+
+  <script>
+    (() => {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          meta: 'Seasonal · Hot or iced · ~150 mg caffeine (medium)',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1120&q=80',
+          alt: 'A latte with foam art in a ceramic cup',
+          prices: { small: 4.25, medium: 4.95, large: 5.65 },
+          defaults: { size: 'medium', milk: 'oat' },
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost. Pulled from our single-origin dark roast.',
+          meta: 'Year-round · Hot · ~130 mg caffeine (double)',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1120&q=80',
+          alt: 'A shot of espresso in a small cup',
+          prices: { small: 2.75, medium: 3.25, large: 3.75 },
+          defaults: { size: 'small', milk: 'none' },
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness, served over ice with a naturally sweet finish.',
+          meta: 'Year-round · Iced · ~200 mg caffeine (medium)',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1120&q=80',
+          alt: 'A glass of iced coffee',
+          prices: { small: 3.95, medium: 4.55, large: 5.15 },
+          defaults: { size: 'medium', milk: 'none' },
+        },
+      };
+      const MILK_UPCHARGE = { oat: 0.6, almond: 0.6 };
+      const EXTRA_SHOT = 0.9;
+      const money = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
+
+      const dialog = document.getElementById('order-dialog');
+      const form = document.getElementById('order-form');
+      const prompt = document.getElementById('discard-prompt');
+      const totalEl = document.getElementById('order-total');
+      const toast = document.getElementById('order-toast');
+      const supportsClosedBy = 'closedBy' in HTMLDialogElement.prototype;
+
+      let current = null;
+      let baseline = '';
+
+      const serialize = () => new URLSearchParams(new FormData(form)).toString();
+      const isDirty = () => current !== null && serialize() !== baseline;
+
+      function updateTotal() {
+        if (!current) return;
+        const data = new FormData(form);
+        const qty = Math.min(10, Math.max(1, parseInt(data.get('quantity'), 10) || 1));
+        const unit = current.prices[data.get('size')] +
+          (MILK_UPCHARGE[data.get('milk')] || 0) +
+          (data.get('extraShot') ? EXTRA_SHOT : 0);
+        totalEl.value = money(unit * qty);
+      }
+
+      // While there are unsaved changes, turn off native light dismiss / close
+      // requests so the only way out is "Discard changes" (or submitting).
+      function syncDismissState() {
+        const dirty = isDirty();
+        dialog.setAttribute('closedby', dirty ? 'none' : 'any');
+        if (!dirty) hidePrompt();
+      }
+
+      function showPrompt() {
+        prompt.hidden = false;
+        prompt.focus();
+      }
+
+      function hidePrompt() {
+        prompt.hidden = true;
+      }
+
+      function attemptClose() {
+        if (isDirty()) {
+          showPrompt();
+        } else {
+          dialog.close('dismiss');
+        }
+      }
+
+      function openDrink(id) {
+        const drink = DRINKS[id];
+        if (!drink) return;
+        current = drink;
+
+        document.getElementById('order-dialog-title').textContent = drink.name;
+        document.getElementById('order-dialog-desc').textContent = drink.description;
+        document.getElementById('order-dialog-meta').textContent = drink.meta;
+        const img = document.getElementById('order-dialog-img');
+        img.src = drink.image;
+        img.alt = drink.alt;
+        for (const el of form.querySelectorAll('[data-size-price]')) {
+          el.textContent = money(drink.prices[el.dataset.sizePrice]);
+        }
+
+        form.reset();
+        form.elements.size.value = drink.defaults.size;
+        form.elements.milk.value = drink.defaults.milk;
+        baseline = serialize();
+        hidePrompt();
+        syncDismissState();
+        updateTotal();
+        dialog.showModal();
+      }
+
+      document.addEventListener('click', (event) => {
+        const opener = event.target.closest('[data-open-drink]');
+        if (opener) openDrink(opener.dataset.openDrink);
+      });
+
+      form.addEventListener('input', () => {
+        updateTotal();
+        syncDismissState();
+      });
+      form.addEventListener('change', syncDismissState);
+
+      for (const btn of dialog.querySelectorAll('[data-dialog-dismiss]')) {
+        btn.addEventListener('click', attemptClose);
+      }
+
+      document.getElementById('discard-cancel').addEventListener('click', () => {
+        hidePrompt();
+        form.querySelector('input, select, textarea')?.focus();
+      });
+
+      document.getElementById('discard-confirm').addEventListener('click', () => {
+        baseline = serialize();
+        dialog.setAttribute('closedby', 'any');
+        dialog.close('discard');
+      });
+
+      // Esc: browsers with closedby="none" ignore it natively, so surface the prompt.
+      dialog.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && isDirty()) {
+          event.preventDefault();
+          showPrompt();
+        }
+      });
+
+      // Browsers without closedby still fire cancel on Esc; block it while dirty.
+      dialog.addEventListener('cancel', (event) => {
+        if (isDirty()) {
+          event.preventDefault();
+          showPrompt();
+        }
+      });
+
+      // Backdrop clicks: prompt while dirty; light-dismiss fallback where closedby is unsupported.
+      dialog.addEventListener('click', (event) => {
+        if (event.target !== dialog) return;
+        const r = dialog.getBoundingClientRect();
+        const inside = r.top <= event.clientY && event.clientY <= r.bottom &&
+          r.left <= event.clientX && event.clientX <= r.right;
+        if (inside) return;
+        if (isDirty()) showPrompt();
+        else if (!supportsClosedBy) dialog.close('dismiss');
+      });
+
+      form.addEventListener('submit', (event) => {
+        if (!form.reportValidity()) {
+          event.preventDefault();
+          return;
+        }
+        const data = new FormData(form);
+        const qty = data.get('quantity');
+        const size = data.get('size');
+        toast.textContent = `Added ${qty} × ${size} ${current.name} (${totalEl.value}) to your order.`;
+        toast.hidden = false;
+        clearTimeout(toast._t);
+        toast._t = setTimeout(() => { toast.hidden = true; }, 4000);
+        baseline = serialize();
+      });
+
+      dialog.addEventListener('close', () => {
+        current = null;
+        hidePrompt();
+        dialog.setAttribute('closedby', 'any');
+      });
+    })();
+  </script>
+
 </body>
 
