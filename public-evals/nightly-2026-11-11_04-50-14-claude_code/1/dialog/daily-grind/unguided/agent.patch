+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          meta: 'Seasonal · 190 cal (medium) · Contains: oats',
+          price: 5.25,
+          defaultMilk: 'oat',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=900&q=80',
+          alt: 'A latte with foam art in a ceramic cup'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost. Pulled from our single-origin Sumatran dark roast.',
+          meta: 'Year-round · 5 cal · Notes of cocoa and cedar',
+          price: 3.25,
+          defaultMilk: 'none',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=900&q=80',
+          alt: 'A shot of espresso in a small white cup'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness, served over ice with a naturally sweet finish.',
+          meta: 'Year-round · 10 cal · Served iced',
+          price: 4.50,
+          defaultMilk: 'none',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=900&q=80',
+          alt: 'A glass of iced cold brew coffee'
+        }
+      };
+      const SIZE_DELTA = { small: -0.50, medium: 0, large: 0.75 };
+      const MILK_DELTA = { none: 0, whole: 0, oat: 0.75, almond: 0.75 };
+
+      const dialog = document.getElementById('order-dialog');
+      if (typeof dialog.showModal !== 'function') return; // fall back to normal links
+
+      const form = document.getElementById('order-form');
+      const drinkSelect = document.getElementById('order-drink');
+      const titleEl = document.getElementById('order-dialog-title');
+      const descEl = document.getElementById('order-dialog-desc');
+      const metaEl = document.getElementById('order-dialog-meta');
+      const imgEl = document.getElementById('order-dialog-img');
+      const totalEl = document.getElementById('order-total');
+      const discardPanel = document.getElementById('discard-panel');
+      const discardBtn = document.getElementById('discard-btn');
+      const keepEditingBtn = document.getElementById('keep-editing-btn');
+      const toast = document.getElementById('toast');
+
+      let initialState = '';
+      let opener = null;
+      let toastTimer = null;
+
+      Object.entries(DRINKS).forEach(([id, d]) => {
+        drinkSelect.add(new Option(`${d.name} — $${d.price.toFixed(2)}`, id));
+      });
+
+      imgEl.addEventListener('error', () => { imgEl.style.visibility = 'hidden'; });
+      imgEl.addEventListener('load', () => { imgEl.style.visibility = ''; });
+
+      function serialize() {
+        const data = new FormData(form);
+        return JSON.stringify([...data.entries()].concat([
+          ['extraShot', form.extraShot.checked],
+          ['whippedCream', form.whippedCream.checked]
+        ]));
+      }
+
+      function isDirty() {
+        return serialize() !== initialState;
+      }
+
+      function quantity() {
+        const q = parseInt(form.quantity.value, 10);
+        return Number.isFinite(q) ? Math.min(20, Math.max(1, q)) : 1;
+      }
+
+      function showDrinkInfo(id) {
+        const d = DRINKS[id];
+        titleEl.textContent = d.name;
+        descEl.textContent = d.description;
+        metaEl.textContent = d.meta;
+        if (imgEl.getAttribute('src') !== d.image) imgEl.src = d.image;
+        imgEl.alt = d.alt;
+      }
+
+      function updateTotal() {
+        const d = DRINKS[drinkSelect.value];
+        let unit = d.price + SIZE_DELTA[form.size.value] + MILK_DELTA[form.milk.value];
+        if (form.extraShot.checked) unit += 1;
+        if (form.whippedCream.checked) unit += 0.5;
+        totalEl.textContent = '$' + (unit * quantity()).toFixed(2);
+      }
+
+      function resetForm(drinkId) {
+        form.reset();
+        drinkSelect.value = drinkId;
+        form.milk.value = DRINKS[drinkId].defaultMilk;
+        showDrinkInfo(drinkId);
+        updateTotal();
+        initialState = serialize();
+      }
+
+      function hideDiscardPanel() {
+        discardPanel.hidden = true;
+      }
+
+      function closeDialog() {
+        hideDiscardPanel();
+        dialog.close();
+      }
+
+      // Every non-confirm dismissal path goes through here.
+      function requestDismiss() {
+        if (!isDirty()) {
+          closeDialog();
+          return;
+        }
+        discardPanel.hidden = false;
+        keepEditingBtn.focus();
+      }
+
+      function openDialog(drinkId, trigger) {
+        opener = trigger;
+        resetForm(drinkId);
+        hideDiscardPanel();
+        dialog.showModal();
+        document.body.classList.add('dialog-open');
+        drinkSelect.focus();
+      }
+
+      function showToast(msg) {
+        toast.textContent = msg;
+        toast.hidden = false;
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => { toast.hidden = true; }, 3500);
+      }
+
+      document.querySelectorAll('[data-order-open]').forEach((link) => {
+        link.addEventListener('click', (e) => {
+          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // allow open-in-new-tab
+          e.preventDefault();
+          const id = link.dataset.drink && DRINKS[link.dataset.drink] ? link.dataset.drink : Object.keys(DRINKS)[0];
+          openDialog(id, link);
+        });
+      });
+
+      dialog.querySelectorAll('[data-dialog-dismiss]').forEach((btn) => {
+        btn.addEventListener('click', requestDismiss);
+      });
+
+      // Escape: handle ourselves so the browser never closes a dirty dialog.
+      dialog.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          e.preventDefault();
+          if (!discardPanel.hidden) {
+            hideDiscardPanel();
+          } else {
+            requestDismiss();
+          }
+        }
+      });
+      // Fallback for any other close request (e.g. Android back gesture).
+      dialog.addEventListener('cancel', (e) => {
+        e.preventDefault();
+        requestDismiss();
+      });
+
+      // Backdrop click (the dialog element itself is only hit outside the inner box).
+      let pointerDownOnBackdrop = false;
+      dialog.addEventListener('pointerdown', (e) => { pointerDownOnBackdrop = e.target === dialog; });
+      dialog.addEventListener('click', (e) => {
+        if (e.target === dialog && pointerDownOnBackdrop) requestDismiss();
+        pointerDownOnBackdrop = false;
+      });
+
+      dialog.addEventListener('close', () => {
+        document.body.classList.remove('dialog-open');
+        if (opener && document.contains(opener)) opener.focus();
+      });
+
+      discardBtn.addEventListener('click', closeDialog);
+      keepEditingBtn.addEventListener('click', () => {
+        hideDiscardPanel();
+        drinkSelect.focus();
+      });
+
+      drinkSelect.addEventListener('change', () => {
+        form.milk.value = DRINKS[drinkSelect.value].defaultMilk;
+        showDrinkInfo(drinkSelect.value);
+      });
+      form.addEventListener('input', () => {
+        updateTotal();
+        if (!isDirty()) hideDiscardPanel();
+      });
+      form.addEventListener('change', updateTotal);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        form.quantity.value = quantity();
+        const d = DRINKS[drinkSelect.value];
+        const sizeLabel = form.size.value.charAt(0).toUpperCase() + form.size.value.slice(1);
+        const summary = `${quantity()} × ${sizeLabel} ${d.name} added to your order (${totalEl.textContent}).`;
+        closeDialog();
+        showToast(summary);
+      });
+    })();
+  </script>
+
 </body>
 
