+  <script>
+    document.querySelectorAll('.reviews-scroll-wrapper').forEach((wrapper) => {
+      const list = wrapper.querySelector('.reviews-list');
+      const topHint = wrapper.querySelector('.scroll-hint-top');
+      const bottomHint = wrapper.querySelector('.scroll-hint-bottom');
+      const THRESHOLD = 2; // tolerate sub-pixel rounding
+
+      const updateHints = () => {
+        const { scrollTop, scrollHeight, clientHeight } = list;
+        topHint.classList.toggle('is-visible', scrollTop > THRESHOLD);
+        bottomHint.classList.toggle('is-visible', scrollHeight - clientHeight - scrollTop > THRESHOLD);
+      };
+
+      let ticking = false;
+      list.addEventListener('scroll', () => {
+        if (ticking) return;
+        ticking = true;
+        requestAnimationFrame(() => {
+          updateHints();
+          ticking = false;
+        });
+      }, { passive: true });
+
+      if ('ResizeObserver' in window) {
+        const ro = new ResizeObserver(updateHints);
+        ro.observe(list);
+        Array.from(list.children).forEach((child) => ro.observe(child));
+      } else {
+        window.addEventListener('resize', updateHints);
+      }
+
+      updateHints();
+    });
+  </script>
+
