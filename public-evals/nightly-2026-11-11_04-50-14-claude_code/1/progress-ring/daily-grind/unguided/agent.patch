+  <script>
+    (function () {
+      var ring = document.getElementById('loyalty-ring');
+      if (!ring) return;
+
+      var goal = Math.max(1, parseInt(ring.dataset.goal, 10) || 10);
+      var stamps = Math.min(goal, Math.max(0, parseInt(ring.dataset.stamps, 10) || 0));
+      var remaining = goal - stamps;
+
+      var bar = ring.querySelector('.progress-ring__bar');
+      var circumference = 2 * Math.PI * bar.r.baseVal.value;
+      var targetOffset = circumference * (1 - stamps / goal);
+
+      ring.querySelector('[data-ring="stamps"]').textContent = stamps;
+      ring.querySelector('[data-ring="goal"]').textContent = goal;
+      ring.setAttribute('aria-valuemax', goal);
+      ring.setAttribute('aria-valuenow', stamps);
+      ring.setAttribute('aria-valuetext', stamps + ' of ' + goal + ' drinks earned');
+
+      var title = document.querySelector('[data-ring="title"]');
+      if (title) {
+        title.textContent = remaining === 0 ? 'Reward unlocked!'
+          : stamps / goal >= 0.5 ? 'Almost there!' : 'Keep sipping!';
+      }
+
+      var message = document.querySelector('[data-ring="message"]');
+      if (message) {
+        message.innerHTML = remaining === 0
+          ? '<strong>Your free drink is ready!</strong> Redeem it on your next visit.'
+          : 'Just <strong>' + remaining + ' more drink' + (remaining === 1 ? '' : 's') +
+            '</strong> until your next free drink.';
+      }
+
+      // Animate the ring filling from empty on page load.
+      bar.style.strokeDasharray = circumference;
+      bar.style.strokeDashoffset = circumference;
+      bar.getBoundingClientRect(); // force reflow so the transition runs
+      requestAnimationFrame(function () {
+        bar.style.strokeDashoffset = targetOffset;
+      });
+    })();
+  </script>
