+  <script>
+    // Sync the progress value/max into CSS for browsers without typed attr() support.
+    const ring = document.getElementById('rewards-progress');
+    const needsSync = !CSS.supports('width: attr(value type(<number>))');
+    const syncRing = () => {
+      if (needsSync) {
+        ring.style.setProperty('--value', ring.getAttribute('value'));
+        ring.style.setProperty('--max', ring.getAttribute('max'));
+      }
+      ring.classList.toggle('is-complete', ring.position >= 1);
+    };
+    new MutationObserver(syncRing).observe(ring, { attributes: true, attributeFilter: ['value', 'max'] });
+    syncRing();
+  </script>
