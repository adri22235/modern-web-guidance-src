@@ -85,10 +85,57 @@
       align-items: center;
       color: white;
       text-align: center;
       padding: 0 20px;
+      /* Containing block for the decorative shape; clip any overflow so it never adds scroll */
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
     }
 
+    /* Keep hero content above the decorative shape */
+    .hero > :not(.shaped-element) {
+      position: relative;
+      z-index: 1;
+    }
+
+    /* Decorative organic shape: absolutely positioned (out of flow) with a fixed
+       aspect ratio, so it never shifts or resizes surrounding layout. */
+    .shaped-element {
+      position: absolute;
+      z-index: 0;
+      right: -4%;
+      bottom: -10%;
+      width: clamp(160px, 28vw, 380px);
+      aspect-ratio: 1 / 1;
+      background:
+        linear-gradient(135deg, rgba(255, 171, 64, 0.55), rgba(78, 52, 46, 0.35)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80') center / cover no-repeat,
+        var(--accent);
+      /* Fallback silhouette for browsers without SVG clip-path references */
+      clip-path: polygon(50% 0%, 80% 8%, 98% 35%, 92% 70%, 68% 95%, 32% 98%, 6% 75%, 2% 40%, 20% 10%);
+      /* Free-form blob, defined in objectBoundingBox units so it scales with the box */
+      clip-path: url('#hero-blob');
+      opacity: 0.85;
+      pointer-events: none;
+      user-select: none;
+      animation: shaped-float 12s ease-in-out infinite alternate;
+      will-change: transform;
+    }
+
+    @keyframes shaped-float {
+      from { transform: translate3d(0, 0, 0) rotate(0deg); }
+      to   { transform: translate3d(-12px, -18px, 0) rotate(6deg); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .shaped-element { animation: none; }
+    }
+
+    @media (max-width: 600px) {
+      .shaped-element { opacity: 0.45; right: -18%; }
+    }
+
     .hero h1 {
       font-size: 3rem;
       margin-bottom: 1rem;
     }
