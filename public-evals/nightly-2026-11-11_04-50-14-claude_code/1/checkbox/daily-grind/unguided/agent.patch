+    /* Drink customization checkboxes */
+    .card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .card > .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    .customize {
+      border: 0;
+      margin: 18px 0 20px;
+      padding: 0;
+      min-width: 0;
+      text-align: left;
+    }
+
+    .customize legend {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+      width: 100%;
+      margin-bottom: 10px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 1.5px;
+      text-transform: uppercase;
+      color: #6d4c41;
+    }
+
+    .customize legend::after {
+      content: "";
+      flex: 1;
+      height: 1px;
+      background: var(--secondary);
+    }
+
+    .options {
+      list-style: none;
+      display: grid;
+      gap: 8px;
+    }
+
+    .option {
+      --ring: var(--secondary);
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border: 2px solid var(--ring);
+      border-radius: 10px;
+      background: #fffdfb;
+      cursor: pointer;
+      transition: border-color 0.2s ease, background-color 0.2s ease,
+        box-shadow 0.2s ease, transform 0.15s ease;
+    }
+
+    /* The real, native checkbox: it stays in the accessibility tree, keeps
+       keyboard focus and Space toggling, and covers the whole row so every
+       click lands on the input itself. It is only made transparent. */
+    .option input[type="checkbox"] {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: inherit;
+      z-index: 1;
+    }
+
+    .option:hover {
+      --ring: #bcaaa4;
+      box-shadow: 0 2px 6px rgba(78, 52, 46, 0.12);
+    }
+
+    .option:active {
+      transform: scale(0.985);
+    }
+
+    .option-icon {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 34px;
+      height: 34px;
+      border-radius: 50%;
+      background: #efebe9;
+      color: var(--primary);
+      transition: background-color 0.25s ease, color 0.25s ease;
+    }
+
+    .option-icon svg {
+      width: 20px;
+      height: 20px;
+    }
+
+    .option-text {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      line-height: 1.25;
+      font-size: 0.95rem;
+      font-weight: 600;
+      color: var(--text);
+    }
+
+    .option-price {
+      font-size: 0.78rem;
+      font-weight: 400;
+      color: #795548;
+    }
+
+    .option-box {
+      flex: none;
+      display: grid;
+      place-items: center;
+      width: 24px;
+      height: 24px;
+      border: 2px solid #a1887f;
+      border-radius: 7px;
+      background: white;
+      color: white;
+      transition: background-color 0.2s ease, border-color 0.2s ease,
+        transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option-box svg {
+      width: 16px;
+      height: 16px;
+      overflow: visible;
+    }
+
+    .option-box .check {
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transition: stroke-dashoffset 0.18s ease-in;
+    }
+
+    /* Checked */
+    .option:has(input:checked) {
+      --ring: var(--accent);
+      background: #fff6ea;
+    }
+
+    .option input:checked ~ .option-icon {
+      background: var(--accent);
+      color: var(--primary);
+      animation: grind-wiggle 0.45s ease;
+    }
+
+    .option input:checked ~ .option-box {
+      background: var(--primary);
+      border-color: var(--primary);
+      animation: grind-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option input:checked ~ .option-box .check {
+      stroke-dashoffset: 0;
+      transition: stroke-dashoffset 0.28s ease-out 0.08s;
+    }
+
+    /* Keyboard focus */
+    .option:has(input:focus-visible) {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .option input:focus-visible ~ .option-box {
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.55);
+    }
+
+    /* Disabled */
+    .option:has(input:disabled) {
+      cursor: not-allowed;
+      opacity: 0.55;
+      box-shadow: none;
+      transform: none;
+    }
+
+    @keyframes grind-pop {
+      0% { transform: scale(0.7); }
+      60% { transform: scale(1.15); }
+      100% { transform: scale(1); }
+    }
+
+    @keyframes grind-wiggle {
+      0%, 100% { transform: rotate(0); }
+      25% { transform: rotate(-14deg) scale(1.08); }
+      55% { transform: rotate(10deg) scale(1.08); }
+      80% { transform: rotate(-4deg); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option,
+      .option-icon,
+      .option-box,
+      .option-box .check {
+        transition: none !important;
+        animation: none !important;
+      }
+
+      .option:active {
+        transform: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors */
+    @media (forced-colors: active) {
+      .option {
+        border-color: CanvasText;
+      }
+
+      .option-box {
+        border-color: CanvasText;
+        background: Canvas;
+      }
+
+      .option input:checked ~ .option-box {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .option input:checked ~ .option-box .check {
+        stroke: HighlightText;
+      }
+
+      .option:has(input:focus-visible) {
+        outline-color: Highlight;
+      }
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
