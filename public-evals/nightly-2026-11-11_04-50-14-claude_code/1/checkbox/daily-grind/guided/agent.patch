+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .option-price {
+      margin-inline-start: auto;
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .checkbox-custom {
+      --checkbox-size: 1.3em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      flex-shrink: 0;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid var(--primary);
+      border-radius: 6px;
+      background-color: white;
+      color: var(--accent);
+      cursor: pointer;
+    }
+
+    .checkbox-custom::before {
+      content: "";
+      inline-size: var(--checkbox-icon-size);
+      aspect-ratio: 1;
+      background-color: currentColor;
+      mask: var(--checkbox-icon) no-repeat center / contain;
+      scale: 0;
+      rotate: -45deg;
+    }
+
+    .checkbox-custom:checked {
+      --checkbox-icon: var(--icon-check);
+    }
+
+    .checkbox-custom:indeterminate {
+      --checkbox-icon: var(--icon-dash);
+    }
+
+    .checkbox-custom:is(:checked, :indeterminate) {
+      background-color: var(--primary);
+    }
+
+    .checkbox-custom:is(:checked, :indeterminate)::before {
+      scale: 1;
+      rotate: 0deg;
+    }
+
+    .checkbox-custom:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .checkbox-custom:disabled {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    .option:has(:disabled) {
+      cursor: not-allowed;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .checkbox-custom {
+        transition: background-color 150ms ease, scale 150ms ease;
+      }
+
+      .checkbox-custom:active {
+        scale: 0.88;
+      }
+
+      .checkbox-custom::before {
+        transition: scale 200ms cubic-bezier(0.34, 1.56, 0.64, 1), rotate 200ms ease;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .checkbox-custom {
+        border-color: CanvasText;
+      }
+
+      .checkbox-custom::before {
+        background-color: CanvasText;
+      }
+    }
   </style>
