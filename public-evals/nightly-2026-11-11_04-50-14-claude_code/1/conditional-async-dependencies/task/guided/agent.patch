+    /* Rewards trigger + popover card */
+    .rewards-trigger {
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: none;
+      border: 0;
+      cursor: pointer;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      transition: color 0.3s;
+    }
+
+    .rewards-trigger:hover,
+    .rewards-trigger[aria-expanded="true"] {
+      color: var(--accent);
+    }
+
+    .rewards-trigger:focus-visible,
+    .rewards-close:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .rewards-badge {
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.7rem;
+      font-weight: bold;
+      border-radius: 999px;
+      padding: 0 7px;
+      line-height: 1.5;
+    }
+
+    .rewards-card {
+      width: min(320px, calc(100vw - 32px));
+      border: 0;
+      border-radius: 12px;
+      padding: 0;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
+      overflow: hidden;
+    }
+
+    /* Combine native and polyfill selectors so older browsers keep the rule. */
+    .rewards-card:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .rewards-photo {
+      display: block;
+      width: 100%;
+      height: 120px;
+      object-fit: cover;
+    }
+
+    .rewards-body {
+      padding: 16px 20px 20px;
+    }
+
+    .rewards-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-bottom: 8px;
+    }
+
+    .rewards-header h2 {
+      font-size: 1.2rem;
+      color: var(--primary);
+    }
+
+    .rewards-close {
+      font-size: 1.5rem;
+      line-height: 1;
+      background: none;
+      border: 0;
+      color: var(--text);
+      cursor: pointer;
+      padding: 0 4px;
+    }
+
+    .rewards-tier {
+      display: inline-block;
+      margin-left: 4px;
+      font-size: 0.75rem;
+      background: var(--secondary);
+      border-radius: 999px;
+      padding: 0 8px;
+    }
+
+    .rewards-stars {
+      font-size: 2rem;
+      font-weight: bold;
+      color: var(--primary);
+      margin: 8px 0 4px;
+    }
+
+    .rewards-stars span:last-child {
+      font-size: 1rem;
+      font-weight: normal;
+    }
+
+    .rewards-progress-label {
+      display: block;
+      font-size: 0.85rem;
+    }
+
+    .rewards-card progress {
+      width: 100%;
+      height: 10px;
+      accent-color: var(--accent);
+    }
+
+    .rewards-perks {
+      margin: 12px 0 0 18px;
+      font-size: 0.85rem;
+    }
+
+    .rewards-card .btn {
+      display: block;
+      text-align: center;
+    }
+
+    /* Tether the card under the trigger where anchor positioning is supported;
+       otherwise keep the default centered popover placement. */
+    .rewards-trigger {
+      anchor-name: --rewards-trigger;
+    }
+
+    @supports (position-area: block-end) {
+      .rewards-card {
+        position-anchor: --rewards-trigger;
+        inset: auto;
+        margin: 8px 0;
+        position-area: block-end span-inline-start;
+        position-try-fallbacks: flip-inline, flip-block, flip-block flip-inline;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .rewards-card {
+        transition: opacity 0.2s, translate 0.2s, overlay 0.2s allow-discrete, display 0.2s allow-discrete;
+        opacity: 0;
+        translate: 0 -6px;
+      }
+
+      .rewards-card:is(:popover-open, .\:popover-open) {
+        opacity: 1;
+        translate: 0 0;
+      }
+
+      @starting-style {
+        .rewards-card:popover-open {
+          opacity: 0;
+          translate: 0 -6px;
+        }
+      }
+    }
+
