     regenBtn.addEventListener('click', renderCards);
 
 
   </script>
+
+  <!-- Core Web Vitals monitoring -->
+  <script type="module">
+    import { onCLS, onINP, onLCP, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@5?module';
+
+    const ANALYTICS_ENDPOINT = '/path/to/analytics/endpoint';
+
+    // Metrics are queued as web-vitals reports them and sent in one batch
+    // when the page is hidden, so values are final before they're collected.
+    const queue = new Set();
+
+    function addToQueue(metric) {
+      queue.add(metric);
+    }
+
+    function flushQueue() {
+      if (queue.size === 0) return;
+
+      const body = JSON.stringify({
+        page: location.href,
+        metrics: [...queue].map(({ name, value, delta, id, rating, navigationType }) => ({
+          name,
+          value,
+          delta,
+          id,
+          rating,
+          navigationType,
+        })),
+      });
+
+      // sendBeacon still sends while the page is being hidden or unloaded.
+      // Fall back to fetch with keepalive if it's unavailable or the beacon is rejected.
+      const sent = navigator.sendBeacon && navigator.sendBeacon(ANALYTICS_ENDPOINT, body);
+      if (!sent) {
+        fetch(ANALYTICS_ENDPOINT, { body, method: 'POST', keepalive: true }).catch(() => {});
+      }
+
+      queue.clear();
+    }
+
+    onCLS(addToQueue);
+    onINP(addToQueue);
+    onLCP(addToQueue);
+    onFCP(addToQueue);
+    onTTFB(addToQueue);
+
+    // `visibilitychange` -> hidden is the last event that reliably fires on all
+    // browsers (tab close, navigation, app switch, mobile backgrounding).
+    // Unlike `unload`/`beforeunload`, it doesn't stop the page from using the
+    // back/forward cache. This listener is added after the web-vitals
+    // listeners so the library's final values are queued before we flush.
+    addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'hidden') {
+        flushQueue();
+      }
+    });
+  </script>
 </body>
 
 </html>
