+  <script type="module">
+    // Load the popover polyfill only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.5/dist/popover.min.js");
+    }
+
+    const header = document.querySelector(".site-header");
+    const inner = header.querySelector(".header-inner");
+    const menu = header.querySelector("#site-menu");
+    const dropdown = header.querySelector(".nav-dropdown");
+    const trigger = dropdown.querySelector(".dropdown-trigger");
+    const submenu = dropdown.querySelector("#drinks-menu");
+
+    const isOpen = (el) => {
+      try { return el.matches(":popover-open"); }
+      catch { return el.classList.contains(":popover-open"); }
+    };
+
+    /* ---- Current page ---- */
+    const normalize = (path) => path.replace(/\/index\.html$/, "/").replace(/(.)\/$/, "$1");
+    const here = normalize(location.pathname);
+    for (const link of header.querySelectorAll("a[href]")) {
+      if (normalize(new URL(link.href).pathname) === here) link.setAttribute("aria-current", "page");
+    }
+    // Mark the "Menu" parent when the current page is inside its section.
+    if (here === "/menu" || here.startsWith("/menu/")) trigger.classList.add("is-current-section");
+
+    /* ---- Layout: inline when it fits, collapsed otherwise ---- */
+    let wide = null;
+    let lastWidth = 0;
+
+    function applySubmenuMode(isWide) {
+      if (isWide) submenu.setAttribute("popover", "auto");
+      else submenu.removeAttribute("popover");
+      submenu.hidden = !isWide;
+      trigger.setAttribute("aria-expanded", "false");
+    }
+
+    function update() {
+      const width = header.clientWidth;
+      const grew = width > lastWidth;
+      lastWidth = width;
+      // While collapsed, only remeasure when there's more room than before.
+      if (wide === false && !grew) return;
+
+      if (wide) {
+        // Already inline: just check it still fits.
+        if (inner.scrollWidth <= inner.clientWidth) return;
+        setLayout(false);
+        return;
+      }
+
+      // Collapsed (or first run): try the inline layout and measure.
+      const menuWasOpen = isOpen(menu);
+      header.classList.add("is-measuring", "is-wide");
+      menu.removeAttribute("popover");
+      submenu.removeAttribute("popover");
+      submenu.hidden = true;
+      const fits = inner.scrollWidth <= inner.clientWidth;
+      if (fits) {
+        wide = true;
+        applySubmenuMode(true);
+      } else {
+        setLayout(false, menuWasOpen);
+      }
+      requestAnimationFrame(() => header.classList.remove("is-measuring"));
+    }
+
+    function setLayout(isWide, reopenMenu = false) {
+      header.classList.add("is-measuring");
+      wide = isWide;
+      header.classList.toggle("is-wide", isWide);
+      if (isWide) {
+        menu.removeAttribute("popover");
+      } else {
+        if (isOpen(submenu)) submenu.hidePopover();
+        menu.setAttribute("popover", "auto");
+        if (reopenMenu) menu.showPopover();
+      }
+      applySubmenuMode(isWide);
+      requestAnimationFrame(() => header.classList.remove("is-measuring"));
+    }
+
+    const ro = new ResizeObserver(update);
+    ro.observe(header);
+    ro.observe(menu);
+
+    /* ---- Submenu behaviour ---- */
+    let hoverPreview = false;
+
+    // Narrow layout: inline disclosure.
+    trigger.addEventListener("click", (event) => {
+      if (submenu.hasAttribute("popover")) {
+        if (hoverPreview) {
+          // Click while hover-previewing pins it open instead of closing it.
+          hoverPreview = false;
+          event.preventDefault();
+        }
+        return; // popovertarget handles toggling natively
+      }
+      const expanded = trigger.getAttribute("aria-expanded") === "true";
+      trigger.setAttribute("aria-expanded", String(!expanded));
+      submenu.hidden = expanded;
+    });
+
+    // Wide layout: popover drives aria-expanded, and is placed manually without anchor positioning.
+    submenu.addEventListener("toggle", (event) => {
+      const open = event.newState === "open";
+      trigger.setAttribute("aria-expanded", String(open));
+      if (!open) {
+        hoverPreview = false;
+        return;
+      }
+      if (!CSS.supports("position-area", "block-end")) {
+        const t = trigger.getBoundingClientRect();
+        const size = submenu.getBoundingClientRect();
+        let top = t.bottom + 8;
+        if (top + size.height > innerHeight) top = Math.max(0, t.top - size.height - 8);
+        const left = Math.min(Math.max(0, t.left), Math.max(0, innerWidth - size.width));
+        submenu.style.top = `${top}px`;
+        submenu.style.left = `${left}px`;
+      }
+    });
+
+    // Hover preview (wide layout, real hover devices only).
+    const canHover = matchMedia("(hover: hover)");
+    dropdown.addEventListener("pointerenter", (event) => {
+      if (!wide || !canHover.matches || event.pointerType === "touch") return;
+      if (isOpen(submenu)) return;
+      hoverPreview = true;
+      submenu.showPopover({ source: trigger });
+    });
+    dropdown.addEventListener("pointerleave", () => {
+      if (hoverPreview && isOpen(submenu)) submenu.hidePopover();
+      hoverPreview = false;
+    });
+
+    // Close when focus leaves the dropdown's list item.
+    dropdown.addEventListener("focusout", (event) => {
+      if (event.relatedTarget && !dropdown.contains(event.relatedTarget) && isOpen(submenu)) {
+        submenu.hidePopover();
+      }
+    });
+  </script>
 
