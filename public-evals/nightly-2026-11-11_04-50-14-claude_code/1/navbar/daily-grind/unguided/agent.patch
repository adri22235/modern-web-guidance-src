+  <script>
+    (function () {
+      var nav = document.getElementById('site-nav');
+      if (!nav) return;
+      var toggle = nav.querySelector('.nav-toggle');
+      var list = document.getElementById('primary-nav-list');
+      var logo = nav.querySelector('.logo');
+
+      /* ---------- Active page ---------- */
+      function normalize(path) {
+        path = path.replace(/\/index\.html?$/, '/').replace(/\.html?$/, '');
+        return path.length > 1 ? path.replace(/\/+$/, '') : path;
+      }
+      var current = normalize(window.location.pathname);
+      nav.querySelectorAll('a[href]').forEach(function (link) {
+        if (normalize(new URL(link.href, window.location.href).pathname) === current) {
+          link.setAttribute('aria-current', 'page');
+        }
+      });
+      nav.querySelectorAll('[data-section]').forEach(function (item) {
+        var section = item.getAttribute('data-section');
+        if (current === section || current.indexOf(section + '/') === 0) {
+          item.classList.add('nav-item--current');
+        }
+      });
+
+      /* ---------- Submenus (disclosure pattern) ---------- */
+      var submenuToggles = Array.prototype.slice.call(nav.querySelectorAll('.submenu-toggle'));
+
+      function setSubmenu(btn, open) {
+        btn.setAttribute('aria-expanded', String(open));
+        document.getElementById(btn.getAttribute('aria-controls')).hidden = !open;
+      }
+
+      function closeSubmenus(except) {
+        submenuToggles.forEach(function (btn) {
+          if (btn !== except) setSubmenu(btn, false);
+        });
+      }
+
+      submenuToggles.forEach(function (btn) {
+        btn.hidden = false;
+        var item = btn.closest('.nav-item');
+        setSubmenu(btn, false);
+        btn.addEventListener('click', function () {
+          var open = btn.getAttribute('aria-expanded') !== 'true';
+          closeSubmenus(btn);
+          setSubmenu(btn, open);
+        });
+        // Close the inline dropdown when focus leaves it.
+        item.addEventListener('focusout', function (e) {
+          if (!nav.classList.contains('is-collapsed') && !item.contains(e.relatedTarget)) {
+            setSubmenu(btn, false);
+          }
+        });
+      });
+
+      /* ---------- Collapse behind "Menu" button when it doesn't fit ---------- */
+      function setPanel(open) {
+        toggle.setAttribute('aria-expanded', String(open));
+        list.hidden = !open;
+      }
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', function () {
+        var open = toggle.getAttribute('aria-expanded') !== 'true';
+        setPanel(open);
+        if (open) {
+          // Reveal the active section's submenu so the current page is visible.
+          submenuToggles.forEach(function (btn) {
+            if (btn.closest('.nav-item--current')) setSubmenu(btn, true);
+          });
+        }
+      });
+
+      var collapsed = null;
+      function update() {
+        var wasOpen = toggle.getAttribute('aria-expanded') === 'true';
+        // Measure in the inline layout (synchronously, so nothing is painted).
+        nav.classList.remove('is-collapsed');
+        list.hidden = false;
+        var styles = getComputedStyle(nav);
+        var available = nav.clientWidth -
+          parseFloat(styles.paddingLeft) - parseFloat(styles.paddingRight) -
+          logo.offsetWidth - parseFloat(styles.columnGap || 0);
+        var shouldCollapse = list.scrollWidth > available + 1;
+
+        if (shouldCollapse) {
+          nav.classList.add('is-collapsed');
+          setPanel(collapsed === true ? wasOpen : false);
+        } else {
+          toggle.setAttribute('aria-expanded', 'false');
+          list.hidden = false;
+        }
+        if (collapsed !== shouldCollapse) closeSubmenus();
+        collapsed = shouldCollapse;
+      }
+
+      update();
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(update).observe(nav);
+      } else {
+        window.addEventListener('resize', update);
+      }
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
+
+      /* ---------- Dismiss with Escape / outside click ---------- */
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== 'Escape') return;
+        var openSub = submenuToggles.filter(function (b) {
+          return b.getAttribute('aria-expanded') === 'true';
+        })[0];
+        if (openSub && !nav.classList.contains('is-collapsed')) {
+          setSubmenu(openSub, false);
+          openSub.focus();
+        } else if (nav.classList.contains('is-collapsed') && toggle.getAttribute('aria-expanded') === 'true') {
+          setPanel(false);
+          toggle.focus();
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (nav.contains(e.target)) return;
+        if (nav.classList.contains('is-collapsed')) {
+          setPanel(false);
+        } else {
+          closeSubmenus();
+        }
+      });
+    })();
+  </script>
