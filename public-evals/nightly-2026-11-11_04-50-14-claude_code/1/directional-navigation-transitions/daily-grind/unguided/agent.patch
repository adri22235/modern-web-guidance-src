+  <script>
+    (function () {
+      var carousel = document.getElementById('seasonal-carousel');
+      if (!carousel) return;
+      var slides = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-viewport > .card'));
+      var status = carousel.querySelector('.carousel-status');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var current = 0;
+      var running = [];
+      var DURATION = 400;
+      var EASING = 'cubic-bezier(0.22, 0.61, 0.36, 1)';
+
+      function render() {
+        slides.forEach(function (slide, i) {
+          var active = i === current;
+          slide.classList.toggle('is-active', active);
+          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
+          slide.setAttribute('aria-label', (i + 1) + ' of ' + slides.length);
+          slide.inert = !active;
+        });
+        status.textContent = (current + 1) + ' / ' + slides.length;
+      }
+
+      function finishRunning() {
+        running.forEach(function (anim) { anim.finish(); });
+        running = [];
+      }
+
+      // direction: 1 = next (enter from right), -1 = previous (enter from left)
+      function go(direction) {
+        if (slides.length < 2) return;
+        finishRunning();
+
+        var outgoing = slides[current];
+        current = (current + direction + slides.length) % slides.length;
+        var incoming = slides[current];
+        render();
+
+        if (reduceMotion.matches || typeof incoming.animate !== 'function') return;
+
+        var offset = direction > 0 ? '100%' : '-100%';
+        var exitTo = direction > 0 ? '-100%' : '100%';
+        var opts = { duration: DURATION, easing: EASING };
+
+        outgoing.classList.add('is-animating');
+        incoming.classList.add('is-animating');
+
+        var outAnim = outgoing.animate([
+          { transform: 'translateX(0)', opacity: 1 },
+          { transform: 'translateX(' + exitTo + ')', opacity: 0 }
+        ], opts);
+        var inAnim = incoming.animate([
+          { transform: 'translateX(' + offset + ')', opacity: 0 },
+          { transform: 'translateX(0)', opacity: 1 }
+        ], opts);
+
+        running = [outAnim, inAnim];
+        outAnim.onfinish = outAnim.oncancel = function () { outgoing.classList.remove('is-animating'); };
+        inAnim.onfinish = inAnim.oncancel = function () { incoming.classList.remove('is-animating'); };
+      }
+
+      carousel.addEventListener('click', function (e) {
+        var btn = e.target.closest('.carousel-btn');
+        if (!btn) return;
+        go(btn.getAttribute('data-dir') === 'prev' ? -1 : 1);
+      });
+
+      carousel.addEventListener('keydown', function (e) {
+        if (e.key === 'ArrowRight') { go(1); }
+        else if (e.key === 'ArrowLeft') { go(-1); }
+      });
+
+      carousel.classList.add('is-enhanced');
+      render();
+    })();
+  </script>
+
