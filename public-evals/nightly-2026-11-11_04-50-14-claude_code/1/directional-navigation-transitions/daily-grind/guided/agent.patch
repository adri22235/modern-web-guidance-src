+  <script>
+    (() => {
+      const carousel = document.getElementById('seasonal-carousel');
+      const slides = [...carousel.querySelectorAll('.seasonal-card')];
+      const status = carousel.querySelector('.seasonal-status');
+      let index = 0;
+
+      const show = (next) => {
+        slides[index].hidden = true;
+        index = next;
+        slides[index].hidden = false;
+        status.textContent = `${index + 1} / ${slides.length}`;
+      };
+
+      const navigate = (direction) => {
+        const step = direction === 'forward' ? 1 : -1;
+        // Compute the target inside the update callback, which runs async,
+        // so rapid clicks always step from the current slide.
+        const update = () => show((index + step + slides.length) % slides.length);
+
+        // Prefer an element-scoped transition so the rest of the page stays
+        // interactive; fall back to a document transition. Without view
+        // transition types, the direction can't be expressed, so just swap.
+        const supportsTypes = CSS.supports('selector(:active-view-transition-type(forward))');
+        const scope = !supportsTypes ? null
+          : 'startViewTransition' in Element.prototype ? carousel
+          : document.startViewTransition ? document : null;
+        if (!scope) {
+          update();
+          return;
+        }
+
+        const transition = scope.startViewTransition({ update, types: [direction] });
+        transition.ready.catch(() => {});
+      };
+
+      carousel.querySelectorAll('[data-direction]').forEach((button) => {
+        button.addEventListener('click', () => navigate(button.dataset.direction));
+      });
+
+      carousel.addEventListener('keydown', (event) => {
+        if (event.key === 'ArrowRight') navigate('forward');
+        else if (event.key === 'ArrowLeft') navigate('backward');
+      });
+    })();
+  </script>
+
