index 0000000..cd46719
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,228 @@
+---
+import type { CollectionEntry } from 'astro:content';
+import { Image } from 'astro:assets';
+import { getArticleImage } from '../utils/images';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+const base = import.meta.env.BASE_URL;
+const slides = await Promise.all(
+    articles.map(async (article) => ({ article, image: await getArticleImage(article) }))
+);
+const total = slides.length;
+---
+<section
+    class="top-stories bg-white border-b border-gray-300"
+    aria-roledescription="carousel"
+    aria-label="Top stories"
+    data-top-stories
+>
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-3 sm:gap-4">
+        <h2 class="hidden sm:block shrink-0 font-brand text-amber-800 text-sm tracking-widest uppercase">
+            Top Stories
+        </h2>
+
+        <!-- Controls come before the slides in DOM order -->
+        <button
+            type="button"
+            class="ts-btn"
+            data-direction="previous"
+            aria-label="Previous story"
+        >
+            <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
+                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd" />
+            </svg>
+        </button>
+
+        <div class="ts-viewport flex-1 min-w-0" data-viewport>
+            {slides.map(({ article, image }, i) => (
+                <div
+                    class="ts-slide"
+                    role="group"
+                    aria-roledescription="slide"
+                    aria-label={`${i + 1} of ${total}`}
+                    data-slide
+                    hidden={i !== 0}
+                >
+                    <a href={`${base}articles/${article.id}`} class="group flex items-center gap-4">
+                        <Image
+                            src={image}
+                            alt=""
+                            width={128}
+                            height={72}
+                            format="webp"
+                            class="w-20 sm:w-32 aspect-[16/9] object-cover rounded shrink-0"
+                        />
+                        <span class="min-w-0">
+                            <span class="block font-bold text-gray-900 group-hover:text-amber-400 transition-colors line-clamp-2">
+                                {article.data.title}
+                            </span>
+                            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                        </span>
+                    </a>
+                </div>
+            ))}
+        </div>
+
+        <span class="shrink-0 text-xs text-gray-500 tabular-nums" aria-hidden="true" data-counter>1 / {total}</span>
+
+        <button type="button" class="ts-btn" data-direction="next" aria-label="Next story">
+            <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
+                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" />
+            </svg>
+        </button>
+
+        <p class="sr-only" role="status" aria-live="polite" data-status></p>
+    </div>
+</section>
+
+<style>
+    .ts-btn {
+        display: inline-grid;
+        place-items: center;
+        inline-size: 2.25rem;
+        block-size: 2.25rem;
+        flex-shrink: 0;
+        border-radius: 9999px;
+        border: 1px solid var(--color-gray-300);
+        color: var(--color-gray-700);
+        cursor: pointer;
+        touch-action: manipulation;
+        transition: background-color 0.15s, color 0.15s, border-color 0.15s;
+    }
+    .ts-btn:hover {
+        background-color: var(--color-gray-900);
+        border-color: var(--color-gray-900);
+        color: white;
+    }
+    .ts-btn:focus-visible {
+        outline: 2px solid var(--color-amber-500);
+        outline-offset: 2px;
+    }
+
+    /* Clip the sliding story to the carousel bounds */
+    .ts-viewport {
+        overflow: clip;
+    }
+
+    /* Only the current story participates in the transition */
+    .ts-slide {
+        view-transition-name: top-story;
+    }
+
+    @keyframes ts-slide-from-right { from { transform: translateX(100%); } }
+    @keyframes ts-slide-to-left   { to   { transform: translateX(-100%); } }
+    @keyframes ts-slide-from-left { from { transform: translateX(-100%); } }
+    @keyframes ts-slide-to-right  { to   { transform: translateX(100%); } }
+
+    .ts-viewport::view-transition-group(top-story) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+    }
+    .ts-viewport::view-transition-old(top-story),
+    .ts-viewport::view-transition-new(top-story) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+    }
+
+    /* Next: new story enters from the right, old exits left */
+    .ts-viewport:active-view-transition-type(next)::view-transition-old(top-story) {
+        animation-name: ts-slide-to-left;
+    }
+    .ts-viewport:active-view-transition-type(next)::view-transition-new(top-story) {
+        animation-name: ts-slide-from-right;
+    }
+
+    /* Previous: new story enters from the left, old exits right */
+    .ts-viewport:active-view-transition-type(previous)::view-transition-old(top-story) {
+        animation-name: ts-slide-to-right;
+    }
+    .ts-viewport:active-view-transition-type(previous)::view-transition-new(top-story) {
+        animation-name: ts-slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .ts-viewport::view-transition-group(*),
+        .ts-viewport::view-transition-old(*),
+        .ts-viewport::view-transition-new(*) {
+            animation: none !important;
+        }
+    }
+</style>
+
+<script>
+    type Direction = 'next' | 'previous';
+
+    const supportsScopedTransition =
+        typeof Element !== 'undefined' && 'startViewTransition' in Element.prototype;
+    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+    function initCarousel(root: HTMLElement) {
+        if (root.dataset.ready) return;
+        root.dataset.ready = 'true';
+
+        const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
+        const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
+        const counter = root.querySelector<HTMLElement>('[data-counter]');
+        const status = root.querySelector<HTMLElement>('[data-status]');
+        const total = slides.length;
+        let current = 0;
+
+        if (total < 2) {
+            root.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((b) => (b.hidden = true));
+            return;
+        }
+
+        function show(index: number) {
+            slides[current].hidden = true;
+            current = index;
+            slides[current].hidden = false;
+            if (counter) counter.textContent = `${current + 1} / ${total}`;
+            if (status) status.textContent = `Story ${current + 1} of ${total}`;
+        }
+
+        // Fallback for browsers without element-scoped view transitions
+        function animateFallback(direction: Direction) {
+            if (reducedMotion()) return;
+            const from = direction === 'next' ? '100%' : '-100%';
+            slides[current].animate(
+                [{ transform: `translateX(${from})` }, { transform: 'translateX(0)' }],
+                { duration: 400, easing: 'ease-in-out' }
+            );
+        }
+
+        function go(direction: Direction) {
+            const step = direction === 'next' ? 1 : -1;
+            // Resolve the target when the DOM update runs so rapid clicks build on each other
+            const advance = () => show((current + step + total) % total);
+
+            if (!supportsScopedTransition) {
+                advance();
+                animateFallback(direction);
+                return;
+            }
+
+            const transition = (viewport as any).startViewTransition({
+                update: advance,
+                types: [direction],
+            });
+            // Rapid clicks skip the running transition; avoid unhandled rejections
+            transition.ready.catch(() => {});
+        }
+
+        root.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
+            button.addEventListener('click', () => go(button.dataset.direction as Direction));
+        });
+    }
+
+    function initAll() {
+        document.querySelectorAll<HTMLElement>('[data-top-stories]').forEach(initCarousel);
+    }
+
+    // Works with Astro's ClientRouter (runs on initial load and after each navigation)
+    document.addEventListener('astro:page-load', initAll);
+</script>
