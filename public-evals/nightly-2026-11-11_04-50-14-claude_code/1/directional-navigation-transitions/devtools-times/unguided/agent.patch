+import { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStory {
+  id: string;
+  title: string;
+  href: string;
+  date: string;
+}
+
+interface Props {
+  stories: TopStory[];
+}
+
+type Direction = 'next' | 'prev' | null;
+
+export default function TopStoriesCarousel({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  // Each navigation gets a unique key so the slide remounts and its
+  // animation restarts, even on rapid repeated clicks.
+  const [nav, setNav] = useState<{ direction: Direction; count: number }>({ direction: null, count: 0 });
+
+  if (stories.length === 0) return null;
+
+  const go = (direction: 'next' | 'prev') => {
+    const delta = direction === 'next' ? 1 : -1;
+    setIndex((i) => (i + delta + stories.length) % stories.length);
+    setNav((n) => ({ direction, count: n.count + 1 }));
+  };
+
+  const story = stories[index];
+  const animationClass =
+    nav.direction === 'next' ? 'carousel-slide-next' : nav.direction === 'prev' ? 'carousel-slide-prev' : '';
+  const hasMultiple = stories.length > 1;
+
+  return (
+    <section
+      className="flex items-center gap-3"
+      aria-roledescription="carousel"
+      aria-label="Top Stories"
+    >
+      <button
+        type="button"
+        onClick={() => go('prev')}
+        disabled={!hasMultiple}
+        aria-label="Previous story"
+        className="shrink-0 rounded-full border border-gray-300 p-1.5 text-gray-700 hover:text-amber-400 hover:border-amber-400 disabled:opacity-40 disabled:pointer-events-none"
+      >
+        <ChevronLeftIcon className="h-5 w-5" />
+      </button>
+
+      <div className="relative flex-1 overflow-hidden" aria-live="polite">
+        <div
+          key={`${story.id}-${nav.count}`}
+          className={animationClass}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${index + 1} of ${stories.length}`}
+        >
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+          </a>
+          <div className="flex items-center gap-2 text-xs text-gray-500">
+            <span>{story.date}</span>
+            <span aria-hidden="true">·</span>
+            <span>
+              {index + 1} / {stories.length}
+            </span>
+          </div>
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={() => go('next')}
+        disabled={!hasMultiple}
+        aria-label="Next story"
+        className="shrink-0 rounded-full border border-gray-300 p-1.5 text-gray-700 hover:text-amber-400 hover:border-amber-400 disabled:opacity-40 disabled:pointer-events-none"
+      >
+        <ChevronRightIcon className="h-5 w-5" />
+      </button>
+    </section>
+  );
+}
