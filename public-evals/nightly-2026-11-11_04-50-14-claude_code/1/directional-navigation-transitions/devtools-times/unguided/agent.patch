+}
+/* Top Stories carousel: direction-aware slide transitions */
+@keyframes carousel-slide-in-from-right {
+  from { transform: translateX(100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+@keyframes carousel-slide-in-from-left {
+  from { transform: translateX(-100%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+
+.carousel-slide-next {
+  animation: carousel-slide-in-from-right 350ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+.carousel-slide-prev {
+  animation: carousel-slide-in-from-left 350ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .carousel-slide-next,
+  .carousel-slide-prev {
+    animation: none;
+  }
+}
