diff --git a/migration-config.js b/migration-config.js
new file mode 100644
index 0000000..f652407
--- /dev/null
+++ b/migration-config.js
@@ -0,0 +1,16 @@
+// Origin migration settings for The Daily Grind web app.
+// The app used to be installed from LEGACY_ORIGIN and now lives on CURRENT_ORIGIN.
+// Both origins serve this same build. app.js checks which one it's on and
+// picks the right manifest and behaviour.
+window.DG_MIGRATION = Object.freeze({
+  LEGACY_ORIGIN: 'https://www.dailygrind.coffee',
+  CURRENT_ORIGIN: 'https://app.dailygrind.coffee',
+  // Manifest used when the page is served from LEGACY_ORIGIN (contains `migrate_to`).
+  LEGACY_MANIFEST: '/legacy/manifest.webmanifest',
+  // Manifest used everywhere else (contains `migrate_from`).
+  CURRENT_MANIFEST: '/manifest.webmanifest',
+  // How long an installed (standalone) legacy app stays open before it hands off.
+  // This gives the browser time to fetch the legacy manifest and see `migrate_to`.
+  STANDALONE_HANDOFF_DELAY_MS: 5000,
+  HASH_KEY: 'dg-migrate'
+});
diff --git a/sw.js b/sw.js
new file mode 100644
index 0000000..0f1c48e
--- /dev/null
+++ b/sw.js
@@ -0,0 +1,24 @@
+// Small offline service worker: network-first for pages, cache-first for static assets.
+const CACHE = 'dg-v1';
+const ASSETS = ['/', '/app.js', '/migration-config.js', '/manifest.webmanifest',
+  '/icons/icon-192.png', '/icons/icon-512.png', '/icons/maskable-512.png', '/icons/icon.svg'];
+
+self.addEventListener('install', (e) => {
+  e.waitUntil(caches.open(CACHE).then((c) => c.addAll(ASSETS)).then(() => self.skipWaiting()));
+});
+
+self.addEventListener('activate', (e) => {
+  e.waitUntil(caches.keys()
+    .then((keys) => Promise.all(keys.filter((k) => k !== CACHE).map((k) => caches.delete(k))))
+    .then(() => self.clients.claim()));
+});
+
+self.addEventListener('fetch', (e) => {
+  const req = e.request;
+  if (req.method !== 'GET' || new URL(req.url).origin !== self.location.origin) return;
+  if (req.mode === 'navigate') {
+    e.respondWith(fetch(req).catch(() => caches.match('/')));
+    return;
+  }
+  e.respondWith(caches.match(req).then((hit) => hit || fetch(req)));
+});
