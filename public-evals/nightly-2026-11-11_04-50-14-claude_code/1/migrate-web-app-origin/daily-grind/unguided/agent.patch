diff --git a/app.js b/app.js
new file mode 100644
index 0000000..2f2b50e
--- /dev/null
+++ b/app.js
@@ -0,0 +1,214 @@
+/* The Daily Grind: user preferences and the origin-migration handoff.
+ *
+ * localStorage belongs to one origin, so the browser cannot carry it from the
+ * legacy origin to the new one on its own. When the page runs on the legacy
+ * origin, it packs the user's saved configuration into the URL *fragment*
+ * (fragments are never sent to servers) and redirects to the same path on the
+ * new origin. The new origin checks the payload, merges it in, and removes the
+ * fragment from the address bar.
+ *
+ * Installed-app identity and OS integration (launcher icon, taskbar pin and
+ * jump-list shortcuts) carry over through the manifest pair:
+ * legacy/manifest.webmanifest declares `migrate_to` and manifest.webmanifest
+ * declares `migrate_from`. Both list the same `shortcuts`.
+ */
+(function () {
+  'use strict';
+
+  var CFG = window.DG_MIGRATION;
+  var STORAGE_KEY = 'dg:prefs';
+  var SCHEMA_VERSION = 1;
+
+  // Allowed preference keys and their validators. Anything else is dropped on import.
+  var PREF_SCHEMA = {
+    favoriteDrink: oneOf(['', 'maple-oat-latte', 'dark-roast-espresso', 'cold-brew']),
+    milk: oneOf(['whole', 'oat', 'almond', 'soy', 'none']),
+    size: oneOf(['small', 'medium', 'large']),
+    homeLocation: oneOf(['', 'downtown', 'riverside', 'uptown']),
+    theme: oneOf(['light', 'dark']),
+    notifications: function (v) { return typeof v === 'boolean'; }
+  };
+  var DEFAULT_PREFS = {
+    favoriteDrink: '', milk: 'whole', size: 'medium',
+    homeLocation: '', theme: 'light', notifications: false
+  };
+
+  function oneOf(list) { return function (v) { return list.indexOf(v) !== -1; }; }
+
+  // ---------- storage ----------
+  function sanitize(raw) {
+    var out = {};
+    if (!raw || typeof raw !== 'object') return out;
+    Object.keys(PREF_SCHEMA).forEach(function (k) {
+      if (Object.prototype.hasOwnProperty.call(raw, k) && PREF_SCHEMA[k](raw[k])) out[k] = raw[k];
+    });
+    return out;
+  }
+
+  function readStore() {
+    try {
+      var data = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
+      if (data && data.v === SCHEMA_VERSION) {
+        return { v: SCHEMA_VERSION, updatedAt: Number(data.updatedAt) || 0, prefs: sanitize(data.prefs) };
+      }
+    } catch (e) { /* corrupted or unavailable storage */ }
+    return { v: SCHEMA_VERSION, updatedAt: 0, prefs: {} };
+  }
+
+  function writeStore(store) {
+    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(store)); } catch (e) { /* quota / private mode */ }
+  }
+
+  function getPrefs() {
+    var p = readStore().prefs, out = {};
+    Object.keys(DEFAULT_PREFS).forEach(function (k) { out[k] = k in p ? p[k] : DEFAULT_PREFS[k]; });
+    return out;
+  }
+
+  function savePrefs(prefs) {
+    writeStore({ v: SCHEMA_VERSION, updatedAt: Date.now(), prefs: sanitize(prefs) });
+  }
+
+  // ---------- base64url JSON ----------
+  function encode(obj) {
+    var bytes = new TextEncoder().encode(JSON.stringify(obj)), bin = '';
+    bytes.forEach(function (b) { bin += String.fromCharCode(b); });
+    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  }
+  function decode(str) {
+    var b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+    while (b64.length % 4) b64 += '=';
+    var bin = atob(b64), bytes = new Uint8Array(bin.length);
+    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+    return JSON.parse(new TextDecoder().decode(bytes));
+  }
+
+  // ---------- origin detection ----------
+  var origin = location.origin;
+  var isLegacy = origin === CFG.LEGACY_ORIGIN;
+  var isStandalone = (window.matchMedia && matchMedia('(display-mode: standalone)').matches) ||
+    window.navigator.standalone === true;
+
+  // Each origin gets the manifest that matches its role in the migration.
+  (function linkManifest() {
+    var link = document.createElement('link');
+    link.rel = 'manifest';
+    link.href = isLegacy ? CFG.LEGACY_MANIFEST : CFG.CURRENT_MANIFEST;
+    document.head.appendChild(link);
+  })();
+
+  // ---------- legacy origin: export and redirect ----------
+  function buildHandoffUrl() {
+    var target = new URL(location.pathname + location.search, CFG.CURRENT_ORIGIN);
+    var store = readStore();
+    if (store.updatedAt) {
+      target.hash = CFG.HASH_KEY + '=' + encode({
+        v: SCHEMA_VERSION, from: origin, updatedAt: store.updatedAt, prefs: store.prefs
+      });
+    }
+    return target.href;
+  }
+
+  function handoff() { location.replace(buildHandoffUrl()); }
+
+  if (isLegacy) {
+    if (!isStandalone) {
+      // Regular browser tab: nothing to wait for, go straight to the new origin.
+      handoff();
+      return;
+    }
+    // Installed app: keep the page up briefly so the browser can read the
+    // legacy manifest (`migrate_to`) and start migrating the installed app.
+    document.addEventListener('DOMContentLoaded', function () {
+      showBanner(
+        'The Daily Grind has moved to ' + CFG.CURRENT_ORIGIN.replace(/^https?:\/\//, '') +
+        '. Your preferences and shortcuts are coming with you.',
+        'Continue now', handoff
+      );
+      setTimeout(handoff, CFG.STANDALONE_HANDOFF_DELAY_MS);
+    });
+    return;
+  }
+
+  // ---------- new origin: import ----------
+  function importFromHash() {
+    var hash = location.hash.replace(/^#/, '');
+    if (!hash) return false;
+    var params = new URLSearchParams(hash);
+    var payload = params.get(CFG.HASH_KEY);
+    if (payload === null) return false;
+
+    // Always remove the payload from the URL, whether or not it's valid.
+    params.delete(CFG.HASH_KEY);
+    var rest = params.toString();
+    history.replaceState(history.state, '', location.pathname + location.search + (rest ? '#' + rest : ''));
+
+    var data;
+    try { data = decode(payload); } catch (e) { return false; }
+    if (!data || data.v !== SCHEMA_VERSION || data.from !== CFG.LEGACY_ORIGIN) return false;
+
+    var incoming = sanitize(data.prefs);
+    var incomingAt = Number(data.updatedAt) || 0;
+    var local = readStore();
+    // If this origin already has newer settings, keep them. Otherwise, fill missing keys.
+    var merged = incomingAt > local.updatedAt
+      ? Object.assign({}, local.prefs, incoming)
+      : Object.assign({}, incoming, local.prefs);
+    writeStore({ v: SCHEMA_VERSION, updatedAt: Math.max(incomingAt, local.updatedAt) || Date.now(), prefs: merged });
+    return true;
+  }
+
+  var imported = importFromHash();
+
+  // ---------- UI ----------
+  function applyTheme(prefs) {
+    document.documentElement.setAttribute('data-theme', prefs.theme);
+  }
+  applyTheme(getPrefs());
+
+  function showBanner(text, actionLabel, onAction) {
+    var el = document.createElement('div');
+    el.className = 'dg-banner';
+    el.setAttribute('role', 'status');
+    var span = document.createElement('span');
+    span.textContent = text;
+    el.appendChild(span);
+    var btn = document.createElement('button');
+    btn.type = 'button';
+    btn.textContent = actionLabel || 'Dismiss';
+    btn.addEventListener('click', function () { (onAction || function () { el.remove(); })(); });
+    el.appendChild(btn);
+    document.body.appendChild(el);
+  }
+
+  document.addEventListener('DOMContentLoaded', function () {
+    var form = document.getElementById('prefs-form');
+    if (form) {
+      var prefs = getPrefs();
+      Object.keys(prefs).forEach(function (k) {
+        var field = form.elements[k];
+        if (!field) return;
+        if (field.type === 'checkbox') field.checked = prefs[k]; else field.value = prefs[k];
+      });
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var next = {};
+        Object.keys(DEFAULT_PREFS).forEach(function (k) {
+          var field = form.elements[k];
+          if (field) next[k] = field.type === 'checkbox' ? field.checked : field.value;
+        });
+        savePrefs(next);
+        applyTheme(getPrefs());
+        var status = document.getElementById('prefs-status');
+        if (status) status.textContent = 'Preferences saved.';
+      });
+    }
+    if (imported) showBanner('Welcome to our new home! Your saved preferences were transferred.');
+  });
+
+  if ('serviceWorker' in navigator) {
+    window.addEventListener('load', function () {
+      navigator.serviceWorker.register('/sw.js').catch(function () { /* offline support is optional */ });
+    });
+  }
+})();
