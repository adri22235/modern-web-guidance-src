diff --git a/legacy-origin/migration-bridge.html b/legacy-origin/migration-bridge.html
new file mode 100644
index 0000000..e700ba7
--- /dev/null
+++ b/legacy-origin/migration-bridge.html
@@ -0,0 +1,20 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Daily Grind settings bridge</title>
+  <script>
+    // Hands the user's saved settings (dg:* keys) to the new origin only.
+    const NEW_ORIGIN = 'https://www.dailygrind.coffee';
+    if (window.parent !== window) {
+      const settings = {};
+      for (let i = 0; i < localStorage.length; i++) {
+        const key = localStorage.key(i);
+        if (key.startsWith('dg:')) settings[key] = localStorage.getItem(key);
+      }
+      window.parent.postMessage({ type: 'dg-settings', settings }, NEW_ORIGIN);
+    }
+  </script>
+</head>
+<body></body>
+</html>
diff --git a/legacy-origin/move-notice.js b/legacy-origin/move-notice.js
new file mode 100644
index 0000000..47f952d
--- /dev/null
+++ b/legacy-origin/move-notice.js
@@ -0,0 +1,12 @@
+// Fallback for browsers without Web App Origin Migration (Firefox, Safari,
+// Chromium < 149): tell users of the old install where the app lives now.
+const NEW_URL = 'https://www.dailygrind.coffee/';
+const banner = document.createElement('aside');
+banner.setAttribute('role', 'status');
+banner.style.cssText =
+  'position:sticky;top:0;z-index:1001;background:#ffab40;color:#3e2723;' +
+  'padding:.75rem 5%;text-align:center;font:inherit';
+banner.innerHTML =
+  'The Daily Grind has moved! <a href="' + NEW_URL + '" style="color:inherit;font-weight:bold">' +
+  'Open the new app</a> and install it from there. Your settings will come with you.';
+document.body.prepend(banner);
