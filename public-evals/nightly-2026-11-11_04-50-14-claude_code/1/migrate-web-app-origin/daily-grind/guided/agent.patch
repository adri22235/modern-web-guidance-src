diff --git a/migrate-settings.js b/migrate-settings.js
new file mode 100644
index 0000000..c0a59a2
--- /dev/null
+++ b/migrate-settings.js
@@ -0,0 +1,37 @@
+// Web App Origin Migration moves the *installation* (icons, shortcuts) only.
+// localStorage is per-origin, so pull the user's saved settings from the old
+// origin once, through a bridge page the old origin hosts.
+const OLD_ORIGIN = 'https://app.dailygrind.coffee';
+const PREFIX = 'dg:';
+const DONE_KEY = 'dg:migrated-from-legacy';
+
+if (!localStorage.getItem(DONE_KEY)) {
+  const iframe = document.createElement('iframe');
+  iframe.src = `${OLD_ORIGIN}/migration-bridge.html`;
+  iframe.hidden = true;
+  iframe.title = 'Settings migration';
+
+  const cleanup = () => {
+    window.removeEventListener('message', onMessage);
+    iframe.remove();
+  };
+
+  function onMessage(event) {
+    if (event.origin !== OLD_ORIGIN || event.source !== iframe.contentWindow) return;
+    const { type, settings } = event.data ?? {};
+    if (type !== 'dg-settings' || typeof settings !== 'object' || settings === null) return;
+
+    for (const [key, value] of Object.entries(settings)) {
+      // Only accept our own namespaced string values; never overwrite newer local data.
+      if (key.startsWith(PREFIX) && typeof value === 'string' && localStorage.getItem(key) === null) {
+        localStorage.setItem(key, value);
+      }
+    }
+    localStorage.setItem(DONE_KEY, new Date().toISOString());
+    cleanup();
+  }
+
+  window.addEventListener('message', onMessage);
+  setTimeout(cleanup, 10000); // old origin unreachable: retry on next visit
+  document.body.append(iframe);
+}
