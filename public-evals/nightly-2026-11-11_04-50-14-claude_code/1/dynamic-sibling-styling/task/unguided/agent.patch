+  <script>
+    // Fallback for browsers without CSS sibling-index()/sibling-count():
+    // expose the same --i / --n variables and keep them in sync as items change.
+    if (!CSS.supports('z-index', 'sibling-index()')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const update = () => {
+        const parents = new Set([...document.querySelectorAll(selector)].map(el => el.parentElement));
+        parents.forEach(parent => {
+          const kids = [...parent.children];
+          kids.forEach((el, i) => {
+            el.style.setProperty('--i', i);
+            el.style.setProperty('--n', kids.length);
+          });
+        });
+      };
+      update();
+      new MutationObserver(update).observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
+
