+    /* ------------------------------------------------------------------
+       Dynamic index/count helpers
+       --i = zero-based position among siblings, --n = number of siblings.
+       Native sibling-index()/sibling-count() are used where supported; a tiny
+       script at the end of <body> provides the same variables otherwise.
+       Nothing below hard-codes item counts, so adding/removing items just works.
+       ------------------------------------------------------------------ */
+    @supports (z-index: sibling-index()) {
+      :is(.spectrum-card, .fan-card, .circle-orb) {
+        --i: calc(sibling-index() - 1);
+        --n: sibling-count();
+      }
