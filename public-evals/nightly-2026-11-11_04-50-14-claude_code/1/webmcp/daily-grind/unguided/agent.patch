+  <script>
+    (() => {
+      'use strict';
+
+      // ---- Menu data -------------------------------------------------------
+      const MENU = {
+        'maple-oat-latte': { name: 'Maple Oat Latte', basePrice: 5.25, milkOptions: ['oat', 'whole', 'skim', 'almond'], defaultMilk: 'oat' },
+        'dark-roast-espresso': { name: 'Dark Roast Espresso', basePrice: 3.50, milkOptions: null },
+        'cold-brew': { name: 'Cold Brew', basePrice: 4.75, milkOptions: null }
+      };
+      const SIZES = { small: 0, medium: 0.5, large: 1.0 };
+      const MAX_QTY = 10;
+      const STORAGE_KEY = 'dailyGrind.order';
+
+      // ---- State -----------------------------------------------------------
+      let order = loadOrder();
+      let nextLineId = order.reduce((m, l) => Math.max(m, l.lineId), 0) + 1;
+
+      function loadOrder() {
+        try {
+          const raw = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
+          return Array.isArray(raw) ? raw.filter(l => MENU[l.drinkId]) : [];
+        } catch { return []; }
+      }
+      function saveOrder() {
+        try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch { /* ignore */ }
+      }
+
+      const money = n => n.toFixed(2);
+      const unitPrice = (drinkId, size) => MENU[drinkId].basePrice + SIZES[size];
+      const orderTotal = () => order.reduce((sum, l) => sum + l.unitPrice * l.quantity, 0);
+
+      function describeLine(l) {
+        const milk = l.milk ? `, ${l.milk} milk` : '';
+        return `${l.quantity} × ${l.size} ${l.name}${milk}`;
+      }
+
+      function snapshot() {
+        return {
+          items: order.map(l => ({
+            lineId: l.lineId,
+            drinkId: l.drinkId,
+            name: l.name,
+            size: l.size,
+            milk: l.milk || null,
+            quantity: l.quantity,
+            unitPrice: Number(money(l.unitPrice)),
+            lineTotal: Number(money(l.unitPrice * l.quantity))
+          })),
+          total: Number(money(orderTotal())),
+          currency: 'USD'
+        };
+      }
+
+      // ---- Core actions (shared by UI and agent tools) ---------------------
+      function addToOrder({ drinkId, size = 'medium', quantity = 1, milk } = {}) {
+        const item = MENU[drinkId];
+        if (!item) throw new Error(`Unknown drink "${drinkId}". Valid options: ${Object.keys(MENU).join(', ')}.`);
+        if (!(size in SIZES)) throw new Error(`Invalid size "${size}". Valid sizes: ${Object.keys(SIZES).join(', ')}.`);
+        quantity = Number(quantity);
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QTY) {
+          throw new Error(`Quantity must be a whole number between 1 and ${MAX_QTY}.`);
+        }
+        if (item.milkOptions) {
+          milk = milk || item.defaultMilk;
+          if (!item.milkOptions.includes(milk)) {
+            throw new Error(`Invalid milk "${milk}" for ${item.name}. Options: ${item.milkOptions.join(', ')}.`);
+          }
+        } else if (milk) {
+          throw new Error(`${item.name} does not take a milk option.`);
+        } else {
+          milk = undefined;
+        }
+
+        const existing = order.find(l => l.drinkId === drinkId && l.size === size && (l.milk || null) === (milk || null));
+        let line;
+        if (existing) {
+          if (existing.quantity + quantity > MAX_QTY) {
+            throw new Error(`You can order at most ${MAX_QTY} of the same drink.`);
+          }
+          existing.quantity += quantity;
+          line = existing;
+        } else {
+          line = { lineId: nextLineId++, drinkId, name: item.name, size, milk, quantity, unitPrice: unitPrice(drinkId, size) };
+          order.push(line);
+        }
+        commit(`Added ${quantity} × ${size} ${item.name} to your order.`);
+        return line;
+      }
+
+      function removeFromOrder(lineId) {
+        const idx = order.findIndex(l => l.lineId === Number(lineId));
+        if (idx === -1) throw new Error(`No order line with id ${lineId}.`);
+        const [removed] = order.splice(idx, 1);
+        commit(`Removed ${removed.name} from your order.`);
+        return removed;
+      }
+
+      function clearOrder() {
+        order = [];
+        commit('Order cleared.');
+      }
+
+      function placeOrder() {
+        if (!order.length) throw new Error('Your order is empty. Add a drink before placing the order.');
+        const confirmation = {
+          confirmationNumber: 'DG-' + Date.now().toString(36).toUpperCase(),
+          ...snapshot(),
+          estimatedReadyMinutes: 5 + order.reduce((n, l) => n + l.quantity, 0) * 2
+        };
+        order = [];
+        commit(`Order ${confirmation.confirmationNumber} placed! Total $${money(confirmation.total)}. Ready in about ${confirmation.estimatedReadyMinutes} minutes.`);
+        return confirmation;
+      }
+
+      // ---- Rendering -------------------------------------------------------
+      const els = {
+        items: document.getElementById('order-items'),
+        empty: document.getElementById('order-empty'),
+        total: document.getElementById('order-total'),
+        status: document.getElementById('order-status'),
+        place: document.getElementById('place-order'),
+        clear: document.getElementById('clear-order')
+      };
+
+      function setStatus(msg, isError = false) {
+        els.status.textContent = msg;
+        els.status.classList.toggle('error', isError);
+      }
+
+      function render() {
+        els.items.replaceChildren(...order.map(l => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = describeLine(l);
+          const right = document.createElement('span');
+          right.textContent = `$${money(l.unitPrice * l.quantity)} `;
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.textContent = 'Remove';
+          btn.setAttribute('aria-label', `Remove ${describeLine(l)}`);
+          btn.addEventListener('click', () => removeFromOrder(l.lineId));
+          right.appendChild(btn);
+          li.append(label, right);
+          return li;
+        }));
+        els.empty.hidden = order.length > 0;
+        els.total.textContent = money(orderTotal());
+        els.place.disabled = els.clear.disabled = order.length === 0;
+      }
+
+      function commit(message) {
+        saveOrder();
+        render();
+        if (message) setStatus(message);
+      }
+
+      // ---- UI wiring -------------------------------------------------------
+      document.querySelectorAll('.order-form').forEach(form => {
+        form.addEventListener('submit', e => {
+          e.preventDefault();
+          const data = new FormData(form);
+          try {
+            addToOrder({
+              drinkId: form.dataset.drinkId,
+              size: data.get('size'),
+              quantity: data.get('quantity'),
+              milk: data.get('milk') || undefined
+            });
+            form.reset();
+          } catch (err) {
+            setStatus(err.message, true);
+          }
+        });
+      });
+      els.clear.addEventListener('click', clearOrder);
+      els.place.addEventListener('click', () => {
+        try { placeOrder(); } catch (err) { setStatus(err.message, true); }
+      });
+      render();
+
+      // ---- Browser AI agent tools (WebMCP: navigator.modelContext) ---------
+      const ok = data => ({ content: [{ type: 'text', text: JSON.stringify(data) }] });
+      const fail = err => ({ content: [{ type: 'text', text: `Error: ${err.message}` }], isError: true });
+      const wrap = fn => async (input, client) => {
+        try { return ok(await fn(input || {}, client)); } catch (err) { return fail(err); }
+      };
+
+      const tools = [
+        {
+          name: 'list_seasonal_drinks',
+          description: 'List the Seasonal Favorites drinks available to order at The Daily Grind, with ids, prices, sizes and milk options.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: wrap(() => ({
+            drinks: Object.entries(MENU).map(([id, d]) => ({
+              drinkId: id,
+              name: d.name,
+              prices: Object.fromEntries(Object.keys(SIZES).map(sz => [sz, Number(money(unitPrice(id, sz)))])),
+              milkOptions: d.milkOptions,
+              defaultMilk: d.defaultMilk || null
+            })),
+            currency: 'USD',
+            maxQuantityPerItem: MAX_QTY
+          }))
+        },
+        {
+          name: 'add_drink_to_order',
+          description: 'Add a Seasonal Favorites drink to the customer\'s current order (cart). Does not place the order.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drinkId: { type: 'string', enum: Object.keys(MENU), description: 'Drink to add.' },
+              size: { type: 'string', enum: Object.keys(SIZES), default: 'medium', description: 'Cup size.' },
+              quantity: { type: 'integer', minimum: 1, maximum: MAX_QTY, default: 1, description: 'Number of drinks.' },
+              milk: { type: 'string', enum: MENU['maple-oat-latte'].milkOptions, description: 'Milk choice. Only valid for maple-oat-latte (defaults to oat).' }
+            },
+            required: ['drinkId']
+          },
+          execute: wrap(input => ({ added: addToOrder(input), order: snapshot() }))
+        },
+        {
+          name: 'view_current_order',
+          description: 'Get the items and total of the customer\'s current, not-yet-placed order.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: wrap(() => snapshot())
+        },
+        {
+          name: 'remove_drink_from_order',
+          description: 'Remove a line item from the current order by its lineId (from view_current_order).',
+          inputSchema: {
+            type: 'object',
+            properties: { lineId: { type: 'integer', description: 'Line item id to remove.' } },
+            required: ['lineId']
+          },
+          execute: wrap(({ lineId }) => ({ removed: removeFromOrder(lineId).name, order: snapshot() }))
+        },
+        {
+          name: 'clear_order',
+          description: 'Remove all items from the current order.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: wrap(() => { clearOrder(); return snapshot(); })
+        },
+        {
+          name: 'place_order',
+          description: 'Submit the current order for pickup. The customer is asked to confirm in the page before the order is placed. Returns a confirmation number.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: wrap(async (_input, client) => {
+            if (!order.length) throw new Error('Your order is empty. Add a drink before placing the order.');
+            const summary = order.map(describeLine).join('\n');
+            const question = `Place this order for $${money(orderTotal())}?\n\n${summary}`;
+            const confirmed = client && typeof client.requestUserInteraction === 'function'
+              ? await client.requestUserInteraction(async () => window.confirm(question))
+              : window.confirm(question);
+            if (!confirmed) throw new Error('The customer declined to place the order.');
+            return placeOrder();
+          })
+        }
+      ];
+
+      // Also expose on window for agents/scripts that drive the page directly.
+      window.dailyGrindOrdering = { tools, addToOrder, removeFromOrder, clearOrder, placeOrder, getOrder: snapshot };
+
+      const mc = navigator.modelContext;
+      if (mc) {
+        try {
+          if (typeof mc.registerTool === 'function') {
+            tools.forEach(t => mc.registerTool(t));
+          } else if (typeof mc.provideContext === 'function') {
+            mc.provideContext({ tools });
+          }
+        } catch (err) {
+          console.warn('Failed to register ordering tools with navigator.modelContext:', err);
+        }
+      }
+    })();
+  </script>
 </body>
 
