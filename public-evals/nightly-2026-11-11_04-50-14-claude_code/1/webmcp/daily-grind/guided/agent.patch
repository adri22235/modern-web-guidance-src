+  <script>
+    (() => {
+      const MENU = {
+        'maple-oat-latte': { name: 'Maple Oat Latte', basePrice: 5.75 },
+        'dark-roast-espresso': { name: 'Dark Roast Espresso', basePrice: 3.25 },
+        'cold-brew': { name: 'Cold Brew', basePrice: 4.50 },
+      };
+      const SIZES = { small: 0, medium: 0.5, large: 1.0 };
+      const DRINK_IDS = Object.keys(MENU);
+      const SIZE_IDS = Object.keys(SIZES);
+      const MAX_QTY = 10;
+      const STORAGE_KEY = 'daily-grind-order';
+
+      const money = (n) => `$${n.toFixed(2)}`;
+      const unitPrice = (drink, size) => MENU[drink].basePrice + SIZES[size];
+
+      // ----- Order state -----
+      let order = [];
+      try {
+        const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
+        if (Array.isArray(saved)) {
+          order = saved.filter((i) => MENU[i.drink] && i.size in SIZES && Number.isInteger(i.quantity) && i.quantity > 0);
+        }
+      } catch { /* ignore corrupt storage */ }
+
+      const save = () => sessionStorage.setItem(STORAGE_KEY, JSON.stringify(order));
+
+      function summary() {
+        const items = order.map((i, index) => ({
+          index,
+          drink: i.drink,
+          name: MENU[i.drink].name,
+          size: i.size,
+          quantity: i.quantity,
+          unitPrice: unitPrice(i.drink, i.size),
+          lineTotal: +(unitPrice(i.drink, i.size) * i.quantity).toFixed(2),
+        }));
+        const total = +items.reduce((sum, i) => sum + i.lineTotal, 0).toFixed(2);
+        return { items, total, formattedTotal: money(total) };
+      }
+
+      function validate(drink, size, quantity) {
+        if (!DRINK_IDS.includes(drink)) return `Unknown drink "${drink}". Choose one of: ${DRINK_IDS.join(', ')}.`;
+        if (!SIZE_IDS.includes(size)) return `Unknown size "${size}". Choose one of: ${SIZE_IDS.join(', ')}.`;
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QTY) return `Quantity must be a whole number from 1 to ${MAX_QTY}.`;
+        return null;
+      }
+
+      function addItem(drink, size, quantity) {
+        const error = validate(drink, size, quantity);
+        if (error) return { error };
+        const existing = order.find((i) => i.drink === drink && i.size === size);
+        if (existing) {
+          if (existing.quantity + quantity > MAX_QTY) {
+            return { error: `At most ${MAX_QTY} of the same drink and size per order (currently ${existing.quantity}).` };
+          }
+          existing.quantity += quantity;
+        } else {
+          order.push({ drink, size, quantity });
+        }
+        save();
+        render();
+        announce(`Added ${quantity} × ${size} ${MENU[drink].name} to your order.`);
+        return null;
+      }
+
+      function removeItem(index) {
+        if (!Number.isInteger(index) || !order[index]) {
+          return { error: `No order line at index ${index}.` };
+        }
+        const [removed] = order.splice(index, 1);
+        save();
+        render();
+        announce(`Removed ${removed.size} ${MENU[removed.drink].name} from your order.`);
+        return null;
+      }
+
+      function clearOrder() {
+        order = [];
+        save();
+        render();
+      }
+
+      // ----- Rendering -----
+      const list = document.querySelector('.order-list');
+      const empty = document.querySelector('.order-empty');
+      const totalEl = document.querySelector('.order-total-amount');
+      const placeBtn = document.querySelector('.place-order');
+      const clearBtn = document.querySelector('.clear-order');
+      const statusEl = document.querySelector('.order-status');
+      const dialog = document.querySelector('.confirm-dialog');
+
+      function announce(msg) {
+        statusEl.textContent = msg;
+      }
+
+      function render() {
+        const { items, formattedTotal } = summary();
+        list.replaceChildren(...items.map((i) => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${i.quantity} × ${i.name} (${i.size})`;
+          const right = document.createElement('span');
+          right.textContent = `${money(i.lineTotal)} `;
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.className = 'remove';
+          btn.textContent = 'Remove';
+          btn.setAttribute('aria-label', `Remove ${i.name} (${i.size})`);
+          btn.addEventListener('click', () => removeItem(i.index));
+          right.append(btn);
+          li.append(label, right);
+          return li;
+        }));
+        empty.hidden = items.length > 0;
+        totalEl.textContent = formattedTotal;
+        placeBtn.disabled = clearBtn.disabled = items.length === 0;
+      }
+
+      // ----- Checkout (always requires the user to confirm in the dialog) -----
+      let pendingConfirmation = null;
+
+      function confirmAndPlace(signal) {
+        if (order.length === 0) return Promise.resolve({ error: 'The order is empty. Add drinks before placing an order.' });
+        if (pendingConfirmation) return Promise.resolve({ error: 'A confirmation is already awaiting the user.' });
+
+        const { items, formattedTotal } = summary();
+        dialog.querySelector('.confirm-items').replaceChildren(...items.map((i) => {
+          const li = document.createElement('li');
+          li.textContent = `${i.quantity} × ${i.name} (${i.size}) — ${money(i.lineTotal)}`;
+          return li;
+        }));
+        dialog.querySelector('.confirm-total').textContent = formattedTotal;
+        dialog.returnValue = '';
+
+        pendingConfirmation = new Promise((resolve, reject) => {
+          const onAbort = () => {
+            dialog.removeEventListener('close', onClose);
+            dialog.close();
+            reject(signal.reason ?? new DOMException('Aborted', 'AbortError'));
+          };
+          const onClose = () => {
+            signal?.removeEventListener('abort', onAbort);
+            if (dialog.returnValue !== 'confirm') {
+              announce('Order not placed.');
+              resolve({ status: 'cancelled', message: 'The user declined to place the order.' });
+              return;
+            }
+            const placed = summary();
+            const orderNumber = `DG-${Date.now().toString(36).toUpperCase()}`;
+            clearOrder();
+            announce(`Thanks! Order ${orderNumber} placed — total ${placed.formattedTotal}.`);
+            resolve({ status: 'placed', orderNumber, items: placed.items, total: placed.total });
+          };
+          dialog.addEventListener('close', onClose, { once: true });
+          signal?.addEventListener('abort', onAbort, { once: true });
+          dialog.showModal();
+        }).finally(() => { pendingConfirmation = null; });
+
+        return pendingConfirmation;
+      }
+
+      // ----- UI wiring -----
+      document.querySelectorAll('.order-form').forEach((form) => {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const data = new FormData(form);
+          const result = addItem(form.dataset.drink, data.get('size'), Number(data.get('quantity')));
+          if (result?.error) announce(result.error);
+          else form.reset();
+        });
+      });
+      placeBtn.addEventListener('click', () => confirmAndPlace());
+      clearBtn.addEventListener('click', () => {
+        clearOrder();
+        announce('Your order was cleared.');
+      });
+
+      render();
+
+      // ----- WebMCP: expose ordering actions to browser AI agents -----
+      if ('modelContext' in document) {
+        const mc = document.modelContext;
+        const tools = [
+          {
+            name: 'get_seasonal_menu',
+            description: 'Lists the seasonal favorite drinks available to order, with their IDs, descriptions, and prices for each size.',
+            inputSchema: { type: 'object', properties: {} },
+            execute() {
+              return DRINK_IDS.map((id) => ({
+                drink: id,
+                name: MENU[id].name,
+                description: document.querySelector(`.card[data-drink="${id}"] p`)?.textContent ?? '',
+                prices: Object.fromEntries(SIZE_IDS.map((s) => [s, unitPrice(id, s)])),
+              }));
+            },
+            annotations: { readOnlyHint: true },
+          },
+          {
+            name: 'add_drink_to_order',
+            description: 'Adds a seasonal drink to the customer\'s current order. Repeated additions of the same drink and size are combined.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                drink: { type: 'string', enum: DRINK_IDS, description: 'Which seasonal drink to add.' },
+                size: { type: 'string', enum: SIZE_IDS, default: 'medium', description: 'Cup size; larger sizes cost more.' },
+                quantity: { type: 'integer', minimum: 1, maximum: MAX_QTY, default: 1, description: 'How many cups of this drink to add.' },
+              },
+              required: ['drink'],
+            },
+            execute({ drink, size = 'medium', quantity = 1 }) {
+              const result = addItem(drink, size, quantity);
+              return result ?? { status: 'added', order: summary() };
+            },
+          },
+          {
+            name: 'remove_drink_from_order',
+            description: 'Removes one line from the customer\'s current order. Use get_current_order to find the line index.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                index: { type: 'integer', minimum: 0, description: 'Position of the line in the current order, as reported by get_current_order.' },
+              },
+              required: ['index'],
+            },
+            execute({ index }) {
+              const result = removeItem(index);
+              return result ?? { status: 'removed', order: summary() };
+            },
+          },
+          {
+            name: 'get_current_order',
+            description: 'Returns the drinks in the customer\'s current order and the running total.',
+            inputSchema: { type: 'object', properties: {} },
+            execute: () => summary(),
+            annotations: { readOnlyHint: true },
+          },
+          {
+            name: 'place_order',
+            description: 'Submits the current order for pickup. The customer is shown a confirmation dialog and must approve it on the page.',
+            inputSchema: { type: 'object', properties: {} },
+            execute: (_input, { signal } = {}) => confirmAndPlace(signal),
+            annotations: { readOnlyHint: false, consequentialHint: true },
+          },
+        ];
+
+        const controller = new AbortController();
+        for (const tool of tools) {
+          Promise.resolve(mc.registerTool(tool, { signal: controller.signal }))
+            .catch((err) => console.warn(`WebMCP: failed to register ${tool.name}`, err));
+        }
+      }
+    })();
+  </script>
+
 </body>
 
