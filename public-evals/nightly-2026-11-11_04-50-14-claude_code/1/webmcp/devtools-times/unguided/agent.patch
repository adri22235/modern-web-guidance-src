+---
+import Layout from '../layouts/Layout.astro';
+import ArticleTeaser from '../components/ArticleTeaser.astro';
+import { getCollection } from 'astro:content';
+
+const baseUrl = import.meta.env.BASE_URL;
+const articles = await getCollection('articles');
+articles.sort((a, b) => a.data.title.localeCompare(b.data.title));
+
+// No-JS fallback: handle the form POST on the server, then redirect (POST/redirect/GET).
+if (Astro.request.method === 'POST') {
+  const form = await Astro.request.formData();
+  const slug = String(form.get('slug') ?? '');
+  const action = String(form.get('action') ?? 'add');
+  if (articles.some((a) => a.id === slug)) {
+    let list: string[] = (await Astro.session?.get('readingList')) || [];
+    list = list.filter((s) => s !== slug);
+    if (action !== 'remove') list.push(slug);
+    await Astro.session?.set('readingList', list);
+  }
+  return Astro.redirect(`${baseUrl}reading-list`, 303);
+}
+
+const readingList: string[] = (await Astro.session?.get('readingList')) || [];
+const saved = readingList
+  .map((slug) => articles.find((a) => a.id === slug))
+  .filter((a): a is (typeof articles)[number] => !!a);
+---
+
+<Layout title="Your Reading List | The DevTools Times">
+  <div class="max-w-6xl mx-auto px-4 md:px-6 py-8">
+    <h1 class="text-3xl md:text-4xl font-brand text-gray-900 mb-6">Your Reading List</h1>
+
+    <!-- Exposed to in-browser AI agents as the WebMCP tool "update_reading_list". -->
+    <form
+      method="post"
+      action={`${baseUrl}reading-list`}
+      class="flex flex-wrap gap-2 items-end mb-8 p-4 bg-gray-50 border border-gray-200 rounded-md"
+      data-webmcp-form="reading-list"
+      toolname="update_reading_list"
+      tooldescription="Add an article to, or remove an article from, the reader's saved reading list on The DevTools Times. Returns the updated reading list."
+      toolautosubmit
+    >
+      <label class="flex-grow min-w-[14rem]">
+        <span class="block text-sm font-semibold text-gray-700 mb-1">Article</span>
+        <select
+          name="slug"
+          required
+          class="w-full p-2 border border-gray-300 rounded-md"
+          toolparamtitle="Article"
+          toolparamdescription="The article to add or remove, identified by its slug."
+        >
+          {articles.map((a) => <option value={a.id}>{a.data.title}</option>)}
+        </select>
+      </label>
+      <label>
+        <span class="block text-sm font-semibold text-gray-700 mb-1">Action</span>
+        <select
+          name="action"
+          class="p-2 border border-gray-300 rounded-md"
+          toolparamtitle="Action"
+          toolparamdescription="Whether to add the article to the reading list or remove it."
+        >
+          <option value="add">Add to reading list</option>
+          <option value="remove">Remove from reading list</option>
+        </select>
+      </label>
+      <button type="submit" class="bg-gray-800 text-white font-semibold py-2 px-4 rounded hover:bg-gray-700">Update</button>
+    </form>
+
+    {saved.length > 0 ? (
+      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" data-reading-list>
+        {saved.map((article) => <ArticleTeaser article={article} />)}
+      </div>
+    ) : (
+      <p class="text-gray-500 text-center py-12">Your reading list is empty.</p>
+    )}
+  </div>
+</Layout>
diff --git a/src/pages/search.astro b/src/pages/search.astro
new file mode 100644
index 0000000..8fe6c9c
--- /dev/null
+++ b/src/pages/search.astro
@@ -0,0 +1,71 @@
+---
+import Layout from '../layouts/Layout.astro';
+import ArticleTeaser from '../components/ArticleTeaser.astro';
+import { getCollection } from 'astro:content';
+import { searchArticles } from '../utils/search';
+
+const query = (Astro.url.searchParams.get('q') ?? '').trim();
+const category = (Astro.url.searchParams.get('category') ?? '').trim().toLowerCase();
+
+const articles = await getCollection('articles');
+const categories = [...new Set(articles.map((a) => a.data.category.toLowerCase()))].sort();
+
+const matches = searchArticles(
+  articles.map((entry) => ({
+    slug: entry.id,
+    title: entry.data.title,
+    summary: entry.data.summary,
+    category: entry.data.category,
+    author: entry.data.author,
+    tags: entry.data.tags,
+    entry,
+  })),
+  query,
+  category,
+).map((m) => m.entry);
+---
+
+<Layout title={query ? `Search: ${query} | The DevTools Times` : 'Search | The DevTools Times'}>
+  <div class="max-w-6xl mx-auto px-4 md:px-6 py-8">
+    <h1 class="text-3xl md:text-4xl font-brand text-gray-900 mb-6">Search</h1>
+
+    <!-- Refinement form for humans. The agent-facing search tool lives in the footer
+         (toolname="search_articles") so it is available on every page. -->
+    <form role="search" method="get" action={`${import.meta.env.BASE_URL}search`} class="flex flex-wrap gap-2 mb-8">
+      <input
+        type="search"
+        name="q"
+        value={query}
+        placeholder="Search for articles..."
+        aria-label="Search query"
+        class="flex-grow min-w-[12rem] p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent"
+      />
+      <select name="category" aria-label="Category" class="p-2 border border-gray-300 rounded-md">
+        <option value="">All categories</option>
+        {categories.map((c) => (
+          <option value={c} selected={c === category}>{c.charAt(0).toUpperCase() + c.slice(1)}</option>
+        ))}
+      </select>
+      <button type="submit" class="bg-gray-800 text-white font-semibold py-2 px-4 rounded hover:bg-gray-700">Search</button>
+    </form>
+
+    {(query || category) ? (
+      <>
+        <p class="text-gray-600 mb-6" data-search-summary>
+          {matches.length} {matches.length === 1 ? 'result' : 'results'}
+          {query && <> for “<strong>{query}</strong>”</>}
+          {category && <> in <strong>{category}</strong></>}
+        </p>
+        {matches.length > 0 ? (
+          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
+            {matches.map((article) => <ArticleTeaser article={article} />)}
+          </div>
+        ) : (
+          <p class="text-gray-500 text-center py-12">No articles found. Try different keywords.</p>
+        )}
+      </>
+    ) : (
+      <p class="text-gray-500">Enter a keyword to search all articles.</p>
+    )}
+  </div>
+</Layout>
diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..1936812
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,466 @@
+/**
+ * WebMCP integration for The DevTools Times.
+ *
+ * Exposes the site to in-browser AI agents in two ways:
+ *
+ * 1. Declarative tools: <form toolname="…"> elements in the markup
+ *    (`search_articles` in the footer, `update_reading_list` on /reading-list).
+ *    The browser derives their schemas from the form fields. This module only
+ *    intercepts agent-invoked submissions so the agent gets structured data back
+ *    via `SubmitEvent.respondWith()` instead of a page navigation.
+ *
+ * 2. Imperative tools: registered with `navigator.modelContext.registerTool()`.
+ *    Site-wide tools are registered once; article tools are (re)registered on every
+ *    Astro page load because <ClientRouter /> swaps pages without a full reload.
+ *
+ * Everything is feature-detected, so browsers without WebMCP are unaffected.
+ */
+import { navigate } from 'astro:transitions/client';
+import { searchArticles } from '../utils/search';
+
+const BASE = import.meta.env.BASE_URL;
+
+interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+  author: string;
+  date: string;
+  readingTime?: number;
+  tags?: string[];
+  image?: string;
+}
+
+// ---------------------------------------------------------------------------
+// Data helpers
+// ---------------------------------------------------------------------------
+
+let articlesPromise: Promise<ArticleSummary[]> | null = null;
+
+function getArticles(): Promise<ArticleSummary[]> {
+  articlesPromise ??= fetch(`${BASE}api/articles.json`)
+    .then((r) => {
+      if (!r.ok) throw new Error(`Failed to load articles (HTTP ${r.status})`);
+      return r.json();
+    })
+    .catch((err) => {
+      articlesPromise = null; // allow a retry on the next call
+      throw err;
+    });
+  return articlesPromise;
+}
+
+function articleUrl(slug: string) {
+  return new URL(`${BASE}articles/${slug}`, location.origin).href;
+}
+
+function describe(a: ArticleSummary) {
+  return {
+    slug: a.slug,
+    title: a.title,
+    summary: a.summary,
+    category: a.category,
+    author: a.author,
+    date: a.date,
+    readingTimeMinutes: a.readingTime ?? null,
+    url: articleUrl(a.slug),
+  };
+}
+
+async function getReadingList() {
+  const [res, articles] = await Promise.all([
+    fetch(`${BASE}api/reading-list.json`, { credentials: 'same-origin' }),
+    getArticles(),
+  ]);
+  if (!res.ok) throw new Error(`Failed to load reading list (HTTP ${res.status})`);
+  const { readingList } = (await res.json()) as { readingList: string[] };
+  return readingList
+    .map((slug) => articles.find((a) => a.slug === slug))
+    .filter((a): a is ArticleSummary => !!a)
+    .map(describe);
+}
+
+async function updateReadingList(slug: string, action: 'add' | 'remove') {
+  const articles = await getArticles();
+  const article = articles.find((a) => a.slug === slug);
+  if (!article) throw new Error(`Unknown article slug: "${slug}"`);
+
+  const res = await fetch(`${BASE}api/reading-list.json`, {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, action }),
+  });
+  if (!res.ok) throw new Error(`Failed to update reading list (HTTP ${res.status})`);
+  const { readingList } = (await res.json()) as { readingList: string[] };
+  return {
+    action,
+    article: describe(article),
+    readingList: readingList
+      .map((s) => articles.find((a) => a.slug === s))
+      .filter((a): a is ArticleSummary => !!a)
+      .map(describe),
+  };
+}
+
+// --- Current-article DOM helpers -------------------------------------------
+
+function currentArticle() {
+  const el = document.querySelector<HTMLElement>('article[data-article-slug]');
+  const body = el?.querySelector<HTMLElement>('[data-article-body]');
+  if (!el || !body) return null;
+  const d = el.dataset;
+  return {
+    el,
+    body,
+    meta: {
+      slug: d.articleSlug!,
+      title: d.articleTitle ?? '',
+      summary: d.articleSummary ?? '',
+      author: d.articleAuthor ?? '',
+      category: d.articleCategory ?? '',
+      date: d.articleDate ?? '',
+      readingTimeMinutes: d.articleReadingTime ? Number(d.articleReadingTime) : null,
+      url: location.href,
+    },
+  };
+}
+
+/** Readable text blocks of the article body (ignores inline <script>/<style>). */
+function articleBlocks(body: HTMLElement) {
+  const blocks: { type: 'heading' | 'paragraph' | 'list-item' | 'quote'; level?: number; text: string; el: HTMLElement }[] = [];
+  body.querySelectorAll<HTMLElement>('h1,h2,h3,h4,h5,h6,p,li,blockquote').forEach((el) => {
+    if (el.closest('script,style')) return;
+    // Avoid double counting: paragraphs inside list items / quotes are covered by their parent.
+    if (el.tagName === 'P' && el.parentElement?.closest('li,blockquote')) return;
+    const text = el.textContent?.replace(/\s+/g, ' ').trim();
+    if (!text) return;
+    const tag = el.tagName;
+    if (tag.startsWith('H')) blocks.push({ type: 'heading', level: Number(tag[1]), text, el });
+    else if (tag === 'LI') blocks.push({ type: 'list-item', text, el });
+    else if (tag === 'BLOCKQUOTE') blocks.push({ type: 'quote', text, el });
+    else blocks.push({ type: 'paragraph', text, el });
+  });
+  return blocks;
+}
+
+function blocksToText(blocks: ReturnType<typeof articleBlocks>) {
+  return blocks
+    .map((b) => (b.type === 'heading' ? `${'#'.repeat(b.level!)} ${b.text}` : b.type === 'list-item' ? `- ${b.text}` : b.type === 'quote' ? `> ${b.text}` : b.text))
+    .join('\n\n');
+}
+
+function countWords(text: string) {
+  return text.split(/\s+/).filter(Boolean).length;
+}
+
+// ---------------------------------------------------------------------------
+// Imperative tool registration
+// ---------------------------------------------------------------------------
+
+type Json = Record<string, unknown>;
+
+function result(data: unknown) {
+  return { content: [{ type: 'text' as const, text: JSON.stringify(data, null, 2) }] };
+}
+
+function errorResult(message: string) {
+  return { content: [{ type: 'text' as const, text: message }], isError: true };
+}
+
+/** Wrap a tool implementation so thrown errors become a tool error, not a rejected promise. */
+function tool(def: Omit<ModelContextTool, 'execute'> & { execute: (input: Json) => unknown | Promise<unknown> }): ModelContextTool {
+  return {
+    ...def,
+    async execute(input: Json) {
+      try {
+        return result(await def.execute(input ?? {}));
+      } catch (err) {
+        return errorResult(err instanceof Error ? err.message : String(err));
+      }
+    },
+  };
+}
+
+/** Registers a tool, returning a cleanup function. Supports both the current
+ * (`unregisterTool(name)`) and earlier (`registration.unregister()`) API shapes. */
+function register(def: ModelContextTool): () => void {
+  const mc = navigator.modelContext;
+  if (!mc?.registerTool) return () => {};
+  try {
+    const registration = mc.registerTool(def);
+    return () => {
+      try {
+        if (registration && typeof registration.unregister === 'function') registration.unregister();
+        else mc.unregisterTool?.(def.name);
+      } catch {
+        /* already gone */
+      }
+    };
+  } catch (err) {
+    console.warn(`[webmcp] Could not register tool "${def.name}":`, err);
+    return () => {};
+  }
+}
+
+const siteTools: ModelContextTool[] = [
+  tool({
+    name: 'list_articles',
+    description:
+      'List articles published on The DevTools Times, newest first. Optionally filter by category. Returns slug, title, summary, category, author, date, reading time and URL for each article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: { type: 'string', description: 'Only return articles in this category (case-insensitive), e.g. "sports". Use list_categories to see valid values.' },
+        limit: { type: 'integer', minimum: 1, maximum: 100, description: 'Maximum number of articles to return. Defaults to 20.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    async execute({ category, limit }) {
+      const cat = typeof category === 'string' ? category.trim().toLowerCase() : '';
+      const max = typeof limit === 'number' && limit > 0 ? Math.min(limit, 100) : 20;
+      const articles = (await getArticles())
+        .filter((a) => !cat || a.category.toLowerCase() === cat)
+        .sort((a, b) => b.date.localeCompare(a.date));
+      return { total: articles.length, articles: articles.slice(0, max).map(describe) };
+    },
+  }),
+  tool({
+    name: 'list_categories',
+    description: 'List the news categories on The DevTools Times with the number of articles in each and the URL of the category page.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const counts = new Map<string, number>();
+      for (const a of await getArticles()) {
+        const c = a.category.toLowerCase();
+        counts.set(c, (counts.get(c) ?? 0) + 1);
+      }
+      return [...counts]
+        .sort(([a], [b]) => a.localeCompare(b))
+        .map(([category, articleCount]) => ({
+          category,
+          articleCount,
+          url: new URL(`${BASE}category/${encodeURIComponent(category)}`, location.origin).href,
+        }));
+    },
+  }),
+  tool({
+    name: 'get_reading_list',
+    description: "Get the articles currently saved in the reader's reading list. To change it, use the update_reading_list tool on the reading list page (open it with open_reading_list).",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    async execute() {
+      const articles = await getReadingList();
+      return { count: articles.length, articles, pageUrl: new URL(`${BASE}reading-list`, location.origin).href };
+    },
+  }),
+  tool({
+    name: 'open_article',
+    description: 'Navigate the current tab to an article on The DevTools Times so the user can read it. After navigating, article tools such as get_article_content become available.',
+    inputSchema: {
+      type: 'object',
+      properties: { slug: { type: 'string', description: 'The article slug, as returned by list_articles or search_articles.' } },
+      required: ['slug'],
+    },
+    async execute({ slug }) {
+      const article = (await getArticles()).find((a) => a.slug === slug);
+      if (!article) throw new Error(`Unknown article slug: "${String(slug)}". Use list_articles or search_articles to find valid slugs.`);
+      await navigate(`${BASE}articles/${article.slug}`);
+      return { navigatedTo: describe(article) };
+    },
+  }),
+  tool({
+    name: 'open_reading_list',
+    description: "Navigate the current tab to the reader's reading list page, where the update_reading_list tool is available.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute() {
+      await navigate(`${BASE}reading-list`);
+      return { navigatedTo: location.href };
+    },
+  }),
+];
+
+const articleTools: ModelContextTool[] = [
+  tool({
+    name: 'get_article_content',
+    description: 'Get the metadata and full text (as Markdown-style plain text) of the article currently open in the page.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        maxCharacters: { type: 'integer', minimum: 200, description: 'Truncate the article text to at most this many characters. Defaults to no limit.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    execute({ maxCharacters }) {
+      const a = currentArticle();
+      if (!a) throw new Error('No article is open. Use open_article first.');
+      let text = blocksToText(articleBlocks(a.body));
+      const truncated = typeof maxCharacters === 'number' && text.length > maxCharacters;
+      if (truncated) text = `${text.slice(0, maxCharacters as number)}…`;
+      return { ...a.meta, truncated, text };
+    },
+  }),
+  tool({
+    name: 'get_article_outline',
+    description: 'Get the section headings of the article currently open in the page, in document order.',
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute() {
+      const a = currentArticle();
+      if (!a) throw new Error('No article is open. Use open_article first.');
+      const headings = articleBlocks(a.body)
+        .filter((b) => b.type === 'heading')
+        .map((b) => ({ level: b.level, text: b.text }));
+      return { title: a.meta.title, headings };
+    },
+  }),
+  tool({
+    name: 'get_article_stats',
+    description: 'Compute reading statistics for the article currently open in the page: word count, paragraph and section counts, and estimated reading time.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        wordsPerMinute: { type: 'integer', minimum: 50, maximum: 1000, description: 'Reading speed used for the estimate. Defaults to 230.' },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    execute({ wordsPerMinute }) {
+      const a = currentArticle();
+      if (!a) throw new Error('No article is open. Use open_article first.');
+      const wpm = typeof wordsPerMinute === 'number' ? wordsPerMinute : 230;
+      const blocks = articleBlocks(a.body);
+      const words = countWords(blocks.map((b) => b.text).join(' '));
+      return {
+        title: a.meta.title,
+        wordCount: words,
+        paragraphCount: blocks.filter((b) => b.type === 'paragraph').length,
+        sectionCount: blocks.filter((b) => b.type === 'heading').length,
+        wordsPerMinute: wpm,
+        estimatedReadingTimeMinutes: Math.max(1, Math.round(words / wpm)),
+        publishedReadingTimeMinutes: a.meta.readingTimeMinutes,
+      };
+    },
+  }),
+  tool({
+    name: 'find_in_article',
+    description: 'Find passages in the article currently open in the page that contain the given text (case-insensitive). Returns each matching paragraph along with the section it belongs to.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        text: { type: 'string', description: 'The word or phrase to look for.' },
+        highlight: { type: 'boolean', description: 'Also scroll the first match into view and briefly highlight it for the user. Defaults to false.' },
+      },
+      required: ['text'],
+    },
+    annotations: { readOnlyHint: true },
+    execute({ text, highlight }) {
+      const a = currentArticle();
+      if (!a) throw new Error('No article is open. Use open_article first.');
+      const needle = String(text ?? '').trim().toLowerCase();
+      if (!needle) throw new Error('"text" must not be empty.');
+      let section: string | null = null;
+      const matches: { section: string | null; passage: string }[] = [];
+      let first: HTMLElement | null = null;
+      for (const b of articleBlocks(a.body)) {
+        if (b.type === 'heading') section = b.text;
+        if (b.text.toLowerCase().includes(needle)) {
+          matches.push({ section, passage: b.text });
+          first ??= b.el;
+        }
+      }
+      if (highlight && first) flash(first);
+      return { query: text, matchCount: matches.length, matches };
+    },
+  }),
+  tool({
+    name: 'scroll_to_article_section',
+    description: 'Scroll the article currently open in the page to the section whose heading best matches the given text, and briefly highlight it for the user.',
+    inputSchema: {
+      type: 'object',
+      properties: { heading: { type: 'string', description: 'Full or partial heading text, as returned by get_article_outline.' } },
+      required: ['heading'],
+    },
+    execute({ heading }) {
+      const a = currentArticle();
+      if (!a) throw new Error('No article is open. Use open_article first.');
+      const needle = String(heading ?? '').trim().toLowerCase();
+      const headings = articleBlocks(a.body).filter((b) => b.type === 'heading');
+      const match = headings.find((h) => h.text.toLowerCase() === needle) ?? headings.find((h) => h.text.toLowerCase().includes(needle));
+      if (!match) {
+        throw new Error(`No section matching "${String(heading)}". Available sections: ${headings.map((h) => h.text).join(' | ') || '(none)'}`);
+      }
+      flash(match.el);
+      return { scrolledTo: match.text };
+    },
+  }),
+];
+
+function flash(el: HTMLElement) {
+  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  el.animate(
+    [{ backgroundColor: 'rgb(251 191 36 / 0.45)' }, { backgroundColor: 'transparent' }],
+    { duration: 2000, easing: 'ease-out' },
+  );
+}
+
+// ---------------------------------------------------------------------------
+// Declarative form tools: return structured results to the agent
+// ---------------------------------------------------------------------------
+
+function onSubmit(event: SubmitEvent) {
+  const form = event.target;
+  if (!(form instanceof HTMLFormElement) || !event.agentInvoked || typeof event.respondWith !== 'function') return;
+
+  const kind = form.dataset.webmcpForm;
+  if (kind !== 'search' && kind !== 'reading-list') return;
+
+  // Handle the submission in-page (this also stops <ClientRouter /> from navigating),
+  // and hand the agent a structured result.
+  event.preventDefault();
+  const data = new FormData(form);
+
+  if (kind === 'search') {
+    const q = String(data.get('q') ?? '').trim();
+    const category = String(data.get('category') ?? '').trim();
+    const response = getArticles().then((articles) => {
+      const matches = searchArticles(articles, q, category);
+      const params = new URLSearchParams({ q });
+      if (category) params.set('category', category);
+      const resultsUrl = new URL(`${BASE}search?${params}`, location.origin).href;
+      // Show the same results to the user without blocking the agent's response.
+      queueMicrotask(() => void navigate(resultsUrl));
+      return { query: q, category: category || null, resultCount: matches.length, resultsUrl, results: matches.slice(0, 25).map(describe) };
+    });
+    event.respondWith(response);
+  } else {
+    const slug = String(data.get('slug') ?? '');
+    const action = data.get('action') === 'remove' ? 'remove' : 'add';
+    const response = updateReadingList(slug, action).then((res) => {
+      // Refresh the page so the user sees the updated list.
+      queueMicrotask(() => void navigate(location.href, { history: 'replace' }));
+      return res;
+    });
+    event.respondWith(response);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Boot
+// ---------------------------------------------------------------------------
+
+let pageCleanups: Array<() => void> = [];
+
+function syncPageTools() {
+  pageCleanups.forEach((fn) => fn());
+  pageCleanups = currentArticle() ? articleTools.map(register) : [];
+}
+
+if (typeof navigator !== 'undefined' && navigator.modelContext) {
+  siteTools.forEach(register);
+  // Capture phase so this runs before <ClientRouter />'s own submit handler.
+  document.addEventListener('submit', onSubmit, { capture: true });
+  // Fires on the initial load and after every client-side navigation.
+  document.addEventListener('astro:page-load', syncPageTools);
+}
