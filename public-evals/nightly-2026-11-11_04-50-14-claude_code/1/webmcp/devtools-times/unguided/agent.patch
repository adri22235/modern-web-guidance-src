+/**
+ * Shared article search logic, used both server-side (the /search page) and
+ * client-side (WebMCP tool responses), so agents and humans get identical results.
+ */
+export interface SearchableArticle {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+  author?: string;
+  tags?: string[];
+}
+
+export function searchArticles<T extends SearchableArticle>(
+  articles: T[],
+  query: string,
+  category?: string | null,
+): T[] {
+  const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
+  const cat = category?.trim().toLowerCase();
+
+  return articles
+    .filter((a) => !cat || a.category.toLowerCase() === cat)
+    .map((a) => {
+      const title = a.title.toLowerCase();
+      const haystack = [a.summary, a.author ?? '', ...(a.tags ?? [])].join(' ').toLowerCase();
+      let score = 0;
+      for (const term of terms) {
+        if (title.includes(term)) score += 3;
+        else if (haystack.includes(term)) score += 1;
+        else return { a, score: -1 }; // every term must match somewhere
+      }
+      return { a, score };
+    })
+    .filter(({ score }) => score >= 0 && (terms.length > 0 || !!cat))
+    .sort((x, y) => y.score - x.score)
+    .map(({ a }) => a);
+}
