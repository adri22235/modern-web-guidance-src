new file mode 100644
index 0000000..9fe50d3
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,76 @@
+// Shared helpers for exposing The DevTools Times to in-browser AI agents via WebMCP.
+
+/**
+ * A form `submit` event that may have been triggered by an AI agent through the
+ * WebMCP Declarative API. Browsers without WebMCP never set these members.
+ */
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+const BASE_URL = import.meta.env.BASE_URL;
+
+/** Absolute URL for an article, so agents can share or navigate to it. */
+export function articleUrl(slug: string): string {
+  return new URL(`${BASE_URL}articles/${slug}`, window.location.href).href;
+}
+
+export async function fetchArticles(signal?: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Loading articles failed with status ${response.status}`);
+  return response.json();
+}
+
+export async function fetchReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${BASE_URL}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Loading the reading list failed with status ${response.status}`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** The API toggles membership, so callers must check the current state first. */
+export async function toggleReadingListEntry(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${BASE_URL}api/reading-list.json`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+    signal,
+  });
+  if (!response.ok) throw new Error(`Updating the reading list failed with status ${response.status}`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** Set an article's reading-list membership idempotently and broadcast the change. */
+export async function setReadingListEntry(slug: string, saved: boolean, signal?: AbortSignal): Promise<string[]> {
+  let list = await fetchReadingList(signal);
+  if (list.includes(slug) !== saved) {
+    list = await toggleReadingListEntry(slug, signal);
+  }
+  notifyReadingListChange(list);
+  return list;
+}
+
+export const READING_LIST_CHANGE_EVENT = 'readinglistchange';
+
+/** Keeps separate islands (flyout, bookmark buttons) in sync after an update. */
+export function notifyReadingListChange(readingList: string[]) {
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGE_EVENT, { detail: { readingList } }));
+}
+
+export function searchArticles<T extends ArticleSummary>(articles: T[], query: string): T[] {
+  const term = query.trim().toLowerCase();
+  if (!term) return [];
+  return articles.filter(
+    (article) =>
+      article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term),
+  );
+}
