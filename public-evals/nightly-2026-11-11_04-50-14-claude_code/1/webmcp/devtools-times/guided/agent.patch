diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..104493a
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,133 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { articleUrl } from '../utils/webmcp';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  category: string;
+  date: string;
+  readingTime?: number;
+  imageCaption?: string;
+}
+
+const WORDS_PER_MINUTE = 230;
+
+/** Paragraph-level text blocks of the rendered article body. */
+function getArticleBlocks(): HTMLElement[] {
+  const body = document.querySelector<HTMLElement>('[data-article-body]');
+  if (!body) return [];
+  return [...body.querySelectorAll<HTMLElement>('p, h1, h2, h3, h4, h5, h6, li, blockquote')]
+    .filter(el => el.textContent?.trim());
+}
+
+function countWords(text: string): number {
+  return text.trim().split(/\s+/).filter(Boolean).length;
+}
+
+/**
+ * Registers client-side article utilities as WebMCP tools while an article page
+ * is shown. Renders nothing; tools unregister automatically on navigation.
+ */
+export default function ArticleTools({ slug, title, summary, author, category, date, readingTime, imageCaption }: Props) {
+  useWebMCP({
+    name: 'read_current_article',
+    description: 'Returns the headline, byline, metadata, and full text of the article the reader is viewing. Use to summarize, explain, or answer questions about this story.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const blocks = getArticleBlocks();
+      const paragraphs = blocks.map(el => el.textContent!.trim());
+      const sections = blocks.filter(el => /^H\d$/.test(el.tagName)).map(el => el.textContent!.trim());
+      const wordCount = countWords(paragraphs.join(' '));
+      return {
+        slug,
+        url: articleUrl(slug),
+        title,
+        summary,
+        author,
+        category,
+        publishedDate: date,
+        imageCaption,
+        wordCount,
+        readingTimeMinutes: readingTime ?? Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        sections,
+        text: paragraphs.join('\n\n'),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ query?: unknown }>({
+    name: 'find_in_current_article',
+    description: 'Finds passages in the article the reader is viewing that mention a word or phrase, and scrolls the first match into view. Use to locate or quote a specific part of the story.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: { type: 'string', description: "Word or phrase to look for, e.g. 'bike lanes'." },
+      },
+      required: ['query'],
+    },
+    execute({ query }) {
+      if (typeof query !== 'string' || !query.trim()) {
+        return { error: 'Provide a word or phrase to look for.' };
+      }
+      const term = query.trim().toLowerCase();
+      const blocks = getArticleBlocks();
+      const matches = blocks
+        .map((el, index) => ({ el, index, text: el.textContent!.trim() }))
+        .filter(({ text }) => text.toLowerCase().includes(term));
+
+      if (matches.length === 0) {
+        return { query, matchCount: 0, message: `"${query}" does not appear in this article.` };
+      }
+
+      const first = matches[0].el;
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      first.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
+      first.dataset.agentHighlight = '';
+      setTimeout(() => delete first.dataset.agentHighlight, 3000);
+
+      return {
+        query,
+        matchCount: matches.length,
+        matches: matches.map(({ index, text }) => ({ paragraph: index + 1, text })),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ platform?: unknown }>({
+    name: 'get_article_share_links',
+    description: 'Builds share links for the article the reader is viewing. Use when the reader wants to send or post this story.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        platform: {
+          type: 'string',
+          enum: ['all', 'link', 'x', 'facebook', 'email'],
+          default: 'all',
+          description: 'Where the reader wants to share the article.',
+        },
+      },
+    },
+    execute({ platform = 'all' }) {
+      const url = articleUrl(slug);
+      const encodedUrl = encodeURIComponent(url);
+      const links: Record<string, string> = {
+        link: url,
+        x: `https://x.com/intent/post?url=${encodedUrl}&text=${encodeURIComponent(title)}`,
+        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
+        email: `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${summary}\n\n${url}`)}`,
+      };
+      if (platform === 'all') return { title, links };
+      if (typeof platform !== 'string' || !(platform in links)) {
+        return { error: `Unsupported platform "${String(platform)}".`, platforms: ['all', ...Object.keys(links)] };
+      }
+      return { title, links: { [platform]: links[platform] } };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return null;
+}
