+    /* Decorative coffee bean before each seasonal favorite title.
+       Vector SVG mask = crisp at any device pixel ratio; no extra DOM nodes. */
+    .card h3::before {
+      /* Fallback for browsers without alt-text syntax in `content` */
+      content: "";
+      /* Empty alt keeps the decoration out of the accessibility tree */
+      content: "" / "";
+      display: inline-block;
+      width: 1em;
+      height: 1em;
+      margin-inline-end: 0.4em;
+      /* Center on cap height, nudged slightly up for optical balance */
+      vertical-align: calc(0.5cap - 0.5em - 0.02em);
+      background-color: currentColor;
+      mask: var(--icon-coffee-bean) no-repeat center / contain;
+      pointer-events: none;
+      forced-color-adjust: none;
+    }
