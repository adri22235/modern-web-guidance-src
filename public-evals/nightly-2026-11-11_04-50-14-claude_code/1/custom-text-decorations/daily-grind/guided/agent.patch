+    /* ==========================================================
+       Decorative text lines
+       Native text-decoration follows wrapped text, tracks font
+       metrics, and skips descender ink by default (skip-ink: auto),
+       so the offsets below are kept tight enough that descenders
+       (p, y, g, J) cross the line and the gaps stay visible.
+       ========================================================== */
+
+    /* --- Navigation: accent underline that reveals left-to-right --- */
+    :where(nav ul a) {
+      text-decoration: underline solid var(--accent) max(1px, 0.1em);
+      text-underline-offset: 0.18em;
+    }
+
+    /* The bordered Logout button already has its own affordance. */
+    nav ul a.logout-link {
+      text-decoration: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul a {
+        /* Trim the end by the full inline size: zero-length line at rest. */
+        text-decoration-inset: 0 100%;
+        transition: color 0.3s, text-decoration-inset 0.25s ease-out;
+      }
+
+      nav ul a:is(:hover, :focus-visible) {
+        /* Small end insets so the line stops just short of the glyph edges. */
+        text-decoration-inset: 0.05em 0.05em;
+      }
+    }
+
+    /* --- Footer: soft dotted underline that firms up and extends --- */
+    :where(.footer-links a) {
