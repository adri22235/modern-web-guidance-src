+      /* Dotted lines need a little more room than solid ones. */
+      text-underline-offset: 0.22em;
+      /* Pull both ends in slightly at rest. */
+      text-decoration-inset: 0.15em;
+      transition: text-decoration-color 0.2s, text-decoration-inset 0.25s ease-out;
+    }
+
+    :where(.footer-links a:is(:hover, :focus-visible)) {
