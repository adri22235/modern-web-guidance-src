+      text-underline-offset: 0.18em;
+      text-decoration-inset: 0.1em -0.1em;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .deco-line {
+        transition: text-decoration-color 0.01s;
+      }
+
+      .section-title {
+        animation: none;
+      }
+    }
