+    /* ==========================================================
+       Decorative text lines
+       - text-underline-offset   : custom vertical offset
+       - text-decoration-inset   : horizontal end insets (CSS Text Decoration 4)
+       - text-decoration-skip-ink: ink skipping around descenders
+       Reveals animate color, thickness, offset and inset together.
+       ========================================================== */
+    :root {
+      --deco-ease: cubic-bezier(0.22, 1, 0.36, 1);
+      --deco-duration: 0.45s;
+    }
+
+    .deco-line {
+      text-decoration-line: underline;
+      text-decoration-style: solid;
+      text-decoration-color: transparent;
+      text-decoration-thickness: 0.06em;
+      text-underline-offset: 0.5em;
+      text-underline-position: from-font;
+      text-decoration-skip-ink: auto;
+      transition:
+        color 0.3s,
+        text-decoration-color var(--deco-duration) var(--deco-ease),
+        text-decoration-thickness var(--deco-duration) var(--deco-ease),
+        text-underline-offset var(--deco-duration) var(--deco-ease),
+        text-decoration-inset var(--deco-duration) var(--deco-ease);
+    }
+
+    /* Collapsed state: line pulled in from both ends so it "grows" outward */
+    @supports (text-decoration-inset: 1px) {
+      .deco-line {
+        text-decoration-inset: 0.6em;
+      }
+    }
+
+    /* Navigation: underline drops into place and extends slightly past the text */
+    nav a.deco-line {
+      text-decoration-thickness: 0.08em;
+      text-underline-offset: 0.55em;
+    }
+
+    nav a.deco-line:hover,
+    nav a.deco-line:focus-visible,
+    nav a.deco-line[aria-current="page"] {
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 0.12em;
+      text-underline-offset: 0.25em;
+      text-decoration-inset: -0.15em;
+    }
+
+    /* Logout button already has a border — use a strikethrough-to-underline flourish */
+    nav a.logout-link.deco-line {
+      text-decoration-line: line-through;
+      text-decoration-color: transparent;
+    }
+
+    nav a.logout-link.deco-line:hover,
+    nav a.logout-link.deco-line:focus-visible {
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 0.1em;
+      text-decoration-inset: 0.1em;
+    }
+
+    /* Footer: underline + overline frame that tightens around the label */
+    .footer-links a.deco-line {
+      text-decoration-line: underline overline;
+      text-decoration-style: dotted;
+      text-decoration-thickness: 0.1em;
+      text-underline-offset: 0.6em;
+    }
+
+    .footer-links a.deco-line:hover,
+    .footer-links a.deco-line:focus-visible {
+      text-decoration-color: var(--primary);
+      text-decoration-style: solid;
+      text-decoration-thickness: 0.08em;
+      text-underline-offset: 0.2em;
+      text-decoration-inset: 0.05em 0.05em;
+    }
+
+    /* Section heading: wavy underline revealed on page load */
+    .section-title {
+      text-align: center;
+      text-decoration-line: underline;
+      text-decoration-style: wavy;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 0.06em;
+      text-underline-offset: 0.3em;
+      text-decoration-skip-ink: auto;
+      animation: deco-heading-reveal 1.1s var(--deco-ease) 0.2s both;
+    }
+
+    @keyframes deco-heading-reveal {
+      from {
+        text-decoration-color: transparent;
+        text-underline-offset: 0.9em;
+        text-decoration-thickness: 0.01em;
+      }
+
+      to {
+        text-decoration-color: var(--accent);
+        text-underline-offset: 0.3em;
+        text-decoration-thickness: 0.06em;
+      }
+    }
+
+    @supports (text-decoration-inset: 1px) {
+      .section-title {
+        text-decoration-inset: 0.4em;
+        animation-name: deco-heading-reveal-inset;
+      }
+
+      @keyframes deco-heading-reveal-inset {
+        from {
+          text-decoration-color: transparent;
+          text-underline-offset: 0.9em;
+          text-decoration-thickness: 0.01em;
+          text-decoration-inset: 4em;
+        }
+
+        to {
+          text-decoration-color: var(--accent);
+          text-underline-offset: 0.3em;
+          text-decoration-thickness: 0.06em;
+          text-decoration-inset: 0.4em;
+        }
+      }
+    }
+
+    /* Card titles: underline revealed when the whole card is hovered/focused */
+    .card h3.deco-line {
+      text-decoration-thickness: 0.1em;
