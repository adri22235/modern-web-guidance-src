+  <script>
+    // Fallback for browsers without CSS `field-sizing: content` support.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('field-sizing', 'content')) return;
+
+      var measurer = document.createElement('span');
+      measurer.className = 'size-measurer';
+      measurer.setAttribute('aria-hidden', 'true');
+      document.body.appendChild(measurer);
+
+      function textWidth(el, text) {
+        var cs = getComputedStyle(el);
+        measurer.style.font = cs.font;
+        measurer.style.letterSpacing = cs.letterSpacing;
+        measurer.textContent = text || '';
+        return measurer.getBoundingClientRect().width;
+      }
+
+      function chrome(el) {
+        var cs = getComputedStyle(el);
+        return parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight) +
+          parseFloat(cs.borderLeftWidth) + parseFloat(cs.borderRightWidth);
+      }
+
+      function sizeInput(el) {
+        var w = textWidth(el, el.value || el.placeholder);
+        el.style.width = Math.ceil(w + chrome(el) + 2) + 'px';
+      }
+
+      function sizeSelect(el) {
+        var opt = el.options[el.selectedIndex];
+        // Leave room for the native dropdown arrow.
+        var w = textWidth(el, opt ? opt.text : '');
+        el.style.width = Math.ceil(w + chrome(el) + 28) + 'px';
+      }
+
+      function sizeTextarea(el) {
+        var lines = (el.value || el.placeholder).split('\n');
+        var widest = 0;
+        lines.forEach(function (line) { widest = Math.max(widest, textWidth(el, line)); });
+        el.style.width = Math.ceil(widest + chrome(el) + 2) + 'px';
+        el.style.height = 'auto';
+        var cs = getComputedStyle(el);
+        var borders = parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
+        el.style.height = (el.scrollHeight + borders) + 'px';
+      }
+
+      function size(el) {
+        if (el.tagName === 'SELECT') sizeSelect(el);
+        else if (el.tagName === 'TEXTAREA') sizeTextarea(el);
+        else sizeInput(el);
+      }
+
+      var fields = document.querySelectorAll('.auto-size');
+      fields.forEach(function (el) {
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () { size(el); });
+        size(el);
+      });
+      window.addEventListener('resize', function () { fields.forEach(size); });
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { fields.forEach(size); });
+    })();
+  </script>
