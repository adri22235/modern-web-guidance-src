+  <script>
+    // Lazy-load below-the-fold video/audio, including posters and preload data.
+    (() => {
+      const media = document.querySelectorAll('.lazy-media');
+
+      const activate = (el) => {
+        if (el.dataset.poster) el.poster = el.dataset.poster;
+        if (el.dataset.src) el.src = el.dataset.src;
+        for (const child of el.querySelectorAll('source[data-src], track[data-src]')) {
+          child.src = child.dataset.src;
+          child.removeAttribute('data-src');
+        }
+        if (el.dataset.preload) el.preload = el.dataset.preload;
+        for (const key of ['poster', 'src', 'preload']) delete el.dataset[key];
+        el.load();
+      };
+
+      if (Object.hasOwn(HTMLMediaElement.prototype, 'loading')) {
+        // Native support: loading="lazy" defers the poster, preload and sources itself.
+        media.forEach(activate);
+      } else if ('IntersectionObserver' in window) {
+        const io = new IntersectionObserver((entries, observer) => {
+          for (const entry of entries) {
+            if (!entry.isIntersecting) continue;
+            activate(entry.target);
+            observer.unobserve(entry.target);
+          }
+        }, { rootMargin: '300px 0px' });
+        media.forEach((el) => io.observe(el));
+      } else {
+        media.forEach(activate);
+      }
+    })();
+
+    // Hero video: pause control + respect reduced-motion preferences.
+    (() => {
+      const video = document.querySelector('.hero-video');
+      const toggle = document.querySelector('.hero-toggle');
+      if (!video || !toggle) return;
+
+      const setPaused = (paused) => {
+        if (paused) video.pause(); else video.play().catch(() => {});
+        toggle.setAttribute('aria-pressed', String(paused));
+        toggle.textContent = paused ? 'Play background video' : 'Pause background video';
+      };
+
+      toggle.addEventListener('click', () => setPaused(!video.paused));
+
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      if (reducedMotion.matches) {
+        video.removeAttribute('autoplay');
+        setPaused(true);
+      }
+      reducedMotion.addEventListener('change', (e) => { if (e.matches) setPaused(true); });
+    })();
+  </script>
+
