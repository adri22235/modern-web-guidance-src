+  <script>
+    // Lazy-load offscreen <video>/<audio>: attach poster + sources and allow metadata
+    // preloading only once the player is within ~300px of the viewport.
+    (function () {
+      var players = document.querySelectorAll('.lazy-media');
+
+      function hydrate(el) {
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          el.removeAttribute('data-poster');
+        }
+        el.querySelectorAll('source[data-src]').forEach(function (source) {
+          source.src = source.dataset.src;
+          source.removeAttribute('data-src');
+        });
+        el.preload = 'metadata';
+        el.load();
+        el.classList.remove('lazy-media');
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        players.forEach(hydrate);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            observer.unobserve(entry.target);
+            hydrate(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      players.forEach(function (el) { observer.observe(el); });
+    })();
+
+    // Respect reduced-motion preferences for the autoplaying hero.
+    (function () {
+      var hero = document.querySelector('.hero-video');
+      if (hero && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        hero.pause();
+        hero.removeAttribute('autoplay');
+        hero.preload = 'none';
+      }
+    })();
+  </script>
+
