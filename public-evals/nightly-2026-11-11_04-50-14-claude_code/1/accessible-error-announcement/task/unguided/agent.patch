+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var success = document.getElementById('newsletter-success');
+      // Errors are only surfaced after the user has interacted (blur or submit attempt).
+      var touched = false;
+
+      function getErrorMessage() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      // Single source of truth: the visual message, aria-invalid, and the live
+      // region announcement are all updated together in this one function.
+      function render() {
+        var message = touched ? getErrorMessage() : '';
+        if (message) {
+          // Only write when the text changes, so screen readers don't re-announce on every keystroke.
+          if (error.textContent !== message) error.textContent = message;
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          if (error.textContent !== '') error.textContent = '';
+          input.setAttribute('aria-invalid', 'false');
+        }
+        return !message;
+      }
+
+      input.addEventListener('blur', function () {
+        // Don't flag an untouched empty field just because focus passed through it.
+        if (input.value.trim() !== '') touched = true;
+        render();
+      });
+
+      input.addEventListener('input', function () {
+        success.textContent = '';
+        // Once an error is showing, re-validate live so it clears the moment the email is valid.
+        if (touched) render();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        if (!render()) {
+          input.focus();
+          return;
+        }
+        success.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        touched = false;
+        render();
+      });
+    })();
+  </script>
+
