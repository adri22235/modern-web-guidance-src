+  <script>
+    // Keep the screen reader state of the newsletter email field in sync with its visual
+    // :user-invalid state, so assistive technologies only hear about an error when the
+    // visible error message appears, and stop hearing it as soon as the email is valid.
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      if (!form) return;
+
+      // List the error message (the id in data-error) in aria-describedby only while it's
+      // shown: text referenced by aria-describedby is announced even when it's hidden.
+      const linkError = (el, shown) => {
+        const errorId = el.dataset.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+
+      // One polite live region announces an error that appears when the user leaves the field.
+      const announcer = document.createElement('div');
+      announcer.setAttribute('aria-live', 'polite');
+      announcer.classList.add('visually-hidden');
+      document.body.append(announcer);
+      let announceTimer;
+      let announcedField;
+
+      // Text as a screen reader reads it: icon text alternatives in, aria-hidden text out.
+      const spokenText = (node) => {
+        const copy = node.cloneNode(true);
+        copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
+        copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
+        return copy.textContent.replace(/\s+/g, ' ').trim();
+      };
+
+      const clearAnnouncement = () => {
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announcedField = null;
+      };
+
+      const announceError = (el) => {
+        const error = document.getElementById(el.dataset.error);
+        if (!error) return;
+        const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announcedField = el;
+        // Wait until the screen reader has announced whatever receives focus next.
+        announceTimer = setTimeout(() => { announcer.textContent = label + spokenText(error); }, 500);
+      };
+
+      const flagged = new WeakSet();   // fields this script marked aria-invalid="true"
+      const announced = new WeakSet(); // fields whose current error was already announced
+
+      const syncAria = (el, announce = false) => {
+        if (!el.matches?.('input, select, textarea')) return;
+        if (el.matches(':user-invalid')) {
+          if (announce && !announced.has(el)) {
+            announceError(el);
+            announced.add(el);
+          }
+          el.setAttribute('aria-invalid', 'true');
+          linkError(el, true);
+          flagged.add(el);
+        } else if (flagged.has(el) || el.getAttribute('aria-invalid') !== 'true') {
+          el.setAttribute('aria-invalid', 'false');
+          linkError(el, false);
+          flagged.delete(el);
+          announced.delete(el);
+          // Clear a fixed field's announcement so it isn't found later when reading the page.
+          if (announcedField === el) clearAnnouncement();
+        }
+      };
+
+      // Start at aria-invalid="false": Firefox and Safari otherwise expose an empty
+      // required field as invalid from page load.
+      [...form.elements].forEach((el) => syncAria(el));
+
+      // Blur shows (and announces) an error; typing clears it the moment the email is valid.
+      form.addEventListener('blur', (e) => syncAria(e.target, true), true);
+      form.addEventListener('input', (e) => syncAria(e.target));
+      form.addEventListener('change', (e) => syncAria(e.target, true), true);
+
+      // A failed submit fires 'invalid' (which doesn't bubble) and the browser moves focus
+      // to the field, which reads its error, so don't also announce it via the live region.
+      form.addEventListener('invalid', (e) => {
+        announced.add(e.target);
+        if (announcedField === e.target) clearAnnouncement();
+        syncAria(e.target);
+      }, true);
+
+      // Reset clears :user-invalid after the 'reset' event, so sync afterwards.
+      form.addEventListener('reset', () => {
+        setTimeout(() => [...form.elements].forEach((el) => syncAria(el)));
+      });
+    })();
+  </script>
+
