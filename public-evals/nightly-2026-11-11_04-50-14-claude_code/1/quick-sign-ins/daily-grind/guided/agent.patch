+  <!-- Announces sign-in state changes to assistive technology -->
+  <p id="auth-status" class="visually-hidden" role="status"></p>
+
+  <!-- Inline sign-in fallback, shown when no saved credential could be used in place -->
+  <dialog id="signin-dialog" class="signin-dialog" aria-labelledby="signin-title" closedby="any">
+    <form method="dialog" class="signin-close-form">
+      <button class="signin-close" value="cancel" aria-label="Close sign in">&times;</button>
