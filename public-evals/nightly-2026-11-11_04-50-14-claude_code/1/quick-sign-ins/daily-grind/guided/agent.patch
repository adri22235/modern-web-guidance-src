+
+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs"
+      },
+      "integrity": {
+        "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs": "sha384-EBLK1vCYl7ILfHGSetlZN/n8TaV5nbYKx9JrMwcJvy5NTITz1Q9HDYqCG4NxzuR0"
+      }
+    }
+  </script>
+
+  <script type="module">
+    /*
+     * In-place sign-in for returning customers.
+     *
+     * 1. Clicking a link that needs an account (Rewards, My Account, Order Now) or "Sign In"
+     *    while signed out first asks the browser for a saved passkey or password in place
+     *    (WebAuthn Immediate UI mode). If one is picked, the customer goes straight on.
+     * 2. If nothing is saved on this device (or the browser lacks support), an inline sign-in
+     *    dialog opens instead, offering passkey autofill, a passkey button and saved-password
+     *    autofill — still without leaving the page.
+     *
+     * Expected server endpoints:
+     *   GET  /api/session         -> 200 { user: { name } } when signed in
+     *   POST /api/login/options   -> WebAuthn request options JSON (challenge, rpId, userVerification)
+     *   POST /api/login/verify    -> verifies a passkey assertion; 404 if credential unknown
+     *   POST /api/login/password  -> verifies { username, password }
+     */
+
+    const hasWebAuthn = 'PublicKeyCredential' in window;
+
+    // Polyfill getClientCapabilities / parseRequestOptionsFromJSON / toJSON where WebAuthn exists.
+    const polyfillsReady = hasWebAuthn
+      ? import('webauthn-polyfills').catch((err) => console.warn('WebAuthn polyfills failed to load', err))
+      : Promise.resolve();
+
+    const capabilitiesReady = polyfillsReady.then(async () => {
+      if (!hasWebAuthn || !PublicKeyCredential.getClientCapabilities) return {};
+      try {
+        return (await PublicKeyCredential.getClientCapabilities()) ?? {};
+      } catch {
+        return {};
+      }
+    });
+
+    const dialog = document.getElementById('signin-dialog');
+    const form = document.getElementById('signin-form');
+    const errorEl = document.getElementById('signin-error');
+    const passkeyButton = document.getElementById('passkey-button');
+    const returnInput = document.getElementById('signin-return');
+    const statusEl = document.getElementById('auth-status');
+    const accountLink = document.getElementById('account-link');
+
+    let signedIn = false;
+    let isAuthenticating = false;
+    let pendingDestination = null; // URL the customer was heading to when sign-in was needed
+    let conditionalAbort = null;
+
+    // Explicit passkey button also covers phones (QR code) and security keys.
+    passkeyButton.hidden = !hasWebAuthn;
+
+    // ---------- UI state ----------
+
+    function announce(message) {
+      statusEl.textContent = '';
+      // Defer so repeated identical messages are still announced.
+      requestAnimationFrame(() => { statusEl.textContent = message; });
+    }
+
+    function renderAuthState(user) {
+      const greeting = document.getElementById('nav-greeting');
+      document.getElementById('signin-item').hidden = signedIn;
+      document.getElementById('logout-item').hidden = !signedIn;
+      greeting.hidden = !signedIn || !user?.name;
+      greeting.textContent = user?.name ? `Hi, ${user.name}` : '';
+    }
+
+    function showError(message) {
+      errorEl.textContent = message;
+    }
+
+    function setBusy(busy) {
+      for (const button of form.querySelectorAll('button')) button.disabled = busy;
+    }
+
+    function completeSignIn(user, { destination, returnFocusEl } = {}) {
+      signedIn = true;
+      stopConditionalUi();
+      if (dialog.open) dialog.close('signed-in');
+      renderAuthState(user);
+      announce(user?.name ? `Signed in as ${user.name}.` : 'You are signed in.');
+
+      if (destination) {
+        // Finish what the customer set out to do.
+        location.assign(destination);
+        return;
+      }
+      // The "Sign In" link is now hidden; keep focus on a meaningful control.
+      (returnFocusEl?.isConnected && !returnFocusEl.closest('[hidden]') ? returnFocusEl : accountLink).focus();
+    }
+
+    // ---------- Server helpers ----------
+
+    async function fetchRequestOptions() {
+      await polyfillsReady;
+      const response = await fetch('/api/login/options', { method: 'POST', credentials: 'same-origin' });
+      if (!response.ok) throw new Error('Failed to fetch authentication options');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await response.json());
+    }
+
+    async function postJSON(url, body) {
+      return fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body),
+      });
+    }
+
+    class SignInError extends Error {}
+
+    async function verifyPasskey(credential, publicKey) {
+      const encoded = credential.toJSON();
+      const response = await postJSON('/api/login/verify', encoded);
+      if (response.status === 404) {
+        if (PublicKeyCredential.signalUnknownCredential) {
+          // Remove the stale passkey from the customer's password manager.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId, // server-provided RP ID, never location.hostname
+            credentialId: encoded.id,
+          }).catch(() => {});
+        }
+        throw new SignInError("That passkey isn't recognized anymore. Please sign in with your password.");
+      }
+      if (!response.ok) throw new SignInError("We couldn't verify your passkey. Please try again.");
+      return readUser(response);
+    }
+
+    async function verifyPassword(username, password) {
+      const response = await postJSON('/api/login/password', { username, password });
+      if (response.status === 401 || response.status === 403) {
+        throw new SignInError('That email and password combination didn\u2019t match.');
+      }
+      if (!response.ok) throw new SignInError('Sign in failed. Please try again.');
+      return readUser(response);
+    }
+
+    async function readUser(response) {
+      const data = await response.json().catch(() => ({}));
+      return data.user ?? data;
+    }
+
+    // ---------- 1. Quick sign-in with Immediate UI mode ----------
+
+    async function quickSignIn() {
+      const caps = await capabilitiesReady;
+      // Browsers that don't understand uiMode would open a blocking QR-code dialog instead.
+      if (!caps.immediateGet) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+      stopConditionalUi(); // never run alongside a pending conditional request
+
+      const publicKey = await fetchRequestOptions();
+      // No signal and no allowCredentials: both are rejected in immediate mode.
+      const credential = await navigator.credentials.get({
+        password: true,
+        publicKey,
+        uiMode: 'immediate',
+      });
+      if (!credential) throw new DOMException('No credential returned', 'NotAllowedError');
+
+      if (credential.type === 'public-key') return verifyPasskey(credential, publicKey);
+      if (credential.type === 'password') return verifyPassword(credential.id, credential.password);
+      throw new Error(`Unsupported credential type: ${credential.type}`);
+    }
+
+    // ---------- 2. Inline sign-in dialog fallback ----------
+
+    function stopConditionalUi() {
+      conditionalAbort?.abort();
+      conditionalAbort = null;
+    }
+
+    async function startConditionalUi() {
+      const caps = await capabilitiesReady;
+      if (!caps.conditionalGet || !dialog.open || signedIn) return;
+      stopConditionalUi();
+      const controller = new AbortController();
+      conditionalAbort = controller;
+
+      let publicKey;
+      try {
+        publicKey = await fetchRequestOptions();
+      } catch (err) {
+        console.warn('Passkey autofill unavailable:', err);
+        return;
+      }
+      if (controller.signal.aborted) return;
+
+      let credential;
+      try {
+        // Offers saved passkeys in the username field's autofill menu.
+        credential = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: controller.signal,
+        });
+      } catch (err) {
+        if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+          console.error('Conditional sign-in error:', err);
+        }
+        return;
+      }
+
+      setBusy(true);
+      try {
+        completeSignIn(await verifyPasskey(credential, publicKey), { destination: pendingDestination });
+      } catch (err) {
+        showError(err instanceof SignInError ? err.message : 'Something went wrong. Please try again.');
+        startConditionalUi(); // re-arm autofill with a fresh challenge
+      } finally {
+        setBusy(false);
+      }
+    }
+
+    function openSignInDialog({ destination }) {
+      pendingDestination = destination;
+      form.reset();
+      showError('');
+      // Used by the no-JS form post so the server can redirect back afterwards.
+      const target = new URL(destination ?? location.href);
+      returnInput.value = target.pathname + target.search;
+      if (!dialog.open) dialog.showModal(); // autofocuses the username field
+      announce('Sign in to continue.');
+      startConditionalUi();
+    }
+
+    dialog.addEventListener('close', () => {
+      stopConditionalUi();
+      dialog.returnValue = '';
+    });
+
+    passkeyButton.addEventListener('click', async () => {
+      stopConditionalUi(); // avoid colliding with the autofill request
+      showError('');
+      setBusy(true);
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchRequestOptions();
+        conditionalAbort = new AbortController();
+        credential = await navigator.credentials.get({ publicKey, signal: conditionalAbort.signal });
+      } catch (err) {
+        setBusy(false);
+        if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+          console.error('Passkey sign-in error:', err);
+          showError('Passkey sign-in is unavailable right now. Please use your password.');
+        }
+        conditionalAbort = null;
+        startConditionalUi();
+        return;
+      }
+      conditionalAbort = null;
+      try {
+        completeSignIn(await verifyPasskey(credential, publicKey), { destination: pendingDestination });
+      } catch (err) {
+        showError(err instanceof SignInError ? err.message : 'Something went wrong. Please try again.');
+        startConditionalUi();
+      } finally {
+        setBusy(false);
+      }
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      showError('');
+      setBusy(true);
+      const username = form.username.value.trim();
+      const password = form.password.value;
+      try {
+        const user = await verifyPassword(username, password);
+        // Offer to save the password so next visit can use quick sign-in.
+        if ('PasswordCredential' in window) {
+          await navigator.credentials
+            .store(new PasswordCredential({ id: username, password, name: user?.name || username }))
+            .catch(() => {});
+        }
+        completeSignIn(user, { destination: pendingDestination });
+      } catch (err) {
+        showError(err instanceof SignInError ? err.message : 'Something went wrong. Please try again.');
+        if (!(err instanceof SignInError)) console.error('Password sign-in error:', err);
+        form.password.select();
+      } finally {
+        setBusy(false);
+      }
+    });
+
+    // ---------- Intercept links that need an account ----------
+
+    document.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[data-requires-auth], a[data-signin]');
+      if (!link || signedIn) return;
+      // Let new-tab / new-window clicks behave normally.
+      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      event.preventDefault();
+      if (isAuthenticating) return;
+      isAuthenticating = true;
+
+      // "Sign In" just signs in on this page; other links continue to their destination.
+      const destination = link.hasAttribute('data-signin') ? null : link.href;
+      try {
+        completeSignIn(await quickSignIn(), { destination, returnFocusEl: link });
+      } catch (err) {
+        // NotAllowedError: nothing saved on this device, chooser dismissed, or unsupported.
+        if (err.name !== 'NotAllowedError') console.error('Quick sign-in error:', err);
+        openSignInDialog({ destination });
+        if (err instanceof SignInError) showError(err.message);
+      } finally {
+        isAuthenticating = false;
+      }
+    });
+
+    // ---------- Initial session state ----------
+
+    fetch('/api/session', { credentials: 'same-origin' })
+      .then(async (response) => {
+        if (!response.ok) return;
+        const user = await readUser(response);
+        if (user && (user.name || user.id || user.email)) {
+          signedIn = true;
+          renderAuthState(user);
+        }
+      })
+      .catch(() => { /* treat as signed out */ });
+
+    // Light-dismiss fallback for browsers without <dialog closedby>.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+    }
+  </script>
+
 </body>
 
