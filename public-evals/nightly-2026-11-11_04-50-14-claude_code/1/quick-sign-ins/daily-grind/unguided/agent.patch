+  <!-- Inline sign-in: opens over the current page instead of redirecting to /login -->
+  <dialog id="signin-dialog" class="signin-dialog" aria-labelledby="signin-title" aria-describedby="signin-subtitle">
+    <div class="signin-header">
+      <h2 id="signin-title">Welcome back</h2>
+      <p id="signin-subtitle">Sign in to continue.</p>
+      <button type="button" class="signin-close" data-close-signin aria-label="Close sign in">&times;</button>
+    </div>
+    <div class="signin-body">
+      <button type="button" class="passkey-btn" id="passkey-btn" hidden>Sign in with a passkey</button>
+      <div class="signin-divider" id="passkey-divider" hidden>or use your password</div>
+
+      <!-- Regular form fields with autocomplete tokens so the browser's password manager
+           can autofill saved passwords, and "webauthn" so saved passkeys show up in the
+           same autofill dropdown (conditional mediation). -->
+      <form id="signin-form" action="/login" method="post" novalidate>
+        <label for="signin-username">Email</label>
+        <input id="signin-username" name="username" type="email" inputmode="email"
+          autocomplete="username webauthn" autocapitalize="none" spellcheck="false" required>
+
+        <label for="signin-password">Password</label>
+        <input id="signin-password" name="password" type="password" autocomplete="current-password" required>
+
+        <p class="signin-error" id="signin-error" role="alert" aria-live="assertive"></p>
+        <button type="submit" id="signin-submit">Sign In</button>
+      </form>
+
+      <p class="signin-footer">
+        <a href="/forgot-password">Forgot password?</a> &middot; <a href="/register">Create an account</a>
+      </p>
+    </div>
+  </dialog>
+
+  <script>
+    (() => {
+      'use strict';
+
+      // Assumed backend endpoints (same origin, cookie-based session).
+      const API = {
+        session: '/api/auth/session',               // GET  -> 200 { user } if signed in, 401 otherwise
+        passwordLogin: '/api/auth/login',           // POST { username, password }
+        passkeyOptions: '/api/auth/passkey/options', // POST -> PublicKeyCredentialRequestOptionsJSON
+        passkeyVerify: '/api/auth/passkey/verify'   // POST <PublicKeyCredential JSON>
+      };
+
+      const dialog = document.getElementById('signin-dialog');
+      const form = document.getElementById('signin-form');
+      const usernameInput = document.getElementById('signin-username');
+      const passwordInput = document.getElementById('signin-password');
+      const submitBtn = document.getElementById('signin-submit');
+      const passkeyBtn = document.getElementById('passkey-btn');
+      const passkeyDivider = document.getElementById('passkey-divider');
+      const errorEl = document.getElementById('signin-error');
+      const subtitle = document.getElementById('signin-subtitle');
+
+      let signedIn = false;
+      let pendingHref = null;       // where the user was headed when we asked them to sign in
+      let conditionalAbort = null;  // AbortController for the passkey autofill request
+      let lastTrigger = null;
+
+      // ---------- helpers ----------
+      const b64urlToBuf = (s) => {
+        const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
+        return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+      };
+      const bufToB64url = (buf) =>
+        btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      const postJSON = (url, body) =>
+        fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(body ?? {})
+        });
+
+      const readError = async (res, fallback) => {
+        try {
+          const data = await res.json();
+          return data.message || data.error || fallback;
+        } catch {
+          return fallback;
+        }
+      };
+
+      const setBusy = (busy) => {
+        submitBtn.disabled = busy;
+        passkeyBtn.disabled = busy;
+        submitBtn.textContent = busy ? 'Signing in…' : 'Sign In';
+      };
+
+      const showError = (msg) => { errorEl.textContent = msg || ''; };
+
+      const toast = (msg) => {
+        const el = document.createElement('div');
+        el.className = 'toast';
+        el.setAttribute('role', 'status');
+        el.textContent = msg;
+        document.body.appendChild(el);
+        setTimeout(() => el.remove(), 3000);
+      };
+
+      const setSignedIn = (value) => {
+        signedIn = value;
+        document.body.classList.toggle('signed-in', value);
+      };
+
+      // ---------- WebAuthn (passkeys) ----------
+      const webauthnSupported = typeof window.PublicKeyCredential === 'function' && !!navigator.credentials;
+
+      const parseRequestOptions = (json) => {
+        const opts = json.publicKey || json;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(opts);
+        }
+        return {
+          ...opts,
+          challenge: b64urlToBuf(opts.challenge),
+          allowCredentials: (opts.allowCredentials || []).map((c) => ({ ...c, id: b64urlToBuf(c.id) }))
+        };
+      };
+
+      const credentialToJSON = (cred) => {
+        if (typeof cred.toJSON === 'function') {
+          try { return cred.toJSON(); } catch { /* fall through */ }
+        }
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufToB64url(r.clientDataJSON),
+            authenticatorData: bufToB64url(r.authenticatorData),
+            signature: bufToB64url(r.signature),
+            userHandle: r.userHandle ? bufToB64url(r.userHandle) : null
+          }
+        };
+      };
+
+      const abortConditional = () => {
+        if (conditionalAbort) {
+          conditionalAbort.abort();
+          conditionalAbort = null;
+        }
+      };
+
+      // mediation: 'conditional' -> passkeys appear in the email field's autofill list.
+      // mediation: 'optional'    -> explicit browser passkey prompt (button click).
+      async function passkeySignIn(mediation) {
+        abortConditional();
+        const controller = new AbortController();
+        if (mediation === 'conditional') conditionalAbort = controller;
+
+        const optsRes = await postJSON(API.passkeyOptions);
+        if (!optsRes.ok) throw new Error(await readError(optsRes, 'Passkey sign-in is unavailable right now.'));
+        const publicKey = parseRequestOptions(await optsRes.json());
+
+        const cred = await navigator.credentials.get({ publicKey, mediation, signal: controller.signal });
+        if (conditionalAbort === controller) conditionalAbort = null;
+        if (!cred) return false;
+
+        setBusy(true);
+        try {
+          const verifyRes = await postJSON(API.passkeyVerify, credentialToJSON(cred));
+          if (!verifyRes.ok) throw new Error(await readError(verifyRes, 'We couldn’t verify that passkey.'));
+        } finally {
+          setBusy(false);
+        }
+        return true;
+      }
+
+      async function startConditionalPasskey() {
+        if (!webauthnSupported) return;
+        try {
+          if (typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function' ||
+              !(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+          if (await passkeySignIn('conditional')) onSignedIn();
+        } catch (err) {
+          if (err.name !== 'AbortError' && dialog.open) showError(friendlyWebAuthnError(err));
+        }
+      }
+
+      const friendlyWebAuthnError = (err) => {
+        if (err.name === 'NotAllowedError') return 'Passkey sign-in was cancelled or timed out.';
+        if (err.name === 'SecurityError') return 'Passkeys aren’t available on this connection.';
+        return err.message || 'Passkey sign-in failed. Please try again.';
+      };
+
+      // ---------- Password sign-in ----------
+      async function passwordSignIn(username, password) {
+        const res = await postJSON(API.passwordLogin, { username, password });
+        if (!res.ok) {
+          throw new Error(res.status === 401
+            ? 'That email and password don’t match our records.'
+            : await readError(res, 'Sign-in failed. Please try again.'));
+        }
+        // Offer to save/update the credential in the browser's password manager.
+        if ('PasswordCredential' in window) {
+          try {
+            await navigator.credentials.store(new PasswordCredential({ id: username, password, name: username }));
+          } catch { /* user declined or unsupported — not an error */ }
+        }
+      }
+
+      // ---------- Dialog flow ----------
+      function openSignIn(href, label, trigger) {
+        pendingHref = href || null;
+        lastTrigger = trigger || null;
+        subtitle.textContent = label ? `Sign in to continue to ${label}.` : 'Sign in to your Daily Grind account.';
+        showError('');
+        form.reset();
+        if (!dialog.open) dialog.showModal();
+        usernameInput.focus();
+        startConditionalPasskey();
+      }
+
+      function closeSignIn() {
+        abortConditional();
+        if (dialog.open) dialog.close();
+      }
+
+      function onSignedIn() {
+        const dest = pendingHref;
+        pendingHref = null;
+        setSignedIn(true);
+        closeSignIn();
+        if (dest) {
+          // Continue to where the user was going.
+          window.location.assign(dest);
+        } else {
+          toast('You’re signed in. Welcome back!');
+        }
+      }
+
+      dialog.addEventListener('close', () => {
+        abortConditional();
+        pendingHref = null;
+        if (lastTrigger && document.contains(lastTrigger)) lastTrigger.focus();
+        lastTrigger = null;
+      });
+
+      // Close when clicking the backdrop.
+      dialog.addEventListener('click', (e) => {
+        if (e.target === dialog) closeSignIn();
+      });
+      dialog.querySelectorAll('[data-close-signin]').forEach((btn) => btn.addEventListener('click', closeSignIn));
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        showError('');
+        const username = usernameInput.value.trim();
+        const password = passwordInput.value;
+        if (!username || !password) {
+          showError('Please enter your email and password.');
+          (username ? passwordInput : usernameInput).focus();
+          return;
+        }
+        abortConditional();
+        setBusy(true);
+        try {
+          await passwordSignIn(username, password);
+          onSignedIn();
+        } catch (err) {
+          showError(err.message);
+          passwordInput.select();
+          startConditionalPasskey();
+        } finally {
+          setBusy(false);
+        }
+      });
+
+      passkeyBtn.addEventListener('click', async () => {
+        showError('');
+        try {
+          if (await passkeySignIn('optional')) onSignedIn();
+        } catch (err) {
+          if (err.name !== 'AbortError') showError(friendlyWebAuthnError(err));
+          if (dialog.open) startConditionalPasskey();
+        }
+      });
+
+      // Intercept links that need an account; let everything else navigate normally.
+      document.addEventListener('click', (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const link = e.target.closest('a[data-auth-required], a[data-signin-trigger]');
+        if (!link) return;
+        const isSigninTrigger = link.hasAttribute('data-signin-trigger');
+        if (signedIn && !isSigninTrigger) return;
+        e.preventDefault();
+        openSignIn(isSigninTrigger ? null : link.href, isSigninTrigger ? null : link.textContent.trim(), link);
+      });
+
+      // ---------- Init ----------
+      if (webauthnSupported) {
+        passkeyBtn.hidden = false;
+        passkeyDivider.hidden = false;
+      }
+
+      // Determine current session so signed-in users are never interrupted.
+      fetch(API.session, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
+        .then((res) => setSignedIn(res.ok))
+        .catch(() => setSignedIn(false));
+    })();
+  </script>
+
 </body>
 
