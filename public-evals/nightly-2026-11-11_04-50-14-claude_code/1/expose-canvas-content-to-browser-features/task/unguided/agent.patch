+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('customizer-stage');
+      const ctx = canvas.getContext('2d');
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('cup-milk');
+      const syrupSelect = document.getElementById('cup-syrup');
+
+      // Logical design space; everything is drawn in these units and scaled.
+      const W = 720, H = 480;
+
+      // Where each live control sits in design units (x, y, width, height).
+      const controls = [
+        { el: document.getElementById('ctl-name'), x: 186, y: 262, w: 168, h: 38 },
+        { el: document.getElementById('ctl-milk'), x: 466, y: 170, w: 210, h: 38 },
+        { el: document.getElementById('ctl-syrup'), x: 466, y: 256, w: 210, h: 38 },
+      ];
+      controls.forEach(c => {
+        c.el.style.width = c.w + 'px';
+        c.el.style.height = c.h + 'px';
+      });
+
+      const MILK = {
+        whole: { label: 'Whole Milk', coffee: '#b07a4f', foam: '#f3e3cf', price: 0 },
+        oat: { label: 'Oat Milk', coffee: '#b98a5e', foam: '#efe0c4', price: 0.75 },
+        almond: { label: 'Almond Milk', coffee: '#a87650', foam: '#f1e2d0', price: 0.75 },
+        skim: { label: 'Skim Milk', coffee: '#9c6b45', foam: '#f6ede2', price: 0 },
+        none: { label: 'Black', coffee: '#3b2216', foam: null, price: 0 },
+      };
+      const SYRUP = {
+        none: { label: '', color: null, price: 0 },
+        maple: { label: 'Maple', color: '#c56a1a', price: 0.6 },
+        vanilla: { label: 'Vanilla', color: '#f2d98a', price: 0.6 },
+        caramel: { label: 'Caramel', color: '#b5651d', price: 0.6 },
+        hazelnut: { label: 'Hazelnut', color: '#8d5b3a', price: 0.6 },
+        mocha: { label: 'Mocha', color: '#4a2a1a', price: 0.6 },
+      };
+      const BASE_PRICE = 4.25;
+
+      // Feature detection for the HTML-in-Canvas API (layoutsubtree + drawElementImage).
+      const proto = window.CanvasRenderingContext2D && CanvasRenderingContext2D.prototype;
+      const drawEl = proto && (proto.drawElementImage || proto.drawElement);
+      const nativeHTMLInCanvas = !!drawEl && ('layoutSubtree' in canvas || 'onpaint' in canvas || !!proto.drawElementImage);
+
+      // Fallback: move controls into an overlay positioned exactly over the canvas.
+      let overlay = null;
+      if (!nativeHTMLInCanvas) {
+        canvas.removeAttribute('layoutsubtree');
+        overlay = document.createElement('div');
+        overlay.className = 'customizer-overlay';
+        controls.forEach(c => overlay.appendChild(c.el));
+        stage.appendChild(overlay);
+      }
+
+      let cssW = 0, cssH = 0, dpr = window.devicePixelRatio || 1;
+
+      function resize(entry) {
+        const rect = canvas.getBoundingClientRect();
+        cssW = rect.width;
+        cssH = rect.height;
+        let pxW, pxH;
+        const dp = entry && entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0];
+        if (dp) {
+          pxW = dp.inlineSize;
+          pxH = dp.blockSize;
+        } else {
+          dpr = window.devicePixelRatio || 1;
+          pxW = Math.round(cssW * dpr);
+          pxH = Math.round(cssH * dpr);
+        }
+        if (canvas.width !== pxW || canvas.height !== pxH) {
+          canvas.width = pxW;
+          canvas.height = pxH;
+        }
+        schedule();
+      }
+
+      // ---------- drawing helpers ----------
+      function roundRect(x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.moveTo(x + r, y);
+        ctx.arcTo(x + w, y, x + w, y + h, r);
+        ctx.arcTo(x + w, y + h, x, y + h, r);
+        ctx.arcTo(x, y + h, x, y, r);
+        ctx.arcTo(x, y, x + w, y, r);
+        ctx.closePath();
+      }
+
+      // Half-width of the cup body at a given y (tapered cup).
+      const CUP_TOP = 130, CUP_BOTTOM = 420, CUP_CX = 270, TOP_HW = 120, BOT_HW = 88;
+      const hwAt = y => TOP_HW + (BOT_HW - TOP_HW) * ((y - CUP_TOP) / (CUP_BOTTOM - CUP_TOP));
+
+      function drawCup(milk, syrup, t) {
+        // Shadow
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.15)';
+        ctx.beginPath();
+        ctx.ellipse(CUP_CX, CUP_BOTTOM + 8, 120, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Steam
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 5;
+        ctx.lineCap = 'round';
+        for (let i = -1; i <= 1; i++) {
+          const x0 = CUP_CX + i * 40;
+          ctx.beginPath();
+          for (let y = 0; y <= 70; y += 5) {
+            const x = x0 + Math.sin((y / 18) + t * 2 + i) * 8;
+            const yy = CUP_TOP - 30 - y;
+            y === 0 ? ctx.moveTo(x, yy) : ctx.lineTo(x, yy);
+          }
+          ctx.stroke();
+        }
+
+        // Body
+        const body = ctx.createLinearGradient(CUP_CX - TOP_HW, 0, CUP_CX + TOP_HW, 0);
+        body.addColorStop(0, '#e9e1d9');
+        body.addColorStop(0.35, '#ffffff');
+        body.addColorStop(1, '#d9cfc5');
+        ctx.fillStyle = body;
+        ctx.beginPath();
+        ctx.moveTo(CUP_CX - TOP_HW, CUP_TOP);
+        ctx.lineTo(CUP_CX + TOP_HW, CUP_TOP);
+        ctx.lineTo(CUP_CX + BOT_HW, CUP_BOTTOM);
+        ctx.ellipse(CUP_CX, CUP_BOTTOM, BOT_HW, 12, 0, 0, Math.PI);
+        ctx.closePath();
+        ctx.fill();
+        ctx.strokeStyle = '#a1887f';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Sleeve
+        const sTop = 236, sBot = 326;
+        ctx.fillStyle = '#8d6e63';
+        ctx.beginPath();
+        ctx.moveTo(CUP_CX - hwAt(sTop) - 3, sTop);
+        ctx.lineTo(CUP_CX + hwAt(sTop) + 3, sTop);
+        ctx.lineTo(CUP_CX + hwAt(sBot) + 3, sBot);
+        ctx.lineTo(CUP_CX - hwAt(sBot) - 3, sBot);
+        ctx.closePath();
+        ctx.fill();
+        ctx.fillStyle = 'rgba(255,255,255,0.12)';
+        for (let y = sTop + 6; y < sBot; y += 12) {
+          ctx.fillRect(CUP_CX - hwAt(y), y, hwAt(y) * 2, 2);
+        }
+        ctx.fillStyle = '#fff3e0';
+        ctx.font = '600 12px "Segoe UI", sans-serif';
+        ctx.textAlign = 'center';
+        ctx.fillText('THE DAILY GRIND', CUP_CX, sTop + 18);
+
+        // Rim
+        ctx.fillStyle = '#f5efe9';
+        ctx.beginPath();
+        ctx.ellipse(CUP_CX, CUP_TOP, TOP_HW, 22, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+
+        // Coffee surface
+        ctx.save();
+        ctx.beginPath();
+        ctx.ellipse(CUP_CX, CUP_TOP + 4, TOP_HW - 10, 16, 0, 0, Math.PI * 2);
+        ctx.clip();
+        ctx.fillStyle = milk.coffee;
+        ctx.fillRect(CUP_CX - TOP_HW, CUP_TOP - 20, TOP_HW * 2, 40);
+        if (milk.foam) {
+          // Latte-art heart
+          ctx.fillStyle = milk.foam;
+          ctx.beginPath();
+          ctx.ellipse(CUP_CX - 14, CUP_TOP + 1, 22, 9, -0.2, 0, Math.PI * 2);
+          ctx.ellipse(CUP_CX + 14, CUP_TOP + 1, 22, 9, 0.2, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.beginPath();
+          ctx.moveTo(CUP_CX - 34, CUP_TOP + 4);
+          ctx.quadraticCurveTo(CUP_CX, CUP_TOP + 22, CUP_CX + 34, CUP_TOP + 4);
+          ctx.fill();
+        }
+        if (syrup.color) {
+          ctx.strokeStyle = syrup.color;
+          ctx.lineWidth = 2.5;
+          ctx.beginPath();
+          for (let a = 0; a <= Math.PI * 6; a += 0.1) {
+            const r = 6 + a * 4.5;
+            const x = CUP_CX + Math.cos(a + t * 0.6) * r;
+            const y = CUP_TOP + 4 + Math.sin(a + t * 0.6) * r * 0.16;
+            a === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
+          }
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Name label backing on the sleeve (input is rendered on top of this)
+        const n = controls[0];
+        ctx.fillStyle = 'rgba(255, 243, 224, 0.25)';
+        roundRect(n.x - 6, n.y - 6, n.w + 12, n.h + 12, 9);
+        ctx.fill();
+      }
+
+      function drawPanel(milk, syrup, name) {
+        // Order card
+        ctx.fillStyle = '#ffffff';
+        ctx.shadowColor = 'rgba(0,0,0,0.12)';
+        ctx.shadowBlur = 12;
+        ctx.shadowOffsetY = 3;
+        roundRect(446, 70, 250, 350, 14);
+        ctx.fill();
+        ctx.shadowColor = 'transparent';
+        ctx.strokeStyle = '#d7ccc8';
+        ctx.lineWidth = 1.5;
+        ctx.stroke();
+
+        ctx.textAlign = 'left';
+        ctx.fillStyle = '#4e342e';
+        ctx.font = 'bold 22px "Segoe UI", sans-serif';
+        ctx.fillText('Your Order', 466, 110);
+
+        ctx.font = '600 13px "Segoe UI", sans-serif';
+        ctx.fillStyle = '#8d6e63';
+        ctx.fillText('MILK', 466, 160);
+        ctx.fillText('SYRUP', 466, 246);
+
+        // Swatches next to labels
+        const swatch = (x, y, color) => {
+          ctx.beginPath();
+          ctx.arc(x, y, 6, 0, Math.PI * 2);
+          ctx.fillStyle = color;
+          ctx.fill();
+          ctx.strokeStyle = '#a1887f';
+          ctx.lineWidth = 1;
+          ctx.stroke();
+        };
+        swatch(676 - 6, 155, milk.foam || milk.coffee);
+        swatch(676 - 6, 241, syrup.color || '#ffffff');
+
+        ctx.strokeStyle = '#efebe9';
+        ctx.beginPath();
+        ctx.moveTo(466, 318);
+        ctx.lineTo(676, 318);
+        ctx.stroke();
+
+        // Live summary text
+        const who = name.trim() ? name.trim() + "'s" : 'Your';
+        const drink = (syrup.label ? syrup.label + ' ' : '') +
+          (milk.foam ? milk.label.replace(' Milk', '') + ' Latte' : 'Americano');
+        ctx.fillStyle = '#3e2723';
+        ctx.font = '600 16px "Segoe UI", sans-serif';
+        wrapText(who + ' ' + drink, 466, 344, 210, 20, 2);
+
+        const price = BASE_PRICE + milk.price + syrup.price;
+        ctx.fillStyle = '#4e342e';
+        ctx.font = 'bold 26px "Segoe UI", sans-serif';
+        ctx.fillText('$' + price.toFixed(2), 466, 402);
+      }
+
+      function wrapText(text, x, y, maxW, lineH, maxLines) {
+        const words = text.split(' ');
+        let line = '', lines = 0;
+        for (let i = 0; i < words.length; i++) {
+          const test = line ? line + ' ' + words[i] : words[i];
+          if (ctx.measureText(test).width > maxW && line) {
+            ctx.fillText(line, x, y + lines * lineH);
+            line = words[i];
+            if (++lines >= maxLines - 1) {
+              line = words.slice(i).join(' ');
+              break;
+            }
+          } else {
+            line = test;
+          }
+        }
+        while (line.length > 1 && ctx.measureText(line).width > maxW) line = line.slice(0, -2) + '…';
+        ctx.fillText(line, x, y + lines * lineH);
+      }
+
+      // ---------- main paint ----------
+      function paint() {
+        if (!cssW) return;
+        const t = performance.now() / 1000;
+        const scale = cssW / W;              // design units -> CSS px
+        const gx = canvas.width / cssW;      // CSS px -> device pixels
+
+        if (ctx.reset) ctx.reset(); else ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(gx * scale, 0, 0, gx * scale, 0, 0);
+
+        const bg = ctx.createLinearGradient(0, 0, 0, H);
+        bg.addColorStop(0, '#fff8f0');
+        bg.addColorStop(1, '#f3e5d8');
+        ctx.fillStyle = bg;
+        ctx.fillRect(0, 0, W, H);
+
+        const milk = MILK[milkSelect.value] || MILK.oat;
+        const syrup = SYRUP[syrupSelect.value] || SYRUP.none;
+
+        drawCup(milk, syrup, t);
+        drawPanel(milk, syrup, nameInput.value);
+
+        // Render the live HTML controls into the graphic, and keep their
+        // hit-testing / accessibility boxes aligned with where they are drawn.
+        controls.forEach(c => {
+          if (nativeHTMLInCanvas) {
+            const m = drawEl.call(ctx, c.el, c.x, c.y);
+            if (m && typeof m.toString === 'function' && m.toString() !== '[object Object]') {
+              c.el.style.transform = m.toString();
+            } else {
+              c.el.style.transform = `translate(${c.x * scale}px, ${c.y * scale}px) scale(${scale})`;
+            }
+          } else {
+            c.el.style.transform = `translate(${c.x * scale}px, ${c.y * scale}px) scale(${scale})`;
+          }
+        });
+      }
+
+      let queued = false;
+      function schedule() {
+        if (queued) return;
+        queued = true;
+        requestAnimationFrame(() => {
+          queued = false;
+          paint();
+        });
+      }
+
+      // Native API fires 'paint' when child content changes (typing, focus, etc).
+      if (nativeHTMLInCanvas) canvas.addEventListener('paint', schedule);
+      [nameInput, milkSelect, syrupSelect].forEach(el => {
+        el.addEventListener('input', schedule);
+        el.addEventListener('change', schedule);
+        el.addEventListener('focus', schedule);
+        el.addEventListener('blur', schedule);
+      });
+
+      // Gentle animation (steam + syrup swirl) unless reduced motion is requested.
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let visible = true;
+      function loop() {
+        if (visible && !reduceMotion.matches) paint();
+        requestAnimationFrame(loop);
+      }
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(canvas);
+      }
+      requestAnimationFrame(loop);
+
+      // Track size changes at device-pixel precision for crisp high-DPI rendering.
+      const ro = new ResizeObserver(([entry]) => resize(entry));
+      try {
+        ro.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch (e) {
+        ro.observe(canvas);
+      }
+      // Catch DPR changes (zoom, moving between monitors).
+      const watchDpr = () => {
+        const mq = window.matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
+        mq.addEventListener('change', () => { resize(); watchDpr(); }, { once: true });
+      };
+      watchDpr();
+      resize();
+    })();
+  </script>
+
