+        ctx.lineWidth = 22;
+        ctx.beginPath();
+        ctx.arc(386, 210, 52, -Math.PI / 2.2, Math.PI / 2.4);
+        ctx.stroke();
+        ctx.strokeStyle = '#8d6e63';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.arc(386, 210, 63, -Math.PI / 2.3, Math.PI / 2.5);
+        ctx.stroke();
+
+        // Cup body
+        const body = cupPath();
+        const glaze = ctx.createLinearGradient(88, 0, 392, 0);
+        glaze.addColorStop(0, '#e9dfd9');
+        glaze.addColorStop(0.35, '#ffffff');
+        glaze.addColorStop(1, '#d9cbc4');
+        ctx.fillStyle = glaze;
+        ctx.fill(body);
+        ctx.strokeStyle = '#8d6e63';
+        ctx.stroke(body);
+
+        // Rim and coffee surface
+        ctx.fillStyle = '#f5efeb';
+        ctx.beginPath();
+        ctx.ellipse(240, 92, 152, 24, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+        ctx.fillStyle = milk.color;
+        ctx.beginPath();
+        ctx.ellipse(240, 94, 138, 18, 0, 0, Math.PI * 2);
