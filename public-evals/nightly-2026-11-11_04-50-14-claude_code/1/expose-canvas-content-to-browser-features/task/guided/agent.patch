+  <script>
+    (() => {
+      // Design space: everything is drawn in a fixed 480x440 coordinate system
+      // and scaled to the canvas's actual (device-pixel) size.
+      const W = 480;
+      const H = 440;
+      const FORM_X = 130;
+      const FORM_Y = 128;
+
+      const MILKS = {
+        none: { label: 'black coffee', color: '#3b2417' },
+        whole: { label: 'whole milk', color: '#b98a5e' },
+        oat: { label: 'oat milk', color: '#c49a6c' },
+        almond: { label: 'almond milk', color: '#c7a27a' },
+        soy: { label: 'soy milk', color: '#bf9466' },
+      };
+      const SYRUPS = {
+        none: { label: '', color: null },
+        vanilla: { label: 'vanilla', color: '#f6e7b4' },
+        caramel: { label: 'caramel', color: '#c9781f' },
+        hazelnut: { label: 'hazelnut', color: '#7a4a24' },
+        maple: { label: 'maple', color: '#a8501a' },
+      };
+
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('cup-stage');
+      const form = document.getElementById('cup-form');
+      const ctx = canvas.getContext('2d');
+
+      const supportsHtmlInCanvas =
+        'content' in HTMLCanvasElement.prototype &&
+        typeof CanvasRenderingContext2D !== 'undefined' &&
+        'drawElementImage' in CanvasRenderingContext2D.prototype &&
+        'requestPaint' in HTMLCanvasElement.prototype;
+
+      if (!supportsHtmlInCanvas) {
+        // Canvas children are fallback content (not rendered) in browsers without
+        // HTML-in-Canvas, so move the form next to the canvas and overlay it.
+        stage.classList.add('overlay');
+        stage.append(form);
+      }
+
+      function readOrder() {
+        const data = new FormData(form);
+        const name = String(data.get('cupName') || '').trim();
+        const milk = MILKS[data.get('milk')] || MILKS.whole;
+        const syrup = SYRUPS[data.get('syrup')] || SYRUPS.none;
+        return { name, milk, syrup };
+      }
+
+      function updateSummary() {
+        const { name, milk, syrup } = readOrder();
+        const drink = milk === MILKS.none ? 'Black coffee' : `Latte with ${milk.label}`;
+        const extra = syrup.label ? ` & ${syrup.label}` : '';
+        form.elements.summary.value = `${name ? name + '’s' : 'Your'} cup: ${drink}${extra}`;
+      }
+
+      function cupPath() {
+        const p = new Path2D();
+        p.moveTo(88, 92);
+        p.lineTo(392, 92);
+        p.lineTo(362, 340);
+        p.quadraticCurveTo(356, 372, 322, 372);
+        p.lineTo(158, 372);
+        p.quadraticCurveTo(124, 372, 118, 340);
+        p.closePath();
+        return p;
+      }
+
+      function drawCup() {
+        const { milk, syrup } = readOrder();
+
+        // Saucer
+        ctx.fillStyle = 'rgba(0, 0, 0, 0.12)';
+        ctx.beginPath();
+        ctx.ellipse(244, 404, 206, 26, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const saucer = ctx.createLinearGradient(0, 360, 0, 410);
+        saucer.addColorStop(0, '#fffaf5');
+        saucer.addColorStop(1, '#d7ccc8');
+        ctx.fillStyle = saucer;
+        ctx.strokeStyle = '#8d6e63';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.ellipse(240, 380, 210, 34, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+
+        // Handle
