+
+        // Latte art heart for milk drinks
+        if (milk !== MILKS.none) {
+          ctx.fillStyle = 'rgba(255, 248, 238, 0.85)';
+          ctx.beginPath();
+          ctx.moveTo(240, 104);
+          ctx.bezierCurveTo(205, 92, 220, 80, 240, 88);
+          ctx.bezierCurveTo(260, 80, 275, 92, 240, 104);
+          ctx.fill();
+        }
+
+        // Syrup drizzle
+        if (syrup.color) {
+          ctx.save();
+          ctx.beginPath();
+          ctx.ellipse(240, 94, 134, 16, 0, 0, Math.PI * 2);
+          ctx.clip();
+          ctx.strokeStyle = syrup.color;
+          ctx.lineWidth = 3;
+          ctx.lineCap = 'round';
+          ctx.beginPath();
+          for (let i = 0; i <= 12; i++) {
+            const x = 130 + i * 18;
+            const y = i % 2 ? 84 : 104;
+            i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
+          }
+          ctx.stroke();
+          ctx.restore();
+        }
+
+        // Steam
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 4;
+        ctx.lineCap = 'round';
+        for (const x of [200, 240, 280]) {
+          ctx.beginPath();
+          ctx.moveTo(x, 62);
+          ctx.bezierCurveTo(x - 14, 46, x + 14, 34, x, 14);
+          ctx.stroke();
+        }
+      }
+
+      function draw() {
+        ctx.reset();
+        const scale = canvas.width / W; // canvas grid pixels per design unit
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+        drawCup();
+
+        if (supportsHtmlInCanvas) {
+          // Draw the live form onto the cup. The browser syncs hit testing and
+          // accessibility geometry with where it's drawn (including the scale).
+          ctx.drawElementImage(form, FORM_X, FORM_Y, form.offsetWidth, form.offsetHeight);
