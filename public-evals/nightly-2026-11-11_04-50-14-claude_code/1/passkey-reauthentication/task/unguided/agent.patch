+  <script>
+    (function () {
+      'use strict';
+
+      var button = document.querySelector('[data-testid="reauth-button"]');
+      var statusEl = document.getElementById('reauth-status');
+      if (!button) return;
+
+      function setStatus(msg, kind) {
+        statusEl.textContent = msg;
+        statusEl.className = 'reauth-status' + (kind ? ' ' + kind : '');
+      }
+
+      // --- base64url helpers ---
+      function b64urlToBuffer(value) {
+        if (value instanceof ArrayBuffer) return value;
+        if (ArrayBuffer.isView(value)) return value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength);
+        var b64 = String(value).replace(/-/g, '+').replace(/_/g, '/');
+        var pad = b64.length % 4;
+        if (pad) b64 += '===='.slice(pad);
+        var bin = atob(b64);
+        var bytes = new Uint8Array(bin.length);
+        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buf) {
+        if (!buf) return null;
+        var bytes = new Uint8Array(buf);
+        var bin = '';
+        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      // Convert server JSON (base64url strings) into PublicKeyCredentialRequestOptions.
+      function toRequestOptions(json) {
+        var opts = json && json.publicKey ? json.publicKey : json;
+        if (!opts || !opts.challenge) throw new Error('Server did not return a valid challenge.');
+        if (!Array.isArray(opts.allowCredentials) || opts.allowCredentials.length === 0) {
+          throw new Error('No registered security keys were found for your account.');
+        }
+
+        var publicKey = {
+          challenge: b64urlToBuffer(opts.challenge),
+          allowCredentials: opts.allowCredentials.map(function (c) {
+            var d = { type: c.type || 'public-key', id: b64urlToBuffer(c.id) };
+            if (Array.isArray(c.transports)) d.transports = c.transports;
+            return d;
+          }),
+          // Always require user verification (PIN/biometric) for re-authentication.
+          userVerification: 'required'
+        };
+        if (opts.rpId) publicKey.rpId = opts.rpId;
+        if (typeof opts.timeout === 'number') publicKey.timeout = opts.timeout;
+        if (opts.extensions) publicKey.extensions = opts.extensions;
+        return publicKey;
+      }
+
+      function credentialToJSON(cred) {
+        var r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null
+          }
+        };
+      }
+
+      async function postJSON(url, body) {
+        var res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body || {})
+        });
+        var data = null;
+        try { data = await res.json(); } catch (e) { /* non-JSON body */ }
+        if (!res.ok) {
+          var msg = (data && (data.error || data.message)) || ('Request failed (' + res.status + ')');
+          throw new Error(msg);
+        }
+        return data;
+      }
+
+      var inFlight = false;
+
+      button.addEventListener('click', async function () {
+        if (inFlight) return;
+
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.get) {
+          setStatus('Your browser does not support security keys or passkeys.', 'error');
+          return;
+        }
+
+        inFlight = true;
+        button.disabled = true;
+        setStatus('Requesting challenge…');
+
+        try {
+          // 1. Fetch a fresh challenge scoped to the signed-in user's registered credentials.
+          var optionsJSON = await postJSON('/api/reauth/options', {});
+          var publicKey = toRequestOptions(optionsJSON);
+
+          // 2. Run the WebAuthn assertion ceremony (origin-bound, phishing-resistant).
+          setStatus('Follow your browser prompt to verify with your security key…');
+          var credential = await navigator.credentials.get({ publicKey: publicKey });
+          if (!credential) throw new Error('No credential was returned.');
+
+          // 3. Submit the signed assertion for server-side verification.
+          setStatus('Verifying…');
+          var result = await postJSON('/api/reauth/verify', credentialToJSON(credential));
+
+          if (result && (result.verified === false || result.success === false)) {
+            throw new Error(result.error || result.message || 'Verification failed.');
+          }
+
+          setStatus('Identity confirmed. You may now make your account change.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success', { detail: result }));
+        } catch (err) {
+          var msg;
+          if (err && err.name === 'NotAllowedError') {
+            msg = 'Verification was cancelled or timed out. Please try again.';
+          } else if (err && err.name === 'SecurityError') {
+            msg = 'Verification is not permitted on this site.';
+          } else if (err && err.name === 'InvalidStateError') {
+            msg = 'This authenticator is not registered to your account.';
+          } else {
+            msg = (err && err.message) || 'Verification failed. Please try again.';
+          }
+          setStatus(msg, 'error');
+          document.dispatchEvent(new CustomEvent('reauth:failure', { detail: { error: msg } }));
+        } finally {
+          inFlight = false;
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
