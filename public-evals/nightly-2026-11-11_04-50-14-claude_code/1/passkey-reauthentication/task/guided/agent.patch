+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs"
+      },
+      "integrity": {
+        "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs": "sha384-EBLK1vCYl7ILfHGSetlZN/n8TaV5nbYKx9JrMwcJvy5NTITz1Q9HDYqCG4NxzuR0"
+      }
+    }
+  </script>
+  <script type="module">
+    const button = document.getElementById('reauth-btn');
+    const statusEl = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function ensureWebAuthnJSONSupport() {
+      if (!window.PublicKeyCredential) return false;
+      const needsPolyfill =
+        typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function';
+      if (needsPolyfill) {
+        await import('webauthn-polyfills');
+      }
+      return true;
+    }
+
+    async function triggerButtonReauth() {
+      // Cancel any in-flight WebAuthn request to avoid prompt collisions.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Waiting for passkey verification…');
+
+      try {
+        if (!(await ensureWebAuthnJSONSupport())) {
+          setStatus('This browser does not support passkeys, so identity verification is unavailable.', 'error');
+          return;
+        }
+
+        // Server returns request options scoped to the signed-in user's
+        // registered credentials (allowCredentials) with a fresh challenge.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Failed to get reauthentication options (${optionsResponse.status})`);
+        }
+        const optionsJSON = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        if (!publicKey.allowCredentials || publicKey.allowCredentials.length === 0) {
+          setStatus('No passkeys are registered on this account. Add a passkey before making sensitive changes.', 'error');
+          return;
+        }
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          setStatus('Verification was not completed.', 'error');
+          return;
+        }
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          setStatus('Identity confirmed. You can now update your account settings.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+        } else {
+          if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Tell the passkey provider this credential no longer exists server-side.
+            // Always use the server-provided rpId, never window.location.hostname.
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encodedCredential.id,
+            }).catch(() => {});
+          }
+          setStatus('We could not verify your identity. Please try again.', 'error');
+        }
+      } catch (err) {
+        if (err.name === 'AbortError') return;
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled or timed out.', 'error');
+        } else {
+          console.error(err);
+          setStatus('Something went wrong during verification. Please try again.', 'error');
+        }
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', triggerButtonReauth);
+  </script>
+
 </body>
 
