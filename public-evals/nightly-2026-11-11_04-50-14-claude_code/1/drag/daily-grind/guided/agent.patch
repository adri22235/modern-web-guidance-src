+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      const grip = document.getElementById('qo-grip');
+      const moveBtn = document.getElementById('qo-move-btn');
+      const moveMenu = document.getElementById('qo-move-menu');
+      const helpBtn = document.getElementById('qo-help-btn');
+      const help = document.getElementById('qo-help');
+      const announcer = document.getElementById('qo-announcer');
+      const STORAGE_KEY = 'dailyGrind.quickOrder.position';
+      const MARGIN = 8;
+      const STEP = 15;
+      const BIG_STEP = 60;
+
+      /* ---------- Dragging (progressive enhancement) ---------- */
+      panel.classList.add('js-drag');
+      grip.hidden = false;
+      moveBtn.hidden = false;
+      helpBtn.hidden = false;
+
+      let announceTimer;
+      function announce(msg) {
+        announcer.textContent = msg;
+        clearTimeout(announceTimer);
+        announceTimer = setTimeout(() => { announcer.textContent = ''; }, 1000);
+      }
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(MARGIN, window.innerWidth - panel.offsetWidth - MARGIN);
+        const maxTop = Math.max(MARGIN, window.innerHeight - panel.offsetHeight - MARGIN);
+        const x = Math.max(MARGIN, Math.min(left, maxLeft));
+        const y = Math.max(MARGIN, Math.min(top, maxTop));
+        panel.classList.add('is-positioned');
+        panel.style.left = `${x}px`;
+        panel.style.top = `${y}px`;
+        return { x, y };
+      }
+
+      function savePosition() {
+        const rect = panel.getBoundingClientRect();
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify({ left: rect.left, top: rect.top }));
+        } catch { /* storage unavailable */ }
+      }
+
+      function currentPos() {
+        const rect = panel.getBoundingClientRect();
+        return { left: rect.left, top: rect.top };
+      }
+
+      // Restore saved position, or convert the CSS bottom-right default to left/top.
+      (function initPosition() {
+        let saved = null;
+        try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)); } catch { /* ignore */ }
+        if (saved && Number.isFinite(saved.left) && Number.isFinite(saved.top)) {
+          moveTo(saved.left, saved.top);
+        } else {
+          const { left, top } = currentPos();
+          moveTo(left, top);
+        }
+      })();
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let dragging = false;
+
+      handle.addEventListener('pointerdown', (event) => {
+        const control = event.target.closest('button, input, select, textarea, a, [role="menu"]');
+        if (event.button !== 0 || (control && control !== grip)) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        dragging = false;
+        closeMenu();
+        handle.setPointerCapture(event.pointerId);
+        event.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!dragging) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < 4) return;
