+          announce('Quick order panel moved');
+        }
+        dragging = false;
+        handle.classList.remove('dragging');
+      });
+
+      // Keyboard movement on the grip button
+      const KEY_DIRS = {
+        ArrowLeft: [-1, 0, 'left'],
+        ArrowRight: [1, 0, 'right'],
+        ArrowUp: [0, -1, 'up'],
+        ArrowDown: [0, 1, 'down'],
