+      });
+
+      moveMenu.addEventListener('keydown', (event) => {
+        const items = [...moveMenu.querySelectorAll('button')];
+        const i = items.indexOf(document.activeElement);
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeMenu(true);
+        } else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
+          event.preventDefault();
+          items[(i + 1) % items.length].focus();
+        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
+          event.preventDefault();
+          items[(i - 1 + items.length) % items.length].focus();
+        } else if (event.key === 'Home') {
+          event.preventDefault();
+          items[0].focus();
+        } else if (event.key === 'End') {
+          event.preventDefault();
+          items.at(-1).focus();
+        } else if (event.key === 'Tab') {
+          closeMenu();
+        }
+      });
+
+      document.addEventListener('pointerdown', (event) => {
+        if (!moveMenu.contains(event.target) && event.target !== moveBtn) closeMenu();
+      });
+
+      function toggleHelp() {
+        const open = help.hidden;
+        help.hidden = !open;
+        helpBtn.setAttribute('aria-expanded', String(open));
+        reclamp();
+      }
+      helpBtn.addEventListener('click', toggleHelp);
+
+      // Keep the panel reachable when the viewport or panel size changes
+      function reclamp() {
+        const { left, top } = currentPos();
+        moveTo(left, top);
+      }
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      /* ---------- Collapse ---------- */
+      const collapseBtn = document.getElementById('qo-collapse');
+      const body = document.getElementById('qo-body');
+      collapseBtn.addEventListener('click', () => {
+        const expanded = collapseBtn.getAttribute('aria-expanded') === 'true';
+        body.hidden = expanded;
+        collapseBtn.setAttribute('aria-expanded', String(!expanded));
+        collapseBtn.setAttribute('aria-label', expanded ? 'Expand quick order' : 'Collapse quick order');
+        collapseBtn.innerHTML = expanded ? '+' : '&minus;';
+      });
+
+      /* ---------- Order logic ---------- */
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const drinkSelect = document.getElementById('qo-drink-select');
+      const img = document.getElementById('qo-img');
+      const milk = document.getElementById('qo-milk');
+      const shot = document.getElementById('qo-shot');
+      const qtyOut = document.getElementById('qo-qty');
+      const qtyInput = document.getElementById('qo-qty-input');
+      const linePrice = document.getElementById('qo-line-price');
+      const itemsList = document.getElementById('qo-items');
+      const empty = document.getElementById('qo-empty');
+      const totalEl = document.getElementById('qo-total');
+      const countEl = document.getElementById('qo-count');
+      const checkout = document.getElementById('qo-checkout');
+      const status = document.getElementById('qo-status');
+      const CART_KEY = 'dailyGrind.quickOrder.cart';
+      const MAX_QTY = 10;
+
+      let qty = 1;
+      let cart = [];
+      try { cart = JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch { cart = []; }
+
+      function currentConfig() {
+        const opt = drinkSelect.selectedOptions[0];
+        const sizeInput = body.querySelector('input[name="size"]:checked');
+        const unit = parseFloat(opt.dataset.price) + parseFloat(sizeInput.dataset.extra) + (shot.checked ? 0.75 : 0);
+        return {
+          id: crypto.randomUUID?.() ?? String(Date.now() + Math.random()),
+          name: opt.textContent.split(' — ')[0],
+          size: sizeInput.value,
+          milk: milk.value,
+          shot: shot.checked,
+          qty,
+          unit,
+        };
+      }
+
+      function updateLinePrice() {
+        const cfg = currentConfig();
+        linePrice.textContent = money.format(cfg.unit * cfg.qty);
+        qtyOut.textContent = qty;
+        qtyInput.value = qty;
+        img.src = drinkSelect.selectedOptions[0].dataset.img;
+        milk.disabled = drinkSelect.value === 'dark-roast-espresso';
+        if (milk.disabled) milk.value = 'none';
+      }
+
+      function renderCart() {
+        itemsList.replaceChildren(...cart.map((item) => {
+          const li = document.createElement('li');
+          const desc = document.createElement('span');
+          const extras = [item.size, item.milk !== 'none' ? `${item.milk} milk` : null, item.shot ? '+shot' : null].filter(Boolean).join(', ');
+          desc.textContent = `${item.qty}× ${item.name} (${extras})`;
+          const price = document.createElement('span');
+          price.textContent = money.format(item.unit * item.qty);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'qo-remove';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${item.name} from cart`);
+          remove.addEventListener('click', () => {
+            cart = cart.filter((c) => c.id !== item.id);
+            persistCart();
+            renderCart();
+            status.textContent = `Removed ${item.name}.`;
+            (itemsList.querySelector('.qo-remove') || drinkSelect).focus();
+          });
+          li.append(desc, price, remove);
+          return li;
+        }));
+        const count = cart.reduce((n, c) => n + c.qty, 0);
+        const total = cart.reduce((s, c) => s + c.unit * c.qty, 0);
+        empty.hidden = cart.length > 0;
+        totalEl.textContent = money.format(total);
+        countEl.textContent = count;
+        countEl.setAttribute('aria-label', `${count} item${count === 1 ? '' : 's'} in cart`);
+        checkout.disabled = cart.length === 0;
+      }
+
+      function persistCart() {
+        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch { /* ignore */ }
+      }
+
+      document.getElementById('qo-dec').addEventListener('click', () => {
+        qty = Math.max(1, qty - 1);
+        updateLinePrice();
+      });
+      document.getElementById('qo-inc').addEventListener('click', () => {
+        qty = Math.min(MAX_QTY, qty + 1);
+        updateLinePrice();
+      });
+
+      body.addEventListener('change', updateLinePrice);
+
+      body.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const item = currentConfig();
+        cart.push(item);
+        persistCart();
+        renderCart();
+        status.textContent = `Added ${item.qty}× ${item.name} to your cart.`;
+        qty = 1;
+        updateLinePrice();
+      });
+
+      checkout.addEventListener('click', () => {
+        if (!cart.length) return;
+        const total = totalEl.textContent;
+        cart = [];
+        persistCart();
+        renderCart();
+        status.textContent = `Order placed! ${total} — we'll have it ready for pickup in about 10 minutes.`;
+      });
+
+      updateLinePrice();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
 </html>
