+  <script>
+    (function () {
+      // ---------- Draggable behaviour ----------
+      function makeDraggable(panel) {
+        var handle = panel.querySelector('[data-drag-handle]');
+        if (!handle) return;
+        var STORAGE_KEY = 'dg-quick-order-pos';
+        var MARGIN = 8;
+        var drag = null;
+
+        function clamp(x, y) {
+          var r = panel.getBoundingClientRect();
+          var maxX = Math.max(MARGIN, window.innerWidth - r.width - MARGIN);
+          var maxY = Math.max(MARGIN, window.innerHeight - Math.min(r.height, handle.offsetHeight + 40) - MARGIN);
+          return {
+            x: Math.min(Math.max(MARGIN, x), maxX),
+            y: Math.min(Math.max(MARGIN, y), maxY)
+          };
+        }
+
+        function place(x, y, save) {
+          var p = clamp(x, y);
+          panel.style.left = p.x + 'px';
+          panel.style.top = p.y + 'px';
+          panel.style.right = 'auto';
+          panel.style.bottom = 'auto';
+          if (save) {
+            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); } catch (e) { }
+          }
+        }
+
+        // Restore saved position
+        try {
+          var saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
+          if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') place(saved.x, saved.y, false);
+        } catch (e) { }
+
+        handle.addEventListener('pointerdown', function (e) {
+          if (e.button !== 0) return;
+          if (e.target.closest('button, a, input, select, textarea')) return; // let header controls work
+          var r = panel.getBoundingClientRect();
+          drag = { id: e.pointerId, dx: e.clientX - r.left, dy: e.clientY - r.top };
+          handle.setPointerCapture(e.pointerId);
+          panel.classList.add('is-dragging');
+          e.preventDefault();
+        });
+
+        handle.addEventListener('pointermove', function (e) {
+          if (!drag || e.pointerId !== drag.id) return;
+          place(e.clientX - drag.dx, e.clientY - drag.dy, false);
+        });
+
+        function endDrag(e) {
+          if (!drag || e.pointerId !== drag.id) return;
+          drag = null;
+          panel.classList.remove('is-dragging');
+          if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+          var r = panel.getBoundingClientRect();
+          place(r.left, r.top, true);
+        }
+        handle.addEventListener('pointerup', endDrag);
+        handle.addEventListener('pointercancel', endDrag);
+        handle.addEventListener('lostpointercapture', endDrag);
+
+        // Keyboard moving for accessibility
+        handle.addEventListener('keydown', function (e) {
+          if (e.target !== handle) return;
+          var step = e.shiftKey ? 50 : 10;
+          var d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
+          if (!d) return;
+          e.preventDefault();
+          var r = panel.getBoundingClientRect();
+          place(r.left + d[0], r.top + d[1], true);
+        });
+
+        // Keep panel on screen when the viewport changes
+        window.addEventListener('resize', function () {
+          if (!panel.style.left) return;
+          var r = panel.getBoundingClientRect();
+          place(r.left, r.top, false);
+        });
+      }
+
+      document.querySelectorAll('[data-draggable]').forEach(makeDraggable);
+
+      // ---------- Quick order controls ----------
+      var $ = function (id) { return document.getElementById(id); };
+      var panel = $('quick-order');
+      var form = $('qo-body');
+      var drink = $('qo-drink');
+      var milk = $('qo-milk');
+      var qtyEl = $('qo-qty');
+      var addBtn = $('qo-add');
+      var cartEl = $('qo-cart');
+      var totalEl = $('qo-total');
+      var countEl = $('qo-count');
+      var checkoutBtn = $('qo-checkout');
+      var statusEl = $('qo-status');
+      var toggle = $('qo-toggle');
+      var qty = 1;
+      var cart = [];
+      var money = function (n) { return '$' + n.toFixed(2); };
+
+      function currentItem() {
+        var d = drink.selectedOptions[0];
+        var s = form.querySelector('input[name="qo-size"]:checked');
+        var m = milk.selectedOptions[0];
+        var unit = parseFloat(d.dataset.price) + parseFloat(s.dataset.extra) + parseFloat(m.dataset.extra);
+        return { name: d.value, size: s.value, milk: m.value, qty: qty, unit: unit };
+      }
+
+      function updateAddLabel() {
+        qtyEl.textContent = qty;
+        addBtn.textContent = 'Add · ' + money(currentItem().unit * qty);
+      }
+
+      function renderCart() {
+        cartEl.innerHTML = '';
+        if (!cart.length) {
+          var li = document.createElement('li');
+          li.className = 'qo-empty';
+          li.textContent = 'Your cart is empty';
+          cartEl.appendChild(li);
+        }
+        cart.forEach(function (item, i) {
+          var li = document.createElement('li');
+          var label = document.createElement('span');
+          label.textContent = item.qty + '× ' + item.size + ' ' + item.name +
+            (item.milk !== 'Whole' ? ' (' + item.milk + ')' : '');
+          var right = document.createElement('span');
+          right.textContent = money(item.unit * item.qty) + ' ';
+          var rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'qo-remove';
+          rm.setAttribute('aria-label', 'Remove ' + label.textContent);
+          rm.textContent = '×';
+          rm.addEventListener('click', function () { cart.splice(i, 1); renderCart(); });
+          right.appendChild(rm);
+          li.appendChild(label);
+          li.appendChild(right);
+          cartEl.appendChild(li);
+        });
+        var total = cart.reduce(function (t, it) { return t + it.unit * it.qty; }, 0);
+        var count = cart.reduce(function (t, it) { return t + it.qty; }, 0);
+        totalEl.textContent = money(total);
+        countEl.textContent = count;
+        checkoutBtn.disabled = !cart.length;
+      }
+
+      $('qo-minus').addEventListener('click', function () { qty = Math.max(1, qty - 1); updateAddLabel(); });
+      $('qo-plus').addEventListener('click', function () { qty = Math.min(20, qty + 1); updateAddLabel(); });
+      form.addEventListener('change', updateAddLabel);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var item = currentItem();
+        var existing = cart.find(function (c) {
+          return c.name === item.name && c.size === item.size && c.milk === item.milk;
+        });
+        if (existing) existing.qty += item.qty; else cart.push(item);
+        statusEl.textContent = 'Added ' + item.qty + '× ' + item.name + ' to your cart.';
+        qty = 1;
+        updateAddLabel();
+        renderCart();
+      });
+
+      checkoutBtn.addEventListener('click', function () {
+        if (!cart.length) return;
+        statusEl.textContent = 'Order placed! We\'ll have it ready in about 10 minutes.';
+        cart = [];
+        renderCart();
+      });
+
+      toggle.addEventListener('click', function () {
+        var collapsed = panel.classList.toggle('is-collapsed');
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', (collapsed ? 'Expand' : 'Collapse') + ' quick order panel');
+        toggle.textContent = collapsed ? '+' : '–';
+        // re-clamp in case expanding pushes it off screen
+        if (panel.style.left) {
+          var r = panel.getBoundingClientRect();
+          panel.style.top = Math.max(8, Math.min(r.top, window.innerHeight - r.height - 8)) + 'px';
+        }
+      });
+
+      updateAddLabel();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
