index 0000000..34296d6
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,97 @@
+// <drink-card> — hydrates server-rendered (Declarative Shadow DOM) drink cards in place.
+// The server markup is authoritative: we never re-render the shadow tree, we only
+// attach behavior and sync state onto the existing nodes.
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) — keep in-memory state only */
+  }
+}
+
+class DrinkCard extends HTMLElement {
+  #detailsBtn;
+  #panel;
+  #favBtn;
+
+  constructor() {
+    super();
+
+    // Fallback for engines without DSD parsing: the <template shadowrootmode>
+    // stays inert, so attach the shadow root imperatively from that same markup.
+    if (!this.shadowRoot) {
+      const tpl = this.querySelector(':scope > template[shadowrootmode]');
+      const root = this.attachShadow({ mode: 'open' });
+      if (tpl) {
+        root.append(tpl.content.cloneNode(true));
+        tpl.remove();
+      }
+    }
+
+    const root = this.shadowRoot;
+    this.#detailsBtn = root.querySelector('[data-action="details"]');
+    this.#panel = root.querySelector('[data-panel="details"]');
+    this.#favBtn = root.querySelector('[data-action="favorite"]');
+
+    // Listeners attached once, against the existing server markup.
+    this.#detailsBtn?.addEventListener('click', () => this.toggleDetails());
+    this.#favBtn?.addEventListener('click', () => this.toggleFavorite());
+  }
+
+  connectedCallback() {
+    // Restore persisted favorite state onto the server-rendered button (state sync, not a re-render).
+    const id = this.dataset.drinkId;
+    if (id && readFavorites().has(id)) this.#setFavorite(true, { silent: true });
+    this.setAttribute('hydrated', '');
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.#setFavorite(Boolean(value));
+  }
+
+  toggleDetails(force) {
+    const open = force ?? this.#panel.hidden;
+    this.#panel.hidden = !open;
+    this.#detailsBtn.setAttribute('aria-expanded', String(open));
+    this.#detailsBtn.querySelector('[data-label]').textContent = open ? 'Hide details' : 'Show details';
+    this.toggleAttribute('expanded', open);
+  }
+
+  toggleFavorite() {
+    this.#setFavorite(!this.favorite);
+  }
+
+  #setFavorite(on, { silent = false } = {}) {
+    this.toggleAttribute('favorite', on);
+    this.#favBtn.setAttribute('aria-pressed', String(on));
+
+    const id = this.dataset.drinkId;
+    if (id && !silent) {
+      const favs = readFavorites();
+      on ? favs.add(id) : favs.delete(id);
+      writeFavorites(favs);
+    }
+    if (!silent) {
+      this.dispatchEvent(
+        new CustomEvent('favorite-change', { bubbles: true, composed: true, detail: { id, favorite: on } })
+      );
+    }
+  }
+}
+
+if (!customElements.get('drink-card')) customElements.define('drink-card', DrinkCard);
