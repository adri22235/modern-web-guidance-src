+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var stageEl = document.getElementById('roast-stage');
+      var statusEl = document.getElementById('roast-status');
+      if (!widget || !canvas || !canvas.getContext) return;
+
+      var ctx = canvas.getContext('2d');
+      var raf = window.requestAnimationFrame || function (cb) { return setTimeout(function () { cb(Date.now()); }, 16); };
+      var caf = window.cancelAnimationFrame || clearTimeout;
+
+      var rafId = null;
+      var intervalId = null;
+      var running = false;
+      var width = 0, height = 0;
+      var angle = 0;
+      var lastTs = null;
+
+      // --- Simulated roast profile -------------------------------------
+      var CHARGE = 200, TURNING = 95, DROP = 226;
+      var roastSecond = 0; // simulated elapsed roast time (1 tick = 10s of roast)
+      var temp = CHARGE;
+
+      function stageFor(t, sec) {
+        if (sec < 90) return 'Turning point';
+        if (t < 150) return 'Drying phase';
+        if (t < 196) return 'Maillard browning';
+        if (t < 205) return 'First crack!';
+        return 'Development';
+      }
+
+      function tickTemperature() {
+        roastSecond += 10;
+        if (roastSecond < 90) {
+          temp = CHARGE - (CHARGE - TURNING) * (roastSecond / 90);
+        } else {
+          // Rate of rise slows as the roast develops.
+          var ror = Math.max(1.2, 18 - (temp - TURNING) * 0.11);
+          temp += ror * (10 / 60) * 6;
+        }
+        temp += (Math.random() - 0.5) * 0.8; // probe noise
+        if (temp >= DROP) {
+          roastSecond = 0;
+          temp = CHARGE;
+          stageEl.textContent = 'Dropped! Charging next batch\u2026';
+        } else {
+          stageEl.textContent = stageFor(temp, roastSecond);
+        }
+        tempEl.textContent = temp.toFixed(1);
+      }
+
+      // --- Canvas animation --------------------------------------------
+      var beans = [];
+      for (var i = 0; i < 70; i++) {
+        beans.push({
+          r: 0.15 + Math.random() * 0.75,   // radial position inside drum (0..1)
+          a: Math.random() * Math.PI * 2,   // angular offset
+          spin: Math.random() * Math.PI * 2,
+          spinSpeed: (Math.random() - 0.5) * 4,
+          size: 0.85 + Math.random() * 0.3
+        });
+      }
+
+      function beanColor() {
+        // Green -> yellow -> brown -> dark as temperature rises.
+        var p = Math.min(1, Math.max(0, (temp - TURNING) / (DROP - TURNING)));
+        var stops = [[122, 140, 80], [196, 170, 90], [140, 85, 45], [60, 34, 22]];
+        var seg = Math.min(stops.length - 2, Math.floor(p * (stops.length - 1)));
+        var t = p * (stops.length - 1) - seg;
+        var a = stops[seg], b = stops[seg + 1];
+        return 'rgb(' + [0, 1, 2].map(function (k) { return Math.round(a[k] + (b[k] - a[k]) * t); }).join(',') + ')';
+      }
+
+      function resize() {
+        var dpr = window.devicePixelRatio || 1;
+        var rect = canvas.getBoundingClientRect();
+        width = rect.width;
+        height = rect.height;
+        canvas.width = Math.max(1, Math.round(width * dpr));
+        canvas.height = Math.max(1, Math.round(height * dpr));
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      }
+
+      function draw(ts) {
+        if (!running) return;
+        var dt = lastTs == null ? 0 : Math.min(0.05, (ts - lastTs) / 1000);
+        lastTs = ts;
+        angle += dt * 1.6;
+
+        var cx = width / 2, cy = height / 2;
+        var R = Math.min(width, height) * 0.42;
+
+        ctx.clearRect(0, 0, width, height);
+
+        // Heat glow underneath the drum
+        var glow = ctx.createRadialGradient(cx, cy + R, R * 0.1, cx, cy + R, R * 1.4);
+        var heat = Math.min(1, (temp - TURNING) / (DROP - TURNING));
+        glow.addColorStop(0, 'rgba(255,' + Math.round(120 - heat * 60) + ',40,' + (0.25 + heat * 0.35) + ')');
+        glow.addColorStop(1, 'rgba(255,80,20,0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, width, height);
+
+        // Drum
+        ctx.beginPath();
+        ctx.arc(cx, cy, R, 0, Math.PI * 2);
+        ctx.fillStyle = '#3a2a24';
+        ctx.fill();
+        ctx.lineWidth = 6;
+        ctx.strokeStyle = '#8d6e63';
+        ctx.stroke();
+
+        // Drum vanes
+        ctx.save();
+        ctx.translate(cx, cy);
+        ctx.rotate(angle);
+        ctx.strokeStyle = 'rgba(141,110,99,0.5)';
+        ctx.lineWidth = 3;
+        for (var v = 0; v < 6; v++) {
+          ctx.rotate(Math.PI / 3);
+          ctx.beginPath();
+          ctx.moveTo(0, 0);
+          ctx.lineTo(R * 0.95, 0);
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Beans tumble in the lower part of the drum, lifted by rotation
+        var color = beanColor();
+        var bw = Math.max(5, R * 0.075);
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          var theta = Math.PI / 2 + Math.sin(angle * 1.3 + b.a) * 0.9 + (b.a - Math.PI) * 0.25;
+          var bx = cx + Math.cos(theta) * R * b.r * 0.9;
+          var by = cy + Math.sin(theta) * R * b.r * 0.9;
+          b.spin += b.spinSpeed * dt;
+
+          ctx.save();
+          ctx.translate(bx, by);
+          ctx.rotate(b.spin);
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bw * b.size, bw * 0.68 * b.size, 0, 0, Math.PI * 2);
+          ctx.fillStyle = color;
+          ctx.fill();
+          ctx.beginPath();
+          ctx.moveTo(-bw * 0.7 * b.size, 0);
+          ctx.quadraticCurveTo(0, bw * 0.25, bw * 0.7 * b.size, 0);
+          ctx.strokeStyle = 'rgba(0,0,0,0.45)';
+          ctx.lineWidth = 1.2;
+          ctx.stroke();
+          ctx.restore();
+        }
+
+        rafId = raf(draw);
+      }
+
+      // --- Start / stop (idempotent) -----------------------------------
+      function start() {
+        if (running) return;
+        running = true;
+        lastTs = null;
+        resize();
+        rafId = raf(draw);
+        intervalId = setInterval(tickTemperature, 1000);
+        tickTemperature();
+        statusEl.textContent = 'Live';
+      }
+
+      function stop() {
+        if (!running) return;
+        running = false;
+        if (rafId !== null) caf(rafId);
+        if (intervalId !== null) clearInterval(intervalId);
+        rafId = intervalId = null;
+        statusEl.textContent = 'Paused (off-screen)';
+      }
+
+      function setVisible(visible) {
+        if (visible) start(); else stop();
+      }
+
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(function () { if (running) resize(); }).observe(canvas);
+      } else {
+        window.addEventListener('resize', function () { if (running) resize(); });
+      }
+
+      // --- Visibility detection -----------------------------------------
+      // 1) Modern: content-visibility:auto tells us when the browser skips
+      //    or resumes rendering the widget (includes a pre-render margin).
+      // 2) Fallback: IntersectionObserver with a similar margin.
+      // 3) Last resort: scroll/resize geometry checks (very old browsers).
+      if ('ContentVisibilityAutoStateChangeEvent' in window) {
+        widget.addEventListener('contentvisibilityautostatechange', function (e) {
+          setVisible(!e.skipped);
+        });
+      } else if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          for (var i = 0; i < entries.length; i++) setVisible(entries[i].isIntersecting);
+        }, { rootMargin: '200px 0px' }).observe(widget);
+      } else {
+        var pending = false;
+        var check = function () {
+          pending = false;
+          var r = widget.getBoundingClientRect();
+          var vh = window.innerHeight || document.documentElement.clientHeight;
+          setVisible(r.bottom > -200 && r.top < vh + 200);
+        };
+        var schedule = function () {
+          if (!pending) { pending = true; raf(check); }
+        };
+        window.addEventListener('scroll', schedule, { passive: true });
+        window.addEventListener('resize', schedule);
+        check();
+      }
+    })();
+  </script>
+
