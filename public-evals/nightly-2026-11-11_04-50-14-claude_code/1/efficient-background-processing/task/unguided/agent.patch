+  <script>
+    (function () {
+      'use strict';
+
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var stageEl = document.getElementById('roast-stage');
+      if (!widget || !canvas || !tempEl || !canvas.getContext) return;
+
+      var ctx = canvas.getContext('2d');
+
+      // ---- requestAnimationFrame with fallback for older browsers ----
+      var raf = window.requestAnimationFrame ||
+        window.webkitRequestAnimationFrame ||
+        window.mozRequestAnimationFrame ||
+        function (cb) { return window.setTimeout(function () { cb(Date.now()); }, 1000 / 60); };
+      var caf = window.cancelAnimationFrame ||
+        window.webkitCancelAnimationFrame ||
+        window.mozCancelAnimationFrame ||
+        function (id) { window.clearTimeout(id); };
+      var now = (window.performance && performance.now) ?
+        function () { return performance.now(); } :
+        function () { return Date.now(); };
+
+      // ---- Canvas sizing (HiDPI aware) ----
+      var width = 0, height = 0;
+      function resize() {
+        var dpr = window.devicePixelRatio || 1;
+        var rect = canvas.getBoundingClientRect();
+        width = Math.max(1, rect.width);
+        height = Math.max(1, rect.height);
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      }
+
+      // ---- Simulation state ----
+      var MIN_TEMP = 200, MAX_TEMP = 446; // °F
+      var temp = MIN_TEMP;
+      var beans = [];
+      var BEAN_COUNT = 40;
+      for (var i = 0; i < BEAN_COUNT; i++) {
+        beans.push({
+          angle: Math.random() * Math.PI * 2,
+          radius: 0.35 + Math.random() * 0.55,
+          speed: 0.6 + Math.random() * 0.8,
+          rot: Math.random() * Math.PI * 2,
+          spin: (Math.random() - 0.5) * 4,
+          size: 7 + Math.random() * 4
+        });
+      }
+
+      function roastProgress() {
+        return Math.min(1, Math.max(0, (temp - MIN_TEMP) / (MAX_TEMP - MIN_TEMP)));
+      }
+
+      // Green (#8fa05a) -> yellow (#c9a64b) -> brown (#7b4a26) -> dark (#2e1a10)
+      var stops = [[143, 160, 90], [201, 166, 75], [123, 74, 38], [46, 26, 16]];
+      function beanColor(p) {
+        var seg = Math.min(stops.length - 2, Math.floor(p * (stops.length - 1)));
+        var t = p * (stops.length - 1) - seg;
+        var a = stops[seg], b = stops[seg + 1];
+        return 'rgb(' +
+          Math.round(a[0] + (b[0] - a[0]) * t) + ',' +
+          Math.round(a[1] + (b[1] - a[1]) * t) + ',' +
+          Math.round(a[2] + (b[2] - a[2]) * t) + ')';
+      }
+
+      function stageLabel(t) {
+        if (t < 300) return 'Drying phase';
+        if (t < 380) return 'Maillard / browning';
+        if (t < 400) return 'First crack';
+        if (t < 430) return 'Development';
+        return 'Second crack — dropping soon!';
+      }
+
+      function drawBean(b, cx, cy, drumR, color) {
+        var x = cx + Math.cos(b.angle) * drumR * b.radius;
+        var y = cy + Math.sin(b.angle) * drumR * b.radius;
+        ctx.save();
+        ctx.translate(x, y);
+        ctx.rotate(b.rot);
+        ctx.fillStyle = color;
+        ctx.beginPath();
+        if (ctx.ellipse) {
+          ctx.ellipse(0, 0, b.size, b.size * 0.68, 0, 0, Math.PI * 2);
+        } else {
+          ctx.scale(1, 0.68);
+          ctx.arc(0, 0, b.size, 0, Math.PI * 2);
+          ctx.scale(1, 1 / 0.68);
+        }
+        ctx.fill();
+        // centre crease
+        ctx.strokeStyle = 'rgba(0,0,0,0.45)';
+        ctx.lineWidth = 1.2;
+        ctx.beginPath();
+        ctx.moveTo(-b.size * 0.75, 0);
+        ctx.quadraticCurveTo(0, b.size * 0.25, b.size * 0.75, 0);
+        ctx.stroke();
+        ctx.restore();
+      }
+
+      var lastFrame = 0;
+      function render(dt) {
+        var p = roastProgress();
+        var cx = width / 2, cy = height / 2;
+        var drumR = Math.min(width, height) * 0.42;
+
+        ctx.clearRect(0, 0, width, height);
+
+        // heat glow
+        var glow = ctx.createRadialGradient(cx, cy, drumR * 0.2, cx, cy, drumR * 1.3);
+        glow.addColorStop(0, 'rgba(255,' + Math.round(140 - p * 80) + ',40,' + (0.15 + p * 0.35) + ')');
+        glow.addColorStop(1, 'rgba(0,0,0,0)');
+        ctx.fillStyle = glow;
+        ctx.fillRect(0, 0, width, height);
+
+        // drum
+        ctx.strokeStyle = '#8d6e63';
+        ctx.lineWidth = 6;
+        ctx.beginPath();
+        ctx.arc(cx, cy, drumR, 0, Math.PI * 2);
+        ctx.stroke();
+
+        var color = beanColor(p);
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.angle += b.speed * dt;
+          b.rot += b.spin * dt;
+          drawBean(b, cx, cy, drumR - 10, color);
+        }
+
+        // smoke wisps as roast develops
+        if (p > 0.55) {
+          var t = now() / 1000;
+          ctx.strokeStyle = 'rgba(220,220,220,' + ((p - 0.55) * 0.6) + ')';
+          ctx.lineWidth = 2;
+          for (var s = 0; s < 3; s++) {
+            var sx = cx - 30 + s * 30;
+            ctx.beginPath();
+            ctx.moveTo(sx, cy - drumR);
+            for (var k = 1; k <= 6; k++) {
+              ctx.lineTo(sx + Math.sin(t * 2 + k + s) * 8, cy - drumR - k * 8);
+            }
+            ctx.stroke();
+          }
+        }
+      }
+
+      // ---- Animation loop ----
+      var rafId = null;
+      function frame(ts) {
+        rafId = null;
+        if (!running) return;
+        var t = typeof ts === 'number' ? ts : now();
+        var dt = lastFrame ? Math.min(0.1, (t - lastFrame) / 1000) : 0;
+        lastFrame = t;
+        render(dt);
+        rafId = raf(frame);
+      }
+
+      // ---- Temperature interval ----
+      var intervalId = null;
+      function tick() {
+        temp += 2 + Math.random() * 3;
+        if (temp >= MAX_TEMP) temp = MIN_TEMP; // drop the batch, start a new one
+        var fluct = (Math.random() - 0.5) * 1.5;
+        tempEl.textContent = (temp + fluct).toFixed(1) + '°F';
+        if (stageEl) stageEl.textContent = stageLabel(temp);
+      }
+
+      // ---- Start / stop ----
+      var running = false;
+      function start() {
+        if (running) return;
+        running = true;
+        lastFrame = 0;
+        tick();
+        intervalId = window.setInterval(tick, 500);
+        rafId = raf(frame);
+      }
+      function stop() {
+        if (!running) return;
+        running = false;
+        if (intervalId !== null) { window.clearInterval(intervalId); intervalId = null; }
+        if (rafId !== null) { caf(rafId); rafId = null; }
+      }
+
+      // ---- Visibility tracking ----
+      var inViewport = false;
+      var pageVisible = true;
+
+      function update() {
+        if (inViewport && pageVisible) start(); else stop();
+      }
+
+      // Page Visibility API (with vendor-prefixed fallbacks)
+      var hiddenProp = null, visEvent = null;
+      if (typeof document.hidden !== 'undefined') { hiddenProp = 'hidden'; visEvent = 'visibilitychange'; }
+      else if (typeof document.webkitHidden !== 'undefined') { hiddenProp = 'webkitHidden'; visEvent = 'webkitvisibilitychange'; }
+      else if (typeof document.mozHidden !== 'undefined') { hiddenProp = 'mozHidden'; visEvent = 'mozvisibilitychange'; }
+      else if (typeof document.msHidden !== 'undefined') { hiddenProp = 'msHidden'; visEvent = 'msvisibilitychange'; }
+
+      if (hiddenProp) {
+        pageVisible = !document[hiddenProp];
+        document.addEventListener(visEvent, function () {
+          pageVisible = !document[hiddenProp];
+          update();
+        }, false);
+      } else {
+        // Oldest browsers: approximate with window focus/blur + pagehide/pageshow
+        window.addEventListener('blur', function () { pageVisible = false; update(); }, false);
+        window.addEventListener('focus', function () { pageVisible = true; update(); }, false);
+      }
+      window.addEventListener('pagehide', function () { pageVisible = false; update(); }, false);
+      window.addEventListener('pageshow', function () {
+        pageVisible = hiddenProp ? !document[hiddenProp] : true;
+        update();
+      }, false);
+
+      // Viewport detection: IntersectionObserver, else throttled scroll/resize fallback
+      function checkViewportManually() {
+        var rect = widget.getBoundingClientRect();
+        var vh = window.innerHeight || document.documentElement.clientHeight;
+        var vw = window.innerWidth || document.documentElement.clientWidth;
+        inViewport = rect.bottom > 0 && rect.right > 0 && rect.top < vh && rect.left < vw;
+        update();
+      }
+
+      if ('IntersectionObserver' in window &&
+        'IntersectionObserverEntry' in window &&
+        'isIntersecting' in window.IntersectionObserverEntry.prototype) {
+        var io = new IntersectionObserver(function (entries) {
+          for (var i = 0; i < entries.length; i++) {
+            if (entries[i].target === widget) inViewport = entries[i].isIntersecting;
+          }
+          update();
+        }, { threshold: 0 });
+        io.observe(widget);
+      } else {
+        var pending = false;
+        var onScroll = function () {
+          if (pending) return;
+          pending = true;
+          window.setTimeout(function () { pending = false; checkViewportManually(); }, 150);
+        };
+        window.addEventListener('scroll', onScroll, false);
+        window.addEventListener('resize', onScroll, false);
+        window.addEventListener('orientationchange', onScroll, false);
+        window.addEventListener('load', checkViewportManually, false);
+        checkViewportManually();
+      }
+
+      // Keep canvas crisp on resize; redraw once if paused so it isn't stale/blank
+      var resizeTimer = null;
+      window.addEventListener('resize', function () {
+        window.clearTimeout(resizeTimer);
+        resizeTimer = window.setTimeout(function () {
+          resize();
+          if (!running) render(0);
+        }, 100);
+      }, false);
+
+      resize();
+      render(0);
+    })();
+  </script>
+
 </body>
 
 </html>
