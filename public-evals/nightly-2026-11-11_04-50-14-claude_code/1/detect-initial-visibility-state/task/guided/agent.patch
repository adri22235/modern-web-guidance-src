     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Detect whether this page was opened in a background tab during initial load.
+    (() => {
+      let result;
+
+      if ('VisibilityStateEntry' in window) {
+        // Preferred: the performance timeline records visibility history from
+        // navigation start, so it is accurate even if this script runs late.
+        const entries = performance.getEntriesByType('visibility-state');
+        const firstHidden = entries.find((entry) => entry.name === 'hidden');
+        result = {
+          backgrounded: entries.length > 0 && entries[0].name === 'hidden',
+          // ms since navigation start when the page was first hidden (null if never).
+          timestamp: firstHidden ? firstHidden.startTime : null,
+        };
+      } else {
+        // Fallback: only reflects the state at the moment this script executes.
+        const backgrounded = document.visibilityState === 'hidden';
+        result = {
+          backgrounded,
+          timestamp: backgrounded ? 0 : null,
+          note: 'VisibilityStateEntry is unsupported; fell back to document.visibilityState, ' +
+            'which is unreliable for async/deferred scripts — if the tab was foregrounded before ' +
+            'this script ran, an initial background load will be missed, and timestamps are approximate.',
+        };
+      }
+
+      console.log('[Daily Grind] Initial visibility:', result);
+    })();
+  </script>
+
 </body>
 
 </html>
