+  <section class="container feedback" aria-labelledby="feedback-heading">
+    <h2 id="feedback-heading">Send Us Feedback</h2>
+    <form id="feedback-form" class="feedback-form" action="/feedback" method="POST">
+      <label for="feedback-message">Your feedback</label>
+      <span id="feedback-hint" class="hint">Press Enter to send, Shift+Enter for a new line.</span>
+      <textarea id="feedback-message" name="message" required maxlength="2000" enterkeyhint="send"
+        aria-describedby="feedback-hint"></textarea>
+      <button type="submit" class="btn">Send feedback</button>
+      <p id="feedback-status" class="feedback-status" role="status"></p>
+    </form>
+  </section>
+
   <footer>
