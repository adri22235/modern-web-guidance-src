+  <script>
+    (function () {
+      const installBtn = document.getElementById('install-app');
+      let deferredPrompt = null;
+
+      const isInstalled = () =>
+        window.matchMedia('(display-mode: standalone)').matches ||
+        window.matchMedia('(display-mode: window-controls-overlay)').matches ||
+        navigator.standalone === true;
+
+      const show = () => { if (!isInstalled()) installBtn.hidden = false; };
+      const hide = () => { installBtn.hidden = true; };
+
+      // Web Install API: navigator.install() opens the browser's own install consent dialog.
+      if ('install' in navigator) show();
+
+      // Fallback for browsers that support the install prompt event instead.
+      window.addEventListener('beforeinstallprompt', (event) => {
+        event.preventDefault();
+        deferredPrompt = event;
+        show();
+      });
+
+      window.addEventListener('appinstalled', () => {
+        deferredPrompt = null;
+        hide();
+      });
+
+      installBtn.addEventListener('click', async () => {
+        installBtn.disabled = true;
+        try {
+          if ('install' in navigator) {
+            await navigator.install();
+            hide();
+          } else if (deferredPrompt) {
+            deferredPrompt.prompt();
+            const { outcome } = await deferredPrompt.userChoice;
+            deferredPrompt = null;
+            hide(); // a deferred prompt can only be used once
+            if (outcome === 'dismissed') console.info('Install dismissed by user.');
+          }
+        } catch (err) {
+          // AbortError = user declined the browser's consent dialog; keep the button available.
+          if (err && err.name !== 'AbortError') console.warn('App install failed:', err);
+        } finally {
+          installBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
