+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const grid = document.getElementById('favorites-grid');
+      const status = document.getElementById('favorites-status');
+      const filters = document.getElementById('favorites-filters');
+      const detailsBtn = document.getElementById('toggle-details');
+      const filtersBtn = document.getElementById('toggle-filters');
+      const copyBtn = document.getElementById('copy-favorites');
+      const viewBtns = [...bar.querySelectorAll('[data-view]')];
+      const cards = [...grid.querySelectorAll('.card')];
+
+      let lastMessage = '';
+      let statusTimer;
+      function announce(text) {
+        // VoiceOver skips identical consecutive messages; a trailing NBSP makes repeats distinct
+        let message = text;
+        if (message === lastMessage) message += '\u00A0';
+        lastMessage = message;
+        clearTimeout(statusTimer);
+        status.textContent = message;
+        statusTimer = setTimeout(() => { status.textContent = ''; }, 3000);
+      }
+
+      // Grid / list: mutually exclusive pressed buttons
+      viewBtns.forEach((btn) => btn.addEventListener('click', () => {
+        viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+        grid.dataset.view = btn.dataset.view;
+      }));
+
+      // Drink details on/off
+      detailsBtn.addEventListener('click', () => {
+        const on = detailsBtn.getAttribute('aria-pressed') !== 'true';
+        detailsBtn.setAttribute('aria-pressed', String(on));
+        grid.classList.toggle('hide-details', !on);
+      });
+
+      // Filters on/off; turning them off resets to all drinks
+      function applyFilter(value) {
+        let shown = 0;
+        cards.forEach((card) => {
+          card.hidden = value !== 'all' && card.dataset.temp !== value;
+          if (!card.hidden) shown++;
+        });
+        return shown;
+      }
+
+      filtersBtn.addEventListener('click', () => {
+        const on = filtersBtn.getAttribute('aria-expanded') !== 'true';
+        filtersBtn.setAttribute('aria-expanded', String(on));
+        filters.hidden = !on;
+        if (!on) {
+          filters.querySelector('input[value="all"]').checked = true;
+          applyFilter('all');
+        }
+      });
+
+      filters.addEventListener('change', (event) => {
+        const shown = applyFilter(event.target.value);
+        announce(`Showing ${shown} drink${shown === 1 ? '' : 's'}`);
+      });
+
+      // Copy featured drinks list
+      let copyTimer;
+      copyBtn.addEventListener('click', async () => {
+        const text = 'The Daily Grind — Seasonal Favorites\n' + cards.map((card) => {
+          const name = card.querySelector('h3').textContent.trim();
+          const desc = card.querySelector('p').textContent.trim();
+          return `• ${name}: ${desc}`;
+        }).join('\n');
+
+        clearTimeout(copyTimer);
+        copyBtn.removeAttribute('data-copied');
+        copyBtn.removeAttribute('data-failed');
+        let ok = true;
+        try {
+          await navigator.clipboard.writeText(text);
+        } catch {
+          ok = false;
+        }
+        copyBtn.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        announce(ok ? 'Featured drinks list copied' : 'Copy failed');
+        copyTimer = setTimeout(() => {
+          copyBtn.removeAttribute('data-copied');
+          copyBtn.removeAttribute('data-failed');
+        }, 2000);
+      });
+
+      // Roving tabindex fallback, only where native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        const items = [...bar.querySelectorAll('button')];
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener('keydown', (event) => {
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          const current = items.indexOf(document.activeElement);
+          if (current === -1) return;
+          let next;
+          if (event.key in steps) next = (current + steps[event.key] + items.length) % items.length;
+          else if (event.key === 'Home') next = 0;
+          else if (event.key === 'End') next = items.length - 1;
+          else return;
+          event.preventDefault();
+          items[next].focus();
+        });
+      }
+    })();
+  </script>
+
