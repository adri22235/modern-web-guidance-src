+  <script>
+    (function () {
+      var toolbar = document.getElementById('favorites-actions');
+      var list = document.getElementById('favorites-list');
+      var filters = document.getElementById('favorites-filters');
+      var status = document.getElementById('favorites-status');
+      if (!toolbar || !list) return;
+
+      var buttons = Array.prototype.slice.call(toolbar.querySelectorAll('button'));
+      var viewButtons = buttons.filter(function (b) { return b.dataset.action === 'view'; });
+
+      function announce(msg) {
+        status.textContent = '';
+        // Defer so repeated identical messages are still announced.
+        setTimeout(function () { status.textContent = msg; }, 50);
+      }
+
+      function setLabel(btn, label) {
+        btn.setAttribute('aria-label', label);
+        btn.setAttribute('data-tooltip', label);
+      }
+
+      function setView(view) {
+        list.classList.toggle('is-list', view === 'list');
+        viewButtons.forEach(function (b) {
+          b.setAttribute('aria-pressed', String(b.dataset.view === view));
+        });
+        announce(view === 'list' ? 'Showing list view' : 'Showing grid view');
+      }
+
+      function toggleDetails(btn) {
+        var show = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(show));
+        list.classList.toggle('hide-details', !show);
+        setLabel(btn, show ? 'Hide drink details' : 'Show drink details');
+        announce(show ? 'Drink details shown' : 'Drink details hidden');
+      }
+
+      function applyFilter(value) {
+        list.querySelectorAll('.card').forEach(function (card) {
+          card.hidden = value !== 'all' && card.dataset.temp !== value;
+        });
+      }
+
+      function toggleFilters(btn) {
+        var show = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(show));
+        filters.hidden = !show;
+        setLabel(btn, show ? 'Hide filters' : 'Show filters');
+        if (show) {
+          var checked = filters.querySelector('input:checked');
+          applyFilter(checked ? checked.value : 'all');
+        } else {
+          applyFilter('all'); // Turning filters off restores the full list.
+        }
+        announce(show ? 'Filters shown' : 'Filters hidden, showing all drinks');
+      }
+
+      function getDrinksText() {
+        var cards = list.querySelectorAll('.card:not([hidden])');
+        var lines = Array.prototype.map.call(cards, function (card) {
+          var name = card.querySelector('h3').textContent.trim();
+          var desc = card.querySelector('p');
+          return '- ' + name + (desc ? ': ' + desc.textContent.trim() : '');
+        });
+        return 'Seasonal Favorites at The Daily Grind\n' + lines.join('\n');
+      }
+
+      function fallbackCopy(text) {
+        var ta = document.createElement('textarea');
+        ta.value = text;
+        ta.setAttribute('readonly', '');
+        ta.style.position = 'fixed';
+        ta.style.opacity = '0';
+        document.body.appendChild(ta);
+        ta.select();
+        var ok = false;
+        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
+        document.body.removeChild(ta);
+        return ok ? Promise.resolve() : Promise.reject(new Error('Copy failed'));
+      }
+
+      var copyTimer;
+      function copyDrinks(btn) {
+        var text = getDrinksText();
+        var p = navigator.clipboard && window.isSecureContext
+          ? navigator.clipboard.writeText(text).catch(function () { return fallbackCopy(text); })
+          : fallbackCopy(text);
+
+        p.then(function () {
+          btn.classList.add('is-success');
+          btn.querySelector('.icon-copy').hidden = true;
+          btn.querySelector('.icon-check').hidden = false;
+          btn.setAttribute('data-tooltip', 'Copied!');
+          announce('Featured drinks list copied to clipboard');
+          clearTimeout(copyTimer);
+          copyTimer = setTimeout(function () {
+            btn.classList.remove('is-success');
+            btn.querySelector('.icon-copy').hidden = false;
+            btn.querySelector('.icon-check').hidden = true;
+            btn.setAttribute('data-tooltip', 'Copy featured drinks');
+          }, 2000);
+        }).catch(function () {
+          announce('Unable to copy the drinks list');
+        });
+      }
+
+      toolbar.addEventListener('click', function (e) {
+        var btn = e.target.closest('button');
+        if (!btn || !toolbar.contains(btn)) return;
+        focusButton(btn);
+        switch (btn.dataset.action) {
+          case 'view': setView(btn.dataset.view); break;
+          case 'details': toggleDetails(btn); break;
+          case 'filters': toggleFilters(btn); break;
+          case 'copy': copyDrinks(btn); break;
+        }
+      });
+
+      if (filters) {
+        filters.addEventListener('change', function (e) {
+          if (e.target.name === 'favorites-temp') {
+            applyFilter(e.target.value);
+            var n = list.querySelectorAll('.card:not([hidden])').length;
+            announce(n + (n === 1 ? ' drink' : ' drinks') + ' shown');
+          }
+        });
+      }
+
+      // Roving tabindex: the toolbar is a single tab stop; arrow keys move between buttons.
+      function focusButton(btn) {
+        buttons.forEach(function (b) { b.tabIndex = b === btn ? 0 : -1; });
+        btn.focus();
+      }
+
+      toolbar.addEventListener('keydown', function (e) {
+        var i = buttons.indexOf(document.activeElement);
+        if (i === -1) return;
+        var next = null;
+        switch (e.key) {
+          case 'ArrowRight': case 'ArrowDown': next = buttons[(i + 1) % buttons.length]; break;
+          case 'ArrowLeft': case 'ArrowUp': next = buttons[(i - 1 + buttons.length) % buttons.length]; break;
+          case 'Home': next = buttons[0]; break;
+          case 'End': next = buttons[buttons.length - 1]; break;
+        }
+        if (next) {
+          e.preventDefault();
+          focusButton(next);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
