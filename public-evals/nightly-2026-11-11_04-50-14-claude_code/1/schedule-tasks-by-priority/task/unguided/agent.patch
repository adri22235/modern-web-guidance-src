+  <script>
+    (() => {
+      // Priority levels: lower rank runs first.
+      const PRIORITIES = {
+        urgent:     { rank: 0, label: 'Urgent',     name: 'Checkout',       chunks: 20, chunkMs: 6 },
+        standard:   { rank: 1, label: 'Standard',   name: 'Menu update',    chunks: 40, chunkMs: 8 },
+        background: { rank: 2, label: 'Background', name: 'Telemetry log',  chunks: 60, chunkMs: 8 },
+      };
+      const MAX_LOG = 50;
+
+      const $ = (id) => document.getElementById(id);
+      const queueEl = $('ops-queue');
+      const logEl = $('ops-log');
+      const yieldToggle = $('ops-yield');
+
+      const queue = [];       // pending + preempted tasks
+      let current = null;     // task currently executing
+      let running = false;
+      let seq = 0;
+      let completed = 0;
+      let preemptions = 0;
+
+      // Yield control back to the browser so it can paint and handle input.
+      const yieldToMain = () => {
+        if (globalThis.scheduler && typeof scheduler.yield === 'function') return scheduler.yield();
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      };
+
+      // Simulate CPU-bound work for roughly `ms` milliseconds.
+      const busyWork = (ms) => {
+        const end = performance.now() + ms;
+        let x = 0;
+        while (performance.now() < end) x += Math.sqrt(Math.random());
+        return x;
+      };
+
+      const byPriority = (a, b) => (a.rank - b.rank) || (a.id - b.id);
+
+      function createTask(type) {
+        const p = PRIORITIES[type];
+        const id = ++seq;
+        return {
+          id, type, rank: p.rank, label: p.label,
+          name: `${p.name} #${id}`,
+          totalChunks: p.chunks, chunkMs: p.chunkMs,
+          doneChunks: 0, enqueuedAt: performance.now(), startedAt: null,
+        };
+      }
+
+      function enqueue(tasks) {
+        queue.push(...tasks);
+        queue.sort(byPriority);
+        render();
+        if (!running) run();
+      }
+
+      async function run() {
+        running = true;
+        while (queue.length) {
+          current = queue.shift();
+          if (current.startedAt === null) current.startedAt = performance.now();
+
+          while (current.doneChunks < current.totalChunks) {
+            busyWork(current.chunkMs);
+            current.doneChunks++;
+
+            if (yieldToggle.checked) {
+              renderProgress();
+              await yieldToMain();
+              // Preempt if a higher-priority task arrived while we were yielding.
+              if (current.doneChunks < current.totalChunks && queue.length && queue[0].rank < current.rank) {
+                preemptions++;
+                queue.push(current);
+                queue.sort(byPriority);
+                current = queue.shift();
+                if (current.startedAt === null) current.startedAt = performance.now();
+                render();
+              }
+            }
+          }
+
+          finish(current);
+          current = null;
+          render();
+          // Always give the browser a breather between tasks.
+          await yieldToMain();
+        }
+        running = false;
+        render();
+      }
+
+      function finish(task) {
+        completed++;
+        const now = performance.now();
+        const li = document.createElement('li');
+        li.className = 'ops-task';
+        li.innerHTML = `
+          <span class="ops-meta">#${completed}</span>
+          <span class="ops-badge ${task.type}">${task.label}</span>
+          <span></span>
+          <span class="ops-meta" title="Wait time / total turnaround"></span>`;
+        li.children[2].textContent = task.name;
+        li.children[3].textContent =
+          `wait ${Math.round(task.startedAt - task.enqueuedAt)}ms · total ${Math.round(now - task.enqueuedAt)}ms`;
+        logEl.prepend(li);
+        while (logEl.children.length > MAX_LOG) logEl.lastChild.remove();
+      }
+
+      function taskItem(task, isRunning) {
+        const li = document.createElement('li');
+        li.className = 'ops-task' + (isRunning ? ' running' : '');
+        li.dataset.id = task.id;
+        li.innerHTML = `
+          <span class="ops-badge ${task.type}">${task.label}</span>
+          <span></span>
+          <span class="ops-meta"></span>
+          <div class="ops-progress"><span></span></div>`;
+        li.children[1].textContent = task.name;
+        updateItem(li, task, isRunning);
+        return li;
+      }
+
+      function updateItem(li, task, isRunning) {
+        const pct = Math.round((task.doneChunks / task.totalChunks) * 100);
+        li.children[2].textContent = isRunning ? `running ${pct}%` : (task.doneChunks ? `paused ${pct}%` : 'queued');
+        li.querySelector('.ops-progress span').style.width = pct + '%';
+      }
+
+      function render() {
+        const frag = document.createDocumentFragment();
+        if (current) frag.appendChild(taskItem(current, true));
+        queue.forEach((t) => frag.appendChild(taskItem(t, false)));
+        queueEl.replaceChildren(frag);
+        $('ops-stat-queued').textContent = queue.length + (current ? 1 : 0);
+        $('ops-stat-done').textContent = completed;
+        $('ops-stat-preempt').textContent = preemptions;
+      }
+
+      function renderProgress() {
+        if (!current) return;
+        const li = queueEl.firstElementChild;
+        if (li && li.dataset.id === String(current.id)) updateItem(li, current, true);
+      }
+
+      // Individual task buttons
+      document.querySelectorAll('#ops-sim [data-task]').forEach((btn) => {
+        btn.addEventListener('click', () => enqueue([createTask(btn.dataset.task)]));
+      });
+
+      // Mixed batch: submitted in shuffled order, executed in priority order.
+      $('ops-batch').addEventListener('click', () => {
+        const types = ['background', 'standard', 'urgent', 'background', 'standard', 'urgent', 'background', 'standard'];
+        for (let i = types.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [types[i], types[j]] = [types[j], types[i]];
+        }
+        enqueue(types.map(createTask));
+      });
+
+      $('ops-clear').addEventListener('click', () => {
+        queue.length = 0;
+        logEl.replaceChildren();
+        completed = 0;
+        preemptions = 0;
+        maxGap = 0;
+        $('ops-stat-frame').textContent = '0 ms';
+        render();
+      });
+
+      // UI heartbeat: rAF-driven so it visibly freezes if the main thread is blocked.
+      const dot = $('ops-dot');
+      let lastFrame = performance.now();
+      let maxGap = 0;
+      let pos = 0;
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      function tick(now) {
+        const gap = now - lastFrame;
+        lastFrame = now;
+        if (running && gap > maxGap) {
+          maxGap = gap;
+          $('ops-stat-frame').textContent = Math.round(maxGap) + ' ms';
+        }
+        if (!reduceMotion) {
+          pos = (pos + gap * 0.1) % 104;
+          dot.style.transform = `translateX(${pos}px)`;
+        }
+        requestAnimationFrame(tick);
+      }
+      requestAnimationFrame(tick);
+
+      render();
+    })();
+  </script>
+
 </body>
 
