+  <script type="module">
+    // MANDATORY: feature-detect the Prioritized Task Scheduling API and load the
+    // polyfill only when missing, so supported browsers pay zero cost.
+    if (!('scheduler' in globalThis && 'postTask' in globalThis.scheduler)) {
+      try {
+        await import('https://cdn.jsdelivr.net/npm/scheduler-polyfill@1/+esm');
+      } catch (err) {
+        console.warn('scheduler-polyfill failed to load; using setTimeout fallback.', err);
+      }
+    }
+
+    const hasPostTask = 'scheduler' in globalThis && 'postTask' in globalThis.scheduler;
+    const hasYield = hasPostTask && 'yield' in globalThis.scheduler;
+    const hasController = typeof globalThis.TaskController === 'function';
+
+    const yieldToMain = () =>
+      hasYield ? scheduler.yield() : new Promise((resolve) => setTimeout(resolve, 0));
+
+    // Minimal setTimeout fallback (no cross-priority ordering) if the polyfill is unavailable.
+    const postTask = (callback, { priority, signal }) => {
+      if (hasPostTask) {
+        return scheduler.postTask(callback, signal ? { signal } : { priority });
+      }
+      return new Promise((resolve, reject) => {
+        setTimeout(() => {
+          if (signal?.aborted) return reject(signal.reason ?? new DOMException('Aborted', 'AbortError'));
+          Promise.resolve().then(callback).then(resolve, reject);
+        }, 0);
+      });
+    };
+
+    const TASKS = {
+      checkout: {
+        priority: 'user-blocking',
+        label: 'Checkout',
+        workMs: () => 150 + Math.random() * 150,
+        describe: (n) => `Order #${1000 + n} payment authorized`,
+      },
+      menu: {
+        priority: 'user-visible',
+        label: 'Menu',
+        workMs: () => 400 + Math.random() * 400,
+        describe: () => {
+          const items = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Chai Latte', 'Flat White'];
+          return `Menu price & stock refreshed: ${items[Math.floor(Math.random() * items.length)]}`;
+        },
+      },
+      telemetry: {
+        priority: 'background',
+        label: 'Telemetry',
+        workMs: () => 800 + Math.random() * 700,
+        describe: () => `${Math.floor(200 + Math.random() * 800)} telemetry events flushed`,
+      },
+    };
+
+    const els = {
+      active: document.getElementById('ops-active'),
+      log: document.getElementById('ops-log'),
+      frameGap: document.getElementById('ops-frame-gap'),
+      counts: {
+        'user-blocking': document.getElementById('ops-count-user-blocking'),
+        'user-visible': document.getElementById('ops-count-user-visible'),
+        background: document.getElementById('ops-count-background'),
+      },
+    };
+
+    const counts = { 'user-blocking': 0, 'user-visible': 0, background: 0 };
+    // One controller per priority lets "Cancel queued" abort pending work.
+    let controllers = {};
+    let seq = 0;
+    const startTime = performance.now();
+
+    function getSignal(priority) {
+      if (!hasController) return undefined;
+      if (!controllers[priority] || controllers[priority].signal.aborted) {
+        controllers[priority] = new TaskController({ priority });
+      }
+      return controllers[priority].signal;
+    }
+
+    function log(tag, cls, message) {
+      const li = document.createElement('li');
+      const time = ((performance.now() - startTime) / 1000).toFixed(2).padStart(7, ' ');
+      const tagEl = document.createElement('span');
+      tagEl.className = `tag ${cls}`;
+      tagEl.textContent = tag;
+      li.append(`[${time}s] `, tagEl, ' ', message);
+      els.log.append(li);
+      while (els.log.children.length > 200) els.log.firstElementChild.remove();
+      els.log.scrollTop = els.log.scrollHeight;
+    }
+
+    // Simulates CPU-bound work, yielding to the main thread every 50ms so
+    // input and rendering are never blocked. Continuations keep the task's priority.
+    async function simulateWork(totalMs, onProgress, signal) {
+      let done = 0;
+      let deadline = performance.now() + 50;
+      while (done < totalMs) {
+        const sliceStart = performance.now();
+        while (performance.now() - sliceStart < 5) { /* busy work */ }
+        done += performance.now() - sliceStart;
+        if (performance.now() >= deadline) {
+          onProgress(Math.min(done / totalMs, 1));
+          await yieldToMain();
+          if (signal?.aborted) throw signal.reason ?? new DOMException('Aborted', 'AbortError');
+          deadline = performance.now() + 50;
+        }
+      }
+      onProgress(1);
+    }
+
+    function enqueue(kind) {
+      const def = TASKS[kind];
+      const id = ++seq;
+      const { priority } = def;
+      const signal = getSignal(priority);
+
+      const row = document.createElement('li');
+      const name = document.createElement('span');
+      name.textContent = `${def.label} #${id} — queued`;
+      const bar = document.createElement('progress');
+      bar.max = 1;
+      bar.value = 0;
+      bar.setAttribute('aria-label', `${def.label} task ${id} progress`);
+      row.append(name, bar);
+      els.active.append(row);
+
+      postTask(async () => {
+        name.textContent = `${def.label} #${id} — running`;
+        log(def.label, priority, `#${id} started`);
+        const t0 = performance.now();
+        await simulateWork(def.workMs(), (p) => { bar.value = p; }, signal);
+        counts[priority]++;
+        els.counts[priority].textContent = counts[priority];
+        log(def.label, priority, `#${id} done in ${Math.round(performance.now() - t0)} ms — ${def.describe(id)}`);
+      }, { priority, signal })
+        .catch((err) => {
+          if (err?.name === 'AbortError') log(def.label, priority, `#${id} cancelled`);
+          else { log(def.label, priority, `#${id} failed: ${err?.message ?? err}`); console.error(err); }
+        })
+        .finally(() => row.remove());
+    }
+
+    document.querySelectorAll('.ops-controls [data-task]').forEach((btn) => {
+      btn.addEventListener('click', () => enqueue(btn.dataset.task));
+    });
+
+    // Enqueue tasks deliberately out of order; the scheduler runs them by priority.
+    document.getElementById('ops-batch').addEventListener('click', () => {
+      const batch = ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'telemetry', 'checkout', 'menu', 'checkout'];
+      log('Batch', 'system', `Queued ${batch.length} mixed tasks in order: ${batch.join(', ')}`);
+      batch.forEach(enqueue);
+    });
+
+    document.getElementById('ops-cancel').addEventListener('click', () => {
+      if (!hasController) {
+        log('System', 'system', 'Cancellation requires TaskController support in this browser.');
+        return;
+      }
+      Object.values(controllers).forEach((c) => c.abort());
+      controllers = {};
+      log('System', 'system', 'Cancelled all pending tasks.');
+    });
+
+    // Responsiveness monitor: tracks the longest gap between animation frames.
+    let lastFrame = performance.now();
+    let maxGap = 0;
+    let resetAt = lastFrame + 5000;
+    function heartbeat(now) {
+      const gap = now - lastFrame;
+      lastFrame = now;
+      if (now > resetAt) { maxGap = 0; resetAt = now + 5000; }
+      if (gap > maxGap) {
+        maxGap = gap;
+        els.frameGap.textContent = `${Math.round(maxGap)} ms`;
+      }
+      requestAnimationFrame(heartbeat);
+    }
+    requestAnimationFrame(heartbeat);
+
+    log('System', 'system', hasPostTask
+      ? 'Scheduler ready (scheduler.postTask with priority queues).'
+      : 'Scheduler API unavailable — falling back to setTimeout (no priority ordering).');
+  </script>
+
 </body>
 
