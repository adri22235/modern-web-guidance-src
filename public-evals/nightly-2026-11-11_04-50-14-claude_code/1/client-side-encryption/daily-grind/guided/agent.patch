+  <script type="module">
+    // ---- Encrypted delivery notes ----------------------------------------
+    // Recipient = the store. Its key pair is non-extractable and persisted in
+    // IndexedDB (in production the store would generate it on its own device
+    // and publish only the public key). The customer (sender) encapsulates a
+    // fresh one-time key per note and seals it with an AEAD cipher.
+
+    const PROTOCOL = 'daily-grind-delivery-note-v1';
+    const HKDF_INFO = new TextEncoder().encode(PROTOCOL);
+    const SUITE_PQ = 'MLKEM768-X25519+HKDF-SHA256+ChaCha20-Poly1305';
+    const SUITE_CLASSIC = 'X25519+HKDF-SHA256+AES-GCM';
+    const ENVELOPE_KEY = 'dg-delivery-note-envelope';
+
+    const $ = (id) => document.getElementById(id);
+    const form = $('note-form');
+    const noteText = $('note-text');
+    const encryptBtn = $('encrypt-btn');
+    const decryptBtn = $('decrypt-btn');
+    const tamperBtn = $('tamper-btn');
+    const statusEl = $('note-status');
+    const envelopeEl = $('note-envelope');
+    const suiteEl = $('note-suite');
+
+    // -- base64 helpers (native Uint8Array base64 with fallback) --
+    const toB64 = (bytes) =>
+      typeof bytes.toBase64 === 'function'
+        ? bytes.toBase64()
+        : btoa(Array.from(bytes, (b) => String.fromCharCode(b)).join(''));
+    const fromB64 = (str) =>
+      typeof Uint8Array.fromBase64 === 'function'
+        ? Uint8Array.fromBase64(str)
+        : Uint8Array.from(atob(str), (c) => c.charCodeAt(0));
+
+    function setStatus(msg, tone = '') {
+      statusEl.textContent = msg;
+      statusEl.dataset.tone = tone;
+    }
+
+    // -- Feature detection (static method on the constructor) --
+    function supportsPostQuantum() {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'HKDF') &&
+        SubtleCrypto.supports('importKey', 'ChaCha20-Poly1305')
+      );
+    }
+
+    // -- IndexedDB persistence of the store's CryptoKeyPair --
+    function openDb() {
+      return new Promise((resolve, reject) => {
+        const req = indexedDB.open('daily-grind-crypto', 1);
+        req.onupgradeneeded = () => req.result.createObjectStore('keys');
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+    }
+    async function idb(mode, fn) {
+      const db = await openDb();
+      try {
+        return await new Promise((resolve, reject) => {
+          const tx = db.transaction('keys', mode);
+          const req = fn(tx.objectStore('keys'));
+          tx.oncomplete = () => resolve(req.result);
+          tx.onerror = () => reject(tx.error);
+        });
+      } finally {
+        db.close();
+      }
+    }
+
+    async function getStoreKeys() {
+      const suite = supportsPostQuantum() ? SUITE_PQ : SUITE_CLASSIC;
+      const id = `store-key:${suite}`;
+      let keyPair = await idb('readonly', (s) => s.get(id)).catch(() => undefined);
+      if (!keyPair) {
+        keyPair =
+          suite === SUITE_PQ
+            ? await crypto.subtle.generateKey('MLKEM768-X25519', false, ['encapsulateKey', 'decapsulateKey'])
+            : await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+        await idb('readwrite', (s) => s.put(keyPair, id)).catch(() => {
+          /* Persistence unavailable (e.g. private mode): key lives for this session only. */
+        });
+      }
+      const publicKeyBytes = new Uint8Array(
+        await crypto.subtle.exportKey(suite === SUITE_PQ ? 'raw-public' : 'raw', keyPair.publicKey),
+      );
+      return { suite, keyPair, publicKeyBytes };
+    }
+
+    // -- Key derivation: shared secret -> HKDF (domain separated) -> AEAD key --
+    async function aeadKeyFromHkdf(hkdfKey, salt, suite) {
+      if (suite === SUITE_PQ) {
+        const bits = await crypto.subtle.deriveBits(
+          { name: 'HKDF', hash: 'SHA-256', salt, info: HKDF_INFO }, hkdfKey, 256);
+        return crypto.subtle.importKey('raw-secret', bits, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt']);
+      }
+      return crypto.subtle.deriveKey(
+        { name: 'HKDF', hash: 'SHA-256', salt, info: HKDF_INFO },
+        hkdfKey, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+    }
+
+    async function x25519Hkdf(privateKey, publicKey) {
+      const secret = await crypto.subtle.deriveBits({ name: 'X25519', public: publicKey }, privateKey, 256);
+      return crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveBits', 'deriveKey']);
+    }
+
+    // Sender side: encapsulate to the store's public key bytes.
+    async function encapsulate(suite, recipientPublicKeyBytes, salt) {
+      if (suite === SUITE_PQ) {
+        const pub = await crypto.subtle.importKey(
+          'raw-public', recipientPublicKeyBytes, 'MLKEM768-X25519', true, ['encapsulateKey']);
+        const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+          'MLKEM768-X25519', pub, 'HKDF', false, ['deriveBits']);
+        return { key: await aeadKeyFromHkdf(sharedKey, salt, suite), capsule: new Uint8Array(ciphertext) };
+      }
+      // Classical fallback: ephemeral-static X25519; ephemeral public key is the capsule.
+      const pub = await crypto.subtle.importKey('raw', recipientPublicKeyBytes, 'X25519', true, []);
+      const eph = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const capsule = new Uint8Array(await crypto.subtle.exportKey('raw', eph.publicKey));
+      const hkdf = await x25519Hkdf(eph.privateKey, pub);
+      return { key: await aeadKeyFromHkdf(hkdf, salt, suite), capsule };
+    }
+
+    // Recipient side: recover the AEAD key from the capsule.
+    async function decapsulate(suite, privateKey, capsule, salt) {
+      if (suite === SUITE_PQ) {
+        const hkdf = await crypto.subtle.decapsulateKey(
+          'MLKEM768-X25519', privateKey, capsule, 'HKDF', false, ['deriveBits']);
+        return aeadKeyFromHkdf(hkdf, salt, suite);
+      }
+      const ephPub = await crypto.subtle.importKey('raw', capsule, 'X25519', true, []);
+      return aeadKeyFromHkdf(await x25519Hkdf(privateKey, ephPub), salt, suite);
+    }
+
+    // Unencrypted metadata bound into the authentication tag.
+    const aadFor = (env) =>
+      new TextEncoder().encode(JSON.stringify({ v: PROTOCOL, suite: env.suite, orderId: env.orderId }));
+
+    async function sealNote(store, plaintext) {
+      const orderId = `DG-${toB64(crypto.getRandomValues(new Uint8Array(6))).replace(/[+/=]/g, '').toUpperCase()}`;
+      const salt = crypto.getRandomValues(new Uint8Array(32));
+      const iv = crypto.getRandomValues(new Uint8Array(12)); // fresh per message, never reused
+      const { key, capsule } = await encapsulate(store.suite, store.publicKeyBytes, salt);
+      const env = { v: PROTOCOL, suite: store.suite, orderId };
+      const ct = await crypto.subtle.encrypt(
+        { name: key.algorithm.name, iv, additionalData: aadFor(env) },
+        key, new TextEncoder().encode(plaintext));
+      return { ...env, salt: toB64(salt), capsule: toB64(capsule), iv: toB64(iv), ciphertext: toB64(new Uint8Array(ct)) };
+    }
+
+    async function openNote(store, env) {
+      if (env.v !== PROTOCOL || env.suite !== store.suite) throw new Error('Unsupported envelope suite.');
+      const key = await decapsulate(store.suite, store.keyPair.privateKey, fromB64(env.capsule), fromB64(env.salt));
+      const pt = await crypto.subtle.decrypt(
+        { name: key.algorithm.name, iv: fromB64(env.iv), additionalData: aadFor(env) },
+        key, fromB64(env.ciphertext));
+      return new TextDecoder().decode(pt);
+    }
+
+    // -- UI wiring --
+    let store;
+    let envelope;
+
+    function showEnvelope() {
+      const short = (b64) => (b64.length > 64 ? `${b64.slice(0, 64)}… (${fromB64(b64).length} bytes)` : b64);
+      envelopeEl.textContent = JSON.stringify(
+        { ...envelope, capsule: short(envelope.capsule), ciphertext: short(envelope.ciphertext) }, null, 2);
+      envelopeEl.hidden = false;
+      decryptBtn.disabled = tamperBtn.disabled = false;
+    }
+
+    async function init() {
+      if (!globalThis.crypto?.subtle) {
+        suiteEl.textContent = 'Encryption unavailable';
+        setStatus('Secure notes require a modern browser over HTTPS.', 'error');
+        return;
+      }
+      try {
+        store = await getStoreKeys();
+        suiteEl.textContent = store.suite === SUITE_PQ
+          ? 'Post-quantum hybrid: ML-KEM-768 + X25519 · ChaCha20-Poly1305'
+          : 'Classical: X25519 key agreement · AES-256-GCM';
+        encryptBtn.disabled = false;
+        const saved = sessionStorage.getItem(ENVELOPE_KEY);
+        if (saved) {
+          envelope = JSON.parse(saved);
+          if (envelope.suite === store.suite) showEnvelope();
+        }
+      } catch (err) {
+        console.error(err);
+        suiteEl.textContent = 'Encryption unavailable';
+        setStatus('This browser does not support X25519 or post-quantum key encapsulation.', 'error');
+      }
+    }
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const text = noteText.value.trim();
+      if (!text) return;
+      encryptBtn.disabled = true;
+      try {
+        envelope = await sealNote(store, text);
+        sessionStorage.setItem(ENVELOPE_KEY, JSON.stringify(envelope)); // ciphertext only
+        noteText.value = '';
+        showEnvelope();
+        setStatus(`Note sealed for order ${envelope.orderId}. Only the store can read it.`, 'ok');
+      } catch (err) {
+        console.error(err);
+        setStatus('Could not encrypt your note. Please try again.', 'error');
+      } finally {
+        encryptBtn.disabled = false;
+      }
+    });
+
+    decryptBtn.addEventListener('click', async () => {
+      try {
+        const text = await openNote(store, envelope);
+        setStatus(`Store view (${envelope.orderId}): “${text}”`, 'ok');
+      } catch (err) {
+        setStatus(err.name === 'OperationError'
+          ? 'Authentication failed: the note was modified in transit and was rejected.'
+          : `Could not open note: ${err.message}`, 'error');
+      }
+    });
+
+    tamperBtn.addEventListener('click', () => {
+      const ct = fromB64(envelope.ciphertext);
+      ct[0] ^= 0x01; // flip one bit
+      envelope = { ...envelope, ciphertext: toB64(ct) };
+      sessionStorage.setItem(ENVELOPE_KEY, JSON.stringify(envelope));
+      showEnvelope();
+      setStatus('One bit of the ciphertext was flipped. Try “Open as store” to see it rejected.');
+    });
+
+    init();
+  </script>
+
