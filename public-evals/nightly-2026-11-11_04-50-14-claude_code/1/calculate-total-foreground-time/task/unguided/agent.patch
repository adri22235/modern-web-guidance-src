+  <script>
+    /**
+     * Foreground time tracking.
+     *
+     * Accumulates the time the page is actually visible to the user
+     * (tab active, window not minimized), using the Page Visibility API.
+     * Time spent in a background tab, minimized, or frozen in the
+     * back/forward cache is excluded.
+     */
+    (function () {
+      let accumulatedMs = 0;
+      // Timestamp (performance.now()) when the current visible period began, or null if hidden.
+      let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+      function startVisiblePeriod() {
+        if (visibleSince === null) visibleSince = performance.now();
+      }
+
+      function endVisiblePeriod() {
+        if (visibleSince !== null) {
+          accumulatedMs += performance.now() - visibleSince;
+          visibleSince = null;
+        }
+      }
+
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'visible') startVisiblePeriod();
+        else endVisiblePeriod();
+      });
+
+      // Handle back/forward cache: the page can be frozen and restored
+      // without a visibilitychange in some browsers.
+      window.addEventListener('pagehide', endVisiblePeriod);
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted && document.visibilityState === 'visible') startVisiblePeriod();
+      });
+
+      /**
+       * Returns the total time (in milliseconds) the page has been in the
+       * foreground since it was loaded, including the current visible period.
+       */
+      function getTotalForegroundTime() {
+        const current = visibleSince !== null ? performance.now() - visibleSince : 0;
+        return Math.round(accumulatedMs + current);
+      }
+
+      window.getTotalForegroundTime = getTotalForegroundTime;
+    })();
+  </script>
+
