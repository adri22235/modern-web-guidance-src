diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -152,8 +152,84 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
   </style>
+
+  <script>
+    /**
+     * Foreground-time tracking.
+     *
+     * Primary: the Performance Timeline's `visibility-state` entries
+     * (VisibilityStateEntry), which record every visibility change with
+     * browser-precise timestamps, regardless of when this script runs.
+     *
+     * Fallback (browsers without VisibilityStateEntry, e.g. Firefox/Safari):
+     * accumulate visible time ourselves via `visibilitychange`. This is
+     * registered early in <head> to minimize the window where an initial
+     * background state could be missed.
+     */
+    (() => {
+      const supportsVisibilityEntries =
+        'VisibilityStateEntry' in window &&
+        PerformanceObserver.supportedEntryTypes?.includes('visibility-state');
+
+      // --- Fallback accumulator (only used when the API is unsupported) ---
+      let fallbackTotal = 0;
+      // If visible now, assume visible since navigation start (time 0).
+      let fallbackVisibleSince =
+        document.visibilityState === 'visible' ? 0 : null;
+
+      if (!supportsVisibilityEntries) {
+        document.addEventListener('visibilitychange', () => {
+          const now = performance.now();
+          if (document.visibilityState === 'hidden') {
+            if (fallbackVisibleSince !== null) {
+              fallbackTotal += now - fallbackVisibleSince;
+              fallbackVisibleSince = null;
+            }
+          } else if (fallbackVisibleSince === null) {
+            fallbackVisibleSince = now;
+          }
+        });
+      }
+
+      /**
+       * Calculates the total time the page has been in the foreground
+       * (visibilityState === 'visible'), excluding background-tab time.
+       *
+       * @returns {number} Total foreground time in milliseconds.
+       */
+      function getTotalForegroundTime() {
+        const now = performance.now();
+
+        if (supportsVisibilityEntries) {
+          const entries = performance.getEntriesByType('visibility-state');
+          if (entries.length > 0) {
+            let total = 0;
+            for (let i = 0; i < entries.length; i++) {
+              if (entries[i].name !== 'visible') continue;
+              const start = entries[i].startTime;
+              // A visible period ends at the next state change, or now.
+              const end =
+                i + 1 < entries.length ? entries[i + 1].startTime : now;
+              total += end - start;
+            }
+            return total;
+          }
+          // Supported but no entries yet: treat as time since navigation.
+          return now;
+        }
+
+        // Fallback: accumulated visible time plus the current visible stretch.
+        return (
+          fallbackTotal +
+          (fallbackVisibleSince !== null ? now - fallbackVisibleSince : 0)
+        );
+      }
+
+      window.getTotalForegroundTime = getTotalForegroundTime;
+    })();
+  </script>
