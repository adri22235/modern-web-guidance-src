+  <script>
+    (function () {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const result = document.getElementById('detect-result');
+
+      const displayNames = typeof Intl.DisplayNames === 'function'
+        ? new Intl.DisplayNames(['en'], { type: 'language' })
+        : null;
+
+      function languageName(code) {
+        try {
+          return (displayNames && displayNames.of(code)) || code;
+        } catch (e) {
+          return code;
+        }
+      }
+
+      // Distinctive scripts map (almost) directly to a language.
+      const SCRIPTS = [
+        { code: 'ja', re: /[぀-ヿ]/g },          // Hiragana / Katakana
+        { code: 'ko', re: /[가-힯ᄀ-ᇿ]/g },
+        { code: 'zh', re: /[一-鿿]/g },
+        { code: 'ar', re: /[؀-ۿ]/g },
+        { code: 'he', re: /[֐-׿]/g },
+        { code: 'el', re: /[Ͱ-Ͽ]/g },
+        { code: 'th', re: /[฀-๿]/g },
+        { code: 'hi', re: /[ऀ-ॿ]/g },
+        { code: 'bn', re: /[ঀ-৿]/g },
+        { code: 'ta', re: /[஀-௿]/g },
+        { code: 'ka', re: /[Ⴀ-ჿ]/g },
+        { code: 'hy', re: /[԰-֏]/g },
+        { code: 'cyrl', re: /[Ѐ-ӿ]/g }
+      ];
+
+      // Common function words for languages sharing a script.
+      const STOPWORDS = {
+        en: 'the and is it to of was in that for you with this my have but not are very good great coffee they we be at on',
+        es: 'el la de que y en los las un una es por para con no muy pero mi lo se del al está fue gracias',
+        fr: 'le la les de des et est un une que qui pas pour dans avec je très mais ce mon sur au du était merci',
+        de: 'der die das und ist nicht ein eine ich zu mit sehr aber den dem es war für auf auch sie wir danke',
+        it: 'il la di che e è un una non per con sono molto ma mi lo gli del della era grazie anche questo',
+        pt: 'o a de que e é um uma não para com muito mas meu os as do da foi em obrigado obrigada você',
+        nl: 'de het een en is van niet ik dat met zijn op voor maar heel was ook wij bedankt dit',
+        sv: 'och är det en att jag inte med på för som var mycket men har vi tack av',
+        da: 'og er det en at jeg ikke med på for som var meget men har vi tak af',
+        no: 'og er det en at jeg ikke med på for som var veldig men har vi takk av',
+        pl: 'i w nie jest to się na że z do bardzo ale jak było dziękuję mi',
+        cs: 'a je to se na že v ne s do jsem velmi ale jak bylo děkuji',
+        tr: 've bir bu çok ama için ile de da değil ben güzel teşekkürler kahve',
+        id: 'dan yang di ini itu tidak saya sangat untuk dengan ada enak terima kasih',
+        ro: 'și este nu un o de la cu în foarte dar mi pentru mulțumesc',
+        fi: 'ja on ei se että oli hyvä mutta kiitos minä tämä kahvi',
+        hu: 'és a az nem egy hogy van nagyon de is köszönöm volt',
+        vi: 'và là của không có rất được tôi này cà phê cảm ơn',
+        ru: 'и в не на я что это с как но очень было по мне спасибо кофе',
+        uk: 'і в не на я що це з як але дуже було по мені дякую кава',
+        bg: 'и в не на аз че това с как но много беше за благодаря'
+      };
+      const STOPWORD_SETS = Object.fromEntries(
+        Object.entries(STOPWORDS).map(([k, v]) => [k, new Set(v.split(' '))])
+      );
+      const CYRILLIC_LANGS = ['ru', 'uk', 'bg'];
+
+      function heuristicDetect(text) {
+        const letters = (text.match(/\p{L}/gu) || []).length;
+        if (!letters) return null;
+
+        // Non-Latin script detection
+        let best = null;
+        for (const s of SCRIPTS) {
+          const n = (text.match(s.re) || []).length;
+          if (n && (!best || n > best.n)) best = { code: s.code, n };
+        }
+        // Japanese text contains Han characters too; any kana means Japanese.
+        if (best && best.code === 'zh' && /[぀-ヿ]/.test(text)) best.code = 'ja';
+
+        const words = text.toLowerCase().match(/\p{L}+/gu) || [];
+        const scoreWords = (langs) => {
+          let top = null;
+          for (const lang of langs) {
+            const set = STOPWORD_SETS[lang];
+            const hits = words.filter((w) => set.has(w)).length;
+            if (hits && (!top || hits > top.hits)) top = { lang, hits };
+          }
+          return top;
+        };
+
+        if (best && best.n / letters > 0.3) {
+          if (best.code === 'cyrl') {
+            if (/[їєґі]/i.test(text)) return { lang: 'uk', confidence: 0.8 };
+            const top = scoreWords(CYRILLIC_LANGS);
+            return { lang: top ? top.lang : 'ru', confidence: top ? 0.7 : 0.5 };
+          }
+          return { lang: best.code, confidence: Math.min(0.95, best.n / letters) };
+        }
+
+        const latin = Object.keys(STOPWORDS).filter((l) => !CYRILLIC_LANGS.includes(l));
+        const top = scoreWords(latin);
+        if (!top) return null;
+        return { lang: top.lang, confidence: Math.min(0.9, top.hits / Math.max(words.length, 1) + 0.3) };
+      }
+
+      let detectorPromise = null;
+      async function getBuiltInDetector() {
+        if (!('LanguageDetector' in self)) return null;
+        if (!detectorPromise) {
+          detectorPromise = (async () => {
+            const availability = await LanguageDetector.availability();
+            if (availability === 'unavailable') return null;
+            return LanguageDetector.create();
+          })().catch(() => null);
+        }
+        return detectorPromise;
+      }
+
+      async function detectLanguage(text) {
+        const detector = await getBuiltInDetector();
+        if (detector) {
+          try {
+            const [top] = await detector.detect(text);
+            if (top && top.detectedLanguage !== 'und') {
+              return { lang: top.detectedLanguage, confidence: top.confidence };
+            }
+          } catch (e) {
+            // fall through to heuristic
+          }
+        }
+        return heuristicDetect(text);
+      }
+
+      function show(message, isError) {
+        result.textContent = message;
+        result.classList.toggle('error', !!isError);
+        result.hidden = false;
+      }
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const text = textarea.value.trim();
+        if (!text) {
+          show('Please enter a message first.', true);
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        button.textContent = 'Detecting...';
+        try {
+          const detected = await detectLanguage(text);
+          if (!detected) {
+            show("Sorry, we couldn't identify the language of this message.", true);
+          } else {
+            const pct = Math.round(detected.confidence * 100);
+            show(`Detected language: ${languageName(detected.lang)} (${detected.lang}) — ${pct}% confidence`);
+          }
+        } catch (e) {
+          show('Something went wrong while detecting the language. Please try again.', true);
+        } finally {
+          button.disabled = false;
+          button.textContent = 'Detect';
+        }
+      });
+    })();
+  </script>
+
