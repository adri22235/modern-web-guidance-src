+
+  <script type="module">
+    const form = document.getElementById('feedback-form');
+    const textarea = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-btn');
+    const result = document.getElementById('detect-result');
+
+    const displayNames = new Intl.DisplayNames([navigator.language, 'en'], { type: 'language' });
+    const languageName = (code) => {
+      try { return displayNames.of(code) ?? code; } catch { return code; }
+    };
+
+    const unsupported = (msg) => {
+      button.disabled = true;
+      result.textContent = msg;
+    };
+
+    let detectorPromise;
+
+    if (!('LanguageDetector' in self)) {
+      unsupported('Language detection is not supported in this browser.');
+    } else {
+      LanguageDetector.availability().then((availability) => {
+        if (availability === 'unavailable') {
+          unsupported('Language detection is currently unavailable on this device.');
+        }
+      }).catch(() => unsupported('Language detection is currently unavailable.'));
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const text = textarea.value.trim();
+        if (!text) return;
+
+        button.disabled = true;
+        try {
+          // create() must run from a user gesture so the model can download if needed.
+          detectorPromise ??= LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                result.textContent = `Downloading language model… ${Math.round(e.loaded * 100)}%`;
+              });
+            },
+          });
+          result.textContent = 'Detecting…';
+          const detector = await detectorPromise;
+          const [top] = await detector.detect(text);
+
+          if (!top || top.detectedLanguage === 'und') {
+            result.textContent = "Sorry, we couldn't identify the language.";
+            return;
+          }
+
+          const pct = Math.round(top.confidence * 100);
+          result.replaceChildren(
+            'Detected language: ',
+            Object.assign(document.createElement('strong'), {
+              textContent: languageName(top.detectedLanguage),
+            }),
+            ` (${pct}% confidence)` +
+              (text.split(/\s+/).length < 4 ? ' — longer messages give more accurate results.' : ''),
+          );
+          textarea.lang = top.detectedLanguage;
+        } catch (err) {
+          detectorPromise = undefined;
+          result.textContent = `Language detection failed: ${err.message}`;
+        } finally {
+          button.disabled = false;
+        }
+      });
+    }
+  </script>
 </body>
 
