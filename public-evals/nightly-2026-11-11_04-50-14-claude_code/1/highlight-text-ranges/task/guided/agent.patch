+  <script>
+    (() => {
+      const input = document.getElementById('search-input');
+      const grid = document.getElementById('seasonal-grid');
+      const supportsHighlights = typeof CSS !== 'undefined' && 'highlights' in CSS && typeof Highlight === 'function';
+
+      const getTextNodes = () => {
+        const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: (n) => n.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT
+        });
+        const nodes = [];
+        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+        return nodes;
+      };
+
+      // Card text is static, so collect the text nodes once (Highlight API path).
+      const textNodes = supportsHighlights ? getTextNodes() : null;
+
+      const findMatches = (text, term) => {
+        const hay = text.toLowerCase();
+        const offsets = [];
+        let pos = hay.indexOf(term);
+        while (pos !== -1) {
+          offsets.push(pos);
+          pos = hay.indexOf(term, pos + term.length);
+        }
+        return offsets;
+      };
+
+      const clearMarks = () => {
+        grid.querySelectorAll('mark.search-hit').forEach((mark) => {
+          const parent = mark.parentNode;
+          mark.replaceWith(document.createTextNode(mark.textContent));
+          parent.normalize();
+        });
+      };
+
+      const highlight = () => {
+        const term = input.value.trim().toLowerCase();
+
+        if (supportsHighlights) {
+          CSS.highlights.delete('menu-search');
+          if (!term) return;
+          const ranges = [];
+          for (const node of textNodes) {
+            for (const start of findMatches(node.nodeValue, term)) {
+              const range = new Range();
+              range.setStart(node, start);
+              range.setEnd(node, start + term.length);
+              ranges.push(range);
+            }
+          }
+          if (ranges.length) CSS.highlights.set('menu-search', new Highlight(...ranges));
+          return;
+        }
+
+        // Fallback: wrap matches in <mark> elements.
+        clearMarks();
+        if (!term) return;
+        for (const node of getTextNodes()) {
+          const text = node.nodeValue;
+          const offsets = findMatches(text, term);
+          if (!offsets.length) continue;
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          for (const start of offsets) {
+            frag.append(text.slice(last, start));
+            const mark = document.createElement('mark');
+            mark.className = 'search-hit';
+            mark.textContent = text.slice(start, start + term.length);
+            frag.append(mark);
+            last = start + term.length;
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      };
+
+      input.addEventListener('input', highlight);
+    })();
+  </script>
+
