+  <script>
+    (function () {
+      var input = document.getElementById('search-input');
+      var grid = document.getElementById('menu-grid');
+      if (!input || !grid) return;
+
+      // Remove all existing highlights, restoring the original text nodes.
+      function clearHighlights() {
+        var marks = grid.querySelectorAll('mark.search-highlight');
+        var parents = new Set();
+        marks.forEach(function (mark) {
+          var parent = mark.parentNode;
+          parent.replaceChild(document.createTextNode(mark.textContent), mark);
+          parents.add(parent);
+        });
+        // Merge adjacent text nodes so future searches can match across former boundaries.
+        parents.forEach(function (p) { p.normalize(); });
+      }
+
+      function highlight(term) {
+        clearHighlights();
+        if (!term) return;
+        var needle = term.toLowerCase();
+
+        // Collect text nodes first so DOM mutations don't disturb the walk.
+        var walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT, {
+          acceptNode: function (node) {
+            return node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+          }
+        });
+        var nodes = [];
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+
+        nodes.forEach(function (node) {
+          var text = node.nodeValue;
+          var lower = text.toLowerCase();
+          var idx = lower.indexOf(needle);
+          if (idx === -1) return;
+
+          // Build fragment with text nodes only (never innerHTML) to avoid injection.
+          var frag = document.createDocumentFragment();
+          var last = 0;
+          while (idx !== -1) {
+            if (idx > last) frag.appendChild(document.createTextNode(text.slice(last, idx)));
+            var mark = document.createElement('mark');
+            mark.className = 'search-highlight';
+            mark.textContent = text.slice(idx, idx + needle.length);
+            frag.appendChild(mark);
+            last = idx + needle.length;
+            idx = lower.indexOf(needle, last);
+          }
+          if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
+          node.parentNode.replaceChild(frag, node);
+        });
+      }
+
+      input.addEventListener('input', function () {
+        highlight(input.value.trim());
+      });
+    })();
+  </script>
+
