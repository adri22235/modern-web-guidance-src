+  <script>
+    // Native <select> only supports Up/Down; add Left/Right for the side-by-side grid picker.
+    const roastPicker = document.getElementById('roast');
+    if (CSS.supports('appearance', 'base-select')) {
+      roastPicker.addEventListener('keydown', (event) => {
+        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
+        const current = document.activeElement;
+        if (!(current instanceof HTMLOptionElement) || current.parentElement !== roastPicker) return;
+        const forward = (event.key === 'ArrowRight') === (getComputedStyle(roastPicker).direction !== 'rtl');
+        const next = forward ? current.nextElementSibling : current.previousElementSibling;
+        if (next instanceof HTMLOptionElement) {
+          event.preventDefault();
+          next.focus();
+        }
+      });
+    }
+  </script>
