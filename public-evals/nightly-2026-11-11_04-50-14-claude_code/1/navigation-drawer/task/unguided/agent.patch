+  <script>
+    (function () {
+      const body = document.body;
+      const toggle = document.getElementById('menu-toggle');
+      const drawer = document.getElementById('nav-drawer');
+      const backdrop = document.getElementById('drawer-backdrop');
+      const closeBtn = document.getElementById('drawer-close');
+
+      const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
+      let lastFocused = null;
+
+      function isOpen() {
+        return body.classList.contains('drawer-open');
+      }
+
+      function openDrawer() {
+        if (isOpen()) return;
+        lastFocused = document.activeElement;
+        drawer.removeAttribute('inert');
+        body.classList.add('drawer-open');
+        toggle.setAttribute('aria-expanded', 'true');
+        // Focus the first link once the drawer becomes visible
+        requestAnimationFrame(function () {
+          const first = drawer.querySelector('ul ' + FOCUSABLE) || closeBtn;
+          first.focus({ preventScroll: true });
+        });
+      }
+
+      function closeDrawer() {
+        if (!isOpen()) return;
+        body.classList.remove('drawer-open');
+        drawer.setAttribute('inert', '');
+        toggle.setAttribute('aria-expanded', 'false');
+        drawer.style.transform = '';
+        backdrop.style.opacity = '';
+        const target = lastFocused && document.contains(lastFocused) ? lastFocused : toggle;
+        target.focus({ preventScroll: true });
+      }
+
+      toggle.addEventListener('click', function () {
+        isOpen() ? closeDrawer() : openDrawer();
+      });
+      closeBtn.addEventListener('click', closeDrawer);
+
+      // Tap/click outside the drawer
+      backdrop.addEventListener('click', closeDrawer);
+
+      // Escape closes; Tab stays trapped inside the open drawer
+      document.addEventListener('keydown', function (e) {
+        if (!isOpen()) return;
+        if (e.key === 'Escape' || e.key === 'Esc') {
+          e.preventDefault();
+          closeDrawer();
+        } else if (e.key === 'Tab') {
+          const items = Array.prototype.slice.call(drawer.querySelectorAll(FOCUSABLE));
+          if (!items.length) return;
+          const first = items[0];
+          const last = items[items.length - 1];
+          if (e.shiftKey && (document.activeElement === first || !drawer.contains(document.activeElement))) {
+            e.preventDefault();
+            last.focus();
+          } else if (!e.shiftKey && (document.activeElement === last || !drawer.contains(document.activeElement))) {
+            e.preventDefault();
+            first.focus();
+          }
+        }
+      });
+
+      // Swipe right to dismiss (drawer slides in from the right edge)
+      const DRAG_START = 10;        // px of horizontal movement before we treat it as a swipe
+      const CLOSE_RATIO = 0.35;     // fraction of drawer width that closes on release
+      const FLICK_VELOCITY = 0.5;   // px/ms — fast flicks close regardless of distance
+
+      let pointerId = null;
+      let startX = 0, startY = 0, lastX = 0, lastT = 0, velocity = 0;
+      let dragging = false;
+      let suppressClick = false;
+
+      function resetDrag() {
+        pointerId = null;
+        dragging = false;
+        drawer.classList.remove('dragging');
+        backdrop.classList.remove('dragging');
+      }
+
+      drawer.addEventListener('pointerdown', function (e) {
+        if (!isOpen() || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        pointerId = e.pointerId;
+        startX = lastX = e.clientX;
+        startY = e.clientY;
+        lastT = e.timeStamp;
+        velocity = 0;
+        dragging = false;
+        suppressClick = false;
+      });
+
+      drawer.addEventListener('pointermove', function (e) {
+        if (e.pointerId !== pointerId) return;
+        const dx = e.clientX - startX;
+        const dy = e.clientY - startY;
+
+        if (!dragging) {
+          if (Math.abs(dx) < DRAG_START || Math.abs(dx) <= Math.abs(dy)) {
+            // Mostly vertical: give up so normal scrolling works
+            if (Math.abs(dy) > DRAG_START && Math.abs(dy) > Math.abs(dx)) resetDrag();
+            return;
+          }
+          dragging = true;
+          drawer.classList.add('dragging');
+          backdrop.classList.add('dragging');
+          try { drawer.setPointerCapture(e.pointerId); } catch (_) {}
+        }
+
+        const dt = e.timeStamp - lastT;
+        if (dt > 0) velocity = (e.clientX - lastX) / dt;
+        lastX = e.clientX;
+        lastT = e.timeStamp;
+
+        const offset = Math.max(0, dx); // only allow dragging toward the closed position
+        const width = drawer.offsetWidth;
+        drawer.style.transform = 'translateX(' + offset + 'px)';
+        backdrop.style.opacity = String(Math.max(0, 1 - offset / width));
+        e.preventDefault();
+      });
+
+      function endDrag(e) {
+        if (e.pointerId !== pointerId) return;
+        const wasDragging = dragging;
+        const offset = Math.max(0, lastX - startX);
+        const width = drawer.offsetWidth;
+        resetDrag();
+        if (!wasDragging) return;
+
+        suppressClick = true; // don't follow a link the swipe started on
+        const shouldClose = e.type !== 'pointercancel' &&
+          (offset > width * CLOSE_RATIO || velocity > FLICK_VELOCITY);
+
+        // Clear inline styles so CSS transitions animate to the final state
+        drawer.style.transform = '';
+        backdrop.style.opacity = '';
+        if (shouldClose) closeDrawer();
+      }
+
+      drawer.addEventListener('pointerup', endDrag);
+      drawer.addEventListener('pointercancel', endDrag);
+
+      drawer.addEventListener('click', function (e) {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+          suppressClick = false;
+        }
+      }, true);
+
+      // Close when a navigation link is chosen
+      drawer.querySelectorAll('ul a').forEach(function (link) {
+        link.addEventListener('click', function () { closeDrawer(); });
+      });
+    })();
+  </script>
+
