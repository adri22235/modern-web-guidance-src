+  <script>
+    (function () {
+      const trigger = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+      const GAP = 4;      // space between trigger and panel
+      const MARGIN = 8;   // minimum distance from viewport edges
+      const supportsPopover = typeof panel.showPopover === 'function';
+
+      // Without the Popover API, ensure the panel is a direct child of <body>
+      // so no ancestor overflow can clip it; z-index in CSS keeps it on top.
+      if (!supportsPopover && panel.parentElement !== document.body) {
+        document.body.appendChild(panel);
+      }
+
+      const isOpen = () =>
+        supportsPopover ? panel.matches(':popover-open') : panel.classList.contains('is-open');
+
+      function position() {
+        const t = trigger.getBoundingClientRect();
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+        const pw = panel.offsetWidth;
+        const ph = panel.offsetHeight;
+
+        // Vertical: prefer below; flip above if it would overflow and above has more room.
+        let top = t.bottom + GAP;
+        let placement = 'bottom';
+        if (top + ph > vh - MARGIN) {
+          const above = t.top - GAP - ph;
+          const spaceBelow = vh - MARGIN - (t.bottom + GAP);
+          const spaceAbove = t.top - GAP - MARGIN;
+          if (above >= MARGIN || spaceAbove > spaceBelow) {
+            top = above;
+            placement = 'top';
+          }
+        }
+
+        // Horizontal: prefer aligning to trigger's left edge; flip to right-edge alignment on overflow.
+        let left = t.left;
+        let align = 'start';
+        if (left + pw > vw - MARGIN) {
+          const flipped = t.right - pw;
+          if (flipped >= MARGIN || t.right > vw - t.left) {
+            left = flipped;
+            align = 'end';
+          }
+        }
+
+        // Final clamp so the panel is never cut off, even in tiny viewports.
+        left = Math.min(Math.max(left, MARGIN), Math.max(MARGIN, vw - pw - MARGIN));
+        top = Math.min(Math.max(top, MARGIN), Math.max(MARGIN, vh - ph - MARGIN));
+
+        panel.style.left = Math.round(left) + 'px';
+        panel.style.top = Math.round(top) + 'px';
+        panel.dataset.placement = placement + '-' + align;
+      }
+
+      let rafId = 0;
+      function schedulePosition() {
+        if (rafId) return;
+        rafId = requestAnimationFrame(() => {
+          rafId = 0;
+          if (isOpen()) position();
+        });
+      }
+
+      function open() {
+        if (isOpen()) return;
+        if (supportsPopover) panel.showPopover();
+        else panel.classList.add('is-open');
+        trigger.setAttribute('aria-expanded', 'true');
+        position();
+        window.addEventListener('scroll', schedulePosition, true);
+        window.addEventListener('resize', schedulePosition);
+        const first = panel.querySelector('[role="menuitem"]');
+        if (first) first.focus({ preventScroll: true });
+      }
+
+      function close(returnFocus) {
+        if (!isOpen()) return;
+        if (supportsPopover) panel.hidePopover();
+        else panel.classList.remove('is-open');
+        trigger.setAttribute('aria-expanded', 'false');
+        window.removeEventListener('scroll', schedulePosition, true);
+        window.removeEventListener('resize', schedulePosition);
+        if (returnFocus) trigger.focus();
+      }
+
+      trigger.addEventListener('click', () => (isOpen() ? close(false) : open()));
+
+      trigger.addEventListener('keydown', (e) => {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          open();
+        }
+      });
+
+      // Light dismiss: click outside the trigger and panel.
+      document.addEventListener('pointerdown', (e) => {
+        if (isOpen() && !panel.contains(e.target) && !trigger.contains(e.target)) close(false);
+      });
+
+      // Keyboard navigation within the menu.
+      panel.addEventListener('keydown', (e) => {
+        const items = Array.from(panel.querySelectorAll('[role="menuitem"]'));
+        const i = items.indexOf(document.activeElement);
+        switch (e.key) {
+          case 'Escape':
+            e.preventDefault();
+            close(true);
+            break;
+          case 'ArrowDown':
+            e.preventDefault();
+            items[(i + 1) % items.length].focus();
+            break;
+          case 'ArrowUp':
+            e.preventDefault();
+            items[(i - 1 + items.length) % items.length].focus();
+            break;
+          case 'Home':
+            e.preventDefault();
+            items[0].focus();
+            break;
+          case 'End':
+            e.preventDefault();
+            items[items.length - 1].focus();
+            break;
+          case 'Tab':
+            close(false);
+            break;
+        }
+      });
+
+      panel.addEventListener('click', (e) => {
+        const item = e.target.closest('[role="menuitem"]');
+        if (!item) return;
+        close(true);
+        if (item.dataset.href) window.location.href = item.dataset.href;
+      });
+
+      // Keep position correct if the panel's own size changes while open.
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(schedulePosition).observe(panel);
+      }
+    })();
+  </script>
+
