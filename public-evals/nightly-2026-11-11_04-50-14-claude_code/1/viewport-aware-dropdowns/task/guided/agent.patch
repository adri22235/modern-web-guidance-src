+
+    /* Options dropdown */
+    .options-trigger {
+      /* Explicit anchor: the anchor-positioning polyfill ignores implicit popovertarget anchors */
+      anchor-name: --options-trigger;
+      background: none;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      border: 1px solid transparent;
+      border-radius: 4px;
+      padding: 5px 12px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger::after {
+      content: " \25BE";
+    }
+
+    .options-trigger:hover,
+    .options-trigger:focus-visible,
+    .options-trigger:has(+ :is(:popover-open, .\:popover-open)) {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    #action-panel {
+      /* Rendered in the top layer via popover, so no ancestor overflow/z-index can clip it */
+      position-anchor: --options-trigger;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 6px 0 0;
+      /* Flip above and/or right-align when the default spot would overflow the viewport */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    #action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      display: block;
+      width: 100%;
+      text-align: start;
+      background: none;
+      border: 0;
+      border-radius: 5px;
+      padding: 8px 12px;
+      font: inherit;
+      font-size: 0.9rem;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background: var(--secondary);
+      color: var(--primary);
+    }
   </style>
