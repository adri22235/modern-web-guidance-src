+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = [...panel.querySelectorAll('.drink-section > header')];
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    const setActive = (id) => {
+      for (const link of links) {
+        const isActive = link.hash === `#${id}`;
+        if (isActive) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      }
+    };
+
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      // Fires once the panel settles on a new snap target (an article header)
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const article = event.snapTargetBlock?.closest('.drink-section');
+        if (article) setActive(article.id);
+      });
+    } else {
+      // Fallback: track the top-most visible header in the panel
+      const observer = new IntersectionObserver(() => {
+        const panelTop = panel.getBoundingClientRect().top;
+        const top = headers.reduce((current, header) => {
+          const { bottom } = header.getBoundingClientRect();
+          if (bottom < panelTop) return current;
+          if (!current) return header;
+          return bottom < current.getBoundingClientRect().bottom ? header : current;
+        }, undefined);
+        if (top) setActive(top.closest('.drink-section').id);
+      }, { root: panel, threshold: [0, 0.9, 1] });
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    // Smoothly scroll only the panel (not the page) to the chosen section
+    for (const link of links) {
+      link.addEventListener('click', (event) => {
+        const article = document.getElementById(link.hash.slice(1));
+        if (!article) return;
+        event.preventDefault();
+        const header = article.querySelector('header');
+        const offset = header.getBoundingClientRect().top - panel.getBoundingClientRect().top;
+        const margin = parseFloat(getComputedStyle(header).scrollMarginTop) || 0;
+        panel.scrollTo({
+          top: panel.scrollTop + offset - margin,
+          behavior: reduceMotion.matches ? 'auto' : 'smooth',
+        });
+        // Move focus to the section for keyboard/screen reader users
+        article.focus({ preventScroll: true });
+        history.replaceState(null, '', link.hash);
+      });
+    }
+
+    // Honor an initial #fragment pointing at a drink
+    const initialEl = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
+    const initial = initialEl?.matches('.seasonal-panel .drink-section') ? initialEl : null;
+    if (initial) {
+      panel.scrollTop += initial.getBoundingClientRect().top - panel.getBoundingClientRect().top;
+      setActive(initial.id);
+    }
+  </script>
+
