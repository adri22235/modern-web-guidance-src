+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var toc = document.querySelector('.toc-sidebar');
+      if (!panel || !toc) return;
+
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a.toc-link[href^="#"]'));
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var pendingTarget = null;
+
+      function headerOf(section) {
+        return section.querySelector('.drink-header') || section;
+      }
+
+      // Offset of a section's header relative to the panel's scroll origin,
+      // honouring the header's scroll-margin-top so it matches the snap point.
+      function snapOffset(section) {
+        var header = headerOf(section);
+        var margin = parseFloat(getComputedStyle(header).scrollMarginTop) || 0;
+        return header.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop - margin;
+      }
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          var active = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('is-active', active);
+          if (active) link.setAttribute('aria-current', 'true');
+          else link.removeAttribute('aria-current');
+        });
+        sections.forEach(function (section) {
+          section.classList.toggle('is-current', section.id === id);
+        });
+      }
+
+      // Pick the section whose snap point is closest to the current scroll position.
+      function currentSection() {
+        var top = panel.scrollTop;
+        if (top + panel.clientHeight >= panel.scrollHeight - 2) return sections[sections.length - 1];
+        var best = sections[0], bestDist = Infinity;
+        sections.forEach(function (section) {
+          var dist = Math.abs(snapOffset(section) - top);
+          if (dist < bestDist) { bestDist = dist; best = section; }
+        });
+        return best;
+      }
+
+      function onSettle() {
+        var section = pendingTarget || currentSection();
+        pendingTarget = null;
+        if (section) setActive(section.id);
+      }
+
+      // Update only once scrolling has settled (after snapping completes).
+      if ('onscrollend' in window) {
+        panel.addEventListener('scrollend', onSettle);
+      } else {
+        var timer;
+        panel.addEventListener('scroll', function () {
+          clearTimeout(timer);
+          timer = setTimeout(onSettle, 150);
+        }, { passive: true });
+      }
+
+      function goTo(section, smooth) {
+        var top = Math.max(0, Math.min(snapOffset(section), panel.scrollHeight - panel.clientHeight));
+        pendingTarget = section;
+        if (Math.abs(top - panel.scrollTop) < 1) {
+          onSettle();
+        } else {
+          panel.scrollTo({ top: top, behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto' });
+        }
+        // Move focus for keyboard / screen reader users without a second jump.
+        try { section.focus({ preventScroll: true }); } catch (e) { section.focus(); }
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (event) {
+          var id = decodeURIComponent(link.getAttribute('href').slice(1));
+          var section = document.getElementById(id);
+          if (!section || !panel.contains(section)) return;
+          event.preventDefault();
+          if (history.replaceState) history.replaceState(null, '', '#' + id);
+          setActive(id);
+          goTo(section, true);
+        });
+      });
+
+      // Honour a deep link like index.html#cold-brew on load.
+      var initial = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
+      if (initial && panel.contains(initial)) {
+        goTo(initial, false);
+      } else if (sections[0]) {
+        setActive(sections[0].id);
+      }
+    })();
+  </script>
