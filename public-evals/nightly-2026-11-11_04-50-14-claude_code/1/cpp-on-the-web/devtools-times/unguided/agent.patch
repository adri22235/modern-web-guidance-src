@@ -0,0 +1,32 @@
+// Web Worker hosting one instance of the smallpt WebAssembly module.
+// The main thread hands out image rows one at a time; each finished row is
+// posted back as RGBA8 pixels so the canvas can be filled in progressively.
+importScripts('smallpt.js');
+
+let modulePromise = createSmallpt();
+let M = null;
+let job = null; // { w, h, rgbaPtr }
+
+self.onmessage = async (e) => {
+  const msg = e.data;
+  if (!M) M = await modulePromise;
+
+  if (msg.type === 'init') {
+    const { w, h, spp, seed, colors } = msg;
+    M._reset_sphere_colors();
+    if (colors) {
+      for (const [i, [r, g, b]] of Object.entries(colors)) M._set_sphere_color(+i, r, g, b);
+    }
+    const rgbaPtr = M._render_begin(w, h, spp, seed >>> 0);
+    job = { w, h, rgbaPtr };
+    self.postMessage({ type: 'ready' });
+  } else if (msg.type === 'row' && job) {
+    const { w, h, rgbaPtr } = job;
+    const y = msg.y; // smallpt row index (bottom-up)
+    M._render_rows(y, y + 1);
+    const imageRow = h - y - 1; // canvas row index (top-down)
+    const start = rgbaPtr + imageRow * w * 4;
+    const pixels = M.HEAPU8.slice(start, start + w * 4); // copy (heap may grow)
+    self.postMessage({ type: 'row', row: imageRow, pixels }, [pixels.buffer]);
+  }
+};
diff --git a/src/components/SmallptRenderer.astro b/src/components/SmallptRenderer.astro
new file mode 100644
index 0000000..5d1b903
--- /dev/null
+++ b/src/components/SmallptRenderer.astro
@@ -0,0 +1,190 @@
+---
+const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+const workerUrl = `${base}smallpt/worker.js`;
+---
+
+<section class="p-4 md:p-6" data-smallpt-root data-worker-url={workerUrl}>
+  <div class="flex flex-col md:flex-row gap-6 items-start">
+    <div class="w-full md:w-3/5">
+      <div class="relative bg-black aspect-[4/3] w-full overflow-hidden">
+        <canvas data-smallpt-canvas width="480" height="360" class="w-full h-full block [image-rendering:auto]"></canvas>
+      </div>
+      <div class="mt-2 h-1 bg-gray-200">
+        <div data-smallpt-progress class="h-1 bg-amber-400 transition-[width] duration-150" style="width:0%"></div>
+      </div>
+    </div>
+    <div class="w-full md:w-2/5">
+      <p class="text-xs uppercase tracking-wider text-amber-500 font-semibold">Technology</p>
+      <h2 class="text-2xl font-bold text-gray-900 mt-1">A path tracer, running in your browser</h2>
+      <p class="text-gray-700 mt-2 text-sm leading-relaxed">
+        This image was rendered on your device by
+        <a class="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a>,
+        Kevin Beason's 99-line C++ global-illumination renderer, compiled to WebAssembly and spread across
+        your CPU cores with Web Workers.
+      </p>
+      <div class="mt-4 flex flex-wrap items-center gap-3">
+        <button
+          type="button"
+          data-smallpt-randomize
+          class="bg-gray-900 text-white text-sm font-semibold px-4 py-2 hover:bg-amber-400 hover:text-gray-900 transition-colors disabled:opacity-50"
+        >
+          Randomize colors &amp; render
+        </button>
+        <label class="text-sm text-gray-700 flex items-center gap-2">
+          Samples/pixel
+          <select data-smallpt-spp class="border border-gray-300 px-2 py-1 text-sm bg-white">
+            <option value="16">16</option>
+            <option value="64" selected>64</option>
+            <option value="256">256</option>
+            <option value="1024">1024</option>
+          </select>
+        </label>
+      </div>
+      <div data-smallpt-swatches class="mt-4 flex flex-wrap gap-2"></div>
+      <p data-smallpt-status class="mt-3 text-xs text-gray-500 font-mono">Loading WebAssembly…</p>
+    </div>
+  </div>
+</section>
+
+<script>
+  // Sphere indices in smallpt's scene.
+  const SPHERES = [
+    { i: 0, name: 'Left wall' },
+    { i: 1, name: 'Right wall' },
+    { i: 2, name: 'Back wall' },
+    { i: 4, name: 'Floor' },
+    { i: 5, name: 'Ceiling' },
+    { i: 6, name: 'Mirror ball', tint: true },
+    { i: 7, name: 'Glass ball', tint: true },
+  ];
+  const DEFAULT_COLORS: Record<number, [number, number, number]> = {
+    0: [0.75, 0.25, 0.25],
+    1: [0.25, 0.25, 0.75],
+    2: [0.75, 0.75, 0.75],
+    4: [0.75, 0.75, 0.75],
+    5: [0.75, 0.75, 0.75],
+    6: [0.999, 0.999, 0.999],
+    7: [0.999, 0.999, 0.999],
+  };
+
+  function hslToRgb(h: number, s: number, l: number): [number, number, number] {
+    const k = (n: number) => (n + h * 12) % 12;
+    const a = s * Math.min(l, 1 - l);
+    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+    return [f(0), f(8), f(4)];
+  }
+
+  function randomColors() {
+    const colors: Record<number, [number, number, number]> = {};
+    for (const s of SPHERES) {
+      const h = Math.random();
+      colors[s.i] = s.tint
+        ? // Mirror/glass: light tints keep them reflective rather than murky.
+          hslToRgb(h, 0.4 + Math.random() * 0.5, 0.7 + Math.random() * 0.15).map((v) => Math.min(v, 0.999)) as [number, number, number]
+        : hslToRgb(h, 0.35 + Math.random() * 0.55, 0.3 + Math.random() * 0.35);
+    }
+    return colors;
+  }
+
+  const toCss = ([r, g, b]: number[]) =>
+    `rgb(${[r, g, b].map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join(',')})`;
+
+  function setup(root: HTMLElement) {
+    if (root.dataset.smallptInit) return;
+    root.dataset.smallptInit = '1';
+
+    const workerUrl = root.dataset.workerUrl!;
+    const canvas = root.querySelector<HTMLCanvasElement>('[data-smallpt-canvas]')!;
+    const ctx = canvas.getContext('2d')!;
+    const button = root.querySelector<HTMLButtonElement>('[data-smallpt-randomize]')!;
+    const sppSelect = root.querySelector<HTMLSelectElement>('[data-smallpt-spp]')!;
+    const status = root.querySelector<HTMLElement>('[data-smallpt-status]')!;
+    const progress = root.querySelector<HTMLElement>('[data-smallpt-progress]')!;
+    const swatches = root.querySelector<HTMLElement>('[data-smallpt-swatches]')!;
+
+    let workers: Worker[] = [];
+    let currentColors = DEFAULT_COLORS;
+
+    const stop = () => {
+      workers.forEach((w) => w.terminate());
+      workers = [];
+    };
+
+    function renderSwatches(colors: Record<number, number[]>) {
+      swatches.replaceChildren(
+        ...SPHERES.map((s) => {
+          const el = document.createElement('span');
+          el.className = 'inline-flex items-center gap-1 text-xs text-gray-600';
+          const dot = document.createElement('span');
+          dot.className = 'inline-block w-3 h-3 rounded-full border border-gray-300';
+          dot.style.background = toCss(colors[s.i]);
+          el.append(dot, s.name);
+          return el;
+        }),
+      );
+    }
+
+    function render(colors: Record<number, [number, number, number]>) {
+      stop();
+      currentColors = colors;
+      renderSwatches(colors);
+
+      const w = canvas.width;
+      const h = canvas.height;
+      const spp = Number(sppSelect.value);
+      const seed = (Math.random() * 0xffffffff) >>> 0;
+      const threads = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 16));
+
+      ctx.fillStyle = '#000';
+      ctx.fillRect(0, 0, w, h);
+      progress.style.width = '0%';
+      status.textContent = `Rendering ${w}×${h} @ ${spp} spp on ${threads} worker${threads > 1 ? 's' : ''}…`;
+
+      // Hand out rows top-down (smallpt's y is bottom-up) for a nice progressive reveal.
+      let nextRow = 0;
+      let done = 0;
+      const start = performance.now();
+      const pool = Array.from({ length: threads }, () => new Worker(workerUrl));
+      workers = pool;
+
+      const dispatch = (worker: Worker) => {
+        if (nextRow < h) worker.postMessage({ type: 'row', y: h - 1 - nextRow++ });
+      };
+
+      for (const worker of pool) {
+        worker.onmessage = (e) => {
+          if (workers !== pool) return; // stale job
+          const msg = e.data;
+          if (msg.type === 'ready') {
+            dispatch(worker);
+          } else if (msg.type === 'row') {
+            ctx.putImageData(new ImageData(new Uint8ClampedArray(msg.pixels.buffer), w, 1), 0, msg.row);
+            done++;
+            progress.style.width = `${(100 * done) / h}%`;
+            if (done === h) {
+              const secs = ((performance.now() - start) / 1000).toFixed(2);
+              status.textContent = `Rendered ${w}×${h} @ ${spp} spp in ${secs}s on ${threads} worker${threads > 1 ? 's' : ''}.`;
+              stop();
+            } else {
+              dispatch(worker);
+            }
+          }
+        };
+        worker.onerror = (err) => {
+          status.textContent = `Render failed: ${err.message || 'worker error'}`;
+          stop();
+        };
+        worker.postMessage({ type: 'init', w, h, spp, seed, colors });
+      }
+    }
+
+    button.addEventListener('click', () => render(randomColors()));
+    sppSelect.addEventListener('change', () => render(currentColors));
+    document.addEventListener('astro:before-swap', stop, { once: true });
+
+    render(DEFAULT_COLORS);
+  }
+
+  const init = () => document.querySelectorAll<HTMLElement>('[data-smallpt-root]').forEach(setup);
+  document.addEventListener('astro:page-load', init);
+</script>
