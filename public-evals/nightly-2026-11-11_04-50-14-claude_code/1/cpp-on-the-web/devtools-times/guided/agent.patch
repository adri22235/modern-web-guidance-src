diff --git a/scripts/build-wasm.sh b/scripts/build-wasm.sh
new file mode 100755
index 0000000..3306511
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# Compiles wasm/smallpt.cpp to an ES6 WebAssembly module in src/wasm/.
+# The generated files are committed, so environments without Emscripten can
+# still run `astro build`; this script then just skips compilation.
+set -e
+cd "$(dirname "$0")/.."
+OUT=src/wasm
+if ! command -v em++ >/dev/null 2>&1; then
+  if [ -f "$OUT/smallpt.js" ] && [ -f "$OUT/smallpt.wasm" ]; then
+    echo "build-wasm: em++ not found, using prebuilt $OUT/smallpt.{js,wasm}"
+    exit 0
+  fi
+  echo "build-wasm: em++ (Emscripten) is required to build smallpt" >&2
+  exit 1
+fi
+mkdir -p build/wasm "$OUT"
+em++ -c wasm/smallpt.cpp -o build/wasm/smallpt.o -O3 -flto -fno-exceptions -Wall -Werror
+em++ build/wasm/smallpt.o -o "$OUT/smallpt.js" \
+  -O3 -flto -fno-exceptions \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  --no-entry \
+  -sEXPORTED_FUNCTIONS=_begin_render,_render_row,_set_sphere_color,_sphere_count \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
+echo "build-wasm: wrote $OUT/smallpt.js and $OUT/smallpt.wasm"
diff --git a/src/components/SmallptRender.astro b/src/components/SmallptRender.astro
new file mode 100644
index 0000000..56b0b7b
--- /dev/null
+++ b/src/components/SmallptRender.astro
@@ -0,0 +1,210 @@
+---
+// Renders Kevin Beason's smallpt path tracer (compiled to WebAssembly) in the
+// browser and lets the reader re-render it with random sphere colors.
+const WIDTH = 400;
+const HEIGHT = 300;
+const SAMPLES = 16; // per 2x2 subpixel => 64 samples per pixel
+---
+<section class="p-4 md:p-6">
+  <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+    Rendered In Your Browser
+  </h2>
+  <smallpt-render
+    class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start"
+    data-width={WIDTH}
+    data-height={HEIGHT}
+    data-samples={SAMPLES}
+  >
+    <figure class="m-0">
+      <canvas
+        width={WIDTH}
+        height={HEIGHT}
+        class="w-full h-auto bg-gray-900 shadow-sm"
+        style={`aspect-ratio: ${WIDTH} / ${HEIGHT}`}
+        role="img"
+        aria-label="Path-traced Cornell box scene with a mirror sphere and a glass sphere"
+      ></canvas>
+      <progress class="block w-full h-1 mt-2 accent-amber-400" max="1" value="0"></progress>
+      <figcaption class="text-xs text-gray-500 mt-2" aria-live="polite" data-status>
+        Loading the WebAssembly path tracer…
+      </figcaption>
+    </figure>
+    <div class="flex flex-col gap-4">
+      <span class="text-amber-400 font-semibold text-sm">Technology</span>
+      <h3 class="text-2xl font-bold text-gray-900">
+        A 99-line path tracer, now running client-side
+      </h3>
+      <p class="text-gray-700">
+        This image is computed on your device by
+        <a class="underline hover:text-amber-400" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+        Kevin Beason's open-source global illumination renderer, compiled from C++ to
+        WebAssembly with Emscripten. Rows are traced in parallel across Web Workers at
+        {SAMPLES * 4} samples per pixel, so the page stays responsive while it renders.
+      </p>
+      <ul class="flex flex-wrap gap-2" data-swatches aria-label="Current sphere colors"></ul>
+      <div>
+        <button
+          type="button"
+          class="bg-gray-900 text-white font-semibold px-4 py-2 hover:bg-amber-400 hover:text-gray-900 disabled:opacity-50 disabled:cursor-progress"
+          data-rerender
+        >
+          Render again with random colors
+        </button>
+      </div>
+    </div>
+  </smallpt-render>
+</section>
+
+<script>
+  import type { RGB, WorkerRequest, WorkerResponse } from '../wasm/smallpt.worker';
+
+  // Sphere order matches the scene in wasm/smallpt.cpp.
+  const SPHERES: { name: string; color: RGB; randomize: 'diffuse' | 'tint' | false }[] = [
+    { name: 'Left wall', color: [0.75, 0.25, 0.25], randomize: 'diffuse' },
+    { name: 'Right wall', color: [0.25, 0.25, 0.75], randomize: 'diffuse' },
+    { name: 'Back wall', color: [0.75, 0.75, 0.75], randomize: 'diffuse' },
+    { name: 'Front wall', color: [0, 0, 0], randomize: false },
+    { name: 'Floor', color: [0.75, 0.75, 0.75], randomize: 'diffuse' },
+    { name: 'Ceiling', color: [0.75, 0.75, 0.75], randomize: 'diffuse' },
+    { name: 'Mirror sphere', color: [0.999, 0.999, 0.999], randomize: 'tint' },
+    { name: 'Glass sphere', color: [0.999, 0.999, 0.999], randomize: 'tint' },
+    { name: 'Light', color: [0, 0, 0], randomize: false },
+  ];
+
+  // HSL -> linear RGB in [0, 1].
+  function hsl(h: number, s: number, l: number): RGB {
+    const k = (n: number) => (n + h / 30) % 12;
+    const a = s * Math.min(l, 1 - l);
+    const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+    return [f(0), f(8), f(4)];
+  }
+
+  function randomColors(): RGB[] {
+    return SPHERES.map(({ color, randomize }) => {
+      const hue = Math.random() * 360;
+      if (randomize === 'diffuse') {
+        // Keep albedo below ~0.85 so the walls don't wash out the scene.
+        return hsl(hue, 0.4 + Math.random() * 0.5, 0.3 + Math.random() * 0.25);
+      }
+      if (randomize === 'tint') {
+        // Light tint keeps the mirror/glass recognizable; max channel stays < 1.
+        return hsl(hue, 0.5 + Math.random() * 0.5, 0.75 + Math.random() * 0.1)
+          .map((c) => Math.min(0.999, c)) as RGB;
+      }
+      return color;
+    });
+  }
+
+  const toCss = (c: RGB) =>
+    `rgb(${c.map((v) => Math.round(Math.pow(Math.min(1, v), 1 / 2.2) * 255)).join(' ')})`;
+
+  class SmallptRender extends HTMLElement {
+    #workers: Worker[] = [];
+    #job = 0;
+    #abort?: AbortController;
+
+    connectedCallback() {
+      const button = this.querySelector<HTMLButtonElement>('[data-rerender]')!;
+      this.#abort = new AbortController();
+      button.addEventListener('click', () => this.render(randomColors()), {
+        signal: this.#abort.signal,
+      });
+      this.render(SPHERES.map((s) => s.color));
+    }
+
+    disconnectedCallback() {
+      this.#abort?.abort();
+      this.#workers.forEach((w) => w.terminate());
+      this.#workers = [];
+      this.#job++;
+    }
+
+    #ensureWorkers() {
+      if (this.#workers.length) return this.#workers;
+      const count = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 8));
+      for (let i = 0; i < count; i++) {
+        this.#workers.push(
+          new Worker(new URL('../wasm/smallpt.worker.ts', import.meta.url), {
+            type: 'module',
+            name: `smallpt-${i}`,
+          }),
+        );
+      }
+      return this.#workers;
+    }
+
+    #showSwatches(colors: RGB[]) {
+      const list = this.querySelector('[data-swatches]')!;
+      list.replaceChildren(
+        ...SPHERES.flatMap(({ name, randomize }, i) => {
+          if (!randomize) return [];
+          const li = document.createElement('li');
+          li.className = 'flex items-center gap-1 text-xs text-gray-600';
+          const dot = document.createElement('span');
+          dot.className = 'inline-block size-3 rounded-full border border-gray-300';
+          dot.style.backgroundColor = toCss(colors[i]);
+          li.append(dot, name);
+          return [li];
+        }),
+      );
+    }
+
+    render(colors: RGB[]) {
+      const width = Number(this.dataset.width);
+      const height = Number(this.dataset.height);
+      const samples = Number(this.dataset.samples);
+      const canvas = this.querySelector('canvas')!;
+      const ctx = canvas.getContext('2d')!;
+      const progress = this.querySelector('progress')!;
+      const status = this.querySelector<HTMLElement>('[data-status]')!;
+      const button = this.querySelector<HTMLButtonElement>('[data-rerender]')!;
+
+      const job = ++this.#job;
+      const workers = this.#ensureWorkers();
+      this.#showSwatches(colors);
+      button.disabled = true;
+      progress.value = 0;
+      status.textContent = `Rendering ${width}×${height} at ${samples * 4} spp on ${workers.length} worker${workers.length > 1 ? 's' : ''}…`;
+
+      // Hand out rows top-down; each worker gets a new row when it finishes one.
+      let nextRow = height - 1;
+      let done = 0;
+      const start = performance.now();
+      const send = (w: Worker, msg: WorkerRequest) => w.postMessage(msg);
+
+      const assign = (w: Worker) => {
+        if (nextRow >= 0) send(w, { type: 'row', job, y: nextRow-- });
+      };
+
+      for (const w of workers) {
+        w.onmessage = ({ data }: MessageEvent<WorkerResponse>) => {
+          if (data.type === 'error') {
+            status.textContent = `Rendering failed: ${data.message}`;
+            button.disabled = false;
+            return;
+          }
+          if (data.job !== job) return; // stale row from a previous render
+          ctx.putImageData(new ImageData(data.pixels, width, 1), 0, height - data.y - 1);
+          progress.value = ++done / height;
+          if (done === height) {
+            const secs = ((performance.now() - start) / 1000).toFixed(1);
+            status.textContent = `Rendered ${width}×${height} at ${samples * 4} spp in ${secs} s with smallpt (WebAssembly).`;
+            button.disabled = false;
+          } else {
+            assign(w);
+          }
+        };
+        w.onerror = (e) => {
+          status.textContent = `Rendering failed: ${e.message || 'could not start worker'}`;
+          button.disabled = false;
+        };
+        send(w, { type: 'setup', job, width, height, samples, colors });
+        assign(w);
+      }
+    }
+  }
+
+  if (!customElements.get('smallpt-render')) {
+    customElements.define('smallpt-render', SmallptRender);
+  }
+</script>
