diff --git a/src/wasm/smallpt.worker.ts b/src/wasm/smallpt.worker.ts
new file mode 100644
index 0000000..295e468
--- /dev/null
+++ b/src/wasm/smallpt.worker.ts
@@ -0,0 +1,41 @@
+// Runs the smallpt WebAssembly module off the main thread. Several of these
+// workers render rows of the same image in parallel; each has its own Wasm
+// instance, so no SharedArrayBuffer / cross-origin isolation is needed.
+import createSmallpt from './smallpt.js';
+
+export type RGB = [number, number, number];
+export type WorkerRequest =
+  | { type: 'setup'; job: number; width: number; height: number; samples: number; colors: RGB[] }
+  | { type: 'row'; job: number; y: number };
+export type WorkerResponse =
+  | { type: 'row'; job: number; y: number; pixels: Uint8ClampedArray<ArrayBuffer> }
+  | { type: 'error'; message: string };
+
+const ready = createSmallpt();
+let width = 0;
+let height = 0;
+let ptr = 0;
+
+self.onmessage = async ({ data }: MessageEvent<WorkerRequest>) => {
+  try {
+    const wasm = await ready;
+    if (data.type === 'setup') {
+      data.colors.forEach(([r, g, b], i) => wasm._set_sphere_color(i, r, g, b));
+      width = data.width;
+      height = data.height;
+      ptr = wasm._begin_render(width, height, data.samples);
+      return;
+    }
+    wasm._render_row(data.y);
+    // smallpt counts rows from the bottom; the RGBA buffer is stored top-down.
+    // Read HEAPU8 after the call: memory growth may have replaced its buffer.
+    const rowBytes = width * 4;
+    const start = ptr + (height - data.y - 1) * rowBytes;
+    const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, start, rowBytes).slice();
+    const msg: WorkerResponse = { type: 'row', job: data.job, y: data.y, pixels };
+    self.postMessage(msg, [pixels.buffer]);
+  } catch (err) {
+    const msg: WorkerResponse = { type: 'error', message: String(err) };
+    self.postMessage(msg);
+  }
+};
