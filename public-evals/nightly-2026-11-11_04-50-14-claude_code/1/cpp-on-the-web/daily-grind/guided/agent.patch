diff --git a/smallpt-worker.js b/smallpt-worker.js
new file mode 100644
index 0000000..966e8ae
--- /dev/null
+++ b/smallpt-worker.js
@@ -0,0 +1,29 @@
+// Web Worker running the smallpt WebAssembly module.
+// Receives row-range jobs, renders them, and posts back RGBA pixels for those rows.
+import initSmallpt from './wasm/smallpt.js';
+
+const wasmReady = initSmallpt();
+let currentRender = -1;
+let rgbaPtr = 0;
+
+self.onmessage = async ({ data }) => {
+  const wasm = await wasmReady;
+  const { renderId, width, height, spp, colors, y0, y1 } = data;
+
+  // Each new render (new colors or settings) resets this worker's buffers.
+  if (renderId !== currentRender) {
+    currentRender = renderId;
+    colors.forEach(([r, g, b], i) => wasm._set_sphere_color(i, r, g, b));
+    rgbaPtr = wasm._begin_render(width, height, spp);
+  }
+
+  wasm._render_rows(y0, y1);
+
+  // smallpt counts y from the bottom; image rows [height-y1, height-y0) are top-down.
+  // Read HEAPU8 fresh after the call, since memory growth detaches old buffers.
+  const rowBytes = width * 4;
+  const top = height - y1;
+  const start = rgbaPtr + top * rowBytes;
+  const pixels = wasm.HEAPU8.slice(start, start + (y1 - y0) * rowBytes);
+  self.postMessage({ renderId, top, rows: y1 - y0, pixels }, [pixels.buffer]);
+};
