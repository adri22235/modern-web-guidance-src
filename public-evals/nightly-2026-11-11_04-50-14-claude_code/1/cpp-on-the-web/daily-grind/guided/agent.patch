+#!/bin/sh
+# Compiles smallpt (src/smallpt.cpp) to WebAssembly -> wasm/smallpt.js + wasm/smallpt.wasm
+# Note: -flto and --closure=1 are omitted: LTO linking of libc++ fails with this
+# Debian emscripten package, and closure-compiler is not installed.
+set -e
+cd "$(dirname "$0")"
+mkdir -p build wasm
+em++ -c src/smallpt.cpp -o build/smallpt.o -O3 -Wall -Werror
+em++ build/smallpt.o -o wasm/smallpt.js \
+  -O3 \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_begin_render,_render_rows,_set_sphere_color,_reset_colors,_sphere_count \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
