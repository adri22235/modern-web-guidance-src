+  <script type="module">
+    // Drives smallpt (WebAssembly) across a pool of Web Workers and paints rows as they finish.
+    const WIDTH = 400, HEIGHT = 300, ROWS_PER_JOB = 4;
+    // Sphere indices in smallpt's scene: 0 left, 1 right, 2 back, 3 front, 4 floor,
+    // 5 ceiling, 6 mirror, 7 glass, 8 light.
+    const DEFAULT_COLORS = [
+      [.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [0, 0, 0],
+      [.75, .75, .75], [.75, .75, .75], [.999, .999, .999], [.999, .999, .999], [0, 0, 0],
+    ];
+    const SWATCH_INDICES = [0, 1, 2, 4, 6, 7];
+
+    const canvas = document.getElementById('smallpt-canvas');
+    const ctx = canvas.getContext('2d');
+    const button = document.getElementById('smallpt-randomize');
+    const quality = document.getElementById('smallpt-quality');
+    const progress = document.getElementById('smallpt-progress');
+    const status = document.getElementById('smallpt-status');
+    const swatches = document.getElementById('smallpt-swatches');
+
+    const workerCount = Math.max(1, Math.min(navigator.hardwareConcurrency || 4, 16));
+    const workers = Array.from({ length: workerCount }, () => {
+      const w = new Worker(new URL('./smallpt-worker.js', import.meta.url), { type: 'module' });
+      w.onmessage = (e) => onRowsDone(w, e.data);
+      w.onerror = (e) => {
+        status.textContent = `Renderer failed to load: ${e.message || 'unknown error'}`;
+        button.disabled = false;
+      };
+      return w;
+    });
+    const idle = new Set(workers);
+
+    let render = null; // { id, colors, spp, nextY, rowsDone, start }
+    let lastColors = DEFAULT_COLORS;
+    let renderCounter = 0;
+
+    function hslToRgb(h, s, l) {
+      const k = (n) => (n + h / 30) % 12;
+      const a = s * Math.min(l, 1 - l);
+      return [0, 8, 4].map((n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1)));
+    }
+
+    function randomColors() {
+      const colors = DEFAULT_COLORS.map((c) => [...c]);
+      const diffuse = (sat, light) => hslToRgb(Math.random() * 360, sat, light).map((v) => Math.min(v, 0.95));
+      colors[0] = diffuse(0.5 + Math.random() * 0.4, 0.4 + Math.random() * 0.2);   // left wall
+      colors[1] = diffuse(0.5 + Math.random() * 0.4, 0.4 + Math.random() * 0.2);   // right wall
+      for (const i of [2, 4, 5]) colors[i] = diffuse(Math.random() * 0.35, 0.55 + Math.random() * 0.2); // back, floor, ceiling
+      // Mirror and glass get light tints so they stay reflective/transparent.
+      for (const i of [6, 7]) colors[i] = hslToRgb(Math.random() * 360, 0.3 + Math.random() * 0.6, 0.75).map((v) => Math.min(v, 0.999));
+      return colors;
+    }
+
+    function showSwatches(colors) {
+      const names = ['Left wall', 'Right wall', 'Back wall', '', 'Floor', '', 'Mirror sphere', 'Glass sphere'];
+      swatches.replaceChildren(...SWATCH_INDICES.map((i) => {
+        const li = document.createElement('li');
+        const [r, g, b] = colors[i].map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255));
+        li.style.background = `rgb(${r} ${g} ${b})`;
+        li.title = names[i];
+        return li;
+      }));
+    }
+
+    function dispatch(worker) {
+      if (!render || render.nextY >= HEIGHT) {
+        idle.add(worker);
+        return;
+      }
+      idle.delete(worker);
+      const y0 = render.nextY;
+      const y1 = Math.min(HEIGHT, y0 + ROWS_PER_JOB);
+      render.nextY = y1;
+      worker.postMessage({ renderId: render.id, width: WIDTH, height: HEIGHT, spp: render.spp, colors: render.colors, y0, y1 });
+    }
+
+    function onRowsDone(worker, { renderId, top, rows, pixels }) {
+      if (render && renderId === render.id) {
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(pixels.buffer), WIDTH, rows), 0, top);
+        render.rowsDone += rows;
+        progress.value = render.rowsDone / HEIGHT;
+        if (render.rowsDone >= HEIGHT) {
+          const secs = ((performance.now() - render.start) / 1000).toFixed(1);
+          status.textContent = `Rendered ${WIDTH}×${HEIGHT} at ${render.spp} samples per pixel in ${secs}s using ${workerCount} worker${workerCount > 1 ? 's' : ''}.`;
+          button.disabled = false;
+          render = null;
+        }
+      }
+      dispatch(worker); // Stale results are ignored; the worker picks up current work (or goes idle).
+    }
+
+    function startRender(colors) {
+      lastColors = colors;
+      render = { id: ++renderCounter, colors, spp: Number(quality.value), nextY: 0, rowsDone: 0, start: performance.now() };
+      showSwatches(colors);
+      progress.value = 0;
+      button.disabled = true;
+      status.textContent = `Path tracing at ${render.spp} samples per pixel…`;
+      ctx.fillStyle = '#111';
+      ctx.fillRect(0, 0, WIDTH, HEIGHT);
+      // Idle workers need a kick; busy ones pick up the new render when their job returns.
+      [...idle].forEach(dispatch);
+    }
+
+    button.addEventListener('click', () => startRender(randomColors()));
+    quality.addEventListener('change', () => startRender(lastColors));
+
+    startRender(DEFAULT_COLORS);
+  </script>
