+  <script>
+    (function () {
+      'use strict';
+
+      /**
+       * Spatial (geometry-based) arrow-key navigation for a card grid.
+       *
+       * Navigation is computed from each card's rendered position
+       * (getBoundingClientRect) rather than from a fixed column count, so it
+       * works in any layout: responsive auto-fit grids, compact grids, a single
+       * column list, ragged last rows, RTL, and after resizes or layout changes.
+       *
+       * Uses the roving-tabindex pattern: exactly one card is in the Tab order.
+       * Tab from the active card reaches its "View Details" link, then leaves
+       * the grid; Shift+Tab returns into the grid at the last active card.
+       */
+      function initSpatialNav(container) {
+        var activeIndex = 0;
+
+        function getItems() {
+          return Array.prototype.filter.call(
+            container.querySelectorAll('[data-nav-item]'),
+            function (el) { return el.getClientRects().length > 0; } // skip hidden
+          );
+        }
+
+        function isRTL() {
+          return getComputedStyle(container).direction === 'rtl';
+        }
+
+        function setActive(items, index, focus) {
+          if (!items.length) return;
+          index = Math.max(0, Math.min(index, items.length - 1));
+          activeIndex = index;
+          items.forEach(function (item, i) {
+            var on = i === index;
+            item.tabIndex = on ? 0 : -1;
+            item.classList.toggle('is-active', on);
+            item.querySelectorAll('a, button, input, select, textarea, [tabindex]')
+              .forEach(function (el) {
+                if (el !== item) el.tabIndex = on ? 0 : -1;
+              });
+          });
+          if (focus) {
+            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+            items[index].focus({ preventScroll: true });
+            items[index].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
+          }
+        }
+
+        /**
+         * Find the best candidate in a direction from the current card.
+         * Candidates must lie strictly in that direction. Cards that overlap the
+         * current card on the perpendicular axis (same row / same column) are
+         * always preferred; ties break on primary distance, then on how far
+         * off-axis the candidate's center is.
+         */
+        function findInDirection(items, fromIndex, dir) {
+          var from = items[fromIndex].getBoundingClientRect();
+          var cx = from.left + from.width / 2;
+          var cy = from.top + from.height / 2;
+          var EPS = 1;
+          var best = null;
+          var bestScore = Infinity;
+
+          items.forEach(function (item, i) {
+            if (i === fromIndex) return;
+            var r = item.getBoundingClientRect();
+            var primary, overlap, offAxis;
+
+            switch (dir) {
+              case 'right':
+                if (r.left < from.right - EPS) return;
+                primary = r.left - from.right;
+                overlap = Math.min(r.bottom, from.bottom) - Math.max(r.top, from.top);
+                offAxis = Math.abs(r.top + r.height / 2 - cy);
+                break;
+              case 'left':
+                if (r.right > from.left + EPS) return;
+                primary = from.left - r.right;
+                overlap = Math.min(r.bottom, from.bottom) - Math.max(r.top, from.top);
+                offAxis = Math.abs(r.top + r.height / 2 - cy);
+                break;
+              case 'down':
+                if (r.top < from.bottom - EPS) return;
+                primary = r.top - from.bottom;
+                overlap = Math.min(r.right, from.right) - Math.max(r.left, from.left);
+                offAxis = Math.abs(r.left + r.width / 2 - cx);
+                break;
+              case 'up':
+                if (r.bottom > from.top + EPS) return;
+                primary = from.top - r.bottom;
+                overlap = Math.min(r.right, from.right) - Math.max(r.left, from.left);
+                offAxis = Math.abs(r.left + r.width / 2 - cx);
+                break;
+            }
+
+            // Aligned candidates win outright over non-aligned ones.
+            var score = (overlap > 0 ? 0 : 1e6) + primary * 1000 + offAxis;
+            if (score < bestScore) {
+              bestScore = score;
+              best = i;
+            }
+          });
+          return best;
+        }
+
+        // Group items into visual rows (by overlapping vertical extent).
+        function rowOf(items, index) {
+          var ref = items[index].getBoundingClientRect();
+          var mid = ref.top + ref.height / 2;
+          return items
+            .map(function (el, i) { return { i: i, r: el.getBoundingClientRect() }; })
+            .filter(function (o) { return o.r.top <= mid && o.r.bottom >= mid; })
+            .sort(function (a, b) { return a.r.left - b.r.left; })
+            .map(function (o) { return o.i; });
+        }
+
+        container.addEventListener('keydown', function (e) {
+          if (e.altKey || e.metaKey) return;
+          var card = e.target.closest('[data-nav-item]');
+          if (!card || !container.contains(card)) return;
+
+          var items = getItems();
+          var current = items.indexOf(card);
+          if (current === -1) return;
+          var onCard = e.target === card;
+          var rtl = isRTL();
+          var next = null;
+
+          switch (e.key) {
+            case 'ArrowRight':
+            case 'ArrowLeft': {
+              var visualDir = e.key === 'ArrowRight' ? 'right' : 'left';
+              next = findInDirection(items, current, visualDir);
+              if (next === null) {
+                // No card in that direction (end of row, or single-column list):
+                // fall back to reading order so every card stays reachable.
+                var forward = (visualDir === 'right') !== rtl;
+                var candidate = current + (forward ? 1 : -1);
+                if (candidate >= 0 && candidate < items.length) next = candidate;
+              }
+              break;
+            }
+            case 'ArrowDown':
+              next = findInDirection(items, current, 'down');
+              break;
+            case 'ArrowUp':
+              next = findInDirection(items, current, 'up');
+              break;
+            case 'Home':
+            case 'End': {
+              if (e.ctrlKey) {
+                next = e.key === 'Home' ? 0 : items.length - 1;
+              } else {
+                var row = rowOf(items, current);
+                var startOfRow = rtl ? row[row.length - 1] : row[0];
+                var endOfRow = rtl ? row[0] : row[row.length - 1];
+                next = e.key === 'Home' ? startOfRow : endOfRow;
+              }
+              break;
+            }
+            case 'Enter':
+            case ' ':
+              if (onCard) {
+                var link = card.querySelector('a[href]');
+                if (link) {
+                  e.preventDefault();
+                  link.click();
+                }
+              }
+              return;
+            default:
+              return;
+          }
+
+          e.preventDefault();
+          if (next !== null && next !== current) setActive(items, next, true);
+        });
+
+        // Keep roving tabindex in sync with mouse clicks / programmatic focus.
+        container.addEventListener('focusin', function (e) {
+          var card = e.target.closest('[data-nav-item]');
+          if (!card) return;
+          var items = getItems();
+          var i = items.indexOf(card);
+          if (i !== -1 && i !== activeIndex) setActive(items, i, false);
+        });
+
+        // Re-sync if items are hidden/added (e.g. filtering, layout change).
+        function refresh() {
+          var items = getItems();
+          if (!items.length) return;
+          var current = container.querySelector('[data-nav-item].is-active');
+          var i = items.indexOf(current);
+          setActive(items, i === -1 ? Math.min(activeIndex, items.length - 1) : i, false);
+        }
+
+        new MutationObserver(refresh).observe(container, {
+          childList: true,
+          subtree: true,
+          attributeFilter: ['hidden', 'style']
+        });
+
+        setActive(getItems(), 0, false);
+        return { refresh: refresh };
+      }
+
+      function initLayoutToggle(grid, nav) {
+        var buttons = document.querySelectorAll('[data-layout-option]');
+        var status = document.getElementById('layout-status');
+        var labels = { grid: 'Grid', compact: 'Compact', list: 'List' };
+
+        function apply(layout, announce) {
+          grid.dataset.layout = layout;
+          buttons.forEach(function (b) {
+            b.setAttribute('aria-pressed', String(b.dataset.layoutOption === layout));
+          });
+          try { localStorage.setItem('dg-card-layout', layout); } catch (err) { /* ignore */ }
+          if (announce && status) status.textContent = labels[layout] + ' layout selected';
+          nav.refresh();
+        }
+
+        buttons.forEach(function (b) {
+          b.addEventListener('click', function () { apply(b.dataset.layoutOption, true); });
+        });
+
+        var saved = null;
+        try { saved = localStorage.getItem('dg-card-layout'); } catch (err) { /* ignore */ }
+        if (saved && labels[saved]) apply(saved, false);
+      }
+
+      document.querySelectorAll('[data-spatial-nav]').forEach(function (grid) {
+        var nav = initSpatialNav(grid);
+        initLayoutToggle(grid, nav);
+      });
+    })();
+  </script>
+
