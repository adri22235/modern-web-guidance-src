+  <script type="module">
+    /**
+     * Spatial (arrow-key) navigation for a composite widget.
+     * Candidates are chosen from live geometry on every keypress, so it keeps
+     * working in any layout mode (grid, list, carousel, RTL, resized viewport).
+     */
+    const TOLERANCE = 1; // px, absorbs sub-pixel rounding
+    const FALLBACK_WEIGHT = 2; // favours aligned candidates when nothing overlaps
+    const DIRECTIONS = {
+      ArrowUp: 'up',
+      ArrowDown: 'down',
+      ArrowLeft: 'left',
+      ArrowRight: 'right',
+    };
+
+    function setupSpatialNavigation(container, itemSelector) {
+      const getItems = () =>
+        [...container.querySelectorAll(itemSelector)].filter((el) => el.checkVisibility());
+
+      // Measure the whole cell so items of different shapes line up by card,
+      // not by where the button happens to sit inside it.
+      const rectOf = (item) =>
+        (item.closest('[role="gridcell"]') ?? item).getBoundingClientRect();
+
+      function setActive(item) {
+        for (const el of container.querySelectorAll(itemSelector)) {
+          el.tabIndex = el === item ? 0 : -1;
+        }
+      }
+
+      function findCandidate(current, direction) {
+        const from = rectOf(current);
+        const horizontal = direction === 'left' || direction === 'right';
+        const aligned = [];
+        const others = [];
+
+        for (const item of getItems()) {
+          if (item === current) continue;
+          const to = rectOf(item);
+
+          // Edge-based direction filter.
+          let gap;
+          switch (direction) {
+            case 'right': gap = to.left - from.right; break;
+            case 'left': gap = from.left - to.right; break;
+            case 'down': gap = to.top - from.bottom; break;
+            case 'up': gap = from.top - to.bottom; break;
+          }
+          if (gap < -TOLERANCE) continue;
+          gap = Math.max(gap, 0);
+
+          const overlaps = horizontal
+            ? to.top < from.bottom - TOLERANCE && to.bottom > from.top + TOLERANCE
+            : to.left < from.right - TOLERANCE && to.right > from.left + TOLERANCE;
+          const perpendicular = horizontal
+            ? Math.abs((to.top + to.bottom) / 2 - (from.top + from.bottom) / 2)
+            : Math.abs((to.left + to.right) / 2 - (from.left + from.right) / 2);
+
+          (overlaps ? aligned : others).push({ item, gap, perpendicular });
+        }
+
+        if (aligned.length) {
+          aligned.sort((a, b) => a.gap - b.gap || a.perpendicular - b.perpendicular);
+          return aligned[0].item;
+        }
+        if (others.length) {
+          const score = (c) => c.gap + FALLBACK_WEIGHT * c.perpendicular;
+          others.sort((a, b) => score(a) - score(b));
+          return others[0].item;
+        }
+        return null;
+      }
+
+      function moveTo(item) {
+        setActive(item);
+        item.focus({ preventScroll: true });
+        item.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      }
+
+      container.addEventListener('keydown', (event) => {
+        if (event.defaultPrevented) return;
+        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+
+        const target = event.composedPath()[0];
+        if (!(target instanceof Element) || !target.matches(itemSelector)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+
+        let next = null;
+        if (event.key in DIRECTIONS) {
+          next = findCandidate(target, DIRECTIONS[event.key]);
+        } else if (event.key === 'Home' || event.key === 'End') {
+          const items = getItems();
+          next = event.key === 'Home' ? items[0] : items.at(-1);
+          if (next === target) next = null;
+        }
+
+        // No candidate: let the browser scroll the page/scroller natively.
+        if (!next) return;
+        event.preventDefault();
+        moveTo(next);
+      });
+
+      // Keep the single tab stop in sync with pointer/programmatic focus.
+      container.addEventListener('focusin', (event) => {
+        if (event.target.matches(itemSelector)) setActive(event.target);
+      });
+
+      // Roving tabindex: one tab stop for the whole widget.
+      const initial = getItems()[0] ?? container.querySelector(itemSelector);
+      if (initial) setActive(initial);
+    }
+
+    const favorites = document.getElementById('favorites');
+    setupSpatialNavigation(favorites, '[data-nav-item]');
+
+    // Layout mode switcher.
+    document.querySelector('.layout-switcher').addEventListener('change', (event) => {
+      if (event.target.name !== 'layout') return;
+      favorites.dataset.layout = event.target.value;
+    });
+  </script>
+
