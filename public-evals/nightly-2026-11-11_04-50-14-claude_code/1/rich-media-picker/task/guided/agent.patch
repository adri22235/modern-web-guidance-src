+      border-inline-start: 4px solid transparent;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: #efebe9;
+      outline: none;
+    }
+
+    .roast-select option::checkmark {
+      display: none;
