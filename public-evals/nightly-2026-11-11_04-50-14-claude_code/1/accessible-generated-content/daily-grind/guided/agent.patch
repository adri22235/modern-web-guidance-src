+      flex: 0 1 5rem;
+      color: var(--flourish);
+      font-size: 0.8em;
+      line-height: 1;
+      background: linear-gradient(var(--flourish), var(--flourish)) no-repeat center / calc(100% - 1.6em) 2px;
