+
+    /* Section heading flourish: ✦ ── Seasonal Favorites ── ✦ */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.75rem;
+      text-align: center;
+    }
+
+    .section-title::before,
