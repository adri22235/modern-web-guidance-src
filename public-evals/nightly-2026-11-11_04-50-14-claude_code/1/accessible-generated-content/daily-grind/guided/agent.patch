+    }
+
+    .btn--arrow::after {
+      --icon: var(--icon-arrow);
+      --icon-size: 0.9em;
+      transition: translate 0.2s ease;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .btn--arrow:is(:hover, :focus-visible)::after {
+        translate: 0.25em 0;
+      }
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Safari: masked pseudo-elements may not paint until interaction (WebKit #301609) */
+    @keyframes webkit-301609 {}
+
+    @supports ((-webkit-nbsp-mode: normal) or (-webkit-touch-callout: none) or (font: -apple-system-body)) and (content-visibility: auto) {
+      @layer webkit-301609-fix {
+        ::before, ::after {
+          animation: webkit-301609 0s;
+        }
+      }
+    }
