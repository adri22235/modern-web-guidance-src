+    }
+
+    /* Shared masked-icon rendering: takes the element's text color */
+    .drink-title::before,
+    .btn--order::before,
+    .btn--arrow::after {
+      content: "";       /* fallback for browsers without alt syntax */
+      content: "" / "";
