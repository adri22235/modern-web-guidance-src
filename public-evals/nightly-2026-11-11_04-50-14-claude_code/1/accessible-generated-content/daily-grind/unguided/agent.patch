+    /* ==========================================================
+       Decorative icons & flourishes
+       ----------------------------------------------------------
+       Accessibility approach:
+       - All icons are CSS pseudo-elements, so they never enter the
+         DOM as real content and can't be focused or selected.
+       - Pseudo-elements that DO contain a glyph use the CSS
+         alternative-text syntax  content: "<glyph>" / "";
+         The empty string after the slash tells assistive tech the
+         glyph is decorative, so it is not announced (e.g. a screen
+         reader won't say "hot beverage, Maple Oat Latte").
+         A plain declaration precedes it as a fallback for browsers
+         that don't yet support the alt-text syntax (they drop the
+         second declaration as invalid and keep the first).
+       - Purely shape-based flourishes use content: "" (empty), which
+         exposes nothing to the accessibility tree.
+       - Meaning never depends on an icon: headings and button labels
+         keep their full visible text, and the repeated "View Details"
+         links get a visually-hidden suffix naming the drink.
+       ========================================================== */
+
+    .visually-hidden {
+      position: absolute !important;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    /* Section heading: bean-and-line flourishes on both sides */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.75rem;
+      color: var(--primary);
+      text-align: center;
+    }
+
+    .section-title::before,
+    .section-title::after {
+      content: "";
+      flex: 0 1 90px;
+      height: 12px;
+      /* a coffee bean (ellipse with a centre seam) + a fading rule */
+      background:
+        radial-gradient(ellipse 5px 6px at var(--bean-x) 50%,
+          var(--primary) 0 70%, transparent 72%),
+        linear-gradient(var(--to-bean), transparent, var(--accent))
+          no-repeat center / 100% 2px;
+    }
+
+    .section-title::before {
+      --bean-x: calc(100% - 5px);
+      --to-bean: to right;
+    }
+
+    .section-title::after {
+      --bean-x: 5px;
+      --to-bean: to left;
+    }
+
+    /* Drink headings: per-drink icon + underline flourish */
+    .card h3 {
+      position: relative;
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      padding-bottom: 0.4rem;
+    }
+
+    .card h3::before {
+      display: inline-grid;
+      place-items: center;
+      width: 2rem;
+      height: 2rem;
+      border-radius: 50%;
+      background: radial-gradient(circle at 30% 30%, #fff3e0, var(--secondary));
+      box-shadow: inset 0 0 0 2px rgba(78, 52, 46, 0.15);
+      font-size: 1.05rem;
+      line-height: 1;
+      /* default icon: hot beverage */
+      content: "\2615";
+      content: "\2615" / "";
+    }
+
+    .card h3.icon-maple::before {
+      content: "\1F341";
+      content: "\1F341" / "";
+    }
+
+    .card h3.icon-espresso::before {
+      content: "\2615";
+      content: "\2615" / "";
+    }
+
+    .card h3.icon-cold::before {
+      content: "\1F9CA";
+      content: "\1F9CA" / "";
+    }
+
+    /* tapered underline drawn with a gradient — no text content */
+    .card h3::after {
+      content: "";
+      position: absolute;
+      left: 15%;
+      right: 15%;
+      bottom: 0;
+      height: 3px;
+      border-radius: 3px;
+      background: linear-gradient(to right, transparent, var(--accent), transparent);
+      transform: scaleX(0.6);
+      transition: transform 0.3s ease;
+    }
+
+    .card:hover h3::after,
+    .card:focus-within h3::after {
+      transform: scaleX(1);
+    }
+
+    /* Buttons */
+    .btn {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .btn::after {
+      display: inline-block;
+      transition: transform 0.25s ease;
+      content: "\2192";
+      content: "\2192" / "";
+    }
+
+    .btn:hover::after,
+    .btn:focus-visible::after {
+      transform: translateX(4px);
+    }
+
+    /* "Order Now": CSS-drawn steaming cup before the label */
+    .btn-order {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+      padding: 12px 24px;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
+    }
+
+    .btn-order:hover {
+      background: #ffc571;
+    }
+
+    /* cup body (open-topped bordered box) with a thicker right wall
+       suggesting a handle, and a saucer drawn via box-shadow */
+    .btn-order::before {
+      content: "";
+      width: 14px;
+      height: 11px;
+      border: 2px solid currentColor;
+      border-right-width: 4px;
+      border-top: 0;
+      border-radius: 0 0 6px 6px;
+      box-shadow: 0 4px 0 -2px currentColor;
+    }
+
+    /* "View Details": small leaf-shaped accent before the label */
+    .btn-details::before {
+      content: "";
+      width: 8px;
+      height: 8px;
+      background: var(--accent);
+      border-radius: 0 50%;
+      transform: rotate(45deg);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn::after,
+      .card h3::after {
+        transition: none;
+      }
+
+      .btn:hover::after,
+      .btn:focus-visible::after {
+        transform: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep shapes visible */
+    @media (forced-colors: active) {
+      .section-title::before,
+      .section-title::after,
+      .card h3::after,
+      .btn-details::before {
+        background: CanvasText;
+        forced-color-adjust: none;
+      }
+
+      .card h3::before {
+        background: none;
+        box-shadow: none;
+      }
+    }
   </style>
 </head>
 
