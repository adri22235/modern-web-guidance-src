+  <script>
+    (function () {
+      var tracked = Array.prototype.slice.call(document.querySelectorAll('#tracked > section'));
+      var animatedRoot = document.getElementById('animated');
+      var visuals = Array.prototype.slice.call(document.querySelectorAll('#animated > section'));
+      if (!tracked.length || !visuals.length) return;
+
+      // Pair each text step with its visual (by data-step, falling back to index).
+      var pairs = tracked.map(function (step, i) {
+        var key = step.getAttribute('data-step');
+        var visual = visuals.filter(function (v) { return v.getAttribute('data-step') === key; })[0] || visuals[i];
+        return { step: step, visual: visual };
+      });
+
+      var activeIndex = -1;
+      var ticking = false;
+
+      function clamp(v) { return Math.min(1, Math.max(0, v)); }
+
+      function setActive(index) {
+        if (index === activeIndex) return;
+        activeIndex = index;
+        pairs.forEach(function (p, i) {
+          var on = i === index;
+          p.step.classList.toggle('is-active', on);
+          if (p.visual) {
+            p.visual.classList.toggle('is-active', on);
+            p.visual.setAttribute('aria-hidden', on ? 'false' : 'true');
+          }
+        });
+      }
+
+      function update() {
+        ticking = false;
+        var trigger = window.innerHeight / 2;
+        var current = 0;
+
+        pairs.forEach(function (p, i) {
+          var rect = p.step.getBoundingClientRect();
+          // 0 when the step's top reaches the viewport middle, 1 when its bottom does.
+          var progress = clamp((trigger - rect.top) / rect.height);
+          if (p.visual) p.visual.style.setProperty('--progress', progress.toFixed(4));
+          if (rect.top <= trigger) current = i;
+        });
+
+        setActive(current);
+
+        var first = tracked[0].getBoundingClientRect();
+        var last = tracked[tracked.length - 1].getBoundingClientRect();
+        var total = last.bottom - first.top;
+        animatedRoot.style.setProperty('--story-progress', clamp((trigger - first.top) / total).toFixed(4));
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate);
+      update();
+    })();
+  </script>
