+  <script>
+    // Fallback for browsers without CSS scroll-driven animations (native CSS is used where supported).
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')) {
+      const animatedRoot = document.querySelector('#animated');
+      const visuals = animatedRoot.querySelectorAll('section');
+      const steps = Array.from(document.querySelectorAll('#tracked section'));
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      animatedRoot.classList.add('scroll-fallback');
+
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          const index = steps.indexOf(entry.target);
+          const visual = visuals[index];
+          if (!visual) return;
+          // 1 once the step fills (or is centered in) the viewport, even if taller than it
+          let ratio = Math.min(1, entry.intersectionRect.height / Math.min(entry.boundingClientRect.height, innerHeight));
+          const exiting = entry.boundingClientRect.top < 0;
+          const isLast = index === visuals.length - 1;
+          if (exiting && isLast) ratio = 1; // last visual stays visible after the story
+
+          visual.style.opacity = ratio;
+          if (reduceMotion.matches) {
+            visual.style.transform = visual.style.translate = visual.style.scale = '';
+          } else if (exiting && !isLast) {
+            visual.style.transform = 'none';
+            visual.style.scale = 0.9 + ratio * 0.1;
+            visual.style.translate = `0 ${(1 - ratio) * -20}%`;
+          } else {
+            visual.style.transform = `rotateY(${-90 + ratio * 90}deg)`;
+            visual.style.scale = 0.6 + ratio * 0.4;
+            visual.style.translate = '0 0';
+          }
+        });
+      }, { threshold: Array.from({ length: 101 }, (_, i) => i / 100) });
+
+      steps.forEach((step) => observer.observe(step));
+    }
+  </script>
