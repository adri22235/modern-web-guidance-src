+  <script type="module">
+    // Load the Popover polyfill only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Collapse the primary navigation into the popover only when the inline row doesn't fit.
+    // Without script the header stays collapsed, which is fully usable.
+    const header = document.querySelector(".site-header");
+    const inner = header.querySelector(".header-inner");
+    const menu = document.getElementById("site-menu");
+    const supportsPopoverOpen = CSS.supports("selector(:popover-open)");
+    const isOpen = () =>
+      menu.classList.contains(":popover-open") ||
+      (supportsPopoverOpen && menu.matches(":popover-open"));
+
+    let lastWidth = 0;
+
+    function syncLayout() {
+      const width = inner.clientWidth;
+      const wasWide = header.classList.contains("is-wide");
+
+      // While collapsed, only re-measure when the header has grown (avoids layout thrash).
+      if (!wasWide && width <= lastWidth) {
+        lastWidth = width;
+        return;
+      }
+      lastWidth = width;
+
+      const wasOpen = isOpen();
+      header.classList.add("is-measuring", "is-wide");
+      const wide = inner.scrollWidth <= inner.clientWidth;
+      header.classList.toggle("is-wide", wide);
+
+      if (wide) {
+        // Inline navigation: a plain list, not a popover.
+        menu.removeAttribute("popover");
+      } else if (!menu.hasAttribute("popover")) {
+        menu.setAttribute("popover", "auto");
+        if (wasOpen) menu.showPopover?.();
+      }
+
+      requestAnimationFrame(() => header.classList.remove("is-measuring"));
+    }
+
+    const observer = new ResizeObserver(syncLayout);
+    observer.observe(header);
+    observer.observe(menu);
+  </script>
