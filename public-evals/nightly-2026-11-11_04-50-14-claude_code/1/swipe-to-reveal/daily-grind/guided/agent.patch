+    /* Swipe-to-reveal drink actions */
+    .card.SwipeReveal {
+      padding: 0;
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      position: relative;
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-trigger {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      min-width: 32px;
+      min-height: 32px;
+      border: none;
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .SwipeReveal-trigger:hover,
+    .SwipeReveal-trigger[aria-expanded="true"] {
+      background: var(--secondary);
+    }
+
+    .SwipeReveal-hint {
+      display: block;
+      margin-top: 10px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-action {
