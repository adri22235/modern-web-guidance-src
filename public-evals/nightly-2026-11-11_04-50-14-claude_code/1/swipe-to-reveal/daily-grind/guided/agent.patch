+  <script>
+    (() => {
+      const status = document.getElementById('drink-action-status');
+      const announce = (msg) => { status.textContent = msg; };
+
+      const isOpen = (reveal) => {
+        const panel = reveal.querySelector('.SwipeReveal-panel');
+        return reveal.scrollLeft > panel.offsetWidth / 2;
+      };
+
+      // Keep aria-expanded and action focusability in sync with what is visible.
+      const setOpen = (reveal, open) => {
+        reveal.querySelector('.SwipeReveal-trigger').setAttribute('aria-expanded', String(open));
+        for (const action of reveal.querySelectorAll('.SwipeReveal-action')) {
+          action.tabIndex = open ? 0 : -1;
+        }
+      };
+
+      const scrollToState = (reveal, open) => {
+        reveal.scrollTo({ left: open ? reveal.scrollWidth : 0 });
+        setOpen(reveal, open);
+      };
+
+      for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+        const trigger = reveal.querySelector('.SwipeReveal-trigger');
+        const content = reveal.querySelector('.SwipeReveal-content');
+
+        trigger.addEventListener('click', () => {
+          const open = trigger.getAttribute('aria-expanded') !== 'true';
+          scrollToState(reveal, open);
+          if (open) reveal.querySelector('.SwipeReveal-action').focus({ preventScroll: true });
+        });
+
+        // Swiping only reveals the actions; sync state once the snap settles.
+        if ('onscrollsnapchange' in Element.prototype) {
+          reveal.addEventListener('scrollsnapchange', (e) => {
+            setOpen(reveal, e.snapTargetInline?.classList.contains('SwipeReveal-panel') ?? isOpen(reveal));
+          });
+        } else {
+          let timeout;
+          const sync = () => { clearTimeout(timeout); setOpen(reveal, isOpen(reveal)); };
+          reveal.addEventListener('scroll', () => {
+            clearTimeout(timeout);
+            timeout = setTimeout(sync, 100);
+          }, { passive: true });
+          reveal.addEventListener('scrollend', sync);
+        }
+
+        // Keyboard users tabbing back into the drink close the panel.
+        content.addEventListener('focusin', (e) => {
+          if (e.target !== trigger && e.target.matches(':focus-visible') && isOpen(reveal)) {
+            scrollToState(reveal, false);
+          }
+        });
+
+        reveal.addEventListener('keydown', (e) => {
+          if (e.key === 'Escape' && isOpen(reveal)) {
+            scrollToState(reveal, false);
+            trigger.focus();
+          }
+        });
+      }
+
+      // Action handlers — only run on an explicit tap/click, never on swipe.
+      for (const btn of document.querySelectorAll('.SwipeReveal-action.favorite')) {
+        btn.addEventListener('click', () => {
+          const pressed = btn.getAttribute('aria-pressed') !== 'true';
+          btn.setAttribute('aria-pressed', String(pressed));
+          const name = btn.closest('.SwipeReveal').querySelector('h3').textContent;
+          announce(`${name} ${pressed ? 'added to' : 'removed from'} favorites`);
+        });
+      }
+
+      for (const btn of document.querySelectorAll('.SwipeReveal-action.share')) {
+        btn.addEventListener('click', async () => {
+          const name = btn.closest('.SwipeReveal').querySelector('h3').textContent;
+          const url = new URL(btn.dataset.shareUrl, location.href).href;
+          try {
+            if (navigator.share) {
+              await navigator.share({ title: name, url });
+            } else {
+              await navigator.clipboard.writeText(url);
+              announce(`Link to ${name} copied`);
+            }
+          } catch (err) {
+            if (err.name !== 'AbortError') announce(`Couldn't share ${name}`);
+          }
+        });
+      }
+    })();
+  </script>
+
