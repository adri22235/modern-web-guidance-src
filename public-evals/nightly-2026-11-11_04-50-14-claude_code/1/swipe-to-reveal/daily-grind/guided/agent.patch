+      color: white;
+      font: inherit;
+      font-size: 0.85rem;
+      text-decoration: none;
+      cursor: pointer;
+    }
+
+    .SwipeReveal-action span[aria-hidden] {
+      font-size: 1.3rem;
+    }
+
+    .SwipeReveal-action:focus-visible {
