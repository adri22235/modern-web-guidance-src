+  <script>
+    (function () {
+      var OPEN_THRESHOLD = 0.4;   // fraction of action width needed to snap open
+      var AXIS_LOCK_DISTANCE = 8; // px before deciding horizontal vs vertical
+      var cards = Array.prototype.slice.call(document.querySelectorAll('.swipe-card'));
+      var openCard = null;
+
+      function actionsWidth(card) {
+        return card.querySelector('.card-actions').offsetWidth;
+      }
+
+      function setOpen(card, open) {
+        var content = card.querySelector('.card-content');
+        var actions = card.querySelector('.card-actions');
+        var toggle = card.querySelector('.actions-toggle');
+        content.style.transform = '';
+        card.classList.toggle('open', open);
+        toggle.setAttribute('aria-expanded', String(open));
+        if (open) {
+          actions.removeAttribute('inert');
+          if (openCard && openCard !== card) setOpen(openCard, false);
+          openCard = card;
+        } else {
+          actions.setAttribute('inert', '');
+          if (openCard === card) openCard = null;
+        }
+      }
+
+      cards.forEach(function (card) {
+        var content = card.querySelector('.card-content');
+        var toggle = card.querySelector('.actions-toggle');
+        var favorite = card.querySelector('.card-action.favorite');
+        var startX = 0, startY = 0, baseOffset = 0, offset = 0;
+        var pointerId = null, axis = null, suppressClick = false;
+
+        content.addEventListener('pointerdown', function (e) {
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          if (e.target.closest('.actions-toggle')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          baseOffset = card.classList.contains('open') ? -actionsWidth(card) : 0;
+          offset = baseOffset;
+          axis = null;
+          suppressClick = false;
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var dx = e.clientX - startX;
+          var dy = e.clientY - startY;
+
+          if (axis === null) {
+            if (Math.abs(dx) < AXIS_LOCK_DISTANCE && Math.abs(dy) < AXIS_LOCK_DISTANCE) return;
+            axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
+            if (axis === 'y') { pointerId = null; return; } // let the page scroll
+            content.setPointerCapture(e.pointerId);
+            card.classList.add('dragging');
+            suppressClick = true;
+          }
+
+          var max = actionsWidth(card);
+          offset = Math.min(0, Math.max(-max, baseOffset + dx));
+          content.style.transform = 'translateX(' + offset + 'px)';
+        });
+
+        function endDrag(e) {
+          if (e.pointerId !== pointerId) return;
+          pointerId = null;
+          if (axis !== 'x') return;
+          card.classList.remove('dragging');
+          // Snap open or closed. Revealing actions never triggers one.
+          setOpen(card, -offset > actionsWidth(card) * OPEN_THRESHOLD);
+        }
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+
+        // Swallow the click that follows a drag, and treat a tap on an
+        // open card's content as "close" rather than following a link.
+        content.addEventListener('click', function (e) {
+          if (e.target.closest('.actions-toggle')) return;
+          if (suppressClick || card.classList.contains('open')) {
+            e.preventDefault();
+            e.stopPropagation();
+            if (!suppressClick) setOpen(card, false);
+          }
+          suppressClick = false;
+        }, true);
+
+        // Prevent native link/image dragging from hijacking the gesture.
+        content.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        // Non-touch / keyboard access to the same actions.
+        toggle.addEventListener('click', function () {
+          var open = !card.classList.contains('open');
+          setOpen(card, open);
+          if (open) card.querySelector('.card-action').focus();
+        });
+
+        favorite.addEventListener('click', function () {
+          var pressed = favorite.getAttribute('aria-pressed') !== 'true';
+          favorite.setAttribute('aria-pressed', String(pressed));
+          favorite.querySelector('.icon').innerHTML = pressed ? '&#x2665;' : '&#x2661;';
+          favorite.querySelector('.label').textContent = pressed ? 'Favorited' : 'Favorite';
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && card.classList.contains('open')) {
+            setOpen(card, false);
+            toggle.focus();
+          }
+        });
+      });
+
+      // Tapping anywhere outside the open card closes it.
+      document.addEventListener('pointerdown', function (e) {
+        if (openCard && !openCard.contains(e.target)) setOpen(openCard, false);
+      });
+    })();
+  </script>
+
