+      top: 0;
+      right: 0;
+      bottom: 0;
+      display: flex;
+      width: var(--actions-width, 216px);
+    }
+
+    .card-action {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      border: 0;
+      color: white;
+      font: inherit;
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-decoration: none;
+      cursor: pointer;
+      padding: 0 6px;
+    }
+
+    .card-action .icon {
+      font-size: 1.3rem;
+      line-height: 1;
+    }
+
+    .card-action:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .card-action.order { background: #6d4c41; }
+    .card-action.customize { background: #8d6e63; }
+    .card-action.favorite { background: #c77700; }
+    .card-action.favorite[aria-pressed="true"] { background: #e65100; }
+
+    .card-content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      padding: 20px;
+      background: white;
+      transition: transform 0.25s ease;
+      will-change: transform;
+      user-select: none;
+      -webkit-user-select: none;
+    }
+
+    .swipe-card.dragging .card-content {
+      transition: none;
+    }
+
+    .swipe-card.open .card-content {
+      transform: translateX(calc(-1 * var(--actions-width, 216px)));
+      box-shadow: 4px 0 8px rgba(0, 0, 0, 0.15);
+    }
+
+    .actions-toggle {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      width: 32px;
+      height: 32px;
+      border: 0;
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font-size: 1.2rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .actions-toggle:hover,
+    .actions-toggle:focus-visible {
+      background: var(--secondary);
+    }
+
+    .swipe-hint {
+      margin-top: 10px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card-content { transition: none; }
+    }
