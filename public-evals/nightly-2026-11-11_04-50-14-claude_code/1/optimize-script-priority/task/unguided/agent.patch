diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,21 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Dashboard</title>
+
+  <!-- Critical interactivity: async, fetched at high priority -->
+  <script src="/js/app.js" async fetchpriority="high"></script>
+
+  <!-- Legacy widgets: deferred so it no longer blocks the parser (still runs in order, after parsing) -->
+  <script src="/js/legacy-widgets.js" defer></script>
+
+  <!-- Analytics: async, low priority so it never competes with critical resources -->
+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+</head>
+<body>
+  <h1>Dashboard</h1>
+  <main id="dashboard"></main>
+</body>
+</html>
