+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const statusEl = document.getElementById('signin-status');
+    const passwordInput = document.getElementById('current-password');
+    const submitButton = form.querySelector('[data-testid="signin-button"]');
+
+    // Controller for any pending conditional-get (autofill) request on this page.
+    // Must be aborted before a conditional create call.
+    let loginAbortController = new AbortController();
+
+    document.getElementById('show-password').addEventListener('change', (e) => {
+      passwordInput.type = e.target.checked ? 'text' : 'password';
+    });
+
+    function setStatus(message, isError = false) {
+      statusEl.textContent = message;
+      statusEl.classList.toggle('error', isError);
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+
+      submitButton.disabled = true;
+      setStatus('Signing in…');
+
+      try {
+        const response = await fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            email: form.email.value.trim(),
+            password: form.password.value,
+          }),
+        });
+
+        if (!response.ok) {
+          setStatus('Incorrect email or password. Please try again.', true);
+          return;
+        }
+
+        setStatus('Signed in. Welcome back!');
+        form.password.value = '';
+
+        // Fire-and-forget: silently upgrade this password user to a passkey.
+        // Never surfaces UI or errors to the user.
+        triggerConditionalCreate().catch((err) => {
+          console.debug('Silent passkey registration skipped:', err);
+        });
+      } catch {
+        setStatus('Unable to sign in right now. Please check your connection and try again.', true);
+      } finally {
+        submitButton.disabled = false;
+      }
+    });
+
+    async function signalUnknown(rpId, credentialId) {
+      if (!rpId || typeof PublicKeyCredential.signalUnknownCredential !== 'function') return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.debug('signalUnknownCredential failed:', err);
+      }
+    }
+
+    async function triggerConditionalCreate() {
+      // WebAuthn requires a secure context and PublicKeyCredential support.
+      if (!window.isSecureContext || typeof window.PublicKeyCredential === 'undefined') return;
+
+      // Polyfill getClientCapabilities / parseCreationOptionsFromJSON / toJSON where missing.
+      if (
+        typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        try {
+          await import('webauthn-polyfills');
+        } catch {
+          return;
+        }
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities?.conditionalCreate !== true) return;
+
+      // Clear any pending conditional-get (autofill) request.
+      loginAbortController.abort();
+      loginAbortController = new AbortController();
+
+      // Server must include rp.id and excludeCredentials for the user's existing passkeys.
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ conditional: true }),
+      });
+      if (!optionsResponse.ok) return;
+
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+      } catch (err) {
+        if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(err.name)) {
+          console.debug('Unexpected conditional create error:', err);
+        }
+        return;
+      }
+      if (!credential) return;
+
+      const encodedResponse = credential.toJSON();
+      // Always use the server-provided RP ID; never window.location.hostname.
+      const rpId = publicKey.rp?.id;
+
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ ...encodedResponse, conditional: true }),
+        });
+        if (!verifyResponse.ok) {
+          await signalUnknown(rpId, encodedResponse.id);
+        }
+      } catch (err) {
+        console.debug('Passkey verification network failure:', err);
+        await signalUnknown(rpId, encodedResponse.id);
+      }
+    }
+  </script>
+
