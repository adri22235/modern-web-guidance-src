+  <script>
+    (() => {
+      'use strict';
+
+      const SIGNIN_ENDPOINT = '/api/login';
+      const REG_OPTIONS_ENDPOINT = '/api/register/options';
+      const REG_VERIFY_ENDPOINT = '/api/register/verify';
+
+      const form = document.getElementById('signin-form');
+      const button = form.querySelector('[data-testid="signin-button"]');
+      const statusEl = document.getElementById('signin-status');
+
+      function setStatus(message, type) {
+        statusEl.textContent = message;
+        statusEl.className = 'signin-status' + (type ? ' ' + type : '');
+      }
+
+      // ---------- base64url helpers ----------
+      function base64urlToBuffer(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToBase64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      // Accepts either the raw options object or { publicKey: {...} }.
+      function parseCreationOptions(json) {
+        const opts = json && json.publicKey ? json.publicKey : json;
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(opts);
+        }
+        const parsed = { ...opts };
+        parsed.challenge = base64urlToBuffer(opts.challenge);
+        parsed.user = { ...opts.user, id: base64urlToBuffer(opts.user.id) };
+        if (Array.isArray(opts.excludeCredentials)) {
+          parsed.excludeCredentials = opts.excludeCredentials.map((c) => ({
+            ...c,
+            id: base64urlToBuffer(c.id),
+          }));
+        }
+        return parsed;
+      }
+
+      function credentialToJSON(credential) {
+        if (typeof credential.toJSON === 'function') {
+          try { return credential.toJSON(); } catch (_) { /* fall through */ }
+        }
+        const response = credential.response;
+        const json = {
+          id: credential.id,
+          rawId: bufferToBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          clientExtensionResults: credential.getClientExtensionResults
+            ? credential.getClientExtensionResults()
+            : {},
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            attestationObject: bufferToBase64url(response.attestationObject),
+          },
+        };
+        if (typeof response.getTransports === 'function') {
+          json.response.transports = response.getTransports();
+        }
+        return json;
+      }
+
+      // ---------- capability check ----------
+      async function canSilentlyRegisterPasskey() {
+        if (!window.isSecureContext) return false;
+        if (typeof window.PublicKeyCredential === 'undefined') return false;
+        if (!navigator.credentials || typeof navigator.credentials.create !== 'function') return false;
+        try {
+          if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+            const caps = await PublicKeyCredential.getClientCapabilities();
+            return caps.conditionalCreate === true;
+          }
+        } catch (_) {
+          return false;
+        }
+        // Without getClientCapabilities we cannot confirm conditional create
+        // support, so never risk showing a modal prompt.
+        return false;
+      }
+
+      // ---------- orphan cleanup ----------
+      async function signalOrphanedCredential(rpId, credentialId) {
+        try {
+          if (rpId && credentialId && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+          }
+        } catch (_) {
+          /* silent by design */
+        }
+      }
+
+      // ---------- silent passkey registration ----------
+      async function silentlyRegisterPasskey() {
+        try {
+          if (!(await canSilentlyRegisterPasskey())) return;
+
+          const optionsRes = await fetch(REG_OPTIONS_ENDPOINT, {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({}),
+          });
+          if (!optionsRes.ok) return;
+          const optionsJSON = await optionsRes.json();
+          const publicKey = parseCreationOptions(optionsJSON);
+          const rpId = publicKey.rp && publicKey.rp.id ? publicKey.rp.id : location.hostname;
+
+          let credential;
+          try {
+            credential = await navigator.credentials.create({
+              publicKey,
+              mediation: 'conditional',
+            });
+          } catch (_) {
+            // NotAllowedError / InvalidStateError etc.: the browser declined
+            // to create silently. Do nothing, show nothing.
+            return;
+          }
+          if (!credential) return;
+
+          let verified = false;
+          try {
+            const verifyRes = await fetch(REG_VERIFY_ENDPOINT, {
+              method: 'POST',
+              credentials: 'same-origin',
+              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+              body: JSON.stringify(credentialToJSON(credential)),
+            });
+            if (verifyRes.ok) {
+              const result = await verifyRes.json().catch(() => ({}));
+              verified = result.verified !== false;
+            }
+          } catch (_) {
+            verified = false;
+          }
+
+          if (!verified) {
+            // The authenticator stored a passkey the server doesn't know
+            // about; tell the credential manager to remove it.
+            await signalOrphanedCredential(rpId, credential.id);
+          }
+        } catch (_) {
+          /* silent by design: never surface passkey upgrade errors */
+        }
+      }
+
+      // ---------- password sign-in ----------
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const username = form.username.value.trim();
+        const password = form.password.value;
+
+        if (!username || !password) {
+          setStatus('Please enter your username and password.', 'error');
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Signing in…');
+
+        try {
+          const res = await fetch(SIGNIN_ENDPOINT, {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({ username, password }),
+          });
+
+          if (!res.ok) {
+            let message = 'Sign-in failed. Please check your credentials.';
+            try {
+              const data = await res.json();
+              if (data && typeof data.error === 'string') message = data.error;
+              else if (data && typeof data.message === 'string') message = data.message;
+            } catch (_) { /* ignore */ }
+            setStatus(message, 'error');
+            return;
+          }
+
+          setStatus('Signed in successfully. Welcome back!', 'success');
+          form.password.value = '';
+
+          // Fire-and-forget: upgrade the account with a passkey in the background.
+          silentlyRegisterPasskey();
+        } catch (_) {
+          setStatus('Network error. Please try again.', 'error');
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
