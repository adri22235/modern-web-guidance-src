+++ b/js/signatures.js
@@ -0,0 +1,335 @@
+// Digital signatures for Daily Grind receipts and gift vouchers.
+//
+// Uses WebCrypto asymmetric signatures, preferring post-quantum ML-DSA-65
+// (FIPS 204) and falling back to classical Ed25519, then ECDSA P-256 in
+// browsers that don't support the newer algorithms.
+//
+// Token format (all segments base64url, no padding):
+//   DG1.<header JSON>.<claims JSON>.<signature>
+// The signature covers the ASCII string "DG1.<header>.<claims>", so the
+// algorithm, key id and document type are tamper-protected along with the
+// claims. Each document type also gets its own domain-separation context, so
+// a receipt signature can never be passed off as a voucher (or vice versa).
+
+const TOKEN_PREFIX = 'DG1';
+const ML_DSA_SUITE = 'ML-DSA-65';
+const ML_DSA_SUITES = new Set(['ML-DSA-44', 'ML-DSA-65', 'ML-DSA-87']);
+const ECDSA_SUITE = 'ECDSA-P256';
+const DB_NAME = 'daily-grind-signing';
+const DB_STORE = 'keys';
+const ISSUER_KEY_ID = 'issuer';
+
+export const DOC_TYPES = Object.freeze(['receipt', 'voucher']);
+
+const encoder = new TextEncoder();
+const decoder = new TextDecoder('utf-8', { fatal: true });
+
+/* ---------- base64url ---------- */
+
+const B64URL_PATTERN = /^[A-Za-z0-9_-]*$/;
+
+export function b64urlEncode(bytes) {
+  if (typeof bytes.toBase64 === 'function') {
+    return bytes.toBase64({ alphabet: 'base64url', omitPadding: true });
+  }
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64urlDecode(text) {
+  if (!B64URL_PATTERN.test(text)) {
+    throw new SyntaxError('Invalid base64url data');
+  }
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(text, { alphabet: 'base64url' });
+  }
+  const base64 = text.replace(/-/g, '+').replace(/_/g, '/');
+  const binary = atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '='));
+  return Uint8Array.from(binary, (char) => char.charCodeAt(0));
+}
+
+/* ---------- algorithm suites ---------- */
+
+export function isPostQuantumSuite(suite) {
+  return ML_DSA_SUITES.has(suite);
+}
+
+function supportsPostQuantumSignatures() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('generateKey', ML_DSA_SUITE) &&
+    SubtleCrypto.supports('sign', ML_DSA_SUITE)
+  );
+}
+
+async function generateKeyPair() {
+  if (supportsPostQuantumSignatures()) {
+    return crypto.subtle.generateKey(ML_DSA_SUITE, false, ['sign', 'verify']);
+  }
+  try {
+    return await crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']);
+  } catch {
+    return crypto.subtle.generateKey(
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      false,
+      ['sign', 'verify'],
+    );
+  }
+}
+
+function suiteOf(key) {
+  return key.algorithm.name === 'ECDSA' ? ECDSA_SUITE : key.algorithm.name;
+}
+
+async function exportPublicKey(publicKey) {
+  // ML-DSA rejects the legacy 'raw' format; classical keys use 'raw' for
+  // compatibility with browsers that predate 'raw-public'.
+  const format = isPostQuantumSuite(suiteOf(publicKey)) ? 'raw-public' : 'raw';
+  return new Uint8Array(await crypto.subtle.exportKey(format, publicKey));
+}
+
+async function importPublicKey(suite, bytes) {
+  if (isPostQuantumSuite(suite)) {
+    return crypto.subtle.importKey('raw-public', bytes, suite, true, ['verify']);
+  }
+  if (suite === 'Ed25519') {
+    return crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+  }
+  if (suite === ECDSA_SUITE) {
+    return crypto.subtle.importKey(
+      'raw',
+      bytes,
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      true,
+      ['verify'],
+    );
+  }
+  throw new Error(`Unsupported signature algorithm: ${suite}`);
+}
+
+async function keyIdFor(publicKeyBytes) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKeyBytes));
+  return b64urlEncode(digest.subarray(0, 16));
+}
+
+/* ---------- sign / verify with domain separation ---------- */
+
+function contextFor(docType) {
+  return encoder.encode(`daily-grind.${docType}.v1`);
+}
+
+// Classical algorithms ignore a `context` member, so prepend a length-prefixed
+// context header to keep domain separation consistent across suites.
+function frameClassicalInput(data, context) {
+  if (context.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + context.byteLength + data.byteLength);
+  framed[0] = context.byteLength;
+  framed.set(context, 1);
+  framed.set(data, 1 + context.byteLength);
+  return framed;
+}
+
+function classicalParams(key) {
+  return key.algorithm.name === 'ECDSA' ? { name: 'ECDSA', hash: 'SHA-256' } : 'Ed25519';
+}
+
+async function signBytes(privateKey, data, context) {
+  const name = privateKey.algorithm.name;
+  const signature = ML_DSA_SUITES.has(name)
+    ? await crypto.subtle.sign({ name, context }, privateKey, data)
+    : await crypto.subtle.sign(
+        classicalParams(privateKey),
+        privateKey,
+        frameClassicalInput(data, context),
+      );
+  return new Uint8Array(signature);
+}
+
+function verifyBytes(publicKey, signature, data, context) {
+  const name = publicKey.algorithm.name;
+  return ML_DSA_SUITES.has(name)
+    ? crypto.subtle.verify({ name, context }, publicKey, signature, data)
+    : crypto.subtle.verify(
+        classicalParams(publicKey),
+        publicKey,
+        signature,
+        frameClassicalInput(data, context),
+      );
+}
+
+/* ---------- key storage (IndexedDB keeps CryptoKeys non-extractable) ---------- */
+
+function requestToPromise(request) {
+  return new Promise((resolve, reject) => {
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+function openKeyDb() {
+  const request = indexedDB.open(DB_NAME, 1);
+  request.onupgradeneeded = () => request.result.createObjectStore(DB_STORE);
+  return requestToPromise(request);
+}
+
+function readIssuerKeys(db) {
+  return requestToPromise(
+    db.transaction(DB_STORE, 'readonly').objectStore(DB_STORE).get(ISSUER_KEY_ID),
+  );
+}
+
+function addIssuerKeys(db, keyPair) {
+  const record = { privateKey: keyPair.privateKey, publicKey: keyPair.publicKey };
+  return requestToPromise(
+    db.transaction(DB_STORE, 'readwrite').objectStore(DB_STORE).add(record, ISSUER_KEY_ID),
+  );
+}
+
+async function describeSigner(keyPair, persisted) {
+  const suite = suiteOf(keyPair.publicKey);
+  const publicKeyBytes = await exportPublicKey(keyPair.publicKey);
+  return {
+    suite,
+    postQuantum: isPostQuantumSuite(suite),
+    privateKey: keyPair.privateKey,
+    publicKey: keyPair.publicKey,
+    kid: await keyIdFor(publicKeyBytes),
+    publishedKey: `${suite}:${b64urlEncode(publicKeyBytes)}`,
+    persisted,
+  };
+}
+
+/**
+ * Loads the store's signing key pair from IndexedDB, creating (and
+ * persisting) a new non-extractable key pair on first use.
+ */
+export async function loadOrCreateSigner() {
+  let db = null;
+  try {
+    db = await openKeyDb();
+    const stored = await readIssuerKeys(db);
+    if (stored?.privateKey && stored?.publicKey) return describeSigner(stored, true);
+  } catch {
+    db = null; // Storage unavailable (e.g. some private browsing modes).
+  }
+
+  const keyPair = await generateKeyPair();
+  if (!db) return describeSigner(keyPair, false);
+
+  try {
+    await addIssuerKeys(db, keyPair);
+    return describeSigner(keyPair, true);
+  } catch {
+    // Another tab may have stored a key first; prefer that one.
+    const stored = await readIssuerKeys(db).catch(() => null);
+    return stored?.privateKey && stored?.publicKey
+      ? describeSigner(stored, true)
+      : describeSigner(keyPair, false);
+  }
+}
+
+/**
+ * Parses a published key string ("<suite>:<base64url public key>") into a
+ * trusted verification key.
+ */
+export async function importPublishedKey(published) {
+  const text = published.replace(/\s+/g, '');
+  const separator = text.indexOf(':');
+  if (separator < 1) throw new SyntaxError('Expected "<algorithm>:<public key>"');
+  const suite = text.slice(0, separator);
+  const bytes = b64urlDecode(text.slice(separator + 1));
+  const publicKey = await importPublicKey(suite, bytes);
+  return { suite, publicKey, kid: await keyIdFor(bytes) };
+}
+
+/* ---------- tokens ---------- */
+
+function encodeJson(value) {
+  return b64urlEncode(encoder.encode(JSON.stringify(value)));
+}
+
+function decodeJson(segment) {
+  return JSON.parse(decoder.decode(b64urlDecode(segment)));
+}
+
+/** Signs `claims` as a receipt or voucher and returns a compact token. */
+export async function issueToken(signer, docType, claims) {
+  if (!DOC_TYPES.includes(docType)) throw new TypeError(`Unknown document type: ${docType}`);
+  const header = encodeJson({ v: 1, typ: docType, alg: signer.suite, kid: signer.kid });
+  const body = encodeJson({ ...claims, typ: docType });
+  const signingInput = `${TOKEN_PREFIX}.${header}.${body}`;
+  const signature = await signBytes(
+    signer.privateKey,
+    encoder.encode(signingInput),
+    contextFor(docType),
+  );
+  return `${signingInput}.${b64urlEncode(signature)}`;
+}
+
+/**
+ * Verifies a token against a list of trusted keys ({ suite, kid, publicKey }).
+ * Resolves to { status, header?, claims?, reason? } where status is one of
+ * 'valid', 'invalid', 'untrusted' or 'malformed'. Claims are only returned
+ * once the signature has been verified.
+ */
+export async function verifyToken(token, trustedKeys) {
+  const parts = token.replace(/\s+/g, '').split('.');
+  if (parts.length !== 4 || parts[0] !== TOKEN_PREFIX) {
+    return { status: 'malformed', reason: 'This is not a Daily Grind signed document.' };
+  }
+  const [, headerSegment, bodySegment, signatureSegment] = parts;
+
+  let header;
+  let signature;
+  try {
+    header = decodeJson(headerSegment);
+    signature = b64urlDecode(signatureSegment);
+  } catch {
+    return { status: 'malformed', reason: 'The document could not be decoded.' };
+  }
+  if (header?.v !== 1 || !DOC_TYPES.includes(header.typ) || typeof header.kid !== 'string') {
+    return { status: 'malformed', reason: 'The document header is not recognized.' };
+  }
+
+  const key = trustedKeys.find((k) => k.kid === header.kid && k.suite === header.alg);
+  if (!key) {
+    return {
+      status: 'untrusted',
+      header,
+      reason: 'Signed with a key that is not trusted by this verifier.',
+    };
+  }
+
+  let valid = false;
+  try {
+    valid = await verifyBytes(
+      key.publicKey,
+      signature,
+      encoder.encode(`${TOKEN_PREFIX}.${headerSegment}.${bodySegment}`),
+      contextFor(header.typ),
+    );
+  } catch {
+    valid = false;
+  }
+  if (!valid) {
+    return {
+      status: 'invalid',
+      header,
+      reason: 'The signature does not match. The document was altered or forged.',
+    };
+  }
+
+  let claims;
+  try {
+    claims = decodeJson(bodySegment);
+  } catch {
+    return { status: 'malformed', header, reason: 'The signed contents could not be decoded.' };
+  }
+  if (claims?.typ !== header.typ) {
+    return { status: 'invalid', header, reason: 'The document type does not match its signature.' };
+  }
+  return { status: 'valid', header, claims };
+}
