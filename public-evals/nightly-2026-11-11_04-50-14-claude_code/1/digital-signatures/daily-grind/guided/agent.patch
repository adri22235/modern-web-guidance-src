diff --git a/js/receipts.js b/js/receipts.js
new file mode 100644
index 0000000..794db2a
--- /dev/null
+++ b/js/receipts.js
@@ -0,0 +1,277 @@
+import {
+  issueToken,
+  verifyToken,
+  loadOrCreateSigner,
+  importPublishedKey,
+} from './signatures.js';
+
+const MENU = [
+  { id: 'maple-oat-latte', name: 'Maple Oat Latte', unitCents: 525 },
+  { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', unitCents: 350 },
+  { id: 'cold-brew', name: 'Cold Brew', unitCents: 475 },
+];
+
+const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+const dateTime = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+const formatCents = (cents) => money.format(cents / 100);
+
+const $ = (selector) => document.querySelector(selector);
+
+const issueForm = $('#issue-form');
+const verifyForm = $('#verify-form');
+const keyStatus = $('#signing-key-status');
+const issuedPanel = $('#issued-token');
+const issuedOutput = $('#issued-token-value');
+const verifyInput = $('#verify-token');
+const verifyKeyInput = $('#verify-public-key');
+const verifyResult = $('#verify-result');
+const receiptFields = $('#receipt-fields');
+const voucherFields = $('#voucher-fields');
+const receiptTotal = $('#receipt-total');
+
+/* ---------- helpers ---------- */
+
+function localIsoDate(date = new Date()) {
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
+}
+
+function el(tag, props = {}, ...children) {
+  const node = Object.assign(document.createElement(tag), props);
+  node.append(...children);
+  return node;
+}
+
+function setFormsDisabled(disabled) {
+  for (const form of [issueForm, verifyForm]) {
+    for (const control of form.elements) control.disabled = disabled;
+  }
+}
+
+function selectedDocType() {
+  return issueForm.elements['doc-type'].value;
+}
+
+function syncDocTypeFields() {
+  const isReceipt = selectedDocType() === 'receipt';
+  // Disabled fieldsets are skipped by constraint validation and form data.
+  receiptFields.disabled = !isReceipt;
+  receiptFields.hidden = !isReceipt;
+  voucherFields.disabled = isReceipt;
+  voucherFields.hidden = isReceipt;
+}
+
+function receiptLineItems() {
+  return MENU.map((item) => ({
+    ...item,
+    qty: Number(issueForm.elements[`qty-${item.id}`].value) || 0,
+  })).filter((item) => item.qty > 0);
+}
+
+function updateReceiptTotal() {
+  const items = receiptLineItems();
+  const total = items.reduce((sum, item) => sum + item.qty * item.unitCents, 0);
+  receiptTotal.value = formatCents(total);
+  const firstQty = issueForm.elements[`qty-${MENU[0].id}`];
+  firstQty.setCustomValidity(items.length ? '' : 'Add at least one drink to the order.');
+}
+
+/* ---------- issuing ---------- */
+
+function buildClaims(docType, data) {
+  const base = { id: crypto.randomUUID(), issuedAt: new Date().toISOString() };
+
+  if (docType === 'receipt') {
+    const items = receiptLineItems().map(({ name, qty, unitCents }) => ({ name, qty, unitCents }));
+    return {
+      ...base,
+      store: 'The Daily Grind',
+      customer: data.get('customer').trim() || undefined,
+      items,
+      totalCents: items.reduce((sum, item) => sum + item.qty * item.unitCents, 0),
+    };
+  }
+
+  return {
+    ...base,
+    recipient: data.get('recipient').trim(),
+    from: data.get('from').trim() || undefined,
+    amountCents: Math.round(Number(data.get('amount')) * 100),
+    message: data.get('message').trim() || undefined,
+    expiresOn: data.get('expires'),
+  };
+}
+
+/* ---------- verification rendering ---------- */
+
+const STATUS_COPY = {
+  valid: { title: 'Authentic', tone: 'ok' },
+  expired: { title: 'Authentic, but expired', tone: 'warn' },
+  invalid: { title: 'Tampered or forged', tone: 'bad' },
+  untrusted: { title: 'Unknown signer', tone: 'bad' },
+  malformed: { title: 'Not a valid document', tone: 'bad' },
+};
+
+function claimRows(claims) {
+  const rows = [
+    ['Document', claims.typ === 'voucher' ? 'Gift voucher' : 'Order receipt'],
+    ['ID', claims.id],
+    ['Issued', dateTime.format(new Date(claims.issuedAt))],
+  ];
+  if (claims.typ === 'receipt') {
+    if (claims.customer) rows.push(['Customer', claims.customer]);
+    for (const item of claims.items ?? []) {
+      rows.push([`${item.qty} × ${item.name}`, formatCents(item.qty * item.unitCents)]);
+    }
+    rows.push(['Total', formatCents(claims.totalCents)]);
+  } else {
+    rows.push(['Recipient', claims.recipient]);
+    if (claims.from) rows.push(['From', claims.from]);
+    rows.push(['Value', formatCents(claims.amountCents)]);
+    if (claims.message) rows.push(['Message', claims.message]);
+    rows.push(['Expires', claims.expiresOn]);
+  }
+  return rows;
+}
+
+function renderResult(result) {
+  const copy = STATUS_COPY[result.status];
+  const children = [el('p', { className: 'verify-title', textContent: copy.title })];
+
+  if (result.reason) children.push(el('p', { textContent: result.reason }));
+  if (result.header) {
+    children.push(
+      el('p', {
+        className: 'verify-meta',
+        textContent: `Algorithm: ${result.header.alg} · Key ID: ${result.header.kid}`,
+      }),
+    );
+  }
+  if (result.claims) {
+    const list = el('dl');
+    for (const [term, detail] of claimRows(result.claims)) {
+      list.append(el('dt', { textContent: term }), el('dd', { textContent: String(detail) }));
+    }
+    children.push(list);
+  }
+
+  verifyResult.dataset.tone = copy.tone;
+  verifyResult.replaceChildren(...children);
+}
+
+/* ---------- wiring ---------- */
+
+async function init() {
+  if (!globalThis.crypto?.subtle) {
+    keyStatus.textContent =
+      'Signing needs a secure (HTTPS) connection and a browser with Web Crypto support.';
+    setFormsDisabled(true);
+    return;
+  }
+
+  setFormsDisabled(true);
+  syncDocTypeFields();
+  updateReceiptTotal();
+
+  const tomorrow = new Date();
+  tomorrow.setDate(tomorrow.getDate() + 1);
+  const defaultExpiry = new Date();
+  defaultExpiry.setFullYear(defaultExpiry.getFullYear() + 1);
+  issueForm.elements.expires.min = localIsoDate(tomorrow);
+  issueForm.elements.expires.value = localIsoDate(defaultExpiry);
+
+  let signer;
+  try {
+    signer = await loadOrCreateSigner();
+  } catch (error) {
+    keyStatus.textContent = `Could not create a signing key: ${error.message}`;
+    return;
+  }
+
+  keyStatus.replaceChildren(
+    el('span', {
+      className: `badge ${signer.postQuantum ? 'badge-pq' : 'badge-classical'}`,
+      textContent: signer.postQuantum ? 'Quantum-resistant' : 'Classical',
+    }),
+    ` Signing with ${signer.suite} · Key ID ${signer.kid}`,
+    signer.persisted ? '' : ' (temporary key: browser storage is unavailable)',
+  );
+  $('#published-key').value = signer.publishedKey;
+  setFormsDisabled(false);
+  syncDocTypeFields();
+
+  issueForm.addEventListener('change', (event) => {
+    if (event.target.name === 'doc-type') syncDocTypeFields();
+  });
+  issueForm.addEventListener('input', updateReceiptTotal);
+
+  issueForm.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const submitter = event.submitter ?? issueForm.querySelector('[type="submit"]');
+    submitter.disabled = true;
+    try {
+      const docType = selectedDocType();
+      const claims = buildClaims(docType, new FormData(issueForm));
+      issuedOutput.value = await issueToken(signer, docType, claims);
+      issuedPanel.hidden = false;
+      $('#issued-token-label').textContent =
+        docType === 'receipt' ? 'Signed order receipt' : 'Signed gift voucher';
+    } catch (error) {
+      issuedOutput.value = `Signing failed: ${error.message}`;
+      issuedPanel.hidden = false;
+    } finally {
+      submitter.disabled = false;
+    }
+  });
+
+  $('#copy-token').addEventListener('click', async (event) => {
+    const button = event.currentTarget;
+    try {
+      await navigator.clipboard.writeText(issuedOutput.value);
+      button.textContent = 'Copied';
+    } catch {
+      issuedOutput.select();
+      button.textContent = 'Press Ctrl+C to copy';
+    }
+    setTimeout(() => { button.textContent = 'Copy'; }, 2000);
+  });
+
+  $('#send-to-verify').addEventListener('click', () => {
+    verifyInput.value = issuedOutput.value;
+    verifyInput.focus();
+    verifyInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  });
+
+  verifyForm.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const trustedKeys = [signer];
+    const published = verifyKeyInput.value.trim();
+    if (published) {
+      try {
+        trustedKeys.push(await importPublishedKey(published));
+        verifyKeyInput.setCustomValidity('');
+      } catch {
+        verifyKeyInput.setCustomValidity(
+          'Enter a public key exactly as published, e.g. "ML-DSA-65:…".',
+        );
+        verifyKeyInput.reportValidity();
+        return;
+      }
+    }
+
+    const result = await verifyToken(verifyInput.value, trustedKeys);
+    if (
+      result.status === 'valid' &&
+      result.claims.typ === 'voucher' &&
+      String(result.claims.expiresOn) < localIsoDate()
+    ) {
+      result.status = 'expired';
+      result.reason = 'This voucher is genuine but can no longer be redeemed.';
+    }
+    renderResult(result);
+  });
+
+  verifyKeyInput.addEventListener('input', () => verifyKeyInput.setCustomValidity(''));
+}
+
+init();
