+/** Accepts either a JSON envelope or a "DG1." token. */
+export function parseEnvelope(input) {
+  if (typeof input !== 'string') throw new Error('Expected text input');
+  const text = input.trim();
+  if (!text) throw new Error('Nothing to verify');
+  if (text.length > MAX_TOKEN_CHARS) throw new Error('Input is too large');
+  let json = text;
+  if (text.startsWith('DG1.')) json = td.decode(b64uDecode(text.slice(4).replace(/\s+/g, '')));
+  let env;
+  try {
+    env = JSON.parse(json);
+  } catch {
+    throw new Error('Not valid JSON or a DG1 token');
+  }
+  if (!env || typeof env !== 'object' || Array.isArray(env)) throw new Error('Malformed envelope');
+  return env;
+}
+
+/**
+ * Verify an envelope.
+ * @param env           parsed envelope
+ * @param trustedKids   Set/array of trusted key fingerprints (hex)
+ * @param now           Date used for validity checks
+ * @returns {{ status: 'valid'|'untrusted'|'invalid', signatureValid, trusted,
+ *             errors: string[], warnings: string[], payload }}
+ */
+export async function verifyEnvelope(env, trustedKids = [], now = new Date()) {
+  const trustedSet = trustedKids instanceof Set ? trustedKids : new Set(trustedKids);
+  const errors = [];
+  const warnings = [];
+  const result = (signatureValid, trusted) => ({
+    status: errors.length || !signatureValid ? 'invalid' : trusted ? 'valid' : 'untrusted',
+    signatureValid,
+    trusted,
+    errors,
+    warnings,
+    payload: env && env.payload,
+    alg: env && env.alg,
+    kid: env && env.kid,
+  });
