+      p.totalCents = p.subtotalCents + p.taxCents;
+    } else p.tampered = true;
+    $('verify-input').value = envelopeToToken(env);
+    runVerify();
+  });
+
+  // ------------------------------------------------------------ trusted keys
+
+  function renderTrusted() {
+    const list = $('trusted-list');
+    if (!trusted.length) {
+      list.replaceChildren(el('li', {}, 'No trusted keys yet.'));
+      return;
+    }
+    list.replaceChildren(
+      ...trusted.map((t) => {
+        const rm = el('button', { type: 'button', class: 'danger' }, 'Remove');
+        rm.addEventListener('click', async () => {
+          await store.removeTrusted(t.kid);
+          trusted = await store.listTrusted();
+          renderTrusted();
+        });
+        return el('li', {},
+          el('span', {}, el('span', { class: 'mono', title: t.kid }, shortFingerprint(t.kid)), ` · ${t.alg} · ${t.label || 'Imported'}`),
+          rm,
+        );
+      }),
+    );
+  }
+
+  $('trust-add').addEventListener('click', async () => {
+    try {
+      const raw = $('trust-input').value.trim();
+      if (raw.length > MAX_TOKEN_CHARS) throw new Error('Input is too large');
+      const pk = await importPublicKey(raw);
+      await store.addTrusted({ format: 'daily-grind-pubkey/v1', ...pk, label: 'Imported' });
+      trusted = await store.listTrusted();
+      renderTrusted();
+      $('trust-input').value = '';
+      setStatus($('trust-status'), `Trusted key ${shortFingerprint(pk.kid)} added.`);
+    } catch (e) {
+      setStatus($('trust-status'), e instanceof SyntaxError ? 'Not valid JSON.' : e.message, true);
+    }
+  });
+
+  renderKey();
+  renderTrusted();
+  if (!store.persistent) {
+    setStatus($('key-status'), 'Browser storage is unavailable, so keys last only for this visit.');
+  }
+}
+
+init().catch((e) => {
+  console.error(e);
+  const s = $('key-status');
+  if (s) setStatus(s, `Signing features failed to load: ${e.message}`, true);
+});
+
