+// ---------------------------------------------------------------- sign / verify
+
+export async function signPayload(key, payload) {
+  validatePayload(payload); // never sign malformed documents
+  const signature = await rawSign(key.alg, key.privateKey, signingInput(key.alg, key.kid, payload));
+  return {
+    format: FORMAT,
+    alg: key.alg,
+    kid: key.kid,
+    publicKey: b64uEncode(key.publicKey),
+    payload,
+    signature: b64uEncode(signature),
+  };
