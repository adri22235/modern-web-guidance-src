diff --git a/js/keystore.js b/js/keystore.js
new file mode 100644
index 0000000..e25b8ca
--- /dev/null
+++ b/js/keystore.js
@@ -0,0 +1,84 @@
+// IndexedDB persistence for signing keys and trusted public keys.
+// WebCrypto private keys are stored as non-extractable CryptoKey objects
+// (structured clone keeps them opaque). Falls back to memory-only storage
+// when IndexedDB is unavailable (e.g. some private-browsing modes).
+
+const DB_NAME = 'daily-grind-signing';
+const DB_VERSION = 1;
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, DB_VERSION);
+    req.onupgradeneeded = () => {
+      const db = req.result;
+      db.createObjectStore('keys', { keyPath: 'kid' });
+      db.createObjectStore('trusted', { keyPath: 'kid' });
+      db.createObjectStore('meta', { keyPath: 'id' });
+    };
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+function idbStore(db) {
+  const run = (store, mode, fn) =>
+    new Promise((resolve, reject) => {
+      const tx = db.transaction(store, mode);
+      const req = fn(tx.objectStore(store));
+      tx.oncomplete = () => resolve(req && req.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  return {
+    persistent: true,
+    get: (store, key) => run(store, 'readonly', (s) => s.get(key)),
+    getAll: (store) => run(store, 'readonly', (s) => s.getAll()),
+    put: (store, value) => run(store, 'readwrite', (s) => s.put(value)),
+    delete: (store, key) => run(store, 'readwrite', (s) => s.delete(key)),
+  };
+}
+
+function memoryStore() {
+  const stores = { keys: new Map(), trusted: new Map(), meta: new Map() };
+  const keyOf = (store, v) => (store === 'meta' ? v.id : v.kid);
+  return {
+    persistent: false,
+    get: async (store, key) => stores[store].get(key),
+    getAll: async (store) => [...stores[store].values()],
+    put: async (store, value) => void stores[store].set(keyOf(store, value), value),
+    delete: async (store, key) => void stores[store].delete(key),
+  };
+}
+
+export async function openKeyStore() {
+  let backend;
+  try {
+    backend = idbStore(await openDb());
+  } catch {
+    backend = memoryStore();
+  }
+
+  return {
+    persistent: backend.persistent,
+
+    async getActiveKey() {
+      const meta = await backend.get('meta', 'active');
+      return meta ? (await backend.get('keys', meta.kid)) || null : null;
+    },
+
+    async saveActiveKey(key) {
+      await backend.put('keys', key);
+      await backend.put('meta', { id: 'active', kid: key.kid });
+    },
+
+    async deleteKey(kid) {
+      await backend.delete('keys', kid);
+      const meta = await backend.get('meta', 'active');
+      if (meta && meta.kid === kid) await backend.delete('meta', 'active');
+    },
+
+    listTrusted: () => backend.getAll('trusted'),
+    addTrusted: (entry) => backend.put('trusted', { ...entry, addedAt: entry.addedAt || new Date().toISOString() }),
+    removeTrusted: (kid) => backend.delete('trusted', kid),
+  };
+}
diff --git a/js/signing-core.js b/js/signing-core.js
new file mode 100644
index 0000000..a15c510
--- /dev/null
+++ b/js/signing-core.js
@@ -0,0 +1,418 @@
+// The Daily Grind — digital signatures for receipts & gift vouchers.
+//
+// Pure crypto/data module (no DOM). Works in modern browsers and Node >= 20.
+//
+// Supported algorithms:
+//   - ECDSA-P256-SHA256  classical, WebCrypto (FIPS 186-5)
+//   - Ed25519            classical, WebCrypto (RFC 8032), where supported
+//   - ML-DSA-65          quantum-resistant (FIPS 204), via vendored @noble/post-quantum
+//
+// Signed envelope format ("daily-grind-signed/v1"):
+//   { format, alg, kid, publicKey, payload, signature }
+// The signature covers a domain-separated, canonical encoding of
+// (format, alg, kid, payload). `kid` is the SHA-256 fingerprint of
+// (alg, publicKey) so the key and algorithm cannot be swapped independently.
+//
+// NOTE: a valid signature proves *integrity* and that the holder of the
+// embedded key signed it. *Authenticity* (that the key belongs to The Daily
+// Grind) additionally requires the key fingerprint to be in a trusted set —
+// verifyEnvelope() reports both separately.
+
+export const FORMAT = 'daily-grind-signed/v1';
+const DOMAIN = 'DailyGrind-Signature-v1';
+const ML_DSA_MODULE = '../vendor/noble-ml-dsa-0.7.1.min.js';
+
+export const MAX_TOKEN_CHARS = 64 * 1024;
+const CLOCK_SKEW_MS = 5 * 60 * 1000;
+
+export const ALGORITHMS = {
+  'ECDSA-P256-SHA256': {
+    label: 'ECDSA P-256 (classical)',
+    family: 'webcrypto',
+    quantumResistant: false,
+    genParams: { name: 'ECDSA', namedCurve: 'P-256' },
+    importParams: { name: 'ECDSA', namedCurve: 'P-256' },
+    signParams: { name: 'ECDSA', hash: 'SHA-256' },
+    sigLen: 64,
+  },
+  Ed25519: {
+    label: 'Ed25519 (classical)',
+    family: 'webcrypto',
+    quantumResistant: false,
+    genParams: { name: 'Ed25519' },
+    importParams: { name: 'Ed25519' },
+    signParams: { name: 'Ed25519' },
+    sigLen: 64,
+  },
+  'ML-DSA-65': {
+    label: 'ML-DSA-65 (quantum-resistant, FIPS 204)',
+    family: 'noble',
+    quantumResistant: true,
+    pubLen: 1952,
+    sigLen: 3309,
+  },
+};
+
+const subtle = globalThis.crypto.subtle;
+const te = new TextEncoder();
+const td = new TextDecoder('utf-8', { fatal: true });
+
+// ---------------------------------------------------------------- encoding
+
+export function b64uEncode(bytes) {
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64uDecode(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new Error('Invalid base64url data');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+const toHex = (bytes) => Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+
+/**
+ * Deterministic JSON: object keys sorted, no whitespace. Only strings,
+ * safe integers, booleans, null, arrays and plain objects are allowed
+ * (money is always integer cents, so floats are rejected outright).
+ */
+export function canonicalize(value) {
+  if (value === null || typeof value === 'boolean') return JSON.stringify(value);
+  if (typeof value === 'string') return JSON.stringify(value);
+  if (typeof value === 'number') {
+    if (!Number.isSafeInteger(value)) throw new Error('Only safe integers are allowed in signed data');
+    return String(value);
+  }
+  if (Array.isArray(value)) return '[' + value.map(canonicalize).join(',') + ']';
+  if (typeof value === 'object' && Object.getPrototypeOf(value) === Object.prototype) {
+    const keys = Object.keys(value).sort();
+    return '{' + keys.map((k) => JSON.stringify(k) + ':' + canonicalize(value[k])).join(',') + '}';
+  }
+  throw new Error('Unsupported value in signed data');
+}
+
+function signingInput(alg, kid, payload) {
+  return te.encode([DOMAIN, FORMAT, alg, kid, canonicalize(payload)].join('\n'));
+}
+
+// ---------------------------------------------------------------- keys
+
+let mlDsaPromise;
+async function mlDsa() {
+  mlDsaPromise ||= import(new URL(ML_DSA_MODULE, import.meta.url).href).then((m) => m.ml_dsa65);
+  return mlDsaPromise;
+}
+
+export async function fingerprint(alg, publicKeyBytes) {
+  const prefix = te.encode(alg + '\n');
+  const buf = new Uint8Array(prefix.length + publicKeyBytes.length);
+  buf.set(prefix);
+  buf.set(publicKeyBytes, prefix.length);
+  return toHex(new Uint8Array(await subtle.digest('SHA-256', buf)));
+}
+
+/** Human-friendly short fingerprint, e.g. "3F9A-12C0-77B1-04DE". */
+export const shortFingerprint = (kid) =>
+  kid.slice(0, 16).toUpperCase().match(/.{4}/g).join('-');
+
+const algSupportCache = new Map();
+export async function isAlgorithmSupported(alg) {
+  const spec = ALGORITHMS[alg];
+  if (!spec) return false;
+  if (spec.family === 'noble') return true;
+  if (!algSupportCache.has(alg)) {
+    algSupportCache.set(
+      alg,
+      subtle.generateKey(spec.genParams, false, ['sign', 'verify']).then(() => true, () => false),
+    );
+  }
+  return algSupportCache.get(alg);
+}
+
+/**
+ * Generate a signing key pair. WebCrypto private keys are created
+ * NON-extractable (they can be stored in IndexedDB but never exported).
+ * Returns { alg, kid, publicKey: Uint8Array, privateKey: CryptoKey|Uint8Array, createdAt }.
+ */
+export async function generateSigningKey(alg) {
+  const spec = ALGORITHMS[alg];
+  if (!spec) throw new Error(`Unknown algorithm: ${alg}`);
+  let publicKey, privateKey;
+  if (spec.family === 'webcrypto') {
+    const kp = await subtle.generateKey(spec.genParams, false, ['sign', 'verify']);
+    publicKey = new Uint8Array(await subtle.exportKey('spki', kp.publicKey));
+    privateKey = kp.privateKey;
+  } else {
+    const ml = await mlDsa();
+    const kp = ml.keygen(); // seed from crypto.getRandomValues
+    publicKey = kp.publicKey;
+    privateKey = kp.secretKey;
+  }
+  return { alg, kid: await fingerprint(alg, publicKey), publicKey, privateKey, createdAt: new Date().toISOString() };
+}
+
+async function rawSign(alg, privateKey, data) {
+  const spec = ALGORITHMS[alg];
+  if (spec.family === 'webcrypto') {
+    return new Uint8Array(await subtle.sign(spec.signParams, privateKey, data));
+  }
+  return (await mlDsa()).sign(data, privateKey);
+}
+
+async function rawVerify(alg, publicKeyBytes, signature, data) {
+  const spec = ALGORITHMS[alg];
+  if (spec.sigLen && signature.length !== spec.sigLen) return false;
+  if (spec.family === 'webcrypto') {
+    let key;
+    try {
+      key = await subtle.importKey('spki', publicKeyBytes, spec.importParams, false, ['verify']);
+    } catch {
+      return false;
+    }
+    return subtle.verify(spec.signParams, key, signature, data);
+  }
+  if (publicKeyBytes.length !== spec.pubLen) return false;
+  try {
+    return (await mlDsa()).verify(signature, data, publicKeyBytes);
+  } catch {
+    return false;
+  }
+}
+
+/** Shareable public-key descriptor (safe to publish). */
+export function exportPublicKey(key) {
+  return { format: 'daily-grind-pubkey/v1', alg: key.alg, kid: key.kid, publicKey: b64uEncode(key.publicKey) };
+}
+
+/** Parse + validate a public-key descriptor; recomputes the fingerprint. */
+export async function importPublicKey(json) {
+  const obj = typeof json === 'string' ? JSON.parse(json) : json;
+  if (!obj || obj.format !== 'daily-grind-pubkey/v1') throw new Error('Not a Daily Grind public key');
+  if (!ALGORITHMS[obj.alg]) throw new Error(`Unsupported algorithm: ${obj.alg}`);
+  const pub = b64uDecode(obj.publicKey);
+  const kid = await fingerprint(obj.alg, pub);
+  if (obj.kid && obj.kid !== kid) throw new Error('Public key fingerprint mismatch');
+  return { alg: obj.alg, kid, publicKey: obj.publicKey };
