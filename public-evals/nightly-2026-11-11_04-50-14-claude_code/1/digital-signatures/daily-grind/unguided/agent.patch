+  if (!env || env.format !== FORMAT) {
+    errors.push('Unknown document format');
+    return result(false, false);
+  }
+  if (!Object.prototype.hasOwnProperty.call(ALGORITHMS, env.alg)) {
+    errors.push(`Unsupported or disallowed algorithm "${String(env.alg)}"`);
+    return result(false, false);
+  }
+  if (typeof env.kid !== 'string' || typeof env.publicKey !== 'string' || typeof env.signature !== 'string') {
+    errors.push('Envelope is missing key or signature fields');
+    return result(false, false);
+  }
+
+  let pub, sig;
+  try {
+    pub = b64uDecode(env.publicKey);
+    sig = b64uDecode(env.signature);
+  } catch {
+    errors.push('Key or signature is not valid base64url');
+    return result(false, false);
+  }
+
+  const kid = await fingerprint(env.alg, pub);
+  if (kid !== env.kid) {
+    errors.push('Key fingerprint does not match the embedded public key');
+    return result(false, false);
+  }
+
+  let data;
+  try {
+    data = signingInput(env.alg, env.kid, env.payload);
+  } catch (e) {
+    errors.push(`Payload cannot be canonicalized: ${e.message}`);
+    return result(false, false);
+  }
+
+  const signatureValid = await rawVerify(env.alg, pub, sig, data);
+  if (!signatureValid) {
+    errors.push('Signature does not match — the document was altered or signed with a different key');
+    return result(false, false);
+  }
+
+  // Signature is good; now check business rules on the signed content.
+  try {
+    validatePayload(env.payload);
+  } catch (e) {
+    errors.push(e.message);
+  }
+  if (!errors.length) checkValidity(env.payload, now, errors, warnings);
+
+  const trusted = trustedSet.has(kid);
+  if (!trusted) warnings.push('Signed by a key that is not in your trusted Daily Grind key list');
+  if (!ALGORITHMS[env.alg].quantumResistant) {
+    warnings.push('Classical signature — not resistant to future quantum attacks');
+  }
+  return result(true, trusted);
+}
+
+// ---------------------------------------------------------------- documents
+
+const isStr = (v, max = 200) => typeof v === 'string' && v.length <= max;
+const isCents = (v) => Number.isSafeInteger(v) && v >= 0 && v <= 100_000_000;
+const isIso = (v) => isStr(v, 40) && !Number.isNaN(Date.parse(v));
