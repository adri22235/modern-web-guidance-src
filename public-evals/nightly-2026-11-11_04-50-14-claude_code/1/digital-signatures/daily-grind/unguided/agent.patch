+/** Throws if the payload is not a well-formed receipt or voucher. */
+export function validatePayload(p) {
+  if (!p || typeof p !== 'object' || Array.isArray(p)) throw new Error('Payload must be an object');
+  if (!isStr(p.id, 64) || !isIso(p.issuedAt) || p.currency !== 'USD' || !isStr(p.issuer, 80)) {
+    throw new Error('Payload is missing required fields');
+  }
+  if (p.type === 'receipt') {
+    if (!Array.isArray(p.items) || p.items.length === 0 || p.items.length > 50) throw new Error('Receipt has no items');
+    let subtotal = 0;
+    for (const it of p.items) {
+      if (!it || !isStr(it.name, 80) || !Number.isSafeInteger(it.qty) || it.qty < 1 || it.qty > 99 || !isCents(it.unitCents)) {
+        throw new Error('Receipt contains an invalid line item');
+      }
+      subtotal += it.qty * it.unitCents;
+    }
+    if (p.customer !== undefined && !isStr(p.customer, 80)) throw new Error('Invalid customer name');
+    if (!isCents(p.subtotalCents) || !isCents(p.taxCents) || !isCents(p.totalCents)) throw new Error('Invalid receipt totals');
+    if (subtotal !== p.subtotalCents || p.subtotalCents + p.taxCents !== p.totalCents) {
+      throw new Error('Receipt totals do not add up');
+    }
+  } else if (p.type === 'voucher') {
+    if (!isCents(p.valueCents) || p.valueCents < 100) throw new Error('Invalid voucher value');
+    if (!isStr(p.recipient, 80) || !isStr(p.message ?? '', 280)) throw new Error('Invalid voucher recipient/message');
+    if (!isIso(p.expiresAt)) throw new Error('Voucher has no valid expiry date');
+    if (Date.parse(p.expiresAt) <= Date.parse(p.issuedAt)) throw new Error('Voucher expires before it was issued');
+  } else {
+    throw new Error('Unknown document type');
+  }
+}
+
+function checkValidity(p, now, errors, warnings) {
+  if (Date.parse(p.issuedAt) > now.getTime() + CLOCK_SKEW_MS) {
+    errors.push('Document is dated in the future');
+  }
+  if (p.type === 'voucher' && Date.parse(p.expiresAt) < now.getTime()) {
+    errors.push(`Voucher expired on ${new Date(p.expiresAt).toLocaleDateString()}`);
+  }
+  if (p.type === 'voucher') warnings.push('Signatures prove authenticity, not that a voucher is unspent — redemption must be checked at the till');
+}
+
+const CROCKFORD = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
+export function randomCode(groups = 2, size = 4) {
+  const bytes = crypto.getRandomValues(new Uint8Array(groups * size));
+  const chars = Array.from(bytes, (b) => CROCKFORD[b & 31]).join('');
+  return chars.match(new RegExp(`.{${size}}`, 'g')).join('-');
+}
+
+export const ISSUER = 'The Daily Grind Coffee Co.';
+export const TAX_RATE_BPS = 875; // 8.75%
+
+export function buildReceipt({ items, customer }, now = new Date()) {
+  const lines = items
+    .filter((i) => i.qty > 0)
+    .map((i) => ({ name: i.name, qty: i.qty, unitCents: i.unitCents }));
+  const subtotalCents = lines.reduce((s, i) => s + i.qty * i.unitCents, 0);
+  const taxCents = Math.round((subtotalCents * TAX_RATE_BPS) / 10_000);
+  const p = {
+    type: 'receipt',
+    id: 'DG-R-' + randomCode(2, 4),
+    issuer: ISSUER,
+    issuedAt: now.toISOString(),
+    currency: 'USD',
+    items: lines,
+    subtotalCents,
+    taxCents,
+    totalCents: subtotalCents + taxCents,
+  };
+  if (customer) p.customer = customer;
+  return p;
+}
+
+export function buildVoucher({ valueCents, recipient, message, expiresOn }, now = new Date()) {
+  // expiresOn is "YYYY-MM-DD"; voucher is valid through the end of that day (UTC).
+  const expiresAt = new Date(`${expiresOn}T23:59:59.999Z`);
+  if (Number.isNaN(expiresAt.getTime())) throw new Error('Choose a valid expiry date');
+  return {
+    type: 'voucher',
+    id: 'DG-V-' + randomCode(3, 4),
+    issuer: ISSUER,
+    issuedAt: now.toISOString(),
+    currency: 'USD',
+    valueCents,
+    recipient,
+    message: message || '',
+    expiresAt: expiresAt.toISOString(),
+  };
+}
+
+export const formatCents = (c) => `$${(c / 100).toFixed(2)}`;
