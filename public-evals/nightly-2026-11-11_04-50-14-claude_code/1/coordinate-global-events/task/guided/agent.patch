+  <script type="module">
+    // Load Temporal polyfill only where the native API is missing (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const HOST_ZONES = [
+      ['Pacific/Honolulu', 'Honolulu'],
+      ['America/Los_Angeles', 'Los Angeles'],
+      ['America/Denver', 'Denver'],
+      ['America/Chicago', 'Chicago'],
+      ['America/New_York', 'New York'],
+      ['America/Bogota', 'Bogotá'],
+      ['America/Sao_Paulo', 'São Paulo'],
+      ['Europe/London', 'London'],
+      ['Europe/Paris', 'Paris'],
+      ['Europe/Berlin', 'Berlin'],
+      ['Africa/Nairobi', 'Nairobi'],
+      ['Africa/Addis_Ababa', 'Addis Ababa'],
+      ['Asia/Kolkata', 'Kolkata'],
+      ['Asia/Jakarta', 'Jakarta'],
+      ['Asia/Shanghai', 'Shanghai'],
+      ['Asia/Tokyo', 'Tokyo'],
+      ['Australia/Sydney', 'Sydney'],
+      ['Pacific/Auckland', 'Auckland'],
+    ];
+
+    // Tasting rooms that receive the converted time.
+    const TARGET_ZONES = [
+      ['America/Los_Angeles', 'Los Angeles'],
+      ['America/New_York', 'New York'],
+      ['America/Bogota', 'Bogotá'],
+      ['America/Sao_Paulo', 'São Paulo'],
+      ['Europe/London', 'London'],
+      ['Europe/Paris', 'Paris'],
+      ['Africa/Addis_Ababa', 'Addis Ababa'],
+      ['Asia/Kolkata', 'Kolkata'],
+      ['Asia/Jakarta', 'Jakarta'],
+      ['Asia/Tokyo', 'Tokyo'],
+      ['Australia/Sydney', 'Sydney'],
+      ['Pacific/Auckland', 'Auckland'],
+    ];
+
+    const $ = (id) => document.getElementById(id);
+    const dateInput = $('dateInput');
+    const timeInput = $('timeInput');
+    const hostTzSelect = $('hostTzSelect');
+    const grid = $('grid');
+    const statusEl = $('status');
+
+    const cityName = (tz) =>
+      HOST_ZONES.find(([z]) => z === tz)?.[1] ??
+      tz.split('/').pop().replaceAll('_', ' ');
+
+    // --- Populate host time zone select (include the visitor's zone) ---
+    const localTz = Temporal.Now.timeZoneId();
+    const hostOptions = [...HOST_ZONES];
+    if (!hostOptions.some(([z]) => z === localTz)) {
+      hostOptions.unshift([localTz, `${cityName(localTz)} (your zone)`]);
+    }
+    for (const [tz, label] of hostOptions) {
+      hostTzSelect.add(new Option(`${label} — ${tz}`, tz));
+    }
+    hostTzSelect.value = hostOptions.some(([z]) => z === localTz) ? localTz : 'America/New_York';
+
+    // --- Defaults: tomorrow at 09:00 in the host zone ---
+    dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).add({ days: 1 }).toString();
+    timeInput.value = '09:00';
+
+    // --- Helpers ---
+    function offsetIsDst(zdt) {
+      // Standard offset = smaller of the January / July offsets that year.
+      const jan = Temporal.ZonedDateTime.from({ timeZone: zdt.timeZoneId, year: zdt.year, month: 1, day: 1 });
+      const jul = Temporal.ZonedDateTime.from({ timeZone: zdt.timeZoneId, year: zdt.year, month: 7, day: 1 });
+      const std = Math.min(jan.offsetNanoseconds, jul.offsetNanoseconds);
+      return jan.offsetNanoseconds !== jul.offsetNanoseconds && zdt.offsetNanoseconds > std;
+    }
+
+    function vibeFor(hour) {
+      if (hour >= 5 && hour < 11) return 'Morning cupping — perfect for bright light roasts.';
+      if (hour >= 11 && hour < 14) return 'Midday tasting — pair with a pour-over.';
+      if (hour >= 14 && hour < 18) return 'Afternoon session — espresso flights welcome.';
+      if (hour >= 18 && hour < 22) return 'Evening tasting — consider decaf or cascara.';
+      return 'Late-night slot — attendees may need extra caffeine (or a recording).';
+    }
+
+    const fmtTime = (zdt) => zdt.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' });
+    const fmtDate = (zdt) => zdt.toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
+    const fmtAbbr = (zdt) =>
+      new Intl.DateTimeFormat('en-US', { timeZone: zdt.timeZoneId, timeZoneName: 'short' })
+        .formatToParts(zdt.epochMilliseconds)
+        .find((p) => p.type === 'timeZoneName')?.value ?? '';
+
+    function el(tag, className, text) {
+      const node = document.createElement(tag);
+      if (className) node.className = className;
+      if (text != null) node.textContent = text;
+      return node;
+    }
+
+    /**
+     * Resolve the host wall-clock time. Returns { zdt } or { error }.
+     * Times that don't exist (spring-forward gap) or occur twice (fall-back
+     * overlap) are rejected so every attendee gets one unambiguous instant.
+     */
+    function resolveHostTime(dateStr, timeStr, tz) {
+      let pdt;
+      try {
+        pdt = Temporal.PlainDateTime.from(`${dateStr}T${timeStr}`);
+      } catch {
+        return { error: 'Please enter a valid date and time.' };
+      }
+      try {
+        return { zdt: pdt.toZonedDateTime(tz, { disambiguation: 'reject' }) };
+      } catch (e) {
+        if (!(e instanceof RangeError)) throw e;
+        const earlier = pdt.toZonedDateTime(tz, { disambiguation: 'earlier' });
+        const later = pdt.toZonedDateTime(tz, { disambiguation: 'later' });
+        const city = cityName(tz);
+        const wall = pdt.toPlainTime().toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' });
+        if (!earlier.toPlainDateTime().equals(pdt) || !later.toPlainDateTime().equals(pdt)) {
+          // Gap: clocks jump forward, this wall time never happens.
+          return {
+            error: `${wall} doesn't exist in ${city} on ${fmtDate(earlier)} — clocks spring forward for daylight saving time. ` +
+              `Try ${fmtTime(earlier)} or ${fmtTime(later)} instead.`,
+          };
+        }
+        // Overlap: clocks fall back, this wall time happens twice.
+        return {
+          error: `${wall} happens twice in ${city} on ${fmtDate(earlier)} — clocks fall back as daylight saving time ends ` +
+            `(${earlier.offset} and ${later.offset}). Please choose a time outside the repeated hour.`,
+        };
+      }
+    }
+
+    function showStatus(msg, kind) {
+      statusEl.textContent = msg;
+      statusEl.className = `status ${kind}`;
+    }
+
+    function render() {
+      const dateStr = dateInput.value;
+      const timeStr = timeInput.value;
+      const tz = hostTzSelect.value;
+      timeInput.setCustomValidity('');
+
+      if (!dateStr || !timeStr) {
+        grid.replaceChildren();
+        showStatus('Choose a date and start time to see the schedule.', 'ok');
+        return;
+      }
+
+      const { zdt: host, error } = resolveHostTime(dateStr, timeStr, tz);
+      if (error) {
+        timeInput.setCustomValidity(error);
+        grid.replaceChildren();
+        showStatus(error, 'error');
+        return;
+      }
+
+      showStatus(
+        `Tasting starts ${fmtTime(host)} ${fmtAbbr(host)} on ${fmtDate(host)} in ${cityName(tz)} ` +
+          `(${host.toInstant().toString({ smallestUnit: 'minute' })}).`,
+        'ok',
+      );
+
+      const zones = [[tz, cityName(tz)], ...TARGET_ZONES.filter(([z]) => z !== tz)];
+      const hostDate = host.toPlainDate();
+
+      const cards = zones.map(([zone, city]) => {
+        const local = host.withTimeZone(zone);
+        const isHost = zone === tz;
+        const card = el('article', `card tz-card${isHost ? ' host' : ''}`);
+        card.append(
+          el('h3', 'city', city),
+          el('div', 'zone', zone),
+          el('div', 'time', fmtTime(local)),
+          el('div', 'date', fmtDate(local)),
+        );
+
+        const meta = el('div', 'meta');
+        if (isHost) meta.append(el('span', 'badge host-badge', 'Host'));
+        meta.append(el('span', 'badge', `${fmtAbbr(local)} · UTC${local.offset}`));
+        if (offsetIsDst(local)) meta.append(el('span', 'badge dst', 'Daylight saving'));
+        const dayDiff = Temporal.PlainDate.compare(local.toPlainDate(), hostDate);
+        if (dayDiff !== 0) {
+          const days = hostDate.until(local.toPlainDate()).days;
+          meta.append(el('span', 'badge day-shift', `${days > 0 ? '+' : ''}${days} day vs host`));
+        }
+        card.append(meta, el('p', 'vibe', vibeFor(local.hour)));
+        return card;
+      });
+
+      grid.replaceChildren(...cards);
+    }
+
+    for (const input of [dateInput, timeInput, hostTzSelect]) {
+      input.addEventListener('input', render);
+      input.addEventListener('change', render);
+    }
+    $('plannerForm').addEventListener('submit', (e) => { e.preventDefault(); render(); });
+
+    render();
+  </script>
+
 </body>
 
