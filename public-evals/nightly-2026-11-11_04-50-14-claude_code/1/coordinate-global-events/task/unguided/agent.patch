+  <script>
+    (function () {
+      'use strict';
+
+      // Zones offered as host options and rendered as target cards.
+      var ZONES = [
+        { tz: 'America/Los_Angeles', city: 'Los Angeles' },
+        { tz: 'America/Denver', city: 'Denver' },
+        { tz: 'America/Chicago', city: 'Chicago' },
+        { tz: 'America/New_York', city: 'New York' },
+        { tz: 'America/Sao_Paulo', city: 'São Paulo' },
+        { tz: 'UTC', city: 'UTC' },
+        { tz: 'Europe/London', city: 'London' },
+        { tz: 'Europe/Paris', city: 'Paris' },
+        { tz: 'Europe/Berlin', city: 'Berlin' },
+        { tz: 'Africa/Nairobi', city: 'Nairobi' },
+        { tz: 'Asia/Dubai', city: 'Dubai' },
+        { tz: 'Asia/Kolkata', city: 'Mumbai' },
+        { tz: 'Asia/Singapore', city: 'Singapore' },
+        { tz: 'Asia/Shanghai', city: 'Shanghai' },
+        { tz: 'Asia/Tokyo', city: 'Tokyo' },
+        { tz: 'Australia/Sydney', city: 'Sydney' },
+        { tz: 'Pacific/Auckland', city: 'Auckland' }
+      ];
+
+      var dateInput = document.getElementById('dateInput');
+      var timeInput = document.getElementById('timeInput');
+      var hostTzSelect = document.getElementById('hostTzSelect');
+      var grid = document.getElementById('grid');
+      var statusMsg = document.getElementById('statusMsg');
+
+      var MINUTE = 60000;
+      var HOUR = 60 * MINUTE;
+      var DAY = 24 * HOUR;
+
+      // ---------- Timezone helpers (Intl-based, DST-aware) ----------
+
+      var partsFmtCache = {};
+      function partsFormatter(tz) {
+        if (!partsFmtCache[tz]) {
+          partsFmtCache[tz] = new Intl.DateTimeFormat('en-US', {
+            timeZone: tz,
+            hourCycle: 'h23',
+            year: 'numeric', month: '2-digit', day: '2-digit',
+            hour: '2-digit', minute: '2-digit', second: '2-digit'
+          });
+        }
+        return partsFmtCache[tz];
+      }
+
+      // Wall-clock fields of a UTC instant in a given zone.
+      function wallParts(utcMs, tz) {
+        var out = {};
+        partsFormatter(tz).formatToParts(new Date(utcMs)).forEach(function (p) {
+          if (p.type !== 'literal') out[p.type] = parseInt(p.value, 10);
+        });
+        if (out.hour === 24) out.hour = 0; // defensive for older engines
+        return out;
+      }
+
+      // Offset (ms) of zone from UTC at a given instant.
+      function offsetAt(utcMs, tz) {
+        var w = wallParts(utcMs, tz);
+        var asUtc = Date.UTC(w.year, w.month - 1, w.day, w.hour, w.minute, w.second);
+        return asUtc - Math.floor(utcMs / 1000) * 1000;
+      }
+
+      /**
+       * Resolve a wall-clock time in a zone to UTC instant(s).
+       * Returns [] for nonexistent times (spring-forward gap),
+       * one entry for normal times, two (sorted) for ambiguous fall-back times.
+       */
+      function resolveWallTime(y, mo, d, h, mi, tz) {
+        var wallMs = Date.UTC(y, mo - 1, d, h, mi, 0);
+        var offsets = {};
+        [-DAY, -DAY / 2, 0, DAY / 2, DAY].forEach(function (delta) {
+          offsets[offsetAt(wallMs + delta, tz)] = true;
+        });
+        var results = [];
+        Object.keys(offsets).forEach(function (k) {
+          var candidate = wallMs - Number(k);
+          var w = wallParts(candidate, tz);
+          if (w.year === y && w.month === mo && w.day === d && w.hour === h && w.minute === mi) {
+            if (results.indexOf(candidate) === -1) results.push(candidate);
+          }
+        });
+        return results.sort(function (a, b) { return a - b; });
+      }
+
+      function isDst(utcMs, tz) {
+        var year = wallParts(utcMs, tz).year;
+        var jan = offsetAt(Date.UTC(year, 0, 1), tz);
+        var jul = offsetAt(Date.UTC(year, 6, 1), tz);
+        if (jan === jul) return false;
+        return offsetAt(utcMs, tz) === Math.max(jan, jul);
+      }
+
+      function formatOffset(ms) {
+        var sign = ms < 0 ? '−' : '+';
+        var abs = Math.abs(ms) / MINUTE;
+        var hh = Math.floor(abs / 60);
+        var mm = abs % 60;
+        return 'UTC' + sign + hh + (mm ? ':' + String(mm).padStart(2, '0') : '');
+      }
+
+      function tzAbbrev(utcMs, tz) {
+        try {
+          var p = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'short' })
+            .formatToParts(new Date(utcMs)).find(function (x) { return x.type === 'timeZoneName'; });
+          return p ? p.value : '';
+        } catch (e) { return ''; }
+      }
+
+      function fmtTime(utcMs, tz) {
+        return new Intl.DateTimeFormat('en-US', {
+          timeZone: tz, hour: 'numeric', minute: '2-digit', hour12: true
+        }).format(new Date(utcMs));
+      }
+
+      function fmtDate(utcMs, tz) {
+        return new Intl.DateTimeFormat('en-US', {
+          timeZone: tz, weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'
+        }).format(new Date(utcMs));
+      }
+
+      function isSupportedZone(tz) {
+        try { new Intl.DateTimeFormat('en-US', { timeZone: tz }); return true; }
+        catch (e) { return false; }
+      }
+
+      // ---------- Input parsing ----------
+
+      function parseDate(v) {
+        var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || '');
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (mo < 1 || mo > 12 || d < 1) return null;
+        var dim = new Date(Date.UTC(y, mo, 0)).getUTCDate();
+        if (d > dim) return null;
+        return { y: y, mo: mo, d: d };
+      }
+
+      function parseTime(v) {
+        var m = /^(\d{2}):(\d{2})(?::(\d{2})(?:\.\d+)?)?$/.exec(v || '');
+        if (!m) return null;
+        var h = +m[1], mi = +m[2];
+        if (h > 23 || mi > 59) return null;
+        return { h: h, mi: mi };
+      }
+
+      // ---------- Rendering ----------
+
+      function escapeHtml(s) {
+        return String(s).replace(/[&<>"']/g, function (c) {
+          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+        });
+      }
+
+      function setStatus(kind, html) {
+        statusMsg.className = 'status' + (kind ? ' ' + kind : '');
+        statusMsg.innerHTML = html || '';
+      }
+
+      function showError(msg) {
+        setStatus('error', escapeHtml(msg));
+        grid.innerHTML = '<div class="card error" role="alert" data-error="true"><h3>Cannot schedule this tasting</h3><p>' +
+          escapeHtml(msg) + '</p></div>';
+        grid.dataset.state = 'error';
+      }
+
+      function dayDiff(a, b) {
+        var da = Date.UTC(a.year, a.month - 1, a.day);
+        var db = Date.UTC(b.year, b.month - 1, b.day);
+        return Math.round((db - da) / DAY);
+      }
+
+      function render() {
+        dateInput.removeAttribute('aria-invalid');
+        timeInput.removeAttribute('aria-invalid');
+
+        var hostTz = hostTzSelect.value;
+        var date = parseDate(dateInput.value);
+        var time = parseTime(timeInput.value);
+
+        if (!date) {
+          dateInput.setAttribute('aria-invalid', 'true');
+          return showError('Please enter a valid date.');
+        }
+        if (!time) {
+          timeInput.setAttribute('aria-invalid', 'true');
+          return showError('Please enter a valid time (HH:MM).');
+        }
+        if (!hostTz || !isSupportedZone(hostTz)) {
+          return showError('Please choose a valid host time zone.');
+        }
+
+        var instants = resolveWallTime(date.y, date.mo, date.d, time.h, time.mi, hostTz);
+        var hostLabel = labelFor(hostTz);
+        var wallStr = dateInput.value + ' ' + timeInput.value.slice(0, 5);
+
+        if (instants.length === 0) {
+          timeInput.setAttribute('aria-invalid', 'true');
+          return showError(wallStr + ' does not exist in ' + hostLabel +
+            ' — clocks spring forward for daylight saving time and skip this hour. Please choose a different time.');
+        }
+
+        var utc = instants[0];
+        var hostWall = wallParts(utc, hostTz);
+
+        if (instants.length > 1) {
+          setStatus('warn', '<strong>Heads up:</strong> ' + escapeHtml(wallStr) + ' occurs twice in ' +
+            escapeHtml(hostLabel) + ' because clocks fall back for the end of daylight saving time. ' +
+            'Using the first occurrence (' + escapeHtml(formatOffset(offsetAt(utc, hostTz))) + ').');
+        } else {
+          setStatus('ok', 'Tasting at <strong>' + escapeHtml(fmtTime(utc, hostTz)) + '</strong> on ' +
+            escapeHtml(fmtDate(utc, hostTz)) + ' in ' + escapeHtml(hostLabel) + ' (' +
+            escapeHtml(new Date(utc).toISOString().replace('.000Z', 'Z')) + ').');
+        }
+
+        var zones = ZONES.slice();
+        if (!zones.some(function (z) { return z.tz === hostTz; })) {
+          zones.unshift({ tz: hostTz, city: hostTz.split('/').pop().replace(/_/g, ' ') });
+        }
+
+        grid.innerHTML = zones.map(function (z) {
+          var w = wallParts(utc, z.tz);
+          var off = offsetAt(utc, z.tz);
+          var dst = isDst(utc, z.tz);
+          var shift = dayDiff(hostWall, w);
+          var isHost = z.tz === hostTz;
+          var friendly = w.hour >= 7 && w.hour < 22;
+          var abbr = tzAbbrev(utc, z.tz);
+          var badges = [
+            '<span class="badge">' + escapeHtml(formatOffset(off)) + (abbr && abbr.indexOf('GMT') !== 0 && abbr !== 'UTC' ? ' · ' + escapeHtml(abbr) : '') + '</span>',
+            dst ? '<span class="badge dst">DST</span>' : '<span class="badge">Standard</span>',
+            shift !== 0 ? '<span class="badge dayshift">' + (shift > 0 ? '+' : '−') + Math.abs(shift) + ' day' + (Math.abs(shift) > 1 ? 's' : '') + '</span>' : '',
+            friendly ? '<span class="badge good">☕ Good hour</span>' : '<span class="badge bad">🌙 Off hours</span>'
+          ].join('');
+          return '<article class="card tz-card' + (isHost ? ' host' : '') + '" data-tz="' + escapeHtml(z.tz) +
+            '" data-utc-offset="' + (off / MINUTE) + '" data-dst="' + dst + '" data-local="' +
+            String(w.year) + '-' + pad(w.month) + '-' + pad(w.day) + 'T' + pad(w.hour) + ':' + pad(w.minute) + '">' +
+            '<h3 class="city">' + escapeHtml(z.city) + (isHost ? ' <span class="badge">Host</span>' : '') + '</h3>' +
+            '<div class="zone">' + escapeHtml(z.tz) + '</div>' +
+            '<p class="time">' + escapeHtml(fmtTime(utc, z.tz)) + '</p>' +
+            '<p class="date">' + escapeHtml(fmtDate(utc, z.tz)) + '</p>' +
+            '<div class="meta">' + badges + '</div>' +
+            '</article>';
+        }).join('');
+        grid.dataset.state = 'ok';
+      }
+
+      function pad(n) { return String(n).padStart(2, '0'); }
+
+      function labelFor(tz) {
+        var z = ZONES.find(function (x) { return x.tz === tz; });
+        return z ? z.city + ' (' + tz + ')' : tz;
+      }
+
+      // ---------- Init ----------
+
+      function init() {
+        var supported = ZONES.filter(function (z) { return isSupportedZone(z.tz); });
+        ZONES = supported;
+        var localTz = '';
+        try { localTz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) { }
+
+        var opts = ZONES.slice();
+        if (localTz && isSupportedZone(localTz) && !opts.some(function (z) { return z.tz === localTz; })) {
+          opts.unshift({ tz: localTz, city: localTz.split('/').pop().replace(/_/g, ' ') + ' (your zone)' });
+        }
+        hostTzSelect.innerHTML = opts.map(function (z) {
+          return '<option value="' + escapeHtml(z.tz) + '">' + escapeHtml(z.city + ' — ' + z.tz) + '</option>';
+        }).join('');
+        hostTzSelect.value = localTz && opts.some(function (z) { return z.tz === localTz; }) ? localTz : 'America/New_York';
+
+        // Default: today (in host zone) at 10:00.
+        var now = wallParts(Date.now(), hostTzSelect.value);
+        if (!dateInput.value) dateInput.value = now.year + '-' + pad(now.month) + '-' + pad(now.day);
+        if (!timeInput.value) timeInput.value = '10:00';
+
+        ['input', 'change'].forEach(function (ev) {
+          dateInput.addEventListener(ev, render);
+          timeInput.addEventListener(ev, render);
+          hostTzSelect.addEventListener(ev, render);
+        });
+        render();
+      }
+
+      // Expose helpers for testing/debugging.
+      window.CoffeeTz = { resolveWallTime: resolveWallTime, offsetAt: offsetAt, isDst: isDst, render: render };
+
+      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
+      else init();
+    })();
+  </script>
+
