+/**
+ * <drink-card> — reusable menu card with encapsulated (Shadow DOM) styles.
+ *
+ * Attributes (all reactive — change them at any time and the card updates):
+ *   heading      Card title, e.g. "Cold Brew"
+ *   description  Short body copy
+ *   href         Action link URL
+ *   link-text    Action link label (default: "View Details")
+ *   limited      Boolean. When present, shows the "Limited" badge.
+ *   badge-text   Optional badge label override (default: "Limited")
+ *
+ * Example:
+ *   <drink-card heading="Maple Oat Latte"
+ *               description="Creamy oat milk..."
+ *               href="/menu/seasonal"
+ *               limited></drink-card>
+ *
+ *   // Toggle the badge from page script:
+ *   card.limited = false;            // or card.removeAttribute('limited')
+ *
+ * Theming: the card reads the page's --primary / --accent / --text custom
+ * properties when available (custom properties intentionally pierce the
+ * shadow boundary); all other styling is isolated from global CSS.
+ */
+(() => {
+  const template = document.createElement('template');
+  template.innerHTML = `
+    <style>
+      :host {
+        all: initial; /* reset inherited global styles (font, color, line-height...) */
+        display: block;
+        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+        line-height: 1.6;
+        color: var(--text, #3e2723);
+      }
+
+      :host([hidden]) {
+        display: none;
+      }
+
+      *, *::before, *::after {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      .card {
+        position: relative;
+        height: 100%;
+        background: #fff;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+      }
+
+      .badge {
+        display: none;
+        position: absolute;
+        top: 12px;
+        right: 12px;
+        background: var(--accent, #ffab40);
+        color: var(--text, #3e2723);
+        font-size: 0.7rem;
+        font-weight: 700;
+        letter-spacing: 0.08em;
+        text-transform: uppercase;
+        padding: 3px 8px;
+        border-radius: 999px;
+      }
+
+      :host([limited]) .badge {
+        display: inline-block;
+      }
+
+      h3 {
+        font-size: 1.17em;
+        margin-bottom: 10px;
+        color: var(--primary, #4e342e);
+      }
+
+      /* Keep the title clear of the badge when it is shown */
+      :host([limited]) h3 {
+        padding: 0 3.5rem;
+      }
+
+      .btn {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: #fff;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover {
+        background: #3e2723;
+      }
+
+      .btn:focus-visible {
+        outline: 2px solid var(--accent, #ffab40);
+        outline-offset: 2px;
+      }
+    </style>
+    <article class="card" part="card">
+      <span class="badge" part="badge"></span>
+      <h3 part="heading"></h3>
+      <p part="description"></p>
+      <a class="btn" part="action"></a>
+    </article>
+  `;
+
+  class DrinkCard extends HTMLElement {
+    static get observedAttributes() {
+      return ['heading', 'description', 'href', 'link-text', 'badge-text'];
+    }
+
+    constructor() {
+      super();
+      const root = this.attachShadow({ mode: 'open' });
+      root.appendChild(template.content.cloneNode(true));
+      this._els = {
+        badge: root.querySelector('.badge'),
+        heading: root.querySelector('h3'),
+        description: root.querySelector('p'),
+        action: root.querySelector('a'),
+      };
+    }
+
+    connectedCallback() {
+      this._render();
+    }
+
+    attributeChangedCallback() {
+      this._render();
+    }
+
+    get limited() {
+      return this.hasAttribute('limited');
+    }
+
+    set limited(value) {
+      this.toggleAttribute('limited', Boolean(value));
+    }
+
+    _render() {
+      const { badge, heading, description, action } = this._els;
+      const title = this.getAttribute('heading') || '';
+      const linkText = this.getAttribute('link-text') || 'View Details';
+
+      heading.textContent = title;
+      description.textContent = this.getAttribute('description') || '';
+      badge.textContent = this.getAttribute('badge-text') || 'Limited';
+
+      action.textContent = linkText;
+      action.setAttribute('href', this.getAttribute('href') || '#');
+      // Give repeated "View Details" links a distinct accessible name.
+      if (title) {
+        action.setAttribute('aria-label', `${linkText}: ${title}`);
+      } else {
+        action.removeAttribute('aria-label');
+      }
+    }
+  }
+
+  if (!customElements.get('drink-card')) {
+    customElements.define('drink-card', DrinkCard);
+  }
+})();
