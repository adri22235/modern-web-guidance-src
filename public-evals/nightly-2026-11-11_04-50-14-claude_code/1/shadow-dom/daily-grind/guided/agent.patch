index 0000000..557c818
--- /dev/null
+++ b/components/drink-card.js
@@ -0,0 +1,156 @@
+/**
+ * <drink-card> — reusable menu card with encapsulated layout and styles.
+ *
+ * Usage:
+ *   <drink-card href="/menu/seasonal" action-label="View Details" limited>
+ *     <h3 slot="title">Maple Oat Latte</h3>
+ *     <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+ *   </drink-card>
+ *
+ * Attributes (reflected as properties):
+ *   href          URL for the action link. The link is hidden when absent.
+ *   action-label  Text for the action link (default: "View Details").
+ *   limited       Boolean. Shows the "Limited" badge when present; add/remove
+ *                 it at any time (or set `card.limited = true/false`).
+ *
+ * Slots:
+ *   title    Drink name (use a heading element for document outline).
+ *   default  Description.
+ *
+ * Theming (optional custom properties, set anywhere up the tree):
+ *   --drink-card-bg, --drink-card-accent, --drink-card-badge-bg,
+ *   --drink-card-badge-fg
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--drink-card-bg, #fff);
+    --_accent: var(--drink-card-accent, var(--primary, #4e342e));
+    --_accent-hover: var(--drink-card-accent-hover, #3e2723);
+    --_badge-bg: var(--drink-card-badge-bg, var(--accent, #ffab40));
+    --_badge-fg: var(--drink-card-badge-fg, #3e2723);
+
+    display: block;
+    position: relative;
+    box-sizing: border-box;
+    background: var(--_bg);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+  }
+
+  :host([hidden]) { display: none; }
+
+  *, *::before, *::after { box-sizing: border-box; }
+
+  .badge {
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    padding: 2px 10px;
+    border-radius: 999px;
+    background: var(--_badge-bg);
+    color: var(--_badge-fg);
+    font-size: 0.75rem;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+    line-height: 1.6;
+  }
+
+  :host(:not([limited])) .badge { display: none; }
+
+  /* Spacing lives on shadow wrappers so global resets on slotted
+     content (e.g. "* { margin: 0 }") can't collapse the layout. */
+  .title {
+    margin: 0 0 10px;
+    color: var(--_accent);
+    font-size: 1.17em;
+    font-weight: bold;
+  }
+
+  :host([limited]) .title { padding-inline: 4.5rem; }
+
+  ::slotted([slot="title"]) {
+    font: inherit;
+    color: inherit;
+  }
+
+  .action {
+    display: inline-block;
+    margin-top: 15px;
+    padding: 10px 20px;
+    border-radius: 5px;
+    background: var(--_accent);
+    color: #fff;
+    font: inherit;
+    text-decoration: none;
+    transition: background 0.3s;
+  }
+
+  .action:hover { background: var(--_accent-hover); }
+
+  .action:focus-visible {
+    outline: 2px solid var(--_accent);
+    outline-offset: 2px;
+  }
+
+  .action:not([href]) { display: none; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <span class="badge" part="badge">Limited</span>
+  <div class="title"><slot name="title"></slot></div>
+  <div class="description"><slot></slot></div>
+  <a class="action" part="action"></a>
+`;
+
+const DEFAULT_ACTION_LABEL = 'View Details';
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['href', 'action-label'];
+
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+    this.#link = root.querySelector('.action');
+  }
+
+  connectedCallback() {
+    this.#syncLink();
+  }
+
+  attributeChangedCallback(_name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#syncLink();
+  }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { v ? this.setAttribute('href', v) : this.removeAttribute('href'); }
+
+  get actionLabel() { return this.getAttribute('action-label') || DEFAULT_ACTION_LABEL; }
+  set actionLabel(v) { v ? this.setAttribute('action-label', v) : this.removeAttribute('action-label'); }
+
+  // Badge visibility is pure CSS (:host([limited])), so no re-render needed.
+  get limited() { return this.hasAttribute('limited'); }
+  set limited(on) { this.toggleAttribute('limited', !!on); }
+
+  #syncLink() {
+    const href = this.getAttribute('href');
+    if (href) this.#link.setAttribute('href', href);
+    else this.#link.removeAttribute('href');
+    this.#link.textContent = this.actionLabel;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
+
+export { DrinkCard };
