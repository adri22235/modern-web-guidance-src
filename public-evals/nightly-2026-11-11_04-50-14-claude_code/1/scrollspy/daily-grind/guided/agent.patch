+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...document.querySelectorAll('.nav-section-link')];
+    const sections = links
+      .map((link) => document.getElementById(link.hash.slice(1)))
+      .filter(Boolean);
+
+    // Keep anchor scroll offset in sync with the sticky nav's real height.
+    new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', `${nav.offsetHeight}px`);
+    }).observe(nav);
+
+    const setCurrent = (activeLink) => {
+      for (const link of links) {
+        link.classList.toggle('target-current', link === activeLink);
+        if (link === activeLink) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      }
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native scrollspy: CSS handles visuals; mirror state for assistive tech.
+      const syncAriaCurrent = () => {
+        setCurrent(links.find((link) => link.matches(':target-current')) ?? null);
+      };
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback: pick the last section whose top has passed the viewport midpoint.
+      const update = () => {
+        const middle = window.innerHeight / 2;
+        const atBottom =
+          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
+        let current = null;
+        if (atBottom) {
+          current = sections.at(-1);
+        } else {
+          for (const section of sections) {
+            const rect = section.getBoundingClientRect();
+            if (rect.top <= middle && rect.bottom > nav.offsetHeight) current = section;
+          }
+        }
+        setCurrent(current ? links[sections.indexOf(current)] : null);
+      };
+
+      let ticking = false;
+      const onScroll = () => {
+        if (ticking) return;
+        ticking = true;
+        requestAnimationFrame(() => {
+          update();
+          ticking = false;
+        });
+      };
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    }
+  </script>
+
