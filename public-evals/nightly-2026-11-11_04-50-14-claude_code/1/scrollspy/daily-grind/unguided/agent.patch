+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var links = Array.prototype.slice.call(document.querySelectorAll('nav a.nav-link[href^="#"]'));
+      var sections = links
+        .map(function (link) { return document.getElementById(link.getAttribute('href').slice(1)); })
+        .filter(Boolean);
+      var root = document.documentElement;
+      var ticking = false;
+
+      function setNavHeight() {
+        root.style.setProperty('--nav-height', nav.offsetHeight + 'px');
+      }
+
+      function setActive(id) {
+        links.forEach(function (link) {
+          var isActive = link.getAttribute('href') === '#' + id;
+          link.classList.toggle('active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function update() {
+        ticking = false;
+        // A section is "current" once its top passes just below the sticky nav.
+        var threshold = nav.offsetHeight + window.innerHeight * 0.25;
+        var currentId = null;
+
+        sections.forEach(function (section) {
+          if (section.getBoundingClientRect().top <= threshold) {
+            currentId = section.id;
+          }
+        });
+
+        // When scrolled to the very bottom, the last section may be too short
+        // to reach the threshold, so force it active.
+        var atBottom = window.innerHeight + window.scrollY >= root.scrollHeight - 2;
+        if (atBottom && sections.length) {
+          currentId = sections[sections.length - 1].id;
+        }
+
+        setActive(currentId);
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      setNavHeight();
+      update();
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', function () {
+        setNavHeight();
+        onScroll();
+      });
+      window.addEventListener('hashchange', onScroll);
+    })();
+  </script>
+
