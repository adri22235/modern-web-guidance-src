+    /* Staff Pick badge */
+    .promo-badge {
+      display: inline-block;
+      /* Fallback for browsers without calc-size() support */
+      inline-size: max-content;
+      max-inline-size: 100%;
+      /* 1.2x the max-content size, clamped between 100px and 100% of the parent */
+      inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+      margin-block-end: 10px;
+      padding: 4px 10px;
+      background: var(--accent);
+      color: var(--text);
+      border-radius: 999px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 0.5px;
+      text-transform: uppercase;
+      text-align: center;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+
+    /* Our Sourcing accordion */
+    .accordion {
+      margin-block-start: 40px;
+    }
+
+    .accordion h2 {
+      margin-block-end: 15px;
+      text-align: center;
+    }
+
+    #accordion-toggle {
+      display: flex;
+      align-items: center;
+      gap: 0.75ch;
+      inline-size: 100%;
+      padding: 15px 20px;
+      background: white;
+      color: var(--primary);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      font: inherit;
+      font-weight: bold;
+      text-align: start;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    #accordion-toggle:hover {
+      background: var(--secondary);
+    }
+
+    #accordion-toggle:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    #accordion-toggle::before {
+      content: "";
+      flex-shrink: 0;
+      inline-size: 0.6em;
+      block-size: 0.6em;
+      border-inline-end: 2px solid currentColor;
+      border-block-end: 2px solid currentColor;
+      /* Closed: chevron points toward the inline end */
+      rotate: -45deg;
+      transition: rotate 0.3s;
+    }
+
+    #accordion-toggle:dir(rtl)::before {
+      rotate: 135deg;
+    }
+
+    #accordion-toggle[aria-expanded="true"]::before {
+      rotate: 45deg;
+    }
+
+    .accordion-content {
+      overflow: hidden;
+      /* Closed state */
+      block-size: 0;
+      /* Removes collapsed content from the accessibility tree and tab order;
+         transitioning visibility keeps it visible until the collapse finishes */
+      visibility: hidden;
+      transition: block-size 0.4s ease-out, visibility 0.4s;
+    }
+
+    .accordion-content.is-open {
+      /* Fallback for browsers without calc-size() support */
+      block-size: auto;
+      /* Natural height plus 2rem of breathing room, animated from 0 */
+      block-size: calc-size(auto, size + 2rem);
+      visibility: visible;
+    }
+
+    .accordion-content-inner {
+      padding: 20px 20px 0;
+    }
+
+    .accordion-content-inner p + p {
+      margin-block-start: 10px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      /* Skip the size animation entirely; the panel jumps open/closed */
+      .accordion-content,
+      #accordion-toggle::before {
+        transition: none;
+      }
+    }
+
