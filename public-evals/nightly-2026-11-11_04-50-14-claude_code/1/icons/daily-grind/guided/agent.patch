+  <script>
+    // Favorite toggles: state lives in aria-pressed (CSS swaps the icon), persisted locally.
+    const STORAGE_KEY = 'dailyGrindFavorites';
+    const saved = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));
+
+    document.querySelectorAll('.favorite-btn').forEach((btn) => {
+      const id = btn.dataset.favorite;
+      btn.setAttribute('aria-pressed', String(saved.has(id)));
+      btn.addEventListener('click', () => {
+        const pressed = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(pressed));
+        pressed ? saved.add(id) : saved.delete(id);
+        localStorage.setItem(STORAGE_KEY, JSON.stringify([...saved]));
+      });
+    });
+  </script>
