+  <script>
+    // Application menu bar (WAI-ARIA menubar pattern): roving tabindex,
+    // arrow-key navigation, Home/End, Escape, typeahead and mouse support.
+    (function () {
+      const menubar = document.querySelector('[role="menubar"]');
+      if (!menubar) return;
+
+      const topItems = Array.from(menubar.querySelectorAll(':scope > li > [role="menuitem"]'));
+      const submenuOf = (item) => document.getElementById(item.getAttribute('aria-controls'));
+      const itemsOf = (menu) => Array.from(menu.querySelectorAll('[role="menuitem"]'));
+      let openItem = null;
+
+      function setActive(item) {
+        topItems.forEach((t) => (t.tabIndex = t === item ? 0 : -1));
+      }
+
+      function openMenu(item, focus) {
+        if (openItem && openItem !== item) closeMenu(false);
+        const menu = submenuOf(item);
+        item.setAttribute('aria-expanded', 'true');
+        menu.hidden = false;
+        openItem = item;
+        setActive(item);
+        const items = itemsOf(menu);
+        if (focus === 'first') items[0].focus();
+        else if (focus === 'last') items[items.length - 1].focus();
+        else item.focus();
+      }
+
+      function closeMenu(returnFocus) {
+        if (!openItem) return;
+        const item = openItem;
+        item.setAttribute('aria-expanded', 'false');
+        submenuOf(item).hidden = true;
+        openItem = null;
+        if (returnFocus) item.focus();
+      }
+
+      function moveTop(from, delta, keepOpen) {
+        const i = topItems.indexOf(from);
+        const next = topItems[(i + delta + topItems.length) % topItems.length];
+        setActive(next);
+        if (keepOpen) openMenu(next, 'first');
+        else next.focus();
+      }
+
+      function typeahead(items, current, char) {
+        const start = items.indexOf(current) + 1;
+        const ordered = items.slice(start).concat(items.slice(0, start));
+        const match = ordered.find((el) => el.textContent.trim().toLowerCase().startsWith(char));
+        if (match) match.focus();
+      }
+
+      setActive(topItems[0]);
+
+      topItems.forEach((item) => {
+        const menu = submenuOf(item);
+        const items = itemsOf(menu);
+        items.forEach((el) => (el.tabIndex = -1));
+
+        item.addEventListener('click', () => {
+          if (openItem === item) closeMenu(true);
+          else openMenu(item);
+        });
+
+        item.addEventListener('mouseenter', () => {
+          if (openItem && openItem !== item) openMenu(item);
+        });
+
+        item.addEventListener('keydown', (e) => {
+          switch (e.key) {
+            case 'ArrowRight': moveTop(item, 1, !!openItem); break;
+            case 'ArrowLeft': moveTop(item, -1, !!openItem); break;
+            case 'ArrowDown':
+            case 'Enter':
+            case ' ': openMenu(item, 'first'); break;
+            case 'ArrowUp': openMenu(item, 'last'); break;
+            case 'Home': closeMenu(false); setActive(topItems[0]); topItems[0].focus(); break;
+            case 'End': {
+              const last = topItems[topItems.length - 1];
+              closeMenu(false); setActive(last); last.focus(); break;
+            }
+            case 'Escape': closeMenu(true); break;
+            default:
+              if (e.key.length === 1 && /\S/.test(e.key) && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                typeahead(topItems, item, e.key.toLowerCase());
+                const focused = document.activeElement;
+                if (topItems.includes(focused)) setActive(focused);
+                break;
+              }
+              return;
+          }
+          e.preventDefault();
+        });
+
+        menu.addEventListener('keydown', (e) => {
+          const current = document.activeElement;
+          const i = items.indexOf(current);
+          switch (e.key) {
+            case 'ArrowDown': items[(i + 1) % items.length].focus(); break;
+            case 'ArrowUp': items[(i - 1 + items.length) % items.length].focus(); break;
+            case 'Home': items[0].focus(); break;
+            case 'End': items[items.length - 1].focus(); break;
+            case 'ArrowRight': moveTop(item, 1, true); break;
+            case 'ArrowLeft': moveTop(item, -1, true); break;
+            case 'Escape': closeMenu(true); break;
+            case 'Tab': closeMenu(false); return;
+            case ' ': current.click(); break;
+            default:
+              if (e.key.length === 1 && /\S/.test(e.key) && !e.ctrlKey && !e.metaKey && !e.altKey) {
+                typeahead(items, current, e.key.toLowerCase());
+                break;
+              }
+              return;
+          }
+          e.preventDefault();
+        });
+      });
+
+      document.addEventListener('pointerdown', (e) => {
+        if (openItem && !menubar.contains(e.target)) closeMenu(false);
+      });
+
+      menubar.addEventListener('focusout', (e) => {
+        if (openItem && e.relatedTarget && !menubar.contains(e.relatedTarget)) closeMenu(false);
+      });
+    })();
+  </script>
+
 </body>
 
