+    /* Application menu bar: one continuous strip, one Tab stop */
+    .menubar {
+      display: flex;
+      background: rgba(255, 255, 255, 0.08);
+      border-radius: 6px;
+      padding: 3px;
+    }
+
+    .menubar-trigger {
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: transparent;
+      border: 0;
+      border-radius: 4px;
+      padding: 6px 14px;
+      cursor: pointer;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+    }
+
+    .menubar-trigger::after {
+      content: "";
+      inline-size: 0.4em;
+      block-size: 0.4em;
+      border-inline-end: 2px solid currentColor;
+      border-block-end: 2px solid currentColor;
+      rotate: 45deg;
+      translate: 0 -0.15em;
+    }
+
+    .menubar-trigger:hover {
+      background: rgba(255, 255, 255, 0.12);
+    }
+
+    .menubar-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 1px;
+    }
+
+    /* The open or previewed menu's title */
+    .menubar-trigger[aria-expanded="true"] {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    /* Menus */
+    .menubar-menu {
+      margin: 0;
+      border: 0;
+      padding: 6px;
+      min-inline-size: 13rem;
+      background: white;
+      color: var(--text);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.12);
+      /* Below the trigger, flipping when it would overflow. Implicit anchor comes from the invoker/source. */
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      inset: auto;
+      margin-block-start: 6px;
+    }
+
+    /* No anchor positioning: script sets viewport-relative left/top */
+    @supports not (position-area: block-end) {
+      .menubar-menu {
+        position: fixed;
+        inset: auto;
+      }
+    }
+
+    .menubar-menu [focusgroup~="menu"] {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .menubar-menu a {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+      padding: 7px 12px;
+      border-radius: 5px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.9rem;
+      white-space: nowrap;
+    }
+
+    .menubar-menu a .hint {
+      margin-inline-start: auto;
+      padding-inline-start: 1.5rem;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .menubar-menu a:hover,
+    .menubar-menu a:focus {
+      background: var(--secondary);
+      outline: none;
+    }
+
+    .menubar-menu a:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: -2px;
+    }
+
+    .menubar-menu hr {
+      border: 0;
+      border-block-start: 1px solid #efebe9;
+      margin: 5px 6px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      /* Closing */
+      .menubar-menu {
+        opacity: 0;
+        translate: 0 -0.25rem;
+        transition: opacity, translate, display, overlay;
+        transition-duration: 0.15s;
+        transition-behavior: allow-discrete;
+      }
+
+      /* Opening */
+      .menubar-menu:is(:popover-open, .\:popover-open) {
+        opacity: 1;
+        translate: 0 0;
+        transition-duration: 0.1s;
+
+        @starting-style {
+          opacity: 0;
+          translate: 0 -0.25rem;
+        }
+      }
+
+      /* Switching between open menubar menus is instant, as in native menubars. */
+      [role="menubar"]:has(> [popover]:is(:popover-open, .\:popover-open)) > [popover] {
+        transition: none;
+      }
+    }
