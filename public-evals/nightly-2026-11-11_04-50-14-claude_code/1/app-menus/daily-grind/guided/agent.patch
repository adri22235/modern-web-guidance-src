+  <script type="module">
+    // Popover polyfill only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    const menubar = document.querySelector('[role="menubar"]');
+    const rootTriggers = [...menubar.querySelectorAll(':scope > [commandfor]')];
+    const menuFor = trigger => document.getElementById(trigger.getAttribute('commandfor'));
+    const triggerFor = menu => rootTriggers.find(trigger => menuFor(trigger) === menu);
+    const isOpen = menu => menu.matches(':is(:popover-open, .\\:popover-open)');
+    const itemsOf = menu => [...menu.querySelectorAll('a[href], button')]
+      .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+    const openMenus = () => rootTriggers.map(menuFor).filter(isOpen);
+    const enterOnOpen = new WeakMap(); // menu -> 'first' | 'last'
+    const pointerOpened = new WeakSet();
+    const hasInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+    const hasAnchorPositioning = CSS.supports('position-area', 'block-end');
+
+    // Ignore focus returning from another window, or switching apps reopens the last menu.
+    let windowReturning = false;
+    addEventListener('blur', () => { windowReturning = true; });
+    addEventListener('focus', () => { setTimeout(() => { windowReturning = false; }); });
+
+    function setTabStop(target) {
+      rootTriggers.forEach(trigger => { trigger.tabIndex = trigger === target ? 0 : -1; });
+    }
+
+    function showMenu(trigger) {
+      const menu = menuFor(trigger);
+      if (!isOpen(menu)) menu.showPopover({ source: trigger });
+    }
+
+    function closeAndRestore(menu, { fromPointer = false } = {}) {
+      const trigger = triggerFor(menu);
+      trigger.focus({ preventScroll: true, focusVisible: !fromPointer });
+      if (isOpen(menu)) menu.hidePopover();
+    }
+
+    // Focus moves first, so hiding never triggers the browser's own focus restoration.
+    function moveToRootTrigger(from, direction) {
+      const next = rootTriggers[(rootTriggers.indexOf(from) + direction + rootTriggers.length) % rootTriggers.length];
+      setTabStop(next);
+      next.focus({ preventScroll: true }); // Focusing the trigger previews its menu.
+      openMenus().filter(menu => menu !== menuFor(next)).forEach(menu => menu.hidePopover());
+    }
+
+    // Tab leaves the bar: park focus on the active trigger, close everything, let Tab continue.
+    function leaveOnTab(trigger) {
+      setTabStop(trigger);
+      trigger.focus({ preventScroll: true });
+      openMenus().forEach(menu => menu.hidePopover());
+    }
+
+    function focusItem(menu, which) {
+      const items = itemsOf(menu);
+      items[which === 'last' ? items.length - 1 : 0]?.focus({ preventScroll: true });
+    }
+
+    // Fallback placement where CSS anchor positioning is unavailable.
+    function placeMenu(menu, trigger, measure) {
+      const gap = 6, edge = 8;
+      const anchor = trigger.getBoundingClientRect();
+      let left = anchor.left;
+      let top = anchor.bottom + gap;
+      if (measure) {
+        const box = menu.getBoundingClientRect();
+        if (left + box.width > innerWidth - edge) left = Math.max(edge, anchor.right - box.width);
+        if (top + box.height > innerHeight - edge && anchor.top - gap - box.height >= edge) {
+          top = anchor.top - gap - box.height;
+        }
+      }
+      Object.assign(menu.style, { left: `${left}px`, top: `${top}px`, margin: '0' });
+    }
+
+    rootTriggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+
+      // Preview on focus.
+      trigger.addEventListener('focus', () => {
+        setTabStop(trigger);
+        if (windowReturning) return;
+        showMenu(trigger);
+      });
+
+      // A preview closes when focus leaves the trigger, unless it moved into the menu.
+      trigger.addEventListener('blur', event => {
+        if (windowReturning || menu.contains(event.relatedTarget)) return;
+        if (isOpen(menu)) menu.hidePopover();
+      });
+
+      // Pointer clicks must not move focus; the toggle handler focuses the trigger ringlessly.
+      trigger.addEventListener('pointerdown', event => {
+        if (event.button === 0) event.preventDefault();
+      });
+
+      // With a menu open, hovering another title switches to it.
+      // Touch is excluded: the tap that follows would immediately toggle the previewed menu closed.
+      trigger.addEventListener('pointerenter', event => {
+        if (event.pointerType === 'touch' || isOpen(menu) || !openMenus().length) return;
+        trigger.focus({ preventScroll: true, focusVisible: false });
+        openMenus().filter(other => other !== menu).forEach(other => other.hidePopover());
+      });
+
+      trigger.addEventListener('click', event => {
+        const fromPointer = event.detail > 0;
+        if (!isOpen(menu)) {
+          if (fromPointer) pointerOpened.add(menu);
+          else if (!enterOnOpen.has(menu)) enterOnOpen.set(menu, 'first');
+        }
+        if (hasInvokers) return; // The native toggle-popover command does the rest.
+        event.preventDefault();
+        if (isOpen(menu)) closeAndRestore(menu, { fromPointer });
+        else menu.showPopover({ source: trigger });
+      });
+
+      trigger.addEventListener('keydown', event => {
+        switch (event.key) {
+          case 'ArrowRight':
+          case 'ArrowLeft':
+            event.preventDefault();
+            moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+            break;
+          case 'ArrowDown':
+          case 'ArrowUp': {
+            event.preventDefault();
+            const which = event.key === 'ArrowDown' ? 'first' : 'last';
+            if (isOpen(menu)) focusItem(menu, which);
+            else { enterOnOpen.set(menu, which); trigger.click(); }
+            break;
+          }
+          case 'Home':
+          case 'End':
+            event.preventDefault();
+            showMenu(trigger);
+            focusItem(menu, event.key === 'Home' ? 'first' : 'last');
+            break;
+          case 'Tab':
+            leaveOnTab(trigger);
+            break;
+        }
+      });
+
+      menu.addEventListener('beforetoggle', event => {
+        if (event.newState === 'open' && !hasAnchorPositioning) placeMenu(menu, trigger, false);
+      });
+
+      // aria-expanded and focus entry happen once the menu is actually open.
+      menu.addEventListener('toggle', event => {
+        const open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', String(open));
+        if (!open) {
+          enterOnOpen.delete(menu);
+          pointerOpened.delete(menu);
+          return;
+        }
+        if (!hasAnchorPositioning) placeMenu(menu, trigger, true);
+        if (enterOnOpen.has(menu)) {
+          focusItem(menu, enterOnOpen.get(menu));
+          enterOnOpen.delete(menu);
+        } else if (pointerOpened.has(menu)) {
+          trigger.focus({ preventScroll: true, focusVisible: false });
+        }
+        pointerOpened.delete(menu);
+      });
+
+      menu.addEventListener('keydown', event => {
+        switch (event.key) {
+          case 'Escape':
+            event.preventDefault();
+            event.stopPropagation();
+            closeAndRestore(menu);
+            break;
+          case 'ArrowRight':
+          case 'ArrowLeft':
+            event.preventDefault();
+            moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+            break;
+          case 'Tab':
+            leaveOnTab(trigger);
+            break;
+        }
+      });
+
+      // Hover follows focus.
+      menu.addEventListener('pointermove', event => {
+        const item = event.target.closest('a[href], button');
+        if (item && menu.contains(item) && document.activeElement !== item) {
+          item.focus({ preventScroll: true, focusVisible: false });
+        }
+      });
+
+      // Choosing a destination closes the menu before navigating.
+      menu.addEventListener('click', event => {
+        if (!event.target.closest('a[href]')) return;
+        closeAndRestore(menu, { fromPointer: event.detail > 0 });
+      });
+    });
+
+    // Focus landing outside the menu bar closes every menu.
+    document.addEventListener('focusin', event => {
+      if (!menubar.contains(event.target)) openMenus().forEach(menu => menu.hidePopover());
+    });
+
+    // focusgroup fallback: arrow keys, Home/End and menu roles where it isn't supported natively.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      menubar.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.setAttribute('role', 'menu');
+        group.querySelectorAll('a[href]:not([role]), button:not([role])').forEach(item => {
+          item.setAttribute('role', 'menuitem');
+        });
+        group.addEventListener('keydown', event => {
+          if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+          const items = itemsOf(group).filter(item => item.closest('[focusgroup]') === group);
+          const current = items.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+            (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          items[next].focus({ preventScroll: true });
+        }, true);
+      });
+    }
+  </script>
+
 </body>
 
