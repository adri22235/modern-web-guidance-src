+++ b/server/aaguid.js
@@ -0,0 +1,58 @@
+// AAGUID -> passkey provider name/icon lookup.
+// AAGUIDs are UX hints only (not attested for platform passkeys) — never use them for access decisions.
+import { readFile, writeFile, mkdir } from 'node:fs/promises';
+import { dirname } from 'node:path';
+
+const REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+/** @type {Record<string, { name: string, icon_light?: string, icon_dark?: string }>} */
+let registry = {};
+
+/** Load the cached registry, then refresh it from the network in the background. */
+export async function loadAaguidRegistry(cacheFile) {
+  try {
+    registry = JSON.parse(await readFile(cacheFile, 'utf8'));
+  } catch {
+    // No cache yet.
+  }
+  try {
+    const res = await fetch(REGISTRY_URL, { signal: AbortSignal.timeout(15_000) });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    const fresh = await res.json();
+    registry = fresh;
+    await mkdir(dirname(cacheFile), { recursive: true });
+    await writeFile(cacheFile, JSON.stringify(fresh));
+  } catch (err) {
+    console.warn('AAGUID registry refresh failed; using cached copy if present.', err.message);
+  }
+}
+
+/** Derive a readable fallback label from the user agent when the AAGUID is unknown/zeroed. */
+function deviceLabelFromUserAgent(ua = '') {
+  const os =
+    /iPhone|iPad/.test(ua) ? 'iOS' :
+    /Android/.test(ua) ? 'Android' :
+    /Mac OS X/.test(ua) ? 'macOS' :
+    /Windows/.test(ua) ? 'Windows' :
+    /CrOS/.test(ua) ? 'ChromeOS' :
+    /Linux/.test(ua) ? 'Linux' : '';
+  return os ? `Passkey on ${os}` : 'Unknown passkey provider';
+}
+
+/**
+ * @param {string} aaguid
+ * @param {string} [userAgent]
+ * @returns {{ name: string, providerIcon?: string }}
+ */
+export function describeAuthenticator(aaguid, userAgent) {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: deviceLabelFromUserAgent(userAgent), providerIcon: undefined };
+  }
+  const provider = registry[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
diff --git a/server/db.js b/server/db.js
new file mode 100644
index 0000000..648f859
--- /dev/null
+++ b/server/db.js
@@ -0,0 +1,96 @@
+// Minimal JSON-file persistence for customers and their passkeys.
+// Swap for a real database in production; the shape mirrors the tables you'd need.
+import { readFileSync, writeFileSync, renameSync, mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+
+/**
+ * @typedef {object} User
+ * @property {string} id               Internal account ID
+ * @property {string} passkeyUserId    Unpadded Base64URL WebAuthn user handle (user.id)
+ * @property {string} email            Username (WebAuthn user.name)
+ * @property {string} displayName      WebAuthn user.displayName
+ * @property {string} passwordHash     scrypt hash ("salt:hash", both base64url)
+ * @property {number} createdAt
+ *
+ * @typedef {object} StoredPasskeyCredential
+ * @property {string} id                     Base64URL credential ID
+ * @property {string} passkeyUserId          Owning application user ID (User.id)
+ * @property {string} credentialPublicKey    Base64URL COSE public key
+ * @property {'public-key'} credentialType
+ * @property {'singleDevice'|'multiDevice'} credentialDeviceType
+ * @property {boolean} credentialBackedUp
+ * @property {string} aaguid
+ * @property {string} [providerIcon]
+ * @property {string} name
+ * @property {string[]} transports
+ * @property {number} [lastUsedAt]
+ * @property {number} registeredAt
+ * @property {number} counter
+ */
+
+export class Database {
+  /** @param {string} file */
+  constructor(file) {
+    this.file = file;
+    /** @type {{ users: User[], credentials: StoredPasskeyCredential[] }} */
+    this.data = { users: [], credentials: [] };
+    try {
+      this.data = JSON.parse(readFileSync(file, 'utf8'));
+    } catch (err) {
+      if (err.code !== 'ENOENT') throw err;
+    }
+  }
+
+  #save() {
+    mkdirSync(dirname(this.file), { recursive: true });
+    const tmp = `${this.file}.tmp`;
+    writeFileSync(tmp, JSON.stringify(this.data, null, 2));
+    renameSync(tmp, this.file);
+  }
+
+  // Users
+  findUserById(id) {
+    return this.data.users.find((u) => u.id === id);
+  }
+
+  findUserByEmail(email) {
+    const needle = email.toLowerCase();
+    return this.data.users.find((u) => u.email.toLowerCase() === needle);
+  }
+
+  createUser(user) {
+    this.data.users.push(user);
+    this.#save();
+    return user;
+  }
+
+  updateUser(id, patch) {
+    const user = this.findUserById(id);
+    if (!user) return undefined;
+    Object.assign(user, patch);
+    this.#save();
+    return user;
+  }
+
+  // Credentials
+  findCredentialById(id) {
+    return this.data.credentials.find((c) => c.id === id);
+  }
+
+  findCredentialsByUserId(userId) {
+    return this.data.credentials.filter((c) => c.passkeyUserId === userId);
+  }
+
+  saveCredential(cred) {
+    const i = this.data.credentials.findIndex((c) => c.id === cred.id);
+    if (i === -1) this.data.credentials.push(cred);
+    else this.data.credentials[i] = cred;
+    this.#save();
+    return cred;
+  }
+
+  deleteCredential(id) {
+    this.data.credentials = this.data.credentials.filter((c) => c.id !== id);
+    this.#save();
+  }
+}
diff --git a/server/index.js b/server/index.js
new file mode 100644
index 0000000..f8f8291
--- /dev/null
+++ b/server/index.js
@@ -0,0 +1,624 @@
+// The Daily Grind web server: static site + customer account and passkey (WebAuthn) API.
+//
+// Configuration (env):
+//   PORT    Port to listen on (default 11222)
+//   ORIGIN  Exact public origin users load the site from (default http://localhost:PORT)
+//   RP_ID   WebAuthn Relying Party ID — the site's registrable domain (default: ORIGIN's hostname)
+//   DATA_DIR  Where account data is persisted (default ./data)
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes, randomUUID, scrypt, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+import { extname, join, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateAuthenticationOptions,
+  generateRegistrationOptions,
+  verifyAuthenticationResponse,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import { Database } from './db.js';
+import { describeAuthenticator, loadAaguidRegistry } from './aaguid.js';
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url));
+const PUBLIC_DIR = join(ROOT, 'public');
+const DATA_DIR = resolve(process.env.DATA_DIR || join(ROOT, 'data'));
+
+const PORT = Number(process.env.PORT || 11222);
+const ORIGIN = (process.env.ORIGIN || `http://localhost:${PORT}`).replace(/\/$/, '');
+// Predefined RP ID constant. Clients always read it back from server responses
+// (never from window.location.hostname).
+const RP_ID = process.env.RP_ID || new URL(ORIGIN).hostname;
+const RP_NAME = 'The Daily Grind';
+const SECURE_COOKIES = ORIGIN.startsWith('https://');
+
+const SESSION_COOKIE = 'dg_sid';
+const SESSION_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+const REAUTH_WINDOW_MS = 5 * 60 * 1000; // Sensitive actions need authentication within this window.
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+const db = new Database(join(DATA_DIR, 'db.json'));
+loadAaguidRegistry(join(DATA_DIR, 'aaguids.json'));
+
+// ---------------------------------------------------------------------------
+// Sessions (in-memory; use a shared store in production)
+// ---------------------------------------------------------------------------
+
+/**
+ * @typedef {object} Session
+ * @property {string} [userId]
+ * @property {number} [authAt]           Last time the user proved their identity
+ * @property {{ challenge: string, uv: string, expires: number }} [signin]
+ * @property {{ challenge: string, uv: string, expires: number }} [reauth]
+ * @property {{ challenge: string, conditional: boolean, expires: number }} [registration]
+ * @property {number} lastSeen
+ */
+
+/** @type {Map<string, Session>} */
+const sessions = new Map();
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, s] of sessions) if (now - s.lastSeen > SESSION_TTL_MS) sessions.delete(sid);
+}, 60 * 60 * 1000).unref();
+
+function parseCookies(header = '') {
+  return Object.fromEntries(
+    header.split(';').map((p) => p.trim().split('=')).filter(([k, v]) => k && v).map(([k, v]) => [k, decodeURIComponent(v)]),
+  );
+}
+
+function setSessionCookie(res, sid, maxAgeMs) {
+  const parts = [
+    `${SESSION_COOKIE}=${sid}`,
+    'Path=/',
+    'HttpOnly',
+    'SameSite=Lax',
+    `Max-Age=${Math.floor(maxAgeMs / 1000)}`,
+  ];
+  if (SECURE_COOKIES) parts.push('Secure');
+  res.setHeader('Set-Cookie', parts.join('; '));
+}
+
+function getSession(req, res) {
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  let session = sid && sessions.get(sid);
+  if (session && Date.now() - session.lastSeen > SESSION_TTL_MS) {
+    sessions.delete(sid);
+    session = undefined;
+  }
+  if (!session) {
+    const newSid = randomBytes(32).toString('base64url');
+    session = { lastSeen: Date.now() };
+    sessions.set(newSid, session);
+    setSessionCookie(res, newSid, SESSION_TTL_MS);
+    req.sid = newSid;
+  } else {
+    req.sid = sid;
+  }
+  session.lastSeen = Date.now();
+  return session;
+}
+
+/** Issue a fresh session ID on sign-in to prevent session fixation. */
+function signIn(req, res, userId) {
+  sessions.delete(req.sid);
+  const sid = randomBytes(32).toString('base64url');
+  const session = { userId, authAt: Date.now(), lastSeen: Date.now() };
+  sessions.set(sid, session);
+  setSessionCookie(res, sid, SESSION_TTL_MS);
+  req.sid = sid;
+  return session;
+}
+
+function signOut(req, res) {
+  sessions.delete(req.sid);
+  setSessionCookie(res, '', 0);
+}
+
+// ---------------------------------------------------------------------------
+// Passwords
+// ---------------------------------------------------------------------------
+
+const scryptAsync = promisify(scrypt);
+const DUMMY_HASH = `${randomBytes(16).toString('base64url')}:${randomBytes(64).toString('base64url')}`;
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const hash = await scryptAsync(password.normalize('NFKC'), salt, 64);
+  return `${salt.toString('base64url')}:${hash.toString('base64url')}`;
+}
+
+async function verifyPassword(password, stored = DUMMY_HASH) {
+  const [salt, expected] = stored.split(':').map((p) => Buffer.from(p, 'base64url'));
+  const actual = await scryptAsync(password.normalize('NFKC'), salt, 64);
+  return timingSafeEqual(actual, expected);
+}
+
+// Simple failed-attempt limiter for password checks.
+const failures = new Map();
+const MAX_FAILURES = 10;
+const FAILURE_WINDOW_MS = 15 * 60 * 1000;
+
+function isRateLimited(key) {
+  const entry = failures.get(key);
+  if (!entry) return false;
+  if (Date.now() - entry.first > FAILURE_WINDOW_MS) {
+    failures.delete(key);
+    return false;
+  }
+  return entry.count >= MAX_FAILURES;
+}
+
+function recordFailure(key) {
+  const entry = failures.get(key);
+  if (!entry || Date.now() - entry.first > FAILURE_WINDOW_MS) failures.set(key, { count: 1, first: Date.now() });
+  else entry.count++;
+}
+
+// ---------------------------------------------------------------------------
+// HTTP helpers
+// ---------------------------------------------------------------------------
+
+class HttpError extends Error {
+  constructor(status, code, message = code) {
+    super(message);
+    this.status = status;
+    this.code = code;
+  }
+}
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+async function readJson(req) {
+  if (!/^application\/json\b/i.test(req.headers['content-type'] || '')) {
+    throw new HttpError(415, 'unsupported_media_type', 'Expected application/json.');
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 64 * 1024) throw new HttpError(413, 'payload_too_large');
+    chunks.push(chunk);
+  }
+  try {
+    return JSON.parse(Buffer.concat(chunks).toString('utf8') || '{}');
+  } catch {
+    throw new HttpError(400, 'invalid_json');
+  }
+}
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function cleanEmail(value) {
+  const email = typeof value === 'string' ? value.trim() : '';
+  if (!EMAIL_RE.test(email) || email.length > 254) throw new HttpError(400, 'invalid_email', 'Enter a valid email address.');
+  return email;
+}
+
+function cleanName(value, field = 'name') {
+  const name = typeof value === 'string' ? value.trim().replace(/\s+/g, ' ') : '';
+  if (!name || name.length > 64) throw new HttpError(400, `invalid_${field}`, 'Enter a name between 1 and 64 characters.');
+  return name;
+}
+
+function cleanPassword(value) {
+  if (typeof value !== 'string' || value.length < 8 || value.length > 256) {
+    throw new HttpError(400, 'invalid_password', 'Passwords must be at least 8 characters.');
+  }
+  return value;
+}
+
+function requireUser(session) {
+  const user = session.userId && db.findUserById(session.userId);
+  if (!user) throw new HttpError(401, 'signed_out', 'Please sign in.');
+  return user;
+}
+
+function requireRecentAuth(session) {
+  const user = requireUser(session);
+  if (!session.authAt || Date.now() - session.authAt > REAUTH_WINDOW_MS) {
+    throw new HttpError(401, 'reauth_required', 'Please confirm it’s you to continue.');
+  }
+  return user;
+}
+
+function takeChallenge(session, key) {
+  const pending = session[key];
+  delete session[key]; // Challenges are single-use.
+  if (!pending || pending.expires < Date.now()) {
+    throw new HttpError(400, 'challenge_expired', 'This request expired. Please try again.');
+  }
+  return pending;
+}
+
+function publicUser(user) {
+  return {
+    email: user.email,
+    displayName: user.displayName,
+    createdAt: user.createdAt,
+    passkeyCount: db.findCredentialsByUserId(user.id).length,
+  };
+}
+
+function publicCredential(cred) {
+  const { id, name, aaguid, providerIcon, registeredAt, lastUsedAt, credentialDeviceType, credentialBackedUp, transports } = cred;
+  return { id, name, aaguid, providerIcon, registeredAt, lastUsedAt, credentialDeviceType, credentialBackedUp, transports };
+}
+
+function toWebAuthnCredential(cred) {
+  return {
+    id: cred.id,
+    publicKey: Buffer.from(cred.credentialPublicKey, 'base64url'),
+    counter: cred.counter,
+    transports: cred.transports,
+  };
+}
+
+/** Verify an assertion against a stored credential and update its usage metadata. */
+async function verifyAssertion(response, cred, pending) {
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: ORIGIN,
+      expectedRPID: RP_ID,
+      credential: toWebAuthnCredential(cred),
+      // 'preferred' must not reject authenticators that skip UV; 'required' is enforced strictly.
+      requireUserVerification: pending.uv === 'required',
+    });
+  } catch (err) {
+    throw new HttpError(400, 'verification_failed', err.message);
+  }
+  if (!verification.verified) throw new HttpError(400, 'verification_failed', 'Passkey could not be verified.');
+  const info = verification.authenticationInfo;
+  db.saveCredential({
+    ...cred,
+    counter: info.newCounter,
+    credentialBackedUp: info.credentialBackedUp,
+    credentialDeviceType: info.credentialDeviceType,
+    lastUsedAt: Date.now(),
+  });
+}
+
+// ---------------------------------------------------------------------------
+// API routes
+// ---------------------------------------------------------------------------
+
+/** @type {Record<string, (ctx: { req: any, res: any, session: Session, params: string[] }) => Promise<[number, any]>>} */
+const routes = {
+  'GET /api/session': async ({ session }) => {
+    const user = session.userId && db.findUserById(session.userId);
+    return [200, { user: user ? publicUser(user) : null }];
+  },
+
+  // --- Customer registration & password sign-in ---------------------------
+
+  'POST /api/account': async ({ req, res }) => {
+    const body = await readJson(req);
+    const email = cleanEmail(body.email);
+    const displayName = cleanName(body.displayName, 'display_name');
+    const password = cleanPassword(body.password);
+    if (db.findUserByEmail(email)) {
+      throw new HttpError(409, 'email_taken', 'An account with this email already exists. Try signing in.');
+    }
+    const user = db.createUser({
+      id: randomUUID(),
+      passkeyUserId: randomBytes(32).toString('base64url'),
+      email,
+      displayName,
+      passwordHash: await hashPassword(password),
+      createdAt: Date.now(),
+    });
+    signIn(req, res, user.id);
+    return [201, { user: publicUser(user) }];
+  },
+
+  'POST /api/signin/password': async ({ req, res }) => {
+    const body = await readJson(req);
+    const email = typeof body.email === 'string' ? body.email.trim() : '';
+    const password = typeof body.password === 'string' ? body.password : '';
+    const limiterKey = `${req.socket.remoteAddress}|${email.toLowerCase()}`;
+    if (isRateLimited(limiterKey)) {
+      throw new HttpError(429, 'rate_limited', 'Too many attempts. Please wait a few minutes and try again.');
+    }
+    const user = email && db.findUserByEmail(email);
+    const ok = await verifyPassword(password, user?.passwordHash);
+    if (!user || !ok) {
+      recordFailure(limiterKey);
+      throw new HttpError(401, 'invalid_credentials', 'That email and password don’t match our records.');
+    }
+    failures.delete(limiterKey);
+    signIn(req, res, user.id);
+    return [200, { user: publicUser(user) }];
+  },
+
+  'POST /api/logout': async ({ req, res }) => {
+    signOut(req, res);
+    return [200, { ok: true }];
+  },
+
+  // --- Passkey sign-in (discoverable credentials) -------------------------
+
+  'POST /api/signin/passkey/options': async ({ session }) => {
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      allowCredentials: [], // Discoverable: the passkey provider lists available accounts.
+      userVerification: 'preferred',
+    });
+    // Persist expected UV server-side so the client can't downgrade it.
+    session.signin = { challenge: options.challenge, uv: 'preferred', expires: Date.now() + CHALLENGE_TTL_MS };
+    return [200, { ...options, rpId: RP_ID }];
+  },
+
+  'POST /api/signin/passkey/verify': async ({ req, res, session }) => {
+    const response = await readJson(req);
+    const pending = takeChallenge(session, 'signin');
+    const cred = typeof response.id === 'string' && db.findCredentialById(response.id);
+    if (!cred) throw new HttpError(404, 'credential_not_found', 'This passkey is no longer registered with The Daily Grind.');
+    const user = db.findUserById(cred.passkeyUserId);
+    if (!user) throw new HttpError(404, 'credential_not_found', 'This passkey is no longer registered with The Daily Grind.');
+    const userHandle = response.response?.userHandle;
+    if (userHandle && userHandle !== user.passkeyUserId) {
+      throw new HttpError(400, 'verification_failed', 'Passkey does not belong to this account.');
+    }
+    await verifyAssertion(response, cred, pending);
+    signIn(req, res, user.id);
+    return [200, { user: publicUser(user) }];
+  },
+
+  // --- Passkey registration (signed-in customers) -------------------------
+
+  'POST /api/passkeys/register/options': async ({ req, session }) => {
+    const body = await readJson(req);
+    const user = requireRecentAuth(session);
+    const conditional = body.conditional === true;
+    // Promotions (post-signup prompt / post-password conditional create) target the platform
+    // authenticator; the management panel also allows security keys.
+    const platformOnly = conditional || body.promotion === true;
+    const existing = db.findCredentialsByUserId(user.id);
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID: RP_ID,
+      userName: user.email,
+      userDisplayName: user.displayName,
+      userID: Buffer.from(user.passkeyUserId, 'base64url'),
+      attestationType: 'none',
+      excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        ...(platformOnly && { authenticatorAttachment: 'platform' }),
+      },
+      supportedAlgorithmIDs: [-7, -257],
+    });
+    session.registration = { challenge: options.challenge, conditional, expires: Date.now() + CHALLENGE_TTL_MS };
+    return [200, options];
+  },
+
+  'POST /api/passkeys/register/verify': async ({ req, session }) => {
+    const response = await readJson(req);
+    const user = requireUser(session);
+    const pending = takeChallenge(session, 'registration');
+    let verification;
+    try {
+      verification = await verifyRegistrationResponse({
+        response,
+        expectedChallenge: pending.challenge,
+        expectedOrigin: ORIGIN,
+        expectedRPID: RP_ID,
+        // Conditional create may legitimately omit user presence; explicit creation must not.
+        requireUserPresence: !pending.conditional,
+        // Options asked for 'preferred', so don't reject authenticators without UV.
+        requireUserVerification: false,
+      });
+    } catch (err) {
+      throw new HttpError(400, 'verification_failed', err.message);
+    }
+    if (!verification.verified) throw new HttpError(400, 'verification_failed', 'Passkey could not be verified.');
+    const info = verification.registrationInfo;
+    if (db.findCredentialById(info.credential.id)) {
+      throw new HttpError(409, 'credential_exists', 'This passkey is already registered.');
+    }
+    const { name, providerIcon } = describeAuthenticator(info.aaguid, req.headers['user-agent']);
+    const cred = db.saveCredential({
+      id: info.credential.id,
+      passkeyUserId: user.id,
+      credentialPublicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType: info.credentialDeviceType,
+      credentialBackedUp: info.credentialBackedUp,
+      aaguid: info.aaguid,
+      providerIcon,
+      name,
+      transports: info.credential.transports || response.response?.transports || [],
+      registeredAt: Date.now(),
+      counter: info.credential.counter,
+    });
+    return [201, { credential: publicCredential(cred) }];
+  },
+
+  // --- Passkey management --------------------------------------------------
+
+  'GET /api/passkeys': async ({ session }) => {
+    const user = requireUser(session);
+    const credentials = db
+      .findCredentialsByUserId(user.id)
+      .sort((a, b) => b.registeredAt - a.registeredAt)
+      .map(publicCredential);
+    return [200, { rpId: RP_ID, userId: user.passkeyUserId, credentials }];
+  },
+
+  'PUT /api/passkeys/:id': async ({ req, session, params }) => {
+    const body = await readJson(req);
+    const user = requireUser(session);
+    const cred = db.findCredentialById(params[0]);
+    if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, 'credential_not_found', 'Passkey not found.');
+    cred.name = cleanName(body.name);
+    db.saveCredential(cred);
+    return [200, { credential: publicCredential(cred) }];
+  },
+
+  'DELETE /api/passkeys/:id': async ({ session, params }) => {
+    const user = requireRecentAuth(session);
+    const cred = db.findCredentialById(params[0]);
+    if (!cred || cred.passkeyUserId !== user.id) throw new HttpError(404, 'credential_not_found', 'Passkey not found.');
+    db.deleteCredential(cred.id);
+    return [200, { ok: true }];
+  },
+
+  // --- Profile -------------------------------------------------------------
+
+  'PUT /api/user': async ({ req, session }) => {
+    const body = await readJson(req);
+    const user = requireRecentAuth(session);
+    const email = cleanEmail(body.email);
+    const displayName = cleanName(body.displayName, 'display_name');
+    const clash = db.findUserByEmail(email);
+    if (clash && clash.id !== user.id) throw new HttpError(409, 'email_taken', 'That email is already used by another account.');
+    const updated = db.updateUser(user.id, { email, displayName });
+    return [200, { user: publicUser(updated), rpId: RP_ID, userId: updated.passkeyUserId }];
+  },
+
+  // --- Reauthentication ----------------------------------------------------
+
+  'POST /api/reauth/options': async ({ session }) => {
+    const user = requireUser(session);
+    const passkeys = db.findCredentialsByUserId(user.id);
+    if (passkeys.length === 0) throw new HttpError(409, 'no_passkeys', 'No passkeys registered.');
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      // Restrict the prompt to this customer's own passkeys (never discoverable here).
+      allowCredentials: passkeys.map((c) => ({ id: c.id, transports: c.transports })),
+      userVerification: 'required',
+    });
+    session.reauth = { challenge: options.challenge, uv: 'required', expires: Date.now() + CHALLENGE_TTL_MS };
+    return [200, { ...options, rpId: RP_ID }];
+  },
+
+  'POST /api/reauth/verify': async ({ req, session }) => {
+    const response = await readJson(req);
+    const user = requireUser(session);
+    const pending = takeChallenge(session, 'reauth');
+    const cred = typeof response.id === 'string' && db.findCredentialById(response.id);
+    if (!cred) throw new HttpError(404, 'credential_not_found', 'This passkey is no longer registered.');
+    if (cred.passkeyUserId !== user.id) {
+      throw new HttpError(403, 'wrong_account', 'That passkey belongs to a different account.');
+    }
+    await verifyAssertion(response, cred, pending);
+    session.authAt = Date.now();
+    return [200, { ok: true }];
+  },
+
+  'POST /api/reauth/password': async ({ req, session }) => {
+    const body = await readJson(req);
+    const user = requireUser(session);
+    const limiterKey = `${req.socket.remoteAddress}|${user.email.toLowerCase()}`;
+    if (isRateLimited(limiterKey)) throw new HttpError(429, 'rate_limited', 'Too many attempts. Please wait a few minutes.');
+    if (!(await verifyPassword(typeof body.password === 'string' ? body.password : '', user.passwordHash))) {
+      recordFailure(limiterKey);
+      throw new HttpError(401, 'invalid_credentials', 'Incorrect password.');
+    }
+    failures.delete(limiterKey);
+    session.authAt = Date.now();
+    return [200, { ok: true }];
+  },
+};
+
+function matchRoute(method, pathname) {
+  for (const key of Object.keys(routes)) {
+    const [m, pattern] = key.split(' ');
+    if (m !== method) continue;
+    const re = new RegExp(`^${pattern.replace(/:[a-z]+/g, '([A-Za-z0-9_-]+)')}$`);
+    const match = pathname.match(re);
+    if (match) return { handler: routes[key], params: match.slice(1) };
+  }
+  return null;
+}
+
+// ---------------------------------------------------------------------------
+// Static files
+// ---------------------------------------------------------------------------
+
+const PAGES = { '/': 'index.html', '/account': 'account.html' };
+const MIME = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.ico': 'image/x-icon',
+  '.json': 'application/json; charset=utf-8',
+};
+
+async function serveStatic(req, res, pathname) {
+  const rel = PAGES[pathname] || pathname.slice(1);
+  const file = resolve(PUBLIC_DIR, rel);
+  if (!file.startsWith(PUBLIC_DIR + sep) || !MIME[extname(file)]) return false;
+  try {
+    const body = await readFile(file);
+    res.writeHead(200, {
+      'Content-Type': MIME[extname(file)],
+      'Cache-Control': extname(file) === '.html' ? 'no-cache' : 'public, max-age=300',
+    });
+    res.end(req.method === 'HEAD' ? undefined : body);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Server
+// ---------------------------------------------------------------------------
+
+const server = createServer(async (req, res) => {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Content-Security-Policy',
+    "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; " +
+      "img-src 'self' data: https://images.unsplash.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'",
+  );
+
+  const { pathname } = new URL(req.url, ORIGIN);
+
+  try {
+    if (pathname.startsWith('/api/')) {
+      const route = matchRoute(req.method, pathname);
+      if (!route) throw new HttpError(404, 'not_found');
+      // CSRF defence: state-changing API calls must come from our own origin.
+      if (req.method !== 'GET' && req.headers.origin !== ORIGIN) {
+        throw new HttpError(403, 'bad_origin', 'Cross-origin request rejected.');
+      }
+      const session = getSession(req, res);
+      const [status, body] = await route.handler({ req, res, session, params: route.params });
+      return sendJson(res, status, body);
+    }
+
+    if (pathname === '/logout' && req.method === 'GET') {
+      getSession(req, res);
+      signOut(req, res);
+      res.writeHead(303, { Location: '/' });
+      return res.end();
+    }
+
+    if ((req.method === 'GET' || req.method === 'HEAD') && (await serveStatic(req, res, pathname))) return;
+
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not found');
+  } catch (err) {
+    if (err instanceof HttpError) return sendJson(res, err.status, { error: err.code, message: err.message });
+    console.error(err);
+    sendJson(res, 500, { error: 'server_error', message: 'Something went wrong. Please try again.' });
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind running at ${ORIGIN} (RP ID: ${RP_ID})`);
+});
