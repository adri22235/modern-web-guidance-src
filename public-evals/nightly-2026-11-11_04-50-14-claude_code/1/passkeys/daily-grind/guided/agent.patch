diff --git a/public/js/account.js b/public/js/account.js
new file mode 100644
index 0000000..38684f3
--- /dev/null
+++ b/public/js/account.js
@@ -0,0 +1,529 @@
+// "My Account": customer registration, sign-in (password + passkeys), passkey management,
+// profile updates and reauthentication.
+import {
+  ApiError,
+  CANCELLED,
+  api,
+  authenticateWithPasskey,
+  getCapabilities,
+  registerPasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+} from './webauthn.js';
+
+const $ = (id) => document.getElementById(id);
+
+const views = {
+  signin: $('signin-view'),
+  register: $('register-view'),
+  promo: $('promo-view'),
+  account: $('account-view'),
+};
+
+const state = {
+  /** @type {null | { email: string, displayName: string, createdAt: number, passkeyCount: number }} */
+  user: null,
+  /** @type {Record<string, boolean | undefined>} */
+  caps: {},
+  /** Controller for the pending conditional-mediation (autofill) request. */
+  autofill: new AbortController(),
+};
+
+const hasWebAuthn = () => typeof window.PublicKeyCredential === 'function';
+const canCreatePasskeys = () => hasWebAuthn() && Boolean(state.caps.passkeyPlatformAuthenticator);
+
+// ---------------------------------------------------------------------------
+// UI helpers
+// ---------------------------------------------------------------------------
+
+function showView(name) {
+  $('loading').hidden = true;
+  for (const [key, el] of Object.entries(views)) el.hidden = key !== name;
+  for (const el of document.querySelectorAll('[data-signed-in]')) el.hidden = !state.user;
+  const titles = {
+    signin: 'Sign in',
+    register: 'Create your account',
+    promo: 'Create a passkey',
+    account: 'My Account',
+  };
+  document.title = `${titles[name]} | The Daily Grind`;
+}
+
+let toastTimer;
+function toast(message) {
+  const el = $('toast');
+  el.textContent = message;
+  el.classList.add('visible');
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => el.classList.remove('visible'), 6000);
+}
+
+function showError(id, err) {
+  const el = $(id);
+  if (!err) {
+    el.textContent = '';
+    return;
+  }
+  if (!(err instanceof ApiError)) console.error(err);
+  el.textContent = err instanceof ApiError ? err.message : 'Something went wrong. Please try again.';
+}
+
+/** Disable a button while an async action runs. */
+async function busy(button, fn) {
+  button.disabled = true;
+  button.setAttribute('aria-busy', 'true');
+  try {
+    return await fn();
+  } finally {
+    button.disabled = false;
+    button.removeAttribute('aria-busy');
+  }
+}
+
+/** Resolve with the dialog's returnValue once it closes ('' when dismissed with Esc). */
+function dialogResult(dialog) {
+  return new Promise((resolve) => {
+    dialog.addEventListener(
+      'close',
+      () => {
+        const value = dialog.returnValue;
+        dialog.returnValue = '';
+        resolve(value);
+      },
+      { once: true },
+    );
+  });
+}
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const formatDate = (epoch) => dateFormat.format(new Date(epoch));
+
+for (const toggle of document.querySelectorAll('.toggle-password')) {
+  toggle.setAttribute('aria-label', 'Show password');
+  toggle.addEventListener('click', () => {
+    const input = $(toggle.getAttribute('aria-controls'));
+    const show = input.type === 'password';
+    input.type = show ? 'text' : 'password';
+    toggle.textContent = show ? 'Hide' : 'Show';
+    toggle.setAttribute('aria-pressed', String(show));
+    toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Routing
+// ---------------------------------------------------------------------------
+
+function routeSignedOut() {
+  if (location.hash === '#register') {
+    stopAutofill();
+    showView('register');
+    $('register-name').focus();
+  } else {
+    showView('signin');
+    $('passkey-signin-group').hidden = !hasWebAuthn();
+    $('signin-email').focus(); // Dedicated sign-in view: surface passkey autofill immediately.
+    startAutofill();
+  }
+}
+
+window.addEventListener('hashchange', () => {
+  if (!state.user) routeSignedOut();
+});
+
+function onSignedIn(user, { promote = false } = {}) {
+  state.user = user;
+  stopAutofill();
+  if (location.hash) history.replaceState(null, '', location.pathname);
+  if (promote && canCreatePasskeys() && state.caps.conditionalGet) {
+    showError('promo-error', null);
+    showView('promo');
+    $('promo-create').focus();
+  } else {
+    showAccount();
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Passkey sign-in (conditional mediation + explicit button)
+// ---------------------------------------------------------------------------
+
+function stopAutofill() {
+  state.autofill.abort();
+  state.autofill = new AbortController();
+}
+
+async function startAutofill() {
+  if (!state.caps.conditionalGet) return;
+  stopAutofill();
+  const { signal } = state.autofill;
+  try {
+    const result = await authenticateWithPasskey({
+      optionsPath: '/api/signin/passkey/options',
+      verifyPath: '/api/signin/passkey/verify',
+      mediation: 'conditional',
+      signal,
+    });
+    if (result === CANCELLED || signal.aborted) return;
+    onSignedIn(result.user);
+  } catch (err) {
+    if (signal.aborted) return;
+    showError('signin-error', err);
+    // Re-arm autofill so the customer can pick another passkey (only after a rejected passkey,
+    // not on network/server failures, to avoid a retry loop).
+    if (!views.signin.hidden && err instanceof ApiError && err.status >= 400 && err.status < 500) startAutofill();
+  }
+}
+
+$('passkey-signin').addEventListener('click', (event) =>
+  busy(event.currentTarget, async () => {
+    showError('signin-error', null);
+    stopAutofill(); // Abort pending conditional request to avoid prompt collisions.
+    try {
+      const result = await authenticateWithPasskey({
+        optionsPath: '/api/signin/passkey/options',
+        verifyPath: '/api/signin/passkey/verify',
+        signal: state.autofill.signal,
+      });
+      if (result !== CANCELLED) return onSignedIn(result.user);
+    } catch (err) {
+      showError('signin-error', err);
+    }
+    startAutofill(); // Re-arm autofill after a cancelled/failed explicit prompt.
+  }),
+);
+
+// ---------------------------------------------------------------------------
+// Password sign-in (+ conditional create) and registration (+ promotion)
+// ---------------------------------------------------------------------------
+
+$('signin-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  showError('signin-error', null);
+  if (!form.reportValidity()) return;
+  const data = new FormData(form);
+  await busy(form.querySelector('[type=submit]'), async () => {
+    try {
+      const { user } = await api('/api/signin/password', {
+        method: 'POST',
+        body: { email: data.get('email'), password: data.get('password') },
+      });
+      stopAutofill(); // Must abort conditional get before conditional create.
+      onSignedIn(user);
+      tryConditionalCreate();
+      form.reset();
+    } catch (err) {
+      showError('signin-error', err);
+    }
+  });
+});
+
+/** Silently offer a passkey right after a successful password sign-in, where supported. */
+async function tryConditionalCreate() {
+  if (!state.caps.conditionalCreate) return;
+  try {
+    const credential = await registerPasskey({ conditional: true });
+    if (credential === CANCELLED) return;
+    toast(`Passkey saved to ${credential.name}. Next time, sign in without your password.`);
+    await loadPasskeys();
+  } catch (err) {
+    // Conditional create is opportunistic; never interrupt the customer with errors.
+    console.warn('Conditional passkey creation skipped:', err);
+  }
+}
+
+$('register-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  showError('register-error', null);
+  if (!form.reportValidity()) return;
+  const data = new FormData(form);
+  await busy(form.querySelector('[type=submit]'), async () => {
+    try {
+      const { user } = await api('/api/account', {
+        method: 'POST',
+        body: {
+          displayName: data.get('displayName'),
+          email: data.get('email'),
+          password: data.get('password'),
+        },
+      });
+      form.reset();
+      onSignedIn(user, { promote: true });
+    } catch (err) {
+      showError('register-error', err);
+    }
+  });
+});
+
+$('promo-create').addEventListener('click', (event) =>
+  busy(event.currentTarget, async () => {
+    showError('promo-error', null);
+    try {
+      const credential = await registerPasskey({ promotion: true });
+      if (credential === CANCELLED) return;
+      toast(`Passkey created in ${credential.name}.`);
+      showAccount();
+    } catch (err) {
+      showError('promo-error', err);
+    }
+  }),
+);
+
+$('promo-skip').addEventListener('click', () => showAccount());
+
+// ---------------------------------------------------------------------------
+// Reauthentication
+// ---------------------------------------------------------------------------
+
+const reauthDialog = $('reauth-dialog');
+let finishReauth = null;
+
+/** Ask the signed-in customer to verify their identity. Resolves true when verified. */
+function reauthenticate() {
+  const usePasskey = hasWebAuthn() && state.user.passkeyCount > 0;
+  $('reauth-passkey-group').hidden = !usePasskey;
+  $('reauth-username').value = state.user.email;
+  $('reauth-password').value = '';
+  showError('reauth-error', null);
+  // Autofocus the primary option.
+  $('reauth-passkey').toggleAttribute('autofocus', usePasskey);
+  $('reauth-password').toggleAttribute('autofocus', !usePasskey);
+
+  return new Promise((resolve) => {
+    let verified = false;
+    finishReauth = () => {
+      verified = true;
+      reauthDialog.close();
+    };
+    reauthDialog.addEventListener(
+      'close',
+      () => {
+        finishReauth = null;
+        resolve(verified);
+      },
+      { once: true },
+    );
+    reauthDialog.showModal();
+  });
+}
+
+$('reauth-passkey').addEventListener('click', (event) =>
+  busy(event.currentTarget, async () => {
+    showError('reauth-error', null);
+    try {
+      const result = await authenticateWithPasskey({
+        optionsPath: '/api/reauth/options',
+        verifyPath: '/api/reauth/verify',
+      });
+      if (result !== CANCELLED) finishReauth?.();
+    } catch (err) {
+      showError('reauth-error', err);
+    }
+  }),
+);
+
+$('reauth-password-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  showError('reauth-error', null);
+  if (!form.reportValidity()) return;
+  await busy(form.querySelector('[type=submit]'), async () => {
+    try {
+      await api('/api/reauth/password', { method: 'POST', body: { password: $('reauth-password').value } });
+      finishReauth?.();
+    } catch (err) {
+      showError('reauth-error', err);
+    }
+  });
+});
+
+reauthDialog.querySelector('[data-close]').addEventListener('click', () => reauthDialog.close());
+
+/** Run a sensitive action; if the server asks for reauthentication, verify and retry once. */
+async function withReauth(action) {
+  try {
+    return await action();
+  } catch (err) {
+    if (!(err instanceof ApiError && err.code === 'reauth_required')) throw err;
+    if (!(await reauthenticate())) return CANCELLED;
+    return action();
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Account dashboard: profile + passkey management
+// ---------------------------------------------------------------------------
+
+function renderProfile() {
+  $('greeting-name').textContent = state.user.displayName;
+  $('profile-name').value = state.user.displayName;
+  $('profile-email').value = state.user.email;
+}
+
+async function showAccount() {
+  renderProfile();
+  showError('profile-error', null);
+  showError('passkeys-error', null);
+  const supported = canCreatePasskeys();
+  $('create-passkey').hidden = !supported;
+  $('passkeys-unsupported').hidden = supported;
+  showView('account');
+  await loadPasskeys();
+}
+
+async function loadPasskeys() {
+  try {
+    const { rpId, userId, credentials } = await api('/api/passkeys');
+    state.user.passkeyCount = credentials.length;
+    renderPasskeys(credentials);
+    // Keep password managers in sync with the server's list on every load/change.
+    await signalAllAcceptedCredentials(rpId, userId, credentials);
+  } catch (err) {
+    if (err instanceof ApiError && err.code === 'signed_out') return handleSignedOut();
+    showError('passkeys-error', err);
+  }
+}
+
+function renderPasskeys(credentials) {
+  const list = $('passkey-list');
+  const template = $('passkey-item-template');
+  list.replaceChildren(
+    ...credentials.map((cred) => {
+      const item = template.content.firstElementChild.cloneNode(true);
+      const icon = item.querySelector('.provider-icon');
+      if (cred.providerIcon) icon.src = cred.providerIcon;
+      else icon.classList.add('generic');
+      item.querySelector('.passkey-name').textContent = cred.name;
+      item.querySelector('.passkey-created').textContent = `Created ${formatDate(cred.registeredAt)}`;
+      item.querySelector('.passkey-used').textContent = cred.lastUsedAt
+        ? ` · Last used ${formatDate(cred.lastUsedAt)}`
+        : ' · Never used';
+      item.querySelector('.passkey-badge').textContent =
+        cred.credentialDeviceType === 'multiDevice' ? 'Synced across your devices' : 'Saved on one device';
+      for (const button of item.querySelectorAll('button')) {
+        button.setAttribute('aria-label', `${button.textContent} ${cred.name}`);
+        button.addEventListener('click', () =>
+          button.dataset.action === 'rename' ? renamePasskey(cred) : deletePasskey(cred, button),
+        );
+      }
+      return item;
+    }),
+  );
+  $('passkeys-empty').hidden = credentials.length > 0;
+}
+
+$('create-passkey').addEventListener('click', (event) =>
+  busy(event.currentTarget, async () => {
+    showError('passkeys-error', null);
+    try {
+      // Management flow: no authenticatorAttachment, so security keys are allowed too.
+      const credential = await withReauth(() => registerPasskey());
+      if (credential === CANCELLED) return;
+      toast(`Passkey created in ${credential.name}.`);
+      await loadPasskeys();
+    } catch (err) {
+      showError('passkeys-error', err);
+    }
+  }),
+);
+
+const renameDialog = $('rename-dialog');
+async function renamePasskey(cred) {
+  showError('passkeys-error', null);
+  $('rename-input').value = cred.name;
+  renameDialog.showModal();
+  if ((await dialogResult(renameDialog)) !== 'save') return;
+  const name = $('rename-input').value.trim();
+  if (!name || name === cred.name) return;
+  try {
+    // Nickname is a server-side label only; no Signal API call needed.
+    await api(`/api/passkeys/${encodeURIComponent(cred.id)}`, { method: 'PUT', body: { name } });
+    toast('Passkey renamed.');
+    await loadPasskeys();
+  } catch (err) {
+    showError('passkeys-error', err);
+  }
+}
+
+const deleteDialog = $('delete-dialog');
+async function deletePasskey(cred, button) {
+  showError('passkeys-error', null);
+  $('delete-name').textContent = cred.name;
+  deleteDialog.showModal();
+  if ((await dialogResult(deleteDialog)) !== 'delete') return;
+  await busy(button, async () => {
+    try {
+      const result = await withReauth(() =>
+        api(`/api/passkeys/${encodeURIComponent(cred.id)}`, { method: 'DELETE' }),
+      );
+      if (result === CANCELLED) return;
+      toast('Passkey deleted.');
+      await loadPasskeys(); // Also signals the remaining accepted credentials.
+    } catch (err) {
+      showError('passkeys-error', err);
+    }
+  });
+}
+
+$('profile-form').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const form = event.currentTarget;
+  showError('profile-error', null);
+  if (!form.reportValidity()) return;
+  const email = $('profile-email').value.trim();
+  const displayName = $('profile-name').value.trim();
+  if (email === state.user.email && displayName === state.user.displayName) {
+    toast('No changes to save.');
+    return;
+  }
+  await busy(form.querySelector('[type=submit]'), async () => {
+    try {
+      const result = await withReauth(() => api('/api/user', { method: 'PUT', body: { email, displayName } }));
+      if (result === CANCELLED) return;
+      state.user = result.user;
+      renderProfile();
+      toast('Profile updated.');
+      // Update the account name shown by password managers for existing passkeys.
+      await signalCurrentUserDetails(result.rpId, result.userId, result.user.email, result.user.displayName);
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'signed_out') return handleSignedOut();
+      showError('profile-error', err);
+    }
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Sign out
+// ---------------------------------------------------------------------------
+
+function handleSignedOut() {
+  state.user = null;
+  routeSignedOut();
+}
+
+$('signout').addEventListener('click', (event) =>
+  busy(event.currentTarget, async () => {
+    try {
+      await api('/api/logout', { method: 'POST', body: {} });
+    } finally {
+      handleSignedOut();
+      toast('You’ve been signed out.');
+    }
+  }),
+);
+
+// ---------------------------------------------------------------------------
+// Boot
+// ---------------------------------------------------------------------------
+
+state.caps = await getCapabilities();
+try {
+  const { user } = await api('/api/session');
+  state.user = user;
+} catch {
+  state.user = null;
+}
+if (state.user) showAccount();
+else routeSignedOut();
