diff --git a/public/js/webauthn.js b/public/js/webauthn.js
new file mode 100644
index 0000000..b6c561b
--- /dev/null
+++ b/public/js/webauthn.js
@@ -0,0 +1,163 @@
+// Native WebAuthn helpers shared by the account UI.
+// Polyfills parseCreationOptionsFromJSON / parseRequestOptionsFromJSON / toJSON / getClientCapabilities
+// whenever PublicKeyCredential exists but those newer methods don't.
+import '/vendor/webauthn-polyfills.js';
+
+export class ApiError extends Error {
+  constructor(status, code, message) {
+    super(message || 'Something went wrong. Please try again.');
+    this.status = status;
+    this.code = code;
+  }
+}
+
+/** JSON fetch wrapper. Throws ApiError for non-2xx responses (status preserved for Signal API decisions). */
+export async function api(path, { method = 'GET', body } = {}) {
+  const response = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+    body: body !== undefined ? JSON.stringify(body) : undefined,
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new ApiError(response.status, data.error, data.message);
+  return data;
+}
+
+const EMPTY_CAPABILITIES = Object.freeze({});
+
+/** @returns {Promise<Record<string, boolean | undefined>>} */
+export async function getCapabilities() {
+  if (!window.PublicKeyCredential?.getClientCapabilities) return EMPTY_CAPABILITIES;
+  try {
+    const caps = await PublicKeyCredential.getClientCapabilities();
+    return {
+      ...caps,
+      // The polyfill can't detect passkeyPlatformAuthenticator (it needs hybrid detection), so fall
+      // back to the user-verifying platform authenticator check in that case.
+      passkeyPlatformAuthenticator: caps.passkeyPlatformAuthenticator ?? caps.userVerifyingPlatformAuthenticator,
+    };
+  } catch {
+    return EMPTY_CAPABILITIES;
+  }
+}
+
+/** Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1. */
+export function isValidBase64Url(value) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+// --- Signal API (progressive enhancement; failures are non-fatal and logged with console.warn) ---
+
+export async function signalUnknownCredential(rpId, credentialId) {
+  if (!window.PublicKeyCredential?.signalUnknownCredential) return;
+  if (!rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    // rpId always comes from the server's options, never window.location.hostname.
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId, userId, credentials) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid Base64URL IDs are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function signalCurrentUserDetails(rpId, userId, name, displayName) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// --- Flows ---------------------------------------------------------------------------------------
+
+/** Result of a WebAuthn ceremony the user dismissed; callers should stay quiet. */
+export const CANCELLED = Symbol('cancelled');
+
+/**
+ * Register a new passkey for the signed-in customer.
+ * @param {{ promotion?: boolean, conditional?: boolean }} opts
+ * @returns {Promise<object | typeof CANCELLED>} The stored credential, or CANCELLED.
+ */
+export async function registerPasskey({ promotion = false, conditional = false } = {}) {
+  const optionsJSON = await api('/api/passkeys/register/options', { method: 'POST', body: { promotion, conditional } });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey,
+      ...(conditional && { mediation: 'conditional' }),
+    });
+  } catch (err) {
+    if (conditional && ['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(err.name)) return CANCELLED;
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') return CANCELLED;
+    if (err.name === 'InvalidStateError') {
+      throw new ApiError(409, 'credential_exists', 'You already have a passkey for this account in this passkey provider.');
+    }
+    if (err.name === 'SecurityError') {
+      throw new ApiError(0, 'security_error', 'Passkeys aren’t available on this connection. Please use the secure site.');
+    }
+    throw err;
+  }
+  if (!credential) return CANCELLED;
+
+  // Segregated server verification: an unverified credential is orphaned in the provider, so tell it.
+  const encoded = credential.toJSON();
+  try {
+    const { credential: saved } = await api('/api/passkeys/register/verify', { method: 'POST', body: encoded });
+    return saved;
+  } catch (err) {
+    await signalUnknownCredential(publicKey.rp.id, encoded.id);
+    throw err;
+  }
+}
+
+/**
+ * Run a passkey assertion against the given endpoints. Signals unknown credentials on HTTP 404.
+ * @param {{ optionsPath: string, verifyPath: string, mediation?: CredentialMediationRequirement, signal?: AbortSignal, signalUnknown?: boolean }} opts
+ */
+export async function authenticateWithPasskey({ optionsPath, verifyPath, mediation, signal, signalUnknown = true }) {
+  const optionsJSON = await api(optionsPath, { method: 'POST', body: {} });
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.get({ publicKey, signal, ...(mediation && { mediation }) });
+  } catch (err) {
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') return CANCELLED;
+    if (err.name === 'SecurityError') {
+      throw new ApiError(0, 'security_error', 'Passkeys aren’t available on this connection. Please use the secure site.');
+    }
+    throw err;
+  }
+  if (!credential) return CANCELLED;
+
+  const encoded = credential.toJSON();
+  try {
+    return await api(verifyPath, { method: 'POST', body: encoded });
+  } catch (err) {
+    if (signalUnknown && err instanceof ApiError && err.status === 404) {
+      await signalUnknownCredential(publicKey.rpId, encoded.id);
+    }
+    throw err;
+  }
+}
