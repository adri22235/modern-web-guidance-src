+    "prestart": "pnpm run build",
+    "start": "node server/index.js"
   },
   "pnpm": {
-    "onlyBuiltDependencies": []
+    "onlyBuiltDependencies": [
+      "esbuild"
+    ]
+  },
+  "dependencies": {
+    "@simplewebauthn/server": "^14.1.0",
+    "webauthn-polyfills": "^0.1.7"
+  },
+  "devDependencies": {
+    "esbuild": "^0.28.2"
+  },
+  "type": "module",
+  "engines": {
+    "node": ">=22"
   }
 }
