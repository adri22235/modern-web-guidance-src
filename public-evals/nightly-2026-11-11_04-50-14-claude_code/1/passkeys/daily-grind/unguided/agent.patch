+    return await task();
+  } catch (err) {
+    if (!(err instanceof ApiError && err.code === 'reauth_required')) throw err;
+  }
+  await reauthenticate(reauthOptions);
+  return task();
+}
+
+/* ------------------------------------------------------------------------ */
+/* Confirm dialog                                                            */
+/* ------------------------------------------------------------------------ */
+
+function confirmAction({ title, message, confirmLabel, danger = false }) {
+  return new Promise((resolve) => {
+    const dialog = el.confirmDialog;
+    el.confirmTitle.textContent = title;
+    el.confirmMessage.textContent = message;
+    el.confirmOkBtn.textContent = confirmLabel;
+    el.confirmOkBtn.classList.toggle('btn-danger', danger);
+    dialog.returnValue = '';
+    dialog.addEventListener('close', () => resolve(dialog.returnValue === 'confirm'), { once: true });
+    dialog.showModal();
+  });
+}
+
+/* ------------------------------------------------------------------------ */
+/* Account actions                                                           */
+/* ------------------------------------------------------------------------ */
+
+async function saveProfile() {
+  const displayName = el.profileName.value.trim();
+  const email = el.profileEmail.value.trim();
+  if (!el.profileForm.reportValidity()) return;
+  const emailChanged = email.toLowerCase() !== state.user.email;
+
+  await runBusy(el.profileSaveBtn, async () => {
+    try {
+      const { user } = await withReauth(() => api('PATCH', '/api/account', { displayName, email }), {
+        description: 'Changing your email changes how you sign in. Please verify with your passkey to continue.',
+      });
+      delete el.profileForm.dataset.dirty;
+      await refreshSession();
+      // Let passkey providers show the updated name/email for this account.
+      signal.syncAccount();
+      showStatus(emailChanged ? `Profile updated. You’ll now sign in as ${user.email}.` : 'Profile updated.');
+    } catch (err) {
+      reportError(err, 'profile');
+    }
+  });
+}
+
+async function renamePasskey(id, name, item) {
+  const saveBtn = $('.passkey-rename [type="submit"]', item);
+  await runBusy(saveBtn, async () => {
+    try {
+      await api('PATCH', `/api/passkeys/${encodeURIComponent(id)}`, { name });
+      $('.passkey-rename', item).hidden = true;
+      await refreshSession();
+      showStatus('Passkey renamed.');
+      el.passkeyList.querySelector(`li[data-id="${CSS.escape(id)}"] [data-action="rename"]`)?.focus();
+    } catch (err) {
+      reportError(err);
+    }
+  });
+}
+
+async function deletePasskey(id) {
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+  const ok = await confirmAction({
+    title: 'Remove this passkey?',
+    message: `“${pk.name}” will no longer sign you in to The Daily Grind. You’ll still be able to sign in with your other passkeys.`,
+    confirmLabel: 'Remove passkey',
+    danger: true,
+  });
+  if (!ok) return;
+
+  await runBusy(null, async () => {
+    try {
+      await withReauth(() => api('DELETE', `/api/passkeys/${encodeURIComponent(id)}`), {
+        description: 'Please verify with your passkey before removing a passkey from your account.',
+      });
+      await refreshSession();
+      // Tell the provider the removed passkey is no longer valid so it can hide it.
+      signal.syncAccount();
+      showStatus(`Removed “${pk.name}”. You may also delete it from your device or password manager.`);
+      el.addPasskeyBtn.focus();
+    } catch (err) {
+      reportError(err);
+    }
+  });
+}
+
+async function deleteAccount() {
+  const ok = await confirmAction({
+    title: 'Delete your account?',
+    message: 'This permanently deletes your Daily Grind account, rewards and all saved passkeys. This can’t be undone.',
+    confirmLabel: 'Delete account',
+    danger: true,
+  });
+  if (!ok) return;
+
+  await runBusy(el.deleteAccountBtn, async () => {
+    try {
+      const { userId } = await withReauth(() => api('DELETE', '/api/account'), {
+        description: 'Please verify with your passkey to delete your account.',
+      });
+      signal.accountDeleted(userId);
+      await refreshSession();
+      showStatus('Your account has been deleted. Sorry to see you go!', 'info');
+    } catch (err) {
+      reportError(err);
+    }
+  });
+  if (!state.user) startConditionalSignIn();
+}
+
+async function signOut() {
+  await runBusy(el.signoutBtn, async () => {
+    try {
+      await api('POST', '/api/logout');
+    } catch {
+      localStorage.removeItem(SESSION_KEY);
+    }
+    state.tab = 'signin';
+    await refreshSession();
+    showStatus('You’ve been signed out.', 'info');
+  });
+  startConditionalSignIn();
+}
+
+/* ------------------------------------------------------------------------ */
+/* Dialog open / close & routing                                             */
+/* ------------------------------------------------------------------------ */
+
+async function openAccount() {
+  if (!el.dialog.open) el.dialog.showModal();
+  if (location.hash !== '#account') history.replaceState(null, '', '#account');
+  await refreshSession();
+  if (!state.user) startConditionalSignIn();
+}
+
+el.dialog.addEventListener('close', () => {
+  abortConditional();
+  if (location.hash === '#account') history.replaceState(null, '', location.pathname + location.search);
+  el.navAccount.focus();
+});
+
+el.dialog.addEventListener('click', (e) => {
+  if (e.target.closest('[data-close]')) {
+    el.dialog.close();
+    return;
+  }
+  // Clicks on the backdrop target the <dialog> element itself, outside its box.
+  if (e.target === el.dialog) {
+    const r = el.dialog.getBoundingClientRect();
+    if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) el.dialog.close();
+  }
+});
+
+el.navAccount.addEventListener('click', (e) => {
+  e.preventDefault();
+  openAccount();
+});
+
+el.navLogout.addEventListener('click', async (e) => {
+  e.preventDefault();
+  if (!el.dialog.open) el.dialog.showModal();
+  await signOut();
+});
+
+window.addEventListener('hashchange', () => {
+  if (location.hash === '#account') openAccount();
+});
+
+// Keep tabs in sync when signing in/out elsewhere.
+window.addEventListener('storage', (e) => {
+  if (e.key === SESSION_KEY) refreshSession();
+});
+
+/* ------------------------------------------------------------------------ */
+/* Signed-out handlers                                                       */
+/* ------------------------------------------------------------------------ */
+
+function selectTab(tab, focus = false) {
+  state.tab = tab;
+  render();
+  const tabEl = tab === 'signin' ? el.tabSignin : el.tabRegister;
+  if (focus) tabEl.focus();
+  if (tab === 'signin') startConditionalSignIn();
+}
+
+el.tabSignin.addEventListener('click', () => selectTab('signin'));
+el.tabRegister.addEventListener('click', () => selectTab('register'));
+for (const tab of [el.tabSignin, el.tabRegister]) {
+  tab.addEventListener('keydown', (e) => {
+    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Home' || e.key === 'End') {
+      e.preventDefault();
+      selectTab(state.tab === 'signin' ? 'register' : 'signin', true);
+    }
+  });
+}
+
+el.signinPasskeyBtn.addEventListener('click', () => signIn(el.signinPasskeyBtn));
+
+el.signinForm.addEventListener('submit', (e) => {
+  e.preventDefault();
+  const email = el.signinEmail.value.trim();
+  if (!el.signinForm.reportValidity()) return;
+  signIn(e.submitter || $('[type="submit"]', el.signinForm), email);
+});
+
+el.registerForm.addEventListener('submit', (e) => {
+  e.preventDefault();
+  if (!el.registerForm.reportValidity()) return;
+  const data = new FormData(el.registerForm);
+  register(e.submitter || $('[type="submit"]', el.registerForm), String(data.get('displayName')).trim(), String(data.get('email')).trim());
+});
+
+/* ------------------------------------------------------------------------ */
+/* Signed-in handlers                                                        */
+/* ------------------------------------------------------------------------ */
+
+el.signoutBtn.addEventListener('click', signOut);
+el.addPasskeyBtn.addEventListener('click', addPasskey);
+el.deleteAccountBtn.addEventListener('click', deleteAccount);
+
+el.profileForm.addEventListener('input', updateProfileDirty);
+el.profileForm.addEventListener('submit', (e) => {
+  e.preventDefault();
+  saveProfile();
+});
+
+el.passkeyList.addEventListener('click', (e) => {
+  const action = e.target.closest('[data-action]')?.dataset.action;
+  const item = e.target.closest('li[data-id]');
+  if (!action || !item) return;
+  const id = item.dataset.id;
+  const form = $('.passkey-rename', item);
+  const nameRow = $('.passkey-name-row', item);
+
+  if (action === 'rename') {
+    form.hidden = false;
+    nameRow.hidden = true;
+    const input = $('input', form);
+    input.focus();
+    input.select();
+  } else if (action === 'cancel-rename') {
+    form.hidden = true;
+    nameRow.hidden = false;
+    $('input', form).value = state.passkeys.find((p) => p.id === id)?.name || '';
+    $('[data-action="rename"]', item).focus();
+  } else if (action === 'delete') {
+    deletePasskey(id);
+  }
+});
+
+el.passkeyList.addEventListener('submit', (e) => {
+  e.preventDefault();
+  const item = e.target.closest('li[data-id]');
+  const input = $('input', e.target);
+  const name = input.value.trim();
+  if (!name) {
+    input.reportValidity();
+    return;
+  }
+  renamePasskey(item.dataset.id, name, item);
+});
+
+el.passkeyList.addEventListener('keydown', (e) => {
+  if (e.key === 'Escape' && e.target.matches('.passkey-rename input')) {
+    e.preventDefault(); // don't close the drawer
+    $('[data-action="cancel-rename"]', e.target.closest('li')).click();
+  }
+});
+
+/* ------------------------------------------------------------------------ */
+/* Boot                                                                      */
+/* ------------------------------------------------------------------------ */
+
+render();
+refreshSession().then(() => {
+  if (location.hash === '#account') openAccount();
+});
