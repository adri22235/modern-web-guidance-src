+/**
+ * Daily Grind relying-party ("server") for passkeys.
+ *
+ * The Daily Grind site is currently a static site with no backend, so this
+ * module plays the part of the account API. It is deliberately written as a
+ * request/response router that only exchanges JSON strings, mirroring the
+ * HTTP endpoints a real backend would expose:
+ *
+ *   GET    /api/session                     current user, passkeys, session info
+ *   POST   /api/logout
+ *   POST   /api/passkeys/register/options   sign-up (signed out) or add passkey (signed in)
+ *   POST   /api/passkeys/register/verify
+ *   POST   /api/passkeys/login/options
+ *   POST   /api/passkeys/login/verify
+ *   POST   /api/passkeys/reauth/options
+ *   POST   /api/passkeys/reauth/verify
+ *   PATCH  /api/passkeys/:id                rename
+ *   DELETE /api/passkeys/:id                remove (requires recent reauth)
+ *   PATCH  /api/account                     profile update (email change requires recent reauth)
+ *   DELETE /api/account                     delete account (requires recent reauth)
+ *
+ * All WebAuthn ceremony checks are performed for real: single-use expiring
+ * challenges, clientData type/origin checks, RP ID hash, UP/UV flags,
+ * signature verification against the stored COSE public key and signature
+ * counter checks. Moving to a real backend means porting this file to the
+ * server (persisting to a database instead of localStorage, using an
+ * HttpOnly session cookie instead of the token header) and replacing the
+ * transport in account.js with fetch().
+ */
+
+import {
+  b64url,
+  utf8,
+  sha256,
+  bytesEqual,
+  concatBytes,
+  decodeCbor,
+  parseAuthenticatorData,
+  coseKeyToJwk,
+  verifySignature,
+  randomBase64url,
+  COSE_ALG,
+} from './webauthn.js';
+
+const DB_KEY = 'dailyGrind.rp.db.v1';
+const RP_NAME = 'The Daily Grind';
+const CEREMONY_TIMEOUT_MS = 5 * 60 * 1000;
+const CHALLENGE_TTL_MS = CEREMONY_TIMEOUT_MS + 30 * 1000;
+const SESSION_TTL_MS = 14 * 24 * 60 * 60 * 1000;
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const SUPPORTED_ALGS = [COSE_ALG.ES256, COSE_ALG.RS256];
+const MAX_PASSKEYS_PER_USER = 20;
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+/** Friendly names for well-known passkey providers, keyed by AAGUID. */
+const AAGUID_PROVIDERS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  'b5397666-4885-aa6b-cebf-e52262a439a2': 'Chromium Browser',
+};
+
+class HttpError extends Error {
+  constructor(status, code, message, extra = {}) {
+    super(message);
+    this.status = status;
+    this.code = code;
+    this.extra = extra;
+  }
+}
+
+const now = () => Date.now();
+const rpId = () => location.hostname;
+const expectedOrigin = () => location.origin;
+
+/* ------------------------------------------------------------------------ */
+/* Persistence                                                               */
+/* ------------------------------------------------------------------------ */
+
+function emptyDb() {
+  return { users: {}, credentials: {}, sessions: {}, challenges: {} };
+}
+
+function loadDb() {
+  try {
+    const db = JSON.parse(localStorage.getItem(DB_KEY));
+    if (db && db.users && db.credentials && db.sessions && db.challenges) return db;
+  } catch {
+    /* fall through */
+  }
+  return emptyDb();
+}
+
+function saveDb(db) {
+  localStorage.setItem(DB_KEY, JSON.stringify(db));
+}
+
+function pruneExpired(db) {
+  const t = now();
+  for (const [k, c] of Object.entries(db.challenges)) if (c.expiresAt < t) delete db.challenges[k];
+  for (const [k, s] of Object.entries(db.sessions)) if (s.expiresAt < t || !db.users[s.userId]) delete db.sessions[k];
+}
+
+/* ------------------------------------------------------------------------ */
+/* Helpers                                                                   */
+/* ------------------------------------------------------------------------ */
+
+function normalizeEmail(email) {
+  return typeof email === 'string' ? email.trim().toLowerCase() : '';
+}
+
+function validateDisplayName(value) {
+  const name = typeof value === 'string' ? value.trim().replace(/\s+/g, ' ') : '';
+  if (!name) throw new HttpError(400, 'invalid_name', 'Please enter your name.');
+  if (name.length > 60) throw new HttpError(400, 'invalid_name', 'Names can be at most 60 characters.');
+  return name;
+}
+
+function validateEmail(value) {
+  const email = normalizeEmail(value);
+  if (!EMAIL_RE.test(email) || email.length > 254) {
+    throw new HttpError(400, 'invalid_email', 'Please enter a valid email address.');
+  }
+  return email;
+}
+
+function findUserByEmail(db, email) {
+  return Object.values(db.users).find((u) => u.email === email) || null;
+}
+
+function userCredentials(db, userId) {
+  return Object.values(db.credentials)
+    .filter((c) => c.userId === userId)
+    .sort((a, b) => a.createdAt - b.createdAt);
+}
+
+function publicUser(user) {
+  return { id: user.id, email: user.email, displayName: user.displayName, createdAt: user.createdAt };
+}
+
+function publicPasskey(cred) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    provider: cred.provider,
+    createdAt: cred.createdAt,
+    lastUsedAt: cred.lastUsedAt,
+    backupEligible: cred.backupEligible,
+    backupState: cred.backupState,
+    transports: cred.transports,
+    authenticatorAttachment: cred.authenticatorAttachment,
+  };
+}
+
+function defaultPasskeyName(provider) {
+  if (provider) return provider;
+  const ua = navigator.userAgent; // stands in for the User-Agent request header
+  const platform =
+    /iPhone|iPad|iPod/.test(ua) ? 'iOS' :
+    /Android/.test(ua) ? 'Android' :
+    /Mac OS X|Macintosh/.test(ua) ? 'macOS' :
+    /Windows/.test(ua) ? 'Windows' :
+    /CrOS/.test(ua) ? 'ChromeOS' :
+    /Linux/.test(ua) ? 'Linux' : '';
+  return platform ? `Passkey on ${platform}` : 'Passkey';
+}
+
+function createSession(ctx, userId, credentialId) {
+  const token = randomBase64url(32);
+  const t = now();
+  ctx.db.sessions[token] = { userId, credentialId, createdAt: t, verifiedAt: t, expiresAt: t + SESSION_TTL_MS };
+  ctx.setSession = token;
+  return token;
+}
+
+function requireSession(ctx) {
+  if (!ctx.session) throw new HttpError(401, 'not_signed_in', 'Please sign in to continue.');
+  return ctx.session;
+}
+
+function requireRecentVerification(ctx) {
+  const session = requireSession(ctx);
+  if (now() - session.verifiedAt > REAUTH_WINDOW_MS) {
+    throw new HttpError(401, 'reauth_required', 'Please confirm it’s you to continue.');
+  }
+}
+
+function issueChallenge(ctx, record) {
+  const challenge = randomBase64url(32);
+  ctx.db.challenges[challenge] = { ...record, expiresAt: now() + CHALLENGE_TTL_MS };
+  return challenge;
+}
+
+/** Look up and consume a challenge. Challenges are single-use regardless of outcome. */
+function takeChallenge(ctx, challenge, purpose) {
+  const record = typeof challenge === 'string' ? ctx.db.challenges[challenge] : undefined;
+  if (record) delete ctx.db.challenges[challenge];
+  if (!record || record.purpose !== purpose || record.expiresAt < now()) {
+    throw new HttpError(400, 'challenge_invalid', 'This request has expired. Please try again.');
+  }
+  if (record.sessionToken && record.sessionToken !== ctx.sessionToken) {
+    throw new HttpError(400, 'challenge_invalid', 'This request has expired. Please try again.');
+  }
+  return record;
+}
+
+function assertCredentialShape(credential, kind) {
+  const ok =
+    credential &&
+    credential.type === 'public-key' &&
+    typeof credential.id === 'string' &&
+    credential.id === credential.rawId &&
+    credential.response &&
+    typeof credential.response.clientDataJSON === 'string' &&
+    (kind === 'registration'
+      ? typeof credential.response.attestationObject === 'string'
+      : typeof credential.response.authenticatorData === 'string' && typeof credential.response.signature === 'string');
+  if (!ok) throw new HttpError(400, 'invalid_credential', 'The passkey response was malformed.');
+}
+
+function parseClientData(encoded, expectedType) {
+  let bytes;
+  let data;
+  try {
+    bytes = b64url.decode(encoded);
+    data = JSON.parse(utf8.decode(bytes));
+  } catch {
+    throw new HttpError(400, 'invalid_credential', 'The passkey response was malformed.');
+  }
+  if (data.type !== expectedType) {
+    throw new HttpError(400, 'invalid_credential', 'Unexpected passkey response type.');
+  }
+  if (data.origin !== expectedOrigin() || data.crossOrigin === true) {
+    throw new HttpError(400, 'origin_mismatch', 'This passkey response came from an unexpected origin.');
+  }
+  return { bytes, data };
+}
+
+async function checkRpIdHash(authData) {
+  if (!bytesEqual(authData.rpIdHash, await sha256(utf8.encode(rpId())))) {
+    throw new HttpError(400, 'rp_mismatch', 'This passkey belongs to a different website.');
+  }
+}
+
+function checkUserFlags(authData, userVerification) {
+  if (!authData.userPresent) throw new HttpError(400, 'user_not_present', 'User presence was not confirmed.');
+  if (userVerification === 'required' && !authData.userVerified) {
+    throw new HttpError(400, 'user_not_verified', 'Your device didn’t verify you (PIN, fingerprint or face). Please try again.');
+  }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Registration                                                              */
+/* ------------------------------------------------------------------------ */
+
+function registerOptions(ctx) {
+  let user;
+  let pendingUser = null;
+
+  if (ctx.session) {
+    // Adding another passkey to an existing account is security-sensitive.
+    requireRecentVerification(ctx);
+    user = ctx.db.users[ctx.session.userId];
+    if (userCredentials(ctx.db, user.id).length >= MAX_PASSKEYS_PER_USER) {
+      throw new HttpError(409, 'too_many_passkeys', `You can save up to ${MAX_PASSKEYS_PER_USER} passkeys.`);
+    }
+  } else {
+    const displayName = validateDisplayName(ctx.body.displayName);
+    const email = validateEmail(ctx.body.email);
+    if (findUserByEmail(ctx.db, email)) {
+      throw new HttpError(409, 'email_taken', 'An account with this email already exists. Try signing in with your passkey instead.');
+    }
+    pendingUser = { id: randomBase64url(32), email, displayName };
+    user = pendingUser;
+  }
+
+  const challenge = issueChallenge(ctx, {
+    purpose: 'register',
+    userId: user.id,
+    pendingUser,
+    sessionToken: ctx.session ? ctx.sessionToken : null,
+    userVerification: 'preferred',
+  });
+
+  return {
+    challenge,
+    rp: { id: rpId(), name: RP_NAME },
+    user: { id: user.id, name: user.email, displayName: user.displayName },
+    pubKeyCredParams: SUPPORTED_ALGS.map((alg) => ({ type: 'public-key', alg })),
+    timeout: CEREMONY_TIMEOUT_MS,
+    attestation: 'none',
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+    excludeCredentials: userCredentials(ctx.db, user.id).map((c) => ({
+      type: 'public-key',
+      id: c.id,
+      transports: c.transports,
+    })),
+    extensions: { credProps: true },
+  };
+}
+
+async function registerVerify(ctx) {
+  const { credential } = ctx.body;
+  assertCredentialShape(credential, 'registration');
+  const clientData = parseClientData(credential.response.clientDataJSON, 'webauthn.create');
+  const challenge = takeChallenge(ctx, clientData.data.challenge, 'register');
+
+  if (challenge.sessionToken && (!ctx.session || ctx.session.userId !== challenge.userId)) {
+    throw new HttpError(403, 'forbidden', 'Your session changed. Please try again.');
+  }
+  if (!challenge.sessionToken && ctx.session) {
+    throw new HttpError(409, 'already_signed_in', 'You’re already signed in.');
+  }
+
+  let authData;
+  let fmt;
+  try {
+    const attestation = decodeCbor(b64url.decode(credential.response.attestationObject)).value;
+    fmt = attestation.get('fmt');
+    authData = parseAuthenticatorData(attestation.get('authData'));
+  } catch {
+    throw new HttpError(400, 'invalid_credential', 'The passkey response was malformed.');
+  }
+  if (typeof fmt !== 'string') throw new HttpError(400, 'invalid_credential', 'The passkey response was malformed.');
+  // We request attestation: 'none', so the attestation statement is not evaluated.
+
+  await checkRpIdHash(authData);
+  checkUserFlags(authData, challenge.userVerification);
+
+  if (!authData.credentialId || !authData.credentialPublicKey) {
+    throw new HttpError(400, 'invalid_credential', 'No credential was included in the response.');
+  }
+  if (!bytesEqual(authData.credentialId, b64url.decode(credential.rawId))) {
+    throw new HttpError(400, 'invalid_credential', 'Credential ID mismatch.');
+  }
+
+  let publicKey;
+  try {
+    publicKey = coseKeyToJwk(authData.credentialPublicKey);
+  } catch {
+    throw new HttpError(400, 'unsupported_algorithm', 'Your device created an unsupported type of passkey.');
+  }
+  if (!SUPPORTED_ALGS.includes(publicKey.alg)) {
+    throw new HttpError(400, 'unsupported_algorithm', 'Your device created an unsupported type of passkey.');
+  }
+
+  if (ctx.db.credentials[credential.id]) {
+    throw new HttpError(409, 'credential_exists', 'This passkey is already registered.');
+  }
+
+  let user;
+  if (challenge.pendingUser) {
+    if (findUserByEmail(ctx.db, challenge.pendingUser.email)) {
+      throw new HttpError(409, 'email_taken', 'An account with this email already exists.');
+    }
+    const t = now();
+    user = { ...challenge.pendingUser, createdAt: t, updatedAt: t };
+    ctx.db.users[user.id] = user;
+  } else {
+    user = ctx.db.users[challenge.userId];
+    if (!user) throw new HttpError(404, 'not_found', 'Account not found.');
+  }
+
+  const provider = AAGUID_PROVIDERS[authData.aaguid] || null;
+  const transports = Array.isArray(credential.response.transports)
+    ? credential.response.transports.filter((t) => typeof t === 'string')
+    : [];
+  const t = now();
+  const stored = {
+    id: credential.id,
+    userId: user.id,
+    publicKey,
+    signCount: authData.signCount,
+    transports,
+    aaguid: authData.aaguid,
+    provider,
+    name: defaultPasskeyName(provider),
+    backupEligible: authData.backupEligible,
+    backupState: authData.backupState,
+    userVerified: authData.userVerified,
+    discoverable: credential.clientExtensionResults?.credProps?.rk ?? null,
+    authenticatorAttachment: credential.authenticatorAttachment || null,
+    createdAt: t,
+    lastUsedAt: null,
+  };
+  ctx.db.credentials[stored.id] = stored;
+
+  if (challenge.pendingUser) {
+    // New account: the registration ceremony also signs the customer in.
+    createSession(ctx, user.id, stored.id);
+  }
+
+  return { user: publicUser(user), passkey: publicPasskey(stored) };
+}
+
+/* ------------------------------------------------------------------------ */
+/* Authentication (sign-in and reauthentication)                             */
+/* ------------------------------------------------------------------------ */
+
+function requestOptions(challenge, allowCredentials, userVerification) {
+  return {
+    challenge,
+    rpId: rpId(),
+    timeout: CEREMONY_TIMEOUT_MS,
+    userVerification,
+    allowCredentials: allowCredentials.map((c) => ({ type: 'public-key', id: c.id, transports: c.transports })),
+  };
+}
+
+function loginOptions(ctx) {
+  // An email is optional. If supplied and known we scope the request to that
+  // account's passkeys; unknown emails get a discoverable-credential request
+  // so the response doesn't reveal whether an account exists.
+  const email = normalizeEmail(ctx.body.email);
+  const user = email ? findUserByEmail(ctx.db, email) : null;
+  const allow = user ? userCredentials(ctx.db, user.id) : [];
+  const challenge = issueChallenge(ctx, {
+    purpose: 'login',
+    userVerification: 'preferred',
+    allowCredentialIds: allow.map((c) => c.id),
+  });
+  return requestOptions(challenge, allow, 'preferred');
+}
+
+function reauthOptions(ctx) {
+  const session = requireSession(ctx);
+  const allow = userCredentials(ctx.db, session.userId);
+  const challenge = issueChallenge(ctx, {
+    purpose: 'reauth',
+    userId: session.userId,
+    sessionToken: ctx.sessionToken,
+    userVerification: 'required',
+    allowCredentialIds: allow.map((c) => c.id),
+  });
+  return requestOptions(challenge, allow, 'required');
+}
+
+async function verifyAssertion(ctx, credential, purpose) {
+  assertCredentialShape(credential, 'assertion');
+  const clientData = parseClientData(credential.response.clientDataJSON, 'webauthn.get');
+  const challenge = takeChallenge(ctx, clientData.data.challenge, purpose);
+
+  const stored = ctx.db.credentials[credential.id];
+  if (!stored) {
+    throw new HttpError(404, 'unknown_credential', 'This passkey isn’t linked to a Daily Grind account. It may have been removed.', {
+      credentialId: credential.id,
+    });
+  }
+  if (challenge.allowCredentialIds?.length && !challenge.allowCredentialIds.includes(stored.id)) {
+    throw new HttpError(403, 'credential_not_allowed', 'Please use a passkey for this account.');
+  }
+  if (challenge.userId && stored.userId !== challenge.userId) {
+    throw new HttpError(403, 'credential_not_allowed', 'Please use a passkey for this account.');
+  }
+
+  const userHandle = credential.response.userHandle;
+  if (userHandle) {
+    if (userHandle !== stored.userId) {
+      throw new HttpError(403, 'credential_not_allowed', 'This passkey doesn’t match the account.');
+    }
+  } else if (!challenge.allowCredentialIds?.length) {
+    // Discoverable flows must return the user handle.
+    throw new HttpError(400, 'invalid_credential', 'The passkey response was missing the account identifier.');
+  }
+
+  let authDataBytes;
+  let authData;
+  let signature;
+  try {
+    authDataBytes = b64url.decode(credential.response.authenticatorData);
+    signature = b64url.decode(credential.response.signature);
+    authData = parseAuthenticatorData(authDataBytes);
+  } catch {
+    throw new HttpError(400, 'invalid_credential', 'The passkey response was malformed.');
+  }
+
+  await checkRpIdHash(authData);
+  checkUserFlags(authData, challenge.userVerification);
+
+  const signedData = concatBytes(authDataBytes, await sha256(clientData.bytes));
+  let valid = false;
+  try {
+    valid = await verifySignature(stored.publicKey, signature, signedData);
+  } catch {
+    valid = false;
+  }
+  if (!valid) throw new HttpError(401, 'invalid_signature', 'We couldn’t verify that passkey. Please try again.');
+
+  if ((authData.signCount > 0 || stored.signCount > 0) && authData.signCount <= stored.signCount) {
+    throw new HttpError(401, 'counter_regression', 'This passkey looks like it may have been cloned. Please contact support.');
+  }
+
+  stored.signCount = authData.signCount;
+  stored.backupState = authData.backupState;
+  stored.lastUsedAt = now();
+
+  return stored;
+}
+
+async function loginVerify(ctx) {
+  const stored = await verifyAssertion(ctx, ctx.body.credential, 'login');
+  const user = ctx.db.users[stored.userId];
+  if (!user) throw new HttpError(404, 'unknown_credential', 'This passkey isn’t linked to an account.', { credentialId: stored.id });
+  if (ctx.sessionToken) delete ctx.db.sessions[ctx.sessionToken];
+  createSession(ctx, user.id, stored.id);
+  return { user: publicUser(user) };
+}
+
+async function reauthVerify(ctx) {
+  const session = requireSession(ctx);
+  const stored = await verifyAssertion(ctx, ctx.body.credential, 'reauth');
+  if (stored.userId !== session.userId) throw new HttpError(403, 'credential_not_allowed', 'Please use a passkey for this account.');
+  session.verifiedAt = now();
+  return { verifiedAt: session.verifiedAt, reauthWindowMs: REAUTH_WINDOW_MS };
+}
+
+/* ------------------------------------------------------------------------ */
+/* Session, passkey management and profile                                   */
+/* ------------------------------------------------------------------------ */
+
+function getSession(ctx) {
+  if (!ctx.session) return { user: null, rpId: rpId() };
+  const user = ctx.db.users[ctx.session.userId];
+  return {
+    user: publicUser(user),
+    passkeys: userCredentials(ctx.db, user.id).map(publicPasskey),
+    currentCredentialId: ctx.session.credentialId,
+    verifiedAt: ctx.session.verifiedAt,
+    reauthWindowMs: REAUTH_WINDOW_MS,
+    rpId: rpId(),
+  };
+}
+
+function logout(ctx) {
+  if (ctx.sessionToken) delete ctx.db.sessions[ctx.sessionToken];
+  ctx.setSession = null;
+  return { ok: true };
+}
+
+function ownedCredential(ctx, id) {
+  const session = requireSession(ctx);
+  const cred = ctx.db.credentials[id];
+  if (!cred || cred.userId !== session.userId) throw new HttpError(404, 'not_found', 'Passkey not found.');
+  return cred;
+}
+
+function renamePasskey(ctx, id) {
+  const cred = ownedCredential(ctx, id);
+  const name = typeof ctx.body.name === 'string' ? ctx.body.name.trim().replace(/\s+/g, ' ') : '';
+  if (!name || name.length > 50) throw new HttpError(400, 'invalid_name', 'Passkey names must be 1–50 characters.');
+  cred.name = name;
+  return { passkey: publicPasskey(cred) };
+}
+
+function deletePasskey(ctx, id) {
+  const cred = ownedCredential(ctx, id);
+  requireRecentVerification(ctx);
+  const remaining = userCredentials(ctx.db, cred.userId).filter((c) => c.id !== id);
+  if (remaining.length === 0) {
+    throw new HttpError(409, 'last_passkey', 'You can’t remove your only passkey — you’d be locked out. Add another passkey first.');
+  }
+  delete ctx.db.credentials[id];
+  return { passkeys: remaining.map(publicPasskey) };
+}
+
+function updateAccount(ctx) {
+  const session = requireSession(ctx);
+  const user = ctx.db.users[session.userId];
+  const displayName = ctx.body.displayName !== undefined ? validateDisplayName(ctx.body.displayName) : user.displayName;
+  const email = ctx.body.email !== undefined ? validateEmail(ctx.body.email) : user.email;
+
+  if (email !== user.email) {
+    // Changing the sign-in identifier is sensitive: require a fresh passkey check.
+    requireRecentVerification(ctx);
+    const existing = findUserByEmail(ctx.db, email);
+    if (existing && existing.id !== user.id) {
+      throw new HttpError(409, 'email_taken', 'That email is already used by another account.');
+    }
+  }
+
+  user.displayName = displayName;
+  user.email = email;
+  user.updatedAt = now();
+  return { user: publicUser(user) };
+}
+
+function deleteAccount(ctx) {
+  const session = requireSession(ctx);
+  requireRecentVerification(ctx);
+  const userId = session.userId;
+  for (const cred of userCredentials(ctx.db, userId)) delete ctx.db.credentials[cred.id];
+  for (const [token, s] of Object.entries(ctx.db.sessions)) if (s.userId === userId) delete ctx.db.sessions[token];
+  delete ctx.db.users[userId];
+  ctx.setSession = null;
+  return { ok: true, userId };
+}
+
+/* ------------------------------------------------------------------------ */
+/* Router                                                                    */
+/* ------------------------------------------------------------------------ */
+
+const routes = [
+  ['GET', /^\/api\/session$/, getSession],
+  ['POST', /^\/api\/logout$/, logout],
+  ['POST', /^\/api\/passkeys\/register\/options$/, registerOptions],
+  ['POST', /^\/api\/passkeys\/register\/verify$/, registerVerify],
+  ['POST', /^\/api\/passkeys\/login\/options$/, loginOptions],
+  ['POST', /^\/api\/passkeys\/login\/verify$/, loginVerify],
+  ['POST', /^\/api\/passkeys\/reauth\/options$/, reauthOptions],
+  ['POST', /^\/api\/passkeys\/reauth\/verify$/, reauthVerify],
+  ['PATCH', /^\/api\/passkeys\/([A-Za-z0-9_-]+)$/, renamePasskey],
+  ['DELETE', /^\/api\/passkeys\/([A-Za-z0-9_-]+)$/, deletePasskey],
+  ['PATCH', /^\/api\/account$/, updateAccount],
+  ['DELETE', /^\/api\/account$/, deleteAccount],
+];
+
+async function process({ method, path, body, sessionToken }) {
+  const db = loadDb();
+  pruneExpired(db);
+  const ctx = {
+    db,
+    sessionToken: sessionToken || null,
+    session: (sessionToken && db.sessions[sessionToken]) || null,
+    body: {},
+    setSession: undefined,
+  };
+  if (sessionToken && !ctx.session) ctx.setSession = null; // stale token: clear "cookie"
+
+  let status = 200;
+  let payload;
+  try {
+    if (body) {
+      try {
+        ctx.body = JSON.parse(body) || {};
+      } catch {
+        throw new HttpError(400, 'bad_request', 'Malformed request.');
+      }
+    }
+    const route = routes.find(([m, re]) => m === method && re.test(path));
+    if (!route) throw new HttpError(404, 'not_found', 'Not found.');
+    const params = path.match(route[1]).slice(1);
+    payload = await route[2](ctx, ...params);
+  } catch (err) {
+    if (err instanceof HttpError) {
+      status = err.status;
+      payload = { error: err.code, message: err.message, ...err.extra };
+    } else {
+      console.error('[passkey-server]', err);
+      status = 500;
+      payload = { error: 'server_error', message: 'Something went wrong. Please try again.' };
+    }
+  }
+  // Persist even on failure so consumed challenges stay consumed.
+  saveDb(db);
+  return { status, body: JSON.stringify(payload), setSession: ctx.setSession };
+}
+
+let queue = Promise.resolve();
+
+/** Handle one request. Requests are serialised (across tabs where supported). */
+export function handle(request) {
+  const run = () => process(request);
+  if (navigator.locks?.request) return navigator.locks.request('daily-grind-rp', run);
+  const result = queue.then(run, run);
+  queue = result.catch(() => {});
+  return result;
+}
