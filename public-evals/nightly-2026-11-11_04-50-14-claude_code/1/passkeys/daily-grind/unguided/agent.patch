@@ -0,0 +1,330 @@
+/**
+ * Low-level WebAuthn helpers shared by the browser UI and the relying-party
+ * (server) module: base64url, CBOR decoding, authenticator-data parsing,
+ * COSE key handling and signature verification via WebCrypto.
+ */
+
+const textEncoder = new TextEncoder();
+const textDecoder = new TextDecoder();
+
+export const utf8 = {
+  encode: (str) => textEncoder.encode(str),
+  decode: (bytes) => textDecoder.decode(bytes),
+};
+
+export const b64url = {
+  encode(input) {
+    const bytes = input instanceof Uint8Array ? input : new Uint8Array(input);
+    let binary = '';
+    for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  },
+  decode(str) {
+    if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+      throw new TypeError('Invalid base64url string');
+    }
+    const base64 = str.replace(/-/g, '+').replace(/_/g, '/');
+    const binary = atob(base64 + '==='.slice((base64.length + 3) % 4));
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+    return bytes;
+  },
+};
+
+export function bytesEqual(a, b) {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+}
+
+export function concatBytes(...parts) {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let offset = 0;
+  for (const p of parts) {
+    out.set(p, offset);
+    offset += p.length;
+  }
+  return out;
+}
+
+export async function sha256(bytes) {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+}
+
+export function randomBase64url(byteLength = 32) {
+  return b64url.encode(crypto.getRandomValues(new Uint8Array(byteLength)));
+}
+
+/* ------------------------------------------------------------------------ */
+/* CBOR (RFC 8949) – the subset used by CTAP2 / WebAuthn (definite lengths)  */
+/* ------------------------------------------------------------------------ */
+
+export function decodeCbor(bytes, start = 0) {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  let pos = start;
+
+  const need = (n) => {
+    if (pos + n > bytes.length) throw new Error('CBOR: unexpected end of data');
+  };
+
+  const readLength = (info) => {
+    if (info < 24) return info;
+    if (info === 24) { need(1); return bytes[pos++]; }
+    if (info === 25) { need(2); const v = view.getUint16(pos); pos += 2; return v; }
+    if (info === 26) { need(4); const v = view.getUint32(pos); pos += 4; return v; }
+    if (info === 27) {
+      need(8);
+      const v = view.getBigUint64(pos);
+      pos += 8;
+      if (v > BigInt(Number.MAX_SAFE_INTEGER)) throw new Error('CBOR: integer too large');
+      return Number(v);
+    }
+    throw new Error('CBOR: indefinite lengths are not supported');
+  };
+
+  const readItem = (depth) => {
+    if (depth > 16) throw new Error('CBOR: nesting too deep');
+    need(1);
+    const initial = bytes[pos++];
+    const major = initial >> 5;
+    const info = initial & 0x1f;
+
+    if (major === 7) {
+      switch (info) {
+        case 20: return false;
+        case 21: return true;
+        case 22: return null;
+        case 23: return undefined;
+        case 26: { need(4); const v = view.getFloat32(pos); pos += 4; return v; }
+        case 27: { need(8); const v = view.getFloat64(pos); pos += 8; return v; }
+        default: throw new Error(`CBOR: unsupported simple value ${info}`);
+      }
+    }
+
+    const length = readLength(info);
+    switch (major) {
+      case 0: return length;
+      case 1: return -1 - length;
+      case 2: { need(length); const v = bytes.slice(pos, pos + length); pos += length; return v; }
+      case 3: { need(length); const v = utf8.decode(bytes.subarray(pos, pos + length)); pos += length; return v; }
+      case 4: {
+        const arr = [];
+        for (let i = 0; i < length; i++) arr.push(readItem(depth + 1));
+        return arr;
+      }
+      case 5: {
+        const map = new Map();
+        for (let i = 0; i < length; i++) {
+          const key = readItem(depth + 1);
+          map.set(key, readItem(depth + 1));
+        }
+        return map;
+      }
+      case 6: return readItem(depth + 1); // tags: return the tagged value
+      default: throw new Error('CBOR: invalid major type');
+    }
+  };
+
+  const value = readItem(0);
+  return { value, offset: pos };
+}
+
+/* ------------------------------------------------------------------------ */
+/* Authenticator data                                                        */
+/* ------------------------------------------------------------------------ */
+
+export const AuthDataFlags = {
+  UP: 0x01, // user present
+  UV: 0x04, // user verified
+  BE: 0x08, // backup eligible (multi-device / synced credential)
+  BS: 0x10, // backup state (currently backed up / synced)
+  AT: 0x40, // attested credential data included
+  ED: 0x80, // extension data included
+};
+
+function formatAaguid(bytes) {
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+export function parseAuthenticatorData(authData) {
+  if (authData.length < 37) throw new Error('Authenticator data is too short');
+  const view = new DataView(authData.buffer, authData.byteOffset, authData.byteLength);
+  const flags = authData[32];
+  const result = {
+    rpIdHash: authData.slice(0, 32),
+    flags,
+    userPresent: !!(flags & AuthDataFlags.UP),
+    userVerified: !!(flags & AuthDataFlags.UV),
+    backupEligible: !!(flags & AuthDataFlags.BE),
+    backupState: !!(flags & AuthDataFlags.BS),
+    signCount: view.getUint32(33),
+  };
+
+  let pos = 37;
+  if (flags & AuthDataFlags.AT) {
+    if (authData.length < pos + 18) throw new Error('Attested credential data is truncated');
+    result.aaguid = formatAaguid(authData.subarray(pos, pos + 16));
+    pos += 16;
+    const idLength = view.getUint16(pos);
+    pos += 2;
+    if (idLength > 1023 || authData.length < pos + idLength) throw new Error('Invalid credential ID length');
+    result.credentialId = authData.slice(pos, pos + idLength);
+    pos += idLength;
+    const { value, offset } = decodeCbor(authData, pos);
+    if (!(value instanceof Map)) throw new Error('Credential public key is not a COSE map');
+    result.credentialPublicKey = value;
+    pos = offset;
+  }
+  if (flags & AuthDataFlags.ED) {
+    const { value, offset } = decodeCbor(authData, pos);
+    result.extensions = value;
+    pos = offset;
+  }
+  if (pos !== authData.length) throw new Error('Unexpected trailing bytes in authenticator data');
+  return result;
+}
+
+/* ------------------------------------------------------------------------ */
+/* COSE keys and signature verification                                      */
+/* ------------------------------------------------------------------------ */
+
+export const COSE_ALG = { ES256: -7, RS256: -257 };
+
+/** Convert a COSE_Key map into a serialisable { alg, jwk } record. */
+export function coseKeyToJwk(cose) {
+  const kty = cose.get(1);
+  const alg = cose.get(3);
+  if (alg === COSE_ALG.ES256) {
+    if (kty !== 2 || cose.get(-1) !== 1) throw new Error('ES256 key must be an EC2 P-256 key');
+    const x = cose.get(-2);
+    const y = cose.get(-3);
+    if (!(x instanceof Uint8Array) || !(y instanceof Uint8Array) || x.length !== 32 || y.length !== 32) {
+      throw new Error('Malformed EC2 public key');
+    }
+    return { alg, jwk: { kty: 'EC', crv: 'P-256', x: b64url.encode(x), y: b64url.encode(y) } };
+  }
+  if (alg === COSE_ALG.RS256) {
+    if (kty !== 3) throw new Error('RS256 key must be an RSA key');
+    const n = cose.get(-1);
+    const e = cose.get(-2);
+    if (!(n instanceof Uint8Array) || !(e instanceof Uint8Array) || n.length < 256) {
+      throw new Error('Malformed RSA public key');
+    }
+    return { alg, jwk: { kty: 'RSA', n: b64url.encode(n), e: b64url.encode(e) } };
+  }
+  throw new Error(`Unsupported COSE algorithm ${alg}`);
+}
+
+/** ECDSA signatures from authenticators are DER encoded; WebCrypto wants raw r||s. */
+function derEcdsaToRaw(der, size = 32) {
+  let pos = 0;
+  const readLen = () => {
+    let len = der[pos++];
+    if (len & 0x80) {
+      const n = len & 0x7f;
+      len = 0;
+      for (let i = 0; i < n; i++) len = (len << 8) | der[pos++];
+    }
+    return len;
+  };
+  const readInt = () => {
+    if (der[pos++] !== 0x02) throw new Error('Invalid DER signature');
+    const len = readLen();
+    let int = der.subarray(pos, pos + len);
+    pos += len;
+    while (int.length > size && int[0] === 0) int = int.subarray(1);
+    if (int.length > size) throw new Error('Invalid DER integer');
+    const out = new Uint8Array(size);
+    out.set(int, size - int.length);
+    return out;
+  };
+  if (der[pos++] !== 0x30) throw new Error('Invalid DER signature');
+  readLen();
+  const r = readInt();
+  const s = readInt();
+  return concatBytes(r, s);
+}
+
+export async function verifySignature({ alg, jwk }, signature, data) {
+  if (alg === COSE_ALG.ES256) {
+    const key = await crypto.subtle.importKey('jwk', jwk, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+    let raw;
+    try {
+      raw = derEcdsaToRaw(signature);
+    } catch {
+      return false;
+    }
+    return crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, raw, data);
+  }
+  if (alg === COSE_ALG.RS256) {
+    const key = await crypto.subtle.importKey('jwk', jwk, { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, false, ['verify']);
+    return crypto.subtle.verify({ name: 'RSASSA-PKCS1-v1_5' }, key, signature, data);
+  }
+  throw new Error(`Unsupported algorithm ${alg}`);
+}
+
+/* ------------------------------------------------------------------------ */
+/* Browser-side JSON <-> WebAuthn object conversion (with fallbacks)          */
+/* ------------------------------------------------------------------------ */
+
+const decodeDescriptor = (d) => ({ ...d, id: b64url.decode(d.id) });
+
+export function creationOptionsFromJSON(json) {
+  if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+    return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+  }
+  return {
+    ...json,
+    challenge: b64url.decode(json.challenge),
+    user: { ...json.user, id: b64url.decode(json.user.id) },
+    excludeCredentials: (json.excludeCredentials || []).map(decodeDescriptor),
+  };
+}
+
+export function requestOptionsFromJSON(json) {
+  if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+    return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+  }
+  return {
+    ...json,
+    challenge: b64url.decode(json.challenge),
+    allowCredentials: (json.allowCredentials || []).map(decodeDescriptor),
+  };
+}
+
+/**
+ * Serialise a PublicKeyCredential. We build the JSON by hand rather than
+ * relying on credential.toJSON(), which some password-manager extensions
+ * have historically shimmed incorrectly.
+ */
+export function credentialToJSON(cred) {
+  const { response } = cred;
+  const base = {
+    id: cred.id,
+    rawId: b64url.encode(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? null,
+    clientExtensionResults: cred.getClientExtensionResults?.() ?? {},
+  };
+  if ('attestationObject' in response) {
+    return {
+      ...base,
+      response: {
+        clientDataJSON: b64url.encode(response.clientDataJSON),
+        attestationObject: b64url.encode(response.attestationObject),
+        transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+      },
+    };
+  }
+  return {
+    ...base,
+    response: {
+      clientDataJSON: b64url.encode(response.clientDataJSON),
+      authenticatorData: b64url.encode(response.authenticatorData),
+      signature: b64url.encode(response.signature),
+      userHandle: response.userHandle ? b64url.encode(response.userHandle) : null,
+    },
+  };
+}
