+        </div>
+        <p className="text-sm text-gray-600 mb-4">
+          Passkeys let you sign in with your fingerprint, face or screen lock. They’re stored in your password
+          manager or on your security key and can’t be phished or leaked in a data breach.
+        </p>
+
+        {!supported && (
+          <div className="mb-4 p-3 text-sm text-yellow-800 bg-yellow-50 border border-yellow-200 rounded-lg">
+            This browser doesn’t support passkeys. Try a recent version of Chrome, Safari, Edge or Firefox.
+          </div>
