@@ -0,0 +1,54 @@
+import type { APIRoute } from 'astro';
+import { getAuth, getCurrentUser, isRecentlyVerified } from '../../../../lib/auth/session';
+import { deletePasskey, getPasskey, getPasskeysForUser, updatePasskey } from '../../../../lib/auth/store';
+import { errorResponse, getRelyingParty, json, toPublicPasskey } from '../../../../lib/auth/webauthn';
+
+async function loadOwnedPasskey(session: Parameters<APIRoute>[0]['session'], id: string | undefined) {
+  const user = await getCurrentUser(session);
+  if (!user) return { error: errorResponse(401, 'NOT_SIGNED_IN', 'Please sign in first.') };
+  const passkey = id ? await getPasskey(id) : undefined;
+  if (!passkey || passkey.userId !== user.id) {
+    return { error: errorResponse(404, 'NOT_FOUND', 'Passkey not found.') };
+  }
+  return { user, passkey };
+}
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const { error, passkey } = await loadOwnedPasskey(session, params.id);
+  if (error) return error;
+
+  const { name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return errorResponse(400, 'INVALID_NAME', 'Passkey names must be 1–64 characters.');
+  }
+  const updated = await updatePasskey(passkey!.id, { name: trimmed });
+  return json({ ok: true, passkey: toPublicPasskey(updated!) });
+};
+
+/** Delete a passkey. Requires a recent (re)authentication. */
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const { error, user, passkey } = await loadOwnedPasskey(session, params.id);
+  if (error) return error;
+
+  if (!isRecentlyVerified(await getAuth(session))) {
+    return errorResponse(401, 'REAUTH_REQUIRED', 'Please confirm it’s you before removing a passkey.');
+  }
+
+  const passkeys = await getPasskeysForUser(user!.id);
+  if (!user!.hasPassword && passkeys.length <= 1) {
+    return errorResponse(400, 'LAST_CREDENTIAL', 'You can’t remove your only passkey — you’d have no way to sign in. Create another passkey first.');
+  }
+
+  await deletePasskey(passkey!.id);
+  const remaining = passkeys.filter((p) => p.id !== passkey!.id);
+  return json({
+    ok: true,
+    signal: {
+      rpID: getRelyingParty(url).rpID,
+      userID: user!.id,
+      allAcceptedCredentialIDs: remaining.map((p) => p.id),
+    },
+  });
+};
