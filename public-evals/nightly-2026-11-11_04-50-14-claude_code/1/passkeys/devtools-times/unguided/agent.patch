@@ -0,0 +1,27 @@
+import type { APIRoute } from 'astro';
+import { verifyPassword } from '../../../../lib/auth/password';
+import { signIn } from '../../../../lib/auth/session';
+import { getPasskeysForUser, upsertPasswordUser } from '../../../../lib/auth/store';
+import { errorResponse, json } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return errorResponse(400, 'INVALID_INPUT', 'Username and password are required.');
+  }
+
+  let result;
+  try {
+    result = await verifyPassword(username.trim(), password);
+  } catch {
+    return errorResponse(502, 'UPSTREAM_UNAVAILABLE', 'The sign-in service is unavailable. Please try again later.');
+  }
+  if (!result.ok) {
+    return json({ ...result.data, error: result.data?.error || 'Unknown error' }, result.status || 401);
+  }
+
+  const user = await upsertPasswordUser(username);
+  await signIn(session, user, 'password');
+  const passkeys = await getPasskeysForUser(user.id);
+  return json({ ok: true, user: { username: user.username }, hasPasskeys: passkeys.length > 0 });
+};
