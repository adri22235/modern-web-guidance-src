+import React, { useEffect, useRef, useState } from 'react';
+import {
+  CheckCircleIcon,
+  CloudIcon,
+  DevicePhoneMobileIcon,
+  FingerPrintIcon,
+  KeyIcon,
+  PencilIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import {
+  api,
+  ApiError,
+  BASE_URL,
+  createPasskey,
+  describeError,
+  passkeysSupported,
+  reauthenticateWithPasskey,
+  syncPasskeySignals,
+} from '../lib/passkeys-client';
+
+export interface Passkey {
+  id: string;
+  name: string;
+  providerName?: string;
+  providerIcon?: string;
+  providerIconDark?: string;
+  synced: boolean;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+interface Props {
+  user: { id: string; username: string; hasPassword: boolean };
+  method?: 'password' | 'passkey';
+  rpID: string;
+  initialPasskeys: Passkey[];
+  welcome?: boolean;
+}
+
+const dateFormat = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+function formatRelative(iso?: string): string {
+  if (!iso) return 'Never';
+  const diff = Date.now() - new Date(iso).getTime();
+  const minutes = Math.round(diff / 60000);
+  if (minutes < 1) return 'Just now';
+  if (minutes < 60) return `${minutes} min ago`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 24) return `${hours} hr ago`;
+  return dateFormat.format(new Date(iso));
+}
+
+function Modal({ title, onClose, children }: { title: string; onClose: () => void; children: React.ReactNode }) {
+  const ref = useRef<HTMLDivElement>(null);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && onCloseRef.current();
+    document.addEventListener('keydown', onKey);
+    ref.current?.focus();
+    return () => document.removeEventListener('keydown', onKey);
+  }, []);
+
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" onClick={onClose}>
+      <div
+        ref={ref}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="modal-title"
+        tabIndex={-1}
+        className="w-full max-w-sm rounded-lg bg-white p-6 shadow-xl focus:outline-none"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="mb-4 flex items-start justify-between">
+          <h3 id="modal-title" className="text-lg font-bold text-gray-900">
+            {title}
+          </h3>
+          <button type="button" onClick={onClose} className="text-gray-400 hover:text-gray-600" aria-label="Close">
+            <XMarkIcon className="h-5 w-5" />
+          </button>
+        </div>
+        {children}
+      </div>
+    </div>
+  );
+}
+
+const primaryBtn =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+const secondaryBtn =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+const dangerBtn =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 disabled:opacity-60 disabled:cursor-not-allowed';
+
+export default function AccountSettings({ user, method, rpID, initialPasskeys, welcome }: Props) {
+  const [passkeys, setPasskeys] = useState<Passkey[]>(initialPasskeys);
+  const [supported, setSupported] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(
+    welcome ? 'Welcome to The DevTools Times! Your account is ready.' : null,
+  );
+  const [creating, setCreating] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+  const [confirmDelete, setConfirmDelete] = useState<Passkey | null>(null);
+  const [deleting, setDeleting] = useState(false);
+
+  // Reauthentication state
+  const [reauthOpen, setReauthOpen] = useState(false);
+  const [reauthError, setReauthError] = useState<string | null>(null);
+  const [reauthBusy, setReauthBusy] = useState(false);
+  const [reauthPassword, setReauthPassword] = useState('');
+  const [reauthDone, setReauthDone] = useState(false);
+  const pendingAction = useRef<{ run: () => Promise<void>; needsGesture: boolean; label: string } | null>(null);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    // Let passkey providers hide passkeys that were removed elsewhere and
+    // show the current username.
+    syncPasskeySignals({
+      rpID,
+      userID: user.id,
+      userName: user.username,
+      allAcceptedCredentialIDs: initialPasskeys.map((p) => p.id),
+    });
+  }, []);
+
+  const refresh = async () => {
+    const data = await api('me');
+    if (data.user) setPasskeys(data.passkeys);
+  };
+
+  /**
+   * Run a sensitive action. If the server says the session is too old, ask the
+   * user to confirm their identity first and then retry automatically.
+   */
+  const withReauth = async (
+    action: () => Promise<void>,
+    { needsGesture = false, label = 'Continue' }: { needsGesture?: boolean; label?: string } = {},
+  ) => {
+    try {
+      await action();
+    } catch (err) {
+      if (err instanceof ApiError && err.code === 'REAUTH_REQUIRED') {
+        pendingAction.current = { run: action, needsGesture, label };
+        setReauthDone(false);
+        setReauthError(null);
+        setReauthPassword('');
+        setReauthOpen(true);
+        return;
+      }
+      throw err;
+    }
+  };
+
+  const closeReauth = () => {
+    setReauthOpen(false);
+    setReauthDone(false);
+    pendingAction.current = null;
+    setCreating(false);
+    setDeleting(false);
+  };
+
+  /** Called once the user has re-verified; runs (or offers to run) the pending action. */
+  const completeReauth = async () => {
+    const pending = pendingAction.current;
+    // WebAuthn calls need a fresh user gesture in some browsers (e.g. Safari),
+    // so ask for one more click instead of retrying automatically.
+    if (pending?.needsGesture) {
+      setReauthDone(true);
+      return;
+    }
+    await runPending();
+  };
+
+  const runPending = async () => {
+    setReauthOpen(false);
+    setReauthDone(false);
+    const pending = pendingAction.current;
+    pendingAction.current = null;
+    if (!pending) return;
+    try {
+      await pending.run();
+    } catch (err) {
+      const message = describeError(err);
+      if (message) setError(message);
+      setCreating(false);
+      setDeleting(false);
+    }
+  };
+
+  const handleReauthPasskey = async () => {
+    setReauthError(null);
+    setReauthBusy(true);
+    try {
+      await reauthenticateWithPasskey();
+      await completeReauth();
+    } catch (err) {
+      const message = describeError(err);
+      if (message) setReauthError(message);
+    } finally {
+      setReauthBusy(false);
+    }
+  };
+
+  const handleReauthPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setReauthError(null);
+    setReauthBusy(true);
+    try {
+      await api('reauth', { body: { password: reauthPassword } });
+      setReauthPassword('');
+      await completeReauth();
+    } catch (err) {
+      setReauthError(describeError(err));
+    } finally {
+      setReauthBusy(false);
+    }
+  };
+
+  // -------------------------------------------------------------------------
+  // Passkey actions
+  // -------------------------------------------------------------------------
+
+  const handleCreate = async () => {
+    setError(null);
+    setNotice(null);
+    setCreating(true);
+    try {
+      await withReauth(async () => {
+        const result = await createPasskey();
+        setPasskeys((prev) => [...prev, result.passkey]);
+        setNotice(`Passkey “${result.passkey.name}” created. You can now use it to sign in.`);
+        setCreating(false);
+      }, { needsGesture: true, label: 'Create passkey' });
+    } catch (err) {
+      const message = describeError(err);
+      if (message) setError(message);
+      setCreating(false);
+    }
+  };
+
+  const startRename = (p: Passkey) => {
+    setEditingId(p.id);
+    setEditName(p.name);
+    setError(null);
+  };
+
+  const saveRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!editingId) return;
+    try {
+      const { passkey } = await api(`passkeys/${encodeURIComponent(editingId)}`, {
+        method: 'PATCH',
+        body: { name: editName },
+      });
+      setPasskeys((prev) => prev.map((p) => (p.id === passkey.id ? passkey : p)));
+      setEditingId(null);
+    } catch (err) {
+      setError(describeError(err));
+    }
+  };
+
+  const handleDelete = async () => {
+    const target = confirmDelete;
+    if (!target) return;
+    setConfirmDelete(null);
+    setError(null);
+    setNotice(null);
+    setDeleting(true);
+    try {
+      await withReauth(async () => {
+        const result = await api(`passkeys/${encodeURIComponent(target.id)}`, { method: 'DELETE' });
+        setPasskeys((prev) => prev.filter((p) => p.id !== target.id));
+        setNotice(
+          `Passkey “${target.name}” removed. You may also want to delete it from ${target.providerName ?? 'your password manager'}.`,
+        );
+        setDeleting(false);
+        // Ask the provider to hide the deleted passkey from future prompts.
+        await syncPasskeySignals(result.signal);
+      });
+    } catch (err) {
+      setError(describeError(err));
+      setDeleting(false);
+      refresh().catch(() => {});
+    }
+  };
+
+  const handleSignOut = async () => {
+    await api('signout', { body: {} }).catch(() => {});
+    window.location.assign(BASE_URL);
+  };
+
+  const onlyCredential = !user.hasPassword && passkeys.length <= 1;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex flex-wrap items-end justify-between gap-4 border-b border-gray-900 pb-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            Signed in as <span className="font-semibold text-gray-900">{user.username}</span>
+            {method && <> with {method === 'passkey' ? 'a passkey' : 'a password'}</>}
+          </p>
+        </div>
+        <button type="button" onClick={handleSignOut} className={secondaryBtn}>
+          Sign out
+        </button>
+      </div>
+
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      {notice && (
+        <div className="flex items-start gap-2 p-3 text-sm text-green-800 bg-green-100 rounded-lg" role="status">
+          <CheckCircleIcon className="h-5 w-5 flex-shrink-0" aria-hidden="true" />
+          <span>{notice}</span>
+        </div>
+      )}
+
+      {/* Sign-in methods overview */}
+      <section aria-labelledby="signin-methods">
+        <h2 id="signin-methods" className="text-xl font-bold text-gray-900 mb-3">
+          Sign-in methods
+        </h2>
+        <ul className="divide-y divide-gray-200 rounded-lg border border-gray-200">
+          <li className="flex items-center gap-3 p-4">
+            <KeyIcon className="h-6 w-6 text-gray-500" aria-hidden="true" />
+            <div className="flex-1">
+              <p className="text-sm font-medium text-gray-900">Password</p>
+              <p className="text-xs text-gray-500">{user.hasPassword ? 'Set' : 'Not set — this account uses passkeys only'}</p>
+            </div>
+          </li>
+          <li className="flex items-center gap-3 p-4">
+            <FingerPrintIcon className="h-6 w-6 text-gray-500" aria-hidden="true" />
+            <div className="flex-1">
+              <p className="text-sm font-medium text-gray-900">Passkeys</p>
+              <p className="text-xs text-gray-500">
+                {passkeys.length === 0 ? 'None yet' : `${passkeys.length} passkey${passkeys.length === 1 ? '' : 's'}`}
+              </p>
+            </div>
+          </li>
+        </ul>
+      </section>
+
+      {/* Passkey management */}
+      <section aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-center justify-between gap-3 mb-3">
+          <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">
+            Passkeys
+          </h2>
+          {supported && (
+            <button type="button" onClick={handleCreate} disabled={creating} className={primaryBtn}>
+              <FingerPrintIcon className="h-5 w-5" aria-hidden="true" />
+              {creating ? 'Waiting for passkey…' : 'Create a passkey'}
+            </button>
