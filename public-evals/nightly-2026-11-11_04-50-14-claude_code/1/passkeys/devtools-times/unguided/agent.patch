+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { getAuth, getCurrentUser } from '../lib/auth/session';
+import { getPasskeysForUser } from '../lib/auth/store';
+import { getRelyingParty, toPublicPasskey } from '../lib/auth/webauthn';
+
+const baseUrl = import.meta.env.BASE_URL;
+const user = await getCurrentUser(Astro.session);
+if (!user) {
+  return Astro.redirect(`${baseUrl}signin?next=${encodeURIComponent(Astro.url.pathname)}`);
+}
+const auth = await getAuth(Astro.session);
+const passkeys = (await getPasskeysForUser(user.id)).map(toPublicPasskey);
+const { rpID } = getRelyingParty(Astro.url);
+const welcome = Astro.url.searchParams.has('welcome');
+Astro.response.headers.set('Cache-Control', 'no-store');
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings
+      client:load
+      user={{ id: user.id, username: user.username, hasPassword: user.hasPassword }}
+      method={auth?.method}
+      rpID={rpID}
+      initialPasskeys={passkeys}
+      welcome={welcome}
+    />
+  </div>
+</Layout>
