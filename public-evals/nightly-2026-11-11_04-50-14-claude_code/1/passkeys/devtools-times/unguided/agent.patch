+            <p className="text-xs text-gray-500 mt-1">
+               Must be at least 8 characters and contain a number.
+            </p>
+          </div>
+
+          <button type="submit" disabled={loading} data-skip-tracking="true" className={primaryButton}>
+            {loading ? 'Signing up...' : 'Sign Up'}
+          </button>
+        </form>
+      )}
+
+      <p className="mt-6 text-center text-sm text-gray-600">
+        Already have an account?{' '}
+        <a href={`${BASE_URL}signin`} className="font-medium text-gray-900 underline hover:text-gray-700">
+          Sign in
+        </a>
+      </p>
     </div>
   );
 }
