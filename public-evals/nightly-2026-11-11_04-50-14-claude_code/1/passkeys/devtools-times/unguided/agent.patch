+import type { APIRoute } from 'astro';
+import { getAuth, getCurrentUser, isRecentlyVerified } from '../../../lib/auth/session';
+import { getPasskeysForUser } from '../../../lib/auth/store';
+import { getRelyingParty, json, toPublicPasskey } from '../../../lib/auth/webauthn';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return json({ user: null });
+  const auth = await getAuth(session);
+  const passkeys = await getPasskeysForUser(user.id);
+  return json({
