--- /dev/null
+++ b/src/lib/auth/password.ts
@@ -0,0 +1,31 @@
+/**
+ * Thin server-side proxy to the external password service. Calling it from the
+ * server lets us bind a successful password check to the local session (needed
+ * for account settings and passkey management).
+ */
+const PASSWORD_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface PasswordResult {
+  ok: boolean;
+  status: number;
+  data: any;
+}
+
+async function call(endpoint: 'login' | 'register', username: string, password: string): Promise<PasswordResult> {
+  const response = await fetch(`${PASSWORD_API}/${endpoint}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+    signal: AbortSignal.timeout(10_000),
+  });
+  let data: any = {};
+  try {
+    data = await response.json();
+  } catch {
+    /* non-JSON body */
+  }
+  return { ok: response.ok, status: response.status, data };
+}
+
+export const verifyPassword = (username: string, password: string) => call('login', username, password);
+export const registerPassword = (username: string, password: string) => call('register', username, password);
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..4efe45c
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,94 @@
+import type { AstroSession } from 'astro';
+import { getUserById, type UserRecord } from './store';
+import { CHALLENGE_TTL_MS } from './webauthn';
+
+/** Sensitive actions require the user to have (re)authenticated within this window. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export type AuthMethod = 'password' | 'passkey';
+
+export interface AuthSession {
+  userId: string;
+  method: AuthMethod;
+  /** Epoch ms of the initial sign-in. */
+  signedInAt: number;
+  /** Epoch ms of the most recent successful (re)authentication. */
+  verifiedAt: number;
+}
+
+export type ChallengePurpose = 'signin' | 'reauth' | 'register' | 'signup';
+
+export interface PendingChallenge {
+  challenge: string;
+  purpose: ChallengePurpose;
+  createdAt: number;
+  /** Only for passkey sign-up: the account that will be created on success. */
+  pendingUser?: { id: string; username: string };
+  /** For registration: whether this was a conditional (automatic) create. */
+  conditional?: boolean;
+}
+
+declare global {
+  namespace App {
+    interface SessionData {
+      auth: AuthSession;
+      webauthnChallenge: PendingChallenge;
+    }
+  }
+}
+
+type Session = AstroSession | undefined;
+
+export async function getAuth(session: Session): Promise<AuthSession | undefined> {
+  return (await session?.get('auth')) ?? undefined;
+}
+
+export async function getCurrentUser(session: Session): Promise<UserRecord | undefined> {
+  const auth = await getAuth(session);
+  if (!auth) return undefined;
+  const user = await getUserById(auth.userId);
+  if (!user) session?.delete('auth');
+  return user;
+}
+
+export async function signIn(session: Session, user: UserRecord, method: AuthMethod): Promise<void> {
+  if (!session) throw new Error('Sessions are not configured');
+  // Preserve non-auth session data (e.g. the reading list) but rotate the ID
+  // to prevent session fixation.
+  await session.regenerate();
+  const now = Date.now();
+  session.set('auth', { userId: user.id, method, signedInAt: now, verifiedAt: now });
+}
+
+export async function markReauthenticated(session: Session): Promise<void> {
+  const auth = await getAuth(session);
+  if (!auth || !session) return;
+  session.set('auth', { ...auth, verifiedAt: Date.now() });
+}
+
+export function isRecentlyVerified(auth: AuthSession | undefined): boolean {
+  return !!auth && Date.now() - auth.verifiedAt < REAUTH_WINDOW_MS;
+}
+
+export function signOut(session: Session): void {
+  session?.delete('auth');
+  session?.delete('webauthnChallenge');
+}
+
+export function storeChallenge(session: Session, challenge: Omit<PendingChallenge, 'createdAt'>): void {
+  if (!session) throw new Error('Sessions are not configured');
+  session.set('webauthnChallenge', { ...challenge, createdAt: Date.now() });
+}
+
+/** Read and invalidate the pending challenge (challenges are single use). */
+export async function consumeChallenge(
+  session: Session,
+  purposes: ChallengePurpose[],
+): Promise<PendingChallenge | undefined> {
+  const pending = await session?.get('webauthnChallenge');
+  if (!pending) return undefined;
+  session?.delete('webauthnChallenge');
+  if (!purposes.includes(pending.purpose)) return undefined;
+  if (Date.now() - pending.createdAt > CHALLENGE_TTL_MS) return undefined;
+  return pending;
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..76ec113
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,170 @@
+/**
+ * A tiny JSON-file backed store for user accounts and their passkeys.
+ *
+ * Password verification for The DevTools Times is handled by the external
+ * "times_cdn" API, so this store only keeps the local account record (needed
+ * as the WebAuthn user handle) and the public-key credentials registered for it.
+ *
+ * The location can be overridden with the AUTH_DATA_FILE environment variable.
+ */
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface UserRecord {
+  /** Random, opaque base64url identifier. Also used as the WebAuthn user handle. */
+  id: string;
+  username: string;
+  /** True if the account was created / verified through the password service. */
+  hasPassword: boolean;
+  createdAt: string;
+}
+
+export interface PasskeyRecord {
+  /** base64url credential ID */
+  id: string;
+  userId: string;
+  /** base64url-encoded COSE public key */
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  name: string;
+  aaguid: string;
+  providerName?: string;
+  providerIcon?: string;
+  providerIconDark?: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+interface Data {
+  users: UserRecord[];
+  passkeys: PasskeyRecord[];
+}
+
+const DATA_FILE =
+  process.env.AUTH_DATA_FILE ?? path.join(process.cwd(), '.data', 'auth.json');
+
+let cache: Data | null = null;
+let writeChain: Promise<void> = Promise.resolve();
+
+async function load(): Promise<Data> {
+  if (cache) return cache;
+  try {
+    const raw = await fs.readFile(DATA_FILE, 'utf8');
+    const parsed = JSON.parse(raw) as Partial<Data>;
+    cache = { users: parsed.users ?? [], passkeys: parsed.passkeys ?? [] };
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') console.error('[auth-store] Failed to read data file', err);
+    cache = { users: [], passkeys: [] };
+  }
+  return cache;
+}
+
+function persist(): Promise<void> {
+  const snapshot = JSON.stringify(cache, null, 2);
+  writeChain = writeChain
+    .then(async () => {
+      await fs.mkdir(path.dirname(DATA_FILE), { recursive: true });
+      const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+      await fs.writeFile(tmp, snapshot, 'utf8');
+      await fs.rename(tmp, DATA_FILE);
+    })
+    .catch((err) => console.error('[auth-store] Failed to write data file', err));
+  return writeChain;
+}
+
+const normalize = (username: string) => username.trim().toLowerCase();
+
+export function newUserId(): string {
+  return randomBytes(32).toString('base64url');
+}
+
+// ---------------------------------------------------------------------------
+// Users
+// ---------------------------------------------------------------------------
+
+export async function getUserById(id: string): Promise<UserRecord | undefined> {
+  const data = await load();
+  return data.users.find((u) => u.id === id);
+}
+
+export async function getUserByUsername(username: string): Promise<UserRecord | undefined> {
+  const data = await load();
+  const n = normalize(username);
+  return data.users.find((u) => normalize(u.username) === n);
+}
+
+export async function createUser(user: UserRecord): Promise<UserRecord> {
+  const data = await load();
+  if (data.users.some((u) => normalize(u.username) === normalize(user.username))) {
+    throw new Error('USERNAME_TAKEN');
+  }
+  data.users.push(user);
+  await persist();
+  return user;
+}
+
+/** Find the local record for a password-authenticated user, creating it if needed. */
+export async function upsertPasswordUser(username: string): Promise<UserRecord> {
+  const existing = await getUserByUsername(username);
+  if (existing) {
+    if (!existing.hasPassword) {
+      existing.hasPassword = true;
+      await persist();
+    }
+    return existing;
+  }
+  return createUser({
+    id: newUserId(),
+    username: username.trim(),
+    hasPassword: true,
+    createdAt: new Date().toISOString(),
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Passkeys
+// ---------------------------------------------------------------------------
+
+export async function getPasskeysForUser(userId: string): Promise<PasskeyRecord[]> {
+  const data = await load();
+  return data.passkeys.filter((p) => p.userId === userId);
+}
+
+export async function getPasskey(id: string): Promise<PasskeyRecord | undefined> {
+  const data = await load();
+  return data.passkeys.find((p) => p.id === id);
+}
+
+export async function addPasskey(passkey: PasskeyRecord): Promise<void> {
+  const data = await load();
+  if (data.passkeys.some((p) => p.id === passkey.id)) {
+    throw new Error('CREDENTIAL_EXISTS');
+  }
+  data.passkeys.push(passkey);
+  await persist();
+}
+
+export async function updatePasskey(
+  id: string,
+  patch: Partial<Pick<PasskeyRecord, 'name' | 'counter' | 'lastUsedAt' | 'backedUp' | 'deviceType'>>,
+): Promise<PasskeyRecord | undefined> {
+  const data = await load();
+  const passkey = data.passkeys.find((p) => p.id === id);
+  if (!passkey) return undefined;
+  Object.assign(passkey, patch);
+  await persist();
+  return passkey;
+}
+
+export async function deletePasskey(id: string): Promise<boolean> {
+  const data = await load();
+  const before = data.passkeys.length;
+  data.passkeys = data.passkeys.filter((p) => p.id !== id);
+  if (data.passkeys.length === before) return false;
+  await persist();
+  return true;
+}
diff --git a/src/lib/auth/webauthn.ts b/src/lib/auth/webauthn.ts
new file mode 100644
index 0000000..4543160
--- /dev/null
+++ b/src/lib/auth/webauthn.ts
@@ -0,0 +1,124 @@
+import { ConvenienceMetadataService } from '@simplewebauthn/server';
+import type { PasskeyRecord } from './store';
+
+export const RP_NAME = 'The DevTools Times';
+
+/** How long a WebAuthn challenge stays valid. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+/**
+ * Resolve the Relying Party ID and expected origin for the current request.
+ * Both can be pinned via PASSKEY_RP_ID / PASSKEY_ORIGIN (comma-separated list
+ * of origins) when running behind a proxy that rewrites the Host header.
+ */
+export function getRelyingParty(url: URL): { rpID: string; origins: string[] } {
+  const rpID = process.env.PASSKEY_RP_ID || url.hostname;
+  const origins = process.env.PASSKEY_ORIGIN
+    ? process.env.PASSKEY_ORIGIN.split(',').map((o) => o.trim()).filter(Boolean)
+    : [url.origin];
+  return { rpID, origins };
+}
+
+// ---------------------------------------------------------------------------
+// Passkey provider metadata (friendly name + icon by AAGUID)
+// ---------------------------------------------------------------------------
+
+/** Small offline fallback for the most common passkey providers. */
+const KNOWN_PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+};
+
+let mdsReady: Promise<boolean> | null = null;
+
+function initMetadataService(): Promise<boolean> {
+  if (!mdsReady) {
+    const timeout = new Promise<boolean>((resolve) => setTimeout(() => resolve(false), 3000));
+    mdsReady = Promise.race([
+      ConvenienceMetadataService.initialize().then(() => true),
+      timeout,
+    ]).catch((err) => {
+      console.warn('[passkeys] Convenience MDS unavailable, using built-in provider list', err);
+      return false;
+    });
+  }
+  return mdsReady;
+}
+
+export interface ProviderInfo {
+  name?: string;
+  icon?: string;
+  iconDark?: string;
+}
+
+export async function getProviderInfo(aaguid: string): Promise<ProviderInfo> {
+  const fallback: ProviderInfo = { name: KNOWN_PROVIDERS[aaguid] };
+  if (!aaguid || /^0{8}-0{4}-0{4}-0{4}-0{12}$/.test(aaguid)) return fallback;
+  try {
+    if (await initMetadataService()) {
+      const meta = await ConvenienceMetadataService.getProviderMetadata(aaguid);
+      if (meta) {
+        const names = meta.friendlyNames ?? {};
+        const name =
+          names['en-US'] ?? names['en'] ?? Object.values(names)[0] ?? fallback.name;
+        return { name, icon: meta.icon, iconDark: meta.iconDark };
+      }
+    }
+  } catch (err) {
+    console.warn('[passkeys] Provider metadata lookup failed', err);
+  }
+  return fallback;
+}
+
+// ---------------------------------------------------------------------------
+// Serialization helpers
+// ---------------------------------------------------------------------------
+
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  providerName?: string;
+  providerIcon?: string;
+  providerIconDark?: string;
+  synced: boolean;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export function toPublicPasskey(p: PasskeyRecord): PublicPasskey {
+  return {
+    id: p.id,
+    name: p.name,
+    providerName: p.providerName,
+    providerIcon: p.providerIcon,
+    providerIconDark: p.providerIconDark,
+    synced: p.backedUp,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function errorResponse(status: number, code: string, message: string, extra: Record<string, unknown> = {}): Response {
+  return json({ error: message, code, ...extra }, status);
+}
diff --git a/src/lib/passkeys-client.ts b/src/lib/passkeys-client.ts
new file mode 100644
index 0000000..bb49e54
--- /dev/null
+++ b/src/lib/passkeys-client.ts
@@ -0,0 +1,220 @@
+/**
+ * Browser-side helpers shared by the sign-in, sign-up and account settings UI.
+ */
+import {
+  browserSupportsWebAuthn,
+  getBrowserCapabilities,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+  WebAuthnAbortService,
+  type BrowserCapabilities,
+} from '@simplewebauthn/browser';
+
+export const BASE_URL = import.meta.env.BASE_URL.endsWith('/')
+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number, public code?: string, public data: any = {}) {
+    super(message);
+  }
+}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const response = await fetch(`${BASE_URL}api/auth/${path}`, {
+    method: init.method ?? (init.body !== undefined ? 'POST' : 'GET'),
+    headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+    body: init.body !== undefined ? JSON.stringify(init.body) : undefined,
+    credentials: 'same-origin',
+  });
+  let data: any = {};
+  try {
+    data = await response.json();
+  } catch {
+    /* empty body */
+  }
+  if (!response.ok) {
+    throw new ApiError(data.error || 'Unknown error', response.status, data.code, data);
+  }
+  return data as T;
+}
+
+const UNSUPPORTED: BrowserCapabilities = {
+  conditionalCreate: 'unsupported',
+  conditionalGet: 'unsupported',
+  hybridTransport: 'unsupported',
+  passkeyPlatformAuthenticator: 'unsupported',
+  userVerifyingPlatformAuthenticator: 'unsupported',
+  relatedOrigins: 'unsupported',
+  signalAllAcceptedCredentials: 'unsupported',
+  signalCurrentUserDetails: 'unsupported',
+  signalUnknownCredential: 'unsupported',
+};
+
+let capabilitiesPromise: Promise<BrowserCapabilities> | null = null;
+
+export function getCapabilities(): Promise<BrowserCapabilities> {
+  if (!capabilitiesPromise) {
+    capabilitiesPromise = browserSupportsWebAuthn()
+      ? getBrowserCapabilities().catch(() => UNSUPPORTED)
+      : Promise.resolve(UNSUPPORTED);
+  }
+  return capabilitiesPromise;
+}
+
+export const passkeysSupported = () => browserSupportsWebAuthn();
+
+/** Turn WebAuthn / API errors into friendly copy. Returns null for silent cancellations. */
+export function describeError(err: unknown): string | null {
+  const e = err as any;
+  if (e instanceof ApiError) return e.message;
+  const name = e?.name;
+  const code = e?.code;
+  if (name === 'AbortError' || code === 'ERROR_CEREMONY_ABORTED') return null;
+  if (name === 'NotAllowedError') {
+    return 'The passkey request was cancelled or timed out.';
+  }
+  if (name === 'InvalidStateError' || code === 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED') {
+    return 'A passkey for this account already exists in this password manager or on this device.';
+  }
+  if (name === 'SecurityError') {
+    return 'Passkeys aren’t available on this domain. Make sure you’re using HTTPS or localhost.';
+  }
+  if (name === 'NotSupportedError') {
+    return 'Your browser or device doesn’t support this kind of passkey.';
+  }
+  return e?.message || 'Something went wrong. Please try again.';
+}
+
+interface SignalPayload {
+  rpID: string;
+  userID: string;
+  userName?: string;
+  allAcceptedCredentialIDs?: string[];
+}
+
+/**
+ * Keep the user's passkey providers in sync with the server: hide deleted
+ * passkeys and update the displayed username. Best-effort and silent.
+ */
+export async function syncPasskeySignals(signal: SignalPayload | undefined): Promise<void> {
+  if (!signal) return;
+  const caps = await getCapabilities();
+  try {
+    if (signal.allAcceptedCredentialIDs && caps.signalAllAcceptedCredentials !== 'unsupported') {
+      await sendSignal({
+        signalName: 'allAcceptedCredentials',
+        rpID: signal.rpID,
+        userID: signal.userID,
+        allAcceptedCredentialIDs: signal.allAcceptedCredentialIDs,
+      });
+    }
+    if (signal.userName && caps.signalCurrentUserDetails !== 'unsupported') {
+      await sendSignal({
+        signalName: 'currentUserDetails',
+        rpID: signal.rpID,
+        userID: signal.userID,
+        userName: signal.userName,
+        userDisplayName: signal.userName,
+      });
+    }
+  } catch {
+    /* signals are fire-and-forget */
+  }
+}
+
+async function signalUnknownCredential(err: unknown): Promise<void> {
+  if (!(err instanceof ApiError) || err.code !== 'UNKNOWN_CREDENTIAL') return;
+  const caps = await getCapabilities();
+  if (caps.signalUnknownCredential === 'unsupported') return;
+  try {
+    await sendSignal({
+      signalName: 'unknownCredential',
+      rpID: err.data.rpID,
+      credentialID: err.data.credentialID,
+    });
+  } catch {
+    /* ignore */
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Ceremonies
+// ---------------------------------------------------------------------------
+
+/** Sign in with a passkey, either via the modal UI or via browser autofill. */
+export async function signInWithPasskey({ autofill = false } = {}) {
+  const optionsJSON = await api('passkey/login-options', { body: { purpose: 'signin' } });
+  const response = await startAuthentication({ optionsJSON, useBrowserAutofill: autofill });
+  try {
+    const result = await api('passkey/login-verify', { body: { response, purpose: 'signin' } });
+    await syncPasskeySignals(result.signal);
+    return result;
+  } catch (err) {
+    await signalUnknownCredential(err);
+    throw err;
+  }
+}
+
+/** Confirm the signed-in user's identity with one of their passkeys. */
+export async function reauthenticateWithPasskey() {
+  const optionsJSON = await api('passkey/login-options', { body: { purpose: 'reauth' } });
+  const response = await startAuthentication({ optionsJSON });
+  try {
+    return await api('passkey/login-verify', { body: { response, purpose: 'reauth' } });
+  } catch (err) {
+    await signalUnknownCredential(err);
+    throw err;
+  }
+}
+
+/**
+ * Create a passkey. When signed out, `username` creates a new passkey-only
+ * account; when signed in, the passkey is added to the current account.
+ */
+export async function createPasskey({ username }: { username?: string } = {}) {
+  const optionsJSON = await api('passkey/register-options', { body: { username } });
+  const response = await startRegistration({ optionsJSON });
+  const result = await api('passkey/register-verify', { body: { response } });
+  await syncPasskeySignals(result.signal);
+  return result;
+}
+
+/**
+ * After a successful password sign-in, ask the browser to silently create a
+ * passkey in the password manager the user just used (if supported).
+ * Resolves to true if a passkey was created.
+ */
+export async function tryAutomaticPasskeyUpgrade(): Promise<boolean> {
+  const caps = await getCapabilities();
+  if (caps.conditionalCreate !== 'supported') return false;
+  try {
+    const optionsJSON = await api('passkey/register-options', { body: { conditional: true } });
+    // The browser either creates the passkey silently or never resolves; don't
+    // hold up navigation for more than a few seconds.
+    const timer = setTimeout(() => WebAuthnAbortService.cancelCeremony(), 4000);
+    let response;
+    try {
+      response = await startRegistration({ optionsJSON, useAutoRegister: true });
+    } finally {
+      clearTimeout(timer);
+    }
+    const result = await api('passkey/register-verify', { body: { response } });
+    await syncPasskeySignals(result.signal);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export function cancelPasskeyCeremony() {
+  WebAuthnAbortService.cancelCeremony();
+}
+
+/** Only allow same-site relative redirects. */
+export function safeNext(fallback = BASE_URL): string {
+  const next = new URLSearchParams(window.location.search).get('next');
+  if (next && next.startsWith('/') && !next.startsWith('//') && !next.startsWith('/\\')) return next;
+  return fallback;
+}
