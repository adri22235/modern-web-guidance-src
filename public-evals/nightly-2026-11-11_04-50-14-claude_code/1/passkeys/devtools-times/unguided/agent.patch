+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getCurrentUser, storeChallenge } from '../../../../lib/auth/session';
+import { getPasskeysForUser } from '../../../../lib/auth/store';
+import { errorResponse, getRelyingParty, json } from '../../../../lib/auth/webauthn';
+
+/**
+ * Start a passkey authentication.
+ *   purpose = "signin": discoverable credential sign-in (button or autofill).
+ *   purpose = "reauth": confirm the signed-in user's identity before a sensitive action.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  const purpose = body?.purpose === 'reauth' ? 'reauth' : 'signin';
+  const { rpID } = getRelyingParty(url);
+
+  let allowCredentials: { id: string; transports?: any[] }[] | undefined;
+  if (purpose === 'reauth') {
+    const user = await getCurrentUser(session);
+    if (!user) return errorResponse(401, 'NOT_SIGNED_IN', 'Please sign in first.');
+    const passkeys = await getPasskeysForUser(user.id);
+    if (passkeys.length === 0) {
+      return errorResponse(400, 'NO_PASSKEYS', 'You don’t have any passkeys yet.');
+    }
+    allowCredentials = passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials,
+    userVerification: purpose === 'reauth' ? 'required' : 'preferred',
+  });
+
+  storeChallenge(session, { challenge: options.challenge, purpose });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/login-verify.ts b/src/pages/api/auth/passkey/login-verify.ts
new file mode 100644
index 0000000..3590e49
--- /dev/null
+++ b/src/pages/api/auth/passkey/login-verify.ts
@@ -0,0 +1,98 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { consumeChallenge, getCurrentUser, markReauthenticated, signIn } from '../../../../lib/auth/session';
+import { getPasskey, getPasskeysForUser, getUserById, updatePasskey } from '../../../../lib/auth/store';
+import { errorResponse, getRelyingParty, json } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  const response = body?.response;
+  const purpose = body?.purpose === 'reauth' ? 'reauth' : 'signin';
+  if (!response?.id) return errorResponse(400, 'INVALID_INPUT', 'Missing authentication response.');
+
+  const pending = await consumeChallenge(session, [purpose]);
+  if (!pending) {
+    return errorResponse(400, 'CHALLENGE_EXPIRED', 'This request has expired. Please try again.');
+  }
+
+  const { rpID, origins } = getRelyingParty(url);
+
+  const passkey = await getPasskey(response.id);
+  if (!passkey) {
+    // Let the client tell the passkey provider to hide this stale credential.
+    return errorResponse(404, 'UNKNOWN_CREDENTIAL', 'This passkey isn’t registered with The DevTools Times. It may have been removed.', {
+      rpID,
+      credentialID: response.id,
+    });
+  }
+
+  const userHandle = response.response?.userHandle;
+  if (userHandle && userHandle !== passkey.userId) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify your passkey. Please try again.');
+  }
+
+  const user = await getUserById(passkey.userId);
+  if (!user) {
+    return errorResponse(404, 'UNKNOWN_CREDENTIAL', 'This passkey’s account no longer exists.', {
+      rpID,
+      credentialID: response.id,
+    });
+  }
+
+  if (purpose === 'reauth') {
+    const current = await getCurrentUser(session);
+    if (!current || current.id !== user.id) {
+      return errorResponse(403, 'WRONG_ACCOUNT', 'That passkey belongs to a different account.');
+    }
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: isoBase64URL.toBuffer(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+      requireUserVerification: purpose === 'reauth',
+    });
+  } catch (err) {
+    console.warn('[passkeys] Authentication verification failed', err);
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify your passkey. Please try again.');
+  }
+  if (!verification.verified) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify your passkey. Please try again.');
+  }
+
+  const { newCounter, credentialBackedUp, credentialDeviceType } = verification.authenticationInfo;
+  await updatePasskey(passkey.id, {
+    counter: newCounter,
+    backedUp: credentialBackedUp,
+    deviceType: credentialDeviceType,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  if (purpose === 'signin') {
+    await signIn(session, user, 'passkey');
+  } else {
+    await markReauthenticated(session);
+  }
+
+  const all = await getPasskeysForUser(user.id);
+  return json({
+    ok: true,
+    user: { username: user.username },
+    signal: {
+      rpID,
+      userID: user.id,
+      userName: user.username,
+      allAcceptedCredentialIDs: all.map((p) => p.id),
+    },
+  });
+};
diff --git a/src/pages/api/auth/passkey/register-options.ts b/src/pages/api/auth/passkey/register-options.ts
new file mode 100644
index 0000000..98d2314
--- /dev/null
+++ b/src/pages/api/auth/passkey/register-options.ts
@@ -0,0 +1,79 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getAuth, getCurrentUser, isRecentlyVerified, storeChallenge } from '../../../../lib/auth/session';
+import { getPasskeysForUser, getUserByUsername, newUserId } from '../../../../lib/auth/store';
+import { errorResponse, getRelyingParty, json, RP_NAME } from '../../../../lib/auth/webauthn';
+
+const USERNAME_RE = /^[a-zA-Z0-9._-]{3,32}$/;
+
+/**
+ * Start a passkey registration.
+ *
+ * - Signed in: adds a passkey to the current account. Requires a recent
+ *   (re)authentication, except for conditional ("automatic") creation right
+ *   after a password sign-in, which the browser only allows in that context.
+ * - Signed out: passkey-first sign-up for a new account with `username`.
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  const conditional = body?.conditional === true;
+  const { rpID } = getRelyingParty(url);
+
+  const user = await getCurrentUser(session);
+  let userId: string;
+  let userName: string;
+  let excludeCredentials: { id: string; transports?: any[] }[] = [];
+
+  if (user) {
+    const auth = await getAuth(session);
+    if (conditional) {
+      if (auth?.method !== 'password' || !isRecentlyVerified(auth)) {
+        return errorResponse(403, 'CONDITIONAL_NOT_ALLOWED', 'Automatic passkey creation is only available right after a password sign-in.');
+      }
+    } else if (!isRecentlyVerified(auth)) {
+      return errorResponse(401, 'REAUTH_REQUIRED', 'Please confirm it’s you before creating a passkey.');
+    }
+    const passkeys = await getPasskeysForUser(user.id);
+    userId = user.id;
+    userName = user.username;
+    excludeCredentials = passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+  } else {
+    if (conditional) return errorResponse(401, 'NOT_SIGNED_IN', 'Please sign in first.');
+    const username = typeof body?.username === 'string' ? body.username.trim() : '';
+    if (!USERNAME_RE.test(username)) {
+      return errorResponse(400, 'INVALID_USERNAME', 'Usernames must be 3–32 characters: letters, numbers, dots, dashes or underscores.');
+    }
+    if (await getUserByUsername(username)) {
+      return errorResponse(409, 'USERNAME_TAKEN', 'That username is already taken. Try signing in instead.');
+    }
+    userId = newUserId();
+    userName = username;
+  }
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: isoBase64URL.toBuffer(userId),
+    userName,
+    userDisplayName: userName,
+    attestationType: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+    // Ed25519, ES256, RS256
+    supportedAlgorithmIDs: [-8, -7, -257],
+  });
+
+  storeChallenge(session, {
+    challenge: options.challenge,
+    purpose: user ? 'register' : 'signup',
+    conditional,
+    pendingUser: user ? undefined : { id: userId, username: userName },
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/register-verify.ts b/src/pages/api/auth/passkey/register-verify.ts
new file mode 100644
index 0000000..8154cc6
--- /dev/null
+++ b/src/pages/api/auth/passkey/register-verify.ts
@@ -0,0 +1,99 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { consumeChallenge, getCurrentUser, signIn } from '../../../../lib/auth/session';
+import { addPasskey, createUser, getPasskeysForUser, getUserByUsername, type UserRecord } from '../../../../lib/auth/store';
+import { errorResponse, getProviderInfo, getRelyingParty, json, toPublicPasskey } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  const response = body?.response;
+  if (!response?.id) return errorResponse(400, 'INVALID_INPUT', 'Missing registration response.');
+
+  const pending = await consumeChallenge(session, ['register', 'signup']);
+  if (!pending) {
+    return errorResponse(400, 'CHALLENGE_EXPIRED', 'This request has expired. Please try again.');
+  }
+
+  // Make sure the account context hasn't changed since the options were issued.
+  let user: UserRecord | undefined = await getCurrentUser(session);
+  if (pending.purpose === 'register' && !user) {
+    return errorResponse(401, 'NOT_SIGNED_IN', 'Please sign in first.');
+  }
+  if (pending.purpose === 'signup' && user) {
+    return errorResponse(400, 'ALREADY_SIGNED_IN', 'You are already signed in.');
+  }
+
+  const { rpID, origins } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      // Conditional (automatic) creation may happen without user verification.
+      requireUserVerification: !pending.conditional,
+    });
+  } catch (err: any) {
+    console.warn('[passkeys] Registration verification failed', err);
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify your passkey. Please try again.');
+  }
+  if (!verification.verified) {
+    return errorResponse(400, 'VERIFICATION_FAILED', 'We couldn’t verify your passkey. Please try again.');
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+
+  if (pending.purpose === 'signup') {
+    const pendingUser = pending.pendingUser!;
+    if (await getUserByUsername(pendingUser.username)) {
+      return errorResponse(409, 'USERNAME_TAKEN', 'That username was just taken. Please choose another one.');
+    }
+    user = await createUser({
+      id: pendingUser.id,
+      username: pendingUser.username,
+      hasPassword: false,
+      createdAt: new Date().toISOString(),
+    });
+  }
+
+  const provider = await getProviderInfo(aaguid);
+  const passkey = {
+    id: credential.id,
+    userId: user!.id,
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports,
+    name: provider.name ?? 'Passkey',
+    aaguid,
+    providerName: provider.name,
+    providerIcon: provider.icon,
+    providerIconDark: provider.iconDark,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    createdAt: new Date().toISOString(),
+  };
+
+  try {
+    await addPasskey(passkey);
+  } catch {
+    return errorResponse(409, 'CREDENTIAL_EXISTS', 'This passkey is already registered.');
+  }
+
+  if (pending.purpose === 'signup') {
+    await signIn(session, user!, 'passkey');
+  }
+
+  const all = await getPasskeysForUser(user!.id);
+  return json({
+    ok: true,
+    passkey: toPublicPasskey(passkey),
+    signal: {
+      rpID,
+      userID: user!.id,
+      userName: user!.username,
+      allAcceptedCredentialIDs: all.map((p) => p.id),
+    },
+  });
+};
diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
