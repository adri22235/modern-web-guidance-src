index 0000000..40a2523
--- /dev/null
+++ b/src/pages/api/auth/reauth.ts
@@ -0,0 +1,28 @@
+import type { APIRoute } from 'astro';
+import { verifyPassword } from '../../../lib/auth/password';
+import { getCurrentUser, markReauthenticated } from '../../../lib/auth/session';
+import { errorResponse, json } from '../../../lib/auth/webauthn';
+
+/** Re-authenticate the signed-in user with their password. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const user = await getCurrentUser(session);
+  if (!user) return errorResponse(401, 'NOT_SIGNED_IN', 'Please sign in first.');
+  if (!user.hasPassword) {
+    return errorResponse(400, 'NO_PASSWORD', 'This account does not have a password. Use a passkey instead.');
+  }
+
+  const { password } = await request.json().catch(() => ({}));
+  if (typeof password !== 'string' || !password) {
+    return errorResponse(400, 'INVALID_INPUT', 'Password is required.');
+  }
+
+  try {
+    const result = await verifyPassword(user.username, password);
+    if (!result.ok) return errorResponse(401, 'INVALID_PASSWORD', 'That password is incorrect.');
+  } catch {
+    return errorResponse(502, 'UPSTREAM_UNAVAILABLE', 'The sign-in service is unavailable. Please try again later.');
+  }
+
+  await markReauthenticated(session);
+  return json({ ok: true });
+};
