+import type { APIRoute } from 'astro';
+import { registerPassword } from '../../../../lib/auth/password';
+import { signIn } from '../../../../lib/auth/session';
+import { getUserByUsername, upsertPasswordUser } from '../../../../lib/auth/store';
+import { errorResponse, json } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return errorResponse(400, 'INVALID_INPUT', 'Username and password are required.');
+  }
+
+  const existing = await getUserByUsername(username);
+  if (existing && !existing.hasPassword) {
+    return errorResponse(409, 'USERNAME_TAKEN', 'That username is already taken.');
+  }
+
+  let result;
+  try {
+    result = await registerPassword(username.trim(), password);
+  } catch {
+    return errorResponse(502, 'UPSTREAM_UNAVAILABLE', 'The sign-up service is unavailable. Please try again later.');
+  }
+  if (!result.ok) {
+    return json({ ...result.data, error: result.data?.error || 'Unknown error' }, result.status || 400);
+  }
+
+  const user = await upsertPasswordUser(username);
+  await signIn(session, user, 'password');
+  return json({ ok: true, user: { username: user.username } });
+};
diff --git a/src/pages/api/auth/reauth.ts b/src/pages/api/auth/reauth.ts
