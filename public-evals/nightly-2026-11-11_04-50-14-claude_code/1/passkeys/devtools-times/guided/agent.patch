index 0000000..1d97236
--- /dev/null
+++ b/src/pages/api/auth/passkey/register-verify.ts
@@ -0,0 +1,76 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import {
+  errorJson,
+  getExpectedOrigins,
+  getRpId,
+  getSessionUser,
+  json,
+  lookupProvider,
+  readJson,
+  startSession,
+  takeChallenge,
+  toPublicCredential,
+  toPublicUser,
+} from '../../../../lib/passkeys/server';
+import { findCredential, findUser, saveCredential, saveUser } from '../../../../lib/passkeys/store';
+
+export const POST: APIRoute = async (ctx) => {
+  const response = await readJson<RegistrationResponseJSON>(ctx);
+  const pending = await takeChallenge(ctx, 'register');
+  if (!response || !pending) return errorJson('Registration session expired. Please try again.', 400);
+
+  let user = pending.pendingUser;
+  if (user) {
+    if (findUser(user.username)) return errorJson('APP_ERR_1001: Username is already taken.', 409);
+  } else {
+    user = await getSessionUser(ctx);
+    if (!user || user.username !== pending.username) return errorJson('Not signed in.', 401);
+  }
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(ctx),
+      expectedRPID: getRpId(ctx),
+      // Creation requested userVerification "preferred".
+      requireUserVerification: false,
+      // Conditional create happens without an explicit user gesture.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (err) {
+    console.warn('[passkeys] Registration verification failed', err);
+    return errorJson('Passkey could not be verified.', 400);
+  }
+  if (!verification.verified) return errorJson('Passkey could not be verified.', 400);
+
+  const info = verification.registrationInfo;
+  if (findCredential(info.credential.id)) return errorJson('This passkey is already registered.', 409);
+
+  const provider = await lookupProvider(info.aaguid);
+  const stored = saveCredential({
+    id: info.credential.id,
+    username: user.username,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: isoBase64URL.fromBuffer(info.credential.publicKey),
+    credentialType: 'public-key',
+    credentialDeviceType: info.credentialDeviceType,
+    credentialBackedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    name: provider.name,
+    providerIcon: provider.providerIcon,
+    transports: info.credential.transports ?? response.response.transports ?? [],
+    registeredAt: Date.now(),
+    counter: info.credential.counter,
+  });
+
+  if (pending.pendingUser) {
+    saveUser(user);
+    await startSession(ctx, user);
+  }
+
+  return json({ credential: toPublicCredential(stored), user: toPublicUser(user) });
+};
diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
