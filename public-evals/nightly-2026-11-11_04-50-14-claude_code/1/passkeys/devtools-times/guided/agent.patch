new file mode 100644
index 0000000..83ab200
--- /dev/null
+++ b/src/lib/passkeys/store.ts
@@ -0,0 +1,146 @@
+/**
+ * Minimal JSON-file backed store for user accounts and passkey credentials.
+ *
+ * Password verification is handled by the external Times auth API; this store
+ * only keeps the information required for WebAuthn (passkey user handles and
+ * registered credentials). Swap it for a real database in production.
+ */
+import { randomBytes } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { tmpdir } from 'node:os';
+
+export interface ProviderIcon {
+  light?: string;
+  dark?: string;
+}
+
+export interface StoredPasskeyCredential {
+  /** Base64URL-encoded credential ID (unique lookup key). */
+  id: string;
+  /** Application user (username) the credential belongs to. */
+  username: string;
+  /** Base64URL-encoded WebAuthn user handle of the owning account. */
+  passkeyUserId: string;
+  /** Base64URL-encoded COSE public key. */
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  /** Provider icons derived from the AAGUID registry. */
+  providerIcon?: ProviderIcon;
+  /** Provider name derived from the AAGUID registry, or a user-chosen nickname. */
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+export interface StoredUser {
+  /** Username, shared with the external password auth API. */
+  username: string;
+  displayName: string;
+  /** Random, unpadded Base64URL WebAuthn user handle (never contains PII). */
+  passkeyUserId: string;
+  /** Whether the account can also sign in with a password. */
+  hasPassword: boolean;
+  createdAt: number;
+}
+
+interface Database {
+  users: Record<string, StoredUser>;
+  credentials: Record<string, StoredPasskeyCredential>;
+}
+
+const DB_PATH =
+  process.env.PASSKEY_DB_PATH ?? join(tmpdir(), 'devtools-times', 'passkeys.json');
+
+let db: Database | null = null;
+
+function load(): Database {
+  if (db) return db;
+  try {
+    if (existsSync(DB_PATH)) {
+      db = JSON.parse(readFileSync(DB_PATH, 'utf8')) as Database;
+    }
+  } catch (err) {
+    console.warn('[passkeys] Could not read credential store, starting fresh.', err);
+  }
+  db ??= { users: {}, credentials: {} };
+  return db;
+}
+
+function persist() {
+  try {
+    mkdirSync(dirname(DB_PATH), { recursive: true });
+    writeFileSync(DB_PATH, JSON.stringify(db, null, 2));
+  } catch (err) {
+    console.warn('[passkeys] Could not persist credential store.', err);
+  }
+}
+
+const userKey = (username: string) => username.trim().toLowerCase();
+
+export function newPasskeyUserId(): string {
+  return randomBytes(16).toString('base64url');
+}
+
+export function findUser(username: string): StoredUser | undefined {
+  return load().users[userKey(username)];
+}
+
+export function saveUser(user: StoredUser): StoredUser {
+  load().users[userKey(user.username)] = user;
+  persist();
+  return user;
+}
+
+/** Returns the local record for a password-authenticated user, creating it on first sign-in. */
+export function ensurePasswordUser(username: string): StoredUser {
+  const existing = findUser(username);
+  if (existing) {
+    if (!existing.hasPassword) {
+      existing.hasPassword = true;
+      saveUser(existing);
+    }
+    return existing;
+  }
+  return saveUser({
+    username,
+    displayName: username,
+    passkeyUserId: newPasskeyUserId(),
+    hasPassword: true,
+    createdAt: Date.now(),
+  });
+}
+
+export function updateUser(username: string, patch: Partial<Pick<StoredUser, 'displayName'>>) {
+  const user = findUser(username);
+  if (!user) return undefined;
+  Object.assign(user, patch);
+  return saveUser(user);
+}
+
+export function findCredential(id: string): StoredPasskeyCredential | undefined {
+  return load().credentials[id];
+}
+
+export function listCredentials(username: string): StoredPasskeyCredential[] {
+  const key = userKey(username);
+  return Object.values(load().credentials)
+    .filter((c) => userKey(c.username) === key)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export function saveCredential(cred: StoredPasskeyCredential) {
+  load().credentials[cred.id] = cred;
+  persist();
+  return cred;
+}
+
+export function deleteCredential(id: string) {
+  delete load().credentials[id];
+  persist();
+}
