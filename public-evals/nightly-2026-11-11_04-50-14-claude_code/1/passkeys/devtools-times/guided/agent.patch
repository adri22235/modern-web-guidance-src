--- /dev/null
+++ b/src/pages/api/auth/passkeys/[id].ts
@@ -0,0 +1,64 @@
+import type { APIContext, APIRoute } from 'astro';
+import {
+  errorJson,
+  getSessionUser,
+  isRecentlyAuthenticated,
+  json,
+  readJson,
+  toPublicCredential,
+} from '../../../../lib/passkeys/server';
+import {
+  deleteCredential,
+  findCredential,
+  listCredentials,
+  saveCredential,
+  type StoredPasskeyCredential,
+  type StoredUser,
+} from '../../../../lib/passkeys/store';
+
+type Owned =
+  | { ok: false; error: Response }
+  | { ok: true; user: StoredUser; cred: StoredPasskeyCredential };
+
+async function ownedCredential(ctx: APIContext): Promise<Owned> {
+  const user = await getSessionUser(ctx);
+  if (!user) return { ok: false, error: errorJson('Not signed in.', 401) };
+  const cred = ctx.params.id ? findCredential(ctx.params.id) : undefined;
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return { ok: false, error: errorJson('Credential not found.', 404) };
+  }
+  return { ok: true, user, cred };
+}
+
+/** Renames a passkey (server-side label only). */
+export const PATCH: APIRoute = async (ctx) => {
+  const result = await ownedCredential(ctx);
+  if (!result.ok) return result.error;
+
+  const body = await readJson<{ name?: string }>(ctx);
+  const name = body?.name?.trim();
+  if (!name || name.length > 64) return errorJson('Name must be between 1 and 64 characters.', 400);
+
+  result.cred.name = name;
+  saveCredential(result.cred);
+  return json(toPublicCredential(result.cred));
+};
+
+/** Deletes a passkey. Requires a recent reauthentication. */
+export const DELETE: APIRoute = async (ctx) => {
+  const result = await ownedCredential(ctx);
+  if (!result.ok) return result.error;
+
+  if (!(await isRecentlyAuthenticated(ctx))) {
+    return errorJson('Please verify your identity first.', 403);
+  }
+  if (!result.user.hasPassword && listCredentials(result.user.username).length <= 1) {
+    return errorJson(
+      'This is the only way to sign in to your account. Add another passkey before deleting this one.',
+      409,
+    );
+  }
+
+  deleteCredential(result.cred.id);
+  return json({ success: true });
+};
