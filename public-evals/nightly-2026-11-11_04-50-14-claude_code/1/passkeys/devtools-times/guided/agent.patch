+import type { APIRoute } from 'astro';
+import { createRequestOptions } from '../../../../lib/passkeys/ceremonies';
+import { errorJson, getSessionUser, json } from '../../../../lib/passkeys/server';
+import { listCredentials } from '../../../../lib/passkeys/store';
+
+/** Request options restricted to the signed-in user's own passkeys. */
+export const POST: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return errorJson('Not signed in.', 401);
+  const credentials = listCredentials(user.username);
+  if (!credentials.length) return errorJson('No passkeys registered for this account.', 400);
+  return json(await createRequestOptions(ctx, 'reauth', credentials, user.username));
+};
