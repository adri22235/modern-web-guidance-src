+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import {
+  RP_NAME,
+  errorJson,
+  getRpId,
+  getSessionUser,
+  isRecentlyAuthenticated,
+  json,
+  readJson,
+} from '../../../../lib/passkeys/server';
+import { findUser, listCredentials, newPasskeyUserId, type StoredUser } from '../../../../lib/passkeys/store';
+
+const USERNAME_PATTERN = /^[A-Za-z0-9._-]{3,32}$/;
+
+/**
+ * Creates WebAuthn creation options.
+ * - Signed in: adds a passkey to the current account (settings, post-sign-up
+ *   promotion, or conditional create after password sign-in).
+ * - Signed out with `username`: creates a new passwordless account.
+ */
+export const POST: APIRoute = async (ctx) => {
+  const body = (await readJson<{
+    promotion?: boolean;
+    conditional?: boolean;
+    username?: string;
+    displayName?: string;
+  }>(ctx)) ?? {};
+
+  let user: StoredUser | undefined = await getSessionUser(ctx);
+  let pendingUser: StoredUser | undefined;
+
+  if (user) {
+    if (!(await isRecentlyAuthenticated(ctx))) {
+      return errorJson('Please verify your identity first.', 403);
+    }
+  } else {
+    const username = body.username?.trim();
+    if (!username) return errorJson('Not signed in.', 401);
+    if (!USERNAME_PATTERN.test(username)) {
+      return errorJson('Usernames must be 3–32 characters: letters, numbers, ".", "_" or "-".', 400);
+    }
+    if (findUser(username)) return errorJson('APP_ERR_1001: Username is already taken.', 409);
+    pendingUser = user = {
+      username,
+      displayName: body.displayName?.trim().slice(0, 64) || username,
+      passkeyUserId: newPasskeyUserId(),
+      hasPassword: false,
+      createdAt: Date.now(),
+    };
+  }
+
+  const platformOnly = Boolean(body.promotion || body.conditional);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: getRpId(ctx),
+    userID: isoBase64URL.toBuffer(user.passkeyUserId),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: listCredentials(user.username).map((c) => ({
+      id: c.id,
+      transports: c.transports,
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Promotions target the platform authenticator; settings also allow security keys.
+      ...(platformOnly && { authenticatorAttachment: 'platform' }),
+    },
+  });
+
+  ctx.session?.set('passkeyChallenge', {
+    challenge: options.challenge,
+    kind: 'register',
+    userVerification: 'preferred',
+    conditional: Boolean(body.conditional),
+    pendingUser,
+    username: user.username,
+    createdAt: Date.now(),
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkey/register-verify.ts b/src/pages/api/auth/passkey/register-verify.ts
