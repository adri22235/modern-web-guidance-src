@@ -0,0 +1,21 @@
+import type { APIRoute } from 'astro';
+import { callExternalAuth, errorJson, json, readJson, startSession, toPublicUser } from '../../../lib/passkeys/server';
+import { ensurePasswordUser } from '../../../lib/passkeys/store';
+
+/** Verifies a password with the Times auth API and starts a local session. */
+export const POST: APIRoute = async (ctx) => {
+  const body = await readJson<{ username?: string; password?: string }>(ctx);
+  const username = body?.username?.trim();
+  if (!username || !body?.password) return errorJson('Username and password are required.', 400);
+
+  try {
+    const result = await callExternalAuth('login', username, body.password);
+    if (!result.ok) return json(result.data, result.status);
+    const user = ensurePasswordUser(username);
+    await startSession(ctx, user);
+    return json({ ...result.data, user: toPublicUser(user) });
+  } catch (err) {
+    console.error('[auth] Password sign-in failed', err);
+    return errorJson('Authentication service unavailable.', 502);
+  }
+};
