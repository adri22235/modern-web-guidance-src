+import type { APIRoute } from 'astro';
+import { errorJson, getRpId, getSessionUser, json, readJson, toPublicUser } from '../../../lib/passkeys/server';
+import { updateUser } from '../../../lib/passkeys/store';
+
+export const GET: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return errorJson('Not signed in.', 401);
+  return json({ ...toPublicUser(user), rpId: getRpId(ctx), userId: user.passkeyUserId });
+};
+
+/** Updates the profile display name. The client mirrors it to password managers via the Signal API. */
+export const PUT: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return errorJson('Not signed in.', 401);
+
+  const body = await readJson<{ displayName?: string }>(ctx);
+  const displayName = body?.displayName?.trim();
+  if (!displayName || displayName.length > 64) {
+    return errorJson('Display name must be between 1 and 64 characters.', 400);
+  }
+
+  const updated = updateUser(user.username, { displayName })!;
+  return json({ ...toPublicUser(updated), rpId: getRpId(ctx), userId: updated.passkeyUserId });
+};
