+import type { APIRoute } from 'astro';
+import { errorJson, getRpId, getSessionUser, json, toPublicCredential, toPublicUser } from '../../../../lib/passkeys/server';
+import { listCredentials } from '../../../../lib/passkeys/store';
+
+/** Lists the signed-in user's passkeys together with the server RP ID and user handle. */
+export const GET: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return errorJson('Not signed in.', 401);
+  return json({
+    rpId: getRpId(ctx),
+    userId: user.passkeyUserId,
+    user: toPublicUser(user),
+    credentials: listCredentials(user.username).map(toPublicCredential),
+  });
+};
