+import type { APIRoute } from 'astro';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { verifyAssertion } from '../../../../lib/passkeys/ceremonies';
+import { errorJson, getSessionUser, json, readJson, takeChallenge } from '../../../../lib/passkeys/server';
+import { findCredential } from '../../../../lib/passkeys/store';
+
+export const POST: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return errorJson('Not signed in.', 401);
+
+  const response = await readJson<AuthenticationResponseJSON>(ctx);
+  const pending = await takeChallenge(ctx, 'reauth');
+  if (!response || !pending || pending.username !== user.username) {
+    return errorJson('Verification session expired. Please try again.', 400);
+  }
+
+  const cred = findCredential(response.id);
+  if (!cred) return errorJson('This passkey is not registered with The DevTools Times.', 404);
+  // Reject a valid passkey that belongs to a different account.
+  if (cred.passkeyUserId !== user.passkeyUserId) {
+    return errorJson('This passkey belongs to a different account.', 403);
+  }
+
+  try {
+    if (!(await verifyAssertion(ctx, pending, response, cred))) {
+      return errorJson('Passkey could not be verified.', 400);
+    }
+  } catch (err) {
+    console.warn('[passkeys] Reauthentication verification failed', err);
+    return errorJson('Passkey could not be verified.', 400);
+  }
+
+  ctx.session?.set('reauthenticatedAt', Date.now());
+  return json({ ok: true });
+};
