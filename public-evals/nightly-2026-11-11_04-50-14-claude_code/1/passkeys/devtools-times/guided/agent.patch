diff --git a/src/lib/passkeys/ceremonies.ts b/src/lib/passkeys/ceremonies.ts
new file mode 100644
index 0000000..605855a
--- /dev/null
+++ b/src/lib/passkeys/ceremonies.ts
@@ -0,0 +1,64 @@
+import type { APIContext } from 'astro';
+import {
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+  type AuthenticationResponseJSON,
+} from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getExpectedOrigins, getRpId, type PendingChallenge } from './server';
+import { saveCredential, type StoredPasskeyCredential } from './store';
+
+/** Generates request options and stores the single-use challenge in the session. */
+export async function createRequestOptions(
+  ctx: APIContext,
+  kind: 'login' | 'reauth',
+  allow: StoredPasskeyCredential[] = [],
+  username?: string,
+) {
+  const userVerification: PendingChallenge['userVerification'] = 'preferred';
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(ctx),
+    // Empty for discoverable sign-in; the user's own passkeys for reauthentication.
+    allowCredentials: allow.map((c) => ({ id: c.id, transports: c.transports })),
+    userVerification,
+  });
+  ctx.session?.set('passkeyChallenge', {
+    challenge: options.challenge,
+    kind,
+    userVerification,
+    username,
+    createdAt: Date.now(),
+  });
+  return options;
+}
+
+/** Verifies an assertion against a stored credential and updates its counters. */
+export async function verifyAssertion(
+  ctx: APIContext,
+  pending: PendingChallenge,
+  response: AuthenticationResponseJSON,
+  cred: StoredPasskeyCredential,
+) {
+  const { verified, authenticationInfo } = await verifyAuthenticationResponse({
+    response,
+    expectedChallenge: pending.challenge,
+    expectedOrigin: getExpectedOrigins(ctx),
+    expectedRPID: getRpId(ctx),
+    credential: {
+      id: cred.id,
+      publicKey: isoBase64URL.toBuffer(cred.credentialPublicKey),
+      counter: cred.counter,
+      transports: cred.transports,
+    },
+    // Allow authenticators without user verification when it was only "preferred".
+    requireUserVerification: pending.userVerification === 'required',
+  });
+  if (!verified) return false;
+
+  cred.counter = authenticationInfo.newCounter;
+  cred.credentialBackedUp = authenticationInfo.credentialBackedUp;
+  cred.credentialDeviceType = authenticationInfo.credentialDeviceType;
+  cred.lastUsedAt = Date.now();
+  saveCredential(cred);
+  return true;
+}
diff --git a/src/lib/passkeys/client.ts b/src/lib/passkeys/client.ts
new file mode 100644
index 0000000..e56b0f6
--- /dev/null
+++ b/src/lib/passkeys/client.ts
@@ -0,0 +1,291 @@
+/**
+ * Browser-side passkey helpers built on the native WebAuthn APIs.
+ * Only call these from effects / event handlers (never during SSR).
+ */
+
+export const apiUrl = (path: string) => `${import.meta.env.BASE_URL}api/auth/${path}`;
+
+// Newer static members that may be missing from the bundled DOM typings.
+interface PublicKeyCredentialStatics {
+  getClientCapabilities?: () => Promise<Record<string, boolean>>;
+  parseCreationOptionsFromJSON(json: unknown): PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON(json: unknown): PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (o: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (o: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (o: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+}
+
+type JsonCredential = PublicKeyCredential & { toJSON(): { id: string } & Record<string, unknown> };
+
+const PKC = () =>
+  (typeof window !== 'undefined' && 'PublicKeyCredential' in window
+    ? (window.PublicKeyCredential as unknown as PublicKeyCredentialStatics)
+    : undefined);
+
+let polyfillPromise: Promise<unknown> | null = null;
+
+/**
+ * Loads `webauthn-polyfills` so getClientCapabilities(), parse*FromJSON() and
+ * toJSON() exist whenever PublicKeyCredential is supported.
+ */
+export function loadWebAuthn(): Promise<PublicKeyCredentialStatics | undefined> {
+  if (!PKC()) return Promise.resolve(undefined);
+  polyfillPromise ??= import('webauthn-polyfills').catch((err) =>
+    console.warn('WebAuthn polyfills failed to load', err),
+  );
+  return polyfillPromise.then(() => PKC());
+}
+
+export interface PasskeyCapabilities {
+  supported: boolean;
+  passkeyPlatformAuthenticator: boolean;
+  conditionalGet: boolean;
+  conditionalCreate: boolean;
+}
+
+const NO_CAPABILITIES: PasskeyCapabilities = {
+  supported: false,
+  passkeyPlatformAuthenticator: false,
+  conditionalGet: false,
+  conditionalCreate: false,
+};
+
+export async function getPasskeyCapabilities(): Promise<PasskeyCapabilities> {
+  const pkc = await loadWebAuthn();
+  if (!pkc?.getClientCapabilities) return NO_CAPABILITIES;
+  try {
+    const caps = await pkc.getClientCapabilities();
+    return {
+      supported: true,
+      passkeyPlatformAuthenticator: Boolean(caps.passkeyPlatformAuthenticator),
+      conditionalGet: Boolean(caps.conditionalGet),
+      conditionalCreate: Boolean(caps.conditionalCreate),
+    };
+  } catch {
+    return NO_CAPABILITIES;
+  }
+}
+
+/** Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, length % 4 !== 1. */
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export async function postJson(path: string, body: unknown = {}) {
+  const response = await fetch(apiUrl(path), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+  });
+  const data = await response.json().catch(() => ({}));
+  return { response, data };
+}
+
+export class PasskeyError extends Error {
+  constructor(
+    message: string,
+    /** True when the user simply dismissed the dialog; don't show an error. */
+    public readonly cancelled = false,
+    /** HTTP status when the server rejected the request (403 = reauthentication needed). */
+    public readonly status?: number,
+  ) {
+    super(message);
+  }
+}
+
+function describeWebAuthnError(err: unknown, ceremony: 'create' | 'get'): PasskeyError {
+  const name = err instanceof DOMException ? err.name : '';
+  switch (name) {
+    case 'NotAllowedError':
+    case 'AbortError':
+      return new PasskeyError('The passkey request was cancelled.', true);
+    case 'InvalidStateError':
+      return new PasskeyError(
+        ceremony === 'create'
+          ? 'A passkey for this account already exists in this passkey provider.'
+          : 'The passkey request could not be completed.',
+      );
+    case 'SecurityError':
+      return new PasskeyError('Passkeys are not available on this site configuration.');
+    default:
+      return new PasskeyError('Something went wrong with the passkey request.');
+  }
+}
+
+async function signalUnknown(rpId: string | undefined, credentialId: string) {
+  const pkc = PKC();
+  if (!rpId || !pkc?.signalUnknownCredential || !isValidBase64Url(credentialId)) return;
+  try {
+    await pkc.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.warn('signalUnknownCredential warning:', err);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+export interface RegisterOptions {
+  /** Post-sign-in/sign-up promotion: restrict to the platform authenticator. */
+  promotion?: boolean;
+  /** Conditional create: silently save a passkey after a password sign-in. */
+  conditional?: boolean;
+  /** New passwordless account. */
+  username?: string;
+  displayName?: string;
+}
+
+export async function registerPasskey(opts: RegisterOptions = {}) {
+  const pkc = await loadWebAuthn();
+  if (!pkc) throw new PasskeyError('Passkeys are not supported in this browser.');
+
+  const { response: optionsResponse, data: optionsJSON } = await postJson(
+    'passkey/register-options',
+    opts,
+  );
+  if (!optionsResponse.ok) {
+    throw new PasskeyError(
+      optionsJSON.error ?? 'Could not start passkey creation.',
+      false,
+      optionsResponse.status,
+    );
+  }
+  const publicKey = pkc.parseCreationOptionsFromJSON(optionsJSON);
+
+  let credential: JsonCredential;
+  try {
+    credential = (await navigator.credentials.create({
+      publicKey,
+      ...(opts.conditional && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as JsonCredential;
+  } catch (err) {
+    throw describeWebAuthnError(err, 'create');
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const { response, data } = await postJson('passkey/register-verify', encoded);
+    if (!response.ok) {
+      // The server rejected the credential: remove the orphan from the provider.
+      await signalUnknown(publicKey.rp.id, encoded.id);
+      throw new PasskeyError(data.error ?? 'The passkey could not be saved.');
+    }
+    return data;
+  } catch (err) {
+    if (err instanceof PasskeyError) throw err;
+    await signalUnknown(publicKey.rp.id, encoded.id);
+    throw new PasskeyError('Network error while saving the passkey.');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Authentication & reauthentication
+// ---------------------------------------------------------------------------
+
+interface AuthenticateOptions {
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+}
+
+async function getAssertion(
+  kind: 'login' | 'reauth',
+  { mediation, signal }: AuthenticateOptions = {},
+) {
+  const pkc = await loadWebAuthn();
+  if (!pkc) throw new PasskeyError('Passkeys are not supported in this browser.');
+
+  const { response: optionsResponse, data: optionsJSON } = await postJson(
+    `passkey/${kind}-options`,
+  );
+  if (!optionsResponse.ok) {
+    throw new PasskeyError(
+      optionsJSON.error ?? 'Could not start passkey verification.',
+      false,
+      optionsResponse.status,
+    );
+  }
+  const publicKey = pkc.parseRequestOptionsFromJSON(optionsJSON);
+
+  let credential: JsonCredential;
+  try {
+    credential = (await navigator.credentials.get({ publicKey, mediation, signal })) as JsonCredential;
+  } catch (err) {
+    throw describeWebAuthnError(err, 'get');
+  }
+
+  const encoded = credential.toJSON();
+  let result;
+  try {
+    result = await postJson(`passkey/${kind}-verify`, encoded);
+  } catch {
+    throw new PasskeyError('Network error while verifying the passkey.');
+  }
+  if (!result.response.ok) {
+    // Only signal an unknown credential when the server says it doesn't exist
+    // and the user isn't authenticated with it.
+    if (result.response.status === 404 && kind === 'login') {
+      await signalUnknown(publicKey.rpId, encoded.id);
+    }
+    throw new PasskeyError(result.data.error ?? 'The passkey could not be verified.');
+  }
+  return result.data;
+}
+
+export const signInWithPasskey = (opts?: AuthenticateOptions) => getAssertion('login', opts);
+export const reauthenticateWithPasskey = () => getAssertion('reauth');
+
+// ---------------------------------------------------------------------------
+// Signal API synchronisation (passive; failures only warn)
+// ---------------------------------------------------------------------------
+
+export async function syncAcceptedCredentials(
+  rpId: string | undefined,
+  userId: string | undefined,
+  credentialIds: string[],
+) {
+  const pkc = PKC();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  if (!rpId || !isValidBase64Url(userId) || !credentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    await pkc.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: credentialIds });
+  } catch (err) {
+    console.warn('signalAllAcceptedCredentials warning:', err);
+  }
+}
+
+export async function syncUserDetails(
+  rpId: string | undefined,
+  userId: string | undefined,
+  name: string,
+  displayName: string,
+) {
+  const pkc = PKC();
+  if (!pkc?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.warn('signalCurrentUserDetails warning:', err);
+  }
+}
diff --git a/src/lib/passkeys/server.ts b/src/lib/passkeys/server.ts
new file mode 100644
index 0000000..939c28d
--- /dev/null
+++ b/src/lib/passkeys/server.ts
@@ -0,0 +1,181 @@
+import type { APIContext } from 'astro';
+import type { ProviderIcon, StoredPasskeyCredential, StoredUser } from './store';
+import { findUser } from './store';
+
+export const RP_NAME = 'The DevTools Times';
+
+/** How long a successful (re)authentication unlocks sensitive account actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export const EXTERNAL_AUTH_API =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface SessionUser {
+  username: string;
+}
+
+export interface PendingChallenge {
+  challenge: string;
+  kind: 'register' | 'login' | 'reauth';
+  userVerification: 'preferred' | 'required';
+  /** Set for conditional-create (automatic post-login) registrations. */
+  conditional?: boolean;
+  /** Set when registering a passkey for a brand new, passwordless account. */
+  pendingUser?: StoredUser;
+  /** For register/reauth: the username the ceremony is bound to. */
+  username?: string;
+  createdAt: number;
+}
+
+declare global {
+  namespace App {
+    interface SessionData {
+      user: SessionUser;
+      reauthenticatedAt: number;
+      passkeyChallenge: PendingChallenge;
+    }
+  }
+}
+
+/**
+ * The relying party ID is a predefined server-side value. Configure it with
+ * PASSKEY_RP_ID in production (e.g. a registrable parent domain); when unset it
+ * falls back to the host serving the request, which is correct for single-host
+ * deployments and localhost development.
+ */
+export function getRpId(ctx: APIContext): string {
+  return process.env.PASSKEY_RP_ID || new URL(ctx.request.url).hostname;
+}
+
+export function getExpectedOrigins(ctx: APIContext): string[] {
+  const fromEnv = process.env.PASSKEY_ORIGINS?.split(',').map((o) => o.trim()).filter(Boolean);
+  return fromEnv?.length ? fromEnv : [new URL(ctx.request.url).origin];
+}
+
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function errorJson(error: string, status: number) {
+  return json({ error }, status);
+}
+
+/**
+ * Parses a JSON request body. Requiring `application/json` means cross-site
+ * form posts can't reach these endpoints without a CORS preflight.
+ */
+export async function readJson<T = Record<string, unknown>>(ctx: APIContext): Promise<T | null> {
+  if (!ctx.request.headers.get('content-type')?.includes('application/json')) return null;
+  try {
+    return (await ctx.request.json()) as T;
+  } catch {
+    return null;
+  }
+}
+
+export async function getSessionUser(ctx: APIContext): Promise<StoredUser | undefined> {
+  const sessionUser = await ctx.session?.get('user');
+  return sessionUser ? findUser(sessionUser.username) : undefined;
+}
+
+/** Signs the user in, rotating the session ID to prevent session fixation. */
+export async function startSession(ctx: APIContext, user: StoredUser) {
+  await ctx.session?.regenerate();
+  ctx.session?.set('user', { username: user.username });
+  ctx.session?.set('reauthenticatedAt', Date.now());
+}
+
+export async function isRecentlyAuthenticated(ctx: APIContext) {
+  const at = await ctx.session?.get('reauthenticatedAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export async function takeChallenge(
+  ctx: APIContext,
+  kind: PendingChallenge['kind'],
+): Promise<PendingChallenge | undefined> {
+  const pending = await ctx.session?.get('passkeyChallenge');
+  ctx.session?.delete('passkeyChallenge');
+  if (!pending || pending.kind !== kind) return undefined;
+  // Challenges are single-use and expire after 10 minutes.
+  if (Date.now() - pending.createdAt > 10 * 60 * 1000) return undefined;
+  return pending;
+}
+
+/** Shape returned to the client; never exposes public keys or counters. */
+export function toPublicCredential(cred: StoredPasskeyCredential) {
+  return {
+    id: cred.id,
+    name: cred.name,
+    aaguid: cred.aaguid,
+    providerIcon: cred.providerIcon,
+    credentialDeviceType: cred.credentialDeviceType,
+    credentialBackedUp: cred.credentialBackedUp,
+    registeredAt: cred.registeredAt,
+    lastUsedAt: cred.lastUsedAt,
+  };
+}
+
+export function toPublicUser(user: StoredUser) {
+  return {
+    username: user.username,
+    displayName: user.displayName,
+    hasPassword: user.hasPassword,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// AAGUID → passkey provider lookup (UX hint only; never used for security).
+// ---------------------------------------------------------------------------
+
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+type AaguidRegistry = Record<string, { name: string; icon_light?: string; icon_dark?: string }>;
+let registryPromise: Promise<AaguidRegistry> | null = null;
+
+function loadRegistry(): Promise<AaguidRegistry> {
+  registryPromise ??= fetch(AAGUID_REGISTRY_URL, { signal: AbortSignal.timeout(4000) })
+    .then((res) => (res.ok ? (res.json() as Promise<AaguidRegistry>) : {}))
+    .catch((err) => {
+      console.warn('[passkeys] Could not load AAGUID registry.', err);
+      registryPromise = null; // retry on the next registration
+      return {};
+    });
+  return registryPromise;
+}
+
+export async function lookupProvider(
+  aaguid: string,
+): Promise<{ name: string; providerIcon?: ProviderIcon }> {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return { name: 'Unknown passkey provider' };
+  }
+  const entry = (await loadRegistry())[aaguid];
+  if (!entry) return { name: 'Unknown passkey provider' };
+  return {
+    name: entry.name,
+    providerIcon: { light: entry.icon_light, dark: entry.icon_dark },
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Password auth is delegated to the external Times auth API.
+// ---------------------------------------------------------------------------
+
+export async function callExternalAuth(
+  endpoint: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<{ ok: boolean; status: number; data: Record<string, unknown> }> {
+  const response = await fetch(`${EXTERNAL_AUTH_API}/${endpoint}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = (await response.json().catch(() => ({}))) as Record<string, unknown>;
+  return { ok: response.ok, status: response.status, data };
+}
