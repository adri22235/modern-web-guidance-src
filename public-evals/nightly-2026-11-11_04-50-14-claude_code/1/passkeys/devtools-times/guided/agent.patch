@@ -0,0 +1,601 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, PlusIcon, ShieldCheckIcon, TrashIcon } from '@heroicons/react/24/outline';
+import {
+  apiUrl,
+  getPasskeyCapabilities,
+  PasskeyError,
+  postJson,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  syncAcceptedCredentials,
+  syncUserDetails,
+} from '../lib/passkeys/client';
+
+interface Passkey {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: { light?: string; dark?: string };
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface Account {
+  username: string;
+  displayName: string;
+  hasPassword: boolean;
+}
+
+interface PasskeyList {
+  rpId: string;
+  userId: string;
+  user: Account;
+  credentials: Passkey[];
+}
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+const formatDate = (epoch?: number) => (epoch ? dateFormat.format(new Date(epoch)) : 'Never');
+
+const buttonPrimary =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed';
+const buttonSecondary =
+  'inline-flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-md border border-gray-300 text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+/** Native modal <dialog>: focus trapping, Escape-to-close and inert background for free. */
+function Modal({
+  open,
+  onClose,
+  labelledBy,
+  children,
+}: {
+  open: boolean;
+  onClose: () => void;
+  labelledBy: string;
+  children: React.ReactNode;
+}) {
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    const dialog = ref.current;
+    if (!dialog) return;
+    if (open && !dialog.open) dialog.showModal();
+    if (!open && dialog.open) dialog.close();
+  }, [open]);
+  return (
+    <dialog
+      ref={ref}
+      aria-labelledby={labelledBy}
+      onClose={onClose}
+      className="m-auto w-[min(28rem,calc(100%-2rem))] rounded-lg p-6 shadow-xl backdrop:bg-black/50"
+    >
+      {children}
+    </dialog>
+  );
+}
+
+export default function AccountSettings() {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<{ kind: 'success' | 'error'; text: string } | null>(null);
+  const [canCreate, setCanCreate] = useState<boolean | null>(null);
+  const [busy, setBusy] = useState<string | null>(null);
+
+  const [displayName, setDisplayName] = useState('');
+  const [renameTarget, setRenameTarget] = useState<Passkey | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [deleteTarget, setDeleteTarget] = useState<Passkey | null>(null);
+
+  // Reauthentication dialog state; resolves the pending promise on close.
+  const [reauthOpen, setReauthOpen] = useState(false);
+  const [reauthError, setReauthError] = useState<string | null>(null);
+  const [reauthPassword, setReauthPassword] = useState('');
+  const [reauthBusy, setReauthBusy] = useState(false);
+  const reauthResolver = useRef<((ok: boolean) => void) | null>(null);
+
+  const ids = {
+    rename: useId(),
+    del: useId(),
+    reauth: useId(),
+    reauthDesc: useId(),
+  };
+
+  const loadPasskeys = useCallback(async () => {
+    const response = await fetch(apiUrl('passkeys'), { headers: { Accept: 'application/json' } });
+    if (response.status === 401) {
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+      return null;
+    }
+    if (!response.ok) throw new Error('Could not load your passkeys.');
+    const list = (await response.json()) as PasskeyList;
+    setData(list);
+    return list;
+  }, []);
+
+  useEffect(() => {
+    getPasskeyCapabilities().then((caps) => setCanCreate(caps.passkeyPlatformAuthenticator));
+    loadPasskeys()
+      .then((list) => {
+        if (!list) return;
+        setDisplayName(list.user.displayName);
+        // Keep the password manager's saved passkeys in sync with the server.
+        void syncAcceptedCredentials(list.rpId, list.userId, list.credentials.map((c) => c.id));
+      })
+      .catch((err) => setLoadError(err.message));
+  }, [loadPasskeys]);
+
+  // ---------------------------------------------------------------------------
+  // Reauthentication
+  // ---------------------------------------------------------------------------
+
+  const requestReauth = () =>
+    new Promise<boolean>((resolve) => {
+      reauthResolver.current = resolve;
+      setReauthError(null);
+      setReauthPassword('');
+      setReauthOpen(true);
+    });
+
+  const finishReauth = (ok: boolean) => {
+    reauthResolver.current?.(ok);
+    reauthResolver.current = null;
+    setReauthOpen(false);
+  };
+
+  const handleReauthPasskey = async () => {
+    setReauthError(null);
+    setReauthBusy(true);
+    try {
+      await reauthenticateWithPasskey();
+      finishReauth(true);
+    } catch (err) {
+      if (!(err instanceof PasskeyError && err.cancelled)) {
+        setReauthError(err instanceof Error ? err.message : 'Verification failed.');
+      }
+    } finally {
+      setReauthBusy(false);
+    }
+  };
+
+  const handleReauthPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setReauthError(null);
+    setReauthBusy(true);
+    try {
+      const { response, data: body } = await postJson('reauth-password', { password: reauthPassword });
+      if (response.ok) finishReauth(true);
+      else setReauthError(body.error ?? 'Verification failed.');
+    } catch {
+      setReauthError('An unexpected error occurred. Please try again.');
+    } finally {
+      setReauthBusy(false);
+    }
+  };
+
+  // ---------------------------------------------------------------------------
+  // Actions
+  // ---------------------------------------------------------------------------
+
+  const handleCreatePasskey = async () => {
+    setNotice(null);
+    setBusy('create');
+    try {
+      try {
+        await registerPasskey();
+      } catch (err) {
+        // Adding a sign-in method is sensitive: verify identity, then retry once.
+        if (!(err instanceof PasskeyError && err.status === 403)) throw err;
+        if (!(await requestReauth())) return;
+        await registerPasskey();
+      }
+      await loadPasskeys();
+      setNotice({ kind: 'success', text: 'Passkey created.' });
+    } catch (err) {
+      if (!(err instanceof PasskeyError && err.cancelled)) {
+        setNotice({ kind: 'error', text: err instanceof Error ? err.message : 'Could not create passkey.' });
+      }
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!renameTarget) return;
+    setBusy(`rename:${renameTarget.id}`);
+    try {
+      const response = await fetch(apiUrl(`passkeys/${encodeURIComponent(renameTarget.id)}`), {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: renameValue }),
+      });
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(body.error ?? 'Could not rename passkey.');
+      await loadPasskeys();
+      setNotice({ kind: 'success', text: 'Passkey renamed.' });
+      setRenameTarget(null);
+    } catch (err) {
+      setNotice({ kind: 'error', text: err instanceof Error ? err.message : 'Could not rename passkey.' });
+      setRenameTarget(null);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleDelete = async () => {
+    const target = deleteTarget;
+    if (!target) return;
+    setDeleteTarget(null);
+    setNotice(null);
+    setBusy(`delete:${target.id}`);
+
+    const doDelete = () =>
+      fetch(apiUrl(`passkeys/${encodeURIComponent(target.id)}`), { method: 'DELETE' });
+
+    try {
+      let response = await doDelete();
+      if (response.status === 403) {
+        if (!(await requestReauth())) return;
+        response = await doDelete();
+      }
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(body.error ?? 'Could not delete passkey.');
+
+      const list = await loadPasskeys();
+      if (list) {
+        // Tell the passkey provider which credentials remain valid.
+        await syncAcceptedCredentials(list.rpId, list.userId, list.credentials.map((c) => c.id));
+      }
+      setNotice({
+        kind: 'success',
+        text: `Passkey deleted. You can also remove “${target.name}” from your password manager.`,
+      });
+    } catch (err) {
+      setNotice({ kind: 'error', text: err instanceof Error ? err.message : 'Could not delete passkey.' });
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleProfileSave = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setNotice(null);
+    setBusy('profile');
+    try {
+      const response = await fetch(apiUrl('user'), {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ displayName }),
+      });
+      const body = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(body.error ?? 'Could not update profile.');
+      setData((d) => (d ? { ...d, user: { ...d.user, displayName: body.displayName } } : d));
+      // Update the name shown in the user's password manager.
+      await syncUserDetails(body.rpId, body.userId, body.username, body.displayName);
+      setNotice({ kind: 'success', text: 'Profile updated.' });
+    } catch (err) {
+      setNotice({ kind: 'error', text: err instanceof Error ? err.message : 'Could not update profile.' });
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleSignOut = async () => {
+    await postJson('signout').catch(() => undefined);
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  // ---------------------------------------------------------------------------
+  // Render
+  // ---------------------------------------------------------------------------
+
+  if (loadError) {
+    return (
+      <div className="max-w-2xl mx-auto p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+        {loadError}
+      </div>
+    );
+  }
+
+  if (!data) {
+    return (
+      <p className="max-w-2xl mx-auto text-sm text-gray-600" role="status">
+        Loading your account…
+      </p>
+    );
+  }
+
+  const { user, credentials } = data;
+  const isOnlySignInMethod = !user.hasPassword && credentials.length <= 1;
+
+  return (
+    <div className="max-w-2xl mx-auto space-y-8">
+      <div className="flex flex-wrap items-end justify-between gap-4 border-b border-gray-300 pb-4">
+        <div>
+          <h1 className="font-serif text-3xl font-bold text-gray-900">Account settings</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            Signed in as <strong className="font-semibold text-gray-900">{user.username}</strong>
+          </p>
+        </div>
+        <button type="button" onClick={handleSignOut} className={buttonSecondary}>
+          Sign out
+        </button>
+      </div>
+
+      {notice && (
+        <div
+          className={`p-3 text-sm rounded-lg ${
+            notice.kind === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'
+          }`}
+          role={notice.kind === 'error' ? 'alert' : 'status'}
+        >
+          {notice.text}
+        </div>
+      )}
+
+      {/* Profile */}
+      <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="profile-heading" className="text-xl font-bold text-gray-800 mb-4">
+          Profile
+        </h2>
+        <form onSubmit={handleProfileSave} className="space-y-4">
+          <div>
+            <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Username
+            </label>
+            <input
+              id="account-username"
+              type="text"
+              value={user.username}
+              readOnly
+              autoComplete="username"
+              className={`${inputClass} bg-gray-50 text-gray-600`}
+            />
+          </div>
+          <div>
+            <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="account-display-name"
+              type="text"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={64}
+              autoComplete="name"
+              aria-describedby="display-name-hint"
+              className={inputClass}
+            />
+            <p id="display-name-hint" className="text-xs text-gray-500 mt-1">
+              Shown on your comments and in your password manager next to your passkeys.
+            </p>
+          </div>
+          <button
+            type="submit"
+            className={buttonPrimary}
+            disabled={busy === 'profile' || displayName.trim() === user.displayName}
+          >
+            {busy === 'profile' ? 'Saving…' : 'Save profile'}
+          </button>
+        </form>
+      </section>
+
+      {/* Passkeys */}
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-2">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">
+              Passkeys
+            </h2>
+            <p className="mt-1 text-sm text-gray-600 max-w-prose">
+              Sign in with your fingerprint, face, screen lock, or a security key. Passkeys are
+              phishing-resistant and never leave your device or password manager.
+            </p>
+          </div>
+          {canCreate && (
+            <button type="button" onClick={handleCreatePasskey} disabled={busy === 'create'} className={buttonPrimary}>
+              <PlusIcon className="h-5 w-5" aria-hidden="true" />
+              {busy === 'create' ? 'Waiting for passkey…' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {canCreate === false && (
+          <p className="mt-3 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            This browser or device can't create passkeys. Use a strong, unique password and try
+            passkeys on a supported device.
+          </p>
+        )}
+
+        {credentials.length === 0 ? (
+          <div className="mt-6 flex flex-col items-center gap-2 rounded-lg border border-dashed border-gray-300 p-8 text-center">
+            <KeyIcon className="h-8 w-8 text-gray-400" aria-hidden="true" />
+            <p className="text-sm font-medium text-gray-800">No passkeys found</p>
+            <p className="text-sm text-gray-600">Create a passkey to sign in faster next time.</p>
+          </div>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-y border-gray-200">
+            {credentials.map((passkey) => (
+              <li key={passkey.id} className="flex flex-wrap items-center gap-4 py-4">
+                {passkey.providerIcon?.light ? (
+                  <img
+                    src={passkey.providerIcon.light}
+                    alt=""
+                    width={32}
+                    height={32}
+                    className="h-8 w-8 shrink-0"
+                  />
+                ) : (
+                  <span className="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gray-100">
+                    <KeyIcon className="h-5 w-5 text-gray-700" aria-hidden="true" />
+                  </span>
+                )}
+                <div className="min-w-0 flex-1">
+                  <p className="font-medium text-gray-900 break-words">
+                    {passkey.name}
+                    <span className="ml-2 inline-block rounded bg-gray-100 px-1.5 py-0.5 align-middle text-xs font-normal text-gray-600">
+                      {passkey.credentialBackedUp ? 'Synced' : 'This device only'}
+                    </span>
+                  </p>
+                  <p className="text-xs text-gray-600">
+                    Created {formatDate(passkey.registeredAt)} · Last used {formatDate(passkey.lastUsedAt)}
+                  </p>
+                </div>
+                <div className="flex gap-2">
+                  <button
+                    type="button"
+                    className={buttonSecondary}
+                    aria-label={`Rename ${passkey.name}`}
+                    onClick={() => {
+                      setRenameValue(passkey.name);
+                      setRenameTarget(passkey);
+                    }}
+                    disabled={busy !== null}
+                  >
+                    <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                    Rename
+                  </button>
+                  <button
+                    type="button"
+                    className={`${buttonSecondary} text-red-700 hover:bg-red-50`}
+                    aria-label={`Delete ${passkey.name}`}
+                    onClick={() => setDeleteTarget(passkey)}
+                    disabled={busy !== null || isOnlySignInMethod}
+                    title={isOnlySignInMethod ? 'Add another passkey before deleting your only sign-in method.' : undefined}
+                  >
+                    <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                    {busy === `delete:${passkey.id}` ? 'Deleting…' : 'Delete'}
+                  </button>
+                </div>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      {/* Rename dialog */}
+      <Modal open={renameTarget !== null} onClose={() => setRenameTarget(null)} labelledBy={ids.rename}>
+        <form onSubmit={handleRename} className="space-y-4">
+          <h2 id={ids.rename} className="text-lg font-bold text-gray-900">
+            Rename passkey
+          </h2>
+          <div>
+            <label htmlFor={`${ids.rename}-input`} className="block text-sm font-medium text-gray-700 mb-1">
+              Passkey name
+            </label>
+            <input
+              id={`${ids.rename}-input`}
+              type="text"
+              value={renameValue}
+              onChange={(e) => setRenameValue(e.target.value)}
+              required
+              maxLength={64}
+              autoComplete="off"
+              className={inputClass}
+            />
+          </div>
+          <div className="flex justify-end gap-2">
+            <button type="button" className={buttonSecondary} onClick={() => setRenameTarget(null)}>
+              Cancel
+            </button>
+            <button type="submit" className={buttonPrimary} disabled={busy?.startsWith('rename:')}>
+              Save
+            </button>
+          </div>
+        </form>
+      </Modal>
+
+      {/* Delete confirmation dialog */}
+      <Modal open={deleteTarget !== null} onClose={() => setDeleteTarget(null)} labelledBy={ids.del}>
+        <h2 id={ids.del} className="text-lg font-bold text-gray-900">
+          Delete passkey?
+        </h2>
+        <p className="mt-2 text-sm text-gray-600">
+          You won't be able to sign in to The DevTools Times with “{deleteTarget?.name}” anymore.
+        </p>
+        <div className="mt-6 flex justify-end gap-2">
+          <button type="button" className={buttonSecondary} onClick={() => setDeleteTarget(null)} autoFocus>
+            Cancel
+          </button>
+          <button type="button" className={`${buttonPrimary} bg-red-700 hover:bg-red-800`} onClick={handleDelete}>
+            Delete
+          </button>
+        </div>
+      </Modal>
+
+      {/* Reauthentication dialog */}
+      <Modal open={reauthOpen} onClose={() => finishReauth(false)} labelledBy={ids.reauth}>
+        <div className="flex items-center gap-2">
+          <ShieldCheckIcon className="h-6 w-6 text-gray-900" aria-hidden="true" />
+          <h2 id={ids.reauth} className="text-lg font-bold text-gray-900">
+            Confirm it's you
+          </h2>
+        </div>
+        <p id={ids.reauthDesc} className="mt-2 text-sm text-gray-600">
+          For your security, verify your identity before changing how you sign in.
+        </p>
+
+        {reauthError && (
+          <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {reauthError}
+          </div>
+        )}
+
+        {credentials.length > 0 && (
+          <button
+            type="button"
+            onClick={handleReauthPasskey}
+            disabled={reauthBusy}
+            aria-describedby={ids.reauthDesc}
+            className={`${buttonPrimary} mt-4 w-full`}
+          >
+            <KeyIcon className="h-5 w-5" aria-hidden="true" />
+            {reauthBusy ? 'Verifying…' : 'Verify with a passkey'}
+          </button>
+        )}
+
+        {user.hasPassword && (
+          <form onSubmit={handleReauthPassword} className="mt-4 space-y-3">
+            {credentials.length > 0 && (
+              <p className="text-center text-xs uppercase tracking-wide text-gray-500">or use your password</p>
+            )}
+            {/* Lets password managers match the saved credential. */}
+            <input type="text" name="username" value={user.username} autoComplete="username" readOnly hidden />
+            <div>
+              <label htmlFor={`${ids.reauth}-password`} className="block text-sm font-medium text-gray-700 mb-1">
+                Password
+              </label>
+              <input
+                id={`${ids.reauth}-password`}
+                type="password"
+                value={reauthPassword}
+                onChange={(e) => setReauthPassword(e.target.value)}
+                required
+                autoComplete="current-password"
+                className={inputClass}
+              />
+            </div>
+            <button
+              type="submit"
+              disabled={reauthBusy}
+              className={credentials.length > 0 ? `${buttonSecondary} w-full py-2` : `${buttonPrimary} w-full`}
+            >
+              Verify with password
+            </button>
+          </form>
+        )}
+
+        <button
+          type="button"
+          onClick={() => finishReauth(false)}
+          className="mt-4 block w-full text-center text-sm font-medium text-gray-700 underline hover:text-gray-900"
+        >
+          Cancel
+        </button>
+      </Modal>
+    </div>
+  );
+}
diff --git a/src/components/Header.astro b/src/components/Header.astro
