@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+import { callExternalAuth, errorJson, getSessionUser, json, readJson } from '../../../lib/passkeys/server';
+
+/** Re-verifies the signed-in user's password before a sensitive action. */
+export const POST: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return errorJson('Not signed in.', 401);
+  if (!user.hasPassword) return errorJson('This account does not use a password.', 400);
+
+  const body = await readJson<{ password?: string }>(ctx);
+  if (!body?.password) return errorJson('Password is required.', 400);
+
+  try {
+    const result = await callExternalAuth('login', user.username, body.password);
+    if (!result.ok) return errorJson(String(result.data.error ?? 'Incorrect password.'), 401);
+    ctx.session?.set('reauthenticatedAt', Date.now());
+    return json({ ok: true });
+  } catch (err) {
+    console.error('[auth] Password reauthentication failed', err);
+    return errorJson('Authentication service unavailable.', 502);
+  }
+};
