diff --git a/src/pages/api/auth/passkey/login-verify.ts b/src/pages/api/auth/passkey/login-verify.ts
new file mode 100644
index 0000000..0fa6180
--- /dev/null
+++ b/src/pages/api/auth/passkey/login-verify.ts
@@ -0,0 +1,31 @@
+import type { APIRoute } from 'astro';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { verifyAssertion } from '../../../../lib/passkeys/ceremonies';
+import { errorJson, json, readJson, startSession, takeChallenge, toPublicUser } from '../../../../lib/passkeys/server';
+import { findCredential, findUser } from '../../../../lib/passkeys/store';
+
+export const POST: APIRoute = async (ctx) => {
+  const response = await readJson<AuthenticationResponseJSON>(ctx);
+  const pending = await takeChallenge(ctx, 'login');
+  if (!response || !pending) return errorJson('Sign-in session expired. Please try again.', 400);
+
+  const cred = findCredential(response.id);
+  const user = cred && findUser(cred.username);
+  // 404 lets the client tell the passkey provider this credential is gone.
+  if (!cred || !user) return errorJson('This passkey is not registered with The DevTools Times.', 404);
+  if (response.response.userHandle && response.response.userHandle !== user.passkeyUserId) {
+    return errorJson('Passkey does not match this account.', 400);
+  }
+
+  try {
+    if (!(await verifyAssertion(ctx, pending, response, cred))) {
+      return errorJson('Passkey could not be verified.', 400);
+    }
+  } catch (err) {
+    console.warn('[passkeys] Authentication verification failed', err);
+    return errorJson('Passkey could not be verified.', 400);
+  }
+
+  await startSession(ctx, user);
+  return json({ user: toPublicUser(user) });
+};
