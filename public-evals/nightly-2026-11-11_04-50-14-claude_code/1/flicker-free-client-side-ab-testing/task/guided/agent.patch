diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,239 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Lumen — Ship faster with less effort</title>
+  <meta name="description" content="Lumen helps teams plan, build and ship products faster.">
+
+  <!-- Open the connection to the experiment CDN as early as possible. -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="preconnect" href="https://images.unsplash.com">
+
+  <!--
+    Anti-flicker FALLBACK — only for browsers without `blocking="render"`
+    support (e.g. Firefox). Must run BEFORE the SDK tag so the page is hidden
+    before the async SDK could possibly execute. Supporting browsers skip it.
+  -->
+  <style>
+    .ab-loading { opacity: 0 !important; }
+  </style>
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var reveal = function () { root.classList.remove('ab-loading'); };
+      // Hook the SDK (or the script tag's load/error handlers) can call.
+      window.onExperimentReady = reveal;
+
+      if (!('blocking' in HTMLScriptElement.prototype)) {
+        root.classList.add('ab-loading');
+        // Never leave the page blank if the CDN is slow or down.
+        setTimeout(reveal, 3000);
+      }
+    })();
+  </script>
+
+  <!--
+    Experiment SDK.
+    - `async`: does not block HTML parsing; the DOM is built while it downloads.
+    - `blocking="render"`: the browser will not paint until the script has
+      executed, so the variant is applied before the first frame — no flash of
+      the original content, no opacity hacks in supporting browsers.
+    load/error also reveal the page for the fallback path.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+    onload="window.onExperimentReady()"
+    onerror="window.onExperimentReady()"
+  ></script>
+
+  <style>
+    :root {
+      color-scheme: light dark;
+      --bg: light-dark(#ffffff, #0d1117);
+      --fg: light-dark(#0f172a, #e6edf3);
+      --muted: light-dark(#475569, #9aa7b4);
+      --accent: #4f46e5;
+      --accent-hover: #4338ca;
+      --radius: 0.75rem;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+    }
+
+    *, *::before, *::after { box-sizing: border-box; }
+
+    body {
+      margin: 0;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+    }
+
+    .site-header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      max-width: 72rem;
+      margin-inline: auto;
+      padding: 1.25rem 1.5rem;
+    }
+
+    .logo {
+      font-weight: 800;
+      font-size: 1.25rem;
+      color: inherit;
+      text-decoration: none;
+    }
+
+    .site-header nav a {
+      color: var(--muted);
+      text-decoration: none;
+      margin-inline-start: 1.5rem;
+    }
+    .site-header nav a:hover { color: var(--fg); }
+
+    .hero {
+      display: grid;
+      grid-template-columns: 1fr;
+      gap: 3rem;
+      align-items: center;
+      max-width: 72rem;
+      margin-inline: auto;
+      padding: 3rem 1.5rem 5rem;
+    }
+
+    @media (min-width: 900px) {
+      .hero { grid-template-columns: 1.1fr 1fr; padding-block: 5rem 7rem; }
+    }
+
+    .eyebrow {
+      display: inline-block;
+      font-size: 0.875rem;
+      font-weight: 600;
+      color: var(--accent);
+      background: color-mix(in oklab, var(--accent) 12%, transparent);
+      padding: 0.25rem 0.75rem;
+      border-radius: 999px;
+      margin: 0 0 1rem;
+    }
+
+    .hero h1 {
+      font-size: clamp(2.25rem, 5vw + 1rem, 4rem);
+      line-height: 1.1;
+      letter-spacing: -0.02em;
+      margin: 0 0 1.25rem;
+      text-wrap: balance;
+    }
+
+    .hero p.lede {
+      font-size: 1.25rem;
+      color: var(--muted);
+      max-width: 36rem;
+      margin: 0 0 2rem;
+      text-wrap: pretty;
+    }
+
+    .cta-row {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 1rem;
+      align-items: center;
+    }
+
+    .cta-button {
+      display: inline-block;
+      background: var(--accent);
+      color: #fff;
+      font-size: 1.125rem;
+      font-weight: 600;
+      text-decoration: none;
+      padding: 0.9rem 1.75rem;
+      border-radius: var(--radius);
+      box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--accent) 70%, transparent);
+      transition: background-color 0.15s, transform 0.15s;
+    }
+    .cta-button:hover { background: var(--accent-hover); transform: translateY(-1px); }
+    .cta-button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+
+    .secondary-link {
+      color: var(--fg);
+      font-weight: 600;
+      text-decoration: none;
+    }
+    .secondary-link:hover { text-decoration: underline; }
+
+    .hero-note {
+      font-size: 0.875rem;
+      color: var(--muted);
+      margin-top: 1rem;
+    }
+
+    .hero-media img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: calc(var(--radius) * 1.5);
+      box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.35);
+    }
+
+    /*
+      Variant hooks: the SDK can simply set `data-variant` on <html>
+      (e.g. document.documentElement.dataset.variant = "b") instead of
+      rewriting DOM, and these rules apply before first paint.
+    */
+    [data-variant="b"] .cta-button { --accent: #059669; --accent-hover: #047857; }
+    [data-variant="b"] .hero-headline-a { display: none; }
+    :root:not([data-variant="b"]) .hero-headline-b { display: none; }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a class="logo" href="/">Lumen</a>
+    <nav aria-label="Primary">
+      <a href="#features">Features</a>
+      <a href="#pricing">Pricing</a>
+      <a href="#login">Log in</a>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-title" data-experiment="hero">
+      <div class="hero-copy">
+        <p class="eyebrow">New: Lumen 2.0 is here</p>
+        <h1 id="hero-title" data-experiment-slot="headline">
+          <span class="hero-headline-a">Ship better products, faster.</span>
+          <span class="hero-headline-b">Your team's work, finally in one place.</span>
+        </h1>
+        <p class="lede" data-experiment-slot="subheadline">
+          Lumen brings planning, docs and delivery together so your team can
+          spend less time coordinating and more time building.
+        </p>
+        <div class="cta-row">
+          <a class="cta-button" href="#signup" data-experiment-slot="cta" id="primary-cta">
+            Start your free trial
+          </a>
+          <a class="secondary-link" href="#demo">Watch the demo →</a>
+        </div>
+        <p class="hero-note">No credit card required · 14-day free trial</p>
+      </div>
+
+      <div class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80"
+          srcset="
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80 600w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80 1200w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1800&q=80 1800w"
+          sizes="(min-width: 900px) 34rem, 100vw"
+          width="1200" height="900"
+          alt="A team collaborating around laptops at a shared table"
+          fetchpriority="high"
+        >
+      </div>
+    </section>
+  </main>
+</body>
+</html>
