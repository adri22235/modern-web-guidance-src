diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,239 @@
+<!DOCTYPE html>
+<html lang="en" class="exp-pending">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Lumen — Ship faster with less noise</title>
+  <meta name="description" content="Lumen helps teams plan, build and ship products without the busywork." />
+
+  <!-- Open the connection to the experiment CDN as early as possible. -->
+  <link rel="preconnect" href="https://cdn.example.com" />
+  <link rel="preload" href="https://cdn.example.com/experiment-sdk.js" as="script" />
+
+  <!--
+    ANTI-FLICKER GUARD
+    This must stay inline, in <head>, and before any content is rendered.
+    Elements marked with [data-experiment] are hidden (visibility, so layout
+    doesn't shift) until the A/B SDK has applied the user's variant. The
+    rest of the page renders normally.
+  -->
+  <style id="exp-antiflicker">
+    .exp-pending [data-experiment] { visibility: hidden !important; }
+  </style>
+  <noscript>
+    <!-- Without JS the SDK can't run, so never hide anything. -->
+    <style>.exp-pending [data-experiment] { visibility: visible !important; }</style>
+  </noscript>
+
+  <script>
+    (function () {
+      var SDK_URL = 'https://cdn.example.com/experiment-sdk.js';
+      // Hard upper bound: never keep content hidden longer than this, even
+      // if the CDN is slow or the SDK never signals readiness.
+      var MAX_HIDE_MS = 2500;
+      var root = document.documentElement;
+      var revealed = false;
+
+      function reveal(reason) {
+        if (revealed) return;
+        revealed = true;
+        clearTimeout(timer);
+        root.classList.remove('exp-pending');
+        root.setAttribute('data-exp-status', reason);
+      }
+
+      // Public hook: the SDK (or any integration code) may call this once the
+      // variant has been applied to the DOM.
+      window.__experimentReveal = function () { reveal('applied'); };
+
+      // The SDK may alternatively dispatch a DOM event when it's done.
+      document.addEventListener('experiment:applied', function () { reveal('applied'); });
+      document.addEventListener('experiment:ready', function () { reveal('applied'); });
+
+      var timer = setTimeout(function () { reveal('timeout'); }, MAX_HIDE_MS);
+
+      function afterDomReady(fn) {
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', fn, { once: true });
+        } else {
+          fn();
+        }
+      }
+
+      var s = document.createElement('script');
+      s.src = SDK_URL;
+      s.async = true;
+      s.onload = function () {
+        // If the SDK exposes a readiness promise, wait for it; otherwise
+        // assume it applies variants synchronously once the DOM exists and
+        // reveal on the next frame (after its mutations are committed).
+        var sdk = window.ExperimentSDK || window.experimentSDK;
+        if (sdk && sdk.ready && typeof sdk.ready.then === 'function') {
+          sdk.ready.then(
+            function () { reveal('applied'); },
+            function () { reveal('sdk-error'); }
+          );
+        } else if (sdk && typeof sdk.onReady === 'function') {
+          sdk.onReady(function () { reveal('applied'); });
+        } else {
+          afterDomReady(function () {
+            requestAnimationFrame(function () { reveal('loaded'); });
+          });
+        }
+      };
+      // Network/CSP failure: show the original content immediately.
+      s.onerror = function () { reveal('load-error'); };
+
+      document.head.appendChild(s);
+    })();
+  </script>
+
+  <style>
+    :root {
+      --bg: #0b0d12;
+      --fg: #f4f5f7;
+      --muted: #a3a9b6;
+      --accent: #6c5ce7;
+      --accent-hover: #5a4bd4;
+      --radius: 12px;
+    }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    html, body { height: 100%; }
+    body {
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+      -webkit-font-smoothing: antialiased;
+    }
+    a { color: inherit; text-decoration: none; }
+
+    .nav {
+      position: absolute; inset: 0 0 auto 0; z-index: 2;
+      display: flex; align-items: center; justify-content: space-between;
+      max-width: 1200px; margin: 0 auto; padding: 1.5rem 2rem;
+    }
+    .logo { font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; }
+    .logo span { color: var(--accent); }
+    .nav ul { display: flex; gap: 2rem; list-style: none; color: var(--muted); font-size: 0.95rem; }
+    .nav ul a:hover { color: var(--fg); }
+
+    .hero {
+      position: relative;
+      min-height: 100vh;
+      display: grid; place-items: center;
+      padding: 7rem 2rem 4rem;
+      overflow: hidden;
+      isolation: isolate;
+    }
+    .hero__bg {
+      position: absolute; inset: 0; z-index: -2;
+      width: 100%; height: 100%; object-fit: cover;
+    }
+    .hero::after {
+      content: ""; position: absolute; inset: 0; z-index: -1;
+      background:
+        radial-gradient(ellipse at top, rgba(108, 92, 231, 0.35), transparent 60%),
+        linear-gradient(180deg, rgba(11, 13, 18, 0.65) 0%, rgba(11, 13, 18, 0.92) 100%);
+    }
+    .hero__content { max-width: 760px; text-align: center; }
+    .eyebrow {
+      display: inline-block; margin-bottom: 1.25rem;
+      padding: 0.35rem 0.85rem; border-radius: 999px;
+      background: rgba(108, 92, 231, 0.18); border: 1px solid rgba(108, 92, 231, 0.45);
+      color: #c9c2ff; font-size: 0.85rem; font-weight: 600;
+    }
+    .hero h1 {
+      font-size: clamp(2.4rem, 6vw, 4.25rem);
+      line-height: 1.08; letter-spacing: -0.035em; font-weight: 800;
+      margin-bottom: 1.25rem;
+    }
+    .hero p.lead {
+      font-size: clamp(1.05rem, 2vw, 1.25rem);
+      color: var(--muted); max-width: 600px; margin: 0 auto 2.25rem;
+    }
+    .cta-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
+    .btn {
+      display: inline-flex; align-items: center; gap: 0.5rem;
+      padding: 0.95rem 1.75rem; border-radius: var(--radius);
+      font-size: 1.05rem; font-weight: 650; cursor: pointer; border: 0;
+      transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
+    }
+    .btn--primary {
+      background: var(--accent); color: #fff;
+      box-shadow: 0 10px 30px -10px rgba(108, 92, 231, 0.8);
+    }
+    .btn--primary:hover { background: var(--accent-hover); transform: translateY(-1px); }
+    .btn--ghost {
+      background: rgba(255, 255, 255, 0.06); color: var(--fg);
+      border: 1px solid rgba(255, 255, 255, 0.14);
+    }
+    .btn--ghost:hover { background: rgba(255, 255, 255, 0.1); }
+    .btn:focus-visible { outline: 3px solid #c9c2ff; outline-offset: 3px; }
+    .fineprint { margin-top: 1rem; font-size: 0.85rem; color: var(--muted); }
+
+    @media (max-width: 640px) {
+      .nav ul { display: none; }
+    }
+    @media (prefers-reduced-motion: reduce) {
+      .btn { transition: none; }
+    }
+  </style>
+</head>
+<body>
+  <header class="nav">
+    <a class="logo" href="/">Lumen<span>.</span></a>
+    <nav aria-label="Primary">
+      <ul>
+        <li><a href="#features">Features</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#login">Log in</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <!--
+      The whole hero is an experiment surface. The SDK can target the
+      [data-experiment-id] hooks below to swap headline, copy, CTA text, etc.
+      It stays hidden until the variant is applied (see anti-flicker guard).
+    -->
+    <section class="hero" data-experiment="hero" aria-labelledby="hero-title">
+      <img
+        class="hero__bg"
+        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=2000&q=70"
+        alt=""
+        fetchpriority="high"
+      />
+      <div class="hero__content">
+        <span class="eyebrow" data-experiment-id="hero-eyebrow">New: AI-powered roadmaps</span>
+        <h1 id="hero-title" data-experiment-id="hero-headline">Ship faster with less noise.</h1>
+        <p class="lead" data-experiment-id="hero-subheadline">
+          Lumen brings planning, docs and delivery into one calm workspace so
+          your team can focus on building what matters.
+        </p>
+        <div class="cta-group">
+          <a class="btn btn--primary" href="#signup" id="primary-cta" data-experiment-id="hero-cta">
+            Start free trial
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
+            </svg>
+          </a>
+          <a class="btn btn--ghost" href="#demo" data-experiment-id="hero-secondary-cta">Watch demo</a>
+        </div>
+        <p class="fineprint" data-experiment-id="hero-fineprint">14-day free trial · No credit card required</p>
+      </div>
+    </section>
+  </main>
+
+  <script>
+    // Report CTA clicks along with the variant the user saw (if the SDK exposes it).
+    document.getElementById('primary-cta').addEventListener('click', function () {
+      var sdk = window.ExperimentSDK || window.experimentSDK;
+      if (sdk && typeof sdk.track === 'function') {
+        sdk.track('hero_cta_click');
+      }
+    });
+  </script>
+</body>
+</html>
