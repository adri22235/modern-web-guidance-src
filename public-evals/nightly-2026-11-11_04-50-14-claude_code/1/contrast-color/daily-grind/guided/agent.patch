diff --git a/index.html b/index.html
index 1bacf96..300bdfd 100644
--- a/index.html
+++ b/index.html
@@ -14,6 +14,32 @@
       --light: #fafafa;
     }
 
+    /*
+     * Auto-contrast text: any element that sets --surface as its background
+     * gets black or white text, whichever contrasts best with it.
+     * Change --primary / --secondary and text adapts automatically.
+     */
+    nav,
+    .btn,
+    footer {
+      background-color: var(--surface);
+      /* 1. Legacy fallback for browsers without relative color syntax */
+      color: var(--surface-fallback-text, white);
+      /* 2. WCAG luminance threshold via relative color syntax (CIE XYZ D65, y = relative luminance) */
+      --wcag-y-threshold: 0.17913;
+      --y: max(0, sign(var(--wcag-y-threshold) - y));
+      color: color(from var(--surface) xyz-d65 calc(var(--y) * 0.9505) var(--y) calc(var(--y) * 1.089));
+    }
+
+    /* 3. Native contrast-color() where supported */
+    @supports (color: contrast-color(red)) {
+      nav,
+      .btn,
+      footer {
+        color: contrast-color(var(--surface));
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
@@ -29,8 +55,7 @@
 
     /* Navigation */
     nav {
-      background: var(--primary);
-      color: white;
+      --surface: var(--primary);
       padding: 1rem 5%;
       display: flex;
       justify-content: space-between;
@@ -56,14 +81,18 @@
     }
 
     nav a {
-      color: white;
-      text-decoration: none;
+      color: inherit;
+      text-decoration: underline 2px transparent;
+      text-underline-offset: 4px;
       font-size: 0.9rem;
-      transition: color 0.3s;
+      transition: text-decoration-color 0.3s;
     }
 
-    nav a:hover {
-      color: var(--accent);
+    /* Indicate hover with an accent underline rather than recoloring the text,
+       so link text keeps its auto-computed contrast on any --primary. */
+    nav a:hover,
+    nav a:focus-visible {
+      text-decoration-color: var(--accent);
     }
 
     .logout-link {
@@ -121,21 +150,24 @@
     }
 
     .btn {
+      --surface: var(--primary);
       display: inline-block;
-      background: var(--primary);
       padding: 10px 20px;
       text-decoration: none;
       border-radius: 5px;
       margin-top: 15px;
-      transition: background 0.3s;
+      transition: background-color 0.3s, color 0.3s;
     }
 
-    .btn:hover {
-      background: #3e2723;
+    /* Hover shade derived from --primary; text re-computes against it */
