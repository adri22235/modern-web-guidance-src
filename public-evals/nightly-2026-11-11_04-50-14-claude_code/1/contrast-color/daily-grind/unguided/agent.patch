+     * text have equal WCAG contrast, so this always picks the better option.
+     */
+    nav,
+    footer,
+    .btn {
+      background: var(--surface);
+      color: var(--surface-fallback-text);
+    }
+
+    @supports (color: contrast-color(red)) {
