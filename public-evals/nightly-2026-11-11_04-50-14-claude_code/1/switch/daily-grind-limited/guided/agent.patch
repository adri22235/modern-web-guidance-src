+  <script>
+    (() => {
+      const KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById("dark-theme-toggle");
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
+      const rendered = () => meta.content === "light dark" ? (systemDark.matches ? "dark" : "light") : meta.content;
+      const sync = () => { toggle.checked = rendered() === "dark"; };
+      const apply = (value) => { meta.content = value ?? "light dark"; sync(); };
+
+      toggle.addEventListener("change", () => {
+        const target = toggle.checked ? "dark" : "light";
+        const system = systemDark.matches ? "dark" : "light";
+        // Matching the system preference means "undo my override": follow the system again.
+        const value = target === system ? null : target;
+        try {
+          value ? localStorage.setItem(KEY, value) : localStorage.removeItem(KEY);
+        } catch {}
+        apply(value);
+      });
+
+      systemDark.addEventListener("change", sync);
+      addEventListener("storage", (e) => { if (e.key === KEY || e.key === null) apply(read()); });
+      sync();
+    })();
+  </script>
+
