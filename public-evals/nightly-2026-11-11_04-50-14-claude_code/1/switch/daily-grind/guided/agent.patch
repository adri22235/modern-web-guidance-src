+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://esm.sh/input-switch-polyfill');
+    }
+
+    const meta = document.querySelector('meta[name="color-scheme"]');
+    const toggle = document.getElementById('dark-mode');
+    const systemDark = matchMedia('(prefers-color-scheme: dark)');
+    const KEY = 'color-scheme';
+
+    const isRenderedDark = () =>
+      meta.content === 'dark' || (meta.content === 'light dark' && systemDark.matches);
+
+    const sync = () => { toggle.checked = isRenderedDark(); };
+
+    const apply = (stored) => {
+      meta.content = stored ?? 'light dark';
+      sync();
+    };
+
+    toggle.addEventListener('change', () => {
+      const target = toggle.checked ? 'dark' : 'light';
+      const system = systemDark.matches ? 'dark' : 'light';
+      // Store only when diverging from the system; matching it reverts to "follow system".
+      const stored = target === system ? null : target;
+      try {
+        stored ? localStorage.setItem(KEY, stored) : localStorage.removeItem(KEY);
+      } catch (e) {}
+      apply(stored);
+    });
+
+    // Keep in sync with other tabs and OS changes (when following the system).
+    window.addEventListener('storage', (e) => { if (e.key === KEY) apply(e.newValue); });
+    systemDark.addEventListener('change', sync);
+    sync();
+  </script>
+
 </body>
 
