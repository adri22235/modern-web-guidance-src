+    /* Seasonal favorites: spotlight reveal */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
+    }
+
+    /* Only grow the spotlight for devices with a real hover state */
+    @media (hover: hover) {
+      .product-card:hover {
+        --inner-size: 90px;
+        --outer-size: 110px;
+      }
+    }
+
+    .product-card .reveal-layer {
+      position: absolute;
+      inset: 0;
