+  <script>
+    // Spotlight reveal: track the pointer on each product card.
+    document.querySelectorAll('.product-card').forEach((card) => {
+      let frame = 0;
+      let x = 0;
+      let y = 0;
+
+      card.addEventListener('pointermove', (event) => {
+        const rect = card.getBoundingClientRect();
+        x = event.clientX - rect.left;
+        y = event.clientY - rect.top;
+        if (frame) return;
+        frame = requestAnimationFrame(() => {
+          frame = 0;
+          card.style.setProperty('--mouse-x', `${x}px`);
+          card.style.setProperty('--mouse-y', `${y}px`);
+        });
+      });
+
+      // Keep the last pointer position on leave so the circle shrinks in place.
+      // When focus arrives without the pointer over the card (keyboard), drop the
+      // inline position so the stylesheet's focus position takes over.
+      card.addEventListener('focusin', () => {
+        if (card.matches(':hover')) return;
+        cancelAnimationFrame(frame);
+        frame = 0;
+        card.style.removeProperty('--mouse-x');
+        card.style.removeProperty('--mouse-y');
+      });
+    });
+  </script>
+
