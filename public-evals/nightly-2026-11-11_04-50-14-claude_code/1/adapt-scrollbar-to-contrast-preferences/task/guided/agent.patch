diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,46 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Page scrollbar: espresso thumb on a latte track (~7:1 contrast) */
+      --scrollbar-thumb: var(--primary);
+      --scrollbar-track: var(--secondary);
     }
 
+    html {
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      /* Needed for macOS overlay scrollbars to honor custom colors */
+      scrollbar-width: auto;
+    }
+
+    /* Users asking for more contrast get stark black-on-white scrollbars */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-thumb: #000000;
+        --scrollbar-track: #ffffff;
+      }
+    }
+
+    /* Legacy fallback for WebKit/Blink without scrollbar-color support */
+    @supports not (scrollbar-color: auto) {
+      ::-webkit-scrollbar {
+        width: 12px;
+        height: 12px;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 6px;
+        border: 2px solid var(--scrollbar-track);
+      }
+
+      ::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
