diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,82 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Scrollbar palette */
+      --scrollbar-track: #efebe9;
+      --scrollbar-thumb: #8d6e63;
+      --scrollbar-thumb-hover: #ffab40;
+      --scrollbar-thumb-active: #ff9100;
+      --scrollbar-thumb-border: #efebe9;
     }
 
+    /* Custom scrollbars */
+    html {
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      scrollbar-width: auto;
+    }
+
+    ::-webkit-scrollbar {
+      width: 14px;
+      height: 14px;
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border: 3px solid var(--scrollbar-thumb-border);
+      border-radius: 8px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: var(--scrollbar-thumb-active);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    /* High-contrast scrollbars for users who prefer more contrast */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #1a0d00;
+        --scrollbar-thumb-active: #000000;
+        --scrollbar-thumb-border: #ffffff;
+      }
+
+      ::-webkit-scrollbar-track {
+        box-shadow: inset 0 0 0 1px #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-width: 2px;
+        border-radius: 0;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        outline: 2px solid #000000;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: defer to system colors */
+    @media (forced-colors: active) {
+      html {
+        scrollbar-color: auto;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
