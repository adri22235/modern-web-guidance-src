diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..faf3f6e
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,269 @@
+/**
+ * <coffee-card> — a menu item card with a persistent "favorite" toggle.
+ *
+ * Content stays in the Light DOM (readable without JS, indexable) and is
+ * projected into named slots:
+ *   <img slot="media">        product photo
+ *   <h3 slot="title">          drink name (also used to label the favorite button)
+ *   <data slot="price">        price
+ *   (default slot)             description
+ *   <a slot="action">          call-to-action link
+ *
+ * Attributes:
+ *   category   space-separated tags used by <coffee-menu> for filtering
+ *   favorited  boolean, reflected; persisted to localStorage when the card has an id
+ *
+ * Events:
+ *   favorite-change  (bubbles, composed) detail: { id, name, favorited }
+ *
+ * Theming: --card-bg, --card-fg, --card-accent, --card-radius, --card-shadow
+ * Parts:   card, media, body, favorite
+ */
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+const readFavorites = () => {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+};
+
+const writeFavorite = (id, on) => {
+  try {
+    const favs = readFavorites();
+    on ? favs.add(id) : favs.delete(id);
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...favs]));
+  } catch {
+    /* storage unavailable (private mode, quota) — state still works for this session */
+  }
+};
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--card-bg, #fff);
+    --_fg: var(--card-fg, #3e2723);
+    --_accent: var(--card-accent, #4e342e);
+    --_radius: var(--card-radius, 12px);
+    --_shadow: var(--card-shadow, 0 2px 8px rgb(0 0 0 / 0.1));
+    display: block;
+    container-type: inline-size;
+  }
+  :host([hidden]) { display: none; }
+
+  .card {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    block-size: 100%;
+    background: var(--_bg);
+    color: var(--_fg);
+    border-radius: var(--_radius);
+    box-shadow: var(--_shadow);
+    overflow: hidden;
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+  }
+  :host(:hover) .card,
+  :host(:focus-within) .card {
+    transform: translateY(-3px);
+    box-shadow: 0 8px 20px rgb(0 0 0 / 0.15);
+  }
+
+  .media {
+    aspect-ratio: 4 / 3;
+    background: #d7ccc8;
+    overflow: hidden;
+  }
+  ::slotted([slot="media"]) {
+    display: block;
+    inline-size: 100%;
+    block-size: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    display: flex;
+    flex-direction: column;
+    flex: 1;
+    gap: 0.5rem;
+    padding: 1.25rem;
+    text-align: center;
+  }
+  .heading {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    align-items: baseline;
+    gap: 0.25rem 0.75rem;
+  }
+  ::slotted([slot="title"]) {
+    margin: 0;
+    color: var(--_accent);
+    font-size: 1.2rem;
+  }
+  ::slotted([slot="price"]) {
+    font-weight: 600;
+    color: var(--_fg);
+    opacity: 0.8;
+  }
+  .description { flex: 1; }
+  ::slotted(p) { margin: 0; }
+
+  .actions { margin-block-start: 0.5rem; }
+
+  /* Favorite toggle: a real <button>, so focus, activation and semantics are native. */
+  .favorite {
+    position: absolute;
+    inset-block-start: 0.75rem;
+    inset-inline-end: 0.75rem;
+    display: grid;
+    place-items: center;
+    inline-size: 2.75rem;
+    block-size: 2.75rem;
+    border: 0;
+    border-radius: 50%;
+    background: rgb(255 255 255 / 0.92);
+    color: var(--_accent);
+    font: inherit;
+    cursor: pointer;
+    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
+    transition: transform 0.15s ease, background-color 0.15s ease;
+  }
+  .favorite:hover { transform: scale(1.08); }
+  .favorite:focus-visible {
+    outline: 3px solid var(--card-focus, #ffab40);
+    outline-offset: 2px;
+  }
+  .favorite svg {
+    inline-size: 1.4rem;
+    block-size: 1.4rem;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 2;
+  }
+  .favorite[aria-pressed="true"] { color: #c62828; }
+  .favorite[aria-pressed="true"] svg { fill: currentColor; }
+
+  /* Wider cards (e.g. a single-column featured slot) lay out horizontally. */
+  @container (min-width: 34rem) {
+    .card { flex-direction: row; }
+    .media { aspect-ratio: auto; flex: 0 0 45%; }
+    .body { text-align: start; }
+    .heading { justify-content: start; }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .card, .favorite { transition: none; }
+    :host(:hover) .card, :host(:focus-within) .card, .favorite:hover { transform: none; }
+  }
+
+  @media (forced-colors: active) {
+    .card { border: 1px solid CanvasText; }
+    .favorite { border: 1px solid ButtonText; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <div class="body" part="body">
+      <div class="heading">
+        <slot name="title"></slot>
+        <slot name="price"></slot>
+      </div>
+      <div class="description"><slot></slot></div>
+      <div class="actions"><slot name="action"></slot></div>
+    </div>
+    <button class="favorite" part="favorite" type="button" aria-pressed="false">
+      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 2.9 4.5 6.6 4.5c2.1 0 3.5 1.1 4.4 2.5.9-1.4 2.3-2.5 4.4-2.5 3.7 0 5.7 3.9 4.2 7.3C19.5 16.4 12 21 12 21z"/>
+      </svg>
+    </button>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['favorited'];
+
+  #internals = this.attachInternals();
+  #button;
+  #titleSlot;
+
+  constructor() {
+    super();
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(template.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+
+    this.#button = this.shadowRoot.querySelector('.favorite');
+    this.#titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+
+    this.#button.addEventListener('click', () => this.toggleFavorite());
+    this.#titleSlot.addEventListener('slotchange', () => this.#updateLabel());
+  }
+
+  connectedCallback() {
+    // Restore persisted state (idempotent: connectedCallback re-runs on moves).
+    if (this.id && readFavorites().has(this.id)) this.favorited = true;
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#sync();
+  }
+
+  /** Drink name, taken from the slotted title. */
+  get name() {
+    return this.querySelector('[slot="title"]')?.textContent.trim() ?? '';
+  }
+
+  /** Category tags from the `category` attribute. */
+  get categories() {
+    return (this.getAttribute('category') ?? '').split(/\s+/).filter(Boolean);
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(on) {
+    this.toggleAttribute('favorited', Boolean(on));
+  }
+
+  toggleFavorite(force = !this.favorited) {
+    if (force === this.favorited) return;
+    this.favorited = force;
+    if (this.id) writeFavorite(this.id, force);
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { id: this.id, name: this.name, favorited: force },
+    }));
+  }
+
+  #sync() {
+    const on = this.favorited;
+    this.#button.setAttribute('aria-pressed', String(on));
+    // Read-only styling hook for consumers: coffee-card:state(favorited)
+    try {
+      on ? this.#internals.states?.add('favorited') : this.#internals.states?.delete('favorited');
+    } catch { /* older engines: use the reflected [favorited] attribute instead */ }
+    this.#updateLabel();
+  }
+
+  #updateLabel() {
+    // The label must live in the same tree as the button (ids can't cross the
+    // shadow boundary), so it's composed from the slotted title text.
+    const name = this.name;
+    this.#button.setAttribute('aria-label', name ? `Favorite ${name}` : 'Favorite');
+    this.#button.title = this.favorited ? `Remove ${name} from favorites` : `Add ${name} to favorites`;
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
diff --git a/components/coffee-menu.js b/components/coffee-menu.js
new file mode 100644
index 0000000..19eb26d
--- /dev/null
+++ b/components/coffee-menu.js
@@ -0,0 +1,217 @@
+/**
+ * <coffee-menu> — a filterable grid of <coffee-card> elements.
+ *
+ * Filter buttons are generated from the cards' `category` attributes, plus
+ * "All" and "Favorites". Each filter is a native <button aria-pressed>, and the
+ * result count is announced through a polite live region.
+ *
+ * Attributes:
+ *   filter  the active filter ("all", "favorites", or a category); reflected
+ *   label   accessible name of the filter toolbar (default "Filter drinks")
+ *
+ * Events:
+ *   filter-change  (bubbles) detail: { filter, visible }
+ *
+ * Theming: --menu-accent, --menu-accent-fg, --menu-min-column
+ * Parts:   toolbar, filter, filter-active, status, grid
+ */
+
+import './coffee-card.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_accent: var(--menu-accent, #4e342e);
+    --_accent-fg: var(--menu-accent-fg, #fff);
+    display: block;
+  }
+
+  .toolbar {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    gap: 0.5rem;
+    margin-block: 1rem;
+  }
+
+  .filter {
+    font: inherit;
+    font-size: 0.9rem;
+    padding: 0.5rem 1.1rem;
+    min-block-size: 2.75rem;
+    border: 2px solid var(--_accent);
+    border-radius: 999px;
+    background: transparent;
+    color: var(--_accent);
+    cursor: pointer;
+    transition: background-color 0.2s ease, color 0.2s ease;
+  }
+  .filter:hover { background: color-mix(in srgb, var(--_accent) 10%, transparent); }
+  .filter[aria-pressed="true"] {
+    background: var(--_accent);
+    color: var(--_accent-fg);
+  }
+  .filter:focus-visible {
+    outline: 3px solid var(--menu-focus, #ffab40);
+    outline-offset: 2px;
+  }
+
+  .status {
+    text-align: center;
+    font-size: 0.9rem;
+    opacity: 0.8;
+    margin-block-end: 1rem;
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--menu-min-column, 250px)), 1fr));
+    gap: 1.5rem;
+  }
+
+  .empty {
+    text-align: center;
+    padding: 2rem 1rem;
+  }
+  .empty[hidden] { display: none; }
+
+  @media (prefers-reduced-motion: reduce) {
+    .filter { transition: none; }
+  }
+  @media (forced-colors: active) {
+    .filter[aria-pressed="true"] { outline: 2px solid Highlight; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="toolbar" part="toolbar" role="group"></div>
+  <p class="status" part="status" role="status"></p>
+  <div class="grid" part="grid" role="list"><slot></slot></div>
+  <div class="empty" hidden><slot name="empty">No drinks match this filter yet.</slot></div>
+`;
+
+const titleCase = (s) => s.charAt(0).toUpperCase() + s.slice(1).replace(/-/g, ' ');
+
+export class CoffeeMenu extends HTMLElement {
+  static observedAttributes = ['filter', 'label'];
+
+  #toolbar;
+  #status;
+  #empty;
+  #slot;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+
+    this.#toolbar = this.shadowRoot.querySelector('.toolbar');
+    this.#status = this.shadowRoot.querySelector('.status');
+    this.#empty = this.shadowRoot.querySelector('.empty');
+    this.#slot = this.shadowRoot.querySelector('.grid slot');
+
+    this.#toolbar.addEventListener('click', (e) => {
+      const btn = e.target.closest('button[data-filter]');
+      if (!btn) return;
+      this.filter = btn.dataset.filter;
+    });
+
+    // Cards may arrive after upgrade (parser streaming, dynamic inserts).
+    this.#slot.addEventListener('slotchange', () => {
+      this.#renderFilters();
+      this.#apply();
+    });
+
+    // Un-favoriting a card while viewing "Favorites" should update the view.
+    this.addEventListener('favorite-change', () => {
+      if (this.filter === 'favorites') this.#apply();
+    });
+  }
+
+  connectedCallback() {
+    this.#toolbar.setAttribute('aria-label', this.getAttribute('label') ?? 'Filter drinks');
+    this.#renderFilters();
+    this.#apply();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'label') {
+      this.#toolbar.setAttribute('aria-label', newVal ?? 'Filter drinks');
+    } else {
+      this.#syncButtons();
+      this.#apply();
+    }
+  }
+
+  get filter() {
+    return this.getAttribute('filter') ?? 'all';
+  }
+  set filter(value) {
+    this.setAttribute('filter', value || 'all');
+  }
+
+  get cards() {
+    return this.#slot.assignedElements().filter((el) => el.localName === 'coffee-card');
+  }
+
+  #renderFilters() {
+    const categories = [...new Set(this.cards.flatMap((c) => c.categories))];
+    const filters = ['all', ...categories, 'favorites'];
+    const current = [...this.#toolbar.children].map((b) => b.dataset.filter);
+    if (current.join() === filters.join()) return; // unchanged; keep focus intact
+
+    this.#toolbar.replaceChildren(...filters.map((f) => {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.className = 'filter';
+      btn.dataset.filter = f;
+      btn.textContent = f === 'all' ? 'All' : f === 'favorites' ? '♥ Favorites' : titleCase(f);
+      return btn;
+    }));
+    this.#syncButtons();
+  }
+
+  #syncButtons() {
+    for (const btn of this.#toolbar.children) {
+      const active = btn.dataset.filter === this.filter;
+      btn.setAttribute('aria-pressed', String(active));
+      btn.part = active ? 'filter filter-active' : 'filter';
+    }
+  }
+
+  #apply() {
+    const filter = this.filter;
+    let visible = 0;
+    for (const card of this.cards) {
+      // Cards are list items of the shadow role="list" grid.
+      card.setAttribute('role', 'listitem');
+      const match =
+        filter === 'all' ||
+        (filter === 'favorites' ? card.favorited : card.categories.includes(filter));
+      card.hidden = !match;
+      if (match) visible++;
+    }
+    this.#empty.hidden = visible > 0;
+
+    const label = filter === 'all' ? 'all drinks'
+      : filter === 'favorites' ? 'favorites'
+      : `${titleCase(filter).toLowerCase()} drinks`;
+    const text = `Showing ${visible} of ${this.cards.length} — ${label}`;
+
+    // Screen readers only announce the live region when its text actually changes,
+    // so re-applying the same filter (e.g. on slotchange) stays silent.
+    if (this.#status.textContent !== text) this.#status.textContent = text;
+
+    this.dispatchEvent(new CustomEvent('filter-change', {
+      bubbles: true,
+      detail: { filter, visible },
+    }));
+  }
+}
+
+if (!customElements.get('coffee-menu')) {
+  customElements.define('coffee-menu', CoffeeMenu);
+}
diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..4514706
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,188 @@
+/**
+ * <site-nav> — sticky, responsive site navigation with a disclosure menu on
+ * narrow widths.
+ *
+ *   <site-nav label="Main">
+ *     <a slot="brand" href="/">THE DAILY GRIND</a>
+ *     <ul> …links… </ul>
+ *   </site-nav>
+ *
+ * The <nav> landmark and the menu toggle live in the shadow tree; the links
+ * stay in the Light DOM. The toggle is a native <button aria-expanded> whose
+ * aria-controls target is in the same shadow tree. Escape closes the menu and
+ * returns focus to the toggle.
+ *
+ * Layout responds to the component's own width (container query), not the
+ * viewport, so it also works inside narrower layouts.
+ *
+ * Theming: --nav-bg, --nav-fg, --nav-accent (collapses below 48rem of its own width)
+ * Parts:   nav, toggle, menu
+ * States:  site-nav:state(open)
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--nav-bg, #4e342e);
+    --_fg: var(--nav-fg, #fff);
+    --_accent: var(--nav-accent, #ffab40);
+    display: block;
+    position: sticky;
+    inset-block-start: 0;
+    z-index: 1000;
+    container-type: inline-size;
+    background: var(--_bg);
+    color: var(--_fg);
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 0.5rem 1rem;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot="brand"]) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    text-decoration: none;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    min-block-size: 2.75rem;
+    padding: 0.4rem 0.9rem;
+    font: inherit;
+    color: inherit;
+    background: transparent;
+    border: 1px solid currentColor;
+    border-radius: 6px;
+    cursor: pointer;
+  }
+  .toggle svg {
+    inline-size: 1.25rem;
+    block-size: 1.25rem;
+    stroke: currentColor;
+    stroke-width: 2;
+    stroke-linecap: round;
+  }
+  .toggle .bar { transition: transform 0.2s ease, opacity 0.2s ease; transform-origin: center; }
+  .toggle[aria-expanded="true"] .top { transform: translateY(6px) rotate(45deg); }
+  .toggle[aria-expanded="true"] .mid { opacity: 0; }
+  .toggle[aria-expanded="true"] .bot { transform: translateY(-6px) rotate(-45deg); }
+
+  .toggle:focus-visible,
+  ::slotted([slot="brand"]:focus-visible) {
+    outline: 3px solid var(--_accent);
+    outline-offset: 3px;
+  }
+
+  ::slotted(ul) {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.25rem 1.25rem;
+    margin: 0;
+    padding: 0;
+    list-style: none;
+  }
+
+  /* Narrow: collapse links behind the disclosure button. */
+  @container (width < 48rem) {
+    .toggle { display: inline-flex; }
+    .menu {
+      flex-basis: 100%;
+      display: none;
+      padding-block: 0.5rem;
+    }
+    .toggle[aria-expanded="true"] + .menu { display: block; }
+    ::slotted(ul) {
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0.25rem;
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .toggle .bar { transition: none; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <line class="bar top" x1="4" y1="6" x2="20" y2="6"/>
+        <line class="bar mid" x1="4" y1="12" x2="20" y2="12"/>
+        <line class="bar bot" x1="4" y1="18" x2="20" y2="18"/>
+      </svg>
+      <span>Menu</span>
+    </button>
+    <div class="menu" part="menu" id="menu"><slot></slot></div>
+  </nav>
+`;
+
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #internals = this.attachInternals();
+  #nav;
+  #toggle;
+  #menu;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+
+    this.#nav = this.shadowRoot.querySelector('nav');
+    this.#toggle = this.shadowRoot.querySelector('.toggle');
+    this.#menu = this.shadowRoot.querySelector('.menu');
+
+    this.#toggle.addEventListener('click', () => (this.open = !this.open));
+
+    this.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && this.open) {
+        this.open = false;
+        this.#toggle.focus();
+      }
+    });
+
+    // Following a link (e.g. an in-page anchor) closes the collapsed menu.
+    this.addEventListener('click', (e) => {
+      if (this.open && e.target.closest?.('a')) this.open = false;
+    });
+  }
+
+  connectedCallback() {
+    this.#nav.setAttribute('aria-label', this.getAttribute('label') ?? 'Main');
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#nav.setAttribute('aria-label', newVal ?? 'Main');
+  }
+
+  get open() {
+    return this.#toggle.getAttribute('aria-expanded') === 'true';
+  }
+  set open(on) {
+    on = Boolean(on);
+    this.#toggle.setAttribute('aria-expanded', String(on));
+    try {
+      on ? this.#internals.states?.add('open') : this.#internals.states?.delete('open');
