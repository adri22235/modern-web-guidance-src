+/**
+ * Shared helpers for The Daily Grind Web Components.
+ *
+ * Design tokens (--primary, --accent, ...) are defined on :root in the page
+ * and inherit through shadow boundaries, so every component can be themed
+ * from the outside without leaking its internal styles.
+ */
+
+const supportsAdopted =
+  typeof CSSStyleSheet !== 'undefined' &&
+  'replaceSync' in CSSStyleSheet.prototype &&
+  'adoptedStyleSheets' in Document.prototype;
+
+/** Create a reusable stylesheet (shared across all instances of a component). */
+export function css(strings, ...values) {
+  const text = String.raw({ raw: strings }, ...values);
+  if (supportsAdopted) {
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(text);
+    return sheet;
+  }
+  return text;
+}
+
+/** Attach an open shadow root, apply styles and render the template. */
+export function attachShadowWith(host, styles, html) {
+  const root = host.shadowRoot ?? host.attachShadow({ mode: 'open' });
+  const sheets = [baseStyles, ...[].concat(styles)];
+  if (supportsAdopted) {
+    root.adoptedStyleSheets = sheets;
+    root.innerHTML = html;
+  } else {
+    root.innerHTML = sheets.map((s) => `<style>${s}</style>`).join('') + html;
+  }
+  return root;
+}
+
+/** Register a custom element once (safe to import modules multiple times). */
+export function define(name, ctor) {
+  if (!customElements.get(name)) customElements.define(name, ctor);
+}
+
+/** Base styles every component gets: box sizing, focus ring, reduced motion. */
+export const baseStyles = css`
+  :host {
+    box-sizing: border-box;
+  }
+  :host([hidden]) {
+    display: none !important;
+  }
+  *, *::before, *::after {
+    box-sizing: inherit;
+  }
+  :focus-visible {
+    outline: 3px solid var(--focus-ring, var(--accent, #ffab40));
+    outline-offset: 2px;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      transition: none !important;
+      animation: none !important;
+    }
+  }
+`;
+
+/**
+ * Button-like styling for slotted links (e.g. `<a slot="action">`).
+ * `::slotted()` can only target top-level slotted nodes, so the selector is
+ * passed in by the consuming component.
+ */
+export function buttonStyles(selector) {
+  return css`
+    ${selector} {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: #fff;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      font-weight: 600;
+      transition: background-color 0.3s, transform 0.2s;
+    }
+    ${selector.replace(/\)$/, ':hover)')} {
+      background: var(--primary-dark, #3e2723);
+    }
+    ${selector.replace(/\)$/, ':focus-visible)')} {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 2px;
+    }
+  `;
+}
