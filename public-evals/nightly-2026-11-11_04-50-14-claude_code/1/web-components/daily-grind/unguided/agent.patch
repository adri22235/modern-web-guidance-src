+import { css, attachShadowWith, define, buttonStyles } from './shared.js';
+
+/**
+ * <dg-hero>
+ *
+ * Full-width hero banner with a decorative background image.
+ *
+ * Slots:
+ *   (default) – heading and supporting copy (e.g. <h1>, <p>)
+ *   actions   – call-to-action links / buttons
+ *
+ * Attributes:
+ *   image   – background image URL (purely decorative; content stays in slots)
+ *   height  – CSS height, defaults to 60vh
+ */
+const styles = [
+  css`
+    :host {
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      min-height: var(--hero-height, 60vh);
+      padding: 2rem 20px;
+      text-align: center;
+      color: #fff;
+      background-color: var(--primary, #4e342e);
+      background-image:
+        linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        var(--hero-image, none);
+      background-size: cover;
+      background-position: center;
+    }
+    ::slotted(h1) {
+      font-size: clamp(2rem, 6vw, 3rem);
+      line-height: 1.2;
+      margin: 0 0 1rem;
+    }
+    ::slotted(p) {
+      margin: 0;
+      font-size: 1.1rem;
+    }
+    .actions {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 12px;
+      margin-top: 15px;
+    }
+  `,
+  buttonStyles('::slotted(a)'),
+];
+
+class DgHero extends HTMLElement {
+  static observedAttributes = ['image', 'height'];
+
+  constructor() {
+    super();
+    attachShadowWith(
+      this,
+      styles,
+      `<slot></slot><div class="actions" part="actions"><slot name="actions"></slot></div>`
+    );
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'image') {
+      if (value) {
+        this.style.setProperty('--hero-image', `url("${value.replace(/["\\\n]/g, "\\$&")}")`);
+      } else {
+        this.style.removeProperty('--hero-image');
+      }
+    } else if (name === 'height') {
+      if (value) this.style.setProperty('--hero-height', value);
+      else this.style.removeProperty('--hero-height');
+    }
+  }
+}
+
+define('dg-hero', DgHero);
+export { DgHero };
diff --git a/components/dg-site-footer.js b/components/dg-site-footer.js
