diff --git a/components/dg-card-grid.js b/components/dg-card-grid.js
new file mode 100644
index 0000000..bf63c75
--- /dev/null
+++ b/components/dg-card-grid.js
@@ -0,0 +1,50 @@
+import { css, attachShadowWith, define } from './shared.js';
+
+/**
+ * <dg-card-grid>
+ *
+ * Responsive auto-fit grid for cards. Exposes list semantics so assistive
+ * technology announces "list, 3 items" – each direct child becomes a listitem.
+ *
+ * Attributes:
+ *   min-width – minimum column width (default 250px)
+ *   gap       – grid gap (default 20px)
+ */
+const styles = css`
+  :host {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(var(--grid-min, 250px), 100%), 1fr));
+    gap: var(--grid-gap, 20px);
+    margin-top: 20px;
+  }
+`;
+
+class DgCardGrid extends HTMLElement {
+  static observedAttributes = ['min-width', 'gap'];
+
+  constructor() {
+    super();
+    const root = attachShadowWith(this, styles, '<slot></slot>');
+    root.querySelector('slot').addEventListener('slotchange', () => this.#syncItems());
+  }
+
+  connectedCallback() {
+    if (!this.hasAttribute('role')) this.setAttribute('role', 'list');
+    this.#syncItems();
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    const prop = name === 'gap' ? '--grid-gap' : '--grid-min';
+    if (value) this.style.setProperty(prop, value);
+    else this.style.removeProperty(prop);
+  }
+
+  #syncItems() {
+    for (const child of this.children) {
+      if (!child.hasAttribute('role')) child.setAttribute('role', 'listitem');
+    }
+  }
+}
+
+define('dg-card-grid', DgCardGrid);
+export { DgCardGrid };
diff --git a/components/dg-coffee-card.js b/components/dg-coffee-card.js
new file mode 100644
index 0000000..b7b01b4
--- /dev/null
+++ b/components/dg-coffee-card.js
@@ -0,0 +1,267 @@
+import { css, attachShadowWith, define, buttonStyles } from './shared.js';
+
+/**
+ * <dg-coffee-card>
+ *
+ * A menu item card with an optional image, price and favourite toggle.
+ * Content lives in the light DOM so it is indexable and readable without JS.
+ *
+ * Slots:
+ *   media     – optional <img> (give it meaningful alt text, or alt="" if decorative)
+ *   title     – the drink name, ideally a heading (<h3>)
+ *   (default) – description
+ *   action    – call-to-action link (e.g. "View Details")
+ *
+ * Attributes:
+ *   price         – optional display price, e.g. "$5.25"
+ *   favoritable   – shows an accessible favourite toggle (aria-pressed)
+ *   favorite      – reflects the favourite state
+ *   item-id       – key used to persist the favourite in localStorage
+ *                   (falls back to the title text)
+ *
+ * Events:
+ *   dg-favorite-change – { detail: { id, name, favorite } }, bubbles + composed
+ */
+const STORAGE_KEY = 'dg:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY)) || []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) – state is session-only */
+  }
+}
+
+const styles = [
+  css`
+    :host {
+      display: flex;
+      flex-direction: column;
+      background: var(--card-bg, #fff);
+      border-radius: var(--card-radius, 8px);
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+      text-align: center;
+      transition: box-shadow 0.3s, transform 0.3s;
+    }
+    :host(:hover),
+    :host(:focus-within) {
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
+      transform: translateY(-2px);
+    }
+    .media {
+      position: relative;
+    }
+    .media:not(.has-media) {
+      display: contents;
+    }
+    ::slotted([slot='media']) {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+    .body {
+      display: flex;
+      flex-direction: column;
+      flex: 1;
+      padding: 20px;
+    }
+    .header {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 8px;
+      margin-bottom: 10px;
+    }
+    ::slotted([slot='title']) {
+      margin: 0;
+      color: var(--primary, #4e342e);
+      font-size: 1.25rem;
+    }
+    .price {
+      font-weight: 600;
+      color: var(--text, #3e2723);
+      background: var(--secondary, #d7ccc8);
+      border-radius: 999px;
+      padding: 0 10px;
+      font-size: 0.85rem;
+    }
+    .price:empty { display: none; }
+    .description {
+      flex: 1;
+    }
+    ::slotted(p) {
+      margin: 0;
+    }
+    .action {
+      margin-top: 15px;
+    }
+    .favorite {
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      display: inline-grid;
+      place-items: center;
+      width: 44px;
+      height: 44px;
+      border: none;
+      border-radius: 50%;
+      background: rgba(255, 255, 255, 0.92);
+      color: var(--primary, #4e342e);
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
+      cursor: pointer;
+      transition: transform 0.2s, color 0.2s;
+    }
+    /* Without media, place the toggle in the card's top corner. */
+    .media:not(.has-media) .favorite { z-index: 1; }
+    :host { position: relative; }
+    .favorite:hover { transform: scale(1.08); }
+    .favorite[aria-pressed='true'] { color: #c62828; }
+    .favorite svg { width: 22px; height: 22px; }
+    .favorite[aria-pressed='false'] path { fill: none; }
+    .favorite[hidden] { display: none; }
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+    @media (forced-colors: active) {
+      .favorite { border: 1px solid ButtonText; }
+    }
+  `,
+  buttonStyles('::slotted(a)'),
+];
+
+class DgCoffeeCard extends HTMLElement {
+  static observedAttributes = ['price', 'favoritable', 'favorite'];
+
+  #root;
+  #button;
+  #mediaWrap;
+
+  constructor() {
+    super();
+    this.#root = attachShadowWith(
+      this,
+      styles,
+      `<div class="media" part="media">
+        <slot name="media"></slot>
+        <button class="favorite" part="favorite" type="button" aria-pressed="false" hidden>
+          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+            <path fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
+              d="M12 20.35l-1.45-1.32C5.4 14.36 2 11.28 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.78-3.4 6.86-8.55 11.54L12 20.35z" transform="translate(0 1)"/>
+          </svg>
+          <span class="sr-only label"></span>
+        </button>
+      </div>
+      <div class="body" part="body">
+        <div class="header">
+          <slot name="title"></slot>
+          <span class="price" part="price"></span>
+        </div>
+        <div class="description"><slot></slot></div>
+        <div class="action"><slot name="action"></slot></div>
+      </div>`
+    );
+    this.#button = this.#root.querySelector('.favorite');
+    this.#mediaWrap = this.#root.querySelector('.media');
+    this.#button.addEventListener('click', () => this.toggleFavorite());
+    this.#root
+      .querySelector('slot[name="media"]')
+      .addEventListener('slotchange', (e) => {
+        this.#mediaWrap.classList.toggle('has-media', e.target.assignedElements().length > 0);
+      });
+    this.#root
+      .querySelector('slot[name="title"]')
+      .addEventListener('slotchange', () => this.#syncFromContent());
+  }
+
+  #restored = false;
+
+  connectedCallback() {
+    this.#syncFromContent();
+    // Children may not be parsed yet when the element upgrades/connects.
+    queueMicrotask(() => this.#syncFromContent());
+  }
+
+  /** Update the toggle's accessible name and restore persisted state. */
+  #syncFromContent() {
+    this.#syncLabel();
+    if (this.#restored || !this.hasAttribute('favoritable') || !this.itemId) return;
+    this.#restored = true;
+    if (!this.hasAttribute('favorite') && readFavorites().has(this.itemId)) {
+      this.favorite = true;
+    }
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    switch (name) {
+      case 'price': {
+        const price = this.#root.querySelector('.price');
+        price.textContent = value ?? '';
+        break;
+      }
+      case 'favoritable':
+        this.#button.hidden = value === null;
+        break;
+      case 'favorite':
+        this.#button.setAttribute('aria-pressed', String(value !== null));
+        break;
+    }
+  }
+
+  /** Drink name, taken from the title slot. */
+  get name() {
+    return this.querySelector('[slot="title"]')?.textContent.trim() ?? '';
+  }
+
+  get itemId() {
+    return this.getAttribute('item-id') || this.name.toLowerCase().replace(/\s+/g, '-');
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  toggleFavorite(force = !this.favorite) {
+    this.favorite = force;
+    const favorites = readFavorites();
+    if (force) favorites.add(this.itemId);
+    else favorites.delete(this.itemId);
+    writeFavorites(favorites);
+    this.dispatchEvent(
+      new CustomEvent('dg-favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { id: this.itemId, name: this.name, favorite: force },
+      })
+    );
+  }
+
+  #syncLabel() {
+    // Stable name + aria-pressed is the recommended toggle-button pattern.
+    this.#root.querySelector('.label').textContent =
+      `Favorite ${this.name || 'this drink'}`;
+  }
+}
+
+define('dg-coffee-card', DgCoffeeCard);
+export { DgCoffeeCard };
