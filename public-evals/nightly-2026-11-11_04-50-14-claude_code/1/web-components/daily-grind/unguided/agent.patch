+++ b/components/dg-site-footer.js
@@ -0,0 +1,76 @@
+import { css, attachShadowWith, define } from './shared.js';
+
+/**
+ * <dg-site-footer>
+ *
+ * Site footer with a labelled link navigation and legal text.
+ * Visual separators are drawn with CSS so screen readers don't announce
+ * stray "|" characters between links.
+ *
+ * Slots:
+ *   links     – footer links (<a> elements)
+ *   (default) – copyright / legal copy
+ *
+ * Attributes:
+ *   label – accessible name for the footer link nav (default "Footer")
+ */
+const styles = css`
+  :host {
+    display: block;
+    background: var(--secondary, #d7ccc8);
+    color: var(--text, #3e2723);
+    text-align: center;
+    padding: 40px 20px;
+    margin-top: 40px;
+  }
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: center;
+    row-gap: 8px;
+    margin-bottom: 20px;
+  }
+  ::slotted(a) {
+    color: inherit;
+    text-decoration: none;
+    font-size: 0.85rem;
+    padding: 0 10px;
+  }
+  ::slotted(a:not(:last-of-type)) {
+    border-inline-end: 1px solid currentColor;
+  }
+  ::slotted(a:hover) {
+    text-decoration: underline;
+  }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--primary, #4e342e);
+    outline-offset: 2px;
+  }
+  ::slotted(p) {
+    margin: 0;
+  }
+`;
+
+class DgSiteFooter extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+
+  constructor() {
+    super();
+    const root = attachShadowWith(
+      this,
+      styles,
+      `<nav part="links"><slot name="links"></slot></nav><slot></slot>`
+    );
+    this.#nav = root.querySelector('nav');
+    this.#nav.setAttribute('aria-label', 'Footer');
+  }
+
+  attributeChangedCallback(_name, _old, value) {
+    this.#nav.setAttribute('aria-label', value || 'Footer');
+  }
+}
+
+define('dg-site-footer', DgSiteFooter);
+export { DgSiteFooter };
diff --git a/components/dg-site-nav.js b/components/dg-site-nav.js
new file mode 100644
index 0000000..a2629d4
--- /dev/null
+++ b/components/dg-site-nav.js
@@ -0,0 +1,233 @@
+import { css, attachShadowWith, define } from './shared.js';
+
+/**
+ * <dg-site-nav>
+ *
+ * Sticky site navigation with a responsive, accessible disclosure menu.
+ *
+ * Slots:
+ *   logo   – brand / home link
+ *   (default) – navigation links (<a> elements). Add class="nav-cta" to
+ *               emphasise a link (e.g. Logout).
+ *
+ * Attributes:
+ *   label       – accessible name for the nav landmark (default "Primary")
+ *   breakpoint  – width in px below which the menu collapses (default 720)
+ *
+ * Behaviour:
+ *   - Toggle button exposes aria-expanded / aria-controls.
+ *   - Escape closes the menu and returns focus to the toggle.
+ *   - Menu auto-closes when resizing past the breakpoint or when a link is
+ *     activated, or when focus leaves the nav.
+ *   - Marks the link matching the current URL with aria-current="page".
+ */
+const styles = css`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--primary, #4e342e);
+    color: #fff;
+  }
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    padding: 1rem 5%;
+    gap: 0.5rem;
+  }
+  ::slotted([slot='logo']) {
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+    color: inherit;
+    text-decoration: none;
+  }
+  .menu {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+  }
+  ::slotted(a) {
+    color: #fff;
+    text-decoration: none;
+    font-size: 0.9rem;
+    padding: 4px 0;
+    transition: color 0.3s;
+  }
+  ::slotted(a:hover),
+  ::slotted(a[aria-current='page']) {
+    color: var(--accent, #ffab40);
+  }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 3px;
+    border-radius: 2px;
+  }
+  ::slotted(a.nav-cta) {
+    border: 1px solid var(--accent, #ffab40);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    background: transparent;
+    color: inherit;
+    border: 1px solid rgba(255, 255, 255, 0.6);
+    border-radius: 4px;
+    padding: 6px 10px;
+    font: inherit;
+    font-size: 0.9rem;
+    cursor: pointer;
+  }
+  .bars,
+  .bars::before,
+  .bars::after {
+    display: block;
+    width: 18px;
+    height: 2px;
+    background: currentColor;
+    transition: transform 0.2s, opacity 0.2s;
+  }
+  .bars { position: relative; }
+  .bars::before,
+  .bars::after {
+    content: '';
+    position: absolute;
+    left: 0;
+  }
+  .bars::before { top: -6px; }
+  .bars::after { top: 6px; }
+  :host([open]) .bars { background: transparent; }
+  :host([open]) .bars::before { transform: translateY(6px) rotate(45deg); }
+  :host([open]) .bars::after { transform: translateY(-6px) rotate(-45deg); }
+
+  /* Collapsed (narrow) layout */
+  :host([collapsed]) .toggle { display: inline-flex; }
+  :host([collapsed]) .menu {
+    display: none;
+    flex-basis: 100%;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 12px;
+    padding-top: 0.75rem;
+  }
+  :host([collapsed][open]) .menu { display: flex; }
+`;
+
+class DgSiteNav extends HTMLElement {
+  static observedAttributes = ['label', 'breakpoint'];
+
+  #root;
+  #toggle;
+  #mql;
+
+  constructor() {
+    super();
+    this.#root = attachShadowWith(
+      this,
+      styles,
+      `<nav part="nav">
+        <slot name="logo"></slot>
+        <button class="toggle" part="toggle" type="button"
+                aria-expanded="false" aria-controls="menu">
+          <span class="bars" aria-hidden="true"></span>
+          <span>Menu</span>
+        </button>
+        <div class="menu" id="menu" part="menu"><slot></slot></div>
+      </nav>`
+    );
+    this.#toggle = this.#root.querySelector('.toggle');
+  }
+
+  get open() {
+    return this.hasAttribute('open');
+  }
+  set open(value) {
+    this.toggleAttribute('open', Boolean(value));
+    this.#toggle.setAttribute('aria-expanded', String(this.open));
+  }
+
+  connectedCallback() {
+    this.#syncLabel();
+    this.#setupMediaQuery();
+    this.#markCurrent();
+    this.#toggle.addEventListener('click', this.#onToggle);
+    this.addEventListener('keydown', this.#onKeydown);
+    this.addEventListener('click', this.#onLinkClick);
+    this.addEventListener('focusout', this.#onFocusOut);
+  }
+
+  disconnectedCallback() {
+    this.#mql?.removeEventListener('change', this.#onMediaChange);
+    this.#toggle.removeEventListener('click', this.#onToggle);
+    this.removeEventListener('keydown', this.#onKeydown);
+    this.removeEventListener('click', this.#onLinkClick);
+    this.removeEventListener('focusout', this.#onFocusOut);
+  }
+
+  attributeChangedCallback(name) {
+    if (!this.isConnected) return;
+    if (name === 'label') this.#syncLabel();
+    if (name === 'breakpoint') this.#setupMediaQuery();
+  }
+
+  #syncLabel() {
+    this.#root
+      .querySelector('nav')
+      .setAttribute('aria-label', this.getAttribute('label') || 'Primary');
+  }
+
+  #setupMediaQuery() {
+    this.#mql?.removeEventListener('change', this.#onMediaChange);
+    const bp = parseInt(this.getAttribute('breakpoint'), 10) || 720;
+    this.#mql = window.matchMedia(`(max-width: ${bp - 0.02}px)`);
+    this.#mql.addEventListener('change', this.#onMediaChange);
+    this.#onMediaChange();
+  }
+
+  #onMediaChange = () => {
+    this.toggleAttribute('collapsed', this.#mql.matches);
+    if (!this.#mql.matches) this.open = false;
+  };
+
+  #markCurrent() {
+    const here = location.pathname.replace(/\/$/, '') || '/';
+    for (const a of this.querySelectorAll(':scope > a[href]')) {
+      const path = new URL(a.href, location.href).pathname.replace(/\/$/, '') || '/';
+      if (path === here && !a.hasAttribute('aria-current')) {
+        a.setAttribute('aria-current', 'page');
+      }
+    }
+  }
+
+  #onToggle = () => {
+    this.open = !this.open;
+    if (this.open) this.querySelector(':scope > a')?.focus();
+  };
+
+  #onKeydown = (event) => {
+    if (event.key === 'Escape' && this.open) {
+      this.open = false;
+      this.#toggle.focus();
+    }
+  };
+
+  #onLinkClick = (event) => {
+    if (this.open && event.target.closest?.('a')) this.open = false;
+  };
+
+  #onFocusOut = (event) => {
+    if (this.open && !this.contains(event.relatedTarget) &&
+        !this.#root.contains(event.relatedTarget)) {
+      this.open = false;
+    }
+  };
