+  <script>
+    (function () {
+      var stage = document.getElementById('boxStage');
+      var box = document.getElementById('coffeeBox');
+      if (!stage || !box) return;
+
+      // ---- Form handling (works in both 3D and fallback modes) ----
+      function handleSubmit(form, okMessage) {
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var status = form.querySelector('.form-status');
+          var invalid = Array.prototype.find.call(form.elements, function (el) {
+            return el.willValidate && !el.checkValidity();
+          });
+          if (invalid) {
+            status.textContent = (invalid.labels && invalid.labels[0] ? invalid.labels[0].textContent : 'A field') +
+              ': ' + invalid.validationMessage;
+            status.classList.add('error');
+            invalid.focus({ preventScroll: true });
+            return;
+          }
+          status.classList.remove('error');
+          status.textContent = okMessage(new FormData(form));
+          form.reset();
+        });
+      }
+      handleSubmit(document.getElementById('orderForm'), function (d) {
+        return 'Added ' + d.get('qty') + ' bag(s) to your cart. ☕';
+      });
+      handleSubmit(document.getElementById('subscribeForm'), function (d) {
