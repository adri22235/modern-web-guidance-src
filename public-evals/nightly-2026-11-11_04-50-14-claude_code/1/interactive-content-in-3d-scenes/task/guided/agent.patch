+            image = canvas.captureElementImage(element);
+          } catch {
+            canvas.requestPaint(); // no paint record yet; retry on next paint
+            return null;
+          }
+          const width = Math.ceil(image.width);
+          const height = Math.ceil(image.height);
+          image.close?.();
+          return width > 0 && height > 0 ? { width, height } : null;
+        }
+
+        function uploadForm() {
+          const size = getElementImageSize(form);
+          if (!size) return false;
+          gl.bindTexture(gl.TEXTURE_2D, htmlTex);
+          if (htmlTexState.width !== size.width || htmlTexState.height !== size.height) {
+            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, size.width, size.height, 0,
+              gl.RGBA, gl.UNSIGNED_BYTE, null);
+            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+            htmlTexState.width = size.width;
+            htmlTexState.height = size.height;
+          }
+          gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, form, size);
+          return true;
+        }
+
+        // Maps the form's border box (CSS px) onto the canvas (CSS px) for a
+        // -0.5..0.5 quad drawn with `mvp`, so hit testing follows the 3D face.
+        function computeCanvasTransform(element, mvp) {
+          const w = element.offsetWidth, h = element.offsetHeight;
+          const toModel = new DOMMatrix().scale(1 / w, -1 / h, 1 / h).translate(-w / 2, -h / 2);
+          const clipToCanvas = new DOMMatrix()
+            .translate(canvas.clientWidth / 2, canvas.clientHeight / 2)
+            .scale(canvas.clientWidth / 2, -canvas.clientHeight / 2, canvas.clientHeight / 2);
+          return clipToCanvas.multiply(new DOMMatrix(Array.from(mvp))).multiply(toModel);
+        }
+
+        // --- keep the backing store at device-pixel resolution ---
+        const ro = new ResizeObserver(([entry]) => {
+          const dpc = entry.devicePixelContentBoxSize;
+          canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+          canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+          canvas.requestPaint();
+        });
+        const dpcSupported = typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        ro.observe(canvas, dpcSupported ? { box: 'device-pixel-content-box' } : {});
+
+        // --- animation & interaction state ---
+        const state = {
+          time: 0, last: performance.now(),
+          sway: reduceMotion.matches ? 0 : 0.38,   // current sway amplitude (radians)
+          dragYaw: 0, dragPitch: 0, dragging: false, pointerId: null, px: 0, py: 0,
+          formHover: false, formVisible: true, needsUpload: true,
+        };
+        form.addEventListener('pointerenter', () => { state.formHover = true; });
+        form.addEventListener('pointerleave', () => { state.formHover = false; });
+
+        // Dragging empty canvas space (or the kraft sides) spins the box.
+        canvas.addEventListener('pointerdown', (e) => {
+          if (e.target !== canvas || e.button !== 0) return;
+          state.dragging = true;
+          state.pointerId = e.pointerId;
+          state.px = e.clientX; state.py = e.clientY;
+          canvas.setPointerCapture(e.pointerId);
+          canvas.classList.add('dragging');
+        });
+        canvas.addEventListener('pointermove', (e) => {
+          if (!state.dragging || e.pointerId !== state.pointerId) return;
+          state.dragYaw += (e.clientX - state.px) * 0.01;
+          state.dragPitch = Math.max(-0.6, Math.min(0.6, state.dragPitch + (e.clientY - state.py) * 0.006));
+          state.px = e.clientX; state.py = e.clientY;
+        });
+        const endDrag = (e) => {
+          if (e.pointerId !== state.pointerId) return;
+          state.dragging = false;
+          state.pointerId = null;
+          canvas.classList.remove('dragging');
+          // Wrap so the box springs back the short way round.
+          state.dragYaw = Math.atan2(Math.sin(state.dragYaw), Math.cos(state.dragYaw));
+        };
+        canvas.addEventListener('pointerup', endDrag);
+        canvas.addEventListener('pointercancel', endDrag);
+
+        // Keyboard users tabbing into the form get a front-facing, steady label.
+        form.addEventListener('focusin', () => { state.dragYaw = 0; state.dragPitch = 0; });
+
+        function step(now) {
+          const dt = Math.min(0.05, (now - state.last) / 1000);
+          state.last = now;
+          state.time += dt;
+          const calm = state.formHover || form.matches(':focus-within');
+          const targetSway = reduceMotion.matches ? 0 : calm ? 0.06 : 0.38;
+          state.sway += (targetSway - state.sway) * Math.min(1, dt * 2.5);
+          if (!state.dragging) {
+            const k = Math.exp(-dt * 3);
+            state.dragYaw *= k;
+            state.dragPitch *= k;
+          }
+        }
+
+        function render() {
+          const cw = canvas.clientWidth, ch = canvas.clientHeight;
+          if (!cw || !ch) return;
+          gl.viewport(0, 0, canvas.width, canvas.height);
+          gl.clearColor(0, 0, 0, 0);
+          gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+          // Box proportions follow the form: width 1, height = form aspect.
+          const fw = form.offsetWidth || 340, fh = form.offsetHeight || 520;
+          const W = 1, H = fh / fw, D = 0.62;
+
+          // Pick a camera distance so the label renders ~1:1 in CSS pixels
+          // (crisp text), while still fitting narrow / short viewports.
+          const fov = (30 * Math.PI) / 180, t = Math.tan(fov / 2);
+          const faceDist = Math.max(
+            ch / (2 * t * fw),               // 1:1 scale
+            ch / (2 * t * 0.86 * cw),        // fit width
+            H / (2 * t * 0.86),              // fit height
+          );
+          const camDist = faceDist + D / 2;
+          const proj = M.perspective(fov, cw / ch, 0.1, 100);
+          const view = M.translate(0, 0, -camDist);
+          const vp = M.mul(proj, view);
+
+          const yaw = state.sway * Math.sin(state.time * 0.55) + state.dragYaw;
+          const pitch = 0.12 + state.sway * 0.18 * Math.sin(state.time * 0.4) + state.dragPitch;
+          const model = M.mul(M.rotX(pitch), M.rotY(yaw));
+          const light = [-0.35, 0.55, 0.76];
+
+          const faces = [
+            { tex: htmlTex, m: M.chain(M.translate(0, 0, D / 2), M.scale(W, H, 1)), front: true },
+            { tex: texBack, m: M.chain(M.translate(0, 0, -D / 2), M.rotY(Math.PI), M.scale(W, H, 1)) },
+            { tex: texSide, m: M.chain(M.translate(W / 2, 0, 0), M.rotY(Math.PI / 2), M.scale(D, H, 1)) },
+            { tex: texSide, m: M.chain(M.translate(-W / 2, 0, 0), M.rotY(-Math.PI / 2), M.scale(D, H, 1)) },
+            { tex: texTop, m: M.chain(M.translate(0, H / 2, 0), M.rotX(-Math.PI / 2), M.scale(W, D, 1)) },
+            { tex: texTop, m: M.chain(M.translate(0, -H / 2, 0), M.rotX(Math.PI / 2), M.scale(W, D, 1)) },
+          ];
+
+          let frontMVP = null, frontFacing = false;
+          for (const face of faces) {
+            const world = M.mul(model, face.m);
+            // Face normal = world * (0,0,1,0); scale on Z is 1 so no renormalisation issues.
+            const n = [world[8], world[9], world[10]];
+            const len = Math.hypot(...n) || 1;
+            const diffuse = Math.max(0, (n[0] * light[0] + n[1] * light[1] + n[2] * light[2]) / len);
+            const mvp = M.mul(vp, world);
+            gl.uniformMatrix4fv(uMVP, false, mvp);
+            gl.uniform1f(uShade, face.front ? 0.84 + 0.16 * diffuse : 0.5 + 0.5 * diffuse);
+            gl.bindTexture(gl.TEXTURE_2D, face.tex);
+            gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+            if (face.front) {
+              frontMVP = mvp;
+              // Vector from face centre to camera, in world space.
+              const toCam = [-world[12], -world[13], camDist - world[14]];
+              frontFacing = (n[0] * toCam[0] + n[1] * toCam[1] + n[2] * toCam[2]) / len > 0.08;
+            }
+          }
+
+          // Keep the real form aligned with its rendered face; when the label is
+          // turned away, remove it from hit testing and make it inert.
+          if (frontFacing) {
+            if (!state.formVisible) { form.inert = false; state.formVisible = true; }
+            canvas.updateElementGeometry(form, { canvasTransform: computeCanvasTransform(form, frontMVP) });
+          } else if (state.formVisible) {
+            if (form.contains(document.activeElement)) document.activeElement.blur();
+            canvas.clearElementGeometry(form);
+            form.inert = true;
+            state.formVisible = false;
+          }
+        }
+
+        canvas.onpaint = (event) => {
+          if (state.needsUpload || event.changedElements?.length) {
+            try {
+              state.needsUpload = !uploadForm();
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+          render();
+        };
+
+        // --- render loop, paused while the section isn't being rendered ---
+        let rafId = 0;
+        function frame(now) {
+          step(now);
+          canvas.requestPaint();
+          rafId = requestAnimationFrame(frame);
+        }
+        function start() {
+          if (rafId) return;
+          state.last = performance.now();
+          rafId = requestAnimationFrame(frame);
+        }
+        function stop() {
+          cancelAnimationFrame(rafId);
+          rafId = 0;
+        }
+
+        if ('contentVisibility' in document.documentElement.style) {
+          section.addEventListener('contentvisibilityautostatechange', (e) => {
+            e.skipped ? stop() : start();
+          });
+        } else {
+          new IntersectionObserver(([entry]) => {
+            entry.isIntersecting ? start() : stop();
+          }, { rootMargin: '200px' }).observe(stage);
+        }
+        start();
+
+        hint.hidden = false;
+        return true;
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
