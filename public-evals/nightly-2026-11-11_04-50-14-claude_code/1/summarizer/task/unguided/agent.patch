+  <script>
+    (() => {
+      const btn = document.getElementById('summarize-btn');
+      const box = document.getElementById('summary-box');
+      const status = document.getElementById('summary-status');
+      const list = document.getElementById('summary-list');
+      const body = document.getElementById('journal-body');
+
+      const OPTIONS = {
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        sharedContext: "A coffee roaster's blog post about how they source their beans.",
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en'
+      };
+
+      let summarizerPromise = null;
+      let cachedSummary = null;
+
+      function setStatus(msg, isError = false) {
+        status.textContent = msg;
+        status.classList.toggle('error', isError);
+        status.hidden = !msg;
+      }
+
+      // Chrome's built-in Summarizer API (global `Summarizer`), with a
+      // fallback to the older `self.ai.summarizer` namespace.
+      function getApi() {
+        if ('Summarizer' in self) return self.Summarizer;
+        if (self.ai && self.ai.summarizer) return self.ai.summarizer;
+        return null;
+      }
+
+      async function getSummarizer() {
+        const api = getApi();
+        if (!api) {
+          throw new Error("Your browser doesn't support on-device AI summarization. Try a recent version of Chrome.");
+        }
+
+        const availability = api.availability
+          ? await api.availability(OPTIONS)
+          : (await api.capabilities()).available;
+
+        if (availability === 'unavailable' || availability === 'no') {
+          throw new Error('On-device summarization is not available on this device.');
+        }
+
+        const needsDownload = availability !== 'available' && availability !== 'readily';
+        if (needsDownload) setStatus('Downloading the on-device AI model… this only happens once.');
+
+        return api.create({
+          ...OPTIONS,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.total ? e.loaded / e.total : e.loaded) * 100);
+              setStatus(`Downloading the on-device AI model… ${pct}%`);
+            });
+          }
+        });
+      }
+
+      function renderBullets(text) {
+        list.replaceChildren();
+        const lines = text
+          .split('\n')
+          .map((l) => l.trim())
+          .filter(Boolean)
+          .map((l) => l.replace(/^([-*•]|\d+[.)])\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1').replace(/[*_`]/g, ''))
+          .filter(Boolean);
+
+        for (const line of lines) {
+          const li = document.createElement('li');
+          li.textContent = line;
+          list.appendChild(li);
+        }
+      }
+
+      btn.addEventListener('click', async () => {
+        box.hidden = false;
+
+        if (cachedSummary) {
+          renderBullets(cachedSummary);
+          setStatus('');
+          return;
+        }
+
+        btn.disabled = true;
+        list.replaceChildren();
+        setStatus('Summarizing…');
+
+        try {
+          if (!summarizerPromise) summarizerPromise = getSummarizer();
+          const summarizer = await summarizerPromise;
+          setStatus('Summarizing…');
+          const text = body.innerText.trim();
+          cachedSummary = await summarizer.summarize(text);
+          renderBullets(cachedSummary);
+          setStatus('');
+          btn.textContent = '✨ Summarized';
+        } catch (err) {
+          summarizerPromise = null;
+          console.error(err);
+          setStatus(err.message || 'Something went wrong while summarizing.', true);
+        } finally {
+          btn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
