+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const status = document.getElementById('summary-status');
+      const output = document.getElementById('summary-output');
+      const source = document.getElementById('journal-body');
+
+      // Identical options are passed to availability() and create().
+      const options = {
+        sharedContext: "A coffee roaster's blog post about how it sources and roasts its beans.",
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      let summarizerPromise = null;
+
+      const showUnsupported = (message) => {
+        button.disabled = true;
+        status.textContent = message;
+      };
+
+      const renderBullets = (text) => {
+        const items = text
+          .split('\n')
+          .map((line) => line.replace(/^\s*(?:[-*\u2022]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        output.replaceChildren(...items.map((item) => {
+          const li = document.createElement('li');
+          li.textContent = item;
+          return li;
+        }));
+      };
+
+      const getSummarizer = () => {
+        summarizerPromise ??= Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading on-device AI model\u2026 ${Math.round((e.loaded / e.total) * 100)}%`;
+            });
+          },
+        }).catch((err) => {
+          summarizerPromise = null;
+          throw err;
+        });
+        return summarizerPromise;
+      };
+
+      async function init() {
+        if (!('Summarizer' in self)) {
+          showUnsupported('On-device summarization is not supported in this browser.');
+          return;
+        }
+        let availability;
+        try {
+          availability = await Summarizer.availability(options);
+        } catch {
+          availability = 'unavailable';
+        }
+        if (availability === 'unavailable') {
+          showUnsupported('On-device summarization is unavailable on this device.');
+          return;
+        }
+        button.disabled = false;
+        if (availability !== 'available') {
+          status.textContent = 'The first summary downloads a small on-device AI model.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        output.replaceChildren();
+        status.textContent = 'Preparing summarizer\u2026';
+        try {
+          // Called inside the click handler so a model download has the required user gesture.
+          const summarizer = await getSummarizer();
+          status.textContent = 'Summarizing\u2026';
+          let result = '';
+          for await (const chunk of summarizer.summarizeStreaming(source.innerText)) {
+            result += chunk;
+            renderBullets(result);
+          }
+          status.textContent = 'Summary generated on your device.';
+          button.textContent = 'Summarize again';
+        } catch (err) {
+          console.error(err);
+          status.textContent = 'Sorry, we couldn\u2019t generate a summary right now. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      });
+
+      init();
+    })();
+  </script>
+
