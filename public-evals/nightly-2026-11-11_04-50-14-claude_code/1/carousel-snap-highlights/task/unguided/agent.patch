+  <script>
+    (function () {
+      document.querySelectorAll('.carousel').forEach(function (carousel) {
+        var items = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-item'));
+        if (!items.length) return;
+
+        function setSnapped(target) {
+          items.forEach(function (item) {
+            var snapped = item === target;
+            item.classList.toggle('is-snapped', snapped);
+            if (snapped) item.setAttribute('aria-current', 'true');
+            else item.removeAttribute('aria-current');
+          });
+        }
+
+        // Find the item whose center is closest to the carousel's center.
+        function updateFromPosition() {
+          var rect = carousel.getBoundingClientRect();
+          var center = rect.left + rect.width / 2;
+          var closest = null;
+          var best = Infinity;
+          items.forEach(function (item) {
+            var r = item.getBoundingClientRect();
+            var d = Math.abs(r.left + r.width / 2 - center);
+            if (d < best) { best = d; closest = item; }
+          });
+          setSnapped(closest);
+        }
+
+        if ('onscrollsnapchange' in window) {
+          carousel.addEventListener('scrollsnapchange', function (e) {
+            if (e.snapTargetInline && items.indexOf(e.snapTargetInline) !== -1) {
+              setSnapped(e.snapTargetInline);
+            } else {
+              updateFromPosition();
+            }
+          });
+        } else if ('onscrollend' in window) {
+          carousel.addEventListener('scrollend', updateFromPosition);
+        } else {
+          var timer;
+          carousel.addEventListener('scroll', function () {
+            clearTimeout(timer);
+            timer = setTimeout(updateFromPosition, 120);
+          }, { passive: true });
+        }
+
+        window.addEventListener('resize', updateFromPosition);
+        updateFromPosition();
+      });
+    })();
+  </script>
