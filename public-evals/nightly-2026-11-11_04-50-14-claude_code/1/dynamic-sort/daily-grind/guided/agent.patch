+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Animated reordering: each card gets a unique transition name from its identity */
+    #favorites .card {
+      view-transition-name: match-element;
+      view-transition-class: favorite-card;
+    }
+
+    ::view-transition-group(.favorite-card) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+    }
+
+    /* Only the cards move; skip the full-page cross-fade in the document-level fallback */
+    :root {
+      view-transition-name: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
