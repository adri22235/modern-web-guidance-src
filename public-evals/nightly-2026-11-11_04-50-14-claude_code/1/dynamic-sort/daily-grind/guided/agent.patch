+  <script>
+    (() => {
+      const grid = document.getElementById('favorites');
+      const select = document.getElementById('favorites-sort');
+      const status = document.getElementById('favorites-status');
+      const cards = Array.from(grid.children);
+      const featuredOrder = new Map(cards.map((card, i) => [card, i]));
+      const nameOf = (card) => card.querySelector('h3').textContent.trim();
+      const collator = new Intl.Collator(undefined, { sensitivity: 'base' });
+
+      const comparators = {
+        featured: (a, b) => featuredOrder.get(a) - featuredOrder.get(b),
+        'name-asc': (a, b) => collator.compare(nameOf(a), nameOf(b)),
+        'name-desc': (a, b) => collator.compare(nameOf(b), nameOf(a)),
+      };
+
+      const canMoveBefore = Object.hasOwn(Element.prototype, 'moveBefore');
+
+      // Move the existing nodes (never recreate them) so view transitions can match them.
+      function reorder(ordered) {
+        for (const card of ordered) {
+          if (canMoveBefore) grid.moveBefore(card, null);
+          else grid.append(card);
+        }
+      }
+
+      function reorderWithTransition(ordered) {
+        const update = () => reorder(ordered);
+        let transition;
+        // Prefer a transition scoped to the grid so the rest of the page stays interactive.
+        if (grid.startViewTransition) transition = grid.startViewTransition(update);
+        else if (document.startViewTransition) transition = document.startViewTransition(update);
+        else update();
+        // A rapid re-sort skips the in-flight transition; ignore that rejection.
+        transition?.ready.catch(() => {});
+      }
+
+      select.addEventListener('change', () => {
+        const ordered = Array.from(grid.children).sort(comparators[select.value]);
+        reorderWithTransition(ordered);
+        const label = select.selectedOptions[0].textContent;
+        status.textContent = `Seasonal favorites sorted by ${label}, ${ordered.length} items`;
+      });
+    })();
+  </script>
+
