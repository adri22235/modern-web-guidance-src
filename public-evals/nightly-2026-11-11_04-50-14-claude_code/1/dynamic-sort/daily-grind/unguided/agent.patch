+  <script>
+    (function () {
+      var grid = document.getElementById('seasonal-grid');
+      var select = document.getElementById('seasonal-sort');
+      if (!grid || !select) return;
+
+      var cards = Array.prototype.slice.call(grid.querySelectorAll('.card'));
+      // Remember the original ("featured") order.
+      cards.forEach(function (card, i) { card.dataset.featuredIndex = i; });
+
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var collator = new Intl.Collator(undefined, { sensitivity: 'base' });
+      function nameOf(card) {
+        var h = card.querySelector('h3');
+        return h ? h.textContent.trim() : '';
+      }
+
+      var comparators = {
+        'featured': function (a, b) { return a.dataset.featuredIndex - b.dataset.featuredIndex; },
+        'name-asc': function (a, b) { return collator.compare(nameOf(a), nameOf(b)); },
+        'name-desc': function (a, b) { return collator.compare(nameOf(b), nameOf(a)); }
+      };
+
+      function sortCards(key) {
+        var compare = comparators[key] || comparators.featured;
+        var animate = !reduceMotion.matches && typeof Element.prototype.animate === 'function';
+
+        // FIRST: capture current on-screen positions (including any in-flight animation).
+        var first = new Map();
+        cards.forEach(function (card) { first.set(card, card.getBoundingClientRect()); });
+
+        // Stop any running animations so the new layout can be measured cleanly.
+        cards.forEach(function (card) {
+          if (card._sortAnim) { card._sortAnim.cancel(); card._sortAnim = null; }
+        });
+
+        // Reorder the DOM.
+        var sorted = cards.slice().sort(compare);
+        sorted.forEach(function (card) { grid.appendChild(card); });
+
+        if (!animate) return;
+
+        // LAST + INVERT + PLAY
+        sorted.forEach(function (card, i) {
+          var from = first.get(card);
+          var to = card.getBoundingClientRect();
+          var dx = from.left - to.left;
+          var dy = from.top - to.top;
+          if (!dx && !dy) return;
+          card._sortAnim = card.animate(
+            [
+              { transform: 'translate(' + dx + 'px, ' + dy + 'px)' },
+              { transform: 'translate(0, 0)' }
+            ],
+            { duration: 450, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)', delay: i * 30, fill: 'backwards' }
+          );
+          card._sortAnim.onfinish = function () { card._sortAnim = null; };
+        });
+      }
+
+      select.addEventListener('change', function () { sortCards(select.value); });
+    })();
+  </script>
