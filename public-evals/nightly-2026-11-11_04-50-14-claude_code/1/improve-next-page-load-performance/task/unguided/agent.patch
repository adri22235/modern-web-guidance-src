+
+  <!--
+    Link prefetching via the Speculation Rules API (Chromium-based browsers).
+    Same-origin links are prefetched when the user signals intent (hover /
+    pointerdown), so the next page loads faster. Links that trigger state
+    changes (e.g. logout) are excluded, as are links explicitly opted out
+    with data-no-prefetch or rel="nofollow".
+  -->
+  <script type="speculationrules">
+  {
+    "prefetch": [
+      {
+        "source": "document",
+        "where": {
+          "and": [
+            { "href_matches": "/*" },
+            { "not": { "href_matches": "/logout" } },
+            { "not": { "href_matches": "/logout/*" } },
+            { "not": { "href_matches": "/logout\\?*" } },
+            { "not": { "selector_matches": ".logout-link" } },
+            { "not": { "selector_matches": "[data-no-prefetch]" } },
+            { "not": { "selector_matches": "[rel~=nofollow]" } }
+          ]
+        },
+        "eagerness": "moderate"
+      }
+    ]
+  }
+  </script>
+
+  <!-- Fallback for browsers without Speculation Rules support: prefetch on hover/touch. -->
+  <script>
+    (function () {
+      if (HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules')) return;
+
+      var prefetched = new Set();
+      var EXCLUDED_PATH = /^\/logout(\/|$)/i;
+
+      function shouldPrefetch(a) {
+        if (!a || !a.href || a.hasAttribute('download')) return false;
+        if (a.target && a.target !== '_self') return false;
+        if (a.matches('.logout-link, [data-no-prefetch], [rel~="nofollow"]')) return false;
+        var url;
+        try { url = new URL(a.href, location.href); } catch (e) { return false; }
+        if (url.origin !== location.origin) return false;
+        if (url.protocol !== 'http:' && url.protocol !== 'https:') return false;
+        if (EXCLUDED_PATH.test(url.pathname)) return false;
+        if (url.pathname === location.pathname && url.search === location.search) return false;
+        return true;
+      }
+
+      function prefetch(event) {
+        var a = event.target.closest && event.target.closest('a[href]');
+        if (!shouldPrefetch(a)) return;
+        var url = new URL(a.href, location.href);
+        url.hash = '';
+        var key = url.href;
+        if (prefetched.has(key)) return;
+        var conn = navigator.connection;
+        if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ''))) return;
+        prefetched.add(key);
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = key;
+        document.head.appendChild(link);
+      }
+
+      document.addEventListener('mouseover', prefetch, { passive: true });
+      document.addEventListener('touchstart', prefetch, { passive: true });
+      document.addEventListener('focusin', prefetch, { passive: true });
+    })();
+  </script>
