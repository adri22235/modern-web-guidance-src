+  <script>
+    (() => {
+      'use strict';
+
+      // ---- Configuration (same-origin endpoints; adjust to match the backend) ----
+      const ENDPOINTS = {
+        cards: '/api/menu/seasonal-favorites',      // returns an HTML fragment of .card elements
+        menuEvents: '/api/menu/events',             // SSE stream; emits "menu-updated"
+        reviews: '/api/reviews?collection=seasonal', // JSON: [{ author, rating, body }]
+        promo: '/cms/promos/seasonal-favorites',    // first-party CMS HTML (may include a widget <script>)
+      };
+      // Only these origins may supply external promo widget scripts.
+      const PROMO_SCRIPT_ORIGINS = [location.origin, 'https://cms.dailygrind.coffee'];
+      const POLL_INTERVAL_MS = 120000;
+
+      // ---- Sanitizer configs ----
+      // Server-rendered card markup: structural/presentational elements only.
+      const CARD_POLICY = {
+        div: ['class'], h3: ['class'], p: ['class'], span: ['class'],
+        strong: [], em: [], br: [],
+        a: ['href', 'class', 'title'],
+        img: ['src', 'alt', 'width', 'height', 'loading', 'class'],
+      };
+      // Customer-submitted review bodies: minimal inline formatting, no links/images/attributes.
+      const REVIEW_POLICY = { p: [], br: [], strong: [], em: [], b: [], i: [], ul: [], ol: [], li: [] };
+
+      const toSanitizerConfig = (policy) => ({
+        elements: Object.entries(policy).map(([name, attributes]) => ({ name, attributes })),
+        attributes: [],
+        comments: false,
+        dataAttributes: false,
+      });
+
+      const hasNativeSetHTML = typeof Element.prototype.setHTML === 'function';
+      const DROP_WITH_CONTENT = new Set(['script', 'style', 'template', 'iframe', 'object', 'embed',
+        'noscript', 'svg', 'math', 'form', 'input', 'button', 'textarea', 'select', 'link', 'meta', 'base']);
+
+      function isSafeUrl(value) {
+        try {
+          const url = new URL(value, document.baseURI);
+          return url.protocol === 'https:' || url.protocol === 'http:';
+        } catch {
+          return false;
+        }
+      }
+
+      // Fallback allowlist sanitizer: parses inertly (DOMParser never runs scripts) and
+      // rebuilds only allowed elements/attributes into a fresh fragment.
+      function sanitizeToFragment(html, policy) {
+        const doc = new DOMParser().parseFromString(`<body>${html}`, 'text/html');
+        const out = document.createDocumentFragment();
+        const copy = (src, dest) => {
+          for (const node of src.childNodes) {
+            if (node.nodeType === Node.TEXT_NODE) {
+              dest.append(node.data);
+            } else if (node.nodeType === Node.ELEMENT_NODE) {
+              const tag = node.localName;
+              if (DROP_WITH_CONTENT.has(tag)) continue;
+              if (!Object.hasOwn(policy, tag)) { copy(node, dest); continue; } // unwrap
+              const el = document.createElement(tag);
+              for (const attr of policy[tag]) {
+                const value = node.getAttribute(attr);
+                if (value === null) continue;
+                if ((attr === 'href' || attr === 'src') && !isSafeUrl(value)) continue;
+                el.setAttribute(attr, value);
+              }
+              if (tag === 'a' && el.hasAttribute('href') &&
+                  new URL(el.href).origin !== location.origin) {
+                el.rel = 'noopener noreferrer';
+              }
+              copy(node, el);
+              dest.append(el);
+            }
+          }
+        };
+        copy(doc.body, out);
+        return out;
+      }
+
+      // Safe HTML insertion: native Sanitizer API (Element.setHTML) when available,
+      // otherwise the allowlist fallback above. Never uses innerHTML.
+      function safeSetHTML(target, html, policy) {
+        if (hasNativeSetHTML) {
+          target.setHTML(html, { sanitizer: toSanitizerConfig(policy) });
+        } else {
+          target.replaceChildren(sanitizeToFragment(html, policy));
+        }
+      }
+
+      // ---- Streamed placeholders: <template for="id"> later in the document ----
+      // Browsers with native declarative partial updates consume these themselves;
+      // this fallback only touches templates that are still in the DOM once fully parsed.
+      function applyStreamedTemplate(template) {
+        const target = document.getElementById(template.getAttribute('for'));
+        if (!target) return;
+        target.replaceChildren(document.importNode(template.content, true));
+        template.remove();
+        target.removeAttribute('aria-busy');
+      }
+
+      function flushStreamedTemplates(finalPass) {
+        for (const t of document.querySelectorAll('template[for]')) {
+          // A template is fully parsed once the parser has moved past it.
+          if (finalPass || t.nextSibling) applyStreamedTemplate(t);
+        }
+      }
+
+      const streamObserver = new MutationObserver(() => flushStreamedTemplates(false));
+      streamObserver.observe(document.documentElement, { childList: true, subtree: true });
+
+      // ---- Live card refresh when the menu changes ----
+      let refreshController = null;
+
+      async function refreshCards() {
+        const grid = document.getElementById('seasonal-cards');
+        const status = document.getElementById('seasonal-status');
+        refreshController?.abort();
+        const controller = (refreshController = new AbortController());
+        grid.setAttribute('aria-busy', 'true');
+        try {
+          const res = await fetch(ENDPOINTS.cards, {
+            headers: { Accept: 'text/html' },
+            credentials: 'same-origin',
+            cache: 'no-store',
+            signal: controller.signal,
+          });
+          if (!res.ok) throw new Error(`HTTP ${res.status}`);
+          const html = await res.text();
+          if (controller.signal.aborted) return;
+          const update = () => safeSetHTML(grid, html, CARD_POLICY);
+          // View Transitions give a smooth in-place swap where supported.
+          if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
+            await document.startViewTransition(update).updateCallbackDone;
+          } else {
+            update();
+          }
+          status.textContent = 'Seasonal favorites updated.';
+        } catch (err) {
+          if (err.name !== 'AbortError') console.warn('[seasonal] refresh failed:', err);
+        } finally {
+          if (refreshController === controller) {
+            grid.removeAttribute('aria-busy');
+            refreshController = null;
+          }
+        }
+      }
+
+      function watchMenuChanges() {
+        let pollTimer = null;
+        const startPolling = () => {
+          if (pollTimer) return;
+          pollTimer = setInterval(() => {
+            if (document.visibilityState === 'visible') refreshCards();
+          }, POLL_INTERVAL_MS);
+        };
+
+        if ('EventSource' in window) {
+          const source = new EventSource(ENDPOINTS.menuEvents, { withCredentials: false });
+          source.addEventListener('menu-updated', refreshCards);
+          source.addEventListener('error', () => {
+            if (source.readyState === EventSource.CLOSED) startPolling();
+          });
+        } else {
+          startPolling();
+        }
+      }
+
+      // ---- Customer reviews (untrusted) ----
+      async function loadReviews() {
+        const container = document.getElementById('seasonal-reviews');
+        try {
+          const res = await fetch(ENDPOINTS.reviews, {
+            headers: { Accept: 'application/json' },
+            credentials: 'same-origin',
+          });
+          if (!res.ok) throw new Error(`HTTP ${res.status}`);
+          const reviews = await res.json();
+          const list = document.createDocumentFragment();
+          for (const review of Array.isArray(reviews) ? reviews.slice(0, 6) : []) {
+            const article = document.createElement('article');
+            article.className = 'review';
+
+            const meta = document.createElement('p');
+            meta.className = 'review__meta';
+            const rating = Math.max(0, Math.min(5, Math.round(Number(review.rating) || 0)));
+            const stars = document.createElement('span');
+            stars.className = 'review__rating';
+            stars.setAttribute('aria-label', `${rating} out of 5 stars`);
+            stars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
+            meta.append(stars, ` — ${String(review.author ?? 'Anonymous').slice(0, 80)}`);
+
+            const body = document.createElement('div');
+            body.className = 'review__body';
+            safeSetHTML(body, String(review.body ?? ''), REVIEW_POLICY);
+
+            article.append(meta, body);
+            list.append(article);
+          }
+          if (list.childNodes.length) {
+            container.replaceChildren(list);
+          } else {
+            container.textContent = 'No reviews yet — be the first!';
+          }
+        } catch (err) {
+          console.warn('[seasonal] reviews failed:', err);
+          container.textContent = 'Reviews are unavailable right now.';
+        } finally {
+          container.removeAttribute('aria-busy');
+        }
+      }
+
+      // ---- First-party CMS promo (trusted, with embedded widget script) ----
+      // Scripts inserted via parsing APIs never execute, so after inserting the
+      // markup we re-create each <script> (only inline or from allowlisted origins),
+      // in document order, waiting for external scripts so dependencies resolve.
+      async function loadPromo() {
+        const container = document.getElementById('seasonal-promo');
+        try {
+          const res = await fetch(ENDPOINTS.promo, {
+            headers: { Accept: 'text/html' },
+            credentials: 'same-origin',
+          });
+          if (!res.ok) throw new Error(`HTTP ${res.status}`);
+          // Guard against redirects to another origin and non-HTML responses.
+          if (new URL(res.url).origin !== location.origin) throw new Error('Unexpected promo origin');
+          if (!(res.headers.get('Content-Type') || '').includes('text/html')) {
+            throw new Error('Unexpected promo content type');
+          }
+
+          const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
+          const fragment = document.importNode(doc.body, true);
+          const inertScripts = [...fragment.querySelectorAll('script')];
+          container.replaceChildren(...fragment.childNodes);
+
+          for (const inert of inertScripts) {
+            const src = inert.getAttribute('src');
+            if (src !== null) {
+              let url;
+              try { url = new URL(src, document.baseURI); } catch { url = null; }
+              if (!url || !PROMO_SCRIPT_ORIGINS.includes(url.origin)) {
+                console.warn('[seasonal] blocked promo script from', src);
+                inert.remove();
+                continue;
+              }
+            }
+            const live = document.createElement('script');
+            for (const { name, value } of inert.attributes) live.setAttribute(name, value);
+            live.textContent = inert.textContent;
+            // Preserve execution order for external scripts unless marked async.
+            const loaded = src !== null && !inert.hasAttribute('async')
+              ? new Promise((resolve) => { live.onload = live.onerror = resolve; })
+              : null;
+            inert.replaceWith(live);
+            if (loaded) await loaded;
+          }
+        } catch (err) {
+          console.warn('[seasonal] promo failed:', err);
+          container.replaceChildren();
+        } finally {
+          container.removeAttribute('aria-busy');
+        }
+      }
+
+      document.addEventListener('DOMContentLoaded', () => {
+        flushStreamedTemplates(true);
+        streamObserver.disconnect();
+        const grid = document.getElementById('seasonal-cards');
+        if (!grid.querySelector('.card--placeholder')) grid.removeAttribute('aria-busy');
+
+        watchMenuChanges();
+        loadReviews();
+        loadPromo();
+      });
+    })();
+  </script>
 </head>
 
