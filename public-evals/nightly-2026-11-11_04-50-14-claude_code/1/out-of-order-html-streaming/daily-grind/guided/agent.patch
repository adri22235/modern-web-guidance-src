+  <script type="module">
+    // ---- Feature detection & conditional polyfills (loaded only when needed) ----
+    const POLYFILL_CDN = 'https://esm.sh';
+    const hasStreamingSetters = 'streamHTML' in Element.prototype && 'streamHTMLUnsafe' in Element.prototype;
+    const hasSanitizer = 'setHTML' in Element.prototype && 'Sanitizer' in window;
+
+    // Natively supported <template for> elements are consumed by the parser, so any
+    // still in the DOM at this point means the browser needs the polyfill.
+    if (document.querySelector('template[for]')) {
+      await import(`${POLYFILL_CDN}/template-for-polyfill`);
+    }
+    if (!hasStreamingSetters) {
+      await import(`${POLYFILL_CDN}/html-setters-polyfill`);
+    }
+
+    const grid = document.getElementById('seasonal-grid');
+    const gridStatus = document.getElementById('seasonal-status');
+    const promo = document.getElementById('promo');
+    const reviewList = document.getElementById('review-list');
+    const reviewsStatus = document.getElementById('reviews-status');
+    const seasonalTitle = document.getElementById('seasonal-title');
+
+    // Initial declarative patch has completed by the time this deferred module runs.
+    grid.setAttribute('aria-busy', 'false');
+    gridStatus.textContent = '';
+
+    // Pipe a fetch response body into a writable produced by one of the stream setters.
+    async function streamInto(url, makeWritable, signal) {
+      const res = await fetch(url, { headers: { Accept: 'text/html' }, signal });
+      if (!res.ok || !res.body) throw new Error(`${url}: ${res.status}`);
+      await res.body.pipeThrough(new TextDecoderStream()).pipeTo(makeWritable());
+    }
+
+    // Seasonal cards: first-party menu HTML, no scripts needed -> safe streamHTML().
+    async function refreshCards(signal) {
+      const hadFocus = grid.contains(document.activeElement);
+      grid.setAttribute('aria-busy', 'true');
+      gridStatus.textContent = 'Updating seasonal favorites…';
+      try {
+        await streamInto('/api/menu/seasonal-cards', () => grid.streamHTML(), signal);
+        gridStatus.textContent = 'Seasonal favorites updated.';
+      } catch (err) {
+        if (err.name !== 'AbortError') gridStatus.textContent = 'Could not refresh seasonal favorites.';
+        throw err;
+      } finally {
+        grid.setAttribute('aria-busy', 'false');
+        // Don't strand keyboard users if the focused card was replaced.
+        if (hadFocus && !grid.contains(document.activeElement)) seasonalTitle.focus();
+      }
+    }
+
+    // Promo: trusted first-party CMS block whose embedded widget script must execute.
+    function refreshPromo(signal) {
+      return streamInto('/api/cms/promo', () => promo.streamHTMLUnsafe({ runScripts: true }), signal);
+    }
+
+    // Reviews: UNTRUSTED customer content -> sanitize with a strict allowlist.
+    // Scripts, event handlers, styles, links, images, etc. are all stripped.
+    const REVIEW_ELEMENTS = ['li', 'p', 'blockquote', 'cite', 'strong', 'em', 'b', 'i', 'br'];
+    const REVIEW_ATTRIBUTES = ['class'];
+    let domPurifyPromise;
+
+    async function safeSetHTML(el, html) {
+      if (hasSanitizer) {
+        el.setHTML(html, { sanitizer: { elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES } });
+        return;
+      }
+      domPurifyPromise ??= import(`${POLYFILL_CDN}/dompurify@3`).then((m) => m.default ?? m);
+      const DOMPurify = await domPurifyPromise;
+      el.innerHTML = DOMPurify.sanitize(html, {
+        ALLOWED_TAGS: [...REVIEW_ELEMENTS, '#text'],
+        ALLOWED_ATTR: REVIEW_ATTRIBUTES,
+        ALLOW_ARIA_ATTR: false,
+        ALLOW_DATA_ATTR: false,
+        KEEP_CONTENT: false,
+      });
+    }
+
+    async function refreshReviews(signal) {
+      reviewList.setAttribute('aria-busy', 'true');
+      try {
+        const res = await fetch('/api/reviews?section=seasonal', { headers: { Accept: 'text/html' }, signal });
+        if (!res.ok) throw new Error(`/api/reviews: ${res.status}`);
+        await safeSetHTML(reviewList, await res.text());
+        reviewsStatus.textContent = '';
+      } catch (err) {
+        if (err.name !== 'AbortError') reviewsStatus.textContent = 'Reviews are unavailable right now.';
+        throw err;
+      } finally {
+        reviewList.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    // ---- Refresh everything whenever the menu changes ----
+    let inFlight;
+    function refreshAll() {
+      inFlight?.abort();
+      inFlight = new AbortController();
+      const { signal } = inFlight;
+      return Promise.allSettled([refreshCards(signal), refreshReviews(signal), refreshPromo(signal)]).then((results) => {
+        for (const r of results) {
+          if (r.status === 'rejected' && r.reason?.name !== 'AbortError') console.error(r.reason);
+        }
+      });
+    }
+
+    // Cards and promo arrived declaratively; reviews are always loaded client-side.
+    refreshReviews().catch(console.error);
+
+    // Server-Sent Events: the server emits `menu-updated` when the menu changes.
+    if ('EventSource' in window) {
+      const events = new EventSource('/api/menu/events');
+      events.addEventListener('menu-updated', () => refreshAll());
+    }
+  </script>
