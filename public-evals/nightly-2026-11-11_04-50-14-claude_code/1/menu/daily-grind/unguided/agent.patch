+      // ---------------------------------------------------------------------
+      // Card state
+      // ---------------------------------------------------------------------
+      function readOrder(card) {
+        const drink = DRINKS[card.dataset.drink];
+        const wrap = card.querySelector('.menu-wrap');
+        const pick = (group) =>
+          wrap.querySelector(`[role="menuitemradio"][data-group="${group}"][aria-checked="true"]`);
+        const choices = { size: pick('size'), temp: pick('temp'), milk: pick('milk'), syrup: pick('syrup') };
+        const extras = [...wrap.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]')];
+        const price = [...Object.values(choices), ...extras]
+          .reduce((sum, i) => sum + Number(i?.dataset.price || 0), drink.base);
+
+        const parts = [choices.size?.dataset.label, choices.temp?.dataset.label];
+        if (choices.milk && choices.milk.dataset.value !== 'none') parts.push(`${choices.milk.dataset.label} milk`);
+        if (choices.syrup && choices.syrup.dataset.value !== 'none') parts.push(`${choices.syrup.dataset.label} syrup`);
+        extras.forEach((x) => parts.push(x.dataset.label.toLowerCase()));
+
+        return { drink, wrap, choices, price, summary: parts.filter(Boolean).join(' · ') };
+      }
+
+      function updateCard(card) {
+        const order = readOrder(card);
+        card.querySelector('[data-summary]').textContent = order.summary;
+        card.querySelector('[data-price]').textContent = money(order.price);
+        order.wrap.querySelectorAll('[data-summary-for]').forEach((meta) => {
+          const key = meta.dataset.summaryFor;
+          meta.textContent = key === 'price' ? money(order.price) : order.choices[key]?.dataset.label || '';
+        });
+      }
+
+      function resetCard(card) {
+        card.querySelectorAll('.menu-wrap [aria-checked]').forEach((i) => {
+          i.setAttribute('aria-checked', i.dataset.default);
+        });
+        updateCard(card);
+      }
+
+      let toastTimer;
+      function toast(message) {
+        const t = document.getElementById('toast');
+        t.textContent = message;
+        t.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
+      }
+
+      // ---------------------------------------------------------------------
+      // Wire up
+      // ---------------------------------------------------------------------
+      const nav = document.querySelector('nav');
+      const menubar = document.getElementById('main-menubar');
+      const navToggle = document.querySelector('.nav-toggle');
+      const navController = new MenuController(menubar);
+
+      const mobile = window.matchMedia('(max-width: 768px)');
+      const syncOrientation = () => {
+        menubar.setAttribute('aria-orientation', mobile.matches ? 'vertical' : 'horizontal');
+        if (!mobile.matches) {
+          nav.classList.remove('nav-open');
+          navToggle.setAttribute('aria-expanded', 'false');
+        }
+      };
+      mobile.addEventListener('change', syncOrientation);
+      syncOrientation();
+
+      navToggle.addEventListener('click', () => {
+        const open = !nav.classList.contains('nav-open');
+        nav.classList.toggle('nav-open', open);
+        navToggle.setAttribute('aria-expanded', String(open));
+        if (open) navController.focus(navController.items(menubar)[0]);
+        else navController.closeAll();
+      });
+
+      menubar.addEventListener('menu-change', (e) => {
+        const { item } = e.detail;
+        if (item.getAttribute('role') === 'menuitemcheckbox') {
+          const on = item.getAttribute('aria-checked') === 'true';
+          toast(`${item.dataset.label}: ${on ? 'on' : 'off'}`);
+        } else {
+          toast(`Default pickup store set to ${item.dataset.label}`);
+        }
+      });
+
+      let bagCount = 0;
+      document.querySelectorAll('.card[data-drink]').forEach((card) => {
+        const drink = DRINKS[card.dataset.drink];
+        const wrap = card.querySelector('.menu-wrap');
+        const button = wrap.querySelector('.menu-button');
+        wrap.append(buildMenu(customizationSpec(drink), `Customize ${drink.name}`, button.getAttribute('aria-controls')));
+        new MenuController(wrap);
+        updateCard(card);
+
+        wrap.addEventListener('menu-change', () => updateCard(card));
+        wrap.addEventListener('menu-action', (e) => {
+          if (e.detail.action === 'reset') {
+            resetCard(card);
+            toast(`${drink.name} reset to default`);
+          } else if (e.detail.action === 'add') {
+            const order = readOrder(card);
+            bagCount += 1;
+            document.getElementById('bag-count').textContent = bagCount;
+            toast(`Added ${drink.name} (${order.summary}) — ${money(order.price)}`);
+          }
+        });
+      });
+    })();
+  </script>
+
 </body>
 
