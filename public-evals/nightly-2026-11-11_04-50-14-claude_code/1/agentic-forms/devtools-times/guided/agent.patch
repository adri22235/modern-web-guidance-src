+}
+/* WebMCP: highlight forms/buttons while an AI agent is using them.
+   Kept in separate rules so unsupported pseudo-classes don't invalidate other styles. */
+form:tool-form-active {
+  outline: 2px dashed var(--color-amber-400);
+  outline-offset: 4px;
+}
+
+button:tool-submit-active {
+  outline: 2px dashed var(--color-amber-500);
+  outline-offset: 2px;
+  animation: tool-submit-pulse 1.5s ease-in-out infinite;
+}
+
+@keyframes tool-submit-pulse {
+  50% { outline-color: transparent; }
+}
