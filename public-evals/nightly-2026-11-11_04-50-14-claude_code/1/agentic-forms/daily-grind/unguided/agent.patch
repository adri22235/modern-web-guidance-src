+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const summaryLines = document.getElementById('summary-lines');
+      const totalEl = document.getElementById('order-total');
+      const errorEl = document.getElementById('order-error');
+      const confirmationEl = document.getElementById('order-confirmation');
+
+      const money = (n) => '$' + n.toFixed(2);
+      const priceOf = (el) => parseFloat(el?.dataset.price || '0');
+      const labelOf = (select) => select.options[select.selectedIndex]?.text.split(' — ')[0].replace(/\s*\(.*\)$/, '') || '';
+
+      function readOrder() {
+        const drinkSel = form.drink;
+        const milkSel = form.milk;
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const extras = [...form.querySelectorAll('input[name="extras"]:checked')];
+        const quantity = parseInt(form.quantity.value, 10);
+        const unit = Math.max(0,
+          priceOf(drinkSel.options[drinkSel.selectedIndex]) +
+          priceOf(milkSel.options[milkSel.selectedIndex]) +
+          priceOf(sizeInput) +
+          extras.reduce((sum, el) => sum + priceOf(el), 0));
+        const qty = Number.isFinite(quantity) ? quantity : 0;
+        return {
+          drink: drinkSel.value,
+          drinkLabel: labelOf(drinkSel),
+          size: sizeInput ? sizeInput.value : null,
+          milk: milkSel.value,
+          milkLabel: labelOf(milkSel),
+          extras: extras.map((el) => el.value),
+          quantity: qty,
+          location: form.location.value,
+          locationLabel: form.location.options[form.location.selectedIndex].text,
+          pickupTime: form.pickup_time.value || 'ASAP',
+          customerName: form.customer_name.value.trim(),
+          notes: form.notes.value.trim(),
+          unitPrice: Math.round(unit * 100) / 100,
+          total: Math.round(unit * qty * 100) / 100,
+        };
+      }
+
+      function validate(order) {
+        if (!order.size) return 'Please choose a size.';
+        if (!Number.isInteger(order.quantity) || order.quantity < 1 || order.quantity > 10)
+          return 'Quantity must be between 1 and 10.';
+        if (!order.customerName) return 'Please enter a name for the order.';
+        if (order.pickupTime !== 'ASAP' && (order.pickupTime < '06:00' || order.pickupTime > '20:00'))
+          return 'Pickup time must be between 06:00 and 20:00.';
+        return '';
+      }
+
+      function render() {
+        const o = readOrder();
+        const lines = [
+          `${o.quantity || 0} × ${o.size ? o.size[0].toUpperCase() + o.size.slice(1) : ''} ${o.drinkLabel}`,
+          `Milk: ${o.milkLabel}`,
+          o.extras.length ? `Extras: ${o.extras.join(', ')}` : null,
+          `Pickup: ${o.locationLabel.split(' — ')[0]} @ ${o.pickupTime}`,
+        ].filter(Boolean);
+        summaryLines.replaceChildren(...lines.map((t) => {
+          const li = document.createElement('li');
+          li.textContent = t;
+          return li;
+        }));
+        totalEl.textContent = money(o.total);
+      }
+
+      form.addEventListener('input', render);
+      form.addEventListener('change', render);
+      form.addEventListener('reset', () => setTimeout(render));
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const order = readOrder();
+        const error = validate(order);
+        errorEl.textContent = error;
+
+        let result;
+        if (error) {
+          confirmationEl.classList.remove('visible');
+          result = { success: false, error };
+        } else {
+          const orderNumber = 'DG-' + Math.random().toString(36).slice(2, 8).toUpperCase();
+          confirmationEl.textContent =
+            `Thanks, ${order.customerName}! Order ${orderNumber} is confirmed: ` +
+            `${order.quantity} × ${order.size} ${order.drinkLabel} for pickup at ` +
+            `${order.locationLabel} (${order.pickupTime}). Total ${money(order.total)}.`;
+          confirmationEl.classList.add('visible');
+          result = {
+            success: true,
+            orderNumber,
+            drink: order.drink,
+            size: order.size,
+            milk: order.milk,
+            extras: order.extras,
+            quantity: order.quantity,
+            location: order.location,
+            pickupTime: order.pickupTime,
+            customerName: order.customerName,
+            notes: order.notes,
+            unitPrice: order.unitPrice,
+            total: order.total,
+            currency: 'USD',
+          };
+        }
+
+        // WebMCP declarative tool: return a structured result to the invoking agent.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+
+      // Bring the form into view when an agent starts using the tool.
+      window.addEventListener('toolactivated', (e) => {
+        if (e.toolName === 'place_coffee_order') {
+          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        }
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
