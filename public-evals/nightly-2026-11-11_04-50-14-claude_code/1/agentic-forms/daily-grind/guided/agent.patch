+
+  <script>
+    (() => {
+      const form = document.getElementById('quick-order-form');
+      const totalOut = document.getElementById('order-total');
+      const statusEl = document.getElementById('order-status');
+      const submitBtn = form.querySelector('button[type="submit"]');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      const LOCATIONS = {
+        downtown: 'Downtown — 120 Main St',
+        riverside: 'Riverside — 45 Water Ave',
+        university: 'University District — 9 College Rd',
+        airport: 'Airport Terminal B',
+      };
+
+      const unitPrice = () => {
+        const drink = form.drink.selectedOptions[0];
+        if (!drink?.value) return 0;
+        const size = form.querySelector('input[name="size"]:checked');
+        const shot = form.extra_shot.checked ? Number(form.extra_shot.dataset.price) : 0;
+        return Number(drink.dataset.price) + Number(size?.dataset.price ?? 0) + shot;
+      };
+
+      const orderTotal = () => {
+        const qty = Math.min(10, Math.max(1, Math.trunc(Number(form.quantity.value)) || 1));
+        return unitPrice() * qty;
+      };
+
+      const updateTotal = () => { totalOut.value = money.format(orderTotal()); };
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      updateTotal();
+
+      // Keep aria-invalid and the error message link in sync with :user-invalid.
+      const linkError = (el, shown) => {
+        const errorId = el.dataset.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+      const syncAria = (el) => {
+        if (!el.matches?.('input, select, textarea')) return;
+        const invalid = el.matches(':user-invalid');
+        el.setAttribute('aria-invalid', String(invalid));
+        linkError(el, invalid);
+      };
+      [...form.elements].forEach(syncAria);
+      form.addEventListener('blur', (e) => syncAria(e.target), true);
+      form.addEventListener('change', (e) => syncAria(e.target), true);
+      form.addEventListener('input', (e) => { if (e.target.getAttribute('aria-invalid') === 'true') syncAria(e.target); });
+      form.addEventListener('invalid', (e) => syncAria(e.target), true);
+
+      // Stand-in for the real order API; resolves with a confirmation.
+      const submitOrder = async (data) => {
+        await new Promise((r) => setTimeout(r, 600));
+        const minutes = data.pickup_time === 'asap' ? 5 : Number(data.pickup_time);
+        const ready = new Date(Date.now() + minutes * 60_000);
+        return {
+          orderNumber: 'DG-' + Math.floor(1000 + Math.random() * 9000),
+          readyAt: ready.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }),
+          total: money.format(orderTotal()),
+        };
+      };
+
+      const describe = (d) => {
+        const drink = form.drink.selectedOptions[0].textContent.split(' — ')[0];
+        const extras = [d.iced && 'iced', d.extra_shot && 'extra shot', d.milk !== 'none' && `${d.milk} milk`].filter(Boolean);
+        return `${d.quantity} × ${d.size} ${drink}${extras.length ? ` (${extras.join(', ')})` : ''}`;
+      };
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        if (!form.checkValidity()) {
+          const invalid = [...form.elements].filter((el) => el.willValidate && !el.validity.valid);
+          if (event.agentInvoked) {
+            const msg = 'Order not placed. Fix these fields: ' + invalid
+              .map((el) => `${el.name} (${document.getElementById(el.dataset.error)?.textContent.replace('⚠', '').trim() || el.validationMessage})`)
+              .join(', ');
+            event.respondWith(Promise.resolve(msg));
+          }
+          form.reportValidity();
+          invalid[0]?.focus();
+          return;
+        }
+
+        const data = Object.fromEntries(new FormData(form));
+        const summary = describe(data);
+        submitBtn.disabled = true;
+        statusEl.textContent = 'Placing your order…';
+
+        const result = submitOrder(data).then((r) => {
+          const message = `Order ${r.orderNumber} confirmed for ${data.customer_name}: ${summary}. ` +
+            `Ready around ${r.readyAt} at ${LOCATIONS[data.location]}. Total ${r.total}, pay at pickup.`;
+          statusEl.textContent = message;
+          form.reset();
+          [...form.elements].forEach((el) => { el.setAttribute?.('aria-invalid', 'false'); linkError(el, false); });
+          updateTotal();
+          return message;
+        }).catch(() => {
+          const message = 'Sorry, we could not place your order. Please try again.';
+          statusEl.textContent = message;
+          return message;
+        }).finally(() => { submitBtn.disabled = false; });
+
+        if (event.agentInvoked) event.respondWith(result);
+      });
+    })();
+  </script>
 </body>
 
 </html>
