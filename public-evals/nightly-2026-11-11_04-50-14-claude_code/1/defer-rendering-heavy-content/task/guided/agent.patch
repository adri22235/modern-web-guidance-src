+    /* Cards below the initial viewport: skip layout/paint until scrolled near.
+       Only applied to cards that start outside the first viewport (see JS). */
+    .off-screen-card {
+      content-visibility: auto;
+      /* Placeholder height (~rendered card height); `auto` remembers the real
+         size once rendered to avoid scrollbar jumps. */
+      contain-intrinsic-size: auto none auto 400px;
