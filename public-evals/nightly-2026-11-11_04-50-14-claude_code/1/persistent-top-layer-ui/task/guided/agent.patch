+  <script type="module">
+    // Invoker Commands polyfill, loaded only where native support is missing.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.sh/invokers-polyfill@0.5');
+    }
+
+    const dialog = document.getElementById('feedback-dialog');
+    const form = document.getElementById('feedback-form');
+    const moveBtn = document.getElementById('feedback-move');
+    const locationLabel = document.getElementById('feedback-location');
+    const status = document.getElementById('feedback-status');
+    const thanks = document.getElementById('feedback-thanks');
+
+    // Page sections the dialog can be relocated between, in cycle order.
+    const sections = ['section-hero', 'section-favorites', 'section-footer']
+      .map((id) => document.getElementById(id));
+
+    const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+    function relocate(node, newParent) {
+      if (supportsMoveBefore) {
+        // Atomic move: the modal stays open, in the top layer, with focus intact.
+        newParent.moveBefore(node, null);
+        return;
+      }
+      // Fallback: a traditional move removes the dialog, which closes it.
+      // Restore the open state and focus manually.
+      const wasOpen = node.open;
+      const focused = document.activeElement;
+      newParent.insertBefore(node, null);
+      if (wasOpen && !node.open) {
+        node.showModal();
+        if (focused && node.contains(focused)) focused.focus();
+      }
+    }
+
+    moveBtn.addEventListener('click', () => {
+      const current = sections.findIndex((section) => section.contains(dialog));
+      const next = sections[(current + 1) % sections.length];
+      relocate(dialog, next);
+
+      const name = next.dataset.sectionName;
+      locationLabel.textContent = name;
+      status.textContent = `Feedback form moved to the ${name} section.`;
+    });
+
+    dialog.addEventListener('close', () => {
+      // A fallback move fires a close event even though we reopened it.
+      if (dialog.open) return;
+
+      if (dialog.returnValue === 'submit') {
+        const data = new FormData(form);
+        thanks.textContent = `Thanks for your feedback${data.get('rating') ? ` (rated ${data.get('rating')})` : ''}!`;
+        form.reset();
+      }
+      dialog.returnValue = '';
+      status.textContent = '';
+    });
+  </script>
