+  <button type="button" class="btn feedback-trigger" id="feedback-open" aria-haspopup="dialog">Give Feedback</button>
+
+  <dialog class="feedback-modal" id="feedback-modal" aria-labelledby="feedback-title">
+    <header>
+      <h2 id="feedback-title">Share Your Feedback</h2>
+      <button type="button" class="icon-btn" data-close aria-label="Close feedback">&times;</button>
+    </header>
+    <form id="feedback-form" method="dialog">
+      <p class="location" aria-live="polite">Attached to section: <strong id="feedback-location">—</strong></p>
+      <div>
+        <label for="feedback-rating">How was your visit?</label>
+        <select id="feedback-rating" name="rating" required>
+          <option value="">Choose a rating…</option>
+          <option value="5">★★★★★ Fantastic</option>
+          <option value="4">★★★★ Great</option>
+          <option value="3">★★★ Okay</option>
+          <option value="2">★★ Meh</option>
+          <option value="1">★ Not good</option>
+        </select>
+      </div>
+      <div>
+        <label for="feedback-message">Tell us more</label>
+        <textarea id="feedback-message" name="message" placeholder="What did you love? What could be better?"></textarea>
+      </div>
+      <div>
+        <label for="feedback-email">Email (optional)</label>
+        <input type="email" id="feedback-email" name="email" placeholder="you@example.com">
+      </div>
+      <p class="thanks" id="feedback-thanks" hidden>Thanks! Your feedback has been received.</p>
+      <div class="actions">
+        <button type="button" class="btn btn-secondary" id="feedback-move" title="Move this modal to the next page section">Move</button>
+        <span>
+          <button type="button" class="btn btn-secondary" data-close>Cancel</button>
+          <button type="submit" class="btn">Send</button>
+        </span>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-modal');
+      const openBtn = document.getElementById('feedback-open');
+      const moveBtn = document.getElementById('feedback-move');
+      const form = document.getElementById('feedback-form');
+      const locationLabel = document.getElementById('feedback-location');
+      const thanks = document.getElementById('feedback-thanks');
+      const sections = Array.from(document.querySelectorAll('[data-section-name]'));
+      let hostIndex = -1;
+
+      function setHost(index) {
+        sections.forEach((s) => s.classList.remove('modal-host'));
+        hostIndex = index;
+        const host = sections[index];
+        if (dialog.open) host.classList.add('modal-host');
+        locationLabel.textContent = host.dataset.sectionName;
+      }
+
+      // Reparent `node` into `parent` while preserving as much live state as possible.
+      function reparent(node, parent) {
+        // Snapshot state that a plain remove/insert would lose.
+        const wasOpen = dialog.open;
+        const wasModal = wasOpen && dialog.matches(':modal');
+        const active = dialog.contains(document.activeElement) ? document.activeElement : null;
+        const selection = active && typeof active.selectionStart === 'number'
+          ? [active.selectionStart, active.selectionEnd, active.selectionDirection]
+          : null;
+        const scrolls = Array.from(dialog.querySelectorAll('textarea'), (el) => [el, el.scrollTop]);
+
+        if (typeof parent.moveBefore === 'function') {
+          // Atomic, state-preserving move (keeps the dialog in the top layer, focus, etc.).
+          try {
+            parent.moveBefore(node, null);
+          } catch (e) {
+            parent.appendChild(node);
+          }
+        } else {
+          parent.appendChild(node);
+        }
+
+        // Fallback: a classic remove/insert closes the dialog; reopen it in the same mode.
+        if (wasOpen && (!dialog.open || (wasModal && !dialog.matches(':modal')))) {
+          if (dialog.open) dialog.close();
+          wasModal ? dialog.showModal() : dialog.show();
+        }
+
+        scrolls.forEach(([el, top]) => { el.scrollTop = top; });
+        if (active && document.activeElement !== active) {
+          active.focus({ preventScroll: true });
+          if (selection) {
+            try { active.setSelectionRange(...selection); } catch (e) { /* not a text input */ }
+          }
+        }
+      }
+
+      function moveToNextSection() {
+        const next = (hostIndex + 1) % sections.length;
+        reparent(dialog, sections[next]);
+        setHost(next);
+      }
+
+      function openModal() {
+        if (hostIndex === -1) {
+          reparent(dialog, sections[0]);
+          setHost(0);
+        }
+        thanks.hidden = true;
+        dialog.showModal();
+        sections[hostIndex].classList.add('modal-host');
+      }
+
+      openBtn.addEventListener('click', openModal);
+      moveBtn.addEventListener('click', moveToNextSection);
+      dialog.querySelectorAll('[data-close]').forEach((btn) =>
+        btn.addEventListener('click', () => dialog.close('cancel'))
+      );
+
+      // Close on backdrop click.
+      dialog.addEventListener('click', (e) => {
+        if (e.target === dialog) dialog.close('cancel');
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        thanks.hidden = false;
+        form.reset();
+        setTimeout(() => { if (dialog.open) dialog.close('submitted'); }, 1200);
+      });
+
+      dialog.addEventListener('close', () => {
+        // The legacy reparent fallback fires a queued `close` even though we reopened
+        // the dialog immediately; ignore it if the dialog is still open.
+        if (dialog.open) return;
+        sections.forEach((s) => s.classList.remove('modal-host'));
+        openBtn.focus();
+      });
+    })();
+  </script>
+
 </body>
 
