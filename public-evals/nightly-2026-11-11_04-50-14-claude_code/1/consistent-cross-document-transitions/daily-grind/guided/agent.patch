+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+
+  <!-- Critical header/layout styles: stylesheets in <head> are render-blocking,
+       so the new page is never snapshotted unstyled during a view transition. -->
+  <link rel="stylesheet" href="/css/styles.css">
+
+  <!-- Theme must be applied before the transition snapshot is taken. -->
+  <script src="/js/theme.js" async blocking="render"></script>
+
+  <!-- Hero background is above the fold; fetch it early so it is ready for the transition. -->
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+
+  <!-- Hold the first render (and the view transition) until the above-the-fold
+       content has been parsed. The footer is intentionally NOT awaited. -->
+  <link rel="expect" href="#menu-hero" blocking="render">
+  <link rel="expect" href="#menu-featured" blocking="render">
+
+  <!-- Prerender the main linked pages on hover/pointerdown so transitions start instantly. -->
+  <script type="speculationrules">
+    {
+      "prerender": [{
+        "where": { "href_matches": ["/", "/menu{/}?", "/locations{/}?"] },
+        "eagerness": "moderate"
+      }]
+    }
+  </script>
+</head>
+
+<body>
+
+  <nav class="site-nav" aria-label="Main">
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/" aria-current="page">Menu</a></li>
+      <li><a href="/locations/">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--compact hero--menu page-hero" id="menu-hero">
+    <h1>Our Menu</h1>
+    <p>Small-batch roasts and house-made syrups, pulled to order.</p>
+  </header>
+
+  <main class="container">
+    <section class="menu-category" id="menu-featured" aria-labelledby="espresso-heading">
+      <h2 id="espresso-heading" class="section-title">Espresso Bar</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <p class="price">$3.25</p>
+        </div>
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <p class="price">$5.50</p>
+        </div>
+        <div class="card">
+          <h3>Cortado</h3>
+          <p>Equal parts espresso and steamed whole milk.</p>
+          <p class="price">$4.25</p>
+        </div>
+      </div>
+    </section>
+
+    <section class="menu-category" aria-labelledby="cold-heading">
+      <h2 id="cold-heading" class="section-title">Cold Drinks</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <p class="price">$4.75</p>
+        </div>
+        <div class="card">
+          <h3>Nitro Cold Brew</h3>
+          <p>Velvety, nitrogen-infused, served on tap.</p>
+          <p class="price">$5.25</p>
+        </div>
+        <div class="card">
+          <h3>Iced Chai</h3>
+          <p>Spiced black tea with your choice of milk.</p>
+          <p class="price">$4.95</p>
+        </div>
+      </div>
+    </section>
+
+    <section class="menu-category" aria-labelledby="bakery-heading">
+      <h2 id="bakery-heading" class="section-title">Bakery</h2>
+      <div class="grid">
