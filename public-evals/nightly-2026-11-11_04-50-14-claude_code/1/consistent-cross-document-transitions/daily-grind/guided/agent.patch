diff --git a/js/theme.js b/js/theme.js
new file mode 100644
index 0000000..75ab017
--- /dev/null
+++ b/js/theme.js
@@ -0,0 +1,46 @@
+// Applies the saved (or system) theme before first render so cross-document
+// view transition snapshots never flash the wrong theme. Loaded with
+// `async blocking="render"`, so it doesn't block parsing but does block paint.
+(() => {
+  const root = document.documentElement;
+  const KEY = 'daily-grind-theme';
+
+  let stored = null;
+  try {
+    stored = localStorage.getItem(KEY);
+  } catch {
+    // Storage unavailable (e.g. privacy mode); fall back to system preference.
+  }
+
+  const theme =
+    stored === 'dark' || stored === 'light'
+      ? stored
+      : matchMedia('(prefers-color-scheme: dark)').matches
+        ? 'dark'
+        : 'light';
+  root.dataset.theme = theme;
+
+  const syncToggle = (button) => {
+    const dark = root.dataset.theme === 'dark';
+    button.setAttribute('aria-pressed', String(dark));
+  };
+
+  // Delegated so it works regardless of whether the button has been parsed yet.
+  document.addEventListener('click', (event) => {
+    const button = event.target.closest('.theme-toggle');
+    if (!button) return;
+    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
+    try {
+      localStorage.setItem(KEY, root.dataset.theme);
+    } catch {}
+    syncToggle(button);
+  });
+
+  // Async scripts may run before or after DOMContentLoaded; handle both.
+  const syncAll = () => document.querySelectorAll('.theme-toggle').forEach(syncToggle);
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', syncAll);
+  } else {
+    syncAll();
+  }
+})();
diff --git a/locations/index.html b/locations/index.html
new file mode 100644
index 0000000..2d63872
--- /dev/null
+++ b/locations/index.html
@@ -0,0 +1,89 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- Critical header/layout styles: stylesheets in <head> are render-blocking,
+       so the new page is never snapshotted unstyled during a view transition. -->
+  <link rel="stylesheet" href="/css/styles.css">
+
+  <!-- Theme must be applied before the transition snapshot is taken. -->
+  <script src="/js/theme.js" async blocking="render"></script>
+
+  <!-- Hero background is above the fold; fetch it early so it is ready for the transition. -->
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+
+  <!-- Hold the first render (and the view transition) until the above-the-fold
+       content has been parsed. The footer is intentionally NOT awaited. -->
+  <link rel="expect" href="#locations-hero" blocking="render">
+  <link rel="expect" href="#locations-list" blocking="render">
+
+  <!-- Prerender the main linked pages on hover/pointerdown so transitions start instantly. -->
+  <script type="speculationrules">
+    {
+      "prerender": [{
+        "where": { "href_matches": ["/", "/menu{/}?", "/locations{/}?"] },
+        "eagerness": "moderate"
+      }]
+    }
+  </script>
+</head>
+
+<body>
+
+  <nav class="site-nav" aria-label="Main">
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu/">Menu</a></li>
+      <li><a href="/locations/" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--compact hero--locations page-hero" id="locations-hero">
+    <h1>Find Your Grind</h1>
+    <p>Neighborhood cafés with fresh roasts and familiar faces.</p>
+  </header>
+
+  <main class="container">
+    <section id="locations-list" aria-labelledby="locations-heading">
+      <h2 id="locations-heading" class="section-title">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <p><address>120 Main Street<br>Burlington, VT 05401</address></p>
+          <p class="hours">Mon–Fri 6am–7pm · Sat–Sun 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <p><address>48 Mill Road<br>Winooski, VT 05404</address></p>
+          <p class="hours">Daily 6:30am–5pm</p>
+        </div>
+        <div class="card">
+          <h3>University Hill</h3>
+          <p><address>9 College Avenue<br>Burlington, VT 05405</address></p>
+          <p class="hours">Mon–Fri 7am–9pm · Sat–Sun 8am–8pm</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
