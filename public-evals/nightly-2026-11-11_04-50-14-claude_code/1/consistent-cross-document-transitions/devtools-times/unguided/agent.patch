diff --git a/src/scripts/page-transitions.ts b/src/scripts/page-transitions.ts
new file mode 100644
index 0000000..41aa955
--- /dev/null
+++ b/src/scripts/page-transitions.ts
@@ -0,0 +1,185 @@
+/**
+ * Page transition controller for Astro's <ClientRouter />.
+ *
+ * Goal: never animate into a half-finished page. Before the view transition
+ * swaps in the new document we:
+ *   1. wait for the brand web font to be available (no fallback-font flash),
+ *   2. preload + decode the images that make up the first screen of the new
+ *      page (hero / featured / first teasers), and mark them eager so they
+ *      paint from cache on the very first frame after the swap,
+ *   3. pair the clicked teaser image with the article hero so the image
+ *      morphs between pages (names assigned only to one pair => always unique).
+ *
+ * All waiting is bounded by a timeout so a slow image never blocks navigation.
+ * Astro's ClientRouter already waits for new stylesheets before swapping.
+ */
+import type {
+  TransitionBeforePreparationEvent,
+  TransitionBeforeSwapEvent,
+} from 'astro:transitions/client';
+
+const MORPH_NAME = 'article-image';
+/** Upper bound for how long we delay a navigation to get assets ready. */
+const READY_TIMEOUT_MS = 2500;
+/** Show the loading bar only if preparing takes longer than this. */
+const LOADING_INDICATOR_DELAY_MS = 150;
+/** Number of leading images in <main> treated as above-the-fold. */
+const LEADING_IMAGE_COUNT = 3;
+
+const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+function withTimeout<T>(promise: Promise<T>, ms: number, signal?: AbortSignal): Promise<void> {
+  return new Promise<void>((resolve) => {
+    const timer = window.setTimeout(resolve, ms);
+    const done = () => {
+      window.clearTimeout(timer);
+      resolve();
+    };
+    signal?.addEventListener('abort', done, { once: true });
+    promise.then(done, done);
+  });
+}
+
+/** Load and decode an image so it is in the memory cache, ready to paint. */
+function preloadImage(img: HTMLImageElement): Promise<void> {
+  const src = img.getAttribute('src');
+  if (!src) return Promise.resolve();
+  const loader = new Image();
+  // Match the request mode, otherwise the cache entry can't be reused.
+  const crossOrigin = img.getAttribute('crossorigin');
+  if (crossOrigin !== null) loader.crossOrigin = crossOrigin;
+  const sizes = img.getAttribute('sizes');
+  if (sizes) loader.sizes = sizes;
+  const srcset = img.getAttribute('srcset');
+  if (srcset) loader.srcset = srcset;
+  loader.src = new URL(src, location.href).href;
+  return loader.decode().catch(() => undefined);
+}
+
+function criticalImages(doc: Document): HTMLImageElement[] {
+  const set = new Set<HTMLImageElement>();
+  doc.querySelectorAll<HTMLImageElement>('img[data-vt-critical]').forEach((img) => set.add(img));
+  const main = doc.querySelector('main');
+  if (main) {
+    Array.from(main.querySelectorAll<HTMLImageElement>('img'))
+      .slice(0, LEADING_IMAGE_COUNT)
+      .forEach((img) => set.add(img));
+  }
+  return [...set];
+}
+
+function isInViewport(el: Element): boolean {
+  const r = el.getBoundingClientRect();
+  return r.bottom > 0 && r.right > 0 && r.top < window.innerHeight && r.left < window.innerWidth && r.width > 0;
+}
+
+function clearMorphNames(doc: Document) {
+  doc.querySelectorAll<HTMLElement>('[data-vt-image]').forEach((el) => {
+    el.style.removeProperty('view-transition-name');
+  });
+}
+
+/** Slug of the article a URL points to, if it is an article page. */
+function articleSlug(url: URL): string | null {
+  const match = url.pathname.match(/\/articles\/([^/?#]+)\/?$/);
+  return match ? decodeURIComponent(match[1]) : null;
+}
+
+/** The visible image on the current page for `slug`, preferring the clicked card. */
+function findSourceImage(slug: string, source?: Element): HTMLElement | null {
+  const fromCard = source
+    ?.closest('[data-vt-card]')
+    ?.querySelector<HTMLElement>(`[data-vt-image="${CSS.escape(slug)}"]`);
+  const fromLink = source?.querySelector<HTMLElement>(`[data-vt-image="${CSS.escape(slug)}"]`);
+  const candidate = fromLink ?? fromCard;
+  if (candidate && isInViewport(candidate)) return candidate;
+  // e.g. the headline link was clicked: use any visible image of that article.
+  return (
+    Array.from(document.querySelectorAll<HTMLElement>(`[data-vt-image="${CSS.escape(slug)}"]`)).find(isInViewport) ??
+    null
+  );
+}
+
+let pendingMorph = false;
+let indicatorTimer: number | undefined;
+
+function setLoading(on: boolean) {
+  window.clearTimeout(indicatorTimer);
+  if (on) {
+    indicatorTimer = window.setTimeout(() => {
+      document.documentElement.dataset.vtLoading = '';
+    }, LOADING_INDICATOR_DELAY_MS);
+  } else {
+    delete document.documentElement.dataset.vtLoading;
+  }
+}
+
+document.addEventListener('astro:before-preparation', (event) => {
+  const e = event as TransitionBeforePreparationEvent;
+
+  // Pair the clicked teaser image with the destination hero (forward link clicks only;
+  // on back/forward the restored scroll position makes a morph unreliable).
+  clearMorphNames(document);
+  pendingMorph = false;
+  const slug = articleSlug(e.to);
+  if (slug && e.navigationType !== 'traverse' && !reducedMotion()) {
+    const sourceImg = findSourceImage(slug, e.sourceElement);
+    if (sourceImg) {
+      sourceImg.style.setProperty('view-transition-name', MORPH_NAME);
+      pendingMorph = true;
+    }
+  }
+
+  setLoading(true);
+  const originalLoader = e.loader;
+  e.loader = async () => {
+    try {
+      await originalLoader();
+      const doc = e.newDocument;
+      if (!doc || e.signal.aborted) return;
+
+      let morphTarget: HTMLElement | null = null;
+      if (pendingMorph && slug) {
+        morphTarget = doc.querySelector<HTMLElement>(`[data-vt-hero="${CSS.escape(slug)}"]`);
+        if (!morphTarget) {
+          clearMorphNames(document);
+          pendingMorph = false;
+        }
+      }
+
+      const images = criticalImages(doc);
+      if (morphTarget instanceof HTMLImageElement && !images.includes(morphTarget)) images.push(morphTarget);
+      images.forEach((img) => {
+        // Paint immediately after the swap instead of waiting for lazy-load/async decode.
+        img.setAttribute('loading', 'eager');
+        img.setAttribute('decoding', 'sync');
+        img.setAttribute('fetchpriority', 'high');
+      });
+
+      const fontsReady = document.fonts
+        ? Promise.all([document.fonts.load('500 1em Grenze'), document.fonts.ready])
+        : Promise.resolve();
+
+      await withTimeout(Promise.all([fontsReady, ...images.map(preloadImage)]), READY_TIMEOUT_MS, e.signal);
+
+      morphTarget?.style.setProperty('view-transition-name', MORPH_NAME);
+    } finally {
+      setLoading(false);
+    }
+  };
+});
+
+document.addEventListener('astro:before-swap', (event) => {
+  const e = event as TransitionBeforeSwapEvent;
+  // Release the morph names once the animation is over so they never collide
+  // with the pairing of the next navigation.
+  const release = () => {
+    pendingMorph = false;
+    clearMorphNames(document);
+  };
+  e.viewTransition.finished.then(release, release);
+});
+
+document.addEventListener('astro:after-swap', () => {
+  setLoading(false);
+});
