\ No newline at end of file
+}
+/* ---------- Page transitions (see src/scripts/page-transitions.ts) ---------- */
+
+@keyframes vt-page-out {
+  to { opacity: 0; }
+}
+
+@keyframes vt-page-in-forwards {
+  from { opacity: 0; transform: translateY(12px); }
+}
+
+@keyframes vt-page-in-backwards {
+  from { opacity: 0; transform: translateY(-12px); }
+}
+
+/* Shared article image morph (teaser -> article hero). */
+::view-transition-group(article-image) {
+  animation-duration: 380ms;
+  animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
+  overflow: clip;
+}
+::view-transition-old(article-image),
+::view-transition-new(article-image) {
+  /* Images keep their aspect ratio while the box morphs. */
+  height: 100%;
+  object-fit: cover;
+}
+
+/* Thin progress bar while the next page is being prepared (only if it takes a moment). */
+html[data-vt-loading]::before {
+  content: "";
+  position: fixed;
+  inset: 0 0 auto 0;
+  height: 3px;
+  z-index: 9999;
+  background: linear-gradient(90deg, transparent, var(--color-amber-500), transparent);
+  background-size: 50% 100%;
+  background-repeat: no-repeat;
+  animation: vt-loading 900ms ease-in-out infinite;
+  pointer-events: none;
+}
+
+@keyframes vt-loading {
+  from { background-position: -50% 0; }
+  to { background-position: 150% 0; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation-duration: 0s !important;
+    animation-delay: 0s !important;
+  }
+  html[data-vt-loading]::before {
+    animation: none;
+    background: var(--color-amber-500);
+    opacity: 0.6;
+  }
+}
