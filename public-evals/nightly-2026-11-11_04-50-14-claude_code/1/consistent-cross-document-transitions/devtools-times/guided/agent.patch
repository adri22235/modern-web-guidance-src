\ No newline at end of file
+}
+/* ------------------------------------------------------------------
+ * Cross-document page transitions
+ * Same-origin navigations between pages (home, category, article…)
+ * animate natively. Render blocking in Layout.astro makes sure the new
+ * page is styled and its above-the-fold content is parsed first.
+ * ------------------------------------------------------------------ */
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* The masthead is identical on every page, so keep it fixed in place
+   rather than cross-fading it along with the page. */
+.vt-site-header {
+  view-transition-name: site-header;
+}
+
+.vt-page-content {
+  view-transition-name: page-content;
+}
+
+/* Header stays put: no fade, just snap to its new size if it changes. */
+::view-transition-old(site-header),
+::view-transition-new(site-header) {
+  animation: none;
+  mix-blend-mode: normal;
+}
+
+::view-transition-group(page-content) {
+  animation-duration: 280ms;
+}
+
+::view-transition-old(page-content) {
+  animation: 160ms cubic-bezier(0.4, 0, 1, 1) both vt-content-out;
+}
+
+::view-transition-new(page-content) {
+  animation: 280ms cubic-bezier(0, 0, 0.2, 1) 80ms both vt-content-in;
+}
+
+/* Old and new content can differ greatly in height; anchor both to the
+   top so neither is stretched while the group resizes. */
+::view-transition-old(page-content),
+::view-transition-new(page-content) {
+  height: auto;
+  object-fit: none;
+  object-position: top;
+}
+
+@keyframes vt-content-out {
+  to {
+    opacity: 0;
+    transform: translateY(-8px);
+  }
+}
+
+@keyframes vt-content-in {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+}
