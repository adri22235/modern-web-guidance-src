+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = Array.prototype.slice.call(scroller.querySelectorAll('.bean'));
+      var SETTLE_DELAY = 150;
+      var settleTimer = null;
+      var isScrolling = false;
+
+      // Find the bean whose center is closest to the scroller's center.
+      function findVisibleBean() {
+        var rect = scroller.getBoundingClientRect();
+        var center = rect.left + rect.width / 2;
+        var best = null;
+        var bestDist = Infinity;
+        for (var i = 0; i < beans.length; i++) {
+          var r = beans[i].getBoundingClientRect();
+          var dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = beans[i];
+          }
+        }
+        return best;
+      }
+
+      function onScrollStop() {
+        clearTimeout(settleTimer);
+        settleTimer = null;
+        if (!isScrolling) return;
+        isScrolling = false;
+        var bean = findVisibleBean();
+        status.classList.remove('is-scrolling');
+        status.textContent = bean ? 'Now viewing: ' + bean.dataset.bean : 'Scroll to explore our beans';
+      }
+
+      // Keep the scroll handler cheap: no layout reads, DOM writes only once per gesture.
+      function onScroll() {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.classList.add('is-scrolling');
+          status.textContent = 'Scrolling…';
+        }
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(onScrollStop, SETTLE_DELAY);
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      // Use native scrollend where supported for a snappier update; the timer is the fallback.
+      if ('onscrollend' in window) {
+        scroller.addEventListener('scrollend', onScrollStop);
+      }
+
+      // Initial state
+      var initial = findVisibleBean();
+      if (initial) status.textContent = 'Now viewing: ' + initial.dataset.bean;
+    })();
+  </script>
+
 </body>
 
