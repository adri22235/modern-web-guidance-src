+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const beans = [...scroller.querySelectorAll('.bean')];
+      let scrolling = false;
+
+      // Find the bean whose center is closest to the scroller's center.
+      // Only called once scrolling has stopped, so layout reads never run mid-scroll.
+      function visibleBean() {
+        const center = scroller.scrollLeft + scroller.clientWidth / 2;
+        let best = beans[0];
+        let bestDist = Infinity;
+        for (const bean of beans) {
+          const dist = Math.abs(bean.offsetLeft + bean.offsetWidth / 2 - center);
+          if (dist < bestDist) {
+            bestDist = dist;
+            best = bean;
+          }
+        }
+        return best;
+      }
+
+      // Cheap: flips the status once per gesture, no layout reads.
+      scroller.addEventListener('scroll', () => {
+        if (scrolling) return;
+        scrolling = true;
+        status.dataset.state = 'scrolling';
+        status.textContent = 'Scrolling…';
+      }, { passive: true });
+
+      scroller.addEventListener('scrollend', () => {
+        scrolling = false;
+        status.dataset.state = 'idle';
+        status.textContent = `Showing: ${visibleBean().dataset.bean}`;
+      });
+
+      // Fallback for browsers without native scrollend.
+      if (!('onscrollend' in window)) {
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 150);
+        }, { passive: true });
+      }
+    })();
+  </script>
+
