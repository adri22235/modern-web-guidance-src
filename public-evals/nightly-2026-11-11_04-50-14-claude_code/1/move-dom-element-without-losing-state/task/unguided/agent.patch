+  <script>
+    (function () {
+      const player = document.getElementById('player');
+      const home = document.getElementById('player-home');
+      const placeholder = document.getElementById('player-placeholder');
+      const slot = document.getElementById('theater-slot');
+      const toggle = document.getElementById('theater-toggle');
+
+      // moveBefore() relocates a node while keeping iframe state intact.
+      // Classic appendChild/insertBefore would reload the iframe and reset playback.
+      const canMoveAtomically = typeof Element.prototype.moveBefore === 'function';
+      let theater = false;
+
+      // Fallback: keep the iframe where it is in the DOM and overlay it on the slot.
+      function positionOverSlot() {
+        if (!theater || canMoveAtomically) return;
+        const rect = slot.getBoundingClientRect();
+        player.style.left = rect.left + window.scrollX + 'px';
+        player.style.top = rect.top + window.scrollY + 'px';
+        player.style.width = rect.width + 'px';
+      }
+
+      function reserveSlotHeight() {
+        // Make the hero slot as tall as the floating player so the hero grows to fit it.
+        slot.style.height = player.offsetHeight + 'px';
+        positionOverSlot();
+      }
+
+      const resizeObserver = new ResizeObserver(function () {
+        if (!theater || canMoveAtomically) return;
+        reserveSlotHeight();
+      });
+
+      function setTheater(on) {
+        if (on === theater) return;
+        theater = on;
+        document.body.classList.toggle('theater', on);
+        toggle.setAttribute('aria-pressed', String(on));
+        toggle.textContent = on ? 'Exit Theater Mode' : 'Theater Mode';
+
+        if (canMoveAtomically) {
+          if (on) {
+            slot.moveBefore(player, null);
+          } else {
+            home.moveBefore(player, placeholder);
+          }
+        } else if (on) {
+          player.classList.add('is-floating');
+          // Width must be set before the height can be measured.
+          player.style.width = slot.getBoundingClientRect().width + 'px';
+          reserveSlotHeight();
+          resizeObserver.observe(slot);
+          resizeObserver.observe(player);
+          resizeObserver.observe(document.body);
+        } else {
+          resizeObserver.disconnect();
+          player.classList.remove('is-floating');
+          player.style.left = player.style.top = player.style.width = '';
+          slot.style.height = '';
+        }
+
+        const target = on ? document.querySelector('.hero') : document.getElementById('roasting-video');
+        target.scrollIntoView({ block: 'start' });
+        toggle.focus({ preventScroll: true });
+      }
+
+      toggle.addEventListener('click', function () {
+        setTheater(!theater);
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && theater) setTheater(false);
+      });
+
+      window.addEventListener('resize', positionOverSlot);
+    })();
+  </script>
+
