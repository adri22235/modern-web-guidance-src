+  <script>
+    (() => {
+      const player = document.getElementById('player');
+      const iframe = document.getElementById('roast-video');
+      const toggle = document.getElementById('theater-toggle');
+      const hero = document.querySelector('.hero');
+      const heroSlot = document.getElementById('hero-video-slot');
+      const home = document.getElementById('video-home');
+      const placeholder = document.getElementById('video-placeholder');
+      const status = document.getElementById('theater-status');
+      const canMoveAtomically = 'moveBefore' in Element.prototype;
+
+      // Fallback (no moveBefore, e.g. Safari): a classic DOM move reloads the
+      // iframe, so track playback via the YouTube postMessage API and restore it.
+      const playback = { time: 0, playing: false };
+      const YT_ORIGINS = ['https://www.youtube-nocookie.com', 'https://www.youtube.com'];
+      const sendToPlayer = (msg) =>
+        iframe.contentWindow?.postMessage(JSON.stringify(msg), '*');
+      const ytCommand = (func, args = []) =>
+        sendToPlayer({ event: 'command', func, args, id: iframe.id });
+
+      if (!canMoveAtomically) {
+        window.addEventListener('message', (e) => {
+          if (e.source !== iframe.contentWindow || !YT_ORIGINS.includes(e.origin)) return;
+          let data;
+          try { data = JSON.parse(e.data); } catch { return; }
+          const info = data?.info;
+          if (!info) return;
+          if (typeof info.currentTime === 'number') playback.time = info.currentTime;
+          if (typeof info.playerState === 'number') playback.playing = info.playerState === 1;
+        });
+        iframe.addEventListener('load', () => {
+          sendToPlayer({ event: 'listening', id: iframe.id });
+          if (playback.time > 0) {
+            ytCommand('seekTo', [playback.time, true]);
+            if (playback.playing) ytCommand('playVideo');
+          }
+        });
+      }
+
+      function move(target, before = null) {
+        if (canMoveAtomically) {
+          // Atomic move: iframe keeps its browsing context and playback state.
+          target.moveBefore(player, before);
+        } else {
+          target.insertBefore(player, before);
+          toggle.focus(); // classic remove+insert drops focus
+        }
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = toggle.getAttribute('aria-pressed') !== 'true';
+
+        if (entering) {
+          move(heroSlot);
+        } else {
+          move(home, placeholder);
+        }
+
+        hero.classList.toggle('is-theater', entering);
+        placeholder.classList.toggle('is-visible', entering);
+        toggle.setAttribute('aria-pressed', String(entering));
+        toggle.textContent = entering ? 'Exit theater mode' : 'Theater mode';
+        status.textContent = entering
+          ? 'Video moved to theater mode at the top of the page.'
+          : 'Video returned to its section.';
+
+        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+        player.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
+      });
+    })();
+  </script>
+
