+  <script>
+    (function () {
+      const anchor = document.getElementById('anchor');
+      const tooltip = document.getElementById('maple-tooltip');
+      const arrow = tooltip.querySelector('.tooltip-arrow');
+      const GAP = 10;          // distance between anchor and tooltip (includes arrow)
+      const PADDING = 8;       // min distance from viewport edges
+      const ARROW = 8;         // arrow half-width
+      const OPPOSITE = { top: 'bottom', bottom: 'top', left: 'right', right: 'left' };
+      const PREFERRED = 'top';
+      let pinned = false;
+      let suppressFocus = false;
+
+      function coordsFor(placement, a, t) {
+        switch (placement) {
+          case 'top':    return { x: a.left + a.width / 2 - t.width / 2, y: a.top - t.height - GAP };
+          case 'bottom': return { x: a.left + a.width / 2 - t.width / 2, y: a.bottom + GAP };
+          case 'left':   return { x: a.left - t.width - GAP, y: a.top + a.height / 2 - t.height / 2 };
+          case 'right':  return { x: a.right + GAP, y: a.top + a.height / 2 - t.height / 2 };
+        }
+      }
+
+      function fits(placement, a, t, vw, vh) {
+        const { x, y } = coordsFor(placement, a, t);
+        if (placement === 'top' || placement === 'bottom') {
+          return y >= PADDING && y + t.height <= vh - PADDING;
+        }
+        return x >= PADDING && x + t.width <= vw - PADDING;
+      }
+
+      function position() {
+        const a = anchor.getBoundingClientRect();
+        const t = tooltip.getBoundingClientRect();
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+
+        // Try preferred side, then flip to the opposite, then the cross axis.
+        const order = [PREFERRED, OPPOSITE[PREFERRED]];
+        const cross = PREFERRED === 'top' || PREFERRED === 'bottom' ? ['right', 'left'] : ['top', 'bottom'];
+        order.push(...cross);
+        let placement = order.find(p => fits(p, a, t, vw, vh));
+
+        // Nothing fits cleanly: use whichever side has the most room.
+        if (!placement) {
+          const room = { top: a.top, bottom: vh - a.bottom, left: a.left, right: vw - a.right };
+          placement = Object.keys(room).reduce((best, p) => (room[p] > room[best] ? p : best));
+        }
+
+        let { x, y } = coordsFor(placement, a, t);
+        const vertical = placement === 'top' || placement === 'bottom';
+
+        // Shift along the cross axis to stay inside the viewport.
+        if (vertical) {
+          x = Math.min(Math.max(x, PADDING), vw - t.width - PADDING);
+        } else {
+          y = Math.min(Math.max(y, PADDING), vh - t.height - PADDING);
+        }
+
+        tooltip.dataset.placement = placement;
+        tooltip.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
+
+        // Keep the arrow pointing at the anchor's center, clamped inside the tooltip's rounded corners.
+        arrow.style.left = arrow.style.top = '';
+        if (vertical) {
+          const center = a.left + a.width / 2 - x - ARROW;
+          arrow.style.left = Math.min(Math.max(center, 6), t.width - ARROW * 2 - 6) + 'px';
+        } else {
+          const center = a.top + a.height / 2 - y - ARROW;
+          arrow.style.top = Math.min(Math.max(center, 6), t.height - ARROW * 2 - 6) + 'px';
+        }
+      }
+
+      function show() {
+        tooltip.classList.add('is-visible');
+        anchor.setAttribute('aria-expanded', 'true');
+        position();
+      }
+
+      function hide() {
+        if (pinned) return;
+        tooltip.classList.remove('is-visible');
+        anchor.setAttribute('aria-expanded', 'false');
+      }
+
+      function forceHide() {
+        pinned = false;
+        hide();
+      }
+
+      const isOpen = () => tooltip.classList.contains('is-visible');
+
+      anchor.addEventListener('mouseenter', show);
+      anchor.addEventListener('mouseleave', hide);
+      anchor.addEventListener('focus', () => { if (!suppressFocus) show(); });
+      anchor.addEventListener('blur', hide);
+      anchor.addEventListener('click', (e) => {
+        e.stopPropagation();
+        pinned = !pinned;
+        pinned ? show() : forceHide();
+      });
+
+      document.addEventListener('click', (e) => {
+        if (pinned && !tooltip.contains(e.target)) forceHide();
+      });
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && isOpen()) {
+          forceHide();
+          suppressFocus = true;
+          anchor.focus();
+          suppressFocus = false;
+        }
+      });
+
+      let frame = null;
+      const schedule = () => {
+        if (!isOpen() || frame) return;
+        frame = requestAnimationFrame(() => { frame = null; position(); });
+      };
+      window.addEventListener('scroll', schedule, { passive: true, capture: true });
+      window.addEventListener('resize', schedule);
+    })();
+  </script>
+
