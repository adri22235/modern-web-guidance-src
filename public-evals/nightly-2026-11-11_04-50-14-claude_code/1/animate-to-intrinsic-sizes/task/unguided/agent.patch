+    /* ---------- Collapsible primitives ----------
+       Animating to/from `height: auto` isn't possible with plain height
+       transitions, so we transition grid-template-rows between 0fr and 1fr.
+       The single grid row tracks the content's natural height, so the
+       animation always ends at exactly the right size, even if the content
+       reflows (e.g. viewport resize). */
+    .collapsible {
+      display: grid;
+      grid-template-rows: 1fr;
+      transition: grid-template-rows 0.35s ease, opacity 0.35s ease;
+    }
+
+    .collapsible[hidden] {
+      display: none;
+    }
+
+    .collapsible.is-collapsed {
+      grid-template-rows: 0fr;
+    }
+
+    .collapsible>.collapsible-inner {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    /* Promo alert */
