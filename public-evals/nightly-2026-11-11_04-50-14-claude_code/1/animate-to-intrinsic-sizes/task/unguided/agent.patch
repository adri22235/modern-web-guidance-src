+  <script>
+    (function () {
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Run `done` once the grid-row transition on `el` finishes (or right away
+      // if motion is reduced / transitions don't fire).
+      function afterCollapse(el, done) {
+        if (reduceMotion.matches) { done(); return; }
+        var finished = false;
+        function finish(e) {
+          if (e && (e.target !== el || e.propertyName !== 'grid-template-rows')) return;
+          if (finished) return;
+          finished = true;
+          el.removeEventListener('transitionend', finish);
+          done();
+        }
+        el.addEventListener('transitionend', finish);
+        setTimeout(finish, 600); // safety net
+      }
+
+      // FAQ accordion
+      var trigger = document.getElementById('faq-trigger');
+      var content = document.getElementById('faq-content');
+      if (trigger && content) {
+        trigger.addEventListener('click', function () {
+          var open = trigger.getAttribute('aria-expanded') === 'true';
+          trigger.setAttribute('aria-expanded', String(!open));
+          content.classList.toggle('is-collapsed', open);
+          // Keep collapsed answers out of the tab order / a11y tree.
+          content.inert = open;
+        });
+      }
+
+      // Dismissible promo alert
+      var alertEl = document.getElementById('promo-alert');
+      var dismiss = document.getElementById('alert-dismiss');
+      var STORAGE_KEY = 'promoAlertDismissed';
+      if (alertEl && dismiss) {
+        try {
+          if (sessionStorage.getItem(STORAGE_KEY) === '1') alertEl.hidden = true;
+        } catch (e) { }
+
+        dismiss.addEventListener('click', function () {
+          alertEl.inert = true;
+          alertEl.classList.add('is-collapsed');
+          afterCollapse(alertEl, function () { alertEl.hidden = true; });
+          try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (e) { }
+        });
+      }
+    })();
+  </script>
+
