+  <script>
+    // Promo alert: collapse to zero, then remove from the accessibility tree
+    const promoAlert = document.getElementById('promo-alert');
+    document.getElementById('alert-dismiss').addEventListener('click', () => {
+      promoAlert.classList.add('is-dismissed');
+      const transitions = promoAlert.getAnimations().filter((a) => a instanceof CSSTransition);
+      Promise.allSettled(transitions.map((t) => t.finished)).then(() => {
+        if (promoAlert.classList.contains('is-dismissed')) promoAlert.hidden = true;
+      });
+    });
+
+    // FAQ accordion
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    faqTrigger.addEventListener('click', () => {
+      faqContent.hidden = faqContent.hidden ? false : 'until-found';
+      faqTrigger.setAttribute('aria-expanded', String(!faqContent.hidden));
+    });
+    // Find-in-page reveals the content directly; mirror that into the trigger
+    faqContent.addEventListener('beforematch', () => {
+      faqTrigger.setAttribute('aria-expanded', 'true');
+    });
+  </script>
 </body>
 
