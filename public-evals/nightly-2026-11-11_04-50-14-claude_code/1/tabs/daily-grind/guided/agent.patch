+  <script type="module">
+    const tablist = document.querySelector('#coffee-menu .tablist');
+    const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+    const panels = tabs.map(tab => document.querySelector(`[aria-labelledby="${tab.id}"]`));
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    function select(tab) {
+      for (const [i, t] of tabs.entries()) {
+        const isSelected = t === tab;
+        t.setAttribute('aria-selected', String(isSelected));
+        t.toggleAttribute('focusgroupstart', isSelected);
+        // Hidden panels stay findable with find-in-page where supported
+        panels[i].hidden = isSelected ? false : 'until-found';
+      }
+      // Scroll only the tablist (not the page) so the selected tab, and a peek of its neighbor, is visible
+      tab.scrollIntoView({
+        block: 'nearest',
+        inline: 'nearest',
+        container: 'nearest',
+        behavior: reduceMotion.matches ? 'instant' : 'smooth',
+      });
+    }
+
+    // Selection follows focus: arrow keys (via focusgroup) move focus, which selects
+    tablist.addEventListener('focusin', e => {
+      const tab = e.target.closest('[role="tab"]');
+      if (tab && tab.getAttribute('aria-selected') !== 'true') select(tab);
+    });
+    tablist.addEventListener('click', e => {
+      const tab = e.target.closest('[role="tab"]');
+      if (tab) select(tab);
+    });
+
+    // Find-in-page matched text in a hidden panel: switch to its tab
+    for (const [i, panel] of panels.entries()) {
+      panel.addEventListener('beforematch', () => select(tabs[i]));
+    }
+
+    // Edge fades fallback when scroll-driven animations are unsupported (the scrollbar is hidden)
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      tablist.classList.add('no-sda');
+      const [first, last] = [tabs[0], tabs.at(-1)];
+      const observer = new IntersectionObserver(entries => {
+        for (const { target, intersectionRatio } of entries) {
+          tablist.classList.toggle(target === first ? 'more-start' : 'more-end', intersectionRatio < 1);
+        }
+      }, { root: tablist, threshold: 1, rootMargin: '1px' });
+      observer.observe(first);
+      observer.observe(last);
+    }
+
+    // Arrow-key roving focus for browsers without native focusgroup
