+  <script>
+    {
+      const menu = document.getElementById('coffee-menu');
+      const tablist = menu.querySelector('[role="tablist"]');
+      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+      const panels = tabs.map(tab => menu.querySelector(`[role="tabpanel"][aria-labelledby="${tab.id}"]`));
+
+      function select(selected) {
+        tabs.forEach((tab, i) => {
+          const isSelected = tab === selected;
+          tab.ariaSelected = String(isSelected);
+          tab.toggleAttribute('focusgroupstart', isSelected);
+          if (isSelected) panels[i].hidden = false;
+          else panels[i].hidden = 'until-found';
+        });
+        // Scroll only the tab bar (not the page) so the selected tab, plus a peek
+        // of its neighbour, is visible on narrow screens.
+        selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+      }
+
+      // Selection follows focus (arrow keys via focusgroup), plus click for
+      // browsers that don't focus buttons on click.
+      const onActivate = event => {
+        const tab = event.target.closest('[role="tab"]');
+        if (tab && tab.ariaSelected !== 'true') select(tab);
+      };
+      tablist.addEventListener('focusin', onActivate);
+      tablist.addEventListener('click', onActivate);
+
+      // Find-in-page revealed a hidden panel: sync the selected tab.
+      panels.forEach((panel, i) => panel.addEventListener('beforematch', () => select(tabs[i])));
+    }
+  </script>
