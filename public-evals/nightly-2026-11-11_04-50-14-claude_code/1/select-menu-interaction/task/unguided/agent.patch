+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var select = document.getElementById('shop');
+      var field = document.getElementById('shop-field');
+      var error = document.getElementById('shop-error');
+
+      function validate() {
+        // Errors are only surfaced once the field is "touched".
+        if (!field.classList.contains('is-touched')) return true;
+        var valid = select.checkValidity();
+        error.textContent = valid ? '' : 'Please select a local shop.';
+        if (valid) {
+          select.removeAttribute('aria-invalid');
+        } else {
+          select.setAttribute('aria-invalid', 'true');
+        }
+        return valid;
+      }
+
+      function touch() {
+        field.classList.add('is-touched');
+        validate();
+      }
+
+      select.addEventListener('change', touch);
+      select.addEventListener('blur', touch);
+
+      form.addEventListener('submit', function (event) {
+        field.classList.add('is-touched');
+        if (!validate()) {
+          event.preventDefault();
+          select.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
