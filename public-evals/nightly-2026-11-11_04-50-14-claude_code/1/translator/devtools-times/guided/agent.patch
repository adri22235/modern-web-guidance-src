diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..1ef3cc6
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,350 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+/**
+ * On-device article translation.
+ *
+ * Translates every element marked with `data-translatable` on the current page
+ * (article headline, lead, body, captions and teaser titles/summaries) using the
+ * browser's built-in Translator API. Nothing leaves the reader's device.
+ */
+
+const STORAGE_KEY = 'devtools-times:translate-to';
+const ROOT_SELECTOR = '[data-translatable]';
+const SKIP_SELECTOR = 'script, style, code, pre, kbd, samp, [translate="no"]';
+const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+// Languages supported by Chrome's Translator API implementation.
+const LANGUAGES = [
+  'ar', 'bg', 'bn', 'cs', 'da', 'de', 'el', 'en', 'es', 'fi', 'fr', 'he', 'hi', 'hr', 'hu',
+  'id', 'it', 'ja', 'kn', 'ko', 'lt', 'mr', 'nl', 'no', 'pl', 'pt', 'ro', 'ru', 'sk', 'sl',
+  'sv', 'ta', 'te', 'th', 'tr', 'uk', 'vi', 'zh', 'zh-Hant',
+];
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'downloading'; percent: number }
+  | { kind: 'translating'; done: number; total: number }
+  | { kind: 'translated'; language: string }
+  | { kind: 'needs-gesture'; language: string }
+  | { kind: 'error'; message: string };
+
+const englishNames = new Intl.DisplayNames(['en'], { type: 'language' });
+
+function languageLabel(code: string): string {
+  const english = englishNames.of(code) ?? code;
+  let native = english;
+  try {
+    native = new Intl.DisplayNames([code], { type: 'language' }).of(code) ?? english;
+  } catch {
+    /* keep English name */
+  }
+  return native.toLowerCase() === english.toLowerCase() ? english : `${native} (${english})`;
+}
+
+const LANGUAGE_OPTIONS = LANGUAGES.map((code) => ({ code, label: languageLabel(code) })).sort((a, b) =>
+  englishNames.of(a.code)!.localeCompare(englishNames.of(b.code)!),
+);
+
+function isSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self;
+}
+
+function isAbortError(error: unknown): boolean {
+  return error instanceof DOMException && error.name === 'AbortError';
+}
+
+/** Original text of each text node we have rewritten, so we can always translate from (and restore to) the source. */
+const originalText = new WeakMap<Text, string>();
+let touchedNodes = new Set<Text>();
+
+function getRoots(): HTMLElement[] {
+  const roots = Array.from(document.querySelectorAll<HTMLElement>(ROOT_SELECTOR));
+  // Skip roots nested in another root so text is processed once.
+  return roots.filter((root) => !root.parentElement?.closest(ROOT_SELECTOR));
+}
+
+/** Source language of a root, captured before we first change its `lang`. */
+function sourceLanguageOf(root: HTMLElement): string {
+  if (!root.dataset.originalLang) {
+    const declared = root.closest<HTMLElement>('[lang]')?.lang || document.documentElement.lang || 'en';
+    root.dataset.originalLang = declared;
+    root.dataset.originalLangAttr = root.getAttribute('lang') ?? '';
+    root.dataset.originalDirAttr = root.getAttribute('dir') ?? '';
+  }
+  return root.dataset.originalLang;
+}
+
+function sameLanguage(a: string, b: string): boolean {
+  if (a === b) return true;
+  // 'en-US' vs 'en' match, but keep 'zh' and 'zh-Hant' distinct.
+  if (a.startsWith('zh') || b.startsWith('zh')) return a.toLowerCase() === b.toLowerCase();
+  return a.split('-')[0].toLowerCase() === b.split('-')[0].toLowerCase();
+}
+
+function collectTextNodes(root: HTMLElement): Text[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest(SKIP_SELECTOR)) return NodeFilter.FILTER_REJECT;
+      const text = originalText.get(node as Text) ?? node.nodeValue ?? '';
+      return /\p{L}/u.test(text) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  const nodes: Text[] = [];
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function setRootLanguage(root: HTMLElement, language: string) {
+  root.setAttribute('lang', language);
+  if (RTL_LANGUAGES.has(language.split('-')[0])) root.setAttribute('dir', 'rtl');
+  else restoreAttr(root, 'dir', root.dataset.originalDirAttr);
+}
+
+function restoreAttr(root: HTMLElement, name: string, value: string | undefined) {
+  if (value) root.setAttribute(name, value);
+  else root.removeAttribute(name);
+}
+
+function restoreRoot(root: HTMLElement) {
+  for (const node of collectTextNodes(root)) {
+    const original = originalText.get(node);
+    if (original !== undefined) {
+      node.nodeValue = original;
+      touchedNodes.delete(node);
+    }
+  }
+  if (root.dataset.originalLang) {
+    restoreAttr(root, 'lang', root.dataset.originalLangAttr);
+    restoreAttr(root, 'dir', root.dataset.originalDirAttr);
+  }
+}
+
+function restoreAll() {
+  for (const node of touchedNodes) {
+    const original = originalText.get(node);
+    if (original !== undefined) node.nodeValue = original;
+  }
+  touchedNodes = new Set();
+  getRoots().forEach(restoreRoot);
+}
+
+export default function TranslateControl() {
+  const selectId = useId();
+  const [supported] = useState(isSupported);
+  const [target, setTarget] = useState('');
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+
+  const abortRef = useRef<AbortController | null>(null);
+  const translatorsRef = useRef(new Map<string, Promise<TranslatorInstance>>());
+
+  const cancel = useCallback(() => {
+    abortRef.current?.abort();
+    abortRef.current = null;
+  }, []);
+
+  const getTranslator = useCallback(
+    async (sourceLanguage: string, targetLanguage: string, userInitiated: boolean, signal: AbortSignal) => {
+      const key = `${sourceLanguage}>${targetLanguage}`;
+      const cached = translatorsRef.current.get(key);
+      if (cached) return cached;
+
+      // Identical options object for availability() and create().
+      const options = { sourceLanguage, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') {
+        throw new Error(`Translating ${englishNames.of(sourceLanguage)} to ${englishNames.of(targetLanguage)} isn't available on this device.`);
+      }
+      if (availability !== 'available' && !userInitiated) {
+        // Downloading a language pack requires a user gesture.
+        return null;
+      }
+
+      const promise = Translator.create({
+        ...options,
+        signal,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            setStatus({ kind: 'downloading', percent: Math.round(e.loaded * 100) });
+          });
+        },
+      });
+      translatorsRef.current.set(key, promise);
+      promise.catch(() => translatorsRef.current.delete(key));
+      return promise;
+    },
+    [],
+  );
+
+  const translatePage = useCallback(
+    async (targetLanguage: string, userInitiated: boolean) => {
+      cancel();
+      if (!targetLanguage) {
+        restoreAll();
+        setStatus({ kind: 'idle' });
+        return;
+      }
+
+      const controller = new AbortController();
+      abortRef.current = controller;
+      const { signal } = controller;
+
+      try {
+        const roots = getRoots();
+        const jobs: { root: HTMLElement; nodes: Text[]; source: string }[] = [];
+        for (const root of roots) {
+          const source = sourceLanguageOf(root);
+          if (sameLanguage(source, targetLanguage)) {
+            restoreRoot(root);
+          } else {
+            jobs.push({ root, nodes: collectTextNodes(root), source });
+          }
+        }
+
+        const total = jobs.reduce((sum, job) => sum + job.nodes.length, 0);
+        if (total === 0) {
+          setStatus({ kind: 'translated', language: targetLanguage });
+          return;
+        }
+
+        let done = 0;
+        const memo = new Map<string, string>();
+        setStatus({ kind: 'translating', done, total });
+
+        for (const { root, nodes, source } of jobs) {
+          const translator = await getTranslator(source, targetLanguage, userInitiated, signal);
+          if (signal.aborted) return;
+          if (!translator) {
+            setStatus({ kind: 'needs-gesture', language: targetLanguage });
+            return;
+          }
+
+          for (const node of nodes) {
+            if (!originalText.has(node)) originalText.set(node, node.nodeValue ?? '');
+            const original = originalText.get(node)!;
+            // Keep surrounding whitespace so inline markup (links, emphasis) stays spaced correctly.
+            const [, lead, core, trail] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+            const memoKey = `${source}>${targetLanguage}:${core}`;
+            let translated = memo.get(memoKey);
+            if (translated === undefined) {
+              translated = await translator.translate(core, { signal });
+              memo.set(memoKey, translated);
+            }
+            if (signal.aborted) return;
+            node.nodeValue = lead + translated + trail;
+            touchedNodes.add(node);
+            setStatus({ kind: 'translating', done: ++done, total });
+          }
+          setRootLanguage(root, targetLanguage);
+        }
+
+        setStatus({ kind: 'translated', language: targetLanguage });
+      } catch (error) {
+        if (isAbortError(error) || signal.aborted) return;
+        console.error('Translation failed:', error);
+        restoreAll();
+        setStatus({
+          kind: 'error',
+          message: error instanceof Error && error.message ? error.message : 'Translation failed.',
+        });
+      }
+    },
+    [cancel, getTranslator],
+  );
+
+  // Re-apply the reader's saved language on each page (only if the language pack is already downloaded).
+  useEffect(() => {
+    if (!supported) return;
+    const saved = localStorage.getItem(STORAGE_KEY);
+    if (saved && LANGUAGES.includes(saved)) {
+      setTarget(saved);
+      translatePage(saved, false);
+    }
+    // Stop in-flight work before Astro's client router swaps the page.
+    document.addEventListener('astro:before-swap', cancel);
+    return () => {
+      document.removeEventListener('astro:before-swap', cancel);
+      cancel();
+      for (const promise of translatorsRef.current.values()) {
+        promise.then((t) => t.destroy()).catch(() => {});
+      }
+      translatorsRef.current.clear();
+    };
+  }, [supported, translatePage, cancel]);
+
+  const handleChange = (event: React.ChangeEvent<HTMLSelectElement>) => {
+    const value = event.target.value;
+    setTarget(value);
+    if (value) localStorage.setItem(STORAGE_KEY, value);
+    else localStorage.removeItem(STORAGE_KEY);
+    // The change event carries the user activation needed to download a language pack.
+    translatePage(value, true);
+  };
+
+  const busy = status.kind === 'downloading' || status.kind === 'translating';
+
+  let message = '';
+  switch (status.kind) {
+    case 'downloading':
+      message = `Downloading language pack… ${status.percent}%`;
+      break;
+    case 'translating':
+      message = `Translating… ${Math.round((status.done / status.total) * 100)}%`;
+      break;
+    case 'translated':
+      message = `Translated on your device to ${englishNames.of(status.language)}.`;
+      break;
+    case 'needs-gesture':
+      message = 'Pick the language again to download it.';
+      break;
+    case 'error':
+      message = status.message;
+      break;
+  }
+
+  if (!supported) {
+    return (
+      <div className="flex items-center gap-1 text-gray-400" title="On-device translation isn't supported in this browser.">
+        <LanguageIcon className="w-6 h-6" aria-hidden="true" />
+        <select disabled aria-label="Translate articles (not supported in this browser)" className="text-xs bg-transparent border border-gray-200 rounded py-1 px-1 max-w-28 sm:max-w-none cursor-not-allowed">
+          <option>Translation unavailable</option>
+        </select>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center gap-1 min-w-0">
+      <label htmlFor={selectId} className="text-gray-700 flex items-center" title="Translate articles on your device">
+        <LanguageIcon className="w-6 h-6" aria-hidden="true" />
+        <span className="sr-only">Translate articles to</span>
+      </label>
+      <select
+        id={selectId}
+        value={target}
+        onChange={handleChange}
+        aria-describedby={`${selectId}-status`}
+        aria-busy={busy}
+        className="text-xs text-gray-800 bg-white border border-gray-300 rounded py-1 px-1 max-w-28 sm:max-w-48 hover:border-amber-400 focus-visible:outline-2 focus-visible:outline-amber-400"
+      >
+        <option value="">Original language</option>
+        {LANGUAGE_OPTIONS.map(({ code, label }) => (
+          <option key={code} value={code}>
+            {label}
+          </option>
+        ))}
+      </select>
+      <span
+        id={`${selectId}-status`}
+        role="status"
+        className={`text-xs truncate sr-only md:not-sr-only ${status.kind === 'error' ? 'text-red-700' : 'text-gray-500'}`}
+      >
+        {message}
+      </span>
+      {busy && (
+        <div className="w-4 h-4 border-2 border-amber-400 border-t-transparent rounded-full animate-spin shrink-0" aria-hidden="true" />
+      )}
+    </div>
+  );
+}
