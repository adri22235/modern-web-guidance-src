diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..267bb98
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,331 @@
+/**
+ * On-device page translation built on Chrome's built-in AI APIs
+ * (`Translator` and `LanguageDetector`). Nothing leaves the device: the
+ * browser downloads language packs once and runs translation locally.
+ *
+ * Translatable regions are opted in via the `data-translatable` attribute.
+ * Text nodes inside those regions are translated in place so that inline
+ * markup (links, emphasis, etc.) is preserved, and the original strings are
+ * remembered so the page can be restored without a reload.
+ */
+
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface DownloadProgressEvent extends Event {
+  loaded: number;
+}
+
+interface CreateMonitor extends EventTarget {}
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface TranslatorStatic {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<Availability>;
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal?: AbortSignal;
+    monitor?: (m: CreateMonitor) => void;
+  }): Promise<TranslatorInstance>;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string): Promise<{ detectedLanguage: string; confidence: number }[]>;
+  destroy(): void;
+}
+
+interface LanguageDetectorStatic {
+  availability(): Promise<Availability>;
+  create(options?: { monitor?: (m: CreateMonitor) => void }): Promise<LanguageDetectorInstance>;
+}
+
+declare global {
+  // eslint-disable-next-line no-var
+  var Translator: TranslatorStatic | undefined;
+  // eslint-disable-next-line no-var
+  var LanguageDetector: LanguageDetectorStatic | undefined;
+}
+
+export const TRANSLATABLE_SELECTOR = '[data-translatable]';
+export const STORAGE_KEY = 'devtools-times:translation-language';
+
+/** Languages offered in the picker (BCP 47). */
+export const SUPPORTED_LANGUAGES = [
+  'en', 'es', 'fr', 'de', 'it', 'pt', 'nl', 'pl', 'sv', 'da', 'fi', 'no',
+  'cs', 'ro', 'hu', 'el', 'tr', 'ru', 'uk', 'ar', 'he', 'hi', 'bn', 'id',
+  'vi', 'th', 'ja', 'ko', 'zh', 'zh-Hant',
+] as const;
+
+const RTL_LANGUAGES = new Set(['ar', 'he', 'fa', 'ur']);
+
+export function isTranslationSupported(): boolean {
+  return typeof globalThis !== 'undefined' && typeof globalThis.Translator !== 'undefined';
+}
+
+export function languageLabel(code: string, displayIn = 'en'): string {
+  try {
+    const names = new Intl.DisplayNames([displayIn], { type: 'language' });
+    return names.of(code) ?? code;
+  } catch {
+    return code;
+  }
+}
+
+export function getStoredLanguage(): string | null {
+  try {
+    return localStorage.getItem(STORAGE_KEY);
+  } catch {
+    return null;
+  }
+}
+
+export function setStoredLanguage(lang: string | null) {
+  try {
+    if (lang) localStorage.setItem(STORAGE_KEY, lang);
+    else localStorage.removeItem(STORAGE_KEY);
+  } catch {
+    /* storage unavailable (private mode etc.) */
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Original text bookkeeping
+// ---------------------------------------------------------------------------
+
+const originalText = new WeakMap<Text, string>();
+const originalAttrs = new WeakMap<Element, { lang: string | null; dir: string | null }>();
+
+function collectTextNodes(root: Element): Text[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      if (parent.closest('script, style, code, pre, [translate="no"], [data-no-translate]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      const text = originalText.get(node as Text) ?? node.nodeValue ?? '';
+      return text.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  const nodes: Text[] = [];
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function getRegions(): Element[] {
+  const all = Array.from(document.querySelectorAll(TRANSLATABLE_SELECTOR));
+  // Skip regions nested inside another region; the outer one covers them.
+  return all.filter((el) => !el.parentElement?.closest(TRANSLATABLE_SELECTOR));
+}
+
+/** Restores every translated region to its original text. */
+export function restoreOriginal() {
+  for (const region of getRegions()) {
+    for (const node of collectTextNodes(region)) {
+      const original = originalText.get(node);
+      if (original !== undefined) node.nodeValue = original;
+    }
+    const attrs = originalAttrs.get(region);
+    if (attrs) {
+      attrs.lang === null ? region.removeAttribute('lang') : region.setAttribute('lang', attrs.lang);
+      attrs.dir === null ? region.removeAttribute('dir') : region.setAttribute('dir', attrs.dir);
+      originalAttrs.delete(region);
+    }
+    region.removeAttribute('data-translated');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Translator / detector management
+// ---------------------------------------------------------------------------
+
+const translators = new Map<string, Promise<TranslatorInstance>>();
+let detectorPromise: Promise<LanguageDetectorInstance | null> | null = null;
+
+function getDetector(): Promise<LanguageDetectorInstance | null> {
+  if (!detectorPromise) {
+    detectorPromise = (async () => {
+      const LD = globalThis.LanguageDetector;
+      if (!LD) return null;
+      try {
+        if ((await LD.availability()) === 'unavailable') return null;
+        return await LD.create();
+      } catch {
+        return null;
+      }
+    })();
+  }
+  return detectorPromise;
+}
+
+function baseLanguage(code: string) {
+  return code.split('-')[0].toLowerCase();
+}
+
+function sameLanguage(a: string, b: string) {
+  // zh vs zh-Hant are different scripts, so only treat exact matches or plain
+  // base-language matches (e.g. en vs en-US) as identical.
+  if (a === b) return true;
+  if (baseLanguage(a) === 'zh' || baseLanguage(b) === 'zh') return false;
+  return baseLanguage(a) === baseLanguage(b);
+}
+
+async function detectLanguage(text: string, fallback: string): Promise<string> {
+  const detector = await getDetector();
+  if (!detector) return fallback;
+  try {
+    const [top] = await detector.detect(text.slice(0, 2000));
+    if (top && top.detectedLanguage !== 'und' && top.confidence >= 0.5) {
+      return top.detectedLanguage;
+    }
+  } catch {
+    /* fall through */
+  }
+  return fallback;
+}
+
+export interface ProgressInfo {
+  phase: 'checking' | 'downloading' | 'translating' | 'done';
+  /** 0..1 for downloads and translation progress. */
+  progress?: number;
+  sourceLanguage?: string;
+}
+
+async function getTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onProgress: (info: ProgressInfo) => void,
+  signal: AbortSignal,
+): Promise<TranslatorInstance | null> {
+  const T = globalThis.Translator;
+  if (!T) throw new TranslationError('unsupported');
+
+  const key = `${sourceLanguage}->${targetLanguage}`;
+  const cached = translators.get(key);
+  if (cached) return cached;
+
+  const availability = await T.availability({ sourceLanguage, targetLanguage });
+  if (availability === 'unavailable') return null;
+
+  const promise = T.create({
+    sourceLanguage,
+    targetLanguage,
+    signal,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        onProgress({ phase: 'downloading', progress: (e as DownloadProgressEvent).loaded, sourceLanguage });
+      });
+    },
+  });
+  translators.set(key, promise);
+  promise.catch(() => translators.delete(key));
+  return promise;
+}
+
+export class TranslationError extends Error {
+  constructor(
+    public code: 'unsupported' | 'unavailable' | 'needs-activation' | 'aborted' | 'failed',
+    message?: string,
+  ) {
+    super(message ?? code);
+  }
+}
+
+/** Whether a language pair can be used without a fresh download (and thus without a user gesture). */
+export async function isPairReady(sourceLanguage: string, targetLanguage: string): Promise<boolean> {
+  const T = globalThis.Translator;
+  if (!T) return false;
+  try {
+    return (await T.availability({ sourceLanguage, targetLanguage })) === 'available';
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Translates all `[data-translatable]` regions on the page to `targetLanguage`.
+ * Each region's source language is detected on-device (falling back to the
+ * document language) so mixed-language pages are handled correctly.
+ */
+export async function translatePage(
+  targetLanguage: string,
+  { signal, onProgress }: { signal: AbortSignal; onProgress: (info: ProgressInfo) => void },
+): Promise<{ translated: number; skipped: number }> {
+  if (!isTranslationSupported()) throw new TranslationError('unsupported');
+
+  // Always translate from the original text, never from a previous translation.
+  restoreOriginal();
+
+  const pageLanguage = document.documentElement.lang || 'en';
+  const regions = getRegions();
+  const work = regions.map((region) => ({ region, nodes: collectTextNodes(region) }));
+  const totalNodes = work.reduce((sum, w) => sum + w.nodes.length, 0) || 1;
+
+  let done = 0;
+  let translated = 0;
+  let skipped = 0;
+  onProgress({ phase: 'checking' });
+
+  for (const { region, nodes } of work) {
+    if (signal.aborted) throw new TranslationError('aborted');
+    if (!nodes.length) continue;
+
+    const declared = region.getAttribute('lang') || pageLanguage;
+    const sourceLanguage = await detectLanguage(region.textContent ?? '', declared);
+
+    if (sameLanguage(sourceLanguage, targetLanguage)) {
+      skipped++;
+      done += nodes.length;
+      continue;
+    }
+
+    let translator: TranslatorInstance | null;
+    try {
+      translator = await getTranslator(sourceLanguage, targetLanguage, onProgress, signal);
+    } catch (err) {
+      if (signal.aborted) throw new TranslationError('aborted');
+      if (err instanceof DOMException && err.name === 'NotAllowedError') {
+        throw new TranslationError('needs-activation');
+      }
+      throw new TranslationError('failed', (err as Error)?.message);
+    }
+    if (!translator) {
+      skipped++;
+      done += nodes.length;
+      continue;
+    }
+
+    if (!originalAttrs.has(region)) {
+      originalAttrs.set(region, { lang: region.getAttribute('lang'), dir: region.getAttribute('dir') });
+    }
+    region.setAttribute('lang', targetLanguage);
+    region.setAttribute('dir', RTL_LANGUAGES.has(baseLanguage(targetLanguage)) ? 'rtl' : 'ltr');
+    region.setAttribute('data-translated', '');
+
+    for (const node of nodes) {
+      if (signal.aborted) throw new TranslationError('aborted');
+      if (!originalText.has(node)) originalText.set(node, node.nodeValue ?? '');
+      const original = originalText.get(node)!;
+      const leading = original.match(/^\s*/)?.[0] ?? '';
+      const trailing = original.match(/\s*$/)?.[0] ?? '';
+      try {
+        const result = await translator.translate(original.trim(), { signal });
+        if (signal.aborted) throw new TranslationError('aborted');
+        node.nodeValue = leading + result + trailing;
+      } catch (err) {
+        if (signal.aborted) throw new TranslationError('aborted');
+        // Leave this snippet untranslated but keep going.
+        console.warn('[translate] failed to translate snippet', err);
+      }
+      done++;
+      onProgress({ phase: 'translating', progress: done / totalNodes, sourceLanguage });
+    }
+    translated++;
+  }
+
+  onProgress({ phase: 'done', progress: 1 });
+  return { translated, skipped };
+}
