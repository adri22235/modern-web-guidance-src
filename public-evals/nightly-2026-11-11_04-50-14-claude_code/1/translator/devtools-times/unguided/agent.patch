diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..60c4d6f
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,257 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon, XMarkIcon } from '@heroicons/react/24/outline';
+import {
+  SUPPORTED_LANGUAGES,
+  TranslationError,
+  getStoredLanguage,
+  isPairReady,
+  isTranslationSupported,
+  languageLabel,
+  restoreOriginal,
+  setStoredLanguage,
+  translatePage,
+  type ProgressInfo,
+} from '../utils/translation';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'working'; info: ProgressInfo }
+  | { kind: 'translated'; language: string; skipped: number }
+  | { kind: 'pending-gesture'; language: string }
+  | { kind: 'error'; message: string };
+
+function defaultTargetLanguage(): string {
+  const preferred = typeof navigator !== 'undefined' ? navigator.languages ?? [navigator.language] : [];
+  for (const lang of preferred) {
+    const match = SUPPORTED_LANGUAGES.find((l) => l === lang || l === lang.split('-')[0]);
+    if (match && match !== 'en') return match;
+  }
+  return 'es';
+}
+
+export default function TranslateControl() {
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [open, setOpen] = useState(false);
+  const [target, setTarget] = useState<string>('es');
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const abortRef = useRef<AbortController | null>(null);
+  const containerRef = useRef<HTMLDivElement>(null);
+  const panelId = useId();
+  const selectId = useId();
+
+  const run = useCallback(async (language: string) => {
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+    setStatus({ kind: 'working', info: { phase: 'checking' } });
+    try {
+      const { skipped } = await translatePage(language, {
+        signal: controller.signal,
+        onProgress: (info) => {
+          if (!controller.signal.aborted) setStatus({ kind: 'working', info });
+        },
+      });
+      if (controller.signal.aborted) return;
+      setStoredLanguage(language);
+      setStatus({ kind: 'translated', language, skipped });
+    } catch (err) {
+      if (controller.signal.aborted) return;
+      const code = err instanceof TranslationError ? err.code : 'failed';
+      if (code === 'needs-activation') {
+        restoreOriginal();
+        setStatus({ kind: 'pending-gesture', language });
+        return;
+      }
+      restoreOriginal();
+      setStatus({
+        kind: 'error',
+        message:
+          code === 'unsupported'
+            ? 'On-device translation is not supported in this browser.'
+            : `Couldn't translate to ${languageLabel(language)}. ${err instanceof Error ? err.message : ''}`.trim(),
+      });
+    }
+  }, []);
+
+  const showOriginal = useCallback(() => {
+    abortRef.current?.abort();
+    restoreOriginal();
+    setStoredLanguage(null);
+    setStatus({ kind: 'idle' });
+  }, []);
+
+  // Feature-detect and re-apply the reader's saved language on each page load.
+  useEffect(() => {
+    const isSupported = isTranslationSupported();
+    setSupported(isSupported);
+    const stored = getStoredLanguage();
+    setTarget(stored ?? defaultTargetLanguage());
+    if (!isSupported || !stored) return;
+
+    let cancelled = false;
+    (async () => {
+      const pageLanguage = document.documentElement.lang || 'en';
+      // Creating a translator that still needs a download requires a user
+      // gesture, so only auto-apply when the model is already on-device.
+      if (await isPairReady(pageLanguage, stored)) {
+        if (!cancelled) run(stored);
+      } else if (!cancelled) {
+        setStatus({ kind: 'pending-gesture', language: stored });
+      }
+    })();
+    return () => {
+      cancelled = true;
+      abortRef.current?.abort();
+    };
+  }, [run]);
+
+  // Close the panel on outside click / Escape.
+  useEffect(() => {
+    if (!open) return;
+    const onPointer = (e: PointerEvent) => {
+      if (!containerRef.current?.contains(e.target as Node)) setOpen(false);
+    };
+    const onKey = (e: KeyboardEvent) => e.key === 'Escape' && setOpen(false);
+    document.addEventListener('pointerdown', onPointer);
+    document.addEventListener('keydown', onKey);
+    return () => {
+      document.removeEventListener('pointerdown', onPointer);
+      document.removeEventListener('keydown', onKey);
+    };
+  }, [open]);
+
+  const isWorking = status.kind === 'working';
+  const isTranslated = status.kind === 'translated';
+  const progress = isWorking ? status.info.progress : undefined;
+
+  let statusText = '';
+  switch (status.kind) {
+    case 'working':
+      statusText =
+        status.info.phase === 'downloading'
+          ? `Downloading language model… ${Math.round((progress ?? 0) * 100)}%`
+          : status.info.phase === 'translating'
+            ? `Translating… ${Math.round((progress ?? 0) * 100)}%`
+            : 'Preparing on-device translation…';
+      break;
+    case 'translated':
+      statusText =
+        `Translated to ${languageLabel(status.language)} on your device.` +
+        (status.skipped ? ` ${status.skipped} section(s) were already in that language or unsupported.` : '');
+      break;
+    case 'pending-gesture':
+      statusText = `Click “Translate” to download the ${languageLabel(status.language)} model and continue.`;
+      break;
+    case 'error':
+      statusText = status.message;
+      break;
+  }
+
+  const buttonLabel = isTranslated ? `Translated: ${languageLabel(status.language)}` : 'Translate';
+
+  return (
+    <div ref={containerRef} className="relative" data-no-translate>
+      <button
+        type="button"
+        onClick={() => setOpen((o) => !o)}
+        aria-expanded={open}
+        aria-controls={panelId}
+        aria-label={buttonLabel}
+        title={supported === false ? 'On-device translation requires a browser with the built-in Translator API (e.g. Chrome 138+)' : buttonLabel}
+        className={`p-1 flex items-center gap-1 rounded ${isTranslated ? 'text-amber-600' : 'text-gray-600'} hover:text-amber-400`}
+      >
+        <LanguageIcon className="h-6 w-6" />
+        <span className="hidden sm:inline text-xs font-semibold">
+          {isTranslated ? languageLabel(status.language) : 'Translate'}
+        </span>
+      </button>
+
+      {open && (
+        <div
+          id={panelId}
+          role="dialog"
+          aria-label="Translate articles"
+          className="absolute left-0 top-full mt-2 z-50 w-72 bg-white border border-gray-200 rounded-md shadow-lg p-4 text-sm"
+        >
+          <div className="flex items-start justify-between mb-2">
+            <h2 className="font-semibold text-gray-900">Translate articles</h2>
+            <button type="button" onClick={() => setOpen(false)} aria-label="Close" className="text-gray-400 hover:text-gray-700">
+              <XMarkIcon className="h-5 w-5" />
+            </button>
+          </div>
+
+          {supported === false ? (
+            <p className="text-gray-600">
+              Your browser doesn't support on-device translation. Try a recent version of Chrome on desktop, which ships the
+              built-in Translator API.
+            </p>
+          ) : (
+            <form
+              onSubmit={(e) => {
+                e.preventDefault();
+                run(target);
+              }}
+            >
+              <label htmlFor={selectId} className="block text-gray-600 mb-1">
+                Translate news and teasers into
+              </label>
+              <div className="flex gap-2">
+                <select
+                  id={selectId}
+                  value={target}
+                  onChange={(e) => setTarget(e.target.value)}
+                  disabled={isWorking}
+                  className="flex-1 border border-gray-300 rounded px-2 py-1 bg-white"
+                >
+                  {SUPPORTED_LANGUAGES.map((code) => (
+                    <option key={code} value={code}>
+                      {languageLabel(code)} {languageLabel(code, code) !== languageLabel(code) ? `— ${languageLabel(code, code)}` : ''}
+                    </option>
+                  ))}
+                </select>
+                <button
+                  type="submit"
+                  disabled={isWorking}
+                  className="bg-gray-800 text-white text-xs font-semibold py-1.5 px-3 rounded hover:bg-gray-700 disabled:opacity-50"
+                >
+                  Translate
+                </button>
+              </div>
+
+              {isWorking && (
+                <div className="mt-3 h-1.5 w-full bg-gray-100 rounded overflow-hidden" aria-hidden="true">
+                  <div
+                    className={`h-full bg-amber-400 transition-all ${progress === undefined ? 'animate-pulse w-1/3' : ''}`}
+                    style={progress !== undefined ? { width: `${Math.round(progress * 100)}%` } : undefined}
+                  />
+                </div>
+              )}
+
+              {(isTranslated || isWorking) && (
+                <button
+                  type="button"
+                  onClick={showOriginal}
+                  className="mt-3 text-xs font-semibold text-amber-800 hover:underline"
+                >
+                  {isWorking ? 'Cancel' : 'Show original'}
+                </button>
+              )}
+            </form>
+          )}
+
+          {statusText && (
+            <p className={`mt-3 text-xs ${status.kind === 'error' ? 'text-red-700' : 'text-gray-700'}`}>{statusText}</p>
+          )}
+
+          <p className="mt-3 text-xs text-gray-500">
+            Translation runs entirely in your browser — article text is never sent to a server.
+          </p>
+        </div>
+      )}
+
+      <p role="status" aria-live="polite" className="sr-only">
+        {statusText}
+      </p>
+    </div>
+  );
+}
