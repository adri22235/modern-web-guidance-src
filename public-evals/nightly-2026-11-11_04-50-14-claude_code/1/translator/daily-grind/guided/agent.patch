+  <script type="module">
+    const SOURCE_LANG = 'en';
+    const form = document.getElementById('translate-form');
+    const select = document.getElementById('translate-lang');
+    const button = form.querySelector('button');
+    const progress = document.getElementById('translate-progress');
+    const status = document.getElementById('translate-status');
+    const region = document.getElementById('translatable');
+    const nodes = [...region.querySelectorAll('[data-translate]')];
+    const originals = new Map(nodes.map((el) => [el, el.textContent.trim()]));
+    const translators = new Map(); // target language -> Translator instance
+    const cache = new Map(); // `${lang}\n${text}` -> translated text
+    let requestId = 0;
+
+    const setStatus = (msg) => { status.textContent = msg; };
+
+    function restoreOriginal() {
+      for (const el of nodes) {
+        el.textContent = originals.get(el);
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      }
+    }
+
+    if (!('Translator' in self)) {
+      select.disabled = true;
+      button.disabled = true;
+      setStatus('On-device translation is not supported in this browser. Try a recent desktop version of Chrome or Edge.');
+    }
+
+    async function getTranslator(targetLanguage) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+      const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+      if (availability !== 'available') {
+        progress.value = 0;
+        progress.hidden = false;
+        setStatus('Downloading language pack…');
+      }
+      try {
+        // create() must run within the submit's user activation when a download is needed.
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              progress.value = e.loaded;
+              setStatus(`Downloading language pack… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        translators.set(targetLanguage, translator);
+        return translator;
+      } finally {
+        progress.hidden = true;
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!('Translator' in self)) return;
+      const lang = select.value;
+      const id = ++requestId;
+      const label = select.selectedOptions[0].textContent;
+
+      if (lang === SOURCE_LANG) {
+        restoreOriginal();
+        setStatus('');
+        return;
+      }
+
+      region.setAttribute('aria-busy', 'true');
+      button.disabled = true;
+      try {
+        const translator = await getTranslator(lang);
+        if (id !== requestId) return;
+        if (!translator) {
+          setStatus(`Translation to ${label} isn't available on this device.`);
+          return;
+        }
+        setStatus(`Translating to ${label}…`);
+        const results = await Promise.all(nodes.map(async (el) => {
+          const text = originals.get(el);
+          const key = `${lang}\n${text}`;
+          if (!cache.has(key)) cache.set(key, await translator.translate(text));
+          return cache.get(key);
+        }));
+        if (id !== requestId) return;
+        const dir = new Intl.Locale(lang).getTextInfo?.().direction
+          ?? new Intl.Locale(lang).textInfo?.direction ?? 'ltr';
+        nodes.forEach((el, i) => {
+          el.textContent = results[i];
+          el.lang = lang;
+          el.dir = dir;
+        });
+        setStatus(`Translated on your device to ${label}. Select “English (original)” to restore.`);
+      } catch (err) {
+        if (id !== requestId) return;
+        console.error(err);
+        setStatus(err?.name === 'NotAllowedError'
+          ? 'Please press Translate again to allow the language pack download.'
+          : 'Sorry, something went wrong while translating. Please try again.');
+      } finally {
+        if (id === requestId) {
+          region.removeAttribute('aria-busy');
+          button.disabled = false;
+        }
+      }
+    });
+  </script>
