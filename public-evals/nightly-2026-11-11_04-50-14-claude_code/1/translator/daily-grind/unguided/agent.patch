+      storyTitle: 'Nossa história',
+      storyP1: 'The Daily Grind começou em 2012 como um simples carrinho em frente a uma estação de trem, servindo café para quem saía cedo e precisava de mais do que apenas cafeína.',
+      storyP2: 'Hoje torramos cada grão em pequenos lotes em nossa própria torrefação de bairro, trabalhando diretamente com produtores que compartilham nosso compromisso com qualidade e justiça.',
+      storyP3: 'Cada xícara que servimos é um agradecimento à comunidade que nos tornou quem somos.',
+    },
+    ja: {
+      heroTitle: '五感を目覚めさせよう',
+      heroTagline: 'エシカルに調達し、地元で焙煎し、あなたのカップへ。',
+      orderNow: '今すぐ注文',
+      seasonalTitle: '季節のおすすめ',
+      mapleName: 'メープルオーツラテ',
+      mapleDesc: 'クリーミーなオーツミルクに、バーモント産メープルシロップをほんのり加えて。',
+      espressoName: 'ダークロースト・エスプレッソ',
+      espressoDesc: '力強くスモーキー。朝の目覚めにぴったりです。',
+      coldBrewName: 'コールドブリュー',
+      coldBrewDesc: '18時間かけて抽出した、極上のなめらかさ。',
+      viewDetails: '詳細を見る',
+      storyTitle: '私たちのストーリー',
+      storyP1: 'The Daily Grind は2012年、駅前の小さな屋台から始まりました。カフェイン以上のものを求める早朝の通勤客にコーヒーを届けてきました。',
+      storyP2: '現在は地元の自家焙煎所ですべての豆を少量ずつ焙煎し、品質と公正さへの想いを共有する農家と直接取引しています。',
+      storyP3: '私たちが注ぐ一杯一杯は、今の私たちを育ててくれた地域の皆さんへの感謝の気持ちです。',
+    },
+  };
+
+  const select = document.getElementById('lang-select');
+  const statusEl = document.getElementById('lang-status');
+  const elements = Array.from(document.querySelectorAll('[data-i18n]'));
+  if (!select || elements.length === 0) return;
+
+  // Snapshot original English copy.
+  const originals = new Map(elements.map((el) => [el, el.textContent.trim()]));
+  const supportedLangs = new Set(Array.from(select.options, (o) => o.value));
+
+  const translatorCache = new Map(); // lang -> Promise<Translator>
+  const resultCache = new Map(); // lang -> Map<key, string>
+  let requestId = 0;
+  let statusTimer;
+
+  const hasBuiltInTranslator = 'Translator' in self;
+
+  function showStatus(message, persist = false) {
+    clearTimeout(statusTimer);
+    statusEl.textContent = message;
+    statusEl.classList.add('visible');
+    if (!persist) {
+      statusTimer = setTimeout(() => statusEl.classList.remove('visible'), 2500);
+    }
+  }
+
+  async function getTranslator(lang) {
+    if (!hasBuiltInTranslator) return null;
+    if (!translatorCache.has(lang)) {
+      const pending = (async () => {
+        const opts = { sourceLanguage: SOURCE_LANG, targetLanguage: lang };
+        const availability = await self.Translator.availability(opts);
+        if (availability === 'unavailable') return null;
+        return self.Translator.create({
+          ...opts,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded ?? 0) * 100);
+              showStatus(`Downloading on-device language model… ${pct}%`, pct < 100);
+            });
+          },
+        });
+      })().catch((err) => {
+        console.warn(`[translate] Built-in translator unavailable for ${lang}:`, err);
+        return null;
+      });
+      translatorCache.set(lang, pending);
+    }
+    const translator = await translatorCache.get(lang);
+    if (!translator) translatorCache.delete(lang); // allow retry later
+    return translator;
+  }
+
+  async function translateAll(lang) {
+    if (resultCache.has(lang)) return { strings: resultCache.get(lang), engine: 'cache' };
+
+    const translator = await getTranslator(lang);
+    if (translator) {
+      try {
+        const strings = new Map();
+        // Translate unique keys once (e.g. repeated "View Details").
+        const uniqueKeys = new Map();
+        for (const el of elements) uniqueKeys.set(el.dataset.i18n, originals.get(el));
+        for (const [key, text] of uniqueKeys) {
+          strings.set(key, await translator.translate(text));
+        }
+        resultCache.set(lang, strings);
+        return { strings, engine: 'built-in' };
+      } catch (err) {
+        console.warn('[translate] Built-in translation failed, using bundled copy:', err);
+      }
+    }
+
+    const bundled = BUNDLED[lang];
+    if (!bundled) return null;
+    const strings = new Map(Object.entries(bundled));
+    resultCache.set(lang, strings);
+    return { strings, engine: 'bundled' };
+  }
+
+  function saveLang(lang) {
+    try {
+      localStorage.setItem(STORAGE_KEY, lang);
+    } catch {
+      /* storage may be blocked */
+    }
+  }
+
+  function applyOriginals() {
+    for (const el of elements) el.textContent = originals.get(el);
+  }
+
+  async function setLanguage(lang, { announce = true } = {}) {
+    const id = ++requestId;
+    select.value = lang;
+
+    if (lang === SOURCE_LANG) {
+      applyOriginals();
+      document.documentElement.lang = SOURCE_LANG;
+      saveLang(lang);
+      if (announce) showStatus('Showing original English text');
+      return;
+    }
+
+    document.body.classList.add('translating');
+    select.disabled = true;
+    if (announce) showStatus('Translating on your device…', true);
+
+    try {
+      const result = await translateAll(lang);
+      if (id !== requestId) return; // a newer selection superseded this one
+
+      if (!result) {
+        applyOriginals();
+        showStatus('Sorry, that language is not available on this device.');
+        select.value = SOURCE_LANG;
+        return;
+      }
+
+      for (const el of elements) {
+        const translated = result.strings.get(el.dataset.i18n);
+        el.textContent = translated ?? originals.get(el);
+      }
+      document.documentElement.lang = lang;
+      saveLang(lang);
+
+      if (announce) {
+        const name = select.options[select.selectedIndex].text;
+        showStatus(`Translated to ${name}`);
+      }
+    } finally {
+      if (id === requestId) {
+        document.body.classList.remove('translating');
+        select.disabled = false;
+      }
+    }
+  }
+
+  select.addEventListener('change', () => setLanguage(select.value));
+
+  // Restore a previous choice (without nagging the visitor with a toast).
+  let saved = null;
+  try {
+    saved = localStorage.getItem(STORAGE_KEY);
+  } catch {
+    /* storage may be blocked */
+  }
+  if (saved && saved !== SOURCE_LANG && supportedLangs.has(saved)) {
+    setLanguage(saved, { announce: false });
+  }
+})();
