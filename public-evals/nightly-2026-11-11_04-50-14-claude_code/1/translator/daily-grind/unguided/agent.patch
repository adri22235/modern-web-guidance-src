+      orderNow: 'Jetzt bestellen',
+      seasonalTitle: 'Saisonale Favoriten',
+      mapleName: 'Ahorn-Hafer-Latte',
+      mapleDesc: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      espressoName: 'Espresso dunkle Röstung',
+      espressoDesc: 'Kräftig, rauchig und perfekt für den Energieschub am Morgen.',
+      coldBrewName: 'Cold Brew',
