+      mapleName: "Latte avoine et érable",
+      mapleDesc: "Lait d'avoine onctueux avec une touche de sirop d'érable du Vermont.",
+      espressoName: 'Espresso torréfaction foncée',
+      espressoDesc: 'Corsé, fumé et parfait pour un coup de fouet matinal.',
+      coldBrewName: 'Cold Brew',
