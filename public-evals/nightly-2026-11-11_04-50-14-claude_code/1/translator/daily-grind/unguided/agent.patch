+/*
+ * On-device page translation for The Daily Grind.
+ *
+ * Strategy:
+ *  1. If the browser ships the built-in Translator API (Chrome 138+), use it.
+ *     Models run locally; text never leaves the device.
+ *  2. Otherwise (or if a language pair is unavailable/fails), use the curated
+ *     translations bundled below. These are also fully client-side.
+ *
+ * Elements opt in with `data-i18n="<key>"`. Their original English text is
+ * captured on load and used as the source for every translation.
+ */
+(() => {
+  'use strict';
+
+  const SOURCE_LANG = 'en';
+  const STORAGE_KEY = 'dailygrind.lang';
+
+  const BUNDLED = {
