+    },
+    pt: {
+      heroTitle: 'Desperte seus sentidos',
+      heroTagline: 'De origem ética, torrado localmente, servido na sua xícara.',
+      orderNow: 'Peça agora',
+      seasonalTitle: 'Favoritos da estação',
