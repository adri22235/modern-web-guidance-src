+  <script>
+    (() => {
+      const img = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=400&q=70`;
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', origin: 'Ethiopia', roast: 'Light', notes: 'Floral, bergamot and lemon zest.', img: img('1559056199-641a0ac8b55e') },
+        { id: 'colombia', name: 'Colombia Supremo', origin: 'Colombia', roast: 'Medium', notes: 'Caramel sweetness with a nutty finish.', img: img('1447933601403-0c6688de566e') },
+        { id: 'sumatra', name: 'Sumatra Mandheling', origin: 'Indonesia', roast: 'Dark', notes: 'Earthy, herbal and full-bodied.', img: img('1511537190424-bbbab87ac5eb') },
+        { id: 'guatemala', name: 'Guatemala Antigua', origin: 'Guatemala', roast: 'Medium', notes: 'Cocoa, spice and soft acidity.', img: img('1442512595331-e89e73853f31') },
+        { id: 'kenya', name: 'Kenya AA', origin: 'Kenya', roast: 'Light', notes: 'Blackcurrant, grapefruit and wine-like.', img: img('1610889556528-9a770e32642f') },
+        { id: 'brazil', name: 'Brazil Santos', origin: 'Brazil', roast: 'Medium-Dark', notes: 'Chocolatey, smooth and low acidity.', img: img('1497935586351-b67a49e012bf') },
+        { id: 'costa-rica', name: 'Costa Rica Tarrazú', origin: 'Costa Rica', roast: 'Medium', notes: 'Honey, citrus and a clean finish.', img: img('1587734195503-904fca47e0e9') },
+        { id: 'house', name: 'Daily Grind House Blend', origin: 'Blend', roast: 'Dark', notes: 'Our signature roast: bold and balanced.', img: img('1580933073521-dc49ac0d4e6a') },
+      ];
+      const INITIAL = ['colombia', 'house'];
+
+      const section = document.getElementById('beans');
+      const optionsList = document.getElementById('bean-options');
+      const optionsEmpty = document.getElementById('bean-options-empty');
+      const selectionList = document.getElementById('bean-selection');
+      const emptyMsg = document.getElementById('bean-empty');
+      const countEl = document.getElementById('bean-count');
+
+      // Build each chip and card once and move the same nodes around afterwards,
+      // so the view transition tracks each item by its stable name.
+      const chips = new Map();
+      const cards = new Map();
+
+      for (const bean of BEANS) {
+        const li = document.createElement('li');
+        const chip = document.createElement('button');
+        chip.type = 'button';
+        chip.className = 'bean-chip';
+        chip.dataset.id = bean.id;
+        chip.style.viewTransitionName = `bean-chip-${bean.id}`;
+        chip.innerHTML = '<span aria-hidden="true">+</span>';
+        chip.append(` ${bean.name}`);
+        chip.setAttribute('aria-label', `Add ${bean.name}`);
+        li.append(chip);
+        chips.set(bean.id, li);
+
+        const card = document.createElement('li');
+        card.className = 'bean-card';
+        card.dataset.id = bean.id;
+        card.style.viewTransitionName = `bean-card-${bean.id}`;
+        card.innerHTML = `
+          <img alt="" loading="lazy" width="400" height="300">
+          <div class="bean-card-body">
+            <h4></h4>
+            <span class="bean-meta"></span>
+            <p class="bean-notes"></p>
+            <button type="button" class="bean-remove">Remove</button>
+          </div>`;
+        card.querySelector('img').src = bean.img;
+        card.querySelector('h4').textContent = bean.name;
+        card.querySelector('.bean-meta').textContent = `${bean.origin} · ${bean.roast} roast`;
+        card.querySelector('.bean-notes').textContent = bean.notes;
+        const removeBtn = card.querySelector('.bean-remove');
+        removeBtn.dataset.id = bean.id;
+        removeBtn.setAttribute('aria-label', `Remove ${bean.name}`);
+        cards.set(bean.id, card);
+      }
+
+      const selected = new Set(INITIAL);
+
+      function render() {
+        // Options stay in catalogue order; selection keeps the order beans were added.
+        for (const bean of BEANS) {
+          const chipLi = chips.get(bean.id);
+          if (selected.has(bean.id)) chipLi.remove();
+          else optionsList.append(chipLi);
+        }
+        for (const id of selected) selectionList.append(cards.get(id));
+        for (const [id, card] of cards) if (!selected.has(id)) card.remove();
+
+        emptyMsg.hidden = selected.size > 0;
+        optionsEmpty.hidden = selected.size < BEANS.length;
+        countEl.textContent = `${selected.size} of ${BEANS.length} selected`;
+      }
+
+      // Prefer an element-scoped transition (only this section is captured, the
+      // rest of the page stays live and other transitions can run concurrently).
+      // Fall back to a document transition (made non-blocking via CSS), then to
+      // an instant update.
+      function transition(update) {
+        let t;
+        if ('startViewTransition' in Element.prototype) {
+          t = section.startViewTransition(update);
+        } else if (document.startViewTransition) {
+          t = document.startViewTransition(update);
+        } else {
+          update();
+          return;
+        }
+        // Rapid clicks skip the running transition and reject `ready`.
+        t.ready.catch(() => {});
+      }
+
+      function addBean(id) {
+        const chipLi = chips.get(id);
+        const hadFocus = chipLi.contains(document.activeElement);
+        const nextChip =
+          chipLi.nextElementSibling?.querySelector('button') ??
+          chipLi.previousElementSibling?.querySelector('button');
+
+        transition(() => {
+          selected.add(id);
+          render();
+          if (hadFocus) (nextChip ?? cards.get(id).querySelector('button')).focus();
+        });
+      }
+
+      function removeBean(id) {
+        const card = cards.get(id);
+        const hadFocus = card.contains(document.activeElement);
+        const nextBtn =
+          card.nextElementSibling?.querySelector('button') ??
+          card.previousElementSibling?.querySelector('button');
+
+        transition(() => {
+          selected.delete(id);
+          render();
+          if (hadFocus) (nextBtn ?? chips.get(id).querySelector('button')).focus();
+        });
+      }
+
+      optionsList.addEventListener('click', (e) => {
+        const chip = e.target.closest('.bean-chip');
+        if (chip) addBean(chip.dataset.id);
+      });
+
+      selectionList.addEventListener('click', (e) => {
+        const btn = e.target.closest('.bean-remove');
+        if (btn) removeBean(btn.dataset.id);
+      });
+
+      render();
+    })();
+  </script>
+
