+  <script>
+    (() => {
+      const IMG = (id) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=160&h=160&q=70`;
+      const beans = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral · Citrus · Light roast', price: 18.5, swatch: '#a1887f', img: IMG('photo-1559056199-641a0ac8b55e') },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel · Red apple · Medium', price: 16, swatch: '#8d6e63', img: IMG('photo-1447933601403-0c6688de566e') },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy · Cedar · Dark roast', price: 17, swatch: '#4e342e', img: IMG('photo-1442512595331-e89e73853f31') },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Cocoa · Spice · Medium-dark', price: 17.5, swatch: '#6d4c41', img: IMG('photo-1611854779393-1b2da9d400fe') },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant · Bright · Light', price: 19.5, swatch: '#bcaaa4', img: IMG('photo-1514432324607-a09d9b4aefdd') },
+        { id: 'house', name: 'Daily Grind House Blend', notes: 'Chocolate · Nutty · Medium', price: 14, swatch: '#5d4037', img: IMG('photo-1497935586351-b67a49e012bf') },
+      ];
+      const order = new Map(beans.map((b, i) => [b.id, i]));
+      const selected = new Set(['colombia']);
+
+      const picker = document.getElementById('bean-picker');
+      const availableList = document.getElementById('available-list');
+      const selectedList = document.getElementById('selected-list');
+      const status = document.getElementById('bean-status');
+      const clearBtn = document.getElementById('clear-selection');
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Build one persistent <li> per bean; items are moved, never recreated,
+      // so each keeps its identity across lists for the transition.
+      const nodes = new Map();
+      for (const bean of beans) {
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.dataset.id = bean.id;
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.innerHTML = `
+          <div class="bean-thumb" style="--swatch:${bean.swatch}">
+            <img src="${bean.img}" alt="" loading="lazy" width="56" height="56">
+          </div>
+          <div class="bean-info">
+            <strong>${bean.name}</strong>
+            <span class="bean-meta">${bean.notes}</span>
+          </div>
+          <span class="bean-price">$${bean.price.toFixed(2)}</span>
+          <button type="button" class="bean-action"></button>`;
+        li.querySelector('img').addEventListener('error', (e) => e.target.remove(), { once: true });
+        nodes.set(bean.id, li);
+      }
+
+      const emptyMsg = document.createElement('li');
+      emptyMsg.className = 'bean-empty';
+
+      function render() {
+        const avail = beans.filter((b) => !selected.has(b.id));
+        const sel = [...selected].sort((a, b) => order.get(a) - order.get(b));
+
+        availableList.replaceChildren(...avail.map((b) => nodes.get(b.id)));
+        selectedList.replaceChildren(...sel.map((id) => nodes.get(id)));
+
+        if (!sel.length) {
+          emptyMsg.textContent = 'No beans selected yet — add some from the left.';
+          selectedList.append(emptyMsg);
+        } else if (!avail.length) {
+          emptyMsg.textContent = "You've picked every bean we have!";
+          availableList.append(emptyMsg);
+        }
+
+        for (const [id, li] of nodes) {
+          const btn = li.querySelector('.bean-action');
+          const name = beans[order.get(id)].name;
+          const isSel = selected.has(id);
+          btn.className = `bean-action ${isSel ? 'remove' : 'add'}`;
+          btn.textContent = isSel ? '−' : '+';
+          btn.setAttribute('aria-label', `${isSel ? 'Remove' : 'Add'} ${name}`);
+        }
+
+        document.getElementById('available-count').textContent = `${avail.length} left`;
+        document.getElementById('selected-count').textContent = `${sel.length} chosen`;
+        const total = sel.reduce((sum, id) => sum + beans[order.get(id)].price, 0);
+        document.getElementById('selected-total').textContent = `$${total.toFixed(2)}`;
+        clearBtn.disabled = sel.length === 0;
+      }
+
+      // FLIP fallback using the Web Animations API: animates every item from
+      // its old position to its new one at the same time without blocking input.
+      function flip(update) {
+        const items = [...nodes.values(), emptyMsg];
+        const before = new Map(items.filter((el) => el.isConnected).map((el) => [el, el.getBoundingClientRect()]));
+        update();
+        for (const el of items) {
+          if (!el.isConnected) continue;
+          const now = el.getBoundingClientRect();
+          const prev = before.get(el);
+          const opts = { duration: 450, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' };
+          if (prev) {
+            const dx = prev.left - now.left;
+            const dy = prev.top - now.top;
+            if (dx || dy) el.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], opts);
+          } else {
+            el.animate([{ opacity: 0, transform: 'scale(0.9)' }, { opacity: 1, transform: 'none' }], opts);
+          }
+        }
+      }
+
+      let running = null;
+      function transition(update) {
+        if (reduceMotion.matches) { update(); return Promise.resolve(); }
+        // Skip an in-flight transition so rapid clicks stay responsive.
+        running?.skipTransition?.();
+        if (typeof picker.startViewTransition === 'function') {
+          // Element-scoped view transition: all bean groups animate in
+          // parallel while the rest of the document remains interactive.
+          running = picker.startViewTransition(update);
+          const t = running;
+          t.finished.finally(() => { if (running === t) running = null; });
+          return t.updateCallbackDone.catch(() => {});
+        }
+        flip(update);
+        return Promise.resolve();
+      }
+
+      function toggle(id) {
+        const name = beans[order.get(id)].name;
+        const adding = !selected.has(id);
+        const hadFocus = document.activeElement?.closest?.('.bean-item')?.dataset.id === id;
+        transition(() => {
+          adding ? selected.add(id) : selected.delete(id);
+          render();
+        }).then(() => {
+          // Moving a node drops focus; keep keyboard users on the moved item.
+          if (hadFocus) nodes.get(id).querySelector('.bean-action').focus({ preventScroll: true });
+        });
+        status.textContent = `${name} ${adding ? 'added to' : 'removed from'} your selection.`;
+      }
+
+      picker.addEventListener('click', (e) => {
+        const btn = e.target.closest('.bean-action');
+        if (btn) toggle(btn.closest('.bean-item').dataset.id);
+      });
+
+      clearBtn.addEventListener('click', () => {
+        if (!selected.size) return;
+        transition(() => { selected.clear(); render(); });
+        status.textContent = 'Selection cleared.';
+      });
+
+      render();
+    })();
+  </script>
+
