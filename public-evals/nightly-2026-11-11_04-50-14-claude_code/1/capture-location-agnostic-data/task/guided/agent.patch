+  <script type="module">
+    // Pickup time and anniversary are location-agnostic values: they are modeled
+    // with Temporal.PlainTime / Temporal.PlainDate (no time zone, no offset) and
+    // persisted as plain ISO strings ("08:00", "2021-03-14"). They are never
+    // converted to a Date/instant, so travelling across time zones or DST
+    // changes cannot shift them.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const STORAGE = {
+      pickup: 'dailyGrind.pickupTime',       // Temporal.PlainTime ISO string
+      anniversary: 'dailyGrind.anniversary', // Temporal.PlainDate ISO string
+    };
+
+    const pickupForm = document.getElementById('pickup-form');
+    const pickupInput = document.getElementById('pickup-time');
+    const pickupStatus = document.getElementById('pickup-status');
+    const annivForm = document.getElementById('anniversary-form');
+    const annivInput = document.getElementById('anniversary-date');
+    const annivStatus = document.getElementById('anniversary-status');
+
+    const load = (key, parse) => {
+      const raw = localStorage.getItem(key);
+      if (!raw) return null;
+      try { return parse(raw); } catch { localStorage.removeItem(key); return null; }
+    };
+
+    // ---- Daily pickup reminder (Temporal.PlainTime) ----
+    function renderPickup(time) {
+      if (!time) { pickupStatus.textContent = ''; return; }
+      pickupInput.value = time.toString({ smallestUnit: 'minute' });
+      const label = time.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+      pickupStatus.textContent = `Reminder set for ${label} every day.`;
+    }
+
+    pickupForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!pickupInput.value) return;
+      const time = Temporal.PlainTime.from(pickupInput.value);
+      localStorage.setItem(STORAGE.pickup, time.toString({ smallestUnit: 'minute' }));
+      renderPickup(time);
+    });
+
+    // ---- Coffee anniversary (Temporal.PlainDate) ----
+    function renderAnniversary(date) {
+      if (!date) { annivStatus.textContent = ''; return; }
+      annivInput.value = date.toString();
+      const today = Temporal.Now.plainDateISO();
+      const label = date.toLocaleString(undefined, { dateStyle: 'long' });
+
+      if (Temporal.PlainDate.compare(date, today) > 0) {
+        const days = today.until(date, { largestUnit: 'day' }).days;
+        annivStatus.textContent = `Saved: ${label}. Your coffee story begins in ${days} day${days === 1 ? '' : 's'}.`;
+        return;
+      }
+
+      // Recurring annual date: convert the month/day to this year's PlainDate
+      // (Feb 29 is constrained to Feb 28 in non-leap years), rolling to next
+      // year if it has already passed.
+      const monthDay = date.toPlainMonthDay();
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+      const years = next.year - date.year;
+      const days = today.until(next, { largestUnit: 'day' }).days;
+      annivStatus.textContent = days === 0
+        ? `Happy ${ordinal(years)} coffee anniversary! ☕`
+        : `Saved: ${label}. Your ${ordinal(years)} anniversary is in ${days} day${days === 1 ? '' : 's'}.`;
+    }
+
+    const pr = new Intl.PluralRules('en', { type: 'ordinal' });
+    const suffix = { one: 'st', two: 'nd', few: 'rd', other: 'th' };
+    const ordinal = (n) => `${n}${suffix[pr.select(n)]}`;
+
+    annivForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!annivInput.value) return;
+      const date = Temporal.PlainDate.from(annivInput.value);
+      localStorage.setItem(STORAGE.anniversary, date.toString());
+      renderAnniversary(date);
+    });
+
+    renderPickup(load(STORAGE.pickup, (s) => Temporal.PlainTime.from(s)));
+    renderAnniversary(load(STORAGE.anniversary, (s) => Temporal.PlainDate.from(s)));
+  </script>
+
