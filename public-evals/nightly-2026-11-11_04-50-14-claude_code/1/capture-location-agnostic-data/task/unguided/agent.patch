+  <script>
+    (function () {
+      // Both values are stored as "floating" wall-clock strings ("HH:MM" and
+      // "YYYY-MM-DD") and never converted to timestamps, so a change of time
+      // zone (travel, DST) can never shift what the user picked.
+      var KEY = 'dailyGrind.prefs';
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+      var MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July',
+        'August', 'September', 'October', 'November', 'December'];
+
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('anniversary-date');
+      var timeOut = document.getElementById('pickup-display');
+      var dateOut = document.getElementById('anniversary-display');
+
+      function load() {
+        try {
+          var data = JSON.parse(localStorage.getItem(KEY)) || {};
+          return {
+            pickupTime: TIME_RE.test(data.pickupTime) ? data.pickupTime : '',
+            anniversaryDate: parseDate(data.anniversaryDate) ? data.anniversaryDate : ''
+          };
+        } catch (e) {
+          return { pickupTime: '', anniversaryDate: '' };
+        }
+      }
+
+      function save(prefs) {
+        try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch (e) { /* storage unavailable */ }
+      }
+
+      // Parse "YYYY-MM-DD" into plain components; rejects impossible dates.
+      function parseDate(str) {
+        var m = DATE_RE.exec(str || '');
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth(y, mo)) return null;
+        return { y: y, m: mo, d: d };
+      }
+
+      function daysInMonth(y, m) {
+        return [31, (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0 ? 29 : 28,
+          31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1];
+      }
+
+      function formatTime(str) {
+        var m = TIME_RE.exec(str);
+        var h = +m[1];
+        return (h % 12 || 12) + ':' + m[2] + ' ' + (h < 12 ? 'AM' : 'PM');
+      }
+
+      // Today's calendar date on the device's current wall clock.
+      function today() {
+        var n = new Date();
+        return { y: n.getFullYear(), m: n.getMonth() + 1, d: n.getDate() };
+      }
+
+      // Day number for pure calendar arithmetic (UTC math, no zone involved).
+      function dayNum(c) {
+        return Math.round(Date.UTC(c.y, c.m - 1, c.d) / 86400000);
+      }
+
+      // Anniversary in a given year; Feb 29 falls back to Feb 28 in non-leap years.
+      function anniversaryIn(year, c) {
+        return { y: year, m: c.m, d: Math.min(c.d, daysInMonth(year, c.m)) };
+      }
+
+      function describeAnniversary(str) {
+        var c = parseDate(str);
+        var label = MONTHS[c.m - 1] + ' ' + c.d + ', ' + c.y;
+        var t = today();
+        var tn = dayNum(t);
+        if (dayNum(c) > tn) return label + ' — coming up!';
+        var next = anniversaryIn(t.y, c);
+        if (dayNum(next) < tn) next = anniversaryIn(t.y + 1, c);
+        var years = next.y - c.y;
+        var days = dayNum(next) - tn;
+        if (days === 0) {
+          return label + (years > 0 ? ' — Happy ' + years + '-year coffee anniversary! ☕' : ' — that\'s today! ☕');
+        }
+        return label + ' — ' + years + '-year anniversary in ' + days + ' day' + (days === 1 ? '' : 's');
+      }
+
+      function render(prefs) {
+        timeInput.value = prefs.pickupTime;
+        dateInput.value = prefs.anniversaryDate;
+        timeOut.textContent = prefs.pickupTime
+          ? 'Reminder every day at ' + formatTime(prefs.pickupTime) + ' (local time)'
+          : 'No reminder set';
+        dateOut.textContent = prefs.anniversaryDate
+          ? describeAnniversary(prefs.anniversaryDate)
+          : 'No anniversary set';
+      }
+
+      var prefs = load();
+      render(prefs);
+
+      function update() {
+        prefs = {
+          pickupTime: TIME_RE.test(timeInput.value) ? timeInput.value : '',
+          anniversaryDate: parseDate(dateInput.value) ? dateInput.value : ''
+        };
+        save(prefs);
+        render(prefs);
+      }
+
+      timeInput.addEventListener('change', update);
+      dateInput.addEventListener('change', update);
+      document.getElementById('prefs-clear').addEventListener('click', function () {
+        timeInput.value = '';
+        dateInput.value = '';
+        update();
+      });
+
+      // Daily reminder: compares the device's current wall clock against the
+      // stored "HH:MM", so it fires at the chosen local time in any zone.
+      var lastFired = null;
+      setInterval(function () {
+        if (!prefs.pickupTime) return;
+        var n = new Date();
+        var hhmm = String(n.getHours()).padStart(2, '0') + ':' + String(n.getMinutes()).padStart(2, '0');
+        var t = today();
+        var stamp = t.y + '-' + t.m + '-' + t.d;
+        if (hhmm === prefs.pickupTime && lastFired !== stamp) {
+          lastFired = stamp;
+          render(prefs);
+          if ('Notification' in window && Notification.permission === 'granted') {
+            new Notification('The Daily Grind', { body: 'Time to pick up your coffee! ☕' });
+          } else {
+            timeOut.textContent = '☕ It\'s pickup time! (' + formatTime(prefs.pickupTime) + ')';
+          }
+        }
+      }, 15000);
+
+      timeInput.addEventListener('change', function () {
+        if (timeInput.value && 'Notification' in window && Notification.permission === 'default') {
+          Notification.requestPermission();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
