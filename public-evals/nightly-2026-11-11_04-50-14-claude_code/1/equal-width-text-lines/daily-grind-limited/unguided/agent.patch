+  <script>
+    // Fit each lockup line's font-size so its text spans exactly the lockup width.
+    // Spacing is untouched; only the glyph size changes per line.
+    (function () {
+      var lockups = document.querySelectorAll('.lockup');
+      if (!lockups.length) return;
+
+      var REF = 100; // reference font-size in px used for measuring
+
+      function fit(lockup) {
+        var target = lockup.clientWidth;
+        if (!target) return;
+        lockup.querySelectorAll('.lockup__line').forEach(function (line) {
+          var text = line.querySelector('.lockup__text') || line;
+          line.style.fontSize = REF + 'px';
+          var measured = text.getBoundingClientRect().width;
+          if (measured > 0) {
+            line.style.fontSize = (REF * target / measured) + 'px';
+          }
+        });
+      }
+
+      function fitAll() { lockups.forEach(fit); }
+
+      fitAll();
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitAll);
+      }
+      if ('ResizeObserver' in window) {
+        var ro = new ResizeObserver(fitAll);
+        lockups.forEach(function (l) { ro.observe(l); });
+      } else {
+        window.addEventListener('resize', fitAll);
+      }
+    })();
+  </script>
+
