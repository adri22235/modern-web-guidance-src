+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    /* 1) Featured barista: image masked by an organic paint splat.
+       The SVG mask uses objectBoundingBox units, so it scales with the
+       image's rendered width and height. */
+    .barista-feature {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 32px;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(300px, 80vw);
+      height: auto;
+      aspect-ratio: 1;
+      object-fit: cover;
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    /* Fallback: plain rounded image if masking is unsupported */
+    @supports (not (mask-image: url(#x))) and (not (-webkit-mask-image: url(#x))) {
+      .shaped-avatar {
+        border-radius: 50%;
+      }
+    }
+
+    .barista-bio {
+      max-width: 420px;
+    }
+
+    .barista-bio h3 {
+      color: var(--primary);
+      font-size: 1.5rem;
+    }
+
+    .barista-bio .role {
+      color: #8d6e63;
+      font-weight: 600;
+      margin-bottom: 10px;
+    }
+
+    /* 2) Loyalty banner: unmasked text block + masked decorative accent */
+    .unified-card {
+      display: flex;
+      max-width: 640px;
+      margin: 0 auto;
+      /* drop-shadow follows the combined silhouette, including the cutout */
+      filter: drop-shadow(0 10px 20px rgba(62, 39, 35, 0.35));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: white;
+      padding: 28px;
+      border-top-left-radius: 16px;
+      border-bottom-left-radius: 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .card-body .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .card-body .btn:hover {
+      background: #ffc171;
+    }
+
+    .card-accent {
+      flex: 0 0 80px;
+      background-color: var(--primary);
+      border-top-right-radius: 16px;
+      border-bottom-right-radius: 16px;
+      -webkit-mask-image: url(#accent-curve-mask);
+      mask-image: url(#accent-curve-mask);
+    }
+
+    /* 3) Promo card: circular notch on the top edge via a gradient mask */
+    .gradient-masked-card {
+      max-width: 420px;
+      margin: 0 auto;
+      background: linear-gradient(135deg, var(--accent), #e65100);
+      color: var(--text);
+      padding: 48px 24px 28px;
+      border-radius: 16px;
+      text-align: center;
+      -webkit-mask-image: radial-gradient(circle at 50% 0, transparent 24px, #000 25px);
+      mask-image: radial-gradient(circle at 50% 0, transparent 24px, #000 25px);
+    }
+
+    .gradient-masked-card h3 {
+      font-size: 1.4rem;
+      margin-bottom: 8px;
+    }
+
+    .gradient-masked-card .promo-code {
+      display: inline-block;
+      margin-top: 12px;
+      padding: 4px 14px;
+      border: 2px dashed var(--text);
+      border-radius: 6px;
+      font-weight: 700;
+      letter-spacing: 2px;
+    }
   </style>
