     .btn:hover {
       background: #3e2723;
     }
 
+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-section h2 {
+      text-align: center;
+      margin-bottom: 24px;
+    }
+
+    .barista-feature {
+      display: flex;
+      align-items: center;
+      gap: 32px;
+      flex-wrap: wrap;
+      justify-content: center;
+    }
+
+    .barista-feature .barista-copy {
+      flex: 1 1 280px;
+      max-width: 480px;
+    }
+
+    .barista-feature h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    /* 1) Organic paint-splat crop. The clipPath uses objectBoundingBox units,
+       so the shape scales with whatever size the image is rendered at. */
+    .shaped-avatar {
+      display: block;
+      width: min(320px, 80vw);
+      aspect-ratio: 1 / 1;
+      object-fit: cover;
+      -webkit-clip-path: url(#paint-splat);
+      clip-path: url(#paint-splat);
+    }
+
+    /* Hidden SVG holding clip definitions (not display:none, which can break
+       url() references in some browsers). */
+    .svg-defs {
+      position: absolute;
+      width: 0;
+      height: 0;
+      overflow: hidden;
+    }
+
+    /* 2) Unified loyalty banner: drop-shadow on the parent traces the
+       combined silhouette of both children, including the masked cutout. */
+    .unified-card {
+      display: flex;
+      align-items: stretch;
+      max-width: 760px;
+      margin: 0 auto;
+      filter: drop-shadow(0 8px 16px rgba(62, 39, 35, 0.25)) drop-shadow(0 2px 4px rgba(62, 39, 35, 0.15));
+    }
+
+    .unified-card .card-body {
+      flex: 1 1 auto;
+      background: white;
+      padding: 28px 32px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .unified-card .card-body h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .unified-card .card-accent {
+      flex: 0 0 140px;
+      background: linear-gradient(135deg, var(--accent), #ff8f00);
+      border-radius: 0 16px 16px 0;
+      /* Concave curved bite out of the outer (right) side */
+      -webkit-mask-image: radial-gradient(circle at 100% 50%, transparent 46px, #000 47px);
+      mask-image: radial-gradient(circle at 100% 50%, transparent 46px, #000 47px);
+    }
+
+    /* 3) Promo card with a circular notch on its top edge via a gradient mask.
+       The shadow lives on the wrapper, since filters on the masked element
+       itself are clipped away by its own mask. */
+    .promo-wrap {
+      max-width: 420px;
+      margin: 0 auto;
+      filter: drop-shadow(0 8px 14px rgba(62, 39, 35, 0.22));
+    }
+
+    .gradient-masked-card {
+      --notch: 30px;
+      background: var(--primary);
+      color: white;
+      text-align: center;
+      padding: calc(var(--notch) + 24px) 28px 28px;
+      border-radius: 14px;
+      -webkit-mask-image: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+      mask-image: radial-gradient(circle var(--notch) at 50% 0, transparent 98%, #000 100%);
+    }
+
+    .gradient-masked-card h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .gradient-masked-card .btn {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    @media (max-width: 600px) {
+      .unified-card .card-accent {
+        flex-basis: 80px;
+      }
+    }
+
