+  <script>
+    (() => {
+      const ADDON_OPTIONS = [
+        'Extra shot', 'Oat milk', 'Almond milk', 'Vanilla syrup', 'Caramel drizzle',
+        'Cinnamon', 'Sweet cream', 'Whipped cream', 'Pumpkin spice',
+      ];
+
+      const grid = document.getElementById('seasonal-grid');
+      const status = document.getElementById('favorites-status');
+      const resetBtn = document.getElementById('reset-favorites');
+      const emptyMsg = document.getElementById('favorites-empty');
+
+      // Remember original nodes (identity matters for match-element) so reset can restore them.
+      const originalSlots = Array.from(grid.children);
+      const originalAddons = new Map(
+        originalSlots.map((slot) => [slot, Array.from(slot.querySelectorAll('.addon'))]),
+      );
+
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+      const canMoveBefore = 'moveBefore' in Element.prototype;
+
+      // Run a DOM update as a view transition scoped to `scopeEl` only. The rest of the page
+      // (sticky nav included) stays interactive, and separate scopes animate concurrently.
+      function scopedTransition(scopeEl, update) {
+        if (!supportsScoped) {
+          update();
+          return;
+        }
+        const t = scopeEl.startViewTransition(update);
+        // Rapid re-triggers on the same scope skip the in-flight transition and reject `ready`.
+        t.ready.catch(() => {});
+      }
+
+      // Move an existing node (preserving identity and, where supported, focus/state).
+      function moveNode(parent, node, before) {
+        if (canMoveBefore) parent.moveBefore(node, before);
+        else parent.insertBefore(node, before);
+      }
+
+      const nameOf = (slot) => slot.querySelector('h3').textContent.trim();
+      const announce = (msg) => { status.textContent = msg; };
+
+      function addonLabel(chip) {
+        return chip.querySelector('span').textContent.trim();
+      }
+
+      function createAddon(label, drinkName) {
+        const li = document.createElement('li');
+        li.className = 'addon';
+        const span = document.createElement('span');
+        span.textContent = label;
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        btn.dataset.action = 'remove-addon';
+        btn.setAttribute('aria-label', `Remove ${label} from ${drinkName}`);
+        btn.innerHTML = '&times;';
+        li.append(span, btn);
+        return li;
+      }
+
+      // Keep each card's <select> in sync with the add-ons it doesn't have yet.
+      function refreshAddonForm(card) {
+        const select = card.querySelector('.addon-form select');
+        const addBtn = card.querySelector('[data-action="add-addon"]');
+        const chosen = new Set(Array.from(card.querySelectorAll('.addon'), addonLabel));
+        const remaining = ADDON_OPTIONS.filter((o) => !chosen.has(o));
+        const previous = select.value;
+        select.replaceChildren(...remaining.map((o) => new Option(o, o)));
+        if (remaining.includes(previous)) select.value = previous;
+        if (!remaining.length) select.append(new Option('All add-ons selected', ''));
+        select.disabled = addBtn.disabled = remaining.length === 0;
+      }
+
+      // Disable the move buttons at the ends, keeping focus on a usable control.
+      function refreshGridControls() {
+        const slots = Array.from(grid.children);
+        slots.forEach((slot, i) => {
+          const prev = slot.querySelector('[data-action="move-prev"]');
+          const next = slot.querySelector('[data-action="move-next"]');
+          const atStart = i === 0;
+          const atEnd = i === slots.length - 1;
+          if (atStart && document.activeElement === prev) (atEnd ? slot.querySelector('[data-action="remove-card"]') : next).focus();
+          if (atEnd && document.activeElement === next) (atStart ? slot.querySelector('[data-action="remove-card"]') : prev).focus();
+          prev.disabled = atStart;
+          next.disabled = atEnd;
+        });
+        emptyMsg.hidden = slots.length > 0;
+      }
+
+      function moveCard(slot, direction) {
+        const target = direction < 0 ? slot.previousElementSibling : slot.nextElementSibling;
+        if (!target) return;
+        const trigger = document.activeElement;
+        // The update callback runs asynchronously, so compute announcement data up front.
+        const pos = Array.from(grid.children).indexOf(slot) + 1 + direction;
+        scopedTransition(grid, () => {
+          moveNode(grid, slot, direction < 0 ? target : target.nextElementSibling);
+          refreshGridControls();
+          // insertBefore fallback drops focus from the moved subtree; restore it.
+          if (trigger && document.activeElement !== trigger && !trigger.disabled) trigger.focus();
+        });
+        announce(`${nameOf(slot)} moved to position ${pos} of ${grid.children.length}.`);
+      }
+
+      function removeCard(slot) {
+        const name = nameOf(slot);
+        const hadFocus = slot.contains(document.activeElement);
+        const neighbor = slot.nextElementSibling ?? slot.previousElementSibling;
+        const remaining = grid.children.length - 1;
+        scopedTransition(grid, () => {
+          slot.remove();
+          refreshGridControls();
+          if (hadFocus) (neighbor?.querySelector('[data-action="remove-card"]') ?? resetBtn).focus();
+        });
+        announce(`${name} removed. ${remaining} favorites remaining.`);
+      }
+
+      function addAddon(card) {
+        const select = card.querySelector('.addon-form select');
+        const label = select.value;
+        if (!label) return;
+        const list = card.querySelector('.addons');
+        const drink = card.querySelector('h3').textContent.trim();
+        scopedTransition(card, () => {
+          list.append(createAddon(label, drink));
+          refreshAddonForm(card);
+          if (select.disabled) card.querySelector('.addon:last-child button').focus();
+        });
+        announce(`${label} added to ${drink}.`);
+      }
+
+      function removeAddon(card, chip) {
+        const label = addonLabel(chip);
+        const drink = card.querySelector('h3').textContent.trim();
+        const hadFocus = chip.contains(document.activeElement);
+        const neighbor = chip.nextElementSibling ?? chip.previousElementSibling;
+        scopedTransition(card, () => {
+          chip.remove();
+          refreshAddonForm(card);
+          if (hadFocus) (neighbor?.querySelector('button') ?? card.querySelector('.addon-form select')).focus();
+        });
+        announce(`${label} removed from ${drink}.`);
+      }
+
+      function resetFavorites() {
+        // Each card animates its own add-on changes (concurrently with the grid)...
+        for (const slot of originalSlots) {
+          const card = slot.querySelector('.card');
+          const list = card.querySelector('.addons');
+          const wanted = originalAddons.get(slot);
+          const current = Array.from(list.children);
+          const same = current.length === wanted.length && current.every((c, i) => c === wanted[i]);
+          if (same || !slot.isConnected) {
+            list.replaceChildren(...wanted);
+            refreshAddonForm(card);
+          } else {
+            scopedTransition(card, () => {
+              list.replaceChildren(...wanted);
+              refreshAddonForm(card);
+            });
+          }
+        }
+        // ...while the grid restores removed cards and the original order.
+        scopedTransition(grid, () => {
+          for (const slot of originalSlots) moveNode(grid, slot, null);
+          refreshGridControls();
+        });
+        announce(`Favorites reset. ${originalSlots.length} favorites shown.`);
+      }
+
+      grid.addEventListener('click', (event) => {
+        const btn = event.target.closest('button[data-action]');
+        if (!btn || btn.disabled) return;
+        const slot = btn.closest('.card-slot');
+        const card = slot.querySelector('.card');
+        switch (btn.dataset.action) {
+          case 'move-prev': moveCard(slot, -1); break;
+          case 'move-next': moveCard(slot, 1); break;
+          case 'remove-card': removeCard(slot); break;
+          case 'add-addon': addAddon(card); break;
+          case 'remove-addon': removeAddon(card, btn.closest('.addon')); break;
+        }
+      });
+
+      resetBtn.addEventListener('click', resetFavorites);
+
+      originalSlots.forEach((slot) => refreshAddonForm(slot.querySelector('.card')));
+      refreshGridControls();
+    })();
+  </script>
+
