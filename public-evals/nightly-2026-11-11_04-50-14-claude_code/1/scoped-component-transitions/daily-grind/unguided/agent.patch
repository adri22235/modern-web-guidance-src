+        const current = liveItems(grid, ':scope > .drink-card').map((el) => el.dataset.id);
+        if (current.join() !== state.order.join()) {
+          for (const id of state.order) grid.appendChild(cards.get(id) || createCard(id));
+        }
+        state.order.forEach((id, i) => {
+          const el = cards.get(id);
+          el.querySelector('[data-dir="-1"]').disabled = i === 0;
+          el.querySelector('[data-dir="1"]').disabled = i === state.order.length - 1;
+        });
+
+        const removed = DEFAULT_ORDER.length - state.order.length;
+        restoreBtn.hidden = removed === 0;
+        restoreBtn.textContent = `Restore removed (${removed})`;
+        emptyMsg.hidden = state.order.length > 0;
+      }
+
+      // ---------- Actions ----------
+      const keepFocus = (el) => { if (el && el.isConnected && document.activeElement !== el) el.focus({ preventScroll: true }); };
+
+      function gridChange(mutate, afterUpdate) {
+        return scopedTransition(grid, ':scope > .drink-card', (mode) => {
+          mutate();
+          syncGrid(mode);
+          save();
+          if (afterUpdate) afterUpdate();
+        });
+      }
+
+      // Per-card counter so overlapping transitions on the same card don't clear
+      // the "vt-local" naming class while a newer one is still running.
+      const localCount = new WeakMap();
+      function cardChange(id, mutate) {
+        const card = cards.get(id);
+        const focused = document.activeElement;
+        localCount.set(card, (localCount.get(card) || 0) + 1);
+        card.classList.add('vt-local');
+        return scopedTransition(card, '[data-flip]', (mode) => {
+          mutate(state.custom[id]);
+          syncCard(id, mode);
+          save();
+          keepFocus(focused && focused.isConnected ? focused : card.querySelector('input[data-opt]'));
+        }).finally(() => {
+          const n = localCount.get(card) - 1;
+          localCount.set(card, n);
+          if (n === 0) card.classList.remove('vt-local');
+        });
+      }
+
+      function moveCard(id, dir) {
+        const i = state.order.indexOf(id);
+        const j = i + dir;
+        if (i < 0 || j < 0 || j >= state.order.length) return;
+        const btn = document.activeElement;
+        gridChange(() => {
+          [state.order[i], state.order[j]] = [state.order[j], state.order[i]];
+        }, () => {
+          const card = cards.get(id);
+          const target = btn && card.contains(btn) && !btn.disabled ? btn : card.querySelector('[data-action="move"]:not(:disabled)');
+          keepFocus(target);
+        });
+        announce(`${DRINKS[id].name} moved to position ${j + 1} of ${state.order.length}.`);
+      }
+
+      function removeCard(id) {
+        const i = state.order.indexOf(id);
+        if (i < 0) return;
+        gridChange(() => { state.order.splice(i, 1); }, () => {
+          const nextId = state.order[i] || state.order[i - 1];
+          keepFocus(nextId ? cards.get(nextId).querySelector('[data-action="remove"]') : emptyMsg.querySelector('button'));
+        });
+        announce(`${DRINKS[id].name} removed. Use "Restore removed" to bring it back.`);
+      }
+
+      function restoreAll() {
+        gridChange(() => {
+          for (const id of DEFAULT_ORDER) if (!state.order.includes(id)) state.order.push(id);
+        }, () => { if (!grid.contains(document.activeElement)) keepFocus(resetBtn); });
+        announce('Removed drinks restored.');
+      }
+
+      function resetAll() {
+        const fresh = defaultState();
+        gridChange(() => { state.order = fresh.order; }, () => keepFocus(resetBtn));
+        // Each card resets in its own scoped transition, concurrently with the grid.
+        for (const id of DEFAULT_ORDER) {
+          const c = state.custom[id];
+          const f = fresh.custom[id];
+          if (c.size === f.size && c.milk === f.milk && c.extras.join() === f.extras.join()) continue;
+          if (cards.has(id)) cardChange(id, (cc) => Object.assign(cc, f));
+          else state.custom[id] = f;
+        }
+        save();
+        announce('Seasonal favorites reset.');
+      }
+
+      // ---------- Events ----------
+      grid.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-action]');
+        if (!btn || !grid.contains(btn)) return;
+        const card = btn.closest('.drink-card');
+        if (!card || card.classList.contains('is-exiting')) return;
+        const id = card.dataset.id;
+        const action = btn.dataset.action;
+        if (action === 'move') moveCard(id, Number(btn.dataset.dir));
+        else if (action === 'remove') removeCard(id);
+        else if (action === 'drop-mod') {
+          const key = btn.dataset.key;
+          const label = btn.previousElementSibling ? btn.previousElementSibling.textContent : 'Option';
+          cardChange(id, (c) => {
+            if (key === 'milk') c.milk = DRINKS[id].milk;
+            else if (key.startsWith('extra-')) c.extras = c.extras.filter((k) => k !== key.slice(6));
+          });
+          announce(`${label} removed from ${DRINKS[id].name}.`);
+        }
+      });
+
+      grid.addEventListener('change', (e) => {
+        const input = e.target.closest('input[data-opt]');
+        if (!input) return;
+        const card = input.closest('.drink-card');
+        const id = card.dataset.id;
+        const type = input.dataset.opt;
+        const value = input.value;
+        const checked = input.checked;
+        // Restore the pre-change UI so the transition's "old" snapshot is accurate.
+        syncCard(id, 'none');
+        cardChange(id, (c) => {
+          if (type === 'extra') {
+            const set = new Set(c.extras);
+            checked ? set.add(value) : set.delete(value);
+            c.extras = EXTRAS.map((x) => x.key).filter((k) => set.has(k));
+          } else {
+            c[type] = value;
+          }
+          const label = byKey(type === 'size' ? SIZES : type === 'milk' ? MILKS : EXTRAS, value).label;
+          announce(`${DRINKS[id].name}: ${label}${type === 'extra' ? (checked ? ' added' : ' removed') : ' selected'}. Now ${money.format(priceFor(id))}.`);
+        });
+      });
+
+      restoreBtn.addEventListener('click', restoreAll);
+      emptyMsg.querySelector('[data-restore]').addEventListener('click', restoreAll);
+      resetBtn.addEventListener('click', resetAll);
+
+      // ---------- Initial render ----------
+      grid.textContent = '';
+      syncGrid('none');
+    })();
+  </script>
+
 </body>
 
 </html>
