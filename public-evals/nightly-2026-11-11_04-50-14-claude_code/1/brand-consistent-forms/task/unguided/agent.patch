+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('sub-progress');
+      const progressText = document.getElementById('sub-progress-text');
+      const progressSteps = document.getElementById('sub-progress-steps');
+      const submit = document.getElementById('sub-submit');
+      const status = document.getElementById('sub-status');
+      const name = document.getElementById('sub-name');
+      const email = document.getElementById('sub-email');
+      const grind = document.getElementById('sub-grind');
+      const roast = document.getElementById('sub-roast');
+      const roastValue = document.getElementById('sub-roast-value');
+      const roastLabels = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastTouched = false;
+
+      function updateRoast() {
+        const label = roastLabels[roast.value - 1];
+        roastValue.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      function updateProgress() {
+        const steps = [
+          name.value.trim().length > 0,
+          email.value.trim().length > 0 && email.checkValidity(),
+          grind.value !== '',
+          roastTouched,
+          !!form.querySelector('input[name="frequency"]:checked')
+        ];
+        const done = steps.filter(Boolean).length;
+        const pct = Math.round((done / steps.length) * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progressText.textContent = pct + '%';
+        progressSteps.textContent = done + ' of ' + steps.length + ' steps complete';
+        submit.disabled = done !== steps.length;
+      }
+
+      roast.addEventListener('input', function () {
+        roastTouched = true;
+        updateRoast();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!form.checkValidity()) {
+          status.textContent = 'Please complete all required fields.';
+          return;
+        }
+        const freq = form.querySelector('input[name="frequency"]:checked');
+        const freqLabel = document.querySelector('label[for="' + freq.id + '"]').textContent;
+        status.textContent = 'Thanks, ' + name.value.trim() + '! Your ' +
+          roastLabels[roast.value - 1].toLowerCase() + ' roast will ship ' +
+          freqLabel.toLowerCase() + '.';
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
 </body>
 
