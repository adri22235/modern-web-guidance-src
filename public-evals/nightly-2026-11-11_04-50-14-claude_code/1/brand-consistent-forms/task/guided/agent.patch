+  <script>
+    (() => {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('setup-progress-text');
+      const nameInput = document.getElementById('sub-name');
+      const emailInput = document.getElementById('sub-email');
+      const roast = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const status = document.getElementById('form-status');
+      const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastChosen = false;
+
+      const updateRoast = () => {
+        const label = roastNames[roast.value - 1];
+        roastOutput.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        // Drives the track fill in the no-accent-color fallback
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', `${pct}%`);
+      };
+
+      const updateProgress = () => {
+        const steps = [
+          nameInput.value.trim() !== '',
+          emailInput.value.trim() !== '' && emailInput.validity.valid,
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastChosen,
+        ];
+        const done = steps.filter(Boolean).length;
+        const pct = Math.round((done / steps.length) * 100);
+        progress.value = done;
+        progress.textContent = `${done} of ${steps.length} steps complete`;
+        progress.setAttribute('aria-valuetext', `${done} of ${steps.length} steps complete`);
+        progressText.textContent = `${pct}% complete`;
+      };
+
+      roast.addEventListener('input', () => {
+        roastChosen = true;
+        updateRoast();
+      });
+
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', (event) => {
+        if (!form.checkValidity()) {
+          event.preventDefault();
+          status.textContent = 'Please complete the highlighted fields.';
+          form.querySelector(':invalid')?.focus();
+          return;
+        }
+        status.textContent = '';
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
 </body>
 
