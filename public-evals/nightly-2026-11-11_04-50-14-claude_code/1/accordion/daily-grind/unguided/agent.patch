+  <script>
+    (function () {
+      var accordion = document.querySelector('#coffee-faq .accordion');
+      if (!accordion) return;
+      var triggers = accordion.querySelectorAll('.accordion-trigger');
+
+      function setOpen(trigger, open) {
+        trigger.setAttribute('aria-expanded', String(open));
+        trigger.closest('.accordion-item').classList.toggle('is-open', open);
+      }
+
+      triggers.forEach(function (trigger) {
+        trigger.addEventListener('click', function () {
+          var willOpen = trigger.getAttribute('aria-expanded') !== 'true';
+          // Only one item may be open at a time
+          triggers.forEach(function (other) {
+            if (other !== trigger) setOpen(other, false);
+          });
+          setOpen(trigger, willOpen);
+        });
+      });
+    })();
+  </script>
+
