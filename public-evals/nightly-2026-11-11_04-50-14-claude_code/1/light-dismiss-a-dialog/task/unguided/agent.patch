+  <script>
+    (function () {
+      var trigger = document.querySelector('.test-dialog-trigger');
+      var dialog = document.getElementById('logout-dialog');
+      if (!trigger || !dialog || typeof dialog.showModal !== 'function') return;
+
+      trigger.addEventListener('click', function (event) {
+        event.preventDefault();
+        dialog.showModal();
+      });
+
+      // Close when clicking the backdrop. The dialog has no padding and its
+      // inner wrapper fills it, so a click targeting the <dialog> element
+      // itself can only be on the backdrop. Track pointerdown too, so a drag
+      // that starts inside the dialog and ends outside doesn't close it.
+      var pressedOnBackdrop = false;
+      dialog.addEventListener('pointerdown', function (event) {
+        pressedOnBackdrop = event.target === dialog;
+      });
+      dialog.addEventListener('click', function (event) {
+        if (event.target === dialog && pressedOnBackdrop) {
+          dialog.close('cancel');
+        }
+        pressedOnBackdrop = false;
+      });
+    })();
+  </script>
+
