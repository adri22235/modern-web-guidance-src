     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <a href="#top" class="back-to-top" aria-label="Back to top"><span aria-hidden="true">&uarr;</span></a>
+  </div>
+
+  <script>
+    // Fallback for browsers without CSS scroll-state container queries:
+    // observe a zero-size sentinel at the top of the scroller instead of listening to scroll events.
+    if (!CSS.supports('container-type', 'scroll-state') && 'IntersectionObserver' in window) {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = scroller.querySelector('.scroll-sentinel');
+      scroller.classList.add('scroll-fallback');
+      new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller }).observe(sentinel);
+    }
+  </script>
+
 </body>
 
