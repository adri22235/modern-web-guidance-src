+  <div class="back-to-top-dock">
+    <button type="button" class="back-to-top" aria-label="Back to top" inert>
+      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
+        stroke-linejoin="round" aria-hidden="true" focusable="false">
+        <path d="M12 19V5M5 12l7-7 7 7" />
+      </svg>
+    </button>
+  </div>
+  </div>
+
+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const button = scroller.querySelector('.back-to-top');
+      const sentinel = scroller.querySelector('.scroll-sentinel');
+      const topTarget = document.getElementById('top-heading');
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const setVisible = (visible) => {
+        button.classList.toggle('is-visible', visible);
+        // inert removes the button from tab order and the a11y tree while hidden
+        button.inert = !visible;
+      };
+
+      if ('IntersectionObserver' in window) {
+        // Fires only when the sentinel crosses the scroller's viewport edge —
+        // no per-frame scroll handler.
+        new IntersectionObserver(([entry]) => setVisible(!entry.isIntersecting), {
+          root: scroller,
+          threshold: 0,
+        }).observe(sentinel);
+      } else {
+        // Fallback for very old browsers: passive, rAF-throttled scroll check
+        let ticking = false;
+        scroller.addEventListener('scroll', () => {
+          if (ticking) return;
+          ticking = true;
+          requestAnimationFrame(() => {
+            setVisible(scroller.scrollTop > sentinel.offsetHeight);
+            ticking = false;
+          });
+        }, { passive: true });
+      }
+
+      button.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        // Move focus to the top so keyboard users aren't stranded on a button
+        // that is about to become inert.
+        topTarget.focus({ preventScroll: true });
+      });
+    })();
+  </script>
+
