+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        alt: 'A latte in a glass with layered milk and coffee',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup. Our autumn signature: a double shot of house espresso, steamed oat milk, and real Grade A maple, finished with a dusting of cinnamon.',
+        price: '$5.75',
+      },
+      'dark-roast-espresso': {
+        alt: 'A cup of espresso with rich crema on a saucer',
+        description: 'Bold, smokey, and perfect for a morning boost. A slow-roasted blend of Sumatran and Guatemalan beans pulled as a rich, syrupy double shot.',
+        price: '$3.50',
+      },
+      'cold-brew': {
+        alt: 'A glass of iced cold brew coffee',
+        description: 'Steeped for 18 hours for maximum smoothness. Low acidity, naturally sweet, and served over ice with an optional splash of cream.',
+        price: '$4.95',
+      },
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const baseTitle = document.title;
+    let current = null; // the .thumbnail currently shown in detail
+
+    function transition(update) {
+      if (!document.startViewTransition) {
+        update();
+        return Promise.resolve();
+      }
+      return document.startViewTransition(update).finished;
+    }
+
+    function fillDetail(card) {
+      const item = ITEMS[card.dataset.id];
+      const name = card.querySelector('.title').textContent;
+      hero.src = card.querySelector('img').src.replace('w=800', 'w=1600');
+      hero.alt = item.alt;
+      title.textContent = name;
+      document.getElementById('detail-description').textContent = item.description;
+      document.getElementById('detail-price').textContent = item.price;
+      document.title = `${name} | ${baseTitle}`;
+    }
+
+    function showDetail(card, { animate = true } = {}) {
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => el.classList.remove('selected'));
+      current = card;
+      // Name the clicked card/title before the old snapshot is captured
+      card.classList.add('selected');
+      const update = () => {
+        fillDetail(card);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+      };
+      const done = animate ? transition(update) : (update(), Promise.resolve());
+      done.finally(() => title.focus());
+    }
+
+    function showList({ animate = true } = {}) {
+      const card = current;
+      current = null;
+      const update = () => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        document.title = baseTitle;
+      };
+      const done = animate ? transition(update) : (update(), Promise.resolve());
+      done.finally(() => {
+        // Clean up so the next transition has unique names
+        card?.classList.remove('selected');
+        // Return focus to the card the user came from (or the list heading)
+        (card ?? document.getElementById('list-heading')).focus();
+      });
+    }
+
+    function cardFromHash() {
+      const id = location.hash.slice(1);
+      return id && ITEMS[id] ? document.querySelector(`.thumbnail[data-id="${id}"]`) : null;
+    }
+
+    document.querySelectorAll('.thumbnail').forEach((card) => {
+      card.addEventListener('click', (e) => {
+        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+        e.preventDefault();
+        history.pushState({ detail: card.dataset.id }, '', `#${card.dataset.id}`);
+        showDetail(card);
+      });
+    });
+
+    document.getElementById('back-btn').addEventListener('click', () => {
+      if (history.state?.detail) {
+        history.back(); // handled by popstate
+      } else {
+        history.replaceState(null, '', location.pathname + location.search);
+        showList();
+      }
+    });
+
+    // Browser back/forward
+    window.addEventListener('popstate', () => {
+      const card = cardFromHash();
+      if (card) showDetail(card);
+      else if (current) showList();
+    });
+
+    // Deep link support
+    const initial = cardFromHash();
+    if (initial) showDetail(initial, { animate: false });
+  </script>
+
