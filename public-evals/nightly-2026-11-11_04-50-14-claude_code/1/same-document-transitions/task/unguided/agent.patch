+  <script>
+    (() => {
+      const ITEMS = {
+        'maple-oat-latte': {
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, finished with a dusting of cinnamon. Our cozy autumn signature, available hot or iced.',
+          price: '$5.75'
+        },
+        'dark-roast-espresso': {
+          description: 'Bold, smokey, and perfect for a morning boost. A double shot of our house dark roast with notes of cocoa and toasted walnut.',
+          price: '$3.50'
+        },
+        'cold-brew': {
+          description: 'Steeped for 18 hours for maximum smoothness. Low in acidity, naturally sweet, and served over ice with an optional splash of cream.',
+          price: '$4.95'
+        }
+      };
+
+      const SITE_TITLE = document.title;
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+      const hero = document.getElementById('hero');
+      const title = document.getElementById('title');
+      const description = document.getElementById('description');
+      const price = document.getElementById('price');
+      const backButton = document.getElementById('back-button');
+      const cards = [...document.querySelectorAll('#list-page .thumbnail')];
+
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let currentId = null;
+      let listScrollY = 0;
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+      const cardFor = (id) => cards.find((c) => c.dataset.id === id);
+
+      // Only one element per name may exist at a time, so names are set
+      // on the active card just around each transition.
+      function nameCard(card, on) {
+        if (!card) return;
+        card.style.viewTransitionName = on ? 'fav-hero' : '';
+        card.querySelector('.title').style.viewTransitionName = on ? 'fav-title' : '';
+      }
+
+      function nameDetail(on) {
+        hero.style.viewTransitionName = on ? 'fav-hero' : '';
+        title.style.viewTransitionName = on ? 'fav-title' : '';
+      }
+
+      // Wait for the hero to be decoded so the "new" snapshot isn't blank.
+      function loadHero(src, alt) {
+        hero.alt = alt;
+        if (hero.getAttribute('src') === src && hero.complete) return Promise.resolve();
+        hero.src = src;
+        const decoded = hero.decode ? hero.decode().catch(() => {}) : Promise.resolve();
+        return Promise.race([decoded, new Promise((r) => setTimeout(r, 1500))]);
+      }
+
+      function transition(update) {
+        if (!document.startViewTransition || reducedMotion.matches) {
+          return Promise.resolve(update()).then(() => null);
+        }
+        const vt = document.startViewTransition(update);
+        return vt.finished.catch(() => {}).then(() => vt);
+      }
+
+      async function showDetail(id) {
+        const card = cardFor(id);
+        const item = ITEMS[id];
+        if (!card || !item) return showList();
+        if (currentId === id) return;
+
+        const fromList = currentId === null;
+        if (fromList) listScrollY = window.scrollY;
+
+        const img = card.querySelector('img');
+        const name = card.querySelector('.title').textContent;
+
+        // Preload before capturing the old state.
+        await loadHero(img.currentSrc || img.src, `${name} in a cup`);
+
+        nameDetail(false);
+        nameCard(card, true);
+
+        await transition(() => {
+          nameCard(card, false);
+          nameDetail(true);
+          title.textContent = name;
+          description.textContent = item.description;
+          price.textContent = item.price;
+          listPage.hidden = true;
+          detailPage.hidden = false;
+          currentId = id;
+          document.title = `${name} | ${SITE_TITLE}`;
+          detailPage.scrollIntoView({ block: 'start' });
+          title.focus({ preventScroll: true });
+        });
+
+        nameDetail(false);
+      }
+
+      async function showList() {
+        if (currentId === null) return;
+        const card = cardFor(currentId);
+
+        nameDetail(true);
+
+        await transition(() => {
+          nameDetail(false);
+          detailPage.hidden = true;
+          listPage.hidden = false;
+          nameCard(card, true);
+          currentId = null;
+          document.title = SITE_TITLE;
+          window.scrollTo(0, listScrollY);
+          if (card) card.focus({ preventScroll: true });
+        });
+
+        nameCard(card, false);
+      }
+
+      function route() {
+        const id = decodeURIComponent(location.hash.slice(1));
+        return ITEMS[id] ? showDetail(id) : showList();
+      }
+
+      cards.forEach((card) => {
+        card.addEventListener('click', (e) => {
+          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+          e.preventDefault();
+          history.pushState({ fav: card.dataset.id }, '', `#${card.dataset.id}`);
+          showDetail(card.dataset.id);
+        });
+      });
+
+      backButton.addEventListener('click', () => {
+        if (history.state && history.state.fav) {
+          history.back(); // popstate -> route() animates back
+        } else {
+          history.replaceState(null, '', location.pathname + location.search);
+          showList();
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && currentId !== null) backButton.click();
+      });
+
+      window.addEventListener('popstate', route);
+
+      // Deep link support (e.g. index.html#cold-brew), without animation.
+      const initial = decodeURIComponent(location.hash.slice(1));
+      if (ITEMS[initial]) {
+        const card = cardFor(initial);
+        const img = card.querySelector('img');
+        const name = card.querySelector('.title').textContent;
+        hero.src = img.src;
+        hero.alt = `${name} in a cup`;
+        title.textContent = name;
+        description.textContent = ITEMS[initial].description;
+        price.textContent = ITEMS[initial].price;
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        currentId = initial;
+        document.title = `${name} | ${SITE_TITLE}`;
+      }
+    })();
+  </script>
+
 </body>
 
