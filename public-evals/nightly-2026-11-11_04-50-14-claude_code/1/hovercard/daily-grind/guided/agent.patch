+  <script>
+    // Wire ARIA for every interestfor → popover="hint" pair up front, in every
+    // browser, before the interestfor polyfill loads.
+    (() => {
+      const owned = new WeakSet();
+      const norm = (t) => (t || "").replace(/\s+/g, " ").trim();
+      const textOf = (el) => {
+        let out = "";
+        for (const n of el.childNodes) {
+          if (n.nodeType === Node.TEXT_NODE) out += n.textContent;
+          else if (n.nodeType === Node.ELEMENT_NODE) {
+            out += " " + (n.tagName === "IMG" ? n.getAttribute("alt") || "" : textOf(n)) + " ";
+          }
+        }
+        return out;
+      };
+      const nameOf = (el) => {
+        const ids = el.getAttribute("aria-labelledby");
+        if (ids) {
+          return norm(ids.split(/\s+/).map((id) => {
+            const ref = document.getElementById(id);
+            return ref ? textOf(ref) : "";
+          }).join(" "));
+        }
+        return norm(el.getAttribute("aria-label")) || norm(textOf(el)) || norm(el.getAttribute("title"));
+      };
+      const isOpen = (el) => {
+        try { return el.matches(":popover-open"); } catch { return el.classList.contains(":popover-open"); }
+      };
+
+      window.wireHints = (root = document) => {
+        for (const trigger of root.querySelectorAll("[interestfor]")) {
+          const id = trigger.getAttribute("interestfor");
+          const hint = document.getElementById(id);
+          if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+          const name = nameOf(trigger);
+          if (norm(textOf(hint)) === name) continue;
+          if (!hint.hasAttribute("role")) hint.setAttribute("role", "tooltip");
+
+          const opensOnActivation =
+            trigger.getAttribute("popovertarget") === id || trigger.getAttribute("commandfor") === id;
+
+          if (!name) {
+            if (!trigger.hasAttribute("aria-labelledby")) trigger.setAttribute("aria-labelledby", id);
+          } else if (opensOnActivation) {
+            if (!trigger.hasAttribute("aria-expanded")) {
+              trigger.setAttribute("aria-expanded", String(isOpen(hint)));
+              owned.add(trigger);
+            }
+          } else if (!trigger.hasAttribute("aria-describedby")) {
+            trigger.setAttribute("aria-describedby", id);
+          }
+        }
+      };
+
+      // `toggle` doesn't bubble, so listen in the capture phase.
+      document.addEventListener("toggle", (e) => {
+        const hint = e.target;
+        if (!(hint instanceof Element) || !hint.id) return;
+        for (const t of document.querySelectorAll(`[interestfor="${CSS.escape(hint.id)}"]`)) {
+          if (owned.has(t)) t.setAttribute("aria-expanded", String(e.newState === "open"));
+        }
+      }, true);
+
+      window.wireHints();
+    })();
+  </script>
+
+  <script type="module">
+    // Load polyfills only where native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      const { default: polyfill } = await import("https://unpkg.com/@oddbird/css-anchor-positioning@latest/dist/css-anchor-positioning-fn.js");
+      await polyfill();
+    }
+  </script>
