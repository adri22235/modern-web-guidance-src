+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-error');
+
+      function getError() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function showError(msg) {
+        error.textContent = msg;
+        input.classList.toggle('is-invalid', !!msg);
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+      }
+
+      // Validate only once the user leaves the field (skip if they never typed anything).
+      input.addEventListener('blur', function () {
+        if (input.value.trim() === '' && !input.classList.contains('is-invalid')) return;
+        showError(getError());
+      });
+
+      // While typing, never add an error — only clear an existing one once the value becomes valid.
+      input.addEventListener('input', function () {
+        if (input.classList.contains('is-invalid') && !getError()) showError('');
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var msg = getError();
+        showError(msg);
+        if (msg) {
+          input.focus();
+          return;
+        }
+        // TODO: send input.value to the newsletter provider/backend.
+        form.innerHTML = '<p class="newsletter-success">Thanks for subscribing! Check your inbox for a welcome brew.</p>';
+      });
+    })();
+  </script>
+
 </body>
 
