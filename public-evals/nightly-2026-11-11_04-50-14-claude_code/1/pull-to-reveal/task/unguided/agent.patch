+  <script>
+    // Runs synchronously during parsing, before first paint, so the page
+    // opens with the nav at the top and the search bar just above the
+    // viewport — no visible jump or flicker.
+    (function () {
+      var root = document.documentElement;
+      var search = document.getElementById('site-search');
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+      if (!location.hash) root.scrollTop = search.offsetHeight;
+
+      // Restored from back/forward cache: tuck the search bar away again
+      // if the user left it revealed.
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted && !location.hash && root.scrollTop < search.offsetHeight) {
+          root.scrollTop = search.offsetHeight;
+        }
+      });
+
+      // "/" reveals and focuses the search bar.
+      document.addEventListener('keydown', function (e) {
+        var t = e.target;
+        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
+        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
+        e.preventDefault();
+        root.scrollTop = 0;
+        document.getElementById('search-input').focus({ preventScroll: true });
+      });
+    })();
+  </script>
