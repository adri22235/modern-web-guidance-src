       <li><a href="/menu">Menu</a></li>
       <li><a href="/locations">Locations</a></li>
       <li><a href="/rewards">Rewards</a></li>
       <li><a href="/account">My Account</a></li>
@@ -205,8 +298,25 @@
       <a href="/privacy-policy">Privacy</a>
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
+  </div>
 
+  <script>
+    // Fallback for browsers without scroll-initial-target (Firefox, Safari).
+    // Runs synchronously at the end of <body>, before first paint, so there is
+    // no visible jump. Skipped when a URL fragment should control scrolling.
+    if (!CSS.supports("scroll-initial-target", "nearest") && !location.hash) {
+      document.querySelector(".page").scrollIntoView({ behavior: "instant", block: "start" });
+    }
+
+    // Visible, single-click alternative to the pull-down gesture (WCAG 2.5.1).
+    document.querySelector(".search-toggle").addEventListener("click", () => {
+      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
+      window.scrollTo({ top: 0, behavior: reduceMotion ? "instant" : "smooth" });
+      document.getElementById("search-input").focus({ preventScroll: true });
+    });
+  </script>
+
 </body>
 
 </html>
