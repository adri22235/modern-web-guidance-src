diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,91 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    /* Pull-to-reveal search: the root element is the scroll container.
+       The search bar sits above .page; .page is the initial scroll target,
+       so the page renders with the nav at the top and the search bar
+       scrolled out of view. Snapping keeps the bar fully shown or hidden. */
+    html {
+      scroll-snap-type: y mandatory;
+    }
+
+    .search-bar {
+      scroll-snap-align: start;
+      background: var(--secondary);
+      padding: 0.75rem 5%;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 0.5rem;
+      max-width: 700px;
+      margin: 0 auto;
+    }
+
+    .search-bar input {
+      flex: 1;
+      min-width: 0;
+      font: inherit;
+      padding: 0.5rem 0.75rem;
+      border: 1px solid var(--primary);
+      border-radius: 4px;
+      background: white;
+      color: var(--text);
+    }
+
+    .search-bar button {
+      font: inherit;
+      padding: 0.5rem 1rem;
+      border: none;
+      border-radius: 4px;
+      background: var(--primary);
+      color: white;
+      cursor: pointer;
+    }
+
+    .search-bar button:hover {
+      background: #3e2723;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Wraps nav + all content. Being taller than the viewport, it lets users
+       scroll freely through the content despite mandatory snapping. The
+       min-height guarantees enough scroll range to hide the search bar. */
+    .page {
+      min-height: 100vh;
+      min-height: 100dvh;
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+    }
+
+    .search-toggle {
+      background: none;
+      border: 1px solid transparent;
+      border-radius: 4px;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      min-width: 24px;
+      min-height: 24px;
+      padding: 2px 6px;
+      cursor: pointer;
+      transition: color 0.3s;
+    }
+
+    .search-toggle:hover {
+      color: var(--accent);
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -156,11 +239,21 @@
 </head>
 
 <body>
 
