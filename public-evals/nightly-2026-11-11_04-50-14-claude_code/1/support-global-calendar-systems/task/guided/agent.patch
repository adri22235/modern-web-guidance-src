+  <script type="module">
+    // The default polyfill entry only ships ISO calendars; non-Gregorian ones need /full.
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill/full');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    const supported = (() => {
+      try {
+        return new Set(Intl.supportedValuesOf('calendar'));
+      } catch {
+        return null;
+      }
+    })();
+
+    // Pick the first calendar ID that both Intl and Temporal accept.
+    function resolveCalendar(candidates) {
+      const probe = Temporal.PlainDate.from('2026-01-01');
+      for (const id of candidates) {
+        if (supported && !supported.has(id)) continue;
+        try {
+          probe.withCalendar(id);
+          return id;
+        } catch {
+          // Not supported by this Temporal implementation; try the next one.
+        }
+      }
+      return null;
+    }
+
+    const CALENDARS = [
+      { key: 'islamic', candidates: ['islamic-umalqura', 'islamic-civil', 'islamic-tbla', 'islamic'] },
+      { key: 'hebrew', candidates: ['hebrew'] },
+      { key: 'japanese', candidates: ['japanese'], era: true },
+    ].map((cal) => ({ ...cal, id: resolveCalendar(cal.candidates) }));
+
+    const input = document.getElementById('calendar-date-input');
+    const errorEl = document.getElementById('calendar-error');
+
+    const el = (tag, props = {}, children = []) => {
+      const node = Object.assign(document.createElement(tag), props);
+      node.append(...children);
+      return node;
+    };
+
+    function row(label, value) {
+      const dd = el('dd');
+      dd.append(value);
+      return [el('dt', { textContent: label }), dd];
+    }
+
+    function renderCalendar(cal, isoDate, today) {
+      const output = document.getElementById(`${cal.key}-date`);
+      if (!cal.id) {
+        output.replaceChildren(el('p', { textContent: 'This calendar is not supported in your browser.' }));
+        return;
+      }
+
+      const date = isoDate.withCalendar(cal.id);
+      const todayInCal = today.withCalendar(cal.id);
+      const cmp = Temporal.PlainDate.compare(date, todayInCal);
+      const status = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+      const localized = date.toLocaleString(`en-u-ca-${cal.id}`, {
+        year: 'numeric',
+        month: 'long',
+        day: 'numeric',
+        ...(cal.era ? { era: 'long' } : {}),
+      });
+
+      const firstOfYear = date.with({ month: 1, day: 1 });
+      const tbody = el('tbody');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthStart = firstOfYear.with({ month: m });
+        const monthName = monthStart.toLocaleString(`en-u-ca-${cal.id}`, { month: 'long' });
+        const tr = el('tr', {}, [
+          el('td', { textContent: String(m) }),
+          el('td', { textContent: monthName }),
+          el('td', { textContent: monthStart.monthCode }),
+          el('td', { textContent: String(monthStart.daysInMonth) }),
+        ]);
+        if (monthStart.monthCode === date.monthCode) tr.className = 'current';
+        tbody.append(tr);
+      }
+
+      const yearLabel = cal.era && date.era
+        ? `${date.year} (${date.era} ${date.eraYear})`
+        : String(date.year);
+
+      const dl = el('dl', {}, [
+        ...row('Year', el('span', { className: 'year', textContent: yearLabel })),
+        ...row('Month', el('span', { className: 'month', textContent: String(date.month) })),
+        ...row('Month code', el('span', { className: 'month-code', textContent: date.monthCode })),
+        ...row('Day', el('span', { className: 'day', textContent: String(date.day) })),
+        ...row('Months in year', el('span', { className: 'months-in-year', textContent: String(date.monthsInYear) })),
+        ...row('Timeline', el('span', { className: 'timeline', textContent: status })),
+      ]);
+      dl.querySelector('.timeline').dataset.status = status;
+
+      const table = el('table', {}, [
+        el('thead', {}, [el('tr', {}, [
+          el('th', { scope: 'col', textContent: '#' }),
+          el('th', { scope: 'col', textContent: 'Month' }),
+          el('th', { scope: 'col', textContent: 'Code' }),
+          el('th', { scope: 'col', textContent: 'Days' }),
+        ])]),
+        tbody,
+      ]);
+      table.createCaption().textContent = `Months of year ${date.year}`;
+
+      output.dataset.calendar = cal.id;
+      output.replaceChildren(
+        el('p', { className: 'localized', textContent: localized }),
+        dl,
+        el('details', {}, [el('summary', { textContent: `Months in this year (${date.monthsInYear})` }), table]),
+      );
+    }
+
+    function update() {
+      const today = Temporal.Now.plainDateISO();
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value || today.toString());
+      } catch {
+        errorEl.textContent = 'Please choose a valid date.';
+        errorEl.hidden = false;
+        return;
+      }
+      errorEl.hidden = true;
+      for (const cal of CALENDARS) {
+        try {
+          renderCalendar(cal, isoDate, today);
+        } catch (err) {
+          document.getElementById(`${cal.key}-date`).replaceChildren(
+            el('p', { textContent: 'This date cannot be shown in this calendar.' }),
+          );
+          console.error(err);
+        }
+      }
+    }
+
+    input.value = Temporal.Now.plainDateISO().toString();
+    input.addEventListener('input', update);
+    document.getElementById('calendar-form').addEventListener('submit', (e) => e.preventDefault());
+    update();
+  </script>
+
 </body>
 
