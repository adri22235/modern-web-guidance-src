+  <script type="module">
+    // Use native Temporal when available, otherwise load a polyfill.
+    async function getTemporal() {
+      if (globalThis.Temporal) return globalThis.Temporal;
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      return mod.Temporal;
+    }
+
+    const CALENDARS = {
+      // Prefer the Umm al-Qura variant; fall back to other Islamic variants if unsupported.
+      islamic: { ids: ['islamic-umalqura', 'islamic-civil', 'islamic', 'islamic-tbla'], locale: 'en' },
+      hebrew: { ids: ['hebrew'], locale: 'en' },
+      japanese: { ids: ['japanese'], locale: 'en', era: true },
+    };
+
+    const escapeHtml = (v) => String(v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+    function resolveCalendar(Temporal, ids) {
+      for (const id of ids) {
+        try {
+          Temporal.PlainDate.from({ year: 2000, month: 1, day: 1 }).withCalendar(id);
+          return id;
+        } catch (e) { /* try next */ }
+      }
+      throw new Error('No supported calendar among: ' + ids.join(', '));
+    }
+
+    // Format an ISO date in a given calendar via Intl (UTC noon avoids timezone shifts).
+    function formatInCalendar(isoDate, calendarId, locale, opts) {
+      const d = new Date(Date.UTC(isoDate.year, isoDate.month - 1, isoDate.day, 12));
+      d.setUTCFullYear(isoDate.year); // handle years 0-99 correctly
+      return new Intl.DateTimeFormat(`${locale}-u-ca-${calendarId}`, { timeZone: 'UTC', ...opts }).format(d);
+    }
+
+    function relationTo(Temporal, isoDate) {
+      const today = Temporal.Now.plainDateISO();
+      const cmp = Temporal.PlainDate.compare(isoDate, today);
+      return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+    }
+
+    function renderCard(Temporal, card, isoDate, cfg, calendarId) {
+      const date = isoDate.withCalendar(calendarId);
+      const localized = formatInCalendar(isoDate, calendarId, cfg.locale, {
+        ...(cfg.era ? { era: 'long' } : {}),
+        year: 'numeric', month: 'long', day: 'numeric',
+      });
+      const relation = relationTo(Temporal, isoDate);
+
+      const firstOfYear = date.with({ month: 1, day: 1 });
+      const months = [];
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthStart = firstOfYear.with({ month: m, day: 1 });
+        const name = formatInCalendar(monthStart.withCalendar('iso8601'), calendarId, cfg.locale, { month: 'long' });
+        months.push({ month: m, code: monthStart.monthCode, name, days: monthStart.daysInMonth });
+      }
+
+      const eraRow = cfg.era && date.era
+        ? `<dt>Era</dt><dd class="cal-era">${escapeHtml(date.era)}${date.eraYear != null ? ` (year ${escapeHtml(date.eraYear)})` : ''}</dd>`
+        : '';
+
+      card.querySelector('.calendar-body').innerHTML = `
+        <p class="localized cal-localized">${escapeHtml(localized)}</p>
+        <dl>
+          ${eraRow}
+          <dt>Year</dt><dd class="cal-year">${escapeHtml(date.year)}</dd>
+          <dt>Month</dt><dd class="cal-month">${escapeHtml(date.month)}</dd>
+          <dt>Month code</dt><dd class="cal-month-code">${escapeHtml(date.monthCode)}</dd>
+          <dt>Day</dt><dd class="cal-day">${escapeHtml(date.day)}</dd>
+          <dt>Months in year</dt><dd class="cal-months-in-year">${escapeHtml(date.monthsInYear)}</dd>
+          <dt>Relative</dt><dd><span class="relation cal-relation ${relation.toLowerCase()}">${relation}</span></dd>
+        </dl>
+        <details open>
+          <summary>Months in ${escapeHtml(date.year)}</summary>
+          <table class="month-table">
+            <thead><tr><th>#</th><th>Code</th><th>Name</th><th>Days</th></tr></thead>
+            <tbody>
+              ${months.map((m) => `
+                <tr class="${m.month === date.month ? 'current' : ''}" data-month-code="${escapeHtml(m.code)}">
+                  <td>${m.month}</td><td>${escapeHtml(m.code)}</td><td>${escapeHtml(m.name)}</td><td>${m.days}</td>
+                </tr>`).join('')}
+            </tbody>
+          </table>
+        </details>`;
+    }
+
+    async function init() {
+      const input = document.getElementById('calendar-date');
+      const errorEl = document.getElementById('calendar-error');
+      const showError = (msg) => { errorEl.textContent = msg; errorEl.hidden = false; };
+
+      let Temporal;
+      try {
+        Temporal = await getTemporal();
+      } catch (e) {
+        showError('Sorry, the calendar converter could not be loaded in this browser.');
+        document.querySelectorAll('.calendar-card .calendar-body').forEach((el) => { el.textContent = 'Unavailable'; });
+        return;
+      }
+
+      const resolved = {};
+      for (const [key, cfg] of Object.entries(CALENDARS)) {
+        try { resolved[key] = resolveCalendar(Temporal, cfg.ids); } catch (e) { resolved[key] = null; }
+      }
+
+      const update = () => {
+        errorEl.hidden = true;
+        if (!input.value) return;
+        let isoDate;
+        try {
+          isoDate = Temporal.PlainDate.from(input.value);
+        } catch (e) {
+          showError('Please enter a valid date.');
+          return;
+        }
+        for (const card of document.querySelectorAll('.calendar-card')) {
+          const key = card.dataset.calendar;
+          const body = card.querySelector('.calendar-body');
+          if (!resolved[key]) { body.textContent = 'This calendar is not supported in your browser.'; continue; }
+          try {
+            renderCard(Temporal, card, isoDate, CALENDARS[key], resolved[key]);
+          } catch (e) {
+            body.textContent = 'Unable to convert this date.';
+          }
+        }
+      };
+
+      input.value = Temporal.Now.plainDateISO().toString();
+      input.addEventListener('input', update);
+      input.addEventListener('change', update);
+      document.getElementById('calendar-today').addEventListener('click', () => {
+        input.value = Temporal.Now.plainDateISO().toString();
+        update();
+      });
+      document.getElementById('calendar-form').addEventListener('submit', (e) => { e.preventDefault(); update(); });
+      update();
+    }
+
+    init();
+  </script>
