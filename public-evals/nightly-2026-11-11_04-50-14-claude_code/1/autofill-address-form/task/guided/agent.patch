+      color: var(--primary);
+      margin-bottom: 0.25rem;
+    }
+
+    .shipping-intro {
+      margin-bottom: 1.5rem;
+    }
+
+    .shipping fieldset {
+      border: 0;
+      margin-block-end: 1rem;
+    }
+
+    .shipping legend {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin-block-end: 0.75rem;
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+      gap: 0.25rem;
+      margin-block-end: 1.25rem;
+    }
+
+    .field-row {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+      column-gap: 1rem;
+    }
+
+    .field label {
+      font-weight: 600;
+    }
+
+    .field .req {
+      color: #b3261e;
+    }
+
+    .field .optional,
+    .field .hint {
+      font-weight: normal;
+      font-size: 0.875rem;
+      color: #5d4037;
+    }
+
+    .field :is(input, select, textarea) {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      color: var(--text);
+      background: white;
+      padding: 0.75rem;
+      min-height: 48px;
+      border: 1px solid #6d5d58;
+      border-radius: 5px;
+      width: 100%;
+    }
+
+    .field textarea {
+      min-height: 6rem;
+      resize: vertical;
+    }
+
+    .field :is(input, select, textarea):focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .field :is(input, select, textarea):user-invalid {
+      border-color: #b3261e;
+      box-shadow: inset 0 0 0 1px #b3261e;
+    }
+
+    /* Non-color cue for autofilled fields, without layout shift */
+    .field :is(input, select, textarea):is(:autofill, :-webkit-autofill) {
+      border-color: var(--primary);
+      box-shadow: inset 0 0 0 2px var(--primary);
+    }
+
+    .shipping button[type="submit"] {
+      font: inherit;
+      font-weight: 600;
+      background: var(--primary);
+      color: white;
+      border: 0;
+      border-radius: 5px;
+      padding: 0.75rem 1.5rem;
+      min-height: 48px;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .shipping button[type="submit"]:hover {
+      background: #3e2723;
+    }
+
+    .shipping button[type="submit"]:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      clip-path: inset(50%);
+      overflow: hidden;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      padding: 0;
+      border: 0;
+      white-space: nowrap;
+    }
+
