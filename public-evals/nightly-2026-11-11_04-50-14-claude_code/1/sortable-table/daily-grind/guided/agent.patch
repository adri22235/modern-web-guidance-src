+  <script>
+    (() => {
+      const table = document.getElementById('seasonal-drinks');
+      const tbody = table.tBodies[0];
+      const status = document.getElementById('seasonal-drinks-status');
+      const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
+
+      function sortRows(rows, index, type, direction) {
+        const factor = direction === 'ascending' ? 1 : -1;
+        const value = (row) => row.cells[index].dataset.value ?? row.cells[index].textContent.trim();
+        return rows.sort((a, b) =>
+          factor * (type === 'number' ? value(a) - value(b) : collator.compare(value(a), value(b)))
+        );
+      }
+
+      function reorder(rows) {
+        const move = Object.hasOwn(Element.prototype, 'moveBefore')
+          ? (row) => tbody.moveBefore(row, null)
+          : (row) => tbody.append(row);
+        for (const row of rows) move(row);
+      }
+
+      function reorderWithTransition(rows) {
+        const update = () => reorder(rows);
+        if (table.startViewTransition) table.startViewTransition(update);
+        else if (document.startViewTransition) document.startViewTransition(update);
+        else update();
+      }
+
+      function sortBy(button) {
+        const th = button.closest('th');
+        const direction = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+        for (const header of table.tHead.rows[0].cells) header.removeAttribute('aria-sort');
+        th.setAttribute('aria-sort', direction);
+
+        const rows = sortRows([...tbody.rows], th.cellIndex, th.dataset.type, direction);
+        reorderWithTransition(rows);
+        status.textContent = `Sorted by ${button.textContent.trim()}, ${direction}, ${rows.length} drinks`;
+      }
+
+      if ('command' in HTMLButtonElement.prototype) {
+        // Invoker commands: one listener on the table handles every header button.
+        table.addEventListener('command', (event) => {
+          if (event.command === '--sort') sortBy(event.source);
+        });
+      } else {
+        // Fallback for browsers without invoker commands.
+        for (const button of table.tHead.querySelectorAll('button[command="--sort"]')) {
+          button.addEventListener('click', () => sortBy(button));
+        }
+      }
+    })();
+  </script>
+
