+  <script type="module">
+    // Load the focusgroup polyfill only when native support is missing
+    if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
+      import('https://esm.sh/@microsoft/focusgroup-polyfill')
+        .then(({ polyfill }) => polyfill())
+        .catch(() => { /* arrow-key navigation is an enhancement */ });
+    }
+
+    // Wholesale / catering tabs (mutually exclusive, selection follows focus)
+    const tabs = [...document.querySelectorAll('.wholesale-tab')];
+    const panelFor = (tab) => document.querySelector(`[role="tabpanel"][aria-labelledby="${tab.id}"]`);
+
+    function selectTab(selected) {
+      for (const tab of tabs) {
+        const isSelected = tab === selected;
+        const panel = panelFor(tab);
+        tab.ariaSelected = String(isSelected);
+        tab.toggleAttribute('focusgroupstart', isSelected);
+        if (isSelected) {
+          panel.hidden = false;
+          panel.tabIndex = 0;
+        } else {
+          // Keep inactive panels findable via find-in-page
+          panel.hidden = 'until-found';
+          panel.removeAttribute('tabindex');
+        }
+      }
+      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+    }
+
+    for (const tab of tabs) {
+      tab.addEventListener('click', () => selectTab(tab));
+      tab.addEventListener('focus', () => selectTab(tab));
+    }
+
+    // Find-in-page matched text inside a hidden panel: sync tab state
+    document.querySelector('.tab-panels').addEventListener('beforematch', (e) => {
+      const panel = e.target.closest('[role="tabpanel"]');
+      const tab = panel && document.getElementById(panel.getAttribute('aria-labelledby'));
+      if (tab) selectTab(tab);
+    });
+
+    // Coupon reveal
+    const couponToggle = document.getElementById('coupon-toggle');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function revealCoupon() {
+      couponPanel.hidden = false;
+      couponToggle.setAttribute('aria-expanded', 'true');
+    }
+
+    couponToggle.addEventListener('click', () => {
+      revealCoupon();
+      couponPanel.querySelector('.coupon-inner').setAttribute('tabindex', '-1');
+      couponPanel.querySelector('.coupon-inner').focus();
+    });
+    // Find-in-page revealed the coupon on its own: keep the button in sync
+    couponPanel.addEventListener('beforematch', () => {
+      couponToggle.setAttribute('aria-expanded', 'true');
+    });
+
+    // Browsers without hidden="until-found" treat it as plain hidden, which
+    // would make the coupon unsearchable, so show it up front instead.
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      revealCoupon();
+    }
+  </script>
