+      // Resolve the target id for a link: data-scroll-target wins, then an in-page href="#id".
+      function targetIdFor(link) {
+        var explicit = link.getAttribute('data-scroll-target');
+        if (explicit) return explicit.replace(/^#/, '');
+        var href = link.getAttribute('href') || '';
+        if (href.charAt(0) === '#' && href.length > 1) return decodeURIComponent(href.slice(1));
+        return null;
+      }
+
+      function targetTop(el) {
+        var top = el.getBoundingClientRect().top + window.pageYOffset - navHeight();
+        var maxTop = document.documentElement.scrollHeight - window.innerHeight;
+        return Math.max(0, Math.min(Math.round(top), maxTop));
+      }
