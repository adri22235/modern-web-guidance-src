+      // a stable scroll position. A hard timeout guarantees completion.
+      function waitForScrollEnd(onDone) {
+        var finished = false;
+        var startY = window.pageYOffset;
+        var lastY = startY;
+        var moved = false;
+        var stableFrames = 0;
+        var rafId = requestAnimationFrame(poll);
