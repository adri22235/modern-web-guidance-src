+  <script>
+    (() => {
+      const navLinks = document.querySelectorAll('nav a[href^="#"], nav a[data-scroll-target]');
+      const announcer = document.getElementById('scroll-announcer');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let currentScrollId = 0;
+      let arrivedTimer;
+
+      // Track whether the root scroller is actively scrolling. Used to work
+      // around browsers where the scroll promise is missing or (Chrome root
+      // scroller bug) resolves before the smooth scroll actually finishes.
+      let isScrolling = false;
+      let idleTimer;
+      const markScrolling = () => {
+        isScrolling = true;
+        clearTimeout(idleTimer);
+        // Idle fallback for browsers without scrollend support
+        idleTimer = setTimeout(markIdle, 150);
+      };
+      const markIdle = () => {
+        isScrolling = false;
+        clearTimeout(idleTimer);
+        window.dispatchEvent(new Event('app:scrollidle'));
+      };
+      window.addEventListener('scroll', markScrolling, { passive: true });
+      window.addEventListener('scrollend', markIdle);
+
+      function waitForScrollIdle(gracePeriod = 100) {
+        return new Promise((resolve) => {
+          let timeoutId;
+          const finish = () => {
+            clearTimeout(timeoutId);
+            window.removeEventListener('app:scrollidle', finish);
+            resolve();
+          };
+          window.addEventListener('app:scrollidle', finish);
+          // If no scrolling starts (target already in view), resolve anyway.
+          timeoutId = setTimeout(() => { if (!isScrolling) finish(); }, gracePeriod);
+        });
+      }
+
+      async function scrollIntoViewAsync(element, options) {
+        const result = element.scrollIntoView(options);
+        if (result instanceof Promise) await result;
+        // Covers browsers without scroll promises and promises that resolve early.
+        if (!(result instanceof Promise) || isScrolling) await waitForScrollIdle();
+      }
+
+      function getTargetId(link) {
+        if (link.dataset.scrollTarget) return link.dataset.scrollTarget;
+        const href = link.getAttribute('href') || '';
+        return href.startsWith('#') ? decodeURIComponent(href.slice(1)) : null;
+      }
+
+      function setCurrentLink(id) {
+        navLinks.forEach((link) => {
+          if (getTargetId(link) === id) link.setAttribute('aria-current', 'true');
+          else link.removeAttribute('aria-current');
+        });
+      }
+
+      async function scrollToSection(id, { updateHistory = true } = {}) {
+        const target = document.getElementById(id);
+        if (!target) return;
+
+        const scrollId = ++currentScrollId;
+        document.querySelectorAll('.page-section.is-arrived')
+          .forEach((sec) => sec.classList.remove('is-arrived'));
+        clearTimeout(arrivedTimer);
+        setCurrentLink(id);
+
+        if (updateHistory && location.hash !== `#${id}`) {
+          history.pushState(null, '', `#${id}`);
+        }
+
+        await scrollIntoViewAsync(target, {
+          behavior: reducedMotion.matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+
+        // A newer navigation superseded this one; skip the follow-up effects.
+        if (scrollId !== currentScrollId) return;
+
+        // Effects run only once the scroll has settled.
+        void target.offsetWidth; // restart animations if re-targeting the same section
+        target.classList.add('is-arrived');
+        arrivedTimer = setTimeout(() => target.classList.remove('is-arrived'), 2000);
+
+        const focusTarget = target.querySelector('h2[tabindex="-1"]') || target;
+        if (!focusTarget.hasAttribute('tabindex')) focusTarget.setAttribute('tabindex', '-1');
+        focusTarget.focus({ preventScroll: true });
+
+        const label = focusTarget.textContent.trim();
+        announcer.textContent = '';
+        requestAnimationFrame(() => { announcer.textContent = `Moved to ${label} section`; });
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const id = getTargetId(link);
+          if (!id || !document.getElementById(id)) return;
+          // Let modified clicks (new tab, etc.) behave normally.
+          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+          event.preventDefault();
+          scrollToSection(id);
+        });
+      });
+
+      // Back/forward between hashes
+      window.addEventListener('popstate', () => {
+        const id = decodeURIComponent(location.hash.slice(1));
+        if (id && document.getElementById(id)) scrollToSection(id, { updateHistory: false });
+      });
+    })();
+  </script>
