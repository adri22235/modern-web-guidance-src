+  <script>
+    (() => {
+      const STORAGE_KEY = 'dailyGrindOrder';
+      const countEl = document.getElementById('order-count');
+
+      const readOrder = () => {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
+        catch { return []; }
+      };
+      const writeOrder = (order) => {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(order)); } catch { /* storage unavailable */ }
+      };
+      const renderCount = (order) => {
+        countEl.textContent = order.reduce((sum, item) => sum + item.qty, 0);
+      };
+
+      renderCount(readOrder());
+
+      document.querySelectorAll('.drink-card .order-form').forEach((form) => {
+        const card = form.closest('.drink-card');
+        const output = form.elements.price;
+        const status = form.querySelector('.order-status');
+        const selected = () => form.querySelector('input[name="size"]:checked');
+
+        const updatePrice = () => {
+          output.value = `$${selected().dataset.price}`;
+        };
+
+        form.addEventListener('change', updatePrice);
+        updatePrice();
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const size = selected();
+          const drink = form.elements.drink.value;
+          const order = readOrder();
+          const existing = order.find((item) => item.drink === drink && item.size === size.value);
+          if (existing) existing.qty += 1;
+          else order.push({ drink, name: card.dataset.drink, size: size.value, price: Number(size.dataset.price), qty: 1 });
+          writeOrder(order);
+          renderCount(order);
+
+          const sizeName = size.closest('label').querySelector('.size-name').textContent;
+          status.textContent = `Added a ${sizeName.toLowerCase()} ${card.dataset.drink} to your order.`;
+        });
+      });
+    })();
+  </script>
+
