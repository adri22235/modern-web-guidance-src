+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var field = input.closest('.form-field');
+      var errorEl = document.getElementById('newsletter-email-error');
+      var successEl = document.getElementById('newsletter-success');
+      var touched = false;
+
+      function getError() {
+        if (input.validity.valueMissing || input.value.trim() === '') {
+          return 'Please enter your email address.';
+        }
+        if (input.validity.typeMismatch) {
+          return 'Please enter a valid email address (e.g. you@example.com).';
+        }
+        return '';
+      }
+
+      function render() {
+        var message = touched ? getError() : '';
+        field.classList.toggle('has-error', !!message);
+        errorEl.textContent = message;
+        if (message) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+        return !getError();
+      }
+
+      // Only start showing errors after the user has interacted and left the field.
+      input.addEventListener('blur', function () {
+        touched = true;
+        render();
+      });
+
+      // Once touched, update feedback live so errors clear as soon as they're fixed.
+      input.addEventListener('input', function () {
+        successEl.hidden = true;
+        if (touched) render();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        touched = true;
+        if (!render()) {
+          input.focus();
+          return;
+        }
+        successEl.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        successEl.hidden = false;
+        form.reset();
+        touched = false; // Return to the neutral state for the next entry.
+        render();
+      });
+    })();
+  </script>
+
 </body>
 
