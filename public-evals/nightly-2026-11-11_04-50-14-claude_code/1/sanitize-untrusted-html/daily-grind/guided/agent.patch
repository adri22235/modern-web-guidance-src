+  <script type="module">
+    // Allowlist for rich-text reviews. Everything not listed here is dropped by the
+    // sanitizer (scripts, event handlers, style, iframes, images, forms, etc.).
+    // setHTML() additionally always strips XSS-unsafe content such as javascript: URLs.
+    const ALLOWED_ELEMENTS = ['p', 'br', 'b', 'strong', 'i', 'em', 'u', 's', 'ul', 'ol', 'li', 'blockquote', 'a'];
+    const ALLOWED_ATTRIBUTES = ['href'];
+    const STORAGE_KEY = 'daily-grind-reviews';
+
+    const form = document.getElementById('review-form');
+    const list = document.getElementById('review-list');
+    const empty = document.getElementById('review-empty');
+    const status = document.getElementById('review-status');
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      // Only downloaded in browsers without the native Sanitizer API.
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES } });
+        return;
+      }
+      const DOMPurify = await loadDOMPurify();
+      el.innerHTML = DOMPurify.sanitize(html, {
+        ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+        ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+        ALLOW_ARIA_ATTR: false,
+        ALLOW_DATA_ATTR: false,
+        KEEP_CONTENT: false,
+      });
+    }
+
+    function loadReviews() {
+      try {
+        const data = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        return Array.isArray(data) ? data : [];
+      } catch {
+        return [];
+      }
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch {
+        // Storage unavailable (private mode / quota); reviews remain for this session.
+      }
+    }
+
+    async function renderReview(review) {
+      const item = document.createElement('li');
+      item.className = 'review';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+      const drink = document.createElement('span');
+      drink.className = 'review-drink';
+      drink.textContent = review.drink; // plain text, never parsed as HTML
+      const byline = document.createElement('span');
+      const time = document.createElement('time');
+      time.dateTime = review.date;
+      time.textContent = new Date(review.date).toLocaleDateString(undefined, { dateStyle: 'medium' });
+      byline.append(`${review.name} · `, time);
+      meta.append(drink, byline);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, review.html); // untrusted markup -> sanitized DOM
+
+      // Harden any surviving links.
+      for (const a of body.querySelectorAll('a')) {
+        a.rel = 'nofollow noopener noreferrer ugc';
+        a.target = '_blank';
+      }
+
+      item.append(meta, body);
+      list.prepend(item);
+      empty.hidden = true;
+    }
+
+    const reviews = loadReviews();
+    for (const review of reviews) {
+      await renderReview(review);
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const review = {
+        drink: String(data.get('drink')),
+        name: String(data.get('name')).trim(),
+        html: String(data.get('review')),
+        date: new Date().toISOString(),
+      };
+
+      const submit = form.querySelector('button[type="submit"]');
+      submit.disabled = true;
+      try {
+        await renderReview(review);
+        reviews.push(review);
+        saveReviews(reviews);
+        form.reset();
+        status.textContent = `Thanks, ${review.name}! Your review was posted.`;
+      } catch {
+        status.textContent = 'Sorry, your review could not be posted. Please try again.';
+      } finally {
+        submit.disabled = false;
+      }
+    });
+  </script>
+
