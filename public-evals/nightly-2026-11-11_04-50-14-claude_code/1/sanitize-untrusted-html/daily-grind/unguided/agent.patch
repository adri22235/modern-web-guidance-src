+      });
+
+      function setStatus(msg, kind) {
+        statusEl.textContent = msg;
+        statusEl.className = 'form-status' + (kind ? ' ' + kind : '');
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var author = authorInput.value.trim();
+        var raw = bodyInput.value.trim();
+        var drink = drinkSelect.value;
+
+        if (!DRINKS[drink]) { setStatus('Please choose a drink.', 'error'); return; }
+        if (!author) { setStatus('Please enter your name.', 'error'); authorInput.focus(); return; }
+
+        // Reject reviews that are empty once unsafe content is stripped.
+        var probe = document.createElement('div');
+        probe.appendChild(sanitizeHTML(raw));
+        if (!probe.textContent.trim()) {
+          setStatus('Your review is empty after removing unsupported content.', 'error');
+          bodyInput.focus();
+          return;
+        }
+
+        reviews.push({
+          drink: drink,
+          author: author.slice(0, 40),
+          rating: clampRating(ratingSelect.value),
+          date: new Date().toISOString(),
+          // Store the raw input; it is sanitized on every render so that
+          // tightening the allowlist later also protects old reviews.
+          body: raw.slice(0, 4000)
+        });
+        saveReviews(reviews);
+
+        form.reset();
+        drinkSelect.value = drink;
+        previewEl.textContent = '';
+        selectDrink(drink);
+        renderCardRatings();
+        setStatus('Thanks! Your review for ' + DRINKS[drink] + ' has been posted.', 'ok');
+      });
+
+      tabs.forEach(function (t) { t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1; });
+      renderCardRatings();
+      renderReviewList();
+    })();
