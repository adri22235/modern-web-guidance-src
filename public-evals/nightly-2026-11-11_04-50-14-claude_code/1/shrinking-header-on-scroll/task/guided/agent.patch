+  <script>
+    // Fallback for browsers without scroll-driven animations: mirror the CSS
+    // scroll timeline by exposing scroll progress as --nav-progress (0 → 1).
+    (function () {
+      var supportsScrollTimeline = window.CSS && CSS.supports &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supportsScrollTimeline) return;
+
+      var root = document.documentElement;
+      var ticking = false;
+
+      function getDistance() {
+        var value = parseFloat(getComputedStyle(root).getPropertyValue('--nav-shrink-distance'));
+        return value > 0 ? value : 120;
+      }
+
+      var distance = getDistance();
+
+      function update() {
+        var scrollY = window.pageYOffset || root.scrollTop || 0;
+        var progress = Math.min(1, Math.max(0, scrollY / distance));
+        root.style.setProperty('--nav-progress', progress.toFixed(3));
+        ticking = false;
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          (window.requestAnimationFrame || function (cb) { setTimeout(cb, 16); })(update);
+        }
+      }
+
+      var passive = false;
+      try {
+        window.addEventListener('test', null, Object.defineProperty({}, 'passive', {
+          get: function () { passive = { passive: true }; }
+        }));
+      } catch (e) {}
+
+      window.addEventListener('scroll', onScroll, passive);
+      window.addEventListener('resize', function () { distance = getDistance(); onScroll(); });
+      update();
+    })();
+  </script>
