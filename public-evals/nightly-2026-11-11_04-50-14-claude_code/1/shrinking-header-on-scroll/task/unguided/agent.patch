+  <script>
+    /* Fallback for browsers without CSS scroll-driven animations. */
+    (function () {
+      var supports = window.CSS && CSS.supports;
+      if (supports && CSS.supports('animation-timeline: scroll()')) return;
+
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var RANGE = 150; // px of scroll over which the nav shrinks (matches CSS)
+      var hasCustomProps = !!(supports && CSS.supports('--a', '0'));
+      var ticking = false;
+      var root = document.documentElement;
+
+      if (!hasCustomProps) nav.className += ' nav--legacy';
+
+      function getScrollY() {
+        return window.pageYOffset || root.scrollTop || document.body.scrollTop || 0;
+      }
+
+      function update() {
+        ticking = false;
+        var progress = Math.min(Math.max(getScrollY() / RANGE, 0), 1);
+
+        if (hasCustomProps) {
+          root.style.setProperty('--nav-progress', progress.toFixed(3));
+        } else {
+          var compact = progress > 0.5;
+          var has = /(^|\s)nav--compact(\s|$)/.test(nav.className);
+          if (compact && !has) nav.className += ' nav--compact';
+          else if (!compact && has) nav.className = nav.className.replace(/\s*nav--compact/, '');
+        }
+      }
+
+      function onScroll() {
+        if (ticking) return;
+        ticking = true;
+        (window.requestAnimationFrame || function (cb) { return setTimeout(cb, 16); })(update);
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
