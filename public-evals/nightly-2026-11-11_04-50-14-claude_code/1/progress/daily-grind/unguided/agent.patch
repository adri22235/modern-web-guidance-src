+    /* Progress Status */
+    .progress-panel {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 24px;
+      margin-bottom: 40px;
+    }
+
+    .progress-panel h2 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .progress-panel .intro {
+      font-size: 0.95rem;
+      margin-bottom: 20px;
+    }
+
+    .progress-item + .progress-item {
+      margin-top: 24px;
+      padding-top: 20px;
+      border-top: 1px solid #efebe9;
+    }
+
+    .progress-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 12px;
+      margin-bottom: 8px;
+    }
+
+    .progress-label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .progress-value {
+      font-size: 0.9rem;
+      font-weight: 600;
+      font-variant-numeric: tabular-nums;
+    }
+
+    .progress-track {
+      position: relative;
+      height: 14px;
+      background: #efebe9;
+      border: 1px solid var(--secondary);
+      border-radius: 999px;
+      overflow: hidden;
+    }
+
+    .progress-fill {
+      height: 100%;
+      width: var(--progress, 0%);
+      background: linear-gradient(90deg, var(--primary), #8d6e63);
+      border-radius: inherit;
+      transition: width 0.6s ease;
+    }
+
+    .progress-indeterminate .progress-fill {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 40%;
+      animation: progress-slide 1.6s ease-in-out infinite;
+    }
+
+    @keyframes progress-slide {
+      0% { transform: translateX(-100%); }
+      100% { transform: translateX(250%); }
+    }
+
+    .progress-hint {
+      font-size: 0.85rem;
+      color: #6d4c41;
+      margin-top: 6px;
+    }
+
+    .progress-steps {
+      display: flex;
+      justify-content: space-between;
+      list-style: none;
+      margin-top: 8px;
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    .progress-steps .done {
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .progress-steps .current {
+      color: var(--text);
+      font-weight: 700;
+      text-decoration: underline;
+      text-decoration-color: var(--accent);
+      text-decoration-thickness: 2px;
+      text-underline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-fill {
+        transition: none;
+      }
+
+      .progress-indeterminate .progress-fill {
+        animation: progress-pulse 2s ease-in-out infinite;
+        width: 100%;
+        transform: none;
+      }
+
+      @keyframes progress-pulse {
+        0%, 100% { opacity: 0.35; }
+        50% { opacity: 0.8; }
+      }
+    }
+
+    @media (max-width: 600px) {
+      .progress-steps {
+        font-size: 0.7rem;
+      }
+    }
+
