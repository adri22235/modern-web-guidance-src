+  <script>
+    // Demo order tracker: starts indeterminate while the order is confirmed,
+    // then becomes determinate as preparation advances.
+    (() => {
+      const bar = document.getElementById('order-progress');
+      const label = document.getElementById('order-progress-label');
+      const meta = document.getElementById('order-progress-meta');
+      const status = document.getElementById('order-status');
+      const steps = [
+        { value: 25, text: 'Order received' },
+        { value: 50, text: 'Grinding beans' },
+        { value: 75, text: 'Brewing your drinks' },
+        { value: 100, text: 'Ready for pickup!' },
+      ];
+      let i = 0;
+
+      const advance = () => {
+        const step = steps[i];
+        bar.value = step.value;
+        label.textContent = step.text;
+        meta.textContent = `${step.value}%`;
+        if (step.value === 100) status.textContent = 'Your order is ready for pickup.';
+        if (++i < steps.length) setTimeout(advance, 2500);
+      };
+
+      setTimeout(advance, 3000);
+    })();
+  </script>
+
