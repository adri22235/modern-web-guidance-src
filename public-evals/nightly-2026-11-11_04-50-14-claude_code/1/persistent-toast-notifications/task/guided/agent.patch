+  <script type="module">
+    // Load the Popover polyfill only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const DEFAULT_DURATION = 6000; // ms; data-toast-duration="0" = stays until closed
+    const MAX_VISIBLE = 4;
+    const supportsDiscrete = CSS.supports("transition-behavior", "allow-discrete");
+    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
+    const announcer = document.getElementById("toast-announcer");
+
+    const stack = [];            // open toasts, oldest first (newest sits at the bottom)
+    const timers = new Map();    // toast -> { id, remaining, startedAt }
+    let lastTrigger = null;
+
+    const isOpen = (toast) => {
+      try { return toast.matches(":popover-open"); }
+      catch { return toast.classList.contains(":popover-open"); }
+    };
+
+    const durationOf = (toast) => {
+      const value = Number(toast.dataset.toastDuration);
+      return Number.isFinite(value) && toast.dataset.toastDuration !== undefined ? value : DEFAULT_DURATION;
+    };
+
+    // Stack open toasts upward from the corner.
+    function layout() {
+      let offset = 0;
+      for (let i = stack.length - 1; i >= 0; i--) {
+        const toast = stack[i];
+        toast.style.setProperty("--toast-offset", `${offset}px`);
+        const gap = parseFloat(getComputedStyle(toast).getPropertyValue("--toast-gap")) * 16 || 12;
+        offset += toast.offsetHeight + gap;
+      }
+    }
+
+    function announce(toast) {
+      let text = toast.querySelector(".toast-message")?.textContent.trim() ?? "";
+      if (toast.querySelector(".toast-action")) text += " Actions available.";
+      if (!text) return;
+      if (typeof document.ariaNotify === "function") {
+        document.ariaNotify(text);
+      } else {
+        announcer.textContent = "";
+        setTimeout(() => { announcer.textContent = text; }, 50);
+      }
+    }
+
+    // ----- Auto-dismiss timers (paused while hovered or focused) -----
+    function clearTimer(toast) {
+      const t = timers.get(toast);
+      if (t) clearTimeout(t.id);
+      timers.delete(toast);
+    }
+
+    function runTimer(toast, ms) {
+      clearTimeout(timers.get(toast)?.id);
+      timers.set(toast, { id: setTimeout(() => hideToast(toast), ms), remaining: ms, startedAt: Date.now() });
+    }
+
+    function startTimer(toast) {
+      clearTimer(toast);
+      const ms = durationOf(toast);
+      if (ms <= 0) return;
+      if (toast.matches(":hover, :focus-within")) {
+        timers.set(toast, { id: 0, remaining: ms, startedAt: 0, paused: true });
+      } else {
+        runTimer(toast, ms);
+      }
+    }
+
+    function pauseTimer(toast) {
+      const t = timers.get(toast);
+      if (!t || t.paused) return;
+      clearTimeout(t.id);
+      t.remaining = Math.max(t.remaining - (Date.now() - t.startedAt), 1000);
+      t.paused = true;
+    }
+
+    function resumeTimer(toast) {
+      const t = timers.get(toast);
+      if (!t || !t.paused || toast.matches(":hover, :focus-within")) return;
+      runTimer(toast, t.remaining);
+    }
+
+    // ----- Show / hide -----
+    function showToast(toast) {
+      if (isOpen(toast)) {
+        // Already visible: move it to the newest position and restart its timer.
+        stack.splice(stack.indexOf(toast), 1);
+        stack.push(toast);
+        layout();
+      } else {
+        toast.classList.remove("is-leaving");
+        toast.showPopover();
+      }
+      announce(toast);
+      startTimer(toast);
+      while (stack.length > MAX_VISIBLE) hideToast(stack[0]);
+    }
+
+    function hideToast(toast) {
+      clearTimer(toast);
+      if (!isOpen(toast)) return;
+      if (supportsDiscrete || reducedMotion.matches) {
+        toast.hidePopover();
+      } else {
+        toast.classList.add("is-leaving");
+        setTimeout(() => { if (isOpen(toast)) toast.hidePopover(); }, 300);
+      }
+    }
+
+    // ----- Wire up toasts -----
+    const resizeObserver = new ResizeObserver(() => layout());
+
+    document.querySelectorAll(".toast").forEach((toast) => {
+      let hadFocus = false;
+
+      toast.addEventListener("beforetoggle", (event) => {
+        if (event.newState === "closed") hadFocus = toast.contains(document.activeElement);
+      });
+
+      toast.addEventListener("toggle", (event) => {
+        if (event.newState === "open") {
+          if (!stack.includes(toast)) stack.push(toast);
+          resizeObserver.observe(toast);
+        } else {
+          clearTimer(toast);
+          toast.classList.remove("is-leaving");
+          resizeObserver.unobserve(toast);
+          const index = stack.indexOf(toast);
+          if (index !== -1) stack.splice(index, 1);
+
+          // Don't strand keyboard users: move focus to the next toast, or back.
+          if (hadFocus) {
+            const next = stack[Math.min(index, stack.length - 1)];
+            (next?.querySelector(".toast-close") ?? lastTrigger)?.focus();
+          }
+          hadFocus = false;
+        }
+        layout();
+      });
+
+      // Close button: use the JS path so older browsers still animate out.
+      toast.querySelector(".toast-close")?.addEventListener("click", (event) => {
+        if (!supportsDiscrete) {
+          event.preventDefault();
+          hideToast(toast);
+        }
+      });
+
+      toast.addEventListener("mouseenter", () => pauseTimer(toast));
+      toast.addEventListener("mouseleave", () => resumeTimer(toast));
+      toast.addEventListener("focusin", () => pauseTimer(toast));
+      toast.addEventListener("focusout", () => setTimeout(() => resumeTimer(toast)));
+    });
+
+    // ----- Triggers -----
+    const orderCount = document.getElementById("order-count");
+
+    document.addEventListener("click", (event) => {
+      const trigger = event.target.closest(".toast-trigger");
+      if (!trigger) return;
+      const toast = document.getElementById(trigger.dataset.toastTarget ?? trigger.getAttribute("aria-controls"));
+      if (!toast?.classList.contains("toast")) return;
+
+      // The order count keeps the toast's info available after it's gone.
+      if (trigger.dataset.orderItem && orderCount) {
+        orderCount.textContent = Number(orderCount.textContent) + 1;
+      }
+
+      lastTrigger = trigger;
+      showToast(toast);
+    });
+  </script>
+
