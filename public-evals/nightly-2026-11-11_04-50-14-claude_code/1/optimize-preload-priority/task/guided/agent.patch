diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,34 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Watch the film</title>
+
+<!-- LCP: the video poster isn't discoverable as an <img>, so preload it with high priority -->
+<link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+<!-- Critical header font: fonts preload at high priority by default -->
+<link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+<!-- Secondary UI font: fetch early, but don't compete with the poster or brand font -->
+<link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+<style>
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-display:swap}
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:optional}
+*{margin:0;box-sizing:border-box}
+body{min-height:100vh;display:grid;place-content:center;gap:1.5rem;padding:1.5rem;background:#111;color:#eee;
+  font-family:Secondary,system-ui,sans-serif;font-size-adjust:from-font;text-align:center}
+h1{font-family:Brand,system-ui,sans-serif;font-size-adjust:from-font;font-size:clamp(2rem,6vw,4rem);line-height:1.1}
+video{display:block;width:min(100%,1280px);height:auto;aspect-ratio:16/9;background:#222}
+a{color:inherit}
+</style>
+</head>
+<body>
+<h1>See it in motion</h1>
+<!-- preload="none": no video bytes compete with the poster during initial load -->
+<video controls playsinline preload="none" width="1280" height="720" poster="poster.jpg">
+  <source src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" type="video/mp4">
+</video>
+<p><a href="#">Get started</a></p>
+</body>
+</html>
