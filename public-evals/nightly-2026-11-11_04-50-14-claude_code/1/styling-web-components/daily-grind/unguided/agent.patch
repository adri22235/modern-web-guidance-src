+/**
+ * <drink-card> — encapsulated Seasonal Favorites card.
+ *
+ * Usage:
+ *   <drink-card variant="featured" badge="New">
+ *     <img slot="media" src="…" alt="…">
+ *     <h3 slot="title">Maple Oat Latte</h3>
+ *     <span slot="price">$5.25</span>
+ *     <p>Description (default slot)</p>
+ *     <a slot="action" href="…" class="btn">View Details</a>
+ *   </drink-card>
+ *
+ * Theming (CSS custom properties inherit across the shadow boundary):
+ *   Site tokens:   --primary, --secondary, --accent, --text, --light
+ *   Card tokens:   --drink-card-bg, --drink-card-fg, --drink-card-heading,
+ *                  --drink-card-accent, --drink-card-radius, --drink-card-shadow,
+ *                  --drink-card-padding, --drink-card-media-ratio
+ *
+ * Variants (attribute, styled via :host([variant])):
+ *   default | featured | bold | iced
+ *
+ * Exposed parts (style from the page with ::part()):
+ *   card, media, body, header, badge, description, actions
+ *
+ * Custom states (style from the page with :state()):
+ *   has-media, has-price
+ *
+ * Internal styles are ordered with cascade layers:
+ *   reset < tokens < base < layout < variants < states
+ * Layout responds to the card's own width via container queries on :host.
+ */
+
+const css = /* css */ `
+@layer reset, tokens, base, layout, variants, states;
+
+/* ───────────── reset: neutralise UA defaults inside the shadow tree ───────────── */
+@layer reset {
+  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+  [hidden] { display: none !important; }
+}
+
+/* ───────────── tokens: map site theme → component tokens ─────────────
+   Site variables (--primary, etc.) are inherited from the page's :root,
+   so the card follows the coffee theme automatically. Pages can override
+   any --drink-card-* token on the element itself. */
+@layer tokens {
+  :host {
+    --_bg:       var(--drink-card-bg, #fff);
+    --_fg:       var(--drink-card-fg, var(--text, #3e2723));
+    --_heading:  var(--drink-card-heading, var(--primary, #4e342e));
+    --_accent:   var(--drink-card-accent, var(--accent, #ffab40));
+    --_muted:    var(--drink-card-muted, var(--secondary, #d7ccc8));
+    --_radius:   var(--drink-card-radius, 8px);
+    --_shadow:   var(--drink-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+    --_pad:      var(--drink-card-padding, 20px);
+    --_ratio:    var(--drink-card-media-ratio, 16 / 9);
+    --_border:   transparent;
+  }
+}
+
+/* ───────────── base: outer box (host) + inner element styling ───────────── */
+@layer base {
+  /* The host is the element the page sees; it is also the size container
+     that internal layouts query. Page styles on drink-card win over these. */
+  :host {
+    display: block;
+    container: drink-card / inline-size;
+    color: var(--_fg);
+    font: inherit;          /* inherit site typography across the boundary */
+    line-height: inherit;
+    min-width: 0;
+  }
+
+  .card {
+    position: relative;
+    display: grid;
+    grid-template-areas: "media" "body";
+    grid-template-rows: auto 1fr;
+    height: 100%;
+    overflow: hidden;
+    background: var(--_bg);
+    border: 2px solid var(--_border);
+    border-radius: var(--_radius);
+    box-shadow: var(--_shadow);
+    text-align: center;
+    transition: transform 0.25s ease, box-shadow 0.25s ease;
+  }
+
+  .media {
+    grid-area: media;
+    aspect-ratio: var(--_ratio);
+    overflow: hidden;
+    background: var(--_muted);
+  }
+
+  ::slotted([slot="media"]) {
+    display: block;
+    width: 100%;
+    height: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    grid-area: body;
+    display: flex;
+    flex-direction: column;
+    gap: 0.5rem;
+    padding: var(--_pad);
+  }
+
+  .header {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.25rem;
+  }
+
+  ::slotted([slot="title"]) {
+    color: var(--_heading);
+    font-size: clamp(1.1rem, 0.9rem + 2.5cqi, 1.6rem);
+    line-height: 1.25;
+  }
+
+  ::slotted([slot="price"]) {
+    font-weight: 700;
+    color: var(--_heading);
+    white-space: nowrap;
+  }
+
+  .description { flex: 1; }
+
+  .actions { margin-top: auto; }
+
+  .badge {
+    position: absolute;
+    top: 12px;
+    left: 12px;
+    z-index: 1;
+    padding: 2px 10px;
+    border-radius: 999px;
+    background: var(--_accent);
+    color: var(--primary, #4e342e);
+    font-size: 0.75rem;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    text-transform: uppercase;
+  }
+}
+
+/* ───────────── layout: respond to the card's own inline size ───────────── */
+@layer layout {
+  /* Medium cards: title and price share a row. */
+  @container drink-card (min-width: 340px) {
+    .header {
+      flex-direction: row;
+      justify-content: space-between;
+      align-items: baseline;
+      text-align: start;
+      gap: 1rem;
+    }
+    .body { text-align: start; }
+  }
+
+  /* Wide cards: media beside the body. */
+  @container drink-card (min-width: 560px) {
+    .card {
+      grid-template-areas: "media body";
+      grid-template-columns: minmax(220px, 42%) 1fr;
+      grid-template-rows: 1fr;
+    }
+    .media { aspect-ratio: auto; min-height: 100%; }
+    .body  { padding: calc(var(--_pad) * 1.5); justify-content: center; }
+    .actions { margin-top: 0.5rem; }
+  }
+
+  /* Very narrow cards: tighter spacing. */
+  @container drink-card (max-width: 240px) {
+    .body { padding: calc(var(--_pad) * 0.6); }
+    .badge { top: 8px; left: 8px; }
+  }
+}
+
+/* ───────────── variants: outer styling driven by host attributes ───────────── */
+@layer variants {
+  :host([variant="featured"]) {
+    --_border: var(--_accent);
+    --_shadow: var(--drink-card-shadow, 0 8px 24px rgb(78 52 46 / 0.18));
+    grid-column: 1 / -1;   /* span the full row of the parent grid */
+  }
+
+  :host([variant="bold"]) {
+    --_bg:      var(--drink-card-bg, var(--primary, #4e342e));
+    --_fg:      var(--drink-card-fg, var(--light, #fafafa));
+    --_heading: var(--drink-card-heading, var(--accent, #ffab40));
+    --_muted:   var(--drink-card-muted, #2b1d19);
+  }
+
+  :host([variant="iced"]) {
+    --_bg:      var(--drink-card-bg, linear-gradient(180deg, #fff 0%, var(--secondary, #d7ccc8) 140%));
+    --_border:  color-mix(in srgb, var(--secondary, #d7ccc8) 70%, white);
+  }
+}
+
+/* ───────────── states: interaction + content-driven states ───────────── */
+@layer states {
+  :host(:hover) .card,
+  :host(:focus-within) .card {
+    transform: translateY(-3px);
+    box-shadow: 0 10px 24px rgb(0 0 0 / 0.15);
+  }
+
+  .card:not(.has-media) { grid-template-areas: "body"; grid-template-columns: 1fr; }
+  .card:not(.has-media) .media { display: none; }
+  .card:not(.has-media) .badge { position: static; justify-self: start; margin: var(--_pad) var(--_pad) 0; }
+
+  .card:not(.has-price) .price { display: none; }
+
+  @media (prefers-reduced-motion: reduce) {
+    .card { transition: none; }
+    :host(:hover) .card, :host(:focus-within) .card { transform: none; }
+  }
+}
+`;
+
+const template = document.createElement('template');
+template.innerHTML = /* html */ `
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden></span>
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <div class="body" part="body">
+      <header class="header" part="header">
+        <slot name="title"></slot>
+        <span class="price"><slot name="price"></slot></span>
+      </header>
+      <div class="description" part="description"><slot></slot></div>
+      <footer class="actions" part="actions"><slot name="action"></slot></footer>
+    </div>
+  </article>
+`;
+
+// One constructable stylesheet shared by every instance (falls back to <style>).
+let sharedSheet = null;
+const supportsAdopted =
+  'adoptedStyleSheets' in Document.prototype && 'replaceSync' in CSSStyleSheet.prototype;
+if (supportsAdopted) {
+  sharedSheet = new CSSStyleSheet();
+  sharedSheet.replaceSync(css);
+}
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['badge'];
+
+  #internals = this.attachInternals?.();
+  #card;
+  #badge;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    if (sharedSheet) {
+      root.adoptedStyleSheets = [sharedSheet];
+    } else {
+      const style = document.createElement('style');
+      style.textContent = css;
+      root.append(style);
+    }
+    root.append(template.content.cloneNode(true));
+
+    this.#card = root.querySelector('.card');
+    this.#badge = root.querySelector('.badge');
+
+    root.querySelectorAll('slot').forEach((slot) =>
+      slot.addEventListener('slotchange', () => this.#syncSlots())
+    );
+    // Hide the media area if a slotted image fails to load.
+    root.querySelector('slot[name="media"]').addEventListener(
+      'error',
+      () => this.#syncSlots(),
+      true
+    );
+  }
+
+  connectedCallback() {
+    this.#syncSlots();
+    this.#renderBadge();
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'badge') this.#renderBadge();
+  }
+
+  #renderBadge() {
+    const text = this.getAttribute('badge');
+    this.#badge.textContent = text ?? '';
+    this.#badge.hidden = !text;
+  }
+
+  #hasContent(slotName) {
+    const slot = this.shadowRoot.querySelector(`slot[name="${slotName}"]`);
+    const isBrokenImage = (el) =>
+      el instanceof HTMLImageElement && el.complete && el.naturalWidth === 0;
+    return slot.assignedElements().some((el) => !isBrokenImage(el));
+  }
+
+  #syncSlots() {
+    this.#toggle('has-media', this.#hasContent('media'));
+    this.#toggle('has-price', this.#hasContent('price'));
+  }
+
+  #toggle(state, on) {
+    this.#card.classList.toggle(state, on);
+    try {
+      if (on) this.#internals?.states.add(state);
+      else this.#internals?.states.delete(state);
+    } catch {
+      /* CustomStateSet unsupported — internal class still applies. */
+    }
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
+
+export { DrinkCard };
