@@ -0,0 +1,256 @@
+/**
+ * <drink-card> — encapsulated card for menu drinks.
+ *
+ * Attributes
+ *   variant  "classic" (default) | "featured" | "iced"  → outer styling via :host()
+ *   badge    optional short label rendered in the internal badge
+ *   price    optional price string rendered in the internal price tag
+ *
+ * Slots (projected light-DOM content, styleable by the page)
+ *   media    an <img> (or <picture>/<video>) shown as the card's hero
+ *   title    the drink's heading (e.g. <h3>)
+ *   (default) description content (e.g. <p>)
+ *   actions  links / buttons
+ *
+ * Parts (internal elements exposed for ::part() styling)
+ *   surface, media, badge, content, footer, price
+ *
+ * Theming
+ *   Inherits the page's coffee tokens (--primary, --secondary, --accent,
+ *   --text, --light) plus inherited font/color across the shadow boundary.
+ *   Public overrides (left unset on :host so they inherit from anywhere):
+ *   --drink-card-surface, --drink-card-ink, --drink-card-heading,
+ *   --drink-card-accent, --drink-card-radius, --drink-card-shadow,
+ *   --drink-card-media-ratio
+ *
+ * Custom state
+ *   :state(has-media) — set when the media slot has content.
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(/* css */ `
+  /* Priority tiers: later layers win. Page rules targeting the host,
+     ::part() rules and inherited custom properties sit outside these
+     layers and so still override the component predictably. */
+  @layer reset, tokens, base, layout, variants, states;
+
+  @layer reset {
+    *, *::before, *::after { box-sizing: border-box; margin: 0; }
+    [hidden] { display: none !important; }
+  }
+
+  @layer tokens {
+    :host {
+      /* Private aliases: read public overrides first, then the page's
+         coffee theme, then a hard-coded fallback. */
+      --_primary:   var(--primary, #4e342e);
+      --_secondary: var(--secondary, #d7ccc8);
+      --_accent:    var(--drink-card-accent, var(--accent, #ffab40));
+      --_text:      var(--text, #3e2723);
+      --_light:     var(--light, #fafafa);
+
+      --_surface:   var(--drink-card-surface, white);
+      --_ink:       var(--drink-card-ink, var(--_text));
+      --_heading:   var(--drink-card-heading, var(--_primary));
+      --_radius:    var(--drink-card-radius, 8px);
+      --_shadow:    var(--drink-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+      --_ratio:     var(--drink-card-media-ratio, 16 / 9);
+      --_badge-bg:  var(--_accent);
+      --_badge-ink: var(--_text);
+      --_pad:       clamp(1rem, 6cqi, 1.5rem);
+    }
+  }
+
+  @layer base {
+    /* Outer box: the host *is* the card, so variants restyle it directly. */
+    :host {
+      display: block; /* custom elements default to inline; containment needs a box */
+      container: drink-card / inline-size;
+      background: var(--_surface);
+      color: var(--_ink);
+      border-radius: var(--_radius);
+      box-shadow: var(--_shadow);
+      overflow: clip;
+    }
+
+    .surface {
+      display: grid;
+      height: 100%;
+      text-align: center;
+    }
+
+    .media { display: none; }
+    .surface.has-media .media { display: block; }
+
+    ::slotted([slot="media"]) {
+      display: block;
+      inline-size: 100%;
+      block-size: 100%;
+      aspect-ratio: var(--_ratio);
+      object-fit: cover;
+    }
+
+    .header {
+      display: grid;
+      justify-items: center;
+      gap: 0.5rem;
+      padding: var(--_pad) var(--_pad) 0;
+    }
+
+    ::slotted([slot="title"]) {
+      color: var(--_heading);
+      font-size: clamp(1.1rem, 3cqi + 0.85rem, 1.75rem);
+      line-height: 1.2;
+      margin: 0;
+    }
+
+    .badge {
+      display: inline-block;
+      padding: 0.15rem 0.6rem;
+      border-radius: 999px;
+      background: var(--_badge-bg);
+      color: var(--_badge-ink);
+      font-size: 0.75rem;
+      font-weight: 600;
+    }
+
+    .content { padding: 0.6rem var(--_pad) 0; }
+    ::slotted(p) { margin: 0; }
+
+    .footer {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 0.5rem 1rem;
+      padding: 0.25rem var(--_pad) var(--_pad);
+      margin-block-start: auto;
+    }
+
+    .price {
+      font-weight: 700;
+      color: var(--_heading);
+      margin-block-start: 15px; /* matches the page's .btn top margin */
+    }
+  }
+
+  @layer layout {
+    /* Rows: media, header, content, footer (footer pinned to the bottom). */
+    .surface { grid-template-rows: auto auto 1fr auto; }
+
+    /* Compact cards: tighten spacing and drop the hero image. */
+    @container drink-card (inline-size < 16rem) {
+      .surface.has-media .media { display: none; }
+      .footer { flex-direction: column; gap: 0; }
+    }
+
+    /* Wide cards with media: image column beside the text. Scoped to
+       .has-media so media-less cards never reserve an empty column. */
+    @container drink-card (inline-size >= 34rem) {
+      .surface.has-media {
+        grid-template-columns: minmax(12rem, 2fr) 3fr;
+        grid-template-rows: auto 1fr auto;
+        text-align: start;
+      }
+      .surface.has-media .media { grid-column: 1; grid-row: 1 / -1; }
+      .surface.has-media .header { justify-items: start; padding-block-start: calc(var(--_pad) * 1.5); }
+      .surface.has-media .footer { justify-content: flex-start; }
+      .surface.has-media ::slotted([slot="media"]) { aspect-ratio: auto; min-block-size: 14rem; }
+    }
+
+    /* Very wide cards: let the description breathe. */
+    @container drink-card (inline-size >= 48rem) {
+      .content { font-size: 1.1rem; max-inline-size: 60ch; }
+    }
+  }
+
+  @layer variants {
+    :host([variant="featured"]) {
+      --_surface:   var(--drink-card-surface,
+                      linear-gradient(135deg, var(--_primary), color-mix(in oklab, var(--_primary), black 35%)));
+      --_ink:       var(--drink-card-ink, var(--_light));
+      --_heading:   var(--drink-card-heading, var(--_accent));
+      --_shadow:    var(--drink-card-shadow, 0 10px 24px rgb(62 39 35 / 0.35));
+      --_radius:    var(--drink-card-radius, 14px);
+      border-block-start: 4px solid var(--_accent);
+    }
+
+    :host([variant="iced"]) {
+      --_surface:   var(--drink-card-surface,
+                      linear-gradient(to bottom, white, color-mix(in oklab, var(--_secondary), white 40%)));
+      --_badge-bg:  var(--_primary);
+      --_badge-ink: var(--_light);
+      outline: 1px solid color-mix(in oklab, var(--_secondary), var(--_primary) 15%);
+      outline-offset: -1px;
+    }
+  }
+
+  @layer states {
+    :host(:focus-within) {
+      outline: 3px solid var(--_accent);
+      outline-offset: 2px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      :host { transition: transform 0.2s ease, box-shadow 0.2s ease; }
+      :host(:hover) {
+        transform: translateY(-3px);
+        box-shadow: 0 8px 18px rgb(0 0 0 / 0.15);
+      }
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="surface" part="surface">
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <div class="header">
+      <span class="badge" part="badge" hidden></span>
+      <slot name="title"></slot>
+    </div>
+    <div class="content" part="content"><slot></slot></div>
+    <div class="footer" part="footer">
+      <span class="price" part="price" hidden></span>
+      <slot name="actions"></slot>
+    </div>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['badge', 'price'];
+
+  #internals = this.attachInternals();
+  #surface;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+    this.#surface = root.querySelector('.surface');
+
+    root.querySelector('slot[name="media"]').addEventListener('slotchange', (e) => {
+      this.#setHasMedia(e.target.assignedElements().length > 0);
+    });
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    const el = this.shadowRoot.querySelector(`.${name}`);
+    el.textContent = value ?? '';
+    el.hidden = !value;
+  }
+
+  #setHasMedia(on) {
+    this.#surface.classList.toggle('has-media', on);
+    try {
+      on ? this.#internals.states.add('has-media') : this.#internals.states.delete('has-media');
+    } catch {
+      /* CustomStateSet unsupported: internal class still drives layout. */
+    }
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
