+  <script>
+    (function () {
+      const target = document.getElementById('action-target');
+      const toggles = document.querySelectorAll('[data-toggle-class]');
+      const classes = Array.from(toggles, (b) => b.dataset.toggleClass);
+
+      toggles.forEach((button) => {
+        button.addEventListener('click', () => {
+          const on = target.classList.toggle(button.dataset.toggleClass);
+          button.setAttribute('aria-pressed', String(on));
+        });
+      });
+
+      document.getElementById('reset-all').addEventListener('click', () => {
+        target.classList.remove(...classes);
+        toggles.forEach((b) => b.setAttribute('aria-pressed', 'false'));
+      });
+    })();
+  </script>
+
