+    // Show the nav inline only when the whole row actually fits; otherwise collapse to the popover menu.
+    const header = document.querySelector(".site-header");
+    const inner = header.querySelector(".header-inner");
+    const menu = document.getElementById("site-menu");
+    let lastWidth = 0;
+
+    const isOpen = () => {
+      try {
+        return menu.matches(":popover-open");
+      } catch {
+        return menu.classList.contains(":popover-open");
+      }
+    };
+
+    function syncLayout() {
+      const width = inner.clientWidth;
+      const wasWide = header.classList.contains("is-wide");
+      // While collapsed, only remeasure when the header has grown, to avoid layout thrash.
+      if (!wasWide && width <= lastWidth) {
+        lastWidth = width;
+        return;
+      }
+      lastWidth = width;
+
+      const wasOpen = menu.hasAttribute("popover") && isOpen();
+      header.classList.add("is-measuring", "is-wide");
+      const fits = inner.scrollWidth <= inner.clientWidth;
+      header.classList.toggle("is-wide", fits);
+
+      if (fits) {
+        menu.removeAttribute("popover");
+      } else if (!menu.hasAttribute("popover")) {
+        menu.setAttribute("popover", "auto");
