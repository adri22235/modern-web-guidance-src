@@ -0,0 +1,192 @@
+/**
+ * <favorite-toggle> — a reusable on/off switch for marking an item as a favorite.
+ *
+ * Attributes:
+ *   item-id   Unique id for the item; used to persist state in localStorage.
+ *   label     Accessible name, e.g. "Favorite Maple Oat Latte" (defaults to "Favorite").
+ *   checked   Present when the item is a favorite. Reflects the current state.
+ *   disabled  Disables interaction.
+ *
+ * Properties: `checked` (boolean), `disabled` (boolean).
+ * Events:     `favorite-change` (bubbles, composed) with detail `{ itemId, checked }`.
+ *
+ * Styling hooks (CSS custom properties):
+ *   --favorite-toggle-on   track color when on   (default #ffab40)
+ *   --favorite-toggle-off  track color when off  (default #bcaaa4)
+ *   --favorite-toggle-text label text color      (default inherit)
+ */
+const STORAGE_PREFIX = 'daily-grind:favorite:';
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-block;
+      font: inherit;
+      color: var(--favorite-toggle-text, inherit);
+    }
+    :host([hidden]) { display: none; }
+
+    button {
+      all: unset;
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      cursor: pointer;
+      padding: 0.25rem 0.375rem;
+      border-radius: 999px;
+      font-size: 0.9rem;
+      user-select: none;
+    }
+    button:focus-visible {
+      outline: 2px solid var(--favorite-toggle-on, #ffab40);
+      outline-offset: 2px;
+    }
+    :host([disabled]) button {
+      cursor: not-allowed;
+      opacity: 0.5;
+    }
+
+    .track {
+      position: relative;
+      flex: none;
+      width: 2.5rem;
+      height: 1.375rem;
+      border-radius: 999px;
+      background: var(--favorite-toggle-off, #bcaaa4);
+      transition: background-color 0.2s ease;
+    }
+    .thumb {
+      position: absolute;
+      top: 0.1875rem;
+      left: 0.1875rem;
+      width: 1rem;
+      height: 1rem;
+      border-radius: 50%;
+      background: #fff;
+      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
+      display: grid;
+      place-items: center;
+      transition: transform 0.2s ease;
+    }
+    .thumb svg {
+      width: 0.7rem;
+      height: 0.7rem;
+      fill: none;
+      stroke: var(--favorite-toggle-off, #bcaaa4);
+      stroke-width: 2.5;
+      transition: fill 0.2s ease, stroke 0.2s ease;
+    }
+
+    :host([checked]) .track { background: var(--favorite-toggle-on, #ffab40); }
+    :host([checked]) .thumb { transform: translateX(1.125rem); }
+    :host([checked]) .thumb svg {
+      fill: var(--favorite-toggle-on, #ffab40);
+      stroke: var(--favorite-toggle-on, #ffab40);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .track, .thumb, .thumb svg { transition: none; }
+    }
+    @media (forced-colors: active) {
+      .track { border: 1px solid ButtonText; }
+      :host([checked]) .track { background: Highlight; }
+      .thumb { background: ButtonText; }
+    }
+  </style>
+  <button type="button" role="switch" aria-checked="false" part="button">
+    <span class="track" part="track" aria-hidden="true">
+      <span class="thumb" part="thumb">
+        <svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.5-9.2C1.1 8.4 3.3 5 6.8 5c2 0 3.6 1.1 4.4 2.6h1.6C13.6 6.1 15.2 5 17.2 5c3.5 0 5.7 3.4 4.3 6.8C19.5 16.4 12 21 12 21z"/></svg>
+      </span>
+    </span>
+    <span class="text" part="label"><slot>Favorite</slot></span>
+  </button>
+`;
+
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['checked', 'disabled', 'label'];
+
+  #button;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.appendChild(template.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#button.addEventListener('click', () => this.toggle());
+  }
+
+  connectedCallback() {
+    // Restore persisted state (overrides the initial `checked` attribute if saved).
+    const saved = this.#read();
+    if (saved !== null) this.checked = saved;
+    this.#sync();
+  }
+
+  attributeChangedCallback() {
+    this.#sync();
+  }
+
+  get checked() { return this.hasAttribute('checked'); }
+  set checked(value) { this.toggleAttribute('checked', Boolean(value)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  get itemId() { return this.getAttribute('item-id'); }
+
+  /** Flip (or force) the state as a user action: persists and fires `favorite-change`. */
+  toggle(force) {
+    if (this.disabled) return;
+    const next = force === undefined ? !this.checked : Boolean(force);
+    if (next === this.checked) return;
+    this.checked = next;
+    this.#write(next);
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { itemId: this.itemId, checked: next },
+    }));
+  }
+
+  #sync() {
+    if (!this.#button) return;
+    this.#button.setAttribute('aria-checked', String(this.checked));
+    this.#button.disabled = this.disabled;
+    const label = this.getAttribute('label');
+    if (label) this.#button.setAttribute('aria-label', label);
+    else this.#button.removeAttribute('aria-label');
+  }
+
+  #key() {
+    return this.itemId ? STORAGE_PREFIX + this.itemId : null;
+  }
+
+  #read() {
+    const key = this.#key();
+    if (!key) return null;
+    try {
+      const value = localStorage.getItem(key);
+      return value === null ? null : value === 'true';
+    } catch {
+      return null; // Storage unavailable (e.g. privacy mode).
+    }
+  }
+
+  #write(value) {
+    const key = this.#key();
+    if (!key) return;
+    try {
+      localStorage.setItem(key, String(value));
+    } catch {
+      /* Storage unavailable; state still works for this page view. */
+    }
+  }
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
+
+export { FavoriteToggle };
