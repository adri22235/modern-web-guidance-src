+  <script type="module">
+    // Seasonal Favorites card markup. Treated as untrusted (e.g. CMS/API-sourced),
+    // so every string is sanitized before it touches the DOM.
+    const seasonalFavorites = [
+      `<div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <a href="/menu/espresso" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </div>`,
+    ];
+
+    // Strict allowlist: only what a card needs. Everything else (script, img/onerror,
+    // style, iframes, event handlers, javascript: URLs) is stripped.
+    const ALLOWED_ELEMENTS = ['div', 'h3', 'p', 'a', 'strong', 'em', 'span', 'br'];
+    const ALLOWED_ATTRIBUTES = ['class', 'href'];
+
+    // Trusted Types tinyfill for browsers without the API (the policy still sanitizes).
+    if (!('trustedTypes' in window)) {
+      window.trustedTypes = { createPolicy: (_name, rules) => rules };
+    }
+
+    let htmlPolicyPromise;
+    // Fallback only: lazily load DOMPurify and wrap it in our named Trusted Types policy.
+    function getHtmlPolicy() {
+      htmlPolicyPromise ??= import('dompurify').then((mod) => {
+        const DOMPurify = mod.default ?? mod;
+        return trustedTypes.createPolicy('daily-grind-html', {
+          createHTML: (input) => DOMPurify.sanitize(input, {
+            ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+            ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+            // Match native Sanitizer behaviour.
+            ALLOW_ARIA_ATTR: false,
+            ALLOW_DATA_ATTR: false,
+            KEEP_CONTENT: false,
+            RETURN_TRUSTED_TYPE: false,
+          }),
+        });
+      });
+      return htmlPolicyPromise;
+    }
+
+    // Sanitize an HTML string and insert it into `el`, replacing existing content.
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // Native Sanitizer API: parse + sanitize + insert in one step, no TT policy needed.
+        el.setHTML(html, {
+          sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES },
+        });
+      } else {
+        const policy = await getHtmlPolicy();
+        el.innerHTML = policy.createHTML(html); // TrustedHTML, so the enforced sink accepts it
+      }
+    }
+
+    async function renderSeasonalFavorites() {
+      const grid = document.getElementById('seasonal-favorites');
+      try {
+        await safeSetHTML(grid, seasonalFavorites.join(''));
+      } catch (err) {
+        console.error('Could not render Seasonal Favorites:', err);
+        grid.textContent = 'Seasonal favorites are unavailable right now.';
+      }
+    }
+
+    renderSeasonalFavorites();
+  </script>
+
