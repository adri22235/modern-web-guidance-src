+'use strict';
+
+// Minimal, dependency-free Node server for The Daily Grind homepage.
+// Serves the static homepage with strict security headers and accepts
+// newsletter signups at POST /api/newsletter.
+
+const http = require('node:http');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+
+const PORT = Number(process.env.PORT) || 11222;
+const HOST = process.env.HOST || '0.0.0.0';
+const PUBLIC_DIR = path.join(__dirname, 'public');
+const DATA_DIR = process.env.DATA_DIR || path.join(__dirname, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const MAX_BODY_BYTES = 2 * 1024;
+
+// Only our own origin and the Unsplash photo host may be contacted by the page.
+// - No inline scripts/styles: an injected <script> or style= attribute won't run.
+// - connect-src 'self': fetch/XHR/WebSocket/sendBeacon can only reach us.
+// - img-src limits image beacons to us + images.unsplash.com.
+// - form-action 'self': forms can't be pointed at another server.
+// - base-uri / object-src / frame-* closed off to stop other exfil tricks.
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "font-src 'self'",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "manifest-src 'self'",
+  "media-src 'none'",
+  "object-src 'none'",
+  "worker-src 'none'",
+  "frame-src 'none'",
+  "child-src 'none'",
+  "frame-ancestors 'none'",
+  "base-uri 'none'",
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CSP,
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'no-referrer',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  // Disable DNS prefetching, which can otherwise leak data via hostnames.
+  'X-DNS-Prefetch-Control': 'off',
+  'Permissions-Policy':
+    'camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()',
+};
+
+// Explicit allowlist of files we serve — nothing else in the repo is exposed.
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/app.js': { file: 'app.js', type: 'text/javascript; charset=utf-8' },
+};
+
+const EMAIL_RE = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, obj) {
+  send(res, status, JSON.stringify(obj), {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+// Reject cross-site POSTs so other sites can't submit signups on a visitor's behalf.
+function isSameOrigin(req) {
+  const origin = req.headers.origin;
+  if (!origin) {
+    const site = req.headers['sec-fetch-site'];
+    return !site || site === 'same-origin' || site === 'none';
+  }
+  try {
+    return new URL(origin).host === req.headers.host;
+  } catch {
+    return false;
+  }
+}
+
+async function handleNewsletter(req, res) {
+  const contentType = (req.headers['content-type'] || '').split(';')[0].trim();
+  const isForm = contentType === 'application/x-www-form-urlencoded';
+  const isJson = contentType === 'application/json';
+
+  // Non-JS form submissions get redirected back to the page with a status flag.
+  const reply = (status, ok, message) => {
+    if (isForm) {
+      send(res, 303, '', {
+        Location: `/?newsletter=${ok ? 'ok' : status === 400 ? 'invalid' : 'error'}#newsletter`,
+      });
+    } else {
+      sendJson(res, status, ok ? { ok: true, message } : { ok: false, error: message });
+    }
+  };
+
+  if (!isSameOrigin(req)) return reply(403, false, 'Request not allowed.');
+  if (!isJson && !isForm) return reply(415, false, 'Unsupported content type.');
+
+  let email;
+  try {
+    const raw = await readBody(req);
+    email = isJson ? JSON.parse(raw).email : new URLSearchParams(raw).get('email');
+  } catch (err) {
+    return reply(err.status || 400, false, err.status === 413 ? 'Request too large.' : 'Invalid request.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return reply(400, false, 'Please enter a valid email address.');
+  }
+
+  try {
+    await fsp.mkdir(DATA_DIR, { recursive: true });
+    await fsp.appendFile(
+      SUBSCRIBERS_FILE,
+      JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n',
+      { mode: 0o600 },
+    );
+  } catch (err) {
+    console.error('Failed to store subscriber:', err);
+    return reply(500, false, "We couldn't save your signup right now. Please try again later.");
+  }
+
+  return reply(200, true, "Thanks for subscribing! Watch your inbox for the next Daily Grind.");
+}
+
+function serveStatic(req, res, pathname) {
+  const entry = STATIC_FILES[pathname];
+  if (!entry) return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+
+  const filePath = path.join(PUBLIC_DIR, entry.file);
+  fs.readFile(filePath, (err, data) => {
+    if (err) {
+      console.error('Failed to read', filePath, err);
+      return send(res, 500, 'Internal server error', { 'Content-Type': 'text/plain; charset=utf-8' });
+    }
+    const headers = { 'Content-Type': entry.type, 'Cache-Control': 'no-cache' };
+    if (req.method === 'HEAD') return send(res, 200, undefined, headers);
+    send(res, 200, data, headers);
+  });
+}
+
+const server = http.createServer((req, res) => {
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    return send(res, 400, 'Bad request', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') return sendJson(res, 405, { ok: false, error: 'Method not allowed.' });
+    return handleNewsletter(req, res).catch((err) => {
+      console.error(err);
+      if (!res.headersSent) sendJson(res, 500, { ok: false, error: 'Internal server error.' });
+    });
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, 'Method not allowed', { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  serveStatic(req, res, pathname);
+});
+
+if (require.main === module) {
+  server.listen(PORT, HOST, () => {
+    console.log(`The Daily Grind running at http://localhost:${PORT}`);
+  });
+}
+
+module.exports = { server, CSP };
