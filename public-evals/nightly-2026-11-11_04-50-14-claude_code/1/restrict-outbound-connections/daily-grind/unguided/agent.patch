@@ -0,0 +1,79 @@
+'use strict';
+
+(function () {
+  const form = document.getElementById('newsletter-form');
+  const status = document.getElementById('newsletter-status');
+  if (!form || !status) return;
+
+  const input = form.querySelector('input[name="email"]');
+  const button = form.querySelector('button[type="submit"]');
+
+  const MESSAGES = {
+    blocked: "Sorry, we couldn't send your request. Please try again later or contact us directly.",
+    network: "We couldn't reach our server. Please check your connection and try again.",
+    invalid: 'Please enter a valid email address.',
+    server: 'Something went wrong on our end. Please try again in a few minutes.',
+    success: "Thanks for subscribing! Watch your inbox for the next Daily Grind.",
+  };
+
+  function show(message, kind) {
+    status.textContent = message;
+    status.className = 'newsletter-status ' + kind;
+    status.hidden = false;
+  }
+
+  // Status passed back from a non-JavaScript form submission (303 redirect).
+  const result = new URLSearchParams(window.location.search).get('newsletter');
+  if (result === 'ok') show(MESSAGES.success, 'success');
+  else if (result === 'invalid') show(MESSAGES.invalid, 'error');
+  else if (result === 'error') show(MESSAGES.server, 'error');
+
+  // If the Content-Security-Policy blocks any outgoing request (e.g. something
+  // tries to reach a host that isn't ours), tell the customer instead of failing silently.
+  document.addEventListener('securitypolicyviolation', function (e) {
+    const directive = e.effectiveDirective || e.violatedDirective || '';
+    if (/^(connect-src|form-action)/.test(directive)) {
+      show(MESSAGES.blocked, 'error');
+    }
+  });
+
+  form.addEventListener('submit', async function (event) {
+    event.preventDefault();
+
+    const email = input.value.trim();
+    if (!email || !input.checkValidity()) {
+      show(MESSAGES.invalid, 'error');
+      input.focus();
+      return;
+    }
+
+    button.disabled = true;
+    status.hidden = true;
+
+    try {
+      const res = await fetch('/api/newsletter', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify({ email: email }),
+        credentials: 'same-origin',
+      });
+
+      let data = null;
+      try { data = await res.json(); } catch (_) { /* non-JSON response */ }
+
+      if (res.ok) {
+        show((data && data.message) || MESSAGES.success, 'success');
+        form.reset();
+      } else if (res.status === 400 || res.status === 422) {
+        show((data && data.error) || MESSAGES.invalid, 'error');
+      } else {
+        show((data && data.error) || MESSAGES.server, 'error');
+      }
+    } catch (err) {
+      // fetch rejects on network failures *and* when blocked by CSP.
+      show(navigator.onLine === false ? MESSAGES.network : MESSAGES.blocked, 'error');
+    } finally {
+      button.disabled = false;
+    }
+  });
+})();
