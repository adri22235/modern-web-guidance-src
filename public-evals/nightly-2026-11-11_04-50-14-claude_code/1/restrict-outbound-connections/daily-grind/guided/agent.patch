@@ -0,0 +1,119 @@
+// Progressive enhancement for the newsletter signup form.
+// Without JS the form still POSTs to /api/newsletter and the server renders a result page.
+
+const form = document.getElementById('newsletter-form');
+const email = document.getElementById('newsletter-email');
+const emailError = document.getElementById('newsletter-email-error');
+const status = document.getElementById('newsletter-status');
+const submitButton = form?.querySelector('button[type="submit"]');
+
+const REQUEST_TIMEOUT_MS = 10_000;
+
+function setStatus(state, message) {
+  status.dataset.state = state;
+  status.textContent = message; // textContent only: never inject HTML
+}
+
+function showFieldError(message) {
+  email.setAttribute('aria-invalid', 'true');
+  emailError.textContent = message;
+  emailError.hidden = false;
+}
+
+function clearFieldError() {
+  email.removeAttribute('aria-invalid');
+  emailError.textContent = '';
+  emailError.hidden = true;
+}
+
+function validateEmail() {
+  if (email.validity.valueMissing) {
+    showFieldError('Please enter your email address.');
+    return false;
+  }
+  if (email.validity.typeMismatch || email.validity.tooLong) {
+    showFieldError('Please enter a valid email address, like name@example.com.');
+    return false;
+  }
+  clearFieldError();
+  return true;
+}
+
+if (form) {
+  // Clear errors while typing; validate when the user leaves the field.
+  email.addEventListener('input', () => {
+    if (email.getAttribute('aria-invalid') === 'true' && email.validity.valid) clearFieldError();
+  });
+  email.addEventListener('blur', () => {
+    if (email.value) validateEmail();
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    setStatus('', '');
+
+    if (!validateEmail()) {
+      email.focus();
+      return;
+    }
+
+    submitButton.disabled = true;
+    setStatus('pending', 'Signing you up…');
+
+    const data = new FormData(form);
+    const payload = {
+      email: String(data.get('email') ?? '').trim(),
+      website: String(data.get('website') ?? ''),
+    };
+
+    try {
+      // Only same-origin requests are allowed by our Connection-Allowlist / CSP.
+      const response = await fetch('/api/newsletter', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify(payload),
+        credentials: 'same-origin',
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+
+      let body = null;
+      try {
+        body = await response.json();
+      } catch {
+        // Non-JSON response; fall through to generic messaging.
+      }
+
+      if (response.ok) {
+        setStatus('success', body?.message ?? "Thanks! You're on the list.");
+        form.reset();
+        return;
+      }
+
+      if (response.status === 400 && body?.field === 'email') {
+        showFieldError(body.message ?? 'Please enter a valid email address.');
+        setStatus('error', "We couldn't sign you up. Please check your email address.");
+        email.focus();
+        return;
+      }
+
+      if (response.status === 429) {
+        setStatus('error', 'Too many attempts. Please wait a minute and try again.');
+        return;
+      }
+
+      setStatus('error', "Sorry, we couldn't complete your signup right now. Please try again later.");
+    } catch (error) {
+      // TypeError: the network failed or the request was blocked (for example by the
+      // Connection-Allowlist / CSP or a browser extension). TimeoutError: the server took too long.
+      if (error?.name === 'TimeoutError') {
+        setStatus('error', 'The request timed out. Please check your connection and try again.');
+      } else if (!navigator.onLine) {
+        setStatus('error', "You appear to be offline. Please reconnect and try again.");
+      } else {
+        setStatus('error', "Your request couldn't go through. Please check your connection and try again.");
+      }
+    } finally {
+      submitButton.disabled = false;
+    }
+  });
+}
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..2b23153
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,256 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  margin-block-start: 60px;
+  padding: 32px 24px;
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-block-end: 0.5rem;
+}
+
+.newsletter-form {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: flex-end;
+  gap: 12px;
+  margin-block-start: 20px;
+}
+
+.newsletter-form .field {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 0.25rem;
+  flex: 1 1 280px;
+  max-width: 420px;
+  text-align: start;
+}
+
+.newsletter-form input[type="email"] {
+  inline-size: 100%;
+  min-height: 48px;
+  padding: 0.75rem;
+  font: inherit;
+  font-size: max(1rem, 1em);
+  border: 1px solid #767676;
+  border-radius: 5px;
+}
+
+.newsletter-form input:focus-visible,
+.newsletter-form button:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 2px;
+}
+
+.newsletter-form input:user-invalid,
+.newsletter-form input[aria-invalid="true"] {
+  border-color: #b3261e;
+}
+
+.newsletter-form button {
+  min-height: 48px;
+  margin-top: 0;
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+}
+
+.newsletter-form button:disabled {
+  opacity: 0.7;
+  cursor: progress;
+}
+
+.field-error {
+  color: #b3261e;
+  font-size: 0.9rem;
+}
+
+.field-error::before,
+.form-status[data-state="error"]::before {
+  content: "⚠ ";
+}
+
+.form-status {
+  margin-block-start: 16px;
+  min-height: 1.6em;
+  font-weight: 600;
+}
+
+.form-status[data-state="success"] {
+  color: #1b5e20;
+}
+
+.form-status[data-state="success"]::before {
+  content: "✓ ";
+}
+
+.form-status[data-state="error"] {
+  color: #b3261e;
+}
+
+.hp {
+  position: absolute;
+  clip-path: inset(50%);
+  overflow: hidden;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  white-space: nowrap;
+}
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..03b063b
--- /dev/null
+++ b/server.js
@@ -0,0 +1,351 @@
+// Daily Grind homepage server.
+//
+// Serves the homepage and its assets with strict outbound-connection headers so the page can
+// only talk to our own origin and the Unsplash image host, and handles newsletter signups.
+//
+//   PORT=11222 node server.js
+
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { existsSync, readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const DATA_DIR = path.join(ROOT, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const MAX_BODY_BYTES = 8 * 1024;
+
+// ---------------------------------------------------------------------------
+// Outbound connection policy
+// ---------------------------------------------------------------------------
+
+// The only third-party origin the page may contact (hero photo).
+const UNSPLASH_ORIGIN = 'https://images.unsplash.com';
+const REPORT_ENDPOINT_NAME = 'security-reports';
+const REPORT_ENDPOINT_PATH = '/api/security-reports';
+
+// Connection-Allowlist (Chrome/Edge 152+): one network-layer allowlist covering fetch, XHR,
+// subresources, beacons, navigations, resource hints (preconnect/dns-prefetch), WebSocket and
+// WebRTC. Must be an RFC 9651 Inner List; a malformed value fails closed (blocks everything).
+// Redirects and WebRTC stay at their default "block".
+const CONNECTION_ALLOWLIST =
+  `(response-origin "${UNSPLASH_ORIGIN}/*"); report-to=${REPORT_ENDPOINT_NAME}`;
+
+// CSP: covers browsers without Connection-Allowlist and adds script/style restrictions.
+// No inline scripts/styles are used, so no 'unsafe-inline' is needed.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${UNSPLASH_ORIGIN}`,
+  "connect-src 'self'",
+  "font-src 'self'",
+  "media-src 'self'",
+  "manifest-src 'self'",
+  "worker-src 'self'",
+  "frame-src 'none'",
+  "object-src 'none'",
+  "base-uri 'none'",
+  "form-action 'self'", // default-src does not cover form submissions
+  "frame-ancestors 'none'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+  `report-to ${REPORT_ENDPOINT_NAME}`,
+].join('; ');
+
+function setDocumentSecurityHeaders(res) {
+  res.setHeader('Reporting-Endpoints', `${REPORT_ENDPOINT_NAME}="${REPORT_ENDPOINT_PATH}"`);
+  res.setHeader('Connection-Allowlist', CONNECTION_ALLOWLIST);
+  res.setHeader('Content-Security-Policy', CONTENT_SECURITY_POLICY);
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+  res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=()');
+}
+
+function setCommonHeaders(res) {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+}
+
+// ---------------------------------------------------------------------------
+// Static files (explicit allowlist: no filesystem path resolution from the URL)
+// ---------------------------------------------------------------------------
+
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8', document: true },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8', document: true },
+  '/styles.css': { file: 'public/styles.css', type: 'text/css; charset=utf-8' },
+  '/newsletter.js': { file: 'public/newsletter.js', type: 'text/javascript; charset=utf-8' },
+};
+
+async function serveStatic(req, res, entry) {
+  let body;
+  try {
+    body = await readFile(path.join(ROOT, entry.file));
+  } catch {
+    return sendText(res, 404, 'Not found');
+  }
+  if (entry.document) setDocumentSecurityHeaders(res);
+  res.writeHead(200, {
+    'Content-Type': entry.type,
+    'Content-Length': body.length,
+    'Cache-Control': entry.document ? 'no-cache' : 'public, max-age=300',
+  });
+  res.end(req.method === 'HEAD' ? undefined : body);
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function sendText(res, status, text) {
+  res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8' });
+  res.end(text);
+}
+
+function sendJson(res, status, obj) {
+  const body = JSON.stringify(obj);
+  res.writeHead(status, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Content-Length': Buffer.byteLength(body),
+    'Cache-Control': 'no-store',
+  });
+  res.end(body);
+}
+
+function escapeHtml(s) {
+  return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+}
+
+// Result page for the no-JavaScript form fallback. Returned as a 200 page rather than a
+// redirect, because Connection-Allowlist blocks 3xx redirects by default.
+function sendResultPage(res, status, title, message) {
+  setDocumentSecurityHeaders(res);
+  const body = `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+<body>
+  <main class="container">
+    <section class="newsletter">
+      <h1>${escapeHtml(title)}</h1>
+      <p class="form-status" data-state="${status < 400 ? 'success' : 'error'}">${escapeHtml(message)}</p>
+      <a class="btn" href="/">Back to the homepage</a>
+    </section>
+  </main>
+</body>
+</html>`;
+  res.writeHead(status, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Content-Length': Buffer.byteLength(body),
+    'Cache-Control': 'no-store',
+  });
+  res.end(body);
+}
+
+class HttpError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function readBody(req, limit = MAX_BODY_BYTES) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > limit) {
+        reject(new HttpError(413, 'Request body too large'));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+// Reject cross-site POSTs (CSRF). Prefer Fetch Metadata; fall back to Origin vs Host.
+function isSameOriginRequest(req) {
+  const site = req.headers['sec-fetch-site'];
+  if (site) return site === 'same-origin' || site === 'none';
+  const origin = req.headers.origin;
+  if (!origin) return true; // non-browser client or very old browser
+  try {
+    return new URL(origin).host === req.headers.host;
+  } catch {
+    return false;
+  }
+}
+
+function clientIp(req) {
+  return req.socket.remoteAddress ?? 'unknown';
+}
+
+// ---------------------------------------------------------------------------
+// Newsletter
+// ---------------------------------------------------------------------------
+
+// Pragmatic email check; real validation is the confirmation email you send later.
+const EMAIL_RE = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;
+
+const subscribers = new Set();
+if (existsSync(SUBSCRIBERS_FILE)) {
+  for (const line of readFileSync(SUBSCRIBERS_FILE, 'utf8').split('\n')) {
+    try {
+      if (line) subscribers.add(JSON.parse(line).email);
+    } catch {
+      /* skip malformed line */
+    }
+  }
+}
+
+// Simple fixed-window rate limit: 5 signups per IP per minute.
+const RATE_WINDOW_MS = 60_000;
+const RATE_MAX = 5;
+const rateBuckets = new Map();
+function rateLimited(ip) {
+  const now = Date.now();
+  const bucket = rateBuckets.get(ip);
+  if (!bucket || now - bucket.start > RATE_WINDOW_MS) {
+    rateBuckets.set(ip, { start: now, count: 1 });
+    return false;
+  }
+  bucket.count += 1;
+  return bucket.count > RATE_MAX;
+}
+setInterval(() => {
+  const now = Date.now();
+  for (const [ip, b] of rateBuckets) if (now - b.start > RATE_WINDOW_MS) rateBuckets.delete(ip);
+}, RATE_WINDOW_MS).unref();
+
+async function handleNewsletter(req, res) {
+  const contentType = String(req.headers['content-type'] ?? '').split(';')[0].trim().toLowerCase();
+  const wantsJson = contentType === 'application/json';
+
+  const reply = (status, message, extra = {}) =>
+    wantsJson
+      ? sendJson(res, status, { ok: status < 400, message, ...extra })
+      : sendResultPage(res, status, status < 400 ? "You're subscribed!" : 'Signup problem', message);
+
+  if (!isSameOriginRequest(req)) return reply(403, 'Cross-site requests are not allowed.');
+  if (rateLimited(clientIp(req))) return reply(429, 'Too many attempts. Please wait a minute and try again.');
+
+  let fields;
+  try {
+    const raw = await readBody(req);
+    if (wantsJson) {
+      fields = JSON.parse(raw);
+      if (!fields || typeof fields !== 'object') throw new HttpError(400, 'Invalid request.');
+    } else if (contentType === 'application/x-www-form-urlencoded') {
+      fields = Object.fromEntries(new URLSearchParams(raw));
+    } else {
+      return reply(415, 'Unsupported request format.');
+    }
+  } catch (err) {
+    return reply(err instanceof HttpError ? err.status : 400, err instanceof HttpError ? err.message : 'Invalid request.');
+  }
+
+  // Honeypot filled: pretend success so bots don't adapt.
+  if (typeof fields.website === 'string' && fields.website.trim() !== '') {
+    return reply(200, "Thanks! You're on the list.");
+  }
+
+  const email = typeof fields.email === 'string' ? fields.email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return reply(400, 'Please enter a valid email address, like name@example.com.', { field: 'email' });
+  }
+
+  // Same response whether new or existing, so the form can't be used to probe who's subscribed.
+  if (!subscribers.has(email)) {
+    try {
+      await mkdir(DATA_DIR, { recursive: true });
+      await appendFile(SUBSCRIBERS_FILE, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', {
+        mode: 0o600,
+      });
+      subscribers.add(email);
+    } catch (err) {
+      console.error('Failed to save subscriber:', err);
+      return reply(500, "Sorry, we couldn't complete your signup right now. Please try again later.");
+    }
+  }
+  return reply(200, "Thanks! You're on the list. Watch your inbox for fresh-roast news.");
+}
+
+// ---------------------------------------------------------------------------
+// Violation reports (Connection-Allowlist / CSP via the Reporting API)
+// ---------------------------------------------------------------------------
+
+async function handleSecurityReport(req, res) {
+  try {
+    const raw = await readBody(req, 64 * 1024);
+    const reports = JSON.parse(raw);
+    for (const r of Array.isArray(reports) ? reports : [reports]) {
+      console.warn('[security-report]', JSON.stringify({ type: r?.type, url: r?.url, body: r?.body }));
+    }
+  } catch {
+    /* ignore malformed reports */
+  }
+  res.writeHead(204);
+  res.end();
+}
+
+// ---------------------------------------------------------------------------
+// Router
+// ---------------------------------------------------------------------------
+
+const server = createServer(async (req, res) => {
+  setCommonHeaders(res);
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    return sendText(res, 400, 'Bad request');
+  }
+
+  try {
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return sendText(res, 405, 'Method not allowed');
+      }
+      return await handleNewsletter(req, res);
+    }
+
+    if (pathname === REPORT_ENDPOINT_PATH) {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return sendText(res, 405, 'Method not allowed');
+      }
+      return await handleSecurityReport(req, res);
+    }
+
+    const entry = STATIC_FILES[pathname];
+    if (entry) {
+      if (req.method !== 'GET' && req.method !== 'HEAD') {
+        res.setHeader('Allow', 'GET, HEAD');
+        return sendText(res, 405, 'Method not allowed');
+      }
+      return await serveStatic(req, res, entry);
+    }
+
+    return sendText(res, 404, 'Not found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) sendText(res, 500, 'Internal server error');
+    else res.end();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`Daily Grind server listening on http://localhost:${PORT}`);
+});
