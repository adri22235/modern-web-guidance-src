+++ b/src/pages/api/account/passkeys/[id].ts
@@ -0,0 +1,45 @@
+import type { APIRoute } from 'astro';
+import {
+  MAX_NAME_LENGTH,
+  cleanName,
+  getAccount,
+  json,
+  readJson,
+  saveAccount,
+  toListResponse,
+  unauthorized,
+} from '../../../../lib/account';
+
+const notFound = () => json({ error: 'Passkey not found.' }, 404);
+
+/** Renames a passkey (server-side label only). An empty name resets it. */
+export const PATCH: APIRoute = async ({ params, request, session, url }) => {
+  const account = await getAccount(session);
+  if (!account || !session) return unauthorized();
+
+  const passkey = account.passkeys.find((p) => p.id === params.id);
+  if (!passkey) return notFound();
+
+  const body = await readJson(request);
+  const name = cleanName(body?.name, { allowEmpty: true });
+  if (name === undefined) {
+    return json({ error: `Names can be up to ${MAX_NAME_LENGTH} characters.` }, 400);
+  }
+
+  passkey.name = name || null;
+  await saveAccount(session, account);
+  return json(toListResponse(account, url));
+};
+
+/** Removes a passkey. The client then signals the remaining IDs to the browser. */
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const account = await getAccount(session);
+  if (!account || !session) return unauthorized();
+
+  const index = account.passkeys.findIndex((p) => p.id === params.id);
+  if (index === -1) return notFound();
+
+  account.passkeys.splice(index, 1);
+  await saveAccount(session, account);
+  return json(toListResponse(account, url));
+};
