+import type { APIRoute } from 'astro';
+import {
+  MAX_NAME_LENGTH,
+  cleanName,
+  getAccount,
+  json,
+  readJson,
+  saveAccount,
+  toUserResponse,
+  unauthorized,
+} from '../../../lib/account';
+
+/** Updates the account's display name; the client syncs it via signalCurrentUserDetails(). */
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const account = await getAccount(session);
+  if (!account || !session) return unauthorized();
+
+  const body = await readJson(request);
+  const displayName = cleanName(body?.displayName, { allowEmpty: false });
+  if (!displayName) {
+    return json({ error: `Display names must be 1–${MAX_NAME_LENGTH} characters.` }, 400);
+  }
+
+  account.user.displayName = displayName;
+  await saveAccount(session, account);
+  return json(toUserResponse(account, url));
+};
