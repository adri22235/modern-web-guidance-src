--- /dev/null
+++ b/src/lib/aaguids.ts
@@ -0,0 +1,28 @@
+/**
+ * Small subset of the community AAGUID registry
+ * (github.com/passkeydeveloper/passkey-authenticator-aaguids) used for UX
+ * hints only. Never use AAGUIDs for security decisions.
+ */
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+export const AAGUID_PROVIDERS: Record<string, { name: string }> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager' },
+  'adce0002-35bc-c60a-648b-0b25f1f05503': { name: 'Chrome on Mac' },
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': { name: 'iCloud Keychain' },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': { name: 'iCloud Keychain (Managed)' },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': { name: 'Windows Hello' },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': { name: 'Windows Hello' },
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': { name: 'Windows Hello' },
+  'bada5566-a7aa-401f-bd96-45619a55120d': { name: '1Password' },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': { name: 'Bitwarden' },
+  '531126d6-e717-415c-9320-3d9aa6981239': { name: 'Dashlane' },
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': { name: 'NordPass' },
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': { name: 'Keeper' },
+  'fdb141b2-5d84-443e-8a35-4698c205a502': { name: 'KeePassXC' },
+  '53414d53-554e-4700-0000-000000000000': { name: 'Samsung Pass' },
+};
+
+export function providerName(aaguid: string): string {
+  if (aaguid === ZERO_AAGUID) return 'Passkey';
+  return AAGUID_PROVIDERS[aaguid]?.name ?? 'Unknown passkey provider';
+}
diff --git a/src/lib/account.ts b/src/lib/account.ts
new file mode 100644
index 0000000..9c02332
--- /dev/null
+++ b/src/lib/account.ts
@@ -0,0 +1,162 @@
+import { randomBytes } from 'node:crypto';
+import type { AstroCookies } from 'astro';
+
+/**
+ * Demo account store for The DevTools Times.
+ *
+ * Accounts live in the Astro session (the same storage the reading list uses).
+ * Passkeys are seeded when a reader signs in so the management UI has data to
+ * work with. All credential IDs and the passkey user handle are random,
+ * unpadded Base64URL strings, as required by the WebAuthn Signal API.
+ */
+
+export interface StoredPasskey {
+  /** Base64URL credential ID. */
+  id: string;
+  /** Reader-chosen nickname; `null` falls back to the provider name. */
+  name: string | null;
+  aaguid: string;
+  /** Epoch milliseconds. */
+  registeredAt: number;
+  /** Epoch milliseconds. */
+  lastUsedAt: number | null;
+}
+
+export interface AccountUser {
+  /** Username (WebAuthn `user.name`). */
+  name: string;
+  /** WebAuthn `user.displayName`. */
+  displayName: string;
+  /** Base64URL WebAuthn user handle (`user.id`). */
+  passkeyUserId: string;
+}
+
+export interface Account {
+  user: AccountUser;
+  passkeys: StoredPasskey[];
+}
+
+/** Shape returned to the client for passkey listings. */
+export interface PasskeyListResponse {
+  rpId: string;
+  userId: string;
+  credentials: StoredPasskey[];
+}
+
+export interface UserResponse extends AccountUser {
+  rpId: string;
+  userId: string;
+}
+
+type Session = NonNullable<import('astro').APIContext['session']>;
+
+const SESSION_KEY = 'account';
+export const MAX_NAME_LENGTH = 64;
+
+/**
+ * Relying Party ID. Must match the `rp.id` used when the passkeys were
+ * registered. Configurable via PASSKEY_RP_ID, otherwise the request host.
+ */
+export function getRpId(url: URL): string {
+  return import.meta.env.PASSKEY_RP_ID || process.env.PASSKEY_RP_ID || url.hostname;
+}
+
+const base64url = (bytes: number) => randomBytes(bytes).toString('base64url');
+
+const DAY = 24 * 60 * 60 * 1000;
+
+function seedPasskeys(): StoredPasskey[] {
+  const now = Date.now();
+  return [
+    {
+      id: base64url(32),
+      name: null,
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', // Google Password Manager
+      registeredAt: now - 180 * DAY,
+      lastUsedAt: now - 2 * DAY,
+    },
+    {
+      id: base64url(32),
+      name: 'Work MacBook',
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', // iCloud Keychain
+      registeredAt: now - 95 * DAY,
+      lastUsedAt: now - 21 * DAY,
+    },
+    {
+      id: base64url(16),
+      name: null,
+      aaguid: '00000000-0000-0000-0000-000000000000', // Unattested security key
+      registeredAt: now - 400 * DAY,
+      lastUsedAt: null,
+    },
+  ];
+}
+
+export async function getAccount(session: Session | undefined): Promise<Account | null> {
+  if (!session) return null;
+  return ((await session.get(SESSION_KEY)) as Account | undefined) ?? null;
+}
+
+export async function saveAccount(session: Session, account: Account): Promise<void> {
+  session.set(SESSION_KEY, account);
+}
+
+export async function signIn(session: Session, username: string): Promise<Account> {
+  const existing = await getAccount(session);
+  if (existing && existing.user.name === username) return existing;
+  const account: Account = {
+    user: { name: username, displayName: username, passkeyUserId: base64url(32) },
+    passkeys: seedPasskeys(),
+  };
+  await saveAccount(session, account);
+  return account;
+}
+
+export async function signOut(session: Session): Promise<void> {
+  session.delete(SESSION_KEY);
+}
+
+export function toListResponse(account: Account, url: URL): PasskeyListResponse {
+  return {
+    rpId: getRpId(url),
+    userId: account.user.passkeyUserId,
+    credentials: [...account.passkeys].sort((a, b) => b.registeredAt - a.registeredAt),
+  };
+}
+
+export function toUserResponse(account: Account, url: URL): UserResponse {
+  return { ...account.user, rpId: getRpId(url), userId: account.user.passkeyUserId };
+}
+
+/** Trims and validates a free-text name. Returns `undefined` when invalid. */
+export function cleanName(value: unknown, { allowEmpty }: { allowEmpty: boolean }): string | undefined {
+  if (typeof value !== 'string') return undefined;
+  const trimmed = value.replace(/\s+/g, ' ').trim();
+  if (trimmed.length > MAX_NAME_LENGTH) return undefined;
+  if (!allowEmpty && trimmed.length === 0) return undefined;
+  return trimmed;
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+/**
+ * Parses a JSON body. Requiring `application/json` forces a CORS preflight
+ * for cross-origin requests, which protects these endpoints from CSRF
+ * (the site has Astro's `checkOrigin` disabled).
+ */
+export async function readJson(request: Request): Promise<Record<string, unknown> | null> {
+  if (!request.headers.get('content-type')?.includes('application/json')) return null;
+  try {
+    const body = await request.json();
+    return body && typeof body === 'object' ? (body as Record<string, unknown>) : null;
+  } catch {
+    return null;
+  }
+}
+
+export const unauthorized = () => json({ error: 'Sign in to manage your account.' }, 401);
