+import type { APIRoute } from 'astro';
+import { cleanName, json, readJson, signIn, signOut, toUserResponse } from '../../../lib/account';
+
+/** Marks the reader as signed in after a successful login. */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions are unavailable.' }, 500);
+  const body = await readJson(request);
+  const username = cleanName(body?.username, { allowEmpty: false });
+  if (!username) return json({ error: 'A valid username is required.' }, 400);
+  const account = await signIn(session, username);
+  return json(toUserResponse(account, url));
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  if (session) await signOut(session);
+  return json({ success: true });
+};
