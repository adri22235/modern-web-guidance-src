diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..3bb4a94
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,449 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { providerName } from '../lib/aaguids';
+import type { AccountUser, PasskeyListResponse, StoredPasskey, UserResponse } from '../lib/account';
+
+const MAX_NAME_LENGTH = 64;
+const API = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/account`;
+
+// ---------------------------------------------------------------------------
+// WebAuthn Signal API helpers (progressive enhancement; failures are non-fatal)
+// ---------------------------------------------------------------------------
+
+type SignalPKC = {
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+const getPKC = (): SignalPKC | undefined =>
+  typeof window !== 'undefined' && 'PublicKeyCredential' in window
+    ? (window.PublicKeyCredential as unknown as SignalPKC)
+    : undefined;
+
+/** Valid unpadded Base64URL: [A-Za-z0-9_-] only, no padding, length % 4 !== 1. */
+function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+async function syncAcceptedCredentials({ rpId, userId, credentials }: PasskeyListResponse) {
+  const pkc = getPKC();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    // rpId always comes from the server, never window.location.hostname.
+    await pkc.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function syncCurrentUserDetails({ rpId, userId, name, displayName }: UserResponse) {
+  const pkc = getPKC();
+  if (!pkc?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await pkc.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// API helpers
+// ---------------------------------------------------------------------------
+
+async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${API}${path}`, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...init.headers },
+    credentials: 'same-origin',
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(data.error || `Request failed (${response.status}).`);
+  return data as T;
+}
+
+// ---------------------------------------------------------------------------
+// Formatting
+// ---------------------------------------------------------------------------
+
+function formatDate(epoch: number, hydrated: boolean) {
+  // Before hydration render in UTC so server and client markup match.
+  return new Intl.DateTimeFormat(undefined, {
+    dateStyle: 'medium',
+    timeZone: hydrated ? undefined : 'UTC',
+  }).format(epoch);
+}
+
+const labelFor = (p: StoredPasskey) => p.name || providerName(p.aaguid);
+
+// ---------------------------------------------------------------------------
+// Component
+// ---------------------------------------------------------------------------
+
+interface Props {
+  initialList: PasskeyListResponse;
+  initialUser: AccountUser;
+}
+
+export default function PasskeyManager({ initialList, initialUser }: Props) {
+  const [list, setList] = useState(initialList);
+  const [user, setUser] = useState(initialUser);
+  const [hydrated, setHydrated] = useState(false);
+  const [status, setStatus] = useState<{ tone: 'ok' | 'error'; text: string } | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  // Rename / delete dialog state
+  const [renaming, setRenaming] = useState<StoredPasskey | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [renameError, setRenameError] = useState<string | null>(null);
+  const [deleting, setDeleting] = useState<StoredPasskey | null>(null);
+  const renameDialog = useRef<HTMLDialogElement>(null);
+  const deleteDialog = useRef<HTMLDialogElement>(null);
+
+  // Profile form state
+  const [displayName, setDisplayName] = useState(initialUser.displayName);
+
+  const ids = useId();
+  const renameTitleId = `${ids}-rename-title`;
+  const renameErrorId = `${ids}-rename-error`;
+  const deleteTitleId = `${ids}-delete-title`;
+  const deleteDescId = `${ids}-delete-desc`;
+  const displayNameId = `${ids}-display-name`;
+
+  // Refresh from the server on mount and tell the password manager which
+  // passkeys are still valid, so removed ones disappear from the authenticator.
+  useEffect(() => {
+    setHydrated(true);
+    let cancelled = false;
+    request<PasskeyListResponse>('/passkeys')
+      .then((fresh) => {
+        if (cancelled) return;
+        setList(fresh);
+        return syncAcceptedCredentials(fresh);
+      })
+      .catch(() => {
+        if (!cancelled) syncAcceptedCredentials(initialList);
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  // ---- Rename -------------------------------------------------------------
+
+  function openRename(passkey: StoredPasskey) {
+    setRenaming(passkey);
+    setRenameValue(passkey.name ?? '');
+    setRenameError(null);
+    renameDialog.current?.showModal();
+  }
+
+  async function submitRename(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    if (!renaming) return;
+    setBusy(true);
+    setRenameError(null);
+    try {
+      // Nicknames are a server-side label only; no Signal API call needed.
+      const fresh = await request<PasskeyListResponse>(`/passkeys/${encodeURIComponent(renaming.id)}`, {
+        method: 'PATCH',
+        body: JSON.stringify({ name: renameValue }),
+      });
+      setList(fresh);
+      const updated = fresh.credentials.find((c) => c.id === renaming.id);
+      setStatus({ tone: 'ok', text: `Passkey renamed to “${updated ? labelFor(updated) : renameValue}”.` });
+      renameDialog.current?.close();
+    } catch (err) {
+      setRenameError((err as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  // ---- Delete -------------------------------------------------------------
+
+  function openDelete(passkey: StoredPasskey) {
+    setDeleting(passkey);
+    deleteDialog.current?.showModal();
+  }
+
+  async function onDeleteDialogClose() {
+    const dialog = deleteDialog.current;
+    if (!dialog) return;
+    const choice = dialog.returnValue;
+    dialog.returnValue = '';
+    const target = deleting;
+    setDeleting(null);
+    if (choice !== 'delete' || !target) return;
+
+    setBusy(true);
+    try {
+      const fresh = await request<PasskeyListResponse>(`/passkeys/${encodeURIComponent(target.id)}`, {
+        method: 'DELETE',
+      });
+      setList(fresh);
+      setStatus({ tone: 'ok', text: `“${labelFor(target)}” was removed from your account.` });
+      // Let the browser / password manager hide the removed passkey.
+      await syncAcceptedCredentials(fresh);
+    } catch (err) {
+      setStatus({ tone: 'error', text: (err as Error).message });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  // ---- Profile ------------------------------------------------------------
+
+  async function submitProfile(e: React.FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    setBusy(true);
+    try {
+      const updated = await request<UserResponse>('/user', {
+        method: 'PUT',
+        body: JSON.stringify({ displayName }),
+      });
+      setUser({ name: updated.name, displayName: updated.displayName, passkeyUserId: updated.passkeyUserId });
+      setDisplayName(updated.displayName);
+      setStatus({ tone: 'ok', text: 'Display name updated.' });
+      // Update the name shown in the passkey picker of the password manager.
+      await syncCurrentUserDetails(updated);
+    } catch (err) {
+      setStatus({ tone: 'error', text: (err as Error).message });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function signOut() {
+    await fetch(`${API}/session`, { method: 'DELETE', credentials: 'same-origin' }).catch(() => {});
+    window.location.assign(import.meta.env.BASE_URL);
+  }
+
+  const { credentials } = list;
+  const isLast = credentials.length === 1;
+
+  return (
+    <div className="space-y-10">
+      <p role="status" aria-live="polite" className="min-h-6 text-sm">
+        {status && (
+          <span className={status.tone === 'ok' ? 'text-green-700' : 'text-red-700'}>{status.text}</span>
+        )}
+      </p>
+
+      {/* Profile ---------------------------------------------------------- */}
+      <section aria-labelledby={`${ids}-profile`} className="space-y-4">
+        <h2 id={`${ids}-profile`} className="text-xl font-bold text-gray-900">
+          Profile
+        </h2>
+        <dl className="text-sm">
+          <dt className="font-medium text-gray-700">Username</dt>
+          <dd className="text-gray-900">{user.name}</dd>
+        </dl>
+        <form onSubmit={submitProfile} className="flex flex-wrap items-end gap-3">
+          <div className="grow">
+            <label htmlFor={displayNameId} className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id={displayNameId}
+              type="text"
+              name="displayName"
+              autoComplete="name"
+              required
+              maxLength={MAX_NAME_LENGTH}
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button
+            type="submit"
+            disabled={busy || displayName.trim() === user.displayName}
+            className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed"
+          >
+            Save
+          </button>
+        </form>
+        <p className="text-xs text-gray-500">
+          Your display name is also updated in your password manager’s passkey list where supported.
+        </p>
+      </section>
+
+      {/* Passkeys --------------------------------------------------------- */}
+      <section aria-labelledby={`${ids}-passkeys`} className="space-y-4">
+        <div>
+          <h2 id={`${ids}-passkeys`} className="text-xl font-bold text-gray-900">
+            Passkeys
+          </h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Passkeys let you sign in with your fingerprint, face, screen lock or security key. Removing one here also
+            removes it from supported password managers.
+          </p>
+        </div>
+
+        {credentials.length === 0 ? (
+          <p className="p-4 text-sm text-gray-600 border border-dashed border-gray-300 rounded-lg">
+            No passkeys found. You can still sign in with your password.
+          </p>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+            {credentials.map((passkey) => {
+              const label = labelFor(passkey);
+              const provider = providerName(passkey.aaguid);
+              return (
+                <li key={passkey.id} className="flex flex-wrap items-center gap-4 p-4">
+                  <span
+                    aria-hidden="true"
+                    className="flex size-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700"
+                  >
+                    <KeyIcon className="size-5" />
+                  </span>
+                  <div className="min-w-0 grow">
+                    <p className="font-semibold text-gray-900 break-words">{label}</p>
+                    {passkey.name && <p className="text-xs text-gray-500">{provider}</p>}
+                    <p className="text-xs text-gray-500">
+                      Created <time dateTime={new Date(passkey.registeredAt).toISOString()}>{formatDate(passkey.registeredAt, hydrated)}</time>
+                      {' · '}
+                      {passkey.lastUsedAt ? (
+                        <>
+                          Last used{' '}
+                          <time dateTime={new Date(passkey.lastUsedAt).toISOString()}>
+                            {formatDate(passkey.lastUsedAt, hydrated)}
+                          </time>
+                        </>
+                      ) : (
+                        'Never used'
+                      )}
+                    </p>
+                  </div>
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      onClick={() => openRename(passkey)}
+                      disabled={busy}
+                      aria-label={`Rename ${label}`}
+                      className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium border border-gray-300 rounded-md hover:bg-gray-50 disabled:opacity-50"
+                    >
+                      <PencilSquareIcon aria-hidden="true" className="size-4" />
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => openDelete(passkey)}
+                      disabled={busy}
+                      aria-label={`Remove ${label}`}
+                      className="inline-flex items-center gap-1 py-1.5 px-3 text-sm font-medium text-red-700 border border-red-200 rounded-md hover:bg-red-50 disabled:opacity-50"
+                    >
+                      <TrashIcon aria-hidden="true" className="size-4" />
+                      Remove
+                    </button>
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </section>
+
+      <button type="button" onClick={signOut} className="text-sm font-medium text-gray-700 underline hover:text-gray-900">
+        Sign out
+      </button>
+
+      {/* Rename dialog ------------------------------------------------------ */}
+      <dialog
+        ref={renameDialog}
+        aria-labelledby={renameTitleId}
+        onClose={() => setRenaming(null)}
+        className="account-dialog"
+      >
+        <form onSubmit={submitRename} className="space-y-4">
+          <h2 id={renameTitleId} className="text-lg font-bold text-gray-900">
+            Rename passkey
+          </h2>
+          <div>
+            <label htmlFor={`${ids}-rename`} className="block text-sm font-medium text-gray-700 mb-1">
+              Passkey name
+            </label>
+            <input
+              id={`${ids}-rename`}
+              type="text"
+              autoComplete="off"
+              maxLength={MAX_NAME_LENGTH}
+              value={renameValue}
+              placeholder={renaming ? providerName(renaming.aaguid) : ''}
+              onChange={(e) => setRenameValue(e.target.value)}
+              aria-describedby={renameError ? renameErrorId : `${ids}-rename-hint`}
+              aria-invalid={renameError ? true : undefined}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <p id={`${ids}-rename-hint`} className="mt-1 text-xs text-gray-500">
+              Leave empty to use the provider name.
+            </p>
+            {renameError && (
+              <p id={renameErrorId} className="mt-1 text-sm text-red-700">
+                {renameError}
+              </p>
+            )}
+          </div>
+          <div className="flex justify-end gap-2">
+            <button
+              type="button"
+              onClick={() => renameDialog.current?.close()}
+              className="py-2 px-4 text-sm font-medium border border-gray-300 rounded-md hover:bg-gray-50"
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={busy}
+              className="py-2 px-4 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800 disabled:opacity-50"
+            >
+              Save
+            </button>
+          </div>
+        </form>
+      </dialog>
+
+      {/* Delete confirmation dialog ---------------------------------------- */}
+      <dialog
+        ref={deleteDialog}
+        aria-labelledby={deleteTitleId}
+        aria-describedby={deleteDescId}
+        onClose={onDeleteDialogClose}
+        className="account-dialog"
+      >
+        <form method="dialog" className="space-y-4">
+          <h2 id={deleteTitleId} className="text-lg font-bold text-gray-900">
+            Remove “{deleting ? labelFor(deleting) : ''}”?
+          </h2>
+          <p id={deleteDescId} className="text-sm text-gray-600">
+            You won’t be able to sign in to The DevTools Times with this passkey anymore.
+            {isLast && ' This is your only passkey, so you’ll need your password to sign in.'}
+          </p>
+          <div className="flex justify-end gap-2">
+            <button
+              value="cancel"
+              className="py-2 px-4 text-sm font-medium border border-gray-300 rounded-md hover:bg-gray-50"
+            >
+              Keep passkey
+            </button>
+            <button
+              value="delete"
+              className="py-2 px-4 text-sm font-medium text-white bg-red-700 rounded-md hover:bg-red-800"
+            >
+              Remove
+            </button>
+          </div>
+        </form>
+      </dialog>
+    </div>
+  );
+}
