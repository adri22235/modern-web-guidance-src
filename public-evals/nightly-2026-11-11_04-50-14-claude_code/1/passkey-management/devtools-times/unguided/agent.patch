+import type { APIRoute } from 'astro';
+import { error, getSignedInUser, json, readJson, rejectCrossSite, serializeAccount } from '../../../lib/api';
+import { updateDisplayName } from '../../../lib/account-store';
+
+export const PATCH: APIRoute = async (context) => {
+  const rejected = rejectCrossSite(context.request);
+  if (rejected) return rejected;
+  const user = await getSignedInUser(context);
+  if (!user) return error('You need to sign in first.', 401);
+
+  const body = await readJson<{ displayName?: unknown }>(context.request);
+  const displayName = typeof body?.displayName === 'string' ? body.displayName.trim() : '';
+  if (!displayName || displayName.length > 64) {
+    return error('Display name must be between 1 and 64 characters.', 400);
