index 0000000..0d9cf9c
--- /dev/null
+++ b/src/lib/account-store.ts
@@ -0,0 +1,126 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { randomBase64Url } from './webauthn';
+
+export interface StoredPasskey {
+  /** base64url-encoded credential ID */
+  id: string;
+  /** Reader-chosen label shown in account settings. */
+  name: string;
+  /** base64url-encoded SPKI public key */
+  publicKey: string;
+  algorithm: number;
+  signCount: number;
+  transports: string[];
+  aaguid: string | null;
+  provider: string | null;
+  backupEligible: boolean;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface StoredAccount {
+  username: string;
+  /** base64url-encoded WebAuthn user handle; stable for the lifetime of the account. */
+  userId: string;
+  displayName: string;
+  passkeys: StoredPasskey[];
+}
+
+interface StoreFile {
+  accounts: Record<string, StoredAccount>;
+}
+
+const DATA_DIR = process.env.DEVTOOLS_TIMES_DATA_DIR ?? path.join(process.cwd(), '.data');
+const STORE_PATH = path.join(DATA_DIR, 'accounts.json');
+
+let cache: StoreFile | null = null;
+// Serialises read-modify-write cycles so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreFile> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(STORE_PATH, 'utf8')) as StoreFile;
+    cache.accounts ??= {};
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') console.error('Failed to read account store, starting fresh', err);
+    cache = { accounts: {} };
+  }
+  return cache;
+}
+
+async function persist(data: StoreFile) {
+  await mkdir(DATA_DIR, { recursive: true });
+  const tmp = `${STORE_PATH}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(data, null, 2), 'utf8');
+  await rename(tmp, STORE_PATH);
+}
+
+function withStore<T>(fn: (data: StoreFile) => T | Promise<T>, write: boolean): Promise<T> {
+  const run = queue.then(async () => {
+    const data = await load();
+    const result = await fn(data);
+    if (write) await persist(data);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+function clone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+function ensureAccount(data: StoreFile, username: string): StoredAccount {
+  let account = data.accounts[username];
+  if (!account) {
+    account = { username, userId: randomBase64Url(16), displayName: username, passkeys: [] };
+    data.accounts[username] = account;
+  }
+  return account;
+}
+
+export function getOrCreateAccount(username: string): Promise<StoredAccount> {
+  return withStore(async (data) => clone(ensureAccount(data, username)), true);
+}
+
+export function updateDisplayName(username: string, displayName: string): Promise<StoredAccount> {
+  return withStore((data) => {
+    const account = ensureAccount(data, username);
+    account.displayName = displayName;
+    return clone(account);
+  }, true);
+}
+
+export class CredentialAlreadyRegisteredError extends Error {}
+
+export function addPasskey(username: string, passkey: StoredPasskey): Promise<StoredAccount> {
+  return withStore((data) => {
+    const taken = Object.values(data.accounts).some((a) => a.passkeys.some((p) => p.id === passkey.id));
+    if (taken) throw new CredentialAlreadyRegisteredError('This passkey is already registered.');
+    const account = ensureAccount(data, username);
+    account.passkeys.push(passkey);
+    return clone(account);
+  }, true);
+}
+
+export function renamePasskey(username: string, id: string, name: string): Promise<StoredPasskey | null> {
+  return withStore((data) => {
+    const passkey = data.accounts[username]?.passkeys.find((p) => p.id === id);
+    if (!passkey) return null;
+    passkey.name = name;
+    return clone(passkey);
+  }, true);
+}
+
+export function removePasskey(username: string, id: string): Promise<StoredAccount | null> {
+  return withStore((data) => {
+    const account = data.accounts[username];
+    if (!account) return null;
+    const before = account.passkeys.length;
+    account.passkeys = account.passkeys.filter((p) => p.id !== id);
+    return account.passkeys.length === before ? null : clone(account);
+  }, true);
+}
diff --git a/src/lib/api.ts b/src/lib/api.ts
