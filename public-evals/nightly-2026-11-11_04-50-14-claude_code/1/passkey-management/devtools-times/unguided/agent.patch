diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..a7bb529
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,424 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+
+interface Passkey {
+  id: string;
+  name: string;
+  provider: string | null;
+  transports: string[];
+  backupEligible: boolean;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+interface Account {
+  rpId: string;
+  username: string;
+  userId: string;
+  displayName: string;
+  passkeys: Passkey[];
+}
+
+type Notice = { kind: 'success' | 'error' | 'info'; message: string } | null;
+
+// The WebAuthn Signal API is new; declare the pieces we use so this compiles everywhere.
+type SignalPublicKeyCredential = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  parseCreationOptionsFromJSON?: (o: unknown) => PublicKeyCredentialCreationOptions;
+};
+
+const API = `${import.meta.env.BASE_URL}api`;
+
+function getPKC(): SignalPublicKeyCredential | null {
+  return typeof window !== 'undefined' && 'PublicKeyCredential' in window
+    ? (window.PublicKeyCredential as SignalPublicKeyCredential)
+    : null;
+}
+
+const b64urlToBytes = (value: string) => {
+  const b64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));
+};
+
+const bytesToB64url = (buffer: ArrayBuffer | ArrayBufferView) => {
+  const bytes = buffer instanceof ArrayBuffer ? new Uint8Array(buffer) : new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength);
+  let binary = '';
+  bytes.forEach((b) => (binary += String.fromCharCode(b)));
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+};
+
+function toCreationOptions(json: any): PublicKeyCredentialCreationOptions {
+  const PKC = getPKC();
+  if (PKC?.parseCreationOptionsFromJSON) return PKC.parseCreationOptionsFromJSON(json);
+  return {
+    ...json,
+    challenge: b64urlToBytes(json.challenge),
+    user: { ...json.user, id: b64urlToBytes(json.user.id) },
+    excludeCredentials: (json.excludeCredentials ?? []).map((c: any) => ({ ...c, id: b64urlToBytes(c.id) })),
+  };
+}
+
+function serializeRegistration(credential: PublicKeyCredential) {
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const publicKey = response.getPublicKey?.();
+  const authenticatorData = response.getAuthenticatorData?.();
+  if (!publicKey || !authenticatorData) {
+    throw new Error('This browser cannot export passkey details. Please update your browser and try again.');
+  }
+  return {
+    id: credential.id,
+    rawId: bytesToB64url(credential.rawId),
+    type: credential.type,
+    response: {
+      clientDataJSON: bytesToB64url(response.clientDataJSON),
+      attestationObject: bytesToB64url(response.attestationObject),
+      authenticatorData: bytesToB64url(authenticatorData),
+      publicKey: bytesToB64url(publicKey),
+      publicKeyAlgorithm: response.getPublicKeyAlgorithm(),
+      transports: response.getTransports?.() ?? [],
+    },
+  };
+}
+
+async function api<T = Account>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${API}${path}`, {
+    credentials: 'same-origin',
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(init?.headers ?? {}) },
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(data.error ?? `Request failed (${response.status})`);
+  return data as T;
+}
+
+/**
+ * Tells the reader's passkey provider which credentials are still valid for this account
+ * and what the account's current names are, so removed keys disappear from the browser's
+ * passkey picker and renamed accounts show up correctly.
+ * Returns false when the browser doesn't support the Signal API.
+ */
+async function syncAuthenticator(account: Account): Promise<boolean> {
+  const PKC = getPKC();
+  if (!PKC?.signalAllAcceptedCredentials || !PKC.signalCurrentUserDetails) return false;
+  try {
+    await Promise.all([
+      PKC.signalAllAcceptedCredentials({
+        rpId: account.rpId,
+        userId: account.userId,
+        allAcceptedCredentialIds: account.passkeys.map((p) => p.id),
+      }),
+      PKC.signalCurrentUserDetails({
+        rpId: account.rpId,
+        userId: account.userId,
+        name: account.username,
+        displayName: account.displayName,
+      }),
+    ]);
+    return true;
+  } catch (err) {
+    console.warn('Unable to sync passkey provider', err);
+    return false;
+  }
+}
+
+const dateFormat = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [notice, setNotice] = useState<Notice>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [displayNameDraft, setDisplayNameDraft] = useState('');
+  const [supportsPasskeys, setSupportsPasskeys] = useState(true);
+  const [supportsSignals, setSupportsSignals] = useState(true);
+  const editInputRef = useRef<HTMLInputElement>(null);
+
+  const applyAccount = useCallback((next: Account) => {
+    setAccount(next);
+    setDisplayNameDraft(next.displayName);
+  }, []);
+
+  useEffect(() => {
+    const PKC = getPKC();
+    setSupportsPasskeys(!!PKC && !!navigator.credentials?.create);
+    setSupportsSignals(!!PKC?.signalAllAcceptedCredentials);
+
+    api('/passkeys')
+      .then((data) => {
+        applyAccount(data);
+        // Reconcile the provider with the server on every visit, e.g. after a key was
+        // removed from another device.
+        void syncAuthenticator(data);
+      })
+      .catch((err) => setNotice({ kind: 'error', message: err.message }))
+      .finally(() => setLoading(false));
+  }, [applyAccount]);
+
+  useEffect(() => {
+    if (editingId) editInputRef.current?.focus();
+  }, [editingId]);
+
+  const syncedSuffix = (synced: boolean) =>
+    synced ? ' Your browser’s passkey list has been updated.' : '';
+
+  const handleCreate = async () => {
+    setNotice(null);
+    setBusy('create');
+    try {
+      const options = await api<any>('/passkeys/options', { method: 'POST', body: '{}' });
+      const credential = (await navigator.credentials.create({ publicKey: toCreationOptions(options) })) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created.');
+      const next = await api('/passkeys/register', { method: 'POST', body: JSON.stringify(serializeRegistration(credential)) });
+      applyAccount(next);
+      setNotice({ kind: 'success', message: 'Passkey added. You can rename it below.' });
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') {
+        setNotice({ kind: 'info', message: 'Passkey creation was cancelled.' });
+      } else if (err?.name === 'InvalidStateError') {
+        setNotice({ kind: 'info', message: 'This device already has a passkey for your account.' });
+      } else {
+        setNotice({ kind: 'error', message: err?.message ?? 'Could not create a passkey.' });
+      }
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const startEditing = (passkey: Passkey) => {
+    setEditingId(passkey.id);
+    setDraftName(passkey.name);
+    setNotice(null);
+  };
+
+  const handleRename = async (e: React.FormEvent, passkey: Passkey) => {
+    e.preventDefault();
+    const name = draftName.trim();
+    if (!name || name === passkey.name) {
+      setEditingId(null);
+      return;
+    }
+    setBusy(passkey.id);
+    try {
+      const next = await api(`/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'PATCH', body: JSON.stringify({ name }) });
+      applyAccount(next);
+      setEditingId(null);
+      setNotice({ kind: 'success', message: `Renamed passkey to “${name}”.` });
+    } catch (err: any) {
+      setNotice({ kind: 'error', message: err.message });
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleRemove = async (passkey: Passkey) => {
+    const confirmed = window.confirm(
+      `Remove “${passkey.name}”? You won’t be able to sign in with this passkey anymore.`,
+    );
+    if (!confirmed) return;
+    setNotice(null);
+    setBusy(passkey.id);
+    try {
+      const next = await api(`/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE', body: '{}' });
+      applyAccount(next);
+      const synced = await syncAuthenticator(next);
+      setNotice({
+        kind: 'success',
+        message: synced
+          ? `Removed “${passkey.name}”.${syncedSuffix(true)}`
+          : `Removed “${passkey.name}”. Your browser can’t be updated automatically, so you may also want to delete it from your password manager.`,
+      });
+    } catch (err: any) {
+      setNotice({ kind: 'error', message: err.message });
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const handleDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!account) return;
+    const displayName = displayNameDraft.trim();
+    if (!displayName || displayName === account.displayName) return;
+    setBusy('profile');
+    setNotice(null);
+    try {
+      const next = await api('/account/profile', { method: 'PATCH', body: JSON.stringify({ displayName }) });
+      applyAccount(next);
+      const synced = await syncAuthenticator(next);
+      setNotice({ kind: 'success', message: `Display name updated.${syncedSuffix(synced && next.passkeys.length > 0)}` });
+    } catch (err: any) {
+      setNotice({ kind: 'error', message: err.message });
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const noticeStyles = {
+    success: 'text-green-700 bg-green-100',
+    error: 'text-red-700 bg-red-100',
+    info: 'text-gray-700 bg-gray-100',
+  } as const;
+
+  if (loading) {
+    return <p className="text-sm text-gray-500">Loading your account…</p>;
+  }
+
+  if (!account) {
+    return (
+      <div className={`p-3 text-sm rounded-lg ${noticeStyles.error}`} role="alert">
+        {notice?.message ?? 'Could not load your account.'}
+      </div>
+    );
+  }
+
+  return (
+    <div className="space-y-10">
+      <div aria-live="polite">
+        {notice && (
+          <div className={`p-3 text-sm rounded-lg ${noticeStyles[notice.kind]}`} role={notice.kind === 'error' ? 'alert' : 'status'}>
+            {notice.message}
+          </div>
+        )}
+      </div>
+
+      <section aria-labelledby="profile-heading">
+        <h2 id="profile-heading" className="text-lg font-bold text-gray-900 border-b border-gray-900 pb-2 mb-4">
+          Profile
+        </h2>
+        <form onSubmit={handleDisplayName} className="flex flex-col sm:flex-row sm:items-end gap-3 max-w-xl">
+          <div className="flex-1">
+            <label htmlFor="display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="display-name"
+              type="text"
+              maxLength={64}
+              value={displayNameDraft}
+              onChange={(e) => setDisplayNameDraft(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+            <p className="text-xs text-gray-500 mt-1">
+              Signed in as <span className="font-semibold">{account.username}</span>. This name is also shown in your
+              browser’s passkey picker.
+            </p>
+          </div>
+          <button
+            type="submit"
+            disabled={busy !== null || displayNameDraft.trim() === account.displayName || !displayNameDraft.trim()}
+            className="sm:mb-5 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed"
+          >
+            {busy === 'profile' ? 'Saving…' : 'Save'}
+          </button>
+        </form>
+      </section>
+
+      <section aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-center justify-between gap-3 border-b border-gray-900 pb-2 mb-4">
+          <h2 id="passkeys-heading" className="text-lg font-bold text-gray-900">
+            Passkeys
+          </h2>
+          <button
+            type="button"
+            onClick={handleCreate}
+            disabled={!supportsPasskeys || busy !== null}
+            className="py-2 px-3 rounded text-xs font-semibold text-white bg-gray-800 hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed"
+          >
+            {busy === 'create' ? 'Waiting for your device…' : 'Create a passkey'}
+          </button>
+        </div>
+
+        <p className="text-sm text-gray-600 mb-4">
+          Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password.
+          {!supportsPasskeys && ' Your browser doesn’t support passkeys.'}
+          {supportsPasskeys && !supportsSignals &&
+            ' Your browser can’t be notified automatically when you remove a passkey here, so you may need to delete it from your password manager too.'}
+        </p>
+
+        {account.passkeys.length === 0 ? (
+          <div className="border border-dashed border-gray-300 rounded-lg p-6 text-center text-sm text-gray-500">
+            You haven’t registered any passkeys yet.
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+            {account.passkeys.map((passkey) => {
+              const isEditing = editingId === passkey.id;
+              const isBusy = busy === passkey.id;
+              return (
+                <li key={passkey.id} className="flex flex-col sm:flex-row sm:items-center gap-3 p-4">
+                  <div className="w-10 h-10 rounded bg-gray-100 flex items-center justify-center flex-shrink-0" aria-hidden="true">
+                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth={1.5} stroke="currentColor" className="w-5 h-5 text-gray-700">
+                      <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z" />
+                    </svg>
+                  </div>
+
+                  <div className="flex-1 min-w-0">
+                    {isEditing ? (
+                      <form onSubmit={(e) => handleRename(e, passkey)} className="flex flex-wrap items-center gap-2">
+                        <label htmlFor={`passkey-name-${passkey.id}`} className="sr-only">
+                          Passkey name
+                        </label>
+                        <input
+                          ref={editInputRef}
+                          id={`passkey-name-${passkey.id}`}
+                          type="text"
+                          maxLength={64}
+                          value={draftName}
+                          onChange={(e) => setDraftName(e.target.value)}
+                          onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                          required
+                          className="flex-1 min-w-[12rem] px-2 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+                        />
+                        <button type="submit" disabled={isBusy} className="text-xs font-semibold py-1 px-3 rounded text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50">
+                          {isBusy ? 'Saving…' : 'Save'}
+                        </button>
+                        <button type="button" onClick={() => setEditingId(null)} className="text-xs font-semibold py-1 px-3 rounded border border-gray-300 hover:bg-gray-50">
+                          Cancel
+                        </button>
+                      </form>
+                    ) : (
+                      <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+                    )}
+                    <p className="text-xs text-gray-500 mt-1">
+                      Added {dateFormat.format(new Date(passkey.createdAt))}
+                      {passkey.lastUsedAt ? ` · Last used ${dateFormat.format(new Date(passkey.lastUsedAt))}` : ' · Never used to sign in'}
+                      {passkey.provider && passkey.provider !== passkey.name ? ` · ${passkey.provider}` : ''}
+                      {passkey.backupEligible ? ' · Synced across devices' : ' · This device only'}
+                    </p>
+                  </div>
+
+                  {!isEditing && (
+                    <div className="flex items-center gap-2 sm:ml-auto">
+                      <button
+                        type="button"
+                        onClick={() => startEditing(passkey)}
+                        disabled={busy !== null}
+                        aria-label={`Rename ${passkey.name}`}
+                        className="text-xs font-semibold py-1 px-3 rounded border border-gray-300 hover:bg-gray-50 disabled:opacity-50"
+                      >
+                        Rename
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => handleRemove(passkey)}
+                        disabled={busy !== null}
+                        aria-label={`Remove ${passkey.name}`}
+                        className="text-xs font-semibold py-1 px-3 rounded border border-red-300 text-red-700 hover:bg-red-50 disabled:opacity-50"
+                      >
+                        {isBusy ? 'Removing…' : 'Remove'}
+                      </button>
+                    </div>
+                  )}
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
