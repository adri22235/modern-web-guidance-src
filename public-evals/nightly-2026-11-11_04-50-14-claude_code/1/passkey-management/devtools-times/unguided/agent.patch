@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { error, json, loadSignedInAccount, rejectCrossSite } from '../../../lib/api';
+import { getRpId, randomBase64Url, RP_NAME, SUPPORTED_ALGORITHMS } from '../../../lib/webauthn';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+/** Returns PublicKeyCredentialCreationOptions (JSON form) for registering a new passkey. */
+export const POST: APIRoute = async (context) => {
+  const rejected = rejectCrossSite(context.request);
+  if (rejected) return rejected;
+  const account = await loadSignedInAccount(context);
+  if (!account) return error('You need to sign in first.', 401);
+
+  const challenge = randomBase64Url(32);
+  context.session?.set('passkeyChallenge', { challenge, expiresAt: Date.now() + CHALLENGE_TTL_MS });
+
+  return json({
+    challenge,
+    rp: { id: getRpId(context.url), name: RP_NAME },
+    user: { id: account.userId, name: account.username, displayName: account.displayName },
+    pubKeyCredParams: SUPPORTED_ALGORITHMS.map((alg) => ({ type: 'public-key', alg })),
+    timeout: CHALLENGE_TTL_MS,
+    attestation: 'none',
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+    excludeCredentials: account.passkeys.map((p) => ({ type: 'public-key', id: p.id, transports: p.transports })),
+    hints: [],
+    extensions: { credProps: true },
+  });
+};
diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..7c1b013
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,88 @@
+import type { APIRoute } from 'astro';
+import { error, json, loadSignedInAccount, readJson, rejectCrossSite, serializeAccount } from '../../../lib/api';
+import { addPasskey, CredentialAlreadyRegisteredError } from '../../../lib/account-store';
+import {
+  fromBase64Url,
+  getRpId,
+  parseAuthenticatorData,
+  providerNameForAaguid,
+  sha256,
+  SUPPORTED_ALGORITHMS,
+} from '../../../lib/webauthn';
+
+interface RegistrationPayload {
+  id?: string;
+  type?: string;
+  response?: {
+    clientDataJSON?: string;
+    authenticatorData?: string;
+    publicKey?: string;
+    publicKeyAlgorithm?: number;
+    transports?: string[];
+  };
+}
+
+/** Verifies a navigator.credentials.create() response and saves the new passkey. */
+export const POST: APIRoute = async (context) => {
+  const rejected = rejectCrossSite(context.request);
+  if (rejected) return rejected;
+  const account = await loadSignedInAccount(context);
+  if (!account) return error('You need to sign in first.', 401);
+
+  const pending = await context.session?.get('passkeyChallenge');
+  context.session?.delete('passkeyChallenge');
+  if (!pending || pending.expiresAt < Date.now()) {
+    return error('The passkey request expired. Please try again.', 400);
+  }
+
+  const body = await readJson<RegistrationPayload>(context.request);
+  const res = body?.response;
+  if (
+    !body?.id ||
+    body.type !== 'public-key' ||
+    !res?.clientDataJSON ||
+    !res.authenticatorData ||
+    !res.publicKey ||
+    typeof res.publicKeyAlgorithm !== 'number'
+  ) {
+    return error('Malformed passkey registration.', 400);
+  }
+
+  try {
+    const clientData = JSON.parse(fromBase64Url(res.clientDataJSON).toString('utf8'));
+    if (clientData.type !== 'webauthn.create') throw new Error('Unexpected ceremony type.');
+    if (clientData.challenge !== pending.challenge) throw new Error('Challenge mismatch.');
+    if (clientData.origin !== context.url.origin) throw new Error('Origin mismatch.');
+    if (clientData.crossOrigin === true) throw new Error('Cross-origin registration is not allowed.');
+
+    const authData = parseAuthenticatorData(fromBase64Url(res.authenticatorData));
+    if (!authData.rpIdHash.equals(sha256(getRpId(context.url)))) throw new Error('RP ID mismatch.');
+    if (!authData.userPresent) throw new Error('User presence was not confirmed.');
+    if (!SUPPORTED_ALGORITHMS.includes(res.publicKeyAlgorithm)) throw new Error('Unsupported key algorithm.');
+
+    const provider = providerNameForAaguid(authData.aaguid);
+    const existingNames = new Set(account.passkeys.map((p) => p.name));
+    const baseName = provider ?? 'Passkey';
+    let name = baseName;
+    for (let i = 2; existingNames.has(name); i++) name = `${baseName} (${i})`;
+
+    const updated = await addPasskey(account.username, {
+      id: body.id,
+      name,
+      publicKey: res.publicKey,
+      algorithm: res.publicKeyAlgorithm,
+      signCount: authData.signCount,
+      transports: Array.isArray(res.transports) ? res.transports.filter((t) => typeof t === 'string') : [],
+      aaguid: authData.aaguid,
+      provider,
+      backupEligible: authData.backupEligible,
+      backedUp: authData.backedUp,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: null,
+    });
+    return json(serializeAccount(updated, context.url), 201);
+  } catch (err) {
+    if (err instanceof CredentialAlreadyRegisteredError) return error(err.message, 409);
+    return error(`Passkey verification failed: ${(err as Error).message}`, 400);
+  }
+};
