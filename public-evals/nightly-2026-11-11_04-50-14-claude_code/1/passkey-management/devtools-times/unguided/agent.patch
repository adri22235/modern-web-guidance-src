+import type { APIRoute } from 'astro';
+import { error, getSignedInUser, json, readJson, rejectCrossSite, serializeAccount } from '../../../lib/api';
+import { getOrCreateAccount, removePasskey, renamePasskey } from '../../../lib/account-store';
+
+const MAX_NAME_LENGTH = 64;
+
+export const PATCH: APIRoute = async (context) => {
+  const rejected = rejectCrossSite(context.request);
+  if (rejected) return rejected;
+  const user = await getSignedInUser(context);
+  if (!user) return error('You need to sign in first.', 401);
+
+  const body = await readJson<{ name?: unknown }>(context.request);
+  const name = typeof body?.name === 'string' ? body.name.trim() : '';
+  if (!name || name.length > MAX_NAME_LENGTH) {
+    return error(`Passkey names must be between 1 and ${MAX_NAME_LENGTH} characters.`, 400);
+  }
+
+  const passkey = await renamePasskey(user.username, context.params.id ?? '', name);
+  if (!passkey) return error('Passkey not found.', 404);
+  return json(serializeAccount(await getOrCreateAccount(user.username), context.url));
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const rejected = rejectCrossSite(context.request);
+  if (rejected) return rejected;
+  const user = await getSignedInUser(context);
+  if (!user) return error('You need to sign in first.', 401);
+
+  const account = await removePasskey(user.username, context.params.id ?? '');
+  if (!account) return error('Passkey not found.', 404);
+  return json(serializeAccount(account, context.url));
+};
