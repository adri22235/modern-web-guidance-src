@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { error, json, readJson, rejectCrossSite } from '../../../lib/api';
+import { getOrCreateAccount } from '../../../lib/account-store';
+
+const LOGIN_ENDPOINT = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Verifies credentials against the Times auth service server-side, then establishes a
+ * session so account pages (like passkey management) know who the reader is.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const rejected = rejectCrossSite(request);
+  if (rejected) return rejected;
+
+  const body = await readJson<{ username?: unknown; password?: unknown }>(request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password) return error('Username and password are required.', 400);
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return error('The sign-in service is unavailable. Please try again later.', 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json(data && typeof data === 'object' ? data : { error: 'Unknown error' }, upstream.status);
+  }
+
+  if (!session) return error('Sessions are not available.', 500);
+  await session.regenerate();
+  session.set('user', { username });
+  const account = await getOrCreateAccount(username);
+
+  return json({ username, displayName: account.displayName });
+};
