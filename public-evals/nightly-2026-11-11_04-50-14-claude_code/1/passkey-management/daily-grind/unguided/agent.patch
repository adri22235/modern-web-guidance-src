@@ -0,0 +1,504 @@
+/**
+ * Passkey management for "My Account".
+ *
+ * Expected backend contract (session-cookie authenticated, same origin):
+ *
+ *   GET    /api/account/passkeys
+ *     200 → {
+ *       rpId: "dailygrind.example",
+ *       user: { id: "<base64url user handle>", name: "jane@example.com", displayName: "Jane Doe" },
+ *       passkeys: [{
+ *         id: "<base64url credential ID>",
+ *         name: "MacBook Pro",
+ *         createdAt: "2026-01-02T10:00:00Z",
+ *         lastUsedAt: "2026-11-10T08:30:00Z" | null,
+ *         backedUp: true,                       // synced passkey (BS flag)
+ *         isCurrent: false,                     // used to sign in to this session
+ *         provider: { name: "iCloud Keychain", icon: "data:image/svg+xml;..." } | null  // from AAGUID
+ *       }]
+ *     }
+ *   PATCH  /api/account/passkeys/:id   body { name }  → 200 updated passkey object
+ *   DELETE /api/account/passkeys/:id                  → 204
+ *   Any endpoint → 401 when the session has expired.
+ *
+ * After every successful load and delete, the browser's authenticators are kept in sync via the
+ * WebAuthn Signal API (signalAllAcceptedCredentials / signalCurrentUserDetails) where supported.
+ *
+ * Append ?demo to the URL to try the UI with local sample data (no server, no signals).
+ */
+
+const API_BASE = '/api/account/passkeys';
+const MAX_NAME_LENGTH = 64;
+const DEMO = new URLSearchParams(location.search).has('demo');
+
+const els = {
+  status: document.getElementById('passkey-status'),
+  loading: document.getElementById('passkey-loading'),
+  list: document.getElementById('passkey-list'),
+  empty: document.getElementById('passkey-empty'),
+  syncNote: document.getElementById('sync-note'),
+  greeting: document.getElementById('account-greeting'),
+  template: document.getElementById('passkey-item-template'),
+  dialog: document.getElementById('delete-dialog'),
+  dialogName: document.getElementById('delete-dialog-name'),
+  dialogCurrent: document.getElementById('delete-dialog-current'),
+  dialogLast: document.getElementById('delete-dialog-last'),
+};
+
+/** @type {{ rpId: string, user: {id: string, name: string, displayName: string}, passkeys: any[] } | null} */
+let state = null;
+
+// ---------------------------------------------------------------------------
+// API layer
+// ---------------------------------------------------------------------------
+
+class ApiError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function csrfToken() {
+  return document.querySelector('meta[name="csrf-token"]')?.content || '';
+}
+
+async function request(path, { method = 'GET', body } = {}) {
+  const headers = { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' };
+  if (method !== 'GET') {
+    const token = csrfToken();
+    if (token) headers['X-CSRF-Token'] = token;
+  }
+  if (body !== undefined) headers['Content-Type'] = 'application/json';
+
+  let res;
+  try {
+    res = await fetch(path, {
+      method,
+      headers,
+      credentials: 'same-origin',
+      cache: 'no-store',
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError('We couldn’t reach the server. Check your connection and try again.', 0);
+  }
+
+  if (res.status === 401) {
+    location.assign(`/login?next=${encodeURIComponent(location.pathname + location.hash)}`);
+    throw new ApiError('Your session has expired. Redirecting to sign in…', 401);
+  }
+  if (res.status === 204) return null;
+
+  let data = null;
+  try {
+    data = await res.json();
+  } catch {
+    /* non-JSON body */
+  }
+  if (!res.ok) {
+    throw new ApiError(data?.error || data?.message || `Request failed (${res.status}).`, res.status);
+  }
+  return data;
+}
+
+const realApi = {
+  list: () => request(API_BASE),
+  rename: (id, name) =>
+    request(`${API_BASE}/${encodeURIComponent(id)}`, { method: 'PATCH', body: { name } }),
+  remove: (id) => request(`${API_BASE}/${encodeURIComponent(id)}`, { method: 'DELETE' }),
+};
+
+// Local sample data so the page can be exercised without a backend (?demo).
+const demoApi = (() => {
+  const KEY = 'dg-demo-passkeys';
+  const now = Date.now();
+  const day = 86_400_000;
+  const seed = {
+    rpId: location.hostname,
+    user: { id: 'ZGVtby11c2VyLTEyMw', name: 'jane@example.com', displayName: 'Jane Doe' },
+    passkeys: [
+      { id: 'cred-a1b2c3', name: 'MacBook Pro', createdAt: new Date(now - 120 * day).toISOString(),
+        lastUsedAt: new Date(now - 3600_000).toISOString(), backedUp: true, isCurrent: true,
+        provider: { name: 'iCloud Keychain' } },
+      { id: 'cred-d4e5f6', name: 'Pixel 8', createdAt: new Date(now - 60 * day).toISOString(),
+        lastUsedAt: new Date(now - 9 * day).toISOString(), backedUp: true, isCurrent: false,
+        provider: { name: 'Google Password Manager' } },
+      { id: 'cred-g7h8i9', name: 'YubiKey 5C', createdAt: new Date(now - 400 * day).toISOString(),
+        lastUsedAt: null, backedUp: false, isCurrent: false, provider: null },
+    ],
+  };
+  const load = () => {
+    try {
+      return JSON.parse(sessionStorage.getItem(KEY)) || structuredClone(seed);
+    } catch {
+      return structuredClone(seed);
+    }
+  };
+  const save = (d) => sessionStorage.setItem(KEY, JSON.stringify(d));
+  const delay = () => new Promise((r) => setTimeout(r, 300));
+  return {
+    async list() {
+      await delay();
+      return load();
+    },
+    async rename(id, name) {
+      await delay();
+      const d = load();
+      const pk = d.passkeys.find((p) => p.id === id);
+      if (!pk) throw new ApiError('Passkey not found.', 404);
+      pk.name = name;
+      save(d);
+      return pk;
+    },
+    async remove(id) {
+      await delay();
+      const d = load();
+      d.passkeys = d.passkeys.filter((p) => p.id !== id);
+      save(d);
+      return null;
+    },
+  };
+})();
+
+const api = DEMO ? demoApi : realApi;
+
+// ---------------------------------------------------------------------------
+// Authenticator sync (WebAuthn Signal API)
+// ---------------------------------------------------------------------------
+
+const signals = {
+  get supported() {
+    return (
+      !DEMO &&
+      typeof window.PublicKeyCredential !== 'undefined' &&
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+    );
+  },
+
+  /**
+   * Tell authenticators the complete set of credential IDs the server still accepts for this
+   * user, so they can hide/remove passkeys that were deleted here (or elsewhere).
+   * Only ever call this with a list freshly confirmed by the server — an incomplete list would
+   * cause valid passkeys to be hidden.
+   */
+  async syncAccepted() {
+    if (!this.supported || !state) return;
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: state.rpId,
+        userId: state.user.id,
+        allAcceptedCredentialIds: state.passkeys.map((p) => p.id),
+      });
+    } catch (err) {
+      console.warn('signalAllAcceptedCredentials failed', err);
+    }
+  },
+
+  /** Keep the account name / display name shown in passkey pickers up to date. */
+  async syncUserDetails() {
+    if (DEMO || !state || typeof PublicKeyCredential?.signalCurrentUserDetails !== 'function') return;
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId: state.rpId,
+        userId: state.user.id,
+        name: state.user.name,
+        displayName: state.user.displayName,
+      });
+    } catch (err) {
+      console.warn('signalCurrentUserDetails failed', err);
+    }
+  },
+};
+
+// ---------------------------------------------------------------------------
+// Rendering
+// ---------------------------------------------------------------------------
+
+let statusTimer;
+function setStatus(message, type = 'info', { sticky = false } = {}) {
+  clearTimeout(statusTimer);
+  els.status.className = `status ${type}`;
+  els.status.textContent = message;
+  if (message && !sticky && type !== 'error') {
+    statusTimer = setTimeout(() => (els.status.textContent = ''), 6000);
+  }
+}
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const relFmt = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function formatDate(iso) {
+  const d = iso ? new Date(iso) : null;
+  return d && !Number.isNaN(d.getTime()) ? dateFmt.format(d) : null;
+}
+
+function formatRelative(iso) {
+  const d = iso ? new Date(iso) : null;
+  if (!d || Number.isNaN(d.getTime())) return null;
+  const diffSec = (d.getTime() - Date.now()) / 1000;
+  const units = [
+    ['year', 31_536_000], ['month', 2_592_000], ['week', 604_800],
+    ['day', 86_400], ['hour', 3_600], ['minute', 60],
+  ];
+  for (const [unit, secs] of units) {
+    if (Math.abs(diffSec) >= secs) return relFmt.format(Math.round(diffSec / secs), unit);
+  }
+  return 'just now';
+}
+
+function displayName(pk) {
+  return pk.name?.trim() || pk.provider?.name || 'Unnamed passkey';
+}
+
+function renderItem(pk) {
+  const li = els.template.content.firstElementChild.cloneNode(true);
+  li.dataset.id = pk.id;
+
+  const nameEl = li.querySelector('.passkey-name');
+  nameEl.textContent = displayName(pk);
+  if (pk.isCurrent) nameEl.append(badge('This session'));
+  if (pk.backedUp) nameEl.append(badge('Synced', 'synced'));
+
+  const meta = [];
+  if (pk.provider?.name) meta.push(pk.provider.name);
+  const created = formatDate(pk.createdAt);
+  if (created) meta.push(`Added ${created}`);
+  meta.push(pk.lastUsedAt ? `Last used ${formatRelative(pk.lastUsedAt)}` : 'Never used');
+  li.querySelector('.passkey-meta').textContent = meta.join(' · ');
+
+  // Only trust provider icons that are inline images (AAGUID metadata ships data: URIs).
+  if (typeof pk.provider?.icon === 'string' && pk.provider.icon.startsWith('data:image/')) {
+    const img = document.createElement('img');
+    img.src = pk.provider.icon;
+    img.alt = '';
+    li.querySelector('.passkey-icon').replaceChildren(img);
+  }
+
+  const input = li.querySelector('input[name="name"]');
+  const inputId = `passkey-name-${cssSafe(pk.id)}`;
+  input.id = inputId;
+  input.maxLength = MAX_NAME_LENGTH;
+  li.querySelector('label').htmlFor = inputId;
+
+  li.querySelector('[data-action="rename"]').setAttribute('aria-label', `Rename ${displayName(pk)}`);
+  li.querySelector('[data-action="delete"]').setAttribute('aria-label', `Remove ${displayName(pk)}`);
+  return li;
+}
+
+function badge(text, cls = '') {
+  const b = document.createElement('span');
+  b.className = `badge ${cls}`.trim();
+  b.textContent = text;
+  return b;
+}
+
+function cssSafe(s) {
+  return String(s).replace(/[^a-zA-Z0-9_-]/g, '_');
+}
+
+function render() {
+  els.loading.hidden = true;
+  const passkeys = state?.passkeys ?? [];
+  els.list.replaceChildren(...passkeys.map(renderItem));
+  els.list.hidden = passkeys.length === 0;
+  els.empty.hidden = passkeys.length !== 0;
+  els.syncNote.hidden = !signals.supported;
+  if (state?.user?.displayName) {
+    els.greeting.textContent = `Signed in as ${state.user.displayName}`;
+  }
+}
+
+function findItem(id) {
+  return [...els.list.children].find((li) => li.dataset.id === id);
+}
+
+// ---------------------------------------------------------------------------
+// Actions
+// ---------------------------------------------------------------------------
+
+function validateName(raw) {
+  // Collapse whitespace and strip control characters.
+  const name = raw.replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim();
+  if (!name) return { error: 'Please enter a name.' };
+  if (name.length > MAX_NAME_LENGTH) return { error: `Names can be at most ${MAX_NAME_LENGTH} characters.` };
+  return { name };
+}
+
+function startRename(li) {
+  // Only one rename at a time.
+  els.list.querySelectorAll('.rename-form:not([hidden])').forEach((f) => cancelRename(f.closest('li')));
+  const pk = state.passkeys.find((p) => p.id === li.dataset.id);
+  const form = li.querySelector('.rename-form');
+  const input = form.querySelector('input');
+  li.querySelector('.passkey-view').hidden = true;
+  li.querySelector('.passkey-actions').hidden = true;
+  form.hidden = false;
+  form.querySelector('.field-error').textContent = '';
+  input.value = pk?.name ?? '';
+  input.focus();
+  input.select();
+}
+
+function cancelRename(li) {
+  li.querySelector('.rename-form').hidden = true;
+  li.querySelector('.passkey-view').hidden = false;
+  li.querySelector('.passkey-actions').hidden = false;
+  li.querySelector('[data-action="rename"]').focus();
+}
+
+async function submitRename(li, form) {
+  const id = li.dataset.id;
+  const pk = state.passkeys.find((p) => p.id === id);
+  const errorEl = form.querySelector('.field-error');
+  const { name, error } = validateName(form.elements.name.value);
+  if (error) {
+    errorEl.textContent = error;
+    form.elements.name.focus();
+    return;
+  }
+  if (pk && name === pk.name) {
+    cancelRename(li);
+    return;
+  }
+
+  setBusy(form, true);
+  try {
+    const updated = await api.rename(id, name);
+    Object.assign(pk, updated && typeof updated === 'object' ? updated : { name });
+    const fresh = renderItem(pk);
+    li.replaceWith(fresh);
+    fresh.querySelector('[data-action="rename"]').focus();
+    setStatus(`Passkey renamed to “${displayName(pk)}”.`, 'success');
+  } catch (err) {
+    if (err.status === 404) return handleMissing(id);
+    errorEl.textContent = err.message;
+    setBusy(form, false);
+  }
+}
+
+/** Ask for confirmation using the <dialog>. Resolves true if confirmed. */
+function confirmDelete(pk) {
+  els.dialogName.textContent = displayName(pk);
+  els.dialogCurrent.hidden = !pk.isCurrent;
+  els.dialogLast.hidden = state.passkeys.length !== 1;
+
+  if (typeof els.dialog.showModal !== 'function') {
+    return Promise.resolve(window.confirm(`Remove passkey “${displayName(pk)}”?`));
+  }
+  return new Promise((resolve) => {
+    els.dialog.returnValue = '';
+    els.dialog.addEventListener('close', () => resolve(els.dialog.returnValue === 'confirm'), { once: true });
+    els.dialog.showModal();
+  });
+}
+
+async function deletePasskey(li) {
+  const id = li.dataset.id;
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+  const deleteBtn = li.querySelector('[data-action="delete"]');
+
+  if (!(await confirmDelete(pk))) {
+    deleteBtn.focus();
+    return;
+  }
+
+  setBusy(li, true);
+  try {
+    await api.remove(id);
+  } catch (err) {
+    // Already gone server-side → treat as success and resync.
+    if (err.status !== 404) {
+      setBusy(li, false);
+      setStatus(`Couldn’t remove “${displayName(pk)}”: ${err.message}`, 'error');
+      deleteBtn.focus();
+      return;
+    }
+  }
+  const name = displayName(pk);
+  await refreshAfterDelete(id, li, signals.supported
+    ? `“${name}” was removed. Your browser has been told to stop offering it.`
+    : `“${name}” was removed. You may also want to delete it from your device’s password manager.`);
+}
+
+async function refreshAfterDelete(id, li, message) {
+  const nextFocus = li?.nextElementSibling || li?.previousElementSibling;
+  // Re-fetch so the list we signal to authenticators is authoritative (it also picks up changes
+  // made on other devices). Fall back to local removal if the refresh fails, but skip signalling
+  // in that case so we never hide passkeys based on a guess.
+  try {
+    state = await api.list();
+    render();
+    await signals.syncAccepted();
+  } catch {
+    state.passkeys = state.passkeys.filter((p) => p.id !== id);
+    render();
+  }
+  setStatus(message, 'success', { sticky: true });
+  const focusTarget = nextFocus && findItem(nextFocus.dataset.id);
+  (focusTarget?.querySelector('[data-action="rename"]') || els.status).focus?.();
+}
+
+async function handleMissing(id) {
+  await refreshAfterDelete(id, findItem(id),
+    'That passkey no longer exists — it may have been removed on another device. Your list has been refreshed.');
+}
+
+function setBusy(container, busy) {
+  container.setAttribute('aria-busy', String(busy));
+  container.querySelectorAll('button, input').forEach((el) => (el.disabled = busy));
+}
+
+// ---------------------------------------------------------------------------
+// Wiring
+// ---------------------------------------------------------------------------
+
+els.list.addEventListener('click', (e) => {
+  const btn = e.target.closest('button[data-action]');
+  if (!btn) return;
+  const li = btn.closest('li.passkey');
+  switch (btn.dataset.action) {
+    case 'rename':
+      startRename(li);
+      break;
+    case 'cancel-rename':
+      cancelRename(li);
+      break;
+    case 'delete':
+      deletePasskey(li);
+      break;
+  }
+});
+
+els.list.addEventListener('submit', (e) => {
+  const form = e.target.closest('.rename-form');
+  if (!form) return;
+  e.preventDefault();
+  submitRename(form.closest('li.passkey'), form);
+});
+
+els.list.addEventListener('keydown', (e) => {
+  if (e.key === 'Escape' && e.target.matches('.rename-form input')) {
+    e.preventDefault();
+    cancelRename(e.target.closest('li.passkey'));
+  }
+});
+
+els.status.tabIndex = -1;
+
+async function init() {
+  if (DEMO) setStatus('Demo mode: showing sample passkeys stored only in this browser tab.', 'info', { sticky: true });
+  try {
+    state = await api.list();
+    if (!state || !Array.isArray(state.passkeys)) throw new ApiError('Unexpected response from server.', 500);
+    render();
+    // Bring authenticators in line with the server on every visit.
+    await Promise.all([signals.syncAccepted(), signals.syncUserDetails()]);
+  } catch (err) {
+    els.loading.hidden = true;
+    if (err.status !== 401) setStatus(`We couldn’t load your passkeys. ${err.message}`, 'error');
+  }
+}
+
+init();
