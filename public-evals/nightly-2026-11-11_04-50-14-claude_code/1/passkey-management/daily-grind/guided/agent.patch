@@ -0,0 +1,161 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs"
+      },
+      "integrity": {
+        "https://esm.sh/webauthn-polyfills@0.1.7/es2022/webauthn-polyfills.bundle.mjs": "sha384-EBLK1vCYl7ILfHGSetlZN/n8TaV5nbYKx9JrMwcJvy5NTITz1Q9HDYqCG4NxzuR0"
+      }
+    }
+  </script>
+  <link rel="stylesheet" href="account.css">
+  <script type="module" src="passkeys.js"></script>
+</head>
+
+<body>
+
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
