+  <script>
+    (function () {
+      var THRESHOLD_RATIO = 0.4;   // fraction of item width needed to trigger removal
+      var INTENT_SLOP = 8;         // px moved before deciding horizontal vs vertical
+
+      var list = document.querySelector('.SwipeableList');
+      if (!list) return;
+      var section = list.closest('.cart');
+      var emptyMsg = section.querySelector('.cart-empty');
+      var totalEl = section.querySelector('.cart-total');
+      var totalAmount = section.querySelector('.cart-total-amount');
+      var live = section.querySelector('[aria-live]');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function updateCart() {
+        var items = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        var total = 0;
+        items.forEach(function (li) { total += parseFloat(li.dataset.price) || 0; });
+        totalAmount.textContent = '$' + total.toFixed(2);
+        var empty = items.length === 0;
+        emptyMsg.hidden = !empty;
+        totalEl.hidden = empty;
+      }
+
+      function removeItem(item, direction) {
+        if (item.classList.contains('is-removing')) return;
+        var content = item.querySelector('.SwipeableList-content');
+        var name = item.querySelector('.SwipeableList-name').textContent;
+
+        // Move focus to a neighbour so keyboard users don't lose their place.
+        var next = item.nextElementSibling || item.previousElementSibling;
+        var hadFocus = item.contains(document.activeElement);
+
+        item.classList.add('is-removing', 'is-past-threshold');
+        item.classList.remove('is-dragging');
+
+        // 1) Slide content fully off-screen, revealing the action color.
+        item.classList.add('is-settling');
+        content.style.transform = 'translateX(' + (direction < 0 ? '-' : '') + '100%)';
+
+        var slideDone = false;
+        function collapse() {
+          if (slideDone) return;
+          slideDone = true;
+          // 2) Collapse height smoothly from its current pixel height to 0.
+          item.style.height = item.offsetHeight + 'px';
+          void item.offsetHeight; // force reflow so the transition starts from the fixed height
+          item.style.height = '0px';
+          item.style.marginBottom = '0px';
+          item.style.opacity = '0';
+
+          var removed = false;
+          function finish() {
+            if (removed) return;
+            removed = true;
+            item.remove();
+            updateCart();
+          }
+          item.addEventListener('transitionend', function onEnd(e) {
+            if (e.target === item && e.propertyName === 'height') {
+              item.removeEventListener('transitionend', onEnd);
+              finish();
+            }
+          });
+          setTimeout(finish, reducedMotion.matches ? 50 : 500); // fallback
+        }
+        content.addEventListener('transitionend', function onSlide(e) {
+          if (e.target === content && e.propertyName === 'transform') {
+            content.removeEventListener('transitionend', onSlide);
+            collapse();
+          }
+        });
+        setTimeout(collapse, reducedMotion.matches ? 20 : 350); // fallback
+
+        updateCart();
+        live.textContent = name + ' removed from cart.';
+        if (hadFocus && next && !next.classList.contains('is-removing')) {
+          next.querySelector('.SwipeableList-content').focus();
+        }
+      }
+
+      function initItem(item) {
+        if (item.classList.contains('is-initialized')) return;
+        var content = item.querySelector('.SwipeableList-content');
+        if (!content) return;
+
+        var pointerId = null;
+        var startX = 0, startY = 0, dx = 0;
+        var intent = null; // 'horizontal' | 'vertical' | null
+
+        function setOffset(x) {
+          content.style.transform = x ? 'translateX(' + x + 'px)' : '';
+          var threshold = item.offsetWidth * THRESHOLD_RATIO;
+          item.classList.toggle('is-swiping-left', x < 0);
+          item.classList.toggle('is-swiping-right', x > 0);
+          item.classList.toggle('is-past-threshold', Math.abs(x) >= threshold);
+        }
+
+        function reset() {
+          pointerId = null;
+          intent = null;
+          item.classList.remove('is-dragging');
+        }
+
+        content.addEventListener('pointerdown', function (e) {
+          if (item.classList.contains('is-removing')) return;
+          if (e.pointerType === 'mouse' && e.button !== 0) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          intent = null;
+          item.classList.remove('is-settling');
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var mx = e.clientX - startX;
+          var my = e.clientY - startY;
+
+          if (!intent) {
+            if (Math.abs(mx) < INTENT_SLOP && Math.abs(my) < INTENT_SLOP) return;
+            intent = Math.abs(mx) > Math.abs(my) ? 'horizontal' : 'vertical';
+            if (intent === 'vertical') { reset(); return; }
+            content.setPointerCapture(pointerId);
+            item.classList.add('is-dragging');
+          }
+
+          e.preventDefault();
+          dx = mx;
+          setOffset(dx);
+        });
+
+        function release(e) {
+          if (e.pointerId !== pointerId) return;
+          var wasDragging = intent === 'horizontal';
+          var cancelled = e.type === 'pointercancel';
+          reset();
+          if (!wasDragging) return;
+
+          if (!cancelled && Math.abs(dx) >= item.offsetWidth * THRESHOLD_RATIO) {
+            removeItem(item, dx < 0 ? -1 : 1);
+          } else {
+            // Snap back into place.
+            item.classList.add('is-settling');
+            setOffset(0);
+          }
+          dx = 0;
+        }
+
+        content.addEventListener('pointerup', release);
+        content.addEventListener('pointercancel', release);
+        content.addEventListener('lostpointercapture', function (e) {
+          if (pointerId !== null) release(e);
+        });
+
+        content.addEventListener('keydown', function (e) {
+          if (e.key === 'Delete' || e.key === 'Backspace') {
+            e.preventDefault();
+            removeItem(item, -1);
+          }
+        });
+
+        item.classList.add('is-initialized');
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(initItem);
+      updateCart();
+    })();
+  </script>
+
