@@ -134,8 +134,124 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 24px;
+    }
+
+    /* Card whose content is clipped to its padding (content) box, so the
+       child corners follow the card's inner curve (outer radius - padding). */
+    .nested-curve-parent {
+      --radius: 28px;
+      --pad: 12px;
+      background: var(--primary);
+      padding: var(--pad);
+      border-radius: var(--radius);
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
+      overflow: clip;
+      overflow-clip-margin: content-box;
+      display: flex;
+      flex-direction: column;
+      gap: var(--pad);
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .nested-body {
+      background: var(--light);
+      padding: 20px;
+    }
+
+    .nested-curve-parent .nested-body h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    /* Promo that clips overflowing text but leaves a safety zone around its
+       edges so the button's outer glow is not cut off. */
+    .safety-zone-parent {
+      --glow: 24px;
+      position: relative;
+      background: linear-gradient(135deg, #3e2723, #6d4c41);
+      color: white;
+      border-radius: 16px;
+      padding: 32px;
+      overflow: clip;
+      overflow-clip-margin: var(--glow);
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      gap: 12px;
+    }
+
+    /* Decorative oversized text, clipped exactly at the card's edge by its own
+       layer so it never spills into the glow safety zone. */
+    .safety-zone-parent .promo-watermark {
+      position: absolute;
+      inset: 0;
+      border-radius: inherit;
+      overflow: hidden;
+      pointer-events: none;
+    }
+
+    .safety-zone-parent .promo-watermark span {
+      position: absolute;
+      left: -0.05em;
+      bottom: -0.2em;
+      font-size: 9rem;
+      font-weight: 800;
+      line-height: 1;
+      white-space: nowrap;
+      color: rgba(255, 255, 255, 0.06);
+    }
+
+    .safety-zone-parent > :not(.promo-watermark) {
+      position: relative;
+    }
+
+    .safety-zone-parent h3 {
+      font-size: 1.6rem;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+
+    .safety-zone-parent p {
+      display: -webkit-box;
+      -webkit-line-clamp: 3;
+      -webkit-box-orient: vertical;
+      overflow: hidden;
+    }
+
+    .glow-btn {
+      position: relative;
+      align-self: flex-start;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      padding: 12px 26px;
+      border-radius: 999px;
+      text-decoration: none;
+      box-shadow: 0 0 calc(var(--glow) * 0.75) 4px rgba(255, 171, 64, 0.7);
+      transition: box-shadow 0.3s;
+    }
+
+    .glow-btn:hover {
+      box-shadow: 0 0 var(--glow) 8px rgba(255, 171, 64, 0.85);
+    }
+
