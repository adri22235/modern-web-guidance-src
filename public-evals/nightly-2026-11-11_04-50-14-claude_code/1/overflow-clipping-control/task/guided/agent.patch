+    /* Showcase Section */
+    .showcase {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 40px;
+      align-items: start;
+    }
+
+    /* Nested curves: padded, rounded card that clips children to its inner curve */
+    .nested-curve-parent {
+      --card-radius: 28px;
+      --card-pad: 12px;
+      background: var(--primary);
+      padding: var(--card-pad);
+      border-radius: var(--card-radius);
+      box-shadow: 0 6px 18px rgba(62, 39, 35, 0.25);
+      display: flex;
+      flex-direction: column;
+      gap: var(--card-pad);
+      /* Fallback: clips at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      background: var(--secondary);
+      color: var(--text);
+      padding: 14px 18px;
+    }
+
+    .nested-curve-footer h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        /* overflow: clip is required for overflow-clip-margin to apply */
+        overflow: clip;
+        /* Clip edge follows the inner (content-box) curve automatically */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    @supports not (overflow-clip-margin: content-box) {
+      /* Fallback: round the outer child corners to the concentric inner radius manually */
+      .nested-curve-parent img {
+        border-radius: calc(var(--card-radius) - var(--card-pad)) calc(var(--card-radius) - var(--card-pad)) 0 0;
+      }
+
+      .nested-curve-footer {
+        border-radius: 0 0 calc(var(--card-radius) - var(--card-pad)) calc(var(--card-radius) - var(--card-pad));
+      }
+    }
+
+    /* Safety zone: clips overflowing text but lets the button glow bleed out */
+    .safety-zone-parent {
+      background: linear-gradient(135deg, #3e2723, #6d4c41);
+      color: white;
+      padding: 28px 28px 10px;
+      border-radius: 16px;
+      /* Fallback: clips overflowing content (and truncates the glow) */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      font-size: 1.6rem;
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .promo-ticker {
+      white-space: nowrap;
+      font-size: 0.85rem;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+      opacity: 0.75;
+      margin-bottom: 12px;
+    }
+
+    .promo-glow-btn {
+      display: block;
+      width: 100%;
+      margin-top: 16px;
+      padding: 12px 20px;
+      border: none;
+      border-radius: 8px;
+      background: var(--accent);
+      color: var(--text);
+      font: inherit;
+      font-weight: bold;
+      cursor: pointer;
+      box-shadow: 0 8px 14px rgba(255, 171, 64, 0.7);
+    }
+
+    .promo-glow-btn:hover {
+      box-shadow: 0 8px 18px rgba(255, 171, 64, 0.9);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* Safety zone lets the button glow render past the container edge */
+        overflow-clip-margin: 15px;
+      }
+    }
+
