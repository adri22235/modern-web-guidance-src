diff --git a/src/components/PrivacyConsent.astro b/src/components/PrivacyConsent.astro
new file mode 100644
index 0000000..27403a4
--- /dev/null
+++ b/src/components/PrivacyConsent.astro
@@ -0,0 +1,172 @@
+---
+/**
+ * Privacy-by-design consent manager.
+ *
+ * - Nothing optional loads until the visitor actively opts in (no pre-ticked boxes,
+ *   "Reject" is as prominent as "Accept").
+ * - Global Privacy Control (GPC) / Do Not Track signals are honoured as a refusal.
+ * - The analytics script is never loaded on authentication pages.
+ * - The choice is stored only in this browser (localStorage) — no cookie, no server copy.
+ * - Visitors can change their mind at any time via any element with
+ *   `data-privacy-preferences` (e.g. the footer link).
+ */
+const baseUrl = import.meta.env.BASE_URL;
+const privacyUrl = `${baseUrl.replace(/\/?$/, "/")}legal/privacy`;
+---
+
+<div
+  id="privacy-consent"
+  transition:persist
+  role="dialog"
+  aria-modal="false"
+  aria-labelledby="privacy-consent-title"
+  aria-describedby="privacy-consent-desc"
+  hidden
+  class="fixed inset-x-0 bottom-0 z-50 p-4"
+>
+  <div class="max-w-3xl mx-auto bg-white border border-gray-300 rounded-lg shadow-lg p-5 text-sm text-gray-800">
+    <h2 id="privacy-consent-title" class="text-base font-bold mb-2">Your privacy choices</h2>
+    <div id="privacy-consent-desc" class="space-y-2">
+      <p>
+        We only use what is strictly necessary to run this site by default. With your permission we would
+        also load an <strong>optional analytics script</strong> (provided via Google Cloud) that records which
+        links and buttons are clicked (element type, its visible label and a timestamp) so we can improve our
+        journalism. It does not run on the sign-in and sign-up pages.
+      </p>
+      <p>
+        You can change your choice at any time with “Manage Privacy Preferences” in the footer.
+        <a href={privacyUrl} class="underline" data-skip-tracking="true">Read our Privacy Policy</a>.
+      </p>
+      <p id="privacy-consent-gpc" hidden class="text-gray-600">
+        Your browser sends a Global Privacy Control / Do Not Track signal, so analytics stays off unless you
+        explicitly allow it here.
+      </p>
+    </div>
+    <div class="mt-4 flex flex-wrap gap-3">
+      <button
+        type="button"
+        data-consent-choice="reject"
+        data-skip-tracking="true"
+        class="flex-1 min-w-[10rem] py-2 px-4 rounded-md border border-gray-900 bg-gray-900 text-white font-medium hover:bg-gray-800"
+      >
+        Reject analytics
+      </button>
+      <button
+        type="button"
+        data-consent-choice="accept"
+        data-skip-tracking="true"
+        class="flex-1 min-w-[10rem] py-2 px-4 rounded-md border border-gray-900 bg-gray-900 text-white font-medium hover:bg-gray-800"
+      >
+        Allow analytics
+      </button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STORAGE_KEY = "dtt-privacy-consent";
+  const CONSENT_VERSION = 1;
+  const ANALYTICS_SRC =
+    "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js";
+  // Pages where no optional third-party code may ever run.
+  const SENSITIVE_PATHS = /\/(signin|signup)\/?$/;
+
+  type Consent = { version: number; analytics: boolean; decidedAt: string };
+
+  function readConsent(): Consent | null {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (!raw) return null;
+      const parsed = JSON.parse(raw) as Consent;
+      // Re-ask when the purposes we request consent for change.
+      return parsed && parsed.version === CONSENT_VERSION ? parsed : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function writeConsent(analytics: boolean) {
+    const consent: Consent = {
+      version: CONSENT_VERSION,
+      analytics,
+      decidedAt: new Date().toISOString().slice(0, 10), // day precision is enough
+    };
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
+    } catch {
+      /* storage unavailable: fall back to "no consent" behaviour */
+    }
+  }
+
+  function hasPrivacySignal(): boolean {
+    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+    return nav.globalPrivacyControl === true || navigator.doNotTrack === "1";
+  }
+
+  function getBanner() {
+    return document.getElementById("privacy-consent");
+  }
+
+  function showBanner(show: boolean) {
+    const banner = getBanner();
+    if (!banner) return;
+    banner.hidden = !show;
+    const gpcNote = document.getElementById("privacy-consent-gpc");
+    if (gpcNote) gpcNote.hidden = !hasPrivacySignal();
+    if (show) banner.querySelector<HTMLButtonElement>("[data-consent-choice]")?.focus();
+  }
+
+  let analyticsLoaded = false;
+  function loadAnalytics() {
+    if (analyticsLoaded || SENSITIVE_PATHS.test(location.pathname)) return;
+    analyticsLoaded = true;
+    const script = document.createElement("script");
+    script.src = ANALYTICS_SRC;
+    script.defer = true;
+    script.referrerPolicy = "no-referrer";
+    document.head.appendChild(script);
+  }
+
+  function apply() {
+    const consent = readConsent();
+    if (consent?.analytics) {
+      loadAnalytics();
+    }
+    // Ask only when no decision exists and the browser hasn't already said "no".
+    showBanner(!consent && !hasPrivacySignal() && !SENSITIVE_PATHS.test(location.pathname));
+  }
+
+  document.addEventListener("click", (event) => {
+    const target = event.target as Element | null;
+    if (!target) return;
+
+    const choice = target.closest<HTMLElement>("[data-consent-choice]");
+    if (choice) {
+      const accepted = choice.dataset.consentChoice === "accept";
+      writeConsent(accepted);
+      showBanner(false);
+      if (accepted) {
+        loadAnalytics();
+      } else if (analyticsLoaded) {
+        // A loaded script can't be unloaded; reload so withdrawal takes effect immediately.
+        location.reload();
+      }
+      return;
+    }
+
+    if (target.closest("[data-privacy-preferences]")) {
+      event.preventDefault();
+      showBanner(true);
+    }
+  });
+
+  document.addEventListener("keydown", (event) => {
+    const banner = getBanner();
+    if (event.key === "Escape" && banner && !banner.hidden && readConsent()) {
+      showBanner(false);
+    }
+  });
+
+  // Runs on first load and after every client-side navigation.
+  document.addEventListener("astro:page-load", apply);
+</script>
