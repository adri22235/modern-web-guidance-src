diff --git a/src/components/authPrivacy.ts b/src/components/authPrivacy.ts
new file mode 100644
index 0000000..bacf3db
--- /dev/null
+++ b/src/components/authPrivacy.ts
@@ -0,0 +1,31 @@
+/**
+ * Shared privacy helpers for the sign-in / sign-up forms.
+ */
+export const AUTH_API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/**
+ * Fetch options for credential submissions:
+ * - no ambient cookies are sent to the third-party auth endpoint,
+ * - no Referer header (the page URL is not disclosed),
+ * - responses are never cached.
+ */
+export function authRequestInit(body: Record<string, string>): RequestInit {
+  return {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body),
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'no-store',
+  };
+}
+
+/**
+ * Attributes for credential inputs: disable spell-checking (browsers' "enhanced"
+ * spell-check can send field contents to a cloud service) and auto-capitalisation.
+ */
+export const credentialInputProps = {
+  spellCheck: false,
+  autoCapitalize: 'none',
+  autoCorrect: 'off',
+} as const;
