diff --git a/src/components/PrivacyConsent.astro b/src/components/PrivacyConsent.astro
new file mode 100644
index 0000000..1d6233f
--- /dev/null
+++ b/src/components/PrivacyConsent.astro
@@ -0,0 +1,176 @@
+---
+/**
+ * Privacy-by-design consent manager.
+ *
+ * - No third-party script is loaded until the visitor actively opts in.
+ * - "Reject" is as prominent as "Accept" and is the default.
+ * - Global Privacy Control / Do Not Track signals are honoured as a refusal.
+ * - Pages flagged as sensitive (sign-in / sign-up) never load third parties.
+ * - The choice is stored only in first-party localStorage (no cookie, never
+ *   sent to a server) and can be changed at any time via the footer link.
+ */
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<div
+  id="privacy-consent"
+  role="region"
+  aria-labelledby="privacy-consent-title"
+  hidden
+  class="fixed inset-x-0 bottom-0 z-[100] p-4 sm:p-6"
+>
+  <div class="max-w-3xl mx-auto bg-white border border-gray-300 rounded-lg shadow-lg p-5 text-sm text-gray-700">
+    <h2 id="privacy-consent-title" class="text-base font-bold text-gray-900 mb-2">
+      Your privacy choices
+    </h2>
+    <p class="mb-2">
+      We only use what is strictly necessary to run this site by default. With your
+      permission, we would also load an <strong>analytics script</strong> from
+      <code class="text-xs">us-central1-web-devrel-apps.cloudfunctions.net</code> that records
+      which links and buttons you click (element type, its visible text and a timestamp) to
+      help us improve the site. Your IP address and browser details are visible to that
+      provider when the script loads.
+    </p>
+    <p class="mb-4">
+      Analytics is never loaded on sign-in or sign-up pages, and you can change your choice at
+      any time via “Manage Privacy Preferences” in the footer. Details are in our
+      <a href={`${baseUrl}legal/privacy`} class="underline">Privacy Policy</a>.
+    </p>
+    <p id="privacy-consent-gpc" hidden class="mb-4 text-xs text-gray-600">
+      Your browser sends a Global Privacy Control or Do Not Track signal, so analytics stays
+      off unless you explicitly allow it here.
+    </p>
+    <div class="flex flex-col sm:flex-row gap-3 sm:justify-end">
+      <button
+        type="button"
+        data-consent="reject"
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md text-sm font-medium border border-gray-900 text-gray-900 bg-white hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+      >
+        Reject analytics
+      </button>
+      <button
+        type="button"
+        data-consent="accept"
+        data-skip-tracking="true"
+        class="py-2 px-4 rounded-md text-sm font-medium border border-gray-900 text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+      >
+        Allow analytics
+      </button>
+    </div>
+  </div>
+</div>
+
+<script>
+  const STORAGE_KEY = 'dtt-privacy-consent';
+  // Bump when the purposes or vendors change so visitors are asked again.
+  const CONSENT_VERSION = 1;
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+  type Consent = { version: number; analytics: boolean; updatedAt: string };
+
+  function readConsent(): Consent | null {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (!raw) return null;
+      const parsed = JSON.parse(raw) as Consent;
+      return parsed.version === CONSENT_VERSION ? parsed : null;
+    } catch {
+      return null;
+    }
+  }
+
+  function writeConsent(analytics: boolean) {
+    const consent: Consent = {
+      version: CONSENT_VERSION,
+      analytics,
+      updatedAt: new Date().toISOString(),
+    };
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
+    } catch {
+      // Storage unavailable (e.g. blocked): the choice applies to this page only.
+    }
+    return consent;
+  }
+
+  function browserOptsOut() {
+    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+    return nav.globalPrivacyControl === true || nav.doNotTrack === '1';
+  }
+
+  function isSensitivePage() {
+    return document.documentElement.hasAttribute('data-sensitive-page');
+  }
+
+  let analyticsLoaded = false;
+
+  function loadAnalytics() {
+    if (analyticsLoaded || isSensitivePage()) return;
+    analyticsLoaded = true;
+    const script = document.createElement('script');
+    script.src = ANALYTICS_SRC;
+    script.defer = true;
+    script.referrerPolicy = 'no-referrer';
+    document.head.appendChild(script);
+  }
+
+  function showBanner(show: boolean) {
+    const banner = document.getElementById('privacy-consent');
+    if (!banner) return;
+    banner.hidden = !show;
+    const gpcNote = document.getElementById('privacy-consent-gpc');
+    if (gpcNote) gpcNote.hidden = !browserOptsOut();
+    if (show) banner.querySelector<HTMLButtonElement>('[data-consent="reject"]')?.focus();
+  }
+
+  function applyChoice(analytics: boolean) {
+    const hadAnalytics = analyticsLoaded;
+    writeConsent(analytics);
+    showBanner(false);
+    if (analytics) {
+      loadAnalytics();
+    } else if (hadAnalytics) {
+      // A loaded third-party script cannot be reliably unloaded; reload so
+      // withdrawing consent takes effect immediately.
+      location.reload();
+    }
+  }
+
+  function init() {
+    const consent = readConsent();
+
+    if (consent?.analytics) {
+      loadAnalytics();
+    }
+    // Ask only when no valid choice exists. With GPC/DNT active we treat the
+    // signal as a refusal and do not nag; the footer link still allows opt-in.
+    showBanner(!consent && !browserOptsOut() && !isSensitivePage());
+  }
+
+  // Event delegation survives ClientRouter page swaps.
+  document.addEventListener('click', (event) => {
+    const target = event.target as HTMLElement | null;
+    const choice = target?.closest<HTMLElement>('[data-consent]');
+    if (choice) {
+      applyChoice(choice.dataset.consent === 'accept');
+      return;
+    }
+    const manage = target?.closest<HTMLElement>('[data-open-privacy-preferences]');
+    if (manage) {
+      event.preventDefault();
+      showBanner(true);
+    }
+  });
+
+  document.addEventListener('keydown', (event) => {
+    if (event.key === 'Escape') {
+      const banner = document.getElementById('privacy-consent');
+      // Escape dismisses for now without recording consent (nothing is loaded).
+      if (banner && !banner.hidden) banner.hidden = true;
+    }
+  });
+
+  document.addEventListener('astro:page-load', init);
+</script>
