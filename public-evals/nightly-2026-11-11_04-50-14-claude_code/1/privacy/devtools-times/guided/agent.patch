diff --git a/src/components/AuthPrivacyNotice.tsx b/src/components/AuthPrivacyNotice.tsx
new file mode 100644
index 0000000..a5111ac
--- /dev/null
+++ b/src/components/AuthPrivacyNotice.tsx
@@ -0,0 +1,70 @@
+const baseUrl = import.meta.env.BASE_URL;
+
+/** The only host that receives account credentials. Keep in sync with the privacy policy. */
+export const AUTH_SERVICE_ORIGIN = 'https://us-central1-web-devrel-apps.cloudfunctions.net';
+export const AUTH_API_BASE = `${AUTH_SERVICE_ORIGIN}/times_cdn/api`;
+
+/**
+ * Request options for credential submissions: send nothing beyond the JSON
+ * body (no cookies, no referrer revealing the page) and never cache.
+ */
+export const AUTH_FETCH_OPTIONS: RequestInit = {
+  method: 'POST',
+  headers: { 'Content-Type': 'application/json' },
+  credentials: 'omit',
+  referrerPolicy: 'no-referrer',
+  cache: 'no-store',
+};
+
+type Props = { mode: 'signin' | 'signup' };
+
+/** Just-in-time notice explaining what is collected, by whom, and why. */
+export default function AuthPrivacyNotice({ mode }: Props) {
+  return (
+    <section
+      aria-labelledby={`${mode}-privacy-heading`}
+      className="mt-6 p-3 text-xs text-gray-600 bg-gray-50 border border-gray-200 rounded-md"
+    >
+      <h3 id={`${mode}-privacy-heading`} className="font-semibold text-gray-700 mb-1">
+        How we handle your data
+      </h3>
+      <ul className="list-disc pl-4 space-y-1">
+        <li>
+          {mode === 'signup'
+            ? 'We only ask for a username and a password. No email address, real name or other personal details are needed.'
+            : 'Only your username and password are sent, solely to verify your identity.'}
+        </li>
+        <li>
+          They are sent over an encrypted connection to our account service hosted on Google
+          Cloud (<code>us-central1-web-devrel-apps.cloudfunctions.net</code>), without cookies
+          or referrer information.
+        </li>
+        <li>
+          Analytics and ads are never loaded on this page, and the form’s buttons are excluded
+          from click tracking everywhere.
+        </li>
+        <li>
+          {mode === 'signup'
+            ? 'You can request access to, or deletion of, your account data at any time (see the Privacy Policy).'
+            : 'We don’t store your password in your browser; your password manager may offer to save it.'}
+        </li>
+      </ul>
+      <p className="mt-2">
+        {mode === 'signup' && (
+          <>
+            By creating an account you agree to our{' '}
+            <a href={`${baseUrl}legal/terms`} className="underline" data-skip-tracking="true">
+              Terms of Service
+            </a>
+            .{' '}
+          </>
+        )}
+        Read the{' '}
+        <a href={`${baseUrl}legal/privacy`} className="underline" data-skip-tracking="true">
+          Privacy Policy
+        </a>{' '}
+        for details.
+      </p>
+    </section>
+  );
+}
