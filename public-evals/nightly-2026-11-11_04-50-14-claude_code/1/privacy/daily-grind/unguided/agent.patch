--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,154 @@
+#!/usr/bin/env node
+/**
+ * Privacy & third-party audit for The Daily Grind static site.
+ *
+ * Fails (exit 1) when:
+ *  - any HTML/CSS/JS file references an external origin that is not in the
+ *    audited register privacy/third-parties.json;
+ *  - inline <script>, inline <style>, style="" or on*="" handlers appear
+ *    (these would require weakening the CSP with 'unsafe-inline');
+ *  - an HTML page lacks the CSP / referrer meta tags, or its CSP diverges
+ *    from the one in _headers;
+ *  - required security headers are missing from _headers;
+ *  - target="_blank" links lack rel="noopener noreferrer";
+ *  - forms send data over GET to non-search endpoints, or over plain http;
+ *  - password / payment inputs lack an explicit autocomplete attribute.
+ *
+ * Zero dependencies — run with `npm run audit:privacy`.
+ */
+import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs';
+import { join, relative, extname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('..', import.meta.url));
+const IGNORE_DIRS = new Set(['node_modules', '.git', 'scripts', 'privacy', '.well-known']);
+const SCAN_EXT = new Set(['.html', '.htm', '.css', '.js', '.mjs']);
+
+const problems = [];
+const report = (file, msg) => problems.push(`${relative(root, file) || file}: ${msg}`);
+
+function walk(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) {
+      if (!IGNORE_DIRS.has(name)) walk(p, out);
+    } else if (SCAN_EXT.has(extname(name).toLowerCase())) {
+      out.push(p);
+    }
+  }
+  return out;
+}
+
+// -------------------------------------------------------------- register
+const registerPath = join(root, 'privacy', 'third-parties.json');
+const register = JSON.parse(readFileSync(registerPath, 'utf8'));
+const allowedOrigins = new Set();
+for (const entry of register.allowed ?? []) {
+  for (const field of ['origin', 'vendor', 'purpose', 'category', 'dataShared', 'dpa', 'reviewedOn']) {
+    if (!entry[field]) report(registerPath, `entry ${entry.origin ?? '?'} is missing "${field}"`);
+  }
+  try {
+    allowedOrigins.add(new URL(entry.origin).origin);
+  } catch {
+    report(registerPath, `invalid origin "${entry.origin}"`);
+  }
+}
+
+// Origins that appear only as identifiers / documentation, never fetched.
+const NON_FETCH_ORIGINS = new Set(['http://www.w3.org']);
+
+const URL_RE = /\b(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}(?::\d+)?[^\s"'()<>]*/gi;
+
+// ----------------------------------------------------------------- scan
+let headerCsp = null;
+const headersPath = join(root, '_headers');
+if (!existsSync(headersPath)) {
+  report(headersPath, 'missing _headers file with security headers');
+} else {
+  const headers = readFileSync(headersPath, 'utf8');
+  headerCsp = headers.match(/^\s*Content-Security-Policy:\s*(.+)$/m)?.[1].trim() ?? null;
+  const required = [
+    'Content-Security-Policy', 'Strict-Transport-Security', 'Referrer-Policy',
+    'X-Content-Type-Options', 'Permissions-Policy', 'Cross-Origin-Opener-Policy',
+    'X-Frame-Options', 'Clear-Site-Data',
+  ];
+  for (const h of required) {
+    if (!new RegExp(`^\\s*${h}:`, 'mi').test(headers)) report(headersPath, `missing ${h}`);
+  }
+  if (headerCsp && !/frame-ancestors\s+'none'/.test(headerCsp)) {
+    report(headersPath, "CSP must include frame-ancestors 'none'");
+  }
+  if (headerCsp && /'unsafe-(inline|eval)'/.test(headerCsp)) {
+    report(headersPath, "CSP must not allow 'unsafe-inline' or 'unsafe-eval'");
+  }
+}
+
+const normaliseCsp = (csp) =>
+  csp.split(';').map((d) => d.trim().replace(/\s+/g, ' ')).filter(Boolean)
+    // frame-ancestors is ignored in <meta>, so compare without it.
+    .filter((d) => !d.startsWith('frame-ancestors')).sort().join('; ');
+
+for (const file of walk(root)) {
+  const src = readFileSync(file, 'utf8');
+  const ext = extname(file).toLowerCase();
+  // Strip comments so documentation URLs don't count as requests.
+  const code = ext === '.html' || ext === '.htm'
+    ? src.replace(/<!--[\s\S]*?-->/g, '')
+    : src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:\\])\/\/.*$/gm, '$1');
+
+  for (const match of code.matchAll(URL_RE)) {
+    let origin;
+    try {
+      origin = new URL(match[0].startsWith('//') ? `https:${match[0]}` : match[0]).origin;
+    } catch {
+      continue;
+    }
+    if (NON_FETCH_ORIGINS.has(origin)) continue;
+    if (!allowedOrigins.has(origin)) {
+      report(file, `unaudited third-party origin ${origin} (add to privacy/third-parties.json or self-host)`);
+    }
+    if (match[0].startsWith('http:')) report(file, `insecure http:// reference ${match[0]}`);
+  }
+
+  if (ext !== '.html' && ext !== '.htm') continue;
+
+  if (/<script\b(?![^>]*\bsrc=)[^>]*>/i.test(code)) report(file, 'inline <script> (move to an external file)');
+  if (/<style\b/i.test(code)) report(file, 'inline <style> (move to an external stylesheet)');
+  if (/\sstyle\s*=/i.test(code)) report(file, 'style="" attribute (use a CSS class)');
+  if (/\son[a-z]+\s*=/i.test(code)) report(file, 'inline event handler attribute (use addEventListener)');
+
+  const metaCsp = code.match(/<meta[^>]+http-equiv=["']Content-Security-Policy["'][^>]*content=(["'])(.*?)\1/is)?.[2];
+  if (!metaCsp) report(file, 'missing Content-Security-Policy meta tag');
+  else if (headerCsp && normaliseCsp(metaCsp) !== normaliseCsp(headerCsp)) {
+    report(file, 'CSP meta tag differs from _headers');
+  }
+  if (!/<meta[^>]+name=["']referrer["']/i.test(code)) report(file, 'missing referrer meta tag');
+
+  for (const [tag] of code.matchAll(/<a\b[^>]*target=["']_blank["'][^>]*>/gi)) {
+    const rel = tag.match(/rel=["']([^"']*)["']/i)?.[1] ?? '';
+    if (!/noopener/.test(rel) || !/noreferrer/.test(rel)) report(file, `target=_blank without rel="noopener noreferrer": ${tag}`);
+  }
+
+  for (const [tag] of code.matchAll(/<form\b[^>]*>/gi)) {
+    const method = (tag.match(/method=["']?(\w+)/i)?.[1] ?? 'get').toLowerCase();
+    const action = tag.match(/action=["']([^"']*)["']/i)?.[1] ?? '';
+    if (action.startsWith('http:')) report(file, `form posts over plain http: ${tag}`);
+    if (method === 'get' && action && !/search/i.test(action)) {
+      report(file, `form uses GET (data ends up in URLs/logs): ${tag}`);
+    }
+  }
+
+  for (const [tag] of code.matchAll(/<input\b[^>]*>/gi)) {
+    if (/type=["']?password|name=["']?(cc-|card|cvc|cvv)/i.test(tag) && !/autocomplete=/i.test(tag)) {
+      report(file, `sensitive input without explicit autocomplete: ${tag}`);
+    }
+  }
+}
+
+// --------------------------------------------------------------- result
+if (problems.length) {
+  console.error(`Privacy audit FAILED (${problems.length} issue${problems.length === 1 ? '' : 's'}):`);
+  for (const p of problems) console.error(`  - ${p}`);
+  process.exit(1);
+}
+console.log(`Privacy audit passed. Third-party origins in use: ${allowedOrigins.size === 0 ? 'none' : [...allowedOrigins].join(', ')}.`);
