+++ b/assets/js/privacy.js
@@ -0,0 +1,263 @@
+/**
+ * The Daily Grind — client-side privacy controls.
+ *
+ * Privacy-by-design principles implemented here:
+ *  - Privacy as the default: every non-essential category starts OFF.
+ *  - Browser signals are honoured: Global Privacy Control (GPC) and Do Not
+ *    Track force non-essential processing off, with no prompt.
+ *  - Data minimisation: the only thing stored client-side is the consent
+ *    choice itself (booleans + a day-precision date, no identifiers), and it
+ *    expires automatically. Tracking parameters are stripped from the URL.
+ *  - Third parties are only loaded through the audited registry below, and
+ *    only after the matching consent category has been granted.
+ *  - Secure handling: no innerHTML, no eval, no inline handlers (CSP-safe),
+ *    client storage is cleared on logout.
+ */
+(function () {
+  'use strict';
+
+  var CONSENT_KEY = 'dg_privacy_consent';
+  var CONSENT_VERSION = 1;
+  var CONSENT_MAX_AGE_DAYS = 365;
+
+  /**
+   * Audited third-party registry. Every external script, pixel or embed MUST
+   * be declared here (and in privacy/third-parties.json, which the
+   * `npm run audit:privacy` check enforces) — nothing else may load one.
+   * Each entry: { id, category: 'analytics'|'marketing', src, purpose }.
+   * Intentionally empty: the site currently uses no third-party services.
+   * Adding one also requires extending the CSP in index.html and _headers.
+   */
+  var THIRD_PARTIES = [];
+
+  var CATEGORIES = ['analytics', 'marketing'];
+
+  /** Query parameters that only exist to track people across sites. */
+  var TRACKING_PARAMS = /^(utm_[a-z]+|fbclid|gclid|gbraid|wbraid|dclid|msclkid|mc_eid|mc_cid|_hsenc|_hsmsclk|igshid|yclid|twclid|ttclid|li_fat_id)$/i;
+
+  // ---------------------------------------------------------------- signals
+
+  function browserOptedOut() {
+    var nav = window.navigator || {};
+    return nav.globalPrivacyControl === true ||
+      nav.doNotTrack === '1' || window.doNotTrack === '1';
+  }
+
+  // ---------------------------------------------------------------- storage
+
+  function storage() {
+    try {
+      var s = window.localStorage;
+      var probe = '__dg_probe__';
+      s.setItem(probe, probe);
+      s.removeItem(probe);
+      return s;
+    } catch (e) {
+      return null; // storage disabled / private mode — default-deny still applies
+    }
+  }
+
+  function today() {
+    // Day precision only: we don't need to know *when* exactly someone chose.
+    return new Date().toISOString().slice(0, 10);
+  }
+
+  function readConsent() {
+    var s = storage();
+    if (!s) return null;
+    var raw = s.getItem(CONSENT_KEY);
+    if (!raw) return null;
+    try {
+      var c = JSON.parse(raw);
+      var ageDays = (Date.now() - Date.parse(c.date)) / 864e5;
+      if (c.v !== CONSENT_VERSION || !(ageDays >= 0 && ageDays <= CONSENT_MAX_AGE_DAYS)) {
+        s.removeItem(CONSENT_KEY);
+        return null;
+      }
+      // Re-validate shape: only accept known boolean fields.
+      var clean = { v: CONSENT_VERSION, date: String(c.date).slice(0, 10) };
+      CATEGORIES.forEach(function (k) { clean[k] = c[k] === true; });
+      return clean;
+    } catch (e) {
+      s.removeItem(CONSENT_KEY);
+      return null;
+    }
+  }
+
+  function writeConsent(choices) {
+    var record = { v: CONSENT_VERSION, date: today() };
+    CATEGORIES.forEach(function (k) { record[k] = choices[k] === true; });
+    var s = storage();
+    if (s) s.setItem(CONSENT_KEY, JSON.stringify(record));
+    return record;
+  }
+
+  /** Effective consent = stored choice, overridden by browser opt-out signals. */
+  function effectiveConsent() {
+    var stored = readConsent() || {};
+    var optedOut = browserOptedOut();
+    var result = {};
+    CATEGORIES.forEach(function (k) { result[k] = !optedOut && stored[k] === true; });
+    return result;
+  }
+
+  // ------------------------------------------------------- third-party gate
+
+  var loaded = {};
+
+  function loadConsentedThirdParties() {
+    var consent = effectiveConsent();
+    THIRD_PARTIES.forEach(function (tp) {
+      if (loaded[tp.id] || consent[tp.category] !== true) return;
+      if (!/^https:\/\//.test(tp.src)) return; // never load over plain http
+      var el = document.createElement('script');
+      el.src = tp.src;
+      el.async = true;
+      el.referrerPolicy = 'no-referrer';
+      if (tp.integrity) {
+        el.integrity = tp.integrity;
+        el.crossOrigin = 'anonymous';
+      }
+      document.head.appendChild(el);
+      loaded[tp.id] = true;
+    });
+  }
+
+  function hasNonEssentialVendors() {
+    return THIRD_PARTIES.some(function (tp) { return CATEGORIES.indexOf(tp.category) !== -1; });
+  }
+
+  // ----------------------------------------------------- data minimisation
+
+  function stripTrackingParams() {
+    if (!window.URL || !window.history || !history.replaceState) return;
+    var url = new URL(window.location.href);
+    var removed = false;
+    Array.from(url.searchParams.keys()).forEach(function (key) {
+      if (TRACKING_PARAMS.test(key)) {
+        url.searchParams.delete(key);
+        removed = true;
+      }
+    });
+    if (removed) history.replaceState(history.state, '', url.pathname + url.search + url.hash);
+  }
+
+  /** External links must not leak window.opener or the referring URL. */
+  function hardenExternalLinks() {
+    var links = document.querySelectorAll('a[href]');
+    Array.prototype.forEach.call(links, function (a) {
+      if (a.origin && a.origin !== window.location.origin) {
+        var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+        ['noopener', 'noreferrer'].forEach(function (r) {
+          if (rel.indexOf(r) === -1) rel.push(r);
+        });
+        a.setAttribute('rel', rel.join(' '));
+        a.referrerPolicy = 'no-referrer';
+      }
+    });
+  }
+
+  /** On logout, wipe client-side state that could identify the previous user. */
+  function bindLogoutCleanup() {
+    var forms = document.querySelectorAll('form[data-logout]');
+    Array.prototype.forEach.call(forms, function (form) {
+      form.addEventListener('submit', function () {
+        try { window.sessionStorage.clear(); } catch (e) { /* ignore */ }
+        var s = storage();
+        if (s) {
+          // Keep only the device-level privacy choice; drop everything else we own.
+          for (var i = s.length - 1; i >= 0; i--) {
+            var key = s.key(i);
+            if (key && key.indexOf('dg_') === 0 && key !== CONSENT_KEY) s.removeItem(key);
+          }
+        }
+      });
+    });
+  }
+
+  // ------------------------------------------------------------------- UI
+
+  function setText(el, text) {
+    if (el) el.textContent = text; // textContent only — never innerHTML
+  }
+
+  function initPanel() {
+    var dialog = document.getElementById('privacy-panel');
+    var form = document.getElementById('privacy-form');
+    var openBtn = document.getElementById('privacy-choices-btn');
+    var gpcNote = document.getElementById('privacy-gpc-note');
+    var status = document.getElementById('privacy-status');
+    if (!dialog || !form || typeof dialog.showModal !== 'function') {
+      if (openBtn) openBtn.hidden = true;
+      return;
+    }
+
+    function syncForm() {
+      var consent = effectiveConsent();
+      var optedOut = browserOptedOut();
+      CATEGORIES.forEach(function (k) {
+        var box = form.elements.namedItem(k);
+        if (!box) return;
+        box.checked = consent[k];
+        box.disabled = optedOut;
+      });
+      if (gpcNote) gpcNote.hidden = !optedOut;
+      var stored = readConsent();
+      setText(status, stored
+        ? 'Choice saved on this device on ' + stored.date + '. It expires after 12 months.'
+        : 'No choice saved — all non-essential processing is off by default.');
+    }
+
+    function save(choices) {
+      writeConsent(choices);
+      dialog.close();
+      loadConsentedThirdParties();
+    }
+
+    openBtn.addEventListener('click', function () {
+      syncForm();
+      dialog.showModal();
+    });
+
+    form.addEventListener('submit', function (ev) {
+      ev.preventDefault();
+      var action = ev.submitter ? ev.submitter.value : 'save';
+      var choices = {};
+      CATEGORIES.forEach(function (k) {
+        var box = form.elements.namedItem(k);
+        if (action === 'accept') choices[k] = true;
+        else if (action === 'reject') choices[k] = false;
+        else choices[k] = !!(box && box.checked);
+      });
+      if (browserOptedOut()) CATEGORIES.forEach(function (k) { choices[k] = false; });
+      save(choices);
+    });
+
+    var closeBtn = document.getElementById('privacy-close');
+    if (closeBtn) closeBtn.addEventListener('click', function () { dialog.close(); });
+
+    // Only prompt when there is actually something to consent to, the user
+    // hasn't decided yet, and the browser hasn't already said "no".
+    if (hasNonEssentialVendors() && !readConsent() && !browserOptedOut()) {
+      syncForm();
+      dialog.showModal();
+    }
+  }
+
+  // ------------------------------------------------------------------ boot
+
+  stripTrackingParams();
+
+  function onReady() {
+    hardenExternalLinks();
+    bindLogoutCleanup();
+    initPanel();
+    loadConsentedThirdParties();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', onReady);
+  } else {
+    onReady();
+  }
+})();
