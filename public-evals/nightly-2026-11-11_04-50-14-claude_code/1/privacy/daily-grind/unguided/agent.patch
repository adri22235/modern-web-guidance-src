+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('../img/hero-coffee.jpg');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Utilities (replace inline style attributes so CSP can forbid 'unsafe-inline') */
+.text-center {
+  text-align: center;
+}
+
+/* Logout is a POST form (state-changing action, not a prefetchable GET link) */
+.logout-form {
+  display: inline;
+}
+
+button.logout-link {
+  background: none;
+  color: white;
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+  transition: color 0.3s;
+}
+
+button.logout-link:hover,
+button.logout-link:focus-visible {
+  color: var(--accent);
+}
+
+.link-button {
+  background: none;
+  border: 0;
+  margin: 0 10px;
+  color: var(--text);
+  font: inherit;
+  font-size: 0.85rem;
+  cursor: pointer;
+  text-decoration: underline;
+}
+
+/* Privacy choices panel */
+.privacy-panel {
+  max-width: 520px;
+  width: calc(100% - 40px);
+  border: 0;
+  border-radius: 8px;
+  padding: 24px;
+  color: var(--text);
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+}
+
+.privacy-panel::backdrop {
+  background: rgba(0, 0, 0, 0.5);
+}
+
+.privacy-panel h2 {
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+.privacy-panel fieldset {
+  border: 1px solid var(--secondary);
+  border-radius: 6px;
+  padding: 10px 14px;
+  margin: 14px 0;
+}
+
+.privacy-panel label {
+  display: flex;
+  gap: 10px;
+  align-items: flex-start;
+  margin: 8px 0;
+  font-size: 0.9rem;
+}
+
+.privacy-panel .note {
+  font-size: 0.85rem;
+  background: #fff3e0;
+  border-left: 4px solid var(--accent);
+  padding: 8px 12px;
+  margin: 10px 0;
+}
+
+.privacy-panel .actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  justify-content: flex-end;
+}
+
+/* Equal visual weight for accept and reject — no dark patterns */
+.privacy-panel .actions button {
+  background: var(--primary);
+  color: white;
+  border: 0;
+  border-radius: 5px;
+  padding: 10px 16px;
+  font: inherit;
+  cursor: pointer;
+}
+
+.privacy-panel .actions button:hover,
+.privacy-panel .actions button:focus-visible {
+  background: #3e2723;
+}
+
+.privacy-status {
+  font-size: 0.8rem;
+  margin-top: 10px;
+}
