+# Security and privacy response headers for The Daily Grind.
+# Uses the Netlify / Cloudflare Pages `_headers` format. For other hosts
+# (nginx, Caddy, Express, CDN edge rules), copy the same name/value pairs.
+#
+# Third-party audit (2026-11-11): the site loads NO third-party resources.
+# The Unsplash hero image is now self-hosted at /assets/img/hero.jpg, so every
+# directive below can stay on 'self'. If you add a vendor later, review its
+# data collection first, then add only that origin to the narrowest directive
+# (and to Connection-Allowlist).
+
+/*
+  # Report violations to our own origin. The endpoint must strip PII and
+  # query strings before storing reports.
+  Reporting-Endpoints: default="/api/reports"
+
+  # Strict CSP: no inline code, no third-party origins, Trusted Types enforced.
+  Content-Security-Policy: default-src 'none'; script-src 'self' 'report-sample'; style-src 'self' 'report-sample'; img-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; worker-src 'self'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests; report-to default
+
+  # Network-layer egress allowlist (Chromium 152+). It also covers channels CSP
+  # misses: preconnect/dns-prefetch, WebRTC, beacons, <a ping>, and navigations.
+  # redirects=allow keeps the POST /logout -> 303 / redirect working.
+  Connection-Allowlist: (response-origin "https://globalprivacycontrol.org"); redirects=allow; report-to=default
+
+  # Don't leak paths or query strings to other origins.
+  Referrer-Policy: same-origin
+
+  # Turn off powerful features nobody on this site uses.
+  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), encrypted-media=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), focus-without-user-activation=()
+
+  X-Frame-Options: DENY
+  X-Content-Type-Options: nosniff
+  Cross-Origin-Opener-Policy: same-origin
+  Cross-Origin-Resource-Policy: same-origin
+
+  # Raise gradually: 300 -> 86400 -> 31536000 (then add `preload`).
+  Strict-Transport-Security: max-age=31536000; includeSubDomains
+
+# Signed-in areas: never let shared caches or the back/forward cache keep
+# personal data.
+/account/*
+  Cache-Control: no-store
+
+# Logout: wipe all client-side state for this origin. The server must also
+# expire the `__Host-session` cookie (Secure; HttpOnly; SameSite=Lax; Path=/),
+# accept POST only, and answer with `303 See Other` to `/`.
+/logout
+  Cache-Control: no-store
+  Clear-Site-Data: "cache", "cookies", "storage"
+
+/.well-known/gpc.json
+  Content-Type: application/json
+  Access-Control-Allow-Origin: *
