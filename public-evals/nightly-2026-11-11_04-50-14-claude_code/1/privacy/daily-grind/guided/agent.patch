diff --git a/js/privacy.js b/js/privacy.js
new file mode 100644
index 0000000..c7fca6d
--- /dev/null
+++ b/js/privacy.js
@@ -0,0 +1,47 @@
+// First-party privacy helpers for The Daily Grind.
+//
+// Rules this file follows (and that any future script should follow):
+//  - No third-party code, no network beacons, no fingerprinting, and no
+//    user-agent sniffing. Use feature detection only.
+//  - Never write untrusted strings to HTML sinks. The CSP enforces
+//    `require-trusted-types-for 'script'; trusted-types 'none'`, so assigning
+//    to innerHTML/outerHTML/document.write fails at runtime. Use textContent.
+//  - Never put tokens or PII in localStorage/sessionStorage. Session state
+//    lives only in the HttpOnly `__Host-` cookie set by the server.
+
+/**
+ * Global Privacy Control (https://globalprivacycontrol.org/).
+ * Treat the signal as a valid opt-out of sale/sharing. The server sees the
+ * `Sec-GPC: 1` request header too; here we only tell the user it was honored.
+ */
+function reflectGlobalPrivacyControl() {
+  const status = document.querySelector('[data-gpc-status]');
+  if (!status || navigator.globalPrivacyControl !== true) return;
+  status.textContent =
+    'Your browser sent a Global Privacy Control signal. We have opted you out of any sale or sharing of your data.';
+  status.hidden = false;
+}
+
+/**
+ * Logout data hygiene.
+ * The /logout response sends `Clear-Site-Data: "cache", "cookies", "storage"`.
+ * Some browsers support only part of that header, so we also clear Web Storage
+ * on the client before the form submits. Clearing storage is synchronous, so it
+ * finishes before the navigation starts.
+ */
+function hardenLogout() {
+  for (const form of document.querySelectorAll('form[data-logout]')) {
+    form.addEventListener('submit', () => {
+      try {
+        localStorage.clear();
+        sessionStorage.clear();
+      } catch {
+        // Storage can be unavailable (e.g. blocked by privacy settings); the
+        // server-side Clear-Site-Data header still covers this case.
+      }
+    });
+  }
+}
+
+reflectGlobalPrivacyControl();
+hardenLogout();
