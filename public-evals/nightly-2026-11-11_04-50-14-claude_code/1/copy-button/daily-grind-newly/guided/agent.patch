+  <script>
+    const copyTimers = new WeakMap();
+    let lastCopyMessage = '';
+
+    function reportCopy(button, ok) {
+      const tip = button.nextElementSibling; // the role="status" bubble
+      clearTimeout(copyTimers.get(button));
+      button.removeAttribute('data-copied');
+      button.removeAttribute('data-failed');
+      let message = ok ? 'Copied' : 'Copy failed';
+      if (message === lastCopyMessage) message += '\u00A0'; // so VoiceOver re-announces repeats
+      lastCopyMessage = message;
+      tip.textContent = '';
+      void button.offsetWidth; // restart CSS transitions
+      button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+      requestAnimationFrame(() => (tip.textContent = message));
+      copyTimers.set(button, setTimeout(() => {
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        tip.textContent = '';
+      }, 2000));
+    }
+
+    async function copyText(button, target) {
+      const text = target.matches('input, textarea') ? target.value : target.innerText.trim();
+      if (!text) return;
+      try {
+        await navigator.clipboard.writeText(text);
+        reportCopy(button, true);
+      } catch {
+        reportCopy(button, false);
+      }
+    }
+
+    // `command` events don't bubble: listen in the capture phase.
+    // event.source is the clicked button; event.target is the commandfor element.
+    document.addEventListener('command', (event) => {
+      if (event.command === '--copy') copyText(event.source, event.target);
+    }, true);
+  </script>
