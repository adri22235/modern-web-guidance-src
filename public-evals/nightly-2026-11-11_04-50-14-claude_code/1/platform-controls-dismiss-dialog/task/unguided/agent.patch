+  <dialog class="coffee-dialog" id="coffee-dialog" aria-labelledby="coffee-dialog-title"
+    aria-describedby="coffee-dialog-desc" closedby="any">
+    <div class="dialog-inner">
+      <button type="button" class="dialog-close" data-close aria-label="Close details">
+        <span aria-hidden="true">&times;</span>
+      </button>
+      <div id="coffee-dialog-content"></div>
+      <div class="dialog-actions" id="coffee-dialog-actions">
+        <button type="button" class="btn btn-secondary" data-close>Close</button>
+      </div>
+    </div>
+  </dialog>
+
+  <script>
+    (function () {
+      const dialog = document.getElementById('coffee-dialog');
+      const content = document.getElementById('coffee-dialog-content');
+      const actions = document.getElementById('coffee-dialog-actions');
+      const HISTORY_KEY = 'coffeeDialog';
+      let opener = null;
+      let closingViaHistory = false;
+      let pendingBack = false;
+
+      function render(id) {
+        const tpl = document.getElementById('coffee-' + id);
+        if (!tpl) return false;
+        const frag = tpl.content.cloneNode(true);
+        frag.querySelector('[data-dialog-title]').id = 'coffee-dialog-title';
+        frag.querySelector('[data-dialog-desc]').id = 'coffee-dialog-desc';
+        // Move the menu link into the action row, keeping Close last.
+        actions.querySelectorAll('a').forEach(a => a.remove());
+        const link = frag.querySelector('a');
+        if (link) actions.prepend(link);
+        content.replaceChildren(frag);
+        return true;
+      }
+
+      function open(id, { pushHistory = true } = {}) {
+        if (!render(id)) return;
+        if (!dialog.open) dialog.showModal();
+        dialog.querySelector('.dialog-close').focus();
+        // Add a history entry so the mobile back gesture/button closes the dialog
+        // instead of leaving the page.
+        if (pushHistory) {
+          history.pushState({ [HISTORY_KEY]: id }, '', location.href);
+        }
+      }
+
+      document.querySelectorAll('[data-coffee]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          opener = btn;
+          open(btn.dataset.coffee);
+        });
+      });
+
+      dialog.addEventListener('click', e => {
+        // Close buttons, or a click on the backdrop (fallback where closedby is unsupported).
+        if (e.target.closest('[data-close]') || e.target === dialog) {
+          dialog.close();
+        }
+      });
+
+      // Fires however the dialog closed: Escape, close button, backdrop, back gesture.
+      dialog.addEventListener('close', () => {
+        if (!closingViaHistory && history.state && history.state[HISTORY_KEY]) {
+          // Remove the entry we pushed so history stays in sync.
+          pendingBack = true;
+          history.back();
+        }
+        closingViaHistory = false;
+        if (opener && document.contains(opener)) opener.focus();
+      });
+
+      window.addEventListener('popstate', e => {
+        if (pendingBack) {
+          pendingBack = false;
+          return;
+        }
+        const id = e.state && e.state[HISTORY_KEY];
+        if (dialog.open && !id) {
+          closingViaHistory = true;
+          dialog.close();
+        } else if (id && !dialog.open) {
+          // User navigated forward onto a dialog entry.
+          opener = document.querySelector('[data-coffee="' + CSS.escape(id) + '"]');
+          open(id, { pushHistory: false });
+        }
+      });
+
+      // Don't restore a stale dialog entry after a reload.
+      if (history.state && history.state[HISTORY_KEY]) {
+        history.replaceState(null, '', location.href);
+      }
+    })();
+  </script>
+
