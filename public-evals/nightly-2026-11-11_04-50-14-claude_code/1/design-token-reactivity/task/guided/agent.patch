+
+    /* Layout density: cards react to the inherited --card-density token
+       via container style queries, so only the container's value changes. */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    #target-container {
+      --card-density: comfortable;
+    }
+
+    @container style(--card-density: compact) {
+      .card {
+        padding: 12px;
+      }
+    }
+
+    @container style(--card-density: comfortable) {
+      .card {
+        padding: 20px;
+      }
+    }
+
+    @container style(--card-density: spacious) {
+      .card {
+        padding: 40px;
+      }
+    }
+
+    .card {
+      transition: padding 0.3s;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card {
+        transition: none;
+      }
+    }
+
+    .section-header {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      align-items: center;
+      gap: 12px 20px;
+    }
+
+    /* Only show the toggle where container style queries work */
+    .density-toggle {
