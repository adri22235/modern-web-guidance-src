+          desc: 'Our darkest roast, with notes of cedar, dark chocolate and toasted walnut. Served as a double shot with thick, lingering crema.'
+        },
+        'cold-brew': {
+          price: '$4.50', meta: ['Iced', '10 cal (16 oz)', 'Extra caffeine'],
+          desc: 'Coarse-ground Colombian beans steeped in cold filtered water for 18 hours, then served over ice for a naturally sweet, low-acid cup.'
+        },
+        'pumpkin-spice-cappuccino': {
+          price: '$5.95', meta: ['Hot', '240 cal (12 oz)', 'Limited time'],
+          desc: 'House-made pumpkin purée with cinnamon, nutmeg, ginger and clove, folded into espresso and topped with a cloud of microfoam.'
+        },
+        'cinnamon-mocha': {
+          price: '$5.50', meta: ['Hot or iced', '280 cal (12 oz)', 'Contains dairy'],
+          desc: '70% single-origin Peruvian chocolate melted into espresso and steamed milk, warmed with Ceylon cinnamon and a cocoa-dusted finish.'
+        },
+        'honey-lavender-latte': {
+          price: '$5.75', meta: ['Hot or iced', '210 cal (12 oz)', 'Local honey'],
+          desc: 'Espresso with steamed milk, wildflower honey from a farm ten miles away, and a delicate lavender syrup we steep in-house each morning.'
+        }
+      };
+
+      /* ---------- Carousel ---------- */
+      const track = document.getElementById('seasonal-track');
+      const prevBtn = document.querySelector('[data-carousel="prev"]');
+      const nextBtn = document.querySelector('[data-carousel="next"]');
+      const status = document.getElementById('seasonal-status');
+      const cards = Array.from(track.querySelectorAll('.card'));
+
+      cards.forEach((card, i) => {
+        card.setAttribute('role', 'group');
+        card.setAttribute('aria-roledescription', 'slide');
+        card.setAttribute('aria-label', `${i + 1} of ${cards.length}: ${card.querySelector('h3').textContent}`);
+      });
+
+      const behavior = () => (reduceMotion.matches ? 'auto' : 'smooth');
+      const step = () => {
+        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
+        return cards[0].getBoundingClientRect().width + gap;
+      };
+      const maxScroll = () => track.scrollWidth - track.clientWidth;
+
+      function nearestIndex() {
+        return Math.round(track.scrollLeft / step());
+      }
+
+      function scrollToIndex(i) {
+        const idx = Math.max(0, Math.min(cards.length - 1, i));
+        track.scrollTo({ left: Math.min(cards[idx].offsetLeft - track.firstElementChild.offsetLeft, maxScroll()), behavior: behavior() });
+      }
+
+      let statusTimer;
+      function updateControls() {
+        const atStart = track.scrollLeft <= 2;
+        const atEnd = track.scrollLeft >= maxScroll() - 2;
+        // If focus sits on a button that is about to be disabled, move it to its sibling.
+        if (atStart && document.activeElement === prevBtn) nextBtn.focus();
+        if (atEnd && document.activeElement === nextBtn) prevBtn.focus();
+        prevBtn.disabled = atStart;
+        nextBtn.disabled = atEnd;
+
+        clearTimeout(statusTimer);
+        statusTimer = setTimeout(() => {
+          const first = Math.min(cards.length, nearestIndex() + 1);
+          const visible = Math.max(1, Math.round(track.clientWidth / step()));
+          const last = Math.min(cards.length, first + visible - 1);
+          status.textContent = first === last
+            ? `Showing drink ${first} of ${cards.length}`
+            : `Showing drinks ${first} to ${last} of ${cards.length}`;
+        }, 300);
+      }
+
+      prevBtn.addEventListener('click', () => scrollToIndex(nearestIndex() - 1));
+      nextBtn.addEventListener('click', () => scrollToIndex(nearestIndex() + 1));
+      track.addEventListener('scroll', updateControls, { passive: true });
+      window.addEventListener('resize', updateControls);
+
+      track.addEventListener('keydown', (e) => {
+        if (e.target !== track) return;
+        const map = { ArrowLeft: nearestIndex() - 1, ArrowRight: nearestIndex() + 1, Home: 0, End: cards.length - 1 };
+        if (e.key in map) {
+          e.preventDefault();
+          scrollToIndex(map[e.key]);
+        }
+      });
+
+      // Keep a card fully in view when one of its controls receives keyboard focus.
+      track.addEventListener('focusin', (e) => {
+        const card = e.target.closest('.card');
+        if (card) card.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: behavior() });
+      });
+
+      // Mouse drag-to-swipe (touch & trackpads use native scrolling).
+      let drag = null;
+      let suppressClick = false;
+      track.addEventListener('pointerdown', (e) => {
+        if (e.pointerType !== 'mouse' || e.button !== 0) return;
+        drag = { x: e.clientX, left: track.scrollLeft, moved: false, id: e.pointerId };
+      });
+      track.addEventListener('pointermove', (e) => {
+        if (!drag || e.pointerId !== drag.id) return;
+        const dx = e.clientX - drag.x;
+        if (!drag.moved && Math.abs(dx) > 6) {
+          drag.moved = true;
+          track.classList.add('is-dragging');
+          track.setPointerCapture(e.pointerId);
+        }
+        if (drag.moved) track.scrollLeft = drag.left - dx;
+      });
+      const endDrag = () => {
+        if (!drag) return;
+        if (drag.moved) {
+          suppressClick = true;
+          setTimeout(() => { suppressClick = false; }, 0);
+          track.classList.remove('is-dragging');
+          scrollToIndex(nearestIndex());
+        }
+        drag = null;
+      };
+      track.addEventListener('pointerup', endDrag);
+      track.addEventListener('pointercancel', endDrag);
+      track.addEventListener('click', (e) => {
+        if (suppressClick) { e.preventDefault(); e.stopPropagation(); }
+      }, true);
+      track.addEventListener('dragstart', (e) => e.preventDefault());
+
+      updateControls();
+
+      /* ---------- Detail view expanding from its trigger ---------- */
+      const dialog = document.getElementById('drink-dialog');
+      const closeBtn = document.getElementById('drink-dialog-close');
+      const els = {
+        title: document.getElementById('drink-dialog-title'),
+        price: document.getElementById('drink-dialog-price'),
+        meta: document.getElementById('drink-dialog-meta'),
+        desc: document.getElementById('drink-dialog-desc'),
+        media: document.getElementById('drink-dialog-media'),
+        link: document.getElementById('drink-dialog-link')
+      };
+      const DURATION = 420;
+      const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';
+      let trigger = null;
+      let anim = null;
+      let closing = false;
+
+      function fromTriggerKeyframes(btn) {
+        const b = btn.getBoundingClientRect();
+        const d = dialog.getBoundingClientRect();
+        const btnStyle = getComputedStyle(btn);
+        return [
+          {
+            transform: `translate(${b.left - d.left}px, ${b.top - d.top}px) scale(${b.width / d.width}, ${b.height / d.height})`,
+            backgroundColor: btnStyle.backgroundColor,
+            borderRadius: btnStyle.borderRadius,
+            boxShadow: '0 0 0 rgba(0,0,0,0)'
+          },
+          {
+            transform: 'none',
+            backgroundColor: '#ffffff',
+            borderRadius: '12px',
+            boxShadow: '0 24px 60px rgba(0,0,0,0.35)'
+          }
+        ];
+      }
+
+      function fill(card, btn) {
+        const id = card.dataset.drink;
+        const data = DRINKS[id] || { price: '', meta: [], desc: card.querySelector('p').textContent };
+        const media = card.querySelector('.card-media');
+        els.title.textContent = card.querySelector('h3').textContent;
+        els.price.textContent = data.price;
+        els.desc.textContent = data.desc;
+        els.meta.replaceChildren(...data.meta.map((m) => Object.assign(document.createElement('li'), { textContent: m })));
+        els.media.style.backgroundImage = media.style.backgroundImage;
+        els.media.setAttribute('aria-label', media.getAttribute('aria-label') || '');
+        els.link.href = btn.getAttribute('href');
+      }
+
+      function openDetails(btn) {
+        const card = btn.closest('.card');
+        if (anim) anim.cancel();
+        closing = false;
+        trigger = btn;
+        fill(card, btn);
+
+        dialog.classList.add('is-animating');
+        dialog.classList.remove('is-open');
+        dialog.style.transformOrigin = 'top left';
+        dialog.showModal();
+        closeBtn.focus({ preventScroll: true });
+
+        if (reduceMotion.matches) {
+          dialog.classList.remove('is-animating');
+          dialog.classList.add('is-open');
+          return;
+        }
+        requestAnimationFrame(() => dialog.classList.add('is-open'));
+        anim = dialog.animate(fromTriggerKeyframes(btn), { duration: DURATION, easing: EASE });
+        anim.onfinish = () => { anim = null; dialog.classList.remove('is-animating'); };
+      }
+
+      function closeDetails() {
+        if (!dialog.open || closing) return;
+        closing = true;
+        const finish = () => {
+          anim = null;
+          closing = false;
+          dialog.classList.remove('is-animating', 'is-open');
+          dialog.close();
+          if (trigger && document.contains(trigger)) trigger.focus({ preventScroll: true });
+        };
+        if (anim) anim.cancel();
+        if (reduceMotion.matches || !trigger) return finish();
+
+        dialog.classList.add('is-animating');
+        dialog.classList.remove('is-open');
+        anim = dialog.animate(fromTriggerKeyframes(trigger).reverse(), {
+          duration: DURATION * 0.75, easing: 'cubic-bezier(0.55, 0, 0.75, 0.3)', fill: 'forwards'
+        });
+        anim.onfinish = () => { anim.cancel(); finish(); };
+      }
+
+      track.addEventListener('click', (e) => {
+        const btn = e.target.closest('[data-details]');
+        if (!btn || e.defaultPrevented) return;
+        // Allow modified clicks (new tab/window) to follow the link normally.
+        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+        e.preventDefault();
+        openDetails(btn);
+      });
+
+      closeBtn.addEventListener('click', closeDetails);
+      dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeDetails(); });
+      // Click on the backdrop (outside the dialog box) closes it.
+      dialog.addEventListener('click', (e) => {
+        if (e.target !== dialog) return;
+        const r = dialog.getBoundingClientRect();
+        const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDetails();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
