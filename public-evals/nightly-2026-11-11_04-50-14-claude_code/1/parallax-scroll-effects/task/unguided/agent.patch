+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      overflow: hidden;
+      isolation: isolate;
+      min-height: 80vh;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      padding: 80px 20px;
+      color: white;
+      background: #2b1b17; /* fallback while the image loads */
+    }
+
+    .parallax__layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    /* Oversized so translating never reveals the edges */
+    .parallax__layer--back {
+      inset: -30% 0;
+      z-index: -3;
+    }
+
+    .parallax__layer--back img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .parallax__layer--shade {
+      z-index: -2;
