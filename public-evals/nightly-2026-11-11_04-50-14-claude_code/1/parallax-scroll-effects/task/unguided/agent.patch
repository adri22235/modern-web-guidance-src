+  <script>
+    (function () {
+      var section = document.querySelector('[data-parallax]');
+      if (!section) return;
+
+      var layers = Array.prototype.map.call(
+        section.querySelectorAll('.parallax__layer[data-speed]'),
+        function (el) { return { el: el, speed: parseFloat(el.dataset.speed) || 0 }; }
+      );
+      var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var ticking = false;
+      var visible = false;
+      var listening = false;
+
+      function update() {
+        ticking = false;
+        var rect = section.getBoundingClientRect();
+        var vh = window.innerHeight;
+        // Distance of the section's centre from the viewport's centre;
+        // 0 when centred, positive once the user has scrolled past centre.
+        var distance = vh / 2 - (rect.top + rect.height / 2);
+        var limit = (vh + rect.height) / 2;
+        distance = Math.max(-limit, Math.min(limit, distance));
+        for (var i = 0; i < layers.length; i++) {
+          var y = (distance * layers[i].speed).toFixed(1);
+          layers[i].el.style.transform = 'translate3d(0,' + y + 'px,0)';
+        }
+      }
+
+      function requestUpdate() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      function start() {
+        if (listening) return;
+        listening = true;
+        section.classList.add('is-active');
+        window.addEventListener('scroll', requestUpdate, { passive: true });
+        window.addEventListener('resize', requestUpdate, { passive: true });
+        requestUpdate();
+      }
+
+      function stop() {
+        if (!listening) return;
+        listening = false;
+        section.classList.remove('is-active');
+        window.removeEventListener('scroll', requestUpdate);
+        window.removeEventListener('resize', requestUpdate);
+      }
+
+      function reset() {
+        for (var i = 0; i < layers.length; i++) layers[i].el.style.transform = '';
+      }
+
+      function sync() {
+        if (motionQuery.matches) {
+          stop();
+          reset();
+        } else if (visible) {
+          start();
+        } else {
+          stop();
+        }
+      }
+
+      // Only do scroll work while the section is on (or near) screen.
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          visible = entries[0].isIntersecting;
+          sync();
+        }, { rootMargin: '100px 0px' }).observe(section);
+      } else {
+        visible = true;
+      }
+
+      // Respond live if the user toggles their reduced-motion setting.
+      if (motionQuery.addEventListener) {
+        motionQuery.addEventListener('change', sync);
+      } else if (motionQuery.addListener) {
+        motionQuery.addListener(sync);
+      }
+
+      sync();
+    })();
+  </script>
