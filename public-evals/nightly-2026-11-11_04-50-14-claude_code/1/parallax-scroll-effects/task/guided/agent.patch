+  <script>
+    // Fallback parallax for browsers without CSS scroll-driven animations.
+    // Native CSS is used wherever supported (it runs off the main thread).
+    (() => {
+      if (CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) return;
+
+      const section = document.querySelector('.parallax');
+      if (!section) return;
+      const layers = [...section.querySelectorAll('[data-parallax]')].map((el) => {
+        const cs = getComputedStyle(el);
+        return {
+          el,
+          from: cs.getPropertyValue('--shift-from').trim() || '0px',
+          to: cs.getPropertyValue('--shift-to').trim() || '0px',
+        };
+      });
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      let ticking = false;
+      let listening = false;
+      let inView = false;
+
+      function render() {
+        ticking = false;
+        const rect = section.getBoundingClientRect();
+        const vh = window.innerHeight;
+        // Same as `animation-range: cover`: 0 when the section's top enters
+        // the bottom of the viewport, 1 when its bottom leaves the top.
+        const p = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
+        for (const { el, from, to } of layers) {
+          el.style.transform = `translate3d(0, calc(${from} + (${to} - ${from}) * ${p}), 0)`;
+        }
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          requestAnimationFrame(render);
+        }
+      }
+
+      function update() {
+        const shouldListen = inView && !reducedMotion.matches;
+        if (shouldListen && !listening) {
+          window.addEventListener('scroll', onScroll, { passive: true });
+          window.addEventListener('resize', onScroll, { passive: true });
+          onScroll();
+        } else if (!shouldListen && listening) {
+          window.removeEventListener('scroll', onScroll);
+          window.removeEventListener('resize', onScroll);
+        }
+        listening = shouldListen;
+        if (reducedMotion.matches) {
+          for (const { el } of layers) el.style.transform = '';
+        }
+      }
+
+      // Only do scroll work while the section is on screen.
+      new IntersectionObserver(([entry]) => {
+        inView = entry.isIntersecting;
+        update();
+      }).observe(section);
+
+      // React if the user toggles their motion preference mid-session.
+      reducedMotion.addEventListener('change', update);
+    })();
+  </script>
+
