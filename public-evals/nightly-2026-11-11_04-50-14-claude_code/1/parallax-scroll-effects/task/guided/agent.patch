+      overflow: clip;
+      display: grid;
+      place-items: center;
+      background: var(--primary);
+      isolation: isolate;
+      view-timeline: --parallax;
+    }
+
+    .parallax__layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    /* Oversized so the background never shows gaps while it shifts */
+    .parallax__layer--bg {
+      inset: -20% 0;
+      z-index: -3;
+    }
+
+    .parallax__layer--bg img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .parallax__layer--bg::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      background: linear-gradient(180deg, rgba(62, 39, 35, 0.75), rgba(62, 39, 35, 0.45) 50%, rgba(62, 39, 35, 0.8));
+    }
+
+    .parallax__layer--far {
+      z-index: -2;
+      color: var(--secondary);
