+    /*
+      Progressive enhancement: only animate in browsers with full
+      scroll-driven animation support and when the user has not asked
+      for reduced motion. Only `transform` is animated (compositor-only).
+    */
+    @keyframes parallax-shift {
+      from {
+        transform: translate3d(0, var(--shift-from, 0px), 0);
+      }
+
+      to {
+        transform: translate3d(0, var(--shift-to, 0px), 0);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .parallax [data-parallax] {
+          animation: parallax-shift linear both;
+          /* Must come after the shorthand so it isn't reset */
+          animation-timeline: --parallax;
+          animation-range: cover;
+        }
+      }
+    }
