+  <script>
+    (() => {
+      'use strict';
+
+      const section = document.getElementById('passkey-section');
+      const button = document.getElementById('register-button');
+      const statusEl = document.getElementById('passkey-status');
+
+      // ---- base64url helpers (fallback for browsers without the JSON helpers) ----
+      const b64urlToBuffer = (value) => {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      };
+
+      const bufferToB64url = (buffer) => {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const parseCreationOptions = (json) => {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+          excludeCredentials: (json.excludeCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id),
+          })),
+        };
+      };
+
+      const credentialToJSON = (credential) => {
+        if (typeof credential.toJSON === 'function') {
+          try {
+            return credential.toJSON();
+          } catch (_) {
+            // Fall through to manual serialization (some password managers break toJSON).
+          }
+        }
+        const { response } = credential;
+        const json = {
+          id: credential.id,
+          rawId: bufferToB64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(response.clientDataJSON),
+            attestationObject: bufferToB64url(response.attestationObject),
+            transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+          },
+        };
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          json.response.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        if (typeof response.getPublicKey === 'function') {
+          const pk = response.getPublicKey();
+          if (pk) json.response.publicKey = bufferToB64url(pk);
+        }
+        if (typeof response.getAuthenticatorData === 'function') {
+          json.response.authenticatorData = bufferToB64url(response.getAuthenticatorData());
+        }
+        return json;
+      };
+
+      const setStatus = (message, type = '') => {
+        statusEl.textContent = message; // textContent only: never inject server/user strings as HTML
+        statusEl.className = 'passkey-status' + (type ? ' ' + type : '');
+      };
+
+      const postJSON = async (url, body) => {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(body),
+        });
+        if (!res.ok) throw new Error(`Request to ${url} failed (${res.status})`);
+        return res.json();
+      };
+
+      // ---- Feature detection ----
+      const isWebAuthnSupported = () =>
+        window.isSecureContext && !!window.PublicKeyCredential &&
+        typeof navigator.credentials?.create === 'function';
+
+      let inFlight = false;
+
+      const register = async () => {
+        if (inFlight) return; // prevent concurrent ceremonies
+        if (!isWebAuthnSupported()) {
+          setStatus('Passkeys aren’t supported in this browser.', 'error');
+          return;
+        }
+        inFlight = true;
+        button.disabled = true;
+        setStatus('Preparing your passkey…');
+
+        try {
+          // 1. Fetch server-generated options (challenge, rp, user, excludeCredentials…)
+          const optionsJSON = await postJSON('/api/register/options', { promotion: true });
+          const publicKey = parseCreationOptions(optionsJSON);
+
+          // 2. Run the WebAuthn ceremony in the browser/authenticator
+          setStatus('Follow the prompt from your device…');
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential) throw new Error('No credential was returned.');
+
+          // 3. Send the attestation to the server for verification
+          setStatus('Verifying…');
+          const result = await postJSON('/api/register/verify', credentialToJSON(credential));
+
+          if (result && result.verified === false) {
+            throw new Error('Server could not verify the passkey.');
+          }
+
+          setStatus('Passkey created! You can now use it to sign in.', 'success');
+          button.hidden = true;
+        } catch (err) {
+          console.error('Passkey registration failed:', err);
+          switch (err && err.name) {
+            case 'InvalidStateError':
+              setStatus('A passkey for this account already exists on this device.', 'error');
+              break;
+            case 'NotAllowedError':
+              setStatus('Passkey creation was cancelled or timed out.', 'error');
+              break;
+            case 'AbortError':
+              setStatus('Passkey creation was aborted.', 'error');
+              break;
+            case 'SecurityError':
+              setStatus('Passkeys can’t be created on this site configuration.', 'error');
+              break;
+            default:
+              setStatus('Something went wrong creating your passkey. Please try again.', 'error');
+          }
+        } finally {
+          inFlight = false;
+          button.disabled = false;
+        }
+      };
+
+      button.addEventListener('click', register);
+    })();
+  </script>
+
 </body>
 
