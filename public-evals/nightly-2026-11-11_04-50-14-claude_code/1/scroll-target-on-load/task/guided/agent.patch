+  <script>
+    // Fallback for browsers without `scroll-initial-target` (Firefox, Safari).
+    // Runs at the end of <body>, before first paint in practice, and sets
+    // scrollTop directly so only the feed scrolls (never the page) and
+    // with no animation.
+    (() => {
+      if (CSS.supports("scroll-initial-target", "nearest")) return;
+      const feed = document.querySelector(".media-feed");
+      const target = feed && feed.querySelector(".target");
+      if (!target) return;
+      const offset =
+        target.getBoundingClientRect().top -
+        feed.getBoundingClientRect().top +
+        feed.scrollTop;
+      feed.scrollTo({
+        top: offset - (feed.clientHeight - target.offsetHeight) / 2,
+        behavior: "instant",
+      });
+    })();
+  </script>
