+  <script>
+    // Directional cross-document view transitions for the pagination links.
+    // Must run before first render so the pagereveal listener is registered in time.
+    (() => {
+      const pageOf = (url) => {
+        try {
+          const n = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+          return Number.isFinite(n) && n > 0 ? n : 1;
+        } catch {
+          return null;
+        }
+      };
+      const directionBetween = (fromUrl, toUrl) => {
+        const from = pageOf(fromUrl);
+        const to = pageOf(toUrl);
+        if (from == null || to == null || from === to) return null;
+        return to > from ? 'forward' : 'backward';
+      };
+      const KEY = 'pagination-direction';
+
+      // Outgoing page: remember the direction as a fallback for browsers
+      // without the Navigation API, and tag the outgoing transition too.
+      window.addEventListener('pageswap', (e) => {
+        if (!e.viewTransition) return;
+        const toUrl = e.activation?.entry?.url;
+        const dir = toUrl ? directionBetween(location.href, toUrl) : sessionStorage.getItem(KEY);
+        if (dir) e.viewTransition.types.add(dir);
+      });
+
+      // Incoming page: pick the slide direction.
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition) return;
+        let dir = null;
+        const activation = window.navigation?.activation;
+        if (activation?.from?.url && activation?.entry?.url) {
+          dir = directionBetween(activation.from.url, activation.entry.url);
+        } else {
+          dir = sessionStorage.getItem(KEY);
+        }
+        sessionStorage.removeItem(KEY);
+        if (dir) e.viewTransition.types.add(dir);
+      });
+
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest?.('#previous, #next');
+        if (!link) return;
+        if (link.getAttribute('aria-disabled') === 'true') {
+          e.preventDefault();
+          return;
+        }
+        sessionStorage.setItem(KEY, link.id === 'next' ? 'forward' : 'backward');
+      });
+
+      document.addEventListener('DOMContentLoaded', () => {
+        const page = pageOf(location.href) ?? 1;
+        const prev = document.getElementById('previous');
+        const next = document.getElementById('next');
+        const indicator = document.getElementById('page-indicator');
+        if (indicator) indicator.textContent = `Page ${page}`;
+        if (next) next.href = `?page=${page + 1}`;
+        if (prev) {
+          prev.href = `?page=${Math.max(1, page - 1)}`;
+          if (page <= 1) prev.setAttribute('aria-disabled', 'true');
+          else prev.removeAttribute('aria-disabled');
+        }
+      });
+    })();
+  </script>
