+
+    /* Cross-document view transitions (only when motion is OK) */
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+
+      main.container {
+        view-transition-name: page-content;
+      }
+
+      ::view-transition-old(page-content),
+      ::view-transition-new(page-content) {
+        animation-duration: 0.35s;
+        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+        animation-fill-mode: both;
+      }
+
+      /* Next: content slides out to the left, new content comes in from the right */
+      html:active-view-transition-type(forwards)::view-transition-old(page-content) {
+        animation-name: slide-out-to-left;
+      }
+
+      html:active-view-transition-type(forwards)::view-transition-new(page-content) {
+        animation-name: slide-in-from-right;
+      }
+
+      /* Previous: content slides out to the right, new content comes in from the left */
+      html:active-view-transition-type(backwards)::view-transition-old(page-content) {
+        animation-name: slide-out-to-right;
+      }
+
+      html:active-view-transition-type(backwards)::view-transition-new(page-content) {
+        animation-name: slide-in-from-left;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      @view-transition {
+        navigation: none;
+      }
+    }
+
+    @keyframes slide-out-to-left {
+      to { opacity: 0; transform: translateX(-60px); }
+    }
+
+    @keyframes slide-in-from-right {
+      from { opacity: 0; transform: translateX(60px); }
+    }
+
+    @keyframes slide-out-to-right {
+      to { opacity: 0; transform: translateX(60px); }
+    }
+
+    @keyframes slide-in-from-left {
+      from { opacity: 0; transform: translateX(-60px); }
+    }
   </style>
+  <script>
+    // Tag cross-document view transitions with a direction type so CSS can
+    // pick the right slide animation for "previous" vs "next" navigation.
+    (function () {
+      var KEY = 'vt-direction';
+
+      function directionFromLink(link) {
+        if (!link) return null;
+        if (link.id === 'next') return 'forwards';
+        if (link.id === 'previous') return 'backwards';
+        return null;
+      }
+
+      // Remember which pagination link was used (fallback for pagereveal).
+      document.addEventListener('click', function (e) {
+        var link = e.target.closest && e.target.closest('a#previous, a#next');
+        var dir = directionFromLink(link);
+        try {
+          if (dir) sessionStorage.setItem(KEY, dir);
+          else sessionStorage.removeItem(KEY);
+        } catch (err) {}
+      });
+
+      // Outgoing page: decide direction from the destination URL.
+      window.addEventListener('pageswap', function (e) {
+        if (!e.viewTransition || !e.activation) return;
+        var url = e.activation.entry && e.activation.entry.url;
+        var dir = null;
+        ['previous', 'next'].forEach(function (id) {
+          var link = document.getElementById(id);
+          if (link && url && link.href === url) dir = directionFromLink(link);
+        });
+        if (!dir && e.activation.navigationType === 'traverse' && e.activation.from) {
+          dir = e.activation.entry.index < e.activation.from.index ? 'backwards' : 'forwards';
+        }
+        if (dir) e.viewTransition.types.add(dir);
+        else e.viewTransition.skipTransition();
+      });
+
+      // Incoming page: apply the same direction type.
+      window.addEventListener('pagereveal', function (e) {
+        if (!e.viewTransition) return;
+        var dir = null;
+        try {
+          dir = sessionStorage.getItem(KEY);
+          sessionStorage.removeItem(KEY);
+        } catch (err) {}
+        if (!dir && window.navigation && navigation.activation &&
+            navigation.activation.navigationType === 'traverse' && navigation.activation.from) {
+          dir = navigation.activation.entry.index < navigation.activation.from.index ? 'backwards' : 'forwards';
+        }
+        if (dir) e.viewTransition.types.add(dir);
+        else e.viewTransition.skipTransition();
+      });
+    })();
+  </script>
