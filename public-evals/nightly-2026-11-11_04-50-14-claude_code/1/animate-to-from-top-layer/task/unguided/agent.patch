+  <script>
+    (function () {
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      // Run `done` once the element finishes its transition (with a timeout fallback).
+      function afterTransition(el, done) {
+        if (reduceMotion.matches) { done(); return; }
+        let finished = false;
+        const finish = () => {
+          if (finished) return;
+          finished = true;
+          el.removeEventListener('transitionend', onEnd);
+          clearTimeout(timer);
+          done();
+        };
+        const onEnd = (e) => { if (e.target === el) finish(); };
+        const timer = setTimeout(finish, 400);
+        el.addEventListener('transitionend', onEnd);
+      }
+
+      /* ---------- Logout confirmation dialog ---------- */
+      const dialog = document.getElementById('logout-dialog');
+      const openBtn = document.getElementById('open-dialog-btn');
+      const closeBtn = document.getElementById('close-dialog-btn');
+      let closing = false;
+
+      function openDialog() {
+        if (dialog.open) return;
+        closing = false;
+        dialog.showModal();
+        closeBtn.focus();
+        void dialog.offsetWidth; // commit starting styles before transitioning
+        dialog.classList.add('is-open');
+      }
+
+      function closeDialog() {
+        if (!dialog.open || closing) return;
+        closing = true;
+        dialog.classList.remove('is-open');
+        afterTransition(dialog, () => {
+          closing = false;
+          if (!dialog.classList.contains('is-open')) dialog.close();
+        });
+      }
+
+      openBtn.addEventListener('click', (e) => {
+        e.preventDefault();
+        openDialog();
+      });
+      closeBtn.addEventListener('click', closeDialog);
+
+      // Escape key: animate out instead of closing instantly.
+      dialog.addEventListener('cancel', (e) => {
+        e.preventDefault();
+        closeDialog();
+      });
+
+      // Click on backdrop closes the dialog.
+      dialog.addEventListener('click', (e) => {
+        if (e.target !== dialog) return;
+        const r = dialog.getBoundingClientRect();
+        const inside = e.clientX >= r.left && e.clientX <= r.right &&
+                       e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDialog();
+      });
+
+      // Return focus to the trigger once fully closed.
+      dialog.addEventListener('close', () => openBtn.focus());
+
+      /* ---------- Floating informational notice ---------- */
+      const notice = document.getElementById('info-notice');
+      const noticeBtn = document.getElementById('foobar');
+      const noticeClose = document.getElementById('close-notice-btn');
+
+      function showNotice() {
+        notice.hidden = false;
+        void notice.offsetWidth;
+        notice.classList.add('is-visible');
+        noticeBtn.setAttribute('aria-expanded', 'true');
+      }
+
+      function hideNotice() {
+        if (notice.hidden) return;
+        notice.classList.remove('is-visible');
+        noticeBtn.setAttribute('aria-expanded', 'false');
+        afterTransition(notice, () => {
+          if (!notice.classList.contains('is-visible')) notice.hidden = true;
+        });
+      }
+
+      noticeBtn.setAttribute('aria-expanded', 'false');
+      noticeBtn.addEventListener('click', () => {
+        notice.classList.contains('is-visible') ? hideNotice() : showNotice();
+      });
+      noticeClose.addEventListener('click', () => {
+        hideNotice();
+        noticeBtn.focus();
+      });
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && !dialog.open && notice.classList.contains('is-visible')) hideNotice();
+      });
+    })();
+  </script>
