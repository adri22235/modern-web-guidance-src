+  <script type="module">
+    // Conditionally polyfill Invoker Commands and Popover only where missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    // Exit animations need both `overlay` and discrete `display` transitions.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+        return (supportsDisplayTransition = false);
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+    const supportsTopLayerExit = () =>
+      window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+
+    async function closeTopLayer(el) {
+      if (!supportsTopLayerExit()) {
+        el.setAttribute('data-closing', '');
+        const animations = el.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!el.hasAttribute('data-closing')) return;
+        el.removeAttribute('data-closing');
+      }
+      if (el instanceof HTMLDialogElement) el.close();
+      else el.hidePopover();
+    }
+
+    // ----- Logout dialog -----
+    const dialog = document.getElementById('logout-dialog');
+    document.getElementById('close-dialog-btn').addEventListener('click', () => closeTopLayer(dialog));
+
+    // Route Esc / light dismiss through the animated close where the browser can't animate it natively
+    dialog.addEventListener('cancel', (event) => {
+      if (supportsTopLayerExit()) return;
+      event.preventDefault();
+      closeTopLayer(dialog);
+    });
+
+    // closedby="any" fallback (Safari): close on press + release outside the dialog box
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e)) closeTopLayer(dialog);
+      });
+    }
+
+    // ----- Informational notice -----
+    const notice = document.getElementById('info-notice');
+    const trigger = document.getElementById('foobar');
+    const announcer = document.getElementById('sr-announcer');
+
+    notice.addEventListener('toggle', (event) => {
+      if (event.newState !== 'open') return;
+      const message = document.getElementById('info-notice-text').textContent.replace(/\s+/g, ' ').trim();
+      if ('ariaNotify' in document) {
+        document.ariaNotify(message);
+      } else {
+        announcer.textContent = '';
+        requestAnimationFrame(() => { announcer.textContent = message; });
+      }
+    });
+
+    notice.querySelector('.notice-close').addEventListener('click', async () => {
+      const hadFocus = notice.contains(document.activeElement);
+      await closeTopLayer(notice);
+      if (hadFocus) trigger.focus();
+    });
+  </script>
+
