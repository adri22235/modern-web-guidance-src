+  <script type="module">
+    import './star-rating.js';
+
+    const form = document.getElementById('feedback-form');
+    const drink = document.getElementById('drink');
+    const ratings = document.getElementById('ratings');
+    const status = document.getElementById('form-status');
+
+    // The ratings fieldset is enabled in markup (so it works without JS) and
+    // disabled here until a drink is chosen. Disabling the fieldset natively
+    // disables every <star-rating> inside it via formDisabledCallback, and
+    // bars them from constraint validation.
+    const syncRatings = () => {
+      ratings.disabled = !drink.value;
+    };
+    syncRatings();
+    drink.addEventListener('change', syncRatings);
+    // `reset` fires before controls are reset; sync once values are restored.
+    form.addEventListener('reset', () => {
+      setTimeout(syncRatings);
+      status.value = '';
+    });
+    // Back/forward navigation restores the select (and the star ratings via
+    // formStateRestoreCallback) — re-sync the fieldset afterwards.
+    window.addEventListener('pageshow', syncRatings);
+
+    // Inline error text for required star ratings, alongside the native bubble.
+    for (const rating of form.querySelectorAll('star-rating[required]')) {
+      const error = document.getElementById(`${rating.id}-error`);
+      if (!error) continue;
+      rating.addEventListener('invalid', () => {
+        error.textContent = rating.validationMessage;
+      });
+      rating.addEventListener('change', () => {
+        if (rating.validity.valid) error.textContent = '';
+      });
+      form.addEventListener('reset', () => {
+        error.textContent = '';
+      });
+    }
+
+    // Only fires once native constraint validation passes (including the
+    // required <star-rating>). Without JS, the form posts to /feedback.
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const drinkName = drink.selectedOptions[0].textContent;
+      const parts = ['flavor', 'aroma', 'service']
+        .filter((key) => data.has(key))
+        .map((key) => `${key} ${data.get(key)}/5`);
+      // fetch(form.action, { method: form.method, body: data });
+      status.value = `Thanks! We got your feedback on the ${drinkName} (${parts.join(', ')}).`;
+    });
+  </script>
+
 </body>
 
