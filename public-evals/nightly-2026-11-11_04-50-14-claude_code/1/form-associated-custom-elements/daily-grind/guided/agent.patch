diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..da61418
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,318 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Attributes (mirroring native controls):
+ *   name      Submitted field name (handled natively by the form).
+ *   value     Default value (like <input value>), restored on form reset.
+ *   max       Number of stars, 1–10 (default 5).
+ *   required  Participates in constraint validation (valueMissing).
+ *   disabled  Disables the control; also honours <fieldset disabled>.
+ *
+ * Events: native `input` (composed from the inner radios) and `change`.
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base, selection, hover;
+
+  @layer base {
+    :host {
+      --star-size: 2rem;
+      --star-filled: #ffab40;
+      --star-hover: #ffc976;
+      --star-empty: #efe7e4;
+      --star-stroke: #6d4c41;
+      --star-focus: #4e342e;
+      display: inline-block;
+    }
+
+    :host([hidden]) { display: none; }
+
+    :host(:disabled) { opacity: 0.55; }
+
+    .stars {
+      display: inline-flex;
+      gap: 0.125rem;
+    }
+
+    label {
+      display: grid;
+      place-items: center;
+      min-inline-size: 48px;
+      min-block-size: 48px;
+      border-radius: 6px;
+      color: var(--star-empty);
+      cursor: pointer;
+      transition: color 0.15s, transform 0.15s;
+    }
+
+    :host(:disabled) label { cursor: not-allowed; }
+
+    label:has(:focus-visible) {
+      outline: 3px solid var(--star-focus);
+      outline-offset: -2px;
+    }
+
+    svg {
+      inline-size: var(--star-size);
+      block-size: var(--star-size);
+      fill: currentColor;
+      stroke: var(--star-stroke);
+      stroke-width: 1.25;
+      stroke-linejoin: round;
+    }
+
+    /* Canonical visually-hidden recipe: keeps the radios in the a11y tree. */
+    input {
+      position: absolute;
+      clip-path: inset(50%);
+      overflow: hidden;
+      inline-size: 1px;
+      block-size: 1px;
+      margin: -1px;
+      padding: 0;
+      border: 0;
+      white-space: nowrap;
+    }
+
+    @media (forced-colors: active) {
+      :host {
+        --star-filled: Highlight;
+        --star-hover: Highlight;
+        --star-empty: Canvas;
+        --star-stroke: CanvasText;
+        --star-focus: Highlight;
+      }
+    }
+  }
+
+  /* Fill every star up to and including the checked one. */
+  @layer selection {
+    .stars:has(:checked) label { color: var(--star-filled); }
+    .stars label:has(:checked) ~ label { color: var(--star-empty); }
+  }
+
+  /* Hover preview wins over the selection (later layer). */
+  @layer hover {
+    @media (hover: hover) {
+      :host(:not(:disabled)) .stars:hover label { color: var(--star-hover); }
+      :host(:not(:disabled)) .stars label:hover ~ label { color: var(--star-empty); }
+      :host(:not(:disabled)) label:hover { transform: scale(1.1); }
+    }
+    @media (prefers-reduced-motion: reduce) {
+      label { transition: none; }
+      :host(:not(:disabled)) label:hover { transform: none; }
+    }
+  }
+`);
+
+const STAR_PATH =
+  'M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z';
+
+const supportsStates = 'states' in ElementInternals.prototype;
+
+export class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['max', 'value', 'required'];
+
+  #internals;
+  #group;
+  #value = '';
+  #dirty = false; // true once the user or script sets .value (like native inputs)
+  #disabled = false;
+  #interacted = false;
+  #customError = '';
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.adoptedStyleSheets = [sheet];
+    this.#group = document.createElement('div');
+    this.#group.className = 'stars';
+    this.#group.part = 'stars';
+    root.append(this.#group);
+
+    // Native radio `input` events are composed, so they already reach outside
+    // listeners (retargeted to the host). Update our value first.
+    root.addEventListener('input', (event) => {
+      if (!(event.target instanceof HTMLInputElement)) return;
+      this.#dirty = true;
+      this.#interacted = true;
+      this.#setValue(event.target.value);
+    });
+
+    // `change` is not composed, so re-dispatch it from the host.
+    root.addEventListener('change', (event) => {
+      event.stopPropagation();
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+
+    // Fired by checkValidity()/reportValidity()/form submission.
+    this.addEventListener('invalid', () => {
+      this.#interacted = true;
+      this.#updateUserInvalid();
+    });
+
+    this.#render();
+  }
+
+  connectedCallback() {
+    // Handle a `value` property set before the element was upgraded.
+    if (Object.hasOwn(this, 'value')) {
+      const v = this.value;
+      delete this.value;
+      this.value = v;
+    }
+    this.#updateValidity();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'max') {
+      this.#render();
+      this.#setValue(this.#value);
+    } else if (name === 'value' && !this.#dirty) {
+      this.#setValue(this.defaultValue);
+    } else if (name === 'required') {
+      this.#updateValidity();
+    }
+  }
+
+  /* ---------- Form-associated lifecycle ---------- */
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#interacted = false;
+    this.#setValue(this.defaultValue);
+  }
+
+  formDisabledCallback(disabled) {
+    // Never toggle `disabled` on the host here: that would stick after an
+    // ancestor <fieldset> is re-enabled. The host matches :disabled already.
+    this.#disabled = disabled;
+    for (const radio of this.#radios) radio.disabled = disabled;
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#setValue(typeof state === 'string' ? state : '');
+  }
+
+  /* ---------- Public API (mirrors native controls) ---------- */
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+
+  get valueAsNumber() { return this.#value ? Number(this.#value) : NaN; }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get max() {
+    const n = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(n) && n >= 1 && n <= 10 ? n : 5;
+  }
+  set max(v) { this.setAttribute('max', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get type() { return this.localName; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  setCustomValidity(message) {
+    this.#customError = String(message ?? '');
+    this.#updateValidity();
+  }
+
+  /* ---------- Internals ---------- */
+
+  get #radios() {
+    return this.#group.querySelectorAll('input');
+  }
+
+  #render() {
+    const max = this.max;
+    const labels = [];
+    for (let i = 1; i <= max; i++) {
+      const label = document.createElement('label');
+      const radio = document.createElement('input');
+      radio.type = 'radio';
+      radio.name = 'star'; // scoped to this shadow root
+      radio.value = String(i);
+      radio.disabled = this.#disabled;
+      radio.setAttribute('aria-label', `${i} ${i === 1 ? 'star' : 'stars'} out of ${max}`);
+      label.append(radio);
+      label.insertAdjacentHTML(
+        'beforeend',
+        `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="${STAR_PATH}"/></svg>`,
+      );
+      labels.push(label);
+    }
+    this.#group.replaceChildren(...labels);
+  }
+
+  #setValue(raw) {
+    const n = Number.parseInt(raw, 10);
+    this.#value = Number.isInteger(n) && n >= 1 && n <= this.max ? String(n) : '';
+
+    for (const radio of this.#radios) radio.checked = radio.value === this.#value;
+
+    // null = submit nothing, just like an unchecked radio group.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#updateValidity();
+  }
+
+  #updateValidity() {
+    this.#internals.ariaRequired = String(this.required);
+    const anchor = this.#group.querySelector(':checked') ?? this.#radios[0];
+
+    if (this.#customError) {
+      this.#internals.setValidity({ customError: true }, this.#customError, anchor);
+    } else if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        `Please choose a rating from 1 to ${this.max} stars.`,
+        anchor,
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+    this.#updateUserInvalid();
+  }
+
+  // Custom `:state(user-invalid)` — only after interaction or a submit attempt,
+  // so empty required ratings aren't flagged on page load.
+  #updateUserInvalid() {
+    const userInvalid = this.#interacted && !this.#internals.validity.valid;
+    this.#internals.ariaInvalid = String(userInvalid);
+    if (supportsStates) {
+      try {
+        this.#internals.states[userInvalid ? 'add' : 'delete']('user-invalid');
+      } catch {
+        // Older implementations required the legacy `--` prefix.
+        this.#internals.states[userInvalid ? 'add' : 'delete']('--user-invalid');
+      }
+    }
+  }
+}
+
+customElements.define('star-rating', StarRating);
