diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..6083f98
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,321 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Behaves like a native form control:
+ *  - Submits `name=value` with its form (nothing is submitted when unrated).
+ *  - Supports `required` constraint validation (:invalid, checkValidity, reportValidity).
+ *  - Resets to its `value` attribute (the default value) on form reset.
+ *  - Is disabled by its own `disabled` attribute or by an ancestor <fieldset disabled>.
+ *  - Restores its value on back/forward navigation and autofill (formStateRestoreCallback).
+ *  - Is labelable (<label for>, fieldset/legend) and keyboard accessible (ARIA slider).
+ *
+ * Attributes: name, value (default value), max (default 5), required, disabled.
+ * Events: `input` and `change` fire on user interaction, like native inputs.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      --star-size: 2rem;
+      --star-color: #ffab40;
+      --star-empty: #d7ccc8;
+      --star-focus: #4e342e;
+      border-radius: 6px;
+      outline-offset: 3px;
+      cursor: pointer;
+      user-select: none;
+      -webkit-tap-highlight-color: transparent;
+    }
+    :host([hidden]) { display: none; }
+    :host(:focus-visible) { outline: 2px solid var(--star-focus); }
+    :host(:disabled) { cursor: not-allowed; opacity: 0.5; }
+    .stars { display: inline-flex; }
+    .star {
+      width: var(--star-size);
+      height: var(--star-size);
+      padding: 0 2px;
+      color: var(--star-empty);
+      transition: color 0.15s, transform 0.15s;
+    }
+    .star svg { width: 100%; height: 100%; display: block; fill: currentColor; }
+    .star.on { color: var(--star-color); }
+    .stars.previewing .star.preview { color: var(--star-color); opacity: 0.7; }
+    .stars.previewing .star.on:not(.preview) { color: var(--star-empty); }
+    :host(:not(:disabled)) .star:hover { transform: scale(1.12); }
+    .text { font-size: 0.9rem; min-width: 5.5em; color: inherit; }
+    @media (prefers-reduced-motion: reduce) { .star { transition: none; } }
+  </style>
+  <span class="stars" part="stars"></span>
+  <span class="text" part="text" aria-hidden="true"></span>
+`;
+
+const STAR_SVG =
+  '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>';
+
+const WORDS = ['Not rated', 'Poor', 'Fair', 'Good', 'Great', 'Excellent'];
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'max', 'required', 'disabled'];
+
+  #internals;
+  #value = 0;
+  #dirty = false; // true once the user (or script) changed the value; attribute changes no longer apply
+  #formDisabled = false;
+  #customError = '';
+  #savedTabIndex = '0';
+  #starsEl;
+  #textEl;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this.#starsEl = root.querySelector('.stars');
+    this.#textEl = root.querySelector('.text');
+
+    this.addEventListener('click', this.#onClick);
+    this.addEventListener('keydown', this.#onKeyDown);
+    this.#starsEl.addEventListener('pointermove', this.#onPointerMove);
+    this.#starsEl.addEventListener('pointerleave', this.#clearPreview);
+
+    // ARIA via ElementInternals where supported (keeps the host's attributes clean).
+    this.#setAria('role', 'slider');
+    this.#setAria('ariaValueMin', '0');
+  }
+
+  connectedCallback() {
+    if (!this.hasAttribute('tabindex') && !this.#isDisabled) this.tabIndex = 0;
+    if (!this.#dirty) this.#value = this.#clamp(this.#defaultValue());
+    if (!this.#starsEl.childElementCount) this.#renderStars();
+    this.#syncFocusability();
+    this.#update();
+  }
+
+  attributeChangedCallback(name) {
+    if (!this.#starsEl) return;
+    if (name === 'max') {
+      this.#value = this.#clamp(this.#value);
+      this.#renderStars();
+    } else if (name === 'value' && !this.#dirty) {
+      this.#value = this.#clamp(this.#defaultValue());
+    } else if (name === 'disabled') {
+      this.#syncFocusability();
+    }
+    this.#update();
+  }
+
+  /* ---------- Form lifecycle callbacks ---------- */
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#clamp(this.#defaultValue());
+    this.#update();
+  }
+
+  formDisabledCallback(disabled) {
+    // Called for the element's own `disabled` attribute and for ancestor <fieldset disabled>.
+    this.#formDisabled = disabled;
+    this.#clearPreview();
+    this.#syncFocusability();
+    this.#update();
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    // `state` is what we passed as the 2nd arg to setFormValue (mode: "restore"),
+    // or an autofill value (mode: "autocomplete").
+    const n = Number(state);
+    this.#value = Number.isFinite(n) ? this.#clamp(n) : 0;
+    this.#dirty = true;
+    this.#update();
+  }
+
+  /* ---------- Public API (mirrors native controls) ---------- */
+
+  get value() { return this.#value ? String(this.#value) : ''; }
+  set value(v) {
+    this.#dirty = true;
+    this.#value = this.#clamp(Number(v) || 0);
+    this.#update();
+  }
+  get valueAsNumber() { return this.#value; }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get max() { const m = parseInt(this.getAttribute('max'), 10); return m > 0 && m <= 10 ? m : 5; }
+  set max(v) { this.setAttribute('max', v); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get type() { return 'star-rating'; }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  setCustomValidity(message) {
+    this.#customError = String(message ?? '');
+    this.#update();
+  }
+
+  /* ---------- Internals ---------- */
+
+  get #isDisabled() { return this.disabled || this.#formDisabled; }
+
+  #defaultValue() { return Number(this.getAttribute('value')) || 0; }
+
+  #clamp(n) { return Math.max(0, Math.min(this.max, Math.round(n))); }
+
+  #setAria(prop, value) {
+    if (prop in this.#internals) this.#internals[prop] = value;
+    else {
+      const attr = prop === 'role' ? 'role' : prop.replace(/^aria/, 'aria-').toLowerCase();
+      if (value == null) this.removeAttribute(attr);
+      else this.setAttribute(attr, value);
+    }
+  }
+
+  #syncFocusability() {
+    // Disabled controls are removed from the tab order and can't be focused, like native ones.
+    if (this.#isDisabled) {
+      if (this.hasAttribute('tabindex')) {
+        this.#savedTabIndex = this.getAttribute('tabindex');
+        this.removeAttribute('tabindex');
+      }
+      if (this.matches(':focus')) this.blur();
+    } else if (!this.hasAttribute('tabindex')) {
+      this.setAttribute('tabindex', this.#savedTabIndex);
+    }
+  }
+
+  #renderStars() {
+    this.#starsEl.textContent = '';
+    for (let i = 1; i <= this.max; i++) {
+      const s = document.createElement('span');
+      s.className = 'star';
+      s.dataset.value = String(i);
+      s.part = 'star';
+      s.innerHTML = STAR_SVG;
+      this.#starsEl.appendChild(s);
+    }
+  }
+
+  #label(n) {
+    if (this.max === 5) return WORDS[n];
+    return n ? `${n} of ${this.max}` : WORDS[0];
+  }
+
+  #update() {
+    const v = this.#value;
+    this.#starsEl.querySelectorAll('.star').forEach((s) => {
+      s.classList.toggle('on', Number(s.dataset.value) <= v);
+    });
+    this.#textEl.textContent = this.#label(v);
+
+    // Form value + restorable state. Unrated submits nothing (like an unchecked radio group).
+    const str = v ? String(v) : null;
+    this.#internals.setFormValue(str, str);
+
+    // Constraint validation.
+    if (this.#customError) {
+      this.#internals.setValidity({ customError: true }, this.#customError);
+    } else if (this.required && !v) {
+      this.#internals.setValidity({ valueMissing: true }, 'Please select a star rating.');
+    } else {
+      this.#internals.setValidity({});
+    }
+
+    this.#setAria('ariaValueMax', String(this.max));
+    this.#setAria('ariaValueNow', String(v));
+    this.#setAria('ariaValueText', v ? `${v} of ${this.max} stars, ${this.#label(v)}` : 'Not rated');
+    this.#setAria('ariaRequired', this.required ? 'true' : 'false');
+    this.#setAria('ariaDisabled', this.#isDisabled ? 'true' : null);
+  }
+
+  #commit(n) {
+    n = this.#clamp(n);
+    if (n === this.#value) return;
+    this.#dirty = true;
+    this.#value = n;
+    this.#update();
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #starFromEvent(e) {
+    const star = e.composedPath().find((el) => el.classList?.contains('star'));
+    return star ? Number(star.dataset.value) : 0;
+  }
+
+  #onClick = (e) => {
+    if (this.#isDisabled) return;
+    const n = this.#starFromEvent(e);
+    if (n) {
+      this.#commit(n);
+      this.focus({ preventScroll: true });
+    }
+  };
+
+  #onKeyDown = (e) => {
+    if (this.#isDisabled) return;
+    const v = this.#value;
+    let next = null;
+    switch (e.key) {
+      case 'ArrowRight':
+      case 'ArrowUp': next = v + 1; break;
+      case 'ArrowLeft':
+      case 'ArrowDown': next = v - 1; break;
+      case 'Home': next = this.required ? 1 : 0; break;
+      case 'End': next = this.max; break;
+      case 'Backspace':
+      case 'Delete': next = 0; break;
+      case 'Enter':
+        // Mirror native inputs: Enter performs implicit submission.
+        this.form?.requestSubmit();
+        e.preventDefault();
+        return;
+      default:
+        if (/^[0-9]$/.test(e.key) && Number(e.key) <= this.max) next = Number(e.key);
+    }
+    if (next !== null) {
+      e.preventDefault();
+      this.#commit(next);
+    }
+  };
+
+  #onPointerMove = (e) => {
+    if (this.#isDisabled || e.pointerType === 'touch') return;
+    const n = this.#starFromEvent(e);
+    if (!n) return;
+    this.#starsEl.classList.add('previewing');
+    this.#starsEl.querySelectorAll('.star').forEach((s) => {
+      s.classList.toggle('preview', Number(s.dataset.value) <= n);
+    });
+    this.#textEl.textContent = this.#label(n);
+  };
+
+  #clearPreview = () => {
+    this.#starsEl.classList.remove('previewing');
+    this.#starsEl.querySelectorAll('.preview').forEach((s) => s.classList.remove('preview'));
+    this.#textEl.textContent = this.#label(this.#value);
+  };
+}
+
+if (!customElements.get('star-rating')) customElements.define('star-rating', StarRating);
+
+export { StarRating };
