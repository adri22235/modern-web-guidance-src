+  <script type="module">
+    import './star-rating.js';
+
+    const form = document.getElementById('feedback-form');
+    const fieldset = document.getElementById('feedback-fieldset');
+    const submitBtn = document.getElementById('feedback-submit');
+    const status = document.getElementById('form-status');
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      form.classList.add('was-validated');
+      status.className = 'form-status';
+      status.textContent = '';
+
+      // Native constraint validation covers the <star-rating> too (via ElementInternals).
+      if (!form.checkValidity()) {
+        form.querySelector(':invalid:not(fieldset)')?.focus();
+        form.reportValidity();
+        return;
+      }
+
+      // Collect data before disabling: disabled controls (including <star-rating>
+      // inside a disabled fieldset) are excluded from FormData, like native inputs.
+      const data = new FormData(form);
+      fieldset.disabled = true;
+      submitBtn.disabled = true;
+      status.textContent = 'Sending\u2026';
+
+      try {
+        // No backend on this static site yet; simulate the request.
+        // Swap for: await fetch(form.action, { method: 'POST', body: data });
+        await new Promise((resolve) => setTimeout(resolve, 800));
+        const taste = data.get('taste');
+        status.classList.add('success');
+        status.textContent = `Thanks! You rated your coffee ${taste} out of 5 stars.`;
+        form.reset();
+        form.classList.remove('was-validated');
+      } catch {
+        status.textContent = 'Something went wrong. Please try again.';
+      } finally {
+        fieldset.disabled = false;
+        submitBtn.disabled = false;
+      }
+    });
+
+    form.addEventListener('reset', () => {
+      form.classList.remove('was-validated');
+    });
+  </script>
+
