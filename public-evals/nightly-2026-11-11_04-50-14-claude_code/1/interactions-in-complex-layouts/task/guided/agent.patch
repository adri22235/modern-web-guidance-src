+  <script>
+    (() => {
+      const STATUSES = ['queued', 'brewing', 'ready'];
+      const LABELS = { queued: 'Queued', brewing: 'Brewing', ready: 'Ready' };
+      const STORAGE_KEY = 'daily-grind-orders';
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const board = document.getElementById('board');
+      const liveRegion = document.getElementById('board-status');
+
+      const columns = Object.fromEntries(STATUSES.map((status) => {
+        const el = board.querySelector(`.board-column[data-status="${status}"]`);
+        return [status, { el, list: el.querySelector('.card-list'), count: el.querySelector('.column-count') }];
+      }));
+
+      const defaults = [
+        { id: 101, customer: 'Ava', drink: 'Maple Oat Latte', size: 'Medium', status: 'queued' },
+        { id: 102, customer: 'Ben', drink: 'Cold Brew', size: 'Large', status: 'queued' },
+        { id: 103, customer: 'Chloe', drink: 'Cappuccino', size: 'Small', status: 'queued' },
+        { id: 104, customer: 'Dev', drink: 'Dark Roast Espresso', size: 'Small', status: 'brewing' },
+        { id: 105, customer: 'Elena', drink: 'Chai Latte', size: 'Medium', status: 'brewing' },
+        { id: 106, customer: 'Finn', drink: 'Flat White', size: 'Medium', status: 'ready' },
+      ];
+
+      let orders;
+      try {
+        orders = JSON.parse(localStorage.getItem(STORAGE_KEY)) || defaults;
+        if (!Array.isArray(orders)) orders = defaults;
+      } catch {
+        orders = defaults;
+      }
+      const byId = new Map(orders.map((o) => [String(o.id), o]));
+
+      // Persist order from the DOM (the DOM is the source of truth for sequence).
+      function save() {
+        const list = [];
+        for (const status of STATUSES) {
+          for (const card of columns[status].list.children) {
+            const order = byId.get(card.dataset.id);
+            if (order) list.push({ ...order, status });
+          }
+        }
+        orders = list;
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(list)); } catch { /* storage unavailable */ }
+      }
+
+      function createCard(order) {
+        const li = document.createElement('li');
+        li.className = 'card';
+        li.draggable = true;
+        li.dataset.id = order.id;
+        li.id = `order-${order.id}`;
+
+        const top = document.createElement('div');
+        top.className = 'card-top';
+        const h4 = document.createElement('h4');
+        h4.textContent = order.drink;
+        const idEl = document.createElement('span');
+        idEl.className = 'order-id';
+        idEl.textContent = `#${order.id}`;
+        top.append(h4, idEl);
+
+        const meta = document.createElement('div');
+        meta.className = 'order-meta';
+        meta.textContent = order.size;
+
+        const customer = document.createElement('div');
+        customer.className = 'order-customer';
+        customer.textContent = `For ${order.customer}`;
+
+        const actions = document.createElement('div');
+        actions.className = 'card-actions';
+        const back = document.createElement('button');
+        back.type = 'button';
+        back.dataset.action = 'back';
+        back.textContent = '←';
+        const fwd = document.createElement('button');
+        fwd.type = 'button';
+        fwd.dataset.action = 'forward';
+        fwd.textContent = '→';
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.dataset.action = 'remove';
+        remove.className = 'remove-btn';
+        actions.append(back, fwd, remove);
+
+        li.append(top, meta, customer, actions);
+        return li;
+      }
+
+      // Per-card state that depends on which column the card is in.
+      function updateCardControls(card, status) {
+        const order = byId.get(card.dataset.id);
+        const idx = STATUSES.indexOf(status);
+        const [back, fwd, remove] = card.querySelectorAll('.card-actions button');
+        back.hidden = idx === 0;
+        fwd.hidden = idx === STATUSES.length - 1;
+        back.setAttribute('aria-label', `Move ${order.drink} for ${order.customer} back to ${LABELS[STATUSES[idx - 1]] ?? ''}`);
+        fwd.setAttribute('aria-label', `Move ${order.drink} for ${order.customer} to ${LABELS[STATUSES[idx + 1]] ?? ''}`);
+        remove.textContent = status === 'ready' ? 'Picked up' : 'Cancel';
+        remove.setAttribute('aria-label', `${remove.textContent}: ${order.drink} for ${order.customer}`);
+      }
+
+      // Only touches a single column: count + controls of its own cards.
+      function refreshColumn(status) {
+        const { list, count } = columns[status];
+        count.textContent = list.children.length;
+        for (const card of list.children) updateCardControls(card, status);
+      }
+
+      // Initial render: each column renders its own cards independently.
+      function renderColumn(status) {
+        const frag = document.createDocumentFragment();
+        for (const order of orders) {
+          if (order.status === status) frag.append(createCard(order));
+        }
+        columns[status].list.replaceChildren(frag);
+        refreshColumn(status);
+      }
+      STATUSES.forEach(renderColumn);
+
+      let announceTimer;
+      function announce(message) {
+        clearTimeout(announceTimer);
+        liveRegion.textContent = '';
+        announceTimer = setTimeout(() => { liveRegion.textContent = message; }, 500);
+      }
+
+      const statusOf = (card) => card.closest('.board-column').dataset.status;
+
+      // Move a card node (preserving it) into `list` before `ref`, with a FLIP animation.
+      function moveCard(card, toStatus, ref = null, { focusSelector } = {}) {
+        const fromStatus = statusOf(card);
+        const list = columns[toStatus].list;
+        if (ref === card || (card.parentElement === list && card.nextElementSibling === ref && ref !== null)) return false;
+        if (card.parentElement === list && ref === null && card === list.lastElementChild) return false;
+
+        const first = card.getBoundingClientRect();
+        if ('moveBefore' in Element.prototype && card.isConnected) {
+          list.moveBefore(card, ref);
+        } else {
+          list.insertBefore(card, ref);
+        }
+
+        refreshColumn(toStatus);
+        if (fromStatus !== toStatus) refreshColumn(fromStatus);
+        save();
+
+        card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        if (focusSelector) {
+          const target = card.querySelector(`${focusSelector}:not([hidden])`) || card.querySelector('.card-actions button:not([hidden])');
+          target?.focus({ preventScroll: true });
+        }
+
+        if (!reduceMotion.matches) {
+          card.getAnimations().forEach((a) => a.finish());
+          const last = card.getBoundingClientRect();
+          const dx = first.left - last.left;
+          const dy = first.top - last.top;
+          if (dx || dy) {
+            card.animate(
+              [{ translate: `${dx}px ${dy}px` }, { translate: '0 0' }],
+              { duration: 220, easing: 'cubic-bezier(.2,.8,.2,1)' }
+            );
+          }
+        }
+
+        const order = byId.get(card.dataset.id);
+        const position = [...list.children].indexOf(card) + 1;
+        announce(`${order.drink} for ${order.customer} moved to ${LABELS[toStatus]}, position ${position} of ${list.children.length}.`);
+        return true;
+      }
+
+      // --- Button controls (keyboard-accessible alternative to dragging) ---
+      board.addEventListener('click', (e) => {
+        const btn = e.target.closest('.card-actions button');
+        if (!btn) return;
+        const card = btn.closest('.card');
+        const status = statusOf(card);
+        const idx = STATUSES.indexOf(status);
+        const action = btn.dataset.action;
+
+        if (action === 'remove') {
+          const order = byId.get(card.dataset.id);
+          const nextFocus = card.nextElementSibling || card.previousElementSibling;
+          card.remove();
+          byId.delete(card.dataset.id);
+          refreshColumn(status);
+          save();
+          nextFocus?.querySelector('.card-actions button:not([hidden])')?.focus();
+          announce(`${order.drink} for ${order.customer} ${status === 'ready' ? 'picked up' : 'cancelled'}.`);
+          return;
+        }
+
+        const to = STATUSES[idx + (action === 'forward' ? 1 : -1)];
+        if (to) moveCard(card, to, null, { focusSelector: `[data-action="${action}"]` });
+      });
+
+      // --- Drag and drop between columns ---
+      let dragged = null;
+      let dropTarget = null; // { status, ref }
+
+      function clearDropMarker() {
+        for (const status of STATUSES) {
+          const { el, list } = columns[status];
+          el.classList.remove('is-over');
+          list.removeAttribute('data-drop');
+          list.style.removeProperty('--drop-y');
+        }
+      }
+
+      // Find insertion point from layout midpoints (ignores in-flight animations).
+      function computeDrop(list, clientY) {
+        const rect = list.getBoundingClientRect();
+        const y = clientY - rect.top - list.clientTop + list.scrollTop;
+        const cards = [...list.children];
+        let ref = null;
+        for (const card of cards) {
+          if (card.offsetTop + card.offsetHeight / 2 > y) { ref = card; break; }
+        }
+        return ref;
+      }
+
+      function showMarker(status, ref) {
+        const { el, list } = columns[status];
+        const columnChanged = !el.classList.contains('is-over');
+        if (columnChanged) {
+          clearDropMarker();
+          el.classList.add('is-over');
+        }
+        // Skip the marker when dropping would be a no-op.
+        const sameSlot = dragged.parentElement === list &&
+          (ref === dragged || ref === dragged.nextElementSibling);
+        if (sameSlot) {
+          list.removeAttribute('data-drop');
+          return;
+        }
+        let y;
+        const gap = parseFloat(getComputedStyle(list).rowGap) || 0;
+        if (ref) {
+          y = ref.offsetTop - gap / 2;
+        } else if (list.lastElementChild) {
+          const last = list.lastElementChild;
+          y = last.offsetTop + last.offsetHeight + gap / 2;
+        } else {
+          y = parseFloat(getComputedStyle(list).paddingTop) || 0;
+        }
+        list.style.setProperty('--drop-y', `${y}px`);
+        list.setAttribute('data-drop', '');
+      }
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest?.('.card');
+        if (!card) return;
+        dragged = card;
+        e.dataTransfer.effectAllowed = 'move';
+        e.dataTransfer.setData('text/plain', card.dataset.id);
+        requestAnimationFrame(() => card.classList.add('is-dragging'));
+      });
+
+      board.addEventListener('dragover', (e) => {
+        if (!dragged) return;
+        const column = e.target.closest?.('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        e.dataTransfer.dropEffect = 'move';
+        const status = column.dataset.status;
+        const ref = computeDrop(columns[status].list, e.clientY);
+        dropTarget = { status, ref };
+        showMarker(status, ref);
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        const column = e.target.closest?.('.board-column');
+        if (column && !column.contains(e.relatedTarget)) {
+          column.classList.remove('is-over');
+          columns[column.dataset.status].list.removeAttribute('data-drop');
+          if (dropTarget?.status === column.dataset.status) dropTarget = null;
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        if (!dragged) return;
+        e.preventDefault();
+        const column = e.target.closest?.('.board-column');
+        if (column) {
+          const status = column.dataset.status;
+          const ref = computeDrop(columns[status].list, e.clientY);
+          dragged.classList.remove('is-dragging');
+          moveCard(dragged, status, ref);
+        }
+        endDrag();
+      });
+
+      function endDrag() {
+        dragged?.classList.remove('is-dragging');
+        dragged = null;
+        dropTarget = null;
+        clearDropMarker();
+      }
+      board.addEventListener('dragend', endDrag);
+
+      // --- New orders ---
+      const form = document.getElementById('order-form');
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const customer = String(data.get('customer')).trim();
+        if (!customer) return;
+        const nextId = Math.max(100, ...[...byId.keys()].map(Number)) + 1;
+        const order = { id: nextId, customer, drink: data.get('drink'), size: data.get('size'), status: 'queued' };
+        byId.set(String(order.id), order);
+        const card = createCard(order);
+        columns.queued.list.append(card);
+        refreshColumn('queued');
+        save();
+        form.reset();
+        form.elements.customer.focus();
+        announce(`Queued ${order.drink} for ${order.customer}.`);
+      });
+    })();
+  </script>
+
