+  <script>
+    (function () {
+      var STATUSES = ['queued', 'brewing', 'ready'];
+      var LABELS = { queued: 'Queued', brewing: 'Brewing', ready: 'Ready' };
+      var STORAGE_KEY = 'daily-grind-order-board';
+
+      // State is kept per column so each column can be rendered independently.
+      var state = load() || {
+        nextId: 105,
+        columns: {
+          queued: [
+            { id: 104, customer: 'Priya', drink: 'Cold Brew', size: 'Large' },
+            { id: 103, customer: 'Marcus', drink: 'Cappuccino', size: 'Small' }
+          ],
+          brewing: [
+            { id: 102, customer: 'Elena', drink: 'Maple Oat Latte', size: 'Medium' }
+          ],
+          ready: [
+            { id: 101, customer: 'Sam', drink: 'Dark Roast Espresso', size: 'Small' }
+          ]
+        }
+      };
+
+      function load() {
+        try {
+          var data = JSON.parse(localStorage.getItem(STORAGE_KEY));
+          if (data && data.columns && STATUSES.every(function (s) { return Array.isArray(data.columns[s]); })) {
+            return data;
+          }
+        } catch (e) { /* ignore */ }
+        return null;
+      }
+
+      function save() {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) { /* ignore */ }
+      }
+
+      var columnEls = {};
+      document.querySelectorAll('#board .board-column').forEach(function (col) {
+        columnEls[col.dataset.status] = {
+          root: col,
+          list: col.querySelector('.column-cards'),
+          count: col.querySelector('.column-count')
+        };
+      });
+
+      function createCard(order, status) {
+        var li = document.createElement('li');
+        li.className = 'card';
+        li.draggable = true;
+        li.tabIndex = 0;
+        li.dataset.id = String(order.id);
+        li.setAttribute('aria-label', order.drink + ' for ' + order.customer + ', ' + LABELS[status]);
+
+        var top = document.createElement('div');
+        top.className = 'card-top';
+        var drink = document.createElement('span');
+        drink.className = 'card-drink';
+        drink.textContent = order.drink;
+        var id = document.createElement('span');
+        id.className = 'card-id';
+        id.textContent = '#' + order.id;
+        top.append(drink, id);
+
+        var meta = document.createElement('div');
+        meta.className = 'card-meta';
+        meta.textContent = order.size + ' · ' + order.customer;
+
+        var actions = document.createElement('div');
+        actions.className = 'card-actions';
+        var idx = STATUSES.indexOf(status);
+        if (idx > 0) actions.appendChild(actionButton('← ' + LABELS[STATUSES[idx - 1]], 'move', STATUSES[idx - 1]));
+        if (idx < STATUSES.length - 1) actions.appendChild(actionButton(LABELS[STATUSES[idx + 1]] + ' →', 'move', STATUSES[idx + 1]));
+        if (status === 'ready') actions.appendChild(actionButton('Picked up', 'remove'));
+
+        li.append(top, meta, actions);
+        return li;
+      }
+
+      function actionButton(text, action, target) {
+        var b = document.createElement('button');
+        b.type = 'button';
+        b.textContent = text;
+        b.dataset.action = action;
+        if (target) b.dataset.target = target;
+        return b;
+      }
+
+      // Render a single column only; other columns' DOM is untouched.
+      function renderColumn(status) {
+        var els = columnEls[status];
+        var orders = state.columns[status];
+        var frag = document.createDocumentFragment();
+        if (orders.length === 0) {
+          var empty = document.createElement('li');
+          empty.className = 'column-empty';
+          empty.textContent = 'No orders';
+          frag.appendChild(empty);
+        } else {
+          orders.forEach(function (o) { frag.appendChild(createCard(o, status)); });
+        }
+        els.list.replaceChildren(frag);
+        els.count.textContent = String(orders.length);
+      }
+
+      function findOrder(id) {
+        for (var i = 0; i < STATUSES.length; i++) {
+          var list = state.columns[STATUSES[i]];
+          for (var j = 0; j < list.length; j++) {
+            if (list[j].id === id) return { status: STATUSES[i], index: j };
+          }
+        }
+        return null;
+      }
+
+      function moveOrder(id, toStatus, toIndex) {
+        var found = findOrder(id);
+        if (!found || !state.columns[toStatus]) return;
+        var from = state.columns[found.status];
+        var order = from.splice(found.index, 1)[0];
+        var to = state.columns[toStatus];
+        if (toIndex == null || toIndex > to.length) toIndex = to.length;
+        if (found.status === toStatus && found.index < toIndex) toIndex--;
+        to.splice(toIndex, 0, order);
+        save();
+        renderColumn(found.status);
+        if (toStatus !== found.status) renderColumn(toStatus);
+        var card = columnEls[toStatus].list.querySelector('.card[data-id="' + id + '"]');
+        return card;
+      }
+
+      function removeOrder(id) {
+        var found = findOrder(id);
+        if (!found) return;
+        state.columns[found.status].splice(found.index, 1);
+        save();
+        renderColumn(found.status);
+      }
+
+      // ---- Drag and drop ----
+      var draggingId = null;
+
+      function dropIndex(list, y) {
+        var cards = Array.prototype.filter.call(list.querySelectorAll('.card'), function (c) {
+          return Number(c.dataset.id) !== draggingId;
+        });
+        for (var i = 0; i < cards.length; i++) {
+          var r = cards[i].getBoundingClientRect();
+          if (y < r.top + r.height / 2) {
+            var found = findOrder(Number(cards[i].dataset.id));
+            return found ? found.index : i;
+          }
+        }
+        return null; // append
+      }
+
+      STATUSES.forEach(function (status) {
+        var els = columnEls[status];
+        var col = els.root;
+
+        col.addEventListener('dragstart', function (e) {
+          var card = e.target.closest && e.target.closest('.card');
+          if (!card) return;
+          draggingId = Number(card.dataset.id);
+          card.classList.add('dragging');
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.dataset.id);
+        });
+
+        col.addEventListener('dragend', function (e) {
+          var card = e.target.closest && e.target.closest('.card');
+          if (card) card.classList.remove('dragging');
+          draggingId = null;
+          STATUSES.forEach(function (s) { columnEls[s].root.classList.remove('drag-over'); });
+        });
+
+        col.addEventListener('dragover', function (e) {
+          e.preventDefault();
+          e.dataTransfer.dropEffect = 'move';
+          col.classList.add('drag-over');
+        });
+
+        col.addEventListener('dragleave', function (e) {
+          if (!col.contains(e.relatedTarget)) col.classList.remove('drag-over');
+        });
+
+        col.addEventListener('drop', function (e) {
+          e.preventDefault();
+          col.classList.remove('drag-over');
+          var id = draggingId != null ? draggingId : Number(e.dataTransfer.getData('text/plain'));
+          if (!id) return;
+          var idx = dropIndex(els.list, e.clientY);
+          // If the source column is this one, compute against the pre-move order.
+          moveOrder(id, status, idx);
+          draggingId = null;
+        });
+
+        // Button + keyboard controls (accessible alternative to dragging)
+        col.addEventListener('click', function (e) {
+          var btn = e.target.closest('button[data-action]');
+          if (!btn) return;
+          var card = btn.closest('.card');
+          var id = Number(card.dataset.id);
+          if (btn.dataset.action === 'move') moveOrder(id, btn.dataset.target);
+          else if (btn.dataset.action === 'remove') removeOrder(id);
+        });
+
+        col.addEventListener('keydown', function (e) {
+          var card = e.target.classList && e.target.classList.contains('card') ? e.target : null;
+          if (!card) return;
+          var idx = STATUSES.indexOf(status);
+          var target = null;
+          if (e.key === 'ArrowRight' && idx < STATUSES.length - 1) target = STATUSES[idx + 1];
+          if (e.key === 'ArrowLeft' && idx > 0) target = STATUSES[idx - 1];
+          if (!target) return;
+          e.preventDefault();
+          var moved = moveOrder(Number(card.dataset.id), target);
+          if (moved) moved.focus();
+        });
+      });
+
+      // ---- New orders ----
+      document.getElementById('order-form').addEventListener('submit', function (e) {
+        e.preventDefault();
+        var nameInput = document.getElementById('order-customer');
+        var customer = nameInput.value.trim();
+        if (!customer) return;
+        state.columns.queued.push({
+          id: state.nextId++,
+          customer: customer,
+          drink: document.getElementById('order-drink').value,
+          size: document.getElementById('order-size').value
+        });
+        save();
+        renderColumn('queued');
+        nameInput.value = '';
+        nameInput.focus();
+      });
+
+      STATUSES.forEach(renderColumn);
+    })();
+  </script>
+
 </body>
 
