+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-step-title">
+    <h4 id="tour-step-title">Earn points with Rewards ☕</h4>
+    <p>Every purchase earns you points. Redeem them for free drinks, pastries, and exclusive member perks.</p>
+    <button type="button" class="tour-close">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var tip = document.getElementById('tour-step');
+      var closeBtn = tip.querySelector('.tour-close');
+      var supportsPopover = typeof tip.showPopover === 'function';
+      var supportsAnchor = window.CSS && CSS.supports && CSS.supports('anchor-name: --a');
+      var open = false;
+      var rafId = null;
+
+      // JS fallback positioning for browsers without CSS anchor positioning
+      function position() {
+        var r = link.getBoundingClientRect();
+        var w = tip.offsetWidth;
+        var left = r.left + r.width / 2 - w / 2;
+        left = Math.max(12, Math.min(left, window.innerWidth - w - 12));
+        tip.style.left = left + 'px';
+        tip.style.top = (r.bottom + 14) + 'px';
+        tip.style.translate = 'none';
+        // Keep the arrow pointing at the link even when the box is clamped
+        tip.style.setProperty('--arrow-x', (r.left + r.width / 2 - left) + 'px');
+      }
+
+      function track() {
+        if (!open) return;
+        position();
+        rafId = requestAnimationFrame(track);
+      }
+
+      function show() {
+        open = true;
+        if (supportsPopover) tip.showPopover(); else { tip.removeAttribute('popover'); tip.classList.add('tour-open'); }
+        link.classList.add('tour-active');
+        if (!supportsAnchor) {
+          tip.classList.add('js-positioned');
+          track();
+        }
+      }
+
+      function hide() {
+        open = false;
+        if (rafId) cancelAnimationFrame(rafId);
+        if (supportsPopover && tip.matches(':popover-open')) tip.hidePopover();
+        tip.classList.remove('tour-open');
+        link.classList.remove('tour-active');
+        link.removeAttribute('aria-describedby');
+      }
+
+      // Prevent the rewards link from navigating away while the tour is open
+      link.addEventListener('click', function (e) {
+        if (open) e.preventDefault();
+      });
+
+      closeBtn.addEventListener('click', hide);
+
+      // Open by default
+      show();
+    })();
+  </script>
+
 </body>
 
