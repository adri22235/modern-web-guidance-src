+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var addBtn = document.getElementById('addBtn');
+      var removeBtn = document.getElementById('removeBtn');
+      var toggleBtn = document.getElementById('toggleBtn');
+      var toggleCard = document.getElementById('toggleCard');
+      var emptyMsg = document.getElementById('promoEmpty');
+
+      var EXIT_FALLBACK_MS = 600;
+
+      var promos = [
+        { title: 'Buy One, Gift One', text: 'Grab a latte and get a second for a friend, on us.', badge: 'BOGO',
+          img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80', alt: 'Two iced coffees on a table' },
+        { title: 'Pastry Pairing', text: 'Any espresso drink + a fresh croissant for just $6.', badge: 'Combo',
+          img: 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80', alt: 'Cozy cafe interior' },
+        { title: 'Double Stars Day', text: 'Earn 2x rewards points on every purchase this Friday.', badge: 'Rewards',
+          img: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80', alt: 'Cup of black coffee' },
+        { title: 'Beans to Go', text: 'Take 20% off any 1lb bag of our house-roasted beans.', badge: '20% Off',
+          img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80', alt: 'Roasted coffee beans' },
+        { title: 'Cold Brew Refill', text: 'Bring back your cup for a $2 cold brew refill all week.', badge: 'Refill',
+          img: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=80', alt: 'Iced cold brew in a glass' }
+      ];
+      var promoIndex = 0;
+
+      // Re-trigger CSS transitions reliably by forcing a style flush between states.
+      function animateIn(card) {
+        if (card._cancelExit) card._cancelExit();
+        card.classList.remove('is-leaving');
+        card.classList.add('is-entering');
+        void card.offsetWidth;
+        requestAnimationFrame(function () {
+          card.classList.remove('is-entering');
+        });
+      }
+
+      // Fade/scale out, then call done() once (on transitionend or after a fallback timeout).
+      function animateOut(card, done) {
+        if (card.classList.contains('is-leaving')) return;
+        var finished = false;
+        function cleanup() {
+          finished = true;
+          card._cancelExit = null;
+          card.removeEventListener('transitionend', onEnd);
+          clearTimeout(timer);
+        }
+        function finish() {
+          if (finished) return;
+          cleanup();
+          done();
+          updateState();
+        }
+        card._cancelExit = cleanup;
+        function onEnd(e) {
+          if (e.target === card && e.propertyName === 'opacity') finish();
+        }
+        card.addEventListener('transitionend', onEnd);
+        var timer = setTimeout(finish, EXIT_FALLBACK_MS);
+        card.classList.remove('is-entering');
+        card.classList.add('is-leaving');
+      }
+
+      function isActive(card) {
+        return !card.hidden && !card.classList.contains('is-leaving');
+      }
+
+      function createCard(data) {
+        var card = document.createElement('div');
+        card.className = 'card';
+
+        var badge = document.createElement('span');
+        badge.className = 'promo-badge';
+        badge.textContent = data.badge;
+
+        var img = document.createElement('img');
+        img.src = data.img;
+        img.alt = data.alt;
+        img.loading = 'lazy';
+
+        var h3 = document.createElement('h3');
+        h3.textContent = data.title;
+
+        var p = document.createElement('p');
+        p.textContent = data.text;
+
+        var link = document.createElement('a');
+        link.href = '/rewards';
+        link.className = 'btn';
+        link.textContent = 'Claim Offer';
+
+        card.append(badge, img, h3, p, link);
+        return card;
+      }
+
+      function showToggleCard() {
+        if (!toggleCard.hidden && !toggleCard.classList.contains('is-leaving')) return;
+        toggleCard.hidden = false;
+        animateIn(toggleCard);
+        updateState();
+      }
+
+      function hideToggleCard() {
+        if (!isActive(toggleCard)) return;
+        animateOut(toggleCard, function () {
+          toggleCard.hidden = true;
+          toggleCard.classList.remove('is-leaving');
+        });
+        updateState();
+      }
+
+      function updateState() {
+        var cards = container.querySelectorAll('.card');
+        var activeCount = 0;
+        cards.forEach(function (c) { if (isActive(c)) activeCount++; });
+
+        var featuredOn = isActive(toggleCard);
+        toggleBtn.setAttribute('aria-pressed', String(featuredOn));
+        toggleBtn.textContent = featuredOn ? 'Hide Featured Deal' : 'Show Featured Deal';
+
+        removeBtn.disabled = activeCount === 0;
+        emptyMsg.hidden = activeCount > 0 ||
+          Array.prototype.some.call(cards, function (c) { return c.classList.contains('is-leaving'); });
+      }
+
+      addBtn.addEventListener('click', function () {
+        var card = createCard(promos[promoIndex % promos.length]);
+        promoIndex++;
+        container.appendChild(card);
+        animateIn(card);
+        updateState();
+      });
+
+      removeBtn.addEventListener('click', function () {
+        var cards = container.querySelectorAll('.card');
+        for (var i = cards.length - 1; i >= 0; i--) {
+          var card = cards[i];
+          if (!isActive(card)) continue;
+          if (card === toggleCard) {
+            // Keep the default card in the DOM so the toggle can bring it back.
+            hideToggleCard();
+          } else {
+            animateOut(card, function () { card.remove(); });
+            updateState();
+          }
+          return;
+        }
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        if (isActive(toggleCard)) hideToggleCard();
+        else showToggleCard();
+      });
+
+      // Initial entry animation for the default promo card.
+      animateIn(toggleCard);
+      updateState();
+    })();
+  </script>
+
