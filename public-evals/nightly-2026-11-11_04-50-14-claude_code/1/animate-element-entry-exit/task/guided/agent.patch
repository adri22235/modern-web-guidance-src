+  <script>
+    const promos = [
+      { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink.', img: 'photo-1495474472287-4d71bcdd2085', alt: 'Coffee cup on a wooden table' },
+      { title: 'Cold Brew Club', text: '20% off cold brew growlers all month long.', img: 'photo-1461023058943-07fcbe16d735', alt: 'Iced coffee in a glass' },
+      { title: 'Bean Bundle Deal', text: 'Buy two bags of beans, get the third half off.', img: 'photo-1442512595331-e89e73853f31', alt: 'Roasted coffee beans' },
+      { title: 'Double Rewards Points', text: 'Earn 2x points on every order this week.', img: 'photo-1511920170033-f8396924c348', alt: 'Espresso shot being poured' },
+      { title: 'Study Session Special', text: 'Free refills on drip coffee after 6 PM.', img: 'photo-1501339847302-ac426a4a7cbb', alt: 'Cozy cafe interior' },
+    ];
+
+    const container = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    let promoIndex = 0;
+
+    // Detect real support for transitioning display (Firefox parses allow-discrete but doesn't apply it to display)
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function waitForAnimations(el) {
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000)),
+        ]);
+      }
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+      await waitForAnimations(el);
+      // Skipped if showElement() cancelled the close mid-animation
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      el.dataset.removing = '';
+      await hideElement(el);
+      el.remove();
+    }
+
+    function createPromoCard({ title, text, img, alt }) {
+      const card = document.createElement('article');
+      card.className = 'card';
+
+      const image = document.createElement('img');
+      image.src = `https://images.unsplash.com/${img}?auto=format&fit=crop&w=600&q=80`;
+      image.alt = alt;
+      image.width = 600;
+      image.height = 338;
+      image.loading = 'lazy';
+
+      const badge = document.createElement('span');
+      badge.className = 'promo-badge';
+      badge.textContent = 'New';
+
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+
+      const body = document.createElement('p');
+      body.textContent = text;
+
+      card.append(image, badge, heading, body);
+      return card;
+    }
+
+    function getToggleCard() {
+      return document.getElementById('toggleCard');
+    }
+
+    function syncToggleButton() {
+      const card = getToggleCard();
+      const visible = !!card && !card.hidden && !card.hasAttribute('data-closing') && !card.hasAttribute('data-removing');
+      toggleBtn.textContent = visible ? 'Hide Featured Promo' : 'Show Featured Promo';
+      toggleBtn.setAttribute('aria-expanded', String(visible));
+    }
+
+    addBtn.addEventListener('click', () => {
+      const promo = promos[promoIndex % promos.length];
+      promoIndex++;
+      container.append(createPromoCard(promo));
+    });
+
+    removeBtn.addEventListener('click', () => {
+      // Last card that is visible and not already leaving
+      const cards = container.querySelectorAll('.card:not([hidden]):not([data-closing]):not([data-removing])');
+      const last = cards[cards.length - 1];
+      if (!last) return;
+      removeElement(last).then(syncToggleButton);
+      syncToggleButton();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      let card = getToggleCard();
+      if (!card || card.hasAttribute('data-removing')) {
+        // Featured card was removed entirely; recreate it at the front
+        card?.removeAttribute('id');
+        card = createPromoCard({
+          title: 'Happy Hour: 2-for-1 Lattes',
+          text: 'Every weekday from 2\u20134 PM. Bring a friend!',
+          img: 'photo-1509042239860-f550ce710b93',
+          alt: 'Latte art in a ceramic cup',
+        });
+        card.id = 'toggleCard';
+        card.querySelector('.promo-badge').textContent = 'Featured';
+        container.prepend(card);
+      } else if (card.hidden || card.hasAttribute('data-closing')) {
+        showElement(card);
+      } else {
+        hideElement(card).then(syncToggleButton);
+      }
+      syncToggleButton();
+    });
+  </script>
+
