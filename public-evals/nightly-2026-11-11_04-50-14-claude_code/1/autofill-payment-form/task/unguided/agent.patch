+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const number = document.getElementById('card-number');
+      const name = document.getElementById('card-name');
+      const expiry = document.getElementById('card-expiry');
+      const cvc = document.getElementById('card-cvc');
+
+      const digits = (v) => v.replace(/\D/g, '');
+
+      // Auto-format card number in groups of 4
+      number.addEventListener('input', () => {
+        number.value = digits(number.value).slice(0, 19).replace(/(\d{4})(?=\d)/g, '$1 ');
+      });
+
+      // Auto-format expiry as MM/YY
+      expiry.addEventListener('input', (e) => {
+        let v = digits(expiry.value).slice(0, 4);
+        if (v.length >= 3) v = v.slice(0, 2) + '/' + v.slice(2);
+        else if (v.length === 2 && e.inputType !== 'deleteContentBackward') v += '/';
+        expiry.value = v;
+      });
+
+      cvc.addEventListener('input', () => {
+        cvc.value = digits(cvc.value).slice(0, 4);
+      });
+
+      function luhn(num) {
+        let sum = 0, dbl = false;
+        for (let i = num.length - 1; i >= 0; i--) {
+          let d = +num[i];
+          if (dbl) { d *= 2; if (d > 9) d -= 9; }
+          sum += d;
+          dbl = !dbl;
+        }
+        return sum % 10 === 0;
+      }
+
+      const validators = {
+        'card-number': () => {
+          const n = digits(number.value);
+          if (!n) return 'Card number is required.';
+          if (n.length < 12 || n.length > 19 || !luhn(n)) return 'Please enter a valid card number.';
+          return '';
+        },
+        'card-name': () => {
+          const v = name.value.trim();
+          if (!v) return 'Name on card is required.';
+          if (!/^[\p{L} .'-]+$/u.test(v)) return 'Please enter a valid name.';
+          return '';
+        },
+        'card-expiry': () => {
+          const m = expiry.value.match(/^(\d{2})\/(\d{2})$/);
+          if (!m) return 'Use MM/YY format.';
+          const month = +m[1], year = 2000 + +m[2];
+          if (month < 1 || month > 12) return 'Invalid month.';
+          const now = new Date();
+          const endOfMonth = new Date(year, month, 1); // first day after expiry month
+          if (endOfMonth <= now) return 'This card has expired.';
+          return '';
+        },
+        'card-cvc': () => {
+          const v = digits(cvc.value);
+          const isAmex = /^3[47]/.test(digits(number.value));
+          const len = isAmex ? 4 : 3;
+          if (v.length !== len) return `Security code must be ${len} digits.`;
+          return '';
+        }
+      };
+
+      function validate(id) {
+        const input = document.getElementById(id);
+        const msg = validators[id]();
+        document.getElementById(id + '-error').textContent = msg;
+        input.classList.toggle('invalid', !!msg);
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+        return !msg;
+      }
+
+      Object.keys(validators).forEach((id) => {
+        document.getElementById(id).addEventListener('blur', () => validate(id));
+      });
+
+      form.addEventListener('submit', (e) => {
+        const results = Object.keys(validators).map(validate);
+        if (results.includes(false)) {
+          e.preventDefault();
+          form.querySelector('.invalid').focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
