+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const card = document.getElementById('export_element');
+      const form = document.getElementById('gift_form');
+      const nameInput = document.getElementById('gc_name');
+      const messageInput = document.getElementById('gc_message');
+      const counter = document.getElementById('gc_message_count');
+      const customColor = document.getElementById('gc_custom_color');
+      const outName = document.getElementById('gc_out_name');
+      const outMessage = document.getElementById('gc_out_message');
+      const exportBtn = document.getElementById('gc_export');
+      const status = document.getElementById('gc_status');
+
+      // HTML-in-Canvas: draw the real #export_element DOM into the canvas when supported;
+      // otherwise reproduce the same card design with the 2D canvas API.
+      const supportsHtmlInCanvas =
+        'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function';
+
+      const state = { name: '', message: '', bg: '#4e342e', fg: '#ffffff' };
+
+      // Pick dark or light text for readable contrast on the chosen background.
+      function textColorFor(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const lin = (c) => { c /= 255; return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4; };
+        const L = 0.2126 * lin(n >> 16 & 255) + 0.7152 * lin(n >> 8 & 255) + 0.0722 * lin(n & 255);
+        return L > 0.179 ? '#3e2723' : '#ffffff';
+      }
+
+      function readForm() {
+        const checked = form.querySelector('input[name="bg"]:checked');
+        state.name = nameInput.value.trim() || 'You';
+        state.message = messageInput.value.trim();
+        state.bg = checked ? checked.value : customColor.value;
+        state.fg = textColorFor(state.bg);
+      }
+
+      function update() {
+        readForm();
+        outName.textContent = state.name;
+        outMessage.textContent = state.message;
+        card.style.setProperty('--card-bg', state.bg);
+        card.style.setProperty('--card-fg', state.fg);
+        counter.textContent = `${messageInput.value.length}/${messageInput.maxLength}`;
+        render();
+      }
+
+      function render() {
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint?.();
+        } else {
+          drawFallback();
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+        };
+      }
+
+      // ---- 2D fallback that mirrors the HTML card's styling ----
+      function roundRectPath(x, y, w, h, r) {
+        ctx.beginPath();
+        if (ctx.roundRect) ctx.roundRect(x, y, w, h, r);
+        else ctx.rect(x, y, w, h);
+      }
+
+      function wrapLines(text, maxWidth, maxLines) {
+        const words = text.split(/\s+/).filter(Boolean);
+        const lines = [];
+        let line = '';
+        for (const word of words) {
+          const test = line ? `${line} ${word}` : word;
+          if (ctx.measureText(test).width <= maxWidth || !line) {
+            line = test;
+          } else {
+            lines.push(line);
+            line = word;
+          }
+        }
+        if (line) lines.push(line);
+        if (lines.length > maxLines) {
+          lines.length = maxLines;
+          lines[maxLines - 1] = lines[maxLines - 1].replace(/\s*\S*$/, '') + '…';
+        }
+        return lines;
+      }
+
+      function drawFallback() {
+        const W = canvas.width, H = canvas.height, u = W / 100;
+        const padX = 7 * u, padY = 6 * u; // CSS % padding is relative to width
+        ctx.save();
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, W, H);
+
+        roundRectPath(0, 0, W, H, 3 * u);
+        ctx.clip();
+        ctx.fillStyle = state.bg;
+        ctx.fillRect(0, 0, W, H);
+
+        // Decorative circles (match the CSS radial gradients)
+        ctx.fillStyle = 'rgba(255,255,255,0.22)';
+        ctx.beginPath();
+        ctx.arc(W * 0.88, H * 0.18, Math.hypot(W, H) * 0.14 / Math.SQRT2, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = 'rgba(0,0,0,0.18)';
+        ctx.beginPath();
+        ctx.arc(W * 0.96, H, Math.hypot(W, H) * 0.30 / Math.SQRT2, 0, Math.PI * 2);
+        ctx.fill();
+
+        const sans = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
+        const serif = "Georgia, 'Times New Roman', serif";
+        ctx.fillStyle = state.fg;
+        ctx.textBaseline = 'top';
+
+        // Brand
+        ctx.globalAlpha = 0.85;
+        ctx.font = `700 ${2.6 * u}px ${sans}`;
+        if ('letterSpacing' in ctx) ctx.letterSpacing = `${0.52 * u}px`;
+        ctx.fillText('THE DAILY GRIND · GIFT CARD', padX, padY);
+        if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
+        ctx.globalAlpha = 1;
+
+        // Recipient + message, vertically centered block
+        const maxW = W - padX * 2;
+        ctx.font = `700 ${6 * u}px ${serif}`;
+        const nameLines = wrapLines(`For ${state.name}`, maxW, 2);
+        const nameLH = 6 * u * 1.15;
+        ctx.font = `italic ${3.4 * u}px ${serif}`;
+        const msgLines = state.message ? wrapLines(state.message, maxW, 3) : [];
+        const msgLH = 3.4 * u * 1.35;
+        const blockH = nameLines.length * nameLH + (msgLines.length ? 1.4 * u + msgLines.length * msgLH : 0);
+        let y = (H - blockH) / 2;
+
+        ctx.font = `700 ${6 * u}px ${serif}`;
+        for (const l of nameLines) { ctx.fillText(l, padX, y); y += nameLH; }
+        y += 1.4 * u;
+        ctx.font = `italic ${3.4 * u}px ${serif}`;
+        ctx.globalAlpha = 0.95;
+        for (const l of msgLines) { ctx.fillText(l, padX, y); y += msgLH; }
+        ctx.globalAlpha = 1;
+
+        // Footer
+        ctx.textBaseline = 'alphabetic';
+        ctx.font = `${2.4 * u}px ${sans}`;
+        if ('letterSpacing' in ctx) ctx.letterSpacing = `${0.24 * u}px`;
+        ctx.fillText('REDEEMABLE AT ANY LOCATION', padX, H - padY);
+        if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
+        ctx.font = `${7 * u}px ${sans}`;
+        ctx.textAlign = 'right';
+        ctx.fillText('☕', W - padX, H - padY + u);
+        ctx.textAlign = 'left';
+
+        ctx.restore();
+      }
+
+      // Keep the canvas backing store matched to device pixels for a crisp preview/export.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        const w = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        const h = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        // Never export smaller than 1040px wide.
+        const scale = Math.max(1, 1040 / w);
+        canvas.width = Math.round(w * scale);
+        canvas.height = Math.round(h * scale);
+        render();
+      });
+      const supportsDPCB = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDPCB ? { box: 'device-pixel-content-box' } : {});
+
+      // Choosing a custom color deselects the preset swatches.
+      const useCustomColor = () => {
+        form.querySelectorAll('input[name="bg"]').forEach((r) => { r.checked = false; });
+        update();
+      };
+      customColor.addEventListener('input', useCustomColor);
+      customColor.addEventListener('click', useCustomColor);
+      form.addEventListener('input', (e) => { if (e.target !== customColor) update(); });
+      form.addEventListener('submit', (e) => e.preventDefault());
+
+      exportBtn.addEventListener('click', () => {
+        render();
+        // Wait a frame so any pending paint lands before capturing.
+        requestAnimationFrame(() => {
+          canvas.toBlob((blob) => {
+            if (!blob) { status.textContent = 'Sorry, the card could not be exported.'; return; }
+            const url = URL.createObjectURL(blob);
+            const a = document.createElement('a');
+            const slug = state.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'card';
+            a.href = url;
+            a.download = `daily-grind-gift-card-${slug}.png`;
+            document.body.append(a);
+            a.click();
+            a.remove();
+            setTimeout(() => URL.revokeObjectURL(url), 1000);
+            status.textContent = 'Gift card downloaded!';
+          }, 'image/png');
+        });
+      });
+
+      document.fonts?.ready.then(render);
+      update();
+    })();
+  </script>
+
 </body>
 
