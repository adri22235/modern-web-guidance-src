+  <script>
+    (function () {
+      const OUTPUT_WIDTH = 1050; // exported image width in px
+
+      const card = document.getElementById('export_element');
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const form = document.getElementById('designer_form');
+      const nameInput = document.getElementById('gc_name_input');
+      const messageInput = document.getElementById('gc_message_input');
+      const amountInput = document.getElementById('gc_amount_input');
+      const colorInput = document.getElementById('gc_color_input');
+      const swatches = document.querySelectorAll('#gc_swatches .swatch');
+      const countEl = document.getElementById('gc_message_count');
+      const exportBtn = document.getElementById('gc_export_btn');
+      const statusEl = document.getElementById('gc_export_status');
+
+      /* ---------- HTML card state ---------- */
+
+      function isLightColor(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map(v => {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.4;
+      }
+
+      function setColor(hex) {
+        card.style.setProperty('--card-bg', hex);
+        card.classList.toggle('on-light', isLightColor(hex));
+        colorInput.value = hex;
+        swatches.forEach(s => s.setAttribute('aria-pressed', String(s.dataset.color === hex)));
+        scheduleRender();
+      }
+
+      function syncText() {
+        const name = nameInput.value.trim();
+        document.getElementById('gc_recipient').textContent = name ? 'For ' + name : 'For You';
+        document.getElementById('gc_message').textContent = messageInput.value.trim() || 'Enjoy a cup on us!';
+        document.getElementById('gc_amount').textContent = amountInput.value;
+        countEl.textContent = messageInput.value.length + ' / ' + messageInput.maxLength;
+        scheduleRender();
+      }
+
+      /* ---------- Canvas rendering of the HTML card ---------- */
+
+      function roundRectPath(c, x, y, w, h, r) {
+        r = Math.min(r, w / 2, h / 2);
+        c.beginPath();
+        c.moveTo(x + r, y);
+        c.arcTo(x + w, y, x + w, y + h, r);
+        c.arcTo(x + w, y + h, x, y + h, r);
+        c.arcTo(x, y + h, x, y, r);
+        c.arcTo(x, y, x + w, y, r);
+        c.closePath();
+      }
+
+      function applyTransform(text, transform) {
+        if (transform === 'uppercase') return text.toUpperCase();
+        if (transform === 'lowercase') return text.toLowerCase();
+        if (transform === 'capitalize') return text.replace(/\b\w/g, ch => ch.toUpperCase());
+        return text;
+      }
+
+      // Word-wrap text to maxWidth; breaks overly long words by character.
+      function wrapLines(c, text, maxWidth) {
+        const lines = [];
+        let line = '';
+        text.split(/\s+/).filter(Boolean).forEach(word => {
+          const test = line ? line + ' ' + word : word;
+          if (c.measureText(test).width <= maxWidth) {
+            line = test;
+            return;
+          }
+          if (line) lines.push(line);
+          line = '';
+          for (const ch of word) {
+            if (c.measureText(line + ch).width > maxWidth && line) {
+              lines.push(line);
+              line = ch;
+            } else {
+              line += ch;
+            }
+          }
+        });
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      function drawText(el, box, scale) {
+        const cs = getComputedStyle(el);
+        const fontSize = parseFloat(cs.fontSize) * scale;
+        const lh = cs.lineHeight === 'normal' ? fontSize * 1.2 : parseFloat(cs.lineHeight) * scale;
+        const spacing = cs.letterSpacing === 'normal' ? 0 : parseFloat(cs.letterSpacing) * scale;
+
+        ctx.save();
+        ctx.globalAlpha = parseFloat(cs.opacity);
+        ctx.fillStyle = cs.color;
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${fontSize}px ${cs.fontFamily}`;
+        ctx.textBaseline = 'middle';
+        if ('letterSpacing' in ctx) ctx.letterSpacing = spacing + 'px';
+
+        // Small tolerance so canvas measurement differences don't cause extra wraps.
+        const maxWidth = box.width + spacing + 1 * scale;
+        const lines = wrapLines(ctx, applyTransform(el.textContent.trim(), cs.textTransform), maxWidth);
+        lines.forEach((line, i) => {
+          ctx.fillText(line, box.x, box.y + lh * i + lh / 2);
+        });
+        ctx.restore();
+      }
+
+      function drawCircle(el, box, scale, kind) {
+        const cs = getComputedStyle(el);
+        const r = box.width / 2;
+        ctx.save();
+        ctx.globalAlpha = parseFloat(cs.opacity);
+        ctx.beginPath();
+        ctx.arc(box.x + r, box.y + r, r, 0, Math.PI * 2);
+        if (kind === 'ring') {
+          ctx.lineWidth = parseFloat(cs.borderTopWidth) * scale;
+          ctx.strokeStyle = cs.borderTopColor;
+          // Border is drawn inside the box in CSS, so inset the stroke.
+          ctx.beginPath();
+          ctx.arc(box.x + r, box.y + r, r - ctx.lineWidth / 2, 0, Math.PI * 2);
+          ctx.stroke();
+        } else {
+          ctx.fillStyle = cs.backgroundColor;
+          ctx.fill();
+        }
+        ctx.restore();
+      }
+
+      function renderCanvas() {
+        const rect = card.getBoundingClientRect();
+        if (!rect.width) return;
+        const scale = OUTPUT_WIDTH / rect.width;
+        const height = Math.round(rect.height * scale);
+        if (canvas.width !== OUTPUT_WIDTH) canvas.width = OUTPUT_WIDTH;
+        if (canvas.height !== height) canvas.height = height;
+
+        const cs = getComputedStyle(card);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.save();
+        roundRectPath(ctx, 0, 0, canvas.width, canvas.height, parseFloat(cs.borderTopLeftRadius) * scale);
+        ctx.clip();
+        ctx.fillStyle = cs.backgroundColor;
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        // Draw each marked card element in DOM order using its live layout + styles.
+        card.querySelectorAll('[data-canvas]').forEach(el => {
+          const r = el.getBoundingClientRect();
+          const box = {
+            x: (r.left - rect.left) * scale,
+            y: (r.top - rect.top) * scale,
+            width: r.width * scale,
+            height: r.height * scale
+          };
+          const kind = el.dataset.canvas;
+          if (kind === 'text') drawText(el, box, scale);
+          else drawCircle(el, box, scale, kind);
+        });
+        ctx.restore();
+      }
+
+      let frame = 0;
+      function scheduleRender() {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(renderCanvas);
+      }
+
+      /* ---------- Export ---------- */
+
+      function fileName() {
+        const slug = nameInput.value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+        return 'daily-grind-gift-card' + (slug ? '-' + slug : '') + '.png';
+      }
+
+      function download(url, name) {
+        const a = document.createElement('a');
+        a.href = url;
+        a.download = name;
+        document.body.appendChild(a);
+        a.click();
+        a.remove();
+      }
+
+      form.addEventListener('submit', e => {
+        e.preventDefault();
+        exportBtn.disabled = true;
+        statusEl.textContent = 'Preparing your image…';
+        renderCanvas(); // make sure the canvas reflects the latest edits
+        const name = fileName();
+        const done = () => {
+          exportBtn.disabled = false;
+          statusEl.textContent = 'Downloaded ' + name;
+        };
+        if (canvas.toBlob) {
+          canvas.toBlob(blob => {
+            if (!blob) {
+              exportBtn.disabled = false;
+              statusEl.textContent = 'Sorry, the image could not be created.';
+              return;
+            }
+            const url = URL.createObjectURL(blob);
+            download(url, name);
+            setTimeout(() => URL.revokeObjectURL(url), 1000);
+            done();
+          }, 'image/png');
+        } else {
+          download(canvas.toDataURL('image/png'), name);
+          done();
+        }
+      });
+
+      /* ---------- Wiring ---------- */
+
+      [nameInput, messageInput].forEach(el => el.addEventListener('input', syncText));
+      amountInput.addEventListener('change', syncText);
+      colorInput.addEventListener('input', () => setColor(colorInput.value));
+      swatches.forEach(s => s.addEventListener('click', () => setColor(s.dataset.color)));
+
+      if ('ResizeObserver' in window) new ResizeObserver(scheduleRender).observe(card);
+      else window.addEventListener('resize', scheduleRender);
+
+      syncText();
+      setColor(swatches[0].dataset.color);
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleRender);
+    })();
+  </script>
+
