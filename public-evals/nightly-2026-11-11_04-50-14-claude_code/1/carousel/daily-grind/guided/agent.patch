+  <script type="module">
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const canLoop = CSS.supports('order', 'sibling-count()');
+    const hasScrollEnd = 'onscrollend' in window;
+
+    for (const carousel of document.querySelectorAll('.carousel')) {
+      const track = carousel.querySelector('.carousel-track');
+      const slides = [...track.children];
+      const status = carousel.querySelector('[role="status"]');
+      const prevBtn = carousel.querySelector('[data-direction="previous"]');
+      const nextBtn = carousel.querySelector('[data-direction="next"]');
+      const markerGroup = carousel.querySelector('.carousel-markers');
+      const loop = canLoop && slides.length >= 3;
+
+      let pending = null;      // slide a click is currently scrolling to
+      let settledIndex = -1;   // original index of the last settled slide
+      let currentParam = null; // value of --current
+      let frame = 0;
+
+      const markers = slides.map((slide) => {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.setAttribute('aria-label', slide.dataset.markerName);
+        button.addEventListener('click', () => goTo(slide));
+        markerGroup.append(button);
+        return button;
+      });
+
+      const center = (el) => {
+        const r = el.getBoundingClientRect();
+        return r.left + r.width / 2;
+      };
+      const offsetFromCenter = (slide) => center(slide) - center(track);
+      const visualOrder = () =>
+        [...slides].sort((a, b) => a.getBoundingClientRect().left - b.getBoundingClientRect().left);
+      const nearest = () =>
+        slides.reduce((best, s) =>
+          Math.abs(offsetFromCenter(s)) < Math.abs(offsetFromCenter(best)) ? s : best);
+
+      function setMarker(slide) {
+        const index = slides.indexOf(slide);
+        markers.forEach((m, i) => {
+          if (i === index) m.setAttribute('aria-current', 'true');
+          else m.removeAttribute('aria-current');
+        });
+      }
+
+      function goTo(slide) {
+        pending = slide;
+        setMarker(slide);
+        track.scrollBy({
+          left: offsetFromCenter(slide),
+          behavior: reducedMotion.matches ? 'instant' : 'smooth',
+        });
+      }
+
+      function step(direction) {
+        const order = visualOrder();
+        const target = order[order.indexOf(pending ?? nearest()) + direction];
+        if (target) goTo(target);
+      }
+
+      prevBtn.addEventListener('click', () => step(-1));
+      nextBtn.addEventListener('click', () => step(1));
+
+      // A user gesture overrides any scripted target.
+      for (const type of ['pointerdown', 'wheel', 'keydown']) {
+        track.addEventListener(type, () => { pending = null; }, { passive: true });
+      }
+
+      // Re-park the end slides around the current one without a visible jump.
+      function park(index) {
+        if (currentParam === index) return;
+        currentParam = index;
+        const current = slides[index];
+        const before = current.getBoundingClientRect().left;
+        track.style.scrollSnapType = 'none';
+        track.style.overflowX = 'hidden';
+        track.style.setProperty('--current', index);
+        const after = current.getBoundingClientRect().left;
+        track.scrollBy({ left: after - before, behavior: 'instant' });
+        requestAnimationFrame(() => requestAnimationFrame(() => {
+          track.style.scrollSnapType = '';
+          track.style.overflowX = '';
+        }));
+        for (const slide of slides) {
+          slide.inert = getComputedStyle(slide).order !== '0';
+        }
+      }
+
+      function settle({ announce = true } = {}) {
+        // A scrollend from an earlier scroll while a click target is still in flight.
+        if (pending && Math.abs(offsetFromCenter(pending)) > 2) return;
+        pending = null;
+
+        const current = nearest();
+        const index = slides.indexOf(current);
+        if (loop) park(index);
+
+        if (!loop) {
+          const order = visualOrder();
+          prevBtn.disabled = order.indexOf(current) === 0;
+          nextBtn.disabled = order.indexOf(current) === order.length - 1;
+        }
+
+        setMarker(current);
+        if (announce && index !== settledIndex) {
+          const name = current.querySelector('h3')?.textContent ?? '';
+          status.textContent = `Slide ${index + 1} of ${slides.length}: ${name}`;
+        }
+        settledIndex = index;
+      }
+
+      // Live marker updates while scrolling, one per frame.
+      track.addEventListener('scroll', () => {
+        if (pending || frame) return;
+        frame = requestAnimationFrame(() => {
+          frame = 0;
+          setMarker(nearest());
+        });
+      }, { passive: true });
+
+      if (hasScrollEnd) {
+        track.addEventListener('scrollend', () => settle());
+      } else {
+        let timer;
+        track.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => settle(), 150);
+        }, { passive: true });
+      }
+
+      settle({ announce: false });
+    }
+  </script>
+
