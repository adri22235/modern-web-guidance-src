+
+    .carousel-track:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-slide {
+      flex: 0 0 100%;
+      scroll-snap-align: center;
+      /* side padding keeps text clear of the overlaid arrow buttons */
+      padding: 40px 72px;
+    }
+
+    /* Looping: park an end slide beside the current one with CSS order.
+       --current is set by script; while undefined, no slide is parked. */
+    @supports (order: sibling-count()) {
+      .carousel-track > :first-child {
+        order: clamp(0, var(--current) - (sibling-count() - 2), 1);
+      }
+
+      .carousel-track > :last-child {
+        order: calc(-1 * clamp(0, 1 - var(--current), 1));
+      }
+    }
