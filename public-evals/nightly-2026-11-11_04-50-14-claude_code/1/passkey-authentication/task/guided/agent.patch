+  <script type="module">
+    // Polyfills parseRequestOptionsFromJSON / toJSON / getClientCapabilities where missing.
+    try {
+      await import('webauthn-polyfills');
+    } catch (err) {
+      console.warn('WebAuthn polyfills failed to load:', err);
+    }
+
+    const usernameField = document.querySelector('[data-testid="username-field"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    const form = document.getElementById('signin-form');
+
+    let autofillAbortController = new AbortController();
+    let authenticated = false;
+
+    function setStatus(message, state = '') {
+      authStatus.textContent = message;
+      if (state) authStatus.dataset.state = state;
+      else authStatus.removeAttribute('data-state');
+    }
+
+    async function fetchLoginOptions() {
+      const res = await fetch('/api/login/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        credentials: 'same-origin',
+        body: '{}',
+      });
+      if (!res.ok) throw new Error(`Failed to fetch login options (${res.status})`);
+      const json = await res.json();
+      // Accept either the bare options object or one wrapped as { publicKey: {...} }.
+      return PublicKeyCredential.parseRequestOptionsFromJSON(json.publicKey ?? json);
+    }
+
+    async function verifyCredential(credential, publicKey) {
+      const encoded = credential.toJSON();
+      let res;
+      try {
+        res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(encoded),
+        });
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.', 'error');
+        return;
+      }
+
+      if (res.ok) {
+        let data = {};
+        try { data = await res.json(); } catch { /* empty body is fine */ }
+        const name = data.username ?? data.user?.username ?? data.user?.name ?? data.name;
+        authenticated = true;
+        autofillAbortController.abort();
+        setStatus(name ? `Signed in as ${name}` : 'Signed in successfully', 'success');
+        return;
+      }
+
+      if (res.status === 404) {
+        // Credential unknown to the server: let the passkey provider hide it (pre-auth path).
+        if (PublicKeyCredential.signalUnknownCredential && publicKey.rpId) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          } catch (err) {
+            console.warn('signalUnknownCredential failed:', err);
+          }
+        }
+        setStatus('This passkey is no longer registered. Please choose another.', 'error');
+        return;
+      }
+
+      setStatus('Sign-in failed. Please try again.', 'error');
+    }
+
+    async function initializeConditionalAutofill() {
+      if (authenticated || !window.PublicKeyCredential?.getClientCapabilities) return;
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch {
+        return;
+      }
+      if (capabilities.conditionalGet !== true) return;
+
+      try {
+        const publicKey = await fetchLoginOptions();
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+        if (credential) await verifyCredential(credential, publicKey);
+      } catch (err) {
+        if (err.name === 'NotAllowedError' || err.name === 'AbortError') return;
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', 'error');
+        return;
+      }
+
+      // Abort any pending conditional request so the explicit prompt can open.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      authButton.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchLoginOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        authButton.disabled = false;
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.');
+        } else if (err.name === 'AbortError') {
+          setStatus('');
+        } else {
+          console.error('Passkey sign-in error:', err);
+          setStatus('Something went wrong. Please try again.', 'error');
+        }
+        initializeConditionalAutofill(); // Re-arm autofill suggestions.
+        return;
+      }
+
+      await verifyCredential(credential, publicKey);
+      authButton.disabled = false;
+      if (!authenticated) initializeConditionalAutofill();
+    }
+
+    authButton.addEventListener('click', triggerButtonAuthentication);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      triggerButtonAuthentication();
+    });
+
+    initializeConditionalAutofill();
+  </script>
+
