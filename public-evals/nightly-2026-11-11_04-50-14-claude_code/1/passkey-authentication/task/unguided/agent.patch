+  <script>
+    (() => {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      const form = document.getElementById('signin-form');
+
+      let conditionalAbort = null;
+      let conditionalStarted = false;
+
+      const setStatus = (msg, type = '') => {
+        statusEl.textContent = msg;
+        statusEl.className = 'auth-status' + (type ? ' ' + type : '');
+      };
+
+      // ---- base64url helpers ----
+      const b64urlToBuffer = (value) => {
+        const b64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
+        const bin = atob(padded);
+        const bytes = new Uint8Array(bin.length);
+        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      };
+
+      const bufferToB64url = (buf) => {
+        const bytes = new Uint8Array(buf);
+        let bin = '';
+        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      // Server may return options directly or wrapped as { publicKey: {...} }.
+      const parseRequestOptions = (json) => {
+        const opts = json && json.publicKey ? json.publicKey : json;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(opts);
+        }
+        const parsed = { ...opts, challenge: b64urlToBuffer(opts.challenge) };
+        if (Array.isArray(opts.allowCredentials)) {
+          parsed.allowCredentials = opts.allowCredentials.map((c) => ({ ...c, id: b64urlToBuffer(c.id) }));
+        }
+        return parsed;
+      };
+
+      const credentialToJSON = (cred) => {
+        if (typeof cred.toJSON === 'function') {
+          try { return cred.toJSON(); } catch (_) { /* fall through */ }
+        }
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || undefined,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null,
+          },
+        };
+      };
+
+      const fetchOptions = async () => {
+        const res = await fetch('/api/login/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify({ username: usernameField.value.trim() || undefined }),
+        });
+        if (!res.ok) throw new Error('Could not load sign-in options (' + res.status + ')');
+        return res.json();
+      };
+
+      const verify = async (credential) => {
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(credentialToJSON(credential)),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty body */ }
+        if (!res.ok || data.verified === false || data.success === false) {
+          throw new Error(data.error || data.message || 'Passkey verification failed');
+        }
+        return data;
+      };
+
+      const onSuccess = (data) => {
+        const name = data.username || (data.user && (data.user.username || data.user.name)) || usernameField.value.trim();
+        setStatus(name ? 'Signed in as ' + name : 'Signed in successfully', 'success');
+        authButton.disabled = true;
+        usernameField.disabled = true;
+      };
+
+      const isAbort = (err) => err && (err.name === 'AbortError' || err === 'superseded');
+
+      // ---- Conditional UI (autofill) ----
+      const startConditional = async () => {
+        if (conditionalStarted || authButton.disabled) return;
+        if (!window.PublicKeyCredential ||
+            typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+        conditionalStarted = true;
+        let available = false;
+        try { available = await PublicKeyCredential.isConditionalMediationAvailable(); } catch (_) {}
+        if (!available || authButton.disabled) { conditionalStarted = false; return; }
+        conditionalAbort = new AbortController();
+        const signal = conditionalAbort.signal;
+        try {
+          const publicKey = parseRequestOptions(await fetchOptions());
+          // Autofill must not be restricted to a specific username's credentials.
+          delete publicKey.allowCredentials;
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey,
+            signal,
+          });
+          if (!credential) return;
+          setStatus('Verifying…');
+          onSuccess(await verify(credential));
+        } catch (err) {
+          if (!isAbort(err) && !signal.aborted) {
+            setStatus(err.message || 'Sign-in failed', 'error');
+          }
+        } finally {
+          if (conditionalAbort && conditionalAbort.signal === signal) {
+            conditionalAbort = null;
+            conditionalStarted = false;
+          }
+        }
+      };
+
+      const abortConditional = () => {
+        if (conditionalAbort) {
+          conditionalAbort.abort('superseded');
+          conditionalAbort = null;
+        }
+        conditionalStarted = false;
+      };
+
+      // ---- Modal (button) flow: prompts for biometrics directly ----
+      const signInWithButton = async () => {
+        if (!window.PublicKeyCredential || !navigator.credentials) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+        abortConditional();
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+        try {
+          const publicKey = parseRequestOptions(await fetchOptions());
+          publicKey.userVerification = publicKey.userVerification || 'required';
+          const credential = await navigator.credentials.get({ publicKey });
+          if (!credential) throw new Error('No passkey was selected');
+          setStatus('Verifying…');
+          onSuccess(await verify(credential));
+          return;
+        } catch (err) {
+          if (err && err.name === 'NotAllowedError') {
+            setStatus('Sign-in was cancelled or timed out.', 'error');
+          } else {
+            setStatus((err && err.message) || 'Sign-in failed', 'error');
+          }
+        }
+        authButton.disabled = false;
+        startConditional();
+      };
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        signInWithButton();
+      });
+
+      // Start autofill request immediately so suggestions appear on focus;
+      // also (re)arm it on focus in case it isn't running.
+      usernameField.addEventListener('focus', startConditional);
+      startConditional();
+    })();
+  </script>
+
 </body>
 
