+  <script>
+    (() => {
+      const ORIGINS = [
+        { name: 'Ethiopia', acidity: 8.5, body: 4.5, sweetness: 7, bitterness: 3, aroma: 9 },
+        { name: 'Colombia', acidity: 6.5, body: 6, sweetness: 7, bitterness: 4, aroma: 7 },
+        { name: 'Brazil', acidity: 4, body: 7, sweetness: 7.5, bitterness: 5, aroma: 6 },
+        { name: 'Sumatra', acidity: 3, body: 9, sweetness: 5, bitterness: 6.5, aroma: 6.5 },
+        { name: 'Kenya', acidity: 9, body: 5.5, sweetness: 6, bitterness: 3.5, aroma: 8.5 },
+        { name: 'Guatemala', acidity: 6, body: 6.5, sweetness: 6.5, bitterness: 5, aroma: 7.5 },
+        { name: 'Costa Rica', acidity: 7, body: 5.5, sweetness: 7, bitterness: 3.5, aroma: 7 },
+        { name: 'Vietnam', acidity: 2.5, body: 8.5, sweetness: 4, bitterness: 8, aroma: 5 }
+      ];
+      const ROASTS = ['Light', 'Medium', 'Medium-Dark', 'Dark'];
+      const METHODS = {
+        espresso: { label: 'Espresso', acidity: 1.0, body: 1.35, sweetness: 1.05, bitterness: 1.25, aroma: 1.1 },
+        pourover: { label: 'Pour-over', acidity: 1.2, body: 0.85, sweetness: 1.0, bitterness: 0.9, aroma: 1.15 },
+        frenchpress: { label: 'French press', acidity: 0.9, body: 1.25, sweetness: 1.0, bitterness: 1.05, aroma: 0.95 },
+        coldbrew: { label: 'Cold brew', acidity: 0.6, body: 1.1, sweetness: 1.2, bitterness: 0.7, aroma: 0.85 }
+      };
+      const METHOD_KEYS = Object.keys(METHODS);
+      const TRAITS = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+      const TARGETS = {
+        balanced: { acidity: 6, body: 6, sweetness: 6.5, bitterness: 4, aroma: 7 },
+        bright: { acidity: 8.5, body: 4.5, sweetness: 6.5, bitterness: 3, aroma: 8.5 },
+        bold: { acidity: 3.5, body: 8.5, sweetness: 5, bitterness: 6.5, aroma: 6.5 },
+        sweet: { acidity: 4.5, body: 6.5, sweetness: 8.5, bitterness: 3, aroma: 7 }
+      };
+      const TIME_BUDGET_MS = 50; // a task longer than 50ms counts as a long task
+
+      const $ = (id) => document.getElementById(id);
+      const form = $('sim-form');
+      const runBtn = $('sim-run');
+      const cancelBtn = $('sim-cancel');
+      const bar = $('sim-bar');
+      const status = $('sim-status');
+      const results = $('sim-results');
+      const profileEl = $('sim-profile');
+      const topEl = $('sim-top');
+
+      let controller = null;
+
+      // Yield control back to the browser so it can handle input and paint.
+      function yieldToMain() {
+        if (globalThis.scheduler?.yield) return scheduler.yield();
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      // Small fast seeded PRNG (mulberry32) so runs are reproducible per seed.
+      function mulberry32(seed) {
+        return () => {
+          seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
+          let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      function simulateBlend(rand, methodFilter, target) {
+        // Choose 2–3 origins with random ratios.
+        const n = 2 + Math.floor(rand() * 2);
+        const picks = [];
+        let total = 0;
+        for (let i = 0; i < n; i++) {
+          const w = 0.1 + rand();
+          picks.push({ origin: ORIGINS[Math.floor(rand() * ORIGINS.length)], w });
+          total += w;
+        }
+        const roast = Math.floor(rand() * ROASTS.length); // 0..3
+        const methodKey = methodFilter === 'any'
+          ? METHOD_KEYS[Math.floor(rand() * METHOD_KEYS.length)]
+          : methodFilter;
+        const method = METHODS[methodKey];
+        const extraction = 0.85 + rand() * 0.3; // brew strength variance
+
+        const profile = {};
+        for (const t of TRAITS) {
+          let v = 0;
+          for (const p of picks) v += p.origin[t] * (p.w / total);
+          // Roast development: darker roasts trade acidity/aroma for body/bitterness.
+          if (t === 'acidity') v *= 1 - roast * 0.15;
+          else if (t === 'aroma') v *= 1 - roast * 0.06;
+          else if (t === 'body') v *= 1 + roast * 0.08;
+          else if (t === 'bitterness') v *= 1 + roast * 0.22;
+          else if (t === 'sweetness') v *= 1 + (roast === 1 || roast === 2 ? 0.1 : -0.04);
+          v *= method[t] * extraction;
+          profile[t] = Math.min(10, Math.max(0, v));
+        }
+
+        // Score: closeness to the target profile (0–100).
+        let dist = 0;
+        for (const t of TRAITS) {
+          const d = profile[t] - target[t];
+          dist += d * d;
+        }
+        const score = 100 * Math.exp(-Math.sqrt(dist) / 6);
+
+        // Collapse duplicate origins in the label.
+        const shares = new Map();
+        for (const p of picks) shares.set(p.origin.name, (shares.get(p.origin.name) || 0) + p.w / total);
+        const label = [...shares].sort((a, b) => b[1] - a[1])
+          .map(([name, s]) => `${Math.round(s * 100)}% ${name}`).join(' / ');
+
+        return { profile, score, label, roast: ROASTS[roast], method: method.label };
+      }
+
+      function insertTop(top, blend, size = 5) {
+        if (top.length === size && blend.score <= top[size - 1].score) return;
+        top.push(blend);
+        top.sort((a, b) => b.score - a.score);
+        if (top.length > size) top.pop();
+      }
+
+      function render(sums, count, top) {
+        profileEl.replaceChildren(...TRAITS.map((t) => {
+          const avg = sums[t] / count;
+          const row = document.createElement('div');
+          row.className = 'flavor-bar';
+          row.innerHTML = `<span></span><div class="track"><div class="fill"></div></div><span class="val"></span>`;
+          row.children[0].textContent = t[0].toUpperCase() + t.slice(1);
+          row.querySelector('.fill').style.width = `${avg * 10}%`;
+          row.children[2].textContent = avg.toFixed(1);
+          return row;
+        }));
+        topEl.replaceChildren(...top.map((b, i) => {
+          const tr = document.createElement('tr');
+          for (const [text, cls] of [[i + 1], [b.label], [b.roast], [b.method], [b.score.toFixed(1), 'num']]) {
+            const td = document.createElement('td');
+            td.textContent = text;
+            if (cls) td.className = cls;
+            tr.append(td);
+          }
+          return tr;
+        }));
+        results.hidden = false;
+      }
+
+      async function runSimulation(count, methodFilter, targetKey, signal) {
+        const rand = mulberry32((Math.random() * 2 ** 32) >>> 0);
+        const target = TARGETS[targetKey];
+        const sums = Object.fromEntries(TRAITS.map((t) => [t, 0]));
+        const top = [];
+        const start = performance.now();
+        let deadline = performance.now() + TIME_BUDGET_MS;
+        let i = 0;
+
+        for (; i < count; i++) {
+          const blend = simulateBlend(rand, methodFilter, target);
+          for (const t of TRAITS) sums[t] += blend.profile[t];
+          insertTop(top, blend);
+
+          if (performance.now() >= deadline) {
+            // Update progress, then let the browser handle input & rendering.
+            bar.value = i / count;
+            status.textContent = `Simulating… ${i.toLocaleString()} / ${count.toLocaleString()} blends`;
+            await yieldToMain();
+            if (signal.aborted) break;
+            deadline = performance.now() + TIME_BUDGET_MS;
+          }
+        }
+
+        const elapsed = ((performance.now() - start) / 1000).toFixed(2);
+        if (i > 0) render(sums, i, top);
+        bar.value = i / count;
+        status.textContent = signal.aborted
+          ? `Cancelled after ${i.toLocaleString()} blends (${elapsed}s). Showing partial results.`
+          : `Done! Simulated ${count.toLocaleString()} blends in ${elapsed}s.`;
+      }
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        if (controller) return;
+        const count = Math.min(2_000_000, Math.max(1000, Math.floor(Number($('sim-count').value) || 0)));
+        controller = new AbortController();
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        bar.value = 0;
+        status.textContent = 'Starting simulation…';
+        try {
+          await runSimulation(count, $('sim-method').value, $('sim-target').value, controller.signal);
+        } finally {
+          controller = null;
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+        }
+      });
+
+      cancelBtn.addEventListener('click', () => controller?.abort());
+    })();
+  </script>
+
