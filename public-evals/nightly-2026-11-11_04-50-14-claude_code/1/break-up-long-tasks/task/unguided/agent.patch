+  <!-- Flavor Lab simulation worker source (executed off the main thread) -->
+  <script type="text/js-worker" id="flavor-worker-src">
+    'use strict';
+    var ORIGINS = [
+      { name: 'Ethiopia Yirgacheffe', acidity: 0.85, body: 0.40, sweetness: 0.70, bitterness: 0.25, aroma: 0.90 },
+      { name: 'Colombia Huila',       acidity: 0.65, body: 0.60, sweetness: 0.70, bitterness: 0.35, aroma: 0.65 },
+      { name: 'Brazil Cerrado',       acidity: 0.35, body: 0.75, sweetness: 0.65, bitterness: 0.45, aroma: 0.50 },
+      { name: 'Sumatra Mandheling',   acidity: 0.25, body: 0.90, sweetness: 0.45, bitterness: 0.60, aroma: 0.55 },
+      { name: 'Kenya AA',             acidity: 0.90, body: 0.55, sweetness: 0.60, bitterness: 0.30, aroma: 0.80 },
+      { name: 'Guatemala Antigua',    acidity: 0.60, body: 0.65, sweetness: 0.65, bitterness: 0.40, aroma: 0.70 },
+      { name: 'Costa Rica Tarrazu',   acidity: 0.75, body: 0.50, sweetness: 0.70, bitterness: 0.30, aroma: 0.70 },
+      { name: 'Vietnam Robusta',      acidity: 0.20, body: 0.85, sweetness: 0.30, bitterness: 0.85, aroma: 0.40 }
+    ];
+    var ROASTS = ['Light', 'Medium', 'Medium-Dark', 'Dark'];
+    var METHODS = {
+      espresso:    { time: [20, 35],   grind: [0.05, 0.25], temp: [90, 96], strength: 1.25 },
+      pourover:    { time: [150, 270], grind: [0.35, 0.60], temp: [90, 96], strength: 0.95 },
+      frenchpress: { time: [210, 300], grind: [0.70, 0.95], temp: [92, 96], strength: 1.05 },
+      coldbrew:    { time: [43200, 86400], grind: [0.75, 1.0], temp: [4, 22], strength: 1.10 }
+    };
+    var IDEAL = { acidity: 0.55, body: 0.60, sweetness: 0.70, bitterness: 0.35, aroma: 0.70 };
+    var TOP_N = 8;
+    var cancelled = false;
+
+    // Mulberry32: tiny, fast, seedable PRNG so runs are reproducible.
+    function makeRng(seed) {
+      var a = seed >>> 0;
+      return function () {
+        a = (a + 0x6D2B79F5) | 0;
+        var t = Math.imul(a ^ (a >>> 15), 1 | a);
+        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+      };
+    }
+    function clamp(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
+    function lerp(r, range) { return range[0] + r() * (range[1] - range[0]); }
+
+    function simulateBlend(rng, method, samples) {
+      // Pick 2-3 origins with random ratios.
+      var n = 2 + (rng() < 0.4 ? 1 : 0);
+      var picks = [], weights = [], total = 0, i, k;
+      for (i = 0; i < n; i++) {
+        var idx = (rng() * ORIGINS.length) | 0;
+        if (picks.indexOf(idx) !== -1) { i--; continue; }
+        var w = 0.2 + rng();
+        picks.push(idx); weights.push(w); total += w;
+      }
+      var base = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+      for (i = 0; i < n; i++) {
+        weights[i] /= total;
+        var o = ORIGINS[picks[i]];
+        for (k in base) base[k] += o[k] * weights[i];
+      }
+
+      var roast = (rng() * ROASTS.length) | 0;
+      var roastF = roast / (ROASTS.length - 1); // 0 light .. 1 dark
+      var time = lerp(rng, method.time);
+      var grind = lerp(rng, method.grind);
+      var temp = lerp(rng, method.temp);
+      var timeN = (time - method.time[0]) / (method.time[1] - method.time[0]);
+      var tempN = (temp - method.temp[0]) / Math.max(1, method.temp[1] - method.temp[0]);
+
+      // Monte Carlo extraction: sample particle extraction yields.
+      var yieldSum = 0;
+      for (var s = 0; s < samples; s++) {
+        var particle = grind + (rng() - 0.5) * 0.2;
+        var rate = (1.2 - particle) * (0.7 + 0.6 * tempN);
+        var y = 1 - Math.exp(-rate * (0.5 + timeN * 1.5) * method.strength);
+        // Channeling noise
+        y += (rng() - 0.5) * 0.08;
+        yieldSum += y;
+      }
+      var extraction = clamp(yieldSum / samples); // ~0.18-0.22 ideal mapped to ~0.55-0.75
+      var over = Math.max(0, extraction - 0.75);
+      var under = Math.max(0, 0.55 - extraction);
+
+      var p = {
+        acidity:    clamp(base.acidity * (1 - 0.6 * roastF) + under * 0.8 - over * 0.3),
+        body:       clamp(base.body * (0.8 + 0.4 * roastF) + extraction * 0.15 - under * 0.4),
+        sweetness:  clamp(base.sweetness * (1 - Math.abs(roastF - 0.4) * 0.5) - over * 0.9 - under * 0.7),
+        bitterness: clamp(base.bitterness * (0.6 + 0.8 * roastF) + over * 1.2),
+        aroma:      clamp(base.aroma * (1 - 0.35 * roastF) + extraction * 0.1 - over * 0.4)
+      };
+
+      var dist = 0;
+      for (k in IDEAL) dist += (p[k] - IDEAL[k]) * (p[k] - IDEAL[k]);
+      p.score = Math.round(100 * (1 - Math.sqrt(dist / 5) * 1.8) * 10) / 10;
+      p.extraction = extraction;
+      p.roast = ROASTS[roast];
+      p.grind = grind;
+      p.time = time;
+      p.temp = temp;
+      p.origins = picks.map(function (idx, j) {
+        return Math.round(weights[j] * 100) + '% ' + ORIGINS[idx].name;
+      }).join(' / ');
+      return p;
+    }
+
+    function insertTop(top, p, id) {
+      if (top.length === TOP_N && p.score <= top[top.length - 1].score) return;
+      p.id = id;
+      var i = top.length;
+      while (i > 0 && top[i - 1].score < p.score) i--;
+      top.splice(i, 0, p);
+      if (top.length > TOP_N) top.pop();
+    }
+
+    function run(cfg) {
+      cancelled = false;
+      var rng = makeRng(cfg.seed);
+      var method = METHODS[cfg.method] || METHODS.pourover;
+      var sums = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+      var top = [];
+      var done = 0;
+      var CHUNK = 5000;
+      var start = Date.now();
+      var lastPost = 0;
+
+      function snapshot(final) {
+        var avg = {};
+        for (var k in sums) avg[k] = done ? sums[k] / done : 0;
+        return { type: final ? 'done' : 'progress', done: done, total: cfg.count,
+                 elapsed: Date.now() - start, average: avg, top: top };
+      }
+
+      // Process in chunks and yield between them so 'cancel' messages can be received.
+      function step() {
+        if (cancelled) { self.postMessage({ type: 'cancelled', done: done, total: cfg.count }); return; }
+        var end = Math.min(cfg.count, done + CHUNK);
+        for (var i = done; i < end; i++) {
+          var p = simulateBlend(rng, method, cfg.samples);
+          sums.acidity += p.acidity; sums.body += p.body; sums.sweetness += p.sweetness;
+          sums.bitterness += p.bitterness; sums.aroma += p.aroma;
+          insertTop(top, p, i + 1);
+        }
+        done = end;
+        if (done >= cfg.count) { self.postMessage(snapshot(true)); return; }
+        var now = Date.now();
+        if (now - lastPost > 100) { lastPost = now; self.postMessage(snapshot(false)); }
+        setTimeout(step, 0);
+      }
+      step();
+    }
+
+    self.onmessage = function (e) {
+      var msg = e.data;
+      if (msg.type === 'start') run(msg.config);
+      else if (msg.type === 'cancel') cancelled = true;
+    };
+  </script>
+
+  <script>
+    (function () {
+      'use strict';
+      var form = document.getElementById('lab-form');
+      var runBtn = document.getElementById('lab-run');
+      var cancelBtn = document.getElementById('lab-cancel');
+      var fill = document.getElementById('lab-progress-fill');
+      var bar = document.getElementById('lab-progressbar');
+      var statusText = document.getElementById('lab-status-text');
+      var statusMeta = document.getElementById('lab-status-meta');
+      var profileEl = document.getElementById('lab-profile');
+      var topEl = document.getElementById('lab-top');
+      var workerSrc = document.getElementById('flavor-worker-src').textContent;
+      var ATTRS = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+      var worker = null;
+      var workerUrl = null;
+      var pendingFrame = null;
+      var latest = null;
+
+      function createWorker() {
+        // Inline Blob worker: works with any static host and without extra files.
+        workerUrl = URL.createObjectURL(new Blob([workerSrc], { type: 'text/javascript' }));
+        var w = new Worker(workerUrl);
+        w.onmessage = onWorkerMessage;
+        w.onerror = function (err) {
+          err.preventDefault();
+          finish('Simulation error: ' + (err.message || 'unknown error'));
+          terminate();
+        };
+        return w;
+      }
+
+      function terminate() {
+        if (worker) { worker.terminate(); worker = null; }
+        if (workerUrl) { URL.revokeObjectURL(workerUrl); workerUrl = null; }
+      }
+
+      function escapeHtml(str) {
+        return String(str).replace(/[&<>"']/g, function (c) {
+          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
+        });
+      }
+
+      function fmt(n) { return n.toLocaleString(); }
+
+      function ensureProfileRows() {
+        if (profileEl.querySelector('.profile-row')) return;
+        profileEl.innerHTML = ATTRS.map(function (a) {
+          return '<div class="profile-row"><span>' + a.charAt(0).toUpperCase() + a.slice(1) + '</span>' +
+            '<div class="profile-track"><div class="profile-fill" data-attr="' + a + '"></div></div>' +
+            '<span class="profile-value" data-val="' + a + '">0</span></div>';
+        }).join('');
+      }
+
+      function render(data) {
+        var pct = data.total ? (data.done / data.total) * 100 : 0;
+        fill.style.width = pct.toFixed(1) + '%';
+        bar.setAttribute('aria-valuenow', Math.round(pct));
+        var secs = data.elapsed / 1000;
+        var rate = secs > 0 ? Math.round(data.done / secs) : 0;
+        statusMeta.textContent = fmt(data.done) + ' / ' + fmt(data.total) + ' blends · ' +
+          secs.toFixed(1) + 's · ' + fmt(rate) + ' blends/s';
+
+        ensureProfileRows();
+        ATTRS.forEach(function (a) {
+          var v = data.average[a] * 100;
+          profileEl.querySelector('[data-attr="' + a + '"]').style.width = v.toFixed(1) + '%';
+          profileEl.querySelector('[data-val="' + a + '"]').textContent = v.toFixed(0);
+        });
+
+        if (!data.top.length) return;
+        topEl.innerHTML = '<table class="top-blends"><thead><tr><th>#</th><th>Blend</th><th>Roast</th>' +
+          '<th class="num">Score</th></tr></thead><tbody>' +
+          data.top.map(function (b) {
+            var detail = 'Grind ' + b.grind.toFixed(2) + ', ' + Math.round(b.temp) + '°C, extraction ' +
+              Math.round(b.extraction * 100) + '%';
+            return '<tr title="' + escapeHtml(detail) + '"><td>' + b.id + '</td><td>' + escapeHtml(b.origins) +
+              '</td><td>' + escapeHtml(b.roast) + '</td><td class="num">' + b.score.toFixed(1) + '</td></tr>';
+          }).join('') + '</tbody></table>';
+      }
+
+      // Throttle DOM updates to animation frames to keep the main thread smooth.
+      function scheduleRender(data) {
+        latest = data;
+        if (pendingFrame) return;
+        pendingFrame = requestAnimationFrame(function () {
+          pendingFrame = null;
+          if (latest) render(latest);
+        });
+      }
+
+      function onWorkerMessage(e) {
+        var d = e.data;
+        if (d.type === 'progress') {
+          statusText.textContent = 'Simulating blends…';
+          scheduleRender(d);
+        } else if (d.type === 'done') {
+          if (pendingFrame) { cancelAnimationFrame(pendingFrame); pendingFrame = null; }
+          render(d);
+          finish('Simulation complete! Best blend scored ' + (d.top[0] ? d.top[0].score.toFixed(1) : '–') + '.');
+          terminate();
+        } else if (d.type === 'cancelled') {
+          finish('Simulation cancelled after ' + fmt(d.done) + ' blends.');
+          terminate();
+        }
+      }
+
+      function finish(msg) {
+        statusText.textContent = msg;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+      }
+
+      function readInt(id, min, max) {
+        var v = parseInt(document.getElementById(id).value, 10);
+        if (isNaN(v)) v = min;
+        return Math.min(max, Math.max(min, v));
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (typeof Worker === 'undefined') {
+          statusText.textContent = 'Sorry, your browser does not support background simulations.';
+          return;
+        }
+        terminate();
+        var config = {
+          count: readInt('lab-count', 1000, 2000000),
+          samples: readInt('lab-samples', 1, 200),
+          seed: readInt('lab-seed', 0, 4294967295),
+          method: document.getElementById('lab-method').value
+        };
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        fill.style.width = '0%';
+        statusText.textContent = 'Warming up the roaster…';
+        statusMeta.textContent = '';
+        topEl.innerHTML = '<p class="lab-empty">Collecting results…</p>';
+        try {
+          worker = createWorker();
+          worker.postMessage({ type: 'start', config: config });
+        } catch (err) {
+          finish('Could not start simulation: ' + err.message);
+          terminate();
+        }
+      });
+
+      cancelBtn.addEventListener('click', function () {
+        if (!worker) return;
+        cancelBtn.disabled = true;
+        statusText.textContent = 'Cancelling…';
+        worker.postMessage({ type: 'cancel' });
+      });
+
+      window.addEventListener('pagehide', terminate);
+    })();
+  </script>
+
