+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const drink = form.elements.drink;
+      const milk = form.elements.milk;
+      const shots = form.elements.shots;
+      const sweetness = form.elements.sweetness;
+      const sweetOut = document.getElementById('sweetness-output');
+      const totalOut = document.getElementById('order-total');
+      const caffeineOut = document.getElementById('caffeine-output');
+      const meter = document.getElementById('caffeine-meter');
+      const dateInput = document.getElementById('pickup-date');
+      const sweetLabels = ['None', 'Light', 'Regular', 'Sweet', 'Extra'];
+
+      // Earliest pickup date is today (local time)
+      const now = new Date();
+      const today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+      dateInput.min = today;
+      dateInput.value = today;
+      dateInput.defaultValue = today;
+
+      function update() {
+        const opt = drink.selectedOptions[0];
+        const size = form.querySelector('input[name="size"]:checked');
+        const mult = size ? parseFloat(size.dataset.multiplier) : 1;
+        const shotCount = Math.min(4, Math.max(0, parseInt(shots.value, 10) || 0));
+
+        let price = parseFloat(opt.dataset.price) * mult;
+        if (milk.value === 'oat' || milk.value === 'almond') price += 0.6;
+        price += Math.max(0, shotCount - 1) * 0.75;
+        form.querySelectorAll('input[name="extras"]:checked').forEach(function (el) {
+          price += parseFloat(el.dataset.price) || 0;
+        });
+        totalOut.value = '$' + price.toFixed(2);
+
+        const caffeine = Math.max(0, Math.round(parseInt(opt.dataset.caffeine, 10) * mult + (shotCount - 1) * 65));
+        meter.value = caffeine;
+        meter.textContent = caffeine + ' mg';
+        caffeineOut.value = caffeine + ' mg';
+
+        sweetOut.value = sweetLabels[sweetness.value];
+        sweetness.style.setProperty('--fill', (sweetness.value / sweetness.max) * 100 + '%');
+      }
+
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      form.addEventListener('reset', function () { requestAnimationFrame(update); });
+      update();
+    })();
+  </script>
