+  <script>
+    (() => {
+      const form = document.getElementById('order-form');
+      const shots = document.getElementById('shots');
+      const shotsOut = document.getElementById('shots-output');
+      const meter = document.getElementById('strength');
+      const strengthLabel = document.getElementById('strength-label');
+      const sweet = document.getElementById('sweetness');
+      const sweetOut = document.getElementById('sweetness-output');
+      const date = document.getElementById('pickup-date');
+      const summary = document.getElementById('order-summary');
+      const strengthNames = ['', 'Mellow', 'Balanced', 'Bold', 'Extra bold'];
+      const needsTrackFill = !CSS.supports('accent-color', 'auto');
+
+      const fill = (input) => {
+        if (!needsTrackFill) return;
+        const pct = ((input.value - input.min) / (input.max - input.min)) * 100;
+        input.style.setProperty('--progress', `${pct}%`);
+      };
+
+      const syncShots = () => {
+        shotsOut.value = shots.value;
+        meter.value = shots.value;
+        strengthLabel.textContent = `Strength: ${strengthNames[shots.value]}`;
+        fill(shots);
+      };
+      const syncSweet = () => {
+        sweetOut.value = `${sweet.value}%`;
+        fill(sweet);
+      };
+
+      shots.addEventListener('input', syncShots);
+      sweet.addEventListener('input', syncSweet);
+      syncShots();
+      syncSweet();
+
+      // Earliest pickup date is today (local), up to two weeks out
+      const toISODate = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+      const today = new Date();
+      const maxDay = new Date(today);
+      maxDay.setDate(today.getDate() + 14);
+      date.min = toISODate(today);
+      date.max = toISODate(maxDay);
+      date.value = date.min;
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const drink = form.drink.selectedOptions[0].textContent;
+        const extras = data.getAll('extras');
+        summary.textContent =
+          `Added ${data.get('quantity')} × ${data.get('size')} ${drink} with ${data.get('milk')} milk, ` +
+          `${data.get('shots')} shot(s), ${data.get('sweetness')}% sweet` +
+          (extras.length ? `, ${extras.join(', ').replaceAll('-', ' ')}` : '') +
+          ` — pickup ${data.get('pickup_date')} at ${data.get('pickup_time')}.`;
+      });
+    })();
+  </script>
 </body>
 
