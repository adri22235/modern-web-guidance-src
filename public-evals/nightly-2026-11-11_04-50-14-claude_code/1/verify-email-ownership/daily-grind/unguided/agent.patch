diff --git a/rewards-signup.js b/rewards-signup.js
new file mode 100644
index 0000000..c2edf83
--- /dev/null
+++ b/rewards-signup.js
@@ -0,0 +1,72 @@
+// Daily Grind Rewards sign-up uses the Email Verification Protocol (EVP).
+//
+// When the user picks an address from autofill, a supporting browser asks the email domain's
+// issuer for a signed token, binds it to the form's nonce and this site's origin, and puts the
+// result (EVT+KB) in the hidden `autocomplete="email-verification-token"` input before the
+// submit event fires. The server checks that token, so no passcode or magic-link email is sent.
+(() => {
+  const form = document.getElementById('rewards-form');
+  if (!form) return;
+  const tokenInput = document.getElementById('rw-token');
+  const status = document.getElementById('rw-status');
+  const button = form.querySelector('button[type="submit"]');
+
+  const setStatus = (msg, kind) => {
+    status.textContent = msg;
+    status.className = `form-status ${kind || ''}`;
+  };
+
+  // Each nonce works once. After a failed attempt, install the fresh one the server returned.
+  const setNonce = (nonce) => {
+    if (!nonce) return;
+    tokenInput.nonce = nonce;
+    tokenInput.setAttribute('nonce', nonce);
+    tokenInput.value = '';
+  };
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (!form.reportValidity()) return;
+
+    const data = new FormData(form);
+    const payload = {
+      name: data.get('name'),
+      email: data.get('email'),
+      favorite: data.get('favorite'),
+      marketing: data.get('marketing') === 'on',
+      token: tokenInput.value,
+    };
+
+    button.disabled = true;
+    setStatus('Confirming your email with your provider…');
+    try {
+      const res = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify(payload),
+      });
+      const body = await res.json().catch(() => ({}));
+      if (res.ok && body.ok) {
+        form.reset();
+        form.querySelectorAll('input, select, button').forEach((el) => (el.disabled = true));
+        setStatus(
+          `Welcome, ${body.account.name}! ${body.account.email} is verified and ` +
+            `${body.account.points} bonus points are waiting for you.`,
+          'success',
+        );
+        return;
+      }
+      setNonce(body.nonce);
+      setStatus(body.error || 'Sign-up failed. Please try again.', 'error');
+    } catch {
+      setStatus('Network error. Please check your connection and try again.', 'error');
+      try {
+        const r = await fetch('/api/rewards/nonce', { credentials: 'same-origin' });
+        setNonce((await r.json()).nonce);
+      } catch {}
+    } finally {
+      if (!status.classList.contains('success')) button.disabled = false;
+    }
+  });
+})();
diff --git a/server/evp-verifier.js b/server/evp-verifier.js
new file mode 100644
index 0000000..c51c1e0
--- /dev/null
+++ b/server/evp-verifier.js
@@ -0,0 +1,302 @@
+// Verifier for the Email Verification Protocol (EVP).
+// Spec: https://datatracker.ietf.org/doc/draft-hardt-email-verification/
+// Explainer: https://github.com/WICG/email-verification
+//
+// The browser sends an "EVT+KB" presentation token:  <EVT>~<KB-JWT>
+//   EVT    – a JWT signed by the email domain's issuer. It says the user controls `email`
+//            and binds the browser's ephemeral key (`cnf.jwk`).
+//   KB-JWT – a JWT signed by the browser's ephemeral key. It binds the token to our origin
+//            (`aud`) and to the one-time nonce we issued (`nonce`).
+//
+// Nothing here sends email: proof of control comes from the user's existing session with
+// their email provider, which the browser uses when it asks the issuer for the EVT.
+
+import crypto from 'node:crypto';
+import dns from 'node:dns/promises';
+import net from 'node:net';
+
+export class EvpError extends Error {
+  constructor(code, message) {
+    super(message);
+    this.code = code;
+  }
+}
+
+// Fully specified JOSE algorithms we accept (RFC 9864). The draft forbids `none`,
+// symmetric MACs and the polymorphic `EdDSA`.
+const ALGS = {
+  Ed25519: { kty: 'OKP', crv: 'Ed25519', hash: null },
+  ES256: { kty: 'EC', crv: 'P-256', hash: 'sha256', dsaEncoding: 'ieee-p1363' },
+  ES384: { kty: 'EC', crv: 'P-384', hash: 'sha384', dsaEncoding: 'ieee-p1363' },
+  RS256: { kty: 'RSA', hash: 'sha256' },
+  PS256: { kty: 'RSA', hash: 'sha256', pss: true },
+};
+
+const b64urlDecode = (s) => {
+  if (typeof s !== 'string' || !/^[A-Za-z0-9_-]*$/.test(s)) {
+    throw new EvpError('malformed', 'Invalid base64url segment');
+  }
+  return Buffer.from(s, 'base64url');
+};
+
+function parseJwt(jwt, label) {
+  const parts = typeof jwt === 'string' ? jwt.split('.') : [];
+  if (parts.length !== 3 || parts.some((p) => p.length === 0)) {
+    throw new EvpError('malformed', `${label} is not a compact JWS`);
+  }
+  let header, payload;
+  try {
+    header = JSON.parse(b64urlDecode(parts[0]).toString('utf8'));
+    payload = JSON.parse(b64urlDecode(parts[1]).toString('utf8'));
+  } catch (e) {
+    if (e instanceof EvpError) throw e;
+    throw new EvpError('malformed', `${label} has an invalid JSON header or payload`);
+  }
+  if (!header || typeof header !== 'object' || !payload || typeof payload !== 'object') {
+    throw new EvpError('malformed', `${label} header/payload must be JSON objects`);
+  }
+  return {
+    header,
+    payload,
+    signingInput: Buffer.from(`${parts[0]}.${parts[1]}`, 'ascii'),
+    signature: b64urlDecode(parts[2]),
+  };
+}
+
+function importJwk(jwk, alg, label) {
+  const spec = ALGS[alg];
+  if (!spec) throw new EvpError('bad_alg', `${label}: unsupported algorithm "${alg}"`);
+  if (!jwk || typeof jwk !== 'object' || jwk.kty !== spec.kty || (spec.crv && jwk.crv !== spec.crv)) {
+    throw new EvpError('bad_key', `${label}: key type does not match algorithm ${alg}`);
+  }
+  if ('d' in jwk || 'k' in jwk) throw new EvpError('bad_key', `${label}: key must be a public key`);
+  if (jwk.alg !== undefined && jwk.alg !== alg) {
+    throw new EvpError('bad_key', `${label}: key alg "${jwk.alg}" does not match "${alg}"`);
+  }
+  try {
+    const { kty, crv, x, y, n, e } = jwk;
+    const key = crypto.createPublicKey({ key: { kty, crv, x, y, n, e }, format: 'jwk' });
+    if (spec.kty === 'RSA' && key.asymmetricKeyDetails.modulusLength < 2048) {
+      throw new EvpError('bad_key', `${label}: RSA key too short`);
+    }
+    return key;
+  } catch (e) {
+    if (e instanceof EvpError) throw e;
+    throw new EvpError('bad_key', `${label}: invalid public key`);
+  }
+}
+
+function verifySignature(parsed, key, alg, label) {
+  const spec = ALGS[alg];
+  const opts = { key };
+  if (spec.dsaEncoding) opts.dsaEncoding = spec.dsaEncoding;
+  if (spec.pss) {
+    opts.padding = crypto.constants.RSA_PKCS1_PSS_PADDING;
+    opts.saltLength = 32;
+  }
+  let ok = false;
+  try {
+    ok = crypto.verify(spec.hash, parsed.signingInput, opts, parsed.signature);
+  } catch {
+    ok = false;
+  }
+  if (!ok) throw new EvpError('bad_signature', `${label} signature is invalid`);
+}
+
+function checkIat(iat, now, { maxAgeSec, maxSkewSec }, label) {
+  if (!Number.isInteger(iat)) throw new EvpError('bad_claims', `${label}: missing or invalid iat`);
+  if (iat > now + maxSkewSec) throw new EvpError('expired', `${label}: iat is in the future`);
+  if (now - iat > maxAgeSec) throw new EvpError('expired', `${label}: token is too old`);
+}
+
+// Returns the email domain only if it is a plausible DNS name. Rejects IP literals and odd
+// characters so a crafted address can't steer the DNS lookup.
+function emailDomain(email) {
+  if (typeof email !== 'string' || email.length > 254) return null;
+  const at = email.lastIndexOf('@');
+  if (at < 1) return null;
+  const domain = email.slice(at + 1).toLowerCase();
+  if (!/^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}$/.test(domain)) return null;
+  return domain;
+}
+
+function isPublicHostname(host) {
+  if (!/^(?=.{1,253}$)([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9-]{2,63}$/.test(host)) return false;
+  if (net.isIP(host)) return false;
+  if (host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local') || host.endsWith('.internal')) return false;
+  return true;
+}
+
+/**
+ * Builds an EVP verifier.
+ *
+ * @param {object} opts
+ * @param {string} opts.rpOrigin   Our exact origin, e.g. "https://dailygrind.example". It is
+ *                                 compared byte-for-byte with the KB-JWT `aud`.
+ * @param {(name:string)=>Promise<string[][]>} [opts.resolveTxt]  Injectable DNS TXT resolver.
+ * @param {typeof fetch} [opts.fetch]  Injectable fetch.
+ * @param {()=>number} [opts.now]      Returns the current time in epoch seconds.
+ */
+export function createEvpVerifier({
+  rpOrigin,
+  resolveTxt = (name) => dns.resolveTxt(name),
+  fetch: fetchImpl = globalThis.fetch,
+  now = () => Math.floor(Date.now() / 1000),
+  evtMaxAgeSec = 300,
+  kbMaxAgeSec = 300,
+  maxSkewSec = 60,
+  cacheTtlMs = 10 * 60 * 1000,
+  fetchTimeoutMs = 5000,
+  maxTokenLength = 16 * 1024,
+} = {}) {
+  if (!rpOrigin || new URL(rpOrigin).origin !== rpOrigin) {
+    throw new Error('rpOrigin must be a bare origin such as https://example.com');
+  }
+
+  const cache = new Map(); // url -> { expires, value }
+
+  async function getJson(url) {
+    const hit = cache.get(url);
+    if (hit && hit.expires > Date.now()) return hit.value;
+    let res;
+    try {
+      res = await fetchImpl(url, {
+        redirect: 'error',
+        headers: { accept: 'application/json' },
+        signal: AbortSignal.timeout(fetchTimeoutMs),
+      });
+    } catch {
+      throw new EvpError('issuer_unreachable', `Could not fetch ${url}`);
+    }
+    if (!res.ok) throw new EvpError('issuer_unreachable', `${url} returned HTTP ${res.status}`);
+    const text = await res.text();
+    if (text.length > 64 * 1024) throw new EvpError('issuer_bad_metadata', `${url} response too large`);
+    let value;
+    try {
+      value = JSON.parse(text);
+    } catch {
+      throw new EvpError('issuer_bad_metadata', `${url} did not return JSON`);
+    }
+    cache.set(url, { expires: Date.now() + cacheTtlMs, value });
+    return value;
+  }
+
+  // Spec §3.1–3.2: there must be exactly one TXT record at _email-verification.$domain
+  // that starts with "iss=". The issuer identifier is https:// + host.
+  async function discoverIssuer(domain) {
+    let records;
+    try {
+      records = await resolveTxt(`_email-verification.${domain}`);
+    } catch {
+      throw new EvpError('no_issuer', `No email verification issuer is published for ${domain}`);
+    }
+    const iss = records.map((chunks) => chunks.join('')).filter((r) => r.startsWith('iss='));
+    if (iss.length !== 1) {
+      throw new EvpError('no_issuer', `Expected exactly one issuer record for ${domain}, found ${iss.length}`);
+    }
+    const host = iss[0].slice(4);
+    if (!isPublicHostname(host)) throw new EvpError('no_issuer', `Issuer host "${host}" is not valid`);
+    return `https://${host}`;
+  }
+
+  async function getIssuerKey(issuer, kid, alg) {
+    const meta = await getJson(`${issuer}/.well-known/email-verification`);
+    if (!meta || meta.issuer !== issuer) {
+      throw new EvpError('issuer_bad_metadata', 'Issuer metadata "issuer" does not match');
+    }
+    if (Array.isArray(meta.signing_alg_values_supported)) {
+      if (!meta.signing_alg_values_supported.includes(alg)) {
+        throw new EvpError('bad_alg', `Issuer does not advertise algorithm ${alg}`);
+      }
+    } else if (alg !== 'Ed25519') {
+      // The draft makes Ed25519 the default when the issuer doesn't list algorithms.
+      throw new EvpError('bad_alg', `Issuer does not advertise algorithm ${alg}`);
+    }
+    let jwksUrl;
+    try {
+      jwksUrl = new URL(meta.jwks_uri);
+    } catch {
+      throw new EvpError('issuer_bad_metadata', 'Issuer metadata has no valid jwks_uri');
+    }
+    if (jwksUrl.protocol !== 'https:' || !isPublicHostname(jwksUrl.hostname)) {
+      throw new EvpError('issuer_bad_metadata', 'jwks_uri must be a public https URL');
+    }
+    const jwks = await getJson(jwksUrl.href);
+    const keys = Array.isArray(jwks?.keys) ? jwks.keys.filter((k) => k && k.kid === kid) : [];
+    if (keys.length !== 1) throw new EvpError('bad_key', `Issuer key "${kid}" not found`);
+    if (keys[0].use !== undefined && keys[0].use !== 'sig') {
+      throw new EvpError('bad_key', 'Issuer key is not a signing key');
+    }
+    return importJwk(keys[0], alg, 'EVT');
+  }
+
+  /**
+   * Verifies an EVT+KB presentation token.
+   * @param {string} token           The value the browser put in the token field.
+   * @param {string} expectedNonce   The nonce we issued for this session.
+   * @returns {Promise<{email:string, issuer:string}>}
+   */
+  async function verify(token, expectedNonce) {
+    if (typeof token !== 'string' || token.length === 0) {
+      throw new EvpError('missing_token', 'No email verification token was provided');
+    }
+    if (token.length > maxTokenLength) throw new EvpError('malformed', 'Token too large');
+    if (typeof expectedNonce !== 'string' || expectedNonce.length < 22) {
+      throw new EvpError('bad_nonce', 'No valid nonce for this session');
+    }
+
+    // Format: <EVT>~<KB-JWT>. The EVT has no disclosures. A form with several "~"
+    // separators would carry selective disclosures, which EVP doesn't use, so reject it.
+    const parts = token.split('~');
+    if (parts.length !== 2 || !parts[0] || !parts[1]) {
+      throw new EvpError('malformed', 'Token must have the form <EVT>~<KB-JWT>');
+    }
+    const [evtJwt, kbJwt] = parts;
+    const evt = parseJwt(evtJwt, 'EVT');
+    const kb = parseJwt(kbJwt, 'KB-JWT');
+    const t = now();
+
+    // KB-JWT claim checks (§6). These are cheap, so do them before any network I/O.
+    if (kb.header.typ !== 'kb+jwt') throw new EvpError('bad_claims', 'KB-JWT typ must be kb+jwt');
+    if (kb.payload.aud !== rpOrigin) throw new EvpError('bad_audience', 'Token was not issued for this site');
+    const nonceA = Buffer.from(String(kb.payload.nonce ?? ''));
+    const nonceB = Buffer.from(expectedNonce);
+    if (nonceA.length !== nonceB.length || !crypto.timingSafeEqual(nonceA, nonceB)) {
+      throw new EvpError('bad_nonce', 'Token nonce does not match this session');
+    }
+    checkIat(kb.payload.iat, t, { maxAgeSec: kbMaxAgeSec, maxSkewSec }, 'KB-JWT');
+    const sdHash = crypto.createHash('sha256').update(`${evtJwt}~`, 'ascii').digest('base64url');
+    if (kb.payload.sd_hash !== sdHash) throw new EvpError('bad_claims', 'KB-JWT sd_hash does not match the EVT');
+
+    // EVT claim checks (§5).
+    if (evt.header.typ !== 'evt+jwt') throw new EvpError('bad_claims', 'EVT typ must be evt+jwt');
+    if (!ALGS[evt.header.alg]) throw new EvpError('bad_alg', `EVT algorithm "${evt.header.alg}" not allowed`);
+    if (typeof evt.header.kid !== 'string' || !evt.header.kid) throw new EvpError('bad_claims', 'EVT kid missing');
+    if (evt.payload.email_verified !== true) throw new EvpError('bad_claims', 'EVT email_verified must be true');
+    const email = evt.payload.email;
+    const domain = emailDomain(email);
+    if (!domain) throw new EvpError('bad_claims', 'EVT email claim is invalid');
+    checkIat(evt.payload.iat, t, { maxAgeSec: evtMaxAgeSec, maxSkewSec }, 'EVT');
+    const cnfJwk = evt.payload.cnf?.jwk;
+    if (!cnfJwk || typeof cnfJwk !== 'object') throw new EvpError('bad_claims', 'EVT cnf.jwk missing');
+
+    // The KB-JWT alg must equal the alg on the bound key.
+    if (typeof cnfJwk.alg !== 'string' || kb.header.alg !== cnfJwk.alg) {
+      throw new EvpError('bad_alg', 'KB-JWT alg does not match cnf.jwk alg');
+    }
+    const browserKey = importJwk(cnfJwk, cnfJwk.alg, 'KB-JWT');
+    verifySignature(kb, browserKey, cnfJwk.alg, 'KB-JWT');
+
+    // Find the issuer this email domain authorises, then check the issuer's signature.
+    const issuer = await discoverIssuer(domain);
+    if (evt.payload.iss !== issuer) {
+      throw new EvpError('bad_issuer', 'EVT was not issued by the issuer authorised for this email domain');
+    }
+    const issuerKey = await getIssuerKey(issuer, evt.header.kid, evt.header.alg);
+    verifySignature(evt, issuerKey, evt.header.alg, 'EVT');
+
+    return { email, issuer };
+  }
+
+  return { verify };
+}
diff --git a/server/index.js b/server/index.js
new file mode 100644
index 0000000..6eba10b
--- /dev/null
+++ b/server/index.js
@@ -0,0 +1,269 @@
+// The Daily Grind web server. It serves the homepage and the rewards sign-up API.
+//
+//   GET  /                        homepage, with a fresh one-time EVP nonce in the sign-up form
+//   GET  /api/rewards/nonce       issues a new nonce (used to retry after a failed attempt)
+//   POST /api/rewards/signup      verifies the browser's EVT+KB token and creates the account
+//
+// Environment:
+//   PORT       listen port (default 11222)
+//   RP_ORIGIN  exact public origin of the site, e.g. https://dailygrind.example. Tokens are
+//              audience-bound to it. Defaults to http://localhost:$PORT for local development.
+//   DATA_DIR   where accounts.json is stored (default ./data)
+
+import http from 'node:http';
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createEvpVerifier, EvpError } from './evp-verifier.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+const DATA_DIR = path.resolve(process.env.DATA_DIR || path.join(ROOT, 'data'));
+const ACCOUNTS_FILE = path.join(DATA_DIR, 'accounts.json');
+const SECURE_COOKIE = RP_ORIGIN.startsWith('https://');
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const SESSION_COOKIE = SECURE_COOKIE ? '__Host-dg_sid' : 'dg_sid';
+
+const verifier = createEvpVerifier({ rpOrigin: RP_ORIGIN });
+
+// ---- Sessions and nonces (in memory) ---------------------------------------------------
+const sessions = new Map(); // sid -> { nonce, nonceExpires, lastSeen }
+
+function getSession(req, res) {
+  const cookies = Object.fromEntries(
+    (req.headers.cookie || '').split(';').map((c) => c.trim().split('=')).filter((p) => p.length === 2),
+  );
+  let sid = cookies[SESSION_COOKIE];
+  if (!sid || !sessions.has(sid)) {
+    sid = crypto.randomBytes(32).toString('base64url');
+    sessions.set(sid, {});
+    res.setHeader(
+      'Set-Cookie',
+      `${SESSION_COOKIE}=${sid}; Path=/; HttpOnly; SameSite=Strict${SECURE_COOKIE ? '; Secure' : ''}`,
+    );
+  }
+  const s = sessions.get(sid);
+  s.lastSeen = Date.now();
+  return s;
+}
+
+function issueNonce(session) {
+  session.nonce = crypto.randomBytes(32).toString('base64url'); // 256 bits of entropy
+  session.nonceExpires = Date.now() + NONCE_TTL_MS;
+  return session.nonce;
+}
+
+// Single use: the nonce is cleared whether verification succeeds or fails.
+function consumeNonce(session) {
+  const { nonce, nonceExpires } = session;
+  delete session.nonce;
+  delete session.nonceExpires;
+  return nonce && nonceExpires > Date.now() ? nonce : null;
+}
+
+setInterval(() => {
+  const cutoff = Date.now() - 60 * 60 * 1000;
+  for (const [sid, s] of sessions) if (s.lastSeen < cutoff) sessions.delete(sid);
+}, 5 * 60 * 1000).unref();
+
+// ---- Accounts (JSON file) ---------------------------------------------------------------
+let accounts = null;
+let writeChain = Promise.resolve();
+
+async function loadAccounts() {
+  if (accounts) return accounts;
+  try {
+    accounts = JSON.parse(await fs.readFile(ACCOUNTS_FILE, 'utf8'));
+  } catch (e) {
+    if (e.code !== 'ENOENT') throw e;
+    accounts = {};
+  }
+  return accounts;
+}
+
+function saveAccounts() {
+  writeChain = writeChain.then(async () => {
+    await fs.mkdir(DATA_DIR, { recursive: true });
+    const tmp = `${ACCOUNTS_FILE}.${process.pid}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(accounts, null, 2), { mode: 0o600 });
+    await fs.rename(tmp, ACCOUNTS_FILE);
+  });
+  return writeChain;
+}
+
+// ---- Basic per-IP rate limiting for the sign-up endpoint ---------------------------------
+const hits = new Map();
+function rateLimited(ip, limit = 10, windowMs = 60_000) {
+  const now = Date.now();
+  const entry = hits.get(ip);
+  if (!entry || entry.reset < now) {
+    hits.set(ip, { count: 1, reset: now + windowMs });
+    return false;
+  }
+  return ++entry.count > limit;
+}
+setInterval(() => {
+  const now = Date.now();
+  for (const [ip, e] of hits) if (e.reset < now) hits.delete(ip);
+}, 60_000).unref();
+
+// ---- Helpers -----------------------------------------------------------------------------
+const SECURITY_HEADERS = {
+  'Content-Security-Policy':
+    "default-src 'self'; img-src 'self' https://images.unsplash.com; style-src 'self' 'unsafe-inline'; " +
+    "script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+};
+
+function send(res, status, body, type = 'application/json; charset=utf-8') {
+  const payload = type.startsWith('application/json') ? JSON.stringify(body) : body;
+  res.writeHead(status, { ...SECURITY_HEADERS, 'Content-Type': type, 'Cache-Control': 'no-store' });
+  res.end(payload);
+}
+
+async function readBody(req, limit = 32 * 1024) {
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) throw new HttpError(413, 'Request body too large');
+    chunks.push(chunk);
+  }
+  const raw = Buffer.concat(chunks).toString('utf8');
+  const type = (req.headers['content-type'] || '').split(';')[0].trim();
+  if (type === 'application/json') {
+    try {
+      return JSON.parse(raw);
+    } catch {
+      throw new HttpError(400, 'Invalid JSON');
+    }
+  }
+  if (type === 'application/x-www-form-urlencoded') return Object.fromEntries(new URLSearchParams(raw));
+  throw new HttpError(415, 'Unsupported content type');
+}
+
+class HttpError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+const escapeAttr = (s) => s.replace(/[&"<>]/g, (c) => ({ '&': '&amp;', '"': '&quot;', '<': '&lt;', '>': '&gt;' })[c]);
+
+// Error codes the browser may show directly. Anything else is reported generically.
+const USER_MESSAGES = {
+  missing_token:
+    "Your browser didn't provide an email verification token. Choose your email from the browser's " +
+    'autofill suggestions, or use a browser that supports email verification.',
+  no_issuer: "Your email provider doesn't support instant browser verification yet.",
+  bad_nonce: 'This sign-up form has expired. Please try again.',
+  expired: 'The verification token has expired. Please try again.',
+  issuer_unreachable: "We couldn't reach your email provider to confirm your address. Please try again shortly.",
+};
+
+// ---- Routes ------------------------------------------------------------------------------
+async function handleSignup(req, res) {
+  // CSRF protection: only accept submissions from our own origin.
+  if (req.headers.origin !== RP_ORIGIN) throw new HttpError(403, 'Cross-origin request rejected');
+  const ip = req.socket.remoteAddress || 'unknown';
+  if (rateLimited(ip)) throw new HttpError(429, 'Too many attempts. Please wait a minute and try again.');
+
+  const session = getSession(req, res);
+  const body = await readBody(req);
+  const name = typeof body.name === 'string' ? body.name.trim().slice(0, 100) : '';
+  const submittedEmail = typeof body.email === 'string' ? body.email.trim() : '';
+  const favorite = typeof body.favorite === 'string' ? body.favorite.trim().slice(0, 100) : '';
+  const marketing = body.marketing === true || body.marketing === 'on';
+  const nonce = consumeNonce(session);
+  const nextNonce = issueNonce(session); // the client needs a fresh nonce to retry
+
+  if (!name) return send(res, 400, { ok: false, error: 'Please enter your name.', nonce: nextNonce });
+
+  let verified;
+  try {
+    verified = await verifier.verify(body.token, nonce);
+  } catch (e) {
+    if (!(e instanceof EvpError)) throw e;
+    console.warn(`[rewards] email verification failed (${e.code}): ${e.message}`);
+    return send(res, 422, {
+      ok: false,
+      code: e.code,
+      error: USER_MESSAGES[e.code] || "We couldn't verify your email address. Please try again.",
+      nonce: nextNonce,
+    });
+  }
+
+  // The token's email is authoritative. It must also match what the user sees in the form.
+  if (submittedEmail && submittedEmail.toLowerCase() !== verified.email.toLowerCase()) {
+    return send(res, 422, {
+      ok: false,
+      code: 'email_mismatch',
+      error: 'The verified email address does not match the one entered in the form.',
+      nonce: nextNonce,
+    });
+  }
+
+  const db = await loadAccounts();
+  const key = verified.email.toLowerCase();
+  if (db[key]) {
+    return send(res, 409, { ok: false, error: 'A rewards account already exists for this email.', nonce: nextNonce });
+  }
+  db[key] = {
+    id: crypto.randomUUID(),
+    name,
+    email: verified.email,
+    emailVerified: true,
+    emailVerifiedBy: verified.issuer,
+    favorite,
+    marketing,
+    points: 50, // welcome bonus
+    createdAt: new Date().toISOString(),
+  };
+  await saveAccounts();
+  return send(res, 201, {
+    ok: true,
+    account: { name, email: verified.email, points: db[key].points },
+  });
+}
+
+const STATIC = {
+  '/rewards-signup.js': ['rewards-signup.js', 'text/javascript; charset=utf-8'],
+};
+
+async function route(req, res) {
+  const { pathname } = new URL(req.url, 'http://localhost');
+
+  if (req.method === 'GET' && (pathname === '/' || pathname === '/index.html')) {
+    const session = getSession(req, res);
+    const html = await fs.readFile(path.join(ROOT, 'index.html'), 'utf8');
+    return send(res, 200, html.replace('{{EVP_NONCE}}', escapeAttr(issueNonce(session))), 'text/html; charset=utf-8');
+  }
+  if (req.method === 'GET' && pathname === '/api/rewards/nonce') {
+    return send(res, 200, { nonce: issueNonce(getSession(req, res)) });
+  }
+  if (pathname === '/api/rewards/signup') {
+    if (req.method !== 'POST') throw new HttpError(405, 'Method not allowed');
+    return handleSignup(req, res);
+  }
+  if (req.method === 'GET' && STATIC[pathname]) {
+    const [file, type] = STATIC[pathname];
+    return send(res, 200, await fs.readFile(path.join(ROOT, file)), type);
+  }
+  throw new HttpError(404, 'Not found');
+}
+
+const server = http.createServer(async (req, res) => {
+  try {
+    await route(req, res);
+  } catch (e) {
+    if (e instanceof HttpError) return send(res, e.status, { ok: false, error: e.message });
+    console.error(e);
+    if (!res.headersSent) send(res, 500, { ok: false, error: 'Something went wrong. Please try again.' });
+  }
+});
+
+server.listen(PORT, () => console.log(`The Daily Grind listening on :${PORT} (RP origin ${RP_ORIGIN})`));
diff --git a/test/evp-verifier.test.js b/test/evp-verifier.test.js
new file mode 100644
index 0000000..b461011
--- /dev/null
+++ b/test/evp-verifier.test.js
@@ -0,0 +1,106 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { createEvpVerifier } from '../server/evp-verifier.js';
+
+const RP = 'https://dailygrind.example';
+const ISSUER = 'https://issuer.mail.example';
+const NOW = 1_800_000_000;
+const NONCE = crypto.randomBytes(32).toString('base64url');
+
+const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
+const issuerKeys = crypto.generateKeyPairSync('ed25519');
+const issuerJwk = { ...issuerKeys.publicKey.export({ format: 'jwk' }), kid: 'k1', use: 'sig', alg: 'Ed25519' };
+const browserKeys = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+const browserJwk = { ...browserKeys.publicKey.export({ format: 'jwk' }), alg: 'ES256' };
+
+function sign(header, payload, key, alg) {
+  const input = `${b64(header)}.${b64(payload)}`;
+  const sig = alg === 'ES256'
+    ? crypto.sign('sha256', Buffer.from(input), { key, dsaEncoding: 'ieee-p1363' })
+    : crypto.sign(null, Buffer.from(input), key);
+  return `${input}.${sig.toString('base64url')}`;
+}
+
+function makeToken({ evtHeader = {}, evtClaims = {}, kbHeader = {}, kbClaims = {}, issuerKey = issuerKeys.privateKey } = {}) {
+  const evt = sign(
+    { alg: 'Ed25519', kid: 'k1', typ: 'evt+jwt', ...evtHeader },
+    { iss: ISSUER, iat: NOW - 5, cnf: { jwk: browserJwk }, email: 'ada@mail.example', email_verified: true, ...evtClaims },
+    issuerKey, 'Ed25519',
+  );
+  const sdHash = crypto.createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb = sign(
+    { alg: 'ES256', typ: 'kb+jwt', ...kbHeader },
+    { aud: RP, nonce: NONCE, iat: NOW - 1, sd_hash: sdHash, ...kbClaims },
+    browserKeys.privateKey, 'ES256',
+  );
+  return `${evt}~${kb}`;
+}
+
+function makeVerifier({ txt = [[`iss=issuer.mail.example`]], meta = {} } = {}) {
+  const docs = {
+    [`${ISSUER}/.well-known/email-verification`]: {
+      issuer: ISSUER, issuance_endpoint: `${ISSUER}/issue`, jwks_uri: `${ISSUER}/jwks.json`,
+      signing_alg_values_supported: ['Ed25519'], ...meta,
+    },
+    [`${ISSUER}/jwks.json`]: { keys: [issuerJwk] },
+  };
+  return createEvpVerifier({
+    rpOrigin: RP,
+    now: () => NOW,
+    resolveTxt: async (name) => {
+      assert.equal(name, '_email-verification.mail.example');
+      return txt;
+    },
+    fetch: async (url) => (docs[url]
+      ? new Response(JSON.stringify(docs[url]), { status: 200 })
+      : new Response('nope', { status: 404 })),
+  });
+}
+
+const rejects = (p, code) => assert.rejects(p, (e) => e.code === code || assert.fail(`expected ${code}, got ${e.code}: ${e.message}`));
+
+test('accepts a valid EVT+KB token', async () => {
+  const res = await makeVerifier().verify(makeToken(), NONCE);
+  assert.deepEqual(res, { email: 'ada@mail.example', issuer: ISSUER });
+});
+
+test('rejects a missing token', () => rejects(makeVerifier().verify('', NONCE), 'missing_token'));
+test('rejects a token minted for another site', () => rejects(makeVerifier().verify(makeToken({ kbClaims: { aud: 'https://evil.example' } }), NONCE), 'bad_audience'));
+test('rejects a nonce from another session', () => rejects(makeVerifier().verify(makeToken(), crypto.randomBytes(32).toString('base64url')), 'bad_nonce'));
+test('rejects a stale KB-JWT', () => rejects(makeVerifier().verify(makeToken({ kbClaims: { iat: NOW - 3600 } }), NONCE), 'expired'));
+test('rejects a stale EVT', () => rejects(makeVerifier().verify(makeToken({ evtClaims: { iat: NOW - 3600 } }), NONCE), 'expired'));
+test('rejects sd_hash mismatch', () => rejects(makeVerifier().verify(makeToken({ kbClaims: { sd_hash: 'x' } }), NONCE), 'bad_claims'));
+test('rejects email_verified != true', () => rejects(makeVerifier().verify(makeToken({ evtClaims: { email_verified: 'true' } }), NONCE), 'bad_claims'));
+test('rejects polymorphic EdDSA', () => rejects(makeVerifier().verify(makeToken({ evtHeader: { alg: 'EdDSA' } }), NONCE), 'bad_alg'));
+test('rejects KB alg differing from cnf.jwk alg', () => rejects(makeVerifier().verify(makeToken({ kbHeader: { alg: 'Ed25519' } }), NONCE), 'bad_alg'));
+test('rejects wrong typ', () => rejects(makeVerifier().verify(makeToken({ evtHeader: { typ: 'JWT' } }), NONCE), 'bad_claims'));
+
+test('rejects an EVT forged by a key that is not the issuer\'s', () => {
+  const rogue = crypto.generateKeyPairSync('ed25519').privateKey;
+  return rejects(makeVerifier().verify(makeToken({ issuerKey: rogue }), NONCE), 'bad_signature');
+});
+
+test('rejects an issuer the email domain does not delegate to', () =>
+  rejects(makeVerifier().verify(makeToken({ evtClaims: { iss: 'https://evil-issuer.example' } }), NONCE), 'bad_issuer'));
+
+test('rejects when DNS has no or multiple issuer records', async () => {
+  await rejects(makeVerifier({ txt: [] }).verify(makeToken(), NONCE), 'no_issuer');
+  await rejects(makeVerifier({ txt: [['iss=a.example'], ['iss=b.example']] }).verify(makeToken(), NONCE), 'no_issuer');
+  await rejects(makeVerifier({ txt: [['iss=127.0.0.1']] }).verify(makeToken(), NONCE), 'no_issuer');
+});
+
+test('rejects metadata whose issuer does not match', () =>
+  rejects(makeVerifier({ meta: { issuer: 'https://other.example' } }).verify(makeToken(), NONCE), 'issuer_bad_metadata'));
+
+test('rejects a tampered email claim', () => {
+  const [evt, kb] = makeToken().split('~');
+  const [h, , s] = evt.split('.');
+  const forged = `${h}.${b64({ iss: ISSUER, iat: NOW, cnf: { jwk: browserJwk }, email: 'mallory@mail.example', email_verified: true })}.${s}`;
+  return rejects(makeVerifier().verify(`${forged}~${kb}`, NONCE), 'bad_claims'); // sd_hash breaks first
+});
+
+test('rejects tokens with selective disclosures or bad shape', async () => {
+  await rejects(makeVerifier().verify('a.b.c~d~e.f.g', NONCE), 'malformed');
+  await rejects(makeVerifier().verify('garbage', NONCE), 'malformed');
+});
