index 0000000..249190b
--- /dev/null
+++ b/server/evp.mjs
@@ -0,0 +1,156 @@
+// Email Verification Protocol (EVP) relying-party verification.
+//
+// The browser submits `EVT~KB-JWT` (an SD-JWT presentation) in the hidden
+// `autocomplete="email-verification-token"` input. This module verifies the
+// whole cryptographic chain on the server:
+//   1. the issuer is delegated by the email domain's `_email-verification` TXT record
+//   2. the EVT is signed by that issuer's published JWKS and is fresh
+//   3. the KB-JWT is signed by the browser key in `cnf.jwk`, bound to our origin
+//      (`aud`), our single-use session nonce, and the exact EVT (`sd_hash`)
+//   4. the verified `email` matches what the customer typed and `email_verified === true`
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync, getClaimsSync } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers and Chrome Origin Trial builds finish
+// transitioning from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+const MAX_TOKEN_LENGTH = 16 * 1024;
+const NETWORK_TIMEOUT_MS = 5000;
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// Reuse JWKS fetchers across requests so jose can cache keys per issuer.
+const jwksCache = new Map();
+function getRemoteJwks(jwksUri) {
+  let jwks = jwksCache.get(jwksUri);
+  if (!jwks) {
+    jwks = createRemoteJWKSet(new URL(jwksUri), { timeoutDuration: NETWORK_TIMEOUT_MS });
+    jwksCache.set(jwksUri, jwks);
+  }
+  return jwks;
+}
+
+async function assertDnsDelegation(domain, iss) {
+  const records = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) => r.join(''));
+  const delegated = records.some(
+    (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss,
+  );
+  if (!delegated) throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+}
+
+async function loadIssuerJwks(iss) {
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') throw new Error('Issuer must use HTTPS.');
+  const res = await fetch(discoveryUrl, {
+    redirect: 'error',
+    signal: AbortSignal.timeout(NETWORK_TIMEOUT_MS),
+  });
+  if (!res.ok) throw new Error(`Issuer metadata request failed (${res.status}).`);
+  const metadata = await res.json();
+  if (metadata.issuer !== iss || typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  return getRemoteJwks(metadata.jwks_uri);
+}
+
+/**
+ * Throws if the token does not prove ownership of `submittedEmail`.
+ * Resolves with the verified (lower-cased) email on success.
+ */
+export async function verifyEmailVerificationToken({ rawToken, submittedEmail, expectedNonce, expectedAudience }) {
+  if (!rawToken || rawToken.length > MAX_TOKEN_LENGTH) throw new Error('Missing or oversized token.');
+  if (!expectedNonce) throw new Error('No session nonce available.');
+
+  // Step 1: parse and pre-check claims before any network I/O.
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const claims = getClaimsSync(decoded.jwt.payload, decoded.disclosures ?? [], hasher);
+  const iss = decoded.jwt.payload?.iss;
+  if (!decoded.kbJwt || typeof iss !== 'string' || claims.email_verified !== true) {
+    throw new Error('Missing KB-JWT, issuer, or email_verified !== true.');
+  }
+  if (typeof claims.email !== 'string' || claims.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: DNS delegation, then issuer discovery + JWKS.
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  if (!domain) throw new Error('Submitted email has no domain.');
+  await assertDnsDelegation(domain, iss);
+  const issuerJwks = await loadIssuerJwks(iss);
+
+  // Step 3: EVT signature + KB-JWT holder binding.
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // Issuers such as Gmail omit `kid`; when several keys match, jose throws
+        // JWKSMultipleMatchingKeys, which is an async iterable of candidate keys.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = decoded.jwt.payload?.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header?.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  // Re-assert on the signature-verified claims (not just the pre-parsed ones).
+  const { email, email_verified: emailVerified } = verified.payload;
+  if (emailVerified !== true || typeof email !== 'string' || email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Verified claims do not match the submitted email.');
+  }
+  return email.toLowerCase();
+}
diff --git a/server/server.mjs b/server/server.mjs
new file mode 100644
index 0000000..cd44e29
--- /dev/null
+++ b/server/server.mjs
@@ -0,0 +1,263 @@
+// The Daily Grind web server.
+//
+//   GET  /                     homepage with the rewards sign-up form (fresh EVP nonce per render)
+//   POST /api/rewards/signup   creates the rewards account; verifies email ownership via the
+//                              Email Verification Protocol, falling back to an emailed code
+//
+// Environment:
+//   PORT                   listen port (default 11222)
+//   RP_ORIGIN              public origin of this site, used as the KB-JWT audience
+//                          (default http://localhost:$PORT)
+//   ORIGIN_TRIAL_TOKEN     Chrome Email Verification origin trial token for RP_ORIGIN
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes, randomInt, scrypt as scryptCb, timingSafeEqual } from 'node:crypto';
+import { promisify } from 'node:util';
+import { fileURLToPath } from 'node:url';
+import { verifyEmailVerificationToken } from './evp.mjs';
+
+const scrypt = promisify(scryptCb);
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ORIGIN = (process.env.RP_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const ORIGIN_TRIAL_TOKEN = process.env.ORIGIN_TRIAL_TOKEN || '';
+const SECURE_COOKIES = RP_ORIGIN.startsWith('https://');
+const SESSION_COOKIE = SECURE_COOKIES ? '__Host-dg_sid' : 'dg_sid';
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const MAX_BODY_BYTES = 64 * 1024;
+
+const TEMPLATE_PATH = fileURLToPath(new URL('../index.html', import.meta.url));
+const template = await readFile(TEMPLATE_PATH, 'utf8');
+
+// ---------------------------------------------------------------------------
+// In-memory stores. Swap for Redis / your database in production; the only
+// hard requirement is that consumeNonce() is an atomic read-and-delete.
+// ---------------------------------------------------------------------------
+const nonces = new Map(); // sessionId -> { nonce, expiresAt }
+const accounts = new Map(); // lower-cased email -> account
+const pendingCodes = new Map(); // lower-cased email -> { codeHash, expiresAt }
+
+function issueNonce(sessionId) {
+  const nonce = randomBytes(32).toString('base64url');
+  nonces.set(sessionId, { nonce, expiresAt: Date.now() + NONCE_TTL_MS });
+  return nonce;
+}
+
+function consumeNonce(sessionId) {
+  if (!sessionId) return null;
+  const entry = nonces.get(sessionId);
+  nonces.delete(sessionId);
+  if (!entry || entry.expiresAt < Date.now()) return null;
+  return entry.nonce;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [k, v] of nonces) if (v.expiresAt < now) nonces.delete(k);
+  for (const [k, v] of pendingCodes) if (v.expiresAt < now) pendingCodes.delete(k);
+}, 60_000).unref();
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim());
+  }
+  return out;
+}
+
+function sessionCookie(id) {
+  return `${SESSION_COOKIE}=${id}; Path=/; HttpOnly; SameSite=Lax${SECURE_COOKIES ? '; Secure' : ''}; Max-Age=86400`;
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+async function hashSecret(secret) {
+  const salt = randomBytes(16);
+  const key = await scrypt(secret, salt, 64);
+  return `${salt.toString('base64url')}.${key.toString('base64url')}`;
+}
+
+async function secretMatches(secret, stored) {
+  const [salt, key] = stored.split('.');
+  const actual = await scrypt(secret, Buffer.from(salt, 'base64url'), 64);
+  return timingSafeEqual(actual, Buffer.from(key, 'base64url'));
+}
+
+function baseHeaders(extra = {}) {
+  return {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'same-origin',
+    ...(ORIGIN_TRIAL_TOKEN ? { 'Origin-Trial': ORIGIN_TRIAL_TOKEN } : {}),
+    ...extra,
+  };
+}
+
+function resultPage({ title, heading, body, status = 200 }) {
+  return {
+    status,
+    html: `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fafafa; color: #3e2723; line-height: 1.6; margin: 0; }
+    main { max-width: 34rem; margin: 10vh auto; padding: 2rem; background: white; border-radius: 12px; box-shadow: 0 2px 10px rgb(0 0 0 / 0.1); }
+    h1 { color: #4e342e; margin-top: 0; }
+    a { color: #4e342e; font-weight: 600; }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>${escapeHtml(heading)}</h1>
+    ${body}
+    <p><a href="/">Back to The Daily Grind</a></p>
+  </main>
+</body>
+</html>`,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Rewards sign-up
+// ---------------------------------------------------------------------------
+async function sendTraditionalVerificationEmail(email) {
+  // Fallback only: used when the browser could not supply a valid Email
+  // Verification Token. Wire this to your transactional mail provider.
+  const code = String(randomInt(0, 1_000_000)).padStart(6, '0');
+  pendingCodes.set(email.toLowerCase(), { codeHash: await hashSecret(code), expiresAt: Date.now() + 15 * 60 * 1000 });
+  console.info(`[mailer stub] verification code for ${email}: ${code}`);
+}
+
+async function handleSignup(req, sessionId) {
+  // CSRF defence in depth (the session cookie is already SameSite=Lax).
+  const origin = req.headers.origin;
+  if (origin && origin !== RP_ORIGIN) {
+    return resultPage({ status: 403, title: 'Forbidden', heading: 'Request blocked', body: '<p>This form must be submitted from The Daily Grind website.</p>' });
+  }
+
+  const form = new URLSearchParams(await readBody(req));
+  const name = String(form.get('name') || '').trim().slice(0, 200);
+  const email = String(form.get('email') || '').trim();
+  const password = String(form.get('new-password') || '');
+  const rawToken = String(form.get('email-verification-token') || '').trim();
+  // Atomically consume the single-use nonce *before* any other work so a token can never be replayed.
+  const expectedNonce = consumeNonce(sessionId);
+
+  if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254 || password.length < 8) {
+    return resultPage({ status: 400, title: 'Check your details', heading: 'Please check your details', body: '<p>Enter your name, a valid email address and a password of at least 8 characters.</p>' });
+  }
+
+  const key = email.toLowerCase();
+  if (accounts.has(key)) {
+    // Don't reveal more than necessary; point the customer to sign in instead.
+    return resultPage({ status: 409, title: 'Account exists', heading: 'You may already be a member', body: '<p>If you already have a rewards account, sign in from <a href="/account">My Account</a>.</p>' });
+  }
+
+  let emailVerified = false;
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({ rawToken, submittedEmail: email, expectedNonce, expectedAudience: RP_ORIGIN });
+      emailVerified = true;
+    } catch (err) {
+      console.warn('Email verification token check failed:', err?.message || err);
+    }
+  }
+
+  accounts.set(key, {
+    id: randomBytes(16).toString('hex'),
+    name,
+    email,
+    passwordHash: await hashSecret(password),
+    emailVerified,
+    emailVerifiedVia: emailVerified ? 'email-verification-protocol' : null,
+    createdAt: new Date().toISOString(),
+  });
+
+  if (emailVerified) {
+    return resultPage({
+      status: 201,
+      title: 'Welcome to Rewards',
+      heading: `Welcome to Grind Rewards, ${name}!`,
+      body: `<p>Your email address <strong>${escapeHtml(email)}</strong> was confirmed instantly by your email provider, so there's no code to enter. Your first drink is on us.</p>`,
+    });
+  }
+
+  await sendTraditionalVerificationEmail(email);
+  return resultPage({
+    status: 202,
+    title: 'Confirm your email',
+    heading: 'Almost there: check your inbox',
+    body: `<p>We couldn't confirm <strong>${escapeHtml(email)}</strong> automatically in this browser, so we've sent a 6-digit code to that address. Enter it from <a href="/account">My Account</a> to activate your rewards.</p>`,
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Router
+// ---------------------------------------------------------------------------
+const server = createServer(async (req, res) => {
+  try {
+    const url = new URL(req.url, RP_ORIGIN);
+    let sessionId = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+    if (sessionId && !/^[A-Za-z0-9_-]{43}$/.test(sessionId)) sessionId = undefined;
+
+    if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+      const extra = {};
+      if (!sessionId) {
+        sessionId = randomBytes(32).toString('base64url');
+        extra['Set-Cookie'] = sessionCookie(sessionId);
+      }
+      const nonce = issueNonce(sessionId);
+      res.writeHead(200, baseHeaders(extra));
+      res.end(template.replaceAll('{{EVT_NONCE}}', escapeHtml(nonce)));
+      return;
+    }
+
+    if (url.pathname === '/api/rewards/signup') {
+      if (req.method !== 'POST') {
+        res.writeHead(405, baseHeaders({ Allow: 'POST' }));
+        res.end('Method Not Allowed');
+        return;
+      }
+      const { status, html } = await handleSignup(req, sessionId);
+      res.writeHead(status, baseHeaders());
+      res.end(html);
+      return;
+    }
+
+    const { status, html } = resultPage({ status: 404, title: 'Not found', heading: 'Page not found', body: '<p>That page has gone cold.</p>' });
+    res.writeHead(status, baseHeaders());
+    res.end(html);
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) res.writeHead(err?.status || 500, baseHeaders());
+    res.end(err?.status === 413 ? 'Payload too large' : 'Something went wrong');
+  }
+});
+
+server.listen(PORT, () => console.info(`The Daily Grind listening on ${RP_ORIGIN} (port ${PORT})`));
