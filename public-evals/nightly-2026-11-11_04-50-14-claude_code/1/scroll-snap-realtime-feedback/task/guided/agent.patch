+  <script type="module">
+    const carousel = document.querySelector('.gallery-carousel');
+    const track = document.getElementById('gallery');
+    const items = [...track.querySelectorAll('.gallery-item')];
+    const thumbsGroup = carousel.querySelector('.gallery-thumbs');
+    const thumbnails = [...thumbsGroup.querySelectorAll('button')];
+    const prevBtn = carousel.querySelector('[data-direction="previous"]');
+    const nextBtn = carousel.querySelector('[data-direction="next"]');
+    const status = carousel.querySelector('[role="status"]');
+
+    const supportsSnapEvents = 'onscrollsnapchanging' in Element.prototype;
+    const supportsScrollEnd = 'onscrollend' in window;
+
+    let activeIndex = -1;
+    let pendingIndex = -1;
+    // Target of a click-initiated scroll that hasn't settled yet.
+    let clickTarget = null;
+
+    // Nearest slide to the track's center (slides use scroll-snap-align: center).
+    const findClosestItemIndex = () => {
+      const center = track.scrollLeft + track.clientWidth / 2;
+      let closest = 0;
+      let min = Infinity;
+      items.forEach((item, i) => {
+        const d = Math.abs(center - (item.offsetLeft + item.offsetWidth / 2));
+        if (d < min) { min = d; closest = i; }
+      });
+      return closest;
+    };
+
+    const setPending = (index) => {
+      if (index < 0 || index === pendingIndex) return;
+      pendingIndex = index;
+      thumbnails.forEach((t, i) => t.classList.toggle('pending', i === index));
+    };
+
+    const clearPending = () => {
+      pendingIndex = -1;
+      thumbnails.forEach((t) => t.classList.remove('pending'));
+    };
+
+    const setActive = (index, { announce = true } = {}) => {
+      if (index < 0) return;
+      clearPending();
+      if (index === activeIndex) return;
+      activeIndex = index;
+      thumbnails.forEach((t, i) => {
+        const on = i === index;
+        t.classList.toggle('active', on);
+        if (on) t.setAttribute('aria-current', 'true');
+        else t.removeAttribute('aria-current');
+      });
+      if (announce) {
+        const caption = items[index].querySelector('figcaption')?.textContent ?? '';
+        status.textContent = `Photo ${index + 1} of ${items.length}: ${caption}`;
+      }
+    };
+
+    const updateButtons = () => {
+      const i = findClosestItemIndex();
+      prevBtn.disabled = i === 0;
+      nextBtn.disabled = i === items.length - 1;
+    };
+
+    const scrollToItem = (index) => {
+      const item = items[index];
+      if (!item) return;
+      clickTarget = index;
+      setPending(index); // reflect the decision immediately
+      const left = item.offsetLeft - (track.clientWidth - item.offsetWidth) / 2;
+      // Smoothness comes from CSS scroll-behavior (reduced-motion aware).
+      track.scrollTo({ left });
+    };
+
+    // Runs once per settled scroll (scrollend, or debounced scroll fallback).
+    const onSettle = () => {
+      clickTarget = null;
+      if (!supportsSnapEvents) {
+        setActive(findClosestItemIndex());
+      } else {
+        // scrollsnapchange won't fire if the user returned to the same
+        // target, so make sure no stale pending marker remains.
+        clearPending();
+      }
+      updateButtons();
+    };
+
+    if (supportsSnapEvents) {
+      track.addEventListener('scrollsnapchanging', (e) => {
+        setPending(items.indexOf(e.snapTargetInline));
+      });
+      track.addEventListener('scrollsnapchange', (e) => {
+        setActive(items.indexOf(e.snapTargetInline));
+      });
+    } else {
+      // Fallback: emulate scrollsnapchanging with geometry, once per frame.
+      let rafId = 0;
+      track.addEventListener('scroll', () => {
+        if (rafId || clickTarget !== null) return;
+        rafId = requestAnimationFrame(() => {
+          rafId = 0;
+          setPending(findClosestItemIndex());
+        });
+      }, { passive: true });
+    }
+
+    if (supportsScrollEnd) {
+      track.addEventListener('scrollend', onSettle);
+    } else {
+      let settleTimer;
+      track.addEventListener('scroll', () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(onSettle, 120);
+      }, { passive: true });
+    }
+
+    thumbnails.forEach((thumb, i) => {
+      thumb.addEventListener('click', () => scrollToItem(i));
+    });
+
+    const step = (dir) => {
+      const from = clickTarget ?? findClosestItemIndex();
+      const to = Math.min(items.length - 1, Math.max(0, from + dir));
+      if (to !== from) scrollToItem(to);
+    };
+    prevBtn.addEventListener('click', () => step(-1));
+    nextBtn.addEventListener('click', () => step(1));
+
+    // Initial sync (covers restored scroll positions); stays silent.
+    const init = () => {
+      setActive(findClosestItemIndex(), { announce: false });
+      updateButtons();
+    };
+    if (document.readyState === 'complete') init();
+    else window.addEventListener('load', init, { once: true });
+
+    // Roving tabindex for thumbnails where native focusgroup is unavailable.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      thumbsGroup.setAttribute('role', 'toolbar');
+      const syncTabIndex = () => {
+        let current = thumbnails.indexOf(document.activeElement);
+        if (current < 0) current = Math.max(0, activeIndex);
+        thumbnails.forEach((t, i) => { t.tabIndex = i === current ? 0 : -1; });
+      };
+      thumbsGroup.addEventListener('focusin', syncTabIndex);
+      thumbsGroup.addEventListener('keydown', (e) => {
+        if (!['ArrowLeft', 'ArrowRight'].includes(e.key)) return;
+        const current = thumbnails.indexOf(document.activeElement);
+        if (current < 0) return;
+        const next = (current + (e.key === 'ArrowLeft' ? -1 : 1) + thumbnails.length) % thumbnails.length;
+        e.preventDefault();
+        thumbnails.forEach((t, i) => { t.tabIndex = i === next ? 0 : -1; });
+        thumbnails[next].focus({ preventScroll: true });
+      }, true);
+      syncTabIndex();
+      // Keep the tab stop on the active thumbnail when focus is elsewhere.
+      track.addEventListener('scrollend', () => {
+        if (!thumbsGroup.contains(document.activeElement)) syncTabIndex();
+      });
+    }
+  </script>
