+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+      const slides = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.gallery-thumb'));
+      if (!slides.length) return;
+
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const supportsSnapEvents = 'onscrollsnapchange' in window && 'onscrollsnapchanging' in window;
+      const supportsScrollEnd = 'onscrollend' in window;
+
+      let activeIndex = 0;
+      let pendingIndex = -1;
+      let settleTimer = null;
+
+      // Nearest slide to the scroller's center (used for fallback detection and verification).
+      function nearestIndex() {
+        const center = gallery.scrollLeft + gallery.clientWidth / 2;
+        let best = 0;
+        let bestDist = Infinity;
+        slides.forEach(function (slide, i) {
+          const mid = slide.offsetLeft - gallery.offsetLeft + slide.offsetWidth / 2;
+          const dist = Math.abs(mid - center);
+          if (dist < bestDist) { bestDist = dist; best = i; }
+        });
+        return best;
+      }
+
+      function setPending(index) {
+        if (index === pendingIndex) return;
+        if (pendingIndex >= 0 && thumbs[pendingIndex]) thumbs[pendingIndex].classList.remove('pending');
+        pendingIndex = index === activeIndex ? -1 : index;
+        if (pendingIndex >= 0 && thumbs[pendingIndex]) thumbs[pendingIndex].classList.add('pending');
+      }
+
+      function setActive(index) {
+        setPending(-1);
+        if (index < 0 || index >= slides.length) return;
+        thumbs.forEach(function (thumb, i) {
+          const on = i === index;
+          thumb.classList.toggle('active', on);
+          thumb.classList.remove('pending');
+          if (on) thumb.setAttribute('aria-current', 'true');
+          else thumb.removeAttribute('aria-current');
+        });
+        slides.forEach(function (slide, i) {
+          slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
+        });
+        activeIndex = index;
+        pendingIndex = -1;
+      }
+
+      function settle() {
+        clearTimeout(settleTimer);
+        settleTimer = null;
+        setActive(nearestIndex());
+      }
+
+      function goTo(index) {
+        index = Math.max(0, Math.min(slides.length - 1, index));
+        setPending(index);
+        const slide = slides[index];
+        gallery.scrollTo({
+          left: slide.offsetLeft - gallery.offsetLeft - (gallery.clientWidth - slide.offsetWidth) / 2,
+          behavior: reduceMotion.matches ? 'auto' : 'smooth'
+        });
+        // If no scrolling is required (already there), settle right away.
+        if (Math.abs(gallery.scrollLeft - (slide.offsetLeft - gallery.offsetLeft)) < 1) settle();
+      }
+
+      if (supportsSnapEvents) {
+        // Native: preview the snap target while scrolling, promote when the snap settles.
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          const i = slides.indexOf(e.snapTargetInline);
+          if (i >= 0) setPending(i);
+        });
+        gallery.addEventListener('scrollsnapchange', function (e) {
+          const i = slides.indexOf(e.snapTargetInline);
+          setActive(i >= 0 ? i : nearestIndex());
+        });
+        // Safety net: if a scroll ends without a snapchange (e.g. returned to same target), clear pending.
+        if (supportsScrollEnd) {
+          gallery.addEventListener('scrollend', function () {
+            if (pendingIndex >= 0) settle();
+          });
+        }
+      } else {
+        // Fallback: derive pending from geometry during scroll, promote on scrollend / debounce.
+        gallery.addEventListener('scroll', function () {
+          setPending(nearestIndex());
+          if (!supportsScrollEnd) {
+            clearTimeout(settleTimer);
+            settleTimer = setTimeout(settle, 150);
+          }
+        }, { passive: true });
+        if (supportsScrollEnd) gallery.addEventListener('scrollend', settle);
+      }
+
+      thumbs.forEach(function (thumb) {
+        thumb.addEventListener('click', function () {
+          goTo(Number(thumb.dataset.index));
+        });
+      });
+
+      gallery.addEventListener('keydown', function (e) {
+        const base = pendingIndex >= 0 ? pendingIndex : activeIndex;
+        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(base + 1); }
+        else if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(base - 1); }
+        else if (e.key === 'Home') { e.preventDefault(); goTo(0); }
+        else if (e.key === 'End') { e.preventDefault(); goTo(slides.length - 1); }
+      });
+
+      // Keep the active slide aligned on resize.
+      window.addEventListener('resize', function () {
+        const slide = slides[activeIndex];
+        gallery.scrollTo({ left: slide.offsetLeft - gallery.offsetLeft, behavior: 'auto' });
+      });
+
+      setActive(nearestIndex());
+    })();
+  </script>
+
