     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    /*
+     * Menu catalog used by the "get_menu_item_details" WebMCP tool.
+     * Keep in sync with the cards shown on the page.
+     */
+    const MENU_ITEMS = [
+      {
+        id: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        category: 'Seasonal',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        sizes: [
+          { size: 'Small (12 oz)', price: 4.75 },
+          { size: 'Medium (16 oz)', price: 5.25 },
+          { size: 'Large (20 oz)', price: 5.75 }
+        ],
+        calories: 210,
+        caffeineMg: 150,
+        ingredients: ['Espresso', 'Oat milk', 'Vermont maple syrup'],
+        allergens: ['Oats (may contain gluten)'],
+        dietary: ['Vegan', 'Dairy-free'],
+        servedHotOrIced: ['Hot', 'Iced'],
+        available: true,
+        url: '/menu/seasonal'
+      },
+      {
+        id: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        category: 'Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        sizes: [
+          { size: 'Single shot', price: 2.75 },
+          { size: 'Double shot', price: 3.50 }
+        ],
+        calories: 5,
+        caffeineMg: 75,
+        ingredients: ['Dark roast espresso beans'],
+        allergens: [],
+        dietary: ['Vegan', 'Dairy-free', 'Gluten-free', 'Sugar-free'],
+        servedHotOrIced: ['Hot'],
+        available: true,
+        url: '/menu/espresso'
+      },
+      {
+        id: 'cold-brew',
+        name: 'Cold Brew',
+        category: 'Cold Coffee',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        sizes: [
+          { size: 'Medium (16 oz)', price: 4.50 },
+          { size: 'Large (20 oz)', price: 5.00 }
+        ],
+        calories: 10,
+        caffeineMg: 200,
+        ingredients: ['Cold-steeped coffee', 'Filtered water', 'Ice'],
+        allergens: [],
+        dietary: ['Vegan', 'Dairy-free', 'Gluten-free', 'Sugar-free'],
+        servedHotOrIced: ['Iced'],
+        available: true,
+        url: '/menu/cold-brew'
+      }
+    ];
+
+    const normalize = (str) =>
+      String(str).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
+
+    /** Find a menu item by name: exact match first, then partial match. */
+    function findMenuItem(name) {
+      const query = normalize(name);
+      if (!query) return null;
+      return (
+        MENU_ITEMS.find((item) => normalize(item.name) === query || item.id === query.replace(/ /g, '-')) ||
+        MENU_ITEMS.find((item) => normalize(item.name).includes(query) || query.includes(normalize(item.name))) ||
+        null
+      );
+    }
+
+    const textResult = (data, isError = false) => ({
+      content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }],
+      ...(isError ? { isError: true } : {})
+    });
+
+    const menuItemTool = {
+      name: 'get_menu_item_details',
+      description:
+        'Look up full details for a single item on The Daily Grind coffee menu by its name. ' +
+        'Returns the description, category, sizes and prices (USD), calories, caffeine content, ' +
+        'ingredients, allergens, dietary tags, hot/iced availability, and a link to the item page. ' +
+        'Use this whenever the user asks about a specific drink (e.g. "Maple Oat Latte", ' +
+        '"Dark Roast Espresso", "Cold Brew"). Matching is case-insensitive and accepts partial names.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          name: {
+            type: 'string',
+            description:
+              'The name of the menu item to look up, e.g. "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew". ' +
+              'Case-insensitive; partial names such as "maple latte" or "cold brew" are accepted.'
+          }
+        },
+        required: ['name'],
+        additionalProperties: false
+      },
+      annotations: { readOnlyHint: true },
+      async execute({ name } = {}) {
+        if (typeof name !== 'string' || !name.trim()) {
+          return textResult('Error: "name" is required and must be a non-empty string.', true);
+        }
+        const item = findMenuItem(name);
+        if (!item) {
+          return textResult(
+            `No menu item found matching "${name}". Available items: ${MENU_ITEMS.map((i) => i.name).join(', ')}.`,
+            true
+          );
+        }
+        return textResult({ ...item, url: new URL(item.url, location.origin).href });
+      }
+    };
+
+    /*
+     * Registration / cleanup for the WebMCP tool.
+     * Supports the AbortSignal-based API as well as older variants that return
+     * a registration handle with unregister() or expose unregisterTool(name).
+     */
+    let toolRegistration = null;
+
+    function registerMenuTool() {
+      const modelContext = navigator.modelContext;
+      if (!modelContext || typeof modelContext.registerTool !== 'function' || toolRegistration) return;
+
+      const controller = new AbortController();
+      try {
+        const handle = modelContext.registerTool(menuItemTool, { signal: controller.signal });
+        toolRegistration = { controller, handle };
+      } catch (err) {
+        console.warn('Failed to register WebMCP tool "get_menu_item_details":', err);
+      }
+    }
+
+    function unregisterMenuTool() {
+      if (!toolRegistration) return;
+      const { controller, handle } = toolRegistration;
+      toolRegistration = null;
+      try {
+        controller.abort();
+        if (handle && typeof handle.unregister === 'function') {
+          handle.unregister();
+        } else if (typeof navigator.modelContext?.unregisterTool === 'function') {
+          navigator.modelContext.unregisterTool(menuItemTool.name);
+        }
+      } catch (err) {
+        // Already unregistered (e.g. via the abort signal) — safe to ignore.
+      }
+    }
+
+    registerMenuTool();
+
+    // Clean up when the page is unloaded or put into the back/forward cache,
+    // and re-register if it is restored from the bfcache.
+    window.addEventListener('pagehide', unregisterMenuTool);
+    window.addEventListener('pageshow', (event) => {
+      if (event.persisted) registerMenuTool();
+    });
+  </script>
+
 </body>
 
 </html>
