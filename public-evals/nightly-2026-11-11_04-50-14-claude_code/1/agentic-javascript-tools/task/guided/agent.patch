@@ -206,7 +206,134 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // Menu data the agent tool reads from. Kept in sync with the cards above.
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        price: { currency: "USD", small: 5.25, medium: 5.75, large: 6.25 },
+        caffeine: "Medium (double shot of espresso)",
+        ingredients: ["Espresso", "Oat milk", "Vermont maple syrup"],
+        dietary: ["Vegan", "Dairy-free"],
+        allergens: ["Oats (may contain gluten)"],
+        calories: { medium: 190 },
+        temperature: ["Hot", "Iced"],
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        price: { currency: "USD", single: 2.75, double: 3.5 },
+        caffeine: "High (about 75 mg per shot)",
+        ingredients: ["Locally roasted dark roast espresso beans"],
+        dietary: ["Vegan", "Dairy-free", "Gluten-free"],
+        allergens: [],
+        calories: { double: 5 },
+        temperature: ["Hot"],
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Coffee",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        price: { currency: "USD", small: 4.25, medium: 4.75, large: 5.25 },
+        caffeine: "High (about 200 mg per medium)",
+        ingredients: ["Coarse-ground coffee", "Filtered water", "Ice"],
+        dietary: ["Vegan", "Dairy-free", "Gluten-free"],
+        allergens: [],
+        calories: { medium: 5 },
+        temperature: ["Iced"],
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    // Lowercase and strip punctuation/extra spaces so "maple-oat latte" matches.
+    const normalize = (value) =>
+      value.toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
+
+    function findMenuItem(itemName) {
+      const query = normalize(itemName);
+      return (
+        MENU_ITEMS.find((item) => normalize(item.name) === query) ??
+        MENU_ITEMS.find((item) => {
+          const name = normalize(item.name);
+          return name.includes(query) || query.includes(name);
+        })
+      );
+    }
+
+    const getMenuItemDetailsTool = {
+      name: "get_menu_item_details",
+      description:
+        "Looks up full details for a drink on The Daily Grind menu, including description, prices, caffeine level, ingredients, dietary info, and allergens. Use when the user asks about a specific menu item.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          itemName: {
+            type: "string",
+            description:
+              "Name of the menu item as the user said it, for example \"maple oat latte\" or \"cold brew\". Matching ignores capitalization and punctuation.",
+          },
+        },
+        required: ["itemName"],
+      },
+      execute({ itemName } = {}) {
+        // The browser doesn't validate against inputSchema, so check here and
+        // return errors as values so the agent can read them and retry.
+        if (typeof itemName !== "string" || !itemName.trim()) {
+          return {
+            error: "Provide the name of a menu item to look up.",
+            availableItems: MENU_ITEMS.map((item) => item.name),
+          };
+        }
+        const item = findMenuItem(itemName);
+        if (!item) {
+          return {
+            error: `Menu item "${itemName}" not found.`,
+            availableItems: MENU_ITEMS.map((item) => item.name),
+          };
+        }
+        return item;
+      },
+      annotations: { readOnlyHint: true },
+    };
+
+    // WebMCP has no unregisterTool(); aborting the registration signal removes the tool.
+    let registration = null;
+
+    async function registerMenuTools() {
+      if (!("modelContext" in document) || registration) return;
+      registration = new AbortController();
+      try {
+        await document.modelContext.registerTool(getMenuItemDetailsTool, {
+          signal: registration.signal,
+        });
+      } catch (err) {
+        registration = null;
+        console.warn("Failed to register WebMCP menu tool:", err);
+      }
+    }
+
+    function unregisterMenuTools() {
+      registration?.abort();
+      registration = null;
+    }
+
+    registerMenuTools();
+
+    // Clean up when the page is unloaded. `pagehide` fires reliably on navigation,
+    // tab close, and bfcache entry (unlike `unload`, which also blocks bfcache).
+    window.addEventListener("pagehide", unregisterMenuTools);
+    // Re-register if the page is restored from the back/forward cache.
+    window.addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
+
 </body>
 
 </html>
