+
+  <script type="module">
+    // Interest invokers: each "View Details" button declares interestfor="seasonal-preview"
+    // in HTML, so only the single preview target needs interest/loseinterest handling.
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    const preview = document.getElementById("seasonal-preview");
+    const text = preview.querySelector("[data-preview-text]");
+    const accent = preview.querySelector("[data-preview-accent]");
+    const DEFAULT_TEXT = "Select a drink to preview";
+
+    preview.addEventListener("interest", (event) => {
+      const { drink, accent: color, accentName } = event.source.dataset;
+      text.textContent = drink;
+      accent.textContent = `Accent color: ${accentName} (${color})`;
+      accent.hidden = false;
+      preview.style.setProperty("--preview-accent", color);
+    });
+
+    preview.addEventListener("loseinterest", () => {
+      text.textContent = DEFAULT_TEXT;
+      accent.textContent = "";
+      accent.hidden = true;
+      preview.style.removeProperty("--preview-accent");
+    });
+  </script>
