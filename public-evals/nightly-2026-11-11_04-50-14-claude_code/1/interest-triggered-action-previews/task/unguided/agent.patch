+  <script>
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const nameEl = preview.querySelector('.preview-name');
+      const accentEl = preview.querySelector('.preview-accent');
+      const DEFAULT_TEXT = 'Select a drink to preview';
+      let current = null;
+
+      const show = (source) => {
+        if (!source || !source.dataset.drink) return;
+        current = source;
+        nameEl.textContent = source.dataset.drink;
+        accentEl.textContent = source.dataset.accent
+          ? `Accent: ${source.dataset.accentName || source.dataset.accent} (${source.dataset.accent})`
+          : '';
+        preview.style.setProperty('--preview-accent', source.dataset.accent || '');
+      };
+
+      const reset = (source) => {
+        if (source && current && source !== current) return;
+        current = null;
+        nameEl.textContent = DEFAULT_TEXT;
+        accentEl.textContent = '';
+        preview.style.removeProperty('--preview-accent');
+      };
+
+      // Interest invokers: buttons declare interestfor="seasonal-preview", and the
+      // browser fires interest / loseinterest on this single target element.
+      preview.addEventListener('interest', (e) => show(e.source));
+      preview.addEventListener('loseinterest', (e) => reset(e.source));
+
+      // Fallback for browsers without interest invoker support: one delegated
+      // set of listeners, driven by the same declarative interestfor attribute.
+      if (!('interestForElement' in HTMLAnchorElement.prototype)) {
+        const invokerFor = (node) =>
+          node instanceof Element ? node.closest('[interestfor="seasonal-preview"]') : null;
+        const onEnter = (e) => {
+          const src = invokerFor(e.target);
+          if (src && !src.contains(e.relatedTarget)) show(src);
+        };
+        const onLeave = (e) => {
+          const src = invokerFor(e.target);
+          if (src && !src.contains(e.relatedTarget)) reset(src);
+        };
+        document.addEventListener('mouseover', onEnter);
+        document.addEventListener('mouseout', onLeave);
+        document.addEventListener('focusin', onEnter);
+        document.addEventListener('focusout', onLeave);
+      }
+    })();
+  </script>
+
