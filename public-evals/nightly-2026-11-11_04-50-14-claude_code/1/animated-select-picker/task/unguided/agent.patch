+    /* Store picker */
+    .store-picker {
+      margin-top: 1.25rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+    }
+
+    .store-picker label {
+      font-size: 0.85rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      opacity: 0.85;
+    }
+
+    .store-select {
+      min-width: 260px;
+      padding: 10px 14px;
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Customizable native select (appearance: base-select) */
+    @supports (appearance: base-select) {
+
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select {
+        display: flex;
+        justify-content: space-between;
+        align-items: center;
+        gap: 12px;
+        text-align: left;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.3s ease;
+      }
+
+      .store-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .store-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        border: none;
+        border-radius: 8px;
+        background: var(--light);
+        color: var(--text);
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+        opacity: 0;
+        transform: translateY(-8px);
+        transition:
+          opacity 0.25s ease,
+          transform 0.25s ease,
+          display 0.25s allow-discrete,
+          overlay 0.25s allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+        transform: translateY(0);
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+          transform: translateY(-8px);
+        }
+      }
+
+      .store-select option {
+        padding: 8px 12px;
+        border-radius: 4px;
+        transition: background 0.2s;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        font-weight: bold;
+      }
+
+      .store-select option::checkmark {
+        color: var(--accent);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .store-select::picker-icon,
+      .store-select::picker(select) {
+        transition: none;
+      }
+    }
