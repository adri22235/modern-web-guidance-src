+/**
+ * Responsive `srcset`/`sizes` props for `<Image>`.
+ * Remote URLs that are not in `image.domains` are passed through unoptimized by Astro,
+ * so generating a srcset for them would only repeat the same URL — skip it.
+ */
+export function responsiveImageProps(
+    image: ImageMetadata | string,
+    widths: number[],
+    sizes: string,
+): { widths?: number[]; sizes?: string } {
+    return typeof image === 'string' ? {} : { widths, sizes };
+}
+
+/** Shared `sizes` hints derived from the layout (max content width is 72rem / 1152px). */
+export const IMAGE_SIZES = {
+    /** Card in a 3-column grid from `md` up. */
+    card: '(min-width: 1152px) 352px, (min-width: 768px) calc((100vw - 96px) / 3), calc(100vw - 32px)',
+    /** Card in a 2-column (md) / 3-column (lg) grid. */
+    cardCategory: '(min-width: 1152px) 341px, (min-width: 1024px) calc((100vw - 112px) / 3), (min-width: 768px) calc((100vw - 64px) / 2), calc(100vw - 32px)',
+    /** Two-thirds column of the lead story. */
+    lead: '(min-width: 1152px) 693px, (min-width: 1024px) calc((100vw - 128px) * 2 / 3), (min-width: 768px) calc(100vw - 112px), calc(100vw - 80px)',
+    /** Half-width column of a top story block. */
+    half: '(min-width: 1152px) 552px, (min-width: 1024px) calc((100vw - 48px) / 2), (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)',
+    /** Article body width (max-w-3xl minus padding). */
+    article: '(min-width: 768px) 736px, calc(100vw - 32px)',
+    /** Full content width. */
+    full: '(min-width: 1152px) 1104px, (min-width: 768px) calc(100vw - 48px), calc(100vw - 32px)',
+} as const;
