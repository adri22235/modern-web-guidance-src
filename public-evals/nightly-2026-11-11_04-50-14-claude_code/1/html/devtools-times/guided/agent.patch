diff --git a/src/components/useModalDialog.ts b/src/components/useModalDialog.ts
new file mode 100644
index 0000000..13ddeea
--- /dev/null
+++ b/src/components/useModalDialog.ts
@@ -0,0 +1,51 @@
+import { useEffect, useRef } from 'react';
+
+const isOutside = (event: PointerEvent, dialog: HTMLDialogElement) => {
+  const r = dialog.getBoundingClientRect();
+  return event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom;
+};
+
+/**
+ * Opens a native `<dialog>` as a modal as soon as it mounts and reports when it closes.
+ *
+ * The browser provides focus containment, an inert page, Esc / back-gesture dismissal and
+ * focus return to the invoker. Light dismiss comes from `closedby="any"` on the dialog; a small
+ * pointer-based fallback covers browsers without `closedby` support.
+ */
+export function useModalDialog(onClose: () => void) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+
+    const handleClose = () => onCloseRef.current();
+    dialog.addEventListener('close', handleClose);
+
+    let cleanupFallback = () => {};
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      let pressedOutside = false;
+      const onPointerDown = (e: PointerEvent) => { pressedOutside = isOutside(e, dialog); };
+      // Require press and release outside, so a text-selection drag ending on the backdrop doesn't dismiss.
+      const onPointerUp = (e: PointerEvent) => { if (pressedOutside && isOutside(e, dialog)) dialog.close(); };
+      dialog.addEventListener('pointerdown', onPointerDown);
+      dialog.addEventListener('pointerup', onPointerUp);
+      cleanupFallback = () => {
+        dialog.removeEventListener('pointerdown', onPointerDown);
+        dialog.removeEventListener('pointerup', onPointerUp);
+      };
+    }
+
+    if (!dialog.open) dialog.showModal();
+
+    return () => {
+      dialog.removeEventListener('close', handleClose);
+      cleanupFallback();
+      if (dialog.open) dialog.close();
+    };
+  }, []);
+
+  return dialogRef;
+}
