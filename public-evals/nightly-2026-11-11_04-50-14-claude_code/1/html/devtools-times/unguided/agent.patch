diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..a73efe9
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,78 @@
+import React, { useEffect, useId, useRef } from 'react';
+
+interface Props {
+  /** Visible dialog title, also used as the accessible name. */
+  title: string;
+  onClose: () => void;
+  children: React.ReactNode;
+  className?: string;
+}
+
+/**
+ * Thin wrapper around the native `<dialog>` element opened with `showModal()`.
+ *
+ * The browser provides: top-layer rendering, an inert background, focus
+ * trapping, Esc to close, initial focus (an element marked `data-autofocus`), and
+ * restoring focus to the previously focused element (the trigger) on close.
+ * The component is mounted while open and unmounted after `onClose`.
+ */
+export default function Modal({ title, onClose, children, className = '' }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const titleId = useId();
+
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (!dialog.open) {
+      dialog.showModal();
+      // React implements `autoFocus` by calling focus() at mount time, before
+      // the dialog is shown, so move focus to the preferred element explicitly.
+      dialog.querySelector<HTMLElement>('[data-autofocus]')?.focus();
+    }
+    const handleClose = () => onCloseRef.current();
+    dialog.addEventListener('close', handleClose);
+    return () => {
+      dialog.removeEventListener('close', handleClose);
+      if (dialog.open) dialog.close();
+    };
+  }, []);
+
+  // Clicking the ::backdrop targets the <dialog> itself (content lives in an
+  // inner wrapper), so close on direct hits. `closedby="any"` does the same
+  // natively in browsers that support it.
+  const handleClick = (event: React.MouseEvent<HTMLDialogElement>) => {
+    if (event.target === event.currentTarget) {
+      event.currentTarget.close();
+    }
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby={titleId}
+      onClick={handleClick}
+      closedby="any"
+      className={`modal bg-transparent p-0 w-[calc(100%-2rem)] max-w-2xl ${className}`}
+    >
+      <div className="bg-white shadow-xl relative">
+        <h2 id={titleId} className="px-4 pt-4 text-lg font-semibold text-gray-800">{title}</h2>
+        {children}
+        {/* Last in DOM order so Tab reaches the content first; positioned visually top-right. */}
+        <form method="dialog">
+          <button
+            type="submit"
+            aria-label="Close"
+            className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-500 hover:scale-110 transition-transform z-10"
+          >
+            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+            </svg>
+          </button>
+        </form>
+      </div>
+    </dialog>
+  );
+}
