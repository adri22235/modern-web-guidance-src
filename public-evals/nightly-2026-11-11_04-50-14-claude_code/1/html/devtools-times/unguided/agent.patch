+/**
+ * Responsive image presets. `widths` drives the generated `srcset`, `sizes`
+ * tells the browser how wide the image is rendered at each breakpoint so it
+ * can pick the smallest adequate candidate. The page container is max-w-6xl
+ * (72rem / 1152px).
+ */
+export const imagePresets = {
+    /** One column of a 3-column grid (md:grid-cols-3). */
+    gridThird: {
+        widths: [320, 480, 640, 800],
+        sizes: '(min-width: 1152px) 352px, (min-width: 768px) calc((100vw - 5rem) / 3), calc(100vw - 2rem)',
