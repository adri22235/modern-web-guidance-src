+
+/* Visible keyboard focus everywhere, without showing rings on mouse clicks. */
+:focus-visible {
+  outline: 2px solid var(--color-amber-500);
+  outline-offset: 2px;
+}
+
+/* Native modal dialogs ------------------------------------------------- */
+dialog.modal {
+  /* Override UA centering so the overlay sits in the upper third, like before. */
+  margin: 15vh auto auto;
+  max-height: 80vh;
+  overflow: visible;
+}
+
+dialog.modal::backdrop {
+  background-color: rgb(255 255 255 / 0.3);
+  backdrop-filter: blur(4px);
+}
+
+/* Prevent the page behind a modal from scrolling. */
+html:has(dialog.modal[open]) {
+  overflow: hidden;
+}
+
+/* Navigation popover ---------------------------------------------------- */
+.nav-flyout[popover] {
+  /* Top-layer element: we position it ourselves under the nav bar. */
+  position: absolute;
+  inset: auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  dialog.modal[open],
+  .nav-flyout:popover-open {
+    animation: overlay-in 120ms ease-out;
+  }
+}
+
+@keyframes overlay-in {
+  from {
+    opacity: 0;
+    transform: translateY(-4px);
+  }
+}
