new file mode 100644
index 0000000..2efc9c3
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,175 @@
+import React, { useId, useState } from 'react';
+
+const API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+interface Props {
+  mode: 'signin' | 'signup';
+}
+
+const config = {
+  signin: {
+    title: 'Sign In',
+    endpoint: `${API_BASE}/login`,
+    submit: 'Sign In',
+    pending: 'Signing in...',
+    // Lets password managers fill saved credentials.
+    passwordAutocomplete: 'current-password',
+    errorPrefix: 'Login failed',
+    alternate: { prompt: 'New here?', label: 'Create an account', href: 'signup' },
+  },
+  signup: {
+    title: 'Sign Up',
+    endpoint: `${API_BASE}/register`,
+    submit: 'Sign Up',
+    pending: 'Signing up...',
+    // Lets password managers offer a generated strong password.
+    passwordAutocomplete: 'new-password',
+    errorPrefix: 'Registration failed',
+    alternate: { prompt: 'Already have an account?', label: 'Sign in', href: 'signin' },
+  },
+} as const;
+
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 user-invalid:border-red-500';
+
+export default function AuthForm({ mode }: Props) {
+  const c = config[mode];
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const id = useId();
+  const usernameId = `${id}-username`;
+  const passwordId = `${id}-password`;
+  const hintId = `${id}-password-hint`;
+  const titleId = `${id}-title`;
+
+  // Uncontrolled inputs + FormData: works with browser autofill (which may not
+  // fire React change events reliably) and keeps the markup a plain HTML form.
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const form = e.currentTarget;
+    const formData = new FormData(form);
+    const username = String(formData.get('username') ?? '');
+    const password = String(formData.get('password') ?? '');
+
+    setError(null);
+    setSuccess(null);
+    setLoading(true);
+
+    try {
+      const response = await fetch(c.endpoint, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({ username, password }),
+      });
+
+      const data = await response.json();
+
+      if (!response.ok) {
+        // TODO: Handle specific error codes (APP_ERR_1001, APP_ERR_2001, ...) properly.
+        // For now, we display a generic error message including the code.
+        setError(`${c.errorPrefix}: ${data.error || 'Unknown error'}`);
+      } else if (mode === 'signup') {
+        setSuccess('User registered successfully! You can now sign in.');
+        form.reset();
+      } else {
+        setSuccess('Login successful!');
+        // You might store the token here if needed, e.g., localStorage.setItem('token', data.token);
+      }
+    } catch (err) {
+      setError('An unexpected error occurred. Please try again later.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <section aria-labelledby={titleId} className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h1 id={titleId} className="text-2xl font-bold mb-6 text-center text-gray-800">{c.title}</h1>
+
+      <div aria-live="polite">
+        {error && (
+          <p className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </p>
+        )}
+        {success && (
+          <p className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+            {success}
+          </p>
+        )}
+      </div>
+
+      <form
+        method="post"
+        onSubmit={handleSubmit}
+        aria-labelledby={titleId}
+        aria-busy={loading}
+        className="space-y-4"
+      >
+        <div>
+          <label htmlFor={usernameId} className="block text-sm font-medium text-gray-700 mb-1">
+            Username
+          </label>
+          <input
+            type="text"
+            id={usernameId}
+            name="username"
+            autoComplete="username"
+            autoCapitalize="none"
+            autoCorrect="off"
+            spellCheck={false}
+            required
+            className={inputClass}
+          />
+        </div>
+
+        <div>
+          <label htmlFor={passwordId} className="block text-sm font-medium text-gray-700 mb-1">
+            Password
+          </label>
+          <input
+            type="password"
+            id={passwordId}
+            name="password"
+            autoComplete={c.passwordAutocomplete}
+            required
+            {...(mode === 'signup'
+              ? {
+                  minLength: 8,
+                  pattern: '(?=.*\\d).{8,}',
+                  title: 'At least 8 characters, including a number.',
+                  'aria-describedby': hintId,
+                  passwordrules: 'minlength: 8; required: digit;',
+                }
+              : {})}
+            className={inputClass}
+          />
+          {mode === 'signup' && (
+            <p id={hintId} className="text-xs text-gray-600 mt-1">
+              Must be at least 8 characters and contain a number.
+            </p>
+          )}
+        </div>
+
+        <button
+          type="submit"
+          disabled={loading}
+          data-skip-tracking={mode === 'signup' ? 'true' : undefined}
+          className="w-full py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75 disabled:cursor-not-allowed"
+        >
+          {loading ? c.pending : c.submit}
+        </button>
+      </form>
+
+      <p className="mt-6 text-center text-sm text-gray-600">
+        {c.alternate.prompt}{' '}
+        <a href={`${import.meta.env.BASE_URL}${c.alternate.href}`} className="font-semibold text-gray-900 underline hover:text-amber-700">
+          {c.alternate.label}
+        </a>
+      </p>
+    </section>
+  );
+}
