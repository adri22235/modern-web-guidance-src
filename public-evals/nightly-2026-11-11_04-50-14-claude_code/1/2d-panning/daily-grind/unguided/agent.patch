+        westside: { name: 'Westside Corner', address: '88 Westbrook Lane', hours: 'Mon–Sat · 7am – 6pm', img: 'https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=600&q=70' },
