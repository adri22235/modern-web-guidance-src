+  <script>
+    (() => {
+      const viewport = document.getElementById('cafe-map');
+      if (!viewport) return;
+
+      // Start centered on the downtown flagship.
+      const flagship = viewport.querySelector('[href="/locations/downtown"]');
+      if (flagship) {
+        viewport.scrollLeft = flagship.offsetLeft - viewport.clientWidth / 2;
+        viewport.scrollTop = flagship.offsetTop - viewport.clientHeight / 2;
+      }
+
+      // Native support handles free 2D panning on the compositor thread.
+      if (window.CSS && CSS.supports('scroll-axis-lock', 'none')) return;
+
+      // Fallback: wheel/trackpad and pointer events expose raw, unlocked
+      // 2D deltas, applied directly to scrollLeft/scrollTop.
+      viewport.addEventListener('wheel', (e) => {
+        if (e.ctrlKey) return; // let Ctrl+wheel / trackpad pinch zoom the page
+        e.preventDefault();
+        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? viewport.clientHeight : 1;
+        viewport.scrollLeft += e.deltaX * unit;
+        viewport.scrollTop += e.deltaY * unit;
+      }, { passive: false });
+
+      const DRAG_THRESHOLD = 4;
+      let start = null;
+      let last = null;
+      let dragging = false;
+      let suppressClick = false;
+
+      viewport.addEventListener('pointerdown', (e) => {
+        const rect = viewport.getBoundingClientRect();
+        // Ignore secondary buttons and presses on native scrollbars.
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - viewport.clientLeft >= viewport.clientWidth ||
+          e.clientY - rect.top - viewport.clientTop >= viewport.clientHeight
+        ) return;
+        start = last = { x: e.clientX, y: e.clientY, id: e.pointerId };
+        dragging = false;
+      });
+
+      viewport.addEventListener('pointermove', (e) => {
+        if (!start || e.pointerId !== start.id) return;
+        if (!dragging) {
+          if (Math.hypot(e.clientX - start.x, e.clientY - start.y) < DRAG_THRESHOLD) return;
+          // Only capture once it's a real drag so taps on pins still click.
+          dragging = true;
+          viewport.setPointerCapture(e.pointerId);
+          viewport.classList.add('is-panning');
+        }
+        viewport.scrollLeft -= e.clientX - last.x;
+        viewport.scrollTop -= e.clientY - last.y;
+        last = { x: e.clientX, y: e.clientY, id: e.pointerId };
+      });
+
+      const endPan = () => {
+        if (dragging) {
+          suppressClick = true;
+          // Any click from this drag fires before this task runs.
+          setTimeout(() => { suppressClick = false; }, 0);
+        }
+        start = last = null;
+        dragging = false;
+        viewport.classList.remove('is-panning');
+      };
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+
+      // Don't follow a pin link at the end of a drag.
+      viewport.addEventListener('click', (e) => {
+        if (suppressClick) {
+          e.preventDefault();
+          e.stopPropagation();
+        }
+        suppressClick = false;
+      }, true);
+
+      // Prevent native link/image dragging from hijacking the pan.
+      viewport.addEventListener('dragstart', (e) => e.preventDefault());
+    })();
+  </script>
+
