diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,104 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Visually Stable Mixed Fonts</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+    }
+
+    body {
+      margin: 0;
+      padding: 2rem;
+      font-family: system-ui, sans-serif;
+      line-height: 1.6;
+      max-width: 70ch;
+      margin-inline: auto;
+    }
+
+    h1, h2 {
+      line-height: 1.2;
+      text-wrap: balance;
+    }
+
+    section {
+      padding: 1.5rem;
+      border: 1px solid color-mix(in oklab, currentColor 25%, transparent);
+      border-radius: 0.75rem;
+      margin-block: 1.5rem;
+    }
+
+    code {
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in oklab, currentColor 10%, transparent);
+    }
+
+    /* 1. Mixed fonts: normalize x-height of inline code to the parent font automatically */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", serif;
+      font-size: 1.125rem;
+      /* Extract the x-height ratio from the primary font and apply it to descendants */
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: ui-monospace, "Courier New", Courier, monospace;
+      /* Inherits font-size-adjust (the resolved ratio) so code matches the serif's x-height */
+    }
+
+    /* 2. Independent theme: lock proportions with an explicit numeric metric */
+    #independent-theme-container {
+      font-family: "Times New Roman", Times, serif;
+      /* Numeric x-height / font-size ratio override (matches Verdana-like proportions) */
+      font-size-adjust: ex-height 0.545;
+    }
+
+    #independent-theme-container code {
+      font-family: ui-monospace, "Courier New", Courier, monospace;
+    }
+
+    /* Fallback for browsers without font-size-adjust support */
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container code {
+        font-size: 0.9em;
+      }
+    }
+
+    @supports not (font-size-adjust: 0.5) {
+      #independent-theme-container {
+        font-size: 1.1rem;
+        line-height: 1.65;
+      }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Visually Stable Mixed Fonts</h1>
+
+    <section id="mixed-fonts-container" aria-labelledby="mixed-heading">
+      <h2 id="mixed-heading">Mixed font families</h2>
+      <p>
+        This paragraph is set in a serif typeface, yet inline snippets such as
+        <code>font-size-adjust: from-font</code> or <code>document.querySelector()</code>
+        use a monospace font. Thanks to <code>from-font</code>, the lowercase letters of
+        both families share the same visual height, so the code doesn't look oversized
+        or shrunken next to the surrounding prose.
+      </p>
+    </section>
+
+    <section id="independent-theme-container" aria-labelledby="theme-heading">
+      <h2 id="theme-heading">Independent theme</h2>
+      <p>
+        This container represents a standalone theme with its own font stack. Its
+        proportions are locked with an explicit numeric override,
+        <code>font-size-adjust: ex-height 0.545</code>, so the x-height stays consistent
+        regardless of which font in the stack actually renders.
+      </p>
+    </section>
+  </main>
+</body>
+</html>
