diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,102 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Font Size Adjust Demo</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+      font-family: Georgia, "Times New Roman", serif;
+      line-height: 1.6;
+    }
+
+    body {
+      max-width: 48rem;
+      margin: 3rem auto;
+      padding: 0 1.5rem;
+    }
+
+    section {
+      margin-block: 2rem;
+      padding: 1.5rem;
+      border-radius: 0.75rem;
+      border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
+    }
+
+    h2 {
+      margin-top: 0;
+    }
+
+    /* 1. Mixed fonts: normalize x-height automatically.
+       `from-font` reads the aspect value (x-height / font-size) of the
+       first available primary font and applies it to every fallback and
+       every descendant font, so the inline monospace code matches the
+       surrounding serif text's visual height. */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", serif;
+      font-size: 1.25rem;
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, ui-monospace, monospace;
+      /* Prevent the UA from shrinking monospace text ("monospace quirk"). */
+      font-size: inherit;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in srgb, currentColor 10%, transparent);
+    }
+
+    /* 2. Independent theme: lock proportions with an explicit metric.
+       An explicit ex-height ratio of 0.52 is enforced regardless of which
+       font ends up loading, so the theme's visual proportions remain fixed
+       even if its fonts (or fallbacks) change. */
+    #independent-theme-container {
+      --theme-bg: #1e1b2e;
+      --theme-fg: #f4f1ff;
+      --theme-accent: #a78bfa;
+
+      background: var(--theme-bg);
+      color: var(--theme-fg);
+      border-color: var(--theme-accent);
+      font-family: "Trebuchet MS", Verdana, system-ui, sans-serif;
+      font-size: 1.125rem;
+      font-size-adjust: ex-height 0.52;
+    }
+
+    #independent-theme-container h2 {
+      color: var(--theme-accent);
+    }
+
+    #independent-theme-container code {
+      font-family: ui-monospace, "Courier New", monospace;
+      font-size: inherit;
+      color: var(--theme-accent);
+    }
+  </style>
+</head>
+<body>
+  <h1>Normalizing Mixed Fonts with <code>font-size-adjust</code></h1>
+
+  <section id="mixed-fonts-container">
+    <h2>Mixed font families</h2>
+    <p>
+      This paragraph is set in a serif face, while inline snippets such as
+      <code>const total = items.reduce(sum, 0);</code> use a monospace font.
+      Thanks to <code>font-size-adjust: from-font</code>, the lowercase letters
+      of both families share the same visual x-height, so the code blends
+      naturally into the running text.
+    </p>
+  </section>
+
+  <section id="independent-theme-container">
+    <h2>Independent theme</h2>
+    <p>
+      This container is a self-contained theme. Its proportions are locked by
+      <code>font-size-adjust: ex-height 0.52</code>, so whichever font
+      actually renders, the x-height always equals 52% of the font size.
+    </p>
+  </section>
+</body>
+</html>
