+  <script>
+    // Builds the breadcrumb trail from the current URL path so it works on
+    // the home page as well as nested pages such as /menu/seasonal.
+    (function () {
+      var labels = {
+        '/menu': 'Menu',
+        '/menu/seasonal': 'Maple Oat Latte',
+        '/menu/espresso': 'Dark Roast Espresso',
+        '/menu/cold-brew': 'Cold Brew',
+        '/locations': 'Locations',
+        '/rewards': 'Rewards',
+        '/account': 'My Account',
+        '/order-online': 'Order Online',
+        '/about': 'Our Story',
+        '/careers': 'Join the Team',
+        '/contact': 'Contact Us',
+        '/privacy-policy': 'Privacy'
+      };
+
+      function prettify(slug) {
+        return decodeURIComponent(slug)
+          .replace(/\.html?$/i, '')
+          .replace(/[-_]+/g, ' ')
+          .replace(/\b\w/g, function (c) { return c.toUpperCase(); });
+      }
+
+      var list = document.getElementById('breadcrumb-list');
+      if (!list) return;
+
+      var segments = window.location.pathname.split('/').filter(function (seg) {
+        return seg && !/^index\.html?$/i.test(seg);
+      });
+
+      var crumbs = [{ href: '/', label: 'Home' }];
+      var path = '';
+      segments.forEach(function (seg) {
+        path += '/' + seg;
+        crumbs.push({ href: path, label: labels[path.toLowerCase()] || prettify(seg) });
+      });
+
+      list.textContent = '';
+      crumbs.forEach(function (crumb, i) {
+        var li = document.createElement('li');
+        var el;
+        if (i === crumbs.length - 1) {
+          el = document.createElement('span');
+          el.setAttribute('aria-current', 'page');
+        } else {
+          el = document.createElement('a');
+          el.href = crumb.href;
+        }
+        el.textContent = crumb.label;
+        li.appendChild(el);
+        list.appendChild(li);
+      });
+    })();
+  </script>
+
 </body>
 
