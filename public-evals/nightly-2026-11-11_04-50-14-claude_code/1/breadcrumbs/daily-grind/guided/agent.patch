+  <script>
+    // Builds the breadcrumb trail from the current URL so the same markup works
+    // on the home page and on Menu / seasonal favorite detail pages.
+    (() => {
+      const trails = {
+        '/': [],
+        '/menu': [['Menu', '/menu']],
+        '/menu/seasonal': [['Menu', '/menu'], ['Seasonal Favorites', '/#seasonal-favorites'], ['Maple Oat Latte', '/menu/seasonal']],
+        '/menu/espresso': [['Menu', '/menu'], ['Seasonal Favorites', '/#seasonal-favorites'], ['Dark Roast Espresso', '/menu/espresso']],
+        '/menu/cold-brew': [['Menu', '/menu'], ['Seasonal Favorites', '/#seasonal-favorites'], ['Cold Brew', '/menu/cold-brew']],
+        '/locations': [['Locations', '/locations']],
+        '/rewards': [['Rewards', '/rewards']],
+        '/account': [['My Account', '/account']],
+      };
+
+      const path = location.pathname.replace(/\/index\.html$/, '/').replace(/(.)\/$/, '$1');
+      const trail = trails[path];
+      if (!trail) return; // Unknown path: keep the static "Home" trail.
+
+      const list = document.querySelector('.breadcrumb > ol');
+      const crumbs = [['Home', '/'], ...trail];
+      list.replaceChildren(...crumbs.map(([label, href], i) => {
+        const li = document.createElement('li');
+        const a = document.createElement('a');
+        a.href = href;
+        a.textContent = label;
+        if (i === crumbs.length - 1) a.setAttribute('aria-current', 'page');
+        li.append(a);
+        return li;
+      }));
+    })();
+  </script>
+
