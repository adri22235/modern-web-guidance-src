+      margin-bottom: 20px;
+    }
+
+    .feedback-log {
+      max-height: 360px;
+      overflow-y: auto;
+      overflow-x: hidden;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 10px 20px;
+      list-style: none;
+    }
+
+    .feedback-entry {
+      padding: 15px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .feedback-entry:last-child {
+      border-bottom: none;
+    }
+
+    .feedback-entry blockquote {
+      font-style: italic;
+      margin-bottom: 6px;
+    }
+
+    .feedback-meta {
+      display: flex;
+      justify-content: space-between;
+      font-size: 0.85rem;
+      color: var(--primary);
+    }
+
+    .feedback-meta .rating {
+      color: var(--accent);
+      letter-spacing: 2px;
+    }
+
+    /* Themed scrollbar: WebKit/Blink (Chrome, Edge, Safari) */
+    .feedback-log::-webkit-scrollbar {
+      width: 8px;
+    }
+
+    .feedback-log::-webkit-scrollbar-track {
+      background: #4e342e;
+      border-radius: 4px;
+    }
+
+    .feedback-log::-webkit-scrollbar-thumb {
+      background: #ffab40;
+      border-radius: 4px;
+    }
+
+    .feedback-log::-webkit-scrollbar-thumb:hover {
+      background: #ff9100;
+    }
+
+    /* Themed scrollbar: standard properties (Firefox). Applied only where the
+       WebKit pseudo-elements are unsupported, since newer Chromium ignores
+       ::-webkit-scrollbar styling whenever these standard properties are set. */
+    @supports not selector(::-webkit-scrollbar) {
+      .feedback-log {
+        scrollbar-width: thin;
+        scrollbar-color: #ffab40 #4e342e;
+      }
+    }
   </style>
