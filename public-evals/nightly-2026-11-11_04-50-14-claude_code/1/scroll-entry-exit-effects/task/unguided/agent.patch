diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,45 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /*
+     * Scroll-driven reveal: cards grow from 50% to 100% as they enter the
+     * viewport and shrink back as they leave. Pure CSS (view timelines).
+     * - Only applies where scroll-driven animations are supported; other
+     *   browsers simply show the cards at full size.
+     * - Disabled for users who prefer reduced motion.
+     * - A card containing keyboard focus is always shown at full size.
+     */
+    @keyframes card-reveal {
+      entry 0% {
+        scale: 0.5;
+      }
+
+      entry 100%,
+      exit 0% {
+        scale: 1;
+      }
+
+      exit 100% {
+        scale: 0.5;
+      }
+    }
+
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+          animation-range: cover;
+        }
+
+        .card:focus-within {
+          animation: none;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
