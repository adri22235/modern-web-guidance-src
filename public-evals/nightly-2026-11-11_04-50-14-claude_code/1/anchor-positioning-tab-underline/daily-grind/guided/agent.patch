     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const list = document.querySelector('.primary-nav');
+      const items = [...list.querySelectorAll('li')].filter(li => !li.querySelector('.logout-link'));
+      const supportsAnchor = CSS.supports('position-anchor', 'auto');
+
+      // Without anchor positioning, feed the active item's geometry to the CSS fallback.
+      const syncIndicator = () => {
+        if (supportsAnchor) return;
+        const active = list.querySelector('li.active');
+        if (!active) return;
+        list.style.setProperty('--indicator-left', `${active.offsetLeft}px`);
+        list.style.setProperty('--indicator-width', `${active.offsetWidth}px`);
+        list.style.setProperty('--indicator-top', `${active.offsetTop + active.offsetHeight + 4}px`);
+      };
+
+      const setActive = (target) => {
+        for (const li of items) {
+          const isActive = li === target;
+          li.classList.toggle('active', isActive);
+          const link = li.querySelector('a');
+          if (isActive) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        }
+        syncIndicator();
+      };
+
+      const itemForPath = (path) =>
+        items.find(li => {
+          const href = li.querySelector('a').getAttribute('href');
+          return path === href || path.startsWith(`${href}/`);
+        });
+
+      list.addEventListener('click', (event) => {
+        const link = event.target.closest('a');
+        const li = link?.closest('li');
+        if (!li || !items.includes(li)) return;
+        // Let modified clicks (new tab, etc.) behave natively.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        if (li.classList.contains('active')) return;
+        history.pushState(null, '', link.getAttribute('href'));
+        setActive(li);
+      });
+
+      window.addEventListener('popstate', () => setActive(itemForPath(location.pathname)));
+      new ResizeObserver(syncIndicator).observe(list);
+
+      setActive(itemForPath(location.pathname));
+    })();
+  </script>
+
 </body>
 
