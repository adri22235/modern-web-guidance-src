     nav ul {
       display: flex;
       list-style: none;
+      position: relative;
+    }
+
+    /* Active nav indicator: one decorative underline that slides between items */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      pointer-events: none;
+      /* Border (not background) so it survives forced-colors mode */
+      border-block-end: 2px solid var(--accent);
+      /* Fallback geometry, set by script when anchor positioning is unsupported */
+      top: var(--indicator-top, 100%);
+      left: var(--indicator-left, 0);
+      width: var(--indicator-width, 0);
+      opacity: 0;
+    }
+
+    nav ul:has(> li.active)::before {
+      opacity: 1;
+    }
+
+    nav ul li.active {
+      anchor-name: --active-nav;
+    }
+
+    @supports (position-anchor: auto) {
+      nav ul::before {
+        position-anchor: --active-nav;
+        top: calc(anchor(bottom) + 4px);
+        left: anchor(left);
+        right: anchor(right);
+        width: auto;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: top 0.3s ease, left 0.3s ease, right 0.3s ease, width 0.3s ease, opacity 0.2s;
