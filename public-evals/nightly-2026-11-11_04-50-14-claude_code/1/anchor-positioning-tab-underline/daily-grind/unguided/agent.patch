+  <script>
+    (function () {
+      const list = document.querySelector('.nav-links');
+      const indicator = list.querySelector('.nav-indicator');
+      const items = Array.from(list.querySelectorAll('[data-nav-item]'));
+      let active = null;
+
+      function moveIndicator(link) {
+        if (!link) {
+          indicator.style.opacity = '0';
+          return;
+        }
+        // Links' offsetParent is the positioned <ul>, so offsets are relative to it.
+        indicator.style.width = link.offsetWidth + 'px';
+        indicator.style.transform = 'translateX(' + link.offsetLeft + 'px)';
+        indicator.style.opacity = '1';
+      }
+
+      function setActive(link) {
+        items.forEach(function (item) {
+          const isActive = item === link;
+          item.classList.toggle('active', isActive);
+          if (isActive) item.setAttribute('aria-current', 'page');
+          else item.removeAttribute('aria-current');
+        });
+        active = link;
+        moveIndicator(link);
+      }
+
+      // Initial state: match current path, default to Menu. Place without animating.
+      const path = window.location.pathname;
+      const initial = items.find(function (a) {
+        const href = a.getAttribute('href');
+        return path === href || path.indexOf(href + '/') === 0;
+      }) || items[0];
+      setActive(initial);
+      requestAnimationFrame(function () {
+        requestAnimationFrame(function () { indicator.classList.add('ready'); });
+      });
+
+      items.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          // Allow modified clicks (new tab/window) to behave normally.
+          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+          e.preventDefault();
+          if (link === active) return;
+          setActive(link);
+          history.pushState(null, '', link.getAttribute('href'));
+        });
+      });
+
+      // Keep the indicator aligned on layout changes (resize, font load).
+      window.addEventListener('resize', function () {
+        indicator.classList.remove('ready');
+        moveIndicator(active);
+        requestAnimationFrame(function () { indicator.classList.add('ready'); });
+      });
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(function () { moveIndicator(active); });
+      }
+    })();
+  </script>
+
