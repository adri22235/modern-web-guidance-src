+  <script>
+    // Truncation detection for browsers without scroll-driven animations / style queries:
+    // toggle .truncated when a label's text overflows its box.
+    {
+      const labels = document.querySelectorAll('.truncate');
+      const observer = new ResizeObserver(entries => {
+        for (const { target } of entries) {
+          target.classList.toggle('truncated', target.scrollWidth > target.clientWidth);
+        }
+      });
+      for (const label of labels) observer.observe(label);
+    }
+  </script>
