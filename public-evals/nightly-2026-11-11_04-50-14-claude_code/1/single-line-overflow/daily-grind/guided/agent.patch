+    @property --truncated {
+      syntax: "<integer>";
+      inherits: false;
+      initial-value: 0;
+    }
+
+    /* Single-line truncation: the full text stays in the DOM (accessible name,
+       find-in-page, copy); only its rendering is clipped with an ellipsis. */
+    .truncate {
+      display: block;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+      /* Flags truncation: the self scroll timeline is only active while the text overflows */
+      animation: truncated linear both;
+      animation-timeline: scroll(self inline);
+    }
+
+    @keyframes truncated {
+      from, to {
+        --truncated: 1;
+      }
+    }
+
+    /* Fallback flag set from script where scroll-driven animations are unsupported */
+    .truncate.truncated {
+      --truncated: 1;
+    }
+
+    /* Reveal the full text on hover / keyboard focus by scrolling it within its box */
+    @media (prefers-reduced-motion: no-preference) {
+      .truncate:is(:hover, :focus-visible) {
+        text-overflow: clip;
+      }
+
+      @container style(--truncated: 1) {
+        .truncate:is(:hover, :focus-visible) > span {
+          display: inline-block;
+          margin-inline-start: 100%;
+          translate: calc(1px - 100%);
+          transition: margin-inline-start 1.5s ease-in, translate 1.5s ease-in;
+        }
+
+        .truncate:is(:hover, :focus-visible):dir(rtl) > span {
+          translate: calc(100% - 1px);
+        }
+      }
+
+      /* Same reveal for browsers without style queries (class set from script) */
+      .truncate.truncated:is(:hover, :focus-visible) > span {
+        display: inline-block;
+        margin-inline-start: 100%;
+        translate: calc(1px - 100%);
+        transition: margin-inline-start 1.5s ease-in, translate 1.5s ease-in;
+      }
     }
 
