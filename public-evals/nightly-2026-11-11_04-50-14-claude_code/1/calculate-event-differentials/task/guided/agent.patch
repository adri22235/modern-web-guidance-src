+  <script type="module">
+    // Load the Temporal polyfill only where the native API isn't available.
+    if (typeof Temporal === 'undefined') {
+      try {
+        const mod = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = mod.Temporal;
+      } catch {
+        // Leave the static "Offer ends March 1, 2026" fallback in place.
+      }
+    }
+
+    function renderPromoTimer(el) {
+      // Both dates mean local midnight (start of the day) in the user's own time zone.
+      const tz = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(tz);
+      const start = Temporal.PlainDate.from(el.dataset.start).toZonedDateTime({ timeZone: tz });
+      const end = Temporal.PlainDate.from(el.dataset.end).toZonedDateTime({ timeZone: tz });
+
+      const opts = { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' };
+      const remaining = now.until(end, opts);
+      const elapsed = now.since(start, opts);
+
+      // Always show both days and hours, even when one of them is zero.
+      const fmt = (d) => d.abs().toLocaleString(undefined, {
+        style: 'long', daysDisplay: 'always', hoursDisplay: 'always',
+      });
+      const endLabel = end.toLocaleString(undefined, { dateStyle: 'long' });
+
+      const remainingEl = el.querySelector('.promo-remaining');
+      const elapsedEl = el.querySelector('.promo-elapsed');
+      const endTime = `<time datetime="${end.toString({ timeZoneName: 'never' })}">${endLabel}</time>`;
+
+      if (elapsed.sign < 0) {
+        el.dataset.state = 'upcoming';
+        remainingEl.innerHTML = `Starts in ${fmt(elapsed)}`;
+        elapsedEl.textContent = '';
+      } else if (remaining.sign > 0) {
+        el.dataset.state = 'active';
+        remainingEl.innerHTML = `<time datetime="${remaining.toString()}">${fmt(remaining)}</time> left &middot; ends ${endTime}`;
+        elapsedEl.innerHTML = `Running for <time datetime="${elapsed.toString()}">${fmt(elapsed)}</time>`;
+      } else {
+        el.dataset.state = 'ended';
+        remainingEl.innerHTML = `This offer ended ${endTime}`;
+        elapsedEl.innerHTML = `<time datetime="${elapsed.toString()}">${fmt(elapsed)}</time> since the promotion started`;
+      }
+    }
+
+    if (typeof Temporal !== 'undefined') {
+      document.querySelectorAll('.promo-timer').forEach(renderPromoTimer);
+    }
+  </script>
+
 </body>
 
