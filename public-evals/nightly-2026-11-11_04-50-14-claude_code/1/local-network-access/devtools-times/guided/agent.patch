new file mode 100644
index 0000000..11646c3
--- /dev/null
+++ b/src/pages/diagnostics.astro
@@ -0,0 +1,32 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect.tsx';
+
+// Local Network Access permissions are limited to this page's own origin;
+// state that explicitly so no embedded third-party frame can use them.
+Astro.response.headers.set(
+  'Permissions-Policy',
+  'local-network=(self), loopback-network=(self)'
+);
+---
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 pb-2 border-b-2">Developer Diagnostics</h1>
+    <p class="text-gray-700 mb-6 max-w-3xl">
+      Connect this page to a hardware test device on your Wi-Fi network and to the companion CLI running on
+      your computer. Your browser connects to them directly. Nothing is sent through our servers.
+      Your browser may ask whether this site may access devices on your local network.
+    </p>
+    <DiagnosticsConnect client:load />
+    <details class="mt-8 text-sm text-gray-700 max-w-3xl">
+      <summary class="font-semibold cursor-pointer">Setting up your endpoints</summary>
+      <ul class="list-disc ml-5 mt-2 space-y-1">
+        <li>Each endpoint must answer a plain HTTP <code>GET</code> and send an
+          <code>Access-Control-Allow-Origin</code> header that allows this site's origin.</li>
+        <li>JSON responses are pretty-printed. Other responses are shown as plain text.</li>
+        <li>Supported browsers: Chrome and Edge 145+ show a permission prompt. Other browsers may block
+          or allow these requests according to their own rules.</li>
+      </ul>
+    </details>
+  </div>
+</Layout>
