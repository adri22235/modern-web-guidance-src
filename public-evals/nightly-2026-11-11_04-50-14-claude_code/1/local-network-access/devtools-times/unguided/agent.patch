index 0000000..55b6be2
--- /dev/null
+++ b/src/components/DeviceDiagnostics.tsx
@@ -0,0 +1,341 @@
+import React, { useEffect, useState } from 'react';
+import {
+  displayValue,
+  probe,
+  queryLnaPermission,
+  validateLanTarget,
+  validateLoopbackTarget,
+  type AddressSpace,
+  type LnaPermissionState,
+  type ProbeResult,
+} from '../utils/localNetwork';
+
+// Fixed endpoint paths. The reader can only change the host and port, never
+// the path, so the widget can't be pointed at arbitrary URLs on a device.
+const DEVICE_STATUS_PATH = '/api/v1/status';
+const CLI_HEALTH_PATH = '/v1/health';
+const DEFAULT_DEVICE_PORT = '80';
+const DEFAULT_CLI_PORT = '47821';
+
+// Only non-secret settings are saved. Tokens stay in memory.
+const STORAGE_KEY = 'devtools-times:diagnostics';
+
+interface SavedSettings {
+  deviceHost?: string;
+  devicePort?: string;
+  cliPort?: string;
+}
+
+function loadSettings(): SavedSettings {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    const parsed = raw ? JSON.parse(raw) : {};
+    return {
+      deviceHost: typeof parsed.deviceHost === 'string' ? parsed.deviceHost : undefined,
+      devicePort: typeof parsed.devicePort === 'string' ? parsed.devicePort : undefined,
+      cliPort: typeof parsed.cliPort === 'string' ? parsed.cliPort : undefined,
+    };
+  } catch {
+    return {};
+  }
+}
+
+function saveSettings(s: SavedSettings) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(s));
+  } catch {
+    /* storage unavailable (private mode, etc.) */
+  }
+}
+
+type ConnState = 'idle' | 'connecting' | 'connected' | 'error';
+
+function StatusPill({ state }: { state: ConnState }) {
+  const styles: Record<ConnState, string> = {
+    idle: 'bg-gray-100 text-gray-600',
+    connecting: 'bg-amber-100 text-amber-800',
+    connected: 'bg-green-100 text-green-800',
+    error: 'bg-red-100 text-red-700',
+  };
+  const labels: Record<ConnState, string> = {
+    idle: 'Not connected',
+    connecting: 'Connecting…',
+    connected: 'Connected',
+    error: 'Failed',
+  };
+  return (
+    <span className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold ${styles[state]}`}>
+      <span
+        aria-hidden="true"
+        className={`h-1.5 w-1.5 rounded-full ${
+          state === 'connected' ? 'bg-green-600' : state === 'error' ? 'bg-red-600' : state === 'connecting' ? 'bg-amber-500' : 'bg-gray-400'
+        }`}
+      />
+      {labels[state]}
+    </span>
+  );
+}
+
+function PermissionNote({ space }: { space: AddressSpace }) {
+  const [state, setState] = useState<LnaPermissionState | null>(null);
+  useEffect(() => {
+    let cancelled = false;
+    queryLnaPermission(space).then((s) => !cancelled && setState(s));
+    return () => {
+      cancelled = true;
+    };
+  }, [space]);
+
+  if (state === null || state === 'unsupported') return null;
+  const text: Record<PermissionState, string> = {
+    granted: 'Local network access is allowed for this site.',
+    prompt: 'Your browser will ask for local network access the first time you connect.',
+    denied: 'Local network access is blocked for this site. To connect, turn it back on in your site settings.',
+  };
+  return (
+    <p className={`text-xs ${state === 'denied' ? 'text-red-700' : 'text-gray-500'}`}>{text[state]}</p>
+  );
+}
+
+function ResultTable({ result }: { result: ProbeResult }) {
+  const entries = Object.entries(result.data ?? {}).slice(0, 20);
+  return (
+    <div className="mt-3 rounded-md border border-gray-200 bg-gray-50 p-3 text-xs">
+      <div className="mb-2 flex flex-wrap gap-x-4 gap-y-1 text-gray-600">
+        {result.status !== undefined && <span>HTTP {result.status}</span>}
+        <span>{result.latencyMs} ms</span>
+      </div>
+      {result.error && (
+        <p role="alert" className="mb-2 text-red-700">
+          {result.error}
+        </p>
+      )}
+      {entries.length > 0 && (
+        <dl className="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1 font-mono">
+          {entries.map(([k, v]) => (
+            <React.Fragment key={k}>
+              <dt className="text-gray-500 truncate max-w-[12rem]">{displayValue(k)}</dt>
+              <dd className="text-gray-900 break-all">{displayValue(v)}</dd>
+            </React.Fragment>
+          ))}
+        </dl>
+      )}
+    </div>
+  );
+}
+
+function Field(props: {
+  id: string;
+  label: string;
+  value: string;
+  onChange: (v: string) => void;
+  placeholder?: string;
+  type?: string;
+  inputMode?: React.HTMLAttributes<HTMLInputElement>['inputMode'];
+  disabled?: boolean;
+  hint?: string;
+  className?: string;
+}) {
+  return (
+    <div className={props.className}>
+      <label htmlFor={props.id} className="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">
+        {props.label}
+      </label>
+      <input
+        id={props.id}
+        type={props.type ?? 'text'}
+        inputMode={props.inputMode}
+        value={props.value}
+        disabled={props.disabled}
+        onChange={(e) => props.onChange(e.target.value)}
+        placeholder={props.placeholder}
+        autoComplete="off"
+        spellCheck={false}
+        className="w-full px-3 py-2 border border-gray-300 rounded-md font-mono text-sm focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:bg-gray-100 disabled:text-gray-500"
+      />
+      {props.hint && <p className="mt-1 text-xs text-gray-500">{props.hint}</p>}
+    </div>
+  );
+}
+
+function DevicePanel({ initialHost, initialPort, onSave }: { initialHost: string; initialPort: string; onSave: (h: string, p: string) => void }) {
+  const [host, setHost] = useState(initialHost);
+  const [port, setPort] = useState(initialPort);
+  const [token, setToken] = useState('');
+  const [state, setState] = useState<ConnState>('idle');
+  const [validation, setValidation] = useState<string | null>(null);
+  const [result, setResult] = useState<ProbeResult | null>(null);
+
+  useEffect(() => setHost(initialHost), [initialHost]);
+  useEffect(() => setPort(initialPort), [initialPort]);
+
+  const connect = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const target = validateLanTarget(host, port);
+    if (typeof target === 'string') {
+      setValidation(target);
+      return;
+    }
+    setValidation(null);
+    setState('connecting');
+    setResult(null);
+    onSave(target.host, String(target.port));
+    const r = await probe(target, DEVICE_STATUS_PATH, { token: token.trim() || undefined });
+    setResult(r);
+    setState(r.ok ? 'connected' : 'error');
+  };
+
+  return (
+    <section aria-labelledby="device-heading" className="border border-gray-300 rounded-lg p-5 bg-white">
+      <div className="flex items-start justify-between gap-3 mb-1">
+        <h2 id="device-heading" className="text-lg font-bold text-gray-900">
+          Hardware test device
+        </h2>
+        <StatusPill state={state} />
+      </div>
+      <p className="text-sm text-gray-600 mb-4">
+        Connect to a test rig on your Wi-Fi network, such as <code className="font-mono">192.168.1.50</code>. Requests
+        go straight from your browser to the device and never pass through our servers.
+      </p>
+
+      <form onSubmit={connect} className="space-y-3" noValidate>
+        <div className="grid grid-cols-3 gap-3">
+          <Field
+            id="device-host"
+            label="Device IP"
+            value={host}
+            onChange={setHost}
+            placeholder="192.168.1.50"
+            inputMode="decimal"
+            className="col-span-2"
+          />
+          <Field id="device-port" label="Port" value={port} onChange={setPort} placeholder="80" inputMode="numeric" />
+        </div>
+        <Field
+          id="device-token"
+          label="Access token (optional)"
+          type="password"
+          value={token}
+          onChange={setToken}
+          hint="Only needed if your device requires one. It's held in memory and never saved."
+        />
+        {validation && (
+          <p role="alert" className="text-xs text-red-700">
+            {validation}
+          </p>
+        )}
+        <PermissionNote space="local" />
+        <button
+          type="submit"
+          disabled={state === 'connecting'}
+          className="w-full py-2 px-4 rounded-md text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60 disabled:cursor-not-allowed"
+        >
+          {state === 'connecting' ? 'Connecting…' : state === 'connected' ? 'Refresh status' : 'Connect to device'}
+        </button>
+      </form>
+      {result && <ResultTable result={result} />}
+    </section>
+  );
+}
+
+function CliPanel({ initialPort, onSave }: { initialPort: string; onSave: (p: string) => void }) {
+  const [port, setPort] = useState(initialPort);
+  const [token, setToken] = useState('');
+  const [state, setState] = useState<ConnState>('idle');
+  const [validation, setValidation] = useState<string | null>(null);
+  const [result, setResult] = useState<ProbeResult | null>(null);
+
+  useEffect(() => setPort(initialPort), [initialPort]);
+
+  const connect = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const target = validateLoopbackTarget(port);
+    if (typeof target === 'string') {
+      setValidation(target);
+      return;
+    }
+    if (!token.trim()) {
+      setValidation('Paste the pairing token printed by `devtools-times-cli serve`.');
+      return;
+    }
+    setValidation(null);
+    setState('connecting');
+    setResult(null);
+    onSave(String(target.port));
+    const r = await probe(target, CLI_HEALTH_PATH, { token: token.trim() });
+    setResult(r);
+    setState(r.ok ? 'connected' : 'error');
+  };
+
+  return (
+    <section aria-labelledby="cli-heading" className="border border-gray-300 rounded-lg p-5 bg-white">
+      <div className="flex items-start justify-between gap-3 mb-1">
+        <h2 id="cli-heading" className="text-lg font-bold text-gray-900">
+          Companion CLI
+        </h2>
+        <StatusPill state={state} />
+      </div>
+      <p className="text-sm text-gray-600 mb-4">
+        Connect to the companion CLI on this computer. Start it with{' '}
+        <code className="font-mono">devtools-times-cli serve</code>, then paste the pairing token it prints.
+      </p>
+
+      <form onSubmit={connect} className="space-y-3" noValidate>
+        <div className="grid grid-cols-3 gap-3">
+          <Field id="cli-host" label="Host" value="127.0.0.1" onChange={() => {}} disabled className="col-span-2" />
+          <Field id="cli-port" label="Port" value={port} onChange={setPort} placeholder={DEFAULT_CLI_PORT} inputMode="numeric" />
+        </div>
+        <Field
+          id="cli-token"
+          label="Pairing token"
+          type="password"
+          value={token}
+          onChange={setToken}
+          hint="Held in memory for this tab only. It's never saved or sent anywhere other than 127.0.0.1."
+        />
+        {validation && (
+          <p role="alert" className="text-xs text-red-700">
+            {validation}
+          </p>
+        )}
+        <PermissionNote space="loopback" />
+        <button
+          type="submit"
+          disabled={state === 'connecting'}
+          className="w-full py-2 px-4 rounded-md text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60 disabled:cursor-not-allowed"
+        >
+          {state === 'connecting' ? 'Connecting…' : state === 'connected' ? 'Refresh status' : 'Connect to CLI'}
+        </button>
+      </form>
+      {result && <ResultTable result={result} />}
+    </section>
+  );
+}
+
+export default function DeviceDiagnostics() {
+  const [settings, setSettings] = useState<SavedSettings>({});
+
+  // Read saved settings after mount so server and client render the same markup.
+  useEffect(() => setSettings(loadSettings()), []);
+
+  const update = (patch: SavedSettings) => {
+    setSettings((prev) => {
+      const next = { ...prev, ...patch };
+      saveSettings(next);
+      return next;
+    });
+  };
+
+  return (
+    <div className="space-y-6">
+      <div className="grid gap-6 md:grid-cols-2">
+        <DevicePanel
+          initialHost={settings.deviceHost ?? ''}
+          initialPort={settings.devicePort ?? DEFAULT_DEVICE_PORT}
+          onSave={(deviceHost, devicePort) => update({ deviceHost, devicePort })}
+        />
+        <CliPanel initialPort={settings.cliPort ?? DEFAULT_CLI_PORT} onSave={(cliPort) => update({ cliPort })} />
+      </div>
+    </div>
+  );
+}
