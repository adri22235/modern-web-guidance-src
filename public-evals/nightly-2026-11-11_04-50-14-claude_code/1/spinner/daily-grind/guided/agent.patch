+  <!-- Announces busy state to assistive technology -->
+  <div role="status" class="visually-hidden" id="loading-status"></div>
+
+  <script>
+    (() => {
+      const status = document.getElementById('loading-status');
+      const buttons = document.querySelectorAll('a.btn[data-loading-label]');
+
+      function setBusy(link, label) {
+        link.setAttribute('aria-disabled', 'true');
+        const region = link.closest('.grid') || link.closest('.hero');
+        region?.setAttribute('aria-busy', 'true');
+
+        const spinner = document.createElement('progress');
+        spinner.className = 'loading-spinner';
+        spinner.setAttribute('aria-label', label);
+        link.prepend(spinner);
+
+        status.textContent = label + '\u2026';
+      }
+
+      function resetAll() {
+        document.querySelectorAll('a.btn[aria-disabled="true"]').forEach((link) => {
+          link.removeAttribute('aria-disabled');
+          link.querySelector('progress.loading-spinner')?.remove();
+        });
+        document.querySelectorAll('[aria-busy="true"]').forEach((el) => el.removeAttribute('aria-busy'));
+        status.textContent = '';
+      }
+
+      buttons.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          // Prevent duplicate requests while already loading.
+          if (link.getAttribute('aria-disabled') === 'true') {
+            event.preventDefault();
+            return;
+          }
+          // Let new-tab / modified clicks behave normally without a spinner.
+          if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+              event.ctrlKey || event.shiftKey || event.altKey || link.target === '_blank') {
+            return;
+          }
+
+          let label = link.dataset.loadingLabel;
+          const drink = link.closest('.card')?.querySelector('h3')?.textContent.trim();
+          if (drink) label = `Loading ${drink} details`;
+          setBusy(link, label);
+        });
+      });
+
+      // Restore buttons when returning via the back/forward cache.
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) resetAll();
+      });
+    })();
+  </script>
+
