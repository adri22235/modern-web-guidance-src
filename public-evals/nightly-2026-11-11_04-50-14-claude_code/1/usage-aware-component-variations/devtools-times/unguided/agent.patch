+/*
+ * Teaser presentation context
+ * ---------------------------
+ * Teaser cards never decide on their own whether they are "featured" or not.
+ * Instead, the section that contains them declares its semantic role via
+ * `data-teaser-context="featured" | "default"`. The context is expressed as
+ * inherited custom properties, so a teaser always follows its *closest*
+ * context ancestor (nested contexts work as expected) and the same markup can
+ * be dropped into any section without extra props.
+ *
+ *   featured -> promotional badge visible, filled action button
+ *   default  -> badge hidden, outlined action button (also the fallback when
+ *               no context is declared at all)
+ */
+@layer components {
+  [data-teaser-context="default"] {
+    --teaser-badge-display: none;
+    --teaser-action-bg: transparent;
+    --teaser-action-fg: var(--color-amber-800, #92400e);
+    --teaser-action-border: currentColor;
+    --teaser-action-hover-bg: var(--color-amber-50, #fffbeb);
+    --teaser-action-hover-fg: var(--color-amber-900, #78350f);
+    --teaser-action-shadow: none;
+  }
+
+  [data-teaser-context="featured"] {
+    --teaser-badge-display: inline-flex;
+    --teaser-action-bg: var(--color-amber-400, #fbbf24);
+    --teaser-action-fg: var(--color-gray-900, #111827);
+    --teaser-action-border: var(--color-amber-400, #fbbf24);
+    --teaser-action-hover-bg: var(--color-amber-500, #f59e0b);
+    --teaser-action-hover-fg: var(--color-gray-900, #111827);
+    --teaser-action-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.08);
+  }
+
+  .teaser-badge {
+    display: var(--teaser-badge-display, none);
+    align-items: center;
+    gap: 0.25rem;
+    width: fit-content;
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    background-color: var(--color-gray-900, #111827);
+    color: var(--color-amber-300, #fcd34d);
+    font-size: 0.6875rem;
+    font-weight: 700;
+    line-height: 1.25rem;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+  }
+
+  .teaser-action {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.25rem 0.75rem;
+    border: 1px solid var(--teaser-action-border, currentColor);
+    border-radius: 9999px;
+    background-color: var(--teaser-action-bg, transparent);
+    color: var(--teaser-action-fg, var(--color-amber-800, #92400e));
+    box-shadow: var(--teaser-action-shadow, none);
+    font-size: 0.8125rem;
+    font-weight: 600;
+    line-height: 1.25rem;
+    white-space: nowrap;
+    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
+  }
+
+  .teaser-action:hover {
+    background-color: var(--teaser-action-hover-bg, var(--color-amber-50, #fffbeb));
+    color: var(--teaser-action-hover-fg, var(--color-amber-900, #78350f));
+  }
+
+  .teaser-action:focus-visible {
+    outline: 2px solid var(--color-amber-600, #d97706);
+    outline-offset: 2px;
+  }
+}
