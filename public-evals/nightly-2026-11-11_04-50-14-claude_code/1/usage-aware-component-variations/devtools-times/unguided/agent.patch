@@ -0,0 +1,19 @@
+---
+/**
+ * Call-to-action button for article teasers. Filled in featured sections,
+ * outlined in default sections — driven by the parent `data-teaser-context`.
+ */
+export interface Props {
+    href: string;
+    label?: string;
+    title?: string;
+}
+
+const { href, label = 'Read story', title } = Astro.props;
+---
+<a href={href} class="teaser-action" aria-label={title ? `${label}: ${title}` : undefined}>
+    {label}
+    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="w-4 h-4">
+        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
+    </svg>
+</a>
