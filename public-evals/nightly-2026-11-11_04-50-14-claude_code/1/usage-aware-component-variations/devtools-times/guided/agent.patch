+}
+/*
+ * Semantic surface context.
+ * Any container can declare itself a featured surface; teaser components
+ * react to the inherited `--surface` flag without knowing who set it.
+ */
+.surface-featured {
+  --surface: featured;
+}
+
+@layer components {
+  /* Default (subtle) presentation */
+  .teaser-badge {
+    display: none;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    background: var(--color-amber-400);
+    color: var(--color-gray-900);
+    font-size: 0.6875rem;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    line-height: 1.25rem;
+    text-transform: uppercase;
+  }
+
+  .teaser-action {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.375rem 0.875rem;
+    border: 1px solid currentColor;
+    border-radius: 0.375rem;
+    background: transparent;
+    color: var(--color-amber-800);
+    font-size: 0.875rem;
+    font-weight: 600;
+    line-height: 1.25rem;
+    transition: background-color 150ms, color 150ms, border-color 150ms;
+  }
+
+  .teaser-action:hover {
+    background: var(--color-amber-50);
+  }
+
+  .teaser-action:focus-visible {
+    outline: 2px solid var(--color-amber-400);
+    outline-offset: 2px;
+  }
+
+  /* Selector-based fallback for browsers without container style queries */
+  :where(.surface-featured) .teaser-badge {
+    display: inline-flex;
+  }
+
+  :where(.surface-featured) .teaser-action {
+    border-color: transparent;
+    background: var(--color-amber-800);
+    color: var(--color-white);
+  }
+
+  :where(.surface-featured) .teaser-action:hover {
+    background: var(--color-amber-900);
+  }
+
+  /* Progressive enhancement: react to the inherited semantic flag */
+  @container style(--surface: featured) {
+    .teaser-badge {
+      display: inline-flex;
+    }
+
+    .teaser-action {
+      border-color: transparent;
+      background: var(--color-amber-800);
+      color: var(--color-white);
+    }
+
+    .teaser-action:hover {
+      background: var(--color-amber-900);
+    }
+  }
+}
