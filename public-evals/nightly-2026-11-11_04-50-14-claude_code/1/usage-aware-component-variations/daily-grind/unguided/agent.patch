+    /* ---------------------------------------------------------------
+       Context-aware cards
+       A section declares its semantic theme via data-theme. The theme
+       only sets design tokens; .card (and its children) consume them,
+       so any card dropped into a themed section adapts automatically.
+       Unthemed sections fall back to the brand defaults above.
+       --------------------------------------------------------------- */
+    .themed-section {
+      --card-bg: white;
+      --card-text: var(--text);
+      --card-heading: var(--primary);
+      --card-accent: var(--accent);
+      --card-border: transparent;
+      --card-shadow: rgba(0, 0, 0, 0.1);
+      --card-btn-bg: var(--primary);
+      --card-btn-hover: #3e2723;
+      --card-btn-text: white;
+      --theme-label: none;
+      --theme-heading: var(--primary);
+    }
+
+    .themed-section > h2 {
+      text-align: center;
+      color: var(--theme-heading);
+    }
+
+    .themed-section .card {
+      position: relative;
+      overflow: hidden;
+      background: var(--card-bg);
+      color: var(--card-text);
+      border: 1px solid var(--card-border);
+      border-top: 4px solid var(--card-accent);
+      box-shadow: 0 2px 6px var(--card-shadow);
+      transition: transform 0.25s ease, box-shadow 0.25s ease;
+    }
+
+    .themed-section .card:hover {
+      transform: translateY(-4px);
+      box-shadow: 0 10px 20px var(--card-shadow);
+    }
+
+    .themed-section .card h3 {
+      color: var(--card-heading);
+    }
+
+    .themed-section .card .btn {
+      background: var(--card-btn-bg);
+      color: var(--card-btn-text);
+    }
+
+    .themed-section .card .btn:hover,
+    .themed-section .card .btn:focus-visible {
+      background: var(--card-btn-hover);
+    }
+
+    .themed-section .card .btn:focus-visible {
+      outline: 2px solid var(--card-accent);
+      outline-offset: 2px;
+    }
+
+    /* Small seasonal tag, text supplied by the theme */
+    .themed-section .card::before {
+      content: var(--theme-label);
+      display: block;
+      width: fit-content;
+      margin: 0 auto 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      font-size: 0.7rem;
+      font-weight: 600;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      background: var(--card-accent);
+      color: var(--card-btn-text);
+    }
+
+    /* Theme token sets */
+    [data-theme="autumn"] {
+      --card-bg: linear-gradient(160deg, #fff8f0 0%, #fbe9d7 100%);
+      --card-text: #4a2c1a;
+      --card-heading: #8d3b12;
+      --card-accent: #d9661f;
+      --card-border: #f0d2b4;
+      --card-shadow: rgba(141, 59, 18, 0.18);
+      --card-btn-bg: #8d3b12;
+      --card-btn-hover: #6b2a0b;
+      --card-btn-text: #fff;
+      --theme-label: "\1F341  Autumn Pick";
+      --theme-heading: #8d3b12;
+    }
+
+    [data-theme="winter"] {
+      --card-bg: linear-gradient(160deg, #f6f9fc 0%, #e3ecf5 100%);
+      --card-text: #23344a;
+      --card-heading: #1f4e79;
+      --card-accent: #5b8db8;
+      --card-border: #cddbe8;
+      --card-shadow: rgba(31, 78, 121, 0.18);
+      --card-btn-bg: #1f4e79;
+      --card-btn-hover: #163a5a;
+      --card-btn-text: #fff;
+      --theme-label: "\2744  Winter Warmer";
+      --theme-heading: #1f4e79;
+    }
+
+    [data-theme="spring"] {
+      --card-bg: linear-gradient(160deg, #fbfdf7 0%, #eaf4dd 100%);
+      --card-text: #2f3d22;
+      --card-heading: #3f6b2a;
+      --card-accent: #8bbf5a;
+      --card-border: #d6e8c3;
+      --card-shadow: rgba(63, 107, 42, 0.16);
+      --card-btn-bg: #3f6b2a;
+      --card-btn-hover: #2e4f1f;
+      --card-btn-text: #fff;
+      --theme-label: "\1F338  Spring Bloom";
+      --theme-heading: #3f6b2a;
+    }
+
+    [data-theme="summer"] {
+      --card-bg: linear-gradient(160deg, #fffdf5 0%, #fff1cc 100%);
+      --card-text: #3d3214;
+      --card-heading: #9a5b00;
+      --card-accent: #f2a900;
+      --card-border: #f5e1a8;
+      --card-shadow: rgba(154, 91, 0, 0.16);
+      --card-btn-bg: #9a5b00;
+      --card-btn-hover: #774600;
+      --card-btn-text: #fff;
+      --theme-label: "\2600  Summer Sip";
+      --theme-heading: #9a5b00;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .themed-section .card {
+        transition: none;
+      }
+
+      .themed-section .card:hover {
+        transform: none;
+      }
+    }
+
