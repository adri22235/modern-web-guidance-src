+    }
+
+    .table-wrapper {
+      overflow: auto;
+      max-inline-size: 100%;
+      max-block-size: min(500px, 80vh);
+      container-type: inline-size;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-wrapper:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      inline-size: 100%;
+      border-collapse: separate;
+      border-spacing: 0;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      caption-side: top;
+      padding: 12px 16px;
+      text-align: start;
+      font-size: 0.85rem;
+      color: #5d4037;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 10px 16px;
+      text-align: end;
+      white-space: nowrap;
+      border-block-end: 1px solid var(--secondary);
+    }
+
+    .nutrition-table th[scope="row"],
+    .nutrition-table thead th:first-child {
+      text-align: start;
+    }
+
+    /* Sticky column headers */
+    .nutrition-table thead {
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+    }
+
+    /* Sticky row headers */
+    .nutrition-table tbody th {
+      position: sticky;
+      inset-inline-start: 0;
+      background: white;
+      color: var(--primary);
+    }
+
+    .nutrition-table tbody tr:last-child > * {
+      border-block-end: 0;
+    }
+
+    /* Stacked "card" layout when the table itself is narrow */
+    @container (width < 600px) {
+      .nutrition-table,
+      .nutrition-table thead,
+      .nutrition-table tbody,
+      .nutrition-table tr,
+      .nutrition-table th,
+      .nutrition-table td {
+        display: block;
+      }
+
+      .nutrition-table thead {
+        display: none;
+      }
+
+      .nutrition-table tbody {
+        padding: 0 12px 12px;
+      }
+
+      .nutrition-table tr {
+        margin-block-end: 1rem;
+        border: 1px solid var(--secondary);
+        border-radius: 6px;
+        overflow: clip;
+      }
+
+      .nutrition-table tbody th {
+        inset-inline-start: auto;
+        inset-block-start: 0;
+        z-index: 2;
+        background: var(--secondary);
+        text-align: start;
+      }
+
+      .nutrition-table td {
+        display: flex;
+        justify-content: space-between;
+        gap: 1rem;
+        white-space: normal;
+      }
+
+      .nutrition-table tbody tr:last-child td:not(:last-child) {
+        border-block-end: 1px solid var(--secondary);
+      }
+
+      .nutrition-table td::before {
+        font-weight: 600;
+        text-align: start;
+      }
+
+      .nutrition-table td:nth-child(2)::before { content: "Size"; }
+      .nutrition-table td:nth-child(3)::before { content: "Calories"; }
+      .nutrition-table td:nth-child(4)::before { content: "Total fat"; }
+      .nutrition-table td:nth-child(5)::before { content: "Sugar"; }
+      .nutrition-table td:nth-child(6)::before { content: "Caffeine"; }
+      .nutrition-table td:nth-child(7)::before { content: "Price"; }
+    }
