+  <script>
+    // Verified-asset loader: integrity-checked, credential-less, no-referrer.
+    (function () {
+      'use strict';
+
+      // These options are fixed. They are never relaxed and never fall back
+      // to an unverified request.
+      function fetchVerified(url, integrity) {
+        return fetch(url, {
+          mode: 'cors',               // required for SRI on cross-origin responses
+          credentials: 'omit',        // no cookies / HTTP auth / client certs
+          referrerPolicy: 'no-referrer',
+          integrity: integrity,       // browser rejects the response on hash mismatch
+          redirect: 'error'
+        }).then(function (res) {
+          if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + url);
+          return res;
+        });
+      }
+
+      function warn(kind, url, err) {
+        console.warn('[verified-assets] ' + kind + ' not loaded (' + url + '):', err);
+      }
+
+      // Fonts: self-describing @fontsource builds, pinned by version + hash.
+      var FONTS = [
+        {
+          family: 'Playfair Display', weight: '700', style: 'normal',
+          url: 'https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.1.0/files/playfair-display-latin-700-normal.woff2',
+          integrity: 'sha384-2OUMztuc2Uvfq3n8w2APnig7JM4X9miM/re2XmGSZqKU6gdoOGFHDSiACwWV1wfK'
+        },
+        {
+          family: 'Lato', weight: '400', style: 'normal',
+          url: 'https://cdn.jsdelivr.net/npm/@fontsource/lato@5.1.0/files/lato-latin-400-normal.woff2',
+          integrity: 'sha384-+chn3xqCWRPSXDBtVEFQn+0J9Gb0SYR2FO1WrXo+L/arnyr8lXLVX2p0BqZIUemc'
+        }
+      ];
+
+      if ('FontFace' in window && document.fonts) {
+        FONTS.forEach(function (f) {
+          fetchVerified(f.url, f.integrity)
+            .then(function (res) { return res.arrayBuffer(); })
+            .then(function (buf) {
+              var face = new FontFace(f.family, buf, {
+                weight: f.weight, style: f.style, display: 'swap'
+              });
+              return face.load();
+            })
+            .then(function (face) { document.fonts.add(face); })
+            .catch(function (err) { warn('font', f.url, err); });
+        });
+      }
+
+      // Load an image's verified bytes and return a same-document blob: URL.
+      function verifiedObjectURL(url, integrity) {
+        return fetchVerified(url, integrity)
+          .then(function (res) { return res.blob(); })
+          .then(function (blob) {
+            if (blob.type && blob.type.indexOf('image/') !== 0) {
+              throw new Error('Unexpected content type ' + blob.type);
+            }
+            return URL.createObjectURL(blob);
+          });
+      }
+
+      // Hero background
+      document.querySelectorAll('[data-verified-bg]').forEach(function (el) {
+        var url = el.getAttribute('data-verified-bg');
+        verifiedObjectURL(url, el.getAttribute('data-integrity'))
+          .then(function (objUrl) {
+            el.style.setProperty('--hero-image', 'url("' + objUrl + '")');
+          })
+          .catch(function (err) { warn('background image', url, err); });
+      });
+
+      // Seasonal card images
+      document.querySelectorAll('img[data-verified-src]').forEach(function (img) {
+        var url = img.getAttribute('data-verified-src');
+        verifiedObjectURL(url, img.getAttribute('data-integrity'))
+          .then(function (objUrl) {
+            img.addEventListener('load', function () {
+              img.classList.add('is-loaded');
+              URL.revokeObjectURL(objUrl);
+            }, { once: true });
+            img.src = objUrl;
+          })
+          .catch(function (err) { warn('image', url, err); });
+      });
+
+      // Icons: the Lucide script only runs if its integrity check passed.
+      function renderIcons() {
+        if (window.lucide && typeof window.lucide.createIcons === 'function') {
+          window.lucide.createIcons();
+        }
+      }
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', renderIcons);
+      } else {
+        renderIcons();
+      }
+    })();
+  </script>
