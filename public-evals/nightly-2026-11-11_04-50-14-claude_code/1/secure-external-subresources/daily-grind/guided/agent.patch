+      const hour = now.hour();
+      const part = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';
+      greeting.textContent = `${part} \u2014 ${now.format('dddd, MMMM D')}`;
+    }
