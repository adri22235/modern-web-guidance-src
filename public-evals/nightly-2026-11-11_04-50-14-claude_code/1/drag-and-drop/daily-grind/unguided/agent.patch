+  <script>
+    (function () {
+      const grid = document.getElementById('seasonal-grid');
+      const status = document.getElementById('reorder-status');
+      if (!grid) return;
+
+      const STORAGE_KEY = 'dailyGrind.seasonalOrder';
+      const DRAG_THRESHOLD = 5;
+      const ANIM = 'transform 200ms ease';
+
+      const cards = () => Array.from(grid.querySelectorAll(':scope > .card'));
+      const nameOf = (card) => card.querySelector('h3')?.textContent.trim() || 'Card';
+
+      // ---- Persistence ----
+      function restoreOrder() {
+        let saved;
+        try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch (_) { saved = null; }
+        if (!Array.isArray(saved)) return;
+        const byId = new Map(cards().map((c) => [c.dataset.id, c]));
+        saved.forEach((id) => {
+          const card = byId.get(id);
+          if (card) grid.appendChild(card);
+        });
+      }
+
+      function saveOrder() {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(cards().map((c) => c.dataset.id))); } catch (_) { }
+      }
+
+      // ---- Helpers ----
+      // Cards sharing the same visual row (same top offset), in DOM order.
+      function rowOf(card) {
+        return cards().filter((c) => Math.abs(c.offsetTop - card.offsetTop) < 2);
+      }
+
+      // Animate siblings from their previous positions to their new ones (FLIP).
+      function withFlip(elements, mutate) {
+        const before = new Map(elements.map((el) => [el, el.getBoundingClientRect().left]));
+        mutate();
+        elements.forEach((el) => {
+          const delta = before.get(el) - el.getBoundingClientRect().left;
+          if (!delta) return;
+          el.style.transition = 'none';
+          el.style.transform = `translateX(${delta}px)`;
+          el.getBoundingClientRect(); // force reflow
+          el.style.transition = ANIM;
+          el.style.transform = '';
+        });
+      }
+
+      // Move `card` to position `index` among the other cards of `row`.
+      function placeInRow(card, row, index) {
+        const others = row.filter((c) => c !== card);
+        const ref = index < others.length ? others[index] : others[others.length - 1].nextElementSibling;
+        if (ref !== card) grid.insertBefore(card, ref);
+      }
+
+      function announce(card) {
+        const row = rowOf(card);
+        status.textContent = `${nameOf(card)} moved to position ${row.indexOf(card) + 1} of ${row.length}.`;
+      }
+
+      // ---- Pointer dragging ----
+      let drag = null;
+
+      grid.addEventListener('pointerdown', (e) => {
+        if (e.button !== 0 || drag) return;
+        const card = e.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+        if (e.target.closest('a, button, input, select, textarea, label')) return;
+
+        drag = {
+          card,
+          pointerId: e.pointerId,
+          startX: e.clientX,
+          // Constant offset between the pointer (viewport coords) and the card's layout position.
+          grabDelta: e.clientX - card.offsetLeft,
+          started: false,
+          row: null,
+        };
+        card.setPointerCapture(e.pointerId);
+      });
+
+      grid.addEventListener('pointermove', (e) => {
+        if (!drag || e.pointerId !== drag.pointerId) return;
+        const { card } = drag;
+
+        if (!drag.started) {
+          if (Math.abs(e.clientX - drag.startX) < DRAG_THRESHOLD) return;
+          drag.started = true;
+          drag.row = rowOf(card);
+          card.classList.add('dragging');
+          document.body.classList.add('is-reordering');
+        }
+
+        e.preventDefault();
+        const row = drag.row;
+        const lefts = row.map((c) => c.offsetLeft);
+        const minLeft = Math.min(...lefts);
+        const maxLeft = Math.max(...lefts);
+        const desiredLeft = Math.min(maxLeft, Math.max(minLeft, e.clientX - drag.grabDelta));
+        const desiredCenter = desiredLeft + card.offsetWidth / 2;
+
+        // New index = number of other row cards whose center lies left of the dragged card's center.
+        const others = row.filter((c) => c !== card);
+        const newIndex = others.filter((c) => c.offsetLeft + c.offsetWidth / 2 < desiredCenter).length;
+        const currentIndex = rowOf(card).indexOf(card);
+
+        if (newIndex !== currentIndex) {
+          withFlip(others, () => placeInRow(card, row, newIndex));
+          drag.row = rowOf(card);
+        }
+
+        card.style.transition = 'none';
+        card.style.transform = `translateX(${desiredLeft - card.offsetLeft}px)`;
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.pointerId) return;
+        const { card, started } = drag;
+        drag = null;
+        if (card.hasPointerCapture(e.pointerId)) card.releasePointerCapture(e.pointerId);
+        if (!started) return;
+
+        card.classList.remove('dragging');
+        document.body.classList.remove('is-reordering');
+        card.style.transition = ANIM;
+        card.style.transform = '';
+        saveOrder();
+        announce(card);
+      }
+
+      grid.addEventListener('pointerup', endDrag);
+      grid.addEventListener('pointercancel', endDrag);
+
+      // ---- Keyboard reordering ----
+      grid.addEventListener('keydown', (e) => {
+        const card = e.target;
+        if (!card.classList || !card.classList.contains('card')) return;
+        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+
+        const row = rowOf(card);
+        const index = row.indexOf(card);
+        const newIndex = index + (e.key === 'ArrowLeft' ? -1 : 1);
+        if (newIndex < 0 || newIndex >= row.length) return;
+
+        e.preventDefault();
+        withFlip(row, () => placeInRow(card, row, newIndex));
+        card.focus();
+        saveOrder();
+        announce(card);
+      });
+
+      // ---- Init ----
+      restoreOrder();
+      cards().forEach((card) => {
+        card.tabIndex = 0;
+        card.setAttribute('aria-roledescription', 'reorderable card');
+        card.addEventListener('transitionend', (ev) => {
+          if (ev.propertyName === 'transform') card.style.transition = '';
+        });
+      });
+    })();
+  </script>
+
