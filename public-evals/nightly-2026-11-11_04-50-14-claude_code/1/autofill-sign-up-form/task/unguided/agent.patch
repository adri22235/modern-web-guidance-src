+  <script>
+    (function () {
+      const form = document.getElementById('signup-form');
+      const section = document.getElementById('signup');
+      const password = form.elements.password;
+      const confirm = form.elements.confirmPassword;
+
+      function errorEl(input) {
+        return input.closest('.form-group').querySelector('.error-msg');
+      }
+
+      function validate(input) {
+        let msg = '';
+        if (input.type === 'checkbox') {
+          if (!input.checked) msg = 'You must accept the terms to continue.';
+        } else if (!input.value.trim()) {
+          msg = 'This field is required.';
+        } else if (input.type === 'email' && input.validity.typeMismatch) {
+          msg = 'Please enter a valid email address.';
+        } else if (input === password && input.value.length < 8) {
+          msg = 'Password must be at least 8 characters.';
+        } else if (input === confirm && input.value !== password.value) {
+          msg = 'Passwords do not match.';
+        }
+        errorEl(input).textContent = msg;
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+        return !msg;
+      }
+
+      const fields = Array.from(form.querySelectorAll('[required]'));
+
+      fields.forEach(function (input) {
+        input.addEventListener(input.type === 'checkbox' ? 'change' : 'blur', function () {
+          validate(input);
+        });
+      });
+
+      password.addEventListener('input', function () {
+        if (confirm.value) validate(confirm);
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const invalid = fields.filter(function (input) { return !validate(input); });
+        if (invalid.length) {
+          invalid[0].focus();
+          return;
+        }
+        // TODO: send the data to the backend sign-up endpoint (form.action) once available.
+        section.classList.add('submitted');
+        form.reset();
+      });
+    })();
+  </script>
+
