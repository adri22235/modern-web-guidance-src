       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Featured promo badge (Seasonal Favorites) */
+    .promo-track {
+      display: flex;
+      justify-content: center;
+      padding: 24px 0 8px;
+      overflow: hidden;
+    }
+
+    .target {
+      display: grid;
+      place-items: center;
+      width: 110px;
+      aspect-ratio: 1;
+      border-radius: 50%;
+      background: radial-gradient(circle at 30% 30%, #ffd180, var(--accent) 60%, #ff8f00);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.3);
+      font-weight: bold;
+      font-size: 0.8rem;
+      line-height: 1.2;
+      text-align: center;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+      cursor: default;
+
+      /* Identity values for every transform property that changes, so the
+         stacking context and containing block exist from the start and do
+         not flip when the animations or the hover transition kick in. */
+      position: relative;
+      z-index: 1;
+      translate: 0 0;
+      rotate: 0deg;
+      scale: 1;
+
+      /* Only `scale` transitions; `rotate` and `translate` are owned by the
+         animations, so hover never restarts or interrupts them. */
+      transition: scale 0.3s ease;
+
+      @media (prefers-reduced-motion: no-preference) {
+        animation:
+          badge-spin 6s linear infinite,
+          badge-slide 4s ease-in-out infinite alternate;
+      }
+    }
+
+    .target:hover {
+      scale: 1.2;
+    }
+
+    @keyframes badge-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes badge-slide {
+      from { translate: -120px 0; }
+      to { translate: 120px 0; }
+    }
   </style>
 </head>
 
