+      function populate(drink) {
+        titleEl.textContent = drink.title;
+        descEl.textContent = drink.desc;
+        media.style.backgroundImage = `url("${drink.image}")`;
+        media.setAttribute('aria-label', drink.alt);
+        metaEl.replaceChildren(...drink.meta.map((m) => {
+          const li = document.createElement('li');
+          li.textContent = m;
+          return li;
+        }));
+        linkEl.href = drink.href;
+      }
+
+      // Native exit transitions need both `overlay` and discrete `display` transitions.
+      let displayTransitionSupport;
+      function canTransitionDisplay() {
+        if (displayTransitionSupport !== undefined) return displayTransitionSupport;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return (displayTransitionSupport = false);
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        displayTransitionSupport = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return displayTransitionSupport;
+      }
+      const supportsTopLayerExit = () => !!window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+
+      async function closeDialog() {
+        if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+        if (!supportsTopLayerExit()) {
+          dialog.setAttribute('data-closing', '');
+          const animations = dialog.getAnimations({ subtree: true });
+          // Reduced motion / no transitions: nothing to wait for
+          if (animations.length > 0) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 1000)),
+            ]);
+          }
+          if (!dialog.hasAttribute('data-closing')) return;
+          dialog.removeAttribute('data-closing');
+        }
+        dialog.close();
+      }
+
+      function openDialog(key) {
+        const drink = drinks[key];
+        if (!drink) return;
+        dialog.removeAttribute('data-closing');
+        populate(drink);
+        if (!dialog.open) dialog.showModal();
+      }
+
+      document.querySelectorAll('.view-details').forEach((btn) => {
+        btn.addEventListener('click', () => openDialog(btn.closest('.card').dataset.drink));
+      });
+
+      dialog.querySelector('[data-close]').addEventListener('click', closeDialog);
+
+      // Route Esc / light-dismiss close requests through the animated close
+      dialog.addEventListener('cancel', (event) => {
+        event.preventDefault();
+        closeDialog();
+      });
+
+      // Light-dismiss fallback where closedby isn't supported
+      if (!('closedBy' in HTMLDialogElement.prototype)) {
+        const outside = (e) => {
+          const r = dialog.getBoundingClientRect();
+          return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+        };
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+        dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) closeDialog(); });
+      }
+    })();
+  </script>
