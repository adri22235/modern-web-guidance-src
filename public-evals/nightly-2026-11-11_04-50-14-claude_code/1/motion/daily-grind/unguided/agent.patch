+        'transitionstart', 'transitionend', 'transitioncancel'
+      ].forEach(function (type) {
+        document.addEventListener(type, recordAnimationState, { capture: true, passive: true });
+      });
+
+      /* ------------------------------------------------------------------
+       * Daily roast banner pause / resume
+       * ------------------------------------------------------------------ */
+      var banner = document.getElementById('roast-banner');
+      var toggle = banner && banner.querySelector('.roast-toggle');
+      if (banner && toggle) {
+        var icon = toggle.querySelector('.roast-toggle__icon');
+        var label = toggle.querySelector('.roast-toggle__label');
+        toggle.addEventListener('click', function () {
+          var paused = banner.classList.toggle('is-paused');
+          toggle.setAttribute('aria-pressed', String(paused));
+          label.textContent = paused ? 'Play' : 'Pause';
+          icon.innerHTML = paused ? '&#9654;' : '&#10074;&#10074;';
+        });
+      }
+
+      /* ------------------------------------------------------------------
+       * Drink details overlay
+       * ------------------------------------------------------------------ */
+      var overlay = document.getElementById('drink-overlay');
+      if (!overlay) return;
+      var panel = overlay.querySelector('.drink-overlay__panel');
+      var titleEl = overlay.querySelector('#drink-overlay-title');
+      var priceEl = overlay.querySelector('.drink-overlay__price');
+      var descEl = overlay.querySelector('#drink-overlay-desc');
+      var notesEl = overlay.querySelector('.drink-overlay__notes');
+      var imgEl = overlay.querySelector('.drink-overlay__img');
+      var moreEl = overlay.querySelector('.drink-overlay__more');
+      var backgroundEls = Array.prototype.filter.call(body.children, function (el) {
+        return el !== overlay && el.tagName !== 'SCRIPT';
+      });
+      var lastTrigger = null;
+      var closeTimer = null;
+
+      imgEl.addEventListener('error', function () { imgEl.hidden = true; });
+
+      function setBackgroundInert(on) {
+        backgroundEls.forEach(function (el) {
+          if (on) el.setAttribute('inert', ''); else el.removeAttribute('inert');
+        });
+      }
+
+      function finishClose() {
+        clearTimeout(closeTimer);
+        closeTimer = null;
+        panel.removeEventListener('animationend', onCloseAnimationEnd);
+        overlay.classList.remove('is-closing');
+        overlay.hidden = true;
+        body.classList.remove('overlay-open');
+        setBackgroundInert(false);
+        if (lastTrigger) lastTrigger.focus();
+      }
+
+      function onCloseAnimationEnd(event) {
+        if (event.target === panel) finishClose();
+      }
+
+      function openOverlay(trigger) {
+        if (closeTimer) finishClose();
+        lastTrigger = trigger;
+        var d = trigger.dataset;
+        titleEl.textContent = d.name || '';
+        priceEl.textContent = d.price || '';
+        descEl.textContent = d.description || '';
+        notesEl.textContent = '';
+        (d.notes || '').split('|').filter(Boolean).forEach(function (note) {
+          var li = document.createElement('li');
+          li.textContent = note;
+          notesEl.appendChild(li);
+        });
+        imgEl.hidden = !d.image;
+        if (d.image) {
+          imgEl.src = d.image;
+          imgEl.alt = d.alt || '';
+        }
+        moreEl.href = trigger.getAttribute('href') || '#';
+
+        overlay.classList.remove('is-closing');
+        overlay.hidden = false;
+        body.classList.add('overlay-open');
+        setBackgroundInert(true);
+        panel.focus({ preventScroll: true });
+      }
+
+      function closeOverlay() {
+        if (overlay.hidden || overlay.classList.contains('is-closing')) return;
+        overlay.classList.add('is-closing');
+        panel.addEventListener('animationend', onCloseAnimationEnd);
+        // Safety net in case animationend never fires (e.g. animations disabled).
+        closeTimer = setTimeout(finishClose, reducedMotion.matches ? 200 : 450);
+      }
+
+      document.querySelectorAll('.js-drink-details').forEach(function (btn) {
+        btn.setAttribute('role', 'button');
+        btn.addEventListener('click', function (event) {
+          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button === 1) return;
+          event.preventDefault();
+          openOverlay(btn);
+        });
+        btn.addEventListener('keydown', function (event) {
+          if (event.key === ' ') {
+            event.preventDefault();
+            openOverlay(btn);
+          }
+        });
+      });
+
+      overlay.addEventListener('click', function (event) {
+        if (event.target.closest('[data-overlay-close]')) closeOverlay();
+      });
+
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && !overlay.hidden) closeOverlay();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
