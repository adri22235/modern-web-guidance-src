index 0000000..8f035b5
--- /dev/null
+++ b/src/scripts/sectionRouter.ts
@@ -0,0 +1,248 @@
+/**
+ * Client-side router for the main section views (Top News, World, Politics,
+ * Multimedia, Reports).
+ *
+ * - Views are lazily fetched from `/sections/<id>` the first time they are
+ *   needed (or prefetched on hover/focus of a link) and then kept in the DOM.
+ * - Inactive views are hidden with `content-visibility: hidden` (+ `inert`), so
+ *   the browser keeps their rendering state cached and switching back is a cheap
+ *   class toggle instead of a destroy/rebuild.
+ * - Astro's ClientRouter is kept for all other navigations; we pre-empt it for
+ *   section links (capture-phase click + popstate) while the views are mounted.
+ */
+
+const CONTAINER_ID = 'section-views';
+
+const container = () => document.getElementById(CONTAINER_ID);
+
+const views = (root: ParentNode | null = container()) =>
+  root ? Array.from(root.querySelectorAll<HTMLElement>(':scope > .spa-view')) : [];
+
+const normalizePath = (p: string) => p.replace(/\/+$/, '') || '/';
+
+/** Returns the view for a URL, if it is a section URL and the views are mounted. */
+function viewForUrl(url: URL): HTMLElement | undefined {
+  if (url.origin !== location.origin || url.search) return undefined;
+  const path = normalizePath(url.pathname);
+  return views().find(
+    (v) => normalizePath(new URL(v.dataset.href!, location.href).pathname) === path,
+  );
+}
+
+const activeView = () => views().find((v) => !v.classList.contains('inactive'));
+
+const pendingLoads = new WeakMap<HTMLElement, Promise<void>>();
+
+/** Inserts server-rendered HTML so that island/hydration scripts execute. */
+function fillView(view: HTMLElement, html: string) {
+  const range = document.createRange();
+  range.selectNodeContents(view);
+  view.replaceChildren(range.createContextualFragment(html));
+  view.dataset.loaded = 'true';
+}
+
+/** Fetches a view's markup once; concurrent calls share the same request. */
+function loadView(view: HTMLElement): Promise<void> {
+  if (view.dataset.loaded === 'true') return Promise.resolve();
+  let pending = pendingLoads.get(view);
+  if (!pending) {
+    pending = fetch(view.dataset.src!, { headers: { Accept: 'text/html' } })
+      .then((res) => {
+        if (!res.ok) throw new Error(`Failed to load section (${res.status})`);
+        return res.text();
+      })
+      .then((html) => {
+        if (view.dataset.loaded !== 'true') fillView(view, html);
+      })
+      .finally(() => pendingLoads.delete(view));
+    pendingLoads.set(view, pending);
+  }
+  return pending;
+}
+
+function updateNav(activeId: string) {
+  document.querySelectorAll<HTMLAnchorElement>('a[data-section-link]').forEach((link) => {
+    if (link.dataset.sectionLink === activeId) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  });
+}
+
+/** Shows `target` and hides (but keeps) every other view. */
+function activate(target: HTMLElement, { focus }: { focus: boolean }) {
+  for (const view of views()) {
+    const isTarget = view === target;
+    view.classList.toggle('inactive', !isTarget);
+    view.inert = !isTarget;
+    if (isTarget) view.removeAttribute('aria-hidden');
+    else view.setAttribute('aria-hidden', 'true');
+  }
+  document.title = target.dataset.title ?? document.title;
+  updateNav(target.dataset.section!);
+  if (focus) target.focus({ preventScroll: true });
+}
+
+/** Last known scroll position per view, used for fresh (pushed) visits. */
+const lastScroll = new Map<string, number>();
+
+/** Scroll position at which the views start, i.e. "top of the section". */
+function viewsTop() {
+  const root = container();
+  return root ? Math.max(0, root.getBoundingClientRect().top + scrollY) : 0;
+}
+
+function saveScrollToHistory() {
+  if (history.state) {
+    history.replaceState({ ...history.state, scrollX, scrollY }, '');
+  }
+}
+
+let navigationId = 0;
+
+async function goTo(
+  view: HTMLElement,
+  mode: 'push' | 'pop',
+  popState?: { scrollX?: number; scrollY?: number } | null,
+) {
+  const current = activeView();
+  const id = ++navigationId;
+  const href = view.dataset.href!;
+
+  if (current === view) {
+    if (mode === 'push') {
+      // Clicking the active section scrolls back to its start.
+      if (location.pathname !== new URL(href, location.href).pathname) {
+        history.replaceState(history.state, '', href);
+      }
+      if (scrollY > viewsTop()) scrollTo({ top: viewsTop() });
+    }
+    return;
+  }
+
+  if (view.dataset.loaded !== 'true') {
+    container()?.setAttribute('aria-busy', 'true');
+    try {
+      await loadView(view);
+    } catch (error) {
+      console.error(error);
+      // Fall back to a regular page load.
+      if (mode === 'push') location.assign(href);
+      else location.reload();
+      return;
+    } finally {
+      if (id === navigationId) container()?.removeAttribute('aria-busy');
+    }
+    // A newer navigation started while this one was loading.
+    if (id !== navigationId) return;
+  }
+
+  if (current) lastScroll.set(current.dataset.section!, scrollY);
+
+  let top: number;
+  if (mode === 'push') {
+    saveScrollToHistory();
+    const stored = lastScroll.get(view.dataset.section!);
+    top = stored ?? Math.min(scrollY, viewsTop());
+    // Reuse the current index so Astro's ClientRouter history bookkeeping stays consistent.
+    history.pushState(
+      { index: history.state?.index ?? 0, scrollX: 0, scrollY: top, section: view.dataset.section },
+      '',
+      href,
+    );
+  } else {
+    top = popState?.scrollY ?? lastScroll.get(view.dataset.section!) ?? 0;
+  }
+
+  activate(view, { focus: true });
+  scrollTo({ left: 0, top, behavior: 'instant' });
+}
+
+function onClick(event: MouseEvent) {
+  if (
+    event.defaultPrevented ||
+    event.button !== 0 ||
+    event.metaKey ||
+    event.ctrlKey ||
+    event.shiftKey ||
+    event.altKey
+  ) {
+    return;
+  }
+  const link = (event.target as Element | null)?.closest?.('a[href]');
+  if (!(link instanceof HTMLAnchorElement)) return;
+  if (
+    (link.target && link.target !== '_self') ||
+    link.hasAttribute('download') ||
+    link.hasAttribute('data-astro-reload')
+  ) {
+    return;
+  }
+  const url = new URL(link.href);
+  if (url.hash && normalizePath(url.pathname) === normalizePath(location.pathname)) return;
+  const view = viewForUrl(url);
+  if (!view) return;
+
+  // Pre-empt Astro's ClientRouter, which ignores default-prevented clicks.
+  event.preventDefault();
+  goTo(view, 'push');
+}
+
+function onPopState(event: PopStateEvent) {
+  const view = viewForUrl(new URL(location.href));
+  if (!view) return; // Not a section (or views not mounted): let Astro handle it.
+  event.stopImmediatePropagation();
+  goTo(view, 'pop', event.state);
+}
+
+/** Warm up a view's markup when the user shows intent to visit it. */
+function onIntent(event: Event) {
+  const link = (event.target as Element | null)?.closest?.('a[href]');
+  if (!(link instanceof HTMLAnchorElement)) return;
+  const view = viewForUrl(new URL(link.href));
+  if (view && view.dataset.loaded !== 'true') loadView(view).catch(() => {});
+}
+
+/**
+ * Before ClientRouter swaps in a new page, the persisted container (with all
+ * cached views) replaces the freshly rendered one. Carry over any view the new
+ * page rendered that we haven't cached yet, so we don't need to refetch it.
+ */
+function onBeforeSwap(event: Event) {
+  const newDocument = (event as Event & { newDocument?: Document }).newDocument;
+  const newRoot = newDocument?.getElementById(CONTAINER_ID);
+  if (!newRoot) return;
+  for (const newView of views(newRoot)) {
+    if (newView.dataset.loaded !== 'true') continue;
+    const oldView = views().find((v) => v.dataset.section === newView.dataset.section);
+    if (oldView && oldView.dataset.loaded !== 'true') fillView(oldView, newView.innerHTML);
+  }
+}
+
+/** Makes the mounted views match the current URL (initial load and after swaps). */
+function syncWithLocation() {
+  const view = viewForUrl(new URL(location.href));
+  if (!view) return;
+  if (view.dataset.loaded === 'true') {
+    activate(view, { focus: false });
+  } else {
+    loadView(view)
+      .then(() => {
+        if (viewForUrl(new URL(location.href)) === view) activate(view, { focus: false });
+      })
+      .catch(() => location.reload());
+  }
+}
+
+export function initSectionRouter() {
+  // Guard on window: the script may be inlined and evaluated in a fresh module scope.
+  const w = window as Window & { __sectionRouterInit?: boolean };
+  if (w.__sectionRouterInit) return;
+  w.__sectionRouterInit = true;
+
+  // Capture phase so we run before ClientRouter's listeners.
+  document.addEventListener('click', onClick, { capture: true });
+  window.addEventListener('popstate', onPopState, { capture: true });
+  document.addEventListener('pointerover', onIntent, { passive: true });
+  document.addEventListener('focusin', onIntent);
+  document.addEventListener('astro:before-swap', onBeforeSwap);
+  document.addEventListener('astro:page-load', syncWithLocation);
+}
