new file mode 100644
index 0000000..3b9facd
--- /dev/null
+++ b/src/data/sections.ts
@@ -0,0 +1,51 @@
+/**
+ * Main section navigation config. Each section is rendered as a client-side
+ * SPA view (see components/SectionViews.astro); the server still renders every
+ * section at its own URL so deep links and no-JS visits work.
+ */
+export const SECTION_IDS = ['top-news', 'world', 'politics', 'multimedia', 'reports'] as const;
+export type SectionId = (typeof SECTION_IDS)[number];
+
+export interface Section {
+  id: SectionId;
+  label: string;
+  /** Path relative to the site base ('' = home). */
+  path: string;
+  title: string;
+}
+
+export const SECTIONS: Section[] = [
+  { id: 'top-news', label: 'Top News', path: '', title: 'The DevTools Times' },
+  { id: 'world', label: 'World', path: 'world', title: 'World | The DevTools Times' },
+  { id: 'politics', label: 'Politics', path: 'politics', title: 'Politics | The DevTools Times' },
+  { id: 'multimedia', label: 'Multimedia', path: 'multimedia', title: 'Multimedia | The DevTools Times' },
+  { id: 'reports', label: 'Reports', path: 'reports', title: 'Reports | The DevTools Times' },
+];
+
+export function isSectionId(value: unknown): value is SectionId {
+  return typeof value === 'string' && (SECTION_IDS as readonly string[]).includes(value);
+}
+
+export function getSection(id: SectionId): Section {
+  return SECTIONS.find((s) => s.id === id)!;
+}
+
+/** Joins a path onto the configured base URL, regardless of trailing slashes. */
+export function withBase(path: string): string {
+  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
+  return `${base}/${path.replace(/^\/+/, '')}`;
+}
+
+/** Canonical (full page) URL of a section. */
+export const sectionHref = (section: Section) => withBase(section.path);
+
+/** URL of the HTML fragment endpoint used to lazily load a view client-side. */
+export const sectionPartialHref = (section: Section) => withBase(`sections/${section.id}`);
+
+const normalizePath = (p: string) => p.replace(/\/+$/, '') || '/';
+
+/** Resolves the section that a pathname belongs to, if any. */
+export function sectionForPath(pathname: string): Section | undefined {
+  const path = normalizePath(pathname);
+  return SECTIONS.find((s) => normalizePath(sectionHref(s)) === path);
+}
