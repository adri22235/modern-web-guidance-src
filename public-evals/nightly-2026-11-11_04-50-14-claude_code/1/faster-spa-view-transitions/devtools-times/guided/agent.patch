diff --git a/src/components/SectionViews.astro b/src/components/SectionViews.astro
new file mode 100644
index 0000000..8bfddfd
--- /dev/null
+++ b/src/components/SectionViews.astro
@@ -0,0 +1,45 @@
+---
+import { SECTIONS, sectionHref, sectionPartialHref, type SectionId } from '../data/sections';
+import SectionView from './sections/SectionView.astro';
+
+export interface Props {
+    active: SectionId;
+}
+
+const { active } = Astro.props;
+---
+<!--
+  Client-side SPA views for the main sections. Only the active view is rendered
+  on the server; other views are fetched once on first visit and then kept in the
+  DOM (hidden with `content-visibility: hidden`) so returning to them is instant.
+  `transition:persist` keeps the cached views alive across ClientRouter page swaps
+  (e.g. section -> article -> back).
+-->
+<div id="section-views" class="relative" transition:persist="section-views">
+    {SECTIONS.map(section => {
+        const isActive = section.id === active;
+        return (
+            <div
+                class:list={['spa-view', { inactive: !isActive }]}
+                id={`section-view-${section.id}`}
+                data-section={section.id}
+                data-href={sectionHref(section)}
+                data-src={sectionPartialHref(section)}
+                data-title={section.title}
+                data-loaded={isActive ? 'true' : 'false'}
+                aria-label={section.label}
+                role="region"
+                tabindex="-1"
+                inert={!isActive}
+                aria-hidden={isActive ? undefined : 'true'}
+            >
+                {isActive && <SectionView id={section.id} />}
+            </div>
+        );
+    })}
+</div>
+
+<script>
+    import { initSectionRouter } from '../scripts/sectionRouter';
+    initSectionRouter();
+</script>
