+/*
+ * SPA section views: inactive views stay in the DOM with their rendering state
+ * cached, so switching back to them skips layout/paint work entirely.
+ */
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset-inline: 0;
+  inset-block-start: 0;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
+
+.spa-view:focus:not(:focus-visible) {
+  outline: none;
+}
