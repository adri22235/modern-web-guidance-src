+++ b/src/components/SectionNav.astro
@@ -0,0 +1,36 @@
+---
+import { SECTIONS, sectionHref, type SectionKey } from '../utils/sections';
+
+export interface Props {
+    current: SectionKey;
+}
+
+const { current } = Astro.props;
+---
+<nav
+    aria-label="Sections"
+    data-section-nav
+    class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-gray-200"
+>
+    <ul class="flex justify-center gap-1 sm:gap-4 overflow-x-auto px-4 text-sm font-semibold">
+        {SECTIONS.map((s) => (
+            <li>
+                <a
+                    href={sectionHref(s.key)}
+                    data-section-link={s.key}
+                    aria-current={s.key === current ? 'page' : undefined}
+                    class="section-link block whitespace-nowrap px-3 py-3 border-b-2 border-transparent text-gray-600 hover:text-gray-900 transition-colors"
+                >
+                    {s.label}
+                </a>
+            </li>
+        ))}
+    </ul>
+</nav>
+
+<style>
+    .section-link[aria-current='page'] {
+        color: var(--color-gray-900);
+        border-bottom-color: var(--color-amber-400);
+    }
+</style>
diff --git a/src/layouts/SectionLayout.astro b/src/layouts/SectionLayout.astro
new file mode 100644
index 0000000..a7e4a85
--- /dev/null
+++ b/src/layouts/SectionLayout.astro
@@ -0,0 +1,37 @@
+---
+import Layout from './Layout.astro';
+import SectionNav from '../components/SectionNav.astro';
+import { getSection, sectionHref, type SectionKey } from '../utils/sections';
+
+export interface Props {
+    section: SectionKey;
+    title?: string;
+}
+
+const { section } = Astro.props;
+const meta = getSection(section);
+const title = Astro.props.title ?? meta.title;
+---
+<Layout title={title}>
+    <SectionNav current={section} />
+
+    <!--
+        SPA shell: every section the reader visits is kept here as a sibling
+        view. Only the active one is shown; the others stay mounted (hidden),
+        so going back to them is instant and keeps their DOM / island state.
+        See src/scripts/section-views.ts.
+    -->
+    <div data-section-shell>
+        <div
+            data-section-view={section}
+            data-section-path={sectionHref(section)}
+            data-section-title={title}
+        >
+            <slot />
+        </div>
+    </div>
+</Layout>
+
+<script>
+    import '../scripts/section-views';
+</script>
