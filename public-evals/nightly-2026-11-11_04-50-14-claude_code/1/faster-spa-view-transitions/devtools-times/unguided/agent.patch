diff --git a/src/scripts/section-views.ts b/src/scripts/section-views.ts
new file mode 100644
index 0000000..34365b8
--- /dev/null
+++ b/src/scripts/section-views.ts
@@ -0,0 +1,139 @@
+/**
+ * Client-side SPA views for the main sections (Top News, World, Politics,
+ * Multimedia, Reports).
+ *
+ * Navigation itself (link interception, history, scroll restoration, view
+ * transitions) is still handled by Astro's <ClientRouter />. This module hooks
+ * into its lifecycle events to change *what* happens on a section switch:
+ *
+ *  - Default ClientRouter behaviour: fetch the whole page, then replace
+ *    <body>, destroying every DOM node and unmounting every island.
+ *  - Here, when both the current and the target page use the section shell:
+ *      • first visit to a section: fetch it once, move only its view element
+ *        into the shell, and hide the previously active view;
+ *      • any later visit: skip the network entirely and simply unhide the
+ *        view that is already in the DOM (state, scroll-independent UI state,
+ *        hydrated React islands, loaded images… are all preserved).
+ *
+ * Navigating to a page that isn't a section (an article, sign-in, …) falls
+ * back to the regular full swap, which also cleans up all cached views.
+ */
+import { swapFunctions } from 'astro:transitions/client';
+
+const SHELL = '[data-section-shell]';
+const VIEW = ':scope > [data-section-view]';
+
+/** Synthetic documents created for cache hits → the view they should show. */
+const cacheHits = new WeakMap<Document, HTMLElement>();
+
+const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
+
+const getShell = (doc: Document = document) => doc.querySelector<HTMLElement>(SHELL);
+
+const viewPath = (view: HTMLElement) =>
+    normalizePath(new URL(view.dataset.sectionPath ?? '', location.href).pathname);
+
+function findView(shell: HTMLElement, url: URL) {
+    const target = normalizePath(url.pathname);
+    for (const view of shell.querySelectorAll<HTMLElement>(VIEW)) {
+        if (viewPath(view) === target) return view;
+    }
+    return undefined;
+}
+
+function activate(shell: HTMLElement, view: HTMLElement) {
+    if (view.parentElement !== shell) shell.append(view);
+    for (const other of shell.querySelectorAll<HTMLElement>(VIEW)) {
+        const active = other === view;
+        // `hidden` takes the inactive views out of layout/paint, `inert` keeps
+        // them out of the tab order and the accessibility tree.
+        other.hidden = !active;
+        other.inert = !active;
+    }
+    if (view.dataset.sectionTitle) document.title = view.dataset.sectionTitle;
+    updateNav(viewPath(view));
+}
+
+function updateNav(activePath: string) {
+    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-section-link]')) {
+        if (normalizePath(new URL(link.href).pathname) === activePath) {
+            link.setAttribute('aria-current', 'page');
+        } else {
+            link.removeAttribute('aria-current');
+        }
+    }
+}
+
+const sameHeadElement = (a: Element, b: Element) => {
+    if (a.tagName !== b.tagName) return false;
+    if (a instanceof HTMLLinkElement || a instanceof HTMLScriptElement) {
+        const attr = a instanceof HTMLLinkElement ? 'href' : 'src';
+        const aVal = a.getAttribute(attr);
+        if (aVal) return aVal === b.getAttribute(attr);
+    }
+    return a.isEqualNode(b);
+};
+
+/**
+ * Additive head merge. Unlike ClientRouter's swapHeadElements we never remove
+ * anything: styles needed by views that are now hidden must stay around for
+ * when they are shown again.
+ */
+function mergeHead(newDoc: Document) {
+    const existing = [...document.head.children];
+    for (const el of [...newDoc.head.children]) {
+        if (el.tagName === 'TITLE') continue;
+        if (existing.some((cur) => sameHeadElement(cur, el))) continue;
+        document.head.append(document.adoptNode(el));
+    }
+}
+
+document.addEventListener('astro:before-preparation', (event) => {
+    if (event.formData) return;
+    const shell = getShell();
+    if (!shell) return;
+    const cached = findView(shell, event.to);
+    if (!cached) return;
+
+    // Cache hit: don't fetch anything, the view is already in the DOM.
+    event.loader = async () => {
+        const doc = document.implementation.createHTMLDocument(cached.dataset.sectionTitle ?? document.title);
+        cacheHits.set(doc, cached);
+        event.newDocument = doc;
+    };
+});
+
+document.addEventListener('astro:before-swap', (event) => {
+    const shell = getShell();
+    if (!shell) return;
+    const newDoc = event.newDocument;
+
+    const cached = cacheHits.get(newDoc);
+    if (cached) {
+        event.swap = () => activate(shell, cached);
+        return;
+    }
+
+    // First visit to another section: graft its view into our shell.
+    const incomingView = getShell(newDoc)?.querySelector<HTMLElement>(VIEW);
+    if (!incomingView) return; // leaving the sections → regular full-page swap
+
+    event.swap = () => {
+        // Mark scripts that already ran so ClientRouter doesn't re-run them.
+        swapFunctions.deselectScripts(newDoc);
+        mergeHead(newDoc);
+
+        const view = document.adoptNode(incomingView);
+        view.dataset.sectionTitle ??= newDoc.title;
+        activate(shell, view);
+
+        // Body scripts outside the view (e.g. island directive / hydration
+        // scripts emitted in the header) that haven't run yet on this page.
+        // ClientRouter executes them after the swap.
+        for (const script of newDoc.body.querySelectorAll('script')) {
+            if (script.dataset.astroExec === undefined) {
+                document.body.append(document.adoptNode(script));
+            }
+        }
+    };
+});
diff --git a/src/utils/sections.ts b/src/utils/sections.ts
new file mode 100644
index 0000000..c87c5bd
--- /dev/null
+++ b/src/utils/sections.ts
@@ -0,0 +1,63 @@
+import { getCollection, type CollectionEntry, type RenderResult } from 'astro:content';
+
+/**
+ * The main sections of The DevTools Times. Each one is rendered as a client-side
+ * "view" inside the SectionLayout shell. The first request to a section is
+ * server-rendered (so every URL still works as a regular page); subsequent
+ * switches are handled on the client by `section-views.ts`, which keeps
+ * previously visited views alive offscreen instead of rebuilding them.
+ */
+export const SECTIONS = [
+    { key: 'top', label: 'Top News', path: '', title: 'The DevTools Times' },
+    { key: 'world', label: 'World', path: 'world', title: 'World – The DevTools Times' },
+    { key: 'politics', label: 'Politics', path: 'politics', title: 'Politics – The DevTools Times' },
+    { key: 'multimedia', label: 'Multimedia', path: 'multimedia', title: 'Multimedia' },
+    { key: 'reports', label: 'Reports', path: 'reports', title: 'Reports' },
+] as const;
+
+export type SectionKey = (typeof SECTIONS)[number]['key'];
+
+export function getSection(key: SectionKey) {
+    return SECTIONS.find((s) => s.key === key)!;
+}
+
+export function sectionHref(key: SectionKey) {
+    return `${import.meta.env.BASE_URL}${getSection(key).path}`;
+}
+
+/**
+ * Splits the article collection into the slices used by the front-page
+ * sections. Kept in one place so every view shows the same articles it did
+ * when they all lived on the home page.
+ */
+export async function getFrontPageArticles() {
+    const articles = await getCollection('articles');
+    articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+    const topArticle = articles[0];
+    const topStories = articles.slice(1, 4);
+    const topNewsArticles = articles.slice(4, 8);
+    const worldNewsArticles = articles.slice(8, 11);
+    const politicsArticles = articles.slice(11, 15);
+
+    // Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+    politicsArticles[2] = {
+        id: 'public-transit-overhaul',
+        data: {
+            title: 'What\'s new in DevTools',
+            summary: 'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+            author: 'Chrome DevTools Team',
+            date: new Date('2025-09-16T00:00:00.000Z'),
+            category: 'Web Development',
+            image: 'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+            image_caption: '',
+            readingTime: 3,
+        },
+        body: '',
+        collection: 'articles',
+        slug: 'public-transit-overhaul',
+        render: async () => '' as unknown as RenderResult,
+    } as unknown as CollectionEntry<'articles'>;
+
+    return { topArticle, topStories, topNewsArticles, worldNewsArticles, politicsArticles };
+}
