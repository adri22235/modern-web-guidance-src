+  <script type="module">
+    const IMG = (id) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=600&q=70`;
+
+    const MENU = [
+      { name: 'Maple Oat Latte', cat: 'coffee', price: 5.25, img: 'photo-1541167760496-1628856ab772' },
+      { name: 'Dark Roast Espresso', cat: 'coffee', price: 3.0, img: 'photo-1510707577719-ae7c14805e3a' },
+      { name: 'Cappuccino', cat: 'coffee', price: 4.5, img: 'photo-1572442388796-11668a67e53d' },
+      { name: 'Cold Brew', cat: 'cold', price: 4.75, img: 'photo-1461023058943-07fcbe16d735' },
+      { name: 'Iced Mocha', cat: 'cold', price: 5.5, img: 'photo-1517701604599-bb29b565090c' },
+      { name: 'Butter Croissant', cat: 'bakery', price: 3.25, img: 'photo-1555507036-ab1f4038808a' },
+    ];
+
+    const LOCATIONS = [
+      { name: 'Downtown Roastery', area: 'Downtown', hours: '6am – 8pm', img: 'photo-1501339847302-ac426a4a7cbb' },
+      { name: 'Riverside Café', area: 'Riverside', hours: '7am – 6pm', img: 'photo-1554118811-1e0d58224f24' },
+      { name: 'Old Town Corner', area: 'Old Town', hours: '6:30am – 7pm', img: 'photo-1445116572660-236099ec97a0' },
+    ];
+
+    const el = (tag, props = {}, ...children) => {
+      const node = Object.assign(document.createElement(tag), props);
+      node.append(...children);
+      return node;
+    };
+
+    // One-time setup for each lazily created view. Its DOM (and therefore all
+    // user state: filters, inputs, counters) lives on after the user leaves.
+    const setups = {
+      menu(root) {
+        const grid = root.querySelector('.menu-grid');
+        let count = 0, total = 0;
+        for (const item of MENU) {
+          const add = el('button', { type: 'button', className: 'btn', textContent: 'Add to order' });
+          add.addEventListener('click', () => {
+            count++; total += item.price;
+            root.querySelector('.order-count').textContent = count;
+            root.querySelector('.order-total').textContent = total.toFixed(2);
+          });
+          const card = el('div', { className: 'card' },
+            el('img', { src: IMG(item.img), alt: item.name, loading: 'lazy', decoding: 'async', width: 600, height: 450 }),
+            el('h3', { textContent: item.name }),
+            el('p', { className: 'price', textContent: `$${item.price.toFixed(2)}` }),
+            add);
+          card.dataset.cat = item.cat;
+          grid.append(card);
+        }
+        root.querySelector('.chips').addEventListener('click', (e) => {
+          const chip = e.target.closest('.chip');
+          if (!chip) return;
+          root.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
+          const f = chip.dataset.filter;
+          grid.querySelectorAll('.card').forEach((c) => { c.hidden = f !== 'all' && c.dataset.cat !== f; });
+        });
+      },
+      locations(root) {
+        const grid = root.querySelector('.loc-grid');
+        for (const loc of LOCATIONS) {
+          const card = el('div', { className: 'card' },
+            el('img', { src: IMG(loc.img), alt: `${loc.name} interior`, loading: 'lazy', decoding: 'async', width: 600, height: 450 }),
+            el('h3', { textContent: loc.name }),
+            el('p', { textContent: `${loc.area} · ${loc.hours}` }));
+          card.dataset.search = `${loc.name} ${loc.area}`.toLowerCase();
+          grid.append(card);
+        }
+        root.querySelector('.loc-search').addEventListener('input', (e) => {
+          const q = e.target.value.trim().toLowerCase();
+          grid.querySelectorAll('.card').forEach((c) => { c.hidden = !c.dataset.search.includes(q); });
+        });
+      },
+      rewards(root) {
+        const stamps = root.querySelector('.stamps');
+        let n = 3;
+        const render = () => {
+          stamps.replaceChildren(...Array.from({ length: 10 }, (_, i) =>
+            el('div', { className: `stamp${i < n ? ' filled' : ''}`, textContent: i < n ? '☕' : '' })));
+          root.querySelector('.stamp-count').textContent = n;
+        };
+        root.querySelector('.add-stamp').addEventListener('click', () => { n = (n + 1) % 11; render(); });
+        render();
+      },
+      account(root) {
+        const form = root.querySelector('.account-form');
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          form.querySelector('.save-status').textContent = 'Saved!';
+        });
+      },
+    };
+
+    const ROUTES = { '/': 'home', '/menu': 'menu', '/locations': 'locations', '/rewards': 'rewards', '/account': 'account' };
+    const TITLES = { home: 'Artisanal Coffee', menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account' };
+
+    const app = document.getElementById('app');
+    const views = new Map([['home', document.getElementById('view-home')]]); // cache of live views
+    const scrollPositions = new Map();
+    let current = null;
+
+    function getView(id) {
+      let view = views.get(id);
+      if (!view) {
+        view = el('div', { className: 'spa-view inactive', id: `view-${id}`, tabIndex: -1 });
+        view.dataset.viewId = id;
+        view.inert = true;
+        view.append(document.getElementById(`tpl-${id}`).content.cloneNode(true));
+        setups[id]?.(view);
+        app.append(view);
+        views.set(id, view);
+      }
+      return view;
+    }
+
+    function swap(id, { focus }) {
+      if (current) scrollPositions.set(current, scrollY);
+      for (const [vid, view] of views) {
+        if (vid === id) continue;
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+        view.inert = true;
+      }
+      const active = getView(id);
+      active.classList.remove('inactive');
+      active.removeAttribute('aria-hidden');
+      active.inert = false;
+      current = id;
+
+      document.title = `The Daily Grind | ${TITLES[id]}`;
+      document.querySelectorAll('nav a[data-view]').forEach((a) => {
+        if (a.dataset.view === id && id !== 'home') a.setAttribute('aria-current', 'page');
+        else a.removeAttribute('aria-current');
+      });
+
+      scrollTo(0, scrollPositions.get(id) ?? 0);
+      if (focus) active.focus({ preventScroll: true });
+    }
+
+    function show(id, opts = { focus: true }) {
+      if (id === current) return;
+      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (document.startViewTransition && !reduce && current) {
+        document.startViewTransition(() => swap(id, opts));
+      } else {
+        swap(id, opts);
+      }
+    }
+
+    const routeFor = (path) => ROUTES[path.replace(/\/+$/, '') || '/'];
+
+    document.addEventListener('click', (e) => {
+      const a = e.target.closest('a[data-view]');
+      if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+      e.preventDefault();
+      const id = a.dataset.view;
+      if (id !== current) history.pushState({ view: id }, '', a.getAttribute('href'));
+      show(id);
+    });
+
+    addEventListener('popstate', () => show(routeFor(location.pathname) ?? 'home'));
+
+    history.scrollRestoration = 'manual';
+    swap(routeFor(location.pathname) ?? 'home', { focus: false });
+  </script>
+
 </body>
 
