+  <script>
+    (() => {
+      const strengths = [
+        { name: 'Mild', desc: 'Light roast with bright, delicate notes of citrus and honey. Easy-going and gentle.' },
+        { name: 'Medium', desc: 'Balanced and smooth with notes of caramel and cocoa. Our house favorite.' },
+        { name: 'Bold', desc: 'Dark roast with a full body and rich, chocolatey depth for a serious wake-up call.' },
+        { name: 'Extra Bold', desc: 'Our most intense brew: smoky, robust, and double-dosed. Not for the faint of heart.' }
+      ];
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('strength-value');
+      const desc = document.getElementById('strength-desc');
+      const ticks = document.querySelectorAll('.strength-ticks li');
+
+      function sync() {
+        const i = Number(slider.value);
+        const { name, desc: text } = strengths[i];
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 3);
+        slider.style.setProperty('--control-value', i);
+        slider.setAttribute('aria-valuetext', name);
+        output.value = name;
+        desc.textContent = text;
+        ticks.forEach((t) => t.toggleAttribute('data-active', Number(t.dataset.step) === i));
+      }
+
+      ticks.forEach((t) => t.addEventListener('click', () => {
+        slider.value = t.dataset.step;
+        sync();
+        slider.focus();
+      }));
+      slider.addEventListener('input', sync);
+      sync();
+    })();
+  </script>
+
 </body>
 
