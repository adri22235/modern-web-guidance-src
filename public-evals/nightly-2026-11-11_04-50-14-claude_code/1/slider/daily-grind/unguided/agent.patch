+  <script>
+    (function () {
+      var STRENGTHS = [
+        { name: 'Mild', desc: 'Light and bright with gentle citrus and floral notes. Easy sipping any time of day.' },
+        { name: 'Medium', desc: 'Balanced and smooth with notes of caramel and toasted nuts.' },
+        { name: 'Bold', desc: 'Full-bodied and rich, with dark chocolate depth and a lingering finish.' },
+        { name: 'Extra Bold', desc: 'Intense, smoky, and unapologetic. Our strongest pour for serious mornings.' }
+      ];
+
+      var section = document.querySelector('.strength');
+      var range = document.getElementById('brew-strength');
+      var nameEl = document.getElementById('strength-name');
+      var descEl = document.getElementById('strength-desc');
+      var beans = section.querySelectorAll('.strength-beans span');
+      var buttons = section.querySelectorAll('.strength-ticks button');
+      var max = Number(range.max);
+
+      function update() {
+        var v = Number(range.value);
+        var s = STRENGTHS[v];
+        var ratio = v / max;
+        range.style.setProperty('--ratio', ratio);
+        range.setAttribute('aria-valuetext', s.name);
+        nameEl.textContent = s.name;
+        descEl.textContent = s.desc;
+        beans.forEach(function (b, i) { b.classList.toggle('on', i <= v); });
+        buttons.forEach(function (btn) {
+          btn.setAttribute('aria-pressed', String(Number(btn.dataset.value) === v));
+        });
+      }
+
+      range.addEventListener('input', update);
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          range.value = btn.dataset.value;
+          update();
+          range.focus();
+        });
+      });
+
+      update();
+    })();
+  </script>
+
