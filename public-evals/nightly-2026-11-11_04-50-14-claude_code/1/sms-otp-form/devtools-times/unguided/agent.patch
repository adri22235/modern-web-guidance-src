+  SESSION_KEY_PENDING,
+  SESSION_KEY_VERIFIED,
+  codeMatches,
+  json,
+  type PendingVerification,
+} from '../../../lib/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return json({ error: 'Sessions are unavailable.' }, 500);
+
+  let body: { code?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== CODE_LENGTH) {
+    return json({ error: `Enter the ${CODE_LENGTH}-digit code we sent you.` }, 400);
+  }
+
+  const pending = (await session.get(SESSION_KEY_PENDING)) as PendingVerification | undefined;
+  if (!pending) {
+    return json({ error: 'No verification in progress. Please request a new code.', expired: true }, 400);
+  }
+
+  if (Date.now() > pending.expiresAt) {
+    session.delete(SESSION_KEY_PENDING);
+    return json({ error: 'This code has expired. Please request a new one.', expired: true }, 400);
+  }
+
+  if (!codeMatches(pending, code)) {
+    pending.attempts += 1;
+    if (pending.attempts >= MAX_ATTEMPTS) {
+      session.delete(SESSION_KEY_PENDING);
+      return json({ error: 'Too many incorrect attempts. Please request a new code.', expired: true }, 429);
+    }
+    await session.set(SESSION_KEY_PENDING, pending);
+    const remaining = MAX_ATTEMPTS - pending.attempts;
+    return json(
+      { error: `That code is incorrect. ${remaining} attempt${remaining === 1 ? '' : 's'} remaining.`, attemptsRemaining: remaining },
+      400,
+    );
+  }
+
+  session.delete(SESSION_KEY_PENDING);
+  await session.set(SESSION_KEY_VERIFIED, { phone: pending.phone, verifiedAt: Date.now() });
+
+  return json({ verified: true, phone: pending.phone });
+};
