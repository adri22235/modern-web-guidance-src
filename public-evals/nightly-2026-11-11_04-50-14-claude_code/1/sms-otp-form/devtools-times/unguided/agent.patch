@@ -0,0 +1,112 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+/** How long a one-time passcode stays valid. */
+export const CODE_TTL_MS = 5 * 60 * 1000;
+/** Minimum delay between two SMS sends to the same session. */
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+/** Maximum wrong guesses before the code is invalidated. */
+export const MAX_ATTEMPTS = 5;
+export const CODE_LENGTH = 6;
+
+export interface PendingVerification {
+  phone: string;
+  codeHash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+export const SESSION_KEY_PENDING = 'phoneVerificationPending';
+export const SESSION_KEY_VERIFIED = 'phoneVerified';
+
+/**
+ * Normalise user input into E.164 format (e.g. "+14155550123").
+ * Accepts spaces, dashes, dots and parentheses. Numbers without a leading "+"
+ * are assumed to be North American (country code 1) when they have 10 digits.
+ * Returns null if the number cannot be interpreted.
+ */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  if (!/^\+?[\d\s().-]+$/.test(trimmed)) return null;
+  let digits = trimmed.replace(/\D/g, '');
+  if (trimmed.startsWith('+')) {
+    // already international
+  } else if (trimmed.startsWith('00')) {
+    digits = digits.slice(2);
+  } else if (digits.length === 10) {
+    digits = `1${digits}`;
+  } else if (!(digits.length === 11 && digits.startsWith('1'))) {
+    return null;
+  }
+  // E.164: max 15 digits, country code cannot start with 0.
+  if (digits.length < 8 || digits.length > 15 || digits.startsWith('0')) return null;
+  return `+${digits}`;
+}
+
+export function maskPhone(phone: string): string {
+  return phone.length <= 4 ? phone : `${phone.slice(0, 2)}${'•'.repeat(phone.length - 4)}${phone.slice(-2)}`;
+}
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** CODE_LENGTH).toString().padStart(CODE_LENGTH, '0');
+}
+
+function secret(): string {
+  return import.meta.env.OTP_SECRET ?? process.env.OTP_SECRET ?? 'devtools-times-otp';
+}
+
+export function hashCode(phone: string, code: string): string {
+  return createHash('sha256').update(`${secret()}:${phone}:${code}`).digest('hex');
+}
+
+export function codeMatches(pending: PendingVerification, code: string): boolean {
+  const a = Buffer.from(hashCode(pending.phone, code), 'hex');
+  const b = Buffer.from(pending.codeHash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Build the SMS body. The final line follows the WebOTP "origin-bound one-time
+ * code" format (`@domain #code`) so supporting browsers (Chrome on Android,
+ * Safari on iOS/macOS) can extract and autofill the code automatically.
+ */
+export function buildSmsBody(code: string, host: string): string {
+  return `${code} is your DevTools Times verification code. It expires in ${CODE_TTL_MS / 60000} minutes.\n\n@${host} #${code}`;
+}
+
+/**
+ * Deliver an SMS. Uses Twilio when TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN and
+ * TWILIO_FROM_NUMBER are configured; otherwise logs the message to the server
+ * console (development fallback).
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  const env = (name: string) => import.meta.env[name] ?? process.env[name];
+  const sid = env('TWILIO_ACCOUNT_SID');
+  const token = env('TWILIO_AUTH_TOKEN');
+  const from = env('TWILIO_FROM_NUMBER');
+
+  if (!sid || !token || !from) {
+    console.info(`[sms:dev] to=${to}\n${body}`);
+    return;
+  }
+
+  const res = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: to, From: from, Body: body }),
+  });
+  if (!res.ok) {
+    throw new Error(`SMS provider responded with ${res.status}`);
+  }
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
