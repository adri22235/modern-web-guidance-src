@@ -0,0 +1,68 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_TTL_MS,
+  RESEND_COOLDOWN_MS,
+  SESSION_KEY_PENDING,
+  SESSION_KEY_VERIFIED,
+  buildSmsBody,
+  generateCode,
+  hashCode,
+  json,
+  maskPhone,
+  normalizePhone,
+  sendSms,
+  type PendingVerification,
+} from '../../../lib/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) return json({ error: 'Sessions are unavailable.' }, 500);
+
+  let body: { phone?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number, including the country code (e.g. +1 415 555 0123).' }, 400);
+  }
+
+  const now = Date.now();
+  const existing = (await session.get(SESSION_KEY_PENDING)) as PendingVerification | undefined;
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return json(
+      { error: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter },
+      429,
+      { 'Retry-After': String(retryAfter) },
+    );
+  }
+
+  const code = generateCode();
+  const pending: PendingVerification = {
+    phone,
+    codeHash: hashCode(phone, code),
+    expiresAt: now + CODE_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  };
+
+  try {
+    await sendSms(phone, buildSmsBody(code, url.host));
+  } catch (err) {
+    console.error('Failed to send verification SMS', err);
+    return json({ error: 'We could not send a text message to that number. Please try again.' }, 502);
+  }
+
+  await session.set(SESSION_KEY_PENDING, pending);
+  session.delete(SESSION_KEY_VERIFIED);
+
+  return json({
+    phone,
+    maskedPhone: maskPhone(phone),
+    expiresIn: CODE_TTL_MS / 1000,
+    resendAfter: RESEND_COOLDOWN_MS / 1000,
+  });
+};
