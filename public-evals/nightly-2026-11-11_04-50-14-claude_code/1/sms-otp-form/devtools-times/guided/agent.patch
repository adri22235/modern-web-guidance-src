index 0000000..47bbab4
--- /dev/null
+++ b/src/lib/smsOtp.ts
@@ -0,0 +1,105 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+/**
+ * Minimal in-memory SMS one-time passcode store.
+ *
+ * NOTE: This is a demo implementation. In production, persist challenges in a
+ * shared store (Redis, DB) and deliver messages through a real SMS provider.
+ */
+
+export const OTP_LENGTH = 6;
+const OTP_TTL_MS = 5 * 60 * 1000; // 5 minutes
+const RESEND_COOLDOWN_MS = 30 * 1000; // 30 seconds
+const MAX_ATTEMPTS = 5;
+
+interface Challenge {
+  codeHash: Buffer;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+const challenges = new Map<string, Challenge>();
+const verifiedPhones = new Map<string, number>(); // phone -> verification expiry
+
+const hash = (value: string) => createHash('sha256').update(value).digest();
+
+/** Normalizes to E.164-ish form: leading "+" followed by 8–15 digits. */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  const digits = trimmed.replace(/[\s().-]/g, '');
+  if (!/^\+[1-9]\d{7,14}$/.test(digits)) return null;
+  return digits;
+}
+
+export type SendResult =
+  | { ok: true; retryAfter: number }
+  | { ok: false; error: string; retryAfter?: number };
+
+export function createChallenge(phone: string, domain: string): SendResult {
+  const now = Date.now();
+  const existing = challenges.get(phone);
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return { ok: false, error: 'Please wait before requesting another code.', retryAfter };
+  }
+
+  const code = randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+  challenges.set(phone, {
+    codeHash: hash(code),
+    expiresAt: now + OTP_TTL_MS,
+    sentAt: now,
+    attempts: 0,
+  });
+
+  sendSms(phone, buildOtpMessage(code, domain));
+  return { ok: true, retryAfter: RESEND_COOLDOWN_MS / 1000 };
+}
+
+/**
+ * Origin-bound SMS format: human-readable text first, then a final line of
+ * `@<host> #<code>` so WebOTP and `autocomplete="one-time-code"` can verify
+ * the domain before offering the code.
+ */
+export function buildOtpMessage(code: string, domain: string): string {
+  return `Your DevTools Times verification code is ${code}.\n\n@${domain} #${code}`;
+}
+
+function sendSms(phone: string, body: string) {
+  // Replace with a real SMS provider integration.
+  const masked = phone.slice(0, -4).replace(/\d/g, '•') + phone.slice(-4);
+  console.info(`[sms] to ${masked}:\n${body}`);
+}
+
+export type VerifyResult = { ok: true } | { ok: false; error: string };
+
+export function verifyChallenge(phone: string, code: unknown): VerifyResult {
+  const challenge = challenges.get(phone);
+  if (!challenge || Date.now() > challenge.expiresAt) {
+    challenges.delete(phone);
+    return { ok: false, error: 'This code has expired. Request a new code.' };
+  }
+  if (typeof code !== 'string' || !new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return { ok: false, error: `Enter the ${OTP_LENGTH}-digit code.` };
+  }
+
+  challenge.attempts += 1;
+  if (challenge.attempts > MAX_ATTEMPTS) {
+    challenges.delete(phone);
+    return { ok: false, error: 'Too many attempts. Request a new code.' };
+  }
+
+  if (!timingSafeEqual(hash(code), challenge.codeHash)) {
+    return { ok: false, error: 'That code is incorrect. Check the message and try again.' };
+  }
+
+  challenges.delete(phone);
+  verifiedPhones.set(phone, Date.now() + 15 * 60 * 1000);
+  return { ok: true };
+}
+
+export function isPhoneVerified(phone: string): boolean {
+  const expiry = verifiedPhones.get(phone);
+  return expiry !== undefined && Date.now() < expiry;
+}
