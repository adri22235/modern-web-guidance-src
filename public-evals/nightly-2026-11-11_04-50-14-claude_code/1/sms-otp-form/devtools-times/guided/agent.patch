+import type { APIRoute } from 'astro';
+import { createChallenge, normalizePhone } from '../../../lib/smsOtp';
+
+export const prerender = false;
+
+const json = (body: unknown, status = 200, headers: Record<string, string> = {}) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+
+export const POST: APIRoute = async ({ request, url }) => {
+  let payload: { phone?: unknown };
+  try {
+    payload = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(payload.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number including the country code, e.g. +1 555 123 4567.' }, 400);
+  }
+
+  // Host only (no scheme, port, or path) for the origin-bound "@domain #code" line.
+  const result = createChallenge(phone, url.hostname);
+  if (!result.ok) {
+    return json(
+      { error: result.error, retryAfter: result.retryAfter },
+      429,
+      result.retryAfter ? { 'Retry-After': String(result.retryAfter) } : {},
+    );
+  }
+  return json({ sent: true, retryAfter: result.retryAfter });
+};
