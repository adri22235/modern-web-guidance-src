+  <script>
+    (function () {
+      'use strict';
+
+      var CODE_LENGTH = 6;
+      var RESEND_SECONDS = 30;
+      var DESTINATIONS = { rewards: '/rewards', order: '/order-online' };
+
+      var phoneForm = document.getElementById('phone-form');
+      var codeForm = document.getElementById('code-form');
+      var phoneInput = document.getElementById('phone');
+      var phoneError = document.getElementById('phone-error');
+      var codeInput = document.getElementById('otp-code');
+      var codeError = document.getElementById('otp-error');
+      var sendBtn = document.getElementById('send-btn');
+      var verifyBtn = document.getElementById('verify-btn');
+      var resendBtn = document.getElementById('resend-btn');
+      var changeBtn = document.getElementById('change-number-btn');
+      var sentTo = document.getElementById('sent-to');
+      var codePhone = document.getElementById('code-phone');
+      var codePurpose = document.getElementById('code-purpose');
+      var statusEl = document.getElementById('verify-status');
+
+      var resendTimer = null;
+      var otpAbort = null;
+      var verifying = false;
+
+      function setStatus(msg, success) {
+        statusEl.textContent = msg;
+        statusEl.classList.toggle('success', !!success);
+      }
+
+      function setError(input, el, msg) {
+        el.textContent = msg || '';
+        input.setAttribute('aria-invalid', msg ? 'true' : 'false');
+      }
+
+      // Normalise to E.164 (defaults to US +1 when no country code is given).
+      function normalisePhone(raw) {
+        var trimmed = raw.trim();
+        var digits = trimmed.replace(/\D/g, '');
+        if (trimmed.charAt(0) === '+') {
+          return digits.length >= 8 && digits.length <= 15 ? '+' + digits : null;
+        }
+        if (digits.length === 11 && digits.charAt(0) === '1') digits = digits.slice(1);
+        return digits.length === 10 ? '+1' + digits : null;
+      }
+
+      function maskPhone(e164) {
+        return '•••• ' + e164.slice(-4);
+      }
+
+      function selectedPurpose() {
+        var checked = phoneForm.querySelector('input[name="purpose"]:checked');
+        return checked ? checked.value : 'rewards';
+      }
+
+      function postJSON(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(body)
+        }).then(function (res) {
+          return res.json().catch(function () { return {}; }).then(function (data) {
+            if (!res.ok) {
+              var err = new Error(data.message || 'Request failed (' + res.status + ')');
+              err.status = res.status;
+              throw err;
+            }
+            return data;
+          });
+        });
+      }
+
+      function startResendCountdown() {
+        var remaining = RESEND_SECONDS;
+        clearInterval(resendTimer);
+        resendBtn.disabled = true;
+        resendBtn.textContent = 'Resend code in ' + remaining + 's';
+        resendTimer = setInterval(function () {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(resendTimer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+          } else {
+            resendBtn.textContent = 'Resend code in ' + remaining + 's';
+          }
+        }, 1000);
+      }
+
+      function stopWebOTP() {
+        if (otpAbort) {
+          otpAbort.abort();
+          otpAbort = null;
+        }
+      }
+
+      // WebOTP API: reads the code from an incoming SMS (Chrome on Android).
+      // The SMS must end with a line like:  @dailygrind.example #123456
+      // iOS/macOS Safari autofill is handled by autocomplete="one-time-code".
+      function listenForSmsCode() {
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        stopWebOTP();
+        otpAbort = new AbortController();
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: otpAbort.signal })
+          .then(function (otp) {
+            if (!otp || !otp.code) return;
+            codeInput.value = sanitiseCode(otp.code);
+            setStatus('Code received from your text message.');
+            if (codeInput.value.length === CODE_LENGTH) submitCode();
+          })
+          .catch(function () { /* aborted, denied or timed out: manual entry still works */ });
+      }
+
+      function sanitiseCode(value) {
+        return String(value).replace(/\D/g, '').slice(0, CODE_LENGTH);
+      }
+
+      function sendCode(phone, purpose, isResend) {
+        sendBtn.disabled = true;
+        resendBtn.disabled = true;
+        setStatus(isResend ? 'Sending a new code…' : 'Sending your code…');
+
+        return postJSON('/api/otp/send', { phone: phone, purpose: purpose })
+          .then(function () {
+            codePhone.value = phone;
+            codePurpose.value = purpose;
+            sentTo.textContent = maskPhone(phone);
+            phoneForm.hidden = true;
+            codeForm.hidden = false;
+            codeInput.value = '';
+            setError(codeInput, codeError, '');
+            setStatus((isResend ? 'A new code was' : 'A code was') + ' sent to ' + maskPhone(phone) + '.');
+            codeInput.focus();
+            startResendCountdown();
+            listenForSmsCode();
+          })
+          .catch(function (err) {
+            var msg = err.status === 429
+              ? 'Too many attempts. Please wait a few minutes and try again.'
+              : 'We couldn’t send a code right now. Please try again.';
+            if (isResend) {
+              setError(codeInput, codeError, msg);
+              resendBtn.disabled = false;
+            } else {
+              setError(phoneInput, phoneError, msg);
+              phoneInput.focus();
+            }
+            setStatus('');
+          })
+          .then(function () { sendBtn.disabled = false; });
+      }
+
+      function submitCode() {
+        if (verifying) return;
+        var code = sanitiseCode(codeInput.value);
+        codeInput.value = code;
+
+        if (code.length !== CODE_LENGTH) {
+          setError(codeInput, codeError, 'Enter all ' + CODE_LENGTH + ' digits of your code.');
+          codeInput.focus();
+          return;
+        }
+
+        verifying = true;
+        verifyBtn.disabled = true;
+        setError(codeInput, codeError, '');
+        setStatus('Checking your code…');
+
+        var purpose = codePurpose.value;
+        postJSON('/api/otp/verify', { phone: codePhone.value, purpose: purpose, code: code })
+          .then(function (data) {
+            stopWebOTP();
+            clearInterval(resendTimer);
+            setStatus('You’re verified! Taking you to ' +
+              (purpose === 'order' ? 'your order' : 'Rewards') + '…', true);
+            var next = (data && typeof data.redirect === 'string' && data.redirect.charAt(0) === '/' &&
+              data.redirect.charAt(1) !== '/') ? data.redirect : DESTINATIONS[purpose] || '/';
+            setTimeout(function () { window.location.assign(next); }, 800);
+          })
+          .catch(function (err) {
+            var msg = err.status === 429
+              ? 'Too many incorrect attempts. Please request a new code.'
+              : err.status === 410
+                ? 'That code has expired. Please request a new one.'
+                : 'That code didn’t match. Check your text and try again.';
+            setError(codeInput, codeError, msg);
+            setStatus('');
+            codeInput.select();
+            codeInput.focus();
+          })
+          .then(function () {
+            verifying = false;
+            verifyBtn.disabled = false;
+          });
+      }
+
+      phoneForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var phone = normalisePhone(phoneInput.value);
+        if (!phone) {
+          setError(phoneInput, phoneError, 'Enter a valid 10-digit mobile number.');
+          phoneInput.focus();
+          return;
+        }
+        setError(phoneInput, phoneError, '');
+        sendCode(phone, selectedPurpose(), false);
+      });
+
+      phoneInput.addEventListener('input', function () {
+        if (phoneInput.getAttribute('aria-invalid') === 'true') setError(phoneInput, phoneError, '');
+      });
+
+      codeForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        submitCode();
+      });
+
+      // Keep only digits (handles pasted "Your code is 123 456" etc.)
+      // and auto-submit once a full code is present (typed, pasted or autofilled).
+      codeInput.addEventListener('input', function () {
+        var clean = sanitiseCode(codeInput.value);
+        if (clean !== codeInput.value) codeInput.value = clean;
+        if (codeInput.getAttribute('aria-invalid') === 'true') setError(codeInput, codeError, '');
+        if (clean.length === CODE_LENGTH) submitCode();
+      });
+
+      codeInput.addEventListener('paste', function (e) {
+        var text = (e.clipboardData || window.clipboardData).getData('text');
+        var match = text && text.match(/\b(\d[\s-]?){6}\b/);
+        if (match) {
+          e.preventDefault();
+          codeInput.value = sanitiseCode(match[0]);
+          codeInput.dispatchEvent(new Event('input', { bubbles: true }));
+        }
+      });
+
+      resendBtn.addEventListener('click', function () {
+        sendCode(codePhone.value, codePurpose.value, true);
+      });
+
+      changeBtn.addEventListener('click', function () {
+        stopWebOTP();
+        clearInterval(resendTimer);
+        codeForm.hidden = true;
+        phoneForm.hidden = false;
+        setError(codeInput, codeError, '');
+        setStatus('');
+        phoneInput.focus();
+        phoneInput.select();
+      });
+
+      // Pre-select purpose from links like /?signin=order or #order
+      var params = new URLSearchParams(window.location.search);
+      var wanted = params.get('signin') || window.location.hash.replace('#', '');
+      var radio = phoneForm.querySelector('input[name="purpose"][value="' + (wanted === 'order' ? 'order' : 'rewards') + '"]');
+      if (radio) radio.checked = true;
+    })();
+  </script>
+
 </body>
 
