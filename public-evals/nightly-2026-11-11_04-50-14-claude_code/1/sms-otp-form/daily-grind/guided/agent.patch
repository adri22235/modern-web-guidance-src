+
+  <script>
+    (() => {
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const phoneStatus = document.getElementById('phone-status');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpStatus = document.getElementById('otp-status');
+      const resendBtn = document.getElementById('resend-code');
+      const changeBtn = document.getElementById('change-number');
+      const RESEND_DELAY = 30;
+
+      const setStatus = (el, message, tone = '') => {
+        el.dataset.tone = tone;
+        el.textContent = message;
+      };
+
+      // ---- Accessible validation state (aria-invalid + error linking) ----
+      const announcer = document.createElement('div');
+      announcer.setAttribute('aria-live', 'polite');
+      announcer.className = 'visually-hidden';
+      document.body.append(announcer);
+      let announceTimer;
+      let announcedField;
+
+      const supportsUserInvalid = CSS.supports('selector(:user-invalid)');
+      const touched = new WeakSet();
+      const isUserInvalid = (el) =>
+        supportsUserInvalid ? el.matches(':user-invalid') : touched.has(el) && !el.validity.valid;
+
+      const linkError = (el, shown) => {
+        const errorId = el.dataset.error;
+        if (!errorId) return;
+        const ids = (el.getAttribute('aria-describedby') || '').split(/\s+/).filter((id) => id && id !== errorId);
+        if (shown) ids.push(errorId);
+        if (ids.length) el.setAttribute('aria-describedby', ids.join(' '));
+        else el.removeAttribute('aria-describedby');
+      };
+
+      const spokenText = (node) => {
+        const copy = node.cloneNode(true);
+        copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove());
+        copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => n.replaceWith(`${n.getAttribute('aria-label')}: `));
+        return copy.textContent.replace(/\s+/g, ' ').trim();
+      };
+
+      const announced = new WeakSet();
+      const syncAria = (el, announce = false) => {
+        if (!el.dataset?.error) return;
+        const invalid = isUserInvalid(el);
+        el.classList.toggle('user-invalid-fallback', !supportsUserInvalid && invalid);
+        el.setAttribute('aria-invalid', String(invalid));
+        linkError(el, invalid);
+        if (invalid && announce && !announced.has(el)) {
+          announced.add(el);
+          const error = document.getElementById(el.dataset.error);
+          const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : '';
+          clearTimeout(announceTimer);
+          announcer.textContent = '';
+          announcedField = el;
+          announceTimer = setTimeout(() => { announcer.textContent = label + spokenText(error); }, 500);
+        } else if (!invalid) {
+          announced.delete(el);
+          if (announcedField === el) {
+            clearTimeout(announceTimer);
+            announcer.textContent = '';
+          }
+        }
+      };
+
+      const fields = [phoneInput, otpInput];
+      fields.forEach((el) => {
+        syncAria(el);
+        el.addEventListener('blur', () => {
+          if (el.value) touched.add(el);
+          syncAria(el, true);
+        });
+        el.addEventListener('input', () => syncAria(el));
+        el.addEventListener('invalid', () => {
+          // A failed submit counts as interaction; focus moves there and reads the error.
+          touched.add(el);
+          announced.add(el);
+          syncAria(el);
+        });
+      });
+
+      // Keep the OTP field digits-only (e.g. after pasting "123 456").
+      otpInput.addEventListener('input', () => {
+        const digits = otpInput.value.replace(/\D/g, '').slice(0, 6);
+        if (digits !== otpInput.value) otpInput.value = digits;
+      });
+
+      // ---- WebOTP: automatic code extraction from the incoming SMS ----
+      // The SMS must end with the origin-bound line, e.g. "@dailygrind.example #123456".
+      let otpAbortController = null;
+
+      const stopSmsOtpListener = () => {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      };
+
+      const startSmsOtpListener = async () => {
+        if (!('OTPCredential' in window)) return; // falls back to autocomplete="one-time-code" / manual entry
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+        try {
+          const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+          if (!otp || ac.signal.aborted) return;
+          otpInput.value = otp.code;
+          otpForm.requestSubmit();
+        } catch (err) {
+          if (err?.name !== 'AbortError') console.error('WebOTP error:', err);
+        }
+      };
+
+      // ---- Resend cooldown ----
+      let resendTimer;
+      const startResendCooldown = () => {
+        clearInterval(resendTimer);
+        let remaining = RESEND_DELAY;
+        resendBtn.disabled = true;
+        resendBtn.textContent = `Resend code in ${remaining}s`;
+        resendTimer = setInterval(() => {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(resendTimer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+          } else {
+            resendBtn.textContent = `Resend code in ${remaining}s`;
+          }
+        }, 1000);
+      };
+
+      const requestCode = async () => {
+        const res = await fetch(phoneForm.action, {
+          method: 'POST',
+          body: new FormData(phoneForm),
+          headers: { Accept: 'application/json' },
+        });
+        if (!res.ok) throw new Error(`HTTP ${res.status}`);
+      };
+
+      const showOtpStep = () => {
+        otpForm.reset();
+        const data = new FormData(phoneForm);
+        document.getElementById('otp-phone').value = data.get('phone').trim();
+        document.getElementById('otp-purpose').value = data.get('purpose');
+        document.getElementById('otp-phone-display').textContent = data.get('phone').trim();
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        touched.delete(otpInput);
+        syncAria(otpInput);
+        setStatus(otpStatus, '');
+        otpInput.focus();
+        startResendCooldown();
+        startSmsOtpListener();
+      };
+
+      const showPhoneStep = () => {
+        stopSmsOtpListener();
+        clearInterval(resendTimer);
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus(phoneStatus, '');
+        phoneInput.focus();
+      };
+
+      phoneForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const submitBtn = phoneForm.querySelector('[type="submit"]');
+        submitBtn.disabled = true;
+        setStatus(phoneStatus, 'Sending your code…');
+        try {
+          await requestCode();
+          showOtpStep();
+        } catch {
+          setStatus(phoneStatus, "Error: We couldn't send a code right now. Please try again in a moment.", 'error');
+        } finally {
+          submitBtn.disabled = false;
+        }
+      });
+
+      otpForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        stopSmsOtpListener(); // abort in-flight WebOTP request on any submission
+        const submitBtn = otpForm.querySelector('[type="submit"]');
+        submitBtn.disabled = true;
+        setStatus(otpStatus, 'Verifying…');
+        try {
+          const res = await fetch(otpForm.action, {
+            method: 'POST',
+            body: new FormData(otpForm),
+            headers: { Accept: 'application/json' },
+          });
+          if (!res.ok) throw new Error(`HTTP ${res.status}`);
+          const purpose = document.getElementById('otp-purpose').value;
+          setStatus(otpStatus, 'Verified! Redirecting…', 'success');
+          window.location.assign(purpose === 'order' ? '/order-online' : '/rewards');
+        } catch {
+          setStatus(otpStatus, "Error: That code didn't work. Check the code and try again, or request a new one.", 'error');
+          otpInput.select();
+          otpInput.focus();
+          startSmsOtpListener(); // keep listening in case a fresh SMS arrives
+        } finally {
+          submitBtn.disabled = false;
+        }
+      });
+
+      resendBtn.addEventListener('click', async () => {
+        resendBtn.disabled = true;
+        setStatus(otpStatus, 'Sending a new code…');
+        try {
+          await requestCode();
+          otpInput.value = '';
+          setStatus(otpStatus, 'A new code is on its way.');
+          startResendCooldown();
+          startSmsOtpListener(); // aborts the previous listener before starting a new one
+          otpInput.focus();
+        } catch {
+          setStatus(otpStatus, "Error: We couldn't resend the code. Please try again.", 'error');
+          resendBtn.disabled = false;
+        }
+      });
+
+      changeBtn.addEventListener('click', showPhoneStep);
+      window.addEventListener('pagehide', stopSmsOtpListener);
+    })();
+  </script>
 </body>
 
