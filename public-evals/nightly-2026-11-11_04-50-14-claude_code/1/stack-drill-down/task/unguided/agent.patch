+      const swipeHint = '<p class="swipe-hint">Swipe right to go back</p>';
+
+      /* ================= Routes ================= */
+      // Each route: { key, hash, title, render(parentTitle) -> html }
+      const homeHref = () => location.pathname + location.search;
+
+      const HOME_ROUTE = { key: 'home', hash: '', title: 'Home', docTitle: HOME_DOC_TITLE };
+
+      function itemRoute(id, item) {
+        return {
+          key: 'item:' + id,
+          hash: '#/seasonal/' + id,
+          title: item.name,
+          render: (parentTitle) => `
+            ${appbar(item.name, parentTitle)}
+            <div class="detail-hero"><img src="${IMG(item.image, 1400)}" alt="${esc(item.alt)}"></div>
+            <article class="detail">
+              <div class="detail-head">
+                <h1 tabindex="-1">${esc(item.name)}</h1>
+                <span class="price">${money(item.price)}</span>
+              </div>
+              <p class="tagline">${esc(item.tagline)}</p>
+              <p class="lead">${esc(item.description)}</p>
+
+              <h2>Tasting notes</h2>
+              <ul class="chips">${item.notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>
+
+              <h2>At a glance</h2>
+              ${factsList(item.facts)}
+
+              <h2>Sizes</h2>
+              <table class="sizes">
+                <thead><tr><th scope="col">Size</th><th scope="col">Volume</th><th scope="col">Price</th></tr></thead>
+                <tbody>${item.sizes.map(([s, v, p]) => `<tr><td>${esc(s)}</td><td>${esc(v)}</td><td>${money(p)}</td></tr>`).join('')}</tbody>
+              </table>
+
+              <h2>Learn more</h2>
+              <ul class="drill-list">
+                <li><a href="#/seasonal/${id}/origin">
+                  <span class="drill-text"><strong>Origin &amp; ingredients</strong>
+                  <small>${esc(item.origin.region)} · Nutrition facts</small></span>${chevronRight}
+                </a></li>
+              </ul>
+
+              <div class="actions">
+                <a href="/order-online" class="btn btn-accent">Order ${esc(item.name)}</a>
+              </div>
+              ${swipeHint}
+            </article>`
+        };
+      }
+
+      function originRoute(id, item) {
+        const o = item.origin;
+        return {
+          key: 'origin:' + id,
+          hash: '#/seasonal/' + id + '/origin',
+          title: 'Origin & Ingredients',
+          docTitle: item.name + ' – Origin & Ingredients',
+          render: (parentTitle) => `
+            ${appbar('Origin & Ingredients', parentTitle)}
+            <article class="detail">
+              <h1 tabindex="-1">${esc(o.beans)}</h1>
+              <p class="tagline">The beans behind our ${esc(item.name)}</p>
+              <p class="lead">${esc(o.story)}</p>
+
+              <h2>Origin</h2>
+              ${factsList({ Region: o.region, Producer: o.producer, Altitude: o.altitude, Process: o.process, Roast: o.roast })}
+
+              <h2>Ingredients</h2>
+              <ul class="chips">${item.ingredients.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>
+
+              <h2>Nutrition <small style="font-weight:400;color:var(--muted)">(${esc(item.sizes[1][0].toLowerCase())}, ${esc(item.sizes[1][1])})</small></h2>
+              ${factsList(item.nutrition)}
+              ${swipeHint}
+            </article>`
+        };
+      }
+
+      function notFoundRoute(path) {
+        return {
+          key: 'notfound:' + path,
+          hash: '#/' + path,
+          title: 'Not found',
+          render: (parentTitle) => `
+            ${appbar('Not found', parentTitle)}
+            <article class="detail" style="text-align:center">
+              <h1 tabindex="-1">We couldn't find that page</h1>
+              <p class="lead">The item you're looking for may no longer be on our seasonal menu.</p>
+              <div class="actions" style="justify-content:center">
+                <button type="button" class="btn" data-action="back">Back to ${esc(parentTitle)}</button>
+              </div>
+            </article>`
+        };
+      }
+
+      /** Parse a hash into the full hierarchy of routes, root first. */
+      function routesFor(hash) {
+        const path = decodeURIComponent((hash || '').replace(/^#\/?/, '')).replace(/\/+$/, '');
+        const segs = path.split('/').filter(Boolean);
+        const routes = [HOME_ROUTE];
+        if (!segs.length) return routes;
+
+        if (segs[0] === 'seasonal' && segs.length >= 2 && Object.prototype.hasOwnProperty.call(ITEMS, segs[1])) {
+          const id = segs[1];
+          const item = ITEMS[id];
+          routes.push(itemRoute(id, item));
+          if (segs.length === 2) return routes;
+          if (segs.length === 3 && segs[2] === 'origin') {
+            routes.push(originRoute(id, item));
+            return routes;
+          }
+          routes.push(notFoundRoute(path));
+          return routes;
+        }
+        routes.push(notFoundRoute(path));
+        return routes;
+      }
+
+      /* ================= Stack engine ================= */
+      const stackEl = document.getElementById('stack');
+      const scrim = document.getElementById('scrim');
+      const announcer = document.getElementById('nav-announcer');
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const duration = () => (reduceMotion.matches ? 0 : 350);
+
+      let zCounter = 1;
+      // Entries: { key, route, el, returnFocus }
+      let stack = [{ key: 'home', route: HOME_ROUTE, el: document.getElementById('screen-home'), returnFocus: null }];
+      stack[0].el.style.zIndex = String(zCounter);
+      const leaving = new Set();
+      let drag = null; // active swipe-back gesture
+
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+      function createScreen(route, parentTitle) {
+        const el = document.createElement('section');
+        el.className = 'screen is-sub is-ahead';
+        el.dataset.key = route.key;
+        el.setAttribute('aria-label', route.title);
+        el.innerHTML = route.render(parentTitle);
+        zCounter += 2;
+        el.style.zIndex = String(zCounter);
+        return el;
+      }
+
+      function removeLater(el, animate) {
+        leaving.add(el);
+        el.inert = true;
+        el.setAttribute('aria-hidden', 'true');
+        const done = () => {
+          if (!leaving.has(el)) return;
+          leaving.delete(el);
+          el.remove();
+        };
+        if (!animate) return done();
+        el.addEventListener('transitionend', (e) => { if (e.target === el && e.propertyName === 'transform') done(); });
+        setTimeout(done, duration() + 80);
+      }
+
+      function flushLeaving() {
+        leaving.forEach((el) => el.remove());
+        leaving.clear();
+      }
+
+      /** Apply resting positions to every screen in the stack. */
+      function layout(scrimFor) {
+        const topIdx = stack.length - 1;
+        stack.forEach((entry, i) => {
+          const el = entry.el;
+          el.style.transform = '';
+          el.style.transition = '';
+          el.classList.remove('is-ahead');
+          el.classList.toggle('is-behind', i < topIdx);
+          const hidden = i < topIdx;
+          el.inert = hidden;
+          if (hidden) el.setAttribute('aria-hidden', 'true'); else el.removeAttribute('aria-hidden');
+        });
+        scrim.style.transition = '';
+        // Scrim sits directly beneath the top-most visible screen (or a leaving one).
+        const ref = scrimFor || stack[topIdx].el;
+        scrim.style.zIndex = String(Number(ref.style.zIndex) - 1);
+        scrim.style.opacity = topIdx > 0 && !scrimFor ? '1' : '0';
+      }
+
+      function updateTitle() {
+        const r = stack[stack.length - 1].route;
+        document.title = r.key === 'home' ? HOME_DOC_TITLE : `${r.docTitle || r.title} | ${BASE_TITLE}`;
+        announcer.textContent = r.key === 'home' ? 'Home' : r.title;
+      }
+
+      function focusTop() {
+        const el = stack[stack.length - 1].el;
+        const h = el.querySelector('h1[tabindex]');
+        if (h) h.focus({ preventScroll: true });
+      }
+
+      function restoreFocus(entry) {
+        const t = entry && entry.returnFocus;
+        if (t && t.isConnected && !t.closest('[inert]')) t.focus({ preventScroll: true });
+        else if (stack.length > 1) focusTop();
+      }
+
+      function withoutAnimation(fn) {
+        stackEl.classList.add('no-anim');
+        fn();
+        void stackEl.offsetWidth;
+        stackEl.classList.remove('no-anim');
+      }
+
+      /** Visually pop the top screen (used by back actions and swipe commit). */
+      function popVisual(animate) {
+        if (stack.length < 2) return;
+        flushLeaving();
+        const entry = stack.pop();
+        const go = () => {
+          entry.el.classList.add('is-ahead');
+          entry.el.style.transform = '';
+          entry.el.style.transition = '';
+          layout(entry.el);
+        };
+        animate ? go() : withoutAnimation(go);
+        removeLater(entry.el, animate);
+        updateTitle();
+        restoreFocus(entry);
+      }
+
+      /** Sync the visual stack with the current URL. */
+      function render(opts) {
+        const animate = !(opts && opts.animate === false) && duration() > 0;
+        const routes = routesFor(location.hash);
+
+        let p = 0;
+        while (p < stack.length && p < routes.length && stack[p].key === routes[p].key) p++;
+        if (p === stack.length && p === routes.length) return; // already in sync
+
+        drag = null; // URL changed underneath an in-flight gesture
+        flushLeaving();
+        const activeBefore = document.activeElement;
+        const popped = stack.splice(p);
+        const pushed = routes.slice(p).map((route, i) => {
+          const parent = i === 0 ? stack[stack.length - 1] : null;
+          const parentTitle = parent ? parent.route.title : routes[p + i - 1].title;
+          return { key: route.key, route, el: createScreen(route, parentTitle), returnFocus: null };
+        });
+
+        if (pushed.length) {
+          // Push (or replace): new screens slide in over whatever is there.
+          pushed[0].returnFocus = popped.length ? popped[0].returnFocus : activeBefore;
+          pushed.forEach((e) => stackEl.appendChild(e.el));
+          stack.push(...pushed);
+          if (animate) {
+            // Intermediate screens jump straight to their "behind" position.
+            withoutAnimation(() => pushed.slice(0, -1).forEach((e) => { e.el.classList.remove('is-ahead'); e.el.classList.add('is-behind'); }));
+            void stackEl.offsetWidth;
+            layout();
+          } else {
+            withoutAnimation(() => layout());
+          }
+          popped.forEach((e) => removeLater(e.el, animate));
+          updateTitle();
+          pushed[pushed.length - 1].el.scrollTop = 0;
+          focusTop();
+        } else {
+          // Pure pop: animate only the top-most leaving screen.
+          const top = popped[popped.length - 1];
+          popped.slice(0, -1).forEach((e) => removeLater(e.el, false));
+          const go = () => { top.el.classList.add('is-ahead'); layout(top.el); };
+          animate ? go() : withoutAnimation(go);
+          removeLater(top.el, animate);
+          updateTitle();
+          restoreFocus(popped[0]);
+        }
+      }
+
+      /* ================= History integration ================= */
+      const depthOf = (hash) => routesFor(hash).length - 1;
+
+      function navigate(hash) {
+        if (routesFor(hash).map((r) => r.key).join('|') === stack.map((e) => e.key).join('|')) return;
+        history.pushState({ grind: true, depth: depthOf(hash) }, '', hash);
+        render();
+      }
+
+      /**
+       * Go up one level. If the previous history entry is our parent, use the
+       * real browser back so history stays in sync; otherwise (e.g. hand-edited
+       * URL) replace the current entry with the parent.
+       */
+      function goBack(opts) {
+        if (stack.length < 2) return;
+        const fromSwipe = opts && opts.fromSwipe;
+        const parent = stack[stack.length - 2].route;
+        const st = history.state;
+        if (fromSwipe) popVisual(true);
+        if (st && st.grind && st.depth === stack.length - (fromSwipe ? 0 : 1) && st.depth > 0) {
+          history.back();
+        } else {
+          history.replaceState({ grind: true, depth: depthOf(parent.hash) }, '', parent.hash || homeHref());
+          render();
+        }
+      }
+
+      window.addEventListener('popstate', () => render());
+      window.addEventListener('hashchange', () => render());
+
+      // Intercept in-app links so we control history entries.
+      document.addEventListener('click', (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const backBtn = e.target.closest('[data-action="back"]');
+        if (backBtn) { e.preventDefault(); goBack(); return; }
+        const a = e.target.closest('a[href^="#/"]');
+        if (!a) return;
+        e.preventDefault();
+        navigate(a.getAttribute('href'));
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key !== 'Escape' || stack.length < 2) return;
+        const t = e.target;
+        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
+        e.preventDefault();
+        goBack();
+      });
+
+      /* ================= Swipe-back gesture ================= */
+      stackEl.addEventListener('pointerdown', (e) => {
+        if (stack.length < 2 || !e.isPrimary || e.pointerType === 'mouse') return;
+        const top = stack[stack.length - 1].el;
+        if (!top.contains(e.target)) return;
+        drag = {
+          id: e.pointerId, x0: e.clientX, y0: e.clientY, engaged: false, x: 0,
+          samples: [{ x: 0, t: e.timeStamp }],
+          top, under: stack[stack.length - 2].el
+        };
+      });
+
+      stackEl.addEventListener('pointermove', (e) => {
+        if (!drag || e.pointerId !== drag.id) return;
+        const dx = e.clientX - drag.x0;
+        const dy = e.clientY - drag.y0;
+        if (!drag.engaged) {
+          if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return;
+          if (dx > 0 && Math.abs(dx) > Math.abs(dy) * 1.3) {
+            drag.engaged = true;
+            try { drag.top.setPointerCapture(drag.id); } catch (_) { }
+            drag.top.style.transition = 'none';
+            drag.under.style.transition = 'none';
+            scrim.style.transition = 'none';
+          } else {
+            drag = null; // vertical scroll or leftward move: let the browser have it
+            return;
+          }
+        }
+        const w = stackEl.clientWidth;
+        const x = Math.max(0, Math.min(w, dx));
+        drag.x = x;
+        drag.samples.push({ x, t: e.timeStamp });
+        if (drag.samples.length > 5) drag.samples.shift();
+        const progress = x / w;
+        drag.top.style.transform = `translate3d(${x}px,0,0)`;
+        drag.under.style.transform = `translate3d(${-30 + 30 * progress}%,0,0)`;
+        scrim.style.opacity = String(1 - progress);
+      });
+
+      function endDrag(e, cancelled) {
+        if (!drag || e.pointerId !== drag.id) return;
+        const d = drag;
+        drag = null;
+        if (!d.engaged) return;
+        const first = d.samples[0];
+        const last = d.samples[d.samples.length - 1];
+        const velocity = (last.x - first.x) / Math.max(1, last.t - first.t); // px/ms
+        const w = stackEl.clientWidth;
+        const commit = !cancelled && (d.x > w * 0.4 || (velocity > 0.45 && d.x > 30));
+        if (commit) {
+          goBack({ fromSwipe: true });
+        } else {
+          layout(); // settle back into place
+        }
+      }
+
+      stackEl.addEventListener('pointerup', (e) => endDrag(e, false));
+      stackEl.addEventListener('pointercancel', (e) => endDrag(e, true));
+
+      /* ================= Boot ================= */
+      (function init() {
+        const routes = routesFor(location.hash);
+        // Seed history so deep links have a real "back" path up the hierarchy.
+        history.replaceState({ grind: true, depth: 0 }, '', routes.length > 1 ? homeHref() : location.href);
+        for (let i = 1; i < routes.length; i++) {
+          history.pushState({ grind: true, depth: i }, '', routes[i].hash);
+        }
+        layout();
+        render({ animate: false });
+      })();
+    })();
+  </script>
+
 </body>
 
 </html>
