+  <script>
+    // Allow Escape to dismiss an open tooltip (WCAG 1.4.13); reset on leave/blur.
+    (function () {
+      var wraps = document.querySelectorAll('.tooltip-wrap');
+      function reset(wrap) {
+        wrap.className = wrap.className.replace(/\s*is-dismissed/g, '');
+      }
+      for (var i = 0; i < wraps.length; i++) {
+        (function (wrap) {
+          wrap.addEventListener('mouseleave', function () { reset(wrap); });
+          wrap.addEventListener('focusout', function () { reset(wrap); });
+          wrap.addEventListener('mouseenter', function () { reset(wrap); });
+          wrap.addEventListener('focusin', function () { reset(wrap); });
+        })(wraps[i]);
+      }
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27) {
+          for (var j = 0; j < wraps.length; j++) {
+            if (wraps[j].className.indexOf('is-dismissed') === -1) {
+              wraps[j].className += ' is-dismissed';
+            }
+          }
+        }
+      });
+    })();
+  </script>
