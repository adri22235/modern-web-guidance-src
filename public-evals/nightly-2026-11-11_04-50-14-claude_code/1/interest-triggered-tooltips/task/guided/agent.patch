+  <script>
+    // Wire ARIA for interest-triggered hints before any polyfill loads, so
+    // browse-mode screen readers see the relationships up front.
+    (() => {
+      const norm = (t) => (t || "").replace(/\s+/g, " ").trim();
+      const owned = new WeakSet();
+
+      const accessibleName = (el) => {
+        const ids = el.getAttribute("aria-labelledby");
+        if (ids) {
+          return norm(ids.split(/\s+/).map((id) => document.getElementById(id)?.textContent).join(" "));
+        }
+        if (el.hasAttribute("aria-label")) return norm(el.getAttribute("aria-label"));
+        const clone = el.cloneNode(true);
+        clone.querySelectorAll("img[alt]").forEach((img) => img.replaceWith(img.alt));
+        return norm(clone.textContent) || norm(el.getAttribute("title"));
+      };
+
+      const addIdRef = (el, attr, id) => {
+        if (!el.hasAttribute(attr)) el.setAttribute(attr, id);
+      };
+
+      window.wireInterestHints = (root = document) => {
+        root.querySelectorAll("[interestfor]").forEach((trigger) => {
+          const hint = document.getElementById(trigger.getAttribute("interestfor"));
+          if (!hint || hint.getAttribute("popover") !== "hint") return;
+
+          const name = accessibleName(trigger);
+          if (name && name === norm(hint.textContent)) return;
+          if (!hint.hasAttribute("role")) hint.setAttribute("role", "tooltip");
+
+          if (!name) {
+            addIdRef(trigger, "aria-labelledby", hint.id);
+            return;
+          }
+          const opensOnActivation =
+            trigger.getAttribute("popovertarget") === hint.id ||
+            trigger.getAttribute("commandfor") === hint.id;
+          if (opensOnActivation) {
+            if (!trigger.hasAttribute("aria-expanded")) {
+              let open = false;
+              try { open = hint.matches(":popover-open"); } catch { /* unsupported selector */ }
+              trigger.setAttribute("aria-expanded", String(open));
+              owned.add(trigger);
+            }
+          } else {
+            addIdRef(trigger, "aria-describedby", hint.id);
+          }
+        });
+      };
+
+      // toggle does not bubble: listen in the capture phase.
+      document.addEventListener("toggle", (event) => {
+        const hint = event.target;
+        if (!(hint instanceof Element) || !hint.id) return;
+        document.querySelectorAll(`[interestfor="${CSS.escape(hint.id)}"]`).forEach((trigger) => {
+          if (owned.has(trigger)) trigger.setAttribute("aria-expanded", String(event.newState === "open"));
+        });
+      }, true);
+
+      wireInterestHints();
+    })();
+  </script>
+
+  <script type="module">
+    // Conditionally load polyfills only where native support is missing.
+    // Order matters: popover first, then interest invokers, then anchor positioning.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+  </script>
+
