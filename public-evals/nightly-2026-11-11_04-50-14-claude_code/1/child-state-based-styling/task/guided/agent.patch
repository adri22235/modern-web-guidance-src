--- a/index.html
+++ b/index.html
@@ -134,8 +134,140 @@
     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Seasonal card + "Make it iced" toggle */
+    .seasonal-card {
+      --card-bg: white;
+      --card-border: transparent;
+      --card-heading: var(--primary);
+      --card-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      --iced-accent: var(--primary);
+
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      background: var(--card-bg);
+      border: 2px solid var(--card-border);
+      box-shadow: var(--card-shadow);
+      transition: background 0.3s, border-color 0.3s, box-shadow 0.3s, transform 0.3s;
+    }
+
+    .seasonal-card h3 {
+      color: var(--card-heading);
+      transition: color 0.3s;
+    }
+
+    .seasonal-card .btn {
+      margin-top: auto;
+    }
+
+    .seasonal-card::after {
+      content: "❄ Iced";
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: #0277bd;
+      color: white;
+      font-size: 0.75rem;
+      font-weight: bold;
+      opacity: 0;
+      scale: 0.8;
+      transition: opacity 0.3s, scale 0.3s;
+      pointer-events: none;
+    }
+
+    .seasonal-card:has(.iced-toggle input:checked) {
+      --card-bg: linear-gradient(160deg, #e1f5fe 0%, #b3e5fc 100%);
+      --card-border: #4fc3f7;
+      --card-heading: #01579b;
+      --card-shadow: 0 6px 18px rgba(2, 119, 189, 0.25);
+      --iced-accent: #0277bd;
+      transform: translateY(-3px);
+    }
+
+    .seasonal-card:has(.iced-toggle input:checked)::after {
+      opacity: 1;
+      scale: 1;
+    }
+
+    .iced-toggle {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+      margin: 15px 0 0;
+      font-weight: 600;
+      cursor: pointer;
+      user-select: none;
+    }
+
+    .iced-toggle input {
+      width: 1.1rem;
+      height: 1.1rem;
+      accent-color: var(--iced-accent);
+      cursor: pointer;
+    }
+
+    /* Fallback for browsers without accent-color: custom box on a visually hidden input */
+    @supports not (accent-color: red) {
+      .iced-toggle {
+        position: relative;
+      }
+
+      .iced-toggle input {
+        position: absolute;
+        clip-path: inset(50%);
+        overflow: hidden;
+        width: 1px;
+        height: 1px;
+        margin: -1px;
+        padding: 0;
+        border: 0;
+        white-space: nowrap;
+      }
+
+      .iced-toggle input + span::before {
+        content: "";
+        display: inline-block;
+        vertical-align: -0.2em;
+        width: 1.1rem;
+        height: 1.1rem;
+        margin-right: 8px;
+        border: 2px solid var(--iced-accent);
+        border-radius: 4px;
+        background: white;
+        color: white;
+        font-size: 0.8rem;
+        line-height: 0.9rem;
+        text-align: center;
+      }
+
+      .iced-toggle input:checked + span::before {
+        content: "✓";
+        background: var(--iced-accent);
+      }
+
+      .iced-toggle input:focus-visible + span::before {
+        outline: 2px solid #000;
+        outline-offset: 2px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .seasonal-card,
+      .seasonal-card::after {
+        transition: none;
+      }
+
+      .seasonal-card:has(.iced-toggle input:checked) {
+        transform: none;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
