+    /* Sticky section headers */
+    .sticky-section {
+      margin-top: 60px;
+      /* Prevent scroll anchoring from fighting the padding change when stuck */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just below the site nav */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named container so queries don't collide with other containers */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 20px 24px;
+      border-radius: 8px;
+      font-size: 1.5rem;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s, border-radius 0.3s;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: #1565c0;
+        color: white;
+        padding: 8px 24px;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 4px 10px rgb(0 0 0 / 0.25);
+      }
+    }
+
+    .sticky-section .card {
+      text-align: left;
+    }
+
     footer {
