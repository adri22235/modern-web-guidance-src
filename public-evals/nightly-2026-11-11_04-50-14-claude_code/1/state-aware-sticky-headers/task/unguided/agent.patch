+    /* Sticky section headers.
+       The sticky element is a named scroll-state container so the
+       stuck-state query below only targets these headers, never the
+       site <nav> (which is also sticky). Scroll root is the viewport. */
+    .sticky-container {
+      position: sticky;
+      top: var(--nav-height); /* stick just below the site navigation */
+      z-index: 900;           /* below the nav (1000), above cards */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 1.5rem;
+      border-radius: 8px;
+      text-align: center;
+      font-size: 1.6rem;
+      box-shadow: none;
+      transition: background-color 0.25s ease, color 0.25s ease,
+        padding 0.25s ease, box-shadow 0.25s ease, font-size 0.25s ease;
