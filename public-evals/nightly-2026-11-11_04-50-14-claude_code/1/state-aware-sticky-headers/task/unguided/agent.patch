+  <script>
+    // Fallback for browsers lacking CSS scroll-state container queries:
+    // toggle .is-stuck when a header reaches its sticky offset in the viewport.
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('container-type: scroll-state')) return;
+      var containers = Array.prototype.slice.call(document.querySelectorAll('.sticky-container'));
+      if (!containers.length) return;
+      var ticking = false;
+      function update() {
+        ticking = false;
+        containers.forEach(function (el) {
+          var top = parseFloat(getComputedStyle(el).top) || 0;
+          var rect = el.getBoundingClientRect();
+          var parentRect = el.parentElement.getBoundingClientRect();
+          // Stuck: pinned at its offset and the section's top has scrolled above it
+          var stuck = Math.abs(rect.top - top) < 1 && parentRect.top < top;
+          el.classList.toggle('is-stuck', stuck);
+        });
+      }
+      function onScroll() {
+        if (!ticking) { ticking = true; requestAnimationFrame(update); }
+      }
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
