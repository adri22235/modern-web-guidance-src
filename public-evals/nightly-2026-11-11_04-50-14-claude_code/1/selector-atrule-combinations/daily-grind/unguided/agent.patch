+    /*
+     * Theming
+     * -------
+     * Every themed value is declared exactly once via light-dark(). Which
+     * branch wins is decided by the `color-scheme` of the root element:
+     *   - default: `light dark` -> follows the OS prefers-color-scheme setting
+     *   - <html data-theme="dark">  / <html class="dark">  / .theme-dark  -> forced dark
+     *   - <html data-theme="light"> / <html class="light"> / .theme-light -> forced light
+     * Only the scheme selector changes per mode; the themed rules are never duplicated.
+     */
+    :root {
+      color-scheme: light dark;
+
+      /* Page */
+      --page-bg: light-dark(#fafafa, #16110f);
+      --page-fg: light-dark(#3e2723, #ede0d4);
+
+      /* Navigation */
+      --nav-bg: light-dark(#4e342e, #1f1714);
+      --nav-fg: light-dark(#ffffff, #f5ebe0);
+      --nav-link-hover: light-dark(#ffab40, #ffc46b);
+      --nav-border: light-dark(transparent, #3a2b25);
+      --nav-shadow: light-dark(0 2px 6px rgba(0, 0, 0, 0.15), 0 2px 10px rgba(0, 0, 0, 0.6));
+
+      /* Hero */
+      --hero-overlay-top: light-dark(rgba(0, 0, 0, 0.35), rgba(10, 6, 4, 0.65));
+      --hero-overlay-bottom: light-dark(rgba(0, 0, 0, 0.55), rgba(10, 6, 4, 0.85));
+      --hero-fg: light-dark(#ffffff, #f5ebe0);
+      --hero-text-shadow: light-dark(0 2px 8px rgba(0, 0, 0, 0.35), 0 2px 12px rgba(0, 0, 0, 0.8));
+
+      /* Seasonal Favorites cards */
+      --card-bg: light-dark(#ffffff, #261c18);
+      --card-fg: light-dark(#3e2723, #d7ccc8);
+      --card-heading: light-dark(#4e342e, #ffcc80);
+      --card-border: light-dark(transparent, #3a2b25);
+      --card-shadow: light-dark(0 2px 5px rgba(0, 0, 0, 0.1), 0 4px 14px rgba(0, 0, 0, 0.5));
+
+      /* Buttons (hero + cards) */
+      --btn-bg: light-dark(#4e342e, #ffab40);
+      --btn-fg: light-dark(#ffffff, #1f1714);
+      --btn-hover-bg: light-dark(#3e2723, #ffc46b);
+    }
+
+    :root[data-theme="dark"],
+    :root.dark,
+    :root.theme-dark {
+      color-scheme: dark;
+    }
+
+    :root[data-theme="light"],
+    :root.light,
+    :root.theme-light {
+      color-scheme: light;
+    }
+
