+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    /* Seasonal drink cards: each card is a size container, so its layout follows
+       its own width (column count, gaps, etc.) rather than the viewport. */
+    .seasonal .card {
+      container: drink-card / inline-size;
+      display: grid;
+      /* Media column is "auto": it collapses to 0 while children span both tracks
+         (stacked), and sizes to the image once the image is placed in it (side-by-side). */
+      grid-template-columns: auto 1fr;
+      align-content: start;
+      row-gap: 10px;
+      padding: 0;
+      overflow: hidden;
+    }
+
+    /* Default (narrow card): regions stacked in source order */
+    .seasonal .card > * {
+      grid-column: 1 / -1;
+      text-align: center;
+    }
+
+    .seasonal .card > :not(img) {
+      padding-inline: 20px;
+    }
+
+    .seasonal .card > img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      margin-bottom: 10px;
+    }
+
+    .seasonal .card h3 {
+      margin-bottom: 0;
+    }
+
+    .seasonal .card > footer {
+      padding-bottom: 20px;
+    }
+
