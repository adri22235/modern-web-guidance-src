+        grid-row: 1 / span 3;
+        width: 40cqi;
+        height: 100%;
+        min-height: 12rem;
+        aspect-ratio: auto;
+        margin: 0 24px 0 0;
+        padding: 0;
+      }
+
+      .seasonal .card:has(> img) > h3 {
+        align-self: end;
+        padding-top: 24px;
+        font-size: 1.4rem;
+      }
+
+      .seasonal .card:has(> img) > footer {
+        align-self: start;
+        padding-bottom: 24px;
+      }
+    }
