+    /* Seasonal Favorites: drink cards respond to their own width via container queries */
+    .drink-grid {
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+    }
+
+    /* The first drink is featured across the full row, so it has room to go side-by-side */
+    .drink-grid > .drink-card:first-child {
+      grid-column: 1 / -1;
+    }
+
+    .drink-card {
+      container: drink-card / inline-size;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+    }
+
+    /* Default (narrow card): stacked, image on top */
+    .drink-card__inner {
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+    }
+
+    .drink-card__media {
+      aspect-ratio: 16 / 10;
+      background: var(--secondary);
+    }
+
+    .drink-card__media img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    .drink-card__body {
+      display: flex;
+      flex: 1;
+      flex-direction: column;
+      align-items: center;
+      padding: 20px;
+      text-align: center;
+    }
+
+    .drink-card__body h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+      font-size: 1.25rem;
+    }
+
+    .drink-card__body .btn {
+      margin-top: auto;
+    }
+
+    .drink-card__body p {
+      margin-bottom: 15px;
+    }
+
+    /* Wide card: side-by-side, image beside text */
+    @container drink-card (min-width: 520px) {
+      .drink-card__inner {
+        flex-direction: row;
+      }
+
+      .drink-card__media {
+        flex: 0 0 45%;
+        aspect-ratio: auto;
+        min-height: 240px;
+      }
+
+      .drink-card__body {
+        align-items: flex-start;
+        justify-content: center;
+        padding: 30px clamp(24px, 5cqi, 48px);
+        text-align: left;
+      }
+
+      .drink-card__body h3 {
+        font-size: clamp(1.4rem, 3.5cqi, 2rem);
+      }
+
+      .drink-card__body p {
+        font-size: 1.05rem;
+      }
+
+      .drink-card__body .btn {
+        margin-top: 0;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
