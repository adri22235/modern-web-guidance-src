+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const statusRegion = document.getElementById('preferences-status');
+    const switches = document.querySelectorAll('input[type="checkbox"][switch]');
+
+    switches.forEach((switchInput) => {
+      switchInput.addEventListener('change', (event) => {
+        const isChecked = event.target.checked;
+        const labelText = event.target.closest('label')?.querySelector('span')?.textContent?.trim() || event.target.name;
+        statusRegion.textContent = `${labelText}: ${isChecked ? 'On' : 'Off'}`;
+      });
+    });
+
+    const form = document.getElementById('preferences-form');
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const activeSettings = Array.from(switches)
+        .filter((input) => input.checked)
+        .map((input) => input.closest('label')?.querySelector('span')?.textContent?.trim() || input.name);
+
+      statusRegion.textContent = activeSettings.length > 0
+        ? `Preferences saved. Active: ${activeSettings.join(', ')}.`
+        : 'Preferences saved. All optional switches are currently turned off.';
+    });
+  </script>
