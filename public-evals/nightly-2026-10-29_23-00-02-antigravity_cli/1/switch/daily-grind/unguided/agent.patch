+  <script>
+    (function () {
+      const liveStatus = document.getElementById('switch-live-status');
+
+      function applySwitchSideEffects(switchEl, isChecked) {
+        const id = switchEl.id;
+        if (id === 'dark-mode-switch') {
+          document.body.setAttribute('data-theme', isChecked ? 'dark' : 'light');
+        } else if (id === 'decaf-switch') {
+          const cards = document.querySelectorAll('.card[data-decaf-available]');
+          cards.forEach((card) => {
+            const decafAvailable = card.getAttribute('data-decaf-available') === 'true';
+            card.hidden = isChecked && !decafAvailable;
+          });
+        } else if (id === 'oatmilk-switch') {
+          const badges = document.querySelectorAll('[data-milk-badge]');
+          badges.forEach((badge) => {
+            badge.hidden = !isChecked;
+          });
+        }
+      }
+
+      function toggleSwitch(switchEl) {
+        if (switchEl.disabled || switchEl.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        const isChecked = switchEl.getAttribute('aria-checked') === 'true';
+        const nextState = !isChecked;
+
+        switchEl.setAttribute('aria-checked', String(nextState));
+
+        const stateText = document.querySelector('[data-state-for="' + switchEl.id + '"]');
+        if (stateText) {
+          stateText.textContent = nextState ? 'On' : 'Off';
+        }
+
+        applySwitchSideEffects(switchEl, nextState);
+
+        const labelId = switchEl.getAttribute('aria-labelledby');
+        const labelEl = labelId ? document.getElementById(labelId) : null;
+        const labelText = labelEl ? labelEl.textContent.trim() : 'Switch';
+        if (liveStatus) {
+          liveStatus.textContent = labelText + ' ' + (nextState ? 'enabled' : 'disabled');
+        }
+
+        switchEl.dispatchEvent(
+          new CustomEvent('switch:change', {
+            bubbles: true,
+            detail: { checked: nextState, id: switchEl.id }
+          })
+        );
+      }
+
+      const switches = document.querySelectorAll('button[role="switch"]');
+      switches.forEach((switchEl) => {
+        switchEl.addEventListener('click', () => {
+          toggleSwitch(switchEl);
+        });
+
+        // Initialize visual state on load
+        const initialChecked = switchEl.getAttribute('aria-checked') === 'true';
+        applySwitchSideEffects(switchEl, initialChecked);
+      });
+
+      // Allow clicking associated text labels to toggle and focus the switch
+      const switchLabels = document.querySelectorAll('[data-switch-for]');
+      switchLabels.forEach((labelEl) => {
+        labelEl.addEventListener('click', () => {
+          const targetId = labelEl.getAttribute('data-switch-for');
+          const targetSwitch = targetId ? document.getElementById(targetId) : null;
+          if (targetSwitch) {
+            targetSwitch.focus();
+            toggleSwitch(targetSwitch);
+          }
+        });
+      });
+    })();
+  </script>
