+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      if (!CSS.supports("appearance", "base-select")) {
+        return;
+      }
+
+      const select = document.getElementById("roast-picker");
+      if (!select) return;
+
+      select.addEventListener("keydown", (event) => {
+        if (!select.matches(":open")) return;
+        const { key } = event;
+        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(key)) {
+          return;
+        }
+
+        const options = Array.from(select.querySelectorAll("option"));
+        const activeOption =
+          options.find((opt) => opt === document.activeElement) ||
+          select.selectedOptions[0];
+        if (!activeOption) return;
+
+        const currentRect = activeOption.getBoundingClientRect();
+        const currentCenter = {
+          x: currentRect.left + currentRect.width / 2,
+          y: currentRect.top + currentRect.height / 2,
+        };
+
+        let bestCandidate = null;
+        let bestDistance = Infinity;
+
+        for (const option of options) {
+          if (option === activeOption) continue;
+          const rect = option.getBoundingClientRect();
+          const center = {
+            x: rect.left + rect.width / 2,
+            y: rect.top + rect.height / 2,
+          };
+          const dx = center.x - currentCenter.x;
+          const dy = center.y - currentCenter.y;
+
+          const isInDirection =
+            (key === "ArrowRight" && dx > 4) ||
+            (key === "ArrowLeft" && dx < -4) ||
+            (key === "ArrowDown" && dy > 4) ||
+            (key === "ArrowUp" && dy < -4);
+
+          if (!isInDirection) continue;
+
+          const distance = Math.hypot(dx, dy);
+          if (distance < bestDistance) {
+            bestDistance = distance;
+            bestCandidate = option;
+          }
+        }
+
+        if (bestCandidate) {
+          event.preventDefault();
+          bestCandidate.focus();
+        }
+      });
+    });
+  </script>
