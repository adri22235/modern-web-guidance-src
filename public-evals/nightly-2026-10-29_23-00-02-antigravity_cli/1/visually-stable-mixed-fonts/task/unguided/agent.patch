diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,168 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Modern CSS Typography &amp; Visual Proportions</title>
+  <link rel="stylesheet" href="styles.css" />
+  <style>
+    :root {
+      --bg-primary: #0f172a;
+      --bg-card: #1e293b;
+      --text-primary: #f8fafc;
+      --text-secondary: #94a3b8;
+      --accent: #38bdf8;
+      --border-color: #334155;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+      background-color: var(--bg-primary);
+      color: var(--text-primary);
+      line-height: 1.6;
+      padding: 2.5rem 1.5rem;
+      min-height: 100vh;
+    }
+
+    main {
+      max-width: 840px;
+      margin: 0 auto;
+      display: flex;
+      flex-direction: column;
+      gap: 2rem;
+    }
+
+    header {
+      border-bottom: 1px solid var(--border-color);
+      padding-bottom: 1.25rem;
+    }
+
+    header h1 {
+      font-size: 1.875rem;
+      font-weight: 700;
+      letter-spacing: -0.025em;
+      color: var(--text-primary);
+    }
+
+    header p {
+      color: var(--text-secondary);
+      margin-top: 0.5rem;
+    }
+
+    .card {
+      background-color: var(--bg-card);
+      border: 1px solid var(--border-color);
+      border-radius: 0.75rem;
+      padding: 1.75rem;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
+    }
+
+    .section-label {
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 0.08em;
+      color: var(--accent);
+      font-weight: 600;
+      margin-bottom: 0.75rem;
+      display: block;
+    }
+
+    /* Mixed fonts container: normalize visual x-height automatically */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", Times, serif;
+      font-size: 1.125rem;
+      font-size-adjust: from-font;
+      line-height: 1.75;
+      color: var(--text-primary);
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, Consolas, Monaco, monospace;
+      background-color: rgba(56, 189, 248, 0.12);
+      color: #7dd3fc;
+      padding: 0.15em 0.4em;
+      border-radius: 0.375rem;
+      border: 1px solid rgba(56, 189, 248, 0.25);
+    }
+
+    /* Independent theme container: lock down visual proportions with numeric aspect-ratio override */
+    #independent-theme-container {
+      --theme-bg: #fefce8;
+      --theme-surface: #fef9c3;
+      --theme-text: #422006;
+      --theme-muted: #713f12;
+      --theme-accent: #ca8a04;
+      --theme-border: #fde047;
+
+      background: linear-gradient(135deg, var(--theme-bg) 0%, var(--theme-surface) 100%);
+      color: var(--theme-text);
+      border: 2px solid var(--theme-border);
+      border-radius: 0.75rem;
+      padding: 2rem;
+      font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
+      font-size: 1.125rem;
+      font-size-adjust: 0.5;
+      aspect-ratio: 16 / 9;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25);
+    }
+
+    #independent-theme-container h2 {
+      font-size: 1.5rem;
+      color: var(--theme-text);
+      margin-bottom: 0.5rem;
+    }
+
+    #independent-theme-container p {
+      color: var(--theme-muted);
+      line-height: 1.6;
+    }
+
+    #independent-theme-container code {
+      font-family: Consolas, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
+      background-color: rgba(202, 138, 4, 0.15);
+      color: var(--theme-text);
+      padding: 0.15em 0.4em;
+      border-radius: 0.25rem;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Font Size Adjustment &amp; Visual Proportions</h1>
+      <p>Demonstrating automatic mixed-font visual height normalization and independent theme aspect-ratio overrides.</p>
+    </header>
+
+    <section class="card">
+      <span class="section-label">Automatic Mixed-Font Normalization</span>
+      <p id="mixed-fonts-container">
+        When combining prose typography with inline code snippets like <code>font-size-adjust: from-font</code> or <code>const ratio = computeXHeight(font)</code>, browsers can automatically normalize the visual x-height across mixed font families so that inline <code>monospace</code> glyphs align harmoniously with surrounding regular text.
+      </p>
+    </section>
+
+    <div id="independent-theme-container">
+      <div>
+        <span class="section-label" style="color: var(--theme-accent);">Independent Theme Container</span>
+        <h2>Locked Visual Proportions</h2>
+        <p>
+          This independent theme container applies a specific numeric override (<code>font-size-adjust: 0.5</code> and <code>aspect-ratio: 16 / 9</code>) to lock down its typographic and layout visual proportions independently of the parent document.
+        </p>
+      </div>
+      <div>
+        <p>
+          Inline code elements such as <code>themeConfig.aspectRatio = 0.5</code> inherit the container's locked metric.
+        </p>
+      </div>
+    </div>
+  </main>
+</body>
+</html>
