diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,140 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Visually Stable Mixed Fonts &amp; Independent Theme Proportions</title>
+  <style>
+    @layer base, components, theme;
+
+    @layer base {
+      :root {
+        --font-primary: Verdana, Geneva, Tahoma, sans-serif;
+        --font-code: "Courier New", Courier, monospace;
+        --font-alternate-theme: "Times New Roman", Times, Georgia, serif;
+        --color-bg: #f8fafc;
+        --color-surface: #ffffff;
+        --color-text: #0f172a;
+        --color-code-bg: #e2e8f0;
+        --color-theme-bg: #1e293b;
+        --color-theme-text: #f1f5f9;
+        --color-border: #cbd5e1;
+      }
+
+      body {
+        margin: 0;
+        padding-block: 2rem;
+        padding-inline: 1.5rem;
+        font-family: var(--font-primary);
+        font-size: 1rem;
+        line-height: 1.5;
+        text-align: start;
+        background-color: var(--color-bg);
+        color: var(--color-text);
+      }
+
+      main {
+        max-inline-size: 80ch;
+        margin-inline: auto;
+      }
+
+      h1, h2 {
+        text-wrap: balance;
+        line-height: 1.25;
+      }
+
+      p {
+        max-inline-size: 80ch;
+        text-wrap: pretty;
+        overflow-wrap: break-word;
+      }
+    }
+
+    @layer components {
+      #mixed-fonts-container {
+        font-family: var(--font-primary);
+        font-size: 1rem;
+        line-height: 1.6;
+        /* Automatically extract and apply x-height aspect ratio from the primary font */
+        font-size-adjust: from-font;
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-border);
+        border-radius: 0.5rem;
+        padding-block: 1rem;
+        padding-inline: 1.25rem;
+        margin-block: 1.5rem;
+      }
+
+      #mixed-fonts-container code {
+        font-family: var(--font-code);
+        background-color: var(--color-code-bg);
+        padding-block: 0.125em;
+        padding-inline: 0.375em;
+        border-radius: 0.25rem;
+      }
+    }
+
+    @layer theme {
+      #independent-theme-container {
+        font-family: var(--font-alternate-theme);
+        font-size: 1rem;
+        line-height: 1.6;
+        /* Lock down visual proportions independently using a specific numeric aspect-ratio override */
+        font-size-adjust: 0.545;
+        background-color: var(--color-theme-bg);
+        color: var(--color-theme-text);
+        border-radius: 0.5rem;
+        padding-block: 1.25rem;
+        padding-inline: 1.5rem;
+        margin-block: 1.5rem;
+      }
+    }
+
+    /* Fallback strategy for browsers that do not support font-size-adjust: from-font */
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container {
+        font-size: 1rem;
+        line-height: 1.6;
+      }
+
+      #mixed-fonts-container code {
+        font-size: 1.08em;
+        line-height: 1.5;
+      }
+
+      #independent-theme-container {
+        font-size: 1.15rem;
+        line-height: 1.6;
+      }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>Typography Normalization Demo</h1>
+
+    <section aria-labelledby="mixed-fonts-heading">
+      <h2 id="mixed-fonts-heading">Mixed Fonts Container</h2>
+      <p id="mixed-fonts-container">
+        When mixing regular body copy with inline code snippets such as
+        <code>const aspectRatio = "from-font";</code> or
+        <code>font-size-adjust: from-font</code>, differences in lowercase x-height
+        can make inline <code>&lt;code&gt;</code> elements appear visually mismatched.
+        Applying automatic x-height normalization keeps all mixed font families harmonized.
+      </p>
+    </section>
+
+    <section aria-labelledby="independent-theme-heading">
+      <h2 id="independent-theme-heading">Independent Theme Container</h2>
+      <div id="independent-theme-container">
+        <p>
+          This container uses an independent serif theme font stack whose natural x-height
+          differs from the primary sans-serif typography. By specifying an explicit numeric
+          <code>font-size-adjust</code> aspect-ratio value, its lowercase letter height is
+          locked to consistent visual proportions across themes.
+        </p>
+      </div>
+    </section>
+  </main>
+</body>
+</html>
