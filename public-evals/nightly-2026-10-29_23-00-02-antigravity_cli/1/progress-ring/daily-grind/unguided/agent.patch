+    /* Loyalty Rewards Section */
+    .rewards-section {
+      margin-top: 50px;
+    }
+
+    .rewards-card {
+      background: white;
+      padding: 35px 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      margin-top: 20px;
+      border-top: 4px solid var(--accent);
+    }
+
+    .progress-ring-container {
+      position: relative;
+      width: 180px;
+      height: 180px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex-shrink: 0;
+    }
+
+    .progress-ring {
+      width: 180px;
+      height: 180px;
+      transform: rotate(-90deg);
+    }
+
+    .progress-ring-track {
+      fill: none;
+      stroke: var(--secondary);
+      stroke-width: 14;
+    }
+
+    .progress-ring-fill {
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 14;
+      stroke-linecap: round;
+      stroke-dasharray: 440;
+      stroke-dashoffset: 88; /* 80% progress (8 of 10 drinks) */
+      transition: stroke-dashoffset 0.5s ease;
+    }
+
+    .progress-ring-center {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      text-align: center;
+      padding: 20px;
+    }
+
+    .progress-count {
+      font-size: 1.8rem;
+      font-weight: bold;
+      color: var(--primary);
+      line-height: 1.1;
+    }
+
+    .progress-label {
+      font-size: 0.8rem;
+      color: var(--text);
+      margin-top: 4px;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+    }
+
+    .progress-subtext {
+      font-size: 0.75rem;
+      color: var(--primary);
+      margin-top: 2px;
+    }
+
+    .rewards-details {
+      max-width: 480px;
+      text-align: left;
+    }
+
+    .rewards-details h3 {
+      font-size: 1.5rem;
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .rewards-details p {
+      margin-bottom: 12px;
+      color: var(--text);
+    }
+
+    .rewards-perks {
+      list-style: none;
+      margin: 15px 0;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+      gap: 8px;
+    }
+
+    .rewards-perks li {
+      font-size: 0.9rem;
+      display: flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    .perk-badge {
+      display: inline-block;
+      width: 8px;
+      height: 8px;
+      border-radius: 50%;
+      background: var(--accent);
+    }
+
+    @media (max-width: 600px) {
+      .rewards-details {
+        text-align: center;
+      }
+    }
+
