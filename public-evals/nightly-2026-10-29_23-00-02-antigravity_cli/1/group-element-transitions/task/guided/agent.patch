+        roast: 'Medium Roast',
+        price: 19,
+        notes: 'Brown sugar sweetness, crisp red apple, and silky body.',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+      },
+      'sumatra-mandheling': {
+        name: 'Sumatra Mandheling',
+        origin: 'Indonesia',
+        roast: 'Dark Roast',
+        price: 21,
+        notes: 'Earthy cedar, dark baker chocolate, and full-bodied spice.',
+        image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80'
+      },
+      'kenya-aa': {
+        name: 'Kenya AA Nyeri',
+        origin: 'Kenya',
+        roast: 'Light Roast',
+        price: 23,
+        notes: 'Juicy blackcurrant, ruby grapefruit, and sparkling acidity.',
+        image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80'
+      },
+      'costa-rica-tarrazu': {
+        name: 'Costa Rica Tarrazú',
+        origin: 'Costa Rica',
+        roast: 'Medium Roast',
+        price: 20,
+        notes: 'Honeycrisp apple, wildflower honey, and clean citrus finish.',
+        image: 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80'
+      }
+    };
+
+    const DEFAULT_SELECTION = [
+      { instanceId: 'bean-item-1', beanKey: 'ethiopian-yirgacheffe' },
+      { instanceId: 'bean-item-2', beanKey: 'guatemala-antigua' },
+      { instanceId: 'bean-item-3', beanKey: 'brazil-cerrado' },
+      { instanceId: 'bean-item-4', beanKey: 'house-espresso' }
+    ];
+
+    let nextInstanceCounter = 5;
+    let selectedBeans = DEFAULT_SELECTION.map((item) => ({ ...item }));
+
+    const beanListEl = document.getElementById('bean-list');
+    const beanSummaryEl = document.getElementById('bean-summary');
+    const beanSelectEl = document.getElementById('bean-catalog-select');
+    const addBeanBtn = document.getElementById('add-bean-btn');
+    const resetBeansBtn = document.getElementById('reset-beans-btn');
+    const quickAddContainer = document.getElementById('quick-add-container');
+
+    function createBeanElement(item) {
+      const bean = BEAN_CATALOG[item.beanKey];
+      const li = document.createElement('li');
+      li.className = 'bean-item';
+      li.dataset.instanceId = item.instanceId;
+      // Assign a unique view-transition-name per item in the group
+      li.style.viewTransitionName = item.instanceId;
+
+      const img = document.createElement('img');
+      img.className = 'bean-item-image';
+      img.src = bean.image;
+      img.alt = `${bean.name} coffee beans`;
+
+      const body = document.createElement('div');
+      body.className = 'bean-item-body';
+
+      const meta = document.createElement('div');
+      meta.className = 'bean-item-meta';
+      const originSpan = document.createElement('span');
+      originSpan.textContent = bean.origin;
+      const roastSpan = document.createElement('span');
+      roastSpan.className = 'roast-badge';
+      roastSpan.textContent = bean.roast;
+      meta.append(originSpan, roastSpan);
+
+      const title = document.createElement('h3');
+      title.textContent = bean.name;
+
+      const notes = document.createElement('p');
+      notes.className = 'bean-notes';
+      notes.textContent = bean.notes;
+
+      const footer = document.createElement('div');
+      footer.className = 'bean-item-footer';
+
+      const price = document.createElement('span');
+      price.className = 'bean-price';
+      price.textContent = `$${bean.price} / 12oz`;
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'remove-bean-btn';
+      removeBtn.dataset.removeId = item.instanceId;
+      removeBtn.setAttribute('aria-label', `Remove ${bean.name}`);
+      removeBtn.textContent = 'Remove';
+
+      footer.append(price, removeBtn);
+      body.append(meta, title, notes, footer);
+      li.append(img, body);
+      return li;
+    }
+
+    function updateDOM() {
+      beanListEl.replaceChildren();
+
+      if (selectedBeans.length === 0) {
+        const emptyLi = document.createElement('li');
+        emptyLi.className = 'bean-empty-state';
+        emptyLi.textContent = 'Your coffee bean box is empty. Select a roast above to add beans!';
+        beanListEl.appendChild(emptyLi);
+      } else {
+        for (const item of selectedBeans) {
+          beanListEl.appendChild(createBeanElement(item));
+        }
+      }
+
+      const totalCost = selectedBeans.reduce(
+        (sum, item) => sum + (BEAN_CATALOG[item.beanKey]?.price || 0),
+        0
+      );
+      const bagLabel = selectedBeans.length === 1 ? 'Bag' : 'Bags';
+      beanSummaryEl.textContent = `${selectedBeans.length} ${bagLabel} Selected \u2022 $${totalCost} Total`;
+    }
+
+    function transitionDOMUpdate(mutationFn) {
+      if (document.startViewTransition) {
+        document.startViewTransition(() => {
+          mutationFn();
+          updateDOM();
+        });
+      } else {
+        // Fallback: Perform the update immediately without animation
+        mutationFn();
+        updateDOM();
+      }
+    }
+
+    function addBean(beanKey) {
+      if (!BEAN_CATALOG[beanKey]) return;
+      const newInstanceId = `bean-item-${nextInstanceCounter++}`;
+      transitionDOMUpdate(() => {
+        selectedBeans.push({ instanceId: newInstanceId, beanKey });
+      });
+    }
+
+    function removeBean(instanceId) {
+      transitionDOMUpdate(() => {
+        selectedBeans = selectedBeans.filter((item) => item.instanceId !== instanceId);
+      });
+    }
+
+    addBeanBtn.addEventListener('click', () => {
+      addBean(beanSelectEl.value);
+    });
+
+    quickAddContainer.addEventListener('click', (event) => {
+      const btn = event.target.closest('[data-quick-add]');
+      if (!btn) return;
+      addBean(btn.dataset.quickAdd);
+    });
+
+    beanListEl.addEventListener('click', (event) => {
+      const btn = event.target.closest('[data-remove-id]');
+      if (!btn) return;
+      removeBean(btn.dataset.removeId);
+    });
+
+    resetBeansBtn.addEventListener('click', () => {
+      transitionDOMUpdate(() => {
+        selectedBeans = DEFAULT_SELECTION.map((item) => ({ ...item }));
+      });
+    });
+
+    updateDOM();
+  </script>
 </body>
 
