+        roast: 'Medium-Dark',
+        price: 20,
+        notes: 'Velvety dark chocolate, toasted almond, and warm baking spice.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      'brazil-cerrado': {
+        name: 'Brazil Cerrado',
+        origin: 'Brazil',
+        roast: 'Medium Roast',
+        price: 18,
+        notes: 'Roasted hazelnut, sweet caramel, and low-acidity cocoa body.',
+        image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+      },
+      'house-espresso': {
+        name: 'Daily Grind House Espresso',
+        origin: 'Signature Blend',
+        roast: 'Dark Roast',
+        price: 19,
+        notes: 'Rich molasses, bittersweet dark cocoa, and syrupy crema.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+      },
+      'colombian-supremo': {
+        name: 'Colombian Supremo',
