+      animation-duration: 0.45s;
+      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+    }
+
+    /* A ::view-transition-old() element is the only child if it isn't present after the view transition (removed element) */
+    ::view-transition-old(.bean-card):only-child {
+      animation-name: bean-exit;
+      animation-duration: 0.35s;
+      animation-timing-function: ease-in;
+    }
+
+    @keyframes bean-enter {
+      from {
+        opacity: 0;
+        translate: 0 24px;
+        scale: 0.92;
+      }
+    }
+
+    @keyframes bean-exit {
+      to {
+        opacity: 0;
+        translate: 0 -20px;
+        scale: 0.9;
+      }
+    }
+
+    /* Handle accessibility by respecting motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
