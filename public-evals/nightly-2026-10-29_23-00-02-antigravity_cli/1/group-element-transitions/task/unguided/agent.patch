+          price: '$16.50',
+          description: 'Smooth and comforting profile of roasted peanut, creamy nougat, and sweet milk chocolate.',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        },
+        'ethiopia': {
+          name: 'Ethiopian Yirgacheffe',
+          roast: 'Light Roast',
+          price: '$19.50',
+          description: 'Bright floral aroma with delicate notes of bergamot, jasmine, and sweet lemon zest.',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+        },
+        'colombia': {
+          name: 'Colombian Supremo',
+          roast: 'Medium Roast',
+          price: '$17.00',
+          description: 'Velvety body balanced by rich caramel sweetness, toasted walnut, and a crisp citrus finish.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        },
+        'espresso-blend': {
+          name: 'House Espresso Blend',
+          roast: 'Dark Roast',
+          price: '$18.00',
+          description: 'Full-bodied and syrupy with bittersweet dark chocolate, molasses, and roasted hazelnut notes.',
+          image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+        }
+      };
+
+      let nextBeanId = 5;
+      const beanGrid = document.getElementById('bean-grid');
+      const addBeanBtn = document.getElementById('add-bean-btn');
+      const beanSelect = document.getElementById('bean-variety-select');
+      const beanCount = document.getElementById('bean-count');
+
+      function updateWithViewTransition(updateCallback) {
+        if (document.startViewTransition) {
+          return document.startViewTransition(() => {
+            updateCallback();
+          });
+        } else {
+          updateCallback();
+        }
+      }
+
+      function updateCountBadge() {
+        const count = beanGrid.querySelectorAll('.bean-card').length;
+        beanCount.textContent = count === 1 ? '1 Bean Selected' : `${count} Beans Selected`;
+      }
+
+      function createBeanCard(beanKey, uniqueId) {
+        const data = beanCatalog[beanKey] || beanCatalog['ethiopia'];
+        const article = document.createElement('article');
+        article.className = 'bean-card';
+        article.dataset.beanId = uniqueId;
+        article.style.viewTransitionName = uniqueId;
+
+        article.innerHTML = `
+          <img class="bean-card-img" src="${data.image}" alt="${data.name} coffee beans">
+          <div class="bean-card-body">
+            <div class="bean-meta">
+              <span class="roast-badge">${data.roast}</span>
+              <span class="bean-price">${data.price}</span>
+            </div>
+            <h3>${data.name}</h3>
+            <p>${data.description}</p>
+            <button type="button" class="btn-remove" data-action="remove">Remove</button>
+          </div>
+        `;
+        return article;
+      }
+
+      addBeanBtn.addEventListener('click', () => {
+        const selectedKey = beanSelect.value;
+        const uniqueId = `bean-${nextBeanId++}`;
+        const newCard = createBeanCard(selectedKey, uniqueId);
+
+        updateWithViewTransition(() => {
+          beanGrid.appendChild(newCard);
+          updateCountBadge();
+        });
+
+        // Cycle select to the next option for convenient repeated additions
+        beanSelect.selectedIndex = (beanSelect.selectedIndex + 1) % beanSelect.options.length;
+      });
+
+      beanGrid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('[data-action="remove"]');
+        if (!removeBtn) return;
+
+        const card = removeBtn.closest('.bean-card');
+        if (!card) return;
+
+        updateWithViewTransition(() => {
+          card.remove();
+          updateCountBadge();
+        });
+      });
+    })();
+  </script>
