+        'kenya': {
+          name: 'Kenyan AA Nyeri',
+          roast: 'Light-Medium',
+          price: '$20.00',
+          description: 'Juicy and aromatic with vibrant blackcurrant, ruby grapefruit, and cane sugar sweetness.',
+          image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+        },
+        'costa-rica': {
+          name: 'Costa Rican Tarrazú',
+          roast: 'Medium Roast',
+          price: '$18.50',
+          description: 'Clean, vibrant cup featuring honeyed sweetness, crisp green apple, and milk chocolate.',
+          image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
