+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMsg = document.getElementById('newsletter-error');
+      const successMsg = document.getElementById('newsletter-success');
+
+      function isValidEmail(value) {
+        const trimmed = value.trim();
+        if (!trimmed) return false;
+        return emailInput.checkValidity() && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed);
+      }
+
+      function clearErrorState() {
+        emailInput.classList.remove('invalid', 'error');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorMsg.hidden = true;
+      }
+
+      function showErrorState() {
+        emailInput.classList.add('invalid', 'error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMsg.hidden = false;
+        successMsg.hidden = true;
+      }
+
+      // Clear any error state while the user is actively focusing or typing
+      emailInput.addEventListener('focus', function () {
+        clearErrorState();
+      });
+
+      emailInput.addEventListener('input', function () {
+        clearErrorState();
+        successMsg.hidden = true;
+      });
+
+      // Only validate after the user clicks away (blurs)
+      emailInput.addEventListener('blur', function () {
+        const value = emailInput.value.trim();
+        if (value.length > 0 && !isValidEmail(value)) {
+          showErrorState();
+        } else {
+          clearErrorState();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const value = emailInput.value.trim();
+        if (!isValidEmail(value)) {
+          showErrorState();
+          return;
+        }
+        clearErrorState();
+        successMsg.hidden = false;
+        emailInput.value = '';
+      });
+    })();
+  </script>
+
 </body>
 
