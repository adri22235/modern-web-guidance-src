+    /* Interest Invoker & Hovercard Styles */
+    [interestfor] {
+      --interest-delay-start: 0.2s;
+      --interest-delay-end: 0.1s;
+      interest-delay: var(--interest-delay-start) var(--interest-delay-end);
+      interest-delay-start: var(--interest-delay-start);
+      interest-delay-end: var(--interest-delay-end);
+    }
+
+    :root:has(:is(:interest-source, .interest-source)) [interestfor] {
+      --interest-delay-start: 0s;
+      interest-delay-start: 0s;
+    }
+
+    [popover].hovercard {
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline;
+      margin: 8px 0;
+      width: min(320px, 90vw);
+      padding: 16px;
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 10px 25px rgba(62, 39, 35, 0.18);
+      text-align: left;
+      opacity: 0;
+      transform-origin: top;
+    }
+
+    [popover].hovercard:is(:popover-open, .\:popover-open) {
+      display: block;
+      opacity: 1;
+      transform: translateY(0) scale(1);
+    }
+
+    @starting-style {
+      [popover].hovercard:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        transform: translateY(-10px) scale(0.95);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover].hovercard {
+        transition:
+          opacity,
+          transform,
+          display,
+          overlay;
+        transition-duration: 0.4s;
+        transition-behavior: allow-discrete;
+      }
+    }
+
+    .hovercard-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 4px;
+    }
+
+    .hovercard-header h4 {
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin: 0;
+    }
+
+    .hovercard-price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 0.95rem;
+    }
+
+    .hovercard-meta {
+      font-size: 0.8rem;
+      color: #6d4c41;
+      margin-bottom: 10px;
+    }
+
+    .hovercard-body {
+      display: flex;
+      gap: 12px;
+      align-items: flex-start;
+    }
+
+    .hovercard-body img {
+      width: 88px;
+      height: 88px;
+      object-fit: cover;
+      border-radius: 6px;
+      flex-shrink: 0;
+    }
+
+    .hovercard-body p {
+      font-size: 0.85rem;
+      line-height: 1.45;
+      margin-bottom: 8px;
+    }
+
+    .hovercard-tags {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 6px;
+      list-style: none;
+      margin-top: 8px;
+    }
+
+    .hovercard-tags li {
+      background: var(--light);
