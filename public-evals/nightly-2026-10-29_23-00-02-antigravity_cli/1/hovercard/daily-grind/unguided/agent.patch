+  <script>
+    document.querySelectorAll('.hovercard-wrapper').forEach((wrapper) => {
+      let hideTimeout;
+
+      wrapper.addEventListener('mouseenter', () => {
+        clearTimeout(hideTimeout);
+        wrapper.classList.add('is-open');
+      });
+
+      wrapper.addEventListener('mouseleave', () => {
+        hideTimeout = setTimeout(() => {
+          wrapper.classList.remove('is-open');
+        }, 120);
+      });
+
+      const priceEl = wrapper.querySelector('[data-price]');
+      const calEl = wrapper.querySelector('[data-calories]');
+      const cafEl = wrapper.querySelector('[data-caffeine]');
+      const sizeBtns = wrapper.querySelectorAll('.hovercard-size-btn');
+
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          e.stopPropagation();
+          sizeBtns.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          if (priceEl && btn.dataset.p) priceEl.textContent = btn.dataset.p;
+          if (calEl && btn.dataset.cal) calEl.textContent = btn.dataset.cal;
+          if (cafEl && btn.dataset.caf) cafEl.textContent = btn.dataset.caf;
+        });
+      });
+    });
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape') {
+        document.querySelectorAll('.hovercard-wrapper.is-open').forEach((w) => {
+          w.classList.remove('is-open');
+        });
+        if (document.activeElement && document.activeElement.closest('.hovercard-wrapper')) {
+          document.activeElement.blur();
+        }
+      }
+    });
+  </script>
+
