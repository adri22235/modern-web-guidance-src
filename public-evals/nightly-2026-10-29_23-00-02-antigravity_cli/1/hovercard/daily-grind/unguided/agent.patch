+    /* Hovercard Component */
+    .hovercard-wrapper {
+      position: relative;
+      display: inline-block;
+      margin-top: 15px;
+    }
+
+    .hovercard-wrapper .btn {
+      margin-top: 0;
+    }
+
+    .hovercard {
+      position: absolute;
+      bottom: calc(100% + 14px);
+      left: 50%;
+      transform: translateX(-50%) translateY(8px);
+      width: 310px;
+      background: #ffffff;
+      border-radius: 12px;
+      box-shadow: 0 12px 32px rgba(62, 39, 35, 0.22), 0 2px 8px rgba(0, 0, 0, 0.08);
+      border: 1px solid rgba(215, 204, 200, 0.8);
+      text-align: left;
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
+      z-index: 900;
+    }
+
+    /* Invisible hover bridge so moving the cursor from button to popup stays active */
+    .hovercard::before {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 0;
+      width: 100%;
+      height: 18px;
+    }
+
+    /* Pointer arrow */
+    .hovercard::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border-width: 8px;
+      border-style: solid;
+      border-color: #ffffff transparent transparent transparent;
+      filter: drop-shadow(0 2px 2px rgba(62, 39, 35, 0.1));
+    }
+
+    .hovercard-wrapper:hover .hovercard,
+    .hovercard-wrapper:focus-within .hovercard,
+    .hovercard-wrapper.is-open .hovercard {
+      opacity: 1;
+      visibility: visible;
+      pointer-events: auto;
+      transform: translateX(-50%) translateY(0);
