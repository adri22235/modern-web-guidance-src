+  <script>
+    const scroller = document.getElementById('scroller');
+    const statusEl = document.getElementById('status');
+    const originCards = Array.from(scroller.children);
+
+    let isScrolling = false;
+    let scrollTimeout = null;
+
+    function getMostVisibleOrigin() {
+      const scrollerRect = scroller.getBoundingClientRect();
+      let maxVisibleArea = -1;
+      let mostVisibleCard = originCards[0];
+
+      for (let i = 0; i < originCards.length; i++) {
+        const card = originCards[i];
+        const rect = card.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, scrollerRect.top);
+        const visibleBottom = Math.min(rect.bottom, scrollerRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+        const visibleLeft = Math.max(rect.left, scrollerRect.left);
+        const visibleRight = Math.min(rect.right, scrollerRect.right);
+        const visibleWidth = Math.max(0, visibleRight - visibleLeft);
+        const visibleArea = visibleHeight * visibleWidth;
+
+        if (visibleArea > maxVisibleArea) {
+          maxVisibleArea = visibleArea;
+          mostVisibleCard = card;
+        }
+      }
+
+      return mostVisibleCard
+        ? (mostVisibleCard.dataset.origin || mostVisibleCard.textContent.trim())
+        : '';
+    }
+
+    function handleScrollEnd() {
+      clearTimeout(scrollTimeout);
+      scrollTimeout = null;
+      isScrolling = false;
+      const visibleOrigin = getMostVisibleOrigin();
+      statusEl.textContent = `Scroll ended. Visible: ${visibleOrigin}`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!isScrolling) {
+        isScrolling = true;
+        statusEl.textContent = 'Scrolling...';
+      }
+      clearTimeout(scrollTimeout);
+      scrollTimeout = setTimeout(handleScrollEnd, 150);
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', handleScrollEnd, { passive: true });
+  </script>
+
