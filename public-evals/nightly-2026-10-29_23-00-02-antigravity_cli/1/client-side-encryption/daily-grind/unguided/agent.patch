+          const ctBytes = base64ToBytes(envelope.keyEstablishment.kemCiphertextBase64);
+          const ephBytes = base64ToBytes(envelope.keyEstablishment.ephemeralPublicKeyBase64);
+          pqSharedSecret = await decapsulatePqKem(keyring.pqKem, ctBytes);
+          classicalSharedSecret = await performClassicalKeyAgreementRecipient(keyring.x25519, ephBytes);
+        } else if (mode === 'pq-mlkem768') {
+          const ctBytes = base64ToBytes(envelope.keyEstablishment.kemCiphertextBase64);
+          pqSharedSecret = await decapsulatePqKem(keyring.pqKem, ctBytes);
+        } else if (mode === 'classical-ecdh-p256') {
+          const ephBytes = base64ToBytes(envelope.keyEstablishment.ephemeralPublicKeyBase64);
+          classicalSharedSecret = await performClassicalKeyAgreementRecipient(keyring.ecdhP256, ephBytes);
+        } else if (mode === 'classical-x25519') {
+          const ephBytes = base64ToBytes(envelope.keyEstablishment.ephemeralPublicKeyBase64);
+          classicalSharedSecret = await performClassicalKeyAgreementRecipient(keyring.x25519, ephBytes);
+        } else {
+          throw new Error('Unsupported mode in envelope: ' + mode);
+        }
+
+        const combinedSecretIkm = concatBytes(pqSharedSecret, classicalSharedSecret);
+        const hkdfSalt = base64ToBytes(envelope.keyEstablishment.hkdfSaltBase64);
+        const hkdfInfo = envelope.keyEstablishment.hkdfInfo;
+
+        const { aesKey, sharedSecretFingerprint } = await deriveAesGcmKeyFromSharedSecret(
+          combinedSecretIkm,
+          hkdfSalt,
+          hkdfInfo
+        );
+
+        const iv = base64ToBytes(envelope.aead.ivBase64);
+        const aadBytes = base64ToBytes(envelope.aead.aadBase64);
+        const ciphertextBody = base64ToBytes(envelope.aead.ciphertextBase64);
+        const authTag = base64ToBytes(envelope.aead.authTagBase64);
+        const combinedCiphertextAndTag = concatBytes(ciphertextBody, authTag);
+
+        const decryptedBuffer = await crypto.subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesKey,
+          combinedCiphertextAndTag
+        );
+
+        return {
+          plaintext: textDecoder.decode(decryptedBuffer),
+          sharedSecretFingerprint,
+          aad: envelope.aead.aad
+        };
+      }
+
+      // =========================================================================
+      // DOM Wiring & UI Updates
+      // =========================================================================
+      const elKeyId = document.getElementById('recipient-key-id');
+      const elPqFp = document.getElementById('pq-public-key-fingerprint');
+      const elClFp = document.getElementById('classical-public-key-fingerprint');
+      const elStatusBadge = document.getElementById('crypto-status-badge');
+      const elRotateKeysBtn = document.getElementById('rotate-keys-btn');
+
+      const elForm = document.getElementById('delivery-note-form');
+      const elModeSelect = document.getElementById('key-establishment-mode');
+      const elOrderId = document.getElementById('order-id');
+      const elNoteCategory = document.getElementById('note-category');
+      const elDeliveryAddress = document.getElementById('delivery-address');
+      const elDeliveryNote = document.getElementById('delivery-note');
+      const elFormFeedback = document.getElementById('form-feedback');
+
+      const elSuite = document.getElementById('envelope-suite');
+      const elKemEngineTag = document.getElementById('kem-engine-tag');
+      const elSecretFp = document.getElementById('shared-secret-fingerprint');
+      const elIvDisplay = document.getElementById('aead-iv-display');
+      const elKemCtDisplay = document.getElementById('kem-ciphertext-display');
+      const elKemCtSize = document.getElementById('kem-ciphertext-size');
+      const elEphPubDisplay = document.getElementById('ephemeral-pubkey-display');
+      const elEphPubSize = document.getElementById('ephemeral-pubkey-size');
+      const elCtDisplay = document.getElementById('aead-ciphertext-display');
+      const elCtSize = document.getElementById('aead-ciphertext-size');
+      const elTagDisplay = document.getElementById('aead-tag-display');
+      const elAadDisplay = document.getElementById('aead-aad-display');
+      const elEnvelopeJson = document.getElementById('encrypted-envelope-json');
+
+      const elCopyBtn = document.getElementById('copy-envelope-btn');
+      const elDecryptBtn = document.getElementById('decrypt-verify-btn');
+      const elTamperBtn = document.getElementById('tamper-payload-btn');
+      const elVerificationStatus = document.getElementById('verification-status');
+      const elDecryptedDisplay = document.getElementById('decrypted-note-display');
+
+      const elSavedCount = document.getElementById('saved-notes-count');
+      const elSavedList = document.getElementById('saved-notes-list');
+      const elClearSavedBtn = document.getElementById('clear-saved-notes-btn');
+
+      function updateKeyringHeader(keyring) {
+        elKeyId.textContent = keyring.keyId;
+        elPqFp.textContent = `${keyring.pqFingerprint} (${keyring.pqKem.publicKeyBytes.byteLength} B)`;
+        elClFp.textContent = `${keyring.classicalFingerprint} (${keyring.ecdhP256.publicKeyBytes.byteLength} B)`;
+      }
+
+      function renderEnvelopeInspector(envelope) {
+        currentEnvelope = envelope;
+        elSuite.textContent = envelope.suite;
+        elKemEngineTag.textContent = envelope.pqEngine;
+        elSecretFp.textContent = envelope.keyEstablishment.sharedSecretFingerprint;
+        elIvDisplay.textContent = envelope.aead.ivBase64;
+
+        if (envelope.keyEstablishment.kemCiphertextBase64) {
+          elKemCtDisplay.textContent = envelope.keyEstablishment.kemCiphertextBase64;
+          elKemCtSize.textContent = `${envelope.keyEstablishment.kemCiphertextBytes} B`;
+        } else {
+          elKemCtDisplay.textContent = 'N/A (Classical Key Agreement Mode)';
+          elKemCtSize.textContent = '0 B';
+        }
+
+        if (envelope.keyEstablishment.ephemeralPublicKeyBase64) {
+          elEphPubDisplay.textContent = envelope.keyEstablishment.ephemeralPublicKeyBase64;
+          elEphPubSize.textContent = `${envelope.keyEstablishment.ephemeralPublicKeyBytes} B`;
+        } else {
+          elEphPubDisplay.textContent = 'N/A (Pure Post-Quantum KEM Mode)';
+          elEphPubSize.textContent = '0 B';
+        }
+
+        elCtDisplay.textContent = envelope.aead.ciphertextBase64;
+        elCtSize.textContent = `${envelope.aead.ciphertextBytes} B`;
+        elTagDisplay.textContent = envelope.aead.authTagBase64;
+        elAadDisplay.textContent = JSON.stringify(envelope.aead.aad);
+        elEnvelopeJson.textContent = JSON.stringify(envelope, null, 2);
+      }
+
+      function loadSavedEnvelopes() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          return raw ? JSON.parse(raw) : [];
+        } catch (_) {
+          return [];
+        }
+      }
+
+      function saveEnvelopeToHistory(envelope) {
+        try {
+          const list = loadSavedEnvelopes();
+          list.unshift(envelope);
+          const trimmed = list.slice(0, 6);
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(trimmed));
+          renderSavedNotesList(trimmed);
+        } catch (_) {
+          // Ignore storage quota errors
+        }
+      }
+
+      function renderSavedNotesList(list) {
+        elSavedCount.textContent = String(list.length);
+        elSavedList.innerHTML = '';
+        if (list.length === 0) {
+          const empty = document.createElement('p');
+          empty.className = 'helper-text';
+          empty.textContent = 'No encrypted delivery notes stored yet.';
+          elSavedList.appendChild(empty);
+          return;
+        }
+
+        list.forEach((env) => {
+          const card = document.createElement('div');
+          card.className = 'saved-note-card';
+
+          const header = document.createElement('div');
+          header.className = 'saved-note-header';
+          const titleSpan = document.createElement('span');
+          titleSpan.textContent = `${env.aead.aad.orderId} • ${env.aead.aad.category}`;
+          const modeSpan = document.createElement('span');
+          modeSpan.style.fontSize = '0.73rem';
+          modeSpan.textContent = env.mode;
+          header.appendChild(titleSpan);
+          header.appendChild(modeSpan);
+
+          const addr = document.createElement('div');
+          addr.textContent = `Drop-off: ${env.aead.aad.deliveryAddress}`;
+
+          const cipherPreview = document.createElement('div');
+          cipherPreview.className = 'saved-note-cipher';
+          cipherPreview.textContent = `AEAD Ciphertext: ${env.aead.ciphertextBase64}`;
+
+          const tagPreview = document.createElement('div');
+          tagPreview.className = 'helper-text';
+          tagPreview.textContent = `Secret FP: ${env.keyEstablishment.sharedSecretFingerprint} | GCM Tag: ${env.aead.authTagBase64}`;
+
+          card.appendChild(header);
+          card.appendChild(addr);
+          card.appendChild(cipherPreview);
+          card.appendChild(tagPreview);
+          elSavedList.appendChild(card);
+        });
+      }
+
+      async function handleEncryptAndVerify(saveToStorage) {
+        const plaintextNote = elDeliveryNote.value.trim();
+        const orderId = elOrderId.value.trim() || 'DG-2026-4821';
+        const deliveryAddress = elDeliveryAddress.value.trim() || '742 Roast Ave, Apt 4B';
+        const noteCategory = elNoteCategory.value;
+        const mode = elModeSelect.value;
+
+        if (!plaintextNote) {
+          elFormFeedback.className = 'status-banner error';
+          elFormFeedback.textContent = 'Please enter a delivery note before encrypting.';
+          return;
+        }
+
+        const envelope = await encryptDeliveryNote({
+          mode,
+          orderId,
+          deliveryAddress,
+          noteCategory,
+          plaintextNote
+        });
+
+        renderEnvelopeInspector(envelope);
+
+        elFormFeedback.className = 'status-banner success';
+        elFormFeedback.textContent = `Shared secret established (${envelope.keyEstablishment.sharedSecretFingerprint}) and note encrypted with AES-256-GCM.`;
+
+        if (saveToStorage) {
+          saveEnvelopeToHistory(envelope);
+        }
+
+        // Automatically run courier decapsulation & verification to confirm round-trip integrity
+        const verified = await decryptDeliveryNoteEnvelope(envelope);
+        elVerificationStatus.className = 'status-banner success';
+        elVerificationStatus.textContent = `Decapsulated & Authenticated! Shared Secret FP: ${verified.sharedSecretFingerprint} • 128-bit GCM Tag & AAD Verified.`;
+        elDecryptedDisplay.textContent = verified.plaintext;
+      }
+
+      // Wire events
+      elForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        try {
+          await handleEncryptAndVerify(true);
+        } catch (err) {
+          elFormFeedback.className = 'status-banner error';
+          elFormFeedback.textContent = 'Encryption error: ' + err.message;
+        }
+      });
+
+      elModeSelect.addEventListener('change', async () => {
+        try {
+          await handleEncryptAndVerify(false);
+        } catch (err) {
+          elFormFeedback.className = 'status-banner error';
+          elFormFeedback.textContent = 'Mode switch error: ' + err.message;
+        }
+      });
+
+      elRotateKeysBtn.addEventListener('click', async () => {
+        const keyring = await generateCourierKeyring();
+        updateKeyringHeader(keyring);
+        await handleEncryptAndVerify(false);
+      });
+
+      document.querySelectorAll('.chip-btn').forEach((btn) => {
+        btn.addEventListener('click', async () => {
+          const preset = btn.getAttribute('data-preset');
+          if (preset) {
+            elDeliveryNote.value = preset;
+            await handleEncryptAndVerify(true);
+          }
+        });
+      });
+
+      elCopyBtn.addEventListener('click', async () => {
+        if (!currentEnvelope) return;
+        const json = JSON.stringify(currentEnvelope, null, 2);
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          try {
+            await navigator.clipboard.writeText(json);
+            elCopyBtn.textContent = 'Copied!';
+            setTimeout(() => {
+              elCopyBtn.textContent = 'Copy JSON Envelope';
+            }, 1500);
+          } catch (_) {
+            // Ignore clipboard permission errors in headless environments
+          }
+        }
+      });
+
+      elDecryptBtn.addEventListener('click', async () => {
+        if (!currentEnvelope) return;
+        try {
+          const verified = await decryptDeliveryNoteEnvelope(currentEnvelope);
+          elVerificationStatus.className = 'status-banner success';
+          elVerificationStatus.textContent = `Decapsulated & Authenticated! Shared Secret FP: ${verified.sharedSecretFingerprint} • 128-bit GCM Tag & AAD Verified.`;
+          elDecryptedDisplay.textContent = verified.plaintext;
+        } catch (err) {
+          elVerificationStatus.className = 'status-banner error';
+          elVerificationStatus.textContent = 'AEAD Authentication Failed: Ciphertext, Tag, or AAD was tampered with!';
+          elDecryptedDisplay.textContent = '[DECRYPTION REJECTED — UNTRUSTED PAYLOAD]';
+        }
+      });
+
+      elTamperBtn.addEventListener('click', async () => {
+        if (!currentEnvelope) return;
+        // Clone envelope and flip a bit in the AES-GCM ciphertext
+        const tamperedEnvelope = JSON.parse(JSON.stringify(currentEnvelope));
+        const ctBytes = base64ToBytes(tamperedEnvelope.aead.ciphertextBase64);
+        if (ctBytes.byteLength > 0) {
+          ctBytes[0] ^= 0xff;
+        }
+        tamperedEnvelope.aead.ciphertextBase64 = bytesToBase64(ctBytes);
+
+        try {
+          await decryptDeliveryNoteEnvelope(tamperedEnvelope);
+        } catch (_) {
+          elVerificationStatus.className = 'status-banner error';
+          elVerificationStatus.textContent = 'Tamper Detected! AES-256-GCM authentication tag verification failed — forged ciphertext rejected.';
+          elDecryptedDisplay.textContent = '[AUTHENTICATION FAILURE: GCM TAG MISMATCH]';
+        }
+      });
+
+      elClearSavedBtn.addEventListener('click', () => {
+        try {
+          localStorage.removeItem(STORAGE_KEY);
+        } catch (_) {}
+        renderSavedNotesList([]);
+      });
+
+      // Expose API for programmatic inspection/testing
+      window.DailyGrindCrypto = {
+        generateCourierKeyring,
+        encryptDeliveryNote,
+        decryptDeliveryNoteEnvelope,
+        getCurrentKeyring: () => currentKeyring,
+        getCurrentEnvelope: () => currentEnvelope
+      };
+
+      // Initialize on page load
+      (async function init() {
+        const keyring = await generateCourierKeyring();
+        updateKeyringHeader(keyring);
+        elStatusBadge.textContent = `Quantum-Safe Hybrid Active (${keyring.pqKem.isNative ? 'WebCrypto ML-KEM-768' : 'ML-KEM-768 PQ Engine'})`;
+        renderSavedNotesList(loadSavedEnvelopes());
+        await handleEncryptAndVerify(true);
+      })();
+    })();
+  </script>
+
