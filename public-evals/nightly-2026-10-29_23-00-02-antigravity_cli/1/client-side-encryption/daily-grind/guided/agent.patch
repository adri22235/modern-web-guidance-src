+/**
+ * Client-side Envelope Encryption for Daily Grind Delivery Notes
+ *
+ * Establishes shared secrets using post-quantum / hybrid Key Encapsulation Mechanisms
+ * ('MLKEM768-X25519', 'ML-KEM-768', 'ML-KEM-1024') with a classical ephemeral-static
+ * Diffie-Hellman fallback ('X25519' + 'HKDF' + 'AES-GCM'), and encrypts customer
+ * delivery notes in the browser using Authenticated Encryption with Associated Data
+ * ('ChaCha20-Poly1305' or 'AES-GCM') with a fresh 12-byte IV per message.
+ */
+
+const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+const IDB_NAME = 'daily-grind-crypto-store';
+const IDB_STORE = 'courier-kem-keys';
+const IDB_KEY_ID = 'recipient-kem-key';
+
+function normalizeSharedKeyAlgorithm(aeadAlgorithm) {
+  if (aeadAlgorithm === 'AES-GCM') {
+    return { name: 'AES-GCM', length: 256 };
+  }
+  return aeadAlgorithm;
+}
+
+/**
+ * Checks whether the current browser supports post-quantum/hybrid KEM encapsulation
+ * and the requested AEAD cipher via the static SubtleCrypto.supports() method.
+ *
+ * @param {string} [kemAlgorithm='MLKEM768-X25519']
+ * @param {string} [aeadAlgorithm='ChaCha20-Poly1305']
+ * @returns {boolean}
+ */
+export function supportsPostQuantumEnvelope(
+  kemAlgorithm = 'MLKEM768-X25519',
+  aeadAlgorithm = 'ChaCha20-Poly1305',
+) {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports(
+      'encapsulateKey',
+      kemAlgorithm,
+      normalizeSharedKeyAlgorithm(aeadAlgorithm),
+    )
+  );
+}
+
+/**
+ * Persist or load a non-extractable CryptoKeyPair in IndexedDB via structured cloning
+ * without ever exporting private key bytes.
+ */
+function openKeyDatabase() {
+  return new Promise((resolve, reject) => {
+    if (typeof indexedDB === 'undefined') {
+      resolve(null);
+      return;
+    }
+    const request = indexedDB.open(IDB_NAME, 1);
+    request.onupgradeneeded = () => {
+      const db = request.result;
+      if (!db.objectStoreNames.contains(IDB_STORE)) {
+        db.createObjectStore(IDB_STORE);
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => resolve(null);
+  });
+}
+
+export async function saveKeyPairToIndexedDB(record, keyId = IDB_KEY_ID) {
+  const db = await openKeyDatabase();
+  if (!db) return false;
+  return new Promise((resolve) => {
+    const tx = db.transaction(IDB_STORE, 'readwrite');
+    const objectStore = tx.objectStore(IDB_STORE);
+    objectStore.put(record, keyId);
+    tx.oncomplete = () => {
+      db.close();
+      resolve(true);
+    };
+    tx.onerror = () => {
+      db.close();
+      resolve(false);
+    };
+  });
+}
+
+export async function loadKeyPairFromIndexedDB(keyId = IDB_KEY_ID) {
+  const db = await openKeyDatabase();
+  if (!db) return null;
+  return new Promise((resolve) => {
+    const tx = db.transaction(IDB_STORE, 'readonly');
+    const objectStore = tx.objectStore(IDB_STORE);
+    const req = objectStore.get(keyId);
+    req.onsuccess = () => {
+      db.close();
+      resolve(req.result || null);
+    };
+    req.onerror = () => {
+      db.close();
+      resolve(null);
+    };
+  });
+}
+
+/**
+ * Generates a recipient key pair using the hybrid post-quantum KEM ('MLKEM768-X25519' by default,
+ * or 'ML-KEM-768' / 'ML-KEM-1024') with extractable: false, falling back to 'X25519' key agreement
+ * when post-quantum KEM is not supported by the browser.
+ *
+ * @param {string} [preferredKem='MLKEM768-X25519']
+ * @param {string} [preferredAead='ChaCha20-Poly1305']
+ */
+export async function generateRecipientKeys(
+  preferredKem = 'MLKEM768-X25519',
+  preferredAead = 'ChaCha20-Poly1305',
+) {
+  if (
+    preferredKem !== 'X25519' &&
+    supportsPostQuantumEnvelope(preferredKem, preferredAead)
+  ) {
+    const keyPair = await crypto.subtle.generateKey(
+      preferredKem,
+      false,
+      ['encapsulateKey', 'decapsulateKey'],
+    );
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    const record = {
+      suite: `${preferredKem}+${preferredAead}`,
+      kemAlgorithm: preferredKem,
+      aeadAlgorithm: preferredAead,
+      keyPair,
+      publicKeyBytes,
+    };
+    await saveKeyPairToIndexedDB(record);
+    return record;
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  const record = {
+    suite: 'X25519+HKDF+AES-GCM',
+    kemAlgorithm: 'X25519',
+    aeadAlgorithm: 'AES-GCM',
+    keyPair,
+    publicKeyBytes,
+  };
+  await saveKeyPairToIndexedDB(record);
+  return record;
+}
+
+/**
+ * Derives a 256-bit AES-GCM key from an X25519 shared secret via HKDF-SHA256.
+ * Used as the classical fallback when KEM encapsulation is unavailable.
+ */
+async function deriveFallbackAesKey(
+  privateKey,
+  peerPublicKey,
+  infoBytes = new TextEncoder().encode('envelope-v1'),
+) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey(
+    'raw',
+    sharedSecret,
+    'HKDF',
+    false,
+    ['deriveKey'],
+  );
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+/**
+ * Encapsulates a fresh one-time shared AEAD key and produces a ciphertext capsule
+ * for the recipient's public key.
+ *
+ * @param {CryptoKey | Uint8Array | ArrayBuffer} recipientPublicKeyOrBytes
+ * @param {Uint8Array} [infoBytes]
+ * @param {string} [aeadAlgorithm='ChaCha20-Poly1305']
+ */
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  infoBytes = new TextEncoder().encode('envelope-v1'),
+  aeadAlgorithm = 'ChaCha20-Poly1305',
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await (() => {
+          const bytes =
+            recipientPublicKeyOrBytes instanceof Uint8Array
+              ? recipientPublicKeyOrBytes
+              : new Uint8Array(recipientPublicKeyOrBytes);
+          const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+          return kemName
+            ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+            : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+        })();
+
+  if (pubKey.algorithm.name !== 'X25519') {
+    const normalizedAead = normalizeSharedKeyAlgorithm(aeadAlgorithm);
+    const targetAead =
+      typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      SubtleCrypto.supports('encapsulateKey', pubKey.algorithm.name, normalizedAead)
+        ? normalizedAead
+        : 'ChaCha20-Poly1305';
+
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      pubKey.algorithm.name,
+      pubKey,
+      targetAead,
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return { sharedKey, capsuleBytes };
+}
+
+/**
+ * Decapsulates the ciphertext capsule on the recipient to recover the identical shared AEAD key.
+ *
+ * @param {CryptoKey} recipientPrivateKey
+ * @param {Uint8Array} capsuleBytes
+ * @param {Uint8Array} [infoBytes]
+ * @param {string} [aeadAlgorithm='ChaCha20-Poly1305']
+ */
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  infoBytes = new TextEncoder().encode('envelope-v1'),
+  aeadAlgorithm = 'ChaCha20-Poly1305',
+) {
+  if (recipientPrivateKey.algorithm.name !== 'X25519') {
+    const normalizedAead = normalizeSharedKeyAlgorithm(aeadAlgorithm);
+    const targetAead =
+      typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      SubtleCrypto.supports('decapsulateKey', recipientPrivateKey.algorithm.name, normalizedAead)
+        ? normalizedAead
+        : 'ChaCha20-Poly1305';
+
+    return crypto.subtle.decapsulateKey(
+      recipientPrivateKey.algorithm.name,
+      recipientPrivateKey,
+      capsuleBytes,
+      targetAead,
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+
+  const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, 'X25519', true, []);
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Optional domain-separated key encapsulation via HKDF-SHA256 when multiple subkeys
+ * or explicit protocol context binding is required.
+ */
+export async function encapsulateKeyWithHkdf(
+  recipientPublicKey,
+  infoBytes = new TextEncoder().encode('envelope-v1'),
+) {
+  const { sharedKey: hkdfBaseKey, ciphertext } = await crypto.subtle.encapsulateKey(
+    recipientPublicKey.algorithm.name,
+    recipientPublicKey,
+    'HKDF',
+    false,
+    ['deriveKey'],
+  );
+
+  const aeadKey = await crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfBaseKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+
+  return { sharedKey: aeadKey, capsuleBytes: new Uint8Array(ciphertext) };
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * Always generates a fresh 12-byte (96-bit) IV per message and binds optional
+ * additionalData (AAD) to the authentication tag.
+ *
+ * @param {CryptoKey} key
+ * @param {string} plaintext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = new TextEncoder().encode(plaintext);
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded,
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload. Throws OperationError if tampered.
+ *
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext,
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+/**
+ * Serializes a Uint8Array to Base64 using Uint8Array.prototype.toBase64() when available,
+ * with a standard btoa fallback.
+ *
+ * @param {Uint8Array} bytes
+ * @returns {string}
+ */
+export function bytesToBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
