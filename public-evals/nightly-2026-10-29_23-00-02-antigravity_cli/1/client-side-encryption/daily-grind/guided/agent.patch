+    const metaSuite = document.getElementById('meta-suite');
+    const metaPubkeySize = document.getElementById('meta-pubkey-size');
+    const metaCapsuleSize = document.getElementById('meta-capsule-size');
+    const metaIvSize = document.getElementById('meta-iv-size');
+
+    let recipientRecord = null;
+    let currentEnvelope = null;
+
+    function showStatus(el, type, message) {
+      el.className = `status-banner ${type}`;
+      el.textContent = message;
+    }
+
+    function updateRecipientUI(record) {
+      const pqSupported = supportsPostQuantumEnvelope(record.kemAlgorithm, record.aeadAlgorithm);
+      suiteBadge.textContent = pqSupported
+        ? `Post-Quantum Ready: ${record.suite}`
+        : `Active Suite: ${record.suite}`;
+      metaSuite.textContent = record.suite;
+      metaPubkeySize.textContent = `${record.publicKeyBytes.byteLength} bytes`;
+      pubkeyPreview.textContent = bytesToBase64(record.publicKeyBytes);
+    }
+
+    async function initRecipientKeys(forceRotate = false) {
+      try {
+        const preferredKem = kemSelect.value;
+        const preferredAead = aeadSelect.value;
+
+        if (!forceRotate) {
+          const cached = await loadKeyPairFromIndexedDB();
+          if (cached && cached.keyPair && cached.publicKeyBytes) {
+            recipientRecord = cached;
+            updateRecipientUI(recipientRecord);
+            return;
+          }
+        }
+
+        recipientRecord = await generateRecipientKeys(preferredKem, preferredAead);
+        updateRecipientUI(recipientRecord);
+        if (forceRotate) {
+          showStatus(
+            senderStatus,
+            'success',
+            `Generated & persisted new non-extractable ${recipientRecord.suite} key pair in IndexedDB.`,
+          );
+        }
+      } catch (err) {
+        showStatus(senderStatus, 'error', `Key setup failed: ${err.message}`);
+      }
+    }
+
+    rotateKeysBtn.addEventListener('click', () => {
+      initRecipientKeys(true);
+    });
+
+    kemSelect.addEventListener('change', () => {
+      initRecipientKeys(true);
+    });
+
+    aeadSelect.addEventListener('change', () => {
+      initRecipientKeys(true);
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      try {
+        if (!recipientRecord) {
+          await initRecipientKeys(false);
+        }
+
+        const plaintext = noteInput.value.trim();
+        if (!plaintext) {
+          showStatus(senderStatus, 'error', 'Please enter delivery instructions to encrypt.');
+          return;
+        }
+
+        const orderId = orderIdInput.value.trim() || 'ORD-DEFAULT';
+        const additionalData = new TextEncoder().encode(`order:${orderId}`);
+        const infoBytes = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+        // Encapsulate a fresh shared key using the exported raw-public (or fallback raw) key bytes
+        const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+          recipientRecord.publicKeyBytes,
+          infoBytes,
+          recipientRecord.aeadAlgorithm,
+        );
+
+        // Encrypt the delivery note with a fresh 12-byte IV and AAD binding
+        const { iv, ciphertext } = await encryptMessage(sharedKey, plaintext, additionalData);
+
+        currentEnvelope = {
+          suite: recipientRecord.suite,
+          aeadAlgorithm: sharedKey.algorithm.name,
+          orderId,
+          additionalData,
+          infoBytes,
+          capsuleBytes,
+          iv,
+          ciphertext,
+        };
+
+        metaCapsuleSize.textContent = `${capsuleBytes.byteLength} bytes`;
+        metaIvSize.textContent = `${iv.byteLength} bytes`;
+
+        envelopePreview.textContent = JSON.stringify(
+          {
+            suite: currentEnvelope.suite,
+            orderId: currentEnvelope.orderId,
+            capsule: bytesToBase64(capsuleBytes),
+            iv: bytesToBase64(iv),
+            ciphertext: bytesToBase64(ciphertext),
+          },
+          null,
+          2,
+        );
+
+        decryptBtn.disabled = false;
+        tamperAadBtn.disabled = false;
+
+        showStatus(
+          senderStatus,
+          'success',
+          `Encrypted delivery note (${ciphertext.byteLength}B ciphertext + ${capsuleBytes.byteLength}B capsule) with ${currentEnvelope.aeadAlgorithm}.`,
+        );
+        recipientStatus.className = 'status-banner';
+        recipientStatus.textContent = '';
+      } catch (err) {
+        showStatus(senderStatus, 'error', `Encryption error: ${err.message}`);
+      }
+    });
+
+    decryptBtn.addEventListener('click', async () => {
+      if (!currentEnvelope || !recipientRecord) return;
+      try {
+        const recipientSharedKey = await decapsulateEnvelopeKey(
+          recipientRecord.keyPair.privateKey,
+          currentEnvelope.capsuleBytes,
+          currentEnvelope.infoBytes,
+          recipientRecord.aeadAlgorithm,
+        );
+
+        const decryptedText = await decryptMessage(
+          recipientSharedKey,
+          currentEnvelope.iv,
+          currentEnvelope.ciphertext,
+          currentEnvelope.additionalData,
+        );
+
+        showStatus(
+          recipientStatus,
+          'success',
+          `Verified AAD (order:${currentEnvelope.orderId}) & decrypted note: "${decryptedText}"`,
+        );
+      } catch (err) {
+        showStatus(
+          recipientStatus,
+          'error',
+          `Decryption rejected (${err.name}): Authentication tag or AAD verification failed.`,
+        );
+      }
+    });
+
+    tamperAadBtn.addEventListener('click', async () => {
+      if (!currentEnvelope || !recipientRecord) return;
+      try {
+        const recipientSharedKey = await decapsulateEnvelopeKey(
+          recipientRecord.keyPair.privateKey,
+          currentEnvelope.capsuleBytes,
+          currentEnvelope.infoBytes,
+          recipientRecord.aeadAlgorithm,
+        );
+
+        const tamperedAad = new TextEncoder().encode(`order:${currentEnvelope.orderId}-TAMPERED`);
+        await decryptMessage(
+          recipientSharedKey,
+          currentEnvelope.iv,
+          currentEnvelope.ciphertext,
+          tamperedAad,
+        );
+      } catch (err) {
+        showStatus(
+          recipientStatus,
+          'error',
+          `Tamper check passed! decrypt() threw ${err.name || 'OperationError'} when AAD metadata was modified.`,
+        );
+      }
+    });
+
+    initRecipientKeys(false);
+  </script>
+
 </body>
 
