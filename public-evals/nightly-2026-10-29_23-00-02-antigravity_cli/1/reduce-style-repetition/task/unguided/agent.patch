diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13,8 +13,20 @@
       --text: #3e2723;
       --light: #fafafa;
     }
 
+    @function --cool-gradient(--start: var(--light), --end: var(--secondary), --angle: 135deg) {
+      result: linear-gradient(var(--angle), var(--start), var(--end));
+    }
+
+    @function --responsive-columns(--cols: 2) {
+      result: 1fr;
