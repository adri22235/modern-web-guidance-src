       line-height: 1.6;
       color: var(--text);
-      background-color: var(--light);
+      background: --cool-gradient(var(--light), var(--secondary));
     }
 
+    h2 {
+      background: --cool-gradient(var(--accent), var(--secondary));
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -97,13 +113,26 @@
