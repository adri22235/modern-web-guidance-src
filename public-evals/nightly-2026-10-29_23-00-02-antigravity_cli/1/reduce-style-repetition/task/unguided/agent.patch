+      grid-template-columns: --responsive-columns();
     }
 
+    main > section {
+      grid-column: 1 / -1;
+      display: grid;
+      grid-template-columns: --responsive-columns();
+    }
+
+    main > section > h2,
+    main > section > .grid {
+      grid-column: 1 / -1;
+    }
+
     .grid {
       display: grid;
-      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      grid-template-columns: --responsive-columns();
       gap: 20px;
       margin-top: 20px;
     }
 
