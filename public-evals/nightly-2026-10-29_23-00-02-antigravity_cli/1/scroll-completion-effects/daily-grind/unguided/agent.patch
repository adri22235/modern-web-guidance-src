+          if (byData) return byData;
+        }
+
+        const rawHref = link.getAttribute('href') || '';
+        if (rawHref.startsWith('#') && rawHref.length > 1) {
+          const id = decodeURIComponent(rawHref.slice(1));
+          return document.getElementById(id);
+        }
+
+        if (PATH_TO_ID_MAP[rawHref]) {
+          return document.getElementById(PATH_TO_ID_MAP[rawHref]);
+        }
+
+        return null;
+      }
+
+      function clearTargetEffects() {
