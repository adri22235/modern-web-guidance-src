+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        window.scrollTo({ top: destinationY, behavior: 'smooth' });
+
+        // Fallback if scroll distance is negligible or environment does not emit scrollend
+        const initialFallbackMs = distance <= 2 ? 180 : 750;
+        fallbackTimer = setTimeout(() => {
+          if (!hasScrolled || Math.abs(window.scrollY - destinationY) <= 8) {
+            completeScroll();
+          } else {
+            fallbackTimer = setTimeout(completeScroll, 400);
+          }
+        }, initialFallbackMs);
+      }
+
+      document.addEventListener('click', function (event) {
+        const link = event.target.closest('a');
+        if (!link) return;
+
+        const target = resolveTargetElement(link);
+        if (!target) return;
+
+        event.preventDefault();
+        smoothScrollToTarget(target, link);
+      });
+    })();
