+  <script>
+    (function () {
+      const theaterBtn = document.getElementById('theater-mode-btn');
+      const iframe = document.getElementById('roasting-video');
+      const hero = document.querySelector('.hero');
+      const mainContainer = document.querySelector('main.container');
+      const seasonalSection = document.getElementById('seasonal-section');
+
+      let isTheaterMode = false;
+
+      function reparentIframe(targetParent, referenceNode = null) {
+        if ('moveBefore' in targetParent && typeof targetParent.moveBefore === 'function') {
+          targetParent.moveBefore(iframe, referenceNode);
+        } else if (referenceNode) {
+          targetParent.insertBefore(iframe, referenceNode);
+        } else {
+          targetParent.appendChild(iframe);
+        }
+      }
+
+      theaterBtn.addEventListener('click', function () {
+        isTheaterMode = !isTheaterMode;
+        if (isTheaterMode) {
+          reparentIframe(hero, null);
+          hero.classList.add('theater-active');
+          theaterBtn.setAttribute('aria-pressed', 'true');
+        } else {
+          reparentIframe(mainContainer, seasonalSection);
+          hero.classList.remove('theater-active');
+          theaterBtn.setAttribute('aria-pressed', 'false');
+        }
+      });
+    })();
+  </script>
+
