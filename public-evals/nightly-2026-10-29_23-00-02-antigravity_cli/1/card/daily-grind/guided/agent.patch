+  <script>
+    // Handle order form submissions right from the card
+    document.querySelectorAll('.order-form').forEach((form) => {
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const size = data.get('size');
+        const card = form.closest('.card');
+        const drinkTitle = card?.querySelector('h3')?.textContent?.trim() || 'Drink';
+        const statusEl = form.querySelector('.order-status');
+        const submitBtn = form.querySelector('button[type="submit"]');
+
+        if (statusEl && size) {
+          const formattedSize = String(size).charAt(0).toUpperCase() + String(size).slice(1);
+          statusEl.textContent = `Added ${formattedSize} ${drinkTitle} to your order!`;
+        }
+
+        if (submitBtn) {
+          submitBtn.disabled = true;
+          setTimeout(() => {
+            submitBtn.disabled = false;
+          }, 800);
+        }
+      });
+    });
+
+    // Fallback JavaScript for older browsers that do not support :has()
+    if (!CSS.supports('selector(:has(*))')) {
+      document.querySelectorAll('.card').forEach((card) => {
+        if (card.querySelector('img')) {
+          card.classList.add('has-image');
+        }
+        const checkedRadio = card.querySelector('input[type="radio"]:checked');
+        if (checkedRadio) {
+          card.classList.add('is-selected');
+          checkedRadio.closest('.size-option')?.classList.add('is-checked');
+        }
+        card.querySelectorAll('input[type="radio"]').forEach((radio) => {
+          radio.addEventListener('change', () => {
+            card.classList.add('is-selected');
+            card.querySelectorAll('.size-option').forEach((opt) => {
+              const input = opt.querySelector('input[type="radio"]');
+              opt.classList.toggle('is-checked', Boolean(input && input.checked));
+            });
+          });
+        });
+      });
+    }
+  </script>
+
