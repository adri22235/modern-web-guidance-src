+  <script>
+    const drawer = document.getElementById('nav-drawer');
+    const menuBtn = document.querySelector('.menu-btn');
+    const drawerPanel = drawer.querySelector('.drawer-panel');
+    let scrollTimer = null;
+
+    // Sync ARIA state and reset scroll-snap position when opened
+    drawer.addEventListener('toggle', (event) => {
+      const isOpen = event.newState === 'open';
+      menuBtn.setAttribute('aria-expanded', String(isOpen));
+      if (isOpen) {
+        drawer.scrollLeft = 0;
+      }
+    });
+
+    // Close the popover when native scroll-snap settles on the dismiss target
+    drawer.addEventListener('scrollend', () => {
+      if (drawer.matches(':popover-open') && drawer.scrollLeft >= drawer.clientWidth * 0.5) {
+        drawer.hidePopover();
+      }
+    });
+
+    // Fallback for environments where scroll fires without scrollend
+    drawer.addEventListener('scroll', () => {
+      clearTimeout(scrollTimer);
+      if (!drawer.matches(':popover-open')) return;
+      if (drawer.scrollLeft >= drawer.clientWidth - 2) {
+        drawer.hidePopover();
+        return;
+      }
+      scrollTimer = setTimeout(() => {
+        if (drawer.matches(':popover-open') && drawer.scrollLeft >= drawer.clientWidth * 0.5) {
+          drawer.hidePopover();
+        }
+      }, 120);
+    }, { passive: true });
+
+    // Close if clicking the dismiss area or backdrop region directly
+    drawer.addEventListener('click', (event) => {
+      if (!drawerPanel.contains(event.target)) {
+        drawer.hidePopover();
+      }
+    });
+
+    // Fallback for synthetic touch / pointer swipe gestures
+    let startX = null;
+    let startY = null;
+
+    drawerPanel.addEventListener('touchstart', (event) => {
+      if (event.touches.length === 1) {
+        startX = event.touches[0].clientX;
+        startY = event.touches[0].clientY;
+      }
+    }, { passive: true });
+
+    drawerPanel.addEventListener('touchend', (event) => {
+      if (startX === null || event.changedTouches.length === 0) return;
+      const dx = event.changedTouches[0].clientX - startX;
+      const dy = event.changedTouches[0].clientY - startY;
+      startX = null;
+      startY = null;
+      if (dx < -50 && Math.abs(dx) > Math.abs(dy) && drawer.scrollLeft < 10 && drawer.matches(':popover-open')) {
+        drawer.hidePopover();
+      }
+    }, { passive: true });
+
+    drawerPanel.addEventListener('pointerdown', (event) => {
+      if (event.pointerType === 'mouse' && event.button === 0) {
+        startX = event.clientX;
+        startY = event.clientY;
+      }
+    });
+
+    drawerPanel.addEventListener('pointerup', (event) => {
+      if (startX === null || event.pointerType !== 'mouse') return;
+      const dx = event.clientX - startX;
+      const dy = event.clientY - startY;
+      startX = null;
+      startY = null;
+      if (dx < -50 && Math.abs(dx) > Math.abs(dy) && drawer.matches(':popover-open')) {
+        drawer.hidePopover();
+      }
+    });
+  </script>
+
