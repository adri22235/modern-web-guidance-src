+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorited', 'active', 'checked', 'drink'];
+      }
+
+      constructor() {
+        super();
+        this._favorited = false;
+        this._updating = false;
+        this.attachShadow({ mode: 'open' });
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+              position: absolute;
+              top: 12px;
+              right: 12px;
+              color: #8d6e63;
+            }
+            :host([favorited]),
+            :host([active]),
+            :host([checked]) {
+              color: #e53935;
+            }
+            .favorite-btn {
+              display: inline-flex;
+              align-items: center;
+              justify-content: center;
+              gap: 4px;
+              width: 36px;
+              height: 36px;
+              border-radius: 50%;
+              border: 1px solid #d7ccc8;
+              background-color: #fafafa;
+              color: #8d6e63;
+              cursor: pointer;
+              padding: 0;
+              transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
+            }
+            .favorite-btn:hover {
+              border-color: #e53935;
+              color: #e53935;
+              background-color: #fff5f5;
+            }
+            .favorite-btn:focus-visible {
+              outline: 2px solid #ffab40;
+              outline-offset: 2px;
+            }
+            .favorite-btn.active {
+              background-color: #ffebee;
+              border-color: #e53935;
+              color: #e53935;
+            }
+            .heart-icon {
+              width: 18px;
+              height: 18px;
+              fill: transparent;
+              stroke: currentColor;
+              stroke-width: 2;
+              transition: fill 0.2s ease, transform 0.15s ease;
+            }
+            .favorite-btn.active .heart-icon {
+              fill: currentColor;
+              transform: scale(1.1);
+            }
+          </style>
+          <button type="button" class="favorite-btn" part="button" aria-pressed="false" aria-label="Favorite">
+            <svg class="heart-icon" viewBox="0 0 24 24" aria-hidden="true">
+              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+            </svg>
+          </button>
+        `;
+
+        this._button = this.shadowRoot.querySelector('.favorite-btn');
+        this.addEventListener('click', (e) => {
+          e.stopPropagation();
+          this.toggle();
+        });
+        this.addEventListener('keydown', (e) => {
+          if (e.target === this && (e.key === 'Enter' || e.key === ' ')) {
+            e.preventDefault();
+            this.toggle();
+          }
+        });
+      }
+
+      connectedCallback() {
+        const initial =
+          this.hasAttribute('favorited') ||
+          this.hasAttribute('active') ||
+          this.hasAttribute('checked') ||
+          this.getAttribute('aria-pressed') === 'true';
+        this._setFavorited(initial, false);
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (this._updating || oldValue === newValue) return;
+        if (name === 'drink') {
+          this._syncUI();
+        } else if (name === 'favorited' || name === 'active' || name === 'checked') {
+          this._setFavorited(newValue !== null, false);
+        }
+      }
+
+      get favorited() {
+        return this._favorited;
+      }
+
+      set favorited(val) {
+        this._setFavorited(Boolean(val), false);
+      }
+
+      get active() {
+        return this._favorited;
+      }
+
+      set active(val) {
+        this._setFavorited(Boolean(val), false);
+      }
+
+      get checked() {
+        return this._favorited;
+      }
+
+      set checked(val) {
+        this._setFavorited(Boolean(val), false);
+      }
+
+      get drink() {
+        return this.getAttribute('drink') || '';
+      }
+
+      set drink(val) {
+        this.setAttribute('drink', val);
+      }
+
+      toggle() {
+        this._setFavorited(!this._favorited, true);
+        return this._favorited;
+      }
+
+      _setFavorited(state, emitEvent) {
+        this._favorited = Boolean(state);
+        this._syncUI();
+        if (emitEvent) {
+          const detail = { favorited: this._favorited, active: this._favorited, drink: this.drink };
+          this.dispatchEvent(new CustomEvent('favorite-toggle', { detail, bubbles: true, composed: true }));
+          this.dispatchEvent(new CustomEvent('change', { detail, bubbles: true, composed: true }));
+        }
+      }
+
+      _syncUI() {
+        this._updating = true;
+        const isFav = this._favorited;
+        const drinkName = this.drink;
+        const label = drinkName ? `Favorite ${drinkName}` : 'Favorite';
+
+        if (isFav) {
+          this.setAttribute('favorited', '');
+          this.setAttribute('active', '');
+          this.setAttribute('checked', '');
+        } else {
+          this.removeAttribute('favorited');
+          this.removeAttribute('active');
+          this.removeAttribute('checked');
+        }
+        this.setAttribute('aria-pressed', String(isFav));
+        this.dataset.favorited = String(isFav);
+
+        if (this._button) {
+          this._button.classList.toggle('active', isFav);
+          this._button.classList.toggle('favorited', isFav);
+          this._button.setAttribute('aria-pressed', String(isFav));
+          this._button.setAttribute('aria-label', label);
+          this._button.setAttribute('title', isFav ? `Remove ${drinkName || 'drink'} from favorites` : `Mark ${drinkName || 'drink'} as favorite`);
+        }
+        this._updating = false;
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
