+  <script>
+    /**
+     * Runs an element-scoped view transition on a single component/subtree (`element.startViewTransition`)
+     * so the rest of the page stays interactive and other component transitions can run concurrently.
+     * Falls back to immediate execution if `element.startViewTransition` is unavailable.
+     */
+    function runScopedTransition(scopeElement, updateCallback) {
+      if (scopeElement && typeof scopeElement.startViewTransition === 'function') {
+        return scopeElement.startViewTransition(updateCallback);
+      }
+      updateCallback();
+      return null;
+    }
+
+    const coffeeGrid = document.getElementById('coffee-grid');
+    const orderPanel = document.getElementById('order-panel');
+    const orderList = document.getElementById('order-list');
+    const cartCount = document.getElementById('cart-count');
+    const orderTotal = document.getElementById('order-total');
+
+    function updateOrderSummary() {
+      const items = orderList.querySelectorAll('.order-item');
+      const count = items.length;
+      cartCount.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+      let total = 0;
+      items.forEach((item) => {
+        total += parseFloat(item.dataset.price || '0');
+      });
+      orderTotal.textContent = `$${total.toFixed(2)}`;
+    }
+
+    // 1. Card-scoped state transitions: toggling details or changing cup size inside a single `.card`
+    coffeeGrid.addEventListener('click', (event) => {
+      const toggleBtn = event.target.closest('.toggle-details-btn');
+      if (toggleBtn) {
+        const card = toggleBtn.closest('.card');
+        const details = card.querySelector('.card-details');
+        runScopedTransition(card, () => {
+          const isHidden = details.hasAttribute('hidden');
+          if (isHidden) {
+            details.removeAttribute('hidden');
+            toggleBtn.textContent = 'Hide Details';
+            toggleBtn.setAttribute('aria-expanded', 'true');
+          } else {
+            details.setAttribute('hidden', '');
+            toggleBtn.textContent = 'View Details';
+            toggleBtn.setAttribute('aria-expanded', 'false');
+          }
+        });
+        return;
+      }
+
+      const sizeBtn = event.target.closest('.size-btn');
+      if (sizeBtn) {
+        const card = sizeBtn.closest('.card');
+        const priceEl = card.querySelector('.card-price');
+        runScopedTransition(card, () => {
+          card.querySelectorAll('.size-btn').forEach((btn) => btn.classList.remove('active'));
+          sizeBtn.classList.add('active');
+          if (priceEl && sizeBtn.dataset.price) {
+            priceEl.textContent = `$${parseFloat(sizeBtn.dataset.price).toFixed(2)}`;
+          }
+        });
+        return;
+      }
+
+      // 2. Concurrent Order Panel transition triggered when adding an item from a card
+      const addBtn = event.target.closest('.add-order-btn');
+      if (addBtn) {
+        const card = addBtn.closest('.card');
+        const activeSizeBtn = card.querySelector('.size-btn.active');
+        const sizeLabel = activeSizeBtn ? activeSizeBtn.dataset.size : 'M';
+        const price = activeSizeBtn ? parseFloat(activeSizeBtn.dataset.price) : parseFloat(card.dataset.basePrice);
+        const itemName = card.dataset.name;
+
+        // Animate the button state locally inside the card while simultaneously animating the order panel
+        runScopedTransition(card, () => {
+          addBtn.textContent = 'Added!';
+        });
+        setTimeout(() => {
+          runScopedTransition(card, () => {
+            addBtn.textContent = '+ Add';
+          });
+        }, 700);
+
+        runScopedTransition(orderPanel, () => {
+          const li = document.createElement('li');
+          li.className = 'order-item';
+          li.dataset.price = price.toFixed(2);
+          li.innerHTML = `
+            <span>${itemName} (${sizeLabel})</span>
+            <span>
+              <strong>$${price.toFixed(2)}</strong>
+              <button type="button" class="order-item-remove" aria-label="Remove item">&times;</button>
+            </span>
+          `;
+          orderList.appendChild(li);
+          updateOrderSummary();
+        });
+      }
+    });
+
+    // 3. Grid-scoped state transitions: filtering or shuffling cards inside `#coffee-grid`
+    document.querySelector('.filter-controls').addEventListener('click', (event) => {
+      const btn = event.target.closest('.filter-btn');
+      if (!btn) return;
+
+      if (btn.id === 'shuffle-grid-btn') {
+        runScopedTransition(coffeeGrid, () => {
+          const cards = Array.from(coffeeGrid.children);
+          for (let i = cards.length - 1; i > 0; i--) {
+            const j = Math.floor(Math.random() * (i + 1));
+            coffeeGrid.appendChild(cards[j]);
+            cards.splice(j, 1);
+          }
+        });
+        return;
+      }
+
+      const filter = btn.dataset.filter;
+      if (!filter) return;
+
+      document.querySelectorAll('.filter-btn[data-filter]').forEach((b) => b.classList.remove('active'));
+      btn.classList.add('active');
+
+      runScopedTransition(coffeeGrid, () => {
+        coffeeGrid.querySelectorAll('.card').forEach((card) => {
+          const matches = filter === 'all' || card.dataset.category === filter;
+          if (matches) {
+            card.removeAttribute('hidden');
+          } else {
+            card.setAttribute('hidden', '');
+          }
+        });
+      });
+    });
+
+    // 4. Panel-scoped transition when removing an item from `#order-panel`
+    orderPanel.addEventListener('click', (event) => {
+      const removeBtn = event.target.closest('.order-item-remove');
+      if (!removeBtn) return;
+      const item = removeBtn.closest('.order-item');
+      if (!item) return;
+
+      runScopedTransition(orderPanel, () => {
+        item.remove();
+        updateOrderSummary();
+      });
+    });
+  </script>
 </body>
 
