+  <script>
+    // Feature detect element-scoped view transitions specifically on Element.prototype
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    const extraAddons = [
+      { name: 'Cinnamon Bark Dusting', meta: 'Freshly grated • +$0.35' },
+      { name: 'Toasted Hazelnut Drizzle', meta: 'House-made syrup • +$0.65' },
+      { name: 'Cardamom Infused Whip', meta: 'Spiced cream • +$0.85' },
+      { name: 'Cacao Nib Crunch', meta: 'Roasted topping • +$0.50' }
+    ];
+
+    let addonCounter = 100;
+
+    // Trigger a view transition scoped to a single component subtree
+    function runWithTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        // Fallback: apply the DOM update immediately without blocking the document
+        updateDOM();
+        return;
+      }
+
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      // Catch rejection if rapid interactions re-trigger startViewTransition() on the same element
+      transition.ready.catch(() => {});
+    }
+
+    function updateCardBadge(cardEl) {
+      const listEl = cardEl.querySelector('ul.item-list');
+      const badgeEl = cardEl.querySelector('.card-badge');
+      const count = listEl.querySelectorAll('li[data-id]').length;
+      if (badgeEl) {
+        badgeEl.textContent = `${count} ${count === 1 ? 'Customization' : 'Customizations'}`;
+      }
+    }
+
+    // Reorder items by moving existing DOM nodes (required for view-transition-name: match-element)
+    // Scoped to listEl since only the list order changes, keeping controls outside listEl interactive
+    function reorderItems(listEl, orderedIds) {
+      const existing = new Map(
+        Array.from(listEl.children, (li) => [li.dataset.id, li])
+      );
+
+      runWithTransition(listEl, () => {
+        for (const id of orderedIds) {
+          const li = existing.get(id);
+          if (li) listEl.appendChild(li);
+        }
+      });
+    }
+
+    // Move a single item up in the list while preserving DOM node identity
+    function moveItemUp(listEl, itemEl) {
+      const prevEl = itemEl.previousElementSibling;
+      if (!prevEl) return;
+
+      runWithTransition(listEl, () => {
+        listEl.insertBefore(itemEl, prevEl);
+      });
+    }
+
+    // Remove an item while preserving exit animation and keyboard focus
+    // Scoped to the outer cardEl so the card smoothly transitions its height change alongside children
+    function removeItem(cardEl, itemEl) {
+      const listEl = cardEl.querySelector('ul.item-list');
+      const hadFocus = itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl.nextElementSibling?.querySelector('button') ??
+        itemEl.previousElementSibling?.querySelector('button') ??
+        cardEl.querySelector('button');
+
+      runWithTransition(cardEl, () => {
+        itemEl.remove();
+        updateCardBadge(cardEl);
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    // Add a customization item scoped to the card subtree
+    function addItem(cardEl) {
+      const listEl = cardEl.querySelector('ul.item-list');
+      const index = Number(cardEl.dataset.nextAddIndex || 0) % extraAddons.length;
+      cardEl.dataset.nextAddIndex = String(index + 1);
+      const addon = extraAddons[index];
+      const newId = `addon-${++addonCounter}`;
+
+      const li = document.createElement('li');
+      li.dataset.id = newId;
+      li.innerHTML = `
+        <div class="item-info">
+          <span class="item-name">${addon.name}</span>
+          <span class="item-meta">${addon.meta}</span>
+        </div>
+        <div class="item-actions">
+          <button type="button" class="btn-icon" data-action="move-up" aria-label="Move ${addon.name} up">↑</button>
+          <button type="button" class="btn-icon" data-action="remove-item" aria-label="Remove ${addon.name}">✕</button>
+        </div>
+      `;
+
+      runWithTransition(cardEl, () => {
+        listEl.appendChild(li);
+        updateCardBadge(cardEl);
+      });
+    }
+
+    // Toggle expandable tasting notes scoped to the card subtree
+    function toggleDetails(cardEl, toggleBtn) {
+      const detailsEl = cardEl.querySelector('.card-details');
+      if (!detailsEl) return;
+
+      runWithTransition(cardEl, () => {
+        const isHidden = detailsEl.hasAttribute('hidden');
+        if (isHidden) {
+          detailsEl.removeAttribute('hidden');
+          toggleBtn.setAttribute('aria-expanded', 'true');
+          toggleBtn.textContent = 'Hide Details';
+        } else {
+          detailsEl.setAttribute('hidden', '');
+          toggleBtn.setAttribute('aria-expanded', 'false');
+          toggleBtn.textContent = 'View Details';
+        }
+      });
+    }
+
+    // Delegate interactions within the cards grid
+    const gridEl = document.getElementById('cards-grid');
+
+    gridEl.addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-action]');
+      if (!button) return;
+
+      const action = button.dataset.action;
+      const cardEl = button.closest('.card');
+      if (!cardEl) return;
+
+      const listEl = cardEl.querySelector('ul.item-list');
+
+      if (action === 'sort-list' && listEl) {
+        const reversedIds = Array.from(listEl.children)
+          .map((li) => li.dataset.id)
+          .filter(Boolean)
+          .reverse();
+        reorderItems(listEl, reversedIds);
+      } else if (action === 'add-item') {
+        addItem(cardEl);
+      } else if (action === 'toggle-details') {
+        toggleDetails(cardEl, button);
+      } else if (action === 'move-up' && listEl) {
+        const itemEl = button.closest('li');
+        if (itemEl) moveItemUp(listEl, itemEl);
+      } else if (action === 'remove-item') {
+        const itemEl = button.closest('li');
+        if (itemEl) removeItem(cardEl, itemEl);
+      }
+    });
+
+    // Trigger concurrent transitions across all cards simultaneously
+    document.getElementById('animate-all-concurrent').addEventListener('click', () => {
+      const cards = gridEl.querySelectorAll('.card');
+      cards.forEach((cardEl) => {
+        const listEl = cardEl.querySelector('ul.item-list');
+        const toggleBtn = cardEl.querySelector('button[data-action="toggle-details"]');
+        if (listEl) {
+          const reversedIds = Array.from(listEl.children)
+            .map((li) => li.dataset.id)
+            .filter(Boolean)
+            .reverse();
+          reorderItems(listEl, reversedIds);
+        }
+        if (toggleBtn) {
+          toggleDetails(cardEl, toggleBtn);
+        }
+      });
+    });
+
+    // Trigger an outer transition on the grid container while inner card scopes remain isolated
+    document.getElementById('reorder-cards-btn').addEventListener('click', () => {
+      const wrappers = Array.from(gridEl.querySelectorAll('.card-wrapper'));
+      if (wrappers.length < 2) return;
+
+      runWithTransition(gridEl, () => {
+        const first = wrappers[0];
+        gridEl.appendChild(first);
+      });
+    });
+  </script>
 </body>
 
