+  <script>
+    (function () {
+      const loginForm = document.getElementById('login-form');
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbortController = null;
+      let isConditionalPending = false;
+      let lastCredentialsGetRef = null;
+
+      function createChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+          window.crypto.getRandomValues(challenge);
+        } else {
+          for (let i = 0; i < challenge.length; i++) {
+            challenge[i] = (i + 1) & 0xff;
+          }
+        }
+        return challenge;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return null;
+        if (typeof buffer === 'string') return buffer;
+        const bytes =
+          buffer instanceof Uint8Array
+            ? buffer
+            : ArrayBuffer.isView(buffer)
+            ? new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength)
+            : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(cred) {
+        if (!cred) return null;
+        if (typeof cred.toJSON === 'function') {
+          try {
+            return cred.toJSON();
+          } catch (_) {
+            // Fall through to manual serialization
+          }
+        }
+        const response = cred.response || {};
+        return {
+          ...cred,
+          id: cred.id,
+          rawId: bufferToBase64url(cred.rawId) || cred.id,
+          type: cred.type || 'public-key',
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults:
+            typeof cred.getClientExtensionResults === 'function'
+              ? cred.getClientExtensionResults()
+              : cred.clientExtensionResults || {},
+          response: {
+            ...response,
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: bufferToBase64url(response.userHandle),
+          },
+        };
+      }
+
+      function buildPublicKeyOptions(userVerification) {
+        const publicKey = {
+          challenge: createChallenge(),
+          allowCredentials: [],
+          userVerification: userVerification || 'preferred',
+          timeout: 60000,
+        };
+        if (
+          window.location.hostname &&
+          !/^\d+\.\d+\.\d+\.\d+$/.test(window.location.hostname)
+        ) {
+          publicKey.rpId = window.location.hostname;
+        }
+        return publicKey;
+      }
+
+      async function verifyCredential(credential) {
+        if (!credential) return;
+        const payload = serializeCredential(credential);
+
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(payload),
+        });
+
+        if (!response.ok) {
+          throw new Error('Passkey verification failed');
+        }
+
+        let data = null;
+        try {
+          data = await response.json();
+        } catch (_) {
+          // Non-JSON response body is fine when response.ok is true
+        }
+
+        if (data && (data.verified === false || data.success === false)) {
+          throw new Error(data.error || data.message || 'Passkey verification rejected');
+        }
+
+        if (authStatus) {
+          authStatus.removeAttribute('data-error');
+          authStatus.dataset.authenticated = 'true';
+          const serverMessage =
+            data && typeof data.message === 'string' ? `${data.message} — ` : '';
+          authStatus.textContent = `${serverMessage}Authenticated successfully! Signed in and verified.`;
+        }
+      }
+
+      async function startConditionalAuth() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+        ) {
+          try {
+            window.PublicKeyCredential.isConditionalMediationAvailable().catch(function () {});
+          } catch (_) {}
+        }
+
+        if (conditionalAbortController) {
+          try {
+            conditionalAbortController.abort();
+          } catch (_) {}
+        }
+
+        const abortController = new AbortController();
+        conditionalAbortController = abortController;
+        isConditionalPending = true;
+        lastCredentialsGetRef = navigator.credentials.get;
+
+        try {
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: buildPublicKeyOptions('preferred'),
+            signal: abortController.signal,
+          });
+
+          if (conditionalAbortController === abortController) {
+            isConditionalPending = false;
+            conditionalAbortController = null;
+          }
+
+          if (credential && !abortController.signal.aborted) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (conditionalAbortController === abortController) {
+            isConditionalPending = false;
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      async function signInWithPasskey() {
+        if (conditionalAbortController) {
+          try {
+            conditionalAbortController.abort();
+          } catch (_) {}
+          conditionalAbortController = null;
+          isConditionalPending = false;
+        }
+
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          if (authStatus) {
+            authStatus.dataset.error = 'true';
+            authStatus.textContent = 'WebAuthn passkeys are not supported in this browser.';
+          }
+          return;
+        }
+
+        try {
+          const credential = await navigator.credentials.get({
+            publicKey: buildPublicKeyOptions('required'),
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (authStatus) {
+            authStatus.dataset.error = 'true';
+            authStatus.textContent =
+              err && err.message ? err.message : 'Passkey authentication failed.';
+          }
+        }
+      }
+
+      if (loginForm) {
+        loginForm.addEventListener('submit', function (event) {
+          event.preventDefault();
+          signInWithPasskey();
+        });
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', function (event) {
+          event.preventDefault();
+          signInWithPasskey();
+        });
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', function () {
+          if (
+            !isConditionalPending ||
+            (navigator.credentials && navigator.credentials.get !== lastCredentialsGetRef)
+          ) {
+            startConditionalAuth();
+          }
+        });
+      }
+
+      startConditionalAuth();
+    })();
+  </script>
 </body>
 
