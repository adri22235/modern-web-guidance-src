+  <script>
+    function updateMapleOatCountdown() {
+      const remainingEl = document.getElementById('offer-remaining');
+      const elapsedEl = document.getElementById('offer-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      const promoStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone,
+      });
+
+      const promoEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone,
+      });
+
+      const remainingDuration = now.until(promoEnd, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+      });
+
+      const elapsedDuration = now.since(promoStart, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+      });
+
+      remainingEl.textContent = `Offer ends in: ${remainingDuration.days} days, ${remainingDuration.hours} hours`;
+      elapsedEl.textContent = `Time elapsed since promo start: ${elapsedDuration.days} days, ${elapsedDuration.hours} hours`;
+    }
+
+    window.addEventListener('DOMContentLoaded', updateMapleOatCountdown);
+  </script>
+
