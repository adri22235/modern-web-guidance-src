+  <script>
+    function updateMaplePromoTimer() {
+      const tz = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(tz);
+
+      const startDateStr = '2026-01-15';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr)
+        .toPlainDateTime(startTimeStr)
+        .toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr)
+        .toPlainDateTime(endTimeStr)
+        .toZonedDateTime(tz);
+
+      const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      const remainingEl = document.getElementById('maple-time-remaining');
+      const elapsedEl = document.getElementById('maple-time-elapsed');
+      const statusEl = document.getElementById('maple-promo-status');
+
+      if (remainingEl) {
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+        remainingEl.textContent = timeRemaining.toLocaleString('en-US', { style: 'long' });
+      }
+
+      if (elapsedEl) {
+        elapsedEl.setAttribute('datetime', timeActive.toString());
+        elapsedEl.textContent = timeActive.toLocaleString('en-US', { style: 'long' });
+      }
+
+      const isExpired = timeRemaining.sign < 0;
+      const isPastHalfway =
+        Temporal.Duration.compare(timeActive, timeRemaining, { relativeTo: now }) > 0;
+
+      if (statusEl) {
+        if (isExpired) {
+          statusEl.textContent = 'Offer ended March 1, 2026 at midnight';
+        } else if (isPastHalfway) {
+          statusEl.textContent = 'Hurry — promotion is past halfway!';
+        } else {
+          statusEl.textContent = 'Seasonal promotion active until March 1, 2026 at midnight';
+        }
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      updateMaplePromoTimer();
+    })();
+  </script>
+
