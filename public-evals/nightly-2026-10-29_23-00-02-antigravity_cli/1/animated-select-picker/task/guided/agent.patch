+    /* Store Picker Select (Hero) */
+    .store-picker {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      gap: 0.4rem;
+      width: 100%;
+      max-width: 320px;
+      margin-top: 1.25rem;
+      text-align: left;
+    }
+
+    .store-picker label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      color: var(--light);
+      letter-spacing: 0.02em;
+    }
+
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 0.75rem 1rem;
+      font-family: inherit;
+      font-size: 0.95rem;
+      background-color: var(--light);
+      color: var(--text);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    .store-select:hover,
+    .store-select:focus-visible {
+      border-color: var(--accent);
+      outline: none;
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.35);
+    }
+
+    .store-select button {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .store-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    .store-select::picker(select) {
+      background-color: var(--light);
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.25);
+      padding: 0.5rem;
+      margin-top: 0.35rem;
+      width: anchor-size(width);
+      overflow: hidden;
+
+      transition:
+        display 0.35s allow-discrete,
+        overlay 0.35s allow-discrete,
+        opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
+        height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
+      opacity: 0;
+      height: 0;
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      height: auto;
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        height: 0;
+      }
+    }
+
+    .store-select option {
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+      padding: 0.55rem 0.75rem;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .store-select option:hover {
+      background-color: #efebe9;
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+      background-color: var(--secondary);
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    .store-select option svg,
+    .store-select selectedcontent svg {
+      flex-shrink: 0;
+      width: 1.1rem;
+      height: 1.1rem;
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none !important;
+      }
+    }
+
