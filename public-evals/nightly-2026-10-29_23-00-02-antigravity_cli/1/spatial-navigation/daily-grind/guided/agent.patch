+  <script>
+    (() => {
+      const FOCUSABLE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled)',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[tabindex]:not([tabindex="-1"])',
+        '[data-spatial-item]'
+      ].join(', ');
+
+      const DIRECTION_MAP = {
+        ArrowUp: 'up',
+        ArrowDown: 'down',
+        ArrowLeft: 'left',
+        ArrowRight: 'right'
+      };
+
+      const TOLERANCE = 2; // Sub-pixel rounding tolerance in px
+      const FALLBACK_WEIGHT = 3; // Weight w >= 2 for perpendicular centre offset in non-overlapping fallback
+
+      function getVisibleCandidates(container) {
+        const allItems = Array.from(
+          container.querySelectorAll(
+            'a[href], button:not(:disabled), input:not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex], [data-spatial-item]'
+          )
+        );
+        return allItems.filter((el) => {
+          if (el.hasAttribute('disabled') || el.getAttribute('aria-hidden') === 'true') {
+            return false;
+          }
+          if (typeof el.checkVisibility === 'function' && !el.checkVisibility()) {
+            return false;
+          }
+          return true;
+        });
+      }
+
+      function initRovingTabindex(container) {
+        const candidates = getVisibleCandidates(container);
+        if (candidates.length === 0) return;
+
+        let activeItem = candidates.find((el) => el.getAttribute('tabindex') === '0') || candidates[0];
+        candidates.forEach((el) => {
+          el.setAttribute('tabindex', el === activeItem ? '0' : '-1');
+        });
+
+        container.addEventListener('focusin', (e) => {
+          const target = e.composedPath()[0];
+          const currentCandidates = getVisibleCandidates(container);
+          if (target instanceof HTMLElement && currentCandidates.includes(target)) {
+            setActiveCandidate(container, target);
+          }
+        });
+      }
+
+      function setActiveCandidate(container, target) {
+        const candidates = getVisibleCandidates(container);
+        candidates.forEach((el) => {
+          el.setAttribute('tabindex', el === target ? '0' : '-1');
+        });
+      }
+
+      function findBestCandidate(current, candidates, direction) {
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = currentRect.left + currentRect.width / 2;
+        const currentCenterY = currentRect.top + currentRect.height / 2;
+
+        const isHorizontal = direction === 'left' || direction === 'right';
+
+        const alignedCandidates = [];
+        const fallbackCandidates = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+
+          const rect = candidate.getBoundingClientRect();
+          if (rect.width === 0 && rect.height === 0) continue;
+
+          // Edge-based direction filter with sub-pixel tolerance
+          let inDirection = false;
+          let gap = 0;
+
+          if (direction === 'right') {
+            if (rect.left >= currentRect.right - TOLERANCE) {
+              inDirection = true;
+              gap = Math.max(0, rect.left - currentRect.right);
+            }
+          } else if (direction === 'left') {
+            if (rect.right <= currentRect.left + TOLERANCE) {
+              inDirection = true;
+              gap = Math.max(0, currentRect.left - rect.right);
+            }
+          } else if (direction === 'down') {
+            if (rect.top >= currentRect.bottom - TOLERANCE) {
+              inDirection = true;
+              gap = Math.max(0, rect.top - currentRect.bottom);
+            }
+          } else if (direction === 'up') {
+            if (rect.bottom <= currentRect.top + TOLERANCE) {
+              inDirection = true;
+              gap = Math.max(0, currentRect.top - rect.bottom);
+            }
+          }
+
+          if (!inDirection) continue;
+
+          const candidateCenterX = rect.left + rect.width / 2;
+          const candidateCenterY = rect.top + rect.height / 2;
+
+          // Perpendicular axis overlap and center offset
+          let overlapsPerpendicular = false;
+          let perpendicularCenterOffset = 0;
+
+          if (isHorizontal) {
+            const overlapTop = Math.max(currentRect.top, rect.top);
+            const overlapBottom = Math.min(currentRect.bottom, rect.bottom);
+            overlapsPerpendicular = overlapBottom > overlapTop;
+            perpendicularCenterOffset = Math.abs(candidateCenterY - currentCenterY);
+          } else {
+            const overlapLeft = Math.max(currentRect.left, rect.left);
+            const overlapRight = Math.min(currentRect.right, rect.right);
+            overlapsPerpendicular = overlapRight > overlapLeft;
+            perpendicularCenterOffset = Math.abs(candidateCenterX - currentCenterX);
+          }
+
+          if (overlapsPerpendicular) {
+            alignedCandidates.push({
+              element: candidate,
+              gap,
+              perpendicularCenterOffset
+            });
+          } else {
+            fallbackCandidates.push({
+              element: candidate,
+              score: gap + FALLBACK_WEIGHT * perpendicularCenterOffset
+            });
+          }
+        }
+
+        // Prefer aligned candidates first: smallest gap on navigation axis, tie-break with smallest perpendicular center offset
+        if (alignedCandidates.length > 0) {
+          alignedCandidates.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCenterOffset - b.perpendicularCenterOffset;
+          });
+          return alignedCandidates[0].element;
+        }
+
+        // Fallback scoring: gap + w * perpendicularCentreOffset
+        if (fallbackCandidates.length > 0) {
+          fallbackCandidates.sort((a, b) => a.score - b.score);
+          return fallbackCandidates[0].element;
+        }
+
+        return null;
+      }
+
+      function setupSpatialNavigation(container) {
+        initRovingTabindex(container);
+
+        container.addEventListener('keydown', (e) => {
+          const direction = DIRECTION_MAP[e.key];
+          if (!direction) return;
+
+          // Do not intercept when a modifier key is held or event is already prevented
+          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) {
+            return;
+          }
+
+          // Inspect innermost target via composedPath()[0]
+          const target = e.composedPath()[0];
+          if (!(target instanceof HTMLElement)) return;
+
+          // Do not intercept when the innermost event target consumes arrow keys itself
+          if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) {
+            return;
+          }
+
+          // Act only when the focused element is itself a candidate
+          const candidates = getVisibleCandidates(container);
+          if (!candidates.includes(target)) {
+            return;
+          }
+
+          const nextCandidate = findBestCandidate(target, candidates, direction);
+          if (!nextCandidate) {
+            // Preserve native boundary scrolling when no candidate exists in the pressed direction
+            return;
+          }
+
+          e.preventDefault();
+          setActiveCandidate(container, nextCandidate);
+          nextCandidate.focus();
+          nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+      }
+
+      document.querySelectorAll('.grid, [data-spatial-nav]').forEach(setupSpatialNavigation);
+    })();
+  </script>
