+  <script>
+    (function () {
+      const grid = document.querySelector('.grid');
+      const statusEl = document.getElementById('grid-status');
+      const layoutButtons = document.querySelectorAll('[data-layout-mode]');
+
+      if (!grid) return;
+
+      function getCards() {
+        return Array.from(grid.querySelectorAll('.card')).filter(
+          (card) => !card.hidden && getComputedStyle(card).display !== 'none'
+        );
+      }
+
+      /**
+       * Groups cards into visual 2D rows using their actual bounding rectangles,
+       * falling back to layout mode column counts if layout geometry is unavailable.
+       */
+      function buildSpatialRows(cards) {
+        if (cards.length === 0) return [];
+
+        const items = cards.map((card, index) => {
+          const rect = card.getBoundingClientRect();
+          return {
+            card,
+            index,
+            rect,
+            centerX: rect.left + rect.width / 2,
+            centerY: rect.top + rect.height / 2
+          };
+        });
+
+        const hasGeometry = items.some((item) => item.rect.width > 0 || item.rect.height > 0);
+
+        if (!hasGeometry) {
+          const mode = grid.getAttribute('data-layout') || 'grid';
+          const fallbackCols =
+            mode === 'list' ? 1 : mode === 'two-column' ? 2 : mode === 'compact' ? 4 : 3;
+          const rows = [];
+          for (let i = 0; i < items.length; i += fallbackCols) {
+            rows.push(items.slice(i, i + fallbackCols));
+          }
+          return rows;
+        }
+
+        const rows = [];
+        for (const item of items) {
+          const matchingRow = rows.find((row) => {
+            const ref = row[0];
+            const tolerance = Math.max(12, Math.min(ref.rect.height, item.rect.height) * 0.45);
+            return Math.abs(item.rect.top - ref.rect.top) <= tolerance;
+          });
+
+          if (matchingRow) {
+            matchingRow.push(item);
+          } else {
+            rows.push([item]);
+          }
+        }
+
+        rows.sort((a, b) => a[0].rect.top - b[0].rect.top);
+        rows.forEach((row) => row.sort((a, b) => a.rect.left - b.rect.left));
+        return rows;
+      }
+
+      function syncGridMetadata() {
+        const cards = getCards();
+        if (cards.length === 0) return;
+
+        const rows = buildSpatialRows(cards);
+        let hasActiveTabStop = cards.some((card) => card.getAttribute('tabindex') === '0');
+
+        rows.forEach((row, rIdx) => {
+          row.forEach((item, cIdx) => {
+            item.card.dataset.row = String(rIdx);
+            item.card.dataset.col = String(cIdx);
+            item.card.setAttribute('aria-posinset', String(item.index + 1));
+            item.card.setAttribute('aria-setsize', String(cards.length));
+            if (!hasActiveTabStop && rIdx === 0 && cIdx === 0) {
+              item.card.setAttribute('tabindex', '0');
+              hasActiveTabStop = true;
+            } else if (item.card.getAttribute('tabindex') !== '0') {
+              item.card.setAttribute('tabindex', '-1');
+            }
+          });
+        });
+      }
+
+      function setActiveCard(targetCard, shouldFocus = true) {
+        const cards = getCards();
+        cards.forEach((card) => {
+          card.setAttribute('tabindex', card === targetCard ? '0' : '-1');
+        });
+        if (shouldFocus) {
+          targetCard.focus();
+        }
+      }
+
+      function findBestVerticalMatch(currentItem, targetRow, currentColIndex) {
+        if (!targetRow || targetRow.length === 0) return null;
+
+        const hasGeometry =
+          currentItem.rect.width > 0 ||
+          targetRow.some((candidate) => candidate.rect.width > 0);
+
+        if (!hasGeometry) {
+          return targetRow[Math.min(currentColIndex, targetRow.length - 1)].card;
+        }
+
+        let bestCandidate = targetRow[0];
+        let bestScore = Infinity;
+
+        for (const candidate of targetRow) {
+          const horizontalDist = Math.abs(candidate.centerX - currentItem.centerX);
+          const overlap = Math.max(
+            0,
+            Math.min(currentItem.rect.right, candidate.rect.right) -
+              Math.max(currentItem.rect.left, candidate.rect.left)
+          );
+          const score = horizontalDist - overlap * 0.25;
+          if (score < bestScore) {
+            bestScore = score;
+            bestCandidate = candidate;
+          }
+        }
+
+        return bestCandidate.card;
+      }
+
+      grid.addEventListener('focusin', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          setActiveCard(card, false);
+        }
+      });
+
+      grid.addEventListener('click', (event) => {
+        const card = event.target.closest('.card');
+        if (!card || !grid.contains(card)) return;
+        setActiveCard(card, false);
+      });
+
+      grid.addEventListener('keydown', (event) => {
+        const currentCard = event.target.closest('.card');
+        if (!currentCard || !grid.contains(currentCard)) return;
+
+        if ((event.key === 'Enter' || event.key === ' ') && event.target === currentCard) {
+          const primaryLink = currentCard.querySelector('a.btn, a, button');
+          if (primaryLink) {
+            event.preventDefault();
+            primaryLink.click();
+          }
+          return;
+        }
+
+        const navKeys = ['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'];
+        if (!navKeys.includes(event.key)) return;
+
+        const cards = getCards();
+        const rows = buildSpatialRows(cards);
+        if (rows.length === 0) return;
+
+        let currentRowIdx = -1;
+        let currentColIdx = -1;
+        let currentItem = null;
+
+        for (let r = 0; r < rows.length; r++) {
+          const c = rows[r].findIndex((item) => item.card === currentCard);
+          if (c !== -1) {
+            currentRowIdx = r;
+            currentColIdx = c;
+            currentItem = rows[r][c];
+            break;
+          }
+        }
+
+        if (!currentItem) return;
+
+        let targetCard = null;
+
+        switch (event.key) {
+          case 'ArrowRight': {
+            if (currentColIdx + 1 < rows[currentRowIdx].length) {
+              targetCard = rows[currentRowIdx][currentColIdx + 1].card;
+            }
+            break;
+          }
+          case 'ArrowLeft': {
+            if (currentColIdx - 1 >= 0) {
+              targetCard = rows[currentRowIdx][currentColIdx - 1].card;
+            }
+            break;
+          }
+          case 'ArrowDown': {
+            if (currentRowIdx + 1 < rows.length) {
+              targetCard = findBestVerticalMatch(
+                currentItem,
+                rows[currentRowIdx + 1],
+                currentColIdx
+              );
+            }
+            break;
+          }
+          case 'ArrowUp': {
+            if (currentRowIdx - 1 >= 0) {
+              targetCard = findBestVerticalMatch(
+                currentItem,
+                rows[currentRowIdx - 1],
+                currentColIdx
+              );
+            }
+            break;
+          }
+          case 'Home': {
+            if (event.ctrlKey || rows[currentRowIdx].length === 1) {
+              targetCard = rows[0][0].card;
+            } else {
+              targetCard = rows[currentRowIdx][0].card;
+            }
+            break;
+          }
+          case 'End': {
+            const lastRow = rows[rows.length - 1];
+            if (event.ctrlKey || rows[currentRowIdx].length === 1) {
+              targetCard = lastRow[lastRow.length - 1].card;
+            } else {
+              const currentRow = rows[currentRowIdx];
+              targetCard = currentRow[currentRow.length - 1].card;
+            }
+            break;
+          }
+        }
+
+        event.preventDefault();
+        if (targetCard && targetCard !== currentCard) {
+          setActiveCard(targetCard, true);
+        }
+      });
+
+      function setLayoutMode(mode) {
+        grid.setAttribute('data-layout', mode);
+        layoutButtons.forEach((btn) => {
+          const isCurrent = btn.getAttribute('data-layout-mode') === mode;
+          btn.setAttribute('aria-pressed', String(isCurrent));
+        });
+        syncGridMetadata();
+        if (statusEl) {
+          const rows = buildSpatialRows(getCards());
+          const colCount = rows[0] ? rows[0].length : 0;
+          statusEl.textContent = `Layout changed to ${mode} view (${colCount} ${
+            colCount === 1 ? 'column' : 'columns'
+          }).`;
+        }
+      }
+
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          if (mode) setLayoutMode(mode);
+        });
+      });
+
+      window.addEventListener('resize', syncGridMetadata);
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(() => syncGridMetadata());
+        ro.observe(grid);
+      }
+
+      syncGridMetadata();
+    })();
+  </script>
 </body>
 
