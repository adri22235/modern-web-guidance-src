+import http from 'node:http';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  RP_ORIGIN,
+  ORIGIN_TRIAL_TOKEN,
+  createSessionNonce,
+  consumeSessionNonce,
+  parseSessionId,
+  verifyEmailVerificationToken,
+  completeAccountCreation,
+  sendTraditionalVerificationEmail,
+  handleSignupSubmission,
+} from './verify-email.js';
+
+export {
+  RP_ORIGIN,
+  ORIGIN_TRIAL_TOKEN,
+  createSessionNonce,
+  consumeSessionNonce,
+  parseSessionId,
+  verifyEmailVerificationToken,
+  completeAccountCreation,
+  sendTraditionalVerificationEmail,
+  handleSignupSubmission,
+};
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+const INDEX_HTML_PATH = path.join(__dirname, 'index.html');
+
+function escapeHtml(str) {
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+async function readRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+function parseSubmittedFields(body, contentType = '') {
+  if (contentType.includes('application/json')) {
+    try {
+      return JSON.parse(body);
+    } catch {
+      return {};
+    }
+  }
+  const params = new URLSearchParams(body);
+  return {
+    name: params.get('name') || '',
+    email: params.get('email') || '',
+    password: params.get('password') || '',
+    token: params.get('token') || '',
+  };
+}
+
+export const server = http.createServer(async (req, res) => {
+  try {
+    const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+
+    // Serve Homepage with freshly generated per-render cryptographic nonce
+    if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+      const existingSessionId = parseSessionId(req.headers.cookie || '');
+      const { sessionId, nonce } = createSessionNonce(existingSessionId);
+
+      const rawHtml = await fs.readFile(INDEX_HTML_PATH, 'utf8');
+      const renderedHtml = rawHtml.replace(
+        /nonce="SERVER_GENERATED_PER_FORM_NONCE"/g,
+        `nonce="${escapeHtml(nonce)}"`
+      );
+
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Origin-Trial': ORIGIN_TRIAL_TOKEN,
+        'Set-Cookie': `dg_session=${encodeURIComponent(sessionId)}; Path=/; HttpOnly; Secure; SameSite=Lax`,
+      });
+      res.end(renderedHtml);
+      return;
+    }
+
+    // Endpoint to issue a fresh nonce for client-side progressive enhancement if needed
+    if (req.method === 'GET' && url.pathname === '/api/verify-email/nonce') {
+      const existingSessionId = parseSessionId(req.headers.cookie || '');
+      const { sessionId, nonce } = createSessionNonce(existingSessionId);
+
+      res.writeHead(200, {
+        'Content-Type': 'application/json; charset=utf-8',
+        'Cache-Control': 'no-store',
+        'Origin-Trial': ORIGIN_TRIAL_TOKEN,
+        'Set-Cookie': `dg_session=${encodeURIComponent(sessionId)}; Path=/; HttpOnly; Secure; SameSite=Lax`,
+      });
+      res.end(JSON.stringify({ nonce }));
+      return;
+    }
+
+    // Server Verification Endpoint for Rewards Account Sign-Up
+    if (
+      req.method === 'POST' &&
+      (url.pathname === '/api/verify-email' || url.pathname === '/api/rewards/signup')
+    ) {
+      const body = await readRequestBody(req);
+      const fields = parseSubmittedFields(body, req.headers['content-type'] || '');
+      const submittedEmail = String(fields.email || '').trim();
+      const submittedName = String(fields.name || '').trim();
+      const rawToken = String(fields.token || '').trim();
+      const sessionId = parseSessionId(req.headers.cookie || '');
+
+      if (!submittedEmail || !submittedEmail.includes('@')) {
+        res.writeHead(400, {
+          'Content-Type': 'application/json; charset=utf-8',
+          'Cache-Control': 'no-store',
+        });
+        res.end(
+          JSON.stringify({
+            status: 'error',
+            message: 'Please provide a valid email address.',
+          })
+        );
+        return;
+      }
+
+      const result = await handleSignupSubmission({
+        submittedName,
+        submittedEmail,
+        rawToken,
+        sessionId,
+        expectedAudience: RP_ORIGIN,
+      });
+
+      const accept = req.headers.accept || '';
+      if (accept.includes('application/json')) {
+        res.writeHead(200, {
+          'Content-Type': 'application/json; charset=utf-8',
+          'Cache-Control': 'no-store',
+        });
+        res.end(JSON.stringify(result));
+        return;
+      }
+
+      // Standard HTML form response fallback when submitted without fetch
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+      });
+      res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Rewards Registration | The Daily Grind</title>
+</head>
+<body style="font-family: system-ui, sans-serif; padding: 2rem; max-width: 600px; margin: 0 auto; color: #3e2723;">
+  <h1>${result.emailVerified ? 'Account Verified Instantly!' : 'Check Your Email'}</h1>
+  <p>${escapeHtml(result.message)}</p>
+  <p><a href="/" style="color: #4e342e; font-weight: 600;">Return to The Daily Grind homepage</a></p>
+</body>
+</html>`);
+      return;
+    }
+
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not Found');
+  } catch (err) {
+    console.error('Server error:', err);
+    res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify({ status: 'error', message: 'Internal server error' }));
+  }
+});
+
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const port = Number(process.env.PORT) || 11222;
+  server.listen(port, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${port}`);
+  });
+}
