index 0000000..d76c2e3
--- /dev/null
+++ b/verify-email.js
@@ -0,0 +1,301 @@
+import { createHash, randomBytes } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// Public relying-party origin for The Daily Grind
+export const RP_ORIGIN = process.env.RP_ORIGIN || 'https://dailygrind.example.com';
+
+// Origin Trial token for the Email Verification API
+export const ORIGIN_TRIAL_TOKEN =
+  process.env.ORIGIN_TRIAL_TOKEN ||
+  'A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6A7b8C9d0E1f2G3h4I5j6K7l8M9n0';
+
+// Server-side session store mapping session IDs to single-use nonces
+const sessionNonceStore = new Map();
+
+// In-memory store of registered rewards accounts
+const rewardsAccounts = new Map();
+
+/**
+ * Generates a cryptographically random single-use nonce (256 bits of entropy)
+ * and stores it in server-side session state keyed by the session ID.
+ */
+export function createSessionNonce(sessionId) {
+  const sid = sessionId || randomBytes(24).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  sessionNonceStore.set(sid, {
+    nonce,
+    createdAt: Date.now(),
+  });
+  return { sessionId: sid, nonce };
+}
+
+/**
+ * Extracts the `dg_session` cookie value from a Cookie header string or Web Request.
+ */
+export function parseSessionId(requestOrCookieHeader) {
+  let cookieHeader = '';
+  if (typeof requestOrCookieHeader === 'string') {
+    cookieHeader = requestOrCookieHeader;
+  } else if (requestOrCookieHeader?.headers) {
+    cookieHeader =
+      typeof requestOrCookieHeader.headers.get === 'function'
+        ? requestOrCookieHeader.headers.get('cookie') || ''
+        : requestOrCookieHeader.headers.cookie || '';
+  }
+  const match = cookieHeader.match(/(?:^|;\s*)dg_session=([^;]+)/);
+  return match ? decodeURIComponent(match[1].trim()) : '';
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce from server-side session state.
+ */
+export async function consumeSessionNonce(sessionIdOrRequest) {
+  const sessionId =
+    typeof sessionIdOrRequest === 'string'
+      ? sessionIdOrRequest
+      : parseSessionId(sessionIdOrRequest);
+  if (!sessionId || !sessionNonceStore.has(sessionId)) {
+    return null;
+  }
+  const entry = sessionNonceStore.get(sessionId);
+  sessionNonceStore.delete(sessionId);
+
+  // Expire nonces older than 5 minutes
+  if (Date.now() - entry.createdAt > 5 * 60 * 1000) {
+    return null;
+  }
+  return entry.nonce;
+}
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// Include 'EdDSA' while Origin Trial implementations transition from 'EdDSA' to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+/**
+ * Verifies an Email Verification Token (EVT + KB-JWT) presentation according to
+ * the Email Verification Protocol (EVP).
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience = RP_ORIGIN,
+}) {
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload?.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email address domain.');
+  }
+
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) =>
+    r.join('')
+  );
+  if (
+    !txtRecords.some(
+      (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss
+    )
+  ) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+
+  const metadataResponse = await fetch(discoveryUrl);
+  if (!metadataResponse.ok) {
+    throw new Error(`Failed to fetch issuer metadata from ${discoveryUrl}.`);
+  }
+  const metadata = await metadataResponse.json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+
+  const issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws ERR_JWKS_MULTIPLE_MATCHING_KEYS, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
+
+/**
+ * Completes account creation immediately when email ownership is cryptographically verified.
+ * Note: EVP proves ownership of the account with the issuer, not inbox deliverability,
+ * so a standard transactional welcome email is still queued.
+ */
+export function completeAccountCreation(submittedEmail, name = '') {
+  const accountId = randomBytes(16).toString('hex');
+  const account = {
+    id: accountId,
+    name,
+    email: submittedEmail,
+    emailVerified: true,
+    verificationMethod: 'email-verification-protocol',
+    pointsBalance: 100, // Welcome bonus points
+    welcomeEmailQueued: true,
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(submittedEmail.toLowerCase(), account);
+  return {
+    status: 'verified',
+    emailVerified: true,
+    verificationMethod: 'email-verification-protocol',
+    message: `Welcome to Daily Grind Rewards! Your email (${submittedEmail}) was verified instantly without needing a passcode email. 100 bonus points have been added to your account.`,
+    account,
+  };
+}
+
+/**
+ * Fallback flow: creates a pending account and sends a traditional OTP or magic link email
+ * when browser-assisted verification is unavailable or fails.
+ */
+export function sendTraditionalVerificationEmail(submittedEmail, name = '') {
+  const accountId = randomBytes(16).toString('hex');
+  const account = {
+    id: accountId,
+    name,
+    email: submittedEmail,
+    emailVerified: false,
+    verificationMethod: 'email-fallback',
+    pointsBalance: 0,
+    createdAt: new Date().toISOString(),
+  };
+  rewardsAccounts.set(submittedEmail.toLowerCase(), account);
+  return {
+    status: 'pending_verification',
+    emailVerified: false,
+    verificationMethod: 'email-fallback',
+    message: `Almost there! We've sent a verification link to ${submittedEmail} to finish activating your Daily Grind Rewards account.`,
+    account,
+  };
+}
+
+/**
+ * Handles rewards sign-up form submission using a Web Fetch API Request or parsed form fields.
+ */
+export async function handleSignupSubmission(input = {}) {
+  let submittedEmail = '';
+  let submittedName = '';
+  let rawToken = '';
+  let expectedNonce = null;
+  let expectedAudience = RP_ORIGIN;
+
+  if (typeof input?.formData === 'function') {
+    const formData = await input.formData();
+    submittedEmail = String(formData.get('email') || '').trim();
+    submittedName = String(formData.get('name') || '').trim();
+    rawToken = String(formData.get('token') || '').trim();
+    expectedNonce = await consumeSessionNonce(input);
+  } else {
+    submittedEmail = String(input.submittedEmail || input.email || '').trim();
+    submittedName = String(input.submittedName || input.name || '').trim();
+    rawToken = String(input.rawToken || input.token || '').trim();
+    expectedAudience = input.expectedAudience || RP_ORIGIN;
+    expectedNonce =
+      input.expectedNonce !== undefined
+        ? input.expectedNonce
+        : await consumeSessionNonce(input.sessionId || input);
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      return completeAccountCreation(submittedEmail, submittedName);
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  return sendTraditionalVerificationEmail(submittedEmail, submittedName);
+}
