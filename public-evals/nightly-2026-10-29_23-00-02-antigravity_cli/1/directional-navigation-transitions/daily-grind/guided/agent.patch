+  <script>
+    const cards = Array.from(document.querySelectorAll('#seasonal-favorites .card'));
+    const prevBtn = document.getElementById('prev-btn');
+    const nextBtn = document.getElementById('next-btn');
+    let currentIndex = 0;
+
+    function showCard(index) {
+      currentIndex = index;
+      cards.forEach((card, i) => {
+        card.hidden = i !== currentIndex;
+      });
+    }
+
+    function navigate(updateDOM, direction) {
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      document.startViewTransition({
+        update: updateDOM,
+        types: [direction]
+      });
+    }
+
+    nextBtn.addEventListener('click', () => {
+      const nextIndex = (currentIndex + 1) % cards.length;
+      navigate(() => showCard(nextIndex), 'forward');
+    });
+
+    prevBtn.addEventListener('click', () => {
+      const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
+      navigate(() => showCard(prevIndex), 'backward');
+    });
+  </script>
+
