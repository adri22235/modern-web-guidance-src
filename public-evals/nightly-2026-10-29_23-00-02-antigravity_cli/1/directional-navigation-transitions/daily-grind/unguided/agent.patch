+    /* Carousel / Seasonal Favorites */
+    .carousel-wrapper {
+      max-width: 500px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      position: relative;
+      overflow: hidden;
+      border-radius: 8px;
+      padding: 4px;
+    }
+
+    .carousel-viewport .card {
+      display: none;
+    }
+
+    .carousel-viewport .card.active {
+      display: block;
+    }
+
+    .carousel-viewport .card[hidden] {
+      display: none !important;
+    }
+
+    @keyframes slideInFromRight {
+      from {
+        transform: translateX(100%);
+        opacity: 0;
+      }
+      to {
+        transform: translateX(0);
+        opacity: 1;
+      }
+    }
+
+    @keyframes slideInFromLeft {
+      from {
+        transform: translateX(-100%);
+        opacity: 0;
+      }
+      to {
+        transform: translateX(0);
+        opacity: 1;
+      }
+    }
+
+    .carousel-viewport .card.slide-next {
+      animation: slideInFromRight 0.35s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
+    }
+
+    .carousel-viewport .card.slide-prev {
+      animation: slideInFromLeft 0.35s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
+    }
+
+    .carousel-controls {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 16px;
+      margin-top: 16px;
+    }
+
+    .carousel-btn {
+      background: var(--primary);
+      color: white;
+      border: none;
+      padding: 8px 18px;
+      border-radius: 5px;
+      font-size: 0.95rem;
+      cursor: pointer;
+      transition: background 0.3s, opacity 0.3s;
+    }
+
+    .carousel-btn:hover {
+      background: #3e2723;
+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+      color: var(--text);
+      font-weight: 500;
+      min-width: 60px;
+      text-align: center;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel-viewport .card.slide-next,
+      .carousel-viewport .card.slide-prev {
+        animation: none !important;
+        transition: none !important;
+      }
+      .carousel-btn,
+      .btn,
+      nav a {
+        transition: none !important;
+      }
+    }
+
