+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('.carousel-viewport .card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const statusEl = document.getElementById('carousel-status');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let currentIndex = 0;
+
+      function showItem(newIndex, direction) {
+        cards.forEach((card, index) => {
+          card.classList.remove('active', 'slide-next', 'slide-prev');
+          if (index === newIndex) {
+            card.hidden = false;
+            card.classList.add('active');
+            if (!reducedMotionQuery.matches && direction) {
+              // Trigger reflow so repeated animations in the same direction play cleanly
+              void card.offsetWidth;
+              card.classList.add(direction === 'next' ? 'slide-next' : 'slide-prev');
+            }
+          } else {
+            card.hidden = true;
+          }
+        });
+        currentIndex = newIndex;
+        if (statusEl) {
+          statusEl.textContent = (currentIndex + 1) + ' / ' + cards.length;
+        }
+      }
+
+      prevBtn.addEventListener('click', () => {
+        const nextIdx = (currentIndex - 1 + cards.length) % cards.length;
+        showItem(nextIdx, 'prev');
+      });
+
+      nextBtn.addEventListener('click', () => {
+        const nextIdx = (currentIndex + 1) % cards.length;
+        showItem(nextIdx, 'next');
+      });
+    })();
+  </script>
+
