+import React, { useState, useRef, useLayoutEffect, useEffect } from 'react';
+
+export interface StoryItem {
+  id: string;
+  title: string;
+  date: string;
+  href: string;
+}
+
+interface TopStoriesSliderProps {
+  stories: StoryItem[];
+}
+
+export default function TopStoriesSlider({ stories }: TopStoriesSliderProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [slideCount, setSlideCount] = useState(0);
+  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
+  const slideRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    if (typeof window === 'undefined' || !window.matchMedia) return;
+    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+    setPrefersReducedMotion(mediaQuery.matches);
+
+    const handleChange = (event: MediaQueryListEvent) => {
+      setPrefersReducedMotion(event.matches);
+    };
+
+    mediaQuery.addEventListener('change', handleChange);
+    return () => mediaQuery.removeEventListener('change', handleChange);
+  }, []);
+
+  useLayoutEffect(() => {
+    const el = slideRef.current;
+    if (!el || !direction) return;
+
+    const reduced =
+      typeof window !== 'undefined' &&
+      window.matchMedia &&
+      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+    el.classList.remove('slide-in-right', 'slide-in-left');
+
+    if (reduced) {
+      return;
+    }
+
+    // Force reflow so consecutive navigations in the same direction restart the animation
+    void el.offsetWidth;
+    el.classList.add(direction === 'next' ? 'slide-in-right' : 'slide-in-left');
+  }, [currentIndex, direction, slideCount]);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const handlePrevious = () => {
+    setDirection('prev');
+    setSlideCount((c) => c + 1);
+    setCurrentIndex((prevIndex) => (prevIndex - 1 + stories.length) % stories.length);
+  };
+
+  const handleNext = () => {
+    setDirection('next');
+    setSlideCount((c) => c + 1);
+    setCurrentIndex((prevIndex) => (prevIndex + 1) % stories.length);
+  };
+
+  const currentStory = stories[currentIndex];
+  const animationClass =
+    !prefersReducedMotion && direction === 'next'
+      ? 'slide-in-right'
+      : !prefersReducedMotion && direction === 'prev'
+      ? 'slide-in-left'
+      : '';
+
+  return (
+    <section
+      aria-label="Top Stories"
+      aria-roledescription="carousel"
+      className="bg-white border-b border-gray-300"
+    >
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div className="flex items-center justify-between gap-4">
+          <button
+            type="button"
+            onClick={handlePrevious}
+            aria-label="Previous"
+            className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+          >
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={2}
+              stroke="currentColor"
+              className="w-4 h-4"
+              aria-hidden="true"
+            >
+              <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
+            </svg>
+            <span>Previous</span>
+          </button>
+
+          <div className="overflow-hidden flex-1 min-w-0" aria-live="polite">
+            <div
+              ref={slideRef}
+              data-direction={direction ?? undefined}
+              className={`top-story-slide w-full text-center ${animationClass}`}
+            >
+              <a href={currentStory.href}>
+                <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+                  {currentStory.title}
+                </h3>
+              </a>
+              <span className="text-xs text-gray-500">{currentStory.date}</span>
+            </div>
+          </div>
+
+          <button
+            type="button"
+            onClick={handleNext}
+            aria-label="Next"
+            className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+          >
+            <span>Next</span>
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={2}
+              stroke="currentColor"
+              className="w-4 h-4"
+              aria-hidden="true"
+            >
+              <path strokeLinecap="round" strokeLinejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
+            </svg>
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
