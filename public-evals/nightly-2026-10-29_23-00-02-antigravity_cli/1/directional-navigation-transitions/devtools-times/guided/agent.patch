-                ))}
+            <div class="flex items-center justify-between gap-4" id="top-stories-section">
+                <button
+                    type="button"
+                    id="prev-story"
+                    aria-label="Previous story"
+                    class="px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer shrink-0"
+                >
+                    Previous
+                </button>
+
+                <div id="top-stories-slider" class="top-story-content flex-1 overflow-hidden text-center">
+                    {topStories.map((article, index) => (
+                        <div
+                            data-story-slide
+                            data-story-index={index}
+                            class={index === 0 ? "" : "hidden"}
+                            hidden={index !== 0}
+                        >
+                            <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                            </a>
+                            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                        </div>
+                    ))}
+                </div>
+
+                <button
+                    type="button"
+                    id="next-story"
+                    aria-label="Next story"
+                    class="px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer shrink-0"
+                >
+                    Next
+                </button>
             </div>
         </div>
     </div>
 
+    <script>
+        /**
+         * Navigates to a new view with a directional transition.
+         * @param {() => void} updateDOM - Callback to update the DOM state.
+         * @param {'forward' | 'backward'} direction - Either 'forward' or 'backward'.
+         */
+        function navigate(updateDOM: () => void, direction: 'forward' | 'backward') {
+            // Feature detect for browsers that do not support View Transitions
+            if (!document.startViewTransition) {
+                updateDOM();
+                return;
+            }
+
+            // Start transition with the specific navigation type
+            document.startViewTransition({
+                update: updateDOM,
+                types: [direction] // Matches the CSS :active-view-transition-type() selectors
+            });
+        }
+
+        function initTopStoriesSlider() {
+            const slider = document.getElementById('top-stories-slider');
+            const prevBtn = document.getElementById('prev-story');
+            const nextBtn = document.getElementById('next-story');
+            if (!slider || !prevBtn || !nextBtn || slider.dataset.initialized === 'true') return;
+            slider.dataset.initialized = 'true';
+
+            const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-story-slide]'));
+            if (slides.length === 0) return;
+
+            let currentIndex = 0;
+
+            function updateActiveStory() {
+                slides.forEach((slide, index) => {
+                    const isActive = index === currentIndex;
+                    slide.classList.toggle('hidden', !isActive);
+                    slide.hidden = !isActive;
+                });
+            }
+
+            nextBtn.addEventListener('click', () => {
+                navigate(() => {
+                    currentIndex = (currentIndex + 1) % slides.length;
+                    updateActiveStory();
+                }, 'forward');
+            });
+
+            prevBtn.addEventListener('click', () => {
+                navigate(() => {
+                    currentIndex = (currentIndex - 1 + slides.length) % slides.length;
+                    updateActiveStory();
+                }, 'backward');
+            });
+        }
+
+        initTopStoriesSlider();
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
+
     <!-- Main Content Area -->
     <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
         <ArticleTeaser article={topArticle} large={true} />
