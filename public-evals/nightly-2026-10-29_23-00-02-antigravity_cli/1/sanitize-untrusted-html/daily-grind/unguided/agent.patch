+  <script>
+    (function () {
+      const UNSAFE_ELEMENTS = new Set([
+        'SCRIPT', 'IFRAME', 'OBJECT', 'EMBED', 'STYLE', 'LINK', 'META',
+        'BASE', 'FORM', 'INPUT', 'BUTTON', 'TEXTAREA', 'SELECT', 'OPTION',
+        'OPTGROUP', 'DATALIST', 'APPLET', 'FRAME', 'FRAMESET', 'NOSCRIPT',
+        'TEMPLATE', 'SVG', 'MATH', 'PORTAL', 'SLOT', 'HEAD', 'HTML', 'BODY', 'TITLE'
+      ]);
+
+      const URL_ATTRIBUTES = new Set([
+        'href', 'src', 'cite', 'action', 'formaction', 'xlink:href', 'poster', 'background', 'longdesc', 'usemap'
+      ]);
+
+      function cleanElementTree(root) {
+        const allElements = Array.from(root.querySelectorAll('*'));
+        for (const el of allElements) {
+          if (UNSAFE_ELEMENTS.has(el.tagName.toUpperCase())) {
+            el.remove();
+            continue;
+          }
+
+          for (const attr of Array.from(el.attributes)) {
+            const name = attr.name.toLowerCase();
+            const normalizedValue = attr.value.replace(/[\u0000-\u0020]+/g, '').toLowerCase();
+
+            if (
+              name.startsWith('on') ||
+              name === 'srcdoc' ||
+              name === 'style' ||
+              name === 'formaction' ||
+              name === 'xlink:href'
+            ) {
+              el.removeAttribute(attr.name);
+            } else if (URL_ATTRIBUTES.has(name)) {
+              if (
+                normalizedValue.startsWith('javascript:') ||
+                normalizedValue.startsWith('vbscript:') ||
+                normalizedValue.startsWith('data:')
+              ) {
+                el.removeAttribute(attr.name);
+              }
+            }
+          }
+        }
+      }
+
+      function renderSanitizedHTML(targetElement, untrustedHTML) {
+        const markup = String(untrustedHTML ?? '');
+        if (typeof targetElement.setHTML === 'function') {
+          try {
+            targetElement.setHTML(markup);
+            cleanElementTree(targetElement);
+            return;
+          } catch (e) {
+            // Fall back to DOMParser sanitization if setHTML fails
+          }
+        }
+
+        const parser = new DOMParser();
+        const parsedDoc = parser.parseFromString(markup, 'text/html');
+        cleanElementTree(parsedDoc.body);
+
+        const fragment = document.createDocumentFragment();
+        for (const child of Array.from(parsedDoc.body.childNodes)) {
+          fragment.appendChild(document.importNode(child, true));
+        }
+        targetElement.replaceChildren(fragment);
+      }
+
+      const initialReviews = [
+        {
+          name: 'Elena R.',
+          drink: 'Maple Oat Latte',
+          rating: 5,
+          feedback: '<p>The <strong>Maple Oat Latte</strong> has the <em>perfect</em> balance of real Vermont maple sweetness and velvety oat milk!</p>'
+        },
+        {
+          name: 'Marcus T.',
+          drink: 'Dark Roast Espresso',
+          rating: 5,
+          feedback: '<p>Bold and rich with <b>zero bitterness</b>. My go-to morning espresso shot.</p>'
+        },
+        {
+          name: 'Priya K.',
+          drink: 'Cold Brew',
+          rating: 4,
+          feedback: '<p>Incredibly smooth! Love the subtle <i>chocolate notes</i> after the 18-hour steep.</p>'
+        }
+      ];
+
+      const reviewsList = document.getElementById('reviews-list');
+      const reviewForm = document.getElementById('review-form');
+
+      function addReviewToDOM({ name, drink, rating, feedback }, prepend = false) {
+        const item = document.createElement('article');
+        item.className = 'review-item';
+
+        const header = document.createElement('div');
+        header.className = 'review-header';
+
+        const authorSpan = document.createElement('span');
+        authorSpan.className = 'review-author';
+        authorSpan.textContent = (name && name.trim()) ? name.trim() : 'Anonymous';
+
+        const drinkBadge = document.createElement('span');
+        drinkBadge.className = 'review-drink-badge';
+        drinkBadge.textContent = drink || 'Maple Oat Latte';
+
+        const numericRating = Math.min(5, Math.max(1, parseInt(rating, 10) || 5));
+        const ratingSpan = document.createElement('span');
+        ratingSpan.className = 'review-rating';
+        ratingSpan.setAttribute('aria-label', `${numericRating} out of 5 stars`);
+        ratingSpan.textContent = '★'.repeat(numericRating) + '☆'.repeat(5 - numericRating);
+
+        header.appendChild(authorSpan);
+        header.appendChild(drinkBadge);
+        header.appendChild(ratingSpan);
+
+        const contentDiv = document.createElement('div');
+        contentDiv.className = 'review-content';
+        renderSanitizedHTML(contentDiv, feedback);
+
+        item.appendChild(header);
+        item.appendChild(contentDiv);
+
+        if (prepend && reviewsList.firstChild) {
+          reviewsList.insertBefore(item, reviewsList.firstChild);
+        } else {
+          reviewsList.appendChild(item);
+        }
+      }
+
+      for (const review of initialReviews) {
+        addReviewToDOM(review, false);
+      }
+
+      reviewForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const nameInput = document.getElementById('reviewer-name');
+        const drinkSelect = document.getElementById('review-drink');
+        const ratingSelect = document.getElementById('review-rating');
+        const feedbackInput = document.getElementById('review-feedback');
+
+        const feedback = feedbackInput.value;
+        if (!feedback || !feedback.trim()) {
+          return;
+        }
+
+        addReviewToDOM({
+          name: nameInput.value,
+          drink: drinkSelect.value,
+          rating: ratingSelect.value,
+          feedback: feedback
+        }, true);
+
+        feedbackInput.value = '';
+        nameInput.value = '';
+      });
+    })();
+  </script>
