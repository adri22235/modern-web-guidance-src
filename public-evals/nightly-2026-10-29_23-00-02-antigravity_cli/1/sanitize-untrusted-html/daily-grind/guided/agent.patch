+  <script type="module">
+    const ALLOWED_ELEMENTS = [
+      'p', 'b', 'i', 'strong', 'em', 'u', 's',
+      'blockquote', 'code', 'ul', 'ol', 'li', 'br', 'span'
+    ];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then(
+        (mod) => mod.default ?? mod
+      );
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    async function safePreviewHTML(previewEl, rawHTML) {
+      if (!rawHTML.trim()) {
+        previewEl.textContent = 'Start typing to preview your sanitized review...';
+        return;
+      }
+
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(rawHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, rawHTML);
+      }
+    }
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const nameInput = document.getElementById('reviewer-name');
+    const feedbackInput = document.getElementById('review-feedback');
+    const nameError = document.getElementById('name-error');
+    const feedbackError = document.getElementById('feedback-error');
+    const previewEl = document.getElementById('review-preview');
+    const submitBtn = document.getElementById('submit-review-btn');
+
+    async function appendReview({ author, drink, html }) {
+      const article = document.createElement('article');
+      article.className = 'review-item';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = author;
+
+      const drinkBadge = document.createElement('span');
+      drinkBadge.className = 'review-drink-badge';
+      drinkBadge.textContent = drink;
+
+      meta.append(authorSpan, drinkBadge);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, html);
+
+      article.append(meta, body);
+      reviewsList.prepend(article);
+    }
+
+    const initialReviews = [
+      {
+        author: 'Maya Lin',
+        drink: 'Cold Brew',
+        html: '<p>Steeped to perfection! <strong>Zero bitterness</strong> and super refreshing over ice.</p>'
+      },
+      {
+        author: 'Marcus Vance',
+        drink: 'Dark Roast Espresso',
+        html: '<p>Rich crema and <em>bold</em> smokey notes:</p><ul><li>Great morning kick</li><li>Pairs well with a croissant</li></ul>'
+      },
+      {
+        author: 'Elena Rostova',
+        drink: 'Maple Oat Latte',
+        html: '<p>The <strong>Vermont maple</strong> balance is spot-on—sweet without overpowering the espresso!</p><blockquote>My go-to autumn drink every morning.</blockquote>'
+      }
+    ];
+
+    for (const review of initialReviews) {
+      await appendReview(review);
+    }
+
+    function validateField(input, errorEl, emptyMessage) {
+      if (!input.value.trim()) {
+        input.setCustomValidity(emptyMessage);
+        errorEl.textContent = emptyMessage;
+        return false;
+      }
+      input.setCustomValidity('');
+      errorEl.textContent = '';
+      return true;
+    }
+
+    nameInput.addEventListener('blur', () => {
+      validateField(nameInput, nameError, 'Please enter your name.');
+    });
+
+    nameInput.addEventListener('input', () => {
+      nameInput.setCustomValidity('');
+      nameError.textContent = '';
+    });
+
+    feedbackInput.addEventListener('blur', () => {
+      validateField(feedbackInput, feedbackError, 'Please enter your review feedback.');
+    });
+
+    feedbackInput.addEventListener('input', () => {
+      feedbackInput.setCustomValidity('');
+      feedbackError.textContent = '';
+      safePreviewHTML(previewEl, feedbackInput.value);
+    });
+
+    reviewForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+
+      const isNameValid = validateField(nameInput, nameError, 'Please enter your name.');
+      const isFeedbackValid = validateField(feedbackInput, feedbackError, 'Please enter your review feedback.');
+
+      if (!isNameValid) {
+        nameInput.focus();
+        return;
+      }
+      if (!isFeedbackValid) {
+        feedbackInput.focus();
+        return;
+      }
+
+      submitBtn.disabled = true;
+      try {
+        const formData = new FormData(reviewForm);
+        const drink = String(formData.get('drink') || 'Maple Oat Latte');
+        const author = String(formData.get('reviewer_name') || '').trim();
+        const html = String(formData.get('review_feedback') || '');
+
+        await appendReview({ author, drink, html });
+
+        reviewForm.reset();
+        await safePreviewHTML(previewEl, '');
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
