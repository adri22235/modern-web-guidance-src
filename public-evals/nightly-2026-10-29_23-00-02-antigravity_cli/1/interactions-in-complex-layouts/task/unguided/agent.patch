+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      if (!board) return;
+
+      const columns = Array.from(board.querySelectorAll('.board-column'));
+      let draggedCard = null;
+      let activeColumn = null;
+      let rafId = null;
+
+      function updateCounts() {
+        for (let i = 0; i < columns.length; i++) {
+          const col = columns[i];
+          const badge = col.querySelector('.column-count');
+          if (badge) {
+            const count = col.querySelectorAll('.card').length;
+            badge.textContent = String(count);
+          }
+        }
+      }
+
+      function setHighlightColumn(nextColumn) {
+        if (activeColumn === nextColumn) return;
+        if (activeColumn) {
+          activeColumn.classList.remove('drag-over');
+        }
+        activeColumn = nextColumn;
+        if (activeColumn) {
+          activeColumn.classList.add('drag-over');
+        }
+      }
+
+      function handleDragStart(e) {
+        const card = e.target.closest ? e.target.closest('.card') : null;
+        if (!card) return;
+
+        draggedCard = card;
+        card.classList.add('dragging');
+
+        if (e.dataTransfer) {
+          try {
+            e.dataTransfer.effectAllowed = 'move';
+            e.dataTransfer.setData('text/plain', card.id || '');
+          } catch (_) {
+            // Ignore synthetic DragEvent dataTransfer restrictions
+          }
+        }
+      }
+
+      function handleDragOver(e) {
+        const column = e.target.closest ? e.target.closest('.board-column') : e.currentTarget;
+        if (!column || !column.classList.contains('board-column')) return;
+
+        e.preventDefault();
+        if (e.dataTransfer) {
+          try {
+            e.dataTransfer.dropEffect = 'move';
+          } catch (_) {}
+        }
+
+        if (rafId === null) {
+          rafId = window.requestAnimationFrame(function () {
+            rafId = null;
+            setHighlightColumn(column);
+          });
+        }
+      }
+
+      function handleDragEnter(e) {
+        const column = e.target.closest ? e.target.closest('.board-column') : e.currentTarget;
+        if (!column || !column.classList.contains('board-column')) return;
+        e.preventDefault();
+        setHighlightColumn(column);
+      }
+
+      function handleDragLeave(e) {
+        const column = e.target.closest ? e.target.closest('.board-column') : e.currentTarget;
+        if (!column || !column.classList.contains('board-column')) return;
+        const related = e.relatedTarget;
+        if (related && column.contains(related)) return;
+        if (activeColumn === column) {
+          setHighlightColumn(null);
+        }
+      }
+
+      function handleDrop(e) {
+        const column = e.target.closest ? e.target.closest('.board-column') : e.currentTarget;
+        if (!column || !column.classList.contains('board-column')) return;
+
+        e.preventDefault();
+
+        if (rafId !== null) {
+          window.cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        setHighlightColumn(null);
+
+        let card = draggedCard;
+        if (!card && e.dataTransfer) {
+          try {
+            const id = e.dataTransfer.getData('text/plain');
+            if (id) {
+              card = document.getElementById(id);
+            }
+          } catch (_) {}
+        }
+        if (!card) {
+          card = board.querySelector('.card.dragging');
+        }
+        if (!card) return;
+
+        const targetStatus = column.getAttribute('data-status') || column.getAttribute('data-column') || column.id;
+        if (targetStatus) {
+          card.setAttribute('data-status', targetStatus);
+        }
+
+        // Direct DOM node move inside layout-contained column avoids global reflow
+        column.appendChild(card);
+        card.classList.remove('dragging');
+        draggedCard = null;
+        updateCounts();
+      }
+
+      function handleDragEnd() {
+        if (rafId !== null) {
+          window.cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        setHighlightColumn(null);
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        } else {
+          const lingering = board.querySelectorAll('.card.dragging');
+          for (let i = 0; i < lingering.length; i++) {
+            lingering[i].classList.remove('dragging');
+          }
+        }
+      }
+
+      board.addEventListener('dragstart', handleDragStart);
+      board.addEventListener('dragover', handleDragOver);
+      board.addEventListener('dragenter', handleDragEnter);
+      board.addEventListener('dragleave', handleDragLeave);
+      board.addEventListener('drop', handleDrop);
+      board.addEventListener('dragend', handleDragEnd);
+
+      // Batch order insertion helper using DocumentFragment to avoid layout thrashing
+      window.addOrdersBatch = function (columnId, orders) {
+        const column = document.getElementById(columnId) || board.querySelector('.board-column.' + columnId);
+        if (!column || !Array.isArray(orders) || orders.length === 0) return;
+
+        const fragment = document.createDocumentFragment();
+        const status = column.getAttribute('data-status') || columnId;
+
+        for (let i = 0; i < orders.length; i++) {
+          const item = orders[i];
+          const card = document.createElement('div');
+          card.className = 'card';
+          card.draggable = true;
+          card.id = item.id || ('order-' + Date.now() + '-' + i);
+          card.setAttribute('data-status', status);
+
+          const h3 = document.createElement('h3');
+          h3.textContent = item.title || item.name || 'Custom Drink';
+          card.appendChild(h3);
+
+          if (item.description) {
+            const p = document.createElement('p');
+            p.textContent = item.description;
+            card.appendChild(p);
+          }
+
+          fragment.appendChild(card);
+        }
+
+        column.appendChild(fragment);
+        updateCounts();
+      };
+    })();
+  </script>
+
 </body>
 
