+  <script>
+    const navItems = document.querySelectorAll('nav ul li a:not(.logout-link)');
+    const indicator = document.querySelector('.nav-indicator');
+
+    function updateIndicator(activeItem, animate = true) {
+      if (!activeItem || !indicator) return;
+      if (!animate) {
+        indicator.style.transition = 'none';
+      }
+      indicator.style.left = `${activeItem.offsetLeft}px`;
+      indicator.style.width = `${activeItem.offsetWidth}px`;
+      if (!animate) {
+        indicator.offsetHeight; // Force reflow
+        indicator.style.transition = '';
+      }
+    }
+
+    const initialActive = document.querySelector('nav ul li a.active:not(.logout-link)') || navItems[0];
+    if (initialActive) {
+      initialActive.classList.add('active');
+      updateIndicator(initialActive, false);
+    }
+
+    navItems.forEach((item) => {
+      item.addEventListener('click', (event) => {
+        event.preventDefault();
+        navItems.forEach((navLink) => {
+          navLink.classList.remove('active');
+          navLink.removeAttribute('aria-current');
+        });
+        item.classList.add('active');
+        item.setAttribute('aria-current', 'page');
+        updateIndicator(item, true);
+      });
+    });
+
+    window.addEventListener('resize', () => {
+      const currentActive = document.querySelector('nav ul li a.active:not(.logout-link)');
+      updateIndicator(currentActive, false);
+    });
+  </script>
+
 </body>
 
