diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,16 +11,117 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-size: 16px;
+      --scrollbar-track: #ece5e2;
+      --scrollbar-track-border: #b0a09a;
+      --scrollbar-thumb: #3e2723;
+      --scrollbar-thumb-hover: #1f120f;
+      --scrollbar-thumb-active: #000000;
+      --scrollbar-thumb-border: #ece5e2;
     }
 
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
     }
 
+    /* High-visibility Custom Scrollbars */
+    ::-webkit-scrollbar {
+      width: var(--scrollbar-size);
+      height: var(--scrollbar-size);
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+      border-left: 2px solid var(--scrollbar-track-border);
+      border-top: 2px solid var(--scrollbar-track-border);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border: 3px solid var(--scrollbar-thumb-border);
+      border-radius: 8px;
+      min-height: 44px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+      border-color: var(--accent);
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: var(--scrollbar-thumb-active);
+      border-color: var(--accent);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    /* Enhanced visibility for users requesting high contrast */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-size: 18px;
+        --scrollbar-track: #ffffff;
+        --scrollbar-track-border: #000000;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #3e2723;
+        --scrollbar-thumb-active: #000000;
+        --scrollbar-thumb-border: #ffffff;
+      }
+
+      * {
+        scrollbar-width: auto;
+        scrollbar-color: #000000 #ffffff;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: #ffffff;
+        border: 2px solid #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: #000000;
+        border: 2px solid #ffffff;
+        outline: 2px solid #000000;
+        border-radius: 0;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: #000000;
+        border-color: var(--accent);
+        outline: 2px solid #000000;
+      }
+    }
+
+    @media (forced-colors: active) {
+      * {
+        scrollbar-color: ButtonText Canvas;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: Canvas;
+        border: 2px solid ButtonText;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: ButtonText;
+        border: 2px solid Canvas;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: Highlight;
+        border-color: Canvas;
+      }
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
