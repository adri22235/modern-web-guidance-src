+    /* Toast Notifications (Top Layer via Popover API, pure CSS stacking) */
+    @keyframes toast-enter {
+      from {
+        opacity: 0;
+        transform: translateY(16px) scale(0.96);
+      }
+      to {
+        opacity: 1;
+        transform: translateY(0) scale(1);
+      }
+    }
+
+    .toast {
+      --stack-index: 0;
+      --toast-height: 56px;
+      --toast-gap: 12px;
+      position: fixed;
+      inset: auto 24px 24px auto;
+      bottom: calc(24px + var(--stack-index) * (var(--toast-height) + var(--toast-gap)));
+      right: 24px;
+      margin: 0;
+      min-width: 240px;
+      height: var(--toast-height);
+      padding: 12px 16px;
+      background: var(--primary);
+      color: var(--light);
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+      pointer-events: none;
+      opacity: 0;
+      transform: translateY(16px) scale(0.96);
+      transition:
+        bottom 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+        opacity 0.25s ease,
+        transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
+        overlay 0.25s allow-discrete,
+        display 0.25s allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      transform: translateY(0) scale(1);
+      animation: toast-enter 0.25s cubic-bezier(0.22, 1, 0.36, 1);
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateY(16px) scale(0.96);
+      }
+    }
+
+    .toast.toast-leaving {
+      opacity: 0;
+      transform: translateY(16px) scale(0.96);
+    }
+
+    .toast:has(~ .toast) { --stack-index: 1; }
+    .toast:has(~ .toast ~ .toast) { --stack-index: 2; }
+    .toast:has(~ .toast ~ .toast ~ .toast) { --stack-index: 3; }
+    .toast:has(~ .toast ~ .toast ~ .toast ~ .toast) { --stack-index: 4; }
+    .toast:has(~ .toast ~ .toast ~ .toast ~ .toast ~ .toast) { --stack-index: 5; }
+    .toast:has(~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast) { --stack-index: 6; }
+    .toast:has(~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast) { --stack-index: 7; }
+    .toast:has(~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast) { --stack-index: 8; }
+    .toast:has(~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast ~ .toast) { --stack-index: 9; }
