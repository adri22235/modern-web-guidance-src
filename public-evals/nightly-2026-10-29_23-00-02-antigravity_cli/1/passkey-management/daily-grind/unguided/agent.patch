+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css">
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" class="active">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <!-- My Account & Passkey Management Section -->
+    <section id="account" class="account-section" aria-labelledby="account-heading">
+      <div class="account-header">
+        <div>
+          <h2 id="account-heading">My Account</h2>
+          <p class="account-subtitle">Manage your profile, security settings, and registered passkeys.</p>
+        </div>
+      </div>
+
+      <div class="account-layout">
+        <!-- Customer Profile Summary & Details -->
+        <aside class="account-panel" aria-label="Customer Profile">
+          <div class="profile-summary">
+            <div id="profile-avatar" class="profile-avatar" aria-hidden="true">AR</div>
+            <div class="profile-meta">
+              <h3 id="profile-display-name">Alex Rivera</h3>
+              <p id="profile-email">alex.rivera@dailygrind.coffee</p>
+              <span class="member-badge">Roaster's Reserve Member</span>
+            </div>
+          </div>
+
+          <form id="account-profile-form" class="profile-form">
+            <h4>Account Identity</h4>
+            <div class="form-group">
+              <label for="account-display-name-input">Display Name</label>
+              <input
+                id="account-display-name-input"
+                type="text"
+                class="input-field"
+                value="Alex Rivera"
+                required
+              />
+            </div>
+            <div class="form-group">
+              <label for="account-email-input">Email / Username</label>
+              <input
+                id="account-email-input"
+                type="email"
+                class="input-field"
+                value="alex.rivera@dailygrind.coffee"
+                required
+              />
+            </div>
+            <button type="submit" class="btn btn-sm btn-outline" style="width: 100%;">
+              Update Profile &amp; Sync Authenticator
+            </button>
+          </form>
+        </aside>
+
+        <!-- Passkey Management UI -->
+        <div id="passkey-management" class="account-panel">
+          <div class="passkey-panel-header">
+            <div class="passkey-panel-title">
+              <h3>
+                Registered Passkeys
+                <span id="passkey-count-badge" class="passkey-count-badge">3 keys</span>
+              </h3>
+              <p>
+                View, rename, or remove passkeys linked to your Daily Grind account. Changes are automatically synchronized with your browser authenticator.
+              </p>
+            </div>
+            <div class="passkey-panel-actions">
+              <button
+                type="button"
+                id="sync-authenticator-btn"
+                class="btn btn-sm btn-outline"
+              >
+                Sync Authenticator
+              </button>
+              <button
+                type="button"
+                id="toggle-add-passkey-btn"
+                class="btn btn-sm"
+              >
+                + Add Passkey
+              </button>
+            </div>
+          </div>
+
+          <!-- Browser Authenticator Sync Status Bar -->
+          <div id="authenticator-sync-status" class="sync-status-bar" role="status" aria-live="polite">
+            <div class="sync-status-main">
+              <span class="sync-dot" aria-hidden="true"></span>
+              <strong id="authenticator-sync-text">Browser authenticator synced (3 active passkeys)</strong>
+            </div>
+            <span id="authenticator-sync-meta" class="sync-meta">
+              WebAuthn Signal API ready
+            </span>
+          </div>
+
+          <!-- Action Feedback Banner -->
+          <div id="passkey-feedback-banner" class="feedback-banner" role="alert" aria-live="polite">
+            <span id="passkey-feedback-text"></span>
+            <button
+              type="button"
+              id="passkey-undo-btn"
+              class="btn btn-sm btn-outline"
+              style="display: none;"
+            >
+              Undo Delete
+            </button>
+          </div>
+
+          <!-- Register New Passkey Box -->
+          <div id="add-passkey-box" class="add-passkey-box">
+            <form id="add-passkey-form" class="add-passkey-form">
+              <div class="form-group">
+                <label for="new-passkey-name-input">Passkey Name / Device Label</label>
+                <input
+                  id="new-passkey-name-input"
+                  type="text"
+                  class="input-field"
+                  placeholder="e.g. iPhone 16 Pro, Work Laptop"
+                  required
+                />
+              </div>
+              <button type="submit" class="btn btn-sm">Register Passkey</button>
+              <button type="button" id="cancel-add-passkey-btn" class="btn btn-sm btn-outline">
+                Cancel
+              </button>
+            </form>
+          </div>
+
+          <!-- Registered Passkeys List -->
+          <ul id="passkey-list" class="passkey-list" aria-label="Registered Passkeys"></ul>
+
+          <!-- Empty State when all passkeys are removed -->
+          <div id="passkey-empty-state" class="passkey-empty-state" style="display: none;">
+            <h4>No Passkeys Registered</h4>
+            <p>You have removed all passkeys from your account and your browser authenticator has been updated.</p>
+            <button type="button" id="restore-default-passkeys-btn" class="btn btn-sm btn-outline" style="margin-top: 12px;">
+              Restore Sample Passkeys
+            </button>
+          </div>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script src="/passkeys.js"></script>
+</body>
+
+</html>
