+}
+
+.profile-meta p {
+  font-size: 0.85rem;
+  color: var(--text-muted);
+}
+
+.member-badge {
+  display: inline-block;
+  margin-top: 6px;
+  padding: 2px 10px;
+  border-radius: 999px;
+  font-size: 0.75rem;
