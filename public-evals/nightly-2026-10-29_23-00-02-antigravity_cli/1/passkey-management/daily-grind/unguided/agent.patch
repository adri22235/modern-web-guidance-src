--- /dev/null
+++ b/passkeys.js
@@ -0,0 +1,684 @@
+(function () {
+  const STORAGE_KEY = 'daily_grind_account_state_v1';
+
+  const DEFAULT_USER = {
+    userId: 'dXNlcl9kYWlseV9ncmluZF8x', // base64url encoded user handle
+    name: 'alex.rivera@dailygrind.coffee',
+    displayName: 'Alex Rivera',
+    memberTier: "Roaster's Reserve Member"
+  };
+
+  const DEFAULT_PASSKEYS = [
+    {
+      id: 'pk-1',
+      credentialId: 'Y3JlZF9tYWNib29rX3Byb18x',
+      name: 'MacBook Pro (iCloud Keychain)',
+      authenticatorType: 'Platform • Synced',
+      createdAt: 'Sep 14, 2026',
+      lastUsedAt: 'Today'
+    },
+    {
+      id: 'pk-2',
+      credentialId: 'Y3JlZF9waXhlbF9waG9uZV8y',
+      name: 'Google Password Manager (Chrome)',
+      authenticatorType: 'Multi-device • Synced',
+      createdAt: 'Oct 02, 2026',
+      lastUsedAt: 'Oct 25, 2026'
+    },
+    {
+      id: 'pk-3',
+      credentialId: 'Y3JlZF95dWJpa2V5X25mY18z',
+      name: 'YubiKey 5C NFC',
+      authenticatorType: 'Security Key • USB/NFC',
+      createdAt: 'Aug 19, 2026',
+      lastUsedAt: 'Sep 30, 2026'
+    }
+  ];
+
+  function cloneDefaults() {
+    return {
+      user: { ...DEFAULT_USER },
+      passkeys: DEFAULT_PASSKEYS.map((pk) => ({ ...pk }))
+    };
+  }
+
+  function loadState() {
+    try {
+      const raw = window.localStorage.getItem(STORAGE_KEY);
+      if (!raw) return cloneDefaults();
+      const parsed = JSON.parse(raw);
+      if (!parsed || !Array.isArray(parsed.passkeys) || !parsed.user) {
+        return cloneDefaults();
+      }
+      return parsed;
+    } catch (e) {
+      return cloneDefaults();
+    }
+  }
+
+  function saveState(state) {
+    try {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+    } catch (e) {
+      // Ignore storage errors in restricted environments
+    }
+  }
+
+  function bytesToBase64Url(bytes) {
+    let binary = '';
+    for (let i = 0; i < bytes.length; i++) {
+      binary += String.fromCharCode(bytes[i]);
+    }
+    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  }
+
+  function base64UrlToUint8Array(base64url) {
+    const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+    const padLen = (4 - (base64.length % 4)) % 4;
+    const padded = base64 + '='.repeat(padLen);
+    const binary = atob(padded);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+  }
+
+  function generateCredentialId() {
+    const bytes = new Uint8Array(18);
+    if (window.crypto && window.crypto.getRandomValues) {
+      window.crypto.getRandomValues(bytes);
+    } else {
+      for (let i = 0; i < bytes.length; i++) {
+        bytes[i] = Math.floor(Math.random() * 256);
+      }
+    }
+    return bytesToBase64Url(bytes);
+  }
+
+  function escapeHtml(str) {
+    return String(str)
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&#39;');
+  }
+
+  function getInitials(name) {
+    const parts = String(name || 'User').trim().split(/\s+/);
+    if (parts.length >= 2) {
+      return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
+    }
+    return (parts[0] ? parts[0].slice(0, 2) : 'DG').toUpperCase();
+  }
+
+  let state = loadState();
+  let editingCredentialId = null;
+  let lastDeletedPasskey = null;
+
+  /**
+   * Synchronize registered passkeys and user details with the browser authenticator
+   * using the WebAuthn Signal API:
+   * - PublicKeyCredential.signalAllAcceptedCredentials
+   * - PublicKeyCredential.signalUnknownCredential
+   * - PublicKeyCredential.signalCurrentUserDetails
+   */
+  async function syncBrowserAuthenticator(options = {}) {
+    const {
+      action = 'sync',
+      deletedCredentialId = null,
+      updatedUser = false
+    } = options;
+
+    const rpId = window.location.hostname || 'localhost';
+    const acceptedIds = state.passkeys.map((pk) => pk.credentialId);
+    const signalsSent = [];
+    let apiAvailable = false;
+
+    if (typeof window.PublicKeyCredential !== 'undefined') {
+      // 1. If a key was deleted, notify the browser authenticator that the credential is no longer valid
+      if (
+        deletedCredentialId &&
+        typeof window.PublicKeyCredential.signalUnknownCredential === 'function'
+      ) {
+        apiAvailable = true;
+        try {
+          await window.PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: deletedCredentialId
+          });
+          signalsSent.push('signalUnknownCredential');
+        } catch (err) {
+          console.warn('PublicKeyCredential.signalUnknownCredential error:', err);
+        }
+      }
+
+      // 2. Always synchronize the full list of accepted credential IDs for the signed-in user
+      if (
+        typeof window.PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+      ) {
+        apiAvailable = true;
+        try {
+          await window.PublicKeyCredential.signalAllAcceptedCredentials({
+            rpId,
+            userId: state.user.userId,
+            allAcceptedCredentialIds: acceptedIds
+          });
+          signalsSent.push('signalAllAcceptedCredentials');
+        } catch (err) {
+          console.warn('PublicKeyCredential.signalAllAcceptedCredentials error:', err);
+        }
+      }
+
+      // 3. Synchronize current user details when profile or account state updates
+      if (
+        updatedUser &&
+        typeof window.PublicKeyCredential.signalCurrentUserDetails === 'function'
+      ) {
+        apiAvailable = true;
+        try {
+          await window.PublicKeyCredential.signalCurrentUserDetails({
+            rpId,
+            userId: state.user.userId,
+            name: state.user.name,
+            displayName: state.user.displayName
+          });
+          signalsSent.push('signalCurrentUserDetails');
+        } catch (err) {
+          console.warn('PublicKeyCredential.signalCurrentUserDetails error:', err);
+        }
+      }
+    }
+
+    updateSyncStatusUI({
+      action,
+      rpId,
+      acceptedCount: acceptedIds.length,
+      deletedCredentialId,
+      signalsSent,
+      apiAvailable
+    });
+
+    return {
+      rpId,
+      userId: state.user.userId,
+      allAcceptedCredentialIds: acceptedIds,
+      deletedCredentialId,
+      signalsSent,
+      apiAvailable
+    };
+  }
+
+  function updateSyncStatusUI({
+    action,
+    rpId,
+    acceptedCount,
+    deletedCredentialId,
+    signalsSent,
+    apiAvailable
+  }) {
+    const statusEl = document.getElementById('authenticator-sync-status');
+    const statusTextEl = document.getElementById('authenticator-sync-text');
+    const statusMetaEl = document.getElementById('authenticator-sync-meta');
+    if (!statusEl || !statusTextEl || !statusMetaEl) return;
+
+    const timeStr = new Date().toLocaleTimeString([], {
+      hour: '2-digit',
+      minute: '2-digit',
+      second: '2-digit'
+    });
+
+    let message = `Browser authenticator synced (${acceptedCount} active ${
+      acceptedCount === 1 ? 'passkey' : 'passkeys'
+    })`;
+
+    if (action === 'delete' && deletedCredentialId) {
+      message = `Removed deleted key from browser authenticator (${acceptedCount} active ${
+        acceptedCount === 1 ? 'passkey' : 'passkeys'
+      } remaining)`;
+    } else if (action === 'rename') {
+      message = `Passkey label updated & browser authenticator synced (${acceptedCount} active)`;
+    } else if (action === 'add') {
+      message = `New passkey registered & synced with browser authenticator (${acceptedCount} active)`;
+    } else if (action === 'user-update') {
+      message = `Account details synced with browser authenticator for ${state.user.displayName}`;
+    }
+
+    statusTextEl.textContent = message;
+
+    const signalLabel =
+      signalsSent.length > 0
+        ? `WebAuthn Signal API (${signalsSent.join(', ')})`
+        : apiAvailable
+        ? 'WebAuthn Signal API ready'
+        : 'WebAuthn Signal API (simulated / fallback)';
+
+    statusMetaEl.textContent = `${signalLabel} • RP: ${rpId} • Last synced ${timeStr}`;
+  }
+
+  function showFeedback(message, canUndo = false) {
+    const banner = document.getElementById('passkey-feedback-banner');
+    const textEl = document.getElementById('passkey-feedback-text');
+    const undoBtn = document.getElementById('passkey-undo-btn');
+    if (!banner || !textEl) return;
+
+    textEl.textContent = message;
+    banner.classList.add('visible');
+
+    if (undoBtn) {
+      undoBtn.style.display = canUndo && lastDeletedPasskey ? 'inline-flex' : 'none';
+    }
+  }
+
+  function renderProfile() {
+    const avatarEl = document.getElementById('profile-avatar');
+    const displayNameEl = document.getElementById('profile-display-name');
+    const emailEl = document.getElementById('profile-email');
+    const displayNameInput = document.getElementById('account-display-name-input');
+    const emailInput = document.getElementById('account-email-input');
+
+    if (avatarEl) avatarEl.textContent = getInitials(state.user.displayName);
+    if (displayNameEl) displayNameEl.textContent = state.user.displayName;
+    if (emailEl) emailEl.textContent = state.user.name;
+    if (displayNameInput && document.activeElement !== displayNameInput) {
+      displayNameInput.value = state.user.displayName;
+    }
+    if (emailInput && document.activeElement !== emailInput) {
+      emailInput.value = state.user.name;
+    }
+  }
+
+  function renderPasskeys() {
+    const listEl = document.getElementById('passkey-list');
+    const emptyEl = document.getElementById('passkey-empty-state');
+    const countBadge = document.getElementById('passkey-count-badge');
+
+    if (countBadge) {
+      countBadge.textContent = `${state.passkeys.length} ${
+        state.passkeys.length === 1 ? 'key' : 'keys'
+      }`;
+    }
+
+    if (!listEl) return;
+
+    if (state.passkeys.length === 0) {
+      listEl.innerHTML = '';
+      if (emptyEl) emptyEl.style.display = 'block';
+      return;
+    }
+
+    if (emptyEl) emptyEl.style.display = 'none';
+
+    listEl.innerHTML = state.passkeys
+      .map((pk) => {
+        const isEditing = editingCredentialId === pk.credentialId;
+        const safeName = escapeHtml(pk.name);
+        const safeCredId = escapeHtml(pk.credentialId);
+        const safeType = escapeHtml(pk.authenticatorType || 'Platform • Synced');
+        const safeCreated = escapeHtml(pk.createdAt || 'Today');
+        const safeLastUsed = escapeHtml(pk.lastUsedAt || 'Today');
+
+        if (isEditing) {
+          return `
+            <li class="passkey-item" data-credential-id="${safeCredId}">
+              <div class="passkey-info">
+                <div class="passkey-icon" aria-hidden="true">🔑</div>
+                <div class="passkey-details">
+                  <form class="rename-form" data-rename-form="${safeCredId}">
+                    <label for="rename-input-${safeCredId}" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Passkey Name</label>
+                    <input
+                      id="rename-input-${safeCredId}"
+                      type="text"
+                      name="passkeyName"
+                      class="rename-input"
+                      value="${safeName}"
+                      aria-label="New passkey name"
+                      required
+                    />
+                    <button type="submit" class="btn btn-sm save-rename-btn" data-save-rename="${safeCredId}">
+                      Save
+                    </button>
+                    <button type="button" class="btn btn-sm btn-outline cancel-rename-btn" data-cancel-rename="${safeCredId}">
+                      Cancel
+                    </button>
+                  </form>
+                  <div class="passkey-meta">
+                    <span>ID: <code class="passkey-cred-id">${safeCredId}</code></span>
+                    <span>Created ${safeCreated}</span>
+                  </div>
+                </div>
+              </div>
+            </li>
+          `;
+        }
+
+        return `
+          <li class="passkey-item" data-credential-id="${safeCredId}">
+            <div class="passkey-info">
+              <div class="passkey-icon" aria-hidden="true">🔑</div>
+              <div class="passkey-details">
+                <div class="passkey-title-row">
+                  <span class="passkey-name" data-passkey-name="${safeCredId}">${safeName}</span>
+                  <span class="passkey-badge">${safeType}</span>
+                </div>
+                <div class="passkey-meta">
+                  <span>ID: <code class="passkey-cred-id">${safeCredId}</code></span>
+                  <span>Created: ${safeCreated}</span>
+                  <span>Last used: ${safeLastUsed}</span>
+                </div>
+              </div>
+            </div>
+            <div class="passkey-actions">
+              <button
+                type="button"
+                class="btn btn-sm btn-outline rename-passkey-btn"
+                data-action="rename"
+                data-credential-id="${safeCredId}"
+                aria-label="Rename ${safeName}"
+              >
+                Rename
+              </button>
+              <button
+                type="button"
+                class="btn btn-sm btn-danger delete-passkey-btn"
+                data-action="delete"
+                data-credential-id="${safeCredId}"
+                aria-label="Delete ${safeName}"
+              >
+                Delete
+              </button>
+            </div>
+          </li>
+        `;
+      })
+      .join('');
+
+    if (editingCredentialId) {
+      const input = document.getElementById(`rename-input-${editingCredentialId}`);
+      if (input) {
+        input.focus();
+        input.select();
+      }
+    }
+  }
+
+  async function renamePasskey(credentialId, newName) {
+    const trimmed = String(newName || '').trim();
+    if (!trimmed) return;
+
+    const target = state.passkeys.find((pk) => pk.credentialId === credentialId);
+    if (!target) return;
+
+    const previousName = target.name;
+    target.name = trimmed;
+    editingCredentialId = null;
+    saveState(state);
+    renderPasskeys();
+    showFeedback(`Renamed passkey from "${previousName}" to "${trimmed}".`, false);
+    await syncBrowserAuthenticator({ action: 'rename' });
+  }
+
+  async function deletePasskey(credentialId) {
+    const index = state.passkeys.findIndex((pk) => pk.credentialId === credentialId);
+    if (index === -1) return;
+
+    const [removed] = state.passkeys.splice(index, 1);
+    lastDeletedPasskey = { passkey: removed, index };
+    if (editingCredentialId === credentialId) {
+      editingCredentialId = null;
+    }
+
+    saveState(state);
+    renderPasskeys();
+    showFeedback(
+      `Deleted passkey "${removed.name}" and signaled browser authenticator to remove credential.`,
+      true
+    );
+    await syncBrowserAuthenticator({
+      action: 'delete',
+      deletedCredentialId: removed.credentialId
+    });
+  }
+
+  async function undoDeletePasskey() {
+    if (!lastDeletedPasskey) return;
+    const { passkey, index } = lastDeletedPasskey;
+    lastDeletedPasskey = null;
+
+    if (!state.passkeys.some((pk) => pk.credentialId === passkey.credentialId)) {
+      state.passkeys.splice(Math.min(index, state.passkeys.length), 0, passkey);
+      saveState(state);
+      renderPasskeys();
+      showFeedback(`Restored passkey "${passkey.name}" and re-synced browser authenticator.`, false);
+      await syncBrowserAuthenticator({ action: 'add' });
+    }
+  }
+
+  async function registerNewPasskey(customLabel) {
+    const label = String(customLabel || '').trim() || 'Daily Grind Passkey';
+    let credentialId = generateCredentialId();
+
+    if (
+      window.PublicKeyCredential &&
+      navigator.credentials &&
+      typeof navigator.credentials.create === 'function'
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        }
+        const credential = await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The Daily Grind',
+              id: window.location.hostname || 'localhost'
+            },
+            user: {
+              id: base64UrlToUint8Array(state.user.userId),
+              name: state.user.name,
+              displayName: state.user.displayName
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 },
+              { type: 'public-key', alg: -257 }
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred'
+            },
+            timeout: 15000,
+            excludeCredentials: state.passkeys.map((pk) => ({
+              type: 'public-key',
+              id: base64UrlToUint8Array(pk.credentialId)
+            }))
+          }
+        });
+
+        if (credential && credential.rawId) {
+          credentialId = bytesToBase64Url(new Uint8Array(credential.rawId));
+        } else if (credential && credential.id) {
+          credentialId = credential.id;
+        }
+      } catch (err) {
+        // Fallback to generated credentialId when running in headless/non-interactive environments
+      }
+    }
+
+    const newPasskey = {
+      id: `pk-${Date.now()}`,
+      credentialId,
+      name: label,
+      authenticatorType: 'Platform • Synced',
+      createdAt: 'Just now',
+      lastUsedAt: 'Just now'
+    };
+
+    state.passkeys.unshift(newPasskey);
+    saveState(state);
+    renderPasskeys();
+    showFeedback(
+      `Registered new passkey "${label}" and synchronized with your browser authenticator.`,
+      false
+    );
+    await syncBrowserAuthenticator({ action: 'add' });
+  }
+
+  async function resetDefaultPasskeys() {
+    state = cloneDefaults();
+    editingCredentialId = null;
+    lastDeletedPasskey = null;
+    saveState(state);
+    renderProfile();
+    renderPasskeys();
+    showFeedback('Restored default registered passkeys and synced browser authenticator.', false);
+    await syncBrowserAuthenticator({ action: 'sync', updatedUser: true });
+  }
+
+  function bindEvents() {
+    const listEl = document.getElementById('passkey-list');
+    if (listEl) {
+      listEl.addEventListener('click', (e) => {
+        const renameBtn = e.target.closest('[data-action="rename"]');
+        if (renameBtn) {
+          const credId = renameBtn.getAttribute('data-credential-id');
+          editingCredentialId = credId;
+          renderPasskeys();
+          return;
+        }
+
+        const cancelBtn = e.target.closest('[data-cancel-rename]');
+        if (cancelBtn) {
+          editingCredentialId = null;
+          renderPasskeys();
+          return;
+        }
+
+        const deleteBtn = e.target.closest('[data-action="delete"]');
+        if (deleteBtn) {
+          const credId = deleteBtn.getAttribute('data-credential-id');
+          deletePasskey(credId);
+          return;
+        }
+      });
+
+      listEl.addEventListener('submit', (e) => {
+        const form = e.target.closest('[data-rename-form]');
+        if (form) {
+          e.preventDefault();
+          const credId = form.getAttribute('data-rename-form');
+          const input = form.querySelector('input[name="passkeyName"]');
+          if (input) {
+            renamePasskey(credId, input.value);
+          }
+        }
+      });
+
+      listEl.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && editingCredentialId) {
+          editingCredentialId = null;
+          renderPasskeys();
+        }
+      });
+    }
+
+    const syncBtn = document.getElementById('sync-authenticator-btn');
+    if (syncBtn) {
+      syncBtn.addEventListener('click', async () => {
+        await syncBrowserAuthenticator({ action: 'sync', updatedUser: true });
+        showFeedback('Synchronized active passkeys and user details with browser authenticator.', false);
+      });
+    }
+
+    const toggleAddBtn = document.getElementById('toggle-add-passkey-btn');
+    const addBox = document.getElementById('add-passkey-box');
+    const addForm = document.getElementById('add-passkey-form');
+    const cancelAddBtn = document.getElementById('cancel-add-passkey-btn');
+    const newPasskeyInput = document.getElementById('new-passkey-name-input');
+
+    if (toggleAddBtn && addBox) {
+      toggleAddBtn.addEventListener('click', () => {
+        addBox.classList.toggle('visible');
+        if (addBox.classList.contains('visible') && newPasskeyInput) {
+          newPasskeyInput.focus();
+        }
+      });
+    }
+
+    if (cancelAddBtn && addBox) {
+      cancelAddBtn.addEventListener('click', () => {
+        addBox.classList.remove('visible');
+      });
+    }
+
+    if (addForm) {
+      addForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const label = newPasskeyInput ? newPasskeyInput.value : 'My New Passkey';
+        await registerNewPasskey(label);
+        if (newPasskeyInput) newPasskeyInput.value = '';
+        if (addBox) addBox.classList.remove('visible');
+      });
+    }
+
+    const undoBtn = document.getElementById('passkey-undo-btn');
+    if (undoBtn) {
+      undoBtn.addEventListener('click', () => {
+        undoDeletePasskey();
+      });
+    }
+
+    const restoreDefaultsBtn = document.getElementById('restore-default-passkeys-btn');
+    if (restoreDefaultsBtn) {
+      restoreDefaultsBtn.addEventListener('click', () => {
+        resetDefaultPasskeys();
+      });
+    }
+
+    const profileForm = document.getElementById('account-profile-form');
+    if (profileForm) {
+      profileForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const displayNameInput = document.getElementById('account-display-name-input');
+        const emailInput = document.getElementById('account-email-input');
+        const newDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+        const newEmail = emailInput ? emailInput.value.trim() : '';
+
+        if (newDisplayName) state.user.displayName = newDisplayName;
+        if (newEmail) state.user.name = newEmail;
+
+        saveState(state);
+        renderProfile();
+        showFeedback(
+          `Updated account profile for "${state.user.displayName}" and synced user details with browser authenticator.`,
+          false
+        );
+        await syncBrowserAuthenticator({ action: 'user-update', updatedUser: true });
+      });
+    }
+  }
+
+  function init() {
+    renderProfile();
+    renderPasskeys();
+    bindEvents();
+    syncBrowserAuthenticator({ action: 'init', updatedUser: true });
+  }
+
+  window.DailyGrindPasskeys = {
+    getState: () => state,
+    renamePasskey,
+    deletePasskey,
+    registerNewPasskey,
+    syncBrowserAuthenticator,
+    resetDefaultPasskeys
+  };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
