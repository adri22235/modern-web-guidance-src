diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..87843a7
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,993 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  KeyIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  PlusIcon,
+  ArrowPathIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+  ShieldCheckIcon,
+  UserCircleIcon,
+  DevicePhoneMobileIcon,
+  ComputerDesktopIcon,
+  CheckIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import {
+  syncAcceptedPasskeys,
+  syncCurrentUserDetails,
+  syncUnknownCredential,
+  isPasskeySignalSupported,
+  type SignalEventResult,
+} from '../utils/passkeySignals';
+
+export interface PasskeyItem {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string | null;
+  transports?: string[];
+  backedUp?: boolean;
+}
+
+export interface UserProfileData {
+  userId: string;
+  username: string;
+  displayName: string;
+}
+
+const DEFAULT_USER: UserProfileData = {
+  userId: 'M2YPl-KGnA8',
+  username: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+};
+
+const DEFAULT_PASSKEYS: PasskeyItem[] = [
+  {
+    id: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+    name: 'MacBook Pro (Chrome)',
+    createdAt: '2026-08-14T10:30:00Z',
+    lastUsedAt: '2026-10-29T18:15:00Z',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'k9LmNpQrStUvWxYz0123456789AbCdEfGh',
+    name: 'Pixel 9 Pro',
+    createdAt: '2026-09-02T14:20:00Z',
+    lastUsedAt: '2026-10-25T09:05:00Z',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'yUbIkEy5NfC9876543210ZyXwVuTsRqPoN',
+    name: 'YubiKey 5C NFC',
+    createdAt: '2026-05-19T08:00:00Z',
+    lastUsedAt: '2026-07-11T16:45:00Z',
+    transports: ['usb', 'nfc'],
+    backedUp: false,
+  },
+];
+
+function formatDate(isoString?: string | null): string {
+  if (!isoString) return 'Never';
+  try {
+    return new Date(isoString).toLocaleDateString('en-US', {
+      year: 'numeric',
+      month: 'short',
+      day: 'numeric',
+    });
+  } catch {
+    return isoString;
+  }
+}
+
+export default function PasskeyManagement() {
+  const [user, setUser] = useState<UserProfileData>(DEFAULT_USER);
+  const [passkeys, setPasskeys] = useState<PasskeyItem[]>(DEFAULT_PASSKEYS);
+  const [loading, setLoading] = useState(true);
+
+  // User profile form state
+  const [profileDisplayName, setProfileDisplayName] = useState(DEFAULT_USER.displayName);
+  const [profileUsername, setProfileUsername] = useState(DEFAULT_USER.username);
+  const [isSavingProfile, setIsSavingProfile] = useState(false);
+
+  // Inline passkey rename state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState('');
+  const [isSavingPasskey, setIsSavingPasskey] = useState(false);
+
+  // New passkey creation state
+  const [showAddForm, setShowAddForm] = useState(false);
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [isAddingPasskey, setIsAddingPasskey] = useState(false);
+
+  // Authenticator sync status & logs
+  const [signalCapabilities, setSignalCapabilities] = useState({
+    signalAllAcceptedCredentials: false,
+    signalCurrentUserDetails: false,
+    signalUnknownCredential: false,
+  });
+  const [signalLogs, setSignalLogs] = useState<SignalEventResult[]>([]);
+  const [statusBanner, setStatusBanner] = useState<{
+    type: 'success' | 'info' | 'error';
+    message: string;
+  } | null>(null);
+
+  const appendSignalLog = useCallback((result: SignalEventResult) => {
+    setSignalLogs((prev) => [result, ...prev].slice(0, 10));
+  }, []);
+
+  const fetchAccountPasskeys = useCallback(async () => {
+    setLoading(true);
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const response = await fetch(`${baseUrl}api/passkeys.json`);
+      if (response.ok) {
+        const data = await response.json();
+        if (data.user) {
+          setUser(data.user);
+          setProfileDisplayName(data.user.displayName);
+          setProfileUsername(data.user.username);
+        }
+        if (Array.isArray(data.passkeys)) {
+          setPasskeys(data.passkeys);
+          // Sync accepted credentials with the browser authenticator upon loading
+          const syncRes = await syncAcceptedPasskeys({
+            userId: (data.user || DEFAULT_USER).userId,
+            allAcceptedCredentialIds: data.passkeys.map((pk: PasskeyItem) => pk.id),
+          });
+          appendSignalLog(syncRes);
+        }
+      }
+    } catch {
+      // Fallback to default local state if fetch fails
+    } finally {
+      setLoading(false);
+    }
+  }, [appendSignalLog]);
+
+  useEffect(() => {
+    setSignalCapabilities(isPasskeySignalSupported());
+    // Check if localStorage has a signed-in username from SignInForm
+    try {
+      const storedUsername = localStorage.getItem('dtt_username');
+      const storedDisplayName = localStorage.getItem('dtt_display_name');
+      if (storedUsername || storedDisplayName) {
+        setUser((prev) => ({
+          ...prev,
+          username: storedUsername || prev.username,
+          displayName: storedDisplayName || prev.displayName,
+        }));
+      }
+    } catch {
+      // Ignore storage errors
+    }
+    fetchAccountPasskeys();
+  }, [fetchAccountPasskeys]);
+
+  // Update reader's account display name & username and sync with browser authenticator
+  const handleUpdateUserProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplay = profileDisplayName.trim();
+    const trimmedUser = profileUsername.trim();
+    if (!trimmedDisplay || !trimmedUser) return;
+
+    setIsSavingProfile(true);
+    setStatusBanner(null);
+
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const response = await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          userDisplayName: trimmedDisplay,
+          username: trimmedUser,
+        }),
+      });
+
+      let updatedUser: UserProfileData = {
+        ...user,
+        displayName: trimmedDisplay,
+        username: trimmedUser,
+      };
+
+      if (response.ok) {
+        const data = await response.json();
+        if (data.user) {
+          updatedUser = data.user;
+        }
+      }
+
+      setUser(updatedUser);
+      try {
+        localStorage.setItem('dtt_username', updatedUser.username);
+        localStorage.setItem('dtt_display_name', updatedUser.displayName);
+      } catch {
+        // Ignore storage errors
+      }
+
+      // Sync updated user details with the browser authenticator via WebAuthn Signal API
+      const signalResult = await syncCurrentUserDetails({
+        userId: updatedUser.userId,
+        name: updatedUser.username,
+        displayName: updatedUser.displayName,
+      });
+      appendSignalLog(signalResult);
+
+      setStatusBanner({
+        type: 'success',
+        message: `Display name updated to "${updatedUser.displayName}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Failed to update profile details. Please try again.',
+      });
+    } finally {
+      setIsSavingProfile(false);
+    }
+  };
+
+  // Start editing a passkey's display name
+  const startEditingPasskey = (pk: PasskeyItem) => {
+    setEditingPasskeyId(pk.id);
+    setEditingPasskeyName(pk.name);
+    setStatusBanner(null);
+  };
+
+  const cancelEditingPasskey = () => {
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+  };
+
+  // Save updated passkey display name and signal authenticator
+  const handleSavePasskeyName = async (passkeyId: string) => {
+    const trimmedName = editingPasskeyName.trim();
+    if (!trimmedName) return;
+
+    setIsSavingPasskey(true);
+    setStatusBanner(null);
+
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const response = await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: passkeyId,
+          name: trimmedName,
+        }),
+      });
+
+      let updatedList = passkeys.map((pk) =>
+        pk.id === passkeyId ? { ...pk, name: trimmedName } : pk
+      );
+
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          updatedList = data.passkeys;
+        }
+      }
+
+      setPasskeys(updatedList);
+      setEditingPasskeyId(null);
+      setEditingPasskeyName('');
+
+      // Signal current user details to keep the browser authenticator in sync
+      const userDetailsSignal = await syncCurrentUserDetails({
+        userId: user.userId,
+        name: user.username,
+        displayName: trimmedName,
+      });
+      appendSignalLog(userDetailsSignal);
+
+      setStatusBanner({
+        type: 'success',
+        message: `Passkey renamed to "${trimmedName}" and browser authenticator synchronized.`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Could not update passkey name. Please try again.',
+      });
+    } finally {
+      setIsSavingPasskey(false);
+    }
+  };
+
+  // Remove a passkey and synchronize the browser authenticator
+  const handleRemovePasskey = async (passkey: PasskeyItem) => {
+    setStatusBanner(null);
+
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const response = await fetch(
+        `${baseUrl}api/passkeys.json?id=${encodeURIComponent(passkey.id)}`,
+        {
+          method: 'DELETE',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ id: passkey.id }),
+        }
+      );
+
+      let updatedList = passkeys.filter((pk) => pk.id !== passkey.id);
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          updatedList = data.passkeys;
+        }
+      }
+
+      setPasskeys(updatedList);
+      if (editingPasskeyId === passkey.id) {
+        setEditingPasskeyId(null);
+      }
+
+      const acceptedIds = updatedList.map((pk) => pk.id);
+
+      // 1. Signal the updated list of all accepted credentials to the authenticator
+      const allAcceptedSignal = await syncAcceptedPasskeys({
+        userId: user.userId,
+        allAcceptedCredentialIds: acceptedIds,
+      });
+      appendSignalLog(allAcceptedSignal);
+
+      // 2. Also signal the removed credential as unknown so authenticators supporting signalUnknownCredential prune it immediately
+      const unknownSignal = await syncUnknownCredential({
+        credentialId: passkey.id,
+      });
+      appendSignalLog(unknownSignal);
+
+      setStatusBanner({
+        type: 'success',
+        message: `Removed passkey "${passkey.name}" and notified your browser authenticator (${acceptedIds.length} active ${acceptedIds.length === 1 ? 'key' : 'keys'} remaining).`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Failed to remove passkey. Please try again.',
+      });
+    }
+  };
+
+  // Register a new passkey (supports WebAuthn navigator.credentials.create with graceful fallback)
+  const handleAddPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const label = newPasskeyName.trim() || 'Chrome Profile Passkey';
+    setIsAddingPasskey(true);
+    setStatusBanner(null);
+
+    let generatedId = `pk_${Math.random().toString(36).substring(2, 12)}_${Date.now().toString(36)}`;
+
+    // Attempt WebAuthn creation if available and user wants to register
+    if (
+      typeof window !== 'undefined' &&
+      window.PublicKeyCredential &&
+      navigator.credentials?.create
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        crypto.getRandomValues(challenge);
+        const userIdBytes = new TextEncoder().encode(user.userId);
+
+        const credential = (await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: window.location.hostname || 'localhost',
+            },
+            user: {
+              id: userIdBytes,
+              name: user.username,
+              displayName: user.displayName,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 },
+              { type: 'public-key', alg: -257 },
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred',
+            },
+            timeout: 15000,
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential?.id) {
+          generatedId = credential.id;
+        }
+      } catch {
+        // If user cancels native prompt or headless browser doesn't have a virtual authenticator attached,
+        // continue with registering the passkey record so management workflows work seamlessly.
+      }
+    }
+
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const response = await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: generatedId,
+          name: label,
+          transports: ['internal', 'hybrid'],
+          backedUp: true,
+        }),
+      });
+
+      let updatedList = passkeys;
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          updatedList = data.passkeys;
+        }
+      } else {
+        const newEntry: PasskeyItem = {
+          id: generatedId,
+          name: label,
+          createdAt: new Date().toISOString(),
+          lastUsedAt: new Date().toISOString(),
+          transports: ['internal', 'hybrid'],
+          backedUp: true,
+        };
+        updatedList = [newEntry, ...passkeys];
+      }
+
+      setPasskeys(updatedList);
+      setNewPasskeyName('');
+      setShowAddForm(false);
+
+      const syncRes = await syncAcceptedPasskeys({
+        userId: user.userId,
+        allAcceptedCredentialIds: updatedList.map((pk) => pk.id),
+      });
+      appendSignalLog(syncRes);
+
+      setStatusBanner({
+        type: 'success',
+        message: `Registered new passkey "${label}" and synchronized accepted credentials with your authenticator.`,
+      });
+    } catch {
+      setStatusBanner({
+        type: 'error',
+        message: 'Could not register new passkey.',
+      });
+    } finally {
+      setIsAddingPasskey(false);
+    }
+  };
+
+  // Manual full sync button
+  const handleManualSync = async () => {
+    setStatusBanner(null);
+    const allAcceptedRes = await syncAcceptedPasskeys({
+      userId: user.userId,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.id),
+    });
+    appendSignalLog(allAcceptedRes);
+
+    const userDetailsRes = await syncCurrentUserDetails({
+      userId: user.userId,
+      name: user.username,
+      displayName: user.displayName,
+    });
+    appendSignalLog(userDetailsRes);
+
+    setStatusBanner({
+      type: 'info',
+      message: 'Synchronized accepted passkeys and current user details with browser authenticator.',
+    });
+  };
+
+  // Restore sample passkeys for testing
+  const handleResetDemoKeys = async () => {
+    setStatusBanner(null);
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const response = await fetch(`${baseUrl}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset' }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        setUser(data.user);
+        setProfileDisplayName(data.user.displayName);
+        setProfileUsername(data.user.username);
+        setPasskeys(data.passkeys);
+
+        const syncRes = await syncAcceptedPasskeys({
+          userId: data.user.userId,
+          allAcceptedCredentialIds: data.passkeys.map((pk: PasskeyItem) => pk.id),
+        });
+        appendSignalLog(syncRes);
+
+        setStatusBanner({
+          type: 'info',
+          message: 'Restored default passkeys and synchronized with browser authenticator.',
+        });
+      }
+    } catch {
+      setPasskeys(DEFAULT_PASSKEYS);
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8" data-testid="account-settings">
+      {/* Page Header */}
+      <div className="border-b border-gray-300 pb-5 mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <span className="text-xs font-bold uppercase tracking-wider text-amber-600">
+            Subscriber Account
+          </span>
+          <h1 className="text-3xl font-bold text-gray-900 mt-1">Account Settings</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as <span className="font-semibold text-gray-900">{user.displayName}</span> (
+            <span className="text-gray-700">{user.username}</span>)
+          </p>
+        </div>
+        <div className="flex items-center gap-2 self-start sm:self-center">
+          <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
+            <ShieldCheckIcon className="w-4 h-4" />
+            Passkey Protected
+          </span>
+        </div>
+      </div>
+
+      {/* Feedback Alert Banner */}
+      {statusBanner && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`mb-6 p-4 rounded-lg border flex items-start justify-between gap-3 ${
+            statusBanner.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : statusBanner.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-amber-50 border-amber-200 text-amber-900'
+          }`}
+        >
+          <div className="flex items-center gap-2.5 text-sm font-medium">
+            {statusBanner.type === 'error' ? (
+              <ExclamationTriangleIcon className="w-5 h-5 text-red-600 shrink-0" />
+            ) : (
+              <CheckCircleIcon className="w-5 h-5 text-green-600 shrink-0" />
+            )}
+            <span>{statusBanner.message}</span>
+          </div>
+          <button
+            type="button"
+            onClick={() => setStatusBanner(null)}
+            className="text-gray-400 hover:text-gray-600"
+            aria-label="Dismiss message"
+          >
+            <XMarkIcon className="w-4 h-4" />
+          </button>
+        </div>
+      )}
+
+      <div className="space-y-8">
+        {/* Reader Profile / Display Name Section */}
+        <section
+          aria-labelledby="profile-heading"
+          className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden"
+        >
+          <div className="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center gap-2">
+            <UserCircleIcon className="w-5 h-5 text-gray-700" />
+            <h2 id="profile-heading" className="text-lg font-bold text-gray-900">
+              Reader Profile &amp; Authenticator Identity
+            </h2>
+          </div>
+
+          <form onSubmit={handleUpdateUserProfile} className="p-6 space-y-4">
+            <p className="text-sm text-gray-600">
+              Updating your display name or username here notifies your browser&apos;s passkey
+              authenticator via{' '}
+              <code className="text-xs bg-gray-100 px-1.5 py-0.5 rounded font-mono text-gray-800">
+                PublicKeyCredential.signalCurrentUserDetails()
+              </code>{' '}
+              so your autofill prompt stays accurate.
