+export interface SignalAllAcceptedParams {
+  rpId?: string;
+  userId: string;
+  allAcceptedCredentialIds: string[];
+}
+
+export interface SignalCurrentUserDetailsParams {
+  rpId?: string;
+  userId: string;
+  name: string;
+  displayName: string;
+}
+
+export interface SignalUnknownCredentialParams {
+  rpId?: string;
+  credentialId: string;
+}
+
+export interface SignalEventResult {
+  method:
+    | 'signalAllAcceptedCredentials'
+    | 'signalCurrentUserDetails'
+    | 'signalUnknownCredential';
+  supported: boolean;
+  success: boolean;
+  timestamp: string;
+  payload: Record<string, unknown>;
+  error?: string;
+}
+
+export function getRpId(customRpId?: string): string {
+  if (customRpId) return customRpId;
+  if (typeof window !== 'undefined' && window.location?.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+export function isPasskeySignalSupported(): {
+  signalAllAcceptedCredentials: boolean;
+  signalCurrentUserDetails: boolean;
+  signalUnknownCredential: boolean;
+} {
+  if (typeof window === 'undefined' || typeof PublicKeyCredential === 'undefined') {
+    return {
+      signalAllAcceptedCredentials: false,
+      signalCurrentUserDetails: false,
+      signalUnknownCredential: false,
+    };
+  }
+
+  return {
+    signalAllAcceptedCredentials:
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+    signalCurrentUserDetails:
+      typeof PublicKeyCredential.signalCurrentUserDetails === 'function',
+    signalUnknownCredential:
+      typeof PublicKeyCredential.signalUnknownCredential === 'function',
+  };
+}
+
+/**
+ * Synchronizes the complete list of accepted passkey credential IDs for the current user
+ * with the browser's authenticator / password manager via WebAuthn Signal API.
+ */
+export async function syncAcceptedPasskeys({
+  rpId,
+  userId,
+  allAcceptedCredentialIds,
+}: SignalAllAcceptedParams): Promise<SignalEventResult> {
+  const resolvedRpId = getRpId(rpId);
+  const payload = {
+    rpId: resolvedRpId,
+    userId,
+    allAcceptedCredentialIds,
+  };
+
+  if (
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+      return {
+        method: 'signalAllAcceptedCredentials',
+        supported: true,
+        success: true,
+        timestamp: new Date().toISOString(),
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        method: 'signalAllAcceptedCredentials',
+        supported: true,
+        success: false,
+        timestamp: new Date().toISOString(),
+        payload,
+        error: err?.message || String(err),
+      };
+    }
+  }
+
+  return {
+    method: 'signalAllAcceptedCredentials',
+    supported: false,
+    success: false,
+    timestamp: new Date().toISOString(),
+    payload,
+  };
+}
+
+/**
+ * Synchronizes updated user account details (username and displayName)
+ * with the browser's authenticator / password manager via WebAuthn Signal API.
+ */
+export async function syncCurrentUserDetails({
+  rpId,
+  userId,
+  name,
+  displayName,
+}: SignalCurrentUserDetailsParams): Promise<SignalEventResult> {
+  const resolvedRpId = getRpId(rpId);
+  const payload = {
+    rpId: resolvedRpId,
+    userId,
+    name,
+    displayName,
+  };
+
+  if (
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails(payload);
+      return {
+        method: 'signalCurrentUserDetails',
+        supported: true,
+        success: true,
+        timestamp: new Date().toISOString(),
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        method: 'signalCurrentUserDetails',
+        supported: true,
+        success: false,
+        timestamp: new Date().toISOString(),
+        payload,
+        error: err?.message || String(err),
+      };
+    }
+  }
+
+  return {
+    method: 'signalCurrentUserDetails',
+    supported: false,
+    success: false,
+    timestamp: new Date().toISOString(),
+    payload,
+  };
+}
+
+/**
+ * Signals to the browser's authenticator that a specific credential ID is no longer recognized.
+ */
+export async function syncUnknownCredential({
+  rpId,
+  credentialId,
+}: SignalUnknownCredentialParams): Promise<SignalEventResult> {
+  const resolvedRpId = getRpId(rpId);
+  const payload = {
+    rpId: resolvedRpId,
+    credentialId,
+  };
+
+  if (
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalUnknownCredential === 'function'
+  ) {
+    try {
+      await PublicKeyCredential.signalUnknownCredential(payload);
+      return {
+        method: 'signalUnknownCredential',
+        supported: true,
+        success: true,
+        timestamp: new Date().toISOString(),
+        payload,
+      };
+    } catch (err: any) {
+      return {
+        method: 'signalUnknownCredential',
+        supported: true,
+        success: false,
+        timestamp: new Date().toISOString(),
+        payload,
+        error: err?.message || String(err),
+      };
+    }
+  }
+
+  return {
+    method: 'signalUnknownCredential',
+    supported: false,
+    success: false,
+    timestamp: new Date().toISOString(),
+    payload,
+  };
+}
