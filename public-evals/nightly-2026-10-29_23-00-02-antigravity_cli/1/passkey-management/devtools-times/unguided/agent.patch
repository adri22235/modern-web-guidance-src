new file mode 100644
index 0000000..1c22286
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,192 @@
+import type { APIRoute } from 'astro';
+
+export interface PasskeyRecord {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string | null;
+  transports?: string[];
+  backedUp?: boolean;
+}
+
+export interface UserProfile {
+  userId: string;
+  username: string;
+  displayName: string;
+}
+
+const DEFAULT_PASSKEYS: PasskeyRecord[] = [
+  {
+    id: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+    name: 'MacBook Pro (Chrome)',
+    createdAt: '2026-08-14T10:30:00Z',
+    lastUsedAt: '2026-10-29T18:15:00Z',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'k9LmNpQrStUvWxYz0123456789AbCdEfGh',
+    name: 'Pixel 9 Pro',
+    createdAt: '2026-09-02T14:20:00Z',
+    lastUsedAt: '2026-10-25T09:05:00Z',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'yUbIkEy5NfC9876543210ZyXwVuTsRqPoN',
+    name: 'YubiKey 5C NFC',
+    createdAt: '2026-05-19T08:00:00Z',
+    lastUsedAt: '2026-07-11T16:45:00Z',
+    transports: ['usb', 'nfc'],
+    backedUp: false,
+  },
+];
+
+const DEFAULT_USER: UserProfile = {
+  userId: 'M2YPl-KGnA8',
+  username: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+};
+
+async function getState(session: any): Promise<{ user: UserProfile; passkeys: PasskeyRecord[] }> {
+  const user: UserProfile = (await session?.get('user')) || DEFAULT_USER;
+  const passkeys: PasskeyRecord[] = (await session?.get('passkeys')) || DEFAULT_PASSKEYS;
+  return { user, passkeys };
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const { user, passkeys } = await getState(session);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  const { user, passkeys } = await getState(session);
+
+  if (body.action === 'reset') {
+    await session?.set('user', DEFAULT_USER);
+    await session?.set('passkeys', DEFAULT_PASSKEYS);
+    return new Response(
+      JSON.stringify({
+        user: DEFAULT_USER,
+        passkeys: DEFAULT_PASSKEYS,
+        allAcceptedCredentialIds: DEFAULT_PASSKEYS.map((pk) => pk.id),
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const newPasskey: PasskeyRecord = {
+    id: body.id || body.credentialId || `pk_${Date.now().toString(36)}`,
+    name: (body.name || body.displayName || 'New Passkey').trim(),
+    createdAt: new Date().toISOString(),
+    lastUsedAt: new Date().toISOString(),
+    transports: body.transports || ['internal', 'hybrid'],
+    backedUp: body.backedUp ?? true,
+  };
+
+  const updatedPasskeys = [newPasskey, ...passkeys.filter((pk) => pk.id !== newPasskey.id)];
+  await session?.set('passkeys', updatedPasskeys);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkey: newPasskey,
+      passkeys: updatedPasskeys,
+      allAcceptedCredentialIds: updatedPasskeys.map((pk) => pk.id),
+    }),
+    {
+      status: 201,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  let { user, passkeys } = await getState(session);
+
+  // Support updating passkey display name and/or user displayName / username
+  const targetId = body.id || body.credentialId;
+  const newName = (body.name ?? body.displayName ?? '').trim();
+
+  if (targetId && newName) {
+    passkeys = passkeys.map((pk) => (pk.id === targetId ? { ...pk, name: newName } : pk));
+    await session?.set('passkeys', passkeys);
+  }
+
+  if (body.userDisplayName !== undefined || body.username !== undefined || (!targetId && newName)) {
+    user = {
+      ...user,
+      username: body.username !== undefined ? body.username.trim() : user.username,
+      displayName:
+        body.userDisplayName !== undefined
+          ? body.userDisplayName.trim()
+          : !targetId && newName
+          ? newName
+          : user.displayName,
+    };
+    await session?.set('user', user);
+  }
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((pk) => pk.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const PUT: APIRoute = PATCH;
+
+export const DELETE: APIRoute = async ({ request, url, session }) => {
+  let targetId = url.searchParams.get('id') || url.searchParams.get('credentialId');
+  if (!targetId) {
+    try {
+      const body = await request.json();
+      targetId = body.id || body.credentialId;
+    } catch {
+      // Ignore JSON parse error if no body
+    }
+  }
+
+  if (!targetId) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const { user, passkeys } = await getState(session);
+  const updatedPasskeys = passkeys.filter((pk) => pk.id !== targetId);
+  await session?.set('passkeys', updatedPasskeys);
+
+  return new Response(
+    JSON.stringify({
+      removedCredentialId: targetId,
+      user,
+      passkeys: updatedPasskeys,
+      allAcceptedCredentialIds: updatedPasskeys.map((pk) => pk.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
