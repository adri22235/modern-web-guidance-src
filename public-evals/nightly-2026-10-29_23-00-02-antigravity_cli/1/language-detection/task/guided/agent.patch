+  <script>
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const resultContainer = document.getElementById('detection-result');
+
+    const languageNames = new Intl.DisplayNames(['en'], { type: 'language' });
+
+    function getLanguageName(code) {
+      if (!code) return 'Unknown';
+      try {
+        return languageNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    async function initLanguageDetection() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        resultContainer.textContent = 'Client-side language detection is currently unsupported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          detectBtn.disabled = true;
+          resultContainer.textContent = 'Language detection model is unavailable on this device.';
+          return;
+        }
+
+        let detector = null;
+
+        detectBtn.addEventListener('click', async () => {
+          const text = feedbackTextarea.value.trim();
+          if (!text) {
+            resultContainer.textContent = 'Please enter a feedback message first.';
+            return;
+          }
+
+          detectBtn.disabled = true;
+
+          try {
+            if (!detector) {
+              detector = await LanguageDetector.create({
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    const percent = Math.round(e.loaded * 100);
+                    resultContainer.textContent = `Downloading language model: ${percent}%`;
+                  });
+                },
+              });
+            }
+
+            const results = await detector.detect(text);
+            if (results && results.length > 0) {
+              const topResult = results[0];
+              const langName = getLanguageName(topResult.detectedLanguage);
+              const confidencePct = (topResult.confidence * 100).toFixed(1);
+              resultContainer.textContent = `Detected Language: ${langName} (${topResult.detectedLanguage}) — Confidence: ${confidencePct}%`;
+            } else {
+              resultContainer.textContent = 'Could not determine the language of the message.';
+            }
+          } catch (error) {
+            resultContainer.textContent = `Error detecting language: ${error.message || 'Unknown error'}`;
+          } finally {
+            detectBtn.disabled = false;
+          }
+        });
+      } catch (error) {
+        detectBtn.disabled = true;
+        resultContainer.textContent = 'Failed to check language detection availability.';
+      }
+    }
+
+    initLanguageDetection();
+  </script>
+
 </body>
 
