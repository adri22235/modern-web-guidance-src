+  <script>
+    const messageInput = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const progressContainer = document.getElementById('download-progress');
+    const progressText = document.getElementById('progress-text');
+    const progressBar = document.getElementById('progress-bar');
+    const resultContainer = document.getElementById('detection-result');
+
+    let detectorInstance = null;
+    const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+
+    function showResult(html) {
+      resultContainer.innerHTML = html;
+      resultContainer.classList.add('visible');
+    }
+
+    function updateDownloadProgress(percent) {
+      progressContainer.classList.add('visible');
+      progressBar.value = percent;
+      progressText.textContent = `Downloading language model: ${percent}%`;
+    }
+
+    function hideDownloadProgress() {
+      progressContainer.classList.remove('visible');
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = messageInput.value.trim();
+      if (!text) {
+        showResult('Please enter a feedback message to detect its language.');
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        showResult('The built-in Language Detector API is not supported in this browser.');
+        return;
+      }
+
+      detectBtn.disabled = true;
+      resultContainer.classList.remove('visible');
+
+      try {
+        const availability = await LanguageDetector.availability();
+
+        if (availability === 'unavailable') {
+          showResult('Language detection is currently unavailable on this device.');
+          return;
+        }
+
+        if (!detectorInstance) {
+          if (availability === 'available') {
+            detectorInstance = await LanguageDetector.create();
+          } else {
+            // 'downloadable' or 'downloading'
+            updateDownloadProgress(0);
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const rawRatio = e.total && e.total > 0 ? e.loaded / e.total : e.loaded;
+                  const percent = Math.round(rawRatio * 100);
+                  updateDownloadProgress(percent);
+                });
+              }
+            });
+            if (detectorInstance.ready) {
+              await detectorInstance.ready;
+            }
+            hideDownloadProgress();
+          }
+        }
+
+        const results = await detectorInstance.detect(text);
+
+        if (!results || results.length === 0) {
+          showResult('Could not determine the language of the message.');
+          return;
+        }
+
+        const topResult = results[0];
+        const languageCode = topResult.detectedLanguage;
+        let languageName = languageCode;
+        try {
+          languageName = displayNames.of(languageCode) || languageCode;
+        } catch {
+          languageName = languageCode;
+        }
+
+        const confidencePercent = (topResult.confidence * 100).toFixed(1);
+        showResult(
+          `<strong>Detected Language:</strong> ${languageName} (${languageCode})<br>` +
+          `<strong>Confidence:</strong> ${confidencePercent}%`
+        );
+      } catch (error) {
+        hideDownloadProgress();
+        showResult(`Error detecting language: ${error.message || error}`);
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
+
