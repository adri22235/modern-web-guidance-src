@@ -206,7 +206,141 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const TELEMETRY_ENDPOINT = '/api/telemetry';
+      const DEBOUNCE_DELAY_MS = 1000;
+      const MAX_BATCH_SIZE = 20;
+
+      const sessionId = (typeof crypto !== 'undefined' && crypto.randomUUID)
+        ? crypto.randomUUID()
+        : 'sess-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 9);
+
+      let eventQueue = [];
+      let debounceTimer = null;
+
+      function flushEvents(useBeacon = false) {
+        if (debounceTimer) {
+          clearTimeout(debounceTimer);
+          debounceTimer = null;
+        }
+        if (eventQueue.length === 0) return;
+
+        const batch = eventQueue.splice(0, eventQueue.length);
+        const payload = JSON.stringify({
+          sessionId: sessionId,
+          sentAt: new Date().toISOString(),
+          page: window.location.pathname,
+          events: batch
+        });
+
+        if (useBeacon && navigator.sendBeacon) {
+          const blob = new Blob([payload], { type: 'application/json' });
+          if (navigator.sendBeacon(TELEMETRY_ENDPOINT, blob)) {
+            return;
+          }
+        }
+
+        fetch(TELEMETRY_ENDPOINT, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: payload,
+          keepalive: true
+        }).catch(function () {
+          // Silently ignore telemetry transport errors
+        });
+      }
+
+      function scheduleFlush() {
+        if (eventQueue.length >= MAX_BATCH_SIZE) {
+          flushEvents(false);
+          return;
+        }
+        if (debounceTimer) {
+          clearTimeout(debounceTimer);
+        }
+        debounceTimer = setTimeout(function () {
+          debounceTimer = null;
+          if (typeof requestIdleCallback === 'function') {
+            requestIdleCallback(function () {
+              flushEvents(false);
+            }, { timeout: 2000 });
+          } else {
+            flushEvents(false);
+          }
+        }, DEBOUNCE_DELAY_MS);
+      }
+
+      function recordEvent(type, data) {
+        eventQueue.push(Object.assign({
+          type: type,
+          timestamp: new Date().toISOString(),
+          url: window.location.href,
+          path: window.location.pathname
+        }, data));
+        scheduleFlush();
+      }
+
+      // Record initial page view
+      function trackPageView() {
+        recordEvent('pageview', {
+          title: document.title,
+          referrer: document.referrer || null,
+          viewport: window.innerWidth + 'x' + window.innerHeight
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', trackPageView);
+      } else {
+        trackPageView();
+      }
+
+      // Record user click interactions
+      document.addEventListener('click', function (event) {
+        const target = event.target instanceof Element ? event.target : null;
+        if (!target) return;
+
+        const interactiveEl = target.closest('a, button, .btn, .card, nav, header, footer') || target;
+        const anchor = target.closest('a');
+
+        recordEvent('click', {
+          tagName: interactiveEl.tagName.toLowerCase(),
+          id: interactiveEl.id || null,
+          className: typeof interactiveEl.className === 'string' && interactiveEl.className.trim()
+            ? interactiveEl.className.trim()
+            : null,
+          text: (interactiveEl.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 100) || null,
+          href: anchor ? anchor.getAttribute('href') : null,
+          coordinates: {
+            x: event.clientX,
+            y: event.clientY,
+            pageX: event.pageX,
+            pageY: event.pageY
+          }
+        });
+      }, { capture: true, passive: true });
+
+      // Flush remaining buffered events when the page is hidden or unloaded
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'hidden') {
+          flushEvents(true);
+        }
+      });
+
+      window.addEventListener('pagehide', function () {
+        flushEvents(true);
+      });
+
+      // Expose analytics helper for testing / inspection
+      window.DailyGrindAnalytics = {
+        recordEvent: recordEvent,
+        flush: flushEvents,
+        getQueue: function () { return eventQueue.slice(); }
+      };
+    })();
+  </script>
 </body>
 
 </html>
