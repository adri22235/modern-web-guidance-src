diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,70 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Video Landing Page</title>
+
+  <!-- Elevate priority for the video poster image (LCP candidate) -->
+  <link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+
+  <!-- Preload critical header font (fonts are high priority by default; always include crossorigin) -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+
+  <!-- Deprioritize secondary font preload to avoid network contention with LCP and critical font -->
+  <link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+  <!-- Inline critical styles directly in head to avoid render-blocking CSS requests -->
+  <style>
+    @font-face {
+      font-family: 'Brand Font';
+      src: url('brand-font.woff2') format('woff2');
+      font-display: swap;
+    }
+
+    @font-face {
+      font-family: 'Secondary Font';
+      src: url('secondary-font.woff2') format('woff2');
+      font-display: swap;
+    }
+
+    body {
+      margin: 0;
+      padding: 2rem;
+      font-family: 'Secondary Font', system-ui, sans-serif;
+      font-size-adjust: from-font;
+    }
+
+    header h1 {
+      font-family: 'Brand Font', system-ui, sans-serif;
+      font-size-adjust: from-font;
+      margin: 0 0 1rem;
+    }
+
+    video {
+      max-width: 100%;
+      height: auto;
+      display: block;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Featured Video</h1>
+  </header>
+  <main>
+    <video
+      controls
+      width="1280"
+      height="720"
+      poster="poster.jpg"
+      preload="none"
+    >
+      <source src="video.webm" type="video/webm">
+      <source src="video.mp4" type="video/mp4">
+      <track src="captions.vtt" kind="captions" srclang="en" label="English">
+    </video>
+    <p>Watch the presentation above.</p>
+  </main>
+</body>
+</html>
