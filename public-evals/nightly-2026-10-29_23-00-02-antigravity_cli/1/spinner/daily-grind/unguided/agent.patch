+  <script>
+    (function () {
+      const announcer = document.getElementById('status-announcer');
+      const actionButtons = document.querySelectorAll('.hero .btn, #seasonal-favorites .btn');
+
+      function activateLoadingState(btn, event) {
+        if (event) {
+          event.preventDefault();
+        }
+        if (btn.getAttribute('aria-busy') === 'true') {
+          return;
+        }
+
+        btn.classList.add('is-loading', 'loading');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.dataset.loading = 'true';
+
+        const card = btn.closest('.card');
+        if (card) {
+          card.classList.add('is-loading', 'loading');
+          card.setAttribute('aria-busy', 'true');
+          card.dataset.loading = 'true';
+        }
+
+        const section = btn.closest('section');
+        if (section) {
+          section.classList.add('is-loading', 'loading');
+          section.setAttribute('aria-busy', 'true');
+          section.dataset.loading = 'true';
+        }
+
+        const hero = btn.closest('.hero');
+        if (hero) {
+          hero.classList.add('is-loading', 'loading');
+          hero.setAttribute('aria-busy', 'true');
+          hero.dataset.loading = 'true';
+        }
+
+        const message = btn.getAttribute('data-loading-text') || 'Loading, please wait...';
+        if (announcer) {
+          announcer.textContent = message;
+        }
+      }
+
+      actionButtons.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          activateLoadingState(btn, event);
+        });
+
+        btn.addEventListener('keydown', function (event) {
+          if (event.key === ' ') {
+            activateLoadingState(btn, event);
+          }
+        });
+      });
+    })();
+  </script>
