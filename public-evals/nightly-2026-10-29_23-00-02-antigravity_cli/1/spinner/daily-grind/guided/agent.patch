+  <script>
+    const orderNowBtn = document.getElementById('order-now-btn');
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', () => {
+        if (orderNowBtn.disabled) return;
+        const spinner = orderNowBtn.querySelector('.loading-spinner');
+        const label = orderNowBtn.querySelector('.btn-label');
+
+        orderNowBtn.disabled = true;
+        orderNowBtn.setAttribute('aria-busy', 'true');
+        if (spinner) spinner.hidden = false;
+        if (label) label.textContent = 'Starting Order...';
+      });
+    }
+
+    const seasonalSection = document.getElementById('seasonal-favorites');
+    const detailButtons = document.querySelectorAll('.view-details-btn');
+
+    detailButtons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        if (btn.disabled) return;
+        const card = btn.closest('.card');
+        const drinkName = btn.dataset.drinkName || 'drink';
+        const btnSpinner = btn.querySelector('.loading-spinner');
+        const cardSpinner = card ? card.querySelector('.drink-details .loading-spinner') : null;
+        const detailsContent = card ? card.querySelector('.details-content') : null;
+        const label = btn.querySelector('.btn-label');
+
+        btn.disabled = true;
+        btn.setAttribute('aria-busy', 'true');
+        if (card) card.setAttribute('aria-busy', 'true');
+        if (seasonalSection) seasonalSection.setAttribute('aria-busy', 'true');
+
+        if (detailsContent) detailsContent.hidden = true;
+        if (btnSpinner) btnSpinner.hidden = false;
+        if (cardSpinner) cardSpinner.hidden = false;
+        if (label) {
+          label.innerHTML = `Loading Details... <span class="visually-hidden">for ${drinkName}</span>`;
+        }
+
+        setTimeout(() => {
+          if (btnSpinner) btnSpinner.hidden = true;
+          if (cardSpinner) cardSpinner.hidden = true;
+          if (detailsContent) detailsContent.hidden = false;
+
+          btn.disabled = false;
+          btn.setAttribute('aria-busy', 'false');
+          if (card) card.setAttribute('aria-busy', 'false');
+          if (seasonalSection && !seasonalSection.querySelector('.view-details-btn[aria-busy="true"]')) {
+            seasonalSection.setAttribute('aria-busy', 'false');
+          }
+          if (label) {
+            label.innerHTML = `View Details <span class="visually-hidden">for ${drinkName}</span>`;
+          }
+        }, 2500);
+      });
+    });
+  </script>
