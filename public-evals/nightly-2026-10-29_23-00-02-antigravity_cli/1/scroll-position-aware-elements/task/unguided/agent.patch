+  <script>
+    (function () {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = document.querySelector('.scroll-sentinel');
+      const backToTop = document.querySelector('.back-to-top');
+
+      if (!scroller || !backToTop) return;
+
+      if (sentinel && 'IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            entries.forEach((entry) => {
+              const isAtTop = entry.isIntersecting;
+              backToTop.classList.toggle('visible', !isAtTop);
+              backToTop.classList.toggle('is-visible', !isAtTop);
+              backToTop.inert = isAtTop;
+              if (isAtTop) {
+                backToTop.setAttribute('aria-hidden', 'true');
+              } else {
+                backToTop.removeAttribute('aria-hidden');
+              }
+            });
+          },
+          {
+            root: scroller,
+            threshold: 0,
+          }
+        );
+
+        observer.observe(sentinel);
+      }
+
+      backToTop.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: 'smooth' });
+      });
+    })();
+  </script>
+
