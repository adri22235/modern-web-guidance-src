+  <script>
+    (() => {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const confirmation = document.getElementById('order-confirmation');
+      const supportsUserInvalid = typeof CSS !== 'undefined' && CSS.supports('selector(:user-invalid)');
+
+      // Synchronize aria-invalid with the visual :user-invalid / fallback state
+      const syncAriaState = (el) => {
+        if (!el || !el.matches || !el.matches('input, textarea, select')) return;
+        const isUserInvalid =
+          (supportsUserInvalid && el.matches(':user-invalid')) ||
+          el.classList.contains('user-invalid-fallback');
+
+        if (isUserInvalid) {
+          el.setAttribute('aria-invalid', 'true');
+        } else {
+          el.removeAttribute('aria-invalid');
+        }
+      };
+
+      // Listen on capture phase for blur/focus and invalid events
+      document.addEventListener('blur', (event) => syncAriaState(event.target), true);
+      document.addEventListener('focus', (event) => syncAriaState(event.target), true);
+
+      // Update immediately on input/change if an error is already shown or when changed
+      const handleImmediateChange = (event) => {
+        const el = event.target;
+        if (!el || !el.matches || !el.matches('input, textarea, select')) return;
+        if (el.hasAttribute('aria-invalid') || event.type === 'change') {
+          syncAriaState(el);
+        }
+        if (confirmation) {
+          confirmation.classList.remove('visible');
+          confirmation.textContent = '';
+        }
+      };
+
+      document.addEventListener('input', handleImmediateChange);
+      document.addEventListener('change', handleImmediateChange);
+
+      // Sync when browser fires 'invalid' during a submission attempt
+      form.addEventListener('invalid', (event) => {
+        const el = event.target;
+        if (!supportsUserInvalid && el.checkValidity) {
+          el.classList.add('user-invalid-fallback');
+          el.classList.remove('user-valid-fallback');
+        }
+        el.setAttribute('aria-invalid', 'true');
+      }, true);
+
+      // Fallback for browsers that do not support :user-invalid
+      const UserInvalidFallback = (() => {
+        const dirtyState = new WeakMap();
+
+        const updateState = (input) => {
+          const isValid = input.checkValidity();
+          input.classList.toggle('user-invalid-fallback', !isValid);
+          input.classList.toggle('user-valid-fallback', isValid);
+          if (!isValid) {
+            input.setAttribute('aria-invalid', 'true');
+          } else {
+            input.removeAttribute('aria-invalid');
+          }
+        };
+
+        const handleEvent = (event) => {
+          const input = event.target;
+
+          if (event.type === 'reset') {
+            const controls = input.elements || [];
+            for (const control of controls) {
+              dirtyState.delete(control);
+              control.classList.remove('user-invalid-fallback');
+              control.classList.remove('user-valid-fallback');
+              control.removeAttribute('aria-invalid');
+            }
+            return;
+          }
+
+          if (!input || !input.checkValidity) return;
+
+          if (event.type === 'input' || event.type === 'change') {
+            const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
+            state.hasInteracted = true;
+            dirtyState.set(input, state);
+            if (state.hasBlurred || input.classList.contains('user-invalid-fallback')) {
+              updateState(input);
+            }
+          } else if (event.type === 'blur') {
+            const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
+            state.hasBlurred = true;
+            dirtyState.set(input, state);
+            if (state.hasInteracted) {
+              updateState(input);
+            }
+          }
+        };
+
+        const init = (root = document) => {
+          if (supportsUserInvalid) return;
+          root.addEventListener('blur', handleEvent, true);
+          root.addEventListener('input', handleEvent);
+          root.addEventListener('change', handleEvent);
+          root.addEventListener('reset', handleEvent, true);
+        };
+
+        return { init };
+      })();
+
+      UserInvalidFallback.init(form);
+
+      // Handle form submission
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.checkValidity()) {
+          form.querySelectorAll('input, select, textarea').forEach(syncAriaState);
+          return;
+        }
+        syncAriaState(shopSelect);
+        const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+        if (confirmation && selectedOption) {
+          confirmation.textContent = `Shop selected: ${selectedOption.text}. Ready to customize your order!`;
+          confirmation.classList.add('visible');
+        }
+      });
+    })();
+  </script>
