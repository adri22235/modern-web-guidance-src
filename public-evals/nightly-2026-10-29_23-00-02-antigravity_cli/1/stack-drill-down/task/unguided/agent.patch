+            } else if (entry.level === 2) {
+              screenEl = createSubDetailScreenElement(entry);
+            }
+            if (screenEl) {
+              if (animateDirection === 'push' && index === targetStack.length - 1) {
+                screenEl.dataset.stackState = 'entering';
+              }
+              stackViewport.appendChild(screenEl);
+            }
+          }
+        });
