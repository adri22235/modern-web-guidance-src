+          const stillInStack = targetStack.some(e => e.route === route);
+          if (!stillInStack) {
+            screenEl.style.transform = '';
+            screenEl.style.opacity = '';
+            screenEl.classList.remove('is-dragging');
+            if (animateDirection === 'pop') {
+              screenEl.dataset.stackState = 'leaving';
