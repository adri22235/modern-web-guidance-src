+          const prevOffset = -28 * (1 - progress);
+          const prevScale = 0.985 + (0.015 * progress);
+          gestureState.prevScreen.style.transform = `translate3d(${prevOffset}%, 0, 0) scale(${prevScale})`;
+          gestureState.prevScreen.style.opacity = String(0.65 + 0.35 * progress);
+        }
+
+        const pillOffset = Math.min(28, -48 + clampedX * 0.45);
+        swipeFeedbackPill.classList.add('visible');
+        swipeFeedbackPill.style.transform = `translateY(-50%) translateX(${pillOffset}px) scale(${0.85 + progress * 0.25})`;
+      }
+
+      function endSwipeGesture() {
+        if (!gestureState) return;
+        const state = gestureState;
+        gestureState = null;
+
+        swipeFeedbackPill.classList.remove('visible');
+        swipeFeedbackPill.style.transform = '';
+
+        if (!state.isHorizontalSwipe || state.canceled) {
+          state.activeScreen.classList.remove('is-dragging');
+          state.activeScreen.style.transform = '';
+          if (state.prevScreen) {
+            state.prevScreen.classList.remove('is-dragging');
+            state.prevScreen.style.transform = '';
+            state.prevScreen.style.opacity = '';
+          }
+          return;
+        }
+
+        const deltaX = Math.max(0, state.currentX - state.startX);
+        const elapsed = Math.max(1, performance.now() - state.startTime);
+        const velocity = deltaX / elapsed; // px per ms
+        const shouldPop = deltaX > state.viewportWidth * 0.22 || deltaX > 95 || (deltaX > 35 && velocity > 0.45);
+
+        state.activeScreen.classList.remove('is-dragging');
+        if (state.prevScreen) {
+          state.prevScreen.classList.remove('is-dragging');
+        }
+
+        if (shouldPop) {
+          popStack();
+        } else {
+          // Spring back to active position
+          state.activeScreen.style.transform = '';
+          if (state.prevScreen) {
+            state.prevScreen.style.transform = '';
+            state.prevScreen.style.opacity = '';
+          }
+        }
+      }
+
+      // Touch event listeners on stackViewport
+      stackViewport.addEventListener('touchstart', function (e) {
+        if (e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        const fromEdge = touch.clientX <= 44 || e.target === edgeSwipeZone;
+        startSwipeGesture(touch.clientX, touch.clientY, fromEdge);
+      }, { passive: true });
+
+      stackViewport.addEventListener('touchmove', function (e) {
+        if (!gestureState || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        moveSwipeGesture(touch.clientX, touch.clientY);
+      }, { passive: true });
+
+      stackViewport.addEventListener('touchend', endSwipeGesture);
+      stackViewport.addEventListener('touchcancel', endSwipeGesture);
+
+      // Mouse / Pointer drag support (from edge zone or horizontal drag on detail screen)
+      stackViewport.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'touch') return; // handled by touch events
+        if (e.button !== 0) return;
+        const isInteractiveControl = e.target.closest('button, a, input, select, textarea');
+        const fromEdge = e.target === edgeSwipeZone || e.clientX <= 44;
+        if (isInteractiveControl && !fromEdge) return;
+        startSwipeGesture(e.clientX, e.clientY, fromEdge);
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (!gestureState || e.pointerType === 'touch') return;
+        moveSwipeGesture(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', function (e) {
+        if (!gestureState || e.pointerType === 'touch') return;
+        endSwipeGesture();
+      });
+
+      // Initial Boot: Hydrate stack from current URL (supports deep links via path, query, or hash)
+      const initialStack = parseLocationToStack(window.location);
+      window.history.replaceState(
+        { stackRoutes: initialStack.map(s => s.route), depth: initialStack.length - 1 },
+        '',
+        window.location.pathname + window.location.search + window.location.hash
+      );
+      syncStackDOM(initialStack, 'none');
+    })();
+  </script>
 </body>
 
