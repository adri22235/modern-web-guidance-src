index 0000000..e2db22c
--- /dev/null
+++ b/src/components/SmallptRenderer.tsx
@@ -0,0 +1,302 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  name: string;
+  index: number;
+  rgb: [number, number, number];
+}
+
+const SPHERE_LABELS: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+const DEFAULT_COLORS: [number, number, number][] = [
+  [0.75, 0.25, 0.25],
+  [0.25, 0.25, 0.75],
+  [0.75, 0.75, 0.75],
+  [0, 0, 0],
+  [0.75, 0.75, 0.75],
+  [0.75, 0.75, 0.75],
+  [0.999, 0.999, 0.999],
+  [0.999, 0.999, 0.999],
+  [0, 0, 0],
+];
+
+function toCssRgb(rgb: [number, number, number]): string {
+  const toGamma = (v: number) =>
+    Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255);
+  return `rgb(${toGamma(rgb[0])}, ${toGamma(rgb[1])}, ${toGamma(rgb[2])})`;
+}
+
+export default function SmallptRenderer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobIdRef = useRef<number>(0);
+
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [progress, setProgress] = useState<number>(0);
+  const [elapsedMs, setElapsedMs] = useState<number>(0);
+  const [samps, setSamps] = useState<number>(2); // 2 * 4 = 8 samples per pixel
+  const [resolution, setResolution] = useState<{ width: number; height: number }>({
+    width: 320,
+    height: 240,
+  });
+  const [sphereColors, setSphereColors] =
+    useState<[number, number, number][]>(DEFAULT_COLORS);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+
+  const startRender = useCallback(
+    (options: {
+      randomize?: boolean;
+      resetDefault?: boolean;
+      width?: number;
+      height?: number;
+      samps?: number;
+    } = {}) => {
+      const targetWidth = options.width ?? resolution.width;
+      const targetHeight = options.height ?? resolution.height;
+      const targetSamps = options.samps ?? samps;
+
+      // Terminate any in-flight worker if currently rendering so new click starts immediately
+      if (workerRef.current) {
+        workerRef.current.terminate();
+        workerRef.current = null;
+      }
+
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+      const workerUrl = new URL(
+        `${normalizedBase}wasm/smallpt-worker.js`,
+        window.location.origin,
+      );
+
+      const worker = new Worker(workerUrl, { type: 'module' });
+      workerRef.current = worker;
+
+      const currentJobId = ++jobIdRef.current;
+      setIsRendering(true);
+      setProgress(0);
+      setErrorMsg(null);
+
+      worker.onmessage = (e: MessageEvent) => {
+        const data = e.data;
+        if (data.jobId !== currentJobId) return;
+
+        if (data.type === 'error') {
+          setErrorMsg(data.message || 'WebAssembly path tracer error');
+          setIsRendering(false);
+          return;
+        }
+
+        if (data.type === 'progress' || data.type === 'complete') {
+          const canvas = canvasRef.current;
+          if (canvas && data.pixels) {
+            if (canvas.width !== data.width || canvas.height !== data.height) {
+              canvas.width = data.width;
+              canvas.height = data.height;
+            }
+            const ctx = canvas.getContext('2d');
+            if (ctx) {
+              const imgData = new ImageData(
+                new Uint8ClampedArray(data.pixels),
+                data.width,
+                data.height,
+              );
+              ctx.putImageData(imgData, 0, 0);
+            }
+          }
+
+          if (Array.isArray(data.sphereColors)) {
+            setSphereColors(data.sphereColors);
+          }
+
+          setElapsedMs(Math.round(data.elapsedMs));
+          setProgress(Math.round((data.completedRows / data.height) * 100));
+
+          if (data.type === 'complete') {
+            setIsRendering(false);
+          }
+        }
+      };
+
+      worker.onerror = (err) => {
+        setErrorMsg(err.message || 'Failed to run WebAssembly worker');
+        setIsRendering(false);
+      };
+
+      const seed = (Math.random() * 0xffffffff) >>> 0;
+      worker.postMessage({
+        jobId: currentJobId,
+        width: targetWidth,
+        height: targetHeight,
+        samps: targetSamps,
+        randomize: Boolean(options.randomize),
+        resetDefault: Boolean(options.resetDefault),
+        seed,
+        chunkRows: 24,
+      });
+    },
+    [resolution.width, resolution.height, samps],
+  );
+
+  useEffect(() => {
+    startRender({ resetDefault: true });
+    return () => {
+      if (workerRef.current) {
+        workerRef.current.terminate();
+        workerRef.current = null;
+      }
+    };
+  }, []);
+
+  const handleRandomize = () => {
+    startRender({ randomize: true });
+  };
+
+  const handleResetDefault = () => {
+    startRender({ resetDefault: true });
+  };
+
+  const activePalette: SphereColorInfo[] = SPHERE_LABELS.map((item) => ({
+    ...item,
+    rgb: sphereColors[item.index] || [0.75, 0.75, 0.75],
+  }));
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      aria-labelledby="smallpt-heading"
+      className="bg-white border border-gray-200 shadow-sm rounded-lg p-6 my-6"
+    >
+      <div className="flex flex-col lg:flex-row gap-6 items-start">
+        {/* Left column: Canvas Output */}
+        <div className="w-full lg:w-auto flex-shrink-0 flex flex-col items-center">
+          <div className="relative rounded-md overflow-hidden border border-gray-800 bg-black shadow-md">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={resolution.width}
+              height={resolution.height}
+              className="block w-full max-w-[480px] aspect-[4/3] object-contain"
+            />
+            {isRendering && (
+              <div className="absolute bottom-0 inset-x-0 bg-black/75 text-white text-xs px-3 py-1.5 flex items-center justify-between">
+                <span>Tracing paths in WebAssembly... {progress}%</span>
+                <span>{elapsedMs} ms</span>
+              </div>
+            )}
+          </div>
+        </div>
+
+        {/* Right column: Controls & Scene Metadata */}
+        <div className="flex-grow flex flex-col justify-between w-full">
+          <div>
+            <div className="flex items-center gap-2 text-amber-800 text-xs font-brand tracking-widest uppercase">
+              <span>Interactive Graphics</span>
+              <span>•</span>
+              <span>WebAssembly (Emscripten)</span>
+            </div>
+
+            <h2
+              id="smallpt-heading"
+              className="mt-1 text-2xl md:text-3xl font-brand text-gray-900"
+            >
+              smallpt: Global Illumination Path Tracer
+            </h2>
+
+            <p className="mt-2 text-sm text-gray-700 leading-relaxed">
+              Kevin Beason&apos;s open-source 99-line C++ Monte Carlo path tracer (
+              <code className="text-xs bg-gray-100 px-1.5 py-0.5 rounded">
+                smallpt.cpp
+              </code>
+              ) compiled to WebAssembly and running client-side in your browser,
+              featuring soft shadows, diffuse color bleeding, specular mirror
+              reflection, and dielectric glass refraction.
+            </p>
+
+            {/* Controls */}
+            <div className="mt-4 flex flex-wrap items-center gap-3">
+              <button
+                type="button"
+                id="randomize-spheres-btn"
+                onClick={handleRandomize}
+                className="bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white font-semibold text-sm px-4 py-2.5 rounded shadow-sm transition-colors cursor-pointer"
+              >
+                Run Again with Randomized Sphere Colors
+              </button>
+
+              <button
+                type="button"
+                id="reset-spheres-btn"
+                onClick={handleResetDefault}
+                className="bg-gray-800 hover:bg-gray-700 text-white font-semibold text-sm px-3.5 py-2.5 rounded transition-colors cursor-pointer"
+              >
+                Reset Classic Cornell Box
+              </button>
+
+              <label className="flex items-center gap-1.5 text-xs text-gray-700 ml-auto">
+                <span className="font-medium">Samples/pixel:</span>
+                <select
+                  value={samps}
+                  onChange={(e) => {
+                    const nextSamps = Number(e.target.value);
+                    setSamps(nextSamps);
+                    startRender({ samps: nextSamps });
+                  }}
+                  className="border border-gray-300 rounded px-2 py-1 bg-white text-gray-800"
+                >
+                  <option value={1}>4 spp (Fast)</option>
+                  <option value={2}>8 spp (Balanced)</option>
+                  <option value={4}>16 spp (Detailed)</option>
+                  <option value={8}>32 spp (High Quality)</option>
+                </select>
+              </label>
+            </div>
+
+            {errorMsg && (
+              <p className="mt-3 text-xs text-red-600 font-medium" role="alert">
+                Error: {errorMsg}
+              </p>
+            )}
+          </div>
+
+          {/* Sphere Color Swatches & Stats */}
+          <div className="mt-5 pt-4 border-t border-gray-200">
+            <div className="flex items-center justify-between text-xs text-gray-500 mb-2">
+              <span className="font-semibold text-gray-700">
+                Current Scene Sphere Colors
+              </span>
+              <span>
+                {resolution.width}×{resolution.height} • {samps * 4} spp •{' '}
+                {isRendering ? `Rendering (${progress}%)` : `Rendered in ${elapsedMs} ms`}
+              </span>
+            </div>
+
+            <div className="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-2">
+              {activePalette.map((sphere) => (
+                <div
+                  key={sphere.index}
+                  className="flex items-center gap-1.5 border border-gray-200 rounded px-2 py-1 bg-gray-50 text-xs"
+                >
+                  <span
+                    className="w-3.5 h-3.5 rounded-full border border-gray-400 flex-shrink-0"
+                    style={{ backgroundColor: toCssRgb(sphere.rgb) }}
+                  />
+                  <span className="truncate text-gray-700" title={sphere.name}>
+                    {sphere.name}
+                  </span>
+                </div>
+              ))}
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
