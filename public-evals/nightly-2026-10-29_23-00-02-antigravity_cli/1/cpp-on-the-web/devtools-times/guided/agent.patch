diff --git a/public/wasm/smallpt-worker.js b/public/wasm/smallpt-worker.js
new file mode 100644
index 0000000..3f1a9e2
--- /dev/null
+++ b/public/wasm/smallpt-worker.js
@@ -0,0 +1,101 @@
+import initSmallpt from './smallpt.js';
+
+let wasmModulePromise = null;
+
+async function getWasm() {
+  if (!wasmModulePromise) {
+    wasmModulePromise = initSmallpt();
+  }
+  return wasmModulePromise;
+}
+
+function readSphereColors(wasm) {
+  const ptr = wasm._malloc(9 * 3 * 8);
+  try {
+    wasm._get_sphere_colors(ptr);
+    const f64 = new Float64Array(wasm.HEAPF64.buffer, ptr, 27);
+    const colors = [];
+    for (let i = 0; i < 9; i++) {
+      colors.push([f64[i * 3], f64[i * 3 + 1], f64[i * 3 + 2]]);
+    }
+    return colors;
+  } finally {
+    wasm._free(ptr);
+  }
+}
+
+self.onmessage = async (event) => {
+  const {
+    jobId,
+    width = 320,
+    height = 240,
+    samps = 2,
+    randomize = false,
+    seed = Date.now(),
+    resetDefault = false,
+    customColors = null,
+    chunkRows = 24,
+  } = event.data;
+
+  try {
+    const wasm = await getWasm();
+
+    if (resetDefault) {
+      wasm._reset_default_colors();
+    } else if (randomize) {
+      wasm._randomize_sphere_colors(seed >>> 0);
+    } else if (Array.isArray(customColors)) {
+      for (let i = 0; i < customColors.length && i < 9; i++) {
+        const c = customColors[i];
+        if (Array.isArray(c) && c.length === 3) {
+          wasm._set_sphere_color(i, c[0], c[1], c[2]);
+        }
+      }
+    }
+
+    const sphereColors = readSphereColors(wasm);
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+
+    const startTime = performance.now();
+
+    try {
+      for (let yStart = 0; yStart < height; yStart += chunkRows) {
+        const yEnd = Math.min(height, yStart + chunkRows);
+        wasm._render_rows(ptr, width, height, samps, yStart, yEnd);
+
+        const pixels = new Uint8ClampedArray(
+          wasm.HEAPU8.buffer,
+          ptr,
+          byteLength,
+        ).slice();
+
+        const elapsedMs = performance.now() - startTime;
+        const done = yEnd >= height;
+
+        self.postMessage(
+          {
+            type: done ? 'complete' : 'progress',
+            jobId,
+            pixels,
+            width,
+            height,
+            samps,
+            completedRows: yEnd,
+            elapsedMs,
+            sphereColors,
+          },
+          [pixels.buffer],
+        );
+      }
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (error) {
+    self.postMessage({
+      type: 'error',
+      jobId,
+      message: error instanceof Error ? error.message : String(error),
+    });
+  }
+};
