+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  name: string;
+  index: number;
+  hex: string;
+  rgb: [number, number, number];
+}
+
+declare global {
+  interface Window {
+    createSmallptModule?: (options?: any) => Promise<any>;
+  }
+}
+
+const SPHERE_LABELS: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+function toHex(r: number, g: number, b: number): string {
+  const clamp = (v: number) => Math.max(0, Math.min(255, Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255)));
+  return (
+    '#' +
+    [clamp(r), clamp(g), clamp(b)]
+      .map((x) => x.toString(16).padStart(2, '0'))
+      .join('')
+  );
+}
+
+export default function SmallptPathTracer({ baseUrl = '/devtools-times/' }: { baseUrl?: string }) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmModuleRef = useRef<any>(null);
+  const renderTimerRef = useRef<number | null>(null);
+
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'ready' | 'error'>('loading');
+  const [samples, setSamples] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number>(0);
+  const [resolution, setResolution] = useState<{ w: number; h: number }>({ w: 200, h: 150 });
+  const [targetPasses, setTargetPasses] = useState<number>(6);
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([]);
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const readCurrentSphereColors = useCallback((mod: any) => {
+    const list: SphereColorInfo[] = SPHERE_LABELS.map(({ index, name }) => {
+      const r = mod._get_sphere_color_channel(index, 0);
+      const g = mod._get_sphere_color_channel(index, 1);
+      const b = mod._get_sphere_color_channel(index, 2);
+      return {
+        name,
+        index,
+        rgb: [r, g, b],
+        hex: toHex(r, g, b),
+      };
+    });
+    setSphereColors(list);
+  }, []);
+
+  const stopProgressiveRender = useCallback(() => {
+    if (renderTimerRef.current !== null) {
+      window.clearTimeout(renderTimerRef.current);
+      renderTimerRef.current = null;
+    }
+  }, []);
+
+  const runPathTracer = useCallback(
+    (randomize: boolean, customRes?: { w: number; h: number }, customPasses?: number) => {
+      const mod = wasmModuleRef.current;
+      if (!mod) return;
+
+      stopProgressiveRender();
+
+      const { w, h } = customRes || resolution;
+      const passes = customPasses || targetPasses;
+
+      if (randomize) {
+        const seed = Math.floor(Math.random() * 0xffffffff);
+        mod._randomize_sphere_colors(seed);
+      }
+
+      readCurrentSphereColors(mod);
+      mod._init_render(w, h);
+      setStatus('rendering');
+      setSamples(0);
+
+      let currentPass = 0;
+      const startTime = performance.now();
+
+      const step = () => {
+        const ptr = mod._step_render(1); // 1x 2x2 subpixels = 4 samples per pixel per pass
+        const totalSpp = mod._get_total_samples();
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, w * h * 4);
+            const imageData = new ImageData(new Uint8ClampedArray(pixels), w, h);
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+
+        currentPass++;
+        setSamples(totalSpp);
+        setRenderTimeMs(Math.round(performance.now() - startTime));
+
+        if (currentPass < passes) {
+          renderTimerRef.current = window.setTimeout(step, 10);
+        } else {
+          setStatus('ready');
+          renderTimerRef.current = null;
+        }
+      };
+
+      step();
+    },
+    [resolution, targetPasses, readCurrentSphereColors, stopProgressiveRender]
+  );
+
+  const handleResetColors = useCallback(() => {
+    const mod = wasmModuleRef.current;
+    if (!mod) return;
+    stopProgressiveRender();
+    mod._reset_scene_colors();
+    runPathTracer(false);
+  }, [runPathTracer, stopProgressiveRender]);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function loadWasm() {
+      try {
+        if (!window.createSmallptModule) {
+          await new Promise<void>((resolve, reject) => {
+            const existing = document.querySelector('script[data-smallpt-wasm="true"]');
+            if (existing && window.createSmallptModule) {
+              resolve();
+              return;
+            }
+            const script = document.createElement('script');
+            script.src = `${normalizedBase}smallpt.js`;
+            script.async = true;
+            script.dataset.smallptWasm = 'true';
+            script.onload = () => resolve();
+            script.onerror = () => reject(new Error('Failed to load smallpt.js'));
+            document.head.appendChild(script);
+          });
+        }
+
+        if (cancelled || !window.createSmallptModule) return;
+
+        const mod = await window.createSmallptModule({
+          locateFile: (path: string) => {
+            if (path.endsWith('.wasm')) {
+              return `${normalizedBase}smallpt.wasm`;
+            }
+            return path;
+          },
+        });
+
+        if (cancelled) return;
+        wasmModuleRef.current = mod;
+        runPathTracer(false);
+      } catch (err) {
+        console.error('Error initializing smallpt WASM:', err);
+        if (!cancelled) setStatus('error');
+      }
+    }
+
+    loadWasm();
+
+    return () => {
+      cancelled = true;
+      stopProgressiveRender();
+    };
+  }, [normalizedBase]);
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="my-6 bg-gray-900 text-white rounded-lg shadow-lg border border-gray-800 overflow-hidden"
+    >
+      <div className="p-5 md:p-6 border-b border-gray-800 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
+        <div>
+          <div className="flex items-center gap-2">
+            <span className="inline-block px-2 py-0.5 text-xs font-semibold uppercase tracking-wider bg-amber-500 text-gray-950 rounded">
+              WebAssembly Lab
+            </span>
+            <span className="text-xs text-gray-400 font-mono">smallpt.wasm (C++98 / Emscripten)</span>
+          </div>
+          <h2 className="text-xl md:text-2xl font-bold mt-1 text-white">
+            Interactive C++ Global Illumination Path Tracer (smallpt)
+          </h2>
+          <p className="text-sm text-gray-300 mt-1">
+            Compiled from Kevin Beason&apos;s 99-line C++ Monte Carlo path tracer running client-side in WebAssembly.
+          </p>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <button
+            id="randomize-spheres-btn"
+            type="button"
+            onClick={() => runPathTracer(true)}
+            disabled={status === 'loading'}
+            className="bg-amber-500 hover:bg-amber-400 disabled:opacity-50 text-gray-950 font-bold py-2.5 px-4 rounded shadow transition cursor-pointer text-sm flex items-center gap-2"
+          >
+            <span>Randomize Sphere Colors &amp; Re-render</span>
+          </button>
+
+          <button
+            id="reset-spheres-btn"
+            type="button"
+            onClick={handleResetColors}
+            disabled={status === 'loading'}
+            className="bg-gray-800 hover:bg-gray-700 disabled:opacity-50 text-gray-200 font-semibold py-2.5 px-3.5 rounded border border-gray-700 transition cursor-pointer text-sm"
+          >
+            Reset Cornell Box
+          </button>
+        </div>
+      </div>
+
+      <div className="p-5 md:p-6 grid grid-cols-1 lg:grid-cols-3 gap-6 items-center">
+        <div className="lg:col-span-2 flex flex-col items-center bg-black rounded-lg p-3 border border-gray-800">
+          <canvas
+            id="smallpt-canvas"
+            ref={canvasRef}
+            width={resolution.w}
+            height={resolution.h}
+            className="w-full max-w-[560px] aspect-[4/3] rounded border border-gray-700"
+            style={{ imageRendering: 'auto' }}
+          />
+          <div className="w-full max-w-[560px] flex flex-wrap justify-between items-center text-xs text-gray-400 mt-2 font-mono">
+            <span>
+              Status:{' '}
+              <strong className={status === 'rendering' ? 'text-amber-400' : 'text-emerald-400'}>
+                {status === 'loading'
+                  ? 'Loading WebAssembly...'
+                  : status === 'rendering'
+                  ? `Rendering (${samples} spp)...`
+                  : status === 'ready'
+                  ? `Complete (${samples} spp)`
+                  : 'Error loading WASM'}
+              </strong>
+            </span>
+            <span>
+              Resolution: {resolution.w}&times;{resolution.h} | Time: {renderTimeMs} ms
+            </span>
+          </div>
+        </div>
+
+        <div className="space-y-4">
+          <div className="bg-gray-800/70 rounded-lg p-4 border border-gray-700/80">
+            <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">
+              Current Scene Sphere Colors
+            </h3>
+            <div className="grid grid-cols-2 gap-2.5">
+              {sphereColors.map((sphere) => (
+                <div
+                  key={sphere.index}
+                  className="flex items-center gap-2 bg-gray-900/80 px-2.5 py-1.5 rounded border border-gray-700/60"
+                >
+                  <span
+                    className="w-4 h-4 rounded-full border border-white/20 shrink-0"
+                    style={{ backgroundColor: sphere.hex }}
+                  />
+                  <div className="truncate">
+                    <div className="text-xs font-medium text-gray-200 truncate">{sphere.name}</div>
+                    <div className="text-[10px] font-mono text-gray-400">{sphere.hex}</div>
+                  </div>
+                </div>
+              ))}
+            </div>
+          </div>
+
+          <div className="bg-gray-800/70 rounded-lg p-4 border border-gray-700/80 space-y-3">
+            <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-400">
+              Render Quality Settings
+            </h3>
+            <div className="flex items-center justify-between text-xs">
+              <label htmlFor="smallpt-res-select" className="text-gray-300">
+                Resolution:
+              </label>
+              <select
+                id="smallpt-res-select"
+                value={`${resolution.w}x${resolution.h}`}
+                onChange={(e) => {
+                  const [w, h] = e.target.value.split('x').map(Number);
+                  const nextRes = { w, h };
+                  setResolution(nextRes);
+                  runPathTracer(false, nextRes, targetPasses);
+                }}
+                className="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-gray-200"
+              >
+                <option value="120x90">120 &times; 90 (Fast)</option>
+                <option value="200x150">200 &times; 150 (Balanced)</option>
+                <option value="320x240">320 &times; 240 (High Detail)</option>
+              </select>
+            </div>
+
+            <div className="flex items-center justify-between text-xs">
+              <label htmlFor="smallpt-passes-select" className="text-gray-300">
+                Samples per Pixel:
+              </label>
+              <select
+                id="smallpt-passes-select"
+                value={targetPasses}
+                onChange={(e) => {
+                  const nextPasses = Number(e.target.value);
+                  setTargetPasses(nextPasses);
+                  runPathTracer(false, resolution, nextPasses);
+                }}
+                className="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-gray-200"
+              >
+                <option value={2}>8 spp (Quick Preview)</option>
+                <option value={6}>24 spp (Standard)</option>
+                <option value={12}>48 spp (Smooth)</option>
+              </select>
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
