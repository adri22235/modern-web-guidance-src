+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (e) => {
+  const { width = 320, height = 240, samples = 8, colors = null } = e.data;
+  try {
+    const wasm = await getWasm();
+    if (colors && Array.isArray(colors)) {
+      for (const item of colors) {
+        wasm._set_sphere_color(item.index, item.r, item.g, item.b);
+      }
+    } else {
+      wasm._reset_default_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+    const startTime = performance.now();
+
+    try {
+      wasm._render_frame(ptr, width, height, samples);
+      const elapsedMs = Math.round(performance.now() - startTime);
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        ptr,
+        byteLength
+      ).slice();
+
+      self.postMessage(
+        { status: 'done', pixels, width, height, samples, elapsedMs, colors },
+        [pixels.buffer]
+      );
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (err) {
+    self.postMessage({ status: 'error', message: err.message || String(err) });
+  }
+});
