+  </main>
+
+  <script type="module">
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const samplesSelect = document.getElementById('samples-select');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const statusText = document.getElementById('status-text');
+    const swatchContainer = document.getElementById('swatch-container');
+
+    const SPHERE_NAMES = [
+      'Left Wall',
+      'Right Wall',
+      'Back Wall',
+      'Front Wall',
+      'Floor',
+      'Ceiling',
+      'Mirror Sphere',
+      'Glass Sphere'
+    ];
+
+    const DEFAULT_COLORS = [
+      { index: 0, r: 0.75, g: 0.25, b: 0.25 },
+      { index: 1, r: 0.25, g: 0.25, b: 0.75 },
+      { index: 2, r: 0.75, g: 0.75, b: 0.75 },
+      { index: 3, r: 0.0,  g: 0.0,  b: 0.0  },
+      { index: 4, r: 0.75, g: 0.75, b: 0.75 },
+      { index: 5, r: 0.75, g: 0.75, b: 0.75 },
+      { index: 6, r: 0.999, g: 0.999, b: 0.999 },
+      { index: 7, r: 0.999, g: 0.999, b: 0.999 }
+    ];
+
+    let currentColors = DEFAULT_COLORS;
+
+    // Create a Web Worker with fallback to direct execution if needed
+    const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+
+    function updateSwatches(colors) {
+      swatchContainer.replaceChildren();
+      for (const c of colors) {
+        if (c.index === 3) continue; // Front wall is behind camera (black)
+        const el = document.createElement('div');
+        el.className = 'swatch';
+        const r = Math.round(Math.pow(Math.min(1, Math.max(0, c.r)), 1 / 2.2) * 255);
+        const g = Math.round(Math.pow(Math.min(1, Math.max(0, c.g)), 1 / 2.2) * 255);
+        const b = Math.round(Math.pow(Math.min(1, Math.max(0, c.b)), 1 / 2.2) * 255);
+        el.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
+        el.title = `${SPHERE_NAMES[c.index]}: (${c.r.toFixed(2)}, ${c.g.toFixed(2)}, ${c.b.toFixed(2)})`;
+        swatchContainer.appendChild(el);
+      }
+    }
+
+    function generateRandomColors() {
+      const randChannel = (min = 0.15, max = 0.95) =>
+        +(min + Math.random() * (max - min)).toFixed(3);
+
+      return [
+        // Left & Right walls: vibrant random hues
+        { index: 0, r: randChannel(0.15, 0.9), g: randChannel(0.15, 0.9), b: randChannel(0.15, 0.9) },
+        { index: 1, r: randChannel(0.15, 0.9), g: randChannel(0.15, 0.9), b: randChannel(0.15, 0.9) },
+        // Back wall, Floor, Ceiling: tinted surfaces
+        { index: 2, r: randChannel(0.3, 0.9), g: randChannel(0.3, 0.9), b: randChannel(0.3, 0.9) },
+        { index: 3, r: 0.0, g: 0.0, b: 0.0 },
+        { index: 4, r: randChannel(0.4, 0.9), g: randChannel(0.4, 0.9), b: randChannel(0.4, 0.9) },
+        { index: 5, r: randChannel(0.5, 0.95), g: randChannel(0.5, 0.95), b: randChannel(0.5, 0.95) },
+        // Mirror & Glass spheres: colorful reflective/refractive tints
+        { index: 6, r: randChannel(0.4, 0.999), g: randChannel(0.4, 0.999), b: randChannel(0.4, 0.999) },
+        { index: 7, r: randChannel(0.4, 0.999), g: randChannel(0.4, 0.999), b: randChannel(0.4, 0.999) }
+      ];
+    }
+
+    function setLoadingState(isRendering) {
+      randomizeBtn.disabled = isRendering;
+      resetBtn.disabled = isRendering;
+      samplesSelect.disabled = isRendering;
+      resolutionSelect.disabled = isRendering;
+    }
+
+    function triggerRender(colors) {
+      currentColors = colors;
+      updateSwatches(currentColors);
+      const [width, height] = resolutionSelect.value.split('x').map(Number);
+      const samples = Number(samplesSelect.value);
+
+      setLoadingState(true);
+      statusText.textContent = `Rendering ${width}\u00d7${height} (${samples * 4} total rays/pixel) in WebAssembly...`;
+
+      worker.postMessage({
+        width,
+        height,
+        samples,
+        colors: currentColors
+      });
+    }
+
+    worker.addEventListener('message', (e) => {
+      const data = e.data;
+      setLoadingState(false);
+
+      if (data.status === 'done') {
+        const { pixels, width, height, samples, elapsedMs } = data;
+        canvas.width = width;
+        canvas.height = height;
+        const imageData = new ImageData(pixels, width, height);
+        ctx.putImageData(imageData, 0, 0);
+        statusText.textContent = `Rendered ${width}\u00d7${height} at ${samples * 4} SPP in ${elapsedMs} ms`;
+      } else if (data.status === 'error') {
+        statusText.textContent = `Render error: ${data.message}`;
+      }
+    });
+
+    randomizeBtn.addEventListener('click', () => {
+      triggerRender(generateRandomColors());
+    });
+
+    resetBtn.addEventListener('click', () => {
+      triggerRender(DEFAULT_COLORS);
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      triggerRender(currentColors);
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      triggerRender(currentColors);
+    });
 
+    // Run initial render on load
+    triggerRender(DEFAULT_COLORS);
+  </script>
 </body>
 
