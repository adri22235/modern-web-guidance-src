+  <script>
+    const SPHERE_META = [
+      { index: 0, name: 'Left Wall Sphere', mat: 'DIFF' },
+      { index: 1, name: 'Right Wall Sphere', mat: 'DIFF' },
+      { index: 2, name: 'Back Wall Sphere', mat: 'DIFF' },
+      { index: 4, name: 'Floor Sphere', mat: 'DIFF' },
+      { index: 5, name: 'Ceiling Sphere', mat: 'DIFF' },
+      { index: 6, name: 'Mirror Sphere', mat: 'SPEC' },
+      { index: 7, name: 'Glass Sphere', mat: 'REFR' },
+      { index: 8, name: 'Ceiling Light', mat: 'LIGHT' }
+    ];
+
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resSelect = document.getElementById('res-select');
+    const passesSelect = document.getElementById('passes-select');
+    const statusText = document.getElementById('status-text');
+    const metricSpp = document.getElementById('metric-spp');
+    const metricTime = document.getElementById('metric-time');
+    const metricRuns = document.getElementById('metric-runs');
+    const sphereListEl = document.getElementById('sphere-list');
+
+    let wasmReady = false;
+    let pendingRandomize = false;
+    let progressiveTimer = null;
+    let currentPass = 0;
+    let targetPasses = 8;
+    let renderCount = 0;
+    let seedCounter = 1001;
+
+    function toHexChannel(v) {
+      const srgb = Math.min(255, Math.max(0, Math.floor(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255 + 0.5)));
+      return srgb.toString(16).padStart(2, '0');
+    }
+
+    function updateSphereSwatches() {
+      if (!wasmReady) return;
+      sphereListEl.innerHTML = '';
+      for (const item of SPHERE_META) {
+        let hex = '#ffffff';
+        if (item.mat !== 'LIGHT') {
+          const r = Module._get_sphere_color_r(item.index);
+          const g = Module._get_sphere_color_g(item.index);
+          const b = Module._get_sphere_color_b(item.index);
+          hex = '#' + toHexChannel(r) + toHexChannel(g) + toHexChannel(b);
+        }
+        const row = document.createElement('div');
+        row.className = 'sphere-item';
+        row.innerHTML = `
+          <div class="sphere-info">
+            <span class="swatch" style="background:${hex}"></span>
+            <span>${item.name}</span>
+          </div>
+          <span class="sphere-tag">${hex.toUpperCase()} · ${item.mat}</span>
+        `;
+        sphereListEl.appendChild(row);
+      }
+    }
+
+    function getResolution() {
+      const [w, h] = resSelect.value.split('x').map(Number);
+      return { w: w || 320, h: h || 240 };
+    }
+
+    function executePass(accumulate) {
+      const { w, h } = getResolution();
+      if (canvas.width !== w || canvas.height !== h) {
+        canvas.width = w;
+        canvas.height = h;
+      }
+
+      const t0 = performance.now();
+      seedCounter = (seedCounter * 1664525 + 1013904223) >>> 0;
+      const ptr = Module._render_scene(w, h, 1, accumulate ? 1 : 0, seedCounter);
+      const elapsed = Math.round(performance.now() - t0);
+
+      const byteLength = w * h * 4;
+      const pixels = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, byteLength);
+      const imageData = new ImageData(new Uint8ClampedArray(pixels), w, h);
+      ctx.putImageData(imageData, 0, 0);
+
+      currentPass = Module._get_accum_passes();
+      const totalSpp = currentPass * 4;
+      canvas.dataset.pass = String(currentPass);
+      metricSpp.textContent = `${totalSpp} spp`;
+      metricTime.textContent = `${elapsed} ms`;
+    }
+
+    function scheduleNextPass() {
+      if (currentPass >= targetPasses) {
+        statusText.textContent = `Render complete (${currentPass * 4} spp)`;
+        return;
+      }
+      statusText.textContent = `Refining path trace... Pass ${currentPass}/${targetPasses} (${currentPass * 4} spp)`;
+      progressiveTimer = setTimeout(() => {
+        executePass(true);
+        scheduleNextPass();
+      }, 20);
+    }
+
+    function startRender(randomizeColors) {
+      if (!wasmReady) {
+        if (randomizeColors) pendingRandomize = true;
+        return;
+      }
+      if (progressiveTimer) {
+        clearTimeout(progressiveTimer);
+        progressiveTimer = null;
+      }
+
+      targetPasses = parseInt(passesSelect.value, 10) || 8;
+
+      if (randomizeColors) {
+        seedCounter = (seedCounter + Date.now() + renderCount * 7919) >>> 0;
+        Module._randomize_spheres(seedCounter);
+      }
+
+      renderCount++;
+      canvas.dataset.renderCount = String(renderCount);
+      metricRuns.textContent = String(renderCount);
+
+      updateSphereSwatches();
+      executePass(false);
+      scheduleNextPass();
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      startRender(true);
+    });
+
+    resSelect.addEventListener('change', () => {
+      startRender(false);
+    });
+
+    passesSelect.addEventListener('change', () => {
+      targetPasses = parseInt(passesSelect.value, 10) || 8;
+      if (wasmReady && currentPass < targetPasses && !progressiveTimer) {
+        scheduleNextPass();
+      }
+    });
 
+    var Module = {
+      onRuntimeInitialized: function () {
+        wasmReady = true;
+        if (pendingRandomize) {
+          pendingRandomize = false;
+          startRender(true);
+        } else {
+          Module._reset_spheres();
+          startRender(false);
+        }
+      }
+    };
+  </script>
+  <script src="smallpt.js"></script>
