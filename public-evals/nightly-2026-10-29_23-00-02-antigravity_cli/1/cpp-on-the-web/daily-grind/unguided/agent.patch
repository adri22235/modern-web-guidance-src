+
+  // Randomize Left, Right, Back, Bottom, Top walls and Mirror & Glass spheres
+  int indices[] = {0, 1, 2, 4, 5, 6, 7};
+  double base_hue = erand48(Xi);
+  for (int idx = 0; idx < 7; idx++) {
+    int s = indices[idx];
+    double h = fmod(base_hue + idx * 0.61803398875 + 0.15 * erand48(Xi), 1.0) * 6.0;
+    double sat = 0.65 + 0.30 * erand48(Xi);
+    double val = 0.72 + 0.26 * erand48(Xi);
+    int hi = (int)h;
+    double f = h - hi;
+    double p = val * (1.0 - sat);
+    double q = val * (1.0 - sat * f);
+    double t = val * (1.0 - sat * (1.0 - f));
+    double r, g, b;
+    switch (hi % 6) {
+      case 0: r = val; g = t;   b = p;   break;
+      case 1: r = q;   g = val; b = p;   break;
+      case 2: r = p;   g = val; b = t;   break;
+      case 3: r = p;   g = q;   b = val; break;
+      case 4: r = t;   g = p;   b = val; break;
+      default:r = val; g = p;   b = q;   break;
+    }
+    spheres[s].c = Vec(r, g, b);
+  }
+  accum_passes = 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_scene(int w, int h, int samps, int accumulate, unsigned int seed_offset) {
+  if (w <= 0) w = 320;
+  if (h <= 0) h = 240;
+  if (samps <= 0) samps = 1;
+
+  if (w != current_w || h != current_h || !rgba_buffer || !accum_buffer) {
+    free(rgba_buffer);
+    delete[] accum_buffer;
+    rgba_buffer = (uint8_t*)malloc(w * h * 4);
+    accum_buffer = new Vec[w * h];
+    current_w = w;
+    current_h = h;
+    accum_passes = 0;
+  }
+
+  if (!accumulate || accum_passes == 0) {
+    for (int i = 0; i < w * h; i++) {
+      accum_buffer[i] = Vec();
+    }
+    accum_passes = 0;
+  }
+
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
