+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const customizerForm = document.getElementById('cup-customizer-ui');
+      const nameInput = document.getElementById('customer-name');
+      const milkSelect = document.getElementById('milk-option');
+      const syrupRadios = document.querySelectorAll('input[name="syrupOption"]');
+      const summaryText = document.getElementById('order-summary-text');
+      const addOrderBtn = document.getElementById('add-order-btn');
+
+      let orderAdded = false;
+
+      function getOrderState() {
+        const name = (nameInput.value || '').trim() || 'Guest';
+        const milk = milkSelect.value || 'Oat Milk';
+        let syrup = 'Maple';
+        syrupRadios.forEach((radio) => {
+          if (radio.checked) syrup = radio.value;
+        });
+        return { name, milk, syrup };
+      }
+
+      function updateSummaryDOM() {
+        const { name, milk, syrup } = getOrderState();
+        if (orderAdded) {
+          summaryText.textContent = `Order ready for ${name}: ${syrup} ${milk} Latte!`;
+        } else {
+          summaryText.textContent = `${name}'s ${syrup} ${milk} Latte`;
+        }
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderCanvas();
+        }
+      }
+
+      nameInput.addEventListener('input', () => {
+        orderAdded = false;
+        addOrderBtn.textContent = 'Add to Order';
+        updateSummaryDOM();
+      });
+
+      milkSelect.addEventListener('change', () => {
+        orderAdded = false;
+        addOrderBtn.textContent = 'Add to Order';
+        updateSummaryDOM();
+      });
+
+      syrupRadios.forEach((radio) => {
+        radio.addEventListener('change', () => {
+          orderAdded = false;
+          addOrderBtn.textContent = 'Add to Order';
+          updateSummaryDOM();
+        });
+      });
+
+      customizerForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        orderAdded = true;
+        addOrderBtn.textContent = 'Added to Cup!';
+        updateSummaryDOM();
+      });
+
+      function drawCoffeeCup(ctx, cssWidth, cssHeight, state) {
+        const centerX = cssWidth / 2;
+
+        // Subtle warm background vignette
+        const bgGrad = ctx.createRadialGradient(centerX, cssHeight / 2, 40, centerX, cssHeight / 2, cssWidth * 0.6);
+        bgGrad.addColorStop(0, '#fffdf9');
+        bgGrad.addColorStop(1, '#f5ebe6');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, cssWidth, cssHeight);
+
+        // Cup shadow on counter
+        ctx.save();
+        ctx.beginPath();
+        ctx.ellipse(centerX, 500, 115, 16, 0, 0, Math.PI * 2);
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.14)';
+        ctx.fill();
+        ctx.restore();
+
+        // Steam wisps above the lid
+        ctx.save();
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-35, 0, 35].forEach((offsetX, i) => {
+          ctx.beginPath();
+          const startX = centerX + offsetX;
+          ctx.moveTo(startX, 58);
+          ctx.bezierCurveTo(startX - 12, 42, startX + 12, 28, startX - 4, 14);
+          ctx.stroke();
+        });
+        ctx.restore();
+
+        // Cup Body Coordinates
+        const topY = 98;
+        const bottomY = 492;
+        const topHalfW = 165;
+        const bottomHalfW = 115;
+
+        // Milk/Syrup tint for decorative liquid indicator band
+        const syrupColors = {
+          Maple: '#d97724',
+          Vanilla: '#f3e5ab',
+          Caramel: '#c67d3b',
+          Hazelnut: '#8d5524'
+        };
+        const milkColors = {
+          'Oat Milk': '#f5ead6',
+          'Whole Milk': '#fffdf7',
+          'Almond Milk': '#efe0c9',
+          'Soy Milk': '#f2e8d5'
+        };
+
+        // Main Paper Cup Body
+        ctx.save();
+        ctx.beginPath();
+        ctx.moveTo(centerX - topHalfW, topY);
+        ctx.lineTo(centerX + topHalfW, topY);
+        ctx.lineTo(centerX + bottomHalfW, bottomY);
+        ctx.quadraticCurveTo(centerX, bottomY + 14, centerX - bottomHalfW, bottomY);
+        ctx.closePath();
+
+        const cupGrad = ctx.createLinearGradient(centerX - topHalfW, 0, centerX + topHalfW, 0);
+        cupGrad.addColorStop(0, '#efe5dc');
+        cupGrad.addColorStop(0.25, '#fdfaf6');
+        cupGrad.addColorStop(0.75, '#f7efe6');
+        cupGrad.addColorStop(1, '#dfd1c5');
+        ctx.fillStyle = cupGrad;
+        ctx.fill();
+        ctx.lineWidth = 2.5;
+        ctx.strokeStyle = '#6d4c41';
+        ctx.stroke();
+
+        // Clip to cup body for Kraft Cardboard Sleeve & Flavor Accent
+        ctx.clip();
+
+        // Top espresso/milk/syrup accent stripe under rim
+        ctx.fillStyle = syrupColors[state.syrup] || '#d97724';
+        ctx.fillRect(centerX - topHalfW, topY, topHalfW * 2, 16);
+        ctx.fillStyle = milkColors[state.milk] || '#f5ead6';
+        ctx.fillRect(centerX - topHalfW, topY + 16, topHalfW * 2, 8);
+
+        // Kraft Cardboard Sleeve wrapping the middle of the cup
+        const sleeveTopY = 128;
+        const sleeveBottomY = 452;
+        const sleeveGrad = ctx.createLinearGradient(centerX - topHalfW, 0, centerX + topHalfW, 0);
+        sleeveGrad.addColorStop(0, '#a98260');
+        sleeveGrad.addColorStop(0.2, '#c89f7c');
+        sleeveGrad.addColorStop(0.8, '#bc926e');
+        sleeveGrad.addColorStop(1, '#966f4e');
+        ctx.fillStyle = sleeveGrad;
+        ctx.fillRect(centerX - topHalfW, sleeveTopY, topHalfW * 2, sleeveBottomY - sleeveTopY);
+
+        // Sleeve borders
+        ctx.strokeStyle = '#5d4037';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(centerX - topHalfW, sleeveTopY);
+        ctx.lineTo(centerX + topHalfW, sleeveTopY);
+        ctx.moveTo(centerX - topHalfW, sleeveBottomY);
+        ctx.lineTo(centerX + topHalfW, sleeveBottomY);
+        ctx.stroke();
+        ctx.restore();
+
+        // Coffee Cup Dome Lid
+        ctx.save();
+        // Upper lid dome
+        ctx.beginPath();
+        ctx.moveTo(centerX - topHalfW + 8, topY - 12);
+        ctx.lineTo(centerX - topHalfW + 22, topY - 32);
+        ctx.lineTo(centerX + topHalfW - 22, topY - 32);
+        ctx.lineTo(centerX + topHalfW - 8, topY - 12);
+        ctx.closePath();
+        ctx.fillStyle = '#4e342e';
+        ctx.fill();
+        ctx.strokeStyle = '#3e2723';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Lid rim lip
+        ctx.beginPath();
+        ctx.roundRect(centerX - topHalfW - 10, topY - 14, (topHalfW + 10) * 2, 18, 6);
+        ctx.fillStyle = '#5d4037';
+        ctx.fill();
+        ctx.strokeStyle = '#3e2723';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+        ctx.restore();
+      }
+
+      function renderCanvas() {
+        const dpr = window.devicePixelRatio || 1;
+        const cssWidth = canvas.clientWidth || 720;
+        const cssHeight = canvas.clientHeight || 540;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        // Scale the context by devicePixelRatio so drawings and drawElementImage are crisp on high-DPI screens
+        ctx.scale(dpr, dpr);
+
+        const state = getOrderState();
+        drawCoffeeCup(ctx, cssWidth, cssHeight, state);
+
+        // Calculate centered coordinates on the cup sleeve for the interactive HTML form
+        const formWidth = customizerForm.offsetWidth || 240;
+        const x = Math.round((cssWidth - formWidth) / 2);
+        const y = 140;
+
+        // Render live HTML element into the canvas and sync its CSS transform for exact alignment
+        const drawFn = ctx.drawElementImage || ctx.drawElement;
+        if (typeof drawFn === 'function') {
+          const transform = drawFn.call(ctx, customizerForm, x, y);
+          if (transform) {
+            customizerForm.style.transform = transform.toString();
+          }
+        } else {
+          customizerForm.style.transform = `translate(${x}px, ${y}px)`;
+        }
+      }
+
+      canvas.onpaint = () => {
+        renderCanvas();
+      };
+
+      // ResizeObserver using device-pixel-content-box to prevent blurriness on high-DPI displays
+      const resizeObserver = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        if (dpc && dpc[0]) {
+          canvas.width = dpc[0].inlineSize;
+          canvas.height = dpc[0].blockSize;
+        } else {
+          const dpr = window.devicePixelRatio || 1;
+          canvas.width = Math.round(entry.contentRect.width * dpr);
+          canvas.height = Math.round(entry.contentRect.height * dpr);
+        }
+
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderCanvas();
+        }
+      });
+
+      try {
+        resizeObserver.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch (e) {
+        resizeObserver.observe(canvas);
+      }
+
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else {
+        renderCanvas();
+      }
+    })();
+  </script>
+
