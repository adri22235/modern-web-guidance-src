+  <script>
+    const canvas = document.getElementById("canvas");
+    const ctx = canvas.getContext("2d");
+    const uiElement = document.getElementById("ui-element");
+    const canvasWrapper = document.getElementById("canvas-wrapper");
+    const form = document.getElementById("coffee-customizer-form");
+    const nameInput = document.getElementById("cup-name");
+    const milkSelect = document.getElementById("milk-option");
+    const orderStatus = document.getElementById("order-status");
+
+    const milkColors = {
+      "Oat Milk": "#e6d2b5",
+      "Whole Milk": "#f5ebe0",
+      "Almond Milk": "#dfccb2",
+      "Soy Milk": "#ede0c8",
+      "Coconut Milk": "#f7f3eb",
+      "Skim Milk": "#eef1f6"
+    };
+
+    const syrupColors = {
+      "Maple": "#b85d19",
+      "Vanilla": "#e3b778",
+      "Caramel": "#c67727",
+      "Hazelnut": "#7b4b2a",
+      "No Syrup": "#4e342e"
+    };
+
+    function getOrderState() {
+      const checkedSyrup = form.querySelector('input[name="syrup"]:checked');
+      return {
+        name: (nameInput.value || "Guest").trim(),
+        milk: milkSelect.value || "Oat Milk",
+        syrup: checkedSyrup ? checkedSyrup.value : "Maple"
+      };
+    }
+
+    function drawCoffeeCup(context, width, height) {
+      if (!width || !height) return;
+
+      const state = getOrderState();
+      const dpr = window.devicePixelRatio || 1;
+      const cssWidth = width / dpr;
+      const cssHeight = height / dpr;
+
+      context.save();
+      context.scale(dpr, dpr);
+
+      // Warm coffee bar background
+      const bgGrad = context.createLinearGradient(0, 0, cssWidth, cssHeight);
+      bgGrad.addColorStop(0, "#fdf8f4");
+      bgGrad.addColorStop(1, "#f3e7df");
+      context.fillStyle = bgGrad;
+      context.fillRect(0, 0, cssWidth, cssHeight);
+
+      // Decorative left panel backdrop for the coffee cup
+      const isCompact = cssWidth <= 720;
+      const cupCenterX = isCompact ? cssWidth / 2 : 185;
+      const cupCenterY = isCompact ? 155 : cssHeight / 2 + 15;
+      const scale = isCompact ? 0.78 : 1;
+
+      context.save();
+      context.translate(cupCenterX, cupCenterY);
+      context.scale(scale, scale);
+
+      // Soft shadow beneath cup
+      context.fillStyle = "rgba(62, 39, 35, 0.14)";
+      context.beginPath();
+      context.ellipse(0, 145, 78, 16, 0, 0, Math.PI * 2);
+      context.fill();
+
+      // Rising steam wisps
+      context.strokeStyle = "rgba(121, 85, 72, 0.35)";
+      context.lineWidth = 3;
+      context.lineCap = "round";
+      [-28, 0, 28].forEach((offsetX, i) => {
+        context.beginPath();
+        context.moveTo(offsetX, -145);
+        context.bezierCurveTo(
+          offsetX - 14, -168 - i * 4,
+          offsetX + 16, -188 - i * 4,
+          offsetX - 4, -210 - i * 4
+        );
+        context.stroke();
+      });
+
+      // Cup body (tapered paper cup)
+      const cupGrad = context.createLinearGradient(-85, 0, 85, 0);
+      cupGrad.addColorStop(0, "#fffdfa");
+      cupGrad.addColorStop(0.7, "#f7efe8");
+      cupGrad.addColorStop(1, "#e5d5c8");
+      context.fillStyle = cupGrad;
+      context.strokeStyle = "#5d4037";
+      context.lineWidth = 2.5;
+
+      context.beginPath();
+      context.moveTo(-82, -105);
+      context.lineTo(82, -105);
+      context.lineTo(58, 138);
+      context.quadraticCurveTo(0, 148, -58, 138);
+      context.closePath();
+      context.fill();
+      context.stroke();
+
+      // Liquid layer window near top of cup reflecting milk & syrup selection
+      context.fillStyle = milkColors[state.milk] || "#e6d2b5";
+      context.beginPath();
+      context.moveTo(-76, -82);
+      context.lineTo(76, -82);
+      context.lineTo(72, -48);
+      context.lineTo(-72, -48);
+      context.closePath();
+      context.fill();
+
+      // Syrup drizzle wave
+      context.strokeStyle = syrupColors[state.syrup] || "#b85d19";
+      context.lineWidth = 4;
+      context.beginPath();
+      context.moveTo(-64, -65);
+      context.bezierCurveTo(-30, -76, -10, -54, 0, -65);
+      context.bezierCurveTo(20, -76, 40, -54, 64, -65);
+      context.stroke();
+
+      // Kraft cardboard sleeve
+      const sleeveGrad = context.createLinearGradient(-75, 0, 75, 0);
+      sleeveGrad.addColorStop(0, "#d2b497");
+      sleeveGrad.addColorStop(0.5, "#c39f7e");
+      sleeveGrad.addColorStop(1, "#a98463");
+      context.fillStyle = sleeveGrad;
+      context.strokeStyle = "#4e342e";
+      context.lineWidth = 2;
+
+      context.beginPath();
+      context.moveTo(-71, -36);
+      context.lineTo(71, -36);
+      context.lineTo(63, 62);
+      context.lineTo(-63, 62);
+      context.closePath();
+      context.fill();
+      context.stroke();
+
+      // Cup sleeve white barista sticker
+      context.fillStyle = "#fffdf9";
+      context.strokeStyle = "#8d6e63";
+      context.lineWidth = 1.5;
+      context.beginPath();
+      context.roundRect(-54, -22, 108, 70, 6);
+      context.fill();
+      context.stroke();
+
+      // Text on cup sticker
+      context.fillStyle = "#3e2723";
+      context.font = "bold 13px 'Segoe UI', sans-serif";
+      context.textAlign = "center";
+      context.fillText(state.name.toUpperCase(), 0, -2);
+
+      context.fillStyle = "#5d4037";
+      context.font = "11px 'Segoe UI', sans-serif";
+      context.fillText(state.milk, 0, 16);
+
+      context.fillStyle = syrupColors[state.syrup] || "#4e342e";
+      context.font = "bold 11px 'Segoe UI', sans-serif";
+      context.fillText(state.syrup, 0, 34);
+
+      // Coffee cup traveller lid
+      context.fillStyle = "#4e342e";
+      context.beginPath();
+      context.roundRect(-90, -124, 180, 22, 6);
+      context.fill();
+
+      context.fillStyle = "#3e2723";
+      context.beginPath();
+      context.moveTo(-74, -124);
+      context.lineTo(74, -124);
+      context.lineTo(66, -140);
+      context.lineTo(-66, -140);
+      context.closePath();
+      context.fill();
+
+      context.restore();
+      context.restore();
+    }
+
+    function updateOrderSummary(submitted = false) {
+      const state = getOrderState();
+      const prefix = submitted ? "Order Added" : "Previewing";
+      orderStatus.textContent = `${prefix}: ${state.name}'s ${state.milk} Latte (${state.syrup})`;
+      if ("content" in HTMLCanvasElement.prototype) {
+        canvas.requestPaint();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+      }
+    }
+
+    canvas.onpaint = () => {
+      ctx.reset();
+      drawCoffeeCup(ctx, canvas.width, canvas.height);
+      // Draw the HTML element at x:0, y:0. The browser syncs the DOM location
+      // with the drawn location.
+      ctx.drawElementImage(uiElement, 0, 0);
+    };
+
+    if ("content" in HTMLCanvasElement.prototype) {
+      canvas.requestPaint();
+    } else {
+      // Fallback strategy: place the HTML content on top of the canvas using CSS
+      canvasWrapper.classList.add("canvas-fallback");
+      drawCoffeeCup(ctx, canvas.width, canvas.height);
+    }
+
+    // Handle resizing to match device pixels
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      if ("content" in HTMLCanvasElement.prototype) {
+        canvas.requestPaint();
+      } else {
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+      }
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+
+    form.addEventListener("input", () => updateOrderSummary(false));
+    form.addEventListener("change", () => updateOrderSummary(false));
+    form.addEventListener("submit", (event) => {
+      event.preventDefault();
+      updateOrderSummary(true);
+    });
+  </script>
+
 </body>
 
