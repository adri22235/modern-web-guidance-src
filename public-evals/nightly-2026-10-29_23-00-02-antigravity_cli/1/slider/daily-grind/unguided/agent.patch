+  <script>
+    (function () {
+      const brewProfiles = {
+        1: {
+          tag: 'Delicate',
+          fillLabel: '0% Extraction Intensity',
+          title: 'Light & Floral Pour-Over:',
+          notes: 'Bright bergamot, jasmine blossom, and crisp honeycrisp apple acidity.',
+          ratio: '1:17 Coffee-to-Water · 198°F',
+          valueText: 'Level 1 of 5: Delicate (Light & Floral Pour-Over)'
+        },
+        2: {
+          tag: 'Mild',
+          fillLabel: '25% Extraction Intensity',
+          title: 'Mellow Morning Drip:',
+          notes: 'Soft milk chocolate, golden raisin, and gentle toasted almond warmth.',
+          ratio: '1:16 Coffee-to-Water · 199°F',
+          valueText: 'Level 2 of 5: Mild (Mellow Morning Drip)'
+        },
+        3: {
+          tag: 'Balanced',
+          fillLabel: '50% Extraction Intensity',
+          title: 'Balanced House Blend:',
+          notes: 'Smooth caramel sweetness with toasted hazelnut and a clean citrus finish.',
+          ratio: '1:15 Coffee-to-Water · 200°F',
+          valueText: 'Level 3 of 5: Balanced (Medium Roast Profile)'
+        },
+        4: {
+          tag: 'Bold',
+          fillLabel: '75% Extraction Intensity',
+          title: 'Full-Bodied Craft Roast:',
+          notes: 'Rich dark cocoa, roasted walnut, and velvety brown spice undertones.',
+          ratio: '1:14 Coffee-to-Water · 202°F',
+          valueText: 'Level 4 of 5: Bold (Full-Bodied Craft Roast)'
+        },
+        5: {
+          tag: 'Extra Strong',
+          fillLabel: '100% Extraction Intensity',
+          title: 'Double Ristretto Reserve:',
+          notes: 'Intense bittersweet espresso, smoky molasses, and a lingering syrupy crema.',
+          ratio: '1:12 Coffee-to-Water · 204°F',
+          valueText: 'Level 5 of 5: Extra Strong (Double Ristretto Reserve)'
+        }
+      };
+
+      const slider = document.getElementById('brew-strength-slider');
+      const output = document.getElementById('brew-strength-output');
+      const tag = document.getElementById('brew-strength-tag');
+      const fillReadout = document.getElementById('brew-fill-readout');
+      const tastingTitle = document.getElementById('brew-tasting-title');
+      const tastingNotes = document.getElementById('brew-tasting-notes');
+      const ratioSpec = document.getElementById('brew-ratio-spec');
+      const ticks = document.querySelectorAll('.brew-tick');
+
+      if (!slider) return;
+
+      function updateBrewStrength(rawValue) {
+        const min = Number(slider.min) || 1;
+        const max = Number(slider.max) || 5;
+        const value = Math.min(max, Math.max(min, Number(rawValue)));
+        const percent = ((value - min) / (max - min)) * 100;
+        const profile = brewProfiles[value] || brewProfiles[3];
+
+        slider.style.setProperty('--fill-percent', `${percent}%`);
+        slider.setAttribute('aria-valuenow', String(value));
+        slider.setAttribute('aria-valuetext', profile.valueText);
+
+        if (output) output.textContent = `Level ${value} / ${max}`;
+        if (tag) tag.textContent = profile.tag;
+        if (fillReadout) fillReadout.textContent = profile.fillLabel;
+        if (tastingTitle) tastingTitle.textContent = profile.title;
+        if (tastingNotes) tastingNotes.textContent = profile.notes;
+        if (ratioSpec) ratioSpec.textContent = profile.ratio;
+
+        ticks.forEach((tick) => {
+          const tickVal = Number(tick.getAttribute('data-value'));
+          tick.classList.toggle('active', tickVal === value);
+        });
+      }
+
+      slider.addEventListener('input', (event) => {
+        updateBrewStrength(event.target.value);
+      });
+
+      slider.addEventListener('change', (event) => {
+        updateBrewStrength(event.target.value);
+      });
+
+      ticks.forEach((tick) => {
+        tick.addEventListener('click', () => {
+          const val = tick.getAttribute('data-value');
+          if (val) {
+            slider.value = val;
+            updateBrewStrength(val);
+            slider.focus();
+            slider.dispatchEvent(new Event('input', { bubbles: true }));
+            slider.dispatchEvent(new Event('change', { bubbles: true }));
+          }
+        });
+      });
+
+      updateBrewStrength(slider.value);
+    })();
+  </script>
 </body>
 
