+  <script>
+    const slider = document.querySelector('#brew-strength');
+    const sliderOutput = document.querySelector('#brew-strength-value');
+
+    function formatBrewStrength(value) {
+      const numericValue = Number(value);
+      let roastLevel = 'Extra Bold';
+      if (numericValue < 25) {
+        roastLevel = 'Light';
+      } else if (numericValue < 50) {
+        roastLevel = 'Mild';
+      } else if (numericValue < 75) {
+        roastLevel = 'Medium';
+      } else if (numericValue < 90) {
+        roastLevel = 'Strong';
+      }
+      return `${roastLevel} (${numericValue}%)`;
+    }
+
+    function syncSliderValue() {
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 100);
+      slider.style.setProperty('--control-value', slider.value);
+
+      const formattedValue = formatBrewStrength(slider.value);
+      if (sliderOutput) {
+        sliderOutput.textContent = formattedValue;
+      }
+      slider.setAttribute('aria-valuetext', formattedValue);
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
+
