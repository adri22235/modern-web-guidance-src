+    const dynamicViewRoot = document.getElementById('dynamic-view-root');
+
+    function renderRouteView(pathname, pushHistory = true) {
+      if (!dynamicViewRoot) return;
+
+      if (pathname === '/' || !VIEWS[pathname]) {
+        if (pushHistory && window.location.pathname !== '/') {
+          history.pushState({ path: '/' }, '', '/');
+        }
+        dynamicViewRoot.innerHTML = '';
+        return;
+      }
+
+      const view = VIEWS[pathname];
+      // Render new contentful DOM elements and update URL via history.pushState
+      // so the browser emits both interaction-contentful-paint and soft-navigation entries.
+      dynamicViewRoot.innerHTML = `
+        <article class="view-panel" data-view-path="${pathname}">
+          <h2>${view.title}</h2>
+          <p>${view.description}</p>
+          <img src="${view.image}" alt="${view.title}" width="800" height="280">
+          <p><strong>${view.details}</strong></p>
+        </article>
+      `;
+
+      if (pushHistory && window.location.pathname !== pathname) {
+        history.pushState({ path: pathname }, '', pathname);
+      }
+    }
+
+    document.addEventListener('click', (event) => {
+      const target = event.target instanceof Element ? event.target : null;
+      if (!target) return;
+
+      const link = target.closest('a[href]');
+      if (link) {
+        const href = link.getAttribute('href');
+        if (href === '/' || (href && VIEWS[href])) {
+          event.preventDefault();
+          renderRouteView(href, true);
+          return;
+        }
+      }
+
+      const card = target.closest('.card[data-route]');
+      if (card) {
