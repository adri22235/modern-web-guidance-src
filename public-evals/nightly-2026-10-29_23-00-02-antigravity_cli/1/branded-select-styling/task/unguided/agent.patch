+    /* Coffee Roast Selector */
+    .roast-selector {
+      margin-top: 1.25rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .roast-selector label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+      color: var(--accent);
+      text-transform: uppercase;
+    }
+
+    select,
+    ::picker(select) {
+      appearance: base-select;
+    }
+
+    select {
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      padding: 10px 18px;
+      font-size: 1rem;
+      font-weight: 600;
+      font-family: inherit;
+      min-width: 200px;
+      cursor: pointer;
+      transition: background-color 0.2s, box-shadow 0.2s;
+    }
+
+    select:hover,
+    select:focus {
+      background-color: var(--primary);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.35);
+      outline: none;
+    }
+
+    select::picker-icon {
+      color: var(--accent);
+      transition: transform 0.2s ease;
+    }
+
+    select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    ::picker(select) {
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      padding: 6px;
+      margin-top: 6px;
+      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
+    }
+
+    option {
+      background-color: var(--primary);
+      color: var(--accent);
+      padding: 10px 14px;
+      border-radius: 4px;
+      font-weight: 500;
+      cursor: pointer;
+      transition: background-color 0.15s, color 0.15s;
+    }
+
+    option:focus {
+      background-color: var(--primary);
+      color: var(--accent);
+      outline: 1px solid var(--accent);
+    }
+
+    option:checked {
+      background-color: var(--primary);
+      color: var(--accent);
+      font-weight: 700;
+    }
+
+    option:hover {
+      background-color: var(--accent);
+      color: var(--primary);
+    }
+
+    option::checkmark {
+      color: var(--accent);
+      font-weight: bold;
+    }
+
+    option:hover::checkmark {
+      color: var(--primary);
+    }
+
