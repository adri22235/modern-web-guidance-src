+  <script>
+    (() => {
+      const draggable = document.getElementById('quick-cart-panel');
+      const handle = document.getElementById('quick-cart-header');
+      const grip = document.getElementById('drag-grip');
+      if (!draggable || !handle) return;
+
+      // Progressive enhancement: attach drag affordances and keyboard accessibility when JS initializes
+      handle.classList.add('drag-handle');
+      handle.tabIndex = 0;
+      handle.setAttribute(
+        'aria-label',
+        'Quick Order Cart header — drag with pointer or use arrow keys to move panel'
+      );
+      if (grip) grip.hidden = false;
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let isDragging = false;
+      let hasCustomPosition = false;
+      const DRAG_THRESHOLD_PX = 4;
+      const KEYBOARD_STEP_PX = 15;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+        draggable.style.right = 'auto';
+        draggable.style.bottom = 'auto';
+        draggable.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        draggable.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        hasCustomPosition = true;
+      }
+
+      function reclampPosition() {
+        if (!hasCustomPosition) return;
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (
+          event.button !== 0 ||
+          event.target.closest('button, input, select, textarea, a')
+        ) {
+          return;
+        }
+
+        const rect = draggable.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        isDragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+
+        if (!isDragging) {
+          const distance = Math.hypot(event.clientX - startX, event.clientY - startY);
+          if (distance < DRAG_THRESHOLD_PX) return;
+          isDragging = true;
+          handle.classList.add('dragging');
+        }
+
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        isDragging = false;
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+
+        const deltas = {
+          ArrowLeft: [-KEYBOARD_STEP_PX, 0],
+          ArrowRight: [KEYBOARD_STEP_PX, 0],
+          ArrowUp: [0, -KEYBOARD_STEP_PX],
+          ArrowDown: [0, KEYBOARD_STEP_PX],
+        };
+
+        const delta = deltas[event.key];
+        if (!delta) return;
+
+        event.preventDefault();
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+      });
+
+      window.addEventListener('resize', reclampPosition);
+      if ('ResizeObserver' in window) {
+        const resizeObserver = new ResizeObserver(() => reclampPosition());
+        resizeObserver.observe(draggable);
+      }
+
+      // Interactive Cart Controls
+      const sizeSelect = document.getElementById('cart-size-select');
+      const milkSelect = document.getElementById('cart-milk-select');
+      const itemsList = document.getElementById('cart-items-list');
+      const countBadge = document.getElementById('cart-count-badge');
+      const totalPriceEl = document.getElementById('cart-total-price');
+      const checkoutBtn = document.getElementById('cart-checkout-btn');
+      const clearBtn = document.getElementById('cart-clear-btn');
+      const statusMsg = document.getElementById('cart-status-msg');
+      const collapseBtn = document.getElementById('cart-collapse-btn');
+
+      function updateCartSummary() {
+        const sizeUpcharge = parseFloat(sizeSelect.value) || 0;
+        let totalItems = 0;
+        let totalCost = 0;
+
+        itemsList.querySelectorAll('.cart-item').forEach((itemEl) => {
+          const basePrice = parseFloat(itemEl.dataset.basePrice) || 0;
+          const qtyEl = itemEl.querySelector('[data-qty]');
+          const qty = parseInt(qtyEl.textContent, 10) || 0;
+          totalItems += qty;
+          totalCost += qty * (basePrice + sizeUpcharge);
+        });
+
+        countBadge.textContent = String(totalItems);
+        totalPriceEl.textContent = `$${totalCost.toFixed(2)}`;
+        checkoutBtn.disabled = totalItems === 0;
+      }
+
+      itemsList.addEventListener('click', (event) => {
+        const btn = event.target.closest('button[data-action]');
+        if (!btn) return;
+        const itemEl = btn.closest('.cart-item');
+        const qtyEl = itemEl.querySelector('[data-qty]');
+        let qty = parseInt(qtyEl.textContent, 10) || 0;
+
+        if (btn.dataset.action === 'increment') {
+          qty += 1;
+        } else if (btn.dataset.action === 'decrement' && qty > 0) {
+          qty -= 1;
+        }
+
+        qtyEl.textContent = String(qty);
+        statusMsg.hidden = true;
+        updateCartSummary();
+      });
+
+      sizeSelect.addEventListener('change', () => {
+        statusMsg.hidden = true;
+        updateCartSummary();
+      });
+
+      milkSelect.addEventListener('change', () => {
+        statusMsg.hidden = true;
+      });
+
+      clearBtn.addEventListener('click', () => {
+        itemsList.querySelectorAll('[data-qty]').forEach((qtyEl) => {
+          qtyEl.textContent = '0';
+        });
+        statusMsg.hidden = true;
+        updateCartSummary();
+      });
+
+      checkoutBtn.addEventListener('click', () => {
+        const count = parseInt(countBadge.textContent, 10) || 0;
+        if (count === 0) return;
+        const sizeLabel = sizeSelect.options[sizeSelect.selectedIndex].text.split(' ')[0];
+        const milkLabel = milkSelect.value;
+        statusMsg.textContent = `Order queued: ${count}x ${sizeLabel} (${milkLabel}) — ${totalPriceEl.textContent}`;
+        statusMsg.hidden = false;
+      });
+
+      collapseBtn.addEventListener('click', () => {
+        const isCollapsed = draggable.classList.toggle('is-collapsed');
+        collapseBtn.setAttribute('aria-expanded', String(!isCollapsed));
+        collapseBtn.querySelector('span').innerHTML = isCollapsed ? '&#43;' : '&minus;';
+      });
+
+      updateCartSummary();
+    })();
+  </script>
 </body>
 
