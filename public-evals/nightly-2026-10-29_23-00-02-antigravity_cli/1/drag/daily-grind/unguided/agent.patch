+        btn.addEventListener('click', function () {
+          sizeButtons.forEach(function (b) { b.classList.remove('active'); });
+          btn.classList.add('active');
+          selectedSize = btn.getAttribute('data-size') || 'Medium';
+          selectedUpcharge = parseFloat(btn.getAttribute('data-upcharge') || '0');
+        });
+      });
+
+      function addOrIncrementItem(name, size, milk, extraShot, unitPrice) {
+        const existing = cartItems.find(function (item) {
+          return item.name === name &&
+                 item.size === size &&
+                 item.milk === milk &&
+                 item.extraShot === extraShot;
+        });
+
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          cartItems.push({
+            id: 'item-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
+            name: name,
+            size: size,
+            milk: milk,
+            extraShot: extraShot,
+            unitPrice: unitPrice,
+            qty: 1
+          });
+        }
+        hideStatusBanner();
+        renderCart();
+      }
+
+      addDrinkBtn.addEventListener('click', function () {
+        const selectedOption = drinkSelect.options[drinkSelect.selectedIndex];
+        const name = selectedOption.value;
+        const basePrice = parseFloat(selectedOption.getAttribute('data-price') || '4.50');
+        const milk = milkSelect.value;
+        const extraShot = extraShotCheckbox.checked;
+        const unitPrice = basePrice + selectedUpcharge + (extraShot ? 1.00 : 0);
+
+        addOrIncrementItem(name, selectedSize, milk, extraShot, unitPrice);
+      });
+
+      document.querySelectorAll('.btn-quick-add').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const name = btn.getAttribute('data-quick-drink');
+          const price = parseFloat(btn.getAttribute('data-quick-price') || '4.50');
+          const milk = btn.getAttribute('data-quick-milk') || 'Oat Milk';
+          panel.classList.remove('is-minimized');
+          minimizeBtn.innerHTML = '&minus;';
+          addOrIncrementItem(name, 'Medium', milk, false, price + 0.50);
+        });
+      });
+
+      rewardsCheckbox.addEventListener('change', function () {
+        renderCart();
+      });
+
+      clearCartBtn.addEventListener('click', function () {
+        cartItems = [];
+        hideStatusBanner();
+        renderCart();
+      });
+
+      checkoutBtn.addEventListener('click', function () {
+        if (cartItems.length === 0) return;
+        const pickup = pickupSelect.value;
+        const totalText = totalEl.textContent;
+        statusBanner.textContent = 'Order confirmed! Ready ' + pickup.toLowerCase() + ' (' + totalText + ').';
+        statusBanner.classList.add('visible');
+      });
+
+      function hideStatusBanner() {
+        statusBanner.classList.remove('visible');
+      }
+
+      function renderCart() {
+        cartListEl.innerHTML = '';
+
+        let totalCount = 0;
+        let subtotal = 0;
+
+        if (cartItems.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'empty-cart-msg';
+          emptyLi.textContent = 'Your coffee cart is empty. Add a drink above!';
+          cartListEl.appendChild(emptyLi);
+        } else {
+          cartItems.forEach(function (item) {
+            totalCount += item.qty;
+            subtotal += item.unitPrice * item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+
+            const infoDiv = document.createElement('div');
+            infoDiv.className = 'cart-item-info';
+
+            const nameDiv = document.createElement('div');
+            nameDiv.className = 'cart-item-name';
+            nameDiv.textContent = item.name + ' ($' + (item.unitPrice * item.qty).toFixed(2) + ')';
+
+            const metaDiv = document.createElement('div');
+            metaDiv.className = 'cart-item-meta';
+            metaDiv.textContent = item.size + ' • ' + item.milk + (item.extraShot ? ' • +Shot' : '');
+
+            infoDiv.appendChild(nameDiv);
+            infoDiv.appendChild(metaDiv);
+
+            const controlsDiv = document.createElement('div');
+            controlsDiv.className = 'cart-item-controls';
+
+            const decBtn = document.createElement('button');
+            decBtn.type = 'button';
+            decBtn.className = 'qty-btn';
+            decBtn.setAttribute('aria-label', 'Decrease quantity of ' + item.name);
+            decBtn.textContent = '-';
+            decBtn.addEventListener('click', function () {
+              if (item.qty > 1) {
+                item.qty -= 1;
+              } else {
+                cartItems = cartItems.filter(function (i) { return i.id !== item.id; });
+              }
+              hideStatusBanner();
+              renderCart();
+            });
+
+            const qtySpan = document.createElement('span');
+            qtySpan.className = 'item-qty';
+            qtySpan.textContent = String(item.qty);
+
+            const incBtn = document.createElement('button');
+            incBtn.type = 'button';
+            incBtn.className = 'qty-btn';
+            incBtn.setAttribute('aria-label', 'Increase quantity of ' + item.name);
+            incBtn.textContent = '+';
+            incBtn.addEventListener('click', function () {
+              item.qty += 1;
+              hideStatusBanner();
+              renderCart();
+            });
+
+            const removeBtn = document.createElement('button');
+            removeBtn.type = 'button';
+            removeBtn.className = 'remove-item-btn';
+            removeBtn.setAttribute('aria-label', 'Remove ' + item.name);
+            removeBtn.innerHTML = '&times;';
+            removeBtn.addEventListener('click', function () {
+              cartItems = cartItems.filter(function (i) { return i.id !== item.id; });
+              hideStatusBanner();
+              renderCart();
+            });
+
+            controlsDiv.appendChild(decBtn);
+            controlsDiv.appendChild(qtySpan);
+            controlsDiv.appendChild(incBtn);
+            controlsDiv.appendChild(removeBtn);
+
+            li.appendChild(infoDiv);
+            li.appendChild(controlsDiv);
+            cartListEl.appendChild(li);
+          });
+        }
+
+        badgeEl.textContent = String(totalCount);
+
+        const discount = (rewardsCheckbox.checked && subtotal > 0) ? Math.min(1.00, subtotal) : 0;
+        const discountedSubtotal = Math.max(0, subtotal - discount);
+        const tax = discountedSubtotal * 0.08;
+        const total = discountedSubtotal + tax;
+
+        subtotalEl.textContent = '$' + subtotal.toFixed(2);
+        discountRowEl.style.display = discount > 0 ? 'flex' : 'none';
+        taxEl.textContent = '$' + tax.toFixed(2);
+        totalEl.textContent = '$' + total.toFixed(2);
+        checkoutBtn.disabled = cartItems.length === 0;
+      }
+
+      renderCart();
+    })();
+  </script>
 </body>
 
 </html>
