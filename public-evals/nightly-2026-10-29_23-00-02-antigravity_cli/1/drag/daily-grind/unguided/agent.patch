+    (function () {
+      const panel = document.getElementById('coffee-cart-panel');
+      const handle = document.getElementById('cart-header-handle');
+      const minimizeBtn = document.getElementById('cart-minimize-btn');
+
+      // Drag state
+      let isDragging = false;
+      let dragOffsetX = 0;
+      let dragOffsetY = 0;
+
+      function startDrag(clientX, clientY, target) {
+        if (target && target.closest && target.closest('button, a, input, select')) {
+          return false;
+        }
+        const rect = panel.getBoundingClientRect();
+        panel.style.left = rect.left + 'px';
+        panel.style.top = rect.top + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+
+        dragOffsetX = clientX - rect.left;
+        dragOffsetY = clientY - rect.top;
+        isDragging = true;
+        panel.classList.add('is-dragging');
+        return true;
+      }
+
+      function moveDrag(clientX, clientY) {
+        if (!isDragging) return;
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - handle.offsetHeight);
+        const newLeft = Math.min(Math.max(0, clientX - dragOffsetX), maxLeft);
+        const newTop = Math.min(Math.max(0, clientY - dragOffsetY), maxTop);
+
+        panel.style.left = Math.round(newLeft) + 'px';
+        panel.style.top = Math.round(newTop) + 'px';
+      }
+
+      function endDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        panel.classList.remove('is-dragging');
+      }
+
+      // Mouse events
+      handle.addEventListener('mousedown', function (e) {
+        if (e.button !== 0 && e.button !== undefined) return;
+        if (!isDragging) {
+          startDrag(e.clientX, e.clientY, e.target);
+        }
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', function () {
+        endDrag();
+      });
+
+      // Pointer events
+      handle.addEventListener('pointerdown', function (e) {
