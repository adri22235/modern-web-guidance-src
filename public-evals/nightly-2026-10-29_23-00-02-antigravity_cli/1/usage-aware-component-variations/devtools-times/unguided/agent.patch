diff --git a/src/components/SemanticCalloutBox.tsx b/src/components/SemanticCalloutBox.tsx
new file mode 100644
index 0000000..e1d4fc2
--- /dev/null
+++ b/src/components/SemanticCalloutBox.tsx
@@ -0,0 +1,216 @@
+import React, { useState } from 'react';
+import {
+  resolveCategoryTheme,
+  resolveReadingDepth,
+  inferContentIntent,
+  deriveTakeawaysFromSummary,
+  type ContentIntent,
+} from '../utils/semanticContext';
+
+interface SemanticCalloutBoxProps {
+  title: string;
+  summary: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+  promptComment?: string;
+  overrideIntent?: ContentIntent;
+}
+
+export const SemanticCalloutBox: React.FC<SemanticCalloutBoxProps> = ({
+  title,
+  summary,
+  category,
+  readingTime = 4,
+  tags = [],
+  promptComment,
+  overrideIntent,
+}) => {
+  const [activeView, setActiveView] = useState<'context' | 'methodology'>('context');
+
+  const theme = resolveCategoryTheme(category);
+  const intent =
+    overrideIntent ||
+    inferContentIntent({
+      title,
+      summary,
+      category,
+      tags,
+      readingTime,
+      prompt_comment: promptComment,
+    });
+  const depth = resolveReadingDepth(readingTime);
+  const takeaways = deriveTakeawaysFromSummary(summary, title, category);
+
+  if (intent === 'breaking') {
+    return (
+      <aside
+        className="my-6 rounded-lg border-l-4 border-l-red-600 border border-red-200 bg-gradient-to-r from-red-50/90 via-red-50/30 to-white p-5 shadow-xs"
+        data-semantic-callout="breaking"
+      >
+        <div className="flex items-center justify-between gap-2 mb-3">
+          <div className="flex items-center gap-2">
+            <span className="relative flex h-2.5 w-2.5">
+              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75" />
+              <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600" />
+            </span>
+            <span className="text-xs font-bold uppercase tracking-widest text-red-800">
+              Developing Situational Brief · {theme.displayName}
+            </span>
+          </div>
+          <span className="text-[11px] font-mono bg-red-100 text-red-900 px-2 py-0.5 rounded">
+            Priority Level 4
+          </span>
+        </div>
+        <ul className="space-y-2 text-sm text-gray-800">
+          {takeaways.map((item, idx) => (
+            <li key={idx} className="flex items-start gap-2.5">
+              <span className="font-mono text-xs font-bold text-red-700 mt-0.5">
+                0{idx + 1}
+              </span>
+              <span>{item}</span>
+            </li>
+          ))}
+        </ul>
+      </aside>
+    );
+  }
+
+  if (intent === 'investigative') {
+    return (
+      <aside
+        className="my-6 rounded-lg border border-slate-800 bg-slate-900 text-slate-100 p-5 shadow-md"
+        data-semantic-callout="investigative"
+      >
+        <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-700/80 pb-3 mb-4">
+          <div className="flex items-center gap-2">
+            <span className="px-2 py-0.5 text-[10px] font-mono uppercase tracking-widest bg-amber-400 text-slate-950 font-bold rounded">
+              Investigative Dossier
+            </span>
+            <span className="text-xs text-slate-300 font-mono">
+              {theme.groupLabel} · {depth.minutesRange}
+            </span>
+          </div>
+          <div className="flex rounded bg-slate-800 p-0.5 text-xs">
+            <button
+              type="button"
+              onClick={() => setActiveView('context')}
+              className={`px-2.5 py-1 rounded transition-colors ${
+                activeView === 'context'
+                  ? 'bg-slate-700 text-amber-300 font-semibold'
+                  : 'text-slate-400 hover:text-white'
+              }`}
+            >
+              Key Findings
+            </button>
+            <button
+              type="button"
+              onClick={() => setActiveView('methodology')}
+              className={`px-2.5 py-1 rounded transition-colors ${
+                activeView === 'methodology'
+                  ? 'bg-slate-700 text-amber-300 font-semibold'
+                  : 'text-slate-400 hover:text-white'
+              }`}
+            >
+              Verification Scope
+            </button>
+          </div>
+        </div>
+
+        {activeView === 'context' ? (
+          <div className="grid sm:grid-cols-3 gap-4">
+            {takeaways.map((point, index) => (
+              <div
+                key={index}
+                className="bg-slate-800/70 border border-slate-700/60 rounded p-3 text-xs leading-relaxed text-slate-200"
+              >
+                <div className="text-amber-400 font-mono font-bold mb-1">
+                  FINDING // 0{index + 1}
+                </div>
+                <p>{point}</p>
+              </div>
+            ))}
+          </div>
+        ) : (
+          <div className="text-xs text-slate-300 space-y-2 font-mono leading-relaxed">
+            <p>
+              • Classification: Primary-source investigative reporting ({theme.displayName} Desk).
+            </p>
+            <p>
+              • Depth Profile: {depth.label} ({readingTime} min estimated reading time).
+            </p>
+            <p>
+              • Cross-checked against public records, forensic documentation, and field interviews.
+            </p>
+          </div>
+        )}
+      </aside>
+    );
+  }
+
+  if (intent === 'analysis' || intent === 'interactive') {
+    return (
+      <aside
+        className={`my-6 rounded-lg border p-5 ${theme.badgeBorder} ${theme.surfaceTint}`}
+        data-semantic-callout={intent}
+      >
+        <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
+          <div className="flex items-center gap-2">
+            <span
+              className="w-2 h-2 rounded-full"
+              style={{ backgroundColor: theme.accentHex }}
+            />
+            <span className={`text-xs font-bold uppercase tracking-wider ${theme.kickerText}`}>
+              {intent === 'interactive' ? 'Interactive System Context' : 'Executive Synthesis'} · {theme.displayName}
+            </span>
+          </div>
+          <span className="text-xs text-gray-500 font-mono">
+            {depth.densityLabel} ({readingTime}m)
+          </span>
+        </div>
+        <div className="grid sm:grid-cols-2 gap-3 text-sm text-gray-700">
+          {takeaways.slice(0, 2).map((point, idx) => (
+            <div key={idx} className="bg-white/80 rounded p-3 border border-gray-200/80">
+              <span className="block text-[10px] font-mono uppercase tracking-wider text-gray-400 mb-1">
+                Context Vector 0{idx + 1}
+              </span>
+              <p className="text-xs sm:text-sm text-gray-800">{point}</p>
+            </div>
+          ))}
+        </div>
+      </aside>
+    );
+  }
+
+  // Feature or Standard context
+  return (
+    <aside
+      className="my-6 rounded-lg border border-amber-200/80 bg-stone-50/70 p-4 sm:p-5"
+      data-semantic-callout="feature"
+    >
+      <div className="flex items-center justify-between text-xs text-amber-900 mb-2">
+        <span className="font-semibold uppercase tracking-widest">
+          Editorial Context · {theme.displayName}
+        </span>
+        <span className="text-gray-500">{depth.label}</span>
+      </div>
+      <p className="text-sm text-gray-700 italic leading-relaxed">
+        “{takeaways[0]}”
+      </p>
+      {tags && tags.length > 0 && (
+        <div className="mt-3 flex flex-wrap gap-1.5">
+          {tags.map((tag) => (
+            <span
+              key={tag}
+              className="text-[11px] px-2 py-0.5 rounded-full bg-white border border-gray-200 text-gray-600"
+            >
+              #{tag}
+            </span>
+          ))}
+        </div>
+      )}
+    </aside>
+  );
+};
+
+export default SemanticCalloutBox;
diff --git a/src/components/SemanticContextBadge.tsx b/src/components/SemanticContextBadge.tsx
new file mode 100644
index 0000000..3687c04
--- /dev/null
+++ b/src/components/SemanticContextBadge.tsx
@@ -0,0 +1,169 @@
+import React from 'react';
+import {
+  resolveCategoryTheme,
+  resolveReadingDepth,
+  inferContentIntent,
+  type ContentIntent,
+} from '../utils/semanticContext';
+
+interface SemanticContextBadgeProps {
+  category: string;
+  intent?: ContentIntent;
+  readingTime?: number;
+  title?: string;
+  summary?: string;
+  tags?: string[];
+  promptComment?: string;
+  compact?: boolean;
+  showDepthMeter?: boolean;
+  showIntent?: boolean;
+  interactiveCategoryLink?: boolean;
+  baseUrl?: string;
+}
+
+const INTENT_LABELS: Record<ContentIntent, { label: string; classes: string; dotClass?: string }> = {
+  breaking: {
+    label: 'Breaking',
+    classes: 'bg-red-600 text-white border-red-700',
+    dotClass: 'bg-white animate-ping',
+  },
+  investigative: {
+    label: 'Investigation',
+    classes: 'bg-slate-900 text-amber-300 border-slate-700',
+  },
+  analysis: {
+    label: 'Analysis',
+    classes: 'bg-teal-900 text-teal-100 border-teal-700',
+  },
+  interactive: {
+    label: 'Live Data',
+    classes: 'bg-indigo-600 text-white border-indigo-700',
+    dotClass: 'bg-indigo-200 animate-pulse',
+  },
+  feature: {
+    label: 'Feature',
+    classes: 'bg-amber-100 text-amber-900 border-amber-300',
+  },
+  standard: {
+    label: 'Dispatch',
+    classes: 'bg-gray-100 text-gray-700 border-gray-300',
+  },
+};
+
+export const SemanticContextBadge: React.FC<SemanticContextBadgeProps> = ({
+  category,
+  intent,
+  readingTime,
+  title,
+  summary,
+  tags,
+  promptComment,
+  compact = false,
+  showDepthMeter = false,
+  showIntent = true,
+  interactiveCategoryLink = true,
+  baseUrl = import.meta.env.BASE_URL || '/',
+}) => {
+  const theme = resolveCategoryTheme(category);
+  const resolvedIntent =
+    intent ||
+    inferContentIntent({
+      title,
+      summary,
+      category,
+      tags,
+      readingTime,
+      prompt_comment: promptComment,
+    });
+  const intentMeta = INTENT_LABELS[resolvedIntent];
+  const depth = resolveReadingDepth(readingTime);
+  const categoryHref = `${baseUrl}category/${category.toLowerCase()}`;
+
+  return (
+    <div
+      className="inline-flex flex-wrap items-center gap-1.5"
+      data-semantic-group={theme.group}
+      data-semantic-intent={resolvedIntent}
+      data-semantic-depth={depth.depth}
+    >
+      {/* Category Pill */}
+      {interactiveCategoryLink ? (
+        <a
+          href={categoryHref}
+          className={`inline-flex items-center gap-1 rounded border font-semibold tracking-wider uppercase transition-colors hover:opacity-85 ${theme.badgeBg} ${theme.badgeText} ${theme.badgeBorder} ${
+            compact ? 'px-1.5 py-0.5 text-[10px]' : 'px-2 py-0.5 text-xs'
+          }`}
+        >
+          <span
+            className="w-1.5 h-1.5 rounded-full shrink-0"
+            style={{ backgroundColor: theme.accentHex }}
+          />
+          <span>{theme.displayName}</span>
+        </a>
+      ) : (
+        <span
+          className={`inline-flex items-center gap-1 rounded border font-semibold tracking-wider uppercase ${theme.badgeBg} ${theme.badgeText} ${theme.badgeBorder} ${
+            compact ? 'px-1.5 py-0.5 text-[10px]' : 'px-2 py-0.5 text-xs'
+          }`}
+        >
+          <span
+            className="w-1.5 h-1.5 rounded-full shrink-0"
+            style={{ backgroundColor: theme.accentHex }}
+          />
+          <span>{theme.displayName}</span>
+        </span>
+      )}
+
+      {/* Content Intent Pill */}
+      {showIntent && resolvedIntent !== 'standard' && (
+        <span
+          className={`inline-flex items-center gap-1 rounded border font-medium tracking-wide uppercase ${intentMeta.classes} ${
+            compact ? 'px-1.5 py-0.5 text-[10px]' : 'px-2 py-0.5 text-[11px]'
+          }`}
+          title={`Semantic Intent: ${intentMeta.label}`}
+        >
+          {intentMeta.dotClass && (
+            <span className="relative flex h-1.5 w-1.5">
+              <span
+                className={`absolute inline-flex h-full w-full rounded-full opacity-75 ${intentMeta.dotClass}`}
+              />
+              <span className="relative inline-flex rounded-full h-1.5 w-1.5 bg-current" />
+            </span>
+          )}
+          <span>{intentMeta.label}</span>
+        </span>
+      )}
+
+      {/* Optional Reading Depth Visual Meter */}
+      {showDepthMeter && readingTime !== undefined && (
+        <span
+          className={`inline-flex items-center gap-1.5 text-gray-500 font-medium ${
+            compact ? 'text-[10px]' : 'text-xs'
+          }`}
+          title={`${depth.label} (${depth.minutesRange})`}
+        >
+          <span className="inline-flex items-center gap-0.5" aria-hidden="true">
+            {[1, 2, 3].map((bar) => (
+              <span
+                key={bar}
+                className={`w-1 rounded-xs transition-all ${
+                  bar === 1 ? 'h-2' : bar === 2 ? 'h-2.5' : 'h-3'
+                } ${
+                  bar <= depth.segments
+                    ? 'bg-gray-800'
+                    : 'bg-gray-200'
+                }`}
+              />
+            ))}
+          </span>
+          <span>{readingTime}m</span>
+          {!compact && (
+            <span className="text-gray-400 hidden sm:inline">· {depth.label}</span>
+          )}
+        </span>
+      )}
+    </div>
+  );
+};
+
+export default SemanticContextBadge;
