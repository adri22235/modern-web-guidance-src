+import React, { useEffect, useState } from 'react';
+import {
+  resolveCategoryTheme,
+  resolveReadingDepth,
+  inferContentIntent,
+  type ContentIntent,
+} from '../utils/semanticContext';
+
+interface SemanticReadingHeaderProps {
+  title: string;
+  category: string;
+  readingTime?: number;
+  intent?: ContentIntent;
+}
+
+export const SemanticReadingHeader: React.FC<SemanticReadingHeaderProps> = ({
+  title,
+  category,
+  readingTime = 4,
+  intent,
+}) => {
+  const [progress, setProgress] = useState(0);
+  const [isVisible, setIsVisible] = useState(false);
+
+  const theme = resolveCategoryTheme(category);
+  const depth = resolveReadingDepth(readingTime);
+  const resolvedIntent =
+    intent || inferContentIntent({ title, category, readingTime });
+
+  useEffect(() => {
+    const handleScroll = () => {
+      const scrollTop = window.scrollY;
+      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
+      const pct = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
+      setProgress(pct);
+      setIsVisible(scrollTop > 220);
+    };
+
+    window.addEventListener('scroll', handleScroll, { passive: true });
+    handleScroll();
+    return () => window.removeEventListener('scroll', handleScroll);
+  }, []);
+
+  const remainingMinutes = Math.max(1, Math.ceil(readingTime * (1 - progress / 100)));
+
+  return (
+    <div
+      className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
+        isVisible
+          ? 'translate-y-0 opacity-100 shadow-sm'
+          : '-translate-y-full opacity-0 pointer-events-none'
+      }`}
+      data-semantic-reading-header={theme.group}
+    >
+      <div className="bg-white/95 backdrop-blur-xs border-b border-gray-200 px-4 py-2">
+        <div className="max-w-5xl mx-auto flex items-center justify-between gap-4">
+          <div className="flex items-center gap-2.5 min-w-0">
+            <span
+              className={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider shrink-0 border ${theme.badgeBg} ${theme.badgeText} ${theme.badgeBorder}`}
+            >
+              {theme.displayName}
+            </span>
+            {resolvedIntent === 'breaking' && (
+              <span className="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase bg-red-600 text-white shrink-0">
+                Breaking
+              </span>
+            )}
+            <span className="text-xs sm:text-sm font-brand text-gray-900 truncate">
+              {title}
+            </span>
+          </div>
+
+          <div className="flex items-center gap-3 shrink-0 text-xs text-gray-600">
+            <span className="hidden md:inline font-mono text-[11px] text-gray-500">
+              {depth.label}
+            </span>
+            <span className="font-mono font-semibold text-gray-800">
+              {progress >= 95 ? 'Completed' : `${remainingMinutes} min left`}
+            </span>
+          </div>
+        </div>
+      </div>
+
+      {/* Semantic Accent Progress Bar */}
+      <div className="h-1 w-full bg-gray-100 overflow-hidden">
+        <div
+          className={`h-full bg-gradient-to-r ${theme.topBarGradient} transition-all duration-150`}
+          style={{ width: `${progress}%` }}
+        />
+      </div>
+    </div>
+  );
+};
+
+export default SemanticReadingHeader;
