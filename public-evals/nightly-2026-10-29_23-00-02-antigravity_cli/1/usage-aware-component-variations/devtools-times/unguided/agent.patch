+
+export function resolveCategoryTheme(category?: string): CategoryVisualTheme {
+  const normalized = (category || 'news').trim().toLowerCase();
+  if (CATEGORY_THEMES[normalized]) {
+    return CATEGORY_THEMES[normalized];
+  }
+  if (GROUP_FALLBACK_THEMES[normalized]) {
+    return GROUP_FALLBACK_THEMES[normalized];
+  }
+  return CATEGORY_THEMES.news;
+}
+
+export function inferContentIntent(input: {
+  id?: string;
+  title?: string;
+  summary?: string;
+  category?: string;
+  tags?: string[];
+  readingTime?: number;
+  prompt_comment?: string;
+}): ContentIntent {
+  const title = (input.title || '').toLowerCase();
+  const summary = (input.summary || '').toLowerCase();
+  const category = (input.category || '').toLowerCase();
+  const tags = (input.tags || []).map((t) => t.toLowerCase());
+  const readingTime = input.readingTime ?? 4;
+
+  // Interactive / Live Telemetry articles
+  if (input.prompt_comment && (
+    input.prompt_comment.includes('plant-stats') ||
+    input.prompt_comment.includes('coffee-brew') ||
+    input.prompt_comment.includes('tide-levels') ||
+    input.prompt_comment.includes('article-popularity')
+  )) {
+    return 'interactive';
+  }
+
+  // Investigative / Deep crime or scientific inquiry
+  if (
+    readingTime >= 6 ||
+    category === 'news' ||
+    title.includes('criminal') ||
+    title.includes('forensic') ||
+    title.includes('killer') ||
+    title.includes('unraveling') ||
+    title.includes('breakthrough')
+  ) {
+    return 'investigative';
+  }
+
+  // Breaking / Urgent crisis or strike dispatches
+  if (
+    title.includes('crisis') ||
+    title.includes('strikes') ||
+    title.includes('ticking time bomb') ||
+    title.includes('crumbling') ||
+    title.includes('super bowl') ||
+    tags.includes('protests') ||
+    tags.includes('safety')
+  ) {
+    return 'breaking';
+  }
+
+  // Policy, Economic, or Industry Analysis
+  if (
+    category === 'economy' ||
+    category === 'business' ||
+    category === 'media' ||
+    category === 'urban development' ||
+    category === 'web development' ||
+    title.includes('future of') ||
+    title.includes('end of an era') ||
+    title.includes('boom') ||
+    title.includes('overhaul')
+  ) {
+    return 'analysis';
+  }
+
+  // Cultural or Lifestyle Feature
+  if (
+    category === 'culture' ||
+    category === 'lifestyle' ||
+    category === 'pets' ||
+    category === 'sports'
+  ) {
+    return 'feature';
+  }
+
+  return 'standard';
+}
+
+export function resolveReadingDepth(readingTime?: number): DepthVisualLogic {
+  const minutes = readingTime ?? 4;
+  if (minutes <= 3) {
+    return {
+      depth: 'quick',
+      label: 'Quick Dispatch',
+      minutesRange: `${minutes} min read`,
+      segments: 1,
+      recommendedDropCap: false,
+      showReadingProgress: false,
+      summaryClamp: 'line-clamp-2',
+      densityLabel: 'Compact Scan',
+    };
+  }
+  if (minutes <= 5) {
+    return {
+      depth: 'standard',
+      label: 'Standard Feature',
+      minutesRange: `${minutes} min read`,
+      segments: 2,
+      recommendedDropCap: true,
+      showReadingProgress: true,
+      summaryClamp: 'line-clamp-3',
+      densityLabel: 'Balanced Editorial',
+    };
+  }
+  return {
+    depth: 'deep-dive',
+    label: 'Longform Dossier',
+    minutesRange: `${minutes} min deep dive`,
+    segments: 3,
+    recommendedDropCap: true,
+    showReadingProgress: true,
+    summaryClamp: 'line-clamp-4',
+    densityLabel: 'Immersive Longform',
+  };
+}
+
+export function resolveTelemetryEndpoint(slug?: string, promptComment?: string): string | undefined {
+  if (!slug && !promptComment) return undefined;
+  const target = `${slug || ''} ${promptComment || ''}`.toLowerCase();
+  if (target.includes('coffee-alchemy') || target.includes('coffee-brew')) {
+    return '/api/coffee-brew';
+  }
+  if (target.includes('silent-architects') || target.includes('plant-stats')) {
+    return '/api/plant-stats';
+  }
+  if (target.includes('coastal-pulse') || target.includes('tide-levels')) {
+    return '/api/tide-levels';
+  }
+  if (target.includes('super-bowl-lx') || target.includes('article-popularity')) {
+    return '/api/article-popularity';
+  }
+  return undefined;
+}
+
+export function resolveSemanticContext(
+  articleInput: {
+    id?: string;
+    slug?: string;
+    data: {
+      title: string;
+      summary: string;
+      category: string;
+      readingTime?: number;
+      tags?: string[];
+      prompt_comment?: string;
+      author?: string;
+      date?: Date;
+    };
+  },
+  slot: PlacementSlot = 'grid-card',
+  overrideIntent?: ContentIntent
+): ResolvedSemanticContext {
+  const rawCategory = articleInput.data.category || 'news';
+  const normalizedCategory = rawCategory.trim().toLowerCase();
+  const theme = resolveCategoryTheme(normalizedCategory);
+  const inferredIntent =
+    overrideIntent ||
+    inferContentIntent({
+      id: articleInput.id || articleInput.slug,
+      title: articleInput.data.title,
+      summary: articleInput.data.summary,
+      category: rawCategory,
+      tags: articleInput.data.tags,
+      readingTime: articleInput.data.readingTime,
+      prompt_comment: articleInput.data.prompt_comment,
+    });
+
+  const intent = INTENT_LOGIC[inferredIntent];
+  const readingTimeMinutes = articleInput.data.readingTime ?? 4;
+  const depth = resolveReadingDepth(readingTimeMinutes);
+  const slotLogic = SLOT_LOGIC[slot] || SLOT_LOGIC['grid-card'];
+  const telemetryEndpoint = resolveTelemetryEndpoint(
+    articleInput.id || articleInput.slug,
+    articleInput.data.prompt_comment
+  );
+
+  return {
+    rawCategory,
+    normalizedCategory,
+    theme,
+    intent,
+    depth,
+    slot: slotLogic,
+    readingTimeMinutes,
+    hasInteractiveTelemetry: Boolean(telemetryEndpoint),
+    telemetryEndpoint,
+  };
+}
+
+export function deriveTakeawaysFromSummary(summary: string, title: string, category: string): string[] {
+  const sentences = summary
+    .split(/(?<=[.!?])\s+/)
+    .map((s) => s.trim())
+    .filter(Boolean);
+
+  const takeaways: string[] = [...sentences];
+  if (takeaways.length === 1) {
+    takeaways.push(`Contextual classification: ${resolveCategoryTheme(category).groupLabel} desk.`);
+  }
+  if (takeaways.length < 3) {
+    takeaways.push(`Key focus: ${title.replace(/:.*$/, '').trim()} and its broader systemic implications.`);
+  }
+  return takeaways.slice(0, 3);
+}
