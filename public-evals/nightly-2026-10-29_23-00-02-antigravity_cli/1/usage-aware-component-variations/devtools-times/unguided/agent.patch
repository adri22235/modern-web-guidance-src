@@ -0,0 +1,300 @@
+import React, { useEffect, useState } from 'react';
+import { type OperationalStatus } from '../utils/semanticContext';
+
+interface SemanticLiveTelemetryPanelProps {
+  endpoint: string;
+  articleSlug: string;
+  category: string;
+}
+
+interface TelemetryState {
+  status: OperationalStatus;
+  httpCode: number | null;
+  statusLabel: string;
+  headline: string;
+  diagnosticDetail: string;
+  remediationHint: string;
+  payloadPreview?: Record<string, unknown>;
+}
+
+const STATUS_VISUAL_THEMES: Record<
+  OperationalStatus,
+  {
+    container: string;
+    headerBg: string;
+    badge: string;
+    dot: string;
+    codeBg: string;
+    iconLabel: string;
+  }
+> = {
+  nominal: {
+    container: 'border-emerald-300 bg-emerald-50/40 text-emerald-950',
+    headerBg: 'bg-emerald-100/70 border-b border-emerald-200',
+    badge: 'bg-emerald-700 text-white',
+    dot: 'bg-emerald-500',
+    codeBg: 'bg-emerald-950 text-emerald-200',
+    iconLabel: 'NOMINAL // 200 OK',
+  },
+  advisory: {
+    container: 'border-amber-300 bg-amber-50/50 text-amber-950',
+    headerBg: 'bg-amber-100/70 border-b border-amber-200',
+    badge: 'bg-amber-600 text-white',
+    dot: 'bg-amber-500 animate-pulse',
+    codeBg: 'bg-stone-900 text-amber-200',
+    iconLabel: 'ADVISORY // REDIRECT / PARAM',
+  },
+  degraded: {
+    container: 'border-orange-300 bg-orange-50/50 text-orange-950',
+    headerBg: 'bg-orange-100/70 border-b border-orange-200',
+    badge: 'bg-orange-600 text-white',
+    dot: 'bg-orange-500 animate-pulse',
+    codeBg: 'bg-slate-900 text-orange-200',
+    iconLabel: 'DEGRADED // HEADER OVERFLOW',
+  },
+  critical: {
+    container: 'border-red-300 bg-red-50/50 text-red-950',
+    headerBg: 'bg-red-100/70 border-b border-red-200',
+    badge: 'bg-red-600 text-white',
+    dot: 'bg-red-600 animate-ping',
+    codeBg: 'bg-red-950 text-red-200',
+    iconLabel: 'CRITICAL // SERVER FAULT',
+  },
+};
+
+export const SemanticLiveTelemetryPanel: React.FC<SemanticLiveTelemetryPanelProps> = ({
+  endpoint,
+  articleSlug,
+  category,
+}) => {
+  const [telemetry, setTelemetry] = useState<TelemetryState>({
+    status: 'advisory',
+    httpCode: null,
+    statusLabel: 'Probing Telemetry...',
+    headline: `Connecting to ${endpoint}`,
+    diagnosticDetail: 'Evaluating semantic response state from endpoint...',
+    remediationHint: 'Inspect network request in Chrome DevTools Network panel.',
+  });
+  const [simulatedMode, setSimulatedMode] = useState<'live' | 'resolved'>('live');
+
+  useEffect(() => {
+    let isMounted = true;
+
+    async function probeEndpoint() {
+      if (simulatedMode === 'resolved') {
+        if (!isMounted) return;
+        setTelemetry({
+          status: 'nominal',
+          httpCode: 200,
+          statusLabel: '200 OK (Simulated Resolution)',
+          headline: `Endpoint ${endpoint} operating within normal parameters`,
+          diagnosticDetail:
+            'Semantic state adapted to Nominal after applying recommended request remediation.',
+          remediationHint: 'Switch back to "Live Endpoint Probe" to inspect the raw server behavior.',
+          payloadPreview: {
+            endpoint,
+            article: articleSlug,
+            semanticStatus: 'healthy',
+            timestamp: new Date().toISOString(),
+          },
+        });
+        return;
+      }
+
+      try {
+        const res = await fetch(endpoint, { credentials: 'same-origin' });
+        if (!isMounted) return;
+
+        if (res.redirected || res.status === 302 || (res.status === 404 && endpoint.includes('tide'))) {
+          setTelemetry({
+            status: 'advisory',
+            httpCode: res.status || 302,
+            statusLabel: `${res.status || 302} Redirect / Moved`,
+            headline: 'Tidal Telemetry Redirected to Unresolved V2 Path',
+            diagnosticDetail: `Request to ${endpoint} was redirected (${res.url || '/api/tide-levels-v2'}), resulting in HTTP ${res.status}.`,
+            remediationHint:
+              'Semantic Context adapted to Advisory: Endpoint relocated via 302 Found header.',
+            payloadPreview: {
+              requestedEndpoint: endpoint,
+              redirected: res.redirected,
+              finalUrl: res.url,
+              status: res.status,
+            },
+          });
+          return;
+        }
+
+        if (res.status === 431) {
+          setTelemetry({
+            status: 'degraded',
+            httpCode: 431,
+            statusLabel: '431 Request Header Fields Too Large',
+            headline: 'Botanical Telemetry Blocked by Oversized Cookie Headers',
+            diagnosticDetail:
+              'Multiple plant_stats_cache cookies exceeded the 4KB server header limit.',
+            remediationHint:
+              'Semantic Context adapted to Degraded: Clear scoped cookies or reduce header payload.',
+            payloadPreview: {
+              endpoint,
+              status: 431,
+              statusText: 'Request Header Fields Too Large',
+            },
+          });
+          return;
+        }
+
+        if (res.status === 400) {
+          let errJson: Record<string, unknown> = {};
+          try {
+            errJson = await res.json();
+          } catch {
+            // ignore
+          }
+          setTelemetry({
+            status: 'advisory',
+            httpCode: 400,
+            statusLabel: '400 Bad Request (Missing Parameter)',
+            headline: 'Popularity Telemetry Missing Required Query Identifier',
+            diagnosticDetail:
+              typeof errJson.message === 'string'
+                ? errJson.message
+                : 'Endpoint requires ?id=<slug> query parameter.',
+            remediationHint:
+              'Semantic Context adapted to Advisory: Provide ?id=' + articleSlug + ' in request URL.',
+            payloadPreview: errJson,
+          });
+          return;
+        }
+
+        if (res.status >= 500) {
+          let errJson: Record<string, unknown> = {};
+          try {
+            errJson = await res.json();
+          } catch {
+            // ignore
+          }
+          setTelemetry({
+            status: 'critical',
+            httpCode: res.status,
+            statusLabel: `${res.status} Internal Server Error`,
+            headline: 'Extraction Telemetry Fault in Brewing Subsystem',
+            diagnosticDetail:
+              typeof errJson.message === 'string'
+                ? errJson.message
+                : 'Upstream service returned an unhandled 500 error.',
+            remediationHint:
+              'Semantic Context adapted to Critical: Inspect 500 response payload in DevTools.',
+            payloadPreview: errJson,
+          });
+          return;
+        }
+
+        if (res.ok) {
+          let data: Record<string, unknown> = {};
+          try {
+            data = await res.json();
+          } catch {
+            // ignore
+          }
+          setTelemetry({
+            status: 'nominal',
+            httpCode: res.status,
+            statusLabel: `${res.status} OK`,
+            headline: 'Live Telemetry Stream Synchronized',
+            diagnosticDetail: 'Endpoint responded with valid telemetry payload.',
+            remediationHint: 'All semantic checks nominal.',
+            payloadPreview: data,
+          });
+        }
+      } catch (error) {
+        if (!isMounted) return;
+        setTelemetry({
+          status: 'critical',
+          httpCode: 0,
+          statusLabel: 'Network Exception',
+          headline: 'Telemetry Connection Interrupted',
+          diagnosticDetail: error instanceof Error ? error.message : 'Unable to reach endpoint.',
+          remediationHint: 'Verify network connectivity and CORS configuration.',
+        });
+      }
+    }
+
+    probeEndpoint();
+    return () => {
+      isMounted = false;
+    };
+  }, [endpoint, articleSlug, simulatedMode]);
+
+  const visual = STATUS_VISUAL_THEMES[telemetry.status];
+
+  return (
+    <section
+      className={`my-6 rounded-lg border-2 overflow-hidden transition-all duration-300 ${visual.container}`}
+      data-semantic-telemetry-status={telemetry.status}
+    >
+      <div className={`px-4 py-3 flex flex-wrap items-center justify-between gap-2 ${visual.headerBg}`}>
+        <div className="flex items-center gap-2.5">
+          <span className="relative flex h-2.5 w-2.5">
+            <span className={`inline-flex rounded-full h-2.5 w-2.5 ${visual.dot}`} />
+          </span>
+          <span className="font-mono text-xs font-bold uppercase tracking-wider">
+            {visual.iconLabel}
+          </span>
+          <span className={`text-[11px] font-mono px-2 py-0.5 rounded font-semibold ${visual.badge}`}>
+            {telemetry.statusLabel}
+          </span>
+        </div>
+
+        <div className="flex items-center gap-1.5 text-xs">
+          <button
+            type="button"
+            onClick={() => setSimulatedMode('live')}
+            className={`px-2 py-1 rounded font-mono text-[11px] transition-colors ${
+              simulatedMode === 'live'
+                ? 'bg-gray-900 text-white font-semibold'
+                : 'bg-white/70 text-gray-700 hover:bg-white'
+            }`}
+          >
+            Live Endpoint Probe
+          </button>
+          <button
+            type="button"
+            onClick={() => setSimulatedMode('resolved')}
+            className={`px-2 py-1 rounded font-mono text-[11px] transition-colors ${
+              simulatedMode === 'resolved'
+                ? 'bg-emerald-800 text-white font-semibold'
+                : 'bg-white/70 text-gray-700 hover:bg-white'
+            }`}
+          >
+            Simulate Healthy State
+          </button>
+        </div>
+      </div>
+
+      <div className="p-4 sm:p-5 space-y-3">
+        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
+          <div>
+            <h4 className="font-bold text-base leading-snug">{telemetry.headline}</h4>
+            <p className="text-xs sm:text-sm opacity-90 mt-1">{telemetry.diagnosticDetail}</p>
+          </div>
+          <span className="text-[11px] font-mono uppercase px-2.5 py-1 rounded bg-white/80 border border-current/20 shrink-0 self-start">
+            Endpoint: {endpoint}
+          </span>
+        </div>
+
+        {telemetry.payloadPreview && Object.keys(telemetry.payloadPreview).length > 0 && (
+          <pre className={`p-3 rounded text-xs font-mono overflow-x-auto ${visual.codeBg}`}>
+            {JSON.stringify(telemetry.payloadPreview, null, 2)}
+          </pre>
+        )}
+
+        <div className="text-xs font-mono opacity-80 pt-1 flex items-center justify-between">
+          <span>{telemetry.remediationHint}</span>
+          <span className="uppercase">Context: {category}</span>
+        </div>
+      </div>
+    </section>
+  );
+};
+
+export default SemanticLiveTelemetryPanel;
