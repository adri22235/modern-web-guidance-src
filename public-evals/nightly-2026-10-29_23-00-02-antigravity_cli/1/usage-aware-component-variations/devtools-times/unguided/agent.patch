+export type EditorialCategoryGroup =
+  | 'news-politics'
+  | 'science-tech'
+  | 'arts-culture'
+  | 'lifestyle-sports'
+  | 'business-economy';
+
+export type ContentIntent =
+  | 'breaking'
+  | 'investigative'
+  | 'analysis'
+  | 'feature'
+  | 'interactive'
+  | 'standard';
+
+export type ReadingDepth = 'quick' | 'standard' | 'deep-dive';
+
+export type PlacementSlot =
+  | 'hero'
+  | 'lead'
+  | 'feature-card'
+  | 'grid-card'
+  | 'compact-rail'
+  | 'related-rail'
+  | 'flyout-item'
+  | 'banner';
+
+export type OperationalStatus = 'nominal' | 'advisory' | 'degraded' | 'critical';
+
+export interface CategoryVisualTheme {
+  group: EditorialCategoryGroup;
+  groupLabel: string;
+  displayName: string;
+  accentHex: string;
+  badgeBg: string;
+  badgeText: string;
+  badgeBorder: string;
+  kickerText: string;
+  borderAccent: string;
+  topBarGradient: string;
+  heroOverlayGradient: string;
+  cardHoverBorder: string;
+  surfaceTint: string;
+  darkSurface: string;
+  iconType: 'globe' | 'beaker' | 'sparkles' | 'trophy' | 'chart' | 'newspaper' | 'bolt' | 'shield';
+  typographyMood: 'editorial-serif' | 'technical-mono' | 'expressive-display' | 'dynamic-sans';
+}
+
+export interface IntentVisualLogic {
+  intent: ContentIntent;
+  label: string;
+  description: string;
+  urgencyLevel: 1 | 2 | 3 | 4;
+  badgeStyle: string;
+  pulseDot: boolean;
+  cardTreatment: string;
+  headerTreatment: string;
+  calloutBorder: string;
+  calloutBg: string;
+  showMethodologyNote: boolean;
+  showKeyTakeaways: boolean;
+}
+
+export interface DepthVisualLogic {
+  depth: ReadingDepth;
+  label: string;
+  minutesRange: string;
+  segments: 1 | 2 | 3;
+  recommendedDropCap: boolean;
+  showReadingProgress: boolean;
+  summaryClamp: string;
+  densityLabel: string;
+}
+
+export interface SlotVisualLogic {
+  slot: PlacementSlot;
+  showImage: boolean;
+  showSummary: boolean;
+  showReadingDepth: boolean;
+  showTags: boolean;
+  showIntentBadge: boolean;
+  showAuthorMeta: boolean;
+  imageAspect: string;
+  headlineSize: string;
+  layoutDirection: 'split-horizontal' | 'stacked-vertical' | 'compact-row' | 'minimal-ticker';
+  paddingClass: string;
+}
+
+export interface ResolvedSemanticContext {
+  rawCategory: string;
+  normalizedCategory: string;
+  theme: CategoryVisualTheme;
+  intent: IntentVisualLogic;
+  depth: DepthVisualLogic;
+  slot: SlotVisualLogic;
+  readingTimeMinutes: number;
+  hasInteractiveTelemetry: boolean;
+  telemetryEndpoint?: string;
+}
