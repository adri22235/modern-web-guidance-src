diff --git a/src/utils/localNetwork.ts b/src/utils/localNetwork.ts
new file mode 100644
index 0000000..9f1affe
--- /dev/null
+++ b/src/utils/localNetwork.ts
@@ -0,0 +1,181 @@
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+/**
+ * Updates any matching status badge and remediation box in the DOM for the given LNA permission.
+ */
+export function updatePermissionUI(permissionName: LnaPermissionName, state: PermissionState): void {
+  if (typeof document === 'undefined') return;
+
+  const statusBadges = document.querySelectorAll<HTMLElement>(`[data-permission-status="${permissionName}"]`);
+  statusBadges.forEach((badge) => {
+    badge.textContent = state;
+  });
+
+  const remediationBoxes = document.querySelectorAll<HTMLElement>(`[data-remediation="${permissionName}"]`);
+  remediationBoxes.forEach((box) => {
+    // Show remediation instructions whenever permission is explicitly denied
+    box.hidden = state !== 'denied';
+  });
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions ('local-network' | 'loopback-network').
+ * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+ */
+export async function queryLnaPermissionSafe(permissionName: LnaPermissionName): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName as PermissionName });
+    return status.state;
+  } catch {
+    // Unrecognized permission name; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target space and keeps UI synchronized.
+ * @param permissionName 'local-network' | 'loopback-network'
+ * @param onChange Optional callback invoked whenever the permission state changes
+ */
+export async function checkNetworkPermission(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    updatePermissionUI(permissionName, 'prompt');
+    onChange?.('prompt');
+    return 'prompt';
+  }
+
+  try {
+    const status = await navigator.permissions.query({ name: permissionName as PermissionName });
+
+    // Keep UI synchronized if the user changes permission in browser site settings
+    status.addEventListener('change', () => {
+      updatePermissionUI(permissionName, status.state);
+      onChange?.(status.state);
+    });
+
+    updatePermissionUI(permissionName, status.state);
+    onChange?.(status.state);
+    return status.state;
+  } catch {
+    // Unrecognized permission name in browsers without LNA support; treat as 'prompt'
+    updatePermissionUI(permissionName, 'prompt');
+    onChange?.('prompt');
+    return 'prompt';
+  }
+}
+
+/**
+ * Infers the targetAddressSpace ('local' | 'loopback') and corresponding granular LNA permission name
+ * from an endpoint URL.
+ */
+export function inferAddressSpace(endpointUrl: string): {
+  targetAddressSpace: TargetAddressSpace;
+  permissionName: LnaPermissionName;
+} {
+  try {
+    const { hostname } = new URL(endpointUrl);
+    const normalized = hostname.replace(/^\[|\]$/g, '').toLowerCase();
+    const isLoopback =
+      normalized === 'localhost' ||
+      normalized.endsWith('.localhost') ||
+      normalized === '::1' ||
+      /^127(?:\.\d{1,3}){3}$/.test(normalized);
+
+    if (isLoopback) {
+      return { targetAddressSpace: 'loopback', permissionName: 'loopback-network' };
+    }
+  } catch {
+    // Default to local space if URL parsing fails
+  }
+  return { targetAddressSpace: 'local', permissionName: 'local-network' };
+}
+
+/**
+ * Connects to a local network device (e.g., LAN printer or IoT hub) over HTTP.
+ * Explicitly declares targetAddressSpace: 'local' for Mixed Content exemption and address space verification.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status',
+  init?: RequestInit
+): Promise< unknown > {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ * Explicitly declares targetAddressSpace: 'loopback' for Mixed Content exemption and address space verification.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  init?: RequestInit
+): Promise< unknown > {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Opens a WebSocket connection to a local network or loopback device (IP literal, .local, or localhost).
+ * Passes only subprotocol string(s) as the second argument (never a targetAddressSpace options object).
+ */
+export function openLocalWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream',
+  protocols: string | string[] = ['v1.telemetry']
+): WebSocket {
+  const socket = new WebSocket(wsUrl, protocols);
+  return socket;
+}
+
+/**
+ * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes?: BufferSource
+): Promise<WebTransport> {
+  const options: WebTransportOptions | undefined = certSha256Bytes
+    ? {
+        serverCertificateHashes: [
+          {
+            algorithm: 'sha-256',
+            value: certSha256Bytes,
+          },
+        ],
+      }
+    : undefined;
+
+  const transport = new WebTransport(wtUrl, options);
+  // transport.ready resolves only after the user grants the 'local-network' or 'loopback-network' permission
+  // and rejects with WebTransportError if the permission is denied.
+  await transport.ready;
+  return transport;
+}
