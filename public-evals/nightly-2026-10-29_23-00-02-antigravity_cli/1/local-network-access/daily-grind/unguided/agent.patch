+  <script>
+    (function () {
+      const ENDPOINTS = {
+        local: {
+          label: 'Wi-Fi Coffee Brewer',
+          targetAddressSpace: 'local',
+          primaryPermission: 'local-network',
+          fallbackPermission: 'local-network-access',
+          badgeEl: document.getElementById('local-perm-badge'),
+          permNameEl: document.getElementById('local-perm-name'),
+          permHelpEl: document.getElementById('local-perm-help'),
+          urlInputEl: document.getElementById('local-brewer-url'),
+          connectBtnEl: document.getElementById('connect-local-brewer-btn'),
+          feedbackEl: document.getElementById('local-brewer-feedback'),
+          currentPermissionState: 'unknown',
+          resolvedPermissionName: 'local-network',
+          permissionStatusObj: null
+        },
+        loopback: {
+          label: 'Companion Brewing Utility',
+          targetAddressSpace: 'loopback',
+          primaryPermission: 'loopback-network',
+          fallbackPermission: 'local-network-access',
+          badgeEl: document.getElementById('loopback-perm-badge'),
+          permNameEl: document.getElementById('loopback-perm-name'),
+          permHelpEl: document.getElementById('loopback-perm-help'),
+          urlInputEl: document.getElementById('loopback-utility-url'),
+          connectBtnEl: document.getElementById('connect-loopback-utility-btn'),
+          feedbackEl: document.getElementById('loopback-utility-feedback'),
+          currentPermissionState: 'unknown',
+          resolvedPermissionName: 'loopback-network',
+          permissionStatusObj: null
+        }
+      };
+
+      const securityBannerEl = document.getElementById('security-context-banner');
+      const securityTextEl = document.getElementById('security-context-text');
+      const refreshPermissionsBtn = document.getElementById('refresh-permissions-btn');
+
+      function updateSecurityContextBanner() {
+        if (window.isSecureContext) {
+          securityBannerEl.classList.remove('warning');
+          securityTextEl.textContent =
+            'Secure Context Active: Browser Local Network Access (local-network & loopback-network) permissions and targetAddressSpace fetch requests are available.';
+        } else {
+          securityBannerEl.classList.add('warning');
+          securityTextEl.textContent =
+            'Non-Secure Context Detected: Local Network Access requires HTTPS (or localhost). Connections to local network or loopback endpoints may be blocked by the browser.';
+        }
+      }
+
+      function describePermissionState(config, state) {
+        const permLabel = config.resolvedPermissionName;
+        const isLocal = config.targetAddressSpace === 'local';
+        const targetDesc = isLocal
+          ? 'devices on your local Wi-Fi network'
+          : 'the companion utility on your local loopback interface (127.0.0.1 / localhost)';
+
+        switch (state) {
+          case 'granted':
+            return 'Permission "' + permLabel + '" is granted. The browser allows requests to ' + targetDesc + '.';
+          case 'prompt':
+            return 'Permission "' + permLabel + '" will prompt on connect. Clicking Connect will ask your browser for permission to access ' + targetDesc + '.';
+          case 'denied':
+            return 'Permission "' + permLabel + '" is denied. The browser will block connections to ' + targetDesc + '. Re-enable it in your browser site settings to connect.';
+          default:
+            return 'The "' + config.primaryPermission + '" permission query is not supported in this browser version. You can still test connecting with targetAddressSpace: "' + config.targetAddressSpace + '".';
+        }
+      }
+
+      function renderPermissionUI(config, state, permissionNameUsed) {
+        config.currentPermissionState = state;
+        if (permissionNameUsed) {
+          config.resolvedPermissionName = permissionNameUsed;
+          config.permNameEl.textContent = permissionNameUsed;
+        }
+
+        const badge = config.badgeEl;
+        badge.className = 'permission-badge';
+
+        if (state === 'granted') {
+          badge.classList.add('granted');
+          badge.textContent = 'Granted';
+        } else if (state === 'prompt') {
+          badge.classList.add('prompt');
+          badge.textContent = 'Prompt Required';
+        } else if (state === 'denied') {
+          badge.classList.add('denied');
+          badge.textContent = 'Denied';
+        } else {
+          badge.classList.add('unsupported');
+          badge.textContent = 'Unsupported';
+        }
+
+        config.permHelpEl.textContent = describePermissionState(config, state);
+      }
+
+      async function queryEndpointPermission(config) {
+        if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
+          renderPermissionUI(config, 'unsupported', config.primaryPermission);
+          return 'unsupported';
+        }
+
+        const namesToTry = [config.primaryPermission, config.fallbackPermission];
+        for (const permName of namesToTry) {
+          try {
+            const status = await navigator.permissions.query({ name: permName });
+            if (config.permissionStatusObj !== status) {
+              config.permissionStatusObj = status;
+              status.onchange = function () {
+                renderPermissionUI(config, status.state, permName);
+              };
+            }
+            renderPermissionUI(config, status.state, permName);
+            return status.state;
+          } catch (_err) {
+            // Try fallback permission name if primary split permission name is unrecognized
+          }
+        }
+
+        renderPermissionUI(config, 'unsupported', config.primaryPermission);
+        return 'unsupported';
+      }
+
+      async function refreshAllPermissions() {
+        updateSecurityContextBanner();
+        await Promise.all([
+          queryEndpointPermission(ENDPOINTS.local),
+          queryEndpointPermission(ENDPOINTS.loopback)
+        ]);
+      }
+
+      function setFeedback(config, type, title, message, detailsText) {
+        const el = config.feedbackEl;
+        el.className = 'status-feedback ' + type;
+        el.textContent = '';
+
+        const strong = document.createElement('strong');
+        strong.textContent = title;
+        el.appendChild(strong);
+
+        const span = document.createElement('span');
+        span.textContent = message;
+        el.appendChild(span);
+
+        if (detailsText) {
+          const details = document.createElement('div');
+          details.className = 'status-details';
+          details.textContent = detailsText;
+          el.appendChild(details);
+        }
+      }
+
+      async function connectToEndpoint(config) {
+        const rawUrl = config.urlInputEl.value.trim();
+        if (!rawUrl) {
+          setFeedback(
+            config,
+            'error',
+            'Error: Missing Endpoint URL',
+            'Please enter a valid HTTP or HTTPS URL for the ' + config.label + '.'
+          );
+          return;
+        }
+
+        let parsedUrl;
+        try {
+          parsedUrl = new URL(rawUrl);
+          if (parsedUrl.protocol !== 'http:' && parsedUrl.protocol !== 'https:') {
+            throw new Error('Protocol must be http: or https:');
+          }
+        } catch (err) {
+          setFeedback(
+            config,
+            'error',
+            'Error: Invalid URL Format',
+            'Please provide a complete URL starting with http:// or https://.',
+            err && err.message ? err.message : String(err)
+          );
+          return;
+        }
+
+        if (!window.isSecureContext) {
+          setFeedback(
+            config,
+            'error',
+            'Error: Secure Context Required',
+            'Local Network Access requests require a secure context (HTTPS or localhost). Current origin is not secure.',
+            'targetAddressSpace="' + config.targetAddressSpace + '" blocked in insecure context.'
+          );
+          return;
+        }
+
+        const preState = await queryEndpointPermission(config);
+        if (preState === 'denied') {
+          setFeedback(
+            config,
+            'error',
+            'Permission Denied (' + config.resolvedPermissionName + ')',
+            'Your browser has blocked access to ' +
+              (config.targetAddressSpace === 'local'
+                ? 'local network devices'
+                : 'the local loopback interface') +
+              '. Please allow "' +
+              config.resolvedPermissionName +
+              '" in your browser site permissions and try again.',
+            'Blocked before request: navigator.permissions state is "denied" for ' + config.resolvedPermissionName + '.'
+          );
+          return;
+        }
+
+        config.connectBtnEl.disabled = true;
+        setFeedback(
+          config,
+          'loading',
+          'Connecting to ' + config.label + '...',
+          'Sending fetch request to ' +
+            parsedUrl.href +
+            ' with targetAddressSpace: "' +
+            config.targetAddressSpace +
+            '". If prompted by your browser, allow "' +
+            config.resolvedPermissionName +
+            '" access.'
+        );
+
+        const controller = new AbortController();
+        const timeoutId = setTimeout(function () {
+          controller.abort();
+        }, 6000);
+
+        try {
+          const requestInit = {
+            method: 'GET',
+            mode: 'cors',
+            targetAddressSpace: config.targetAddressSpace,
+            signal: controller.signal,
+            headers: {
+              Accept: 'application/json, text/plain;q=0.9, */*;q=0.8'
+            }
+          };
+
+          const response = await fetch(parsedUrl.href, requestInit);
+          clearTimeout(timeoutId);
+          await queryEndpointPermission(config);
+
+          if (!response.ok) {
+            setFeedback(
+              config,
+              'error',
+              'Connection Error: HTTP ' + response.status + ' ' + (response.statusText || ''),
+              'Reached ' + config.label + ', but the endpoint returned an error status code.',
+              'GET ' + parsedUrl.href + ' (targetAddressSpace: "' + config.targetAddressSpace + '") -> HTTP ' + response.status
+            );
+            return;
+          }
+
+          const contentType = response.headers.get('content-type') || '';
+          let payloadPreview = '';
+          if (contentType.includes('application/json')) {
+            const data = await response.json();
+            payloadPreview = JSON.stringify(data);
+          } else {
+            const text = await response.text();
+            payloadPreview = text.slice(0, 200) || 'OK (empty response body)';
+          }
+
+          setFeedback(
+            config,
+            'success',
+            'Connected to ' + config.label,
+            'Successfully communicated with ' + parsedUrl.host + ' via "' + config.targetAddressSpace + '" address space.',
+            'Response: ' + payloadPreview
+          );
+        } catch (err) {
+          clearTimeout(timeoutId);
+          const postState = await queryEndpointPermission(config);
+
+          if (postState === 'denied') {
+            setFeedback(
+              config,
+              'error',
+              'Permission Denied (' + config.resolvedPermissionName + ')',
+              'The connection was blocked because the "' +
+                config.resolvedPermissionName +
+                '" permission was denied. Enable local/loopback network access in your browser address bar settings to connect.',
+              (err && err.name ? err.name + ': ' : '') + (err && err.message ? err.message : String(err))
+            );
+          } else if (err && err.name === 'AbortError') {
+            setFeedback(
+              config,
+              'error',
+              'Connection Timed Out',
+              'No response received from ' +
+                parsedUrl.host +
+                ' within 6 seconds. Verify the ' +
+                config.label +
+                ' is powered on, reachable, and listening on ' +
+                parsedUrl.href +
+                '.',
+              'AbortError: Request timed out (targetAddressSpace: "' + config.targetAddressSpace + '")'
+            );
+          } else {
+            setFeedback(
+              config,
+              'error',
+              'Connection Failed (' + config.label + ')',
+              'Could not reach ' +
+                parsedUrl.href +
+                '. Ensure the device/utility is running, allows CORS requests from this origin, and "' +
+                config.resolvedPermissionName +
+                '" permission is allowed in your browser.',
+              (err && err.name ? err.name + ': ' : '') +
+                (err && err.message ? err.message : String(err)) +
+                ' [targetAddressSpace: "' +
+                config.targetAddressSpace +
+                '", permission: "' +
+                postState +
+                '"]'
+            );
+          }
+        } finally {
+          config.connectBtnEl.disabled = false;
+        }
+      }
+
+      ENDPOINTS.local.connectBtnEl.addEventListener('click', function () {
+        connectToEndpoint(ENDPOINTS.local);
+      });
+
+      ENDPOINTS.loopback.connectBtnEl.addEventListener('click', function () {
+        connectToEndpoint(ENDPOINTS.loopback);
+      });
+
+      refreshPermissionsBtn.addEventListener('click', function () {
+        refreshAllPermissions();
+      });
+
+      refreshAllPermissions();
+    })();
+  </script>
 </body>
 
