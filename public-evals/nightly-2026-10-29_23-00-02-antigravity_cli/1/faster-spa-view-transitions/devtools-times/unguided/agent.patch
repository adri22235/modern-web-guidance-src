+    <script>
+      import {
+        deselectScripts,
+        swapRootAttributes,
+      } from "astro:transitions/client";
+
+      interface CachedView {
+        main: HTMLElement;
+        title: string;
+      }
+
+      const viewCache = new Map<string, CachedView>();
+      (window as any).__viewCache = viewCache;
+      (window as any).viewCache = viewCache;
+
+      function getCacheKey(url: URL | Location): string {
+        return url.pathname + url.search;
+      }
+
+      function getMainContainer(doc: Document = document): HTMLElement | null {
+        return (
+          (doc.getElementById("app-view-container") as HTMLElement | null) ||
+          (doc.querySelector("main.bg-white.relative") as HTMLElement | null) ||
+          (doc.querySelector("main") as HTMLElement | null)
+        );
+      }
+
+      function preserveIslands(root: ParentNode) {
+        const islands = root.querySelectorAll("astro-island");
+        islands.forEach((island) => {
+          (island as any).unmount = () => {};
+          island.addEventListener(
+            "astro:unmount",
+            (e) => {
+              e.stopImmediatePropagation();
+            },
+            { capture: true }
+          );
+        });
+      }
+
+      function syncHeadAndDirectiveScripts(newDocument: Document, newMain: HTMLElement) {
+        document.title = newDocument.title;
+
+        // Append any newly introduced styles or links from newDocument.head without removing existing ones
+        const headElements = newDocument.head.querySelectorAll(
+          "style, link[rel='stylesheet'], script"
+        );
+        headElements.forEach((el) => {
+          const isDuplicate = Array.from(
+            document.head.querySelectorAll(el.tagName)
+          ).some((existing) => existing.isEqualNode(el));
+          if (!isDuplicate) {
+            document.head.appendChild(el.cloneNode(true));
+          }
+        });
+
+        // Ensure any body-level scripts outside <main> (e.g. Astro client directive scripts like client:visible) are preserved
+        const bodyScripts = Array.from(newDocument.body.querySelectorAll("script")).filter(
+          (script) => !newMain.contains(script)
+        );
+        bodyScripts.forEach((script) => {
+          const isDuplicate = Array.from(
+            document.querySelectorAll("script")
+          ).some((existing) => existing.isEqualNode(script));
+          if (!isDuplicate) {
+            newMain.appendChild(script);
+          }
+        });
+      }
+
+      function cacheCurrentView(url: URL | Location = window.location) {
+        const currentMain = getMainContainer(document);
+        if (currentMain) {
+          preserveIslands(currentMain);
+          viewCache.set(getCacheKey(url), {
+            main: currentMain,
+            title: document.title,
+          });
+        }
+      }
+
+      // Cache initial page view on load
+      cacheCurrentView(window.location);
+
+      document.addEventListener("astro:before-preparation", (event: any) => {
+        cacheCurrentView(event.from || window.location);
+
+        const targetKey = getCacheKey(event.to);
+        if (viewCache.has(targetKey) && !event.formData) {
+          // Skip network fetch and DOM parsing when transitioning back to a cached view
+          event.loader = async () => {};
+        }
+      });
+
+      document.addEventListener("astro:before-swap", (event: any) => {
+        const fromKey = getCacheKey(event.from || window.location);
+        const toKey = getCacheKey(event.to);
+
+        event.swap = () => {
+          const currentMain = getMainContainer(document);
+          if (currentMain) {
+            preserveIslands(currentMain);
+            viewCache.set(fromKey, {
+              main: currentMain,
+              title: document.title,
+            });
+          }
+
+          const cached = viewCache.get(toKey);
+          if (cached && !event.formData) {
+            document.title = cached.title;
+            if (currentMain && currentMain !== cached.main) {
+              preserveIslands(cached.main);
+              currentMain.replaceWith(cached.main);
+            }
+            return;
+          }
+
+          if (event.newDocument) {
+            deselectScripts(event.newDocument);
+            swapRootAttributes(event.newDocument);
+
+            const newMain = getMainContainer(event.newDocument);
+            if (currentMain && newMain) {
+              syncHeadAndDirectiveScripts(event.newDocument, newMain);
+              preserveIslands(newMain);
+              currentMain.replaceWith(newMain);
+              viewCache.set(toKey, {
+                main: newMain,
+                title: document.title,
+              });
+            }
+          }
+        };
+      });
+    </script>
