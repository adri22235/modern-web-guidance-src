+    select.custom-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.custom-select::picker-icon {
+      color: var(--primary);
+    }
+
+    select.custom-select button {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      background: none;
+      border: none;
+      color: inherit;
+      font: inherit;
+      padding: 0;
+      width: 100%;
+      text-align: left;
+      cursor: pointer;
+    }
+
+    select.custom-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+    }
+
+    select.custom-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.custom-select::picker(select) {
+      background-color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      padding: 8px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.35);
+      width: anchor-size(width);
+      color: var(--text);
+    }
+
+    select.custom-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    select.custom-select option:hover {
+      background-color: var(--secondary);
+    }
+
+    select.custom-select option::before,
+    select.custom-select option::checkmark {
+      display: none;
+    }
+
+    select.custom-select option:checked {
+      background-color: var(--primary);
+      color: #ffffff;
+    }
+
+    select.custom-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.custom-select option:checked .option-desc {
+      color: var(--secondary);
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+      color: currentColor;
+    }
+
+    .option-text {
+      display: flex;
