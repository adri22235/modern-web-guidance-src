+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+      const sections = Array.from(document.querySelectorAll('.seasonal-panel .drink-section'));
+
+      if (!panel || tocLinks.length === 0 || sections.length === 0) return;
+
+      let programmaticTargetId = null;
+      let programmaticTimer = null;
+
+      function setActiveSection(activeId) {
+        if (!activeId) return;
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + activeId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function syncActiveFromScroll() {
+        const panelRect = panel.getBoundingClientRect();
+        if (programmaticTargetId) {
+          const targetEl = document.getElementById(programmaticTargetId);
+          if (targetEl) {
+            const dist = Math.abs(targetEl.getBoundingClientRect().top - panelRect.top);
+            if (dist <= 8) {
+              programmaticTargetId = null;
+              if (programmaticTimer) {
+                clearTimeout(programmaticTimer);
+                programmaticTimer = null;
+              }
+            } else {
+              return;
+            }
+          }
+        }
+
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const header = section.querySelector('header') || section;
+          const rect = header.getBoundingClientRect();
+          const distance = Math.abs(rect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        if (closestSection && closestSection.id) {
+          setActiveSection(closestSection.id);
+        }
+      }
+
+      // IntersectionObserver to detect snapped sections inside .seasonal-panel
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (programmaticTargetId) return;
+            let bestEntry = null;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            });
+            if (bestEntry && bestEntry.target.id && bestEntry.intersectionRatio >= 0.5) {
+              setActiveSection(bestEntry.target.id);
+            } else {
+              syncActiveFromScroll();
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.5, 0.65, 0.8]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      panel.addEventListener('scroll', syncActiveFromScroll, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        programmaticTargetId = null;
+        if (programmaticTimer) {
+          clearTimeout(programmaticTimer);
+          programmaticTimer = null;
+        }
+        syncActiveFromScroll();
+      }, { passive: true });
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+
+          programmaticTargetId = targetId;
+          if (programmaticTimer) clearTimeout(programmaticTimer);
+          programmaticTimer = setTimeout(() => {
+            programmaticTargetId = null;
+            syncActiveFromScroll();
+          }, 700);
+
+          setActiveSection(targetId);
+
+          const targetHeader = targetSection.querySelector('header') || targetSection;
+          const panelRect = panel.getBoundingClientRect();
+          const headerRect = targetHeader.getBoundingClientRect();
+          const targetScrollTop = panel.scrollTop + (headerRect.top - panelRect.top);
+
+          panel.scrollTo({
+            top: targetScrollTop,
+            behavior: 'smooth'
+          });
+        });
+      });
+
+      syncActiveFromScroll();
+    })();
+  </script>
 </body>
 
