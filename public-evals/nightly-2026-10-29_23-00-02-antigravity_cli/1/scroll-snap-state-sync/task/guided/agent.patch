+          if (sectionId) setActiveDrink(sectionId);
+        },
+        { root: panel, threshold: [0, 0.5, 0.9] }
+      );
+
+      drinkHeaders.forEach((header) => observer.observe(header));
+    }
+
+    // 3. Smoothly scroll the panel to the target drink section on TOC link click
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetSection = document.getElementById(targetId);
+
+        if (panel && targetSection && panel.contains(targetSection)) {
+          event.preventDefault();
+          programmaticTargetId = targetId;
+          clearTimeout(programmaticScrollTimer);
+          programmaticScrollTimer = setTimeout(() => {
+            programmaticTargetId = null;
+          }, 700);
+
+          setActiveDrink(targetId);
+
+          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          panel.scrollTo({
+            top: targetSection.offsetTop,
+            behavior: prefersReducedMotion ? 'auto' : 'smooth',
+          });
+        }
+      });
+    });
+
+    // 4. Sync initial state on load
+    const initialId = findClosestDrinkId();
+    if (initialId) {
+      setActiveDrink(initialId);
+    }
+  </script>
 </body>
 
 </html>
