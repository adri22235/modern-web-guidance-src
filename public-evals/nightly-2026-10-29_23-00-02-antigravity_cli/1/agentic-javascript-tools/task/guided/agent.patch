diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,101 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal Favorites",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        price: "$5.50",
+        calories: 210,
+        ingredients: ["Espresso", "Steamed oat milk", "Pure Vermont maple syrup", "Cinnamon dusting"],
+        dietary: ["Vegan", "Dairy-Free"],
+        url: "/menu/seasonal"
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        price: "$3.25",
+        calories: 5,
+        ingredients: ["100% Arabica dark roast coffee beans", "Filtered water"],
+        dietary: ["Vegan", "Gluten-Free", "Dairy-Free", "Sugar-Free"],
+        url: "/menu/espresso"
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Coffee",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        price: "$4.75",
+        calories: 15,
+        ingredients: ["Coarse-ground single-origin coffee beans", "Cold filtered water"],
+        dietary: ["Vegan", "Gluten-Free", "Dairy-Free", "Unsweetened"],
+        url: "/menu/cold-brew"
+      }
+    ];
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+
+      window.addEventListener("pagehide", () => controller.abort(), { once: true });
+      window.addEventListener("beforeunload", () => controller.abort(), { once: true });
+      window.addEventListener("unload", () => controller.abort(), { once: true });
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Looks up details for a coffee shop menu item, including its description, price, ingredients, calories, and dietary information. Use when the user asks about a specific drink on the menu.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "Title of the drink or menu item to look up."
+              }
+            },
+            required: ["itemName"]
+          },
+          execute(input = {}) {
+            const rawName =
+              typeof input?.itemName === "string"
+                ? input.itemName
+                : typeof input?.name === "string"
+                  ? input.name
+                  : "";
+            const normalizedName = rawName.trim().toLowerCase();
+
+            if (!normalizedName) {
+              return {
+                error: "Provide a non-empty menu item title to look up.",
+                availableItems: menuItems.map((entry) => entry.name)
+              };
+            }
+
+            const item = menuItems.find(
+              (entry) => entry.name.toLowerCase() === normalizedName
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${rawName.trim()}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name)
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true
+          }
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
+
 </body>
 
 </html>
