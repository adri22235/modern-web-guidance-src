diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,145 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const TOOL_NAME = 'getMenuItemDetails';
+      const controller = new AbortController();
+
+      function findMenuItemDetails(queryName) {
+        if (!queryName || typeof queryName !== 'string') {
+          return null;
+        }
+        const normalizedQuery = queryName.trim().toLowerCase();
+
+        const cards = Array.from(document.querySelectorAll('.card'));
+        const items = cards.map((card) => {
+          const titleEl = card.querySelector('h3');
+          const descEl = card.querySelector('p');
+          const linkEl = card.querySelector('a');
+          return {
+            name: titleEl ? titleEl.textContent.trim() : '',
+            description: descEl ? descEl.textContent.trim() : '',
+            url: linkEl ? linkEl.getAttribute('href') : ''
+          };
+        }).filter((item) => item.name);
+
+        return (
+          items.find((item) => item.name.toLowerCase() === normalizedQuery) ||
+          items.find(
+            (item) =>
+              item.name.toLowerCase().includes(normalizedQuery) ||
+              normalizedQuery.includes(item.name.toLowerCase())
+          ) ||
+          null
+        );
+      }
+
+      const toolDefinition = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item (such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew) by its name and return its name, description, and details URL.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up (e.g., "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew").'
+            },
+            itemName: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up (alias for name).'
+            }
+          },
+          required: ['name']
+        },
+        annotations: {
+          readOnlyHint: true
+        },
+        execute: async (input = {}) => {
+          const query =
+            typeof input === 'string'
+              ? input
+              : input.name || input.itemName || input.item || input.query || '';
+          const item = findMenuItemDetails(query);
+
+          if (!item) {
+            return {
+              found: false,
+              error: `Menu item "${query}" not found.`,
+              content: [
+                {
+                  type: 'text',
+                  text: `Menu item "${query}" was not found on the menu.`
+                }
+              ]
+            };
+          }
+
+          return {
+            found: true,
+            ...item,
+            item,
+            content: [
+              {
+                type: 'text',
+                text: `${item.name}: ${item.description} (Details: ${item.url})`
+              }
+            ]
+          };
+        }
+      };
+
+      let unregisterFn = null;
+
+      function registerMenuTool() {
+        const mc = navigator.modelContext || document.modelContext;
+        if (!mc || typeof mc.registerTool !== 'function') {
+          return;
+        }
+
+        try {
+          const registration = mc.registerTool(toolDefinition, {
+            signal: controller.signal
+          });
+          if (registration && typeof registration.unregister === 'function') {
+            unregisterFn = () => registration.unregister();
+          } else if (typeof registration === 'function') {
+            unregisterFn = registration;
+          }
+        } catch (err) {
+          try {
+            mc.registerTool(toolDefinition);
+          } catch (_) {}
+        }
+      }
+
+      function cleanupMenuTool() {
+        controller.abort();
+        if (typeof unregisterFn === 'function') {
+          try {
+            unregisterFn();
+          } catch (_) {}
+          unregisterFn = null;
+        }
+        const mc = navigator.modelContext || document.modelContext;
+        if (mc && typeof mc.unregisterTool === 'function') {
+          try {
+            mc.unregisterTool(TOOL_NAME);
+          } catch (_) {}
+        }
+      }
+
+      registerMenuTool();
+
+      window.addEventListener('pagehide', cleanupMenuTool);
+      window.addEventListener('beforeunload', cleanupMenuTool);
+      window.addEventListener('unload', cleanupMenuTool);
+    })();
+  </script>
 </body>
 
 </html>
