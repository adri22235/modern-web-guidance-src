+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      function installMinimalSchedulerFallback() {
+        if (!window.scheduler) {
+          window.scheduler = {};
+        }
+        if (typeof window.scheduler.postTask !== 'function') {
+          const pendingQueue = [];
+          let isFlushing = false;
+
+          function flushQueue() {
+            if (pendingQueue.length === 0) {
+              isFlushing = false;
+              return;
+            }
+            pendingQueue.sort((a, b) => a.weight - b.weight || a.seq - b.seq);
+            const nextTask = pendingQueue.shift();
+            Promise.resolve()
+              .then(() => nextTask.callback())
+              .then(nextTask.resolve, nextTask.reject)
+              .finally(() => {
+                setTimeout(flushQueue, 0);
+              });
+          }
+
+          let seqCounter = 0;
+          window.scheduler.postTask = function (callback, options = {}) {
+            const priority = options.priority || 'user-visible';
+            const weight = PRIORITY_WEIGHTS[priority] ?? 1;
+            return new Promise((resolve, reject) => {
+              pendingQueue.push({
+                callback,
+                weight,
+                seq: ++seqCounter,
+                resolve,
+                reject
+              });
+              if (!isFlushing) {
+                isFlushing = true;
+                setTimeout(flushQueue, 0);
+              }
+            });
+          };
+        }
+      }
+
+      // Feature detect the scheduler API and load polyfill if needed
+      if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => {
+          initOperationsSimulator();
+        };
+        script.onerror = () => {
+          installMinimalSchedulerFallback();
+          initOperationsSimulator();
+        };
+        document.head.appendChild(script);
+      } else {
+        initOperationsSimulator();
+      }
+
+      let taskCounter = 0;
+      let queuedCount = 0;
+      let completedCount = 0;
+      let totalYieldCount = 0;
+      let uiPingCount = 0;
+
+      const metricQueuedEl = document.getElementById('metric-queued');
+      const metricCompletedEl = document.getElementById('metric-completed');
+      const metricYieldsEl = document.getElementById('metric-yields');
+      const progressEl = document.getElementById('ops-progress');
+      const statusAnnouncementEl = document.getElementById('ops-status-announcement');
+      const logListEl = document.getElementById('ops-log');
+      const uiPingCountEl = document.getElementById('ui-ping-count');
+
+      function updateMetricsUI() {
+        metricQueuedEl.textContent = String(queuedCount);
+        metricCompletedEl.textContent = String(completedCount);
+        metricYieldsEl.textContent = String(totalYieldCount);
+      }
+
+      function processItem(itemIndex) {
+        // Perform a small synchronous computation slice (~1.5ms)
+        const sliceEnd = performance.now() + 1.5;
+        let checksum = itemIndex;
+        while (performance.now() < sliceEnd) {
+          checksum = (checksum * 31 + 17) % 1000003;
+        }
+        return checksum;
+      }
+
+      // Break up long tasks using a 50ms deadline and scheduler.yield() with setTimeout fallback
+      async function processLargeOperationWithFallback(items, onProgress) {
+        let deadline = performance.now() + 50;
+        let taskYields = 0;
+
+        for (let i = 0; i < items.length; i++) {
+          processItem(items[i]);
+
+          if (performance.now() >= deadline) {
+            taskYields++;
+            totalYieldCount++;
+            updateMetricsUI();
+            if (onProgress) {
+              onProgress(Math.round(((i + 1) / items.length) * 100));
+            }
+            if ('scheduler' in window && 'yield' in window.scheduler) {
+              await scheduler.yield();
+            } else {
+              await new Promise(resolve => setTimeout(resolve, 0));
+            }
+            deadline = performance.now() + 50;
+          }
+        }
+
+        if (onProgress) {
+          onProgress(100);
+        }
+        return taskYields;
+      }
+
+      function createLogEntry(taskId, label, priority) {
+        const li = document.createElement('li');
+        li.className = 'ops-log-item';
+        li.dataset.priority = priority;
+        li.dataset.taskId = String(taskId);
+
+        const titleSpan = document.createElement('span');
+        const badge = document.createElement('span');
+        badge.className = `ops-badge ${priority}`;
+        badge.textContent = priority;
+
+        const nameText = document.createElement('strong');
+        nameText.textContent = ` #${taskId} ${label}`;
+
+        titleSpan.append(badge, nameText);
+
+        const detailsSpan = document.createElement('span');
+        detailsSpan.className = 'ops-log-details';
+        detailsSpan.textContent = 'Running...';
+
+        li.append(titleSpan, detailsSpan);
+        logListEl.appendChild(li);
+        return detailsSpan;
+      }
+
+      function scheduleOperation(label, priority, itemCount = 45) {
+        installMinimalSchedulerFallback();
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateMetricsUI();
+
+        const items = Array.from({ length: itemCount }, (_, idx) => idx + 1);
+
+        const runTask = async () => {
+          const startTime = performance.now();
+          const detailsSpan = createLogEntry(taskId, label, priority);
+          progressEl.value = 10;
+
+          const yieldsUsed = await processLargeOperationWithFallback(items, (pct) => {
+            progressEl.value = pct;
+          });
+
+          const elapsedMs = Math.round(performance.now() - startTime);
+          queuedCount = Math.max(0, queuedCount - 1);
+          completedCount++;
+          updateMetricsUI();
+
+          detailsSpan.textContent = `Completed in ${elapsedMs}ms (${yieldsUsed} yield${yieldsUsed === 1 ? '' : 's'})`;
+          statusAnnouncementEl.textContent = `Completed #${taskId} ${label} (${priority}) in ${elapsedMs}ms.`;
+        };
+
+        if (priority === 'user-blocking') {
+          return scheduler.postTask(() => {
+            return runTask();
+          }, { priority: 'user-blocking' });
+        }
+
+        if (priority === 'background') {
+          return scheduler.postTask(() => {
+            return runTask();
+          }, { priority: 'background' });
+        }
+
+        // Default 'user-visible' priority task
+        return scheduler.postTask(() => {
+          return runTask();
+        }, { priority: 'user-visible' });
+      }
+
+      function initOperationsSimulator() {
+        const btnUrgent = document.getElementById('btn-urgent-checkout');
+        const btnMenu = document.getElementById('btn-menu-update');
+        const btnTelemetry = document.getElementById('btn-telemetry-log');
+        const btnBatch = document.getElementById('btn-mixed-batch');
+        const btnClear = document.getElementById('btn-clear-log');
+        const btnPing = document.getElementById('btn-ui-ping');
+
+        btnUrgent.addEventListener('click', () => {
+          scheduleOperation('Urgent Checkout Task', 'user-blocking', 45);
+        });
+
+        btnMenu.addEventListener('click', () => {
+          scheduleOperation('Standard Menu Update', 'user-visible', 45);
+        });
+
+        btnTelemetry.addEventListener('click', () => {
+          scheduleOperation('Background Telemetry Logging', 'background', 45);
+        });
+
+        btnBatch.addEventListener('click', () => {
+          statusAnnouncementEl.textContent = 'Queued mixed batch: executing in priority order (user-blocking, user-visible, background).';
+          // Enqueue in reverse priority order to demonstrate scheduler.postTask reordering
+          scheduleOperation('Background Telemetry Logging (Batch)', 'background', 45);
+          scheduleOperation('Standard Menu Update (Batch)', 'user-visible', 45);
+          scheduleOperation('Urgent Checkout Task (Batch)', 'user-blocking', 45);
+        });
+
+        btnClear.addEventListener('click', () => {
+          logListEl.replaceChildren();
+          completedCount = 0;
+          totalYieldCount = 0;
+          progressEl.value = 0;
+          updateMetricsUI();
+          statusAnnouncementEl.textContent = 'Execution log cleared.';
+        });
+
+        btnPing.addEventListener('click', () => {
+          uiPingCount++;
+          uiPingCountEl.textContent = String(uiPingCount);
+        });
+      }
+    })();
+  </script>
 </body>
 
