+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 1,
+        'user-visible': 2,
+        'background': 3
+      };
+
+      const TASK_CONFIGS = {
+        checkout: {
+          label: 'Urgent Checkout Task',
+          shortLabel: 'Urgent Checkout',
+          priority: 'user-blocking',
+          chunks: 4,
+          chunkWorkMs: 6,
+          description: 'Processing express payment & order confirmation'
+        },
+        menu: {
+          label: 'Standard Menu Update',
+          shortLabel: 'Menu Update',
+          priority: 'user-visible',
+          chunks: 4,
+          chunkWorkMs: 6,
+          description: 'Syncing seasonal roast inventory & pricing'
+        },
+        telemetry: {
+          label: 'Background Telemetry Logging',
+          shortLabel: 'Telemetry Log',
+          priority: 'background',
+          chunks: 4,
+          chunkWorkMs: 6,
+          description: 'Uploading anonymized brewer diagnostics'
+        }
+      };
+
+      let taskCounter = 0;
+      let queuedCount = 0;
+      let completedCount = 0;
+      let activeTaskName = null;
+      const completedOrder = [];
+
+      const queueListEl = document.getElementById('task-queue-list');
+      const logEl = document.getElementById('execution-log');
+      const statQueuedEl = document.getElementById('stat-queued');
+      const statActiveEl = document.getElementById('stat-active');
+      const statCompletedEl = document.getElementById('stat-completed');
+      const executionOrderEl = document.getElementById('execution-order');
+      const schedulerBadgeEl = document.getElementById('scheduler-mode-badge');
+      const pingBtn = document.getElementById('btn-ui-ping');
+      const pingCountEl = document.getElementById('ui-ping-count');
+
+      let pingCount = 0;
+      pingBtn.addEventListener('click', () => {
+        pingCount += 1;
+        pingCountEl.textContent = String(pingCount);
+      });
+
+      const hasNativeScheduler =
+        typeof window.scheduler !== 'undefined' &&
+        typeof window.scheduler.postTask === 'function';
+
+      if (hasNativeScheduler) {
+        schedulerBadgeEl.textContent = 'scheduler.postTask Active';
+      } else {
+        schedulerBadgeEl.textContent = 'Priority Queue Fallback';
+      }
+
+      // Fallback priority queue when window.scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackProcessing = false;
+
+      function scheduleWithPriority(callback, priority) {
+        if (hasNativeScheduler) {
+          return window.scheduler.postTask(callback, { priority });
+        }
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            weight: PRIORITY_WEIGHTS[priority] || 2,
+            seq: fallbackQueue.length,
+            resolve,
+            reject
+          });
+          fallbackQueue.sort((a, b) => a.weight - b.weight || a.seq - b.seq);
+          processFallbackQueue();
+        });
+      }
+
+      async function processFallbackQueue() {
+        if (fallbackProcessing) return;
+        fallbackProcessing = true;
+        await new Promise((r) => setTimeout(r, 0));
+        while (fallbackQueue.length > 0) {
+          const next = fallbackQueue.shift();
+          try {
+            const res = await next.callback();
+            next.resolve(res);
+          } catch (err) {
+            next.reject(err);
+          }
+        }
+        fallbackProcessing = false;
+      }
+
+      // Yield to main thread during long tasks to keep UI responsive
+      async function yieldToMain(priority) {
+        if (typeof window.scheduler !== 'undefined' && typeof window.scheduler.yield === 'function') {
+          await window.scheduler.yield();
+        } else if (hasNativeScheduler) {
+          await window.scheduler.postTask(() => {}, { priority: priority || 'user-visible' });
+        } else {
+          await new Promise((resolve) => setTimeout(resolve, 0));
+        }
+      }
+
+      function simulateChunkWork(durationMs) {
+        const start = performance.now();
+        let acc = 0;
+        while (performance.now() - start < durationMs) {
+          acc += Math.sqrt(start + acc + 1);
+        }
+        return acc;
+      }
+
+      function updateStats() {
+        statQueuedEl.textContent = String(queuedCount);
+        statActiveEl.textContent = activeTaskName || 'Idle';
+        statCompletedEl.textContent = String(completedCount);
+        executionOrderEl.textContent =
+          completedOrder.length > 0 ? completedOrder.join(' → ') : 'None';
+      }
+
+      function appendLog(message, priority) {
+        const entry = document.createElement('div');
+        entry.className = 'log-entry' + (priority ? ' log-' + priority : '');
+        const timestamp = new Date().toLocaleTimeString('en-US', {
+          hour12: false,
+          hour: '2-digit',
+          minute: '2-digit',
+          second: '2-digit'
+        });
+        entry.textContent = `[${timestamp}] ${message}`;
+        logEl.appendChild(entry);
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      function createTaskElement(task) {
+        const emptyEl = document.getElementById('queue-empty-state');
+        if (emptyEl) {
+          emptyEl.remove();
+        }
+
+        const li = document.createElement('li');
+        li.className = 'task-item';
+        li.id = `task-item-${task.id}`;
+        li.dataset.taskId = String(task.id);
+        li.dataset.priority = task.priority;
+        li.dataset.taskType = task.type;
+        li.dataset.status = 'queued';
+
+        li.innerHTML = `
+          <div class="task-item-top">
+            <span class="task-name">#${task.id} ${task.label}</span>
+            <span class="badge badge-${task.priority}">${task.priority}</span>
+          </div>
+          <div class="task-item-top">
+            <span class="task-status">Queued</span>
+            <span class="task-progress-text">0%</span>
+          </div>
+          <div class="progress-track">
+            <div class="progress-fill" style="width: 0%"></div>
+          </div>
+        `;
+
+        queueListEl.appendChild(li);
+        return li;
+      }
+
+      function enqueueTask(type) {
+        const config = TASK_CONFIGS[type];
+        if (!config) return null;
+
+        taskCounter += 1;
+        const task = {
+          id: taskCounter,
+          type,
+          label: config.label,
+          shortLabel: config.shortLabel,
+          priority: config.priority,
+          chunks: config.chunks,
+          chunkWorkMs: config.chunkWorkMs,
+          description: config.description
+        };
+
+        queuedCount += 1;
+        updateStats();
+
+        const itemEl = createTaskElement(task);
+        const statusEl = itemEl.querySelector('.task-status');
+        const progressTextEl = itemEl.querySelector('.task-progress-text');
+        const progressFillEl = itemEl.querySelector('.progress-fill');
+
+        appendLog(
+          `Queued #${task.id} ${task.label} (${task.priority})`,
+          task.priority
+        );
+
+        return scheduleWithPriority(async () => {
+          queuedCount = Math.max(0, queuedCount - 1);
+          activeTaskName = `#${task.id} ${task.shortLabel} (${task.priority})`;
+          itemEl.dataset.status = 'running';
+          statusEl.textContent = `Running: ${task.description}`;
+          updateStats();
+
+          const startTime = performance.now();
+          appendLog(
+            `Started #${task.id} ${task.label} [${task.priority}]`,
+            task.priority
+          );
+
+          for (let i = 1; i <= task.chunks; i++) {
+            simulateChunkWork(task.chunkWorkMs);
+            const pct = Math.round((i / task.chunks) * 100);
+            progressFillEl.style.width = `${pct}%`;
+            progressTextEl.textContent = `${pct}%`;
+
+            if (i < task.chunks) {
+              statusEl.textContent = `Yielding to UI (${i}/${task.chunks})...`;
+              await yieldToMain(task.priority);
+              statusEl.textContent = `Running (${i}/${task.chunks})...`;
+            }
+          }
+
+          const elapsed = Math.max(1, Math.round(performance.now() - startTime));
+          itemEl.dataset.status = 'completed';
+          statusEl.textContent = `Completed in ${elapsed}ms`;
+          completedCount += 1;
+          completedOrder.push(`${task.shortLabel} (${task.priority})`);
+          activeTaskName = null;
+          updateStats();
+
+          appendLog(
+            `Completed #${task.id} ${task.label} [${task.priority}] in ${elapsed}ms`,
+            task.priority
+          );
+
+          return task;
+        }, task.priority);
+      }
+
+      function enqueueMixedBatch() {
+        appendLog(
+          '--- Queuing Mixed Batch (Enqueued: Telemetry -> Menu Update -> Urgent Checkout) ---'
+        );
+        // Queue in reverse priority order to prove priority scheduling executes
+        // Urgent Checkout (user-blocking) -> Standard Menu Update (user-visible) -> Background Telemetry (background)
+        const batchTypes = [
+          'telemetry',
+          'menu',
+          'checkout',
+          'telemetry',
+          'menu',
+          'checkout'
+        ];
+        batchTypes.forEach((type) => enqueueTask(type));
+      }
+
+      document
+        .getElementById('btn-urgent-checkout')
+        .addEventListener('click', () => enqueueTask('checkout'));
+
+      document
+        .getElementById('btn-menu-update')
+        .addEventListener('click', () => enqueueTask('menu'));
+
+      document
+        .getElementById('btn-telemetry-log')
+        .addEventListener('click', () => enqueueTask('telemetry'));
+
+      document
+        .getElementById('btn-batch-tasks')
+        .addEventListener('click', () => enqueueMixedBatch());
+
+      document
+        .getElementById('btn-clear-queue')
+        .addEventListener('click', () => {
+          completedCount = 0;
+          completedOrder.length = 0;
+          queueListEl.innerHTML =
+            '<li id="queue-empty-state" class="empty-state">No operations queued yet. Use the buttons above to schedule tasks.</li>';
+          logEl.innerHTML =
+            '<div class="log-entry">[System] Log cleared. Ready for new tasks.</div>';
+          updateStats();
+        });
+    })();
+  </script>
 </body>
 
