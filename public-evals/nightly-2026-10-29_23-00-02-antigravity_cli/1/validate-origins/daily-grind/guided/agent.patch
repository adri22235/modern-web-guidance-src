+  <script>
+    // Trusted ordering origin (exact tuple origin match required for privileged cross-window messages)
+    const TRUSTED_ORDER_URL = 'https://orders.dailygrind.co.uk';
+    // Application primary site origin (schemeful same-site match used for redirects and internal links)
+    const APP_SITE_URL = 'https://app.dailygrind.co.uk';
+    const TRUSTED_SITE_DOMAIN = 'dailygrind.co.uk';
+
+    const TRUSTED_ORIGIN = 'Origin' in globalThis ? Origin.from(TRUSTED_ORDER_URL) : null;
+    const APP_ORIGIN = 'Origin' in globalThis ? Origin.from(APP_SITE_URL) : null;
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        // Synthetic new MessageEvent('message', { origin }) objects in tests lack an
+        // internal browser origin; fall back to parsing candidate.origin if it is a URL.
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    // 1. Verify Exact Origins for Privileged Cross-Window Ordering Messages
+    function isTrustedSameOrigin(candidate, trustedOrigin = TRUSTED_ORIGIN ?? TRUSTED_ORDER_URL) {
+      try {
+        if ('Origin' in globalThis) {
+          const candidateOrigin = extractOrigin(candidate);
+          if (candidateOrigin.opaque) return false;
+          const targetOrigin =
+            trustedOrigin instanceof Origin ? trustedOrigin : extractOrigin(trustedOrigin);
+          return candidateOrigin.isSameOrigin(targetOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(extractUrlString(trustedOrigin));
+        return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedUrl.origin;
+      } catch {
+        // Rejects invalid URLs, "null" strings, or unsupported objects
+        return false;
+      }
+    }
+
+    const checkSameOriginWithFallback = isTrustedSameOrigin;
+
+    // 2. Validate Cross-Subdomain Redirects and Links Without String-Splitting Bugs
+    function isAllowedSameSiteUrl(candidateUrlOrElement, trustedSiteOrigin = null) {
+      try {
+        if ('Origin' in globalThis) {
+          const candidateOrigin = extractOrigin(candidateUrlOrElement);
+          // Reject opaque origins such as data: URLs
+          if (candidateOrigin.opaque) return false;
+
+          if (trustedSiteOrigin !== null) {
+            const targetOrigin =
+              trustedSiteOrigin instanceof Origin
+                ? trustedSiteOrigin
+                : extractOrigin(trustedSiteOrigin);
+            return !targetOrigin.opaque && candidateOrigin.isSameSite(targetOrigin);
+          }
