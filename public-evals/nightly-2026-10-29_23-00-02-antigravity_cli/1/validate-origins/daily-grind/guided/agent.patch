+          if (APP_ORIGIN && candidateOrigin.isSameSite(APP_ORIGIN)) {
+            return true;
+          }
+
+          const currentContextOrigin = Origin.from(self);
+          return !currentContextOrigin.opaque && candidateOrigin.isSameSite(currentContextOrigin);
+        }
+
+        const candidateUrl = new URL(extractUrlString(candidateUrlOrElement));
