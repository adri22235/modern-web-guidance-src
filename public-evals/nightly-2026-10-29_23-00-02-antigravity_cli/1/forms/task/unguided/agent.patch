+
+        const pct = Math.round((currentStep / steps.length) * 100);
+        if (progressFill) {
+          progressFill.style.width = pct + '%';
+        }
+        if (progressBar) {
+          progressBar.setAttribute('aria-valuenow', String(currentStep));
+          progressBar.setAttribute('aria-valuetext', stepTitles[currentStep] || ('Step ' + currentStep + ' of 3'));
+        }
+        if (liveAnnouncer) {
+          liveAnnouncer.textContent = stepTitles[currentStep] || ('Step ' + currentStep + ' of 3');
+        }
+
+        if (errorSummary) {
+          errorSummary.hidden = true;
+        }
+
+        if (currentStep === 3) {
+          populateReviewSummary();
+        }
+
+        if (moveFocus) {
+          const activeStepEl = document.getElementById('step-' + currentStep);
+          if (activeStepEl) {
+            const legend = activeStepEl.querySelector('.step-legend');
+            if (legend) {
+              legend.focus();
+            }
+          }
+        }
+      }
+
+      // Wire step navigation buttons
+      form.addEventListener('click', function (event) {
+        const nextBtn = event.target.closest('[data-next-step]');
+        if (nextBtn) {
+          event.preventDefault();
+          const nextStepNum = Number(nextBtn.getAttribute('data-next-step'));
+          const result = validateStep(currentStep);
+          if (result.valid) {
+            goToStep(nextStepNum, true);
+          }
+          return;
+        }
+
+        const prevBtn = event.target.closest('[data-prev-step]');
+        if (prevBtn) {
+          event.preventDefault();
+          const prevStepNum = Number(prevBtn.getAttribute('data-prev-step'));
+          goToStep(prevStepNum, true);
+        }
+      });
+
+      // Inline validation: validate on blur, clear/re-check immediately on input if invalid
+      const allFields = Array.from(
+        form.querySelectorAll('input:not([type="hidden"]):not([type="radio"]), select, textarea')
+      );
+
+      allFields.forEach(function (field) {
+        field.addEventListener('blur', function () {
+          if (field.value !== '' || field.getAttribute('aria-invalid') === 'true') {
+            validateField(field, true);
+          }
+        });
+
+        field.addEventListener('input', function () {
+          if (field.id === 'password') {
+            updatePasswordStrengthUI();
+            if (confirmPasswordInput && confirmPasswordInput.value !== '') {
+              validateField(confirmPasswordInput, confirmPasswordInput.getAttribute('aria-invalid') === 'true');
+            }
+          }
+          if (field.getAttribute('aria-invalid') === 'true') {
+            validateField(field, true);
+          }
+        });
+
+        field.addEventListener('change', function () {
+          if (field.type === 'checkbox' || field.tagName === 'SELECT' || field.type === 'date') {
+            validateField(field, true);
+          }
+        });
+      });
+
+      // Accessible password visibility toggles
+      function setupPasswordToggle(buttonId, inputId, showLabel, hideLabel) {
+        const btn = document.getElementById(buttonId);
+        const input = document.getElementById(inputId);
+        if (!btn || !input) return;
+
+        btn.addEventListener('click', function () {
+          const isHidden = input.type === 'password';
+          input.type = isHidden ? 'text' : 'password';
+          btn.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
+          btn.setAttribute('aria-label', isHidden ? hideLabel : showLabel);
+          btn.textContent = isHidden ? 'Hide' : 'Show';
+        });
+      }
+
+      setupPasswordToggle('toggle-password', 'password', 'Show password', 'Hide password');
+      setupPasswordToggle('toggle-confirm-password', 'confirm-password', 'Show confirm password', 'Hide confirm password');
+
+      // Secure Form Submission Handler
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+
+        // Prevent duplicate submissions
+        if (isSubmitting) return;
+
+        // Anti-bot honeypot check
+        if (honeypotInput && honeypotInput.value !== '') {
+          return;
+        }
+
+        // Validate all steps in order so no step can be bypassed
+        for (let s = 1; s <= steps.length; s++) {
+          const check = validateStep(s);
+          if (!check.valid) {
+            if (currentStep !== s) {
+              goToStep(s, false);
+              check.invalidFields[0].focus();
+            }
+            return;
+          }
+        }
+
+        isSubmitting = true;
+        form.setAttribute('aria-busy', 'true');
+
+        // Ensure password fields are masked before completion
+        if (passwordInput) passwordInput.type = 'password';
+        if (confirmPasswordInput) confirmPasswordInput.type = 'password';
+
+        if (submitBtn) {
+          submitBtn.disabled = true;
+          submitBtn.setAttribute('aria-busy', 'true');
+          submitBtn.textContent = 'Creating Your Account...';
+        }
+
+        // Normalize text fields before completing submission
+        ['first-name', 'last-name', 'email', 'phone', 'postal-code'].forEach(function (id) {
+          const el = document.getElementById(id);
+          if (el) {
+            el.value = sanitizeValue(el.value);
+          }
+        });
+
+        const memberFirstName = sanitizeValue(document.getElementById('first-name').value);
+        const memberEmail = sanitizeValue(document.getElementById('email').value);
+
+        // Complete registration and present accessible confirmation state
+        form.hidden = true;
+        if (errorSummary) errorSummary.hidden = true;
+        if (successMessage) {
+          successMessage.textContent =
+            'Thank you, ' +
+            memberFirstName +
+            '! We have sent a verification link and your digital rewards card to ' +
+            memberEmail +
+            '.';
+        }
+        if (successBox) {
+          successBox.hidden = false;
+          successBox.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
