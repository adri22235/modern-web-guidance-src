+  <script type="module">
+    const CALENDAR_CONFIGS = [
+      {
+        id: 'islamic-umalqura',
+        locale: 'en-u-ca-islamic-umalqura',
+        cardId: 'card-islamic-umalqura',
+        includeEra: true
+      },
+      {
+        id: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        cardId: 'card-hebrew',
+        includeEra: true
+      },
+      {
+        id: 'japanese',
+        locale: 'en-u-ca-japanese',
+        cardId: 'card-japanese',
+        includeEra: true
+      }
+    ];
+
+    // 1. Helper to check calendar support
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        // Fallback for environments where supportedValuesOf is not available
+        return false;
+      }
+    }
+
+    function renderCalendarCard(config, selectedIsoDate, todayIsoDate) {
+      const card = document.getElementById(config.cardId);
+      if (!card) return;
+
+      const calendarId = config.id;
+      const supported = isCalendarSupported(calendarId);
+
+      // Convert to target calendar if supported, otherwise fall back to ISO 8601
+      const targetDate = supported
+        ? selectedIsoDate.withCalendar(calendarId)
+        : selectedIsoDate;
+
+      const todayInCalendar = supported
+        ? todayIsoDate.withCalendar(calendarId)
+        : todayIsoDate;
+
+      const resolvedCalendarId = targetDate.calendarId ?? (targetDate.calendar && targetDate.calendar.id) ?? calendarId;
+      if (resolvedCalendarId !== calendarId) {
+        console.warn(`Calendar ${calendarId} not supported; falling back to ISO 8601`);
+      }
+
+      // 1. Formatted localized date (including era names for era-based calendars like Japanese)
+      const formatOptions = {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric'
+      };
+      if (config.includeEra) {
+        formatOptions.era = 'long';
+      }
+      const localizedDisplay = targetDate.toLocaleString(config.locale, formatOptions);
+
+      const formattedDateEl = card.querySelector('[data-field="formatted-date"]');
+      if (formattedDateEl) {
+        formattedDateEl.textContent = localizedDisplay;
+      }
+
+      const calIdEl = card.querySelector('[data-field="calendar-id"]');
+      if (calIdEl) {
+        calIdEl.textContent = resolvedCalendarId;
+      }
+
+      // 2. Converted year, numeric month, and unique stable month code (e.g., M05L)
+      const yearEl = card.querySelector('[data-field="year"]');
+      if (yearEl) {
+        yearEl.textContent = String(targetDate.year);
+      }
+
+      const monthEl = card.querySelector('[data-field="month"]');
+      if (monthEl) {
+        monthEl.textContent = String(targetDate.month);
+      }
+
+      const monthCodeEl = card.querySelector('[data-field="month-code"]');
+      if (monthCodeEl) {
+        monthCodeEl.textContent = targetDate.monthCode;
+      }
+
+      // 3. Total number of months in that specific calendar year (respecting lunisolar leap years)
+      const monthsInYearEl = card.querySelector('[data-field="months-in-year"]');
+      if (monthsInYearEl) {
+        monthsInYearEl.textContent = String(targetDate.monthsInYear);
+      }
+
+      // 4. Timeline comparison using Temporal.PlainDate.compare() within the same calendar
+      const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+      const relative = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      const timelineEl = card.querySelector('[data-field="timeline"]');
+      if (timelineEl) {
+        timelineEl.textContent = relative;
+        timelineEl.className = `timeline-badge timeline-${relative.toLowerCase()}`;
+      }
+
+      // 5. Month breakdown showing each month's code and days in that month for that specific year
+      const breakdownContainer = card.querySelector('[data-field="month-breakdown"]');
+      if (breakdownContainer) {
+        breakdownContainer.replaceChildren();
+        for (let m = 1; m <= targetDate.monthsInYear; m++) {
+          const monthDate = targetDate.with({ month: m, day: 1 });
+          const pill = document.createElement('span');
+          pill.className = 'month-pill';
+          if (monthDate.monthCode === targetDate.monthCode) {
+            pill.classList.add('active-month');
+          }
+          if (monthDate.monthCode.endsWith('L')) {
+            pill.classList.add('leap-month');
+          }
+          pill.dataset.month = String(m);
+          pill.dataset.monthCode = monthDate.monthCode;
+          pill.dataset.days = String(monthDate.daysInMonth);
+          pill.textContent = `${monthDate.monthCode}: ${monthDate.daysInMonth} days`;
+          breakdownContainer.appendChild(pill);
+        }
+      }
+    }
+
+    function updateAllCalendars(isoDateString) {
+      const todayIso = Temporal.Now.plainDateISO();
+      let selectedIso = todayIso;
+
+      if (isoDateString) {
+        try {
+          selectedIso = Temporal.PlainDate.from(isoDateString);
+        } catch {
+          selectedIso = todayIso;
+        }
+      }
+
+      for (const config of CALENDAR_CONFIGS) {
+        renderCalendarCard(config, selectedIso, todayIso);
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('calendar-date-input');
+      const todayIso = Temporal.Now.plainDateISO();
+
+      if (dateInput) {
+        if (!dateInput.value) {
+          dateInput.value = todayIso.toString();
+        }
+        const handleDateChange = (event) => {
+          updateAllCalendars(event.target.value);
+        };
+        dateInput.addEventListener('input', handleDateChange);
+        dateInput.addEventListener('change', handleDateChange);
+        updateAllCalendars(dateInput.value);
+      } else {
+        updateAllCalendars(todayIso.toString());
+      }
+    }
+
+    // Check if Temporal is supported natively and load temporal-polyfill conditionally
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
