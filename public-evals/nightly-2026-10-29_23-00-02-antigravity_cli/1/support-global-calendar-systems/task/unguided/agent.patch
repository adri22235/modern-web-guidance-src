+  <script type="module">
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') {
+        return globalThis.Temporal;
+      }
+      const mod = await import('https://esm.sh/@js-temporal/polyfill');
+      globalThis.Temporal = mod.Temporal;
+      return mod.Temporal;
+    }
+
+    const CALENDAR_CONFIGS = [
+      {
+        key: 'islamic',
+        id: 'islamic-umalqura',
+        locale: 'en-u-ca-islamic-umalqura',
+        formatOptions: {
+          calendar: 'islamic-umalqura',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        key: 'hebrew',
+        id: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        formatOptions: {
+          calendar: 'hebrew',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        key: 'japanese',
+        id: 'japanese',
+        locale: 'ja-JP-u-ca-japanese',
+        formatOptions: {
+          calendar: 'japanese',
+          era: 'long',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      }
+    ];
+
+    function getTimelineStatus(Temporal, selectedIsoDate, todayIsoDate) {
+      const comparison = Temporal.PlainDate.compare(selectedIsoDate, todayIsoDate);
+      if (comparison < 0) return { label: 'Past', className: 'timeline-badge timeline-past' };
+      if (comparison > 0) return { label: 'Future', className: 'timeline-badge timeline-future' };
+      return { label: 'Today', className: 'timeline-badge timeline-today' };
+    }
+
+    function buildMonthBreakdown(calDate) {
+      const totalMonths = calDate.monthsInYear;
+      const breakdown = [];
+      let cursor = calDate.with({ month: 1, day: 1 });
+      for (let m = 1; m <= totalMonths; m++) {
+        breakdown.push({
+          month: cursor.month,
+          monthCode: cursor.monthCode,
+          daysInMonth: cursor.daysInMonth,
+          isCurrent: cursor.monthCode === calDate.monthCode
+        });
+        if (m < totalMonths) {
+          cursor = cursor.add({ months: 1 });
+        }
+      }
+      return breakdown;
+    }
+
+    function renderCalendars(Temporal, isoDateString) {
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = Temporal.PlainDate.from(isoDateString);
+      } catch {
+        return;
+      }
+
+      const todayIsoDate = Temporal.Now.plainDateISO();
+      const timeline = getTimelineStatus(Temporal, selectedIsoDate, todayIsoDate);
+
+      for (const config of CALENDAR_CONFIGS) {
+        const calDate = selectedIsoDate.withCalendar(config.id);
+
+        // 1. Formatted localized date (with era names for Japanese, #islamic-date for Islamic)
+        const formattedString = calDate.toLocaleString(config.locale, config.formatOptions);
+        const dateEl = document.getElementById(`${config.key}-date`);
+        if (dateEl) {
+          dateEl.textContent = formattedString;
+        }
+
+        // 2. Converted year, numeric month, and unique stable month code
+        const yearEl = document.getElementById(`${config.key}-year`);
+        if (yearEl) {
+          yearEl.textContent = config.id === 'japanese' && calDate.era
+            ? `${calDate.year} (${calDate.era} ${calDate.eraYear})`
+            : String(calDate.year);
+        }
+
+        const monthEl = document.getElementById(`${config.key}-month`);
+        if (monthEl) {
+          monthEl.textContent = String(calDate.month);
+        }
+
+        const monthCodeEl = document.getElementById(`${config.key}-month-code`);
+        if (monthCodeEl) {
+          monthCodeEl.textContent = calDate.monthCode;
+        }
+
+        // 3. Total number of months in that specific calendar year
+        const monthsInYearEl = document.getElementById(`${config.key}-months-in-year`);
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(calDate.monthsInYear);
+        }
+
+        // 4. Timeline label comparing selected date against current date ('Past', 'Future', or 'Today')
+        const timelineEl = document.getElementById(`${config.key}-timeline`);
+        if (timelineEl) {
+          timelineEl.textContent = timeline.label;
+          timelineEl.className = timeline.className;
+        }
+
+        // 5. Month breakdown showing each month's code and days in that month for that year
+        const breakdownContainer = document.getElementById(`${config.key}-breakdown`);
+        if (breakdownContainer) {
+          const breakdown = buildMonthBreakdown(calDate);
+          breakdownContainer.innerHTML = '';
+          for (const item of breakdown) {
+            const chip = document.createElement('div');
+            chip.className = item.isCurrent ? 'month-chip active-month' : 'month-chip';
+            chip.innerHTML = `<span class="month-code">${item.monthCode}</span><span class="month-days">${item.daysInMonth} days</span>`;
+            breakdownContainer.appendChild(chip);
+          }
+        }
+      }
+    }
+
+    async function initCalendarTool() {
+      const Temporal = await ensureTemporal();
+      const datePicker = document.getElementById('calendar-date-picker');
+      const todayIso = Temporal.Now.plainDateISO();
+
+      if (datePicker) {
+        if (!datePicker.value) {
+          datePicker.value = todayIso.toString();
+        }
+        renderCalendars(Temporal, datePicker.value);
+
+        const handleDateChange = (e) => {
+          if (e.target.value) {
+            renderCalendars(Temporal, e.target.value);
+          }
+        };
+        datePicker.addEventListener('input', handleDateChange);
+        datePicker.addEventListener('change', handleDateChange);
+      }
+    }
+
+    initCalendarTool();
+  </script>
 </body>
 
 </html>
