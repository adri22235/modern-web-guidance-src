+  <script>
+    (function () {
+      const lockup = document.querySelector('.hero-poster-lockup');
+      if (!lockup) return;
+
+      const lines = Array.from(lockup.querySelectorAll('.hero-poster-line'));
+
+      function fitPosterLines() {
+        const targetWidth = lockup.clientWidth;
+        if (targetWidth <= 0) return;
+
+        const baseSize = 100;
+        lines.forEach((line) => {
+          const inner = line.querySelector('.hero-poster-line-inner') || line;
+          line.style.fontSize = baseSize + 'px';
+          const measuredWidth = inner.getBoundingClientRect().width;
+          if (measuredWidth > 0) {
+            const fittedSize = (baseSize * targetWidth) / measuredWidth;
+            line.style.fontSize = fittedSize + 'px';
+          }
+        });
+      }
+
+      fitPosterLines();
+      window.addEventListener('resize', fitPosterLines);
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitPosterLines);
+      }
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(fitPosterLines).observe(lockup);
+      }
+    })();
+  </script>
+
