+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('theme-toggle');
+
+      function getStoredScheme() {
+        try {
+          const value = localStorage.getItem('color-scheme');
+          return value === 'light' || value === 'dark' ? value : null;
+        } catch {
+          return null;
+        }
+      }
+
+      function syncFallbackClasses(scheme) {
+        if (!CSS.supports('selector(:has(*))')) {
+          document.documentElement.classList.toggle('theme-dark', scheme === 'dark');
+          document.documentElement.classList.toggle('theme-light', scheme === 'light');
+        }
+      }
+
+      syncFallbackClasses(meta.content);
+
+      toggle.addEventListener('click', () => {
+        const systemScheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+        const currentMeta = meta.content === 'light' || meta.content === 'dark' ? meta.content : null;
+        const currentRendered = getStoredScheme() ?? currentMeta ?? systemScheme;
+        const targetScheme = currentRendered === 'dark' ? 'light' : 'dark';
+
+        if (targetScheme !== systemScheme) {
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+          meta.content = targetScheme;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+          meta.content = 'light dark';
+        }
+        syncFallbackClasses(meta.content);
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          const stored = event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : null;
+          meta.content = stored ?? 'light dark';
+          syncFallbackClasses(meta.content);
+        }
+      });
+    })();
+  </script>
+
