+  <script>
+    const alertElement = document.querySelector('#promo-alert');
+    alertElement?.addEventListener('transitionend', (e) => {
+      if (e.propertyName === 'block-size' && (alertElement.matches(':has(.alert-dismiss-input:checked)') || alertElement.classList.contains('is-dismissed'))) {
+        alertElement.hidden = true;
+      }
+    });
+
+    if (!CSS.supports('selector(:has(*))')) {
+      const toggle = document.querySelector('.alert-dismiss-input');
+      if (toggle && alertElement) {
+        toggle.addEventListener('change', (e) => {
+          alertElement.classList.toggle('is-dismissed', e.target.checked);
+        });
+      }
+    }
+  </script>
