+  <script>
+    (function () {
+      const ACTION_COLOR = '#e53935';
+      const DEFAULT_ITEM_BG = '#bcaaa4';
+      let activeSwipe = null;
+
+      function getClientX(event) {
+        if (event.touches && event.touches.length > 0) {
+          return event.touches[0].clientX;
+        }
+        if (event.changedTouches && event.changedTouches.length > 0) {
+          return event.changedTouches[0].clientX;
+        }
+        if (typeof event.clientX === 'number') {
+          return event.clientX;
+        }
+        return null;
+      }
+
+      function updateCartSummary() {
+        const list = document.querySelector('.SwipeableList');
+        if (!list) return;
+        const remainingItems = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        let total = 0;
+        remainingItems.forEach(function (item) {
+          const price = parseFloat(item.getAttribute('data-price') || '0');
+          if (!Number.isNaN(price)) {
+            total += price;
+          }
+        });
+
+        const countEl = document.getElementById('cart-count');
+        const totalEl = document.getElementById('cart-total');
+        const emptyEl = document.getElementById('cart-empty');
+
+        if (countEl) countEl.textContent = String(remainingItems.length);
+        if (totalEl) totalEl.textContent = '$' + total.toFixed(2);
+        if (emptyEl) {
+          emptyEl.classList.toggle('is-visible', remainingItems.length === 0);
+        }
+      }
+
+      function collapseAndRemoveItem(item, track, direction) {
+        if (item.dataset.removing === 'true') return;
+        item.dataset.removing = 'true';
+
+        const currentHeight = item.offsetHeight;
+        item.style.height = currentHeight + 'px';
+        item.style.backgroundColor = ACTION_COLOR;
+        item.classList.add('is-past-threshold');
+
+        if (track) {
+          track.style.backgroundColor = ACTION_COLOR;
+          track.classList.remove('is-dragging');
+          const slideOutX = (direction >= 0 ? 1 : -1) * (item.offsetWidth || 400);
+          track.style.transform = 'translateX(' + slideOutX + 'px)';
+        }
+
+        // Force layout reflow so height transition starts smoothly from currentHeight
+        void item.offsetHeight;
+
+        item.classList.add('is-removing');
+        item.style.height = '0px';
+        item.style.marginBottom = '0px';
+        item.style.paddingTop = '0px';
+        item.style.paddingBottom = '0px';
+        item.style.opacity = '0';
+
+        updateCartSummary();
+
+        let finalized = false;
+        function finalizeRemoval() {
+          if (finalized) return;
+          finalized = true;
+          if (item.parentNode) {
+            item.parentNode.removeChild(item);
+          }
+          updateCartSummary();
+        }
+
+        item.addEventListener('transitionend', function onTransitionEnd(e) {
+          if (e.target === item && (e.propertyName === 'height' || e.propertyName === 'opacity')) {
+            item.removeEventListener('transitionend', onTransitionEnd);
+            finalizeRemoval();
+          }
+        });
+
+        setTimeout(finalizeRemoval, 400);
+      }
+
+      function handleSwipeStart(event) {
+        if (activeSwipe) return;
+        if (event.type === 'mousedown' && event.button !== 0) return;
+
+        const target = event.target && event.target.closest ? event.target : null;
+        if (!target) return;
+
+        const item = target.closest('.SwipeableList-item');
+        if (!item || item.dataset.removing === 'true') return;
+
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        const startX = getClientX(event);
+        if (startX === null) return;
+
+        const width = item.offsetWidth || 300;
+        const threshold = Math.min(90, Math.max(50, width * 0.2));
+
+        item.style.height = item.offsetHeight + 'px';
+        track.classList.add('is-dragging');
+
+        activeSwipe = {
+          item: item,
+          track: track,
+          content: content,
+          startX: startX,
+          currentX: startX,
+          hasMoved: false,
+          threshold: threshold
+        };
+      }
+
+      function handleSwipeMove(event) {
+        if (!activeSwipe) return;
+
+        const clientX = getClientX(event);
+        if (clientX === null) return;
+
+        activeSwipe.currentX = clientX;
+        activeSwipe.hasMoved = true;
+
+        const deltaX = activeSwipe.currentX - activeSwipe.startX;
+        activeSwipe.track.style.transform = 'translateX(' + deltaX + 'px)';
+
+        const pastThreshold = Math.abs(deltaX) >= activeSwipe.threshold;
+        activeSwipe.item.classList.toggle('is-past-threshold', pastThreshold);
+        activeSwipe.item.style.backgroundColor = pastThreshold ? ACTION_COLOR : DEFAULT_ITEM_BG;
+        activeSwipe.track.style.backgroundColor = pastThreshold ? ACTION_COLOR : DEFAULT_ITEM_BG;
+      }
+
+      function handleSwipeEnd(event) {
+        if (!activeSwipe) return;
+
+        const swipe = activeSwipe;
+        activeSwipe = null;
+
+        const endX = getClientX(event);
+        if (endX !== null && (!swipe.hasMoved || endX !== 0)) {
+          swipe.currentX = endX;
+        }
+
+        const deltaX = swipe.currentX - swipe.startX;
+        swipe.track.classList.remove('is-dragging');
+
+        if (Math.abs(deltaX) >= swipe.threshold) {
+          collapseAndRemoveItem(swipe.item, swipe.track, deltaX);
+        } else {
+          swipe.track.style.transform = 'translateX(0px)';
+          swipe.item.classList.remove('is-past-threshold');
+          swipe.item.style.backgroundColor = DEFAULT_ITEM_BG;
+          swipe.track.style.backgroundColor = DEFAULT_ITEM_BG;
+          swipe.item.style.height = '';
+        }
+      }
+
+      const list = document.querySelector('.SwipeableList');
+      if (list) {
+        list.addEventListener('dragstart', function (e) {
+          e.preventDefault();
+        });
+
+        window.addEventListener('pointerdown', handleSwipeStart, { capture: true });
+        window.addEventListener('mousedown', handleSwipeStart, { capture: true });
+        window.addEventListener('touchstart', handleSwipeStart, { capture: true, passive: true });
+
+        window.addEventListener('pointermove', handleSwipeMove, { capture: true });
+        window.addEventListener('mousemove', handleSwipeMove, { capture: true });
+        window.addEventListener('touchmove', handleSwipeMove, { capture: true, passive: true });
+
+        window.addEventListener('pointerup', handleSwipeEnd, { capture: true });
+        window.addEventListener('pointercancel', handleSwipeEnd, { capture: true });
+        window.addEventListener('mouseup', handleSwipeEnd, { capture: true });
+        window.addEventListener('touchend', handleSwipeEnd, { capture: true });
+        window.addEventListener('touchcancel', handleSwipeEnd, { capture: true });
+      }
+    })();
+  </script>
 </body>
 
