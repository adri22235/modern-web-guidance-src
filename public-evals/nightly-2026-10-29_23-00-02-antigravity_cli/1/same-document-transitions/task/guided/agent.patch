+  <script>
+    const listPage = document.getElementById("list-page");
+    const detailPage = document.getElementById("detail-page");
+    const listHeading = document.getElementById("list-heading");
+    const detailTitle = document.getElementById("title");
+    const hero = document.getElementById("hero");
+    const detailPrice = document.getElementById("detail-price");
+    const detailCalories = document.getElementById("detail-calories");
+    const detailDescription = document.getElementById("detail-description");
+    const backButton = document.getElementById("back-button");
+    const thumbnails = document.querySelectorAll(".thumbnail");
+
+    function populateDetail(card) {
+      const titleText = card.dataset.title || card.querySelector(".title")?.textContent || "";
+      const descriptionText = card.dataset.description || "";
+      const priceText = card.dataset.price || "";
+      const caloriesText = card.dataset.calories || "";
+      const imageUrl = card.dataset.image || "";
+      const bgColor = card.dataset.bg || getComputedStyle(card).backgroundColor;
+
+      detailTitle.textContent = titleText;
+      detailPrice.textContent = priceText;
+      detailCalories.textContent = caloriesText;
+      detailDescription.textContent = descriptionText;
+      hero.style.backgroundColor = bgColor;
+      if (imageUrl) {
+        hero.style.backgroundImage = `linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.25)), url('${imageUrl}')`;
+      }
+      hero.setAttribute("aria-label", titleText);
+    }
+
+    function showDetailDOM() {
+      document.body.classList.add("detail");
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      document.title = `${detailTitle.textContent} | The Daily Grind`;
+    }
+
+    function showListDOM() {
+      document.body.classList.remove("detail");
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      document.title = "The Daily Grind | Artisanal Coffee";
+    }
+
+    function cleanupSelected() {
+      document.querySelectorAll(".selected").forEach((element) => {
+        element.classList.remove("selected");
+        element.style.removeProperty("view-transition-name");
+      });
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+      cleanupSelected();
+
+      card.classList.add("selected");
+      const cardTitle = card.querySelector(".title");
+      if (cardTitle) {
+        cardTitle.classList.add("selected");
+      }
+
+      populateDetail(card);
+
+      if (!document.startViewTransition) {
+        showDetailDOM();
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        showDetailDOM();
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      if (!document.startViewTransition) {
+        showListDOM();
+        cleanupSelected();
+        listHeading?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        showListDOM();
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        cleanupSelected();
+      });
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener("click", goFromListToDetail);
+      thumbnail.addEventListener("keydown", (e) => {
+        if (e.key === "Enter") {
+          goFromListToDetail(e);
+        }
+        if (e.key === " ") {
+          e.preventDefault();
+        }
+      });
+      thumbnail.addEventListener("keyup", (e) => {
+        if (e.key === " ") {
+          goFromListToDetail(e);
+        }
+      });
+    });
+
+    backButton.addEventListener("click", goFromDetailToList);
+  </script>
 </body>
 
 </html>
