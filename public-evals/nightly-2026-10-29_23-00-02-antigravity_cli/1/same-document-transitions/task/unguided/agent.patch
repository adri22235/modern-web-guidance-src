+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80',
+        price: '$5.50',
+        calories: '210 kcal',
+        description: 'Our signature espresso paired with velvety steamed oat milk and sweetened with pure Grade-A Vermont maple syrup, finished with a light dusting of cinnamon.'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+        price: '$3.75',
+        calories: '15 kcal',
+        description: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches to bring out deep dark chocolate notes and a rich, velvety crema.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80',
+        price: '$4.75',
+        calories: '10 kcal',
+        description: 'Steeped slowly in cool filtered water for 18 hours for maximum smoothness and naturally sweet cocoa undertones with low acidity.'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const heroImg = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const detailPrice = document.getElementById('detail-price');
+    const detailCalories = document.getElementById('detail-calories');
+    const detailDescription = document.getElementById('detail-description');
+    const backButton = document.getElementById('back-button');
+    const thumbnails = document.querySelectorAll('.thumbnail');
+
+    let activeCard = null;
+
+    function prefersReducedMotion() {
+      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+
+    function cleanupTransitionNames() {
+      document.querySelectorAll('.vt-hero, .vt-title').forEach((el) => {
+        el.classList.remove('vt-hero', 'vt-title');
+        el.style.viewTransitionName = '';
+      });
+      heroImg.style.viewTransitionName = '';
+      detailTitle.style.viewTransitionName = '';
+      thumbnails.forEach((card) => {
+        card.style.viewTransitionName = '';
+        const img = card.querySelector('.thumbnail-img');
+        const title = card.querySelector('.title');
+        if (img) img.style.viewTransitionName = '';
+        if (title) title.style.viewTransitionName = '';
+      });
+    }
+
+    function populateDetail(itemId) {
+      const data = ITEMS[itemId];
+      if (!data) return;
+      heroImg.src = data.image;
+      heroImg.alt = data.title;
+      detailTitle.textContent = data.title;
+      detailPrice.textContent = data.price;
+      detailCalories.textContent = data.calories;
+      detailDescription.textContent = data.description;
+    }
+
+    async function showDetailView(card) {
+      const itemId = card.dataset.id;
+      activeCard = card;
+      const thumbTitle = card.querySelector('.title');
+
+      populateDetail(itemId);
+
+      const updateDOM = () => {
+        card.classList.remove('vt-hero');
+        card.style.viewTransitionName = '';
+        if (thumbTitle) {
+          thumbTitle.classList.remove('vt-title');
+          thumbTitle.style.viewTransitionName = '';
+        }
+
+        heroImg.classList.add('vt-hero');
+        heroImg.style.viewTransitionName = 'hero';
+        detailTitle.classList.add('vt-title');
+        detailTitle.style.viewTransitionName = 'title';
+
+        listPage.hidden = true;
+        detailPage.hidden = false;
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        updateDOM();
+        cleanupTransitionNames();
+        detailTitle.focus();
+        return;
+      }
+
+      cleanupTransitionNames();
+      card.classList.add('vt-hero');
+      card.style.viewTransitionName = 'hero';
+      if (thumbTitle) {
+        thumbTitle.classList.add('vt-title');
+        thumbTitle.style.viewTransitionName = 'title';
+      }
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      try {
+        await transition.finished;
+      } finally {
+        cleanupTransitionNames();
+        detailTitle.focus();
+      }
+    }
+
+    async function showListView() {
+      const card = activeCard || thumbnails[0];
+      const thumbTitle = card ? card.querySelector('.title') : null;
+
+      const updateDOM = () => {
+        heroImg.classList.remove('vt-hero');
+        heroImg.style.viewTransitionName = '';
+        detailTitle.classList.remove('vt-title');
+        detailTitle.style.viewTransitionName = '';
+
+        if (card) {
+          card.classList.add('vt-hero');
+          card.style.viewTransitionName = 'hero';
+        }
+        if (thumbTitle) {
+          thumbTitle.classList.add('vt-title');
+          thumbTitle.style.viewTransitionName = 'title';
+        }
+
+        detailPage.hidden = true;
+        listPage.hidden = false;
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        updateDOM();
+        cleanupTransitionNames();
+        listHeading.focus();
+        return;
+      }
+
+      cleanupTransitionNames();
+      heroImg.classList.add('vt-hero');
+      heroImg.style.viewTransitionName = 'hero';
+      detailTitle.classList.add('vt-title');
+      detailTitle.style.viewTransitionName = 'title';
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      try {
+        await transition.finished;
+      } finally {
+        cleanupTransitionNames();
+        listHeading.focus();
+      }
+    }
+
+    thumbnails.forEach((card) => {
+      card.addEventListener('click', (e) => {
+        e.preventDefault();
+        showDetailView(card);
+      });
+
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          showDetailView(card);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', (e) => {
+      e.preventDefault();
+      showListView();
+    });
+  </script>
