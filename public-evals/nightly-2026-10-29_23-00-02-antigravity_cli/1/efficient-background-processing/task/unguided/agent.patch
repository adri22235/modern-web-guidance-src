+  <section id="roasting-widget" aria-label="Real-Time Coffee Roasting Simulator">
+    <div>
+      <h2>Live Drum Roaster Simulator</h2>
+      <p>Watch our artisanal batch roast in real time as beans progress toward first crack.</p>
