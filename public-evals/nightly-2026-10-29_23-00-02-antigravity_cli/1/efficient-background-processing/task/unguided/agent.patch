   </footer>
 
+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+      let currentTemp = 195.0;
+      let tempDirection = 1;
+
+      // Initialize coffee beans for tumbling animation
+      const beans = Array.from({ length: 28 }, (_, i) => ({
+        x: 60 + ((i * 23) % (canvas.width - 120)),
+        y: 40 + ((i * 37) % (canvas.height - 80)),
+        vx: (Math.random() - 0.5) * 2.4 + (i % 2 === 0 ? 0.8 : -0.8),
+        vy: (Math.random() - 0.5) * 2.2,
+        angle: (i * 0.45) % (Math.PI * 2),
+        vAngle: (Math.random() - 0.5) * 0.08 + 0.02,
+        rx: 10 + (i % 4),
+        ry: 6 + (i % 3),
+        roastLevel: (i % 10) / 10
+      }));
+
+      function getBeanColor(roast) {
+        // Interpolate from light cinnamon roast (#8d5524) to dark espresso (#3b2219)
+        const r = Math.round(141 - roast * 82);
+        const g = Math.round(85 - roast * 51);
+        const b = Math.round(36 - roast * 11);
+        return `rgb(${r}, ${g}, ${b})`;
+      }
+
+      function renderFrame() {
+        if (!isRunning) return;
+
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        // Subtle warm glow at bottom of roaster drum
+        const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
+        grad.addColorStop(0, '#2b1b17');
+        grad.addColorStop(1, '#43261e');
+        ctx.fillStyle = grad;
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        for (let i = 0; i < beans.length; i++) {
+          const b = beans[i];
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.vAngle;
+
+          if (b.x < b.rx + 8 || b.x > canvas.width - b.rx - 8) {
+            b.vx *= -1;
+            b.x = Math.max(b.rx + 8, Math.min(canvas.width - b.rx - 8, b.x));
+          }
+          if (b.y < b.ry + 8 || b.y > canvas.height - b.ry - 8) {
+            b.vy *= -1;
+            b.y = Math.max(b.ry + 8, Math.min(canvas.height - b.ry - 8, b.y));
+          }
+
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          // Bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.rx, b.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = getBeanColor(b.roastLevel);
+          ctx.fill();
+          ctx.lineWidth = 1;
+          ctx.strokeStyle = '#24140e';
+          ctx.stroke();
+
+          // Center crease of coffee bean
+          ctx.beginPath();
+          ctx.moveTo(-b.rx * 0.7, 0);
+          ctx.quadraticCurveTo(0, b.ry * 0.35, b.rx * 0.7, 0);
+          ctx.strokeStyle = '#1a0d08';
+          ctx.lineWidth = 1.4;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        animationFrameId = requestAnimationFrame(renderFrame);
+      }
+
+      function updateTemperature() {
+        currentTemp += tempDirection * (0.2 + Math.random() * 0.4);
+        if (currentTemp >= 224.0) {
+          currentTemp = 224.0;
+          tempDirection = -1;
+        } else if (currentTemp <= 192.0) {
+          currentTemp = 192.0;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°C`;
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(renderFrame);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 1000);
+        }
+      }
+
+      function stopSimulation() {
+        isRunning = false;
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Pause/resume based on rendering state changes with fallback for older browsers
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          if (event.skipped) {
+            stopSimulation();
+          } else {
+            startSimulation();
+          }
+        });
+      } else if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          for (const entry of entries) {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          }
+        });
+        observer.observe(widget);
+      } else {
+        startSimulation();
+      }
+    })();
+  </script>
 </body>
 
