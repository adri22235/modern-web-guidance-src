+  <script>
+    (() => {
+      const roastingWidget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      if (!roastingWidget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let currentTemp = 385;
+      let tempDirection = 1;
+
+      const beans = Array.from({ length: 28 }, (_, i) => ({
+        x: 60 + (i * 23) % (canvas.width - 120),
+        y: 50 + (i * 37) % (canvas.height - 100),
+        vx: (Math.random() - 0.5) * 3.2 + (i % 2 === 0 ? 1.2 : -1.2),
+        vy: (Math.random() - 0.5) * 2.8 - 0.5,
+        angle: (i * 0.45) % (Math.PI * 2),
+        spin: (Math.random() - 0.5) * 0.08 + 0.02,
+        rx: 12 + (i % 4),
+        ry: 8 + (i % 3),
+        roastProgress: (i % 10) / 10
+      }));
+
+      function getBeanColor(progress) {
+        const r = Math.round(140 - progress * 75);
+        const g = Math.round(92 - progress * 55);
+        const b = Math.round(56 - progress * 35);
+        return `rgb(${r}, ${g}, ${b})`;
+      }
+
+      function drawFrame() {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        // Subtle heated drum glow at bottom
+        const grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
+        grad.addColorStop(0, '#2b1b17');
+        grad.addColorStop(1, '#4a2518');
+        ctx.fillStyle = grad;
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        for (const bean of beans) {
+          bean.x += bean.vx;
+          bean.y += bean.vy;
+          bean.vy += 0.05; // light gravity inside tumbling drum
+          bean.angle += bean.spin;
+          bean.roastProgress = (bean.roastProgress + 0.0008) % 1;
+
+          if (bean.x - bean.rx < 12) {
+            bean.x = 12 + bean.rx;
+            bean.vx = Math.abs(bean.vx);
+          } else if (bean.x + bean.rx > canvas.width - 12) {
+            bean.x = canvas.width - 12 - bean.rx;
+            bean.vx = -Math.abs(bean.vx);
+          }
+
+          if (bean.y - bean.ry < 12) {
+            bean.y = 12 + bean.ry;
+            bean.vy = Math.abs(bean.vy) * 0.9;
+          } else if (bean.y + bean.ry > canvas.height - 12) {
+            bean.y = canvas.height - 12 - bean.ry;
+            bean.vy = -Math.abs(bean.vy) * 0.92 - 0.6;
+          }
+
+          ctx.save();
+          ctx.translate(bean.x, bean.y);
+          ctx.rotate(bean.angle);
+
+          // Bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = getBeanColor(bean.roastProgress);
+          ctx.fill();
+          ctx.lineWidth = 1.5;
+          ctx.strokeStyle = '#24140e';
+          ctx.stroke();
+
+          // Bean center crease
+          ctx.beginPath();
+          ctx.moveTo(-bean.rx * 0.7, 0);
+          ctx.quadraticCurveTo(0, bean.ry * 0.3, bean.rx * 0.7, 0);
+          ctx.strokeStyle = '#1b0e0a';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+      }
+
+      function animateBeans() {
+        drawFrame();
+        animationFrameId = requestAnimationFrame(animateBeans);
+      }
+
+      function updateTemperature() {
+        currentTemp += tempDirection * (Math.floor(Math.random() * 3) + 1);
+        if (currentTemp >= 430) {
+          currentTemp = 430;
+          tempDirection = -1;
+        } else if (currentTemp <= 385) {
+          currentTemp = 385;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = `${currentTemp}°F`;
+      }
+
+      function startSimulation() {
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(animateBeans);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 1000);
+        }
+      }
+
+      function stopSimulation() {
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Draw initial static state
+      drawFrame();
+
+      // Pause/resume when browser skips or resumes rendering the widget
+      roastingWidget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          stopSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      // Fallback using IntersectionObserver for older browsers without content-visibility support
+      const isSupported = 'contentVisibility' in document.documentElement.style;
+
+      if (!isSupported) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(roastingWidget);
+      }
+    })();
+  </script>
+
 </body>
 
