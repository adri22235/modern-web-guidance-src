+  <script>
+    const STORAGE_KEYS = {
+      pickupTime: 'dailyGrind.pickupReminderTime',
+      anniversaryDate: 'dailyGrind.coffeeAnniversaryDate',
+    };
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+
+      const displayPickupTime = document.getElementById('display-pickup-time');
+      const isoPickupTime = document.getElementById('iso-pickup-time');
+      const displayAnniversaryDate = document.getElementById('display-anniversary-date');
+      const isoAnniversaryDate = document.getElementById('iso-anniversary-date');
+      const displayAnnualMonthDay = document.getElementById('display-annual-month-day');
+      const displayPlainDateTime = document.getElementById('display-plain-datetime');
+      const anniversaryStatus = document.getElementById('anniversary-status');
+
+      // Load saved ISO strings if available
+      const savedTime = localStorage.getItem(STORAGE_KEYS.pickupTime);
+      const savedDate = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+
+      if (savedTime) {
+        const parsedSavedTime = Temporal.PlainTime.from(savedTime);
+        timeInput.value = parsedSavedTime.toString({ smallestUnit: 'minute' });
+      }
+      if (savedDate) {
+        const parsedSavedDate = Temporal.PlainDate.from(savedDate);
+        dateInput.value = parsedSavedDate.toString();
+      }
+
+      function renderSchedule() {
+        if (!timeInput.value || !dateInput.value) {
+          return;
+        }
+
+        // 1. Parse wall-clock time and calendar date using location-agnostic Temporal Plain types
+        const reminderTime = Temporal.PlainTime.from(timeInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(dateInput.value);
+
+        // Combine into a location-agnostic PlainDateTime without string interpolation
+        const anniversaryPickup = anniversaryDate.toPlainDateTime(reminderTime);
+
+        // Model the recurring annual coffee anniversary using PlainMonthDay with explicit calendar
+        const { year, month, day } = anniversaryDate;
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        // Persist canonical location-agnostic representations
+        localStorage.setItem(STORAGE_KEYS.pickupTime, reminderTime.toString());
+        localStorage.setItem(STORAGE_KEYS.anniversaryDate, anniversaryDate.toString());
+
+        // 2. Display without time zone conversion so values never shift when traveling
+        displayPickupTime.textContent = reminderTime.toLocaleString(undefined, {
+          hour: '2-digit',
+          minute: '2-digit',
+        });
+        isoPickupTime.textContent = reminderTime.toString();
+
+        displayAnniversaryDate.textContent = anniversaryDate.toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+        });
+        isoAnniversaryDate.textContent = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
+
+        // Convert PlainMonthDay to PlainDate with a specific year before date comparisons/arithmetic
+        const today = Temporal.Now.plainDateISO();
+        const isTodayAnniversary = annualAnniversary.equals(today.toPlainMonthDay());
+        const occurrenceThisYear = annualAnniversary.toPlainDate({ year: today.year });
+
+        displayAnnualMonthDay.textContent = `${annualAnniversary.toLocaleString(undefined, {
+          month: 'short',
+          day: 'numeric',
+        })} (This year: ${occurrenceThisYear.toString()})`;
+
+        displayPlainDateTime.textContent = anniversaryPickup.toString();
+
+        if (isTodayAnniversary) {
+          anniversaryStatus.textContent = `Happy Coffee Anniversary! (${anniversaryDate.toString()}) — Locked to your wall clock & calendar anywhere you travel.`;
+        } else {
+          anniversaryStatus.textContent = `Saved as PlainDate (${anniversaryDate.toString()}) & PlainTime (${reminderTime.toString()}) — immune to time zone shifts.`;
+        }
+      }
+
+      // Validate on blur and clear custom validity on input
+      timeInput.addEventListener('blur', () => {
+        if (!timeInput.value) {
+          timeInput.setCustomValidity('Please select a daily pickup reminder time.');
+        } else {
+          renderSchedule();
+        }
+      });
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+      });
+      timeInput.addEventListener('change', renderSchedule);
+
+      dateInput.addEventListener('blur', () => {
+        if (!dateInput.value) {
+          dateInput.setCustomValidity('Please select your coffee anniversary date.');
+        } else {
+          renderSchedule();
+        }
+      });
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+      });
+      dateInput.addEventListener('change', renderSchedule);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        renderSchedule();
+      });
+
+      renderSchedule();
+    }
+
+    // Check if Temporal is supported natively; dynamically load temporal-polyfill if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
