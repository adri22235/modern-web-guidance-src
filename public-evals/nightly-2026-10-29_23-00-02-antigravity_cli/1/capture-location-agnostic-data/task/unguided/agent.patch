+  <script>
+    (function () {
+      const STORAGE_KEYS = {
+        pickupTime: 'dailyGrind_pickupReminderTime',
+        anniversaryDate: 'dailyGrind_coffeeAnniversaryDate'
+      };
+
+      const MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeDisplay = document.getElementById('pickup-time-display');
+      const dateDisplay = document.getElementById('anniversary-date-display');
+      const form = document.getElementById('coffee-preferences-form');
+      const statusEl = document.getElementById('preferences-status');
+
+      /**
+       * Parses and normalizes a location-agnostic wall-clock time string (HH:MM)
+       * without using Date objects or time zone offsets.
+       */
+      function normalizePlainTime(rawTime) {
+        if (typeof rawTime !== 'string') return null;
+        const trimmed = rawTime.trim();
+        if (typeof Temporal !== 'undefined' && Temporal.PlainTime) {
+          try {
+            const plainTime = Temporal.PlainTime.from(trimmed);
+            const hh = String(plainTime.hour).padStart(2, '0');
+            const mm = String(plainTime.minute).padStart(2, '0');
+            return { iso: `${hh}:${mm}`, hour: plainTime.hour, minute: plainTime.minute };
+          } catch (_) {
+            // Fall through to regex parser
+          }
+        }
+        const match = /^([01]\d|2[0-3]):([0-5]\d)(?::[0-5]\d)?$/.exec(trimmed);
+        if (!match) return null;
+        const hour = Number(match[1]);
+        const minute = Number(match[2]);
+        return {
+          iso: `${match[1]}:${match[2]}`,
+          hour,
+          minute
+        };
+      }
+
+      /**
+       * Parses and normalizes a location-agnostic calendar date string (YYYY-MM-DD)
+       * without constructing a Date object (avoiding UTC-midnight-to-local shifts).
+       */
+      function normalizePlainDate(rawDate) {
+        if (typeof rawDate !== 'string') return null;
+        const trimmed = rawDate.trim();
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          try {
+            const plainDate = Temporal.PlainDate.from(trimmed);
+            const yyyy = String(plainDate.year).padStart(4, '0');
+            const mm = String(plainDate.month).padStart(2, '0');
+            const dd = String(plainDate.day).padStart(2, '0');
+            return {
+              iso: `${yyyy}-${mm}-${dd}`,
+              year: plainDate.year,
+              month: plainDate.month,
+              day: plainDate.day
+            };
+          } catch (_) {
+            // Fall through to regex parser
+          }
+        }
+        const match = /^(\d{4})-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/.exec(trimmed);
+        if (!match) return null;
+        const year = Number(match[1]);
+        const month = Number(match[2]);
+        const day = Number(match[3]);
+        return {
+          iso: `${match[1]}-${match[2]}-${match[3]}`,
+          year,
+          month,
+          day
+        };
+      }
+
+      function formatPlainTime(plainTime) {
+        if (!plainTime) return 'Not set';
+        const period = plainTime.hour >= 12 ? 'PM' : 'AM';
+        const hour12 = plainTime.hour % 12 === 0 ? 12 : plainTime.hour % 12;
+        const minutePadded = String(plainTime.minute).padStart(2, '0');
+        return `${plainTime.iso} (${hour12}:${minutePadded} ${period})`;
+      }
+
+      function formatPlainDate(plainDate) {
+        if (!plainDate) return 'Not set';
+        const monthName = MONTH_NAMES[plainDate.month - 1];
+        return `${plainDate.iso} (${monthName} ${plainDate.day}, ${plainDate.year})`;
+      }
+
+      function renderAndPersist(showSavedMessage) {
+        const parsedTime = normalizePlainTime(timeInput.value);
+        const parsedDate = normalizePlainDate(dateInput.value);
+
+        if (parsedTime) {
+          timeInput.value = parsedTime.iso;
+          timeDisplay.textContent = formatPlainTime(parsedTime);
+          try {
+            localStorage.setItem(STORAGE_KEYS.pickupTime, parsedTime.iso);
+          } catch (_) {}
+        } else {
+          timeDisplay.textContent = 'Not set';
+        }
+
+        if (parsedDate) {
+          dateInput.value = parsedDate.iso;
+          dateDisplay.textContent = formatPlainDate(parsedDate);
+          try {
+            localStorage.setItem(STORAGE_KEYS.anniversaryDate, parsedDate.iso);
+          } catch (_) {}
+        } else {
+          dateDisplay.textContent = 'Not set';
+        }
+
+        if (showSavedMessage && parsedTime && parsedDate) {
+          statusEl.textContent = `Preferences saved! Reminder set for ${parsedTime.iso} daily and anniversary set to ${parsedDate.iso} (location-agnostic).`;
+        }
+      }
+
+      // Restore any previously saved location-agnostic values on load
+      try {
+        const savedTime = normalizePlainTime(localStorage.getItem(STORAGE_KEYS.pickupTime));
+        if (savedTime) {
+          timeInput.value = savedTime.iso;
+        }
+        const savedDate = normalizePlainDate(localStorage.getItem(STORAGE_KEYS.anniversaryDate));
+        if (savedDate) {
+          dateInput.value = savedDate.iso;
+        }
+      } catch (_) {}
+
+      renderAndPersist(false);
+
+      timeInput.addEventListener('input', function () {
+        statusEl.textContent = '';
+        renderAndPersist(false);
+      });
+      timeInput.addEventListener('change', function () {
+        renderAndPersist(false);
+      });
+
+      dateInput.addEventListener('input', function () {
+        statusEl.textContent = '';
+        renderAndPersist(false);
+      });
+      dateInput.addEventListener('change', function () {
+        renderAndPersist(false);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        renderAndPersist(true);
+      });
+    })();
+  </script>
