+  <script>
+    const BARISTA_SYSTEM_PROMPT =
+      'You are a knowledgeable, friendly barista at The Daily Grind coffee shop. ' +
+      'Answer customer questions specifically about our signature drinks: ' +
+      '1) Maple Oat Latte: Espresso combined with steamed creamy oat milk and a hint of real Vermont maple syrup. ' +
+      '2) Cold Brew: Artisanal coffee grounds steeped in cold water for 18 hours for maximum smoothness and low acidity.';
+
+    const FEEDBACK_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: {
+          type: 'number',
+          description: 'Sentiment score ranging from 0 (very negative) to 10 (very positive)'
+        },
+        category: {
+          type: 'string',
+          enum: ['positive', 'neutral', 'negative']
+        }
+      },
+      required: ['score', 'category'],
+      additionalProperties: false
+    };
+
+    let activeSession = null;
+    let branchedSession = null;
+
+    const askBaristaBtn = document.getElementById('ask-the-barista');
+    const baristaQuestionInput = document.getElementById('barista-question');
+    const baristaAnswerDiv = document.getElementById('barista-answer');
+    const downloadProgressDiv = document.getElementById('download-progress');
+
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentResultDiv = document.getElementById('sentiment-result');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-btn');
+    const contextUsageDiv = document.getElementById('context-usage');
+    const branchStatusDiv = document.getElementById('branch-status');
+
+    function updateContextUsageDisplay(session) {
+      if (!session) {
+        contextUsageDiv.textContent = 'Context Usage: No active session';
+        return;
+      }
+      const usage = session.inputUsage ?? 0;
+      const quota = session.inputQuota ?? 0;
+      contextUsageDiv.textContent = `Context Usage: ${usage} / ${quota} tokens`;
+    }
+
+    function destroySessionSafely(session) {
+      if (session && typeof session.destroy === 'function') {
+        session.destroy();
+      }
+    }
+
+    async function checkModelAvailability() {
+      if (typeof LanguageModel === 'undefined') {
+        return 'unavailable';
+      }
+      return await LanguageModel.availability();
+    }
+
+    async function getOrCreateBaristaSession() {
+      if (activeSession) {
+        return activeSession;
+      }
+
+      const availability = await checkModelAvailability();
+      if (availability === 'unavailable') {
+        throw new Error('The built-in LanguageModel API is unavailable on this device or browser.');
+      }
+
+      activeSession = await LanguageModel.create({
+        initialPrompts: [
+          {
+            role: 'system',
+            content: BARISTA_SYSTEM_PROMPT
+          }
+        ],
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const percent = Math.round((e.loaded || 0) * 100);
+            downloadProgressDiv.textContent = `Downloading AI model: ${percent}%`;
+          });
+        }
+      });
+
+      downloadProgressDiv.textContent = '';
+      updateContextUsageDisplay(activeSession);
+      return activeSession;
+    }
+
+    // 1. Ask the Barista (Streaming + Availability Check + Progress Monitoring)
+    askBaristaBtn.addEventListener('click', async () => {
+      const question = baristaQuestionInput.value.trim() ||
+        'Tell me about the Maple Oat Latte and Cold Brew.';
+
+      baristaAnswerDiv.textContent = '';
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          baristaAnswerDiv.textContent = 'Sorry, the built-in AI model is unavailable.';
+          return;
+        }
+
+        const session = await getOrCreateBaristaSession();
+
+        // Check remaining context quota and recycle session if close to limit
+        if (session.inputQuota && session.inputUsage >= session.inputQuota * 0.9) {
+          const cloned = await session.clone();
+          destroySessionSafely(activeSession);
+          activeSession = cloned;
+        }
+
+        const stream = activeSession.promptStreaming(question);
+        for await (const chunk of stream) {
+          baristaAnswerDiv.textContent += chunk;
+        }
+
+        updateContextUsageDisplay(activeSession);
+      } catch (error) {
+        baristaAnswerDiv.textContent = `Error: ${error.message}`;
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON Output via responseConstraint)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedbackText = feedbackInput.value.trim() ||
+        'The Cold Brew is super smooth and refreshing!';
+
+      sentimentResultDiv.textContent = 'Analyzing feedback...';
+      let feedbackSession = null;
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          sentimentResultDiv.textContent = 'Sorry, the built-in AI model is unavailable.';
+          return;
+        }
+
+        feedbackSession = await LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'You are a customer feedback sentiment analyzer for a coffee shop. Respond strictly with JSON matching the provided schema containing score and category.'
+            }
+          ],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              downloadProgressDiv.textContent = `Downloading AI model: ${percent}%`;
+            });
+          }
+        });
+
+        const rawJson = await feedbackSession.prompt(feedbackText, {
+          responseConstraint: FEEDBACK_SCHEMA
+        });
+
+        const parsed = JSON.parse(rawJson);
+        sentimentResultDiv.textContent = JSON.stringify(parsed, null, 2);
+      } catch (error) {
+        sentimentResultDiv.textContent = `Error: ${error.message}`;
+      } finally {
+        // Clean up temporary single-turn feedback analyzer session
+        destroySessionSafely(feedbackSession);
+      }
+    });
+
+    // 3. Conversation Branching & Context Usage Tracking + Session Cleanup
+    cloneBtn.addEventListener('click', async () => {
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          branchStatusDiv.textContent = 'Cannot clone session: built-in AI model is unavailable.';
+          return;
+        }
+
+        const baseSession = await getOrCreateBaristaSession();
+
+        // Clean up any previously branched session that is no longer needed
+        if (branchedSession && branchedSession !== activeSession) {
+          destroySessionSafely(branchedSession);
+          branchedSession = null;
+        }
+
+        branchedSession = await baseSession.clone();
+
+        // Promote the cloned session to active and clean up the old session if replaced
+        destroySessionSafely(activeSession);
+        activeSession = branchedSession;
+        branchedSession = null;
+
+        updateContextUsageDisplay(activeSession);
+        branchStatusDiv.textContent =
+          `Session cloned! Active session usage: ${activeSession.inputUsage ?? 0} / ${activeSession.inputQuota ?? 0} tokens.`;
+      } catch (error) {
+        branchStatusDiv.textContent = `Error cloning session: ${error.message}`;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      destroySessionSafely(branchedSession);
+      branchedSession = null;
+      destroySessionSafely(activeSession);
+      activeSession = null;
+      updateContextUsageDisplay(null);
+      branchStatusDiv.textContent = 'All unneeded AI sessions have been destroyed and resources freed.';
+    });
+
+    window.addEventListener('pagehide', () => {
+      destroySessionSafely(branchedSession);
+      branchedSession = null;
+      destroySessionSafely(activeSession);
+      activeSession = null;
+    });
+  </script>
 </body>
 
