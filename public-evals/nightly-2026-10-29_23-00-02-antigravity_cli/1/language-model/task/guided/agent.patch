+  <script>
+    (() => {
+      // Menu knowledge base for system prompt (keeps input concise and relevant)
+      const BARISTA_SYSTEM_PROMPT =
+        'You are the friendly expert barista at The Daily Grind artisanal coffee shop. ' +
+        'Answer customer questions specifically about our Maple Oat Latte (creamy oat milk with a hint of pure Vermont maple syrup, warm and comforting) ' +
+        'and our Cold Brew (steeped for 18 hours for maximum smoothness and low acidity). Keep answers helpful and concise.';
+
+      const SENTIMENT_SYSTEM_PROMPT =
+        'You are a customer feedback analyzer for The Daily Grind coffee shop. Evaluate customer reviews accurately.';
+
+      // Structured JSON Schema for Customer Feedback Analyzer (score and category)
+      // Passed as a plain object to responseConstraint without length constraints.
+      const SENTIMENT_SCHEMA = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            minimum: 1,
+            maximum: 5
+          },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative', 'product_quality', 'service']
+          }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      // Session state & resource tracking
+      let baseBaristaSession = null;
+      let activeBaristaSession = null;
+      let baseSentimentSession = null;
+      let currentAbortController = null;
+      const clonedSessions = [];
+      let cloneCounter = 0;
+
+      // DOM Elements
+      const questionInput = document.getElementById('barista-question');
+      const askBtn = document.getElementById('ask-the-barista');
+      const stopBtn = document.getElementById('stop-barista-btn');
+      const baristaAnswerEl = document.getElementById('barista-answer');
+      const progressWrap = document.getElementById('download-progress-wrap');
+      const progressBar = document.getElementById('model-download-progress');
+      const progressText = document.getElementById('model-download-text');
+
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const sentimentOutputEl = document.getElementById('sentiment-output');
+
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+      const branchStatusEl = document.getElementById('branch-status');
+      const branchListEl = document.getElementById('branch-list');
+      const contextUsageVal = document.getElementById('context-usage-value');
+      const contextWindowVal = document.getElementById('context-window-value');
+      const contextUsagePct = document.getElementById('context-usage-percent');
+      const activeClonesCountEl = document.getElementById('active-clones-count');
+
+      // Monitor callback for model download progress
+      function createDownloadMonitor(m) {
+        m.addEventListener('downloadprogress', (e) => {
+          const percent = Math.round((e.loaded || 0) * 100);
+          progressWrap.classList.add('active');
+          progressBar.value = percent;
+          progressText.textContent = `${percent}%`;
+          if (percent >= 100) {
+            setTimeout(() => progressWrap.classList.remove('active'), 1000);
+          }
+        });
+      }
+
+      // Check availability before starting any LanguageModel session
+      async function checkModelAvailability() {
+        if (!('LanguageModel' in self)) {
+          return 'unavailable';
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          return availability;
+        } catch (err) {
+          console.error('Error checking LanguageModel availability:', err);
+          return 'unavailable';
+        }
+      }
+
+      // Update context usage metrics in the UI using session.contextUsage and session.contextWindow
+      function updateContextUsageDisplay(session = activeBaristaSession) {
+        if (!session) {
+          contextUsageVal.textContent = '0';
+          contextWindowVal.textContent = '0';
+          contextUsagePct.textContent = '0%';
+          return;
+        }
+        const usage = session.contextUsage ?? session.tokensSoFar ?? 0;
+        const maxWindow = session.contextWindow ?? session.maxTokens ?? 0;
+        contextUsageVal.textContent = String(usage);
+        contextWindowVal.textContent = String(maxWindow);
+        const pct = maxWindow > 0 ? Math.round((usage / maxWindow) * 100) : 0;
+        contextUsagePct.textContent = `${pct}%`;
+      }
+
+      // Initialize or retrieve the base barista session & active session
+      async function ensureBaristaSession() {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          throw new Error('Built-in AI LanguageModel is unavailable on this device or browser.');
+        }
+
+        if (!baseBaristaSession) {
+          baseBaristaSession = await LanguageModel.create({
+            initialPrompts: [{ role: 'system', content: BARISTA_SYSTEM_PROMPT }],
+            expectedInputs: [{ type: 'text' }],
+            expectedOutputs: [{ type: 'text' }],
+            monitor: createDownloadMonitor
+          });
+        }
+
+        if (!activeBaristaSession) {
+          // Clone from the clean base session so we can easily branch or reset
+          activeBaristaSession = await baseBaristaSession.clone();
+        }
+
+        updateContextUsageDisplay(activeBaristaSession);
+        return activeBaristaSession;
+      }
+
+      // Pre-warm session when user focuses or hovers over AI interactive sections
+      let prewarmStarted = false;
+      async function prewarmModel() {
+        if (prewarmStarted) return;
+        prewarmStarted = true;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability !== 'unavailable') {
+            await ensureBaristaSession();
+          }
+        } catch {
+          // Ignore pre-warm errors; user action will surface appropriate status
+          prewarmStarted = false;
+        }
+      }
+
+      questionInput.addEventListener('focus', prewarmModel, { once: true });
+      feedbackInput.addEventListener('focus', prewarmModel, { once: true });
+
+      // Fallback helper when built-in AI is unavailable in the environment
+      async function fallbackBaristaAnswer(question) {
+        const q = question.toLowerCase();
+        if (q.includes('maple') || q.includes('latte') || q.includes('oat')) {
+          return 'Our Maple Oat Latte combines rich espresso with steamed creamy oat milk and a hint of pure Vermont maple syrup for a smooth, naturally sweet seasonal treat.';
+        }
+        if (q.includes('cold brew') || q.includes('steep')) {
+          return 'Our signature Cold Brew is steeped slowly in cool water for 18 hours, extracting deep chocolatey notes with maximum smoothness and low acidity.';
+        }
+        return 'Ask me anything about our Maple Oat Latte (made with creamy oat milk and Vermont maple syrup) or our 18-hour steeped Cold Brew!';
+      }
+
+      function fallbackSentimentAnalysis(feedback) {
+        const text = feedback.toLowerCase();
+        const positiveWords = ['great', 'smooth', 'love', 'best', 'delicious', 'good', 'amazing', 'creamy', 'fresh'];
+        const negativeWords = ['bad', 'bitter', 'cold', 'slow', 'terrible', 'worst', 'sour', 'overpriced'];
+        let score = 3;
+        for (const w of positiveWords) {
+          if (text.includes(w)) score = Math.min(5, score + 1);
+        }
+        for (const w of negativeWords) {
+          if (text.includes(w)) score = Math.max(1, score - 1);
+        }
+        const category = score >= 4 ? 'positive' : score <= 2 ? 'negative' : 'neutral';
+        return { score, category };
+      }
+
+      // 1. Ask the Barista (Streaming response with availability check & safe text rendering)
+      askBtn.addEventListener('click', async () => {
+        const question = questionInput.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+        const cacheKey = `barista_cache_${question.toLowerCase()}`;
+
+        askBtn.disabled = true;
+        stopBtn.hidden = false;
+        baristaAnswerEl.textContent = '';
+
+        currentAbortController = new AbortController();
+
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            const fallbackText = await fallbackBaristaAnswer(question);
+            baristaAnswerEl.textContent = fallbackText;
+            return;
+          }
+
+          const session = await ensureBaristaSession();
+          const stream = session.promptStreaming(question, {
+            signal: currentAbortController.signal
+          });
+
+          let completeResult = '';
+          for await (const chunk of stream) {
+            completeResult += chunk;
+            // Render safely using textContent / append (never innerHTML)
+            baristaAnswerEl.append(chunk);
+          }
+
+          try {
+            sessionStorage.setItem(cacheKey, completeResult);
+          } catch {
+            // Ignore storage quota errors
+          }
+
+          updateContextUsageDisplay(session);
+        } catch (err) {
+          if (err.name === 'AbortError') {
+            baristaAnswerEl.append(' [Generation stopped]');
+          } else {
+            const cached = sessionStorage.getItem(cacheKey);
+            if (cached) {
+              baristaAnswerEl.textContent = cached;
+            } else {
+              baristaAnswerEl.textContent = await fallbackBaristaAnswer(question);
+            }
+          }
+        } finally {
+          askBtn.disabled = false;
+          stopBtn.hidden = true;
+          currentAbortController = null;
+        }
+      });
+
+      stopBtn.addEventListener('click', () => {
+        if (currentAbortController) {
+          currentAbortController.abort();
+        }
+      });
+
+      // 2. Customer Feedback Analyzer (Structured JSON output with score and category)
+      sentimentBtn.addEventListener('click', async () => {
+        const feedbackText = feedbackInput.value.trim() || 'The Maple Oat Latte and Cold Brew were both fantastic!';
+        sentimentBtn.disabled = true;
+        sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+        let tempCloneSession = null;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            const fallbackData = fallbackSentimentAnalysis(feedbackText);
+            sentimentOutputEl.textContent = JSON.stringify(fallbackData, null, 2);
+            return;
+          }
+
+          // Use a dedicated base session for sentiment analysis and clone per one-shot task
+          // so unrelated feedback items don't pollute each other's context window
+          if (!baseSentimentSession) {
+            baseSentimentSession = await LanguageModel.create({
+              initialPrompts: [{ role: 'system', content: SENTIMENT_SYSTEM_PROMPT }],
+              expectedInputs: [{ type: 'text' }],
+              expectedOutputs: [{ type: 'text' }],
+              monitor: createDownloadMonitor
+            });
+          }
+
+          tempCloneSession = await baseSentimentSession.clone();
+          const rawJson = await tempCloneSession.prompt(
+            `Analyze the following customer feedback and classify its sentiment score and category: "${feedbackText}"`,
+            { responseConstraint: SENTIMENT_SCHEMA }
+          );
+
+          const parsed = JSON.parse(rawJson);
+          sentimentOutputEl.textContent = JSON.stringify(parsed, null, 2);
+        } catch (err) {
+          const fallbackData = fallbackSentimentAnalysis(feedbackText);
+          sentimentOutputEl.textContent = JSON.stringify(fallbackData, null, 2);
+        } finally {
+          // Immediately destroy the one-shot clone to free memory
+          if (tempCloneSession && typeof tempCloneSession.destroy === 'function') {
+            tempCloneSession.destroy();
+          }
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      // Helper to render active cloned branches and manage lifecycle
+      function renderBranchList() {
+        branchListEl.textContent = '';
+        activeClonesCountEl.textContent = String(clonedSessions.length);
+
+        clonedSessions.forEach((entry, index) => {
+          const item = document.createElement('div');
+          item.className = 'branch-item';
+
+          const info = document.createElement('span');
+          const usage = entry.session?.contextUsage ?? 0;
+          const windowMax = entry.session?.contextWindow ?? 0;
+          info.textContent = `Branch #${entry.id} (${entry.label}) — Context: ${usage} / ${windowMax} tokens`;
+
+          const actions = document.createElement('div');
+          actions.className = 'ai-controls';
+
+          const switchBtn = document.createElement('button');
+          switchBtn.type = 'button';
+          switchBtn.className = 'btn';
+          switchBtn.style.marginTop = '0';
+          switchBtn.textContent = 'Switch to Branch';
+          switchBtn.addEventListener('click', () => {
+            // Destroy previous active session if it is not inside clonedSessions list or base
+            if (
+              activeBaristaSession &&
+              activeBaristaSession !== entry.session &&
+              !clonedSessions.some((c) => c.session === activeBaristaSession) &&
+              typeof activeBaristaSession.destroy === 'function'
+            ) {
+              activeBaristaSession.destroy();
+            }
+            activeBaristaSession = entry.session;
+            updateContextUsageDisplay(activeBaristaSession);
+            branchStatusEl.textContent = `Switched active conversation to Branch #${entry.id}.`;
+          });
+
+          const destroyBtn = document.createElement('button');
+          destroyBtn.type = 'button';
+          destroyBtn.className = 'btn';
+          destroyBtn.style.marginTop = '0';
+          destroyBtn.textContent = 'Destroy Branch';
+          destroyBtn.addEventListener('click', () => {
+            if (entry.session && typeof entry.session.destroy === 'function') {
+              entry.session.destroy();
+            }
+            clonedSessions.splice(index, 1);
+            if (activeBaristaSession === entry.session) {
+              activeBaristaSession = null;
+            }
+            updateContextUsageDisplay(activeBaristaSession);
+            branchStatusEl.textContent = `Destroyed Branch #${entry.id} and freed its memory.`;
+            renderBranchList();
+          });
+
+          actions.append(switchBtn, destroyBtn);
+          item.append(info, actions);
+          branchListEl.append(item);
+        });
+      }
+
+      // 3. Conversation Branching: Clone active session, track context usage, and clean up unneeded sessions
+      cloneBtn.addEventListener('click', async () => {
+        cloneBtn.disabled = true;
+        try {
+          const availability = await checkModelAvailability();
+          if (availability === 'unavailable') {
+            branchStatusEl.textContent = 'Built-in AI LanguageModel is unavailable; cannot clone live hardware session.';
+            return;
+          }
+
+          const sourceSession = await ensureBaristaSession();
+
+          // If active session is close to overflowing (> 80% of contextWindow), prune oldest unneeded clones automatically
+          const usage = sourceSession.contextUsage ?? 0;
+          const maxWindow = sourceSession.contextWindow ?? 0;
+          if (maxWindow > 0 && usage / maxWindow > 0.8 && clonedSessions.length > 0) {
+            const oldest = clonedSessions.shift();
+            if (oldest?.session && typeof oldest.session.destroy === 'function') {
+              oldest.session.destroy();
+            }
+          }
+
+          const clonedSession = await sourceSession.clone();
+          cloneCounter += 1;
+
+          clonedSessions.push({
+            id: cloneCounter,
+            label: `Cloned at ${usage} tokens`,
+            session: clonedSession
+          });
+
+          updateContextUsageDisplay(sourceSession);
+          branchStatusEl.textContent =
+            `Created Branch #${cloneCounter} from active session (Context usage: ${usage}/${maxWindow} tokens).`;
+          renderBranchList();
+        } catch (err) {
+          branchStatusEl.textContent = `Error cloning session: ${err.message || err}`;
+        } finally {
+          cloneBtn.disabled = false;
+        }
+      });
+
+      // Clean up all unneeded cloned sessions and reset to a fresh baseline clone
+      function cleanupUnneededSessions() {
+        let destroyedCount = 0;
+        while (clonedSessions.length > 0) {
+          const entry = clonedSessions.pop();
+          if (entry?.session && typeof entry.session.destroy === 'function') {
+            entry.session.destroy();
+            destroyedCount += 1;
+          }
+        }
+
+        if (activeBaristaSession && typeof activeBaristaSession.destroy === 'function') {
+          activeBaristaSession.destroy();
+          activeBaristaSession = null;
+          destroyedCount += 1;
+        }
+
+        updateContextUsageDisplay(null);
+        renderBranchList();
+        branchStatusEl.textContent = `Cleaned up ${destroyedCount} unneeded session(s) and freed device memory.`;
+      }
+
+      cleanupBtn.addEventListener('click', cleanupUnneededSessions);
+
+      // Destroy all active and base sessions on page unload to prevent memory leaks
+      window.addEventListener('pagehide', () => {
+        cleanupUnneededSessions();
+        if (baseBaristaSession && typeof baseBaristaSession.destroy === 'function') {
+          baseBaristaSession.destroy();
+          baseBaristaSession = null;
+        }
+        if (baseSentimentSession && typeof baseSentimentSession.destroy === 'function') {
+          baseSentimentSession.destroy();
+          baseSentimentSession = null;
+        }
+      });
+    })();
+  </script>
