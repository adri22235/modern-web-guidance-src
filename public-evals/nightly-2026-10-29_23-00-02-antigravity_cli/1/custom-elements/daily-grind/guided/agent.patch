+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        --_card-bg: var(--card-bg, white);
+        --_primary: var(--primary, #4e342e);
+        --_secondary: var(--secondary, #d7ccc8);
+        --_accent: var(--accent, #ffab40);
+        --_text: var(--text, #3e2723);
+        display: block;
+        container-type: inline-size;
+      }
+
+      :host([disabled]) {
+        opacity: 0.55;
+        pointer-events: none;
+      }
+
+      .card {
+        background: var(--_card-bg);
+        color: var(--_text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        position: relative;
+        border: 2px solid transparent;
+        transition: transform 0.2s ease, box-shadow 0.2s ease;
+      }
+
+      :host([featured]) .card {
+        border-color: var(--_accent);
+      }
+
+      .badge {
+        display: none;
+        align-self: center;
+        background: var(--_accent);
+        color: var(--_text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 2px 10px;
+        border-radius: 999px;
+        margin-bottom: 8px;
+      }
+
+      :host([featured]) .badge {
+        display: inline-block;
+      }
+
+      h3 {
+        margin: 0 0 10px;
+        color: var(--_primary);
+      }
+
+      .description {
+        margin: 0 0 12px;
+      }
+
+      .meta {
+        display: flex;
+        justify-content: center;
+        align-items: baseline;
+        gap: 12px;
+        font-size: 0.9rem;
+        margin-bottom: 4px;
+      }
+
+      .price {
+        font-weight: 700;
+        color: var(--_primary);
+      }
+
+      .calories {
+        color: #6d4c41;
+        font-size: 0.85rem;
+      }
+
+      .btn {
+        display: inline-block;
+        align-self: center;
+        background: var(--_primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover {
+        background: var(--_text);
+      }
+
+      .btn[aria-disabled="true"] {
+        background: var(--_secondary);
+        color: var(--_text);
+        cursor: not-allowed;
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <div>
+          <span class="badge" part="badge">Featured</span>
+          <h3 part="heading"></h3>
+          <p class="description" part="description"></p>
+          <div class="meta" part="meta">
+            <span class="price" part="price"></span>
+            <span class="calories" part="calories"></span>
+          </div>
+          <slot></slot>
+        </div>
+        <a class="btn" part="cta">View Details</a>
+      </article>
+    `;
+
+    export class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'cta',
+        'price',
+        'calories',
+        'featured',
+        'disabled',
+      ];
+
+      #headingEl;
+      #descriptionEl;
+      #priceEl;
+      #caloriesEl;
+      #linkEl;
+      #slotEl;
+      #abortController = null;
+
+      constructor() {
+        super();
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        shadowRoot.adoptedStyleSheets = [sheet];
+        shadowRoot.append(template.content.cloneNode(true));
+
+        this.#headingEl = shadowRoot.querySelector('h3');
+        this.#descriptionEl = shadowRoot.querySelector('.description');
+        this.#priceEl = shadowRoot.querySelector('.price');
+        this.#caloriesEl = shadowRoot.querySelector('.calories');
+        this.#linkEl = shadowRoot.querySelector('.btn');
+        this.#slotEl = shadowRoot.querySelector('slot');
+      }
+
+      // String attributes reflected via getter/setter.
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(v) {
+        v ? this.setAttribute('name', v) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(v) {
+        v ? this.setAttribute('description', v) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', v) : this.removeAttribute('href');
+      }
+
+      get cta() {
+        return this.getAttribute('cta') ?? '';
+      }
+      set cta(v) {
+        v ? this.setAttribute('cta', v) : this.removeAttribute('cta');
+      }
+
+      // Numeric attributes: coerce from string on read, serialize on write.
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(v) {
+        this.setAttribute('price', String(v));
+      }
+
+      get calories() {
+        return Number(this.getAttribute('calories')) || 0;
+      }
+      set calories(v) {
+        this.setAttribute('calories', String(v));
+      }
+
+      // Boolean attributes: present = true, absent = false. Never set to "false".
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      connectedCallback() {
+        for (const prop of CoffeeCard.observedAttributes) {
+          this.#upgradeProperty(prop);
+        }
+
+        // Make setup idempotent across multiple insertions.
+        this.#abortController?.abort();
+        this.#abortController = new AbortController();
+        const { signal } = this.#abortController;
+
+        this.#slotEl.addEventListener(
+          'slotchange',
+          () => {
+            const hasSlottedNodes = this.#slotEl.assignedNodes({ flatten: true }).some(
+              (node) => node.nodeType === Node.ELEMENT_NODE || (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+            );
+            this.#slotEl.hidden = !hasSlottedNodes;
+          },
+          { signal }
+        );
+
+        this.#linkEl.addEventListener(
+          'click',
+          (event) => {
+            if (this.disabled) {
+              event.preventDefault();
+              event.stopImmediatePropagation();
+            }
+          },
+          { signal }
+        );
+
+        this.#render();
+      }
+
+      disconnectedCallback() {
+        this.#abortController?.abort();
+        this.#abortController = null;
+      }
+
+      connectedMoveCallback() {
+        // Preserve existing state and active listeners when relocated via Node.moveBefore().
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#render();
+        }
+      }
+
+      #upgradeProperty(prop) {
+        if (Object.prototype.hasOwnProperty.call(this, prop)) {
+          const value = this[prop];
+          delete this[prop];
+          this[prop] = value;
+        }
+      }
+
+      #render() {
+        this.#headingEl.textContent = this.name;
+        this.#descriptionEl.textContent = this.description;
+
+        const priceVal = this.price;
+        this.#priceEl.textContent = priceVal > 0 ? `$${priceVal.toFixed(2)}` : '';
+        this.#priceEl.hidden = priceVal <= 0;
+
+        const caloriesVal = this.calories;
+        this.#caloriesEl.textContent = caloriesVal > 0 ? `${caloriesVal} cal` : '';
+        this.#caloriesEl.hidden = caloriesVal <= 0;
+
+        this.#linkEl.textContent = this.cta || 'View Details';
+
+        if (this.disabled) {
+          this.#linkEl.removeAttribute('href');
+          this.#linkEl.setAttribute('aria-disabled', 'true');
+          this.#linkEl.setAttribute('tabindex', '-1');
+        } else {
+          const targetHref = this.href;
+          if (targetHref) {
+            this.#linkEl.setAttribute('href', targetHref);
+          } else {
+            this.#linkEl.removeAttribute('href');
+          }
+          this.#linkEl.removeAttribute('aria-disabled');
+          this.#linkEl.removeAttribute('tabindex');
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+    window.CoffeeCard = CoffeeCard;
+  </script>
