+          color: #5d4037;
+          flex-wrap: wrap;
+        }
+
+        .price {
+          font-weight: 700;
+          font-size: 1.05rem;
+          color: var(--primary, #4e342e);
+        }
+
+        .rating {
+          color: #ef6c00;
+          font-weight: 600;
+        }
+
+        .calories {
+          color: #6d4c41;
+        }
+
+        .btn {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          transition: background 0.3s, opacity 0.2s;
+          align-self: center;
+          cursor: pointer;
+        }
+
+        .btn:hover {
+          background: #3e2723;
+        }
+
+        .btn[aria-disabled="true"] {
+          background: #9e9e9e;
+          pointer-events: none;
+          cursor: not-allowed;
+        }
+      </style>
+      <article class="card" part="card">
+        <div>
+          <div class="badges" part="badges"></div>
+          <h3 class="title" part="title"><slot name="title"></slot></h3>
+          <p class="description" part="description"><slot></slot></p>
+        </div>
+        <div>
+          <div class="meta" part="meta">
+            <span class="price" part="price" hidden></span>
+            <span class="rating" part="rating" hidden></span>
+            <span class="calories" part="calories" hidden></span>
+          </div>
+          <a class="btn" part="button" href="#"></a>
+        </div>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static STRING_ATTRIBUTES = [
+        'name',
+        'title',
+        'description',
+        'href',
+        'link',
+        'action-text',
+        'roast',
+        'origin',
+        'image'
+      ];
+
+      static NUMERIC_ATTRIBUTES = [
+        'price',
+        'rating',
+        'calories',
+        'intensity',
+        'stock'
+      ];
+
+      static BOOLEAN_ATTRIBUTES = [
+        'featured',
+        'seasonal',
+        'iced',
+        'decaf',
+        'sold-out',
+        'in-stock',
+        'disabled'
+      ];
+
+      static get observedAttributes() {
+        return [
+          ...CoffeeCard.STRING_ATTRIBUTES,
+          ...CoffeeCard.NUMERIC_ATTRIBUTES,
+          ...CoffeeCard.BOOLEAN_ATTRIBUTES
+        ];
+      }
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.appendChild(coffeeCardTemplate.content.cloneNode(true));
+
+        this._isConnected = false;
+        this._handleActionClick = this._handleActionClick.bind(this);
+
+        this._elements = {
+          card: this.shadowRoot.querySelector('.card'),
+          badges: this.shadowRoot.querySelector('.badges'),
+          title: this.shadowRoot.querySelector('.title'),
+          description: this.shadowRoot.querySelector('.description'),
+          meta: this.shadowRoot.querySelector('.meta'),
+          price: this.shadowRoot.querySelector('.price'),
+          rating: this.shadowRoot.querySelector('.rating'),
+          calories: this.shadowRoot.querySelector('.calories'),
+          button: this.shadowRoot.querySelector('.btn')
+        };
+      }
+
+      connectedCallback() {
+        this._isConnected = true;
+
+        // Upgrade any properties that may have been set on the instance before custom element definition/upgrade
+        for (const attr of CoffeeCard.observedAttributes) {
+          this._upgradeProperty(this._attrToProp(attr));
+        }
+        this._upgradeProperty('name');
+        this._upgradeProperty('title');
+
+        this._elements.button.addEventListener('click', this._handleActionClick);
+        this.render();
+      }
+
+      disconnectedCallback() {
+        this._isConnected = false;
+        this._elements.button.removeEventListener('click', this._handleActionClick);
+      }
+
+      adoptedCallback() {
+        this.render();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+        if (this._isConnected) {
+          this.render();
+        }
+      }
+
+      _attrToProp(attr) {
+        return attr.replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
+      }
+
+      _upgradeProperty(prop) {
+        if (Object.prototype.hasOwnProperty.call(this, prop)) {
+          const value = this[prop];
+          delete this[prop];
+          this[prop] = value;
+        }
+      }
+
+      // String attribute helpers (reflects string properties to attributes)
+      _getStringAttr(attr, fallback = '') {
+        return this.hasAttribute(attr) ? this.getAttribute(attr) : fallback;
+      }
+
+      _setStringAttr(attr, value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute(attr);
+        } else {
+          this.setAttribute(attr, String(value));
+        }
+      }
+
+      // Numeric attribute helpers (reflects numeric properties to attributes)
+      _getNumberAttr(attr, fallback = null) {
+        if (!this.hasAttribute(attr)) return fallback;
+        const parsed = Number(this.getAttribute(attr));
+        return Number.isFinite(parsed) ? parsed : fallback;
+      }
+
+      _setNumberAttr(attr, value) {
+        if (value === null || value === undefined || value === '') {
+          this.removeAttribute(attr);
+          return;
+        }
+        const parsed = Number(value);
+        if (Number.isFinite(parsed)) {
+          this.setAttribute(attr, String(parsed));
+        } else {
+          this.removeAttribute(attr);
+        }
+      }
+
+      // Boolean attribute helpers (reflects boolean properties to presence/absence of attributes)
+      _getBooleanAttr(attr) {
+        return this.hasAttribute(attr);
+      }
+
+      _setBooleanAttr(attr, value) {
+        this.toggleAttribute(attr, Boolean(value));
+      }
+
+      // String Properties
+      get name() {
+        return this.hasAttribute('name')
+          ? this.getAttribute('name')
+          : this._getStringAttr('title', '');
+      }
+      set name(value) {
+        this._setStringAttr('name', value);
+      }
+
+      get title() {
+        return this.hasAttribute('title')
+          ? this.getAttribute('title')
+          : this._getStringAttr('name', '');
+      }
+      set title(value) {
+        this._setStringAttr('title', value);
+      }
+
+      get description() {
+        return this._getStringAttr('description', '');
+      }
+      set description(value) {
+        this._setStringAttr('description', value);
+      }
+
+      get href() {
+        return this.hasAttribute('href')
+          ? this.getAttribute('href')
+          : this._getStringAttr('link', '#');
+      }
+      set href(value) {
+        this._setStringAttr('href', value);
+      }
+
+      get link() {
+        return this.hasAttribute('link')
+          ? this.getAttribute('link')
+          : this._getStringAttr('href', '#');
+      }
+      set link(value) {
+        this._setStringAttr('link', value);
+      }
+
+      get actionText() {
+        return this._getStringAttr('action-text', 'View Details');
+      }
+      set actionText(value) {
+        this._setStringAttr('action-text', value);
+      }
+
+      get roast() {
+        return this._getStringAttr('roast', '');
+      }
+      set roast(value) {
+        this._setStringAttr('roast', value);
+      }
+
+      get origin() {
+        return this._getStringAttr('origin', '');
+      }
+      set origin(value) {
+        this._setStringAttr('origin', value);
+      }
+
+      get image() {
+        return this._getStringAttr('image', '');
+      }
+      set image(value) {
+        this._setStringAttr('image', value);
+      }
+
+      // Numeric Properties
+      get price() {
+        return this._getNumberAttr('price', null);
+      }
+      set price(value) {
+        this._setNumberAttr('price', value);
+      }
+
+      get rating() {
+        return this._getNumberAttr('rating', null);
+      }
+      set rating(value) {
+        this._setNumberAttr('rating', value);
+      }
+
+      get calories() {
+        return this._getNumberAttr('calories', null);
+      }
+      set calories(value) {
+        this._setNumberAttr('calories', value);
+      }
+
+      get intensity() {
+        return this._getNumberAttr('intensity', null);
+      }
+      set intensity(value) {
+        this._setNumberAttr('intensity', value);
+      }
+
+      get stock() {
+        return this._getNumberAttr('stock', null);
+      }
+      set stock(value) {
+        this._setNumberAttr('stock', value);
+      }
+
+      // Boolean Properties
+      get featured() {
+        return this._getBooleanAttr('featured');
+      }
+      set featured(value) {
+        this._setBooleanAttr('featured', value);
+      }
+
+      get seasonal() {
+        return this._getBooleanAttr('seasonal');
+      }
+      set seasonal(value) {
+        this._setBooleanAttr('seasonal', value);
+      }
+
+      get iced() {
+        return this._getBooleanAttr('iced');
+      }
+      set iced(value) {
+        this._setBooleanAttr('iced', value);
+      }
+
+      get decaf() {
+        return this._getBooleanAttr('decaf');
+      }
+      set decaf(value) {
+        this._setBooleanAttr('decaf', value);
+      }
+
+      get soldOut() {
+        return this._getBooleanAttr('sold-out');
+      }
+      set soldOut(value) {
+        this._setBooleanAttr('sold-out', value);
+      }
+
+      get inStock() {
+        return this._getBooleanAttr('in-stock');
+      }
+      set inStock(value) {
+        this._setBooleanAttr('in-stock', value);
+      }
+
+      get disabled() {
+        return this._getBooleanAttr('disabled');
+      }
+      set disabled(value) {
+        this._setBooleanAttr('disabled', value);
+      }
+
+      _handleActionClick(event) {
+        const isUnavailable = this.soldOut || this.disabled || (this.stock !== null && this.stock <= 0);
+        if (isUnavailable) {
+          event.preventDefault();
+          return;
+        }
+        this.dispatchEvent(
+          new CustomEvent('coffee-select', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              name: this.name,
+              description: this.description,
+              price: this.price,
+              rating: this.rating,
+              calories: this.calories,
+              roast: this.roast,
+              href: this.href,
+              featured: this.featured,
+              seasonal: this.seasonal,
+              iced: this.iced,
+              soldOut: this.soldOut,
+              inStock: this.inStock
+            }
+          })
+        );
+      }
+
+      render() {
+        const { badges, title, description, meta, price, rating, calories, button } = this._elements;
+
+        // Render text content
+        title.textContent = this.name;
+        description.textContent = this.description;
+
+        // Render badges
+        badges.innerHTML = '';
+        if (this.featured) {
+          const badge = document.createElement('span');
+          badge.className = 'badge badge-featured';
+          badge.textContent = 'Featured';
+          badges.appendChild(badge);
+        }
+        if (this.seasonal) {
+          const badge = document.createElement('span');
+          badge.className = 'badge badge-seasonal';
+          badge.textContent = 'Seasonal';
+          badges.appendChild(badge);
+        }
+        if (this.iced) {
+          const badge = document.createElement('span');
+          badge.className = 'badge badge-iced';
+          badge.textContent = 'Iced';
+          badges.appendChild(badge);
+        }
+        if (this.roast) {
+          const badge = document.createElement('span');
+          badge.className = 'badge badge-roast';
+          badge.textContent = `${this.roast} Roast`;
+          badges.appendChild(badge);
+        }
+        if (this.soldOut || (this.stock !== null && this.stock <= 0)) {
+          const badge = document.createElement('span');
+          badge.className = 'badge badge-sold-out';
+          badge.textContent = 'Sold Out';
+          badges.appendChild(badge);
+        }
+        badges.hidden = badges.childElementCount === 0;
+
+        // Render numeric metadata
+        const hasPrice = this.price !== null;
+        price.hidden = !hasPrice;
+        price.textContent = hasPrice ? `$${this.price.toFixed(2)}` : '';
+
+        const hasRating = this.rating !== null;
+        rating.hidden = !hasRating;
+        rating.textContent = hasRating ? `★ ${this.rating.toFixed(1)}` : '';
+
+        const hasCalories = this.calories !== null;
+        calories.hidden = !hasCalories;
+        calories.textContent = hasCalories ? `${this.calories} cal` : '';
+
+        meta.hidden = !hasPrice && !hasRating && !hasCalories;
+
+        // Render CTA button
+        const isUnavailable = this.soldOut || this.disabled || (this.stock !== null && this.stock <= 0);
+        button.href = this.href || '#';
+        button.textContent = this.soldOut ? 'Sold Out' : this.actionText;
+        if (isUnavailable) {
+          button.setAttribute('aria-disabled', 'true');
+          button.setAttribute('tabindex', '-1');
+        } else {
+          button.removeAttribute('aria-disabled');
+          button.removeAttribute('tabindex');
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
