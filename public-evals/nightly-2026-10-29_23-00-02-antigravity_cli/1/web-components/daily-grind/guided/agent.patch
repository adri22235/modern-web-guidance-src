+    display: none;
+    align-items: center;
+    gap: 6px;
+    font-size: 0.9rem;
+  }
+  .menu-toggle:hover,
+  .menu-toggle:focus-visible {
+    border-color: var(--_nav-accent);
+    color: var(--_nav-accent);
+  }
+  .nav-links {
