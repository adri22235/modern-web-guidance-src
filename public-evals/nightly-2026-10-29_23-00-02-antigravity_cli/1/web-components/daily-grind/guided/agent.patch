+
+const siteNavTemplate = document.createElement('template');
+siteNavTemplate.innerHTML = `
+  <nav part="nav" aria-label="Primary Navigation">
+    <a href="/" class="logo" part="logo"><slot name="logo">THE DAILY GRIND</slot></a>
+    <button type="button" class="menu-toggle" part="menu-toggle" aria-expanded="false" aria-controls="primary-nav-links">
+      <span aria-hidden="true">☰</span>
+      <span>Menu</span>
+    </button>
+    <div id="primary-nav-links" class="nav-links" part="links">
+      <slot></slot>
+      <slot name="cta"></slot>
+    </div>
+  </nav>
+`;
+
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['logo', 'open'];
+
+  #internals;
+  #open = false;
+  #onKeyDown = (e) => {
+    if (e.key === 'Escape' && this.#open) {
+      this.open = false;
+      this.shadowRoot?.querySelector('.menu-toggle')?.focus();
+    }
+  };
+
+  constructor() {
+    super();
+    if ('attachInternals' in this) {
+      this.#internals = this.attachInternals();
+    }
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.adoptedStyleSheets = [siteNavSheet];
+      this.shadowRoot.append(siteNavTemplate.content.cloneNode(true));
+    }
+
+    const toggleBtn = this.shadowRoot.querySelector('.menu-toggle');
+    toggleBtn?.addEventListener('click', () => {
+      this.open = !this.open;
+    });
+  }
+
+  connectedCallback() {
+    this.#syncLogo();
+    this.#syncOpenState();
+    document.addEventListener('keydown', this.#onKeyDown);
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('keydown', this.#onKeyDown);
+  }
+
+  connectedMoveCallback() {
+    // Preserve state on moveBefore() without tearing down global listeners
+  }
+
+  get logo() {
+    return this.getAttribute('logo') ?? 'THE DAILY GRIND';
+  }
+  set logo(v) {
+    v ? this.setAttribute('logo', v) : this.removeAttribute('logo');
+  }
+
+  get open() {
+    return this.#open;
+  }
+  set open(val) {
+    const next = Boolean(val);
+    if (this.#open === next && this.hasAttribute('open') === next) return;
+    this.#open = next;
+    this.toggleAttribute('open', next);
+    this.#syncOpenState();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'logo') {
+      this.#syncLogo();
+    } else if (name === 'open') {
+      this.#open = newVal !== null;
+      this.#syncOpenState();
+    }
+  }
+
+  #syncLogo() {
+    const logoSlot = this.shadowRoot?.querySelector('slot[name="logo"]');
+    if (logoSlot && logoSlot.assignedElements().length === 0) {
+      logoSlot.textContent = this.logo;
+    }
+  }
+
+  #syncOpenState() {
+    if (this.#internals?.states) {
+      if (this.#open) {
+        this.#internals.states.add('open');
+      } else {
+        this.#internals.states.delete('open');
+      }
+    }
+    const toggleBtn = this.shadowRoot?.querySelector('.menu-toggle');
+    if (toggleBtn) {
+      toggleBtn.setAttribute('aria-expanded', String(this.#open));
+    }
+  }
+}
+
+if (!customElements.get('site-nav')) {
+  customElements.define('site-nav', SiteNav);
+}
