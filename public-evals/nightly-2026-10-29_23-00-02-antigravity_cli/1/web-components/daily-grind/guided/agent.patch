+      font-size: 0.95rem;
+    }
+    .price:empty {
+      display: none;
+    }
+    .body {
+      margin-bottom: 15px;
+    }
+    ::slotted(p) {
+      margin: 0;
+    }
+    .details-panel {
+      display: none;
+      text-align: left;
