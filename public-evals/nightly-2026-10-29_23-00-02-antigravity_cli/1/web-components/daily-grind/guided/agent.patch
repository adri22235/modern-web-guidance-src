+
+export class HeroBanner extends HTMLElement {
+  static observedAttributes = ['heading', 'subtitle', 'cta-href', 'cta-label', 'bg-image'];
+
+  constructor() {
+    super();
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.adoptedStyleSheets = [heroBannerSheet];
+      this.shadowRoot.append(heroBannerTemplate.content.cloneNode(true));
+    }
+  }
+
+  connectedCallback() {
+    this.#syncHero();
+  }
+
+  get heading() {
+    return this.getAttribute('heading') ?? 'Wake Up Your Senses';
+  }
+  set heading(v) {
+    v ? this.setAttribute('heading', v) : this.removeAttribute('heading');
+  }
+
+  get subtitle() {
+    return this.getAttribute('subtitle') ?? '';
+  }
+  set subtitle(v) {
+    v ? this.setAttribute('subtitle', v) : this.removeAttribute('subtitle');
+  }
+
+  get ctaHref() {
+    return this.getAttribute('cta-href') ?? '/order-online';
+  }
+  set ctaHref(v) {
+    v ? this.setAttribute('cta-href', v) : this.removeAttribute('cta-href');
+  }
+
+  get ctaLabel() {
+    return this.getAttribute('cta-label') ?? 'Order Now';
+  }
+  set ctaLabel(v) {
+    v ? this.setAttribute('cta-label', v) : this.removeAttribute('cta-label');
+  }
+
+  get bgImage() {
+    return this.getAttribute('bg-image') ?? '';
+  }
+  set bgImage(v) {
+    v ? this.setAttribute('bg-image', v) : this.removeAttribute('bg-image');
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) {
+      this.#syncHero();
+    }
+  }
+
+  #syncHero() {
+    if (!this.shadowRoot) return;
+    const headingSlot = this.shadowRoot.querySelector('slot[name="heading"]');
+    if (headingSlot && headingSlot.assignedElements().length === 0 && this.heading) {
+      headingSlot.textContent = this.heading;
+    }
+
+    const subtitleSlot = this.shadowRoot.querySelector('slot[name="subtitle"]');
