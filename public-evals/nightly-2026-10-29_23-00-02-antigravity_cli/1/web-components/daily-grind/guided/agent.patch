+// ---------------------------------------------------------------------------
+// 2. <site-nav> Web Component
+// ---------------------------------------------------------------------------
+const siteNavSheet = new CSSStyleSheet();
+siteNavSheet.replaceSync(`
+  :host {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    container-type: inline-size;
+    --_nav-bg: var(--nav-bg, var(--primary, #4e342e));
