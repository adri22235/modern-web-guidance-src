+/**
+ * Reusable, Accessible Web Components for The Daily Grind
+ * - <coffee-card>: Encapsulated product card with Declarative Shadow DOM hydration,
+ *   Constructable Stylesheets fallback, ElementInternals custom states (:state(favorited), :state(expanded)),
+ *   same-tree ARIA relationships, and attribute/property reflection.
+ * - <site-nav>: Responsive, accessible navigation bar with mobile menu disclosure and keyboard Escape handling.
+ * - <hero-banner>: Reusable hero banner with encapsulated styling and customizable slots/attributes.
+ */
+
+// ---------------------------------------------------------------------------
+// 1. <coffee-card> Web Component
+// ---------------------------------------------------------------------------
+const coffeeCardSheet = new CSSStyleSheet();
+coffeeCardSheet.replaceSync(`
+  @layer base, theme;
+  @layer base {
+    :host {
+      display: block;
+      container-type: inline-size;
+      --_card-bg: var(--card-bg, white);
+      --_card-fg: var(--card-fg, var(--text, #3e2723));
+      --_card-primary: var(--card-primary, var(--primary, #4e342e));
+      --_card-accent: var(--card-accent, var(--accent, #ffab40));
+    }
+    .card {
+      background: var(--_card-bg);
+      color: var(--_card-fg);
+      padding: 20px;
