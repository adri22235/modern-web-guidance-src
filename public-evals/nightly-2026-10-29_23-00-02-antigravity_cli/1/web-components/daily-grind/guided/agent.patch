+
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article class="card" part="card" aria-labelledby="card-title" aria-describedby="card-desc">
+    <div>
+      <div class="card-top">
+        <span class="badge" part="badge"></span>
+        <button type="button" class="fav-btn" part="favorite-button" aria-pressed="false">
+          <span aria-hidden="true">♡</span>
+          <span class="fav-label">Save</span>
+        </button>
+      </div>
+      <h3 id="card-title" part="title"><slot name="title"></slot></h3>
+      <div class="price" part="price"></div>
+      <div id="card-desc" class="body" part="description">
+        <slot></slot>
+      </div>
+      <div id="card-notes" class="details-panel" part="details">
+        <slot name="notes"></slot>
+      </div>
+    </div>
+    <div class="actions" part="actions">
+      <a href="#" class="btn" part="cta">View Details</a>
+      <button type="button" class="btn-secondary" part="notes-toggle" aria-expanded="false" aria-controls="card-notes">Tasting Notes</button>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'href', 'cta-label', 'price', 'badge', 'favorited'];
+
+  #internals;
+  #favorited = false;
+  #expanded = false;
+
+  constructor() {
+    super();
+    if ('attachInternals' in this) {
+      this.#internals = this.attachInternals();
+    }
+
+    // Fallback for engines that do not parse Declarative Shadow DOM (<template shadowrootmode>)
+    if (!this.shadowRoot && !Object.hasOwn(HTMLTemplateElement.prototype, 'shadowRootMode')) {
+      const dsdTemplate = this.querySelector('template[shadowrootmode]');
+      if (dsdTemplate) {
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.append(dsdTemplate.content.cloneNode(true));
+        dsdTemplate.remove();
+      }
+    }
+
+    // Reuse server-rendered Declarative Shadow DOM if present; otherwise create one from template
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+      this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+    }
+
+    // Hydrate in place: attach listeners once in constructor so moving the element does not duplicate them
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    favBtn?.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.dispatchEvent(
+        new CustomEvent('coffee-favorite-change', {
+          bubbles: true,
+          composed: true,
+          detail: { name: this.name, favorited: this.favorited },
+        })
+      );
+    });
+
+    const notesBtn = this.shadowRoot.querySelector('.btn-secondary');
+    notesBtn?.addEventListener('click', () => {
+      this.#setExpanded(!this.#expanded);
+    });
+
+    const notesSlot = this.shadowRoot.querySelector('slot[name="notes"]');
+    notesSlot?.addEventListener('slotchange', () => {
+      this.#syncNotesVisibility();
+    });
+  }
+
+  connectedCallback() {
+    this.#syncUI();
+    this.#syncNotesVisibility();
+  }
+
+  connectedMoveCallback() {
+    // Preserve component state and focus when moved via Node.moveBefore()
+  }
+
+  // Attribute ⇄ Property reflection
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(v) {
+    v ? this.setAttribute('name', v) : this.removeAttribute('name');
+  }
+
+  get href() {
+    return this.getAttribute('href') ?? '#';
+  }
+  set href(v) {
+    v ? this.setAttribute('href', v) : this.removeAttribute('href');
+  }
+
+  get ctaLabel() {
+    return this.getAttribute('cta-label') ?? 'View Details';
+  }
+  set ctaLabel(v) {
+    v ? this.setAttribute('cta-label', v) : this.removeAttribute('cta-label');
+  }
+
+  get price() {
+    return this.getAttribute('price') ?? '';
+  }
+  set price(v) {
+    v ? this.setAttribute('price', v) : this.removeAttribute('price');
+  }
+
+  get badge() {
+    return this.getAttribute('badge') ?? '';
+  }
+  set badge(v) {
+    v ? this.setAttribute('badge', v) : this.removeAttribute('badge');
+  }
+
+  get favorited() {
+    return this.#favorited;
+  }
+  set favorited(on) {
+    const next = Boolean(on);
+    if (this.#favorited === next && this.hasAttribute('favorited') === next) return;
+    this.#favorited = next;
+    this.toggleAttribute('favorited', next);
+    this.#syncFavoriteState();
+  }
+
+  attributeChangedCallback(attrName, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (attrName === 'favorited') {
+      this.#favorited = newVal !== null;
+      this.#syncFavoriteState();
+    } else {
+      this.#syncUI();
+    }
+  }
+
+  #setExpanded(expanded) {
+    this.#expanded = Boolean(expanded);
+    if (this.#internals?.states) {
+      if (this.#expanded) {
+        this.#internals.states.add('expanded');
+      } else {
+        this.#internals.states.delete('expanded');
+      }
+    }
+    const notesBtn = this.shadowRoot?.querySelector('.btn-secondary');
+    if (notesBtn) {
+      notesBtn.setAttribute('aria-expanded', String(this.#expanded));
+    }
+  }
+
+  #syncFavoriteState() {
+    if (this.#internals?.states) {
+      if (this.#favorited) {
+        this.#internals.states.add('favorited');
+      } else {
+        this.#internals.states.delete('favorited');
+      }
+    }
+    const favBtn = this.shadowRoot?.querySelector('.fav-btn');
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(this.#favorited));
+      const icon = favBtn.querySelector('[aria-hidden="true"]');
+      const label = favBtn.querySelector('.fav-label');
+      if (icon) icon.textContent = this.#favorited ? '♥' : '♡';
+      if (label) label.textContent = this.#favorited ? 'Saved' : 'Save';
+    }
+  }
+
+  #syncNotesVisibility() {
+    const notesSlot = this.shadowRoot?.querySelector('slot[name="notes"]');
+    const notesBtn = this.shadowRoot?.querySelector('.btn-secondary');
+    if (!notesSlot || !notesBtn) return;
+    const hasAssigned = notesSlot.assignedNodes({ flatten: true }).some(
+      (node) => node.nodeType === Node.ELEMENT_NODE || (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+    );
+    notesBtn.hidden = !hasAssigned;
+  }
+
+  #syncUI() {
+    if (!this.shadowRoot) return;
+    const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+    if (titleSlot && titleSlot.assignedElements().length === 0 && this.name) {
+      titleSlot.textContent = this.name;
+    }
+
+    const cta = this.shadowRoot.querySelector('.btn');
+    if (cta) {
+      cta.setAttribute('href', this.href);
+      cta.textContent = this.ctaLabel;
+    }
+
+    const priceEl = this.shadowRoot.querySelector('.price');
+    if (priceEl) {
+      priceEl.textContent = this.price;
+    }
+
+    const badgeEl = this.shadowRoot.querySelector('.badge');
+    if (badgeEl) {
+      badgeEl.textContent = this.badge;
+    }
+
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    if (favBtn && this.name) {
+      favBtn.setAttribute('aria-label', `Save ${this.name} to favorites`);
+    }
+
+    this.#favorited = this.hasAttribute('favorited');
+    this.#syncFavoriteState();
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
