+  connectedCallback() {
+    this.render();
+  }
+
+  _computeRecommendation() {
+    const { temp, roast, milk, sweetness, shots, size } = this._state;
+    let baseName = 'Artisan Signature Latte';
+    let basePrice = 5.25;
+    let image = 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80';
+
+    if (temp === 'Cold Steeped') {
+      baseName = '18-Hour Reserve Cold Brew';
+      basePrice = 4.95;
+      image = 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=800&q=80';
+    } else if (roast === 'Dark') {
+      baseName = 'Smokey Velvet Espresso Craft';
+      basePrice = 5.0;
+      image = 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80';
+    } else if (sweetness === 'Maple Syrup') {
+      baseName = 'Vermont Maple Oat Cortado';
+      basePrice = 5.5;
+    }
+
+    const extraShotCost = Math.max(0, shots - 2) * 0.75;
+    const sizeCost = size === '16oz' ? 0.75 : size === '8oz' ? -0.5 : 0;
+    const total = (basePrice + extraShotCost + sizeCost).toFixed(2);
+
+    return {
