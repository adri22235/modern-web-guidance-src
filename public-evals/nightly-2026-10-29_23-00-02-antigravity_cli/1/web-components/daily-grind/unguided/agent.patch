+/**
+ * 5. <daily-grind-customizer> / <dg-brew-customizer>
+ * Interactive Brew Customizer & Flavor Matcher section.
+ * Allows visitors to build a custom drink or get a personalized recommendation and add it directly to their bag.
+ */
+export class DailyGrindCustomizer extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._state = {
+      temp: 'Iced',
+      roast: 'Medium',
+      milk: 'Oat Milk',
+      sweetness: 'Maple Syrup',
+      shots: 2,
+      size: '12oz'
+    };
+  }
