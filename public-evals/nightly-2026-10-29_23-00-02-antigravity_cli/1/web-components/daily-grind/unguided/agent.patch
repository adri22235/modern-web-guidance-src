+/**
+ * The Daily Grind - Accessible, Reusable Web Components
+ * Provides encapsulated Shadow DOM styling, ARIA accessibility, keyboard navigation,
+ * and event-driven inter-component communication.
+ */
+
+const SHARED_THEME_VARS = `
+  :host {
+    --primary: var(--dg-primary, #4e342e);
+    --primary-dark: var(--dg-primary-dark, #3e2723);
+    --secondary: var(--dg-secondary, #d7ccc8);
+    --accent: var(--dg-accent, #ffab40);
+    --accent-hover: var(--dg-accent-hover, #ff9100);
+    --text: var(--dg-text, #3e2723);
+    --text-muted: var(--dg-text-muted, #6d4c41);
+    --light: var(--dg-light, #fafafa);
+    --surface: var(--dg-surface, #ffffff);
+    --radius: 10px;
+    --shadow-sm: 0 2px 8px rgba(62, 39, 35, 0.08);
+    --shadow-md: 0 8px 24px rgba(62, 39, 35, 0.14);
+    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    color: var(--text);
+    box-sizing: border-box;
+  }
+  *, *::before, *::after {
+    box-sizing: border-box;
+  }
+  :focus-visible {
+    outline: 3px solid var(--accent);
+    outline-offset: 2px;
+  }
+`;
