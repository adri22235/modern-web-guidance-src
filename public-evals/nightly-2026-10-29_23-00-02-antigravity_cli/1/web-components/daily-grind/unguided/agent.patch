+          color: var(--text-muted);
+        }
+        .qty-controls {
+          display: flex;
+          align-items: center;
+          gap: 8px;
+        }
+        .qty-btn {
+          width: 28px;
+          height: 28px;
+          border-radius: 5px;
+          border: 1px solid #d7ccc8;
+          background: #fafafa;
+          cursor: pointer;
+          font-weight: 700;
+        }
+        .drawer-footer {
+          padding: 18px 20px;
+          border-top: 1px solid #e0d6d2;
+          background: #fbf8f6;
+        }
+        .subtotal-row {
+          display: flex;
+          justify-content: space-between;
+          font-weight: 800;
+          font-size: 1.1rem;
+          margin-bottom: 12px;
+        }
+        .checkout-btn {
+          width: 100%;
+          background: var(--primary);
+          color: white;
+          border: none;
+          padding: 12px;
+          border-radius: 6px;
+          font-weight: 800;
+          font-size: 0.95rem;
+          cursor: pointer;
+        }
+        .checkout-btn:disabled {
+          opacity: 0.5;
+          cursor: not-allowed;
+        }
+        .toast {
+          position: fixed;
+          bottom: 24px;
+          right: 24px;
+          background: var(--primary-dark);
+          color: white;
+          padding: 12px 18px;
+          border-radius: 8px;
+          border-left: 4px solid var(--accent);
+          box-shadow: var(--shadow-md);
+          font-size: 0.9rem;
+          font-weight: 600;
+          opacity: 0;
+          transform: translateY(12px);
+          pointer-events: none;
+          transition: opacity 0.2s ease, transform 0.2s ease;
+          z-index: 1300;
+        }
+        .toast.visible {
+          opacity: 1;
+          transform: translateY(0);
+        }
+      </style>
+      <div class="backdrop" part="backdrop"></div>
+      <aside
+        class="drawer"
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="cart-drawer-title"
+        aria-hidden="true"
+      >
+        <div class="drawer-header">
+          <h2 id="cart-drawer-title">Your Coffee Bag</h2>
+          <button type="button" class="close-btn" aria-label="Close coffee bag">&times;</button>
+        </div>
+        <ul class="cart-items" aria-live="polite">
+          <li class="empty-msg">Your coffee bag is currently empty. Add a seasonal favorite to get started!</li>
+        </ul>
+        <div class="drawer-footer">
+          <div class="subtotal-row">
+            <span>Estimated Total</span>
+            <span class="subtotal-val">$0.00</span>
+          </div>
+          <button type="button" class="checkout-btn" disabled>Proceed to Pickup Order</button>
+        </div>
+      </aside>
+      <div class="toast" role="status" aria-live="polite"></div>
+    `;
+
+    this.shadowRoot.querySelector('.backdrop').addEventListener('click', () => this.closeDrawer());
+    this.shadowRoot.querySelector('.close-btn').addEventListener('click', () => this.closeDrawer());
+
+    const listEl = this.shadowRoot.querySelector('.cart-items');
+    listEl.addEventListener('click', (e) => {
+      const btn = e.target.closest('.qty-btn');
+      if (!btn) return;
+      const { action, key } = btn.dataset;
+      const idx = this._items.findIndex(item => item.key === key);
+      if (idx === -1) return;
+      if (action === 'inc') {
+        this._items[idx].qty += 1;
+      } else if (action === 'dec') {
+        this._items[idx].qty -= 1;
+        if (this._items[idx].qty <= 0) {
+          this._items.splice(idx, 1);
+        }
+      }
+      this._broadcastCartState();
+      this._updateDrawerContent();
+    });
+
+    const checkoutBtn = this.shadowRoot.querySelector('.checkout-btn');
+    checkoutBtn.addEventListener('click', () => {
+      if (this._items.length === 0) return;
+      this._items = [];
+      this._broadcastCartState();
+      this._updateDrawerContent();
+      this.closeDrawer();
+      this._showToast('Order received! Your barista is preparing your fresh pour.');
+    });
+  }
+}
