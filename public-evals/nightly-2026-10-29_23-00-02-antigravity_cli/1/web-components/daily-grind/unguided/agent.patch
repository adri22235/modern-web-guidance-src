+          display: flex;
+          justify-content: center;
+          flex-wrap: wrap;
+          gap: 8px 18px;
+        }
+        .footer-links a {
+          color: var(--text);
+          text-decoration: none;
+          font-size: 0.9rem;
+          font-weight: 600;
+        }
+        .footer-links a:hover {
+          text-decoration: underline;
+        }
+        p {
+          margin: 0;
+          font-size: 0.9rem;
+        }
+      </style>
+      <footer role="contentinfo">
+        <nav class="footer-links" aria-label="Footer Links">
+          <a href="/about">Our Story</a>
+          <a href="/careers">Join the Team</a>
+          <a href="/contact">Contact Us</a>
+          <a href="/privacy-policy">Privacy</a>
+        </nav>
+        <p>&copy; ${year} The Daily Grind Coffee Co. All rights reserved.</p>
+      </footer>
+    `;
+  }
+}
+
+// Register all Custom Elements safely
+const COMPONENT_DEFINITIONS = [
+  ['daily-grind-navbar', DailyGrindNavbar],
+  ['dg-navbar', DailyGrindNavbar],
+  ['daily-grind-hero', DailyGrindHero],
+  ['dg-hero', DailyGrindHero],
+  ['coffee-card', CoffeeCard],
+  ['dg-coffee-card', CoffeeCard],
+  ['coffee-menu-section', CoffeeMenuSection],
+  ['daily-grind-menu', CoffeeMenuSection],
+  ['daily-grind-customizer', DailyGrindCustomizer],
+  ['dg-brew-customizer', DailyGrindCustomizer],
+  ['daily-grind-rewards', DailyGrindRewards],
+  ['dg-rewards-banner', DailyGrindRewards],
+  ['daily-grind-cart', DailyGrindCart],
+  ['dg-cart-drawer', DailyGrindCart],
+  ['daily-grind-footer', DailyGrindFooter],
+  ['dg-footer', DailyGrindFooter]
+];
+
+COMPONENT_DEFINITIONS.forEach(([tagName, ctor]) => {
+  if (!customElements.get(tagName)) {
+    customElements.define(tagName, ctor);
+  }
+});
