+/**
+ * 3. <coffee-card>
+ * Reusable, accessible Web Component representing an artisanal coffee menu item.
+ * Features:
+ * - Shadow DOM style & structure encapsulation
+ * - Support for both attributes (`name`, `description`, `price`, `roast`, `category`, `image`, `calories`, `origin`, `tasting-notes`, `badge`, `href`) and named `<slot>` content
+ * - Interactive size selector (Small 8oz, Medium 12oz, Large 16oz) & milk/temperature selector with live price recalculation
+ * - Expandable accessible details panel (`aria-expanded`, `aria-controls`)
+ * - Favorite toggle button (`aria-pressed`)
+ * - Dispatches `coffee-add-to-cart`, `coffee-view-details`, and `coffee-favorite-change` custom events
+ */
+export class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'coffee-id',
+      'name',
+      'description',
+      'price',
+      'roast',
+      'category',
+      'image',
+      'origin',
+      'tasting-notes',
+      'caffeine',
+      'badge',
+      'href',
+      'favorited'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._selectedSize = '12oz';
+    this._sizeModifiers = {
+      '8oz': -0.5,
+      '12oz': 0,
+      '16oz': 0.75
+    };
+    this._selectedMilk = 'Oat';
+    this._detailsOpen = false;
+    this._isFavorited = false;
+  }
+
+  connectedCallback() {
+    this._isFavorited = this.hasAttribute('favorited') && this.getAttribute('favorited') !== 'false';
+    this.render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal || !this.isConnected) return;
+    if (name === 'favorited') {
+      this._isFavorited = newVal !== null && newVal !== 'false';
+    }
+    this.render();
+  }
+
+  get basePrice() {
+    const raw = parseFloat(this.getAttribute('price') || '4.75');
+    return Number.isNaN(raw) ? 4.75 : raw;
+  }
+
+  get currentPrice() {
+    const mod = this._sizeModifiers[this._selectedSize] || 0;
+    return (this.basePrice + mod).toFixed(2);
+  }
+
+  get coffeeData() {
+    return {
+      id: this.getAttribute('coffee-id') || (this.getAttribute('name') || 'coffee').toLowerCase().replace(/\s+/g, '-'),
+      name: this.getAttribute('name') || 'Artisanal Coffee',
+      description: this.getAttribute('description') || '',
+      basePrice: this.basePrice,
+      price: parseFloat(this.currentPrice),
+      size: this._selectedSize,
+      milk: this._selectedMilk,
+      roast: this.getAttribute('roast') || 'Medium',
+      category: this.getAttribute('category') || 'seasonal',
+      origin: this.getAttribute('origin') || 'Single-Origin Colombia & Ethiopia',
+      tastingNotes: this.getAttribute('tasting-notes') || 'Caramel, toasted hazelnut, cocoa',
+      caffeine: this.getAttribute('caffeine') || '150mg',
+      image: this.getAttribute('image') || 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80',
+      href: this.getAttribute('href') || '/menu/seasonal'
+    };
+  }
+
+  _updateDisplayedPrice() {
+    const priceEl = this.shadowRoot.querySelector('.price-tag');
+    if (priceEl) {
+      priceEl.textContent = `$${this.currentPrice}`;
+    }
+  }
+
+  render() {
+    const data = this.coffeeData;
+    const badge = this.getAttribute('badge') || '';
+    const roast = data.roast;
+    const notesList = data.tastingNotes
+      .split(',')
+      .map(s => s.trim())
+      .filter(Boolean);
+
+    this.shadowRoot.innerHTML = `
+      <style>
+        ${SHARED_THEME_VARS}
+        :host {
+          display: block;
+          height: 100%;
+        }
+        article.card {
+          background: var(--surface);
+          border-radius: var(--radius);
+          box-shadow: var(--shadow-sm);
+          overflow: hidden;
+          display: flex;
+          flex-direction: column;
