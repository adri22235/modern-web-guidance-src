+        }
+        .pill {
+          background: rgba(62, 39, 35, 0.88);
+          color: #fff;
+          font-size: 0.72rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.6px;
+          padding: 4px 10px;
