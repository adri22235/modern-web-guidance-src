+/**
+ * 8. <daily-grind-footer> / <dg-footer>
+ * Reusable accessible footer component.
+ */
+export class DailyGrindFooter extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  render() {
+    const year = this.getAttribute('year') || '2026';
+    this.shadowRoot.innerHTML = `
+      <style>
+        ${SHARED_THEME_VARS}
