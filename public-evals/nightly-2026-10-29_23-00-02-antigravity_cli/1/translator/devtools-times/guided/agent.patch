index 0000000..33f1555
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,647 @@
+import React, { useState, useEffect, useId, useRef } from 'react';
+import { LanguageIcon, ArrowPathIcon, ArrowsRightLeftIcon } from '@heroicons/react/24/outline';
+
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Spanish' },
+  { code: 'fr', label: 'French' },
+  { code: 'de', label: 'German' },
+  { code: 'it', label: 'Italian' },
+  { code: 'pt', label: 'Portuguese' },
+  { code: 'nl', label: 'Dutch' },
+  { code: 'pl', label: 'Polish' },
+  { code: 'ru', label: 'Russian' },
+  { code: 'uk', label: 'Ukrainian' },
+  { code: 'ja', label: 'Japanese' },
+  { code: 'ko', label: 'Korean' },
+  { code: 'zh', label: 'Chinese (Simplified)' },
+  { code: 'zh-Hant', label: 'Chinese (Traditional)' },
+  { code: 'ar', label: 'Arabic' },
+  { code: 'hi', label: 'Hindi' },
+  { code: 'bn', label: 'Bengali' },
+  { code: 'tr', label: 'Turkish' },
+  { code: 'vi', label: 'Vietnamese' },
+  { code: 'th', label: 'Thai' },
+  { code: 'id', label: 'Indonesian' },
+  { code: 'sv', label: 'Swedish' },
+  { code: 'da', label: 'Danish' },
+  { code: 'fi', label: 'Finnish' },
+  { code: 'no', label: 'Norwegian' },
+  { code: 'cs', label: 'Czech' },
+  { code: 'el', label: 'Greek' },
+  { code: 'he', label: 'Hebrew' },
+  { code: 'hu', label: 'Hungarian' },
+  { code: 'ro', label: 'Romanian' },
+  { code: 'bg', label: 'Bulgarian' },
+  { code: 'hr', label: 'Croatian' },
+  { code: 'lt', label: 'Lithuanian' },
+  { code: 'sk', label: 'Slovak' },
+  { code: 'sl', label: 'Slovenian' },
+  { code: 'kn', label: 'Kannada' },
+  { code: 'mr', label: 'Marathi' },
+  { code: 'ta', label: 'Tamil' },
+  { code: 'te', label: 'Telugu' },
+];
+
+interface ArticleTranslationControlProps {
+  scopeSelector?: string;
+  compact?: boolean;
+  defaultSourceLanguage?: string;
+  defaultTargetLanguage?: string;
+  contextLabel?: string;
+}
+
+interface TranslatableRecord {
+  element: HTMLElement;
+  originalText: string;
+  originalLang: string | null;
+}
+
+export default function ArticleTranslationControl({
+  scopeSelector,
+  compact = false,
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+  contextLabel,
+}: ArticleTranslationControlProps) {
+  const instanceId = useId();
+  const rootRef = useRef<HTMLDivElement>(null);
+  const originalsRef = useRef<Map<HTMLElement, TranslatableRecord>>(new Map());
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const [isSupported, setIsSupported] = useState<boolean | null>(null);
+  const [hasLanguageDetector, setHasLanguageDetector] = useState<boolean>(false);
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>(defaultTargetLanguage);
+  const [availability, setAvailability] = useState<
+    'available' | 'downloadable' | 'downloading' | 'unavailable' | 'checking'
+  >('checking');
+
+  const [status, setStatus] = useState<
+    'idle' | 'detecting' | 'downloading' | 'translating' | 'translated' | 'error'
+  >('idle');
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [activeTranslatedLang, setActiveTranslatedLang] = useState<string | null>(null);
+  const [isExpanded, setIsExpanded] = useState<boolean>(!compact);
+
+  // Check if global Translator and LanguageDetector exist on client
+  useEffect(() => {
+    const supported = typeof self !== 'undefined' && 'Translator' in self && Boolean(self.Translator);
+    setIsSupported(supported);
+    setHasLanguageDetector(
+      typeof self !== 'undefined' && 'LanguageDetector' in self && Boolean(self.LanguageDetector),
+    );
+  }, []);
+
+  // Check availability for the selected source and target language pair
+  useEffect(() => {
+    if (!isSupported || !self.Translator) {
+      if (isSupported === false) {
+        setAvailability('unavailable');
+      }
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      setAvailability('unavailable');
+      return;
+    }
+
+    let cancelled = false;
+    setAvailability('checking');
+
+    const options = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    self.Translator.availability(options)
+      .then((result) => {
+        if (!cancelled) {
+          setAvailability(result);
+        }
+      })
+      .catch(() => {
+        if (!cancelled) {
+          setAvailability('unavailable');
+        }
+      });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [isSupported, sourceLanguage, targetLanguage]);
+
+  // Cleanup any in-flight operations on unmount
+  useEffect(() => {
+    return () => {
+      abortControllerRef.current?.abort();
+    };
+  }, []);
+
+  const getScopeContainer = (): HTMLElement | null => {
+    if (typeof document === 'undefined') return null;
+    if (scopeSelector) {
+      const explicit = document.querySelector<HTMLElement>(scopeSelector);
+      if (explicit) return explicit;
+    }
+    if (rootRef.current) {
+      const closestContainer = rootRef.current.closest<HTMLElement>(
+        '[data-translatable-container], article',
+      );
+      if (closestContainer) return closestContainer;
+    }
+    return document.querySelector<HTMLElement>('main');
+  };
+
+  const getTranslatableElements = (container: HTMLElement): HTMLElement[] => {
+    const marked = Array.from(
+      container.querySelectorAll<HTMLElement>('[data-translatable]'),
+    ).filter((el) => {
+      // If we are inside an article that also contains nested related teasers,
+      // only translate elements belonging to this container unless container is main
+      const closestScope = el.closest<HTMLElement>('[data-translatable-container]');
+      if (
+        closestScope &&
+        container.hasAttribute('data-translatable-container') &&
+        closestScope !== container
+      ) {
+        return false;
+      }
+      return true;
+    });
+
+    const result: HTMLElement[] = [];
+    for (const item of marked) {
+      if (item.dataset.translatable === 'body') {
+        const blocks = Array.from(
+          item.querySelectorAll<HTMLElement>('p, h2, h3, h4, h5, h6, li, blockquote, figcaption'),
+        ).filter((block) => block.textContent && block.textContent.trim().length > 0);
+        if (blocks.length > 0) {
+          result.push(...blocks);
+        } else if (item.textContent && item.textContent.trim().length > 0) {
+          result.push(item);
+        }
+      } else if (item.textContent && item.textContent.trim().length > 0) {
+        result.push(item);
+      }
+    }
+    return result;
+  };
+
+  const recordOriginals = (elements: HTMLElement[]) => {
+    for (const el of elements) {
+      if (!originalsRef.current.has(el)) {
+        originalsRef.current.set(el, {
+          element: el,
+          originalText: el.textContent || '',
+          originalLang: el.getAttribute('lang'),
+        });
+      }
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    abortControllerRef.current?.abort();
+    originalsRef.current.forEach(({ element, originalText, originalLang }) => {
+      element.textContent = originalText;
+      if (originalLang === null) {
+        element.removeAttribute('lang');
+      } else {
+        element.setAttribute('lang', originalLang);
+      }
+    });
+    const container = getScopeContainer();
+    if (container && container.hasAttribute('data-translated-lang')) {
+      container.removeAttribute('lang');
+      container.removeAttribute('data-translated-lang');
+    }
+    setActiveTranslatedLang(null);
+    setStatus('idle');
+    setDownloadProgress(null);
+    setStatusMessage('Restored original language.');
+  };
+
+  const handleSwapLanguages = () => {
+    const prevSource = sourceLanguage;
+    setSourceLanguage(targetLanguage);
+    setTargetLanguage(prevSource);
+  };
+
+  const handleDetectSourceLanguage = async () => {
+    if (!hasLanguageDetector || !self.LanguageDetector) return;
+    const container = getScopeContainer();
+    if (!container) return;
+
+    const elements = getTranslatableElements(container);
+    recordOriginals(elements);
+
+    const sampleText = elements
+      .map((el) => originalsRef.current.get(el)?.originalText || el.textContent || '')
+      .join(' ')
+      .trim()
+      .slice(0, 1000);
+
+    if (sampleText.length < 10) {
+      setStatusMessage('Not enough text to reliably detect language.');
+      return;
+    }
+
+    try {
+      setStatus('detecting');
+      setStatusMessage('Detecting source language...');
+      const detectorAvailability = await self.LanguageDetector.availability();
+      if (detectorAvailability === 'unavailable') {
+        setStatus('error');
+        setStatusMessage('On-device language detection is unavailable.');
+        return;
+      }
+
+      const detector = await self.LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            setDownloadProgress(Math.round(e.loaded * 100));
+          });
+        },
+      });
+
+      const results = await detector.detect(sampleText);
+      detector.destroy();
+      setDownloadProgress(null);
+
+      if (results && results.length > 0) {
+        const topMatch = results[0];
+        const matchedOption = SUPPORTED_LANGUAGES.find(
+          (l) =>
+            l.code.toLowerCase() === topMatch.detectedLanguage.toLowerCase() ||
+            topMatch.detectedLanguage.toLowerCase().startsWith(l.code.toLowerCase() + '-'),
+        );
+        if (matchedOption) {
+          setSourceLanguage(matchedOption.code);
+          if (matchedOption.code === targetLanguage) {
+            const fallbackTarget = matchedOption.code === 'en' ? 'es' : 'en';
+            setTargetLanguage(fallbackTarget);
+          }
+          setStatus('idle');
+          setStatusMessage(
+            `Detected ${matchedOption.label} (${Math.round(topMatch.confidence * 100)}% confidence).`,
+          );
+          return;
+        }
+      }
+      setStatus('idle');
+      setStatusMessage('Could not match detected language to supported options.');
+    } catch (err: any) {
+      setDownloadProgress(null);
+      setStatus('error');
+      setStatusMessage(err?.message || 'Language detection failed.');
+    }
+  };
+
+  const handleTranslate = async () => {
+    if (!isSupported || !self.Translator) {
+      setStatus('error');
+      setStatusMessage('Client-side translation is currently unsupported in this browser.');
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      setStatus('error');
+      setStatusMessage('Please select different source and target languages.');
+      return;
+    }
+
+    const container = getScopeContainer();
+    if (!container) {
+      setStatus('error');
+      setStatusMessage('Could not locate article content to translate.');
+      return;
+    }
+
+    const elements = getTranslatableElements(container);
+    if (elements.length === 0) {
+      setStatus('error');
+      setStatusMessage('No translatable text found.');
+      return;
+    }
+
+    recordOriginals(elements);
+
+    abortControllerRef.current?.abort();
+    const abortController = new AbortController();
+    abortControllerRef.current = abortController;
+
+    const options = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    try {
+      setStatusMessage('Checking translation model availability...');
+      const currentAvailability = await self.Translator.availability(options);
+      setAvailability(currentAvailability);
+
+      if (currentAvailability === 'unavailable') {
+        setStatus('error');
+        setStatusMessage(
+          `On-device translation from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} is unavailable on this device.`,
+        );
+        return;
+      }
+
+      if (currentAvailability === 'downloadable' || currentAvailability === 'downloading') {
+        setStatus('downloading');
+        setDownloadProgress(0);
+        setStatusMessage('Downloading on-device language pack...');
+      } else {
+        setStatus('translating');
+        setDownloadProgress(null);
+        setStatusMessage('Initializing on-device translator...');
+      }
+
+      // Pass identical options (sourceLanguage, targetLanguage) plus monitor callback
+      const translator = await self.Translator.create({
+        ...options,
+        signal: abortController.signal,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round(e.loaded * 100);
+            setStatus('downloading');
+            setDownloadProgress(pct);
+            setStatusMessage(`Downloading language model (${pct}%)...`);
+          });
+        },
+      });
+
+      setStatus('translating');
+      setDownloadProgress(null);
+
+      const total = elements.length;
+      for (let i = 0; i < total; i++) {
+        if (abortController.signal.aborted) {
+          translator.destroy();
+          return;
+        }
+        const el = elements[i];
+        const originalRecord = originalsRef.current.get(el);
+        const sourceText = (originalRecord ? originalRecord.originalText : el.textContent || '').trim();
+        if (!sourceText) continue;
+
+        setStatusMessage(
+          total > 1
+            ? `Translating (${i + 1} of ${total})...`
+            : 'Translating on device...',
+        );
+        setDownloadProgress(Math.round(((i + 0.5) / total) * 100));
+
+        // Use streaming for longer paragraphs and standard translate() for headlines/teasers
+        if (sourceText.length > 260 && typeof translator.translateStreaming === 'function') {
+          const stream = translator.translateStreaming(sourceText, {
+            signal: abortController.signal,
+          });
+          let accumulated = '';
+          el.setAttribute('lang', targetLanguage);
+          for await (const chunk of stream) {
+            if (abortController.signal.aborted) break;
+            accumulated += chunk;
+            el.textContent = accumulated;
+          }
+        } else {
+          const translated = await translator.translate(sourceText, {
+            signal: abortController.signal,
+          });
+          el.textContent = translated;
+          el.setAttribute('lang', targetLanguage);
+        }
+      }
+
+      translator.destroy();
+
+      if (container.hasAttribute('data-translatable-container')) {
+        container.setAttribute('lang', targetLanguage);
+        container.setAttribute('data-translated-lang', targetLanguage);
+      }
+
+      const targetLabel =
+        SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage)?.label || targetLanguage;
+      setActiveTranslatedLang(targetLanguage);
+      setDownloadProgress(null);
+      setStatus('translated');
+      setStatusMessage(`Translated to ${targetLabel} on-device.`);
+    } catch (err: any) {
+      if (err?.name === 'AbortError') return;
+      setDownloadProgress(null);
+      setStatus('error');
+      if (err?.name === 'NotAllowedError') {
+        setStatusMessage('Please click Translate directly to allow model download.');
+      } else {
+        setStatusMessage(err?.message || 'Unable to complete on-device translation.');
+      }
+    }
+  };
+
+  const sourceSelectId = `${instanceId}-source-lang`;
+  const targetSelectId = `${instanceId}-target-lang`;
+  const progressId = `${instanceId}-progress`;
+  const statusId = `${instanceId}-status`;
+
+  const isBusy = status === 'downloading' || status === 'translating' || status === 'detecting';
+  const canTranslate =
+    Boolean(isSupported) &&
+    sourceLanguage !== targetLanguage &&
+    availability !== 'unavailable' &&
+    !isBusy;
+
+  const buttonLabel = contextLabel
+    ? `Translate ${contextLabel}`
+    : compact
+      ? 'Translate teaser'
+      : 'Translate article';
+
+  if (compact && !isExpanded) {
+    return (
+      <div ref={rootRef} className="inline-flex items-center">
+        <button
+          type="button"
+          onClick={() => setIsExpanded(true)}
+          aria-expanded={isExpanded}
+          aria-label={buttonLabel}
+          className="inline-flex items-center gap-1 text-xs font-medium text-gray-600 hover:text-amber-700 px-2 py-1 min-h-6 rounded border border-gray-200 hover:border-amber-400 bg-gray-50 transition-colors cursor-pointer"
+        >
+          <LanguageIcon className="w-3.5 h-3.5 flex-shrink-0" aria-hidden="true" />
+          <span>{activeTranslatedLang ? `Translated (${activeTranslatedLang.toUpperCase()})` : 'Translate'}</span>
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div
+      ref={rootRef}
+      role="region"
+      aria-label={contextLabel ? `Translation controls for ${contextLabel}` : 'On-device translation controls'}
+      className={
+        compact
+          ? 'mt-2 p-2.5 rounded-md border border-gray-200 bg-gray-50 text-xs space-y-2'
+          : 'my-4 p-3.5 rounded-lg border border-gray-200 bg-gray-50/90 text-sm space-y-2.5'
+      }
+    >
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <div className="flex items-center gap-1.5 font-semibold text-gray-800">
+          <LanguageIcon className="w-4 h-4 text-amber-700 flex-shrink-0" aria-hidden="true" />
+          <span>On-Device Translation</span>
+          {availability === 'downloadable' && isSupported && (
+            <span className="text-[11px] font-normal px-1.5 py-0.5 rounded bg-amber-100 text-amber-900">
+              Model download required
+            </span>
+          )}
+          {availability === 'available' && isSupported && (
+            <span className="text-[11px] font-normal px-1.5 py-0.5 rounded bg-green-100 text-green-800">
+              Ready on device
+            </span>
+          )}
+        </div>
+
+        {compact && (
+          <button
+            type="button"
+            onClick={() => setIsExpanded(false)}
+            aria-label={contextLabel ? `Close translation controls for ${contextLabel}` : 'Close translation controls'}
+            className="text-xs text-gray-500 hover:text-gray-800 px-1.5 py-0.5 min-h-6 min-w-6 rounded cursor-pointer"
+          >
+            Close
+          </button>
+        )}
+      </div>
+
+      <div className="flex flex-wrap items-center gap-2">
+        <div className="flex items-center gap-1.5">
+          <label htmlFor={sourceSelectId} className="text-gray-600 font-medium whitespace-nowrap">
+            From
+          </label>
+          <select
+            id={sourceSelectId}
+            value={sourceLanguage}
+            onChange={(e) => setSourceLanguage(e.target.value)}
+            disabled={isBusy || isSupported === false}
+            className="rounded border border-gray-300 bg-white px-2 py-1 min-h-6 text-gray-800 focus:outline-2 focus:outline-amber-600 disabled:opacity-60"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.label}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        <button
+          type="button"
+          onClick={handleSwapLanguages}
+          disabled={isBusy || isSupported === false}
+          aria-label="Swap source and target languages"
+          className="inline-flex items-center justify-center p-1 min-h-6 min-w-6 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 disabled:opacity-50 cursor-pointer"
+        >
+          <ArrowsRightLeftIcon className="w-3.5 h-3.5" aria-hidden="true" />
+        </button>
+
+        <div className="flex items-center gap-1.5">
+          <label htmlFor={targetSelectId} className="text-gray-600 font-medium whitespace-nowrap">
+            To
+          </label>
+          <select
+            id={targetSelectId}
+            value={targetLanguage}
+            onChange={(e) => setTargetLanguage(e.target.value)}
+            disabled={isBusy || isSupported === false}
+            className="rounded border border-gray-300 bg-white px-2 py-1 min-h-6 text-gray-800 focus:outline-2 focus:outline-amber-600 disabled:opacity-60"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.label}
+              </option>
+            ))}
+          </select>
+        </div>
+
+        {hasLanguageDetector && !compact && (
+          <button
+            type="button"
+            onClick={handleDetectSourceLanguage}
+            disabled={isBusy}
+            className="inline-flex items-center gap-1 px-2.5 py-1 min-h-6 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 font-medium disabled:opacity-50 cursor-pointer"
+          >
+            <span>Auto-detect</span>
+          </button>
+        )}
+
+        <div className="flex items-center gap-1.5 ml-auto">
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={!canTranslate}
+            className="inline-flex items-center gap-1.5 px-3 py-1 min-h-6 rounded bg-gray-900 text-white font-semibold hover:bg-amber-700 disabled:bg-gray-300 disabled:text-gray-600 disabled:cursor-not-allowed transition-colors cursor-pointer"
+          >
+            {isBusy && <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" aria-hidden="true" />}
+            <span>
+              {status === 'downloading'
+                ? 'Downloading...'
+                : status === 'translating'
+                  ? 'Translating...'
+                  : 'Translate'}
+            </span>
+          </button>
+
+          {activeTranslatedLang && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              className="inline-flex items-center gap-1 px-2.5 py-1 min-h-6 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 font-medium cursor-pointer"
+            >
+              <span>Restore original</span>
+            </button>
+          )}
+        </div>
+      </div>
+
+      {isBusy && (
+        <div className="space-y-1">
+          <label htmlFor={progressId} className="block text-xs text-gray-600">
+            {statusMessage || 'Processing translation...'}
+          </label>
+          <progress
+            id={progressId}
+            className="translator-progress w-full h-2 block"
+            max={100}
+            value={downloadProgress !== null ? downloadProgress : undefined}
+          />
+        </div>
+      )}
+
+      <div id={statusId} role="status" aria-live="polite" className="text-xs text-gray-600">
+        {isSupported === false ? (
+          <span className="text-amber-800">
+            Client-side translation is currently unsupported in this browser (requires Chrome 138+ or Edge 148+ with Built-in AI Translator API).
+          </span>
+        ) : sourceLanguage === targetLanguage ? (
+          <span className="text-amber-800">
+            Select two different languages to translate.
+          </span>
+        ) : availability === 'unavailable' ? (
+          <span className="text-amber-800">
+            This language pair ({sourceLanguage.toUpperCase()} → {targetLanguage.toUpperCase()}) is unavailable for on-device translation on this device.
+          </span>
+        ) : !isBusy && statusMessage ? (
+          <span className={status === 'error' ? 'text-red-700 font-medium' : 'text-gray-700'}>
+            {statusMessage}
+          </span>
+        ) : null}
+      </div>
+    </div>
+  );
+}
