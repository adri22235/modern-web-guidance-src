new file mode 100644
index 0000000..e56de4d
--- /dev/null
+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,622 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  checkTranslationAvailability,
+  isNativeTranslatorSupported,
+  translateScopeElement,
+  restoreScopeElement,
+  getLanguageByCode,
+  type NormalizedAvailability,
+  type TranslationProgress,
+} from '../utils/translator';
+
+interface GlobalTranslateEventDetail {
+  sourceLanguage: string;
+  targetLanguage: string;
+  action: 'translate' | 'restore';
+}
+
+const GLOBAL_TRANSLATE_EVENT = 'devtools-times:global-translate';
+
+function LanguageIcon({ className = 'w-4 h-4' }: { className?: string }) {
+  return (
+    <svg
+      xmlns="http://www.w3.org/2000/svg"
+      fill="none"
+      viewBox="0 0 24 24"
+      strokeWidth={1.75}
+      stroke="currentColor"
+      className={className}
+      aria-hidden="true"
+    >
+      <path
+        strokeLinecap="round"
+        strokeLinejoin="round"
+        d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+      />
+    </svg>
+  );
+}
+
+/**
+ * Global Header Translation Control:
+ * Lets readers translate all articles and teasers on the current page between languages.
+ */
+export function HeaderTranslationControl() {
+  const [sourceLanguage, setSourceLanguage] = useState<string>('en');
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [isBusy, setIsBusy] = useState<boolean>(false);
+  const [availability, setAvailability] = useState<NormalizedAvailability>('available');
+  const [progress, setProgress] = useState<TranslationProgress | null>(null);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    let active = true;
+    checkTranslationAvailability(sourceLanguage, targetLanguage).then((status) => {
+      if (active) setAvailability(status);
+    });
+    return () => {
+      active = false;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  const handleTranslatePage = useCallback(
+    async (srcLang = sourceLanguage, tgtLang = targetLanguage) => {
+      if (typeof document === 'undefined') return;
+      abortControllerRef.current?.abort();
+      const controller = new AbortController();
+      abortControllerRef.current = controller;
+
+      setIsBusy(true);
+      try {
+        const mainScope = document.querySelector('main') || document.body;
+        await translateScopeElement(mainScope as HTMLElement, srcLang, tgtLang, {
+          signal: controller.signal,
+          onProgress: (p) => setProgress(p),
+        });
+        setIsTranslated(true);
+        window.dispatchEvent(
+          new CustomEvent<GlobalTranslateEventDetail>(GLOBAL_TRANSLATE_EVENT, {
+            detail: {
+              sourceLanguage: srcLang,
+              targetLanguage: tgtLang,
+              action: 'translate',
+            },
+          })
+        );
+      } catch (err: any) {
+        if (err?.name !== 'AbortError') {
+          console.error('Page translation error:', err);
+          setProgress({
+            phase: 'error',
+            message: 'Translation failed',
+          });
+        }
+      } finally {
+        setIsBusy(false);
+      }
+    },
+    [sourceLanguage, targetLanguage]
+  );
+
+  const handleRestorePage = useCallback(() => {
+    if (typeof document === 'undefined') return;
+    abortControllerRef.current?.abort();
+    const mainScope = document.querySelector('main') || document.body;
+    restoreScopeElement(mainScope as HTMLElement);
+    setIsTranslated(false);
+    setProgress(null);
+    window.dispatchEvent(
+      new CustomEvent<GlobalTranslateEventDetail>(GLOBAL_TRANSLATE_EVENT, {
+        detail: {
+          sourceLanguage,
+          targetLanguage,
+          action: 'restore',
+        },
+      })
+    );
+  }, [sourceLanguage, targetLanguage]);
+
+  const handleSwapLanguages = () => {
+    if (sourceLanguage === 'auto') return;
+    const nextSource = targetLanguage;
+    const nextTarget = sourceLanguage;
+    setSourceLanguage(nextSource);
+    setTargetLanguage(nextTarget);
+    if (isTranslated) {
+      handleTranslatePage(nextSource, nextTarget);
+    }
+  };
+
+  return (
+    <div
+      className="inline-flex flex-wrap items-center gap-1.5 bg-gray-50 border border-gray-200 rounded-md px-2 py-1 text-xs text-gray-700"
+      data-no-translate="true"
+      role="region"
+      aria-label="On-device page translator"
+    >
+      <span className="inline-flex items-center gap-1 font-semibold text-gray-800 mr-0.5" title="On-device browser translation">
+        <LanguageIcon className="w-4 h-4 text-amber-600" />
+        <span className="hidden sm:inline">Translate:</span>
+      </span>
+
+      <label className="sr-only" htmlFor="header-translate-source">
+        Source Language
+      </label>
+      <select
+        id="header-translate-source"
+        aria-label="Source language"
+        value={sourceLanguage}
+        onChange={(e) => setSourceLanguage(e.target.value)}
+        disabled={isBusy}
+        className="bg-white border border-gray-300 rounded px-1.5 py-0.5 text-xs text-gray-800 focus:outline-none focus:ring-1 focus:ring-amber-500"
+      >
+        <option value="auto">Auto-detect</option>
+        {SUPPORTED_LANGUAGES.map((lang) => (
+          <option key={`src-${lang.code}`} value={lang.code}>
+            {lang.name}
+          </option>
+        ))}
+      </select>
+
+      <button
+        type="button"
+        onClick={handleSwapLanguages}
+        disabled={isBusy || sourceLanguage === 'auto'}
+        title="Swap source and target languages"
+        aria-label="Swap languages"
+        className="px-1 py-0.5 text-gray-500 hover:text-amber-600 disabled:opacity-40 cursor-pointer"
+      >
+        ⇄
+      </button>
+
+      <label className="sr-only" htmlFor="header-translate-target">
+        Target Language
+      </label>
+      <select
+        id="header-translate-target"
+        aria-label="Target language"
+        value={targetLanguage}
+        onChange={(e) => {
+          const nextTarget = e.target.value;
+          setTargetLanguage(nextTarget);
+          if (isTranslated) {
+            handleTranslatePage(sourceLanguage, nextTarget);
+          }
+        }}
+        disabled={isBusy}
+        className="bg-white border border-gray-300 rounded px-1.5 py-0.5 text-xs text-gray-800 focus:outline-none focus:ring-1 focus:ring-amber-500"
+      >
+        {SUPPORTED_LANGUAGES.map((lang) => (
+          <option key={`tgt-${lang.code}`} value={lang.code}>
+            {lang.name} ({lang.nativeName})
+          </option>
+        ))}
+      </select>
+
+      <button
+        type="button"
+        onClick={() => handleTranslatePage(sourceLanguage, targetLanguage)}
+        disabled={isBusy || (sourceLanguage !== 'auto' && sourceLanguage === targetLanguage)}
+        className="bg-amber-500 hover:bg-amber-600 disabled:bg-gray-300 text-white font-semibold px-2.5 py-0.5 rounded transition-colors cursor-pointer whitespace-nowrap"
+      >
+        {isBusy
+          ? progress?.phase === 'downloading'
+            ? `Model ${progress.downloadPercent ?? 0}%`
+            : 'Translating...'
+          : isTranslated
+          ? 'Re-translate'
+          : 'Translate'}
+      </button>
+
+      {isTranslated && (
+        <button
+          type="button"
+          onClick={handleRestorePage}
+          disabled={isBusy}
+          className="bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 font-medium px-2 py-0.5 rounded transition-colors cursor-pointer whitespace-nowrap"
+        >
+          Original
+        </button>
+      )}
+
+      {availability === 'downloadable' && !isTranslated && !isBusy && (
+        <span
+          className="hidden lg:inline-block text-[10px] text-amber-700 bg-amber-50 border border-amber-200 px-1.5 py-0.2 rounded"
+          title="Language model will be downloaded on-device when translating"
+        >
+          Model download on use
+        </span>
+      )}
+    </div>
+  );
+}
+
+/**
+ * Full Article On-Device Translation Control Bar:
+ * Displayed on article pages (`src/pages/articles/[slug].astro`) to translate the article
+ * headline, summary, captions, and body paragraphs on-device.
+ */
+export function ArticleTranslationBar({
+  defaultSourceLanguage = 'en',
+}: {
+  defaultSourceLanguage?: string;
+}) {
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [isBusy, setIsBusy] = useState<boolean>(false);
+  const [availability, setAvailability] = useState<NormalizedAvailability>('available');
+  const [nativeSupported, setNativeSupported] = useState<boolean>(true);
+  const [progress, setProgress] = useState<TranslationProgress | null>(null);
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    setNativeSupported(isNativeTranslatorSupported());
+  }, []);
+
+  useEffect(() => {
+    let active = true;
+    checkTranslationAvailability(sourceLanguage, targetLanguage).then((status) => {
+      if (active) setAvailability(status);
+    });
+    return () => {
+      active = false;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  const getArticleScope = (): HTMLElement | null => {
+    if (!containerRef.current) return null;
+    return (
+      containerRef.current.closest<HTMLElement>('[data-translatable-scope="article"]') ||
+      containerRef.current.closest<HTMLElement>('article') ||
+      document.querySelector<HTMLElement>('article')
+    );
+  };
+
+  const handleTranslateArticle = useCallback(
+    async (srcLang = sourceLanguage, tgtLang = targetLanguage) => {
+      const scopeEl = getArticleScope();
+      if (!scopeEl) return;
+
+      abortControllerRef.current?.abort();
+      const controller = new AbortController();
+      abortControllerRef.current = controller;
+
+      setIsBusy(true);
+      try {
+        const result = await translateScopeElement(scopeEl, srcLang, tgtLang, {
+          signal: controller.signal,
+          onProgress: (p) => setProgress(p),
+        });
+        setIsTranslated(true);
+        if (srcLang === 'auto' && result.detectedSourceLanguage) {
+          // Keep 'auto' selected or show detected source language in status
+        }
+      } catch (err: any) {
+        if (err?.name !== 'AbortError') {
+          console.error('Article translation error:', err);
+          setProgress({
+            phase: 'error',
+            message: 'Could not translate article.',
+          });
+        }
+      } finally {
+        setIsBusy(false);
+      }
+    },
+    [sourceLanguage, targetLanguage]
+  );
+
+  const handleRestoreArticle = useCallback(() => {
+    const scopeEl = getArticleScope();
+    if (!scopeEl) return;
+    abortControllerRef.current?.abort();
+    restoreScopeElement(scopeEl);
+    setIsTranslated(false);
+    setProgress(null);
+  }, []);
+
+  const handleSwapLanguages = () => {
+    if (sourceLanguage === 'auto') return;
+    const nextSource = targetLanguage;
+    const nextTarget = sourceLanguage;
+    setSourceLanguage(nextSource);
+    setTargetLanguage(nextTarget);
+    if (isTranslated) {
+      handleTranslateArticle(nextSource, nextTarget);
+    }
+  };
+
+  useEffect(() => {
+    const onGlobalEvent = (e: Event) => {
+      const detail = (e as CustomEvent<GlobalTranslateEventDetail>).detail;
+      if (!detail) return;
+      if (detail.action === 'translate') {
+        setSourceLanguage(detail.sourceLanguage);
+        setTargetLanguage(detail.targetLanguage);
+        setIsTranslated(true);
+      } else if (detail.action === 'restore') {
+        setIsTranslated(false);
+        setProgress(null);
+      }
+    };
+    window.addEventListener(GLOBAL_TRANSLATE_EVENT, onGlobalEvent);
+    return () => window.removeEventListener(GLOBAL_TRANSLATE_EVENT, onGlobalEvent);
+  }, []);
+
+  const targetLangObj = getLanguageByCode(targetLanguage);
+
+  return (
+    <div
+      ref={containerRef}
+      data-no-translate="true"
+      className="my-4 p-3.5 bg-gray-50 border border-gray-200 rounded-lg shadow-xs"
+      role="region"
+      aria-label="On-device article translation controls"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Left: Title & On-Device Status Badge */}
+        <div className="flex items-center gap-2">
+          <span className="inline-flex items-center justify-center w-7 h-7 rounded-full bg-amber-100 text-amber-800">
+            <LanguageIcon className="w-4 h-4" />
+          </span>
+          <div>
+            <div className="flex items-center gap-2">
+              <span className="text-sm font-semibold text-gray-900">
+                On-Device Article Translation
+              </span>
+              <span
+                className={`text-[11px] font-medium px-2 py-0.5 rounded-full ${
+                  nativeSupported && availability === 'available'
+                    ? 'bg-green-100 text-green-800'
+                    : nativeSupported && availability === 'downloadable'
+                    ? 'bg-amber-100 text-amber-800'
+                    : 'bg-gray-200 text-gray-700'
+                }`}
+              >
+                {nativeSupported && availability === 'available'
+                  ? 'Browser AI Ready'
+                  : nativeSupported && availability === 'downloadable'
+                  ? 'Model Downloadable'
+                  : nativeSupported
+                  ? 'On-Device API'
+                  : 'On-Device Fallback Ready'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Translate this article directly in your browser without sending text to external servers.
+            </p>
+          </div>
+        </div>
+
+        {/* Right: Language Selectors & Action Buttons */}
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="flex items-center gap-1.5">
+            <label htmlFor="article-source-lang" className="text-xs font-medium text-gray-600">
+              From
+            </label>
+            <select
+              id="article-source-lang"
+              aria-label="Source language"
+              value={sourceLanguage}
+              onChange={(e) => setSourceLanguage(e.target.value)}
+              disabled={isBusy}
+              className="bg-white border border-gray-300 rounded-md px-2 py-1 text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400"
+            >
+              <option value="auto">Auto-detect</option>
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`art-src-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={isBusy || sourceLanguage === 'auto'}
+            title="Swap languages"
+            aria-label="Swap source and target languages"
+            className="p-1 text-gray-500 hover:text-amber-600 hover:bg-gray-100 rounded disabled:opacity-40 cursor-pointer"
+          >
+            ⇄
+          </button>
+
+          <div className="flex items-center gap-1.5">
+            <label htmlFor="article-target-lang" className="text-xs font-medium text-gray-600">
+              To
+            </label>
+            <select
+              id="article-target-lang"
+              aria-label="Target language"
+              value={targetLanguage}
+              onChange={(e) => {
+                const nextTarget = e.target.value;
+                setTargetLanguage(nextTarget);
+                if (isTranslated) {
+                  handleTranslateArticle(sourceLanguage, nextTarget);
+                }
+              }}
+              disabled={isBusy}
+              className="bg-white border border-gray-300 rounded-md px-2 py-1 text-xs font-medium text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`art-tgt-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <button
+            type="button"
+            onClick={() => handleTranslateArticle(sourceLanguage, targetLanguage)}
+            disabled={isBusy || (sourceLanguage !== 'auto' && sourceLanguage === targetLanguage)}
+            className="bg-gray-900 hover:bg-amber-500 hover:text-gray-950 disabled:bg-gray-300 text-white text-xs font-semibold px-3 py-1.5 rounded-md transition-colors cursor-pointer"
+          >
+            {isBusy
+              ? 'Translating...'
+              : isTranslated
+              ? `Translate to ${targetLangObj?.name || targetLanguage.toUpperCase()}`
+              : 'Translate Article'}
+          </button>
+
+          {isTranslated && (
+            <button
+              type="button"
+              onClick={handleRestoreArticle}
+              disabled={isBusy}
+              className="bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 text-xs font-semibold px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress / Status feedback bar */}
+      {(isBusy || (isTranslated && progress)) && (
+        <div className="mt-2.5 pt-2 border-t border-gray-200 flex items-center justify-between text-xs text-gray-600">
+          <span>{progress?.message}</span>
+          {isBusy && progress?.totalBlocks && progress.totalBlocks > 0 && (
+            <div className="w-36 bg-gray-200 rounded-full h-1.5 overflow-hidden">
+              <div
+                className="bg-amber-500 h-full transition-all duration-150"
+                style={{
+                  width: `${Math.round(
+                    ((progress.completedBlocks || 0) / progress.totalBlocks) * 100
+                  )}%`,
+                }}
+              />
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
+
+/**
+ * Compact inline translation control for Article Teasers (`ArticleTeaser.astro`, `TopStoryTeaserGrid.astro`, etc.)
+ */
+export function TeaserTranslateControl({
+  defaultSourceLanguage = 'en',
+}: {
+  defaultSourceLanguage?: string;
+}) {
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [isBusy, setIsBusy] = useState<boolean>(false);
+  const containerRef = useRef<HTMLDivElement | null>(null);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const getTeaserScope = (): HTMLElement | null => {
+    if (!containerRef.current) return null;
+    return (
+      containerRef.current.closest<HTMLElement>('[data-translatable-scope]') ||
+      containerRef.current.closest<HTMLElement>('article') ||
+      containerRef.current.parentElement
+    );
+  };
+
+  const handleTranslateTeaser = async (nextTarget = targetLanguage) => {
+    const scopeEl = getTeaserScope();
+    if (!scopeEl) return;
+
+    abortControllerRef.current?.abort();
+    const controller = new AbortController();
+    abortControllerRef.current = controller;
+
+    setIsBusy(true);
+    try {
+      await translateScopeElement(scopeEl, defaultSourceLanguage, nextTarget, {
+        signal: controller.signal,
+      });
+      setIsTranslated(true);
+    } catch (err: any) {
+      if (err?.name !== 'AbortError') {
+        console.error('Teaser translation error:', err);
+      }
+    } finally {
+      setIsBusy(false);
+    }
+  };
+
+  const handleRestoreTeaser = () => {
+    const scopeEl = getTeaserScope();
+    if (!scopeEl) return;
+    abortControllerRef.current?.abort();
+    restoreScopeElement(scopeEl);
+    setIsTranslated(false);
+  };
+
+  useEffect(() => {
+    const onGlobalEvent = (e: Event) => {
+      const detail = (e as CustomEvent<GlobalTranslateEventDetail>).detail;
+      if (!detail) return;
+      if (detail.action === 'translate') {
+        setTargetLanguage(detail.targetLanguage);
+        setIsTranslated(true);
+      } else if (detail.action === 'restore') {
+        setIsTranslated(false);
+      }
+    };
+    window.addEventListener(GLOBAL_TRANSLATE_EVENT, onGlobalEvent);
+    return () => window.removeEventListener(GLOBAL_TRANSLATE_EVENT, onGlobalEvent);
+  }, []);
+
+  return (
+    <div
+      ref={containerRef}
+      data-no-translate="true"
+      className="inline-flex items-center gap-1 text-xs"
+      onClick={(e) => e.stopPropagation()}
+    >
+      <LanguageIcon className="w-3.5 h-3.5 text-gray-400" />
+      <select
+        aria-label="Translate teaser to language"
+        value={targetLanguage}
+        onChange={(e) => {
+          const lang = e.target.value;
+          setTargetLanguage(lang);
+          handleTranslateTeaser(lang);
+        }}
+        disabled={isBusy}
+        className="bg-transparent border border-gray-200 hover:border-gray-300 rounded px-1 py-0.5 text-[11px] text-gray-600 focus:outline-none focus:ring-1 focus:ring-amber-400 cursor-pointer"
+      >
+        {SUPPORTED_LANGUAGES.map((lang) => (
+          <option key={`teaser-${lang.code}`} value={lang.code}>
+            {lang.code.toUpperCase()} - {lang.name}
+          </option>
+        ))}
+      </select>
+      {!isTranslated ? (
+        <button
+          type="button"
+          onClick={() => handleTranslateTeaser(targetLanguage)}
+          disabled={isBusy}
+          title="Translate teaser on-device"
+          className="text-[11px] font-medium text-amber-700 hover:text-amber-500 px-1.5 py-0.5 rounded bg-amber-50 hover:bg-amber-100 transition-colors cursor-pointer"
+        >
+          {isBusy ? '...' : 'Translate'}
+        </button>
+      ) : (
+        <button
+          type="button"
+          onClick={handleRestoreTeaser}
+          disabled={isBusy}
+          title="Restore original language"
+          className="text-[11px] font-medium text-gray-600 hover:text-gray-900 px-1.5 py-0.5 rounded bg-gray-100 hover:bg-gray-200 transition-colors cursor-pointer"
+        >
+          Original
+        </button>
+      )}
+    </div>
+  );
+}
+
+export default ArticleTranslationBar;
