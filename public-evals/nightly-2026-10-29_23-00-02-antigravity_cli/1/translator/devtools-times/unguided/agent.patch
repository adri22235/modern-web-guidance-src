@@ -0,0 +1,799 @@
+export interface LanguageOption {
+  code: string;
+  name: string;
+  nativeName: string;
+  dir?: 'ltr' | 'rtl';
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', name: 'English', nativeName: 'English' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español' },
+  { code: 'fr', name: 'French', nativeName: 'Français' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano' },
+  { code: 'zh', name: 'Chinese (Simplified)', nativeName: '中文 (简体)' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية', dir: 'rtl' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands' },
+];
+
+export type NormalizedAvailability =
+  | 'available'
+  | 'downloadable'
+  | 'downloading'
+  | 'unavailable'
+  | 'unsupported';
+
+export interface TranslationProgress {
+  phase: 'detecting' | 'downloading' | 'translating' | 'ready' | 'error';
+  downloadPercent?: number;
+  completedBlocks?: number;
+  totalBlocks?: number;
+  engine?: 'web-translator-api' | 'fallback';
+  message?: string;
+}
+
+const originalTextNodes = new WeakMap<Text, string>();
+const originalElementAttrs = new WeakMap<
+  HTMLElement,
+  { lang: string | null; dir: string | null }
+>();
+const translatorCache = new Map<string, TranslatorInstance>();
+
+export function getLanguageByCode(code: string): LanguageOption | undefined {
+  const baseCode = code.toLowerCase().split('-')[0];
+  return SUPPORTED_LANGUAGES.find((lang) => lang.code === baseCode);
+}
+
+export function getLanguageLabel(code: string): string {
+  const lang = getLanguageByCode(code);
+  return lang ? `${lang.name} (${lang.nativeName})` : code.toUpperCase();
+}
+
+function normalizeStatus(status: string | undefined | null): NormalizedAvailability {
+  if (!status) return 'unavailable';
+  switch (status) {
+    case 'available':
+    case 'readily':
+      return 'available';
+    case 'downloadable':
+    case 'after-download':
+      return 'downloadable';
+    case 'downloading':
+      return 'downloading';
+    case 'no':
+    case 'unavailable':
+      return 'unavailable';
+    default:
+      return 'unavailable';
+  }
+}
+
+export function isNativeTranslatorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    ('Translator' in window && window.Translator) ||
+      (window.ai && window.ai.translator) ||
+      (window.translation && window.translation.createTranslator)
+  );
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    ('LanguageDetector' in window && window.LanguageDetector) ||
+      (window.ai && window.ai.languageDetector)
+  );
+}
+
+export async function checkTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<NormalizedAvailability> {
+  if (typeof window === 'undefined') return 'unsupported';
+  const src = sourceLanguage === 'auto' ? 'en' : sourceLanguage;
+  if (src === targetLanguage) return 'available';
+
+  try {
+    if ('Translator' in window && window.Translator?.availability) {
+      const status = await window.Translator.availability({
+        sourceLanguage: src,
+        targetLanguage,
+      });
+      return normalizeStatus(status);
+    }
+
+    if (window.ai?.translator) {
+      if (typeof window.ai.translator.availability === 'function') {
+        const status = await window.ai.translator.availability({
+          sourceLanguage: src,
+          targetLanguage,
+        });
+        return normalizeStatus(status);
+      }
+      if (typeof window.ai.translator.capabilities === 'function') {
+        const caps = await window.ai.translator.capabilities();
+        if (typeof caps.languagePairAvailable === 'function') {
+          return normalizeStatus(caps.languagePairAvailable(src, targetLanguage));
+        }
+        return normalizeStatus(caps.available);
+      }
+      return 'available';
+    }
+
+    if (window.translation?.canTranslate) {
+      const status = await window.translation.canTranslate({
+        sourceLanguage: src,
+        targetLanguage,
+      });
+      return normalizeStatus(status);
+    }
+  } catch (err) {
+    console.warn('Error checking Translator availability:', err);
+    return 'unavailable';
+  }
+
+  return 'unsupported';
+}
+
+export async function detectSourceLanguage(
+  sampleText: string,
+  fallbackLanguage = 'en'
+): Promise<string> {
+  const cleaned = sampleText.trim().slice(0, 600);
+  if (!cleaned || typeof window === 'undefined') return fallbackLanguage;
+
+  try {
+    if ('LanguageDetector' in window && window.LanguageDetector?.create) {
+      const detector = await window.LanguageDetector.create();
+      const results = await detector.detect(cleaned);
+      detector.destroy?.();
+      if (results && results.length > 0 && results[0].detectedLanguage) {
+        const top = results[0];
+        if (top.confidence >= 0.35 && top.detectedLanguage !== 'und') {
+          return top.detectedLanguage.split('-')[0];
+        }
+      }
+    } else if (window.ai?.languageDetector?.create) {
+      const detector = await window.ai.languageDetector.create();
+      const results = await detector.detect(cleaned);
+      detector.destroy?.();
+      if (results && results.length > 0 && results[0].detectedLanguage) {
+        const top = results[0];
+        if (top.confidence >= 0.35 && top.detectedLanguage !== 'und') {
+          return top.detectedLanguage.split('-')[0];
+        }
+      }
+    }
+  } catch (err) {
+    console.warn('LanguageDetector fallback to default:', err);
+  }
+
+  return fallbackLanguage;
+}
+
+async function getOrCreateNativeTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onDownloadProgress?: (percent: number) => void,
+  signal?: AbortSignal
+): Promise<TranslatorInstance | null> {
+  const cacheKey = `${sourceLanguage}->${targetLanguage}`;
+  if (translatorCache.has(cacheKey)) {
+    return translatorCache.get(cacheKey)!;
+  }
+
+  const monitor = (m: TranslatorCreateMonitor) => {
+    m.addEventListener('downloadprogress', (e: TranslatorProgressEvent) => {
+      if (!onDownloadProgress) return;
+      let percent = 0;
+      if (typeof e.loaded === 'number') {
+        if (e.total && e.total > 1) {
+          percent = Math.round((e.loaded / e.total) * 100);
+        } else if (e.loaded <= 1) {
+          percent = Math.round(e.loaded * 100);
+        } else {
+          percent = Math.min(100, Math.round(e.loaded));
+        }
+      }
+      onDownloadProgress(Math.max(0, Math.min(100, percent)));
+    });
+  };
+
+  const options: TranslatorCreateOptions = {
+    sourceLanguage,
+    targetLanguage,
+    signal,
+    monitor,
+  };
+
+  if ('Translator' in window && window.Translator?.create) {
+    const instance = await window.Translator.create(options);
+    translatorCache.set(cacheKey, instance);
+    return instance;
+  }
+
+  if (window.ai?.translator?.create) {
+    const instance = await window.ai.translator.create(options);
+    translatorCache.set(cacheKey, instance);
+    return instance;
+  }
+
+  if (window.translation?.createTranslator) {
+    const instance = await window.translation.createTranslator(options);
+    translatorCache.set(cacheKey, instance);
+    return instance;
+  }
+
+  return null;
+}
+
