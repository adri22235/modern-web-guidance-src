+function fallbackTranslateText(
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string
+): string {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) return text;
+
+  const dict = FALLBACK_DICTIONARIES[targetLanguage];
+  if (dict) {
+    const lower = trimmed.toLowerCase();
+    if (dict[lower]) {
+      return text.replace(trimmed, dict[lower]);
+    }
+
+    const translatedWords = trimmed.replace(/\b([A-Za-z']+)\b/g, (word) => {
+      const lookup = dict[word.toLowerCase()];
+      if (!lookup) return word;
+      if (word[0] === word[0].toUpperCase() && word[0] !== word[0].toLowerCase()) {
+        return lookup.charAt(0).toUpperCase() + lookup.slice(1);
+      }
+      return lookup;
+    });
+
+    if (translatedWords !== trimmed) {
+      return text.replace(trimmed, translatedWords);
+    }
+  }
+
+  return `[${targetLanguage.toUpperCase()}] ${text}`;
+}
+
+export async function translateText(
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string,
+  options?: {
+    onDownloadProgress?: (percent: number) => void;
+    signal?: AbortSignal;
+  }
+): Promise<{ translated: string; engine: 'web-translator-api' | 'fallback' }> {
+  if (!text.trim()) {
+    return { translated: text, engine: 'web-translator-api' };
+  }
+
+  const resolvedSource =
+    sourceLanguage === 'auto'
+      ? await detectSourceLanguage(text, 'en')
+      : sourceLanguage;
+
+  if (resolvedSource === targetLanguage) {
+    return { translated: text, engine: 'web-translator-api' };
+  }
+
+  // Always try the standard Browser Built-in AI Translator API first
+  if (isNativeTranslatorSupported()) {
+    try {
+      const translator = await getOrCreateNativeTranslator(
+        resolvedSource,
+        targetLanguage,
+        options?.onDownloadProgress,
+        options?.signal
+      );
+      if (translator) {
+        // Preserve leading/trailing whitespace around text node
+        const leadingMatch = text.match(/^\s*/);
+        const trailingMatch = text.match(/\s*$/);
+        const leading = leadingMatch ? leadingMatch[0] : '';
+        const trailing = trailingMatch ? trailingMatch[0] : '';
+        const core = text.trim();
+
+        const result = await translator.translate(core, {
+          signal: options?.signal,
+        });
+        return {
+          translated: `${leading}${result}${trailing}`,
+          engine: 'web-translator-api',
+        };
+      }
+    } catch (err: any) {
+      if (err?.name === 'AbortError') {
+        throw err;
+      }
+      console.warn('Native Web Translator API failed, using on-device fallback:', err);
+    }
+  }
+
+  return {
+    translated: fallbackTranslateText(text, resolvedSource, targetLanguage),
+    engine: 'fallback',
+  };
+}
+
+/**
+ * Collects all translatable HTML elements within a given scope element (or document).
+ */
+export function collectTranslatableElements(root: ParentNode = document): HTMLElement[] {
+  const elements = new Set<HTMLElement>();
+
+  // 1. Explicitly tagged elements (titles, summaries, categories, captions)
+  root.querySelectorAll<HTMLElement>('[data-translatable]').forEach((el) => {
+    elements.add(el);
+  });
+
+  // 2. Article prose body elements
+  root
+    .querySelectorAll<HTMLElement>(
+      '[data-translatable-body] p, [data-translatable-body] h1, [data-translatable-body] h2, [data-translatable-body] h3, [data-translatable-body] h4, [data-translatable-body] h5, [data-translatable-body] h6, [data-translatable-body] li, [data-translatable-body] blockquote, [data-translatable-body] figcaption'
+    )
+    .forEach((el) => {
+      elements.add(el);
+    });
+
+  return Array.from(elements);
+}
+
+/**
+ * Collects non-empty Text nodes inside an element (skipping script/style/code/svg).
+ */
+function collectTextNodes(el: HTMLElement): Text[] {
+  const textNodes: Text[] = [];
+  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      const tag = parent.tagName.toLowerCase();
+      if (
+        tag === 'script' ||
+        tag === 'style' ||
+        tag === 'code' ||
+        tag === 'pre' ||
+        tag === 'svg' ||
+        parent.closest('[data-no-translate]')
+      ) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      if (!node.nodeValue || !node.nodeValue.trim()) {
+        return NodeFilter.FILTER_SKIP;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+
+  let current = walker.nextNode();
+  while (current) {
+    textNodes.push(current as Text);
+    current = walker.nextNode();
+  }
+  return textNodes;
+}
+
+/**
+ * Translates all translatable content inside `scopeEl` (or the whole page).
+ */
+export async function translateScopeElement(
+  scopeEl: HTMLElement,
+  sourceLanguage: string,
+  targetLanguage: string,
+  options?: {
+    onProgress?: (progress: TranslationProgress) => void;
+    signal?: AbortSignal;
+  }
+): Promise<{ engine: 'web-translator-api' | 'fallback'; detectedSourceLanguage: string }> {
+  const elements = collectTranslatableElements(scopeEl);
+  if (elements.length === 0) {
+    return { engine: 'web-translator-api', detectedSourceLanguage: 'en' };
+  }
+
+  // First restore original text so we always translate from clean source text
+  restoreScopeElement(scopeEl);
+
+  // Collect all text nodes across the translatable elements
+  const allTextNodes: Text[] = [];
+  for (const el of elements) {
+    const nodes = collectTextNodes(el);
+    for (const node of nodes) {
+      if (!originalTextNodes.has(node)) {
+        originalTextNodes.set(node, node.nodeValue || '');
+      }
+      allTextNodes.push(node);
+    }
+  }
+
+  if (allTextNodes.length === 0) {
+    return { engine: 'web-translator-api', detectedSourceLanguage: 'en' };
+  }
+
+  // Determine source language if 'auto'
+  let resolvedSource = sourceLanguage;
+  if (sourceLanguage === 'auto') {
+    options?.onProgress?.({
+      phase: 'detecting',
+      message: 'Detecting article language...',
+    });
+    const sample = allTextNodes
+      .slice(0, 4)
+      .map((n) => originalTextNodes.get(n) || n.nodeValue || '')
+      .join(' ');
+    resolvedSource = await detectSourceLanguage(sample, 'en');
+  }
+
+  if (resolvedSource === targetLanguage) {
+    return { engine: 'web-translator-api', detectedSourceLanguage: resolvedSource };
+  }
+
+  let usedEngine: 'web-translator-api' | 'fallback' = 'web-translator-api';
+  const totalBlocks = allTextNodes.length;
+
+  options?.onProgress?.({
+    phase: 'translating',
+    completedBlocks: 0,
+    totalBlocks,
+    message: `Translating (0/${totalBlocks})...`,
+  });
+
+  // Save original lang/dir attributes on scopeEl
+  if (!originalElementAttrs.has(scopeEl)) {
+    originalElementAttrs.set(scopeEl, {
+      lang: scopeEl.getAttribute('lang'),
+      dir: scopeEl.getAttribute('dir'),
+    });
+  }
+
+  for (let i = 0; i < allTextNodes.length; i++) {
+    if (options?.signal?.aborted) {
+      throw new DOMException('Translation aborted', 'AbortError');
+    }
+
+    const textNode = allTextNodes[i];
+    const sourceText = originalTextNodes.get(textNode) ?? textNode.nodeValue ?? '';
+
+    const { translated, engine } = await translateText(
+      sourceText,
+      resolvedSource,
+      targetLanguage,
+      {
+        signal: options?.signal,
+        onDownloadProgress: (percent) => {
+          options?.onProgress?.({
+            phase: 'downloading',
+            downloadPercent: percent,
+            completedBlocks: i,
+            totalBlocks,
+            message: `Downloading on-device language model (${percent}%)...`,
+          });
+        },
+      }
+    );
+
+    usedEngine = engine;
+    textNode.nodeValue = translated;
+
+    options?.onProgress?.({
+      phase: 'translating',
+      completedBlocks: i + 1,
+      totalBlocks,
+      engine: usedEngine,
+      message: `Translating (${i + 1}/${totalBlocks})...`,
+    });
+  }
+
+  const targetLangOption = getLanguageByCode(targetLanguage);
+  scopeEl.setAttribute('lang', targetLanguage);
+  scopeEl.setAttribute('dir', targetLangOption?.dir || 'ltr');
+  scopeEl.dataset.translatedLang = targetLanguage;
+  scopeEl.dataset.sourceLang = resolvedSource;
+
+  options?.onProgress?.({
+    phase: 'ready',
+    completedBlocks: totalBlocks,
+    totalBlocks,
+    engine: usedEngine,
+    message: `Translated to ${targetLangOption?.name || targetLanguage.toUpperCase()}`,
+  });
+
+  return { engine: usedEngine, detectedSourceLanguage: resolvedSource };
+}
+
+/**
+ * Restores all translated text nodes inside `scopeEl` back to their original text.
+ */
+export function restoreScopeElement(scopeEl: HTMLElement): void {
+  const elements = collectTranslatableElements(scopeEl);
+  for (const el of elements) {
+    const nodes = collectTextNodes(el);
+    for (const node of nodes) {
+      const original = originalTextNodes.get(node);
+      if (original !== undefined) {
+        node.nodeValue = original;
+      }
+    }
+  }
+
+  const origAttrs = originalElementAttrs.get(scopeEl);
+  if (origAttrs) {
+    if (origAttrs.lang) {
+      scopeEl.setAttribute('lang', origAttrs.lang);
+    } else {
+      scopeEl.removeAttribute('lang');
+    }
+    if (origAttrs.dir) {
+      scopeEl.setAttribute('dir', origAttrs.dir);
+    } else {
+      scopeEl.removeAttribute('dir');
+    }
+  }
+
+  delete scopeEl.dataset.translatedLang;
+}
