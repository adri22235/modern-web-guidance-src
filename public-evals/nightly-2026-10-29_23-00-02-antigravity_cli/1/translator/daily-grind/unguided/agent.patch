+  <script>
+    (function () {
+      const SOURCE_LANG = 'en';
+      const selectEl = document.getElementById('target-lang');
+      const translateBtn = document.getElementById('translate-btn');
+      const statusEl = document.getElementById('translator-status');
+      const badgeEl = document.getElementById('translator-badge');
+      const progressWrap = document.getElementById('download-progress-wrap');
+      const progressBar = document.getElementById('download-progress');
+      const progressLabel = document.getElementById('download-progress-label');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Cache original English strings and active translator instances
+      const translatorCache = new Map();
+      let currentLanguage = SOURCE_LANG;
+
+      translatableElements.forEach((el) => {
+        el.dataset.originalText = el.textContent.trim();
+      });
+
+      function getTranslatorNamespace() {
+        if ('Translator' in self && self.Translator) {
+          return self.Translator;
+        }
+        if (self.ai && self.ai.translator) {
+          return self.ai.translator;
+        }
+        return null;
+      }
+
+      function setStatus(message, state = '') {
+        statusEl.textContent = message;
+        badgeEl.className = 'status-badge' + (state ? ' ' + state : '');
+      }
+
+      function showProgress(percent) {
+        const clamped = Math.max(0, Math.min(100, Math.round(percent)));
+        progressWrap.classList.add('visible');
+        progressBar.value = clamped;
+        progressBar.textContent = clamped + '%';
+        progressLabel.textContent = `Downloading model: ${clamped}%`;
+      }
+
+      function hideProgress() {
+        progressWrap.classList.remove('visible');
+      }
+
+      async function getOrCreateTranslator(sourceLanguage, targetLanguage) {
+        const pairKey = `${sourceLanguage}->${targetLanguage}`;
+        if (translatorCache.has(pairKey)) {
+          return translatorCache.get(pairKey);
+        }
+
+        const TranslatorAPI = getTranslatorNamespace();
+        if (!TranslatorAPI || typeof TranslatorAPI.create !== 'function') {
+          throw new Error('The browser Built-in AI Translator API (window.Translator) is not available.');
+        }
+
+        const availability = typeof TranslatorAPI.availability === 'function'
+          ? await TranslatorAPI.availability({ sourceLanguage, targetLanguage })
+          : 'available';
+
+        if (availability === 'unavailable' || availability === 'no') {
+          setStatus(
+            `Translation from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} is unavailable on this device.`,
+            'unavailable'
+          );
+          throw new Error(`Language pair ${sourceLanguage} -> ${targetLanguage} is not supported on this device.`);
+        }
+
+        const needsDownload =
+          availability === 'downloadable' ||
+          availability === 'after-download' ||
+          availability === 'downloading';
+
+        if (needsDownload) {
+          setStatus(`Downloading ${targetLanguage.toUpperCase()} on-device translation model...`, 'downloading');
+          showProgress(0);
+        } else {
+          setStatus(`On-device model for ${targetLanguage.toUpperCase()} is ready.`, 'available');
+        }
+
+        const translator = await TranslatorAPI.create({
+          sourceLanguage,
+          targetLanguage,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const ratio = typeof e.loaded === 'number'
+                ? (e.total ? e.loaded / e.total : e.loaded)
+                : 0;
+              showProgress(ratio * 100);
+            });
+          }
+        });
+
+        hideProgress();
+        translatorCache.set(pairKey, translator);
+        return translator;
+      }
+
+      async function translatePageContent(targetLanguage) {
+        if (targetLanguage === SOURCE_LANG) {
+          translatableElements.forEach((el) => {
+            el.textContent = el.dataset.originalText;
+            el.setAttribute('lang', SOURCE_LANG);
+          });
+          document.documentElement.lang = SOURCE_LANG;
+          currentLanguage = SOURCE_LANG;
+          hideProgress();
+          setStatus('Restored original English text.', 'available');
+          return;
+        }
+
+        translateBtn.disabled = true;
+        selectEl.disabled = true;
+
+        try {
+          const translator = await getOrCreateTranslator(SOURCE_LANG, targetLanguage);
+          setStatus(`Translating menu descriptions and story to ${targetLanguage.toUpperCase()}...`, 'downloading');
+
+          for (const el of translatableElements) {
+            const sourceText = el.dataset.originalText;
+            if (!sourceText) continue;
+            const translated = await translator.translate(sourceText);
+            if (translated) {
+              el.textContent = translated;
+              el.setAttribute('lang', targetLanguage);
+            }
+          }
+
+          document.documentElement.lang = targetLanguage;
+          currentLanguage = targetLanguage;
+          setStatus(
+            `Translated coffee menu descriptions and story text into ${targetLanguage.toUpperCase()} on-device.`,
+            'available'
+          );
+        } catch (error) {
+          hideProgress();
+          setStatus(
+            error && error.message
+              ? error.message
+              : 'On-device translation failed. Ensure Chrome Built-in AI Translator API is enabled.',
+            'error'
+          );
+        } finally {
+          translateBtn.disabled = false;
+          selectEl.disabled = false;
+        }
+      }
+
+      selectEl.addEventListener('change', async () => {
+        await translatePageContent(selectEl.value);
+      });
+
+      translateBtn.addEventListener('click', async () => {
+        await translatePageContent(selectEl.value);
+      });
+
+      // Initial availability check on load
+      if (!getTranslatorNamespace()) {
+        setStatus(
+          'On-device Translator API (window.Translator) not detected in this browser.',
+          'unavailable'
+        );
+      } else {
+        setStatus('On-device Translator API ready. Choose a language to translate.', 'available');
+      }
+    })();
+  </script>
+
 </body>
 
