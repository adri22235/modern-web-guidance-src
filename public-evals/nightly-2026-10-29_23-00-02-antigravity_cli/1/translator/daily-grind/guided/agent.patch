+  <script type="module">
+    const form = document.getElementById('translation-form');
+    const languageSelect = document.getElementById('language-select');
+    const translateBtn = document.getElementById('start-translation-btn');
+    const statusEl = document.getElementById('translation-status');
+    const progressWrapper = document.getElementById('download-progress-wrapper');
+    const progressBar = document.getElementById('download-progress');
+    const progressLabel = document.getElementById('download-progress-label');
+    const translatableElements = Array.from(document.querySelectorAll('[data-translate]'));
+
+    const rtlLanguages = new Set(['ar', 'he']);
+    const translatorCache = new Map();
+
+    // Preserve original English copy and language metadata
+    for (const el of translatableElements) {
+      el.dataset.originalText = el.textContent.trim().replace(/\s+/g, ' ');
+    }
+
+    function setStatus(message, state = 'info') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    function showProgress(percent = null) {
+      progressWrapper.hidden = false;
+      if (typeof percent === 'number' && Number.isFinite(percent)) {
+        progressBar.value = percent;
+        progressLabel.textContent = `Downloading language model: ${percent}%`;
+      } else {
+        progressBar.removeAttribute('value');
+        progressLabel.textContent = 'Preparing on-device language model...';
+      }
+    }
+
+    function hideProgress() {
+      progressWrapper.hidden = true;
+      progressBar.removeAttribute('value');
+    }
+
+    function restoreOriginalText() {
+      for (const el of translatableElements) {
+        el.textContent = el.dataset.originalText;
+        el.removeAttribute('lang');
+        el.removeAttribute('dir');
+      }
+      hideProgress();
+      translateBtn.textContent = 'Translate';
+      setStatus('Showing original English text.', 'info');
+    }
+
+    async function applyTranslation(translator, targetLanguage) {
+      const isRtl = rtlLanguages.has(targetLanguage);
+
+      for (const el of translatableElements) {
+        const sourceText = el.dataset.originalText;
+        if (!sourceText) continue;
+
+        el.setAttribute('lang', targetLanguage);
+        el.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
+
+        if (typeof translator.translateStreaming === 'function' && sourceText.length > 140) {
+          const stream = translator.translateStreaming(sourceText);
+          let translated = '';
+          for await (const chunk of stream) {
+            translated += chunk;
+            el.textContent = translated;
+          }
+        } else {
+          const result = await translator.translate(sourceText);
+          el.textContent = result;
+        }
+      }
+    }
+
+    async function getOrCreateTranslator(options) {
+      const cacheKey = `${options.sourceLanguage}->${options.targetLanguage}`;
+      if (translatorCache.has(cacheKey)) {
+        return translatorCache.get(cacheKey);
+      }
+
+      const translator = await Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const percent = Math.round((e.loaded ?? 0) * 100);
+            showProgress(percent);
+          });
+        },
+      });
+
+      translatorCache.set(cacheKey, translator);
+      return translator;
+    }
+
+    async function handleLanguageRequest({ fromButtonClick = false } = {}) {
+      const targetLanguage = languageSelect.value;
+
+      if (targetLanguage === 'en') {
+        restoreOriginalText();
+        return;
+      }
+
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus(
+          'Client-side translation is currently unsupported in this browser.',
+          'unsupported'
+        );
+        return;
+      }
+
+      const options = {
+        sourceLanguage: 'en',
+        targetLanguage,
+      };
+
+      try {
+        translateBtn.disabled = true;
+        const availability = await Translator.availability(options);
+
+        if (availability === 'unavailable') {
+          hideProgress();
+          translateBtn.disabled = false;
+          setStatus(
+            `On-device translation for "${languageSelect.options[languageSelect.selectedIndex].text}" is unavailable on this device.`,
+            'error'
+          );
+          return;
+        }
+
+        if (
+          (availability === 'downloadable' || availability === 'downloading') &&
+          !fromButtonClick
+        ) {
+          hideProgress();
+          translateBtn.disabled = false;
+          translateBtn.textContent = 'Download & Translate';
+          setStatus(
+            'Language pack download required. Click "Download & Translate" to start on-device translation.',
+            'info'
+          );
+          return;
+        }
+
+        if (availability === 'downloadable' || availability === 'downloading') {
+          showProgress(null);
+          setStatus('Downloading language pack for on-device translation...', 'info');
+        } else {
+          setStatus('Translating menu and story on your device...', 'info');
+        }
+
+        const translator = await getOrCreateTranslator(options);
+        await applyTranslation(translator, targetLanguage);
+
+        hideProgress();
+        translateBtn.disabled = false;
+        translateBtn.textContent = 'Translate';
+        setStatus(
+          `Translated menu descriptions and story to ${languageSelect.options[languageSelect.selectedIndex].text}.`,
+          'info'
+        );
+      } catch (err) {
+        hideProgress();
+        translateBtn.disabled = false;
+        if (err && err.name === 'NotAllowedError') {
+          translateBtn.textContent = 'Download & Translate';
+          setStatus(
+            'Please click "Download & Translate" to authorize downloading the language pack.',
+            'error'
+          );
+        } else {
+          setStatus(
+            'Unable to complete on-device translation right now. Showing available content.',
+            'error'
+          );
+        }
+      }
+    }
+
+    // Initial feature detection on load
+    if (!('Translator' in self)) {
+      languageSelect.disabled = true;
+      translateBtn.disabled = true;
+      setStatus(
+        'Client-side translation is currently unsupported in this browser.',
+        'unsupported'
+      );
+    }
+
+    languageSelect.addEventListener('change', () => {
+      handleLanguageRequest({ fromButtonClick: false });
+    });
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      handleLanguageRequest({ fromButtonClick: true });
+    });
+  </script>
 </body>
 
