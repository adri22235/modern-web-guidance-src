+
+    const form = document.getElementById('coffee-finder-form');
+    const resultsGrid = document.getElementById('results-grid');
+    const resultsSummary = document.getElementById('results-summary');
+    const agentStatus = document.getElementById('agent-status');
+
+    function renderDrinks(drinks, isFiltered = false) {
+      resultsGrid.replaceChildren();
+
+      if (drinks.length === 0) {
+        resultsSummary.textContent = 'No matching drinks found (0 results)';
+        const emptyCard = document.createElement('div');
+        emptyCard.className = 'card';
+        const p = document.createElement('p');
+        p.textContent = 'No drinks matched all of your filters. Try broadening your flavor notes or increasing the caffeine ceiling.';
+        emptyCard.appendChild(p);
+        resultsGrid.appendChild(emptyCard);
+        return;
+      }
+
+      resultsSummary.textContent = isFiltered
+        ? `Matching Drinks (${drinks.length} found)`
+        : `All Featured Drinks (${drinks.length})`;
+
+      for (const drink of drinks) {
+        const card = document.createElement('div');
+        card.className = 'card';
+
+        const title = document.createElement('h3');
+        title.textContent = drink.name;
+
+        const desc = document.createElement('p');
+        desc.textContent = drink.description;
+
+        const badges = document.createElement('div');
+        const roastBadge = document.createElement('span');
+        roastBadge.className = 'badge';
+        roastBadge.textContent = `${drink.roast} roast`;
+
+        const tempBadge = document.createElement('span');
+        tempBadge.className = 'badge';
+        tempBadge.textContent = drink.temperature;
+
+        const milkBadge = document.createElement('span');
+        milkBadge.className = 'badge';
+        milkBadge.textContent = drink.milk === 'black' ? 'black' : `${drink.milk} milk`;
+
+        const caffeineBadge = document.createElement('span');
+        caffeineBadge.className = 'badge';
+        caffeineBadge.textContent = `${drink.caffeine} mg caffeine`;
+
+        badges.append(roastBadge, tempBadge, milkBadge, caffeineBadge);
+
+        const link = document.createElement('a');
+        link.href = drink.url;
+        link.className = 'btn';
+        link.textContent = 'View Details';
+
+        card.append(title, desc, badges, link);
+        resultsGrid.appendChild(card);
+      }
+    }
+
+    function validateCoffeeForm(formEl) {
+      const errors = [];
+      const data = new FormData(formEl);
+
+      const roast = (data.get('roast') || 'any').toString().trim();
+      const validRoasts = ['any', 'light', 'medium', 'dark'];
+      if (!validRoasts.includes(roast)) {
+        errors.push({ field: 'roast', message: 'Must be one of any, light, medium, or dark' });
+      }
+
+      const temperature = (data.get('temperature') || '').toString().trim();
+      const validTemps = ['any', 'hot', 'iced'];
+      if (!temperature || !validTemps.includes(temperature)) {
+        errors.push({ field: 'temperature', message: 'Please select any, hot, or iced' });
+      }
+
+      const milk = (data.get('milk') || 'any').toString().trim();
+      const validMilks = ['any', 'black', 'oat', 'almond', 'whole'];
+      if (!validMilks.includes(milk)) {
+        errors.push({ field: 'milk', message: 'Must be one of any, black, oat, almond, or whole' });
+      }
+
+      const maxCaffeineRaw = (data.get('maxCaffeine') ?? '').toString().trim();
+      const maxCaffeine = Number(maxCaffeineRaw);
+      if (maxCaffeineRaw === '' || Number.isNaN(maxCaffeine) || maxCaffeine < 0 || maxCaffeine > 400) {
+        errors.push({ field: 'maxCaffeine', message: 'Caffeine limit must be a number between 0 and 400 mg' });
+      }
+
+      return errors;
+    }
+
+    async function performCoffeeSearch(formData) {
+      const roast = (formData.get('roast') || 'any').toString().toLowerCase().trim();
+      const temperature = (formData.get('temperature') || 'any').toString().toLowerCase().trim();
+      const milk = (formData.get('milk') || 'any').toString().toLowerCase().trim();
+      const flavorQuery = (formData.get('flavor') || '').toString().toLowerCase().trim();
+      const maxCaffeine = Number(formData.get('maxCaffeine') ?? 300);
+
+      const matches = COFFEE_MENU.filter((drink) => {
+        if (roast !== 'any' && drink.roast !== roast) return false;
+        if (temperature !== 'any' && drink.temperature !== temperature) return false;
+        if (milk !== 'any' && drink.milk !== milk) return false;
+        if (!Number.isNaN(maxCaffeine) && drink.caffeine > maxCaffeine) return false;
+        if (flavorQuery) {
+          const keywords = flavorQuery.split(/[\s,]+/).filter(Boolean);
+          const searchable = `${drink.name} ${drink.description} ${drink.flavors.join(' ')}`.toLowerCase();
+          const matchesFlavor = keywords.some((kw) => searchable.includes(kw));
+          if (!matchesFlavor) return false;
+        }
+        return true;
+      });
+
+      // Update UI state before returning to the agent for consistency
+      renderDrinks(matches, true);
+
+      if (matches.length === 0) {
+        return 'No matching coffee drinks found for the selected criteria.';
+      }
+
+      const summaryList = matches
+        .map((d) => `${d.name} (${d.roast} roast, ${d.temperature}, ${d.milk === 'black' ? 'black' : d.milk + ' milk'}, ${d.caffeine}mg caffeine)`)
+        .join('; ');
+      return `Found ${matches.length} matching coffee drink(s): ${summaryList}.`;
+    }
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      form.querySelectorAll('input[required], select[required]').forEach((control) => {
+        if (!control.checkValidity()) {
+          control.setAttribute('aria-invalid', 'true');
+        } else {
+          control.removeAttribute('aria-invalid');
+        }
+      });
+
+      const formValidationErrors = validateCoffeeForm(form);
+
+      if (formValidationErrors.length > 0) {
+        if (event.agentInvoked) {
+          const errorString =
+            'Validation failed: ' +
+            formValidationErrors
+              .map((err) => `${err.field} (${err.message})`)
+              .join(', ');
+
+          event.respondWith(Promise.resolve(errorString));
+        }
+        return;
+      }
+
+      const resultPromise = performCoffeeSearch(new FormData(event.target));
+
+      if (event.agentInvoked) {
+        event.respondWith(resultPromise);
+      }
+    });
+
+    form.addEventListener('reset', () => {
+      setTimeout(() => {
+        form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
+        renderDrinks(COFFEE_MENU, false);
+      }, 0);
+    });
+
+    // WebMCP Lifecycle Events (Chrome 156+ dispatches on document.modelContext; older versions on window)
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor('toolactivated', ({ toolName }) => {
+      console.log(`Tool "${toolName}" started execution.`);
+      if (toolName === 'find-coffee') {
+        agentStatus.textContent = 'AI Assistant is searching the coffee menu for you...';
+        agentStatus.classList.add('active');
+      }
+    });
+
+    targetFor('toolcancel', ({ toolName }) => {
+      console.log(`Tool "${toolName}" execution is cancelled.`);
+      if (toolName === 'find-coffee') {
+        agentStatus.textContent = 'AI Assistant search was canceled.';
+        setTimeout(() => agentStatus.classList.remove('active'), 3000);
+      }
+    });
+
+    // Synchronize aria-invalid with :user-invalid state
+    const updateAriaState = (event) => {
+      const input = event.target;
+      if (!input.matches?.('input, textarea, select')) return;
+
+      const isUserInvalid = CSS.supports('selector(:user-invalid)')
+        ? input.matches(':user-invalid')
+        : input.classList.contains('user-invalid-fallback');
+
+      if (isUserInvalid) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    document.addEventListener('blur', updateAriaState, true);
+    document.addEventListener('focus', updateAriaState, true);
+    document.addEventListener('input', (event) => {
+      const input = event.target;
+      if (!input.matches?.('input, textarea, select')) return;
+      if (input.getAttribute('aria-invalid') === 'true') {
+        updateAriaState(event);
+      }
+    });
+
+    const UserInvalidFallback = (() => {
+      const dirtyState = new WeakMap();
+
+      const updateState = (input) => {
+        const isValid = input.checkValidity();
+        input.classList.toggle('user-invalid-fallback', !isValid);
+        input.classList.toggle('user-valid-fallback', isValid);
+
+        if (!isValid) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+
+      const handleEvent = (event) => {
+        const input = event.target;
+
+        if (event.type === 'reset' && input.matches?.('form')) {
+          const controls = input.elements || [];
+          for (const control of controls) {
+            dirtyState.delete(control);
+            control.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+            control.removeAttribute('aria-invalid');
+          }
+          return;
+        }
+
+        if (!input.matches?.('input, textarea, select')) return;
+
+        if (event.type === 'input' || event.type === 'change') {
+          const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
+          state.hasInteracted = true;
+          dirtyState.set(input, state);
+          if (state.hasBlurred) {
+            updateState(input);
+          }
+        } else if (event.type === 'blur') {
+          const state = dirtyState.get(input) || { hasInteracted: false, hasBlurred: false };
+          state.hasBlurred = true;
+          dirtyState.set(input, state);
+          if (state.hasInteracted) {
+            updateState(input);
+          }
+        }
+      };
+
+      const init = () => {
+        if (CSS.supports('selector(:user-invalid)')) return;
+        document.addEventListener('blur', handleEvent, true);
+        document.addEventListener('input', handleEvent, true);
+        document.addEventListener('change', handleEvent, true);
+        document.addEventListener('reset', handleEvent, true);
+      };
+
+      return { init };
+    })();
+
+    UserInvalidFallback.init();
+    renderDrinks(COFFEE_MENU, false);
+  </script>
