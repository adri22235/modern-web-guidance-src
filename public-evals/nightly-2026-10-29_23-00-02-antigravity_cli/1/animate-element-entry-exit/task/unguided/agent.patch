+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promos = [
+      {
+        title: 'Happy Hour: 50% Off Cold Brew',
+        desc: 'Beat the afternoon slump with half-price cold brews from 2 PM to 4 PM.',
+        link: '/menu/cold-brew'
+      },
+      {
+        title: 'Free Pastry Friday',
+        desc: 'Enjoy a complimentary artisanal croissant with any large specialty latte.',
+        link: '/menu/seasonal'
+      },
+      {
+        title: 'Bring a Mug, Save $1',
+        desc: 'Help us stay sustainable and get $1 off when you bring your own tumbler.',
+        link: '/locations'
+      },
+      {
+        title: 'Roaster\'s Choice Bundle',
+        desc: 'Take home two bags of our single-origin whole bean coffee for $25.',
+        link: '/order-online'
+      }
+    ];
+
+    let promoCount = 0;
+
+    addBtn.addEventListener('click', () => {
+      const promo = promos[promoCount % promos.length];
+      promoCount++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${promo.title}</h3>
+        <p>${promo.desc}</p>
+        <a href="${promo.link}" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      lastCard.addEventListener('transitionend', () => {
+        lastCard.remove();
+      }, { once: true });
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
+
