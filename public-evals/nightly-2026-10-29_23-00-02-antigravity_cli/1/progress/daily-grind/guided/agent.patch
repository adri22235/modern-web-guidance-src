+  <script>
+    const orderProgress = document.getElementById('order-progress');
+    const orderStatus = document.getElementById('order-status');
+    const stateButtons = document.querySelectorAll('[data-order-state]');
+
+    stateButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        const state = button.dataset.orderState;
+        if (state === 'indeterminate') {
+          orderProgress.removeAttribute('value');
+          orderStatus.textContent = 'Confirming with Barista...';
+        } else {
+          orderProgress.value = Number(state);
+          orderStatus.textContent =
+            state === '100'
+              ? 'Order Complete — Ready for Pickup!'
+              : `Brewing Order (${state}%)`;
+        }
+      });
+    });
