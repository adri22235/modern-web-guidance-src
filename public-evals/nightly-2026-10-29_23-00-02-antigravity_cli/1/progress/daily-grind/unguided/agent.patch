+  <script>
+    (function () {
+      const progressBar = document.getElementById('reward-order-progress');
+      const statusText = document.getElementById('progress-status-text');
+      const modeBadge = document.getElementById('progress-mode-badge');
+      const buttons = document.querySelectorAll('.progress-btn');
+      const milestones = document.querySelectorAll('#progress-milestones span');
+
+      const stepDescriptions = {
+        25: '25% Complete — 50 / 200 Beans (Order Placed, Step 1 of 4)',
+        50: '50% Complete — 100 / 200 Beans (Grinding Beans, Step 2 of 4)',
+        75: '75% Complete — 150 / 200 Beans (Brewing Step 3 of 4)',
+        100: '100% Complete — 200 / 200 Beans (Order Ready & Free Drink Reward Unlocked!)'
+      };
+
+      buttons.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          buttons.forEach(function (b) { b.classList.remove('active'); });
+          btn.classList.add('active');
+
+          const mode = btn.getAttribute('data-progress-mode');
+          if (mode === 'indeterminate') {
+            progressBar.removeAttribute('value');
+            progressBar.removeAttribute('aria-valuenow');
+            progressBar.setAttribute('aria-busy', 'true');
+            progressBar.classList.remove('determinate');
+            progressBar.classList.add('indeterminate');
+            progressBar.textContent = 'Processing...';
+            statusText.textContent = 'Indeterminate — Syncing order & reward points with barista station...';
+            modeBadge.textContent = 'Indeterminate (Processing)';
+            milestones.forEach(function (m) { m.classList.remove('active'); });
+          } else {
+            const val = parseInt(btn.getAttribute('data-progress-value'), 10);
+            progressBar.setAttribute('max', '100');
+            progressBar.setAttribute('value', String(val));
+            progressBar.value = val;
+            progressBar.setAttribute('aria-valuenow', String(val));
+            progressBar.removeAttribute('aria-busy');
+            progressBar.classList.remove('indeterminate');
+            progressBar.classList.add('determinate');
+            progressBar.textContent = val + '%';
+            statusText.textContent = stepDescriptions[val] || (val + '% Complete');
+            modeBadge.textContent = 'Determinate (' + val + '%)';
+            milestones.forEach(function (m) {
+              const stepVal = parseInt(m.getAttribute('data-step'), 10);
+              if (stepVal <= val) {
+                m.classList.add('active');
+              } else {
+                m.classList.remove('active');
+              }
+            });
+          }
+        });
+      });
+    })();
+  </script>
+
