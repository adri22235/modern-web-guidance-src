+      visibility: hidden;
+      opacity: 0;
+      pointer-events: none;
+      z-index: 100;
+    }
+
+    .tooltip::before {
+      content: '';
+      position: absolute;
+      right: 100%;
+      top: 50%;
+      transform: translateY(-50%);
+      border-width: 6px;
+      border-style: solid;
+      border-color: transparent var(--text) transparent transparent;
+    }
+
+    .tooltip-title {
+      font-weight: bold;
+      color: var(--accent);
+      margin-bottom: 3px;
+      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
+      padding-bottom: 2px;
+    }
+
+    .tooltip-wrapper:hover .tooltip,
+    .btn:hover + .tooltip,
+    .btn:focus + .tooltip,
+    .btn:focus-visible + .tooltip,
+    .tooltip.visible {
+      visibility: visible;
+      opacity: 1;
+    }
