+  <script type="module">
+    // Feature detect Invoker Commands API and conditionally load polyfill when missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    // Fallback for declarative light-dismiss (closedby="any") in browsers without native closedBy support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dialog)) dialog.close(); });
+      }
+    }
+
+    const feedbackDialog = document.getElementById('feedback-modal');
+    const openFeedbackBtn = document.getElementById('open-feedback-btn');
+    const moveDialogBtn = document.getElementById('move-dialog-btn');
+    const parentIndicator = document.getElementById('dialog-parent-indicator');
+    const reparentStatus = document.getElementById('reparent-status');
+
+    const hostContainers = [
+      document.getElementById('feedback-host-primary'),
+      document.getElementById('feedback-host-secondary'),
+      document.getElementById('feedback-host-footer'),
+    ];
+
+    // Fallback click listener to open modal immediately if Invoker Commands are not natively supported
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      openFeedbackBtn.addEventListener('click', () => {
+        if (!feedbackDialog.open) {
+          feedbackDialog.showModal();
+        }
+      });
+    }
+
+    // Reset dialog.returnValue on close so stale values do not leak across dismissals
+    feedbackDialog.addEventListener('close', () => {
+      const choice = feedbackDialog.returnValue;
+      feedbackDialog.returnValue = '';
+      if (choice === 'submit') {
+        reparentStatus.textContent = 'Thank you for sharing your feedback!';
+      }
+    });
+
+    function relocateDialog(targetParent) {
+      if (!targetParent || feedbackDialog.parentElement === targetParent) return;
+
+      const activeEl = document.activeElement;
+      const hadFocusInside = feedbackDialog.contains(activeEl);
+      const selectionStart = activeEl && 'selectionStart' in activeEl ? activeEl.selectionStart : null;
+      const selectionEnd = activeEl && 'selectionEnd' in activeEl ? activeEl.selectionEnd : null;
+
+      // MANDATORY: Feature-detect moveBefore on Element.prototype to reparent without losing top-layer or focus state
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+        reparentStatus.textContent = `Relocated via native moveBefore() to #${targetParent.id} (state preserved).`;
+      } else {
+        // Fallback: traditional DOM move closes top-layer elements (<dialog> / popover) and resets focus
+        const wasOpen = feedbackDialog.hasAttribute('open') || feedbackDialog.matches(':popover-open');
+        targetParent.insertBefore(feedbackDialog, null);
+
+        // Manually restore modal / popover state
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+
+        // Restore focus and text selection if focus was inside the dialog prior to fallback reparenting
+        if (hadFocusInside && activeEl instanceof HTMLElement) {
+          activeEl.focus();
+          if (selectionStart !== null && selectionEnd !== null && typeof activeEl.setSelectionRange === 'function') {
+            try {
+              activeEl.setSelectionRange(selectionStart, selectionEnd);
+            } catch {
+              // Ignore input types that do not support setSelectionRange
+            }
+          }
+        }
+        reparentStatus.textContent = `Relocated via fallback insertBefore() + showModal() to #${targetParent.id}.`;
+      }
+
+      parentIndicator.textContent = `DOM Parent: #${targetParent.id}`;
+    }
+
+    moveDialogBtn.addEventListener('click', () => {
+      const currentIndex = hostContainers.indexOf(feedbackDialog.parentElement);
+      const nextIndex = (currentIndex + 1) % hostContainers.length;
+      relocateDialog(hostContainers[nextIndex]);
+    });
+  </script>
