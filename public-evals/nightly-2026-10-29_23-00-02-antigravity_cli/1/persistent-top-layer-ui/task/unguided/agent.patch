+
+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const closeBtn = document.getElementById('close-modal-btn');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const feedbackForm = document.getElementById('feedback-form');
+      const dockIndicator = document.getElementById('feedback-dock-indicator');
+      const statusText = document.getElementById('feedback-status');
+
+      const docks = Array.from(document.querySelectorAll('.feedback-dock'));
+
+      function openFeedbackModal() {
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else if (typeof dialog.show === 'function') {
+            dialog.show();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+        if (!dialog.contains(document.activeElement)) {
+          moveBtn.focus({ preventScroll: true });
+        }
+      }
+
+      function restoreDialogStateAndFocus(wasOpen, wasModal, activeElement, selectionState) {
+        if (wasOpen) {
+          let isCurrentlyModal = false;
+          try {
+            isCurrentlyModal = dialog.matches(':modal');
+          } catch (_) {
+            isCurrentlyModal = dialog.open;
+          }
+
+          if (!dialog.open || (wasModal && !isCurrentlyModal)) {
+            if (dialog.open && typeof dialog.close === 'function') {
+              dialog.close();
+            }
+            if (wasModal && typeof dialog.showModal === 'function') {
+              dialog.showModal();
+            } else if (typeof dialog.show === 'function') {
+              dialog.show();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          }
+        }
+
+        const targetFocus =
+          activeElement && dialog.contains(activeElement) ? activeElement : moveBtn;
+
+        if (targetFocus && typeof targetFocus.focus === 'function') {
+          if (document.activeElement !== targetFocus) {
+            targetFocus.focus({ preventScroll: true });
+          }
+          if (
+            selectionState &&
+            selectionState.start !== null &&
+            selectionState.end !== null &&
+            typeof targetFocus.setSelectionRange === 'function'
+          ) {
+            try {
+              targetFocus.setSelectionRange(
+                selectionState.start,
+                selectionState.end,
+                selectionState.direction || 'none'
+              );
+            } catch (_) {}
+          }
+        }
+      }
+
+      function relocateFeedbackModal() {
+        if (!docks.length) return;
+
+        // Ensure the modal is open and has active focus inside it prior to moving
+        if (!dialog.open) {
+          openFeedbackModal();
+        } else if (!dialog.contains(document.activeElement)) {
+          moveBtn.focus({ preventScroll: true });
+        }
+
+        const previouslyFocused = dialog.contains(document.activeElement)
+          ? document.activeElement
+          : moveBtn;
+
+        let selectionState = null;
+        if (
+          previouslyFocused &&
+          (previouslyFocused instanceof HTMLInputElement ||
+            previouslyFocused instanceof HTMLTextAreaElement)
+        ) {
+          try {
+            selectionState = {
+              start: previouslyFocused.selectionStart,
+              end: previouslyFocused.selectionEnd,
+              direction: previouslyFocused.selectionDirection,
+            };
+          } catch (_) {}
+        }
+
+        const wasOpen = dialog.open;
+        let wasModal = false;
+        try {
+          wasModal = dialog.matches(':modal');
+        } catch (_) {
+          wasModal = wasOpen;
+        }
+
+        const currentDock = dialog.parentElement;
+        const currentIndex = docks.indexOf(currentDock);
+        const nextDock = docks[(currentIndex + 1) % docks.length];
+
+        let usedNativeMoveBefore = false;
+
+        if (typeof nextDock.moveBefore === 'function') {
+          try {
+            nextDock.moveBefore(dialog, null);
+            usedNativeMoveBefore = true;
+          } catch (_) {
+            usedNativeMoveBefore = false;
+          }
+        }
+
+        if (!usedNativeMoveBefore) {
+          nextDock.appendChild(dialog);
+          restoreDialogStateAndFocus(wasOpen, wasModal, previouslyFocused, selectionState);
+        } else {
+          // Verify state remains open and focused if moveBefore was polyfilled/mocked
+          restoreDialogStateAndFocus(wasOpen, wasModal, previouslyFocused, selectionState);
+        }
+
+        const dockName = nextDock.getAttribute('data-dock-name') || nextDock.id;
+        if (dockIndicator) {
+          dockIndicator.textContent = 'Location: ' + dockName;
+        }
+        if (statusText) {
+          statusText.textContent = usedNativeMoveBefore
+            ? 'Moved via native moveBefore()'
+            : 'Moved via fallback (state restored)';
+        }
+      }
+
+      moveBtn.addEventListener('click', relocateFeedbackModal);
+
+      closeBtn.addEventListener('click', function () {
+        if (dialog.open) {
+          dialog.close();
+        }
+      });
+
+      openBtn.addEventListener('click', function () {
+        openFeedbackModal();
+      });
+
+      feedbackForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (statusText) {
+          statusText.textContent = 'Thank you for your feedback!';
+        }
+      });
+
+      // Open the persistent feedback modal on initialization
+      openFeedbackModal();
+    })();
+  </script>
