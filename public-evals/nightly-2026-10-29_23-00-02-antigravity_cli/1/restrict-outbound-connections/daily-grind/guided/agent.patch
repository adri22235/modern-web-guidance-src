@@ -0,0 +1,324 @@
+import http from 'node:http';
+import fs from 'node:fs/promises';
+import crypto from 'node:crypto';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+const ALLOWED_EXTERNAL_PATTERNS = ['https://images.unsplash.com'];
+const subscribers = new Set();
+
+// Normalize a config URL or URLPattern string for Connection-Allowlist:
+// - Rewrites ws:// and wss:// to http:// and https:// (WebSocket matching rule).
+// - Strips a bare trailing slash on origin-only URLs (e.g. from new URL(...).href)
+//   so all subpaths on the origin are permitted instead of only "/".
+export function normalizeAllowlistPattern(rawPattern) {
+  const trimmed = String(rawPattern).trim().replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\//i.test(trimmed)) {
+    throw new Error(`Pattern must include an http:// or https:// scheme: ${rawPattern}`);
+  }
+  if (/[\s,]/.test(trimmed)) {
+    throw new Error(`Pattern must be a single URLPattern without spaces or commas: ${rawPattern}`);
+  }
+  if (/[()]/.test(trimmed)) {
+    throw new Error(`Custom regex groups are rejected by Connection-Allowlist: ${rawPattern}`);
+  }
+  return trimmed.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+// Build an RFC 9651 Inner List value for Connection-Allowlist or Connection-Allowlist-Report-Only.
+export function buildConnectionAllowlistHeader({
+  allowSelf = true,
+  patterns = ALLOWED_EXTERNAL_PATTERNS,
+  reportTo,
+  redirects = 'block',
+  webrtc = 'block',
+} = {}) {
+  const items = allowSelf ? ['response-origin'] : [];
+  for (const pattern of patterns) {
+    const raw = String(pattern).trim();
+    if (raw === 'response-origin') {
+      if (!items.includes('response-origin')) items.push('response-origin');
+      continue;
+    }
+    const normalized = normalizeAllowlistPattern(raw);
+    items.push(`"${normalized.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let header = `(${items.join(' ')})`;
+  if (redirects === 'allow') header += '; redirects=allow';
+  if (webrtc === 'allow') header += '; webrtc=allow';
+  if (reportTo) {
+    const endpointToken = String(reportTo).trim().replace(/^"+|"+$/g, '');
+    header += `; report-to=${endpointToken}`;
+  }
+  return header;
+}
+
+// Server or middleware helper applying Connection-Allowlist and Reporting-Endpoints
+// on document and worker responses.
+export function setConnectionAllowlistHeaders(res, options = {}) {
+  const {
+    secFetchDest = 'document',
+    patterns = ALLOWED_EXTERNAL_PATTERNS,
+    reportOnlyPatterns,
+    reportEndpointName = 'conn-reports',
+    reportEndpointUrl = `http://localhost:${PORT}/api/security-reports`,
+    redirects = 'block',
+    webrtc = 'block',
+    reportOnly = false,
+    styleHashes = [],
+  } = options;
+
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers.set(name, value);
+
+  if (typeof res.appendHeader === 'function') {
+    res.appendHeader('Vary', 'Sec-Fetch-Dest');
+  } else if (typeof res.headers?.append === 'function') {
+    res.headers.append('Vary', 'Sec-Fetch-Dest');
+  } else {
+    setHeader('Vary', 'Sec-Fetch-Dest');
+  }
+
+  if (secFetchDest && !ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) return;
+
+  setHeader('Reporting-Endpoints', `${reportEndpointName}="${reportEndpointUrl}"`);
+  setHeader(
+    reportOnly ? 'Connection-Allowlist-Report-Only' : 'Connection-Allowlist',
+    buildConnectionAllowlistHeader({ allowSelf: true, patterns, reportTo: reportEndpointName, redirects, webrtc }),
+  );
+
+  if (!reportOnly && Array.isArray(reportOnlyPatterns)) {
+    setHeader(
+      'Connection-Allowlist-Report-Only',
+      buildConnectionAllowlistHeader({
+        allowSelf: true,
+        patterns: reportOnlyPatterns,
+        reportTo: reportEndpointName,
+        redirects,
+        webrtc,
+      }),
+    );
+  }
+
+  const styleSrcTokens = ["'self'", ...styleHashes.map((h) => `'${h}'`)].join(' ');
+  const csp = [
+    "default-src 'self'",
+    "connect-src 'self' https://images.unsplash.com",
+    "img-src 'self' https://images.unsplash.com data: blob:",
+    `style-src ${styleSrcTokens}`,
+    "script-src 'self'",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'self'",
+    "frame-ancestors 'self'",
+    `report-to ${reportEndpointName}`,
+  ].join('; ');
+  setHeader('Content-Security-Policy', csp);
+}
+
+function setCompanionSecurityHeaders(res) {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'SAMEORIGIN');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Permissions-Policy', 'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()');
+}
+
+function extractInlineStyleHashes(html) {
+  const hashes = [];
+  const styleRegex = /<style>([\s\S]*?)<\/style>/gi;
+  let match;
+  while ((match = styleRegex.exec(html)) !== null) {
+    const digest = crypto.createHash('sha256').update(match[1]).digest('base64');
+    hashes.push(`sha256-${digest}`);
+  }
+  return hashes;
+}
+
+function readRequestBody(req, maxBytes = 64 * 1024) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let total = 0;
+    req.on('data', (chunk) => {
+      total += chunk.length;
+      if (total > maxBytes) {
+        reject(new Error('Payload too large'));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function parseEmailFromBody(rawBody, contentType = '') {
+  if (!rawBody) return '';
+  if (contentType.includes('application/json')) {
+    const parsed = JSON.parse(rawBody);
+    return typeof parsed?.email === 'string' ? parsed.email.trim() : '';
+  }
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const params = new URLSearchParams(rawBody);
+    return (params.get('email') || '').trim();
+  }
+  try {
+    const parsed = JSON.parse(rawBody);
+    if (typeof parsed?.email === 'string') return parsed.email.trim();
+  } catch {
+    const params = new URLSearchParams(rawBody);
+    if (params.has('email')) return (params.get('email') || '').trim();
+  }
+  return '';
+}
+
+function isValidEmail(email) {
+  return typeof email === 'string' && email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
+}
+
+export function createAppServer() {
+  return http.createServer(async (req, res) => {
+    setCompanionSecurityHeaders(res);
+
+    const host = req.headers.host || `localhost:${PORT}`;
+    const protocol = req.headers['x-forwarded-proto'] || 'http';
+    const reportEndpointUrl = `${protocol}://${host}/api/security-reports`;
+    const url = new URL(req.url || '/', `${protocol}://${host}`);
+    const pathname = url.pathname;
+
+    // Fetch Metadata resource isolation check for non-navigational cross-site requests
+    const secFetchSite = req.headers['sec-fetch-site'];
+    const secFetchMode = req.headers['sec-fetch-mode'];
+    const secFetchDest = req.headers['sec-fetch-dest'];
+
+    if (
+      secFetchSite &&
+      !['same-origin', 'same-site', 'none'].includes(secFetchSite) &&
+      !(
+        secFetchSite === 'cross-site' &&
+        secFetchMode === 'navigate' &&
+        req.method === 'GET' &&
+        !['object', 'embed'].includes(secFetchDest)
+      )
+    ) {
+      res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+      res.writeHead(403, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ ok: false, error: 'Cross-site requests are forbidden.' }));
+      return;
+    }
+
+    // Violation reporting endpoint for Connection-Allowlist and CSP
+    if (pathname === '/api/security-reports' && req.method === 'POST') {
+      try {
+        await readRequestBody(req);
+      } catch {
+        // Ignore malformed report bodies
+      }
+      res.writeHead(204);
+      res.end();
+      return;
+    }
+
+    // Newsletter subscription endpoint
+    if (
+      ['/api/newsletter', '/newsletter', '/api/subscribe', '/subscribe'].includes(pathname) &&
+      (req.method === 'POST' || req.method === 'GET')
+    ) {
+      res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
+      if (req.method === 'GET') {
+        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ ok: true, count: subscribers.size }));
+        return;
+      }
+
+      try {
+        const rawBody = await readRequestBody(req);
+        const email = parseEmailFromBody(rawBody, req.headers['content-type'] || '');
+
+        if (!isValidEmail(email)) {
+          res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+          res.end(JSON.stringify({ ok: false, error: 'Please provide a valid email address.' }));
+          return;
+        }
+
+        subscribers.add(email.toLowerCase());
+        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(
+          JSON.stringify({
+            ok: true,
+            message: 'Thank you for subscribing to The Daily Grind newsletter!',
+            email,
+          }),
+        );
+      } catch {
+        res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ ok: false, error: 'Invalid request payload.' }));
+      }
+      return;
+    }
+
+    // Logout route
+    if (pathname === '/logout') {
+      res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+      res.writeHead(200, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Logged out.');
+      return;
+    }
+
+    // Static assets (e.g., /app.js)
+    if (pathname === '/app.js' && (req.method === 'GET' || req.method === 'HEAD')) {
+      try {
+        const jsContent = await fs.readFile(path.join(__dirname, 'app.js'), 'utf8');
+        setConnectionAllowlistHeaders(res, {
+          secFetchDest: secFetchDest || 'script',
+          patterns: ALLOWED_EXTERNAL_PATTERNS,
+          reportEndpointUrl,
+        });
+        res.writeHead(200, { 'Content-Type': 'text/javascript; charset=utf-8' });
+        res.end(req.method === 'HEAD' ? undefined : jsContent);
+      } catch {
+        res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+        res.end('Not Found');
+      }
+      return;
+    }
+
+    // Homepage document route
+    if ((pathname === '/' || pathname === '/index.html') && (req.method === 'GET' || req.method === 'HEAD')) {
+      try {
+        const html = await fs.readFile(path.join(__dirname, 'index.html'), 'utf8');
+        const styleHashes = extractInlineStyleHashes(html);
+        setConnectionAllowlistHeaders(res, {
+          secFetchDest: secFetchDest || 'document',
+          patterns: ALLOWED_EXTERNAL_PATTERNS,
+          reportEndpointUrl,
+          styleHashes,
+        });
+        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+        res.end(req.method === 'HEAD' ? undefined : html);
+      } catch {
+        res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+        res.end('Internal Server Error');
+      }
+      return;
+    }
+
+    res.writeHead(404, { 'Content-Type': 'application/json; charset=utf-8' });
+    res.end(JSON.stringify({ ok: false, error: 'Not Found' }));
+  });
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  const server = createAppServer();
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
