+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const messageBox = document.getElementById('newsletter-message');
+      const submitBtn = document.getElementById('newsletter-submit');
+
+      function showMessage(text, type) {
+        if (!messageBox) return;
+        messageBox.textContent = text;
+        messageBox.className = 'status-message visible ' + (type || 'error');
+      }
+
+      document.addEventListener('securitypolicyviolation', function (e) {
+        const blocked = e.blockedURI || 'an unauthorized destination';
+        showMessage(
+          'Security notice: A request to ' + blocked + ' could not go through because connections outside our server are blocked.',
+          'error'
+        );
+      });
+
+      window.addEventListener('unhandledrejection', function (e) {
+        if (e && e.reason && (e.reason.name === 'TypeError' || String(e.reason).toLowerCase().includes('fetch') || String(e.reason).toLowerCase().includes('network'))) {
+          showMessage(
+            'Unable to complete the request. The connection was blocked or could not reach the server.',
+            'error'
+          );
+        }
+      });
+
+      if (form) {
+        form.addEventListener('submit', async function (e) {
+          e.preventDefault();
+          const email = emailInput ? emailInput.value.trim() : '';
+
+          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+            showMessage('Please enter a valid email address.', 'error');
+            return;
+          }
+
+          const targetUrl = form.getAttribute('action') || '/api/newsletter';
+          submitBtn.disabled = true;
+
+          try {
+            const response = await fetch(targetUrl, {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json'
+              },
+              body: JSON.stringify({ email: email })
+            });
+
+            let data = {};
+            try {
+              data = await response.json();
+            } catch (_) {
+              // Ignore JSON parse errors on non-JSON responses
+            }
+
+            if (!response.ok || data.ok === false) {
+              showMessage(
+                data.message || 'Your request could not go through. Please try again later.',
+                'error'
+              );
+              return;
+            }
+
+            showMessage(
+              data.message || 'Thanks for subscribing to The Daily Grind newsletter!',
+              'success'
+            );
+            form.reset();
+          } catch (err) {
+            showMessage(
+              'Your request could not go through. Please check your connection or security policy and try again.',
+              'error'
+            );
+          } finally {
+            submitBtn.disabled = false;
+          }
+        });
+      }
+    })();
+  </script>
