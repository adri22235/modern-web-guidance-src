+++ b/server.js
@@ -0,0 +1,182 @@
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const PORT = process.env.PORT || 11222;
+const subscribers = [];
+
+const CSP_HEADER = [
+  "default-src 'self'",
+  "script-src 'self' 'unsafe-inline'",
+  "style-src 'self' 'unsafe-inline'",
+  "img-src 'self' https://images.unsplash.com data:",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "frame-src 'none'",
+  "object-src 'none'",
+  "base-uri 'self'"
+].join('; ');
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon'
+};
+
+const sendJson = (res, statusCode, payload) => {
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Content-Security-Policy': CSP_HEADER,
+    'X-Content-Type-Options': 'nosniff'
+  });
+  res.end(JSON.stringify(payload));
+};
+
+const handleNewsletterPost = (req, res, parsedUrl) => {
+  let body = '';
+  req.on('data', (chunk) => {
+    body += chunk.toString();
+    if (body.length > 1e5) {
+      req.destroy();
+    }
+  });
+
+  req.on('end', () => {
+    let email = '';
+    const contentType = (req.headers['content-type'] || '').toLowerCase();
+
+    try {
+      if (contentType.includes('application/json')) {
+        const data = JSON.parse(body || '{}');
+        email = (data.email || '').trim();
+      } else if (contentType.includes('application/x-www-form-urlencoded')) {
+        const params = new URLSearchParams(body);
+        email = (params.get('email') || '').trim();
+      } else if (body) {
+        try {
+          const data = JSON.parse(body);
+          email = (data.email || '').trim();
+        } catch {
+          const params = new URLSearchParams(body);
+          email = (params.get('email') || '').trim();
+        }
+      }
+    } catch (err) {
+      return sendJson(res, 400, { ok: false, message: 'Invalid request payload.' });
+    }
+
+    if (!email && parsedUrl.searchParams.get('email')) {
+      email = parsedUrl.searchParams.get('email').trim();
+    }
+
+    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+    if (!email || !emailRegex.test(email)) {
+      return sendJson(res, 400, {
+        ok: false,
+        message: 'Please enter a valid email address.'
+      });
+    }
+
+    if (!subscribers.includes(email.toLowerCase())) {
+      subscribers.push(email.toLowerCase());
+    }
+
+    return sendJson(res, 200, {
+      ok: true,
+      email,
+      message: 'Thanks for subscribing to The Daily Grind newsletter!'
+    });
+  });
+};
+
+const server = http.createServer((req, res) => {
+  const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
+  const pathname = parsedUrl.pathname;
+
+  res.setHeader('Content-Security-Policy', CSP_HEADER);
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+
+  const newsletterRoutes = [
+    '/newsletter',
+    '/api/newsletter',
+    '/subscribe',
+    '/api/subscribe',
+    '/signup',
+    '/api/signup'
+  ];
+
+  if (req.method === 'POST' && (newsletterRoutes.includes(pathname) || pathname === '/')) {
+    return handleNewsletterPost(req, res, parsedUrl);
+  }
+
+  if (req.method === 'GET' && newsletterRoutes.includes(pathname)) {
+    if (parsedUrl.searchParams.has('email')) {
+      return handleNewsletterPost(req, res, parsedUrl);
+    }
+    return sendJson(res, 200, { ok: true, count: subscribers.length, subscribers });
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return sendJson(res, 405, { ok: false, message: 'Method not allowed.' });
+  }
+
+  let safePath = path.normalize(pathname).replace(/^(\.\.[/\\])+/, '');
+  if (safePath === '/' || safePath === '\\') {
+    safePath = '/index.html';
+  }
+
+  const filePath = path.join(__dirname, safePath);
+
+  fs.stat(filePath, (err, stats) => {
+    if (err || !stats.isFile()) {
+      const indexPath = path.join(__dirname, 'index.html');
+      fs.readFile(indexPath, (readErr, content) => {
+        if (readErr) {
+          res.writeHead(404, {
+            'Content-Type': 'text/plain; charset=utf-8',
+            'Content-Security-Policy': CSP_HEADER
+          });
+          res.end('Not Found');
+          return;
+        }
+        res.writeHead(200, {
+          'Content-Type': 'text/html; charset=utf-8',
+          'Content-Security-Policy': CSP_HEADER,
+          'X-Content-Type-Options': 'nosniff'
+        });
+        res.end(req.method === 'HEAD' ? undefined : content);
+      });
+      return;
+    }
+
+    const ext = path.extname(filePath).toLowerCase();
+    const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+
+    fs.readFile(filePath, (readErr, content) => {
+      if (readErr) {
+        res.writeHead(500, {
+          'Content-Type': 'text/plain; charset=utf-8',
+          'Content-Security-Policy': CSP_HEADER
+        });
+        res.end('Internal Server Error');
+        return;
+      }
+      res.writeHead(200, {
+        'Content-Type': contentType,
+        'Content-Security-Policy': CSP_HEADER,
+        'X-Content-Type-Options': 'nosniff'
+      });
+      res.end(req.method === 'HEAD' ? undefined : content);
+    });
+  });
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+});
