+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+    }
+
+    .table-wrapper:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      border-collapse: collapse;
+      text-align: left;
+      min-width: 520px;
+    }
+
+    .nutrition-table caption {
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      padding: 16px 20px 12px;
+      text-align: left;
+      border-bottom: 2px solid var(--secondary);
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 16px;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .nutrition-table thead th {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+      font-size: 0.9rem;
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 2;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      font-weight: 600;
+      color: var(--primary);
+      background-color: white;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) td,
+    .nutrition-table tbody tr:nth-child(even) th[scope="row"] {
+      background-color: #f7f3f2;
+    }
+
+    .nutrition-table tbody tr:hover td,
+    .nutrition-table tbody tr:hover th[scope="row"] {
+      background-color: #efebe9;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    @media (max-width: 600px) {
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+        font-size: 0.85rem;
+      }
+
+      .nutrition-table caption {
+        font-size: 1.1rem;
+        padding: 14px 12px 10px;
+      }
+
+      .nutrition-table tbody th[scope="row"] {
+        box-shadow: 2px 0 4px rgba(0, 0, 0, 0.06);
+      }
+    }
