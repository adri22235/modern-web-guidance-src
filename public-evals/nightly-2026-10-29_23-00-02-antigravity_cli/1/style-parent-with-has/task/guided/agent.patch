       background: #3e2723;
     }
 
+    /* Contact Form */
+    .contact-section {
+      max-width: 600px;
+      margin-block: 3rem;
+      margin-inline: auto;
+      padding-inline: 20px;
+    }
+
+    .contact-form {
+      background: white;
+      padding: 2rem;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .contact-form fieldset {
+      border: none;
+    }
+
+    .contact-form legend {
+      font-size: 1.5rem;
+      font-weight: bold;
+      color: var(--primary);
+      margin-block-end: 1.25rem;
+      text-align: center;
+      width: 100%;
+    }
+
+    .field {
+      padding: 1rem;
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      margin-block-end: 1.25rem;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    .field:has(:user-invalid) {
+      border-color: var(--error);
+      background-color: var(--error-surface);
+    }
+
+    .field:has(:user-valid) {
+      border-color: var(--success);
+    }
+
+    .field label {
+      display: inline-block;
+      font-weight: 600;
+      padding: 10px 0;
+      margin: -10px 0 0.25rem;
+    }
+
+    .hint {
+      display: block;
+      color: var(--muted);
+      font-size: 0.85rem;
+      margin-block-end: 0.25rem;
+    }
+
+    .field :where(input, textarea) {
+      width: 100%;
+      font-family: inherit;
+      font-size: 1rem;
+      line-height: 1.5;
+      padding: 0.75rem;
+      min-height: 48px;
+      border: 1px solid var(--border);
+      border-radius: 4px;
+      color: var(--text);
+      background-color: white;
+    }
+
+    .field textarea {
+      resize: vertical;
+      min-height: 120px;
+    }
+
+    @media (pointer: coarse) {
+      .field input,
+      .btn {
+        min-height: 52px;
+      }
+    }
+
+    .field :where(input, textarea):focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .field :where(input, textarea):user-invalid {
+      border-color: var(--error);
+      background-color: var(--error-bg);
+    }
+
+    .field :where(input, textarea):user-valid {
+      border-color: var(--success);
+    }
+
+    .error-msg {
+      display: none;
+      color: var(--error);
+      font-size: 0.875rem;
+      margin-block-start: 0.35rem;
+    }
+
+    .field :where(input, textarea):user-invalid + .error-msg {
+      display: block;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
