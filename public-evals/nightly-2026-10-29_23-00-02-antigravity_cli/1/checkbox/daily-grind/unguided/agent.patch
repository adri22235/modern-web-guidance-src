+
+    /* Visually hidden native checkbox while preserving full keyboard, focus, and screen-reader accessibility */
+    .custom-checkbox input[type="checkbox"] {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .checkbox-left {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-width: 0;
+    }
+
+    /* Custom Checkbox Box & Check/Uncheck Animation */
+    .checkbox-control {
+      width: 20px;
+      height: 20px;
+      flex-shrink: 0;
+      border: 2px solid #8d6e63;
+      border-radius: 5px;
+      background-color: var(--light);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      transition: background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
+        box-shadow 0.2s ease;
+    }
+
+    .checkbox-control svg {
+      width: 13px;
+      height: 13px;
+      fill: none;
+      stroke: white;
+      stroke-width: 2.6;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      opacity: 0;
+      transform: scale(0.6);
+      transition: stroke-dashoffset 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        opacity 0.2s ease,
+        transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option-icon {
+      width: 16px;
+      height: 16px;
+      flex-shrink: 0;
+      color: #8d6e63;
+      transition: color 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .checkbox-text {
+      font-size: 0.88rem;
+      color: var(--text);
+      font-weight: 500;
+      transition: color 0.2s ease, font-weight 0.2s ease;
+    }
+
+    .checkbox-price {
+      font-size: 0.78rem;
+      font-weight: 600;
+      color: #6d4c41;
+      background-color: var(--secondary);
+      padding: 2px 7px;
+      border-radius: 999px;
+      flex-shrink: 0;
+      transition: background-color 0.25s ease, color 0.25s ease;
+    }
+
+    /* Checked states & animations */
+    .custom-checkbox:has(input[type="checkbox"]:checked) {
+      background-color: #fff8ef;
+      border-color: var(--accent);
+      box-shadow: 0 2px 6px rgba(255, 171, 64, 0.18);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-control {
+      background-color: var(--primary);
+      border-color: var(--primary);
+      transform: scale(1.06);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-control svg {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .option-icon {
+      color: var(--accent);
+      transform: scale(1.12) rotate(-6deg);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-text {
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-price {
+      background-color: var(--accent);
+      color: var(--text);
+    }
+
+    /* Keyboard focus accessibility */
+    .custom-checkbox input[type="checkbox"]:focus-visible ~ .checkbox-left .checkbox-control {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.25);
+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:focus-visible) {
+      border-color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .custom-checkbox,
+      .checkbox-control,
+      .checkbox-control svg,
+      .option-icon,
+      .checkbox-text,
+      .checkbox-price {
+        transition: none;
+      }
+    }
