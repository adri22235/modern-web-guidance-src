new file mode 100644
index 0000000..b905d31
--- /dev/null
+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,291 @@
+import React, { useState, useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleUtilityProps {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  initialIsBookmarked: boolean;
+}
+
+const FONT_SIZES = ['small', 'medium', 'large', 'xlarge'] as const;
+type FontSizeOption = (typeof FONT_SIZES)[number];
+
+const FONT_SIZE_CLASSES: Record<FontSizeOption, string> = {
+  small: 'prose-sm',
+  medium: 'prose-base',
+  large: 'prose-lg',
+  xlarge: 'prose-xl',
+};
+
+const SHARE_PLATFORMS = ['copy', 'x', 'facebook', 'whatsapp', 'email'] as const;
+type SharePlatform = (typeof SHARE_PLATFORMS)[number];
+
+export default function ArticleUtilities({
+  slug,
+  title,
+  summary,
+  author,
+  date,
+  category,
+  readingTime,
+  initialIsBookmarked,
+}: ArticleUtilityProps) {
+  const [fontSize, setFontSize] = useState<FontSizeOption>('medium');
+  const [shareStatus, setShareStatus] = useState<string | null>(null);
+  const [isBookmarked, setIsBookmarked] = useState(initialIsBookmarked);
+
+  useEffect(() => {
+    const handleCustomUpdate = (event: Event) => {
+      const customEvent = event as CustomEvent<{ readingList?: string[] }>;
+      if (customEvent.detail?.readingList) {
+        setIsBookmarked(customEvent.detail.readingList.includes(slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleCustomUpdate);
+    return () => {
+      window.removeEventListener('reading-list-updated', handleCustomUpdate);
+    };
+  }, [slug]);
+
+  const applyFontSize = (size: FontSizeOption) => {
+    setFontSize(size);
+    const bodyEl = document.getElementById('article-body-content');
+    if (bodyEl) {
+      Object.values(FONT_SIZE_CLASSES).forEach((cls) => bodyEl.classList.remove(cls));
+      bodyEl.classList.add(FONT_SIZE_CLASSES[size]);
+    }
+  };
+
+  // 1. Read-only tool: get_article_details
+  useWebMCP<{ includeFullText?: boolean }>({
+    name: 'get_article_details',
+    description: 'Extract metadata, reading statistics, and body text for the article currently displayed on the page.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        includeFullText: {
+          type: 'boolean',
+          default: true,
+          description: 'Whether to include the full plain-text content of the article body.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute(input) {
+      const includeFullText = input?.includeFullText ?? true;
+      const bodyEl = document.getElementById('article-body-content');
+      const fullText = bodyEl ? bodyEl.innerText.trim() : '';
+      const words = fullText ? fullText.split(/\s+/).filter(Boolean).length : 0;
+      const headings = bodyEl
+        ? Array.from(bodyEl.querySelectorAll('h1, h2, h3, h4')).map((h) => h.textContent?.trim() || '')
+        : [];
+
+      return {
+        slug,
+        title,
+        summary,
+        author,
+        date,
+        category,
+        wordCount: words,
+        estimatedReadingTimeMinutes: readingTime ?? Math.max(1, Math.ceil(words / 200)),
+        isBookmarked,
+        fontSize,
+        headings,
+        ...(includeFullText ? { content: fullText } : {}),
+      };
+    },
+  });
+
+  // 2. Client-side utility tool: bookmark_current_article
+  useWebMCP<{ action?: 'add' | 'remove' | 'toggle' }>({
+    name: 'bookmark_current_article',
+    description: 'Save, remove, or toggle the currently open article in the user reading list.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        action: {
+          type: 'string',
+          enum: ['add', 'remove', 'toggle'],
+          default: 'toggle',
+          description: 'Action to perform on the current article bookmark state.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    async execute(input, { signal }) {
+      const action = input?.action ?? 'toggle';
+      if (!['add', 'remove', 'toggle'].includes(action)) {
+        return {
+          error: 'Unsupported bookmark action.',
+          supportedActions: ['add', 'remove', 'toggle'],
+        };
+      }
+
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug, action }),
+          signal,
+        });
+
+        if (!response.ok) {
+          return { error: `Failed to update bookmark: ${response.status}` };
+        }
+
+        const data = await response.json();
+        const updatedList: string[] = data.readingList || [];
+        const nowBookmarked = updatedList.includes(slug);
+        setIsBookmarked(nowBookmarked);
+        window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList: updatedList } }));
+
+        return {
+          slug,
+          title,
+          action,
+          isBookmarked: nowBookmarked,
+          readingList: updatedList,
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  // 3. Client-side utility tool: set_article_text_size
+  useWebMCP<{ size: FontSizeOption }>({
+    name: 'set_article_text_size',
+    description: 'Adjust the typography font size of the article body for comfortable reading.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        size: {
+          type: 'string',
+          enum: FONT_SIZES,
+          default: 'medium',
+          description: 'Desired reading font size for the article body text.',
+        },
+      },
+      required: ['size'],
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    execute(input) {
+      const size = (input?.size ?? 'medium') as FontSizeOption;
+      if (!FONT_SIZES.includes(size)) {
+        return {
+          error: 'Unsupported font size.',
+          supportedSizes: FONT_SIZES,
+        };
+      }
+      applyFontSize(size);
+      return {
+        slug,
+        fontSize: size,
+        appliedClass: FONT_SIZE_CLASSES[size],
+      };
+    },
+  });
+
+  // 4. Client-side utility tool: share_article
+  useWebMCP<{ platform?: SharePlatform }>({
+    name: 'share_article',
+    description: 'Generate a shareable link or copy the current article citation and URL to the clipboard.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        platform: {
+          type: 'string',
+          enum: SHARE_PLATFORMS,
+          default: 'copy',
+          description: 'Target channel for sharing the article.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    async execute(input) {
+      const platform = (input?.platform ?? 'copy') as SharePlatform;
+      if (!SHARE_PLATFORMS.includes(platform)) {
+        return {
+          error: 'Unsupported share platform.',
+          supportedPlatforms: SHARE_PLATFORMS,
+        };
+      }
+
+      const url = window.location.href;
+      const shareText = `${title} — ${summary}`;
+      let shareUrl = url;
+
+      if (platform === 'x') {
+        shareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(url)}`;
+      } else if (platform === 'facebook') {
+        shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
+      } else if (platform === 'whatsapp') {
+        shareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${shareText} ${url}`)}`;
+      } else if (platform === 'email') {
+        shareUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${shareText}\n\n${url}`)}`;
+      } else {
+        try {
+          if (navigator.clipboard?.writeText) {
+            await navigator.clipboard.writeText(url);
+          }
+        } catch {
+          // Ignore clipboard permission errors in automated contexts
+        }
+      }
+
+      setShareStatus(platform === 'copy' ? 'Link copied!' : `Ready to share via ${platform}`);
+      setTimeout(() => setShareStatus(null), 3000);
+
+      return {
+        slug,
+        title,
+        platform,
+        articleUrl: url,
+        shareUrl,
+        citation: `${author}. "${title}." The DevTools Times, ${date}. ${url}`,
+      };
+    },
+  });
+
+  return (
+    <div className="flex flex-wrap items-center gap-2 text-xs text-gray-600">
+      <span className="font-semibold text-gray-800">Text size:</span>
+      <div className="inline-flex rounded-md border border-gray-200 bg-gray-50 p-0.5">
+        {FONT_SIZES.map((size) => (
+          <button
+            key={size}
+            type="button"
+            onClick={() => applyFontSize(size)}
+            className={`px-2 py-1 rounded capitalize transition-colors ${
+              fontSize === size ? 'bg-white text-gray-900 shadow-xs font-semibold' : 'text-gray-600 hover:text-gray-900'
+            }`}
+          >
+            {size}
+          </button>
+        ))}
+      </div>
+      {shareStatus && (
+        <span className="text-amber-700 font-medium ml-2" role="status">
+          {shareStatus}
+        </span>
+      )}
+    </div>
+  );
+}
