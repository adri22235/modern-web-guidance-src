diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..344a230
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,151 @@
+import type { ModelContext, ModelContextTool } from '../../global';
+
+const registeredToolsRegistry = new Map<string, ModelContextTool<any, any>>();
+
+/**
+ * Ensures `navigator.modelContext` is available in the browser environment.
+ * If the browser provides a native implementation, it is preserved and augmented
+ * cleanly; otherwise, a spec-compliant shim is installed on `navigator.modelContext`.
+ */
+export function ensureModelContext(): ModelContext | undefined {
+  if (typeof window === 'undefined' || typeof navigator === 'undefined') {
+    return undefined;
+  }
+
+  if (!('modelContext' in navigator) || !navigator.modelContext) {
+    const contextShim: ModelContext = {
+      tools: registeredToolsRegistry,
+      registerTool(tool: ModelContextTool<any, any>, options?: { signal?: AbortSignal }) {
+        if (!tool || !tool.name) return;
+        registeredToolsRegistry.set(tool.name, tool);
+        if (options?.signal) {
+          options.signal.addEventListener(
+            'abort',
+            () => {
+              registeredToolsRegistry.delete(tool.name);
+            },
+            { once: true }
+          );
+        }
+      },
+      unregisterTool(name: string) {
+        registeredToolsRegistry.delete(name);
+      },
+      provideContext(context: { tools: ModelContextTool<any, any>[] }) {
+        registeredToolsRegistry.clear();
+        if (Array.isArray(context?.tools)) {
+          for (const tool of context.tools) {
+            if (tool?.name) {
+              registeredToolsRegistry.set(tool.name, tool);
+            }
+          }
+        }
+      },
+      clearContext() {
+        registeredToolsRegistry.clear();
+      },
+      listTools() {
+        return Array.from(registeredToolsRegistry.values());
+      },
+      async executeTool(name: string, input: Record<string, any> = {}) {
+        const tool = registeredToolsRegistry.get(name);
+        if (!tool) {
+          throw new Error(`WebMCP tool "${name}" is not registered.`);
+        }
+        return await tool.execute(input);
+      },
+    };
+
+    try {
+      Object.defineProperty(navigator, 'modelContext', {
+        value: contextShim,
+        configurable: true,
+        writable: true,
+      });
+    } catch {
+      (navigator as any).modelContext = contextShim;
+    }
+  }
+
+  return navigator.modelContext;
+}
+
+/**
+ * Registers a single WebMCP tool via `navigator.modelContext.registerTool`
+ * and returns a cleanup function to unregister it.
+ */
+export function registerWebMCPTool<TInput = Record<string, any>, TOutput = any>(
+  tool: ModelContextTool<TInput, TOutput>
+): () => void {
+  const mc = ensureModelContext();
+  if (!mc) {
+    return () => {};
+  }
+
+  const controller = new AbortController();
+  registeredToolsRegistry.set(tool.name, tool);
+
+  try {
+    if (typeof mc.unregisterTool === 'function') {
+      try {
+        mc.unregisterTool(tool.name);
+      } catch {
+        // Ignore if tool wasn't previously registered
+      }
+    }
+
+    if (typeof mc.registerTool === 'function') {
+      mc.registerTool(tool, { signal: controller.signal });
+    } else if (typeof mc.provideContext === 'function') {
+      mc.provideContext({ tools: Array.from(registeredToolsRegistry.values()) });
+    }
+  } catch (err) {
+    // Some native implementations throw if a tool with the same name is already registered
+    console.warn(`WebMCP registerTool warning for "${tool.name}":`, err);
+  }
+
+  return () => {
+    controller.abort();
+    registeredToolsRegistry.delete(tool.name);
+    try {
+      if (typeof mc.unregisterTool === 'function') {
+        mc.unregisterTool(tool.name);
+      }
+    } catch {
+      // Ignore cleanup errors
+    }
+  };
+}
+
+/**
+ * Formats a tool output payload so it works for both MCP-style content consumers
+ * (`{ content: [{ type: 'text', text: ... }] }`) and direct structured-object consumers.
+ */
+export function formatToolResponse<T extends Record<string, any>>(
+  data: T,
+  summaryText?: string
+): T & { content: Array<{ type: 'text'; text: string }> } {
+  const text = summaryText ?? JSON.stringify(data, null, 2);
+  return {
+    ...data,
+    content: [{ type: 'text', text }],
+  };
+}
+
+/**
+ * Attaches or handles a WebMCP declarative `<form>` submission, invoking `event.respondWith`
+ * when available on the `SubmitEvent`.
+ */
+export function respondWithWebMCP(
+  event: Event | React.FormEvent<HTMLFormElement>,
+  resultPromise: Promise<any>
+): void {
+  const nativeEvent = ('nativeEvent' in event ? event.nativeEvent : event) as SubmitEvent;
+  if (nativeEvent && typeof nativeEvent.respondWith === 'function') {
+    try {
+      nativeEvent.respondWith(resultPromise);
+    } catch (err) {
+      console.warn('Failed to call SubmitEvent.respondWith:', err);
+    }
+  }
+}
