+import React, { useState, useEffect, useCallback } from 'react';
+import { formatToolResponse, registerWebMCPTool, respondWithWebMCP } from '../utils/webmcp';
+
+export interface ArticleMetadata {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+}
+
+interface RelatedArticleItem {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+}
+
+interface Props {
+  article: ArticleMetadata;
+  relatedArticles?: RelatedArticleItem[];
+  articleBodySelector?: string;
+}
+
+type FontSizeOption = 'small' | 'medium' | 'large' | 'xlarge';
+type ThemeOption = 'default' | 'sepia' | 'high-contrast';
+type LineSpacingOption = 'normal' | 'relaxed' | 'loose';
+type CitationFormat = 'apa' | 'mla' | 'chicago' | 'markdown';
+
+const FONT_SIZE_CLASSES: Record<FontSizeOption, string> = {
+  small: 'text-sm',
+  medium: 'text-base',
+  large: 'text-lg',
+  xlarge: 'text-xl',
+};
+
+const THEME_STYLES: Record<ThemeOption, { backgroundColor: string; color: string; padding: string; borderRadius: string }> = {
+  default: { backgroundColor: 'transparent', color: 'inherit', padding: '0', borderRadius: '0' },
+  sepia: { backgroundColor: '#fdf6e3', color: '#3b2f2f', padding: '1.25rem', borderRadius: '0.5rem' },
+  'high-contrast': { backgroundColor: '#111827', color: '#f9fafb', padding: '1.25rem', borderRadius: '0.5rem' },
+};
+
+const LINE_SPACING_VALUES: Record<LineSpacingOption, string> = {
+  normal: '1.6',
+  relaxed: '1.85',
+  loose: '2.15',
+};
+
+export default function ArticleUtilities({
+  article,
+  relatedArticles = [],
+  articleBodySelector = '#article-body-content',
+}: Props) {
+  const [fontSize, setFontSize] = useState<FontSizeOption>('medium');
+  const [theme, setTheme] = useState<ThemeOption>('default');
+  const [lineSpacing, setLineSpacing] = useState<LineSpacingOption>('normal');
+  const [highlightQuery, setHighlightQuery] = useState('');
+  const [highlightCount, setHighlightCount] = useState<number | null>(null);
+  const [wordsPerMinute, setWordsPerMinute] = useState<number>(200);
+  const [wordCount, setWordCount] = useState<number>(0);
+  const [citationFormat, setCitationFormat] = useState<CitationFormat>('apa');
+  const [generatedCitation, setGeneratedCitation] = useState<string>('');
+  const [activePanel, setActivePanel] = useState<'none' | 'preferences' | 'highlight' | 'cite'>('none');
+
+  const getBodyElement = useCallback((): HTMLElement | null => {
+    if (typeof document === 'undefined') return null;
+    return (
+      document.querySelector<HTMLElement>(articleBodySelector) ||
+      document.querySelector<HTMLElement>('article .prose')
+    );
+  }, [articleBodySelector]);
+
+  const extractDomDetails = useCallback(() => {
+    const bodyEl = getBodyElement();
+    const rawText = bodyEl ? (bodyEl.innerText || bodyEl.textContent || '').trim() : '';
+    const words = rawText ? rawText.split(/\s+/).filter(Boolean) : [];
+    const headings = bodyEl
+      ? Array.from(bodyEl.querySelectorAll('h1, h2, h3, h4, h5, h6')).map(
+          h => (h.textContent || '').trim()
+        )
+      : [];
+    const paragraphs = bodyEl
+      ? Array.from(bodyEl.querySelectorAll('p'))
+          .map(p => (p.textContent || '').trim())
+          .filter(Boolean)
+      : [];
+
+    return {
+      text: rawText,
+      wordCount: words.length,
+      headings,
+      paragraphs,
+    };
+  }, [getBodyElement]);
+
+  useEffect(() => {
+    const { wordCount: count } = extractDomDetails();
+    setWordCount(count);
+  }, [extractDomDetails]);
+
+  const applyReadingPreferences = useCallback(
+    (
+      nextFontSize: FontSizeOption,
+      nextTheme: ThemeOption,
+      nextLineSpacing: LineSpacingOption
+    ) => {
+      setFontSize(nextFontSize);
+      setTheme(nextTheme);
+      setLineSpacing(nextLineSpacing);
+
+      const bodyEl = getBodyElement();
+      if (bodyEl) {
+        Object.values(FONT_SIZE_CLASSES).forEach(cls => bodyEl.classList.remove(cls));
+        bodyEl.classList.add(FONT_SIZE_CLASSES[nextFontSize]);
+
+        const themeStyle = THEME_STYLES[nextTheme];
+        bodyEl.style.backgroundColor = themeStyle.backgroundColor;
+        bodyEl.style.color = themeStyle.color;
+        bodyEl.style.padding = themeStyle.padding;
+        bodyEl.style.borderRadius = themeStyle.borderRadius;
+        bodyEl.style.lineHeight = LINE_SPACING_VALUES[nextLineSpacing];
+        bodyEl.dataset.fontSize = nextFontSize;
+        bodyEl.dataset.theme = nextTheme;
+        bodyEl.dataset.lineSpacing = nextLineSpacing;
+      }
+
+      return formatToolResponse(
+        {
+          slug: article.slug,
+          fontSize: nextFontSize,
+          theme: nextTheme,
+          lineSpacing: nextLineSpacing,
+        },
+        `Updated article reading preferences: fontSize=${nextFontSize}, theme=${nextTheme}, lineSpacing=${nextLineSpacing}.`
+      );
+    },
+    [article.slug, getBodyElement]
+  );
+
+  const clearHighlights = useCallback(() => {
+    const bodyEl = getBodyElement();
+    if (!bodyEl) return;
+    const marks = bodyEl.querySelectorAll('mark.webmcp-highlight');
+    marks.forEach(mark => {
+      const parent = mark.parentNode;
+      if (parent) {
+        parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+        parent.normalize();
+      }
+    });
+  }, [getBodyElement]);
+
+  const highlightTextInArticle = useCallback(
+    (rawQuery: string, scrollToFirst = true) => {
+      clearHighlights();
+      const query = (rawQuery || '').trim();
+      setHighlightQuery(query);
+
+      if (!query) {
+        setHighlightCount(null);
+        return formatToolResponse(
+          {
+            slug: article.slug,
+            query: '',
+            matchCount: 0,
+            snippets: [],
+          },
+          'Cleared all article text highlights.'
+        );
+      }
+
+      const bodyEl = getBodyElement();
+      if (!bodyEl) {
+        return formatToolResponse(
+          {
+            slug: article.slug,
+            query,
+            matchCount: 0,
+            snippets: [],
+          },
+          'Article body element not found.'
+        );
+      }
+
+      const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      const regex = new RegExp(`(${escapedQuery})`, 'gi');
+
+      const walker = document.createTreeWalker(bodyEl, NodeFilter.SHOW_TEXT, {
+        acceptNode(node) {
+          const parentTag = node.parentElement?.tagName.toLowerCase();
+          if (parentTag === 'script' || parentTag === 'style' || parentTag === 'mark') {
+            return NodeFilter.FILTER_REJECT;
+          }
+          if (node.nodeValue && regex.test(node.nodeValue)) {
+            regex.lastIndex = 0;
+            return NodeFilter.FILTER_ACCEPT;
+          }
+          return NodeFilter.FILTER_SKIP;
+        },
+      });
+
+      const textNodes: Text[] = [];
+      let currentNode = walker.nextNode();
+      while (currentNode) {
+        textNodes.push(currentNode as Text);
+        currentNode = walker.nextNode();
+      }
+
+      let matchCount = 0;
+      const snippetsSet = new Set<string>();
+
+      textNodes.forEach(textNode => {
+        const text = textNode.nodeValue || '';
+        const parts = text.split(regex);
+        if (parts.length <= 1) return;
+
+        if (textNode.parentElement) {
+          snippetsSet.add((textNode.parentElement.textContent || '').trim());
+        }
+
+        const fragment = document.createDocumentFragment();
+        parts.forEach(part => {
+          if (part.toLowerCase() === query.toLowerCase()) {
+            matchCount += 1;
+            const mark = document.createElement('mark');
+            mark.className = 'webmcp-highlight bg-amber-200 text-gray-900 px-0.5 rounded';
+            mark.textContent = part;
+            fragment.appendChild(mark);
+          } else if (part) {
+            fragment.appendChild(document.createTextNode(part));
+          }
+        });
+
+        textNode.parentNode?.replaceChild(fragment, textNode);
+      });
+
+      setHighlightCount(matchCount);
+
+      if (scrollToFirst && matchCount > 0) {
+        const firstMark = bodyEl.querySelector<HTMLElement>('mark.webmcp-highlight');
+        firstMark?.scrollIntoView({ behavior: 'smooth', block: 'center' });
+      }
+
+      const snippets = Array.from(snippetsSet).slice(0, 5);
+
+      return formatToolResponse(
+        {
+          slug: article.slug,
+          query,
+          matchCount,
+          snippets,
+        },
+        `Highlighted ${matchCount} occurrence(s) of "${query}" in "${article.title}".`
+      );
+    },
+    [article.slug, article.title, clearHighlights, getBodyElement]
+  );
+
+  const buildCitation = useCallback(
+    (format: CitationFormat = 'apa') => {
+      const url =
+        typeof window !== 'undefined'
+          ? window.location.href
+          : `${import.meta.env.BASE_URL}articles/${article.slug}`;
+      const pubDate = new Date(article.date);
+      const year = isNaN(pubDate.getFullYear()) ? new Date().getFullYear() : pubDate.getFullYear();
+      const formattedDate = isNaN(pubDate.getTime())
+        ? article.date
+        : pubDate.toLocaleDateString('en-US', {
+            year: 'numeric',
+            month: 'long',
+            day: 'numeric',
+          });
+
+      let citation = '';
+      switch (format) {
+        case 'mla':
+          citation = `${article.author}. "${article.title}." The DevTools Times, ${formattedDate}, ${url}.`;
+          break;
+        case 'chicago':
+          citation = `${article.author}. "${article.title}." The DevTools Times (${formattedDate}). ${url}.`;
+          break;
+        case 'markdown':
+          citation = `[${article.title}](${url}) — *${article.author}*, The DevTools Times (${formattedDate})`;
+          break;
+        case 'apa':
+        default:
+          citation = `${article.author}. (${year}, ${formattedDate}). ${article.title}. The DevTools Times. ${url}`;
+          break;
+      }
+
+      setCitationFormat(format);
+      setGeneratedCitation(citation);
+
+      return formatToolResponse(
+        {
+          slug: article.slug,
+          title: article.title,
+          author: article.author,
+          date: formattedDate,
+          format,
+          citation,
+          url,
+        },
+        citation
+      );
+    },
+    [article.author, article.date, article.slug, article.title]
+  );
+
+  const computeReadingTime = useCallback(
+    (wpm = 200) => {
+      const safeWpm = Math.max(50, Math.min(1000, Number(wpm) || 200));
+      setWordsPerMinute(safeWpm);
+      const details = extractDomDetails();
+      const totalWords = details.wordCount;
+      setWordCount(totalWords);
+
+      const exactMinutes = totalWords / safeWpm;
+      const estimatedMinutes = Math.max(1, Math.ceil(exactMinutes));
+      const estimatedSeconds = Math.round(exactMinutes * 60);
+
+      return formatToolResponse(
+        {
+          slug: article.slug,
+          title: article.title,
+          wordCount: totalWords,
+          wordsPerMinute: safeWpm,
+          estimatedMinutes,
+          estimatedSeconds,
+          formattedTime: `${estimatedMinutes} min read (${totalWords} words at ${safeWpm} WPM)`,
+        },
+        `Estimated reading time for "${article.title}": ${estimatedMinutes} min (${totalWords} words at ${safeWpm} WPM).`
+      );
+    },
+    [article.slug, article.title, extractDomDetails]
+  );
+
+  useEffect(() => {
+    const unregisters = [
+      registerWebMCPTool({
+        name: 'get_article_info',
+        description:
+          'Get structured metadata, section headings, word count, related articles, and plain-text content for the current article.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            includeFullText: {
+              type: 'boolean',
+              description: 'Whether to include the full plain-text body of the article (default: true).',
+            },
+          },
+        },
+        annotations: {
+          title: 'Get Current Article Info',
+          readOnlyHint: true,
+          idempotentHint: true,
+        },
+        execute: async (input?: { includeFullText?: boolean }) => {
+          const includeFullText = input?.includeFullText !== false;
+          const details = extractDomDetails();
+          const url =
+            typeof window !== 'undefined'
+              ? window.location.href
+              : `${import.meta.env.BASE_URL}articles/${article.slug}`;
+
+          return formatToolResponse(
+            {
+              slug: article.slug,
+              title: article.title,
+              summary: article.summary,
+              author: article.author,
+              date: article.date,
+              category: article.category,
+              readingTime: article.readingTime,
+              tags: article.tags || [],
+              wordCount: details.wordCount,
+              headings: details.headings,
+              paragraphs: includeFullText ? details.paragraphs : undefined,
+              text: includeFullText ? details.text : undefined,
+              relatedArticles,
+              url,
+            },
+            `"${article.title}" by ${article.author} (${article.category}) — ${details.wordCount} words.`
+          );
+        },
+      }),
+
+      registerWebMCPTool({
+        name: 'estimate_reading_time',
+        description:
+          'Calculate the word count and estimated reading time of the current article at a customizable words-per-minute speed.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            wordsPerMinute: {
+              type: 'number',
+              description: 'Reading speed in words per minute (default: 200).',
+            },
+          },
+        },
+        annotations: {
+          title: 'Estimate Article Reading Time',
+          readOnlyHint: true,
+          idempotentHint: true,
+        },
+        execute: async (input?: { wordsPerMinute?: number }) => {
+          return computeReadingTime(input?.wordsPerMinute ?? 200);
+        },
+      }),
+
+      registerWebMCPTool({
+        name: 'highlight_article_text',
+        description:
+          'Find and highlight occurrences of a word or phrase inside the current article body, or clear existing highlights.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            query: {
+              type: 'string',
+              description:
+                'Word or phrase to highlight inside the article body. Pass an empty string to clear highlights.',
+            },
+            scrollToFirst: {
+              type: 'boolean',
+              description: 'Whether to scroll the first highlighted match into view (default: true).',
+            },
+          },
+          required: ['query'],
+        },
+        annotations: {
+          title: 'Highlight Article Text',
+          readOnlyHint: false,
+          idempotentHint: true,
+        },
+        execute: async (input: { query: string; scrollToFirst?: boolean }) => {
+          return highlightTextInArticle(input?.query || '', input?.scrollToFirst !== false);
+        },
+      }),
+
+      registerWebMCPTool({
+        name: 'set_reading_preferences',
+        description:
+          'Adjust client-side reading preferences (font size, color theme, and line spacing) for the current article.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            fontSize: {
+              type: 'string',
+              enum: ['small', 'medium', 'large', 'xlarge'],
+              description: 'Font size for the article body.',
+            },
+            theme: {
+              type: 'string',
+              enum: ['default', 'sepia', 'high-contrast'],
+              description: 'Color theme for reading the article.',
+            },
+            lineSpacing: {
+              type: 'string',
+              enum: ['normal', 'relaxed', 'loose'],
+              description: 'Line spacing for the article text.',
+            },
+          },
+        },
+        annotations: {
+          title: 'Set Article Reading Preferences',
+          readOnlyHint: false,
+          idempotentHint: true,
+        },
+        execute: async (input?: {
+          fontSize?: FontSizeOption;
+          theme?: ThemeOption;
+          lineSpacing?: LineSpacingOption;
+        }) => {
+          return applyReadingPreferences(
+            input?.fontSize || fontSize,
+            input?.theme || theme,
+            input?.lineSpacing || lineSpacing
+          );
+        },
+      }),
+
+      registerWebMCPTool({
+        name: 'cite_article',
+        description:
+          'Generate a formatted citation (APA, MLA, Chicago, or Markdown) and shareable URL for the current article.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            format: {
+              type: 'string',
+              enum: ['apa', 'mla', 'chicago', 'markdown'],
+              description: 'Citation style format (default: apa).',
+            },
+          },
+        },
+        annotations: {
+          title: 'Cite or Share Article',
+          readOnlyHint: true,
+          idempotentHint: true,
+        },
+        execute: async (input?: { format?: CitationFormat }) => {
+          setActivePanel('cite');
+          return buildCitation(input?.format || 'apa');
+        },
+      }),
+
+      registerWebMCPTool({
+        name: 'extract_article_summary',
+        description:
+          'Extract the article summary, section headings, and key sentences from the current article.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            maxSentences: {
+              type: 'number',
+              description: 'Maximum number of key sentences to extract from the article (default: 3).',
+            },
+          },
+        },
+        annotations: {
+          title: 'Extract Article Summary & Key Points',
+          readOnlyHint: true,
+          idempotentHint: true,
+        },
+        execute: async (input?: { maxSentences?: number }) => {
+          const maxSentences = Math.max(1, Number(input?.maxSentences) || 3);
+          const details = extractDomDetails();
+          const sentences = details.text
+            .split(/(?<=[.!?])\s+/)
+            .map(s => s.trim())
+            .filter(Boolean)
+            .slice(0, maxSentences);
+
+          return formatToolResponse(
+            {
+              slug: article.slug,
+              title: article.title,
+              summary: article.summary,
+              headings: details.headings,
+              keySentences: sentences,
+              wordCount: details.wordCount,
+            },
+            `${article.title}: ${article.summary}`
+          );
+        },
+      }),
+    ];
+
+    return () => {
+      unregisters.forEach(fn => fn());
+    };
+  }, [
+    applyReadingPreferences,
+    article,
+    buildCitation,
+    computeReadingTime,
+    extractDomDetails,
+    fontSize,
+    highlightTextInArticle,
+    lineSpacing,
+    relatedArticles,
+    theme,
+  ]);
+
+  const handleHighlightFormSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const formData = new FormData(e.currentTarget);
+    const q = String(formData.get('query') ?? highlightQuery);
+    const result = highlightTextInArticle(q, true);
+    respondWithWebMCP(e, Promise.resolve(result));
+  };
+
+  const handlePreferencesFormSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const formData = new FormData(e.currentTarget);
+    const nextSize = (formData.get('fontSize') as FontSizeOption) || fontSize;
+    const nextTheme = (formData.get('theme') as ThemeOption) || theme;
+    const nextSpacing = (formData.get('lineSpacing') as LineSpacingOption) || lineSpacing;
+    const result = applyReadingPreferences(nextSize, nextTheme, nextSpacing);
+    respondWithWebMCP(e, Promise.resolve(result));
+  };
+
+  const handleCitationFormSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const formData = new FormData(e.currentTarget);
+    const fmt = ((formData.get('format') as CitationFormat) || citationFormat) as CitationFormat;
+    const result = buildCitation(fmt);
+    respondWithWebMCP(e, Promise.resolve(result));
+  };
+
+  const estimatedMins = Math.max(1, Math.ceil((wordCount || 100) / wordsPerMinute));
+
+  return (
+    <div className="my-4 border border-gray-200 rounded-lg bg-gray-50 p-3 text-sm" data-article-utilities>
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <div className="flex items-center space-x-3 text-xs text-gray-600">
+          <span className="font-semibold text-gray-800">Article Tools:</span>
+          <span title="Word count and estimated reading time">
+            {wordCount > 0 ? `${wordCount} words (~${estimatedMins} min read)` : `${article.readingTime || 3} min read`}
+          </span>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2">
+          <button
+            type="button"
+            onClick={() => setActivePanel(activePanel === 'preferences' ? 'none' : 'preferences')}
+            className={`px-2.5 py-1 rounded text-xs font-medium border transition ${
+              activePanel === 'preferences'
+                ? 'bg-gray-800 text-white border-gray-800'
+                : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-100'
+            }`}
+          >
+            Aa Display
+          </button>
+          <button
+            type="button"
+            onClick={() => setActivePanel(activePanel === 'highlight' ? 'none' : 'highlight')}
+            className={`px-2.5 py-1 rounded text-xs font-medium border transition ${
