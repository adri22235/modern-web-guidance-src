+  <script>
+    const SEASONAL_MENU = [
+      {
+        id: "maple-oat-latte",
+        name: "Maple Oat Latte",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        price: 5.50,
+        category: "seasonal",
+        sizes: ["Small", "Medium", "Large"],
+        defaultMilk: "Oat",
+        url: "/menu/seasonal"
+      },
+      {
+        id: "dark-roast-espresso",
+        name: "Dark Roast Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        price: 3.75,
+        category: "espresso",
+        sizes: ["Small", "Medium", "Large"],
+        defaultMilk: "None",
+        url: "/menu/espresso"
+      },
+      {
+        id: "cold-brew",
+        name: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        price: 4.50,
+        category: "cold-brew",
+        sizes: ["Small", "Medium", "Large"],
+        defaultMilk: "None",
+        url: "/menu/cold-brew"
+      }
+    ];
+
+    const SIZES = ["Small", "Medium", "Large"];
+    const MILK_OPTIONS = ["Oat", "Whole", "Almond", "None"];
+    const SIZE_UPCHARGE = { Small: -0.50, Medium: 0, Large: 0.75 };
+
+    const activeOrders = [];
+
+    function findDrink(query) {
+      if (typeof query !== "string" || !query.trim()) return null;
+      const normalized = query.trim().toLowerCase();
+      return SEASONAL_MENU.find(
+        (item) =>
+          item.id === normalized ||
+          item.name.toLowerCase() === normalized ||
+          item.name.toLowerCase().includes(normalized)
+      ) || null;
+    }
+
+    function highlightDrinkCard(drinkId) {
+      const cards = document.querySelectorAll("#menu-grid .card");
+      let matchedCard = null;
+      cards.forEach((card) => {
+        if (card.dataset.drinkId === drinkId) {
+          card.classList.add("highlighted");
+          matchedCard = card;
+        } else {
+          card.classList.remove("highlighted");
+        }
+      });
+      return matchedCard;
+    }
+
+    function updateOrderUI(order) {
+      const statusEl = document.getElementById("order-status");
+      const drinkSelect = document.getElementById("order-drink");
+      const sizeSelect = document.getElementById("order-size");
+      const milkSelect = document.getElementById("order-milk");
+      const qtyInput = document.getElementById("order-quantity");
+
+      if (drinkSelect) drinkSelect.value = order.drink;
+      if (sizeSelect) sizeSelect.value = order.size;
+      if (milkSelect) milkSelect.value = order.milk;
+      if (qtyInput) qtyInput.value = String(order.quantity);
+
+      highlightDrinkCard(order.drinkId);
+
+      if (statusEl) {
+        statusEl.textContent = `Order #${order.orderId} confirmed: ${order.quantity}x ${order.size} ${order.drink} (${order.milk} milk) — Total: $${order.totalPrice.toFixed(2)}`;
+        statusEl.classList.add("visible");
+      }
+    }
+
+    function createOrder({ drink, size = "Medium", milk, quantity = 1 }) {
+      const matched = findDrink(drink);
+      if (!matched) {
+        return {
+          error: `Drink "${drink}" was not found on the Seasonal Favorites menu.`,
+          availableDrinks: SEASONAL_MENU.map((item) => item.name)
+        };
+      }
+
+      if (!SIZES.includes(size)) {
+        return {
+          error: `Unsupported cup size "${size}".`,
+          supportedSizes: SIZES
+        };
+      }
+
+      const resolvedMilk = milk ?? matched.defaultMilk;
+      if (!MILK_OPTIONS.includes(resolvedMilk)) {
+        return {
+          error: `Unsupported milk option "${resolvedMilk}".`,
+          supportedMilkOptions: MILK_OPTIONS
+        };
+      }
+
+      const parsedQty = Number(quantity);
+      if (!Number.isInteger(parsedQty) || parsedQty < 1 || parsedQty > 10) {
+        return {
+          error: "Quantity must be a whole number of cups between 1 and 10."
+        };
+      }
+
+      const unitPrice = +(matched.price + (SIZE_UPCHARGE[size] || 0)).toFixed(2);
+      const totalPrice = +(unitPrice * parsedQty).toFixed(2);
+
+      const order = {
+        orderId: `DG-${1000 + activeOrders.length + 1}`,
+        drinkId: matched.id,
+        drink: matched.name,
+        size,
+        milk: resolvedMilk,
+        quantity: parsedQty,
+        unitPrice,
+        totalPrice,
+        status: "confirmed"
+      };
+
+      activeOrders.push(order);
+      updateOrderUI(order);
+      return order;
+    }
+
+    // Handle Declarative WebMCP Form submissions
+    const orderForm = document.getElementById("drink-order-form");
+    if (orderForm) {
+      orderForm.addEventListener("submit", (event) => {
+        event.preventDefault();
+        const formData = new FormData(orderForm);
+        const result = createOrder({
+          drink: formData.get("drink"),
+          size: formData.get("size") || "Medium",
+          milk: formData.get("milk") || undefined,
+          quantity: Number(formData.get("quantity") || 1)
+        });
+
+        if (event.agentInvoked && typeof event.respondWith === "function") {
+          if (result.error) {
+            event.respondWith(Promise.resolve(`Validation failed: ${result.error}`));
+          } else {
+            event.respondWith(Promise.resolve(result));
+          }
+        }
+      });
+    }
+
+    // Register Imperative WebMCP Tools with feature detection and AbortController cleanup
+    const webMcpController = new AbortController();
+    window.addEventListener("pagehide", () => webMcpController.abort(), { once: true });
+
+    async function registerDailyGrindWebMcpTools() {
+      if (!("modelContext" in document) || !document.modelContext) {
+        return;
+      }
+
+      const registrationOptions = { signal: webMcpController.signal };
+
+      // 1. Read-only tool to query the Seasonal Favorites coffee menu
+      await document.modelContext.registerTool({
+        name: "query_seasonal_menu",
+        description: "Queries the Seasonal Favorites coffee menu. Use when the user asks what drinks are available, wants descriptions or pricing, or searches for a specific coffee drink.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            search: {
+              type: "string",
+              description: "Keyword or drink name to filter the menu items."
+            },
+            maxPrice: {
+              type: "number",
+              minimum: 0,
+              description: "Upper price limit in USD for filtering drinks."
+            }
+          }
+        },
+        execute(input = {}) {
+          const { search, maxPrice } = input || {};
+
+          if (search !== undefined && typeof search !== "string") {
+            return { error: "Provide a text string for the search filter." };
+          }
+          if (maxPrice !== undefined && (typeof maxPrice !== "number" || Number.isNaN(maxPrice) || maxPrice < 0)) {
+            return { error: "Provide a non-negative number for maxPrice." };
+          }
+
+          let results = SEASONAL_MENU;
+          if (search && search.trim()) {
+            const q = search.trim().toLowerCase();
+            results = results.filter(
+              (item) =>
+                item.name.toLowerCase().includes(q) ||
+                item.description.toLowerCase().includes(q) ||
+                item.category.toLowerCase().includes(q)
+            );
+          }
+
+          if (typeof maxPrice === "number") {
+            results = results.filter((item) => item.price <= maxPrice);
+          }
+
+          return {
+            items: results,
+            totalCount: results.length
+          };
+        },
+        annotations: {
+          readOnlyHint: true
+        }
+      }, registrationOptions);
+
+      // 2. Interactive UI update tool to highlight/select a drink on the page
+      await document.modelContext.registerTool({
+        name: "highlight_seasonal_drink",
+        description: "Highlights a Seasonal Favorites coffee card on the page and pre-fills the Quick Drink Order form with that selection. Use when showing or recommending a specific drink to the user.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            drink: {
+              type: "string",
+              enum: SEASONAL_MENU.map((item) => item.name),
+              description: "The seasonal coffee drink to highlight and pre-select in the UI."
+            }
+          },
+          required: ["drink"]
+        },
+        execute(input = {}) {
+          const { drink } = input || {};
+          const matched = findDrink(drink);
+          if (!matched) {
+            return {
+              error: `Drink "${drink}" not found in Seasonal Favorites.`,
+              availableDrinks: SEASONAL_MENU.map((item) => item.name)
+            };
+          }
+
+          const card = highlightDrinkCard(matched.id);
+          const drinkSelect = document.getElementById("order-drink");
+          const milkSelect = document.getElementById("order-milk");
+          if (drinkSelect) drinkSelect.value = matched.name;
+          if (milkSelect) milkSelect.value = matched.defaultMilk;
+
+          if (card && typeof card.scrollIntoView === "function") {
+            card.scrollIntoView({ behavior: "smooth", block: "nearest" });
+          }
+
+          return {
+            highlightedDrink: matched,
+            uiUpdated: true
+          };
+        },
+        annotations: {
+          readOnlyHint: false
+        }
+      }, registrationOptions);
+
+      // 3. Interactive drink order placement tool
+      await document.modelContext.registerTool({
+        name: "order_seasonal_drink",
+        description: "Places an interactive coffee order from the Seasonal Favorites menu and updates the live order confirmation banner on the page. Use when the user wants to order a drink.",
+        inputSchema: {
+          type: "object",
+          properties: {
+            drink: {
+              type: "string",
+              enum: SEASONAL_MENU.map((item) => item.name),
+              description: "The coffee drink to order."
+            },
+            size: {
+              type: "string",
+              enum: SIZES,
+              default: "Medium",
+              description: "Cup size for the drink."
+            },
+            milk: {
+              type: "string",
+              enum: MILK_OPTIONS,
+              description: "Milk or non-dairy option for the drink."
+            },
+            quantity: {
+              type: "integer",
+              minimum: 1,
+              maximum: 10,
+              default: 1,
+              description: "Number of cups to order."
+            }
+          },
+          required: ["drink"]
+        },
+        execute(input = {}) {
+          const { drink, size = "Medium", milk, quantity = 1 } = input || {};
+          return createOrder({ drink, size, milk, quantity });
+        },
+        annotations: {
+          readOnlyHint: false,
+          consequentialHint: true,
+          untrustedContentHint: false
+        }
+      }, registrationOptions);
+
+      // Listen for lifecycle events with backward-compatible target detection
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor("toolactivated", ({ toolName }) => {
+        const statusEl = document.getElementById("order-status");
+        if (statusEl && !statusEl.classList.contains("visible")) {
+          statusEl.textContent = `AI Agent running tool "${toolName}"...`;
+          statusEl.classList.add("visible");
+        }
+      }, registrationOptions);
+
+      targetFor("toolcancel", ({ toolName }) => {
+        const statusEl = document.getElementById("order-status");
+        if (statusEl && statusEl.textContent === `AI Agent running tool "${toolName}"...`) {
+          statusEl.textContent = "";
+          statusEl.classList.remove("visible");
+        }
+      }, registrationOptions);
+    }
+
+    registerDailyGrindWebMcpTools();
+  </script>
+
 </body>
 
