+        }
+
+        // Checkout & Clear buttons
+        const checkoutBtn = document.getElementById('checkout-order-btn');
+        if (checkoutBtn) {
+          checkoutBtn.addEventListener('click', () => {
+            if (navigator.modelContext && typeof navigator.modelContext.callTool === 'function') {
