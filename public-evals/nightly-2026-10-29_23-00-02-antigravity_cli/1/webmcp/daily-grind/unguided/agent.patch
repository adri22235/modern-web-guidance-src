+          });
+        }
+
+        const clearBtn = document.getElementById('clear-order-btn');
+        if (clearBtn) {
+          clearBtn.addEventListener('click', () => {
+            if (navigator.modelContext && typeof navigator.modelContext.callTool === 'function') {
+              navigator.modelContext.callTool('manage_order_cart', { action: 'clear' });
+            }
+          });
+        }
+
+        // Dismiss banner button
+        const closeBannerBtn = document.getElementById('close-status-banner');
+        if (closeBannerBtn) {
+          closeBannerBtn.addEventListener('click', () => {
+            const banner = document.getElementById('live-status-banner');
+            if (banner) banner.classList.remove('active');
+          });
+        }
+
+        // Nav Cart Trigger scrolls to order tray
+        const navCartTrigger = document.getElementById('nav-cart-trigger');
+        if (navCartTrigger) {
+          navCartTrigger.addEventListener('click', () => {
+            const orderSection = document.getElementById('order-section');
+            if (orderSection) orderSection.scrollIntoView({ behavior: 'smooth' });
+          });
+        }
+      }
+
+      // Initialize immediately and on DOMContentLoaded if needed
+      initWebMCP();
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initDomInteractions);
+      } else {
+        initDomInteractions();
+      }
+    })();
+  </script>
