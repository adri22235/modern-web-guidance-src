+          showStatusBanner('Seasonal Favorites UI refreshed.');
+          actionsApplied.push('Refreshed Seasonal Favorites UI');
+        }
+
+        const summary = actionsApplied.join('; ');
+        logAgentEvent(`UI Update: ${summary}`);
+
+        return {
+          success: true,
+          updated: actionsApplied,
+          state: {
+            activeFilter: appState.activeFilter,
+            searchQuery: appState.searchQuery,
+            highlightedDrinkId: appState.highlightedDrinkId,
+            theme: appState.theme
+          }
+        };
+      }
+
+      // Format result as standard MCP / WebMCP tool output
+      function toMcpResponse(payload) {
+        return {
+          ...payload,
+          content: [
+            {
+              type: 'text',
+              text: JSON.stringify(payload, null, 2)
+            }
+          ]
+        };
+      }
+
+      // Define WebMCP Tools Suite
+      const WEBMCP_TOOLS = [
+        {
+          name: 'get_seasonal_menu',
+          description: 'Query The Daily Grind "Seasonal Favorites" coffee menu. Supports optional filtering by search query, category (Latte, Espresso, Cold Brew), dietary tag (e.g., vegan, dairy-free), serving temperature (Hot, Iced), or maximum price.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              query: {
+                type: 'string',
+                description: 'Optional search keyword to match drink name, flavor notes, or ingredients (e.g., "maple", "espresso", "smooth").'
+              },
+              category: {
+                type: 'string',
+                description: 'Optional drink category filter (e.g., "all", "Latte", "Espresso", "Cold Brew").'
+              },
+              dietary: {
+                type: 'string',
+                description: 'Optional dietary or flavor tag filter (e.g., "vegan", "dairy-free", "high-caffeine").'
+              },
+              temperature: {
+                type: 'string',
+                enum: ['Hot', 'Iced'],
+                description: 'Optional serving temperature filter.'
+              },
+              maxPrice: {
+                type: 'number',
+                description: 'Optional maximum base price in USD.'
+              }
+            }
+          },
+          execute: async (params = {}) => toMcpResponse(querySeasonalMenu(params))
+        },
+        {
+          name: 'get_drink_details',
+          description: 'Retrieve full nutritional info, caffeine content, available sizes, milk options, and ingredients for a specific Seasonal Favorites drink, and display its detail panel on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'The drink name or ID (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+              }
+            },
+            required: ['drink']
+          },
+          execute: async (params = {}) => {
+            const drink = findDrink(params.drink || params.name || params.id);
+            if (!drink) {
+              return toMcpResponse({
+                success: false,
+                error: `Drink "${params.drink}" not found in Seasonal Favorites.`,
+                availableDrinks: SEASONAL_MENU.map((d) => d.name)
+              });
+            }
+            highlightDrinkCard(drink.id, true);
+            showStatusBanner(`Viewing details for ${drink.name} ($${drink.basePrice.toFixed(2)})`);
+            logAgentEvent(`Inspected drink details: ${drink.name}`);
+            return toMcpResponse({
+              success: true,
+              drink
+            });
+          }
+        },
+        {
+          name: 'place_drink_order',
+          description: 'Trigger an interactive coffee drink order from the Seasonal Favorites menu and update the active order cart and confirmation UI on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'Name or ID of the seasonal drink to order (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+              },
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size (Small, Medium, or Large). Defaults to Medium.'
+              },
+              temperature: {
+                type: 'string',
+                enum: ['Hot', 'Iced'],
+                description: 'Serving temperature (Hot or Iced).'
+              },
+              milk: {
+                type: 'string',
+                enum: ['Oat', 'Whole', 'Almond', 'Soy', 'None'],
+                description: 'Milk choice (Oat, Whole, Almond, Soy, or None).'
+              },
+              quantity: {
+                type: 'number',
+                description: 'Number of drinks to order (default: 1).'
+              },
+              customerName: {
+                type: 'string',
+                description: 'Optional customer name or pickup note.'
+              },
+              notes: {
+                type: 'string',
+                description: 'Optional customization instructions.'
+              }
+            },
+            required: ['drink']
+          },
+          execute: async (params = {}) => toMcpResponse(placeDrinkOrder(params))
+        },
+        {
+          name: 'update_page_ui',
+          description: 'Trigger interactive UI updates on The Daily Grind homepage, such as highlighting a Seasonal Favorites drink card, filtering the menu grid, displaying a status banner, or switching between light and dark-roast themes.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              highlightDrink: {
+                type: 'string',
+                description: 'Name or ID of a seasonal drink card to highlight on the page.'
+              },
+              showDetails: {
+                type: 'boolean',
+                description: 'Whether to open the detailed specs drawer for the highlighted drink.'
+              },
+              filter: {
+                type: 'string',
+                description: 'Category or tag filter to apply to the Seasonal Favorites grid (e.g., "all", "Latte", "Espresso", "Cold Brew", "vegan").'
+              },
+              query: {
+                type: 'string',
+                description: 'Search text to filter visible menu cards.'
+              },
+              theme: {
+                type: 'string',
+                enum: ['light', 'dark'],
+                description: 'Visual theme ("light" or "dark" roast mode).'
+              },
+              bannerMessage: {
+                type: 'string',
+                description: 'Custom notification message to display in the live status banner.'
+              }
+            }
+          },
+          execute: async (params = {}) => toMcpResponse(triggerUiUpdate(params))
+        },
+        {
+          name: 'manage_order_cart',
+          description: 'Inspect, checkout, or clear the current interactive drink order cart on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              action: {
+                type: 'string',
+                enum: ['view', 'checkout', 'clear'],
+                description: 'Action to perform on the order cart ("view", "checkout", or "clear").'
+              }
+            },
+            required: ['action']
+          },
+          execute: async (params = {}) => {
+            const action = (params.action || 'view').toLowerCase();
+            if (action === 'clear') {
+              appState.cart = [];
+              renderOrderCart();
+              const confirmBox = document.getElementById('order-confirmation-box');
+              if (confirmBox) confirmBox.style.display = 'none';
+              showStatusBanner('Order cart cleared.');
+              logAgentEvent('Cleared order cart');
+              return toMcpResponse({ success: true, action: 'clear', cart: [], cartTotal: 0 });
+            }
+            if (action === 'checkout') {
+              const total = Number(appState.cart.reduce((s, i) => s + i.totalPrice, 0).toFixed(2));
+              const count = appState.cart.reduce((s, i) => s + i.quantity, 0);
+              const receiptId = `RECEIPT-${Date.now().toString().slice(-6)}`;
+              const msg = count > 0
+                ? `Checkout complete (${receiptId})! Brewing ${count} seasonal drink(s) — Total paid: $${total.toFixed(2)}.`
+                : 'Cart is currently empty — add a seasonal drink before checking out.';
+              showStatusBanner(msg);
+              const statusPill = document.getElementById('order-status-pill');
+              if (statusPill && count > 0) statusPill.textContent = `Brewing (${receiptId})`;
+              logAgentEvent(`Completed checkout: ${receiptId} ($${total.toFixed(2)})`);
+              return toMcpResponse({
+                success: count > 0,
+                action: 'checkout',
+                receiptId: count > 0 ? receiptId : null,
+                message: msg,
+                items: [...appState.cart],
+                totalPaid: total
+              });
+            }
+            return toMcpResponse({
+              success: true,
+              action: 'view',
+              items: [...appState.cart],
+              cartCount: appState.cart.reduce((s, i) => s + i.quantity, 0),
+              cartTotal: Number(appState.cart.reduce((s, i) => s + i.totalPrice, 0).toFixed(2))
+            });
+          }
+        }
+      ];
+
+      // Setup / Enhance navigator.modelContext (WebMCP API)
+      function initWebMCP() {
+        const toolRegistry = new Map();
+
+        function normalizeToolDef(toolOrName, maybeExecute) {
+          if (!toolOrName) return null;
+          const execute =
+            typeof toolOrName.execute === 'function'
+              ? toolOrName.execute
+              : typeof toolOrName.handler === 'function'
+              ? toolOrName.handler
+              : typeof maybeExecute === 'function'
+              ? maybeExecute
+              : async () => ({});
+
+          return {
+            name: toolOrName.name,
+            description: toolOrName.description || '',
+            inputSchema: toolOrName.inputSchema || toolOrName.parameters || { type: 'object', properties: {} },
+            execute
+          };
+        }
+
+        // If the browser doesn't natively provide navigator.modelContext, install a compliant implementation
+        if (!('modelContext' in navigator) || !navigator.modelContext) {
+          const modelContextShim = {
+            get tools() {
+              return Array.from(toolRegistry.values());
+            },
+            registerTool(toolDef, executeFn) {
+              const normalized = normalizeToolDef(toolDef, executeFn);
+              if (!normalized || !normalized.name) {
+                throw new Error('WebMCP registerTool requires a valid tool name.');
+              }
+              toolRegistry.set(normalized.name, normalized);
+              return normalized;
+            },
+            unregisterTool(name) {
+              return toolRegistry.delete(name);
+            },
+            provideContext(contextOrTools) {
+              toolRegistry.clear();
+              const list = Array.isArray(contextOrTools)
+                ? contextOrTools
+                : contextOrTools && Array.isArray(contextOrTools.tools)
+                ? contextOrTools.tools
+                : [];
+              list.forEach((t) => {
+                const normalized = normalizeToolDef(t);
+                if (normalized && normalized.name) {
+                  toolRegistry.set(normalized.name, normalized);
+                }
+              });
+            },
+            clearContext() {
+              toolRegistry.clear();
+            },
+            getTools() {
+              return Array.from(toolRegistry.values());
+            },
+            async callTool(name, args = {}) {
+              const tool = toolRegistry.get(name);
+              if (!tool) {
+                throw new Error(`WebMCP tool "${name}" is not registered.`);
+              }
+              return await tool.execute(args);
+            }
+          };
+
+          try {
+            Object.defineProperty(navigator, 'modelContext', {
+              value: modelContextShim,
+              configurable: true,
+              writable: true
+            });
+          } catch (e) {
+            navigator.modelContext = modelContextShim;
+          }
+        }
+
+        const mc = navigator.modelContext;
+
+        // Register all tools via registerTool AND provideContext for maximum compatibility
+        if (typeof mc.registerTool === 'function') {
+          WEBMCP_TOOLS.forEach((tool) => {
+            try {
+              mc.registerTool(tool);
+              toolRegistry.set(tool.name, tool);
+            } catch (err) {
+              toolRegistry.set(tool.name, tool);
+            }
+          });
+        }
+
+        if (typeof mc.provideContext === 'function') {
+          try {
+            mc.provideContext({ tools: WEBMCP_TOOLS });
+          } catch (err) {
+            // Ignore if native provideContext has a different signature
+          }
+        }
+
+        // Ensure helper inspection methods exist even if native/mock modelContext was pre-injected
+        if (!mc.getTools) {
+          mc.getTools = () => Array.from(toolRegistry.values());
+        }
+        if (!mc.callTool) {
+          mc.callTool = async (name, args = {}) => {
+            const tool = toolRegistry.get(name);
+            if (!tool) throw new Error(`WebMCP tool "${name}" not found`);
+            return await tool.execute(args);
+          };
+        }
+
+        // Render registered tool badges in the UI
+        const toolsListEl = document.getElementById('registered-tools-list');
+        if (toolsListEl) {
+          toolsListEl.innerHTML = '';
+          WEBMCP_TOOLS.forEach((tool) => {
+            const badge = document.createElement('span');
+            badge.className = 'tool-tag';
+            badge.textContent = tool.name;
+            badge.title = tool.description;
+            toolsListEl.appendChild(badge);
+          });
+        }
+
+        logAgentEvent(`Registered ${WEBMCP_TOOLS.length} WebMCP tools on navigator.modelContext`);
+      }
+
+      // Wire up interactive DOM event handlers
+      function initDomInteractions() {
+        // Filter chips
+        const filterChips = document.querySelectorAll('#category-filters .filter-chip');
+        filterChips.forEach((chip) => {
+          chip.addEventListener('click', () => {
+            const filterVal = chip.getAttribute('data-filter') || 'all';
+            applyMenuFilter({ category: filterVal, query: appState.searchQuery });
+          });
+        });
+
+        // Search input
+        const searchInput = document.getElementById('menu-search-input');
+        if (searchInput) {
+          searchInput.addEventListener('input', (e) => {
+            applyMenuFilter({ category: appState.activeFilter, query: e.target.value });
+          });
+        }
+
+        // View Details buttons
+        const detailBtns = document.querySelectorAll('.view-details-btn');
+        detailBtns.forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            e.preventDefault();
+            const drinkId = btn.getAttribute('data-drink-id');
+            highlightDrinkCard(drinkId, true);
+          });
+        });
+
+        // Close Details button
+        const closeDetailsBtn = document.getElementById('close-drink-details');
+        if (closeDetailsBtn) {
+          closeDetailsBtn.addEventListener('click', () => {
+            const panel = document.getElementById('drink-details-panel');
+            if (panel) panel.classList.remove('open');
+          });
+        }
+
+        // Quick Order buttons on cards
+        const quickOrderBtns = document.querySelectorAll('.quick-order-btn');
+        quickOrderBtns.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const drinkId = btn.getAttribute('data-drink-id');
+            const drink = findDrink(drinkId);
+            if (drink) {
+              placeDrinkOrder({
+                drink: drink.name,
+                size: 'Medium',
+                temperature: drink.id === 'cold-brew' ? 'Iced' : 'Hot',
+                milk: drink.defaultMilk,
+                quantity: 1
+              });
+            }
+          });
+        });
+
+        // Interactive Order Form submission
+        const orderForm = document.getElementById('drink-order-form');
+        if (orderForm) {
+          orderForm.addEventListener('submit', (e) => {
