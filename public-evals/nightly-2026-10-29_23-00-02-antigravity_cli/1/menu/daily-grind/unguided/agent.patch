+          .filter(Boolean);
+      }
+
+      function closeSubmenus(parentMenuEl) {
+        if (!parentMenuEl) return;
+        const openSubTriggers = parentMenuEl.querySelectorAll('[aria-haspopup="true"][aria-expanded="true"]');
+        openSubTriggers.forEach((trigger) => {
+          trigger.setAttribute('aria-expanded', 'false');
+          const subMenu = trigger.nextElementSibling;
+          if (subMenu && subMenu.getAttribute('role') === 'menu') {
+            subMenu.classList.remove('menu-open');
+          }
+        });
+      }
+
+      function closeAllMenus(exceptRoot = null) {
