+      function openMenu(triggerEl, menuEl, focusFirst = false) {
+        triggerEl.setAttribute('aria-expanded', 'true');
+        menuEl.classList.add('menu-open');
+        if (focusFirst) {
+          const items = getMenuItems(menuEl);
+          if (items.length > 0) items[0].focus();
+        }
+      }
+
+      function closeMenu(triggerEl, menuEl, returnFocus = false) {
+        if (!triggerEl || !menuEl) return;
+        closeSubmenus(menuEl);
+        triggerEl.setAttribute('aria-expanded', 'false');
+        menuEl.classList.remove('menu-open');
+        if (returnFocus) triggerEl.focus();
+      }
+
+      function updateDrinkCardSummary(cardEl) {
+        if (!cardEl) return;
+        const summaryEl = cardEl.querySelector('[data-config-summary]');
+        if (!summaryEl) return;
+
+        const checkedRadios = Array.from(cardEl.querySelectorAll('[role="menuitemradio"][aria-checked="true"]'));
+        const checkedBoxes = Array.from(cardEl.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]'));
+
+        const parts = checkedRadios
+          .map((el) => el.getAttribute('data-option-label'))
+          .filter(Boolean);
+
+        checkedBoxes.forEach((box) => {
+          const label = box.getAttribute('data-option-label');
+          if (label) parts.push('+ ' + label);
+        });
+
+        summaryEl.textContent = parts.join(' · ');
+      }
+
+      function handleItemSelection(itemEl) {
+        const role = itemEl.getAttribute('role');
+        const cardEl = itemEl.closest('[data-drink-card]');
+        const drinkName = cardEl ? cardEl.getAttribute('data-drink-name') : null;
+
+        if (role === 'menuitemradio') {
+          const group = itemEl.getAttribute('data-radio-group');
+          if (group) {
+            const scope = cardEl || itemEl.closest('[data-menu-root]') || document;
+            scope.querySelectorAll(`[role="menuitemradio"][data-radio-group="${group}"]`).forEach((radio) => {
+              radio.setAttribute('aria-checked', 'false');
+            });
+          }
+          itemEl.setAttribute('aria-checked', 'true');
+          if (cardEl) {
+            updateDrinkCardSummary(cardEl);
+            const label = itemEl.getAttribute('data-option-label');
+            showNotification(`${drinkName}: Set to ${label}`);
+          } else if (itemEl.hasAttribute('data-action')) {
+            showNotification(itemEl.getAttribute('data-action'));
+          }
+          return;
+        }
+
+        if (role === 'menuitemcheckbox') {
+          const isChecked = itemEl.getAttribute('aria-checked') === 'true';
+          itemEl.setAttribute('aria-checked', String(!isChecked));
+          if (cardEl) {
+            updateDrinkCardSummary(cardEl);
+            const label = itemEl.getAttribute('data-option-label');
+            showNotification(`${drinkName}: ${!isChecked ? 'Added' : 'Removed'} ${label}`);
+          }
+          return;
+        }
+
+        // Standard menuitem action
+        if (itemEl.hasAttribute('data-card-action') && cardEl) {
+          const actionType = itemEl.getAttribute('data-card-action');
+          const summaryText = cardEl.querySelector('[data-config-summary]')?.textContent.trim() || '';
+          showNotification(`${actionType}: ${drinkName} (${summaryText})`);
+          closeAllMenus();
+        } else if (itemEl.hasAttribute('data-action')) {
+          showNotification(itemEl.getAttribute('data-action'));
+          closeAllMenus();
+        }
+      }
+
+      // Initialize all menu roots
+      document.querySelectorAll('[data-menu-root]').forEach((root) => {
+        const rootTrigger = root.querySelector(':scope > [aria-haspopup="true"]');
+        const rootMenu = root.querySelector(':scope > [role="menu"]');
+
+        if (!rootTrigger || !rootMenu) return;
+
+        rootTrigger.addEventListener('click', (e) => {
+          e.stopPropagation();
+          const isExpanded = rootTrigger.getAttribute('aria-expanded') === 'true';
+          if (isExpanded) {
+            closeMenu(rootTrigger, rootMenu, false);
+          } else {
+            closeAllMenus(root);
+            openMenu(rootTrigger, rootMenu, true);
+          }
+        });
+
+        rootTrigger.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
+            e.preventDefault();
+            closeAllMenus(root);
+            openMenu(rootTrigger, rootMenu, true);
+          } else if (e.key === 'ArrowUp') {
+            e.preventDefault();
+            closeAllMenus(root);
+            openMenu(rootTrigger, rootMenu, false);
+            const items = getMenuItems(rootMenu);
+            if (items.length > 0) items[items.length - 1].focus();
+          }
+        });
+
+        // Submenu hover and click behavior
+        root.querySelectorAll('.submenu-container').forEach((subContainer) => {
+          const subTrigger = subContainer.querySelector(':scope > [role="menuitem"][aria-haspopup="true"]');
+          const subMenu = subContainer.querySelector(':scope > [role="menu"]');
+          if (!subTrigger || !subMenu) return;
+
+          subContainer.addEventListener('mouseenter', () => {
+            const parentMenu = subContainer.parentElement;
+            if (parentMenu) {
+              Array.from(parentMenu.children).forEach((sibling) => {
+                if (sibling !== subContainer) {
+                  const sibTrigger = sibling.querySelector(':scope > [aria-haspopup="true"][aria-expanded="true"]');
+                  const sibMenu = sibling.querySelector(':scope > [role="menu"]');
+                  if (sibTrigger && sibMenu) closeMenu(sibTrigger, sibMenu, false);
+                }
+              });
+            }
+            openMenu(subTrigger, subMenu, false);
+          });
+
+          subContainer.addEventListener('mouseleave', () => {
+            closeMenu(subTrigger, subMenu, false);
+          });
+
+          subTrigger.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const isExpanded = subTrigger.getAttribute('aria-expanded') === 'true';
+            if (isExpanded) {
+              closeMenu(subTrigger, subMenu, true);
+            } else {
+              openMenu(subTrigger, subMenu, true);
+            }
+          });
+        });
+
+        // Click handling on leaf items
+        rootMenu.addEventListener('click', (e) => {
+          const item = e.target.closest('[role="menuitem"], [role="menuitemradio"], [role="menuitemcheckbox"]');
+          if (!item || item.getAttribute('aria-haspopup') === 'true') return;
+          e.stopPropagation();
+          handleItemSelection(item);
+        });
+
+        // Full WAI-ARIA keyboard navigation within menus and nested submenus
+        rootMenu.addEventListener('keydown', (e) => {
+          const currentItem = e.target.closest('[role="menuitem"], [role="menuitemradio"], [role="menuitemcheckbox"]');
+          if (!currentItem) return;
+
+          const currentMenu = currentItem.closest('[role="menu"]');
+          const items = getMenuItems(currentMenu);
+          const idx = items.indexOf(currentItem);
+
+          switch (e.key) {
+            case 'ArrowDown': {
+              e.preventDefault();
+              e.stopPropagation();
+              const nextItem = items[(idx + 1) % items.length];
+              if (nextItem) nextItem.focus();
+              break;
+            }
+            case 'ArrowUp': {
+              e.preventDefault();
+              e.stopPropagation();
+              const prevItem = items[(idx - 1 + items.length) % items.length];
+              if (prevItem) prevItem.focus();
+              break;
+            }
+            case 'Home': {
+              e.preventDefault();
+              e.stopPropagation();
+              if (items[0]) items[0].focus();
+              break;
+            }
+            case 'End': {
+              e.preventDefault();
+              e.stopPropagation();
+              if (items[items.length - 1]) items[items.length - 1].focus();
+              break;
+            }
+            case 'ArrowRight': {
+              if (currentItem.getAttribute('aria-haspopup') === 'true') {
+                e.preventDefault();
+                e.stopPropagation();
+                const subMenu = currentItem.nextElementSibling;
+                if (subMenu && subMenu.getAttribute('role') === 'menu') {
+                  openMenu(currentItem, subMenu, true);
+                }
+              }
+              break;
+            }
+            case 'ArrowLeft': {
+              const parentContainer = currentMenu.parentElement;
+              if (parentContainer && parentContainer.classList.contains('submenu-container')) {
+                e.preventDefault();
+                e.stopPropagation();
+                const parentTrigger = parentContainer.querySelector(':scope > [role="menuitem"][aria-haspopup="true"]');
+                closeMenu(parentTrigger, currentMenu, true);
+              }
+              break;
+            }
+            case 'Escape': {
+              e.preventDefault();
+              e.stopPropagation();
+              const parentContainer = currentMenu.parentElement;
+              if (parentContainer && parentContainer.classList.contains('submenu-container')) {
+                const parentTrigger = parentContainer.querySelector(':scope > [role="menuitem"][aria-haspopup="true"]');
+                closeMenu(parentTrigger, currentMenu, true);
+              } else {
+                closeMenu(rootTrigger, rootMenu, true);
+              }
+              break;
+            }
+            case 'Enter':
+            case ' ': {
+              if (currentItem.getAttribute('aria-haspopup') === 'true') {
+                e.preventDefault();
+                e.stopPropagation();
+                const subMenu = currentItem.nextElementSibling;
+                if (subMenu && subMenu.getAttribute('role') === 'menu') {
+                  openMenu(currentItem, subMenu, true);
+                }
+              } else if (e.key === ' ') {
+                e.preventDefault();
+                e.stopPropagation();
+                handleItemSelection(currentItem);
+              }
+              break;
+            }
+            case 'Tab': {
+              closeAllMenus();
+              break;
+            }
+          }
+        });
+      });
+
+      // Close menus when clicking outside
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('[data-menu-root]')) {
+          closeAllMenus();
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
