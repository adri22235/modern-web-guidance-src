+        menus.forEach(m => {
+          if (!m.parentElement.closest('[popover]') && isOpen(m)) {
+            m.hidePopover();
+          }
+        });
+      }
+
+      // 1. Focusgroup fallback for browsers without native focusgroup support
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+          group.setAttribute('role', 'menu');
+          group.querySelectorAll('button:not([role]), a[href]:not([role])').forEach(item => {
+            item.setAttribute('role', 'menuitem');
+          });
+          group.addEventListener('keydown', event => {
+            if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+            const items = [...group.querySelectorAll('button, a[href]')]
+              .filter(item => item.closest('[focusgroup]') === group)
+              .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+            const current = items.indexOf(document.activeElement);
+            if (current < 0) return;
+            const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+              (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            items[next].focus({ preventScroll: true });
+          }, true);
+        });
+      } else {
+        // Even with native focusgroup, Home and End jump to first and last enabled item
+        document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+          group.addEventListener('keydown', event => {
+            if (event.key !== 'Home' && event.key !== 'End') return;
+            const items = [...group.querySelectorAll('button, a[href]')]
+              .filter(item => item.closest('[focusgroup]') === group)
+              .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+            if (!items.length || !items.includes(document.activeElement)) return;
+            event.preventDefault();
+            event.stopImmediatePropagation();
+            (event.key === 'Home' ? items[0] : items[items.length - 1]).focus({ preventScroll: true });
+          }, true);
+        });
+      }
+
+      // 2. One tab stop for the menubar
+      function setMenubarTabStop(activeTrigger) {
+        menubarTriggers.forEach(btn => {
+          btn.tabIndex = btn === activeTrigger ? 0 : -1;
+        });
+      }
+      if (menubarTriggers.length) {
+        setMenubarTabStop(menubarTriggers[0]);
+      }
+
+      // 3. Fallback for browsers without CSS Anchor Positioning (`position-area: block-end`)
+      const supportsAnchorPositionArea = CSS.supports('position-area', 'block-end');
+      const supportsImplicitAnchor = 'source' in (window.ToggleEvent?.prototype || {});
+
+      if (supportsAnchorPositionArea && !supportsImplicitAnchor) {
+        triggers.forEach((trig, i) => {
+          const anchorName = `--menu-anchor-${i}`;
+          trig.style.anchorName = anchorName;
+          const menu = menuFor(trig);
+          if (menu) menu.style.positionAnchor = anchorName;
+        });
+      }
+
+      function positionMenuFallback(menu, trigger) {
+        if (supportsAnchorPositionArea || !menu || !trigger) return;
+        const trigRect = trigger.getBoundingClientRect();
+        const menuRect = menu.getBoundingClientRect();
+        const isSubmenu = Boolean(menu.parentElement.closest('[popover]'));
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+        const gap = 4;
+
+        let left;
+        let top;
+
+        if (!isSubmenu) {
+          left = trigRect.left;
+          top = trigRect.bottom + gap;
+          if (left + menuRect.width > vw - 8) {
+            left = Math.max(8, trigRect.right - menuRect.width);
+          }
+          if (top + menuRect.height > vh - 8 && trigRect.top - gap - menuRect.height >= 8) {
+            top = trigRect.top - gap - menuRect.height;
+          }
+        } else {
+          left = trigRect.right + 2;
+          top = trigRect.top;
+          if (left + menuRect.width > vw - 8) {
+            if (trigRect.left - 2 - menuRect.width >= 8) {
+              left = trigRect.left - 2 - menuRect.width;
+            } else {
+              // Narrow viewport fallback: below and indented
+              left = Math.min(trigRect.left + 16, Math.max(8, vw - menuRect.width - 8));
+              top = trigRect.bottom + 2;
+            }
+          }
+          if (top + menuRect.height > vh - 8) {
+            top = Math.max(8, vh - menuRect.height - 8);
+          }
+        }
+
+        menu.style.left = `${Math.max(8, left)}px`;
+        menu.style.top = `${Math.max(8, top)}px`;
+      }
+
+      // 4. Safe triangle for submenus
+      const canHover = matchMedia('(hover: hover)');
+      function startBridge(submenu, event) {
+        if (!canHover.matches || !isOpen(submenu)) return;
+        const rect = submenu.getBoundingClientRect();
+        if (event.clientX >= rect.left && event.clientX <= rect.right) return;
+        const style = submenu.style;
+        style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+        style.setProperty('--bridge-height', `${rect.height}px`);
+        const update = ({ clientX, clientY, target }) => {
+          if (target !== submenu && submenu.contains(target)) return stop();
+          style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+          style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+        };
+        const timer = setTimeout(() => stop(), 300);
+        const stop = () => {
+          clearTimeout(timer);
+          document.removeEventListener('pointermove', update);
+          submenu.removeEventListener('toggle', stop);
+          submenu.removeAttribute('data-bridge');
+        };
+        update(event);
+        submenu.dataset.bridge = '';
+        document.addEventListener('pointermove', update);
+        submenu.addEventListener('toggle', stop, { once: true });
+      }
+
+      // 5. Invoker commands fallback & pointer handling on triggers
+      const supportsInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+
+      triggers.forEach(trigger => {
+        const menu = menuFor(trigger);
+        const isTopMenubarTrigger = menubarTriggers.includes(trigger);
+        const isSubmenuTrigger = Boolean(trigger.closest('[popover]'));
+
+        // Pointerdown: prevent default so click doesn't move focus and start a preview mid-click
+        trigger.addEventListener('pointerdown', event => {
+          event.preventDefault();
+          pointerTrigger = trigger;
+        });
+
+        if (!supportsInvokers) {
+          trigger.addEventListener('click', event => {
+            event.preventDefault();
+            const fromPointer = pointerTrigger === trigger || event.detail > 0;
+            pointerTrigger = null;
+            if (!menu) return;
+            if (isOpen(menu)) {
+              closeAndRestore(menu, { fromPointer });
+            } else {
+              if (!fromPointer) {
+                enterOnOpen.add(menu);
+              }
+              try {
+                menu.showPopover({ source: trigger });
+              } catch {
+                menu.showPopover();
+              }
+            }
+          });
+        } else {
+          trigger.addEventListener('click', event => {
+            const fromPointer = pointerTrigger === trigger || event.detail > 0;
+            pointerTrigger = null;
+            if (!fromPointer && menu && !isOpen(menu)) {
+              enterOnOpen.add(menu);
+            }
+          });
+        }
+
+        // Menubar preview on focus
+        if (isTopMenubarTrigger && menu) {
+          trigger.addEventListener('focus', event => {
+            if (windowBlurred || pointerTrigger === trigger) return;
+            const prev = event.relatedTarget;
+            if (prev && menu.contains(prev)) return;
+            if (!isOpen(menu)) {
+              previewedMenus.add(menu);
+              try {
+                menu.showPopover({ source: trigger });
+              } catch {
+                menu.showPopover();
+              }
+            }
+          });
+
+          trigger.addEventListener('blur', event => {
+            const next = event.relatedTarget;
+            if (previewedMenus.has(menu) && isOpen(menu)) {
+              if (!next || !menu.contains(next)) {
+                menu.hidePopover();
+              }
+            }
+          });
+
+          // Hover switches open menubar menus
+          trigger.addEventListener('pointerenter', () => {
+            const anyMenubarOpen = menubarTriggers.some(t => t !== trigger && isOpen(menuFor(t)));
+            if (anyMenubarOpen) {
+              menubarTriggers.forEach(t => {
+                const m = menuFor(t);
+                if (t !== trigger && isOpen(m)) m.hidePopover();
+              });
+              setMenubarTabStop(trigger);
+              focusWithoutRing(trigger);
+            }
+          });
+        }
+
+        // Submenu trigger hover preview and safe triangle
+        if (isSubmenuTrigger && menu) {
+          trigger.addEventListener('pointerenter', () => {
+            clearTimeout(hoverTimer);
+            hoverTimer = setTimeout(() => {
+              if (!isOpen(menu)) {
+                previewedMenus.add(menu);
+                try {
+                  menu.showPopover({ source: trigger });
+                } catch {
+                  menu.showPopover();
+                }
+              }
+            }, 90);
+          });
+
+          trigger.addEventListener('pointerleave', event => {
+            clearTimeout(hoverTimer);
+            if (isOpen(menu)) {
+              startBridge(menu, event);
+            }
+          });
+        }
+      });
+
+      // 6. Toggle event listener for all popovers (`aria-expanded`, positioning fallback, focus entry)
+      menus.forEach(menu => {
+        const trigger = triggerFor(menu);
+        menu.addEventListener('toggle', event => {
+          const open = event.newState === 'open';
+          if (trigger) {
+            trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
+          }
+          if (!open) {
+            previewedMenus.delete(menu);
+            enterOnOpen.delete(menu);
+            return;
+          }
+
+          positionMenuFallback(menu, trigger);
+
+          if (enterOnOpen.has(menu)) {
+            enterOnOpen.delete(menu);
+            previewedMenus.delete(menu);
+            const items = ownItems(menu);
+            const targetItem = menu.dataset.enterTarget === 'last' ? items[items.length - 1] : items[0];
+            delete menu.dataset.enterTarget;
+            if (targetItem) {
+              targetItem.focus({ preventScroll: true });
+            }
+          } else if (pointerTrigger === trigger && trigger) {
+            pointerTrigger = null;
+            focusWithoutRing(trigger);
+          }
+        });
+      });
+
+      // 7. Pointer over items inside a menu: focus without ring and close sibling submenus
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.addEventListener('pointermove', event => {
+          const item = event.target.closest('button, a[href]');
+          if (!item || item.closest('[focusgroup]') !== group) return;
+          if (item.disabled || item.getAttribute('aria-disabled') === 'true') return;
+
+          if (document.activeElement !== item) {
+            focusWithoutRing(item);
+          }
+
+          // If hovering a sibling item that isn't the trigger for an open submenu in this group, close that submenu
+          const subtriggers = [...group.querySelectorAll('button[commandfor]')].filter(
+            btn => btn.closest('[focusgroup]') === group
+          );
+          subtriggers.forEach(subTrig => {
+            if (subTrig !== item) {
+              const subMenu = menuFor(subTrig);
+              if (isOpen(subMenu)) {
+                subMenu.hidePopover();
+              }
+            }
+          });
+        });
+      });
+
+      // 8. Keyboard navigation on triggers & inside menus
+      function switchMenubarTrigger(currentTrigger, delta) {
+        const idx = menubarTriggers.indexOf(currentTrigger);
+        if (idx < 0) return;
+        const nextIdx = (idx + delta + menubarTriggers.length) % menubarTriggers.length;
+        const nextTrigger = menubarTriggers[nextIdx];
+        const currentMenu = menuFor(currentTrigger);
+        if (isOpen(currentMenu)) {
+          currentMenu.hidePopover();
+        }
+        setMenubarTabStop(nextTrigger);
+        nextTrigger.focus({ preventScroll: true });
+      }
+
+      triggers.forEach(trigger => {
+        const menu = menuFor(trigger);
+        const isTopMenubarTrigger = menubarTriggers.includes(trigger);
+        const isSubmenuTrigger = Boolean(trigger.closest('[popover]'));
+
+        trigger.addEventListener('keydown', event => {
+          if (isSubmenuTrigger) return; // Handled by parent menu listener
+
+          if (isTopMenubarTrigger && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
+            event.preventDefault();
+            switchMenubarTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+            return;
+          }
+
+          if (event.key === 'ArrowDown' || event.key === 'Home' || event.key === 'End') {
+            event.preventDefault();
+            if (!menu) return;
+            const enterLast = event.key === 'End';
+            if (isOpen(menu)) {
+              previewedMenus.delete(menu);
+              const items = ownItems(menu);
+              const target = enterLast ? items[items.length - 1] : items[0];
+              if (target) target.focus({ preventScroll: true });
+            } else {
+              menu.dataset.enterTarget = enterLast ? 'last' : 'first';
+              enterOnOpen.add(menu);
+              trigger.click();
+            }
+          } else if (event.key === 'ArrowUp' && !isTopMenubarTrigger) {
+            event.preventDefault();
+            if (!menu) return;
+            if (isOpen(menu)) {
+              const items = ownItems(menu);
+              if (items.length) items[items.length - 1].focus({ preventScroll: true });
+            } else {
+              menu.dataset.enterTarget = 'last';
+              enterOnOpen.add(menu);
+              trigger.click();
+            }
+          } else if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            closeAndRestore(menu);
+          }
+        });
+      });
+
+      menus.forEach(menu => {
+        menu.addEventListener('keydown', event => {
+          const active = document.activeElement;
+          if (!active || active.closest('[popover]') !== menu) return;
+
+          const parentPopover = menu.parentElement.closest('[popover]');
+          const rootMenu = rootMenuOf(menu);
+          const rootTrigger = triggerFor(rootMenu);
+          const isInsideMenubar = menubarTriggers.includes(rootTrigger);
+
+          if (event.key === 'Escape') {
+            event.preventDefault();
+            event.stopPropagation();
+            closeAndRestore(menu);
+            return;
+          }
+
+          if (event.key === 'ArrowLeft') {
+            event.preventDefault();
+            event.stopPropagation();
+            if (parentPopover) {
+              closeAndRestore(menu);
+            } else if (isInsideMenubar) {
+              switchMenubarTrigger(rootTrigger, -1);
+            }
+            return;
+          }
+
+          if (event.key === 'ArrowRight') {
+            const subMenu = active.hasAttribute('commandfor') ? menuFor(active) : null;
+            if (subMenu) {
+              event.preventDefault();
+              event.stopPropagation();
+              if (isOpen(subMenu)) {
+                previewedMenus.delete(subMenu);
+                const subItems = ownItems(subMenu);
+                if (subItems.length) subItems[0].focus({ preventScroll: true });
+              } else {
+                enterOnOpen.add(subMenu);
+                active.click();
+              }
+            } else if (isInsideMenubar) {
+              event.preventDefault();
+              event.stopPropagation();
+              switchMenubarTrigger(rootTrigger, 1);
+            }
+            return;
+          }
+
+          if (event.key === 'Tab') {
+            closeAllMenus();
+          }
+        });
+      });
+
+      // 9. Outside focus closes open menus
+      document.addEventListener('focusin', event => {
+        const target = event.target;
+        if (!target.closest('[popover]') && !target.closest('button[commandfor]') && !target.closest('[role="menubar"]')) {
+          closeAllMenus();
+        }
+      });
+
+      // 10. Command, Checkbox, and Radio item activation
+      function updateCardSummary(card) {
+        if (!card) return;
+        const summaryEl = card.querySelector('.card-summary');
+        if (!summaryEl) return;
+        const checkedRadios = [...card.querySelectorAll('button[role="menuitemradio"][aria-checked="true"][data-summary-val]')];
+        const checkedBoxes = [...card.querySelectorAll('button[role="menuitemcheckbox"][aria-checked="true"]')];
+        const parts = checkedRadios.map(r => r.dataset.summaryVal);
+        if (checkedBoxes.length) {
+          parts.push(...checkedBoxes.map(cb => cb.textContent.trim()));
+        }
+        if (parts.length) {
+          summaryEl.textContent = `Current: ${parts.join(' • ')}`;
+        }
+      }
+
+      function announceAction(message) {
+        if (statusEl && message) {
+          statusEl.textContent = message;
+        }
+      }
+
+      document.querySelectorAll('[focusgroup~="menu"] button:not([commandfor])').forEach(btn => {
+        let spaceKeyActivation = false;
+
+        btn.addEventListener('keydown', event => {
+          if (event.key === ' ') {
+            spaceKeyActivation = true;
+          }
+        });
+
+        btn.addEventListener('click', event => {
+          const fromPointer = event.detail > 0;
+          const viaSpace = spaceKeyActivation;
+          spaceKeyActivation = false;
+
+          const role = btn.getAttribute('role');
+          const rootMenu = rootMenuOf(btn);
+          const card = btn.closest('.card');
+
+          if (role === 'menuitemcheckbox') {
+            const nextChecked = btn.getAttribute('aria-checked') !== 'true';
+            btn.setAttribute('aria-checked', String(nextChecked));
+            updateCardSummary(card);
+            announceAction(`${btn.dataset.action || btn.textContent.trim()} (${nextChecked ? 'Enabled' : 'Disabled'})`);
+
+            // Space on a checkbox toggles and stays open; Enter or pointer click closes after 300ms
+            if (!viaSpace && rootMenu) {
+              setTimeout(() => {
+                closeAndRestore(rootMenu, { fromPointer });
+              }, 300);
+            }
+            return;
+          }
+
+          if (role === 'menuitemradio') {
+            const group = btn.closest('[role="group"]') || btn.closest('[focusgroup~="menu"]');
+            if (group) {
+              group.querySelectorAll('button[role="menuitemradio"]').forEach(radio => {
+                radio.setAttribute('aria-checked', String(radio === btn));
+              });
+            }
+            updateCardSummary(card);
+            announceAction(btn.dataset.action || `Selected ${btn.textContent.trim()}`);
+
+            if (rootMenu) {
+              setTimeout(() => {
+                closeAndRestore(rootMenu, { fromPointer });
+              }, 300);
+            }
+            return;
+          }
+
+          // Standard command button
+          announceAction(btn.dataset.action || `Activated ${btn.textContent.trim()}`);
+          if (rootMenu) {
+            closeAndRestore(rootMenu, { fromPointer });
+          }
+        });
+      });
+    })();
+  </script>
 </body>
 
