+      /* Popover & Menu Styling */
+      [popover] {
+        border: 1px solid var(--border-subtle);
+        border-radius: 8px;
+        background: var(--surface);
+        color: var(--text);
+        box-shadow: 0 10px 25px rgba(62, 39, 35, 0.18), 0 2px 6px rgba(62, 39, 35, 0.08);
+        padding: 0.35rem;
+        min-inline-size: 14.5rem;
+        margin: 0;
+      }
+
+      @supports (position-area: block-end) {
+        /* Top-level menus sit below their trigger. The implicit anchor comes from the invoker or source. */
+        [popover] {
+          position-area: block-end span-inline-end;
+          position-try-fallbacks: flip-inline, flip-block, flip-block flip-inline;
+          inset: auto;
+          margin-block-start: 0.25rem;
+        }
+
+        /* A popover nested in another popover is a submenu: beside its parent item, flipping when it would overflow. */
+        [popover] [popover] {
+          position-area: inline-end span-block-end;
+          position-try-fallbacks: flip-inline, flip-block, --below;
+          margin-block-start: 0;
+          margin-inline-start: 0.15rem;
+        }
+
+        /* Last resort for narrow viewports: directly below the trigger, indented, so the submenu never covers its trigger. */
+        @position-try --below {
+          position-area: block-end span-inline-end;
+          margin-inline-start: 1rem;
+          min-inline-size: 0;
+          max-inline-size: calc(100% - 1rem);
+        }
+      }
+
+      @supports not (position-area: block-end) {
+        [popover] {
+          position: fixed;
+          inset: auto;
+          margin: 0;
+        }
+      }
+
+      /* Safe triangle for submenus */
+      [popover] [popover] {
+        overflow: visible;
+
+        &[data-bridge]::before {
+          content: "";
+          position: absolute;
+          inset: -100vh -100vw;
+          clip-path: shape(
+            from calc(100vw + var(--bridge-x, 0px)) calc(100vh + var(--bridge-y, 0px)),
+            line to calc(100vw + var(--bridge-edge, 0px)) 100vh,
+            line to calc(100vw + var(--bridge-edge, 0px)) calc(100vh + var(--bridge-height, 0px)),
+            close
+          );
+        }
+      }
+
+      /* Menu open/close animations */
+      @media (prefers-reduced-motion: no-preference) {
+        [popover] {
+          opacity: 0;
+          translate: 0 -.25rem;
+          transition: opacity .15s, translate .15s, display .15s allow-discrete, overlay .15s allow-discrete;
+        }
+        [popover]:where(:popover-open, .\:popover-open) {
+          opacity: 1;
+          translate: 0 0;
+          transition-duration: .1s;
+          @starting-style {
+            opacity: 0;
+            translate: 0 -.25rem;
+          }
+        }
+        [role="menubar"]:has(> [popover]:where(:popover-open, .\:popover-open)) > [popover] {
+          transition: none;
+        }
+      }
+
