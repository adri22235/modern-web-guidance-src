+  <script>
+    (function () {
+      const COFFEE_DATA = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          price: '$5.75',
+          meta: '12 oz / 16 oz • 210 kcal',
+          summary: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          details: 'Rich double-shot espresso combined with velvety steamed oat milk, pure Grade A Vermont amber maple syrup, and a light dusting of warm autumn cinnamon.',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Maple Oat Latte topped with velvety microfoam',
+          highlights: ['100% Plant-Based', 'Pure Vermont Maple', 'Seasonal Limited Release'],
+          orderUrl: '/order-online?item=maple-oat-latte'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          price: '$3.50',
+          meta: 'Double Shot (2 oz) • 10 kcal',
+          summary: 'Bold, smokey, and perfect for a morning boost.',
+          details: 'Full-bodied single-origin beans roasted to a deep mahogany finish, delivering intense notes of dark cacao, toasted walnut, and a rich caramelized crema.',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Freshly pulled Dark Roast Espresso shot',
+          highlights: ['Single-Origin Blend', 'Deep Mahogany Roast', 'Freshly Pulled to Order'],
+          orderUrl: '/order-online?item=dark-roast-espresso'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          price: '$4.75',
+          meta: '16 oz / 20 oz • 15 kcal',
+          summary: 'Steeped for 18 hours for maximum smoothness.',
+          details: 'Coarse-ground artisanal beans slow-steeped in cool filtered water for 18 hours, resulting in a naturally sweet, low-acid brew with smooth dark chocolate undertones.',
+          image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Chilled Cold Brew coffee poured over ice',
+          highlights: ['18-Hour Slow Steep', 'Low Acidity', 'Smooth Chocolate Notes'],
+          orderUrl: '/order-online?item=cold-brew'
+        }
+      };
+
+      const dialog = document.getElementById('coffee-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalPrice = document.getElementById('modal-price');
+      const modalMeta = document.getElementById('modal-meta');
+      const modalSummary = document.getElementById('modal-summary');
+      const modalDetails = document.getElementById('modal-details');
+      const modalImage = document.getElementById('modal-image');
+      const modalHighlights = document.getElementById('modal-highlights');
+      const modalOrderLink = document.getElementById('modal-order-link');
+      const detailButtons = document.querySelectorAll('.details-btn');
+      const closeButtons = dialog.querySelectorAll('[data-close-modal]');
+
+      let lastFocusedTrigger = null;
+      let activeCloseWatcher = null;
+
+      function cleanupCloseWatcher() {
+        if (activeCloseWatcher) {
+          const watcher = activeCloseWatcher;
+          activeCloseWatcher = null;
+          try {
+            watcher.destroy();
+          } catch (_) {}
+        }
+      }
+
+      function closeModal() {
+        cleanupCloseWatcher();
+        if (typeof dialog.close === 'function' && dialog.open) {
+          dialog.close();
+        } else if (dialog.hasAttribute('open')) {
+          dialog.removeAttribute('open');
+          restoreFocus();
+        }
+      }
+
+      function restoreFocus() {
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+        }
+      }
+
+      function setupCloseWatcher() {
+        cleanupCloseWatcher();
+        if (typeof window.CloseWatcher === 'function') {
+          try {
+            const watcher = new window.CloseWatcher();
+            const onWatcherClose = () => {
+              if (activeCloseWatcher === watcher) {
+                activeCloseWatcher = null;
+              }
+              closeModal();
+            };
+            watcher.onclose = onWatcherClose;
+            if (typeof watcher.addEventListener === 'function') {
+              watcher.addEventListener('close', onWatcherClose);
+            }
+            activeCloseWatcher = watcher;
+          } catch (_) {}
+        }
+      }
+
+      function openModal(coffeeId, triggerEl) {
+        const data = COFFEE_DATA[coffeeId];
+        if (!data) return;
+
+        lastFocusedTrigger = triggerEl || document.activeElement;
+
+        modalTitle.textContent = data.title;
+        modalPrice.textContent = data.price;
+        modalMeta.textContent = data.meta;
+        modalSummary.textContent = data.summary;
+        modalDetails.textContent = data.details;
+        modalImage.src = data.image;
+        modalImage.alt = data.imageAlt;
+        modalOrderLink.href = data.orderUrl;
+
+        modalHighlights.innerHTML = '';
+        data.highlights.forEach((item) => {
+          const li = document.createElement('li');
+          li.textContent = item;
+          modalHighlights.appendChild(li);
+        });
+
+        try {
+          if (window.history && typeof window.history.pushState === 'function') {
+            if (window.history.state && window.history.state.modalOpen) {
+              window.history.replaceState({ modalOpen: true, coffeeId }, '');
+            } else {
+              window.history.pushState({ modalOpen: true, coffeeId }, '');
+            }
+          }
+        } catch (_) {}
+
+        if (typeof dialog.showModal === 'function') {
+          if (!dialog.open) {
+            dialog.showModal();
+          }
+        } else {
+          dialog.setAttribute('open', '');
+        }
+
+        setupCloseWatcher();
+      }
+
+      detailButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const coffeeId = btn.getAttribute('data-coffee');
+          openModal(coffeeId, btn);
+        });
+      });
+
+      closeButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          closeModal();
+        });
+      });
+
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) {
+          closeModal();
+        }
+      });
+
+      dialog.addEventListener('close', () => {
+        cleanupCloseWatcher();
+        restoreFocus();
+      });
+
+      window.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && (dialog.open || dialog.hasAttribute('open'))) {
+          closeModal();
+        }
+      });
+
+      window.addEventListener('popstate', () => {
+        if (dialog.open || dialog.hasAttribute('open')) {
+          closeModal();
+        }
+      });
+    })();
+  </script>
+
