+  <script>
+    (function detectBackgroundTabLoad() {
+      const supportsVisibilityStateEntries =
+        typeof performance !== 'undefined' &&
+        typeof performance.getEntriesByType === 'function' &&
+        (('VisibilityStateEntry' in window) ||
+          (typeof PerformanceObserver !== 'undefined' &&
+            Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+            PerformanceObserver.supportedEntryTypes.includes('visibility-state')) ||
+          performance.getEntriesByType('visibility-state').length > 0);
+
+      if (supportsVisibilityStateEntries) {
+        const entries = performance.getEntriesByType('visibility-state');
+        const initialEntry = entries[0];
+        const firstHiddenEntry = entries.find((entry) => entry.name === 'hidden');
+
+        // Accurate detection via buffered Performance Timeline 'visibility-state' entries.
+        // Unlike document.visibilityState, VisibilityStateEntry records historical visibility
+        // states starting at navigation start (startTime === 0), making it reliable even for
+        // async or deferred scripts that execute after the user switches tabs.
+        const loadedInBackground = Boolean(
+          (initialEntry && initialEntry.name === 'hidden') || firstHiddenEntry
+        );
+        const backgroundTime = firstHiddenEntry ? firstHiddenEntry.startTime : null;
+
+        const detectionInfo = {
+          backgrounded: loadedInBackground,
+          initiallyLoadedInBackground: Boolean(initialEntry && initialEntry.name === 'hidden'),
+          backgroundTime: backgroundTime,
+          fallbackActive: false,
+          unreliable: false,
+          detectionMethod: 'performance-visibility-state'
+        };
+
+        console.log(detectionInfo);
+      } else {
+        // WARNING: Legacy fallback detection active (potentially unreliable / inaccurate).
+        // Querying document.visibilityState or document.hidden only reflects the tab's
+        // visibility at the exact moment this script runs. For async, deferred, or
+        // late-loading scripts, the user may have already switched tabs between navigation
+        // start and script execution, causing false positives/negatives and losing the
+        // true initial timestamp of when the page was backgrounded.
+        const isCurrentlyHidden =
+          document.visibilityState === 'hidden' || Boolean(document.hidden);
+        const fallbackTimestamp = isCurrentlyHidden ? performance.now() : null;
+
+        const detectionInfo = {
+          backgrounded: isCurrentlyHidden,
+          initiallyLoadedInBackground: isCurrentlyHidden,
+          backgroundTime: fallbackTimestamp,
+          fallbackActive: true,
+          unreliable: true,
+          detectionMethod: 'legacy-document-visibility-fallback',
+          warning:
+            'Legacy fallback detection active: document.visibilityState queries are inaccurate and potentially unreliable for async scripts.'
+        };
+
+        console.warn(
+          '[Background Detection] Fallback detection active and potentially unreliable for async scripts.'
+        );
+        console.log(detectionInfo);
+      }
+    })();
+  </script>
+
 </body>
 
