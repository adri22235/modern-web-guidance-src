+  <script>
+    // Identify causes of poor INP using the Event Timing and Long Animation Frames (LoAF) APIs
+    (function monitorINP() {
+      if (typeof PerformanceObserver === 'undefined') return;
+
+      const POOR_INP_THRESHOLD = 200;
+      const recentLoAFs = [];
+
+      function getSelector(node) {
+        if (!node || node.nodeType !== 1) return 'unknown';
+        const tag = node.tagName.toLowerCase();
+        const id = node.id ? `#${node.id}` : '';
+        const classes =
+          node.className && typeof node.className === 'string'
+            ? `.${node.className.trim().split(/\s+/).join('.')}`
+            : '';
+        return `${tag}${id}${classes}`;
+      }
+
+      function identifyPrimaryCause(inputDelay, processingDuration, presentationDelay) {
+        const max = Math.max(inputDelay, processingDuration, presentationDelay);
+        if (max === inputDelay) {
+          return 'inputDelay (main-thread contention before event handlers could run)';
+        }
+        if (max === processingDuration) {
+          return 'processingDuration (slow event handler execution)';
+        }
+        return 'presentationDelay (expensive style, layout, paint, or large DOM size)';
+      }
+
+      // Observe Long Animation Frames (LoAF) to attribute slow scripts and forced layouts
+      if (
+        PerformanceObserver.supportedEntryTypes &&
+        PerformanceObserver.supportedEntryTypes.includes('long-animation-frame')
+      ) {
+        try {
+          const loafObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              recentLoAFs.push(entry);
+              if (recentLoAFs.length > 100) recentLoAFs.shift();
+            }
+          });
+          loafObserver.observe({ type: 'long-animation-frame', buffered: true });
+        } catch (e) {
+          // Ignore if unsupported
+        }
+      }
+
+      // Observe Event Timing entries to break down INP phases and correlate with LoAF
+      if (
+        PerformanceObserver.supportedEntryTypes &&
+        PerformanceObserver.supportedEntryTypes.includes('event')
+      ) {
+        try {
+          const eventObserver = new PerformanceObserver((list) => {
+            for (const entry of list.getEntries()) {
+              if (!entry.interactionId && entry.duration < POOR_INP_THRESHOLD) continue;
+
+              const inputDelay = entry.processingStart - entry.startTime;
+              const processingDuration = entry.processingEnd - entry.processingStart;
+              const presentationDelay = Math.max(
+                0,
+                entry.startTime + entry.duration - entry.processingEnd
+              );
+              const entryEnd = entry.startTime + entry.duration;
+
+              const overlappingLoAFs = recentLoAFs.filter((loaf) => {
+                const loafEnd = loaf.startTime + loaf.duration;
+                return loaf.startTime < entryEnd && loafEnd > entry.startTime;
+              });
+
+              const scripts = overlappingLoAFs.flatMap((loaf) =>
+                (loaf.scripts || []).map((script) => ({
+                  invoker: script.invoker,
+                  invokerType: script.invokerType,
+                  sourceURL: script.sourceURL,
+                  sourceFunctionName: script.sourceFunctionName,
+                  sourceCharPosition: script.sourceCharPosition,
+                  duration: script.duration,
+                  forcedStyleAndLayoutDuration: script.forcedStyleAndLayoutDuration,
+                }))
+              );
+
+              const diagnosticReport = {
+                interactionId: entry.interactionId,
+                interactionType: entry.name,
+                interactionTarget: getSelector(entry.target),
+                interactionTargetElement: entry.target,
+                interactionTime: entry.startTime,
+                duration: entry.duration,
+                rating:
+                  entry.duration > 500
+                    ? 'poor'
+                    : entry.duration > POOR_INP_THRESHOLD
+                    ? 'needs-improvement'
+                    : 'good',
+                loadState: document.readyState,
+                phases: {
+                  inputDelay,
+                  processingDuration,
+                  presentationDelay,
+                },
+                primaryCause: identifyPrimaryCause(
+                  inputDelay,
+                  processingDuration,
+                  presentationDelay
+                ),
+                longAnimationFrames: overlappingLoAFs,
+                scripts,
+              };
+
+              if (entry.duration >= POOR_INP_THRESHOLD) {
+                console.warn('[INP Diagnostic] Slow interaction detected:', diagnosticReport);
+              } else {
+                console.debug('[INP Diagnostic] Interaction recorded:', diagnosticReport);
+              }
+            }
+          });
+
+          eventObserver.observe({
+            type: 'event',
+            durationThreshold: 40,
+            buffered: true,
+          });
+        } catch (e) {
+          // Ignore if unsupported
+        }
+      }
+    })();
+  </script>
+
+  <script type="module">
+    // Use web-vitals attribution build to report INP and its root cause in the field
+    import { onINP } from 'https://unpkg.com/web-vitals@4/dist/web-vitals.attribution.js?module';
+
+    function logINPAttribution(metric) {
+      const { value, rating, attribution } = metric;
+      const {
+        interactionTarget,
+        interactionTargetElement,
+        interactionType,
+        interactionTime,
+        nextPaintTime,
+        loadState,
+        inputDelay,
+        processingDuration,
+        presentationDelay,
+        longAnimationFrameEntries = [],
+      } = attribution || {};
+
+      const scripts = longAnimationFrameEntries.flatMap((loaf) =>
+        (loaf.scripts || []).map((script) => ({
+          invoker: script.invoker,
+          invokerType: script.invokerType,
+          sourceURL: script.sourceURL,
+          sourceFunctionName: script.sourceFunctionName,
+          sourceCharPosition: script.sourceCharPosition,
+          duration: script.duration,
+          forcedStyleAndLayoutDuration: script.forcedStyleAndLayoutDuration,
+        }))
+      );
+
+      const report = {
+        inp: value,
+        rating,
+        interactionTarget,
+        interactionTargetElement,
+        interactionType,
+        interactionTime,
+        nextPaintTime,
+        loadState,
+        inputDelay,
+        processingDuration,
+        presentationDelay,
+        longAnimationFrameEntries,
+        scripts,
+      };
+
+      console.log('[Web Vitals INP Attribution]', report);
+    }
+
+    onINP(logINPAttribution, { reportAllChanges: true });
+  </script>
+
 </body>
 
 </html>
