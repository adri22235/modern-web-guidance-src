+  <script blocking="render">
+    function determineTransitionType(fromEntry, currentEntry) {
+      if (!fromEntry || !currentEntry) return 'next';
+      const fromUrl = new URL(fromEntry.url);
+      const currentUrl = new URL(currentEntry.url);
+      const fromPage = parseInt(fromUrl.searchParams.get('page') || '1', 10);
+      const currentPage = parseInt(currentUrl.searchParams.get('page') || '1', 10);
+      if (currentPage < fromPage || currentUrl.hash === '#previous' || currentUrl.pathname.includes('previous')) {
+        return 'previous';
+      }
+      if (currentPage > fromPage || currentUrl.hash === '#next' || currentUrl.pathname.includes('next')) {
+        return 'next';
+      }
+      if (typeof currentEntry.index === 'number' && typeof fromEntry.index === 'number' && currentEntry.index < fromEntry.index) {
+        return 'previous';
+      }
+      return 'next';
+    }
+
+    if ('onpagereveal' in window) {
+      window.addEventListener('pagereveal', async (e) => {
+        if (e.viewTransition && window.navigation?.activation) {
+          const transitionType = determineTransitionType(
+            navigation.activation.from,
+            navigation.activation.entry
+          );
+          e.viewTransition.types.add(transitionType);
+        }
+      });
+    }
+  </script>
