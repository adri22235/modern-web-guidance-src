+  <script>
+    const nextLink = document.getElementById('next');
+    const previousLink = document.getElementById('previous');
+
+    nextLink?.addEventListener('click', () => {
+      sessionStorage.setItem('transitionType', 'next');
+    });
+
+    previousLink?.addEventListener('click', () => {
+      sessionStorage.setItem('transitionType', 'previous');
+    });
+
+    window.addEventListener('pagereveal', (e) => {
+      if (!e.viewTransition) return;
+
+      let transitionType = sessionStorage.getItem('transitionType');
+      sessionStorage.removeItem('transitionType');
+
+      if (!transitionType && window.navigation?.activation) {
+        const fromUrl = window.navigation.activation.from?.url;
+        const toUrl = window.navigation.activation.entry?.url;
+
+        if (toUrl === nextLink?.href || fromUrl === previousLink?.href) {
+          transitionType = 'next';
+        } else if (toUrl === previousLink?.href || fromUrl === nextLink?.href) {
+          transitionType = 'previous';
+        }
+      }
+
+      if (transitionType === 'previous') {
+        e.viewTransition.types.add('previous');
+      } else if (transitionType === 'next') {
+        e.viewTransition.types.add('next');
+      }
+    });
+  </script>
+
 </body>
 
