+        if (algoName === 'ECDSA-P256') {
+          signParams = { name: 'ECDSA', hash: { name: 'SHA-256' } };
+          if (!privKey) {
+            privKey = await window.crypto.subtle.importKey(
+              'pkcs8',
+              base64ToBytes(keyObj.privateKeyRawB64),
+              { name: 'ECDSA', namedCurve: 'P-256' },
+              false,
+              ['sign']
+            );
+          }
+        } else if (algoName === 'RSA-PSS-2048') {
+          signParams = { name: 'RSA-PSS', saltLength: 32 };
+          if (!privKey) {
+            privKey = await window.crypto.subtle.importKey(
+              'pkcs8',
+              base64ToBytes(keyObj.privateKeyRawB64),
+              { name: 'RSA-PSS', hash: 'SHA-256' },
+              false,
+              ['sign']
+            );
+          }
+        }
+        const sigBuf = await window.crypto.subtle.sign(signParams, privKey, messageBytes);
+        return bytesToBase64(sigBuf);
+      }
