+        const canonical = canonicalizeJson(envelope.payload);
+        const msgBytes = textEncoder.encode(canonical);
+        const recomputedHash = await sha256Hex(msgBytes);
+        const claimedHashMatches = !envelope.payloadHash || envelope.payloadHash === recomputedHash;
