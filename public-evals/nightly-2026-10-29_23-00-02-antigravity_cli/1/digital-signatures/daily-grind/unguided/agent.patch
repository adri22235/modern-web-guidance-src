+
+      copyPubKeyBtn.addEventListener('click', async () => {
+        if (!activeKeyObj) return;
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          await navigator.clipboard.writeText(activeKeyObj.publicKeyPem);
+        }
+        copyPubKeyBtn.textContent = 'Copied!';
+        setTimeout(() => {
+          copyPubKeyBtn.textContent = 'Copy Public Key';
+        }, 1400);
+      });
+
+      // Document Type Tabs
+      tabReceipt.addEventListener('click', () => {
+        tabReceipt.classList.add('active');
+        tabReceipt.setAttribute('aria-selected', 'true');
+        tabVoucher.classList.remove('active');
+        tabVoucher.setAttribute('aria-selected', 'false');
+        receiptForm.classList.remove('hidden');
+        voucherForm.classList.add('hidden');
+      });
+
+      tabVoucher.addEventListener('click', () => {
+        tabVoucher.classList.add('active');
+        tabVoucher.setAttribute('aria-selected', 'true');
+        tabReceipt.classList.remove('active');
+        tabReceipt.setAttribute('aria-selected', 'false');
+        voucherForm.classList.remove('hidden');
+        receiptForm.classList.add('hidden');
+      });
+
+      // Add item to receipt
+      addItemBtn.addEventListener('click', () => {
+        const [name, priceStr] = addMenuItemSelect.value.split('|');
+        const price = parseFloat(priceStr) || 4.50;
+        const existing = receiptItems.find((i) => i.name === name);
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          receiptItems.push({ name, price, qty: 1 });
+        }
+        renderReceiptItems();
+      });
+
+      document.getElementById('new-receipt-id-btn').addEventListener('click', () => {
+        const rand = Math.floor(1000 + Math.random() * 9000);
+        document.getElementById('receipt-id').value = `DG-ORD-2026-${rand}`;
+      });
+
+      document.getElementById('new-voucher-code-btn').addEventListener('click', () => {
+        const rand = Math.floor(1000 + Math.random() * 9000);
+        document.getElementById('voucher-code').value = `DG-GIFT-2026-${rand}`;
+      });
+
+      // Sign Order Receipt button
+      document.getElementById('sign-receipt-btn').addEventListener('click', async () => {
+        const payload = buildOrderReceiptPayload();
+        await signAndPublishPayload(payload);
+      });
+
+      // Sign Gift Voucher button
+      document.getElementById('sign-voucher-btn').addEventListener('click', async () => {
+        const payload = buildGiftVoucherPayload();
+        await signAndPublishPayload(payload);
+      });
+
+      // Seasonal Menu Cards "Order & Sign Receipt" quick buttons
+      document.querySelectorAll('.quick-order-btn').forEach((btn) => {
+        btn.addEventListener('click', async (e) => {
+          const itemName = e.currentTarget.getAttribute('data-item');
+          const itemPrice = parseFloat(e.currentTarget.getAttribute('data-price')) || 5.00;
+          tabReceipt.click();
+          receiptItems = [{ name: itemName, price: itemPrice, qty: 1 }];
+          renderReceiptItems();
+          const rand = Math.floor(1000 + Math.random() * 9000);
+          document.getElementById('receipt-id').value = `DG-ORD-2026-${rand}`;
+          const payload = buildOrderReceiptPayload();
+          await signAndPublishPayload(payload);
+          document.getElementById('crypto-portal').scrollIntoView({ behavior: 'smooth' });
+        });
+      });
+
+      // Ticket Actions
+      document.getElementById('send-to-verifier-btn').addEventListener('click', async () => {
+        if (currentSignedEnvelope) {
+          await loadEnvelopeIntoVerifier(currentSignedEnvelope);
+        }
+      });
+
+      document.getElementById('copy-signed-json-btn').addEventListener('click', async (e) => {
+        const btn = e.currentTarget;
+        if (currentSignedEnvelope && navigator.clipboard && navigator.clipboard.writeText) {
+          await navigator.clipboard.writeText(JSON.stringify(currentSignedEnvelope, null, 2));
+        }
+        btn.textContent = 'Copied JSON!';
+        setTimeout(() => {
+          btn.textContent = 'Copy Signed JSON';
+        }, 1400);
+      });
+
+      document.getElementById('download-signed-json-btn').addEventListener('click', () => {
+        if (!currentSignedEnvelope) return;
+        const blob = new Blob([JSON.stringify(currentSignedEnvelope, null, 2)], { type: 'application/json' });
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        const id = currentSignedEnvelope.payload.receiptId || currentSignedEnvelope.payload.voucherCode || 'document';
+        a.href = url;
+        a.download = `${id.toLowerCase()}-signed.json`;
+        document.body.appendChild(a);
+        a.click();
+        document.body.removeChild(a);
+        URL.revokeObjectURL(url);
+      });
+
+      // Verifier Controls
+      verifyKeySource.addEventListener('change', () => {
+        if (verifyKeySource.value === 'custom') {
+          customPubkeyGroup.classList.remove('hidden');
+        } else {
+          customPubkeyGroup.classList.add('hidden');
+        }
+        runVerificationFromInspector();
+      });
+
+      customPubkeyInput.addEventListener('input', () => {
+        runVerificationFromInspector();
+      });
+
+      document.getElementById('verify-document-btn').addEventListener('click', () => {
+        runVerificationFromInspector();
+      });
+
+      verifierJsonInput.addEventListener('input', () => {
+        runVerificationFromInspector();
+      });
+
+      document.getElementById('upload-json-file').addEventListener('change', (e) => {
+        const file = e.target.files && e.target.files[0];
+        if (!file) return;
+        const reader = new FileReader();
+        reader.onload = () => {
+          verifierJsonInput.value = String(reader.result || '');
+          runVerificationFromInspector();
+        };
+        reader.readAsText(file);
+      });
+
+      // Tamper Simulation Buttons
+      document.getElementById('tamper-amount-btn').addEventListener('click', async () => {
+        try {
+          const parsed = JSON.parse(verifierJsonInput.value);
+          if (parsed && parsed.payload) {
+            if (parsed.payload.documentType === 'GIFT_VOUCHER') {
+              parsed.payload.denomination = +(Number(parsed.payload.denomination || 25) + 100).toFixed(2);
+            } else {
+              parsed.payload.totalAmount = +(Number(parsed.payload.totalAmount || 15) + 100).toFixed(2);
+            }
+            verifierJsonInput.value = JSON.stringify(parsed, null, 2);
+            await runVerificationFromInspector();
+          }
+        } catch (_) {
+          // Ignore if JSON invalid
+        }
+      });
+
+      document.getElementById('tamper-sig-btn').addEventListener('click', async () => {
+        try {
+          const parsed = JSON.parse(verifierJsonInput.value);
+          if (parsed && typeof parsed.signature === 'string' && parsed.signature.length > 8) {
+            const firstChar = parsed.signature[0];
+            const flipped = firstChar === 'A' ? 'B' : 'A';
+            parsed.signature = flipped + parsed.signature.slice(1);
+            verifierJsonInput.value = JSON.stringify(parsed, null, 2);
+            await runVerificationFromInspector();
+          }
+        } catch (_) {
+          // Ignore if JSON invalid
+        }
+      });
+
+      document.getElementById('restore-valid-btn').addEventListener('click', async () => {
+        if (lastAuthenticEnvelopeBackup) {
+          verifierJsonInput.value = JSON.stringify(lastAuthenticEnvelopeBackup, null, 2);
+          await runVerificationFromInspector();
+        }
+      });
+
+      // Initialize on load: render items, generate default Quantum-Resistant keypair, and pre-sign both a sample Gift Voucher and Order Receipt
+      async function initPortal() {
+        renderReceiptItems();
+        activeKeyObj = await generateKeyPairForScheme(algoSelect.value);
+        updateKeyringUI();
+
+        // Pre-sign a Gift Voucher for the ledger
+        const initialVoucherPayload = buildGiftVoucherPayload();
+        const signedVoucher = await signDocumentPayload(initialVoucherPayload, activeKeyObj);
+        signedLedger.push(signedVoucher);
+
+        // Pre-sign the default Order Receipt so both receipt and voucher are ready immediately
+        const initialReceiptPayload = buildOrderReceiptPayload();
+        await signAndPublishPayload(initialReceiptPayload);
+      }
+
+      initPortal();
+    })();
+  </script>
 </body>
 
 </html>
