+      async function generateKeyPairForScheme(scheme) {
+        if (scheme === 'PQ-WOTS-SHA256') {
+          return await generateWotsKeyPair();
+        }
+        if (scheme === 'ECDSA-P256' || scheme === 'RSA-PSS-2048') {
+          return await generateClassicalWebCryptoKeyPair(scheme);
+        }
+        if (scheme === 'HYBRID-ECDSA-WOTS') {
+          const classical = await generateClassicalWebCryptoKeyPair('ECDSA-P256');
+          const pqc = await generateWotsKeyPair();
+          const combinedPub = `${classical.publicKeyRawB64}.${pqc.publicKeyRawB64}`;
+          const combinedPriv = `${classical.privateKeyRawB64}.${pqc.privateKeyRawB64}`;
+          const keyId = 'HYB-' + (await sha256Hex(combinedPub)).slice(0, 12).toUpperCase();
+          return {
+            algorithm: 'HYBRID-ECDSA-WOTS',
+            quantumResistant: true,
+            keyId,
+            publicKeyPem: formatPem(combinedPub, 'HYBRID ECDSA-P256+WOTS PUBLIC KEY'),
+            privateKeyPem: formatPem(combinedPriv, 'HYBRID ECDSA-P256+WOTS PRIVATE KEY'),
+            publicKeyRawB64: combinedPub,
+            privateKeyRawB64: combinedPriv,
