+      async function verifyClassicalWebCrypto(algoName, messageBytes, signatureB64, publicKeyPemOrB64) {
+        try {
+          const spkiBytes = base64ToBytes(publicKeyPemOrB64);
+          const sigBytes = base64ToBytes(signatureB64);
