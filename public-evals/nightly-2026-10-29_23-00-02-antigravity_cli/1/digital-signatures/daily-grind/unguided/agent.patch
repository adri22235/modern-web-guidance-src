+            valid: false,
+            title: 'INVALID DOCUMENT FORMAT',
+            summary: 'The provided JSON is missing required cryptographic envelope fields (payload, signature, or algorithm).',
+            checks: [{ ok: false, text: 'Envelope structure check failed.' }]
+          };
+        }
