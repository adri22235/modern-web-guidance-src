+          publicKey,
+          signatureBytes,
+          payloadBytes,
+        );
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+    }
+
+    function bytesToBase64(bytes) {
+      const arr = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+      let binary = '';
+      for (let i = 0; i < arr.byteLength; i++) {
+        binary += String.fromCharCode(arr[i]);
+      }
+      return btoa(binary);
+    }
+
+    function base64ToBytes(base64) {
+      const binary = atob(base64.trim());
+      const bytes = new Uint8Array(binary.length);
+      for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+      }
+      return bytes;
+    }
+
+    function formatKeyFingerprint(bytes) {
+      return Array.from(bytes.slice(0, 8))
+        .map((b) => b.toString(16).padStart(2, '0'))
+        .join(':');
+    }
+
+    // Expose helpers on window for programmatic inspection
+    globalThis.DailyGrindCrypto = {
+      ML_DSA_PUBLIC_KEY_ALGORITHMS,
+      DOMAIN_CONTEXTS,
+      supportsPostQuantumSignatures,
+      generateSigningKeyPair,
+      signPayload,
+      verifyPayload,
+      bytesToBase64,
+      base64ToBytes,
+    };
+
+    // UI State & DOM Elements
+    let activeKeyBundle = null;
+
+    const suiteSelect = document.getElementById('suite-select');
+    const rotateKeyBtn = document.getElementById('rotate-key-btn');
+    const activeSuiteNameEl = document.getElementById('active-suite-name');
+    const activeSuiteBadgeEl = document.getElementById('active-suite-badge');
+    const activeKeyFormatEl = document.getElementById('active-key-format');
+    const activeKeySizeEl = document.getElementById('active-key-size');
+    const activeKeyFingerprintEl = document.getElementById('active-key-fingerprint');
+
+    const artifactTypeSelect = document.getElementById('artifact-type');
+    const receiptFields = document.getElementById('receipt-fields');
+    const voucherFields = document.getElementById('voucher-fields');
+    const signerContextInput = document.getElementById('signer-context');
+    const signerPayloadTextarea = document.getElementById('signer-payload');
+    const signArtifactBtn = document.getElementById('sign-artifact-btn');
+    const loadPresetVoucherBtn = document.getElementById('load-preset-voucher-btn');
+    const sigByteLengthEl = document.getElementById('sig-byte-length');
+    const ctxByteLengthEl = document.getElementById('ctx-byte-length');
+
+    const verifierContextSelect = document.getElementById('verifier-context');
+    const verifierPayloadTextarea = document.getElementById('verifier-payload');
+    const verifierPublicKeyTextarea = document.getElementById('verifier-public-key');
+    const verifierSignatureTextarea = document.getElementById('verifier-signature');
+    const verifyArtifactBtn = document.getElementById('verify-artifact-btn');
+    const tamperPayloadBtn = document.getElementById('tamper-payload-btn');
+    const mismatchContextBtn = document.getElementById('mismatch-context-btn');
+    const verificationStatusEl = document.getElementById('verification-status');
+
+    function buildPayloadFromFields() {
+      const type = artifactTypeSelect.value;
+      if (type === 'voucher') {
+        const payload = {
+          artifactType: 'gift-voucher',
+          issuer: 'The Daily Grind Coffee Co.',
+          voucherCode: document.getElementById('voucher-code').value.trim(),
+          recipient: document.getElementById('voucher-recipient').value.trim(),
+          amount: document.getElementById('voucher-amount').value.trim(),
+          expiresOn: document.getElementById('voucher-expiry').value.trim(),
+        };
+        signerContextInput.value = DOMAIN_CONTEXTS.voucher;
+        signerPayloadTextarea.value = JSON.stringify(payload, null, 2);
+      } else {
+        const payload = {
+          artifactType: 'order-receipt',
+          merchant: 'The Daily Grind Coffee Co.',
+          orderId: document.getElementById('receipt-order-id').value.trim(),
+          customer: document.getElementById('receipt-customer').value.trim(),
+          item: document.getElementById('receipt-item').value,
+          totalPaid: document.getElementById('receipt-total').value.trim(),
+          issuedAt: '2026-10-29T12:00:00Z',
+        };
+        signerContextInput.value = DOMAIN_CONTEXTS.receipt;
+        signerPayloadTextarea.value = JSON.stringify(payload, null, 2);
+      }
+      const ctxBytes = new TextEncoder().encode(signerContextInput.value);
+      ctxByteLengthEl.textContent = String(ctxBytes.byteLength);
+    }
+
+    function setVerificationBanner(state, message) {
+      verificationStatusEl.className = `verification-result ${state}`;
+      verificationStatusEl.textContent = message;
+    }
+
+    async function initOrRotateKeys() {
+      try {
+        const preferred = suiteSelect.value;
+        activeKeyBundle = await generateSigningKeyPair(preferred);
+
+        activeSuiteNameEl.textContent = activeKeyBundle.suite;
+        if (activeKeyBundle.isPostQuantum) {
+          activeSuiteBadgeEl.className = 'badge badge-pq';
+          activeSuiteBadgeEl.textContent = 'Quantum-Resistant (FIPS 204 ML-DSA)';
+        } else {
+          activeSuiteBadgeEl.className = 'badge badge-classical';
+          activeSuiteBadgeEl.textContent =
+            preferred.startsWith('ML-DSA')
+              ? 'Classical Fallback (Ed25519 — ML-DSA unsupported in this browser)'
+              : 'Classical Asymmetric (Ed25519)';
+        }
+
+        activeKeyFormatEl.textContent = activeKeyBundle.keyFormat;
+        activeKeySizeEl.textContent = String(activeKeyBundle.publicKeyBytes.byteLength);
+        activeKeyFingerprintEl.textContent = formatKeyFingerprint(
+          activeKeyBundle.publicKeyBytes,
+        );
+
+        verifierPublicKeyTextarea.value = bytesToBase64(activeKeyBundle.publicKeyBytes);
+        await handleSignArtifact();
+      } catch (err) {
+        setVerificationBanner('invalid', `Key generation error: ${err.message}`);
+      }
+    }
+
+    async function handleSignArtifact() {
+      if (!activeKeyBundle) return;
+      try {
+        const payloadText = signerPayloadTextarea.value;
+        const contextText = signerContextInput.value;
+
+        const payloadBytes = new TextEncoder().encode(payloadText);
+        const contextBytes = new TextEncoder().encode(contextText);
+
+        const signatureBytes = await signPayload(
+          activeKeyBundle.keyPair.privateKey,
+          payloadBytes,
+          contextBytes,
+        );
+
+        sigByteLengthEl.textContent = String(signatureBytes.byteLength);
+        ctxByteLengthEl.textContent = String(contextBytes.byteLength);
+
+        verifierContextSelect.value = contextText;
+        verifierPayloadTextarea.value = payloadText;
+        verifierPublicKeyTextarea.value = bytesToBase64(activeKeyBundle.publicKeyBytes);
+        verifierSignatureTextarea.value = bytesToBase64(signatureBytes);
+
+        await handleVerifyArtifact();
+      } catch (err) {
+        setVerificationBanner('invalid', `Signing failed: ${err.message}`);
+      }
+    }
+
+    async function handleVerifyArtifact() {
+      try {
+        const payloadBytes = new TextEncoder().encode(verifierPayloadTextarea.value);
+        const contextBytes = new TextEncoder().encode(verifierContextSelect.value);
+        const publicKeyBytes = base64ToBytes(verifierPublicKeyTextarea.value);
+        const signatureBytes = base64ToBytes(verifierSignatureTextarea.value);
+
+        const isValid = await verifyPayload(
+          publicKeyBytes,
+          signatureBytes,
+          payloadBytes,
+          contextBytes,
+        );
+
+        const detectedSuite =
+          ML_DSA_PUBLIC_KEY_ALGORITHMS[publicKeyBytes.byteLength] || 'Ed25519';
+
+        if (isValid) {
+          setVerificationBanner(
+            'valid',
+            `Verified Authentic & Intact (${detectedSuite}, context "${verifierContextSelect.value}"): Signature matches the artifact payload and signer public key.`,
+          );
+        } else {
+          setVerificationBanner(
+            'invalid',
+            `Verification Failed (${detectedSuite}): Payload was modified, signature is invalid, or domain separation context ("${verifierContextSelect.value}") does not match.`,
+          );
+        }
+      } catch (err) {
+        setVerificationBanner('invalid', `Verification Error: ${err.message}`);
+      }
+    }
+
+    artifactTypeSelect.addEventListener('change', () => {
+      const isVoucher = artifactTypeSelect.value === 'voucher';
+      receiptFields.style.display = isVoucher ? 'none' : 'block';
+      voucherFields.style.display = isVoucher ? 'block' : 'none';
+      loadPresetVoucherBtn.textContent = isVoucher
+        ? 'Switch to Order Receipt Preset'
+        : 'Switch to Gift Voucher Preset';
+      buildPayloadFromFields();
+      handleSignArtifact();
+    });
+
+    loadPresetVoucherBtn.addEventListener('click', () => {
+      artifactTypeSelect.value =
+        artifactTypeSelect.value === 'voucher' ? 'receipt' : 'voucher';
+      artifactTypeSelect.dispatchEvent(new Event('change'));
+    });
+
+    [
+      'receipt-order-id',
+      'receipt-customer',
+      'receipt-item',
+      'receipt-total',
+      'voucher-code',
+      'voucher-recipient',
+      'voucher-amount',
+      'voucher-expiry',
+    ].forEach((id) => {
+      const el = document.getElementById(id);
+      el.addEventListener('input', buildPayloadFromFields);
+      el.addEventListener('change', buildPayloadFromFields);
+    });
+
+    document.getElementById('receipt-item').addEventListener('change', (e) => {
+      const prices = {
+        'Maple Oat Latte': '$5.75',
+        'Dark Roast Espresso': '$3.50',
+        'Cold Brew': '$4.75',
+      };
+      document.getElementById('receipt-total').value = prices[e.target.value] || '$5.00';
+      buildPayloadFromFields();
+    });
+
+    rotateKeyBtn.addEventListener('click', initOrRotateKeys);
+    suiteSelect.addEventListener('change', initOrRotateKeys);
+    signArtifactBtn.addEventListener('click', handleSignArtifact);
+    verifyArtifactBtn.addEventListener('click', handleVerifyArtifact);
+
+    tamperPayloadBtn.addEventListener('click', async () => {
+      try {
+        const parsed = JSON.parse(verifierPayloadTextarea.value);
+        if (parsed.totalPaid) {
+          parsed.totalPaid = '$0.01';
+        } else if (parsed.amount) {
+          parsed.amount = '$999.00';
+        } else {
+          parsed.tampered = true;
+        }
+        verifierPayloadTextarea.value = JSON.stringify(parsed, null, 2);
+      } catch {
+        verifierPayloadTextarea.value += '\n/* tampered */';
+      }
+      await handleVerifyArtifact();
+    });
+
+    mismatchContextBtn.addEventListener('click', async () => {
+      verifierContextSelect.value =
+        verifierContextSelect.value === DOMAIN_CONTEXTS.receipt
+          ? DOMAIN_CONTEXTS.voucher
+          : DOMAIN_CONTEXTS.receipt;
+      await handleVerifyArtifact();
+    });
+
+    // Initialize initial payload and keys on load
+    buildPayloadFromFields();
+    initOrRotateKeys();
+  </script>
 </body>
 
 </html>
