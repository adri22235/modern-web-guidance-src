+  <script>
+    (function () {
+      const SWIPE_THRESHOLD = 35;
+      const DEFAULT_ACTION_WIDTH = 192;
+      const cards = Array.from(document.querySelectorAll('#seasonal-favorites .card'));
+      const feedbackEl = document.getElementById('seasonal-action-feedback');
+
+      function getActionWidth(card) {
+        const actions = card.querySelector('.card-actions');
+        return (actions && actions.offsetWidth) ? actions.offsetWidth : DEFAULT_ACTION_WIDTH;
+      }
+
+      function setCardOffset(card, offsetPx, isOpen) {
+        const content = card.querySelector('.card-content');
+        const actions = card.querySelector('.card-actions');
+        const buttons = card.querySelectorAll('.action-btn');
+
+        card._currentOffset = offsetPx;
+        if (content) {
+          content.style.transform = offsetPx === 0 ? 'translateX(0px)' : `translateX(${offsetPx}px)`;
+        }
+
+        if (actions) {
+          if (offsetPx > 0) {
+            actions.classList.add('align-left');
+          } else if (offsetPx < 0) {
+            actions.classList.remove('align-left');
+          }
+          actions.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
+        }
+
+        card.classList.toggle('is-swiped', Boolean(isOpen));
+        card.classList.toggle('swipe-open', Boolean(isOpen));
+        card.setAttribute('data-swipe-open', isOpen ? 'true' : 'false');
+
+        buttons.forEach((btn) => {
+          btn.setAttribute('tabindex', isOpen ? '0' : '-1');
+        });
+      }
+
+      function closeOtherCards(activeCard) {
+        cards.forEach((card) => {
+          if (card !== activeCard && card.getAttribute('data-swipe-open') === 'true') {
+            setCardOffset(card, 0, false);
+          }
+        });
+      }
+
+      function getEventCoords(e) {
+        if (e.touches && e.touches.length > 0) {
+          const t = e.touches[0];
+          return {
+            x: t.clientX ?? t.pageX ?? t.screenX ?? 0,
+            y: t.clientY ?? t.pageY ?? t.screenY ?? 0
+          };
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          const t = e.changedTouches[0];
+          return {
+            x: t.clientX ?? t.pageX ?? t.screenX ?? 0,
+            y: t.clientY ?? t.pageY ?? t.screenY ?? 0
+          };
+        }
+        if (typeof e.clientX === 'number' || typeof e.pageX === 'number' || typeof e.screenX === 'number') {
+          return {
+            x: e.clientX ?? e.pageX ?? e.screenX ?? 0,
+            y: e.clientY ?? e.pageY ?? e.screenY ?? 0
+          };
+        }
+        return null;
+      }
+
+      cards.forEach((card) => {
+        card._currentOffset = 0;
+        let activeType = null;
+        let startX = 0;
+        let startY = 0;
+        let currentX = 0;
+        let startOffset = 0;
+        let isDragging = false;
+        let hasMoved = false;
+        let suppressNextClick = false;
+        let lastEvent = null;
+
+        function onStart(e, type) {
+          if (e.target && e.target.closest('.card-actions')) {
+            return;
+          }
+          if (type === 'mouse' && typeof e.button === 'number' && e.button !== 0) {
+            return;
+          }
+          if (activeType !== null) {
+            if (activeType === 'pointer' && type === 'touch') {
+              activeType = 'touch';
+            } else {
+              return;
+            }
+          } else {
+            activeType = type;
+          }
+
+          const coords = getEventCoords(e);
+          if (!coords) return;
+
+          startX = coords.x;
+          startY = coords.y;
+          currentX = coords.x;
+          startOffset = card._currentOffset || 0;
+          isDragging = true;
+          hasMoved = false;
+          closeOtherCards(card);
+        }
+
+        function onMove(e, type) {
+          if (!isDragging || activeType !== type || e === lastEvent) return;
+          lastEvent = e;
+
+          const coords = getEventCoords(e);
+          if (!coords) return;
+
+          const dx = coords.x - startX;
+          const dy = coords.y - startY;
+
+          if (!hasMoved) {
+            if (Math.abs(dx) < 5 && Math.abs(dy) < 5) {
+              return;
+            }
+            if (Math.abs(dy) > Math.abs(dx) * 1.5) {
+              isDragging = false;
+              activeType = null;
+              card.classList.remove('is-dragging');
+              return;
+            }
+            hasMoved = true;
+            card.classList.add('is-dragging');
+          }
+
+          if (e.cancelable) {
+            e.preventDefault();
+          }
+
+          currentX = coords.x;
+          const maxReveal = getActionWidth(card);
+          let rawOffset = startOffset + dx;
+
+          // Clamp horizontal translation to reveal contextual buttons without auto-executing any action
+          if (rawOffset < -maxReveal) {
+            rawOffset = -maxReveal - (Math.abs(rawOffset + maxReveal) * 0.15);
+          } else if (rawOffset > maxReveal) {
+            rawOffset = maxReveal + ((rawOffset - maxReveal) * 0.15);
+          }
+
+          // If starting from open state and swiping back toward 0, clamp at 0
+          if (startOffset < 0 && rawOffset > 0) {
+            rawOffset = 0;
+          } else if (startOffset > 0 && rawOffset < 0) {
+            rawOffset = 0;
+          }
+
+          setCardOffset(card, rawOffset, Math.abs(rawOffset) >= SWIPE_THRESHOLD);
+        }
+
+        function onEnd(e, type) {
+          if (!isDragging || activeType !== type || e === lastEvent) return;
+          lastEvent = e;
+
+          const coords = getEventCoords(e);
+          if (!hasMoved && coords && Math.abs(coords.x - startX) >= SWIPE_THRESHOLD) {
+            currentX = coords.x;
+            hasMoved = true;
+          }
+
+          isDragging = false;
+          activeType = null;
+          card.classList.remove('is-dragging');
+
+          if (!hasMoved) {
+            return;
+          }
+
+          suppressNextClick = true;
+          setTimeout(() => {
+            suppressNextClick = false;
+          }, 50);
+
+          const dx = currentX - startX;
+          const maxReveal = getActionWidth(card);
+          const projected = startOffset + dx;
+
+          if (startOffset === 0) {
+            if (dx <= -SWIPE_THRESHOLD) {
+              setCardOffset(card, -maxReveal, true);
+            } else if (dx >= SWIPE_THRESHOLD) {
+              setCardOffset(card, maxReveal, true);
+            } else {
+              setCardOffset(card, 0, false);
+            }
+          } else if (startOffset < 0) {
+            if (dx >= SWIPE_THRESHOLD || projected > -maxReveal / 2) {
+              setCardOffset(card, 0, false);
+            } else {
+              setCardOffset(card, -maxReveal, true);
+            }
+          } else if (startOffset > 0) {
+            if (dx <= -SWIPE_THRESHOLD || projected < maxReveal / 2) {
+              setCardOffset(card, 0, false);
+            } else {
+              setCardOffset(card, maxReveal, true);
+            }
+          }
+        }
+
+        card.addEventListener('pointerdown', (e) => onStart(e, 'pointer'));
+        card.addEventListener('touchstart', (e) => onStart(e, 'touch'), { passive: true });
+        card.addEventListener('mousedown', (e) => onStart(e, 'mouse'));
+
+        card.addEventListener('pointermove', (e) => onMove(e, 'pointer'));
+        card.addEventListener('touchmove', (e) => onMove(e, 'touch'), { passive: false });
+        card.addEventListener('mousemove', (e) => onMove(e, 'mouse'));
+
+        card.addEventListener('pointerup', (e) => onEnd(e, 'pointer'));
+        card.addEventListener('pointercancel', (e) => onEnd(e, 'pointer'));
+        card.addEventListener('touchend', (e) => onEnd(e, 'touch'));
+        card.addEventListener('touchcancel', (e) => onEnd(e, 'touch'));
+        card.addEventListener('mouseup', (e) => onEnd(e, 'mouse'));
+
+        document.addEventListener('pointermove', (e) => onMove(e, 'pointer'));
+        document.addEventListener('touchmove', (e) => onMove(e, 'touch'), { passive: false });
+        document.addEventListener('mousemove', (e) => onMove(e, 'mouse'));
+
+        document.addEventListener('pointerup', (e) => onEnd(e, 'pointer'));
+        document.addEventListener('pointercancel', (e) => onEnd(e, 'pointer'));
+        document.addEventListener('touchend', (e) => onEnd(e, 'touch'));
+        document.addEventListener('touchcancel', (e) => onEnd(e, 'touch'));
+        document.addEventListener('mouseup', (e) => onEnd(e, 'mouse'));
+
+        // Prevent accidental link navigation right after finishing a drag gesture
+        card.addEventListener('click', (e) => {
+          if (suppressNextClick && !e.target.closest('.card-actions')) {
+            e.preventDefault();
+            e.stopPropagation();
+            suppressNextClick = false;
+          }
+        }, true);
+
+        // Explicit contextual button actions (only triggered when user clicks a button)
+        const actionButtons = card.querySelectorAll('.action-btn');
+        actionButtons.forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const action = btn.getAttribute('data-action');
+            const drink = btn.getAttribute('data-drink') || card.getAttribute('data-drink');
+            const badge = card.querySelector('.card-status-badge');
+
+            if (action === 'order') {
+              if (badge) badge.textContent = 'Added to Order';
+              if (feedbackEl) feedbackEl.textContent = `Added ${drink} to your order.`;
+            } else if (action === 'customize') {
+              if (badge) badge.textContent = 'Customizing...';
+              if (feedbackEl) feedbackEl.textContent = `Customizing options for ${drink}.`;
+            } else if (action === 'favorite') {
+              const isFav = btn.classList.toggle('is-favorited');
+              btn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+              const icon = btn.querySelector('.action-icon');
+              const label = btn.querySelector('.action-label');
+              if (icon) icon.textContent = isFav ? '♥' : '♡';
+              if (label) label.textContent = isFav ? 'Saved' : 'Favorite';
+              if (badge) badge.textContent = isFav ? '♥ Favorited' : '';
+              if (feedbackEl) {
+                feedbackEl.textContent = isFav
+                  ? `Saved ${drink} to your favorites.`
+                  : `Removed ${drink} from your favorites.`;
+              }
+            }
+
+            setCardOffset(card, 0, false);
+          });
+        });
+      });
+
+      // Close open swipe drawer when clicking outside cards or pressing Escape
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('#seasonal-favorites .card')) {
+          closeOtherCards(null);
+        }
+      });
+
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          closeOtherCards(null);
+        }
+      });
+    })();
+  </script>
