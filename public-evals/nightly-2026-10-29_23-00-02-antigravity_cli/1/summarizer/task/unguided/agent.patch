+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const journalTextEl = document.getElementById('journal-text');
+    const summaryContainer = document.getElementById('journal-summary');
+    const summaryContent = document.getElementById('journal-summary-content');
+
+    function renderBulletPoints(rawSummary) {
+      const lines = rawSummary
+        .split(/\r?\n/)
+        .map((line) => line.trim())
+        .filter((line) => line.length > 0);
+
+      const ul = document.createElement('ul');
+      for (const line of lines) {
+        const cleaned = line
+          .replace(/^([*\-•+]|\d+[.)])\s+/, '')
+          .trim();
+        if (!cleaned) continue;
+
+        const li = document.createElement('li');
+        // Render basic bold markdown safely if present
+        const parts = cleaned.split(/(\*\*.*?\*\*)/g);
+        for (const part of parts) {
+          if (part.startsWith('**') && part.endsWith('**') && part.length > 4) {
+            const strong = document.createElement('strong');
+            strong.textContent = part.slice(2, -2);
+            li.appendChild(strong);
+          } else {
+            li.appendChild(document.createTextNode(part));
+          }
+        }
+        ul.appendChild(li);
+      }
+
+      summaryContent.innerHTML = '';
+      summaryContent.appendChild(ul);
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summaryContainer.hidden = false;
+      summarizeBtn.disabled = true;
+      const originalBtnText = summarizeBtn.textContent;
+      summarizeBtn.textContent = 'Summarizing...';
+      summaryContent.innerHTML = '<p class="summary-status">Generating summary with browser AI...</p>';
+
+      try {
+        if (!('Summarizer' in self)) {
+          throw new Error('The native Summarizer AI API is not supported in this browser.');
+        }
+
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          throw new Error('The browser AI Summarizer model is unavailable on this device.');
+        }
+
+        const summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'An article from a specialty coffee roaster about their ethical bean sourcing and processing practices.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (typeof e.loaded === 'number') {
+                const pct = Math.round(e.loaded * 100);
+                summaryContent.innerHTML = `<p class="summary-status">Downloading browser AI model (${pct}%)...</p>`;
+              }
+            });
+          }
+        });
+
+        const articleText = journalTextEl.innerText.trim();
+        const summary = await summarizer.summarize(articleText);
+        renderBulletPoints(summary);
+
+        if (typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.textContent = 'Summarize';
+      } catch (err) {
+        summaryContent.innerHTML = '';
+        const errorMsg = document.createElement('p');
+        errorMsg.className = 'summary-status';
+        errorMsg.textContent = err.message || 'Unable to generate summary using browser AI.';
+        summaryContent.appendChild(errorMsg);
+        summarizeBtn.textContent = originalBtnText;
+      } finally {
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
