+    <section class="journal-section" id="roasters-journal">
+      <h2 style="text-align: center;">Roaster's Journal</h2>
+      <article class="journal-card">
+        <div class="journal-header">
+          <div>
+            <h3>From High-Altitude Farms to Your Morning Cup: How We Source Our Beans</h3>
+            <p class="journal-meta">By Master Roaster Elena Vance &bull; Bean Sourcing &amp; Sustainability</p>
+          </div>
+          <button type="button" id="summarize-btn" class="btn">Summarize</button>
+        </div>
+
+        <div id="journal-summary" class="journal-summary" aria-live="polite" hidden>
+          <h4>Key Takeaways</h4>
