+        <div id="download-progress-wrapper" class="download-progress-wrapper" hidden>
+          <label for="download-progress">Downloading local AI model:</label>
+          <progress id="download-progress" value="0" max="100"></progress>
+        </div>
+        <p id="summarize-status" class="summarize-status" role="status" aria-live="polite" hidden></p>
+      </div>
+
+      <div id="summary-container" class="summary-container" aria-live="polite" hidden>
+        <h3>Key Takeaways</h3>
+        <ul id="summary-list" class="summary-list"></ul>
+      </div>
+    </section>
