+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const journalArticle = document.getElementById('journal-article');
+    const summaryContainer = document.getElementById('summary-container');
+    const summaryList = document.getElementById('summary-list');
+    const statusText = document.getElementById('summarize-status');
+    const progressWrapper = document.getElementById('download-progress-wrapper');
+    const progressBar = document.getElementById('download-progress');
+
+    const summarizerOptions = {
+      sharedContext: 'An article from a specialty coffee roaster journal detailing their ethical bean sourcing and roasting process.',
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'medium',
+    };
+
+    function showUnavailableMessage(message) {
+      summarizeBtn.disabled = true;
+      statusText.textContent = message;
+      statusText.hidden = false;
+    }
+
+    function renderSummaryBullets(summaryText) {
+      summaryList.replaceChildren();
+      const lines = summaryText
+        .split('\n')
+        .map((line) => line.replace(/^(\s*[-*•]|\s*\d+[.)])\s*/, '').trim())
+        .filter(Boolean);
+
+      for (const point of lines) {
+        const li = document.createElement('li');
+        li.textContent = point;
+        summaryList.appendChild(li);
+      }
+
+      summaryContainer.hidden = lines.length === 0;
+    }
+
+    async function initSummarizerAvailability() {
+      if (!('Summarizer' in self)) {
+        showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+        }
+      } catch {
+        showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+      }
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      statusText.hidden = true;
+
+      let isUnavailable = false;
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          isUnavailable = true;
+          showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+          return;
+        }
+
+        const summarizer = await Summarizer.create({
+          ...summarizerOptions,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = e.total ? Math.round((e.loaded / e.total) * 100) : 0;
+              console.log(`Downloaded ${percent}%`);
+              progressWrapper.hidden = false;
+              progressBar.value = percent;
+            });
+          },
+        });
+
+        progressWrapper.hidden = true;
+        const summary = await summarizer.summarize(journalArticle.innerText, {
+          context: 'Distill this coffee bean sourcing article into concise bullet points for customers.',
+        });
+
+        renderSummaryBullets(summary);
+      } catch (err) {
+        statusText.textContent = 'Unable to generate summary on this device.';
+        statusText.hidden = false;
+        console.error(err);
+      } finally {
+        progressWrapper.hidden = true;
+        if ('Summarizer' in self && !isUnavailable) {
+          summarizeBtn.disabled = false;
+        }
+      }
+    });
+
+    initSummarizerAvailability();
+  </script>
+
 </body>
 
