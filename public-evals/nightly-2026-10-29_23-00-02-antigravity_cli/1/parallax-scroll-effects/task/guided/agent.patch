+    /* Scroll-Driven Parallax Section */
+    .parallax-wrapper {
+      position: relative;
+      overflow: clip;
+      height: 80vh;
+      min-height: 500px;
+      background-color: #2d1b15;
+      color: var(--light);
+      display: grid;
+      place-items: center;
+    }
+
+    .parallax-layer {
+      grid-area: 1 / 1;
+      width: 100%;
+      height: 100%;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      pointer-events: none;
+    }
+
+    .parallax-layer--bg {
+      background: linear-gradient(rgba(30, 18, 14, 0.65), rgba(30, 18, 14, 0.75)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1400&q=80') center / cover no-repeat;
+      height: 120%;
+    }
+
+    .parallax-layer--mid {
+      justify-content: space-between;
+      max-width: 1100px;
+      padding: 0 40px;
+      gap: 20px;
+    }
+
+    .parallax-photo {
+      width: 240px;
+      height: 300px;
+      object-fit: cover;
+      border-radius: 12px;
+      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
+      border: 3px solid rgba(215, 204, 200, 0.25);
+    }
+
+    .parallax-photo--left {
+      align-self: flex-start;
+      margin-top: 10%;
+    }
+
+    .parallax-photo--right {
+      align-self: flex-end;
+      margin-bottom: 10%;
+    }
+
+    .parallax-layer--fg {
+      pointer-events: auto;
+      z-index: 2;
+      padding: 20px;
+    }
+
+    .parallax-card {
+      background: rgba(62, 39, 35, 0.88);
+      backdrop-filter: blur(8px);
+      border: 1px solid rgba(255, 171, 64, 0.35);
+      border-radius: 12px;
+      padding: 40px 32px;
+      max-width: 540px;
+      text-align: center;
+      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
+    }
+
+    .parallax-eyebrow {
+      display: inline-block;
+      text-transform: uppercase;
+      letter-spacing: 2px;
+      font-size: 0.8rem;
+      color: var(--accent);
+      font-weight: 700;
+      margin-bottom: 0.5rem;
+    }
+
+    .parallax-card h2 {
+      font-size: 2.2rem;
+      margin-bottom: 1rem;
+      color: #fff;
+    }
+
+    .parallax-card p {
+      color: var(--secondary);
+      margin-bottom: 0.5rem;
+    }
+
+    @keyframes parallax {
+      from {
+        transform: translateY(var(--offset, calc(120px * sibling-index())));
+      }
+      to {
+        transform: translateY(calc(-0.35 * var(--offset, calc(120px * sibling-index()))));
+      }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      .parallax-wrapper {
+        view-timeline: --parallax-wrapper;
+      }
+
+      .parallax-layer:nth-child(1) {
+        --offset: 80px;
+      }
+
+      .parallax-layer:nth-child(2) {
+        --offset: 200px;
+      }
+
+      .parallax-layer:nth-child(3) {
+        --offset: 340px;
+      }
+
+      .parallax-layer {
+        animation: parallax linear both;
+        animation-timeline: --parallax-wrapper;
+        animation-range: entry 0% exit 100%;
+
+        @media (prefers-reduced-motion: reduce) {
+          animation: none;
+        }
+      }
+    }
+
+    @media (max-width: 768px) {
+      .parallax-photo {
+        width: 150px;
+        height: 190px;
+        opacity: 0.55;
+      }
+    }
+
