+    /* Scroll-Driven Parallax Section */
+    .parallax-section {
+      position: relative;
+      min-height: 75vh;
+      overflow: clip;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      background-color: #261714;
+      color: var(--light);
+      padding: 6rem 5%;
+       isolation: isolate;
+      view-timeline-name: --parallax-scroll;
+      view-timeline-axis: block;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    /* Layer 1: Deep Background (Slowest) */
+    .parallax-layer--bg {
+      inset: -20% 0;
+      z-index: 1;
+      background:
+        linear-gradient(180deg, rgba(38, 23, 20, 0.75) 0%, rgba(38, 23, 20, 0.45) 50%, rgba(38, 23, 20, 0.85) 100%),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=80') center / cover no-repeat;
+    }
+
+    /* Layer 2: Midground Imagery (Medium Speed) */
+    .parallax-layer--mid {
+      z-index: 2;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 0 2rem;
+    }
+
+    .parallax-photo {
+      width: clamp(180px, 22vw, 280px);
+      aspect-ratio: 4 / 5;
+      object-fit: cover;
+      border-radius: 12px;
+      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
+      border: 2px solid rgba(255, 171, 64, 0.3);
+      opacity: 0.85;
+    }
+
+    .parallax-photo--left {
+      align-self: flex-start;
+      margin-top: 3rem;
+    }
+
+    .parallax-photo--right {
+      align-self: flex-end;
+      margin-bottom: 3rem;
+    }
+
+    /* Layer 3: Foreground Accent Elements (Fastest Speed) */
+    .parallax-layer--fg {
+      z-index: 4;
+      max-width: 1280px;
+      margin: 0 auto;
+    }
+
+    .parallax-badge {
+      position: absolute;
+      background: rgba(78, 52, 46, 0.88);
+      border: 1px solid rgba(255, 171, 64, 0.5);
+      color: var(--accent);
+      padding: 0.75rem 1.25rem;
+      border-radius: 999px;
+      font-weight: 600;
+      font-size: 0.85rem;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
+    }
+
+    .parallax-badge--top {
+      top: 14%;
+      right: 12%;
+    }
+
+    .parallax-badge--bottom {
+      bottom: 14%;
+      left: 12%;
+    }
+
+    /* Layer 4: Foreground Story Content */
+    .parallax-content {
+      position: relative;
+      z-index: 3;
+      max-width: 640px;
+      text-align: center;
+      background: rgba(38, 23, 20, 0.82);
+      border: 1px solid rgba(215, 204, 200, 0.2);
+      border-radius: 16px;
+      padding: 3rem 2.5rem;
+      box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
+    }
+
+    .parallax-eyebrow {
+      display: inline-block;
+      color: var(--accent);
+      text-transform: uppercase;
+      letter-spacing: 2px;
+      font-size: 0.85rem;
+      font-weight: 700;
+      margin-bottom: 0.75rem;
+    }
+
+    .parallax-content h2 {
+      font-size: clamp(1.8rem, 3.5vw, 2.5rem);
+      margin-bottom: 1rem;
+      color: #ffffff;
+      line-height: 1.25;
+    }
+
+    .parallax-content p {
+      color: var(--secondary);
+      font-size: 1.05rem;
+      margin-bottom: 1.5rem;
+    }
+
+    .parallax-stats {
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 1rem;
+      border-top: 1px solid rgba(215, 204, 200, 0.2);
+      padding-top: 1.5rem;
+      margin-top: 0.5rem;
+    }
+
+    .parallax-stat strong {
+      display: block;
+      font-size: 1.4rem;
+      color: var(--accent);
+    }
+
+    .parallax-stat span {
+      font-size: 0.8rem;
+      color: var(--secondary);
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+    }
+
+    @keyframes parallax-shift {
+      from {
+        transform: translate3d(0, var(--shift-from, 0px), 0);
+      }
+      to {
+        transform: translate3d(0, var(--shift-to, 0px), 0);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .parallax-layer--bg,
+        .parallax-layer--mid,
+        .parallax-content,
+        .parallax-layer--fg {
+          will-change: transform;
+          animation-name: parallax-shift;
+          animation-timing-function: linear;
+          animation-fill-mode: both;
+          animation-timeline: --parallax-scroll;
+          animation-range: entry 0% exit 100%;
+        }
+
+        .parallax-layer--bg {
+          --shift-from: -90px;
+          --shift-to: 90px;
+        }
+
+        .parallax-layer--mid {
+          --shift-from: 110px;
+          --shift-to: -110px;
+        }
+
+        .parallax-content {
+          --shift-from: 45px;
+          --shift-to: -45px;
+        }
+
+        .parallax-layer--fg {
+          --shift-from: 200px;
+          --shift-to: -200px;
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .parallax-layer--bg,
+      .parallax-layer--mid,
+      .parallax-content,
+      .parallax-layer--fg {
+        animation: none !important;
+        transform: none !important;
+        will-change: auto;
+      }
+    }
+
+    @media (max-width: 768px) {
+      .parallax-layer--mid {
+        opacity: 0.35;
+        padding: 0 1rem;
+      }
+
+      .parallax-badge {
+        display: none;
+      }
+
+      .parallax-content {
+        padding: 2rem 1.5rem;
+      }
+
+      .parallax-stats {
+        grid-template-columns: 1fr;
+      }
+    }
+
