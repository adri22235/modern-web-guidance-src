+  <div id="auth-modal-backdrop" class="auth-modal-backdrop" aria-hidden="true">
+    <div class="auth-modal" role="dialog" aria-labelledby="auth-modal-title" aria-modal="true">
+      <h2 id="auth-modal-title">Sign In</h2>
+      <p>Sign in to continue without leaving your page.</p>
+      <form id="fallback-login-form">
+        <label for="username">Email or Username</label>
+        <input id="username" name="username" type="text" autocomplete="username webauthn" required>
+        <label for="password">Password</label>
+        <input id="password" name="password" type="password" autocomplete="current-password" required>
+        <div class="auth-modal-actions">
+          <button type="button" id="auth-modal-close" class="btn-secondary">Continue Browsing</button>
+          <button type="submit" class="btn" style="margin-top: 0; border: none; cursor: pointer;">Sign In</button>
+        </div>
+      </form>
+    </div>
+  </div>
+
+  <script>
+    const authStatus = document.getElementById('auth-status');
+    const authModalBackdrop = document.getElementById('auth-modal-backdrop');
+    const authModalClose = document.getElementById('auth-modal-close');
+    const fallbackLoginForm = document.getElementById('fallback-login-form');
+
+    function showSignedInStatus(message) {
+      if (authStatus) {
+        authStatus.textContent = message;
+        authStatus.classList.add('visible');
+      }
+      if (authModalBackdrop) {
+        authModalBackdrop.classList.remove('open');
+        authModalBackdrop.setAttribute('aria-hidden', 'true');
+      }
+    }
+
+    function showFallbackLoginUI() {
+      if (authModalBackdrop) {
+        authModalBackdrop.classList.add('open');
+        authModalBackdrop.setAttribute('aria-hidden', 'false');
+      }
+    }
+
+    async function checkImmediateMediationAvailability() {
+      if (!window.PublicKeyCredential || typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        return false;
+      }
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.immediateGet && window.PasswordCredential) {
+          console.log('Immediate Mediation with passwords supported.');
+          return true;
+        } else if (capabilities.immediateGet) {
+          console.log('Immediate Mediation without passwords supported.');
+          return true;
+        } else {
+          console.log('Immediate Mediation unsupported.');
+          return false;
+        }
+      } catch (error) {
+        console.error('Error getting client capabilities:', error);
+        return false;
+      }
+    }
+
+    checkImmediateMediationAvailability();
+
+    async function signInWithImmediateMediation(event) {
+      event.preventDefault();
+      event.stopPropagation();
+
+      try {
+        const challenge = window.crypto.getRandomValues(new Uint8Array(32));
+        const cred = await navigator.credentials.get({
+          password: true,
+          publicKey: {
+            challenge,
+            rpId: window.location.hostname || 'localhost',
+          },
+          mediation: 'immediate',
+        });
+
+        if (cred) {
+          const userLabel = cred.name || cred.id || 'Returning Customer';
+          showSignedInStatus(`Signed in as ${userLabel}`);
+        }
+      } catch (error) {
+        if (error.name === 'NotAllowedError') {
+          console.log('No immediate credentials available. Showing fallback sign-in UI.');
+          showFallbackLoginUI();
+        } else {
+          console.error('Error during sign-in:', error);
+          showFallbackLoginUI();
+        }
+      }
+    }
+
+    document.querySelectorAll('a:not(.logout-link)').forEach((link) => {
+      link.addEventListener('click', signInWithImmediateMediation);
+    });
+
+    const logoutLink = document.querySelector('.logout-link');
+    if (logoutLink) {
+      logoutLink.addEventListener('click', async (event) => {
+        event.preventDefault();
+        if (navigator.credentials && typeof navigator.credentials.preventSilentAccess === 'function') {
+          try {
+            await navigator.credentials.preventSilentAccess();
+          } catch (error) {
+            console.error('Error preventing silent access:', error);
+          }
+        }
+        if (authStatus) {
+          authStatus.textContent = '';
+          authStatus.classList.remove('visible');
+        }
+      });
+    }
+
+    if (authModalClose) {
+      authModalClose.addEventListener('click', () => {
+        authModalBackdrop.classList.remove('open');
+        authModalBackdrop.setAttribute('aria-hidden', 'true');
+      });
+    }
+
+    if (fallbackLoginForm) {
+      fallbackLoginForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const usernameInput = document.getElementById('username');
+        const userLabel = (usernameInput && usernameInput.value) || 'Customer';
+        showSignedInStatus(`Signed in as ${userLabel}`);
+      });
+    }
+  </script>
+
 </body>
 
 </html>
