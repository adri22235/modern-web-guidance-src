+  <script type="module">
+    import 'webauthn-polyfills';
+
+    let isAuthenticating = false;
+    let pendingIntent = null;
+
+    const statusBanner = document.getElementById('auth-status-banner');
+    const navUserItem = document.getElementById('nav-user-item');
+    const navUserBadge = document.getElementById('nav-user-badge');
+    const navSigninItem = document.getElementById('nav-signin-item');
+    const logoutLink = document.getElementById('logout-link');
+    const signinDialog = document.getElementById('signin-dialog');
+    const signinSubtitle = document.getElementById('signin-dialog-subtitle');
+    const signinForm = document.getElementById('signin-form');
+    const signinFormError = document.getElementById('signin-form-error');
+    const closeSigninDialogBtn = document.getElementById('close-signin-dialog');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const passwordInput = document.getElementById('current-password');
+
+    // Light-dismiss fallback for browsers without native <dialog closedby="any">
+    if (signinDialog && !('closedBy' in HTMLDialogElement.prototype)) {
+      signinDialog.addEventListener('click', (event) => {
+        if (event.target !== signinDialog) return;
+        const rect = signinDialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+        if (isDialogContent) return;
+        signinDialog.close();
+      });
+    }
+
+    signinDialog?.addEventListener('close', () => {
+      signinDialog.returnValue = '';
+      signinFormError.hidden = true;
+      signinFormError.textContent = '';
+    });
+
+    closeSigninDialogBtn?.addEventListener('click', () => {
+      signinDialog.close();
+    });
+
+    togglePasswordBtn?.addEventListener('click', () => {
+      const showing = passwordInput.type === 'text';
+      passwordInput.type = showing ? 'password' : 'text';
+      togglePasswordBtn.setAttribute('aria-pressed', String(!showing));
+      togglePasswordBtn.textContent = showing ? 'Show password' : 'Hide password';
+    });
+
+    function showBanner(message, isError = false) {
+      if (!statusBanner) return;
+      statusBanner.textContent = message;
+      statusBanner.classList.toggle('error', isError);
+      statusBanner.hidden = false;
+    }
+
+    function updateHeaderUserState(user) {
+      const displayName = user?.username || user?.name || user?.email || 'Member';
+      document.body.dataset.signedIn = 'true';
+      if (navUserBadge && navUserItem) {
+        navUserBadge.textContent = `Welcome, ${displayName}`;
+        navUserItem.hidden = false;
+      }
+      if (navSigninItem) {
+        navSigninItem.hidden = true;
+      }
+    }
+
+    function completeUserIntent(intent, user) {
+      updateHeaderUserState(user);
+      const displayName = user?.username || user?.name || user?.email || 'Member';
+
+      if (!intent) {
+        showBanner(`Signed in as ${displayName}.`);
+        return;
+      }
+
+      if (intent.type === 'favorite' && intent.button) {
+        const nextPressed = intent.button.getAttribute('aria-pressed') !== 'true';
+        intent.button.setAttribute('aria-pressed', String(nextPressed));
+        const itemName = intent.button.dataset.favoriteItem || 'item';
+        showBanner(
+          nextPressed
+            ? `Signed in as ${displayName} and saved ${itemName} to your favorites.`
+            : `Removed ${itemName} from your favorites.`
+        );
+        return;
+      }
+
+      const label = intent.label || intent.action || 'your selection';
+      showBanner(`Signed in as ${displayName}. Viewing ${label}.`);
+    }
+
+    function showFallbackSignInUi(intent) {
+      pendingIntent = intent || null;
+      if (signinSubtitle) {
+        const targetLabel = intent?.label ? ` to access ${intent.label}` : '';
+        signinSubtitle.textContent = `Sign in${targetLabel} without leaving this page.`;
+      }
+      if (signinDialog && !signinDialog.open) {
+        signinDialog.showModal();
+      }
+    }
+
+    async function isImmediateUiSupported() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        return false;
+      }
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities?.immediateGet);
+      } catch {
+        return false;
+      }
+    }
+
+    async function authenticateWithImmediateUi() {
+      // MANDATORY: Check immediateGet support so unsupported browsers do not open a modal QR dialog
+      const supported = await isImmediateUiSupported();
+      if (!supported) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+
+      let optionsJSON;
+      const optionsResponse = await fetch('/api/login/options', { method: 'POST' });
+      if (!optionsResponse.ok) {
+        if (optionsResponse.status === 404) {
+          optionsJSON = {
+            challenge: 'dGhlLWRhaWx5LWdyaW5kLWNoYWxsZW5nZS0yMDI2',
+            rpId: window.location.hostname || 'localhost',
+            userVerification: 'preferred',
+          };
+        } else {
+          throw new Error('Failed to fetch authentication options');
+        }
+      } else {
+        optionsJSON = await optionsResponse.json();
+      }
+
+      // Omit non-empty allowCredentials for Immediate UI mode privacy requirements
+      delete optionsJSON.allowCredentials;
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+      if (publicKey.allowCredentials) {
+        delete publicKey.allowCredentials;
+      }
+
+      // MANDATORY: Request both password and publicKey with uiMode: 'immediate' and NO signal parameter
+      const cred = await navigator.credentials.get({
+        password: true,
+        publicKey,
+        uiMode: 'immediate',
+      });
+
+      if (!cred) {
+        throw new DOMException('No credential returned', 'NotAllowedError');
+      }
+
+      if (cred.type === 'public-key') {
+        const encoded = cred.toJSON();
+        const verifyResponse = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+
+        if (verifyResponse.status === 404) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId || window.location.hostname,
+              credentialId: encoded.id,
+            });
+          }
+          throw new Error('Passkey credential is no longer recognized by the server');
+        }
+
+        if (!verifyResponse.ok) {
+          throw new Error('Passkey verification failed');
+        }
+        return await verifyResponse.json();
+      }
+
+      if (cred.type === 'password') {
+        const verifyResponse = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: cred.id,
+            password: cred.password,
+          }),
+        });
+
+        if (!verifyResponse.ok) {
+          throw new Error('Password verification failed');
+        }
+        return await verifyResponse.json();
+      }
+
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    async function handleQuickSignInIntent(intent) {
+      if (isAuthenticating) return;
+
+      if (document.body.dataset.signedIn === 'true') {
+        completeUserIntent(intent, { username: navUserBadge?.textContent?.replace(/^Welcome,\s*/, '') || 'Member' });
+        return;
+      }
+
+      isAuthenticating = true;
+      try {
+        const user = await authenticateWithImmediateUi();
+        completeUserIntent(intent, user);
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          showFallbackSignInUi(intent);
+          return;
+        }
+        console.error('Authentication error:', err);
+        showBanner(err.message || 'Sign-in could not be completed. Please try signing in below.', true);
+        showFallbackSignInUi(intent);
+      } finally {
+        isAuthenticating = false;
+      }
+    }
+
+    // Attach quick sign-in handlers to navigation and action links
+    document.querySelectorAll('[data-quick-signin]').forEach((link) => {
+      link.addEventListener('click', async (event) => {
+        event.preventDefault();
+        await handleQuickSignInIntent({
+          type: 'link',
+          action: link.dataset.quickSignin,
+          href: link.getAttribute('href'),
+          label: link.textContent.trim(),
+        });
+      });
+    });
+
+    // Attach quick sign-in handlers to inline favorite micro-action buttons
+    document.querySelectorAll('.favorite-btn').forEach((button) => {
+      button.addEventListener('click', async (event) => {
+        event.preventDefault();
+        await handleQuickSignInIntent({
+          type: 'favorite',
+          button,
+          label: button.dataset.favoriteItem,
+        });
+      });
+    });
+
+    // Handle inline fallback sign-in form submission
+    signinForm?.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      signinFormError.hidden = true;
+      const formData = new FormData(signinForm);
+      const username = String(formData.get('email') || '').trim();
+      const password = String(formData.get('password') || '');
+
+      try {
+        const verifyResponse = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, password }),
+        });
+
+        let user = { username };
+        if (verifyResponse.ok) {
+          user = await verifyResponse.json();
+        } else if (verifyResponse.status !== 404) {
+          throw new Error('Invalid email or password.');
+        }
+
+        signinDialog.close();
+        completeUserIntent(pendingIntent, user);
+        pendingIntent = null;
+      } catch (err) {
+        signinFormError.textContent = err.message || 'Unable to sign in. Please try again.';
+        signinFormError.hidden = false;
+      }
+    });
+
+    // Handle logout in place
+    logoutLink?.addEventListener('click', (event) => {
+      event.preventDefault();
+      document.body.dataset.signedIn = 'false';
+      if (navUserItem) navUserItem.hidden = true;
+      if (navSigninItem) navSigninItem.hidden = false;
+      document.querySelectorAll('.favorite-btn').forEach((btn) => {
+        btn.setAttribute('aria-pressed', 'false');
+      });
+      showBanner('You have been signed out.');
+    });
+  </script>
+
