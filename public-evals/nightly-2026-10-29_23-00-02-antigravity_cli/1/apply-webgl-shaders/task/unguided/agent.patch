+      }
+
+      function updatePointerFromEvent(clientX, clientY, boost) {
+        const rect = hero.getBoundingClientRect();
+        if (rect.width <= 0 || rect.height <= 0) return;
+        const u = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
+        const v = Math.max(0, Math.min(1, (clientY - rect.top) / rect.height));
+        const dx = u - targetMouseUV.x;
+        const dy = v - targetMouseUV.y;
+        mouseVelocity.x = Math.max(-0.08, Math.min(0.08, dx));
+        mouseVelocity.y = Math.max(-0.08, Math.min(0.08, dy));
+        targetMouseUV.x = u;
+        targetMouseUV.y = v;
+
+        const now = getNowSec();
+        const distMoved = Math.hypot(dx, dy);
+        if (boost > 1.0 || (distMoved > 0.012 && now - lastRippleSpawnTime > 0.055)) {
+          addRipple(u, v, now, Math.min(1.5, (0.45 + distMoved * 8.0) * boost));
+          lastRippleSpawnTime = now;
+        }
+      }
+
+      hero.addEventListener(
+        'pointermove',
+        function (e) {
+          updatePointerFromEvent(e.clientX, e.clientY, 1.0);
+        },
+        { passive: true }
+      );
+
+      hero.addEventListener(
+        'pointerdown',
+        function (e) {
+          updatePointerFromEvent(e.clientX, e.clientY, 1.65);
+        },
+        { passive: true }
+      );
+
+      titleEl.addEventListener('pointerenter', function () {
+        isTitleHovered = true;
+        addRipple(titleUVRect[0], titleUVRect[1], getNowSec(), 0.95);
+      });
+      titleEl.addEventListener('pointerleave', function () {
+        isTitleHovered = false;
+      });
+
+      buttonEl.addEventListener('pointerenter', function () {
+        isButtonHovered = true;
+        addRipple(buttonUVRect[0], buttonUVRect[1], getNowSec(), 1.15);
+      });
+      buttonEl.addEventListener('pointerleave', function () {
+        isButtonHovered = false;
+      });
+
+      // Initial rasterization & mark hero as WebGL-ready
+      rasterizeHtmlToTexture();
+      hero.classList.add('webgl-ready');
+
+      // Seed initial ripples over 'Wake Up Your Senses' and 'Order Now'
+      addRipple(titleUVRect[0] - 0.12, titleUVRect[1], 0.0, 0.9);
+      addRipple(buttonUVRect[0], buttonUVRect[1], 0.15, 1.0);
+
+      let lastAmbientRippleTime = 0;
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(function () {
+          rasterizeHtmlToTexture();
+        });
+        ro.observe(hero);
+      } else {
+        window.addEventListener('resize', rasterizeHtmlToTexture);
+      }
+
+      gl.enable(gl.BLEND);
+      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+
+      function renderFrame() {
+        const nowSec = getNowSec();
+
+        // Periodically emit gentle ambient ripples across 'Wake Up Your Senses' and 'Order Now'
+        if (nowSec - lastAmbientRippleTime > 1.8) {
+          const targetIsButton = Math.floor(nowSec / 1.8) % 2 === 1;
+          const baseRect = targetIsButton ? buttonUVRect : titleUVRect;
+          const jitterX = (Math.sin(nowSec * 3.7) * 0.35) * baseRect[2];
+          const jitterY = (Math.cos(nowSec * 2.3) * 0.25) * baseRect[3];
+          addRipple(baseRect[0] + jitterX, baseRect[1] + jitterY, nowSec, targetIsButton ? 0.85 : 0.75);
+          lastAmbientRippleTime = nowSec;
+        }
+
+        // Smooth hover state transitions
+        const targetTH = isTitleHovered ? 1.0 : 0.0;
+        const targetBH = isButtonHovered ? 1.0 : 0.0;
+        currentTitleHover += (targetTH - currentTitleHover) * 0.12;
+        currentButtonHover += (targetBH - currentButtonHover) * 0.14;
+
+        if (Math.abs(currentButtonHover - renderedButtonHover) > 0.02) {
+          rasterizeHtmlToTexture();
+        }
+
+        // Smooth pointer tracking and velocity decay
+        mouseUV.x += (targetMouseUV.x - mouseUV.x) * 0.16;
+        mouseUV.y += (targetMouseUV.y - mouseUV.y) * 0.16;
+        mouseVelocity.x *= 0.88;
+        mouseVelocity.y *= 0.88;
+
+        gl.clearColor(0.0, 0.0, 0.0, 0.0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+
+        gl.useProgram(program);
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, htmlTexture);
+
+        gl.uniform1i(uTexture, 0);
+        gl.uniform1f(uTime, nowSec);
+        gl.uniform2f(uResolution, canvas.width, canvas.height);
+        gl.uniform2f(uMouse, mouseUV.x, mouseUV.y);
+        gl.uniform2f(uMouseVelocity, mouseVelocity.x, mouseVelocity.y);
+        gl.uniform2f(uHoverState, currentTitleHover, currentButtonHover);
+        gl.uniform4fv(uTitleRect, titleUVRect);
+        gl.uniform4fv(uButtonRect, buttonUVRect);
+        gl.uniform4fv(uRipples, rippleData);
+
+        gl.drawElements(gl.TRIANGLES, indices.length, gl.UNSIGNED_SHORT, 0);
+
+        requestAnimationFrame(renderFrame);
+      }
+
+      requestAnimationFrame(renderFrame);
+    })();
+  </script>
 </body>
 
