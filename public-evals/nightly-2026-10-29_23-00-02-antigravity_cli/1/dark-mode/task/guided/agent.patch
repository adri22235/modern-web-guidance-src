+  <script>
+    (function () {
+      const themeSelect = document.getElementById('theme-select');
+      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+      const root = document.documentElement;
+
+      function applyTheme(value, persist = true) {
+        const scheme = (value === 'light' || value === 'dark') ? value : 'light dark';
+
+        if (metaColorScheme) {
+          metaColorScheme.content = scheme;
+        }
+
+        // Force the chosen theme on the root element
+        root.style.colorScheme = scheme;
+
+        if (scheme === 'light' || scheme === 'dark') {
+          root.dataset.theme = scheme;
+        } else {
+          delete root.dataset.theme;
+        }
+
+        if (themeSelect && themeSelect.value !== scheme) {
+          themeSelect.value = scheme;
+        }
+
+        if (persist) {
+          try {
+            if (scheme === 'light dark') {
+              localStorage.removeItem('color-scheme');
+            } else {
+              localStorage.setItem('color-scheme', scheme);
+            }
+          } catch (e) {}
+        }
+      }
+
+      // Initialize select dropdown from current saved preference or meta tag
+      let initialScheme = 'light dark';
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          initialScheme = stored;
+        } else if (metaColorScheme && (metaColorScheme.content === 'light' || metaColorScheme.content === 'dark')) {
+          initialScheme = metaColorScheme.content;
+        }
+      } catch (e) {}
+
+      applyTheme(initialScheme, false);
+
+      themeSelect.addEventListener('change', (e) => {
+        applyTheme(e.target.value, true);
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          applyTheme(e.newValue ?? 'light dark', false);
+        }
+      });
+
+      // Interactive filter for Late Night Specials select menu
+      const specialsSelect = document.getElementById('specials-category');
+      const specialItems = document.querySelectorAll('#specials-list .special-item');
+
+      if (specialsSelect) {
+        specialsSelect.addEventListener('change', (e) => {
+          const category = e.target.value;
+          specialItems.forEach((item) => {
+            item.hidden = !(category === 'all' || item.dataset.category === category);
+          });
+        });
+      }
+    })();
+  </script>
+
