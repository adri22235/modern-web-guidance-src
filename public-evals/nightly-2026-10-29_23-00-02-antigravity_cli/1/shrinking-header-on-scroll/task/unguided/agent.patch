+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      var logo = document.querySelector('.logo');
+      var logoutLink = document.querySelector('.logout-link');
+      if (!nav) return;
+
+      var SCROLL_RANGE = 150;
+      var supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('animation-timeline', 'scroll()');
+
+      if (!supportsScrollTimeline) {
+        document.documentElement.classList.add('no-scroll-timeline');
+      }
+
+      function updateNavOnScroll() {
+        var scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(Math.max(scrollY / SCROLL_RANGE, 0), 1);
+        var progressStr = progress.toFixed(4);
+
+        document.documentElement.style.setProperty('--nav-scroll-progress', progressStr);
+        nav.style.setProperty('--nav-scroll-progress', progressStr);
+
+        if (scrollY > 10) {
+          nav.classList.add('scrolled');
+          nav.setAttribute('data-scrolled', 'true');
+        } else {
+          nav.classList.remove('scrolled');
+          nav.setAttribute('data-scrolled', 'false');
+        }
+
+        // Direct style interpolation fallback for older browsers without CSS Scroll-Driven Animations
+        if (!supportsScrollTimeline) {
+          var padRem = 1.25 - 0.85 * progress;
+          var logoRem = 1.5 - 0.35 * progress;
+          var shadowAlpha = 0.08 + 0.18 * progress;
+          var bgAlpha = 1 - 0.04 * progress;
+
+          nav.style.paddingTop = padRem.toFixed(3) + 'rem';
+          nav.style.paddingBottom = padRem.toFixed(3) + 'rem';
+          nav.style.backgroundColor = 'rgba(78, 52, 46, ' + bgAlpha.toFixed(3) + ')';
+          nav.style.boxShadow = '0 4px 12px rgba(0, 0, 0, ' + shadowAlpha.toFixed(3) + ')';
+
+          if (logo) {
+            logo.style.fontSize = logoRem.toFixed(3) + 'rem';
+          }
+
+          if (logoutLink) {
+            var vPad = 5 - 3 * progress;
+            var hPad = 12 - 2 * progress;
+            logoutLink.style.padding = vPad.toFixed(1) + 'px ' + hPad.toFixed(1) + 'px';
+          }
+        }
+      }
+
+      window.addEventListener('scroll', updateNavOnScroll, { passive: true });
+      window.addEventListener('resize', updateNavOnScroll, { passive: true });
+      updateNavOnScroll();
+    })();
+  </script>
