+  <script>
+    const searchInput = document.getElementById("search-input");
+    const menuCards = document.querySelectorAll(".grid .card");
+
+    // Cache text nodes in the menu cards using TreeWalker so we don't repeatedly walk the DOM
+    const allTextNodes = [];
+    for (const card of menuCards) {
+      const treeWalker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+      let currentNode = treeWalker.nextNode();
+      while (currentNode) {
+        if (currentNode.textContent.trim().length > 0) {
+          allTextNodes.push(currentNode);
+        }
+        currentNode = treeWalker.nextNode();
+      }
+    }
+
+    function clearFallbackMarks() {
+      for (const card of menuCards) {
+        const marks = card.querySelectorAll("mark.search-highlight");
+        for (const mark of marks) {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        }
+        card.normalize();
+      }
+    }
+
+    function updateHighlights() {
+      const searchTerm = searchInput.value.trim().toLowerCase();
+
+      if (CSS.highlights) {
+        CSS.highlights.clear();
+        if (!searchTerm) return;
+
+        const matchingRanges = [];
+        for (const textNode of allTextNodes) {
+          const text = textNode.textContent.toLowerCase();
+          let startPos = 0;
+          while (startPos < text.length) {
+            const matchStartIndex = text.indexOf(searchTerm, startPos);
+            if (matchStartIndex === -1) break;
+            const matchEndIndex = matchStartIndex + searchTerm.length;
+
+            const range = new Range();
+            range.setStart(textNode, matchStartIndex);
+            range.setEnd(textNode, matchEndIndex);
+            matchingRanges.push(range);
+
+            startPos = matchEndIndex;
+          }
+        }
+
+        if (matchingRanges.length > 0) {
+          const searchHighlight = new Highlight(...matchingRanges);
+          CSS.highlights.set("search-results", searchHighlight);
+        }
+      } else {
+        // Fallback for browsers without CSS Custom Highlight API support
+        clearFallbackMarks();
+        if (!searchTerm) return;
+
+        for (const card of menuCards) {
+          const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+          const nodes = [];
+          for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+            nodes.push(n);
+          }
+
+          for (const textNode of nodes) {
+            const text = textNode.textContent;
+            let pos = text.toLowerCase().indexOf(searchTerm);
+            if (pos === -1) continue;
+
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            while (pos !== -1) {
+              frag.append(text.slice(last, pos));
+              const mark = document.createElement("mark");
+              mark.className = "search-highlight";
+              mark.textContent = text.slice(pos, pos + searchTerm.length);
+              frag.append(mark);
+              last = pos + searchTerm.length;
+              pos = text.toLowerCase().indexOf(searchTerm, last);
+            }
+            frag.append(text.slice(last));
+            textNode.replaceWith(frag);
+          }
+        }
+      }
+    }
+
+    searchInput.addEventListener("input", updateHighlights);
+  </script>
+
