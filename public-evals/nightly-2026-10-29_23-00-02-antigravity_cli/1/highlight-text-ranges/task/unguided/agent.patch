+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menuCards = document.querySelectorAll('.grid .card');
+
+    function updateHighlights() {
+      const query = searchInput.value;
+
+      menuCards.forEach((card) => {
+        card.querySelectorAll('mark.highlight').forEach((mark) => {
+          const parent = mark.parentNode;
+          parent.replaceChild(document.createTextNode(mark.textContent), mark);
+          parent.normalize();
+        });
+
+        if (!query || !query.trim()) return;
+
+        const escapedQuery = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+        const regex = new RegExp(`(${escapedQuery})`, 'gi');
+
+        const textElements = card.querySelectorAll('h3, p');
+        textElements.forEach((el) => {
+          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+          const textNodes = [];
+          let currentNode;
+          while ((currentNode = walker.nextNode())) {
+            textNodes.push(currentNode);
+          }
+
+          textNodes.forEach((textNode) => {
+            const text = textNode.nodeValue;
+            if (!regex.test(text)) return;
+            regex.lastIndex = 0;
+
+            const parts = text.split(regex);
+            const fragment = document.createDocumentFragment();
+
+            parts.forEach((part, index) => {
+              if (!part) return;
+              if (index % 2 === 1) {
+                const mark = document.createElement('mark');
+                mark.className = 'highlight';
+                mark.style.backgroundColor = 'gold';
+                mark.textContent = part;
+                fragment.appendChild(mark);
+              } else {
+                fragment.appendChild(document.createTextNode(part));
+              }
+            });
+
+            textNode.parentNode.replaceChild(fragment, textNode);
+          });
+        });
+      });
+    }
+
+    searchInput.addEventListener('input', updateHighlights);
+    searchInput.addEventListener('keyup', updateHighlights);
+    searchInput.addEventListener('search', updateHighlights);
+  </script>
+
 </body>
 
