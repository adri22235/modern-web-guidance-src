+          Math.min(
+            99.8,
+            Number(((acidity * 0.21 + body * 0.20 + sweetness * 0.26 + aroma * 0.22 + finish * 0.18) - balancePenalty).toFixed(1))
+          )
+        );
+
+        const grindMicrons = 350 + ((index * 29) % 650);
+        const doseGrams = 18 + (index % 5);
+        const yieldRatio = (14 + ((index * 3) % 5)).toFixed(1);
+
+        return {
+          id: index + 1,
+          name: `${primaryOrigin.name.split(' ')[0]} / ${secondaryOrigin.name.split(' ')[0]} Reserve #${index + 1}`,
+          composition: `${ratioA}% ${primaryOrigin.name}, ${ratioB}% ${secondaryOrigin.name}${ratioC > 0 ? `, ${ratioC}% ${tertiaryOrigin.name}` : ''}`,
+          recipeSpec: `${doseGrams}g dose • 1:${yieldRatio} • ${grindMicrons}μm grind • ${config.waterTemp}°C ${brewMod.label}`,
+          note: primaryOrigin.note,
+          acidity,
+          body,
+          sweetness,
+          aroma,
+          bitterness,
+          finish,
+          harmonyScore
+        };
+      }
+
+      function updateProgressUI(processed, total, yieldsCount, avgSliceMs, elapsedMs, stageText) {
+        const pct = total > 0 ? Math.min(100, Math.round((processed / total) * 100)) : 0;
+        progressStageLabel.textContent = stageText;
+        progressPercentage.textContent = `${pct}% (${processed.toLocaleString()} / ${total.toLocaleString()} blends)`;
+        progressFill.style.width = `${pct}%`;
+        progressBarContainer.setAttribute('aria-valuenow', String(pct));
+        metricYields.textContent = yieldsCount.toLocaleString();
+        metricSliceMs.textContent = `${avgSliceMs.toFixed(1)} ms`;
+        metricElapsed.textContent = `${Math.round(elapsedMs)} ms`;
+      }
+
+      function updateAggregateSensoryBars(totals, count) {
+        if (!count) return;
+        const keys = ['acidity', 'body', 'sweetness', 'aroma', 'bitterness', 'finish'];
+        for (const key of keys) {
+          const avg = Math.round(totals[key] / count);
+          const valEl = document.getElementById(`attr-val-${key}`);
+          const barEl = document.getElementById(`attr-bar-${key}`);
+          if (valEl) valEl.textContent = `${avg} / 100`;
+          if (barEl) barEl.style.width = `${avg}%`;
+        }
+      }
+
+      function renderTopBlends(blends, noteFilter) {
+        const filtered = noteFilter === 'all'
+          ? blends
+          : blends.filter((item) => item.note === noteFilter);
+
+        const topItems = filtered.slice(0, 8);
+        if (topItems.length === 0) {
+          blendResultsList.innerHTML = `
+            <div class="blend-item">
+              <div class="blend-item-info">
+                <h4>No matching blends for "${noteFilter}"</h4>
+                <p>Try selecting "All Notes" or running a larger recipe batch.</p>
+              </div>
+            </div>
+          `;
+          return;
+        }
+
+        blendResultsList.innerHTML = topItems
+          .map(
+            (blend) => `
+            <div class="blend-item">
+              <div class="blend-item-info">
+                <h4>${blend.name} <small style="font-weight: 500; color: #8d6e63;">(${blend.note})</small></h4>
+                <p>${blend.composition}</p>
+                <p>${blend.recipeSpec}</p>
+              </div>
+              <div class="blend-score-badge">${blend.harmonyScore}% Match</div>
+            </div>
+          `
+          )
+          .join('');
+      }
+
+      /**
+       * Runs the full batch flavor simulation while breaking up long tasks and yielding
+       * to the main thread so user interactions and animations remain responsive.
+       */
+      async function runFlavorSimulation() {
+        const runId = ++activeRunId;
+        isSimulating = true;
+
+        const totalBlends = parseInt(batchSizeSelect.value, 10) || 2000;
+        const config = {
+          roast: roastSelect.value,
+          brew: brewSelect.value,
+          waterTemp: parseFloat(waterTempInput.value) || 94
+        };
+
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        schedulerDot.classList.add('running');
+        schedulerStatusText.textContent = 'Simulating batch • Yielding to main thread';
+
+        const simulationStart = performance.now();
+        let sliceStart = performance.now();
+        let itemsInCurrentSlice = 0;
+        let yieldsCount = 0;
+        let totalSliceDurationMs = 0;
+        let sliceCount = 0;
+
+        const results = [];
+        const runningTotals = {
+          acidity: 0,
+          body: 0,
+          sweetness: 0,
+          aroma: 0,
+          bitterness: 0,
+          finish: 0
+        };
+
+        // Yield once before starting heavy batch work so button state updates paint immediately
+        await yieldToMain();
+        if (runId !== activeRunId) return;
+        sliceStart = performance.now();
+
+        for (let i = 0; i < totalBlends; i++) {
+          const profile = computeSingleBlendProfile(i, config);
+          results.push(profile);
+
+          runningTotals.acidity += profile.acidity;
+          runningTotals.body += profile.body;
+          runningTotals.sweetness += profile.sweetness;
+          runningTotals.aroma += profile.aroma;
+          runningTotals.bitterness += profile.bitterness;
+          runningTotals.finish += profile.finish;
+          itemsInCurrentSlice += 1;
+
+          if (shouldYieldToMain(sliceStart, itemsInCurrentSlice)) {
+            const sliceDuration = performance.now() - sliceStart;
+            totalSliceDurationMs += sliceDuration;
+            sliceCount += 1;
+            yieldsCount += 1;
+
+            const avgSliceMs = totalSliceDurationMs / sliceCount;
+            const elapsedMs = performance.now() - simulationStart;
+
+            updateProgressUI(
+              i + 1,
+              totalBlends,
+              yieldsCount,
+              avgSliceMs,
+              elapsedMs,
+              'Processing extraction kinetics & yielding to main thread...'
+            );
+            updateAggregateSensoryBars(runningTotals, i + 1);
+
+            await yieldToMain();
+            if (runId !== activeRunId) return;
+
+            sliceStart = performance.now();
+            itemsInCurrentSlice = 0;
+          }
+        }
+
+        // Record final slice telemetry before ranking phase
+        const finalSliceDuration = performance.now() - sliceStart;
+        totalSliceDurationMs += finalSliceDuration;
+        sliceCount += 1;
+
+        // Yield before sorting large results array to avoid combining sort with final chunk
+        yieldsCount += 1;
+        await yieldToMain();
+        if (runId !== activeRunId) return;
+
+        const sortStart = performance.now();
+        results.sort((a, b) => b.harmonyScore - a.harmonyScore);
+        totalSliceDurationMs += performance.now() - sortStart;
+        sliceCount += 1;
+
+        latestSimulatedBlends = results;
+        const totalElapsedMs = performance.now() - simulationStart;
+        const finalAvgSliceMs = totalSliceDurationMs / Math.max(1, sliceCount);
+
+        updateProgressUI(
+          totalBlends,
+          totalBlends,
+          yieldsCount,
+          finalAvgSliceMs,
+          totalElapsedMs,
+          'Simulation Complete • All tasks kept under 50ms threshold'
+        );
+        updateAggregateSensoryBars(runningTotals, totalBlends);
+        renderTopBlends(latestSimulatedBlends, selectedNoteFilter);
+
+        isSimulating = false;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+        schedulerDot.classList.remove('running');
+        schedulerStatusText.textContent = `Completed ${totalBlends.toLocaleString()} blends across ${yieldsCount} main-thread yields`;
+      }
+
+      function cancelSimulation() {
+        if (!isSimulating) return;
+        activeRunId += 1;
+        isSimulating = false;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+        schedulerDot.classList.remove('running');
+        schedulerStatusText.textContent = 'Simulation paused by user • Main thread idle';
+        progressStageLabel.textContent = 'Simulation stopped';
+      }
+
+      runBtn.addEventListener('click', () => {
+        runFlavorSimulation();
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        cancelSimulation();
+      });
+
+      // Run an initial batch simulation after page load so the tool is populated
+      window.addEventListener('DOMContentLoaded', () => {
+        runFlavorSimulation();
+      });
+    })();
+  </script>
 </body>
 
 </html>
