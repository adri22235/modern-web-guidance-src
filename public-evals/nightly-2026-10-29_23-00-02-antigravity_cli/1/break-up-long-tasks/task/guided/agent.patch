+  <script type="module">
+    const ORIGINS = [
+      { name: 'Ethiopia Yirgacheffe', acidity: 88, body: 58, sweetness: 84, bitterness: 28, aroma: 94 },
+      { name: 'Colombia Huila', acidity: 74, body: 72, sweetness: 82, bitterness: 38, aroma: 85 },
+      { name: 'Sumatra Mandheling', acidity: 36, body: 94, sweetness: 60, bitterness: 76, aroma: 80 },
+      { name: 'Guatemala Antigua', acidity: 70, body: 78, sweetness: 79, bitterness: 45, aroma: 86 },
+      { name: 'Brazil Cerrado', acidity: 48, body: 84, sweetness: 76, bitterness: 55, aroma: 74 },
+      { name: 'Kenya AA', acidity: 92, body: 68, sweetness: 78, bitterness: 34, aroma: 91 }
+    ];
+
+    const TARGET_PROFILES = {
+      balanced: { acidity: 68, body: 76, sweetness: 84, bitterness: 42, aroma: 86 },
+      bright: { acidity: 88, body: 60, sweetness: 82, bitterness: 28, aroma: 92 },
+      bold: { acidity: 42, body: 92, sweetness: 68, bitterness: 72, aroma: 82 }
+    };
+
+    const BREW_MODIFIERS = {
+      espresso: { acidity: 0.95, body: 1.15, sweetness: 1.05, bitterness: 1.1, aroma: 1.1 },
+      pourover: { acidity: 1.12, body: 0.9, sweetness: 1.08, bitterness: 0.88, aroma: 1.15 },
+      coldbrew: { acidity: 0.72, body: 1.08, sweetness: 1.14, bitterness: 0.78, aroma: 0.95 }
+    };
+
+    function createRecipeBatch(count, roastTarget, brewMethod) {
+      const items = new Array(count);
+      for (let i = 0; i < count; i++) {
+        const primary = ORIGINS[i % ORIGINS.length];
+        const secondary = ORIGINS[(i * 3 + 1) % ORIGINS.length];
+        const tertiary = ORIGINS[(i * 7 + 2) % ORIGINS.length];
+        const ratioA = 0.45 + ((i % 25) * 0.01);
+        const ratioB = 0.35 - ((i % 15) * 0.01);
+        const ratioC = +(1 - ratioA - ratioB).toFixed(2);
+
+        items[i] = {
+          id: i + 1,
+          name: `${primary.name.split(' ')[0]} / ${secondary.name.split(' ')[0]} Blend #${i + 1}`,
+          composition: `${Math.round(ratioA * 100)}% ${primary.name}, ${Math.round(ratioB * 100)}% ${secondary.name}, ${Math.round(ratioC * 100)}% ${tertiary.name}`,
+          primary,
+          secondary,
+          tertiary,
+          ratioA,
+          ratioB,
+          ratioC,
+          roastTempC: 196 + (i % 28),
+          roastDurationSec: 480 + (i % 180),
+          roastTarget,
+          brewMethod
+        };
+      }
+      return items;
+    }
+
+    function simulateBlendProfile(item) {
+      const mod = BREW_MODIFIERS[item.brewMethod] || BREW_MODIFIERS.espresso;
+      const target = TARGET_PROFILES[item.roastTarget] || TARGET_PROFILES.balanced;
+
+      let acidity = (item.primary.acidity * item.ratioA + item.secondary.acidity * item.ratioB + item.tertiary.acidity * item.ratioC) * mod.acidity;
+      let body = (item.primary.body * item.ratioA + item.secondary.body * item.ratioB + item.tertiary.body * item.ratioC) * mod.body;
+      let sweetness = (item.primary.sweetness * item.ratioA + item.secondary.sweetness * item.ratioB + item.tertiary.sweetness * item.ratioC) * mod.sweetness;
+      let bitterness = (item.primary.bitterness * item.ratioA + item.secondary.bitterness * item.ratioB + item.tertiary.bitterness * item.ratioC) * mod.bitterness;
+      let aroma = (item.primary.aroma * item.ratioA + item.secondary.aroma * item.ratioB + item.tertiary.aroma * item.ratioC) * mod.aroma;
+
+      // Multi-step thermal Maillard & caramelization curve simulation
+      const tempFactor = (item.roastTempC - 195) / 30;
+      const timeFactor = (item.roastDurationSec - 480) / 180;
+      for (let step = 0; step < 320; step++) {
+        const progress = step / 320;
+        const maillard = Math.sin(progress * Math.PI) * (1 + tempFactor * 0.25);
+        const pyrolysis = Math.pow(progress, 2.2) * (0.8 + timeFactor * 0.35);
+        acidity -= pyrolysis * 0.018;
+        sweetness += (maillard * 0.022) - (pyrolysis * 0.015);
+        body += maillard * 0.016;
+        bitterness += pyrolysis * 0.024;
+        aroma += (maillard * 0.019) - (pyrolysis * 0.01);
+      }
+
+      const clamp = (val) => Math.max(10, Math.min(99, Math.round(val)));
+      const profile = {
+        acidity: clamp(acidity),
+        body: clamp(body),
+        sweetness: clamp(sweetness),
+        bitterness: clamp(bitterness),
+        aroma: clamp(aroma)
+      };
+
+      const distance =
+        Math.abs(profile.acidity - target.acidity) * 1.1 +
+        Math.abs(profile.body - target.body) * 1.1 +
+        Math.abs(profile.sweetness - target.sweetness) * 1.25 +
+        Math.abs(profile.bitterness - target.bitterness) * 0.9 +
+        Math.abs(profile.aroma - target.aroma) * 1.15;
+
+      const harmonyScore = Math.max(1, Math.min(99.9, +(100 - distance * 0.28).toFixed(1)));
+
+      return {
+        id: item.id,
+        name: item.name,
+        composition: item.composition,
+        roastTempC: item.roastTempC,
+        roastDurationSec: item.roastDurationSec,
+        profile,
+        harmonyScore
+      };
+    }
+
+    const batchSizeSelect = document.getElementById('batch-size');
+    const roastTargetSelect = document.getElementById('roast-target');
+    const brewMethodSelect = document.getElementById('brew-method');
+    const runBtn = document.getElementById('run-simulation-btn');
+    const statusText = document.getElementById('simulation-status-text');
+    const progressLabel = document.getElementById('simulation-progress-label');
+    const progressBar = document.getElementById('simulation-progress-bar');
+    const progressbarEl = document.getElementById('simulation-progressbar');
+    const metricProcessed = document.getElementById('metric-processed');
+    const metricYields = document.getElementById('metric-yields');
+    const metricElapsed = document.getElementById('metric-elapsed');
+    const resultsContainer = document.getElementById('simulation-results');
+
+    function updateProgressUI(processed, total, yieldCount, startTime) {
+      const pct = total > 0 ? Math.round((processed / total) * 100) : 0;
+      progressLabel.textContent = `${pct}%`;
+      progressBar.style.width = `${pct}%`;
+      progressbarEl.setAttribute('aria-valuenow', String(pct));
+      metricProcessed.textContent = `Processed: ${processed.toLocaleString()} / ${total.toLocaleString()}`;
+      metricYields.textContent = `Main Thread Yields: ${yieldCount}`;
+      metricElapsed.textContent = `Elapsed: ${Math.round(performance.now() - startTime)} ms`;
+    }
+
+    function renderTopBlends(topBlends) {
+      resultsContainer.replaceChildren();
+      for (const blend of topBlends) {
+        const card = document.createElement('article');
+        card.className = 'blend-card';
+
+        const title = document.createElement('h3');
+        const nameSpan = document.createElement('span');
+        nameSpan.textContent = blend.name;
+        const scorePill = document.createElement('span');
+        scorePill.className = 'score-pill';
+        scorePill.textContent = `${blend.harmonyScore} pts`;
+        title.append(nameSpan, scorePill);
+
+        const meta = document.createElement('p');
+        meta.className = 'blend-meta';
+        meta.textContent = `${blend.composition} • Roasted at ${blend.roastTempC}°C for ${Math.floor(blend.roastDurationSec / 60)}m ${blend.roastDurationSec % 60}s`;
+
+        const bars = document.createElement('div');
+        bars.className = 'flavor-bars';
+
+        const metrics = [
+          ['Acidity', blend.profile.acidity],
+          ['Body', blend.profile.body],
+          ['Sweetness', blend.profile.sweetness],
+          ['Bitterness', blend.profile.bitterness],
+          ['Aroma', blend.profile.aroma]
+        ];
+
+        for (const [label, value] of metrics) {
+          const row = document.createElement('div');
+          row.className = 'flavor-row';
+
+          const labelEl = document.createElement('span');
+          labelEl.textContent = label;
+
+          const barBg = document.createElement('div');
+          barBg.className = 'flavor-bar-bg';
+          const barFill = document.createElement('div');
+          barFill.className = 'flavor-bar-fill';
+          barFill.style.width = `${value}%`;
+          barBg.appendChild(barFill);
+
+          const valEl = document.createElement('span');
+          valEl.textContent = String(value);
+
+          row.append(labelEl, barBg, valEl);
+          bars.appendChild(row);
+        }
+
+        card.append(title, meta, bars);
+        resultsContainer.appendChild(card);
+      }
+    }
+
+    async function processRecipeBatchWithYield(items) {
+      const startTime = performance.now();
+      // Set a time-based deadline 50 milliseconds into the future (Long Task threshold).
+      let deadline = performance.now() + 50;
+      let processed = 0;
+      let yieldCount = 0;
+      const simulatedResults = [];
+
+      for (const item of items) {
+        simulatedResults.push(simulateBlendProfile(item));
+        processed++;
+
+        // Yield to the main thread periodically when the 50ms deadline is reached.
+        if (performance.now() >= deadline) {
+          yieldCount++;
+          updateProgressUI(processed, items.length, yieldCount, startTime);
+
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+
+      updateProgressUI(processed, items.length, yieldCount, startTime);
+      return { simulatedResults, yieldCount, durationMs: Math.round(performance.now() - startTime) };
+    }
+
+    async function runSimulation() {
+      const count = Number.parseInt(batchSizeSelect.value, 10) || 5000;
+      const roastTarget = roastTargetSelect.value;
+      const brewMethod = brewMethodSelect.value;
+
+      runBtn.disabled = true;
+      statusText.textContent = `Simulating ${count.toLocaleString()} recipe blends...`;
+
+      const batch = createRecipeBatch(count, roastTarget, brewMethod);
+      const { simulatedResults, yieldCount, durationMs } = await processRecipeBatchWithYield(batch);
+
+      simulatedResults.sort((a, b) => b.harmonyScore - a.harmonyScore);
+      const topBlends = simulatedResults.slice(0, 6);
+      renderTopBlends(topBlends);
+
+      statusText.textContent = `Completed ${count.toLocaleString()} blend simulations in ${durationMs} ms (${yieldCount} main-thread yields). Showing top 6 matches:`;
+      runBtn.disabled = false;
+    }
+
+    runBtn.addEventListener('click', runSimulation);
+  </script>
+
 </body>
 
