+    } catch {
+      return iso;
+    }
+  };
+
+  const getActionDescription = (action: PendingSensitiveAction) => {
+    switch (action.type) {
+      case 'delete-passkey':
+        return `Remove passkey "${action.passkey.name}" from your account`;
+      case 'update-profile':
+        return 'Update account profile & email address';
+      case 'change-password':
+        return 'Change account fallback password';
+      case 'delete-account':
+        return 'Permanently delete your subscriber account';
+      case 'manual-verify':
+        return 'Verify identity to unlock sensitive account settings';
+    }
+  };
+
+  if (loading || !user) {
+    return (
+      <div className="max-w-4xl mx-auto py-12 px-4">
+        <div className="animate-pulse space-y-4 bg-white p-8 border border-gray-200 rounded-lg">
+          <div className="h-7 bg-gray-200 rounded w-1/3" />
+          <div className="h-4 bg-gray-100 rounded w-2/3" />
+          <div className="h-32 bg-gray-100 rounded" />
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Header Banner */}
+      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-gray-200">
+        <div>
+          <div className="flex items-center gap-2.5">
+            <h1 className="text-2xl sm:text-3xl font-bold text-gray-900">Account & Passkey Settings</h1>
+            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-900">
+              {user.subscriptionTier}
+            </span>
+          </div>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as <span className="font-semibold text-gray-900">{user.displayName}</span> (
+            <code className="text-xs bg-gray-100 px-1.5 py-0.5 rounded">@{user.username}</code>)
+          </p>
+        </div>
+
+        <div className="flex items-center gap-3">
+          {reauthRemainingSeconds > 0 ? (
+            <div
+              data-testid="reauth-status-badge"
+              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-green-50 text-green-800 border border-green-200"
+            >
+              <span className="w-2 h-2 rounded-full bg-green-500 animate-pulse" />
+              Reauthenticated ({Math.floor(reauthRemainingSeconds / 60)}:
+              {String(reauthRemainingSeconds % 60).padStart(2, '0')})
+            </div>
+          ) : (
+            <button
+              type="button"
+              data-testid="reauthenticate-button"
+              onClick={() => setPendingAction({ type: 'manual-verify' })}
+              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-semibold bg-amber-50 text-amber-900 border border-amber-300 hover:bg-amber-100 transition-colors"
+            >
+              <svg className="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
+                />
+              </svg>
+              Verify with Passkey (Reauthenticate)
+            </button>
+          )}
+
+          <button
+            type="button"
+            onClick={handleSignOut}
+            className="px-3 py-1.5 rounded-md text-xs font-semibold text-gray-700 bg-white border border-gray-300 hover:bg-gray-50"
+          >
+            Sign Out
+          </button>
+        </div>
+      </div>
+
+      {statusMessage && (
+        <div
+          role="alert"
+          className={`p-4 rounded-lg border text-sm flex items-center justify-between ${
+            statusMessage.type === 'success'
