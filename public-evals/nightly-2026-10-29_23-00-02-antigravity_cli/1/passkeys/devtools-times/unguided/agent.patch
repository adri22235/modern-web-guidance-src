+
+          <div className="flex flex-wrap gap-2 text-xs">
+            <span
+              className={`px-2.5 py-1 rounded border ${
+                capabilities.supported
+                  ? 'bg-green-50 border-green-200 text-green-800'
+                  : 'bg-gray-100 border-gray-200 text-gray-600'
+              }`}
+            >
+              WebAuthn: {capabilities.supported ? 'Supported' : 'Unavailable'}
+            </span>
+            <span
+              className={`px-2.5 py-1 rounded border ${
+                capabilities.platformAuthenticatorAvailable
+                  ? 'bg-blue-50 border-blue-200 text-blue-800'
+                  : 'bg-gray-50 border-gray-200 text-gray-600'
+              }`}
+            >
+              Platform Authenticator: {capabilities.platformAuthenticatorAvailable ? 'Detected' : 'Virtual / External'}
+            </span>
+          </div>
+        </div>
+
+        {/* Registered Passkeys List */}
+        <div className="divide-y divide-gray-200">
+          {user.passkeys.length === 0 ? (
+            <div className="p-8 text-center text-gray-500 text-sm">
+              No passkeys are registered on your account yet. Add one below for passwordless sign-in.
+            </div>
+          ) : (
+            user.passkeys.map((pk) => (
+              <div
+                key={pk.id}
+                data-testid={`passkey-item-${pk.id}`}
+                className="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/60 transition-colors"
+              >
+                <div className="flex items-start gap-3.5">
+                  <div className="w-10 h-10 rounded-lg bg-gray-900 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">
+                    <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                      <path
+                        strokeLinecap="round"
+                        strokeLinejoin="round"
+                        strokeWidth={2}
+                        d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                      />
+                    </svg>
+                  </div>
+
+                  <div className="space-y-1">
+                    {editingPasskeyId === pk.id ? (
+                      <div className="flex items-center gap-2">
+                        <input
+                          type="text"
+                          value={editingPasskeyName}
+                          onChange={(e) => setEditingPasskeyName(e.target.value)}
+                          className="px-2.5 py-1 text-sm border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
+                          aria-label="Passkey name"
+                        />
+                        <button
+                          type="button"
+                          onClick={() => handleRenamePasskey(pk.id)}
+                          className="px-2.5 py-1 text-xs font-semibold bg-gray-900 text-white rounded hover:bg-gray-800"
+                        >
+                          Save
