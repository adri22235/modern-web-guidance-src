+        break;
+      }
+    }
+  };
+
+  const handlePerformReauth = async () => {
+    if (!user || !pendingAction) return;
+    setReauthLoading(true);
+    setReauthError(null);
+
+    try {
+      const result = await authenticateWithPasskeyClient({
+        username: user.username,
+        purpose: 'reauthenticate',
+      });
+
+      if (result.verified) {
+        recordReauthTimestamp();
+        syncFormWithUser(result.user);
+        const completedAction = pendingAction;
+        setPendingAction(null);
+        await executePendingAction(completedAction);
+      }
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') {
+        setReauthError('Passkey verification was cancelled or timed out.');
+      } else {
+        setReauthError(err?.message || 'Could not verify passkey. Please try again.');
+      }
+    } finally {
+      setReauthLoading(false);
+    }
+  };
+
+  const handleRegisterNewPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!user) return;
+    setStatusMessage(null);
+    setRegisteringPasskey(true);
+
+    try {
+      const result = await registerPasskeyClient({
+        username: user.username,
+        displayName: user.displayName,
+        email: user.email,
+        passkeyName:
+          newPasskeyName.trim() ||
+          (attachmentType === 'cross-platform' ? 'Hardware Security Key' : 'Platform Passkey'),
+        authenticatorAttachment: attachmentType,
+      });
+
+      syncFormWithUser(result.user);
+      setNewPasskeyName('');
+      setStatusMessage({
