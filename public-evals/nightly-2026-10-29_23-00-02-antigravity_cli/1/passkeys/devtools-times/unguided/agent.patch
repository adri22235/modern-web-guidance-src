+
+      {/* Section 1: Passkey Management (Registration, Inspection, Renaming, Deletion) */}
+      <section className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
+        <div className="p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+          <div>
+            <div className="flex items-center gap-2">
+              <h2 className="text-lg font-bold text-gray-900">Passkeys</h2>
+              <span className="px-2 py-0.5 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
+                {user.passkeys.length} registered
