diff --git a/src/pages/api/passkeys.ts b/src/pages/api/passkeys.ts
new file mode 100644
index 0000000..a77f9f0
--- /dev/null
+++ b/src/pages/api/passkeys.ts
@@ -0,0 +1,344 @@
+import type { APIRoute } from 'astro';
+import {
+  challengesStore,
+  createChallenge,
+  findUserByCredentialId,
+  generateBase64Url,
+  getUserById,
+  getUserByUsername,
+  sanitizeUserForClient,
+  upsertUser,
+  usersStore,
+  type StoredPasskey,
+  type UserProfile,
+} from '../../utils/passkeyStore';
+
+const jsonResponse = (data: unknown, status = 200) =>
+  new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+
+async function getSessionUser(session: App.Locals['session'] | undefined): Promise<UserProfile | undefined> {
+  const userId = await session?.get('userId');
+  if (userId) {
+    const found = getUserById(userId);
+    if (found) return found;
+  }
+  return undefined;
+}
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const usernameParam = url.searchParams.get('username');
+  let user = await getSessionUser(session);
+
+  if (!user && usernameParam) {
+    user = getUserByUsername(usernameParam);
+  }
+
+  // Fallback to default demo user so Account Settings is immediately inspectable/interactive
+  const defaultDemo = getUserByUsername('alex.rivera');
+
+  return jsonResponse({
+    authenticated: Boolean(user),
+    user: sanitizeUserForClient(user || defaultDemo!),
+  });
+};
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json();
+    const action = body.action as string;
+    const rpId = body.rpId || url.hostname || 'localhost';
+
+    switch (action) {
+      case 'register-options': {
+        const rawUsername = (body.username || '').trim();
+        const displayName = (body.displayName || rawUsername || 'Alex Rivera').trim();
+        let user = rawUsername ? getUserByUsername(rawUsername) : await getSessionUser(session);
+
+        if (!user && !rawUsername) {
+          user = getUserByUsername('alex.rivera');
+        }
+
+        const userId = user?.id || `usr_${generateBase64Url(12)}`;
+        const effectiveUsername = user?.username || rawUsername || 'alex.rivera';
+        const challengeRecord = createChallenge('register', effectiveUsername, userId);
+
+        const excludeCredentials = (user?.passkeys || []).map((pk) => ({
+          id: pk.id,
+          type: 'public-key' as const,
+          transports: pk.transports,
+        }));
+
+        return jsonResponse({
+          options: {
+            challenge: challengeRecord.challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: rpId,
+            },
+            user: {
+              id: Buffer.from(userId, 'utf8').toString('base64url'),
+              name: effectiveUsername,
+              displayName: user?.displayName || displayName,
+            },
+            pubKeyCredParams: [
+              { alg: -7, type: 'public-key' },   // ES256
+              { alg: -257, type: 'public-key' }, // RS256
+            ],
+            timeout: 60000,
+            attestation: 'none',
+            excludeCredentials,
+            authenticatorSelection: {
+              residentKey: 'required',
+              requireResidentKey: true,
+              userVerification: 'required',
+              ...(body.authenticatorAttachment ? { authenticatorAttachment: body.authenticatorAttachment } : {}),
+            },
+          },
+        });
+      }
+
+      case 'register-verify': {
+        const {
+          username: rawUsername,
+          displayName,
+          email,
+          credential,
+          passkeyName,
+          password,
+        } = body;
+
+        let user = rawUsername ? getUserByUsername(rawUsername) : await getSessionUser(session);
+        if (!user && !rawUsername) {
+          user = getUserByUsername('alex.rivera');
+        }
+
+        const effectiveUsername = (user?.username || rawUsername || 'alex.rivera').trim();
+        if (!user) {
+          user = {
+            id: `usr_${generateBase64Url(12)}`,
+            username: effectiveUsername,
+            displayName: (displayName || effectiveUsername).trim(),
+            email: (email || `${effectiveUsername.toLowerCase()}@devtoolstimes.dev`).trim(),
+            subscriptionTier: 'Digital All-Access',
+            hasPassword: Boolean(password),
+            passwordHash: password || undefined,
+            createdAt: new Date().toISOString(),
+            lastReauthenticatedAt: new Date().toISOString(),
+            passkeys: [],
+          };
+        }
+
+        const credId = credential?.id || `cred_${generateBase64Url(12)}`;
+        const transports: AuthenticatorTransport[] =
+          credential?.response?.transports?.length > 0
+            ? credential.response.transports
+            : ['internal', 'hybrid'];
+
+        const attachment = credential?.authenticatorAttachment || 'platform';
+        const defaultName =
+          passkeyName?.trim() ||
+          (attachment === 'cross-platform'
+            ? 'Security Key (USB / NFC)'
+            : 'This Device (Platform Passkey)');
+
+        const newPasskey: StoredPasskey = {
+          id: credId,
+          publicKey: credential?.response?.publicKey || generateBase64Url(48),
+          name: defaultName,
+          createdAt: new Date().toISOString(),
+          lastUsedAt: new Date().toISOString(),
+          transports,
+          deviceType: attachment === 'cross-platform' ? 'singleDevice' : 'multiDevice',
+          backedUp: attachment !== 'cross-platform',
+          aaguid: credential?.aaguid || 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+          signCount: 1,
+        };
+
+        // Avoid duplicate IDs
+        user.passkeys = [
+          newPasskey,
+          ...user.passkeys.filter((pk) => pk.id !== newPasskey.id),
+        ];
+        user.lastReauthenticatedAt = new Date().toISOString();
+        upsertUser(user);
+
+        await session?.set('userId', user.id);
+
+        return jsonResponse({
+          verified: true,
+          passkey: newPasskey,
+          user: sanitizeUserForClient(user),
+        });
+      }
+
+      case 'auth-options': {
+        const rawUsername = (body.username || '').trim();
+        const purpose = body.purpose === 'reauthenticate' ? 'reauthenticate' : 'authenticate';
+        let user = rawUsername ? getUserByUsername(rawUsername) : await getSessionUser(session);
+
+        if (purpose === 'reauthenticate' && !user) {
+          user = getUserByUsername('alex.rivera');
+        }
+
+        const challengeRecord = createChallenge(purpose, user?.username, user?.id);
+
+        const allowCredentials =
+          user && (rawUsername || purpose === 'reauthenticate')
+            ? user.passkeys.map((pk) => ({
+                id: pk.id,
+                type: 'public-key' as const,
+                transports: pk.transports,
+              }))
+            : [];
+
+        return jsonResponse({
+          options: {
+            challenge: challengeRecord.challenge,
+            rpId,
+            timeout: 60000,
+            userVerification: 'required',
+            allowCredentials,
+          },
+        });
+      }
+
+      case 'auth-verify': {
+        const { credential, username: rawUsername, purpose } = body;
+        const credId = credential?.id;
+
+        let matched = credId ? findUserByCredentialId(credId) : undefined;
+        let user: UserProfile | undefined = matched?.user;
+        let passkey: StoredPasskey | undefined = matched?.passkey;
+
+        if (!user && rawUsername) {
+          user = getUserByUsername(rawUsername);
+        }
+        if (!user) {
+          user = (await getSessionUser(session)) || getUserByUsername('alex.rivera');
+        }
+
+        if (!user) {
+          return jsonResponse({ error: 'No matching passkey account found.' }, 404);
+        }
+
+        if (!passkey && user.passkeys.length > 0) {
+          passkey = user.passkeys[0];
+        } else if (!passkey && credId) {
+          // If an authenticator returned a fresh resident credential not yet in memory (e.g. after server restart), bind it
+          passkey = {
+            id: credId,
+            publicKey: generateBase64Url(48),
+            name: 'Synced Passkey',
+            createdAt: new Date().toISOString(),
+            lastUsedAt: new Date().toISOString(),
+            transports: ['internal', 'hybrid'],
+            deviceType: 'multiDevice',
+            backedUp: true,
+            aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+            signCount: 1,
+          };
+          user.passkeys.unshift(passkey);
+        }
+
+        if (passkey) {
+          passkey.lastUsedAt = new Date().toISOString();
+          passkey.signCount = (passkey.signCount || 0) + 1;
+        }
+
+        if (purpose === 'reauthenticate') {
+          user.lastReauthenticatedAt = new Date().toISOString();
+        } else {
+          user.lastReauthenticatedAt = new Date().toISOString();
+        }
+
+        upsertUser(user);
+        await session?.set('userId', user.id);
+
+        return jsonResponse({
+          verified: true,
+          purpose: purpose || 'authenticate',
+          usedPasskey: passkey,
+          user: sanitizeUserForClient(user),
+        });
+      }
+
+      case 'rename-passkey': {
+        const { credentialId, name, username: rawUsername } = body;
+        const user =
+          (rawUsername ? getUserByUsername(rawUsername) : undefined) ||
+          (await getSessionUser(session)) ||
+          getUserByUsername('alex.rivera')!;
+
+        const target = user.passkeys.find((pk) => pk.id === credentialId);
+        if (!target) {
+          return jsonResponse({ error: 'Passkey not found.' }, 404);
+        }
+
+        target.name = (name || '').trim() || target.name;
+        upsertUser(user);
+
+        return jsonResponse({
+          updated: true,
+          passkey: target,
+          user: sanitizeUserForClient(user),
+        });
+      }
+
+      case 'delete-passkey': {
+        const { credentialId, username: rawUsername } = body;
+        const user =
+          (rawUsername ? getUserByUsername(rawUsername) : undefined) ||
+          (await getSessionUser(session)) ||
+          getUserByUsername('alex.rivera')!;
+
+        user.passkeys = user.passkeys.filter((pk) => pk.id !== credentialId);
+        upsertUser(user);
+
+        return jsonResponse({
+          deleted: true,
+          user: sanitizeUserForClient(user),
+        });
+      }
+
+      case 'update-profile': {
+        const { username: rawUsername, displayName, email, subscriptionTier, hasPassword } = body;
+        const user =
+          (rawUsername ? getUserByUsername(rawUsername) : undefined) ||
+          (await getSessionUser(session)) ||
+          getUserByUsername('alex.rivera')!;
+
+        if (typeof displayName === 'string' && displayName.trim()) {
+          user.displayName = displayName.trim();
+        }
+        if (typeof email === 'string' && email.trim()) {
+          user.email = email.trim();
+        }
+        if (subscriptionTier) {
+          user.subscriptionTier = subscriptionTier;
+        }
+        if (typeof hasPassword === 'boolean') {
+          user.hasPassword = hasPassword;
+        }
+
+        upsertUser(user);
+        return jsonResponse({
+          updated: true,
+          user: sanitizeUserForClient(user),
+        });
+      }
+
+      case 'signout': {
+        await session?.set('userId', undefined);
+        return jsonResponse({ signedOut: true });
+      }
+
+      default:
+        return jsonResponse({ error: `Unsupported action: ${action}` }, 400);
+    }
+  } catch (err: any) {
+    return jsonResponse({ error: err?.message || 'Internal Server Error' }, 500);
+  }
+};
