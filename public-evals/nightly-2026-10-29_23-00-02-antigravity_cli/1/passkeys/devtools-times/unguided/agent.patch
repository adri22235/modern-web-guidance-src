+import React, { useEffect, useState } from 'react';
+import {
+  authenticateWithPasskeyClient,
+  checkWebAuthnCapabilities,
+  getApiUrl,
+  getAppPath,
+  getLastReauthTimestamp,
+  getLocalActiveUser,
+  recordReauthTimestamp,
+  registerPasskeyClient,
+  saveActiveUserLocally,
+  type ClientPasskey,
+  type ClientUserProfile,
+} from '../utils/webauthnClient';
+
+const REAUTH_VALIDITY_MS = 5 * 60 * 1000; // 5 minutes step-up reauthentication window
+
+type PendingSensitiveAction =
+  | { type: 'delete-passkey'; passkey: ClientPasskey }
+  | { type: 'update-profile' }
+  | { type: 'change-password' }
+  | { type: 'delete-account' }
+  | { type: 'manual-verify' };
+
+export default function AccountSettings() {
+  const [user, setUser] = useState<ClientUserProfile | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [statusMessage, setStatusMessage] = useState<{ type: 'success' | 'error' | 'info'; text: string } | null>(null);
+
+  // Profile form fields
+  const [displayName, setDisplayName] = useState('');
+  const [email, setEmail] = useState('');
+  const [subscriptionTier, setSubscriptionTier] = useState<ClientUserProfile['subscriptionTier']>('Digital All-Access');
+
+  // Password change fields
+  const [newPassword, setNewPassword] = useState('');
+  const [confirmPassword, setConfirmPassword] = useState('');
+
+  // Add Passkey fields
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [attachmentType, setAttachmentType] = useState<'platform' | 'cross-platform'>('platform');
+  const [registeringPasskey, setRegisteringPasskey] = useState(false);
+
+  // Rename Passkey state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState('');
+
+  // Step-up Reauthentication Modal state
+  const [pendingAction, setPendingAction] = useState<PendingSensitiveAction | null>(null);
+  const [reauthLoading, setReauthLoading] = useState(false);
+  const [reauthError, setReauthError] = useState<string | null>(null);
+  const [reauthRemainingSeconds, setReauthRemainingSeconds] = useState<number>(0);
+
+  // WebAuthn environment capabilities
+  const [capabilities, setCapabilities] = useState<{
+    supported: boolean;
+    platformAuthenticatorAvailable: boolean;
+    conditionalMediationAvailable: boolean;
+  }>({
+    supported: true,
+    platformAuthenticatorAvailable: false,
+    conditionalMediationAvailable: false,
+  });
+
+  const syncFormWithUser = (profile: ClientUserProfile) => {
+    setUser(profile);
+    setDisplayName(profile.displayName);
+    setEmail(profile.email);
+    setSubscriptionTier(profile.subscriptionTier);
+  };
+
+  useEffect(() => {
+    let mounted = true;
+
+    const loadUserAndCaps = async () => {
+      setLoading(true);
+      const caps = await checkWebAuthnCapabilities();
+      if (mounted) setCapabilities(caps);
+
+      const localUser = getLocalActiveUser();
+      const queryParam = localUser?.username ? `?username=${encodeURIComponent(localUser.username)}` : '';
+
+      try {
+        const res = await fetch(`${getApiUrl()}${queryParam}`);
+        if (res.ok) {
+          const data = await res.json();
+          if (mounted && data.user) {
+            syncFormWithUser(data.user);
+            saveActiveUserLocally(data.user);
+          }
+        } else if (localUser && mounted) {
+          syncFormWithUser(localUser);
+        }
+      } catch {
+        if (localUser && mounted) {
+          syncFormWithUser(localUser);
+        }
+      } finally {
+        if (mounted) setLoading(false);
+      }
+    };
+
+    loadUserAndCaps();
+
+    return () => {
+      mounted = false;
+    };
+  }, []);
+
+  // Track active step-up reauthentication countdown
+  useEffect(() => {
+    const updateRemaining = () => {
+      const lastTs = getLastReauthTimestamp();
+      if (!lastTs) {
+        setReauthRemainingSeconds(0);
+        return;
+      }
+      const elapsed = Date.now() - lastTs;
+      const remaining = Math.max(0, Math.ceil((REAUTH_VALIDITY_MS - elapsed) / 1000));
