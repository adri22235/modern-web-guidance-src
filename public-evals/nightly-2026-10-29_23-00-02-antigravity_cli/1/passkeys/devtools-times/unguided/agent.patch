+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            action: 'update-profile',
+            username: user.username,
+            hasPassword: true,
+          }),
+        });
+        const data = await res.json();
+        if (res.ok && data.user) {
