+    window.location.href = getAppPath('signin');
+  };
+
+  const formatDate = (iso: string | null | undefined) => {
+    if (!iso) return 'Never used';
+    try {
+      return new Date(iso).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
