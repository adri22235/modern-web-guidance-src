+            username: user.username,
+            credentialId: action.passkey.id,
+          }),
+        });
+        const data = await res.json();
+        if (res.ok && data.user) {
+          syncFormWithUser(data.user);
+          saveActiveUserLocally(data.user);
+          setStatusMessage({
+            type: 'success',
+            text: `Passkey "${action.passkey.name}" has been removed from your account.`,
+          });
+        }
+        break;
+      }
+
+      case 'update-profile': {
+        const res = await fetch(getApiUrl(), {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            action: 'update-profile',
+            username: user.username,
+            displayName,
+            email,
+            subscriptionTier,
