+
+      // Base64URL and ArrayBuffer helpers
+      function bufferToBase64Url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function base64UrlToBuffer(base64url) {
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const rawData = atob(base64);
+        const outputArray = new Uint8Array(rawData.length);
+        for (let i = 0; i < rawData.length; ++i) {
+          outputArray[i] = rawData.charCodeAt(i);
+        }
+        return outputArray.buffer;
+      }
+
+      function randomBytes(length) {
+        const arr = new Uint8Array(length);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(arr);
+        } else {
+          for (let i = 0; i < length; i++) arr[i] = Math.floor(Math.random() * 256);
+        }
+        return arr;
+      }
+
+      function getRpId() {
+        return window.location.hostname || 'localhost';
+      }
+
+      // Storage helpers
+      function loadUsers() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEYS.USERS);
+          return raw ? JSON.parse(raw) : [];
+        } catch (err) {
+          return [];
+        }
+      }
+
+      function saveUsers(users) {
+        localStorage.setItem(STORAGE_KEYS.USERS, JSON.stringify(users));
+      }
+
+      function loadSession() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEYS.SESSION);
+          return raw ? JSON.parse(raw) : null;
+        } catch (err) {
+          return null;
+        }
+      }
+
+      function saveSession(session) {
+        if (!session) {
+          localStorage.removeItem(STORAGE_KEYS.SESSION);
+        } else {
+          localStorage.setItem(STORAGE_KEYS.SESSION, JSON.stringify(session));
+        }
+      }
+
+      function getCurrentUser() {
+        const session = loadSession();
+        if (!session || !session.userId) return null;
+        const users = loadUsers();
+        return users.find(u => u.id === session.userId) || null;
+      }
+
+      function isRecentlyReauthenticated() {
+        const session = loadSession();
+        if (!session || !session.lastReauthAt) return false;
+        return (Date.now() - session.lastReauthAt) < REAUTH_WINDOW_MS;
+      }
+
+      // WebAuthn Passkey Operations
+      async function createPasskeyCredential(user, label) {
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.create) {
+          throw new Error('WebAuthn passkeys are not supported in this browser environment.');
+        }
+
+        const challenge = randomBytes(32);
+        const userIdBytes = new TextEncoder().encode(user.id);
+        const excludeCredentials = (user.passkeys || []).map(pk => ({
+          id: base64UrlToBuffer(pk.credentialId),
+          type: 'public-key',
+          transports: pk.transports || ['internal', 'hybrid']
+        }));
+
+        const publicKeyOptions = {
+          challenge: challenge.buffer,
+          rp: {
+            name: 'The Daily Grind Coffee Co.',
+            id: getRpId()
+          },
+          user: {
+            id: userIdBytes.buffer,
+            name: user.email,
+            displayName: user.name
+          },
+          pubKeyCredParams: [
+            { type: 'public-key', alg: -7 },   // ES256
+            { type: 'public-key', alg: -257 }  // RS256
+          ],
+          authenticatorSelection: {
+            residentKey: 'preferred',
+            requireResidentKey: false,
+            userVerification: 'preferred'
+          },
+          timeout: 60000,
+          attestation: 'none',
+          excludeCredentials
+        };
+
+        const credential = await navigator.credentials.create({ publicKey: publicKeyOptions });
+        if (!credential) {
+          throw new Error('Passkey creation was cancelled or returned no credential.');
+        }
+
+        const credentialId = credential.id || bufferToBase64Url(credential.rawId);
+        const transports = (credential.response && typeof credential.response.getTransports === 'function')
+          ? credential.response.getTransports()
+          : ['internal'];
+
+        return {
+          credentialId,
+          label: (label && label.trim()) || `Passkey (${new Date().toLocaleDateString()})`,
+          createdAt: new Date().toISOString(),
+          lastUsedAt: new Date().toISOString(),
