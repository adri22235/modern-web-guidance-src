+  <script>
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'required', 'disabled', 'max', 'name'];
+      }
+
+      constructor() {
+        super();
+        this._internals = this.attachInternals();
+        this._root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this._value = '';
+        this._defaultValue = undefined;
+        this._formDisabled = false;
+        this._customErrorMessage = '';
+        this._hoverValue = 0;
+
+        this._render();
+        this._syncFromAttributes();
+        this._updateValidity();
+      }
+
+      connectedCallback() {
+        if (this._defaultValue === undefined) {
+          this._defaultValue = this.getAttribute('value') ?? '';
+        }
+        if (!this.hasAttribute('role')) {
+          this.setAttribute('role', 'radiogroup');
+        }
+        this._syncFromAttributes();
+        this._updateStars();
+        this._updateDisabledUI();
+        this._updateValidity();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+
+        if (name === 'value') {
+          if (this._defaultValue === undefined) {
+            this._defaultValue = newValue ?? '';
+          }
+          this._setValueInternal(newValue ?? '');
+        } else if (name === 'required') {
+          this._updateValidity();
+          this._updateAria();
+        } else if (name === 'disabled') {
+          this._updateDisabledUI();
+          this._updateValidity();
+        } else if (name === 'max') {
+          this._renderStars();
+          this._updateStars();
+          this._updateValidity();
+        }
+      }
+
+      formAssociatedCallback(form) {
+        this._updateValidity();
+      }
+
+      formDisabledCallback(disabled) {
+        this._formDisabled = Boolean(disabled);
+        this._updateDisabledUI();
+        this._updateValidity();
+      }
+
+      formResetCallback() {
+        this._customErrorMessage = '';
+        this._hoverValue = 0;
+        const resetVal = this._defaultValue !== undefined ? this._defaultValue : (this.getAttribute('value') ?? '');
+        this._setValueInternal(resetVal);
+      }
+
+      formStateRestoreCallback(state, _mode) {
+        this._customErrorMessage = '';
+        this._setValueInternal(state != null ? String(state) : '');
+      }
+
+      get internals() {
+        return this._internals;
+      }
+
+      get form() {
+        return this._internals.form;
+      }
+
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', String(val));
+        }
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this._internals.validity;
+      }
+
+      get validationMessage() {
+        return this._internals.validationMessage;
+      }
+
+      get willValidate() {
+        return this._internals.willValidate;
+      }
+
+      get labels() {
+        return this._internals.labels;
+      }
+
+      checkValidity() {
+        return this._internals.checkValidity();
+      }
+
+      reportValidity() {
+        return this._internals.reportValidity();
+      }
+
+      setCustomValidity(message = '') {
+        this._customErrorMessage = message ? String(message) : '';
+        this._updateValidity();
+      }
+
+      get max() {
+        const parsed = parseInt(this.getAttribute('max') || '5', 10);
+        return Number.isFinite(parsed) && parsed > 0 ? parsed : 5;
+      }
+
+      set max(val) {
+        this.setAttribute('max', String(val));
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        this.toggleAttribute('required', Boolean(val));
+      }
+
+      get disabled() {
+        return this._formDisabled || this.hasAttribute('disabled');
+      }
+
+      set disabled(val) {
+        this.toggleAttribute('disabled', Boolean(val));
+      }
+
+      get value() {
+        return this._value;
+      }
+
+      set value(val) {
+        const normalized = val === null || val === undefined || val === '' || val === 0 || val === '0'
+          ? ''
+          : String(val);
+        this._setValueInternal(normalized);
+      }
+
+      _syncFromAttributes() {
+        if (this.hasAttribute('value') && !this._value) {
+          this._setValueInternal(this.getAttribute('value') || '');
+        } else {
+          this._syncFormValue();
+        }
+      }
+
+      _setValueInternal(val) {
+        const normalized = val === null || val === undefined || val === '' || val === 0 || val === '0'
+          ? ''
+          : String(val);
+        this._value = normalized;
+        this._syncFormValue();
+        this._updateStars();
+        this._updateValidity();
+      }
+
+      _syncFormValue() {
+        if (this._value) {
+          this._internals.setFormValue(this._value, this._value);
+        } else {
+          this._internals.setFormValue(null);
+        }
+      }
+
+      _updateValidity() {
+        const anchor = this._root.querySelector('.star') || undefined;
+        const setInternalValidity = (flags, message) => {
+          try {
+            if (message && anchor) {
+              this._internals.setValidity(flags, message, anchor);
+            } else if (message) {
+              this._internals.setValidity(flags, message);
+            } else {
+              this._internals.setValidity({});
+            }
+          } catch (_err) {
+            this._internals.setValidity(flags, message);
+          }
+        };
+
+        if (this._customErrorMessage) {
+          setInternalValidity({ customError: true }, this._customErrorMessage);
+          return;
+        }
+
+        if (this.required && !this._value) {
+          setInternalValidity({ valueMissing: true }, 'Please select a star rating.');
+          return;
+        }
+
+        setInternalValidity({});
+      }
+
+      _updateAria() {
+        this.setAttribute('aria-required', this.required ? 'true' : 'false');
+      }
+
+      _updateDisabledUI() {
+        const isDisabled = this.disabled;
+        this.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');
+        const buttons = this._root.querySelectorAll('.star');
+        buttons.forEach((btn) => {
+          btn.disabled = isDisabled;
+        });
+      }
+
+      _selectRating(starVal) {
+        if (this.disabled) return;
+        const nextVal = String(starVal);
+        const changed = this._value !== nextVal;
+        this.value = nextVal;
+        this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+        if (changed) {
+          this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        }
+      }
+
+      _render() {
+        this._root.innerHTML = `
+          <style>
+            :host {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+              user-select: none;
+              padding: 4px 2px;
+              border-radius: 6px;
+            }
+            :host(:disabled) {
+              opacity: 0.5;
+              cursor: not-allowed;
+              pointer-events: none;
+            }
+            .stars {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+            }
+            .star {
+              appearance: none;
+              background: transparent;
+              border: none;
+              padding: 4px;
+              font-size: 2rem;
+              line-height: 1;
+              color: #d7ccc8;
+              cursor: pointer;
+              transition: transform 0.15s ease, color 0.15s ease;
+              border-radius: 4px;
+            }
+            .star:focus-visible {
+              outline: 2px solid #4e342e;
+              outline-offset: 2px;
+            }
+            .star.active,
+            .star.selected {
+              color: #ffab40;
+            }
+            .star.hover-preview {
+              color: #ffc46b;
+              transform: scale(1.1);
+            }
+            .star:disabled {
+              cursor: not-allowed;
+            }
+            .rating-caption {
+              font-size: 0.9rem;
+              color: #5d4037;
+              margin-left: 8px;
+              min-width: 75px;
+            }
+          </style>
+          <div class="stars" part="stars"></div>
+          <span class="rating-caption" part="caption" aria-live="polite"></span>
+        `;
+        this._starsContainer = this._root.querySelector('.stars');
+        this._captionEl = this._root.querySelector('.rating-caption');
+
+        this._starsContainer.addEventListener('mouseleave', () => {
+          if (this.disabled) return;
+          this._hoverValue = 0;
+          this._updateStars();
+        });
+
+        this._root.addEventListener('keydown', (e) => {
+          if (this.disabled) return;
+          const current = parseInt(this._value || '0', 10) || 0;
+          const max = this.max;
+          let next = null;
+
+          if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+            e.preventDefault();
+            next = Math.min(max, current + 1 || 1);
+          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+            e.preventDefault();
+            next = Math.max(1, current - 1 || 1);
+          } else if (e.key === 'Home') {
+            e.preventDefault();
+            next = 1;
+          } else if (e.key === 'End') {
+            e.preventDefault();
+            next = max;
+          } else if (/^[1-9]$/.test(e.key)) {
+            const digit = parseInt(e.key, 10);
+            if (digit <= max) {
+              e.preventDefault();
+              next = digit;
+            }
+          }
+
+          if (next !== null) {
+            this._selectRating(next);
+            const targetBtn = this._root.querySelector(`.star[data-value="${next}"]`);
+            if (targetBtn) targetBtn.focus();
+          }
+        });
+
+        this._renderStars();
+      }
+
+      _renderStars() {
+        if (!this._starsContainer) return;
+        this._starsContainer.innerHTML = '';
+        const max = this.max;
+
+        for (let i = 1; i <= max; i++) {
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.className = 'star';
+          btn.dataset.value = String(i);
+          btn.value = String(i);
+          btn.setAttribute('role', 'radio');
+          btn.setAttribute('aria-label', i === 1 ? '1 star' : `${i} stars`);
+          btn.setAttribute('aria-checked', 'false');
+          btn.disabled = this.disabled;
+          btn.textContent = '★';
+
+          btn.addEventListener('mouseenter', () => {
+            if (this.disabled) return;
+            this._hoverValue = i;
+            this._updateStars();
+          });
+
+          btn.addEventListener('click', () => {
+            this._selectRating(i);
+          });
+
+          this._starsContainer.appendChild(btn);
+        }
+      }
+
+      _updateStars() {
+        if (!this._starsContainer) return;
+        const selectedNum = parseInt(this._value || '0', 10) || 0;
+        const activeNum = this._hoverValue || selectedNum;
+        const buttons = this._starsContainer.querySelectorAll('.star');
+
+        buttons.forEach((btn, idx) => {
+          const starNum = idx + 1;
+          const isSelected = starNum <= selectedNum;
+          const isHovered = this._hoverValue > 0 && starNum <= activeNum;
+          const isCurrentChoice = starNum === selectedNum;
+
+          btn.classList.toggle('selected', isSelected);
+          btn.classList.toggle('active', starNum <= activeNum);
+          btn.classList.toggle('hover-preview', isHovered);
+          btn.setAttribute('aria-checked', isCurrentChoice ? 'true' : 'false');
+          btn.tabIndex = (selectedNum === 0 && starNum === 1) || isCurrentChoice ? 0 : -1;
+        });
+
+        if (this._captionEl) {
+          this._captionEl.textContent = selectedNum > 0
+            ? `${selectedNum} / ${this.max} stars`
+            : 'No rating';
+        }
+      }
+    }
+
+    if (!customElements.get('star-rating')) {
+      customElements.define('star-rating', StarRating);
+    }
+
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    if (feedbackForm && feedbackStatus) {
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(feedbackForm);
+        const rating = formData.get('rating');
+        const coffee = formData.get('coffee') || 'coffee';
+        feedbackStatus.textContent = `Thank you for your ${rating}-star feedback on our ${coffee}!`;
+        feedbackStatus.classList.add('visible');
+      });
+
+      feedbackForm.addEventListener('reset', () => {
+        feedbackStatus.textContent = '';
+        feedbackStatus.classList.remove('visible');
+      });
+    }
+  </script>
