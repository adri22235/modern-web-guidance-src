+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const recipientInput = document.getElementById('card-recipient-input');
+      const messageInput = document.getElementById('card-message-input');
+      const bgColorInput = document.getElementById('card-bg-color');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const recipientDisplay = document.getElementById('card-recipient-display');
+      const messageDisplay = document.getElementById('card-message-display');
+      const exportBtn = document.getElementById('export-card-btn');
+      const statusEl = document.getElementById('canvas-feature-status');
+
+      // Feature detection for HTML-in-Canvas API
+      function supportsHtmlInCanvas(canvasEl, context) {
+        if (!canvasEl || !context) return false;
+        const hasDrawElement =
+          typeof context.drawElementImage === 'function' ||
+          typeof context.drawElement === 'function';
+        const hasPaintSync =
+          'onpaint' in canvasEl ||
+          typeof canvasEl.requestPaint === 'function' ||
+          'layoutsubtree' in HTMLCanvasElement.prototype;
+        return Boolean(hasDrawElement && hasPaintSync);
+      }
+
+      const isHtmlInCanvasSupported = supportsHtmlInCanvas(canvas, ctx);
+
+      // Fallback 2D canvas drawing when native HTML-in-Canvas is unavailable
+      function drawFallbackCard() {
+        const width = 480;
+        const height = 280;
+        const bgColor = exportElement.style.backgroundColor || bgColorInput.value || '#4e342e';
+        const messageText = messageDisplay.textContent || 'Have a brew-tiful day on me!';
+        const recipientText = 'For: ' + (recipientDisplay.textContent || 'Alex');
+
+        ctx.save();
+        ctx.clearRect(0, 0, width, height);
+
+        // Rounded card background
+        ctx.fillStyle = bgColor;
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(0, 0, width, height, 16);
+        } else {
+          ctx.rect(0, 0, width, height);
+        }
+        ctx.fill();
+
+        // Header divider
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.25)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(32, 64);
+        ctx.lineTo(width - 32, 64);
+        ctx.stroke();
+
+        // Brand title
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 17.6px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'middle';
+        ctx.fillText('THE DAILY GRIND', 32, 42);
+
+        // Gift badge
+        const badgeText = '$25 GIFT';
+        ctx.font = 'bold 13.6px "Segoe UI", Tahoma, sans-serif';
+        const badgeWidth = ctx.measureText(badgeText).width + 20;
+        const badgeX = width - 32 - badgeWidth;
+        const badgeY = 28;
+        ctx.fillStyle = '#ffab40';
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(badgeX, badgeY, badgeWidth, 26, 13);
+        } else {
+          ctx.rect(badgeX, badgeY, badgeWidth, 26);
+        }
+        ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.fillText(badgeText, badgeX + 10, badgeY + 13);
+
+        // Message body (with simple word wrap)
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 21.6px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'top';
+        const words = messageText.split(' ');
+        let line = '';
+        let y = 105;
+        const maxWidth = width - 64;
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line + words[i] + ' ';
+          if (ctx.measureText(testLine).width > maxWidth && i > 0) {
+            ctx.fillText(line.trim(), 32, y);
+            line = words[i] + ' ';
+            y += 28;
+          } else {
+            line = testLine;
+          }
+        }
+        ctx.fillText(line.trim(), 32, y);
+
+        // Recipient
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.font = '15.2px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(recipientText, 32, y + 38);
+
+        // Footer
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.font = '12.8px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'bottom';
+        ctx.fillText('ARTISANAL COFFEE CO.', 32, height - 28);
+        const rightFooter = 'REDEEMABLE AT ALL LOCATIONS';
+        const rightWidth = ctx.measureText(rightFooter).width;
+        ctx.fillText(rightFooter, width - 32 - rightWidth, height - 28);
+
+        ctx.restore();
+      }
+
+      // Render HTML #export_element inside the canvas
+      function renderCardToCanvas() {
+        const dpr = window.devicePixelRatio || 1;
+        const targetWidth = exportElement.offsetWidth || 480;
+        const targetHeight = exportElement.offsetHeight || 280;
+
+        if (canvas.width !== targetWidth * dpr || canvas.height !== targetHeight * dpr) {
+          canvas.width = targetWidth * dpr;
+          canvas.height = targetHeight * dpr;
+        }
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        ctx.scale(dpr, dpr);
+
+        if (typeof ctx.drawElementImage === 'function') {
+          const transform = ctx.drawElementImage(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+        } else if (typeof ctx.drawElement === 'function') {
+          const transform = ctx.drawElement(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+        } else {
+          drawFallbackCard();
+        }
+      }
+
+      // Synchronize with the browser's paint event lifecycle
+      canvas.onpaint = () => {
+        renderCardToCanvas();
+      };
+
+      function scheduleCanvasPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderCardToCanvas();
+        }
+      }
+
+      // Update card DOM and trigger paint synchronization
+      function updateCardDesign() {
+        const recipient = recipientInput.value.trim() || 'Coffee Lover';
+        const message = messageInput.value.trim() || 'Have a brew-tiful day on me!';
+        const bgColor = bgColorInput.value;
+
+        recipientDisplay.textContent = recipient;
+        messageDisplay.textContent = message;
+        exportElement.style.backgroundColor = bgColor;
+
+        scheduleCanvasPaint();
+      }
+
+      recipientInput.addEventListener('input', updateCardDesign);
+      messageInput.addEventListener('input', updateCardDesign);
+
+      bgColorInput.addEventListener('input', () => {
+        colorSwatches.forEach((btn) => {
+          btn.classList.toggle('active', btn.dataset.color.toLowerCase() === bgColorInput.value.toLowerCase());
+        });
+        updateCardDesign();
+      });
+
+      colorSwatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          const color = swatch.dataset.color;
+          bgColorInput.value = color;
+          colorSwatches.forEach((btn) => btn.classList.remove('active'));
+          swatch.classList.add('active');
+          updateCardDesign();
+        });
+      });
+
+      // Export / download the canvas design as an image file
+      exportBtn.addEventListener('click', () => {
+        scheduleCanvasPaint();
+        renderCardToCanvas();
+
+        const dataUrl = canvas.toDataURL('image/png');
+        const downloadLink = document.createElement('a');
+        downloadLink.download = 'coffee-gift-card.png';
+        downloadLink.href = dataUrl;
+        document.body.appendChild(downloadLink);
+        downloadLink.click();
+        document.body.removeChild(downloadLink);
+      });
+
+      if (!isHtmlInCanvasSupported && statusEl) {
+        statusEl.textContent = 'Preview rendered via Canvas 2D (enable HTML-in-Canvas for native DOM subtree painting).';
+      }
+
+      window.addEventListener('resize', scheduleCanvasPaint);
+
+      // Initial render
+      updateCardDesign();
+    })();
+  </script>
+
 </body>
 
 </html>
