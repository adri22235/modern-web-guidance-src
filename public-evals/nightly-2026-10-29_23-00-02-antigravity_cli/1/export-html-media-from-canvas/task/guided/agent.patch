+  <script>
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const export_element = document.getElementById('export_element');
+    const exportBtn = document.getElementById('export-card-btn');
+    const bgColorInput = document.getElementById('card-bg-color');
+    const swatchButtons = document.querySelectorAll('.swatch-btn');
+    const cardMessageInput = document.getElementById('card-message');
+    const cardRecipientInput = document.getElementById('card-recipient');
+    const fallbackNotice = document.getElementById('canvas-fallback-notice');
+
+    if ('content' in HTMLCanvasElement.prototype) {
+      canvas.onpaint = (event) => {
+        ctx.reset();
+        // Draw the styled HTML card element into the canvas.
+        // In 2D context, drawElementImage automatically syncs DOM geometry and hit-test bounds.
+        ctx.drawElementImage(export_element, 0, 0);
+      };
+
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        canvas.requestPaint();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+    } else {
+      fallbackNotice.style.display = 'block';
+    }
+
+    function requestCanvasRepaint() {
+      if ('content' in HTMLCanvasElement.prototype && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      }
+    }
+
+    function setCardBackgroundColor(color) {
+      export_element.style.backgroundColor = color;
+      bgColorInput.value = color;
+      requestCanvasRepaint();
+    }
+
+    bgColorInput.addEventListener('input', (event) => {
+      setCardBackgroundColor(event.target.value);
+    });
+
+    swatchButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        const selectedColor = button.getAttribute('data-color');
+        if (selectedColor) {
+          setCardBackgroundColor(selectedColor);
+        }
+      });
+    });
+
+    cardMessageInput.addEventListener('input', requestCanvasRepaint);
+    cardRecipientInput.addEventListener('input', requestCanvasRepaint);
+
+    exportBtn.onclick = () => {
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'coffee-gift-card.png';
+      link.href = dataURL;
+      link.click();
+    };
+  </script>
