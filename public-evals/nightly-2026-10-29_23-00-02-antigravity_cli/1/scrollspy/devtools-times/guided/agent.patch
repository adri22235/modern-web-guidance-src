     <Footer />
+    <script>
+      let cleanupScrollspy: (() => void) | null = null;
+
+      function initScrollspy() {
+        if (cleanupScrollspy) {
+          cleanupScrollspy();
+          cleanupScrollspy = null;
+        }
+
+        const navs = document.querySelectorAll<HTMLElement>('nav.scrollspy-nav');
+        if (navs.length === 0) return;
+
+        const supportsScrollTargetGroup = CSS.supports('scroll-target-group: auto');
+
+        if (supportsScrollTargetGroup) {
+          const syncAriaCurrent = () => {
+            navs.forEach((nav) => {
+              const currentLink = nav.querySelector('a:target-current');
+              nav.querySelectorAll('a').forEach((link) => {
+                link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
+              });
+            });
+          };
+          syncAriaCurrent();
+          document.addEventListener('scrollend', syncAriaCurrent);
+          cleanupScrollspy = () => {
+            document.removeEventListener('scrollend', syncAriaCurrent);
+          };
+        } else {
+          const observers: IntersectionObserver[] = [];
+
+          navs.forEach((nav) => {
+            const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+            const sections = navLinks
+              .map((link) => {
+                const hash = link.getAttribute('href');
+                return hash ? document.getElementById(hash.slice(1)) : null;
+              })
+              .filter((section): section is HTMLElement => section !== null);
+
+            const observer = new IntersectionObserver(
+              (entries) => {
+                entries.forEach((entry) => {
+                  if (entry.isIntersecting) {
+                    const id = entry.target.getAttribute('id');
+                    navLinks.forEach((link) => {
+                      const isActive = link.getAttribute('href') === `#${id}`;
+                      link.classList.toggle('target-current', isActive);
+                      link.setAttribute('aria-current', String(isActive));
+                    });
+                  }
+                });
+              },
+              { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
+            );
+
+            sections.forEach((section) => observer.observe(section));
+            observers.push(observer);
+          });
+
+          cleanupScrollspy = () => {
+            observers.forEach((observer) => observer.disconnect());
+          };
+        }
+      }
+
+      initScrollspy();
+      document.addEventListener('astro:page-load', initScrollspy);
+    </script>
   </body>
 </html>
