+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => {
+          const id = link.getAttribute('href').slice(1);
+          return document.getElementById(id);
+        })
+        .filter(Boolean);
+
+      function setActiveSection(activeId) {
+        navLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + activeId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function computeActiveSection() {
+        if (!sections.length) return;
+
+        const navHeight = nav ? nav.offsetHeight : 60;
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        const scrollBottom = window.scrollY + viewportHeight;
+        const docHeight = Math.max(
+          document.body.scrollHeight,
+          document.documentElement.scrollHeight
+        );
+
+        // If scrolled to the very bottom of the page, highlight the last section
+        if (docHeight - scrollBottom <= 15) {
+          setActiveSection(sections[sections.length - 1].id);
+          return;
+        }
+
+        // Reference line below the sticky navigation bar
+        const triggerLine = navHeight + Math.min(120, (viewportHeight - navHeight) * 0.3);
+
+        let activeSection = null;
+
+        // 1. Prefer the section that currently straddles the trigger line
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= triggerLine && rect.bottom > triggerLine) {
+            activeSection = section;
+            break;
+          }
+        }
+
+        // 2. Otherwise pick the section with the greatest visible height in the viewport below the nav
+        if (!activeSection) {
+          let maxVisible = 0;
+          for (const section of sections) {
+            const rect = section.getBoundingClientRect();
+            const visibleTop = Math.max(rect.top, navHeight);
+            const visibleBottom = Math.min(rect.bottom, viewportHeight);
+            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+            if (visibleHeight > maxVisible) {
+              maxVisible = visibleHeight;
+              activeSection = section;
+            }
+          }
+        }
+
+        // 3. Fallback to the last section whose top has passed the trigger line, or the first section
+        if (!activeSection) {
