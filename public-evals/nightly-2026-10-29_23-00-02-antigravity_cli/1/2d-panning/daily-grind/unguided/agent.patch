+          if (dragState.totalMoved > 6) {
+            e.preventDefault();
+            return;
+          }
+          selectCafePin(pin);
+        });
+      });
+
+      // Quick jump buttons
+      if (quickJumpsContainer) {
+        quickJumpsContainer.addEventListener('click', function (e) {
+          const btn = e.target.closest('.map-chip');
+          if (!btn) return;
+          const cafeId = btn.getAttribute('data-cafe-id');
+          const pin = surface.querySelector('.cafe-pin[data-cafe-id="' + cafeId + '"]');
+          if (pin) {
+            const x = parseFloat(pin.style.left) || 1200;
+            const y = parseFloat(pin.style.top) || 900;
+            selectCafePin(pin);
+            centerOnPoint(x, y);
+          }
+        });
+      }
+
+      if (resetBtn) {
+        resetBtn.addEventListener('click', function () {
+          const defaultPin = surface.querySelector('.cafe-pin[data-cafe-id="roastery-hq"]');
+          if (defaultPin) selectCafePin(defaultPin);
+          centerOnPoint(1200, 900);
+        });
+      }
+    })();
