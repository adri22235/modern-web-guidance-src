+  <script>
+    (function () {
+      const viewport = document.getElementById('cafe-map-viewport');
+      const surface = document.getElementById('cafe-map-surface');
+      const coordsReadout = document.getElementById('map-coords-readout');
+      const resetBtn = document.getElementById('map-reset-btn');
+      const quickJumpsContainer = document.getElementById('map-quick-jumps');
+      const pins = Array.from(surface.querySelectorAll('.cafe-pin'));
+
+      const detailName = document.getElementById('cafe-detail-name');
+      const detailAddress = document.getElementById('cafe-detail-address');
+      const detailFeature = document.getElementById('cafe-detail-feature');
+
+      function updateReadout() {
+        const x = Math.round(viewport.scrollLeft);
+        const y = Math.round(viewport.scrollTop);
+        surface.dataset.panX = String(-x);
+        surface.dataset.panY = String(-y);
+        if (coordsReadout) {
+          coordsReadout.textContent = 'X: ' + x + ', Y: ' + y;
+        }
+      }
+
+      function centerOnPoint(surfaceX, surfaceY) {
+        const targetLeft = Math.max(0, Math.round(surfaceX - viewport.clientWidth / 2));
+        const targetTop = Math.max(0, Math.round(surfaceY - viewport.clientHeight / 2));
+        viewport.scrollLeft = targetLeft;
+        viewport.scrollTop = targetTop;
+        updateReadout();
+      }
+
+      function selectCafePin(pin) {
+        if (!pin) return;
+        pins.forEach(function (p) {
+          p.classList.toggle('selected', p === pin);
+        });
+        const cafeId = pin.getAttribute('data-cafe-id');
+        if (quickJumpsContainer) {
+          Array.from(quickJumpsContainer.querySelectorAll('.map-chip')).forEach(function (chip) {
+            chip.classList.toggle('active', chip.getAttribute('data-cafe-id') === cafeId);
+          });
+        }
+        if (detailName) detailName.textContent = pin.getAttribute('data-name') || '';
+        if (detailAddress) {
+          detailAddress.textContent =
+            (pin.getAttribute('data-address') || '') + ' • ' + (pin.getAttribute('data-hours') || '');
+        }
+        if (detailFeature) {
+          detailFeature.textContent = 'Specialty: ' + (pin.getAttribute('data-feature') || '');
+        }
+      }
+
+      // Initialize map centered at (1200, 900) so users can immediately pan in all 2D directions
+      centerOnPoint(1200, 900);
+
+      viewport.addEventListener('scroll', updateReadout, { passive: true });
+
+      // Support 2D wheel / trackpad scrolling (horizontal, vertical, and diagonal simultaneously)
+      viewport.addEventListener(
+        'wheel',
+        function (e) {
+          const dx = typeof e.deltaX === 'number' ? e.deltaX : 0;
+          const dy = typeof e.deltaY === 'number' ? e.deltaY : 0;
+          if (dx !== 0 || dy !== 0) {
+            if (e.cancelable) e.preventDefault();
+            viewport.scrollLeft += dx;
+            viewport.scrollTop += dy;
+            updateReadout();
+          }
+        },
+        { passive: false }
+      );
+
+      // Free 2D drag-to-pan state (supports pointer, mouse, and touch events without axis locking)
+      const dragState = {
+        active: false,
+        lastX: 0,
+        lastY: 0,
+        totalMoved: 0
+      };
+
+      const handledEvents = typeof WeakSet !== 'undefined' ? new WeakSet() : null;
+
+      function markHandled(e) {
+        if (!handledEvents || !e) return false;
+        if (handledEvents.has(e)) return true;
+        handledEvents.add(e);
+        return false;
+      }
+
+      function getEventPoint(e) {
+        let src = e;
+        if (e.touches && e.touches.length > 0) {
+          src = e.touches[0];
+        } else if (e.changedTouches && e.changedTouches.length > 0) {
+          src = e.changedTouches[0];
+        }
+        const x = typeof src.clientX === 'number' ? src.clientX : (typeof src.pageX === 'number' ? src.pageX : 0);
+        const y = typeof src.clientY === 'number' ? src.clientY : (typeof src.pageY === 'number' ? src.pageY : 0);
+        return { x: x, y: y };
+      }
+
+      function onPanStart(e) {
+        if (markHandled(e)) return;
+        if (e.type === 'mousedown' && typeof e.button === 'number' && e.button !== 0) return;
+        const pt = getEventPoint(e);
+        if (!dragState.active) {
+          dragState.active = true;
+          dragState.lastX = pt.x;
+          dragState.lastY = pt.y;
+          dragState.totalMoved = 0;
+          viewport.classList.add('is-panning');
+        }
+      }
+
+      function onPanMove(e) {
+        if (!dragState.active) return;
+        if (markHandled(e)) return;
+        if (e.type === 'touchmove' && e.cancelable) {
