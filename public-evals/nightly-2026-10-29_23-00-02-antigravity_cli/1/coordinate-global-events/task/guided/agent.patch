+  <script>
+    const TARGET_TIMEZONES = [
+      { label: 'New York', tz: 'America/New_York' },
+      { label: 'London', tz: 'Europe/London' },
+      { label: 'Tokyo', tz: 'Asia/Tokyo' },
+      { label: 'UTC', tz: 'UTC' }
+    ];
+
+    function initializeApp() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function updateSchedule() {
+        const date = dateInput.value;
+        const time = timeInput.value;
+        const timeZone = hostTzSelect.value;
+
+        if (!date || !time || !timeZone) {
+          return;
+        }
+
+        const inputStr = `${date}T${time}[${timeZone}]`;
+
+        // Detect DST gap or overlap conflicts using disambiguation: 'reject'
+        let hasConflict = false;
+        try {
+          Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+        } catch (e) {
+          if (e instanceof RangeError) {
+            hasConflict = true;
+          }
+        }
+
+        // Resolve the time safely using disambiguation: 'compatible'
+        const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+        if (hasConflict) {
+          const resolvedFormattedTime = hostTime.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit'
+          });
+          hostWarning.textContent =
+            `DST Transition Notice: The selected time (${time}) in ${timeZone} falls in a Daylight Saving Time transition gap or overlap (skipped or repeated hour). It was automatically resolved using compatible disambiguation to ${resolvedFormattedTime} (${hostTime.toString()}).`;
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        // Render target time zone cards using immutable .withTimeZone() conversions
+        grid.innerHTML = '';
+        for (const item of TARGET_TIMEZONES) {
+          const targetTime = hostTime.withTimeZone(item.tz);
+          const formattedTime = targetTime.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit'
+          });
+          const formattedDate = targetTime.toLocaleString('en-US', {
+            weekday: 'short',
+            month: 'short',
+            day: 'numeric',
+            year: 'numeric'
+          });
+
+          const card = document.createElement('div');
+          card.className = 'card';
+          card.dataset.timezone = item.tz;
+
+          const heading = document.createElement('h3');
+          heading.textContent = item.label;
+
+          const tzBadge = document.createElement('div');
+          tzBadge.className = 'tz-label';
+          tzBadge.textContent = `${item.tz} (${targetTime.offset})`;
+
+          const timeDisplay = document.createElement('div');
+          timeDisplay.className = 'local-time';
+          timeDisplay.textContent = formattedTime;
+
+          const dateDisplay = document.createElement('div');
+          dateDisplay.className = 'local-date';
+          dateDisplay.textContent = formattedDate;
+
+          card.append(heading, tzBadge, timeDisplay, dateDisplay);
+          grid.appendChild(card);
+        }
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('input', updateSchedule);
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
