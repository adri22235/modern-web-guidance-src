+  <script>
+    (function () {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const TARGET_TIMEZONES = [
+        { label: 'New York', timeZone: 'America/New_York' },
+        { label: 'London', timeZone: 'Europe/London' },
+        { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+        { label: 'UTC', timeZone: 'UTC' }
+      ];
+
+      function formatLocalTime(zdt) {
+        const hour24 = zdt.hour;
+        const minute = String(zdt.minute).padStart(2, '0');
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 || 12;
+        return `${hour12}:${minute} ${period}`;
+      }
+
+      function formatLocalDate(zdt) {
+        return zdt.toPlainDate().toString();
+      }
+
+      function updateSchedule() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateVal || !timeVal || !hostTz) {
+          return;
+        }
+
+        const plainDate = Temporal.PlainDate.from(dateVal);
+        const plainTime = Temporal.PlainTime.from(timeVal);
+        const requestedPlainDateTime = plainDate.toPlainDateTime(plainTime);
+
+        const earlierZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'earlier'
+        });
+        const laterZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'later'
+        });
+        const resolvedHostZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'compatible'
+        });
+
+        let hasConflict = false;
+        try {
+          requestedPlainDateTime.toZonedDateTime(hostTz, {
+            disambiguation: 'reject'
+          });
+        } catch (err) {
+          hasConflict = true;
+        }
+
+        if (hasConflict || !earlierZdt.equals(laterZdt)) {
+          const resolvedPlain = resolvedHostZdt.toPlainDateTime();
+          const isGap = !resolvedPlain.equals(requestedPlainDateTime);
+          const resolvedTimeFormatted = formatLocalTime(resolvedHostZdt);
+
+          if (isGap) {
+            hostWarning.textContent =
+              `Daylight Saving Time Gap Detected: The selected local time (${timeVal}) does not exist in ${hostTz} because clocks spring forward during a DST transition gap (from UTC${earlierZdt.offset} to UTC${laterZdt.offset}). Using immutable Temporal resolution ('compatible' / 'later' disambiguation), the host time was automatically shifted forward and resolved to ${resolvedTimeFormatted} (UTC${resolvedHostZdt.offset}).`;
+          } else {
+            hostWarning.textContent =
+              `Daylight Saving Time Overlap Detected: The selected local time (${timeVal}) is ambiguous in ${hostTz} because clocks fall back during a DST transition overlap and ${resolvedTimeFormatted} occurs twice (first at UTC${earlierZdt.offset} and again at UTC${laterZdt.offset}). Using immutable Temporal resolution ('compatible' / 'earlier' disambiguation), the conflict was resolved to the first (earlier) occurrence at ${resolvedTimeFormatted} (UTC${resolvedHostZdt.offset}).`;
+          }
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        grid.innerHTML = '';
+
+        TARGET_TIMEZONES.forEach(function (target) {
+          const targetZdt = resolvedHostZdt.withTimeZone(target.timeZone);
+          const formattedTime = formatLocalTime(targetZdt);
+          const formattedDate = formatLocalDate(targetZdt);
+
+          const card = document.createElement('div');
+          card.className = 'card tz-card';
+          card.setAttribute('data-timezone', target.timeZone);
+
+          const heading = document.createElement('h3');
+          heading.textContent = target.label;
+
+          const timeEl = document.createElement('p');
+          timeEl.className = 'tz-time';
+          timeEl.textContent = formattedTime;
+
+          const metaEl = document.createElement('p');
+          metaEl.className = 'tz-meta';
+          metaEl.textContent = `${formattedDate} • ${target.timeZone} (UTC${targetZdt.offset})`;
+
+          card.appendChild(heading);
+          card.appendChild(timeEl);
+          card.appendChild(metaEl);
+          grid.appendChild(card);
+        });
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('input', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
