+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+      if (!items.length || !thumbnails.length) return;
+
+      let activeIndex = 0;
+      let pendingIndex = null;
+      let explicitTargetIndex = null;
+      let lastScrollLeft = gallery.scrollLeft;
+      let lastScrollLeftAtFinalize = gallery.scrollLeft;
+      let isScrolling = false;
+      let scrollTimeout = null;
+
+      function getItemSnapLeft(index) {
+        const item = items[index];
+        if (!item) return 0;
+        const firstLeft = items[0] ? items[0].offsetLeft : 0;
+        const baseLeft = item.offsetLeft - firstLeft;
+        if (gallery.clientWidth > 0 && item.offsetWidth > 0) {
+          return baseLeft + (item.offsetWidth - gallery.clientWidth) / 2;
+        }
+        return baseLeft;
+      }
+
+      function getClosestIndex(scrollLeft = gallery.scrollLeft) {
+        let closest = 0;
+        let minDiff = Infinity;
+        for (let i = 0; i < items.length; i++) {
+          const diff = Math.abs(scrollLeft - getItemSnapLeft(i));
+          if (diff < minDiff) {
+            minDiff = diff;
+            closest = i;
+          }
+        }
+        return closest;
+      }
+
+      function computeDirectionalTarget(currentLeft, delta) {
+        const n = items.length;
+        const positions = items.map((_, i) => getItemSnapLeft(i));
+
+        if (currentLeft <= positions[0] + 1) return 0;
+        if (currentLeft >= positions[n - 1] - 1) return n - 1;
+
+        for (let i = 0; i < n; i++) {
+          if (Math.abs(currentLeft - positions[i]) <= 1) {
+            return i;
+          }
+        }
+
+        let k = 0;
+        for (let i = 0; i < n - 1; i++) {
+          if (currentLeft >= positions[i] && currentLeft <= positions[i + 1]) {
+            k = i;
+            break;
+          }
+        }
+
+        if (delta > 0) return Math.min(k + 1, n - 1);
+        if (delta < 0) return Math.max(k, 0);
+
+        const closest = getClosestIndex(currentLeft);
+        if (closest !== activeIndex) return closest;
+        if (currentLeft > positions[activeIndex]) return Math.min(activeIndex + 1, n - 1);
+        if (currentLeft < positions[activeIndex]) return Math.max(activeIndex - 1, 0);
+        return closest;
+      }
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        pendingIndex = index;
+        isScrolling = true;
+        thumbnails.forEach((thumb, i) => {
+          if (i === index) {
+            thumb.classList.add('pending');
+          } else {
+            thumb.classList.remove('pending');
+          }
+        });
+      }
+
+      function finalizeScroll(index) {
+        if (scrollTimeout) {
+          clearTimeout(scrollTimeout);
+          scrollTimeout = null;
+        }
+        const resolvedIndex = (typeof index === 'number' && index >= 0 && index < thumbnails.length)
+          ? index
+          : (pendingIndex !== null ? pendingIndex : getClosestIndex());
+
+        activeIndex = resolvedIndex;
+        pendingIndex = null;
+        explicitTargetIndex = null;
+        isScrolling = false;
+        lastScrollLeft = gallery.scrollLeft;
+        lastScrollLeftAtFinalize = gallery.scrollLeft;
+
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.remove('pending');
+          if (i === resolvedIndex) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function scheduleScrollEndFallback() {
+        if (scrollTimeout) clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(() => {
+          if (isScrolling || pendingIndex !== null) {
+            const currentLeft = gallery.scrollLeft;
+            const closest = getClosestIndex(currentLeft);
+            const isAtSnap = Math.abs(currentLeft - getItemSnapLeft(closest)) <= 5;
+            const target = isAtSnap ? closest : (pendingIndex !== null ? pendingIndex : closest);
+            finalizeScroll(target);
+          }
+        }, 150);
+      }
+
+      // Listen for CSS Scroll Snap changing events (mid-scroll)
+      gallery.addEventListener('scrollsnapchanging', (e) => {
+        const snapTarget = e.snapTargetInline || e.snapTargetBlock;
+        const idx = snapTarget ? items.indexOf(snapTarget) : -1;
+        if (idx !== -1) {
+          explicitTargetIndex = idx !== activeIndex ? idx : null;
+          setPending(idx);
+          scheduleScrollEndFallback();
+        }
+      });
+
+      // Listen for CSS Scroll Snap change events (scroll finished)
+      gallery.addEventListener('scrollsnapchange', (e) => {
+        const snapTarget = e.snapTargetInline || e.snapTargetBlock;
+        const idx = snapTarget ? items.indexOf(snapTarget) : -1;
+        finalizeScroll(idx !== -1 ? idx : getClosestIndex());
+      });
+
+      // Listen for standard scroll events for immediate mid-scroll feedback
+      gallery.addEventListener('scroll', () => {
+        const currentLeft = gallery.scrollLeft;
+        const delta = currentLeft - lastScrollLeft;
+        lastScrollLeft = currentLeft;
+
+        const targetIndex = explicitTargetIndex !== null
+          ? explicitTargetIndex
+          : computeDirectionalTarget(currentLeft, delta);
+
+        setPending(targetIndex);
+        scheduleScrollEndFallback();
+      }, { passive: true });
+
+      // Listen for scrollend event to finalize active thumbnail
+      gallery.addEventListener('scrollend', () => {
+        if (!isScrolling && pendingIndex === null && gallery.scrollLeft === lastScrollLeftAtFinalize) {
+          finalizeScroll(activeIndex);
+          return;
+        }
+        const currentLeft = gallery.scrollLeft;
+        const closest = getClosestIndex(currentLeft);
+        const isAtSnap = Math.abs(currentLeft - getItemSnapLeft(closest)) <= 5;
+        const target = isAtSnap ? closest : (pendingIndex !== null ? pendingIndex : closest);
+        finalizeScroll(target);
+      });
+
+      // Wrap programmatic scrollTo / scrollBy on #gallery for immediate pending feedback
+      const nativeScrollTo = gallery.scrollTo.bind(gallery);
+      gallery.scrollTo = function (optionsOrX, y) {
+        let targetLeft = gallery.scrollLeft;
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          if (typeof optionsOrX.left === 'number') targetLeft = optionsOrX.left;
+        } else if (typeof optionsOrX === 'number') {
+          targetLeft = optionsOrX;
+        }
+        const delta = targetLeft - gallery.scrollLeft;
+        const targetIdx = computeDirectionalTarget(targetLeft, delta);
+        explicitTargetIndex = targetIdx;
+        setPending(targetIdx);
+        scheduleScrollEndFallback();
+        return nativeScrollTo(optionsOrX, y);
+      };
+
+      const nativeScrollBy = gallery.scrollBy.bind(gallery);
+      gallery.scrollBy = function (optionsOrX, y) {
+        let deltaX = 0;
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          if (typeof optionsOrX.left === 'number') deltaX = optionsOrX.left;
+        } else if (typeof optionsOrX === 'number') {
+          deltaX = optionsOrX;
+        }
+        const targetLeft = gallery.scrollLeft + deltaX;
+        const targetIdx = computeDirectionalTarget(targetLeft, deltaX);
+        explicitTargetIndex = targetIdx;
+        setPending(targetIdx);
+        scheduleScrollEndFallback();
+        return nativeScrollBy(optionsOrX, y);
+      };
+
+      // Thumbnail click navigation
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          const targetLeft = getItemSnapLeft(index);
+          if (Math.abs(gallery.scrollLeft - targetLeft) <= 2) {
+            finalizeScroll(index);
+          } else {
+            explicitTargetIndex = index;
+            setPending(index);
+            gallery.scrollTo({ left: targetLeft, behavior: 'smooth' });
+          }
+        });
+      });
+
+      items.forEach((item, index) => {
+        if (typeof item.scrollIntoView === 'function') {
+          const nativeScrollIntoView = item.scrollIntoView.bind(item);
+          item.scrollIntoView = function (arg) {
+            explicitTargetIndex = index;
+            setPending(index);
+            scheduleScrollEndFallback();
+            return nativeScrollIntoView(arg);
+          };
+        }
+      });
+
+      // Ensure initial state is synchronized
+      finalizeScroll(0);
+    })();
+  </script>
+
