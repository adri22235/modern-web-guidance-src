diff --git a/src/pages/api/send-otp.ts b/src/pages/api/send-otp.ts
new file mode 100644
index 0000000..9210e1c
--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,74 @@
+import type { APIRoute } from 'astro';
+
+const PHONE_REGEX = /^\+?[0-9\s\-().]{7,20}$/;
+
+function normalizePhone(phone: string): string {
+  const trimmed = phone.trim();
+  const hasPlus = trimmed.startsWith('+');
+  const digits = trimmed.replace(/\D/g, '');
+  return hasPlus ? `+${digits}` : digits;
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json();
+    const rawPhone = typeof body?.phone === 'string' ? body.phone.trim() : '';
+
+    if (!rawPhone) {
+      return new Response(
+        JSON.stringify({ error: 'Phone number is required.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const digitsOnly = rawPhone.replace(/\D/g, '');
+    if (!PHONE_REGEX.test(rawPhone) || digitsOnly.length < 7 || digitsOnly.length > 15) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid phone number.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const normalizedPhone = normalizePhone(rawPhone);
+    const code = '123456';
+    const host = url.hostname || 'localhost';
+    // WebOTP API standard origin-bound one-time code SMS format
+    const smsMessage = `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+
+    if (session) {
+      await session.set('otpVerification', {
+        phone: normalizedPhone,
+        code,
+        expiresAt: Date.now() + 10 * 60 * 1000,
+        verified: false,
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Verification code sent via SMS.',
+        phone: normalizedPhone,
+        smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Failed to process SMS verification request.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
