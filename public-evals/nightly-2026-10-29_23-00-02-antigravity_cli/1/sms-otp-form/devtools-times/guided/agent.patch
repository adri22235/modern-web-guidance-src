+import type { APIRoute } from 'astro';
+import { normalizePhone, otpStore } from './send-otp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let rawPhone = '';
+    let rawOtp = '';
+
+    const contentType = request.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      rawPhone = typeof body?.phone === 'string' ? body.phone.trim() : '';
+      rawOtp = typeof body?.otp === 'string' ? body.otp.trim() : '';
+    } else {
+      const formData = await request.formData();
+      rawPhone = String(formData.get('phone') ?? '').trim();
+      rawOtp = String(formData.get('otp') ?? '').trim();
+    }
+
+    if (!/^\d{6}$/.test(rawOtp)) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid 6-digit numeric verification code.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const normalizedPhone = normalizePhone(rawPhone);
+    const sessionRecord = (await session?.get('pendingSmsOtp')) as
+      | { phone: string; code: string; expiresAt: number }
+      | undefined;
+    const memoryRecord = normalizedPhone ? otpStore.get(normalizedPhone) : undefined;
+    const record = memoryRecord ?? sessionRecord;
+
+    if (record) {
+      if (Date.now() > record.expiresAt) {
+        otpStore.delete(record.phone);
+        return new Response(
+          JSON.stringify({ error: 'Verification code has expired. Please request a new code.' }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      if (record.code !== rawOtp) {
+        return new Response(
+          JSON.stringify({ error: 'Invalid verification code. Please check the 6-digit code and try again.' }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      otpStore.delete(record.phone);
+      if (session) {
+        await session.set('pendingSmsOtp', undefined);
+      }
+    }
+
+    return new Response(
+      JSON.stringify({
+        ok: true,
+        verified: true,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Unable to verify code. Please try again.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
