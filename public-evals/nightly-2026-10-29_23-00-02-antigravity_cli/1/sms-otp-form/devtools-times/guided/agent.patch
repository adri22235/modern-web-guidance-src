--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,79 @@
+import type { APIRoute } from 'astro';
+import { randomInt } from 'node:crypto';
+import { extractHostDomain, formatOriginBoundSms } from '../../utils/smsOtp';
+
+interface StoredOtpRecord {
+  phone: string;
+  code: string;
+  expiresAt: number;
+}
+
+// In-memory store paired with Astro session for SMS OTP verification
+export const otpStore = new Map<string, StoredOtpRecord>();
+
+export function normalizePhone(phone: string): string {
+  return phone.replace(/[^\d+]/g, '');
+}
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const rawPhone = typeof body?.phone === 'string' ? body.phone.trim() : '';
+    const normalizedPhone = normalizePhone(rawPhone);
+
+    if (!normalizedPhone || normalizedPhone.replace(/\D/g, '').length < 7) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid phone number.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Generate a 6-digit numeric passcode preserving leading zeros
+    const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+    const expiresAt = Date.now() + 5 * 60 * 1000;
+
+    const record: StoredOtpRecord = {
+      phone: normalizedPhone,
+      code,
+      expiresAt,
+    };
+
+    otpStore.set(normalizedPhone, record);
+    if (session) {
+      await session.set('pendingSmsOtp', record);
+    }
+
+    const requestHost =
+      (typeof body?.domain === 'string' && body.domain) ||
+      request.headers.get('origin') ||
+      request.headers.get('host') ||
+      new URL(request.url).hostname;
+
+    const hostDomain = extractHostDomain(requestHost);
+    const smsMessage = formatOriginBoundSms(code, hostDomain);
+
+    return new Response(
+      JSON.stringify({
+        ok: true,
+        phone: rawPhone,
+        domain: hostDomain,
+        smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Failed to send verification code. Please try again.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
