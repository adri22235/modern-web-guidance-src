+/**
+ * Extracts only the bare host domain from an origin, URL, or host string.
+ * Strips URL schemes (https://, http://), ports (:8080), paths (/verify), and whitespace
+ * as required by the origin-bound SMS OTP specification.
+ */
+export function extractHostDomain(originOrHost: string): string {
+  const trimmed = originOrHost.trim();
+  if (!trimmed) {
+    return 'localhost';
+  }
+
+  try {
+    const url = trimmed.includes('://') ? new URL(trimmed) : new URL(`https://${trimmed}`);
+    return url.hostname || 'localhost';
+  } catch {
+    return trimmed
+      .replace(/^[a-zA-Z][a-zA-Z\d+\-.]*:\/\//, '')
+      .split('/')[0]
+      .split(':')[0]
+      .replace(/\s+/g, '') || 'localhost';
+  }
+}
+
+/**
+ * Formats an outgoing SMS verification message following the origin-bound one-time code format:
+ * 1. Starts with human-readable text containing the 6-digit code.
+ * 2. Places `@<domain> #<otp>` on the very last line with no trailing text.
+ * 3. Uses only the host domain (no scheme, port, or path) and a single space between tokens.
+ */
+export function formatOriginBoundSms(
+  code: string,
+  originOrHost: string,
+  embeddedOriginOrHost?: string
+): string {
+  const cleanCode = code.trim().replace(/\s+/g, '');
+  const hostDomain = extractHostDomain(originOrHost);
+  const bindingLine = embeddedOriginOrHost
+    ? `@${hostDomain} #${cleanCode} @${extractHostDomain(embeddedOriginOrHost)}`
+    : `@${hostDomain} #${cleanCode}`;
+
+  return `Your verification code is ${cleanCode}.\n\n${bindingLine}`;
+}
