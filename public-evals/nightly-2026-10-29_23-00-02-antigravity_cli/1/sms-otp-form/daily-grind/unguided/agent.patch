+  <script>
+    (function () {
+      const statusEl = document.getElementById('otp-status');
+      const contextDescEl = document.getElementById('otp-context-description');
+      const tabRewards = document.getElementById('tab-rewards');
+      const tabOrder = document.getElementById('tab-order');
+      const resendBtn = document.getElementById('resend-otp-btn');
+      let currentPurpose = 'rewards';
+
+      function extractCodeFromText(text) {
+        if (!text) return '';
+        const trimmed = String(text).trim();
+        if (/^\d{4,8}$/.test(trimmed)) {
+          return trimmed.slice(0, 6);
+        }
+        const hashMatch = trimmed.match(/#(\d{4,8})\b/);
+        if (hashMatch) {
+          return hashMatch[1].slice(0, 6);
+        }
+        const sixDigitMatch = trimmed.match(/\b(\d{6})\b/);
+        if (sixDigitMatch) {
+          return sixDigitMatch[1];
+        }
+        const digitsOnly = trimmed.replace(/\D/g, '');
+        return digitsOnly.slice(0, 6);
+      }
+
+      function setStatus(message, type) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'otp-status' + (type ? ' ' + type : '');
+        statusEl.hidden = !message;
+      }
+
+      function showVerifiedStatus(code) {
+        const destination = currentPurpose === 'order'
+          ? 'Online Order Checkout'
+          : 'Daily Grind Rewards';
+        setStatus('Passcode ' + code + ' verified! Continuing to ' + destination + '.', 'success');
+      }
+
+      function setPurpose(purpose, focusInput) {
+        currentPurpose = purpose === 'order' ? 'order' : 'rewards';
+        if (tabRewards && tabOrder) {
+          const isOrder = currentPurpose === 'order';
+          tabRewards.setAttribute('aria-pressed', String(!isOrder));
+          tabOrder.setAttribute('aria-pressed', String(isOrder));
+        }
+        if (contextDescEl) {
+          contextDescEl.textContent = currentPurpose === 'order'
+            ? 'Verify your mobile number with a one-time passcode to complete your online coffee order.'
+            : 'Verify your mobile number with a one-time passcode to sign in to Daily Grind Rewards.';
+        }
+        if (focusInput) {
+          const input = document.querySelector('input[autocomplete="one-time-code"]');
+          if (input) input.focus();
+        }
+      }
+
+      if (tabRewards) {
+        tabRewards.addEventListener('click', function () {
+          setPurpose('rewards', true);
+        });
+      }
+
+      if (tabOrder) {
+        tabOrder.addEventListener('click', function () {
+          setPurpose('order', true);
+        });
+      }
+
+      const rewardsLink = document.querySelector('nav a[href="/rewards"]');
+      if (rewardsLink) {
+        rewardsLink.addEventListener('click', function (e) {
+          e.preventDefault();
+          setPurpose('rewards', true);
+        });
+      }
+
+      const orderBtn = document.querySelector('.hero a[href="/order-online"]');
+      if (orderBtn) {
+        orderBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          setPurpose('order', true);
+        });
+      }
+
+      const otpInput = document.querySelector('input[autocomplete="one-time-code"]');
+      if (otpInput) {
+        otpInput.addEventListener('paste', function (e) {
+          const clipboardData = e.clipboardData || window.clipboardData;
+          if (!clipboardData) return;
+          const pastedText = clipboardData.getData('text');
+          const extracted = extractCodeFromText(pastedText);
+          if (extracted) {
+            e.preventDefault();
+            otpInput.value = extracted;
+            otpInput.setCustomValidity('');
+          }
+        });
+
+        otpInput.addEventListener('input', function () {
+          otpInput.setCustomValidity('');
+          if (otpInput.value.length > 6) {
+            const extracted = extractCodeFromText(otpInput.value);
+            if (extracted) {
+              otpInput.value = extracted;
+            }
+          }
+        });
+      }
+
+      const otpForm = document.getElementById('otp-form');
+      if (otpForm && otpInput) {
+        otpForm.addEventListener('submit', function (e) {
+          e.preventDefault();
+          const code = extractCodeFromText(otpInput.value);
+          if (/^\d{6}$/.test(code)) {
+            otpInput.value = code;
+            otpInput.setCustomValidity('');
+            showVerifiedStatus(code);
+          } else {
+            otpInput.setCustomValidity('Please enter a valid 6-digit numeric passcode.');
+            setStatus('Please enter a valid 6-digit numeric passcode.', 'error');
+          }
+        });
+      }
+
+      if (resendBtn) {
+        resendBtn.addEventListener('click', function () {
+          setStatus('A new 6-digit SMS verification code has been sent to your phone.', '');
+          if (otpInput) otpInput.focus();
+        });
+      }
+
+      if ('OTPCredential' in window) {
+        window.addEventListener('DOMContentLoaded', function () {
+          const input = document.querySelector('input[autocomplete="one-time-code"]');
+          if (!input) return;
+          const ac = new AbortController();
+          const form = input.closest('form');
+          if (form) {
+            form.addEventListener('submit', function () {
+              ac.abort();
+            });
+          }
+          navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal
+          }).then(function (otp) {
+            if (otp && otp.code) {
+              input.value = otp.code;
+              showVerifiedStatus(otp.code);
+              if (form) form.submit();
+            }
+          }).catch(function () {
+            // Ignore abort or unsupported environment errors
+          });
+        });
+      }
+    })();
+  </script>
