+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const resendOtpBtn = document.getElementById('resend-otp-btn');
+    const verifyOtpBtn = document.getElementById('verify-otp-btn');
+    const otpStatus = document.getElementById('otp-status');
+    const smsPreview = document.getElementById('sms-preview');
+    const smsPreviewText = document.getElementById('sms-preview-text');
+
+    let otpAbortController = null;
+
+    function formatOriginBoundSms(code, domain = window.location.hostname || 'dailygrind.example') {
+      const cleanHost = domain.replace(/^https?:\/\//, '').split('/')[0].split(':')[0];
+      return `Your Daily Grind verification code is ${code}.\n\n@${cleanHost} #${code}`;
+    }
+
+    function showStatus(message, type = 'info') {
+      if (!otpStatus) return;
+      otpStatus.textContent = message;
+      otpStatus.className = `otp-status ${type}`;
+      otpStatus.hidden = false;
+    }
+
+    function setOtpError(message) {
+      if (!otpInput || !otpError) return;
+      if (message) {
+        otpInput.setCustomValidity(message);
+        otpInput.setAttribute('aria-invalid', 'true');
+        otpError.textContent = `Error: ${message}`;
+        otpError.hidden = false;
+      } else {
+        otpInput.setCustomValidity('');
+        otpInput.removeAttribute('aria-invalid');
+        otpError.textContent = '';
+        otpError.hidden = true;
+      }
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        setOtpError('');
+        otpInput.value = otp.code;
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    function issueNewPasscode(phoneValue) {
+      const demoCode = '123456';
+      if (smsPreview && smsPreviewText) {
+        smsPreviewText.textContent = formatOriginBoundSms(demoCode);
+        smsPreview.hidden = false;
+      }
+      const targetLabel = phoneValue ? ` to ${phoneValue}` : '';
+      showStatus(`A 6-digit verification code has been sent${targetLabel}.`, 'info');
+      setOtpError('');
+      if (verifyOtpBtn) {
+        verifyOtpBtn.disabled = false;
+      }
+      startSmsOtpListener();
+    }
+
+    if (phoneForm) {
+      phoneForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!phoneInput.checkValidity()) {
+          phoneInput.reportValidity();
+          return;
+        }
+        issueNewPasscode(phoneInput.value.trim());
+        otpInput.focus();
+      });
+    }
+
+    if (resendOtpBtn) {
+      resendOtpBtn.addEventListener('click', () => {
+        issueNewPasscode(phoneInput ? phoneInput.value.trim() : '');
+        otpInput.focus();
+      });
+    }
+
+    if (otpInput) {
+      // Clear existing errors on input without showing premature errors while typing
+      otpInput.addEventListener('input', () => {
+        setOtpError('');
+        if ( verifyOtpBtn && verifyOtpBtn.disabled ) {
+          verifyOtpBtn.disabled = false;
+        }
+      });
+
+      // Validate on blur once the user exits the field
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value.length > 0 && !/^\d{6}$/.test(otpInput.value)) {
+          setOtpError('Please enter a valid 6-digit numeric verification code.');
+        }
+      });
+    }
+
+    if (otpForm) {
+      otpForm.addEventListener('submit', async (event) => {
+        // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+        stopSmsOtpListener();
+
+        event.preventDefault();
+
+        const code = otpInput ? otpInput.value.trim() : '';
+        if (!/^\d{6}$/.test(code)) {
+          setOtpError('Please enter a valid 6-digit numeric verification code.');
+          otpInput.focus();
+          return;
+        }
+
+        setOtpError('');
+        if (verifyOtpBtn) {
+          verifyOtpBtn.disabled = true;
+        }
+
+        const formData = new FormData(otpForm);
+        showStatus(`Passcode ${ formData.get('otp') } verified! You are now signed in to Daily Grind Rewards & Online Ordering.`, 'success');
+      });
+    }
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
 </body>
 
