+  <script type="module">
+    // Out-of-order coffee order events recorded by distributed backend services
+    // with nanosecond-precision ISO 8601 UTC timestamps, including multiple events
+    // occurring within the exact same millisecond (14:32:10.045s).
+    const rawOrderEvents = [
+      {
+        orderId: 'ORD-8842',
+        service: 'barista-queue-svc',
+        eventType: 'order.queued_for_barista',
+        detail: 'Assigned to Espresso Bar #1 (Maple Oat Latte)',
+        ts: '2026-10-30T14:32:10.045891204Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'inventory-svc',
+        eventType: 'beans.reserved',
+        detail: 'Allocated 18g Espresso Blend & 240ml Oat Milk',
+        ts: '2026-10-30T14:32:10.045210880Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'edge-gateway',
+        eventType: 'order.received',
+        detail: 'Incoming mobile order payload validated',
+        ts: '2026-10-30T14:32:10.045012300Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'loyalty-svc',
+        eventType: 'rewards.points_credited',
+        detail: 'Added +45 Bean Points to customer account',
+        ts: '2026-10-30T14:32:10.045891999Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'payment-svc',
+        eventType: 'payment.authorized',
+        detail: 'Contactless tap settlement confirmed ($6.50)',
+        ts: '2026-10-30T14:32:10.045210415Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'notification-svc',
+        eventType: 'receipt.dispatched',
+        detail: 'Push notification & digital receipt sent',
+        ts: '2026-10-30T14:32:10.047104050Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        service: 'roastery-telemetry',
+        eventType: 'grinder.dose_triggered',
+        detail: 'Precision burr dose initiated (18.0g)',
+        ts: '2026-10-30T14:32:10.045900012Z'
+      }
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    function parseAndSortEvents(rawEvents) {
+      // 1. Parse recorded timestamps as Temporal.Instant (preserves full nanosecond value,
+      // unlike new Date(ts) which truncates everything below the millisecond).
+      const parsed = rawEvents.map((evt, originalIndex) => ({
+        ...evt,
+        originalIndex: originalIndex + 1,
+        timestamp: Temporal.Instant.from(evt.ts)
+      }));
+
+      // 2. Sort chronologically using Temporal.Instant.compare(a, b)
+      return [...parsed].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    function computeEventTrace(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            intervalDuration: null,
+            isSimultaneous: false,
+            formattedInterval: '0ns (Baseline)'
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+
+        // 3. Calculate exact Temporal.Duration interval between consecutive events
+        const gap = curr.timestamp.since(prev.timestamp);
+
+        // 4. Format the duration for users with toLocaleString() (delegates to Intl.DurationFormat)
+        const formattedInterval = isSimultaneous
+          ? '0ns (Simultaneous)'
+          : `+${gap.toLocaleString('en-US', { style: 'narrow' })}`;
+
+        return {
+          ...curr,
+          intervalDuration: gap,
+          isSimultaneous,
+          formattedInterval
+        };
+      });
+    }
+
+    function renderEventTrace(traceEvents) {
+      const container = document.getElementById('events-container');
+      const firstInstant = traceEvents[0].timestamp;
+      const lastInstant = traceEvents[traceEvents.length - 1].timestamp;
+      const totalSpan = lastInstant.since(firstInstant);
+
+      const rowsHtml = traceEvents
+        .map((evt, idx) => {
+          const intervalCell =
+            idx === 0
+              ? `<span class="delta-baseline">${evt.formattedInterval}</span>`
+              : `<span class="delta-badge mono" data-iso-duration="${evt.intervalDuration.toString()}">${evt.formattedInterval}</span>`;
+
+          return `
+            <tr data-order-id="${evt.orderId}" data-seq="${idx + 1}">
+              <td class="mono">#${idx + 1} <small style="color: #8d6e63;">(batch #${evt.originalIndex})</small></td>
+              <td><span class="service-badge">${evt.service}</span></td>
+              <td class="mono"><strong>${evt.eventType}</strong></td>
+              <td>${evt.detail}</td>
+              <td class="mono"><time datetime="${evt.timestamp.toString()}">${evt.timestamp.toString()}</time></td>
+              <td>${intervalCell}</td>
+            </tr>
+          `;
+        })
+        .join('');
+
+      container.innerHTML = `
+        <div class="table-wrapper">
+          <table class="event-table">
+            <thead>
+              <tr>
+                <th>Seq</th>
+                <th>Backend Service</th>
+                <th>Event</th>
+                <th>Details</th>
+                <th>Nanosecond UTC Timestamp</th>
+                <th>Interval Since Previous</th>
+              </tr>
+            </thead>
+            <tbody>
+              ${rowsHtml}
+            </tbody>
+          </table>
+        </div>
+        <div class="telemetry-summary">
+          <span><strong>Order ID:</strong> <span class="mono">${traceEvents[0].orderId}</span> (${traceEvents.length} distributed events sorted)</span>
+          <span><strong>End-to-End Trace Span:</strong> <span class="mono">${totalSpan.toLocaleString('en-US', { style: 'narrow' })}</span></span>
+        </div>
+      `;
+    }
+
+    const loadBtn = document.getElementById('load-events-btn');
+    loadBtn.addEventListener('click', async () => {
+      loadBtn.disabled = true;
+      loadBtn.textContent = 'Sorting Events...';
+      try {
+        await ensureTemporal();
+        const sorted = parseAndSortEvents(rawOrderEvents);
+        const trace = computeEventTrace(sorted);
+        renderEventTrace(trace);
+        loadBtn.textContent = 'Reload Order Events';
+      } finally {
+        loadBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
