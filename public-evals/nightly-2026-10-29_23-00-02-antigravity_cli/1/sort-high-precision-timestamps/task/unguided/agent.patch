+  <script>
+    // Out-of-order batch of coffee order events collected from distributed backend services
+    // Timestamps are UTC ISO 8601 strings with nanosecond precision (9 fractional digits).
+    // Several events occur within the exact same millisecond (.104s and .105s) to require sub-millisecond precision.
+    const OUT_OF_ORDER_COFFEE_EVENTS = [
+      {
+        eventId: 'evt-904',
+        orderId: 'ORD-2026-8841',
+        item: 'Maple Oat Latte',
+        service: 'barista-queue-us-west',
+        stage: 'BARISTA_TICKET_DISPATCHED',
+        timestamp: '2026-10-30T14:22:05.105412980Z'
+      },
+      {
+        eventId: 'evt-902',
+        orderId: 'ORD-2026-8841',
+        item: 'Maple Oat Latte',
+        service: 'payment-ledger-eu-west',
+        stage: 'PAYMENT_AUTHORIZED',
+        timestamp: '2026-10-30T14:22:05.104215890Z'
+      },
+      {
+        eventId: 'evt-907',
+        orderId: 'ORD-2026-8842',
+        item: 'Cold Brew',
+        service: 'notification-hub-us-east',
+        stage: 'CUSTOMER_RECEIPT_SENT',
+        timestamp: '2026-10-30T14:22:05.118004325Z'
+      },
+      {
+        eventId: 'evt-901',
+        orderId: 'ORD-2026-8841',
+        item: 'Maple Oat Latte',
+        service: 'edge-gateway-us-east',
+        stage: 'ORDER_INGESTED',
+        timestamp: '2026-10-30T14:22:05.104215450Z'
+      },
+      {
+        eventId: 'evt-906',
+        orderId: 'ORD-2026-8842',
+        item: 'Cold Brew',
+        service: 'bean-inventory-ap-south',
+        stage: 'STOCK_DEDUCTED',
+        timestamp: '2026-10-30T14:22:05.105413045Z'
+      },
+      {
+        eventId: 'evt-903',
+        orderId: 'ORD-2026-8841',
+        item: 'Maple Oat Latte',
+        service: 'loyalty-engine-us-central',
+        stage: 'REWARD_POINTS_APPLIED',
+        timestamp: '2026-10-30T14:22:05.104829100Z'
+      },
+      {
+        eventId: 'evt-905',
+        orderId: 'ORD-2026-8842',
+        item: 'Cold Brew',
+        service: 'edge-gateway-us-east',
+        stage: 'ORDER_INGESTED',
+        timestamp: '2026-10-30T14:22:05.105412995Z'
+      }
+    ];
+
+    function formatNanosecondInterval(deltaNsBigInt, durationObj) {
+      const totalNs = deltaNsBigInt;
+      const sec = totalNs / 1000000000n;
+      const remAfterSec = totalNs % 1000000000n;
+      const ms = remAfterSec / 1000000n;
+      const remAfterMs = remAfterSec % 1000000n;
+      const us = remAfterMs / 1000n;
+      const ns = remAfterMs % 1000n;
+
+      const parts = [];
+      if (sec > 0n) parts.push(`${sec} s`);
+      if (ms > 0n) parts.push(`${ms} ms`);
+      if (us > 0n) parts.push(`${us} µs`);
+      if (ns > 0n || parts.length === 0) parts.push(`${ns} ns`);
+
+      const isoStr = durationObj ? durationObj.toString() : `PT${Number(totalNs) / 1e9}S`;
+      return {
+        human: `+${parts.join(' ')}`,
+        exactNs: `${totalNs.toString()} ns`,
+        iso: isoStr
+      };
+    }
+
+    function parseAndSortEvents(rawEvents) {
+      // Parse each event's nanosecond UTC timestamp using Temporal.Instant
+      const parsed = rawEvents.map((event, originalIndex) => {
+        const instant = Temporal.Instant.from(event.timestamp);
+        return {
+          ...event,
+          originalIndex: originalIndex + 1,
+          instant,
+          epochNanoseconds: instant.epochNanoseconds
+        };
+      });
+
+      // Sort chronologically using Temporal.Instant.compare to preserve full nanosecond precision
+      const sorted = [...parsed].sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+      // Measure intervals between consecutive events using Temporal.Instant.prototype.since / until
+      return sorted.map((event, sortedIndex) => {
+        if (sortedIndex === 0) {
+          return {
+            ...event,
+            chronologicalRank: 1,
+            intervalDuration: null,
+            intervalNanoseconds: 0n,
+            intervalFormatted: null
+          };
+        }
+
+        const prevEvent = sorted[sortedIndex - 1];
+        const intervalDuration = event.instant.since(prevEvent.instant, {
+          largestUnit: 'millisecond',
+          smallestUnit: 'nanosecond'
+        });
+        const intervalNanoseconds = event.instant.epochNanoseconds - prevEvent.instant.epochNanoseconds;
+
+        return {
+          ...event,
+          chronologicalRank: sortedIndex + 1,
+          intervalDuration,
+          intervalNanoseconds,
+          intervalFormatted: formatNanosecondInterval(intervalNanoseconds, intervalDuration)
+        };
+      });
+    }
+
+    function renderSortedEvents() {
+      const sortedEvents = parseAndSortEvents(OUT_OF_ORDER_COFFEE_EVENTS);
+      const firstInstant = sortedEvents[0].instant;
+      const lastInstant = sortedEvents[sortedEvents.length - 1].instant;
+      const totalSpanDuration = lastInstant.since(firstInstant, {
+        largestUnit: 'millisecond',
+        smallestUnit: 'nanosecond'
+      });
+      const totalSpanNs = lastInstant.epochNanoseconds - firstInstant.epochNanoseconds;
+      const totalSpanFormatted = formatNanosecondInterval(totalSpanNs, totalSpanDuration);
+
+      const intervalsNs = sortedEvents.slice(1).map((e) => e.intervalNanoseconds);
+      const minIntervalNs = intervalsNs.reduce((min, val) => (val < min ? val : min), intervalsNs[0]);
+      const maxIntervalNs = intervalsNs.reduce((max, val) => (val > max ? val : max), intervalsNs[0]);
+
+      const summaryEl = document.getElementById('events-summary');
+      summaryEl.hidden = false;
+      summaryEl.innerHTML = `
+        <div class="summary-stat">
+          <span class="stat-label">Events Processed</span>
+          <span class="stat-value" id="stat-total-events">${sortedEvents.length} events</span>
+        </div>
+        <div class="summary-stat">
+          <span class="stat-label">Total Batch Window</span>
+          <span class="stat-value" id="stat-total-window">${totalSpanFormatted.human.replace(/^\+/, '')} (${totalSpanFormatted.exactNs})</span>
+        </div>
+        <div class="summary-stat">
+          <span class="stat-label">Shortest Interval</span>
+          <span class="stat-value" id="stat-min-interval">${minIntervalNs.toString()} ns</span>
+        </div>
+        <div class="summary-stat">
+          <span class="stat-label">Longest Interval</span>
+          <span class="stat-value" id="stat-max-interval">${maxIntervalNs.toString()} ns</span>
+        </div>
+      `;
+
+      const outputEl = document.getElementById('events-output');
+      const rowsHtml = sortedEvents.map((evt) => {
+        const intervalCell = evt.intervalFormatted
+          ? `<span class="interval-pill" data-interval-ns="${evt.intervalNanoseconds.toString()}" data-interval-iso="${evt.intervalFormatted.iso}">
+               ${evt.intervalFormatted.human} (${evt.intervalFormatted.exactNs})
+             </span>`
+          : `<span class="mono" data-interval-ns="0">0 ns (Initial Event)</span>`;
+
+        return `
+          <tr data-event-id="${evt.eventId}" data-timestamp="${evt.instant.toString()}" data-epoch-ns="${evt.epochNanoseconds.toString()}">
+            <td class="mono">#${evt.chronologicalRank} <small style="color:#6d4c41;">(was #${evt.originalIndex})</small></td>
+            <td class="mono"><strong>${evt.orderId}</strong><br><small>${evt.item}</small></td>
+            <td><span class="badge">${evt.stage}</span></td>
+            <td class="mono">${evt.service}</td>
+            <td class="mono">${evt.instant.toString()}</td>
+            <td>${intervalCell}</td>
+          </tr>
+        `;
+      }).join('');
+
+      outputEl.innerHTML = `
+        <table class="events-table" aria-label="Sorted Coffee Order Events">
+          <thead>
+            <tr>
+              <th>Order</th>
+              <th>Coffee Order</th>
+              <th>Event Stage</th>
+              <th>Backend Service</th>
+              <th>UTC Timestamp (ns)</th>
+              <th>Interval Since Previous</th>
+            </tr>
+          </thead>
+          <tbody id="sorted-events-tbody">
+            ${rowsHtml}
+          </tbody>
+        </table>
+      `;
+    }
+
+    document.getElementById('load-order-events-btn').addEventListener('click', renderSortedEvents);
+  </script>
 </body>
 
