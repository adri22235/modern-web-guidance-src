diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,38 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Fetch Priority Demo</title>
+</head>
+<body>
+  <main>
+    <h1>Mission-Critical Data Loader</h1>
+    <button type="button" id="load-btn">Load Data</button>
+    <pre id="output" tabindex="0"><code id="output-code"></code></pre>
+  </main>
+
+  <script type="module">
+    const button = document.getElementById('load-btn');
+    const outputCode = document.getElementById('output-code');
+
+    button.addEventListener('click', async () => {
+      // Trigger both requests concurrently; deprioritize background analytics
+      // so it does not compete for bandwidth with the mission-critical fetch.
+      const dataPromise = fetch('/api/data');
+
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low'
+      });
+
+      const response = await dataPromise;
+      if (response.ok) {
+        outputCode.textContent = await response.text();
+      }
+    });
+  </script>
+</body>
+</html>
