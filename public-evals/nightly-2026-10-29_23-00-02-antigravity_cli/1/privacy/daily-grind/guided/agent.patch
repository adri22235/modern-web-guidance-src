+            clientHints = { reducedUA: true, platform: navigator.userAgentData.platform || 'unknown' };
+          }
+        }
+
+        const logEl = document.getElementById('diagnostic-log');
+        if (logEl) {
+          const sampleRawLog =
+            'Audit check for user jane.doe@example.com (555-234-5678) session_id=xyz987secret';
+          const diagnosticSummary = {
+            featuresDetected: capabilities,
+            userAgentClientHints: clientHints,
+            scrubbedLogSample: scrubPII(sampleRawLog),
+            localStorageKeysStored: 0,
+          };
+          logEl.textContent = JSON.stringify(diagnosticSummary, null, 2);
+        }
+      }
+      collectPrivacySafeEnvironmentInfo();
+
+      // 4. Guest Checkout (Data Minimization & Immediate Ephemeral Lifecycle)
+      const guestForm = document.getElementById('guest-checkout-form');
+      const guestStatus = document.getElementById('guest-order-status');
+
+      document.querySelectorAll('[data-drink]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const select = document.getElementById('guest-drink');
+          if (select) {
+            select.value = btn.getAttribute('data-drink');
+          }
+        });
+      });
+
+      if (guestForm && guestStatus) {
+        guestForm.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const aliasInput = document.getElementById('guest-alias');
+          const drinkInput = document.getElementById('guest-drink');
+          const phoneInput = document.getElementById('phone');
+
+          const alias = aliasInput ? aliasInput.value.trim() : 'Guest';
+          const drink = drinkInput ? drinkInput.value : 'Coffee';
+          const hasPhone = Boolean(phoneInput && phoneInput.value.trim());
+
+          ephemeralState.guestOrder = {
+            alias,
+            drink,
+            smsNotificationOptIn: hasPhone,
+            createdAt: new Date().toISOString(),
+          };
+
+          guestStatus.textContent = scrubPII(
+            `Order placed for "${alias}" (${drink}). Phone ${phoneInput?.value || 'not provided'} was scrubbed from logs and will be purged upon pickup.`
+          );
+          guestStatus.classList.add('active');
+          guestForm.reset();
+        });
+      }
+
+      // 5. Rewards Preferences with Fuzzing & Age Bracket Minimization
+      const rewardsForm = document.getElementById('rewards-form');
+      const rewardsStatus = document.getElementById('rewards-status');
+      if (rewardsForm && rewardsStatus) {
+        rewardsForm.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const bracket = document.getElementById('age-bracket')?.value || '18-34';
+          const roast = document.getElementById('roast-pref')?.value || 'medium';
+          ephemeralState.preferences = { ageBracket: bracket, roastProfile: roast };
+
+          const noisyAggregateCount = addDifferentialPrivacyNoise(42, 1.0);
+          rewardsStatus.textContent = `Saved minimal preferences (Age bracket: ${bracket}, Roast: ${roast}). Differential privacy aggregate counter: ~${noisyAggregateCount} fans.`;
+          rewardsStatus.classList.add('active');
+        });
+      }
+
+      // 6. Store Locator with PEPC (<permission>) & Geolocation Fallback
+      const locationResult = document.getElementById('location-result');
+      const geoPermissionEl = document.getElementById('geo-permission');
+      const useLocationBtn = document.getElementById('use-location-btn');
+
+      function updateMap() {
+        if (!('geolocation' in navigator)) {
+          if (locationResult) {
+            locationResult.textContent = 'Geolocation is not supported by your browser. Showing Downtown Roastery.';
+          }
+          return;
+        }
+        navigator.geolocation.getCurrentPosition(
+          (pos) => {
+            // Coarse rounding (~1km) for data minimization
+            const coarseLat = Number(pos.coords.latitude).toFixed(2);
+            const coarseLng = Number(pos.coords.longitude).toFixed(2);
+            if (locationResult) {
+              locationResult.textContent = `Closest Roastery to coarse area (${coarseLat}, ${coarseLng}): Downtown Roastery (0.8 mi away). Coordinates discarded.`;
+            }
+          },
+          () => {
+            if (locationResult) {
+              locationResult.textContent = 'Location access declined or unavailable. Showing Downtown Roastery (120 Artisan Way).';
+            }
+          },
+          { maximumAge: 60000, timeout: 5000, enableHighAccuracy: false }
+        );
+      }
+
+      if (geoPermissionEl) {
+        geoPermissionEl.addEventListener('promptdismiss', updateMap);
+      }
+      if (useLocationBtn) {
+        useLocationBtn.addEventListener('click', updateMap);
+      }
+
+      // 7. Third-Party Video Façade Pattern (youtube-nocookie.com via safe DOM creation)
+      const playBtn = document.getElementById('play-btn');
+      if (playBtn) {
+        playBtn.addEventListener('click', () => {
+          const container = document.getElementById('video-container');
+          if (!container) return;
+          const videoId = container.dataset.videoId || 'abc123';
+          // Validate videoId format before constructing embed URL
+          if (!/^[a-zA-Z0-9_-]+$/.test(videoId)) return;
+
+          const iframe = document.createElement('iframe');
+          iframe.src = `https://www.youtube-nocookie.com/embed/${ encodeURIComponent(videoId) }?autoplay=1`;
+          iframe.title = 'The Daily Grind Roastery Tour';
+          iframe.allowFullscreen = true;
+          iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
+          iframe.setAttribute(
+            'allow',
+            "fullscreen; focus-without-user-activation 'none'"
+          );
+
+          container.replaceChildren(iframe);
+        });
+      }
+
+      // 8. Federated Credential Management API (FedCM) Sign-In Mediation
+      const fedcmBtn = document.getElementById('fedcm-signin-btn');
+      const accountView = document.getElementById('account-data-view');
+
+      async function signInWithFedCM() {
+        if (!('credentials' in navigator) || typeof navigator.credentials.get !== 'function') {
+          if (accountView) {
+            accountView.textContent = 'FedCM is not available in this browser environment. Continue with Guest Checkout.';
+            accountView.classList.add('active');
+          }
+          return;
+        }
+        try {
+          const nonceBytes = new Uint8Array(16);
+          window.crypto.getRandomValues(nonceBytes);
+          const nonce = Array.from(nonceBytes, (b) => b.toString(16).padStart(2, '0')).join('');
+
+          const credential = await navigator.credentials.get({
+            identity: {
+              providers: [
+                {
+                  configURL: 'https://idp.dailygrind.example/fedcm.json',
+                  clientId: 'daily-grind-rp-client',
+                  nonce,
+                },
+              ],
+            },
+          });
+
+          if (credential && accountView) {
+            accountView.textContent = 'Authenticated via browser-mediated FedCM without cross-site IdP tracking.';
+            accountView.classList.add('active');
+          }
+        } catch {
+          if (accountView) {
+            accountView.textContent = 'FedCM sign-in prompt dismissed or unavailable; no data shared with identity provider.';
+            accountView.classList.add('active');
+          }
+        }
+      }
+
+      if (fedcmBtn) {
+        fedcmBtn.addEventListener('click', signInWithFedCM);
+      }
+
+      // 9. Data Rights: Access, Correction, and Deletion + Clear-Site-Data Logout
+      const accessBtn = document.getElementById('access-data-btn');
+      const correctBtn = document.getElementById('correct-data-btn');
+      const deleteBtn = document.getElementById('delete-data-btn');
+      const logoutLink = document.getElementById('logout-link');
+
+      if (accessBtn && accountView) {
+        accessBtn.addEventListener('click', () => {
+          accountView.textContent = `Stored Ephemeral Data: ${JSON.stringify(ephemeralState)}`;
+          accountView.classList.add('active');
+        });
+      }
+
+      if (correctBtn && accountView) {
+        correctBtn.addEventListener('click', () => {
+          const bracketSelect = document.getElementById('age-bracket');
+          const roastSelect = document.getElementById('roast-pref');
+          if (bracketSelect && roastSelect) {
+            ephemeralState.preferences.ageBracket = bracketSelect.value;
+            ephemeralState.preferences.roastProfile = roastSelect.value;
+          }
+          accountView.textContent = `Updated preferences to Age Bracket: ${ephemeralState.preferences.ageBracket}, Roast: ${ephemeralState.preferences.roastProfile}.`;
+          accountView.classList.add('active');
+        });
+      }
+
+      async function clearSessionAndData(reasonMessage) {
+        ephemeralState.guestOrder = null;
+        ephemeralState.preferences = null;
+        ephemeralState.accountActive = false;
+        purgeBrowserStorage();
+
+        // Trigger subresource request to /logout so the server sends Clear-Site-Data: "*"
+        // without blocking main document UI rendering on slow devices.
+        try {
+          await fetch('/logout', {
+            method: 'POST',
+            credentials: 'same-origin',
+            referrerPolicy: 'no-referrer',
+          });
+        } catch {
+          // Fallback if offline or static preview
+        }
+
+        if (accountView) {
+          accountView.textContent = reasonMessage;
+          accountView.classList.add('active');
+        }
+      }
+
+      if (deleteBtn) {
+        deleteBtn.addEventListener('click', () => {
+          clearSessionAndData('All personal data and session state have been permanently erased.');
+        });
+      }
+
+      if (logoutLink) {
+        logoutLink.addEventListener('click', (event) => {
+          event.preventDefault();
+          clearSessionAndData('Logged out safely. Clear-Site-Data triggered to purge cookies, storage, and cache.');
+        });
+      }
+    })();
+  </script>
