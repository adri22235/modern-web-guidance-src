+      // Sensitive query parameters that must never persist in URL history or referrer logs
+      var SENSITIVE_PARAMS = ['token', 'session', 'session_id', 'auth', 'email', 'phone', 'name', 'user', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'fbclid', 'gclid', 'msclkid'];
+
+      // --- 1. URL Sanitization & History Scrubbing (Data Minimization) ---
+      function scrubSensitiveUrlParameters() {
+        try {
+          var url = new URL(window.location.href);
+          var modified = false;
+          SENSITIVE_PARAMS.forEach(function (param) {
+            if (url.searchParams.has(param)) {
+              url.searchParams.delete(param);
+              modified = true;
+            }
+          });
+          if (modified && window.history && window.history.replaceState) {
+            window.history.replaceState(null, document.title, url.pathname + url.search + url.hash);
+          }
+        } catch (e) {
+          // Fail closed without exposing stack traces
+        }
+      }
+
+      // --- 2. Detect Global Privacy Control (GPC) & Do Not Track (DNT) ---
+      function getPrivacySignals() {
+        var gpc = Boolean(navigator.globalPrivacyControl);
+        var dnt = navigator.doNotTrack === '1' || window.doNotTrack === '1' || navigator.msDoNotTrack === '1';
+        return {
+          gpc: gpc,
+          dnt: dnt,
+          restricted: gpc || dnt
+        };
+      }
+
+      // --- 3. Secure Ephemeral Storage Wrapper with TTL & PII Redaction ---
+      function purgeUnexpectedStorage() {
+        try {
+          // Clear any non-whitelisted localStorage keys completely (we strictly avoid persistent localStorage)
+          if (window.localStorage) {
+            window.localStorage.clear();
+          }
+          // Remove any non-whitelisted sessionStorage keys
+          if (window.sessionStorage) {
+            for (var i = window.sessionStorage.length - 1; i >= 0; i--) {
+              var k = window.sessionStorage.key(i);
+              if (k !== STORAGE_KEY) {
+                window.sessionStorage.removeItem(k);
+              }
+            }
+          }
+          // Expire any accessible non-HttpOnly cookies
+          if (document.cookie) {
+            document.cookie.split(';').forEach(function (c) {
+              var eqPos = c.indexOf('=');
+              var name = eqPos > -1 ? c.substr(0, eqPos).trim() : c.trim();
+              if (name) {
+                document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Strict';
+              }
+            });
+          }
+        } catch (e) {
+          // Ignore storage access errors in sandboxed contexts
+        }
+      }
+
+      function readEphemeralState() {
+        try {
+          var raw = window.sessionStorage.getItem(STORAGE_KEY);
+          if (!raw) return null;
+          var parsed = JSON.parse(raw);
+          if (!parsed || typeof parsed.expiresAt !== 'number' || Date.now() > parsed.expiresAt) {
+            window.sessionStorage.removeItem(STORAGE_KEY);
+            return null;
+          }
+          return parsed;
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function writeEphemeralState(data) {
+        try {
+          var payload = {
+            schema: 'daily-grind-privacy-v1',
+            updatedAt: new Date().toISOString(),
+            expiresAt: Date.now() + TTL_MS,
+            consent: {
+              externalMedia: Boolean(data.externalMedia),
+              ephemeralPrefs: Boolean(data.ephemeralPrefs),
+              newsletterOptIn: Boolean(data.newsletterOptIn)
+            },
+            minimizedOrder: data.minimizedOrder || null
+          };
+          window.sessionStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
+          updateStorageInspector();
+          return payload;
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function eraseAllClientData(reason) {
+        try {
+          if (window.sessionStorage) window.sessionStorage.clear();
+          if (window.localStorage) window.localStorage.clear();
+          purgeUnexpectedStorage();
+        } catch (e) {}
+
+        // Reset UI controls to strict privacy defaults
+        var mediaToggle = document.getElementById('toggle-external-media');
+        var prefsToggle = document.getElementById('toggle-ephemeral-prefs');
+        var consentNewsletter = document.getElementById('consent-newsletter');
+        var orderForm = document.getElementById('minimized-order-form');
+
+        if (mediaToggle) mediaToggle.checked = false;
+        if (prefsToggle) prefsToggle.checked = false;
+        if (consentNewsletter) consentNewsletter.checked = false;
+        if (orderForm) orderForm.reset();
+
+        applyExternalMediaPolicy(false);
+        updateStorageInspector();
+        runThirdPartyAndSecurityAudit();
+
+        if (reason) {
+          showFeedback(reason);
+        }
+      }
+
+      // --- 4. Cryptographic Hashing (SHA-256) for Email Minimization ---
+      async function sha256Hex(input) {
+        if (!window.crypto || !window.crypto.subtle || !window.TextEncoder) {
+          return '[redacted-digest]';
+        }
+        var encoded = new TextEncoder().encode(input.trim().toLowerCase());
+        var buffer = await window.crypto.subtle.digest('SHA-256', encoded);
+        var bytes = Array.from(new Uint8Array(buffer));
+        return bytes.map(function (b) { return b.toString(16).padStart(2, '0'); }).join('').slice(0, 16) + '...';
+      }
+
+      // --- 5. External Media Consent Gate (Unsplash Stock Photo Shield) ---
+      function applyExternalMediaPolicy(allowExternal) {
+        var hero = document.getElementById('hero-banner');
+        var heroStatus = document.getElementById('hero-media-status');
+        var auditMedia = document.getElementById('audit-media');
+
+        if (!hero) return;
+
+        if (allowExternal) {
+          hero.classList.add('external-media-enabled');
+          if (heroStatus) {
+            heroStatus.textContent = 'External Media Consented: Unsplash stock photo loaded via HTTPS with strict-origin-when-cross-origin referrer policy.';
+          }
+          if (auditMedia) {
+            auditMedia.textContent = 'Consented (HTTPS images.unsplash.com only)';
+          }
+        } else {
+          hero.classList.remove('external-media-enabled');
+          if (heroStatus) {
+            heroStatus.textContent = 'Third-Party Media Shield Active: External Unsplash imagery is blocked by default to prevent IP & referrer leakage.';
+          }
+          if (auditMedia) {
+            auditMedia.textContent = 'Blocked (Zero leakage)';
+          }
+        }
+      }
+
+      // --- 6. Outbound Link & Form Hardening ---
+      function hardenLinksAndForms() {
+        var links = document.querySelectorAll('a[href]');
+        links.forEach(function (link) {
+          var href = link.getAttribute('href') || '';
+          if (/^https?:\/\//i.test(href) && href.indexOf(window.location.origin) !== 0) {
+            link.setAttribute('rel', 'noopener noreferrer external');
+            link.setAttribute('referrerpolicy', 'no-referrer');
+          }
+        });
+      }
+
+      // --- 7. Third-Party & Security Header Live Audit ---
+      function runThirdPartyAndSecurityAudit() {
+        // Audit scripts
+        var scripts = Array.from(document.querySelectorAll('script[src]'));
+        var externalScripts = scripts.filter(function (s) {
+          return s.src && s.src.indexOf(window.location.origin) !== 0;
+        });
+
+        var auditScriptsEl = document.getElementById('audit-scripts');
+        var auditSummaryPill = document.getElementById('audit-summary-pill');
+
+        if (auditScriptsEl) {
+          auditScriptsEl.textContent = externalScripts.length === 0
+            ? '0 External Scripts (Passed)'
+            : externalScripts.length + ' Unapproved Script(s) Detected';
+        }
+
+        // Audit GPC / DNT signals
+        var signals = getPrivacySignals();
+        var auditSignalsEl = document.getElementById('audit-signals');
+        var gpcBadge = document.getElementById('gpc-status-badge');
+
+        if (auditSignalsEl) {
+          if (signals.restricted) {
+            auditSignalsEl.textContent = 'Active (GPC: ' + (signals.gpc ? 'On' : 'Off') + ', DNT: ' + (signals.dnt ? 'On' : 'Off') + ') — Strict Opt-Out Enforced';
+          } else {
+            auditSignalsEl.textContent = 'No signal detected — Privacy-by-Default still enforced';
+          }
+        }
+        if (gpcBadge && signals.restricted) {
+          gpcBadge.textContent = 'GPC / DNT Honored';
+        }
+
+        // Audit Resource Performance API for any third-party network transfers
+        var thirdPartyTransfers = [];
+        if (window.performance && typeof window.performance.getEntriesByType === 'function') {
+          var resources = window.performance.getEntriesByType('resource') || [];
+          resources.forEach(function (entry) {
+            try {
+              var resUrl = new URL(entry.name, window.location.origin);
+              if (resUrl.origin !== window.location.origin) {
+                thirdPartyTransfers.push(resUrl.origin);
+              }
+            } catch (e) {}
+          });
+        }
+
+        var mediaToggle = document.getElementById('toggle-external-media');
+        var mediaConsented = Boolean(mediaToggle && mediaToggle.checked);
+        var unapprovedTransfers = thirdPartyTransfers.filter(function (origin) {
+          if (mediaConsented && origin === CONSENTED_MEDIA_ORIGIN) return false;
+          return ALLOWED_ORIGINS.indexOf(origin) === -1;
+        });
+
+        if (auditSummaryPill) {
+          auditSummaryPill.textContent = unapprovedTransfers.length === 0
+            ? '0 Unapproved Requests'
+            : unapprovedTransfers.length + ' External Request(s)';
+        }
+      }
+
+      // --- 8. Update Live Storage Inspector ---
+      function updateStorageInspector() {
+        var inspector = document.getElementById('storage-inspector');
+        if (!inspector) return;
+        var state = readEphemeralState();
+        if (!state) {
+          inspector.textContent = JSON.stringify({
+            storageEngine: 'sessionStorage (ephemeral)',
+            cookiesCount: document.cookie ? document.cookie.split(';').length : 0,
+            localStorageKeys: window.localStorage ? window.localStorage.length : 0,
+            storedData: null
+          }, null, 2);
+          return;
+        }
+        var remainingSec = Math.max(0, Math.round((state.expiresAt - Date.now()) / 1000));
+        inspector.textContent = JSON.stringify({
+          ttlRemainingSeconds: remainingSec,
+          consent: state.consent,
+          minimizedOrder: state.minimizedOrder
+        }, null, 2);
+      }
+
+      function showFeedback(message) {
+        var el = document.getElementById('order-feedback');
+        if (!el) return;
+        el.textContent = message;
+        el.classList.add('active');
+      }
+
+      // --- 9. Event Listeners & Initialization ---
+      function init() {
+        scrubSensitiveUrlParameters();
+        purgeUnexpectedStorage();
+        hardenLinksAndForms();
+
+        var mediaToggle = document.getElementById('toggle-external-media');
+        var prefsToggle = document.getElementById('toggle-ephemeral-prefs');
+        var consentNewsletter = document.getElementById('consent-newsletter');
+        var orderForm = document.getElementById('minimized-order-form');
+        var beverageSelect = document.getElementById('beverage-choice');
+        var btnErase = document.getElementById('btn-erase-data');
+        var btnExport = document.getElementById('btn-export-data');
+        var logoutForm = document.getElementById('logout-form');
+
+        // Restore ephemeral state if still within 15-min TTL
+        var existing = readEphemeralState();
+        if (existing && existing.consent) {
+          if (mediaToggle) mediaToggle.checked = Boolean(existing.consent.externalMedia);
+          if (prefsToggle) prefsToggle.checked = Boolean(existing.consent.ephemeralPrefs);
+          if (consentNewsletter) consentNewsletter.checked = Boolean(existing.consent.newsletterOptIn);
+          if (existing.minimizedOrder && existing.minimizedOrder.beverage && beverageSelect) {
+            beverageSelect.value = existing.minimizedOrder.beverage;
+          }
+          applyExternalMediaPolicy(Boolean(existing.consent.externalMedia));
+        } else {
+          applyExternalMediaPolicy(false);
+        }
+
+        // Card quick-select buttons
+        document.querySelectorAll('.card .btn[data-item]').forEach(function (btn) {
+          btn.addEventListener('click', function (ev) {
+            ev.preventDefault();
+            var item = btn.getAttribute('data-item');
+            if (beverageSelect && item) {
+              beverageSelect.value = item;
+            }
+            var orderSection = document.getElementById('quick-order');
+            if (orderSection && orderSection.scrollIntoView) {
+              orderSection.scrollIntoView({ behavior: 'smooth' });
+            }
+          });
+        });
+
+        // External media opt-in toggle
+        if (mediaToggle) {
+          mediaToggle.addEventListener('change', function () {
+            var allowed = Boolean(mediaToggle.checked);
+            applyExternalMediaPolicy(allowed);
+            var current = readEphemeralState() || {};
+            writeEphemeralState({
+              externalMedia: allowed,
+              ephemeralPrefs: Boolean(prefsToggle && prefsToggle.checked),
+              newsletterOptIn: Boolean(consentNewsletter && consentNewsletter.checked),
+              minimizedOrder: current.minimizedOrder || null
+            });
+            runThirdPartyAndSecurityAudit();
+          });
+        }
+
+        // Ephemeral preference toggle
+        if (prefsToggle) {
+          prefsToggle.addEventListener('change', function () {
+            if (!prefsToggle.checked) {
+              window.sessionStorage.removeItem(STORAGE_KEY);
+              updateStorageInspector();
+              showFeedback('Ephemeral session storage disabled and cleared.');
+            } else {
+              writeEphemeralState({
+                externalMedia: Boolean(mediaToggle && mediaToggle.checked),
+                ephemeralPrefs: true,
+                newsletterOptIn: Boolean(consentNewsletter && consentNewsletter.checked),
+                minimizedOrder: {
+                  beverage: beverageSelect ? beverageSelect.value : 'Maple Oat Latte'
+                }
+              });
+              showFeedback('Session preference enabled (auto-expires in 15 minutes).');
+            }
+          });
+        }
+
+        // Data-minimized form submission handler
+        if (orderForm) {
+          orderForm.addEventListener('submit', async function (ev) {
+            ev.preventDefault();
+            var aliasInput = document.getElementById('pickup-alias');
+            var emailInput = document.getElementById('optional-email');
+            var alias = aliasInput ? aliasInput.value.trim().replace(/[^\w\s#-]/g, '').slice(0, 24) : '';
+
+            if (!alias) {
+              showFeedback('Please provide a short pickup alias or first name (max 24 characters).');
+              if (aliasInput) aliasInput.focus();
+              return;
+            }
+
+            var newsletterOptIn = Boolean(consentNewsletter && consentNewsletter.checked);
+            var rawEmail = emailInput ? emailInput.value.trim() : '';
+            var emailDigest = null;
+
+            // Data minimization: Only process email if user explicitly checked opt-in consent, and only store a one-way SHA-256 truncated hash locally
+            if (newsletterOptIn && rawEmail) {
+              emailDigest = await sha256Hex(rawEmail);
+            }
+
+            // Clear raw email input immediately from DOM after processing to prevent shoulder-surfing or DOM scraping
+            if (emailInput) {
+              emailInput.value = '';
+            }
+
+            var minimizedRecord = {
+              pickupAlias: alias,
+              beverage: beverageSelect ? beverageSelect.value : 'Maple Oat Latte',
+              emailSha256Prefix: emailDigest,
+              createdAt: new Date().toISOString()
+            };
+
+            writeEphemeralState({
+              externalMedia: Boolean(mediaToggle && mediaToggle.checked),
+              ephemeralPrefs: true,
+              newsletterOptIn: newsletterOptIn,
+              minimizedOrder: minimizedRecord
+            });
+
+            if (prefsToggle) prefsToggle.checked = true;
+            showFeedback('Order staged for "' + alias + '" with strict data minimization. Raw email discarded; session record expires in 15m.');
+          });
+        }
+
+        // Data Portability (Export JSON)
+        if (btnExport) {
+          btnExport.addEventListener('click', function () {
+            var state = readEphemeralState() || { message: 'No personal data stored in session.' };
+            var blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
+            var url = URL.createObjectURL(blob);
+            var a = document.createElement('a');
+            a.href = url;
+            a.download = 'daily-grind-privacy-export.json';
+            document.body.appendChild(a);
+            a.click();
+            document.body.removeChild(a);
+            URL.revokeObjectURL(url);
+            showFeedback('Exported current ephemeral session data as JSON.');
+          });
+        }
+
+        // Right to Erasure (Delete All Local Data)
+        if (btnErase) {
+          btnErase.addEventListener('click', function () {
+            eraseAllClientData('All client-side storage, cookies, and consent tokens have been permanently erased.');
+          });
+        }
+
+        // Secure Logout Handler
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', function (ev) {
+            ev.preventDefault();
+            eraseAllClientData('Logged out securely. All session storage and cached tokens have been wiped.');
+          });
+        }
+
+        updateStorageInspector();
+        runThirdPartyAndSecurityAudit();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
