   }
-  return next();
+
+  const response = await next();
+
+  // Privacy-preserving and defensive HTTP headers
+  response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+  response.headers.set(
+    'Permissions-Policy',
+    'geolocation=(), camera=(), microphone=(), accelerometer=(), payment=(), usb=(), focus-without-user-activation=()'
+  );
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('X-Frame-Options', 'SAMEORIGIN');
+  response.headers.set('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+
+  // If a user triggers a signout/logout flow, ensure all browser site data is cleared
+  if (
+    context.url.pathname.endsWith('/signout') ||
+    context.url.pathname.endsWith('/logout') ||
+    context.url.searchParams.get('logout') === 'true'
+  ) {
+    response.headers.set('Clear-Site-Data', '"*"');
+  }
+
+  return response;
