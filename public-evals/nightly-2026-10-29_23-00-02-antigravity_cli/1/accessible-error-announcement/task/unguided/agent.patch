+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMessage = document.getElementById('newsletter-error');
+
+      if (!form || !emailInput || !errorMessage) return;
+
+      const ERROR_TEXT = 'Please enter a valid email address.';
+      let isPostInteraction = false;
+
+      function matchesUserInvalid() {
+        try {
+          return emailInput.matches(':user-invalid');
+        } catch {
+          return false;
+        }
+      }
+
+      function syncErrorState() {
+        const isValid = emailInput.validity.valid;
+        if (isValid) {
+          isPostInteraction = false;
+        }
+
+        const shouldShowError = !isValid && (isPostInteraction || matchesUserInvalid());
+
+        if (shouldShowError) {
+          emailInput.classList.add('is-invalid');
+          emailInput.setAttribute('aria-invalid', 'true');
+          if (errorMessage.textContent !== ERROR_TEXT) {
+            errorMessage.textContent = ERROR_TEXT;
+          }
+          errorMessage.hidden = false;
+        } else {
+          emailInput.classList.remove('is-invalid');
+          emailInput.setAttribute('aria-invalid', 'false');
+          errorMessage.textContent = '';
+          errorMessage.hidden = true;
+        }
+      }
+
+      emailInput.addEventListener('input', () => {
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('blur', () => {
+        if (!emailInput.validity.valid) {
+          isPostInteraction = true;
+        }
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('change', () => {
+        if (!emailInput.validity.valid) {
+          isPostInteraction = true;
+        }
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('invalid', (event) => {
+        event.preventDefault();
+        isPostInteraction = true;
+        syncErrorState();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!emailInput.validity.valid) {
+          isPostInteraction = true;
+          if (typeof emailInput.reportValidity === 'function') {
+            emailInput.reportValidity();
+          }
+          syncErrorState();
+          emailInput.focus();
+        } else {
+          isPostInteraction = false;
+          syncErrorState();
+        }
+      });
+
+      form.addEventListener('reset', () => {
+        isPostInteraction = false;
+        setTimeout(syncErrorState, 0);
+      });
+
+      syncErrorState();
+    })();
+  </script>
 </body>
 
 </html>
