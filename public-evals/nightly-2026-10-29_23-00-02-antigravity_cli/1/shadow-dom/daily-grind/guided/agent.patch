+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        display: block;
+        --_card-bg: var(--card-bg, white);
+        --_primary: var(--primary, #4e342e);
+        --_primary-hover: var(--primary-hover, #3e2723);
+        --_accent: var(--accent, #ffab40);
+        --_text: var(--text, #3e2723);
+      }
+
+      *,
+      *::before,
+      *::after {
+        box-sizing: border-box;
+      }
+
+      .card {
+        position: relative;
+        background: var(--_card-bg);
+        color: var(--_text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        height: 100%;
+      }
+
+      .badge-wrapper {
+        margin-bottom: 8px;
+      }
+
+      .badge-wrapper[hidden] {
+        display: none;
+      }
+
+      .badge,
+      ::slotted([slot="badge"]) {
+        display: inline-block;
+        background: var(--_accent);
+        color: var(--_text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 2px 10px;
+        border-radius: 999px;
+      }
+
+      .title,
+      ::slotted([slot="title"]),
+      ::slotted(h3) {
+        margin: 0 0 10px;
+        color: var(--_primary);
+        font-size: 1.17rem;
+        font-weight: 700;
+      }
+
+      .body {
+        flex: 1;
+      }
+
+      .description-text,
+      ::slotted([slot="description"]),
+      ::slotted(p) {
+        margin: 0;
+        color: var(--_text);
+      }
+
+      .action-link,
+      ::slotted([slot="action"]),
+      ::slotted(a) {
+        display: inline-block;
+        background: var(--_primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .action-link:hover,
+      ::slotted([slot="action"]:hover),
+      ::slotted(a:hover) {
+        background: var(--_primary-hover);
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card">
+        <div class="badge-wrapper" part="badge-wrapper" hidden>
+          <slot name="badge"><span class="badge" part="badge">Limited</span></slot>
+        </div>
+        <slot name="title"><h3 class="title" part="title"></h3></slot>
+        <div class="body" part="body">
+          <slot name="description"><slot><p class="description-text" part="description"></p></slot></slot>
+        </div>
+        <div class="footer" part="footer">
+          <slot name="action"><a class="action-link" part="action" href="#">View Details</a></slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = [
+        'limited',
+        'badge',
+        'heading',
+        'description',
+        'href',
+        'action-label',
+      ];
+
+      #internals;
+      #badgeWrapper;
+      #badgeSlot;
+      #fallbackBadge;
+      #fallbackTitle;
+      #fallbackDescription;
+      #fallbackAction;
+      #hadSlottedBadge = false;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals?.() ?? null;
+        if (!this.shadowRoot) {
+          this.attachShadow({ mode: 'open' });
+          this.shadowRoot.adoptedStyleSheets = [sheet];
+          this.shadowRoot.append(template.content.cloneNode(true));
+        }
+
+        this.#badgeWrapper = this.shadowRoot.querySelector('.badge-wrapper');
+        this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        this.#fallbackBadge = this.shadowRoot.querySelector('.badge');
+        this.#fallbackTitle = this.shadowRoot.querySelector('.title');
+        this.#fallbackDescription = this.shadowRoot.querySelector('.description-text');
+        this.#fallbackAction = this.shadowRoot.querySelector('.action-link');
+
+        this.#badgeSlot.addEventListener('slotchange', () => {
+          const hasSlotted = this.#hasAssignedBadgeNodes();
+          if (this.#hadSlottedBadge && !hasSlotted && this.hasAttribute('limited')) {
+            this.#hadSlottedBadge = false;
+            this.removeAttribute('limited');
+            return;
+          }
+          this.#hadSlottedBadge = hasSlotted;
+          this.#syncBadgeState(hasSlotted || this.limited || this.hasAttribute('badge'));
+        });
+      }
+
+      connectedCallback() {
+        this.#hadSlottedBadge = this.#hasAssignedBadgeNodes();
+        this.#syncContent();
+        this.#syncBadgeState(
+          this.#hadSlottedBadge || this.limited || this.hasAttribute('badge')
+        );
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'limited' || name === 'badge') {
+          if (newVal === null && !this.limited && !this.hasAttribute('badge')) {
+            this.#syncBadgeState(false);
+          } else {
+            this.#syncBadgeState(
+              this.limited || this.hasAttribute('badge') || this.#hasAssignedBadgeNodes()
+            );
+          }
+        }
+        this.#syncContent();
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(on) {
+        this.toggleAttribute('limited', Boolean(on));
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(val) {
+        val ? this.setAttribute('badge', val) : this.removeAttribute('badge');
+      }
+
+      get heading() {
+        return this.getAttribute('heading') ?? '';
+      }
+
+      set heading(val) {
+        val ? this.setAttribute('heading', val) : this.removeAttribute('heading');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(val) {
+        val ? this.setAttribute('description', val) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+
+      set href(val) {
+        val ? this.setAttribute('href', val) : this.removeAttribute('href');
+      }
+
+      get actionLabel() {
+        return this.getAttribute('action-label') ?? 'View Details';
+      }
+
+      set actionLabel(val) {
+        val ? this.setAttribute('action-label', val) : this.removeAttribute('action-label');
+      }
+
+      #hasAssignedBadgeNodes() {
+        return this.#badgeSlot
+          .assignedNodes({ flatten: false })
+          .some(
+            (node) =>
+              node.nodeType === Node.ELEMENT_NODE ||
+              (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+          );
+      }
+
+      #syncBadgeState(visible) {
+        if (this.#badgeWrapper) {
+          this.#badgeWrapper.hidden = !visible;
+        }
+        if (this.#fallbackBadge) {
+          this.#fallbackBadge.textContent = this.badge || 'Limited';
+        }
+        if (this.#internals?.states) {
+          if (visible) {
+            this.#internals.states.add('limited');
+            this.#internals.states.add('has-badge');
+          } else {
+            this.#internals.states.delete('limited');
+            this.#internals.states.delete('has-badge');
+          }
+        }
+      }
+
+      #syncContent() {
+        if (this.#fallbackTitle) {
+          this.#fallbackTitle.textContent = this.heading;
+        }
+        if (this.#fallbackDescription) {
+          this.#fallbackDescription.textContent = this.description;
+        }
+        if (this.#fallbackAction) {
+          this.#fallbackAction.href = this.href || '#';
+          this.#fallbackAction.textContent = this.actionLabel;
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
