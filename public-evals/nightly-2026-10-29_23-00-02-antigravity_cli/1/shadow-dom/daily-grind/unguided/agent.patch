+  <template id="drink-card-template">
+    <style>
+      :host {
+        display: block;
+      }
+
+      * {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      .card {
+        position: relative;
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        align-items: center;
+      }
+
+      .badge,
+      ::slotted([slot="badge"]) {
+        display: inline-block;
+        background: var(--accent, #ffab40);
+        color: var(--text, #3e2723);
+        font-size: 0.75rem;
+        font-weight: bold;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 3px 10px;
+        border-radius: 999px;
+        margin-bottom: 8px;
+      }
+
+      h3 {
+        margin-bottom: 10px;
+        color: var(--primary, #4e342e);
+      }
+
+      p {
+        color: var(--text, #3e2723);
+        flex-grow: 1;
+      }
+
+      .btn,
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover,
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    </style>
+    <div class="card" part="card">
+      <slot name="badge"></slot>
+      <h3 part="title"><slot name="title"></slot></h3>
+      <p part="description"><slot name="description"></slot></p>
+      <slot name="action"><a class="btn" part="action"></a></slot>
+    </div>
+  </template>
+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return [
+          'title',
+          'name',
+          'description',
+          'href',
+          'link',
+          'action-link',
+          'action-href',
+          'url',
+          'link-text',
+          'action-text',
+          'limited',
+          'badge'
+        ];
+      }
+
+      constructor() {
+        super();
+        this._syncing = false;
+        const shadow = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        if (template) {
+          shadow.appendChild(template.content.cloneNode(true));
+        }
+      }
+
+      connectedCallback() {
+        this._syncBadgeAttributes();
+        this._render();
+      }
+
+      _syncBadgeAttributes() {
+        if (!this.isConnected || this._syncing) return;
+        this._syncing = true;
+        if (this.hasAttribute('limited') && this.getAttribute('limited') !== 'false' && !this.hasAttribute('badge')) {
+          const val = this.getAttribute('limited');
+          this.setAttribute('badge', val && val !== 'true' ? val : 'Limited');
+        } else if (this.hasAttribute('badge') && this.getAttribute('badge') !== 'false' && !this.hasAttribute('limited')) {
+          this.setAttribute('limited', '');
+        }
+        this._syncing = false;
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || this._syncing) return;
+
+        if (name === 'limited') {
+          this._syncing = true;
+          if (newValue === null || newValue === 'false') {
+            this.removeAttribute('badge');
+          } else if (this.isConnected && !this.hasAttribute('badge')) {
+            this.setAttribute('badge', newValue && newValue !== 'true' ? newValue : 'Limited');
+          }
+          this._syncing = false;
+        } else if (name === 'badge') {
+          this._syncing = true;
+          if (newValue === null || newValue === 'false') {
+            this.removeAttribute('limited');
+          } else if (this.isConnected && !this.hasAttribute('limited')) {
+            this.setAttribute('limited', '');
+          }
+          this._syncing = false;
+        }
+
+        this._render();
+      }
+
+      get title() {
+        return this.getAttribute('title') || this.getAttribute('name') || '';
+      }
+
+      set title(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('title');
+        } else {
+          this.setAttribute('title', value);
+        }
+      }
+
+      get description() {
+        return this.getAttribute('description') || '';
+      }
+
+      set description(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('description');
+        } else {
+          this.setAttribute('description', value);
+        }
+      }
+
+      get href() {
+        return (
+          this.getAttribute('href') ||
+          this.getAttribute('link') ||
+          this.getAttribute('action-link') ||
+          this.getAttribute('action-href') ||
+          this.getAttribute('url') ||
+          '#'
+        );
+      }
+
+      set href(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('href');
+        } else {
+          this.setAttribute('href', value);
+        }
+      }
+
+      get linkText() {
+        return (
+          this.getAttribute('link-text') ||
+          this.getAttribute('action-text') ||
+          'View Details'
+        );
+      }
+
+      set linkText(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('link-text');
+        } else {
+          this.setAttribute('link-text', value);
+        }
+      }
+
+      get limited() {
+        return (
+          (this.hasAttribute('limited') && this.getAttribute('limited') !== 'false') ||
+          (this.hasAttribute('badge') && this.getAttribute('badge') !== 'false')
+        );
+      }
+
+      set limited(value) {
+        if (value) {
+          this.setAttribute('limited', '');
+        } else {
+          this.removeAttribute('limited');
+        }
+      }
+
+      get badge() {
+        if (!this.limited) return '';
+        const val = this.getAttribute('badge') || this.getAttribute('limited');
+        return val && val !== 'true' ? val : 'Limited';
+      }
+
+      set badge(value) {
+        if (value) {
+          this.setAttribute('badge', typeof value === 'string' ? value : 'Limited');
+        } else {
+          this.removeAttribute('badge');
+        }
+      }
+
+      _render() {
+        if (!this.shadowRoot) return;
+
+        const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        const descSlot = this.shadowRoot.querySelector('slot[name="description"]');
+        const actionLink = this.shadowRoot.querySelector('a.btn');
+        const badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+
+        if (titleSlot) {
+          titleSlot.textContent = this.getAttribute('title') || this.getAttribute('name') || '';
+        }
+
+        if (descSlot) {
+          descSlot.textContent = this.getAttribute('description') || '';
+        }
+
+        if (actionLink) {
+          const href =
+            this.getAttribute('href') ||
+            this.getAttribute('link') ||
+            this.getAttribute('action-link') ||
+            this.getAttribute('action-href') ||
+            this.getAttribute('url') ||
+            '#';
+          const linkText =
+            this.getAttribute('link-text') ||
+            this.getAttribute('action-text') ||
+            'View Details';
+          actionLink.setAttribute('href', href);
+          actionLink.textContent = linkText;
+        }
+
+        if (badgeSlot) {
+          if (this.limited) {
+            let badgeEl = badgeSlot.querySelector('.badge');
+            if (!badgeEl) {
+              badgeEl = document.createElement('span');
+              badgeEl.className = 'badge';
+              badgeEl.setAttribute('part', 'badge');
+              badgeSlot.replaceChildren(badgeEl);
+            }
+            badgeEl.textContent = this.badge;
+          } else {
+            badgeSlot.replaceChildren();
+          }
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
