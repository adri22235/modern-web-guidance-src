+  <script type="module">
+    const OLD_APP_ORIGIN_URL = 'https://old-app.dailygrind.com';
+    const NEW_APP_ORIGIN_URL = 'https://new-app.dailygrind.com';
+    const REGISTRABLE_DOMAIN = 'dailygrind.com';
+    const STORAGE_KEY = 'daily_grind_user_config';
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    export function checkSameOriginWithFallback(candidate, trustedUrl) {
+      try {
+        if ('Origin' in globalThis) {
+          return extractOrigin(candidate).isSameOrigin(Origin.from(trustedUrl));
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedParsedUrl = new URL(trustedUrl);
+        return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedParsedUrl.origin;
+      } catch {
+        return false;
+      }
+    }
+
+    export function checkSameSiteWithFallback(candidate, trustedUrl = NEW_APP_ORIGIN_URL) {
+      try {
+        if ('Origin' in globalThis) {
+          return extractOrigin(candidate).isSameSite(Origin.from(trustedUrl));
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedParsedUrl = new URL(trustedUrl);
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.protocol === trustedParsedUrl.protocol &&
+          (candidateUrl.hostname === REGISTRABLE_DOMAIN ||
+            candidateUrl.hostname.endsWith(`.${REGISTRABLE_DOMAIN}`))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    function loadUserConfig() {
+      try {
+        const raw = localStorage.getItem(STORAGE_KEY);
+        return raw ? JSON.parse(raw) : { favoriteDrink: 'Maple Oat Latte', size: 'Medium' };
+      } catch {
+        return { favoriteDrink: 'Maple Oat Latte', size: 'Medium' };
+      }
+    }
+
+    function saveUserConfig(config) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+      } catch {
+        // Ignore storage errors in restricted contexts
+      }
+      renderUserConfig(config);
+      updateMigrationLink(config);
+    }
+
+    function renderUserConfig(config) {
+      const statusEl = document.getElementById('config-status');
+      const selectEl = document.getElementById('favorite-drink');
+      if (statusEl) {
+        statusEl.textContent = `Default Order: ${config.favoriteDrink} (${config.size || 'Medium'})`;
+      }
+      if (selectEl && config.favoriteDrink) {
+        selectEl.value = config.favoriteDrink;
+      }
+    }
+
+    function updateMigrationLink(config) {
+      const migrationLink = document.getElementById('migration-link');
+      if (!migrationLink) return;
+      const targetUrl = new URL('/index.html', NEW_APP_ORIGIN_URL);
+      if ( checkSameSiteWithFallback(OLD_APP_ORIGIN_URL, NEW_APP_ORIGIN_URL) ) {
+        targetUrl.searchParams.set('migratedConfig', JSON.stringify(config));
+        migrationLink.href = targetUrl.toString();
+      }
+    }
+
+    // Import configuration passed during origin migration via URL parameter or cross-origin postMessage
+    function importMigratedConfig() {
+      const params = new URLSearchParams(window.location.search);
+      const migratedParam = params.get('migratedConfig');
+      if (migratedParam) {
+        try {
+          const parsed = JSON.parse(migratedParam);
+          if (parsed && typeof parsed.favoriteDrink === 'string') {
+            saveUserConfig(parsed);
+            const cleanUrl = new URL(window.location.href);
+            cleanUrl.searchParams.delete('migratedConfig');
+            window.history.replaceState({}, '', cleanUrl.toString());
+          }
+        } catch {
+          // Ignore malformed migration payload
+        }
+      }
+    }
+
+    // Listen for cross-origin configuration transfer between the old and new same-site origins
+    window.addEventListener('message', (event) => {
+      const isTrustedOldOrigin = checkSameOriginWithFallback(event, OLD_APP_ORIGIN_URL);
+      const isTrustedNewOrigin = checkSameOriginWithFallback(event, NEW_APP_ORIGIN_URL);
+      if (!isTrustedOldOrigin && !isTrustedNewOrigin) return;
+
+      if (event.data?.type === 'MIGRATE_USER_CONFIG' && event.data.config) {
+        saveUserConfig(event.data.config);
+      } else if (event.data?.type === 'REQUEST_USER_CONFIG' && event.source) {
+        const replyOrigin = isTrustedNewOrigin ? NEW_APP_ORIGIN_URL : OLD_APP_ORIGIN_URL;
+        event.source.postMessage(
+          { type: 'MIGRATE_USER_CONFIG', config: loadUserConfig() },
+          replyOrigin
+        );
+      }
+    });
+
+    // Initialize UI and fallback migration banner
+    importMigratedConfig();
+    const initialConfig = loadUserConfig();
+    renderUserConfig(initialConfig);
+    updateMigrationLink(initialConfig);
+
+    const migrationBanner = document.getElementById('migration-banner');
+    const dismissBtn = document.getElementById('dismiss-migration-banner');
+    if (checkSameOriginWithFallback( globalThis, NEW_APP_ORIGIN_URL )) {
+      migrationBanner?.setAttribute('hidden', '');
+    }
+
+    dismissBtn?.addEventListener('click', () => {
+      migrationBanner?.setAttribute('hidden', '');
+    });
+
+    document.getElementById('save-config-btn')?.addEventListener('click', () => {
+      const selectEl = document.getElementById('favorite-drink');
+      const updatedConfig = {
+        favoriteDrink: selectEl ? selectEl.value : 'Maple Oat Latte',
+        size: 'Medium',
+        updatedAt: new Date().toISOString()
+      };
+      saveUserConfig(updatedConfig);
+    });
+  </script>
