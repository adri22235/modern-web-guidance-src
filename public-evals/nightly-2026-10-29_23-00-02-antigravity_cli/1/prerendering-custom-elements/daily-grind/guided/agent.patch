+        ::slotted(a.btn) {
+          margin-top: 0 !important;
+          padding: 8px 14px !important;
+          font-size: 0.9rem;
+        }
+      </style>
+      <article class="card" part="card">
+        <div>
+          <div class="card-header">
+            <slot name="title"></slot>
+            <button type="button" id="favorite-btn" class="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Save to favorites">
+              <span aria-hidden="true" id="fav-icon">♡</span>
+              <span id="fav-label">Favorite</span>
+            </button>
+          </div>
+          <div class="meta" part="meta">
+            <span class="badge" id="price-badge"></span>
+            <span class="badge" id="calories-badge"></span>
+          </div>
+          <slot></slot>
+          <div id="details-panel" class="details-panel" part="details" hidden>
+            <slot name="details"></slot>
+          </div>
+        </div>
+        <div class="actions" part="actions">
+          <button type="button" id="details-toggle" class="details-toggle" part="details-button" aria-expanded="false" aria-controls="details-panel">
+            Tasting Notes
+          </button>
+          <slot name="cta"></slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorited', 'open', 'price', 'calories'];
+      #internals;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals?.() ?? null;
+
+        // Reuse the server-rendered Declarative Shadow DOM root if present;
+        // otherwise attach one from the inert DSD template or the client fallback template.
+        if (!this.shadowRoot) {
+          const dsdTemplate = !Object.hasOwn(HTMLTemplateElement.prototype, 'shadowRootMode')
+            ? this.querySelector(':scope > template[shadowrootmode]')
+            : null;
+          const root = this.attachShadow({
+            mode: (dsdTemplate?.getAttribute('shadowrootmode') || 'open'),
+            delegatesFocus: true
+          });
+          if (dsdTemplate) {
+            root.append(dsdTemplate.content.cloneNode(true));
+            dsdTemplate.remove();
+          } else {
+            root.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: attach listeners once against existing markup without re-rendering.
+        this.shadowRoot.getElementById('favorite-btn')
+          ?.addEventListener('click', () => {
+            this.favorited = !this.favorited;
+            this.dispatchEvent(new CustomEvent('favorite-toggle', {
+              bubbles: true,
+              composed: true,
+              detail: { favorited: this.favorited }
+            }));
+          });
+
+        this.shadowRoot.getElementById('details-toggle')
+          ?.addEventListener('click', () => {
+            this.open = !this.open;
+            this.dispatchEvent(new CustomEvent('details-toggle', {
+              bubbles: true,
+              composed: true,
+              detail: { open: this.open }
+            }));
+          });
+
+        this.shadowRoot.querySelector('slot[name="title"]')
+          ?.addEventListener('slotchange', () => this.#syncTitleLabel());
+      }
+
+      connectedCallback() {
+        this.#syncFavorite();
+        this.#syncOpen();
+        this.#syncMeta();
+        this.#syncTitleLabel();
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(value) {
+        this.toggleAttribute('favorited', Boolean(value));
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(value) {
+        this.toggleAttribute('open', Boolean(value));
+      }
+
+      get price() {
+        return this.getAttribute('price') ?? '';
+      }
+
+      set price(value) {
+        value ? this.setAttribute('price', value) : this.removeAttribute('price');
+      }
+
+      get calories() {
+        return this.getAttribute('calories') ?? '';
+      }
+
+      set calories(value) {
+        value ? this.setAttribute('calories', value) : this.removeAttribute('calories');
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'favorited') this.#syncFavorite();
+        else if (name === 'open') this.#syncOpen();
+        else if (name === 'price' || name === 'calories') this.#syncMeta();
+      }
+
+      #syncFavorite() {
+        const isFav = this.favorited;
+        if (this.#internals?.states) {
+          if (isFav) this.#internals.states.add('favorited');
+          else this.#internals.states.delete('favorited');
+        }
+        const btn = this.shadowRoot?.getElementById('favorite-btn');
+        const icon = this.shadowRoot?.getElementById('fav-icon');
+        const label = this.shadowRoot?.getElementById('fav-label');
+        if (btn) btn.setAttribute('aria-pressed', String(isFav));
+        if (icon) icon.textContent = isFav ? '♥' : '♡';
+        if (label) label.textContent = isFav ? 'Favorited' : 'Favorite';
+      }
+
+      #syncOpen() {
+        const isOpen = this.open;
+        if (this.#internals?.states) {
+          if (isOpen) this.#internals.states.add('expanded');
+          else this.#internals.states.delete('expanded');
+        }
+        const btn = this.shadowRoot?.getElementById('details-toggle');
+        const panel = this.shadowRoot?.getElementById('details-panel');
+        if (btn) {
+          btn.setAttribute('aria-expanded', String(isOpen));
+          btn.textContent = isOpen ? 'Hide Notes' : 'Tasting Notes';
+        }
+        if (panel) {
+          panel.hidden = !isOpen;
+        }
+      }
+
+      #syncMeta() {
+        const priceEl = this.shadowRoot?.getElementById('price-badge');
+        const calEl = this.shadowRoot?.getElementById('calories-badge');
+        if (priceEl && this.price) priceEl.textContent = this.price;
+        if (calEl && this.calories) calEl.textContent = this.calories;
+      }
+
+      #syncTitleLabel() {
+        const slot = this.shadowRoot?.querySelector('slot[name="title"]');
+        const titleEl = slot?.assignedElements?.()[0];
+        const btn = this.shadowRoot?.getElementById('favorite-btn');
+        if (titleEl && btn) {
+          const title = titleEl.textContent.trim();
+          if (title) {
+            btn.setAttribute('aria-label', `Save ${title} to favorites`);
+          }
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
