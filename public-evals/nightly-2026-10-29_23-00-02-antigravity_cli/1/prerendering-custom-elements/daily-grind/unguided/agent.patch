+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['expanded', 'favorited'];
+      }
+
+      constructor() {
+        super();
+        this._hydrated = false;
+      }
+
+      connectedCallback() {
+        // Only attach a shadow root if one was not already created via Declarative Shadow DOM
+        if (!this.shadowRoot) {
+          const shadow = this.attachShadow({ mode: 'open' });
+          shadow.innerHTML = this._buildFallbackTemplate();
+        }
+
+        // Hydrate existing server-rendered shadow DOM nodes in place without re-rendering
+        if (!this._hydrated) {
+          this._detailsBtn = this.shadowRoot.querySelector('.details-toggle');
+          this._detailsPanel = this.shadowRoot.querySelector('.details-content');
+          this._favBtn = this.shadowRoot.querySelector('.favorite-toggle');
+          this._favIcon = this.shadowRoot.querySelector('.fav-icon');
+          this._favLabel = this.shadowRoot.querySelector('.fav-label');
+
+          if (this._detailsBtn) {
+            this._detailsBtn.addEventListener('click', () => {
+              this.expanded = !this.expanded;
+              this.dispatchEvent(new CustomEvent('details-toggle', {
+                detail: { name: this.getAttribute('name'), expanded: this.expanded },
+                bubbles: true,
+                composed: true
+              }));
+            });
+          }
+
+          if (this._favBtn) {
+            this._favBtn.addEventListener('click', () => {
+              this.favorited = !this.favorited;
+              this.dispatchEvent(new CustomEvent('favorite-toggle', {
+                detail: { name: this.getAttribute('name'), favorited: this.favorited },
+                bubbles: true,
+                composed: true
+              }));
+            });
+          }
+
+          this._hydrated = true;
+          this.setAttribute('data-hydrated', 'true');
+        }
+
+        if (this.hasAttribute('expanded') || this.hasAttribute('favorited')) {
+          this._syncState();
+        }
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue !== newValue && this._hydrated) {
+          this._syncState();
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(val) {
+        this.toggleAttribute('expanded', Boolean(val));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        this.toggleAttribute('favorited', Boolean(val));
+      }
+
+      _syncState() {
+        const isExpanded = this.expanded;
+        if (this._detailsBtn) {
+          this._detailsBtn.setAttribute('aria-expanded', String(isExpanded));
+          this._detailsBtn.textContent = isExpanded ? 'Hide Details' : 'View Details';
+        }
+        if (this._detailsPanel) {
+          this._detailsPanel.hidden = !isExpanded;
+        }
+
+        const isFavorited = this.favorited;
+        if (this._favBtn) {
+          this._favBtn.setAttribute('aria-pressed', String(isFavorited));
+        }
+        if (this._favIcon) {
+          this._favIcon.textContent = isFavorited ? '\u2665' : '\u2661';
+        }
+        if (this._favLabel) {
+          this._favLabel.textContent = isFavorited ? 'Favorited' : 'Favorite';
+        }
+      }
+
+      _buildFallbackTemplate() {
+        const name = this.getAttribute('name') || '';
+        const description = this.getAttribute('description') || '';
+        const price = this.getAttribute('price') || '';
+        const calories = this.getAttribute('calories') || '';
+        const notes = this.getAttribute('notes') || '';
+        const href = this.getAttribute('href') || '/menu';
+        const existingStyle = document.querySelector('drink-card')?.shadowRoot?.querySelector('style')?.outerHTML || '';
+
+        return `
+          ${existingStyle}
+          <article class="card">
+            <div class="card-header">
+              <span class="badge">${price} &bull; ${calories}</span>
+              <button type="button" class="favorite-toggle" data-action="favorite" aria-pressed="false" aria-label="Favorite ${name}">
+                <span class="fav-icon" aria-hidden="true">&#9825;</span>
+                <span class="fav-label">Favorite</span>
+              </button>
+            </div>
+            <h3>${name}</h3>
+            <p class="description">${description}</p>
+            <div class="details-content" id="details-panel" hidden>
+              <div class="details-meta">
+                <span>Price: ${price}</span>
+                <span>${calories}</span>
+              </div>
+              <p class="details-notes">${notes}</p>
+              <a href="${href}" class="details-link">Full Menu Info &rarr;</a>
+            </div>
+            <div class="actions">
+              <button type="button" class="btn details-toggle" data-action="details" aria-expanded="false" aria-controls="details-panel">View Details</button>
+            </div>
+          </article>
+        `;
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
