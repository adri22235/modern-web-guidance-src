diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,243 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>PulseFlow — Modern Product Analytics</title>
+
+  <!--
+    Load the experimentation script with both `async` and `blocking="render"`:
+    - `async`: Prevents parser-blocking so the DOM is built in parallel.
+    - `blocking="render"`: Blocks rendering until the script executes,
+      ensuring the user never sees original content flash before the variant is applied.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // Apply a lightweight anti-flicker fallback only in browsers that do not support blocking="render".
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+
+    // Callback for the experiment SDK to reveal the page once ready in fallback browsers.
+    function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    }
+  </script>
+
+  <style>
+    @layer base, components, utilities;
+
+    @layer base {
+      :root {
+        --color-bg: #f8fafc;
+        --color-surface: #ffffff;
+        --color-text: #0f172a;
+        --color-text-muted: #475569;
+        --color-primary: #2563eb;
+        --color-primary-hover: #1d4ed8;
+        --color-primary-contrast: #ffffff;
+        --color-variant-b: #059669;
+        --color-variant-b-hover: #047857;
+        --color-border: #e2e8f0;
+        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+        --radius-md: 0.5rem;
+        --radius-lg: 1rem;
+        --shadow-lg: 0 10px 25px -5px rgb(15 23 42 / 0.08), 0 8px 10px -6px rgb(15 23 42 / 0.04);
+      }
+
+      body {
+        margin: 0;
+        font-family: var(--font-sans);
+        background-color: var(--color-bg);
+        color: var(--color-text);
+        line-height: 1.6;
+      }
+    }
+
+    @layer components {
+      .site-header {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        max-inline-size: 72rem;
+        margin-inline: auto;
+        padding-block: 1.25rem;
+        padding-inline: 1.5rem;
+      }
+
+      .brand {
+        font-size: 1.25rem;
+        font-weight: 700;
+        color: var(--color-text);
+        text-decoration: none;
+        letter-spacing: -0.02em;
+      }
+
+      .nav-list {
+        display: flex;
+        gap: 1.5rem;
+        list-style: none;
+        margin: 0;
+        padding: 0;
+      }
+
+      .nav-list a {
+        color: var(--color-text-muted);
+        text-decoration: none;
+        font-weight: 500;
+      }
+
+      .nav-list a:hover {
+        color: var(--color-text);
+      }
+
+      .hero {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
+        align-items: center;
+        gap: 3rem;
+        max-inline-size: 72rem;
+        margin-inline: auto;
+        padding-block: 4rem 5rem;
+        padding-inline: 1.5rem;
+      }
+
+      .hero-badge {
+        display: inline-block;
+        padding-block: 0.25rem;
+        padding-inline: 0.75rem;
+        margin-block-end: 1rem;
+        font-size: 0.875rem;
+        font-weight: 600;
+        color: var(--color-primary);
+        background-color: #dbeafe;
+        border-radius: 9999px;
+      }
+
+      .hero-title {
+        margin-block: 0 1.25rem;
+        font-size: clamp(2.25rem, 4vw + 1rem, 3.5rem);
+        line-height: 1.15;
+        letter-spacing: -0.03em;
+      }
+
+      .hero-description {
+        margin-block: 0 2rem;
+        font-size: 1.125rem;
+        color: var(--color-text-muted);
+        max-inline-size: 38ch;
+      }
+
+      .hero-actions {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: 1rem;
+      }
+
+      .cta-button {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        padding-block: 0.875rem;
+        padding-inline: 1.75rem;
+        font-family: inherit;
+        font-size: 1rem;
+        font-weight: 600;
+        color: var(--color-primary-contrast);
+        background-color: var(--color-primary);
+        border: none;
+        border-radius: var(--radius-md);
+        cursor: pointer;
+        text-decoration: none;
+        transition: background-color 0.15s ease, transform 0.15s ease;
+      }
+
+      .cta-button:hover:not(:disabled) {
+        background-color: var(--color-primary-hover);
+      }
+
+      .cta-button:focus-visible {
+        outline: 3px solid var(--color-primary);
+        outline-offset: 2px;
+      }
+
+      /* Variant B styles keyed to a root data attribute set by the experiment SDK */
+      [data-variant="b"] .cta-button {
+        background-color: var(--color-variant-b);
+      }
+
+      [data-variant="b"] .cta-button:hover:not(:disabled) {
+        background-color: var(--color-variant-b-hover);
+      }
+
+      .hero-visual {
+        margin: 0;
+      }
+
+      .hero-image {
+        display: block;
+        inline-size: 100%;
+        block-size: auto;
+        border-radius: var(--radius-lg);
+        box-shadow: var(--shadow-lg);
+        border: 1px solid var(--color-border);
+      }
+    }
+
+    @layer utilities {
+      /* Fallback anti-flicker rule only applied when blocking="render" is unsupported */
+      .ab-loading {
+        opacity: 0 !important;
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a href="/" class="brand">PulseFlow</a>
+    <nav aria-label="Primary">
+      <ul class="nav-list">
+        <li><a href="#features">Features</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#docs">Documentation</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" id="hero" data-experiment="hero-cta">
+      <div class="hero-content">
+        <span class="hero-badge">Real-Time Experimentation</span>
+        <h1 class="hero-title" id="hero-heading">Ship product insights faster with zero-latency analytics</h1>
+        <p class="hero-description" id="hero-subtitle">
+          Understand user journeys, validate hypotheses, and measure conversion impact across every release without slowing down your experience.
+        </p>
+        <div class="hero-actions">
+          <button type="button" class="cta-button" id="hero-cta">Start Free Trial</button>
+        </div>
+      </div>
+
+      <figure class="hero-visual">
+        <img
+          class="hero-image"
+          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+          alt="Analytics dashboard displaying conversion charts and real-time metrics"
+          width="1200"
+          height="800"
+          fetchpriority="high"
+        >
+      </figure>
+    </section>
+  </main>
+</body>
+</html>
