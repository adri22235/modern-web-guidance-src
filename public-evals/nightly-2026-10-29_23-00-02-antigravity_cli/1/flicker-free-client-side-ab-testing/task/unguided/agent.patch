diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,438 @@
+<!DOCTYPE html>
+<html lang="en" class="ab-loading">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="description" content="Ship faster with automated workflows, real-time analytics, and instant global deployments.">
+  <title>PulseFlow — Modern Product Acceleration Platform</title>
+
+  <!-- Early connection & high-priority preload for the A/B testing SDK -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="dns-prefetch" href="https://cdn.example.com">
+  <link rel="preload" href="https://cdn.example.com/experiment-sdk.js" as="script">
+
+  <!-- Scoped, time-bounded anti-flicker controller -->
+  <script>
+    (function () {
+      var root = document.documentElement;
+      root.classList.add('ab-loading');
+      var settled = false;
+
+      function revealVariant() {
+        if (settled) return;
+        settled = true;
+        root.classList.remove('ab-loading');
+        root.classList.add('ab-ready');
+      }
+
+      // Bounded fallback ensures LCP stays fast even if the third-party CDN hangs
+      var fallbackTimer = setTimeout(revealVariant, 1200);
+
+      window.__onExperimentSettled = function () {
+        clearTimeout(fallbackTimer);
+        revealVariant();
+      };
+
+      // Optional hook if experiment-sdk.js signals completion directly
+      window.onExperimentReady = window.__onExperimentSettled;
+    })();
+  </script>
+
+  <!-- Deferred SDK executes after DOM parsing so target nodes exist, then immediately reveals -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    defer
+    onload="window.__onExperimentSettled && window.__onExperimentSettled()"
+    onerror="window.__onExperimentSettled && window.__onExperimentSettled()"
+  ></script>
+
+  <style>
+    :root {
+      --bg-primary: #0b0f19;
+      --bg-secondary: #111827;
+      --bg-card: rgba(30, 41, 59, 0.7);
+      --text-primary: #f8fafc;
+      --text-secondary: #94a3b8;
+      --accent: #6366f1;
+      --accent-hover: #4f46e5;
+      --accent-glow: rgba(99, 102, 241, 0.35);
+      --border-subtle: rgba(148, 163, 184, 0.16);
+      --surface-highlight: rgba(255, 255, 255, 0.05);
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    html {
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Helvetica, Arial, sans-serif;
+      background-color: var(--bg-primary);
+      color: var(--text-primary);
+      line-height: 1.5;
+      -webkit-font-smoothing: antialiased;
+    }
+
+    body {
+      min-height: 100vh;
+      display: flex;
+      flex-direction: column;
+      background:
+        radial-gradient(circle at 20% 15%, rgba(99, 102, 241, 0.16), transparent 45%),
+        radial-gradient(circle at 80% 20%, rgba(14, 165, 233, 0.12), transparent 45%),
+        var(--bg-primary);
+      overflow-x: hidden;
+    }
+
+    /* Anti-flicker scoping: keeps layout geometry intact (0 CLS) while hiding un-mutated hero copy/CTA */
+    html.ab-loading .hero,
+    html.ab-loading .hero-content,
+    html.ab-loading .hero-title,
+    html.ab-loading .hero-subtitle,
+    html.ab-loading .cta-button,
+    html.ab-loading [data-experiment] {
+      opacity: 0 !important;
+      visibility: hidden !important;
+      pointer-events: none !important;
+    }
+
+    .hero,
+    .hero-content,
+    .hero-title,
+    .hero-subtitle,
+    .cta-button {
+      transition: opacity 0.12s ease-out;
+    }
+
+    /* Header renders immediately for fast First Contentful Paint */
+    .site-header {
+      width: 100%;
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 1.25rem 1.5rem;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      border-bottom: 1px solid var(--border-subtle);
+    }
+
+    .brand {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.625rem;
+      font-weight: 700;
+      font-size: 1.125rem;
+      color: var(--text-primary);
+      text-decoration: none;
+      letter-spacing: -0.02em;
+    }
+
+    .brand-icon {
+      width: 28px;
+      height: 28px;
+      border-radius: 8px;
+      background: linear-gradient(135deg, #6366f1, #0ea5e9);
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      color: #ffffff;
+      font-weight: 800;
+      font-size: 0.9rem;
+    }
+
+    .nav-links {
+      display: flex;
+      align-items: center;
+      gap: 1.75rem;
+      list-style: none;
+    }
+
+    .nav-links a {
+      color: var(--text-secondary);
+      text-decoration: none;
+      font-size: 0.9375rem;
+      font-weight: 500;
+      transition: color 0.15s ease;
+    }
+
+    .nav-links a:hover {
+      color: var(--text-primary);
+    }
+
+    /* Main & Hero Section with reserved dimensions to prevent layout shift */
+    main {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    .hero {
+      width: 100%;
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 5rem 1.5rem 4rem;
+      display: grid;
+      grid-template-columns: 1.15fr 0.85fr;
+      gap: 3.5rem;
+      align-items: center;
+      min-height: 540px;
+    }
+
+    .hero-content {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      min-height: 320px;
+    }
+
+    .hero-badge {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      padding: 0.375rem 0.875rem;
+      border-radius: 9999px;
+      background: var(--surface-highlight);
+      border: 1px solid var(--border-subtle);
+      color: #a5b4fc;
+      font-size: 0.8125rem;
+      font-weight: 600;
+      margin-bottom: 1.5rem;
+    }
+
+    .hero-title {
+      font-size: clamp(2.25rem, 4.5vw, 3.5rem);
+      font-weight: 800;
+      line-height: 1.12;
+      letter-spacing: -0.03em;
+      color: var(--text-primary);
+      margin-bottom: 1.25rem;
+      min-height: 2.24em;
+    }
+
+    .hero-subtitle {
+      font-size: 1.125rem;
+      color: var(--text-secondary);
+      max-width: 56ch;
+      margin-bottom: 2.25rem;
+      min-height: 3.375rem;
+    }
+
+    .hero-actions {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 1rem;
+      min-height: 52px;
+    }
+
+    .cta-button {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.5rem;
+      min-width: 190px;
+      min-height: 50px;
+      padding: 0.875rem 1.75rem;
+      border-radius: 0.625rem;
+      border: none;
+      background: var(--accent);
+      color: #ffffff;
+      font-size: 1rem;
+      font-weight: 600;
+      cursor: pointer;
+      text-decoration: none;
+      box-shadow: 0 8px 24px var(--accent-glow);
+      transition: background-color 0.15s ease, transform 0.15s ease;
+    }
+
+    .cta-button:hover {
+      background: var(--accent-hover);
+      transform: translateY(-1px);
+    }
+
+    .cta-button:focus-visible {
+      outline: 2px solid #a5b4fc;
+      outline-offset: 3px;
+    }
+
+    .secondary-link {
+      display: inline-flex;
+      align-items: center;
+      padding: 0.875rem 1.25rem;
+      border-radius: 0.625rem;
+      border: 1px solid var(--border-subtle);
+      background: var(--surface-highlight);
+      color: var(--text-primary);
+      font-size: 0.9375rem;
+      font-weight: 500;
+      text-decoration: none;
+      min-height: 50px;
+    }
+
+    /* Lightweight vector dashboard preview (zero external image requests) */
+    .hero-visual {
+      background: var(--bg-card);
+      border: 1px solid var(--border-subtle);
+      border-radius: 1rem;
+      padding: 1.5rem;
+      min-height: 340px;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
+    }
+
+    .visual-header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding-bottom: 1rem;
+      border-bottom: 1px solid var(--border-subtle);
+    }
+
+    .window-dots {
+      display: flex;
+      gap: 0.4rem;
+    }
+
+    .window-dot {
+      width: 10px;
+      height: 10px;
+      border-radius: 50%;
+      background: rgba(148, 163, 184, 0.35);
+    }
+
+    .metrics-grid {
+      display: grid;
+      grid-template-columns: repeat(2, 1fr);
+      gap: 1rem;
+      margin: 1.25rem 0;
+    }
+
+    .metric-card {
+      background: rgba(15, 23, 42, 0.65);
+      border: 1px solid var(--border-subtle);
+      border-radius: 0.75rem;
+      padding: 1rem;
+    }
+
+    .metric-label {
+      font-size: 0.75rem;
+      color: var(--text-secondary);
+      text-transform: uppercase;
+      letter-spacing: 0.05em;
+    }
+
+    .metric-value {
+      font-size: 1.5rem;
+      font-weight: 700;
+      color: var(--text-primary);
+      margin-top: 0.25rem;
+    }
+
+    .metric-delta {
+      font-size: 0.75rem;
+      color: #34d399;
+      font-weight: 600;
+    }
+
+    .site-footer {
+      width: 100%;
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 1.5rem;
+      border-top: 1px solid var(--border-subtle);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      font-size: 0.875rem;
+      color: var(--text-secondary);
+    }
+
+    @media (max-width: 860px) {
+      .hero {
+        grid-template-columns: 1fr;
+        padding: 3rem 1.5rem;
+      }
+      .nav-links {
+        display: none;
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a href="/" class="brand">
+      <span class="brand-icon" aria-hidden="true">P</span>
+      <span>PulseFlow</span>
+    </a>
+    <nav aria-label="Primary Navigation">
+      <ul class="nav-links">
+        <li><a href="#features">Features</a></li>
+        <li><a href="#benchmarks">Benchmarks</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#docs">Docs</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" id="hero" data-experiment="hero-variant">
+      <div class="hero-content">
+        <span class="hero-badge" data-experiment-badge>Release 4.2 — Instant Edge Rollouts</span>
+        <h1 class="hero-title" id="hero-title" data-experiment-target="headline">
+          Ship high-converting product experiences at global edge speed.
+        </h1>
+        <p class="hero-subtitle" id="hero-subtitle" data-experiment-target="subheadline">
+          Automate experiment rollouts, monitor real-time Core Web Vitals, and deploy zero-latency updates across every region in seconds.
+        </p>
+        <div class="hero-actions">
+          <button
+            type="button"
+            class="cta-button"
+            id="cta-button"
+            data-experiment-target="cta"
+          >
+            Start Free Trial
+          </button>
+          <a href="#demo" class="secondary-link">View Live Architecture</a>
+        </div>
+      </div>
+
+      <div class="hero-visual" aria-hidden="true">
+        <div class="visual-header">
+          <div class="window-dots">
+            <span class="window-dot"></span>
+            <span class="window-dot"></span>
+            <span class="window-dot"></span>
+          </div>
+          <span class="metric-label">Edge Telemetry • Live</span>
+        </div>
+        <div class="metrics-grid">
+          <div class="metric-card">
+            <div class="metric-label">Conversion Lift</div>
+            <div class="metric-value">+28.4%</div>
+            <div class="metric-delta">▲ 99.8% confidence</div>
+          </div>
+          <div class="metric-card">
+            <div class="metric-label">P99 Edge Latency</div>
+            <div class="metric-value">11.2 ms</div>
+            <div class="metric-delta">▼ 42% vs baseline</div>
+          </div>
+        </div>
+        <svg viewBox="0 0 400 90" width="100%" height="90" fill="none" xmlns="http://www.w3.org/2000/svg">
+          <path d="M0 72 C50 68, 85 42, 135 46 C185 50, 220 20, 275 24 C325 28, 360 8, 400 10" stroke="#6366f1" stroke-width="3" fill="none" />
+          <path d="M0 72 C50 68, 85 42, 135 46 C185 50, 220 20, 275 24 C325 28, 360 8, 400 10 L400 90 L0 90 Z" fill="rgba(99, 102, 241, 0.15)" />
+        </svg>
+      </div>
+    </section>
+  </main>
+
+  <footer class="site-footer">
+    <span>© 2026 PulseFlow Inc. All rights reserved.</span>
+    <span>99.99% Uptime SLA</span>
+  </footer>
+</body>
+</html>
