+  <script>
+    (() => {
+      const form = document.getElementById('coffee-subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-level-output');
+      const progressBar = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-text');
+
+      function formatRoastLabel(value) {
+        const v = Number(value);
+        let name = 'Medium';
+        if (v < 25) name = 'Light';
+        else if (v < 45) name = 'Medium-Light';
+        else if (v < 65) name = 'Medium';
+        else if (v < 85) name = 'Medium-Dark';
+        else name = 'Dark Espresso';
+        return `${name} (${v}%)`;
+      }
+
+      if (roastSlider) {
+        roastSlider.style.setProperty('--progress', `${roastSlider.value}%`);
+        roastSlider.addEventListener('input', (e) => {
+          const val = e.target.value;
+          if (!CSS.supports('accent-color', 'var(--brand-color)')) {
+            e.target.style.setProperty('--progress', `${val}%`);
+          } else {
+            e.target.style.setProperty('--progress', `${val}%`);
+          }
+          if (roastOutput) {
+            roastOutput.textContent = formatRoastLabel(val);
+          }
+        });
+      }
+
+      if (form && progressBar && progressText) {
+        const touchedSteps = new Set(['frequency', 'roast', 'email']);
+        let sliderInteracted = false;
+
+        function updateProgress() {
+          const hasFrequency = Boolean(form.querySelector('input[name="delivery_frequency"]:checked'));
+          const hasEmailChoice = Boolean(form.querySelector('#receive-emails'));
+          let completed = 0;
+          if (hasFrequency) completed += 35;
+          if (hasEmailChoice) completed += 40;
+          if (sliderInteracted) completed += 25;
+          progressBar.value = completed;
+          progressBar.textContent = `${completed}%`;
+          progressText.textContent = `${completed}%`;
+        }
+
+        roastSlider?.addEventListener('input', () => {
+          sliderInteracted = true;
+          updateProgress();
+        });
+
+        form.addEventListener('change', updateProgress);
+
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          sliderInteracted = true;
+          progressBar.value = 100;
+          progressBar.textContent = '100%';
+          progressText.textContent = '100%';
+        });
+      }
+    })();
+  </script>
 </body>
 
