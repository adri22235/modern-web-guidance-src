+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      const progress = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-percentage');
+      const roastSlider = document.getElementById('roast-preference');
+      const roastLabelValue = document.getElementById('roast-label-value');
+      const emailCheckbox = document.getElementById('email-updates');
+      const feedback = document.getElementById('subscription-feedback');
+
+      const roastNames = {
+        1: 'Light Roast (1/5)',
+        2: 'Medium-Light Roast (2/5)',
+        3: 'Medium Roast (3/5)',
+        4: 'Medium-Dark Roast (4/5)',
+        5: 'Dark Roast (5/5)'
+      };
+
+      function updateFormState() {
+        const selectedFrequency = form.querySelector('input[name="deliveryFrequency"]:checked');
+        const hasRoast = roastSlider && roastSlider.value !== '';
+        const hasEmail = emailCheckbox && emailCheckbox.checked;
+
+        if (roastSlider && roastLabelValue) {
+          roastLabelValue.textContent = roastNames[roastSlider.value] || ('Level ' + roastSlider.value + '/5');
+        }
+
+        let completedSteps = 0;
+        if (selectedFrequency) completedSteps += 1;
+        if (hasRoast) completedSteps += 1;
+        if (hasEmail) completedSteps += 1;
+
+        const percentage = Math.round((completedSteps / 3) * 100);
+        if (progress) {
+          progress.value = percentage;
+          progress.textContent = percentage + '%';
+        }
+        if (progressText) {
+          progressText.textContent = percentage + '% Complete';
+        }
+      }
+
+      if (form) {
+        form.addEventListener('input', updateFormState);
+        form.addEventListener('change', updateFormState);
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          if (progress) {
+            progress.value = 100;
+            progress.textContent = '100%';
+          }
+          if (progressText) {
+            progressText.textContent = '100% Complete';
+          }
+          if (feedback) {
+            feedback.textContent = 'Your personalized coffee subscription has been saved!';
+          }
+        });
+        updateFormState();
+      }
+    })();
+  </script>
