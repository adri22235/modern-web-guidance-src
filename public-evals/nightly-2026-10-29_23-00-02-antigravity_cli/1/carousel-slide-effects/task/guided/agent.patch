+    /* Product Carousel */
+    .carousel-section {
+      margin-top: 60px;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      overflow-x: scroll;
+      scroll-snap-type: x mandatory;
+      padding: 40px max(20px, calc(50% - 140px));
+      margin-top: 20px;
+      list-style: none;
+      scroll-behavior: smooth;
+      @media (prefers-reduced-motion: reduce) {
+        scroll-behavior: auto;
+      }
+    }
+
+    .scroller > .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      /* Identity transform prevents stacking context shift when animating */
+      scale: 1;
+    }
+
+    .scroller > .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 12px;
+    }
+
+    .scroller > .card .price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin: 8px 0;
+    }
+
+    @keyframes scale-on-scroll {
+      0% {
+        scale: 0.75;
+      }
+      50% {
+        scale: 1.1;
+      }
+      100% {
+        scale: 0.75;
+      }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .scroller > * {
+          animation: scale-on-scroll auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
