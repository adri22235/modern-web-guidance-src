+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          badge: 'Seasonal Specialty',
+          basePrice: 5.75,
+          description: 'Creamy steamed oat milk blended with our signature double-shot espresso and pure Grade-A Vermont maple syrup, finished with a light dusting of warm cinnamon.',
+          notes: 'Notes: Vermont Maple, Toasted Oat, Cinnamon',
+          roast: 'Roast: Medium-Dark Espresso',
+          calories: '210 kcal (12 oz)',
+          defaultTemp: 'Hot',
+          defaultMilk: 'Oat Milk'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          badge: 'Signature Roast',
+          basePrice: 3.75,
+          description: 'Bold, smokey, and full-bodied double shot pulled from single-origin Sumatra and Colombian beans roasted to a rich dark chocolate finish.',
+          notes: 'Notes: Dark Chocolate, Smokey Cedar, Molasses',
+          roast: 'Roast: Artisanal Dark Roast',
+          calories: '15 kcal (Double Shot)',
+          defaultTemp: 'Hot',
+          defaultMilk: 'None (Black)'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          badge: 'Slow-Steeped Classic',
+          basePrice: 4.75,
+          description: 'Coarsely ground Ethiopian and Guatemalan beans steeped in cold filtered water for 18 hours for maximum smoothness, low acidity, and natural caramel sweetness.',
+          notes: 'Notes: Cocoa Nibs, Smooth Caramel, Crisp Finish',
+          roast: 'Roast: Medium Craft Blend',
+          calories: '10 kcal (16 oz)',
+          defaultTemp: 'Iced',
+          defaultMilk: 'None (Black)'
+        }
+      };
+
+      const modal = document.getElementById('drink-modal');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const orderForm = document.getElementById('drink-order-form');
+      const drinkSelect = document.getElementById('order-drink-select');
+      const tempSelect = document.getElementById('order-temperature');
+      const milkSelect = document.getElementById('order-milk');
+      const quantityInput = document.getElementById('order-quantity');
+      const submitBtn = document.getElementById('modal-submit-btn');
+      const orderStatus = document.getElementById('order-status');
+
+      const badgeEl = document.getElementById('modal-drink-badge');
+      const titleEl = document.getElementById('modal-drink-title');
+      const basePriceEl = document.getElementById('modal-drink-base-price');
+      const descEl = document.getElementById('modal-drink-description');
+      const notesEl = document.getElementById('modal-drink-notes');
+      const roastEl = document.getElementById('modal-drink-roast');
+      const caloriesEl = document.getElementById('modal-drink-calories');
+
+      let lastFocusedTrigger = null;
+
+      function formatCurrency(amount) {
+        return '$' + amount.toFixed(2);
+      }
+
+      function updateTotalPrice() {
+        const drinkKey = drinkSelect.value;
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        let unitPrice = drink.basePrice;
+
+        const checkedSize = orderForm.querySelector('input[name="size"]:checked');
+        if (checkedSize) {
+          unitPrice += parseFloat(checkedSize.dataset.priceDelta || '0');
+        }
+
+        const checkedAddons = orderForm.querySelectorAll('input[type="checkbox"]:checked');
+        checkedAddons.forEach(function (box) {
+          unitPrice += parseFloat(box.dataset.priceDelta || '0');
+        });
+
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        const total = unitPrice * qty;
+        submitBtn.textContent = 'Add to Order \u2014 ' + formatCurrency(total);
+      }
+
+      function populateDrinkDetails(drinkKey, resetDefaults) {
+        const key = DRINKS[drinkKey] ? drinkKey : 'maple-oat-latte';
+        const drink = DRINKS[key];
+
+        drinkSelect.value = key;
+        badgeEl.textContent = drink.badge;
+        titleEl.textContent = drink.name;
+        basePriceEl.textContent = formatCurrency(drink.basePrice);
+        descEl.textContent = drink.description;
+        notesEl.textContent = drink.notes;
+        roastEl.textContent = drink.roast;
+        caloriesEl.textContent = drink.calories;
+
+        if (resetDefaults) {
+          tempSelect.value = drink.defaultTemp;
+          milkSelect.value = drink.defaultMilk;
+          const mediumRadio = orderForm.querySelector('input[name="size"][value="Medium (16 oz)"]');
+          if (mediumRadio) mediumRadio.checked = true;
+          orderForm.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
+            cb.checked = false;
+          });
+          quantityInput.value = '1';
+          orderStatus.hidden = true;
+          orderStatus.textContent = '';
+        }
+
+        updateTotalPrice();
+      }
+
+      function openModal(drinkKey, triggerEl) {
+        lastFocusedTrigger = triggerEl || document.activeElement;
+        populateDrinkDetails(drinkKey, true);
+        document.body.classList.add('modal-open');
+
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+
+        closeBtn.focus();
+      }
+
+      function closeModal() {
+        if (modal.open) {
+          if (typeof modal.close === 'function') {
+            modal.close();
+          } else {
+            modal.removeAttribute('open');
+          }
+        }
+        document.body.classList.remove('modal-open');
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+        }
+      }
+
+      document.querySelectorAll('[data-open-modal]').forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          event.preventDefault();
+          const drinkKey = btn.getAttribute('data-open-modal');
+          openModal(drinkKey, btn);
+        });
+      });
+
+      drinkSelect.addEventListener('change', function () {
+        populateDrinkDetails(drinkSelect.value, false);
+        const drink = DRINKS[drinkSelect.value];
+        if (drink) {
+          tempSelect.value = drink.defaultTemp;
+          milkSelect.value = drink.defaultMilk;
+        }
+        orderStatus.hidden = true;
+      });
+
+      orderForm.addEventListener('change', updateTotalPrice);
+      quantityInput.addEventListener('input', updateTotalPrice);
+
+      orderForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const drink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const checkedSize = orderForm.querySelector('input[name="size"]:checked');
+        const sizeLabel = checkedSize ? checkedSize.value : 'Medium (16 oz)';
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        orderStatus.textContent = 'Added ' + qty + '\u00d7 ' + sizeLabel + ' ' + tempSelect.value + ' ' + drink.name + ' (' + milkSelect.value + ') to your order!';
+        orderStatus.hidden = false;
+      });
+
+      closeBtn.addEventListener('click', closeModal);
+      cancelBtn.addEventListener('click', closeModal);
+
+      // Dismiss when clicking the backdrop outside the modal content box
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          closeModal();
+        }
+      });
+
+      // Ensure focus is restored and scroll lock cleared whenever dialog closes natively (Escape / platform back gesture / closedby)
+      modal.addEventListener('close', function () {
+        document.body.classList.remove('modal-open');
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+        }
+      });
+
+      // Keyboard focus trap & Escape fallback
+      modal.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && modal.open) {
+          event.preventDefault();
+          closeModal();
+          return;
+        }
+        if (event.key === 'Tab' && modal.open) {
+          const focusableSelectors = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
+          const focusable = Array.prototype.slice.call(modal.querySelectorAll(focusableSelectors));
+          if (focusable.length === 0) return;
+          const first = focusable[0];
+          const last = focusable[focusable.length - 1];
+          if (event.shiftKey && document.activeElement === first) {
+            event.preventDefault();
+            last.focus();
+          } else if (!event.shiftKey && document.activeElement === last) {
+            event.preventDefault();
+            first.focus();
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
