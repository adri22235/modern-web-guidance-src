+  <script type="module">
+    // Feature detect 'commandForElement' on HTMLButtonElement.prototype and load polyfill only when missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Velvety steamed oat milk blended with rich espresso and pure Grade A Vermont maple syrup, finished with a light dusting of cinnamon.',
+        notes: 'Notes: Toasted oat, warm maple, cinnamon',
+        price: '$5.75',
+        defaultMilk: 'Oat Milk'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'A full-bodied double shot pulled from single-origin dark-roasted beans with deep cocoa undertones and a rich, velvety crema.',
+        notes: 'Notes: Dark chocolate, smoked cedar, molasses',
+        price: '$3.75',
+        defaultMilk: 'Black / No Milk'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for a naturally sweet, ultra-smooth, low-acidity finish.',
+        notes: 'Notes: Caramel, roasted hazelnut, smooth cocoa',
+        price: '$4.75',
+        defaultMilk: 'Black / No Milk'
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const titleEl = document.getElementById('drink-dialog-title');
+    const descEl = document.getElementById('drink-dialog-desc');
+    const notesEl = document.getElementById('drink-dialog-notes');
+    const priceEl = document.getElementById('drink-dialog-price');
+    const drinkSelect = document.getElementById('drink-select');
+    const sizeSelect = document.getElementById('drink-size');
+    const milkSelect = document.getElementById('drink-milk');
+    const qtyInput = document.getElementById('drink-qty');
+    const statusBanner = document.getElementById('order-status-banner');
+
+    function populateDrinkDetails(drinkKey, resetOptions = false) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      descEl.textContent = drink.description;
+      notesEl.textContent = drink.notes;
+      priceEl.textContent = drink.price;
+      drinkSelect.value = drinkKey in DRINKS ? drinkKey : 'maple-oat-latte';
+      if (resetOptions) {
+        sizeSelect.value = 'Medium (12 oz)';
+        milkSelect.value = drink.defaultMilk;
+        qtyInput.value = '1';
+      }
+    }
+
+    drinkSelect.addEventListener('change', () => {
+      populateDrinkDetails(drinkSelect.value, false);
+    });
+
+    // Listen for the 'command' event directly on the target dialog element
+    dialog.addEventListener('command', (event) => {
+      const source = event.source;
+      if (event.command === 'show-modal' && source?.dataset.drink) {
+        populateDrinkDetails(source.dataset.drink, true);
+      }
+    });
+
+    // Ensure drink details also populate before opening even if command polyfill is still loading
+    for (const btn of document.querySelectorAll('button[commandfor="drink-dialog"][data-drink]')) {
+      btn.addEventListener('click', () => {
+        populateDrinkDetails(btn.dataset.drink, true);
+        if (!('commandForElement' in HTMLButtonElement.prototype) && !dialog.open) {
+          dialog.showModal();
+        }
+      });
+    }
+
+    for (const closeBtn of document.querySelectorAll('button[commandfor="drink-dialog"][command="close"]')) {
+      closeBtn.addEventListener('click', () => {
+        if (!('commandForElement' in HTMLButtonElement.prototype) && dialog.open) {
+          dialog.close();
+        }
+      });
+    }
+
+    // Read dialog.returnValue in a close listener, then reset it to '' to prevent stale values
+    dialog.addEventListener('close', () => {
+      const action = dialog.returnValue;
+      dialog.returnValue = '';
+
+      if (action === 'order') {
+        const drink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const qty = qtyInput.value || '1';
+        const size = sizeSelect.value;
+        const milk = milkSelect.value;
+        statusBanner.textContent = `Added ${qty}x ${size} ${drink.name} (${milk}) to your order.`;
+        statusBanner.hidden = false;
+      }
+    });
+
+    // Fallback for browsers without native closedby support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+
+      for (const dlg of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dlg.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, dlg);
+        });
+        dlg.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dlg)) {
+            dlg.close();
+          }
+        });
+        dlg.addEventListener('click', (event) => {
+          if (event.target !== dlg) return;
+          if (outside(event, dlg)) {
+            dlg.close();
+          }
+        });
+      }
+    }
+  </script>
