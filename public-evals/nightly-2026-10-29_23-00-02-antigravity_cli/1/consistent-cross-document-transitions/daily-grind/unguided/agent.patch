+<!DOCTYPE html>
+<html lang="en" data-theme="light" data-layout="standard">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Our Story | The Daily Grind</title>
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#seasonal-favorites" blocking="render">
+  <link rel="stylesheet" href="/styles.css" blocking="render">
+  <style blocking="render">
+    @view-transition {
+      navigation: auto;
+    }
+
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --surface: #ffffff;
+      --hero-height: 60vh;
+      --hero-min-height: 360px;
+      --container-max-width: 1100px;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+      min-height: 100vh;
+      display: flex;
+      flex-direction: column;
+    }
+
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+      min-height: 64px;
+      contain: layout style;
+      view-transition-name: site-nav;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      view-transition-name: brand-logo;
+    }
+
+    .logo a {
+      color: white;
+      text-decoration: none;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover,
+    nav a[aria-current="page"] {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    .hero {
+      height: var(--hero-height);
+      min-height: var(--hero-min-height);
+      background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+      contain: layout style;
+      view-transition-name: page-hero;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+      view-transition-name: hero-title;
+    }
+
+    .hero p {
+      view-transition-name: hero-subtitle;
+    }
+
+    .container {
+      max-width: var(--container-max-width);
+      width: 100%;
+      margin: 40px auto;
+      padding: 0 20px;
+      flex: 1 0 auto;
+    }
+
+    #seasonal-favorites {
+      contain: layout style;
+      min-height: 260px;
+      view-transition-name: seasonal-favorites;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: var(--surface);
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      min-height: 220px;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      align-items: center;
+      contain: layout style;
+    }
+
+    #card-maple-latte {
+      view-transition-name: card-maple-latte;
+    }
+
+    #card-espresso {
+      view-transition-name: card-espresso;
+    }
+
+    #card-cold-brew {
+      view-transition-name: card-cold-brew;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+  </style>
+  <script src="/theme.js" blocking="render"></script>
+  <script blocking="render">
+    (function () {
+      var root = document.documentElement;
+      if (!root.getAttribute('data-theme')) {
+        root.setAttribute('data-theme', 'light');
+      }
+      if (!root.getAttribute('data-layout')) {
+        root.setAttribute('data-layout', 'standard');
+      }
+      root.setAttribute('data-vt-ready', 'true');
+    })();
+  </script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo"><a href="/">THE DAILY GRIND</a></div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header id="hero" class="hero">
+    <h1>Crafted with Care Since 2015</h1>
+    <p>Direct-trade beans roasted in small batches every morning.</p>
+    <a href="/locations" class="btn">Visit a Cafe</a>
+  </header>
+
+  <main id="main-content" class="container">
+    
+    <section id="seasonal-favorites">
+      <h2 style="text-align: center;">Seasonal Favorites</h2>
+      <div class="grid">
+        <div id="card-maple-latte" class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div id="card-espresso" class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div id="card-cold-brew" class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
