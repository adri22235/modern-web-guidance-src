+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --surface: #ffffff;
+  --hero-height: 60vh;
+  --hero-min-height: 360px;
+  --container-max-width: 1100px;
+}
+
+:root[data-theme="dark"] {
+  --primary: #3e2723;
+  --secondary: #4e342e;
+  --accent: #ffd180;
+  --text: #f5f5f5;
+  --light: #1e1411;
+  --surface: #2d1e19;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  min-height: 64px;
+  contain: layout style;
+  view-transition-name: site-nav;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+  view-transition-name: brand-logo;
+}
+
+.logo a {
+  color: inherit;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  align-items: center;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover,
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section - Fixed/Reserved Geometry for Stability */
+.hero {
+  height: var(--hero-height);
+  min-height: var(--hero-min-height);
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+  contain: layout style;
+  view-transition-name: page-hero;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+  view-transition-name: hero-title;
+}
+
+.hero p {
+  max-width: 640px;
+  font-size: 1.1rem;
+  view-transition-name: hero-subtitle;
+}
+
+.hero .btn {
+  view-transition-name: hero-cta;
+}
+
+/* Content Sections */
+.container {
+  max-width: var(--container-max-width);
+  width: 100%;
+  margin: 40px auto;
+  padding: 0 20px;
+  flex: 1 0 auto;
+}
+
+#seasonal-favorites {
+  contain: layout style;
+  min-height: 260px;
+  view-transition-name: seasonal-favorites;
+}
+
+.section-title {
+  text-align: center;
+  margin-bottom: 10px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: var(--surface);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+  min-height: 220px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: center;
+  contain: layout style;
+}
+
+.card-img {
+  width: 100%;
+  aspect-ratio: 16 / 10;
+  object-fit: cover;
+  border-radius: 6px;
+  margin-bottom: 12px;
+  background-color: var(--secondary);
+}
+
+#card-maple-latte {
+  view-transition-name: card-maple-latte;
+}
+
+#card-espresso {
+  view-transition-name: card-espresso;
+}
+
+#card-cold-brew {
+  view-transition-name: card-cold-brew;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+:root[data-theme="dark"] .card h3 {
+  color: var(--accent);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Cross-Document View Transition Animations */
+@keyframes vt-fade-in {
+  from {
+    opacity: 0;
+    transform: translateY(10px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes vt-fade-out {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(-10px);
+  }
+}
+
+::view-transition-old(root) {
+  animation: 220ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 280ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
+}
+
+::view-transition-group(site-nav),
+::view-transition-group(brand-logo),
+::view-transition-group(page-hero),
+::view-transition-group(hero-title),
+::view-transition-group(seasonal-favorites),
+::view-transition-group(card-maple-latte),
+::view-transition-group(card-espresso),
+::view-transition-group(card-cold-brew) {
+  animation-duration: 280ms;
+  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation-duration: 0.01ms !important;
+  }
+}
diff --git a/theme.js b/theme.js
new file mode 100644
index 0000000..8349567
--- /dev/null
+++ b/theme.js
@@ -0,0 +1,38 @@
+(function () {
+  var root = document.documentElement;
+  try {
+    var savedTheme = localStorage.getItem('daily-grind-theme');
+    var prefersDark =
+      window.matchMedia &&
+      window.matchMedia('(prefers-color-scheme: dark)').matches;
+    var activeTheme = savedTheme || (prefersDark ? 'dark' : 'light');
+    root.setAttribute('data-theme', activeTheme);
+
+    var savedLayout = localStorage.getItem('daily-grind-layout') || 'standard';
+    root.setAttribute('data-layout', savedLayout);
+  } catch (e) {
+    root.setAttribute('data-theme', 'light');
+    root.setAttribute('data-layout', 'standard');
+  }
+  root.setAttribute('data-vt-ready', 'true');
+
+  window.addEventListener('pageswap', function (event) {
+    if (!event.viewTransition) return;
+    var targetUrl =
+      event.activation && event.activation.entry && event.activation.entry.url
+        ? new URL(event.activation.entry.url)
+        : null;
+    if (targetUrl && event.viewTransition.types) {
+      event.viewTransition.types.add('navigation');
+      var path = targetUrl.pathname.replace(/\/+$/, '') || '/';
+      event.viewTransition.types.add('to-' + (path === '/' ? 'home' : path.slice(1).replace(/\//g, '-')));
+    }
+  });
+
+  window.addEventListener('pagereveal', function (event) {
+    if (!event.viewTransition) return;
+    if (event.viewTransition.types) {
+      event.viewTransition.types.add('navigation');
+    }
+  });
+})();
