new file mode 100644
index 0000000..eb03cee
--- /dev/null
+++ b/theme-init.js
@@ -0,0 +1,49 @@
+// Apply initial theme and layout configuration before the cross-document view transition snapshot renders
+(function initThemeAndLayout() {
+  try {
+    const savedTheme = localStorage.getItem('theme') || 'light';
+    document.documentElement.dataset.theme = savedTheme;
+    const savedLayout = localStorage.getItem('layout') || 'default';
+    document.documentElement.dataset.layout = savedLayout;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+    document.documentElement.dataset.layout = 'default';
+  }
+})();
+
+// Dynamically pair shared elements across pages when navigating between cards and detail pages
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const fromUrlString = window.navigation?.activation?.from?.url;
+  const entryUrlString = window.navigation?.activation?.entry?.url || window.location.href;
+  if (!fromUrlString || !entryUrlString) return;
+
+  const normalizePath = (pathname) => pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
+  const fromPath = normalizePath(new URL(fromUrlString, window.location.origin).pathname);
+  const toPath = normalizePath(new URL(entryUrlString, window.location.origin).pathname);
+
+  let targetElement = null;
+
+  // Match item card when navigating between homepage/menu and item detail page
+  if (toPath.startsWith('/menu/') && (fromPath === '/' || fromPath === '/menu')) {
+    targetElement = document.querySelector('#seasonal-favorites .card');
+  } else if ((toPath === '/' || toPath === '/menu') && fromPath.startsWith('/menu/')) {
+    const link = document.querySelector(`a[href="${fromPath}"]`);
+    targetElement = link?.closest('.card') || null;
+  }
+
+  if (targetElement) {
+    targetElement.style.viewTransitionName = 'featured-drink-card';
+    try {
+      await event.viewTransition.ready;
+    } catch (error) {
+      if (error.name !== 'InvalidStateError') {
+        throw error;
+      }
+    } finally {
+      await event.viewTransition.finished;
+      targetElement.style.viewTransitionName = '';
+    }
+  }
+});
