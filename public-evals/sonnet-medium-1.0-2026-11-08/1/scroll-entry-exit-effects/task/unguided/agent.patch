diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,36 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Scroll-driven reveal: only for users who haven't asked for reduced motion,
+       and only in browsers that support scroll-driven animations. Otherwise the
+       cards simply render at full size. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+          animation-range: cover 0% cover 100%;
+        }
+      }
+    }
+
+    @keyframes card-reveal {
+      0% {
+        transform: scale(0.5);
+      }
+
+      35%,
+      65% {
+        transform: scale(1);
+      }
+
+      100% {
+        transform: scale(0.5);
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
