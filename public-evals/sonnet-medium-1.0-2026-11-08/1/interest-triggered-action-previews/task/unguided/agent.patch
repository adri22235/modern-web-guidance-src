+    /* Seasonal live preview (pure CSS: :has() reacts to hover/focus/press on any button) */
+    #seasonal-preview {
+      margin-top: 20px;
+      padding: 20px;
+      text-align: center;
+      background: white;
+      border-radius: 8px;
+      border-left: 8px solid var(--secondary);
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      transition: border-color 0.3s;
+    }
+
+    #seasonal-preview .preview-item {
+      display: none;
+    }
+
+    #seasonal-preview .preview-default {
+      display: block;
+    }
+
+    #seasonal-preview .preview-item strong {
+      color: var(--primary);
+    }
+
+    #seasonal-preview .swatch {
+      display: inline-block;
+      width: 1em;
+      height: 1em;
+      border-radius: 50%;
+      vertical-align: middle;
+      margin-right: 6px;
+    }
+
+    #seasonal .btn {
+      -webkit-touch-callout: none;
+      -webkit-user-select: none;
+      user-select: none;
+    }
+
+    #seasonal:has(.btn[data-drink]:is(:hover, :focus-visible, :active)) #seasonal-preview .preview-default {
+      display: none;
+    }
+
+    #seasonal:has(.btn[data-drink="maple-oat-latte"]:is(:hover, :focus-visible, :active)) #seasonal-preview .preview-maple-oat-latte,
+    #seasonal:has(.btn[data-drink="dark-roast-espresso"]:is(:hover, :focus-visible, :active)) #seasonal-preview .preview-dark-roast-espresso,
+    #seasonal:has(.btn[data-drink="cold-brew"]:is(:hover, :focus-visible, :active)) #seasonal-preview .preview-cold-brew {
+      display: block;
+    }
+
+    #seasonal:has(.btn[data-drink="maple-oat-latte"]:is(:hover, :focus-visible, :active)) #seasonal-preview { border-left-color: #c68642; }
+    #seasonal:has(.btn[data-drink="dark-roast-espresso"]:is(:hover, :focus-visible, :active)) #seasonal-preview { border-left-color: #3e2723; }
+    #seasonal:has(.btn[data-drink="cold-brew"]:is(:hover, :focus-visible, :active)) #seasonal-preview { border-left-color: #4a7c8c; }
+
