+  <script type="module">
+    // Load the interestfor polyfill only where native interest invokers are missing
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+    // One listener on the shared target; the buttons stay purely declarative
+    const preview = document.getElementById("seasonal-preview");
+    preview.addEventListener("interest", (event) => {
+      const { drink, color } = event.source.dataset;
+      preview.textContent = drink;
+      preview.style.setProperty("--preview-accent", color);
+    });
+    preview.addEventListener("loseinterest", () => {
+      preview.textContent = preview.dataset.default;
+      preview.style.removeProperty("--preview-accent");
+    });
