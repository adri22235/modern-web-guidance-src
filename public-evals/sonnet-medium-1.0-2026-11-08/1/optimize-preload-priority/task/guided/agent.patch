diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,54 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Brand — Watch the film</title>
+<meta name="description" content="Watch the film.">
+
+<!-- LCP: video poster isn't discoverable by the preload scanner as an <img>, so preload it with high priority -->
+<link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+<!-- Critical header font: high by default; crossorigin is required even same-origin -->
+<link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+<!-- Secondary font: start early but don't compete with LCP resources -->
+<link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+<style>
+@font-face{
+  font-family:"Brand";
+  src:url(brand-font.woff2) format("woff2");
+  font-display:swap;
+}
+@font-face{
+  font-family:"Secondary";
+  src:url(secondary-font.woff2) format("woff2");
+  font-display:swap;
+}
+*{box-sizing:border-box;margin:0}
+body{
+  font-family:"Secondary",system-ui,sans-serif;
+  background:#000;color:#fff;
+}
+header{padding:1rem 1.25rem}
+h1{
+  font-family:"Brand",system-ui,sans-serif;
+  font-size:1.5rem;
+}
+video{
+  display:block;width:100%;height:auto;
+  aspect-ratio:16/9;object-fit:cover;background:#000;
+}
+footer{padding:1rem 1.25rem;font-size:.875rem;opacity:.8}
+</style>
+</head>
+<body>
+<header><h1>Brand</h1></header>
+<main>
+  <!-- preload="none": don't let video data compete with the poster; user starts playback -->
+  <video poster="poster.jpg" width="1280" height="720" controls preload="none" playsinline>
+    <source src="video.mp4" type="video/mp4">
+  </video>
+</main>
+<footer><a href="#" style="color:inherit">Contact</a></footer>
+</body>
+</html>
