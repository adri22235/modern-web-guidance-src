diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,41 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Brand — Watch the film</title>
+<meta name="description" content="Watch the film.">
+
+<!-- Critical: LCP image and header font, fetched at highest priority, first -->
+<link rel="preload" as="image" href="poster.jpg" fetchpriority="high">
+<link rel="preload" as="font" type="font/woff2" href="brand-font.woff2" crossorigin>
+
+<style>
+/* Critical font: swap-free-ish; optional avoids layout shift and late swaps */
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-display:optional}
+/* Secondary font: not preloaded, swaps in when ready */
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:swap}
+
+*{box-sizing:border-box;margin:0}
+body{font:16px/1.5 Secondary,system-ui,sans-serif;background:#000;color:#fff}
+header{padding:16px 20px}
+h1{font:700 1.5rem/1.2 Brand,system-ui,sans-serif}
+main{max-width:960px;margin:0 auto;padding:0 20px}
+.player{position:relative;aspect-ratio:16/9;background:#111 url(poster.jpg) center/cover no-repeat}
+video{display:block;width:100%;height:100%;object-fit:cover}
+a.cta{display:inline-block;margin:16px 0;padding:10px 20px;border-radius:6px;background:#fff;color:#000;text-decoration:none;font-size:.9rem}
+</style>
+</head>
+<body>
+<header><h1>Brand</h1></header>
+<main>
+  <!-- Poster is the LCP element; dimensions reserve space, no JS required -->
+  <div class="player">
+    <video controls preload="none" poster="poster.jpg" width="1280" height="720" playsinline>
+      <source src="video.mp4" type="video/mp4">
+    </video>
+  </div>
+  <a class="cta" href="#">Get started</a>
+</main>
+</body>
+</html>
