+<script type="module">
+    // Load polyfills only where native support is missing
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+
+    const feature = document.getElementById("feature");
+    const tourStep = document.getElementById("tour-step");
+
+    // Keep the user on the page while the tour is showing
+    feature.addEventListener("click", (e) => {
+      if (tourOpen) e.preventDefault();
+    });
+
+    let tourOpen = false;
+    tourStep.addEventListener("toggle", (e) => {
+      tourOpen = e.newState === "open";
+      if (e.newState === "closed") feature.focus();
+    });
+
+    tourStep.showPopover();
+    tourStep.querySelector("button").focus();
+  </script>
