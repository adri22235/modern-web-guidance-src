+<script>
+    (function () {
+      var step = document.getElementById('tour-step');
+      var link = document.getElementById('feature');
+      var touring = true;
+
+      // Fallback for browsers without CSS anchor positioning
+      var anchored = CSS.supports('anchor-name: --a');
+      function place() {
+        if (anchored) return;
+        var r = link.getBoundingClientRect();
+        var w = step.offsetWidth;
+        var left = Math.min(Math.max(8, r.left + r.width / 2 - w / 2), window.innerWidth - w - 8);
+        step.style.left = left + 'px';
+        step.style.top = (r.bottom + 12) + 'px';
+      }
+
+      function close() {
+        touring = false;
+        window.removeEventListener('resize', place);
+        window.removeEventListener('scroll', place, true);
+        step.hidePopover();
+      }
+
+      // Don't navigate away while the tour is active
+      link.addEventListener('click', function (e) {
+        if (touring) e.preventDefault();
+      });
+      document.getElementById('tour-close').addEventListener('click', close);
+
+      step.showPopover(); // popover="manual" ignores outside clicks and Esc
+      place();
+      window.addEventListener('resize', place);
+      window.addEventListener('scroll', place, true);
+    })();
+  </script>
 </body>
 
