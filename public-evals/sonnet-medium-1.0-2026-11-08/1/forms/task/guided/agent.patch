+  <script>
+    (() => {
+      const form = document.getElementById('signup-form');
+      const steps = [...form.querySelectorAll('.step')];
+      const tracker = [...document.querySelectorAll('#steps li')];
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const submitBtn = document.getElementById('submit-btn');
+      const status = document.getElementById('form-status');
+      const nextLabels = ['Next: Your tastes', 'Next: Confirm'];
+      let current = 0;
+
+      // Birthday can't be in the future
+      const birthday = form.elements.birthday;
+      birthday.max = new Date().toISOString().slice(0, 10);
+
+      const messages = {
+        full_name: { valueMissing: 'Enter your name.' },
+        email: {
+          valueMissing: 'Enter your email address.',
+          typeMismatch: 'Enter a valid email address, like you@example.com.'
+        },
+        password: {
+          valueMissing: 'Create a password.',
+          tooShort: 'Your password needs at least 8 characters.'
+        },
+        favorite_drink: { valueMissing: 'Pick your favorite drink.' },
+        birthday: { rangeOverflow: 'Birthday can\u2019t be in the future.', badInput: 'Enter a valid date.' },
+        postal_code: { patternMismatch: 'Use 3\u201312 letters, numbers, spaces or hyphens.' },
+        phone: { patternMismatch: 'Enter a phone number using digits, spaces, + ( ) - or .' },
+        terms_accepted: { valueMissing: 'Please accept the terms to join.' }
+      };
+
+      const errorFor = (el) => document.getElementById(
+        el.name === 'favorite_drink' ? 'drink-error' : el.getAttribute('aria-describedby')?.split(' ').find(id => id.endsWith('-error'))
+      );
+
+      function showError(el) {
+        const msgs = messages[el.name] || {};
+        const key = Object.keys(msgs).find(k => el.validity[k]);
+        const text = (key && msgs[key]) || el.validationMessage;
+        const box = errorFor(el);
+        const targets = el.type === 'radio' ? form.querySelectorAll(`[name="${el.name}"]`) : [el];
+        targets.forEach(t => t.setAttribute('aria-invalid', 'true'));
+        if (box) box.textContent = text;
+      }
+
+      function clearError(el) {
+        const targets = el.type === 'radio' ? form.querySelectorAll(`[name="${el.name}"]`) : [el];
+        targets.forEach(t => t.removeAttribute('aria-invalid'));
+        const box = errorFor(el);
+        if (box) box.textContent = '';
+      }
+
+      const fields = (step) => [...step.querySelectorAll('input:not([type="hidden"]), select, textarea')];
+
+      // Validate a step; show all errors, focus the first invalid control.
+      function validateStep(step) {
+        let first = null;
+        fields(step).forEach(el => {
+          if (el.checkValidity()) return clearError(el);
+          showError(el);
+          first ||= el;
+        });
+        first?.focus();
+        return !first;
+      }
+
+      // Blur: validate if edited. Input: clear errors once fixed.
+      form.addEventListener('focusout', (e) => {
+        const el = e.target;
+        if (!el.name || el.type === 'hidden' || el.type === 'button') return;
+        if (el.dataset.touched !== 'true') return;
+        el.checkValidity() ? clearError(el) : showError(el);
+      });
+      form.addEventListener('input', (e) => {
+        const el = e.target;
+        if (!el.name) return;
+        el.dataset.touched = 'true';
+        if (el.hasAttribute('aria-invalid') && el.checkValidity()) clearError(el);
+      });
+      form.addEventListener('change', (e) => {
+        if (e.target.type === 'radio' || e.target.type === 'checkbox') {
+          e.target.dataset.touched = 'true';
+          if (e.target.checkValidity()) clearError(e.target);
+        }
+      });
+
+      function show(index, moveFocus) {
+        current = index;
+        steps.forEach((step, i) => { step.hidden = i !== index; });
+        tracker.forEach((li, i) => {
+          li.classList.toggle('done', i < index);
+          if (i === index) li.setAttribute('aria-current', 'step');
+          else li.removeAttribute('aria-current');
+        });
+        prevBtn.hidden = index === 0;
+        nextBtn.hidden = index === steps.length - 1;
+        submitBtn.hidden = index !== steps.length - 1;
+        nextBtn.textContent = nextLabels[index] || 'Next';
+        status.textContent = '';
+        if (moveFocus) steps[index].querySelector('h3').focus();
+      }
+
+      // Progressive enhancement: without JS every step is visible and the form submits natively.
+      show(0, false);
+
+      nextBtn.addEventListener('click', () => {
+        if (validateStep(steps[current])) show(current + 1, true);
+      });
+      prevBtn.addEventListener('click', () => show(current - 1, true));
+
+      // Enter in a text field advances instead of submitting early.
+      form.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' && !e.isComposing && e.target.matches('input:not([type="checkbox"])')
+          && current < steps.length - 1) {
+          e.preventDefault();
+          nextBtn.click();
+        }
+      });
+
+      const pw = form.elements.password;
+      const toggle = document.getElementById('toggle-password');
+      toggle.addEventListener('click', () => {
+        const show = pw.type === 'password';
+        pw.type = show ? 'text' : 'password';
+        toggle.setAttribute('aria-pressed', String(show));
+        toggle.textContent = show ? 'Hide password' : 'Show password';
+      });
+
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        // Re-validate every step; jump back to the earliest one with a problem.
+        for (let i = 0; i < steps.length; i++) {
+          if (!validateStep(steps[i])) {
+            if (i !== current) { show(i, false); validateStep(steps[i]); }
+            return;
+          }
+        }
+        // Bots fill the honeypot; pretend success without sending anything.
+        const data = new FormData(form);
+        const done = () => {
+          form.hidden = true;
+          const ok = document.getElementById('signup-success');
+          ok.hidden = false;
+          ok.querySelector('h3').focus();
+        };
+        if (data.get('website')) return done();
+
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Joining\u2026';
+        status.textContent = '';
+        try {
+          const res = await fetch(form.action, {
+            method: 'POST',
+            body: data,
+            credentials: 'same-origin',
+            headers: { 'Accept': 'application/json' },
+            redirect: 'error'
+          });
+          if (!res.ok) throw new Error(String(res.status));
+          form.reset();
+          done();
+        } catch {
+          status.textContent = 'Sorry, we couldn\u2019t create your account. Please check your connection and try again.';
+          submitBtn.disabled = false;
+          submitBtn.textContent = 'Join Rewards';
+        }
+      });
+    })();
+  </script>
