+  <script>
+    (function () {
+      var form = document.getElementById('reg-form');
+      document.documentElement.classList.add('js');
+
+      var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
+      var crumbs = Array.prototype.slice.call(document.querySelectorAll('#progress li'));
+      var back = document.getElementById('back');
+      var next = document.getElementById('next');
+      var submit = document.getElementById('submit');
+      var status = document.getElementById('form-status');
+      var current = 0;
+
+      // Apply hidden state now that JS is active (without JS all steps show and the form posts natively)
+      function show(i, moveFocus) {
+        current = i;
+        steps.forEach(function (s, n) { s.hidden = n !== i; });
+        crumbs.forEach(function (c, n) {
+          c.classList.toggle('done', n < i);
+          if (n === i) c.setAttribute('aria-current', 'step'); else c.removeAttribute('aria-current');
+        });
+        back.hidden = i === 0;
+        next.hidden = i === steps.length - 1;
+        submit.hidden = i !== steps.length - 1;
+        status.textContent = ''; status.className = 'form-status';
+        if (moveFocus) steps[i].querySelector('legend').focus();
+      }
+
+      function errEl(field) {
+        var id = field.getAttribute('aria-describedby') || '';
+        var m = id.split(' ').filter(function (x) { return /-err$/.test(x); })[0];
+        return m && document.getElementById(m);
+      }
+
+      function message(f) {
+        var v = f.validity, label = f.id;
+        if (v.valueMissing) {
+          if (f.type === 'checkbox') return 'You must agree to the terms to join.';
+          return 'Please enter your ' + ({
+            'given-name': 'first name', 'family-name': 'last name', email: 'email address',
+            password: 'password', postal: 'ZIP or postal code'
+          }[label] || 'answer') + '.';
+        }
+        if (v.typeMismatch) return 'Enter a valid email address, like name@example.com.';
+        if (v.tooShort) return 'Use at least ' + f.minLength + ' characters (you have ' + f.value.length + ').';
+        if (v.patternMismatch) return f.id === 'tel' ? 'Enter a valid phone number, digits only.' : 'Enter a valid ZIP or postal code.';
+        if (v.rangeUnderflow || v.badInput) return 'Enter a valid date.';
+        return 'This value is not valid.';
+      }
+
+      function validateField(f) {
+        f.setCustomValidity('');
+        if (f.id === 'bday' && f.value) {
+          var d = new Date(f.value), now = new Date();
+          if (d > now) f.setCustomValidity('x');
+        }
+        var e = errEl(f), ok = f.checkValidity();
+        if (f.id === 'bday' && !ok && !f.validity.badInput && !f.validity.rangeUnderflow) {
+          if (e) e.textContent = 'Birthday cannot be in the future.';
+        } else if (e) {
+          e.textContent = ok ? '' : message(f);
+        }
+        if (ok) f.removeAttribute('aria-invalid'); else f.setAttribute('aria-invalid', 'true');
+        return ok;
+      }
+
+      function fieldsOf(step) {
+        return Array.prototype.slice.call(step.querySelectorAll('input:not([type=hidden]):not(#website), select'));
+      }
+
+      function validateStep(i) {
+        var first = null;
+        fieldsOf(steps[i]).forEach(function (f) {
+          if (!validateField(f) && !first) first = f;
+        });
+        if (first) first.focus();
+        return !first;
+      }
+
+      // Validate on blur once a field has been visited; re-validate live after an error is shown
+      form.addEventListener('focusout', function (e) {
+        var f = e.target;
+        if (f.matches && f.matches('input, select') && f.id !== 'website' && (f.value || f.getAttribute('aria-invalid'))) validateField(f);
+      });
+      form.addEventListener('input', function (e) {
+        if (e.target.getAttribute && e.target.getAttribute('aria-invalid')) validateField(e.target);
+      });
+      form.addEventListener('change', function (e) {
+        if (e.target.getAttribute && e.target.getAttribute('aria-invalid')) validateField(e.target);
+      });
+
+      // Enter advances through steps instead of submitting early
+      form.addEventListener('keydown', function (e) {
+        if (e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.type !== 'checkbox' && current < steps.length - 1) {
+          e.preventDefault(); next.click();
+        }
+      });
+
+      next.addEventListener('click', function () { if (validateStep(current)) show(current + 1, true); });
+      back.addEventListener('click', function () { show(current - 1, true); });
+
+      var pw = document.getElementById('password'), toggle = document.getElementById('pw-toggle');
+      toggle.addEventListener('click', function () {
+        var shown = pw.type === 'text';
+        pw.type = shown ? 'password' : 'text';
+        toggle.textContent = shown ? 'Show' : 'Hide';
+        toggle.setAttribute('aria-pressed', String(!shown));
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        for (var i = 0; i < steps.length; i++) {
+          if (!validateStep(i)) { show(i, false); validateStep(i); return; }
+        }
+        if (form.website.value) return; // honeypot tripped: silently drop
+
+        var data = new URLSearchParams(new FormData(form));
+        submit.disabled = true;
+        status.className = 'form-status'; status.textContent = 'Creating your account…';
+
+        // Sent over POST in the body (never the URL); cookies are same-origin only
+        fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': form.csrf_token.value },
+          body: data
+        }).then(function (r) {
+          if (!r.ok) throw new Error(r.status);
+          form.hidden = true;
+          document.getElementById('progress').hidden = true;
+          var s = document.getElementById('success');
+          s.hidden = false; s.focus();
+        }).catch(function () {
+          status.className = 'form-status error';
+          status.textContent = 'We couldn’t create your account. Please check your connection and try again.';
+          submit.disabled = false;
+        });
+      });
+
+      show(0, false);
+    })();
+  </script>
