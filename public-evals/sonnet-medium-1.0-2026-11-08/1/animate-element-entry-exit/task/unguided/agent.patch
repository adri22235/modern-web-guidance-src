+  <script>
+    (function () {
+      const container = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+      const EXIT_MS = 400;
+      let promoCount = 0;
+
+      function show(card) {
+        // Force a reflow so the entry transition runs from the initial state
+        void card.offsetWidth;
+        card.classList.add('visible');
+      }
+
+      function hide(card) {
+        if (card.classList.contains('leaving')) return;
+        card.classList.remove('visible');
+        card.classList.add('leaving');
+        let done = false;
+        const finish = () => {
+          if (done) return;
+          done = true;
+          card.remove();
+        };
+        card.addEventListener('transitionend', (e) => {
+          if (e.target === card && e.propertyName === 'opacity') finish();
+        });
+        setTimeout(finish, EXIT_MS + 100);
+      }
+
+      function createToggleCard() {
+        const card = document.createElement('div');
+        card.id = 'toggleCard';
+        card.className = 'card';
+        card.innerHTML = '<h3>Welcome Offer</h3><p>Get 10% off your first order with code GRIND10.</p>';
+        return card;
+      }
+
+      addBtn.addEventListener('click', () => {
+        promoCount += 1;
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.innerHTML = '<h3>Promo #' + promoCount + '</h3><p>Limited-time deal on your favorite brew.</p>';
+        container.appendChild(card);
+        show(card);
+      });
+
+      removeBtn.addEventListener('click', () => {
+        const cards = container.querySelectorAll('.card:not(.leaving)');
+        if (cards.length) hide(cards[cards.length - 1]);
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        const existing = document.getElementById('toggleCard');
+        if (existing && !existing.classList.contains('leaving')) {
+          hide(existing);
+        } else {
+          if (existing) existing.remove();
+          const card = createToggleCard();
+          container.prepend(card);
+          show(card);
+        }
+      });
+
+      show(document.getElementById('toggleCard'));
+    })();
+  </script>
+
 </body>
 
