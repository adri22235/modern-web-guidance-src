+  <script>
+    const form = document.getElementById('quick-order-form');
+    const status = document.getElementById('order-status');
+
+    form.addEventListener('submit', (event) => {
+      // No order backend yet: confirm on the page instead of navigating.
+      event.preventDefault();
+
+      const data = new FormData(form);
+      const drink = form.elements.drink.selectedOptions[0].textContent;
+      const summary = `${data.get('quantity')} × ${data.get('size')} ${drink} for ${data.get('name').trim()}`;
+      const message = `Order placed: ${summary}.`;
+
+      status.textContent = message;
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(message));
+      }
+      form.reset();
+    });
+  </script>
