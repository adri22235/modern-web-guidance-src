+  <script>
+    // Handles both human and agent-invoked submissions client-side.
+    document.getElementById('quick-order-form').addEventListener('submit', function (e) {
+      e.preventDefault();
+      var form = e.target;
+      var data = new FormData(form);
+      var label = function (id) { return form.elements[id].selectedOptions[0].textContent; };
+      var summary = data.get('quantity') + ' × ' + label('size') + ' ' + label('drink') +
+        (data.get('milk') !== 'none' ? ' with ' + data.get('milk') + ' milk' : '') +
+        ' for ' + data.get('name');
+      var message = 'Order placed: ' + summary + '. See you soon!';
+      document.getElementById('order-status').textContent = message;
+      // When invoked by an AI agent, report the result back to it.
+      if (e.agentInvoked && typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(message));
+      }
+    });
+  </script>
