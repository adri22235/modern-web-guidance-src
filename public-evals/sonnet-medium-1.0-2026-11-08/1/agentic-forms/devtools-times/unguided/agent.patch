diff --git a/src/lib/useWebMCPTool.ts b/src/lib/useWebMCPTool.ts
new file mode 100644
index 0000000..146ca70
--- /dev/null
+++ b/src/lib/useWebMCPTool.ts
@@ -0,0 +1,45 @@
+import { useEffect, useRef } from 'react';
+
+export interface WebMCPToolResult {
+  content: { type: 'text'; text: string }[];
+  isError?: boolean;
+}
+
+interface WebMCPTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations?: Record<string, unknown>;
+  execute: (input: any) => Promise<WebMCPToolResult>;
+}
+
+/**
+ * Registers a tool with the browser's WebMCP API (navigator.modelContext) while
+ * the calling component is mounted. No-op in browsers without WebMCP support.
+ */
+export function useWebMCPTool(tool: WebMCPTool) {
+  // Always call the latest execute so the tool sees current component state.
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  useEffect(() => {
+    const modelContext = navigator.modelContext;
+    if (!modelContext?.registerTool) return;
+
+    const registration = modelContext.registerTool({
+      ...tool,
+      execute: (input: any) => executeRef.current(input),
+    });
+
+    return () => {
+      if (registration?.unregister) registration.unregister();
+      else modelContext.unregisterTool?.(tool.name);
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [tool.name]);
+}
+
+export const textResult = (text: string, isError = false): WebMCPToolResult => ({
+  content: [{ type: 'text', text }],
+  ...(isError ? { isError: true } : {}),
+});
