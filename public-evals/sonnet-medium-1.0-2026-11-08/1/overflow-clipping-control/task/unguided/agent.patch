     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Showcase */
+    .showcase {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 32px;
+      align-items: stretch;
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+    }
+
+    /* Concentric corners: inner radius = outer radius - padding */
+    .nested-curve-parent {
+      --outer-radius: 28px;
+      --pad: 12px;
+      padding: var(--pad);
+      border-radius: var(--outer-radius);
+      background: var(--primary);
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
+    }
+
+    .nested-curve-parent > .nested-curve-inner {
+      height: 100%;
+      border-radius: calc(var(--outer-radius) - var(--pad));
+      overflow: hidden;
+      background: white;
+    }
+
+    .nested-curve-inner img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-inner .showcase-body {
+      padding: 20px;
+    }
+
+    .nested-curve-inner h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      gap: 20px;
+      padding: 32px;
+      border-radius: 28px;
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    /* Only the text is clipped; the button sits outside the clipped box so its glow can spill */
+    .safety-zone-parent .promo-text {
+      overflow: hidden;
+      white-space: nowrap;
+      text-overflow: ellipsis;
+      font-size: 2rem;
+      font-weight: bold;
+      line-height: 1.3;
+    }
+
+    .safety-zone-parent .promo-button {
+      align-self: flex-start;
+      margin-top: 0;
+      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.5), 0 0 28px 10px rgba(255, 255, 255, 0.9);
+    }
+
