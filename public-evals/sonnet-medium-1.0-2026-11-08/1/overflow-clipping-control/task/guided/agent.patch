@@ -134,8 +134,94 @@
     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 24px;
+      align-items: start;
+    }
+
+    .nested-curve-parent {
+      --radius: 24px;
+      --pad: 12px;
+      padding: var(--pad);
+      border-radius: var(--radius);
+      background: var(--primary);
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      /* Fallback: clips at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 220px;
+      object-fit: cover;
+      border-radius: calc(var(--radius) - var(--pad));
+    }
+
+    .nested-curve-footer {
+      padding: 16px;
+      background: var(--secondary);
+      color: var(--text);
+      border-radius: calc(var(--radius) - var(--pad));
+      margin-top: 4px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        /* Clip along the inner content-box curve */
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    .safety-zone-parent {
+      padding: 28px;
+      border-radius: 16px;
+      background: var(--primary);
+      color: white;
+      /* Fallback: clips overflow but truncates the glow */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .promo-text {
+      white-space: nowrap;
+      font-size: 1.25rem;
+    }
+
+    .glow-btn {
+      display: inline-block;
+      margin-top: 20px;
+      padding: 12px 24px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      text-decoration: none;
+      border-radius: 8px;
+      box-shadow: 0 0 18px 6px rgba(255, 171, 64, 0.7);
+    }
+
+    @supports (overflow-clip-margin: 24px) {
+      .safety-zone-parent {
+        overflow: clip;
+        /* Lets the button's glow extend past the clip edge */
+        overflow-clip-margin: 24px;
+      }
+    }
+
     footer {
