+  <script>
+    class DrinkCard extends HTMLElement {
+      static #sheet;
+
+      static get styles() {
+        if (!DrinkCard.#sheet) {
+          DrinkCard.#sheet = new CSSStyleSheet();
+          // Priority tiers: later layers win over earlier ones regardless of specificity.
+          DrinkCard.#sheet.replaceSync(`
+            @layer reset, base, variant, responsive;
+
+            @layer reset {
+              *, *::before, *::after { box-sizing: border-box; margin: 0; }
+            }
+
+            /* Theme tokens are inherited custom properties from the page :root,
+               with fallbacks matching the coffee theme. */
+            @layer base {
+              :host {
+                display: block;
+                container-type: inline-size;
+                container-name: drink-card;
+                --_bg: var(--card-bg, white);
+                --_pad: var(--card-padding, 20px);
+              }
+              .card {
+                background: var(--_bg);
+                color: var(--text, #3e2723);
+                padding: var(--_pad);
+                border-radius: 8px;
+                border-top: 4px solid transparent;
+                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+                text-align: center;
+                height: 100%;
+                display: flex;
+                flex-direction: column;
+                gap: 10px;
+              }
+              .title { color: var(--primary, #4e342e); }
+              .body { flex: 1; }
+            }
+
+            /* Outer styling driven by the host's attributes. */
+            @layer variant {
+              :host([variant="featured"]) {
+                --_bg: var(--primary, #4e342e);
+                --_pad: 28px;
+              }
+              :host([variant="featured"]) .card {
+                color: var(--light, #fafafa);
+                border-top-color: var(--accent, #ffab40);
+                box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
+              }
+              :host([variant="featured"]) .title { color: var(--secondary, #d7ccc8); }
+              :host([variant="compact"]) { --_pad: 12px; }
+              :host([variant="compact"]) .card { background: var(--secondary, #d7ccc8); }
+              :host(:hover) .card { border-top-color: var(--accent, #ffab40); }
+              :host([hidden]) { display: none; }
+            }
+
+            /* Layout responds to the card's own width, not the viewport. */
+            @layer responsive {
+              @container drink-card (min-width: 420px) {
+                .card {
+                  display: grid;
+                  grid-template-columns: 1fr auto;
+                  grid-template-areas: "badge badge" "title action" "body action";
+                  text-align: left;
+                  align-items: center;
+                  column-gap: 20px;
+                }
+                .badge { grid-area: badge; }
+                .title { grid-area: title; }
+                .body { grid-area: body; }
+                .action { grid-area: action; }
+              }
+              @container drink-card (max-width: 220px) {
+                .card { gap: 6px; }
+                .body { font-size: 0.85rem; }
+              }
+            }
+          `);
+        }
+        return DrinkCard.#sheet;
+      }
+
+      constructor() {
+        super();
+        const root = this.attachShadow({ mode: 'open' });
+        root.adoptedStyleSheets = [DrinkCard.styles];
+        root.innerHTML = `
+          <article class="card" part="card">
+            <div class="badge" part="badge"><slot name="badge"></slot></div>
+            <div class="title" part="title"><slot name="title">Drink</slot></div>
+            <div class="body" part="body"><slot></slot></div>
+            <div class="action" part="action"><slot name="action"></slot></div>
+          </article>`;
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
