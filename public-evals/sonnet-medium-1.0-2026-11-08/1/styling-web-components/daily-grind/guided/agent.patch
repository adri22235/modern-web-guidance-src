+  <script>
+    const cardSheet = new CSSStyleSheet();
+    cardSheet.replaceSync(`
+      /* Internal styles in priority tiers; later layers win over earlier ones.
+         Page overrides (custom properties, ::part, light DOM) sit outside. */
+      @layer reset, base, variant, state;
+
+      @layer reset {
+        :host { box-sizing: border-box; }
+        *, *::before, *::after { box-sizing: inherit; }
+      }
+
+      @layer base {
+        :host {
+          /* Private aliases read the site theme inherited across the boundary */
+          --_bg: var(--drink-card-bg, white);
+          --_fg: var(--drink-card-fg, var(--text, #3e2723));
+          --_heading: var(--drink-card-heading, var(--primary, #4e342e));
+          --_accent: var(--drink-card-accent, var(--secondary, #d7ccc8));
+          --_radius: var(--drink-card-radius, 8px);
+          --_pad: var(--drink-card-padding, 20px);
+          display: block;
+          container: drink-card / inline-size;
+          color: var(--_fg);
+          font-family: inherit;
+        }
+        .card {
+          display: flex;
+          flex-direction: column;
+          gap: 0.5rem;
+          height: 100%;
+          padding: var(--_pad);
+          background: var(--_bg);
+          border-radius: var(--_radius);
+          border-top: 4px solid var(--_accent);
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+        .badge { display: none; }
+        .body { flex: 1; }
+        .action { margin-top: auto; }
+        ::slotted([slot="title"]) { color: var(--_heading); }
+      }
+
+      /* Outer styling per variant, set on the host */
+      @layer variant {
+        :host([variant="featured"]) {
+          --_bg: var(--drink-card-bg, var(--light, #fafafa));
+          box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
+          border-radius: var(--_radius);
+        }
+        :host([variant="compact"]) {
+          --_pad: var(--drink-card-padding, 12px);
+          font-size: 0.9rem;
+        }
+        :host([hidden]) { display: none; }
+      }
+
+      @layer state {
+        :host(:hover), :host(:focus-within) {
+          transform: translateY(-2px);
+          transition: transform 0.2s;
+        }
+        @media (prefers-reduced-motion: reduce) {
+          :host(:hover), :host(:focus-within) { transform: none; }
+        }
+      }
+
+      /* Layouts respond to the card's own width */
+      @layer base {
+        @container drink-card (min-width: 24rem) {
+          .card {
+            display: grid;
+            grid-template-columns: 1fr auto;
+            grid-template-areas: "title action" "body action";
+            align-items: center;
+            text-align: start;
+            column-gap: 1.5rem;
+          }
+          .title { grid-area: title; }
+          .body { grid-area: body; }
+          .action { grid-area: action; margin-top: 0; }
+        }
+        @container drink-card (min-width: 16rem) {
+          .badge { display: inline-block; }
+        }
+      }
+    `);
+
+    const cardTemplate = document.createElement('template');
+    cardTemplate.innerHTML = `
+      <article class="card" part="card">
+        <div class="title" part="title">
+          <span class="badge" part="badge"><slot name="badge"></slot></span>
+          <slot name="title"></slot>
+        </div>
+        <div class="body" part="description"><slot></slot></div>
+        <div class="action" part="action"><slot name="action"></slot></div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [cardSheet];
+        this.shadowRoot.append(cardTemplate.content.cloneNode(true));
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
