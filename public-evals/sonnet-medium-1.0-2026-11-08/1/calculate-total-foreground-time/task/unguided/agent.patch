+  <script>
+    // Tracks time the page is in the foreground (tab visible and window focused).
+    (function () {
+      let total = 0;
+      let since = null;
+
+      function isForeground() {
+        return document.visibilityState === 'visible' && document.hasFocus();
+      }
+
+      function update() {
+        const now = performance.now();
+        if (isForeground()) {
+          if (since === null) since = now;
+        } else if (since !== null) {
+          total += now - since;
+          since = null;
+        }
+      }
+
+      ['visibilitychange', 'focus', 'blur', 'pagehide', 'pageshow'].forEach(function (evt) {
+        (evt === 'visibilitychange' ? document : window).addEventListener(evt, update);
+      });
+      update();
+
+      // Returns total foreground time in milliseconds.
+      window.getForegroundTime = function () {
+        return total + (since !== null ? performance.now() - since : 0);
+      };
+    })();
+  </script>
+
 </body>
 
