+
+  <script>
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      const polyfill = document.createElement('script');
+      polyfill.src = 'https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js';
+      document.head.append(polyfill);
+    }
+
+    const bar = document.querySelector('[role="menubar"]');
+    const triggers = [...bar.querySelectorAll(':scope > [commandfor]')];
+    const menuFor = trigger => document.getElementById(trigger.getAttribute('commandfor'));
+    const triggerFor = menu => triggers.find(trigger => menuFor(trigger) === menu);
+    const isOpen = menu => menu.matches(':popover-open');
+    const itemsOf = menu => [...menu.querySelectorAll('[focusgroup] > a')];
+    const enterOnOpen = new WeakSet();
+    let pointerTrigger = null;
+    let windowAway = false;
+
+    function closeAndRestore(menu, { fromPointer = false } = {}) {
+      triggerFor(menu).focus({ preventScroll: true, focusVisible: !fromPointer });
+      if (isOpen(menu)) menu.hidePopover();
+    }
+
+    function closeAll() {
+      triggers.map(menuFor).filter(isOpen).forEach(menu => menu.hidePopover());
+    }
+
+    function preview(trigger) {
+      const menu = menuFor(trigger);
+      if (!isOpen(menu)) menu.showPopover({ source: trigger });
+    }
+
+    // Left/Right always land on the adjacent trigger as a preview; ArrowDown then enters.
+    function moveToRootTrigger(from, direction) {
+      const next = triggers[(triggers.indexOf(from) + direction + triggers.length) % triggers.length];
+      triggers.forEach(trigger => { trigger.tabIndex = trigger === next ? 0 : -1; });
+      closeAll();
+      next.focus({ preventScroll: true });
+    }
+
+    function enter(trigger, last = false) {
+      const menu = menuFor(trigger);
+      if (!isOpen(menu)) preview(trigger);
+      const items = itemsOf(menu);
+      (last ? items.at(-1) : items[0])?.focus({ preventScroll: true });
+    }
+
+    // Without invoker commands, toggle the menu from script.
+    const hasInvokers = 'commandForElement' in HTMLButtonElement.prototype;
+
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+
+      trigger.addEventListener('pointerdown', event => {
+        event.preventDefault(); // Keep the click from moving focus.
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener('click', event => {
+        if (!hasInvokers) {
+          event.preventDefault();
+          if (isOpen(menu)) closeAndRestore(menu, { fromPointer: pointerTrigger === trigger });
+          else menu.showPopover({ source: trigger });
+        }
+        if (pointerTrigger !== trigger && event.detail === 0 && !isOpen(menu)) enterOnOpen.add(menu);
+        pointerTrigger = null;
+      });
+
+      trigger.addEventListener('focus', event => {
+        if (windowAway || menu.contains(event.relatedTarget)) return;
+        preview(trigger);
+      });
+
+      trigger.addEventListener('blur', event => {
+        if (menu.contains(event.relatedTarget)) return;
+        if (isOpen(menu)) menu.hidePopover();
+      });
+
+      trigger.addEventListener('pointerenter', () => {
+        const otherOpen = triggers.some(other => other !== trigger && isOpen(menuFor(other)));
+        if (!otherOpen) return;
+        closeAll();
+        trigger.focus({ preventScroll: true, focusVisible: false });
+      });
+
+      trigger.addEventListener('keydown', event => {
+        const keys = { ArrowLeft: -1, ArrowRight: 1 };
+        if (event.key in keys) {
+          event.preventDefault();
+          moveToRootTrigger(trigger, keys[event.key]);
+        } else if (event.key === 'ArrowDown') {
+          event.preventDefault();
+          enter(trigger);
+        } else if (event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          enter(trigger, event.key === 'End');
+        }
+      });
+
+      menu.addEventListener('toggle', event => {
+        const opened = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', opened);
+        if (!opened) return;
+        if (!CSS.supports('position-area: block-end')) placeBelow(menu, trigger);
+        if (enterOnOpen.delete(menu)) itemsOf(menu)[0]?.focus({ preventScroll: true });
+      });
+
+      menu.addEventListener('keydown', event => {
+        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+          event.preventDefault();
+          moveToRootTrigger(trigger, event.key === 'ArrowLeft' ? -1 : 1);
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          closeAndRestore(menu);
+        } else if (event.key === 'Tab') {
+          // Leave the bar: park focus on the trigger so Tab continues past it.
+          trigger.focus({ preventScroll: true });
+          closeAll();
+        }
+      });
+
+      menu.addEventListener('pointermove', event => {
+        const item = event.target.closest('a');
+        if (item && item !== document.activeElement) item.focus({ preventScroll: true, focusVisible: false });
+      });
+
+      menu.addEventListener('click', event => {
+        if (event.target.closest('a')) closeAll();
+      });
+    });
+
+    function placeBelow(menu, trigger) {
+      const rect = trigger.getBoundingClientRect();
+      Object.assign(menu.style, { position: 'fixed', inset: 'auto', margin: '0', top: `${rect.bottom}px` });
+      const left = Math.min(rect.left, innerWidth - menu.offsetWidth);
+      menu.style.left = `${Math.max(0, left)}px`;
+    }
+
+    // Focus landing outside the bar closes every menu.
+    document.addEventListener('focusin', event => {
+      if (!bar.contains(event.target)) closeAll();
+    });
+
+    addEventListener('blur', () => { windowAway = true; });
+    addEventListener('focus', () => setTimeout(() => { windowAway = false; }));
+
+    // Unsupported focusgroup: Up, Down, Home and End between a menu's own items.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.setAttribute('role', 'menu');
+        group.querySelectorAll('a').forEach(item => item.setAttribute('role', 'menuitem'));
+        group.addEventListener('keydown', event => {
+          if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+          const items = itemsOf(group.parentElement);
+          const current = items.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+            (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+          event.preventDefault();
+          items[next].focus({ preventScroll: true });
+        });
+      });
+    }
+  </script>
