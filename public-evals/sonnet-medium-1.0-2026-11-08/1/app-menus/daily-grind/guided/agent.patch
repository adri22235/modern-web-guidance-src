+    /* Application menu bar: one continuous strip, one Tab stop */
+    [role="menubar"] {
+      display: flex;
+      margin-inline-start: 2rem;
+    }
+
+    [role="menubar"] > button {
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: none;
+      border: 0;
+      padding: 0.4rem 1rem;
+      cursor: pointer;
+    }
+
+    [role="menubar"] > button:hover,
+    [role="menubar"] > button[aria-expanded="true"] {
+      background: rgb(255 255 255 / 0.15);
+      color: var(--accent);
+    }
+
+    [role="menubar"] > button:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
+    [popover]:has(> [focusgroup~="menu"]) {
+      margin: 0;
+      padding: 0.25rem 0;
+      min-inline-size: 12rem;
+      color: white;
+      background: var(--primary);
+      border: 1px solid rgb(255 255 255 / 0.2);
+      border-radius: 0 0 6px 6px;
+      box-shadow: 0 8px 20px rgb(0 0 0 / 0.3);
+      inset: auto;
+    }
+
+    @supports (position-area: block-end) {
+      [popover]:has(> [focusgroup~="menu"]) {
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    [focusgroup~="menu"] > a {
+      display: block;
+      padding: 0.5rem 1rem;
+      white-space: nowrap;
+    }
+
+    [focusgroup~="menu"] > a:hover,
+    [focusgroup~="menu"] > a:focus-visible {
+      background: rgb(255 255 255 / 0.15);
+      color: var(--accent);
+      outline: none;
+    }
+
+    [focusgroup~="menu"] > hr {
+      border: 0;
+      border-top: 1px solid rgb(255 255 255 / 0.2);
+      margin: 0.25rem 0;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover]:has(> [focusgroup~="menu"]) {
+        opacity: 0;
+        translate: 0 -0.25rem;
+        transition: opacity, translate, display, overlay;
+        transition-duration: 0.15s;
+        transition-behavior: allow-discrete;
+      }
+
+      [popover]:has(> [focusgroup~="menu"]):popover-open {
+        opacity: 1;
+        translate: 0 0;
+        transition-duration: 0.1s;
+
+        @starting-style {
+          opacity: 0;
+          translate: 0 -0.25rem;
+        }
+      }
+
+      /* Switching between open menus is instant, as in native menubars */
+      [role="menubar"]:has(> [popover]:popover-open) > [popover] {
+        transition: none;
+      }
+    }
