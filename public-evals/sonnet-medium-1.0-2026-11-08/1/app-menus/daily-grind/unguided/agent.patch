+  <script>
+    // Roving tabindex + arrow-key navigation for the application menu bar
+    (function () {
+      var items = Array.prototype.slice.call(document.querySelectorAll('.menubar [role="menuitem"]'));
+      var path = location.pathname;
+      items.forEach(function (el, i) {
+        if (path === el.getAttribute('href') || path.indexOf(el.getAttribute('href') + '/') === 0) {
+          el.setAttribute('aria-current', 'page');
+        }
+        el.tabIndex = i === 0 ? 0 : -1;
+        el.addEventListener('keydown', function (e) {
+          var n = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: items.length - 1 }[e.key];
+          if (n === undefined) return;
+          e.preventDefault();
+          var t = items[(n + items.length) % items.length];
+          items.forEach(function (x) { x.tabIndex = -1; });
+          t.tabIndex = 0;
+          t.focus();
+        });
+      });
+    })();
+  </script>
