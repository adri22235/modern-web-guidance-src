new file mode 100644
index 0000000..e18b4b4
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,38 @@
+import { useWebMCP } from 'use-webmcp-tool';
+
+const WORDS_PER_MINUTE = 230;
+
+// Renders nothing; registers client-side utilities for the article on screen.
+export default function ArticleTools() {
+  useWebMCP({
+    name: 'get-article-info',
+    description: 'Get the title, author, headings, word count and estimated reading time of the article being read.',
+    annotations: { readOnlyHint: true },
+    execute: () => {
+      const body = document.querySelector<HTMLElement>('article .prose');
+      if (!body) {
+        return { error: 'No article is open on this page.' };
+      }
+      const wordCount = (body.textContent ?? '').split(/\s+/).filter(Boolean).length;
+      return {
+        title: document.querySelector('article h1')?.textContent?.trim(),
+        url: location.href,
+        wordCount,
+        readingMinutes: Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        headings: [...body.querySelectorAll('h2, h3')].map(heading => heading.textContent?.trim()),
+      };
+    },
+  });
+
+  useWebMCP({
+    name: 'get-article-text',
+    description: 'Get the full body text of the article being read.',
+    annotations: { readOnlyHint: true },
+    execute: () => {
+      const body = document.querySelector<HTMLElement>('article .prose');
+      return body ? { text: body.innerText.trim() } : { error: 'No article is open on this page.' };
+    },
+  });
+
+  return null;
+}
