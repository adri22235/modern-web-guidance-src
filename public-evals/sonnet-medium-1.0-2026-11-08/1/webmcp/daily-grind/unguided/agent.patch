+  <script>
+    (function () {
+      var MENU = {
+        'maple-oat-latte': { name: 'Maple Oat Latte', price: 5.25 },
+        'dark-roast-espresso': { name: 'Dark Roast Espresso', price: 3.5 },
+        'cold-brew': { name: 'Cold Brew', price: 4.75 }
+      };
+      var SIZES = { small: -0.5, medium: 0, large: 0.75 };
+      var order = [];
+
+      var listEl = document.getElementById('order-list');
+      var totalEl = document.getElementById('order-total');
+      var statusEl = document.getElementById('order-status');
+
+      function unitPrice(item) { return MENU[item.drink].price + SIZES[item.size]; }
+      function total() {
+        return order.reduce(function (t, i) { return t + unitPrice(i) * i.quantity; }, 0);
+      }
+      function snapshot() {
+        return {
+          items: order.map(function (i) {
+            return { drink: i.drink, name: MENU[i.drink].name, size: i.size, quantity: i.quantity,
+                     unitPrice: unitPrice(i) };
+          }),
+          total: Math.round(total() * 100) / 100
+        };
+      }
+      function say(msg) { statusEl.textContent = msg; }
+
+      function render() {
+        listEl.textContent = '';
+        order.forEach(function (item, idx) {
+          var li = document.createElement('li');
+          li.textContent = item.quantity + ' \u00d7 ' + item.size + ' ' + MENU[item.drink].name +
+            ' \u2014 $' + (unitPrice(item) * item.quantity).toFixed(2);
+          var rm = document.createElement('button');
+          rm.type = 'button';
+          rm.className = 'btn btn-secondary';
+          rm.textContent = 'Remove';
+          rm.addEventListener('click', function () { removeItem(idx); });
+          li.appendChild(rm);
+          listEl.appendChild(li);
+        });
+        if (!order.length) listEl.innerHTML = '<li>Your order is empty.</li>';
+        totalEl.textContent = '$' + total().toFixed(2);
+      }
+
+      function addItem(drink, size, quantity) {
+        if (!MENU[drink]) throw new Error('Unknown drink: ' + drink);
+        size = size || 'medium';
+        if (!(size in SIZES)) throw new Error('Unknown size: ' + size);
+        quantity = Math.floor(Number(quantity) || 1);
+        if (quantity < 1 || quantity > 10) throw new Error('Quantity must be between 1 and 10');
+        var existing = order.filter(function (i) { return i.drink === drink && i.size === size; })[0];
+        if (existing) existing.quantity = Math.min(10, existing.quantity + quantity);
+        else order.push({ drink: drink, size: size, quantity: quantity });
+        render();
+        say('Added ' + quantity + ' ' + size + ' ' + MENU[drink].name + '.');
+      }
+      function removeItem(idx) {
+        var removed = order.splice(idx, 1)[0];
+        render();
+        if (removed) say('Removed ' + MENU[removed.drink].name + '.');
+      }
+      function clearOrder() { order = []; render(); say('Order cleared.'); }
+      function placeOrder() {
+        if (!order.length) throw new Error('Your order is empty.');
+        var receipt = snapshot();
+        order = [];
+        render();
+        say('Order placed! Total: $' + receipt.total.toFixed(2));
+        return receipt;
+      }
+
+      document.querySelectorAll('.card[data-drink-id]').forEach(function (card) {
+        card.querySelector('.add-btn').addEventListener('click', function () {
+          try {
+            addItem(card.dataset.drinkId, card.querySelector('.size').value, card.querySelector('.qty').value);
+          } catch (e) { say(e.message); }
+        });
+      });
+      document.getElementById('clear-order-btn').addEventListener('click', clearOrder);
+      document.getElementById('place-order-btn').addEventListener('click', function () {
+        try { placeOrder(); } catch (e) { say(e.message); }
+      });
+      render();
+
+      // Expose ordering actions to browser AI agents via WebMCP.
+      function result(fn) {
+        return function (args) {
+          try {
+            var out = fn(args || {});
+            return { content: [{ type: 'text', text: JSON.stringify(out) }] };
+          } catch (e) {
+            return { isError: true, content: [{ type: 'text', text: e.message }] };
+          }
+        };
+      }
+      var drinkIds = Object.keys(MENU);
+      var tools = [
+        {
+          name: 'list_seasonal_drinks',
+          description: 'List the Seasonal Favorites drinks with base prices and available sizes.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: result(function () {
+            return { drinks: drinkIds.map(function (id) {
+              return { id: id, name: MENU[id].name, basePrice: MENU[id].price };
+            }), sizes: SIZES, note: 'Size values are price adjustments in USD relative to medium.' };
+          })
+        },
+        {
+          name: 'add_to_order',
+          description: 'Add a seasonal drink to the current coffee order.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: { type: 'string', enum: drinkIds, description: 'Drink id' },
+              size: { type: 'string', enum: Object.keys(SIZES), description: 'Cup size (default medium)' },
+              quantity: { type: 'integer', minimum: 1, maximum: 10, description: 'Number of drinks (default 1)' }
+            },
+            required: ['drink']
+          },
+          execute: result(function (a) { addItem(a.drink, a.size, a.quantity); return snapshot(); })
+        },
+        {
+          name: 'view_order',
+          description: 'View the current coffee order and its total.',
+          inputSchema: { type: 'object', properties: {} },
+          annotations: { readOnlyHint: true },
+          execute: result(snapshot)
+        },
+        {
+          name: 'remove_from_order',
+          description: 'Remove a line item from the order by its zero-based index (see view_order).',
+          inputSchema: {
+            type: 'object',
+            properties: { index: { type: 'integer', minimum: 0 } },
+            required: ['index']
+          },
+          execute: result(function (a) {
+            if (!order[a.index]) throw new Error('No order item at index ' + a.index);
+            removeItem(a.index);
+            return snapshot();
+          })
+        },
+        {
+          name: 'clear_order',
+          description: 'Remove all items from the current order.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: result(function () { clearOrder(); return snapshot(); })
+        },
+        {
+          name: 'place_order',
+          description: 'Place the current order. Returns a receipt and empties the order.',
+          inputSchema: { type: 'object', properties: {} },
+          execute: result(placeOrder)
+        }
+      ];
+
+      var mc = navigator.modelContext;
+      if (mc) {
+        if (typeof mc.registerTool === 'function') {
+          tools.forEach(function (t) { try { mc.registerTool(t); } catch (e) { console.warn(e); } });
+        } else if (typeof mc.provideContext === 'function') {
+          mc.provideContext({ tools: tools });
+        }
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
