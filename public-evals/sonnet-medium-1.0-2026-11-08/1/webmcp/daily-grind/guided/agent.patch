+  <script>
+    const MENU = {
+      'maple-oat-latte': { name: 'Maple Oat Latte', base: 5.25 },
+      'dark-roast-espresso': { name: 'Dark Roast Espresso', base: 3.5 },
+      'cold-brew': { name: 'Cold Brew', base: 4.5 },
+    };
+    const SIZES = { small: -0.5, medium: 0, large: 0.75 };
+    const MAX_PER_LINE = 10;
+
+    const order = [];
+    const money = (n) => `$${n.toFixed(2)}`;
+    const linePrice = (l) => (MENU[l.item].base + SIZES[l.size]) * l.quantity;
+    const orderTotal = () => order.reduce((sum, l) => sum + linePrice(l), 0);
+
+    function snapshot() {
+      return {
+        items: order.map((l) => ({
+          item: MENU[l.item].name, size: l.size, quantity: l.quantity, price: money(linePrice(l)),
+        })),
+        total: money(orderTotal()),
+      };
+    }
+
+    function render() {
+      const status = document.getElementById('order-status');
+      status.replaceChildren();
+      if (order.length === 0) {
+        const p = document.createElement('p');
+        p.textContent = 'Your order is empty.';
+        status.append(p);
+      } else {
+        const ul = document.createElement('ul');
+        for (const l of order) {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${l.quantity} × ${l.size} ${MENU[l.item].name}`;
+          const price = document.createElement('span');
+          price.textContent = money(linePrice(l));
+          li.append(label, price);
+          ul.append(li);
+        }
+        status.append(ul);
+      }
+      document.getElementById('order-total').textContent = money(orderTotal());
+    }
+
+    // Validates input, updates the order and UI; returns a result or { error }.
+    function addToOrder({ item, size = 'medium', quantity = 1 }) {
+      quantity = Number(quantity);
+      if (!MENU[item]) return { error: `Unknown item "${item}".`, availableItems: Object.keys(MENU) };
+      if (!(size in SIZES)) return { error: `Unknown size "${size}".`, availableSizes: Object.keys(SIZES) };
+      if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_PER_LINE) {
+        return { error: `Quantity must be a whole number from 1 to ${MAX_PER_LINE}.` };
+      }
+      const existing = order.find((l) => l.item === item && l.size === size);
+      if (existing) {
+        if (existing.quantity + quantity > MAX_PER_LINE) {
+          return { error: `An order line can hold at most ${MAX_PER_LINE} drinks.` };
+        }
+        existing.quantity += quantity;
+      } else {
+        order.push({ item, size, quantity });
+      }
+      render();
+      return { added: `${quantity} ${size} ${MENU[item].name}`, ...snapshot() };
+    }
+
+    function clearOrder() {
+      order.length = 0;
+      render();
+      return snapshot();
+    }
+
+    for (const form of document.querySelectorAll('.order-form')) {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const data = new FormData(form);
+        const result = addToOrder({
+          item: form.dataset.item,
+          size: data.get('size'),
+          quantity: data.get('quantity'),
+        });
+        if (event.agentInvoked) event.respondWith(Promise.resolve(result));
+      });
+    }
+
+    document.getElementById('clear-order').addEventListener('click', clearOrder);
+
+    // Expose the remaining ordering actions to browser AI agents (WebMCP).
+    // The add-to-order forms above are registered declaratively via toolname.
+    if ('modelContext' in document) {
+      document.modelContext.registerTool({
+        name: 'get-order',
+        description: 'Returns the current coffee order with line prices and the total.',
+        inputSchema: { type: 'object', properties: {} },
+        execute: () => snapshot(),
+        annotations: { readOnlyHint: true },
+      });
+
+      document.modelContext.registerTool({
+        name: 'clear-order',
+        description: 'Removes every drink from the current coffee order.',
+        inputSchema: { type: 'object', properties: {} },
+        execute: () => clearOrder(),
+      });
+    }
+  </script>
+
 </body>
 
