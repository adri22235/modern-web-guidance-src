+  <script>
+    /* Fallback for browsers without sibling-index()/sibling-count(); re-run if items change */
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const apply = () => {
+        document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb')
+          .forEach(el => {
+            const sibs = [...el.parentElement.children];
+            el.style.setProperty('--sibling-index', sibs.indexOf(el) + 1);
+            el.style.setProperty('--sibling-count', sibs.length);
+          });
+      };
+      apply();
+      new MutationObserver(apply).observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
