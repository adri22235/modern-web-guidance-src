+  <script>
+    // Fallback for browsers without sibling-index()/sibling-count()
+    if (!CSS.supports('order', 'sibling-index()')) {
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach(group => {
+        const items = [...group.children];
+        items.forEach((el, k) => el.style.cssText += `--i:${k + 1};--n:${items.length}`);
