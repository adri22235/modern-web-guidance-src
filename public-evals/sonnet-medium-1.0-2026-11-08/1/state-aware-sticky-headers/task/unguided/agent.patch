+  <script>
+    // Toggle .is-stuck when a sticky header has reached its stuck position below the nav.
+    (function () {
+      var headers = document.querySelectorAll('.sticky-header');
+      var nav = document.querySelector('nav');
+      function update() {
+        var top = nav.offsetHeight;
+        headers.forEach(function (h) {
+          var section = h.parentElement.getBoundingClientRect();
+          var stuck = h.getBoundingClientRect().top <= top + 0.5 &&
+            section.top < top && section.bottom > top;
+          h.classList.toggle('is-stuck', stuck);
+        });
+      }
+      window.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      update();
+    })();
+  </script>
