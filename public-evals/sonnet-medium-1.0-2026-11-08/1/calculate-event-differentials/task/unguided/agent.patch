+  <script>
+    // Dates are built with the local-time Date constructor, so they use the
+    // visitor's own time zone. Months are zero-based (2 = March).
+    // The promotion start date wasn't specified; December 1, 2025 is assumed.
+    (function () {
+      var start = new Date(2025, 11, 1, 0, 0, 0);
+      var end = new Date(2026, 2, 1, 0, 0, 0);
+      var MS_HOUR = 60 * 60 * 1000;
+      var MS_DAY = 24 * MS_HOUR;
+
+      function plural(n, word) {
+        return n + ' ' + word + (n === 1 ? '' : 's');
+      }
+
+      // Split a millisecond span into whole days and remaining whole hours.
+      function format(ms) {
+        var days = Math.floor(ms / MS_DAY);
+        var hours = Math.floor((ms % MS_DAY) / MS_HOUR);
+        return plural(days, 'day') + ', ' + plural(hours, 'hour');
+      }
+
+      var remainingEl = document.getElementById('maple-remaining');
+      var elapsedEl = document.getElementById('maple-elapsed');
+      var now = new Date();
+
+      if (now >= end) {
+        remainingEl.textContent = 'This offer has ended';
+        elapsedEl.textContent = 'It ran for ' + format(end - start) + '.';
+      } else if (now < start) {
+        remainingEl.textContent = 'Starts in ' + format(start - now);
+        elapsedEl.textContent = '';
+      } else {
+        remainingEl.textContent = format(end - now) + ' left';
+        elapsedEl.textContent = format(now - start) + ' since the promotion began';
+      }
+    })();
+  </script>
+
