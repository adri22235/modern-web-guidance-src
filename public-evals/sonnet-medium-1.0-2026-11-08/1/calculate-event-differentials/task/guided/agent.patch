+  <script type="module">
+    // Maple Oat Latte promotion window, in the visitor's local time zone.
+    const PROMO_START = '2025-12-01'; // assumed start: midnight, Dec 1, 2025
+    const PROMO_END = '2026-03-01';   // offer ends at midnight, March 1, 2026
+
+    // Temporal is not in Safari yet, so load a polyfill when it's missing.
+    if (typeof Temporal === 'undefined') {
+      const { Temporal: T } = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = T;
+    }
+
+    const tz = Temporal.Now.timeZoneId();
+    const atMidnight = (date) =>
+      Temporal.PlainDate.from(date).toZonedDateTime({ timeZone: tz, plainTime: '00:00' });
+    const start = atMidnight(PROMO_START);
+    const end = atMidnight(PROMO_END);
+    const now = Temporal.Now.zonedDateTimeISO(tz);
+
+    // Days and hours only; DST-safe because ZonedDateTime handles day length.
+    const span = { largestUnit: 'day', smallestUnit: 'hour' };
+    const fmt = (d) => d.toLocaleString(undefined, { style: 'long' });
+
+    const remainingEl = document.getElementById('maple-remaining');
+    const elapsedEl = document.getElementById('maple-elapsed');
+    const timer = document.getElementById('maple-timer');
+
+    const remaining = now.until(end, span);
+    const ended = remaining.sign <= 0;
+    const notStarted = Temporal.ZonedDateTime.compare(now, start) < 0;
+
+    if (ended) {
+      timer.dataset.state = 'ended';
+      remainingEl.textContent = 'This offer has ended';
+      elapsedEl.textContent = `It ran for ${fmt(end.since(start, span))}.`;
+    } else if (notStarted) {
+      remainingEl.textContent = `${fmt(now.until(end, span))} left`;
+      elapsedEl.textContent = `Starts in ${fmt(now.until(start, span))}.`;
+    } else {
+      remainingEl.textContent = `${fmt(remaining)} left`;
+      elapsedEl.textContent = `Started ${fmt(now.since(start, span))} ago.`;
+    }
+    timer.hidden = false;
+  </script>
 </body>
 
