+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    // Enter sends; Shift+Enter inserts a newline. Ignore Enter that confirms IME composition.
+    feedbackMessage.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        if (event.isComposing || event.keyCode === 229) {
+          return;
+        }
+        feedbackForm.requestSubmit();
+      }
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // No backend yet: acknowledge the submission locally.
+      feedbackForm.reset();
+      feedbackStatus.textContent = 'Thanks for your feedback!';
+    });
+  </script>
+
