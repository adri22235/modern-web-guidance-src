+  <script>
+    (function () {
+      var panel = document.querySelector('.seasonal-panel');
+      var links = Array.prototype.slice.call(document.querySelectorAll('.toc-sidebar a'));
+      var sections = Array.prototype.slice.call(panel.querySelectorAll('.drink-section'));
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setActive(id) {
+        links.forEach(function (a) {
+          var on = a.getAttribute('href') === '#' + id;
+          a.classList.toggle('active', on);
+          if (on) a.setAttribute('aria-current', 'true');
+          else a.removeAttribute('aria-current');
+        });
+        sections.forEach(function (sec) {
+          sec.setAttribute('aria-current', sec.id === id ? 'true' : 'false');
+        });
+      }
+
+      function settledSection() {
+        var top = panel.getBoundingClientRect().top;
+        var best = sections[0], bestDist = Infinity;
+        sections.forEach(function (sec) {
+          var d = Math.abs(sec.getBoundingClientRect().top - top);
+          if (d < bestDist) { best = sec; bestDist = d; }
+        });
+        return best;
+      }
+
+      function update() { setActive(settledSection().id); }
+
+      // Highlight once scrolling settles (scrollend, with debounce fallback).
+      var timer;
+      if ('onscrollend' in window) {
+        panel.addEventListener('scrollend', update);
+      } else {
+        panel.addEventListener('scroll', function () {
+          clearTimeout(timer);
+          timer = setTimeout(update, 120);
+        }, { passive: true });
+      }
+
+      links.forEach(function (a) {
+        a.addEventListener('click', function (e) {
+          var target = document.getElementById(a.getAttribute('href').slice(1));
+          if (!target) return;
+          e.preventDefault();
+          setActive(target.id);
+          panel.scrollTo({
+            top: target.offsetTop - panel.offsetTop,
+            behavior: reduceMotion.matches ? 'auto' : 'smooth'
+          });
+        });
+      });
+
+      update();
+    })();
+  </script>
+
