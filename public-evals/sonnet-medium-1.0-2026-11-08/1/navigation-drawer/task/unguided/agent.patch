+  <script>
+    (function () {
+      var btn = document.getElementById('menu-btn');
+      var drawer = document.getElementById('drawer');
+      var overlay = document.getElementById('drawer-overlay');
+      var closeBtn = document.getElementById('drawer-close');
+      var body = document.body;
+
+      function isOpen() { return body.classList.contains('drawer-open'); }
+
+      function open() {
+        body.classList.add('drawer-open');
+        btn.setAttribute('aria-expanded', 'true');
+        closeBtn.focus();
+      }
+
+      function close(restoreFocus) {
+        if (!isOpen()) return;
+        body.classList.remove('drawer-open');
+        btn.setAttribute('aria-expanded', 'false');
+        if (restoreFocus !== false) btn.focus();
+      }
+
+      btn.addEventListener('click', open);
+      closeBtn.addEventListener('click', close);
+      overlay.addEventListener('click', close);
+      drawer.addEventListener('click', function (e) {
+        if (e.target.closest('a')) close(false);
+      });
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') close();
+      });
+
+      // Swipe right (toward the edge the drawer is docked to) to dismiss
+      var startX = 0, startY = 0, dx = 0, tracking = false, swiping = false;
+
+      drawer.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'mouse') return;
+        tracking = true; swiping = false; dx = 0;
+        startX = e.clientX; startY = e.clientY;
+      });
+
+      drawer.addEventListener('pointermove', function (e) {
+        if (!tracking) return;
+        var mx = e.clientX - startX, my = e.clientY - startY;
+        if (!swiping) {
+          if (Math.abs(mx) > 10 && Math.abs(mx) > Math.abs(my)) {
+            swiping = true;
+            drawer.classList.add('dragging');
+            drawer.setPointerCapture(e.pointerId);
+          } else if (Math.abs(my) > 10) {
+            tracking = false;
+            return;
+          }
+        }
+        if (swiping) {
+          dx = Math.max(0, mx);
+          drawer.style.transform = 'translateX(' + dx + 'px)';
+          overlay.style.opacity = 1 - dx / drawer.offsetWidth;
+        }
+      });
+
+      function endSwipe() {
+        if (!tracking) return;
+        tracking = false;
+        if (!swiping) return;
+        swiping = false;
+        var shouldClose = dx > drawer.offsetWidth * 0.3;
+        drawer.classList.remove('dragging');
+        drawer.style.transform = '';
+        overlay.style.opacity = '';
+        if (shouldClose) close();
+      }
+
+      drawer.addEventListener('pointerup', endSwipe);
+      drawer.addEventListener('pointercancel', endSwipe);
+    })();
+  </script>
