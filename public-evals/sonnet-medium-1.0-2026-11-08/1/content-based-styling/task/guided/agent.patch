+    /* Cards with an image switch to a side-by-side layout */
+    .card:has(> img) {
+      grid-column: 1 / -1;
+      container-type: inline-size;
+      display: grid;
+      grid-template-columns: 1fr;
+      gap: 20px;
+      align-items: center;
+    }
+
+    .card > img {
+      width: 100%;
+      height: 100%;
+      max-height: 260px;
+      object-fit: cover;
+      border-radius: 6px;
+    }
+
+    @media (min-width: 600px) {
+      .card:has(> img) {
+        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
+        text-align: left;
+      }
+
+      .card:has(> img) > img {
+        max-height: none;
+        aspect-ratio: 4 / 3;
+      }
+    }
