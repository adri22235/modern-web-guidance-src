--- a/index.html
+++ b/index.html
@@ -300,7 +300,43 @@
     regenBtn.addEventListener('click', renderCards);
 
 
   </script>
+  <script type="module">
+    import { onCLS, onINP, onLCP } from 'https://unpkg.com/web-vitals@4?module';
+
+    const ENDPOINT = '/path/to/analytics/endpoint';
+    // Keep only the latest value per metric; values keep updating during the visit.
+    const pending = new Map();
+
+    function flush() {
+      if (!pending.size) return;
+      const body = JSON.stringify({
+        page: location.href,
+        metrics: [...pending.values()],
+      });
+      pending.clear();
+      // sendBeacon survives page teardown; fall back to keepalive fetch.
+      if (!(navigator.sendBeacon && navigator.sendBeacon(ENDPOINT, body))) {
+        fetch(ENDPOINT, { method: 'POST', body, keepalive: true }).catch(() => { });
+      }
+    }
+
+    function record({ name, value, rating, delta, id, navigationType }) {
+      pending.set(name, { name, value, rating, delta, id, navigationType });
+    }
+
+    onCLS(record);
+    onINP(record);
+    onLCP(record);
+
+    // visibilitychange (hidden) is the reliable end-of-visit signal and is bfcache-safe.
+    // It fires on tab close, navigation away, and tab switch; web-vitals reports
+    // final values on that same event. Registered after the metrics so their
+    // callbacks run first. Pages restored from bfcache are re-measured by web-vitals.
+    document.addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'hidden') flush();
+    });
+  </script>
 </body>
 
 </html>
