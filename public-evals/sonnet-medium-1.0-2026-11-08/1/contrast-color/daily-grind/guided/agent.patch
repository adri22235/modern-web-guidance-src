@@ -12,6 +12,29 @@
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --primary-hover: color-mix(in srgb, var(--primary) 75%, black);
+
+      /* Readable foreground for each themed background (fallback: relative color syntax) */
+      --contrast-threshold: 0.623;
+      --on-primary: white;
+      --on-primary-hover: white;
+      --on-secondary: black;
+    }
+
+    @supports (color: oklch(from red l c h)) {
+      :root {
+        --on-primary: oklch(from var(--primary) max(0, sign(var(--contrast-threshold) - l)) 0 h);
+        --on-primary-hover: oklch(from var(--primary-hover) max(0, sign(var(--contrast-threshold) - l)) 0 h);
+        --on-secondary: oklch(from var(--secondary) max(0, sign(var(--contrast-threshold) - l)) 0 h);
+      }
+    }
+
+    @supports (color: contrast-color(red)) {
+      :root {
+        --on-primary: contrast-color(var(--primary));
+        --on-primary-hover: contrast-color(var(--primary-hover));
+        --on-secondary: contrast-color(var(--secondary));
+      }
     }
 
