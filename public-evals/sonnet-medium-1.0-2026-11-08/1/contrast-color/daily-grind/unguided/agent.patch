       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      /* Fallbacks for browsers without relative color syntax */
+      --on-primary: #fff;
+      --on-secondary: #1b0f0c;
+    }
+
+    /* Pick black or white text based on the perceived lightness of the
+       background so contrast holds when --primary / --secondary change. */
+    @supports (color: oklch(from red l c h)) {
+      :root {
+        --on-primary: oklch(from var(--primary) clamp(0, (0.65 - l) * 1000, 1) 0 0);
