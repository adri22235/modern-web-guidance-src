index 0000000..6edbe2f
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,77 @@
+import { buttonSheet, template } from './shared.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--card-bg, white);
+    --_fg: var(--card-fg, inherit);
+    --_title: var(--card-title-color, var(--primary, #4e342e));
+    display: block;
+  }
+  article {
+    height: 100%;
+    background: var(--_bg);
+    color: var(--_fg);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+  }
+  ::slotted([slot="title"]) { margin-bottom: 10px; color: var(--_title); }
+  ::slotted(p) { margin: 0; }
+`);
+
+const tpl = template(`
+  <article>
+    <slot name="title"></slot>
+    <slot></slot>
+    <a class="btn" part="link"></a>
+  </article>
+`);
+
+/**
+ * <coffee-card href="/menu/cold-brew" cta="View Details">
+ *   <h3 slot="title">Cold Brew</h3>
+ *   <p>Steeped for 18 hours.</p>
+ * </coffee-card>
+ *
+ * The title heading stays in light DOM (consumer picks the level). The inner
+ * link gets an accessible name combining the CTA and the title, so repeated
+ * "View Details" links are distinguishable. Theme via --card-bg, --card-fg,
+ * --card-title-color, or ::part(link).
+ */
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'cta'];
+  #link;
+  #titleSlot;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.adoptedStyleSheets = [buttonSheet, sheet];
+    root.append(tpl.content.cloneNode(true));
+    this.#link = root.querySelector('a');
+    this.#titleSlot = root.querySelector('slot[name="title"]');
+    this.#titleSlot.addEventListener('slotchange', () => this.#sync());
+  }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { this.setAttribute('href', v); }
+  get cta() { return this.getAttribute('cta') || 'View Details'; }
+  set cta(v) { v ? this.setAttribute('cta', v) : this.removeAttribute('cta'); }
+
+  connectedCallback() { this.#sync(); }
+  attributeChangedCallback(_n, oldVal, newVal) { if (oldVal !== newVal) this.#sync(); }
+
+  #sync() {
+    const link = this.#link;
+    link.textContent = this.cta;
+    link.toggleAttribute('href', this.hasAttribute('href'));
+    if (this.hasAttribute('href')) link.href = this.href;
+    const title = this.#titleSlot.assignedElements()[0]?.textContent.trim();
+    if (title) link.setAttribute('aria-label', `${this.cta}: ${title}`);
+    else link.removeAttribute('aria-label');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/components/dg-button.js b/components/dg-button.js
new file mode 100644
index 0000000..27b5550
--- /dev/null
+++ b/components/dg-button.js
@@ -0,0 +1,38 @@
+import { buttonSheet, template } from './shared.js';
+
+const tpl = template(`<a class="btn" part="link"><slot></slot></a>`);
+
+/**
+ * <dg-button href="/order-online">Order Now</dg-button>
+ * Wraps a real <a>, so link semantics, focus and activation stay native.
+ * Optional `label` attribute overrides the accessible name.
+ */
+class DgButton extends HTMLElement {
+  static observedAttributes = ['href', 'label'];
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.adoptedStyleSheets = [buttonSheet];
+    root.append(tpl.content.cloneNode(true));
+    this.#link = root.querySelector('a');
+  }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { this.setAttribute('href', v); }
+  get label() { return this.getAttribute('label') ?? ''; }
+  set label(v) { v ? this.setAttribute('label', v) : this.removeAttribute('label'); }
+
+  connectedCallback() { this.#sync(); }
+  attributeChangedCallback() { this.#sync(); }
+
+  #sync() {
+    this.#link.toggleAttribute('href', this.hasAttribute('href'));
+    if (this.hasAttribute('href')) this.#link.href = this.href;
+    if (this.label) this.#link.setAttribute('aria-label', this.label);
+    else this.#link.removeAttribute('aria-label');
+  }
+}
+
+customElements.define('dg-button', DgButton);
diff --git a/components/dg-hero.js b/components/dg-hero.js
new file mode 100644
index 0000000..2aa233c
--- /dev/null
+++ b/components/dg-hero.js
@@ -0,0 +1,52 @@
+import { template } from './shared.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host { display: block; }
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      var(--_image, none);
+    background-size: cover;
+    background-position: center;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 0 20px;
+  }
+  ::slotted(h1) { font-size: clamp(2rem, 6vw, 3rem); margin-bottom: 1rem; }
+`);
+
+const tpl = template(`<header><slot></slot></header>`);
+
+/**
+ * <dg-hero image="https://..."> <h1>…</h1> <p>…</p> <dg-button>…</dg-button> </dg-hero>
+ */
+class DgHero extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(tpl.content.cloneNode(true));
+  }
+
+  get image() { return this.getAttribute('image') ?? ''; }
+  set image(v) { this.setAttribute('image', v); }
+
+  connectedCallback() { this.#sync(); }
+  attributeChangedCallback() { this.#sync(); }
+
+  #sync() {
+    // Quote and escape so the URL can't break out of url("...").
+    const url = this.image.replace(/["\\]/g, '\\$&');
+    if (url) this.style.setProperty('--_image', `url("${url}")`);
+    else this.style.removeProperty('--_image');
+  }
+}
+
+customElements.define('dg-hero', DgHero);
diff --git a/components/dg-section.js b/components/dg-section.js
new file mode 100644
index 0000000..fb19b26
--- /dev/null
+++ b/components/dg-section.js
@@ -0,0 +1,50 @@
+import { template } from './shared.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host { display: block; }
+  h2 { text-align: center; }
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(var(--dg-grid-min, 250px), 1fr));
+    gap: 20px;
+    margin-top: 20px;
+  }
+`);
+
+const tpl = template(`
+  <section>
+    <h2 part="heading"></h2>
+    <div class="grid"><slot></slot></div>
+  </section>
+`);
+
+let uid = 0;
+
+/**
+ * <dg-section heading="Seasonal Favorites"> ...cards... </dg-section>
+ * Renders a labelled region (<section> named by its own <h2>, both inside
+ * the shadow tree so aria-labelledby resolves) with a responsive grid.
+ */
+class DgSection extends HTMLElement {
+  static observedAttributes = ['heading'];
+  #h2;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(tpl.content.cloneNode(true));
+    this.#h2 = root.querySelector('h2');
+    this.#h2.id = `dg-section-${++uid}`;
+    root.querySelector('section').setAttribute('aria-labelledby', this.#h2.id);
+  }
+
+  get heading() { return this.getAttribute('heading') ?? ''; }
+  set heading(v) { this.setAttribute('heading', v); }
+
+  connectedCallback() { this.#h2.textContent = this.heading; }
+  attributeChangedCallback() { this.#h2.textContent = this.heading; }
+}
+
+customElements.define('dg-section', DgSection);
