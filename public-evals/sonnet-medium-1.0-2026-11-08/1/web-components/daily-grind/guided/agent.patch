diff --git a/components/shared.js b/components/shared.js
new file mode 100644
index 0000000..c53d6a4
--- /dev/null
+++ b/components/shared.js
@@ -0,0 +1,24 @@
+// Shared constructed stylesheets, adopted by every component instance.
+export const buttonSheet = new CSSStyleSheet();
+buttonSheet.replaceSync(`
+  .btn {
+    display: inline-block;
+    background: var(--dg-btn-bg, var(--primary, #4e342e));
+    color: var(--dg-btn-fg, white);
+    font: inherit;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+  .btn:hover { background: var(--dg-btn-bg-hover, #3e2723); }
+  .btn:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+  @media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
+`);
+
+export function template(html) {
+  const t = document.createElement('template');
+  t.innerHTML = html;
+  return t;
+}
