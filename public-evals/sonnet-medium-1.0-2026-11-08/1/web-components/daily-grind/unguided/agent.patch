@@ -0,0 +1,60 @@
+import { tokensSheet, createSheet } from './tokens.js';
+
+const sheet = createSheet(`
+  :host { display: block; }
+  article {
+    height: 100%;
+    background: #fff;
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+  }
+  .title { margin-bottom: 10px; color: var(--_primary); font-size: 1.17em; }
+`);
+
+/**
+ * <coffee-card name="Cold Brew" href="/menu/cold-brew" cta="View Details">
+ *   Steeped for 18 hours.
+ * </coffee-card>
+ *
+ * Attributes: name, href, cta (button label, default "View Details"),
+ * heading-level (2-6, default 3). Default slot holds the description, so
+ * content stays in the light DOM for crawlers and no-JS fallback.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'href', 'cta', 'heading-level'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).adoptedStyleSheets = [tokensSheet, sheet];
+    this.shadowRoot.innerHTML = `
+      <article part="card">
+        <div class="title" role="heading"></div>
+        <p part="description"><slot></slot></p>
+        <a class="btn" part="link"></a>
+      </article>`;
+    this._title = this.shadowRoot.querySelector('.title');
+    this._link = this.shadowRoot.querySelector('a');
+  }
+
+  connectedCallback() { this._render(); }
+  attributeChangedCallback() { this._render(); }
+
+  _render() {
+    const name = this.getAttribute('name') ?? '';
+    const level = Math.min(6, Math.max(2, parseInt(this.getAttribute('heading-level'), 10) || 3));
+    const cta = this.getAttribute('cta') || 'View Details';
+    this._title.setAttribute('aria-level', level);
+    this._title.textContent = name;
+    this._link.textContent = cta;
+    // Distinguish identical link labels for screen-reader link lists.
+    this._link.setAttribute('aria-label', name ? `${cta}: ${name}` : cta);
+    const href = this.getAttribute('href');
+    if (href) this._link.setAttribute('href', href);
+    else this._link.removeAttribute('href');
+    this._link.hidden = !href;
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
