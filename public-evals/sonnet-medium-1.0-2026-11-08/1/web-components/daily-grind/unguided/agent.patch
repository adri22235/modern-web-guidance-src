+import { tokensSheet, createSheet } from './tokens.js';
+
+const sheet = createSheet(`
+  :host { display: block; }
+  header {
+    min-height: 60vh;
+    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+      var(--hero-image, none) center / cover;
+    background-color: var(--_primary);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: #fff;
+    text-align: center;
+    padding: 0 20px;
+  }
+  h1 { font-size: 3rem; margin-bottom: 1rem; }
+`);
+
+/**
+ * <grind-hero heading="Wake Up Your Senses" cta-href="/order-online" cta="Order Now"
+ *   style="--hero-image: url(...)">Tagline text</grind-hero>
+ */
+export class GrindHero extends HTMLElement {
+  static observedAttributes = ['heading', 'cta', 'cta-href'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).adoptedStyleSheets = [tokensSheet, sheet];
+    this.shadowRoot.innerHTML = `
+      <header>
+        <h1></h1>
+        <p><slot></slot></p>
+        <a class="btn"></a>
+      </header>`;
+    this._h = this.shadowRoot.querySelector('h1');
+    this._a = this.shadowRoot.querySelector('a');
+  }
+
+  connectedCallback() { this._render(); }
+  attributeChangedCallback() { this._render(); }
+
+  _render() {
+    this._h.textContent = this.getAttribute('heading') ?? '';
+    this._a.textContent = this.getAttribute('cta') ?? '';
+    const href = this.getAttribute('cta-href');
+    if (href) this._a.href = href; else this._a.removeAttribute('href');
+    this._a.hidden = !href;
+  }
+}
+
+customElements.define('grind-hero', GrindHero);
diff --git a/components/grind-nav.js b/components/grind-nav.js
new file mode 100644
index 0000000..d9c3db1
--- /dev/null
+++ b/components/grind-nav.js
@@ -0,0 +1,93 @@
+import { tokensSheet, createSheet } from './tokens.js';
+
+const sheet = createSheet(`
+  :host { display: block; position: sticky; top: 0; z-index: 1000; }
+  nav {
+    background: var(--_primary);
+    color: #fff;
+    padding: 1rem 5%;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    flex-wrap: wrap;
+  }
+  .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  ul { display: flex; list-style: none; }
+  li { margin-left: 20px; }
+  a { color: #fff; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
+  a:hover { color: var(--_accent); }
+  a.outline { border: 1px solid var(--_accent); padding: 5px 12px; border-radius: 4px; }
+  a[aria-current="page"] { text-decoration: underline; }
+  button {
+    display: none;
+    background: none;
+    border: 1px solid var(--_accent);
+    color: #fff;
+    padding: 6px 12px;
+    border-radius: 4px;
+    font: inherit;
+    cursor: pointer;
+  }
+  @media (max-width: 640px) {
+    button { display: block; }
+    ul { display: none; flex-direction: column; width: 100%; padding-top: 1rem; gap: 12px; }
+    li { margin-left: 0; }
+    :host([open]) ul { display: flex; }
+  }
+`);
+
+/**
+ * <grind-nav brand="THE DAILY GRIND" label="Main">
+ *   <a href="/menu">Menu</a>
+ *   <a href="/logout" data-variant="outline">Logout</a>
+ * </grind-nav>
+ *
+ * Child anchors are rendered as list items inside a <nav> landmark. On narrow
+ * screens a toggle button (aria-expanded) shows/hides the list; Escape closes it.
+ */
+export class GrindNav extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).adoptedStyleSheets = [tokensSheet, sheet];
+    this._onKey = (e) => { if (e.key === 'Escape' && this.open) { this.open = false; this._btn.focus(); } };
+  }
+
+  get open() { return this.hasAttribute('open'); }
+  set open(v) { this.toggleAttribute('open', Boolean(v)); }
+
+  connectedCallback() {
+    const links = [...this.querySelectorAll('a')];
+    const here = location.pathname;
+    this.shadowRoot.innerHTML = `
+      <nav aria-label="${this.getAttribute('label') || 'Main'}">
+        <div class="logo"></div>
+        <button type="button" aria-expanded="false" aria-controls="links">Menu</button>
+        <ul id="links"></ul>
+      </nav>`;
+    this.shadowRoot.querySelector('.logo').textContent = this.getAttribute('brand') || '';
+    const ul = this.shadowRoot.querySelector('ul');
+    for (const src of links) {
+      const li = document.createElement('li');
+      const a = document.createElement('a');
+      a.href = src.getAttribute('href');
+      a.textContent = src.textContent;
+      if (src.dataset.variant === 'outline') a.className = 'outline';
+      if (a.pathname === here) a.setAttribute('aria-current', 'page');
+      li.append(a);
+      ul.append(li);
+    }
+    this._btn = this.shadowRoot.querySelector('button');
+    this._btn.addEventListener('click', () => { this.open = !this.open; });
+    this.addEventListener('keydown', this._onKey);
+    this._sync();
+  }
+
+  disconnectedCallback() { this.removeEventListener('keydown', this._onKey); }
+
+  static observedAttributes = ['open'];
+  attributeChangedCallback() { this._sync(); }
+
+  _sync() { this._btn?.setAttribute('aria-expanded', String(this.open)); }
+}
+
+customElements.define('grind-nav', GrindNav);
