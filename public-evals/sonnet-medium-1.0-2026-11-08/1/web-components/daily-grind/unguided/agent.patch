+// Shared design tokens as a constructable stylesheet. CSS custom properties
+// inherit through shadow roots, so the page's :root values win when defined;
+// these fallbacks keep components usable standalone.
+export const tokensCSS = `
+  :host {
+    --_primary: var(--primary, #4e342e);
+    --_primary-dark: var(--primary-dark, #3e2723);
+    --_secondary: var(--secondary, #d7ccc8);
+    --_accent: var(--accent, #ffab40);
+    --_text: var(--text, #3e2723);
+    --_light: var(--light, #fafafa);
+    box-sizing: border-box;
+  }
+  *, *::before, *::after { box-sizing: inherit; margin: 0; padding: 0; }
+  :focus-visible { outline: 3px solid var(--_accent); outline-offset: 2px; }
+  .btn {
+    display: inline-block;
+    background: var(--_primary);
+    color: #fff;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+  .btn:hover { background: var(--_primary-dark); }
+  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
+`;
+
+export function createSheet(css) {
+  const sheet = new CSSStyleSheet();
+  sheet.replaceSync(css);
+  return sheet;
+}
+
+export const tokensSheet = createSheet(tokensCSS);
