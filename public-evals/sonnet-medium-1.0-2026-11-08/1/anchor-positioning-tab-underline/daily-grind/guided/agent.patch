     nav ul {
       display: flex;
       list-style: none;
+      position: relative;
+    }
+
+    /* Active indicator, tethered to the active item and transitioned between items */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active;
+      inset-block-start: calc(anchor(bottom) + 0.1lh);
+      inset-inline-start: anchor(left);
+      inset-inline-end: anchor(right);
+      border-block-end: 0.15lh solid var(--accent);
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: inset 0.3s ease;
+      }
+    }
+
+    nav ul li.active {
+      anchor-name: --active;
+    }
+
+    @supports not (position-anchor: auto) {
+      nav ul::before {
+        content: none;
+      }
+
+      nav ul li.active {
+        border-block-end: 0.15lh solid var(--accent);
+      }
     }
 
