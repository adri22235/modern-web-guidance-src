   </footer>
 
+  <script>
+    (function () {
+      var list = document.querySelector('nav ul');
+      var indicator = list.querySelector('.nav-indicator');
+      var links = list.querySelectorAll('a[data-nav]');
+      var current = null;
+
+      function moveTo(link) {
+        var left = link.getBoundingClientRect().left - list.getBoundingClientRect().left;
+        indicator.style.width = link.offsetWidth + 'px';
+        indicator.style.transform = 'translateX(' + left + 'px)';
+        indicator.style.opacity = '1';
+      }
+
+      function select(link) {
+        if (current) current.classList.remove('active');
+        link.classList.add('active');
+        current = link;
+        moveTo(link);
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          // Keep the page in place so the underline can animate between items.
+          e.preventDefault();
+          select(link);
+        });
+      });
+
+      window.addEventListener('resize', function () {
+        if (!current) return;
+        indicator.style.transition = 'none';
+        moveTo(current);
+        indicator.offsetWidth; // flush so the next move animates again
+        indicator.style.transition = '';
+      });
+    })();
+  </script>
+
 </body>
 
