+  <script>
+    // Fallback for browsers without Invoker Commands: wire the buttons manually.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[command]');
+        const dialog = btn && document.getElementById(btn.getAttribute('commandfor'));
+        if (!(dialog instanceof HTMLDialogElement)) return;
+        const cmd = btn.getAttribute('command');
+        if (cmd === 'show-modal') dialog.showModal();
+        else if (cmd === 'close') dialog.close();
+      });
+    }
+  </script>
