+  <dialog class="details-dialog" id="details-dialog" aria-labelledby="details-title" aria-describedby="details-desc">
+    <h2 id="details-title"></h2>
+    <p id="details-desc"></p>
+    <p class="meta" id="details-meta"></p>
+    <div class="dialog-actions">
+      <a class="btn" id="details-link" href="/menu">Full Menu Page</a>
+      <button type="button" class="btn secondary" id="details-close">Close</button>
+    </div>
+  </dialog>
+
+  <script>
+    (function () {
+      var dialog = document.getElementById('details-dialog');
+      if (!dialog || typeof dialog.showModal !== 'function') return; // links still work as plain navigation
+
+      var title = document.getElementById('details-title');
+      var desc = document.getElementById('details-desc');
+      var meta = document.getElementById('details-meta');
+      var link = document.getElementById('details-link');
+
+      document.querySelectorAll('[data-details]').forEach(function (trigger) {
+        trigger.addEventListener('click', function (e) {
+          e.preventDefault();
+          title.textContent = trigger.closest('.card').querySelector('h3').textContent;
+          desc.textContent = trigger.dataset.details;
+          meta.textContent = trigger.dataset.meta || '';
+          link.href = trigger.getAttribute('href');
+          dialog.showModal();
+        });
+      });
+
+      document.getElementById('details-close').addEventListener('click', function () {
+        dialog.close();
+      });
+
+      // Click on the backdrop (outside the dialog box) dismisses too.
+      dialog.addEventListener('click', function (e) {
+        if (e.target === dialog) dialog.close();
+      });
+      // Escape and the Android back gesture are handled natively by showModal().
+    })();
+  </script>
+
