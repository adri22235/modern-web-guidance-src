+  <script>
+    // On-device translation using the browser's built-in Translator API
+    // (Chrome 138+). Text never leaves the device; models are downloaded once.
+    (function () {
+      var SOURCE = 'en';
+      var select = document.getElementById('lang');
+      var wrapper = document.getElementById('lang-select');
+      var status = document.getElementById('lang-status');
+
+      if (!('Translator' in self)) {
+        return; // Unsupported browser: keep the selector hidden.
+      }
+      wrapper.hidden = false;
+
+      var nodes = Array.prototype.slice.call(document.querySelectorAll('[data-translate]'));
+      // Only text nodes are replaced, so child markup/attributes stay intact.
+      var originals = nodes.map(function (el) { return el.textContent; });
+      var translators = {};
+      var requestId = 0;
+
+      function getTranslator(lang) {
+        if (!translators[lang]) {
+          translators[lang] = Translator.availability({ sourceLanguage: SOURCE, targetLanguage: lang })
+            .then(function (availability) {
+              if (availability === 'unavailable') {
+                throw new Error('unsupported');
+              }
+              return Translator.create({
+                sourceLanguage: SOURCE,
+                targetLanguage: lang,
+                monitor: function (m) {
+                  m.addEventListener('downloadprogress', function (e) {
+                    status.textContent = 'Downloading language pack… ' + Math.round(e.loaded * 100) + '%';
+                  });
+                }
+              });
+            });
+          translators[lang].catch(function () { delete translators[lang]; });
+        }
+        return translators[lang];
+      }
+
+      function render(texts, lang) {
+        nodes.forEach(function (el, i) { el.textContent = texts[i]; });
+        document.documentElement.lang = lang;
+      }
+
+      select.addEventListener('change', function () {
+        var lang = select.value;
+        var id = ++requestId;
+
+        if (lang === SOURCE) {
+          render(originals, SOURCE);
+          status.textContent = '';
+          return;
+        }
+
+        status.textContent = 'Translating…';
+        select.disabled = true;
+        getTranslator(lang)
+          .then(function (translator) {
+            return Promise.all(originals.map(function (t) { return translator.translate(t); }));
+          })
+          .then(function (texts) {
+            if (id !== requestId) return;
+            render(texts, lang);
+            status.textContent = '';
+          })
+          .catch(function () {
+            if (id !== requestId) return;
+            select.value = document.documentElement.lang;
+            status.textContent = 'Sorry, that language isn\u2019t available for on-device translation.';
+          })
+          .then(function () { select.disabled = false; });
+      });
+    })();
+  </script>
