+  <script>
+    (() => {
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = [...document.querySelectorAll('[data-i18n]')];
+      const sourceLanguage = document.documentElement.lang || 'en';
+      const originals = new Map(nodes.map((el) => [el, el.textContent]));
+      const translators = new Map();
+      const rtl = new Set(['ar', 'he']);
+
+      if (!('Translator' in self)) {
+        status.textContent = 'On-device translation is not supported in this browser.';
+        return;
+      }
+      select.disabled = false;
+
+      async function getTranslator(targetLanguage) {
+        if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+        const options = { sourceLanguage, targetLanguage };
+        const availability = await Translator.availability(options);
+        if (availability === 'unavailable') throw new Error('unavailable');
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              status.textContent = `Downloading language pack… ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        translators.set(targetLanguage, translator);
+        return translator;
+      }
+
+      function setLanguage(lang) {
+        document.documentElement.lang = lang;
+        document.documentElement.dir = rtl.has(lang) ? 'rtl' : 'ltr';
+      }
+
+      let token = 0;
+      select.addEventListener('change', async () => {
+        const target = select.value;
+        const current = ++token;
+        if (target === sourceLanguage) {
+          nodes.forEach((el) => { el.textContent = originals.get(el); });
+          setLanguage(sourceLanguage);
+          status.textContent = '';
+          return;
+        }
+        select.disabled = true;
+        status.textContent = 'Translating…';
+        try {
+          const translator = await getTranslator(target);
+          const results = await Promise.all(nodes.map((el) => translator.translate(originals.get(el))));
+          if (current !== token) return;
+          nodes.forEach((el, i) => { el.textContent = results[i]; });
+          setLanguage(target);
+          status.textContent = '';
+        } catch (err) {
+          status.textContent = 'Sorry, that language is not available for on-device translation.';
+          select.value = document.documentElement.lang;
+        } finally {
+          select.disabled = false;
+        }
+      });
+    })();
+  </script>
