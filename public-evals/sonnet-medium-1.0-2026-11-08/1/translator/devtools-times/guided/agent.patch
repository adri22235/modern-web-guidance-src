diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..33b7465
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,160 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+const SOURCE_LANGUAGE = 'en';
+const STORAGE_KEY = 'translate-target';
+const RTL_LANGUAGES = ['ar', 'he'];
+
+const LANGUAGES: Record<string, string> = {
+  ar: 'العربية', de: 'Deutsch', es: 'Español', fr: 'Français', hi: 'हिन्दी',
+  it: 'Italiano', ja: '日本語', ko: '한국어', nl: 'Nederlands', pl: 'Polski',
+  pt: 'Português', ru: 'Русский', tr: 'Türkçe', uk: 'Українська', zh: '中文',
+};
+
+type Status = 'idle' | 'downloading' | 'translating' | 'error';
+
+// Original text of every node and attributes of every element we've changed, so we can restore them.
+const originalText = new WeakMap<Text, string>();
+const originalAttrs = new WeakMap<Element, { lang: string | null; dir: string | null }>();
+const translatedNodes = new Set<Text>();
+
+function collectTextNodes(): Text[] {
+  const nodes: Text[] = [];
+  document.querySelectorAll('[data-translatable]').forEach((root) => {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+      if (n.nodeValue?.trim()) nodes.push(n as Text);
+    }
+  });
+  return nodes;
+}
+
+function setLanguage(lang: string | null) {
+  document.querySelectorAll('[data-translatable]').forEach((el) => {
+    if (lang) {
+      if (!originalAttrs.has(el)) {
+        originalAttrs.set(el, { lang: el.getAttribute('lang'), dir: el.getAttribute('dir') });
+      }
+      el.setAttribute('lang', lang);
+      el.setAttribute('dir', RTL_LANGUAGES.includes(lang) ? 'rtl' : 'ltr');
+    } else {
+      const orig = originalAttrs.get(el);
+      if (!orig) return;
+      for (const key of ['lang', 'dir'] as const) {
+        if (orig[key] === null) el.removeAttribute(key);
+        else el.setAttribute(key, orig[key]);
+      }
+      originalAttrs.delete(el);
+    }
+  });
+}
+
+function restore() {
+  translatedNodes.forEach((node) => {
+    const text = originalText.get(node);
+    if (text !== undefined) node.nodeValue = text;
+  });
+  translatedNodes.clear();
+  setLanguage(null);
+}
+
+export default function TranslateControl() {
+  const [supported, setSupported] = useState(false);
+  const [target, setTarget] = useState('');
+  const [status, setStatus] = useState<Status>('idle');
+  const [progress, setProgress] = useState(0);
+  const runId = useRef(0);
+
+  async function translatePage(lang: string, userInitiated: boolean) {
+    const id = ++runId.current;
+    restore();
+    if (!lang) {
+      setStatus('idle');
+      sessionStorage.removeItem(STORAGE_KEY);
+      return;
+    }
+    const options = { sourceLanguage: SOURCE_LANGUAGE, targetLanguage: lang };
+    try {
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') throw new Error('unavailable');
+      // Creating a translator that needs a model download requires a user gesture.
+      if (availability !== 'available' && !userInitiated) return;
+
+      setStatus(availability === 'available' ? 'translating' : 'downloading');
+      setProgress(0);
+      const translator = await Translator.create({
+        ...options,
+        monitor(m: EventTarget) {
+          m.addEventListener('downloadprogress', (e) => {
+            setProgress(Math.round((e as ProgressEvent).loaded * 100));
+          });
+        },
+      });
+      setStatus('translating');
+
+      const nodes = collectTextNodes();
+      for (const node of nodes) {
+        if (id !== runId.current) return; // superseded by another choice
+        const text = node.nodeValue ?? '';
+        const result = await translator.translate(text.trim());
+        if (id !== runId.current) return;
+        originalText.set(node, text);
+        translatedNodes.add(node);
+        // Preserve surrounding whitespace so inline markup keeps its spacing.
+        node.nodeValue = text.match(/^\s*/)![0] + result + text.match(/\s*$/)![0];
+      }
+      setLanguage(lang);
+      sessionStorage.setItem(STORAGE_KEY, lang);
+      setStatus('idle');
+    } catch {
+      if (id !== runId.current) return;
+      restore();
+      setStatus('error');
+    }
+  }
+
+  useEffect(() => {
+    if (!('Translator' in self)) return;
+    setSupported(true);
+    // Keep the chosen language across client-side navigations when no download is needed.
+    const saved = sessionStorage.getItem(STORAGE_KEY);
+    if (saved && saved in LANGUAGES) {
+      setTarget(saved);
+      translatePage(saved, false);
+    }
+    return () => {
+      runId.current++;
+    };
+  }, []);
+
+  if (!supported) return null;
+
+  const busy = status === 'downloading' || status === 'translating';
+
+  return (
+    <div className="flex items-center gap-1 text-xs">
+      <LanguageIcon className="h-5 w-5 text-gray-700" aria-hidden="true" />
+      <label htmlFor="translate-target" className="sr-only">Translate articles on this page</label>
+      <select
+        id="translate-target"
+        value={target}
+        disabled={busy}
+        onChange={(e) => {
+          setTarget(e.target.value);
+          translatePage(e.target.value, true);
+        }}
+        className="border border-gray-300 rounded py-1 px-1 bg-white text-gray-800 max-w-32"
+      >
+        <option value="">Translate…</option>
+        {Object.entries(LANGUAGES).map(([code, name]) => (
+          <option key={code} value={code}>{name}</option>
+        ))}
+      </select>
+      <span role="status" aria-live="polite" className="text-gray-500 whitespace-nowrap">
+        {status === 'downloading' && `Downloading language… ${progress}%`}
+        {status === 'translating' && 'Translating…'}
+        {status === 'error' && 'Translation isn’t available for this language on your device.'}
+      </span>
+    </div>
+  );
+}
