+<script>
+    const nav = document.querySelector('nav');
+    const sections = document.querySelectorAll('section[id]');
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let currentScrollId = 0;
+
+    // Scroll methods return a Promise in supporting browsers; fall back to scrollend/idle detection.
+    function scrollIntoViewAsync(element, options) {
+      const result = element.scrollIntoView(options);
+      if (result instanceof Promise) return result;
+
+      return new Promise((resolve) => {
+        let timeoutId;
+        const finish = () => {
+          clearTimeout(timeoutId);
+          removeEventListener('scrollend', finish);
+          removeEventListener('scroll', onScroll);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+        addEventListener('scrollend', finish, { once: true });
+        addEventListener('scroll', onScroll, { passive: true });
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    nav.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      const target = link && document.getElementById(link.hash.slice(1));
+      if (!target) return;
+
+      event.preventDefault();
+      const scrollId = ++currentScrollId;
+      sections.forEach((sec) => sec.classList.remove('arrived'));
+
+      await scrollIntoViewAsync(target, {
+        behavior: reduceMotion.matches ? 'auto' : 'smooth',
+        block: 'start',
+      });
+
+      // A newer navigation click superseded this scroll
+      if (scrollId !== currentScrollId) return;
+
+      history.pushState(null, '', link.hash);
+      target.classList.add('arrived');
+      target.querySelector('h2').focus({ preventScroll: true });
+    });
+  </script>
