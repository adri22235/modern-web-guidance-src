+<script>
+    (function () {
+      var links = document.querySelectorAll('nav a[data-scroll-target]');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var token = 0;
+
+      // Resolve once scrolling has finished (scrollend, or position stable as fallback)
+      function whenScrollEnds(targetTop) {
+        return new Promise(function (resolve) {
+          var done = false, last = window.scrollY, stable = 0, timer;
+          function finish() {
+            if (done) return;
+            done = true;
+            clearInterval(timer);
+            window.removeEventListener('scrollend', finish);
+            resolve();
+          }
+          if ('onscrollend' in window) window.addEventListener('scrollend', finish, { once: true });
+          timer = setInterval(function () {
+            var y = window.scrollY;
+            stable = Math.abs(y - last) < 1 ? stable + 1 : 0;
+            last = y;
+            if (stable >= 6) finish();
+          }, 50);
+          // Already in place: no scroll event will fire
+          if (Math.abs(window.scrollY - targetTop) < 1) finish();
+        });
+      }
+
+      function arrive(target) {
+        target.focus({ preventScroll: true });
+        target.classList.remove('section-arrived');
+        void target.offsetWidth; // restart animation
+        target.classList.add('section-arrived');
+        target.addEventListener('animationend', function (e) {
+          if (e.target === target) target.classList.remove('section-arrived');
+        });
+      }
+
+      links.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          var id = link.dataset.scrollTarget || link.getAttribute('href').slice(1);
+          var target = document.getElementById(id);
+          if (!target) return;
+          e.preventDefault();
+
+          var my = ++token;
+          var maxTop = document.documentElement.scrollHeight - window.innerHeight;
+          var margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
+          var top = Math.min(Math.max(target.getBoundingClientRect().top + window.scrollY - margin, 0), maxTop);
+
+          links.forEach(function (l) { l.classList.toggle('active', l === link); });
+          history.pushState(null, '', '#' + id);
+          target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
+
+          whenScrollEnds(top).then(function () {
+            if (my === token) arrive(target); // skip if a newer click superseded this one
+          });
+        });
+      });
+    })();
+  </script>
+
