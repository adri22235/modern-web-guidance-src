+  <script>
+    (function () {
+      var list = document.querySelector('.reviews-list');
+      var wrap = list.parentElement;
+
+      function updateHints() {
+        var maxScroll = list.scrollHeight - list.clientHeight;
+        wrap.classList.toggle('can-scroll-up', list.scrollTop > 1);
+        wrap.classList.toggle('can-scroll-down', list.scrollTop < maxScroll - 1);
+      }
+
+      list.addEventListener('scroll', updateHints, { passive: true });
+      window.addEventListener('resize', updateHints);
+      updateHints();
+    })();
+  </script>
