       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Customer Reviews */
+    .reviews {
+      margin-top: 60px;
+    }
+
+    .reviews-scroller {
+      list-style: none;
+      max-width: 700px;
+      height: 360px;
+      margin: 20px auto 0;
+      padding: 0 12px;
+      overflow-y: auto;
+      container-type: scroll-state;
+      background: var(--light);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+    }
+
+    /* Scroll hints: shadows drawn at the scrollport edges, never intercepting clicks */
+    .reviews-scroller::before,
+    .reviews-scroller::after {
+      content: "";
+      display: block;
+      position: sticky;
+      block-size: 0.75rem;
+      z-index: 1;
+      pointer-events: none;
+      opacity: 0;
+      transition: opacity 0.2s;
+    }
+
+    .reviews-scroller::before {
+      inset-block-start: 0;
+      margin-block-end: -0.75rem;
+      background: radial-gradient(farthest-side at 50% 0, rgb(0 0 0 / 0.2), transparent);
+    }
+
+    .reviews-scroller::after {
+      inset-block-end: 0;
+      margin-block-start: -0.75rem;
+      background: radial-gradient(farthest-side at 50% 100%, rgb(0 0 0 / 0.2), transparent);
+    }
+
+    @container scroll-state(scrollable: block-start) {
+      .reviews-scroller::before {
+        opacity: 1;
+      }
+    }
+
+    @container scroll-state(scrollable: block-end) {
+      .reviews-scroller::after {
+        opacity: 1;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .reviews-scroller::before,
+      .reviews-scroller::after {
+        animation: show-shadow linear both;
+        animation-timeline: scroll();
+      }
+
+      .reviews-scroller::before {
+        animation-range: 0 2rem;
+      }
+
+      .reviews-scroller::after {
+        animation-direction: reverse;
+        animation-range: calc(100% - 2rem) 100%;
+      }
+    }
+
+    @keyframes show-shadow {
+      to {
+        opacity: 1;
+      }
+    }
+
+    .review {
+      background: white;
+      padding: 20px;
+      margin: 12px 0;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .review-stars {
+      color: var(--accent);
+      letter-spacing: 2px;
+    }
+
+    .review blockquote {
+      margin: 6px 0;
+    }
+
+    .review-author {
+      font-size: 0.85rem;
+      font-weight: bold;
+      color: var(--primary);
+    }
   </style>
