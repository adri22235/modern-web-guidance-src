+    /* Customization checkboxes */
+    :root {
+      --icon-bean: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill-rule='evenodd' d='M12 2C7 2 4 7 4 12.5S7.500 22 12 22s8-4 8-9.500S17 2 12 2zm.8 3.200c-1.900 1.800-2.200 3.600-1.200 5.400 1 1.700.9 3.500-.8 6.200 2.700-.9 4.100-2.600 4-4.700-.1-2.200-1.600-3.500-2-6.900z'/></svg>");
+    }
+
+    .options {
+      border: 0;
+      margin: 15px 0 0;
+      padding: 15px 0 0;
+      border-top: 1px dashed var(--secondary);
+      text-align: left;
+    }
+
+    .options legend {
+      float: left;
+      width: 100%;
+      margin-bottom: 5px;
+      font-size: 0.75rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      color: var(--primary);
+    }
+
+    .options legend + * {
+      clear: both;
+    }
+
+    .option {
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      min-block-size: 44px;
+      cursor: pointer;
+    }
+
+    .option:has(:disabled) {
+      cursor: not-allowed;
+    }
+
+    .option-box {
+      --checkbox-size: 1.375em;
+      --checkbox-icon-size: 0.95em;
+
+      appearance: none;
+      flex: none;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid var(--primary);
+      border-radius: 6px;
+      background-color: white;
+      color: var(--accent);
+      cursor: inherit;
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--icon-bean) no-repeat center / contain;
+        scale: 0;
+        rotate: -90deg;
+
+        @media (prefers-reduced-motion: no-preference) {
+          transition: scale 250ms cubic-bezier(0.34, 1.56, 0.64, 1), rotate 250ms ease;
+        }
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 200ms ease, box-shadow 200ms ease;
+      }
+
+      &:checked {
+        background-color: var(--primary);
+        box-shadow: 0 0 0 3px var(--secondary);
+      }
+
+      &:checked::before {
+        scale: 1;
+        rotate: 0deg;
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--text);
+        outline-offset: 3px;
+      }
+
+      &:disabled {
+        opacity: 0.5;
+      }
+    }
+
+    .option:hover .option-box:not(:checked, :disabled) {
+      background-color: var(--secondary);
+    }
+
