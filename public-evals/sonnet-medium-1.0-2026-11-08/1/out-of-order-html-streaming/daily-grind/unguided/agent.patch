+  <!-- Streamed later in the document: the real cards. -->
+  <template id="seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+  <script>
+    (() => {
+      const grid = document.getElementById('seasonal-grid');
+      const tpl = document.getElementById('seasonal-cards');
+
+      // Swap placeholders for the streamed cards in place.
+      grid.replaceChildren(tpl.content.cloneNode(true));
+      grid.removeAttribute('aria-busy');
+      tpl.remove();
+
+      // Parse server HTML in an inert document; scripts in it never execute.
+      const applyFragment = (html) => {
+        const doc = new DOMParser().parseFromString(`<template>${html}</template>`, 'text/html');
+        const frag = document.importNode(doc.querySelector('template').content, true);
+        frag.querySelectorAll('script, iframe, object, embed').forEach((n) => n.remove());
+        grid.replaceChildren(frag);
+      };
+
+      let inflight;
+      const refreshMenu = async () => {
+        inflight?.abort();
+        const ctrl = inflight = new AbortController();
+        try {
+          const res = await fetch('/menu/seasonal/cards', {
+            headers: { Accept: 'text/html' }, cache: 'no-cache', signal: ctrl.signal
+          });
+          if (res.ok) applyFragment(await res.text());
+        } catch (e) {
+          if (e.name !== 'AbortError') console.warn('Menu refresh failed', e);
+        }
+      };
+
+      // Refresh when the server says the menu changed, and when the tab regains focus.
+      if ('EventSource' in window) {
+        new EventSource('/menu/events').addEventListener('menu-changed', refreshMenu);
+      }
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) refreshMenu();
+      });
+
+      // Customer reviews are untrusted: built with textContent, never as HTML.
+      const reviews = document.getElementById('reviews-grid');
+      fetch('/api/reviews?limit=3', { headers: { Accept: 'application/json' } })
+        .then((r) => (r.ok ? r.json() : []))
+        .then((list) => {
+          reviews.replaceChildren(...list.map(({ author, text, rating }) => {
+            const card = document.createElement('div');
+            card.className = 'card';
+            const q = document.createElement('blockquote');
+            q.textContent = text;
+            const c = document.createElement('cite');
+            const stars = '★'.repeat(Math.max(0, Math.min(5, rating | 0)));
+            c.textContent = `${stars} ${author}`.trim();
+            card.append(q, c);
+            return card;
+          }));
+        })
+        .catch(() => {});
+    })();
+  </script>
+
 </body>
 
