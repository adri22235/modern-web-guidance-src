+  <!-- Streamed later in the same document: replaces the placeholders above -->
+  <template for="seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script type="module">
+    // --- Polyfills (only where native support is missing) ---
+    // <?marker>/<?start>/<?end> + <template for>: unsupported browsers parse the markers as comments.
+    const hasProcessingInstructions = new DOMParser()
+      .parseFromString('<div><?marker name="x"></div>', 'text/html')
+      .body.firstChild.firstChild?.nodeType === Node.PROCESSING_INSTRUCTION_NODE;
+    if (!hasProcessingInstructions) {
+      await import('https://esm.sh/template-for-polyfill');
+    }
+    if (!('setHTMLUnsafe' in Element.prototype) || !('streamHTMLUnsafe' in Element.prototype)) {
+      await import('https://esm.sh/html-setters-polyfill');
+    }
+
+    // --- Seasonal cards: refresh in place with fresh server HTML ---
+    const grid = document.getElementById('seasonal-grid');
+    let refreshing;
+
+    function refreshCards() {
+      refreshing?.abort();
+      const ctrl = refreshing = new AbortController();
+      return fetch('/menu/seasonal-cards', { signal: ctrl.signal, headers: { Accept: 'text/html' } })
+        .then(async (res) => {
+          if (!res.ok) throw new Error(res.status);
+          // Our own server's markup: trusted, no scripts, so the unsafe (unsanitized) variant is fine.
+          // Streaming variant renders incrementally and replaces the existing cards.
+          await res.body.pipeThrough(new TextDecoderStream()).pipeTo(grid.streamHTMLUnsafe(), { signal: ctrl.signal });
+        })
+        .catch((err) => { if (err.name !== 'AbortError') console.warn('Menu refresh failed', err); });
+    }
+
+    // Server pushes an event whenever the menu changes.
+    if ('EventSource' in window) {
+      new EventSource('/menu/events').addEventListener('menu-changed', refreshCards);
+    }
+    // Catch up on changes missed while the tab was hidden.
+    document.addEventListener('visibilitychange', () => {
+      if (!document.hidden) refreshCards();
+    });
+
+    // --- CMS promo: trusted same-origin HTML with its own widget script ---
+    async function loadPromo() {
+      const target = document.getElementById('cms-promo');
+      const res = await fetch('/cms/promo', { headers: { Accept: 'text/html' } });
+      if (!res.ok) return;
+      target.setHTMLUnsafe(await res.text());
+      // Parser-inserted scripts are inert; re-create them so the widget actually runs (once).
+      for (const old of target.querySelectorAll('script')) {
+        const script = document.createElement('script');
+        for (const { name, value } of old.attributes) script.setAttribute(name, value);
+        script.textContent = old.textContent;
+        old.replaceWith(script);
+      }
+    }
+
+    // --- Customer reviews: untrusted, always sanitized ---
+    const reviewConfig = {
+      elements: ['article', 'h4', 'p', 'blockquote', 'b', 'strong', 'i', 'em', 'span', 'br'],
+      attributes: ['class']
+    };
+
+    async function loadReviews() {
+      const target = document.getElementById('reviews-grid');
+      const res = await fetch('/reviews/seasonal', { headers: { Accept: 'text/html' } });
+      if (!res.ok) { target.replaceChildren(); return; }
+      const html = await res.text();
+      if ('setHTML' in Element.prototype) {
+        target.setHTML(html, { sanitizer: reviewConfig });
+      } else {
+        const { default: DOMPurify } = await import('https://esm.sh/dompurify');
+        target.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...reviewConfig.elements, '#text'],
+          ALLOWED_ATTR: reviewConfig.attributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    loadPromo().catch((err) => console.warn('Promo failed', err));
+    loadReviews().catch((err) => {
+      console.warn('Reviews failed', err);
+      document.getElementById('reviews-grid').replaceChildren();
+    });
+  </script>
+
 </body>
 
