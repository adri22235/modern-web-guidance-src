+
+    /* Each cell is the size container; the card adapts to the cell's width, not the viewport */
+    .card-cell {
+      container-type: inline-size;
+    }
+
+    .card-cell > .card {
+      height: 100%;
+      box-sizing: border-box;
+    }
+
+    .card footer {
+      background: none;
+      padding: 0;
+      margin: 0;
+      text-align: inherit;
+    }
+
+    @container (min-width: 420px) {
+      .card {
+        display: grid;
+        grid-template-columns: 1fr auto;
+        grid-template-areas: "title action" "text action";
+        align-items: center;
+        column-gap: 24px;
+        padding: 28px;
+        text-align: left;
+      }
+
+      .card h3 {
+        grid-area: title;
+        font-size: 1.4rem;
+      }
+
+      .card p {
+        grid-area: text;
+      }
+
+      .card footer {
+        grid-area: action;
+      }
+
+      .card .btn {
+        margin-top: 0;
+      }
+    }
+
