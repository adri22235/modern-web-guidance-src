+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 10px;
+    }
+
+    .drink-card .drink-info {
+      min-width: 0;
+    }
+
+    .drink-card .btn {
+      margin-top: 5px;
+    }
+
+    @container drink-card (min-width: 400px) {
+      .drink-card {
+        flex-direction: row;
+        justify-content: space-between;
+        gap: 20px;
+        padding: 24px 28px;
+        text-align: left;
+      }
+
+      .drink-card h3 {
+        font-size: 1.3rem;
+      }
+
+      .drink-card .btn {
+        flex-shrink: 0;
+        margin-top: 0;
+      }
+    }
+
+    @container drink-card (min-width: 600px) {
+      .drink-card h3 {
+        font-size: 1.5rem;
+      }
+    }
