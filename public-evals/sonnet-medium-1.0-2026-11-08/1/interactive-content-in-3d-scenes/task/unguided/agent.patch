+  <script>
+    (function () {
+      var scene = document.getElementById('coffee-box');
+      if (!scene) return;
+
+      // Wire up the forms regardless of 3D support.
+      var forms = scene.querySelectorAll('form.box-face');
+      Array.prototype.forEach.call(forms, function (form) {
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var status = form.querySelector('.box-status');
+          status.textContent = 'Thanks! Your ' + form.dataset.label.toLowerCase() + ' request was received.';
+          form.reset();
+        });
+      });
+
+      // Feature detection: fall back to flat stacked forms if 3D isn't supported.
+      var supports3d = window.CSS && CSS.supports &&
+        CSS.supports('transform-style', 'preserve-3d') &&
+        CSS.supports('perspective', '1px') &&
+        CSS.supports('backface-visibility', 'hidden');
+      if (!supports3d) return;
+      scene.classList.add('is-3d');
+
+      var box = scene.querySelector('.box-faces');
+      var faces = Array.prototype.slice.call(forms);
+      var angle = 0;       // current rotation in degrees (continuous)
+
+      function current() {
+        return ((Math.round(-angle / 90) % 4) + 4) % 4;
+      }
+
+      // Hidden faces are inert so keyboard users can't tab into them.
+      function sync() {
+        var front = current();
+        faces.forEach(function (f, i) {
+          var hidden = i !== front;
+          if ('inert' in f) f.inert = hidden;
+          f.setAttribute('aria-hidden', hidden ? 'true' : 'false');
+        });
+        box.style.setProperty('--ry', angle + 'deg');
+      }
+
+      function snap(a) {
+        angle = Math.round(a / 90) * 90;
+        sync();
+      }
+
+      function goTo(i) {
+        // Choose the shortest path to face i.
+        var cur = current();
+        var diff = ((i - cur + 6) % 4) - 2;
+        if (diff === -2) diff = 2;
+        snap(angle - diff * 90);
+      }
+
+      scene.querySelector('.box-rotate').addEventListener('click', function (e) {
+        var b = e.target.closest('button');
+        if (!b) return;
+        if (b.dataset.dir) snap(angle - 90 * Number(b.dataset.dir));
+        else goTo(Number(b.dataset.step));
+      });
+
+      // Drag to rotate, only when the drag starts on face background (not on controls).
+      var drag = null;
+      var controls = 'input, select, textarea, button, label, a';
+      box.addEventListener('pointerdown', function (e) {
+        if (e.target.closest(controls)) return;
+        drag = { x: e.clientX, start: angle, id: e.pointerId, moved: false };
+      });
+      box.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        var dx = e.clientX - drag.x;
+        if (!drag.moved && Math.abs(dx) < 4) return;
+        if (!drag.moved) {
+          drag.moved = true;
+          box.classList.add('dragging');
+          box.setPointerCapture(e.pointerId);
+        }
+        angle = drag.start + dx * 0.4;
+        box.style.setProperty('--ry', angle + 'deg');
+      });
+      function end(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        var moved = drag.moved;
+        drag = null;
+        box.classList.remove('dragging');
+        if (moved) snap(angle);
+      }
+      box.addEventListener('pointerup', end);
+      box.addEventListener('pointercancel', end);
+
+      // If focus lands on a face somehow (e.g. label click), rotate it to the front.
+      box.addEventListener('focusin', function (e) {
+        var f = e.target.closest('form.box-face');
+        var i = faces.indexOf(f);
+        if (i > -1 && i !== current()) goTo(i);
+      });
+
+      sync();
+    })();
+  </script>
+
