+/**
+ * <favorite-toggle item="maple-oat-latte" label="Maple Oat Latte"></favorite-toggle>
+ *
+ * A switch-style heart button. `pressed` reflects the on/off state, `item` is the
+ * key the state is remembered under in localStorage, and `label` names the drink
+ * for assistive tech. Fires a bubbling `favorite-change` event with { pressed }.
+ */
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['pressed', 'label'];
+  static #template = (() => {
+    const t = document.createElement('template');
+    t.innerHTML = `
+      <style>
+        :host { display: inline-block; }
+        button {
+          display: grid; place-items: center;
+          width: 44px; height: 44px; padding: 0;
+          border: 0; border-radius: 50%; background: transparent;
+          color: var(--favorite-off, #8d6e63); cursor: pointer;
+          transition: color .2s, transform .2s;
+        }
+        button:hover { background: rgba(0, 0, 0, .06); }
+        button:focus-visible { outline: 2px solid var(--favorite-on, #c62828); outline-offset: 2px; }
+        button[aria-pressed="true"] { color: var(--favorite-on, #c62828); }
+        button[aria-pressed="true"] path { fill: currentColor; }
+        svg { width: 24px; height: 24px; }
+        path { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
+        @media (prefers-reduced-motion: no-preference) {
+          button:active { transform: scale(.85); }
+        }
+      </style>
+      <button type="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 21s-7.5-4.6-9.5-9.3C1.2 8.5 3 5 6.5 5c2 0 3.7 1.1 5.5 3 1.8-1.9 3.5-3 5.5-3C21 5 22.8 8.5 21.5 11.7 19.5 16.4 12 21 12 21z"/>
+        </svg>
+      </button>`;
+    return t;
+  })();
+
+  #button;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(FavoriteToggle.#template.content.cloneNode(true));
+    this.#button = this.shadowRoot.querySelector('button');
+    this.#button.addEventListener('click', () => {
+      this.pressed = !this.pressed;
+      this.#save();
+      this.dispatchEvent(new CustomEvent('favorite-change', { bubbles: true, detail: { pressed: this.pressed } }));
+    });
+  }
+
+  connectedCallback() {
+    // Restore a saved choice unless markup already set one explicitly.
+    if (!this.hasAttribute('pressed') && this.item && this.#load()) this.pressed = true;
+    this.#sync();
+  }
+
+  attributeChangedCallback() {
+    this.#sync();
+  }
+
+  get pressed() { return this.hasAttribute('pressed'); }
+  set pressed(value) { this.toggleAttribute('pressed', Boolean(value)); }
+
+  get item() { return this.getAttribute('item'); }
+  set item(value) { this.setAttribute('item', value); }
+
+  #sync() {
+    const label = this.getAttribute('label');
+    this.#button.setAttribute('aria-pressed', String(this.pressed));
+    this.#button.setAttribute('aria-label', label ? `Favorite ${label}` : 'Favorite');
+  }
+
+  get #key() { return `favorite:${this.item}`; }
+
+  #load() {
+    try { return localStorage.getItem(this.#key) === '1'; } catch { return false; }
+  }
+
+  #save() {
+    if (!this.item) return;
+    try {
+      if (this.pressed) localStorage.setItem(this.#key, '1');
+      else localStorage.removeItem(this.#key);
+    } catch { /* storage blocked: state still works for this page view */ }
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
