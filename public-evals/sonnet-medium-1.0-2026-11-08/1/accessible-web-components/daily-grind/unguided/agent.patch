+/**
+ * <favorite-toggle> — a switchable heart button for marking an item as a favorite.
+ *
+ * Attributes:
+ *   item-id   Unique key used to persist state in localStorage (optional; without it state is not saved)
+ *   label     Name of the item, used for the accessible label (e.g. "Maple Oat Latte")
+ *   pressed   Present when the item is a favorite (reflects the current state)
+ *
+ * Events:
+ *   favorite-change  Bubbles; detail: { itemId, label, pressed }
+ */
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['pressed', 'label'];
+  static storagePrefix = 'daily-grind:favorite:';
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = `
+      <style>
+        :host { display: inline-block; }
+        button {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          width: 2.5rem;
+          height: 2.5rem;
+          padding: 0;
+          border: 1px solid var(--favorite-border, #d7ccc8);
+          border-radius: 50%;
+          background: #fff;
+          color: var(--favorite-off, #8d6e63);
+          cursor: pointer;
+          transition: color 0.2s, background 0.2s, transform 0.1s;
+        }
+        button:hover { background: #fafafa; }
+        button:active { transform: scale(0.92); }
+        button:focus-visible { outline: 2px solid var(--favorite-on, #e53935); outline-offset: 2px; }
+        button[aria-pressed="true"] { color: var(--favorite-on, #e53935); border-color: currentColor; }
+        svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 2; }
+        button[aria-pressed="true"] svg { fill: currentColor; }
+        @media (prefers-reduced-motion: reduce) { button { transition: none; } }
+      </style>
+      <button type="button" aria-pressed="false">
+        <svg viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.3 2.8 4.5 6.4 4.5c2 0 3.8 1.1 5.6 3.2 1.8-2.1 3.6-3.2 5.6-3.2 3.6 0 5.5 3.8 4 7.2C19.5 16.4 12 21 12 21z"/>
+        </svg>
+      </button>`;
+    this._button = root.querySelector('button');
+    this._button.addEventListener('click', () => this.toggle());
+  }
+
+  connectedCallback() {
+    const id = this.getAttribute('item-id');
+    if (id && !this.hasAttribute('pressed')) {
+      try {
+        if (localStorage.getItem(FavoriteToggle.storagePrefix + id) === '1') {
+          this.pressed = true;
+        }
+      } catch { /* storage unavailable */ }
+    }
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  get pressed() {
+    return this.hasAttribute('pressed');
+  }
+
+  set pressed(value) {
+    this.toggleAttribute('pressed', Boolean(value));
+  }
+
+  toggle() {
+    this.pressed = !this.pressed;
+    const itemId = this.getAttribute('item-id');
+    if (itemId) {
+      try {
+        const key = FavoriteToggle.storagePrefix + itemId;
+        if (this.pressed) localStorage.setItem(key, '1');
+        else localStorage.removeItem(key);
+      } catch { /* storage unavailable */ }
+    }
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      detail: { itemId, label: this.getAttribute('label'), pressed: this.pressed },
+    }));
+  }
+
+  _render() {
+    const label = this.getAttribute('label');
+    this._button.setAttribute('aria-pressed', String(this.pressed));
+    this._button.setAttribute('aria-label', label ? `Favorite ${label}` : 'Favorite');
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
