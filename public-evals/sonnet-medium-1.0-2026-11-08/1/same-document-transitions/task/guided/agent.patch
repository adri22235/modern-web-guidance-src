+
+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const detailDesc = document.getElementById('detail-desc');
+
+    function setView(showDetail) {
+      listPage.hidden = showDetail;
+      detailPage.hidden = !showDetail;
+    }
+
+    // Runs the update inside a view transition when supported, then moves focus.
+    function transitionTo(update, focusId, cleanup) {
+      const focus = () => document.getElementById(focusId).focus({ preventScroll: true });
+      if (!document.startViewTransition) {
+        update();
+        focus();
+        cleanup?.();
+        return;
+      }
+      const transition = document.startViewTransition(update);
+      transition.finished.finally(() => {
+        focus();
+        cleanup?.();
+      });
+    }
+
+    function openDetail(card, fromHistory) {
+      card.classList.add('selected');
+      transitionTo(() => {
+        hero.src = card.dataset.img + '&w=1200';
+        hero.alt = card.querySelector('img').alt;
+        detailTitle.textContent = card.querySelector('.title').textContent;
+        detailDesc.textContent = card.dataset.desc;
+        setView(true);
+        window.scrollTo(0, 0);
+      }, 'title');
+      if (!fromHistory) history.pushState({ detail: true }, '');
+    }
+
+    function closeDetail() {
+      transitionTo(() => setView(false), 'list-heading', () => {
+        document.querySelectorAll('.thumbnail.selected').forEach(c => c.classList.remove('selected'));
+      });
+    }
+
+    document.querySelectorAll('.thumbnail').forEach(card => {
+      card.addEventListener('click', () => openDetail(card));
+    });
+    document.getElementById('back').addEventListener('click', () => {
+      if (history.state?.detail) history.back(); // popstate performs the transition
+      else closeDetail();
+    });
+    window.addEventListener('popstate', () => {
+      if (!detailPage.hidden) closeDetail();
+    });
+  </script>
 </body>
 
