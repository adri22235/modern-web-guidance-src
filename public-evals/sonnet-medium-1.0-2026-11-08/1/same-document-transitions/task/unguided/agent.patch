+  <script>
+    (function () {
+      var list = document.getElementById('list-page');
+      var detail = document.getElementById('detail-page');
+      var hero = document.getElementById('hero');
+      var title = document.getElementById('title');
+      var desc = document.getElementById('description');
+      var back = detail.querySelector('.back-btn');
+      var baseTitle = document.title;
+      var current = null;
+
+      function cards() { return Array.prototype.slice.call(document.querySelectorAll('.thumbnail')); }
+      function cardById(id) { return cards().filter(function (c) { return c.dataset.id === id; })[0]; }
+      function parts(card) { return [card.querySelector('img'), card.querySelector('h2.title')]; }
+
+      function name(els, on) {
+        els[0].style.viewTransitionName = on ? 'card-image' : '';
+        els[1].style.viewTransitionName = on ? 'card-title' : '';
+      }
+
+      function run(update) {
+        if (!document.startViewTransition ||
+            window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          update();
+          return;
+        }
+        document.startViewTransition(update);
+      }
+
+      function show(card, pushed) {
+        var src = parts(card);
+        var heading = card.querySelector('.title-btn').textContent;
+        current = card;
+        name(src, true);
+        run(function () {
+          name(src, false);
+          hero.src = src[0].src;
+          hero.alt = '';
+          title.textContent = heading;
+          desc.textContent = card.querySelector('p').textContent;
+          document.title = heading + ' | ' + baseTitle;
+          list.hidden = true;
+          detail.hidden = false;
+          name([hero, title], true);
+          window.scrollTo(0, 0);
+          title.focus({ preventScroll: true });
+        });
+        if (pushed) history.pushState({ id: card.dataset.id }, '', '#' + card.dataset.id);
+      }
+
+      function showList(card) {
+        var dst = card ? parts(card) : null;
+        name([hero, title], true);
+        run(function () {
+          name([hero, title], false);
+          detail.hidden = true;
+          list.hidden = false;
+          document.title = baseTitle;
+          if (dst) {
+            name(dst, true);
+            card.querySelector('.title-btn').focus({ preventScroll: true });
+          }
+        });
+        if (dst) {
+          // drop the names once the transition has captured the new state
+          var clear = function () { name(dst, false); };
+          if (document.startViewTransition) setTimeout(clear, 700); else clear();
+        }
+        current = null;
+      }
+
+      cards().forEach(function (card) {
+        card.addEventListener('click', function () { show(card, true); });
+      });
+
+      back.addEventListener('click', function () {
+        if (history.state && history.state.id) history.back();
+        else showList(current);
+      });
+
+      window.addEventListener('popstate', function (e) {
+        var id = e.state && e.state.id;
+        if (id && cardById(id)) { if (detail.hidden) show(cardById(id), false); }
+        else if (!detail.hidden) showList(current);
+      });
+
+      // deep link
+      var initial = location.hash.slice(1);
+      if (initial && cardById(initial)) {
+        history.replaceState({ id: initial }, '', '#' + initial);
+        show(cardById(initial), false);
+      }
+    })();
+  </script>
 </body>
 
