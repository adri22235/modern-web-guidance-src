+  <script>
+    (function () {
+      var dropdown = document.getElementById('roast-dropdown');
+      var trigger = document.getElementById('roast-trigger');
+      var list = dropdown.querySelector('.roast-list');
+      var options = Array.prototype.slice.call(list.querySelectorAll('.roast-option'));
+      var input = document.getElementById('roast-input');
+      var valueEl = dropdown.querySelector('.roast-value');
+      var activeIndex = 1;
+
+      function setActive(i) {
+        activeIndex = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === activeIndex); });
+      }
+
+      function open() {
+        dropdown.classList.add('open');
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; }));
+      }
+
+      function close() {
+        dropdown.classList.remove('open');
+        trigger.setAttribute('aria-expanded', 'false');
+        options.forEach(function (o) { o.classList.remove('active'); });
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        input.value = options[i].dataset.value;
+        valueEl.textContent = options[i].firstChild.textContent;
+        close();
+        trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () {
+        dropdown.classList.contains('open') ? close() : open();
+      });
+
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { select(i); });
+        o.addEventListener('mouseenter', function () { setActive(i); });
+      });
+
+      trigger.addEventListener('keydown', function (e) {
+        var isOpen = dropdown.classList.contains('open');
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          if (!isOpen) open(); else setActive(activeIndex + (e.key === 'ArrowDown' ? 1 : -1));
+        } else if ((e.key === 'Enter' || e.key === ' ') && isOpen) {
+          e.preventDefault();
+          select(activeIndex);
+        } else if (e.key === 'Escape' && isOpen) {
+          close();
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!dropdown.contains(e.target)) close();
+      });
+    })();
+  </script>
 </body>
 
