+  <script>
+    (function () {
+      var track = document.getElementById('drink-track');
+      var prev = document.getElementById('prev');
+      var next = document.getElementById('next');
+      function step() { return track.clientWidth * 0.8; }
+      function update() {
+        prev.disabled = track.scrollLeft <= 2;
+        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
+      }
+      prev.addEventListener('click', function () { track.scrollBy({ left: -step() }); });
+      next.addEventListener('click', function () { track.scrollBy({ left: step() }); });
+      track.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      track.addEventListener('keydown', function (e) {
+        if (e.target !== track) return;
+        if (e.key === 'ArrowRight') { track.scrollBy({ left: step() }); e.preventDefault(); }
+        if (e.key === 'ArrowLeft') { track.scrollBy({ left: -step() }); e.preventDefault(); }
+      });
+      update();
+
+      var dlg = document.getElementById('detail');
+      var origin = null;
+      var reduce = matchMedia('(prefers-reduced-motion: reduce)');
+      var DUR = 400, EASE = 'cubic-bezier(.2,.8,.2,1)';
+
+      function fromButton() {
+        var b = origin.getBoundingClientRect(), d = dlg.getBoundingClientRect();
+        var dx = (b.left + b.width / 2) - (d.left + d.width / 2);
+        var dy = (b.top + b.height / 2) - (d.top + d.height / 2);
+        return 'translate(' + dx + 'px,' + dy + 'px) scale(' + (b.width / d.width) + ',' + (b.height / d.height) + ')';
+      }
+
+      document.querySelectorAll('.details-btn').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          var c = btn.closest('.card');
+          origin = btn;
+          document.getElementById('detail-title').textContent = c.querySelector('h3').textContent;
+          document.getElementById('detail-desc').textContent = c.querySelector('p').textContent;
+          document.getElementById('detail-price').textContent = c.dataset.price;
+          document.getElementById('detail-size').textContent = c.dataset.size;
+          document.getElementById('detail-ing').textContent = c.dataset.ingredients;
+          document.getElementById('detail-link').href = c.dataset.href;
+          dlg.showModal();
+          if (reduce.matches) return;
+          dlg.animate([
+            { transform: fromButton(), opacity: 0, borderRadius: '5px' },
+            { transform: 'none', opacity: 1, borderRadius: '12px' }
+          ], { duration: DUR, easing: EASE });
+          dlg.animate([{ opacity: 0 }, { opacity: 1 }], { duration: DUR, pseudoElement: '::backdrop' });
+        });
+      });
+
+      var closing = false;
+      function close() {
+        if (closing || !dlg.open) return;
+        if (reduce.matches || !origin) { dlg.close(); return; }
+        closing = true;
+        var a = dlg.animate([
+          { transform: 'none', opacity: 1 },
+          { transform: fromButton(), opacity: 0 }
+        ], { duration: 250, easing: 'ease-in' });
+        dlg.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, pseudoElement: '::backdrop' });
+        a.onfinish = function () { closing = false; dlg.close(); };
+      }
+      document.getElementById('detail-close').addEventListener('click', close);
+      dlg.addEventListener('cancel', function (e) { e.preventDefault(); close(); });
+      dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); });
+      dlg.addEventListener('close', function () { if (origin) origin.focus(); });
+    })();
+  </script>
+
