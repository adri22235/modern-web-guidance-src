+<script>
+    const dialog = document.getElementById('detail');
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let trigger = null;
+
+    // Transform that maps the dialog's box onto the trigger's box.
+    function fromTrigger() {
+      const a = trigger.getBoundingClientRect();
+      const b = dialog.getBoundingClientRect();
+      const dx = a.left + a.width / 2 - (b.left + b.width / 2);
+      const dy = a.top + a.height / 2 - (b.top + b.height / 2);
+      return `translate(${dx}px, ${dy}px) scale(${a.width / b.width}, ${a.height / b.height})`;
+    }
+
+    function animate(opening) {
+      if (reduceMotion.matches || !trigger?.isConnected) return Promise.resolve();
+      const opts = { duration: opening ? 350 : 220, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'both' };
+      const from = fromTrigger();
+      const frames = opening
+        ? [{ transform: from, opacity: 0 }, { opacity: 1, offset: 0.3 }, { transform: 'none', opacity: 1 }]
+        : [{ transform: 'none', opacity: 1 }, { opacity: 0, transform: from }];
+      dialog.animate(frames, opts);
+      const fade = opening ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 1 }, { opacity: 0 }];
+      return dialog.animate(fade, { ...opts, pseudoElement: '::backdrop' }).finished.catch(() => {});
+    }
+
+    document.querySelectorAll('[data-detail]').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        trigger = btn;
+        const card = btn.closest('.card');
+        document.getElementById('detail-title').textContent = card.querySelector('h3').textContent;
+        document.getElementById('detail-text').textContent = btn.dataset.detail;
+        document.getElementById('detail-link').href = btn.dataset.href;
+        dialog.showModal();
+        animate(true);
+      });
+    });
+
+    let closing = false;
+    async function closeDetail() {
+      if (closing) return;
+      closing = true;
+      await animate(false);
+      dialog.close();
+      closing = false;
+    }
+
+    document.getElementById('detail-close').addEventListener('click', closeDetail);
+    // Esc: run the closing animation instead of closing immediately.
+    dialog.addEventListener('cancel', (e) => { e.preventDefault(); closeDetail(); });
+    // Click on the backdrop closes.
+    dialog.addEventListener('click', (e) => { if (e.target === dialog) closeDetail(); });
+    dialog.addEventListener('close', () => trigger?.focus());
+  </script>
