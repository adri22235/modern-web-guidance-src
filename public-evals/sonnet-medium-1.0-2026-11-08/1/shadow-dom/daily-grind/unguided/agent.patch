+  <script>
+    /*
+     * <drink-card heading="..." href="..." [link-text="..."] [limited]>Description</drink-card>
+     * Description is the element's content. Toggle the badge at any time with
+     * card.limited = true/false (or the `limited` attribute).
+     */
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['heading', 'href', 'link-text', 'limited'];
+      }
+
+      constructor() {
+        super();
+        const root = this.attachShadow({ mode: 'open' });
+        root.innerHTML = `
+          <style>
+            :host {
+              display: block;
+            }
+
+            .card {
+              position: relative;
+              height: 100%;
+              background: white;
+              padding: 20px;
+              border-radius: 8px;
+              box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+              text-align: center;
+            }
+
+            h3 {
+              margin-bottom: 10px;
+              color: var(--primary, #4e342e);
+            }
+
+            p {
+              margin: 0;
+            }
+
+            .badge {
+              position: absolute;
+              top: 10px;
+              right: 10px;
+              background: var(--accent, #ffab40);
+              color: var(--text, #3e2723);
+              font-size: 0.7rem;
+              font-weight: bold;
+              text-transform: uppercase;
+              letter-spacing: 0.5px;
+              padding: 2px 8px;
+              border-radius: 999px;
+            }
+
+            .badge[hidden] {
+              display: none;
+            }
+
+            .btn {
+              display: inline-block;
+              background: var(--primary, #4e342e);
+              color: white;
+              padding: 10px 20px;
+              text-decoration: none;
+              border-radius: 5px;
+              margin-top: 15px;
+              transition: background 0.3s;
+            }
+
+            .btn:hover {
+              background: var(--text, #3e2723);
+            }
+          </style>
+          <div class="card">
+            <span class="badge" hidden>Limited</span>
+            <h3></h3>
+            <p><slot></slot></p>
+            <a class="btn"></a>
+          </div>`;
+        this._title = root.querySelector('h3');
+        this._link = root.querySelector('.btn');
+        this._badge = root.querySelector('.badge');
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(value) {
+        this.toggleAttribute('limited', Boolean(value));
+      }
+
+      connectedCallback() {
+        this._render();
+      }
+
+      attributeChangedCallback() {
+        this._render();
+      }
+
+      _render() {
+        this._title.textContent = this.getAttribute('heading') || '';
+        this._link.textContent = this.getAttribute('link-text') || 'View Details';
+        if (this.hasAttribute('href')) {
+          this._link.setAttribute('href', this.getAttribute('href'));
+        } else {
+          this._link.removeAttribute('href');
+        }
+        this._badge.hidden = !this.limited;
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
