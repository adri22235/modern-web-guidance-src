+  <script>
+    // <drink-card>: reusable card with encapsulated layout and styles.
+    //   slot="title"   heading element (e.g. <h3>)
+    //   (default slot) description
+    //   slot="action"  link shown as a button
+    //   limited        boolean attribute (or `limited` property) toggles the "Limited" badge
+    // Theme via --drink-card-bg, --drink-card-title-color, --drink-card-action-bg,
+    // --drink-card-action-hover-bg, --drink-card-badge-bg, --drink-card-badge-fg.
+    const drinkCardSheet = new CSSStyleSheet();
+    drinkCardSheet.replaceSync(`
+      :host {
+        display: block;
+        --_bg: var(--drink-card-bg, white);
+        --_title: var(--drink-card-title-color, var(--primary, #4e342e));
+        --_action-bg: var(--drink-card-action-bg, var(--primary, #4e342e));
+        --_action-hover-bg: var(--drink-card-action-hover-bg, #3e2723);
+        --_badge-bg: var(--drink-card-badge-bg, var(--accent, #ffab40));
+        --_badge-fg: var(--drink-card-badge-fg, #3e2723);
+      }
+      .card {
+        position: relative;
+        height: 100%;
+        background: var(--_bg);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+      }
+      .badge {
+        position: absolute;
+        top: 10px;
+        right: 10px;
+        background: var(--_badge-bg);
+        color: var(--_badge-fg);
+        font-size: 0.75rem;
+        font-weight: bold;
+        text-transform: uppercase;
+        letter-spacing: 0.5px;
+        padding: 2px 8px;
+        border-radius: 999px;
+      }
+      :host(:not([limited])) .badge { display: none; }
+      ::slotted([slot="title"]) {
+        margin: 0 0 10px;
+        color: var(--_title);
+      }
+      ::slotted(p) { margin: 0; }
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--_action-bg);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+      ::slotted([slot="action"]:hover) { background: var(--_action-hover-bg); }
+    `);
+
+    const drinkCardTemplate = document.createElement('template');
+    drinkCardTemplate.innerHTML = `
+      <article class="card">
+        <span class="badge" part="badge">Limited</span>
+        <slot name="title"></slot>
+        <slot></slot>
+        <slot name="action"></slot>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['limited'];
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [drinkCardSheet];
+        this.shadowRoot.append(drinkCardTemplate.content.cloneNode(true));
+      }
+
+      get limited() { return this.hasAttribute('limited'); }
+      set limited(on) { this.toggleAttribute('limited', !!on); }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
