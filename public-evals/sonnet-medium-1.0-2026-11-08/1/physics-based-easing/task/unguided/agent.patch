diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,49 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Springy hover: overshoots the target scale, then settles */
+    .card.spring {
+      transition: transform 0.6s linear(0, 0.402 7.4%, 0.711 15.3%, 0.929 23.7%, 1.008 28.2%, 1.067 33%, 1.099 36.9%, 1.12 41%, 1.13 45.4%, 1.126 50.3%, 1.09 59.4%, 1.03 69.4%, 0.998 79.3%, 0.99 86%, 1);
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within {
+      transform: scale(1.06);
+    }
+
+    /* Playful bounce on hover */
+    .card.bounce:hover,
+    .card.bounce:focus-within {
+      animation: card-bounce 0.7s ease-out;
+    }
+
+    @keyframes card-bounce {
+      0%   { transform: translateY(0) scale(1); }
+      25%  { transform: translateY(-14px) scale(1.03, 0.98); }
+      45%  { transform: translateY(0) scale(0.98, 1.03); }
+      65%  { transform: translateY(-6px) scale(1.01); }
+      85%  { transform: translateY(0) scale(0.995, 1.005); }
+      100% { transform: translateY(0) scale(1); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring {
+        transition: none;
+      }
+
+      .card.spring:hover,
+      .card.spring:focus-within {
+        transform: none;
+      }
+
+      .card.bounce:hover,
+      .card.bounce:focus-within {
+        animation: none;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
