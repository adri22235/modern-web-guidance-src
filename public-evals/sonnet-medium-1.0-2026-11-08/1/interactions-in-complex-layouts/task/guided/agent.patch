+  <script>
+    const STATUSES = ['queued', 'brewing', 'ready'];
+    const orders = [
+      { name: 'Maple Oat Latte', customer: 'Ava', status: 'queued' },
+      { name: 'Cold Brew', customer: 'Ben', status: 'queued' },
+      { name: 'Dark Roast Espresso', customer: 'Chloe', status: 'brewing' },
+      { name: 'Flat White', customer: 'Dev', status: 'brewing' },
+      { name: 'Cappuccino', customer: 'Esha', status: 'ready' },
+    ];
+    const board = document.getElementById('board');
+    let dragged = null;
+
+    const listOf = (status) => board.querySelector(`[data-status="${status}"] .board-cards`);
+
+    function makeCard(order, i) {
+      const li = document.createElement('li');
+      li.className = 'card';
+      li.draggable = true;
+      li.id = `order-${i}`;
+      li.dataset.status = order.status;
+      li.innerHTML = `<strong></strong><small></small>
+        <div class="card-actions">
+          <button type="button" data-dir="-1" aria-label="Move back">&larr;</button>
+          <button type="button" data-dir="1" aria-label="Move forward">&rarr;</button>
+        </div>`;
+      li.querySelector('strong').textContent = order.name;
+      li.querySelector('small').textContent = `For ${order.customer} · #${i + 1}`;
+      return li;
+    }
+
+    function refresh() {
+      board.querySelectorAll('.board-column').forEach((col) => {
+        col.querySelector('.count').textContent = col.querySelectorAll('.card').length;
+      });
+      board.querySelectorAll('.card').forEach((card) => {
+        const idx = STATUSES.indexOf(card.dataset.status);
+        card.querySelector('[data-dir="-1"]').disabled = idx === 0;
+        card.querySelector('[data-dir="1"]').disabled = idx === STATUSES.length - 1;
+      });
+    }
+
+    // Only the target list is mutated, so layout stays inside the column.
+    function moveCard(card, status, before = null) {
+      card.dataset.status = status;
+      listOf(status).insertBefore(card, before);
+      refresh();
+    }
+
+    orders.forEach((o, i) => listOf(o.status).append(makeCard(o, i)));
+    refresh();
+
+    board.addEventListener('dragstart', (e) => {
+      const card = e.target.closest('.card');
+      if (!card) return;
+      dragged = card;
+      e.dataTransfer.effectAllowed = 'move';
+      e.dataTransfer.setData('text/plain', card.id);
+      requestAnimationFrame(() => card.classList.add('dragging'));
+    });
+
+    board.addEventListener('dragend', () => {
+      dragged?.classList.remove('dragging');
+      dragged = null;
+      board.querySelectorAll('.drag-over').forEach((c) => c.classList.remove('drag-over'));
+    });
+
+    board.addEventListener('dragover', (e) => {
+      const col = e.target.closest('.board-column');
+      if (!col || !dragged) return;
+      e.preventDefault();
+      e.dataTransfer.dropEffect = 'move';
+      board.querySelectorAll('.drag-over').forEach((c) => c !== col && c.classList.remove('drag-over'));
+      col.classList.add('drag-over');
+    });
+
+    board.addEventListener('drop', (e) => {
+      const col = e.target.closest('.board-column');
+      if (!col || !dragged) return;
+      e.preventDefault();
+      const over = e.target.closest('.card');
+      let before = null;
+      if (over && over !== dragged) {
+        const r = over.getBoundingClientRect();
+        before = e.clientY < r.top + r.height / 2 ? over : over.nextElementSibling;
+      }
+      moveCard(dragged, col.dataset.status, before);
+      col.classList.remove('drag-over');
+    });
+
+    board.addEventListener('click', (e) => {
+      const btn = e.target.closest('button[data-dir]');
+      if (!btn) return;
+      const card = btn.closest('.card');
+      const next = STATUSES[STATUSES.indexOf(card.dataset.status) + Number(btn.dataset.dir)];
+      if (!next) return;
+      moveCard(card, next);
+      const focusBtn = card.querySelector(`[data-dir="${btn.dataset.dir}"]`);
+      (focusBtn.disabled ? card.querySelector('button:not(:disabled)') : focusBtn)?.focus();
+    });
+  </script>
 </body>
 
