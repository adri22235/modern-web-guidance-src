     <div class="footer-links">
@@ -206,7 +290,106 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+
+  <script>
+    (function () {
+      var STATUSES = [
+        { id: 'queued', title: 'Queued' },
+        { id: 'brewing', title: 'Brewing' },
+        { id: 'ready', title: 'Ready' }
+      ];
+      var orders = [
+        { id: 1, drink: 'Maple Oat Latte', name: 'Priya', note: '12oz, extra hot', status: 'queued' },
+        { id: 2, drink: 'Cold Brew', name: 'Marcus', note: '16oz, no ice', status: 'queued' },
+        { id: 3, drink: 'Dark Roast Espresso', name: 'Jo', note: 'Double shot', status: 'brewing' },
+        { id: 4, drink: 'Flat White', name: 'Sam', note: 'Oat milk', status: 'brewing' },
+        { id: 5, drink: 'Cappuccino', name: 'Lena', note: '8oz', status: 'ready' }
+      ];
+      var board = document.getElementById('board');
+      var draggedId = null;
+      var bodies = {};
+
+      function esc(t) {
+        var d = document.createElement('div');
+        d.textContent = t;
+        return d.innerHTML;
+      }
+
+      // Each column renders only its own orders, so moving a card
+      // re-renders just the source and destination columns.
+      function renderColumn(status) {
+        var col = bodies[status];
+        var list = orders.filter(function (o) { return o.status === status; });
+        col.count.textContent = list.length;
+        col.cards.innerHTML = list.map(function (o) {
+          var i = STATUSES.findIndex(function (s) { return s.id === status; });
+          var prev = i > 0 ? '<button type="button" data-move="-1" aria-label="Move ' + esc(o.drink) + ' back">&larr;</button>' : '';
+          var next = i < STATUSES.length - 1 ? '<button type="button" data-move="1" aria-label="Move ' + esc(o.drink) + ' forward">&rarr;</button>' : '';
+          return '<div class="card" draggable="true" data-id="' + o.id + '">' +
+            '<h4>' + esc(o.drink) + '</h4>' +
+            '<p>' + esc(o.name) + ' &middot; ' + esc(o.note) + '</p>' +
+            '<div class="moves">' + prev + next + '</div></div>';
+        }).join('');
+      }
+
+      function moveOrder(id, status) {
+        var o = orders.find(function (x) { return x.id === id; });
+        if (!o || o.status === status) return;
+        var from = o.status;
+        o.status = status;
+        renderColumn(from);
+        renderColumn(status);
+      }
+
+      STATUSES.forEach(function (s) {
+        var el = document.createElement('div');
+        el.className = 'board-column';
+        el.dataset.status = s.id;
+        el.innerHTML = '<h3>' + s.title + ' <span class="count"></span></h3><div class="cards"></div>';
+        board.appendChild(el);
+        bodies[s.id] = { count: el.querySelector('.count'), cards: el.querySelector('.cards') };
+
+        el.addEventListener('dragover', function (e) {
+          if (draggedId === null) return;
+          e.preventDefault();
+          el.classList.add('drag-over');
+        });
+        el.addEventListener('dragleave', function (e) {
+          if (!el.contains(e.relatedTarget)) el.classList.remove('drag-over');
+        });
+        el.addEventListener('drop', function (e) {
+          e.preventDefault();
+          el.classList.remove('drag-over');
+          if (draggedId !== null) moveOrder(draggedId, s.id);
+          draggedId = null;
+        });
+        el.addEventListener('dragstart', function (e) {
+          var card = e.target.closest('.card');
+          if (!card) return;
+          draggedId = Number(card.dataset.id);
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', String(draggedId));
+          card.classList.add('dragging');
+        });
+        el.addEventListener('dragend', function () {
+          draggedId = null;
+          el.classList.remove('drag-over');
+          var d = el.querySelector('.dragging');
+          if (d) d.classList.remove('dragging');
+        });
+        el.addEventListener('click', function (e) {
+          var btn = e.target.closest('[data-move]');
+          if (!btn) return;
+          var id = Number(btn.closest('.card').dataset.id);
+          var i = STATUSES.findIndex(function (x) { return x.id === s.id; });
+          moveOrder(id, STATUSES[i + Number(btn.dataset.move)].id);
+        });
+        renderColumn(s.id);
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
