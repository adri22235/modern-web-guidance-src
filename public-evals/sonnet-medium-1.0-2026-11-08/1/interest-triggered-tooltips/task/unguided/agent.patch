+    /* Tooltips */
+    .tooltip-wrap {
+      position: relative;
+      display: inline-block;
+    }
+
+    .tooltip {
+      position: absolute;
+      bottom: 100%;
+      left: 50%;
+      width: 220px;
+      max-width: 80vw;
+      margin-bottom: 8px;
+      padding: 10px 12px;
+      background: var(--primary);
+      color: white;
+      font-size: 0.8rem;
+      line-height: 1.4;
+      text-align: left;
+      border-radius: 5px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
+      /* Centering fallback for browsers without transform support */
+      margin-left: -110px;
+      visibility: hidden;
+      opacity: 0;
+      transition: opacity 0.2s, visibility 0.2s;
+      pointer-events: none;
+      z-index: 10;
+    }
+
+    .tooltip::after {
+      content: "";
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      margin-left: -6px;
+      border: 6px solid transparent;
+      border-top-color: var(--primary);
+    }
+
+    /* Separate rules so an unsupported selector (:focus-within) can't drop the others */
+    .tooltip-wrap:hover .tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    .tooltip-wrap .btn:focus + .tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    .tooltip-wrap:focus-within .tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    /* Narrower tooltip on small screens */
+    @media (max-width: 400px) {
+      .tooltip {
+        width: 180px;
+        margin-left: -90px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .tooltip {
+        transition: none;
+      }
+    }
   </style>
