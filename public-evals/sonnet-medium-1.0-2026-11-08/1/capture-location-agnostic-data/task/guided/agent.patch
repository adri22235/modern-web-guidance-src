+  <script>
+    // Both values are location-agnostic: the time is a wall-clock "HH:MM" and the
+    // date is a calendar "YYYY-MM-DD". They are stored and submitted as those
+    // strings and never converted through Date (an instant), so travel and time
+    // zone changes cannot shift them.
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import('https://esm.sh/temporal-polyfill');
+          globalThis.Temporal = module.Temporal;
+        } catch {
+          // Offline: fall back to showing the raw stored strings.
+        }
+      }
+
+      const STORAGE_KEY = 'dailyGrindReminders';
+      const form = document.getElementById('reminder-form');
+      const timeInput = document.getElementById('pickup-time');
+      const dateInput = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('reminder-status');
+
+      function describe(time, date) {
+        if (typeof Temporal === 'undefined') return `${time} daily, anniversary ${date}`;
+        const plainTime = Temporal.PlainTime.from(time);
+        const plainDate = Temporal.PlainDate.from(date);
+        const today = Temporal.Now.plainDateISO();
+        let next = plainDate.toPlainMonthDay().toPlainDate({ year: today.year });
+        if (Temporal.PlainDate.compare(next, today) < 0) next = next.add({ years: 1 });
+        const days = today.until(next, { largestUnit: 'days' }).days;
+        return `Reminder at ${plainTime.toLocaleString(undefined, { timeStyle: 'short' })} daily. ` +
+          `Coffee anniversary ${plainDate.toLocaleString(undefined, { dateStyle: 'long' })} ` +
+          `(next in ${days} day${days === 1 ? '' : 's'}).`;
+      }
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (saved) {
+          timeInput.value = saved.pickupTime;
+          dateInput.value = saved.anniversary;
+          status.textContent = describe(saved.pickupTime, saved.anniversary);
+        }
+      } catch {
+        // Ignore unavailable or corrupt storage.
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const pickupTime = data.get('pickup_time');
+        const anniversary = data.get('coffee_anniversary');
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify({ pickupTime, anniversary }));
+        } catch {
+          // Storage unavailable; still confirm below.
+        }
+        status.textContent = 'Saved. ' + describe(pickupTime, anniversary);
+      });
+    })();
+  </script>
+
