+  <script>
+    const searchInput = document.getElementById('search-input');
+    const grid = document.querySelector('.grid');
+
+    function getTextNodes() {
+      const walker = document.createTreeWalker(grid, NodeFilter.SHOW_TEXT);
+      const nodes = [];
+      for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
+      return nodes;
+    }
+
+    function clearHighlights() {
+      if (window.CSS && CSS.highlights) {
+        CSS.highlights.clear();
+        return;
+      }
+      // Fallback: unwrap previously inserted <mark> elements
+      grid.querySelectorAll('mark.search-hit').forEach(mark => mark.replaceWith(mark.textContent));
+      grid.normalize();
+    }
+
+    function highlight(term) {
+      clearHighlights();
+      term = term.trim().toLowerCase();
+      if (!term) return;
+
+      const useApi = window.CSS && CSS.highlights;
+      const ranges = [];
+
+      for (const node of getTextNodes()) {
+        const text = node.textContent;
+        const lower = text.toLowerCase();
+        let pos = lower.indexOf(term);
+        if (pos === -1) continue;
+
+        if (useApi) {
+          for (; pos !== -1; pos = lower.indexOf(term, pos + term.length)) {
+            const range = new Range();
+            range.setStart(node, pos);
+            range.setEnd(node, pos + term.length);
+            ranges.push(range);
+          }
+        } else {
+          const frag = document.createDocumentFragment();
+          let last = 0;
+          for (; pos !== -1; pos = lower.indexOf(term, last)) {
+            frag.append(text.slice(last, pos));
+            const mark = document.createElement('mark');
+            mark.className = 'search-hit';
+            mark.textContent = text.slice(pos, pos + term.length);
+            frag.append(mark);
+            last = pos + term.length;
+          }
+          frag.append(text.slice(last));
+          node.replaceWith(frag);
+        }
+      }
+
+      if (useApi && ranges.length) CSS.highlights.set('search-results', new Highlight(...ranges));
+    }
+
+    searchInput.addEventListener('input', () => highlight(searchInput.value));
+  </script>
+
 </body>
 
