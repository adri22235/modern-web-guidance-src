+
+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const grid = document.getElementById('favorites-grid');
+      const status = document.getElementById('favorites-status');
+      const filters = document.getElementById('favorites-filters');
+      const search = document.getElementById('favorites-search');
+      const items = [...bar.querySelectorAll('button')];
+      const cards = [...grid.querySelectorAll('.card')];
+      const say = (msg) => { status.textContent = ''; requestAnimationFrame(() => (status.textContent = msg)); };
+
+      // View switching (mutually exclusive)
+      bar.querySelectorAll('[data-view]').forEach((b) => b.addEventListener('click', () => {
+        bar.querySelectorAll('[data-view]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
+        grid.classList.toggle('list-view', b.dataset.view === 'list');
+        say(b.dataset.view === 'list' ? 'List view' : 'Grid view');
+      }));
+
+      document.getElementById('toggle-details').addEventListener('click', (e) => {
+        const on = e.currentTarget.getAttribute('aria-pressed') !== 'true';
+        e.currentTarget.setAttribute('aria-pressed', String(on));
+        grid.classList.toggle('hide-details', !on);
+        say(on ? 'Details shown' : 'Details hidden');
+      });
+
+      const applyFilter = () => {
+        const q = filters.hidden ? '' : search.value.trim().toLowerCase();
+        cards.forEach((c) => (c.hidden = !c.querySelector('h3').textContent.toLowerCase().includes(q)));
+      };
+      document.getElementById('toggle-filters').addEventListener('click', (e) => {
+        const on = e.currentTarget.getAttribute('aria-pressed') !== 'true';
+        e.currentTarget.setAttribute('aria-pressed', String(on));
+        filters.hidden = !on;
+        applyFilter();
+        if (on) search.focus();
+        say(on ? 'Filters shown' : 'Filters hidden');
+      });
+      search.addEventListener('input', applyFilter);
+
+      // Copy the featured drinks list
+      const copyBtn = document.getElementById('copy-favorites');
+      let timer;
+      copyBtn.addEventListener('click', async () => {
+        const text = cards
+          .map((c) => `${c.querySelector('h3').textContent}: ${c.querySelector('p').textContent}`)
+          .join('\n');
+        let ok = true;
+        try { await navigator.clipboard.writeText(text); } catch { ok = false; }
+        clearTimeout(timer);
+        copyBtn.toggleAttribute('data-copied', ok);
+        say(ok ? 'Featured drinks copied' : 'Copy failed');
+        timer = setTimeout(() => copyBtn.removeAttribute('data-copied'), 2000);
+      });
+
+      // Roving tab stop where native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener('keydown', (e) => {
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const i = items.indexOf(document.activeElement);
+          if (i < 0) return;
+          const steps = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          let next;
+          if (e.key in steps) next = (i + steps[e.key] + items.length) % items.length;
+          else if (e.key === 'Home') next = 0;
+          else if (e.key === 'End') next = items.length - 1;
+          else return;
+          e.preventDefault();
+          items[next].focus();
+        });
+      }
+    })();
+  </script>
+
