+  <script>
+    (function () {
+      var list = document.getElementById('favorites-list');
+      var toolbar = document.getElementById('favorites-actions');
+      var filterBar = document.getElementById('favorites-filter');
+      var search = document.getElementById('favorites-search');
+      var status = document.getElementById('favorites-status');
+      var detailsBtn = document.getElementById('toggle-details');
+      var filtersBtn = document.getElementById('toggle-filters');
+      var cards = Array.prototype.slice.call(list.querySelectorAll('.card'));
+
+      function setView(view) {
+        list.classList.toggle('list-view', view === 'list');
+        toolbar.querySelectorAll('[data-view]').forEach(function (b) {
+          b.setAttribute('aria-pressed', String(b.dataset.view === view));
+        });
+      }
+      toolbar.querySelectorAll('[data-view]').forEach(function (b) {
+        b.addEventListener('click', function () { setView(b.dataset.view); });
+      });
+
+      function applyFilter() {
+        var q = filterBar.hidden ? '' : search.value.trim().toLowerCase();
+        cards.forEach(function (c) {
+          var name = c.querySelector('h3').textContent.toLowerCase();
+          c.hidden = q !== '' && name.indexOf(q) === -1;
+        });
+      }
+
+      detailsBtn.addEventListener('click', function () {
+        var on = detailsBtn.getAttribute('aria-pressed') !== 'true';
+        detailsBtn.setAttribute('aria-pressed', String(on));
+        list.classList.toggle('hide-details', !on);
+      });
+
+      filtersBtn.addEventListener('click', function () {
+        var on = filtersBtn.getAttribute('aria-pressed') !== 'true';
+        filtersBtn.setAttribute('aria-pressed', String(on));
+        filterBar.hidden = !on;
+        if (on) search.focus();
+        applyFilter();
+      });
+      search.addEventListener('input', applyFilter);
+
+      document.getElementById('copy-favorites').addEventListener('click', function () {
+        var text = cards.map(function (c) {
+          return c.querySelector('h3').textContent;
+        }).join('\n');
+        var done = function (msg) { status.textContent = msg; };
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          navigator.clipboard.writeText(text).then(
+            function () { done('Featured drinks copied'); },
+            function () { done('Copy failed'); }
+          );
+        } else {
+          done('Copy not supported');
+        }
+      });
+    })();
+  </script>
