+  <script>
+    class DrinkCard extends HTMLElement {
+      #button;
+
+      static observedAttributes = ['favorited'];
+
+      constructor() {
+        super();
+        // Reuse the server-rendered (declarative) shadow root; never re-render it.
+        if (!this.shadowRoot) {
+          // Browsers without Declarative Shadow DOM leave the template inert: attach it manually.
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          if (tpl) {
+            this.attachShadow({ mode: 'open' }).append(tpl.content);
+            tpl.remove();
+          }
+        }
+        this.#button = this.shadowRoot?.querySelector('.fav');
+        this.#button?.addEventListener('click', () => this.toggleAttribute('favorited'));
+      }
+
+      attributeChangedCallback() {
+        if (!this.#button) return;
+        const on = this.hasAttribute('favorited');
+        this.#button.setAttribute('aria-pressed', on);
+        this.#button.textContent = on ? '\u2665 Favorited' : '\u2661 Favorite';
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
