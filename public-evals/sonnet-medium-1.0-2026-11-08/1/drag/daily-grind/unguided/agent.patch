+  <aside class="quick-order" data-draggable aria-label="Quick order">
+    <div class="qo-header" data-drag-handle>
+      <span>☕ Quick Order</span>
+      <button type="button" class="qo-toggle" aria-label="Collapse quick order" aria-expanded="true">−</button>
+    </div>
+    <form class="qo-body" id="qo-form">
+      <label>Drink
+        <select id="qo-drink">
+          <option value="4.50">Maple Oat Latte — $4.50</option>
+          <option value="3.25">Dark Roast Espresso — $3.25</option>
+          <option value="4.00">Cold Brew — $4.00</option>
+        </select>
+      </label>
+      <label>Size
+        <select id="qo-size">
+          <option value="0">Small</option>
+          <option value="0.5" selected>Medium (+$0.50)</option>
+          <option value="1">Large (+$1.00)</option>
+        </select>
+      </label>
+      <div class="qo-qty">
+        <span>Quantity</span>
+        <div>
+          <button type="button" id="qo-minus" aria-label="Decrease quantity">−</button>
+          <output id="qo-count">1</output>
+          <button type="button" id="qo-plus" aria-label="Increase quantity">+</button>
+        </div>
+      </div>
+      <div class="qo-total"><span>Total</span><span id="qo-total">$5.00</span></div>
+      <button type="submit" class="btn qo-add">Add to Order</button>
+      <div class="qo-status" role="status" aria-live="polite"></div>
+    </form>
+  </aside>
+
+  <script>
+    (function () {
+      var panel = document.querySelector('[data-draggable]');
+      var handle = panel.querySelector('[data-drag-handle]');
+      var toggle = panel.querySelector('.qo-toggle');
+
+      // Dragging (pointer events cover mouse, touch and pen)
+      var startX, startY, originX, originY;
+
+      function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.target.closest('button') || (e.pointerType === 'mouse' && e.button !== 0)) return;
+        var rect = panel.getBoundingClientRect();
+        // Switch from right/bottom anchoring to explicit left/top
+        panel.style.left = rect.left + 'px';
+        panel.style.top = rect.top + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        startX = e.clientX; startY = e.clientY;
+        originX = rect.left; originY = rect.top;
+        panel.classList.add('dragging');
+        handle.setPointerCapture(e.pointerId);
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!panel.classList.contains('dragging')) return;
+        var maxX = window.innerWidth - panel.offsetWidth;
+        var maxY = window.innerHeight - panel.offsetHeight;
+        panel.style.left = clamp(originX + e.clientX - startX, 0, Math.max(0, maxX)) + 'px';
+        panel.style.top = clamp(originY + e.clientY - startY, 0, Math.max(0, maxY)) + 'px';
+      });
+
+      function endDrag(e) {
+        panel.classList.remove('dragging');
+        if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      // Keep the panel on-screen after resize
+      window.addEventListener('resize', function () {
+        if (!panel.style.left) return;
+        var r = panel.getBoundingClientRect();
+        panel.style.left = clamp(r.left, 0, Math.max(0, window.innerWidth - r.width)) + 'px';
+        panel.style.top = clamp(r.top, 0, Math.max(0, window.innerHeight - r.height)) + 'px';
+      });
+
+      // Collapse / expand
+      toggle.addEventListener('click', function () {
+        var collapsed = panel.classList.toggle('collapsed');
+        toggle.textContent = collapsed ? '+' : '−';
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', collapsed ? 'Expand quick order' : 'Collapse quick order');
+      });
+
+      // Order controls
+      var drink = document.getElementById('qo-drink');
+      var size = document.getElementById('qo-size');
+      var count = document.getElementById('qo-count');
+      var total = document.getElementById('qo-total');
+      var status = panel.querySelector('.qo-status');
+      var qty = 1;
+
+      function update() {
+        count.textContent = qty;
+        total.textContent = '$' + ((parseFloat(drink.value) + parseFloat(size.value)) * qty).toFixed(2);
+      }
+      document.getElementById('qo-minus').addEventListener('click', function () { qty = Math.max(1, qty - 1); update(); });
+      document.getElementById('qo-plus').addEventListener('click', function () { qty = Math.min(10, qty + 1); update(); });
+      drink.addEventListener('change', update);
+      size.addEventListener('change', update);
+
+      document.getElementById('qo-form').addEventListener('submit', function (e) {
+        e.preventDefault();
+        var name = drink.options[drink.selectedIndex].text.split(' — ')[0];
+        status.textContent = 'Added ' + qty + ' × ' + name + ' (' + total.textContent + ')';
+      });
+      update();
+    })();
+  </script>
+
 </body>
 
 </html>
