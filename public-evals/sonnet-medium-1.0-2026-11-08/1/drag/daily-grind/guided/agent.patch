+      display: flex;
+      gap: 12px;
+      flex-wrap: wrap;
+    }
+
+    .quick-order fieldset label {
+      font-weight: normal;
+    }
+
+    .quick-order legend {
+      margin-bottom: 4px;
+    }
+
+    .quick-order select {
