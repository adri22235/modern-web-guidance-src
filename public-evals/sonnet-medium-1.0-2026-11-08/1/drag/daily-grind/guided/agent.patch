+  <aside class="quick-order" data-draggable aria-labelledby="qo-title">
+    <div class="quick-order-header" data-drag-handle id="qo-header">
+      <span id="qo-title">&#9749; Quick Order</span>
+      <button type="button" class="quick-order-toggle" aria-expanded="true" aria-controls="qo-body" aria-label="Collapse quick order">&minus;</button>
+    </div>
+    <form class="quick-order-body" id="qo-body">
+      <div>
+        <label for="qo-drink">Drink</label>
+        <select id="qo-drink" name="drink">
+          <option value="4.50">Maple Oat Latte &ndash; $4.50</option>
+          <option value="3.25">Dark Roast Espresso &ndash; $3.25</option>
+          <option value="4.00">Cold Brew &ndash; $4.00</option>
+        </select>
+      </div>
+      <fieldset>
+        <legend>Size</legend>
+        <label><input type="radio" name="size" value="0" checked> Small</label>
+        <label><input type="radio" name="size" value="0.5"> Medium (+$0.50)</label>
+        <label><input type="radio" name="size" value="1"> Large (+$1.00)</label>
+      </fieldset>
+      <div class="qty">
+        <label for="qo-qty">Qty</label>
+        <button type="button" data-qty="-1" aria-label="Decrease quantity">&minus;</button>
+        <output id="qo-qty" aria-live="polite">1</output>
+        <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
+      </div>
+      <div class="quick-order-total"><span>Total</span><output id="qo-total">$4.50</output></div>
+      <button type="submit" class="btn">Place Order</button>
+      <p class="quick-order-status" role="status"></p>
+    </form>
+  </aside>
+
+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      const form = panel.querySelector('form');
+      const toggle = panel.querySelector('.quick-order-toggle');
+      const qtyOut = form.querySelector('#qo-qty');
+      const totalOut = form.querySelector('#qo-total');
+      const status = form.querySelector('.quick-order-status');
+      let qty = 1;
+
+      // Order controls
+      const update = () => {
+        const base = parseFloat(form.drink.value);
+        const size = parseFloat(form.size.value);
+        qtyOut.value = qty;
+        totalOut.value = '$' + ((base + size) * qty).toFixed(2);
+      };
+      form.addEventListener('input', () => { status.textContent = ''; update(); });
+      form.querySelectorAll('[data-qty]').forEach((b) =>
+        b.addEventListener('click', () => {
+          qty = Math.min(10, Math.max(1, qty + Number(b.dataset.qty)));
+          status.textContent = '';
+          update();
+        }));
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const name = form.drink.selectedOptions[0].text.split(' \u2013')[0];
+        status.textContent = `Ordered ${qty} \u00d7 ${name} (${totalOut.value}). See you soon!`;
+      });
+      toggle.addEventListener('click', () => {
+        const open = form.hidden;
+        form.hidden = !open;
+        toggle.setAttribute('aria-expanded', String(open));
+        toggle.setAttribute('aria-label', (open ? 'Collapse' : 'Expand') + ' quick order');
+        toggle.innerHTML = open ? '&minus;' : '+';
+        moveTo(panel.offsetLeft, panel.offsetTop);
+      });
+      update();
+
+      // Dragging (enabled only when JS runs)
+      panel.classList.add('is-enhanced');
+      handle.tabIndex = 0;
+      handle.setAttribute('role', 'group');
+      handle.setAttribute('aria-label', 'Quick order. Drag handle: use arrow keys to move the panel');
+
+      let offsetX = 0, offsetY = 0, placed = false;
+
+      function moveTo(left, top) {
+        // Switch from CSS right/bottom anchoring to explicit left/top
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        placed = true;
+      }
+
+      handle.addEventListener('pointerdown', (e) => {
+        if (e.button !== 0 || e.target.closest('button, input, select, textarea, a')) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = e.clientX - rect.left;
+        offsetY = e.clientY - rect.top;
+        handle.setPointerCapture(e.pointerId);
+      });
+      handle.addEventListener('pointermove', (e) => {
+        if (!handle.hasPointerCapture(e.pointerId)) return;
+        handle.classList.add('dragging');
+        moveTo(e.clientX - offsetX, e.clientY - offsetY);
+      });
+      handle.addEventListener('lostpointercapture', () => handle.classList.remove('dragging'));
+
+      handle.addEventListener('keydown', (e) => {
+        if (e.target !== handle) return;
+        const step = 15;
+        const d = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
+        if (!d) return;
+        e.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + d[0], rect.top + d[1]);
+      });
+
+      window.addEventListener('resize', () => {
+        if (!placed) return;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
