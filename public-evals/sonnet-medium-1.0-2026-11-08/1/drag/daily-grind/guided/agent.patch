+    /* Quick-order panel */
+    .quick-order {
+      position: fixed;
+      right: 20px;
+      bottom: 20px;
+      width: min(300px, calc(100vw - 40px));
+      background: white;
+      border-radius: 10px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      z-index: 900;
+      overflow: hidden;
+    }
+
+    .quick-order-header {
+      background: var(--primary);
+      color: white;
+      padding: 10px 14px;
+      font-weight: bold;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    .quick-order.is-enhanced .quick-order-header {
+      cursor: grab;
+      touch-action: none;
+      -webkit-user-select: none;
+      user-select: none;
+    }
+
+    .quick-order-header.dragging {
+      cursor: grabbing;
+    }
+
+    .quick-order-header:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .quick-order-toggle {
+      background: transparent;
+      color: white;
+      border: 1px solid var(--accent);
+      border-radius: 4px;
+      width: 28px;
+      height: 28px;
+      font-size: 1rem;
+      cursor: pointer;
+    }
+
+    .quick-order-body {
+      padding: 14px;
+      display: grid;
+      gap: 12px;
+    }
+
+    .quick-order-body[hidden] {
+      display: none;
+    }
+
+    .quick-order label,
+    .quick-order legend {
+      font-size: 0.85rem;
+      font-weight: 600;
+    }
+
+    .quick-order fieldset {
