+  <script>
+    (function () {
+      var section = document.querySelector('.parallax');
+      if (!section) return;
+      var motion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var layers = Array.prototype.map.call(section.querySelectorAll('.parallax-layer'), function (el) {
+        return { el: el, speed: parseFloat(el.dataset.speed) || 0 };
+      });
+      var visible = false, ticking = false, listening = false;
+
+      function update() {
+        ticking = false;
+        var rect = section.getBoundingClientRect();
+        // Offset from the section being centered in the viewport
+        var offset = rect.top + rect.height / 2 - window.innerHeight / 2;
+        // Max travel is bounded by the layers' overscan (15-20% of height)
+        var limit = rect.height * 0.15;
+        layers.forEach(function (l) {
+          var y = Math.max(-limit, Math.min(limit, offset * (l.speed - 0.5) * -0.6));
+          l.el.style.transform = 'translate3d(0,' + y.toFixed(1) + 'px,0)';
+        });
+      }
+
+      function onScroll() {
+        if (!ticking) { ticking = true; requestAnimationFrame(update); }
+      }
+
+      function sync() {
+        var shouldRun = visible && !motion.matches;
+        if (shouldRun && !listening) {
+          window.addEventListener('scroll', onScroll, { passive: true });
+          window.addEventListener('resize', onScroll, { passive: true });
+          listening = true;
+          update();
+        } else if (!shouldRun && listening) {
+          window.removeEventListener('scroll', onScroll);
+          window.removeEventListener('resize', onScroll);
+          listening = false;
+        }
+        if (motion.matches) layers.forEach(function (l) { l.el.style.transform = ''; });
+      }
+
+      // Only do work while the section is on screen
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          visible = entries[0].isIntersecting;
+          sync();
+        }, { rootMargin: '100px 0px' }).observe(section);
+      } else {
+        visible = true;
+      }
+      if (motion.addEventListener) motion.addEventListener('change', sync);
+      sync();
+    })();
+  </script>
