+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      height: 70vh;
+      min-height: 420px;
+      overflow: hidden;
+      isolation: isolate;
+      color: white;
+      background: var(--primary);
+    }
+
+    .parallax-layer {
+      position: absolute;
+      left: 0;
+      right: 0;
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    /* Layers are oversized vertically so they can travel without exposing edges */
+    .parallax-bg {
+      top: -20%;
+      bottom: -20%;
+      background: linear-gradient(rgba(30, 15, 10, 0.55), rgba(30, 15, 10, 0.55)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1350&q=70');
+      background-size: cover;
+      background-position: center;
+      z-index: 0;
+    }
+
+    .parallax-mid,
+    .parallax-front {
+      top: -15%;
+      bottom: -15%;
+      z-index: 1;
+    }
+
+    .parallax-front {
+      z-index: 2;
+    }
+
+    .bean {
+      position: absolute;
+      width: var(--s);
+      height: calc(var(--s) * 1.4);
+      left: var(--x);
+      top: var(--y);
+      border-radius: 50%;
+      background: radial-gradient(ellipse at 35% 30%, #8d6e63, #3e2723 70%);
+      transform: rotate(var(--r));
+      opacity: var(--o, 0.9);
