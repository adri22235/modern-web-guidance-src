+      bottom: 8%;
+      width: 8%;
+      background: rgba(0, 0, 0, 0.55);
+      border-radius: 50%;
+      transform: translateX(-50%) rotate(12deg);
+    }
+
+    .parallax-content {
+      position: relative;
+      z-index: 3;
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .parallax-content h2 {
+      font-size: 2.2rem;
+      margin-bottom: 0.75rem;
+      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
