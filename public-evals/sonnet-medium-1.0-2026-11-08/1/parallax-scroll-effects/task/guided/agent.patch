+    /* Parallax Section */
+    .parallax {
+      position: relative;
+      height: 80vh;
+      min-height: 480px;
+      overflow: clip;
+      background: var(--primary);
+      color: white;
+      isolation: isolate;
+      view-timeline: --parallax block;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    .parallax-bg {
+      /* Oversized so translation never exposes the edges */
+      inset: -25% 0;
+      background: linear-gradient(rgba(30, 15, 10, 0.65), rgba(30, 15, 10, 0.65)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1350&q=70');
+      background-size: cover;
+      background-position: center;
+      --shift: 15vh;
+    }
+
+    .parallax-beans {
+      --shift: 35vh;
+    }
+
+    .parallax-beans i {
+      position: absolute;
+      width: var(--size);
+      height: calc(var(--size) * 0.65);
+      left: var(--x);
+      top: var(--y);
+      border-radius: 50%;
+      background: radial-gradient(ellipse at 30% 30%, #8d6e63, #3e2723 70%);
+      transform: rotate(var(--r));
+      opacity: 0.85;
+    }
+
+    .parallax-beans i::after {
+      content: '';
+      position: absolute;
+      left: 8%;
+      right: 8%;
+      top: 47%;
+      height: 6%;
+      border-radius: 4px;
+      background: rgba(0, 0, 0, 0.45);
+    }
+
+    .parallax-steam {
+      --shift: 60vh;
+    }
+
+    .parallax-steam i {
+      position: absolute;
+      left: var(--x);
+      top: var(--y);
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      background: radial-gradient(circle, rgba(255, 171, 64, 0.35), transparent 70%);
+    }
+
+    .parallax-content {
+      position: relative;
+      z-index: 1;
+      height: 100%;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      text-align: center;
+      padding: 0 20px;
+      --shift: 6vh;
+    }
+
+    .parallax-content h2 {
+      font-size: 2.25rem;
+      margin-bottom: 1rem;
+    }
+
+    .parallax-content p {
+      max-width: 36rem;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        @keyframes parallax-drift {
+          from {
+            transform: translate3d(0, var(--shift), 0);
+          }
+
+          to {
+            transform: translate3d(0, calc(var(--shift) * -1), 0);
+          }
+        }
+
+        .parallax-layer {
+          will-change: transform;
+          animation: parallax-drift linear both;
+          animation-timeline: --parallax;
+          animation-range: cover;
+        }
+      }
+    }
+
