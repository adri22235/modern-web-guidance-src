+  <script>
+    const TARGET_ZONES = [
+      ['Tokyo', 'Asia/Tokyo'], ['Sydney', 'Australia/Sydney'], ['Singapore', 'Asia/Singapore'],
+      ['Mumbai', 'Asia/Kolkata'], ['Dubai', 'Asia/Dubai'], ['London', 'Europe/London'],
+      ['Berlin', 'Europe/Berlin'], ['São Paulo', 'America/Sao_Paulo'], ['New York', 'America/New_York'],
+      ['Chicago', 'America/Chicago'], ['Los Angeles', 'America/Los_Angeles'], ['Honolulu', 'Pacific/Honolulu']
+    ];
+    const HOST_ZONES = [['UTC', 'UTC'], ...TARGET_ZONES.map(([n, z]) => [n + ' (' + z + ')', z])];
+
+    const $ = id => document.getElementById(id);
+    const fmtCache = {};
+    function parts(ms, tz) {
+      const f = fmtCache[tz] || (fmtCache[tz] = new Intl.DateTimeFormat('en-US', {
+        timeZone: tz, hourCycle: 'h23', year: 'numeric', month: 'numeric', day: 'numeric',
+        hour: 'numeric', minute: 'numeric', second: 'numeric'
+      }));
+      const o = {};
+      for (const p of f.formatToParts(new Date(ms))) o[p.type] = +p.value;
+      return o;
+    }
+    // Offset (ms) of tz from UTC at the given instant.
+    function offsetAt(ms, tz) {
+      const p = parts(ms, tz);
+      return Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second) - Math.floor(ms / 1000) * 1000;
+    }
+    // All instants whose wall-clock time in tz equals the given wall time (0 = gap, 2 = overlap).
+    function resolveWall(y, mo, d, h, mi, tz) {
+      const wall = Date.UTC(y, mo - 1, d, h, mi);
+      const offsets = new Set([offsetAt(wall - 864e5, tz), offsetAt(wall + 864e5, tz)]);
+      const hits = [];
+      for (const off of offsets) {
+        const utc = wall - off;
+        if (offsetAt(utc, tz) === off) hits.push(utc);
+      }
+      return hits.sort((a, b) => a - b);
+    }
+
+    function render() {
+      const msg = $('plannerMsg'), grid = $('grid');
+      grid.innerHTML = '';
+      msg.className = '';
+      msg.textContent = '';
+      const date = $('dateInput').value, time = $('timeInput').value, host = $('hostTzSelect').value;
+      if (!date || !time) { msg.textContent = 'Pick a date and time to see the tasting across the globe.'; return; }
+      const [y, mo, d] = date.split('-').map(Number);
+      const [h, mi] = time.split(':').map(Number);
+      const hits = resolveWall(y, mo, d, h, mi, host);
+      if (!hits.length) {
+        msg.className = 'error';
+        msg.textContent = date + ' ' + time + ' does not exist in ' + host +
+          ' (skipped by a daylight saving transition). Please choose a different time.';
+        return;
+      }
+      if (hits.length > 1) {
+        msg.className = 'note';
+        msg.textContent = time + ' occurs twice in ' + host + ' on this date (clocks go back); using the first occurrence.';
+      }
+      const instant = hits[0];
+      for (const [city, tz] of TARGET_ZONES) {
+        const dt = new Date(instant);
+        const tfmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
+        const dfmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
+        const nfmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, timeZoneName: 'short' });
+        const abbr = nfmt.formatToParts(dt).find(p => p.type === 'timeZoneName').value;
+        const off = offsetAt(instant, tz) / 36e5;
+        const offStr = 'UTC' + (off < 0 ? '-' : '+') + Math.floor(Math.abs(off)) + (Math.abs(off) % 1 ? ':' + String(Math.round((Math.abs(off) % 1) * 60)).padStart(2, '0') : '');
+        const dst = offsetAt(Date.UTC(y, 0, 1), tz) !== offsetAt(Date.UTC(y, 6, 1), tz) &&
+          off * 36e5 === Math.max(offsetAt(Date.UTC(y, 0, 1), tz), offsetAt(Date.UTC(y, 6, 1), tz));
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.dataset.tz = tz;
+        const h3 = document.createElement('h3'); h3.textContent = city;
+        const t = document.createElement('div'); t.className = 'time'; t.textContent = tfmt.format(dt);
+        const dd = document.createElement('div'); dd.textContent = dfmt.format(dt);
+        const m = document.createElement('div'); m.className = 'meta';
+        m.textContent = tz + ' · ' + abbr + ' · ' + offStr;
+        if (dst) { const b = document.createElement('span'); b.className = 'badge'; b.textContent = 'DST'; m.append(b); }
+        card.append(h3, t, dd, m);
+        grid.append(card);
+      }
+    }
+
+    (function init() {
+      const sel = $('hostTzSelect');
+      for (const [label, tz] of HOST_ZONES) sel.add(new Option(label, tz));
+      let local = Intl.DateTimeFormat().resolvedOptions().timeZone;
+      if (![...sel.options].some(o => o.value === local)) sel.add(new Option(local, local));
+      sel.value = local;
+      const now = new Date();
+      $('dateInput').value = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
+      $('timeInput').value = '10:00';
+      for (const id of ['dateInput', 'timeInput', 'hostTzSelect']) {
+        $(id).addEventListener('input', render);
+        $(id).addEventListener('change', render);
+      }
+      $('plannerForm').addEventListener('submit', e => e.preventDefault());
+      render();
+    })();
+  </script>
 </body>
 
 </html>
