+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const ZONES = [
+      ['Pacific/Honolulu', 'Honolulu'],
+      ['America/Los_Angeles', 'Los Angeles'],
+      ['America/Denver', 'Denver'],
+      ['America/Chicago', 'Chicago'],
+      ['America/New_York', 'New York'],
+      ['America/Sao_Paulo', 'São Paulo'],
+      ['UTC', 'UTC'],
+      ['Europe/London', 'London'],
+      ['Europe/Berlin', 'Berlin'],
+      ['Africa/Cairo', 'Cairo'],
+      ['Asia/Dubai', 'Dubai'],
+      ['Asia/Kolkata', 'Mumbai / Kolkata'],
+      ['Asia/Singapore', 'Singapore'],
+      ['Asia/Tokyo', 'Tokyo'],
+      ['Australia/Sydney', 'Sydney'],
+      ['Pacific/Auckland', 'Auckland'],
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const errorEl = document.getElementById('error');
+
+    for (const [id, label] of ZONES) hostTzSelect.add(new Option(`${label} (${id})`, id));
+    const local = Intl.DateTimeFormat().resolvedOptions().timeZone;
+    hostTzSelect.value = ZONES.some(([id]) => id === local) ? local : 'America/New_York';
+
+    function showError(msg) {
+      errorEl.textContent = msg;
+      errorEl.hidden = false;
+      grid.replaceChildren();
+    }
+
+    function el(tag, cls, text) {
+      const e = document.createElement(tag);
+      if (cls) e.className = cls;
+      e.textContent = text;
+      return e;
+    }
+
+    function render() {
+      errorEl.hidden = true;
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const tz = hostTzSelect.value;
+      if (!date || !time) return showError('Please enter both a date and a time.');
+
+      let host;
+      try {
+        // 'reject' throws RangeError for skipped (gap) or repeated (overlap) wall-clock times
+        host = Temporal.ZonedDateTime.from(`${date}T${time}[${tz}]`, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          return showError(`${time} on ${date} is not a valid time in ${tz}: it is skipped or repeated during a daylight saving transition. Please choose a different time.`);
+        }
+        throw e;
+      }
+
+      const cards = ZONES.map(([id, label]) => {
+        const z = host.withTimeZone(id);
+        const dayDiff = z.toPlainDate().since(host.toPlainDate()).days;
+        const card = el('article', id === tz ? 'card host' : 'card');
+        card.append(
+          el('div', 'city', id === tz ? `${label} · Host` : label),
+          el('div', 'time', z.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' })),
+          el('div', 'meta', z.toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })),
+          el('div', 'meta', `${z.toLocaleString('en-US', { timeZoneName: 'short' }).split(' ').pop()} (UTC${z.offset})` +
+            (dayDiff ? ` · ${dayDiff > 0 ? '+' : ''}${dayDiff} day` : '')),
+        );
+        card.dataset.tz = id;
+        return card;
+      });
+      grid.replaceChildren(...cards);
+    }
+
+    for (const input of [dateInput, timeInput, hostTzSelect]) {
+      input.addEventListener('input', render);
+      input.addEventListener('change', render);
+    }
+    render();
+  </script>
 </body>
 
