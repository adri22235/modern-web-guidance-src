+  <script>
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+      static observedAttributes = ['max', 'required', 'value'];
+
+      #internals = this.attachInternals();
+      #value = 0;
+      #stars = [];
+      #root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+
+      constructor() {
+        super();
+        this.#root.innerHTML = `
+          <style>
+            :host { display: inline-block; }
+            :host([hidden]) { display: none; }
+            .stars { display: inline-flex; gap: 2px; }
+            .star {
+              all: unset;
+              cursor: pointer;
+              font-size: 2rem;
+              line-height: 1;
+              color: #bdbdbd;
+              padding: 0 2px;
+              border-radius: 4px;
+            }
+            .star.on { color: var(--star-color, #ffab40); }
+            .star:focus-visible { outline: 2px solid var(--star-focus, #4e342e); outline-offset: 2px; }
+            :host(:state(disabled)) .star { cursor: not-allowed; color: #e0e0e0; }
+            :host(:state(disabled)) .star.on { color: #c9b79c; }
+          </style>
+          <div class="stars" part="stars"></div>`;
+        this.#root.addEventListener('click', (e) => {
+          const star = e.target.closest('.star');
+          if (star && !this.disabled) this.#commit(Number(star.dataset.v));
+        });
+        this.#root.addEventListener('keydown', (e) => this.#onKey(e));
+      }
+
+      connectedCallback() {
+        this.#internals.role = 'radiogroup';
+        this.#render();
+        this.#validate();
+      }
+
+      attributeChangedCallback(name, _old, val) {
+        if (name === 'max') this.#render();
+        else if (name === 'value') this.#setValue(val);
+        else this.#validate();
+      }
+
+      get max() {
+        const n = parseInt(this.getAttribute('max'), 10);
+        return n > 0 ? n : 5;
+      }
+      get name() { return this.getAttribute('name') ?? ''; }
+      get required() { return this.hasAttribute('required'); }
+      set required(v) { this.toggleAttribute('required', Boolean(v)); }
+      get disabled() { return this.#internals.states.has('disabled'); }
+      get value() { return this.#value ? String(this.#value) : ''; }
+      set value(v) { this.#setValue(v); }
+      get form() { return this.#internals.form; }
+      get validity() { return this.#internals.validity; }
+      get validationMessage() { return this.#internals.validationMessage; }
+      get willValidate() { return this.#internals.willValidate; }
+      checkValidity() { return this.#internals.checkValidity(); }
+      reportValidity() { return this.#internals.reportValidity(); }
+
+      // Form-associated lifecycle callbacks
+      formResetCallback() { this.#setValue(this.getAttribute('value')); }
+      formDisabledCallback(disabled) {
+        if (disabled) this.#internals.states.add('disabled');
+        else this.#internals.states.delete('disabled');
+        this.#render();
+      }
+      formStateRestoreCallback(state) { this.#setValue(state); }
+
+      #setValue(v) {
+        const n = Math.round(Number(v));
+        this.#value = n >= 1 && n <= this.max ? n : 0;
+        this.#sync();
+      }
+
+      #commit(n) {
+        this.#value = n;
+        this.#sync();
+        this.#stars[n - 1]?.focus();
+        this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+      }
+
+      #onKey(e) {
+        if (this.disabled) return;
+        const cur = this.#value;
+        let next;
+        switch (e.key) {
+          case 'ArrowRight': case 'ArrowUp': next = Math.min(this.max, cur + 1); break;
+          case 'ArrowLeft': case 'ArrowDown': next = Math.max(1, cur - 1); break;
+          case 'Home': next = 1; break;
+          case 'End': next = this.max; break;
+          case ' ': case 'Enter': next = Number(e.target.dataset.v); break;
+          default: return;
+        }
+        e.preventDefault();
+        if (next !== cur) this.#commit(next);
+        else this.#stars[next - 1]?.focus();
+      }
+
+      #render() {
+        const box = this.#root.querySelector('.stars');
+        if (!box) return;
+        box.replaceChildren();
+        this.#stars = Array.from({ length: this.max }, (_, i) => {
+          const b = document.createElement('button');
+          b.type = 'button';
+          b.className = 'star';
+          b.dataset.v = i + 1;
+          b.setAttribute('role', 'radio');
+          b.setAttribute('aria-label', `${i + 1} star${i ? 's' : ''}`);
+          b.textContent = '★';
+          b.disabled = this.disabled;
+          box.append(b);
+          return b;
+        });
+        this.#sync();
+      }
+
+      #sync() {
+        this.#stars.forEach((b, i) => {
+          const v = i + 1;
+          b.classList.toggle('on', v <= this.#value);
+          b.setAttribute('aria-checked', String(v === this.#value));
+          // Roving tabindex: checked star, or the first one when nothing is chosen.
+          b.tabIndex = v === (this.#value || 1) ? 0 : -1;
+        });
+        // State argument lets the browser restore the value after navigation/reload.
+        this.#internals.setFormValue(this.#value ? String(this.#value) : null, this.value);
+        this.#validate();
+      }
+
+      #validate() {
+        if (this.required && !this.#value) {
+          this.#internals.setValidity(
+            { valueMissing: true },
+            'Please select a rating.',
+            this.#stars[0]
+          );
+        } else {
+          this.#internals.setValidity({});
+        }
+      }
+    }
+    customElements.define('star-rating', StarRating);
+
+    const form = document.getElementById('feedback-form');
+    const rating = form.querySelector('star-rating');
+    const ratingError = document.getElementById('rating-error');
+    const status = document.getElementById('feedback-status');
+
+    const showRatingError = () => {
+      ratingError.textContent = rating.validity.valid ? '' : rating.validationMessage;
+    };
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!form.reportValidity()) return;
+      const data = new FormData(form);
+      // No backend yet: acknowledge locally instead of navigating away.
+      status.textContent = `Thanks! You rated the ${data.get('coffee')} ${data.get('rating')}/5.`;
+    });
+    // Fires for the first invalid control (including the star rating) on submit.
+    form.addEventListener('invalid', showRatingError, true);
+    rating.addEventListener('change', () => { showRatingError(); status.textContent = ''; });
+    form.addEventListener('reset', () => {
+      ratingError.textContent = '';
+      status.textContent = '';
+    });
+  </script>
