diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..80eb3f8
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,176 @@
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'max'];
+
+  #internals;
+  #value = '';
+  #touched = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host { display: inline-block; }
+        .stars { display: flex; gap: 0.25rem; }
+        button {
+          all: unset;
+          cursor: pointer;
+          font-size: var(--star-size, 2rem);
+          line-height: 1;
+          color: var(--star-off, #888);
+          padding: 0.1em;
+          border-radius: 4px;
+        }
+        button[data-on] { color: var(--star-on, orange); }
+        button:focus-visible { outline: 3px solid #0b57d0; outline-offset: 2px; }
+        button:disabled { cursor: not-allowed; }
+        .error { color: #b3261e; font-size: 0.9rem; margin-block-start: 0.25rem; }
+        .error[hidden] { display: none; }
+      </style>
+      <div class="stars"></div>
+      <div class="error" role="alert" hidden></div>`;
+    this.shadowRoot.addEventListener('click', (e) => {
+      const btn = e.target.closest('button');
+      if (btn && !btn.disabled) this.#commit(Number(btn.dataset.value));
+    });
+    this.shadowRoot.addEventListener('keydown', (e) => this.#onKeydown(e));
+    // Fired when form validation fails on submit: now it's fair to show the error.
+    this.addEventListener('invalid', () => {
+      this.#touched = true;
+      this.#render();
+    });
+  }
+
+  get max() { return Math.max(1, parseInt(this.getAttribute('max'), 10) || 5); }
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  get form() { return this.#internals.form; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  get value() { return this.#value; }
+  set value(v) {
+    const n = Math.round(Number(v));
+    this.#setValue(n >= 1 && n <= this.max ? String(n) : '');
+  }
+
+  connectedCallback() {
+    this.#buildStars();
+    this.#update();
+  }
+
+  attributeChangedCallback(name) {
+    if (!this.isConnected) return;
+    if (name === 'max') this.#buildStars();
+    this.#update();
+  }
+
+  #buildStars() {
+    const wrap = this.shadowRoot.querySelector('.stars');
+    wrap.replaceChildren(...Array.from({ length: this.max }, (_, i) => {
+      const b = document.createElement('button');
+      b.type = 'button';
+      b.setAttribute('role', 'radio');
+      b.dataset.value = i + 1;
+      b.setAttribute('aria-label', `${i + 1} ${i ? 'stars' : 'star'}`);
+      b.textContent = '★';
+      return b;
+    }));
+    // Keep disabled state if rebuilt while disabled.
+    this.#syncDisabled(this.matches(':disabled'));
+  }
+
+  #setValue(v) {
+    this.#value = v;
+    // Second argument is the state used for browser state restoration.
+    this.#internals.setFormValue(v === '' ? null : v, v);
+    this.#update();
+  }
+
+  #commit(n) {
+    if (String(n) === this.#value) return;
+    this.#setValue(String(n));
+    this.#touched = true;
+    this.#render();
+    this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #update() {
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        this.shadowRoot.querySelector('button'),
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+    this.#render();
+  }
+
+  #render() {
+    const n = Number(this.#value) || 0;
+    const buttons = [...this.shadowRoot.querySelectorAll('button')];
+    buttons.forEach((b, i) => {
+      b.toggleAttribute('data-on', i < n);
+      b.setAttribute('aria-checked', String(i + 1 === n));
+      // Roving tabindex: the checked star, or the first one when empty.
+      b.tabIndex = (n ? i + 1 === n : i === 0) ? 0 : -1;
+    });
+    const invalid = this.#touched && !this.#internals.validity.valid;
+    this.#internals.ariaInvalid = invalid ? 'true' : null;
+    this.#internals.ariaRequired = this.required ? 'true' : null;
+    const err = this.shadowRoot.querySelector('.error');
+    err.hidden = !invalid;
+    err.textContent = invalid ? this.#internals.validationMessage : '';
+  }
+
+  #onKeydown(e) {
+    const btn = e.target.closest('button');
+    if (!btn || btn.disabled) return;
+    const cur = Number(btn.dataset.value);
+    let next;
+    switch (e.key) {
+      case 'ArrowRight': case 'ArrowUp': next = Math.min(this.max, (Number(this.#value) || 0) + 1); break;
+      case 'ArrowLeft': case 'ArrowDown': next = Math.max(1, (Number(this.#value) || cur + 1) - 1); break;
+      case 'Home': next = 1; break;
+      case 'End': next = this.max; break;
+      case ' ': case 'Enter':
+        if (e.key === 'Enter') return; // let Enter submit the form
+        next = cur; break;
+      default: return;
+    }
+    e.preventDefault();
+    this.#commit(next);
+    this.shadowRoot.querySelector(`button[data-value="${next}"]`).focus();
+  }
+
+  #syncDisabled(disabled) {
+    for (const b of this.shadowRoot.querySelectorAll('button')) b.disabled = disabled;
+  }
+
+  // Form-associated lifecycle callbacks
+  formResetCallback() {
+    this.#touched = false;
+    this.#setValue('');
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable internals only; the host already matches :disabled, and setting
+    // its attribute would stick after a fieldset is re-enabled.
+    this.#syncDisabled(disabled);
+  }
+
+  formStateRestoreCallback(state) {
+    this.value = state;
+  }
+}
+
+customElements.define('star-rating', StarRating);
