+  <script>
+    (function () {
+      var gallery = document.getElementById('gallery');
+      var items = Array.prototype.slice.call(gallery.querySelectorAll('.gallery-item'));
+      var thumbs = Array.prototype.slice.call(document.querySelectorAll('.gallery-thumb'));
+      var active = 0;
+      var settleTimer;
+      var hasScrollEnd = 'onscrollend' in window;
+      var hasSnapChanging = 'onscrollsnapchanging' in window;
+
+      function nearestIndex() {
+        var width = items[0].offsetWidth || 1;
+        var i = Math.round(gallery.scrollLeft / width);
+        return Math.max(0, Math.min(items.length - 1, i));
+      }
+
+      // Mid-scroll: preview the snap target without promoting it.
+      function setPending(index) {
+        thumbs.forEach(function (t, i) {
+          t.classList.toggle('pending', i === index && i !== active);
+        });
+      }
+
+      // Settled: promote the target to active.
+      function setActive(index) {
+        active = index;
+        thumbs.forEach(function (t, i) {
+          var on = i === index;
+          t.classList.remove('pending');
+          t.classList.toggle('active', on);
+          if (on) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+      }
+
+      function settle() {
+        clearTimeout(settleTimer);
+        setActive(nearestIndex());
+      }
+
+      if (hasSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          var i = items.indexOf(e.snapTargetInline);
+          if (i > -1) setPending(i);
+        });
+      }
+
+      gallery.addEventListener('scroll', function () {
+        if (!hasSnapChanging) setPending(nearestIndex());
+        if (!hasScrollEnd) {
+          // Fallback: treat a pause in scroll events as settling.
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(settle, 120);
+        }
+      }, { passive: true });
+
+      if (hasScrollEnd) gallery.addEventListener('scrollend', settle);
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          setPending(i);
+          gallery.scrollTo({ left: items[i].offsetLeft - gallery.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
+          // No scroll will fire if already there; settle immediately.
+          if (i === nearestIndex() && gallery.scrollLeft === items[i].offsetLeft - gallery.offsetLeft) settle();
+        });
+      });
+
+      window.addEventListener('resize', settle);
+    })();
+  </script>
+
