diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,109 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container: the page scrolls inside this element rather than the viewport */
+    .scroller {
+      position: relative;
+      height: 100dvh;
+      overflow-y: auto;
+      scroll-timeline: --scroller block;
+      outline: none;
+    }
+
+    .scroller-top-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 1px;
+      pointer-events: none;
+    }
+
+    /* Back to top button */
+    .back-to-top {
+      position: fixed;
+      right: 1.5rem;
+      bottom: 1.5rem;
+      z-index: 1100;
+      width: 3rem;
+      height: 3rem;
+      display: grid;
+      place-items: center;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.25rem;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      /* Hidden state: visibility removes it from the tab order and accessibility tree */
+      opacity: 0;
+      visibility: hidden;
+      transform: translateY(1rem);
+    }
+
+    .back-to-top:hover {
+      background: #3e2723;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      @keyframes back-to-top-in {
+        to {
+          opacity: 1;
+          visibility: visible;
+          transform: translateY(0);
+        }
+      }
+
+      .back-to-top {
+        animation: back-to-top-in auto linear both;
+        animation-timeline: --scroller;
+        animation-range: 0px 200px;
+      }
+    }
+
+    /* Fallback: toggled by an IntersectionObserver on the top sentinel */
+    .back-to-top.scroll-fallback {
+      transition: opacity 0.3s, transform 0.3s, visibility 0s 0.3s;
+    }
+
+    .back-to-top.scroll-fallback.is-visible {
+      opacity: 1;
+      visibility: visible;
+      transform: translateY(0);
+      transition-delay: 0s;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transform: none;
+        animation-name: back-to-top-in-reduced;
+        transition-property: opacity, visibility;
+      }
+
+      @keyframes back-to-top-in-reduced {
+        to {
+          opacity: 1;
+          visibility: visible;
+        }
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller" tabindex="-1">
+  <div class="scroller-top-sentinel"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -205,8 +301,32 @@
       <a href="/privacy-policy">Privacy</a>
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
+  </div>
 
+  <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+
+  <script>
+    (() => {
+      const scroller = document.querySelector('.scroller');
+      const button = document.querySelector('.back-to-top');
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+      button.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+        scroller.focus({ preventScroll: true });
+      });
+
+      // Native scroll-driven animation handles the rest; otherwise observe the top sentinel
+      if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')) {
+        button.classList.add('scroll-fallback');
+        new IntersectionObserver(([entry]) => {
+          button.classList.toggle('is-visible', !entry.isIntersecting);
+        }, { root: scroller }).observe(document.querySelector('.scroller-top-sentinel'));
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
