diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,13 +151,83 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Scroll container */
+    .scroller {
+      position: relative;
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+    }
+
+    /* Zero-height marker at the top of the scroller content; the observer watches it */
+    .scroller-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 300px;
+      pointer-events: none;
+      visibility: hidden;
+    }
+
+    /* Back to top: sticky to the scroller's bottom-right, takes no layout space */
+    .back-to-top {
+      position: sticky;
+      bottom: 1.5rem;
+      z-index: 1100;
+      display: block;
+      width: 3rem;
+      height: 3rem;
+      margin: -3rem 1.5rem 0 auto;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
+      opacity: 0;
+      transform: translateY(1rem) scale(0.8);
+      /* visibility flips after the fade-out so hidden state leaves the tab order */
+      visibility: hidden;
+      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s, background 0.3s;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      transform: none;
+      visibility: visible;
+      transition-delay: 0s;
+    }
+
+    .back-to-top:hover,
+    .back-to-top:focus-visible {
+      background: #3e2723;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+        transform: none;
+      }
+    }
   </style>
 </head>
 
 <body>
 
+  <div class="scroller" id="scroller">
+  <div class="scroller-sentinel" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +276,31 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button type="button" class="back-to-top" aria-label="Back to top">&uarr;</button>
+  </div>
+
+  <script>
+    (() => {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = scroller.querySelector('.scroller-sentinel');
+      const button = scroller.querySelector('.back-to-top');
+
+      // Show the button once the sentinel at the top has scrolled out of view.
+      // IntersectionObserver avoids a per-scroll-event handler.
+      new IntersectionObserver(([entry]) => {
+        button.classList.toggle('is-visible', !entry.isIntersecting);
+      }, { root: scroller }).observe(sentinel);
+
+      button.addEventListener('click', () => {
+        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
+        scroller.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
+        // The button is about to hide; move focus somewhere that stays focusable.
+        scroller.querySelector('nav a').focus({ preventScroll: true });
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
