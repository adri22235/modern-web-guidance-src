+  <script>
+    (function () {
+      var steps = Array.prototype.slice.call(document.querySelectorAll('#tracked > section'));
+      var visuals = Array.prototype.slice.call(document.querySelectorAll('#animated > section'));
+      if (!steps.length || steps.length !== visuals.length) return;
+
+      var clamp = function (v, lo, hi) { return Math.min(hi, Math.max(lo, v)); };
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var mid = window.innerHeight / 2;
+        steps.forEach(function (step, i) {
+          var r = step.getBoundingClientRect();
+          // 0 when the step's top reaches viewport center, 1 when its bottom does
+          var p = (mid - r.top) / r.height;
+          // fade in over p -0.3..0.1, hold, fade out over 0.9..1.3
+          var inAmt = clamp((p + 0.3) / 0.4, 0, 1);
+          var outAmt = clamp((1.3 - p) / 0.4, 0, 1);
+          var o = Math.min(inAmt, outAmt);
+          var v = visuals[i];
+          var shift = (p < 0.5 ? (1 - inAmt) : -(1 - outAmt)) * 40;
+          v.style.opacity = o;
+          v.style.transform = 'translateY(' + shift + 'px) scale(' + (0.9 + 0.1 * o) + ')';
+          v.style.zIndex = o > 0.5 ? 2 : 1;
+          v.querySelector('.visual-icon').style.transform = 'rotate(' + (clamp(p, 0, 1) * 360) + 'deg)';
+          v.querySelector('.meter-fill').style.transform = 'scaleX(' + clamp(p, 0, 1) + ')';
+          step.classList.toggle('active', p >= 0 && p <= 1);
+        });
+      }
+
+      function onScroll() {
+        if (!ticking) { ticking = true; requestAnimationFrame(update); }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
+
