@@ -206,7 +252,131 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var ctx = canvas.getContext('2d');
+      var W = canvas.width, H = canvas.height;
+
+      var raf = typeof window.requestAnimationFrame === 'function'
+        ? window.requestAnimationFrame.bind(window)
+        : function (cb) { return window.setTimeout(function () { cb(Date.now()); }, 16); };
+      var caf = typeof window.cancelAnimationFrame === 'function'
+        ? window.cancelAnimationFrame.bind(window)
+        : window.clearTimeout.bind(window);
+
+      // Beans
+      var beans = [];
+      for (var i = 0; i < 24; i++) {
+        beans.push({
+          x: Math.random() * W,
+          y: Math.random() * H,
+          vx: (Math.random() - 0.5) * 1.2,
+          vy: (Math.random() - 0.5) * 1.2,
+          r: 10 + Math.random() * 5,
+          angle: Math.random() * Math.PI * 2,
+          spin: (Math.random() - 0.5) * 0.06
+        });
+      }
+
+      // Roast progress 0 (green) -> 1 (dark), driven by temperature
+      var temp = 200, MIN_T = 200, MAX_T = 240, dir = 1;
+
+      function mix(a, b, t) { return Math.round(a + (b - a) * t); }
+
+      function draw() {
+        var t = (temp - MIN_T) / (MAX_T - MIN_T);
+        var color = 'rgb(' + mix(160, 50, t) + ',' + mix(110, 28, t) + ',' + mix(60, 20, t) + ')';
+        ctx.clearRect(0, 0, W, H);
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.x += b.vx; b.y += b.vy; b.angle += b.spin;
+          if (b.x < b.r || b.x > W - b.r) b.vx *= -1;
+          if (b.y < b.r || b.y > H - b.r) b.vy *= -1;
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+          ctx.fillStyle = color;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.r, b.r * 0.7, 0, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.strokeStyle = 'rgba(0,0,0,0.5)';
+          ctx.lineWidth = 1.5;
+          ctx.beginPath();
+          ctx.moveTo(-b.r * 0.8, 0);
+          ctx.quadraticCurveTo(0, b.r * 0.3, b.r * 0.8, 0);
+          ctx.stroke();
+          ctx.restore();
+        }
+      }
+
+      var rafId = null, timerId = null;
+
+      function frame() {
+        draw();
+        rafId = raf(frame);
+      }
+
+      function tick() {
+        temp += dir * (0.5 + Math.random() * 1.5);
+        if (temp >= MAX_T) { temp = MAX_T; dir = -1; }
+        if (temp <= MIN_T) { temp = MIN_T; dir = 1; }
+        tempEl.textContent = temp.toFixed(1);
+      }
+
+      function start() {
+        if (rafId === null) rafId = raf(frame);
+        if (timerId === null) timerId = window.setInterval(tick, 1000);
+      }
+
+      function stop() {
+        if (rafId !== null) { caf(rafId); rafId = null; }
+        if (timerId !== null) { window.clearInterval(timerId); timerId = null; }
+      }
+
+      // Running only while the widget is on screen AND the tab is visible
+      var inView = false;
+      function update() {
+        if (inView && !document.hidden) start(); else stop();
+      }
+
+      function setInView(v) {
+        if (v !== inView) { inView = v; update(); }
+      }
+
+      function checkRect() {
+        var r = widget.getBoundingClientRect();
+        var vh = window.innerHeight || document.documentElement.clientHeight;
+        setInView(r.bottom > 0 && r.top < vh);
+      }
+
+      if ('IntersectionObserver' in window) {
+        new IntersectionObserver(function (entries) {
+          setInView(entries[entries.length - 1].isIntersecting);
+        }).observe(widget);
+      } else {
+        // Fallback for older browsers: scroll/resize + bounding rect checks
+        var pending = false;
+        var onScroll = function () {
+          if (pending) return;
+          pending = true;
+          raf(function () { pending = false; checkRect(); });
+        };
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('resize', onScroll);
+        window.addEventListener('load', checkRect);
+        checkRect();
+      }
+
+      document.addEventListener('visibilitychange', update);
+
+      draw();
+    })();
+  </script>
+
 </body>
 
