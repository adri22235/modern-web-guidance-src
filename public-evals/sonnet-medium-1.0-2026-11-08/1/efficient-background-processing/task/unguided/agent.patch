+  <section id="roasting-widget" aria-label="Roasting simulator">
+    <h2>Live Roast Simulator</h2>
+    <canvas id="roast-canvas" width="600" height="260"></canvas>
+    <p class="roast-temp">Bean temperature: <span id="roast-temp-value">200</span>&deg;C</p>
