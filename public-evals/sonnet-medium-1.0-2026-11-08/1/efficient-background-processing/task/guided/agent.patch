+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var ctx = canvas.getContext('2d');
+      var W = canvas.width, H = canvas.height;
+
+      var beans = [];
+      for (var i = 0; i < 28; i++) {
+        beans.push({
+          x: Math.random() * W, y: Math.random() * H,
+          vx: (Math.random() - 0.5) * 1.5, vy: (Math.random() - 0.5) * 1.5,
+          a: Math.random() * Math.PI * 2, va: (Math.random() - 0.5) * 0.06,
+          r: 11 + Math.random() * 5
+        });
+      }
+
+      var temp = 180, rising = true, rafId = 0, intervalId = 0;
+      var inView = false, pageVisible = !document.hidden;
+
+      // Bean colour darkens from green-brown to dark roast as temperature rises.
+      function beanColor() {
+        var t = Math.min(1, Math.max(0, (temp - 180) / 45));
+        return 'rgb(' + Math.round(150 - 100 * t) + ',' + Math.round(95 - 65 * t) + ',' + Math.round(55 - 35 * t) + ')';
+      }
+
+      function frame() {
+        ctx.clearRect(0, 0, W, H);
+        var color = beanColor();
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.x += b.vx; b.y += b.vy; b.a += b.va;
+          if (b.x < b.r || b.x > W - b.r) b.vx *= -1;
+          if (b.y < b.r || b.y > H - b.r) b.vy *= -1;
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.a);
+          ctx.fillStyle = color;
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.r, b.r * 0.7, 0, 0, Math.PI * 2);
+          ctx.fill();
+          ctx.strokeStyle = 'rgba(0,0,0,0.5)';
+          ctx.lineWidth = 2;
+          ctx.beginPath();
+          ctx.moveTo(-b.r * 0.8, 0);
+          ctx.quadraticCurveTo(0, b.r * 0.3, b.r * 0.8, 0);
+          ctx.stroke();
+          ctx.restore();
+        }
+        rafId = requestAnimationFrame(frame);
+      }
+
+      function tick() {
+        temp += (rising ? 1 : -1) * (0.4 + Math.random() * 0.8);
+        if (temp >= 225) rising = false;
+        if (temp <= 180) rising = true;
+        tempEl.textContent = temp.toFixed(1);
+      }
+
+      function start() {
+        if (!rafId) rafId = requestAnimationFrame(frame);
+        if (!intervalId) intervalId = setInterval(tick, 500);
+      }
+
+      function stop() {
+        cancelAnimationFrame(rafId);
+        rafId = 0;
+        clearInterval(intervalId);
+        intervalId = 0;
+      }
+
+      function update() {
+        if (inView && pageVisible) start(); else stop();
+      }
+
+      document.addEventListener('visibilitychange', function () {
+        pageVisible = !document.hidden;
+        update();
+      });
+
+      if ('contentVisibility' in document.documentElement.style) {
+        // The browser tells us when it skips/resumes rendering the widget.
+        widget.addEventListener('contentvisibilityautostatechange', function (e) {
+          inView = !e.skipped;
+          update();
+        });
+      } else if ('IntersectionObserver' in window) {
+        // Fallback for older browsers
+        new IntersectionObserver(function (entries) {
+          inView = entries[entries.length - 1].isIntersecting;
+          update();
+        }, { rootMargin: '200px' }).observe(widget);
+      } else {
+        // No observer support at all: just run.
+        inView = true;
+        update();
+      }
+    })();
+  </script>
+
 </body>
 
