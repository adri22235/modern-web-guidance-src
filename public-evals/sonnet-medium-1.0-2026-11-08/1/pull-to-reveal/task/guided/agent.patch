diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,16 +11,60 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --search-height: 70px;
     }
 
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
     }
 
+    /* The root is the scroll container; the search bar sits above the nav and is
+       scrolled out of view on load. */
+    html {
+      overflow-y: auto;
+      scroll-snap-type: y proximity;
+    }
+
+    .search-bar {
+      background: var(--secondary);
+      height: var(--search-height);
+      padding: 0 5%;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 10px;
+      width: 100%;
+      max-width: 600px;
+    }
+
+    .search-bar input[type="search"] {
+      flex: 1;
+      min-width: 0;
+      padding: 8px 14px;
+      border: 1px solid var(--primary);
+      border-radius: 4px;
+      font: inherit;
+    }
+
+    .search-bar button {
+      background: var(--primary);
+      color: white;
+      border: 0;
+      border-radius: 4px;
+      padding: 8px 18px;
+      font: inherit;
+      cursor: pointer;
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
@@ -37,8 +81,10 @@
       align-items: center;
       position: sticky;
       top: 0;
       z-index: 1000;
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
     }
 
     .logo {
       font-size: 1.5rem;
@@ -156,8 +202,15 @@
 </head>
 
 <body>
 
+  <div class="search-bar" role="search">
+    <form action="/search" method="get">
+      <input type="search" name="q" placeholder="Search drinks, locations, rewards…" aria-label="Search">
+      <button type="submit">Search</button>
+    </form>
+  </div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +259,14 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without scroll-initial-target: jump past the search bar
+    // synchronously, before first paint.
+    if (!CSS.supports("scroll-initial-target", "nearest") && !location.hash) {
+      document.querySelector("nav").scrollIntoView({ behavior: "instant", block: "start" });
+    }
+  </script>
 </body>
 
 </html>
