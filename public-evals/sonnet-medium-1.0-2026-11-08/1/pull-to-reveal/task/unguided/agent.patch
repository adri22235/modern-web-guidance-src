     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+<script>
+    // Hide the search bar off-screen above the nav before first paint.
+    // Runs synchronously at end of body; skipped if the browser restored a scroll position.
+    (function () {
+      var bar = document.getElementById('search-bar');
+      var root = document.documentElement;
+      var applied = false;
+      function hide() {
+        if (applied) return;
+        if (window.scrollY === 0 && !location.hash) root.scrollTop = bar.offsetHeight;
+      }
+      hide();
+      applied = window.scrollY > 0;
+      // Restoration may occur after load; if we're still at 0 then, hide again once.
+      window.addEventListener('load', function () {
+        if (!applied && window.scrollY === 0 && !location.hash) root.scrollTop = bar.offsetHeight;
+      });
+    })();
+  </script>
 </body>
 
