+  <dialog id="order-dialog" aria-labelledby="order-title">
+    <form id="order-form" method="dialog">
+      <h2 id="order-title">Maple Oat Latte</h2>
+      <p class="drink-desc" id="order-desc"></p>
+
+      <label class="field">
+        <span>Drink</span>
+        <select name="drink" id="order-drink"></select>
+      </label>
+
+      <fieldset class="field">
+        <legend>Size</legend>
+        <label class="inline"><input type="radio" name="size" value="small"> Small</label>
+        <label class="inline"><input type="radio" name="size" value="medium" checked> Medium</label>
+        <label class="inline"><input type="radio" name="size" value="large"> Large</label>
+      </fieldset>
+
+      <fieldset class="field">
+        <legend>Extras</legend>
+        <label class="inline"><input type="checkbox" name="extras" value="shot"> Extra shot (+$0.75)</label>
+        <label class="inline"><input type="checkbox" name="extras" value="oat"> Oat milk (+$0.50)</label>
+      </fieldset>
+
+      <label class="field">
+        <span>Quantity</span>
+        <input type="number" name="quantity" id="order-qty" min="1" max="10" value="1">
+      </label>
+
+      <p class="dialog-total">Total: <span id="order-total"></span></p>
+
+      <div class="discard-warning" id="discard-warning" role="alert" hidden>
+        You have unsaved changes to your order. Discard them to close this dialog.
+      </div>
+
+      <div class="dialog-actions">
+        <button type="submit" class="btn" id="order-confirm">Add to Order</button>
+        <button type="button" class="btn btn-secondary" id="order-close">Close</button>
+        <button type="button" class="btn btn-danger" id="order-discard" hidden>Discard changes</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    (function () {
+      var DRINKS = {
+        'maple-oat': { name: 'Maple Oat Latte', price: 5.5, desc: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+        'espresso': { name: 'Dark Roast Espresso', price: 3.5, desc: 'Bold, smokey, and perfect for a morning boost.' },
+        'cold-brew': { name: 'Cold Brew', price: 4.5, desc: 'Steeped for 18 hours for maximum smoothness.' }
+      };
+      var SIZE_ADJ = { small: -0.5, medium: 0, large: 0.75 };
+      var EXTRA_PRICE = { shot: 0.75, oat: 0.5 };
+
+      var dialog = document.getElementById('order-dialog');
+      var form = document.getElementById('order-form');
+      var drinkSelect = document.getElementById('order-drink');
+      var qty = document.getElementById('order-qty');
+      var closeBtn = document.getElementById('order-close');
+      var discardBtn = document.getElementById('order-discard');
+      var warning = document.getElementById('discard-warning');
+      var baseline = '';
+      var lastTrigger = null;
+
+      Object.keys(DRINKS).forEach(function (key) {
+        var opt = document.createElement('option');
+        opt.value = key;
+        opt.textContent = DRINKS[key].name;
+        drinkSelect.appendChild(opt);
+      });
+
+      function snapshot() {
+        var data = new FormData(form);
+        return JSON.stringify([
+          data.get('drink'), data.get('size'), data.getAll('extras').sort(), data.get('quantity')
+        ]);
+      }
+
+      function isDirty() {
+        return snapshot() !== baseline;
+      }
+
+      function render() {
+        var data = new FormData(form);
+        var drink = DRINKS[data.get('drink')];
+        document.getElementById('order-title').textContent = drink.name;
+        document.getElementById('order-desc').textContent = drink.desc;
+        var unit = drink.price + SIZE_ADJ[data.get('size')];
+        data.getAll('extras').forEach(function (e) { unit += EXTRA_PRICE[e]; });
+        var q = Math.max(1, Math.min(10, parseInt(data.get('quantity'), 10) || 1));
+        document.getElementById('order-total').textContent = '$' + (unit * q).toFixed(2);
+
+        var dirty = isDirty();
+        discardBtn.hidden = !dirty;
+        closeBtn.disabled = dirty;
+        if (!dirty) warning.hidden = true;
+      }
+
+      function resetForm(drinkKey) {
+        form.reset();
+        drinkSelect.value = drinkKey;
+        baseline = snapshot();
+        render();
+      }
+
+      function open(drinkKey, trigger) {
+        lastTrigger = trigger;
+        resetForm(drinkKey);
+        dialog.showModal();
+      }
+
+      document.querySelectorAll('[data-open-order]').forEach(function (btn) {
+        btn.addEventListener('click', function () { open(btn.dataset.drink, btn); });
+      });
+
+      form.addEventListener('input', render);
+      form.addEventListener('change', render);
+
+      // Block Escape / close requests while there are unconfirmed changes.
+      dialog.addEventListener('cancel', function (e) {
+        if (isDirty()) {
+          e.preventDefault();
+          warning.hidden = false;
+          discardBtn.focus();
+        }
+      });
+      dialog.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && isDirty()) e.preventDefault();
+      });
+
+      // Backdrop clicks only dismiss a pristine dialog.
+      dialog.addEventListener('click', function (e) {
+        if (e.target !== dialog) return;
+        if (isDirty()) {
+          warning.hidden = false;
+          discardBtn.focus();
+        } else {
+          dialog.close();
+        }
+      });
+
+      closeBtn.addEventListener('click', function () {
+        if (!isDirty()) dialog.close();
+      });
+
+      discardBtn.addEventListener('click', function () {
+        resetForm(JSON.parse(baseline)[0]);
+        dialog.close();
+      });
+
+      form.addEventListener('submit', function () {
+        // Order confirmed: nothing left to discard, dialog closes via method="dialog".
+        baseline = snapshot();
+      });
+
+      dialog.addEventListener('close', function () {
+        if (lastTrigger) lastTrigger.focus();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
