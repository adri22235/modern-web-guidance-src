+  <dialog id="order-dialog" class="order-dialog" aria-labelledby="order-title" closedby="none">
+    <form id="order-form" method="dialog">
+      <h2 id="order-title">Your drink</h2>
+      <p class="desc" id="order-desc"></p>
+
+      <div class="field">
+        <label for="order-drink">Drink</label>
+        <select id="order-drink" name="drink"></select>
+      </div>
+      <fieldset class="field sizes">
+        <legend>Size</legend>
+        <label><input type="radio" name="size" value="small"> Small</label>
+        <label><input type="radio" name="size" value="medium" checked> Medium (+$0.50)</label>
+        <label><input type="radio" name="size" value="large"> Large (+$1.00)</label>
+      </fieldset>
+      <div class="field">
+        <label for="order-milk">Milk</label>
+        <select id="order-milk" name="milk">
+          <option value="oat">Oat</option>
+          <option value="whole">Whole</option>
+          <option value="almond">Almond</option>
+          <option value="none">No milk</option>
+        </select>
+      </div>
+      <div class="field">
+        <label for="order-qty">Quantity</label>
+        <input id="order-qty" type="number" name="qty" min="1" max="10" value="1">
+      </div>
+      <div class="field">
+        <label for="order-notes">Notes</label>
+        <textarea id="order-notes" name="notes" rows="2"></textarea>
+      </div>
+      <p class="order-total">Total: <output id="order-total"></output></p>
+
+      <p class="discard-msg" id="discard-msg">You have unsaved changes to your order. Discard them to close this dialog, or keep editing.</p>
+      <div class="order-actions">
+        <button type="button" class="btn btn-danger" id="order-discard" value="discard" aria-describedby="discard-msg" hidden>Discard changes</button>
+        <button type="button" class="btn btn-secondary" id="order-close">Close</button>
+        <button type="submit" class="btn" value="confirm" autofocus>Add to order</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    const DRINKS = {
+      'maple-oat-latte': { name: 'Maple Oat Latte', price: 5.5, milk: 'oat', desc: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+      'dark-roast-espresso': { name: 'Dark Roast Espresso', price: 3.5, milk: 'none', desc: 'Bold, smokey, and perfect for a morning boost.' },
+      'cold-brew': { name: 'Cold Brew', price: 4.5, milk: 'none', desc: 'Steeped for 18 hours for maximum smoothness.' }
+    };
+    const SIZE_EXTRA = { small: 0, medium: 0.5, large: 1 };
+
+    const dialog = document.getElementById('order-dialog');
+    const form = document.getElementById('order-form');
+    const drinkSelect = document.getElementById('order-drink');
+    const discardBtn = document.getElementById('order-discard');
+    const discardMsg = document.getElementById('discard-msg');
+    let initialState = '';
+
+    for (const [id, d] of Object.entries(DRINKS)) drinkSelect.add(new Option(d.name, id));
+
+    const snapshot = () => JSON.stringify([...new FormData(form)]);
+    const isDirty = () => snapshot() !== initialState;
+
+    function render() {
+      const d = DRINKS[drinkSelect.value];
+      const data = new FormData(form);
+      document.getElementById('order-desc').textContent = d.desc;
+      const total = (d.price + SIZE_EXTRA[data.get('size')]) * Number(data.get('qty') || 1);
+      document.getElementById('order-total').textContent = '$' + total.toFixed(2);
+    }
+
+    function setConfirming(on) {
+      discardBtn.hidden = !on;
+      discardMsg.classList.toggle('show', on);
+      if (on) discardBtn.focus();
+    }
+
+    function openOrder(id) {
+      form.reset();
+      drinkSelect.value = id;
+      form.elements.milk.value = DRINKS[id].milk;
+      setConfirming(false);
+      render();
+      initialState = snapshot();
+      dialog.showModal();
+    }
+
+    document.querySelectorAll('[data-drink]').forEach((btn) =>
+      btn.addEventListener('click', () => openOrder(btn.dataset.drink)));
+
+    // Changing the drink resets that drink's default milk, which is part of the baseline
+    drinkSelect.addEventListener('change', () => {
+      form.elements.milk.value = DRINKS[drinkSelect.value].milk;
+    });
+
+    form.addEventListener('input', () => {
+      render();
+      if (!isDirty()) setConfirming(false);
+    });
+
+    // Esc / back gesture / Close button: block while there are unsaved changes
+    dialog.addEventListener('cancel', (e) => {
+      if (isDirty()) {
+        e.preventDefault();
+        setConfirming(true);
+      }
+    });
+
+    document.getElementById('order-close').addEventListener('click', () => dialog.requestClose());
+    discardBtn.addEventListener('click', () => dialog.close('discard'));
+    dialog.addEventListener('close', () => { dialog.returnValue = ''; });
+  </script>
+
 </body>
 
 </html>
