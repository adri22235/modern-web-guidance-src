index 0000000..72522e5
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,105 @@
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const port = Number(process.env.PORT) || 11222;
+const dataFile = process.env.SUBSCRIBERS_FILE || join(root, 'data', 'subscribers.txt');
+
+const UNSPLASH = 'https://images.unsplash.com';
+
+// Pages may only talk to this server and the Unsplash photo host.
+// CSP covers all browsers; Connection-Allowlist adds network-layer enforcement
+// (including preconnect/WebRTC/redirects) where supported.
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${UNSPLASH}`,
+  "connect-src 'self'",
+  "form-action 'self'",
+  "worker-src 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+  'report-to csp-reports',
+].join('; ');
+
+const securityHeaders = {
+  'Content-Security-Policy': CSP,
+  'Connection-Allowlist': `(response-origin "${UNSPLASH}"); report-to=csp-reports`,
+  'Reporting-Endpoints': 'csp-reports="/api/security-reports"',
+  'Vary': 'Sec-Fetch-Dest',
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+};
+
+const files = {
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/index.html': ['index.html', 'text/html; charset=utf-8'],
+  '/styles.css': ['styles.css', 'text/css; charset=utf-8'],
+  '/newsletter.js': ['newsletter.js', 'text/javascript; charset=utf-8'],
+};
+
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+function send(res, status, body = '', type = 'text/plain; charset=utf-8', extra = {}) {
+  res.writeHead(status, { ...securityHeaders, 'Content-Type': type, ...extra });
+  res.end(body);
+}
+
+function readBody(req, limit = 4096) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > limit) {
+        reject(new Error('too large'));
+        req.destroy();
+      } else chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+async function handleSubscribe(req, res) {
+  let email;
+  try {
+    email = String(JSON.parse(await readBody(req)).email ?? '').trim();
+  } catch {
+    return send(res, 400, 'Invalid request');
+  }
+  if (email.length > 254 || !EMAIL_RE.test(email)) return send(res, 400, 'Invalid email');
+  await mkdir(dirname(dataFile), { recursive: true });
+  await appendFile(dataFile, `${new Date().toISOString()}\t${email}\n`);
+  send(res, 200, '{"ok":true}', 'application/json');
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') return send(res, 405, 'Method not allowed', undefined, { Allow: 'POST' });
+      return await handleSubscribe(req, res);
+    }
+    if (pathname === '/api/security-reports' && req.method === 'POST') {
+      console.warn('Security report:', (await readBody(req, 16384).catch(() => '')).slice(0, 2000));
+      return send(res, 204);
+    }
+
+    const entry = files[pathname];
+    if (entry && (req.method === 'GET' || req.method === 'HEAD')) {
+      return send(res, 200, await readFile(join(root, entry[0])), entry[1]);
+    }
+    send(res, 404, 'Not found');
+  } catch (error) {
+    console.error(error);
+    if (!res.headersSent) send(res, 500, 'Server error');
+  }
+});
+
+server.listen(port, () => console.log(`Daily Grind listening on http://localhost:${port}`));
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..6ac93cf
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,208 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  max-width: 520px;
+  margin: 40px auto 0;
+  text-align: center;
+}
+
+.newsletter form {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  justify-content: center;
+  margin-top: 15px;
+}
+
+.newsletter input[type="email"] {
+  flex: 1 1 240px;
+  padding: 10px 12px;
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  font: inherit;
+}
+
+.newsletter button {
+  border: 0;
+  cursor: pointer;
+  margin-top: 0;
+  font: inherit;
+}
+
+.newsletter button:disabled {
+  opacity: 0.6;
+  cursor: progress;
+}
+
+.newsletter-status {
+  margin-top: 12px;
+  min-height: 1.6em;
+  font-weight: 600;
+}
+
+.newsletter-status[data-state="error"] {
+  color: #b71c1c;
+}
+
+.newsletter-status[data-state="success"] {
+  color: #1b5e20;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
