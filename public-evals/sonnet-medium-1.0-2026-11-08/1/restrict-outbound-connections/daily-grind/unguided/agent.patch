@@ -0,0 +1,40 @@
+(function () {
+  var form = document.getElementById('newsletter-form');
+  var message = document.getElementById('newsletter-message');
+  var button = form.querySelector('button');
+
+  function show(text, kind) {
+    message.textContent = text;
+    message.className = kind;
+  }
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+    var email = form.elements.email.value.trim();
+    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+      show('Please enter a valid email address.', 'error');
+      return;
+    }
+
+    button.disabled = true;
+    show('Signing you up…', '');
+
+    fetch('/api/subscribe', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ email: email })
+    })
+      .then(function (res) {
+        if (!res.ok) throw new Error('HTTP ' + res.status);
+        form.reset();
+        show('Thanks for subscribing!', 'success');
+      })
+      .catch(function () {
+        // Network failure, server error, or request blocked by the CSP
+        show('Sorry, we couldn’t sign you up right now. Please try again later.', 'error');
+      })
+      .then(function () {
+        button.disabled = false;
+      });
+  });
+})();
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..2ffdf38
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,200 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.center {
+  text-align: center;
+}
+
+.signup {
+  margin-top: 60px;
+  text-align: center;
+}
+
+.signup form {
+  display: flex;
+  justify-content: center;
+  gap: 10px;
+  flex-wrap: wrap;
+  margin-top: 15px;
+}
+
+.signup input {
+  padding: 10px 14px;
+  min-width: 260px;
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  font-size: 1rem;
+}
+
+.signup .btn {
+  margin-top: 0;
+  border: 0;
+  cursor: pointer;
+  font-size: 1rem;
+}
+
+#newsletter-message {
+  margin-top: 12px;
+  min-height: 1.6em;
+  font-weight: 600;
+}
+
+#newsletter-message.error {
+  color: #b71c1c;
+}
+
+#newsletter-message.success {
+  color: #1b5e20;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+}
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..c614408
--- /dev/null
+++ b/server.js
@@ -0,0 +1,74 @@
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const PORT = process.env.PORT || 11222;
+const ROOT = __dirname;
+const SUBSCRIBERS_FILE = path.join(ROOT, 'data', 'subscribers.txt');
+
+// The page may only talk to this server and the Unsplash image host.
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "frame-ancestors 'none'"
+].join('; ');
+
+const FILES = {
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/index.html': ['index.html', 'text/html; charset=utf-8'],
+  '/styles.css': ['public/styles.css', 'text/css; charset=utf-8'],
+  '/newsletter.js': ['public/newsletter.js', 'text/javascript; charset=utf-8']
+};
+
+function send(res, status, type, body) {
+  res.writeHead(status, {
+    'Content-Type': type,
+    'Content-Security-Policy': CSP,
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'same-origin'
+  });
+  res.end(body);
+}
+
+function subscribe(req, res) {
+  let raw = '';
+  req.on('data', (chunk) => {
+    raw += chunk;
+    if (raw.length > 2048) req.destroy();
+  });
+  req.on('end', () => {
+    let email;
+    try {
+      email = String(JSON.parse(raw).email || '').trim();
+    } catch (e) {}
+    if (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+      return send(res, 400, 'application/json', '{"error":"invalid email"}');
+    }
+    fs.mkdir(path.dirname(SUBSCRIBERS_FILE), { recursive: true }, (err) => {
+      if (err) return send(res, 500, 'application/json', '{"error":"server error"}');
+      fs.appendFile(SUBSCRIBERS_FILE, email + '\n', (err2) => {
+        if (err2) return send(res, 500, 'application/json', '{"error":"server error"}');
+        send(res, 200, 'application/json', '{"ok":true}');
+      });
+    });
+  });
+}
+
+http
+  .createServer((req, res) => {
+    const url = req.url.split('?')[0];
+    if (url === '/api/subscribe' && req.method === 'POST') return subscribe(req, res);
+    const file = FILES[url];
+    if (file && (req.method === 'GET' || req.method === 'HEAD')) {
+      return fs.readFile(path.join(ROOT, file[0]), (err, data) =>
+        err ? send(res, 500, 'text/plain', 'Server error') : send(res, 200, file[1], data)
+      );
+    }
+    send(res, 404, 'text/plain', 'Not found');
+  })
+  .listen(PORT, () => console.log('Daily Grind listening on ' + PORT));
