+  <script>
+    // Silently registers a passkey for the signed-in user (conditional create).
+    // Never surfaces UI or errors; any failure just leaves the password session as is.
+    async function registerPasskeySilently() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return;
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalCreate !== true) return;
+
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ conditional: true })
+      });
+      if (!optionsResponse.ok) return;
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey, mediation: 'conditional' });
+      } catch (e) {
+        return; // InvalidStateError, NotAllowedError, AbortError and the like: ignore silently
+      }
+      if (!credential) return;
+
+      const encodedResponse = credential.toJSON();
+      let verified = false;
+      try {
+        const response = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse)
+        });
+        verified = response.ok;
+      } catch (e) {
+        verified = false;
+      }
+
+      if (!verified && PublicKeyCredential.signalUnknownCredential) {
+        // Remove the orphaned credential from the passkey provider; use the server-provided rp.id
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rp.id,
+          credentialId: encodedResponse.id
+        }).catch(() => {});
+      }
+    }
+
+    document.getElementById('signin-form').addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const form = event.currentTarget;
+      const status = document.getElementById('signin-status');
+      status.textContent = '';
+
+      let response;
+      try {
+        response = await fetch(form.action, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(Object.fromEntries(new FormData(form)))
+        });
+      } catch (e) {
+        status.textContent = 'Could not sign in. Please try again.';
+        return;
+      }
+      if (!response.ok) {
+        status.textContent = 'Incorrect email or password.';
+        return;
+      }
+
+      // Password sign-in succeeded: promote to a passkey in the background
+      registerPasskeySilently().catch(() => {});
+    });
+  </script>
