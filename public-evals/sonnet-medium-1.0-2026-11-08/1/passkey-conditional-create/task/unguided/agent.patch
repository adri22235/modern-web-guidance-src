+  <script>
+    // --- base64url helpers ---
+    const b64uToBuf = (s) => {
+      const b64 = s.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(s.length / 4) * 4, '=');
+      return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+    };
+    const bufToB64u = (buf) =>
+      btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+    // Can this browser silently create a passkey? Any failure => false.
+    async function canRegisterPasskey() {
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) return false;
+        if (PublicKeyCredential.getClientCapabilities) {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          if (caps && caps.userVerifyingPlatformAuthenticator === false) return false;
+          if (caps && caps.passkeyPlatformAuthenticator === false) return false;
+        }
+        if (PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable) {
+          return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+        }
+        return false;
+      } catch {
+        return false;
+      }
+    }
+
+    function toCreationOptions(json) {
+      if (PublicKeyCredential.parseCreationOptionsFromJSON) {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+      }
+      return {
+        ...json,
+        challenge: b64uToBuf(json.challenge),
+        user: { ...json.user, id: b64uToBuf(json.user.id) },
+        excludeCredentials: (json.excludeCredentials || []).map((c) => ({ ...c, id: b64uToBuf(c.id) })),
+      };
+    }
+
+    // Remove a credential the server never accepted, where the browser supports signalling it.
+    async function cleanupOrphan(rpId, credentialId) {
+      try {
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+        }
+      } catch { /* best effort */ }
+    }
+
+    // Runs after a successful password sign-in. Never throws, never shows UI of its own.
+    async function silentPasskeyRegistration() {
+      try {
+        if (!(await canRegisterPasskey())) return;
+
+        const optRes = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: '{}',
+        });
+        if (!optRes.ok) return;
+        const optionsJSON = await optRes.json();
+
+        const credential = await navigator.credentials.create({ publicKey: toCreationOptions(optionsJSON) });
+        if (!credential) return;
+
+        const rpId = optionsJSON.rp?.id || location.hostname;
+        let verified = false;
+        try {
+          const verifyRes = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({
+              id: credential.id,
+              rawId: bufToB64u(credential.rawId),
+              type: credential.type,
+              authenticatorAttachment: credential.authenticatorAttachment,
+              response: {
+                clientDataJSON: bufToB64u(credential.response.clientDataJSON),
+                attestationObject: bufToB64u(credential.response.attestationObject),
+                transports: credential.response.getTransports ? credential.response.getTransports() : [],
+              },
+              clientExtensionResults: credential.getClientExtensionResults(),
+            }),
+          });
+          verified = verifyRes.ok;
+        } catch {
+          verified = false;
+        }
+        if (!verified) await cleanupOrphan(rpId, bufToB64u(credential.rawId));
+      } catch {
+        // Silent by design (user cancelled, unsupported, network, etc.)
+      }
+    }
+
+    document.getElementById('signin-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const form = e.currentTarget;
+      const errorEl = document.getElementById('signin-error');
+      const button = form.querySelector('[data-testid="signin-button"]');
+      errorEl.hidden = true;
+      button.disabled = true;
+      try {
+        const res = await fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: form.username.value,
+            password: form.password.value,
+          }),
+        });
+        if (!res.ok) throw new Error('Sign-in failed');
+        form.password.value = '';
+        // Fire and forget: must not delay or affect the sign-in outcome.
+        silentPasskeyRegistration();
+      } catch {
+        errorEl.textContent = 'Sign-in failed. Check your credentials and try again.';
+        errorEl.hidden = false;
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
 </body>
 
