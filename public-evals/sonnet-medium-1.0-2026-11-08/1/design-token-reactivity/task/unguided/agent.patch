+    #target-container {
+      --card-density: 1;
+    }
+
+    #target-container:has(#toggle-spacious:checked) {
+      --card-density: 1.8;
+    }
+
+    /* Toggle is hidden unless the browser supports :has() */
+    .density-toggle {
+      display: none;
+    }
+
+    @supports selector(:has(*)) {
+      .density-toggle {
+        display: block;
+        width: fit-content;
+        margin: 15px auto 0;
+      }
+
+      .density-toggle input {
+        position: absolute;
+        opacity: 0;
+      }
+
+      .density-toggle label {
+        display: inline-block;
+        cursor: pointer;
+        padding: 8px 16px;
+        border: 1px solid var(--primary);
+        border-radius: 5px;
+        color: var(--primary);
+        font-size: 0.9rem;
+      }
+
+      .density-toggle input:checked + label {
+        background: var(--primary);
+        color: white;
+      }
+
+      .density-toggle input:focus-visible + label {
+        outline: 2px solid var(--accent);
+        outline-offset: 2px;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
