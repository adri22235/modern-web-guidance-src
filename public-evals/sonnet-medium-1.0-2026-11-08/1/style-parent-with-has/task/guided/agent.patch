+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    document.querySelectorAll('.contact :is(input, textarea)').forEach((el) => {
+      const sync = () => el.setAttribute('aria-invalid', el.matches(':user-invalid'));
+      el.addEventListener('blur', sync);
+      el.addEventListener('input', sync);
+      el.addEventListener('invalid', sync);
+    });
+  </script>
