+  <script>
+    // Seasonal Favorites card markup, rendered as HTML strings.
+    const seasonalCards = [
+      `<div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <a href="/menu/espresso" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </div>`
+    ];
+
+    const ALLOWED_ELEMENTS = ['div', 'h3', 'p', 'a'];
+    const ALLOWED_ATTRIBUTES = ['class', 'href'];
+
+    // Only same-site paths and http(s) URLs; blocks javascript:, data:, etc.
+    function isSafeHref(value) {
+      try {
+        const url = new URL(value, location.href);
+        return url.protocol === 'https:' || url.protocol === 'http:';
+      } catch {
+        return false;
+      }
+    }
+
+    // Fallback for browsers without Element.setHTML(): parse into an inert
+    // document, then rebuild only allowlisted nodes. Never touches innerHTML,
+    // so it also works under Trusted Types enforcement.
+    function cloneSafe(node) {
+      if (node.nodeType === Node.TEXT_NODE) return document.createTextNode(node.data);
+      if (node.nodeType !== Node.ELEMENT_NODE) return null;
+      const tag = node.localName;
+      if (!ALLOWED_ELEMENTS.includes(tag)) return null; // drop element and its content
+      const copy = document.createElement(tag);
+      for (const { name, value } of node.attributes) {
+        if (!ALLOWED_ATTRIBUTES.includes(name)) continue;
+        if (name === 'href' && !isSafeHref(value)) continue;
+        copy.setAttribute(name, value);
+      }
+      for (const child of node.childNodes) {
+        const safe = cloneSafe(child);
+        if (safe) copy.append(safe);
+      }
+      return copy;
+    }
+
+    function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, {
+          sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES }
+        });
+        return;
+      }
+      const doc = new DOMParser().parseFromString(html, 'text/html');
+      el.replaceChildren(...[...doc.body.childNodes].map(cloneSafe).filter(Boolean));
+    }
+
+    safeSetHTML(document.getElementById('seasonal-grid'), seasonalCards.join(''));
+  </script>
+
