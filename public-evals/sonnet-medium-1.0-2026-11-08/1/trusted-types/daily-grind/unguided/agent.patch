index 0000000..8b2e978
--- /dev/null
+++ b/seasonal.js
@@ -0,0 +1,93 @@
+(function () {
+  'use strict';
+
+  // Card markup as HTML strings (e.g. from a CMS or API). Treated as untrusted.
+  var SEASONAL_FAVORITES = [
+    '<div class="card"><h3>Maple Oat Latte</h3>' +
+      '<p>Creamy oat milk with a hint of Vermont maple syrup.</p>' +
+      '<a href="/menu/seasonal" class="btn">View Details</a></div>',
+    '<div class="card"><h3>Dark Roast Espresso</h3>' +
+      '<p>Bold, smokey, and perfect for a morning boost.</p>' +
+      '<a href="/menu/espresso" class="btn">View Details</a></div>',
+    '<div class="card"><h3>Cold Brew</h3>' +
+      '<p>Steeped for 18 hours for maximum smoothness.</p>' +
+      '<a href="/menu/cold-brew" class="btn">View Details</a></div>'
+  ];
+
+  var ALLOWED_TAGS = {
+    DIV: ['class'], H3: ['class'], P: ['class'], SPAN: ['class'],
+    STRONG: [], EM: [], BR: [],
+    A: ['href', 'class']
+  };
+  var ALLOWED_CLASSES = { card: 1, btn: 1 };
+
+  // Trusted Types policy: the only place a string becomes HTML, and only to
+  // feed an inert parser. Output is rebuilt node-by-node from an allowlist.
+  var policy = null;
+  if (window.trustedTypes && window.trustedTypes.createPolicy) {
+    policy = window.trustedTypes.createPolicy('daily-grind-sanitizer', {
+      createHTML: function (s) { return s; }
+    });
+  }
+
+  function isSafeHref(value) {
+    try {
+      var url = new URL(value, document.baseURI);
+      return (url.protocol === 'http:' || url.protocol === 'https:') &&
+        url.origin === location.origin;
+    } catch (e) {
+      return false;
+    }
+  }
+
+  function cleanNode(node) {
+    if (node.nodeType === Node.TEXT_NODE) {
+      return document.createTextNode(node.nodeValue);
+    }
+    if (node.nodeType !== Node.ELEMENT_NODE) return null;
+
+    var allowedAttrs = ALLOWED_TAGS[node.tagName];
+    if (!allowedAttrs) return null; // drops script, img, svg, iframe, etc. with contents
+
+    var el = document.createElement(node.tagName.toLowerCase());
+    allowedAttrs.forEach(function (name) {
+      if (!node.hasAttribute(name)) return;
+      var value = node.getAttribute(name);
+      if (name === 'href') {
+        if (isSafeHref(value)) el.setAttribute('href', value);
+      } else if (name === 'class') {
+        var classes = value.split(/\s+/).filter(function (c) {
+          return Object.prototype.hasOwnProperty.call(ALLOWED_CLASSES, c);
+        });
+        if (classes.length) el.setAttribute('class', classes.join(' '));
+      }
+    });
+    Array.prototype.forEach.call(node.childNodes, function (child) {
+      var clean = cleanNode(child);
+      if (clean) el.appendChild(clean);
+    });
+    return el;
+  }
+
+  function sanitizeToFragment(html) {
+    var input = policy ? policy.createHTML(html) : html;
+    var doc = new DOMParser().parseFromString(input, 'text/html'); // inert: no script/handler execution
+    var fragment = document.createDocumentFragment();
+    Array.prototype.forEach.call(doc.body.childNodes, function (child) {
+      var clean = cleanNode(child);
+      if (clean) fragment.appendChild(clean);
+    });
+    return fragment;
+  }
+
+  function renderSeasonalFavorites(container, cards) {
+    var fragment = document.createDocumentFragment();
+    cards.forEach(function (html) {
+      fragment.appendChild(sanitizeToFragment(html));
+    });
+    container.replaceChildren(fragment);
+  }
+
+  var grid = document.getElementById('seasonal-grid');
+  if (grid) renderSeasonalFavorites(grid, SEASONAL_FAVORITES);
+})();
