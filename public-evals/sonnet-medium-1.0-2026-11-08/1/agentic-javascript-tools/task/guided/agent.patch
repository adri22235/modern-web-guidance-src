diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,91 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal Favorites",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Seasonal Favorites",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Seasonal Favorites",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    const normalize = (value) => value.trim().toLowerCase().replace(/\s+/g, " ");
+
+    let menuToolController = null;
+
+    async function registerMenuTool() {
+      if (!("modelContext" in document) || menuToolController) return;
+      const controller = new AbortController();
+      menuToolController = controller;
+
+      try {
+        await document.modelContext.registerTool({
+          name: "get_menu_item_details",
+          description: "Looks up the details of a Daily Grind menu item by name. Use when the user asks what a drink is, what it contains, or where to read more about it.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              name: {
+                type: "string",
+                description: "Name of the menu item, such as \"Maple Oat Latte\". Matching ignores case and extra spaces.",
+              },
+            },
+            required: ["name"],
+          },
+          execute({ name } = {}) {
+            if (typeof name !== "string" || !name.trim()) {
+              return {
+                error: "Pass the name of a menu item.",
+                availableItems: MENU_ITEMS.map((item) => item.name),
+              };
+            }
+            const item = MENU_ITEMS.find((entry) => normalize(entry.name) === normalize(name));
+            if (!item) {
+              return {
+                error: `Menu item "${name}" not found.`,
+                availableItems: MENU_ITEMS.map((entry) => entry.name),
+              };
+            }
+            return item;
+          },
+          annotations: { readOnlyHint: true },
+        }, { signal: controller.signal });
+      } catch (err) {
+        // Registration failed, so allow a later retry.
+        if (menuToolController === controller) menuToolController = null;
+        console.error("Failed to register menu tool:", err);
+      }
+    }
+
+    function unregisterMenuTool() {
+      // WebMCP has no unregisterTool(); aborting the registration signal removes the tool.
+      menuToolController?.abort();
+      menuToolController = null;
+    }
+
+    registerMenuTool();
+    window.addEventListener("pagehide", unregisterMenuTool);
+    // Restore the tool if the page returns from the back/forward cache.
+    window.addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTool();
+    });
+  </script>
+
 </body>
 
 </html>
