@@ -206,7 +206,114 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Menu data exposed to AI assistants via the WebMCP `lookup_menu_item` tool.
+    // Prices, sizes and nutrition values are placeholder assumptions.
+    const MENU_ITEMS = [
+      {
+        name: 'Maple Oat Latte',
+        category: 'Seasonal',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        price: '$5.75',
+        sizes: ['12oz', '16oz'],
+        caffeine: 'Contains espresso (about 150 mg in 16oz)',
+        dairyFree: true,
+        servedHot: true,
+        url: '/menu/seasonal'
+      },
+      {
+        name: 'Dark Roast Espresso',
+        category: 'Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        price: '$3.25',
+        sizes: ['Single', 'Double'],
+        caffeine: 'About 65 mg per shot',
+        dairyFree: true,
+        servedHot: true,
+        url: '/menu/espresso'
+      },
+      {
+        name: 'Cold Brew',
+        category: 'Cold Coffee',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        price: '$4.50',
+        sizes: ['12oz', '16oz', '24oz'],
+        caffeine: 'About 200 mg in 16oz',
+        dairyFree: true,
+        servedHot: false,
+        url: '/menu/cold-brew'
+      }
+    ];
+
+    const normalize = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
+
+    function findMenuItem(query) {
+      const q = normalize(query);
+      if (!q) return undefined;
+      return MENU_ITEMS.find((i) => normalize(i.name) === q) ||
+        MENU_ITEMS.find((i) => normalize(i.name).includes(q) || q.includes(normalize(i.name)));
+    }
+
+    const textResult = (text, isError = false) => ({ content: [{ type: 'text', text }], isError });
+
+    const lookupMenuItemTool = {
+      name: 'lookup_menu_item',
+      description: 'Look up details (description, price, sizes, caffeine, dietary info, page link) ' +
+        'for a menu item at The Daily Grind coffee shop by its name, e.g. "Maple Oat Latte", ' +
+        '"Dark Roast Espresso" or "Cold Brew". Matching is case-insensitive.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          name: {
+            type: 'string',
+            description: 'The name of the menu item to look up, e.g. "Cold Brew". Case-insensitive; partial names are accepted.'
+          }
+        },
+        required: ['name']
+      },
+      annotations: { readOnlyHint: true },
+      async execute({ name } = {}) {
+        if (typeof name !== 'string' || !name.trim()) {
+          return textResult('Please provide the "name" of a menu item.', true);
+        }
+        const item = findMenuItem(name);
+        if (!item) {
+          const available = MENU_ITEMS.map((i) => i.name).join(', ');
+          return textResult(`No menu item found matching "${name}". Available items: ${available}.`, true);
+        }
+        return textResult(JSON.stringify(item, null, 2));
+      }
+    };
+
+    // Register the tool (if the browser supports WebMCP) and deactivate it on page unload.
+    (function registerMenuTool() {
+      const modelContext = navigator.modelContext;
+      if (!modelContext || typeof modelContext.registerTool !== 'function') return;
+
+      const controller = new AbortController();
+      try {
+        // `signal` lets newer implementations unregister the tool on abort.
+        modelContext.registerTool(lookupMenuItemTool, { signal: controller.signal });
+      } catch (err) {
+        console.warn('Could not register lookup_menu_item tool:', err);
+        return;
+      }
+
+      let cleaned = false;
+      const cleanup = () => {
+        if (cleaned) return;
+        cleaned = true;
+        controller.abort();
+        if (typeof modelContext.unregisterTool === 'function') {
+          try { modelContext.unregisterTool(lookupMenuItemTool.name); } catch (_) { /* already removed */ }
+        }
+      };
+      // `pagehide` is more reliable than `unload` and is bfcache-friendly.
+      window.addEventListener('pagehide', cleanup, { once: true });
+    })();
+  </script>
+
 </body>
 
 </html>
