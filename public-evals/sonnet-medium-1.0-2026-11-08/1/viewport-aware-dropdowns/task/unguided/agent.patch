+  <script>
+    (function () {
+      var trigger = document.getElementById('trigger-btn');
+      var panel = document.getElementById('action-panel');
+      var MARGIN = 8;
+
+      // Ensure the panel is a direct child of <body> (escapes any clipping ancestor).
+      document.body.appendChild(panel);
+
+      function position() {
+        var t = trigger.getBoundingClientRect();
+        var vw = document.documentElement.clientWidth;
+        var vh = document.documentElement.clientHeight;
+        var pw = panel.offsetWidth;
+        var ph = panel.offsetHeight;
+
+        // Default: directly below, left edges aligned.
+        var left = t.left;
+        var top = t.bottom;
+
+        // Flip horizontally: align right edges if it would overflow the right side.
+        if (left + pw > vw - MARGIN && t.right - pw >= MARGIN) {
+          left = t.right - pw;
+        }
+        // Flip vertically: open above if it doesn't fit below and there's more room above.
+        if (top + ph > vh - MARGIN && t.top > vh - t.bottom) {
+          top = t.top - ph;
+        }
+
+        // Final clamp so it is never cut off.
+        left = Math.max(MARGIN, Math.min(left, vw - pw - MARGIN));
+        top = Math.max(MARGIN, Math.min(top, vh - ph - MARGIN));
+
+        panel.style.left = left + 'px';
+        panel.style.top = top + 'px';
+      }
+
+      function open() {
+        panel.classList.add('open');
+        trigger.setAttribute('aria-expanded', 'true');
+        position();
+      }
+
+      function close(returnFocus) {
+        panel.classList.remove('open');
+        trigger.setAttribute('aria-expanded', 'false');
+        if (returnFocus) trigger.focus();
+      }
+
+      trigger.addEventListener('click', function () {
+        panel.classList.contains('open') ? close() : open();
+      });
+
+      panel.addEventListener('click', function (e) {
+        if (e.target.closest('button')) close(true);
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!panel.contains(e.target) && !trigger.contains(e.target)) close();
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && panel.classList.contains('open')) close(true);
+      });
+
+      function reposition() {
+        if (panel.classList.contains('open')) position();
+      }
+      window.addEventListener('resize', reposition);
+      window.addEventListener('scroll', reposition, true);
+    })();
+  </script>
