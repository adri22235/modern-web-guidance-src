+    /* Options dropdown */
+    #trigger-btn {
+      anchor-name: --options-trigger;
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: transparent;
+      border: 1px solid var(--secondary);
+      padding: 5px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    #trigger-btn:hover,
+    #trigger-btn:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    #action-panel {
+      position-anchor: --options-trigger;
+      min-width: 12rem;
+      padding: 6px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
+    }
+
+    #action-panel:popover-open {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    /* Only take over placement where anchor positioning exists; otherwise keep the UA default */
+    @supports (position-area: block-end) {
+      #action-panel {
+        inset: auto;
+        margin: 0;
+        /* Below the trigger, left edges aligned, extending toward inline-end */
+        position-area: block-end span-inline-end;
+        /* Flip vertically, horizontally, then both when colliding with the viewport */
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    .action-item {
+      font: inherit;
+      font-size: 0.9rem;
+      text-align: left;
+      color: inherit;
+      background: transparent;
+      border: 0;
+      padding: 8px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background: var(--secondary);
+    }
+
