+    /* Roast picker */
+    .roast-picker {
+      width: min(320px, 100%);
+      margin-top: 20px;
+      text-align: left;
+    }
+
+    .roast-picker label {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: 600;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 14px;
+      background: var(--light);
+      color: var(--text);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .roast-select::picker(select) {
+      background: var(--light);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      margin-top: 4px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
+      width: anchor-size(width);
+    }
+
+    .roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+    }
+
+    .roast-select option svg {
+      flex: none;
+      width: 28px;
+      height: 28px;
+      color: var(--primary);
+    }
+
+    .roast-select .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .roast-select .option-title {
+      font-weight: 600;
+    }
+
+    .roast-select .option-desc {
+      font-size: 0.8rem;
+      opacity: 0.75;
+    }
+
+    .roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    .roast-select option:hover {
+      background: var(--secondary);
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option:checked {
+      background: var(--primary);
+      color: white;
+    }
+
+    .roast-select option:checked svg {
+      color: var(--accent);
+    }
+
+    .roast-select option:checked .option-title {
+      font-weight: 800;
+    }
+
+    .roast-select:focus-visible,
+    .roast-select option:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
   </style>
