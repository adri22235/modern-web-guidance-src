+  <script>
+    (function () {
+      var picker = document.getElementById('roast-picker');
+      var toggle = document.getElementById('roast-toggle');
+      var text = document.getElementById('roast-toggle-text');
+      var menu = document.getElementById('roast-menu');
+      var options = Array.prototype.slice.call(menu.querySelectorAll('[role="option"]'));
+      var order = document.querySelector('.hero a.btn');
+      var active = -1;
+
+      function setActive(i) {
+        active = (i + options.length) % options.length;
+        options.forEach(function (o, n) { o.classList.toggle('active', n === active); });
+        options[active].scrollIntoView({ block: 'nearest' });
+      }
+
+      function open() {
+        menu.hidden = false;
+        toggle.setAttribute('aria-expanded', 'true');
+        var sel = options.findIndex(function (o) { return o.getAttribute('aria-selected') === 'true'; });
+        setActive(sel < 0 ? 0 : sel);
+      }
+
+      function close() {
+        menu.hidden = true;
+        toggle.setAttribute('aria-expanded', 'false');
+        options.forEach(function (o) { o.classList.remove('active'); });
+      }
+
+      function select(i) {
+        options.forEach(function (o, n) { o.setAttribute('aria-selected', n === i ? 'true' : 'false'); });
+        var opt = options[i];
+        // Mirror the option's icon and title into the toggle button
+        var old = toggle.querySelector('.roast-icon');
+        if (old) old.remove();
+        toggle.insertBefore(opt.querySelector('.roast-icon').cloneNode(true), toggle.firstChild);
+        text.textContent = opt.querySelector('.roast-title').textContent;
+        text.classList.remove('roast-placeholder');
+        order.href = '/order-online?roast=' + encodeURIComponent(opt.dataset.value);
+        close();
+      }
+
+      toggle.addEventListener('click', function () { menu.hidden ? open() : close(); });
+      options.forEach(function (o, i) {
+        o.addEventListener('click', function () { select(i); toggle.focus(); });
+      });
+      document.addEventListener('click', function (e) { if (!picker.contains(e.target)) close(); });
+      picker.addEventListener('keydown', function (e) {
+        var isOpen = !menu.hidden;
+        if (e.key === 'Escape' && isOpen) { close(); toggle.focus(); }
+        else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          if (!isOpen) open(); else setActive(active + (e.key === 'ArrowDown' ? 1 : -1));
+        } else if ((e.key === 'Enter' || e.key === ' ') && isOpen) {
+          e.preventDefault();
+          select(active);
+          toggle.focus();
+        }
+      });
+    })();
+  </script>
 </body>
 
