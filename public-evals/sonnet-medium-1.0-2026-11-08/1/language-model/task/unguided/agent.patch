+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const LANG = { expectedInputs: [{ type: 'text', languages: ['en'] }], expectedOutputs: [{ type: 'text', languages: ['en'] }] };
+      const MAX_CLONES = 3;
+
+      const barista = {
+        session: null,      // main conversation session
+        controller: null,   // aborts the in-flight prompt
+        clones: [],         // { id, session, label }
+        nextId: 1,
+      };
+
+      const answerEl = $('barista-answer');
+      const progressEl = $('ai-download');
+      const statusEl = $('session-status');
+
+      /** Returns true if the Prompt API can be used; reports why otherwise. */
+      async function ensureAvailable(output) {
+        if (!('LanguageModel' in self)) {
+          output('The built-in AI (Prompt API) is not supported in this browser.');
+          return false;
+        }
+        const availability = await LanguageModel.availability(LANG);
+        if (availability === 'unavailable') {
+          output('The built-in AI model is unavailable on this device.');
+          return false;
+        }
+        return true;
+      }
+
+      /** Creates a session, surfacing model download progress. */
+      function createSession(options = {}, signal) {
+        return LanguageModel.create({
+          ...LANG,
+          signal,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              progressEl.hidden = e.loaded >= 1;
+              progressEl.value = e.loaded;
+            });
+          },
+          ...options,
+        });
+      }
+
+      function destroySession(session) {
+        try { session.destroy(); } catch { /* already destroyed */ }
+      }
+
+      function usageText(session) {
+        return `${session.inputUsage}/${session.inputQuota} tokens used`;
+      }
+
+      function renderSessions() {
+        const list = $('session-list');
+        list.replaceChildren();
+        for (const c of barista.clones) {
+          const li = document.createElement('li');
+          li.textContent = `${c.label}: ${usageText(c.session)} `;
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          btn.textContent = 'Discard';
+          btn.addEventListener('click', () => {
+            destroySession(c.session);
+            barista.clones = barista.clones.filter((x) => x !== c);
+            renderSessions();
+          });
+          li.append(btn);
+          list.append(li);
+        }
+        statusEl.textContent = barista.session
+          ? `Main conversation: ${usageText(barista.session)}`
+          : 'No active conversation yet. Ask the barista a question first.';
+      }
+
+      async function getBaristaSession(signal) {
+        if (barista.session) return barista.session;
+        const session = await createSession({
+          initialPrompts: [{
+            role: 'system',
+            content: 'You are a friendly barista at The Daily Grind coffee shop. ' +
+              'You only answer questions about the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) ' +
+              'and the Cold Brew (steeped for 18 hours for maximum smoothness). ' +
+              'If asked about anything else, politely say you can only help with those two drinks. ' +
+              'Do not invent facts such as prices or allergens; say you are not sure instead.',
+          }],
+        }, signal);
+        // Warn when older context is evicted to fit the quota.
+        session.addEventListener('contextoverflow', () => {
+          statusEl.textContent = 'Context limit reached; earliest messages were dropped.';
+        });
+        barista.session = session;
+        return session;
+      }
+
+      $('ask-the-barista').addEventListener('click', async (event) => {
+        const button = event.currentTarget;
+        const question = $('barista-question').value.trim();
+        if (!question) {
+          answerEl.textContent = 'Please type a question first.';
+          return;
+        }
+        barista.controller?.abort(); // cancel any previous request
+        const controller = barista.controller = new AbortController();
+        button.disabled = true;
+        answerEl.textContent = '';
+        try {
+          if (!(await ensureAvailable((msg) => { answerEl.textContent = msg; }))) return;
+          const session = await getBaristaSession(controller.signal);
+          answerEl.textContent = 'Thinking…';
+          let first = true;
+          for await (const chunk of session.promptStreaming(question, { signal: controller.signal })) {
+            if (first) { answerEl.textContent = ''; first = false; }
+            answerEl.textContent += chunk;
+          }
+          renderSessions();
+        } catch (err) {
+          if (err.name !== 'AbortError') answerEl.textContent = `Sorry, something went wrong: ${err.message}`;
+        } finally {
+          progressEl.hidden = true;
+          if (barista.controller === controller) barista.controller = null;
+          button.disabled = false;
+        }
+      });
+
+      /* Sentiment analysis: one-shot session with a JSON schema, destroyed afterwards. */
+      const sentimentSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: -1, maximum: 1 },
+          category: { type: 'string', enum: ['positive', 'neutral', 'negative'] },
+        },
+        required: ['score', 'category'],
+        additionalProperties: false,
+      };
+
+      $('sentiment-btn').addEventListener('click', async (event) => {
+        const button = event.currentTarget;
+        const out = $('sentiment-result');
+        const text = $('feedback-text').value.trim();
+        if (!text) { out.textContent = 'Please enter some feedback.'; return; }
+        button.disabled = true;
+        out.textContent = 'Analyzing…';
+        let session;
+        try {
+          if (!(await ensureAvailable((msg) => { out.textContent = msg; }))) return;
+          session = await createSession({
+            initialPrompts: [{
+              role: 'system',
+              content: 'Classify the sentiment of customer feedback. score ranges from -1 (very negative) to 1 (very positive).',
+            }],
+          });
+          const result = await session.prompt(text, { responseConstraint: sentimentSchema });
+          out.textContent = JSON.stringify(JSON.parse(result), null, 2);
+        } catch (err) {
+          out.textContent = `Sorry, something went wrong: ${err.message}`;
+        } finally {
+          progressEl.hidden = true;
+          if (session) destroySession(session);
+          button.disabled = false;
+        }
+      });
+
+      /* Conversation branching: clone, track usage, prune oldest clones. */
+      $('clone-btn').addEventListener('click', async () => {
+        if (!barista.session) {
+          statusEl.textContent = 'No active conversation to clone. Ask the barista a question first.';
+          return;
+        }
+        try {
+          const session = await barista.session.clone();
+          barista.clones.push({ session, id: barista.nextId, label: `Branch ${barista.nextId++}` });
+          while (barista.clones.length > MAX_CLONES) {
+            destroySession(barista.clones.shift().session);
+          }
+          renderSessions();
+        } catch (err) {
+          statusEl.textContent = `Could not clone the conversation: ${err.message}`;
+        }
+      });
+
+      // Release on-device resources when leaving the page.
+      addEventListener('pagehide', () => {
+        barista.controller?.abort();
+        if (barista.session) destroySession(barista.session);
+        barista.clones.forEach((c) => destroySession(c.session));
+        barista.session = null;
+        barista.clones = [];
+      });
+
+      renderSessions();
+    })();
+  </script>
 </body>
 
