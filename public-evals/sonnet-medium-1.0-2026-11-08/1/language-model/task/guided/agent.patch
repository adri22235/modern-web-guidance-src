+  <script>
+    (() => {
+      const MAX_BRANCHES = 3;
+      const FULL_RATIO = 0.8;
+      const SYSTEM_PROMPT = [
+        'You are a friendly barista at The Daily Grind coffee shop.',
+        'You only answer questions about two drinks: the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) and the Cold Brew (steeped for 18 hours for maximum smoothness).',
+        'If asked about anything else, politely say you can only help with those two drinks. Keep answers short.'
+      ].join(' ');
+
+      const $ = (id) => document.getElementById(id);
+      const supported = 'LanguageModel' in self;
+
+      let convo = null;          // active multi-turn barista session
+      let convoPromise = null;   // dedupes concurrent creation
+      let askController = null;
+      let branchSeq = 0;
+      const branches = [];       // { id, session, el }
+
+      // Check availability, then create a session while reporting download progress.
+      async function createSession(options, statusEl) {
+        if (!supported) {
+          statusEl.textContent = 'The built-in AI (Prompt API) is not supported in this browser.';
+          return null;
+        }
+        const availability = await LanguageModel.availability();
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'The on-device model is unavailable on this device.';
+          return null;
+        }
+        const progress = $('model-progress');
+        if (availability !== 'available') {
+          statusEl.textContent = 'Downloading the on-device model…';
+          progress.hidden = false;
+          progress.value = 0;
+        }
+        try {
+          return await LanguageModel.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                progress.value = e.loaded;
+                statusEl.textContent = `Downloading the on-device model… ${Math.round(e.loaded * 100)}%`;
+              });
+            }
+          });
+        } finally {
+          progress.hidden = true;
+        }
+      }
+
+      function getConvo(statusEl) {
+        if (convo) return Promise.resolve(convo);
+        convoPromise ??= createSession({ initialPrompts: [{ role: 'system', content: SYSTEM_PROMPT }] }, statusEl)
+          .then((s) => {
+            convo = s;
+            return s;
+          })
+          .finally(() => { convoPromise = null; });
+        return convoPromise;
+      }
+
+      const usageText = (s) => `${s.contextUsage ?? 0} / ${s.contextWindow ?? '?'} tokens`;
+
+      // ---- Ask the barista (streaming) ----
+      const askBtn = $('ask-the-barista');
+      const stopBtn = $('stop-barista');
+
+      askBtn.addEventListener('click', async () => {
+        const question = $('barista-question').value.trim();
+        const status = $('ai-status');
+        const answer = $('barista-answer');
+        if (!question) {
+          status.textContent = 'Please type a question first.';
+          return;
+        }
+        askBtn.disabled = true;
+        answer.textContent = '';
+        try {
+          const session = await getConvo(status);
+          if (!session) return;
+          askController = new AbortController();
+          stopBtn.hidden = false;
+          status.textContent = 'The barista is thinking…';
+          const stream = session.promptStreaming(question, { signal: askController.signal });
+          for await (const chunk of stream) {
+            answer.append(chunk); // text node only: model output is untrusted
+          }
+          status.textContent = `Context used: ${usageText(session)}`;
+          renderBranches();
+        } catch (err) {
+          status.textContent = err.name === 'AbortError' ? 'Stopped.' : `Something went wrong: ${err.message}`;
+        } finally {
+          askController = null;
+          stopBtn.hidden = true;
+          askBtn.disabled = false;
+        }
+      });
+
+      stopBtn.addEventListener('click', () => askController?.abort());
+
+      // ---- Sentiment analyzer (structured output) ----
+      const sentimentSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: -1, maximum: 1 },
+          category: { type: 'string', enum: ['positive', 'neutral', 'negative'] }
+        },
+        required: ['score', 'category']
+      };
+
+      $('sentiment-btn').addEventListener('click', async (e) => {
+        const btn = e.currentTarget;
+        const status = $('sentiment-status');
+        const out = $('sentiment-result');
+        const text = $('feedback-text').value.trim();
+        if (!text) {
+          status.textContent = 'Please enter some feedback.';
+          return;
+        }
+        btn.disabled = true;
+        out.textContent = '';
+        let session;
+        try {
+          session = await createSession({
+            initialPrompts: [{
+              role: 'system',
+              content: 'Classify coffee shop customer feedback. score ranges from -1 (very negative) to 1 (very positive).'
+            }]
+          }, status);
+          if (!session) return;
+          status.textContent = 'Analyzing…';
+          const result = await session.prompt(`Feedback: ${text}`, { responseConstraint: sentimentSchema });
+          out.textContent = JSON.stringify(JSON.parse(result), null, 2);
+          status.textContent = 'Done.';
+        } catch (err) {
+          status.textContent = `Something went wrong: ${err.message}`;
+        } finally {
+          session?.destroy(); // one-shot session: free it immediately
+          btn.disabled = false;
+        }
+      });
+
+      // ---- Conversation branching ----
+      function destroyBranch(branch) {
+        branch.session.destroy();
+        branches.splice(branches.indexOf(branch), 1);
+      }
+
+      function renderBranches() {
+        const list = $('branch-list');
+        list.replaceChildren();
+        const entries = [{ label: 'Active conversation', session: convo }]
+          .concat(branches.map((b) => ({ label: `Branch ${b.id}`, session: b.session, branch: b })));
+        for (const { label, session, branch } of entries) {
+          if (!session) continue;
+          const li = document.createElement('li');
+          const name = document.createElement('span');
+          name.textContent = label;
+          const meter = document.createElement('meter');
+          meter.max = session.contextWindow || 1;
+          meter.value = session.contextUsage || 0;
+          meter.setAttribute('aria-label', `${label} context usage`);
+          const usage = document.createElement('span');
+          usage.textContent = usageText(session);
+          li.append(name, meter, usage);
+          if (branch) {
+            const del = document.createElement('button');
+            del.type = 'button';
+            del.textContent = 'Discard';
+            del.addEventListener('click', () => {
+              destroyBranch(branch);
+              renderBranches();
+            });
+            li.append(del);
+          }
+          list.append(li);
+        }
+      }
+
+      $('clone-btn').addEventListener('click', async (e) => {
+        const btn = e.currentTarget;
+        const status = $('clone-status');
+        btn.disabled = true;
+        try {
+          const source = await getConvo(status);
+          if (!source) return;
+          const session = await source.clone();
+          const branch = { id: ++branchSeq, session };
+          branches.push(branch);
+
+          // Cleanup: drop nearly-full branches and keep only the newest few.
+          const notes = [];
+          for (const b of [...branches]) {
+            const full = b.session.contextWindow && b.session.contextUsage / b.session.contextWindow >= FULL_RATIO;
+            if (full && b !== branch) {
+              destroyBranch(b);
+              notes.push(`branch ${b.id} was nearly full`);
+            }
+          }
+          while (branches.length > MAX_BRANCHES) {
+            const old = branches[0];
+            destroyBranch(old);
+            notes.push(`branch ${old.id} was the oldest`);
+          }
+          status.textContent = `Created branch ${branch.id} (${usageText(session)}).` +
+            (notes.length ? ` Destroyed: ${notes.join(', ')}.` : '');
+          renderBranches();
+        } catch (err) {
+          status.textContent = `Something went wrong: ${err.message}`;
+        } finally {
+          btn.disabled = false;
+        }
+      });
+
+      // Release all on-device sessions when leaving the page.
+      addEventListener('pagehide', () => {
+        askController?.abort();
+        branches.splice(0).forEach((b) => b.session.destroy());
+        convo?.destroy();
+        convo = null;
+      });
+    })();
+  </script>
+
 </body>
 
