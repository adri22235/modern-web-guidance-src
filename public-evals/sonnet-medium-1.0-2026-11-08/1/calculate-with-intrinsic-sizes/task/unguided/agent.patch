+    /* Smooth transitions to and from intrinsic sizes (height: auto etc.) site-wide */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    /*
+     * Note: transitioning directly between different intrinsic keyword sizes
+     * (e.g. min-content to max-content, or auto to fit-content) is not
+     * supported; keywords can only be interpolated with a length/percentage
+     * (via interpolate-size or calc-size()), not with each other.
+     */
+
+    /* Promo badge */
+    .promo-badge {
+      display: block;
