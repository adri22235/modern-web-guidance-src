+      padding: 4px 10px;
+      background: var(--accent);
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: bold;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      text-align: center;
+      border-radius: 999px;
+      inline-size: fit-content;
+    }
+
+    @supports (inline-size: calc-size(max-content, size)) {
+      .promo-badge {
+        /* 1.2 x max-content, clamped between 100px and 100% of the parent */
+        inline-size: calc-size(max-content, clamp(100px, size * 1.2, 100%));
+      }
+    }
+
+    /* Accordion */
+    .faq {
+      margin-block-start: 40px;
+    }
+
+    .accordion-toggle {
+      display: flex;
