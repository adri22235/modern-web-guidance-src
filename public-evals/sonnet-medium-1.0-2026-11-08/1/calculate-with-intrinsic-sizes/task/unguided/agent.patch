+      font: inherit;
+      font-weight: bold;
+      text-align: start;
+      cursor: pointer;
+    }
+
+    .accordion-toggle:hover {
+      background: #3e2723;
+    }
+
+    .accordion-toggle::after {
+      content: '+';
+      font-size: 1.25rem;
+    }
+
+    .accordion-toggle[aria-expanded="true"]::after {
+      content: '\2212';
+    }
+
+    .accordion-content {
+      block-size: 0;
+      overflow: hidden;
+      visibility: hidden;
+      transition: block-size 0.4s ease, visibility 0s linear 0.4s;
+    }
+
+    .accordion-content.is-open {
+      block-size: auto;
