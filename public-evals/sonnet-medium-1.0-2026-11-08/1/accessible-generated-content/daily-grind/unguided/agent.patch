+    /* Decorative flourishes.
+       All shapes are drawn with CSS on empty pseudo-elements (content: "")
+       so there is no text for assistive tech to read. Where a string is used,
+       the "/ ''" alt-text syntax marks it as decorative (empty alternative),
+       with a plain declaration first as a fallback for older browsers. */
+
+    /* Section heading: sparkle + rules on either side */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 14px;
+      text-align: center;
+    }
+
+    .section-title::before,
+    .section-title::after {
+      content: "";
+      flex: 0 1 80px;
+      height: 2px;
+      background: linear-gradient(90deg, transparent, var(--accent));
+    }
+
+    .section-title::after {
+      background: linear-gradient(270deg, transparent, var(--accent));
+    }
+
+    .section-title span::before,
+    .section-title span::after {
+      content: "";
+      display: inline-block;
+      width: 0.45em;
+      height: 0.45em;
+      background: var(--accent);
+      transform: rotate(45deg);
+      vertical-align: middle;
+      margin: 0 0.5em;
+    }
+
+    /* Drink headings: CSS-drawn coffee cup with steam */
+    .drink-title::before {
+      content: "";
+      display: block;
+      position: relative;
+      width: 28px;
+      height: 20px;
+      margin: 0 auto 14px;
+      background: var(--accent);
+      border-radius: 2px 2px 14px 14px;
+      box-shadow: 18px 4px 0 -6px var(--accent), 18px 4px 0 -4px var(--primary);
+    }
+
+    .drink-title::after {
+      content: "";
+      display: block;
+      width: 40px;
+      height: 3px;
+      margin: 8px auto 0;
+      border-radius: 2px;
+      background: var(--accent);
+      opacity: 0.8;
+    }
+
+    /* Buttons: arrow that nudges on hover/focus */
+    .btn::after {
+      content: "";
+      display: inline-block;
+      width: 0.5em;
+      height: 0.5em;
+      margin-left: 0.6em;
+      border-top: 2px solid var(--accent);
+      border-right: 2px solid var(--accent);
+      transform: rotate(45deg);
+      transition: transform 0.3s;
+    }
+
+    .btn:hover::after,
+    .btn:focus-visible::after {
+      transform: translateX(4px) rotate(45deg);
+    }
+
+    .btn {
+      box-shadow: 0 3px 0 rgba(255, 171, 64, 0.6);
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn,
+      .btn::after {
+        transition: none;
+      }
+
+      .btn:hover::after,
+      .btn:focus-visible::after {
+        transform: rotate(45deg);
+      }
+    }
+
+    @media (forced-colors: active) {
+      .btn::after {
+        border-color: ButtonText;
+      }
+    }
+
