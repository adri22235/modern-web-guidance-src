+  <script>
+    (function () {
+      var CATALOG = [
+        { name: 'Ethiopia Yirgacheffe', note: 'Floral, bright, citrus finish' },
+        { name: 'Colombia Huila', note: 'Caramel sweetness, balanced body' },
+        { name: 'Sumatra Mandheling', note: 'Earthy, full-bodied, low acidity' },
+        { name: 'Guatemala Antigua', note: 'Cocoa, spice, gentle smoke' },
+        { name: 'Kenya AA', note: 'Blackcurrant, juicy, wine-like' },
+        { name: 'Brazil Santos', note: 'Nutty, smooth, chocolatey' },
+        { name: 'Costa Rica Tarrazú', note: 'Honey, red apple, crisp' },
+        { name: 'Panama Geisha', note: 'Jasmine, bergamot, delicate' }
+      ];
+
+      var list = document.getElementById('bean-list');
+      var empty = document.getElementById('bean-empty');
+      var addBtn = document.getElementById('bean-add');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var DURATION = 450, EASING = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
+      var nextId = 0;
+      var selected = [];
+
+      function makeItem(bean) {
+        var li = document.createElement('li');
+        li.className = 'bean-item';
+        li.dataset.name = bean.name;
+        li.innerHTML = '<h3></h3><p></p><button type="button" class="bean-remove"></button>';
+        li.querySelector('h3').textContent = bean.name;
+        li.querySelector('p').textContent = bean.note;
+        var btn = li.querySelector('button');
+        btn.textContent = '×';
+        btn.setAttribute('aria-label', 'Remove ' + bean.name);
+        return li;
+      }
+
+      function positions() {
+        var map = new Map();
+        Array.prototype.forEach.call(list.children, function (el) {
+          if (!el.classList.contains('leaving')) map.set(el, el.getBoundingClientRect());
+        });
+        return map;
+      }
+
+      // Group transition (FLIP): record positions, mutate DOM, then animate every
+      // surviving item from its old position to its new one at the same time.
+      // Uses the Web Animations API so the page is never blocked.
+      function transition(mutate) {
+        var before = positions();
+        var added = [];
+        mutate(added);
+        update();
+        if (reduceMotion.matches) {
+          finishLeaving();
+          return;
+        }
+        // Items that are leaving stay in flow until measured, so take them out now.
+        var leaving = Array.prototype.filter.call(list.children, function (el) {
+          return el.classList.contains('leaving');
+        });
+        leaving.forEach(function (el) {
+          var r = before.get(el);
+          var lr = list.getBoundingClientRect();
+          el.style.position = 'absolute';
+          el.style.width = r.width + 'px';
+          el.style.left = (r.left - lr.left) + 'px';
+          el.style.top = (r.top - lr.top) + 'px';
+          el.style.margin = '0';
+          el.style.pointerEvents = 'none';
+        });
+        // Force the list to be relatively positioned for the absolute leavers.
+        list.style.position = 'relative';
+
+        Array.prototype.forEach.call(list.children, function (el) {
+          if (el.classList.contains('leaving')) return;
+          var first = before.get(el);
+          var last = el.getBoundingClientRect();
+          if (!first) {
+            el.animate(
+              [{ opacity: 0, transform: 'scale(0.6)' }, { opacity: 1, transform: 'scale(1)' }],
+              { duration: DURATION, easing: EASING }
+            );
+            return;
+          }
+          var dx = first.left - last.left, dy = first.top - last.top;
+          if (dx || dy) {
+            el.animate(
+              [{ transform: 'translate(' + dx + 'px,' + dy + 'px)' }, { transform: 'none' }],
+              { duration: DURATION, easing: EASING }
+            );
+          }
+        });
+
+        leaving.forEach(function (el) {
+          var a = el.animate(
+            [{ opacity: 1, transform: 'scale(1)' }, { opacity: 0, transform: 'scale(0.6)' }],
+            { duration: DURATION, easing: EASING, fill: 'forwards' }
+          );
+          a.onfinish = function () { el.remove(); };
+        });
+      }
+
+      function finishLeaving() {
+        Array.prototype.slice.call(list.querySelectorAll('.leaving')).forEach(function (el) { el.remove(); });
+      }
+
+      function update() {
+        var count = selected.length;
+        empty.hidden = count > 0;
+        addBtn.disabled = false;
+      }
+
+      function add() {
+        transition(function () {
+          // Prefer a bean not already selected; fall back to numbered repeats.
+          var names = selected.map(function (b) { return b.name; });
+          var bean = CATALOG.filter(function (b) { return names.indexOf(b.name) === -1; })[0];
+          if (!bean) {
+            var base = CATALOG[nextId % CATALOG.length];
+            bean = { name: base.name + ' #' + (Math.floor(nextId / CATALOG.length) + 2), note: base.note };
+          }
+          nextId++;
+          selected.push(bean);
+          // Insert at a random position so neighbours visibly shift.
+          var idx = Math.floor(Math.random() * (list.querySelectorAll('.bean-item:not(.leaving)').length + 1));
+          var live = list.querySelectorAll('.bean-item:not(.leaving)');
+          list.insertBefore(makeItem(bean), live[idx] || null);
+        });
+      }
+
+      function remove(li) {
+        transition(function () {
+          selected = selected.filter(function (b) { return b.name !== li.dataset.name; });
+          li.classList.add('leaving');
+        });
+      }
+
+      function shuffle() {
+        transition(function () {
+          var items = Array.prototype.slice.call(list.querySelectorAll('.bean-item:not(.leaving)'));
+          for (var i = items.length - 1; i > 0; i--) {
+            var j = Math.floor(Math.random() * (i + 1));
+            var t = items[i]; items[i] = items[j]; items[j] = t;
+          }
+          items.forEach(function (el) { list.appendChild(el); });
+        });
+      }
+
+      addBtn.addEventListener('click', add);
+      document.getElementById('bean-shuffle').addEventListener('click', shuffle);
+      list.addEventListener('click', function (e) {
+        var btn = e.target.closest('.bean-remove');
+        if (btn) remove(btn.closest('.bean-item'));
+      });
+
+      // Initial selection (no animation)
+      selected = CATALOG.slice(0, 4);
+      selected.forEach(function (b) { list.appendChild(makeItem(b)); });
+      nextId = selected.length;
+      update();
+    })();
+  </script>
 </body>
 
