+  <script>
+    const BEANS = [
+      { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Floral, citrus, light roast' },
+      { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel, red apple, medium roast' },
+      { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Earthy, cocoa, dark roast' },
+      { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Chocolate, spice, medium roast' },
+      { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant, bright, light roast' },
+      { id: 'brazil', name: 'Brazil Santos', notes: 'Nutty, smooth, medium-dark roast' },
+    ];
+
+    const section = document.getElementById('beans');
+    const selectedList = document.getElementById('selected-beans');
+    const availableList = document.getElementById('available-beans');
+    const emptyMessage = selectedList.querySelector('.bean-empty');
+    const selected = new Set();
+
+    // Each item keeps one DOM node and a unique view-transition-name, so it
+    // animates between the two lists rather than being recreated.
+    const items = new Map(BEANS.map((bean) => {
+      const li = document.createElement('li');
+      li.className = 'bean';
+      li.style.viewTransitionName = `bean-${bean.id}`;
+      li.innerHTML = '<strong></strong><span></span><button type="button"></button>';
+      li.querySelector('strong').textContent = bean.name;
+      li.querySelector('span').textContent = bean.notes;
+      li.querySelector('button').addEventListener('click', () => toggle(bean.id));
+      return [bean.id, li];
+    }));
+
+    function render() {
+      for (const bean of BEANS) {
+        const li = items.get(bean.id);
+        const isSelected = selected.has(bean.id);
+        const button = li.querySelector('button');
+        button.textContent = isSelected ? 'Remove' : 'Add to selection';
+        button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+        (isSelected ? selectedList : availableList).append(li);
+      }
+      // Keep the empty message as the selection list's last child.
+      selectedList.append(emptyMessage);
+    }
+
+    function toggle(id) {
+      const li = items.get(id);
+      const hadFocus = li.contains(document.activeElement);
+      const update = () => {
+        selected.has(id) ? selected.delete(id) : selected.add(id);
+        render();
+        if (hadFocus) li.querySelector('button').focus();
+      };
+
+      // Prefer a transition scoped to the section so the rest of the page stays
+      // interactive; fall back to a document transition, then to no animation.
+      let transition;
+      if ('startViewTransition' in Element.prototype) {
+        transition = section.startViewTransition(update);
+      } else if (document.startViewTransition) {
+        transition = document.startViewTransition(update);
+      } else {
+        update();
+        return;
+      }
+      transition.ready.catch(() => {});
+    }
+
+    render();
+  </script>
