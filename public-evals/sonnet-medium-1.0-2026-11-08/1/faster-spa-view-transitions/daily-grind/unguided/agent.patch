+  <script>
+    // Client-side router. Each view is built once on first visit, then kept in the
+    // DOM (hidden) so scroll position, form input and filter state survive navigation.
+    (function () {
+      var app = document.getElementById('app');
+      var titles = { home: '', menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account' };
+      var base = 'The Daily Grind | Artisanal Coffee';
+      var views = { home: app.querySelector('[data-view="home"]') };
+      var current = 'home';
+      var scroll = {};
+
+      function routeFromHash() {
+        var r = location.hash.replace(/^#\/?/, '');
+        return titles.hasOwnProperty(r) && r ? r : 'home';
+      }
+
+      function getView(name) {
+        if (!views[name]) {
+          var t = document.getElementById('view-' + name);
+          var frag = t.content.cloneNode(true);
+          var el = frag.firstElementChild;
+          el.hidden = true;
+          app.appendChild(frag);
+          views[name] = el;
+        }
+        return views[name];
+      }
+
+      function show(name) {
+        if (name === current && !views[name].hidden) return;
+        scroll[current] = window.scrollY;
+        var next = getView(name);
+        views[current].hidden = true;
+        next.hidden = false;
+        current = name;
+        document.title = titles[name] ? titles[name] + ' | The Daily Grind' : base;
+        document.querySelectorAll('nav [data-route]').forEach(function (a) {
+          if (a.dataset.route === name) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+        window.scrollTo(0, scroll[name] || 0);
+      }
+
+      window.addEventListener('hashchange', function () { show(routeFromHash()); });
+
+      // Menu filter (delegated so it works once the view is created)
+      app.addEventListener('click', function (e) {
+        var chip = e.target.closest('.chip');
+        if (chip) {
+          var view = chip.closest('[data-view]');
+          view.querySelectorAll('.chip').forEach(function (c) { c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'); });
+          view.querySelectorAll('[data-cat]').forEach(function (card) {
+            card.hidden = chip.dataset.filter !== 'all' && card.dataset.cat !== chip.dataset.filter;
+          });
+        }
+        var join = e.target.closest('[data-join]');
+        if (join) { join.textContent = 'Joined ✓'; join.disabled = true; }
+      });
+
+      show(routeFromHash());
+      // Warm remaining views during idle time so first visits are fast too.
+      var idle = window.requestIdleCallback || function (f) { setTimeout(f, 200); };
+      idle(function () { ['menu', 'locations', 'rewards', 'account'].forEach(getView); });
+    })();
+  </script>
+
