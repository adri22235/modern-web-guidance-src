+  <script>
+    // Hash-routed SPA. Views are created once and then cached offscreen with
+    // content-visibility: hidden, so returning to a view reuses its rendering
+    // and DOM state (form input, scroll position within the view, etc.).
+    (() => {
+      const views = new Map();
+      document.querySelectorAll('.spa-view').forEach(v => views.set(v.dataset.view, v));
+      const links = document.querySelectorAll('nav a[href^="#/"]');
+      let current = null;
+
+      function routeFromHash() {
+        const name = location.hash.replace(/^#\/?/, '').split('/')[0];
+        return views.has(name) ? name : '';
+      }
+
+      function switchToView(name, { focus = true } = {}) {
+        if (name === current) return;
+        views.forEach((view, key) => {
+          const active = key === name;
+          view.classList.toggle('inactive', !active);
+          view.toggleAttribute('inert', !active);
+          view.setAttribute('aria-hidden', String(!active));
+        });
+        links.forEach(a => {
+          if (a.getAttribute('href') === '#/' + name) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
+        const active = views.get(name);
+        const title = active.getAttribute('aria-label');
+        document.title = (title ? title + ' | ' : '') + 'The Daily Grind';
+        current = name;
+        window.scrollTo(0, 0);
+        if (focus) active.focus({ preventScroll: true });
+      }
+
+      window.addEventListener('hashchange', () => switchToView(routeFromHash()));
+      switchToView(routeFromHash(), { focus: false });
+    })();
+  </script>
+
