diff --git a/src/components/SectionViews.astro b/src/components/SectionViews.astro
new file mode 100644
index 0000000..dfb5286
--- /dev/null
+++ b/src/components/SectionViews.astro
@@ -0,0 +1,101 @@
+---
+// Client-side section views. Inactive views stay in the DOM with
+// `content-visibility: hidden`, so returning to one is near-instant.
+const sections = [
+  { id: 'top-news', label: 'Top News' },
+  { id: 'world', label: 'World' },
+  { id: 'politics', label: 'Politics' },
+  { id: 'multimedia', label: 'Multimedia' },
+  { id: 'reports', label: 'Reports' },
+];
+---
+
+<section data-section-views>
+  <nav aria-label="Sections" class="border-b border-gray-300 bg-white">
+    <ul class="max-w-6xl mx-auto px-4 flex gap-6 text-sm font-semibold overflow-x-auto">
+      {sections.map((s, i) => (
+        <li>
+          <a
+            href={`#${s.id}`}
+            data-section-link={s.id}
+            aria-current={i === 0 ? 'page' : undefined}
+            class="block py-3 whitespace-nowrap border-b-2 border-transparent hover:text-gray-600 aria-[current=page]:border-amber-400 aria-[current=page]:text-amber-500"
+          >
+            {s.label}
+          </a>
+        </li>
+      ))}
+    </ul>
+  </nav>
+
+  {sections.map((s, i) => (
+    <div
+      id={`view-${s.id}`}
+      data-section-view={s.id}
+      class={`spa-view${i === 0 ? '' : ' inactive'}`}
+      tabindex="-1"
+      inert={i !== 0}
+      aria-hidden={i === 0 ? 'false' : 'true'}
+    >
+      <slot name={s.id} />
+    </div>
+  ))}
+</section>
+
+<style is:global>
+  .spa-view:focus {
+    outline: none;
+  }
+  .spa-view.inactive {
+    content-visibility: hidden;
+    position: absolute;
+    width: 100%;
+  }
+  @supports not (content-visibility: hidden) {
+    .spa-view.inactive {
+      display: none;
+    }
+  }
+</style>
+
+<script>
+  const DEFAULT_VIEW = 'top-news';
+
+  function initSectionViews() {
+    const root = document.querySelector<HTMLElement>('[data-section-views]');
+    if (!root) return;
+    const views = root.querySelectorAll<HTMLElement>('[data-section-view]');
+    const links = root.querySelectorAll<HTMLElement>('[data-section-link]');
+    const ids = Array.from(views, (v) => v.dataset.sectionView!);
+
+    const show = (id: string, moveFocus: boolean) => {
+      if (!ids.includes(id)) id = DEFAULT_VIEW;
+      views.forEach((view) => {
+        const active = view.dataset.sectionView === id;
+        view.classList.toggle('inactive', !active);
+        view.inert = !active;
+        view.setAttribute('aria-hidden', String(!active));
+        if (active && moveFocus) view.focus({ preventScroll: true });
+      });
+      links.forEach((link) => {
+        if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'page');
+        else link.removeAttribute('aria-current');
+      });
+    };
+
+    const fromHash = () => location.hash.slice(1);
+    show(fromHash(), false);
+
+    // Hash changes cover link clicks and back/forward; the target ids don't
+    // exist in the document, so the browser doesn't scroll or reload.
+    const onHashChange = () => show(fromHash(), true);
+    window.addEventListener('hashchange', onHashChange);
+    document.addEventListener(
+      'astro:before-swap',
+      () => window.removeEventListener('hashchange', onHashChange),
+      { once: true },
+    );
+  }
+
+  document.addEventListener('astro:page-load', initSectionViews);
+</script>
