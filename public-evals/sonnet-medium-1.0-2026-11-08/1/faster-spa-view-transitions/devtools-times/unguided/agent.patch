diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..fe44d23
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,155 @@
+---
+const baseUrl = import.meta.env.BASE_URL;
+const sections = [
+  { label: "Top News", path: "" },
+  { label: "World", path: "world" },
+  { label: "Politics", path: "politics" },
+  { label: "Multimedia", path: "multimedia" },
+  { label: "Reports", path: "reports" },
+];
+---
+
+<nav aria-label="Sections" class="border-b border-gray-300">
+  <ul class="container mx-auto px-4 flex justify-center items-center text-sm font-semibold space-x-6 h-10 overflow-x-auto">
+    {sections.map((s) => (
+      <li class="h-full">
+        <a
+          href={`${baseUrl}${s.path}`}
+          data-section-link
+          class="h-full flex items-center whitespace-nowrap border-b-2 border-transparent hover:text-gray-600 aria-[current=page]:text-amber-500 aria-[current=page]:border-amber-400"
+        >{s.label}</a>
+      </li>
+    ))}
+  </ul>
+</nav>
+
+<script>
+  // Client-side section views. Each visited section lives in its own
+  // <section data-view-path> inside #view-host. Leaving a view only hides it,
+  // so returning is instant and keeps scroll/DOM/island state. Views are also
+  // stashed across ClientRouter body swaps (e.g. visiting an article).
+  const stash = new Map<string, HTMLElement>();
+  const scrollPos = new Map<string, number>();
+  let listening = false;
+
+  const norm = (p: string) => p.replace(/\/+$/, "") || "/";
+  const host = () => document.getElementById("view-host");
+  const views = () =>
+    Array.from(host()?.querySelectorAll<HTMLElement>(":scope > [data-view-path]") ?? []);
+  const find = (path: string) => views().find((v) => v.dataset.viewPath === path);
+
+  function activate(path: string) {
+    for (const v of views()) v.hidden = v.dataset.viewPath !== path;
+    for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-section-link]")) {
+      if (norm(new URL(a.href).pathname) === path) a.setAttribute("aria-current", "page");
+      else a.removeAttribute("aria-current");
+    }
+  }
+
+  const pending = new Map<string, Promise<HTMLElement | null>>();
+  function load(path: string, url: string): Promise<HTMLElement | null> {
+    let p = pending.get(path);
+    if (!p) {
+      p = fetch(url)
+        .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
+        .then((html) => {
+          const doc = new DOMParser().parseFromString(html, "text/html");
+          const src = doc.querySelector<HTMLElement>("[data-view-path]");
+          if (!src) return null;
+          const el = document.adoptNode(src) as HTMLElement;
+          el.dataset.viewTitle = doc.title;
+          return el;
+        })
+        .catch(() => null)
+        .finally(() => pending.delete(path));
+      pending.set(path, p);
+    }
+    return p;
+  }
+
+  async function show(url: URL, push: boolean) {
+    const path = norm(url.pathname);
+    const current = views().find((v) => !v.hidden);
+    if (current) scrollPos.set(current.dataset.viewPath!, window.scrollY);
+
+    let view = find(path);
+    if (!view) {
+      view = (stash.get(path) ?? (await load(path, url.href))) ?? undefined;
+      if (!view) {
+        location.href = url.href; // fall back to a full navigation
+        return;
+      }
+      stash.delete(path);
+      view.hidden = true;
+      host()!.appendChild(view);
+    }
+    if (push) history.pushState({ spaSection: true }, "", url.href);
+    document.title = view.dataset.viewTitle ?? document.title;
+    activate(path);
+    window.scrollTo(0, scrollPos.get(path) ?? 0);
+  }
+
+  function prefetch(e: Event) {
+    const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>("a[data-section-link]");
+    if (!a || !host()) return;
+    const url = new URL(a.href);
+    const path = norm(url.pathname);
+    if (!find(path) && !stash.has(path)) load(path, url.href).then((el) => {
+      if (el && !find(path) && !stash.has(path)) stash.set(path, el);
+    });
+  }
+
+  function init() {
+    const h = host();
+    if (!h) return;
+    const here = views().find((v) => !v.hidden);
+    if (here) {
+      here.dataset.viewTitle ||= document.title;
+      // Reattach views kept from before the body swap (keeps their DOM state).
+      for (const [path, el] of stash) {
+        if (find(path)) stash.delete(path);
+        else if (path !== here.dataset.viewPath) {
+          el.hidden = true;
+          h.appendChild(el);
+          stash.delete(path);
+        }
+      }
+      activate(here.dataset.viewPath!);
+    }
+  }
+
+  if (!listening) {
+    listening = true;
+    document.addEventListener(
+      "click",
+      (e) => {
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+        const a = (e.target as Element).closest?.<HTMLAnchorElement>("a[data-section-link]");
+        if (!a || !host() || a.target) return;
+        e.preventDefault();
+        e.stopImmediatePropagation(); // keep ClientRouter from doing a full swap
+        const url = new URL(a.href);
+        if (norm(url.pathname) === norm(location.pathname)) return;
+        show(url, true);
+      },
+      true,
+    );
+    document.addEventListener("pointerover", prefetch, { passive: true });
+    document.addEventListener("focusin", prefetch);
+    window.addEventListener("popstate", () => {
+      const path = norm(location.pathname);
+      if (host() && find(path)) {
+        show(new URL(location.href), false);
+      }
+    });
+    // Stash views before the body is replaced by a non-section navigation.
+    document.addEventListener("astro:before-swap", () => {
+      for (const v of views()) {
+        v.remove();
+        stash.set(v.dataset.viewPath!, v);
+      }
+    });
+    document.addEventListener("astro:page-load", init);
+  }
+  init();
+</script>
