+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('customizer-stage');
+      const panel = document.getElementById('order-panel');
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('cup-milk');
+      const syrupSelect = document.getElementById('cup-syrup');
+      const summary = document.getElementById('order-summary');
+      const ctx = canvas.getContext('2d');
+
+      const supported = 'content' in HTMLCanvasElement.prototype;
+      const MILK = { whole: '#c9a27a', oat: '#b98a5e', almond: '#c4986a', soy: '#bf9468', none: '#3b2219' };
+      const SYRUP = { none: null, vanilla: '#f3e2a9', caramel: '#c8762b', maple: '#a8531a', hazelnut: '#7a4a2a' };
+      const NARROW = 560;
+      const PAD = 16;
+
+      // Layout in CSS pixels, recomputed on every resize.
+      const layout = { w: 0, h: 0, narrow: false, cup: { x: 0, y: 0, w: 0, h: 0 }, panel: { x: 0, y: 0 } };
+
+      function computeLayout(width) {
+        layout.narrow = width < NARROW;
+        if (layout.narrow) {
+          panel.style.width = `${width - PAD * 2}px`;
+          const cupH = 220;
+          layout.cup = { x: 0, y: 0, w: width, h: cupH };
+          layout.panel = { x: PAD, y: cupH };
+          layout.h = cupH + panel.offsetHeight + PAD;
+        } else {
+          panel.style.width = '280px';
+          layout.cup = { x: 0, y: 0, w: width - 280 - PAD * 2, h: 360 };
+          layout.panel = { x: width - 280 - PAD, y: PAD };
+          layout.h = Math.max(360, panel.offsetHeight + PAD * 2);
+        }
+        layout.w = width;
+      }
+
+      function drawCup() {
+        const { x, y, w, h } = layout.cup;
+        const size = Math.min(w - 40, h - 40, 220);
+        const cx = x + w / 2;
+        const top = y + (h - size) / 2 + 10;
+        const topW = size * 0.8;
+        const botW = size * 0.56;
+        const cupH = size * 0.9;
+        const milk = milkSelect.value;
+        const syrup = SYRUP[syrupSelect.value];
+
+        // Saucer shadow
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.15)';
+        ctx.beginPath();
+        ctx.ellipse(cx, top + cupH + 6, topW * 0.62, size * 0.07, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = '#4e342e';
+        ctx.lineWidth = size * 0.06;
+        ctx.beginPath();
+        ctx.arc(cx + topW / 2 - size * 0.02, top + cupH * 0.42, size * 0.17, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+
+        // Cup body
+        const body = new Path2D();
+        body.moveTo(cx - topW / 2, top);
+        body.lineTo(cx + topW / 2, top);
+        body.lineTo(cx + botW / 2, top + cupH);
+        body.quadraticCurveTo(cx, top + cupH + size * 0.06, cx - botW / 2, top + cupH);
+        body.closePath();
+        ctx.fillStyle = '#fffaf5';
+        ctx.fill(body);
+        ctx.lineWidth = 3;
+        ctx.strokeStyle = '#4e342e';
+        ctx.stroke(body);
+
+        // Drink fill, clipped to the cup
+        ctx.save();
+        ctx.clip(body);
+        const fillTop = top + cupH * 0.12;
+        ctx.fillStyle = MILK[milk];
+        ctx.fillRect(cx - topW, fillTop, topW * 2, cupH);
+        if (syrup) {
+          ctx.fillStyle = syrup;
+          ctx.fillRect(cx - topW, fillTop, topW * 2, cupH * 0.1);
+        }
+        ctx.restore();
+
+        // Surface and syrup swirl
+        ctx.fillStyle = milk === 'none' ? '#24130d' : '#e9d3b8';
+        ctx.beginPath();
+        ctx.ellipse(cx, fillTop, topW / 2 - 4, size * 0.05, 0, 0, Math.PI * 2);
+        ctx.fill();
+        if (syrup) {
+          ctx.strokeStyle = syrup;
+          ctx.lineWidth = 4;
+          ctx.lineCap = 'round';
+          ctx.beginPath();
+          const sw = topW * 0.3;
+          ctx.moveTo(cx - sw, fillTop);
+          ctx.bezierCurveTo(cx - sw / 2, fillTop - 8, cx - sw / 3, fillTop + 8, cx, fillTop);
+          ctx.bezierCurveTo(cx + sw / 3, fillTop - 8, cx + sw / 2, fillTop + 8, cx + sw, fillTop);
+          ctx.stroke();
+        }
+
+        // Cup sleeve with the name
+        const sleeveTop = top + cupH * 0.38;
+        const sleeveH = cupH * 0.34;
+        const widthAt = (yy) => botW + (topW - botW) * (1 - (yy - top) / cupH);
+        ctx.fillStyle = '#4e342e';
+        ctx.beginPath();
+        ctx.moveTo(cx - widthAt(sleeveTop) / 2, sleeveTop);
+        ctx.lineTo(cx + widthAt(sleeveTop) / 2, sleeveTop);
+        ctx.lineTo(cx + widthAt(sleeveTop + sleeveH) / 2, sleeveTop + sleeveH);
+        ctx.lineTo(cx - widthAt(sleeveTop + sleeveH) / 2, sleeveTop + sleeveH);
+        ctx.closePath();
+        ctx.fill();
+        ctx.fillStyle = '#ffab40';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.font = `bold ${Math.round(size * 0.1)}px 'Segoe UI', Tahoma, sans-serif`;
+        ctx.fillText(nameInput.value.trim() || 'Your name', cx, sleeveTop + sleeveH / 2, widthAt(sleeveTop + sleeveH) - 12);
+      }
+
+      function updateSummary() {
+        const milk = milkSelect.selectedOptions[0].text.toLowerCase();
+        const syrup = syrupSelect.value === 'none' ? 'no syrup' : `${syrupSelect.selectedOptions[0].text.toLowerCase()} syrup`;
+        const name = nameInput.value.trim() || 'you';
+        summary.textContent = `A coffee for ${name}: ${milk}, ${syrup}.`;
+      }
+
+      function placeFallbackPanel() {
+        panel.style.left = `${layout.panel.x}px`;
+        panel.style.top = `${layout.panel.y}px`;
+      }
+
+      function paint() {
+        // Canvas grid is in device pixels; draw in CSS pixels.
+        const scale = canvas.width / layout.w;
+        ctx.reset();
+        ctx.scale(scale, scale);
+        drawCup();
+        if (supported) {
+          // The browser syncs the DOM hit-test bounds to the drawn position.
+          ctx.drawElementImage(panel, layout.panel.x, layout.panel.y);
+        }
+      }
+
+      function refresh() {
+        updateSummary();
+        if (supported) canvas.requestPaint();
+        else paint();
+      }
+
+      if (supported) {
+        canvas.onpaint = paint;
+      } else {
+        stage.classList.add('is-fallback');
+        stage.appendChild(panel);
+      }
+
+      const resize = (entry) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        const cssW = entry.contentRect.width;
+        computeLayout(cssW);
+        const heightPx = `${layout.h}px`;
+        if (canvas.style.height !== heightPx) canvas.style.height = heightPx;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(cssW * window.devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(layout.h * window.devicePixelRatio);
+        if (!supported) placeFallbackPanel();
+        refresh();
+      };
+      const observer = new ResizeObserver(([entry]) => resize(entry));
+      const supportsDpc = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDpc ? { box: 'device-pixel-content-box' } : {});
+
+      panel.addEventListener('input', refresh);
+      panel.addEventListener('change', refresh);
+      panel.addEventListener('submit', (e) => e.preventDefault());
+    })();
+  </script>
+
 </body>
 
