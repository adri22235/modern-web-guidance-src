+  <script>
+    (() => {
+      const BASE_W = 560, BASE_H = 420;
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('cup-stage');
+      const ctx = canvas.getContext('2d');
+      const nameIn = document.getElementById('cup-name');
+      const milkIn = document.getElementById('cup-milk');
+      const syrupIn = document.getElementById('cup-syrup');
+
+      // Native HTML-in-canvas support (layoutsubtree + drawElementImage)
+      const native = 'drawElementImage' in CanvasRenderingContext2D.prototype ||
+        'drawElement' in CanvasRenderingContext2D.prototype;
+
+      const MILK = { Whole: '#f3e5d0', Oat: '#e0c9a6', Almond: '#e8d5bb', Soy: '#efe2c4', None: '#3b2318' };
+      const SYRUP = { None: null, Maple: '#c77d2b', Vanilla: '#f6e6a8', Caramel: '#b8691e', Hazelnut: '#8a5a3a' };
+
+      // Control placement in base (560x420) coordinates
+      const controls = [
+        { el: nameIn,  x: 215, y: 205, w: 130 },
+        { el: milkIn,  x: 20,  y: 90,  w: 130 },
+        { el: syrupIn, x: 410, y: 90,  w: 130 },
+      ];
+
+      // Fallback: canvas children aren't rendered, so overlay them on the stage
+      if (!native) controls.forEach(c => stage.appendChild(c.el));
+
+      let scale = 1, dpr = window.devicePixelRatio || 1;
+
+      function size() {
+        dpr = window.devicePixelRatio || 1;
+        const cssW = stage.clientWidth;
+        scale = cssW / BASE_W;
+        canvas.width = Math.round(cssW * dpr);
+        canvas.height = Math.round(cssW * (BASE_H / BASE_W) * dpr);
+        controls.forEach(c => {
+          // Layout size in CSS px of the scaled graphic so the control matches what is drawn
+          c.el.style.width = c.w * scale + 'px';
+          c.el.style.fontSize = Math.max(11, 15 * scale) + 'px';
+        });
+      }
+
+      function roundRect(x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.roundRect(x, y, w, h, r);
+      }
+
+      function drawScene() {
+        const k = (canvas.width / BASE_W);
+        ctx.setTransform(k, 0, 0, k, 0, 0);
+        ctx.clearRect(0, 0, BASE_W, BASE_H);
+
+        // Backdrop
+        ctx.fillStyle = '#fdf8f3';
+        ctx.fillRect(0, 0, BASE_W, BASE_H);
+
+        // Saucer
+        ctx.fillStyle = '#d7ccc8';
+        ctx.beginPath(); ctx.ellipse(280, 372, 150, 22, 0, 0, Math.PI * 2); ctx.fill();
+        ctx.fillStyle = '#bcaaa4';
+        ctx.beginPath(); ctx.ellipse(280, 368, 120, 14, 0, 0, Math.PI * 2); ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = '#fff'; ctx.lineWidth = 16;
+        ctx.beginPath(); ctx.arc(400, 255, 40, -Math.PI / 2, Math.PI / 2); ctx.stroke();
+        ctx.strokeStyle = '#4e342e'; ctx.lineWidth = 3;
+        ctx.beginPath(); ctx.arc(400, 255, 48, -Math.PI / 2, Math.PI / 2); ctx.stroke();
+
+        // Cup body
+        ctx.beginPath();
+        ctx.moveTo(180, 150); ctx.lineTo(380, 150);
+        ctx.quadraticCurveTo(375, 345, 280, 355);
+        ctx.quadraticCurveTo(185, 345, 180, 150);
+        ctx.closePath();
+        ctx.fillStyle = '#ffffff'; ctx.fill();
+        ctx.lineWidth = 3; ctx.strokeStyle = '#4e342e'; ctx.stroke();
+
+        // Liquid
+        const milk = milkIn.value, syrup = syrupIn.value;
+        ctx.save();
+        ctx.clip();
+        ctx.fillStyle = '#4a2c1d';
+        ctx.fillRect(170, 168, 220, 200);
+        if (milk !== 'None') {
+          ctx.fillStyle = MILK[milk];
+          ctx.fillRect(170, 168, 220, 22);
+          ctx.fillStyle = MILK[milk];
+          ctx.globalAlpha = 0.35;
+          ctx.fillRect(170, 190, 220, 60);
+          ctx.globalAlpha = 1;
+        }
+        if (SYRUP[syrup]) {
+          ctx.fillStyle = SYRUP[syrup];
+          ctx.globalAlpha = 0.85;
+          ctx.fillRect(170, 330, 220, 40);
+          ctx.globalAlpha = 1;
+        }
+        ctx.restore();
+
+        // Rim
+        ctx.strokeStyle = '#4e342e'; ctx.lineWidth = 3;
+        ctx.beginPath(); ctx.ellipse(280, 150, 100, 12, 0, 0, Math.PI * 2); ctx.stroke();
+
+        // Steam
+        ctx.strokeStyle = 'rgba(78,52,46,0.35)'; ctx.lineWidth = 4; ctx.lineCap = 'round';
+        [240, 280, 320].forEach((x, i) => {
+          ctx.beginPath();
+          ctx.moveTo(x, 125);
+          ctx.bezierCurveTo(x - 14, 105 - i * 4, x + 14, 90, x, 65 - i * 6);
+          ctx.stroke();
+        });
+
+        // Text drawn in the graphic
+        ctx.fillStyle = '#4e342e';
+        ctx.textAlign = 'left'; ctx.font = 'bold 14px "Segoe UI", sans-serif';
+        ctx.fillText('MILK', 22, 80);
+        ctx.fillText('SYRUP', 412, 80);
+        ctx.textAlign = 'center';
+        ctx.fillText('CUP NAME', 280, 195);
+        ctx.font = '16px "Segoe UI", sans-serif';
+        const label = (nameIn.value.trim() || 'Your') + "'s " + (milk === 'None' ? '' : milk + ' ') + 'Coffee';
+        ctx.fillText(label, 280, 28);
+        ctx.font = '13px "Segoe UI", sans-serif';
+        ctx.fillStyle = '#795548';
+        ctx.fillText(SYRUP[syrup] ? syrup + ' syrup' : 'No syrup', 280, 48);
+
+        ctx.fillStyle = '#4e342e'; ctx.font = '12px "Segoe UI", sans-serif';
+      }
+
+      function placeControls() {
+        controls.forEach(c => {
+          const x = c.x * scale, y = c.y * scale;
+          if (native) {
+            // Draw the live element into the canvas; the returned transform keeps hit-testing aligned
+            ctx.setTransform(1, 0, 0, 1, 0, 0);
+            const draw = ctx.drawElementImage || ctx.drawElement;
+            const t = draw.call(ctx, c.el, x * dpr, y * dpr);
+            c.el.style.transform = t ? t.toString() : '';
+          } else {
+            c.el.style.transform = `translate(${x}px, ${y}px)`;
+          }
+        });
+      }
+
+      function render() {
+        drawScene();
+        placeControls();
+      }
+
+      function refresh() {
+        if (native && canvas.requestPaint) canvas.requestPaint();
+        else render();
+      }
+
+      if (native) canvas.addEventListener('paint', render);
+
+      ['input', 'change'].forEach(ev => stage.addEventListener(ev, refresh));
+      if (native) {
+        // Controls live inside the canvas subtree in native mode
+        ['input', 'change'].forEach(ev => canvas.addEventListener(ev, refresh));
+      }
+
+      new ResizeObserver(() => { size(); refresh(); }).observe(stage);
+      window.matchMedia(`(resolution: ${dpr}dppx)`).addEventListener?.('change', () => { size(); refresh(); });
+      size();
+      render();
+    })();
+  </script>
+
 </body>
 
