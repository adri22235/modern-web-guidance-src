+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state
+    const syncAria = (event) => {
+      const el = event.target;
+      if (!el.matches?.('select')) return;
+      if (el.matches(':user-invalid')) {
+        el.setAttribute('aria-invalid', 'true');
+      } else {
+        el.removeAttribute('aria-invalid');
+      }
+    };
+    document.addEventListener('blur', syncAria, true);
+    document.addEventListener('change', syncAria, true);
+    document.addEventListener('invalid', syncAria, true);
+  </script>
