+  <script>
+    // Show validation errors only after interaction or a submit attempt.
+    const form = document.querySelector('.order-form');
+    const shop = document.getElementById('shop');
+    const markTouched = () => shop.classList.add('touched');
+    shop.addEventListener('change', markTouched);
+    shop.addEventListener('blur', markTouched);
+    form.addEventListener('submit', (e) => {
+      markTouched();
+      if (!form.checkValidity()) {
+        e.preventDefault();
+        shop.focus();
+      }
+    });
+  </script>
