+  <script>
+    // Defer offscreen media (src, poster, preloaded data) until near the viewport.
+    (function () {
+      var els = document.querySelectorAll('[data-src]');
+
+      function load(el) {
+        if (el.dataset.poster) el.poster = el.dataset.poster;
+        if (el.tagName === 'IMG') {
+          el.src = el.dataset.src;
+          return;
+        }
+        var source = document.createElement('source');
+        source.src = el.dataset.src;
+        source.type = el.dataset.type;
+        el.appendChild(source);
+        el.preload = 'metadata';
+        el.load();
+      }
+
+      if (!('IntersectionObserver' in window)) {
+        els.forEach(load);
+        return;
+      }
+
+      var io = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (!entry.isIntersecting) return;
+          io.unobserve(entry.target);
+          load(entry.target);
+        });
+      }, { rootMargin: '300px 0px' });
+
+      els.forEach(function (el) { io.observe(el); });
+    })();
+  </script>
