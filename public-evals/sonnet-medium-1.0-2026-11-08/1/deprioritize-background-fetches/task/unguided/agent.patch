diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,27 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>Fetch</title>
+</head>
+<body>
+<button id="go">Load</button>
+<script>
+document.getElementById('go').onclick = () => {
+  // Critical data: high priority
+  fetch('/api/data', { priority: 'high' })
+    .then(r => r.json())
+    .then(console.log);
+
+  // Analytics: low priority so it doesn't compete with the critical request
+  fetch('/api/analytics', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ click: 1 }),
+    priority: 'low',
+    keepalive: true
+  }).catch(() => {});
+};
+</script>
+</body>
+</html>
