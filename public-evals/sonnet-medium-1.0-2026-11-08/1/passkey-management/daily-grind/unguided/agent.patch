diff --git a/account/index.html b/account/index.html
new file mode 100644
index 0000000..6d34487
--- /dev/null
+++ b/account/index.html
@@ -0,0 +1,353 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account · Passkeys | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+      --danger: #b71c1c;
+    }
+
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; color: white; text-decoration: none; }
+    nav ul { display: flex; list-style: none; }
+    nav ul li { margin-left: 20px; }
+    nav a { color: white; text-decoration: none; font-size: 0.9rem; transition: color 0.3s; }
+    nav a:hover, nav a[aria-current="page"] { color: var(--accent); }
+    .logout-link { border: 1px solid var(--accent); padding: 5px 12px; border-radius: 4px; }
+
+    .container { max-width: 760px; margin: 40px auto; padding: 0 20px; }
+    h1 { color: var(--primary); margin-bottom: 0.25rem; }
+    .lead { margin-bottom: 1.5rem; }
+
+    .panel {
+      background: white;
+      padding: 24px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
+    .panel-head h2 { color: var(--primary); font-size: 1.25rem; }
+
+    button {
+      font: inherit;
+      cursor: pointer;
+      border-radius: 5px;
+      padding: 8px 16px;
+      border: 1px solid var(--primary);
+      background: white;
+      color: var(--primary);
+    }
+    button:hover { background: var(--secondary); }
+    button.primary { background: var(--primary); color: white; }
+    button.primary:hover { background: #3e2723; }
+    button.danger { color: var(--danger); border-color: var(--danger); }
+    button.danger:hover { background: #fdecea; }
+    button:disabled { opacity: 0.5; cursor: not-allowed; }
+    :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+
+    ul.passkeys { list-style: none; }
+    .passkey {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 16px;
+      flex-wrap: wrap;
+      padding: 16px 0;
+      border-top: 1px solid var(--secondary);
+    }
+    .passkey:first-child { border-top: 0; }
+    .passkey-name { font-weight: 600; word-break: break-word; }
+    .passkey-meta { font-size: 0.85rem; opacity: 0.75; }
+    .actions { display: flex; gap: 8px; }
+    .rename-form { display: flex; gap: 8px; flex: 1; min-width: 240px; }
+    .rename-form input {
+      flex: 1;
+      font: inherit;
+      padding: 8px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+    }
+
+    .empty { text-align: center; padding: 24px 0; }
+    .status { margin-top: 16px; padding: 10px 14px; border-radius: 5px; background: #e8f5e9; }
+    .status.error { background: #fdecea; color: var(--danger); }
+    .status[hidden] { display: none; }
+    .note { margin-top: 16px; font-size: 0.85rem; opacity: 0.75; }
+
+    footer { background: var(--secondary); text-align: center; padding: 40px 20px; margin-top: 40px; }
+    .footer-links { margin-bottom: 20px; }
+    .footer-links a { margin: 0 10px; color: var(--text); text-decoration: none; font-size: 0.85rem; }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <h1>My Account</h1>
+    <p class="lead">Manage the passkeys you use to sign in to The Daily Grind.</p>
+
+    <section class="panel" aria-labelledby="passkeys-heading">
+      <div class="panel-head">
+        <h2 id="passkeys-heading">Your passkeys</h2>
+        <button type="button" class="primary" id="add-btn">Add a passkey</button>
+      </div>
+
+      <p id="loading">Loading your passkeys…</p>
+      <ul class="passkeys" id="list" hidden></ul>
+      <p class="empty" id="empty" hidden>You haven't registered any passkeys yet.</p>
+
+      <div class="status" id="status" role="status" aria-live="polite" hidden></div>
+      <p class="note">Deleting a passkey here also asks your browser or password manager to remove it, when supported.
+        Passkeys already saved on other devices may need to be removed there manually.</p>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    /*
+     * Assumed backend contract (JSON, session-cookie auth):
+     *   GET    /api/passkeys             -> { rpId?, user: { id, name, displayName }, passkeys: [{ id, name, createdAt, lastUsedAt }] }
+     *   PATCH  /api/passkeys/:id         body { name }
+     *   DELETE /api/passkeys/:id
+     * `id` is the base64url credential ID; `user.id` is the base64url WebAuthn user handle.
+     * 401 means the customer is signed out.
+     */
+    const API = '/api/passkeys';
+    const $ = (id) => document.getElementById(id);
+    const listEl = $('list'), emptyEl = $('empty'), loadingEl = $('loading'), statusEl = $('status');
+
+    let state = { rpId: location.hostname, user: null, passkeys: [] };
+
+    function say(msg, isError) {
+      statusEl.textContent = msg;
+      statusEl.className = 'status' + (isError ? ' error' : '');
+      statusEl.hidden = false;
+    }
+
+    async function api(path, opts = {}) {
+      const res = await fetch(API + path, {
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        ...opts,
+      });
+      if (res.status === 401) {
+        location.href = '/login?next=' + encodeURIComponent(location.pathname);
+        throw new Error('Signed out');
+      }
+      if (!res.ok) throw new Error('Request failed (' + res.status + ')');
+      return res.status === 204 ? null : res.json();
+    }
+
+    /* Browser authenticator sync via the WebAuthn Signal API. Best effort: never blocks the UI. */
+    const signals = {
+      async run(method, payload) {
+        if (!window.PublicKeyCredential || typeof PublicKeyCredential[method] !== 'function') return false;
+        try { await PublicKeyCredential[method](payload); return true; } catch (e) { console.warn(method, e); return false; }
+      },
+      accepted() {
+        if (!state.user) return false;
+        return this.run('signalAllAcceptedCredentials', {
+          rpId: state.rpId,
+          userId: state.user.id,
+          allAcceptedCredentialIds: state.passkeys.map((p) => p.id),
+        });
+      },
+      removed(id) { return this.run('signalUnknownCredential', { rpId: state.rpId, credentialId: id }); },
+      details() {
+        if (!state.user) return false;
+        return this.run('signalCurrentUserDetails', {
+          rpId: state.rpId,
+          userId: state.user.id,
+          name: state.user.name,
+          displayName: state.user.displayName || state.user.name,
+        });
+      },
+    };
+
+    const fmt = (iso) => iso ? new Date(iso).toLocaleDateString(undefined, { dateStyle: 'medium' }) : null;
+
+    function render() {
+      loadingEl.hidden = true;
+      listEl.replaceChildren();
+      emptyEl.hidden = state.passkeys.length > 0;
+      listEl.hidden = state.passkeys.length === 0;
+      state.passkeys.forEach((p) => listEl.append(row(p)));
+    }
+
+    function row(p) {
+      const li = document.createElement('li');
+      li.className = 'passkey';
+      showView(li, p);
+      return li;
+    }
+
+    function showView(li, p) {
+      const info = document.createElement('div');
+      const name = document.createElement('div');
+      name.className = 'passkey-name';
+      name.textContent = p.name || 'Unnamed passkey';
+      const meta = document.createElement('div');
+      meta.className = 'passkey-meta';
+      meta.textContent = [
+        fmt(p.createdAt) && 'Added ' + fmt(p.createdAt),
+        p.lastUsedAt ? 'Last used ' + fmt(p.lastUsedAt) : 'Never used',
+      ].filter(Boolean).join(' · ');
+      info.append(name, meta);
+
+      const actions = document.createElement('div');
+      actions.className = 'actions';
+      const rename = button('Rename', '', () => showEdit(li, p));
+      rename.setAttribute('aria-label', 'Rename ' + (p.name || 'passkey'));
+      const del = button('Delete', 'danger', () => remove(p, del));
+      del.setAttribute('aria-label', 'Delete ' + (p.name || 'passkey'));
+      actions.append(rename, del);
+      li.replaceChildren(info, actions);
+    }
+
+    function showEdit(li, p) {
+      const form = document.createElement('form');
+      form.className = 'rename-form';
+      const input = document.createElement('input');
+      input.value = p.name || '';
+      input.maxLength = 64;
+      input.required = true;
+      input.setAttribute('aria-label', 'Passkey name');
+      const save = button('Save', 'primary');
+      save.type = 'submit';
+      const cancel = button('Cancel', '', () => showView(li, p));
+      form.append(input, save, cancel);
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const name = input.value.trim();
+        if (!name) return;
+        save.disabled = true;
+        try {
+          await api('/' + encodeURIComponent(p.id), { method: 'PATCH', body: JSON.stringify({ name }) });
+          p.name = name;
+          showView(li, p);
+          say('Passkey renamed.');
+          signals.details(); // keep authenticator's account details current
+        } catch (err) {
+          save.disabled = false;
+          say('Could not rename passkey. ' + err.message, true);
+        }
+      });
+      li.replaceChildren(form);
+      input.focus();
+      input.select();
+    }
+
+    function button(label, cls, onClick) {
+      const b = document.createElement('button');
+      b.type = 'button';
+      b.textContent = label;
+      if (cls) b.className = cls;
+      if (onClick) b.addEventListener('click', onClick);
+      return b;
+    }
+
+    async function remove(p, btn) {
+      if (!confirm('Delete "' + (p.name || 'this passkey') + '"? You won\'t be able to sign in with it again.')) return;
+      btn.disabled = true;
+      try {
+        await api('/' + encodeURIComponent(p.id), { method: 'DELETE' });
+      } catch (err) {
+        btn.disabled = false;
+        say('Could not delete passkey. ' + err.message, true);
+        return;
+      }
+      state.passkeys = state.passkeys.filter((x) => x.id !== p.id);
+      render();
+      say('Passkey deleted.');
+      // Tell the authenticator this credential is gone, then reconcile the full list.
+      await signals.removed(p.id);
+      signals.accepted();
+    }
+
+    $('add-btn').addEventListener('click', async () => {
+      const btn = $('add-btn');
+      if (!window.PublicKeyCredential) return say('This browser does not support passkeys.', true);
+      btn.disabled = true;
+      try {
+        // Server returns standard WebAuthn creation options (base64url-encoded binary fields).
+        const opts = await api('/register-options', { method: 'POST' });
+        const b64 = (s) => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
+        const options = PublicKeyCredential.parseCreationOptionsFromJSON
+          ? PublicKeyCredential.parseCreationOptionsFromJSON(opts)
+          : { ...opts, challenge: b64(opts.challenge), user: { ...opts.user, id: b64(opts.user.id) },
+              excludeCredentials: (opts.excludeCredentials || []).map((c) => ({ ...c, id: b64(c.id) })) };
+        const cred = await navigator.credentials.create({ publicKey: options });
+        await api('/register', { method: 'POST', body: JSON.stringify(cred.toJSON()) });
+        await load();
+        say('Passkey added.');
+      } catch (err) {
+        if (err.name !== 'NotAllowedError') say('Could not add passkey. ' + err.message, true);
+      } finally {
+        btn.disabled = false;
+      }
+    });
+
+    async function load() {
+      const data = await api('');
+      state = { rpId: data.rpId || location.hostname, user: data.user, passkeys: data.passkeys || [] };
+      render();
+      signals.accepted(); // prune passkeys the server no longer knows about on this authenticator
+    }
+
+    load().catch((err) => {
+      loadingEl.hidden = true;
+      say('Could not load your passkeys. ' + err.message, true);
+    });
+  </script>
+</body>
+
+</html>
