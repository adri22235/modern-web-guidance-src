+    #passkey-list { list-style: none; }
+
+    .passkey {
+      display: grid;
+      grid-template-columns: auto 1fr auto;
+      gap: 12px 16px;
+      align-items: center;
+      padding: 14px 0;
+      border-top: 1px solid var(--secondary);
+    }
+
+    .passkey img, .passkey .icon-fallback {
+      width: 40px;
+      height: 40px;
+      border-radius: 6px;
+    }
+
+    .icon-fallback {
+      display: grid;
+      place-items: center;
+      background: var(--secondary);
+      font-size: 1.25rem;
+    }
+
+    .passkey-name { font-weight: 600; overflow-wrap: anywhere; }
+    .passkey-meta { font-size: 0.85rem; color: #6d4c41; }
+    .passkey-actions { display: flex; gap: 8px; flex-wrap: wrap; }
+
+    @media (max-width: 560px) {
+      .passkey { grid-template-columns: auto 1fr; }
+      .passkey-actions { grid-column: 1 / -1; }
