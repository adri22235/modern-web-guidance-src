+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <h1>My Account</h1>
+    <p class="lede">Manage how you sign in to The Daily Grind.</p>
+
+    <section class="panel" aria-labelledby="passkeys-heading">
+      <div class="panel-header">
+        <h2 id="passkeys-heading">Passkeys</h2>
+        <button type="button" id="create-passkey" class="primary" hidden>Create passkey</button>
+      </div>
+      <p>Passkeys let you sign in with your fingerprint, face, or screen lock. Remove any you no longer use.</p>
+      <ul id="passkey-list" aria-busy="true"></ul>
+      <p id="passkey-status" class="status" role="status"></p>
+    </section>
+
+    <section class="panel" aria-labelledby="profile-heading">
+      <h2 id="profile-heading">Account name</h2>
+      <p>Shown by your password manager next to your passkeys.</p>
+      <form id="profile-form">
+        <div class="field">
+          <label for="user-name">Username</label>
+          <input type="text" id="user-name" name="name" autocomplete="username" required>
+        </div>
+        <div class="field">
+          <label for="user-display-name">Display name</label>
+          <input type="text" id="user-display-name" name="displayName" autocomplete="name" required>
+        </div>
+        <button type="submit" class="primary">Save</button>
+        <p id="profile-status" class="status" role="status"></p>
+      </form>
+    </section>
+  </main>
+
+  <dialog id="rename-dialog" aria-labelledby="rename-title">
+    <form method="dialog" id="rename-form">
+      <h2 id="rename-title">Rename passkey</h2>
+      <div class="field">
+        <label for="rename-input">Passkey name</label>
+        <input type="text" id="rename-input" maxlength="64" required>
+      </div>
+      <div class="dialog-actions">
+        <button type="button" value="cancel" data-cancel>Cancel</button>
+        <button type="submit" class="primary">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="delete-dialog" aria-labelledby="delete-title">
+    <form method="dialog" id="delete-form">
+      <h2 id="delete-title">Delete passkey?</h2>
+      <p id="delete-message"></p>
+      <div class="dialog-actions">
+        <button type="button" data-cancel>Cancel</button>
+        <button type="submit" class="danger">Delete</button>
+      </div>
+    </form>
+  </dialog>
+
+  <footer>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script type="module" src="/account/passkeys.js"></script>
+</body>
+
+</html>
diff --git a/account/passkeys.js b/account/passkeys.js
new file mode 100644
index 0000000..622ba16
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,299 @@
+// Passkey management for the My Account page.
+// Expected backend (session-authenticated, JSON):
+//   GET    /api/credentials        -> { rpId, userId, user: { name, displayName }, credentials: [...] }
+//   PUT    /api/credential/:id     { name }
+//   DELETE /api/credential/:id
+//   PUT    /api/user               { name, displayName } -> { rpId, userId, name, displayName }
+//   POST   /api/passkeys/register/options -> PublicKeyCredentialCreationOptionsJSON
+//   POST   /api/passkeys/register/verify  <- RegistrationResponseJSON
+// Credential: { id (unpadded base64url), name, aaguid, providerIcon, registeredAt, lastUsedAt } (epoch ms)
+
+const AAGUID_REGISTRY =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+const $ = (id) => document.getElementById(id);
+const list = $('passkey-list');
+const status = $('passkey-status');
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+let state = { rpId: '', userId: '', credentials: [] };
+let registryPromise;
+
+const api = (path, options = {}) =>
+  fetch(path, {
+    credentials: 'same-origin',
+    ...options,
+    headers: { 'Content-Type': 'application/json', ...options.headers },
+    body: options.body && JSON.stringify(options.body),
+  });
+
+function setStatus(el, message, isError = false) {
+  el.textContent = message;
+  el.classList.toggle('error', isError);
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, length % 4 !== 1
+const isValidBase64Url = (v) =>
+  typeof v === 'string' && v.length > 0 && v.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(v);
+
+// ---- AAGUID provider lookup (UX hint only) ----
+function loadRegistry() {
+  registryPromise ??= fetch(AAGUID_REGISTRY)
+    .then((r) => (r.ok ? r.json() : {}))
+    .catch(() => ({}));
+  return registryPromise;
+}
+
+async function providerFor(cred) {
+  if (!cred.aaguid || cred.aaguid === ZERO_AAGUID) return {};
+  if (cred.providerIcon && cred.name) return { icon: cred.providerIcon, name: cred.name };
+  const provider = (await loadRegistry())[cred.aaguid];
+  return { icon: provider?.icon_light, name: provider?.name };
+}
+
+// ---- Signal API sync (progressive enhancement; Chrome/Edge/Safari) ----
+async function syncAcceptedCredentials() {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  const { rpId, userId, credentials } = state;
+  const ids = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !ids.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid Base64URL IDs are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // server-provided, never location.hostname
+      userId,
+      allAcceptedCredentialIds: ids,
+    });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function syncUserDetails({ rpId, userId, name, displayName }) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+// ---- Rendering ----
+async function renderRow(cred) {
+  const { icon, name: providerName } = await providerFor(cred);
+  const displayName = cred.customName ?? cred.name ?? providerName ?? 'Unknown passkey provider';
+
+  const li = document.createElement('li');
+  li.className = 'passkey';
+  li.dataset.id = cred.id;
+
+  let iconEl;
+  if (icon) {
+    iconEl = document.createElement('img');
+    iconEl.src = icon;
+    iconEl.alt = '';
+  } else {
+    iconEl = document.createElement('span');
+    iconEl.className = 'icon-fallback';
+    iconEl.textContent = '🔑';
+    iconEl.setAttribute('aria-hidden', 'true');
+  }
+
+  const info = document.createElement('div');
+  const title = document.createElement('div');
+  title.className = 'passkey-name';
+  title.textContent = displayName;
+  const meta = document.createElement('div');
+  meta.className = 'passkey-meta';
+  const created = cred.registeredAt ? `Created ${dateFormat.format(cred.registeredAt)}` : '';
+  const used = cred.lastUsedAt ? `Last used ${dateFormat.format(cred.lastUsedAt)}` : 'Never used';
+  meta.textContent = [created, used].filter(Boolean).join(' · ');
+  info.append(title, meta);
+
+  const actions = document.createElement('div');
+  actions.className = 'passkey-actions';
+  const rename = document.createElement('button');
+  rename.type = 'button';
+  rename.textContent = 'Rename';
+  rename.setAttribute('aria-label', `Rename passkey ${displayName}`);
+  rename.addEventListener('click', () => openRename(cred, displayName, rename));
+  const del = document.createElement('button');
+  del.type = 'button';
+  del.className = 'danger';
+  del.textContent = 'Delete';
+  del.setAttribute('aria-label', `Delete passkey ${displayName}`);
+  del.addEventListener('click', () => openDelete(cred, displayName, del));
+  actions.append(rename, del);
+
+  li.append(iconEl, info, actions);
+  return li;
+}
+
+async function render() {
+  list.setAttribute('aria-busy', 'true');
+  if (!state.credentials.length) {
+    const empty = document.createElement('li');
+    empty.textContent = 'No passkeys found.';
+    list.replaceChildren(empty);
+  } else {
+    list.replaceChildren(...(await Promise.all(state.credentials.map(renderRow))));
+  }
+  list.removeAttribute('aria-busy');
+}
+
+async function load() {
+  const res = await api('/api/credentials');
+  if (res.status === 401) {
+    location.assign('/login?next=/account');
+    return null;
+  }
+  if (!res.ok) throw new Error(`Failed to load passkeys (${res.status})`);
+  const data = await res.json();
+  state = { rpId: data.rpId, userId: data.userId, credentials: data.credentials ?? [] };
+  await render();
+  return data;
+}
+
+// ---- Dialogs ----
+let renameTarget = null;
+let deleteTarget = null;
+const renameDialog = $('rename-dialog');
+const deleteDialog = $('delete-dialog');
+let dialogOpener = null;
+
+for (const dialog of [renameDialog, deleteDialog]) {
+  dialog.querySelector('[data-cancel]').addEventListener('click', () => dialog.close());
+  dialog.addEventListener('close', () => dialogOpener?.isConnected && dialogOpener.focus());
+}
+
+function openRename(cred, currentName, opener) {
+  renameTarget = cred;
+  dialogOpener = opener;
+  $('rename-input').value = currentName;
+  renameDialog.showModal();
+  $('rename-input').select();
+}
+
+function openDelete(cred, currentName, opener) {
+  deleteTarget = cred;
+  dialogOpener = opener;
+  $('delete-message').textContent =
+    `“${currentName}” will no longer work for signing in. You can't undo this.`;
+  deleteDialog.showModal();
+}
+
+$('rename-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const name = $('rename-input').value.trim();
+  if (!name || !renameTarget) return;
+  const target = renameTarget;
+  renameDialog.close();
+  try {
+    const res = await api(`/api/credential/${encodeURIComponent(target.id)}`, { method: 'PUT', body: { name } });
+    if (!res.ok) throw new Error();
+    // Nickname is a server-side label only; no Signal API call needed.
+    await load();
+    setStatus(status, 'Passkey renamed.');
+  } catch {
+    setStatus(status, 'Could not rename the passkey. Please try again.', true);
+  }
+});
+
+$('delete-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  if (!deleteTarget) return;
+  const target = deleteTarget;
+  deleteDialog.close();
+  try {
+    const res = await api(`/api/credential/${encodeURIComponent(target.id)}`, { method: 'DELETE' });
+    if (!res.ok) throw new Error();
+    await load();
+    await syncAcceptedCredentials();
+    setStatus(status, 'Passkey deleted.');
+  } catch {
+    setStatus(status, 'Could not delete the passkey. Please try again.', true);
+  }
+});
+
+// ---- Account name ----
+$('profile-form').addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const form = e.currentTarget;
+  const profileStatus = $('profile-status');
+  const name = $('user-name').value.trim();
+  const displayName = $('user-display-name').value.trim();
+  try {
+    const res = await api('/api/user', { method: 'PUT', body: { name, displayName } });
+    if (!res.ok) throw new Error();
+    const updated = await res.json();
+    await syncUserDetails({
+      rpId: updated.rpId,
+      userId: updated.userId,
+      name: updated.name ?? name,
+      displayName: updated.displayName ?? displayName,
+    });
+    setStatus(profileStatus, 'Account name saved.');
+  } catch {
+    setStatus(profileStatus, 'Could not save your account name. Please try again.', true);
+  }
+  form.querySelector('button[type="submit"]').disabled = false;
+});
+
+// ---- Create passkey ----
+async function isPasskeySupported() {
+  if (!window.PublicKeyCredential?.getClientCapabilities) return false;
+  try {
+    return Boolean((await PublicKeyCredential.getClientCapabilities()).passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+const createButton = $('create-passkey');
+createButton.addEventListener('click', async () => {
+  createButton.disabled = true;
+  try {
+    const optionsRes = await api('/api/passkeys/register/options', { method: 'POST' });
+    if (!optionsRes.ok) throw new Error();
+    const options = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsRes.json());
+    // authenticatorAttachment is left to the server options so security keys can be registered too.
+    const credential = await navigator.credentials.create({ publicKey: options });
+    const verifyRes = await api('/api/passkeys/register/verify', { method: 'POST', body: credential.toJSON() });
+    if (!verifyRes.ok) throw new Error();
+    await load();
+    await syncAcceptedCredentials();
+    setStatus(status, 'Passkey created.');
+  } catch (e) {
+    if (e?.name === 'NotAllowedError') setStatus(status, 'Passkey creation was cancelled.');
+    else setStatus(status, 'Could not create a passkey. Please try again.', true);
+  } finally {
+    createButton.disabled = false;
+  }
+});
+
+// ---- Init ----
+async function init() {
+  try {
+    const data = await load();
+    if (!data) return;
+    if (data.user) {
+      $('user-name').value = data.user.name ?? '';
+      $('user-display-name').value = data.user.displayName ?? '';
+    }
+    await syncAcceptedCredentials();
+  } catch {
+    list.removeAttribute('aria-busy');
+    list.replaceChildren();
+    setStatus(status, 'We couldn’t load your passkeys. Please refresh the page.', true);
+  }
+  if (await isPasskeySupported()) createButton.hidden = false;
+}
+
+init();
