@@ -0,0 +1,42 @@
+import type { AstroSession } from 'astro';
+import { createHash } from 'node:crypto';
+
+export interface AccountUser {
+  name: string;
+  displayName: string;
+  passkeyUserId: string; // unpadded Base64URL
+}
+
+export interface StoredPasskey {
+  id: string; // unpadded Base64URL credential ID
+  name: string;
+  aaguid?: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+
+// Must match the rp.id used when passkeys are registered.
+export const getRpId = (url: URL) => import.meta.env.PASSKEY_RP_ID || url.hostname;
+
+export const createAccountUser = (username: string): AccountUser => ({
+  name: username,
+  displayName: username,
+  // Opaque, stable user handle that doesn't expose the username.
+  passkeyUserId: createHash('sha256').update(`user:${username}`).digest('base64url'),
+});
+
+export const getUser = async (session?: AstroSession) =>
+  (await session?.get('user')) as AccountUser | undefined;
+
+export const getPasskeys = async (session?: AstroSession) =>
+  ((await session?.get('passkeys')) as StoredPasskey[] | undefined) ?? [];
+
+export const cleanLabel = (value: unknown, max = 60) =>
+  typeof value === 'string' ? value.trim().slice(0, max) : '';
