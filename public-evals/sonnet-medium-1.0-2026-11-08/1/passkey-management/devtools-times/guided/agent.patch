+import type { APIRoute } from 'astro';
+import { cleanLabel, getPasskeys, getUser, json } from '../../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  if (!(await getUser(session))) return json({ error: 'Not signed in' }, 401);
+
+  const body = await request.json().catch(() => ({}));
+  const name = cleanLabel(body.name);
+  if (!name) return json({ error: 'Name is required' }, 400);
+
+  const passkeys = await getPasskeys(session);
+  const passkey = passkeys.find((p) => p.id === params.id);
+  if (!passkey) return json({ error: 'Credential not found.' }, 404);
+
+  passkey.name = name;
+  await session?.set('passkeys', passkeys);
+  return json(passkey);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  if (!(await getUser(session))) return json({ error: 'Not signed in' }, 401);
+
+  const passkeys = await getPasskeys(session);
+  if (!passkeys.some((p) => p.id === params.id)) {
+    return json({ error: 'Credential not found.' }, 404);
+  }
+  await session?.set('passkeys', passkeys.filter((p) => p.id !== params.id));
+  return json({ success: true });
+};
