+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,224 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+
+interface Passkey {
+  id: string;
+  name: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+interface PasskeyList {
+  rpId: string;
+  userId: string;
+  user: { name: string; displayName: string };
+  credentials: Passkey[];
+}
+
+const API = `${import.meta.env.BASE_URL}api`;
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, length % 4 !== 1
+const isBase64Url = (v: unknown): v is string =>
+  typeof v === 'string' && v.length > 0 && v.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(v);
+
+const formatDate = (ms?: number) =>
+  ms ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(ms) : null;
+
+// Tell the browser/password manager which credentials the server still accepts.
+async function syncAcceptedCredentials({ rpId, userId, credentials }: PasskeyList) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  const ids = credentials.map((c) => c.id);
+  if (!rpId || !isBase64Url(userId) || !ids.every(isBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId,
+      allAcceptedCredentialIds: ids,
+    });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function syncUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  if (!window.PublicKeyCredential?.signalCurrentUserDetails) return;
+  if (!rpId || !isBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [draftName, setDraftName] = useState('');
+  const [confirmId, setConfirmId] = useState<string | null>(null);
+  const [username, setUsername] = useState('');
+  const [displayName, setDisplayName] = useState('');
+
+  const load = useCallback(async () => {
+    const res = await fetch(`${API}/passkeys`);
+    if (!res.ok) throw new Error('Could not load your passkeys.');
+    const next: PasskeyList = await res.json();
+    setData(next);
+    return next;
+  }, []);
+
+  useEffect(() => {
+    load()
+      .then((next) => {
+        setUsername(next.user.name);
+        setDisplayName(next.user.displayName);
+        return syncAcceptedCredentials(next);
+      })
+      .catch((e) => setError(e.message));
+  }, [load]);
+
+  const run = async (task: () => Promise<void>, message: string) => {
+    setError(null);
+    setStatus(null);
+    try {
+      await task();
+      setStatus(message);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Something went wrong.');
+    }
+  };
+
+  const rename = (e: React.FormEvent) => {
+    e.preventDefault();
+    const id = editingId!;
+    return run(async () => {
+      const res = await fetch(`${API}/passkeys/${encodeURIComponent(id)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: draftName }),
+      });
+      if (!res.ok) throw new Error('Could not rename this passkey.');
+      setEditingId(null);
+      await load(); // Nickname is server-side only; no Signal API call needed.
+    }, 'Passkey renamed.');
+  };
+
+  const remove = (id: string) =>
+    run(async () => {
+      const res = await fetch(`${API}/passkeys/${encodeURIComponent(id)}`, { method: 'DELETE' });
+      if (!res.ok) throw new Error('Could not remove this passkey.');
+      setConfirmId(null);
+      await syncAcceptedCredentials(await load());
+    }, 'Passkey removed.');
+
+  const saveProfile = (e: React.FormEvent) => {
+    e.preventDefault();
+    return run(async () => {
+      const res = await fetch(`${API}/account`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: username, displayName }),
+      });
+      if (!res.ok) throw new Error('Could not update your account details.');
+      const updated = await res.json();
+      await load();
+      await syncUserDetails(updated.rpId, updated.userId, updated.name, updated.displayName);
+    }, 'Account details updated.');
+  };
+
+  const inputClass =
+    'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+  const buttonClass =
+    'px-3 py-1.5 text-sm font-medium border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="max-w-2xl mx-auto space-y-8">
+      <h1 className="text-2xl font-bold text-gray-800">Account settings</h1>
+
+      <div aria-live="polite">
+        {error && (
+          <p className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</p>
+        )}
+        {status && <p className="p-3 text-sm text-green-700 bg-green-100 rounded-lg">{status}</p>}
+      </div>
+
+      <form onSubmit={saveProfile} className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm space-y-4">
+        <h2 className="text-lg font-semibold text-gray-800">Account name</h2>
+        <p className="text-sm text-gray-600">
+          Shown by your password manager next to your passkeys.
+        </p>
+        <div>
+          <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">Username</label>
+          <input id="account-username" className={inputClass} value={username} onChange={(e) => setUsername(e.target.value)} required maxLength={60} autoComplete="username" />
+        </div>
+        <div>
+          <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">Display name</label>
+          <input id="account-display-name" className={inputClass} value={displayName} onChange={(e) => setDisplayName(e.target.value)} required maxLength={60} autoComplete="name" />
+        </div>
+        <button type="submit" className="px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800">Save</button>
+      </form>
+
+      <div className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="passkeys-heading" className="text-lg font-semibold text-gray-800 mb-4">Passkeys</h2>
+        {!data ? (
+          !error && <p className="text-sm text-gray-600">Loading…</p>
+        ) : data.credentials.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {data.credentials.map((c) => (
+              <li key={c.id} className="py-4 flex flex-wrap items-center gap-3">
+                {c.providerIcon ? (
+                  <img src={c.providerIcon} alt="" width={32} height={32} className="w-8 h-8" />
+                ) : (
+                  <KeyIcon className="w-8 h-8 text-gray-500" aria-hidden="true" />
+                )}
+                <div className="flex-1 min-w-0">
+                  {editingId === c.id ? (
+                    <form onSubmit={rename} className="flex gap-2">
+                      <label className="sr-only" htmlFor={`rename-${c.id}`}>Passkey name</label>
+                      <input id={`rename-${c.id}`} className={inputClass} value={draftName} onChange={(e) => setDraftName(e.target.value)} required maxLength={60} autoFocus />
+                      <button type="submit" className={buttonClass}>Save</button>
+                      <button type="button" className={buttonClass} onClick={() => setEditingId(null)}>Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-900 truncate">{c.name}</p>
+                      <p className="text-xs text-gray-500">
+                        Added {formatDate(c.registeredAt)}
+                        {c.lastUsedAt ? ` · Last used ${formatDate(c.lastUsedAt)}` : ''}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {editingId !== c.id && (
+                  <div className="flex gap-2">
+                    {confirmId === c.id ? (
+                      <>
+                        <button type="button" className={`${buttonClass} text-red-700`} onClick={() => remove(c.id)}>Confirm remove</button>
+                        <button type="button" className={buttonClass} onClick={() => setConfirmId(null)}>Cancel</button>
+                      </>
+                    ) : (
+                      <>
+                        <button type="button" className={buttonClass} aria-label={`Rename ${c.name}`} onClick={() => { setEditingId(c.id); setDraftName(c.name); setConfirmId(null); }}>Rename</button>
+                        <button type="button" className={buttonClass} aria-label={`Remove ${c.name}`} onClick={() => setConfirmId(c.id)}>Remove</button>
+                      </>
+                    )}
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </section>
+  );
+}
