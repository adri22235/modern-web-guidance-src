+import type { APIRoute } from 'astro';
+import { getPasskeys, getRpId, getUser, json } from '../../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  return json({
+    rpId: getRpId(url),
+    userId: user.passkeyUserId,
+    user: { name: user.name, displayName: user.displayName },
+    credentials: await getPasskeys(session),
+  });
+};
