+import type { APIRoute } from 'astro';
+import { cleanLabel, getRpId, getUser, json } from '../../utils/passkeys';
+
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  const body = await request.json().catch(() => ({}));
+  const name = cleanLabel(body.name);
+  const displayName = cleanLabel(body.displayName);
+  if (!name || !displayName) return json({ error: 'Name and display name are required' }, 400);
+
+  const updated = { ...user, name, displayName };
+  await session?.set('user', updated);
+  return json({ name, displayName, rpId: getRpId(url), userId: updated.passkeyUserId });
+};
