+import type { APIRoute } from 'astro';
+import { createAccountUser, json } from '../../utils/passkeys';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Proxies the login so the session is only established after the upstream accepts the credentials.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  const upstream = await fetch(LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) return json(data, upstream.status);
+
+  const existing = (await session?.get('user')) as { name: string } | undefined;
+  if (existing?.name !== username) {
+    await session?.set('user', createAccountUser(username));
+    await session?.set('passkeys', []);
+  }
+  return json(data);
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  session?.destroy();
+  return json({ success: true });
+};
