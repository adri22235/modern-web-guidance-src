+
+  <script>
+    // Customer reviews: feedback is untrusted rich HTML. It is parsed with DOMParser
+    // (inert document: no scripts run, no resources load), then rebuilt node-by-node
+    // from an allowlist of tags/attributes before being inserted into the page.
+    (function () {
+      var ALLOWED_TAGS = {
+        B: 1, STRONG: 1, I: 1, EM: 1, U: 1, S: 1, BR: 1, P: 1, UL: 1, OL: 1, LI: 1,
+        BLOCKQUOTE: 1, CODE: 1, SPAN: 1, A: 1, IMG: 1, H4: 1, H5: 1, H6: 1
+      };
+      var ALLOWED_ATTRS = {
+        A: ['href', 'title'],
+        IMG: ['src', 'alt', 'title', 'width', 'height']
+      };
+      var DROP_WITH_CONTENT = { SCRIPT: 1, STYLE: 1, IFRAME: 1, OBJECT: 1, EMBED: 1, TEMPLATE: 1,
+        NOSCRIPT: 1, SVG: 1, MATH: 1, FORM: 1, TEXTAREA: 1, SELECT: 1, TITLE: 1, HEAD: 1 };
+
+      function safeUrl(value, allowMailto) {
+        try {
+          var u = new URL(value.trim(), 'https://invalid.example/');
+          if (u.protocol === 'https:' || u.protocol === 'http:') return value.trim();
+          if (allowMailto && u.protocol === 'mailto:') return value.trim();
+        } catch (e) {}
+        return null;
+      }
+
+      function cleanNode(node, target) {
+        node.childNodes.forEach(function (child) {
+          if (child.nodeType === Node.TEXT_NODE) {
+            target.appendChild(document.createTextNode(child.nodeValue));
+            return;
+          }
+          if (child.nodeType !== Node.ELEMENT_NODE) return; // drop comments, PIs
+          var tag = child.tagName.toUpperCase();
+          if (DROP_WITH_CONTENT[tag]) return;
+          if (!ALLOWED_TAGS[tag]) { cleanNode(child, target); return; } // unwrap unknown tags
+          var el = document.createElement(tag.toLowerCase());
+          (ALLOWED_ATTRS[tag] || []).forEach(function (name) {
+            if (!child.hasAttribute(name)) return;
+            var v = child.getAttribute(name);
+            if (name === 'href') v = safeUrl(v, true);
+            else if (name === 'src') v = safeUrl(v, false);
+            if (v !== null) el.setAttribute(name, v);
+          });
+          if (tag === 'IMG' && !el.hasAttribute('src')) return;
+          if (tag === 'A') {
+            el.setAttribute('rel', 'noopener noreferrer nofollow');
+            el.setAttribute('target', '_blank');
+          }
+          if (tag === 'IMG') { el.setAttribute('loading', 'lazy'); el.setAttribute('referrerpolicy', 'no-referrer'); }
+          cleanNode(child, el);
+          target.appendChild(el);
+        });
+      }
+
+      function sanitize(html) {
+        var doc = new DOMParser().parseFromString(String(html), 'text/html');
+        var frag = document.createDocumentFragment();
+        cleanNode(doc.body, frag);
+        return frag;
+      }
+
+      var STORE = 'dailyGrindReviews';
+      function load() {
+        try { return JSON.parse(localStorage.getItem(STORE)) || {}; } catch (e) { return {}; }
+      }
+      function save(data) {
+        try { localStorage.setItem(STORE, JSON.stringify(data)); } catch (e) {}
+      }
+
+      var data = load();
+
+      document.querySelectorAll('.card .reviews').forEach(function (box) {
+        var drink = box.closest('.card').querySelector('h3').textContent.trim();
+        var h = document.createElement('h4');
+        h.textContent = 'Customer Reviews';
+        var list = document.createElement('ul');
+        list.className = 'review-list';
+        var form = document.createElement('form');
+        form.className = 'review-form';
+        form.innerHTML =
+          '<input type="text" name="author" placeholder="Your name" maxlength="60" required aria-label="Your name">' +
+          '<textarea name="body" rows="3" maxlength="2000" required aria-label="Your review" ' +
+          'placeholder="Share your thoughts (basic HTML like &lt;b&gt;, &lt;i&gt;, &lt;a&gt; allowed)"></textarea>' +
+          '<small>Unsafe markup is removed automatically.</small>' +
+          '<button type="submit" class="btn">Submit Review</button>';
+
+        function render() {
+          list.textContent = '';
+          (data[drink] || []).forEach(function (r) {
+            var li = document.createElement('li');
+            var who = document.createElement('span');
+            who.className = 'review-author';
+            who.textContent = r.author;
+            li.appendChild(who);
+            li.appendChild(sanitize(r.body));
+            list.appendChild(li);
+          });
+        }
+
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var author = form.author.value.trim();
+          var body = form.body.value.trim();
+          if (!author || !body) return;
+          (data[drink] = data[drink] || []).push({ author: author, body: body });
+          save(data);
+          form.reset();
+          render();
+        });
+
+        box.append(h, list, form);
+        render();
+      });
+    })();
+  </script>
 </body>
 
