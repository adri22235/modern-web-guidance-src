+  <script type="module">
+    // Reviews are untrusted HTML: sanitized at render time, never via raw innerHTML.
+    const sanitizerConfig = {
+      elements: ['p', 'b', 'strong', 'i', 'em', 'u', 'br', 'ul', 'ol', 'li', 'blockquote', 'a', 'span'],
+      attributes: ['href']
+    };
+    const dompurifyUrl = 'https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.es.mjs';
+    let domPurifyPromise;
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: sanitizerConfig });
+        return;
+      }
+      // Fallback for browsers without the Sanitizer API (e.g. Safari), loaded only when needed
+      domPurifyPromise ??= import(dompurifyUrl).then((m) => m.default ?? m);
+      const DOMPurify = await domPurifyPromise;
+      el.innerHTML = DOMPurify.sanitize(html, {
+        ALLOWED_TAGS: [...sanitizerConfig.elements, '#text'],
+        ALLOWED_ATTR: sanitizerConfig.attributes,
+        ALLOW_ARIA_ATTR: false,
+        ALLOW_DATA_ATTR: false,
+        KEEP_CONTENT: false
+      });
+    }
+
+    const storageKey = (drink) => `reviews:${drink}`;
+    const load = (drink) => {
+      try { return JSON.parse(localStorage.getItem(storageKey(drink))) ?? []; }
+      catch { return []; }
+    };
+
+    async function render(section) {
+      const list = section.querySelector('.review-list');
+      const reviews = load(section.dataset.drink);
+      list.replaceChildren();
+      if (!reviews.length) {
+        const empty = document.createElement('li');
+        empty.className = 'review-empty';
+        empty.textContent = 'No reviews yet. Be the first!';
+        list.append(empty);
+        return;
+      }
+      for (const html of reviews) {
+        const li = document.createElement('li');
+        list.append(li);
+        await safeSetHTML(li, html);
+      }
+    }
+
+    for (const section of document.querySelectorAll('.reviews')) {
+      render(section);
+      section.querySelector('form').addEventListener('submit', (e) => {
+        e.preventDefault();
+        const textarea = e.currentTarget.elements.review;
+        const html = textarea.value.trim();
+        if (!html) return;
+        const drink = section.dataset.drink;
+        try {
+          localStorage.setItem(storageKey(drink), JSON.stringify([...load(drink), html]));
+        } catch { /* storage unavailable; review is not persisted */ }
+        textarea.value = '';
+        render(section);
+      });
+    }
+  </script>
