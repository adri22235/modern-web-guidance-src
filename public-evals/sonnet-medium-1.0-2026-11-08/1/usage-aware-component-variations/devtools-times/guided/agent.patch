diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..539973b 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,71 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+/* Usage-aware teaser variations: sections declare --surface, teasers react to it. */
+.surface-featured {
+  --surface: featured;
+}
+
+.teaser-badge {
+  display: none;
+  width: fit-content;
+  margin-bottom: 0.5rem;
+  padding: 0.125rem 0.5rem;
+  border-radius: 9999px;
+  background: var(--color-amber-400);
+  color: var(--color-gray-900);
+  font-size: 0.75rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.teaser-button {
+  display: inline-block;
+  width: fit-content;
+  margin-top: 0.75rem;
+  padding: 0.375rem 1rem;
+  border: 1px solid currentColor;
+  border-radius: 0.25rem;
+  background: transparent;
+  color: var(--color-gray-700);
+  font-size: 0.875rem;
+  font-weight: 600;
+  transition: background-color 0.15s, color 0.15s;
+}
+
+.teaser-button:hover {
+  background: var(--color-gray-100);
+}
+
+/* Fallback for browsers without style queries; :where() keeps specificity equal so the query wins. */
+:where(.surface-featured) .teaser-badge {
+  display: block;
+}
+
+:where(.surface-featured) .teaser-button {
+  border-color: transparent;
+  background: var(--color-amber-400);
+  color: var(--color-gray-900);
+}
+
+:where(.surface-featured) .teaser-button:hover {
+  background: var(--color-amber-500);
+}
+
+@container style(--surface: featured) {
+  .teaser-badge {
+    display: block;
+  }
+
+  .teaser-button {
+    border-color: transparent;
+    background: var(--color-amber-400);
+    color: var(--color-gray-900);
+  }
+
+  .teaser-button:hover {
+    background: var(--color-amber-500);
+  }
+}
