new file mode 100644
index 0000000..2108adf
--- /dev/null
+++ b/src/components/TeaserAction.astro
@@ -0,0 +1,20 @@
+---
+// Badge + "Read more" button whose look depends on the nearest ancestor
+// marked with `group/section` and (optionally) `data-featured`.
+export interface Props {
+    href: string;
+}
+
+const { href } = Astro.props;
+---
+<div class="flex items-center gap-3 mt-3">
+    <span class="hidden group-data-[featured]/section:inline-flex items-center rounded-full bg-amber-400 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-gray-900">
+        Featured
+    </span>
+    <a
+        href={href}
+        class="inline-flex items-center rounded-md border-2 border-gray-900 px-3 py-1.5 text-sm font-semibold text-gray-900 transition-colors hover:bg-gray-900 hover:text-white group-data-[featured]/section:border-amber-400 group-data-[featured]/section:bg-amber-400 group-data-[featured]/section:hover:border-amber-500 group-data-[featured]/section:hover:bg-amber-500 group-data-[featured]/section:hover:text-gray-900"
+    >
+        Read more
+    </a>
+</div>
