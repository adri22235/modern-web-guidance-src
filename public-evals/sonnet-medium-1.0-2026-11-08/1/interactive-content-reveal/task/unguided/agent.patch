@@ -134,8 +134,80 @@
     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Spotlight reveal on seasonal favorites */
+    @property --inner-size { syntax: '<length>'; inherits: true; initial-value: 0px; }
+    @property --outer-size { syntax: '<length>'; inherits: true; initial-value: 0px; }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      transition: --inner-size 0.35s ease, --outer-size 0.35s ease, box-shadow 0.3s;
+    }
+
+    /* soft glow that follows the pointer, sits behind the content */
+    .product-card::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+      background: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+        rgba(255, 171, 64, 0.28) var(--inner-size), transparent var(--outer-size));
+    }
+
+    .product-card > * {
+      position: relative;
+    }
+
+    .product-details {
+      font-size: 0.85rem;
+      font-style: italic;
+      color: #6d4c41;
+      margin-top: 8px;
+    }
+
+    /* highlighted copy of the details, only visible inside the spotlight */
+    .product-details {
+      position: relative;
+    }
+
+    .product-details::after {
+      content: attr(data-extra);
+      content: attr(data-extra) / "";
+      position: absolute;
+      inset: -4px -6px;
+      padding: 4px 6px;
+      border-radius: 4px;
+      background: var(--primary);
+      color: var(--accent);
+      font-weight: 600;
+      font-style: normal;
+      pointer-events: none;
+      -webkit-mask-image: radial-gradient(circle at var(--spot-x, 0) var(--spot-y, 0),
+        #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--spot-x, 0) var(--spot-y, 0),
+        #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    .product-card:hover,
+    .product-card:focus-within {
+      --inner-size: 90px;
+      --outer-size: 160px;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition: none;
+      }
+    }
+
