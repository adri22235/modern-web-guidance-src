+<script>
+    const form = document.getElementById('subscription-form');
+    const bar = document.getElementById('setup-progress');
+    const barText = document.getElementById('progress-text');
+    const roast = document.getElementById('roast');
+    const roastText = document.getElementById('roast-text');
+    const status = document.getElementById('subscribe-status');
+    const roastNames = ['Light', 'Light-medium', 'Medium', 'Medium-dark', 'Dark'];
+    // The slider and checkbox have defaults, so they count once the user touches them
+    const touched = { roast: false, emails: false };
+
+    function updateProgress() {
+      const done = [
+        form.elements.name.value.trim() !== '',
+        form.frequency.value !== '',
+        touched.roast,
+        touched.emails
+      ].filter(Boolean).length;
+      const pct = done * 25;
+      bar.value = pct;
+      bar.textContent = pct + '%';
+      barText.textContent = pct + '%';
+    }
+
+    roast.addEventListener('input', () => {
+      touched.roast = true;
+      roastText.textContent = roastNames[roast.value - 1];
+    });
+    form.emails.addEventListener('change', () => { touched.emails = true; });
+    form.addEventListener('input', updateProgress);
+    form.addEventListener('change', updateProgress);
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      status.textContent = bar.value < 100
+        ? 'Please finish every step to start your subscription.'
+        : 'Thanks, ' + form.elements.name.value.trim() + '! Your ' + roastNames[roast.value - 1].toLowerCase() +
+          ' roast will arrive ' + form.frequency.value.replace('biweekly', 'every two weeks') + '.';
+    });
+  </script>
