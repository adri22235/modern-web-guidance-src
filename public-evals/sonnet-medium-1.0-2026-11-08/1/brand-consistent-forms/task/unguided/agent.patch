+  <script>
+    (function () {
+      var form = document.getElementById('subscription-form');
+      var roast = document.getElementById('roast');
+      var roastValue = document.getElementById('roast-value');
+      var bar = document.getElementById('sub-progress');
+      var text = document.getElementById('progress-text');
+      var email = document.getElementById('email-optin');
+      var names = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      var roastTouched = false;
+      var emailTouched = false;
+
+      function mark(id, done) {
+        var el = document.getElementById(id);
+        el.textContent = (done ? '● ' : '○ ') + el.textContent.slice(2);
+      }
+
+      function update() {
+        var name = names[roast.value - 1];
+        roastValue.textContent = name;
+        roast.setAttribute('aria-valuetext', name);
+
+        var steps = [
+          !!form.querySelector('input[name="frequency"]:checked'),
+          roastTouched,
+          emailTouched
+        ];
+        var pct = Math.round(steps.filter(Boolean).length / steps.length * 100);
+        bar.value = pct;
+        bar.textContent = pct + '%';
+        text.textContent = pct + '% complete';
+        mark('step-frequency', steps[0]);
+        mark('step-roast', steps[1]);
+        mark('step-email', steps[2]);
+      }
+
+      roast.addEventListener('input', function () { roastTouched = true; update(); });
+      email.addEventListener('change', function () { emailTouched = true; update(); });
+      form.addEventListener('change', update);
+      update();
+    })();
+  </script>
