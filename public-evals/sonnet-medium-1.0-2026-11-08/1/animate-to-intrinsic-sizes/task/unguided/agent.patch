+  <script>
+    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const DURATION = 350;
+
+    // Animate an element's height from its current value to `to` (px), then call done.
+    function animateHeight(el, to, done) {
+      el.getAnimations().forEach(a => a.cancel());
+      const from = el.getBoundingClientRect().height;
+      if (reduceMotion.matches || from === to) {
+        el.style.height = '';
+        return done();
+      }
+      el.style.height = from + 'px';
+      const anim = el.animate(
+        [{ height: from + 'px' }, { height: to + 'px' }],
+        { duration: DURATION, easing: 'ease', fill: 'forwards' }
+      );
+      anim.onfinish = () => {
+        anim.cancel();
+        done();
+      };
+      el.style.height = to + 'px';
+    }
+
+    // FAQ accordion
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+
+    faqTrigger.addEventListener('click', () => {
+      const open = faqTrigger.getAttribute('aria-expanded') === 'true';
+      faqTrigger.setAttribute('aria-expanded', String(!open));
+      if (open) {
+        animateHeight(faqContent, 0, () => {
+          faqContent.style.height = '0px';
+          faqContent.hidden = true;
+        });
+      } else {
+        const start = faqContent.getBoundingClientRect().height;
+        faqContent.hidden = false;
+        const natural = faqContent.scrollHeight;
+        faqContent.style.height = start + 'px';
+        animateHeight(faqContent, natural, () => {
+          faqContent.style.height = 'auto';
+        });
+      }
+    });
+
+    // Dismissible promo alert
+    const promo = document.getElementById('promo-alert');
+    document.getElementById('alert-dismiss').addEventListener('click', () => {
+      promo.style.height = promo.getBoundingClientRect().height + 'px';
+      animateHeight(promo, 0, () => promo.remove());
+    });
+  </script>
+
 </body>
 
