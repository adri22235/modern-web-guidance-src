+            if (!isSub(menu)) break;
+            e.preventDefault();
+            e.stopPropagation();
+            closeAndRestore(menu);
+            break;
+          case 'ArrowRight':
+            if (!isMenuTrigger(t)) break;
+            e.preventDefault();
+            enter(menuFor(t));
+            break;
+          case 'Home':
+            e.preventDefault();
+            items[0]?.focus();
+            break;
+          case 'End':
+            e.preventDefault();
+            items.at(-1)?.focus();
+            break;
+          case 'Tab': {
+            const root = rootOf(menu);
+            triggerOf(root).focus({ focusVisible: false });
+            root.hidePopover();
+            break;
+          }
+        }
+      });
+
+      document.addEventListener('click', e => {
+        const trigger = e.target.closest('[commandfor]');
+        if (trigger) {
+          const m = menuFor(trigger);
+          // Keyboard open of a top-level menu enters it
+          if (!trigger.closest('[focusgroup]') && e.detail === 0 && !isOpen(m)) enterOnOpen.add(m);
+          return;
+        }
+        const item = e.target.closest(ITEM);
+        if (!item) return;
+
+        const menu = item.closest('[focusgroup]').parentElement;
+        const root = rootOf(menu);
+        const fromPointer = e.detail !== 0;
+        const role = item.getAttribute('role');
+        let delay = 0;
+        let stayOpen = false;
+
+        if (role === 'menuitemcheckbox') {
+          const on = item.getAttribute('aria-checked') !== 'true';
+          item.setAttribute('aria-checked', on);
+          announce(`${item.dataset.option} ${on ? 'on' : 'off'}`);
+          delay = 300;
+          stayOpen = !fromPointer && lastKey === ' ';
+        } else if (role === 'menuitemradio') {
+          const group = item.closest('[role="group"]');
+          group.querySelectorAll('[role="menuitemradio"]').forEach(r => r.setAttribute('aria-checked', r === item));
+          announce(`${group.getAttribute('aria-label')}: ${item.dataset.option}`);
+          delay = 300;
+        } else if (item.dataset.message) {
+          const name = root.parentElement.closest('[data-item]')?.dataset.item ?? root.closest('[data-item]')?.dataset.item;
+          const opts = [...root.querySelectorAll('[aria-checked="true"]')].map(b => b.dataset.option);
+          announce(item.dataset.message + (name ? `: ${name}` : '') + (opts.length ? ` — ${opts.join(', ')}` : ''));
+        }
+
+        if (stayOpen) return;
+        setTimeout(() => { if (isOpen(root)) closeAndRestore(root, { fromPointer }); }, delay);
+      });
+    })();
+  </script>
+
