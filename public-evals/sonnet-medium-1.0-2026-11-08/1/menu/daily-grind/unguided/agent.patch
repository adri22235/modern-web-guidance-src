+  <script>
+    /* ---------- Reusable menu component ----------
+       Item shapes:
+         { label, href }                       link
+         { label, action() }                   action (closes menu)
+         { label, children: [...] }            nested submenu (any depth)
+         { label, checked(), toggle() }        on/off option (stays open)
+         { label, group, checked(), select() } pick-one option (stays open)
+         { heading } | { separator: true }     non-interactive */
+    function createMenu(trigger, items, { alignRight = false } = {}) {
+      const wrap = document.createElement('span');
+      wrap.className = 'menu-wrap';
+      trigger.replaceWith(wrap);
+      wrap.append(trigger);
+      trigger.setAttribute('aria-haspopup', 'true');
+      trigger.setAttribute('aria-expanded', 'false');
+
+      const refreshers = [];
+
+      function build(list, isRoot) {
+        const ul = document.createElement('ul');
+        ul.className = isRoot ? 'menu' : 'submenu';
+        if (isRoot && alignRight) ul.classList.add('align-right');
+        ul.setAttribute('role', 'menu');
+        if (!isRoot) ul.setAttribute('aria-label', list.label);
+
+        list.forEach(item => {
+          const li = document.createElement('li');
+          li.setAttribute('role', 'none');
+          if (item.separator) {
+            li.className = 'menu-sep';
+            li.setAttribute('role', 'separator');
+          } else if (item.heading) {
+            li.className = 'menu-heading';
+            li.setAttribute('role', 'presentation');
+            li.textContent = item.heading;
+          } else {
+            const el = document.createElement(item.href ? 'a' : 'button');
+            if (item.href) el.href = item.href; else el.type = 'button';
+            el.textContent = item.label;
+            el.tabIndex = -1;
+            el.setAttribute('role',
+              item.toggle ? 'menuitemcheckbox' : item.select ? 'menuitemradio' : 'menuitem');
+            li.append(el);
+
+            if (item.checked) {
+              const sync = () => el.setAttribute('aria-checked', String(!!item.checked()));
+              sync();
+              refreshers.push(sync);
+            }
+            if (item.children) {
+              const sub = build(item.children, false);
+              sub.setAttribute('aria-label', item.label);
+              el.setAttribute('aria-haspopup', 'true');
+              el.setAttribute('aria-expanded', 'false');
+              li.append(sub);
+              el.addEventListener('click', e => { e.preventDefault(); openSub(li, true); });
+              li.addEventListener('mouseenter', () => openSub(li));
+            } else {
+              li.addEventListener('mouseenter', () => closeSiblings(li));
+              el.addEventListener('click', () => {
+                if (item.toggle) item.toggle();
+                else if (item.select) item.select();
+                else if (item.action) item.action();
+                refreshers.forEach(f => f());
+                if (!item.toggle && !item.select) close(true);
+              });
+            }
+          }
+          ul.append(li);
+        });
+        return ul;
+      }
+
+      function closeSiblings(li) {
+        [...li.parentElement.children].forEach(sib => {
+          if (sib !== li && sib.classList.contains('open')) setOpen(sib, false);
+        });
+      }
+
+      function setOpen(li, open) {
+        li.classList.toggle('open', open);
+        li.firstElementChild.setAttribute('aria-expanded', String(open));
+        if (!open) li.querySelectorAll('li.open').forEach(x => setOpen(x, false));
+      }
+
+      function openSub(li, focusFirst) {
+        closeSiblings(li);
+        setOpen(li, true);
+        const sub = li.querySelector(':scope > .submenu');
+        sub.classList.remove('flip');
+        if (sub.getBoundingClientRect().right > window.innerWidth) sub.classList.add('flip');
+        if (focusFirst) itemsOf(sub)[0]?.focus();
+      }
+
+      const root = build(items, true);
+      wrap.append(root);
+
+      const itemsOf = ul => [...ul.children]
+        .map(li => li.firstElementChild)
+        .filter(el => el && el.matches('a, button'));
+
+      function open() {
+        root.classList.add('open');
+        trigger.setAttribute('aria-expanded', 'true');
+        refreshers.forEach(f => f());
+        const r = root.getBoundingClientRect();
+        if (r.right > window.innerWidth) root.classList.add('align-right');
+      }
+
+      function close(returnFocus) {
+        root.classList.remove('open');
+        root.querySelectorAll('li.open').forEach(li => setOpen(li, false));
+        trigger.setAttribute('aria-expanded', 'false');
+        if (returnFocus) trigger.focus();
+      }
+
+      trigger.addEventListener('click', () => {
+        root.classList.contains('open') ? close() : open();
+      });
+      trigger.addEventListener('keydown', e => {
+        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+          e.preventDefault();
+          if (!root.classList.contains('open')) open();
+          const list = itemsOf(root);
+          (e.key === 'ArrowDown' ? list[0] : list[list.length - 1]).focus();
+        }
+      });
+
+      root.addEventListener('keydown', e => {
+        const el = document.activeElement;
+        const ul = el.closest('ul');
+        const li = el.parentElement;
+        const list = itemsOf(ul);
+        const i = list.indexOf(el);
+        switch (e.key) {
+          case 'ArrowDown': list[(i + 1) % list.length].focus(); break;
+          case 'ArrowUp': list[(i - 1 + list.length) % list.length].focus(); break;
+          case 'Home': list[0].focus(); break;
+          case 'End': list[list.length - 1].focus(); break;
+          case 'ArrowRight':
+            if (el.getAttribute('aria-haspopup')) openSub(li, true); else return;
+            break;
+          case 'ArrowLeft':
+            if (ul !== root) { setOpen(ul.parentElement, false); ul.parentElement.firstElementChild.focus(); }
+            else return;
+            break;
+          case 'Escape': close(true); break;
+          case 'Tab': close(); return;
+          default: return;
+        }
+        e.preventDefault();
+      });
+
+      document.addEventListener('click', e => { if (!wrap.contains(e.target)) close(); });
+      return { open, close };
+    }
+
+    function makeTrigger(label, cls) {
+      const b = document.createElement('button');
+      b.type = 'button';
+      b.className = cls;
+      b.textContent = label;
+      document.body.append(b); // replaced into place by createMenu
+      return b;
+    }
+
+    /* ---------- Navigation ---------- */
+    const drink = (name, slug) => ({ label: name, href: '/menu/' + slug });
+    const navItems = [
+      {
+        label: 'Menu',
+        children: [
+          { label: 'Order Online', href: '/order-online' },
+          { separator: true },
+          { label: 'Coffee', children: [
+            { label: 'Espresso', children: [
+              drink('Espresso Shot', 'espresso'), drink('Americano', 'americano'),
+              drink('Cortado', 'cortado')] },
+            { label: 'Lattes', children: [
+              drink('Classic Latte', 'latte'), drink('Maple Oat Latte', 'seasonal'),
+              drink('Mocha', 'mocha')] },
+            { label: 'Cold Brew', children: [
+              drink('Original Cold Brew', 'cold-brew'), drink('Nitro Cold Brew', 'nitro')] },
+          ] },
+          { label: 'Tea', children: [
+            drink('Chai Latte', 'chai'), drink('Matcha Latte', 'matcha'),
+            { label: 'Loose Leaf', children: [
+              drink('Earl Grey', 'earl-grey'), drink('Green Jasmine', 'jasmine')] },
+          ] },
+          { label: 'Seasonal', children: [drink('All Seasonal Drinks', 'seasonal')] },
+          { label: 'Pastries & Bites', href: '/menu/food' },
+        ],
+      },
+      { label: 'Locations', href: '/locations' },
+      { label: 'Rewards', href: '/rewards' },
+      {
+        label: 'My Account',
+        children: [
+          { label: 'Profile', href: '/account' },
+          { label: 'Order History', href: '/account/orders' },
+          { label: 'Payment Methods', href: '/account/payment' },
+        ],
+      },
+      { label: 'Logout', href: '/logout', cls: 'logout-link' },
+    ];
+
+    const navList = document.getElementById('main-nav');
+    navItems.forEach((item, idx) => {
+      const li = document.createElement('li');
+      navList.append(li);
+      if (item.children) {
+        const t = makeTrigger(item.label, 'menu-trigger');
+        li.append(t);
+        createMenu(t, item.children, { alignRight: idx >= 3 });
+      } else {
+        const a = document.createElement('a');
+        a.href = item.href;
+        a.textContent = item.label;
+        if (item.cls) a.className = item.cls;
+        li.append(a);
+      }
+    });
+
+    /* ---------- Seasonal favorite cards ---------- */
+    const favorites = [
+      { name: 'Maple Oat Latte', slug: 'seasonal', milk: 'Oat',
+        desc: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+      { name: 'Dark Roast Espresso', slug: 'espresso', milk: 'None',
+        desc: 'Bold, smokey, and perfect for a morning boost.' },
+      { name: 'Cold Brew', slug: 'cold-brew', milk: 'None',
+        desc: 'Steeped for 18 hours for maximum smoothness.' },
+    ];
+    const SIZES = ['Small', 'Medium', 'Large'];
+    const MILKS = ['None', 'Whole', 'Oat', 'Almond', 'Soy'];
+
+    const grid = document.getElementById('favorites');
+    favorites.forEach(fav => {
+      const opts = { size: 'Medium', milk: fav.milk, extraShot: false, iced: false, decaf: false };
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = '<h3></h3><p></p><div class="card-actions"></div>' +
+        '<div class="order-status" role="status" aria-live="polite"></div>';
+      card.querySelector('h3').textContent = fav.name;
+      card.querySelector('p').textContent = fav.desc;
+      const status = card.querySelector('.order-status');
+      grid.append(card);
+
+      const summary = () => [opts.size, opts.iced && 'Iced', opts.decaf && 'Decaf',
+        opts.milk !== 'None' && opts.milk + ' milk', opts.extraShot && 'Extra shot']
+        .filter(Boolean).join(', ');
+
+      const radio = (key, values) => values.map(v => ({
+        label: v, group: key,
+        checked: () => opts[key] === v,
+        select: () => { opts[key] = v; },
+      }));
+
+      const t = makeTrigger('Order Options', 'btn menu-trigger');
+      card.querySelector('.card-actions').append(t);
+      createMenu(t, [
+        { label: 'Add to Order', action: () => { status.textContent = 'Added: ' + fav.name + ' (' + summary() + ')'; } },
+        { label: 'Customize', children: [
+          { heading: 'Add-ons' },
+          { label: 'Extra shot', checked: () => opts.extraShot, toggle: () => { opts.extraShot = !opts.extraShot; } },
+          { label: 'Iced', checked: () => opts.iced, toggle: () => { opts.iced = !opts.iced; } },
+          { label: 'Decaf', checked: () => opts.decaf, toggle: () => { opts.decaf = !opts.decaf; } },
+          { separator: true },
+          { label: 'Size', children: radio('size', SIZES) },
+          { label: 'Milk', children: radio('milk', MILKS) },
+        ] },
+        { separator: true },
+        { label: 'View Details', href: '/menu/' + fav.slug },
+      ]);
+    });
+  </script>
+
