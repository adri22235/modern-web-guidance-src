+<script>
+    const reauthBtn = document.getElementById('reauth-btn');
+    const reauthStatus = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    async function triggerReauth() {
+      // Abort any pending passkey prompt to avoid collisions
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+      reauthBtn.disabled = true;
+      reauthStatus.textContent = '';
+
+      try {
+        // Server returns options scoped to the user's registered credentials
+        const optionsResponse = await fetch('/api/reauth/options', { method: 'POST' });
+        if (!optionsResponse.ok) throw new Error('options');
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsResponse.json());
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal
+        });
+        if (!credential) return;
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedCredential)
+        });
+
+        if (verifyResponse.ok) {
+          reauthStatus.textContent = 'Identity confirmed.';
+        } else {
+          reauthStatus.textContent = 'Verification failed. Please try again.';
+          if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Use the server-provided rpId, never window.location.hostname
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encodedCredential.id
+            });
+          }
+        }
+      } catch (err) {
+        reauthStatus.textContent = err.name === 'NotAllowedError'
+          ? 'Verification was cancelled.'
+          : 'Something went wrong. Please try again.';
+      } finally {
+        reauthBtn.disabled = false;
+      }
+    }
+
+    if (window.PublicKeyCredential && PublicKeyCredential.parseRequestOptionsFromJSON) {
+      reauthBtn.addEventListener('click', triggerReauth);
+    } else {
+      reauthBtn.disabled = true;
+      reauthStatus.textContent = 'Passkeys are not supported in this browser.';
+    }
+  </script>
+
 </body>
 
