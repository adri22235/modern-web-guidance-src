+  <script>
+    (function () {
+      var button = document.querySelector('[data-testid="reauth-button"]');
+      var status = document.getElementById('reauth-status');
+
+      function b64urlToBuf(s) {
+        s = s.replace(/-/g, '+').replace(/_/g, '/');
+        while (s.length % 4) s += '=';
+        var bin = atob(s), bytes = new Uint8Array(bin.length);
+        for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufToB64url(buf) {
+        var bytes = new Uint8Array(buf), bin = '';
+        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      async function postJSON(url, body) {
+        var res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(body || {})
+        });
+        if (!res.ok) throw new Error('Request failed (' + res.status + ')');
+        return res.json();
+      }
+
+      button.addEventListener('click', async function () {
+        if (!window.PublicKeyCredential || !navigator.credentials) {
+          status.textContent = 'Your browser does not support passkeys or security keys.';
+          return;
+        }
+        button.disabled = true;
+        status.textContent = 'Waiting for your passkey or security key…';
+        try {
+          // Server challenge, scoped to the current user's registered credentials.
+          var opts = await postJSON('/api/reauth/options');
+          var publicKey = {
+            challenge: b64urlToBuf(opts.challenge),
+            timeout: opts.timeout,
+            rpId: opts.rpId,
+            userVerification: opts.userVerification || 'required',
+            allowCredentials: (opts.allowCredentials || []).map(function (c) {
+              return { type: c.type || 'public-key', id: b64urlToBuf(c.id), transports: c.transports };
+            })
+          };
+
+          var cred = await navigator.credentials.get({ publicKey: publicKey });
+          var r = cred.response;
+
+          await postJSON('/api/reauth/verify', {
+            id: cred.id,
+            rawId: bufToB64url(cred.rawId),
+            type: cred.type,
+            response: {
+              clientDataJSON: bufToB64url(r.clientDataJSON),
+              authenticatorData: bufToB64url(r.authenticatorData),
+              signature: bufToB64url(r.signature),
+              userHandle: r.userHandle ? bufToB64url(r.userHandle) : null
+            }
+          });
+          status.textContent = 'Identity confirmed.';
+        } catch (err) {
+          status.textContent = 'Verification failed: ' + (err && err.message ? err.message : err);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
