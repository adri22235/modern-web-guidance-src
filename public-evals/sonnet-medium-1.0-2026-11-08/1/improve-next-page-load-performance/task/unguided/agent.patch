+  <script>
+    // Prefetch same-origin links once they scroll into view (or on hover/focus).
+    // Logout and other state-changing links are excluded.
+    (function () {
+      var conn = navigator.connection;
+      if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ''))) return;
+
+      var seen = {};
+      function skip(a) {
+        return a.origin !== location.origin ||
+          a.hasAttribute('data-no-prefetch') ||
+          a.hasAttribute('download') ||
+          (a.target && a.target !== '_self') ||
+          /\/(logout|log-out|signout|sign-out)(\/|$)/i.test(a.pathname) ||
+          a.pathname === location.pathname;
+      }
+      function prefetch(a) {
+        if (skip(a) || seen[a.href]) return;
+        seen[a.href] = true;
+        var l = document.createElement('link');
+        l.rel = 'prefetch';
+        l.href = a.href;
+        l.as = 'document';
+        document.head.appendChild(l);
+      }
+
+      var links = document.querySelectorAll('a[href]');
+      if ('IntersectionObserver' in window) {
+        var io = new IntersectionObserver(function (entries) {
+          entries.forEach(function (e) {
+            if (e.isIntersecting) { io.unobserve(e.target); prefetch(e.target); }
+          });
+        });
+        links.forEach(function (a) { if (!skip(a)) io.observe(a); });
+      }
+      links.forEach(function (a) {
+        ['mouseenter', 'focus', 'touchstart'].forEach(function (ev) {
+          a.addEventListener(ev, function () { prefetch(a); }, { passive: true });
+        });
+      });
+    })();
+  </script>
