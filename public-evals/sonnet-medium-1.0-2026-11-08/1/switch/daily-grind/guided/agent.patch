+    /* Preference toggle */
+    .pref-toggle {
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+      background: none;
+      border: none;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+
+    .pref-toggle .track {
+      width: 36px;
+      height: 20px;
+      border-radius: 10px;
+      background: #8d6e63;
+      position: relative;
+      transition: background 0.3s;
+    }
+
+    .pref-toggle .track::after {
+      content: '';
+      position: absolute;
+      top: 2px;
+      left: 2px;
+      width: 16px;
+      height: 16px;
+      border-radius: 50%;
+      background: white;
+      transition: transform 0.3s;
+    }
+
+    .pref-toggle[aria-checked="true"] .track {
+      background: var(--accent);
+    }
+
+    .pref-toggle[aria-checked="true"] .track::after {
+      transform: translateX(16px);
+    }
+
+    .pref-toggle:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Dark mode (preference on) */
+    :root[data-dark="true"] {
+      --secondary: #3e2723;
+      --text: #efebe9;
+      --light: #1e1512;
+    }
+
+    :root[data-dark="true"] .card {
+      background: #2b1f1b;
+    }
+
+    :root[data-dark="true"] .card h3 {
+      color: var(--accent);
+    }
   </style>
+  <script>
+    // Apply saved preference before paint to avoid a flash
+    try {
+      document.documentElement.dataset.dark = localStorage.getItem('darkMode') === 'on';
+    } catch (e) { }
+  </script>
 </head>
 
