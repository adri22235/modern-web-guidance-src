+  <script>
+    (function () {
+      var KEY = 'offersEnabled';
+      var toggle = document.getElementById('offers-toggle');
+      var state = document.getElementById('offers-state');
+
+      function render(on) {
+        toggle.setAttribute('aria-checked', String(on));
+        state.textContent = on ? 'On' : 'Off';
+      }
+
+      var saved = false;
+      try { saved = localStorage.getItem(KEY) === 'true'; } catch (e) {}
+      render(saved);
+
+      toggle.addEventListener('click', function () {
+        var on = toggle.getAttribute('aria-checked') !== 'true';
+        render(on);
+        try { localStorage.setItem(KEY, String(on)); } catch (e) {}
+      });
+    })();
+  </script>
+
 </body>
 
