@@ -206,7 +243,213 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const hero = document.getElementById('hero');
+      if (!hero || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+
+      const canvas = document.createElement('canvas');
+      canvas.className = 'hero-gl';
+      canvas.setAttribute('aria-hidden', 'true');
+      hero.prepend(canvas);
+
+      const gl = canvas.getContext('webgl', { premultipliedAlpha: true, alpha: true });
+      if (!gl) { canvas.remove(); return; }
+
+      const MAX = 8;
+      const vs = `attribute vec2 p; varying vec2 uv;
+        void main(){ uv = p * 0.5 + 0.5; gl_Position = vec4(p, 0., 1.); }`;
+      const fs = `precision mediump float;
+        varying vec2 uv;
+        uniform sampler2D tex;
+        uniform float time, aspect;
+        uniform vec3 rip[${MAX}]; // x, y (uv, y up), start time
+        void main(){
+          vec2 st = vec2(uv.x, 1. - uv.y); // texture is top-down
+          vec2 off = vec2(0.);
+          for (int i = 0; i < ${MAX}; i++) {
+            float age = time - rip[i].z;
+            if (rip[i].z < 0. || age > 3.5) continue;
+            vec2 d = st - rip[i].xy;
+            d.x *= aspect;
+            float r = length(d);
+            float front = age * 0.35;
+            float env = exp(-pow((r - front) * 7., 2.)) * exp(-age * 1.1);
+            float wave = sin((r - front) * 48.);
+            vec2 dir = d / max(r, 1e-4);
+            dir.x /= aspect;
+            off += dir * wave * env * 0.02;
+          }
+          float a = texture2D(tex, st + off * 1.0).a;
+          vec3 c = vec3(
+            texture2D(tex, st + off * 1.25).r,
+            texture2D(tex, st + off).g,
+            texture2D(tex, st + off * 0.75).b);
+          vec4 t = texture2D(tex, st + off);
+          // keep premultiplied output; chroma split only where there is ink
+          gl_FragColor = vec4(mix(t.rgb, c, 0.6), t.a);
+        }`;
+
+      const compile = (type, src) => {
+        const sh = gl.createShader(type);
+        gl.shaderSource(sh, src);
+        gl.compileShader(sh);
+        return gl.getShaderParameter(sh, gl.COMPILE_STATUS) ? sh : null;
+      };
+      const v = compile(gl.VERTEX_SHADER, vs), f = compile(gl.FRAGMENT_SHADER, fs);
+      if (!v || !f) { canvas.remove(); return; }
+      const prog = gl.createProgram();
+      gl.attachShader(prog, v); gl.attachShader(prog, f);
+      gl.linkProgram(prog);
+      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { canvas.remove(); return; }
+      gl.useProgram(prog);
+
+      const buf = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const loc = gl.getAttribLocation(prog, 'p');
+      gl.enableVertexAttribArray(loc);
+      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+      const u = n => gl.getUniformLocation(prog, n);
+      const uTime = u('time'), uAspect = u('aspect'), uRip = u('rip');
+
+      const tex = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, tex);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
+      gl.enable(gl.BLEND);
+      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
+
+      // ---- Rasterise the hero's text + button into a 2D canvas ----
+      const layer = document.createElement('canvas');
+      const ctx = layer.getContext('2d');
+      let hovering = false;
+
+      function drawLines(el, box) {
+        const cs = getComputedStyle(el);
+        ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        ctx.textBaseline = 'middle';
+        ctx.textAlign = 'left';
+        const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+        const lines = [];
+        for (let n; (n = walker.nextNode());) {
+          const re = /\S+/g;
+          for (let m; (m = re.exec(n.nodeValue));) {
+            const r = document.createRange();
+            r.setStart(n, m.index);
+            r.setEnd(n, m.index + m[0].length);
+            const b = r.getBoundingClientRect();
+            const last = lines[lines.length - 1];
+            if (last && Math.abs(last.cy - (b.top + b.height / 2)) < b.height / 2) {
+              last.text += ' ' + m[0];
+            } else {
+              lines.push({ text: m[0], x: b.left - box.left, cy: b.top + b.height / 2, y: b.top + b.height / 2 - box.top });
+            }
+          }
+        }
+        for (const l of lines) ctx.fillText(l.text, l.x, l.y);
+      }
+
+      function paintLayer() {
+        const box = hero.getBoundingClientRect();
+        const dpr = Math.min(window.devicePixelRatio || 1, 2);
+        const w = Math.max(1, Math.round(box.width * dpr)), h = Math.max(1, Math.round(box.height * dpr));
+        if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
+        layer.width = w; layer.height = h;
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, box.width, box.height);
+
+        const style = getComputedStyle(hero);
+        const textColor = style.color;
+        for (const el of hero.querySelectorAll('h1, p, .btn')) {
+          if (el.classList.contains('btn')) {
+            const b = el.getBoundingClientRect();
+            const r = parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0;
+            ctx.fillStyle = hovering ? '#3e2723' : '#4e342e';
+            ctx.beginPath();
+            ctx.roundRect(b.left - box.left, b.top - box.top, b.width, b.height, r);
+            ctx.fill();
+          }
+          ctx.fillStyle = textColor;
+          ctx.shadowColor = 'rgba(0,0,0,0.35)';
+          ctx.shadowBlur = 6;
+          drawLines(el, box);
+          ctx.shadowBlur = 0;
+        }
+
+        gl.bindTexture(gl.TEXTURE_2D, tex);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, layer);
+        gl.viewport(0, 0, w, h);
+        gl.uniform1f(uAspect, box.width / box.height);
+        draw();
+      }
+
+      // ---- Ripples ----
+      const ripples = new Float32Array(MAX * 3).fill(-1);
+      let next = 0, raf = 0;
+      const t0 = performance.now();
+      const now = () => (performance.now() - t0) / 1000;
+
+      function addRipple(x, y) {
+        const box = hero.getBoundingClientRect();
+        ripples.set([(x - box.left) / box.width, (y - box.top) / box.height, now()], next * 3);
+        next = (next + 1) % MAX;
+        if (!raf) raf = requestAnimationFrame(tick);
+      }
+
+      function draw() {
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+        gl.uniform1f(uTime, now());
+        gl.uniform3fv(uRip, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+      }
+
+      function tick() {
+        draw();
+        const t = now();
+        const live = Array.from({ length: MAX }, (_, i) => ripples[i * 3 + 2]).some(s => s >= 0 && t - s < 3.5);
+        raf = live ? requestAnimationFrame(tick) : 0;
+      }
+
+      let lastMove = 0;
+      hero.addEventListener('pointermove', e => {
+        const t = performance.now();
+        if (t - lastMove < 140) return;
+        lastMove = t;
+        addRipple(e.clientX, e.clientY);
+      });
+      hero.addEventListener('pointerdown', e => addRipple(e.clientX, e.clientY));
+
+      const btn = hero.querySelector('.btn');
+      if (btn) {
+        const setHover = h => { hovering = h; paintLayer(); };
+        btn.addEventListener('pointerenter', () => setHover(true));
+        btn.addEventListener('pointerleave', () => setHover(false));
+      }
+
+      // ---- Setup ----
+      let pending = 0;
+      const schedule = () => {
+        cancelAnimationFrame(pending);
+        pending = requestAnimationFrame(paintLayer);
+      };
+      new ResizeObserver(schedule).observe(hero);
+
+      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => {
+        hero.classList.add('gl-on');
+        paintLayer();
+        const b = hero.getBoundingClientRect();
+        addRipple(b.left + b.width / 2, b.top + b.height / 2); // intro ripple
+      });
+    })();
+  </script>
+
 </body>
 
