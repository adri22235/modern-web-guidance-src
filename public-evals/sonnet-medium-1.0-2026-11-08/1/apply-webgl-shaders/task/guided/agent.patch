+  <script>
+    // GPU ripple distortion for the hero content via HTML-in-Canvas.
+    // The DOM stays real (selectable, clickable); WebGL only restyles its pixels.
+    (() => {
+      const hero = document.querySelector('.hero');
+      const canvas = hero.querySelector('.hero-canvas');
+      const content = canvas.querySelector('.hero-content');
+
+      // Fallback: render the content as plain HTML.
+      const unwrap = () => canvas.replaceWith(content);
+
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (!('content' in HTMLCanvasElement.prototype) || reduceMotion) return unwrap();
+      const gl = canvas.getContext('webgl2');
+      if (!gl) return unwrap();
+
+      const MAX_RIPPLES = 8;
+      const VERT = `#version 300 es
+        in vec2 aPos;
+        out vec2 vUv;
+        void main() {
+          // Texture row 0 is the top of the HTML element.
+          vUv = vec2(aPos.x * 0.5 + 0.5, 0.5 - aPos.y * 0.5);
+          gl_Position = vec4(aPos, 0.0, 1.0);
+        }`;
+      const FRAG = `#version 300 es
+        precision highp float;
+        in vec2 vUv;
+        out vec4 outColor;
+        uniform sampler2D uTex;
+        uniform vec2 uRes;            // canvas size in CSS px
+        uniform float uTime;
+        uniform vec3 uRipples[${MAX_RIPPLES}]; // xy = origin (CSS px), z = start time
+
+        void main() {
+          vec2 px = vUv * uRes;
+          vec2 offset = vec2(0.0);
+
+          // Subtle ambient swell so the hero feels alive.
+          offset += vec2(
+            sin(px.y * 0.025 + uTime * 1.3),
+            cos(px.x * 0.02 + uTime * 1.1)
+          ) * 0.6;
+
+          // Expanding interactive ripples.
+          for (int i = 0; i < ${MAX_RIPPLES}; i++) {
+            vec3 r = uRipples[i];
+            float age = uTime - r.z;
+            if (r.z < 0.0 || age < 0.0 || age > 3.0) continue;
+            vec2 delta = px - r.xy;
+            float d = length(delta);
+            float front = age * 320.0;                       // wavefront radius, px
+            float ring = exp(-pow((d - front) / 70.0, 2.0)); // band around the front
+            float wave = sin((d - front) * 0.14) * ring * exp(-age * 1.1);
+            offset += normalize(delta + 0.001) * wave * 7.0;
+          }
+
+          vec2 uv = clamp((px - offset) / uRes, 0.0, 1.0);
+          outColor = texture(uTex, uv);
+        }`;
+
+      function compile(type, src) {
+        const sh = gl.createShader(type);
+        gl.shaderSource(sh, src);
+        gl.compileShader(sh);
+        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh));
+        return sh;
+      }
+
+      let program;
+      try {
+        program = gl.createProgram();
+        gl.attachShader(program, compile(gl.VERTEX_SHADER, VERT));
+        gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAG));
+        gl.linkProgram(program);
+        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(program));
+      } catch (err) {
+        console.error('Hero shader failed:', err);
+        return unwrap();
+      }
+      gl.useProgram(program);
+
+      // Full-screen quad
+      const buf = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
+      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
+      const loc = gl.getAttribLocation(program, 'aPos');
+      gl.enableVertexAttribArray(loc);
+      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
+
+      const uRes = gl.getUniformLocation(program, 'uRes');
+      const uTime = gl.getUniformLocation(program, 'uTime');
+      const uRipples = gl.getUniformLocation(program, 'uRipples');
+
+      // Texture
+      const texture = gl.createTexture();
+      const textureState = { width: 0, height: 0 };
+      let hasTexture = false;
+
+      function getElementImageSize() {
+        let img;
+        try {
+          img = canvas.captureElementImage(content);
+        } catch (err) {
+          canvas.requestPaint(); // No paint record yet; retry on next paint.
+          return null;
+        }
+        const width = Math.ceil(img.width);
+        const height = Math.ceil(img.height);
+        img.close();
+        return width > 0 && height > 0 ? { width, height } : null;
+      }
+
+      function uploadContent() {
+        const size = getElementImageSize();
+        if (!size) return false;
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        if (textureState.width !== size.width || textureState.height !== size.height) {
+          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, size.width, size.height, 0,
+            gl.RGBA, gl.UNSIGNED_BYTE, null);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+          textureState.width = size.width;
+          textureState.height = size.height;
+        }
+        gl.texElementSubImage2D(gl.TEXTURE_2D, 0, 0, 0, content, size);
+        return true;
+      }
+
+      // Match the canvas grid to device pixels
+      new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        canvas.requestPaint();
+      }).observe(canvas, 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype
+        ? { box: 'device-pixel-content-box' } : {});
+
+      // Ripples
+      const ripples = new Float32Array(MAX_RIPPLES * 3).fill(-1);
+      let nextRipple = 0;
+      let lastMove = 0;
+      const now = () => performance.now() / 1000;
+
+      function addRipple(e) {
+        const rect = canvas.getBoundingClientRect();
+        const i = nextRipple++ % MAX_RIPPLES;
+        ripples[i * 3] = e.clientX - rect.left;
+        ripples[i * 3 + 1] = e.clientY - rect.top;
+        ripples[i * 3 + 2] = now();
+      }
+      canvas.addEventListener('pointerdown', addRipple);
+      canvas.addEventListener('pointermove', (e) => {
+        if (e.timeStamp - lastMove < 140) return;
+        lastMove = e.timeStamp;
+        addRipple(e);
+      });
+
+      // Draw
+      canvas.onpaint = (event) => {
+        try {
+          if (!hasTexture || (event.changedElements && event.changedElements.length > 0)) {
+            hasTexture = uploadContent() || hasTexture;
+          }
+        } catch (err) {
+          console.error('texElementSubImage2D copy failed:', err);
+        }
+        if (!hasTexture) return;
+
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+        gl.uniform2f(uRes, canvas.clientWidth, canvas.clientHeight);
+        gl.uniform1f(uTime, now());
+        gl.uniform3fv(uRipples, ripples);
+        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
+
+        // Content fills the canvas, so its CSS-pixel box maps 1:1 (identity)
+        // and hit testing, selection and focus rings line up.
+        canvas.updateElementGeometry(content, { canvasTransform: new DOMMatrix() });
+      };
+
+      // Animation loop, paused while the hero is not rendered
+      let raf = 0;
+      function frame() {
+        canvas.requestPaint();
+        raf = requestAnimationFrame(frame);
+      }
+      const start = () => { if (!raf) raf = requestAnimationFrame(frame); };
+      const stop = () => { cancelAnimationFrame(raf); raf = 0; };
+
+      if ('contentVisibility' in document.documentElement.style) {
+        hero.addEventListener('contentvisibilityautostatechange', (e) => e.skipped ? stop() : start());
+      } else {
+        new IntersectionObserver(([e]) => e.isIntersecting ? start() : stop(), { rootMargin: '200px' })
+          .observe(hero);
+      }
+      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
+      start();
+    })();
+  </script>
+
 </body>
 
