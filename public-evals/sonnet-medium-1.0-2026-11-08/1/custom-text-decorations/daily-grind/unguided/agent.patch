--- a/index.html
+++ b/index.html
@@ -152,6 +152,106 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Decorative text lines
+       --deco-offset: vertical offset of the line from the text
+       --deco-inset:  horizontal inset at the end of the line
+       Ink skipping keeps the line from cutting through descenders (g, y, p...).
+       Reveal: the line's end inset retracts (text-decoration-inset) while the
+       colour fades in, so browsers without inset support still get a fade. */
+    nav ul a,
+    .footer-links a,
+    .container h2,
+    .card h3 {
+      --deco-color: currentColor;
+      --deco-hidden-inset: 12em;
+      text-decoration-line: var(--deco-line, underline);
+      text-decoration-style: solid;
+      text-decoration-thickness: 2px;
+      text-decoration-skip-ink: all;
+      text-decoration-color: transparent;
+      text-underline-offset: var(--deco-offset, 0.3em);
+      text-decoration-inset: 0 var(--deco-hidden-inset);
+      transition: color 0.3s,
+        text-decoration-color 0.4s ease,
+        text-decoration-inset 0.5s ease,
+        text-underline-offset 0.4s ease;
+    }
+
+    /* Navigation: underline reveals on hover/focus */
+    nav ul a {
+      --deco-offset: 0.45em;
+      --deco-color: var(--accent);
+    }
+
+    nav ul a:hover,
+    nav ul a:focus-visible {
+      --deco-offset: 0.25em;
+      text-decoration-color: var(--deco-color);
+      text-decoration-inset: 0 0.1em;
+    }
+
+    /* Footer: overline reveals on hover/focus */
+    .footer-links a {
+      --deco-line: overline;
+      --deco-offset: 0.5em;
+      --deco-color: var(--primary);
+    }
+
+    .footer-links a:hover,
+    .footer-links a:focus-visible {
+      --deco-offset: 0.3em;
+      text-decoration-color: var(--deco-color);
+      text-decoration-inset: 0.2em 0.2em;
+    }
+
+    /* Section heading: underline draws in on load */
+    .container h2 {
+      --deco-color: var(--accent);
+      --deco-offset: 0.25em;
+      text-decoration-thickness: 4px;
+      text-decoration-color: var(--deco-color);
+      text-decoration-inset: 0 0.5em;
+      animation: deco-reveal 1s ease 0.2s both;
+    }
+
+    /* Card titles: underline reveals when the card is hovered */
+    .card h3 {
+      --deco-line: underline;
+      --deco-offset: 0.35em;
+      --deco-color: var(--accent);
+      text-decoration-thickness: 3px;
+    }
+
+    .card:hover h3,
+    .card:focus-within h3 {
+      --deco-offset: 0.2em;
+      text-decoration-color: var(--deco-color);
+      text-decoration-inset: 0.3em 0.3em;
+    }
+
+    @keyframes deco-reveal {
+      from {
+        text-decoration-color: transparent;
+        text-decoration-inset: 0 12em;
+      }
+
+      to {
+        text-decoration-color: var(--accent);
+        text-decoration-inset: 0 0.5em;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      nav ul a,
+      .footer-links a,
+      .container h2,
+      .card h3 {
+        transition: none;
+        animation: none;
+      }
+    }
   </style>
 </head>
 
