+  <script type="module">
+    // Load the Popover API polyfill only where the feature is missing. Top-level
+    // await holds back the rest of this module, so the code below can rely on popover support.
+    const POLYFILL = 'https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@0.5.2/dist/';
+    if (!HTMLElement.prototype.hasOwnProperty('popover')) {
+      const css = document.createElement('link');
+      css.rel = 'stylesheet';
+      css.href = POLYFILL + 'popover.css';
+      document.head.append(css);
+      await import(POLYFILL + 'popover.js');
+    }
+
+    const btn = document.getElementById('rewards-btn');
+    const card = document.getElementById('rewards-card');
+
+    function position() {
+      const r = btn.getBoundingClientRect();
+      const left = Math.max(10, Math.min(r.right - card.offsetWidth, innerWidth - card.offsetWidth - 10));
+      card.style.left = `${left}px`;
+      card.style.top = `${r.bottom + 8}px`;
+    }
+
+    card.addEventListener('toggle', (e) => {
+      if (e.newState === 'open') position();
+    });
+    addEventListener('resize', () => card.matches(':popover-open') && position());
+  </script>
+
 </body>
 
