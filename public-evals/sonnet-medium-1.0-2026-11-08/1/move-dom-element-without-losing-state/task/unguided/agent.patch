+
+  <script>
+    (function () {
+      var hero = document.querySelector('.hero');
+      var frame = document.getElementById('video-frame');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var section = document.getElementById('video-slot');
+      var btn = document.getElementById('theater-toggle');
+      var theater = false;
+
+      // Moving an iframe in the DOM reloads it and resets playback, so the
+      // frame stays put and is absolutely positioned over the active slot.
+      function place() {
+        var slot = theater ? heroSlot : section;
+        var parent = frame.offsetParent;
+        var s = slot.getBoundingClientRect();
+        var p = parent.getBoundingClientRect();
+        if (!theater) {
+          frame.style.cssText = '';
+          return;
+        }
+        frame.style.top = (s.top - p.top) + 'px';
+        frame.style.left = (s.left - p.left) + 'px';
+        frame.style.width = s.width + 'px';
+        frame.style.height = s.height + 'px';
+        frame.style.zIndex = 10;
+      }
+
+      btn.addEventListener('click', function () {
+        theater = !theater;
+        hero.classList.toggle('theater', theater);
+        btn.setAttribute('aria-pressed', theater);
+        btn.textContent = theater ? 'Exit Theater Mode' : 'Enter Theater Mode';
+        place();
+        if (theater) hero.scrollIntoView({ behavior: 'smooth' });
+      });
+
+      window.addEventListener('resize', function () { if (theater) place(); });
+    })();
+  </script>
+
