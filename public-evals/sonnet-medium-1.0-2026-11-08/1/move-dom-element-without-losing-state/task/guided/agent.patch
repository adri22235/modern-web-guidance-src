+  <script>
+    const toggle = document.getElementById('theater-toggle');
+    const frame = document.getElementById('video-frame');
+    const pageSlot = document.getElementById('video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const hero = document.querySelector('.hero');
+    const status = document.getElementById('theater-status');
+
+    // moveBefore() keeps the iframe loaded (and the video playing); fall back to insertBefore().
+    function moveTo(parent, node) {
+      if ('moveBefore' in Element.prototype) {
+        parent.moveBefore(node, null);
+      } else {
+        parent.insertBefore(node, null);
+      }
+    }
+
+    toggle.addEventListener('click', () => {
+      const entering = toggle.getAttribute('aria-pressed') === 'false';
+      moveTo(entering ? heroSlot : pageSlot, frame);
+      hero.classList.toggle('theater', entering);
+      toggle.setAttribute('aria-pressed', String(entering));
+      toggle.textContent = entering ? 'Exit Theater Mode' : 'Enter Theater Mode';
+      status.textContent = entering ? 'Video moved to the top of the page.' : 'Video moved back to its section.';
+      if (entering) hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    });
+  </script>
+
