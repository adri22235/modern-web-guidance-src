+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+      var items = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-item'));
+      var frame;
+
+      function update() {
+        var box = carousel.getBoundingClientRect();
+        var center = box.left + box.width / 2;
+        var best = null, bestDist = Infinity;
+        items.forEach(function (item) {
+          var r = item.getBoundingClientRect();
+          // Use the layout center so the 1.15 scale doesn't skew the comparison.
+          var d = Math.abs(r.left + r.width / 2 - center);
+          if (d < bestDist) { bestDist = d; best = item; }
+        });
+        items.forEach(function (item) {
+          item.classList.toggle('is-snapped', item === best);
+        });
+      }
+
+      function schedule() {
+        cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(update);
+      }
+
+      carousel.addEventListener('scroll', schedule, { passive: true });
+      window.addEventListener('resize', schedule);
+      update();
+    })();
+  </script>
+
 </body>
 
