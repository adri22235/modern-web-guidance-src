@@ -134,8 +134,64 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Seasonal carousel */
+    .carousel {
+      display: flex;
+      gap: 20px;
+      margin-top: 20px;
+      padding: 30px 0;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: 20px;
+    }
+
+    .carousel-item {
+      flex: 0 0 min(300px, 80%);
+      scroll-snap-align: center;
+      container-type: scroll-state;
+    }
+
+    .carousel-item:first-child {
+      margin-inline-start: max(0px, calc(50% - 150px));
+    }
+
+    .carousel-item:last-child {
+      margin-inline-end: max(0px, calc(50% - 150px));
+    }
+
+    .carousel-item .card {
+      height: 100%;
+      transition:
+        scale 0.4s cubic-bezier(0.25, 0.8, 0.25, 1),
+        background-color 0.4s,
+        color 0.4s,
+        box-shadow 0.4s;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @container scroll-state(snapped: x) {
+        .carousel-item .card {
+          background: #007bff;
+          color: white;
+          scale: 1.15;
+          box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
+        }
+
+        .carousel-item .card h3 {
+          color: white;
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel-item .card {
+        transition: none !important;
+        scale: 1 !important;
+      }
+    }
+
