 <body>
@@ -197,8 +254,21 @@
     </section>
   </main>
 
   <footer>
+    <form class="newsletter" id="newsletter-form" novalidate>
+      <h3 id="newsletter-title">Join our newsletter</h3>
+      <div class="newsletter-row">
+        <label for="newsletter-email" style="position:absolute;left:-9999px">Email address</label>
+        <input type="email" id="newsletter-email" name="email" placeholder="you@example.com"
+          autocomplete="email" required aria-describedby="newsletter-error">
+        <button type="submit">Subscribe</button>
+      </div>
+      <!-- Text is only present while the visual error is shown, so screen readers
+           announce exactly when (and only when) the error appears. -->
+      <p class="newsletter-error" id="newsletter-error" role="alert"></p>
+      <p class="newsletter-success" id="newsletter-success" role="status"></p>
+    </form>
     <div class="footer-links">
