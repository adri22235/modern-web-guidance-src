     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const email = document.getElementById('newsletter-email');
+      const status = document.getElementById('newsletter-status');
+
+      // Mirror the visual :user-invalid state into aria-invalid so screen readers
+      // are told about the error exactly when the error message appears,
+      // and it is cleared as soon as the email becomes valid.
+      const syncAria = () => {
+        if (email.matches(':user-invalid')) {
+          email.setAttribute('aria-invalid', 'true');
+        } else {
+          email.removeAttribute('aria-invalid');
+        }
+      };
+
+      email.addEventListener('blur', syncAria);
+      email.addEventListener('input', () => {
+        status.textContent = '';
+        syncAria();
+      });
+      // Fires on submit attempts with an invalid value
+      email.addEventListener('invalid', syncAria);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        status.textContent = 'Thanks for subscribing!';
+        form.reset();
+        syncAria();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
