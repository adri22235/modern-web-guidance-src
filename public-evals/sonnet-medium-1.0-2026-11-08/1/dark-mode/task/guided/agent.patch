+<script>
+    const meta = document.querySelector('meta[name="color-scheme"]');
+    const select = document.getElementById('theme-select');
+    const read = () => { try { return localStorage.getItem('color-scheme'); } catch (e) { return null; } };
+    const sync = () => {
+      const v = read();
+      meta.content = v ?? 'light dark';
+      select.value = v ?? 'system';
+    };
+    select.addEventListener('change', () => {
+      try {
+        if (select.value === 'system') localStorage.removeItem('color-scheme');
+        else localStorage.setItem('color-scheme', select.value);
+      } catch (e) { }
+      meta.content = select.value === 'system' ? 'light dark' : select.value;
+    });
+    window.addEventListener('storage', sync);
+    sync();
+  </script>
