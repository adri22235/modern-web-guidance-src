+  <div id="hovercard" class="hovercard" role="dialog" aria-label="Drink preview"></div>
+
+  <script>
+    (function () {
+      var drinks = {
+        'seasonal': {
+          title: 'Maple Oat Latte',
+          desc: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          details: { Size: '12 / 16 oz', Calories: '240', Caffeine: '150 mg', Served: 'Hot or iced' }
+        },
+        'espresso': {
+          title: 'Dark Roast Espresso',
+          desc: 'Bold, smokey, and perfect for a morning boost.',
+          details: { Size: '2 / 4 oz', Calories: '5', Caffeine: '130 mg', Served: 'Hot' }
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          desc: 'Steeped for 18 hours for maximum smoothness.',
+          details: { Size: '16 / 24 oz', Calories: '15', Caffeine: '200 mg', Served: 'Iced' }
+        }
+      };
+
+      var card = document.getElementById('hovercard');
+      var hideTimer, current;
+
+      function el(tag, cls, text) {
+        var e = document.createElement(tag);
+        if (cls) e.className = cls;
+        if (text) e.textContent = text;
+        return e;
+      }
+
+      function show(link) {
+        clearTimeout(hideTimer);
+        var d = drinks[link.dataset.hovercard];
+        if (!d) return;
+        if (current !== link) {
+          card.textContent = '';
+          card.appendChild(el('h4', '', d.title));
+          card.appendChild(el('div', 'hc-path', link.getAttribute('href')));
+          card.appendChild(el('p', '', d.desc));
+          var dl = el('dl');
+          Object.keys(d.details).forEach(function (k) {
+            dl.appendChild(el('dt', '', k));
+            dl.appendChild(el('dd', '', d.details[k]));
+          });
+          card.appendChild(dl);
+          var open = el('a', 'hc-open', 'Open page \u2192');
+          open.href = link.href;
+          card.appendChild(open);
+          current = link;
+        }
+        var r = link.getBoundingClientRect();
+        var left = r.left + window.scrollX + r.width / 2 - card.offsetWidth / 2;
+        left = Math.max(8, Math.min(left, document.documentElement.clientWidth - card.offsetWidth - 8));
+        var top = r.top + window.scrollY - card.offsetHeight - 8;
+        if (r.top < card.offsetHeight + 16) top = r.bottom + window.scrollY + 8;
+        card.style.left = left + 'px';
+        card.style.top = top + 'px';
+        card.classList.add('open');
+      }
+
+      function hide() {
+        hideTimer = setTimeout(function () { card.classList.remove('open'); }, 150);
+      }
+
+      document.querySelectorAll('.hovercard-trigger').forEach(function (link) {
+        link.addEventListener('mouseenter', function () { show(link); });
+        link.addEventListener('mouseleave', hide);
+        link.addEventListener('focus', function () { show(link); });
+        link.addEventListener('blur', hide);
+      });
+      card.addEventListener('mouseenter', function () { clearTimeout(hideTimer); });
+      card.addEventListener('mouseleave', hide);
+      card.addEventListener('focusin', function () { clearTimeout(hideTimer); });
+      card.addEventListener('focusout', hide);
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') card.classList.remove('open');
+      });
+    })();
+  </script>
+
 </body>
 
