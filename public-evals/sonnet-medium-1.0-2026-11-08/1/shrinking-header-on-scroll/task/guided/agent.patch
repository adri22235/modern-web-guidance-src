+    /* Shrink the nav over the first 100px of scroll.
+       Native: scroll-driven animation. Fallback: JS sets --nav-progress (0 to 1). */
+    @keyframes nav-shrink {
+      to {
+        padding-block: 0.35rem;
+        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
+      }
+    }
+
+    @keyframes logo-shrink {
+      to {
+        font-size: 1.1rem;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+        nav {
+          animation: nav-shrink auto linear both;
+          animation-timeline: scroll(root block);
+          animation-range: 0px 100px;
+        }
+
+        .logo {
+          animation: logo-shrink auto linear both;
+          animation-timeline: scroll(root block);
+          animation-range: 0px 100px;
+        }
+      }
+
+      @supports not ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+        nav {
+          --nav-progress: 0;
+          padding-block: calc(1rem - 0.65rem * var(--nav-progress));
+          box-shadow: 0 2px 8px rgba(0, 0, 0, calc(0.35 * var(--nav-progress)));
+        }
+
+        .logo {
+          font-size: calc(1.5rem - 0.4rem * var(--nav-progress, 0));
+        }
+      }
+    }
