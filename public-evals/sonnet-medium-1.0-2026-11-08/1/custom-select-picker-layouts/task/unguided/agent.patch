@@ -92,8 +92,95 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+
+    /* Roast picker (customizable select; falls back to a native select) */
+    .roast-picker {
+      margin-top: 20px;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 6px;
+    }
+
+    .roast-picker label {
+      font-size: 0.85rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+    }
+
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .roast-select {
+      min-width: 220px;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .roast-select::picker(select) {
+      padding: 10px;
+      margin-top: 6px;
+      background: white;
+      border: 2px solid var(--accent);
+      border-radius: 10px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
+      display: grid;
+      grid-template-columns: repeat(3, 110px);
+      gap: 10px;
+    }
+
+    .roast-select option {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 6px;
+      padding: 12px 6px;
+      border-radius: 8px;
+      background: var(--light);
+      text-align: center;
+      cursor: pointer;
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .roast-select option:checked {
+      outline: 2px solid var(--accent);
+      background: #fff3e0;
+    }
+
+    .roast-swatch {
+      display: block;
+      width: 56px;
+      height: 56px;
+      border-radius: 50%;
+      border: 3px solid white;
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
+    }
+
+    .roast-swatch.light { background: radial-gradient(circle at 35% 30%, #d7a86e, #b8814a); }
+    .roast-swatch.medium { background: radial-gradient(circle at 35% 30%, #8d5b3a, #6d4128); }
+    .roast-swatch.dark { background: radial-gradient(circle at 35% 30%, #4e342e, #1b0f0c); }
+
+    .roast-name {
+      font-weight: 600;
+    }
+
