+  <script>
+    // Left/Right arrows move between options in the open grid picker (Up/Down stay native).
+    const roast = document.getElementById('roast');
+    roast.addEventListener('keydown', (e) => {
+      if (!roast.matches(':open') || !['ArrowLeft', 'ArrowRight'].includes(e.key)) return;
+      const opts = [...roast.options];
+      const i = opts.indexOf(document.activeElement);
+      const rtl = getComputedStyle(roast).direction === 'rtl';
+      const step = (e.key === 'ArrowRight') !== rtl ? 1 : -1;
+      const next = opts[i + step];
+      if (next) {
+        e.preventDefault();
+        next.focus();
+      }
+    });
+  </script>
