+  <script blocking="render">
+    // Pages are addressed as /?page=N (default 2); direction = comparing the old and new page numbers.
+    const pageOf = (url) => Number(new URL(url).searchParams.get('page')) || 2;
+    window.addEventListener('pagereveal', (e) => {
+      const from = window.navigation?.activation?.from;
+      if (!e.viewTransition || !from) return;
+      const diff = pageOf(location.href) - pageOf(from.url);
+      if (diff) e.viewTransition.types.add(diff > 0 ? 'next' : 'previous');
+    });
+  </script>
+  <link rel="expect" href="#pagination" blocking="render">
