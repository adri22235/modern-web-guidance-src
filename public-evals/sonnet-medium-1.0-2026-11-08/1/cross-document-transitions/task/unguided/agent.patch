+  <script>
+    // Direction-aware cross-document transitions. The clicked link's direction
+    // is remembered so both the outgoing and incoming pages can apply it.
+    const DIRECTION_KEY = 'page-transition-direction';
+
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('#previous, #next');
+      if (link) sessionStorage.setItem(DIRECTION_KEY, link.id === 'next' ? 'forwards' : 'backwards');
+      else sessionStorage.removeItem(DIRECTION_KEY);
+    });
+
+    window.addEventListener('pageswap', (event) => {
+      const direction = sessionStorage.getItem(DIRECTION_KEY);
+      if (event.viewTransition && direction) event.viewTransition.types.add(direction);
+    });
+
+    window.addEventListener('pagereveal', (event) => {
+      const direction = sessionStorage.getItem(DIRECTION_KEY);
+      if (event.viewTransition && direction) event.viewTransition.types.add(direction);
+      sessionStorage.removeItem(DIRECTION_KEY);
+    });
+  </script>
+
 </body>
 
