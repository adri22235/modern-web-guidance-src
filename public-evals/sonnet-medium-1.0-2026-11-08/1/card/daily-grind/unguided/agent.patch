+  <script>
+    const order = [];
+    const sizeNames = ['Small', 'Medium', 'Large'];
+    const countEl = document.getElementById('order-count');
+
+    document.querySelectorAll('.drink-card').forEach(card => {
+      const prices = card.dataset.prices.split(',').map(Number);
+      const priceEl = card.querySelector('.price');
+      const statusEl = card.querySelector('.status');
+      const selected = () => +card.querySelector('input:checked').value;
+
+      card.addEventListener('change', () => {
+        priceEl.textContent = '$' + prices[selected()].toFixed(2);
+        statusEl.textContent = '';
+        card.classList.remove('added');
+      });
+
+      card.querySelector('.add').addEventListener('click', () => {
+        const i = selected();
+        order.push({ name: card.dataset.name, size: sizeNames[i], price: prices[i] });
+        countEl.textContent = order.length;
+        statusEl.textContent = 'Added ' + sizeNames[i] + ' ' + card.dataset.name + ' to your order.';
+        card.classList.add('added');
+      });
+    });
+  </script>
+
