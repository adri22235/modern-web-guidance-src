+  <script>
+    const order = [];
+    const status = document.querySelector('.order-status');
+
+    document.querySelectorAll('.card .add-to-order').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const card = btn.closest('.card');
+        const size = card.querySelector('input[type="radio"]:checked');
+        order.push({ drink: card.dataset.drink, size: size.value, price: Number(size.dataset.price) });
+        const total = order.reduce((sum, item) => sum + item.price, 0);
+        status.textContent = `Added ${size.value} ${card.dataset.drink}. ${order.length} item(s) in your order, $${total.toFixed(2)} total.`;
+      });
+    });
+  </script>
