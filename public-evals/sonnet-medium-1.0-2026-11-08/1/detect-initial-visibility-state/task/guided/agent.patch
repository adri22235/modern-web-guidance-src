+  <script>
+    // Detect whether the page was initially loaded in a background tab.
+    (function () {
+      const fallbackNote = 'document.visibilityState fallback is unreliable for async scripts: ' +
+        'if the tab was foregrounded before this script ran, the initial hidden state is missed.';
+
+      const entries = 'VisibilityStateEntry' in window
+        ? performance.getEntriesByType('visibility-state')
+        : [];
+
+      if (entries.length > 0) {
+        // The performance timeline records visibility regardless of when this script executes.
+        console.log({
+          backgrounded: entries[0].name === 'hidden',
+          timestamp: Date.now()
+        });
+      } else {
+        console.log({
+          backgrounded: document.visibilityState === 'hidden',
+          timestamp: Date.now(),
+          note: fallbackNote
+        });
+      }
+    })();
+  </script>
