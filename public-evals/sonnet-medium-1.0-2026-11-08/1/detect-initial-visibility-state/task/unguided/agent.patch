diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -152,8 +152,30 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
   </style>
+
+  <script>
+    // Runs synchronously in <head> so visibility is sampled as early as possible.
+    (function () {
+      var hasVisibilityState = typeof document.visibilityState === 'string';
+      var backgrounded = hasVisibilityState
+        ? document.visibilityState === 'hidden'
+        : document.hidden === true;
+
+      var info = {
+        backgrounded: backgrounded,
+        timestamp: Date.now()
+      };
+
+      if (!hasVisibilityState) {
+        info.note = 'Fallback check (document.hidden) used; it is unreliable for async/deferred scripts ' +
+          'because the tab may have changed visibility before the script ran.';
+      }
+
+      console.log('[Daily Grind] Initial page load visibility', info);
+    })();
+  </script>
 </head>
 
 <body>
 
