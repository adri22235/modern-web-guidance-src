   <title>The Daily Grind | Artisanal Coffee</title>
+  <link rel="manifest" href="/manifest.webmanifest">
+  <meta name="theme-color" content="#4e342e">
+  <script>
+    // Origin migration. Set NEW_ORIGIN (e.g. 'https://grind.example.com') to enable.
+    // Old origin: redirect, carrying localStorage in the URL hash (never sent to servers).
+    // New origin: import that data once, then clean the URL.
+    (function () {
+      var NEW_ORIGIN = '';
+      var KEY = 'migrate=';
+      try {
+        if (location.hash.indexOf('#' + KEY) === 0) {
+          var data = JSON.parse(decodeURIComponent(escape(atob(location.hash.slice(KEY.length + 1)))));
+          Object.keys(data).forEach(function (k) {
+            if (localStorage.getItem(k) === null) localStorage.setItem(k, data[k]);
+          });
+          history.replaceState(null, '', location.pathname + location.search);
+        } else if (NEW_ORIGIN && location.origin !== NEW_ORIGIN) {
+          var out = {};
+          for (var i = 0; i < localStorage.length; i++) {
+            var k = localStorage.key(i);
+            out[k] = localStorage.getItem(k);
+          }
+          var payload = btoa(unescape(encodeURIComponent(JSON.stringify(out))));
+          location.replace(NEW_ORIGIN + location.pathname + location.search + '#' + KEY + payload);
+        }
+      } catch (e) { /* never block page load */ }
+    })();
+  </script>
   <style>
     :root {
       --primary: #4e342e;
