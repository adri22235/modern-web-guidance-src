+  <script>
+    const emailInput = document.getElementById('mailing-email');
+    const syncAriaInvalid = () => {
+      if (emailInput.matches(':user-invalid')) emailInput.setAttribute('aria-invalid', 'true');
+      else emailInput.removeAttribute('aria-invalid');
+    };
+    emailInput.addEventListener('blur', syncAriaInvalid);
+    emailInput.addEventListener('invalid', syncAriaInvalid);
+    emailInput.addEventListener('input', () => {
+      if (emailInput.hasAttribute('aria-invalid')) syncAriaInvalid();
+    });
+  </script>
