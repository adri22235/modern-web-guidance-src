@@ -206,7 +281,51 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      var form = document.getElementById('mailing-list');
+      var input = document.getElementById('email');
+      var error = document.getElementById('email-error');
+      var success = document.getElementById('email-success');
+      var touched = false;
+
+      function validate() {
+        var message = '';
+        if (!input.value.trim()) message = 'Please enter your email address.';
+        else if (!input.validity.valid) message = 'Please enter a valid email address.';
+        // Stay neutral until the user has interacted with the field or tried to submit
+        var show = touched && message;
+        input.classList.toggle('invalid', !!show);
+        if (show) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+        error.textContent = show ? message : '';
+        return !message;
+      }
+
+      input.addEventListener('blur', function () {
+        touched = true;
+        validate();
+      });
+      input.addEventListener('input', function () {
+        success.hidden = true;
+        if (touched) validate();
+      });
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        touched = true;
+        if (!validate()) {
+          input.focus();
+          return;
+        }
+        form.reset();
+        touched = false;
+        validate();
+        success.hidden = false;
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
