+  <dialog id="feedback-modal" aria-labelledby="feedback-title" closedby="any">
+    <form method="dialog">
+      <h2 id="feedback-title">Send us feedback</h2>
+      <p class="modal-location">Currently in <span id="modal-location">the main content</span>.</p>
+      <label for="feedback-name">Name</label>
+      <input id="feedback-name" name="name" autocomplete="name">
+      <label for="feedback-message">Message</label>
+      <textarea id="feedback-message" name="message" required autofocus></textarea>
+      <div class="modal-actions">
+        <button type="button" id="move-modal">Move</button>
+        <button value="cancel" formnovalidate>Close</button>
+        <button value="send">Send</button>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    const modal = document.getElementById('feedback-modal');
+    const moveBtn = document.getElementById('move-modal');
+    const locationLabel = document.getElementById('modal-location');
+    const sections = ['section-hero', 'section-main', 'section-footer'].map(id => document.getElementById(id));
+
+    // Open the modal inside <main> so there is somewhere to start from.
+    document.getElementById('section-main').append(modal);
+
+    moveBtn.addEventListener('click', () => {
+      const i = sections.indexOf(modal.parentElement);
+      const target = sections[(i + 1) % sections.length];
+      const focused = document.activeElement;
+
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: the modal stays open, in the top layer, and keeps focus.
+        target.moveBefore(modal, null);
+      } else {
+        // Fallback: a normal move closes the dialog, so reopen it.
+        target.append(modal);
+        if (!modal.open) modal.showModal();
+        if (focused && modal.contains(focused)) focused.focus();
+      }
+      locationLabel.textContent = target.dataset.label;
+    });
+  </script>
+
