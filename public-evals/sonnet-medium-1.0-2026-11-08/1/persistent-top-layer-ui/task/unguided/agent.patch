+  <button type="button" class="btn feedback-fab" id="feedback-open">Feedback</button>
+
+  <div class="modal-overlay" id="feedback-overlay" hidden>
+    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="feedback-title" tabindex="-1">
+      <div class="modal-header">
+        <h2 id="feedback-title">Send us feedback</h2>
+        <button type="button" class="btn secondary" id="feedback-close" aria-label="Close feedback">&times;</button>
+      </div>
+      <p class="modal-location">Currently in: <strong id="feedback-location"></strong></p>
+      <form id="feedback-form">
+        <label>Name
+          <input type="text" name="name" autocomplete="name">
+        </label>
+        <label>Your feedback
+          <textarea name="message" rows="4" required></textarea>
+        </label>
+        <div class="modal-actions">
+          <button type="submit" class="btn">Send</button>
+          <button type="button" class="btn secondary" id="feedback-move">Move</button>
+        </div>
+        <p class="modal-status" role="status" aria-live="polite"></p>
+      </form>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      var overlay = document.getElementById('feedback-overlay');
+      var modal = overlay.querySelector('.modal');
+      var openBtn = document.getElementById('feedback-open');
+      var form = document.getElementById('feedback-form');
+      var status = form.querySelector('.modal-status');
+      var label = document.getElementById('feedback-location');
+      var sections = ['section-hero', 'section-main', 'section-footer']
+        .map(function (id) { return document.getElementById(id); });
+      var lastFocus = null;
+
+      function currentIndex() {
+        var i = sections.indexOf(overlay.parentElement);
+        return i < 0 ? 0 : i;
+      }
+
+      function updateLabel() {
+        label.textContent = overlay.parentElement.dataset.label || 'Page';
+      }
+
+      function open() {
+        lastFocus = document.activeElement;
+        overlay.hidden = false;
+        modal.querySelector('textarea').focus();
+      }
+
+      function close() {
+        overlay.hidden = true;
+        if (lastFocus && lastFocus.focus) lastFocus.focus();
+      }
+
+      // Reparent the overlay while keeping it open: form values, scroll position
+      // and focus are preserved. moveBefore() keeps focus natively; otherwise
+      // reinsert and restore it manually.
+      function move() {
+        var target = sections[(currentIndex() + 1) % sections.length];
+        var active = document.activeElement;
+        var hadFocus = overlay.contains(active);
+        var sel = hadFocus && 'selectionStart' in active
+          ? [active.selectionStart, active.selectionEnd] : null;
+        var scroll = modal.scrollTop;
+
+        if (typeof target.moveBefore === 'function') {
+          target.moveBefore(overlay, null);
+        } else {
+          target.appendChild(overlay);
+        }
+
+        modal.scrollTop = scroll;
+        if (hadFocus && document.activeElement !== active) {
+          active.focus({ preventScroll: true });
+          if (sel) active.setSelectionRange(sel[0], sel[1]);
+        } else if (!hadFocus) {
+          modal.focus();
+        }
+        updateLabel();
+        status.textContent = 'Moved to: ' + label.textContent;
+      }
+
+      openBtn.addEventListener('click', open);
+      document.getElementById('feedback-close').addEventListener('click', close);
+      document.getElementById('feedback-move').addEventListener('click', move);
+
+      overlay.addEventListener('mousedown', function (e) {
+        if (e.target === overlay) close();
+      });
+
+      document.addEventListener('keydown', function (e) {
+        if (overlay.hidden) return;
+        if (e.key === 'Escape') { close(); return; }
+        if (e.key !== 'Tab') return;
+        var items = modal.querySelectorAll('button, input, textarea, [href]');
+        var first = items[0], last = items[items.length - 1];
+        if (!modal.contains(document.activeElement)) {
+          e.preventDefault();
+          first.focus();
+        } else if (e.shiftKey && document.activeElement === first) {
+          e.preventDefault();
+          last.focus();
+        } else if (!e.shiftKey && document.activeElement === last) {
+          e.preventDefault();
+          first.focus();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        form.reset();
+        status.textContent = 'Thanks for your feedback!';
+      });
+
+      // Start in the main section.
+      sections[1].appendChild(overlay);
+      updateLabel();
+    })();
+  </script>
+
 </body>
 
