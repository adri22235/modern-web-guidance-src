+  <script>
+    // Replace with the real ordering origin and the site's registrable domain.
+    const ORDERING_URL = 'https://order.thedailygrind.example';
+    const SITE_DOMAIN = 'thedailygrind.example';
+    const HAS_ORIGIN_API = 'Origin' in globalThis;
+
+    function toUrl(candidate) {
+      if (typeof candidate === 'string') return new URL(candidate, location.href);
+      if (candidate instanceof MessageEvent) return new URL(candidate.origin);
+      return new URL(candidate.href, location.href);
+    }
+
+    function toOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        if (candidate instanceof MessageEvent) return Origin.from(candidate.origin);
+        if (typeof candidate === 'string') return Origin.from(new URL(candidate, location.href));
+        throw err;
+      }
+    }
+
+    // Exact (scheme, host, port) match; opaque "null" origins never match.
+    function isSameOriginAs(candidate, trustedUrl) {
+      try {
+        if (HAS_ORIGIN_API) return toOrigin(candidate).isSameOrigin(Origin.from(trustedUrl));
+        const url = toUrl(candidate);
+        return url.origin !== 'null' && url.origin === new URL(trustedUrl).origin;
+      } catch {
+        return false;
+      }
+    }
+
+    // Schemeful same-site as this page (uses the Public Suffix List where available).
+    function isSameSiteUrl(candidate) {
+      try {
+        if (HAS_ORIGIN_API) return toOrigin(candidate).isSameSite(Origin.from(self));
+        const url = toUrl(candidate);
+        return url.origin !== 'null' &&
+          url.protocol === location.protocol &&
+          (url.hostname === SITE_DOMAIN || url.hostname.endsWith(`.${SITE_DOMAIN}`));
+      } catch {
+        return false;
+      }
+    }
+
+    // Messages from the trusted ordering origin
+    window.addEventListener('message', (event) => {
+      if (event.source === widgetFrame.contentWindow) return; // handled below
+      if (!isSameOriginAs(event, ORDERING_URL)) return;
+      if (event.data?.type === 'redirect' && typeof event.data.url === 'string') {
+        redirectIfSameSite(event.data.url);
+      }
+    });
+
+    // Same-site redirects only (e.g. ?returnTo=...)
+    function redirectIfSameSite(target) {
+      if (isSameSiteUrl(target)) location.assign(new URL(target, location.href));
+    }
+
+    const returnTo = new URLSearchParams(location.search).get('returnTo');
+    if (returnTo) redirectIfSameSite(returnTo);
+
+    // Harden external links
+    document.querySelectorAll('a[href]').forEach((a) => {
+      if (!isSameSiteUrl(a)) {
+        a.rel = 'noopener noreferrer';
+        a.target = '_blank';
+      }
+    });
+
+    // Sandboxed widget: pin its opaque origin on init, then accept only that sender.
+    const widgetFrame = document.getElementById('rewards-widget');
+    let pinnedWidgetOrigin = HAS_ORIGIN_API ? new Origin() : null;
+    let widgetPinned = false;
+
+    function isTrustedWidgetMessage(event) {
+      if (event.source !== widgetFrame.contentWindow) return false;
+      if (!HAS_ORIGIN_API) return true; // no opaque identity available; source check only
+      try {
+        const sender = Origin.from(event);
+        if (!widgetPinned && event.data?.type === 'init') {
+          pinnedWidgetOrigin = sender;
+          widgetPinned = true;
+        }
+        return sender.isSameOrigin(pinnedWidgetOrigin);
+      } catch {
+        return false;
+      }
+    }
+
+    window.addEventListener('message', (event) => {
+      if (event.source !== widgetFrame.contentWindow) return;
+      if (!isTrustedWidgetMessage(event)) return;
+      // Handle verified widget messages here.
+    });
+  </script>
