@@ -207,6 +207,86 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <iframe id="order-widget" title="Order widget" sandbox="allow-scripts" hidden></iframe>
+
+  <script>
+    (function () {
+      'use strict';
+
+      var ORDERING_ORIGIN = 'https://order.thedailygrind.example';
+      var widgetFrame = document.getElementById('order-widget');
+      var pinnedWidget = null; // contentWindow of the sandboxed widget, set on init
+
+      function parseHttpUrl(value) {
+        if (typeof value !== 'string') return null;
+        try {
+          var url = new URL(value, window.location.href);
+          return (url.protocol === 'http:' || url.protocol === 'https:') ? url : null;
+        } catch (e) {
+          return null;
+        }
+      }
+
+      // Same-site: parsed origin must equal ours (no string splitting/prefix checks).
+      function isSameSiteUrl(value) {
+        var url = parseHttpUrl(value);
+        return !!url && url.origin === window.location.origin;
+      }
+
+      function isSafeExternalUrl(value) {
+        return parseHttpUrl(value) !== null;
+      }
+
+      function redirectSameSite(value) {
+        if (!isSameSiteUrl(value)) return false;
+        window.location.assign(parseHttpUrl(value).href);
+        return true;
+      }
+
+      // Sandboxed iframes (no allow-same-origin) report origin "null", so identify
+      // them by event.source: pin the widget on init, then only accept that window.
+      function isTrustedWidgetMessage(event) {
+        if (event.origin !== 'null' || !event.source) return false;
+        var data = event.data;
+        if (pinnedWidget) return event.source === pinnedWidget;
+        if (widgetFrame && event.source === widgetFrame.contentWindow &&
+            data && data.type === 'widget:init') {
+          pinnedWidget = event.source;
+          return true;
+        }
+        return false;
+      }
+
+      window.addEventListener('message', function (event) {
+        var data = event.data;
+        if (!data || typeof data !== 'object') return;
+
+        if (event.origin === ORDERING_ORIGIN) {
+          if (data.type === 'order:redirect') redirectSameSite(data.url);
+          return;
+        }
+
+        if (isTrustedWidgetMessage(event) && data.type === 'widget:redirect') {
+          redirectSameSite(data.url);
+        }
+      });
+
+      // Harden external links; neutralise unsafe schemes such as javascript:.
+      document.addEventListener('click', function (event) {
+        var link = event.target.closest && event.target.closest('a[href]');
+        if (!link) return;
+        var url = parseHttpUrl(link.getAttribute('href'));
+        if (!url) {
+          event.preventDefault();
+          return;
+        }
+        if (url.origin !== window.location.origin) {
+          link.rel = 'noopener noreferrer';
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
