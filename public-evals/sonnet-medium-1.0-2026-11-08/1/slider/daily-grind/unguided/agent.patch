+    /* Brew Strength Slider */
+    .strength {
+      max-width: 600px;
+      margin: 0 auto 50px;
+      background: white;
+      padding: 24px 28px 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
