+  <script>
+    (function () {
+      var slider = document.getElementById('strength-slider');
+      var value = document.getElementById('strength-value');
+      var labels = document.querySelectorAll('#strength-labels li');
+      var names = ['Mild', 'Medium', 'Bold', 'Extra Bold'];
+
+      function update() {
+        var i = Number(slider.value);
+        var pct = (i / (names.length - 1)) * 100;
+        // Compensate so the fill ends at the thumb centre
+        var thumb = 28;
+        slider.style.setProperty('--fill', 'calc(' + pct + '% + ' + (thumb / 2 - (pct / 100) * thumb) + 'px)');
+        value.textContent = names[i];
+        slider.setAttribute('aria-valuetext', names[i]);
+        labels.forEach(function (l, n) { l.classList.toggle('active', n === i); });
+      }
+
+      labels.forEach(function (l, n) {
+        l.addEventListener('click', function () { slider.value = n; update(); });
+      });
+      slider.addEventListener('input', update);
+      update();
+    })();
+  </script>
 </body>
 
