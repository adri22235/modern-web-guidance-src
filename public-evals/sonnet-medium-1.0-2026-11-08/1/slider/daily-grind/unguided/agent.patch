+      margin: 8px 0 16px;
+    }
+
+    .strength-slider {
+      --fill: 0%;
+      --track-h: 10px;
+      --thumb: 28px;
+      -webkit-appearance: none;
+      appearance: none;
+      width: 100%;
+      height: var(--thumb);
+      background: transparent;
+      cursor: pointer;
+    }
+
+    .strength-slider:focus {
+      outline: none;
+    }
+
+    .strength-slider::-webkit-slider-runnable-track {
+      height: var(--track-h);
+      border-radius: 999px;
+      background: linear-gradient(to right, var(--primary) var(--fill), var(--secondary) var(--fill));
+    }
+
+    .strength-slider::-moz-range-track {
+      height: var(--track-h);
+      border-radius: 999px;
+      background: var(--secondary);
+    }
+
+    .strength-slider::-moz-range-progress {
+      height: var(--track-h);
+      border-radius: 999px;
+      background: var(--primary);
+    }
+
+    .strength-slider::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      width: var(--thumb);
+      height: var(--thumb);
+      margin-top: calc((var(--track-h) - var(--thumb)) / 2);
+      border-radius: 50%;
+      background: var(--accent);
+      border: 4px solid var(--primary);
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    .strength-slider::-moz-range-thumb {
+      width: calc(var(--thumb) - 8px);
+      height: calc(var(--thumb) - 8px);
+      border-radius: 50%;
+      background: var(--accent);
+      border: 4px solid var(--primary);
+      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    .strength-slider:hover::-webkit-slider-thumb,
+    .strength-slider:active::-webkit-slider-thumb {
+      transform: scale(1.1);
+    }
+
+    .strength-slider:hover::-moz-range-thumb,
+    .strength-slider:active::-moz-range-thumb {
+      transform: scale(1.1);
+    }
+
+    .strength-slider:focus-visible::-webkit-slider-thumb {
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.5);
+    }
+
+    .strength-slider:focus-visible::-moz-range-thumb {
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.5);
+    }
+
+    .strength-labels {
