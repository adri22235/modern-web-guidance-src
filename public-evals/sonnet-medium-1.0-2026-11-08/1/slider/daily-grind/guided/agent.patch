+  <script>
+    const strengths = [
+      { name: 'Mild', desc: 'Light and delicate, with bright, gentle flavors.' },
+      { name: 'Medium', desc: 'Balanced and smooth: our everyday house brew.' },
+      { name: 'Bold', desc: 'Rich and full-bodied with a lingering finish.' },
+      { name: 'Extra Bold', desc: 'Intense, dark, and unapologetically strong.' }
+    ];
+    const slider = document.querySelector('#brew-strength');
+    const valueOut = document.querySelector('#strength-value');
+    const descOut = document.querySelector('#strength-desc');
+    const stepLabels = document.querySelectorAll('.strength-steps li');
+
+    function syncStrength() {
+      const { name, desc } = strengths[slider.value];
+      slider.style.setProperty('--attr-min', slider.min);
+      slider.style.setProperty('--attr-max', slider.max);
+      slider.style.setProperty('--control-value', slider.value);
+      slider.setAttribute('aria-valuetext', name);
+      valueOut.textContent = name;
+      descOut.textContent = desc;
+      stepLabels.forEach((li, i) => li.setAttribute('aria-current', String(i === +slider.value)));
+    }
+
+    syncStrength();
+    slider.addEventListener('input', syncStrength);
+  </script>
