+/* The Daily Grind — homepage styles
+   Cascade order is declared up front; later layers win regardless of specificity. */
+@layer reset, tokens, base, layout, components, utilities;
+
+/* ---------- Design tokens ---------- */
+@layer tokens {
+  :root {
+    /* Color: palette */
+    --color-brown-900: #3e2723;
+    --color-brown-700: #4e342e;
+    --color-sand-300: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-offwhite: #fafafa;
+    --color-black: #000;
+
+    /* Color: semantic */
+    --color-primary: var(--color-brown-700);
+    --color-primary-hover: var(--color-brown-900);
+    --color-secondary: var(--color-sand-300);
+    --color-accent: var(--color-amber-400);
+    --color-text: var(--color-brown-900);
+    --color-text-inverse: var(--color-white);
+    --color-surface: var(--color-white);
+    --color-background: var(--color-offwhite);
+    --color-overlay: rgb(0 0 0 / 0.5);
+    --color-shadow: rgb(0 0 0 / 0.1);
+
+    /* Typography */
+    --font-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-xs: 0.85rem;
+    --font-size-sm: 0.9rem;
+    --font-size-lg: 1.5rem;
+    --font-size-hero: 3rem;
+    --line-height-base: 1.6;
+    --letter-spacing-logo: 1px;
+
+    /* Spacing scale */
+    --space-1: 0.3125rem; /* 5px */
+    --space-2: 0.625rem;  /* 10px */
+    --space-3: 0.75rem;   /* 12px */
+    --space-4: 1rem;
+    --space-5: 1.25rem;   /* 20px */
+    --space-6: 2.5rem;    /* 40px */
+    --gutter-nav: 5%;
+
+    /* Shape, elevation, motion */
+    --radius-sm: 4px;
+    --radius-md: 5px;
+    --radius-lg: 8px;
+    --shadow-card: 0 2px 5px var(--color-shadow);
+    --transition-base: 0.3s;
+
+    /* Layout */
+    --container-max: 1100px;
+    --card-min: 250px;
+    --hero-height: 60vh;
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+    --z-sticky: 1000;
+  }
+}
+
+/* ---------- Reset ---------- */
+@layer reset {
+  *,
+  *::before,
+  *::after {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+}
+
+/* ---------- Base elements ---------- */
+@layer base {
+  body {
+    font-family: var(--font-sans);
+    line-height: var(--line-height-base);
+    color: var(--color-text);
+    background-color: var(--color-background);
+  }
+
+  :is(nav, footer) a {
+    text-decoration: none;
+  }
+}
+
+/* ---------- Layout ---------- */
+@layer layout {
+  .container {
+    max-inline-size: var(--container-max);
+    margin-block: var(--space-6);
+    margin-inline: auto;
+    padding-inline: var(--space-5);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(var(--card-min), 1fr));
+    gap: var(--space-5);
+    margin-block-start: var(--space-5);
+  }
+}
+
+/* ---------- Components ---------- */
+@layer components {
+  /* Navigation */
+  nav {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--z-sticky);
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding-block: var(--space-4);
+    padding-inline: var(--gutter-nav);
+    background: var(--color-primary);
+    color: var(--color-text-inverse);
+
+    & .logo {
+      font-size: var(--font-size-lg);
+      font-weight: bold;
+      letter-spacing: var(--letter-spacing-logo);
+    }
+
+    & ul {
+      display: flex;
+      gap: var(--space-5);
+      list-style: none;
+    }
+
+    & a {
+      color: var(--color-text-inverse);
+      font-size: var(--font-size-sm);
+      transition: color var(--transition-base);
+
+      &:hover {
+        color: var(--color-accent);
+      }
+    }
+
+    & .logout-link {
+      padding-block: var(--space-1);
+      padding-inline: var(--space-3);
+      border: 1px solid var(--color-accent);
+      border-radius: var(--radius-sm);
+    }
+  }
+
+  /* Hero */
+  .hero {
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-block-size: var(--hero-height);
+    padding-inline: var(--space-5);
+    background:
+      linear-gradient(var(--color-overlay), var(--color-overlay)),
+      var(--hero-image) center / cover;
+    color: var(--color-text-inverse);
+    text-align: center;
+
+    & h1 {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-4);
+    }
+  }
+
+  /* Cards */
+  .card {
+    padding: var(--space-5);
+    background: var(--color-surface);
+    border-radius: var(--radius-lg);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & h3 {
+      margin-block-end: var(--space-2);
+      color: var(--color-primary);
+    }
+  }
+
+  .btn {
+    display: inline-block;
+    margin-block-start: var(--space-4);
+    padding-block: var(--space-2);
+    padding-inline: var(--space-5);
+    background: var(--color-primary);
+    color: var(--color-text-inverse);
+    text-decoration: none;
+    border-radius: var(--radius-md);
+    transition: background var(--transition-base);
+
+    &:hover {
+      background: var(--color-primary-hover);
+    }
+  }
+
+  /* Footer */
+  footer {
+    margin-block-start: var(--space-6);
+    padding-block: var(--space-6);
+    padding-inline: var(--space-5);
+    background: var(--color-secondary);
+    text-align: center;
+
+    & .footer-links {
+      margin-block-end: var(--space-5);
+
+      & a {
+        margin-inline: var(--space-2);
+        color: var(--color-text);
+        font-size: var(--font-size-xs);
+      }
+    }
+  }
+}
+
+/* ---------- Utilities ---------- */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
