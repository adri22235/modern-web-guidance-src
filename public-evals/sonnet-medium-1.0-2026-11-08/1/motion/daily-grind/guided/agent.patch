+  <script>
+    // Drink details overlay
+    const dialog = document.getElementById('drink-dialog');
+
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function closeDialog() {
+      if (!dialog.open) return;
+      if (!(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay())) {
+        dialog.setAttribute('data-closing', '');
+        const animations = dialog.getAnimations({ subtree: true });
+        if (animations.length) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!dialog.hasAttribute('data-closing')) return;
+        dialog.removeAttribute('data-closing');
+      }
+      dialog.close();
+    }
+
+    document.querySelectorAll('[data-drink]').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        document.getElementById('drink-title').textContent = btn.dataset.drink;
+        document.getElementById('drink-desc').textContent = btn.dataset.desc;
+        document.getElementById('drink-meta').textContent = btn.dataset.meta;
+        dialog.removeAttribute('data-closing');
+        dialog.showModal();
+      });
+    });
+    document.getElementById('drink-close').addEventListener('click', closeDialog);
+    // Route Esc / light dismiss through the animated close
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('click', (e) => {
+      if (e.target !== dialog) return;
+      const r = dialog.getBoundingClientRect();
+      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) closeDialog();
+    });
+
+    // Daily roast banner pause / resume
+    const banner = document.querySelector('.roast-banner');
+    const toggle = banner.querySelector('.banner-toggle');
+    toggle.addEventListener('click', () => {
+      const paused = banner.classList.toggle('paused');
+      toggle.setAttribute('aria-pressed', String(paused));
+      toggle.textContent = paused ? 'Resume' : 'Pause';
+    });
+
+    // Record the last animation/transition state, read from event.animation
+    function recordState(event) {
+      let animation = event.animation;
+      if (!animation && event.target.getAnimations) {
+        // Fallback for browsers without event.animation
+        animation = event.target.getAnimations().find((a) =>
+          a.animationName === event.animationName || a.transitionProperty === event.propertyName);
+      }
+      const name = animation?.animationName ?? animation?.transitionProperty ?? event.animationName ?? event.propertyName;
+      const pseudo = animation?.effect?.pseudoElement ?? '';
+      const state = animation?.playState ?? 'unknown';
+      document.body.dataset.lastAnimationState = `${event.type}:${name}${pseudo}:${state}`;
+    }
+    ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+     'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']
+      .forEach((type) => document.addEventListener(type, recordState, true));
+  </script>
