+  <script>
+    (function () {
+      var body = document.body;
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      /* Animation state tracking: read the Animation object behind each event */
+      function findAnimation(event) {
+        if (event.animation) return event.animation; // if the browser exposes it directly
+        var target = event.target;
+        if (!target || typeof target.getAnimations !== 'function') return null;
+        var anims = target.getAnimations({ subtree: false });
+        if (event.type.indexOf('animation') === 0) {
+          return anims.find(function (a) { return a.animationName === event.animationName; }) || null;
+        }
+        return anims.find(function (a) { return a.transitionProperty === event.propertyName; }) || null;
+      }
+
+      function record(event) {
+        var anim = findAnimation(event);
+        var kind = event.type.indexOf('animation') === 0 ? 'animation' : 'transition';
+        var name = kind === 'animation' ? event.animationName : event.propertyName;
+        // After end/cancel the Animation may already be gone; fall back to the event itself
+        var playState = anim ? anim.playState : (/end$/.test(event.type) ? 'finished' : /cancel$/.test(event.type) ? 'idle' : 'running');
+        var timing = anim && anim.effect ? anim.effect.getComputedTiming() : null;
+        var state = {
+          event: event.type,
+          kind: kind,
+          name: name,
+          playState: playState,
+          duration: timing ? timing.duration : null,
+          target: event.target.id || event.target.className || event.target.tagName.toLowerCase()
+        };
+        body.setAttribute('data-last-animation-state', JSON.stringify(state));
+      }
+
+      ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+        'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel'
+      ].forEach(function (type) {
+        document.addEventListener(type, record, true);
+      });
+
+      /* Daily roast banner pause / resume */
+      var banner = document.getElementById('roast-banner');
+      var toggle = document.getElementById('roast-toggle');
+      toggle.addEventListener('click', function () {
+        var paused = banner.classList.toggle('is-paused');
+        toggle.textContent = paused ? 'Resume' : 'Pause';
+        toggle.setAttribute('aria-pressed', String(paused));
+        var track = banner.querySelector('.roast-track');
+        var anim = track.getAnimations()[0];
+        body.setAttribute('data-last-animation-state', JSON.stringify({
+          event: paused ? 'pause' : 'resume',
+          kind: 'animation',
+          name: anim ? anim.animationName : 'roast-scroll',
+          playState: anim ? anim.playState : (paused ? 'paused' : 'running'),
+          duration: anim && anim.effect ? anim.effect.getComputedTiming().duration : null,
+          target: 'roast-track'
+        }));
+      });
+
+      /* Drink details overlay */
+      var overlay = document.getElementById('drink-overlay');
+      var panel = overlay.querySelector('.overlay-panel');
+      var closeBtn = document.getElementById('overlay-close');
+      var lastTrigger = null;
+      var closeTimer = null;
+
+      function openOverlay(card, link) {
+        clearTimeout(closeTimer);
+        lastTrigger = link;
+        document.getElementById('overlay-title').textContent = card.querySelector('h3').textContent;
+        document.getElementById('overlay-desc').textContent = card.querySelector('p').textContent;
+        document.getElementById('overlay-link').setAttribute('href', link.getAttribute('href'));
+        overlay.setAttribute('aria-hidden', 'false');
+        // force a style flush so the opening transition always runs
+        void overlay.offsetWidth;
+        overlay.classList.add('is-open');
+        body.style.overflow = 'hidden';
+        closeBtn.focus({ preventScroll: true });
+      }
+
+      function finishClose() {
+        overlay.setAttribute('aria-hidden', 'true');
+        body.style.overflow = '';
+        if (lastTrigger) lastTrigger.focus({ preventScroll: true });
+      }
+
+      function closeOverlay() {
+        if (!overlay.classList.contains('is-open')) return;
+        overlay.classList.remove('is-open');
+        // Fallback in case no transition fires (e.g. reduced motion)
+        closeTimer = setTimeout(finishClose, reduceMotion.matches ? 50 : 450);
+      }
+
+      overlay.addEventListener('transitionend', function (e) {
+        if (e.target === overlay && e.propertyName === 'opacity' && !overlay.classList.contains('is-open')) {
+          clearTimeout(closeTimer);
+          finishClose();
+        }
+      });
+
+      document.querySelectorAll('.details-btn').forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          e.preventDefault();
+          openOverlay(link.closest('.card'), link);
+        });
+      });
+
+      closeBtn.addEventListener('click', closeOverlay);
+      overlay.addEventListener('click', function (e) {
+        if (!panel.contains(e.target)) closeOverlay();
+      });
+      document.addEventListener('keydown', function (e) {
+        if (!overlay.classList.contains('is-open')) return;
+        if (e.key === 'Escape') {
+          closeOverlay();
+        } else if (e.key === 'Tab') {
+          var f = panel.querySelectorAll('button, a[href]');
+          var first = f[0], last = f[f.length - 1];
+          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
+          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
+        }
+      });
+    })();
+  </script>
