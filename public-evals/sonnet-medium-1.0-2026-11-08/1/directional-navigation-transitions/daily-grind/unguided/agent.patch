+<script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      var cards = carousel.querySelectorAll('.card');
+      var status = document.getElementById('carousel-status');
+      var current = 0;
+
+      function show(index, direction) {
+        current = (index + cards.length) % cards.length;
+        cards.forEach(function (card, i) {
+          card.classList.remove('from-right', 'from-left');
+          card.hidden = i !== current;
+        });
+        var active = cards[current];
+        if (direction) {
+          void active.offsetWidth; // restart animation
+          active.classList.add(direction === 'next' ? 'from-right' : 'from-left');
+        }
+        status.textContent = (current + 1) + ' / ' + cards.length;
+      }
+
+      document.getElementById('carousel-next').addEventListener('click', function () {
+        show(current + 1, 'next');
+      });
+      document.getElementById('carousel-prev').addEventListener('click', function () {
+        show(current - 1, 'prev');
+      });
+      show(0);
+    })();
+  </script>
