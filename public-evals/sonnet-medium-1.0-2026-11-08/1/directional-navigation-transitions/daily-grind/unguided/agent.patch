+      font-size: 1rem;
+      margin-top: 0;
+    }
+
+    .carousel-status {
+      font-size: 0.9rem;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .carousel .card.from-right,
+      .carousel .card.from-left {
+        animation: none;
+      }
+    }
