+</Layout>
+<script>
+    const carousel = document.querySelector<HTMLElement>('[data-carousel]');
+    if (carousel) {
+        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
+        let current = 0;
+
+        function go(direction: 'forward' | 'backward') {
+            const step = direction === 'forward' ? 1 : -1;
+            const next = (current + step + slides.length) % slides.length;
+            const update = () => {
+                slides[current].hidden = true;
+                slides[next].hidden = false;
+                current = next;
+            };
+            if (!document.startViewTransition) {
+                update();
+                return;
+            }
+            document.startViewTransition({ update, types: [direction] });
+        }
+
+        carousel.querySelector('[data-next]')?.addEventListener('click', () => go('forward'));
+        carousel.querySelector('[data-prev]')?.addEventListener('click', () => go('backward'));
+    }
+</script>
+
+<style is:global>
+    /* Scope the transition to the carousel so the rest of the page stays still */
+    .top-story-viewport {
+        view-transition-name: top-story;
+    }
+
+    @keyframes slide-to-left { to { transform: translateX(-100%); } }
+    @keyframes slide-from-right { from { transform: translateX(100%); } }
+    @keyframes slide-to-right { to { transform: translateX(100%); } }
+    @keyframes slide-from-left { from { transform: translateX(-100%); } }
+
+    ::view-transition-group(top-story) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+        animation-fill-mode: both;
+        overflow: clip;
+    }
+
+    html:active-view-transition-type(forward)::view-transition-old(top-story) {
+        animation-name: slide-to-left;
+    }
+    html:active-view-transition-type(forward)::view-transition-new(top-story) {
+        animation-name: slide-from-right;
+    }
+    html:active-view-transition-type(backward)::view-transition-old(top-story) {
+        animation-name: slide-to-right;
+    }
+    html:active-view-transition-type(backward)::view-transition-new(top-story) {
+        animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        ::view-transition-group(top-story),
+        ::view-transition-old(top-story),
+        ::view-transition-new(top-story) {
+            animation: none !important;
+        }
+    }
+</style>
