diff --git a/src/components/TopStoriesCarousel.astro b/src/components/TopStoriesCarousel.astro
new file mode 100644
index 0000000..eee0f62
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,85 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<div class="top-stories-carousel flex items-center gap-3" data-carousel>
+    <button type="button" data-prev aria-label="Previous story"
+        class="shrink-0 rounded-full border border-gray-300 w-8 h-8 flex items-center justify-center text-gray-700 hover:text-amber-500 hover:border-amber-400 cursor-pointer">
+        <span aria-hidden="true">&#8249;</span>
+    </button>
+
+    <div class="relative flex-1 overflow-hidden" aria-live="polite">
+        <div class="grid">
+            {articles.map((article, i) => (
+                <div data-slide class="col-start-1 row-start-1" hidden={i !== 0} aria-hidden={i !== 0 ? 'true' : 'false'}>
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                    </a>
+                    <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                </div>
+            ))}
+        </div>
+    </div>
+
+    <span class="text-xs text-gray-500 shrink-0" data-counter>1 / {articles.length}</span>
+
+    <button type="button" data-next aria-label="Next story"
+        class="shrink-0 rounded-full border border-gray-300 w-8 h-8 flex items-center justify-center text-gray-700 hover:text-amber-500 hover:border-amber-400 cursor-pointer">
+        <span aria-hidden="true">&#8250;</span>
+    </button>
+</div>
+
+<script>
+    const DURATION = 350;
+
+    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
+        const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
+        const counter = root.querySelector<HTMLElement>('[data-counter]');
+        let current = 0;
+        let animating = false;
+
+        const show = (el: HTMLElement, visible: boolean) => {
+            el.hidden = !visible;
+            el.setAttribute('aria-hidden', String(!visible));
+        };
+
+        const go = (direction: 1 | -1) => {
+            if (animating || slides.length < 2) return;
+            const from = slides[current];
+            const next = (current + direction + slides.length) % slides.length;
+            const to = slides[next];
+            current = next;
+            if (counter) counter.textContent = `${next + 1} / ${slides.length}`;
+
+            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+                show(from, false);
+                show(to, true);
+                return;
+            }
+
+            animating = true;
+            show(to, true);
+            const opts: KeyframeAnimationOptions = { duration: DURATION, easing: 'ease-in-out', fill: 'both' };
+            // Next: new story enters from the right; Previous: from the left.
+            const outgoing = from.animate(
+                [{ transform: 'translateX(0)' }, { transform: `translateX(${-100 * direction}%)` }], opts);
+            const incoming = to.animate(
+                [{ transform: `translateX(${100 * direction}%)` }, { transform: 'translateX(0)' }], opts);
+            Promise.allSettled([outgoing.finished, incoming.finished]).then(() => {
+                show(from, false);
+                outgoing.cancel();
+                incoming.cancel();
+                animating = false;
+            });
+        };
+
+        root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
+        root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
+    });
+</script>
