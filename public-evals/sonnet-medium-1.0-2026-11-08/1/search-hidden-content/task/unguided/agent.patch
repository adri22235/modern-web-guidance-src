+  <script>
+    const tabs = document.querySelectorAll('.wholesale-tab');
+
+    function selectTab(selected) {
+      tabs.forEach(tab => {
+        const active = tab === selected;
+        const panel = document.getElementById(tab.getAttribute('aria-controls'));
+        tab.setAttribute('aria-selected', active);
+        if (active) panel.removeAttribute('hidden');
+        else panel.setAttribute('hidden', 'until-found');
+      });
+    }
+
+    tabs.forEach(tab => {
+      tab.addEventListener('click', () => selectTab(tab));
+      // Find-in-page reveals a hidden panel; sync tab state to match
+      document.getElementById(tab.getAttribute('aria-controls'))
+        .addEventListener('beforematch', () => selectTab(tab));
+    });
+
+    const couponBtn = document.getElementById('coupon-btn');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function setCoupon(open) {
+      if (open) couponPanel.removeAttribute('hidden');
+      else couponPanel.setAttribute('hidden', 'until-found');
+      couponBtn.setAttribute('aria-expanded', open);
+      couponBtn.textContent = open ? 'Hide Coupon' : 'Reveal Coupon';
+    }
+
+    couponBtn.addEventListener('click', () => setCoupon(couponPanel.hasAttribute('hidden')));
+    couponPanel.addEventListener('beforematch', () => setCoupon(true));
+  </script>
 </body>
 
