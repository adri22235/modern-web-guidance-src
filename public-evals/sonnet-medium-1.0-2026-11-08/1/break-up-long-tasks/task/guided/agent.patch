+  <script>
+    (() => {
+      const ORIGINS = [
+        { name: 'Ethiopia', acidity: 8, sweetness: 6, body: 3, bitterness: 2, aroma: 9 },
+        { name: 'Colombia', acidity: 6, sweetness: 7, body: 5, bitterness: 3, aroma: 6 },
+        { name: 'Brazil', acidity: 3, sweetness: 7, body: 6, bitterness: 4, aroma: 5 },
+        { name: 'Sumatra', acidity: 2, sweetness: 4, body: 9, bitterness: 6, aroma: 6 },
+        { name: 'Kenya', acidity: 9, sweetness: 5, body: 4, bitterness: 3, aroma: 8 },
+      ];
+      const TRAITS = ['acidity', 'sweetness', 'body', 'bitterness', 'aroma'];
+      const TARGET = { acidity: 5, sweetness: 6.5, body: 6, bitterness: 3, aroma: 7 };
+      const TOP_N = 5;
+
+      const $ = id => document.getElementById(id);
+      const form = $('sim-form'), runBtn = $('sim-run'), cancelBtn = $('sim-cancel');
+      const bar = $('sim-progress'), status = $('sim-status');
+      const summary = $('sim-summary'), table = $('sim-table');
+
+      let controller = null;
+
+      // Small seeded PRNG so runs are reproducible
+      function mulberry32(a) {
+        return () => {
+          a |= 0; a = (a + 0x6D2B79F5) | 0;
+          let t = Math.imul(a ^ (a >>> 15), 1 | a);
+          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      // Simulate one random blend: random origin ratios, roast shifts the profile
+      function simulateBlend(rand, roast) {
+        const w = ORIGINS.map(() => rand() ** 2);
+        const total = w.reduce((a, b) => a + b, 0) || 1;
+        const p = {};
+        for (const t of TRAITS) {
+          let v = 0;
+          for (let i = 0; i < ORIGINS.length; i++) v += ORIGINS[i][t] * w[i] / total;
+          p[t] = v;
+        }
+        p.acidity *= 1.2 - roast * 0.5;
+        p.aroma *= 1.1 - roast * 0.2;
+        p.body *= 0.8 + roast * 0.5;
+        p.bitterness *= 0.6 + roast * 1.0;
+        p.sweetness *= 1.1 - roast * 0.2;
+        let dist = 0;
+        for (const t of TRAITS) dist += (p[t] - TARGET[t]) ** 2;
+        p.score = Math.max(0, 100 - Math.sqrt(dist) * 12);
+        p.mix = ORIGINS.map((o, i) => `${Math.round(w[i] / total * 100)}% ${o.name}`).join(', ');
+        return p;
+      }
+
+      const yieldToMain = () =>
+        'scheduler' in window && 'yield' in scheduler
+          ? scheduler.yield()
+          : new Promise(resolve => setTimeout(resolve, 0));
+
+      async function runSimulation(count, roast, signal) {
+        const rand = mulberry32(42);
+        const sums = Object.fromEntries(TRAITS.map(t => [t, 0]));
+        let best = [], scoreSum = 0;
+        let deadline = performance.now() + 50;
+
+        for (let i = 0; i < count; i++) {
+          const b = simulateBlend(rand, roast);
+          for (const t of TRAITS) sums[t] += b[t];
+          scoreSum += b.score;
+          if (best.length < TOP_N || b.score > best[best.length - 1].score) {
+            best.push(b);
+            best.sort((x, y) => y.score - x.score);
+            if (best.length > TOP_N) best.pop();
+          }
+
+          // Yield every ~50ms so input and rendering are never blocked
+          if (performance.now() >= deadline) {
+            bar.value = (i / count) * 100;
+            status.textContent = `Processed ${i.toLocaleString()} of ${count.toLocaleString()} blends…`;
+            await yieldToMain();
+            if (signal.aborted) return null;
+            deadline = performance.now() + 50;
+          }
+        }
+        return { avg: Object.fromEntries(TRAITS.map(t => [t, sums[t] / count])), avgScore: scoreSum / count, best };
+      }
+
+      function render(r, count) {
+        summary.replaceChildren(...[...TRAITS.map(t => [t, r.avg[t].toFixed(2)]), ['avg score', r.avgScore.toFixed(1)]]
+          .map(([label, value]) => {
+            const d = document.createElement('div');
+            const s = document.createElement('strong');
+            s.textContent = value;
+            d.append(s, label);
+            return d;
+          }));
+        summary.hidden = false;
+        table.tBodies[0].replaceChildren(...r.best.map(b => {
+          const tr = document.createElement('tr');
+          for (const v of [b.mix, ...TRAITS.map(t => b[t].toFixed(1)), b.score.toFixed(1)]) {
+            const td = document.createElement('td');
+            td.textContent = v;
+            tr.append(td);
+          }
+          return tr;
+        }));
+        table.hidden = false;
+      }
+
+      form.addEventListener('submit', async e => {
+        e.preventDefault();
+        const count = Math.min(2000000, Math.max(1000, parseInt($('sim-count').value, 10) || 200000));
+        controller = new AbortController();
+        runBtn.disabled = true; cancelBtn.disabled = false;
+        bar.value = 0;
+        const start = performance.now();
+        try {
+          const result = await runSimulation(count, parseFloat($('sim-roast').value), controller.signal);
+          if (result) {
+            bar.value = 100;
+            render(result, count);
+            status.textContent = `Simulated ${count.toLocaleString()} blends in ${((performance.now() - start) / 1000).toFixed(1)}s.`;
+          } else {
+            status.textContent = 'Simulation cancelled.';
+          }
+        } finally {
+          runBtn.disabled = false; cancelBtn.disabled = true; controller = null;
+        }
+      });
+
+      cancelBtn.addEventListener('click', () => controller?.abort());
+    })();
+  </script>
 </body>
 
