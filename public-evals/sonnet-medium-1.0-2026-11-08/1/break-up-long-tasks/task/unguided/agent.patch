+  <script id="sim-worker" type="text/js-worker">
+    // Runs off the main thread so the page never blocks.
+    const ORIGINS = [
+      { name: 'Ethiopia',  w: { acidity: 8, body: 3, sweetness: 6, bitterness: 2, aroma: 9 } },
+      { name: 'Colombia',  w: { acidity: 6, body: 5, sweetness: 7, bitterness: 3, aroma: 6 } },
+      { name: 'Sumatra',   w: { acidity: 3, body: 9, sweetness: 4, bitterness: 6, aroma: 5 } },
+      { name: 'Brazil',    w: { acidity: 3, body: 6, sweetness: 8, bitterness: 4, aroma: 4 } },
+      { name: 'Kenya',     w: { acidity: 9, body: 4, sweetness: 5, bitterness: 3, aroma: 8 } }
+    ];
+    const ROASTS = [0.8, 1, 1.2]; // light, medium, dark
+    const TRAITS = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+    const TOP_N = 5;
+    let cancelled = false;
+
+    self.onmessage = (e) => {
+      if (e.data.type === 'cancel') { cancelled = true; return; }
+      if (e.data.type === 'start') { cancelled = false; run(e.data.count); }
+    };
+
+    function run(total) {
+      let seed = 123456789;
+      const rand = () => { // xorshift32
+        seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5;
+        return (seed >>> 0) / 4294967296;
+      };
+      const sums = new Float64Array(TRAITS.length);
+      let top = [];
+      const CHUNK = 20000;
+      let done = 0;
+      let lastPost = 0;
+
+      while (done < total) {
+        if (cancelled) { self.postMessage({ type: 'cancelled', done }); return; }
+        const end = Math.min(done + CHUNK, total);
+        for (; done < end; done++) {
+          // Random blend: weights per origin plus a roast level.
+          const ratios = ORIGINS.map(() => rand());
+          const rs = ratios.reduce((a, b) => a + b, 0);
+          const roast = Math.floor(rand() * 3);
+          const profile = new Array(TRAITS.length).fill(0);
+          for (let i = 0; i < ORIGINS.length; i++) {
+            const r = ratios[i] / rs;
+            for (let t = 0; t < TRAITS.length; t++) profile[t] += r * ORIGINS[i].w[TRAITS[t]];
+          }
+          profile[1] *= ROASTS[roast];      // body
+          profile[3] *= ROASTS[roast];      // bitterness
+          profile[0] /= ROASTS[roast];      // acidity
+          let score = 0;
+          for (let t = 0; t < TRAITS.length; t++) {
+            profile[t] = Math.min(10, profile[t]);
+            sums[t] += profile[t];
+            // Balanced cups score higher: reward sweetness/aroma, penalize bitterness.
+            score += t === 3 ? -profile[t] : profile[t];
+          }
+          if (top.length < TOP_N || score > top[top.length - 1].score) {
+            top.push({ score, roast, ratios: ratios.map(r => r / rs) });
+            top.sort((a, b) => b.score - a.score);
+            if (top.length > TOP_N) top.pop();
+          }
+        }
+        const now = Date.now();
+        if (now - lastPost > 50) {
+          lastPost = now;
+          self.postMessage({ type: 'progress', done, total });
+        }
+      }
+
+      self.postMessage({
+        type: 'done',
+        total,
+        averages: TRAITS.map((name, i) => ({ name, value: sums[i] / total })),
+        top: top.map(b => ({
+          score: b.score,
+          roast: ['Light', 'Medium', 'Dark'][b.roast],
+          mix: ORIGINS.map((o, i) => o.name + ' ' + Math.round(b.ratios[i] * 100) + '%').join(', ')
+        }))
+      });
+    }
+  </script>
+  <script>
+    (() => {
+      const form = document.getElementById('sim-form');
+      const countEl = document.getElementById('sim-count');
+      const runBtn = document.getElementById('sim-run');
+      const cancelBtn = document.getElementById('sim-cancel');
+      const bar = document.getElementById('sim-bar');
+      const progress = document.getElementById('sim-progress');
+      const status = document.getElementById('sim-status');
+      const results = document.getElementById('sim-results');
+      const topEl = document.getElementById('sim-top');
+      let worker = null;
+      let workerUrl = null;
+
+      const fmt = (n) => n.toLocaleString();
+      const setProgress = (pct) => {
+        bar.style.width = pct + '%';
+        progress.setAttribute('aria-valuenow', Math.round(pct));
+      };
+      const finish = () => {
+        if (worker) worker.terminate();
+        worker = null;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+      };
+
+      function render(data) {
+        results.replaceChildren();
+        data.averages.forEach((a) => {
+          const row = document.createElement('div');
+          row.className = 'flavor-row';
+          const label = document.createElement('span');
+          label.textContent = a.name[0].toUpperCase() + a.name.slice(1);
+          const track = document.createElement('div');
+          track.className = 'flavor-bar';
+          const fill = document.createElement('div');
+          fill.style.width = (a.value * 10) + '%';
+          track.appendChild(fill);
+          const val = document.createElement('span');
+          val.textContent = a.value.toFixed(2);
+          row.append(label, track, val);
+          results.appendChild(row);
+        });
+        topEl.replaceChildren();
+        data.top.forEach((b) => {
+          const li = document.createElement('li');
+          li.textContent = b.roast + ' roast: ' + b.mix + ' (score ' + b.score.toFixed(2) + ')';
+          topEl.appendChild(li);
+        });
+        topEl.hidden = false;
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const count = Math.min(5000000, Math.max(1, parseInt(countEl.value, 10) || 0));
+        if (!count) return;
+        countEl.value = count;
+        if (!workerUrl) {
+          const src = document.getElementById('sim-worker').textContent;
+          workerUrl = URL.createObjectURL(new Blob([src], { type: 'text/javascript' }));
+        }
+        try {
+          worker = new Worker(workerUrl);
+        } catch (err) {
+          status.textContent = 'Simulation is not supported in this browser.';
+          return;
+        }
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        results.replaceChildren();
+        topEl.hidden = true;
+        setProgress(0);
+        status.textContent = 'Simulating…';
+
+        worker.onmessage = (ev) => {
+          const m = ev.data;
+          if (m.type === 'progress') {
+            setProgress(m.done / m.total * 100);
+            status.textContent = 'Simulated ' + fmt(m.done) + ' of ' + fmt(m.total) + ' blends…';
+          } else if (m.type === 'done') {
+            setProgress(100);
+            status.textContent = 'Finished simulating ' + fmt(m.total) + ' blends.';
+            render(m);
+            finish();
+          } else if (m.type === 'cancelled') {
+            status.textContent = 'Cancelled after ' + fmt(m.done) + ' blends.';
+            finish();
+          }
+        };
+        worker.onerror = () => {
+          status.textContent = 'Simulation failed.';
+          finish();
+        };
+        worker.postMessage({ type: 'start', count });
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        if (!worker) return;
+        // The worker loop is synchronous, so terminate it rather than message it.
+        status.textContent = 'Cancelled.';
+        finish();
+      });
+    })();
+  </script>
+
 </body>
 
