+  <script>
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpStatus = document.getElementById('otp-status');
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    // Auto-fills from an SMS whose last line is "@<this-domain> #<code>" (WebOTP)
+    async function startSmsOtpListener() {
+      if (!('OTPCredential' in window)) return;
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+      try {
+        const otp = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: ac.signal });
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpForm.requestSubmit();
+      } catch (err) {
+        if (err && err.name !== 'AbortError') console.error('WebOTP error:', err);
+      }
+    }
+
+    otpForm.addEventListener('submit', stopSmsOtpListener);
+
+    document.getElementById('otp-resend').addEventListener('click', async () => {
+      otpStatus.textContent = 'Sending a new code…';
+      try {
+        const res = await fetch('/send-otp', { method: 'POST' });
+        if (!res.ok) throw new Error(res.statusText);
+        otpStatus.textContent = 'A new code is on its way.';
+        startSmsOtpListener();
+      } catch {
+        otpStatus.textContent = 'We couldn’t send a new code. Please try again.';
+      }
+    });
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+    startSmsOtpListener();
+  </script>
