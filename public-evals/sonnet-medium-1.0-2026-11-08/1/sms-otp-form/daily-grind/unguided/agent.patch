+  <script>
+    (function () {
+      var form = document.getElementById('otp-form');
+      var input = document.getElementById('otp-code');
+      var status = document.getElementById('otp-status');
+      var resend = document.getElementById('otp-resend');
+      var abort = null;
+
+      function setStatus(msg, type) {
+        status.textContent = msg;
+        status.className = 'status' + (type ? ' ' + type : '');
+      }
+
+      // Keep digits only (handles pasted "123 456" or "123-456")
+      input.addEventListener('input', function () {
+        input.value = input.value.replace(/\D/g, '').slice(0, 6);
+        input.removeAttribute('aria-invalid');
+        if (input.value.length === 6) form.requestSubmit();
+      });
+
+      // Automatic extraction from incoming SMS via WebOTP API.
+      // The SMS must end with a line like: "@example.com #123456"
+      function listenForSms() {
+        if (!('OTPCredential' in window)) return;
+        if (abort) abort.abort();
+        abort = new AbortController();
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: abort.signal })
+          .then(function (cred) {
+            if (!cred || !cred.code) return;
+            input.value = String(cred.code).replace(/\D/g, '').slice(0, 6);
+            setStatus('Code received automatically.');
+            form.requestSubmit();
+          })
+          .catch(function () { /* aborted or dismissed; manual entry still works */ });
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!/^\d{6}$/.test(input.value)) {
+          input.setAttribute('aria-invalid', 'true');
+          setStatus('Enter the 6-digit code from your text message.', 'error');
+          input.focus();
+          return;
+        }
+        setStatus('Verifying…');
+        fetch(form.action, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ code: input.value })
+        }).then(function (res) {
+          if (!res.ok) throw new Error('invalid');
+          if (abort) abort.abort();
+          setStatus('Phone verified. Thank you!', 'success');
+        }).catch(function () {
+          input.setAttribute('aria-invalid', 'true');
+          setStatus('That code didn’t work. Check it and try again.', 'error');
+          input.select();
+        });
+      });
+
+      resend.addEventListener('click', function () {
+        fetch('/api/send-otp', { method: 'POST' }).catch(function () { });
+        input.value = '';
+        setStatus('A new code is on its way.');
+        input.focus();
+        listenForSms();
+      });
+
+      listenForSms();
+    })();
+  </script>
 </body>
 
