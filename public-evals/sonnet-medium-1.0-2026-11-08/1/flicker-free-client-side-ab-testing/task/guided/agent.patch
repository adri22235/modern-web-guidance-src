diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,128 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Acme — Ship faster with less busywork</title>
+  <meta name="description" content="Acme helps teams plan, build, and ship faster.">
+
+  <!--
+    Experiment SDK: async + blocking="render" holds first paint until the script
+    has run, so users never see the original content before the variant.
+    onload/onerror lift the fallback hiding class (Firefox) and never leave the page blank.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+    onload="document.documentElement.classList.remove('ab-loading')"
+    onerror="document.documentElement.classList.remove('ab-loading')"
+  ></script>
+
+  <script>
+    // Fallback only for browsers without blocking="render" support.
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+  </script>
+
+  <style>
+    .ab-loading { opacity: 0 !important; }
+
+    :root {
+      color-scheme: light dark;
+      --bg: light-dark(#f7f8fc, #0d1020);
+      --fg: light-dark(#14172b, #eef0ff);
+      --muted: light-dark(#555b7a, #aab0d4);
+      --accent: #5b5bf0;
+      --accent-fg: #fff;
+    }
+
+    * { box-sizing: border-box; }
+
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+    }
+
+    header {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 1.25rem clamp(1rem, 5vw, 4rem);
+    }
+
+    .logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
+
+    .hero {
+      display: grid;
+      justify-items: center;
+      text-align: center;
+      gap: 1.5rem;
+      padding: clamp(3rem, 12vw, 9rem) clamp(1rem, 5vw, 4rem);
+      background:
+        radial-gradient(60rem 30rem at 50% -10%, color-mix(in srgb, var(--accent) 30%, transparent), transparent);
+    }
+
+    .hero h1 {
+      margin: 0;
+      max-width: 18ch;
+      font-size: clamp(2.25rem, 7vw, 4.5rem);
+      line-height: 1.05;
+      letter-spacing: -0.03em;
+      text-wrap: balance;
+    }
+
+    .hero p {
+      margin: 0;
+      max-width: 52ch;
+      font-size: clamp(1.05rem, 2.5vw, 1.35rem);
+      color: var(--muted);
+      text-wrap: pretty;
+    }
+
+    .cta-button {
+      display: inline-block;
+      padding: 0.9rem 2rem;
+      border-radius: 999px;
+      background: var(--accent);
+      color: var(--accent-fg);
+      font-size: 1.1rem;
+      font-weight: 700;
+      text-decoration: none;
+      transition: transform 0.15s, box-shadow 0.15s;
+    }
+
+    .cta-button:hover {
+      transform: translateY(-2px);
+      box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 45%, transparent);
+    }
+
+    .cta-button:focus-visible { outline: 3px solid var(--fg); outline-offset: 3px; }
+
+    @media (prefers-reduced-motion: reduce) {
+      .cta-button { transition: none; }
+      .cta-button:hover { transform: none; }
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <span class="logo">Acme</span>
+  </header>
+
+  <main>
+    <section class="hero" data-experiment="hero">
+      <h1 data-experiment="headline">Ship faster with less busywork</h1>
+      <p data-experiment="subhead">Acme brings planning, building, and shipping into one calm workspace, so your team can focus on what matters.</p>
+      <a class="cta-button" id="cta" data-experiment="cta" href="#signup">Get started free</a>
+    </section>
+  </main>
+</body>
+</html>
