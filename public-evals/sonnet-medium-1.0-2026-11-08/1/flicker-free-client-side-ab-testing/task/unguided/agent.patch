+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Launchpad – Ship your ideas faster</title>
+  <meta name="description" content="Launchpad helps teams go from idea to launch in days, not months.">
+
+  <!-- Anti-flicker: hide the page until the experiment SDK has applied its variant.
+       Reveals on SDK load + DOM ready, on load error, or after a timeout, so a slow
+       or blocked CDN can never leave the page blank. -->
+  <style id="anti-flicker">
+    html.af-hide body { opacity: 0 !important; }
+    html.af-hide.af-no-js body { opacity: 1 !important; }
+  </style>
+  <script>
+    (function (w, d) {
+      var root = d.documentElement;
+      var TIMEOUT_MS = 2000;
+      var sdkDone = false, domReady = false, revealed = false;
+
+      root.classList.add("af-hide");
+
+      function reveal() {
+        if (revealed) return;
+        revealed = true;
+        clearTimeout(timer);
+        // Wait one frame so SDK DOM mutations are painted-in before the page appears.
+        (w.requestAnimationFrame || w.setTimeout)(function () {
+          root.classList.remove("af-hide");
+          var s = d.getElementById("anti-flicker");
+          if (s) s.parentNode.removeChild(s);
+        });
+      }
+      function check() { if (sdkDone && domReady) reveal(); }
+
+      var timer = setTimeout(reveal, TIMEOUT_MS);
+
+      if (d.readyState === "loading") {
+        d.addEventListener("DOMContentLoaded", function () { domReady = true; check(); });
+      } else {
+        domReady = true;
+      }
+
+      var s = d.createElement("script");
+      s.src = "https://cdn.example.com/experiment-sdk.js";
+      s.async = true;
+      s.onload = function () { sdkDone = true; check(); };
+      s.onerror = reveal; // SDK blocked/unavailable: show original content
+      d.head.appendChild(s);
+
+      // Safety net if JS is disabled is handled by <noscript> below.
+    })(window, document);
+  </script>
+  <noscript>
+    <style>html.af-hide body { opacity: 1 !important; }</style>
+  </noscript>
+
+  <style>
+    :root {
+      --bg: #0b1020;
+      --fg: #f5f7ff;
+      --muted: #aab3d6;
+      --accent: #6c8cff;
+      --accent-2: #a56bff;
+    }
+    * { box-sizing: border-box; }
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+    }
+    header {
+      display: flex; align-items: center; justify-content: space-between;
+      max-width: 1100px; margin: 0 auto; padding: 24px;
+    }
+    .logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
+    .hero {
+      position: relative; overflow: hidden;
+      min-height: 80vh;
+      display: grid; place-items: center; text-align: center;
+      padding: 64px 24px;
+      background:
+        linear-gradient(rgba(11,16,32,.7), rgba(11,16,32,.9)),
+        url("https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1800&q=70") center / cover no-repeat,
+        radial-gradient(circle at 30% 20%, var(--accent-2), transparent 60%), var(--bg);
+    }
+    .hero-inner { max-width: 760px; }
+    .eyebrow {
+      display: inline-block; padding: 4px 12px; border-radius: 999px;
+      background: rgba(108,140,255,.15); color: var(--accent);
+      font-size: .85rem; font-weight: 600; margin-bottom: 20px;
+    }
+    h1 {
+      font-size: clamp(2.25rem, 6vw, 4rem); line-height: 1.1;
+      margin: 0 0 20px; letter-spacing: -0.03em;
+    }
+    .hero p { font-size: 1.15rem; color: var(--muted); margin: 0 0 36px; }
+    .cta {
+      display: inline-block; padding: 16px 36px; border-radius: 12px;
+      background: linear-gradient(135deg, var(--accent), var(--accent-2));
+      color: #fff; font-weight: 700; font-size: 1.05rem; text-decoration: none;
+      box-shadow: 0 10px 30px rgba(108,140,255,.35);
+      transition: transform .15s ease, box-shadow .15s ease;
+    }
+    .cta:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(108,140,255,.5); }
+    .cta:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
+    footer { text-align: center; padding: 32px; color: var(--muted); font-size: .9rem; }
+  </style>
+</head>
+<body>
+  <header>
+    <div class="logo">Launchpad</div>
+  </header>
+
+  <main>
+    <section class="hero" id="hero" data-experiment="hero">
+      <div class="hero-inner">
+        <span class="eyebrow">New · Team workspaces</span>
+        <h1 id="hero-title">Ship your ideas faster than ever</h1>
+        <p id="hero-subtitle">Launchpad takes your team from idea to launch in days, not months. No setup, no hassle.</p>
+        <a class="cta" id="cta-button" data-experiment="cta" href="#signup">Get started free</a>
+      </div>
+    </section>
+  </main>
+
+  <footer>&copy; 2026 Launchpad, Inc.</footer>
+</body>
+</html>
