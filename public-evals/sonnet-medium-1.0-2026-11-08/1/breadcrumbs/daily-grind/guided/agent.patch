+    /* Breadcrumbs */
+    nav.breadcrumb {
+      display: block;
+      position: static;
+      background: none;
+      color: var(--text);
+      max-width: 1100px;
+      margin: 20px auto 0;
+      padding: 0 20px;
+      font-size: 0.9rem;
+    }
+
+    .breadcrumb > ol {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 0.5rem;
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    .breadcrumb > ol > li + li::before {
+      content: "/" / "";
+      margin-inline-end: 0.5rem;
+      color: var(--text);
+    }
+
+    .breadcrumb a {
+      color: var(--primary);
+      text-decoration: underline;
+    }
+
+    .breadcrumb a:hover {
+      color: #3e2723;
+    }
+
+    .breadcrumb a:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .breadcrumb a[aria-current="page"] {
+      font-weight: bold;
+      text-decoration: none;
+    }
+
+    @media (forced-colors: active) {
+      .breadcrumb a[aria-current="page"] {
+        text-decoration: underline;
+      }
+    }
