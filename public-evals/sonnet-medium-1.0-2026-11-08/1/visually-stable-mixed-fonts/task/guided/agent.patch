diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,63 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Mixed Fonts</title>
+  <style>
+    body {
+      margin: 2rem;
+      font-family: system-ui, sans-serif;
+      line-height: 1.6;
+    }
+
+    #mixed-fonts-container {
+      font-family: Verdana, sans-serif;
+      font-size: 1.125rem;
+      /* Take the x-height ratio from the primary font and apply it to nested fonts */
+      font-size-adjust: from-font;
+      max-width: 40rem;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, monospace;
+    }
+
+    #independent-theme-container {
+      margin-top: 2rem;
+      max-width: 40rem;
+      font-family: Times, "Times New Roman", serif;
+      font-size: 1.125rem;
+      /* Numeric x-height ratio locks proportions independent of the primary font */
+      font-size-adjust: 0.51;
+    }
+
+    /* Fallback for browsers without font-size-adjust support */
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container code {
+        font-size: 0.9em;
+      }
+
+      #independent-theme-container {
+        font-size: 1.2rem;
+      }
+    }
+  </style>
+</head>
+<body>
+  <div id="mixed-fonts-container">
+    <p>
+      Call <code>document.querySelector()</code> to find an element, then read its
+      <code>textContent</code> property. Inline code stays visually the same height as
+      the surrounding prose.
+    </p>
+  </div>
+
+  <div id="independent-theme-container">
+    <p>
+      This independent theme uses a serif font with a fixed x-height ratio, so its
+      visual proportions stay consistent regardless of the page's other fonts.
+    </p>
+  </div>
+</body>
+</html>
