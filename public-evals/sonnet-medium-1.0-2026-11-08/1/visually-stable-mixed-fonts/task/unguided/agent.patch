diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,61 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Font Size Adjust Demo</title>
+  <style>
+    body {
+      font-family: system-ui, sans-serif;
+      max-width: 42rem;
+      margin: 2rem auto;
+      padding: 0 1rem;
+      line-height: 1.6;
+    }
+
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", serif;
+      font-size: 1.125rem;
+      /* Normalize x-height across fallback fonts using the first available font's metric */
+      font-size-adjust: from-font;
+      padding: 1rem;
+      border: 1px solid #ccc;
+      border-radius: 8px;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, monospace;
+      /* Inherits the adjustment, so code x-height matches the surrounding text */
+      font-size-adjust: from-font;
+      background: #f2f2f2;
+      padding: 0.1em 0.3em;
+      border-radius: 4px;
+    }
+
+    #independent-theme-container {
+      margin-top: 1.5rem;
+      font-family: Verdana, Tahoma, sans-serif;
+      font-size: 1.125rem;
+      /* Locked numeric aspect value, independent of the page's fonts */
+      font-size-adjust: 0.5;
+      padding: 1rem;
+      color: #eee;
+      background: #223;
+      border-radius: 8px;
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", monospace;
+    }
+  </style>
+</head>
+<body>
+  <div id="mixed-fonts-container">
+    <p>Regular serif text mixed with inline code like <code>const x = 42;</code> and more text with <code>document.querySelector()</code> to show matched visual height.</p>
+  </div>
+
+  <div id="independent-theme-container">
+    <p>An independent theme with a locked <code>font-size-adjust: 0.5</code> proportion, regardless of the font used.</p>
+  </div>
+</body>
+</html>
