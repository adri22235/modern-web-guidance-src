+<script>
+    // Native :target-current handles highlighting where supported; this keeps
+    // aria-current in sync and falls back to IntersectionObserver elsewhere.
+    const links = document.querySelectorAll('nav a[href^="#"]');
+    if (CSS.supports('scroll-target-group: auto')) {
+      const sync = () => {
+        const current = document.querySelector('nav a:target-current');
+        links.forEach(l => l.setAttribute('aria-current', l === current ? 'true' : 'false'));
+      };
+      sync();
+      document.addEventListener('scrollend', sync);
+    } else {
+      const observer = new IntersectionObserver(entries => {
+        entries.forEach(entry => {
+          if (!entry.isIntersecting) return;
+          links.forEach(l => {
+            const active = l.getAttribute('href') === '#' + entry.target.id;
+            l.classList.toggle('target-current', active);
+            l.setAttribute('aria-current', active);
+          });
+        });
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+      document.querySelectorAll('main section[id]').forEach(s => observer.observe(s));
+    }
+  </script>
