+<script>
+    const links = [...document.querySelectorAll('nav ul a[href^="#"]')];
+    const sections = links.map(a => document.querySelector(a.getAttribute('href')));
+
+    function updateActive() {
+      const navH = document.querySelector('nav').offsetHeight;
+      const probe = navH + window.innerHeight * 0.25;
+      let current = null;
+      sections.forEach(sec => {
+        if (sec.getBoundingClientRect().top <= probe) current = sec;
+      });
+      // At page bottom, the last section wins even if it is short
+      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
+        current = sections[sections.length - 1];
+      }
+      links.forEach((a, i) => {
+        const on = sections[i] === current;
+        a.classList.toggle('active', on);
+        if (on) a.setAttribute('aria-current', 'true');
+        else a.removeAttribute('aria-current');
+      });
+    }
+
+    window.addEventListener('scroll', updateActive, { passive: true });
+    window.addEventListener('resize', updateActive);
+    updateActive();
+  </script>
+
