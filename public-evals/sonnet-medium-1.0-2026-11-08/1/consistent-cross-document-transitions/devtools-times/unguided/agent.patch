diff --git a/src/layouts/Layout.astro b/src/layouts/Layout.astro
index dcf9696..ea752e6 100644
--- a/src/layouts/Layout.astro
+++ b/src/layouts/Layout.astro
@@ -35,6 +35,42 @@ const baseUrl = import.meta.env.BASE_URL;
     <link rel="icon" href=`${baseUrl}/favicon.svg` />
 
     <ClientRouter />
+
+    <script>
+      // Hold the old page on screen until the incoming page's fonts and
+      // above-the-fold images are ready, so the transition never reveals
+      // unstyled text or half-loaded layouts.
+      const MAX_WAIT_MS = 2500;
+
+      const waitForImage = (img: HTMLImageElement) =>
+        new Promise<void>((resolve) => {
+          const preload = new Image();
+          preload.onload = preload.onerror = () => resolve();
+          if (img.srcset) preload.srcset = img.srcset;
+          preload.src = img.src;
+          preload.decode?.().then(() => resolve(), () => resolve());
+        });
+
+      document.addEventListener("astro:before-preparation", (event) => {
+        const originalLoader = event.loader;
+        event.loader = async () => {
+          await originalLoader();
+          const doc = event.newDocument;
+          const images = [
+            ...doc.querySelectorAll<HTMLImageElement>("main img[src]"),
+          ].slice(0, 6);
+          const ready = Promise.all([
+            document.fonts?.load('500 1em "Grenze"').catch(() => {}),
+            document.fonts?.ready,
+            ...images.map(waitForImage),
+          ]);
+          await Promise.race([
+            ready,
+            new Promise((resolve) => setTimeout(resolve, MAX_WAIT_MS)),
+          ]);
+        };
+      });
+    </script>
   </head>
   <body class="bg-gray-100">
     <div class="mx-auto">
