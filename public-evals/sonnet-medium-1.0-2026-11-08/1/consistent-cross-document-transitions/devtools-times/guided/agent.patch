+}
+/* Cross-document view transitions between home, category and article pages */
+@media (prefers-reduced-motion: no-preference) {
+  @view-transition {
+    navigation: auto;
+  }
+
+  ::view-transition-old(root) {
+    animation: 0.2s ease-in both page-out;
+  }
+
+  ::view-transition-new(root) {
+    animation: 0.3s ease-out both page-in;
+  }
+}
+
+@keyframes page-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes page-in {
+  from {
+    opacity: 0;
+  }
+}
