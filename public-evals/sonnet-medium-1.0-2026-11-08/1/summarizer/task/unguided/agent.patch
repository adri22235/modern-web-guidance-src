+  <script>
+    // Summarize the journal using the browser's built-in Summarizer API.
+    const btn = document.getElementById('summarize-btn');
+    const box = document.getElementById('summary');
+    const list = document.getElementById('summary-list');
+    const status = document.getElementById('summary-status');
+
+    function showStatus(msg) {
+      box.hidden = false;
+      status.textContent = msg;
+    }
+
+    btn.addEventListener('click', async () => {
+      list.replaceChildren();
+      btn.disabled = true;
+      try {
+        if (!('Summarizer' in self)) {
+          showStatus("Your browser doesn't support built-in AI summarization.");
+          return;
+        }
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          showStatus('Built-in AI summarization is unavailable on this device.');
+          return;
+        }
+
+        showStatus(availability === 'available' ? 'Summarizing…' : 'Downloading the AI model…');
+        const summarizer = await Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'medium',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              showStatus(`Downloading the AI model… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+
+        const text = document.getElementById('journal-text').innerText;
+        const result = await summarizer.summarize(text);
+        summarizer.destroy();
+
+        const points = result.split('\n')
+          .map((line) => line.replace(/^\s*[-*•]\s*/, '').trim())
+          .filter(Boolean);
+        for (const point of points) {
+          const li = document.createElement('li');
+          li.textContent = point;
+          list.append(li);
+        }
+        status.textContent = '';
+      } catch (err) {
+        showStatus('Sorry, something went wrong while summarizing.');
+        console.error(err);
+      } finally {
+        btn.disabled = false;
+      }
+    });
+  </script>
