+  <script>
+    const btn = document.getElementById('summarize-btn');
+    const statusEl = document.getElementById('summary-status');
+    const output = document.getElementById('summary-output');
+    const options = { type: 'key-points', format: 'plain-text', length: 'medium', outputLanguage: 'en' };
+
+    function renderBullets(text) {
+      const ul = document.createElement('ul');
+      for (const line of text.split('\n')) {
+        const item = line.replace(/^\s*[-*\u2022]\s*/, '').trim();
+        if (!item) continue;
+        const li = document.createElement('li');
+        li.textContent = item;
+        ul.append(li);
+      }
+      output.replaceChildren(ul);
+      output.hidden = false;
+    }
+
+    if (!('Summarizer' in self)) {
+      btn.disabled = true;
+      statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+    }
+
+    btn.addEventListener('click', async () => {
+      btn.disabled = true;
+      output.hidden = true;
+      try {
+        const availability = await Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          statusEl.textContent = 'Local summarization is unavailable on this device.';
+          return;
+        }
+        statusEl.textContent = availability === 'available' ? 'Summarizing…' : 'Preparing the on-device model…';
+        const summarizer = await Summarizer.create({
+          ...options,
+          sharedContext: 'A coffee roaster describing how it sources green coffee beans.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              statusEl.textContent = `Downloading model: ${Math.round(e.loaded * 100)}%`;
+            });
+          },
+        });
+        statusEl.textContent = 'Summarizing…';
+        const text = document.getElementById('journal-text').innerText;
+        renderBullets(await summarizer.summarize(text));
+        summarizer.destroy();
+        statusEl.textContent = '';
+      } catch (err) {
+        statusEl.textContent = 'Sorry, the summary could not be generated.';
+        console.error(err);
+      } finally {
+        btn.disabled = false;
+      }
+    });
+  </script>
+
