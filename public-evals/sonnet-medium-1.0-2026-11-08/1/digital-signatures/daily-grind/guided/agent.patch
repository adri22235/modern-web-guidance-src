+  <script type="module">
+    const enc = new TextEncoder();
+    const DOC_TYPES = ['receipt', 'voucher'];
+    const SUITES = ['ML-DSA-65', 'Ed25519', 'ECDSA-P256'];
+    const contextFor = (type) => enc.encode(`daily-grind/${type}/v1`);
+
+    const toB64 = (bytes) => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+    const fromB64 = (str) => Uint8Array.from(atob(str), (c) => c.charCodeAt(0));
+    const hex = (bytes) => [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, '0')).join('');
+
+    async function fingerprint(publicKeyBytes) {
+      const digest = await crypto.subtle.digest('SHA-256', publicKeyBytes);
+      return hex(digest).slice(0, 32).match(/.{4}/g).join(' ');
+    }
+
+    // --- Algorithm selection: ML-DSA-65, then Ed25519, then ECDSA P-256 ---
+    function supports(op, alg) {
+      return typeof globalThis.SubtleCrypto?.supports === 'function' && SubtleCrypto.supports(op, alg);
+    }
+
+    async function pickSuite() {
+      if (supports('sign', 'ML-DSA-65')) return 'ML-DSA-65';
+      try {
+        await crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']);
+        return 'Ed25519';
+      } catch {
+        return 'ECDSA-P256';
+      }
+    }
+
+    const keyParams = {
+      'ML-DSA-65': { gen: 'ML-DSA-65', fmt: 'raw-public' },
+      'Ed25519': { gen: 'Ed25519', fmt: 'raw' },
+      'ECDSA-P256': { gen: { name: 'ECDSA', namedCurve: 'P-256' }, fmt: 'raw' },
+    };
+
+    // Context is native for ML-DSA; classical suites get a length-prefixed header.
+    function signInput(suite, payload, context) {
+      if (suite === 'ML-DSA-65') return payload;
+      const framed = new Uint8Array(1 + context.length + payload.length);
+      framed[0] = context.length;
+      framed.set(context, 1);
+      framed.set(payload, 1 + context.length);
+      return framed;
+    }
+
+    function algFor(suite, context) {
+      if (suite === 'ML-DSA-65') return { name: 'ML-DSA-65', context };
+      if (suite === 'Ed25519') return 'Ed25519';
+      return { name: 'ECDSA', hash: 'SHA-256' };
+    }
+
+    // --- Key persistence: non-extractable CryptoKeys live in IndexedDB ---
+    function idb() {
+      return new Promise((resolve, reject) => {
+        const req = indexedDB.open('daily-grind-signing', 1);
+        req.onupgradeneeded = () => req.result.createObjectStore('keys');
+        req.onsuccess = () => resolve(req.result);
+        req.onerror = () => reject(req.error);
+      });
+    }
+
+    async function idbOp(mode, fn) {
+      const db = await idb();
+      return new Promise((resolve, reject) => {
+        const tx = db.transaction('keys', mode);
+        const req = fn(tx.objectStore('keys'));
+        tx.oncomplete = () => resolve(req.result);
+        tx.onerror = () => reject(tx.error);
+      });
+    }
+
+    async function getSigner() {
+      let stored;
+      try { stored = await idbOp('readonly', (s) => s.get('signer')); } catch { /* storage unavailable */ }
+      if (stored?.suite && SUITES.includes(stored.suite)) return stored;
+
+      const suite = await pickSuite();
+      const { gen, fmt } = keyParams[suite];
+      const keyPair = await crypto.subtle.generateKey(gen, false, ['sign', 'verify']);
+      const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey(fmt, keyPair.publicKey));
+      const signer = { suite, keyPair, publicKeyBytes };
+      try { await idbOp('readwrite', (s) => s.put(signer, 'signer')); } catch { /* session-only key */ }
+      return signer;
+    }
+
+    async function importPublicKey(suite, bytes) {
+      const { gen, fmt } = keyParams[suite];
+      return crypto.subtle.importKey(fmt, bytes, gen, true, ['verify']);
+    }
+
+    // --- Signing ---
+    const $ = (id) => document.getElementById(id);
+    const setStatus = (el, state, msg) => { el.dataset.state = state; el.textContent = msg; };
+
+    $('sign-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const status = $('sign-status');
+      try {
+        const f = new FormData(e.target);
+        const type = f.get('type');
+        const cents = Math.round(Number(f.get('amount')) * 100);
+        if (!DOC_TYPES.includes(type) || !(cents > 0)) throw new Error('Invalid input');
+
+        // Fixed field order; the exact string is what gets signed and shipped.
+        const payload = JSON.stringify({
+          type,
+          id: crypto.randomUUID(),
+          issuedAt: new Date().toISOString(),
+          name: String(f.get('name')).trim(),
+          details: String(f.get('details')).trim(),
+          amountCents: cents,
+          currency: 'USD',
+        });
+
+        const signer = await getSigner();
+        const context = contextFor(type);
+        const sig = await crypto.subtle.sign(
+          algFor(signer.suite, context),
+          signer.keyPair.privateKey,
+          signInput(signer.suite, enc.encode(payload), context),
+        );
+
+        const doc = {
+          v: 1,
+          suite: signer.suite,
+          payload,
+          publicKey: toB64(signer.publicKeyBytes),
+          signature: toB64(sig),
+        };
+        $('signed-output').value = JSON.stringify(doc, null, 2);
+        $('copy-signed').hidden = false;
+        $('verify-input').value = $('signed-output').value;
+        setStatus(status, 'ok', `Signed with ${signer.suite}.`);
+        $('key-info').textContent = `Signing key fingerprint: ${await fingerprint(signer.publicKeyBytes)}`;
+      } catch (err) {
+        setStatus(status, 'bad', 'Could not sign the document in this browser.');
+      }
+    });
+
+    $('copy-signed').addEventListener('click', async () => {
+      try {
+        await navigator.clipboard.writeText($('signed-output').value);
+        setStatus($('sign-status'), 'ok', 'Copied to clipboard.');
+      } catch {
+        $('signed-output').select();
+      }
+    });
+
+    // --- Verification ---
+    $('verify-form').addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const status = $('verify-status');
+      const details = $('verify-details');
+      details.textContent = '';
+      try {
+        const doc = JSON.parse($('verify-input').value);
+        if (doc?.v !== 1 || !SUITES.includes(doc.suite)
+          || typeof doc.payload !== 'string' || typeof doc.publicKey !== 'string'
+          || typeof doc.signature !== 'string') {
+          throw new Error('format');
+        }
+        const data = JSON.parse(doc.payload);
+        if (!DOC_TYPES.includes(data?.type)) throw new Error('format');
+
+        const pubBytes = fromB64(doc.publicKey);
+        const publicKey = await importPublicKey(doc.suite, pubBytes);
+        const context = contextFor(data.type);
+        const valid = await crypto.subtle.verify(
+          algFor(doc.suite, context),
+          publicKey,
+          fromB64(doc.signature),
+          signInput(doc.suite, enc.encode(doc.payload), context),
+        );
+
+        if (!valid) {
+          setStatus(status, 'bad', 'Invalid: the signature does not match. This document was altered or forged.');
+          return;
+        }
+
+        let local;
+        try { local = await idbOp('readonly', (s) => s.get('signer')); } catch { /* ignore */ }
+        const ours = local?.publicKeyBytes
+          && toB64(local.publicKeyBytes) === doc.publicKey;
+        const label = data.type === 'voucher' ? 'gift voucher' : 'order receipt';
+        setStatus(status, 'ok', ours
+          ? `Valid ${label}, signed by this browser's key.`
+          : `Signature is valid and the ${label} is unaltered, but it was signed by a different key. Only trust it if the fingerprint below matches the key you expect.`);
+        details.textContent = `${data.name} · ${data.details} · $${(data.amountCents / 100).toFixed(2)} · `
+          + `issued ${data.issuedAt} · id ${data.id} · ${doc.suite} key ${await fingerprint(pubBytes)}`;
+      } catch {
+        setStatus(status, 'bad', 'Invalid: this is not a well-formed signed document.');
+      }
+    });
+
+    getSigner().then(async (s) => {
+      $('key-info').textContent = `Signing key fingerprint: ${await fingerprint(s.publicKeyBytes)} (${s.suite})`;
+    }).catch(() => {});
+  </script>
 </body>
 
