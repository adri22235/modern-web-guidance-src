+  <script>
+    (() => {
+      const $ = (id) => document.getElementById(id);
+      const ALG = 'ECDSA-P256-SHA256';
+      const ECDSA = { name: 'ECDSA', namedCurve: 'P-256' };
+      const SIGN = { name: 'ECDSA', hash: 'SHA-256' };
+      const enc = new TextEncoder();
+
+      // --- helpers ---
+      const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
+      const unb64 = (str) => Uint8Array.from(atob(str), (c) => c.charCodeAt(0));
+      const hex = (buf) => [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
+      // Deterministic JSON (sorted keys) so signer and verifier hash identical bytes.
+      const canon = (v) => Array.isArray(v) ? '[' + v.map(canon).join(',') + ']'
+        : v && typeof v === 'object' ? '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + canon(v[k])).join(',') + '}'
+        : JSON.stringify(v);
+      const show = (el, cls, msg) => { el.className = 'result ' + cls; el.textContent = msg; };
+
+      async function fingerprint(jwk) {
+        const id = canon({ crv: jwk.crv, kty: jwk.kty, x: jwk.x, y: jwk.y });
+        return hex(await crypto.subtle.digest('SHA-256', enc.encode(id))).match(/.{4}/g).slice(0, 8).join(':');
+      }
+
+      // --- key storage (non-extractable private key in IndexedDB) ---
+      const idb = () => new Promise((res, rej) => {
+        const r = indexedDB.open('daily-grind-keys', 1);
+        r.onupgradeneeded = () => r.result.createObjectStore('keys');
+        r.onsuccess = () => res(r.result);
+        r.onerror = () => rej(r.error);
+      });
+      const idbReq = (req) => new Promise((res, rej) => { req.onsuccess = () => res(req.result); req.onerror = () => rej(req.error); });
+
+      let keyPair;
+      async function getKeyPair() {
+        if (keyPair) return keyPair;
+        let db;
+        try {
+          db = await idb();
+          keyPair = await idbReq(db.transaction('keys').objectStore('keys').get('signing'));
+        } catch (e) { /* IndexedDB unavailable: fall back to session key */ }
+        if (!keyPair) {
+          keyPair = await crypto.subtle.generateKey(ECDSA, false, ['sign', 'verify']);
+          try { await idbReq(db.transaction('keys', 'readwrite').objectStore('keys').put(keyPair, 'signing')); } catch (e) {}
+        }
+        return keyPair;
+      }
+      async function publicJwk() {
+        const { publicKey } = await getKeyPair();
+        const { kty, crv, x, y } = await crypto.subtle.exportKey('jwk', publicKey);
+        return { kty, crv, x, y };
+      }
+
+      // --- build payloads ---
+      function buildPayload() {
+        const now = new Date();
+        const id = crypto.randomUUID();
+        if ($('doc-type').value === 'receipt') {
+          const items = $('r-items').value.split('\n').map((l) => l.trim()).filter(Boolean).map((l) => {
+            const i = l.lastIndexOf(',');
+            const price = parseFloat(l.slice(i + 1));
+            if (i < 1 || !isFinite(price) || price < 0) throw new Error('Bad item line: "' + l + '"');
+            return { name: l.slice(0, i).trim(), priceCents: Math.round(price * 100) };
+          });
+          if (!items.length) throw new Error('Add at least one item.');
+          return { type: 'receipt', id, issuer: 'The Daily Grind', issuedAt: now.toISOString(), items,
+            totalCents: items.reduce((s, i) => s + i.priceCents, 0) };
+        }
+        const amount = parseFloat($('v-amount').value);
+        const days = parseInt($('v-days').value, 10);
+        if (!(amount > 0)) throw new Error('Enter a valid amount.');
+        if (!(days > 0)) throw new Error('Enter a valid validity period.');
+        return { type: 'voucher', id, issuer: 'The Daily Grind', issuedAt: now.toISOString(),
+          expiresAt: new Date(now.getTime() + days * 864e5).toISOString(),
+          amountCents: Math.round(amount * 100), recipient: $('v-to').value.trim() };
+      }
+
+      let lastDoc = null;
+      async function sign() {
+        const out = $('sign-result');
+        try {
+          const payload = buildPayload();
+          const { privateKey } = await getKeyPair();
+          const sig = await crypto.subtle.sign(SIGN, privateKey, enc.encode(canon(payload)));
+          lastDoc = { payload, alg: ALG, publicKey: await publicJwk(), signature: b64(sig) };
+          const text = JSON.stringify(lastDoc, null, 2);
+          $('verify-input').value = text;
+          show(out, 'ok', 'Signed ' + payload.type + ' ' + payload.id + '. Copied into the verifier for checking.');
+        } catch (e) { lastDoc = null; show(out, 'bad', e.message); }
+      }
+
+      async function verify() {
+        const out = $('verify-result');
+        let doc;
+        try { doc = JSON.parse($('verify-input').value); } catch { return show(out, 'bad', 'Not valid JSON.'); }
+        try {
+          if (!doc || typeof doc !== 'object' || !doc.payload || !doc.publicKey || typeof doc.signature !== 'string')
+            return show(out, 'bad', 'Missing payload, publicKey or signature.');
+          if (doc.alg !== ALG) return show(out, 'bad', 'Unsupported algorithm: ' + doc.alg);
+          const { kty, crv, x, y } = doc.publicKey;
+          const key = await crypto.subtle.importKey('jwk', { kty, crv, x, y, ext: true }, ECDSA, true, ['verify']);
+          const ok = await crypto.subtle.verify(SIGN, key, unb64(doc.signature), enc.encode(canon(doc.payload)));
+          if (!ok) return show(out, 'bad', '✗ INVALID: the signature does not match. The document was altered or forged.');
+          const fp = await fingerprint({ kty, crv, x, y });
+          const mine = await fingerprint(await publicJwk());
+          const p = doc.payload;
+          let msg = '✓ Signature valid: ' + p.type + ' ' + p.id + ' is intact. Signer key ' + fp + '.';
+          let cls = 'ok';
+          if (p.type === 'voucher' && new Date(p.expiresAt) < new Date()) { msg += ' Note: this voucher has expired.'; cls = 'warn'; }
+          if (fp !== mine) {
+            msg += ' This key is not the one on this device, so confirm the fingerprint with the issuer: a valid signature only proves integrity, not that it came from The Daily Grind.';
+            cls = 'warn';
+          } else msg += ' Signed by this device\'s key.';
+          show(out, cls, msg);
+        } catch (e) { show(out, 'bad', 'Verification failed: ' + e.message); }
+      }
+
+      if (!window.crypto || !crypto.subtle) {
+        $('signing').insertAdjacentHTML('beforeend', '<p class="result bad">Web Crypto requires a secure (HTTPS or localhost) context.</p>');
+        return;
+      }
+      $('doc-type').addEventListener('change', () => {
+        const r = $('doc-type').value === 'receipt';
+        $('receipt-fields').hidden = !r; $('voucher-fields').hidden = r;
+      });
+      $('sign-btn').addEventListener('click', sign);
+      $('verify-btn').addEventListener('click', verify);
+      $('copy-btn').addEventListener('click', async () => {
+        if (!lastDoc) return show($('sign-result'), 'warn', 'Sign something first.');
+        try { await navigator.clipboard.writeText(JSON.stringify(lastDoc, null, 2)); show($('sign-result'), 'ok', 'Copied.'); }
+        catch { show($('sign-result'), 'warn', 'Clipboard unavailable; use Download.'); }
+      });
+      $('dl-btn').addEventListener('click', () => {
+        if (!lastDoc) return show($('sign-result'), 'warn', 'Sign something first.');
+        const a = document.createElement('a');
+        a.href = URL.createObjectURL(new Blob([JSON.stringify(lastDoc, null, 2)], { type: 'application/json' }));
+        a.download = lastDoc.payload.type + '-' + lastDoc.payload.id + '.signed.json';
+        a.click(); URL.revokeObjectURL(a.href);
+      });
+      $('verify-file').addEventListener('change', async (e) => {
+        const f = e.target.files[0];
+        if (f) { $('verify-input').value = await f.text(); verify(); }
+      });
+      publicJwk().then(fingerprint).then((fp) => { $('key-fp').textContent = fp; })
+        .catch(() => { $('key-fp').textContent = 'unavailable'; });
+    })();
+  </script>
+
