+  <script>
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    let autofillAbortController = new AbortController();
+
+    async function fetchOptions() {
+      const res = await fetch('/api/login/options', { method: 'POST', credentials: 'same-origin' });
+      if (!res.ok) throw new Error('Could not start sign-in');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    // Sends the assertion to the server; returns true on success.
+    async function verify(publicKey, credential) {
+      const encoded = credential.toJSON();
+      let res;
+      try {
+        res = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded)
+        });
+      } catch (err) {
+        statusEl.textContent = 'Sign-in failed. Please try again.';
+        return false;
+      }
+      if (res.ok) {
+        let name = '';
+        try { name = (await res.json()).username || ''; } catch (e) { }
+        statusEl.textContent = name ? `Signed in as ${name}` : 'Signed in successfully';
+        return true;
+      }
+      if (res.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId: publicKey.rpId, credentialId: encoded.id });
+        } catch (e) { }
+      }
+      statusEl.textContent = 'Sign-in failed. Passkey not recognized.';
+      return false;
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential) return;
+      const supported = PublicKeyCredential.getClientCapabilities
+        ? (await PublicKeyCredential.getClientCapabilities()).conditionalGet === true
+        : await PublicKeyCredential.isConditionalMediationAvailable?.();
+      if (!supported) return;
+      try {
+        const publicKey = await fetchOptions();
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional'
+        });
+        await verify(publicKey, credential);
+      } catch (err) {
+        if (['NotAllowedError', 'AbortError'].includes(err.name)) return;
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        statusEl.textContent = 'Passkeys are not supported in this browser.';
+        return;
+      }
+      // Cancel pending autofill request to avoid colliding prompts
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+      try {
+        const publicKey = await fetchOptions();
+        const credential = await navigator.credentials.get({ publicKey, signal: autofillAbortController.signal });
+        await verify(publicKey, credential);
+      } catch (err) {
+        if (err.name === 'NotAllowedError') statusEl.textContent = 'Sign-in was cancelled.';
+        else if (err.name !== 'AbortError') statusEl.textContent = 'Sign-in failed. Please try again.';
+        // Re-arm autofill suggestions
+        initializeConditionalAutofill();
+      }
+    }
+
+    authButton.addEventListener('click', triggerButtonAuthentication);
+    window.addEventListener('DOMContentLoaded', initializeConditionalAutofill);
+  </script>
