+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      let controller = null;
+
+      const b64urlToBuffer = (str) => {
+        const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+        const bin = atob(b64);
+        return Uint8Array.from(bin, (c) => c.charCodeAt(0)).buffer;
+      };
+
+      const bufferToB64url = (buf) => {
+        let bin = '';
+        new Uint8Array(buf).forEach((b) => { bin += String.fromCharCode(b); });
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      };
+
+      const setStatus = (msg, type) => {
+        statusEl.textContent = msg;
+        statusEl.className = type || '';
+      };
+
+      async function fetchOptions() {
+        const res = await fetch('/api/login/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username: usernameField.value.trim() })
+        });
+        if (!res.ok) throw new Error('Could not start sign-in');
+        const data = await res.json();
+        const opts = data.publicKey || data.options || data;
+        return {
+          challenge: b64urlToBuffer(opts.challenge),
+          rpId: opts.rpId,
+          timeout: opts.timeout,
+          userVerification: opts.userVerification || 'preferred',
+          allowCredentials: (opts.allowCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id)
+          }))
+        };
+      }
+
+      async function authenticate(conditional) {
+        if (controller) controller.abort();
+        controller = new AbortController();
+        try {
+          const publicKey = await fetchOptions();
+          if (conditional) publicKey.allowCredentials = [];
+          const cred = await navigator.credentials.get({
+            publicKey,
+            mediation: conditional ? 'conditional' : undefined,
+            signal: controller.signal
+          });
+          if (!cred) return;
+          setStatus('Verifying…');
+          const r = cred.response;
+          const res = await fetch('/api/login/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({
+              id: cred.id,
+              rawId: bufferToB64url(cred.rawId),
+              type: cred.type,
+              authenticatorAttachment: cred.authenticatorAttachment,
+              clientExtensionResults: cred.getClientExtensionResults(),
+              response: {
+                clientDataJSON: bufferToB64url(r.clientDataJSON),
+                authenticatorData: bufferToB64url(r.authenticatorData),
+                signature: bufferToB64url(r.signature),
+                userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null
+              }
+            })
+          });
+          if (!res.ok) throw new Error('Verification failed');
+          setStatus('Signed in successfully', 'success');
+        } catch (err) {
+          if (err.name === 'AbortError') return;
+          setStatus(err.name === 'NotAllowedError' ? 'Sign-in was cancelled' : (err.message || 'Sign-in failed'), 'error');
+        }
+      }
+
+      authButton.addEventListener('click', () => authenticate(false));
+
+      // Offer registered passkeys as autofill suggestions in the username field.
+      if (window.PublicKeyCredential && PublicKeyCredential.isConditionalMediationAvailable) {
+        PublicKeyCredential.isConditionalMediationAvailable().then((ok) => {
+          if (ok) authenticate(true);
+        });
+      }
+    })();
+  </script>
+
 </body>
 
