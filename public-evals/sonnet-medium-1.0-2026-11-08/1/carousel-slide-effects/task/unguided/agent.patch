     }
+
+    /* Product carousel */
+    .carousel-section {
+      margin: 40px 0;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+    }
+
+    .scroller {
+      --card-width: min(280px, 70vw);
+      display: flex;
+      gap: 24px;
+      list-style: none;
+      overflow-x: auto;
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-snap-type: x mandatory;
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+      overscroll-behavior-x: contain;
+    }
+
+    .scroller:focus-visible,
+    .scroller-card a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .scroller-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
+      overflow: hidden;
+      text-align: center;
+      /* Static fallback where scroll-driven animations are unsupported */
+      transform: scale(0.85);
+    }
+
+    .scroller-card img {
+      display: block;
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+    }
+
+    .scroller-card .card-body {
+      padding: 16px 20px 20px;
+    }
+
+    .scroller-card h3 {
+      color: var(--primary);
+    }
+
+    .scroller-card .price {
+      font-weight: bold;
+      margin-top: 4px;
+    }
+
+    /* Scale up at the center of the scroller, down toward the edges (no JS) */
+    @keyframes card-focus {
+      0%, 100% { transform: scale(0.8); opacity: 0.6; }
+      50% { transform: scale(1.1); opacity: 1; }
+    }
+
+    @supports (animation-timeline: view()) {
+      .scroller-card {
+        transform: none;
+        animation: card-focus linear both;
+        animation-timeline: view(inline);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .scroller-card {
+        animation: none;
+        transform: none;
+        opacity: 1;
+      }
+    }
   </style>
