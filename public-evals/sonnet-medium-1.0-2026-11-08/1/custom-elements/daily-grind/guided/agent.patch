+/**
+ * <coffee-card> — autonomous custom element (light DOM, styled by the page).
+ *
+ * Attributes / properties (reflected both ways):
+ *   heading      string   card title
+ *   description  string   short blurb
+ *   href         string   details link
+ *   link-label   string   link text (property: linkLabel), default "View Details"
+ *   price        number   optional; hidden when 0
+ *   featured     boolean  highlights the card; also exposed as :state(featured)
+ */
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['heading', 'description', 'href', 'link-label', 'price', 'featured'];
+
+  #internals;
+  #title;
+  #blurb;
+  #priceEl;
+  #link;
+  #built = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+  }
+
+  // --- string properties ---
+  get heading() { return this.getAttribute('heading') ?? ''; }
+  set heading(v) { this.#setString('heading', v); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(v) { this.#setString('description', v); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { this.#setString('href', v); }
+
+  get linkLabel() { return this.getAttribute('link-label') ?? 'View Details'; }
+  set linkLabel(v) { this.#setString('link-label', v); }
+
+  // --- numeric property ---
+  get price() { return Number(this.getAttribute('price')) || 0; }
+  set price(v) {
+    const n = Number(v);
+    Number.isFinite(n) && n > 0 ? this.setAttribute('price', String(n)) : this.removeAttribute('price');
+  }
+
+  // --- boolean property ---
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(on) { this.toggleAttribute('featured', !!on); }
+
+  #setString(name, v) {
+    v == null || v === '' ? this.removeAttribute(name) : this.setAttribute(name, String(v));
+  }
+
+  connectedCallback() {
+    // Idempotent: may run on every insertion/move.
+    if (!this.#built) {
+      this.#build();
+      this.#built = true;
+    }
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    // No global listeners, timers or observers to release; DOM is kept for re-insertion.
+  }
+
+  connectedMoveCallback() {
+    // Moved with moveBefore(): nothing to redo.
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal || !this.#built) return;
+    this.#render();
+  }
+
+  #build() {
+    this.#title = document.createElement('h3');
+    this.#blurb = document.createElement('p');
+    this.#priceEl = document.createElement('p');
+    this.#priceEl.className = 'price';
+    this.#link = document.createElement('a');
+    this.#link.className = 'btn';
+    this.replaceChildren(this.#title, this.#blurb, this.#priceEl, this.#link);
+  }
+
+  #render() {
+    this.#title.textContent = this.heading;
+    this.#blurb.textContent = this.description;
+
+    const price = this.price;
+    this.#priceEl.hidden = !price;
+    this.#priceEl.textContent = price ? `$${price.toFixed(2)}` : '';
+
+    this.#link.hidden = !this.href;
+    this.#link.textContent = this.linkLabel;
+    this.href ? this.#link.setAttribute('href', this.href) : this.#link.removeAttribute('href');
+
+    this.#internals.states.delete('featured');
+    if (this.featured) this.#internals.states.add('featured');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
