+/**
+ * <coffee-card> — autonomous custom element (light DOM, so page styles apply).
+ *
+ * Attributes / properties (all reflected):
+ *   heading     string   card title
+ *   description string   short blurb
+ *   href        string   details link target
+ *   link-text   string   details link label (property: linkText)
+ *   price       number   optional price; hidden when absent
+ *   featured    boolean  shows a "Featured" badge
+ */
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['heading', 'description', 'href', 'link-text', 'price', 'featured'];
+
+  #refs = null;
+
+  // --- Property <-> attribute reflection ---
+  get heading() { return this.getAttribute('heading') ?? ''; }
+  set heading(v) { this.setAttribute('heading', String(v)); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(v) { this.setAttribute('description', String(v)); }
+
+  get href() { return this.getAttribute('href') ?? '#'; }
+  set href(v) { this.setAttribute('href', String(v)); }
+
+  get linkText() { return this.getAttribute('link-text') ?? 'View Details'; }
+  set linkText(v) { this.setAttribute('link-text', String(v)); }
+
+  /** @returns {number|null} null when no valid price is set */
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const n = Number(raw);
+    return Number.isFinite(n) ? n : null;
+  }
+  set price(v) {
+    if (v === null || v === undefined || Number.isNaN(Number(v))) this.removeAttribute('price');
+    else this.setAttribute('price', String(Number(v)));
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(v) { this.toggleAttribute('featured', Boolean(v)); }
+
+  // --- Lifecycle ---
+  connectedCallback() {
+    if (!this.#refs) this.#build();
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    // Nothing global to release; drop refs so DOM can be rebuilt if re-attached.
+    this.#refs = null;
+    this.replaceChildren();
+  }
+
+  adoptedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue || !this.#refs) return;
+    this.#render();
+  }
+
+  // --- Rendering ---
+  #build() {
+    this.classList.add('card');
+    const badge = document.createElement('span');
+    badge.className = 'card-badge';
+    badge.textContent = 'Featured';
+    const h3 = document.createElement('h3');
+    const p = document.createElement('p');
+    const price = document.createElement('p');
+    price.className = 'card-price';
+    const a = document.createElement('a');
+    a.className = 'btn';
+    this.replaceChildren(badge, h3, p, price, a);
+    this.#refs = { badge, h3, p, price, a };
+  }
+
+  #render() {
+    const { badge, h3, p, price, a } = this.#refs;
+    badge.hidden = !this.featured;
+    h3.textContent = this.heading;
+    p.textContent = this.description;
+    const amount = this.price;
+    price.hidden = amount === null;
+    price.textContent = amount === null ? '' : `$${amount.toFixed(2)}`;
+    a.href = this.href;
+    a.textContent = this.linkText;
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
