+  <dialog id="logout-dialog" closedby="any" aria-labelledby="logout-title">
+    <h2 id="logout-title">Log out?</h2>
+    <p>You'll need to sign in again to view your rewards and orders.</p>
+    <div class="dialog-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-ghost" autofocus>Stay signed in</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <div id="notice" class="notice" popover="manual" role="status" aria-label="Notice">
+    <div class="notice-body">
+      <p>Fresh batch of Maple Oat Lattes just landed. Order ahead to skip the line!</p>
+      <button type="button" id="notice-close" class="notice-close" aria-label="Dismiss notice">&times;</button>
+    </div>
+  </div>
+
+  <script>
+    const dialog = document.getElementById('logout-dialog');
+    const notice = document.getElementById('notice');
+    const noticeBtn = document.getElementById('foobar');
+
+    let displayTransitionOk;
+    function canTransitionDisplay() {
+      if (displayTransitionOk !== undefined) return displayTransitionOk;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      displayTransitionOk = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return displayTransitionOk;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    async function closeTopLayer(el) {
+      if (!supportsTopLayerExit()) {
+        el.setAttribute('data-closing', '');
+        const animations = el.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000))
+          ]);
+        }
+        if (!el.hasAttribute('data-closing')) return;
+        el.removeAttribute('data-closing');
+      }
+      if (el instanceof HTMLDialogElement) el.close();
+      else el.hidePopover();
+    }
+
+    // Logout confirmation
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', () => closeTopLayer(dialog));
+    // Route Esc / light dismiss through the same animated close
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeTopLayer(dialog);
+    });
+
+    // Light-dismiss fallback where closedby is unsupported (Safari)
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      dialog.addEventListener('click', (e) => {
+        if (e.target !== dialog) return;
+        const r = dialog.getBoundingClientRect();
+        const inside = r.top <= e.clientY && e.clientY <= r.bottom &&
+          r.left <= e.clientX && e.clientX <= r.right;
+        if (!inside) closeTopLayer(dialog);
+      });
+    }
+
+    // Floating notice
+    noticeBtn.addEventListener('click', () => {
+      if (notice.matches(':popover-open')) closeTopLayer(notice);
+      else notice.showPopover();
+    });
+    document.getElementById('notice-close').addEventListener('click', () => {
+      closeTopLayer(notice);
+      noticeBtn.focus();
+    });
+  </script>
+
