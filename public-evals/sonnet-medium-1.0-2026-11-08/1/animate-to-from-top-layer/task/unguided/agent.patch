+  <dialog id="logout-dialog" class="dialog" aria-labelledby="dialog-title" aria-describedby="dialog-desc">
+    <h2 id="dialog-title">Log out?</h2>
+    <p id="dialog-desc">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-secondary">Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <div id="notice" class="notice" role="status" aria-live="polite">
+    <p>Fresh batch of Maple Oat Lattes just landed. Seasonal menu available while supplies last!</p>
+    <button type="button" class="notice-close" id="notice-close" aria-label="Dismiss notice">&times;</button>
+  </div>
+
+  <script>
+    (function () {
+      var dialog = document.getElementById('logout-dialog');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        dialog.showModal();
+        // Next frame so the transition runs from the initial state
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () { dialog.classList.add('is-open'); });
+        });
+      });
+
+      function closeDialog() {
+        if (!dialog.open) return;
+        dialog.classList.remove('is-open');
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          dialog.close();
+        }
+        dialog.addEventListener('transitionend', function h(e) {
+          if (e.target !== dialog) return;
+          dialog.removeEventListener('transitionend', h);
+          finish();
+        });
+        setTimeout(finish, 400); // fallback
+      }
+
+      closeBtn.addEventListener('click', closeDialog);
+      // Escape: animate out instead of closing instantly
+      dialog.addEventListener('cancel', function (e) { e.preventDefault(); closeDialog(); });
+      // Backdrop click
+      dialog.addEventListener('click', function (e) { if (e.target === dialog) closeDialog(); });
+
+      var notice = document.getElementById('notice');
+      var trigger = document.getElementById('foobar');
+      var noticeClose = document.getElementById('notice-close');
+
+      trigger.addEventListener('click', function () {
+        notice.classList.toggle('is-visible');
+      });
+      noticeClose.addEventListener('click', function () {
+        notice.classList.remove('is-visible');
+        trigger.focus();
+      });
+    })();
+  </script>
+
