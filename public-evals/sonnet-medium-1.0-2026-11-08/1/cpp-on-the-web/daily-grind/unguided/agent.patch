+  <script>
+    (function () {
+      const canvas = document.getElementById('smallpt-canvas');
+      const ctx = canvas.getContext('2d');
+      const btn = document.getElementById('smallpt-btn');
+      const status = document.getElementById('smallpt-status');
+      const worker = new Worker('smallpt-worker.js');
+      const render = (seed) => {
+        btn.disabled = true;
+        status.textContent = 'Rendering…';
+        worker.postMessage({ w: canvas.width, h: canvas.height, samps: 25, seed });
+      };
+      worker.onmessage = ({ data: { w, h, px, ms } }) => {
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(px.buffer), w, h), 0, 0);
+        status.textContent = 'Rendered in ' + (ms / 1000).toFixed(1) + 's';
+        btn.disabled = false;
+      };
+      worker.onerror = () => { status.textContent = 'Failed to load smallpt.wasm (run wasm/build.sh).'; };
+      btn.onclick = () => render((Math.random() * 0xffffffff >>> 0) || 1);
+      render(0); // original Cornell box colors
+    })();
+  </script>
