diff --git a/smallpt/worker.js b/smallpt/worker.js
new file mode 100644
index 0000000..0ac5c31
--- /dev/null
+++ b/smallpt/worker.js
@@ -0,0 +1,25 @@
+// Runs the smallpt WebAssembly module off the main thread, streaming finished rows back.
+const WIDTH = 256, HEIGHT = 192, SAMPLES = 8, BAND = 8;
+
+const { instance } = await WebAssembly.instantiateStreaming(fetch(new URL('./smallpt.wasm', import.meta.url)));
+const wasm = instance.exports;
+wasm._initialize();
+
+let cancelled = 0;
+self.onmessage = async ({ data }) => {
+  if (data.type === 'cancel') { cancelled = data.job; return; }
+  const { job, colors, seed } = data;
+  colors.forEach(([r, g, b], i) => wasm.set_sphere_color(i, r, g, b));
+  for (let y = 0; y < HEIGHT; y += BAND) {
+    // Let any pending 'cancel' message be delivered between bands.
+    await new Promise(resolve => setTimeout(resolve));
+    if (cancelled >= job) return;
+    const y1 = Math.min(y + BAND, HEIGHT);
+    wasm.render_rows(WIDTH, HEIGHT, SAMPLES, y, y1, seed);
+    // Read memory fresh: the buffer may be replaced if the heap grows.
+    const start = wasm.framebuffer() + y * WIDTH * 4;
+    const pixels = new Uint8ClampedArray(wasm.memory.buffer, start, (y1 - y) * WIDTH * 4).slice();
+    self.postMessage({ type: 'rows', job, y, pixels, done: y1 === HEIGHT }, [pixels.buffer]);
+  }
+};
+self.postMessage({ type: 'ready', count: wasm.sphere_count(), width: WIDTH, height: HEIGHT });
