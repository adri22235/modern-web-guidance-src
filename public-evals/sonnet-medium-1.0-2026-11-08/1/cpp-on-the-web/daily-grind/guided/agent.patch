+      } else if (data.type === 'rows' && data.job === job) {
+        ctx.putImageData(new ImageData(data.pixels, canvas.width), 0, data.y);
+        if (data.done) {
+          status.textContent = `Rendered in ${((performance.now() - startTime) / 1000).toFixed(1)}s`;
+          button.disabled = false;
+        }
+      }
+    };
