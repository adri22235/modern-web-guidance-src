+// Compiles smallpt.cpp to smallpt.wasm using the Clang/LLD WebAssembly build from @yowasp/clang
+// (no Emscripten needed). Run with: node smallpt/build.mjs
+import { runClang } from '@yowasp/clang';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const dir = dirname(fileURLToPath(import.meta.url));
+const out = await runClang(
+  ['clang++', '--target=wasm32-wasip1', '-O3', '-Wall', '-Werror', '-fno-exceptions', '-fno-rtti',
+   '-mexec-model=reactor', '-Wl,--allow-undefined', 'smallpt.cpp', '-o', 'smallpt.wasm'],
+  { 'smallpt.cpp': readFileSync(join(dir, 'smallpt.cpp'), 'utf8') });
+writeFileSync(join(dir, 'smallpt.wasm'), out['smallpt.wasm']);
+console.log('wrote smallpt.wasm', out['smallpt.wasm'].length, 'bytes');
diff --git a/smallpt/smallpt.cpp b/smallpt/smallpt.cpp
