+  <script type="module">
+    const canvas = document.getElementById('tracer-canvas');
+    const ctx = canvas.getContext('2d');
+    const status = document.getElementById('tracer-status');
+    const button = document.getElementById('tracer-button');
+
+    const worker = new Worker(new URL('./smallpt/worker.js', import.meta.url), { type: 'module' });
+    let sphereCount = 0, job = 0, startTime = 0;
+
+    // Original smallpt palette: red left wall, blue right wall, grey back/floor/ceiling, black front, white balls.
+    const randomColors = () => Array.from({ length: sphereCount }, (_, i) => {
+      if (i === 3) return [0, 0, 0]; // front wall is behind the camera
+      const hue = Math.random() * 360;
+      // HSL -> RGB, kept fairly dark/saturated so the scene stays lit by bounce light
+      const s = 0.5 + Math.random() * 0.4, l = 0.3 + Math.random() * 0.25;
+      const a = s * Math.min(l, 1 - l);
+      const f = n => { const k = (n + hue / 30) % 12; return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); };
+      return [f(0), f(8), f(4)];
+    });
+
+    function render(colors) {
+      job++;
+      startTime = performance.now();
+      button.disabled = true;
+      status.textContent = 'Rendering…';
+      worker.postMessage({ type: 'cancel', job: job - 1 });
+      worker.postMessage({ job, colors, seed: Math.floor(Math.random() * 2 ** 31) });
+    }
+
+    worker.onmessage = ({ data }) => {
+      if (data.type === 'ready') {
+        sphereCount = data.count;
+        // First render uses the original smallpt colors.
+        render([[.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [0, 0, 0], [.75, .75, .75], [.75, .75, .75],
