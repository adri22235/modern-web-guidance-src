+<script>
+    const W = 320, H = 240, SAMPS = 40;
+    const canvas = document.getElementById('smallpt-canvas') as HTMLCanvasElement;
+    const btn = document.getElementById('smallpt-btn') as HTMLButtonElement;
+    const status = document.getElementById('smallpt-status') as HTMLElement;
+    const ctx = canvas.getContext('2d')!;
+    // Same as smallpt's defaults for the 6 walls + mirror + glass balls.
+    const defaults: [number, number, number][] = [
+        [.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [0, 0, 0],
+        [.75, .75, .75], [.75, .75, .75], [.999, .999, .999], [.999, .999, .999],
+    ];
+    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+    const worker = new Worker(`${base}smallpt/worker.js`, { type: 'module' });
+
+    function render(randomize: boolean) {
+        const colors = defaults.map((c, i): [number, number, number] =>
+            // Keep the (black) front wall and the mirror/glass balls untouched.
+            randomize && i !== 3 && i < 6 ? [Math.random(), Math.random(), Math.random()].map((v) => .1 + .8 * v) as [number, number, number] : c);
+        btn.disabled = true;
+        status.textContent = 'Rendering…';
+        worker.postMessage({ w: W, h: H, samps: SAMPS, seed: (Math.random() * 2 ** 32) >>> 0, colors });
+    }
+
+    worker.onmessage = ({ data }) => {
+        btn.disabled = false;
+        if (data.error) { status.textContent = `Error: ${data.error}`; return; }
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(data.rgba.buffer), data.w, data.h), 0, 0);
+        status.textContent = `Rendered in ${(data.ms / 1000).toFixed(1)}s`;
+    };
+    worker.onerror = () => { btn.disabled = false; status.textContent = 'Failed to load WebAssembly module'; };
+    btn.addEventListener('click', () => render(true));
+    render(false);
+</script>
diff --git a/wasm/build.sh b/wasm/build.sh
new file mode 100755
index 0000000..e6a17d7
--- /dev/null
+++ b/wasm/build.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+# Compiles smallpt.cpp to public/smallpt/smallpt.{js,wasm}. Requires emcc (https://emscripten.org).
+set -euo pipefail
+cd "$(dirname "$0")"
+emcc smallpt.cpp -O3 -o ../public/smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_ES6=1 -sENVIRONMENT=web,worker \
+  -sALLOW_MEMORY_GROWTH=1 \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -sEXPORTED_FUNCTIONS=_render,_set_sphere_color,_malloc,_free
diff --git a/wasm/smallpt.cpp b/wasm/smallpt.cpp
new file mode 100644
index 0000000..cd4fcf5
--- /dev/null
+++ b/wasm/smallpt.cpp
@@ -0,0 +1,135 @@
+// smallpt: a Path Tracer by Kevin Beason, 2008 (http://www.kevinbeason.com/smallpt/)
+// Adapted for WebAssembly: single-threaded (no OpenMP), exposes a C API, and lets
+// the host set the sphere colors and RNG seed.
+#include <math.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <emscripten.h>
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) { x = x_; y = y_; z = z_; }
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1 / sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(Vec &b) { return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x); }
+};
+
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0; else det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+// Scene from smallpt. Indices 0-5 are the walls, 6 and 7 the mirror/glass balls.
+static Sphere spheres[] = {
+  Sphere(1e5,  Vec( 1e5 + 1, 40.8, 81.6),   Vec(), Vec(.75, .25, .25),    DIFF), // Left
+  Sphere(1e5,  Vec(-1e5 + 99, 40.8, 81.6),  Vec(), Vec(.25, .25, .75),    DIFF), // Right
+  Sphere(1e5,  Vec(50, 40.8, 1e5),          Vec(), Vec(.75, .75, .75),    DIFF), // Back
+  Sphere(1e5,  Vec(50, 40.8, -1e5 + 170),   Vec(), Vec(),                 DIFF), // Front
+  Sphere(1e5,  Vec(50, 1e5, 81.6),          Vec(), Vec(.75, .75, .75),    DIFF), // Bottom
+  Sphere(1e5,  Vec(50, -1e5 + 81.6, 81.6),  Vec(), Vec(.75, .75, .75),    DIFF), // Top
+  Sphere(16.5, Vec(27, 16.5, 47),           Vec(), Vec(1, 1, 1) * .999,   SPEC), // Mirror
+  Sphere(16.5, Vec(73, 16.5, 78),           Vec(), Vec(1, 1, 1) * .999,   REFR), // Glass
+  Sphere(600,  Vec(50, 681.6 - .27, 81.6),  Vec(12, 12, 12), Vec(),       DIFF)  // Light
+};
+static const int numSpheres = sizeof(spheres) / sizeof(Sphere);
+
+static inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+static inline int toInt(double x) { return int(pow(clamp(x), 1 / 2.2) * 255 + .5); }
+
+static inline bool intersect(const Ray &r, double &t, int &id) {
+  double n = numSpheres, d, inf = t = 1e20;
+  for (int i = int(n); i--;) if ((d = spheres[i].intersect(r)) && d < t) { t = d; id = i; }
+  return t < inf;
+}
+
+// Small xorshift64* RNG (replaces erand48, which is not portable).
+static uint64_t rngState;
+static inline double rnd() {
+  rngState ^= rngState >> 12; rngState ^= rngState << 25; rngState ^= rngState >> 27;
+  return double((rngState * 2685821657736338717ULL) >> 11) * (1.0 / 9007199254740992.0);
+}
+
+static Vec radiance(const Ray &r, int depth) {
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+  if (++depth > 5) { if (rnd() < p) f = f * (1 / p); else return obj.e; }
+  if (obj.refl == DIFF) {
+    double r1 = 2 * M_PI * rnd(), r2 = rnd(), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth));
+  }
+  Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0) return obj.e + f.mult(radiance(reflRay, depth));
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re, RP = Re / P, TP = Tr / (1 - P);
+  return obj.e + f.mult(depth > 2
+      ? (rnd() < P ? radiance(reflRay, depth) * RP : radiance(Ray(x, tdir), depth) * TP)
+      : radiance(reflRay, depth) * Re + radiance(Ray(x, tdir), depth) * Tr);
+}
+
+static unsigned char *pixels = 0;
+
+extern "C" {
+
+// Set the diffuse color of a sphere (0-5 walls, 6 mirror, 7 glass).
+EMSCRIPTEN_KEEPALIVE void set_sphere_color(int i, double r, double g, double b) {
+  if (i >= 0 && i < numSpheres - 1) spheres[i].c = Vec(r, g, b);
+}
+
+// Render with `samps` samples per pixel (4 subpixels x samps/4). Returns RGBA bytes.
+EMSCRIPTEN_KEEPALIVE unsigned char *render(int w, int h, int samps, unsigned int seed) {
+  free(pixels);
+  pixels = (unsigned char *)malloc(w * h * 4);
+  rngState = 0x9E3779B97F4A7C15ULL ^ ((uint64_t)seed * 0xD1B54A32D192ED03ULL);
+  if (!rngState) rngState = 1;
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135;
+  int per = samps / 4 > 0 ? samps / 4 : 1;
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      Vec c;
+      for (int sy = 0; sy < 2; sy++) for (int sx = 0; sx < 2; sx++) {
+        Vec r;
+        for (int s = 0; s < per; s++) {
+          double r1 = 2 * rnd(), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+          double r2 = 2 * rnd(), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+          Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                  cy * (((sy + .5 + dy) / 2 + (h - y - 1)) / h - .5) + cam.d;
+          r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0) * (1. / per);
+        }
+        c = c + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+      }
+      unsigned char *p = pixels + (y * w + x) * 4;
+      p[0] = toInt(c.x); p[1] = toInt(c.y); p[2] = toInt(c.z); p[3] = 255;
+    }
+  }
+  return pixels;
+}
+
+}
