diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..89e05fe
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,18 @@
+// Runs the smallpt WebAssembly module off the main thread.
+import createModule from './smallpt.js';
+
+const ready = createModule();
+
+self.onmessage = async ({ data: { w, h, samps, seed, colors } }) => {
+  try {
+    const m = await ready;
+    colors.forEach(([r, g, b], i) => m._set_sphere_color(i, r, g, b));
+    const t0 = performance.now();
+    const ptr = m._render(w, h, samps, seed);
+    const ms = performance.now() - t0;
+    const rgba = m.HEAPU8.slice(ptr, ptr + w * h * 4);
+    self.postMessage({ w, h, rgba, ms }, [rgba.buffer]);
+  } catch (e) {
+    self.postMessage({ error: String(e) });
+  }
+};
