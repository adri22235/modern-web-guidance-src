+++ b/scripts/build-wasm.mjs
@@ -0,0 +1,15 @@
+// Compiles wasm/smallpt.cpp to src/wasm/smallpt.wasm using YoWASP's WASI clang/lld.
+import { runClang } from '@yowasp/clang';
+import { readFile, writeFile } from 'node:fs/promises';
+
+const source = await readFile(new URL('../wasm/smallpt.cpp', import.meta.url), 'utf8');
+const { 'smallpt.wasm': wasm } = await runClang(
+  [
+    'clang++', '--target=wasm32-wasip1', '-std=c++17', '-O3', '-Wall', '-Werror',
+    '-fno-exceptions', '-fno-rtti', '-mexec-model=reactor', '-Wl,--no-entry',
+    '-Wl,-z,stack-size=1048576', '-Wl,--strip-all', 'smallpt.cpp', '-o', 'smallpt.wasm',
+  ],
+  { 'smallpt.cpp': source },
+);
+await writeFile(new URL('../src/wasm/smallpt.wasm', import.meta.url), wasm);
+console.log(`wrote src/wasm/smallpt.wasm (${wasm.length} bytes)`);
