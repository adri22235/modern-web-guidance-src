new file mode 100644
index 0000000..1f6fef4
--- /dev/null
+++ b/src/wasm/smallpt.worker.js
@@ -0,0 +1,33 @@
+import wasmUrl from './smallpt.wasm?url';
+
+const WIDTH = 512;
+const HEIGHT = 384;
+const SAMPLES = 8; // per subpixel (x4 subpixels)
+const ROWS_PER_CHUNK = 16;
+
+const instancePromise = WebAssembly.instantiateStreaming(fetch(wasmUrl), {}).then(
+  ({ instance }) => {
+    instance.exports._initialize();
+    return instance.exports;
+  },
+);
+
+self.onmessage = async ({ data: { colors } }) => {
+  const wasm = await instancePromise;
+  // Set sphere colors (r,g,b per sphere); null keeps the original Cornell box colors.
+  if (colors) {
+    new Float64Array(wasm.memory.buffer, wasm.colors_ptr(), colors.length).set(colors);
+    wasm.use_colors();
+  }
+  for (let y = 0; y < HEIGHT; y += ROWS_PER_CHUNK) {
+    const y1 = Math.min(y + ROWS_PER_CHUNK, HEIGHT);
+    wasm.render_rows(WIDTH, HEIGHT, SAMPLES, y, y1);
+    // Read memory fresh: growth would detach an older buffer.
+    const rows = new Uint8ClampedArray(
+      wasm.memory.buffer,
+      wasm.pixels_ptr() + y * WIDTH * 4,
+      (y1 - y) * WIDTH * 4,
+    ).slice();
+    self.postMessage({ width: WIDTH, y, rows, done: y1 === HEIGHT }, [rows.buffer]);
+  }
+};
diff --git a/wasm/smallpt.cpp b/wasm/smallpt.cpp
new file mode 100644
index 0000000..d27bc0b
--- /dev/null
+++ b/wasm/smallpt.cpp
@@ -0,0 +1,145 @@
+// smallpt: a Path Tracer by Kevin Beason, 2008 (http://www.kevinbeason.com/smallpt/)
+// Adapted for WebAssembly: renders into a linear-memory RGBA buffer instead of
+// writing a PPM file, and takes the sphere colors as a parameter.
+#include <math.h>
+#include <stdlib.h>
+#include <stdint.h>
+
+#define EXPORT(name) __attribute__((export_name(name)))
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) { x = x_; y = y_; z = z_; }
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1 / sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+static const int NSPH = 9;
+static Sphere spheres[NSPH] = {
+    Sphere(1e5, Vec(1e5 + 1, 40.8, 81.6), Vec(), Vec(.75, .25, .25), DIFF),   // Left
+    Sphere(1e5, Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(.25, .25, .75), DIFF), // Right
+    Sphere(1e5, Vec(50, 40.8, 1e5), Vec(), Vec(.75, .75, .75), DIFF),         // Back
+    Sphere(1e5, Vec(50, 40.8, -1e5 + 170), Vec(), Vec(), DIFF),               // Front
+    Sphere(1e5, Vec(50, 1e5, 81.6), Vec(), Vec(.75, .75, .75), DIFF),         // Bottom
+    Sphere(1e5, Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(.75, .75, .75), DIFF), // Top
+    Sphere(16.5, Vec(27, 16.5, 47), Vec(), Vec(1, 1, 1) * .999, SPEC),        // Mirror
+    Sphere(16.5, Vec(73, 16.5, 78), Vec(), Vec(1, 1, 1) * .999, REFR),        // Glass
+    Sphere(600, Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(), DIFF)     // Light
+};
+
+static inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+static inline int toInt(double x) { return int(pow(clamp(x), 1 / 2.2) * 255 + .5); }
+
+static inline bool intersect(const Ray &r, double &t, int &id) {
+  double n = NSPH, d, inf = t = 1e20;
+  for (int i = int(n); i--;)
+    if ((d = spheres[i].intersect(r)) && d < t) { t = d; id = i; }
+  return t < inf;
+}
+
+static Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t, n = (x - obj.p).norm(),
+      nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+  if (++depth > 5) {
+    if (erand48(Xi) < p) f = f * (1 / p);
+    else return obj.e;
+  }
+  if (obj.refl == DIFF) {
+    double r1 = 2 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = sqrt(r2);
+    Vec w = nl, u = ((fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2 * n.dot(r.d)), depth, Xi));
+  }
+  Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+  if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0)
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc, R0 = a * a / (b * b),
+         c = 1 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re,
+         RP = Re / P, TP = Tr / (1 - P);
+  return obj.e + f.mult(depth > 2
+      ? (erand48(Xi) < P ? radiance(reflRay, depth, Xi) * RP
+                         : radiance(Ray(x, tdir), depth, Xi) * TP)
+      : radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+static const int MAX_W = 1024, MAX_H = 768;
+static uint8_t pixels[MAX_W * MAX_H * 4];
+static double colors[NSPH * 3];
+
+EXPORT("pixels_ptr") uint8_t *pixels_ptr() { return pixels; }
+
+// Sphere diffuse/tint colors as r,g,b triples in [0,1]; 9 spheres (see above).
+EXPORT("colors_ptr") double *colors_ptr() { return colors; }
+EXPORT("sphere_count") int sphere_count() { return NSPH; }
+
+EXPORT("use_colors") void use_colors() {
+  for (int i = 0; i < NSPH; i++)
+    if (spheres[i].e.x == 0) spheres[i].c = Vec(colors[i * 3], colors[i * 3 + 1], colors[i * 3 + 2]);
+}
+
+// Render rows [y0, y1) of a w*h image with `samps` samples per pixel (4 subpixels each).
+EXPORT("render_rows") void render_rows(int w, int h, int samps, int y0, int y1) {
+  if (w > MAX_W || h > MAX_H) return;
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135, r;
+  for (int y = y0; y < y1; y++) {
+    unsigned short Xi[3] = {0, 0, (unsigned short)(y * y * y)};
+    for (unsigned short x = 0; x < w; x++) {
+      Vec acc;
+      for (int sy = 0; sy < 2; sy++)
+        for (int sx = 0; sx < 2; sx++) {
+          r = Vec();
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + (h - y - 1)) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          acc = acc + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      uint8_t *px = &pixels[(y * w + x) * 4];
+      px[0] = toInt(acc.x); px[1] = toInt(acc.y); px[2] = toInt(acc.z); px[3] = 255;
+    }
+  }
+}
