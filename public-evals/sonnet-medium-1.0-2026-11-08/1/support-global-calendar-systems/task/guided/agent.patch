+  <script type="module">
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const CALENDARS = [
+      { id: 'islamic', locale: 'en-u-ca-islamic' },
+      { id: 'hebrew', locale: 'en-u-ca-hebrew' },
+      { id: 'japanese', locale: 'en-u-ca-japanese' },
+    ];
+    const input = document.getElementById('converter-date');
+    const esc = (v) => String(v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
+
+    function render() {
+      if (!input.value) return;
+      const iso = Temporal.PlainDate.from(input.value);
+      const timeline = Temporal.PlainDate.compare(iso, Temporal.Now.plainDateISO());
+      const relative = timeline < 0 ? 'Past' : timeline > 0 ? 'Future' : 'Today';
+
+      for (const { id, locale } of CALENDARS) {
+        const card = document.querySelector(`[data-calendar="${id}"]`);
+        const body = card.querySelector('.calendar-body') ?? card.querySelector('#islamic-date');
+        const date = iso.withCalendar(id);
+        const display = date.toLocaleString(locale, { day: 'numeric', month: 'long', year: 'numeric', era: 'long' });
+        const months = [];
+        for (let m = 1; m <= date.monthsInYear; m++) {
+          const d = date.with({ month: m });
+          months.push(`<li>${esc(d.monthCode)}: ${d.daysInMonth} days</li>`);
+        }
+        body.innerHTML = `
+          <p><strong>${esc(display)}</strong></p>
+          <dl>
+            <dt>Year</dt><dd>${date.year}</dd>
+            <dt>Month</dt><dd>${date.month}</dd>
+            <dt>Month code</dt><dd>${esc(date.monthCode)}</dd>
+            <dt>Months in year</dt><dd>${date.monthsInYear}</dd>
+            <dt>Status</dt><dd>${relative}</dd>
+          </dl>
+          <details open><summary>Months in this year</summary><ol>${months.join('')}</ol></details>`;
+      }
+    }
+
+    input.value = Temporal.Now.plainDateISO().toString();
+    input.addEventListener('input', render);
+    render();
+  </script>
 </body>
 
