+  <script>
+    (function () {
+      var CALENDARS = [
+        { id: 'islamic-date', name: 'Islamic', ca: 'islamic' },
+        { id: 'hebrew-date', name: 'Hebrew', ca: 'hebrew' },
+        { id: 'japanese-date', name: 'Japanese', ca: 'japanese' }
+      ];
+      var DAY = 86400000;
+
+      function parts(fmt, t) {
+        var o = {};
+        fmt.formatToParts(new Date(t)).forEach(function (p) { o[p.type] = p.value; });
+        return o;
+      }
+
+      function esc(str) {
+        var d = document.createElement('div');
+        d.textContent = str;
+        return d.innerHTML;
+      }
+
+      function convert(cal, t) {
+        var fmt = new Intl.DateTimeFormat('en-US-u-ca-' + cal.ca + '-nu-latn',
+          { timeZone: 'UTC', year: 'numeric', month: 'numeric', day: 'numeric', era: 'short' });
+        var full = new Intl.DateTimeFormat('en-US-u-ca-' + cal.ca + '-nu-latn',
+          { timeZone: 'UTC', dateStyle: 'full', era: 'short' });
+        var monthName = new Intl.DateTimeFormat('en-US-u-ca-' + cal.ca + '-nu-latn',
+          { timeZone: 'UTC', month: 'long' });
+        // Japanese eras can change mid-year, so group months by Gregorian year there.
+        function yearKey(x) {
+          return cal.ca === 'japanese' ? new Date(x).getUTCFullYear() : parts(fmt, x).year;
+        }
+        var key = yearKey(t);
+        var start = t;
+        while (yearKey(start - DAY) === key) start -= DAY;
+
+        var months = [];
+        var last = null;
+        for (var x = start; yearKey(x) === key; x += DAY) {
+          var p = parts(fmt, x);
+          var id = p.month + '|' + (cal.ca === 'japanese' ? '' : p.year);
+          if (id !== last) {
+            months.push({ number: +p.month, name: monthName.format(new Date(x)), days: 0 });
+            last = id;
+          }
+          months[months.length - 1].days++;
+        }
+
+        var leap = cal.ca === 'hebrew' && months.length === 13;
+        months.forEach(function (m, i) {
+          var n = i + 1;
+          if (leap && n === 6) m.code = 'M05L';
+          else if (leap && n > 6) m.code = 'M' + String(n - 1).padStart(2, '0');
+          else m.code = 'M' + String(n).padStart(2, '0');
+        });
+
+        var cur = parts(fmt, t);
+        var index = months.findIndex(function (m) { return m.number === +cur.month; });
+        return {
+          localized: full.format(new Date(t)),
+          year: cur.year + (cur.era ? ' ' + cur.era : ''),
+          month: +cur.month,
+          code: months[index].code,
+          total: months.length,
+          months: months
+        };
+      }
+
+      function render(value) {
+        if (!value) return;
+        var ymd = value.split('-').map(Number);
+        var t = Date.UTC(ymd[0], ymd[1] - 1, ymd[2]);
+        var now = new Date();
+        var today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
+        var status = t < today ? 'Past' : t > today ? 'Future' : 'Today';
+
+        CALENDARS.forEach(function (cal) {
+          var r = convert(cal, t);
+          document.getElementById(cal.id).innerHTML =
+            '<h3>' + cal.name + '</h3>' +
+            '<dl>' +
+            '<dt>Date</dt><dd class="cal-localized">' + esc(r.localized) + '</dd>' +
+            '<dt>Year</dt><dd class="cal-year">' + esc(r.year) + '</dd>' +
+            '<dt>Month</dt><dd class="cal-month">' + r.month + '</dd>' +
+            '<dt>Month code</dt><dd class="cal-month-code">' + r.code + '</dd>' +
+            '<dt>Months in year</dt><dd class="cal-months-total">' + r.total + '</dd>' +
+            '<dt>Status</dt><dd class="cal-status">' + status + '</dd>' +
+            '</dl>' +
+            '<h4>Months in this year</h4>' +
+            '<ul class="month-list">' + r.months.map(function (m) {
+              return '<li><span>' + esc(m.name) + ' (' + m.code + ')</span><span>' + m.days + ' days</span></li>';
+            }).join('') + '</ul>';
+        });
+      }
+
+      var input = document.getElementById('converter-date');
+      var n = new Date();
+      input.value = n.getFullYear() + '-' + String(n.getMonth() + 1).padStart(2, '0') + '-' + String(n.getDate()).padStart(2, '0');
+      input.addEventListener('input', function () { render(input.value); });
+      render(input.value);
+    })();
+  </script>
+
 </body>
 
