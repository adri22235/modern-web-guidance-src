+    /* Progress */
+    .progress-panel {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-bottom: 40px;
+    }
+
+    .progress-panel h2 {
+      font-size: 1.25rem;
+      color: var(--primary);
+      margin-bottom: 15px;
+    }
+
+    .progress-item + .progress-item {
+      margin-top: 20px;
+    }
+
+    .progress-item label {
+      display: flex;
+      justify-content: space-between;
+      font-size: 0.9rem;
+      font-weight: 600;
+      margin-bottom: 6px;
+    }
+
+    progress {
+      appearance: none;
+      border: 0 solid;
+      overflow: clip;
+      inline-size: 100%;
+      block-size: 14px;
+      --progress-bar-radius: 1e5px;
+      --progress-bar-track: var(--secondary);
+      --progress-bar-fill: var(--primary);
+      border-radius: var(--progress-bar-radius);
+      background: var(--progress-bar-track);
+      box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.15);
+      container-type: inline-size;
+      --progress-bar-indeterminate-size: 30%;
+      --progress-bar-indeterminate-animation-duration: 1.5s;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      progress {
+        --progress-bar-indeterminate-animation-duration: 10s;
+      }
+    }
+
+    progress:indeterminate {
+      --progress-bar-fill: var(--accent);
+      --progress-bar-animation: progress-bar-indeterminate var(--progress-bar-indeterminate-animation-duration) infinite linear;
+    }
+
+    progress:dir(rtl):indeterminate {
+      --progress-bar-animation: progress-bar-indeterminate var(--progress-bar-indeterminate-animation-duration) infinite linear reverse;
+    }
+
+    progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    progress::-webkit-progress-value {
+      background: var(--progress-bar-fill);
+      border-radius: var(--progress-bar-radius);
+      transition: inline-size 0.3s;
+      animation: var(--progress-bar-animation, revert-rule);
+    }
+
+    progress::-moz-progress-bar {
+      background: var(--progress-bar-fill);
+      border-radius: var(--progress-bar-radius);
+      transition: inline-size 0.3s;
+      animation: var(--progress-bar-animation, revert-rule);
+    }
+
+    @keyframes progress-bar-indeterminate {
+      from, to {
+        inline-size: var(--progress-bar-indeterminate-size);
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
