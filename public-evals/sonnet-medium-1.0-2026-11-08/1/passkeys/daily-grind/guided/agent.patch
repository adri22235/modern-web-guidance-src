@@ -0,0 +1,27 @@
+# Passkeys in My Account
+
+The "My Account" nav link opens a dialog (`index.html`, `account.js`, `api.js`) that supports passkey
+sign-in (autofill + button), account creation with a passkey, listing/renaming/deleting passkeys,
+profile updates, and reauthentication before deletes and profile changes.
+
+This repo is a static site, so the backend is not included. Implement these endpoints with a vetted
+WebAuthn library (e.g. SimpleWebAuthn). All IDs are unpadded Base64URL; `rp.id`/`rpId` is a server constant.
+
+| Endpoint | Purpose |
+|---|---|
+| `GET /api/session` | `{signedIn, user:{name, displayName}}` |
+| `POST /api/register` `{name, displayName}` | Create account + session (409 if taken) |
+| `POST /api/logout` | End session |
+| `POST /api/passkeys/register/options` `{promotion}` | Creation options (`residentKey: required`, `excludeCredentials`, `authenticatorAttachment: platform` only if `promotion`) |
+| `POST /api/passkeys/register/verify` | Verify attestation; store AAGUID-derived `name`/`providerIcon` |
+| `POST /api/passkeys/login/options` | Request options, `allowCredentials: []` |
+| `POST /api/passkeys/login/verify` | Verify assertion, start session; **404** if credential unknown |
+| `POST /api/reauth/options` | Request options with `allowCredentials` = the user's credentials |
+| `POST /api/reauth/verify` | Verify; credential must belong to the session user; **404** if unknown |
+| `GET /api/credentials` | `{rpId, userId, credentials:[{id,name,providerIcon,registeredAt,lastUsedAt}]}` |
+| `PUT /api/credential/:id` `{name}` / `DELETE /api/credential/:id` | Rename / delete (owner only) |
+| `PUT /api/user` `{name, displayName}` | Returns the user plus `rpId` and `userId` |
+
+Enforce fresh reauthentication server-side for `DELETE /api/credential/:id` and `PUT /api/user`;
+the client prompt alone is not a security control.
+`vendor/webauthn-polyfills.js` is `webauthn-polyfills@0.1.7` bundled locally for older browsers.
diff --git a/account.js b/account.js
new file mode 100644
index 0000000..c1e6f3f
--- /dev/null
+++ b/account.js
@@ -0,0 +1,356 @@
+import './vendor/webauthn-polyfills.js';
+import * as api from './api.js';
+
+const $ = (id) => document.getElementById(id);
+const dialog = $('account-dialog');
+const status = $('account-status');
+const signedOut = $('account-signed-out');
+const signedIn = $('account-signed-in');
+const list = $('passkey-list');
+const createBtn = $('create-passkey');
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+let autofillAbort = new AbortController();
+let user = null;
+
+function say(message, isError = false) {
+  status.textContent = message;
+  status.classList.toggle('error', isError);
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, length % 4 !== 1
+const isBase64Url = (v) => typeof v === 'string' && v.length > 0 && v.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(v);
+
+async function passkeysSupported() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return false;
+  try {
+    const caps = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(caps.passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+async function conditionalSupported() {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) return false;
+  try {
+    return (await PublicKeyCredential.getClientCapabilities()).conditionalGet === true;
+  } catch {
+    return false;
+  }
+}
+
+async function signalUnknown(publicKey, credentialId) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({
+      rpId: publicKey.rpId ?? publicKey.rp?.id, // server-provided, never location.hostname
+      credentialId,
+    });
+  } catch (e) {
+    console.warn('signalUnknownCredential warning:', e);
+  }
+}
+
+// ---------- Session / view switching ----------
+
+async function refreshSession() {
+  let data = { signedIn: false };
+  try {
+    const res = await api.sessionFetch();
+    if (res.ok) data = await res.json();
+  } catch {
+    /* offline: treat as signed out */
+  }
+  user = data.signedIn ? data.user : null;
+  signedOut.hidden = Boolean(user);
+  signedIn.hidden = !user;
+  $('logout-link').hidden = !user;
+  if (user) {
+    $('account-greeting').textContent = `Signed in as ${user.displayName || user.name}`;
+    $('profile-name').value = user.name;
+    $('profile-display-name').value = user.displayName || '';
+    await loadPasskeys();
+  } else {
+    startConditionalSignIn();
+  }
+}
+
+// ---------- Sign-in (autofill + button) ----------
+
+async function finishSignIn(credential, publicKey) {
+  const encoded = credential.toJSON();
+  try {
+    const res = await api.loginVerifyFetch(encoded);
+    if (res.ok) {
+      say('Signed in.');
+      await refreshSession();
+    } else {
+      if (res.status === 404) await signalUnknown(publicKey, encoded.id);
+      say('We could not sign you in with that passkey.', true);
+    }
+  } catch (e) {
+    console.warn('Sign-in verification failed:', e);
+    say('Network error while signing in. Please try again.', true);
+  }
+}
+
+async function startConditionalSignIn() {
+  autofillAbort.abort();
+  autofillAbort = new AbortController();
+  if (!(await conditionalSupported())) return;
+  try {
+    const res = await api.loginOptionsFetch();
+    if (!res.ok) return;
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    const credential = await navigator.credentials.get({
+      publicKey,
+      signal: autofillAbort.signal,
+      mediation: 'conditional',
+    });
+    if (credential) await finishSignIn(credential, publicKey);
+  } catch (err) {
+    if (!['NotAllowedError', 'AbortError'].includes(err.name)) console.warn('Conditional get error:', err);
+  }
+}
+
+async function signInWithPasskey() {
+  autofillAbort.abort(); // avoid colliding with the pending conditional request
+  autofillAbort = new AbortController();
+  try {
+    const res = await api.loginOptionsFetch();
+    if (!res.ok) throw new Error('options');
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    const credential = await navigator.credentials.get({ publicKey });
+    await finishSignIn(credential, publicKey);
+  } catch (err) {
+    if (err.name === 'NotAllowedError') say('Passkey sign-in was cancelled.');
+    else if (err.name !== 'AbortError') say('Passkey sign-in is unavailable right now.', true);
+    startConditionalSignIn(); // re-arm autofill
+  }
+}
+
+// ---------- Registration ----------
+
+/** Creates a passkey for the signed-in user. Returns true on success. */
+async function createPasskey({ promotion = false } = {}) {
+  let publicKey;
+  try {
+    const res = await api.registerOptionsFetch({ promotion });
+    if (!res.ok) throw new Error('options');
+    publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await res.json());
+  } catch {
+    say('Could not start passkey creation. Please try again.', true);
+    return false;
+  }
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') say('A passkey from this provider already exists for your account.', true);
+    else if (err.name === 'SecurityError') say('Passkeys are not available on this site configuration.', true);
+    else if (err.name === 'NotAllowedError') say('Passkey creation was cancelled.');
+    return false;
+  }
+
+  const encoded = credential.toJSON();
+  let ok = false;
+  try {
+    ok = (await api.registerVerifyFetch(encoded)).ok;
+  } catch (e) {
+    console.warn('Registration verification failed:', e);
+  }
+  if (!ok) {
+    if (PublicKeyCredential.signalUnknownCredential) {
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId: publicKey.rp.id, credentialId: encoded.id });
+      } catch (e) {
+        console.warn('signalUnknownCredential warning:', e);
+      }
+    }
+    say('We could not save your passkey. Please try again.', true);
+    return false;
+  }
+  say('Passkey created.');
+  return true;
+}
+
+async function signUp(event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const data = Object.fromEntries(new FormData(form));
+  try {
+    const res = await api.signUpFetch({ name: data.email, displayName: data.displayName });
+    if (!res.ok) {
+      say(res.status === 409 ? 'An account with that email already exists. Sign in instead.' : 'Could not create your account.', true);
+      return;
+    }
+  } catch {
+    say('Network error while creating your account.', true);
+    return;
+  }
+  autofillAbort.abort();
+  form.reset();
+  await refreshSession();
+  if (await passkeysSupported()) {
+    if (await createPasskey({ promotion: true })) await loadPasskeys();
+  }
+}
+
+// ---------- Reauthentication ----------
+
+/** Verifies the signed-in user with one of their own passkeys before a sensitive action. */
+async function reauthenticate() {
+  if (!(await passkeysSupported())) return true; // nothing to step up with; server session rules apply
+  try {
+    const res = await api.reauthOptionsFetch();
+    if (!res.ok) throw new Error('options');
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    if (!publicKey.allowCredentials?.length) return true; // no passkeys to verify with
+    const credential = await navigator.credentials.get({ publicKey });
+    const encoded = credential.toJSON();
+    const verify = await api.reauthVerifyFetch(encoded);
+    if (verify.ok) return true;
+    if (verify.status === 404) await signalUnknown(publicKey, encoded.id);
+    say('We could not verify your identity.', true);
+  } catch (err) {
+    if (err.name === 'NotAllowedError') say('Verification was cancelled.');
+    else say('Verification failed. Please try again.', true);
+  }
+  return false;
+}
+
+// ---------- Management ----------
+
+async function syncAccepted({ rpId, userId, credentials }) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const ids = credentials.map((c) => c.id);
+  if (!rpId || !isBase64Url(userId) || !ids.every(isBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId/userId/credential IDs.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds: ids });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+function renderPasskeys(credentials) {
+  list.replaceChildren();
+  $('passkey-empty').hidden = credentials.length > 0;
+  for (const c of credentials) {
+    const row = $('passkey-row').content.firstElementChild.cloneNode(true);
+    const icon = row.querySelector('img');
+    if (c.providerIcon) icon.src = c.providerIcon;
+    else icon.hidden = true;
+    row.querySelector('.pk-name').textContent = c.name;
+    const used = c.lastUsedAt ? `Last used ${dateFmt.format(c.lastUsedAt)}` : 'Never used';
+    row.querySelector('.pk-meta').textContent = `Created ${dateFmt.format(c.registeredAt)} · ${used}`;
+    row.dataset.id = c.id;
+    row.querySelector('.pk-rename').setAttribute('aria-label', `Rename ${c.name}`);
+    row.querySelector('.pk-delete').setAttribute('aria-label', `Delete ${c.name}`);
+    list.append(row);
+  }
+}
+
+async function loadPasskeys() {
+  createBtn.hidden = !(await passkeysSupported());
+  try {
+    const res = await api.listFetch();
+    if (!res.ok) throw new Error('list');
+    const data = await res.json();
+    renderPasskeys(data.credentials);
+    await syncAccepted(data);
+  } catch {
+    say('Could not load your passkeys.', true);
+  }
+}
+
+async function renamePasskey(row) {
+  const current = row.querySelector('.pk-name').textContent;
+  const name = prompt('Name this passkey', current)?.trim();
+  if (!name || name === current) return;
+  const res = await api.renameCredentialFetch(row.dataset.id, { name });
+  say(res.ok ? 'Passkey renamed.' : 'Could not rename passkey.', !res.ok);
+  if (res.ok) await loadPasskeys();
+}
+
+async function deletePasskey(row) {
+  const name = row.querySelector('.pk-name').textContent;
+  if (!confirm(`Delete the passkey “${name}”? You won't be able to sign in with it again.`)) return;
+  if (!(await reauthenticate())) return;
+  const res = await api.deleteFetch(row.dataset.id);
+  say(res.ok ? 'Passkey deleted.' : 'Could not delete passkey.', !res.ok);
+  if (res.ok) await loadPasskeys(); // re-syncs remaining credentials via signalAllAcceptedCredentials
+}
+
+async function updateProfile(event) {
+  event.preventDefault();
+  const name = $('profile-name').value.trim();
+  const displayName = $('profile-display-name').value.trim();
+  if (!(await reauthenticate())) return;
+  const res = await api.updateUserFetch({ name, displayName });
+  if (!res.ok) return say('Could not update your profile.', true);
+  const data = await res.json();
+  user = { ...user, name: data.name ?? name, displayName: data.displayName ?? displayName };
+  $('account-greeting').textContent = `Signed in as ${user.displayName || user.name}`;
+  say('Profile updated.');
+  if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+    if (!data.rpId || !isBase64Url(data.userId)) {
+      console.warn('signalCurrentUserDetails skipped: invalid rpId/userId.');
+      return;
+    }
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId: data.rpId,
+        userId: data.userId,
+        name: user.name,
+        displayName: user.displayName,
+      });
+    } catch (e) {
+      console.warn('signalCurrentUserDetails sync warning:', e);
+    }
+  }
+}
+
+async function logout() {
+  await api.logoutFetch().catch(() => {});
+  say('Signed out.');
+  await refreshSession();
+}
+
+// ---------- Wiring ----------
+
+$('account-link').addEventListener('click', (event) => {
+  event.preventDefault(); // /account stays as the no-JS fallback
+  say('');
+  dialog.showModal();
+  refreshSession();
+});
+$('account-close').addEventListener('click', () => dialog.close());
+dialog.addEventListener('close', () => autofillAbort.abort());
+dialog.addEventListener('click', (event) => {
+  if (event.target === dialog) dialog.close(); // light dismiss on backdrop
+});
+$('passkey-signin').addEventListener('click', signInWithPasskey);
+$('signup-form').addEventListener('submit', signUp);
+$('profile-form').addEventListener('submit', updateProfile);
+$('logout-link').addEventListener('click', (event) => {
+  event.preventDefault();
+  logout();
+});
+createBtn.addEventListener('click', async () => {
+  createBtn.disabled = true;
+  if (await createPasskey()) await loadPasskeys();
+  createBtn.disabled = false;
+});
+list.addEventListener('click', (event) => {
+  const row = event.target.closest('li');
+  if (!row) return;
+  if (event.target.closest('.pk-rename')) renamePasskey(row);
+  else if (event.target.closest('.pk-delete')) deletePasskey(row);
+});
+
+if (!(await passkeysSupported())) $('passkey-signin').hidden = true;
