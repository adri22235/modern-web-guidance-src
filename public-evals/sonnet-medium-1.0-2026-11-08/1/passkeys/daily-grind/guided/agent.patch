+// Thin client for the Daily Grind account API (see PASSKEYS.md for the server contract).
+const send = (method, url, body) =>
+  fetch(url, {
+    method,
+    credentials: 'same-origin',
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+
+export const sessionFetch = () => send('GET', '/api/session');
+export const signUpFetch = (profile) => send('POST', '/api/register', profile);
+export const logoutFetch = () => send('POST', '/api/logout');
+
+// Registration (create a passkey for the signed-in user)
+export const registerOptionsFetch = (opts) => send('POST', '/api/passkeys/register/options', opts);
+export const registerVerifyFetch = (credential) => send('POST', '/api/passkeys/register/verify', credential);
+
+// Primary sign-in (discoverable credentials)
+export const loginOptionsFetch = () => send('POST', '/api/passkeys/login/options');
+export const loginVerifyFetch = (credential) => send('POST', '/api/passkeys/login/verify', credential);
+
+// Reauthentication (allowCredentials limited to the signed-in user)
+export const reauthOptionsFetch = () => send('POST', '/api/reauth/options');
+export const reauthVerifyFetch = (credential) => send('POST', '/api/reauth/verify', credential);
+
+// Management
+export const listFetch = () => send('GET', '/api/credentials');
+export const renameCredentialFetch = (id, body) => send('PUT', `/api/credential/${encodeURIComponent(id)}`, body);
+export const deleteFetch = (id) => send('DELETE', `/api/credential/${encodeURIComponent(id)}`);
+export const updateUserFetch = (body) => send('PUT', '/api/user', body);
