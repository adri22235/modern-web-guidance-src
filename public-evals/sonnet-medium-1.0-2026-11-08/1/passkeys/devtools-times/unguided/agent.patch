@@ -0,0 +1,32 @@
+import React, { useState } from 'react';
+import { authenticateWithPasskey, friendlyError, passkeysSupported } from '../utils/passkeyClient';
+
+export default function PasskeySignInButton({ onSuccess, onError }: { onSuccess: (username: string) => void; onError: (message: string) => void }) {
+  const [loading, setLoading] = useState(false);
+  const [supported] = useState(passkeysSupported);
+  if (!supported) return null;
+
+  const handleClick = async () => {
+    setLoading(true);
+    try {
+      const { username } = await authenticateWithPasskey();
+      onSuccess(username);
+    } catch (e) {
+      onError(friendlyError(e));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={handleClick}
+      disabled={loading}
+      data-skip-tracking="true"
+      className={`w-full py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${loading ? 'opacity-75 cursor-not-allowed' : ''}`}
+    >
+      {loading ? 'Waiting for passkey...' : 'Sign in with a passkey'}
+    </button>
+  );
+}
