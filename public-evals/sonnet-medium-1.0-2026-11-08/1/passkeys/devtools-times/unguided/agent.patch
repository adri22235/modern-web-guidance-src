@@ -0,0 +1,41 @@
+import type { APIRoute } from 'astro';
+import { randomBytes } from 'node:crypto';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import { currentUser, getOrCreateUser, getUser, isRecentlyAuthenticated, json, rpInfo } from '../../../utils/passkeys';
+
+// Signed in: add a passkey to the current account (requires recent authentication).
+// Signed out: `{ username }` starts passkey sign-up for a new, unused username.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { rpID, rpName } = rpInfo(request);
+  const body = await request.json().catch(() => ({}));
+  const current = await currentUser(session);
+
+  let username: string;
+  let signup = false;
+  if (current) {
+    if (!isRecentlyAuthenticated(current)) return json({ error: 'Please confirm your identity first', code: 'REAUTH_REQUIRED' }, 401);
+    username = current.username;
+  } else {
+    username = String(body.username ?? '').trim();
+    if (!/^[\w.-]{3,40}$/.test(username)) return json({ error: 'Username must be 3-40 letters, numbers, dots, dashes or underscores' }, 400);
+    if (getUser(username)) return json({ error: 'That username is already taken' }, 409);
+    signup = true;
+  }
+
+  // Signup users are only persisted once verification succeeds.
+  const existing = getUser(username);
+  const userId = existing?.userId ?? (signup ? randomBytes(16).toString('base64url') : getOrCreateUser(username).userId);
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userName: username,
+    userID: new TextEncoder().encode(userId),
+    attestationType: 'none',
+    excludeCredentials: (existing?.passkeys ?? []).map((p) => ({ id: p.id, transports: p.transports as any })),
+    authenticatorSelection: { residentKey: 'required', userVerification: 'preferred' },
+  });
+
+  await session!.set('passkeyRegistration', { challenge: options.challenge, username, userId, signup });
+  return json(options);
+};
