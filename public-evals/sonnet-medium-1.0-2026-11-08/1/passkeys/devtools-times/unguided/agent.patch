index 0000000..8fd498e
--- /dev/null
+++ b/src/pages/api/passkeys/auth-options.ts
@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { currentUser, getUser, json, rpInfo } from '../../../utils/passkeys';
+
+// `{ reauth: true }` limits the ceremony to the signed-in user's passkeys; otherwise
+// credentials are discoverable (usernameless) unless a `username` hint is given.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { rpID } = rpInfo(request);
+  const body = await request.json().catch(() => ({}));
+  let username: string | undefined = body.username?.trim() || undefined;
+  if (body.reauth) {
+    const current = await currentUser(session);
+    if (!current) return json({ error: 'Not signed in' }, 401);
+    username = current.username;
+  }
+  const user = username ? getUser(username) : undefined;
+  if (body.reauth && !user?.passkeys.length) return json({ error: 'No passkeys registered' }, 404);
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    userVerification: 'preferred',
+    allowCredentials: user?.passkeys.map((p) => ({ id: p.id, transports: p.transports as any })),
+  });
+  await session!.set('passkeyAuth', { challenge: options.challenge, reauth: !!body.reauth, username: body.reauth ? username : undefined });
+  return json(options);
+};
diff --git a/src/pages/api/passkeys/auth-verify.ts b/src/pages/api/passkeys/auth-verify.ts
new file mode 100644
index 0000000..3ba9173
--- /dev/null
+++ b/src/pages/api/passkeys/auth-verify.ts
@@ -0,0 +1,50 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { findByCredentialId, json, rpInfo, startSession, updatePasskey } from '../../../utils/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { rpID, origin } = rpInfo(request);
+  const { response } = await request.json();
+  const pending = await session?.get('passkeyAuth');
+  if (!pending) return json({ error: 'No authentication in progress' }, 400);
+  await session!.delete('passkeyAuth');
+
+  const found = findByCredentialId(response?.id);
+  if (!found) return json({ error: 'Unknown passkey' }, 400);
+  const { user, passkey } = found;
+  if (pending.reauth && user.username.toLowerCase() !== pending.username?.toLowerCase()) {
+    return json({ error: 'Passkey belongs to a different account' }, 403);
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: Buffer.from(passkey.publicKey, 'base64url'),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  updatePasskey(user.username, passkey.id, {
+    counter: verification.authenticationInfo.newCounter,
+    lastUsedAt: new Date().toISOString(),
+  });
+
+  if (pending.reauth) {
+    const current = await session!.get('user');
+    await session!.set('user', { ...current, authenticatedAt: Date.now() });
+  } else {
+    await startSession(session, user.username, 'passkey');
+  }
+  return json({ verified: true, username: user.username });
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
