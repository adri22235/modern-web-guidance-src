@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { currentUser, getUser, isRecentlyAuthenticated, json, removePasskey, updatePasskey } from '../../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const current = await currentUser(session);
+  if (!current) return json({ error: 'Not signed in' }, 401);
+  const passkeys = (getUser(current.username)?.passkeys ?? []).map(({ publicKey, counter, ...p }) => p);
+  return json({ passkeys });
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const current = await currentUser(session);
+  if (!current) return json({ error: 'Not signed in' }, 401);
+  const { id, name } = await request.json();
+  const trimmed = String(name ?? '').trim().slice(0, 60);
+  if (!id || !trimmed) return json({ error: 'id and name are required' }, 400);
+  if (!getUser(current.username)?.passkeys.some((p) => p.id === id)) return json({ error: 'Not found' }, 404);
+  updatePasskey(current.username, id, { name: trimmed });
+  return json({ ok: true });
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const current = await currentUser(session);
+  if (!current) return json({ error: 'Not signed in' }, 401);
+  if (!isRecentlyAuthenticated(current)) return json({ error: 'Please confirm your identity first', code: 'REAUTH_REQUIRED' }, 401);
+  const { id } = await request.json();
+  if (!removePasskey(current.username, id)) return json({ error: 'Not found' }, 404);
+  return json({ ok: true });
+};
