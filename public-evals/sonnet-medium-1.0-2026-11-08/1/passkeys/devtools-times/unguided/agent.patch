+import type { APIRoute } from 'astro';
+import { currentUser, json, isRecentlyAuthenticated } from '../../../utils/passkeys';
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await currentUser(session);
+  if (!user) return json({ user: null });
+  return json({ user: { username: user.username, method: user.method, recentlyAuthenticated: isRecentlyAuthenticated(user) } });
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  session?.destroy();
+  return json({ ok: true });
+};
