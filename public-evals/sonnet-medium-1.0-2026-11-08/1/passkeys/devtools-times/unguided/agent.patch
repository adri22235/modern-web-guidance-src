@@ -0,0 +1,45 @@
+import { startAuthentication, startRegistration, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+
+const base = import.meta.env.BASE_URL;
+const api = (path: string) => `${base}api/${path}`.replace(/\/{2,}/g, '/');
+
+export class ApiError extends Error {
+  constructor(message: string, public code?: string) {
+    super(message);
+  }
+}
+
+export async function call<T = any>(path: string, method = 'POST', body?: unknown): Promise<T> {
+  const res = await fetch(api(path), {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(data.error || 'Request failed', data.code);
+  return data;
+}
+
+export const passkeysSupported = () => typeof window !== 'undefined' && browserSupportsWebAuthn();
+
+const cancelled = (e: unknown) => (e as Error)?.name === 'NotAllowedError' || (e as Error)?.name === 'AbortError';
+
+export function friendlyError(e: unknown): string {
+  if (cancelled(e)) return 'Passkey request was cancelled or timed out.';
+  if ((e as Error)?.name === 'InvalidStateError') return 'This passkey is already registered on this device.';
+  return (e as Error)?.message || 'Something went wrong with your passkey.';
+}
+
+/** Register a passkey. Pass `username` when signing up; omit when signed in. */
+export async function registerPasskey(opts: { username?: string; name?: string } = {}) {
+  const optionsJSON = await call('passkeys/register-options', 'POST', { username: opts.username });
+  const response = await startRegistration({ optionsJSON });
+  return call<{ username: string }>('passkeys/register-verify', 'POST', { response, name: opts.name });
+}
+
+/** Authenticate with a passkey. `reauth` confirms the signed-in user instead of signing in. */
+export async function authenticateWithPasskey(opts: { reauth?: boolean; username?: string } = {}) {
+  const optionsJSON = await call('passkeys/auth-options', 'POST', opts);
+  const response = await startAuthentication({ optionsJSON });
+  return call<{ username: string }>('passkeys/auth-verify', 'POST', { response });
+}
diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..5078187
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,113 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { randomBytes } from 'node:crypto';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url COSE public key
+  counter: number;
+  transports?: string[];
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export interface PasskeyUser {
+  username: string;
+  userId: string; // base64url WebAuthn user handle
+  passkeys: StoredPasskey[];
+}
+
+const FILE = path.resolve(process.env.PASSKEY_STORE ?? 'passkeys.db.json');
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+function load(): Record<string, PasskeyUser> {
+  try {
+    return JSON.parse(fs.readFileSync(FILE, 'utf8'));
+  } catch {
+    return {};
+  }
+}
+
+function save(db: Record<string, PasskeyUser>) {
+  fs.writeFileSync(FILE, JSON.stringify(db, null, 2));
+}
+
+const key = (username: string) => username.trim().toLowerCase();
+
+export function getUser(username: string): PasskeyUser | undefined {
+  return load()[key(username)];
+}
+
+export function getUserByHandle(userId: string): PasskeyUser | undefined {
+  return Object.values(load()).find((u) => u.userId === userId);
+}
+
+export function findByCredentialId(id: string) {
+  for (const user of Object.values(load())) {
+    const passkey = user.passkeys.find((p) => p.id === id);
+    if (passkey) return { user, passkey };
+  }
+}
+
+export function getOrCreateUser(username: string, userId?: string): PasskeyUser {
+  const db = load();
+  const k = key(username);
+  if (!db[k]) {
+    db[k] = { username: username.trim(), userId: userId ?? randomBytes(16).toString('base64url'), passkeys: [] };
+    save(db);
+  }
+  return db[k];
+}
+
+export function addPasskey(username: string, passkey: StoredPasskey) {
+  const db = load();
+  db[key(username)].passkeys.push(passkey);
+  save(db);
+}
+
+export function updatePasskey(username: string, id: string, patch: Partial<StoredPasskey>) {
+  const db = load();
+  const p = db[key(username)]?.passkeys.find((x) => x.id === id);
+  if (p) Object.assign(p, patch);
+  save(db);
+}
+
+export function removePasskey(username: string, id: string): boolean {
+  const db = load();
+  const user = db[key(username)];
+  if (!user) return false;
+  const before = user.passkeys.length;
+  user.passkeys = user.passkeys.filter((p) => p.id !== id);
+  save(db);
+  return user.passkeys.length < before;
+}
+
+export function rpInfo(request: Request) {
+  const url = new URL(request.url);
+  const host = request.headers.get('x-forwarded-host') ?? url.host;
+  const proto = request.headers.get('x-forwarded-proto') ?? url.protocol.replace(':', '');
+  return {
+    rpID: process.env.PASSKEY_RP_ID ?? host.split(':')[0],
+    origin: process.env.PASSKEY_ORIGIN ?? `${proto}://${host}`,
+    rpName: 'The DevTools Times',
+  };
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export type SessionUser = { username: string; authenticatedAt: number; method: 'password' | 'passkey' };
+
+export async function startSession(session: any, username: string, method: SessionUser['method']) {
+  session.regenerate?.();
+  await session.set('user', { username, authenticatedAt: Date.now(), method } satisfies SessionUser);
+}
+
+export async function currentUser(session: any): Promise<SessionUser | undefined> {
+  return (await session?.get('user')) ?? undefined;
+}
+
+export const isRecentlyAuthenticated = (u: SessionUser) => Date.now() - u.authenticatedAt < REAUTH_WINDOW_MS;
