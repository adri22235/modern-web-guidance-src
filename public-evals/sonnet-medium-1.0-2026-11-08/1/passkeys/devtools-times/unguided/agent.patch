+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,31 @@
+import type { APIRoute } from 'astro';
+import { json, startSession } from '../../../utils/passkeys';
+
+const BACKEND = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Verifies a password against the backend. With `reauth: true` the credentials must
+// belong to the signed-in user and only refresh the session's authentication time.
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password, reauth } = await request.json();
+  if (!username || !password) return json({ error: 'Username and password are required' }, 400);
+
+  const current = await session?.get('user');
+  if (reauth && (!current || current.username.toLowerCase() !== String(username).toLowerCase())) {
+    return json({ error: 'Not signed in as this user' }, 403);
+  }
+
+  const response = await fetch(BACKEND, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) return json({ error: data.error || 'Unknown error' }, response.status);
+
+  if (reauth) {
+    await session!.set('user', { ...current, authenticatedAt: Date.now() });
+  } else {
+    await startSession(session, username, 'password');
+  }
+  return json({ ok: true, username });
+};
