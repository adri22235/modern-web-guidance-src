@@ -0,0 +1,41 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { addPasskey, getOrCreateUser, getUser, json, rpInfo, startSession } from '../../../utils/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { rpID, origin } = rpInfo(request);
+  const { response, name } = await request.json();
+  const pending = await session?.get('passkeyRegistration');
+  if (!pending) return json({ error: 'No registration in progress' }, 400);
+  await session!.delete('passkeyRegistration');
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+    });
+  } catch (e) {
+    return json({ error: (e as Error).message }, 400);
+  }
+  if (!verification.verified || !verification.registrationInfo) return json({ error: 'Verification failed' }, 400);
+
+  if (pending.signup && getUser(pending.username)) return json({ error: 'That username is already taken' }, 409);
+  const user = getOrCreateUser(pending.username, pending.userId);
+  const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  addPasskey(user.username, {
+    id: credential.id,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports,
+    name: String(name || '').trim().slice(0, 60) || `Passkey ${user.passkeys.length + 1}`,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    createdAt: new Date().toISOString(),
+  });
+
+  if (pending.signup) await startSession(session, user.username, 'passkey');
+  return json({ verified: true, username: user.username });
+};
