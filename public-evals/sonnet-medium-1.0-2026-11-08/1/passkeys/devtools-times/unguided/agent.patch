new file mode 100644
index 0000000..974ef51
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,203 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  ApiError, authenticateWithPasskey, call, friendlyError, passkeysSupported, registerPasskey,
+} from '../utils/passkeyClient';
+
+interface Passkey {
+  id: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+interface Me { username: string; method: string; recentlyAuthenticated: boolean }
+
+const btn = 'py-2 px-4 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-75';
+const primary = `${btn} text-white bg-gray-900 hover:bg-gray-800`;
+const secondary = `${btn} border border-gray-300 text-gray-900 bg-white hover:bg-gray-50`;
+const fmt = (d?: string) => (d ? new Date(d).toLocaleDateString(undefined, { dateStyle: 'medium' }) : 'Never');
+
+export default function AccountSettings() {
+  const [me, setMe] = useState<Me | null | undefined>(undefined);
+  const [passkeys, setPasskeys] = useState<Passkey[]>([]);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [name, setName] = useState('');
+  const [editing, setEditing] = useState<{ id: string; name: string } | null>(null);
+  // Action to run once the user has re-authenticated
+  const [reauth, setReauth] = useState<{ retry: () => Promise<void> } | null>(null);
+  const [password, setPassword] = useState('');
+  const supported = passkeysSupported();
+
+  const refresh = useCallback(async () => {
+    const { user } = await call<{ user: Me | null }>('auth/me', 'GET');
+    setMe(user);
+    if (user) setPasskeys((await call<{ passkeys: Passkey[] }>('passkeys', 'GET')).passkeys);
+  }, []);
+
+  useEffect(() => { refresh().catch(() => setMe(null)); }, [refresh]);
+
+  // Runs a sensitive action; if the server asks for fresh authentication, prompts and retries.
+  const guarded = (action: () => Promise<void>) => async () => {
+    setError(null);
+    setNotice(null);
+    setBusy(true);
+    try {
+      await action();
+    } catch (e) {
+      if (e instanceof ApiError && e.code === 'REAUTH_REQUIRED') setReauth({ retry: guarded(action) });
+      else setError(friendlyError(e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const addPasskey = guarded(async () => {
+    await registerPasskey({ name: name.trim() || undefined });
+    setName('');
+    setNotice('Passkey added.');
+    await refresh();
+  });
+
+  const removePasskey = (p: Passkey) => guarded(async () => {
+    if (!window.confirm(`Remove passkey "${p.name}"?`)) return;
+    await call('passkeys', 'DELETE', { id: p.id });
+    setNotice('Passkey removed.');
+    await refresh();
+  })();
+
+  const rename = guarded(async () => {
+    if (!editing) return;
+    await call('passkeys', 'PATCH', editing);
+    setEditing(null);
+    await refresh();
+  });
+
+  const finishReauth = async () => {
+    const retry = reauth!.retry;
+    setReauth(null);
+    setPassword('');
+    await retry();
+  };
+
+  const reauthWithPasskey = async () => {
+    setError(null);
+    try {
+      await authenticateWithPasskey({ reauth: true });
+      await finishReauth();
+    } catch (e) {
+      setError(friendlyError(e));
+    }
+  };
+
+  const reauthWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    try {
+      await call('auth/login', 'POST', { username: me!.username, password, reauth: true });
+      await finishReauth();
+    } catch (err) {
+      setError((err as Error).message);
+    }
+  };
+
+  const signOut = async () => {
+    await call('auth/me', 'DELETE');
+    window.location.href = import.meta.env.BASE_URL;
+  };
+
+  if (me === undefined) return <p className="text-center mt-10 text-gray-600">Loading...</p>;
+  if (me === null) {
+    return (
+      <p className="text-center mt-10 text-gray-700">
+        You are not signed in. <a className="underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in</a>
+      </p>
+    );
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex justify-between items-center mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Account settings</h2>
+          <p className="text-sm text-gray-600">Signed in as <strong>{me.username}</strong></p>
+        </div>
+        <button className={secondary} onClick={signOut}>Sign out</button>
+      </div>
+
+      {error && <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">{error}</div>}
+      {notice && <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">{notice}</div>}
+
+      {reauth && (
+        <div className="mb-6 p-4 border border-amber-300 bg-amber-50 rounded-lg space-y-3" role="dialog" aria-label="Confirm your identity">
+          <p className="text-sm font-medium text-gray-800">Confirm it's you to continue</p>
+          {supported && passkeys.length > 0 && (
+            <button className={primary} onClick={reauthWithPasskey}>Use a passkey</button>
+          )}
+          <form onSubmit={reauthWithPassword} className="flex gap-2">
+            <input
+              type="password" required value={password} onChange={(e) => setPassword(e.target.value)}
+              placeholder="Password" aria-label="Password" autoComplete="current-password"
+              className="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm"
+            />
+            <button type="submit" className={secondary}>Confirm</button>
+          </form>
+          <button className="text-xs underline text-gray-600" onClick={() => setReauth(null)}>Cancel</button>
+        </div>
+      )}
+
+      <h3 className="text-lg font-semibold text-gray-800 mb-1">Passkeys</h3>
+      <p className="text-sm text-gray-600 mb-4">
+        Passkeys let you sign in with your fingerprint, face, or screen lock instead of a password.
+      </p>
+
+      {passkeys.length === 0 ? (
+        <p className="text-sm text-gray-500 mb-4">No passkeys yet.</p>
+      ) : (
+        <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md mb-4">
+          {passkeys.map((p) => (
+            <li key={p.id} className="p-3 flex justify-between items-center gap-3">
+              <div className="min-w-0">
+                {editing?.id === p.id ? (
+                  <form onSubmit={(e) => { e.preventDefault(); rename(); }} className="flex gap-2">
+                    <input
+                      autoFocus value={editing.name} onChange={(e) => setEditing({ id: p.id, name: e.target.value })}
+                      aria-label="Passkey name" className="px-2 py-1 border border-gray-300 rounded text-sm"
+                    />
+                    <button className={secondary} type="submit">Save</button>
+                    <button className={secondary} type="button" onClick={() => setEditing(null)}>Cancel</button>
+                  </form>
+                ) : (
+                  <p className="text-sm font-medium text-gray-900 truncate">{p.name}</p>
+                )}
+                <p className="text-xs text-gray-500">
+                  Added {fmt(p.createdAt)} · Last used {fmt(p.lastUsedAt)}{p.backedUp ? ' · Synced' : ''}
+                </p>
+              </div>
+              {editing?.id !== p.id && (
+                <div className="flex gap-2 shrink-0">
+                  <button className={secondary} onClick={() => setEditing({ id: p.id, name: p.name })}>Rename</button>
+                  <button className={secondary} disabled={busy} onClick={() => removePasskey(p)}>Remove</button>
+                </div>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+
+      {supported ? (
+        <div className="flex gap-2">
+          <input
+            value={name} onChange={(e) => setName(e.target.value)} placeholder="Name (optional), e.g. Work laptop"
+            aria-label="New passkey name" className="flex-1 px-3 py-2 border border-gray-300 rounded-md text-sm"
+          />
+          <button className={primary} disabled={busy} onClick={addPasskey}>Add a passkey</button>
+        </div>
+      ) : (
+        <p className="text-sm text-gray-500">This browser doesn't support passkeys.</p>
+      )}
+    </div>
+  );
+}
