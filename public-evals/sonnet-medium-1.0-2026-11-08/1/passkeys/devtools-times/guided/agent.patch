diff --git a/src/lib/passkey-client.ts b/src/lib/passkey-client.ts
new file mode 100644
index 0000000..daaae26
--- /dev/null
+++ b/src/lib/passkey-client.ts
@@ -0,0 +1,174 @@
+// Browser-side helpers for passkeys. Uses native WebAuthn APIs directly;
+// `webauthn-polyfills` fills in JSON helpers/capabilities where missing.
+const API = `${import.meta.env.BASE_URL}api/passkey`;
+
+export async function loadPolyfills() {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return;
+  await import('webauthn-polyfills');
+}
+
+export async function getCapabilities(): Promise<Record<string, boolean>> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return {};
+  await loadPolyfills();
+  try {
+    return (await PublicKeyCredential.getClientCapabilities()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+export async function post(path: string, body?: unknown) {
+  return fetch(`${API}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(body ?? {}),
+  });
+}
+
+async function signalUnknown(rpId: string | undefined, credentialId: string) {
+  if (!rpId || !(PublicKeyCredential as any).signalUnknownCredential) return;
+  try {
+    await (PublicKeyCredential as any).signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential warning:', e);
+  }
+}
+
+export type RegisterResult =
+  | { ok: true; created: boolean }
+  | { ok: false; cancelled?: boolean; message: string };
+
+/** Creates a passkey. `signup` registers a brand-new account, otherwise adds to the signed-in user. */
+export async function registerPasskey(opts: { signup?: string; promotion?: boolean }): Promise<RegisterResult> {
+  await loadPolyfills();
+  const optRes = await post('register/options', {
+    signup: !!opts.signup,
+    username: opts.signup,
+    promotion: opts.promotion,
+  });
+  const optJson = await optRes.json();
+  if (!optRes.ok) return { ok: false, message: optJson.error ?? 'Could not start passkey creation.' };
+
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optJson);
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.create({ publicKey })) as PublicKeyCredential;
+  } catch (err: any) {
+    if (err.name === 'InvalidStateError') return { ok: false, message: 'A passkey already exists for this account on that device.' };
+    if (err.name === 'SecurityError') return { ok: false, message: 'Passkeys are not available on this site configuration.' };
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') return { ok: false, cancelled: true, message: 'Passkey creation was cancelled.' };
+    return { ok: false, message: 'Could not create a passkey.' };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const res = await post('register/verify', encoded);
+    const data = await res.json();
+    if (!res.ok) {
+      await signalUnknown(publicKey.rp.id, encoded.id);
+      return { ok: false, message: data.error ?? 'Passkey verification failed.' };
+    }
+    return { ok: true, created: data.created };
+  } catch {
+    await signalUnknown(publicKey.rp.id, encoded.id);
+    return { ok: false, message: 'Network error while saving your passkey.' };
+  }
+}
+
+export type AuthResult = { ok: true } | { ok: false; cancelled?: boolean; message: string };
+
+/**
+ * Signs in with a discoverable passkey. Pass `mediation: 'conditional'` for
+ * autofill; use `signal` to abort a pending request.
+ */
+export async function authenticateWithPasskey(opts: { conditional?: boolean; signal?: AbortSignal } = {}): Promise<AuthResult> {
+  await loadPolyfills();
+  const optRes = await post('authenticate/options');
+  const optJson = await optRes.json();
+  if (!optRes.ok) return { ok: false, message: optJson.error ?? 'Could not start passkey sign-in.' };
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optJson);
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.get({
+      publicKey,
+      signal: opts.signal,
+      ...(opts.conditional && { mediation: 'conditional' as const }),
+    })) as PublicKeyCredential;
+  } catch (err: any) {
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') return { ok: false, cancelled: true, message: 'Passkey sign-in was cancelled.' };
+    return { ok: false, message: 'Passkey sign-in failed.' };
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const res = await post('authenticate/verify', encoded);
+    if (res.status === 404) {
+      await signalUnknown(publicKey.rpId, encoded.id);
+      return { ok: false, message: 'That passkey is no longer registered. It has been removed from your password manager where supported.' };
+    }
+    const data = await res.json();
+    if (!res.ok) return { ok: false, message: data.error ?? 'Passkey verification failed.' };
+    return { ok: true };
+  } catch {
+    return { ok: false, message: 'Network error while signing in.' };
+  }
+}
+
+/** Verifies the signed-in user with one of their own passkeys. */
+export async function reauthenticateWithPasskey(): Promise<AuthResult> {
+  await loadPolyfills();
+  const optRes = await post('reauth/options');
+  const optJson = await optRes.json();
+  if (!optRes.ok) return { ok: false, message: optJson.error ?? 'Could not start verification.' };
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optJson);
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.get({ publicKey })) as PublicKeyCredential;
+  } catch (err: any) {
+    if (err.name === 'NotAllowedError' || err.name === 'AbortError') return { ok: false, cancelled: true, message: 'Verification was cancelled.' };
+    return { ok: false, message: 'Verification failed.' };
+  }
+  const encoded = credential.toJSON();
+  try {
+    const res = await post('reauth/verify', encoded);
+    if (res.status === 404) await signalUnknown(publicKey.rpId, encoded.id);
+    if (!res.ok) return { ok: false, message: (await res.json()).error ?? 'Verification failed.' };
+    return { ok: true };
+  } catch {
+    return { ok: false, message: 'Network error during verification.' };
+  }
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-], length % 4 !== 1.
+export const isBase64Url = (v: unknown): v is string =>
+  typeof v === 'string' && v.length > 0 && v.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(v);
+
+export async function syncAcceptedCredentials(rpId: string, userId: string, ids: string[]) {
+  const api = (PublicKeyCredential as any)?.signalAllAcceptedCredentials;
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !api) return;
+  if (!rpId || !isBase64Url(userId) || !ids.every(isBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId/userId/credential ids.');
+    return;
+  }
+  try {
+    await api.call(PublicKeyCredential, { rpId, userId, allAcceptedCredentialIds: ids });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials warning:', e);
+  }
+}
+
+export async function syncUserDetails(rpId: string, userId: string, name: string, displayName: string) {
+  const api = (PublicKeyCredential as any)?.signalCurrentUserDetails;
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !api) return;
+  if (!rpId || !isBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId/userId.');
+    return;
+  }
+  try {
+    await api.call(PublicKeyCredential, { rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails warning:', e);
+  }
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..af19936
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,167 @@
+import { randomBytes, randomUUID } from 'node:crypto';
+import { existsSync, readFileSync, writeFileSync } from 'node:fs';
+import type { APIContext } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+// Reauthentication stays valid for this long.
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export interface User {
+  id: string;
+  username: string;
+  displayName: string;
+  /** Base64URL user handle used as the WebAuthn `user.id`. */
+  passkeyUserId: string;
+  /** How the account was created; stops passkey-only and password accounts from colliding. */
+  origin: 'password' | 'passkey';
+}
+
+export interface StoredPasskeyCredential {
+  id: string;
+  passkeyUserId: string;
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface Db {
+  users: Record<string, User>;
+  credentials: Record<string, StoredPasskeyCredential>;
+}
+
+const DB_PATH = process.env.PASSKEY_DB_PATH ?? 'db.file';
+let db: Db | undefined;
+
+function load(): Db {
+  if (!db) {
+    db = { users: {}, credentials: {} };
+    if (existsSync(DB_PATH)) {
+      try {
+        db = JSON.parse(readFileSync(DB_PATH, 'utf8'));
+      } catch {
+        // Corrupt or foreign file: start fresh in memory.
+      }
+    }
+  }
+  return db!;
+}
+
+function save() {
+  try {
+    writeFileSync(DB_PATH, JSON.stringify(load()));
+  } catch (e) {
+    console.warn('Could not persist passkey store:', e);
+  }
+}
+
+export const newUserHandle = () => randomBytes(32).toString('base64url');
+
+export const findUserByName = (username: string) =>
+  Object.values(load().users).find((u) => u.username.toLowerCase() === username.toLowerCase());
+export const findUserById = (id: string) => load().users[id];
+export const findUserByHandle = (handle: string) =>
+  Object.values(load().users).find((u) => u.passkeyUserId === handle);
+
+export function createUser(username: string, origin: User['origin'], passkeyUserId = newUserHandle()): User {
+  const user: User = { id: randomUUID(), username, displayName: username, passkeyUserId, origin };
+  load().users[user.id] = user;
+  save();
+  return user;
+}
+
+export function updateUser(id: string, patch: Partial<Pick<User, 'username' | 'displayName'>>) {
+  const user = load().users[id];
+  if (!user) return undefined;
+  Object.assign(user, patch);
+  save();
+  return user;
+}
+
+export const findCredentialById = (id: string) => load().credentials[id];
+export const findCredentialsByHandle = (handle: string) =>
+  Object.values(load().credentials).filter((c) => c.passkeyUserId === handle);
+
+export function saveCredential(cred: StoredPasskeyCredential) {
+  load().credentials[cred.id] = cred;
+  save();
+}
+
+export function deleteCredential(id: string) {
+  delete load().credentials[id];
+  save();
+}
+
+// Provider names are UX hints only (never used for access decisions).
+const AAGUIDS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+};
+
+export function providerName(aaguid: string) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') return 'Unknown passkey provider';
+  return AAGUIDS[aaguid] ?? 'Unknown passkey provider';
+}
+
+// --- Request helpers -------------------------------------------------------
+
+export function relyingParty(request: Request) {
+  const url = new URL(request.url);
+  return {
+    rpID: process.env.PASSKEY_RP_ID ?? url.hostname,
+    origin: process.env.PASSKEY_ORIGIN ?? url.origin,
+  };
+}
+
+export const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export type ChallengeState = {
+  challenge: string;
+  type: 'register' | 'signup' | 'authenticate' | 'reauth';
+  userVerification: 'preferred' | 'required';
+  promotion?: boolean;
+  pendingUser?: { username: string; passkeyUserId: string };
+};
+
+export async function currentUser(ctx: Pick<APIContext, 'session'>) {
+  const id = await ctx.session?.get('userId');
+  return id ? findUserById(id) : undefined;
+}
+
+export async function signIn(ctx: Pick<APIContext, 'session'>, user: User) {
+  await ctx.session?.regenerate();
+  await ctx.session?.set('userId', user.id);
+  await ctx.session?.set('reauthAt', Date.now());
+}
+
+export async function hasRecentReauth(ctx: Pick<APIContext, 'session'>) {
+  const at = await ctx.session?.get('reauthAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export const credentialView = (c: StoredPasskeyCredential) => ({
+  id: c.id,
+  name: c.name,
+  aaguid: c.aaguid,
+  transports: c.transports,
+  credentialDeviceType: c.credentialDeviceType,
+  credentialBackedUp: c.credentialBackedUp,
+  registeredAt: c.registeredAt,
+  lastUsedAt: c.lastUsedAt,
+});
