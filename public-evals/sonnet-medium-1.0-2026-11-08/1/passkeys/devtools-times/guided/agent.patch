+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { json, relyingParty, type ChallengeState } from '../../../../lib/passkeys';
+
+// Discoverable-credential sign-in: no username needed.
+export const POST: APIRoute = async (ctx) => {
+  const { rpID } = relyingParty(ctx.request);
+  const options = await generateAuthenticationOptions({
+    rpID,
+    allowCredentials: [],
+    userVerification: 'preferred',
+  });
+  const state: ChallengeState = { challenge: options.challenge, type: 'authenticate', userVerification: 'preferred' };
+  await ctx.session?.set('passkeyChallenge', state);
+  return json(options);
+};
