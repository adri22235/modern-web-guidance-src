diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..912f604
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,199 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import {
+  getCapabilities, reauthenticateWithPasskey, registerPasskey, syncAcceptedCredentials, syncUserDetails,
+} from '../lib/passkey-client';
+
+interface Passkey {
+  id: string;
+  name: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  credentialDeviceType: string;
+  credentialBackedUp: boolean;
+}
+
+const API = `${import.meta.env.BASE_URL}api`;
+const fmt = (t?: number) => (t ? new Date(t).toLocaleDateString(undefined, { dateStyle: 'medium' }) : 'Never');
+const btn = 'py-1.5 px-3 rounded-md text-sm font-medium border border-gray-300 text-gray-800 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-60';
+
+export default function AccountSettings(props: { username: string; displayName: string }) {
+  const [passkeys, setPasskeys] = useState<Passkey[] | null>(null);
+  const [canCreate, setCanCreate] = useState(false);
+  const [username, setUsername] = useState(props.username);
+  const [displayName, setDisplayName] = useState(props.displayName);
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [message, setMessage] = useState<{ kind: 'error' | 'ok'; text: string } | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const load = useCallback(async () => {
+    const res = await fetch(`${API}/passkey/credentials`);
+    if (res.status === 401) return window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    const data = await res.json();
+    setPasskeys(data.credentials);
+    await syncAcceptedCredentials(data.rpId, data.userId, data.credentials.map((c: Passkey) => c.id));
+  }, []);
+
+  useEffect(() => {
+    load();
+    getCapabilities().then((caps) => setCanCreate(!!caps.passkeyPlatformAuthenticator));
+  }, [load]);
+
+  const fail = (text: string) => setMessage({ kind: 'error', text });
+  const ok = (text: string) => setMessage({ kind: 'ok', text });
+
+  /** Runs a sensitive request; on a reauth challenge, verifies with a passkey and retries once. */
+  const withReauth = async (run: () => Promise<Response>) => {
+    let res = await run();
+    if (res.status === 403 && (await res.clone().json().catch(() => ({}))).reauth) {
+      const result = await reauthenticateWithPasskey();
+      if (!result.ok) {
+        if (!result.cancelled) fail(result.message);
+        return null;
+      }
+      res = await run();
+    }
+    return res;
+  };
+
+  const addPasskey = async () => {
+    setMessage(null);
+    setBusy(true);
+    // Omit attachment preference so security keys can be added here too.
+    const result = await registerPasskey({});
+    setBusy(false);
+    if (result.ok) {
+      ok('Passkey created.');
+      await load();
+    } else if (!result.cancelled) fail(result.message);
+  };
+
+  const saveRename = async (id: string) => {
+    setMessage(null);
+    const res = await fetch(`${API}/passkey/credential/${encodeURIComponent(id)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name: renameValue }),
+    });
+    if (!res.ok) return fail((await res.json()).error ?? 'Could not rename passkey.');
+    setRenamingId(null);
+    await load();
+  };
+
+  const remove = async (p: Passkey) => {
+    if (!window.confirm(`Delete the passkey "${p.name}"? You won't be able to sign in with it anymore.`)) return;
+    setMessage(null);
+    const res = await withReauth(() => fetch(`${API}/passkey/credential/${encodeURIComponent(p.id)}`, { method: 'DELETE' }));
+    if (!res) return;
+    if (!res.ok) return fail((await res.json()).error ?? 'Could not delete passkey.');
+    ok('Passkey deleted.');
+    await load(); // also re-syncs accepted credentials with the password manager
+  };
+
+  const saveProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setMessage(null);
+    const res = await withReauth(() =>
+      fetch(`${API}/passkey/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: username, displayName }),
+      }),
+    );
+    if (!res) return;
+    const data = await res.json();
+    if (!res.ok) return fail(data.error ?? 'Could not update profile.');
+    setUsername(data.username);
+    setDisplayName(data.displayName);
+    ok('Profile updated.');
+    await syncUserDetails(data.rpId, data.userId, data.username, data.displayName);
+  };
+
+  const signOut = async () => {
+    await fetch(`${API}/auth/logout`, { method: 'POST' });
+    window.location.assign(`${import.meta.env.BASE_URL}signin`);
+  };
+
+  const input = 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+  return (
+    <div className="max-w-2xl mx-auto space-y-8">
+      <div className="flex items-center justify-between">
+        <h1 className="text-2xl font-bold text-gray-800">Account settings</h1>
+        <button type="button" onClick={signOut} className={btn}>Sign out</button>
+      </div>
+
+      <div aria-live="polite">
+        {message && (
+          <div role={message.kind === 'error' ? 'alert' : 'status'}
+            className={`p-3 text-sm rounded-lg ${message.kind === 'error' ? 'text-red-700 bg-red-100' : 'text-green-700 bg-green-100'}`}>
+            {message.text}
+          </div>
+        )}
+      </div>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 className="text-lg font-semibold text-gray-800 mb-4">Profile</h2>
+        <form onSubmit={saveProfile} className="space-y-4">
+          <div>
+            <label htmlFor="acct-username" className="block text-sm font-medium text-gray-700 mb-1">Username</label>
+            <input id="acct-username" className={input} value={username} onChange={(e) => setUsername(e.target.value)} required autoComplete="username" />
+          </div>
+          <div>
+            <label htmlFor="acct-display" className="block text-sm font-medium text-gray-700 mb-1">Display name</label>
+            <input id="acct-display" className={input} value={displayName} onChange={(e) => setDisplayName(e.target.value)} autoComplete="name" />
+          </div>
+          <button type="submit" className="py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800">Save profile</button>
+          <p className="text-xs text-gray-500">Changing your profile asks you to verify with a passkey if you have one.</p>
+        </form>
+      </section>
+
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex items-center justify-between mb-4">
+          <h2 className="text-lg font-semibold text-gray-800">Passkeys</h2>
+          <button type="button" onClick={addPasskey} disabled={busy || !canCreate} className={btn}
+            title={canCreate ? undefined : 'Passkeys are not supported on this device'}>
+            Create a passkey
+          </button>
+        </div>
+
+        {passkeys === null ? (
+          <p className="text-sm text-gray-500">Loading…</p>
+        ) : passkeys.length === 0 ? (
+          <p className="text-sm text-gray-600">No passkeys found. Create one to sign in without a password.</p>
+        ) : (
+          <ul className="divide-y divide-gray-200">
+            {passkeys.map((p) => (
+              <li key={p.id} className="py-3 flex flex-wrap items-center gap-3 justify-between">
+                <div className="min-w-0">
+                  {renamingId === p.id ? (
+                    <form onSubmit={(e) => { e.preventDefault(); saveRename(p.id); }} className="flex gap-2">
+                      <label htmlFor={`rename-${p.id}`} className="sr-only">Passkey name</label>
+                      <input id={`rename-${p.id}`} className={input} value={renameValue} maxLength={60} autoFocus
+                        onChange={(e) => setRenameValue(e.target.value)} required />
+                      <button type="submit" className={btn}>Save</button>
+                      <button type="button" className={btn} onClick={() => setRenamingId(null)}>Cancel</button>
+                    </form>
+                  ) : (
+                    <>
+                      <p className="font-medium text-gray-800 truncate">{p.name}</p>
+                      <p className="text-xs text-gray-500">
+                        {p.credentialDeviceType === 'multiDevice' ? (p.credentialBackedUp ? 'Synced' : 'Syncable') : 'Device-bound'} · Created {fmt(p.registeredAt)} · Last used {fmt(p.lastUsedAt)}
+                      </p>
+                    </>
+                  )}
+                </div>
+                {renamingId !== p.id && (
+                  <div className="flex gap-2">
+                    <button type="button" className={btn} onClick={() => { setRenamingId(p.id); setRenameValue(p.name); }}>Rename</button>
+                    <button type="button" className={btn} onClick={() => remove(p)}>Delete</button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
