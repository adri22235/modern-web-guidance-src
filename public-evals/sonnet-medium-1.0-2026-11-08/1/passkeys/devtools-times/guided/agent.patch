+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { currentUser, findCredentialsByHandle, json, relyingParty, type ChallengeState } from '../../../../lib/passkeys';
+
+export const POST: APIRoute = async (ctx) => {
+  const user = await currentUser(ctx);
+  if (!user) return json({ error: 'Sign in first.' }, 401);
+  const creds = findCredentialsByHandle(user.passkeyUserId);
+  if (!creds.length) return json({ error: 'No passkeys registered.' }, 400);
+
+  const options = await generateAuthenticationOptions({
+    rpID: relyingParty(ctx.request).rpID,
+    // Constrain to this user's own passkeys.
+    allowCredentials: creds.map((c) => ({ id: c.id, transports: c.transports as any })),
+    userVerification: 'preferred',
+  });
+  const state: ChallengeState = { challenge: options.challenge, type: 'reauth', userVerification: 'preferred' };
+  await ctx.session?.set('passkeyChallenge', state);
+  return json(options);
+};
