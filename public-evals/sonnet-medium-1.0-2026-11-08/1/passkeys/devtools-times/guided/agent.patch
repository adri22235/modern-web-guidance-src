+import type { APIRoute } from 'astro';
+import {
+  credentialView, currentUser, deleteCredential, findCredentialById, hasRecentReauth, json, saveCredential,
+} from '../../../../lib/passkeys';
+
+async function owned(ctx: Parameters<APIRoute>[0]) {
+  const user = await currentUser(ctx);
+  if (!user) return { error: json({ error: 'Sign in first.' }, 401) };
+  const cred = findCredentialById(ctx.params.id!);
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) return { error: json({ error: 'Credential not found.' }, 404) };
+  return { user, cred };
+}
+
+export const PUT: APIRoute = async (ctx) => {
+  const { cred, error } = await owned(ctx);
+  if (error) return error;
+  const { name } = await ctx.request.json().catch(() => ({}));
+  const trimmed = String(name ?? '').trim().slice(0, 60);
+  if (!trimmed) return json({ error: 'Name is required.' }, 400);
+  cred!.name = trimmed;
+  saveCredential(cred!);
+  return json(credentialView(cred!));
+};
+
+export const DELETE: APIRoute = async (ctx) => {
+  const { cred, error } = await owned(ctx);
+  if (error) return error;
+  if (!(await hasRecentReauth(ctx))) return json({ error: 'Reauthentication required.', reauth: true }, 403);
+  deleteCredential(cred!.id);
+  return json({ success: true });
+};
