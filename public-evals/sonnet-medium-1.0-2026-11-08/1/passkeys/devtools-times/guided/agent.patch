@@ -0,0 +1,45 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  findCredentialById, findUserByHandle, json, relyingParty, saveCredential, signIn, type ChallengeState,
+} from '../../../../lib/passkeys';
+
+export const POST: APIRoute = async (ctx) => {
+  const state = (await ctx.session?.get('passkeyChallenge')) as ChallengeState | undefined;
+  await ctx.session?.delete('passkeyChallenge');
+  if (!state || state.type !== 'authenticate') return json({ error: 'No sign-in in progress.' }, 400);
+
+  const response = await ctx.request.json();
+  const stored = findCredentialById(response?.id);
+  // 404 lets the client tell the password manager this passkey is gone.
+  if (!stored) return json({ error: 'Passkey not found.' }, 404);
+  const user = findUserByHandle(stored.passkeyUserId);
+  if (!user) return json({ error: 'Passkey not found.' }, 404);
+
+  const { rpID, origin } = relyingParty(ctx.request);
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: state.userVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: new Uint8Array(Buffer.from(stored.credentialPublicKey, 'base64url')),
+        counter: stored.counter,
+        transports: stored.transports as any,
+      },
+    });
+  } catch {
+    return json({ error: 'Passkey verification failed.' }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey verification failed.' }, 400);
+
+  stored.counter = verification.authenticationInfo.newCounter;
+  stored.lastUsedAt = Date.now();
+  saveCredential(stored);
+  await signIn(ctx, user);
+  return json({ verified: true, username: user.username });
+};
