@@ -0,0 +1,26 @@
+import type { APIRoute } from 'astro';
+import { createUser, findUserByName, json, signIn } from '../../../lib/passkeys';
+
+const LOGIN_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+// Proxies the password login so the server can establish its own session.
+export const POST: APIRoute = async (ctx) => {
+  const { username, password } = await ctx.request.json().catch(() => ({}));
+  if (!username || !password) return json({ error: 'Username and password are required.' }, 400);
+
+  const upstream = await fetch(LOGIN_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) return json(data, upstream.status);
+
+  let user = findUserByName(username);
+  if (user && user.origin !== 'password') {
+    return json({ error: 'This username belongs to a passkey account. Sign in with your passkey.' }, 409);
+  }
+  user ??= createUser(username, 'password');
+  await signIn(ctx, user);
+  return json({ ...data, username: user.username });
+};
