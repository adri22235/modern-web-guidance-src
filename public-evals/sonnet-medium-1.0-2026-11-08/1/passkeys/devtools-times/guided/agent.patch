+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { currentUser, findCredentialById, json, relyingParty, saveCredential, type ChallengeState } from '../../../../lib/passkeys';
+
+export const POST: APIRoute = async (ctx) => {
+  const state = (await ctx.session?.get('passkeyChallenge')) as ChallengeState | undefined;
+  await ctx.session?.delete('passkeyChallenge');
+  const user = await currentUser(ctx);
+  if (!user) return json({ error: 'Sign in first.' }, 401);
+  if (!state || state.type !== 'reauth') return json({ error: 'No reauthentication in progress.' }, 400);
+
+  const response = await ctx.request.json();
+  const stored = findCredentialById(response?.id);
+  if (!stored) return json({ error: 'Passkey not found.' }, 404);
+  // A valid passkey belonging to someone else must not count.
+  if (stored.passkeyUserId !== user.passkeyUserId) return json({ error: 'Passkey does not belong to this account.' }, 403);
+
+  const { rpID, origin } = relyingParty(ctx.request);
+  try {
+    const v = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: state.userVerification === 'required',
+      credential: {
+        id: stored.id,
+        publicKey: new Uint8Array(Buffer.from(stored.credentialPublicKey, 'base64url')),
+        counter: stored.counter,
+        transports: stored.transports as any,
+      },
+    });
+    if (!v.verified) return json({ error: 'Verification failed.' }, 400);
+    stored.counter = v.authenticationInfo.newCounter;
+    stored.lastUsedAt = Date.now();
+    saveCredential(stored);
+  } catch {
+    return json({ error: 'Verification failed.' }, 400);
+  }
+  await ctx.session?.set('reauthAt', Date.now());
+  return json({ verified: true });
+};
diff --git a/src/pages/api/passkey/register/options.ts b/src/pages/api/passkey/register/options.ts
new file mode 100644
index 0000000..ae90381
--- /dev/null
+++ b/src/pages/api/passkey/register/options.ts
@@ -0,0 +1,65 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  RP_NAME, currentUser, findCredentialsByHandle, findUserByName, json, newUserHandle, relyingParty,
+  type ChallengeState,
+} from '../../../../lib/passkeys';
+
+// Creates registration options for either a signed-in user (add a passkey) or a
+// brand new account (`{ signup: true, username }`).
+export const POST: APIRoute = async (ctx) => {
+  const body = await ctx.request.json().catch(() => ({}));
+  const { rpID } = relyingParty(ctx.request);
+  const user = await currentUser(ctx);
+
+  let userName: string;
+  let userDisplayName: string;
+  let handle: string;
+  let pendingUser: ChallengeState['pendingUser'];
+  let exclude: { id: string; transports?: any[] }[] = [];
+
+  if (body.signup) {
+    const username = String(body.username ?? '').trim();
+    if (!/^[\w.@-]{3,64}$/.test(username)) {
+      return json({ error: 'Choose a username of 3–64 letters, numbers, or . _ @ -' }, 400);
+    }
+    if (findUserByName(username)) return json({ error: 'That username is already taken.' }, 409);
+    handle = newUserHandle();
+    userName = userDisplayName = username;
+    pendingUser = { username, passkeyUserId: handle };
+  } else if (user) {
+    handle = user.passkeyUserId;
+    userName = user.username;
+    userDisplayName = user.displayName;
+    exclude = findCredentialsByHandle(handle).map((c) => ({ id: c.id, transports: c.transports as any }));
+  } else {
+    return json({ error: 'Sign in first.' }, 401);
+  }
+
+  const promotion = body.promotion === true || body.signup === true;
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userName,
+    userDisplayName,
+    userID: new Uint8Array(Buffer.from(handle, 'base64url')),
+    attestationType: 'none',
+    excludeCredentials: exclude,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Settings panel omits attachment so security keys remain possible.
+      ...(promotion && { authenticatorAttachment: 'platform' as const }),
+    },
+  });
+
+  const state: ChallengeState = {
+    challenge: options.challenge,
+    type: body.signup ? 'signup' : 'register',
+    userVerification: 'preferred',
+    pendingUser,
+  };
+  await ctx.session?.set('passkeyChallenge', state);
+  return json(options);
+};
diff --git a/src/pages/api/passkey/register/verify.ts b/src/pages/api/passkey/register/verify.ts
new file mode 100644
index 0000000..18a072a
--- /dev/null
+++ b/src/pages/api/passkey/register/verify.ts
@@ -0,0 +1,62 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  createUser, credentialView, currentUser, findCredentialById, findUserByName, json, providerName, relyingParty,
+  saveCredential, signIn, type ChallengeState,
+} from '../../../../lib/passkeys';
+
+export const POST: APIRoute = async (ctx) => {
+  const state = (await ctx.session?.get('passkeyChallenge')) as ChallengeState | undefined;
+  await ctx.session?.delete('passkeyChallenge'); // challenges are single-use
+  if (!state || (state.type !== 'register' && state.type !== 'signup')) {
+    return json({ error: 'No registration in progress.' }, 400);
+  }
+
+  let user = await currentUser(ctx);
+  if (state.type === 'register' && !user) return json({ error: 'Sign in first.' }, 401);
+
+  const { rpID, origin } = relyingParty(ctx.request);
+  const response = await ctx.request.json();
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: state.challenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: state.userVerification === 'required',
+    });
+  } catch (e) {
+    return json({ error: 'Passkey verification failed.' }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey verification failed.' }, 400);
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  if (findCredentialById(credential.id)) return json({ error: 'Passkey already registered.' }, 409);
+
+  let created = false;
+  if (state.type === 'signup') {
+    const pending = state.pendingUser!;
+    if (findUserByName(pending.username)) return json({ error: 'That username is already taken.' }, 409);
+    user = createUser(pending.username, 'passkey', pending.passkeyUserId);
+    created = true;
+  }
+
+  const stored = {
+    id: credential.id,
+    passkeyUserId: user!.passkeyUserId,
+    credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    credentialType: 'public-key' as const,
+    credentialDeviceType,
+    credentialBackedUp,
+    aaguid,
+    name: providerName(aaguid),
+    transports: credential.transports ?? [],
+    registeredAt: Date.now(),
+    counter: credential.counter,
+  };
+  saveCredential(stored);
+  if (created) await signIn(ctx, user!);
+  return json({ verified: true, created, credential: credentialView(stored) });
+};
diff --git a/src/pages/api/passkey/user.ts b/src/pages/api/passkey/user.ts
new file mode 100644
index 0000000..263b22c
--- /dev/null
+++ b/src/pages/api/passkey/user.ts
@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { currentUser, findCredentialsByHandle, findUserByName, hasRecentReauth, json, relyingParty, updateUser } from '../../../lib/passkeys';
+
+export const PUT: APIRoute = async (ctx) => {
+  const user = await currentUser(ctx);
+  if (!user) return json({ error: 'Sign in first.' }, 401);
+  // Users without passkeys have nothing to reauthenticate with.
+  if (findCredentialsByHandle(user.passkeyUserId).length && !(await hasRecentReauth(ctx))) return json({ error: 'Reauthentication required.', reauth: true }, 403);
+
+  const body = await ctx.request.json().catch(() => ({}));
+  const name = String(body.name ?? '').trim();
+  const displayName = String(body.displayName ?? '').trim() || name;
+  if (!/^[\w.@-]{3,64}$/.test(name)) return json({ error: 'Choose a username of 3–64 letters, numbers, or . _ @ -' }, 400);
+  const clash = findUserByName(name);
+  if (clash && clash.id !== user.id) return json({ error: 'That username is already taken.' }, 409);
+
+  const updated = updateUser(user.id, { username: name, displayName })!;
+  return json({
+    username: updated.username,
+    displayName: updated.displayName,
+    rpId: relyingParty(ctx.request).rpID,
+    userId: updated.passkeyUserId,
+  });
+};
