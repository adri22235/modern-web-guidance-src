@@ -0,0 +1,17 @@
+# Security & privacy headers (Netlify / Cloudflare Pages format).
+# Mirror these in your server/CDN config if hosting elsewhere.
+/*
+  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self' https://images.unsplash.com; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; script-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
+  X-Frame-Options: DENY
+  X-Content-Type-Options: nosniff
+  Referrer-Policy: same-origin
+  Permissions-Policy: camera=(), microphone=(), geolocation=(), accelerometer=(), gyroscope=(), magnetometer=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), focus-without-user-activation=()
+  Strict-Transport-Security: max-age=31536000; includeSubDomains
+  Cross-Origin-Opener-Policy: same-origin-allow-popups
+  Cross-Origin-Resource-Policy: same-origin
+
+# Logout must clear all local state. Send this from the /logout response
+# (ideally via a subresource so it doesn't block rendering of the page).
+/logout
+  Clear-Site-Data: "cookies", "storage", "cache"
+  Cache-Control: no-store
