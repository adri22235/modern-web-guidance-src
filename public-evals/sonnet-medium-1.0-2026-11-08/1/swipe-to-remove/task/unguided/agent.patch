+  <script>
+    (function () {
+      var THRESHOLD = 0.4; // fraction of item width that triggers removal
+
+      function initItem(item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var startX = 0, startY = 0, dx = 0, pointerId = null, dragging = false;
+
+        function reset() {
+          item.classList.remove('is-dragging', 'is-past-threshold');
+          track.style.transform = '';
+          dragging = false;
+          pointerId = null;
+        }
+
+        function remove() {
+          var list = item.parentNode;
+          item.style.height = item.offsetHeight + 'px';
+          item.offsetHeight; // force reflow so the height transition starts from a fixed value
+          item.classList.add('is-removing');
+          item.style.height = '0px';
+          var done = false;
+          function finish() {
+            if (done) return;
+            done = true;
+            item.remove();
+            if (!list.querySelector('.SwipeableList-item')) {
+              var empty = document.querySelector('.cart-empty');
+              if (empty) empty.hidden = false;
+            }
+          }
+          item.addEventListener('transitionend', function (e) {
+            if (e.target === item && e.propertyName === 'height') finish();
+          });
+          setTimeout(finish, 600);
+        }
+
+        item.addEventListener('pointerdown', function (e) {
+          if (pointerId !== null || (e.pointerType === 'mouse' && e.button !== 0)) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          dragging = false;
+        });
+
+        item.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          dx = e.clientX - startX;
+          if (!dragging) {
+            if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(e.clientY - startY)) return;
+            dragging = true;
+            item.classList.add('is-dragging');
+            item.setPointerCapture(pointerId);
+          }
+          track.style.transform = 'translateX(' + dx + 'px)';
+          item.classList.toggle('is-past-threshold', Math.abs(dx) >= item.offsetWidth * THRESHOLD);
+        });
+
+        function end(e) {
+          if (e.pointerId !== pointerId) return;
+          var passed = dragging && e.type === 'pointerup' &&
+            Math.abs(dx) >= item.offsetWidth * THRESHOLD;
+          if (passed) {
+            item.classList.remove('is-dragging');
+            track.style.transform = 'translateX(' + (dx > 0 ? '100%' : '-100%') + ')';
+            pointerId = null;
+            remove();
+          } else {
+            reset();
+          }
+        }
+
+        item.addEventListener('pointerup', end);
+        item.addEventListener('pointercancel', end);
+
+        item.classList.add('is-initialized');
+      }
+
+      document.querySelectorAll('.SwipeableList-item').forEach(initItem);
+    })();
+  </script>
