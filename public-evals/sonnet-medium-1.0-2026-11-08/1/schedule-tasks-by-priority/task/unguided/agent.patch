+  <script>
+    (function () {
+      // Priority: lower number runs first.
+      var TYPES = {
+        checkout: { label: 'Checkout', level: 'urgent', priority: 0, units: 150 },
+        menu: { label: 'Menu update', level: 'standard', priority: 1, units: 400 },
+        telemetry: { label: 'Telemetry log', level: 'background', priority: 2, units: 900 }
+      };
+      var SLICE_MS = 8; // max blocking time per slice, keeps UI at ~60fps
+
+      var queue = [];
+      var seq = 0;
+      var done = 0;
+      var running = null;
+      var scheduled = false;
+
+      var $ = function (id) { return document.getElementById(id); };
+      var queuedEl = $('ops-queued'), doneEl = $('ops-done'), runningEl = $('ops-running');
+      var logEl = $('ops-log'), tickerEl = $('ops-ticker');
+
+      function log(task, msg) {
+        var li = document.createElement('li');
+        li.className = task.type.level;
+        li.textContent = new Date().toLocaleTimeString() + '  #' + task.id + ' ' + task.type.label + ' - ' + msg;
+        logEl.appendChild(li);
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      function render() {
+        queuedEl.textContent = queue.length;
+        doneEl.textContent = done;
+        runningEl.textContent = running ? '#' + running.id + ' ' + running.type.label +
+          ' (' + Math.floor(running.progress / running.type.units * 100) + '%)' : 'idle';
+      }
+
+      function enqueue(key) {
+        var type = TYPES[key];
+        var task = { id: ++seq, type: type, progress: 0, result: 0 };
+        // Insert keeping priority order, FIFO within the same priority.
+        var i = queue.length;
+        while (i > 0 && queue[i - 1].type.priority > type.priority) i--;
+        queue.splice(i, 0, task);
+        log(task, 'queued');
+        render();
+        schedule();
+      }
+
+      function schedule() {
+        if (scheduled) return;
+        scheduled = true;
+        setTimeout(pump, 0); // yields to the browser between slices
+      }
+
+      function pump() {
+        scheduled = false;
+        // Re-pick each slice so a newly queued urgent task preempts a long one.
+        var next = queue[0];
+        if (running && (!next || next.type.priority >= running.type.priority)) {
+          next = running;
+        } else if (running) {
+          queue.push(running); // preempted; resume later
+          queue.sort(function (a, b) { return a.type.priority - b.type.priority || a.id - b.id; });
+          log(running, 'preempted');
+          next = queue[0];
+        }
+        if (!next) { running = null; render(); return; }
+        if (next !== running) {
+          queue.splice(queue.indexOf(next), 1);
+          running = next;
+          log(running, running.progress ? 'resumed' : 'started');
+        }
+
+        var end = performance.now() + SLICE_MS;
+        while (running.progress < running.type.units && performance.now() < end) {
+          // Simulated CPU work for one unit.
+          for (var k = 0; k < 20000; k++) running.result += Math.sqrt(k);
+          running.progress++;
+        }
+
+        if (running.progress >= running.type.units) {
+          done++;
+          log(running, 'completed');
+          running = null;
+        }
+        render();
+        if (running || queue.length) schedule();
+      }
+
+      document.querySelectorAll('.ops-controls [data-type]').forEach(function (btn) {
+        btn.addEventListener('click', function () { enqueue(btn.dataset.type); });
+      });
+
+      // Mixed batch, deliberately added out of priority order; the queue sorts them.
+      $('ops-batch').addEventListener('click', function () {
+        ['telemetry', 'menu', 'telemetry', 'checkout', 'menu', 'checkout'].forEach(enqueue);
+      });
+
+      $('ops-clear').addEventListener('click', function () { logEl.innerHTML = ''; });
+
+      // Visible proof of responsiveness: ticker keeps animating while tasks run.
+      var frames = ['●', '◐', '○', '◑'], f = 0;
+      setInterval(function () { tickerEl.textContent = frames[f++ % frames.length]; }, 150);
+    })();
+  </script>
 </body>
 
