+  <script>
+    (() => {
+      const TYPES = {
+        urgent: { label: 'Checkout', rank: 0, units: 150 },
+        standard: { label: 'Menu update', rank: 1, units: 400 },
+        background: { label: 'Telemetry', rank: 2, units: 900 }
+      };
+      const SLICE_MS = 30; // keep each slice well under the 50ms long-task boundary
+      const UNIT_MS = 1;   // simulated cost of one unit of work
+
+      const queueEl = document.getElementById('ops-queue');
+      const logEl = document.getElementById('ops-log');
+      const pending = [];
+      let running = false;
+      let seq = 0;
+      const t0 = performance.now();
+
+      const yieldToMain = () =>
+        ('scheduler' in window && 'yield' in scheduler)
+          ? scheduler.yield()
+          : new Promise((resolve) => setTimeout(resolve, 0));
+
+      function log(msg) {
+        const li = document.createElement('li');
+        li.textContent = `[${((performance.now() - t0) / 1000).toFixed(2)}s] ${msg}`;
+        logEl.append(li);
+        logEl.scrollTop = logEl.scrollHeight;
+      }
+
+      function enqueue(type) {
+        const def = TYPES[type];
+        const id = ++seq;
+        const li = document.createElement('li');
+        li.className = 'ops-task';
+        li.dataset.priority = type;
+        li.innerHTML = '<span class="tag"></span><progress max="100" value="0"></progress><span class="pct">queued</span>';
+        li.querySelector('.tag').textContent = `#${id} ${def.label}`;
+        li.querySelector('progress').setAttribute('aria-label', `#${id} ${def.label} progress`);
+        queueEl.append(li);
+        pending.push({ id, type, rank: def.rank, total: def.units, done: 0, el: li });
+        log(`Queued #${id} ${def.label} (${type})`);
+        if (!running) run();
+      }
+
+      function next() {
+        // Highest priority first; FIFO (lowest id) within a priority.
+        let best = -1;
+        pending.forEach((t, i) => {
+          if (best < 0 || t.rank < pending[best].rank ||
+              (t.rank === pending[best].rank && t.id < pending[best].id)) best = i;
+        });
+        return best;
+      }
+
+      function busyWait(ms) {
+        const end = performance.now() + ms;
+        while (performance.now() < end);
+      }
+
+      async function run() {
+        running = true;
+        let current = null;
+        while (pending.length) {
+          // Re-pick after every slice so newly queued urgent work preempts.
+          const task = pending[next()];
+          if (current && current !== task) {
+            log(`Paused #${current.id} ${TYPES[current.type].label} for #${task.id} ${TYPES[task.type].label}`);
+          }
+          if (current !== task) {
+            if (task.done === 0) log(`Started #${task.id} ${TYPES[task.type].label}`);
+            else log(`Resumed #${task.id} ${TYPES[task.type].label}`);
+          }
+          current = task;
+
+          const deadline = performance.now() + SLICE_MS;
+          while (task.done < task.total && performance.now() < deadline) {
+            busyWait(UNIT_MS);
+            task.done++;
+          }
+          const pct = Math.round((task.done / task.total) * 100);
+          task.el.querySelector('progress').value = pct;
+          task.el.querySelector('.pct').textContent = `${pct}%`;
+
+          if (task.done >= task.total) {
+            pending.splice(pending.indexOf(task), 1);
+            log(`Finished #${task.id} ${TYPES[task.type].label}`);
+            setTimeout(() => task.el.remove(), 1500);
+            current = null;
+          }
+          await yieldToMain(); // let input and rendering through
+        }
+        running = false;
+      }
+
+      document.querySelector('.ops-actions').addEventListener('click', (e) => {
+        const btn = e.target.closest('button');
+        if (!btn) return;
+        if (btn.id === 'ops-clear') { logEl.replaceChildren(); return; }
+        const kind = btn.dataset.task;
+        if (kind === 'batch') {
+          log('Batch submitted: mixed tasks');
+          // Submitted out of order on purpose; the queue sorts them by priority.
+          ['background', 'standard', 'urgent', 'background', 'urgent', 'standard'].forEach(enqueue);
+        } else {
+          enqueue(kind);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
