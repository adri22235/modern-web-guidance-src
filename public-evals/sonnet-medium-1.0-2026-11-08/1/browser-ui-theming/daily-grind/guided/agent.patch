+    /* Browser UI theming */
+    html {
+      color-scheme: light;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    body {
+      accent-color: var(--primary);
+    }
+
+    ::selection {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    :focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Order customization */
+    .customizer {
+      margin-top: 60px;
+    }
+
+    .order-form {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 30px;
+      margin-top: 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px 30px;
+    }
+
+    .field,
+    fieldset {
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      border: 0;
+      min-width: 0;
+    }
+
+    .field label,
+    legend {
+      font-weight: 600;
+      color: var(--primary);
+      font-size: 0.9rem;
+    }
+
+    .order-form input:not([type="checkbox"], [type="radio"], [type="range"]),
+    .order-form select,
+    .order-form textarea {
+      font: inherit;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 5px;
+      padding: 8px 10px;
+      width: 100%;
+    }
+
+    .order-form input:not([type="checkbox"], [type="radio"], [type="range"]):hover,
+    .order-form select:hover,
+    .order-form textarea:hover {
+      border-color: var(--primary);
+    }
+
+    .order-form ::placeholder {
+      color: #6d4c41;
+      opacity: 1;
+    }
+
+    .order-form textarea {
+      resize: vertical;
+      min-height: 5rem;
+    }
+
+    .order-form option {
+      background: var(--light);
+      color: var(--text);
+    }
+
+    .order-form option:checked {
+      background: var(--secondary);
+    }
+
+    .order-form :user-invalid {
+      border-color: #b71c1c;
+    }
+
+    .order-form input[type="range"] {
+      width: 100%;
+    }
+
+    .order-form ::-webkit-calendar-picker-indicator {
+      cursor: pointer;
+      padding: 2px;
+      border-radius: 3px;
+    }
+
+    .order-form ::-webkit-calendar-picker-indicator:hover {
+      background: var(--secondary);
+    }
+
+    .choices {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 8px;
+    }
+
+    .choices label {
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      padding: 6px 12px;
+      border: 2px solid var(--secondary);
+      border-radius: 999px;
+      cursor: pointer;
+      font-weight: normal;
+      color: var(--text);
+    }
+
+    .choices label:has(:checked) {
+      background: var(--secondary);
+      border-color: var(--primary);
+    }
+
+    .choices label:has(:focus-visible) {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .choices input:focus-visible {
+      outline: none;
+    }
+
+    .order-actions {
+      grid-column: 1 / -1;
+      text-align: center;
+    }
+
+    .order-actions button.btn {
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
