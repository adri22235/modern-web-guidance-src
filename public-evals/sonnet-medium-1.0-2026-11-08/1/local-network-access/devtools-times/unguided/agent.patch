@@ -0,0 +1,100 @@
+import { useState } from "react";
+import {
+  COMPANION_HOST,
+  DEFAULT_COMPANION_PORT,
+  DEFAULT_DEVICE_PORT,
+  isPrivateLanIp,
+  parsePort,
+  probe,
+  type AddressSpace,
+  type ProbeResult,
+} from "../utils/diagnostics";
+
+type State = { phase: "idle" } | { phase: "connecting" } | { phase: "done"; result: ProbeResult };
+
+function StatusRow({ state }: { state: State }) {
+  if (state.phase === "idle") return <p className="text-sm text-gray-500">Not connected.</p>;
+  if (state.phase === "connecting") return <p className="text-sm text-gray-600" role="status">Connecting…</p>;
+  const { result } = state;
+  return (
+    <div role="status" className="text-sm">
+      <p className={result.ok ? "text-green-700 font-semibold" : "text-red-700 font-semibold"}>
+        {result.ok ? `Connected (${result.latencyMs} ms)` : result.error}
+      </p>
+      {result.body ? (
+        <pre className="mt-2 max-h-40 overflow-auto bg-gray-100 p-2 text-xs whitespace-pre-wrap break-all">
+          {result.body}
+        </pre>
+      ) : null}
+    </div>
+  );
+}
+
+export default function DiagnosticsWidget() {
+  const pageIsHttps = typeof window !== "undefined" && window.location.protocol === "https:";
+  const [deviceHost, setDeviceHost] = useState("192.168.1.50");
+  const [devicePort, setDevicePort] = useState(String(DEFAULT_DEVICE_PORT));
+  const [deviceProto, setDeviceProto] = useState<"http" | "https">(pageIsHttps ? "https" : "http");
+  const [companionPort, setCompanionPort] = useState(String(DEFAULT_COMPANION_PORT));
+  const [device, setDevice] = useState<State>({ phase: "idle" });
+  const [companion, setCompanion] = useState<State>({ phase: "idle" });
+
+  const fail = (error: string): State => ({ phase: "done", result: { ok: false, error } });
+
+  async function run(
+    set: (s: State) => void,
+    proto: "http" | "https",
+    host: string,
+    portStr: string,
+    space: AddressSpace,
+  ) {
+    const port = parsePort(portStr);
+    if (!port) return set(fail("Enter a port between 1 and 65535."));
+    set({ phase: "connecting" });
+    set({ phase: "done", result: await probe(proto, host, port, space) });
+  }
+
+  function connectDevice() {
+    if (!isPrivateLanIp(deviceHost)) {
+      return setDevice(fail("Use a private LAN IPv4 address (10.x.x.x, 172.16–31.x.x or 192.168.x.x)."));
+    }
+    if (pageIsHttps && deviceProto === "http") {
+      return setDevice(fail("This page is served over HTTPS, so browsers block plain-HTTP requests to your device. Serve the device over HTTPS."));
+    }
+    run(setDevice, deviceProto, deviceHost.trim(), devicePort, "local");
+  }
+
+  // Loopback is treated as a secure context by browsers, so http is fine here.
+  const connectCompanion = () => run(setCompanion, "http", COMPANION_HOST, companionPort, "loopback");
+
+  const input = "border border-gray-300 rounded px-2 py-1 text-sm";
+  const button = "bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-700 disabled:opacity-50";
+
+  return (
+    <div className="not-prose grid gap-6 md:grid-cols-2">
+      <section className="border border-gray-300 rounded p-4 space-y-3" aria-labelledby="dev-h">
+        <h2 id="dev-h" className="font-bold">Hardware test device (LAN)</h2>
+        <div className="flex flex-wrap gap-2">
+          <select aria-label="Protocol" className={input} value={deviceProto} onChange={(e) => setDeviceProto(e.target.value as "http" | "https")}>
+            <option value="http">http</option>
+            <option value="https">https</option>
+          </select>
+          <input aria-label="Device IP address" className={`${input} w-36`} value={deviceHost} onChange={(e) => setDeviceHost(e.target.value)} inputMode="decimal" placeholder="192.168.1.50" />
+          <input aria-label="Device port" className={`${input} w-20`} value={devicePort} onChange={(e) => setDevicePort(e.target.value)} inputMode="numeric" />
+        </div>
+        <button className={button} onClick={connectDevice} disabled={device.phase === "connecting"}>Connect to device</button>
+        <StatusRow state={device} />
+      </section>
+
+      <section className="border border-gray-300 rounded p-4 space-y-3" aria-labelledby="cli-h">
+        <h2 id="cli-h" className="font-bold">Companion CLI ({COMPANION_HOST})</h2>
+        <div className="flex flex-wrap gap-2 items-center">
+          <span className="text-sm text-gray-600">http://{COMPANION_HOST}:</span>
+          <input aria-label="Companion CLI port" className={`${input} w-20`} value={companionPort} onChange={(e) => setCompanionPort(e.target.value)} inputMode="numeric" />
+        </div>
+        <button className={button} onClick={connectCompanion} disabled={companion.phase === "connecting"}>Connect to companion</button>
+        <StatusRow state={companion} />
+      </section>
+    </div>
+  );
+}
