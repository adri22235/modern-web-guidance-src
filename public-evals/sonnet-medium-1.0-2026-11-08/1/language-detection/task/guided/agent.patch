+  <script>
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-btn');
+    const result = document.getElementById('feedback-result');
+    let detector;
+
+    if (!('LanguageDetector' in self)) {
+      button.disabled = true;
+      result.textContent = 'Language detection is not supported in this browser.';
+    }
+
+    form.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const text = message.value.trim();
+      if (!text) return;
+
+      button.disabled = true;
+      result.textContent = 'Detecting…';
+      try {
+        if ((await LanguageDetector.availability()) === 'unavailable') {
+          result.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        // create() must run from a user gesture (this submit handler) in case the model must download
+        detector ??= await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (ev) => {
+              result.textContent = `Downloading language model… ${Math.round(ev.loaded * 100)}%`;
+            });
+          },
+        });
+        const [top] = await detector.detect(text);
+        if (!top || top.detectedLanguage === 'und') {
+          result.textContent = 'Could not determine the language.';
+          return;
+        }
+        const name = new Intl.DisplayNames(['en'], { type: 'language' }).of(top.detectedLanguage);
+        result.textContent = `Detected language: ${name} (${top.detectedLanguage}), ${Math.round(top.confidence * 100)}% confidence`;
+      } catch (err) {
+        result.textContent = 'Language detection failed. Please try again.';
+      } finally {
+        button.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
