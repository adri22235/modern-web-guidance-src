+  <script>
+    // Non-Latin scripts that map (almost) uniquely to a language.
+    const SCRIPTS = [
+      [/[぀-ヿ]/g, 'ja'],
+      [/[가-힯]/g, 'ko'],
+      [/[一-鿿]/g, 'zh'],
+      [/[฀-๿]/g, 'th'],
+      [/[֐-׿]/g, 'he'],
+      [/[؀-ۿ]/g, 'ar'],
+      [/[ऀ-ॿ]/g, 'hi'],
+      [/[Ͱ-Ͽ]/g, 'el'],
+      [/[Ѐ-ӿ]/g, 'ru']
+    ];
+
+    // Common stopwords for Latin-script languages.
+    const WORDS = {
+      en: 'the and is are was were to of in it that for with this have my very but not you i we they at on',
+      es: 'el la los las es son una un que de y en por para con muy pero no mi su gracias hola está estoy',
+      fr: 'le la les est sont une un que de et en pour avec très mais pas mon ma je nous vous merci bonjour',
+      de: 'der die das ist sind ein eine und zu von mit sehr aber nicht ich wir sie danke hallo war auf',
+      it: 'il lo la gli le è sono un una che di e per con molto ma non mio grazie ciao della sono',
+      pt: 'o a os as é são um uma que de e em para com muito mas não meu obrigado olá você está',
+      nl: 'de het een en is zijn van met voor zeer maar niet ik wij u bedankt hallo dat op',
+      sv: 'och det att är en som på för med mycket men inte jag vi tack hej av den',
+      pl: 'i w nie na to jest się z że do bardzo ale dziękuję cześć jak był',
+      tr: 've bir bu çok için ile ama değil ben biz teşekkürler merhaba güzel da de'
+    };
+
+    const NAMES = new Intl.DisplayNames(['en'], { type: 'language' });
+
+    function heuristicDetect(text) {
+      let best = null;
+      for (const [re, code] of SCRIPTS) {
+        const n = (text.match(re) || []).length;
+        if (n && (!best || n > best.n)) best = { code, n };
+      }
+      // Kana implies Japanese even when Han characters outnumber it.
+      if (best && best.code === 'zh' && /[぀-ヿ]/.test(text)) best.code = 'ja';
+      if (best) return best.code;
+
+      const tokens = text.toLowerCase().match(/\p{L}+/gu) || [];
+      let top = null;
+      for (const [code, list] of Object.entries(WORDS)) {
+        const set = new Set(list.split(' '));
+        const score = tokens.filter(t => set.has(t)).length;
+        if (score && (!top || score > top.score)) top = { code, score };
+      }
+      return top && top.code;
+    }
+
+    async function detectLanguage(text) {
+      // Prefer the browser's built-in detector when available.
+      if ('LanguageDetector' in self) {
+        try {
+          const detector = await LanguageDetector.create();
+          const [top] = await detector.detect(text);
+          if (top && top.detectedLanguage && top.detectedLanguage !== 'und') return top.detectedLanguage;
+        } catch (e) { /* fall back below */ }
+      }
+      return heuristicDetect(text);
+    }
+
+    document.getElementById('detect-btn').addEventListener('click', async () => {
+      const text = document.getElementById('feedback-message').value.trim();
+      const out = document.getElementById('detect-result');
+      if (!text) {
+        out.textContent = 'Please enter a message first.';
+        return;
+      }
+      const code = await detectLanguage(text);
+      if (!code) {
+        out.textContent = 'Sorry, we could not determine the language.';
+        return;
+      }
+      let name = code;
+      try { name = NAMES.of(code) || code; } catch (e) { /* keep code */ }
+      out.textContent = 'Detected language: ' + name;
+    });
+  </script>
