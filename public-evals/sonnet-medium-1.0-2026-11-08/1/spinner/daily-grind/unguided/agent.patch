+  <script>
+    (function () {
+      var status = document.getElementById('busy-status');
+      var links = document.querySelectorAll('a.btn[data-loading-text]');
+
+      function reset(link) {
+        link.classList.remove('is-loading');
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('.btn-label').textContent = link.dataset.label;
+      }
+
+      links.forEach(function (link) {
+        var label = link.querySelector('.btn-label');
+        link.dataset.label = label.textContent;
+
+        link.addEventListener('click', function (e) {
+          // Let new-tab / modified clicks behave normally
+          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+          if (link.classList.contains('is-loading')) { e.preventDefault(); return; }
+          link.classList.add('is-loading');
+          link.setAttribute('aria-busy', 'true');
+          link.setAttribute('aria-disabled', 'true');
+          label.textContent = link.dataset.loadingText;
+          status.textContent = link.dataset.loadingText;
+        });
+      });
+
+      // Restore buttons when returning via back/forward cache
+      window.addEventListener('pageshow', function (e) {
+        if (!e.persisted) return;
+        status.textContent = '';
+        links.forEach(reset);
+      });
+    })();
+  </script>
+
 </body>
 
