+  <div class="visually-hidden" role="status" id="busy-status"></div>
+
+  <script>
+    const status = document.getElementById('busy-status');
+    const seasonal = document.getElementById('seasonal');
+
+    function setBusy(link) {
+      const label = link.dataset.busyLabel;
+      link.setAttribute('aria-busy', 'true');
+      const spinner = document.createElement('progress');
+      spinner.className = 'loading-spinner';
+      spinner.setAttribute('aria-label', label);
+      link.prepend(spinner);
+      if (link.closest('#seasonal')) seasonal.setAttribute('aria-busy', 'true');
+      status.textContent = label;
+    }
+
+    function clearBusy() {
+      document.querySelectorAll('.btn[aria-busy]').forEach((link) => {
+        link.removeAttribute('aria-busy');
+        link.querySelector('.loading-spinner')?.remove();
+      });
+      seasonal.removeAttribute('aria-busy');
+      status.textContent = '';
+    }
+
+    document.addEventListener('click', (e) => {
+      const link = e.target.closest('a.btn[data-busy-label]');
+      // Skip modified clicks that open new tabs/windows
+      if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+      if (link.getAttribute('aria-busy') === 'true') return e.preventDefault();
+      setBusy(link);
+    });
+
+    // Reset when returning via back/forward cache
+    addEventListener('pageshow', (e) => { if (e.persisted) clearBusy(); });
+  </script>
+
 </body>
 
