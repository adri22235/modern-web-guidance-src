+  <script>
+    // Popover polyfill for browsers without native support
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    (() => {
+      const DURATION = 4000;
+      const GAP = 12;
+      const open = []; // open toasts, oldest first; newest sits in the corner
+      const timers = new WeakMap();
+
+      let displayTransition;
+      function canTransitionDisplay() {
+        if (displayTransition !== undefined) return displayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return false;
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        displayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return displayTransition;
+      }
+
+      const supportsTopLayerExit = () =>
+        window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+
+      // Stack: each toast is lifted by the heights of the newer toasts below it
+      function layout() {
+        let offset = 0;
+        for (let i = open.length - 1; i >= 0; i--) {
+          open[i].style.setProperty('--toast-offset', offset + 'px');
+          offset += open[i].offsetHeight + GAP;
+        }
+      }
+
+      function schedule(toast) {
+        clearTimeout(timers.get(toast));
+        timers.set(toast, setTimeout(() => closeToast(toast), DURATION));
+      }
+
+      async function closeToast(toast) {
+        clearTimeout(timers.get(toast));
+        if (!toast.matches(':popover-open, .\\:popover-open')) return;
+        // Leave the stack right away so the others slide down while this one fades out
+        const i = open.indexOf(toast);
+        if (i > -1) { open.splice(i, 1); layout(); }
+        if (!supportsTopLayerExit()) {
+          toast.setAttribute('data-closing', '');
+          const animations = toast.getAnimations();
+          if (animations.length) {
+            await Promise.race([
+              Promise.allSettled(animations.map((a) => a.finished)),
+              new Promise((r) => setTimeout(r, 1000)),
+            ]);
+          }
+          toast.removeAttribute('data-closing');
+        }
+        toast.hidePopover();
+      }
+
+      function showToast(toast) {
+        const i = open.indexOf(toast);
+        if (i > -1) open.splice(i, 1); // already visible: move to the corner
+        else toast.showPopover();
+        open.push(toast);
+        layout();
+        schedule(toast);
+      }
+
+      document.addEventListener('click', (e) => {
+        const trigger = e.target.closest('.toast-trigger');
+        if (trigger) {
+          const toast = document.getElementById(trigger.dataset.toast);
+          if (toast) showToast(toast);
+          return;
+        }
+        const close = e.target.closest('.toast .toast-close');
+        if (close) {
+          e.preventDefault(); // close via closeToast() so the exit animates everywhere
+          closeToast(close.closest('.toast'));
+        }
+      });
+
+      // Keep toasts alive while hovered or focused
+      for (const toast of document.querySelectorAll('.toast')) {
+        const pause = () => clearTimeout(timers.get(toast));
+        const resume = () => { if (open.includes(toast)) schedule(toast); };
+        toast.addEventListener('pointerenter', pause);
+        toast.addEventListener('pointerleave', resume);
+        toast.addEventListener('focusin', pause);
+        toast.addEventListener('focusout', resume);
+      }
+    })();
+  </script>
+
