+  <!-- Optional pre-written toast: trigger with data-toast-target="#welcome-toast" -->
+  <div class="toast-templates" hidden>
+    <div class="toast" id="saved-toast">Your favorites have been saved.</div>
+  </div>
+
+  <script>
+    (function () {
+      var DURATION = 4000;
+      var MAX_TOASTS = 5;
+      var region = document.createElement('div');
+      region.className = 'toast-region';
+      region.setAttribute('role', 'status');
+      region.setAttribute('aria-live', 'polite');
+      document.body.appendChild(region);
+
+      function dismiss(toast) {
+        if (toast.classList.contains('is-leaving')) return;
+        toast.classList.add('is-leaving');
+        var done = function () { toast.remove(); };
+        toast.addEventListener('transitionend', done, { once: true });
+        setTimeout(done, 400); // fallback
+      }
+
+      function show(source, message) {
+        var toast;
+        if (source) {
+          toast = source.cloneNode(true);
+          toast.removeAttribute('id');
+          toast.hidden = false;
+        } else {
+          toast = document.createElement('div');
+          toast.className = 'toast';
+          toast.textContent = message;
+        }
+        var body = document.createElement('div');
+        body.className = 'toast-body';
+        while (toast.firstChild) body.appendChild(toast.firstChild);
+        var close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Dismiss notification');
+        close.innerHTML = '&times;';
+        toast.append(body, close);
+
+        var timer;
+        var start = function () { timer = setTimeout(function () { dismiss(toast); }, DURATION); };
+        var stop = function () { clearTimeout(timer); };
+        close.addEventListener('click', function () { stop(); dismiss(toast); });
+        toast.addEventListener('mouseenter', stop);
+        toast.addEventListener('mouseleave', start);
+        toast.addEventListener('focusin', stop);
+        toast.addEventListener('focusout', start);
+
+        region.appendChild(toast);
+        while (region.children.length > MAX_TOASTS) region.firstElementChild.remove();
+        start();
+      }
+
+      document.addEventListener('click', function (e) {
+        var trigger = e.target.closest('.toast-trigger');
+        if (!trigger) return;
+        var target = trigger.dataset.toastTarget;
+        var source = target ? document.querySelector(target) : null;
+        show(source, trigger.dataset.toastMessage || 'Done!');
+      });
+    })();
+  </script>
+
