+<script>
+    document.querySelectorAll('.fav-btn').forEach(function (btn) {
+      btn.addEventListener('click', function () {
+        var on = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', on);
+        btn.setAttribute('aria-label', btn.getAttribute('aria-label').replace(on ? /^Add (.*) to favorites$/ : /^Remove (.*) from favorites$/, on ? 'Remove $1 from favorites' : 'Add $1 to favorites'));
+      });
+    });
+  </script>
