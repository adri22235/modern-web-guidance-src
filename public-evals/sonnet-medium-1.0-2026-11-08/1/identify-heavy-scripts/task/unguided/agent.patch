diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -152,8 +152,87 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
   </style>
+  <script>
+    // Script performance monitor: detects scripts that delay frames (Long
+    // Animation Frames API, falling back to Long Tasks) and keeps a history
+    // of occurrences in localStorage. Inspect via window.scriptPerf.getLog().
+    (function () {
+      var STORAGE_KEY = 'scriptPerfLog';
+      var MAX_ENTRIES = 50;
+      var SLOW_FRAME_MS = 50; // LoAF threshold is 50ms by spec
+
+      function load() {
+        try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
+        catch (e) { return []; }
+      }
+
+      function save(log) {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(log.slice(-MAX_ENTRIES))); }
+        catch (e) { /* storage unavailable or full; keep running */ }
+      }
+
+      function record(entry) {
+        var log = load();
+        log.push(entry);
+        save(log);
+        console.warn('[scriptPerf] Slow ' + entry.type + ' (' + entry.duration + 'ms)', entry);
+      }
+
+      function fromFrame(frame) {
+        var scripts = (frame.scripts || []).map(function (s) {
+          return {
+            source: s.sourceURL || s.invoker || 'inline',
+            invoker: s.invoker,
+            type: s.invokerType,
+            fn: s.sourceFunctionName,
+            duration: Math.round(s.duration)
+          };
+        }).sort(function (a, b) { return b.duration - a.duration; });
+        return {
+          type: 'frame',
+          time: new Date().toISOString(),
+          page: location.pathname,
+          start: Math.round(frame.startTime),
+          duration: Math.round(frame.duration),
+          blocking: Math.round(frame.blockingDuration || 0),
+          scripts: scripts.slice(0, 5)
+        };
+      }
+
+      function observe(type, handler) {
+        try {
+          var po = new PerformanceObserver(function (list) {
+            list.getEntries().forEach(handler);
+          });
+          po.observe({ type: type, buffered: true });
+          return true;
+        } catch (e) { return false; }
+      }
+
+      var supported =
+        observe('long-animation-frame', function (frame) {
+          if (frame.duration >= SLOW_FRAME_MS) record(fromFrame(frame));
+        }) ||
+        observe('longtask', function (task) {
+          record({
+            type: 'task',
+            time: new Date().toISOString(),
+            page: location.pathname,
+            start: Math.round(task.startTime),
+            duration: Math.round(task.duration),
+            scripts: []
+          });
+        });
+
+      window.scriptPerf = {
+        supported: supported,
+        getLog: load,
+        clear: function () { try { localStorage.removeItem(STORAGE_KEY); } catch (e) {} }
+      };
+    })();
+  </script>
 </head>
 
