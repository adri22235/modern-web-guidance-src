+  <script>
+    // Spatial (arrow key) navigation for the card grid. Uses a roving tabindex
+    // and live geometry, so it follows whatever layout the CSS grid produces.
+    (() => {
+      const grid = document.querySelector('.grid[role="grid"]');
+      if (!grid) return;
+      const ITEMS = 'a[href]';
+      const TOLERANCE = 2;
+      const WEIGHT = 2;
+      const DIRS = { ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down' };
+
+      const overlap = (a0, a1, b0, b1) => Math.min(a1, b1) - Math.max(a0, b0) > 0;
+
+      function findNext(current, dir) {
+        const c = current.getBoundingClientRect();
+        const horizontal = dir === 'left' || dir === 'right';
+        let best = null;
+        for (const el of grid.querySelectorAll(ITEMS)) {
+          if (el === current || !el.checkVisibility()) continue;
+          const r = el.getBoundingClientRect();
+          let gap;
+          if (dir === 'right') gap = r.left - c.right;
+          else if (dir === 'left') gap = c.left - r.right;
+          else if (dir === 'down') gap = r.top - c.bottom;
+          else gap = c.top - r.bottom;
+          if (gap < -TOLERANCE) continue;
+          gap = Math.max(gap, 0);
+          const aligned = horizontal
+            ? overlap(c.top, c.bottom, r.top, r.bottom)
+            : overlap(c.left, c.right, r.left, r.right);
+          const offset = horizontal
+            ? Math.abs((r.top + r.bottom) / 2 - (c.top + c.bottom) / 2)
+            : Math.abs((r.left + r.right) / 2 - (c.left + c.right) / 2);
+          const score = aligned ? [0, gap, offset] : [1, gap + WEIGHT * offset, 0];
+          if (!best || score[0] < best.score[0] ||
+              (score[0] === best.score[0] && (score[1] < best.score[1] ||
+              (score[1] === best.score[1] && score[2] < best.score[2])))) {
+            best = { el, score };
+          }
+        }
+        return best && best.el;
+      }
+
+      grid.addEventListener('keydown', (e) => {
+        const dir = DIRS[e.key];
+        if (!dir || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element) || !target.matches(ITEMS)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+        const next = findNext(target, dir);
+        if (!next) return; // let the browser scroll natively
+        e.preventDefault();
+        target.tabIndex = -1;
+        next.tabIndex = 0;
+        next.focus();
+        next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      });
+
+      // Keep the single tab stop in sync when focus arrives by click.
+      grid.addEventListener('focusin', (e) => {
+        if (!e.target.matches(ITEMS)) return;
+        for (const el of grid.querySelectorAll(ITEMS)) el.tabIndex = el === e.target ? 0 : -1;
+      });
+    })();
+  </script>
+
