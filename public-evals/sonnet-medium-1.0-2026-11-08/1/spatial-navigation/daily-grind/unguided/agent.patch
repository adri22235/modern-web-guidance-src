+<script>
+    // Spatial arrow-key navigation for card grids. Positions are read from the
+    // rendered layout, so it works for any column count (auto-fit, one column
+    // on narrow screens, RTL). Links stay in the normal Tab order.
+    document.querySelectorAll('[data-spatial-nav]').forEach(function (grid) {
+      var SELECTOR = 'a[href], button:not([disabled])';
+
+      function items() {
+        return Array.prototype.filter.call(grid.querySelectorAll(SELECTOR), function (el) {
+          return el.offsetParent !== null;
+        });
+      }
+
+      function center(r) {
+        return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
+      }
+
+      function pick(list, current, dir) {
+        var cr = current.getBoundingClientRect();
+        var c = center(cr);
+        var best = null, bestScore = Infinity;
+        list.forEach(function (el) {
+          if (el === current) return;
+          var r = el.getBoundingClientRect();
+          var p = center(r);
+          var dx = p.x - c.x, dy = p.y - c.y;
+          var primary, cross;
+          if (dir === 'up' || dir === 'down') {
+            primary = dir === 'down' ? dy : -dy;
+            cross = Math.abs(dx);
+            if (primary <= cr.height / 2) return; // must be on a different row
+          } else {
+            primary = dir === 'right' ? dx : -dx;
+            cross = Math.abs(dy);
+            if (primary <= 0 || cross > Math.max(cr.height, r.height) / 2) return; // same row only
+          }
+          var score = primary + cross * 3;
+          if (score < bestScore) { bestScore = score; best = el; }
+        });
+        return best;
+      }
+
+      grid.addEventListener('keydown', function (e) {
+        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+        var list = items();
+        var current = list.indexOf(document.activeElement) >= 0
+          ? document.activeElement
+          : list.find(function (el) { return el.contains(document.activeElement); });
+        if (!current) return;
+
+        var rtl = getComputedStyle(grid).direction === 'rtl';
+        var dir = { ArrowUp: 'up', ArrowDown: 'down',
+                    ArrowLeft: rtl ? 'right' : 'left',
+                    ArrowRight: rtl ? 'left' : 'right' }[e.key];
+        var idx = list.indexOf(current);
+        var target = null;
+
+        if (dir) {
+          target = pick(list, current, dir);
+          // At the end of a row, continue to the previous/next item in reading order.
+          if (!target && (dir === 'left' || dir === 'right')) {
+            var forward = (dir === 'right') !== rtl ? 1 : -1;
+            target = list[idx + forward] || null;
+          }
+        } else if (e.key === 'Home') {
+          target = list[0];
+        } else if (e.key === 'End') {
+          target = list[list.length - 1];
+        } else {
+          return;
+        }
+
+        e.preventDefault();
+        if (target && target !== current) target.focus();
+      });
+    });
+  </script>
+
