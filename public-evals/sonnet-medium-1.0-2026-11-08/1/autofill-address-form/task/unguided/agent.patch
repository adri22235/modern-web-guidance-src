+    /* Shipping Form */
+    .shipping {
+      max-width: 700px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .shipping form {
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: grid;
+      grid-template-columns: repeat(2, 1fr);
+      gap: 16px;
+    }
+
+    .shipping h2,
+    .shipping .intro {
+      text-align: center;
+    }
+
+    .shipping .intro {
+      margin-bottom: 20px;
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .field.full {
+      grid-column: 1 / -1;
+    }
+
+    .field label {
+      font-size: 0.85rem;
+      font-weight: 600;
+      margin-bottom: 4px;
+    }
+
+    .field input,
+    .field select {
+      font: inherit;
+      padding: 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      background: white;
+      color: var(--text);
+    }
+
+    .field input:focus,
+    .field select:focus {
+      outline: 2px solid var(--accent);
+      border-color: var(--accent);
+    }
+
+    .shipping button.btn {
+      grid-column: 1 / -1;
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      margin-top: 5px;
+    }
+
+    @media (max-width: 600px) {
+      .shipping form {
+        grid-template-columns: 1fr;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
