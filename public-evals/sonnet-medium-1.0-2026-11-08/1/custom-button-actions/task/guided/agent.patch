+  <script>
+    // Invoker Commands polyfill for browsers without native support
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch((err) => console.error('Error loading fallback:', err));
+    }
+
+    const toggle = (className) => (target, source) => {
+      const on = target.classList.toggle(className);
+      source?.setAttribute('aria-pressed', on);
+    };
+
+    const commandRegistry = {
+      '--spin': toggle('is-spun'),
+      '--grow': toggle('is-grown'),
+      '--round': toggle('is-rounded'),
+      '--reset': (target) => {
+        target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+        document.querySelectorAll(`button[commandfor="${target.id}"][aria-pressed]`).forEach((btn) => {
+          btn.setAttribute('aria-pressed', 'false');
+        });
+      },
+    };
+
+    // The command event doesn't bubble, so listen on the target itself
+    document.getElementById('action-target').addEventListener('command', (event) => {
+      commandRegistry[event.command]?.(event.target, event.source);
+    });
+  </script>
