+  <script>
+    const target = document.getElementById('action-target');
+    const stateClasses = ['is-spun', 'is-grown', 'is-rounded'];
+
+    document.querySelectorAll('[data-toggle]').forEach(btn => {
+      btn.addEventListener('click', () => target.classList.toggle(btn.dataset.toggle));
+    });
+
+    document.getElementById('reset-all').addEventListener('click', () => {
+      target.classList.remove(...stateClasses);
+    });
