+  <script>
+    // Quick sign-in: authenticate returning customers in place with a saved
+    // passkey or password (immediate UI mode). Anything unsupported or
+    // dismissed falls back to normal navigation, so existing flows are unchanged.
+    (() => {
+      let isAuthenticating = false;
+
+      async function isImmediateUiSupported() {
+        if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities ||
+            !PublicKeyCredential.parseRequestOptionsFromJSON) {
+          return false;
+        }
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          return Boolean(capabilities?.immediateGet);
+        } catch {
+          return false;
+        }
+      }
+
+      async function postJSON(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: body && JSON.stringify(body),
+        });
+      }
+
+      async function authenticateWithImmediateUi() {
+        if (!(await isImmediateUiSupported())) {
+          throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+        }
+        const optionsResponse = await postJSON('/api/login/options');
+        if (!optionsResponse.ok) throw new Error('Failed to fetch authentication options');
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await optionsResponse.json());
+
+        // No allowCredentials and no signal: both are rejected in immediate mode.
+        const cred = await navigator.credentials.get({ password: true, publicKey, uiMode: 'immediate' });
+        if (!cred) throw new DOMException('No credential returned', 'NotAllowedError');
+
+        if (cred.type === 'public-key') {
+          const encoded = cred.toJSON();
+          const response = await postJSON('/api/login/verify', encoded);
+          if (response.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          }
+          if (!response.ok) throw new Error('Passkey verification failed');
+          return;
+        }
+        if (cred.type === 'password') {
+          const response = await postJSON('/api/login/password', { username: cred.id, password: cred.password });
+          if (!response.ok) throw new Error('Password verification failed');
+          return;
+        }
+        throw new Error('Unsupported credential type: ' + cred.type);
+      }
+
+      document.addEventListener('click', async (event) => {
+        const link = event.target.closest('a[data-quick-sign-in]');
+        if (!link || document.body.dataset.signedIn === 'true' ||
+            event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+          return;
+        }
+        event.preventDefault();
+        if (isAuthenticating) return;
+        isAuthenticating = true;
+        try {
+          await authenticateWithImmediateUi();
+          document.body.dataset.signedIn = 'true';
+        } catch (err) {
+          // NotAllowedError: unsupported, no local credentials, or dismissed.
+          if (err.name !== 'NotAllowedError') console.error('Quick sign-in failed:', err);
+        } finally {
+          isAuthenticating = false;
+        }
+        // Signed in: continue straight to the destination. Otherwise the
+        // site's normal flow (which may prompt for sign-in) takes over.
+        window.location.href = link.href;
+      });
+    })();
+  </script>
+
