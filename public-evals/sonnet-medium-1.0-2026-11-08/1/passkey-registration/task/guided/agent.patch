+  <script>
+    (() => {
+      const button = document.getElementById('register-button');
+      const status = document.getElementById('passkey-status');
+
+      const setStatus = (msg) => { status.textContent = msg; };
+
+      // Fallbacks for browsers lacking the JSON helpers
+      const b64urlToBuffer = (str) => {
+        const b64 = str.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(str.length / 4) * 4, '=');
+        return Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)).buffer;
+      };
+      const bufferToB64url = (buf) =>
+        btoa(String.fromCharCode(...new Uint8Array(buf))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+      const parseCreationOptions = (json) => {
+        if (PublicKeyCredential.parseCreationOptionsFromJSON) {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+          excludeCredentials: (json.excludeCredentials || []).map((c) => ({ ...c, id: b64urlToBuffer(c.id) })),
+        };
+      };
+
+      const credentialToJSON = (cred) => {
+        if (typeof cred.toJSON === 'function') return cred.toJSON();
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment,
+          clientExtensionResults: cred.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            attestationObject: bufferToB64url(r.attestationObject),
+            transports: r.getTransports ? r.getTransports() : [],
+          },
+        };
+      };
+
+      const signalOrphan = async (rpId, credentialId) => {
+        if (!PublicKeyCredential.signalUnknownCredential) return;
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+        } catch (e) {
+          console.warn('signalUnknownCredential failed', e);
+        }
+      };
+
+      const postJSON = (url, body) =>
+        fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(body),
+        });
+
+      // Gate the UI on passkey support
+      (async () => {
+        if (!window.PublicKeyCredential) {
+          button.disabled = true;
+          setStatus('Passkeys are not supported in this browser.');
+          return;
+        }
+        if (PublicKeyCredential.getClientCapabilities) {
+          try {
+            const caps = await PublicKeyCredential.getClientCapabilities();
+            if (caps.passkeyPlatformAuthenticator === false || caps.conditionalGet === false) {
+              button.disabled = true;
+              setStatus('Passkeys are not available on this device.');
+            }
+          } catch (e) {
+            console.warn('getClientCapabilities failed', e);
+          }
+        }
+      })();
+
+      button.addEventListener('click', async () => {
+        if (!window.PublicKeyCredential) return;
+        button.disabled = true;
+        setStatus('');
+        try {
+          let publicKey;
+          try {
+            const res = await postJSON('/api/register/options', { promotion: true });
+            if (!res.ok) throw new Error('options ' + res.status);
+            publicKey = parseCreationOptions(await res.json());
+          } catch (err) {
+            console.error(err);
+            setStatus('Could not start passkey creation. Please try again.');
+            return;
+          }
+
+          let credential;
+          try {
+            credential = await navigator.credentials.create({ publicKey });
+          } catch (err) {
+            if (err.name === 'InvalidStateError') setStatus('A passkey already exists for this account.');
+            else if (err.name === 'SecurityError') setStatus('Passkeys cannot be created on this site configuration.');
+            else if (err.name === 'NotAllowedError') setStatus('Passkey creation was cancelled.');
+            else if (err.name === 'AbortError') setStatus('Passkey creation was aborted.');
+            else setStatus('Passkey creation failed.');
+            return; // user cancellations are not orphaned credentials
+          }
+          if (!credential) { setStatus('Passkey creation failed.'); return; }
+
+          const encoded = credentialToJSON(credential);
+          // rp.id comes from the server options, never from window.location
+          const rpId = publicKey.rp.id;
+          try {
+            const res = await postJSON('/api/register/verify', encoded);
+            if (res.ok) {
+              setStatus('Passkey created successfully!');
+            } else {
+              await signalOrphan(rpId, encoded.id);
+              setStatus('Passkey verification failed. Please try again.');
+            }
+          } catch (err) {
+            console.error('Server verification network failure:', err);
+            await signalOrphan(rpId, encoded.id);
+            setStatus('Network error while verifying your passkey.');
+          }
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
