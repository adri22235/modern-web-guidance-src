+    /* Store Select */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    .store-select-wrap {
+      margin: 0 0 1.5rem;
+    }
+
+    .store-select-wrap label {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+    }
+
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .store-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.75rem;
+      width: min(320px, 100%);
+      padding: 0.75rem 1rem;
+      font: inherit;
+      color: white;
+      background: rgba(0, 0, 0, 0.35);
+      border: 1px solid rgba(255, 255, 255, 0.6);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s ease, background-color 0.2s ease;
+    }
+
+    .store-select:hover,
+    .store-select:open {
+      border-color: var(--accent);
+      background: rgba(0, 0, 0, 0.5);
+    }
+
+    .store-select::picker-icon {
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    .store-select::picker(select) {
+      background: white;
+      color: var(--text);
+      border: none;
+      border-radius: 10px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.3);
+      padding: 0.4rem;
+      margin-top: 0.25rem;
+      width: anchor-size(width);
+      text-align: left;
+
+      transition:
+        display,
+        overlay,
+        opacity cubic-bezier(0.16, 1, 0.3, 1),
+        height cubic-bezier(0.16, 1, 0.3, 1);
+      transition-duration: 0.35s;
+      transition-behavior: allow-discrete;
+      opacity: 0;
+      height: 0;
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      height: auto;
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        height: 0;
+      }
+    }
+
+    .store-select option {
+      padding: 0.5rem 0.75rem;
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .store-select option:hover,
+    .store-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+      background: var(--secondary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none !important;
+      }
+    }
+
