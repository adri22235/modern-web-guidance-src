@@ -92,8 +92,98 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    /* Store select (customizable native select) */
+    .store-select {
+      margin-top: 1.25rem;
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      background: white;
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      padding: 10px 14px;
+      min-width: 240px;
+      cursor: pointer;
+    }
+
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select {
+        display: inline-flex;
+        justify-content: space-between;
+        align-items: center;
+        gap: 12px;
+        text-align: left;
+      }
+
+      .store-select::picker-icon {
+        content: "";
+        width: 0.5em;
+        height: 0.5em;
+        border-right: 2px solid currentColor;
+        border-bottom: 2px solid currentColor;
+        transform: translateY(-25%) rotate(45deg);
+        transition: transform 0.3s ease;
+      }
+
+      .store-select:open::picker-icon {
+        transform: translateY(25%) rotate(-135deg);
+      }
+
+      .store-select::picker(select) {
+        margin-top: 6px;
+        padding: 4px;
+        border: 2px solid var(--accent);
+        border-radius: 6px;
+        background: white;
+        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
+        opacity: 0;
+        transform: translateY(-8px);
+        transition: opacity 0.25s ease, transform 0.25s ease,
+          overlay 0.25s allow-discrete, display 0.25s allow-discrete;
+      }
+
+      .store-select::picker(select):popover-open {
+        opacity: 1;
+        transform: translateY(0);
+      }
+
+      @starting-style {
+        .store-select::picker(select):popover-open {
+          opacity: 0;
+          transform: translateY(-8px);
+        }
+      }
+
+      .store-select option {
+        padding: 8px 12px;
+        border-radius: 4px;
+        transition: background 0.2s;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .store-select option::checkmark {
+        color: var(--accent);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker-icon,
+      .store-select::picker(select) {
+        transition-duration: 0.01s;
+      }
+    }
+
