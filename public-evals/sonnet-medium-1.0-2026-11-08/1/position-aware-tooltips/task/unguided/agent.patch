+  <div id="anchor-tooltip" class="tooltip" role="tooltip">
+    Made with 12 oz of steamed oat milk, a double shot of espresso, and pure Vermont maple syrup. Vegan and dairy-free.
+    <span class="tooltip-arrow" aria-hidden="true"></span>
+  </div>
+
+  <script>
+    (function () {
+      var anchor = document.getElementById('anchor');
+      var tip = document.getElementById('anchor-tooltip');
+      var arrow = tip.querySelector('.tooltip-arrow');
+      var GAP = 10;      // distance between anchor and tooltip (room for the arrow)
+      var MARGIN = 8;    // minimum distance from viewport edges
+      var ARROW_PAD = 12; // keep arrow clear of rounded corners
+
+      function space(side, a, tw, th) {
+        switch (side) {
+          case 'top': return a.top - MARGIN - GAP - th;
+          case 'bottom': return window.innerHeight - a.bottom - MARGIN - GAP - th;
+          case 'left': return a.left - MARGIN - GAP - tw;
+          default: return window.innerWidth - a.right - MARGIN - GAP - tw;
+        }
+      }
+
+      function clamp(v, min, max) {
+        return Math.max(min, Math.min(v, max));
+      }
+
+      function position() {
+        var a = anchor.getBoundingClientRect();
+        var tw = tip.offsetWidth;
+        var th = tip.offsetHeight;
+
+        // Preferred: top. Flip to the opposite side if it doesn't fit, then try the sides.
+        var order = ['top', 'bottom', 'left', 'right'];
+        var placement = order.find(function (s) { return space(s, a, tw, th) >= 0; });
+        if (!placement) {
+          // Nothing fits entirely: pick the side with the most room.
+          placement = order.reduce(function (best, s) {
+            return space(s, a, tw, th) > space(best, a, tw, th) ? s : best;
+          });
+        }
+
+        var x, y;
+        if (placement === 'top' || placement === 'bottom') {
+          x = clamp(a.left + a.width / 2 - tw / 2, MARGIN, window.innerWidth - tw - MARGIN);
+          y = placement === 'top' ? a.top - GAP - th : a.bottom + GAP;
+        } else {
+          y = clamp(a.top + a.height / 2 - th / 2, MARGIN, window.innerHeight - th - MARGIN);
+          x = placement === 'left' ? a.left - GAP - tw : a.right + GAP;
+        }
+
+        tip.style.transform = 'translate(' + Math.round(x) + 'px,' + Math.round(y) + 'px)';
+        tip.dataset.placement = placement;
+
+        // Point the arrow at the anchor's center, even when the tooltip was shifted.
+        var half = parseFloat(getComputedStyle(tip).getPropertyValue('--arrow-size')) / 2;
+        arrow.style.left = arrow.style.top = '';
+        if (placement === 'top' || placement === 'bottom') {
+          var ax = a.left + a.width / 2 - x - half;
+          arrow.style.left = clamp(ax, ARROW_PAD - half, tw - ARROW_PAD - half) + 'px';
+        } else {
+          var ay = a.top + a.height / 2 - y - half;
+          arrow.style.top = clamp(ay, ARROW_PAD - half, th - ARROW_PAD - half) + 'px';
+        }
+      }
+
+      function open() {
+        tip.classList.add('is-open');
+        anchor.setAttribute('aria-expanded', 'true');
+        position();
+      }
+
+      function close() {
+        tip.classList.remove('is-open');
+        anchor.setAttribute('aria-expanded', 'false');
+      }
+
+      function isOpen() { return tip.classList.contains('is-open'); }
+
+      anchor.addEventListener('mouseenter', open);
+      anchor.addEventListener('mouseleave', function () {
+        if (document.activeElement !== anchor) close();
+      });
+      anchor.addEventListener('focus', open);
+      anchor.addEventListener('blur', close);
+      anchor.addEventListener('click', open); // touch: tap shows it; blur/Escape hides it
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape') close();
+      });
+      window.addEventListener('resize', function () { if (isOpen()) position(); });
+      window.addEventListener('scroll', function () { if (isOpen()) position(); }, { passive: true });
+    })();
+  </script>
