@@ -119,8 +119,132 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Info tooltip */
+    .info-btn {
+      display: inline-grid;
+      place-items: center;
+      inline-size: 1.5rem;
+      block-size: 1.5rem;
+      margin-inline-start: 0.4rem;
+      padding: 0;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: transparent;
+      color: var(--primary);
+      font: italic bold 0.85rem/1 Georgia, serif;
+      cursor: pointer;
+      vertical-align: middle;
+    }
+
+    .info-btn:hover,
+    .info-btn:focus-visible {
+      background: var(--primary);
+      color: white;
+    }
+
+    #tooltip {
+      --arrow: 8px;
+      --bg: var(--primary);
+      border: 0;
+      padding: 0;
+      background: transparent;
+      color: white;
+      overflow: visible;
+    }
+
+    @supports (anchor-name: --a) {
+      #tooltip {
+        inset: auto;
+        margin: unset;
+        position: fixed;
+        position-area: block-start;
+        position-try-fallbacks: flip-block, --tip-end, --tip-start;
+        container-type: anchored;
+      }
+
+      @position-try --tip-end {
+        position-area: inline-end;
+      }
+
+      @position-try --tip-start {
+        position-area: inline-start;
+      }
+    }
+
+    .tooltip-content {
+      position: relative;
+      max-inline-size: min(16rem, 90vw);
+      padding: 0.6rem 0.8rem;
+      border-radius: 6px;
+      background: var(--bg);
+      font-size: 0.85rem;
+      line-height: 1.4;
+      text-align: start;
+      /* room for the arrow between the bubble and the trigger */
+      margin-block-end: var(--arrow);
+    }
+
+    /* Arrow: default points down from the bottom edge (tooltip above anchor) */
+    .tooltip-content::before {
+      content: "";
+      position: absolute;
+      inline-size: calc(var(--arrow) * 2);
+      block-size: var(--arrow);
+      inset-inline-start: 50%;
+      inset-block-end: calc(var(--arrow) * -1);
+      translate: -50% 0;
+      background: var(--bg);
+      clip-path: polygon(0 0, 100% 0, 50% 100%);
+    }
+
+    /* Tooltip below the anchor: arrow on top, pointing up */
+    @container anchored(fallback: flip-block) {
+      .tooltip-content {
+        margin-block: var(--arrow) 0;
+      }
+
+      .tooltip-content::before {
+        inset-block: calc(var(--arrow) * -1) auto;
+        clip-path: polygon(50% 0, 0 100%, 100% 100%);
+      }
+    }
+
+    /* Tooltip to the right of the anchor: arrow on the left edge, pointing left */
+    @container anchored(fallback: --tip-end) {
+      .tooltip-content {
+        margin-block: 0;
+        margin-inline: var(--arrow) 0;
+      }
+
+      .tooltip-content::before {
+        inset-block: 50% auto;
+        inset-inline: calc(var(--arrow) * -1) auto;
+        translate: 0 -50%;
+        inline-size: var(--arrow);
+        block-size: calc(var(--arrow) * 2);
+        clip-path: polygon(100% 0, 0 50%, 100% 100%);
+      }
+    }
+
+    /* Tooltip to the left of the anchor: arrow on the right edge, pointing right */
+    @container anchored(fallback: --tip-start) {
+      .tooltip-content {
+        margin-block: 0;
+        margin-inline: 0 var(--arrow);
+      }
+
+      .tooltip-content::before {
+        inset-block: 50% auto;
+        inset-inline: auto calc(var(--arrow) * -1);
+        translate: 0 -50%;
+        inline-size: var(--arrow);
+        block-size: calc(var(--arrow) * 2);
+        clip-path: polygon(0 0, 100% 50%, 0 100%);
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
