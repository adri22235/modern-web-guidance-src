+  <script>
+    (function () {
+      var grid = document.getElementById('seasonal-grid');
+      var restoreBtn = document.getElementById('seasonal-restore');
+      var countEl = document.getElementById('seasonal-count');
+      var statusEl = document.getElementById('seasonal-status');
+      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var DUR = 350, EASE = 'cubic-bezier(.2,.8,.2,1)';
+      var removed = []; // {el, index}
+      var SIZES = [['S', -0.5], ['M', 0], ['L', 0.75]];
+      var EXTRAS = [['Extra shot', 0.75], ['Oat milk', 0.5]];
+
+      function cards() {
+        return Array.prototype.filter.call(grid.querySelectorAll('.card'), function (c) {
+          return !c.classList.contains('leaving');
+        });
+      }
+      function say(msg) { statusEl.textContent = msg; }
+      function name(c) { return c.querySelector('h3').textContent; }
+
+      // FLIP: measure, mutate, then animate each card independently from its old spot.
+      function flip(mutate) {
+        var all = Array.prototype.slice.call(grid.querySelectorAll('.card'));
+        var first = all.map(function (c) { return c.getBoundingClientRect(); });
+        mutate();
+        if (reduce.matches) return;
+        Array.prototype.slice.call(grid.querySelectorAll('.card')).forEach(function (c) {
+          var i = all.indexOf(c);
+          if (i < 0 || c.classList.contains('leaving')) return;
+          var last = c.getBoundingClientRect();
+          var dx = first[i].left - last.left, dy = first[i].top - last.top;
+          if (!dx && !dy) return;
+          if (c._move) c._move.cancel();
+          c._move = c.animate(
+            [{ transform: 'translate(' + dx + 'px,' + dy + 'px)' }, { transform: 'none' }],
+            { duration: DUR, easing: EASE }
+          );
+        });
+      }
+
+      function enter(c) {
+        if (reduce.matches) return;
+        c.animate(
+          [{ opacity: 0, transform: 'scale(.85)' }, { opacity: 1, transform: 'none' }],
+          { duration: DUR, easing: EASE }
+        );
+      }
+
+      function leave(c, done) {
+        c.classList.add('leaving');
+        c.querySelectorAll('button').forEach(function (b) { b.disabled = true; });
+        if (reduce.matches) return done();
+        var a = c.animate(
+          [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(.8)' }],
+          { duration: 250, easing: 'ease-in', fill: 'forwards' }
+        );
+        c._leave = a;
+        a.onfinish = done;
+      }
+
+      function update() {
+        var list = cards();
+        list.forEach(function (c, i) {
+          c.querySelector('[data-act=left]').disabled = i === 0;
+          c.querySelector('[data-act=right]').disabled = i === list.length - 1;
+        });
+        countEl.textContent = list.length ? list.length + ' of ' + (list.length + removed.length) + ' shown' : 'All drinks removed';
+        restoreBtn.hidden = !removed.length;
+      }
+
+      function price(c) {
+        var p = parseFloat(c.dataset.price);
+        c.querySelectorAll('.chip[aria-pressed=true]').forEach(function (b) { p += parseFloat(b.dataset.delta); });
+        c.querySelector('.summary').textContent = '$' + p.toFixed(2);
+      }
+
+      function setup(c) {
+        var controls = document.createElement('div');
+        controls.className = 'card-controls';
+        controls.innerHTML =
+          '<button type="button" data-act="left" aria-label="Move ' + name(c) + ' earlier">&larr;</button>' +
+          '<button type="button" data-act="right" aria-label="Move ' + name(c) + ' later">&rarr;</button>' +
+          '<button type="button" data-act="remove" aria-label="Remove ' + name(c) + '">&times;</button>';
+        c.insertBefore(controls, c.firstChild);
+
+        var opts = document.createElement('div');
+        opts.className = 'options';
+        SIZES.forEach(function (s) {
+          opts.innerHTML += '<button type="button" class="chip" data-group="size" data-delta="' + s[1] +
+            '" aria-pressed="' + (s[0] === 'M') + '">' + s[0] + '</button>';
+        });
+        EXTRAS.forEach(function (x) {
+          opts.innerHTML += '<button type="button" class="chip chip-extra" data-delta="' + x[1] +
+            '" aria-pressed="false">' + x[0] + '</button>';
+        });
+        var btn = c.querySelector('.btn');
+        c.insertBefore(opts, btn);
+        var sum = document.createElement('div');
+        sum.className = 'summary';
+        c.insertBefore(sum, btn);
+        price(c);
+      }
+
+      cards().forEach(setup);
+      update();
+
+      grid.addEventListener('click', function (e) {
+        var t = e.target.closest('button');
+        if (!t) return;
+        var c = t.closest('.card');
+        if (t.classList.contains('chip')) {
+          if (t.dataset.group === 'size') {
+            c.querySelectorAll('.chip[data-group=size]').forEach(function (b) { b.setAttribute('aria-pressed', b === t); });
+          } else {
+            t.setAttribute('aria-pressed', t.getAttribute('aria-pressed') !== 'true');
+          }
+          price(c);
+          var s = c.querySelector('.summary');
+          if (!reduce.matches) s.animate([{ transform: 'scale(1.25)' }, { transform: 'none' }], { duration: 250, easing: EASE });
+          return;
+        }
+        var act = t.dataset.act;
+        if (act === 'left' || act === 'right') {
+          var list = cards(), i = list.indexOf(c);
+          var other = list[act === 'left' ? i - 1 : i + 1];
+          if (!other) return;
+          flip(function () {
+            if (act === 'left') grid.insertBefore(c, other);
+            else grid.insertBefore(other, c);
+          });
+          update();
+          say(name(c) + ' moved to position ' + (cards().indexOf(c) + 1));
+          t.focus();
+          if (t.disabled) c.querySelector('[data-act=' + (act === 'left' ? 'right' : 'left') + ']').focus();
+        } else if (act === 'remove') {
+          var idx = cards().indexOf(c);
+          removed.push({ el: c, index: idx });
+          var next = cards()[idx + 1] || cards()[idx - 1];
+          leave(c, function () {
+            flip(function () { grid.removeChild(c); c.classList.remove('leaving'); });
+            c.getAnimations().forEach(function (a) { a.cancel(); });
+          });
+          update();
+          say(name(c) + ' removed');
+          (next ? next.querySelector('[data-act=remove]') : restoreBtn).focus();
+        }
+      });
+
+      restoreBtn.addEventListener('click', function () {
+        var items = removed.splice(0);
+        items.sort(function (a, b) { return a.index - b.index; });
+        flip(function () {
+          items.forEach(function (it) {
+            it.el.querySelectorAll('button').forEach(function (b) { b.disabled = false; });
+            it.el.classList.remove('leaving');
+            if (it.el._leave) { it.el._leave.onfinish = null; it.el._leave.cancel(); it.el._leave = null; }
+            if (it.el.parentNode !== grid) {
+              var ref = grid.children[it.index] || null;
+              grid.insertBefore(it.el, ref);
+            }
+          });
+        });
+        items.forEach(function (it) { if (!it.el._move) enter(it.el); });
+        update();
+        say('Drinks restored');
+      });
+    })();
+  </script>
 </body>
 
