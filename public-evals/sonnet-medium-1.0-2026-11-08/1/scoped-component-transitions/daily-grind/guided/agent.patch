+  <script>
+    (() => {
+      const grid = document.getElementById('seasonal-grid');
+      const resetBtn = document.getElementById('seasonal-reset');
+      const pool = ['Extra shot', 'Vanilla', 'Caramel drizzle', 'Cinnamon', 'Whipped cream', 'Oat milk'];
+      const original = Array.from(grid.children);
+      const removed = new Set();
+      const scoped = 'startViewTransition' in Element.prototype;
+
+      // Each component animates in its own scope, so transitions never block the page or each other.
+      function run(scopeEl, update) {
+        if (!scoped) return update();
+        scopeEl.startViewTransition(update).ready.catch(() => {});
+      }
+
+      function syncControls() {
+        const cards = Array.from(grid.children);
+        cards.forEach((c, i) => {
+          c.querySelector('[data-action="earlier"]').disabled = i === 0;
+          c.querySelector('[data-action="later"]').disabled = i === cards.length - 1;
+        });
+        resetBtn.hidden = removed.size === 0;
+      }
+
+      grid.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-action]');
+        if (!btn) return;
+        const wrapper = btn.closest('.card-wrapper');
+        const card = wrapper.querySelector('.card');
+        const action = btn.dataset.action;
+
+        if (action === 'earlier' || action === 'later') {
+          const other = action === 'earlier' ? wrapper.previousElementSibling : wrapper.nextElementSibling;
+          if (!other) return;
+          run(grid, () => {
+            if (action === 'earlier') grid.insertBefore(wrapper, other);
+            else grid.insertBefore(other, wrapper);
+            syncControls();
+            // Moving a node drops focus; restore it
+            (btn.disabled ? wrapper.querySelector('[data-action="' + (action === 'earlier' ? 'later' : 'earlier') + '"]') : btn).focus();
+          });
+        } else if (action === 'remove-card') {
+          const next = wrapper.nextElementSibling || wrapper.previousElementSibling;
+          run(grid, () => {
+            wrapper.remove();
+            removed.add(wrapper);
+            syncControls();
+            (next ? next.querySelector('[data-action="remove-card"]') : resetBtn).focus();
+          });
+        } else if (action === 'remove-extra') {
+          const li = btn.closest('li');
+          const list = li.parentElement;
+          const target = li.nextElementSibling?.querySelector('button') ??
+            li.previousElementSibling?.querySelector('button') ??
+            card.querySelector('[data-action="add-extra"]');
+          run(card, () => {
+            li.remove();
+            target.focus();
+          });
+        } else if (action === 'add-extra') {
+          const list = card.querySelector('.extras');
+          const have = Array.from(list.children, (li) => li.dataset.extra);
+          const name = pool.find((p) => !have.includes(p));
+          if (!name) return;
+          const title = card.querySelector('h3').textContent;
+          run(card, () => {
+            const li = document.createElement('li');
+            li.dataset.extra = name;
+            li.append(name);
+            const x = document.createElement('button');
+            x.type = 'button';
+            x.dataset.action = 'remove-extra';
+            x.setAttribute('aria-label', 'Remove ' + name + ' from ' + title);
+            x.innerHTML = '&times;';
+            li.append(x);
+            list.append(li);
+          });
+        }
+      });
+
+      resetBtn.addEventListener('click', () => {
+        run(grid, () => {
+          removed.clear();
+          original.forEach((w) => grid.append(w));
+          syncControls();
+        });
+      });
+
+      syncControls();
+    })();
+  </script>
 </body>
 
