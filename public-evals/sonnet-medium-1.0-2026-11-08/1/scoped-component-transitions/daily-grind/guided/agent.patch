+      animation-timing-function: ease-in;
+    }
+
+    @keyframes pop-in {
+      from { opacity: 0; scale: 0.8; }
+    }
+
+    @keyframes pop-out {
+      to { opacity: 0; scale: 0.8; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
