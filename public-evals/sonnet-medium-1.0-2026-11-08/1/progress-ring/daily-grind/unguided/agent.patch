+    /* Loyalty Rewards */
+    .rewards {
+      margin-top: 60px;
+    }
+
+    .rewards-card {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex-wrap: wrap;
+      gap: 40px;
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 20px;
+    }
+
+    .progress-ring {
+      position: relative;
+      width: 180px;
+      height: 180px;
+      flex-shrink: 0;
+    }
+
+    .progress-ring svg {
+      width: 100%;
+      height: 100%;
+      transform: rotate(-90deg);
+    }
+
+    .ring-track {
+      fill: none;
+      stroke: var(--secondary);
+      stroke-width: 10;
+    }
+
+    .ring-fill {
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 10;
+      stroke-linecap: round;
+      /* circumference = 2 * PI * 54 ≈ 339.29 */
+      stroke-dasharray: 339.29;
+      stroke-dashoffset: calc(339.29 * (1 - var(--progress)));
+      transition: stroke-dashoffset 1s ease;
+    }
+
+    .ring-center {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      color: var(--primary);
+      line-height: 1.2;
+    }
+
+    .ring-count {
+      font-size: 2.2rem;
+      font-weight: bold;
+    }
+
+    .ring-label {
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 1px;
+    }
+
+    .rewards-info {
+      max-width: 380px;
+      text-align: left;
+    }
+
+    .rewards-info h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .rewards-info strong {
+      color: var(--primary);
+    }
+
