+  <script>
+    // Fallback for browsers without attr() typed values (e.g. Safari): sync value to --value
+    if (!CSS.supports('width', 'attr(value type(<number>))')) {
+      document.querySelectorAll('progress.progress-ring').forEach((el) => {
+        const sync = () => el.style.setProperty('--value', el.getAttribute('value'));
+        sync();
+        new MutationObserver(sync).observe(el, { attributes: true, attributeFilter: ['value'] });
+      });
+    }
+  </script>
