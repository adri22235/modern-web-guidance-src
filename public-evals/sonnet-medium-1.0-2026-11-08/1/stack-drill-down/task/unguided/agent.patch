+  <script>
+    (function () {
+      var ITEMS = {
+        seasonal: {
+          title: 'Maple Oat Latte', price: '$5.75',
+          desc: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          notes: ['Oat milk', 'Vermont maple syrup', 'Double espresso', 'Available hot or iced'],
+          img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1350&q=80'
+        },
+        espresso: {
+          title: 'Dark Roast Espresso', price: '$3.50',
+          desc: 'Bold, smokey, and perfect for a morning boost. Roasted locally in small batches.',
+          notes: ['Single or double', 'Notes of cocoa and toasted oak', 'Locally roasted'],
+          img: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1350&q=80'
+        },
+        'cold-brew': {
+          title: 'Cold Brew', price: '$4.50',
+          desc: 'Steeped for 18 hours for maximum smoothness and served over ice.',
+          notes: ['18-hour steep', 'Low acidity', 'Add sweet cream for $0.75'],
+          img: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1350&q=80'
+        }
+      };
+
+      var home = document.getElementById('home-screen');
+      var detail = document.getElementById('detail-screen');
+      var DURATION = 300;
+      var currentId = null;
+
+      function routeFromHash() {
+        var m = /^#\/menu\/([\w-]+)$/.exec(location.hash);
+        return m && ITEMS.hasOwnProperty(m[1]) ? m[1] : null;
+      }
+
+      function fill(id) {
+        var it = ITEMS[id];
+        document.getElementById('detail-title').textContent = it.title;
+        document.getElementById('detail-price').textContent = it.price;
+        document.getElementById('detail-desc').textContent = it.desc;
+        var hero = document.getElementById('detail-hero');
+        hero.style.backgroundImage = 'url("' + it.img + '")';
+        hero.setAttribute('aria-label', it.title);
+        var ul = document.getElementById('detail-notes');
+        ul.textContent = '';
+        it.notes.forEach(function (n) {
+          var li = document.createElement('li');
+          li.textContent = n;
+          ul.appendChild(li);
+        });
+        document.title = it.title + ' | The Daily Grind';
+      }
+
+      // Sync the visible stack with the current URL.
+      function render() {
+        var id = routeFromHash();
+        if (id) {
+          if (id !== currentId) { fill(id); detail.scrollTop = 0; }
+          detail.classList.add('open');
+          home.classList.add('covered');
+          detail.removeAttribute('aria-hidden');
+          home.setAttribute('inert', '');
+          document.getElementById('back-btn').focus({ preventScroll: true });
+        } else {
+          detail.classList.remove('open');
+          home.classList.remove('covered');
+          detail.setAttribute('aria-hidden', 'true');
+          home.removeAttribute('inert');
+          document.title = 'The Daily Grind | Artisanal Coffee';
+        }
+        currentId = id;
+      }
+
+      function open(id) {
+        history.pushState({ item: id }, '', '#/menu/' + id);
+        render();
+      }
+
+      function back() {
+        // Only pop if we pushed the detail entry ourselves; otherwise (deep link) replace with home.
+        if (history.state && history.state.item) {
+          history.back();
+        } else {
+          history.replaceState(null, '', location.pathname + location.search);
+          render();
+        }
+      }
+
+      window.addEventListener('popstate', render);
+      window.addEventListener('hashchange', render);
+
+      document.getElementById('back-btn').addEventListener('click', back);
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && currentId) back();
+      });
+
+      // Seasonal Favorites cards drill down into the detail view.
+      Array.prototype.forEach.call(document.querySelectorAll('.card a[href^="/menu/"]'), function (a) {
+        var id = a.getAttribute('href').replace('/menu/', '');
+        if (!ITEMS[id]) return;
+        a.setAttribute('href', '#/menu/' + id);
+        var card = a.closest('.card');
+        card.classList.add('card-link');
+        card.addEventListener('click', function (e) {
+          if (e.target.closest('a') && e.target.closest('a') !== a) return;
+          e.preventDefault();
+          open(id);
+        });
+      });
+
+      // Swipe right to go back (interactive, follows the finger).
+      var startX = 0, startY = 0, dx = 0, tracking = false, locked = false, startT = 0;
+
+      detail.addEventListener('touchstart', function (e) {
+        if (!currentId || e.touches.length !== 1) return;
+        var t = e.touches[0];
+        startX = t.clientX; startY = t.clientY; dx = 0; startT = Date.now();
+        tracking = true; locked = false;
+      }, { passive: true });
+
+      detail.addEventListener('touchmove', function (e) {
+        if (!tracking) return;
+        var t = e.touches[0];
+        var mx = t.clientX - startX, my = t.clientY - startY;
+        if (!locked) {
+          if (Math.abs(mx) < 10 && Math.abs(my) < 10) return;
+          if (mx > 0 && Math.abs(mx) > Math.abs(my) * 1.5) {
+            locked = true;
+            detail.classList.add('dragging');
+            home.classList.add('dragging');
+          } else { tracking = false; return; }
+        }
+        dx = Math.max(0, mx);
+        var p = Math.min(1, dx / window.innerWidth);
+        detail.style.transform = 'translateX(' + dx + 'px)';
+        home.style.transform = 'translateX(' + (-25 * (1 - p)) + '%)';
+        home.style.filter = 'brightness(' + (0.7 + 0.3 * p) + ')';
+      }, { passive: true });
+
+      function endSwipe() {
+        if (!tracking) return;
+        tracking = false;
+        if (!locked) return;
+        detail.classList.remove('dragging');
+        home.classList.remove('dragging');
+        var fast = dx / Math.max(1, Date.now() - startT) > 0.5;
+        var commit = dx > window.innerWidth * 0.35 || (fast && dx > 40);
+        detail.style.transform = '';
+        home.style.transform = '';
+        home.style.filter = '';
+        if (commit) back();
+      }
+      detail.addEventListener('touchend', endSwipe);
+      detail.addEventListener('touchcancel', endSwipe);
+
+      // Initial state (deep link).
+      if (routeFromHash()) {
+        history.replaceState({ item: null, deep: true }, '', location.hash);
+      }
+      render();
+    })();
+  </script>
