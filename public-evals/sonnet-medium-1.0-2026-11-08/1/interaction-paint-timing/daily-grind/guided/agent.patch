+  <script>
+    // Client-side interaction performance monitoring.
+    // - `event` entries: click -> next paint (INP-style) for nav links, "Order Now" and card links.
+    // - `interaction-contentful-paint` / `soft-navigation` (Chrome/Edge 151+): click -> contentful paint
+    //   for async updates and client-side view switches. Skipped where unsupported.
+    (() => {
+      if (typeof PerformanceObserver === 'undefined') return;
+      const supported = PerformanceObserver.supportedEntryTypes || [];
+
+      const LABELS = [
+        ['nav a', 'nav'],
+        ['.hero .btn', 'order-now'],
+        ['.card', 'seasonal-card'],
+      ];
+      const labelFor = (el) => {
+        if (!(el instanceof Element)) return null;
+        for (const [selector, name] of LABELS) {
+          const match = el.closest(selector);
+          if (!match) continue;
+          const id = name === 'seasonal-card'
+            ? match.querySelector('h3')?.textContent
+            : match.getAttribute('href') || match.textContent;
+          return { name, id: (id || '').trim() };
+        }
+        return null;
+      };
+
+      const labels = new Map(); // interactionId -> label
+      const report = (metric) => {
+        // Replace with a real telemetry endpoint (e.g. navigator.sendBeacon) when available.
+        console.debug('[perf]', metric);
+        performance.mark('perf:' + metric.type + ':' + metric.name, { detail: metric });
+      };
+
+      if (supported.includes('event')) {
+        new PerformanceObserver((list) => {
+          for (const e of list.getEntries()) {
+            if (e.name !== 'click' || !e.interactionId) continue;
+            const label = labelFor(e.target);
+            if (!label) continue;
+            labels.set(e.interactionId, label);
+            // duration is rounded to 8ms and ends at the next paint after the input.
+            report({ type: 'next-paint', name: label.name, target: label.id,
+              interactionId: e.interactionId, duration: e.duration });
+          }
+        }).observe({ type: 'event', durationThreshold: 16, buffered: true });
+      }
+
+      if (supported.includes('interaction-contentful-paint')) {
+        new PerformanceObserver((list) => {
+          for (const e of list.getEntries()) {
+            const label = labels.get(e.interactionId);
+            if (!label) continue;
+            report({ type: 'contentful-paint', name: label.name, target: label.id,
+              interactionId: e.interactionId, duration: e.duration });
+          }
+        }).observe({ type: 'interaction-contentful-paint', buffered: true });
+      }
+
+      if (supported.includes('soft-navigation')) {
+        new PerformanceObserver((list) => {
+          for (const e of list.getEntries()) {
+            const label = labels.get(e.interactionId);
+            report({ type: 'view-switch', name: label ? label.name : 'unknown', target: e.name,
+              interactionId: e.interactionId, duration: e.duration });
+          }
+        }).observe({ type: 'soft-navigation', buffered: true });
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
