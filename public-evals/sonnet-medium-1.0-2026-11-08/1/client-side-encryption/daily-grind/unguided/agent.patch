index 0000000..d9f6169
--- /dev/null
+++ b/notes.js
@@ -0,0 +1,93 @@
+// Encrypted delivery notes.
+// Key establishment: X25519 ECDH (ephemeral) + ML-KEM-768 encapsulation when the browser supports it
+// (hybrid, so the secret stays safe unless BOTH are broken). Secrets are combined via HKDF-SHA256 and
+// the note is sealed with AES-256-GCM, binding the header as additional authenticated data.
+(() => {
+  const enc = new TextEncoder();
+  const subtle = crypto.subtle;
+  const config = JSON.parse(document.getElementById('notes-config').textContent);
+  const form = document.getElementById('notes-form');
+  const statusEl = document.getElementById('notes-status');
+  const out = document.getElementById('notes-output');
+  const submit = document.getElementById('notes-submit');
+
+  const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
+  const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
+
+  function setStatus(msg, isErr) {
+    statusEl.textContent = msg;
+    statusEl.classList.toggle('err', !!isErr);
+  }
+
+  async function x25519Secret() {
+    const pub = await subtle.importKey('spki', unb64(config.x25519), { name: 'X25519' }, false, []);
+    const eph = await subtle.generateKey({ name: 'X25519' }, true, ['deriveBits']);
+    const secret = await subtle.deriveBits({ name: 'X25519', public: pub }, eph.privateKey, 256);
+    const epk = await subtle.exportKey('spki', eph.publicKey);
+    return { secret: new Uint8Array(secret), epk: b64(epk) };
+  }
+
+  // Returns null when the browser has no native ML-KEM (WebCrypto encapsulateBits).
+  async function mlkemSecret() {
+    if (typeof subtle.encapsulateBits !== 'function') return null;
+    try {
+      const pub = await subtle.importKey('spki', unb64(config.mlkem768), 'ML-KEM-768', false, ['encapsulateBits']);
+      const { sharedKey, ciphertext } = await subtle.encapsulateBits('ML-KEM-768', pub);
+      return { secret: new Uint8Array(sharedKey), kem: b64(ciphertext) };
+    } catch {
+      return null;
+    }
+  }
+
+  async function sealNote(plaintext) {
+    const x = await x25519Secret();
+    const k = await mlkemSecret();
+    const header = JSON.stringify({
+      v: 1,
+      suite: k ? 'X25519+ML-KEM-768/HKDF-SHA256/AES-256-GCM' : 'X25519/HKDF-SHA256/AES-256-GCM',
+      epk: x.epk,
+      kem: k ? k.kem : null,
+    });
+    const ikm = new Uint8Array(x.secret.length + (k ? k.secret.length : 0));
+    ikm.set(x.secret);
+    if (k) ikm.set(k.secret, x.secret.length);
+
+    const salt = crypto.getRandomValues(new Uint8Array(32));
+    const iv = crypto.getRandomValues(new Uint8Array(12));
+    const headerHash = await subtle.digest('SHA-256', enc.encode(header));
+    const base = await subtle.importKey('raw', ikm, 'HKDF', false, ['deriveKey']);
+    const aesKey = await subtle.deriveKey(
+      { name: 'HKDF', hash: 'SHA-256', salt, info: enc.encode('daily-grind-notes-v1|' + b64(headerHash)) },
+      base, { name: 'AES-GCM', length: 256 }, false, ['encrypt']);
+    const ct = await subtle.encrypt({ name: 'AES-GCM', iv, additionalData: enc.encode(header) }, aesKey, enc.encode(plaintext));
+    ikm.fill(0);
+    x.secret.fill(0);
+    if (k) k.secret.fill(0);
+
+    return { ...JSON.parse(header), salt: b64(salt), iv: b64(iv), ct: b64(ct) };
+  }
+
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    submit.disabled = true;
+    setStatus('Encrypting…');
+    try {
+      const orderId = document.getElementById('notes-order').value.trim();
+      const textEl = document.getElementById('notes-text');
+      const envelope = await sealNote(textEl.value);
+      envelope.order = orderId;
+      textEl.value = '';
+      out.textContent = JSON.stringify(envelope, null, 2);
+      out.hidden = false;
+      const pq = envelope.kem ? 'hybrid post-quantum protection' : 'classical X25519 only (this browser lacks ML-KEM)';
+      setStatus('Note encrypted with ' + pq + '. Only the ciphertext below is stored/sent.');
+      try {
+        sessionStorage.setItem('dg-note-' + orderId, JSON.stringify(envelope));
+      } catch { /* storage unavailable; ignore */ }
+    } catch (err) {
+      setStatus('Could not encrypt note: ' + (err && err.message ? err.message : 'unsupported browser') + '. Nothing was saved.', true);
+    } finally {
+      submit.disabled = false;
+    }
+  });
+})();
diff --git a/tools/decrypt-note.mjs b/tools/decrypt-note.mjs
new file mode 100644
index 0000000..85d74f0
--- /dev/null
+++ b/tools/decrypt-note.mjs
@@ -0,0 +1,24 @@
+// Staff-side decryption of a delivery-note envelope.
+// Usage: node tools/decrypt-note.mjs envelope.json [keysDir]
+import { createHash, createPrivateKey, createPublicKey, diffieHellman, decapsulate, hkdfSync, createDecipheriv } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+
+const [file, dir = '.keys'] = process.argv.slice(2);
+const env = JSON.parse(readFileSync(file, 'utf8'));
+const b64 = (s) => Buffer.from(s, 'base64');
+const xPriv = createPrivateKey(readFileSync(`${dir}/x25519.private.pem`));
+const ephPub = createPublicKey({ key: b64(env.epk), format: 'der', type: 'spki' });
+
+const parts = [diffieHellman({ privateKey: xPriv, publicKey: ephPub })];
+if (env.kem) {
+  const kPriv = createPrivateKey(readFileSync(`${dir}/mlkem768.private.pem`));
+  parts.push(decapsulate(kPriv, b64(env.kem)));
+}
+const header = JSON.stringify({ v: env.v, suite: env.suite, epk: env.epk, kem: env.kem || null });
+const salt = b64(env.salt);
+const key = Buffer.from(hkdfSync('sha256', Buffer.concat(parts), salt, `daily-grind-notes-v1|${createHash('sha256').update(header).digest('base64')}`, 32));
+const ct = b64(env.ct);
+const d = createDecipheriv('aes-256-gcm', key, b64(env.iv));
+d.setAAD(Buffer.from(header));
+d.setAuthTag(ct.subarray(ct.length - 16));
+console.log(Buffer.concat([d.update(ct.subarray(0, ct.length - 16)), d.final()]).toString('utf8'));
diff --git a/tools/keygen.mjs b/tools/keygen.mjs
new file mode 100644
index 0000000..6668373
--- /dev/null
+++ b/tools/keygen.mjs
@@ -0,0 +1,15 @@
+// Generates the store's delivery-notes keypairs (X25519 + ML-KEM-768).
+// Usage: node tools/keygen.mjs [outDir]   (default: .keys, gitignored)
+// Prints the public keys to paste into the #notes-config block in index.html.
+import { generateKeyPairSync } from 'node:crypto';
+import { mkdirSync, writeFileSync } from 'node:fs';
+
+const out = process.argv[2] || '.keys';
+mkdirSync(out, { recursive: true, mode: 0o700 });
+const config = {};
+for (const [alg, field] of [['x25519', 'x25519'], ['ml-kem-768', 'mlkem768']]) {
+  const { publicKey, privateKey } = generateKeyPairSync(alg);
+  config[field] = publicKey.export({ type: 'spki', format: 'der' }).toString('base64');
+  writeFileSync(`${out}/${field}.private.pem`, privateKey.export({ type: 'pkcs8', format: 'pem' }), { mode: 0o600 });
+}
+console.log(JSON.stringify(config, null, 2));
