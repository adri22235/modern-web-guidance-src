+    /* Swipe-to-reveal drink cards */
+    .card.SwipeReveal {
+      padding: 0;
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: chain;
+    }
+
+    .card.SwipeReveal::-webkit-scrollbar {
+      display: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .card.SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      padding: 20px;
+      background: white;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .SwipeReveal-panel button {
+      border: 0;
+      padding: 0 20px;
+      min-width: 84px;
+      font: inherit;
+      font-size: 0.9rem;
+      color: white;
+      background: var(--primary);
+      cursor: pointer;
+    }
+
+    .SwipeReveal-panel button + button {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .SwipeReveal-panel button:last-child {
+      background: var(--text);
+      color: white;
+    }
+
+    .SwipeReveal-panel button:focus-visible {
+      outline: 2px solid var(--text);
+      outline-offset: -4px;
+    }
+
     footer {
