+  <script>
+    // Swipe left on a drink to reveal its actions; nothing runs until a button is tapped.
+    (function () {
+      var items = document.querySelectorAll('.swipe-item');
+      var THRESHOLD = 40;
+
+      function setOpen(item, open) {
+        var w = item.querySelector('.swipe-actions').offsetWidth;
+        item.classList.toggle('open', open);
+        item.style.setProperty('--swipe-x', open ? -w + 'px' : '0px');
+      }
+
+      items.forEach(function (item) {
+        var card = item.querySelector('.card');
+        var actions = item.querySelector('.swipe-actions');
+        var startX = 0, startY = 0, base = 0, dx = 0, tracking = false, moved = false;
+
+        card.addEventListener('pointerdown', function (e) {
+          items.forEach(function (o) { if (o !== item) setOpen(o, false); });
+          tracking = true; moved = false;
+          startX = e.clientX; startY = e.clientY;
+          base = item.classList.contains('open') ? -actions.offsetWidth : 0;
+          dx = 0;
+        });
+
+        card.addEventListener('pointermove', function (e) {
+          if (!tracking) return;
+          var mx = e.clientX - startX;
+          if (!moved && Math.abs(mx) < 8) return;
+          if (!moved && Math.abs(e.clientY - startY) > Math.abs(mx)) { tracking = false; return; }
+          if (!moved) { moved = true; item.classList.add('dragging'); card.setPointerCapture(e.pointerId); }
+          dx = mx;
+          var x = Math.max(-actions.offsetWidth, Math.min(0, base + dx));
+          item.style.setProperty('--swipe-x', x + 'px');
+        });
+
+        function end() {
+          if (!tracking) return;
+          tracking = false;
+          if (!moved) return;
+          item.classList.remove('dragging');
+          var wasOpen = base !== 0;
+          setOpen(item, wasOpen ? dx > -THRESHOLD : dx < -THRESHOLD);
+        }
+        card.addEventListener('pointerup', end);
+        card.addEventListener('pointercancel', end);
+
+        // Keyboard: arrow keys reveal/hide the actions
+        card.setAttribute('tabindex', '0');
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'ArrowLeft') setOpen(item, true);
+          if (e.key === 'ArrowRight' || e.key === 'Escape') setOpen(item, false);
+        });
+
+        item.querySelector('.action-favorite').addEventListener('click', function (e) {
+          var b = e.currentTarget;
+          b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') !== 'true');
+          b.textContent = b.getAttribute('aria-pressed') === 'true' ? 'Favorited' : 'Favorite';
+        });
+      });
+    })();
+  </script>
+
