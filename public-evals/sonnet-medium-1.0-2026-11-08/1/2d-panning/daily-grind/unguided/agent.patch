+  <script>
+    // Mouse drag-to-pan on both axes simultaneously; touch uses native 2D scrolling.
+    (function () {
+      var map = document.getElementById('cafe-map');
+      var startX, startY, startLeft, startTop, activeId = null;
+
+      map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+      map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+
+      map.addEventListener('pointerdown', function (e) {
+        if (e.pointerType !== 'mouse' || e.button !== 0) return;
+        activeId = e.pointerId;
+        startX = e.clientX; startY = e.clientY;
+        startLeft = map.scrollLeft; startTop = map.scrollTop;
+        map.classList.add('dragging');
+        map.setPointerCapture(activeId);
+      });
+
+      map.addEventListener('pointermove', function (e) {
+        if (e.pointerId !== activeId) return;
+        // Offsets are relative to the start point, so direction can change freely mid-drag.
+        map.scrollLeft = startLeft - (e.clientX - startX);
+        map.scrollTop = startTop - (e.clientY - startY);
+      });
+
+      function end(e) {
+        if (e.pointerId !== activeId) return;
+        activeId = null;
+        map.classList.remove('dragging');
+      }
+      map.addEventListener('pointerup', end);
+      map.addEventListener('pointercancel', end);
+    })();
+  </script>
