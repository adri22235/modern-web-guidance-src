+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = [...scroller.querySelectorAll('.bean')];
+
+    // Pick the bean closest to the scroller's center. Only runs when scrolling stops.
+    function visibleBean() {
+      const box = scroller.getBoundingClientRect();
+      const center = box.left + box.width / 2;
+      let best = beans[0];
+      let bestDist = Infinity;
+      for (const bean of beans) {
+        const r = bean.getBoundingClientRect();
+        const dist = Math.abs(r.left + r.width / 2 - center);
+        if (dist < bestDist) {
+          bestDist = dist;
+          best = bean;
+        }
+      }
+      return best;
+    }
+
+    function onScrollEnd() {
+      status.dataset.scrolling = 'false';
+      status.textContent = `Showing: ${visibleBean().dataset.name}`;
+    }
+
+    // Cheap work only during movement: set a flag/text once, no layout reads.
+    let scrolling = false;
+    scroller.addEventListener('scroll', () => {
+      if (scrolling) return;
+      scrolling = true;
+      status.dataset.scrolling = 'true';
+      status.textContent = 'Scrolling…';
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', () => {
+      scrolling = false;
+      onScrollEnd();
+    });
+
+    // Fallback: synthesize scrollend with a debounce where unsupported
+    if (!('onscrollend' in window)) {
+      let timer;
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(() => scroller.dispatchEvent(new CustomEvent('scrollend')), 100);
+      }, { passive: true });
+    }
+
+    onScrollEnd();
+  </script>
 </body>
 
