+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var beans = scroller.querySelectorAll('.bean');
+      var scrolling = false;
+      var timer;
+
+      // Layout reads happen only once scrolling stops, so movement stays cheap.
+      function visibleBean() {
+        var box = scroller.getBoundingClientRect();
+        var center = box.left + box.width / 2;
+        var best = null, bestDist = Infinity;
+        for (var i = 0; i < beans.length; i++) {
+          var r = beans[i].getBoundingClientRect();
+          var d = Math.abs(r.left + r.width / 2 - center);
+          if (d < bestDist) { bestDist = d; best = beans[i]; }
+        }
+        return best;
+      }
+
+      function stop() {
+        scrolling = false;
+        status.classList.remove('scrolling');
+        var bean = visibleBean();
+        status.textContent = bean ? 'Viewing: ' + bean.dataset.name : '';
+      }
+
+      function onScroll() {
+        if (!scrolling) {
+          scrolling = true;
+          status.classList.add('scrolling');
+          status.textContent = 'Scrolling…';
+        }
+        clearTimeout(timer);
+        timer = setTimeout(stop, 150);
+      }
+
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      stop();
+    })();
+  </script>
