+  <script>
+    (function () {
+      var form = document.getElementById('signup-form');
+      var nameEl = document.getElementById('signup-name');
+      var emailEl = document.getElementById('signup-email');
+      var emailStatus = document.getElementById('email-status');
+      var formStatus = document.getElementById('form-status');
+      var submit = document.getElementById('signup-submit');
+      var checkedEmail = null; // last address the server accepted
+
+      function show(el, cls, msg) {
+        el.className = 'field-status ' + cls;
+        el.textContent = msg;
+      }
+
+      function post(path, body) {
+        return fetch(path, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(body)
+        }).then(function (r) { return r.json(); });
+      }
+
+      function checkEmail() {
+        var email = emailEl.value.trim();
+        if (!email) return Promise.resolve(false);
+        show(emailStatus, '', 'Checking...');
+        return post('/api/verify-email', { email: email }).then(function (res) {
+          if (emailEl.value.trim() !== email) return false; // edited meanwhile
+          emailEl.setAttribute('aria-invalid', res.ok ? 'false' : 'true');
+          checkedEmail = res.ok ? email : null;
+          show(emailStatus, res.ok ? 'ok' : 'error', res.ok ? 'Email address looks good.' : res.reason);
+          return res.ok;
+        }).catch(function () {
+          show(emailStatus, 'error', 'Could not check your email. Please try again.');
+          return false;
+        });
+      }
+
+      emailEl.addEventListener('blur', checkEmail);
+      emailEl.addEventListener('input', function () {
+        checkedEmail = null;
+        emailEl.removeAttribute('aria-invalid');
+        show(emailStatus, '', '');
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (!nameEl.value.trim()) return show(formStatus, 'error', 'Please enter your name.');
+        submit.disabled = true;
+        show(formStatus, '', '');
+        var ready = checkedEmail === emailEl.value.trim() ? Promise.resolve(true) : checkEmail();
+        ready.then(function (ok) {
+          if (!ok) throw null;
+          return post('/api/register', { name: nameEl.value, email: emailEl.value });
+        }).then(function (res) {
+          if (!res.ok) { show(formStatus, 'error', res.reason); return; }
+          form.reset();
+          checkedEmail = null;
+          show(emailStatus, '', '');
+          show(formStatus, 'ok', 'Welcome to Daily Grind Rewards!');
+        }).catch(function (err) {
+          if (err) show(formStatus, 'error', 'Something went wrong. Please try again.');
+        }).then(function () { submit.disabled = false; });
+      });
+    })();
+  </script>
