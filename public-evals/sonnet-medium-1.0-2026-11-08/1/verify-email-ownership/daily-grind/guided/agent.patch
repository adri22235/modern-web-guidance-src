+  <script>
+    const form = document.getElementById('signup-form');
+    const email = document.getElementById('email');
+    const emailStatus = document.getElementById('email-status');
+    const result = document.getElementById('signup-result');
+    const submit = form.querySelector('button[type="submit"]');
+
+    const MESSAGES = {
+      format: 'Enter a valid email address.',
+      disposable: 'Please use a permanent email address, not a disposable one.',
+      'no-mail-server': "That email's domain can't receive mail. Check for typos.",
+      'rate-limited': 'Too many attempts. Please wait a minute and try again.',
+      default: "We couldn't check that email right now. Please try again."
+    };
+
+    function setStatus(el, text, kind) {
+      el.textContent = text;
+      el.className = 'status' + (kind ? ' ' + kind : '');
+    }
+
+    // Ask the server whether the address is well-formed and its domain accepts mail.
+    // Resolves to true only on a positive answer.
+    async function checkEmail() {
+      email.setCustomValidity('');
+      if (!email.value || !email.validity.valid) return false;
+      let reason = 'default';
+      try {
+        const res = await fetch('/api/verify-email', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ email: email.value })
+        });
+        const data = await res.json();
+        if (data.ok) {
+          setStatus(emailStatus, 'Email looks good.', 'ok');
+          email.setAttribute('aria-invalid', 'false');
+          return true;
+        }
+        reason = data.reason;
+      } catch { /* network or parse failure: fall through to the generic message */ }
+      const message = MESSAGES[reason] || MESSAGES.default;
+      email.setCustomValidity(message);
+      email.setAttribute('aria-invalid', 'true');
+      setStatus(emailStatus, message, 'error');
+      return false;
+    }
+
+    email.addEventListener('input', () => {
+      email.setCustomValidity('');
+      email.removeAttribute('aria-invalid');
+      setStatus(emailStatus, '');
+    });
+    email.addEventListener('change', checkEmail);
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      setStatus(result, '');
+      if (!form.reportValidity()) return;
+      submit.disabled = true;
+      const ok = await checkEmail();
+      submit.disabled = false;
+      if (!ok) { email.focus(); return; }
+      setStatus(result, 'Thanks! Your rewards account request has been received.', 'ok');
+    });
+  </script>
