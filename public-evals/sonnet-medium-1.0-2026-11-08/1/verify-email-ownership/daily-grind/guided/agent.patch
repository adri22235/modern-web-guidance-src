+// Static file server for the homepage plus POST /api/verify-email.
+// No dependencies: node server.js
+const http = require('node:http');
+const fs = require('node:fs/promises');
+const path = require('node:path');
+const dns = require('node:dns/promises');
+
+const PORT = process.env.PORT || 11222;
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const DISPOSABLE = new Set(['mailinator.com', 'guerrillamail.com', '10minutemail.com', 'tempmail.com', 'yopmail.com', 'trashmail.com']);
+
+// Naive per-IP limit so the endpoint can't be used as a free DNS-lookup proxy.
+const hits = new Map();
+function rateLimited(ip) {
+  const now = Date.now();
+  const recent = (hits.get(ip) || []).filter((t) => now - t < 60_000);
+  recent.push(now);
+  hits.set(ip, recent);
+  return recent.length > 20;
+}
+
+async function hasMailServer(domain) {
+  try {
+    const mx = await dns.resolveMx(domain);
+    if (mx.length) return true;
+  } catch (err) {
+    if (err.code !== 'ENODATA' && err.code !== 'ENOTFOUND') throw err;
+  }
+  // RFC 5321: a domain with no MX falls back to its A/AAAA record.
+  try {
+    return (await dns.resolve4(domain)).length > 0;
+  } catch (err) {
+    if (err.code === 'ENODATA' || err.code === 'ENOTFOUND') return false;
+    throw err;
+  }
+}
+
+// This checks that the address is well-formed and its domain can receive mail.
+// It cannot prove the customer controls the mailbox; that needs a message sent to it.
+async function checkEmail(raw) {
+  const email = String(raw || '').trim().toLowerCase();
+  if (email.length > 254 || !EMAIL_RE.test(email)) return { ok: false, reason: 'format' };
+  const domain = email.slice(email.lastIndexOf('@') + 1);
+  if (DISPOSABLE.has(domain)) return { ok: false, reason: 'disposable' };
+  try {
+    return (await hasMailServer(domain)) ? { ok: true, email } : { ok: false, reason: 'no-mail-server' };
+  } catch {
+    return { ok: false, reason: 'lookup-failed' };
+  }
+}
+
+function readJson(req) {
+  return new Promise((resolve, reject) => {
+    let body = '';
+    req.on('data', (chunk) => {
+      body += chunk;
+      if (body.length > 2048) { reject(new Error('too large')); req.destroy(); }
+    });
+    req.on('end', () => { try { resolve(JSON.parse(body)); } catch (e) { reject(e); } });
+    req.on('error', reject);
+  });
+}
+
+function sendJson(res, status, data) {
+  res.writeHead(status, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(data));
+}
+
+http.createServer(async (req, res) => {
+  const { pathname } = new URL(req.url, 'http://localhost');
+
+  if (pathname === '/api/verify-email') {
+    if (req.method !== 'POST') return sendJson(res, 405, { error: 'method-not-allowed' });
+    if (rateLimited(req.socket.remoteAddress)) return sendJson(res, 429, { ok: false, reason: 'rate-limited' });
+    try {
+      const { email } = await readJson(req);
+      const result = await checkEmail(email);
+      return sendJson(res, result.reason === 'lookup-failed' ? 503 : 200, result);
+    } catch {
+      return sendJson(res, 400, { ok: false, reason: 'bad-request' });
+    }
+  }
+
+  if (pathname === '/' || pathname === '/index.html') {
+    try {
+      const html = await fs.readFile(path.join(__dirname, 'index.html'));
+      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+      return res.end(html);
+    } catch {
+      return sendJson(res, 500, { error: 'server-error' });
+    }
+  }
+
+  res.writeHead(404, { 'Content-Type': 'text/plain' });
+  res.end('Not found');
+}).listen(PORT, () => console.log(`Daily Grind on http://localhost:${PORT}`));
