+  <script>
+    // Batch as delivered by backend services: out of order, nanosecond UTC timestamps.
+    const collectedEvents = [
+      { service: 'kitchen-display', event: 'drink.ready', ts: '2026-11-09T08:15:02.418230017Z' },
+      { service: 'order-api', event: 'order.placed', ts: '2026-11-09T08:15:00.102394551Z' },
+      { service: 'barista-queue', event: 'drink.started', ts: '2026-11-09T08:15:00.912004003Z' },
+      { service: 'payments', event: 'payment.captured', ts: '2026-11-09T08:15:00.102394999Z' },
+      { service: 'notifications', event: 'customer.notified', ts: '2026-11-09T08:15:02.418230890Z' },
+      { service: 'inventory', event: 'beans.reserved', ts: '2026-11-09T08:15:00.102395120Z' },
+    ];
+
+    const loadButton = document.getElementById('load-events');
+    const statusEl = document.getElementById('timeline-status');
+    const timelineEl = document.getElementById('timeline');
+
+    // Temporal is not in Safari yet; load a polyfill only when needed.
+    async function ensureTemporal() {
+      if (typeof Temporal !== 'undefined') return;
+      const mod = await import('https://esm.sh/temporal-polyfill');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    function sequenceEvents(items) {
+      // Instant keeps nanoseconds; new Date() would truncate to milliseconds.
+      return items
+        .map(evt => ({ ...evt, instant: Temporal.Instant.from(evt.ts) }))
+        .sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+    }
+
+    function renderTimeline(sorted) {
+      timelineEl.replaceChildren(...sorted.map((evt, i) => {
+        const li = document.createElement('li');
+        const title = document.createElement('strong');
+        title.textContent = `${evt.event} (${evt.service})`;
+        const meta = document.createElement('div');
+        meta.className = 'meta';
+        meta.textContent = evt.instant.toString();
+        li.append(title, meta);
+        if (i > 0) {
+          const prev = sorted[i - 1].instant;
+          const gap = document.createElement('div');
+          gap.className = 'gap';
+          gap.textContent = evt.instant.equals(prev)
+            ? '+ 0ns (simultaneous)'
+            : `+ ${evt.instant.since(prev).toLocaleString('en-US', { style: 'narrow' })}`;
+          li.append(gap);
+        }
+        return li;
+      }));
+    }
+
+    loadButton.addEventListener('click', async () => {
+      loadButton.disabled = true;
+      statusEl.textContent = 'Loading events…';
+      try {
+        await ensureTemporal();
+        const sorted = sequenceEvents(collectedEvents);
+        renderTimeline(sorted);
+        const total = sorted.at(-1).instant.since(sorted[0].instant);
+        statusEl.textContent = `${sorted.length} events sorted. Total elapsed: ${total.toLocaleString('en-US', { style: 'narrow' })}`;
+      } catch (err) {
+        statusEl.textContent = 'Could not load order events.';
+        console.error(err);
+      } finally {
+        loadButton.disabled = false;
+      }
+    });
+  </script>
 </body>
 
