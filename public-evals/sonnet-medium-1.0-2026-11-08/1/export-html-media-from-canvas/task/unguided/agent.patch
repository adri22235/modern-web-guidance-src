+  <script>
+    (function () {
+      var card = document.getElementById('export_element');
+      var text = document.getElementById('card_text');
+      var input = document.getElementById('card_message');
+      var color = document.getElementById('card_color');
+      var canvas = document.getElementById('export_canvas');
+
+      function update() {
+        text.textContent = input.value || 'Your message here';
+        card.style.background = color.value;
+      }
+      input.addEventListener('input', update);
+      color.addEventListener('input', update);
+
+      function roundRect(ctx, x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.moveTo(x + r, y);
+        ctx.arcTo(x + w, y, x + w, y + h, r);
+        ctx.arcTo(x + w, y + h, x, y + h, r);
+        ctx.arcTo(x, y + h, x, y, r);
+        ctx.arcTo(x, y, x + w, y, r);
+        ctx.closePath();
+      }
+
+      function wrapLines(ctx, str, maxWidth) {
+        var lines = [], line = '';
+        str.split(/\s+/).forEach(function (word) {
+          var test = line ? line + ' ' + word : word;
+          if (line && ctx.measureText(test).width > maxWidth) {
+            lines.push(line);
+            line = word;
+          } else {
+            line = test;
+          }
+        });
+        if (line) lines.push(line);
+        return lines;
+      }
+
+      // Draw the card's HTML elements onto the canvas using their computed styles/positions.
+      function render() {
+        var scale = 2;
+        var box = card.getBoundingClientRect();
+        var cs = getComputedStyle(card);
+        canvas.width = box.width * scale;
+        canvas.height = box.height * scale;
+        var ctx = canvas.getContext('2d');
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+        ctx.clearRect(0, 0, box.width, box.height);
+
+        ctx.fillStyle = cs.backgroundColor;
+        roundRect(ctx, 0, 0, box.width, box.height, parseFloat(cs.borderTopLeftRadius) || 0);
+        ctx.fill();
+
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        Array.prototype.forEach.call(card.children, function (el) {
+          var s = getComputedStyle(el);
+          var r = el.getBoundingClientRect();
+          var size = parseFloat(s.fontSize);
+          var lh = parseFloat(s.lineHeight) || size * 1.2;
+          ctx.font = s.fontWeight + ' ' + s.fontSize + ' ' + s.fontFamily;
+          ctx.fillStyle = s.color;
+          ctx.globalAlpha = parseFloat(s.opacity);
+          var str = el.textContent;
+          if (s.textTransform === 'uppercase') str = str.toUpperCase();
+          if ('letterSpacing' in ctx && s.letterSpacing !== 'normal') ctx.letterSpacing = s.letterSpacing;
+          else if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
+          var lines = wrapLines(ctx, str, r.width);
+          var cx = r.left - box.left + r.width / 2;
+          var top = r.top - box.top + (r.height - lines.length * lh) / 2;
+          lines.forEach(function (l, i) {
+            ctx.fillText(l, cx, top + lh * (i + 0.5));
+          });
+          ctx.globalAlpha = 1;
+        });
+        if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
+      }
+
+      document.getElementById('export_button').addEventListener('click', function () {
+        update();
+        render();
+        canvas.style.display = 'block';
+        canvas.toBlob(function (blob) {
+          var url = URL.createObjectURL(blob);
+          var a = document.createElement('a');
+          a.href = url;
+          a.download = 'coffee-gift-card.png';
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+          setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+        }, 'image/png');
+      });
+    })();
+  </script>
+
