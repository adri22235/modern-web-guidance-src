+  <script>
+    (() => {
+      const canvas = document.getElementById('card_canvas');
+      const card = document.getElementById('export_element');
+      const text = document.getElementById('card_text');
+      const message = document.getElementById('card_message');
+      const color = document.getElementById('card_color');
+      const form = document.getElementById('designer_form');
+      const button = document.getElementById('export_button');
+      const status = document.getElementById('designer_status');
+
+      function applyDesign() {
+        text.textContent = message.value.trim() || 'Enjoy a coffee!';
+        card.style.backgroundColor = color.value;
+        // Pick a readable text color based on background luminance
+        const [r, g, b] = [1, 3, 5].map((i) => parseInt(color.value.slice(i, i + 2), 16));
+        card.style.color = (0.299 * r + 0.587 * g + 0.114 * b) > 150 ? '#3e2723' : '#fafafa';
+        if (supported) canvas.requestPaint();
+      }
+
+      const supported = 'content' in HTMLCanvasElement.prototype;
+      if (!supported) {
+        button.disabled = true;
+        canvas.hidden = true;
+        status.textContent = 'Exporting the gift card requires a browser that supports HTML-in-Canvas (Chrome 157+).';
+        return;
+      }
+
+      const ctx = canvas.getContext('2d');
+      canvas.onpaint = () => {
+        ctx.reset();
+        // Scale the card to fill the canvas grid
+        const scale = canvas.width / card.offsetWidth;
+        ctx.scale(scale, scale);
+        ctx.drawElementImage(card, 0, 0);
+      };
+
+      new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        canvas.requestPaint();
+      }).observe(canvas, 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype ? { box: 'device-pixel-content-box' } : {});
+
+      message.addEventListener('input', applyDesign);
+      color.addEventListener('input', applyDesign);
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        canvas.toBlob((blob) => {
+          if (!blob) return;
+          const link = document.createElement('a');
+          link.download = 'coffee-gift-card.png';
+          link.href = URL.createObjectURL(blob);
+          link.click();
+          URL.revokeObjectURL(link.href);
+          status.textContent = 'Gift card downloaded.';
+        }, 'image/png');
+      });
+
+      applyDesign();
+    })();
+  </script>
+
