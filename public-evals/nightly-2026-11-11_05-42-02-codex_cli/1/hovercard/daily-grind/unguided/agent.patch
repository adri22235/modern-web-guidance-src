+  <script>
+    const previews = document.querySelectorAll('.drink-preview');
+
+    previews.forEach((preview) => {
+      const trigger = preview.querySelector('.btn');
+      const panel = preview.querySelector('.hovercard');
+      let closeTimer;
+      let dismissed = false;
+
+      const close = () => {
+        clearTimeout(closeTimer);
+        panel.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+      };
+
+      const open = () => {
+        clearTimeout(closeTimer);
+        if (dismissed) return;
+        panel.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+      };
+
+      const dismiss = () => {
+        dismissed = true;
+        if (panel.contains(document.activeElement)) trigger.focus();
+        close();
+      };
+
+      preview.addEventListener('pointerenter', (event) => {
+        if (event.pointerType === 'touch') return;
+        dismissed = false;
+        open();
+      });
+      preview.addEventListener('pointerleave', () => {
+        closeTimer = setTimeout(() => {
+          if (!preview.contains(document.activeElement)) close();
+        }, 180);
+      });
+      preview.addEventListener('focusin', open);
+      preview.addEventListener('focusout', (event) => {
+        if (!preview.contains(event.relatedTarget)) {
+          dismissed = false;
+          if (!preview.matches(':hover')) close();
+        }
+      });
+      preview.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && !panel.hidden) {
+          event.preventDefault();
+          dismiss();
+        }
+      });
+      panel.querySelector('.hovercard-close').addEventListener('click', dismiss);
+      // Escape also dismisses a preview opened with the pointer alone.
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && !panel.hidden) dismiss();
+      });
+    });
+  </script>
