+  <script type="module">
+    // Wire descriptions before loading fallbacks, including for screen-reader browse mode.
+    function wireDrinkPreviews() {
+      document.querySelectorAll('[interestfor]').forEach(link => {
+        const preview = document.getElementById(link.getAttribute('interestfor'));
+        if (!preview || preview.getAttribute('popover') !== 'hint') return;
+        if (!preview.hasAttribute('role')) preview.setAttribute('role', 'tooltip');
+        if (!link.hasAttribute('aria-describedby')) link.setAttribute('aria-describedby', preview.id);
+      });
+    }
+    wireDrinkPreviews();
+
+    const pairs = [...document.querySelectorAll('[interestfor]')].map(link => ({
+      link, preview: document.getElementById(link.getAttribute('interestfor'))
+    }));
+    const isOpen = preview => preview.matches(':is(:popover-open, .\\:popover-open)');
+
+    // Keep previews next to their links when CSS anchor positioning is unavailable.
+    function positionPreview({ link, preview }) {
+      if (CSS.supports('position-area: block-end') || !isOpen(preview)) return;
+      const anchor = link.getBoundingClientRect();
+      const bounds = preview.getBoundingClientRect();
+      const left = Math.max(12, Math.min(anchor.left, innerWidth - bounds.width - 12));
+      const below = anchor.bottom + 8;
+      const top = below + bounds.height <= innerHeight - 12 ? below : anchor.top - bounds.height - 8;
+      Object.assign(preview.style, {
+        inset: 'auto', margin: '0', left: `${left}px`,
+        top: `${Math.max(12, Math.min(top, innerHeight - bounds.height - 12))}px`
+      });
+    }
+
+    pairs.forEach(pair => {
+      const { link, preview } = pair;
+      preview.addEventListener('beforetoggle', event => {
+        if (event.newState === 'open') {
+          pairs.forEach(other => {
+            if (other !== pair && isOpen(other.preview)) other.preview.hidePopover();
+          });
+          requestAnimationFrame(() => positionPreview(pair));
+        }
+      });
+      preview.querySelector('.preview-close').addEventListener('click', () => {
+        if (preview.contains(document.activeElement)) link.focus();
+        preview.hidePopover();
+      });
+    });
+    const reposition = () => pairs.forEach(positionPreview);
+    window.addEventListener('resize', reposition);
+    document.addEventListener('scroll', reposition, { capture: true, passive: true });
+
+    // Preserve native link navigation; load compatibility code only where needed.
+    try {
+      if (!('popover' in HTMLElement.prototype)) {
+        await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+      }
+      if (!('interestForElement' in HTMLButtonElement.prototype)) {
+        await import('https://unpkg.com/interestfor@latest');
+      }
+    } catch (error) {
+      console.warn('Drink previews unavailable; menu links remain available.', error);
+    }
+  </script>
