+  <script>
+    const favorites = document.querySelector('#seasonal-favorites');
+    const status = document.querySelector('#reorder-status');
+    let drag = null;
+
+    function cardsInRow(card) {
+      const top = card.getBoundingClientRect().top;
+      return [...favorites.children].filter(item =>
+        Math.abs(item.getBoundingClientRect().top - top) < 2
+      );
+    }
+
+    function moveCard(card, target) {
+      if (card === target) return;
+      const cards = [...favorites.children];
+      favorites.insertBefore(card, cards.indexOf(card) < cards.indexOf(target) ? target.nextSibling : target);
+      card.focus({ preventScroll: true });
+      status.textContent = `${card.querySelector('h3').textContent} moved to position ${[...favorites.children].indexOf(card) + 1} of ${cards.length}.`;
+    }
+
+    favorites.addEventListener('keydown', event => {
+      const card = event.target.closest('.card');
+      if (!card || event.target !== card || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
+      event.preventDefault();
+      const row = cardsInRow(card);
+      const target = row[row.indexOf(card) + (event.key === 'ArrowLeft' ? -1 : 1)];
+      if (target) moveCard(card, target);
+    });
+
+    favorites.addEventListener('pointerdown', event => {
+      const card = event.target.closest('.card');
+      if (drag || !card || !event.isPrimary || event.button !== 0 || event.target.closest('a, button')) return;
+      const row = cardsInRow(card).map(item => ({ card: item, rect: item.getBoundingClientRect() }));
+      const rect = card.getBoundingClientRect();
+      drag = { card, row, rect, startX: event.clientX, pointerId: event.pointerId, offset: 0, active: false };
+      card.setPointerCapture(event.pointerId);
+    });
+
+    favorites.addEventListener('pointermove', event => {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      const delta = event.clientX - drag.startX;
+      if (!drag.active && Math.abs(delta) < 6) return;
+      drag.active = true;
+      drag.card.classList.add('is-dragging');
+      drag.offset = Math.max(drag.row[0].rect.left - drag.rect.left,
+        Math.min(delta, drag.row[drag.row.length - 1].rect.right - drag.rect.right));
+      drag.card.style.transform = `translateX(${drag.offset}px)`;
+    });
+
+    function finishDrag(event) {
+      if (!drag || event.pointerId !== drag.pointerId) return;
+      const current = drag;
+      drag = null;
+      current.card.classList.remove('is-dragging');
+      current.card.style.removeProperty('transform');
+      if (current.card.hasPointerCapture(current.pointerId)) current.card.releasePointerCapture(current.pointerId);
+      if (event.type !== 'pointerup' || !current.active) return;
+      const center = current.rect.left + current.rect.width / 2 + current.offset;
+      const target = current.row.reduce((closest, item) =>
+        Math.abs(item.rect.left + item.rect.width / 2 - center) < Math.abs(closest.rect.left + closest.rect.width / 2 - center)
+          ? item : closest
+      );
+      moveCard(current.card, target.card);
+    }
+
+    favorites.addEventListener('pointerup', finishDrag);
+    favorites.addEventListener('pointercancel', finishDrag);
+    favorites.addEventListener('lostpointercapture', finishDrag);
+    window.addEventListener('resize', () => {
+      if (drag) finishDrag({ type: 'pointercancel', pointerId: drag.pointerId });
+    });
+  </script>
