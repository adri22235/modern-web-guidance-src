+  <script>
+    const row = document.querySelector('#seasonal-favorites');
+    const status = document.querySelector('#reorder-status');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let drag = null;
+    let announcement;
+
+    function announce(message) {
+      clearTimeout(announcement);
+      status.textContent = '';
+      announcement = setTimeout(() => { status.textContent = message; }, 500);
+    }
+
+    function nameOf(card) {
+      return card.querySelector('h3').textContent;
+    }
+
+    function moveCard(card, reference) {
+      if (card.nextElementSibling === reference) return false;
+      const positions = new Map(Array.from(row.children, item => [item, item.getBoundingClientRect()]));
+      if (typeof row.moveBefore === 'function') row.moveBefore(card, reference);
+      else if (reference) reference.before(card);
+      else row.append(card);
+      card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      animateCards(positions);
+      announce(`${nameOf(card)}, position ${Array.from(row.children).indexOf(card) + 1} of ${row.children.length}.`);
+      return true;
+    }
+
+    function animateCards(positions) {
+      if (reducedMotion.matches) return;
+      for (const [item, before] of positions) {
+        const after = item.getBoundingClientRect();
+        item.animate([
+          { translate: `${before.left - after.left}px ${before.top - after.top}px` },
+          { translate: '0 0' }
+        ], { duration: 180, easing: 'ease-out' });
+      }
+    }
+
+    function updateDrag() {
+      if (!drag) return;
+      const { card, startX, startScroll, x } = drag;
+      card.style.translate = `${x - startX + row.scrollLeft - startScroll}px 0`;
+      const bounds = row.getBoundingClientRect();
+      const position = Math.max(bounds.left, Math.min(x, bounds.right)) - bounds.left - row.clientLeft + row.scrollLeft;
+      const others = Array.from(row.children).filter(item => item !== card);
+      drag.reference = others.find(item => position < item.offsetLeft + item.offsetWidth / 2) || null;
+      row.removeAttribute('data-drop');
+      if (drag.reference === card.nextElementSibling) return;
+      const index = drag.reference ? others.indexOf(drag.reference) : others.length;
+      const previous = others[index - 1]?.getBoundingClientRect();
+      const next = others[index]?.getBoundingClientRect();
+      const markerX = previous && next ? (previous.right + next.left) / 2 : next ? next.left - 10 : previous.right + 10;
+      row.style.setProperty('--drop-x', `${Math.max(bounds.left + 2, Math.min(markerX, bounds.right - 6))}px`);
+      row.style.setProperty('--drop-y', `${bounds.top + 16}px`);
+      row.style.setProperty('--drop-height', `${card.offsetHeight}px`);
+      row.setAttribute('data-drop', '');
+    }
+
+    function scrollDrag(time) {
+      if (!drag) return;
+      const bounds = row.getBoundingClientRect();
+      const zone = Math.min(drag.card.offsetWidth, row.clientWidth / 3);
+      const velocity = drag.x < bounds.left + zone
+        ? -Math.min(1, (bounds.left + zone - drag.x) / zone)
+        : drag.x > bounds.right - zone ? Math.min(1, (drag.x - bounds.right + zone) / zone) : 0;
+      row.scrollLeft += velocity * Math.min(time - drag.lastTime, 32) * 0.6;
+      drag.lastTime = time;
+      updateDrag();
+      drag.frame = requestAnimationFrame(scrollDrag);
+    }
+
+    function finishDrag(cancelled = false) {
+      if (!drag) return;
+      const active = drag;
+      const before = active.card.getBoundingClientRect();
+      drag = null;
+      cancelAnimationFrame(active.frame);
+      active.card.style.removeProperty('translate');
+      active.card.classList.remove('is-dragging');
+      document.documentElement.classList.remove('is-reordering');
+      row.removeAttribute('data-drop');
+      for (const property of ['--drop-x', '--drop-y', '--drop-height']) row.style.removeProperty(property);
+      if (active.handle.hasPointerCapture(active.pointerId)) active.handle.releasePointerCapture(active.pointerId);
+      const positions = new Map(Array.from(row.children, item => [item, item === active.card ? before : item.getBoundingClientRect()]));
+      // Move only on release; cancellation leaves the original order intact.
+      if (!cancelled && active.reference !== active.card.nextElementSibling) {
+        for (const item of row.children) item.getAnimations().forEach(animation => animation.finish());
+        if (typeof row.moveBefore === 'function') row.moveBefore(active.card, active.reference);
+        else if (active.reference) active.reference.before(active.card);
+        else row.append(active.card);
+        announce(`${nameOf(active.card)}, position ${Array.from(row.children).indexOf(active.card) + 1} of ${row.children.length}.`);
+      }
+      active.card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      active.handle.focus({ preventScroll: true });
+      animateCards(positions);
+      if (cancelled) announce(`Reordering ${nameOf(active.card)} cancelled.`);
+    }
+
+    for (const card of row.children) {
+      const controls = document.createElement('div');
+      controls.className = 'reorder-controls';
+      for (const [action, label, text] of [
+        ['left', 'Move left', '←'], ['drag', 'Drag to reorder', '⠿'], ['right', 'Move right', '→']
+      ]) {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.textContent = text;
+        button.setAttribute('aria-label', `${label}: ${nameOf(card)}`);
+        if (action === 'drag') {
+          button.className = 'drag-handle';
+          button.setAttribute('aria-describedby', 'reorder-help');
+          button.addEventListener('pointerdown', event => {
+            if (drag || !event.isPrimary || event.button !== 0) return;
+            card.getAnimations().forEach(animation => animation.finish());
+            button.focus({ preventScroll: true });
+            drag = { card, handle: button, pointerId: event.pointerId, startX: event.clientX,
+              x: event.clientX, startScroll: row.scrollLeft, reference: card.nextElementSibling, lastTime: performance.now() };
+            card.classList.add('is-dragging');
+            document.documentElement.classList.add('is-reordering');
+            button.setPointerCapture(event.pointerId);
+            drag.frame = requestAnimationFrame(scrollDrag);
+          });
+          button.addEventListener('lostpointercapture', event => {
+            if (drag?.pointerId === event.pointerId) finishDrag(true);
+          });
+        } else {
+          button.addEventListener('click', () => {
+            if (drag) return;
+            const neighbor = action === 'left' ? card.previousElementSibling : card.nextElementSibling;
+            if (!neighbor) return;
+            moveCard(card, action === 'left' ? neighbor : neighbor.nextElementSibling);
+            button.focus({ preventScroll: true });
+          });
+        }
+        controls.append(button);
+      }
+      card.append(controls);
+      card.addEventListener('focusin', event => {
+        if (!drag && event.target.matches(':focus-visible') && !card.getAnimations().length) {
+          card.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+      });
+    }
+    document.querySelector('#reorder-help').hidden = false;
+    document.addEventListener('pointermove', event => {
+      if (drag?.pointerId !== event.pointerId) return;
+      drag.x = event.clientX;
+      updateDrag();
+    });
+    document.addEventListener('pointerup', event => {
+      if (drag?.pointerId === event.pointerId) finishDrag();
+    });
+    document.addEventListener('pointercancel', event => {
+      if (drag?.pointerId === event.pointerId) finishDrag(true);
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && drag) {
+        event.preventDefault();
+        finishDrag(true);
+      }
+    });
+    window.addEventListener('blur', () => finishDrag(true));
+    window.addEventListener('resize', () => finishDrag(true));
+  </script>
