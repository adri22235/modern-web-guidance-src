--- /dev/null
+++ b/scripts/test-renderer.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import { readFileSync, writeFileSync } from 'node:fs';
+import createRenderer from '../assets/smallpt.js';
+const wasm = await createRenderer({ wasmBinary: readFileSync(new URL('../assets/smallpt.wasm', import.meta.url)) });
+assert.equal(wasm._begin_render(0, 48, 1), 0);
+function render(colors, width = 64, height = 48, passes = 2) {
+  assert.equal(wasm._begin_render(width, height, 12345), 1);
+  colors.forEach((c, i) => wasm._set_color([0, 1, 6, 7][i], ...c));
+  let ptr;
+  for (let i=0; i<passes; i++) ptr=wasm._render_pass();
+  return wasm.HEAPU8.slice(ptr, ptr+width*height*4);
+}
+const palette = ['9bac8c','d7bb99','d9e4c8','e5ca9c'].map(hex => [0,2,4].map(n=>parseInt(hex.slice(n,n+2),16)/255));
+const a = render(palette);
+assert.equal(a.length,64*48*4);
+assert.ok(a.some((v,i)=>i%4!==3 && v>0), 'Output contains light');
+assert.ok(a.every((v,i)=>i%4!==3 || v===255), 'Pixels are opaque');
+assert.deepEqual(a,render(palette), 'Same seed reproduces the same image');
+assert.notDeepEqual(a,render([[.8,.2,.2],[.2,.3,.8],[.3,.8,.5],[.8,.4,.3]]), 'Colors change rendered output');
+console.log('Wasm execution, dimensions, alpha, determinism, and color changes passed.');
+if (process.argv.includes('--preview')) {
+  const w=640,h=480;
+  const data=render(palette,w,h,32);
+  writeFileSync(new URL('../.build/preview.rgba',import.meta.url),data);
+  console.log('Rendered 640 × 480 preview at 128 spp.');
+}
diff --git a/scripts/test-worker.mjs b/scripts/test-worker.mjs
new file mode 100644
index 0000000..8928c06
--- /dev/null
+++ b/scripts/test-worker.mjs
@@ -0,0 +1,21 @@
+// Exercise the actual browser worker module without starting a browser or server.
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+const messages = [];
+globalThis.self = { postMessage: (data, transfers) => {
+  assert.equal(transfers[0], data.pixels.buffer);
+  messages.push(data);
+} };
+globalThis.fetch = async url => new Response(await readFile(new URL(url)), { headers: { 'Content-Type': 'application/wasm' } });
+await import('../src/render-worker.js');
+await self.onmessage({ data: {
+  width: 64, height: 48, samples: 8, seed: 42,
+  colors: ['#9bac8c','#d7bb99','#d9e4c8','#e5ca9c']
+} });
+assert.equal(messages.length, 2);
+assert.deepEqual(messages.map(m=>m.samples), [4,8]);
+assert.equal(messages[0].done, false);
+assert.equal(messages[1].done, true);
+assert.equal(messages[1].pixels.length, 64*48*4);
+assert.ok(messages[1].elapsed>0);
+console.log('Worker module loading, Wasm fetch, progressive frames, and transferable buffers passed.');
diff --git a/src/app.js b/src/app.js
new file mode 100644
index 0000000..d193eeb
--- /dev/null
+++ b/src/app.js
@@ -0,0 +1,126 @@
+const $ = (selector) => document.querySelector(selector);
+const canvas = $('#render');
+const context = canvas.getContext('2d');
+const defaults = ['#9bac8c', '#d7bb99', '#d9e4c8', '#e5ca9c'];
+const inputs = [...document.querySelectorAll('input[type="color"]')];
+let worker;
+let colors = [...defaults];
+let timer;
+let started;
+let hasFrame = false;
+let currentSamples = 32;
+
+function showColors() {
+  inputs.forEach((input, index) => {
+    input.value = colors[index];
+    input.parentElement.style.setProperty('--swatch', colors[index]);
+    input.closest('.material').querySelector('.hex').textContent = colors[index].toUpperCase();
+  });
+}
+function fail(message) {
+  clearInterval(timer);
+  $('#status').textContent = message;
+  $('#status-dot').className = 'status-dot error';
+  $('#randomize').disabled = false;
+}
+function render() {
+  worker?.terminate();
+  clearInterval(timer);
+  if (!window.Worker || !window.WebAssembly || !context) {
+    fail('This browser does not support the renderer.');
+    return;
+  }
+  const width = Number($('#resolution').value);
+  const height = width * .75;
+  currentSamples = Number($('#samples').value);
+  started = performance.now();
+  $('#status').textContent = 'Rendering light…';
+  $('#status-dot').className = 'status-dot busy';
+  $('#sample-count').textContent = '0';
+  $('#elapsed').textContent = '0.0';
+  $('#progress').style.width = '0%';
+  $('#download').disabled = true;
+  $('#render-size').textContent = `${width} × ${height}`;
+  timer = setInterval(() => { $('#elapsed').textContent = ((performance.now() - started) / 1000).toFixed(1); }, 100);
+  try {
+    worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = () => { worker.terminate(); fail('Render failed. Try rendering again.'); };
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail(data.error); return; }
+      if (canvas.width !== data.width || canvas.height !== data.height) {
+        canvas.width = data.width;
+        canvas.height = data.height;
+      }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), data.width, data.height), 0, 0);
+      canvas.classList.add('has-frame');
+      hasFrame = true;
+      $('#sample-count').textContent = data.samples;
+      $('#progress').style.width = `${data.samples / currentSamples * 100}%`;
+      if (data.done) {
+        clearInterval(timer);
+        $('#elapsed').textContent = (data.elapsed / 1000).toFixed(1);
+        $('#status').textContent = 'Render complete';
+        $('#status-dot').className = 'status-dot';
+        $('#download').disabled = false;
+        worker.terminate();
+      }
+    };
+    worker.postMessage({ width, height, samples: currentSamples, colors, seed: crypto.getRandomValues(new Uint32Array(1))[0] });
+  } catch {
+    worker?.terminate();
+    fail('Could not start WebAssembly. Try again.');
+  }
+}
+// A new seed and palette re-run the actual C++ renderer; no server work is involved.
+$('#randomize').addEventListener('click', () => {
+  const random = crypto.getRandomValues(new Uint32Array(4));
+  colors = Array.from(random, (value, index) => {
+    const hue = (value % 360) / 60;
+    const saturation = index < 2 ? .35 : .45;
+    const lightness = index < 2 ? .57 : .72;
+    const a = saturation * Math.min(lightness, 1 - lightness);
+    return '#' + [0, 8, 4].map(n => {
+      const k = (n + hue * 2) % 12;
+      return Math.round(255 * (lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, '0');
+    }).join('');
+  });
+  showColors();
+  render();
+});
+inputs.forEach((input, index) => input.addEventListener('change', () => {
+  colors[index] = input.value;
+  showColors();
+  render();
+}));
+$('#samples').addEventListener('change', render);
+$('#resolution').addEventListener('change', render);
+$('#reset').addEventListener('click', () => {
+  colors = [...defaults];
+  $('#samples').value = '32';
+  $('#resolution').value = '640';
+  showColors();
+  render();
+});
+$('#download').addEventListener('click', () => {
+  if (!hasFrame) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${canvas.width}x${canvas.height}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+const viewport = $('.viewport');
+$('#fullscreen').addEventListener('click', async () => {
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else await viewport.requestFullscreen();
+  } catch {
+    $('#status').textContent = 'Fullscreen is unavailable in this browser.';
+  }
+});
+if (!viewport.requestFullscreen) $('#fullscreen').hidden = true;
+render();
diff --git a/src/render-worker.js b/src/render-worker.js
new file mode 100644
index 0000000..194fddb
--- /dev/null
+++ b/src/render-worker.js
@@ -0,0 +1,21 @@
+import createRenderer from '../assets/smallpt.js';
+const ready = createRenderer();
+self.onmessage = async ({ data }) => {
+  try {
+    const wasm = await ready;
+    const { width, height, samples, seed, colors } = data;
+    if (!wasm._begin_render(width, height, seed)) throw new Error('Unsupported render size.');
+    colors.forEach((hex, i) => {
+      const rgb = [1, 3, 5].map(offset => Math.min(.999, parseInt(hex.slice(offset, offset + 2), 16) / 255));
+      wasm._set_color([0, 1, 6, 7][i], ...rgb);
+    });
+    const start = performance.now();
+    for (let pass = 1; pass <= samples / 4; pass++) {
+      const ptr = wasm._render_pass();
+      const pixels = wasm.HEAPU8.slice(ptr, ptr + width * height * 4);
+      self.postMessage({ pixels, width, height, samples: pass * 4, elapsed: performance.now() - start, done: pass * 4 >= samples }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || 'The renderer could not be loaded.' });
+  }
+};
diff --git a/src/renderer.cpp b/src/renderer.cpp
new file mode 100644
index 0000000..b0d4c88
--- /dev/null
+++ b/src/renderer.cpp
@@ -0,0 +1,119 @@
+// Adapted from smallpt by Kevin Beason (MIT). See vendor/smallpt/LICENSE.txt.
+#include <math.h>   // smallpt, a Path Tracer by Kevin Beason, 2008
+#include <stdlib.h> // Make : g++ -O3 -fopenmp smallpt.cpp -o smallpt
+#include <stdio.h>  //        Remove "-fopenmp" for g++ version < 4.2
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) { if (erand48(Xi)<p) f=f*(1/p); else return obj.e; } //R.R.
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+#include <vector>
+#include <cstdint>
+static int width, height, passes;
+static uint32_t seed;
+static std::vector<Vec> accumulation;
+static std::vector<unsigned char> pixels;
+extern "C" {
+int begin_render(int w, int h, unsigned int randomSeed) {
+  if (w < 1 || h < 1 || w > 1600 || h > 1200) return 0;
+  width=w; height=h; seed=randomSeed; passes=0;
+  accumulation.assign(w*h*4, Vec()); pixels.assign(w*h*4, 0);
+  return 1;
+}
+void set_color(int index, double r, double g, double b) {
+  if (index>=0 && index<8) spheres[index].c=Vec(clamp(r),clamp(g),clamp(b));
+}
+unsigned char* render_pass() {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int y=0; y<height; ++y) {
+    uint32_t rowSeed=seed + uint32_t(y)*747796405u + uint32_t(passes)*2891336453u;
+    unsigned short Xi[3]={static_cast<unsigned short>(rowSeed),
+      static_cast<unsigned short>(rowSeed>>16),static_cast<unsigned short>(y*y*y+passes+1)};
+    for (int x=0; x<width; ++x) {
+      int i=(height-y-1)*width+x;
+      Vec color;
+      for (int sy=0; sy<2; ++sy) for (int sx=0; sx<2; ++sx) {
+        double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        int sub=i*4+sy*2+sx;
+        accumulation[sub]=accumulation[sub]+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec avg=accumulation[sub]*(1./(passes+1));
+        color=color+Vec(clamp(avg.x),clamp(avg.y),clamp(avg.z))*.25;
+      }
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y);
+      pixels[i*4+2]=toInt(color.z); pixels[i*4+3]=255;
+    }
+  }
+  ++passes;
+  return pixels.data();
+}
+}
