new file mode 100644
index 0000000..016d60a
--- /dev/null
+++ b/app.js
@@ -0,0 +1,90 @@
+const $ = (id) => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+const original = [[.75, .25, .25], [.25, .25, .75], [.999, .999, .999], [.999, .999, .999]];
+let colors = original.map(color => [...color]);
+let worker;
+let hasFrame = false;
+let paletteNumber = 0;
+function updatePalette() {
+  document.querySelectorAll('.palette span').forEach((swatch, i) => {
+    swatch.style.setProperty('--swatch', `rgb(${colors[i].map(c => Math.round(c * 255)).join(',')})`);
+  });
+  $('palette-label').textContent = paletteNumber ? `Palette ${String(paletteNumber).padStart(2, '0')}` : 'Original';
+}
+function render() {
+  worker?.terminate();
+  const samples = Number($('quality').value);
+  $('status').textContent = 'Tracing light…';
+  $('status-dot').style.background = '#d9a262';
+  $('sample-count').textContent = `0 / ${samples} spp`;
+  $('elapsed').textContent = '0.0s';
+  $('progress').style.width = '0%';
+  try {
+    worker = new Worker('worker.js');
+    worker.onmessage = ({ data }) => {
+      if (data.error) return showError(data.error);
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), 640, 480), 0, 0);
+      canvas.style.visibility = 'visible';
+      hasFrame = true;
+      $('preview').hidden = true;
+      $('sample-count').textContent = `${data.samples} / ${samples} spp`;
+      $('elapsed').textContent = `${data.elapsed.toFixed(1)}s`;
+      $('progress').style.width = `${data.progress * 100}%`;
+      if (data.done) {
+        $('status').textContent = 'Render complete';
+        $('status-dot').style.background = '#6da58d';
+      }
+    };
+    worker.onerror = () => showError('Unable to load the WebAssembly renderer.');
+    worker.postMessage({ width: 640, height: 480, samples, colors, seed: crypto.getRandomValues(new Uint32Array(1))[0] });
+  } catch (error) { showError(error.message); }
+}
+function showError(message) {
+  $('status').textContent = 'Render unavailable';
+  $('status').title = message;
+  $('status-dot').style.background = '#d46d5d';
+  console.error(message);
+  worker?.terminate();
+}
+$('randomize').addEventListener('click', () => {
+  colors = colors.map((_, i) => {
+    const hue = Math.random() * 360;
+    // Keep reflectance under one, and enough light in mirror and glass materials.
+    const floor = i < 2 ? .2 : .65;
+    return [0, 120, 240].map(offset => floor + (.93 - floor) * (1 + Math.cos((hue + offset) * Math.PI / 180)) / 2);
+  });
+  paletteNumber++;
+  updatePalette();
+  render();
+});
+$('reset').addEventListener('click', () => {
+  colors = original.map(color => [...color]);
+  paletteNumber = 0;
+  updatePalette();
+  render();
+});
+$('quality').addEventListener('change', render);
+$('download').addEventListener('click', async () => {
+  const output = document.createElement('canvas');
+  output.width = 640; output.height = 480;
+  const ctx = output.getContext('2d');
+  if (hasFrame) ctx.drawImage(canvas, 0, 0);
+  else {
+    try { await $('preview').decode(); ctx.drawImage($('preview'), 0, 0); }
+    catch { return; }
+  }
+  output.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url; link.download = `smallpt-palette-${paletteNumber}.png`; link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  });
+});
+$('expand').addEventListener('click', async () => {
+  const view = document.querySelector('.canvas-wrap');
+  if (!document.fullscreenElement && view.requestFullscreen) await view.requestFullscreen().catch(() => {});
+  else if (document.fullscreenElement) await document.exitFullscreen();
+});
+render();
