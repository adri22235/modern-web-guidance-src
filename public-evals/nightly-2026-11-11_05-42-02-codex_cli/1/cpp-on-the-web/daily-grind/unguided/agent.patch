+importScripts('smallpt.js');
+self.onmessage = async ({ data }) => {
+  try {
+    const tracer = await createSmallpt();
+    const { width, height, samples, colors, seed } = data;
+    tracer._init(width, height, seed);
+    [0, 1, 6, 7].forEach((id, i) => tracer._set_color(id, ...colors[i]));
+    const pointer = tracer._buffer();
+    const started = performance.now();
+    let lastUpdate = 0;
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row += 8) {
+        const end = Math.min(row + 8, height);
+        tracer._render_rows(row, end, pass);
+        const now = performance.now();
+        const done = pass === samples / 4 - 1 && end === height;
+        if (now - lastUpdate > 120 || done) {
+          const pixels = tracer.HEAPU8.slice(pointer, pointer + width * height * 4);
+          self.postMessage({ pixels, progress: (pass + end / height) / (samples / 4), samples: (pass + 1) * 4, elapsed: (now - started) / 1000, done }, [pixels.buffer]);
+          lastUpdate = now;
+        }
+      }
+    }
+    self.close();
+  } catch (error) {
+    self.postMessage({ error: error.message || String(error) });
+  }
+};
