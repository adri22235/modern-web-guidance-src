+  accum=new Vec[w*h*4](); pixels=new unsigned char[w*h*4]();
+  for(int i=0;i<w*h;i++) pixels[i*4+3]=255;
+}
+void set_color(int id, double r, double g, double b) {
+  if(id==0 || id==1 || id==6 || id==7) spheres[id].c=Vec(r,g,b);
+}
+unsigned char* buffer() { return pixels; }
+void render_rows(int first, int last, int pass) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for(int y=first;y<last && y<height;y++) {
+    unsigned short Xi[3]={(unsigned short)seed,(unsigned short)(seed>>16),
+      (unsigned short)(y*y*y+pass*7919)};
+    for(int x=0;x<width;x++) {
+      int i=(height-y-1)*width+x; Vec color;
+      for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+        double r1=2*erand48(Xi),dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi),dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+
+          cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        int sub=i*4+sy*2+sx;
+        accum[sub]=accum[sub]+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+        Vec mean=accum[sub]*(1.0/(pass+1));
+        color=color+Vec(clamp(mean.x),clamp(mean.y),clamp(mean.z))*.25;
+      }
+      pixels[i*4]=toInt(color.x); pixels[i*4+1]=toInt(color.y);
+      pixels[i*4+2]=toInt(color.z);
+    }
+  }
+}
+}
