+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc src/smallpt.cpp -O3 --no-entry -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=worker,node -s STACK_SIZE=5242880 -s ALLOW_MEMORY_GROWTH=1 -s EXPORTED_RUNTIME_METHODS=HEAPU8 -s EXPORTED_FUNCTIONS='["_init","_set_color","_buffer","_render_rows"]' -o smallpt.js
diff --git a/scripts/test.cjs b/scripts/test.cjs
new file mode 100644
index 0000000..ccba69d
--- /dev/null
+++ b/scripts/test.cjs
@@ -0,0 +1,32 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const createSmallpt = require('../smallpt.js');
+(async () => {
+  const tracer = await createSmallpt();
+  function frame(color) {
+    tracer._init(64, 48, 123);
+    tracer._set_color(6, ...color);
+    tracer._render_rows(0, 48, 0);
+    return tracer.HEAPU8.slice(tracer._buffer(), tracer._buffer() + 64 * 48 * 4);
+  }
+  const original = frame([.999, .999, .999]);
+  assert(original.some((v, i) => i % 4 !== 3 && v > 0), 'Expected visible light');
+  assert(original.every((v, i) => i % 4 !== 3 || v === 255), 'Expected opaque output');
+  assert.notDeepEqual(original, frame([.9, .6, .65]), 'Sphere colors should change the render');
+  assert.deepEqual(original, frame([.999, .999, .999]), 'Same seed should reproduce output');
+  let final;
+  const sandbox = { importScripts() {}, createSmallpt, performance, self: {
+    postMessage(data) { final = data; }, close() {}
+  }};
+  vm.createContext(sandbox);
+  vm.runInContext(fs.readFileSync(require.resolve('../worker.js'), 'utf8'), sandbox);
+  await sandbox.self.onmessage({ data: { width: 32, height: 24, samples: 8,
+    colors: [[.75,.25,.25], [.25,.25,.75], [.999,.999,.999], [.999,.999,.999]], seed: 123 } });
+  assert(!final.error, final.error);
+  assert.equal(final.done, true);
+  assert.equal(final.progress, 1);
+  assert.equal(final.samples, 8);
+  assert.equal(final.pixels.length, 32 * 24 * 4);
+  console.log('PASS: WASM rendering, color changes, deterministic seeds, RGBA output, worker completion.');
+})().catch(error => { console.error(error); process.exitCode = 1; });
