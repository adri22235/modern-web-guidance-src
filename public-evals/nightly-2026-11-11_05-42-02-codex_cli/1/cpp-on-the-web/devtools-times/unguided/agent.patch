diff --git a/public/renderer/worker.js b/public/renderer/worker.js
new file mode 100644
index 0000000..e209ddb
--- /dev/null
+++ b/public/renderer/worker.js
@@ -0,0 +1,32 @@
+/* Kevin Beason's smallpt, compiled from C++ with Emscripten. */
+importScripts('./smallpt.js');
+const modulePromise = createSmallpt({ locateFile: (name) => new URL(name, self.location.href).href });
+let generation = 0;
+self.onmessage = async ({ data }) => {
+  const job = ++generation;
+  try {
+    const module = await modulePromise;
+    if (job !== generation) return;
+    const { width, height, samples, seed, colors } = data;
+    const pointer = module._init_render(width, height, samples, seed);
+    [0, 1, 6, 7].forEach((id, i) => module._set_color(id, ...colors[i]));
+    let row = 0;
+    let lastUpdate = 0;
+    const started = performance.now();
+    function step() {
+      if (job !== generation) return;
+      try {
+        module._render_rows(row, Math.min(3, height - row));
+        row = Math.min(row + 3, height);
+        const now = performance.now();
+        if (now - lastUpdate > 100 || row === height) {
+          const pixels = module.HEAPU8.slice(pointer, pointer + width * height * 4);
+          self.postMessage({ pixels, row, width, height, elapsed: (now - started) / 1000, done: row === height }, [pixels.buffer]);
+          lastUpdate = now;
+        }
+        if (row < height) setTimeout(step, 0);
+      } catch (error) { self.postMessage({ error: String(error) }); }
+    }
+    step();
+  } catch (error) { self.postMessage({ error: String(error) }); }
+};
