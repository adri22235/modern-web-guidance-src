--- /dev/null
+++ b/src/scripts/playground.ts
@@ -0,0 +1,96 @@
+const base = import.meta.env.BASE_URL.replace(/\/$/, '');
+const canvas = document.querySelector<HTMLCanvasElement>('#render')!;
+const context = canvas.getContext('2d')!;
+const preview = document.querySelector<HTMLImageElement>('#preview')!;
+const status = document.querySelector<HTMLElement>('#status')!;
+const progress = document.querySelector<HTMLElement>('#progress')!;
+const samples = document.querySelector<HTMLSelectElement>('#samples')!;
+const resolution = document.querySelector<HTMLSelectElement>('#resolution')!;
+const download = document.querySelector<HTMLButtonElement>('#download')!;
+const original = [[.75,.25,.25],[.25,.25,.75],[.999,.999,.999],[.999,.999,.999]];
+let colors = original.map(c => [...c]);
+let worker: Worker | null = null;
+let hasRender = false;
+let complete = false;
+let started = 0;
+let timer: ReturnType<typeof setInterval>;
+function updatePalette() {
+  const swatches = document.querySelectorAll<HTMLElement>('#palette > span');
+  colors.forEach((c, i) => swatches[i].style.setProperty('--swatch', `rgb(${c.map(v => Math.round(v*255)).join(',')})`));
+}
+function fail(message: string) {
+  clearInterval(timer);
+  complete = false;
+  status.textContent = 'Render failed. Try Render again.';
+  console.error('smallpt:', message);
+  download.disabled = !hasRender;
+}
+function render() {
+  worker?.terminate();
+  clearInterval(timer);
+  complete = false;
+  download.disabled = true;
+  status.textContent = 'Preparing the light…';
+  progress.style.width = '0%';
+  const width = Number(resolution.value), height = width * 3 / 4;
+  const spp = Number(samples.value);
+  document.querySelector('#dimensions')!.textContent = `${width} × ${height}`;
+  document.querySelector('#sample-label')!.textContent = `${spp} spp`;
+  started = performance.now();
+  timer = setInterval(() => {
+    document.querySelector('#elapsed')!.textContent = `${((performance.now()-started)/1000).toFixed(1)} s`;
+  }, 100);
+  try {
+    worker = new Worker(`${base}/renderer/worker.js`);
+    worker.onerror = e => fail(e.message);
+    worker.onmessage = ({ data }) => {
+      if (data.error) return fail(data.error);
+      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+      canvas.style.opacity = '1';
+      preview.style.opacity = '0';
+      hasRender = true;
+      const percent = Math.round(data.row / height * 100);
+      progress.style.width = `${percent}%`;
+      status.textContent = data.done ? 'Render complete' : `Tracing light… ${percent}%`;
+      if (data.done) {
+        complete = true;
+        clearInterval(timer);
+        document.querySelector('#elapsed')!.textContent = `${((performance.now()-started)/1000).toFixed(1)} s`;
+        download.disabled = false;
+      }
+    };
+    worker.postMessage({ width, height, samples: spp, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors });
+  } catch (error) { fail(String(error)); }
+}
+function randomColor(saturation: number, lightness: number) {
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] / 4294967296;
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  return [0,8,4].map(n => {
+    const k = (n + hue * 12) % 12;
+    return lightness - a * Math.max(-1, Math.min(k-3, 9-k, 1));
+  });
+}
+document.querySelector('#randomize')!.addEventListener('click', () => {
+  colors = [randomColor(.55,.48), randomColor(.55,.48), randomColor(.28,.82), randomColor(.22,.85)];
+  updatePalette(); render();
+});
+document.querySelector('#reset')!.addEventListener('click', () => { colors = original.map(c=>[...c]); updatePalette(); render(); });
+document.querySelector('#rerender')!.addEventListener('click', render);
+samples.addEventListener('change', render);
+resolution.addEventListener('change', render);
+download.addEventListener('click', () => {
+  if (!complete && !hasRender) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a'); link.href=url; link.download=`smallpt-${canvas.width}x${canvas.height}.png`; link.click();
+    setTimeout(()=>URL.revokeObjectURL(url),1000);
+  }, 'image/png');
+});
+const dialog = document.querySelector<HTMLDialogElement>('#about')!;
+document.querySelector('#about-open')!.addEventListener('click',()=>dialog.showModal());
+document.querySelector('#about-close')!.addEventListener('click',()=>dialog.close());
+dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
+window.addEventListener('pagehide',()=>{worker?.terminate();clearInterval(timer);});
+render();
