+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+em++ native/smallpt.cpp -o public/wasm/smallpt.js \
+  -O3 -flto -fno-exceptions -fno-rtti -Wall -Werror --no-entry \
+  -sSTRICT -sEXPORT_ES6 -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=1MB \
+  -sEXPORTED_FUNCTIONS=_init_scene,_set_color,_get_pixels,_render_rows \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
