diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..f97fcc9
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,30 @@
+import createSmallpt from './smallpt.js';
+
+let paused = false;
+self.onmessage = async ({ data }) => {
+  if (data.type === 'pause') { paused = true; return; }
+  if (data.type === 'resume') { paused = false; return; }
+  if (data.type !== 'render') return;
+  try {
+    const wasm = await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    if (!wasm._init_scene(width, height, seed)) throw new Error('Unsupported image dimensions.');
+    for (const { id, rgb } of colors) wasm._set_color(id, ...rgb);
+    const passes = samples / 4;
+    for (let pass = 0; pass < passes; pass++) {
+      for (let row = 0; row < height; row += 8) {
+        while (paused) await new Promise(resolve => setTimeout(resolve, 80));
+        wasm._render_rows(row, 8, pass);
+        self.postMessage({ type: 'progress', progress: (pass + Math.min(row + 8, height) / height) / passes });
+        // Yield so pause/resume messages can be handled between row batches.
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+      // Read the current heap after rendering: memory growth can replace its buffer.
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, wasm._get_pixels(), width * height * 4).slice();
+      self.postMessage({ type: 'frame', width, height, samples: (pass + 1) * 4, pixels }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'complete' });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error instanceof Error ? error.message : 'The renderer could not start.' });
+  }
+};
