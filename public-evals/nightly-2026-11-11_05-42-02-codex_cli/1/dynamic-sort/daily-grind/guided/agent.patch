@@ -207,6 +271,54 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const favorites = document.querySelector('#seasonal-favorites');
+    const sortControl = document.querySelector('#favorites-sort');
+    const sortStatus = document.querySelector('#favorites-sort-status');
+    const featuredCards = Array.from(favorites.children);
+    const collator = new Intl.Collator('en', { sensitivity: 'base' });
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    featuredCards.forEach((card, index) => {
+      card.style.viewTransitionName = `seasonal-card-${index}`;
+    });
+
+    sortControl.addEventListener('change', () => {
+      const orderedCards = [...featuredCards];
+      if (sortControl.value !== 'featured') {
+        const direction = sortControl.value === 'name-asc' ? 1 : -1;
+        orderedCards.sort((a, b) => direction * collator.compare(
+          a.querySelector('h3').textContent,
+          b.querySelector('h3').textContent
+        ));
+      }
+
+      const orderLabel = sortControl.selectedOptions[0].textContent;
+      const update = () => {
+        for (const card of orderedCards) {
+          if (favorites.moveBefore) {
+            favorites.moveBefore(card, null);
+          } else {
+            favorites.append(card);
+          }
+        }
+        sortStatus.textContent = `Sorted by ${orderLabel}, ${orderedCards.length} favorites.`;
+      };
+
+      if (reducedMotion.matches) {
+        update();
+      } else if (favorites.startViewTransition) {
+        favorites.startViewTransition(update);
+      } else if (document.startViewTransition) {
+        document.startViewTransition(update);
+      } else {
+        update();
+      }
+    });
+
+    document.querySelector('#favorites-sort-control').hidden = false;
+  </script>
+
 </body>
 
