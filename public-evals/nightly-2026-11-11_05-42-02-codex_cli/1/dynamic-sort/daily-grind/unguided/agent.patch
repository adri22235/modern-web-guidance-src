+  <script>
+    const grid = document.querySelector('#seasonal-favorites');
+    const sortSelect = document.querySelector('#favorites-sort');
+    const cards = Array.from(grid.children);
+    const names = new Map(cards.map(card => [card, card.querySelector('h3').textContent.trim()]));
+    const collator = new Intl.Collator('en', { sensitivity: 'base' });
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const animations = new Map();
+
+    document.querySelector('.sort-controls').hidden = false;
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) {
+        animations.forEach(animation => animation.cancel());
+        animations.clear();
+      }
+    });
+
+    sortSelect.addEventListener('change', () => {
+      // Capture the current visual positions, including any animation in progress.
+      const previous = new Map(cards.map(card => [card, card.getBoundingClientRect()]));
+      animations.forEach(animation => animation.cancel());
+      animations.clear();
+
+      const sorted = [...cards];
+      if (sortSelect.value !== 'featured') {
+        const direction = sortSelect.value === 'name-asc' ? 1 : -1;
+        sorted.sort((a, b) => direction * collator.compare(names.get(a), names.get(b)));
+      }
+      // Reorder the actual elements so reading and keyboard order follow the cards.
+      grid.append(...sorted);
+
+      if (!reducedMotion.matches) {
+        const positions = new Map(cards.map(card => [card, card.getBoundingClientRect()]));
+        cards.forEach(card => {
+          const dx = previous.get(card).left - positions.get(card).left;
+          const dy = previous.get(card).top - positions.get(card).top;
+          if ((!dx && !dy) || !card.animate) return;
+
+          const animation = card.animate([
+            { transform: `translate(${dx}px, ${dy}px)` },
+            { transform: 'translate(0, 0)' }
+          ], { duration: 450, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
+          animations.set(card, animation);
+          animation.onfinish = () => {
+            if (animations.get(card) === animation) animations.delete(card);
+          };
+        });
+      }
+
+      document.querySelector('#sort-status').textContent =
+        `Seasonal favorites sorted by ${sortSelect.selectedOptions[0].textContent}.`;
+    });
+  </script>
+
