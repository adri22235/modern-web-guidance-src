+import express from 'express';
+import { readFile, mkdir } from 'node:fs/promises';
+import { randomBytes, scrypt } from 'node:crypto';
+import { promisify } from 'node:util';
+import { fileURLToPath } from 'node:url';
+import { createStore } from './store.mjs';
+import { defaultIssuers, verifyEmailToken } from './verify-email.mjs';
+
+const origin = new URL(process.env.PUBLIC_ORIGIN || 'http://localhost:11222').origin;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) throw Error('Set PUBLIC_ORIGIN to your HTTPS deployment origin');
+const secure = origin.startsWith('https://');
+const cookieName = secure ? '__Host-dg-session' : 'dg-session';
+const issuers = process.env.EVP_ISSUERS ? JSON.parse(process.env.EVP_ISSUERS) : defaultIssuers;
+const template = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+await mkdir(new URL('../data/', import.meta.url), { recursive: true, mode: 0o700 });
+const store = createStore(process.env.DATABASE_PATH || fileURLToPath(new URL('../data/rewards.sqlite', import.meta.url)));
+const hashPassword = promisify(scrypt);
+const app = express();
+app.disable('x-powered-by');
+app.use((req, res, next) => {
+  res.set({ 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'same-origin', 'Content-Security-Policy': "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" });
+  next();
+});
+app.use(express.urlencoded({ extended: false, limit: '40kb' }));
+const sessionFor = req => req.headers.cookie?.split(';').map(s => s.trim()).find(s => s.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+function result(req, res, status, message, verified = false) {
+  if (req.accepts(['html', 'json']) === 'json') return res.status(status).json({ verified, message });
+  return res.status(status).type('html').send(`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Daily Grind Rewards</title><body style="font:18px/1.6 system-ui;background:#faf6ef;color:#4e342e;max-width:620px;padding:48px 24px;margin:auto"><p>THE DAILY GRIND · REWARDS</p><h1>${verified ? 'Welcome to the daily ritual.' : 'Let’s finish your sign-up.'}</h1><p role="status">${message}</p><a style="color:inherit" href="/#rewards">${verified ? 'Back to Daily Grind' : 'Return to the form and try again'}</a></body></html>`);
+}
+app.get('/', (req, res) => {
+  let session = sessionFor(req);
+  if (!/^[A-Za-z0-9_-]{43}$/.test(session || '')) session = randomBytes(32).toString('base64url');
+  res.cookie(cookieName, session, { httpOnly: true, secure, sameSite: 'lax', path: '/', maxAge: 3600000 });
+  const form = store.issue(session);
+  if (process.env.ORIGIN_TRIAL_TOKEN) res.set('Origin-Trial', process.env.ORIGIN_TRIAL_TOKEN);
+  res.type('html').send(template.replace('__EVP_NONCE__', form.nonce).replace('__FORM_ID__', form.id));
+});
+app.post('/api/verify-email', async (req, res) => {
+  if (req.headers.origin !== origin) return result(req, res, 403, 'Please submit the form from the Daily Grind homepage.');
+  const body = req.body || {};
+  const form = store.consume(typeof body.form_id === 'string' ? body.form_id : '', sessionFor(req) || '');
+  if (!form || form.expires < Date.now()) return result(req, res, 409, 'Your sign-up form has expired or was already submitted. Return to the form to start again.');
+  const { email, name, password, token } = body;
+  if (typeof email !== 'string' || email.length > 254 || !/^[^\s@]+@[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$/.test(email) || typeof name !== 'string' || !name.trim() || name.length > 100 || typeof password !== 'string' || password.length < 12 || password.length > 128) return result(req, res, 400, 'Enter a name, a valid email address, and a password of 12–128 characters.');
+  if (typeof token !== 'string' || !token) return result(req, res, 422, 'Your browser didn’t provide email verification. Use a supported browser, sign in to your email provider in that browser, and allow email verification before trying again. No verification email has been sent.');
+  try { await verifyEmailToken({ rawToken: token, email, nonce: form.nonce, audience: origin }, { issuers }); }
+  catch { return result(req, res, 422, 'We couldn’t confirm your email securely. Return to the form and try again with your email provider signed in. No account was created and no verification email was sent.'); }
+  const salt = randomBytes(16).toString('hex');
+  const hash = await hashPassword(password, salt, 64);
+  const created = store.register({ email, name: name.trim(), passwordHash: `scrypt:${salt}:${hash.toString('hex')}` });
+  if (!created) return result(req, res, 409, 'A rewards account already exists for this verified email address.');
+  return result(req, res, 201, 'Your email is verified and your rewards account is ready. We’re happy you’re here.', true);
+});
+app.use((error, req, res, next) => {
+  if (res.headersSent) return next(error);
+  result(req, res, error.status === 413 ? 413 : 500, 'We couldn’t process your request. Please return to the form and try again.');
+});
+app.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
