new file mode 100644
index 0000000..6873396
--- /dev/null
+++ b/server/store.mjs
@@ -0,0 +1,24 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes } from 'node:crypto';
+export function createStore(path) {
+  const db = new DatabaseSync(path);
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS forms (id TEXT PRIMARY KEY, session TEXT NOT NULL, nonce TEXT NOT NULL, expires INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS accounts (id TEXT PRIMARY KEY, email TEXT UNIQUE COLLATE NOCASE NOT NULL, name TEXT NOT NULL, password_hash TEXT NOT NULL, email_verified INTEGER NOT NULL, created INTEGER NOT NULL);`);
+  return {
+    issue(session) {
+      db.prepare('DELETE FROM forms WHERE expires < ?').run(Date.now());
+      const form = { id: randomBytes(24).toString('base64url'), nonce: randomBytes(32).toString('base64url') };
+      db.prepare('INSERT INTO forms VALUES (?, ?, ?, ?)').run(form.id, session, form.nonce, Date.now() + 600000);
+      return form;
+    },
+    consume(id, session) {
+      // DELETE RETURNING consumes the nonce atomically, including under concurrent requests.
+      return db.prepare('DELETE FROM forms WHERE id = ? AND session = ? RETURNING nonce, expires').get(id, session);
+    },
+    register({ email, name, passwordHash }) {
+      return db.prepare('INSERT INTO accounts VALUES (?, ?, ?, ?, 1, ?) ON CONFLICT(email) DO NOTHING').run(randomBytes(16).toString('hex'), email, name, passwordHash, Date.now()).changes > 0;
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/server/verify-email.mjs b/server/verify-email.mjs
new file mode 100644
index 0000000..862426b
--- /dev/null
+++ b/server/verify-email.mjs
@@ -0,0 +1,82 @@
+import { createHash } from 'node:crypto';
+import { resolveTxt } from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const ALGORITHMS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalize = alg => alg === 'Ed25519' ? 'EdDSA' : alg;
+export const hasher = (data, alg) => {
+  if (!['sha-256', 'sha-384', 'sha-512'].includes(alg)) throw Error('Unsupported digest');
+  return createHash(alg.replace('-', '')).update(data).digest();
+};
+// Server-controlled trust configuration prevents token-controlled network requests.
+export const defaultIssuers = {
+  'https://accounts.google.com': ['https://accounts.google.com', 'https://verifiablecredentials-pa.googleapis.com'],
+};
+async function fetchJson(url) {
+  const response = await fetch(url, { redirect: 'error', signal: AbortSignal.timeout(5000) });
+  if (!response.ok) throw Error('Provider unavailable');
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of response.body) {
+    size += chunk.length;
+    if (size > 131072) throw Error('Oversized provider response');
+    chunks.push(chunk);
+  }
+  return JSON.parse(Buffer.concat(chunks).toString());
+}
+export async function verifyEmailToken({ rawToken, email, nonce, audience }, {
+  issuers = defaultIssuers, txt = resolveTxt, json = fetchJson,
+} = {}) {
+  if (!nonce || !rawToken || rawToken.length > 32768) throw Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evt = decoded.jwt.payload;
+  const kb = decoded.kbJwt;
+  if (!kb || !Object.hasOwn(issuers, evt.iss)) throw Error('Unsupported issuer');
+  const issuerUrl = new URL(evt.iss);
+  if (issuerUrl.protocol !== 'https:' || issuerUrl.origin !== evt.iss || issuerUrl.port) throw Error('Invalid issuer origin');
+  if (!ALGORITHMS.includes(decoded.jwt.header.alg) || !ALGORITHMS.includes(kb.header.alg)) throw Error('Unsupported signature');
+  if (!['evt+jwt', 'ev+sd-jwt'].includes(decoded.jwt.header.typ)) throw Error('Invalid token type');
+  const records = await txt(`_email-verification.${email.split('@')[1].toLowerCase()}`);
+  if (!records.some(r => r.join('').trim() === `iss=${issuerUrl.hostname}`)) throw Error('Issuer not delegated');
+  const metadata = await json(`${evt.iss}/.well-known/email-verification`);
+  const jwksUrl = new URL(metadata.jwks_uri);
+  if (metadata.issuer !== evt.iss || jwksUrl.protocol !== 'https:' || jwksUrl.username || jwksUrl.password || !issuers[evt.iss].includes(jwksUrl.origin)) throw Error('Untrusted metadata');
+  const keys = createLocalJWKSet(await json(jwksUrl.href));
+  const evtOptions = {
+    issuer: evt.iss, algorithms: ALGORITHMS, maxTokenAge: '5m', clockTolerance: 30,
+    requiredClaims: ['iss', 'iat', 'exp'],
+  };
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, signature) => {
+      const token = `${data}.${signature}`;
+      try { await jwtVerify(token, keys, evtOptions); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let valid = false;
+        for await (const key of error) {
+          try { await jwtVerify(token, key, evtOptions); valid = true; break; } catch { /* try remaining keys */ }
+        }
+        if (!valid) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, signature, payload) => {
+      const jwk = payload.cnf?.jwk;
+      if (!jwk || jwk.d || jwk.k || !ALGORITHMS.includes(jwk.alg) || normalize(jwk.alg) !== normalize(kb.header.alg)) throw Error('Invalid holder key');
+      const key = await importJWK(jwk, kb.header.alg);
+      await jwtVerify(`${data}.${signature}`, key, {
+        typ: 'kb+jwt', algorithms: [kb.header.alg], audience, maxTokenAge: '5m', clockTolerance: 30,
+      });
+      return true;
+    },
+  });
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: nonce,
+    expectedKeyBindingAudience: audience, keyBindingMaxAgeSeconds: 300, skewSeconds: 30,
+    allowedIssuerAlgorithms: ALGORITHMS, allowedKeyBindingAlgorithms: ALGORITHMS,
+  });
+  if (verified.payload.email_verified !== true || typeof verified.payload.email !== 'string' || verified.payload.email.toLowerCase() !== email.toLowerCase()) throw Error('Email mismatch');
+  return verified.payload;
+}
