+++ b/test/rewards.test.mjs
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createHash } from 'node:crypto';
+import { generateKeyPair, exportJWK, SignJWT } from 'jose';
+import { parse } from 'parse5';
+import { verifyEmailToken } from '../server/verify-email.mjs';
+import { createStore } from '../server/store.mjs';
+
+const issuer = 'https://issuer.example';
+const audience = 'https://coffee.example';
+const email = 'Regular@example.com';
+const nonce = 'server-generated-single-use-nonce';
+const issuerKey = await generateKeyPair('ES256');
+const otherKey = await generateKeyPair('ES256');
+const holder = await generateKeyPair('ES256');
+const publicHolder = { ...await exportJWK(holder.publicKey), alg: 'ES256' };
+const deps = {
+  issuers: { [issuer]: [issuer] },
+  txt: async () => [['iss=issuer.example']],
+  json: async url => url.endsWith('email-verification') ? { issuer, jwks_uri: `${issuer}/keys` } : { keys: [await exportJWK(otherKey.publicKey), await exportJWK(issuerKey.publicKey)] },
+};
+async function fixture({ claims = {}, binding = {}, signingKey = issuerKey.privateKey, holderKey = holder.privateKey, corruptHash = false, includeKb = true } = {}) {
+  const now = Math.floor(Date.now() / 1000);
+  const evt = await new SignJWT({ iss: issuer, iat: now, exp: now + 300, email, email_verified: true, cnf: { jwk: publicHolder }, ...claims }).setProtectedHeader({ alg: 'ES256', typ: 'evt+jwt' }).sign(signingKey);
+  const kb = await new SignJWT({ aud: audience, nonce, iat: now, sd_hash: corruptHash ? 'wrong' : createHash('sha256').update(`${evt}~`).digest('base64url'), ...binding }).setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' }).sign(holderKey);
+  return includeKb ? `${evt}~${kb}` : `${evt}~`;
+}
+const verify = async (options = {}, overrides = {}) => verifyEmailToken({ rawToken: await fixture(options), email, nonce, audience }, { ...deps, ...overrides });
+test('valid proof accepts case-insensitive email and missing kid with multiple keys', async () => {
+  const proof = await verify({ claims: { email: email.toLowerCase() } });
+  assert.equal(proof.email_verified, true);
+});
+for (const [name, options] of Object.entries({
+  'wrong email': { claims: { email: 'attacker@example.com' } },
+  'unverified email': { claims: { email_verified: false } },
+  'expired issuer proof': { claims: { exp: 1 } },
+  'missing expiry': { claims: { exp: undefined } },
+  'future issuer proof': { claims: { iat: Math.floor(Date.now() / 1000) + 600 } },
+  'wrong nonce': { binding: { nonce: 'replay' } },
+  'wrong audience': { binding: { aud: 'https://attacker.example' } },
+  'stale key binding': { binding: { iat: 1 } },
+  'forged issuer signature': { signingKey: holder.privateKey },
+  'forged browser signature': { holderKey: otherKey.privateKey },
+  'broken digest binding': { corruptHash: true },
+  'missing key binding': { includeKb: false },
+})) test(`rejects ${name}`, async () => { await assert.rejects(verify(options)); });
+test('rejects undelegated issuer before discovery', async () => {
+  await assert.rejects(verify({}, { txt: async () => [['iss=evil.example']], json: async () => { assert.fail('must not fetch'); } }));
+});
+test('rejects untrusted JWKS URL before fetching it', async () => {
+  await assert.rejects(verify({}, { json: async url => { assert.ok(url.endsWith('email-verification')); return { issuer, jwks_uri: 'https://internal.example/keys' }; } }));
+});
+test('session binding, expiration, and atomic nonce consumption', () => {
+  const store = createStore(':memory:');
+  try {
+    const form = store.issue('session-a');
+    assert.equal(store.consume(form.id, 'session-b'), undefined);
+    assert.equal(store.consume(form.id, 'session-a').nonce, form.nonce);
+    assert.equal(store.consume(form.id, 'session-a'), undefined);
+    assert.notEqual(store.issue('session-a').nonce, form.nonce);
+    assert.equal(store.register({ email, name: 'Regular', passwordHash: 'hashed' }), true);
+    assert.equal(store.register({ email: email.toLowerCase(), name: 'Regular', passwordHash: 'hashed' }), false);
+  } finally { store.close(); }
+});
+test('homepage provides native browser-verification form and accessible fields', async () => {
+  const doc = parse(await readFile(new URL('../index.html', import.meta.url), 'utf8'));
+  const nodes = [];
+  function walk(node) { nodes.push(node); for (const child of node.childNodes || []) walk(child); }
+  walk(doc);
+  const attr = (node, key) => node.attrs?.find(a => a.name === key)?.value;
+  const form = nodes.find(n => n.tagName === 'form' && attr(n, 'action') === '/api/verify-email');
+  assert.equal(attr(form, 'method'), 'POST');
+  const inputs = form.childNodes.flatMap(function descend(n) { return n.tagName === 'input' ? [n] : (n.childNodes || []).flatMap(descend); });
+  assert.ok(inputs.some(n => attr(n, 'autocomplete') === 'email'));
+  const token = inputs.find(n => attr(n, 'autocomplete') === 'email-verification-token');
+  assert.equal(attr(token, 'nonce'), '__EVP_NONCE__');
+  for (const input of inputs.filter(n => attr(n, 'type') !== 'hidden')) {
+    assert.ok(nodes.some(n => n.tagName === 'label' && attr(n, 'for') === attr(input, 'id')));
+    assert.ok(input.attrs.some(a => a.name === 'required'));
+  }
+});
