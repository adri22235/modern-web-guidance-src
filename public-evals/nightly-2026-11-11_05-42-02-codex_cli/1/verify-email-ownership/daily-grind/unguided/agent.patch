+const form = document.querySelector('#rewards-form');
+const joinButton = document.querySelector('#join-button');
+const status = document.querySelector('#form-status');
+const googlePanel = document.querySelector('#google-verification');
+const cancelButton = document.querySelector('#cancel-verification');
+let flow = 0;
+let googlePromise;
+let processing = false;
+
+function message(text, error = false) {
+  status.textContent = text;
+  status.classList.toggle('error', error);
+  status.hidden = !text;
+}
+function lockDetails(locked) {
+  for (const input of form.querySelectorAll('input')) {
+    if (input.type === 'checkbox') input.disabled = locked;
+    else input.readOnly = locked;
+  }
+}
+function reset() {
+  ++flow;
+  lockDetails(false);
+  googlePanel.hidden = true;
+  document.querySelector('#google-button').replaceChildren();
+  joinButton.hidden = false;
+  joinButton.disabled = false;
+  joinButton.innerHTML = 'Join the good stuff <span aria-hidden="true">↗</span>';
+}
+async function api(path, data) {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 18000);
+  try {
+    const response = await fetch(`/api/rewards/${path}`, {
+      method: data ? 'POST' : 'GET',
+      headers: data ? { 'Content-Type': 'application/json' } : {},
+      credentials: 'same-origin',
+      body: data ? JSON.stringify(data) : undefined,
+      signal: controller.signal,
+    });
+    let result;
+    try { result = await response.json(); } catch { throw new Error('Online sign-up is temporarily unavailable. Please try again shortly.'); }
+    if (!response.ok) throw new Error(result.error || 'Something went wrong. Please try again.');
+    return result;
+  } catch (error) {
+    if (error.name === 'AbortError' || error instanceof TypeError) throw new Error('We couldn’t connect. Check your connection and try again.');
+    throw error;
+  } finally { clearTimeout(timer); }
+}
+function loadGoogle() {
+  if (window.google?.accounts?.id) return Promise.resolve();
+  if (googlePromise) return googlePromise;
+  googlePromise = new Promise((resolve, reject) => {
+    const script = document.createElement('script');
+    const fail = () => { clearTimeout(timer); script.remove(); googlePromise = undefined; reject(new Error('Google verification couldn’t load. Please allow Google sign-in and try again.')); };
+    const timer = setTimeout(fail, 15000);
+    script.src = 'https://accounts.google.com/gsi/client';
+    script.async = true;
+    script.onload = () => { clearTimeout(timer); if (window.google?.accounts?.id) resolve(); else fail(); };
+    script.onerror = fail;
+    document.head.append(script);
+  });
+  return googlePromise;
+}
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (joinButton.disabled || processing) return;
+  const emailInput = form.elements.email;
+  emailInput.value = emailInput.value.trim();
+  for (const key of ['firstName', 'lastName']) form.elements[key].value = form.elements[key].value.trim();
+  if (!form.reportValidity()) return;
+  const details = {
+    firstName: form.elements.firstName.value,
+    lastName: form.elements.lastName.value,
+    email: emailInput.value.toLowerCase(),
+    terms: form.elements.terms.checked,
+    marketing: form.elements.marketing.checked,
+  };
+  const thisFlow = ++flow;
+  joinButton.disabled = true;
+  joinButton.textContent = 'Getting your welcome ready…';
+  message('');
+  lockDetails(true);
+  try {
+    const config = await api('config');
+    if (!config.configured || !config.clientId) throw new Error('Online sign-up is not available yet. Please try again soon.');
+    await loadGoogle();
+    if (thisFlow !== flow) return;
+    const { nonce } = await api('challenge', { email: details.email });
+    if (thisFlow !== flow) return;
+    window.google.accounts.id.initialize({
+      client_id: config.clientId,
+      nonce,
+      login_hint: details.email,
+      auto_select: false,
+      ux_mode: 'popup',
+      callback: async ({ credential }) => {
+        if (thisFlow !== flow || processing) return;
+        processing = true;
+        cancelButton.disabled = true;
+        message('Confirming your email and creating your rewards account…');
+        try {
+          await api('verify-email', { email: details.email, credential });
+          if (thisFlow !== flow) return;
+          const result = await api('register', details);
+          if (thisFlow !== flow) return;
+          form.hidden = true;
+          const success = document.querySelector('#signup-success');
+          success.hidden = false;
+          document.querySelector('#success-message').textContent = `Welcome, ${result.member.firstName}! Your email is verified and your rewards account is ready.`;
+          success.setAttribute('tabindex', '-1');
+          success.focus();
+        } catch (error) {
+          reset();
+          message(error.message, true);
+        } finally { processing = false; cancelButton.disabled = false; }
+      },
+    });
+    googlePanel.hidden = false;
+    joinButton.hidden = true;
+    window.google.accounts.id.renderButton(document.querySelector('#google-button'), {
+      type: 'standard', theme: 'outline', size: 'large', text: 'continue_with', shape: 'rectangular',
+      width: Math.min(340, Math.floor(googlePanel.clientWidth - 28)),
+    });
+    message('Choose the same Gmail or Google Workspace address you entered above.');
+  } catch (error) {
+    if (thisFlow !== flow) return;
+    reset();
+    message(error.message, true);
+  }
+});
+cancelButton.addEventListener('click', () => { if (!processing) { reset(); message(''); form.elements.email.focus(); } });
+document.querySelector('#verification-info').addEventListener('click', event => {
+  const button = event.currentTarget;
+  const details = document.querySelector('#verification-details');
+  details.hidden = !details.hidden;
+  button.setAttribute('aria-expanded', String(!details.hidden));
+});
+const dialog = document.querySelector('#policy-dialog');
+const policies = {
+  terms: {
+    title: 'Daily Grind Rewards Terms',
+    paragraphs: [
+      'Membership is free. You must verify a Gmail or Google Workspace email address to join. One rewards account and one welcome drink per person. Your account is linked to your verified Google identity.',
+      'Earn 1 point per $1 spent on eligible café purchases, excluding taxes, tips, and gift cards. Ask your barista to attach your purchase to your rewards email. Your welcome drink is one standard handcrafted drink, redeemable once at participating Daily Grind cafés; extras may cost more.',
+      'Birthday treats, early access, and special offers are subject to availability and offer conditions. Birthday details may be provided in store. Rewards have no cash value. Fraud or misuse may result in cancellation. Program terms may change; existing members will be notified of material changes.',
+      'Terms version: November 11, 2026. For membership assistance, speak with the team at your local Daily Grind café.',
+    ],
+  },
+  privacy: {
+    title: 'Your privacy matters',
+    paragraphs: [
+      'We store your name, verified email address, Google account identifier, rewards balance, welcome-drink status, and the terms and marketing choices you make. We use this information to operate your rewards membership and prevent duplicate or fraudulent registrations.',
+      'Google confirms your identity through its secure sign-in service. We do not request your Google password or access to your inbox. Verification tokens are used only for verification and are not stored in your rewards account. A temporary, essential registration cookie expires after ten minutes or when registration completes.',
+      'Marketing is optional and is separate from membership. You can opt out of promotional messages at any time. We do not sell your personal information. Speak with your local Daily Grind team to request access to, correction of, or deletion of your membership information.',
+      'This site loads fonts from Google Fonts and coffee photography from Unsplash. Their servers receive your IP address when those resources load. Google sign-in loads only when you begin registration. Privacy notice updated November 11, 2026.',
+    ],
+  },
+};
+for (const button of document.querySelectorAll('[data-policy]')) {
+  button.addEventListener('click', () => {
+    const policy = policies[button.dataset.policy];
+    document.querySelector('#policy-title').textContent = policy.title;
+    document.querySelector('#policy-body').replaceChildren(...policy.paragraphs.map(text => {
+      const p = document.createElement('p'); p.textContent = text; return p;
+    }));
+    dialog.showModal();
+  });
+}
+document.querySelector('#close-dialog').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', event => { if (event.target === dialog) { const box = dialog.getBoundingClientRect(); if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) dialog.close(); } });
