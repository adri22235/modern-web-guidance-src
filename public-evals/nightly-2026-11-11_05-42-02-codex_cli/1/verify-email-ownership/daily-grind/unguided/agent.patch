+import { createRemoteJWKSet, jwtVerify } from 'jose';
+
+const googleKeys = createRemoteJWKSet(new URL('https://www.googleapis.com/oauth2/v3/certs'));
+
+// Never accept an email or a client-provided `verified` flag as proof of ownership.
+export async function verifyEmailCredential(credential, { clientId, nonce, email }, keys = googleKeys) {
+  if (!clientId || !nonce || typeof credential !== 'string' || credential.length > 16000) {
+    throw new Error('Invalid verification request. Please start again.');
+  }
+  const { payload } = await jwtVerify(credential, keys, {
+    audience: clientId,
+    issuer: ['https://accounts.google.com', 'accounts.google.com'],
+    algorithms: ['RS256'],
+    requiredClaims: ['exp', 'iat', 'sub', 'email', 'email_verified', 'nonce'],
+    maxTokenAge: '10m',
+    clockTolerance: 5,
+  });
+  if (payload.nonce !== nonce || typeof payload.sub !== 'string' || !payload.sub ||
+      (payload.azp && payload.azp !== clientId) || payload.email_verified !== true ||
+      typeof payload.email !== 'string' || payload.email.toLowerCase() !== email) {
+    throw new Error('Use the Google account that matches the email you entered.');
+  }
+  // For a third-party Google Account, email_verified may describe past ownership.
+  // Only accept mailboxes for which Google is currently authoritative.
+  if (!email.endsWith('@gmail.com') && !(typeof payload.hd === 'string' && payload.hd.length > 0)) {
+    throw new Error('Please use a Gmail or Google Workspace email address for secure verification.');
+  }
+  return { email, subject: payload.sub, expiresAt: payload.exp * 1000 };
+}
