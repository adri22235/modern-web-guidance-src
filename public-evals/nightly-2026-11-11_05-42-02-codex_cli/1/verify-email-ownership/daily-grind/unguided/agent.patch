new file mode 100644
index 0000000..9411971
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,160 @@
+import { createServer } from 'node:http';
+import { readFile, mkdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import { verifyEmailCredential } from './verification.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = new URL(process.env.PUBLIC_ORIGIN || `http://localhost:${port}`).origin;
+const clientId = process.env.GOOGLE_CLIENT_ID || '';
+if (process.env.NODE_ENV === 'production' && (!clientId || !process.env.PUBLIC_ORIGIN || !origin.startsWith('https://'))) {
+  throw new Error('Production requires GOOGLE_CLIENT_ID and an HTTPS PUBLIC_ORIGIN.');
+}
+const cookieName = origin.startsWith('https://') ? '__Host-dg_registration' : 'dg_registration';
+const cookieOptions = `Path=/; HttpOnly; SameSite=Strict${origin.startsWith('https://') ? '; Secure' : ''}`;
+const root = fileURLToPath(new URL('.', import.meta.url));
+const dataDir = process.env.DATA_DIR || `${root}data`;
+await mkdir(dataDir, { recursive: true, mode: 0o700 });
+const db = new DatabaseSync(`${dataDir}/rewards.sqlite`);
+db.exec(`PRAGMA journal_mode = WAL;
+  CREATE TABLE IF NOT EXISTS rewards_members (
+    id TEXT PRIMARY KEY, first_name TEXT NOT NULL, last_name TEXT NOT NULL,
+    email TEXT NOT NULL UNIQUE, google_subject TEXT NOT NULL UNIQUE,
+    email_verified_at TEXT NOT NULL, marketing_consent INTEGER NOT NULL,
+    terms_version TEXT NOT NULL, created_at TEXT NOT NULL,
+    welcome_drink_available INTEGER NOT NULL DEFAULT 1, points INTEGER NOT NULL DEFAULT 0
+  );`);
+const sessions = new Map();
+const rates = new Map();
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/app.js', ['app.js', 'text/javascript; charset=utf-8']],
+]);
+
+function json(res, status, body) {
+  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+function cookieSession(req) {
+  const id = req.headers.cookie?.split(';').map(c => c.trim()).find(c => c.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+  const session = id && sessions.get(id);
+  return session?.expiresAt > Date.now() ? { id, session } : null;
+}
+function cleanState() {
+  const now = Date.now();
+  for (const [id, session] of sessions) if (session.expiresAt <= now) sessions.delete(id);
+  for (const [ip, rate] of rates) if (rate.expiresAt <= now) rates.delete(ip);
+}
+function rateLimit(req) {
+  // Use the socket address; do not trust arbitrary forwarded IP headers.
+  const ip = req.socket.remoteAddress;
+  const rate = rates.get(ip) || { count: 0, expiresAt: Date.now() + 60000 };
+  if (!rates.has(ip) && rates.size >= 10000) return false;
+  rates.set(ip, rate);
+  return ++rate.count <= 30;
+}
+async function readJson(req) {
+  if (!req.headers['content-type']?.startsWith('application/json')) throw new Error('Expected JSON.');
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 20000) throw new Error('Request too large.');
+    chunks.push(chunk);
+  }
+  const body = JSON.parse(Buffer.concat(chunks).toString());
+  if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('Invalid request.');
+  return body;
+}
+function normalizeEmail(value) {
+  if (typeof value !== 'string') return null;
+  const email = value.trim().toLowerCase();
+  return email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? email : null;
+}
+function validName(value) {
+  return typeof value === 'string' && value.trim().length > 0 && value.trim().length <= 60 && !/[\u0000-\u001f\u007f]/u.test(value);
+}
+
+const server = createServer(async (req, res) => {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('X-Frame-Options', 'DENY');
+  const path = new URL(req.url, origin).pathname;
+  try {
+    if (!path.startsWith('/api/')) {
+      const asset = assets.get(path);
+      if (!asset || !['GET', 'HEAD'].includes(req.method)) return json(res, 404, { error: 'Page not found.' });
+      const body = await readFile(`${root}${asset[0]}`);
+      res.writeHead(200, { 'Content-Type': asset[1], 'Cache-Control': 'no-cache' });
+      return res.end(req.method === 'HEAD' ? undefined : body);
+    }
+    if (path === '/api/rewards/config' && req.method === 'GET') return json(res, 200, { clientId, configured: Boolean(clientId) });
+    const apiPaths = ['/api/rewards/challenge', '/api/rewards/verify-email', '/api/rewards/register'];
+    if (!apiPaths.includes(path)) return json(res, 404, { error: 'Endpoint not found.' });
+    if (req.method !== 'POST') { res.setHeader('Allow', 'POST'); return json(res, 405, { error: 'Use POST for this endpoint.' }); }
+    if (req.headers.origin !== origin) return json(res, 403, { error: 'Invalid request origin.' });
+    cleanState();
+    if (!rateLimit(req)) { res.setHeader('Retry-After', '60'); return json(res, 429, { error: 'Please wait a minute and try again.' }); }
+    if (!clientId) return json(res, 503, { error: 'Online sign-up is not available yet. Please try again soon.' });
+    let body;
+    try { body = await readJson(req); } catch { return json(res, 400, { error: 'Invalid request data.' }); }
+    const email = normalizeEmail(body.email);
+    if (!email) return json(res, 400, { error: 'Enter a valid email address.' });
+
+    if (path === '/api/rewards/challenge') {
+      const previous = cookieSession(req);
+      if (previous) sessions.delete(previous.id);
+      if (sessions.size >= 10000) return json(res, 503, { error: 'Sign-up is busy. Please try again shortly.' });
+      const id = randomBytes(32).toString('base64url');
+      const nonce = randomBytes(32).toString('base64url');
+      sessions.set(id, { nonce, email, expiresAt: Date.now() + 10 * 60000, attempts: 0 });
+      res.setHeader('Set-Cookie', `${cookieName}=${id}; Max-Age=600; ${cookieOptions}`);
+      return json(res, 200, { nonce });
+    }
+    const current = cookieSession(req);
+    if (!current || current.session.email !== email) return json(res, 401, { error: 'Your verification session expired. Please start again.' });
+    const { session, id } = current;
+    if (path === '/api/rewards/verify-email') {
+      if (session.verified || !session.nonce || ++session.attempts > 5) return json(res, 401, { error: 'Please start a new verification session.' });
+      // Consume the nonce before awaiting network I/O so concurrent requests cannot replay it.
+      const nonce = session.nonce;
+      session.nonce = null;
+      try {
+        const verified = await verifyEmailCredential(body.credential, { clientId, nonce, email });
+        if (sessions.get(id) !== session || session.expiresAt <= Date.now()) throw new Error('Session expired.');
+        session.verified = verified;
+        session.expiresAt = Math.min(session.expiresAt, verified.expiresAt);
+        return json(res, 200, { verified: true, email });
+      } catch (error) {
+        sessions.delete(id);
+        const message = error.message?.startsWith('Use the Google') || error.message?.startsWith('Please use a Gmail') ? error.message : 'We couldn’t verify your email. Please try again.';
+        return json(res, 401, { error: message });
+      }
+    }
+    if (!session.verified || session.verified.email !== email) return json(res, 403, { error: 'Verify your email before joining rewards.' });
+    if (!validName(body.firstName) || !validName(body.lastName) || body.terms !== true || typeof body.marketing !== 'boolean') {
+      return json(res, 400, { error: 'Enter your name and accept the Rewards Terms to continue.' });
+    }
+    const existing = db.prepare('SELECT id FROM rewards_members WHERE email = ? OR google_subject = ?').get(email, session.verified.subject);
+    if (existing) {
+      sessions.delete(id);
+      res.setHeader('Set-Cookie', `${cookieName}=; Max-Age=0; ${cookieOptions}`);
+      return json(res, 409, { error: 'You’re already one of our regulars! An account with this email or Google account exists.' });
+    }
+    const now = new Date().toISOString();
+    const memberId = randomUUID();
+    db.prepare(`INSERT INTO rewards_members (id, first_name, last_name, email, google_subject, email_verified_at, marketing_consent, terms_version, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(memberId, body.firstName.trim(), body.lastName.trim(), email, session.verified.subject, now, Number(body.marketing), '2026-11-11', now);
+    sessions.delete(id);
+    res.setHeader('Set-Cookie', `${cookieName}=; Max-Age=0; ${cookieOptions}`);
+    return json(res, 201, { member: { firstName: body.firstName.trim(), email, welcomeDrinkAvailable: true, points: 0 } });
+  } catch {
+    // Do not log tokens, email addresses, or database error details.
+    json(res, 500, { error: 'Something went wrong. Please try again shortly.' });
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
