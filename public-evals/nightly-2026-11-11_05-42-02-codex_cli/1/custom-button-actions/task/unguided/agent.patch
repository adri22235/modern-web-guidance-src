+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const toggleButtons = document.querySelectorAll('[data-toggle-class]');
+
+    toggleButtons.forEach((button) => {
+      button.addEventListener('click', () => {
+        const active = actionTarget.classList.toggle(button.dataset.toggleClass);
+        button.setAttribute('aria-pressed', String(active));
+      });
+    });
+
+    document.getElementById('reset-all').addEventListener('click', () => {
+      toggleButtons.forEach((button) => {
+        actionTarget.classList.remove(button.dataset.toggleClass);
+        button.setAttribute('aria-pressed', 'false');
+      });
+    });
+  </script>
