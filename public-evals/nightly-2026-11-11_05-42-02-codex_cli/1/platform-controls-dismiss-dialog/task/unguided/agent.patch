+  <script>
+    const coffeeDialog = document.querySelector('#coffee-dialog');
+    const coffeeButtons = Array.from(document.querySelectorAll('[data-coffee]'));
+    const coffeeStateKey = 'dailyGrindCoffee';
+
+    function syncCoffeeDialog() {
+      const button = coffeeButtons.find(button => button.dataset.coffee === history.state?.[coffeeStateKey]);
+      if (!button) {
+        if (coffeeDialog.open) coffeeDialog.close();
+        return;
+      }
+
+      const card = button.closest('.card');
+      document.querySelector('#coffee-title').textContent = card.querySelector('h3').textContent;
+      document.querySelector('#coffee-description').textContent = card.querySelector('p').textContent;
+      document.querySelector('#coffee-menu').href = button.dataset.menu;
+      if (!coffeeDialog.open) coffeeDialog.showModal();
+    }
+
+    coffeeButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        // A same-URL entry lets browser Back dismiss the dialog, including mobile gestures.
+        history.pushState({ ...history.state, [coffeeStateKey]: button.dataset.coffee }, '');
+        syncCoffeeDialog();
+      });
+    });
+
+    let dismissPending = false;
+    function dismissCoffeeDialog() {
+      if (dismissPending) return;
+      dismissPending = true;
+      history.back();
+    }
+
+    document.querySelector('#close-coffee').addEventListener('click', dismissCoffeeDialog);
+    coffeeDialog.addEventListener('cancel', event => {
+      // Keep Escape/platform dismissal and the browser history entry in sync.
+      event.preventDefault();
+      dismissCoffeeDialog();
+    });
+    window.addEventListener('popstate', () => {
+      dismissPending = false;
+      syncCoffeeDialog();
+    });
+    window.addEventListener('pageshow', syncCoffeeDialog);
+  </script>
