+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthOutput = document.getElementById('strength-value');
+    const strengthLabels = document.querySelectorAll('.strength-labels span');
+    const strengths = ['Mild', 'Medium', 'Bold', 'Extra Bold'];
+
+    function updateStrength() {
+      const index = Number(strengthSlider.value);
+      strengthSlider.style.setProperty('--progress', `${index / 3 * 100}%`);
+      strengthSlider.setAttribute('aria-valuetext', strengths[index]);
+      strengthOutput.textContent = strengths[index];
+      strengthLabels.forEach((label, labelIndex) => {
+        label.toggleAttribute('data-selected', labelIndex === index);
+      });
+    }
+
+    strengthSlider.addEventListener('input', updateStrength);
+    updateStrength();
+  </script>
