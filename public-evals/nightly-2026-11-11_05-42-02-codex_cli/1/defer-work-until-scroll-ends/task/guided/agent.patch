+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = Array.from(scroller.querySelectorAll('.bean'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollEndTimer;
+
+    function updateVisibleBean() {
+      // Read layout only after scrolling settles, then perform one text update.
+      const viewport = scroller.getBoundingClientRect();
+      let visibleIndex = 0;
+      let largestVisibleWidth = -1;
+
+      beans.forEach((bean, index) => {
+        const bounds = bean.getBoundingClientRect();
+        const visibleWidth = Math.max(0,
+          Math.min(bounds.right, viewport.right) - Math.max(bounds.left, viewport.left));
+        if (visibleWidth > largestVisibleWidth) {
+          largestVisibleWidth = visibleWidth;
+          visibleIndex = index;
+        }
+      });
+
+      status.textContent = `Viewing: ${beans[visibleIndex].dataset.bean} · ${visibleIndex + 1} of ${beans.length}`;
+      scrolling = false;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollEndTimer);
+        scrollEndTimer = setTimeout(() => {
+          scroller.dispatchEvent(new Event('scrollend'));
+        }, 150);
+      }
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', updateVisibleBean);
+  </script>
+
