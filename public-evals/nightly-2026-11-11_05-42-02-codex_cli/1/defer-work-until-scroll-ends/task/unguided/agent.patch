+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = Array.from(scroller.querySelectorAll('.bean'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let stopTimer;
+
+    function showVisibleBean() {
+      clearTimeout(stopTimer);
+      scrolling = false;
+      const viewport = scroller.getBoundingClientRect();
+      const center = viewport.left + scroller.clientLeft + scroller.clientWidth / 2;
+      let visibleIndex = 0;
+      let closestDistance = Infinity;
+
+      // Measure only after scrolling settles, keeping the scroll handler light.
+      beans.forEach((bean, index) => {
+        const rect = bean.getBoundingClientRect();
+        const distance = Math.abs(rect.left + rect.width / 2 - center);
+        if (distance < closestDistance) {
+          closestDistance = distance;
+          visibleIndex = index;
+        }
+      });
+
+      status.textContent = `Visible bean: ${beans[visibleIndex].dataset.bean} (${visibleIndex + 1} of ${beans.length})`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+      // Older browsers use a short quiet period in place of native scrollend.
+      if (!supportsScrollEnd) {
+        clearTimeout(stopTimer);
+        stopTimer = setTimeout(showVisibleBean, 150);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) {
+      scroller.addEventListener('scrollend', showVisibleBean);
+    }
+  </script>
+
