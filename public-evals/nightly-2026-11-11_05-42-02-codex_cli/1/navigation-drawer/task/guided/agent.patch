+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const closeButton = document.getElementById('drawer-close');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let opening = false;
+    let closing = false;
+    let hasBeenVisible = false;
+
+    openButton.addEventListener('click', async () => {
+      if (drawer.open) return;
+      opening = true;
+      closing = false;
+      hasBeenVisible = false;
+      drawer.showModal();
+      openButton.setAttribute('aria-expanded', 'true');
+
+      // Reset on every open, including browsers without scroll-initial-target.
+      scroller.scrollTo({ left: scroller.scrollWidth - scroller.clientWidth, behavior: 'instant' });
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      opening = false;
+      if (drawer.open && !closing) scroller.scrollTo({ left: 0, behavior: 'auto' });
+    });
+
+    function closeDrawer() {
+      if (!drawer.open) return;
+      closing = true;
+      const closedPosition = scroller.scrollWidth - scroller.clientWidth;
+      if (Math.abs(scroller.scrollLeft - closedPosition) < 1) {
+        drawer.close();
+      } else {
+        scroller.scrollTo({ left: closedPosition, behavior: 'auto' });
+      }
+    }
+
+    const observer = new IntersectionObserver(entries => {
+      if (!drawer.open || opening) return;
+      const entry = entries[entries.length - 1];
+      if (entry.intersectionRatio >= 0.001) hasBeenVisible = true;
+      if (entry.intersectionRatio < 0.001 && (hasBeenVisible || closing)) drawer.close();
+    }, { root: scroller, threshold: [0.001, 1] });
+    observer.observe(sheet);
+
+    closeButton.addEventListener('click', closeDrawer);
+    let pressedOutside = false;
+    drawer.addEventListener('pointerdown', event => {
+      pressedOutside = !sheet.contains(event.target);
+    });
+    drawer.addEventListener('click', event => {
+      if (pressedOutside && !sheet.contains(event.target)) closeDrawer();
+      pressedOutside = false;
+    });
+    drawer.addEventListener('cancel', event => {
+      if (event.cancelable) {
+        event.preventDefault();
+        closeDrawer();
+      }
+    });
+    drawer.addEventListener('close', () => {
+      openButton.setAttribute('aria-expanded', 'false');
+      opening = false;
+      closing = false;
+      hasBeenVisible = false;
+    });
+
+    if (!CSS.supports('animation-timeline: scroll()') || !CSS.supports('timeline-scope: --drawer-fade')) {
+      const updateBackdrop = () => {
+        const ratio = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, ratio)));
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+  </script>
