+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.navigation-drawer');
+    const panel = drawer.querySelector('.drawer-panel');
+    let closing = false;
+    let previousOverflow = '';
+    let swipeStart = null;
+
+    function closeDrawer() {
+      if (!drawer.open || closing) return;
+      closing = true;
+      swipeStart = null;
+      drawer.classList.remove('is-open');
+      menuButton.setAttribute('aria-expanded', 'false');
+      const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 240;
+      window.setTimeout(() => drawer.close(), delay);
+    }
+
+    menuButton.addEventListener('click', () => {
+      if (drawer.open) return;
+      previousOverflow = document.body.style.overflow;
+      document.body.style.overflow = 'hidden';
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Establish the offscreen position before starting the slide-in transition.
+      panel.getBoundingClientRect();
+      drawer.classList.add('is-open');
+    });
+
+    drawer.querySelector('.close-menu').addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', (event) => {
+      if (event.target === drawer || event.target.closest('a')) closeDrawer();
+    });
+    drawer.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDrawer();
+    });
+    drawer.addEventListener('close', () => {
+      document.body.style.overflow = previousOverflow;
+      drawer.classList.remove('is-open');
+      menuButton.setAttribute('aria-expanded', 'false');
+      closing = false;
+      menuButton.focus();
+    });
+
+    panel.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0) return;
+      swipeStart = { x: event.clientX, y: event.clientY, id: event.pointerId };
+    });
+    panel.addEventListener('pointermove', (event) => {
+      if (!swipeStart || event.pointerId !== swipeStart.id) return;
+      const dx = event.clientX - swipeStart.x;
+      const dy = event.clientY - swipeStart.y;
+      if (dx > 12 && dx > Math.abs(dy) * 1.5) {
+        panel.setPointerCapture(event.pointerId);
+      }
+    });
+    panel.addEventListener('pointerup', (event) => {
+      if (!swipeStart || event.pointerId !== swipeStart.id) return;
+      const dx = event.clientX - swipeStart.x;
+      const dy = event.clientY - swipeStart.y;
+      swipeStart = null;
+      if (dx > 60 && dx > Math.abs(dy) * 1.5) closeDrawer();
+    });
+    panel.addEventListener('pointercancel', () => { swipeStart = null; });
+  </script>
