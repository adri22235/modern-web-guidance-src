+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+      var pending = false;
+
+      function update() {
+        pending = false;
+        if (motion && motion.matches) {
+          nav.style.paddingTop = '';
+          nav.style.paddingBottom = '';
+          logo.style.fontSize = '';
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(scrollTop / 160, 1));
+        var padding = (1 - 0.45 * progress) + 'rem';
+        nav.style.paddingTop = padding;
+        nav.style.paddingBottom = padding;
+        logo.style.fontSize = (1.5 - 0.3 * progress) + 'rem';
+      }
+
+      function scheduleUpdate() {
+        if (!pending) {
+          pending = true;
+          requestFrame.call(window, update);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, false);
+      window.addEventListener('pageshow', scheduleUpdate, false);
+      if (motion) {
+        if (motion.addEventListener) motion.addEventListener('change', scheduleUpdate);
+        else if (motion.addListener) motion.addListener(scheduleUpdate);
+      }
+      update();
