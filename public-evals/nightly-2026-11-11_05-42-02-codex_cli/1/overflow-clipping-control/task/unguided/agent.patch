+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: 1.25fr 1fr;
+      gap: 24px;
+      align-items: stretch;
+    }
+
+    .nested-curve-parent {
+      --card-radius: 28px;
+      --card-padding: 12px;
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      background: #e9dfd5;
+    }
+
+    .nested-curve-content {
+      height: 100%;
+      overflow: hidden;
+      border-radius: max(0px, calc(var(--card-radius) - var(--card-padding)));
+      background: white;
+    }
+
+    .nested-curve-content img {
+      display: block;
+      width: 100%;
+      height: 190px;
+      object-fit: cover;
+      object-position: center 55%;
+    }
+
+    .roast-copy {
+      padding: 22px 24px;
+    }
+
+    .roast-copy .eyebrow {
+      color: #8c6250;
+      margin-bottom: 6px;
+    }
+
+    .roast-copy h3,
+    .promo-copy h3 {
+      font-size: 1.6rem;
+      line-height: 1.25;
+      margin-bottom: 10px;
+    }
+
+    .roast-copy p:last-child {
+      color: #78655d;
+      font-size: 0.9rem;
+    }
+
+    .safety-zone-parent {
+      padding: 36px;
+      border-radius: 28px;
+      background: #3e2b25;
+      color: #fff8ee;
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      justify-content: center;
+      min-width: 0;
+      /* Keep the button's shadow outside the text clipping boundary. */
+      overflow: visible;
+    }
+
+    .promo-copy {
+      width: 100%;
+      min-width: 0;
+      overflow: hidden;
+      overflow-wrap: anywhere;
+    }
+
+    .promo-copy .eyebrow {
+      color: #e7b47c;
+      margin-bottom: 20px;
+    }
+
+    .promo-copy > p:last-child {
+      color: #d9c5b9;
+      font-size: 0.9rem;
+    }
+
+    .safety-zone-parent .promo-button {
+      background: var(--accent);
+      color: #3e2723;
+      font-weight: 700;
+      margin-top: 28px;
+      border-radius: 999px;
+      box-shadow: 0 0 28px 7px rgba(255, 171, 64, 0.3);
+    }
+
+    .safety-zone-parent .promo-button:hover {
+      background: #ffc36e;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid #fff8ee;
+      outline-offset: 5px;
+    }
+
+    @media (max-width: 640px) {
+      .showcase-grid {
+        grid-template-columns: 1fr;
+      }
+
+      .safety-zone-parent {
+        padding: 28px;
+      }
+    }
