+    /* Showcase */
+    .showcase {
+      margin-block-end: 56px;
+    }
+
+    .showcase > h2 {
+      text-align: center;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
+      gap: 32px;
+      align-items: center;
+      margin-block-start: 24px;
+    }
+
+    .nested-curve-parent {
+      --curve: 32px;
+      --inset: 16px;
+      min-inline-size: 0;
+      padding: var(--inset);
+      border-radius: var(--curve);
+      background: var(--secondary);
+      overflow: hidden;
+    }
+
+    /* Keep the inner curve in browsers without content-box clip margins. */
+    .nested-curve-content {
+      border-radius: calc(var(--curve) - var(--inset));
+      overflow: hidden;
+    }
+
+    .nested-curve-content img {
+      display: block;
+      inline-size: 100%;
+      block-size: 180px;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      padding: 20px;
+      color: white;
+      background: var(--primary);
+    }
+
+    .nested-curve-footer p {
+      margin-block-start: 6px;
+    }
+
+    .safety-zone-parent {
+      min-inline-size: 0;
+      padding: 28px 28px 0;
+      border-radius: 24px;
+      background: #f3e9df;
+      /* Text clips independently so the button glow survives the fallback. */
+      overflow: visible;
+    }
+
+    .promo-eyebrow {
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+      margin-block-end: 8px;
+    }
+
+    .safety-zone-parent h3 {
+      font-size: 1.65rem;
+      line-height: 1.25;
+    }
+
+    .promo-copy {
+      margin-block-start: 12px;
+      overflow: hidden;
+      white-space: nowrap;
+      text-overflow: ellipsis;
+    }
+
+    .promo-button {
+      display: block;
+      inline-size: 100%;
+      margin-block-start: 24px;
+      padding: 14px 20px;
+      border: 0;
+      border-radius: 12px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      font-weight: 600;
+      cursor: pointer;
+      box-shadow: 0 0 16px 3px rgba(255, 171, 64, 0.65);
+    }
+
+    .promo-button:hover {
+      background: var(--text);
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+
+      .nested-curve-content {
+        border-radius: 0;
+        overflow: visible;
+      }
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: 32px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 32px;
+      }
+    }
+
