+  <script>
+    // Native text fitting handles layout where available; measure forced lines elsewhere.
+    if (!CSS.supports('text-fit', 'grow per-line-all 1000%')) {
+      const lockup = document.querySelector('.hero-lockup');
+      const lines = [...lockup.children];
+      const fit = () => {
+        for (const line of lines) line.style.removeProperty('--text-fit-scale');
+        const width = lockup.getBoundingClientRect().width;
+        const scales = lines.map(line => width / line.getBoundingClientRect().width);
+        lines.forEach((line, index) => {
+          line.style.setProperty('--text-fit-scale', scales[index]);
+        });
+      };
+
+      // Ignore height-only changes caused by fitting the lines themselves.
+      let previousWidth;
+      new ResizeObserver(([entry]) => {
+        if (entry.contentRect.width !== previousWidth) {
+          previousWidth = entry.contentRect.width;
+          fit();
+        }
+      }).observe(lockup);
+      fit();
+      document.fonts.ready.then(fit);
+      document.fonts.addEventListener('loadingdone', fit);
+    }
+  </script>
