+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+
+    function fitHeroLines() {
+      const width = heroHeading.clientWidth;
+      if (!width) return;
+
+      for (const line of heroHeading.children) {
+        // Measure the rendered font and change its size, keeping natural spacing.
+        const fontSize = parseFloat(getComputedStyle(line).fontSize);
+        const lineWidth = line.getBoundingClientRect().width;
+        if (lineWidth) line.style.fontSize = `${fontSize * width / lineWidth}px`;
+      }
+    }
+
+    let headingWidth = 0;
+    new ResizeObserver(([entry]) => {
+      if (entry.contentRect.width !== headingWidth) {
+        headingWidth = entry.contentRect.width;
+        fitHeroLines();
+      }
+    }).observe(heroHeading);
+
+    fitHeroLines();
+    document.fonts.ready.then(fitHeroLines);
+  </script>
 </body>
 
