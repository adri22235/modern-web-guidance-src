+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-error');
+    const signupStatus = document.getElementById('mailing-list-status');
+    const announcer = document.getElementById('mailing-list-announcer');
+    let announceTimer;
+
+    // Match the browser's interaction state, rather than flagging untouched required fields.
+    function syncEmailError(announce = false) {
+      const invalid = email.matches(':user-invalid');
+      const wasInvalid = email.getAttribute('aria-invalid') === 'true';
+      emailError.textContent = email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address, such as you@example.com.';
+      email.setAttribute('aria-invalid', String(invalid));
+      if (invalid) email.setAttribute('aria-describedby', emailError.id);
+      else email.removeAttribute('aria-describedby');
+
+      if (!invalid) {
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+      }
+      if (invalid && announce && !wasInvalid) {
+        clearTimeout(announceTimer);
+        announcer.textContent = '';
+        announceTimer = setTimeout(() => {
+          announcer.textContent = emailError.textContent;
+        }, 500);
+      }
+    }
+
+    email.addEventListener('blur', () => syncEmailError(true));
+    email.addEventListener('change', () => syncEmailError(true));
+    email.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      syncEmailError();
+    });
+    email.addEventListener('invalid', () => {
+      clearTimeout(announceTimer);
+      announcer.textContent = '';
+      syncEmailError();
+      // Recheck after the browser finishes updating submission validation state.
+      requestAnimationFrame(() => syncEmailError());
+    });
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncEmailError();
+      signupStatus.textContent = 'Mailing list sign-ups are not available yet. Please try again later.';
+    });
+    mailingList.addEventListener('reset', () => {
+      clearTimeout(announceTimer);
+      announcer.textContent = '';
+      signupStatus.textContent = '';
+      setTimeout(() => syncEmailError(), 0);
+    });
+  </script>
+
 </body>
 
