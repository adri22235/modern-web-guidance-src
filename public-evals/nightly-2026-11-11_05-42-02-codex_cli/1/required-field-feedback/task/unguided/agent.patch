@@ -206,7 +268,57 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingForm = document.querySelector('.mailing-list');
+    const emailInput = mailingForm.elements.email;
+    const emailError = document.getElementById('mailing-email-error');
+    const signupStatus = mailingForm.querySelector('.signup-status');
+    let emailTouched = false;
+    let submitAttempted = false;
+
+    function validateEmail() {
+      let message = '';
+      if (emailTouched || submitAttempted) {
+        if (emailInput.validity.valueMissing) {
+          message = 'Please enter your email address.';
+        } else if (emailInput.validity.typeMismatch) {
+          message = 'Please enter a valid email address.';
+        }
+      }
+      emailError.textContent = message;
+      emailError.hidden = !message;
+      if (message) {
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+      return emailInput.validity.valid;
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailTouched = true;
+      validateEmail();
+    });
+
+    emailInput.addEventListener('input', () => {
+      signupStatus.hidden = true;
+      validateEmail();
+    });
+
+    mailingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      submitAttempted = true;
+      signupStatus.hidden = true;
+      if (!validateEmail()) {
+        emailInput.focus();
+        return;
+      }
+      signupStatus.textContent = 'Online signup is not available yet. Please contact us to join our mailing list.';
+      signupStatus.hidden = false;
+    });
+  </script>
+
 </body>
 
 </html>
