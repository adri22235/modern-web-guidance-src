@@ -197,8 +249,18 @@
     </section>
   </main>
 
   <footer>
+    <form class="mailing-list" novalidate>
+      <h2>Join our mailing list</h2>
+      <p>Stay in the loop with fresh coffee news and seasonal favorites.</p>
+      <label for="mailing-email">Email address (required)</label>
+      <input id="mailing-email" name="email" type="email" autocomplete="email" required
+        aria-describedby="mailing-email-error">
+      <p id="mailing-email-error" class="field-error" aria-live="polite" hidden></p>
