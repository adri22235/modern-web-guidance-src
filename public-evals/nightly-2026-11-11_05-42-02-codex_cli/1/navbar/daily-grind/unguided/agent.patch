+  <script>
+    const navigation = document.querySelector('.site-nav');
+    const navToggle = navigation.querySelector('.nav-toggle');
+    const navList = navigation.querySelector('.nav-list');
+    const submenuToggle = navigation.querySelector('.submenu-toggle');
+    const submenu = navigation.querySelector('.submenu');
+    const menuItem = navigation.querySelector('.menu-item');
+    const mobileViewport = window.matchMedia('(max-width: 64rem)');
+
+    function setSubmenu(open) {
+      submenuToggle.setAttribute('aria-expanded', String(open));
+      submenu.hidden = !open;
+    }
+
+    function setNavigation(open) {
+      navToggle.setAttribute('aria-expanded', String(open));
+      navList.classList.toggle('is-open', open);
+      if (!open) setSubmenu(false);
+    }
+
+    navToggle.addEventListener('click', () => {
+      setNavigation(navToggle.getAttribute('aria-expanded') !== 'true');
+    });
+    submenuToggle.addEventListener('click', () => setSubmenu(submenu.hidden));
+
+    document.addEventListener('click', (event) => {
+      if (!menuItem.contains(event.target)) setSubmenu(false);
+      if (!navigation.contains(event.target)) setNavigation(false);
+    });
+    navigation.addEventListener('keydown', (event) => {
+      if (event.key !== 'Escape') return;
+      if (!submenu.hidden) {
+        setSubmenu(false);
+        submenuToggle.focus();
+      } else if (mobileViewport.matches && navList.classList.contains('is-open')) {
+        setNavigation(false);
+        navToggle.focus();
+      }
+    });
+    navigation.addEventListener('focusout', (event) => {
+      if (!navigation.contains(event.relatedTarget)) setNavigation(false);
+      else if (!menuItem.contains(event.relatedTarget)) setSubmenu(false);
+    });
+    mobileViewport.addEventListener('change', () => {
+      const focusWillHide = mobileViewport.matches && navList.contains(document.activeElement);
+      setNavigation(false);
+      if (focusWillHide) navToggle.focus();
+    });
+
+    const normalizePath = (path) => path.replace(/\/+$/, '') || '/';
+    const currentPath = normalizePath(window.location.pathname);
+    navigation.querySelectorAll('a[href]').forEach((link) => {
+      const linkPath = normalizePath(new URL(link.href).pathname);
+      if (linkPath === currentPath) link.setAttribute('aria-current', 'page');
+      if (linkPath !== '/' && currentPath.startsWith(linkPath + '/')) {
+        link.classList.add('is-active');
+      }
+    });
+  </script>
