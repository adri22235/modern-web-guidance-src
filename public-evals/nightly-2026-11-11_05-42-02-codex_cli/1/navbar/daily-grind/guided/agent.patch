+  <script>
+    (() => {
+      const header = document.querySelector('.site-header');
+      const inner = header.querySelector('.header-inner');
+      const menu = document.querySelector('#site-menu');
+      const menuButton = header.querySelector('.menu-button');
+      const submenu = document.querySelector('#menu-categories');
+      const trigger = header.querySelector('.submenu-button');
+      const dropdown = header.querySelector('.nav-dropdown');
+      const nativePopover = 'popover' in HTMLElement.prototype;
+      let wide = false;
+      let lastWidth = -1;
+      let layoutInitialized = false;
+      let preview = false;
+
+      const isOpen = (list) => nativePopover
+        ? list.matches(':popover-open') : list.classList.contains('fallback-open');
+      function setOpen(list, button, open) {
+        if (nativePopover) {
+          if (open && !isOpen(list)) list.showPopover({ source: button });
+          if (!open && isOpen(list)) list.hidePopover();
+        } else {
+          list.hidden = !open;
+          list.classList.toggle('fallback-open', open);
+          button.setAttribute('aria-expanded', String(open));
+        }
+      }
+
+      function positionSubmenu() {
+        if (!wide || !isOpen(submenu)) return;
+        if (nativePopover && CSS.supports('position-area', 'block-end')) return;
+        const rect = trigger.getBoundingClientRect();
+        const size = submenu.getBoundingClientRect();
+        const top = rect.bottom + size.height + 8 > innerHeight
+          ? Math.max(8, rect.top - size.height - 8) : rect.bottom + 8;
+        submenu.style.top = `${top}px`;
+        submenu.style.left = `${Math.max(8, Math.min(rect.left, innerWidth - size.width - 8))}px`;
+      }
+
+      function updateLayout() {
+        const width = inner.clientWidth;
+        header.style.setProperty('--nav-bottom', `${header.getBoundingClientRect().bottom}px`);
+        if (!wide && width <= lastWidth) return;
+        lastWidth = width;
+        const menuWasOpen = !wide && isOpen(menu);
+        const focused = document.activeElement;
+        header.classList.add('is-measuring', 'is-wide');
+        // The floating submenu must never contribute to the row's measured width.
+        if (nativePopover) menu.removeAttribute('popover');
+        else menu.hidden = false;
+        const nextWide = inner.scrollWidth <= width;
+        header.classList.toggle('is-wide', nextWide);
+        if (!layoutInitialized || nextWide !== wide) {
+          if (nativePopover && submenu.hasAttribute('popover') && isOpen(submenu)) submenu.hidePopover();
+          submenu.classList.remove('fallback-open');
+          submenu.style.removeProperty('top');
+          submenu.style.removeProperty('left');
+          if (nextWide && nativePopover) submenu.setAttribute('popover', 'auto');
+          else submenu.removeAttribute('popover');
+          submenu.hidden = !nextWide || !nativePopover;
+          trigger.setAttribute('aria-expanded', 'false');
+          preview = false;
+        }
+        layoutInitialized = true;
+        wide = nextWide;
+        if (!wide) {
+          if (nativePopover) menu.setAttribute('popover', 'auto');
+          else menu.hidden = true;
+          if (menuWasOpen) setOpen(menu, menuButton, true);
+          else if (menu.contains(focused)) menuButton.focus();
+        } else if (submenu.contains(focused) && trigger.getAttribute('aria-expanded') === 'false') {
+          trigger.focus();
+        } else if (focused === menuButton) {
+          header.querySelector('.menu-link').focus();
+        }
+        menuButton.setAttribute('aria-expanded', String(!wide && isOpen(menu)));
+        requestAnimationFrame(() => header.classList.remove('is-measuring'));
+        positionSubmenu();
+      }
+
+      menu.addEventListener('toggle', () => {
+        menuButton.setAttribute('aria-expanded', String(!wide && isOpen(menu)));
+      });
+      submenu.addEventListener('toggle', () => {
+        trigger.setAttribute('aria-expanded', String(isOpen(submenu)));
+        if (!isOpen(submenu)) preview = false;
+        positionSubmenu();
+      });
+      menuButton.addEventListener('click', () => {
+        if (!nativePopover) setOpen(menu, menuButton, !isOpen(menu));
+      });
+      trigger.addEventListener('click', (event) => {
+        if (!wide) {
+          submenu.hidden = !submenu.hidden;
+          trigger.setAttribute('aria-expanded', String(!submenu.hidden));
+        } else if (preview) {
+          event.preventDefault();
+          preview = false;
+        } else if (!nativePopover) {
+          setOpen(submenu, trigger, !isOpen(submenu));
+          positionSubmenu();
+        }
+      });
+      dropdown.addEventListener('pointerenter', (event) => {
+        if (!wide || event.pointerType === 'touch' || !matchMedia('(hover: hover)').matches || isOpen(submenu)) return;
+        preview = true;
+        setOpen(submenu, trigger, true);
+        positionSubmenu();
+      });
+      dropdown.addEventListener('pointerleave', () => {
+        if (wide && preview) setOpen(submenu, trigger, false);
+        preview = false;
+      });
+      dropdown.addEventListener('focusout', (event) => {
+        if (wide && event.relatedTarget && !dropdown.contains(event.relatedTarget)) {
+          setOpen(submenu, trigger, false);
+        }
+      });
+      // Older browsers get a small disclosure fallback; native popovers own dismissal otherwise.
+      if (!nativePopover) {
+        menu.removeAttribute('popover');
+        document.addEventListener('click', (event) => {
+          if (!header.contains(event.target)) {
+            if (!wide) setOpen(menu, menuButton, false);
+            else setOpen(submenu, trigger, false);
+          }
+        });
+        header.addEventListener('keydown', (event) => {
+          if (event.key !== 'Escape') return;
+          const button = wide ? trigger : menuButton;
+          const list = wide ? submenu : menu;
+          if (isOpen(list)) {
+            setOpen(list, button, false);
+            button.focus();
+          }
+        });
+      }
+
+      const normalizePath = (path) => path.replace(/\/index\.html$/, '/').replace(/\/+$/, '') || '/';
+      const path = normalizePath(location.pathname);
+      header.querySelectorAll('a[href]').forEach((link) => {
+        if (normalizePath(new URL(link.href).pathname) === path) link.setAttribute('aria-current', 'page');
+      });
+      header.querySelector('.menu-link').classList.toggle('is-current-section', path.startsWith('/menu/'));
+      updateLayout();
+      const observer = new ResizeObserver(updateLayout);
+      observer.observe(inner);
+      observer.observe(menu);
+      window.addEventListener('scroll', positionSubmenu, { passive: true });
+    })();
+  </script>
