+    /* Loyalty Rewards */
+    .rewards {
+      padding: 28px 24px;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 8px;
+      background: #fffaf3;
+      text-align: center;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+    }
+
+    .rewards-intro {
+      margin-top: 4px;
+      font-size: 0.9rem;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      margin: 24px auto;
+      width: 190px;
+      height: 190px;
+    }
+
+    progress.progress-ring {
+      /* Sample balance: keep this fallback percentage in sync with value/max. */
+      --value: 70;
+      --thickness: 12px;
+      --fill-color: var(--primary);
+      --track-color: var(--secondary);
+      appearance: none;
+      display: block;
+      width: 100%;
+      height: 100%;
+      border-radius: 50%;
+      border: var(--thickness) solid transparent;
+      background: conic-gradient(var(--fill-color) calc(var(--value) * 1%), var(--track-color) 0);
+      background-clip: border-area;
+      background-origin: border-box;
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    @supports (width: attr(value type(<number>))) {
+      progress.progress-ring {
+        --value: calc(attr(value type(<number>)) / attr(max type(<number>)) * 100);
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(circle closest-side, transparent calc(100% - var(--thickness)), black calc(100% - var(--thickness) + 0.5px));
+      }
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      display: grid;
+      line-height: 1.4;
+    }
+
+    .progress-ring-content strong {
+      font-size: 2.5rem;
+      color: var(--primary);
+    }
+
+    .progress-ring-content span {
+      font-size: 0.85rem;
+    }
+
+    .rewards-note {
+      margin-top: 8px;
+      font-size: 0.85rem;
+    }
+
+    @media (forced-colors: active) {
+      progress.progress-ring {
+        forced-color-adjust: none;
+        --fill-color: CanvasText;
+        --track-color: Canvas;
+      }
+    }
+
+    @media (max-width: 1000px) {
+      .container {
+        grid-template-columns: minmax(0, 1fr);
+      }
+    }
+
