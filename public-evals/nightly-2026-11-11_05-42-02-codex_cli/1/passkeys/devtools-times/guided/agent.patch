+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { ApiError, authRequest, authenticatePasskey, passkeyCapabilities, passkeyError, registerPasskey, syncPasskeys, syncProfile, type AccountDetails, type PasskeyCapabilities } from '../utils/passkeys';
+
+const button = 'rounded-md bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900';
+const secondary = 'rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900';
+const input = 'w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-700';
+type Action = { type: 'add' } | { type: 'rename'; id: string; name: string } | { type: 'delete'; id: string } | { type: 'profile'; displayName: string };
+const date = (value: number) => new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+
+export default function AccountSettings() {
+  const [account, setAccount] = useState<AccountDetails | null>(null);
+  const [capabilities, setCapabilities] = useState<PasskeyCapabilities | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [editing, setEditing] = useState('');
+  const [nickname, setNickname] = useState('');
+  const [removing, setRemoving] = useState('');
+  const [pending, setPending] = useState<Action | null>(null);
+  const [password, setPassword] = useState('');
+  const verifiedUntil = useRef(0);
+  const controller = useRef<AbortController | null>(null);
+  const verificationPanel = useRef<HTMLHeadingElement | null>(null);
+
+  useEffect(() => {
+    const request = new AbortController();
+    controller.current = request;
+    authRequest<AccountDetails>('account', undefined, 'GET', request.signal).then(data => {
+      setAccount(data); setDisplayName(data.displayName);
+      void syncPasskeys(data);
+    }).catch(error => {
+      if (!request.signal.aborted) setError(passkeyError(error));
+    }).finally(() => { if (!request.signal.aborted) setLoading(false); });
+    passkeyCapabilities().then(setCapabilities).catch(() => setCapabilities({ supported: false, create: false, conditional: false }));
+    return () => { controller.current?.abort(); };
+  }, []);
+
+  useEffect(() => { if (pending) verificationPanel.current?.focus(); }, [pending]);
+
+  function newRequest() {
+    controller.current?.abort();
+    controller.current = new AbortController();
+    return controller.current;
+  }
+
+  async function perform(action: Action) {
+    const request = newRequest();
+    setBusy(true); setError(''); setMessage('');
+    try {
+      let updated: AccountDetails;
+      if (action.type === 'add') {
+        await registerPasskey(false, request.signal);
+        updated = await authRequest<AccountDetails>('account', undefined, 'GET', request.signal);
+        setMessage('Passkey added. You can use it the next time you sign in.');
+      } else if (action.type === 'profile') {
+        updated = await authRequest<AccountDetails>('profile', { displayName: action.displayName }, 'PUT', request.signal);
+        await syncProfile(updated);
+        setMessage('Display name updated.');
+      } else {
+        updated = await authRequest<AccountDetails>(`credentials/${encodeURIComponent(action.id)}`, action.type === 'rename' ? { name: action.name } : {}, action.type === 'rename' ? 'PUT' : 'DELETE', request.signal);
+        setMessage(action.type === 'rename' ? 'Passkey renamed.' : 'Passkey removed. Delete its saved copy from your password manager if it still appears there.');
+      }
+      setAccount(updated); setEditing(''); setRemoving('');
+      await syncPasskeys(updated);
+    } catch (error) {
+      if (error instanceof ApiError && error.status === 403) {
+        verifiedUntil.current = 0; setPending(action);
+      }
+      if (!request.signal.aborted) setError(passkeyError(error));
+    } finally { if (!request.signal.aborted) setBusy(false); }
+  }
+
+  function requestAction(action: Action) {
+    setError(''); setMessage('');
+    if (Date.now() < verifiedUntil.current) void perform(action);
+    else setPending(action);
+  }
+
+  async function verify(method: 'passkey' | 'password', event?: FormEvent) {
+    event?.preventDefault();
+    if (!pending) return;
+    const action = pending;
+    const request = newRequest();
+    setBusy(true); setError('');
+    try {
+      if (method === 'passkey') await authenticatePasskey(request.signal, 'reauth');
+      else await authRequest('reauth/password', { password }, 'POST', request.signal);
+      if (request.signal.aborted) return;
+      verifiedUntil.current = Date.now() + 5 * 60 * 1000;
+      setPassword(''); setPending(null);
+      await perform(action);
+    } catch (error) { if (!request.signal.aborted) setError(passkeyError(error)); }
+    finally { if (controller.current === request && !request.signal.aborted) setBusy(false); }
+  }
+
+  function cancelVerification() {
+    controller.current?.abort(); setPending(null); setPassword(''); setBusy(false); setError('');
+  }
+
+  async function signOut() {
+    setBusy(true); setError('');
+    try {
+      await authRequest('logout');
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    } catch (error) { setError(passkeyError(error)); setBusy(false); }
+  }
+
+  return <div className="mx-auto max-w-2xl space-y-6">
+    <div className="flex flex-wrap items-center justify-between gap-3">
+      <div><h1 className="text-3xl font-bold text-gray-900">Account settings</h1><p className="mt-2 text-sm text-gray-600">Manage your profile and how you sign in.</p></div>
+      {account && <button type="button" onClick={signOut} disabled={busy || Boolean(pending)} className={secondary}>Sign out</button>}
+    </div>
+    {error && <p role="alert" className="rounded-md bg-red-50 p-4 text-sm text-red-800">{error}</p>}
+    <div role="status" aria-live="polite">{loading ? <p className="text-gray-600">Loading your account…</p> : busy ? <p className="text-sm text-gray-600">Completing your request. Check your device for a passkey prompt…</p> : message ? <p className="rounded-md bg-green-50 p-4 text-sm text-green-800">{message}</p> : null}</div>
+    {!loading && !account && <p className="text-sm"><a className="font-semibold underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in to manage your account</a>, or <button type="button" className="underline" onClick={() => window.location.reload()}>try again</button>.</p>}
+    {pending && <section className="rounded-lg border-2 border-gray-700 bg-gray-50 p-6" aria-labelledby="verify-title">
+      <h2 id="verify-title" ref={verificationPanel} tabIndex={-1} className="text-lg font-semibold">Verify it’s you</h2>
+      <p className="mt-2 text-sm text-gray-600">Confirm your identity to {pending.type === 'delete' ? 'remove this passkey' : pending.type === 'add' ? 'add a passkey' : pending.type === 'rename' ? 'rename this passkey' : 'update your profile'}. Verification lasts for five minutes.</p>
+      {capabilities?.supported && Boolean(account?.credentials.length) && <button type="button" className={`${button} mt-4`} onClick={() => verify('passkey')} disabled={busy}>Verify with a passkey</button>}
+      <form onSubmit={event => verify('password', event)} className="mt-4 space-y-3">
+        <input type="text" name="username" value={account?.username || ''} autoComplete="username" readOnly className="sr-only" tabIndex={-1} aria-label="Username" />
+        <label htmlFor="verify-password" className="block text-sm font-medium">Or verify with your password</label>
+        <input id="verify-password" name="password" type="password" autoComplete="current-password" value={password} onChange={event => setPassword(event.target.value)} required maxLength={1024} disabled={busy} className={input} />
+        <div className="flex flex-wrap gap-3"><button type="submit" className={button} disabled={busy}>{busy ? 'Please wait…' : 'Verify with password'}</button><button type="button" className={secondary} onClick={cancelVerification}>Cancel</button></div>
+      </form>
+    </section>}
+    {account && <fieldset disabled={busy || Boolean(pending)} className="min-w-0 space-y-6 disabled:opacity-60">
+      <legend className="sr-only">Profile and sign-in settings</legend>
+      <section className="rounded-lg border border-gray-200 bg-white p-6" aria-labelledby="profile-title">
+        <h2 id="profile-title" className="text-xl font-semibold">Profile</h2>
+        <p className="mt-2 break-words text-sm text-gray-600">Signed in as <strong>{account.username}</strong></p>
+        <form className="mt-4 space-y-3" onSubmit={event => { event.preventDefault(); requestAction({ type: 'profile', displayName }); }}>
+          <label htmlFor="display-name" className="block text-sm font-medium">Display name</label>
+          <input id="display-name" autoComplete="nickname" value={displayName} onChange={event => setDisplayName(event.target.value)} required maxLength={80} className={input} />
+          <button type="submit" className={secondary} disabled={displayName.trim() === account.displayName}>Save display name</button>
+        </form>
+      </section>
+      <section className="rounded-lg border border-gray-200 bg-white p-6" aria-labelledby="passkeys-title">
+        <div className="flex flex-wrap items-center justify-between gap-3"><h2 id="passkeys-title" className="text-xl font-semibold">Passkeys</h2>{capabilities?.create && <button type="button" className={button} onClick={() => requestAction({ type: 'add' })}>Add a passkey</button>}</div>
+        <p className="mt-3 text-sm text-gray-600">Sign in with your fingerprint, face, device PIN, or a security key. You can add passkeys from more than one device or password manager.</p>
+        {capabilities && !capabilities.create && <p className="mt-3 rounded-md bg-gray-50 p-3 text-sm text-gray-600">Passkey creation isn’t supported on this device. You can still manage existing passkeys and sign in with your password.</p>}
+        {!account.credentials.length ? <div className="mt-5 rounded-md border border-dashed border-gray-300 p-5 text-center"><p className="font-medium">No passkeys yet</p><p className="mt-1 text-sm text-gray-600">Add your first passkey for a faster sign-in without typing a password.</p></div> : <ul className="mt-5 divide-y divide-gray-200">
+          {account.credentials.map(key => <li key={key.id} className="py-4">
+            <div className="flex items-start gap-3">
+              {key.provider?.icon ? <img src={key.provider.icon} width={24} height={24} alt="" className="mt-1 size-6 shrink-0" /> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" className="mt-1 size-6 shrink-0 text-gray-600" aria-hidden="true"><circle cx="8" cy="9" r="4" /><path d="m11 12 9 9m-3-3 3-3m-6 0 3-3" /></svg>}
+              <div className="min-w-0 flex-1"><h3 className="break-words font-semibold">{key.name}</h3><p className="mt-1 text-xs text-gray-600">{key.provider?.name || 'Unknown passkey provider'} · {key.backedUp ? 'Synced' : key.deviceType === 'singleDevice' ? 'Device-bound' : 'Not backed up'}</p><p className="mt-1 text-xs text-gray-600">Added {date(key.registeredAt)} · {key.lastUsedAt ? `Last used ${date(key.lastUsedAt)}` : 'Not used to sign in yet'}</p></div>
+            </div>
+            {editing === key.id ? <form className="mt-3 space-y-3" onSubmit={event => { event.preventDefault(); requestAction({ type: 'rename', id: key.id, name: nickname }); }}>
+              <label htmlFor={`name-${key.id}`} className="block text-sm font-medium">Passkey name</label>
+              <input id={`name-${key.id}`} value={nickname} onChange={event => setNickname(event.target.value)} required maxLength={80} className={input} />
+              <div className="flex gap-2"><button type="submit" className={button}>Save name</button><button type="button" className={secondary} onClick={() => setEditing('')}>Cancel</button></div>
+            </form> : removing === key.id ? <div className="mt-3 rounded-md border border-red-200 bg-red-50 p-3">
+              <p className="text-sm text-red-900">Remove “{key.name}”? It will no longer sign you in.{account.credentials.length === 1 ? ' This is your last passkey. You can still sign in with your password.' : ''}</p>
+              <div className="mt-3 flex flex-wrap gap-2"><button type="button" className={`${button} bg-red-700 hover:bg-red-800`} onClick={() => requestAction({ type: 'delete', id: key.id })}>Remove passkey</button><button type="button" className={secondary} onClick={() => setRemoving('')}>Keep passkey</button></div>
+            </div> : <div className="mt-3 flex gap-2"><button type="button" className={secondary} aria-label={`Rename ${key.name}`} onClick={() => { setEditing(key.id); setNickname(key.name); setRemoving(''); }}>Rename</button><button type="button" className={`${secondary} text-red-700`} aria-label={`Remove ${key.name}`} onClick={() => { setRemoving(key.id); setEditing(''); }}>Remove</button></div>}
+          </li>)}
+        </ul>}
+      </section>
+      <p className="text-sm text-gray-600">Keep access to your password or another passkey in case you lose a device. Removing a passkey here may also require deleting its copy in your password manager.</p>
+    </fieldset>}
+  </div>;
+}
