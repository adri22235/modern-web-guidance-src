+import providers from './passkey-providers.json';
+
+// Provider metadata is a display hint only, never an input to authorization.
+// Source: passkeydeveloper/passkey-authenticator-aaguids (see README).
+export function passkeyProvider(aaguid: string) {
+  if (aaguid === '00000000-0000-0000-0000-000000000000') return undefined;
+  return (providers as Record<string, { name: string; icon: string }>)[aaguid];
+}
