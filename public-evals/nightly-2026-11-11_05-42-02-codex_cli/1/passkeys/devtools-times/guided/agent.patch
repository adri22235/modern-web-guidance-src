+            <input id="username" name="username" type="text" value={username} onChange={event => setUsername(event.target.value)} autoComplete={signup ? 'username' : 'username webauthn'} autoFocus={!signup} aria-describedby="auth-description" required maxLength={80} disabled={Boolean(busy)} className={input} />
+          </div>
+          <div>
+            <label htmlFor="password" className="mb-1 block text-sm font-medium text-gray-700">Password</label>
+            <input id="password" name="password" type="password" value={password} onChange={event => setPassword(event.target.value)} autoComplete={signup ? 'new-password' : 'current-password'} minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} aria-describedby={signup ? 'password-help' : undefined} required maxLength={1024} disabled={Boolean(busy)} className={input} />
+            {signup && <p id="password-help" className="mt-1 text-xs text-gray-600">Use at least 8 characters and a number. Your password is also your fallback if you lose access to a passkey.</p>}
+          </div>
+          <button type="submit" data-skip-tracking="true" disabled={Boolean(busy)} className={signup ? button : secondary}>{busy === 'password' ? (signup ? 'Creating account…' : 'Signing in…') : signup ? 'Create account' : 'Sign in with password'}</button>
+        </form>
+        <p className="mt-6 text-center text-sm text-gray-600">{signup ? 'Already have an account?' : 'New to The DevTools Times?'}{' '}<a href={`${import.meta.env.BASE_URL}${signup ? 'signin' : 'signup'}`} className="font-semibold text-gray-900 underline underline-offset-2">{signup ? 'Sign in' : 'Sign up'}</a></p>
+      </>}
