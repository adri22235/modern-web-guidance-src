new file mode 100644
index 0000000..d80552d
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,118 @@
+import type { APIRoute } from 'astro';
+import { randomBytes } from 'node:crypto';
+import { generateRegistrationOptions, generateAuthenticationOptions } from '@simplewebauthn/server';
+import { verifyPasskeyAssertion, verifyPasskeyRegistration } from '../../../server/passkeys';
+import { withAuthStore } from '../../../server/auth-store';
+import { AuthError, configuration, text, passwordRequest, signIn, requireAccount, requireRecentVerification, saveCeremony, consumeCeremony, accountDetails } from '../../../server/auth';
+
+const json = (value: unknown, status = 200) => Response.json(value, { status, headers: { 'Cache-Control': 'no-store' } });
+
+export const ALL: APIRoute = async context => {
+  try {
+    if (!context.session) throw new AuthError('Account sessions are unavailable.', 503);
+    const { request, params } = context;
+    const action = params.action;
+    const { rpId, origin } = configuration(context.url);
+    if (request.method === 'GET' && action === 'account') {
+      return json(await accountDetails(context, await requireAccount(context)));
+    }
+    if (!['POST', 'PUT', 'DELETE'].includes(request.method)) return json({ error: 'Method not allowed.' }, 405);
+    // Astro's existing app disables global origin checks; enforce CSRF protection here.
+    if (request.headers.get('origin') !== origin) throw new AuthError('This request came from an untrusted origin.', 403);
+    if (!request.headers.get('content-type')?.startsWith('application/json')) throw new AuthError('Expected a JSON request.', 415);
+    const body = await request.json();
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new AuthError('Invalid request.');
+
+    if (request.method === 'POST' && (action === 'login' || action === 'register')) {
+      const username = text(body.username, 'Username');
+      await passwordRequest(action, username, body.password);
+      // Registration does not imply an authenticated session at the password service.
+      if (action === 'register') await passwordRequest('login', username, body.password);
+      const account = await withAuthStore(store => {
+        let account = store.accounts.find(item => item.username === username);
+        if (!account) {
+          account = { id: randomBytes(32).toString('base64url'), username, displayName: username };
+          store.accounts.push(account);
+        }
+        return account;
+      });
+      await signIn(context, account);
+      return json({ success: true });
+    }
+    if (request.method === 'POST' && action === 'logout') {
+      context.session.destroy();
+      return json({ success: true });
+    }
+    if (request.method === 'POST' && action === 'reauth/password') {
+      const account = await requireAccount(context);
+      await passwordRequest('login', account.username, body.password);
+      context.session.set('verifiedAt', Date.now());
+      return json({ success: true });
+    }
+    if (request.method === 'POST' && action === 'registration/options') {
+      const account = await requireAccount(context);
+      await requireRecentVerification(context);
+      const keys = await withAuthStore(store => store.passkeys.filter(key => key.userId === account.id && key.rpId === rpId));
+      const options = await generateRegistrationOptions({
+        rpID: rpId, rpName: 'The DevTools Times',
+        userID: Buffer.from(account.id, 'base64url'), userName: account.username, userDisplayName: account.displayName,
+        attestationType: 'none', excludeCredentials: keys.map(key => ({ id: key.id, transports: key.transports })),
+        authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required', ...(body.promotion === true ? { authenticatorAttachment: 'platform' as const } : {}) },
+      });
+      await saveCeremony(context, { challenge: options.challenge, purpose: 'registration', userId: account.id, origin, rpId });
+      return json(options);
+    }
+    if (request.method === 'POST' && action === 'registration/verify') {
+      const account = await requireAccount(context);
+      await requireRecentVerification(context);
+      const ceremony = await consumeCeremony(context, 'registration');
+      await verifyPasskeyRegistration(body.credential, ceremony, account.id);
+      return json({ success: true });
+    }
+    if (request.method === 'POST' && (action === 'authentication/options' || action === 'reauth/options')) {
+      const account = action === 'reauth/options' ? await requireAccount(context) : undefined;
+      const keys = account ? await withAuthStore(store => store.passkeys.filter(key => key.userId === account.id && key.rpId === rpId)) : [];
+      if (account && !keys.length) throw new AuthError('No passkeys are registered. Verify with your password instead.');
+      const options = await generateAuthenticationOptions({ rpID: rpId, userVerification: 'required', allowCredentials: keys.map(key => ({ id: key.id, transports: key.transports })) });
+      await saveCeremony(context, { challenge: options.challenge, purpose: account ? 'reauthentication' : 'authentication', userId: account?.id, origin, rpId });
+      return json(options);
+    }
+    if (request.method === 'POST' && (action === 'authentication/verify' || action === 'reauth/verify')) {
+      const account = action === 'reauth/verify' ? await requireAccount(context) : undefined;
+      const ceremony = await consumeCeremony(context, account ? 'reauthentication' : 'authentication');
+      const authenticated = await verifyPasskeyAssertion(body.credential, ceremony, account?.id);
+      if (account) context.session.set('verifiedAt', Date.now());
+      else await signIn(context, authenticated);
+      return json({ success: true });
+    }
+    if (request.method === 'PUT' && action === 'profile') {
+      const account = await requireAccount(context);
+      await requireRecentVerification(context);
+      const displayName = text(body.displayName, 'Display name');
+      const updated = await withAuthStore(store => {
+        const stored = store.accounts.find(item => item.id === account.id)!;
+        stored.displayName = displayName;
+        return stored;
+      });
+      return json(await accountDetails(context, updated));
+    }
+    if ((request.method === 'PUT' || request.method === 'DELETE') && action?.startsWith('credentials/')) {
+      const account = await requireAccount(context);
+      await requireRecentVerification(context);
+      const id = action.slice('credentials/'.length);
+      await withAuthStore(store => {
+        const key = store.passkeys.find(key => key.id === id && key.userId === account.id && key.rpId === rpId);
+        if (!key) throw new AuthError('Passkey not found.', 404);
+        if (request.method === 'DELETE') store.passkeys = store.passkeys.filter(item => item !== key);
+        else key.name = text(body.name, 'Passkey name');
+      });
+      return json(await accountDetails(context, account));
+    }
+    return json({ error: 'Endpoint not found.' }, 404);
+  } catch (error) {
+    if (error instanceof AuthError) return json({ error: error.message }, error.status);
+    if (error instanceof SyntaxError) return json({ error: 'Invalid JSON request.' }, 400);
+    console.warn('Authentication request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'The request could not be completed. Please try again.' }, 400);
+  }
+};
diff --git a/src/server/auth-store.ts b/src/server/auth-store.ts
new file mode 100644
index 0000000..abd52b6
--- /dev/null
+++ b/src/server/auth-store.ts
@@ -0,0 +1,62 @@
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+export interface Account {
+  id: string;
+  username: string;
+  displayName: string;
+}
+
+export interface Passkey {
+  id: string;
+  userId: string;
+  rpId: string;
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  name: string;
+  aaguid: string;
+  deviceType: string;
+  backedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface Ceremony {
+  challenge: string;
+  purpose: 'registration' | 'authentication' | 'reauthentication';
+  userId?: string;
+  expiresAt: number;
+  rpId: string;
+  origin: string;
+}
+
+interface AuthStore {
+  accounts: Account[];
+  passkeys: Passkey[];
+  ceremonies: Record<string, Ceremony>;
+}
+
+// Serialized, atomic writes for the standalone, single-process sample app.
+// Use a shared transactional database before deploying multiple instances.
+let pending: Promise<unknown> = Promise.resolve();
+export function withAuthStore<T>(run: (store: AuthStore) => T | Promise<T>): Promise<T> {
+  const result = pending.then(async () => {
+    const path = resolve(process.env.AUTH_STORE_PATH || '.data/auth.json');
+    let store: AuthStore;
+    try {
+      store = JSON.parse(await readFile(path, 'utf8'));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      store = { accounts: [], passkeys: [], ceremonies: {} };
+    }
+    const value = await run(store);
+    await mkdir(dirname(path), { recursive: true, mode: 0o700 });
+    const temporary = `${path}.tmp`;
+    await writeFile(temporary, JSON.stringify(store), { mode: 0o600 });
+    await rename(temporary, path);
+    return value;
+  });
+  pending = result.catch(() => {});
+  return result;
+}
diff --git a/src/server/auth.ts b/src/server/auth.ts
new file mode 100644
index 0000000..9307a40
--- /dev/null
+++ b/src/server/auth.ts
@@ -0,0 +1,105 @@
+import { randomBytes } from 'node:crypto';
+import type { APIContext } from 'astro';
+import { withAuthStore, type Account, type Ceremony } from './auth-store';
+import { passkeyProvider } from './passkey-provider';
+
+export class AuthError extends Error {
+  constructor(message: string, public status = 400) { super(message); }
+}
+
+export function configuration(url: URL) {
+  const local = ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname);
+  const origin = process.env.WEBAUTHN_ORIGIN || (local ? url.origin : new URL(import.meta.env.SITE!).origin);
+  return { origin, rpId: process.env.WEBAUTHN_RP_ID || new URL(origin).hostname };
+}
+
+export function text(value: unknown, label: string, max = 80): string {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > max) {
+    throw new AuthError(`${label} must contain 1–${max} characters.`);
+  }
+  return value.trim();
+}
+
+const PASSWORD_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export async function passwordRequest(action: 'login' | 'register', username: string, password: unknown) {
+  if (typeof password !== 'string' || !password || password.length > 1024) {
+    throw new AuthError('Enter your password.');
+  }
+  if (action === 'register' && (password.length < 8 || !/\d/.test(password))) {
+    throw new AuthError('Use at least 8 characters and a number.');
+  }
+  let response: Response;
+  try {
+    response = await fetch(`${PASSWORD_API}/${action}`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000),
+    });
+  } catch {
+    throw new AuthError('The password service is unavailable. Please try again.', 503);
+  }
+  if (!response.ok) {
+    throw new AuthError(action === 'login' ? 'Username or password is incorrect.' : 'Account could not be created. Try another username.', action === 'login' ? 401 : 400);
+  }
+}
+
+export async function signIn(context: APIContext, account: Account) {
+  await context.session!.regenerate();
+  context.session!.delete('ceremonyId');
+  context.session!.set('accountId', account.id, { ttl: 60 * 60 * 24 });
+  context.session!.set('verifiedAt', Date.now());
+}
+
+export async function currentAccount(context: Pick<APIContext, 'session'>) {
+  const id = await context.session?.get('accountId');
+  if (!id) return undefined;
+  return withAuthStore(store => store.accounts.find(account => account.id === id));
+}
+
+export async function requireAccount(context: APIContext) {
+  const account = await currentAccount(context);
+  if (!account) throw new AuthError('Please sign in to manage your account.', 401);
+  return account;
+}
+
+export async function requireRecentVerification(context: APIContext) {
+  const verifiedAt = await context.session!.get('verifiedAt');
+  if (typeof verifiedAt !== 'number' || Date.now() - verifiedAt > 5 * 60 * 1000) {
+    throw new AuthError('Verify your identity before making this change.', 403);
+  }
+}
+
+export async function saveCeremony(context: APIContext, ceremony: Omit<Ceremony, 'expiresAt'>) {
+  const id = randomBytes(32).toString('base64url');
+  const previous = await context.session!.get('ceremonyId');
+  await withAuthStore(store => {
+    for (const [key, value] of Object.entries(store.ceremonies)) {
+      if (value.expiresAt < Date.now() || key === previous) delete store.ceremonies[key];
+    }
+    store.ceremonies[id] = { ...ceremony, expiresAt: Date.now() + 5 * 60 * 1000 };
+  });
+  context.session!.set('ceremonyId', id, { ttl: 300 });
+}
+
+export async function consumeCeremony(context: APIContext, purpose: Ceremony['purpose']) {
+  const id = await context.session!.get('ceremonyId');
+  context.session!.delete('ceremonyId');
+  // Consume persistently before verification, including failed attempts and concurrent requests.
+  const ceremony = await withAuthStore(store => {
+    const value = id ? store.ceremonies[id] : undefined;
+    if (id) delete store.ceremonies[id];
+    return value;
+  });
+  const { rpId, origin } = configuration(context.url);
+  if (!ceremony || ceremony.purpose !== purpose || ceremony.expiresAt < Date.now() || ceremony.rpId !== rpId || ceremony.origin !== origin) {
+    throw new AuthError('This passkey request expired. Please try again.');
+  }
+  return ceremony;
+}
+
+export async function accountDetails(context: APIContext, account: Account) {
+  const { rpId } = configuration(context.url);
+  const credentials = await withAuthStore(store => store.passkeys
+    .filter(key => key.userId === account.id && key.rpId === rpId)
+    .map(({ id, name, aaguid, registeredAt, lastUsedAt, deviceType, backedUp }) => ({ id, name, provider: passkeyProvider(aaguid), registeredAt, lastUsedAt, deviceType, backedUp })));
+  return { ...account, userId: account.id, rpId, credentials };
+}
