+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { accountUrl, authenticatePasskey, authRequest, passkeyCapabilities, passkeyError, registerPasskey, type PasskeyCapabilities } from '../utils/passkeys';
+
+const button = 'w-full rounded-md bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900';
+const secondary = 'w-full rounded-md border border-gray-400 bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900';
+const input = 'w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-700';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState('');
+  const [signedIn, setSignedIn] = useState(false);
+  const [created, setCreated] = useState(false);
+  const [capabilities, setCapabilities] = useState<PasskeyCapabilities | null>(null);
+  const controller = useRef<AbortController | null>(null);
+  const mounted = useRef(false);
+  const conditional = useRef(false);
+  const authenticated = useRef(false);
+
+  const newRequest = () => {
+    controller.current?.abort();
+    const request = new AbortController();
+    controller.current = request;
+    return request;
+  };
+
+  const startAutofill = async () => {
+    if (!mounted.current || !conditional.current || authenticated.current) return;
+    const request = newRequest();
+    try {
+      await authenticatePasskey(request.signal, 'conditional');
+      if (!request.signal.aborted && mounted.current) window.location.assign(accountUrl);
+    } catch (error) {
+      if (request.signal.aborted || !mounted.current) return;
+      if (error instanceof Error && ['AbortError', 'NotAllowedError'].includes(error.name)) return;
+      setError(passkeyError(error));
+    }
+  };
+
+  useEffect(() => {
+    mounted.current = true;
+    passkeyCapabilities().then(value => {
+      if (!mounted.current) return;
+      setCapabilities(value);
+      conditional.current = !signup && value.conditional;
+      if (conditional.current && !controller.current) void startAutofill();
+    }).catch(() => { if (mounted.current) setCapabilities({ supported: false, create: false, conditional: false }); });
+    return () => { mounted.current = false; controller.current?.abort(); };
+  }, []);
+
+  async function passwordSubmit(event: FormEvent) {
+    event.preventDefault();
+    const request = newRequest();
+    setBusy('password'); setError('');
+    try {
+      await authRequest(signup ? 'register' : 'login', { username, password }, 'POST', request.signal);
+      authenticated.current = true;
+      setPassword(''); setSignedIn(true);
+    } catch (error) {
+      if (!request.signal.aborted) { setError(passkeyError(error)); void startAutofill(); }
+    } finally { if (mounted.current) setBusy(''); }
+  }
+
+  async function passkeySignIn() {
+    const request = newRequest();
+    setBusy('passkey'); setError('');
+    try {
+      await authenticatePasskey(request.signal);
+      authenticated.current = true;
+      window.location.assign(accountUrl);
+    } catch (error) {
+      if (!request.signal.aborted) { setError(passkeyError(error)); void startAutofill(); }
+    } finally { if (mounted.current) setBusy(''); }
+  }
+
+  async function createPasskey() {
+    const request = newRequest();
+    setBusy('create'); setError('');
+    try {
+      await registerPasskey(true, request.signal);
+      setCreated(true);
+    } catch (error) { if (!request.signal.aborted) setError(passkeyError(error)); }
+    finally { if (mounted.current) setBusy(''); }
+  }
+
+  return (
+    <section aria-labelledby="auth-title" className="mx-auto mt-10 max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
+      <h1 id="auth-title" className="mb-3 text-center text-2xl font-bold text-gray-900">{signedIn ? (created ? 'Your passkey is ready' : 'You’re signed in') : signup ? 'Sign Up' : 'Sign In'}</h1>
+      <p id="auth-description" className="mb-6 text-center text-sm text-gray-600">{signedIn ? (created ? 'Next time, sign in with your fingerprint, face, or device PIN.' : 'Make your next visit simpler with a passkey.') : signup ? 'Create your account, then add a passkey for a faster, safer sign-in.' : 'Welcome back to The DevTools Times.'}</p>
+      {error && <p role="alert" className="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{error}</p>}
+      <div role="status" className="sr-only">{busy ? 'Waiting for your sign-in request.' : created ? 'Passkey created successfully.' : ''}</div>
+      {signedIn ? (
+        <div className="space-y-4">
+          {!created && <>
+            <p className="text-sm text-gray-600">Passkeys let you sign in without typing your password. Your device or password manager keeps your passkey safe.</p>
+            <button type="button" className={button} disabled={Boolean(busy) || !capabilities?.create} onClick={createPasskey}>{busy === 'create' ? 'Creating passkey…' : 'Create a passkey'}</button>
+            {capabilities && !capabilities.create && <p className="text-sm text-gray-600">Passkey creation isn’t available on this device. You can add one from account settings on a supported device.</p>}
+          </>}
+          <a href={accountUrl} className={`${secondary} block text-center ${busy ? 'pointer-events-none opacity-50' : ''}`} aria-disabled={Boolean(busy)} tabIndex={busy ? -1 : undefined}>{created ? 'Go to account settings' : 'Continue to my account'}</a>
+        </div>
+      ) : <>
+        {!signup && <>
+          <button type="button" onClick={passkeySignIn} disabled={Boolean(busy) || !capabilities?.supported} className={button}>{busy === 'passkey' ? 'Waiting for your passkey…' : 'Sign in with a passkey'}</button>
+          <p className="mt-2 text-center text-xs text-gray-600">{capabilities && !capabilities.supported ? 'Passkeys aren’t available here. Use your password below.' : 'Use your fingerprint, face, device PIN, or security key.'}</p>
