new file mode 100644
index 0000000..49b9ec8
--- /dev/null
+++ b/src/server/passkeys.ts
@@ -0,0 +1,41 @@
+import { verifyAuthenticationResponse, verifyRegistrationResponse, type AuthenticationResponseJSON, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import { AuthError } from './auth';
+import { withAuthStore, type Ceremony } from './auth-store';
+import { passkeyProvider } from './passkey-provider';
+
+export async function verifyPasskeyRegistration(response: RegistrationResponseJSON, ceremony: Ceremony, accountId: string) {
+  if (ceremony.userId !== accountId) throw new AuthError('Account does not match this request.', 403);
+  const result = await verifyRegistrationResponse({ response, expectedChallenge: ceremony.challenge, expectedOrigin: ceremony.origin, expectedRPID: ceremony.rpId, requireUserVerification: true });
+  if (!result.verified || !result.registrationInfo) throw new AuthError('Could not verify this passkey.');
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = result.registrationInfo;
+  await withAuthStore(store => {
+    if (store.passkeys.some(key => key.id === credential.id)) throw new AuthError('This passkey is already registered.', 409);
+    store.passkeys.push({
+      id: credential.id, userId: accountId, rpId: ceremony.rpId,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter,
+      transports: credential.transports || [], name: passkeyProvider(aaguid)?.name || 'My passkey', aaguid,
+      deviceType: credentialDeviceType, backedUp: credentialBackedUp, registeredAt: Date.now(),
+    });
+  });
+}
+
+export async function verifyPasskeyAssertion(response: AuthenticationResponseJSON, ceremony: Ceremony, activeAccountId?: string) {
+  if (activeAccountId && ceremony.userId !== activeAccountId) throw new AuthError('Account does not match this request.', 403);
+  return withAuthStore(async store => {
+    const key = store.passkeys.find(key => key.id === response?.id && key.rpId === ceremony.rpId);
+    if (!key) throw new AuthError('This passkey is no longer registered. Sign in with your password.', 404);
+    if (activeAccountId && key.userId !== activeAccountId) throw new AuthError('Use a passkey belonging to this account.', 403);
+    const owner = store.accounts.find(item => item.id === key.userId);
+    if (!owner || (response.response?.userHandle && response.response.userHandle !== owner.id)) throw new AuthError('Passkey account does not match.', 403);
+    const result = await verifyAuthenticationResponse({
+      response, expectedChallenge: ceremony.challenge, expectedOrigin: ceremony.origin, expectedRPID: ceremony.rpId,
+      requireUserVerification: true,
+      credential: { id: key.id, publicKey: Buffer.from(key.publicKey, 'base64url'), counter: key.counter, transports: key.transports },
+    });
+    if (!result.verified) throw new AuthError('Passkey could not be verified.', 401);
+    key.counter = result.authenticationInfo.newCounter;
+    key.lastUsedAt = Date.now();
+    key.backedUp = result.authenticationInfo.credentialBackedUp;
+    return owner;
+  });
+}
diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..9f80ea4
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,106 @@
+export const accountUrl = `${import.meta.env.BASE_URL}account`;
+const apiUrl = `${import.meta.env.BASE_URL}api/auth/`;
+
+export class ApiError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+
+export async function authRequest<T = { success: boolean }>(path: string, body?: unknown, method = 'POST', signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${apiUrl}${path}`, {
+    method, credentials: 'same-origin', cache: 'no-store', signal,
+    headers: { 'Content-Type': 'application/json' },
+    ...(method !== 'GET' ? { body: JSON.stringify(body || {}) } : {}),
+  });
+  let data;
+  try { data = await response.json(); } catch { throw new ApiError('The account service is unavailable. Please try again.', response.status); }
+  if (!response.ok) throw new ApiError(data.error || 'The request failed. Please try again.', response.status);
+  return data;
+}
+
+export interface PasskeyCapabilities { supported: boolean; create: boolean; conditional: boolean }
+export async function passkeyCapabilities(): Promise<PasskeyCapabilities> {
+  const unsupported = { supported: false, create: false, conditional: false };
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) return unsupported;
+  await import('webauthn-polyfills');
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return { supported: true, create: Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet), conditional: Boolean(capabilities.conditionalGet) };
+  } catch { return { supported: true, create: false, conditional: false }; }
+}
+
+type SignalCredential = typeof PublicKeyCredential & {
+  signalUnknownCredential?: (value: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (value: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (value: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+async function signalUnknown(rpId: string, id: string) {
+  const api = PublicKeyCredential as SignalCredential;
+  try { await api.signalUnknownCredential?.({ rpId, credentialId: id }); }
+  catch (error) { console.warn('Passkey provider synchronization was skipped.', error); }
+}
+
+export async function registerPasskey(promotion: boolean, signal: AbortSignal) {
+  const options = await authRequest<PublicKeyCredentialCreationOptionsJSON>('registration/options', { promotion }, 'POST', signal);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  const credential = await navigator.credentials.create({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  const encoded = credential.toJSON();
+  try {
+    await authRequest('registration/verify', { credential: encoded }, 'POST', signal);
+  } catch (error) {
+    await signalUnknown(options.rp.id!, credential.id);
+    throw error;
+  }
+}
+
+export async function authenticatePasskey(signal: AbortSignal, mode: 'explicit' | 'conditional' | 'reauth' = 'explicit') {
+  const prefix = mode === 'reauth' ? 'reauth' : 'authentication';
+  const options = await authRequest<PublicKeyCredentialRequestOptionsJSON>(`${prefix}/options`, {}, 'POST', signal);
+  if (mode === 'reauth' && !options.allowCredentials?.length) throw new Error('No passkeys are registered. Verify with your password instead.');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  const credential = await navigator.credentials.get({ publicKey, signal, ...(mode === 'conditional' ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  try {
+    await authRequest(`${prefix}/verify`, { credential: credential.toJSON() }, 'POST', signal);
+  } catch (error) {
+    if (mode !== 'reauth' && error instanceof ApiError && error.status === 404) await signalUnknown(options.rpId!, credential.id);
+    throw error;
+  }
+}
+
+export interface CredentialSummary {
+  id: string; name: string; provider?: { name: string; icon: string }; registeredAt: number; lastUsedAt?: number; deviceType: string; backedUp: boolean;
+}
+export interface AccountDetails {
+  id: string; username: string; displayName: string; userId: string; rpId: string; credentials: CredentialSummary[];
+}
+const validId = (id: string) => typeof id === 'string' && id.length > 0 && id.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(id);
+
+export async function syncPasskeys(account: AccountDetails) {
+  if (!window.PublicKeyCredential) return;
+  const api = PublicKeyCredential as SignalCredential;
+  const ids = account.credentials.map(key => key.id);
+  if (!api.signalAllAcceptedCredentials || !account.rpId || !validId(account.userId) || !ids.every(validId)) return;
+  try { await api.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: ids }); }
+  catch (error) { console.warn('Passkey provider synchronization was skipped.', error); }
+}
+
+export async function syncProfile(account: AccountDetails) {
+  if (!window.PublicKeyCredential || !account.rpId || !validId(account.userId)) return;
+  const api = PublicKeyCredential as SignalCredential;
+  try { await api.signalCurrentUserDetails?.({ rpId: account.rpId, userId: account.userId, name: account.username, displayName: account.displayName }); }
+  catch (error) { console.warn('Passkey profile synchronization was skipped.', error); }
+}
+
+export function passkeyError(error: unknown) {
+  if (error instanceof Error) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. Try again, or use your password.';
+    if (error.name === 'AbortError') return 'The passkey request was cancelled. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys are unavailable on this address. Use your password or contact support.';
+    if (error.name === 'NotSupportedError') return 'This device cannot create this passkey. Try another device or use your password.';
+    return error.message;
+  }
+  return 'Something went wrong. Please try again.';
+}
diff --git a/tests/auth.test.ts b/tests/auth.test.ts
new file mode 100644
index 0000000..888efd1
--- /dev/null
+++ b/tests/auth.test.ts
@@ -0,0 +1,197 @@
+import { after, beforeEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import type { APIContext } from 'astro';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+import { withAuthStore, type Ceremony } from '../src/server/auth-store';
+import { AuthError, saveCeremony, consumeCeremony, requireRecentVerification, passwordRequest, accountDetails } from '../src/server/auth';
+import { verifyPasskeyAssertion } from '../src/server/passkeys';
+import { passkeyProvider } from '../src/server/passkey-provider';
+
+const directory = await mkdtemp(join(tmpdir(), 'devtools-auth-test-'));
+const originalPath = process.env.AUTH_STORE_PATH;
+const originalOrigin = process.env.WEBAUTHN_ORIGIN;
+process.env.AUTH_STORE_PATH = join(directory, 'auth.json');
+process.env.WEBAUTHN_ORIGIN = 'http://localhost';
+after(async () => {
+  await rm(directory, { recursive: true, force: true });
+  if (originalPath === undefined) delete process.env.AUTH_STORE_PATH; else process.env.AUTH_STORE_PATH = originalPath;
+  if (originalOrigin === undefined) delete process.env.WEBAUTHN_ORIGIN; else process.env.WEBAUTHN_ORIGIN = originalOrigin;
+});
+beforeEach(async () => { await writeFile(process.env.AUTH_STORE_PATH!, JSON.stringify({ accounts: [], passkeys: [], ceremonies: {} })); });
+
+function context() {
+  const values = new Map<string, unknown>();
+  return {
+    url: new URL('http://localhost/devtools-times/'),
+    session: { get: async (key: string) => values.get(key), set: (key: string, value: unknown) => values.set(key, value), delete: (key: string) => values.delete(key) },
+  } as unknown as APIContext;
+}
+const ceremony = (): Ceremony => ({ purpose: 'authentication', challenge: randomBytes(32).toString('base64url'), rpId: 'localhost', origin: 'http://localhost', expiresAt: Date.now() + 60000 });
+
+async function assertion(options: { flags?: number; origin?: string; challenge?: string; handle?: string; counter?: number } = {}) {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const cose = isoCBOR.encode(new Map<number, number | Uint8Array>([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x!, 'base64url')], [-3, Buffer.from(jwk.y!, 'base64url')]]));
+  const userId = randomBytes(32).toString('base64url');
+  const id = randomBytes(32).toString('base64url');
+  const expected = ceremony();
+  const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge: options.challenge || expected.challenge, origin: options.origin || expected.origin }));
+  const authenticatorData = Buffer.alloc(37);
+  createHash('sha256').update(expected.rpId).digest().copy(authenticatorData);
+  authenticatorData[32] = options.flags ?? 5; // User present and verified.
+  authenticatorData.writeUInt32BE(options.counter ?? 1, 33);
+  const signature = sign('sha256', Buffer.concat([authenticatorData, createHash('sha256').update(clientData).digest()]), privateKey);
+  const response: AuthenticationResponseJSON = { id, rawId: id, type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: clientData.toString('base64url'), authenticatorData: authenticatorData.toString('base64url'), signature: signature.toString('base64url'), userHandle: options.handle || userId } };
+  await withAuthStore(store => {
+    store.accounts.push({ id: userId, username: 'reader', displayName: 'Reader' });
+    store.passkeys.push({ id, userId, rpId: expected.rpId, publicKey: Buffer.from(cose).toString('base64url'), counter: 0, transports: ['internal'], name: 'Test passkey', aaguid: '00000000-0000-0000-0000-000000000000', deviceType: 'singleDevice', backedUp: false, registeredAt: Date.now() });
+  });
+  return { response, expected, userId };
+}
+
+test('challenges are consumed persistently and cannot be replayed', async () => {
+  const ctx = context();
+  const expected = ceremony();
+  await saveCeremony(ctx, expected);
+  const id = await ctx.session!.get('ceremonyId');
+  assert.equal((await consumeCeremony(ctx, 'authentication')).challenge, expected.challenge);
+  ctx.session!.set('ceremonyId', id!);
+  await assert.rejects(consumeCeremony(ctx, 'authentication'), /expired/);
+});
+
+test('expired challenges and challenges for another operation are rejected', async () => {
+  const ctx = context();
+  await saveCeremony(ctx, ceremony());
+  const id = await ctx.session!.get('ceremonyId');
+  await withAuthStore(store => { store.ceremonies[id!].expiresAt = Date.now() - 1; });
+  await assert.rejects(consumeCeremony(ctx, 'authentication'), /expired/);
+  await saveCeremony(ctx, ceremony());
+  await assert.rejects(consumeCeremony(ctx, 'registration'), /expired/);
+});
+
+test('only one concurrent request can consume a challenge', async () => {
+  const first = context(); const second = context();
+  await saveCeremony(first, ceremony());
+  second.session!.set('ceremonyId', (await first.session!.get('ceremonyId'))!);
+  const results = await Promise.allSettled([consumeCeremony(first, 'authentication'), consumeCeremony(second, 'authentication')]);
+  assert.equal(results.filter(value => value.status === 'fulfilled').length, 1);
+});
+
+test('sensitive changes require recent verification', async () => {
+  const ctx = context();
+  await assert.rejects(requireRecentVerification(ctx), error => error instanceof AuthError && error.status === 403);
+  ctx.session!.set('verifiedAt', Date.now() - 301000);
+  await assert.rejects(requireRecentVerification(ctx), /Verify your identity/);
+  ctx.session!.set('verifiedAt', Date.now());
+  await requireRecentVerification(ctx);
+});
+
+test('valid signatures authenticate, persist last use and counters, and reject counter replay', async () => {
+  const { response, expected, userId } = await assertion();
+  assert.equal((await verifyPasskeyAssertion(response, expected)).id, userId);
+  const key = await withAuthStore(store => store.passkeys[0]);
+  assert.equal(key.counter, 1);
+  assert.ok(key.lastUsedAt);
+  await assert.rejects(verifyPasskeyAssertion(response, expected), /counter/i);
+});
+
+test('reauthentication rejects another account’s valid passkey', async () => {
+  const { response, expected } = await assertion();
+  expected.userId = 'another-account';
+  await assert.rejects(verifyPasskeyAssertion(response, expected, 'another-account'), /belonging to this account/);
+});
+
+test('reauthentication rejects a ceremony belonging to another account', async () => {
+  const { response, expected, userId } = await assertion();
+  expected.userId = 'another-account';
+  await assert.rejects(verifyPasskeyAssertion(response, expected, userId), /Account does not match/);
+});
+
+test('assertions must match the server challenge and expected origin', async () => {
+  const wrongChallenge = await assertion({ challenge: randomBytes(32).toString('base64url') });
+  await assert.rejects(verifyPasskeyAssertion(wrongChallenge.response, wrongChallenge.expected), /challenge/i);
+  const wrongOrigin = await assertion({ origin: 'https://attacker.example' });
+  await assert.rejects(verifyPasskeyAssertion(wrongOrigin.response, wrongOrigin.expected), /origin/i);
+});
+
+test('assertions require user verification and matching user handles', async () => {
+  const unverified = await assertion({ flags: 1 });
+  await assert.rejects(verifyPasskeyAssertion(unverified.response, unverified.expected), /verification/i);
+  const wrongUser = await assertion({ handle: randomBytes(32).toString('base64url') });
+  await assert.rejects(verifyPasskeyAssertion(wrongUser.response, wrongUser.expected), /account does not match/i);
+});
+
+test('invalid signatures do not update stored credential state', async () => {
+  const { response, expected } = await assertion();
+  response.response.signature = randomBytes(72).toString('base64url');
+  await assert.rejects(verifyPasskeyAssertion(response, expected));
+  assert.equal((await withAuthStore(store => store.passkeys[0])).counter, 0);
+});
+
+test('unknown credentials return 404 and account responses never expose public keys', async () => {
+  const { response, expected, userId } = await assertion();
+  const account = await accountDetails(context(), { id: userId, username: 'reader', displayName: 'Reader' });
+  assert.equal(account.credentials.length, 1);
+  assert.equal('publicKey' in account.credentials[0], false);
+  response.id = randomBytes(32).toString('base64url');
+  await assert.rejects(verifyPasskeyAssertion(response, expected), error => error instanceof AuthError && error.status === 404);
+});
+
+test('password signup validation rejects weak passwords before contacting the password service', async () => {
+  await assert.rejects(passwordRequest('register', 'reader', 'weak'), /at least 8/);
+  await assert.rejects(passwordRequest('login', 'reader', ''), /Enter your password/);
+});
+
+test('zero and unknown AAGUIDs use a generic provider fallback', () => {
+  assert.equal(passkeyProvider('00000000-0000-0000-0000-000000000000'), undefined);
+  assert.equal(passkeyProvider('unknown'), undefined);
+  assert.equal(passkeyProvider('bada5566-a7aa-401f-bd96-45619a55120d')?.name, '1Password');
+});
+
+async function registration(flags = 0x45) {
+  const { publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const cose = isoCBOR.encode(new Map<number, number | Uint8Array>([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x!, 'base64url')], [-3, Buffer.from(jwk.y!, 'base64url')]]));
+  const id = randomBytes(32);
+  const expected = { ...ceremony(), purpose: 'registration' as const, userId: randomBytes(32).toString('base64url') };
+  const authData = Buffer.alloc(37 + 16 + 2);
+  createHash('sha256').update(expected.rpId).digest().copy(authData);
+  authData[32] = flags;
+  authData.writeUInt16BE(id.length, 53);
+  const attestation = isoCBOR.encode(new Map<string, string | Map<string, never> | Uint8Array>([
+    ['fmt', 'none'], ['attStmt', new Map<string, never>()], ['authData', Buffer.concat([authData, id, cose])],
+  ]));
+  return {
+    expected,
