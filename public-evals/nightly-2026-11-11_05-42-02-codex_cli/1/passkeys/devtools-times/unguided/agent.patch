diff --git a/src/lib/auth-client.ts b/src/lib/auth-client.ts
new file mode 100644
index 0000000..ee38b5b
--- /dev/null
+++ b/src/lib/auth-client.ts
@@ -0,0 +1,60 @@
+import {
+  startRegistration,
+  startAuthentication,
+  browserSupportsWebAuthn,
+} from "@simplewebauthn/browser";
+export class AuthError extends Error {
+  reauth: boolean;
+  constructor(message: string, reauth = false) {
+    super(message);
+    this.reauth = reauth;
+  }
+}
+export const base = import.meta.env.BASE_URL;
+export async function api(action: string, body?: unknown) {
+  const response = await fetch(`${base}api/auth/${action}`, {
+    method: body === undefined ? "GET" : "POST",
+    credentials: "same-origin",
+    headers: body === undefined ? {} : { "Content-Type": "application/json" },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  const data = await response.json();
+  if (!response.ok)
+    throw new AuthError(
+      data.error || "Something went wrong. Please try again.",
+      data.reauth,
+    );
+  return data;
+}
+export const supportsPasskeys = () =>
+  window.isSecureContext && browserSupportsWebAuthn();
+export async function registerPasskey(
+  username: string,
+  name: string,
+  signup = false,
+) {
+  const optionsJSON = await api("registration-options", {
+    username,
+    name,
+    signup,
+  });
+  const credential = await startRegistration({ optionsJSON });
+  return api("registration-verify", { credential });
+}
+export async function authenticatePasskey(reauth = false) {
+  const optionsJSON = await api("authentication-options", { reauth });
+  const credential = await startAuthentication({ optionsJSON });
+  return api("authentication-verify", { credential });
+}
+export function errorMessage(error: unknown) {
+  if (error instanceof Error) {
+    if (error.name === "NotAllowedError")
+      return "The passkey request was cancelled or timed out. You can try again or use your password.";
+    if (error.name === "InvalidStateError")
+      return "This device already has a passkey for this account. Try another device or security key.";
+    if (error.name === "SecurityError")
+      return "Passkeys require a secure connection and a matching site address.";
+    return error.message;
+  }
+  return "Something went wrong. Please try again.";
+}
