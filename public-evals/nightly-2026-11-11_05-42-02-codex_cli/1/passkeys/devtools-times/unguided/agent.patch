+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,523 @@
+import React, { useEffect, useRef, useState } from "react";
+import {
+  ArrowRightIcon,
+  ArrowLeftOnRectangleIcon,
+  ComputerDesktopIcon,
+  ShieldCheckIcon,
+  UserCircleIcon,
+  XMarkIcon,
+  PlusIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  LockClosedIcon,
+  CheckCircleIcon,
+} from "@heroicons/react/24/outline";
+import { PasskeyIcon } from "./AuthIcons";
+import {
+  api,
+  AuthError,
+  authenticatePasskey,
+  base,
+  errorMessage,
+  registerPasskey,
+  supportsPasskeys,
+} from "../lib/auth-client";
+type Key = {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsed: string | null;
+  backedUp: boolean;
+};
+type Account = { username: string; hasPassword: boolean; passkeys: Key[] };
+type Dialog = { type: "add" | "rename" | "remove" | "reauth"; key?: Key };
+const date = (value: string) =>
+  new Date(value).toLocaleDateString(undefined, {
+    month: "short",
+    day: "numeric",
+    year: "numeric",
+  });
+export default function AccountSettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [signedOut, setSignedOut] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [dialog, setDialog] = useState<Dialog | null>(null);
+  const [name, setName] = useState("");
+  const [password, setPassword] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [usePassword, setUsePassword] = useState(false);
+  const [dialogError, setDialogError] = useState("");
+  const retry = useRef<null | (() => Promise<void>)>(null);
+  const modal = useRef<HTMLDialogElement>(null);
+  const trigger = useRef<HTMLElement | null>(null);
+  async function refresh() {
+    setAccount(await api("account"));
+  }
+  useEffect(() => {
+    setSupported(supportsPasskeys());
+    refresh()
+      .catch((err) => {
+        setSignedOut(true);
+        setError(errorMessage(err));
+      })
+      .finally(() => setLoading(false));
+    if (new URLSearchParams(window.location.search).has("welcome"))
+      setNotice("Welcome to The DevTools Times. Your account is ready.");
+  }, []);
+  useEffect(() => {
+    if (dialog) modal.current?.showModal();
+    else {
+      modal.current?.close();
+      trigger.current?.focus();
+    }
+  }, [dialog]);
+  function open(value: Dialog) {
+    trigger.current = document.activeElement as HTMLElement;
+    setDialogError("");
+    setPassword("");
+    setUsePassword(!supported || !account?.passkeys.length);
+    setDialog(value);
+    setName(value.key?.name || "");
+  }
+  function close() {
+    if (!busy) {
+      setDialog(null);
+      setDialogError("");
+      retry.current = null;
+    }
+  }
+  async function run(action: () => Promise<void>) {
+    setBusy(true);
+    setDialogError("");
+    setError("");
+    try {
+      await action();
+      setDialog(null);
+      await refresh();
+    } catch (err) {
+      if (err instanceof AuthError && err.reauth) {
+        retry.current = action;
+        setPassword("");
+        setUsePassword(!supported || !account?.passkeys.length);
+        setDialog({ type: "reauth" });
+      } else setDialogError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    if (!dialog) return;
+    if (dialog.type === "reauth") {
+      setBusy(true);
+      setDialogError("");
+      try {
+        if (usePassword) await api("password-reauth", { password });
+        else await authenticatePasskey(true);
+        const next = retry.current;
+        retry.current = null;
+        if (next) await next();
+        else
+          setNotice(
+            "Identity confirmed. You can securely manage your passkeys.",
+          );
+        setDialog(null);
+        await refresh();
+      } catch (err) {
+        setDialogError(errorMessage(err));
+      } finally {
+        setBusy(false);
+      }
+      return;
+    }
+    const current = dialog;
+    const nextName = name.trim();
+    await run(async () => {
+      if (current.type === "add") {
+        await registerPasskey(account!.username, nextName || "My passkey");
+        setNotice("Your new passkey is ready to use.");
+      }
+      if (current.type === "rename") {
+        await api("rename", { id: current.key!.id, name: nextName });
+        setNotice("Passkey name updated.");
+      }
+      if (current.type === "remove") {
+        await api("remove", { id: current.key!.id });
+        setNotice("Passkey removed from your account.");
+      }
+    });
+  }
+  async function logout() {
+    setBusy(true);
+    try {
+      await api("logout", {});
+      window.location.assign(`${base}signin`);
+    } catch (err) {
+      setError(errorMessage(err));
+      setBusy(false);
+    }
+  }
+  if (loading)
+    return (
+      <div className="settings-loading" role="status">
+        Loading your account…
+      </div>
+    );
+  if (signedOut || !account)
+    return (
+      <div className="signed-out">
+        <span className="small-key-icon">
+          <UserCircleIcon width={30} />
+        </span>
+        <h1>Your account, at a glance.</h1>
+        <p>{error || "Sign in to manage your security and passkeys."}</p>
+        <a className="primary-button" href={`${base}signin`}>
+          Sign in to your account <ArrowRightIcon width={18} />
+        </a>
+      </div>
+    );
+  return (
+    <div className="settings-grid">
+      <aside className="settings-sidebar">
+        <span className="eyebrow">YOUR ACCOUNT</span>
+        <div className="account-avatar">
+          {account.username.charAt(0).toUpperCase()}
+        </div>
+        <h2>{account.username}</h2>
+        <p>DevTools Times reader</p>
+        <nav aria-label="Account settings">
+          <a href="#security" className="settings-nav-active">
+            <ShieldCheckIcon width={20} />
+            Sign-in & security
+            <ArrowRightIcon width={15} />
+          </a>
+          <a href={`${base}`}>
+            <ComputerDesktopIcon width={20} />
+            Back to the news
+          </a>
+        </nav>
+        <button className="signout-button" onClick={logout} disabled={busy}>
+          <ArrowLeftOnRectangleIcon width={19} />
+          Sign out
+        </button>
+      </aside>
+      <section className="settings-main" id="security">
+        <span className="eyebrow">A LITTLE PEACE OF MIND</span>
+        <h1>Sign-in & security</h1>
+        <p className="settings-intro">
+          A safer account. More time for the stories that matter.
+        </p>
+        {notice && (
+          <div className="success-notice" role="status">
+            <CheckCircleIcon width={20} />
+            <span>{notice}</span>
+            <button
+              aria-label="Dismiss notification"
+              onClick={() => setNotice("")}
+            >
+              <XMarkIcon width={18} />
+            </button>
+          </div>
+        )}
+        {error && (
+          <div className="form-error" role="alert">
+            {error}
+          </div>
+        )}
+        <div className="security-banner">
+          <span className="security-banner-icon">
+            <ShieldCheckIcon width={28} />
+          </span>
+          <div>
+            <h2>
+              {account.passkeys.length
+                ? "A stronger way to protect your account"
+                : "Your next security upgrade: passkeys"}
+            </h2>
+            <p>
+              {account.passkeys.length
+                ? "Your passkeys keep sign-in simple and your account secure."
+                : "Skip the password. Sign in with your face, fingerprint, or device PIN."}
+            </p>
+          </div>
+          <span className="security-badge">
+            {account.passkeys.length ? "PROTECTED" : "RECOMMENDED"}
+          </span>
+        </div>
+        <div className="settings-section-head">
+          <div>
+            <h2>
+              <PasskeyIcon size={23} />
+              Your passkeys{" "}
+              <span className="count-badge">{account.passkeys.length}</span>
+            </h2>
+            <p>Secure sign-in, with a familiar touch.</p>
+          </div>
+          <button
+            className="primary-button compact"
+            onClick={() => open({ type: "add" })}
+            disabled={busy || !supported}
+          >
+            <PlusIcon width={17} />
+            Add a passkey
+          </button>
+        </div>
+        {!supported && (
+          <div className="notice">
+            This browser or connection doesn’t support passkeys. Use a supported
+            browser on HTTPS to add or use one.
+          </div>
+        )}
+        <div className="passkey-list">
+          {account.passkeys.length ? (
+            account.passkeys.map((key) => (
+              <article className="passkey-row" key={key.id}>
+                <span className="key-device">
+                  <PasskeyIcon size={26} />
+                </span>
+                <div className="key-detail">
+                  <h3>{key.name}</h3>
+                  <p>
+                    Added {date(key.createdAt)}
+                    <span>·</span>
+                    {key.lastUsed
+                      ? `Last used ${date(key.lastUsed)}`
+                      : "Not used yet"}
+                  </p>
+                  <span className="key-sync">
+                    {key.backedUp ? "Synced passkey" : "Device-bound passkey"}
+                  </span>
+                </div>
+                <div className="key-actions">
+                  <button
+                    aria-label={`Rename ${key.name}`}
+                    title="Rename passkey"
+                    onClick={() => open({ type: "rename", key })}
+                  >
+                    <PencilSquareIcon width={19} />
+                  </button>
+                  <button
+                    aria-label={`Remove ${key.name}`}
+                    title="Remove passkey"
+                    disabled={
+                      !account.hasPassword && account.passkeys.length === 1
+                    }
+                    onClick={() => open({ type: "remove", key })}
+                  >
+                    <TrashIcon width={19} />
+                  </button>
+                </div>
+              </article>
+            ))
+          ) : (
+            <div className="passkey-empty">
+              <PasskeyIcon size={35} />
+              <h3>Your first passkey starts here.</h3>
+              <p>Add a passkey to sign in securely without a password.</p>
+              <button
+                className="text-button"
+                disabled={!supported}
+                onClick={() => open({ type: "add" })}
+              >
+                Create your first passkey <ArrowRightIcon width={16} />
+              </button>
+            </div>
+          )}
+        </div>
+        <p className="settings-footnote">
+          <LockClosedIcon width={14} />
+          {!account.hasPassword && account.passkeys.length === 1
+            ? "Keep at least one passkey so you can always access your account."
+            : "Only you can use your passkeys. Your biometric data stays on your device."}
+        </p>
+        <div className="settings-info-grid">
+          <div>
+            <h3>New device? No problem.</h3>
+            <p>
+              Passkeys can sync through your password manager. You can also use
+              a nearby phone or a physical security key.
+            </p>
+          </div>
+          <div>
+            <h3>Stay in control.</h3>
+            <p>
+              Give each passkey a memorable name. Remove a passkey here if you
+              no longer want it to access your account.
+            </p>
+          </div>
+        </div>
+        <div className="reauth-card">
+          <LockClosedIcon width={23} />
+          <div>
+            <h3>Extra care for important changes</h3>
+            <p>
+              We’ll ask you to confirm it’s you before updating your security.
+            </p>
+          </div>
+          <button
+            className="text-button"
+            onClick={() => {
+              retry.current = null;
+              open({ type: "reauth" });
+            }}
+          >
+            Verify identity <ArrowRightIcon width={15} />
+          </button>
+        </div>
+        <p className="settings-legal">
+          Your security matters. Read our{" "}
+          <a href={`${base}legal/privacy`}>Privacy Policy ↗</a>
+        </p>
+      </section>
+      <dialog
+        className="account-dialog"
+        aria-labelledby="account-dialog-title"
+        aria-describedby="account-dialog-description"
+        ref={modal}
+        onCancel={(e) => {
+          e.preventDefault();
+          close();
+        }}
+        onClick={(e) => {
+          if (e.target === e.currentTarget) close();
+        }}
+      >
+        <div className="dialog-inner">
+          <button
+            className="dialog-close"
+            aria-label="Close dialog"
+            disabled={busy}
+            onClick={close}
+          >
+            <XMarkIcon width={22} />
+          </button>
+          <span className="small-key-icon">
+            {dialog?.type === "reauth" ? (
+              <ShieldCheckIcon width={30} />
+            ) : (
+              <PasskeyIcon size={30} />
+            )}
+          </span>
+          <h2 id="account-dialog-title">
+            {dialog?.type === "add"
+              ? "Add a passkey"
+              : dialog?.type === "rename"
+                ? "Make it memorable."
+                : dialog?.type === "remove"
+                  ? "Remove this passkey?"
+                  : "Let’s make sure it’s you."}
+          </h2>
+          <p id="account-dialog-description">
+            {dialog?.type === "add"
+              ? "Give your passkey a name. Your device will take care of the rest."
+              : dialog?.type === "rename"
+                ? "Choose a name that helps you recognize this passkey."
+                : dialog?.type === "remove"
+                  ? `“${dialog.key?.name}” will no longer be able to sign in to your account. This won’t delete it from your password manager.`
+                  : "Confirm your identity to securely manage your account."}
+          </p>
+          <form onSubmit={submit} aria-busy={busy}>
+            {(dialog?.type === "add" || dialog?.type === "rename") && (
+              <>
+                <label className="field-label" htmlFor="passkey-name">
+                  Passkey name
+                </label>
+                <input
+                  className="auth-input"
+                  autoFocus
+                  id="passkey-name"
+                  placeholder="e.g. Personal MacBook"
+                  value={name}
+                  onChange={(e) => setName(e.target.value)}
+                  required
+                  maxLength={60}
+                  disabled={busy}
+                />
+              </>
+            )}
+            {dialog?.type === "reauth" &&
+              usePassword &&
+              account.hasPassword && (
+                <>
+                  <label className="field-label" htmlFor="confirm-password">
+                    Your password
+                  </label>
+                  <input
+                    className="auth-input"
+                    autoFocus
+                    type="password"
+                    autoComplete="current-password"
+                    id="confirm-password"
+                    value={password}
+                    onChange={(e) => setPassword(e.target.value)}
+                    required
+                    maxLength={256}
+                    disabled={busy}
+                  />
+                </>
+              )}
+            {dialogError && (
+              <div className="form-error" role="alert">
+                {dialogError}
+              </div>
+            )}
+            {dialog?.type === "reauth" && !supported && !account.hasPassword ? (
+              <p className="form-error">
+                Open this account in a browser that supports passkeys to confirm
+                your identity.
+              </p>
+            ) : (
+              <button
+                className={`primary-button ${dialog?.type === "remove" ? "danger-button" : ""}`}
+                disabled={busy}
+                type="submit"
+              >
+                {busy
+                  ? "Please follow your device’s prompt…"
+                  : dialog?.type === "add"
+                    ? "Create passkey"
+                    : dialog?.type === "rename"
+                      ? "Save name"
+                      : dialog?.type === "remove"
+                        ? "Remove passkey"
+                        : usePassword
+                          ? "Confirm with password"
+                          : "Confirm with passkey"}
+                {!busy && <ArrowRightIcon width={18} />}
+              </button>
+            )}
+            {dialog?.type === "reauth" &&
+              account.hasPassword &&
+              account.passkeys.length > 0 &&
+              supported && (
+                <button
+                  className="text-button reauth-alternative"
+                  type="button"
+                  disabled={busy}
+                  onClick={() => {
+                    setUsePassword(!usePassword);
+                    setDialogError("");
+                  }}
+                >
+                  {usePassword
+                    ? "Use a passkey instead"
+                    : "Use your password instead"}
+                </button>
+              )}
+            <button
+              className="dialog-cancel"
+              type="button"
+              disabled={busy}
+              onClick={close}
+            >
+              Cancel
+            </button>
+          </form>
+        </div>
+      </dialog>
+    </div>
+  );
+}
diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..425d38a
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,249 @@
+import React, { useEffect, useState } from "react";
+import {
+  ArrowRightIcon,
+  EyeIcon,
+  EyeSlashIcon,
+  LockClosedIcon,
+} from "@heroicons/react/24/outline";
+import { PasskeyIcon } from "./AuthIcons";
+import {
+  api,
+  authenticatePasskey,
+  base,
+  errorMessage,
+  registerPasskey,
+  supportsPasskeys,
+} from "../lib/auth-client";
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [method, setMethod] = useState<"passkey" | "password">("passkey");
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [showPassword, setShowPassword] = useState(false);
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    const value = supportsPasskeys();
+    setSupported(value);
+    if (!value) setMethod("password");
+  }, []);
+  async function submit(e: React.FormEvent) {
+    e.preventDefault();
+    setError("");
+    setBusy(true);
+    try {
+      if (method === "passkey") {
+        if (signup) await registerPasskey(username, "My first passkey", true);
+        else await authenticatePasskey();
+      } else
+        await api(signup ? "password-signup" : "password-signin", {
+          username,
+          password,
+        });
+      window.location.assign(
+        `${base}account/settings${signup ? "?welcome=1" : ""}`,
+      );
+    } catch (err) {
+      setError(errorMessage(err));
+      setBusy(false);
+    }
+  }
+  return (
+    <div className="auth-form-wrap">
+      <div className="eyebrow">
+        <span className="eyebrow-line" />
+        {signup ? "JOIN THE DEVTOOLS TIMES" : "YOUR DAILY PERSPECTIVE"}
+      </div>
+      <h1>{signup ? "Good journalism.\nGreat company." : "Welcome back."}</h1>
+      <p className="auth-intro">
+        {signup
+          ? "Create your free account. Stay curious, stay informed."
+          : "Independent thinking starts with a simple sign-in."}
+      </p>
+      <div
+        className="auth-tabs"
+        role="tablist"
+        aria-label={signup ? "Create account with" : "Sign-in method"}
+      >
+        <button
+          type="button"
+          role="tab"
+          id="passkey-tab"
+          aria-selected={method === "passkey"}
+          aria-controls="auth-panel"
+          disabled={busy || supported === false}
+          onClick={() => {
+            setMethod("passkey");
+            setError("");
+          }}
+        >
+          <PasskeyIcon size={19} />
+          Passkey<span className="recommended">RECOMMENDED</span>
+        </button>
+        <button
+          type="button"
+          role="tab"
+          id="password-tab"
+          aria-selected={method === "password"}
+          aria-controls="auth-panel"
+          disabled={busy}
+          onClick={() => {
+            setMethod("password");
+            setError("");
+          }}
+        >
+          <LockClosedIcon width={17} />
+          Password
+        </button>
+      </div>
+      {supported === false && (
+        <p className="notice">
+          Passkeys aren’t available in this browser or connection. You can
+          continue with a password.
+        </p>
+      )}
+      <form
+        onSubmit={submit}
+        id="auth-panel"
+        role="tabpanel"
+        aria-labelledby={`${method}-tab`}
+        aria-busy={busy}
+      >
+        {method === "passkey" && !signup ? (
+          <div className="passkey-prompt">
+            <span className="small-key-icon">
+              <PasskeyIcon size={29} />
+            </span>
+            <h2>A familiar touch. A safer sign-in.</h2>
+            <p>
+              Use your fingerprint, face, or screen lock.
+              <br />
+              No password to remember.
+            </p>
+          </div>
+        ) : (
+          <>
+            <label className="field-label" htmlFor="username">
+              Username
+            </label>
+            <input
+              className="auth-input"
+              id="username"
+              name="username"
+              autoComplete="username"
+              autoCapitalize="none"
+              spellCheck={false}
+              placeholder={signup ? "Choose your username" : "Enter your username"}
+              value={username}
+              onChange={(e) => setUsername(e.target.value)}
+              required
+              minLength={3}
+              maxLength={100}
+              disabled={busy}
+            />
+            {method === "password" && (
+              <>
+                <label
+                  className="field-label password-label"
+                  htmlFor="password"
+                >
+                  Password
+                </label>
+                <div className="password-field">
+                  <input
+                    className="auth-input"
+                    id="password"
+                    name="password"
+                    type={showPassword ? "text" : "password"}
+                    autoComplete={signup ? "new-password" : "current-password"}
+                    placeholder={
+                      signup
+                        ? "Create a strong password"
+                        : "Enter your password"
+                    }
+                    value={password}
+                    onChange={(e) => setPassword(e.target.value)}
+                    required
+                    minLength={signup ? 8 : undefined}
+                    maxLength={256}
+                    disabled={busy}
+                  />
+                  <button
+                    type="button"
+                    aria-label={
+                      showPassword ? "Hide password" : "Show password"
+                    }
+                    onClick={() => setShowPassword(!showPassword)}
+                  >
+                    {showPassword ? (
+                      <EyeSlashIcon width={19} />
+                    ) : (
+                      <EyeIcon width={19} />
+                    )}
+                  </button>
+                </div>
+                {signup && (
+                  <p className="input-help">
+                    At least 8 characters, including a number.
+                  </p>
+                )}
+              </>
+            )}
+            {method === "passkey" && (
+              <p className="input-help signup-help">
+                Next, your device will help you create a secure passkey.
+              </p>
+            )}
+          </>
+        )}
+        {error && (
+          <div className="form-error" role="alert">
+            {error}
+          </div>
+        )}
+        <button
+          className="primary-button"
+          disabled={busy || supported === null}
+          type="submit"
+          data-skip-tracking="true"
+        >
+          {method === "passkey" && <PasskeyIcon size={21} />}
+          <span>
+            {busy
+              ? method === "passkey"
+                ? "Waiting for your device…"
+                : "Please wait…"
+              : method === "passkey"
+                ? signup
+                  ? "Create account with a passkey"
+                  : "Sign in with a passkey"
+                : signup
+                  ? "Create your account"
+                  : "Sign in with password"}
+          </span>
+          {!busy && <ArrowRightIcon width={18} />}
+        </button>
+        {method === "passkey" && (
+          <p className="device-note">
+            <LockClosedIcon width={12} /> Your device keeps your biometric data
+            private.
+          </p>
+        )}
