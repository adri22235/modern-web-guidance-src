index 0000000..7b81792
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,167 @@
+import { DatabaseSync } from "node:sqlite";
+import { mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import { randomBytes, scryptSync, timingSafeEqual } from "node:crypto";
+
+const file = process.env.AUTH_DB_PATH || "./data/auth.sqlite";
+mkdirSync(dirname(file), { recursive: true });
+const db = new DatabaseSync(file);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, password TEXT);
+CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, public_key TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, created_at TEXT NOT NULL, last_used TEXT, backed_up INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT, verified_at INTEGER NOT NULL DEFAULT 0, challenge TEXT, expires INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS attempts (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+export type User = { id: string; username: string; password: string | null };
+export type Key = {
+  id: string;
+  user_id: string;
+  name: string;
+  public_key: string;
+  counter: number;
+  transports: string;
+  created_at: string;
+  last_used: string | null;
+  backed_up: number;
+};
+export type Challenge = {
+  value: string;
+  purpose: "signup" | "add" | "signin" | "reauth";
+  expires: number;
+  username?: string;
+  userId?: string;
+  name?: string;
+};
+export type Session = {
+  id: string;
+  user_id: string | null;
+  verified_at: number;
+  challenge: string | null;
+  expires: number;
+};
+export const token = () => randomBytes(32).toString("base64url");
+export const userByName = (name: string) =>
+  db.prepare("SELECT * FROM users WHERE username = ?").get(name) as
+    User | undefined;
+export const userById = (id: string) =>
+  db.prepare("SELECT * FROM users WHERE id = ?").get(id) as User | undefined;
+export const keysFor = (id: string) =>
+  db
+    .prepare(
+      "SELECT * FROM passkeys WHERE user_id = ? ORDER BY created_at DESC",
+    )
+    .all(id) as Key[];
+export const keyById = (id: string) =>
+  db.prepare("SELECT * FROM passkeys WHERE id = ?").get(id) as Key | undefined;
+export function createUser(
+  username: string,
+  password?: string,
+  id = token(),
+): User {
+  const user = { id, username, password: password ? hash(password) : null };
+  db.prepare("INSERT INTO users VALUES (?, ?, ?)").run(
+    user.id,
+    user.username,
+    user.password,
+  );
+  return user;
+}
+function hash(password: string) {
+  const salt = token();
+  return `${salt}:${scryptSync(password, salt, 64).toString("hex")}`;
+}
+export function checkPassword(user: User, password: string) {
+  if (!user.password) return false;
+  const [salt, value] = user.password.split(":");
+  return timingSafeEqual(
+    scryptSync(password, salt, 64),
+    Buffer.from(value, "hex"),
+  );
+}
+export function sessionById(id: string) {
+  return db
+    .prepare("SELECT * FROM sessions WHERE id = ? AND expires > ?")
+    .get(id, Date.now()) as Session | undefined;
+}
+export function newSession(userId: string | null = null) {
+  db.prepare("DELETE FROM sessions WHERE expires < ?").run(Date.now());
+  const session = {
+    id: token(),
+    user_id: userId,
+    verified_at: userId ? Date.now() : 0,
+    challenge: null,
+    expires: Date.now() + 86400000,
+  };
+  db.prepare("INSERT INTO sessions VALUES (?, ?, ?, ?, ?)").run(
+    session.id,
+    session.user_id,
+    session.verified_at,
+    null,
+    session.expires,
+  );
+  return session;
+}
+export function saveChallenge(id: string, challenge: Challenge | null) {
+  db.prepare("UPDATE sessions SET challenge = ? WHERE id = ?").run(
+    challenge ? JSON.stringify(challenge) : null,
+    id,
+  );
+}
+export function takeChallenge(session: Session): Challenge | undefined {
+  // Read and consume synchronously so concurrent requests cannot reuse a challenge.
+  db.exec("BEGIN IMMEDIATE");
+  try {
+    const current = db
+      .prepare("SELECT challenge FROM sessions WHERE id = ? AND expires > ?")
+      .get(session.id, Date.now());
+    saveChallenge(session.id, null);
+    db.exec("COMMIT");
+    return current?.challenge
+      ? JSON.parse(current.challenge as string)
+      : undefined;
+  } catch (error) {
+    db.exec("ROLLBACK");
+    throw error;
+  }
+}
+export function verifySession(id: string) {
+  db.prepare("UPDATE sessions SET verified_at = ? WHERE id = ?").run(
+    Date.now(),
+    id,
+  );
+}
+export function deleteSession(id: string) {
+  db.prepare("DELETE FROM sessions WHERE id = ?").run(id);
+}
+export function addKey(key: Key) {
+  db.prepare("INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)").run(
+    key.id,
+    key.user_id,
+    key.name,
+    key.public_key,
+    key.counter,
+    key.transports,
+    key.created_at,
+    key.last_used,
+    key.backed_up,
+  );
+}
+export function updateKey(id: string, counter: number, backedUp: boolean) {
+  db.prepare(
+    "UPDATE passkeys SET counter = ?, last_used = ?, backed_up = ? WHERE id = ?",
+  ).run(counter, new Date().toISOString(), Number(backedUp), id);
+}
+export function renameKey(id: string, name: string) {
+  db.prepare("UPDATE passkeys SET name = ? WHERE id = ?").run(name, id);
+}
+export function removeKey(id: string) {
+  db.prepare("DELETE FROM passkeys WHERE id = ?").run(id);
+}
+export function rateLimit(key: string) {
+  db.prepare("DELETE FROM attempts WHERE expires < ?").run(Date.now());
+  const row = db
+    .prepare(
+      "INSERT INTO attempts VALUES (?, 1, ?) ON CONFLICT(key) DO UPDATE SET count = count + 1 RETURNING count",
+    )
+    .get(key, Date.now() + 60000) as { count: number };
+  return row.count <= 20;
+}
