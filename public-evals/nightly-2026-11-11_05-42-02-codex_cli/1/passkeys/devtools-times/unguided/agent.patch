diff --git a/src/pages/api/auth/[action].ts b/src/pages/api/auth/[action].ts
new file mode 100644
index 0000000..955a7a0
--- /dev/null
+++ b/src/pages/api/auth/[action].ts
@@ -0,0 +1,365 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  generateAuthenticationOptions,
+  verifyRegistrationResponse,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import * as store from "../../../lib/auth-store";
+
+export const ALL: APIRoute = async ({ request, cookies, params, url }) => {
+  const json = (body: unknown, status = 200) =>
+    Response.json(body, { status, headers: { "Cache-Control": "no-store" } });
+  const action = params.action;
+  const origin = process.env.AUTH_ORIGIN || url.origin;
+  const rpID = new URL(origin).hostname;
+  const cookieOptions = {
+    httpOnly: true,
+    secure: new URL(origin).protocol === "https:",
+    sameSite: "lax" as const,
+    path: import.meta.env.BASE_URL,
+    maxAge: 86400,
+  };
+  let session = store.sessionById(cookies.get("times_session")?.value || "");
+  let user = session?.user_id ? store.userById(session.user_id) : undefined;
+  const establish = (id: string) => {
+    if (session) store.deleteSession(session.id);
+    session = store.newSession(id);
+    cookies.set("times_session", session.id, cookieOptions);
+  };
+  if (request.method === "GET" && action === "account") {
+    if (!user)
+      return json({ error: "Please sign in to manage your account." }, 401);
+    return json({
+      username: user.username,
+      hasPassword: !!user.password,
+      passkeys: store
+        .keysFor(user.id)
+        .map(({ id, name, created_at, last_used, backed_up }) => ({
+          id,
+          name,
+          createdAt: created_at,
+          lastUsed: last_used,
+          backedUp: !!backed_up,
+        })),
+    });
+  }
+  if (request.method !== "POST")
+    return json({ error: "Method not allowed." }, 405);
+  if (request.headers.get("origin") !== origin)
+    return json(
+      {
+        error:
+          "This request could not be verified. Reload the page and try again.",
+      },
+      403,
+    );
+  if (
+    !store.rateLimit(
+      `${request.headers.get("x-forwarded-for")?.split(",")[0] || "local"}:${action}`,
+    )
+  )
+    return json(
+      { error: "Too many attempts. Please wait a minute and try again." },
+      429,
+    );
+  try {
+    const body = await request.json();
+    const username =
+      typeof body.username === "string"
+        ? body.username.trim().toLowerCase()
+        : "";
+    const password = typeof body.password === "string" ? body.password : "";
+    const name =
+      typeof body.name === "string"
+        ? body.name.trim().slice(0, 60)
+        : "My passkey";
+    if (action === "logout") {
+      if (session) store.deleteSession(session.id);
+      cookies.delete("times_session", { path: import.meta.env.BASE_URL });
+      return json({ ok: true });
+    }
+    if (action === "password-signup" || action === "password-signin") {
+      if (!/^[a-z0-9_.@+-]{3,100}$/.test(username))
+        return json(
+          {
+            error:
+              "Enter a username of 3–100 letters, numbers, or email characters.",
+          },
+          400,
+        );
+      const existing = store.userByName(username);
+      if (action === "password-signup") {
+        if (existing)
+          return json(
+            { error: "This username is already in use. Try signing in." },
+            409,
+          );
+        if (
+          password.length < 8 ||
+          !/\d/.test(password) ||
+          password.length > 256
+        )
+          return json(
+            {
+              error:
+                "Use at least 8 characters, including a number (maximum 256).",
+            },
+            400,
+          );
+        user = store.createUser(username, password);
+      } else {
+        if (!password || password.length > 256)
+          return json({ error: "Enter your password to continue." }, 400);
+        if (existing) {
+          if (!store.checkPassword(existing, password))
+            return json(
+              {
+                error:
+                  "The username or password is incorrect. If you registered with a passkey, use that to sign in.",
+              },
+              401,
+            );
+          user = existing;
+        } else {
+          // Preserve sign-in for accounts created with the original password service.
+          const legacy = await fetch(
+            "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login",
+            {
+              method: "POST",
+              headers: { "Content-Type": "application/json" },
+              body: JSON.stringify({ username, password }),
+              signal: AbortSignal.timeout(10000),
+            },
+          );
+          if (!legacy.ok)
+            return json(
+              { error: "The username or password is incorrect." },
+              401,
+            );
+          // A verified password login provisions an account for passkey enrollment.
+          user = store.createUser(username, password);
+        }
+      }
+      establish(user.id);
+      return json({ ok: true });
+    }
+    if (action === "password-reauth") {
+      if (!user || !session)
+        return json({ error: "Please sign in again." }, 401);
+      if (password.length > 256 || !store.checkPassword(user, password))
+        return json(
+          { error: "That password is incorrect. Please try again." },
+          401,
+        );
+      store.verifySession(session.id);
+      return json({ ok: true });
+    }
+    if (action === "registration-options") {
+      const signup = body.signup === true;
+      if (!signup && (!user || !session))
+        return json({ error: "Please sign in again." }, 401);
+      if (!signup && session!.verified_at < Date.now() - 300000)
+        return json(
+          { error: "Confirm your identity to add a passkey.", reauth: true },
+          403,
+        );
+      if (
+        signup &&
+        (!/^[a-z0-9_.@+-]{3,100}$/.test(username) || store.userByName(username))
+      )
+        return json(
+          { error: "Choose an available username of 3–100 characters." },
+          400,
+        );
+      if (!session) {
+        session = store.newSession();
+        cookies.set("times_session", session.id, cookieOptions);
+      }
+      const userId = signup ? store.token() : user!.id;
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times",
+        rpID,
+        userName: signup ? username : user!.username,
+        userID: new TextEncoder().encode(userId),
+        attestationType: "none",
+        excludeCredentials: signup
+          ? []
+          : store.keysFor(user!.id).map((key) => ({ id: key.id })),
+        authenticatorSelection: {
+          residentKey: "required",
+          userVerification: "required",
+        },
+      });
+      store.saveChallenge(session.id, {
+        value: options.challenge,
+        purpose: signup ? "signup" : "add",
+        userId,
+        username: signup ? username : user!.username,
+        name: name || "My passkey",
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    if (action === "authentication-options") {
+      const reauth = body.reauth === true;
+      if (reauth && !user) return json({ error: "Please sign in again." }, 401);
+      if (!session) {
+        session = store.newSession();
+        cookies.set("times_session", session.id, cookieOptions);
+      }
+      const keys = reauth ? store.keysFor(user!.id) : [];
+      if (reauth && !keys.length)
+        return json(
+          { error: "Use your password to confirm your identity." },
+          400,
+        );
+      const options = await generateAuthenticationOptions({
+        rpID,
+        userVerification: "required",
+        ...(reauth
+          ? { allowCredentials: keys.map((key) => ({ id: key.id })) }
+          : {}),
+      });
+      store.saveChallenge(session.id, {
+        value: options.challenge,
+        purpose: reauth ? "reauth" : "signin",
+        userId: reauth ? user!.id : undefined,
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    if (
+      action === "registration-verify" ||
+      action === "authentication-verify"
+    ) {
+      if (!session)
+        return json({ error: "Your request expired. Please try again." }, 400);
+      const challenge = store.takeChallenge(session);
+      if (!challenge || challenge.expires < Date.now())
+        return json({ error: "Your request expired. Please try again." }, 400);
+      if (action === "registration-verify") {
+        if (
+          !["signup", "add"].includes(challenge.purpose) ||
+          (challenge.purpose === "add" && user?.id !== challenge.userId)
+        )
+          return json({ error: "Invalid registration request." }, 400);
+        const result = await verifyRegistrationResponse({
+          response: body.credential,
+          expectedChallenge: challenge.value,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          requireUserVerification: true,
+        });
+        if (!result.verified || !result.registrationInfo)
+          throw new Error("Verification failed");
+        if (challenge.purpose === "signup") {
+          if (store.userByName(challenge.username!))
+            return json(
+              { error: "This username is now in use. Please choose another." },
+              409,
+            );
+          user = store.createUser(
+            challenge.username!,
+            undefined,
+            challenge.userId!,
+          );
+        }
+        const { credential, credentialBackedUp } = result.registrationInfo;
+        store.addKey({
+          id: credential.id,
+          user_id: user!.id,
+          name: challenge.name!,
+          public_key: Buffer.from(credential.publicKey).toString("base64url"),
+          counter: credential.counter,
+          transports: JSON.stringify(credential.transports || []),
+          created_at: new Date().toISOString(),
+          last_used: null,
+          backed_up: Number(credentialBackedUp),
+        });
+        if (challenge.purpose === "signup") establish(user!.id);
+      } else {
+        if (!["signin", "reauth"].includes(challenge.purpose))
+          return json({ error: "Invalid authentication request." }, 400);
+        const key = store.keyById(body.credential.id);
+        if (
+          !key ||
+          (challenge.purpose === "reauth" &&
+            (key.user_id !== user?.id || key.user_id !== challenge.userId))
+        )
+          return json(
+            { error: "This passkey does not belong to this account." },
+            401,
+          );
+        if (
+          body.credential.response.userHandle &&
+          Buffer.from(
+            body.credential.response.userHandle,
+            "base64url",
+          ).toString("utf8") !== key.user_id
+        )
+          return json({ error: "This passkey could not be verified." }, 401);
+        const result = await verifyAuthenticationResponse({
+          response: body.credential,
+          expectedChallenge: challenge.value,
+          expectedOrigin: origin,
+          expectedRPID: rpID,
+          credential: {
+            id: key.id,
+            publicKey: new Uint8Array(Buffer.from(key.public_key, "base64url")),
+            counter: key.counter,
+            transports: JSON.parse(key.transports),
+          },
+          requireUserVerification: true,
+        });
+        if (!result.verified) throw new Error("Verification failed");
+        store.updateKey(
+          key.id,
+          result.authenticationInfo.newCounter,
+          result.authenticationInfo.credentialBackedUp,
+        );
+        if (challenge.purpose === "reauth") store.verifySession(session.id);
+        else establish(key.user_id);
+      }
+      return json({ ok: true });
+    }
+    if (action === "rename" || action === "remove") {
+      if (!user || !session)
+        return json({ error: "Please sign in again." }, 401);
+      if (session.verified_at < Date.now() - 300000)
+        return json(
+          { error: "Confirm your identity to continue.", reauth: true },
+          403,
+        );
+      const key = store.keyById(body.id);
+      if (!key || key.user_id !== user.id)
+        return json({ error: "Passkey not found." }, 404);
+      if (action === "rename") {
+        if (!name)
+          return json({ error: "Enter a name for this passkey." }, 400);
+        store.renameKey(key.id, name);
+      } else {
+        if (!user.password && store.keysFor(user.id).length <= 1)
+          return json(
+            {
+              error:
+                "Add another passkey before removing your only sign-in method.",
+            },
+            400,
+          );
+        store.removeKey(key.id);
+      }
+      return json({ ok: true });
+    }
+    return json({ error: "Not found." }, 404);
+  } catch (error) {
+    console.error(
+      "Authentication request failed:",
+      error instanceof Error ? error.message : "Unknown error",
+    );
+    return json(
+      { error: "We couldn’t verify this request. Please try again." },
+      400,
+    );
+  }
+};
