diff --git a/tests/auth-store.test.ts b/tests/auth-store.test.ts
new file mode 100644
index 0000000..3fe0168
--- /dev/null
+++ b/tests/auth-store.test.ts
@@ -0,0 +1,74 @@
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+const directory = mkdtempSync(join(tmpdir(), "times-auth-"));
+process.env.AUTH_DB_PATH = join(directory, "auth.sqlite");
+const store = await import("../src/lib/auth-store.ts");
+after(() => rmSync(directory, { recursive: true, force: true }));
+
+test("a WebAuthn challenge is consumed once, including with a stale session snapshot", () => {
+  const session = store.newSession();
+  store.saveChallenge(session.id, {
+    value: "challenge",
+    purpose: "signin",
+    expires: Date.now() + 300000,
+  });
+  const stale = store.sessionById(session.id)!;
+  assert.equal(store.takeChallenge(stale)?.value, "challenge");
+  assert.equal(store.takeChallenge(stale), undefined);
+});
+
+test("a deleted session cannot be used to recover a pending challenge", () => {
+  const session = store.newSession();
+  store.saveChallenge(session.id, {
+    value: "secret",
+    purpose: "reauth",
+    expires: Date.now() + 300000,
+  });
+  const stale = store.sessionById(session.id)!;
+  store.deleteSession(session.id);
+  assert.equal(store.sessionById(session.id), undefined);
+  assert.equal(store.takeChallenge(stale), undefined);
+});
+
+test("passkey-only users have no password fallback and retain the WebAuthn user ID", () => {
+  const id = store.token();
+  const user = store.createUser("passkey-reader", undefined, id);
+  assert.equal(user.id, id);
+  assert.equal(user.password, null);
+  assert.equal(store.checkPassword(user, "anything123"), false);
+  assert.throws(() => store.createUser("passkey-reader"));
+});
+
+test("passwords are salted, reject incorrect values, and are never stored as plaintext", () => {
+  const first = store.createUser("reader-one", "secure-password-123");
+  const second = store.createUser("reader-two", "secure-password-123");
+  assert.notEqual(first.password, second.password);
+  assert.ok(!first.password?.includes("secure-password-123"));
+  assert.equal(store.checkPassword(first, "secure-password-123"), true);
+  assert.equal(store.checkPassword(first, "incorrect"), false);
+});
+
+test("passkeys are scoped to their owner and retain counters and usage metadata", () => {
+  const owner = store.createUser("key-owner");
+  const other = store.createUser("other-owner");
+  store.addKey({
+    id: "credential-id",
+    user_id: owner.id,
+    name: "Laptop",
+    public_key: "public-key",
+    counter: 0,
+    transports: "[]",
+    created_at: new Date().toISOString(),
+    last_used: null,
+    backed_up: 0,
+  });
+  assert.equal(store.keysFor(other.id).length, 0);
+  assert.equal(store.keysFor(owner.id).length, 1);
+  store.updateKey("credential-id", 4, true);
+  assert.equal(store.keyById("credential-id")?.counter, 4);
+  assert.equal(store.keyById("credential-id")?.backed_up, 1);
+  assert.ok(store.keyById("credential-id")?.last_used);
+});
