@@ -0,0 +1,44 @@
+import React, { useEffect, useState } from "react";
+import { UserCircleIcon } from "@heroicons/react/24/outline";
+import { api, base } from "../lib/auth-client";
+export default function AccountNav() {
+  const [signedIn, setSignedIn] = useState(false);
+  useEffect(() => {
+    let active = true;
+    api("account")
+      .then(() => {
+        if (active) setSignedIn(true);
+      })
+      .catch(() => {});
+    return () => {
+      active = false;
+    };
+  }, []);
+  return signedIn ? (
+    <a
+      href={`${base}account/settings`}
+      className="header-account-link"
+      data-skip-tracking="true"
+    >
+      <UserCircleIcon width={17} />
+      My account
+    </a>
+  ) : (
+    <>
+      <a
+        href={`${base}signup`}
+        data-skip-tracking="true"
+        className="header-signup-link"
+      >
+        Sign up
+      </a>
+      <a
+        href={`${base}signin`}
+        data-skip-tracking="true"
+        className="header-signin-link"
+      >
+        Sign in <span aria-hidden="true">↗</span>
+      </a>
+    </>
+  );
+}
diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
