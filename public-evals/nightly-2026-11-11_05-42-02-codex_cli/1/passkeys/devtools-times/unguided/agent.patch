+}
+/* Account experiences share the quiet, editorial character of the newspaper. */
+:root {
+  --account-ink: #202a27;
+  --account-green: #164f40;
+  --account-muted: #727873;
+  --account-line: #e3e7e3;
+}
+.account-breadcrumb {
+  margin: 0 48px;
+  padding: 23px 0;
+  display: flex;
+  align-items: center;
+  gap: 13px;
+  border-bottom: 1px solid var(--account-line);
+  color: #8b918b;
+  font:
+    11px Arial,
+    sans-serif;
+}
+.account-breadcrumb a {
+  color: #5c655f;
+}
+.account-breadcrumb > span:nth-child(3) {
+  color: #343f38;
+}
+.secure-connection {
+  margin-left: auto;
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  font-size: 9px;
+  letter-spacing: 1.25px;
+}
+.auth-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  padding: 44px 48px 48px;
+  gap: 54px;
+  font-family: Arial, sans-serif;
+  color: var(--account-ink);
+}
+.auth-main {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 16px 0;
+}
+.auth-form-wrap {
+  width: 100%;
+  max-width: 392px;
+}
+.eyebrow {
+  font:
+    9px Arial,
+    sans-serif;
+  letter-spacing: 1.7px;
+  font-weight: 600;
+  display: flex;
+  align-items: center;
+  gap: 9px;
+  color: var(--account-green);
+}
+.eyebrow-line {
+  height: 1px;
+  width: 23px;
+  background: var(--account-green);
+}
+.auth-form-wrap h1 {
+  font:
+    44px/1.13 Georgia,
+    serif;
+  letter-spacing: -1.7px;
+  margin: 19px 0 13px;
+  white-space: pre-line;
+}
+.auth-intro {
+  font-size: 12px;
+  line-height: 1.8;
+  color: var(--account-muted);
+  margin-bottom: 31px;
+}
