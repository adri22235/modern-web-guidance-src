@@ -0,0 +1,151 @@
+'use strict';
+// Static UI demonstration. Production WebAuthn challenges, attestation/assertion
+// verification, account ownership and sessions must be enforced by a server.
+const $ = (selector) => document.querySelector(selector);
+const storageKey = 'daily-grind-account-v1';
+const initial = { name: 'Alex Morgan', email: 'alex.morgan@email.com', since: 'March 2026', demo: true, passkeys: [
+  { id: 'sample-mac', name: 'MacBook Pro', type: 'laptop', created: 'May 12, 2026', last: 'Just now', sample: true },
+  { id: 'sample-iphone', name: 'iPhone 15', type: 'phone', created: 'May 10, 2026', last: '2 days ago', sample: true }
+] };
+let account;
+try { const saved = JSON.parse(localStorage.getItem(storageKey)); account = saved && typeof saved.name === 'string' && typeof saved.email === 'string' && Array.isArray(saved.passkeys) ? saved : structuredClone(initial); } catch { account = structuredClone(initial); }
+let signedIn = sessionStorage.getItem('dg-signed-out') !== 'true';
+let submitAction = null;
+let toastTimer;
+const dialog = $('#account-dialog');
+const escapeHtml = (value) => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const icon = (name) => `<svg aria-hidden="true"><use href="#i-${name}"/></svg>`;
+function save() { try { localStorage.setItem(storageKey, JSON.stringify(account)); } catch { toast('Your browser could not save these changes.'); } }
+function toast(message) { $('#toast').textContent = message; $('#toast').classList.add('visible'); clearTimeout(toastTimer); toastTimer = setTimeout(() => $('#toast').classList.remove('visible'), 4500); }
+function render() {
+  document.body.classList.toggle('signed-out', !signedIn);
+  document.querySelectorAll('[data-name]').forEach(el => el.textContent = signedIn ? account.name : 'Welcome, coffee lover');
+  document.querySelectorAll('[data-email]').forEach(el => el.textContent = signedIn ? account.email : 'Sign in to make yourself at home');
+  $('[data-first-name]').textContent = signedIn ? account.name.trim().split(/\s+/)[0] : 'coffee lover';
+  $('[data-initials]').textContent = signedIn ? account.name.trim().split(/\s+/).map(v => v[0]).slice(0, 2).join('').toUpperCase() : 'DG';
+  $('#member-since').textContent = signedIn ? account.since : '—';
+  $('.signout').innerHTML = icon(signedIn ? 'out' : 'user') + (signedIn ? 'Sign out' : 'Sign in / Register');
+  $('#passkey-count').textContent = signedIn ? account.passkeys.length : 0;
+  $('.status').innerHTML = `<i></i>${account.passkeys.length ? 'Protected' : 'Set up a passkey'}`;
+  $('.rewards-banner p').innerHTML = signedIn ? 'You have <strong>120 points.</strong> Your daily ritual is adding up.' : 'Sign in to see your points and your next reward.';
+  $('#passkey-list').innerHTML = !signedIn ? '<p class="empty-passkeys">Your next coffee is one sign-in away. Sign in or create your account to get started.</p>' : account.passkeys.length ? account.passkeys.map((key, i) => `<div class="passkey-row"><div class="device-icon">${icon(key.type === 'phone' ? 'phone' : 'laptop')}</div><div class="device-info"><div class="device-title"><h4>${escapeHtml(key.name)}</h4>${i === 0 ? '<span class="current-tag">Primary passkey</span>' : ''}</div><p>Added ${escapeHtml(key.created)} <span>·</span> ${key.sample ? 'Demo passkey' : 'Device passkey'} <span>·</span> Last used ${escapeHtml(key.last)}</p></div><div class="row-actions"><button data-rename="${escapeHtml(key.id)}" aria-label="Rename ${escapeHtml(key.name)}">Rename</button><button data-remove="${escapeHtml(key.id)}" aria-label="Remove ${escapeHtml(key.name)}">Remove</button></div></div>`).join('') : '<p class="empty-passkeys">No passkeys yet. Add one for a simpler, safer sign-in.</p>';
+  $('[data-action="add"]').innerHTML = signedIn ? '<span>＋</span> Add a passkey' : icon('key') + ' Sign in with a passkey';
+}
+function modal({ title, copy = '', content = '', primary = 'Continue', secondary = 'Cancel', onSubmit = null, onSecondary = null, symbol = 'key' }) {
+  $('#dialog-content').innerHTML = `${icon(symbol).replace('<svg ', '<svg class="modal-symbol" ')}<h2 class="modal-title" id="modal-title">${escapeHtml(title)}</h2>${copy ? `<p class="modal-copy">${copy}</p>` : ''}${content}`;
+  $('#dialog-error').textContent = '';
+  $('#dialog-actions').innerHTML = `${primary ? `<button class="button dark" type="submit">${escapeHtml(primary)}</button>` : ''}${secondary ? `<button class="button" type="button" id="modal-secondary">${escapeHtml(secondary)}</button>` : ''}`;
+  if (secondary) $('#modal-secondary').onclick = onSecondary || (() => dialog.close());
+  submitAction = onSubmit;
+  dialog.setAttribute('aria-labelledby', 'modal-title');
+  if (!dialog.open) dialog.showModal();
+}
+function info(title, copy, symbol = 'shield') { modal({title, copy, primary: null, secondary: 'Got it', symbol}); }
+$('#dialog-form').addEventListener('submit', async e => {
+  e.preventDefault(); if (!submitAction) return;
+  const button = $('#dialog-actions [type="submit"]');
+  const action = submitAction;
+  button.disabled = true; $('#dialog-error').textContent = '';
+  try { await action(new FormData(e.target)); } catch (error) {
+    $('#dialog-error').textContent = error.name === 'NotAllowedError' ? 'Verification was canceled or timed out. You can try again.' : error.name === 'InvalidStateError' ? 'This device already has that passkey. Try a different authenticator.' : error.message || 'Something went wrong. Please try again.';
+  } finally { if (button.isConnected) button.disabled = false; }
+});
+const field = (label, name, value = '', type = 'text', extra = '') => `<label for="field-${name}">${label}</label><input id="field-${name}" name="${name}" type="${type}" value="${escapeHtml(value)}" required maxlength="${name === 'email' ? 254 : 80}" ${extra}>`;
+const randomBytes = () => crypto.getRandomValues(new Uint8Array(32));
+const encode = (buffer) => btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
+const decode = (value) => Uint8Array.from(atob(value.replace(/-/g, '+').replace(/_/g, '/') + '='.repeat((4 - value.length % 4) % 4)), c => c.charCodeAt(0));
+function checkSupport() {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) throw new Error('Passkeys require a supported browser over HTTPS or localhost. You can still explore the demo account.');
+}
+async function createCredential(profile) {
+  checkSupport();
+  const credential = await navigator.credentials.create({ publicKey: {
+    challenge: randomBytes(), rp: { name: 'The Daily Grind' },
+    user: { id: randomBytes(), name: profile.email, displayName: profile.name },
+    pubKeyCredParams: [{type: 'public-key', alg: -7}, {type: 'public-key', alg: -257}],
+    authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+    excludeCredentials: profile.passkeys.filter(k => !k.sample).map(k => ({type: 'public-key', id: decode(k.id)})),
+    timeout: 60000, attestation: 'none'
+  }});
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  return encode(credential.rawId);
+}
+async function authenticate() {
+  checkSupport();
+  const keys = account.passkeys.filter(k => !k.sample);
+  if (!keys.length) throw new Error('This preview account has demo passkeys. Use “Continue with demo account” to explore, or add a device passkey first.');
+  const credential = await navigator.credentials.get({ publicKey: { challenge: randomBytes(), allowCredentials: keys.map(k => ({id: decode(k.id), type: 'public-key'})), userVerification: 'required', timeout: 60000 } });
+  const match = credential && keys.find(k => k.id === encode(credential.rawId));
+  if (!match) throw new Error('That passkey does not belong to this local account.');
+  match.last = 'Just now'; save();
+}
+function reauthenticate(next) {
+  if (!signedIn) { signIn(); return; }
+  modal({ title: 'A quick check. Then you’re in.', copy: 'Verify it’s you before changing your account. Use your fingerprint, face, or device screen lock.', primary: 'Verify with a passkey', secondary: account.demo ? 'Verify demo account' : 'Cancel', content: '<p class="modal-note">This preview verifies on your device only. Production verification requires a secure server.</p>', onSubmit: async () => { await authenticate(); next(); }, onSecondary: account.demo ? () => { next(); } : null });
+}
+function signIn() {
+  modal({ title: 'Welcome back.', copy: 'Your favorites are waiting. Sign in with a passkey and settle in.', primary: 'Sign in with a passkey', secondary: 'Create an account', content: `${account.demo ? '<button class="text-link" type="button" id="demo-signin">Continue with demo account →</button>' : ''}<p class="modal-note">Device passkeys work for the account saved in this browser. This is a local preview, not a production sign-in.</p>`, onSubmit: async () => { await authenticate(); signedIn = true; sessionStorage.removeItem('dg-signed-out'); render(); dialog.close(); toast(`Welcome back, ${account.name.split(' ')[0]}.`); }, onSecondary: register });
+  if ($('#demo-signin')) $('#demo-signin').onclick = () => { signedIn = true; sessionStorage.removeItem('dg-signed-out'); render(); dialog.close(); toast('You’re exploring the demo account.'); };
+}
+function register() {
+  modal({ title: 'Make yourself at home.', copy: 'Create a local preview account with a passkey. No password needed.', content: field('Full name', 'name', '', 'text', 'autocomplete="name"') + field('Email address', 'email', '', 'email', 'autocomplete="email"') + '<p class="modal-note">This static preview stores one account in this browser. Creating one replaces the preview profile. Never use this demo as a real account.</p>', primary: 'Create account with a passkey', secondary: 'Back to sign in', onSecondary: signIn, onSubmit: async data => {
+    const name = data.get('name').trim(); const email = data.get('email').trim();
+    if (!name) throw new Error('Please enter your name.');
+    const profile = { name, email, since: new Date().toLocaleDateString('en-US', {month:'long', year:'numeric'}), demo: false, passkeys: [] };
+    const id = await createCredential(profile);
+    profile.passkeys.push({id, name:'My first passkey', type:'laptop', created:new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}), last:'Just now'});
+    account = profile; signedIn = true; sessionStorage.removeItem('dg-signed-out'); save(); render(); dialog.close(); toast('Welcome to the neighborhood. Your passkey is ready.');
+  }});
+}
+function addPasskey() {
+  if (!signedIn) return signIn();
+  reauthenticate(() => modal({ title: 'Your daily, one touch away.', copy: 'Save a passkey to your device or password manager. Give it a name so it’s easy to recognize.', content: field('Passkey name', 'keyname', '', 'text', 'placeholder="e.g. My MacBook"') + '<p class="modal-note">Your device will ask for your fingerprint, face, or screen lock. Your biometrics are never shared with us.</p>', primary:'Create passkey', onSubmit: async data => {
+    const name = data.get('keyname').trim(); if (!name) throw new Error('Please give your passkey a name.');
+    const id = await createCredential(account);
+    account.passkeys.push({id, name, type:/iPhone|Android|Mobile/i.test(navigator.userAgent) ? 'phone' : 'laptop', created:new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}), last:'Not yet'});
+    save(); render(); dialog.close(); toast('Passkey added. A simpler sign-in is ready.');
+  }}));
+}
+function editProfile() {
+  reauthenticate(() => modal({ title:'The details that make you, you.', copy:'Keep your local account details up to date.', symbol:'user', content:field('Full name','name',account.name,'text','autocomplete="name"') + field('Email address','email',account.email,'email','autocomplete="email"') + '<p class="modal-note">Email updates in this preview are local only. A production account must verify ownership of the new email address.</p>', primary:'Save changes', onSubmit:data => {
+    const name = data.get('name').trim(); if (!name) throw new Error('Please enter your name.');
+    account.name = name; account.email = data.get('email').trim(); save(); render(); dialog.close(); toast('Your profile feels a little more like you. Changes saved.');
+  }}));
+}
+function renamePasskey(id) {
+  if (!signedIn) return signIn();
+  const key = account.passkeys.find(k => k.id === id); if (!key) return;
+  modal({title:'A name you’ll remember.', copy:'Choose a recognizable name for this passkey.', content:field('Passkey name','keyname',key.name), primary:'Save name', onSubmit:data => { const name = data.get('keyname').trim(); if (!name) throw new Error('Please enter a passkey name.'); key.name = name; save(); render(); dialog.close(); toast('Passkey renamed.'); }});
+}
+function removePasskey(id) {
+  const key = account.passkeys.find(k => k.id === id); if (!key) return;
+  if (account.passkeys.length === 1) return info('Keep a way back in.', 'This is your last passkey. Add another passkey before removing it so you can always sign in.');
+  reauthenticate(() => modal({title:'Remove this passkey?', copy:`“${escapeHtml(key.name)}” will no longer be available for sign-in to this local account. You can add a new passkey anytime.`, content:'<p class="modal-note">This removes the saved credential from the preview. You may also need to remove it in your device’s password manager.</p>', primary:'Remove passkey', onSubmit:() => {account.passkeys = account.passkeys.filter(k => k.id !== id); save(); render(); dialog.close(); toast('Passkey removed.');}}));
+}
+document.addEventListener('click', event => {
+  const rename = event.target.closest('[data-rename]'); if (rename) return renamePasskey(rename.dataset.rename);
+  const remove = event.target.closest('[data-remove]'); if (remove) return removePasskey(remove.dataset.remove);
+  const coffee = event.target.closest('[data-coffee]'); if (coffee) return info(coffee.dataset.coffee, ({'Maple Oat Latte':'Creamy oat milk and a little Vermont maple syrup. Your cozy morning companion.','Dark Roast Espresso':'Bold, smoky, and roasted for a beautifully rich finish.','Cold Brew':'Slow-steeped for 18 hours. Smooth, refreshing, and ready for your daily.'})[coffee.dataset.coffee] + ' Visit your neighborhood Daily Grind to enjoy a cup.', 'cup');
+  const tab = event.target.closest('[data-tab]');
+  if (tab) {
+    document.querySelectorAll('[data-tab]').forEach(el => el.classList.toggle('active', el === tab));
+    if (tab.dataset.tab === 'orders') return signedIn ? info('Your next ritual is waiting.', 'No orders yet. Explore our coffee collection and find your next favorite.', 'bag') : signIn();
+    if (tab.dataset.tab === 'rewards') return showRewards();
+    const target = tab.dataset.tab === 'overview' ? $('#account') : document.getElementById(tab.dataset.tab);
+    target.scrollIntoView({behavior:'smooth', block:'start'}); return;
+  }
+  const action = event.target.closest('[data-action]')?.dataset.action;
+  const actions = {
+    close:() => dialog.close(),
+    signout:() => {if (!signedIn) return signIn(); signedIn = false; sessionStorage.setItem('dg-signed-out','true'); render(); toast('You’re signed out. See you for your next cup.');},
+    add:addPasskey, edit:editProfile, learn:() => info('A familiar touch. A safer sign-in.', 'Passkeys replace passwords with your device’s fingerprint, face recognition, or screen lock. Your private key stays with your device or password manager. You can save several passkeys and use another device when you need to.'),
+    'demo-info':() => info('A little look around.', 'This is a static account preview. The sample account, points, and two sample passkeys are for demonstration. Profile changes and credential IDs are stored in this browser. Device passkey prompts use WebAuthn, but secure registration, verified authentication, email ownership, and real sessions require a backend. Demo verification is available only on the sample account.'),
+    rewards:showRewards, shop:() => $('#favorites').scrollIntoView({behavior:'smooth'}),
+    privacy:() => info('Your space. Your privacy.', 'In this preview, account details and credential IDs are stored only in this browser. No biometric information is read or stored by this page. External fonts and the coffee photograph are loaded from Google Fonts and Unsplash. Clear your browser’s site data to remove your saved preview account.'),
+    terms:() => info('A note about this preview.', 'This page demonstrates the Daily Grind account experience. No purchases are processed, reward points have no monetary value, and this preview is not a production authentication service.')
+  };
+  if (actions[action]) actions[action]();
+});
+function showRewards() { if (!signedIn) return signIn(); info('Your daily is adding up.', 'You have 120 points in this preview. Earn 1 point for every $1 spent, and enjoy a free handcrafted drink at 200 points. Just 80 points to your next little pick-me-up.', 'gift'); }
+dialog.addEventListener('click', e => { if (e.target === dialog && (e.clientX < dialog.getBoundingClientRect().left || e.clientX > dialog.getBoundingClientRect().right || e.clientY < dialog.getBoundingClientRect().top || e.clientY > dialog.getBoundingClientRect().bottom)) dialog.close(); });
+render();
