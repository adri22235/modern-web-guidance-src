+  <script>
+    const seasonalTable = document.getElementById('seasonal-drinks');
+    const headers = Array.from(seasonalTable.querySelectorAll('thead th'));
+    const collator = new Intl.Collator('en', { sensitivity: 'base' });
+
+    headers.forEach((header, columnIndex) => {
+      header.querySelector('button').addEventListener('click', () => {
+        const ascending = header.getAttribute('aria-sort') !== 'ascending';
+        const rows = Array.from(seasonalTable.tBodies[0].rows);
+
+        rows.sort((first, second) => {
+          const comparison = collator.compare(
+            first.cells[columnIndex].textContent.trim(),
+            second.cells[columnIndex].textContent.trim()
+          );
+          return ascending ? comparison : -comparison;
+        });
+
+        headers.forEach((item) => item.setAttribute('aria-sort', 'none'));
+        header.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');
+        seasonalTable.tBodies[0].append(...rows);
+      });
+    });
+  </script>
