+  <script>
+    const table = document.getElementById('seasonal-drinks');
+    const tbody = table.tBodies[0];
+    const headers = [...table.tHead.rows[0].cells];
+    const status = document.getElementById('seasonal-sort-status');
+    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
+
+    function sortDrinks(button) {
+      const header = button.closest('th');
+      const direction = header.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+      const factor = direction === 'ascending' ? 1 : -1;
+      const rows = [...tbody.rows].sort((a, b) => factor * collator.compare(
+        a.cells[header.cellIndex].textContent.trim(),
+        b.cells[header.cellIndex].textContent.trim()
+      ));
+
+      headers.forEach((cell) => cell.removeAttribute('aria-sort'));
+      header.setAttribute('aria-sort', direction);
+      for (const row of rows) {
+        if (typeof tbody.moveBefore === 'function') {
+          tbody.moveBefore(row, null);
+        } else {
+          tbody.append(row);
+        }
+      }
+      status.textContent = `Sorted by ${button.textContent.trim()}, ${direction}, ${rows.length} drinks.`;
+    }
+
+    if ('commandForElement' in HTMLButtonElement.prototype) {
+      table.addEventListener('command', (event) => {
+        if (event.command === '--sort') sortDrinks(event.source);
+      });
+    } else {
+      table.querySelectorAll('thead button').forEach((button) => {
+        button.addEventListener('click', () => sortDrinks(button));
+      });
+    }
+  </script>
