+  <script>
+    const carousel = document.getElementById('seasonal-drinks');
+    const previous = document.getElementById('previous-drink');
+    const next = document.getElementById('next-drink');
+
+    function updateControls() {
+      previous.disabled = carousel.scrollLeft <= 1;
+      next.disabled = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 1;
+    }
+
+    function moveDrinks(direction) {
+      const cards = carousel.querySelectorAll('.card');
+      const step = cards[1].offsetLeft - cards[0].offsetLeft;
+      carousel.scrollBy({ left: direction * step });
+    }
+
+    previous.addEventListener('click', () => moveDrinks(-1));
+    next.addEventListener('click', () => moveDrinks(1));
+    carousel.addEventListener('scroll', updateControls, { passive: true });
+    window.addEventListener('resize', updateControls);
+    carousel.addEventListener('keydown', (event) => {
+      if (event.target !== carousel || event.altKey || event.ctrlKey || event.metaKey) return;
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        event.preventDefault();
+        moveDrinks(event.key === 'ArrowRight' ? 1 : -1);
+      } else if (event.key === 'Home' || event.key === 'End') {
+        event.preventDefault();
+        carousel.scrollTo({ left: event.key === 'Home' ? 0 : carousel.scrollWidth });
+      }
+    });
+
+    document.querySelectorAll('.detail-trigger').forEach((button) => {
+      button.addEventListener('click', () => {
+        const panel = document.getElementById(button.getAttribute('aria-controls'));
+        const expanded = button.getAttribute('aria-expanded') !== 'true';
+        const name = button.closest('.card').querySelector('h3').textContent;
+        button.setAttribute('aria-expanded', String(expanded));
+        button.setAttribute('aria-label', `${expanded ? 'Hide' : 'View'} details for ${name}`);
+        button.firstChild.textContent = expanded ? 'Hide Details ' : 'View Details ';
+        button.querySelector('span').textContent = expanded ? '−' : '+';
+        panel.inert = !expanded;
+        panel.setAttribute('aria-hidden', String(!expanded));
+        panel.classList.toggle('is-open', expanded);
+      });
+    });
+    updateControls();
+  </script>
