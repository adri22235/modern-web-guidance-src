+  <script type="module">
+    const track = document.querySelector('#drink-track');
+    const cards = [...track.children];
+    const markers = [...document.querySelectorAll('.slide-markers button')];
+    const status = document.querySelector('#drink-status');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    let pending = null;
+    let settled = 0;
+    let frame = 0;
+    let timer;
+
+    // Center snap positions, including clamped positions at the track's ends.
+    const position = (card) => Math.max(0, Math.min(
+      track.scrollWidth - track.clientWidth,
+      card.offsetLeft - (track.clientWidth - card.offsetWidth) / 2
+    ));
+    const nearest = () => cards.reduce((best, card, index) =>
+      Math.abs(position(card) - track.scrollLeft) <
+      Math.abs(position(cards[best]) - track.scrollLeft) ? index : best, 0);
+    const mark = (index) => markers.forEach((button, i) => {
+      if (i === index) button.setAttribute('aria-current', 'true');
+      else button.removeAttribute('aria-current');
+    });
+    const goTo = (index) => {
+      pending = (index + cards.length) % cards.length;
+      mark(pending);
+      track.scrollTo({ left: position(cards[pending]),
+        behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      // A click on the already visible slide produces no scrollend event.
+      if (Math.abs(track.scrollLeft - position(cards[pending])) < 1) settle();
+    };
+    const settle = () => {
+      if (pending !== null && Math.abs(track.scrollLeft - position(cards[pending])) > 2) return;
+      const current = nearest();
+      pending = null;
+      mark(current);
+      if (current !== settled) {
+        status.textContent = `${cards[current].querySelector('h3').textContent}, ${current + 1} of ${cards.length}`;
+        settled = current;
+      }
+    };
+    document.querySelector('#previous-drink').addEventListener('click', () => goTo((pending ?? nearest()) - 1));
+    document.querySelector('#next-drink').addEventListener('click', () => goTo((pending ?? nearest()) + 1));
+    markers.forEach((button, index) => button.addEventListener('click', () => goTo(index)));
+    const nativeScrollEnd = 'onscrollend' in track;
+    track.addEventListener('scroll', () => {
+      if (pending === null && !frame) frame = requestAnimationFrame(() => {
+        mark(nearest());
+        frame = 0;
+      });
+      if (!nativeScrollEnd) {
+        clearTimeout(timer);
+        timer = setTimeout(settle, 160);
+      }
+    }, { passive: true });
+    if (nativeScrollEnd) track.addEventListener('scrollend', settle);
+    // Let a new native gesture take over from button-initiated scrolling.
+    for (const event of ['pointerdown', 'wheel', 'keydown']) {
+      track.addEventListener(event, () => { pending = null; }, { passive: true });
+    }
+    document.querySelector('.carousel-controls').hidden = false;
+    document.querySelector('.slide-markers').hidden = false;
+    mark(nearest());
+
+    const drinks = {
+      maple: {
+        title: 'Maple Oat Latte',
+        description: 'Espresso meets creamy oat milk and a hint of Vermont maple syrup for a mellow, gently sweet seasonal cup.',
+        notes: 'Flavor notes: maple sweetness and smooth roasted coffee.',
+        url: '/menu/seasonal'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'A bold, concentrated espresso with a smoky character and a rich finish. A small cup with plenty of depth.',
+        notes: 'Flavor notes: deep roast and a smoky finish.',
+        url: '/menu/espresso'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Coffee steeped slowly for 18 hours for a smooth, refreshing brew. An easygoing way to enjoy a bold coffee flavor.',
+        notes: 'Brew method: an 18-hour cold steep for maximum smoothness.',
+        url: '/menu/cold-brew'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+    let openingAnimation;
+    document.querySelectorAll('.detail-trigger').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        const origin = button.getBoundingClientRect();
+        document.querySelector('#detail-title').textContent = drink.title;
+        document.querySelector('#detail-description').textContent = drink.description;
+        document.querySelector('#detail-notes').textContent = drink.notes;
+        document.querySelector('#detail-menu-link').href = drink.url;
+        openingAnimation?.cancel();
+        dialog.showModal();
+        if (!reducedMotion.matches && typeof dialog.animate === 'function') {
+          const destination = dialog.getBoundingClientRect();
+          openingAnimation = dialog.animate([
+            { transform: `translate(${origin.left - destination.left}px, ${origin.top - destination.top}px) scale(${origin.width / destination.width}, ${origin.height / destination.height})`, opacity: 0.35 },
+            { transform: 'translate(0, 0) scale(1)', opacity: 1 }
+          ], { duration: 340, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
+        }
+      });
+    });
+    dialog.addEventListener('close', () => openingAnimation?.cancel());
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) openingAnimation?.cancel();
+    });
+  </script>
