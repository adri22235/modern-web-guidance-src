+  <script>
+    const seasonalPreview = document.getElementById('seasonal-preview');
+    let previewSource = null;
+
+    // Native interest invokers handle hover, keyboard focus, and touch long-press.
+    seasonalPreview.addEventListener('interest', (event) => {
+      previewSource = event.source;
+      seasonalPreview.textContent = previewSource.dataset.drink;
+      seasonalPreview.style.setProperty('--preview-accent', previewSource.dataset.accent);
+    });
+
+    seasonalPreview.addEventListener('loseinterest', (event) => {
+      // A previous invoker losing interest must not clear a newer preview.
+      if (event.source !== previewSource) return;
+      previewSource = null;
+      seasonalPreview.textContent = 'Select a drink to preview';
+      seasonalPreview.style.removeProperty('--preview-accent');
+    });
+  </script>
