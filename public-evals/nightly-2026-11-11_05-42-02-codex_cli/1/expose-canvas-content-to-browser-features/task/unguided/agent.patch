+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const ctx = canvas.getContext('2d');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('cup-milk');
+      const syrup = document.getElementById('cup-syrup');
+      const width = 520;
+      const height = 560;
+      // Canvas and native HTML share the same design-space coordinates.
+      const sleeve = { x: 94, y: 183, width: 296, height: 224 };
+      const parts = {
+        brand: { x: 117, y: 155, width: 250, height: 24 },
+        name: { x: sleeve.x + 28, y: sleeve.y + 14, width: sleeve.width - 56, height: 58 },
+        milk: { x: sleeve.x + 28, y: sleeve.y + 84, width: sleeve.width - 56, height: 58 },
+        syrup: { x: sleeve.x + 28, y: sleeve.y + 154, width: sleeve.width - 56, height: 58 },
+        summary: { x: 122, y: 424, width: 240, height: 54 }
+      };
+      for (const [part, rect] of Object.entries(parts)) {
+        const element = stage.querySelector(`[data-cup-part="${part}"]`);
+        Object.assign(element.style, {
+          left: `${rect.x / width * 100}%`, top: `${rect.y / height * 100}%`,
+          width: `${rect.width / width * 100}%`, height: `${rect.height / height * 100}%`
+        });
+      }
+
+      function ellipse(x, y, rx, ry, color) {
+        ctx.beginPath();
+        ctx.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2);
+        ctx.fillStyle = color;
+        ctx.fill();
+      }
+
+      function draw() {
+        if (!ctx) return;
+        const bounds = stage.getBoundingClientRect();
+        const dpr = window.devicePixelRatio || 1;
+        canvas.width = Math.round(bounds.width * dpr);
+        canvas.height = Math.round(bounds.height * dpr);
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+
+        ellipse(258, 508, 186, 19, '#e0d1bf');
+        ellipse(249, 498, 178, 16, '#faf5eb');
+        // The handle sits behind the gently tapered ceramic cup.
+        ctx.beginPath();
+        ctx.ellipse(410, 266, 57, 77, 0, 0, Math.PI * 2);
+        ctx.lineWidth = 23;
+        ctx.strokeStyle = '#e0cbb3';
+        ctx.stroke();
+        ctx.beginPath();
+        ctx.moveTo(74, 124);
+        ctx.lineTo(410, 124);
+        ctx.lineTo(380, 460);
+        ctx.quadraticCurveTo(375, 495, 242, 495);
+        ctx.quadraticCurveTo(109, 495, 104, 460);
+        ctx.closePath();
+        const ceramic = ctx.createLinearGradient(74, 0, 410, 0);
+        ceramic.addColorStop(0, '#e7d6bf');
+        ceramic.addColorStop(0.3, '#fffaf0');
+        ceramic.addColorStop(1, '#ead8bf');
+        ctx.fillStyle = ceramic;
+        ctx.fill();
+        ctx.save();
+        ctx.clip();
+        ctx.fillStyle = '#dfc6a8';
+        ctx.fillRect(sleeve.x - 20, sleeve.y, sleeve.width + 40, sleeve.height);
+        ctx.restore();
+        ellipse(242, 124, 168, 39, '#fff8ea');
+        const coffeeColors = { oat: '#bd8c60', whole: '#d5ac7e', almond: '#c59b70', soy: '#c99f78', none: '#523023' };
+        ellipse(242, 124, 152, 28, coffeeColors[milk.value]);
+        if (syrup.value !== 'none') {
+          const syrupColors = { maple: '#89512b', vanilla: '#f6dfb2', caramel: '#a96428', hazelnut: '#74442c' };
+          ctx.save();
+          ctx.beginPath();
+          ctx.ellipse(242, 124, 145, 24, 0, 0, Math.PI * 2);
+          ctx.clip();
+          ctx.beginPath();
+          for (let x = 120; x <= 365; x += 3) {
+            const y = 124 + Math.sin((x - 120) / 19) * 13;
+            if (x === 120) ctx.moveTo(x, y);
+            else ctx.lineTo(x, y);
+          }
+          ctx.strokeStyle = syrupColors[syrup.value];
+          ctx.lineWidth = 3;
+          ctx.stroke();
+          ctx.restore();
+        }
+        // Subtle steam, with no animation to distract from editing.
+        ctx.strokeStyle = '#b99b7d';
+        ctx.lineWidth = 2;
+        ctx.lineCap = 'round';
+        for (const x of [208, 242, 276]) {
+          ctx.beginPath();
+          ctx.moveTo(x, 72);
+          ctx.bezierCurveTo(x - 16, 54, x + 16, 46, x, 27);
+          ctx.stroke();
+        }
+      }
+
+      function update() {
+        const drink = milk.value === 'none' ? 'coffee' : 'latte';
+        document.getElementById('cup-owner').textContent = name.value.trim()
+          ? `${name.value.trim()}'s ${drink}` : `Your ${drink}`;
+        document.getElementById('cup-recipe').textContent =
+          `${milk.selectedOptions[0].text} · ${syrup.selectedOptions[0].text}`;
+        draw();
+      }
+      name.addEventListener('input', update);
+      milk.addEventListener('change', update);
+      syrup.addEventListener('change', update);
+      new ResizeObserver(draw).observe(stage);
+      // Moving between displays or changing zoom can change DPR without a resize.
+      let resolutionQuery;
+      function watchResolution() {
+        if (resolutionQuery) resolutionQuery.removeEventListener('change', onResolutionChange);
+        resolutionQuery = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        resolutionQuery.addEventListener('change', onResolutionChange);
+      }
+      function onResolutionChange() { draw(); watchResolution(); }
+      watchResolution();
+      update();
+    })();
+  </script>
+
