+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('cup-stage');
+      const form = document.getElementById('coffee-order');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('cup-milk');
+      const syrup = document.getElementById('cup-syrup');
+      const summary = document.getElementById('cup-summary');
+      const ctx = canvas.getContext('2d');
+      let nativeHTML = !!ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+      let width = 520;
+      const height = 570;
+      let formX = 0;
+      let frame = 0;
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.onpaint = null;
+        canvas.removeAttribute('content');
+        // Move the same form, preserving values, labels and keyboard interaction.
+        stage.append(form);
+      }
+
+      if (!nativeHTML) useOverlay();
+
+      function drawCup() {
+        if (!ctx) return;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        // All drawing uses CSS pixels; only the backing store uses device pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        const center = width / 2;
+        const cupWidth = Math.min(344, width - 40);
+        const left = center - cupWidth / 2;
+        const right = center + cupWidth / 2;
+
+        ctx.fillStyle = 'rgba(78, 52, 46, 0.12)';
+        ctx.beginPath();
+        ctx.ellipse(center, 550, cupWidth / 2, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // A warm paper cup, with a tapered base and a coffee-colored rim.
+        const paper = ctx.createLinearGradient(left, 0, right, 0);
+        paper.addColorStop(0, '#e7d6c1');
+        paper.addColorStop(0.3, '#fff7eb');
+        paper.addColorStop(1, '#efdfcc');
+        ctx.fillStyle = paper;
+        ctx.strokeStyle = '#c4aa8c';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(left, 145);
+        ctx.lineTo(left + 27, 524);
+        ctx.quadraticCurveTo(center, 550, right - 27, 524);
+        ctx.lineTo(right, 145);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        ctx.fillStyle = '#d1b89c';
+        ctx.beginPath();
+        ctx.ellipse(center, 145, cupWidth / 2 + 5, 28, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const coffeeColors = { oat: '#bd9469', whole: '#c7a17b', almond: '#b58e67', soy: '#c09b75', none: '#503126' };
+        ctx.fillStyle = coffeeColors[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(center, 142, cupWidth / 2 - 8, 20, 0, 0, Math.PI * 2);
+        ctx.fill();
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = syrup.value === 'caramel' ? '#935424' : '#e5c19a';
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(center, 142, cupWidth / 4, 9, 0, 0, Math.PI * 1.7);
+          ctx.stroke();
+        }
+
+        ctx.strokeStyle = '#b49a83';
+        ctx.lineWidth = 2;
+        ctx.lineCap = 'round';
+        for (const offset of [-28, 0, 28]) {
+          ctx.beginPath();
+          ctx.moveTo(center + offset, 96);
+          ctx.bezierCurveTo(center + offset - 14, 76, center + offset + 14, 65, center + offset, 45);
+          ctx.stroke();
+        }
+
+        if (nativeHTML) {
+          try {
+            // The 2D API also aligns native hit testing, selection and focus.
+            ctx.drawElementImage(form, formX, 190, form.offsetWidth, form.offsetHeight);
+          } catch {
+            useOverlay();
+          }
+        }
+      }
+
+      function requestDraw() {
+        if (nativeHTML) {
+          canvas.requestPaint();
+        } else if (!frame) {
+          frame = requestAnimationFrame(() => {
+            frame = 0;
+            drawCup();
+          });
+        }
+      }
+
+      function updateOrder() {
+        const drink = milk.value === 'none' ? 'coffee' : `${milk.value} latte`;
+        const flavor = syrup.value === 'none' ? '' : `${syrup.value} `;
+        const cupName = name.value.trim();
+        summary.textContent = `${cupName ? `${cupName}’s` : 'Your'} ${flavor}${drink}`;
+        requestDraw();
+      }
+
+      function resize(entry) {
+        width = canvas.getBoundingClientRect().width;
+        if (!width) return;
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        canvas.width = pixels?.inlineSize || Math.round(width * (window.devicePixelRatio || 1));
+        canvas.height = pixels?.blockSize || Math.round(height * (window.devicePixelRatio || 1));
+        const formWidth = Math.min(240, width - 104);
+        form.style.width = `${formWidth}px`;
+        formX = (width - formWidth) / 2;
+        requestDraw();
+      }
+
+      if (nativeHTML) canvas.onpaint = drawCup;
+      form.addEventListener('input', updateOrder);
+      form.addEventListener('change', updateOrder);
+      form.addEventListener('submit', (event) => event.preventDefault());
+      form.addEventListener('reset', () => requestAnimationFrame(updateOrder));
+      if (typeof ResizeObserver !== 'undefined') {
+        const observer = new ResizeObserver(([entry]) => resize(entry));
+        const supportsDevicePixels = typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, supportsDevicePixels ? { box: 'device-pixel-content-box' } : {});
+      }
+      window.addEventListener('resize', () => resize());
+      // Re-arm the query when zoom or moving between monitors changes pixel density.
+      function watchDensity() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          resize();
+          watchDensity();
+        }, { once: true });
+      }
+      watchDensity();
+      resize();
+      updateOrder();
+    })();
+  </script>
