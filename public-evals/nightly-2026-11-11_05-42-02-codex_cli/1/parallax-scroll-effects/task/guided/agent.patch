+    }
+
+    .story-copy .btn {
+      margin-top: 24px;
+    }
+
+    .story-art {
+      position: relative;
+      min-width: 0;
+      width: 100%;
+      max-width: 440px;
+      justify-self: center;
+      aspect-ratio: 1.2;
+    }
+
+    .story-halo {
+      --travel: 20px;
+      position: absolute;
+      inset: -24px -12px 12px 24px;
+      border: 1px solid #bba38d;
+      border-radius: 50%;
+    }
+
+    .story-photo {
+      --travel: 38px;
+      position: absolute;
+      inset: 0 32px;
+      overflow: hidden;
+      border-radius: 48% 48% 8px 8px;
+      background: #6a4934;
+    }
+
+    .story-photo img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    .story-beans {
+      --travel: 64px;
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    .story-beans span {
+      position: absolute;
+      width: 44px;
+      height: 64px;
+      border-radius: 50%;
+      background: linear-gradient(100deg, #674331 44%, #b08c6a 46%, #b08c6a 49%, #493024 52%);
+      box-shadow: 4px 6px 0 #3e272315;
+      transform: rotate(35deg);
+    }
+
+    .story-beans span:first-child {
+      left: 8px;
+      bottom: 14px;
+    }
+
+    .story-beans span:last-child {
+      right: 8px;
+      top: 18px;
+      transform: rotate(-30deg) scale(0.75);
+    }
+
+    .story-art { pointer-events: none; }
+
+    .story-copy a:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    /* Partial timeline support must also support animation-range. */
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .coffee-story {
+          view-timeline: --coffee-story block;
+        }
+
+        .story-layer {
+          animation: coffee-drift linear both;
+          animation-timeline: --coffee-story;
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
+    @keyframes coffee-drift {
+      from { transform: translateY(var(--travel)); }
+      to { transform: translateY(calc(0px - var(--travel))); }
+    }
+
+    @media (max-width: 640px) {
+      .coffee-story-inner {
+        grid-template-columns: 1fr;
+        gap: 44px;
+        padding: 48px 24px 64px;
+      }
+
+      .story-art {
+        max-width: 340px;
+      }
+
+      .story-halo { --travel: 10px; }
+      .story-photo { --travel: 20px; }
+      .story-beans { --travel: 32px; }
+    }
+
