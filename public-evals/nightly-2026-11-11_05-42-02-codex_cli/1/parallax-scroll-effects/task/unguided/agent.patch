+  <script>
+    (() => {
+      const section = document.querySelector('.coffee-story');
+      const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+      // Unsupported browsers retain the complete, static design.
+      if (!section || !('IntersectionObserver' in window)) return;
+
+      const layers = [...section.querySelectorAll('[data-parallax-speed]')];
+      let frame = null;
+      let visible = false;
+      let listening = false;
+
+      const render = () => {
+        frame = null;
+        const bounds = section.getBoundingClientRect();
+        const distance = window.innerHeight / 2 - (bounds.top + bounds.height / 2);
+        layers.forEach(layer => {
+          const offset = Math.max(-64, Math.min(64, distance * Number(layer.dataset.parallaxSpeed)));
+          layer.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0)`;
+        });
+      };
+
+      const schedule = () => {
+        if (frame === null) frame = window.requestAnimationFrame(render);
+      };
+
+      const sync = () => {
+        const active = visible && !document.hidden && !motionPreference.matches;
+        if (active === listening) return;
+        listening = active;
+        if (active) {
+          layers.forEach(layer => { layer.style.willChange = 'transform'; });
+          window.addEventListener('scroll', schedule, { passive: true });
+          window.addEventListener('resize', schedule);
+          schedule();
+        } else {
+          window.removeEventListener('scroll', schedule);
+          window.removeEventListener('resize', schedule);
+          window.cancelAnimationFrame(frame);
+          frame = null;
+          layers.forEach(layer => {
+            layer.style.removeProperty('will-change');
+            layer.style.removeProperty('transform');
+          });
+        }
+      };
+
+      const observer = new IntersectionObserver(([entry]) => {
+        visible = entry.isIntersecting;
+        sync();
+      });
+      observer.observe(section);
+      motionPreference.addEventListener('change', sync);
+      document.addEventListener('visibilitychange', sync);
+    })();
+  </script>
