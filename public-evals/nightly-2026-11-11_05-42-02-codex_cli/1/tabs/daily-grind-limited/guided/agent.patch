+  <script>
+    const menu = document.querySelector('#coffee-menu');
+    const tabBar = menu.querySelector('.menu-tab-bar');
+    const tabList = menu.querySelector('[role="tablist"]');
+    const tabs = [...tabList.querySelectorAll('[role="tab"]')];
+    const panels = tabs.map(tab => document.getElementById(tab.dataset.panel));
+    const scrollButtons = [...menu.querySelectorAll('.menu-scroll')];
+    const scrollHint = menu.querySelector('.menu-scroll-hint');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function revealTab(tab, animate = true) {
+      tab.scrollIntoView({
+        behavior: animate && !reducedMotion.matches ? 'smooth' : 'instant',
+        block: 'nearest',
+        inline: 'nearest',
+        container: 'nearest'
+      });
+    }
+
+    function selectTab(selected) {
+      tabs.forEach((tab, index) => {
+        const active = tab === selected;
+        tab.setAttribute('aria-selected', String(active));
+        tab.tabIndex = active ? 0 : -1;
+        if (active) {
+          panels[index].removeAttribute('hidden');
+        } else {
+          panels[index].setAttribute('hidden', 'until-found');
+        }
+      });
+      revealTab(selected);
+    }
+
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => selectTab(tab));
+      tab.addEventListener('focus', () => selectTab(tab));
+      // Keep selection synchronized when find-in-page reveals a hidden drink.
+      panels[index].addEventListener('beforematch', () => selectTab(tab));
+    });
+
+    tabList.addEventListener('keydown', event => {
+      const index = tabs.indexOf(event.target);
+      if (index < 0 || event.altKey || event.ctrlKey || event.metaKey) return;
+      const direction = getComputedStyle(tabList).direction === 'rtl' ? -1 : 1;
+      let next;
+      switch (event.key) {
+        case 'ArrowRight': next = (index + direction + tabs.length) % tabs.length; break;
+        case 'ArrowLeft': next = (index - direction + tabs.length) % tabs.length; break;
+        case 'Home': next = 0; break;
+        case 'End': next = tabs.length - 1; break;
+        default: return;
+      }
+      event.preventDefault();
+      tabs[next].focus({ preventScroll: true });
+    });
+
+    function updateScrollControls() {
+      // Compare with the full bar, so the controls cannot sustain their own overflow.
+      const overflowing = tabList.scrollWidth > tabBar.clientWidth + 1;
+      scrollButtons.forEach(button => { button.hidden = !overflowing; });
+      scrollHint.hidden = !overflowing;
+      const offset = Math.abs(tabList.scrollLeft);
+      const maximum = tabList.scrollWidth - tabList.clientWidth;
+      scrollButtons[0].setAttribute('aria-disabled', String(offset <= 1));
+      scrollButtons[1].setAttribute('aria-disabled', String(offset >= maximum - 1));
+    }
+
+    scrollButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        if (button.getAttribute('aria-disabled') === 'true') return;
+        const direction = getComputedStyle(tabList).direction === 'rtl' ? -1 : 1;
+        tabList.scrollBy({
+          left: Number(button.dataset.direction) * direction * tabList.clientWidth * 0.75,
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    tabList.addEventListener('scroll', updateScrollControls, { passive: true });
+    const resizeObserver = new ResizeObserver(() => {
+      updateScrollControls();
+      revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'), false);
+    });
+    resizeObserver.observe(tabBar);
+    document.fonts.ready.then(updateScrollControls);
+    updateScrollControls();
+  </script>
+
