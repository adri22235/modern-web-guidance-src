+  <script>
+    (() => {
+      const menu = document.querySelector('#coffee-menu');
+      const tablist = menu.querySelector('[role="tablist"]');
+      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+      const panels = [...menu.querySelectorAll('[role="tabpanel"]')];
+      const controls = [...menu.querySelectorAll('.tab-scroll')];
+      const hint = menu.querySelector('.menu-hint');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const behavior = () => reducedMotion.matches ? 'auto' : 'smooth';
+
+      function revealTab(tab) {
+        const viewport = tablist.getBoundingClientRect();
+        const bounds = tab.getBoundingClientRect();
+        if (bounds.left < viewport.left + 6) {
+          tablist.scrollBy({ left: bounds.left - viewport.left - 6, behavior: behavior() });
+        } else if (bounds.right > viewport.right - 6) {
+          tablist.scrollBy({ left: bounds.right - viewport.right + 6, behavior: behavior() });
+        }
+      }
+
+      function selectTab(tab) {
+        tabs.forEach(item => {
+          const selected = item === tab;
+          item.setAttribute('aria-selected', String(selected));
+          item.tabIndex = selected ? 0 : -1;
+        });
+        panels.forEach(panel => { panel.hidden = panel.id !== tab.getAttribute('aria-controls'); });
+        revealTab(tab);
+      }
+
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(tab));
+        tab.addEventListener('keydown', event => {
+          let next;
+          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+          if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+          if (event.key === 'Home') next = 0;
+          if (event.key === 'End') next = tabs.length - 1;
+          if (next === undefined) return;
+          event.preventDefault();
+          tabs[next].focus({ preventScroll: true });
+          selectTab(tabs[next]);
+        });
+      });
+
+      function updateOverflow() {
+        // Measure without controls first so their width cannot keep them visible unnecessarily.
+        controls.forEach(control => { control.hidden = true; });
+        const overflowing = tablist.scrollWidth > tablist.clientWidth + 1;
+        controls.forEach(control => { control.hidden = !overflowing; });
+        hint.hidden = !overflowing;
+        updateEdges();
+        revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'));
+      }
+
+      function updateEdges() {
+        const maxScroll = tablist.scrollWidth - tablist.clientWidth;
+        controls[0].disabled = tablist.scrollLeft <= 1;
+        controls[1].disabled = tablist.scrollLeft >= maxScroll - 1;
+      }
+
+      controls.forEach(control => control.addEventListener('click', () => {
+        tablist.scrollBy({
+          left: Number(control.dataset.direction) * tablist.clientWidth * 0.75,
+          behavior: behavior()
+        });
+      }));
+      tablist.addEventListener('scroll', updateEdges, { passive: true });
+      // Observe the wrapper: showing scroll buttons changes the tablist width.
+      new ResizeObserver(updateOverflow).observe(menu.querySelector('.menu-navigation'));
+      if (document.fonts) document.fonts.ready.then(updateOverflow);
+      updateOverflow();
+    })();
+  </script>
