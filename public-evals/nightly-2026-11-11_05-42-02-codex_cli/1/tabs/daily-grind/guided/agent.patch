+  <script>
+    (() => {
+      const menu = document.getElementById('coffee-menu');
+      const tablist = menu.querySelector('.menu-tabs');
+      const shell = menu.querySelector('.menu-tabs-shell');
+      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+      const panels = [...menu.querySelectorAll('[role="tabpanel"]')];
+      const controls = [...menu.querySelectorAll('.menu-scroll')];
+      const nativeFocusgroup = Object.hasOwn(HTMLElement.prototype, 'focusGroup');
+      const motion = matchMedia('(prefers-reduced-motion: reduce)');
+      const behavior = () => motion.matches ? 'instant' : 'smooth';
+
+      function updateOverflow() {
+        const maxScroll = tablist.scrollWidth - tablist.clientWidth;
+        const moreStart = tablist.scrollLeft > 1;
+        const moreEnd = tablist.scrollLeft < maxScroll - 1;
+        shell.dataset.overflow = String(maxScroll > 1);
+        shell.dataset.moreStart = String(moreStart);
+        shell.dataset.moreEnd = String(moreEnd);
+        controls[0].setAttribute('aria-disabled', String(!moreStart));
+        controls[1].setAttribute('aria-disabled', String(!moreEnd));
+      }
+
+      function reveal(tab, scrollBehavior = behavior()) {
+        // Scroll this container directly: older scrollIntoView implementations
+        // ignore container: 'nearest' and can unexpectedly move the whole page.
+        const list = tablist.getBoundingClientRect();
+        const item = tab.getBoundingClientRect();
+        const delta = item.left < list.left + 20 ? item.left - list.left - 20
+          : item.right > list.right - 20 ? item.right - list.right + 20 : 0;
+        if (delta) tablist.scrollBy({ left: delta, behavior: scrollBehavior });
+      }
+
+      function select(tab) {
+        tabs.forEach((item, index) => {
+          const active = item === tab;
+          item.setAttribute('aria-selected', String(active));
+          item.toggleAttribute('focusgroupstart', active);
+          if (!nativeFocusgroup) item.tabIndex = active ? 0 : -1;
+          if (active) panels[index].removeAttribute('hidden');
+          else panels[index].setAttribute('hidden', 'until-found');
+        });
+        reveal(tab);
+      }
+
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => select(tab));
+        tab.addEventListener('focus', () => select(tab));
+        panels[index].addEventListener('beforematch', () => select(tab));
+      });
+
+      // Small fallback for browsers without native focusgroup support.
+      if (!nativeFocusgroup) {
+        tabs.forEach(tab => { tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1; });
+        tablist.addEventListener('keydown', event => {
+          if (event.altKey || event.ctrlKey || event.metaKey) return;
+          const index = tabs.indexOf(document.activeElement);
+          if (index < 0) return;
+          const next = { ArrowRight: (index + 1) % tabs.length,
+            ArrowLeft: (index - 1 + tabs.length) % tabs.length,
+            Home: 0, End: tabs.length - 1 }[event.key];
+          if (next === undefined) return;
+          event.preventDefault();
+          tabs[next].focus({ preventScroll: true });
+        });
+      }
+
+      controls.forEach(control => control.addEventListener('click', () => {
+        if (control.getAttribute('aria-disabled') === 'true') return;
+        tablist.scrollBy({ left: Number(control.dataset.direction) * tablist.clientWidth * .75,
+          behavior: behavior() });
+      }));
+      tablist.addEventListener('scroll', updateOverflow, { passive: true });
+      const resize = new ResizeObserver(() => {
+        updateOverflow();
+        reveal(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'), 'instant');
+      });
+      resize.observe(tablist);
+      tabs.forEach(tab => resize.observe(tab));
+      updateOverflow();
+    })();
+  </script>
+
