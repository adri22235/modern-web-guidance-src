@@ -155,8 +219,10 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller" tabindex="-1">
+  <span class="scroll-sentinel" aria-hidden="true"></span>
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
@@ -206,7 +272,41 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" inert tabindex="-1" aria-hidden="true">
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+    const sentinel = scroller.querySelector('.scroll-sentinel');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    const observer = new IntersectionObserver(([entry]) => {
+      const visible = !entry.isIntersecting;
+      if (!visible && document.activeElement === backToTop) {
+        scroller.focus({ preventScroll: true });
+      }
+      backToTop.inert = !visible;
+      backToTop.tabIndex = visible ? 0 : -1;
+      backToTop.setAttribute('aria-hidden', String(!visible));
+      backToTop.classList.toggle('is-visible', visible);
+    }, {
+      root: scroller,
+      rootMargin: '160px 0px 0px 0px',
+      threshold: 0,
+    });
+
+    observer.observe(sentinel);
+
+    backToTop.addEventListener('click', () => {
+      scroller.focus({ preventScroll: true });
+      scroller.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+    });
+  </script>
+
 </body>
 
 </html>
