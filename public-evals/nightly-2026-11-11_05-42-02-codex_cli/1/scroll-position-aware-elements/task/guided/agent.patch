+    .scroller {
+      position: relative;
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      scrollbar-gutter: stable;
+      container-type: scroll-state;
+      container-name: page-scroll;
+    }
+
+    .scroll-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 1px;
+      visibility: hidden;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: fixed;
+      right: 1.5rem;
+      bottom: 1.5rem;
+      z-index: 1001;
+      min-height: 44px;
+      padding: 0.75rem 1rem;
+      border: 0;
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      cursor: pointer;
+      box-shadow: 0 3px 12px rgb(0 0 0 / 20%);
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition: opacity 0.3s ease, translate 0.3s ease;
+    }
+
+    .back-to-top:hover {
+      background: var(--text);
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* Only the observer fallback sets this class. */
+    .scroller.scrolled .back-to-top {
+      visibility: visible;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @container page-scroll scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+        translate: none;
+      }
+    }
+
