+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const observer = new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting || entry.intersectionRatio < 1);
+      }, { root: scroller, threshold: 1 });
+
+      observer.observe(scroller.querySelector('.scroll-sentinel'));
+    }
+
+    backToTop.addEventListener('click', () => {
+      // Move keyboard focus to the start before the button becomes hidden.
+      document.getElementById('page-top').focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+      });
+    });
+  </script>
