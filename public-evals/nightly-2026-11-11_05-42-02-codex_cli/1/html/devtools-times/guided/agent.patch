+import { forwardRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  children: ReactNode;
+}
+
+// Keep dialogs mounted so the browser can restore focus to their invokers.
+const Modal = forwardRef<HTMLDialogElement, Props>(function Modal({ id, title, children }, ref) {
+  return (
+    <dialog ref={ref} id={id} aria-labelledby={`${id}-title`} {...{ closedby: 'any' }} className="overlay-dialog bg-white shadow-xl p-4">
+      <div className="flex items-center justify-between gap-4 mb-4">
+        <h2 tabIndex={-1} id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <form method="dialog">
+          <button type="submit" className="p-2 text-gray-700 hover:text-amber-700">Close</button>
+        </form>
+      </div>
+      {children}
+    </dialog>
+  );
+});
+
+export default Modal;
