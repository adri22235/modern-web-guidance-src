+++ b/src/components/NavigationPopover.tsx
@@ -0,0 +1,25 @@
+import { useId, useRef, useState, type ReactNode } from 'react';
+
+export default function NavigationPopover({ label, children, active = false }: { label: string; children: ReactNode; active?: boolean }) {
+  const id = useId();
+  const trigger = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  return (
+    <div className="h-full flex items-center">
+      <button ref={trigger} type="button" popoverTarget={id} aria-expanded={open} aria-current={active ? 'true' : undefined} className="flex items-center gap-1 hover:text-gray-600 whitespace-nowrap">
+        {label}<span aria-hidden="true">⌄</span>
+      </button>
+      <div id={id} popover="auto" className="navigation-popover" onToggle={event => {
+        const opened = event.newState === 'open';
+        setOpen(opened);
+        if (opened && trigger.current) {
+          const rect = trigger.current.getBoundingClientRect();
+          event.currentTarget.style.top = `${rect.bottom + 8}px`;
+        }
+      }}>
