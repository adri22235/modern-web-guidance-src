+}
+:focus-visible {
+  outline: 3px solid #b45309;
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: fixed;
+  top: 0.5rem;
+  left: 0.5rem;
+  z-index: 100;
+  padding: 0.75rem 1rem;
+  background: white;
+  color: #111827;
+  transform: translateY(-200%);
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.overlay-dialog {
+  position: fixed;
+  inset: 0;
+  margin: auto;
+  padding: 0;
+  border: 0;
+  width: min(42rem, calc(100% - 2rem));
+  max-height: calc(100dvh - 2rem);
+  overflow-y: auto;
+  background: white;
+  color: #111827;
+  box-shadow: 0 20px 25px rgb(0 0 0 / 0.15);
+}
+
+.overlay-dialog::backdrop {
+  background: rgb(255 255 255 / 0.3);
+  backdrop-filter: blur(4px);
+}
+
+html:has(.overlay-dialog[open]) { overflow: hidden; }
+
+.navigation-popover {
+  position: fixed;
+  inset: auto 0;
+  margin: 0 auto;
+  width: min(72rem, calc(100% - 2rem));
+  max-height: min(65dvh, 36rem);
+  overflow-y: auto;
+  padding: 1rem;
+  border: 1px solid #d1d5db;
+  background: white;
+  color: #111827;
+  box-shadow: 0 10px 15px rgb(0 0 0 / 0.1);
+}
