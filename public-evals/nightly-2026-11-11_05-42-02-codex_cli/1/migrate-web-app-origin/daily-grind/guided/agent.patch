@@ -0,0 +1,69 @@
+import { mkdir, readFile, writeFile, copyFile, rm } from 'node:fs/promises';
+import { getDomain } from 'tldts';
+
+export function validateConfig(config) {
+  const origins = [config.oldOrigin, config.newOrigin].map(value => {
+    const url = new URL(value);
+    if (url.protocol !== 'https:' || url.origin !== value) {
+      throw new Error('Migration requires HTTPS origins without paths or trailing slashes.');
+    }
+    return url;
+  });
+  const sites = origins.map(url => getDomain(url.hostname, { allowPrivateDomains: true }));
+  if (!sites[0] || sites[0] !== sites[1] || origins[0].origin === origins[1].origin) {
+    throw new Error('Migration requires distinct origins on the same registrable domain.');
+  }
+  for (const key of ['oldAppId', 'newAppId']) {
+    const base = key === 'oldAppId' ? origins[0] : origins[1];
+    const id = new URL(config[key], base);
+    if (id.origin !== base.origin || id.hash || !config[key]?.startsWith('/')) {
+      throw new Error('App IDs must be origin-relative paths without fragments.');
+    }
+  }
+  if (!Array.isArray(config.configurationKeys) || config.configurationKeys.some(key =>
+    typeof key !== 'string' || !key || key.startsWith('daily-grind:migration:'))) {
+    throw new Error('configurationKeys must list the app configuration storage keys.');
+  }
+  return config;
+}
+
+export async function build(config, output = 'dist') {
+  validateConfig(config);
+  const page = await readFile('index.html', 'utf8');
+  const oldId = new URL(config.oldAppId, config.oldOrigin).href;
+  const newId = new URL(config.newAppId, config.newOrigin).href;
+  await rm(output, { recursive: true, force: true });
+  for (const role of ['old', 'new']) {
+    const dir = `${output}/${role}`;
+    await mkdir(`${dir}/migration`, { recursive: true });
+    await writeFile(`${dir}/index.html`, page);
+    await writeFile(`${dir}/migration/config.js`, `globalThis.DAILY_GRIND_MIGRATION = ${JSON.stringify({ ...config, role })};\n`);
+    await copyFile('migration/client.js', `${dir}/migration/client.js`);
+    await copyFile('migration/bridge.html', `${dir}/migration/bridge.html`);
+    await copyFile('migration/icon.svg', `${dir}/icon.svg`);
+    const manifest = {
+      id: role === 'old' ? config.oldAppId : config.newAppId,
+      name: 'The Daily Grind', short_name: 'Daily Grind', start_url: '/', scope: '/',
+      display: 'standalone', background_color: '#fafafa', theme_color: '#4e342e',
+      icons: [{ src: '/icon.svg', sizes: 'any', type: 'image/svg+xml', purpose: 'any' }],
+      ...(role === 'old'
+        ? { migrate_to: { id: newId, install_url: `${config.newOrigin}/` } }
+        : { migrate_from: [{ id: oldId }] })
+    };
+    await writeFile(`${dir}/manifest.webmanifest`, JSON.stringify(manifest, null, 2));
+    if (role === 'old') {
+      await mkdir(`${dir}/.well-known`, { recursive: true });
+      await writeFile(`${dir}/.well-known/web-app-origin-association`, JSON.stringify({
+        [newId]: { allow_migration: true }
+      }, null, 2));
+    }
+  }
+}
+
+if (process.argv[1] && import.meta.url === new URL(process.argv[1], 'file:').href) {
+  const config = JSON.parse(await readFile('migration.config.json', 'utf8'));
+  config.oldOrigin = process.env.OLD_ORIGIN ?? config.oldOrigin;
+  config.newOrigin = process.env.NEW_ORIGIN ?? config.newOrigin;
+  await build(config);
+  console.log('Built dist/old and dist/new. Deploy each directory to its configured HTTPS origin.');
+}
diff --git a/test/migration.test.mjs b/test/migration.test.mjs
new file mode 100644
index 0000000..ddab7a8
--- /dev/null
+++ b/test/migration.test.mjs
@@ -0,0 +1,132 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import vm from 'node:vm';
+import { build, validateConfig } from '../scripts/build.mjs';
+
+const config = JSON.parse(await readFile('migration.config.json', 'utf8'));
+const client = await readFile('migration/client.js', 'utf8');
+
+test('rejects unrelated sites, private-suffix tenants, HTTP, and malformed IDs', () => {
+  for (const change of [
+    { newOrigin: 'https://unrelated.example' },
+    { oldOrigin: 'https://a.github.io', newOrigin: 'https://b.github.io' },
+    { newOrigin: 'http://app.dailygrind.example' },
+    { newOrigin: 'https://app.dailygrind.example/path' },
+    { newAppId: '//attacker.example/' },
+    { oldAppId: '/#different' }
+  ]) assert.throws(() => validateConfig({ ...config, ...change }));
+  assert.doesNotThrow(() => validateConfig({ ...config,
+    oldOrigin: 'https://old.coffee.co.uk', newOrigin: 'https://new.coffee.co.uk' }));
+});
+
+test('builds reciprocal manifests, exact association, and linked deployment assets', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'daily-grind-migration-'));
+  try {
+    await build(config, dir);
+    const json = async path => JSON.parse(await readFile(join(dir, path), 'utf8'));
+    const oldManifest = await json('old/manifest.webmanifest');
+    const newManifest = await json('new/manifest.webmanifest');
+    assert.equal(oldManifest.migrate_to.id, `${config.newOrigin}/`);
+    assert.equal(newManifest.migrate_from[0].id, `${config.oldOrigin}/`);
+    assert.equal(newManifest.id, '/');
+    assert.deepEqual(await json('old/.well-known/web-app-origin-association'), {
+      [`${config.newOrigin}/`]: { allow_migration: true }
+    });
+    for (const role of ['old', 'new']) {
+      assert.match(await readFile(join(dir, role, 'index.html'), 'utf8'), /rel="manifest"/);
+      for (const path of ['migration/client.js', 'migration/config.js', 'migration/bridge.html', 'icon.svg']) {
+        assert.ok((await readFile(join(dir, role, path))).length);
+      }
+    }
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
+
+function environment(role, bridge = false, initial = {}) {
+  const listeners = new Map();
+  const elements = [];
+  const sent = [];
+  const storage = new Map(Object.entries(initial));
+  const parent = { postMessage: (...args) => sent.push(args) };
+  const context = {
+    DAILY_GRIND_MIGRATION: { ...config, role }, URL,
+    location: { origin: role === 'old' ? config.oldOrigin : config.newOrigin,
+      pathname: bridge ? '/migration/bridge.html' : '/' },
+    localStorage: { getItem: key => storage.get(key) ?? null, setItem: (key, value) => storage.set(key, value) },
+    crypto: { randomUUID: () => 'test-nonce' },
+    setTimeout: () => 1, clearTimeout() {},
+    addEventListener: (type, fn) => listeners.set(type, fn),
+    removeEventListener: type => listeners.delete(type),
+    document: {
+      body: { prepend() {}, append() {} },
+      createElement(tag) {
+        const element = { tag, style: {}, textContent: '', hidden: false,
+          setAttribute() {}, append() {}, remove() { this.removed = true; },
+          handlers: {}, addEventListener(type, fn) { this.handlers[type] = fn; },
+          contentWindow: { postMessage: (...args) => sent.push(args) } };
+        elements.push(element);
+        return element;
+      }
+    }
+  };
+  context.window = context;
+  context.parent = bridge ? parent : context;
+  vm.runInNewContext(client, context);
+  return { context, listeners, elements, sent, storage };
+}
+
+test('bridge requires trusted origin and parent; exports configuration only', () => {
+  const env = environment('old', true, { 'daily-grind:preferences': '{"milk":"oat"}', token: 'private' });
+  const receive = env.listeners.get('message');
+  const event = { origin: config.newOrigin, source: env.context.parent,
+    data: { type: 'daily-grind:configuration-request:v1', nonce: 'n' } };
+  receive({ ...event, origin: 'null' });
+  receive({ ...event, origin: `${config.newOrigin}.attacker.example` });
+  receive({ ...event, source: {} });
+  assert.equal(env.sent.length, 0);
+  receive(event);
+  assert.equal(env.sent.length, 1);
+  assert.equal(env.sent[0][1], config.newOrigin);
+  assert.equal(env.sent[0][0].settings['daily-grind:preferences'], '{"milk":"oat"}');
+  assert.equal(env.sent[0][0].settings.token, undefined);
+});
+
+test('destination pins iframe and nonce, preserves destination settings, and completes once', () => {
+  const env = environment('new', false, { 'daily-grind:settings': 'newer settings' });
+  const frame = env.elements.find(element => element.tag === 'iframe');
+  frame.handlers.load();
+  assert.equal(env.sent[0][1], config.oldOrigin);
+  const receive = env.listeners.get('message');
+  const event = { origin: config.oldOrigin, source: frame.contentWindow, data: {
+    type: 'daily-grind:configuration-response:v1', nonce: 'test-nonce',
+    settings: { 'daily-grind:preferences': 'saved preference', 'daily-grind:settings': 'older settings' }
+  } };
+  receive({ ...event, source: {} });
+  receive({ ...event, data: { ...event.data, nonce: 'wrong' } });
+  assert.equal(env.storage.get('daily-grind:preferences'), undefined);
+  receive(event);
+  assert.equal(env.storage.get('daily-grind:preferences'), 'saved preference');
+  assert.equal(env.storage.get('daily-grind:settings'), 'newer settings');
+  assert.equal(env.storage.get(`daily-grind:migration:v1:${config.oldOrigin}`), 'complete');
+  assert.equal(frame.removed, true);
+  assert.equal(env.listeners.has('message'), false);
+  const again = environment('new', false, Object.fromEntries(env.storage));
+  assert.equal(again.elements.length, 0);
+});
+
+test('invalid payload and storage failure leave migration retryable', () => {
+  for (const failStorage of [false, true]) {
+    const env = environment('new');
+    const frame = env.elements.find(element => element.tag === 'iframe');
+    if (failStorage) env.context.localStorage.setItem = () => { throw new Error('Quota'); };
+    env.listeners.get('message')({ origin: config.oldOrigin, source: frame.contentWindow,
+      data: { type: 'daily-grind:configuration-response:v1', nonce: 'test-nonce', settings: {
+        'daily-grind:preferences': 'saved', 'daily-grind:settings': failStorage ? null : 42
+      } } });
+    assert.equal(env.storage.get(`daily-grind:migration:v1:${config.oldOrigin}`), undefined);
+    assert.equal(env.storage.get('daily-grind:preferences'), undefined);
+    assert.equal(env.elements.find(element => element.tag === 'button').hidden, false);
+  }
+});
