+(() => {
+  'use strict';
+  const config = globalThis.DAILY_GRIND_MIGRATION;
+  if (!config) return;
+  const { oldOrigin, newOrigin, configurationKeys, role } = config;
+  const REQUEST = 'daily-grind:configuration-request:v1';
+  const RESPONSE = 'daily-grind:configuration-response:v1';
+  const marker = `daily-grind:migration:v1:${oldOrigin}`;
+  const maxSize = 256 * 1024;
+
+  function trusted(event, expected) {
+    try {
+      if ('Origin' in globalThis) {
+        return Origin.from(event).isSameOrigin(Origin.from(expected));
+      }
+      const origin = new URL(event.origin).origin;
+      return origin !== 'null' && origin === new URL(expected).origin;
+    } catch {
+      return false;
+    }
+  }
+
+  // Only this dedicated page exposes configuration, and only to its new-origin parent.
+  if (location.pathname === '/migration/bridge.html') {
+    if (role !== 'old' || location.origin !== oldOrigin || parent === window) return;
+    window.addEventListener('message', event => {
+      if (!trusted(event, newOrigin) || event.source !== parent ||
+          event.data?.type !== REQUEST || typeof event.data.nonce !== 'string') return;
+      const response = { type: RESPONSE, nonce: event.data.nonce };
+      try {
+        response.settings = Object.fromEntries(configurationKeys.map(key => [key, localStorage.getItem(key)]));
+        if (JSON.stringify(response.settings).length > maxSize) throw new Error('Too large');
+      } catch {
+        delete response.settings;
+        response.error = true;
+      }
+      parent.postMessage(response, newOrigin);
+    });
+    return;
+  }
+
+  function notice(text) {
+    const region = document.createElement('aside');
+    region.setAttribute('aria-label', 'App migration');
+    region.style.cssText = 'padding:16px 5%;background:#fff3df;color:#3e2723;border-bottom:1px solid #d7ccc8;';
+    const message = document.createElement('span');
+    message.setAttribute('role', 'status');
+    message.textContent = text;
+    region.append(message);
+    document.body.prepend(region);
+    return { region, message };
+  }
+
+  if (role === 'old' && location.origin === oldOrigin) {
+    const { region } = notice('The Daily Grind has a new home. Open it to transfer your saved preferences. ');
+    const link = document.createElement('a');
+    link.href = `${newOrigin}/`;
+    link.textContent = 'Open the new app';
+    region.append(link);
+    const hint = document.createElement('p');
+    hint.textContent = 'Supported browsers can update your installed app and shortcuts. If no update is offered, install the new app from your browser menu after your preferences transfer.';
+    region.append(hint);
+    return;
+  }
+  if (role !== 'new' || location.origin !== newOrigin || window !== parent) return;
+  try {
+    if (localStorage.getItem(marker) === 'complete') return;
+  } catch { /* Show the recoverable storage error below. */ }
+
+  const { region, message } = notice('Transferring your saved preferences…');
+  const retry = document.createElement('button');
+  retry.type = 'button';
+  retry.textContent = 'Retry transfer';
+  retry.hidden = true;
+  region.append(retry);
+  retry.addEventListener('click', transfer);
+
+  function transfer() {
+    retry.hidden = true;
+    message.textContent = 'Transferring your saved preferences… ';
+    const nonce = crypto.randomUUID();
+    const frame = document.createElement('iframe');
+    frame.hidden = true;
+    frame.title = 'Transfer saved Daily Grind preferences';
+    frame.src = `${oldOrigin}/migration/bridge.html`;
+    let timer;
+    function finish(success) {
+      clearTimeout(timer);
+      window.removeEventListener('message', receive);
+      frame.remove();
+      message.textContent = success
+        ? 'Your saved preferences are ready. Your original preferences remain available at the old address.'
+        : 'Your preferences could not be transferred. Keep the old app available, allow site storage, and retry. ';
+      retry.hidden = success;
+    }
+    function receive(event) {
+      if (!trusted(event, oldOrigin) || event.source !== frame.contentWindow ||
+          event.data?.type !== RESPONSE || event.data.nonce !== nonce) return;
+      try {
+        const settings = event.data.settings;
+        if (event.data.error || !settings || typeof settings !== 'object' ||
+            Array.isArray(settings) || JSON.stringify(settings).length > maxSize) throw new Error('Invalid settings');
+        // Validate the entire payload before writing. Never overwrite settings already saved here.
+        for (const key of configurationKeys) {
+          if (!Object.hasOwn(settings, key) || (settings[key] !== null && typeof settings[key] !== 'string')) {
+            throw new Error('Invalid setting');
+          }
+        }
+        for (const key of configurationKeys) {
+          if (settings[key] !== null && localStorage.getItem(key) === null) localStorage.setItem(key, settings[key]);
+        }
+        localStorage.setItem(marker, 'complete');
+        finish(true);
+      } catch { finish(false); }
+    }
+    window.addEventListener('message', receive);
+    frame.addEventListener('load', () => {
+      frame.contentWindow.postMessage({ type: REQUEST, nonce }, oldOrigin);
+    }, { once: true });
+    frame.addEventListener('error', () => finish(false), { once: true });
+    timer = setTimeout(() => finish(false), 10000);
+    document.body.append(frame);
+  }
+  transfer();
+})();
