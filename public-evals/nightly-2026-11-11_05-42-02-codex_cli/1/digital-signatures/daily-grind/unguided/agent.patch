diff --git a/tests/signing.test.js b/tests/signing.test.js
new file mode 100644
index 0000000..1192503
--- /dev/null
+++ b/tests/signing.test.js
@@ -0,0 +1,61 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createIdentity, signDocument, verifyDocument, canonical, keyId } from '../signing.js';
+const payload = {
+  type: 'receipt', issuer: 'The Daily Grind · local browser identity', currency: 'USD',
+  id: 'DG-RCPT-test', issuedAt: '2026-11-11T10:00:00.000Z', customer: 'Alex',
+  item: 'Maple Oat Latte', quantity: 2, unitPriceCents: 550, totalCents: 1100,
+};
+const identity = await createIdentity();
+test('receipt signatures survive JSON export and property reordering', async () => {
+  const signed = await signDocument(payload, identity);
+  const restored = JSON.parse(JSON.stringify(signed));
+  restored.payload = Object.fromEntries(Object.entries(restored.payload).reverse());
+  assert.deepEqual(await verifyDocument(restored, identity), payload);
+});
+test('voucher signatures authenticate all gift details', async () => {
+  const gift = { type: 'voucher', issuer: payload.issuer, currency: 'USD', id: 'DG-GIFT-test', issuedAt: payload.issuedAt, recipient: 'Sam', sender: 'Alex', message: 'Enjoy your coffee!', amountCents: 2500 };
+  const signed = await signDocument(gift, identity);
+  assert.deepEqual(await verifyDocument(signed, identity), gift);
+  for (const [field, value] of Object.entries({ recipient: 'Mallory', sender: 'Mallory', message: 'Changed', amountCents: 10000 })) {
+    const changed = structuredClone(signed); changed.payload[field] = value;
+    await assert.rejects(verifyDocument(changed, identity), /Signature does not match/);
+  }
+});
+test('changed receipt, timestamp, and document identifier are rejected', async () => {
+  const signed = await signDocument(payload, identity);
+  for (const [field, value] of Object.entries({ item: 'Cold Brew', customer: 'Mallory', id: 'different', issuedAt: '2026-11-12T00:00:00.000Z' })) {
+    const changed = structuredClone(signed); changed.payload[field] = value;
+    await assert.rejects(verifyDocument(changed, identity), /Signature does not match/);
+  }
+  const changed = structuredClone(signed); changed.payload.unitPriceCents = 100; changed.payload.totalCents = 200;
+  await assert.rejects(verifyDocument(changed, identity), /Signature does not match/);
+});
+test('a document signed with a different identity is not trusted', async () => {
+  const attacker = await createIdentity();
+  const signed = await signDocument(payload, attacker);
+  await assert.rejects(verifyDocument(signed, identity), /Unknown signing identity/);
+  signed.keyId = identity.keyId;
+  await assert.rejects(verifyDocument(signed, identity), /Signature does not match/);
+});
+test('private keys cannot be exported; public key fingerprint is reproducible', async () => {
+  assert.equal(identity.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('jwk', identity.privateKey));
+  assert.equal(await keyId(identity.publicKey), identity.keyId);
+  assert.equal(identity.keyId.length, 64);
+  assert.equal((await crypto.subtle.exportKey('jwk', identity.publicKey)).crv, 'P-256');
+});
+test('malformed formats, algorithms, and signatures fail closed', async () => {
+  const signed = await signDocument(payload, identity);
+  for (const bad of [null, [], {}, { ...signed, version: 2 }, { ...signed, algorithm: 'HMAC' }, { ...signed, extra: 'unsigned' }, { ...signed, signature: '!!!' }, { ...signed, signature: 'YWJj' }, { ...signed, payload: { ...payload, totalCents: -1 } }, { ...signed, payload: { ...payload, type: 'other' } }]) {
+    await assert.rejects(verifyDocument(bad, identity));
+  }
+});
+test('invalid receipt totals and blank voucher recipients cannot be signed', async () => {
+  await assert.rejects(signDocument({ ...payload, totalCents: 1 }, identity));
+  await assert.rejects(signDocument({ ...payload, quantity: 0, totalCents: 0 }, identity));
+  await assert.rejects(signDocument({ ...payload, type: 'voucher', amountCents: 2500, sender: 'Alex', recipient: ' ', message: '' }, identity));
+});
+test('canonical serialization sorts nested keys', () => {
+  assert.equal(canonical({ b: { z: 1, a: 'coffee' }, a: [2, 1] }), '{"a":[2,1],"b":{"a":"coffee","z":1}}');
+});
