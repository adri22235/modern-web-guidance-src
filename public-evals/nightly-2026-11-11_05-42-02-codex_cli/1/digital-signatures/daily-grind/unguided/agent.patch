+import { loadIdentity, signDocument, verifyDocument } from './signing.js';
+const $ = id => document.getElementById(id);
+const menu = { maple: { name: 'Maple Oat Latte', cents: 550 }, espresso: { name: 'Dark Roast Espresso', cents: 350 }, cold: { name: 'Slow-Steeped Cold Brew', cents: 450 } };
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+let type = 'receipt', quantity = 1, identity, busy = false, verifiedPayload;
+function status(message, state = '') { $('status').textContent = message; $('status').className = state; }
+function element(tag, className, text) { const node = document.createElement(tag); node.className = className; if (text !== undefined) node.textContent = text; return node; }
+function line(className, left, right) { const row = element('div', className); row.append(element('span', '', left), element('span', '', right)); return row; }
+function currentPayload() {
+  const common = { type, issuer: 'The Daily Grind · local browser identity', currency: 'USD', id: 'PREVIEW', issuedAt: new Date().toISOString() };
+  if (type === 'voucher') return { ...common, recipient: $('recipient').value.trim(), sender: $('sender').value.trim(), message: $('message').value.trim(), amountCents: Number($('amount').value) * 100 };
+  const item = menu[$('coffee').value];
+  return { ...common, customer: $('customer').value.trim(), item: item.name, quantity, unitPriceCents: item.cents, totalCents: item.cents * quantity };
+}
+function renderPreview(payload = currentPayload(), signed = false) {
+  const voucher = payload.type === 'voucher';
+  $('preview-heading').textContent = type === 'verify' ? 'YOUR VERIFICATION RESULT' : voucher ? 'A LITTLE GOODNESS, GIFT-WRAPPED' : 'YOUR RECEIPT, REIMAGINED';
+  $('paper-type').textContent = voucher ? 'GIFT VOUCHER' : 'COFFEE RECEIPT';
+  $('paper-date').textContent = new Date(payload.issuedAt).toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' }).toUpperCase();
+  const content = $('paper-content'); content.replaceChildren();
+  if (voucher) {
+    content.append(element('div', 'voucher-value', money(payload.amountCents)), element('div', 'paper-detail', 'A little coffee. A lot of love.'), line('paper-item', 'To', payload.recipient || 'Someone special'), line('paper-detail', 'From', payload.sender || 'You'));
+    if (payload.message) content.append(element('div', 'voucher-message', payload.message));
+    content.append(element('div', 'paper-detail', 'Local voucher · payment not recorded'));
+  } else {
+    content.append(line('paper-item', payload.item, money(payload.totalCents)), element('div', 'paper-detail', `${payload.quantity} × ${money(payload.unitPriceCents)} · Made with care`));
+    if (payload.customer) content.append(element('div', 'paper-detail', `For ${payload.customer}`));
+    content.append(line('paper-total', 'Total · USD', money(payload.totalCents)));
+  }
+  $('paper-state').textContent = signed ? 'Signature verified' : 'Ready for your signature';
+  $('paper-state-note').textContent = signed ? 'Authentic to this browser’s signing identity.' : voucher ? 'A thoughtful gift, with a personal signature.' : 'A little proof of a very good coffee.';
+  if (signed) content.append(element('div', 'paper-detail', `ID: ${payload.id}`));
+}
+function selectTab(next) {
+  if (busy) return;
+  type = next; verifiedPayload = undefined;
+  document.querySelectorAll('[role=tab]').forEach(tab => { const active = tab.dataset.type === type; tab.setAttribute('aria-selected', active); tab.tabIndex = active ? 0 : -1; });
+  $('document-panel').hidden = type === 'verify'; $('verify-panel').hidden = type !== 'verify';
+  $('receipt-fields').hidden = type !== 'receipt'; $('voucher-fields').hidden = type !== 'voucher';
+  $('recipient').required = type === 'voucher'; $('sender').required = type === 'voucher';
+  $('document-panel').setAttribute('aria-labelledby', `${type === 'voucher' ? 'voucher' : 'receipt'}-tab`);
+  $('form-title').textContent = type === 'voucher' ? 'Make someone’s day.' : 'Make it official.';
+  $('form-description').textContent = type === 'voucher' ? 'A thoughtful little gift, signed with care.' : 'A proper receipt for your daily ritual.';
+  $('issue-button').replaceChildren(element('span', '', '◇'), document.createTextNode(` Sign & download ${type === 'voucher' ? 'voucher' : 'receipt'} `), element('span', 'button-arrow', '↓'));
+  if (identity) status('Your signing identity is ready.');
+  renderPreview(type === 'verify' ? { type: 'receipt', item: 'Your document will appear here', quantity: 1, unitPriceCents: 0, totalCents: 0, issuedAt: new Date().toISOString() } : currentPayload());
+  if (type === 'verify') { $('paper-state').textContent = 'Waiting for a document'; $('paper-state-note').textContent = 'Upload or paste a signed receipt or voucher.'; }
+}
+function download(data, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+  const link = element('a', ''); link.href = url; link.download = filename; document.body.append(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+document.querySelectorAll('[role=tab]').forEach(tab => {
+  tab.addEventListener('click', () => selectTab(tab.dataset.type));
+  tab.addEventListener('keydown', event => {
+    const tabs = [...document.querySelectorAll('[role=tab]')]; let index = tabs.indexOf(tab);
+    if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
+    else if (event.key === 'ArrowLeft') index = (index + tabs.length - 1) % tabs.length;
+    else if (event.key === 'Home') index = 0;
+    else if (event.key === 'End') index = tabs.length - 1;
+    else return;
+    event.preventDefault(); if (!busy) { selectTab(tabs[index].dataset.type); tabs[index].focus(); }
+  });
+});
+function updateQuantity(delta) { quantity = Math.max(1, Math.min(20, quantity + delta)); $('quantity').value = quantity; $('minus').disabled = quantity === 1; $('plus').disabled = quantity === 20; renderPreview(); }
+$('minus').addEventListener('click', () => updateQuantity(-1)); $('plus').addEventListener('click', () => updateQuantity(1));
+$('issue-form').addEventListener('input', () => renderPreview());
+$('issue-form').addEventListener('submit', async event => {
+  event.preventDefault(); if (!identity || busy) return;
+  busy = true; $('issue-button').disabled = true;
+  try {
+    const payload = { ...currentPayload(), id: `${type === 'voucher' ? 'DG-GIFT' : 'DG-RCPT'}-${crypto.randomUUID()}` };
+    const signed = await signDocument(payload, identity);
+    await verifyDocument(signed, identity);
+    download(signed, `${payload.id}.json`); renderPreview(payload, true);
+    status(`Your ${payload.type} is signed, verified, and downloaded. Keep the JSON file for future verification.`, 'success');
+  } catch (error) { status(error.message || 'Signing failed. Please try again.', 'error'); }
+  finally { busy = false; $('issue-button').disabled = false; }
+});
+$('document-file').addEventListener('change', async event => {
+  const file = event.target.files[0]; if (!file) return;
+  clearVerification();
+  if (file.size > 1024 * 1024) { $('document-json').value = ''; status('Choose a JSON document smaller than 1 MB.', 'error'); return; }
+  try { $('document-json').value = await file.text(); status('Document loaded. Select Verify signature to check it.'); }
+  catch { status('The file could not be read. Try selecting it again.', 'error'); }
+});
+function clearVerification() { verifiedPayload = undefined; $('paper-state').textContent = 'Not yet verified'; $('paper-state-note').textContent = 'Verify the current document before trusting its details.'; }
+$('document-json').addEventListener('input', () => { clearVerification(); status('Document changed. Verify it again to check the signature.'); });
+$('verify-button').addEventListener('click', async () => {
+  if (!identity || busy) return;
+  const text = $('document-json').value.trim(); clearVerification();
+  if (!text) { status('Choose a document or paste its JSON first.', 'error'); return; }
+  if (new TextEncoder().encode(text).length > 1024 * 1024) { status('The document must be smaller than 1 MB.', 'error'); return; }
+  busy = true; $('verify-button').disabled = true; $('document-json').disabled = true; $('document-file').disabled = true;
+  try {
+    let document;
+    try { document = JSON.parse(text); } catch { throw new Error('This is not valid JSON. Use the original downloaded document.'); }
+    verifiedPayload = await verifyDocument(document, identity);
+    renderPreview(verifiedPayload, true);
+    status(`Signature verified. This ${verifiedPayload.type} is unchanged and matches this browser’s trusted signing identity. This does not confirm payment or redemption status.`, 'success');
+  } catch (error) { status(error.message || 'Verification failed.', 'error'); $('paper-state').textContent = 'Could not verify'; $('paper-state-note').textContent = 'Do not rely on this document’s authenticity.'; }
+  finally { busy = false; $('verify-button').disabled = false; $('document-json').disabled = false; $('document-file').disabled = false; }
+});
+$('export-key').addEventListener('click', async () => {
+  if (!identity) return;
+  try { download({ format: 'daily-grind-public-key-v1', algorithm: 'ECDSA-P256-SHA256', keyId: identity.keyId, publicKey: await crypto.subtle.exportKey('jwk', identity.publicKey) }, 'daily-grind-public-key.json'); status('Public verification key downloaded. Your private key stays in this browser.', 'success'); }
+  catch { status('Could not export your public key. Please try again.', 'error'); }
+});
+document.querySelectorAll('[data-coffee]').forEach(button => button.addEventListener('click', () => { if (busy) return; $('coffee').value = button.dataset.coffee; selectTab('receipt'); $('studio').scrollIntoView({ behavior: 'smooth' }); }));
+$('gift-link').addEventListener('click', () => selectTab('voucher'));
+updateQuantity(0); $('verify-button').disabled = true;
+loadIdentity().then(value => {
+  identity = value; $('issue-button').disabled = false; $('export-key').disabled = false; $('verify-button').disabled = false;
+  status('Your signing identity is ready.');
+  $('export-key').title = `SHA-256 public key fingerprint: ${identity.keyId}`;
+}).catch(error => status(error.message || 'Signing is unavailable in this browser.', 'error'));
