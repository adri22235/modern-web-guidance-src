+// Daily Grind signed document format v1. Only the locally trusted key is used to verify.
+const keyAlgorithm = { name: 'ECDSA', namedCurve: 'P-256' };
+const signatureAlgorithm = { name: 'ECDSA', hash: 'SHA-256' };
+const encoder = new TextEncoder();
+export function canonical(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}';
+}
+function base64(bytes) { return btoa(String.fromCharCode(...new Uint8Array(bytes))); }
+function unbase64(value) {
+  if (typeof value !== 'string' || !/^[A-Za-z0-9+/]+={0,2}$/.test(value)) throw new Error('Invalid signature encoding.');
+  return Uint8Array.from(atob(value), character => character.charCodeAt(0));
+}
+export async function keyId(publicKey) {
+  const raw = await crypto.subtle.exportKey('raw', publicKey);
+  const digest = await crypto.subtle.digest('SHA-256', raw);
+  return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
+}
+export async function createIdentity() {
+  const pair = await crypto.subtle.generateKey(keyAlgorithm, false, ['sign', 'verify']);
+  return { ...pair, keyId: await keyId(pair.publicKey) };
+}
+export async function loadIdentity() {
+  if (!globalThis.isSecureContext || !crypto.subtle) throw new Error('Signing requires HTTPS or localhost and a browser with Web Crypto support.');
+  const database = await new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-signing', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('identity');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(new Error('Browser storage is unavailable. Allow site storage to keep your signing identity.'));
+    request.onblocked = () => reject(new Error('Close other Daily Grind tabs and reload to prepare signing.'));
+  });
+  try {
+    const read = () => new Promise((resolve, reject) => {
+      const transaction = database.transaction('identity', 'readonly');
+      const request = transaction.objectStore('identity').get('primary');
+      transaction.oncomplete = () => resolve(request.result);
+      transaction.onabort = transaction.onerror = () => reject(new Error('Could not read your signing identity.'));
+    });
+    let identity = await read();
+    if (!identity) {
+      const candidate = await createIdentity();
+      // Read and write in one transaction so simultaneous tabs use the same identity.
+      await new Promise((resolve, reject) => {
+        const transaction = database.transaction('identity', 'readwrite');
+        const store = transaction.objectStore('identity');
+        const request = store.get('primary');
+        request.onsuccess = () => { if (!request.result) store.put(candidate, 'primary'); };
+        transaction.oncomplete = resolve;
+        transaction.onerror = transaction.onabort = () => reject(new Error('Could not save your signing identity. Allow browser storage and reload.'));
+      });
+      identity = await read();
+    }
+    if (!identity?.privateKey || !identity.publicKey || identity.keyId !== await keyId(identity.publicKey)) throw new Error('The saved signing identity is invalid.');
+    return identity;
+  } finally { database.close(); }
+}
+function validPayload(payload) {
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) return false;
+  const text = (value, max = 200) => typeof value === 'string' && value.length <= max;
+  if (payload.issuer !== 'The Daily Grind · local browser identity' || payload.currency !== 'USD' || !text(payload.id, 80) || !payload.id || !text(payload.issuedAt, 40) || !Number.isFinite(Date.parse(payload.issuedAt))) return false;
+  if (payload.type === 'receipt') return text(payload.customer, 80) && text(payload.item, 80) && payload.item.length > 0 && Number.isInteger(payload.quantity) && payload.quantity >= 1 && payload.quantity <= 20 && Number.isSafeInteger(payload.unitPriceCents) && payload.unitPriceCents > 0 && payload.totalCents === payload.quantity * payload.unitPriceCents;
+  if (payload.type === 'voucher') return text(payload.recipient, 80) && payload.recipient.trim().length > 0 && text(payload.sender, 80) && payload.sender.trim().length > 0 && text(payload.message) && [1500, 2500, 5000, 10000].includes(payload.amountCents);
+  return false;
+}
+export async function signDocument(payload, identity) {
+  if (!validPayload(payload)) throw new Error('Check the document details before signing.');
+  const document = { version: 1, algorithm: 'ECDSA-P256-SHA256', keyId: identity.keyId, payload };
+  const signature = await crypto.subtle.sign(signatureAlgorithm, identity.privateKey, encoder.encode(canonical(document)));
+  return { ...document, signature: base64(signature) };
+}
+export async function verifyDocument(document, identity) {
+  if (!document || typeof document !== 'object' || Array.isArray(document) || Object.keys(document).sort().join(',') !== 'algorithm,keyId,payload,signature,version' || document.version !== 1 || document.algorithm !== 'ECDSA-P256-SHA256' || !validPayload(document.payload)) throw new Error('This is not a supported Daily Grind signed document.');
+  if (document.keyId !== identity.keyId) throw new Error('Unknown signing identity. This document was not signed by this browser’s saved key.');
+  const { signature, ...unsigned } = document;
+  const bytes = unbase64(signature);
+  if (bytes.length !== 64 || !await crypto.subtle.verify(signatureAlgorithm, identity.publicKey, bytes, encoder.encode(canonical(unsigned)))) throw new Error('Signature does not match. The document may have been changed or damaged.');
+  return document.payload;
+}
