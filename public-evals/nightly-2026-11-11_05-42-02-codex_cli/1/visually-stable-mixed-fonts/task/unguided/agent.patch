r:#9b9f90}.control-divider{border-top:1px solid #dfe2d5;margin:26px 0 23px}.toggle-row{display:flex;align-items:center;justify-content:space-between;font-size:12px}.switch{width:31px;height:18px;background:var(--accent);border:0;border-radius:20px;padding:3px;display:flex;align-items:center;justify-content:flex-end}.switch:after{content:'';width:12px;height:12px;background:white;border-radius:50%;box-shadow:0 1px 2px #0002}.switch[aria-checked=false]{background:#b8bdaf;justify-content:flex-start}.control-help{font-size:11px;line-height:1.65;color:#8a907e;max-width:190px;margin-top:10px}.reset{background:transparent;border:1px solid #d9ddce;border-radius:5px;color:#737b65;width:100%;padding:10px;margin-top:30px;font-size:11px}.reset span{margin-right:6px}.preview-head{height:61px;display:flex;align-items:center;justify-content:space-between;padding:0 29px;border-bottom:1px solid var(--line)}.preview-head-left{display:flex;align-items:center;gap:10px}.live-dot{height:6px;width:6px;border-radius:50%;background:#8d9d74}.preview-head .section-label{font-size:9px}.preview-status{font:9px var(--mono);color:#8b907e}.preview-body{padding:29px}.sample-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.sample-title{font-size:13px;font-weight:550;display:flex;align-items:center;gap:10px}.number{font:9px var(--mono);color:#9a9e91}.badge{font:9px var(--mono);color:#698053;background:#f0f4e9;border:1px solid #e0e8d5;padding:5px 7px;border-radius:4px}.sample-caption{font-size:11px;color:#93988a;margin:9px 0 23px;padding-left:25px}.text-sample{font-family:'Libre Baskerville',Georgia,serif;font-size:21px;line-height:1.9;letter-spacing:-.35px;position:relative}.text-sample p{margin:0}.text-sample code{font-family:var(--mono);background:#f1f1eb;border:1px solid #e7e7df;border-radius:4px;padding:2px 5px;letter-spacing:-.5px;font-size:1em}.text-sample em{color:#9a9e8f}.code-row{display:flex;justify-content:space-between;align-items:center;margin-top:23px;background:#f6f7f2;border:1px solid #eaede2;border-radius:5px;padding:12px 14px;font:10px var(--mono);color:#6c7460}.code-row .property{color:#939b87}.code-row .value{color:#a45d3a}.copy{border:0;background:transparent;color:#929984;font:10px var(--mono);display:flex;gap:7px;align-items:center;padding:2px}.copy svg{width:12px;height:12px}.sample-divider{border-top:1px solid var(--line);margin:29px 0}.theme-badge{color:#967443;background:#faf4e8;border-color:#eee3cd}.independent-box{background:#f3f0e8;border:1px solid #e9e4d8;padding:23px 26px;border-radius:6px;margin-top:20px}.theme-label{font:9px var(--mono);letter-spacing:1px;text-transform:uppercase;color:#9b907b;margin-bottom:12px}.independent-box .text-sample{color:#514a3d;font-size:19px;line-height:1.9}.independent-box code{background:#e9e4d8;border-color:#ded7c8}.independent-box .code-row{background:#eae6dc;border-color:#e1dbcf;margin-top:20px}.preview-foot{border-top:1px solid var(--line);padding:15px 29px;display:flex;align-items:center;gap:7px;font-size:10px;color:#919685;background:#fcfcf9}.info-icon{border:1px solid #aab29d;border-radius:50%;width:12px;height:12px;text-align:center;font:9px serif}.below{display:grid;grid-template-columns:1fr 1fr 1fr;gap:35px;margin:30px 0 42px}.benefit{display:flex;gap:13px;padding-right:10px}.benefit-icon{color:#7d886f;font-size:21px;width:23px;flex-shrink:0;line-height:1.2}.benefit h3{font-size:11px;font-weight:550;margin:0 0 7px}.benefit p{color:#929787;font-size:11px;line-height:1.65;margin:0}footer{border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:22px 0 27px;color:#969c8d;font-size:10px}.footer-brand{font-weight:600;color:#7a826e;margin-right:10px}footer a{display:flex;gap:7px;align-items:center}.key{font:9px var(--mono);background:#eeefe8;border:1px solid #e1e4d8;border-radius:3px;padding:3px 5px}
+/* The first font supplies the x-height ratio inherited by the inline code. */
+#mixed-fonts-container{font-size-adjust:from-font}
+/* This independent theme maintains its own explicit x-height ratio. */
+#independent-theme-container{font-size-adjust:0.52}
+body.show-guides .text-sample{background-image:repeating-linear-gradient(to bottom,transparent 0,transparent calc(1.9em - 1px),#e8683520 calc(1.9em - 1px),#e8683520 1.9em)}
+@media(min-width:1450px){main{padding-top:65px}.workspace{margin-top:42px}}@media(max-width:900px){main{padding:35px 25px 0}.workspace{grid-template-columns:215px minmax(0,1fr)}.controls{padding:23px 18px}.preview-body{padding:23px}.text-sample{font-size:18px}.version{display:none}h1{font-size:40px}.sample-top{align-items:flex-start}.badge{white-space:nowrap}}@media(max-width:650px){header{height:68px;padding:0 22px}nav{gap:20px}nav .nav-tag,nav .docs{display:none}main{padding:30px 18px 0}h1{font-size:37px}.intro{font-size:13px}.workspace{display:block;margin-top:25px}.controls{border-right:0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:15px 20px}.controls-heading{grid-column:1/-1;margin:0}.field{margin:0}.control-divider,.control-help,.range-ends{display:none}.toggle-row{align-self:center}.reset{margin:0;align-self:end}.preview-head{padding:0 20px}.preview-body{padding:24px 20px}.text-sample{font-size:19px}.sample-caption{line-height:1.6;padding:0}.independent-box{padding:20px 16px}.independent-box .text-sample{font-size:18px}.code-row{font-size:9px;padding:11px 9px}.copy{font-size:0}.below{grid-template-columns:1fr;gap:22px;margin:28px 0}.benefit p{max-width:300px}footer{font-size:9px}.preview-status{font-size:8px}}
+</style>
+</head>
+<body>
+<header><a class="brand" href="./" aria-label="Type Lab home"><div class="brand-icon">Tt</div>type<span>/</span>lab</a><nav aria-label="Main navigation"><a class="active" href="#playground">Playground</a><span class="nav-tag">01</span><a class="docs" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">Documentation <span class="external">↗</span></a></nav></header>
+<main id="playground">
+<div class="eyebrow"><span class="dot"></span>A little tool for better typography</div>
+<div class="intro-row"><div><h1>Different fonts. Same rhythm.</h1><p class="intro">Bring your type together with <code>font-size-adjust</code>.<br>Consistent visual height, without the manual fine-tuning.</p></div><div class="version">CSS EXPLORATIONS / 001</div></div>
+<div class="workspace">
+<aside class="controls" aria-label="Typography controls">
+<div class="controls-heading"><span class="section-label">The settings</span><span class="sliders">☷</span></div>
+<div class="field"><label for="body-font">Body font</label><select id="body-font"><option value="'Libre Baskerville', Georgia, serif">Libre Baskerville</option><option value="Georgia, serif">Georgia</option><option value="'DM Sans', sans-serif">DM Sans</option></select></div>
+<div class="field"><label for="code-font">Code font</label><select id="code-font"><option value="'IBM Plex Mono', monospace">IBM Plex Mono</option><option value="'Courier New', monospace">Courier New</option><option value="monospace">System monospace</option></select></div>
+<div class="field"><div class="field-title"><label for="font-size">Font size</label><output id="font-size-value" for="font-size">21 px</output></div><input id="font-size" type="range" min="14" max="28" value="21"><div class="range-ends"><span>14 px</span><span>28 px</span></div></div>
+<div class="control-divider"></div>
+<div><div class="toggle-row"><span>Normalize font height</span><button class="switch" role="switch" aria-label="Normalize font height" aria-checked="true" id="normalize"></button></div><p class="control-help">Let the font’s x-height do the work.<br>One property. A more natural fit.</p></div>
+<button class="reset" id="reset"><span>↺</span>Reset to defaults</button>
+</aside>
+<section class="preview" aria-label="Font previews"><div class="preview-head"><div class="preview-head-left"><span class="live-dot"></span><span class="section-label">Live preview</span></div><span class="preview-status">Made to be in harmony</span></div>
+<div class="preview-body">
+<div class="sample-top"><div class="sample-title"><span class="number">01</span> Mixed fonts, in balance</div><span class="badge" id="auto-badge">Auto-adjusted</span></div>
+<p class="sample-caption">Two different families. One consistent visual height.</p>
+<div id="mixed-fonts-container" class="text-sample"><p>Good typography is a quiet kind of magic.<br>Even when <code>inline code</code> enters the conversation,<br>everything should feel like it <em>belongs.</em></p></div>
+<div class="code-row"><span><span class="property">font-size-adjust:</span> <span class="value" id="auto-value">from-font</span>;</span><button class="copy" data-copy="auto" aria-label="Copy automatic adjustment CSS"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><rect x="5" y="5" width="8" height="9" rx="1.5"/><path d="M10 5V2H2v9h3"/></svg><span>Copy</span></button></div>
+<div class="sample-divider"></div>
+<div class="sample-top"><div class="sample-title"><span class="number">02</span> A theme of its own</div><span class="badge theme-badge">Independent</span></div>
+<p class="sample-caption">A fixed metric keeps this little world perfectly proportioned.</p>
+<div class="independent-box" id="independent-theme-container"><div class="theme-label">The editorial theme</div><div class="text-sample"><p>Some things follow their own rules.<br>This theme keeps its character, with <code>precise control</code><br>over the details that make a difference.</p></div><div class="code-row"><span><span class="property">font-size-adjust:</span> <span class="value">0.52</span>;</span><button class="copy" data-copy="theme" aria-label="Copy independent theme CSS"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor"><rect x="5" y="5" width="8" height="9" rx="1.5"/><path d="M10 5V2H2v9h3"/></svg><span>Copy</span></button></div></div>
+</div><div class="preview-foot"><span class="info-icon">i</span> Font size adjusts. Your layout stays in rhythm.</div></section>
+</div>
+<div class="below"><div class="benefit"><span class="benefit-icon">Aa</span><div><h3>Optically consistent</h3><p>Match the perceived size of your fonts,<br>not just their pixel values.</p></div></div><div class="benefit"><span class="benefit-icon">⌘</span><div><h3>Native to the web</h3><p>Modern CSS. No JavaScript calculations.<br>No extra dependencies.</p></div></div><div class="benefit"><span class="benefit-icon">⊞</span><div><h3>Room for individuality</h3><p>Independent themes can set their own<br>metrics and keep their own voice.</p></div></div></div>
+<footer><div><span class="footer-brand">type / lab</span> Small experiments. Better type.</div><a href="#playground" id="guides"><span class="key">G</span> Toggle baseline guides</a></footer>
+</main>
+<script>
+const bodyFont=document.querySelector('#body-font'),codeFont=document.querySelector('#code-font'),size=document.querySelector('#font-size'),mixed=document.querySelector('#mixed-fonts-container'),normalize=document.querySelector('#normalize');
+function update(){mixed.style.fontFamily=bodyFont.value;mixed.style.fontSize=size.value+'px';mixed.querySelector('code').style.fontFamily=codeFont.value;document.querySelector('#font-size-value').value=size.value+' px';const enabled=normalize.getAttribute('aria-checked')==='true';mixed.style.fontSizeAdjust=enabled?'from-font':'none';document.querySelector('#auto-value').textContent=enabled?'from-font':'none';document.querySelector('#auto-badge').textContent=enabled?'Auto-adjusted':'Original metrics'}
+[bodyFont,codeFont,size].forEach(el=>el.addEventListener('input',update));normalize.addEventListener('click',()=>{normalize.setAttribute('aria-checked',normalize.getAttribute('aria-checked')!=='true');update()});document.querySelector('#reset').addEventListener('click',()=>{bodyFont.selectedIndex=0;codeFont.selectedIndex=0;size.value=21;normalize.setAttribute('aria-checked','true');document.body.classList.remove('show-guides');update()});
+document.querySelectorAll('.copy').forEach(button=>button.addEventListener('click',async()=>{const css=button.dataset.copy==='auto'?`#mixed-fonts-container {\n  font-size-adjust: ${normalize.getAttribute('aria-checked')==='true'?'from-font':'none'};\n}`:'#independent-theme-container {\n  font-size-adjust: 0.52;\n}';try{await navigator.clipboard.writeText(css);button.querySelector('span').textContent='Copied!';setTimeout(()=>button.querySelector('span').textContent='Copy',1800)}catch{button.querySelector('span').textContent='Unavailable';setTimeout(()=>button.querySelector('span').textContent='Copy',1800)}}));
+function toggleGuides(){document.body.classList.toggle('show-guides')}document.querySelector('#guides').addEventListener('click',event=>{event.preventDefault();toggleGuides()});document.addEventListener('keydown',event=>{if(event.key.toLowerCase()==='g'&&!event.ctrlKey&&!event.metaKey&&!event.altKey&&!['INPUT','SELECT','TEXTAREA'].includes(document.activeElement.tagName))toggleGuides()});
+</script>
+</body>
+</html>
