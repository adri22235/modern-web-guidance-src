ainer{font-size:calc(var(--sample-size)*1.05);line-height:1.8}#independent-theme-container code{font-size:.9em}}@media(min-width:1450px){.content{padding-top:58px}}@media(max-width:1050px){.sidebar{width:185px;padding-inline:18px}.app{margin-left:185px}.content{padding:35px 28px 24px}.topbar{padding-inline:28px}.code-line .comment{display:none}.toolbar-left{gap:12px}.control{gap:6px}}@media(max-width:760px){.sidebar{position:static;width:auto;padding:15px 22px;flex-direction:row;align-items:center;justify-content:space-between;border-right:0;border-bottom:1px solid var(--line)}.brand{font-size:1.2rem}.brand-icon{font-size:1.8rem}.workspace,.nav-bottom{display:none}.nav-link{padding:8px 11px}.nav-link+.nav-link{display:none}.app{margin-left:0}.topbar{min-height:55px;padding:0 22px}.top-note{display:none}.content{padding:30px 20px 20px}.intro{margin-bottom:23px}h1{letter-spacing:-1.2px}.version{display:none}.toolbar{align-items:flex-start;padding:15px}.toolbar-left{flex-wrap:wrap;gap:12px 16px}.divider{display:none}.control-label{font-size:.65rem}.font-select{max-width:135px}.size-control input{width:70px}.reset{padding-top:5px}.card-head{padding:17px 18px}.card-title{gap:7px}.card h2{font-size:.75rem}.badge{font-size:.55rem}.switch-label{font-size:0}.preview{padding:24px 21px}.font-legend{gap:8px;font-size:.5rem}.preview-meta{margin-bottom:18px}#mixed-fonts-container,#independent-theme-container{font-size:calc(var(--sample-size)*.9)}.code-bar{padding:13px 18px}.code-line{font-size:.58rem}.theme-preview{margin:0 17px 18px;padding:20px}.theme-info{font-size:.58rem}.footer{font-size:.55rem}.info{padding:15px}.intro p{font-size:.75rem}}
