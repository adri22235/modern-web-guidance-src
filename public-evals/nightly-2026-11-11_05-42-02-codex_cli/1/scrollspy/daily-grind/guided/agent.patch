+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.getAttribute('href')));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+
+    function setCurrent(currentLink) {
+      links.forEach(link => {
+        link.classList.toggle('is-active', !nativeTracking && link === currentLink);
+        if (link === currentLink) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncCurrent() {
+      if (nativeTracking) {
+        setCurrent(nav.querySelector('a:target-current'));
+        return;
+      }
+
+      // Prefer the first section visible below the sticky navigation.
+      const top = nav.getBoundingClientRect().bottom;
+      const current = sections.find(section => {
+        const bounds = section.getBoundingClientRect();
+        return bounds.bottom > top && bounds.top < window.innerHeight;
+      });
+      setCurrent(current ? links[sections.indexOf(current)] : null);
+    }
+
+    let observer;
+    function updateNavigationSize() {
+      const height = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${height}px`);
+      if (!nativeTracking) {
+        observer?.disconnect();
+        observer = new IntersectionObserver(syncCurrent, {
+          rootMargin: `-${height}px 0px 0px 0px`,
+          threshold: 0
+        });
+        sections.forEach(section => observer.observe(section));
+      }
+      syncCurrent();
+    }
+
+    new ResizeObserver(updateNavigationSize).observe(nav);
+    window.addEventListener('resize', updateNavigationSize);
+    window.addEventListener('pageshow', syncCurrent);
+    window.addEventListener('hashchange', () => requestAnimationFrame(syncCurrent));
+    document.addEventListener('scrollend', syncCurrent);
+    // Keep semantic state synchronized while scrolling, including browsers without scrollend.
+    let pending = false;
+    document.addEventListener('scroll', () => {
+      if (pending) return;
+      pending = true;
+      requestAnimationFrame(() => {
+        syncCurrent();
+        pending = false;
+      });
+    }, { passive: true });
+    updateNavigationSize();
+  </script>
+
