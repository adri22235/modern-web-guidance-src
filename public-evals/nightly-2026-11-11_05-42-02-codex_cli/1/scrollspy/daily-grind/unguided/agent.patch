+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = sectionLinks.map(link => document.querySelector(link.hash));
+    let framePending = false;
+
+    function updateActiveSection() {
+      framePending = false;
+      const navBottom = navigation.getBoundingClientRect().bottom;
+      const visibleSections = sections.filter(section => {
+        const bounds = section.getBoundingClientRect();
+        return bounds.bottom > navBottom && bounds.top < window.innerHeight;
+      });
+      // Prefer the section at the reading position, just below the sticky bar.
+      const readingPosition = navBottom + Math.min(160, (window.innerHeight - navBottom) / 3);
+      let activeSection = visibleSections.find(section =>
+        section.getBoundingClientRect().bottom > readingPosition
+      );
+      // Allow the final section to become active even when it cannot reach the top.
+      if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+        activeSection = visibleSections.at(-1);
+      }
+      sectionLinks.forEach(link => {
+        if (activeSection && link.hash === '#' + activeSection.id) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function scheduleUpdate() {
+      if (!framePending) {
+        framePending = true;
+        requestAnimationFrame(updateActiveSection);
+      }
+    }
+
+    new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', navigation.offsetHeight + 'px');
+      scheduleUpdate();
+    }).observe(navigation);
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    updateActiveSection();
+  </script>
+
 </body>
 
