new file mode 100644
index 0000000..6b4cd90
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,30 @@
+// Hydrate the served light DOM in place. Styles live in the document head so
+// cards render fully styled even before this module loads (or if it fails).
+class DrinkCard extends HTMLElement {
+  #button;
+
+  #toggleFavorite = () => {
+    const favorite = this.#button.getAttribute('aria-pressed') !== 'true';
+    this.#button.setAttribute('aria-pressed', String(favorite));
+    this.#button.textContent = favorite ? '♥ Favorite' : '♡ Favorite';
+  };
+
+  connectedCallback() {
+    this.#button = this.querySelector('[data-favorite]');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    if (!this.#button) return;
+
+    this.#button.removeEventListener('click', this.#toggleFavorite);
+    this.#button.disabled = true;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
