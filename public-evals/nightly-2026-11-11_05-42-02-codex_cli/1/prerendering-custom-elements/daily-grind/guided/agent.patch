diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..0e71a06
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,53 @@
+// Module scripts run after parsing, so each server-rendered tree is ready.
+if (globalThis.customElements && !customElements.get('drink-card')) {
+  class DrinkCard extends HTMLElement {
+    static observedAttributes = ['favorite'];
+
+    #button;
+
+    get favorite() {
+      return this.hasAttribute('favorite');
+    }
+
+    set favorite(value) {
+      this.toggleAttribute('favorite', Boolean(value));
+    }
+
+    connectedCallback() {
+      // Reconnecting a card must not add a second click listener.
+      if (this.#button) return;
+
+      if (!this.shadowRoot) {
+        // Older parsers leave the declarative template inert. Adopt that same
+        // server markup only when no parsed shadow root already exists.
+        const template = this.querySelector('template[shadowrootmode="open"]');
+        if (!template) return;
+        this.attachShadow({ mode: 'open' }).append(template.content);
+        template.remove();
+      }
+
+      this.#button = this.shadowRoot.querySelector('button');
+      if (!this.#button) return;
+
+      this.#syncFavorite();
+      this.#button.addEventListener('click', () => {
+        this.favorite = !this.favorite;
+        this.dispatchEvent(new CustomEvent('favorite-change', {
+          bubbles: true,
+          detail: { favorite: this.favorite },
+        }));
+      });
+      this.#button.disabled = false;
+    }
+
+    attributeChangedCallback() {
+      this.#syncFavorite();
+    }
+
+    #syncFavorite() {
+      this.#button?.setAttribute('aria-pressed', String(this.favorite));
+    }
+  }
+
+  customElements.define('drink-card', DrinkCard);
+}
