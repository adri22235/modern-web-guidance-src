diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..60409fc
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,153 @@
+/** A native form participant. Its value attribute is the reset default. */
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'value'];
+
+  #internals;
+  #root;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+  #descriptions = ['Poor', 'Fair', 'Good', 'Great', 'Loved it'];
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this.#root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; gap: 8px; width: fit-content; }
+        button { display: grid; place-items: center; width: 48px; height: 48px;
+          padding: 0; border: 1px solid #d6cfc4; border-radius: 7px; background: #fffcf7;
+          color: #c9bfb1; cursor: pointer; transition: background .15s, border-color .15s; }
+        svg { width: 27px; height: 27px; fill: transparent; stroke: currentColor; stroke-width: 1.5; }
+        button[data-filled] { color: #a36b22; background: #f8ebd3; border-color: #dbbd8d; }
+        button[data-filled] svg { fill: #dba648; }
+        button:focus-visible { outline: 2px solid #52694b; outline-offset: 3px; }
+        button:disabled { cursor: not-allowed; opacity: .45; }
+        .hint { margin: 9px 0 0; color: #80736a; font: 12px/1.6 'Segoe UI', sans-serif; }
+        .error { margin: 5px 0 0; color: #a13224; font: 12px/1.6 'Segoe UI', sans-serif; }
+        .error:empty { display: none; }
+        @media (max-width: 360px) { .stars { gap: 5px; } button { width: 39px; height: 43px; } }
+        @media (prefers-reduced-motion: reduce) { button { transition: none; } }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Coffee rating" aria-describedby="hint error">
+        ${this.#descriptions.map((description, index) => `
+          <button type="button" role="radio" aria-checked="false" aria-label="${index + 1} ${index === 0 ? 'star' : 'stars'} — ${description}" data-value="${index + 1}" tabindex="-1">
+            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 4 8.1 8.9 1.3-6.4 6.3 1.5 8.9-8-4.2-8 4.2 1.5-8.9-6.4-6.3 8.9-1.3Z"/></svg>
+          </button>`).join('')}
+      </div>
+      <p class="hint" id="hint">Select a star, from 1 to 5.</p>
+      <p class="error" id="error" aria-live="polite"></p>`;
+
+    this.#root.addEventListener('click', (event) => {
+      const button = event.target.closest('button');
+      if (button && !this.#disabled) this.#choose(button.dataset.value);
+    });
+    this.#root.addEventListener('keydown', (event) => {
+      if (this.#disabled || !event.target.matches('button')) return;
+      let next;
+      const current = Number(event.target.dataset.value);
+      switch (event.key) {
+        case 'ArrowRight': case 'ArrowDown': next = current % 5 + 1; break;
+        case 'ArrowLeft': case 'ArrowUp': next = (current + 3) % 5 + 1; break;
+        case 'Home': next = 1; break;
+        case 'End': next = 5; break;
+        default: return;
+      }
+      event.preventDefault();
+      this.#choose(String(next));
+      this.#buttons[next - 1].focus();
+    });
+    this.#root.querySelector('.stars').addEventListener('pointerover', (event) => {
+      const button = event.target.closest('button');
+      if (button && !this.#disabled) this.#paint(Number(button.dataset.value));
+    });
+    this.#root.querySelector('.stars').addEventListener('pointerleave', () => this.#paint(Number(this.#value)));
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  get #buttons() { return [...this.#root.querySelectorAll('button')]; }
+  connectedCallback() { this.#render(); }
+  attributeChangedCallback(name) {
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#render();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#render();
+  }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  get labels() { return this.#internals.labels; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#normalize(this.getAttribute('value'));
+    this.#showError = false;
+    this.#render();
+  }
+  formDisabledCallback(disabled) {
+    // Includes the effective disabled state inherited from a fieldset.
+    this.#disabled = disabled;
+    this.#render();
+  }
+  formStateRestoreCallback(state) {
+    this.value = typeof state === 'string' ? state : '';
+    this.#showError = false;
+    this.#render();
+  }
+
+  #normalize(value) { return /^[1-5]$/.test(String(value)) ? String(value) : ''; }
+  #choose(value) {
+    if (value === this.#value) return;
+    this.value = value;
+    this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+  #paint(value) {
+    this.#buttons.forEach((button, index) => button.toggleAttribute('data-filled', index < value));
+  }
+  #render() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    const missing = this.required && !this.#value && !this.#disabled;
+    const anchor = this.#buttons[Number(this.#value || 1) - 1];
+    this.#internals.setValidity(missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a coffee rating.' : '', anchor);
+    const group = this.#root.querySelector('.stars');
+    group.setAttribute('aria-required', String(this.required));
+    group.setAttribute('aria-disabled', String(this.#disabled));
+    group.setAttribute('aria-invalid', String(missing && this.#showError));
+    this.#buttons.forEach((button) => {
+      button.disabled = this.#disabled;
+      button.setAttribute('aria-checked', String(button.dataset.value === this.#value));
+      button.tabIndex = !this.#disabled && button === anchor ? 0 : -1;
+    });
+    this.#paint(Number(this.#value));
+    this.#root.querySelector('#hint').textContent = this.#value
+      ? `${this.#value} out of 5 — ${this.#descriptions[Number(this.#value) - 1]}`
+      : 'Select a star, from 1 to 5.';
+    this.#root.querySelector('#error').textContent = missing && this.#showError
+      ? 'Please choose a coffee rating.' : '';
+  }
+}
+
+customElements.define('star-rating', StarRating);
