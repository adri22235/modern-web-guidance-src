diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..1b9e27f
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,174 @@
+/** A single-value, form-associated control. No proxy input is needed. */
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'value'];
+
+  #internals;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #radios;
+  #summary;
+  #error;
+  #descriptions = ['Not for me', 'Could be better', 'Pretty good', 'Loved it', 'Made my day'];
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'group';
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; color: #4e342e; }
+        fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
+        legend, input { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+        .stars { display: flex; flex-wrap: wrap; gap: 4px; width: fit-content; }
+        label { display: grid; place-items: center; width: 48px; height: 52px; cursor: pointer; border-radius: 5px; }
+        svg { width: 36px; height: 36px; fill: transparent; stroke: #8b7667; stroke-width: 1.5; }
+        label[data-filled] svg { fill: #b77420; stroke: #9a5d12; }
+        label:hover { background: #f6eee1; }
+        label:has(input:focus-visible) { outline: 3px solid #946216; outline-offset: 2px; }
+        :host(:disabled) { opacity: 0.55; }
+        :host(:disabled) label { cursor: default; }
+        :host(:disabled) label:hover { background: transparent; }
+        .summary { margin: 6px 0 0; font: 0.875rem/1.6 'Segoe UI', sans-serif; color: #6c5850; }
+        .error { color: #a52b22; margin: 6px 0 0; font: 0.875rem/1.6 'Segoe UI', sans-serif; }
+        .error:empty { display: none; }
+        @media (forced-colors: active) {
+          svg { stroke: ButtonText; }
+          label[data-filled] svg { fill: Highlight; stroke: ButtonText; }
+        }
+      </style>
+      <fieldset>
+        <legend>Choose a star rating</legend>
+        <div class="stars">
+          ${this.#descriptions.map((description, index) => `
+            <label>
+              <input type="radio" name="stars" value="${index + 1}" aria-label="${index + 1} ${index === 0 ? 'star' : 'stars'} — ${description}">
+              <svg viewBox="0 0 40 40" aria-hidden="true"><path d="m20 3 5.1 10.4 11.5 1.7-8.3 8.1 2 11.4L20 29.2 9.7 34.6l2-11.4-8.3-8.1 11.5-1.7Z"/></svg>
+            </label>`).join('')}
+        </div>
+      </fieldset>
+      <p class="summary" aria-live="polite"></p>
+      <p class="error" role="alert"></p>`;
+    this.#radios = [...root.querySelectorAll('input')];
+    this.#summary = root.querySelector('.summary');
+    this.#error = root.querySelector('.error');
+
+    // Only the host emits value events; the shadow inputs are implementation details.
+    root.addEventListener('input', (event) => event.stopPropagation());
+    root.addEventListener('change', (event) => {
+      event.stopPropagation();
+      if (this.#disabled) return;
+      this.value = event.target.value;
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true, inputType: 'insertReplacementText' }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#error.textContent = this.validationMessage;
+      this.#internals.ariaInvalid = 'true';
+    });
+  }
+
+  connectedCallback() {
+    // Reconnecting must not erase a user's selection or restored state.
+    if (!this.#dirty) this.#value = this.#normalize(this.defaultValue);
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(newValue);
+    this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', String(value)); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', String(value)); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  focus(options) {
+    (this.#radios.find((radio) => radio.checked) ?? this.#radios[0]).focus(options);
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#value = this.#normalize(this.defaultValue);
+    this.#error.textContent = '';
+    this.#internals.ariaInvalid = null;
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    this.#disabled = disabled;
+    // Never reflect inherited fieldset state to the host's disabled attribute.
+    this.shadowRoot.querySelector('fieldset').disabled = disabled;
+    this.#internals.ariaDisabled = String(disabled);
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #normalize(value) {
+    const text = String(value ?? '');
+    return /^[1-5]$/.test(text) ? text : '';
+  }
+
+  #sync() {
+    this.#radios.forEach((radio) => {
+      radio.checked = radio.value === this.#value;
+      radio.parentElement.toggleAttribute('data-filled', Number(radio.value) <= Number(this.#value));
+    });
+    this.#summary.textContent = this.#value
+      ? `${this.#value} of 5 — ${this.#descriptions[Number(this.#value) - 1]}`
+      : 'Your next great cup starts with a little feedback.';
+    // Explicit state lets the browser restore exactly the same serialized value.
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    const missing = this.required && !this.#value;
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please choose a rating from 1 to 5 stars.' : '',
+      this.#radios[0],
+    );
+    this.#internals.ariaRequired = String(this.required);
+    if (!missing || this.#disabled) {
+      this.#error.textContent = '';
+      this.#internals.ariaInvalid = null;
+    }
+  }
+}
+
+if ('attachInternals' in HTMLElement.prototype && 'setFormValue' in ElementInternals.prototype) {
+  customElements.define('star-rating', StarRating);
+} else {
+  // A visible native fallback retains required validation and submission.
+  for (const rating of document.querySelectorAll('star-rating')) {
+    const select = document.createElement('select');
+    for (const attribute of ['id', 'name', 'required', 'disabled', 'aria-labelledby', 'aria-describedby']) {
+      if (rating.hasAttribute(attribute)) select.setAttribute(attribute, rating.getAttribute(attribute));
+    }
+    select.append(new Option('Choose your rating', ''));
+    for (let value = 1; value <= 5; value++) select.append(new Option(`${value} of 5 stars`, String(value)));
+    select.value = rating.getAttribute('value') ?? '';
+    for (const option of select.options) option.defaultSelected = option.value === select.value;
+    rating.replaceWith(select);
+  }
+}
