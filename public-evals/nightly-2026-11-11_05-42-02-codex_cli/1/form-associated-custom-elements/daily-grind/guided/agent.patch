diff --git a/feedback.js b/feedback.js
new file mode 100644
index 0000000..8aeaef6
--- /dev/null
+++ b/feedback.js
@@ -0,0 +1,24 @@
+const form = document.querySelector('#coffee-feedback');
+const status = document.querySelector('#feedback-status');
+
+// This static homepage has no submission service. Preview the real native
+// payload without claiming that a message was delivered or saved.
+form.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const data = new FormData(form);
+  const coffee = form.elements.namedItem('coffee').selectedOptions[0].textContent;
+  const rating = data.get('rating');
+  if (!rating) {
+    status.textContent = 'Please enable JavaScript in a supported browser to choose a rating.';
+    return;
+  }
+  const comments = String(data.get('comments') ?? '').trim();
+  status.textContent = `Feedback preview: ${coffee}, ${rating} of 5 stars.${comments ? ` Your note: “${comments}”` : ''} Thanks for sharing your thoughts! This preview has not been sent.`;
+});
+
+form.addEventListener('reset', () => {
+  status.textContent = '';
+});
+form.addEventListener('input', () => {
+  status.textContent = '';
+});
