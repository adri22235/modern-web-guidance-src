+  <script>
+    const loadingLinks = document.querySelectorAll('a[data-loading]');
+
+    function resetLoading() {
+      for (const link of loadingLinks) {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('progress').hidden = true;
+      }
+    }
+
+    document.addEventListener('click', (event) => {
+      // Keep modified clicks, downloads, and new-tab navigation native.
+      if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+          event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      const link = event.target.closest('a[href]');
+      if (!link || link.hasAttribute('download') ||
+          (link.target && link.target !== '_self')) return;
+
+      if (link.getAttribute('aria-busy') === 'true') {
+        event.preventDefault();
+        return;
+      }
+
+      resetLoading();
+      if (!link.hasAttribute('data-loading')) return;
+
+      link.setAttribute('aria-busy', 'true');
+      link.setAttribute('aria-disabled', 'true');
+      link.querySelector('progress').hidden = false;
+      // Let the browser follow the original href without an artificial delay.
+    });
+
+    // Back/forward cache restores the DOM, including any pending indicators.
+    window.addEventListener('pageshow', resetLoading);
+    // Escape can cancel a pending browser navigation; allow another attempt.
+    window.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') resetLoading();
+    });
+  </script>
