+  <script>
+    const loadingStatus = document.getElementById('loading-status');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+    const loadingLinks = document.querySelectorAll('[data-loading-label]');
+
+    loadingLinks.forEach((link) => {
+      const label = link.querySelector('.btn-label');
+      const originalLabel = label.textContent;
+      link.addEventListener('click', (event) => {
+        // Keep opening links in another tab or window working normally.
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey) return;
+
+        if (link.getAttribute('aria-disabled') === 'true') {
+          event.preventDefault();
+          return;
+        }
+
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.querySelector('.spinner').hidden = false;
+        label.textContent = link.dataset.loadingLabel;
+        if (seasonalFavorites.contains(link)) {
+          seasonalFavorites.setAttribute('aria-busy', 'true');
+        }
+        loadingStatus.textContent = link.dataset.loadingMessage;
+      });
+
+      // Also runs when a page is restored from the back/forward cache.
+      window.addEventListener('pageshow', () => {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        link.querySelector('.spinner').hidden = true;
+        label.textContent = originalLabel;
+      });
+    });
+
+    window.addEventListener('pageshow', () => {
+      seasonalFavorites.setAttribute('aria-busy', 'false');
+      loadingStatus.textContent = '';
+    });
+  </script>
