index 0000000..f0d897e
--- /dev/null
+++ b/navigation.js
@@ -0,0 +1,222 @@
+(() => {
+  const bar = document.querySelector('.app-menubar');
+  const triggers = [...bar.querySelectorAll(':scope > .menu-trigger')];
+  const menuFor = trigger => document.getElementById(trigger.getAttribute('commandfor'));
+  const menus = triggers.map(menuFor);
+  const hasPopover = 'popover' in HTMLElement.prototype;
+  const hasInvoker = 'commandForElement' in HTMLButtonElement.prototype;
+  const hasFocusgroup = 'focusGroup' in HTMLElement.prototype;
+  const hasAnchors = CSS.supports('position-area: block-end');
+  const isOpen = menu => menu.hasAttribute('data-open');
+  const itemsFor = menu => [...menu.querySelectorAll('a[href]')];
+  const enterOnOpen = new Map();
+  let suppressPreview = false;
+  let windowInactive = false;
+  let windowFocusTimer;
+
+  function focusTrigger(trigger) {
+    suppressPreview = true;
+    trigger.focus();
+    suppressPreview = false;
+  }
+
+  function positionMenu(menu) {
+    if (hasAnchors && hasPopover) return;
+    const trigger = triggers[menus.indexOf(menu)];
+    const rect = trigger.getBoundingClientRect();
+    const gap = 8;
+    const left = Math.max(gap, Math.min(rect.left, innerWidth - menu.offsetWidth - gap));
+    const below = rect.bottom;
+    const top = below + menu.offsetHeight <= innerHeight - gap
+      ? below : Math.max(gap, rect.top - menu.offsetHeight);
+    menu.style.setProperty('--menu-left', `${left}px`);
+    menu.style.setProperty('--menu-top', `${top}px`);
+    // A manual popover fallback cannot use the implicit CSS anchor.
+    if (!hasPopover) {
+      menu.style.left = `${left}px`;
+      menu.style.top = `${top}px`;
+    }
+  }
+
+  function updateState(menu, open) {
+    menu.toggleAttribute('data-open', open);
+    triggers[menus.indexOf(menu)].setAttribute('aria-expanded', String(open));
+  }
+
+  function finishOpening(menu) {
+    if (!isOpen(menu)) return;
+    positionMenu(menu);
+    const destination = enterOnOpen.get(menu);
+    enterOnOpen.delete(menu);
+    if (destination === 'trigger') {
+      focusTrigger(triggers[menus.indexOf(menu)]);
+    } else if (destination) {
+      const items = itemsFor(menu);
+      (destination === 'last' ? items.at(-1) : items[0])?.focus();
+    }
+  }
+
+  function closeMenu(menu) {
+    enterOnOpen.delete(menu);
+    if (!isOpen(menu)) return;
+    if (menu.contains(document.activeElement)) {
+      focusTrigger(triggers[menus.indexOf(menu)]);
+    }
+    if (hasPopover) menu.hidePopover();
+    else updateState(menu, false);
+  }
+
+  function closeAll() {
+    menus.forEach(closeMenu);
+  }
+
+  function showMenu(trigger) {
+    const menu = menuFor(trigger);
+    if (isOpen(menu)) return;
+    menus.filter(other => other !== menu).forEach(closeMenu);
+    if (hasPopover) menu.showPopover({ source: trigger });
+    else {
+      updateState(menu, true);
+      finishOpening(menu);
+    }
+  }
+
+  function moveToTrigger(trigger, direction) {
+    const next = triggers[(triggers.indexOf(trigger) + direction + triggers.length) % triggers.length];
+    closeAll();
+    triggers.forEach(item => { item.tabIndex = item === next ? 0 : -1; });
+    next.focus();
+  }
+
+  triggers.forEach((trigger, index) => {
+    const menu = menus[index];
+    const group = menu.querySelector('[focusgroup]');
+
+    if (!hasPopover) menu.setAttribute('data-fallback', '');
+    if (hasAnchors && (!('ToggleEvent' in window) || !('source' in ToggleEvent.prototype))) {
+      trigger.style.setProperty('anchor-name', `--${trigger.id}`);
+      menu.style.setProperty('position-anchor', `--${trigger.id}`);
+    }
+
+    if (!hasFocusgroup) {
+      group.setAttribute('role', 'menu');
+      itemsFor(menu).forEach(item => item.setAttribute('role', 'menuitem'));
+      group.addEventListener('keydown', event => {
+        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+        const items = itemsFor(menu);
+        const current = items.indexOf(document.activeElement);
+        if (current < 0) return;
+        event.preventDefault();
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1
+          : (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+        items[next].focus();
+      });
+    }
+
+    menu.addEventListener('beforetoggle', event => updateState(menu, event.newState === 'open'));
+    menu.addEventListener('toggle', () => {
+      if (isOpen(menu)) finishOpening(menu);
+      else enterOnOpen.delete(menu);
+    });
+
+    trigger.addEventListener('focus', event => {
+      if (suppressPreview || windowInactive || menu.contains(event.relatedTarget)) return;
+      showMenu(trigger);
+    });
+    trigger.addEventListener('blur', event => {
+      if (!menu.contains(event.relatedTarget)) closeMenu(menu);
+    });
+    trigger.addEventListener('pointerdown', event => {
+      if (event.button === 0) event.preventDefault();
+    });
+    trigger.addEventListener('pointerenter', event => {
+      if (event.pointerType === 'touch' || !menus.some(isOpen) || isOpen(menu)) return;
+      closeAll();
+      triggers.forEach(item => { item.tabIndex = item === trigger ? 0 : -1; });
+      trigger.focus({ focusVisible: false });
+      showMenu(trigger);
+    });
+    trigger.addEventListener('click', event => {
+      const opening = !isOpen(menu);
+      if (opening) enterOnOpen.set(menu, event.detail === 0 ? 'first' : 'trigger');
+      if (!hasInvoker || !hasPopover) {
+        event.preventDefault();
+        if (opening) showMenu(trigger);
+        else {
+          focusTrigger(trigger);
+          closeMenu(menu);
+        }
+      } else if (!opening) {
+        focusTrigger(trigger);
+      }
+    });
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        event.preventDefault();
+        moveToTrigger(trigger, event.key === 'ArrowLeft' ? -1 : 1);
+      } else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const destination = ['ArrowUp', 'End'].includes(event.key) ? 'last' : 'first';
+        if (isOpen(menu)) {
+          const items = itemsFor(menu);
+          (destination === 'last' ? items.at(-1) : items[0])?.focus();
+        } else {
+          enterOnOpen.set(menu, destination);
+          showMenu(trigger);
+        }
+      }
+    });
+    menu.addEventListener('keydown', event => {
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        event.preventDefault();
+        moveToTrigger(trigger, event.key === 'ArrowLeft' ? -1 : 1);
+      } else if (event.key === ' ' && event.target.matches('a[href]')) {
+        event.preventDefault();
+        event.target.click();
+      }
+    });
+    itemsFor(menu).forEach(item => {
+      item.addEventListener('pointermove', event => {
+        if (event.pointerType !== 'touch' && document.activeElement !== item) {
+          item.focus({ focusVisible: false });
+        }
+      });
+      item.addEventListener('click', () => {
+        focusTrigger(trigger);
+        closeAll();
+      });
+    });
+  });
+
+  bar.addEventListener('keydown', event => {
+    if (event.key === 'Escape') {
+      event.preventDefault();
+      const menu = menus.find(isOpen);
+      if (menu) focusTrigger(triggers[menus.indexOf(menu)]);
+      closeAll();
+    } else if (event.key === 'Tab') {
+      // Return to the bar's one tab stop before the browser advances naturally.
+      if (menus.some(menu => menu.contains(document.activeElement))) {
+        focusTrigger(triggers.find(trigger => trigger.tabIndex === 0));
+      }
+      closeAll();
+    }
+  });
+
+  document.addEventListener('focusin', event => {
+    if (!bar.contains(event.target)) closeAll();
+  });
+  document.addEventListener('pointerdown', event => {
+    if (!bar.contains(event.target)) closeAll();
+  });
+  window.addEventListener('blur', () => {
+    clearTimeout(windowFocusTimer);
+    windowInactive = true;
+    closeAll();
+  });
+  window.addEventListener('focus', () => {
+    windowFocusTimer = setTimeout(() => { windowInactive = false; }, 0);
+  });
+  window.addEventListener('resize', () => menus.filter(isOpen).forEach(positionMenu));
+  document.addEventListener('scroll', () => menus.filter(isOpen).forEach(positionMenu), true);
+})();
