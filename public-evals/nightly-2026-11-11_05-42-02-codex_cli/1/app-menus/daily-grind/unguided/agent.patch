+  <script>
+    const menubar = document.querySelector('.app-menubar');
+    const triggers = [...menubar.querySelectorAll('.menu-trigger')];
+    const menuFor = trigger => document.getElementById(trigger.getAttribute('aria-controls'));
+    const itemsFor = trigger => [...menuFor(trigger).querySelectorAll('[role="menuitem"]')];
+
+    function closeMenus() {
+      triggers.forEach(trigger => {
+        trigger.setAttribute('aria-expanded', 'false');
+        menuFor(trigger).hidden = true;
+      });
+    }
+
+    function focusTrigger(trigger) {
+      triggers.forEach(item => item.tabIndex = item === trigger ? 0 : -1);
+      trigger.focus();
+    }
+
+    function openMenu(trigger, last = false) {
+      closeMenus();
+      trigger.setAttribute('aria-expanded', 'true');
+      menuFor(trigger).hidden = false;
+      const items = itemsFor(trigger);
+      items[last ? items.length - 1 : 0].focus();
+    }
+
+    triggers.forEach((trigger, index) => {
+      trigger.addEventListener('focus', () => {
+        triggers.forEach(item => item.tabIndex = item === trigger ? 0 : -1);
+      });
+
+      trigger.addEventListener('click', () => {
+        if (trigger.getAttribute('aria-expanded') === 'true') {
+          closeMenus();
+        } else {
+          openMenu(trigger);
+        }
+      });
+
+      trigger.parentElement.addEventListener('keydown', event => {
+        const inMenu = event.target !== trigger;
+        const items = itemsFor(trigger);
+        const itemIndex = items.indexOf(document.activeElement);
+        const key = event.key;
+
+        if (key === 'Tab') {
+          // Move from the menubar's single tab stop to the next page control.
+          if (inMenu) focusTrigger(trigger);
+          closeMenus();
+          return;
+        }
+
+        if (inMenu && (key === 'Enter' || key === ' ')) {
+          event.preventDefault();
+          event.target.click();
+          return;
+        }
+
+        if (key === 'Escape') {
+          closeMenus();
+          focusTrigger(trigger);
+        } else if (key === 'ArrowLeft' || key === 'ArrowRight') {
+          const next = triggers[(index + (key === 'ArrowRight' ? 1 : -1) + triggers.length) % triggers.length];
+          closeMenus();
+          focusTrigger(next);
+          if (inMenu) openMenu(next);
+        } else if (key === 'ArrowDown' || key === 'ArrowUp') {
+          if (!inMenu) {
+            openMenu(trigger, key === 'ArrowUp');
+          } else {
+            items[(itemIndex + (key === 'ArrowDown' ? 1 : -1) + items.length) % items.length].focus();
+          }
+        } else if (key === 'Home' || key === 'End') {
+          if (inMenu) {
+            items[key === 'Home' ? 0 : items.length - 1].focus();
+          } else {
+            closeMenus();
+            focusTrigger(triggers[key === 'Home' ? 0 : triggers.length - 1]);
+          }
+        } else if (inMenu && key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          const ordered = [...items.slice(itemIndex + 1), ...items.slice(0, itemIndex + 1)];
+          const match = ordered.find(item => item.textContent.trim().toLowerCase().startsWith(key.toLowerCase()));
+          if (!match) return;
+          match.focus();
+        } else {
+          return;
+        }
+        event.preventDefault();
+      });
+    });
+
+    document.addEventListener('pointerdown', event => {
+      if (!menubar.contains(event.target)) closeMenus();
+    });
+    menubar.addEventListener('focusout', event => {
+      if (!menubar.contains(event.relatedTarget)) closeMenus();
+    });
+    menubar.addEventListener('click', event => {
+      if (event.target.closest('a')) closeMenus();
+    });
+  </script>
