diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,80 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const toolName = 'get_menu_item';
+      // Older WebMCP implementations expose the API on navigator.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const normalizeName = (name) => name.trim().replace(/\s+/g, ' ').toLowerCase();
+      const tool = {
+        name: toolName,
+        description: 'Look up a Daily Grind menu item by its full name and return its name, description, and details URL. Matching ignores capitalization and extra whitespace. Returns an error and available names when no item matches.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              minLength: 1,
+              description: 'The full menu item name, such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew.'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        execute: async (input) => {
+          if (typeof input?.name !== 'string' || !normalizeName(input.name)) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          // Read the displayed menu so the tool and page share the same details.
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const item = items.find(({ name }) => normalizeName(name) === normalizeName(input.name));
+          return item ?? {
+            error: `No menu item found for "${input.name}".`,
+            availableNames: items.map(({ name }) => name)
+          };
+        }
+      };
+
+      let registration;
+      async function registerTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registration === controller) registration = undefined;
+          if (!controller.signal.aborted) console.warn('Menu tool registration failed:', error);
+        }
+      }
+
+      function cleanupTool() {
+        if (!registration) return;
+        registration.abort();
+        registration = undefined;
+        // Legacy implementations use unregisterTool instead of AbortSignal.
+        if (!document.modelContext && typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(toolName);
+        }
+      }
+
+      // pagehide also handles pages entering the back/forward cache.
+      window.addEventListener('pagehide', cleanupTool);
+      window.addEventListener('pageshow', registerTool);
+      registerTool();
+    })();
+  </script>
+
 </body>
 
 </html>
