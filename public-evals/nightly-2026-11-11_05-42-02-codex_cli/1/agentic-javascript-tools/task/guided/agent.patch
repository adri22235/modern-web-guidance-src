     <a href="/order-online" class="btn">Order Now</a>
   </header>
 
   <main class="container">
-    <section>
+    <section id="seasonal-favorites">
       <h2 style="text-align: center;">Seasonal Favorites</h2>
       <div class="grid">
         <div class="card">
           <h3>Maple Oat Latte</h3>
@@ -206,7 +206,72 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const modelContext = document.modelContext;
+
+    if (typeof modelContext?.registerTool === 'function') {
+      let registrationController;
+
+      const menuItemTool = {
+        name: 'get_menu_item',
+        description: 'Look up a Daily Grind menu item and return its name, description, and details link. Use when answering questions about a drink on the menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              minLength: 1,
+              description: 'The menu item to look up, such as Maple Oat Latte. Matching ignores capitalization and surrounding whitespace.',
+            },
+          },
+          required: ['itemName'],
+          additionalProperties: false,
+        },
+        execute(input) {
+          if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+            return { error: 'Provide a non-empty menu item name in itemName.' };
+          }
+
+          // Read the displayed menu so assistant responses stay in sync with it.
+          const menuItems = Array.from(document.querySelectorAll('#seasonal-favorites .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href,
+          }));
+          const requestedName = input.itemName.trim().toLowerCase();
+          const item = menuItems.find((entry) => entry.name.toLowerCase() === requestedName);
+
+          return item ?? {
+            error: `Menu item "${input.itemName.trim()}" not found.`,
+            availableItems: menuItems.map((entry) => entry.name),
+          };
+        },
+        annotations: { readOnlyHint: true },
+      };
+
+      async function registerMenuItemTool() {
+        if (registrationController && !registrationController.signal.aborted) return;
+
+        const controller = new AbortController();
+        registrationController = controller;
+        try {
+          await modelContext.registerTool(menuItemTool, { signal: controller.signal });
+        } catch (error) {
+          controller.abort();
+          console.warn('Menu item tool registration failed.', error);
+        }
+      }
+
+      // AbortSignal removes the tool when navigating away, including cached pages.
+      window.addEventListener('pagehide', () => registrationController?.abort());
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerMenuItemTool();
+      });
+      registerMenuItemTool();
+    }
+  </script>
+
 </body>
 
 </html>
