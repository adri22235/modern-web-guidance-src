+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingReview = document.getElementById('shipping-review');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      const address = [
+        details.get('name'),
+        details.get('street-address'),
+        [details.get('city'), details.get('region'), details.get('postal-code')].filter(Boolean).join(', '),
+        details.get('country'),
+        details.get('email'),
+        details.get('tel')
+      ].filter(Boolean).join('\n');
+      shippingReview.textContent = `Your shipping details for review:\n${address}\n\nYou can edit the fields above and review again. No order has been placed.`;
+    });
+
+    shippingForm.addEventListener('input', () => {
+      shippingReview.textContent = '';
+    });
+
+    document.getElementById('review-shipping').hidden = false;
+  </script>
