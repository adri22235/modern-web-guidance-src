+    /* Progress: a known reward total and an open-ended order process. */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: 28px;
+      background: #fffaf3;
+      border: 1px solid #e8dcd0;
+      border-radius: 12px;
+    }
+
+    .progress-panel > p {
+      color: #705b52;
+      margin-top: 4px;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 32px;
+      margin-top: 24px;
+    }
+
+    .progress-label {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      flex-wrap: wrap;
+      gap: 4px 12px;
+      margin-bottom: 10px;
+      font-size: 0.9rem;
+    }
+
+    .progress-label h3 {
+      font-size: 1rem;
+    }
+
+    .progress-track {
+      height: 10px;
+      overflow: hidden;
+      background: #e9dfd5;
+      border-radius: 999px;
+    }
+
+    .progress-fill {
+      height: 100%;
+      width: 60%;
+      border-radius: inherit;
+      background: var(--primary);
+    }
+
+    .progress-track--indeterminate .progress-fill {
+      width: 35%;
+      background: #ab641c;
+      animation: brewing 1.8s ease-in-out infinite;
+    }
+
+    .progress-help {
+      margin-top: 10px;
+      font-size: 0.85rem;
+      color: #705b52;
+    }
+
+    @keyframes brewing {
+      from { transform: translateX(-100%); }
+      to { transform: translateX(286%); }
+    }
+
+    @media (max-width: 600px) {
+      .progress-panel { padding: 20px; }
+      .progress-grid { grid-template-columns: 1fr; gap: 24px; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-track--indeterminate .progress-fill {
+        animation: none;
+        margin-inline: auto;
+      }
+    }
+
