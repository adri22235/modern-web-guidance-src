+    /* Rewards and order progress */
+    .progress-panel {
+      margin-bottom: 40px;
+      padding: 24px;
+      background: #fff8f0;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+    }
+
+    .progress-panel h2 {
+      margin-bottom: 4px;
+      color: var(--primary);
+    }
+
+    .progress-items {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 28px;
+      margin-top: 24px;
+    }
+
+    .progress-label {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      gap: 4px 16px;
+      margin-bottom: 8px;
+    }
+
+    .progress-label label {
+      font-weight: 600;
+    }
+
+    .progress-items p {
+      margin-top: 8px;
+      font-size: 0.9rem;
+    }
+
+    .process-progress {
+      --progress-duration: 1.8s;
+      --progress-fill: var(--primary);
+      appearance: none;
+      border: 0 solid;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      border-radius: 999px;
+      overflow: clip;
+      background: var(--secondary);
+      container-type: inline-size;
+    }
+
+    .process-progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .process-progress::-webkit-progress-value {
+      background: var(--progress-fill);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .process-progress::-moz-progress-bar {
+      background: var(--progress-fill);
+      border-radius: 999px;
+      animation: var(--progress-animation, none);
+    }
+
+    .process-progress:indeterminate {
+      --progress-animation: brewing-progress var(--progress-duration) infinite linear;
+    }
+
+    .process-progress:indeterminate:dir(rtl) {
+      --progress-animation: brewing-progress var(--progress-duration) infinite linear reverse;
+    }
+
+    @keyframes brewing-progress {
+      from, to {
+        inline-size: 30%;
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .process-progress {
+        --progress-duration: 12s;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .process-progress {
+        --progress-fill: Highlight;
+        background: Canvas;
+        border: 1px solid CanvasText;
+      }
+    }
+
