diff --git a/spatial-navigation.js b/spatial-navigation.js
new file mode 100644
index 0000000..89f736b
--- /dev/null
+++ b/spatial-navigation.js
@@ -0,0 +1,76 @@
+const directions = {
+  ArrowRight: ['left', 'right', 'top', 'bottom'],
+  ArrowLeft: ['right', 'left', 'top', 'bottom'],
+  ArrowDown: ['top', 'bottom', 'left', 'right'],
+  ArrowUp: ['bottom', 'top', 'left', 'right'],
+};
+
+// Use physical edges, so wrapping, CSS ordering, RTL and unequal card sizes
+// don't require a fixed column count or assumptions about DOM order.
+export function findSpatialTarget(current, candidates, key) {
+  const axes = directions[key];
+  if (!axes) return;
+  const [near, far, crossStart, crossEnd] = axes;
+  const sign = key === 'ArrowLeft' || key === 'ArrowUp' ? -1 : 1;
+  const center = (rect) => (rect[crossStart] + rect[crossEnd]) / 2;
+  const ranked = candidates.flatMap((candidate) => {
+    if (candidate === current) return [];
+    const gap = sign * (candidate.rect[near] - current.rect[far]);
+    if (gap < -1) return [];
+    const offset = Math.abs(center(candidate.rect) - center(current.rect));
+    const aligned = Math.min(candidate.rect[crossEnd], current.rect[crossEnd]) >
+      Math.max(candidate.rect[crossStart], current.rect[crossStart]);
+    return [{ candidate, gap: Math.max(0, gap), offset, aligned }];
+  });
+
+  const aligned = ranked.filter((item) => item.aligned);
+  const choices = aligned.length ? aligned : ranked;
+  choices.sort((a, b) => aligned.length
+    ? a.gap - b.gap || a.offset - b.offset
+    : (a.gap + 2 * a.offset) - (b.gap + 2 * b.offset));
+  return choices[0]?.candidate;
+}
+
+export function initializeSpatialGrid(grid) {
+  const links = [...grid.querySelectorAll('.card > a.btn[href]')];
+  const isVisible = (element) => {
+    if (element.closest('[hidden], [inert], [aria-hidden="true"]') || element.matches(':disabled')) return false;
+    if (element.checkVisibility) {
+      return element.checkVisibility({ visibilityProperty: true, contentVisibilityAuto: true });
+    }
+    const style = getComputedStyle(element);
+    return element.getClientRects().length > 0 && style.visibility === 'visible';
+  };
+  const setActive = (active) => {
+    links.forEach((link) => { link.tabIndex = link === active ? 0 : -1; });
+  };
+  setActive(links.find(isVisible));
+
+  // Pointer and programmatic focus also become the widget's next Tab entry.
+  grid.addEventListener('focusin', (event) => {
+    const target = event.composedPath()[0];
+    if (links.includes(target)) setActive(target);
+  });
+
+  grid.addEventListener('keydown', (event) => {
+    if (!directions[event.key] || event.defaultPrevented || event.isComposing ||
+        event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+    const target = event.composedPath()[0];
+    if (!links.includes(target) || target.matches(':read-write, select, input, textarea, [role="slider"]')) return;
+
+    // Measure on every keypress: responsive layouts can change at any time.
+    const candidates = links.filter(isVisible).map((element) => ({
+      element,
+      rect: element.parentElement.getBoundingClientRect(),
+    })).filter(({ rect }) => rect.width > 0 && rect.height > 0);
+    const current = candidates.find(({ element }) => element === target);
+    if (!current) return;
+    const next = findSpatialTarget(current, candidates, event.key);
+    // At an edge, leave the event untouched so native page scrolling works.
+    if (!next) return;
+    event.preventDefault();
+    setActive(next.element);
+    next.element.focus({ preventScroll: true });
+    next.element.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  });
+}
diff --git a/spatial-navigation.test.js b/spatial-navigation.test.js
new file mode 100644
index 0000000..289156e
--- /dev/null
+++ b/spatial-navigation.test.js
@@ -0,0 +1,129 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { findSpatialTarget, initializeSpatialGrid } from './spatial-navigation.js';
+
+function card(left, top, width = 100, height = 100) {
+  return { rect: { left, top, right: left + width, bottom: top + height, width, height } };
+}
+
+test('arrows follow physical positions in a wrapped grid, independent of DOM order', () => {
+  const a = card(0, 0), b = card(120, 0), c = card(0, 120);
+  const cards = [c, b, a];
+  assert.equal(findSpatialTarget(a, cards, 'ArrowRight'), b);
+  assert.equal(findSpatialTarget(b, cards, 'ArrowLeft'), a);
+  assert.equal(findSpatialTarget(a, cards, 'ArrowDown'), c);
+  assert.equal(findSpatialTarget(c, cards, 'ArrowUp'), a);
+  assert.equal(findSpatialTarget(b, cards, 'ArrowRight'), undefined);
+  assert.equal(findSpatialTarget(c, cards, 'ArrowLeft'), undefined);
+});
+
+test('horizontal, single-column and reversed layouts use their actual geometry', () => {
+  const a = card(0, 0), b = card(120, 0), c = card(240, 0);
+  const cards = [a, b, c];
+  assert.equal(findSpatialTarget(a, cards, 'ArrowRight'), b);
+  assert.equal(findSpatialTarget(a, cards, 'ArrowDown'), undefined);
+  b.rect = card(0, 120).rect;
+  c.rect = card(0, 240).rect;
+  assert.equal(findSpatialTarget(a, cards, 'ArrowRight'), undefined);
+  assert.equal(findSpatialTarget(a, cards, 'ArrowDown'), b);
+  a.rect = card(240, 0).rect;
+  b.rect = card(120, 0).rect;
+  c.rect = card(0, 0).rect;
+  assert.equal(findSpatialTarget(a, cards, 'ArrowLeft'), b);
+  assert.equal(findSpatialTarget(b, cards, 'ArrowLeft'), c);
+});
+
+test('aligned candidates win over diagonal ones; adjacent gaps and offsets break ties', () => {
+  const current = card(0, 0);
+  const diagonal = card(105, 110);
+  const adjacent = card(120, 80, 100, 300);
+  const centered = card(120, 0);
+  const distant = card(240, 0);
+  assert.equal(findSpatialTarget(current, [current, diagonal, adjacent, distant], 'ArrowRight'), adjacent);
+  assert.equal(findSpatialTarget(current, [current, adjacent, centered], 'ArrowRight'), centered);
+});
+
+test('direction uses edges rather than centers, with a subpixel tolerance', () => {
+  const current = card(0, 0);
+  const overlapping = card(50, 0);
+  const rounded = card(99.5, 0);
+  assert.equal(findSpatialTarget(current, [current, overlapping], 'ArrowRight'), undefined);
+  assert.equal(findSpatialTarget(current, [current, rounded], 'ArrowRight'), rounded);
+});
+
+test('diagonal fallback favors alignment and unsupported keys have no target', () => {
+  const current = card(0, 0);
+  const near = card(110, 300), aligned = card(200, 110);
+  assert.equal(findSpatialTarget(current, [current, near, aligned], 'ArrowRight'), aligned);
+  assert.equal(findSpatialTarget(current, [current, aligned], 'Enter'), undefined);
+});
+
+function fixture() {
+  const listeners = {};
+  const links = [card(0, 0), card(120, 0), card(240, 0)].map(({ rect }) => ({
+    rect, visible: true, excluded: false, editable: false,
+    closest() { return this.excluded; },
+    matches(selector) { return selector !== ':disabled' && this.editable; },
+    checkVisibility() { return this.visible; },
+    focus(options) { this.focusOptions = options; listeners.focusin({ composedPath: () => [this] }); },
+    scrollIntoView(options) { this.scrollOptions = options; },
+    get parentElement() { return { getBoundingClientRect: () => this.rect }; },
+  }));
+  const grid = {
+    querySelectorAll: () => links,
+    addEventListener: (type, listener) => { listeners[type] = listener; },
+  };
+  initializeSpatialGrid(grid);
+  const press = (target, key, overrides = {}) => {
+    const event = {
+      key, composedPath: () => [target], defaultPrevented: false,
+      preventDefault() { this.defaultPrevented = true; }, ...overrides,
+    };
+    listeners.keydown(event);
+    return event;
+  };
+  return { links, listeners, press };
+}
+
+test('roving focus, nearest scrolling and pointer focus retain a single Tab entry', () => {
+  const { links, listeners, press } = fixture();
+  assert.deepEqual(links.map((link) => link.tabIndex), [0, -1, -1]);
+  assert.equal(press(links[0], 'ArrowRight').defaultPrevented, true);
+  assert.deepEqual(links.map((link) => link.tabIndex), [-1, 0, -1]);
+  assert.deepEqual(links[1].focusOptions, { preventScroll: true });
+  assert.deepEqual(links[1].scrollOptions, { block: 'nearest', inline: 'nearest' });
+  listeners.focusin({ composedPath: () => [links[2]] });
+  assert.deepEqual(links.map((link) => link.tabIndex), [-1, -1, 0]);
+});
+
+test('boundaries, native keys, modifiers, composing, controls and handled events stay untouched', () => {
+  const { links, press } = fixture();
+  for (const key of ['ArrowLeft', 'ArrowUp', 'ArrowDown', 'Tab', 'Enter', ' ']) {
+    assert.equal(press(links[0], key).defaultPrevented, false);
+  }
+  for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'isComposing']) {
+    assert.equal(press(links[0], 'ArrowRight', { [modifier]: true }).defaultPrevented, false);
+  }
+  press(links[0], 'ArrowRight', { defaultPrevented: true });
+  assert.equal(links[1].focusOptions, undefined);
+  assert.equal(press({}, 'ArrowRight').defaultPrevented, false);
+  links[0].editable = true;
+  assert.equal(press(links[0], 'ArrowRight').defaultPrevented, false);
+});
+
+test('hidden, inert and zero-sized cards are skipped and layout is remeasured', () => {
+  const { links, press } = fixture();
+  links[1].visible = false;
+  press(links[0], 'ArrowRight');
+  assert.equal(links[2].tabIndex, 0);
+  links[1].visible = true;
+  links[1].excluded = true;
+  assert.equal(press(links[2], 'ArrowLeft').defaultPrevented, true);
+  assert.equal(links[0].tabIndex, 0);
+  links[1].excluded = false;
+  links[1].rect = card(0, 120).rect;
+  links[2].rect = card(0, 240, 0, 0).rect;
+  assert.equal(press(links[0], 'ArrowDown').defaultPrevented, true);
+  assert.equal(links[1].tabIndex, 0);
+  assert.equal(press(links[1], 'ArrowDown').defaultPrevented, false);
+});
