diff --git a/spatial-navigation.js b/spatial-navigation.js
new file mode 100644
index 0000000..1d8b076
--- /dev/null
+++ b/spatial-navigation.js
@@ -0,0 +1,70 @@
+const directions = {
+  ArrowLeft: { axis: 'x', sign: -1 },
+  ArrowRight: { axis: 'x', sign: 1 },
+  ArrowUp: { axis: 'y', sign: -1 },
+  ArrowDown: { axis: 'y', sign: 1 },
+};
+
+// Work in physical screen coordinates, including in RTL and reordered layouts.
+export function findSpatialNeighbor(rectangles, currentIndex, key) {
+  const direction = directions[key];
+  const current = rectangles[currentIndex];
+  if (!direction || !current) return -1;
+
+  const horizontal = direction.axis === 'x';
+  const center = (rect) => ({
+    main: horizontal ? (rect.left + rect.right) / 2 : (rect.top + rect.bottom) / 2,
+    cross: horizontal ? (rect.top + rect.bottom) / 2 : (rect.left + rect.right) / 2,
+    start: horizontal ? rect.top : rect.left,
+    end: horizontal ? rect.bottom : rect.right,
+  });
+  const origin = center(current);
+  const candidates = rectangles.flatMap((rect, index) => {
+    if (index === currentIndex) return [];
+    const target = center(rect);
+    const distance = (target.main - origin.main) * direction.sign;
+    if (distance <= 1) return [];
+    const aligned = Math.min(origin.end, target.end) - Math.max(origin.start, target.start) > 1;
+    // Left/right stay within a visual row; they never wrap to another row.
+    if (horizontal && !aligned) return [];
+    return [{ index, aligned, distance, crossDistance: Math.abs(target.cross - origin.cross) }];
+  });
+
+  candidates.sort((a, b) =>
+    Number(b.aligned) - Number(a.aligned) ||
+    a.distance - b.distance || a.crossDistance - b.crossDistance || a.index - b.index);
+  return candidates[0]?.index ?? -1;
+}
+
+export function enableSpatialNavigation(grid) {
+  grid.addEventListener('keydown', (event) => {
+    if (!Object.hasOwn(directions, event.key) || event.defaultPrevented ||
+        event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+
+    // Leave editing and other controls' keyboard behavior intact.
+    const link = event.target.closest('a[href]');
+    if (!link || event.target.isContentEditable || link.closest('[data-spatial-navigation]') !== grid) return;
+    const card = link.closest('.card');
+    if (!card) return;
+
+    // Measure on each keypress so resizing and layout changes need no cached column count.
+    const entries = Array.from(grid.querySelectorAll('.card')).flatMap((item) => {
+      const target = item.querySelector('a[href]');
+      if (!target || target.tabIndex < 0 || target.closest('[inert]') ||
+          target.closest('[aria-hidden="true"]') || !target.getClientRects().length) return [];
+      const style = getComputedStyle(target);
+      if (style.visibility === 'hidden' || style.visibility === 'collapse') return [];
+      return [{ card: item, target, rect: item.getBoundingClientRect() }];
+    });
+    const currentIndex = entries.findIndex((entry) => entry.card === card);
+    if (currentIndex < 0) return;
+    const nextIndex = findSpatialNeighbor(entries.map((entry) => entry.rect), currentIndex, event.key);
+    // At an edge, keep focus in place and prevent unintended page scrolling.
+    event.preventDefault();
+    if (nextIndex >= 0) entries[nextIndex].target.focus();
+  });
+}
+
+if (typeof document !== 'undefined') {
+  document.querySelectorAll('[data-spatial-navigation]').forEach(enableSpatialNavigation);
+}
diff --git a/spatial-navigation.test.js b/spatial-navigation.test.js
new file mode 100644
index 0000000..0b2a7a1
--- /dev/null
+++ b/spatial-navigation.test.js
@@ -0,0 +1,102 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { enableSpatialNavigation, findSpatialNeighbor } from './spatial-navigation.js';
+
+const rect = (left, top, width = 100, height = 80) => ({
+  left, top, right: left + width, bottom: top + height,
+});
+
+test('multi-column grid follows rows and columns without horizontal wrapping', () => {
+  const cards = [rect(0, 0), rect(120, 0), rect(0, 100), rect(120, 100)];
+  assert.equal(findSpatialNeighbor(cards, 0, 'ArrowRight'), 1);
+  assert.equal(findSpatialNeighbor(cards, 1, 'ArrowLeft'), 0);
+  assert.equal(findSpatialNeighbor(cards, 0, 'ArrowDown'), 2);
+  assert.equal(findSpatialNeighbor(cards, 3, 'ArrowUp'), 1);
+  assert.equal(findSpatialNeighbor(cards, 1, 'ArrowRight'), -1);
+  assert.equal(findSpatialNeighbor(cards, 2, 'ArrowLeft'), -1);
+  assert.equal(findSpatialNeighbor(cards, 3, 'ArrowDown'), -1);
+});
+
+test('single-column layout uses up/down, and single-row layout uses left/right', () => {
+  const column = [rect(0, 0), rect(0, 100), rect(0, 200)];
+  assert.equal(findSpatialNeighbor(column, 1, 'ArrowDown'), 2);
+  assert.equal(findSpatialNeighbor(column, 1, 'ArrowUp'), 0);
+  assert.equal(findSpatialNeighbor(column, 1, 'ArrowRight'), -1);
+  const row = [rect(0, 0), rect(120, 0), rect(240, 0)];
+  assert.equal(findSpatialNeighbor(row, 1, 'ArrowRight'), 2);
+  assert.equal(findSpatialNeighbor(row, 1, 'ArrowDown'), -1);
+});
+
+test('physical direction works with RTL and CSS ordering independent of DOM order', () => {
+  const cards = [rect(240, 0), rect(0, 0), rect(120, 0)];
+  assert.equal(findSpatialNeighbor(cards, 0, 'ArrowLeft'), 2);
+  assert.equal(findSpatialNeighbor(cards, 1, 'ArrowRight'), 2);
+});
+
+test('unequal card heights favor the same column and incomplete rows remain reachable', () => {
+  const cards = [rect(0, 0, 100, 140), rect(120, 0), rect(0, 160), rect(120, 100)];
+  assert.equal(findSpatialNeighbor(cards, 0, 'ArrowDown'), 2);
+  const incomplete = [rect(0, 0), rect(120, 0), rect(0, 100)];
+  assert.equal(findSpatialNeighbor(incomplete, 1, 'ArrowDown'), 2);
+  assert.equal(findSpatialNeighbor(incomplete, 2, 'ArrowUp'), 0);
+});
+
+test('empty grids, missing current cards and unsupported keys have no target', () => {
+  assert.equal(findSpatialNeighbor([], 0, 'ArrowRight'), -1);
+  assert.equal(findSpatialNeighbor([rect(0, 0)], -1, 'ArrowRight'), -1);
+  assert.equal(findSpatialNeighbor([rect(0, 0)], 0, 'Tab'), -1);
+});
+
+test('keyboard handler remeasures layouts, skips hidden cards, and preserves native keys', () => {
+  let handler;
+  let focused = -1;
+  let positions = [rect(0, 0), rect(120, 0), rect(240, 0)];
+  const grid = {
+    addEventListener: (name, callback) => { assert.equal(name, 'keydown'); handler = callback; },
+    querySelectorAll: () => cards,
+  };
+  const links = positions.map((_, index) => ({
+    tabIndex: 0,
+    visible: true,
+    closest: (selector) => selector === 'a[href]' ? links[index]
+      : selector === '.card' ? cards[index]
+        : selector === '[data-spatial-navigation]' ? grid : null,
+    getClientRects() { return this.visible ? [positions[index]] : []; },
+    focus: () => { focused = index; },
+  }));
+  const cards = positions.map((_, index) => ({
+    querySelector: () => links[index],
+    getBoundingClientRect: () => positions[index],
+  }));
+  const previousStyle = globalThis.getComputedStyle;
+  globalThis.getComputedStyle = () => ({ visibility: 'visible' });
+  try {
+    enableSpatialNavigation(grid);
+    const press = (key, overrides = {}) => {
+      let prevented = false;
+      handler({ key, target: links[0], preventDefault: () => { prevented = true; }, ...overrides });
+      return prevented;
+    };
+    assert.equal(press('ArrowRight'), true);
+    assert.equal(focused, 1);
+    positions = [rect(0, 0), rect(0, 100), rect(0, 200)];
+    focused = -1;
+    assert.equal(press('ArrowRight'), true);
+    assert.equal(focused, -1);
+    assert.equal(press('ArrowDown'), true);
+    assert.equal(focused, 1);
+    links[1].visible = false;
+    press('ArrowDown');
+    assert.equal(focused, 2);
+    focused = -1;
+    for (const key of ['Tab', 'Enter', ' ', 'Home']) assert.equal(press(key), false);
+    for (const modifier of ['altKey', 'ctrlKey', 'metaKey', 'shiftKey', 'defaultPrevented']) {
+      assert.equal(press('ArrowDown', { [modifier]: true }), false);
+    }
+    assert.equal(press('ArrowDown', { target: { closest: () => null } }), false);
+    assert.equal(focused, -1);
+  } finally {
+    if (previousStyle === undefined) delete globalThis.getComputedStyle;
+    else globalThis.getComputedStyle = previousStyle;
+  }
+});
