+  building: '<path d="M4 21V3h16v18M9 21v-5h6v5M8 7h1m6 0h1M8 11h1m6 0h1"/>',
+  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
+  check: '<path d="m5 12 4 4L19 6"/>',
+  x: '<path d="m6 6 12 12M6 18 18 6"/>',
+};
+function icon(name) { return `<svg viewBox="0 0 24 24" aria-hidden="true">${paths[name] || paths.lock}</svg>`; }
+function hydrateIcons(root = document) { root.querySelectorAll('[data-icon]').forEach(el => { el.innerHTML = icon(el.dataset.icon); }); }
+hydrateIcons();
+const $ = id => document.getElementById(id);
+const STORAGE = 'daily-grind.encrypted-notes.v1';
+let recipients = [], notes = [], database, hideTimers = new Map();
+const escapeHTML = text => String(text).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
+let toastTimer;
+function toast(message) { $('toast').textContent = message; $('toast').classList.add('visible'); clearTimeout(toastTimer); toastTimer = setTimeout(() => $('toast').classList.remove('visible'), 3500); }
+function openDatabase() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-local-vault', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('recipients', { keyPath: 'id' });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Please close other Daily Grind tabs and try again.'));
+  });
+}
+function keyStore(operation, value) {
+  return new Promise((resolve, reject) => {
+    const tx = database.transaction('recipients', operation === 'getAll' ? 'readonly' : 'readwrite');
+    const request = tx.objectStore('recipients')[operation](...(value ? [value] : []));
+    tx.oncomplete = () => resolve(request.result);
+    tx.onerror = () => reject(tx.error);
+    tx.onabort = () => reject(tx.error);
+  });
+}
+function readNotes() {
+  const stored = localStorage.getItem(STORAGE);
+  const parsed = stored === null ? [] : JSON.parse(stored);
+  if (!Array.isArray(parsed)) throw new Error('Saved note data could not be read.');
+  return parsed;
+}
+function persist(next) { localStorage.setItem(STORAGE, JSON.stringify(next)); notes = next; renderNotes(); }
+function renderNotes() {
+  for (const timer of hideTimers.values()) clearTimeout(timer);
+  hideTimers.clear();
+  $('notes-count').textContent = notes.length;
+  $('saved-notes').innerHTML = notes.length ? notes.map(note => {
+    const date = new Date(note.created);
+    const label = Number.isNaN(date.getTime()) ? 'Saved note' : date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
+    return `<article class="note-card" data-id="${escapeHTML(note.id)}"><div class="note-top"><div class="note-location">${icon(note.location === 'Office' ? 'building' : 'home')}${escapeHTML(note.location)}${note.example ? '<span class="example-tag">Example</span>' : ''}</div><span class="encrypted-tag">${icon('lock')} Encrypted</span></div><div class="sealed-preview">${icon('lock')}<span class="dots" aria-label="Encrypted note, content hidden">••••••••••••••••••</span></div><div class="note-meta">${icon('shield-check')} ${escapeHTML(modeLabels[note.mode] || 'Unknown mode')}<span>·</span>AES-256-GCM<span>·</span>${label}</div><div class="note-actions"><button type="button" class="reveal-button" data-action="reveal">${icon('eye')} Reveal note</button><div class="action-group"><button type="button" class="icon-button" data-action="export" aria-label="Export encrypted ${escapeHTML(note.location)} note" title="Export encrypted note">${icon('download')}</button><button type="button" class="icon-button" data-action="delete" aria-label="Delete ${escapeHTML(note.location)} note" title="Delete note">${icon('trash')}</button></div></div></article>`;
+  }).join('') : `<div class="empty-state"><span>${icon('file-pen')}</span>A fresh start for your next delivery.<br>Your encrypted notes will appear here.</div>`;
+}
+function hideNote(card) {
+  const content = card.querySelector('.revealed-text');
+  if (!content) return;
+  content.className = 'sealed-preview';
+  content.innerHTML = `${icon('lock')}<span class="dots" aria-label="Encrypted note, content hidden">••••••••••••••••••</span>`;
+  const button = card.querySelector('[data-action="reveal"]');
+  button.innerHTML = `${icon('eye')} Reveal note`;
+  button.dataset.revealed = '';
+  clearTimeout(hideTimers.get(card.dataset.id));
