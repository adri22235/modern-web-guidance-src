new file mode 100644
index 0000000..2a2d87b
--- /dev/null
+++ b/src/app.js
@@ -0,0 +1,163 @@
+import { sealNote, openNote, suiteNames } from './crypto.js';
+import { openDatabase, listNotes, getRecipient, saveNote, deleteNote } from './storage.js';
+
+const form = document.querySelector('#note-form');
+const note = document.querySelector('#delivery-note');
+const controls = document.querySelector('#note-controls');
+const submit = document.querySelector('#save-note');
+const status = document.querySelector('#note-status');
+const list = document.querySelector('#saved-notes');
+const counter = document.querySelector('#character-count');
+const count = document.querySelector('#saved-count');
+let busy = false;
+const hiddenTimers = new Map();
+function announce(message, error = false) {
+  status.textContent = message;
+  status.classList.toggle('error', error);
+}
+function hideRevealed() {
+  for (const hide of hiddenTimers.values()) hide();
+}
+document.addEventListener('visibilitychange', () => { if (document.hidden) hideRevealed(); });
+window.addEventListener('pagehide', hideRevealed);
+note.addEventListener('input', () => {
+  note.setCustomValidity('');
+  note.removeAttribute('aria-invalid');
+  counter.textContent = `${note.value.length} / 1,000`;
+});
+
+document.querySelectorAll('input[name="protection"]').forEach((radio) => {
+  radio.addEventListener('change', () => {
+    document.querySelector('#protection-description').textContent = {
+      hybrid: 'Combines classical and post-quantum protection. Recommended for sensitive notes.',
+      quantum: 'Uses ML-KEM-768 post-quantum key encapsulation.',
+      classical: 'Uses classical key agreement. This option does not provide post-quantum protection.',
+    }[radio.value];
+  });
+});
+
+async function renderNotes() {
+  hideRevealed();
+  const notes = (await listNotes()).sort((a, b) => b.header.created.localeCompare(a.header.created));
+  list.replaceChildren();
+  count.textContent = String(notes.length);
+  document.querySelector('#empty-notes').hidden = notes.length > 0;
+  for (const envelope of notes) {
+    const item = document.createElement('article');
+    item.className = 'saved-note';
+    const metadata = document.createElement('div');
+    const title = document.createElement('h4');
+    title.textContent = 'Encrypted delivery note';
+    const detail = document.createElement('p');
+    detail.className = 'note-meta';
+    detail.textContent = `${new Date(envelope.header.created).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })} · ${suiteNames[envelope.header.suite] || 'Unknown protection'}`;
+    metadata.append(title, detail);
+    const plaintext = document.createElement('p');
+    plaintext.className = 'revealed-note';
+    plaintext.hidden = true;
+    const actions = document.createElement('div');
+    actions.className = 'note-actions';
+    const reveal = document.createElement('button');
+    reveal.type = 'button';
+    reveal.className = 'text-button';
+    reveal.textContent = 'Reveal note';
+    reveal.setAttribute('aria-expanded', 'false');
+    plaintext.id = `plaintext-${envelope.header.id}`;
+    reveal.setAttribute('aria-controls', plaintext.id);
+    let timer;
+    function hide() {
+      clearTimeout(timer);
+      plaintext.textContent = '';
+      plaintext.hidden = true;
+      reveal.textContent = 'Reveal note';
+      reveal.setAttribute('aria-expanded', 'false');
+      hiddenTimers.delete(envelope.header.id);
+    }
+    reveal.addEventListener('click', async () => {
+      if (!plaintext.hidden) { hide(); return; }
+      reveal.disabled = true;
+      try {
+        const recipient = await getRecipient(envelope.header.recipient);
+        if (!recipient) throw new Error('Missing key');
+        const text = await openNote(envelope, recipient);
+        if (document.hidden || !item.isConnected) return;
+        plaintext.textContent = text;
+        plaintext.hidden = false;
+        reveal.textContent = 'Hide note';
+        reveal.setAttribute('aria-expanded', 'true');
+        hiddenTimers.set(envelope.header.id, hide);
+        timer = setTimeout(hide, 30000);
+        announce('Note authenticated and revealed. It will hide automatically in 30 seconds.');
+      } catch {
+        announce('This note could not be authenticated or its key is unavailable. No text was revealed.', true);
+      } finally { reveal.disabled = false; }
+    });
+    const remove = document.createElement('button');
+    remove.type = 'button';
+    remove.className = 'text-button delete-button';
+    remove.textContent = 'Delete';
+    remove.addEventListener('click', async () => {
+      remove.disabled = true;
+      try {
+        await deleteNote(envelope.header.id);
+        hide();
+        await renderNotes();
+        announce('Note and its recipient key deleted from this device.');
+        note.focus();
+      } catch { announce('The note could not be deleted. Please try again.', true); }
+      finally { remove.disabled = false; }
+    });
+    actions.append(reveal, remove);
+    item.append(metadata, actions, plaintext);
+    list.append(item);
+  }
+}
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (busy) return;
+  if (!note.value.trim()) {
+    note.setCustomValidity('Please enter your delivery instructions.');
+    note.setAttribute('aria-invalid', 'true');
+    note.reportValidity();
+    note.focus();
+    return;
+  }
+  busy = true;
+  controls.disabled = true;
+  submit.textContent = 'Encrypting…';
+  announce('Encrypting your note on this device…');
+  let persisted = false;
+  try {
+    const protection = form.querySelector('input[name="protection"]:checked').value;
+    const sealed = await sealNote(note.value, protection);
+    await saveNote(sealed);
+    persisted = true;
+    note.value = '';
+    counter.textContent = '0 / 1,000';
+    await renderNotes();
+    announce('Your note is encrypted and saved on this device. It has not been sent to a driver.');
+  } catch {
+    announce(persisted
+      ? 'Your encrypted note was saved, but the list could not refresh. Reload to view it.'
+      : 'Your note could not be saved. Check browser storage permissions and try again. Your text is still here.', true);
+  } finally {
+    busy = false;
+    controls.disabled = false;
+    submit.textContent = 'Encrypt & save note';
+  }
+});
+
+async function initialize() {
+  try {
+    if (!globalThis.isSecureContext || !crypto?.subtle) throw new Error('Secure context required');
+    await openDatabase();
+    await renderNotes();
+    controls.disabled = false;
+    document.querySelector('#secure-label').textContent = 'Browser encryption ready';
+    announce('Ready when you are. Your note stays on this device.');
+  } catch {
+    document.querySelector('#secure-label').textContent = 'Encryption unavailable';
+    announce('Encrypted notes need HTTPS (or localhost) and browser storage access. Please enable both and reload.', true);
+  }
+}
+initialize();
