+<script>
+    (() => {
+      const grid = document.querySelector('#favorites-grid');
+      const restore = document.querySelector('#restore-drinks');
+      const status = document.querySelector('#favorites-status');
+      const empty = document.querySelector('#empty-favorites');
+      const originalDrinks = Array.from(grid.children);
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function transition(scope, update) {
+        // Never promote a component update to a document-wide transition.
+        if (typeof scope.startViewTransition !== 'function' || reducedMotion.matches) {
+          update();
+          return;
+        }
+        const animation = scope.startViewTransition(update);
+        // A rapid second action can skip the previous animation; its update still runs.
+        animation.ready.catch(() => {});
+      }
+
+      function syncControls() {
+        const drinks = Array.from(grid.children);
+        drinks.forEach((drink, index) => {
+          drink.querySelector('[data-action="earlier"]').disabled = index === 0;
+          drink.querySelector('[data-action="later"]').disabled = index === drinks.length - 1;
+        });
+        empty.hidden = drinks.length !== 0;
+        restore.disabled = drinks.length === originalDrinks.length &&
+          drinks.every((drink, index) => drink === originalDrinks[index]);
+      }
+
+      function moveDrink(drink, reference) {
+        // moveBefore preserves focus and any running animation inside the card.
+        if (typeof grid.moveBefore === 'function') {
+          grid.moveBefore(drink, reference);
+        } else {
+          const focused = document.activeElement;
+          grid.insertBefore(drink, reference);
+          if (drink.contains(focused)) focused.focus({ preventScroll: true });
+        }
+      }
+
+      grid.addEventListener('click', (event) => {
+        const button = event.target.closest('button[data-action]');
+        if (!button || button.disabled) return;
+        const drink = button.closest('.drink-wrapper');
+        const name = drink.querySelector('h3').textContent;
+        const action = button.dataset.action;
+
+        if (action === 'customize') {
+          const scope = drink.querySelector('.drink-content');
+          transition(scope, () => {
+            const options = drink.querySelector('.customization');
+            options.hidden = !options.hidden;
+            button.setAttribute('aria-expanded', String(!options.hidden));
+            button.firstChild.textContent = options.hidden ? 'Customize ' : 'Done ';
+            button.querySelector('span').textContent = options.hidden ? '＋' : '✓';
+          });
+          return;
+        }
+
+        transition(grid, () => {
+          if (!grid.contains(drink)) return;
+          if (action === 'remove') {
+            const hadFocus = drink.contains(document.activeElement);
+            const neighbor = drink.nextElementSibling || drink.previousElementSibling;
+            drink.remove();
+            syncControls();
+            if (hadFocus) {
+              (neighbor?.querySelector('[data-action="remove"]') || restore).focus({ preventScroll: true });
+            }
+            status.textContent = `${name} removed. ${grid.children.length} drinks remaining. Restore drinks to bring it back.`;
+          } else {
+            const neighbor = action === 'earlier' ? drink.previousElementSibling : drink.nextElementSibling;
+            if (!neighbor) return;
+            moveDrink(drink, action === 'earlier' ? neighbor : neighbor.nextElementSibling);
+            syncControls();
+            // A boundary button becomes disabled after moving; keep focus in the same card.
+            if (button.disabled) {
+              const otherAction = action === 'earlier' ? 'later' : 'earlier';
+              drink.querySelector(`[data-action="${otherAction}"]`).focus({ preventScroll: true });
+            }
+            status.textContent = `${name} moved to position ${Array.from(grid.children).indexOf(drink) + 1} of ${grid.children.length}.`;
+          }
+        });
+      });
+
+      grid.addEventListener('change', (event) => {
+        if (!event.target.matches('.customization select, .customization input')) return;
+        const drink = event.target.closest('.drink-wrapper');
+        transition(drink.querySelector('.drink-content'), () => {
+          const size = drink.querySelector('[name="size"]').value;
+          const milk = drink.querySelector('[name="milk"]').value;
+          const shot = drink.querySelector('[name="shot"]').checked;
+          const summary = `${size} · ${milk}${shot ? ' · Extra shot' : ''}`;
+          drink.querySelector('.drink-summary').textContent = summary;
+          status.textContent = `${drink.querySelector('h3').textContent}: ${summary}.`;
+        });
+      });
+
+      restore.addEventListener('click', () => {
+        transition(grid, () => {
+          originalDrinks.forEach((drink) => {
+            if (drink.parentElement === grid) moveDrink(drink, null);
+            else grid.append(drink);
+          });
+          syncControls();
+          // Restore becomes disabled, so provide a useful focus destination.
+          originalDrinks[0].querySelector('[data-action="customize"]').focus({ preventScroll: true });
+          status.textContent = 'All three drinks restored to their original order. Your customizations are kept.';
+        });
+      });
+
+      syncControls();
+    })();
+  </script>
 </body>
 
