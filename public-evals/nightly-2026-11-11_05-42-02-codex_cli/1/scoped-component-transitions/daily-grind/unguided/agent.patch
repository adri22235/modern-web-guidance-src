+<script>
+    (() => {
+      const section = document.querySelector('.seasonal');
+      const grid = section.querySelector('.seasonal-grid');
+      const restore = section.querySelector('#restore-drinks');
+      const status = section.querySelector('[role="status"]');
+      const empty = section.querySelector('.empty-message');
+      const originals = [...grid.querySelectorAll('.drink-card')];
+      const removed = new Set();
+      const animations = new WeakMap();
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const cards = () => [...grid.querySelectorAll('.drink-card')].filter(card => !card.hasAttribute('data-exiting'));
+      const name = card => card.querySelector('h3').textContent;
+      const layout = card => ({ x: card.offsetLeft, y: card.offsetTop, width: card.offsetWidth, height: card.offsetHeight });
+
+      function syncControls() {
+        const current = cards();
+        current.forEach((card, index) => {
+          card.querySelector('[data-action="earlier"]').disabled = index === 0;
+          card.querySelector('[data-action="later"]').disabled = index === current.length - 1;
+        });
+        restore.hidden = removed.size === 0;
+        empty.hidden = current.length > 0;
+      }
+
+      // FLIP only the cards whose layout changed. Existing animations on other
+      // cards keep running; no document snapshot or global interaction lock.
+      function transition(change) {
+        const before = new Map(cards().map(card => [card, {
+          layout: layout(card), visual: card.getBoundingClientRect()
+        }]));
+        change();
+        syncControls();
+        const gridRect = grid.getBoundingClientRect();
+        cards().forEach(card => {
+          const old = before.get(card);
+          const next = layout(card);
+          if (old && Object.keys(next).every(key => next[key] === old.layout[key])) return;
+          animations.get(card)?.cancel();
+          if (reduceMotion.matches || !card.animate) return;
+          const from = old ? {
+            transform: `translate(${old.visual.left - gridRect.left - next.x}px, ${old.visual.top - gridRect.top - next.y}px) scale(${old.visual.width / next.width}, ${old.visual.height / next.height})`,
+            opacity: 1
+          } : { transform: 'translateY(16px) scale(.97)', opacity: 0 };
+          const animation = card.animate([from, { transform: 'none', opacity: 1 }], {
+            duration: 340, easing: 'cubic-bezier(.22, 1, .36, 1)'
+          });
+          animations.set(card, animation);
+          animation.finished.then(() => {
+            if (animations.get(card) === animation) animations.delete(card);
+          }).catch(() => {});
+        });
+      }
+
+      grid.addEventListener('click', event => {
+        const button = event.target.closest('button');
+        const card = button?.closest('.drink-card');
+        if (!card || card.hasAttribute('data-exiting')) return;
+        if (button.classList.contains('customize-toggle')) {
+          const expanded = button.getAttribute('aria-expanded') === 'true';
+          transition(() => {
+            button.setAttribute('aria-expanded', String(!expanded));
+            button.querySelector('span').textContent = expanded ? '+' : '−';
+            card.querySelector('.customizations').hidden = expanded;
+          });
+          return;
+        }
+        const action = button.dataset.action;
+        if (!action) return;
+        const current = cards();
+        const index = current.indexOf(card);
+        if (action === 'earlier' && index > 0) {
+          transition(() => grid.insertBefore(card, current[index - 1]));
+        } else if (action === 'later' && index < current.length - 1) {
+          transition(() => grid.insertBefore(current[index + 1], card));
+        } else if (action === 'remove') {
+          const rect = card.getBoundingClientRect();
+          const gridRect = grid.getBoundingClientRect();
+          animations.get(card)?.cancel();
+          transition(() => {
+            // Keep the outgoing card inside this component, outside grid flow.
+            card.setAttribute('data-exiting', '');
+            card.inert = true;
+            Object.assign(card.style, {
+              position: 'absolute', left: `${rect.left - gridRect.left}px`,
+              top: `${rect.top - gridRect.top}px`, width: `${rect.width}px`,
+              height: `${rect.height}px`, pointerEvents: 'none'
+            });
+            removed.add(card);
+          });
+          (current[index + 1] || current[index - 1])?.querySelector('.customize-toggle').focus({ preventScroll: true });
+          if (cards().length === 0) restore.focus({ preventScroll: true });
+          const finish = () => { card.remove(); card.removeAttribute('style'); card.removeAttribute('data-exiting'); card.inert = false; };
+          if (reduceMotion.matches || !card.animate) finish();
+          else card.animate([
+            { opacity: 1, transform: 'scale(1)' },
+            { opacity: 0, transform: 'translateY(12px) scale(.94)' }
+          ], { duration: 220, easing: 'ease-out' }).finished.then(finish).catch(finish);
+          status.textContent = `${name(card)} removed. You can restore removed drinks.`;
+          return;
+        } else return;
+        // Moving to an endpoint can disable the pressed arrow; keep focus nearby.
+        if (button.disabled) card.querySelector(`[data-action="${action === 'earlier' ? 'later' : 'earlier'}"]`).focus({ preventScroll: true });
+        status.textContent = `${name(card)} moved to position ${cards().indexOf(card) + 1} of ${cards().length}.`;
+      });
+
+      grid.addEventListener('change', event => {
+        const card = event.target.closest('.drink-card');
+        if (card) status.textContent = `${name(card)} customization updated.`;
+      });
+
+      restore.addEventListener('click', () => {
+        // An exit can still be running. Restore fresh copies so its completion
+        // cannot remove a card that the visitor has just restored.
+        let first;
+        transition(() => {
+          originals.forEach((card, index) => {
+            if (!removed.has(card)) return;
+            card.remove();
+            const copy = card.cloneNode(true);
+            copy.removeAttribute('style');
+            copy.removeAttribute('data-exiting');
+            copy.inert = false;
+            grid.insertBefore(copy, empty);
+            originals[index] = copy;
+            first ||= copy;
+          });
+          removed.clear();
+        });
+        first?.querySelector('.customize-toggle').focus({ preventScroll: true });
+        status.textContent = 'Removed drinks restored to your lineup.';
+      });
+      syncControls();
+    })();
+  </script>
