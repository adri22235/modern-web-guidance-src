+    const page = favoritesPage(location.href);
+    const additionalFavorites = [
+      [
+        ['Pumpkin Spice Latte', 'Espresso with warming pumpkin spices and steamed milk.'],
+        ['Cinnamon Cappuccino', 'Rich espresso topped with cinnamon-dusted milk foam.'],
+        ['Maple Cold Brew', 'Slow-steeped cold brew with a touch of maple sweetness.']
