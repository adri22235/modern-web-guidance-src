+      ]
+    ];
+
+    if (page > 1) {
+      document.querySelectorAll('#seasonal-favorites .card').forEach((card, index) => {
+        const [name, description] = additionalFavorites[page - 2][index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').href = '/menu/seasonal';
+      });
+    }
+
+    document.getElementById('page-number').textContent = `Page ${page} of 3`;
+    for (const [id, destination, disabled] of [
+      ['previous', Math.max(1, page - 1), page === 1],
+      ['next', Math.min(3, page + 1), page === 3]
+    ]) {
+      const link = document.getElementById(id);
+      link.href = `?page=${destination}`;
+      if (disabled) {
+        link.setAttribute('aria-disabled', 'true');
+        link.removeAttribute('rel');
+        link.tabIndex = -1;
+        link.addEventListener('click', (event) => event.preventDefault());
+      }
+    }
