+  <script>
+    // Keep both document snapshots moving in the same direction, including history navigation.
+    function favoritesPage(url) {
+      const page = Number(new URL(url).searchParams.get('page'));
+      return Number.isInteger(page) && page >= 1 && page <= 3 ? page : 1;
+    }
+
+    function setNavigationDirection(transition, from, to) {
+      if (!transition?.types || !from || !to) return;
+      const difference = favoritesPage(to) - favoritesPage(from);
+      if (difference) transition.types.add(difference > 0 ? 'next' : 'previous');
+    }
+
+    window.addEventListener('pageswap', (event) => {
+      setNavigationDirection(event.viewTransition, location.href, event.activation?.entry.url);
+    });
+
+    window.addEventListener('pagereveal', (event) => {
+      setNavigationDirection(event.viewTransition, window.navigation?.activation?.from?.url, location.href);
+    });
+  </script>
