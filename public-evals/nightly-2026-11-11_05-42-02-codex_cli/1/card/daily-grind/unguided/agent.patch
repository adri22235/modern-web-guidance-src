+  <script>
+    const orderKey = 'daily-grind-order';
+    const drinkNames = Object.fromEntries(
+      Array.from(document.querySelectorAll('.drink-form'), form => [
+        form.dataset.drink, form.closest('.card').querySelector('h3').textContent
+      ])
+    );
+    const sizes = ['small', 'medium', 'large'];
+    let order = [];
+    try {
+      const saved = JSON.parse(localStorage.getItem(orderKey) || '[]');
+      if (Array.isArray(saved)) {
+        order = saved.filter(item => item && Object.hasOwn(drinkNames, item.drink) &&
+          sizes.includes(item.size) && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+      }
+    } catch { /* Ordering remains available when storage is unavailable. */ }
+
+    const summary = document.querySelector('.order-summary');
+    const status = document.querySelector('.order-status');
+
+    function renderOrder() {
+      const items = document.querySelector('#order-items');
+      items.replaceChildren();
+      let count = 0;
+      for (const item of order) {
+        const row = document.createElement('li');
+        row.textContent = `${item.quantity} × ${drinkNames[item.drink]} — ${item.size}`;
+        items.append(row);
+        count += item.quantity;
+      }
+      document.querySelector('#order-count').textContent = count;
+      summary.hidden = order.length === 0;
+      try { localStorage.setItem(orderKey, JSON.stringify(order)); } catch { /* Keep the in-memory order. */ }
+      return count;
+    }
+
+    document.querySelectorAll('.drink-form').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        if (!sizes.includes(size)) return;
+        const existing = order.find(item => item.drink === drink && item.size === size);
+        if (existing) existing.quantity += 1;
+        else order.push({ drink, size, quantity: 1 });
+        const count = renderOrder();
+        form.closest('.card').querySelector('.card-feedback').textContent =
+          `Added to your order · ${size}`;
+        status.textContent = `${drinkNames[drink]} (${size}) added. ${count} ${count === 1 ? 'drink' : 'drinks'} in your order.`;
+      });
+      form.addEventListener('change', () => {
+        form.closest('.card').querySelector('.card-feedback').textContent = '';
+      });
+    });
+
+    document.querySelector('#clear-order').addEventListener('click', () => {
+      order = [];
+      renderOrder();
+      document.querySelectorAll('.card-feedback').forEach(note => { note.textContent = ''; });
+      document.querySelector('.drink-form button').focus();
+      status.textContent = 'Your order has been cleared.';
+    });
+    renderOrder();
+  </script>
