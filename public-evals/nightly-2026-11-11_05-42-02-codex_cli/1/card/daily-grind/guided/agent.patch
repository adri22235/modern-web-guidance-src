+  <script>
+    (() => {
+      const storageKey = 'daily-grind-seasonal-order';
+      const forms = [...document.querySelectorAll('.drink-form')];
+      const drinks = new Map(forms.map(form => [
+        form.dataset.drink,
+        document.getElementById(form.getAttribute('aria-labelledby')).textContent
+      ]));
+      const sizes = ['small', 'medium', 'large'];
+      let order = [];
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
+        if (Array.isArray(saved)) {
+          order = saved.filter(item => item && drinks.has(item.drink) &&
+            sizes.includes(item.size) && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+        }
+      } catch {
+        // Ordering still works when browser storage is unavailable.
+      }
+
+      function renderOrder() {
+        const list = document.getElementById('order-items');
+        const count = order.reduce((total, item) => total + item.quantity, 0);
+        document.getElementById('order-count').textContent = `(${count} ${count === 1 ? 'drink' : 'drinks'})`;
+        document.getElementById('empty-order').hidden = count > 0;
+        list.hidden = count === 0;
+        list.replaceChildren(...order.map(item => {
+          const line = document.createElement('li');
+          line.textContent = `${item.quantity} × ${drinks.get(item.drink)} — ${item.size}`;
+          return line;
+        }));
+      }
+
+      forms.forEach(form => {
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          const drink = form.dataset.drink;
+          const size = new FormData(form).get('size');
+          if (!sizes.includes(size)) return;
+          const existing = order.find(item => item.drink === drink && item.size === size);
+          if (existing) existing.quantity += 1;
+          else order.push({ drink, size, quantity: 1 });
+          let stored = true;
+          try {
+            localStorage.setItem(storageKey, JSON.stringify(order));
+          } catch {
+            stored = false;
+          }
+          renderOrder();
+          const quantity = order.find(item => item.drink === drink && item.size === size).quantity;
+          document.getElementById('order-status').textContent =
+            `Added ${size} ${drinks.get(drink)}. ${quantity} of this selection in your order.` +
+            (stored ? '' : ' Your order is available for this visit; browser storage is unavailable.');
+        });
+      });
+
+      renderOrder();
+    })();
+  </script>
