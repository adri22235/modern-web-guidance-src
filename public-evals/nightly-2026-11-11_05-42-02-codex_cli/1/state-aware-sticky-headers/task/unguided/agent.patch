+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = document.querySelectorAll('.sticky-container');
+    const needsStickyFallback = !CSS.supports('container-type', 'scroll-state');
+    let navigationHeight = 0;
+    let framePending = false;
+
+    function updateStickyState() {
+      framePending = false;
+      if (!needsStickyFallback) return;
+      stickyContainers.forEach((container) => {
+        const top = container.getBoundingClientRect().top;
+        container.classList.toggle('is-stuck', Math.abs(top - navigationHeight) < 1);
+      });
+    }
+
+    function scheduleStickyUpdate() {
+      if (framePending) return;
+      framePending = true;
+      requestAnimationFrame(updateStickyState);
+    }
+
+    // Measure wrapping navigation so section headings always sit below it.
+    new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      scheduleStickyUpdate();
+    }).observe(navigation);
+
+    if (needsStickyFallback) {
+      document.addEventListener('scroll', scheduleStickyUpdate, { passive: true });
+      window.addEventListener('resize', scheduleStickyUpdate);
+      window.addEventListener('pageshow', scheduleStickyUpdate);
+    }
+  </script>
+
