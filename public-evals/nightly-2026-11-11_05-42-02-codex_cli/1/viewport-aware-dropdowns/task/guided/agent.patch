+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativeAnchors = nativePopover && CSS.supports('anchor-name: --options-trigger') &&
+      CSS.supports('position-area: block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks: flip-block');
+    let open = false;
+
+    function positionPanel() {
+      const rect = trigger.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = viewport ? viewport.offsetLeft : 0;
+      const topEdge = viewport ? viewport.offsetTop : 0;
+      const width = viewport ? viewport.width : document.documentElement.clientWidth;
+      const height = viewport ? viewport.height : document.documentElement.clientHeight;
+      const rightEdge = leftEdge + width;
+      const bottomEdge = topEdge + height;
+      const below = Math.max(0, bottomEdge - 8 - rect.bottom);
+      const above = Math.max(0, rect.top - topEdge - 8);
+      panel.style.maxWidth = `${Math.max(0, width - 16)}px`;
+      panel.style.maxHeight = `${Math.min(Math.max(below, above), Math.max(0, height - 16))}px`;
+
+      if (!nativeAnchors) {
+        const size = panel.getBoundingClientRect();
+        const left = rect.left + size.width <= rightEdge - 8 ? rect.left : rect.right - size.width;
+        const top = size.height <= below ? rect.bottom : rect.top - size.height;
+        panel.style.left = `${Math.max(leftEdge + 8, Math.min(left, rightEdge - size.width - 8))}px`;
+        panel.style.top = `${Math.max(topEdge + 8, Math.min(top, bottomEdge - size.height - 8))}px`;
+      }
+    }
+
+    function syncOpen(isOpen) {
+      open = isOpen;
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) positionPanel();
+    }
+
+    function closePanel() {
+      if (nativePopover) panel.hidePopover();
+      else panel.hidden = true;
+      syncOpen(false);
+    }
+
+    if (nativePopover) {
+      panel.hidden = false;
+      panel.addEventListener('beforetoggle', (event) => {
+        // Size before placement so native flip tactics can fit either side.
+        if (event.newState === 'open') positionPanel();
+      });
+      panel.addEventListener('toggle', (event) => syncOpen(event.newState === 'open'));
+    } else {
+      // A body-level fixed overlay also avoids navigation overflow in older browsers.
+      trigger.addEventListener('click', () => {
+        panel.hidden = open;
+        syncOpen(!open);
+      });
+      document.addEventListener('click', (event) => {
+        if (open && !panel.contains(event.target) && !trigger.contains(event.target)) closePanel();
+      });
+      document.addEventListener('keydown', (event) => {
+        if (open && event.key === 'Escape') {
+          closePanel();
+          trigger.focus();
+        }
+      });
+    }
+
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key !== 'ArrowDown') return;
+      event.preventDefault();
+      if (!open) {
+        if (nativePopover) panel.showPopover();
+        else panel.hidden = false;
+        syncOpen(true);
+      }
+      panel.querySelector('button').focus();
+    });
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      closePanel();
+      window.location.assign(action.dataset.href);
+    });
+
+    const reposition = () => { if (open) positionPanel(); };
+    window.addEventListener('resize', reposition);
+    window.addEventListener('scroll', reposition, true);
+    window.visualViewport?.addEventListener('resize', reposition);
+    window.visualViewport?.addEventListener('scroll', reposition);
+  </script>
