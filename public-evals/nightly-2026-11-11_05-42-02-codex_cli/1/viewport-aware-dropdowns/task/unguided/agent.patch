+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const actions = [...panel.querySelectorAll('[role="menuitem"]')];
+    const isOpen = () => panel.matches(':popover-open');
+
+    function positionPanel() {
+      if (!isOpen()) return;
+
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const width = viewport?.width ?? document.documentElement.clientWidth;
+      const height = viewport?.height ?? document.documentElement.clientHeight;
+      const rightEdge = leftEdge + width - 16;
+      const bottomEdge = topEdge + height - 16;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, width - 16)}px`;
+      panel.style.maxHeight = `${Math.max(0, height - 16)}px`;
+      const naturalHeight = panel.getBoundingClientRect().height;
+      const below = Math.max(0, bottomEdge - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge);
+      const flipUp = naturalHeight > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+
+      const size = panel.getBoundingClientRect();
+      // Prefer below/left alignment; flip to right alignment at the right edge.
+      let left = anchor.left;
+      if (left + size.width > rightEdge) left = anchor.right - size.width;
+      left = Math.max(leftEdge, Math.min(left, rightEdge - size.width));
+      const top = flipUp ? anchor.top - size.height : anchor.bottom;
+      panel.style.left = `${left}px`;
+      panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - size.height))}px`;
+    }
+
+    function openPanel(index = 0) {
+      panel.showPopover();
+      trigger.setAttribute('aria-expanded', 'true');
+      positionPanel();
+      actions[index].focus({ preventScroll: true });
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+      if (event.newState === 'open') {
+        queueMicrotask(() => {
+          if (!isOpen()) return;
+          positionPanel();
+          if (!panel.contains(document.activeElement)) {
+            actions[0].focus({ preventScroll: true });
+          }
+        });
+      }
+    });
+
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPanel(event.key === 'ArrowUp' ? actions.length - 1 : 0);
+      }
+    });
+
+    panel.addEventListener('toggle', () => {
+      trigger.setAttribute('aria-expanded', String(isOpen()));
+    });
+
+    panel.addEventListener('keydown', (event) => {
+      const index = actions.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowDown') next = (index + 1) % actions.length;
+      if (event.key === 'ArrowUp') next = (index - 1 + actions.length) % actions.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = actions.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        actions[next].focus();
+      }
+      if (event.key === 'Escape' || event.key === 'Tab') {
+        panel.hidePopover();
+        trigger.focus({ preventScroll: true });
+        if (event.key === 'Escape') event.preventDefault();
+      }
+    });
+
+    actions.forEach((action) => {
+      action.addEventListener('click', () => {
+        panel.hidePopover();
+        window.location.assign(action.dataset.href);
+      });
+    });
+
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    new ResizeObserver(positionPanel).observe(trigger);
+  </script>
