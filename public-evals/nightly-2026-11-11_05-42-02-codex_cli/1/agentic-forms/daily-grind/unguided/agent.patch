@@ -0,0 +1,69 @@
+(() => {
+  const coffees = [
+    { name: 'Maple Oat Latte', temperature: 'hot', flavor: 'sweet', milk: 'oat', description: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+    { name: 'Dark Roast Espresso', temperature: 'hot', flavor: 'bold', milk: 'none', description: 'Bold, smokey, and perfect for a morning boost.' },
+    { name: 'Cold Brew', temperature: 'iced', flavor: 'smooth', milk: 'none', description: 'Steeped for 18 hours for maximum smoothness.' }
+  ];
+  const choices = {
+    temperature: ['any', 'hot', 'iced'],
+    flavor: ['any', 'sweet', 'bold', 'smooth'],
+    milk: ['any', 'oat', 'none']
+  };
+  const form = document.getElementById('coffee-finder-form');
+  const results = document.getElementById('finder-results');
+
+  function findCoffee(preferences) {
+    if (Object.entries(choices).some(([key, values]) => !values.includes(preferences[key]))) {
+      return { status: 'invalid_preferences', message: 'Please choose a valid option for each preference.', matches: [] };
+    }
+    const matches = coffees.filter(coffee => Object.keys(choices).every(key =>
+      preferences[key] === 'any' || preferences[key] === coffee[key]
+    ));
+    return {
+      status: matches.length ? 'success' : 'no_matches',
+      message: matches.length
+        ? `Your coffee ${matches.length === 1 ? 'match' : 'matches'}`
+        : 'No exact match this time. Try “No preference”, “Surprise me”, or “Hot or iced” to explore more cups.',
+      preferences,
+      matches
+    };
+  }
+
+  function showResults(result) {
+    const heading = document.createElement('h3');
+    heading.textContent = result.status === 'success' ? result.message : 'Let’s find your cup';
+    results.replaceChildren(heading);
+    if (result.matches.length) {
+      const list = document.createElement('ul');
+      for (const coffee of result.matches) {
+        const item = document.createElement('li');
+        const name = document.createElement('strong');
+        name.textContent = coffee.name;
+        const description = document.createElement('p');
+        description.textContent = `${coffee.description} Served ${coffee.temperature}; ${coffee.milk === 'oat' ? 'with oat milk' : 'without milk'}.`;
+        item.append(name, description);
+        list.append(item);
+      }
+      results.append(list);
+    } else {
+      const message = document.createElement('p');
+      message.textContent = result.message;
+      results.append(message);
+    }
+    results.hidden = false;
+  }
+
+  // One submission path for people and declarative WebMCP clients.
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    const result = findCoffee(Object.fromEntries(new FormData(form)));
+    showResults(result);
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(result));
+    }
+  });
+
+  // Hide outdated recommendations whenever preferences change.
+  form.addEventListener('change', () => { results.hidden = true; });
+  form.addEventListener('reset', () => { results.hidden = true; });
+})();
