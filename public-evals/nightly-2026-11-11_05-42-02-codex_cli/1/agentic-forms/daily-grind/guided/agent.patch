@@ -0,0 +1,16 @@
+# The Daily Grind
+
+Static homepage with a client-side coffee finder. No backend or dependencies are required for the finder.
+
+## Declarative browser tool
+
+In browsers supporting declarative WebMCP, the homepage form exposes `find_coffee` through `toolname`, `tooldescription`, and `toolautosubmit`. The browser derives its schema from the named, required radio controls:
+
+- `temperature`: `any`, `hot`, or `iced`.
+- `flavor`: `any`, `sweet`, `bold`, or `smooth`.
+
+For example, an agent can supply `{"temperature":"iced","flavor":"smooth"}` to find Cold Brew. Submitting returns a structured result via `SubmitEvent.respondWith()` and renders matching coffees on the page. Results contain `status`, `message`, `matches`, and, on success, `preferences`. Each match includes its name, description, serving temperatures, flavor, and relative menu URL. No exact match returns an empty list with guidance to broaden the preferences. Invalid values return `status: "error"`.
+
+This tool only searches a local catalog; it never places orders or charges money. `toolautosubmit` lets agents fill and submit this read-only query without an additional click. Browsers without WebMCP support use the same native form and JavaScript submit handler. JavaScript is required for recommendations; the existing seasonal favorites remain available without it.
+
+Reference: [WebMCP declarative API](https://developer.chrome.com/docs/ai/webmcp/declarative-api).
diff --git a/coffee-finder.js b/coffee-finder.js
new file mode 100644
index 0000000..0668e84
--- /dev/null
+++ b/coffee-finder.js
@@ -0,0 +1,81 @@
+const coffees = [
+  {
+    name: 'Maple Oat Latte',
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    temperatures: ['hot', 'iced'],
+    flavor: 'sweet',
+    url: '/menu/seasonal',
+  },
+  {
+    name: 'Dark Roast Espresso',
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    temperatures: ['hot'],
+    flavor: 'bold',
+    url: '/menu/espresso',
+  },
+  {
+    name: 'Cold Brew',
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    temperatures: ['iced'],
+    flavor: 'smooth',
+    url: '/menu/cold-brew',
+  },
+];
+
+const form = document.getElementById('coffee-finder-form');
+const status = document.getElementById('finder-status');
+const results = document.getElementById('finder-results');
+
+function findCoffee(data) {
+  const temperature = data.get('temperature');
+  const flavor = data.get('flavor');
+  if (!['any', 'hot', 'iced'].includes(temperature) ||
+      !['any', 'sweet', 'bold', 'smooth'].includes(flavor)) {
+    return { status: 'error', message: 'Choose a temperature and flavor from the available options.', matches: [] };
+  }
+
+  const matches = coffees.filter(coffee =>
+    (temperature === 'any' || coffee.temperatures.includes(temperature)) &&
+    (flavor === 'any' || coffee.flavor === flavor)
+  );
+  return {
+    status: 'success',
+    preferences: { temperature, flavor },
+    message: matches.length
+      ? `${matches.length} ${matches.length === 1 ? 'coffee matches' : 'coffees match'} your mood.`
+      : 'No exact match today. Try “Either” temperature or “Any flavor” to explore more coffees.',
+    matches,
+  };
+}
+
+function renderResult(result) {
+  results.replaceChildren();
+  for (const coffee of result.matches) {
+    const card = document.createElement('article');
+    card.className = 'card';
+    const heading = document.createElement('h3');
+    heading.textContent = coffee.name;
+    const description = document.createElement('p');
+    description.textContent = coffee.description;
+    const temperature = document.createElement('p');
+    temperature.textContent = `Served ${coffee.temperatures.join(' or ')}.`;
+    const link = document.createElement('a');
+    link.className = 'btn';
+    link.href = coffee.url;
+    link.textContent = `Explore ${coffee.name}`;
+    card.append(heading, description, temperature, link);
+    results.append(card);
+  }
+  status.textContent = result.message;
+}
+
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  const result = findCoffee(new FormData(form));
+  // The same result is shown to the person and returned to the invoking agent.
+  // Ordinary browsers ignore WebMCP annotations and use this submit handler.
+  if (event.agentInvoked && typeof event.respondWith === 'function') {
+    event.respondWith(Promise.resolve(result));
+  }
+  renderResult(result);
+});
