diff --git a/src/utils/formTools.ts b/src/utils/formTools.ts
new file mode 100644
index 0000000..2b59364
--- /dev/null
+++ b/src/utils/formTools.ts
@@ -0,0 +1,24 @@
+import type { FormEvent } from 'react';
+
+// These experimental SubmitEvent members are absent in older DOM typings.
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<string>) => void;
+};
+
+export function submitToolForm(
+  event: FormEvent<HTMLFormElement>,
+  submit: (data: FormData) => Promise<string>,
+) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  const nativeEvent = event.nativeEvent as AgentSubmitEvent;
+  const result = form.reportValidity()
+    ? submit(new FormData(form))
+    : Promise.resolve('Validation failed. Complete all required fields with valid values.');
+
+  // respondWith must be called during dispatch, before awaiting the request.
+  if (nativeEvent.agentInvoked && nativeEvent.respondWith) {
+    nativeEvent.respondWith(result);
+  }
+}
diff --git a/tests/form-tools.test.mjs b/tests/form-tools.test.mjs
new file mode 100644
index 0000000..2f0271e
--- /dev/null
+++ b/tests/form-tools.test.mjs
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import { test, mock } from 'node:test';
+import { submitToolForm } from '../src/utils/formTools.ts';
+
+function submission({ agentInvoked = false, valid = true } = {}) {
+  const fields = new FormData();
+  fields.set('username', 'agent-filled-user');
+  fields.set('password', 'agent-filled-password');
+  const respondWith = mock.fn();
+  const event = {
+    preventDefault: mock.fn(),
+    currentTarget: { reportValidity: () => valid, fields },
+    nativeEvent: { agentInvoked, respondWith },
+  };
+  return { event, respondWith };
+}
+
+// Node has FormData but no HTMLFormElement. Model its constructor's DOM read.
+const BrowserFormData = globalThis.FormData;
+mock.method(globalThis, 'FormData', function (form) {
+  return form ? form.fields : new BrowserFormData();
+});
+
+test('agent receives the pending result synchronously and submitted control values', async () => {
+  const { event, respondWith } = submission({ agentInvoked: true });
+  let finish;
+  const request = new Promise((resolve) => { finish = resolve; });
+  submitToolForm(event, (fields) => {
+    assert.equal(fields.get('username'), 'agent-filled-user');
+    assert.equal(fields.get('password'), 'agent-filled-password');
+    return request;
+  });
+  assert.equal(event.preventDefault.mock.callCount(), 1);
+  assert.equal(respondWith.mock.callCount(), 1);
+  assert.equal(respondWith.mock.calls[0].arguments[0], request);
+  finish('Login successful!');
+  assert.equal(await respondWith.mock.calls[0].arguments[0], 'Login successful!');
+});
+
+test('invalid agent input returns a validation result without submitting', async () => {
+  const { event, respondWith } = submission({ agentInvoked: true, valid: false });
+  const submit = mock.fn();
+  submitToolForm(event, submit);
+  assert.equal(submit.mock.callCount(), 0);
+  assert.match(await respondWith.mock.calls[0].arguments[0], /Validation failed/);
+});
+
+test('human submissions work without experimental event members', () => {
+  const { event } = submission();
+  event.nativeEvent = {};
+  const submit = mock.fn(async () => 'Login successful!');
+  submitToolForm(event, submit);
+  assert.equal(submit.mock.callCount(), 1);
+});
+
+test('API failure results are returned to the agent unchanged', async () => {
+  const { event, respondWith } = submission({ agentInvoked: true });
+  submitToolForm(event, async () => 'Registration failed: APP_ERR_1001');
+  assert.equal(await respondWith.mock.calls[0].arguments[0], 'Registration failed: APP_ERR_1001');
+});
