diff --git a/src/utils/toolForms.ts b/src/utils/toolForms.ts
new file mode 100644
index 0000000..9042d94
--- /dev/null
+++ b/src/utils/toolForms.ts
@@ -0,0 +1,26 @@
+import type { FormEvent } from 'react';
+
+export interface FormResult {
+  success: boolean;
+  message: string;
+}
+
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<FormResult>) => void;
+};
+
+/** Share the same submission and result between people and WebMCP agents. */
+export function submitToolForm(
+  event: FormEvent<HTMLFormElement>,
+  submit: (values: FormData) => Promise<FormResult>,
+): void {
+  event.preventDefault();
+  const result = submit(new FormData(event.currentTarget));
+  const nativeEvent = event.nativeEvent as AgentSubmitEvent;
+
+  // respondWith must be called during the submit event, before awaiting the request.
+  if (nativeEvent.agentInvoked && typeof nativeEvent.respondWith === 'function') {
+    nativeEvent.respondWith(result);
+  }
+}
diff --git a/tests/toolForms.test.mjs b/tests/toolForms.test.mjs
new file mode 100644
index 0000000..54c3c87
--- /dev/null
+++ b/tests/toolForms.test.mjs
@@ -0,0 +1,64 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { submitToolForm } from '../src/utils/toolForms.ts';
+
+function submissionEvent(t, nativeEvent) {
+  // Model browser FormData serialization without a DOM or live credentials.
+  t.mock.method(globalThis, 'FormData', class {
+    constructor(form) {
+      return new Map(Object.entries(form.controls));
+    }
+  });
+  return {
+    currentTarget: { controls: { username: 'agent-user', password: 'example123' } },
+    nativeEvent,
+    preventDefault: t.mock.fn(),
+  };
+}
+
+test('agent submission reads controls and attaches the pending result synchronously', async (t) => {
+  let finish;
+  const result = new Promise((resolve) => { finish = resolve; });
+  const respondWith = t.mock.fn();
+  const event = submissionEvent(t, { agentInvoked: true, respondWith });
+  const submit = t.mock.fn((values) => {
+    assert.equal(event.preventDefault.mock.callCount(), 1);
+    assert.equal(values.get('username'), 'agent-user');
+    assert.equal(values.get('password'), 'example123');
+    return result;
+  });
+
+  submitToolForm(event, submit);
+
+  assert.equal(submit.mock.callCount(), 1);
+  assert.equal(respondWith.mock.callCount(), 1);
+  assert.equal(respondWith.mock.calls[0].arguments[0], result);
+  finish({ success: true, message: 'Login successful!' });
+  assert.deepEqual(await respondWith.mock.calls[0].arguments[0], {
+    success: true, message: 'Login successful!',
+  });
+});
+
+test('failed submissions are returned as tool results', async (t) => {
+  const respondWith = t.mock.fn();
+  const event = submissionEvent(t, { agentInvoked: true, respondWith });
+  const failure = { success: false, message: 'Login failed: APP_ERR_2001' };
+
+  submitToolForm(event, async () => failure);
+
+  assert.deepEqual(await respondWith.mock.calls[0].arguments[0], failure);
+});
+
+test('ordinary submissions and browsers without WebMCP use the same handler', (t) => {
+  const respondWith = t.mock.fn();
+  for (const nativeEvent of [{}, { agentInvoked: false, respondWith }]) {
+    const event = submissionEvent(t, nativeEvent);
+    const submit = t.mock.fn(async () => ({ success: true, message: 'Done' }));
+
+    submitToolForm(event, submit);
+
+    assert.equal(submit.mock.callCount(), 1);
+    assert.equal(event.preventDefault.mock.callCount(), 1);
+  }
+  assert.equal(respondWith.mock.callCount(), 0);
+});
