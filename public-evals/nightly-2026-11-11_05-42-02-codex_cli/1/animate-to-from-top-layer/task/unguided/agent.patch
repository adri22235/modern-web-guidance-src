+  <script>
+    const dialog = document.getElementById('logout-dialog');
+    const openDialogButton = document.getElementById('open-dialog-btn');
+    const notice = document.getElementById('floating-notice');
+    const noticeButton = document.getElementById('foobar');
+    let dialogClosing = false;
+    let noticeRevision = 0;
+
+    async function finishAnimations(element) {
+      await Promise.allSettled(element.getAnimations().map(animation => animation.finished));
+    }
+
+    openDialogButton.addEventListener('click', event => {
+      event.preventDefault();
+      if (dialog.open) return;
+      dialog.classList.remove('is-closing');
+      dialog.showModal();
+      document.body.classList.add('dialog-open');
+    });
+
+    async function closeDialog() {
+      if (!dialog.open || dialogClosing) return;
+      dialogClosing = true;
+      dialog.classList.add('is-closing');
+      await finishAnimations(dialog);
+      dialog.close();
+      dialog.classList.remove('is-closing');
+      dialogClosing = false;
+    }
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDialog();
+    });
+    dialog.addEventListener('close', () => {
+      document.body.classList.remove('dialog-open');
+    });
+    dialog.addEventListener('click', event => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog &&
+          (event.clientX < bounds.left || event.clientX > bounds.right ||
+           event.clientY < bounds.top || event.clientY > bounds.bottom)) closeDialog();
+    });
+
+    noticeButton.addEventListener('click', () => {
+      noticeRevision++;
+      notice.classList.remove('is-closing');
+      notice.hidden = false;
+      noticeButton.setAttribute('aria-expanded', 'true');
+      document.getElementById('notice-message').innerHTML =
+        '<strong>A little seasonal inspiration</strong><p>Our seasonal favorites are here. Explore the menu to find your next favorite cup.</p>';
+    });
+
+    document.getElementById('dismiss-notice-btn').addEventListener('click', async () => {
+      const revision = ++noticeRevision;
+      notice.classList.add('is-closing');
+      noticeButton.setAttribute('aria-expanded', 'false');
+      if (notice.contains(document.activeElement)) noticeButton.focus();
+      await finishAnimations(notice);
+      if (revision !== noticeRevision) return;
+      notice.hidden = true;
+      notice.classList.remove('is-closing');
+      document.getElementById('notice-message').textContent = '';
+    });
+  </script>
+
