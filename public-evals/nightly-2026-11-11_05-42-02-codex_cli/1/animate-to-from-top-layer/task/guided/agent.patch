+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your Daily Grind account?</p>
+    <form method="dialog" class="dialog-actions">
+      <button type="submit" class="btn secondary" id="close-dialog-btn" value="cancel" autofocus>Cancel</button>
+      <button type="submit" class="btn" value="confirm">Log out</button>
+    </form>
+  </dialog>
+
+  <aside id="coffee-notice" class="overlay" popover="manual" aria-labelledby="notice-title">
+    <h2 id="notice-title">A fresh little update</h2>
+    <p>Explore our seasonal favorites for your next coffee break.</p>
+    <button type="button" class="notice-close" aria-label="Dismiss notice" popovertarget="coffee-notice" popovertargetaction="hide">&times;</button>
+  </aside>
+  <div id="notice-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const noticeButton = document.getElementById('foobar');
+    const notice = document.getElementById('coffee-notice');
+    const announcement = document.getElementById('notice-announcement');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+
+    function reveal(element) {
+      // Establish the hidden visual state before transitioning, including in
+      // browsers without @starting-style support.
+      element.getBoundingClientRect();
+      element.setAttribute('data-visible', '');
+    }
+
+    async function dismiss(element, finish) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      element.removeAttribute('data-visible');
+      // Keep the native top layer active until exit finishes, including browsers
+      // that parse discrete transitions but cannot animate display or overlay.
+      await Promise.race([
+        Promise.allSettled(element.getAnimations({ subtree: true }).map(animation => animation.finished)),
+        new Promise(resolve => setTimeout(resolve, 400))
+      ]);
+      finish();
+      element.removeAttribute('data-closing');
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (dialog.open) return;
+      dialog.showModal();
+      reveal(dialog);
+    });
+
+    dialog.querySelector('form').addEventListener('submit', event => {
+      event.preventDefault();
+      const choice = event.submitter?.value || 'cancel';
+      dismiss(dialog, () => dialog.close(choice));
+    });
+
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      dismiss(dialog, () => dialog.close());
+    });
+
+    dialog.addEventListener('close', () => {
+      const choice = dialog.returnValue;
+      dialog.returnValue = '';
+      dialog.removeAttribute('data-visible');
+      if (choice === 'confirm') window.location.assign(logoutLink.href);
+    });
+
+    noticeButton.addEventListener('click', () => {
+      if (notice.hasAttribute('data-visible') || notice.hasAttribute('data-closing')) return;
+      if (supportsPopover) notice.showPopover();
+      else notice.setAttribute('data-fallback-open', '');
+      reveal(notice);
+      const message = `${document.getElementById('notice-title').textContent}. ${notice.querySelector('p').textContent}`;
+      if (typeof document.ariaNotify === 'function') document.ariaNotify(message);
+      else announcement.textContent = message;
+    });
+
+    notice.querySelector('button').addEventListener('click', event => {
+      event.preventDefault();
+      dismiss(notice, () => {
+        if (notice.contains(document.activeElement)) noticeButton.focus();
+        if (supportsPopover) notice.hidePopover();
+        else notice.removeAttribute('data-fallback-open');
+        announcement.textContent = '';
+      });
+    });
+  </script>
