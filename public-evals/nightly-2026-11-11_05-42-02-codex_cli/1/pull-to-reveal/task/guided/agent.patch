+      .page-scroll:not([data-scroll-ready]) {
+        visibility: hidden;
+      }
+    }
+
     /* Navigation */
     nav {
+      scroll-initial-target: nearest;
+      scroll-snap-align: start;
       background: var(--primary);
       color: white;
