+
+    .site-search {
+      background: var(--secondary);
+      padding: 16px 5%;
+    }
+
+    .site-search form {
+      display: flex;
+      gap: 10px;
+      max-width: 1100px;
+      margin: auto;
+    }
+
+    .site-search input {
+      flex: 1;
+      min-width: 0;
+      padding: 10px 14px;
+      border: 1px solid var(--primary);
