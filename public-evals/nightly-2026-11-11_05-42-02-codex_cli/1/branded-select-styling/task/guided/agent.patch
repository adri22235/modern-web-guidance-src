+  <script>
+    // Keep the entire picker branded in browsers without customizable selects.
+    if (!CSS.supports('appearance', 'base-select') || !CSS.supports('selector(::picker(select))')) {
+      const select = document.querySelector('#coffee-roast');
+      const wrapper = select.parentElement;
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      trigger.innerHTML = '<span id="roast-value"></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5" /></svg>';
+      const list = document.createElement('ul');
+      list.id = 'roast-options';
+      list.className = 'roast-options';
+      list.setAttribute('role', 'listbox');
+      list.setAttribute('aria-labelledby', 'roast-label');
+      list.hidden = true;
+      const items = Array.from(select.options, (option) => {
+        const item = document.createElement('li');
+        item.textContent = option.text;
+        item.setAttribute('role', 'option');
+        item.tabIndex = -1;
+        item.addEventListener('click', () => {
+          select.value = option.value;
+          select.dispatchEvent(new Event('change', { bubbles: true }));
+          close(true);
+        });
+        list.append(item);
+        return item;
+      });
+      function sync() {
+        trigger.querySelector('span').textContent = select.selectedOptions[0].text;
+        items.forEach((item, index) => item.setAttribute('aria-selected', String(index === select.selectedIndex)));
+      }
+      function close(restoreFocus = false) {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+      function open(index = select.selectedIndex) {
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        items[index].focus();
+      }
+      trigger.addEventListener('click', () => list.hidden ? open() : close());
+      trigger.addEventListener('keydown', (event) => {
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          open(event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 : select.selectedIndex);
+        }
+      });
+      list.addEventListener('keydown', (event) => {
+        const index = items.indexOf(document.activeElement);
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+            (index + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
+          items[next].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          items[index].click();
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          close(true);
+        } else if (event.key === 'Tab') {
+          // Restore the trigger before letting the browser advance focus.
+          close(true);
+        } else if (event.key.length === 1) {
+          const match = items.find((item) => item.textContent.toLowerCase().startsWith(event.key.toLowerCase()));
+          if (match) match.focus();
+        }
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (!wrapper.contains(event.target)) close();
+      });
+      wrapper.addEventListener('focusout', (event) => {
+        if (!wrapper.contains(event.relatedTarget)) close();
+      });
+      select.addEventListener('change', sync);
+      wrapper.append(trigger, list);
+      select.hidden = true;
+      document.querySelector('#roast-label').htmlFor = trigger.id;
+      sync();
+    }
+  </script>
