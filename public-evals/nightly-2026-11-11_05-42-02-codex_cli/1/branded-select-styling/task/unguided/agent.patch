+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = selector.querySelector('.roast-trigger');
+    const list = selector.querySelector('[role="listbox"]');
+    const options = [...list.querySelectorAll('[role="option"]')];
+
+    function closeRoasts(returnFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      document.getElementById('roast-selection').textContent = option.querySelector('span').textContent;
+      document.getElementById('roast-value').value = option.dataset.value;
+      closeRoasts(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    options.forEach(option => option.addEventListener('click', () => selectRoast(option)));
+    list.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        options[(index + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length].focus();
+      } else if (event.key === 'Home' || event.key === 'End') {
+        event.preventDefault();
+        options[event.key === 'Home' ? 0 : options.length - 1].focus();
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        if (index >= 0) selectRoast(options[index]);
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        closeRoasts(true);
+      } else if (event.key.length === 1) {
+        const match = options.find(option => option.dataset.value.startsWith(event.key.toLowerCase()));
+        if (match) match.focus();
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
