@@ -0,0 +1,107 @@
+(() => {
+  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+  const dialog = document.querySelector('#drink-details');
+  const roast = document.querySelector('#daily-roast');
+  const roastToggle = document.querySelector('.roast-toggle');
+  let closeTimer;
+  let lastTrigger;
+
+  // Some event producers expose the Animation directly. Native CSS events
+  // require resolving it by name/property on the element that emitted the event.
+  function trackMotion(event) {
+    const animation = event.animation ?? event.target.getAnimations?.().find((candidate) =>
+      event.animationName ? candidate.animationName === event.animationName :
+        candidate.transitionProperty === event.propertyName);
+    const ended = event.type.endsWith('end');
+    const canceled = event.type.endsWith('cancel');
+    document.body.dataset.lastAnimationState = animation?.playState ??
+      (canceled ? 'idle' : ended ? 'finished' : 'running');
+  }
+
+  for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+    'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+    document.addEventListener(type, trackMotion);
+  }
+
+  roastToggle.addEventListener('click', () => {
+    const paused = roast.dataset.paused !== 'true';
+    roast.dataset.paused = String(paused);
+    roastToggle.setAttribute('aria-pressed', String(paused));
+    roastToggle.textContent = paused ? 'Resume roast' : 'Pause roast';
+    // Update immediately, since changing play state doesn't emit a CSS event.
+    const animation = roast.getAnimations()[0];
+    if (animation) {
+      if (paused) animation.pause();
+      else animation.play();
+      document.body.dataset.lastAnimationState = animation.playState;
+    }
+  });
+
+  const drinks = {
+    maple: {
+      title: 'Maple Oat Latte',
+      description: 'Rich espresso meets creamy oat milk and a hint of Vermont maple syrup. A mellow, gently sweet companion for crisp mornings.',
+      notes: 'Tasting notes: maple sweetness, toasted oats, smooth espresso. Made with oat milk.'
+    },
+    espresso: {
+      title: 'Dark Roast Espresso',
+      description: 'A bold, smoky espresso with a deep roast character and a lingering finish. A little cup with plenty of presence.',
+      notes: 'Tasting notes: deep roast, smoky warmth, full body. Served as espresso.'
+    },
+    'cold-brew': {
+      title: 'Cold Brew',
+      description: 'Slowly steeped for 18 hours to bring out a smooth, rounded coffee flavor. Served cold for an easy, refreshing daily ritual.',
+      notes: 'Tasting notes: mellow roast, smooth finish. Steeped for 18 hours and served over ice.'
+    }
+  };
+
+  document.querySelectorAll('[data-drink]').forEach((button) => {
+    button.addEventListener('click', () => {
+      const drink = drinks[button.dataset.drink];
+      document.querySelector('#drink-title').textContent = drink.title;
+      document.querySelector('#drink-description').textContent = drink.description;
+      document.querySelector('#drink-notes').textContent = drink.notes;
+      clearTimeout(closeTimer);
+      dialog.classList.remove('is-closing');
+      lastTrigger = button;
+      dialog.showModal();
+    });
+  });
+
+  function finishClose() {
+    clearTimeout(closeTimer);
+    dialog.close();
+    dialog.classList.remove('is-closing');
+  }
+
+  function closeDetails() {
+    if (!dialog.open || dialog.classList.contains('is-closing')) return;
+    if (reducedMotion.matches) {
+      finishClose();
+      return;
+    }
+    dialog.classList.add('is-closing');
+    // A fallback also handles interrupted or disabled animations.
+    closeTimer = window.setTimeout(finishClose, 300);
+  }
+
+  dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+  dialog.addEventListener('cancel', (event) => {
+    event.preventDefault();
+    closeDetails();
+  });
+  dialog.addEventListener('click', (event) => {
+    if (event.target !== dialog) return;
+    const bounds = dialog.getBoundingClientRect();
+    if (event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom) closeDetails();
+  });
+  dialog.addEventListener('animationend', (event) => {
+    if (event.target === dialog && event.animationName === 'dialog-out' &&
+        !event.pseudoElement && dialog.classList.contains('is-closing')) finishClose();
+  });
+  dialog.addEventListener('close', () => lastTrigger?.focus({ preventScroll: true }));
+  reducedMotion.addEventListener('change', () => {
+    if (reducedMotion.matches && dialog.classList.contains('is-closing')) finishClose();
+  });
+})();
