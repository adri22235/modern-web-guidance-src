+  <script>
+    // Prefer the exact object supplied by the event: names cannot distinguish
+    // duplicate animations or animations on pseudo-elements.
+    function recordAnimationState(event) {
+      const animation = event.animation;
+      const fallbackState = event.type.endsWith('cancel') ? 'idle'
+        : event.type.endsWith('end') ? 'finished' : 'running';
+      document.body.dataset.lastAnimationState = animation?.playState ?? fallbackState;
+    }
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, recordAnimationState);
+    }
+
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const roastTrack = document.querySelector('.roast-track');
+    const roastControl = document.querySelector('.roast-control');
+    let roastPaused = false;
+    function updateRoastControl() {
+      roastTrack.classList.toggle('is-paused', roastPaused || motionPreference.matches);
+      roastControl.disabled = motionPreference.matches;
+      roastControl.textContent = motionPreference.matches ? 'Motion reduced'
+        : roastPaused ? 'Resume roast banner' : 'Pause roast banner';
+    }
+    roastControl.addEventListener('click', () => {
+      roastPaused = !roastPaused;
+      updateRoastControl();
+    });
+    motionPreference.addEventListener('change', updateRoastControl);
+    updateRoastControl();
+
+    const drinks = {
+      seasonal: {
+        title: 'Maple Oat Latte',
+        description: 'Espresso meets creamy oat milk and a hint of Vermont maple syrup. A cozy, gently sweet cup for slower mornings.',
+        notes: 'Tasting notes: maple, toasted oats, and a mellow espresso finish. Contains oats.'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'A bold, smoky espresso with a rich body and a lingering finish. Enjoy it straight for a small but satisfying morning ritual.',
+        notes: 'Tasting notes: deep roast, cocoa, and a smoky finish. Served hot.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Coffee steeped slowly for 18 hours, then served over ice. Smooth, refreshing, and full of flavor from the first sip to the last.',
+        notes: 'Tasting notes: rounded roast and a smooth finish. Served over ice.'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+    for (const button of document.querySelectorAll('[data-drink]')) {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        dialog.showModal();
+      });
+    }
+    // Keep the dialog in the top layer until the exit settles. This also works
+    // where overlay/discrete display transitions are not implemented.
+    async function closeDrinkDetails() {
+      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+      dialog.setAttribute('data-closing', '');
+      const animations = dialog.getAnimations({ subtree: true });
+      if (animations.length) {
+        await Promise.race([
+          Promise.allSettled(animations.map(animation => animation.finished)),
+          new Promise(resolve => setTimeout(resolve, 500))
+        ]);
+      }
+      dialog.close();
+      dialog.removeAttribute('data-closing');
+    }
+    dialog.querySelector('.close-dialog').addEventListener('click', closeDrinkDetails);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDrinkDetails();
+    });
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      let pressedOutside = false;
+      const outside = event => {
+        const rect = dialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right
+          || event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      dialog.addEventListener('pointerdown', event => { pressedOutside = outside(event); });
+      dialog.addEventListener('pointerup', event => {
+        if (pressedOutside && outside(event)) closeDrinkDetails();
+        pressedOutside = false;
+      });
+    }
+  </script>
