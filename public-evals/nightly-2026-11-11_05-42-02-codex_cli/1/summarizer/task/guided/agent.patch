+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+    const options = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+      monitor(monitor) {
+        monitor.addEventListener('downloadprogress', (event) => {
+          const percent = Math.round(event.loaded * 100);
+          journalStatus.textContent = `Downloading the on-device AI model: ${percent}%. This may take a few minutes.`;
+        });
+      }
+    };
+
+    async function checkNativeAI() {
+      if (!window.isSecureContext || !('Summarizer' in self)) {
+        journalStatus.textContent = 'Native AI summaries are not supported in this browser. You can still enjoy the full journal above.';
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          journalStatus.textContent = 'Native AI summaries are unavailable on this device. The full journal is available above.';
+          return;
+        }
+        summarizeButton.disabled = false;
+        journalStatus.textContent = availability === 'available'
+          ? 'Ready to summarize on your device.'
+          : 'Select Summarize to download or finish preparing the browser’s AI model.';
+      } catch {
+        journalStatus.textContent = 'Could not check native AI availability. Reload the page to try again.';
+      }
+    }
+
+    summarizeButton.addEventListener('click', async () => {
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing the on-device summary…';
+      let summarizer;
+
+      try {
+        // Call create directly from the click to preserve user activation for model downloads.
+        summarizer = await Summarizer.create(options);
+        journalStatus.textContent = 'Reading the journal and creating highlights…';
+        const result = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+        const points = result.split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        const items = points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        });
+        summaryPoints.replaceChildren(...items);
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your AI-generated highlights are ready below.';
+      } catch {
+        journalStatus.textContent = 'The browser could not create a summary. Please try again; the full journal is always available above.';
+      } finally {
+        summarizer?.destroy();
+        summaryPanel.setAttribute('aria-busy', 'false');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+
+    checkNativeAI();
+  </script>
+
