+        aria-controls="journal-summary" aria-describedby="journal-ai-note journal-status">Summarize</button>
+      <p id="journal-ai-note" class="journal-note">Get a few AI-generated highlights, processed on your device. First use may download an AI model.</p>
+      <p id="journal-status" class="journal-status" role="status">Checking native AI availability…</p>
+      <div id="journal-summary" class="journal-summary" aria-labelledby="summary-title" hidden>
+        <h3 id="summary-title">Sourcing at a glance</h3>
+        <p class="journal-note">AI-generated highlights</p>
+        <ul id="journal-summary-points"></ul>
+      </div>
