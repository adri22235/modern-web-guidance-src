+        <div class="journal-summary" id="journal-summary" aria-labelledby="summary-heading" aria-busy="false" hidden>
+          <h3 id="summary-heading">The sourcing story, in brief</h3>
+          <ul id="journal-summary-points"></ul>
+        </div>
