+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!('Summarizer' in window)) {
+        journalStatus.textContent = 'Built-in AI summarization isn’t available in this browser. Try a supported desktop Chrome browser; you can still read the full story above.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI. A first-time model download may take a few minutes…';
+      let summarizer;
+
+      try {
+        // Create directly in the click handler to preserve user activation for downloads.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              const percent = Math.round(event.loaded * 100);
+              journalStatus.textContent = `Downloading your browser’s AI model: ${percent}%. Summarization will start when it’s ready.`;
+            });
+          }
+        });
+
+        journalStatus.textContent = 'Summarizing the sourcing story on your device…';
+        const story = document.getElementById('journal-story').innerText;
+        const summary = await summarizer.summarize(story);
+        const points = summary.split(/\n+/)
+          .map((line) => line.replace(/^\s*(?:[-*•–]|\d+[.)])\s+/, '').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Your AI-generated summary is ready below. Read the full journal above for the complete story.';
+      } catch (error) {
+        journalStatus.textContent = error.name === 'NotSupportedError'
+          ? 'Built-in AI isn’t available on this device or for this browser configuration. You can still read the full story above.'
+          : 'Your browser couldn’t finish the summary. Please try again; if a model download is needed, check your connection and available storage.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+        summaryPanel.setAttribute('aria-busy', 'false');
+      }
+    });
+  </script>
