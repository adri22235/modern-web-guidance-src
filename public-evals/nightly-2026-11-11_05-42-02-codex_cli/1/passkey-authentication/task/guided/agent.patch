+  <script>
+    const signinForm = document.querySelector('#signin-form');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    let autofillController;
+    let explicitLogin = false;
+    let authenticated = false;
+
+    // Keep older WebAuthn browsers working when the JSON helpers are unavailable.
+    function decodeBase64url(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')),
+        character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseOptions(options) {
+      if (PublicKeyCredential.parseRequestOptionsFromJSON) {
+        return PublicKeyCredential.parseRequestOptionsFromJSON(options);
+      }
+      return {
+        ...options,
+        challenge: decodeBase64url(options.challenge),
+        allowCredentials: options.allowCredentials?.map(credential => ({
+          ...credential, id: decodeBase64url(credential.id),
+        })),
+      };
+    }
+
+    function serializeCredential(credential) {
+      if (credential.toJSON) return credential.toJSON();
+      const response = credential.response;
+      return {
+        id: credential.id,
+        rawId: encodeBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        clientExtensionResults: credential.getClientExtensionResults(),
+        response: {
+          clientDataJSON: encodeBase64url(response.clientDataJSON),
+          authenticatorData: encodeBase64url(response.authenticatorData),
+          signature: encodeBase64url(response.signature),
+          userHandle: response.userHandle ? encodeBase64url(response.userHandle) : null,
+        },
+      };
+    }
+
+    async function authenticate(conditional, signal) {
+      const optionsResponse = await fetch('/api/login/options', {
+        credentials: 'same-origin', cache: 'no-store', signal,
+      });
+      if (!optionsResponse.ok) throw new Error('Could not load passkey sign-in options. Please try again.');
+      const options = await optionsResponse.json();
+      const publicKey = parseOptions(options.publicKey ?? options);
+      const credential = await navigator.credentials.get({
+        publicKey,
+        ...(conditional ? { mediation: 'conditional' } : {}),
+        signal,
+      });
+      if (!credential) throw new Error('No passkey was selected. Please try again.');
+      if (signal?.aborted) return;
+
+      authButton.disabled = true;
+      authStatus.textContent = 'Verifying your passkey…';
+      const encoded = serializeCredential(credential);
+      const verification = await fetch('/api/login/verify', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+        signal,
+      });
+      if (!verification.ok) {
+        if (verification.status === 404 && publicKey.rpId && PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({ rpId: publicKey.rpId, credentialId: encoded.id });
+          } catch {
+            // Provider synchronization is optional and must not mask the sign-in error.
+          }
+        }
+        throw new Error('Passkey verification failed. Please try again.');
+      }
+      const result = await verification.json();
+      if (result.verified === false || result.success === false || result.authenticated === false) {
+        throw new Error('Passkey verification failed. Please try again.');
+      }
+      authenticated = true;
+      authStatus.textContent = 'Signed in successfully.';
+    }
+
+    async function initializeAutofill() {
+      if (explicitLogin || authenticated) return;
+      const controller = new AbortController();
+      autofillController?.abort();
+      autofillController = controller;
+      try {
+        const supported = PublicKeyCredential.getClientCapabilities
+          ? (await PublicKeyCredential.getClientCapabilities()).conditionalGet === true
+          : await PublicKeyCredential.isConditionalMediationAvailable?.();
+        if (!supported || controller.signal.aborted) return;
+        await authenticate(true, controller.signal);
+      } catch (error) {
+        if (!controller.signal.aborted && !['AbortError', 'NotAllowedError'].includes(error.name)) {
+          authStatus.textContent = error.message || 'Passkey sign-in is unavailable. Please try again.';
+        }
+      } finally {
+        if (!controller.signal.aborted && !explicitLogin && !authenticated) authButton.disabled = false;
+      }
+    }
+
+    signinForm.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (explicitLogin || authenticated || authButton.disabled) return;
+      explicitLogin = true;
+      autofillController?.abort();
+      authButton.disabled = true;
+      authStatus.textContent = 'Choose your passkey to sign in…';
+      try {
+        await authenticate(false);
+      } catch (error) {
+        authStatus.textContent = ['NotAllowedError', 'AbortError'].includes(error.name)
+          ? 'Sign-in cancelled. You can try again.'
+          : error.message || 'Could not sign in. Please try again.';
+      } finally {
+        explicitLogin = false;
+        authButton.disabled = authenticated;
+        if (!authenticated) void initializeAutofill();
+      }
+    });
+
+    if (window.isSecureContext && window.PublicKeyCredential && navigator.credentials?.get) {
+      void initializeAutofill();
+    } else {
+      authButton.disabled = true;
+      authStatus.textContent = 'Passkeys require a supported browser and a secure connection (HTTPS).';
+    }
+  </script>
+
