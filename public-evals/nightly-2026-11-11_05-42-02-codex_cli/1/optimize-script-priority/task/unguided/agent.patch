diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,43 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Dashboard</title>
+    <script async src="/js/app.js"></script>
+    <script async src="/js/tracker.js"></script>
+    <style>
+      * { box-sizing: border-box; }
+      body { margin: 0; color: #202321; background: #fafbf9; font: 15px/1.5 system-ui, sans-serif; }
+      main { max-width: 960px; margin: 80px auto; padding: 0 24px; }
+      header { margin-bottom: 40px; }
+      h1 { margin: 0 0 8px; font-size: 32px; font-weight: 600; letter-spacing: -1px; }
+      p { margin: 0; color: #727871; }
+      .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
+      article { padding: 24px; border: 1px solid #e3e7e0; border-radius: 8px; background: white; }
+      h2 { margin: 0 0 16px; color: #727871; font-size: 14px; font-weight: 400; }
+      strong { font-size: 32px; font-weight: 500; letter-spacing: -1px; }
+      .activity { margin-top: 40px; padding-top: 24px; border-top: 1px solid #e3e7e0; }
+      .activity h2 { color: #202321; font-weight: 500; }
+      @media (max-width: 600px) { main { margin-top: 40px; } .metrics { grid-template-columns: 1fr; } }
+    </style>
+  </head>
+  <body>
+    <main>
+      <header>
+        <h1>Dashboard</h1>
+        <p>A simple overview of your workspace.</p>
+      </header>
+      <section class="metrics" aria-label="Workspace metrics">
+        <article><h2>Total projects</h2><strong>0</strong></article>
+        <article><h2>Active tasks</h2><strong>0</strong></article>
+        <article><h2>Completed</h2><strong>0</strong></article>
+      </section>
+      <section class="activity" aria-labelledby="activity-title">
+        <h2 id="activity-title">Recent activity</h2>
+        <p>No activity yet.</p>
+      </section>
+    </main>
+    <script src="/js/legacy-widgets.js"></script>
+  </body>
+</html>
