+  <aside class="coffee-cart" data-draggable aria-labelledby="cart-heading">
+    <header class="cart-header">
+      <button class="cart-handle" type="button" data-drag-handle aria-label="Move coffee cart. Drag or use arrow keys." title="Drag to move · arrow keys when focused">⠿</button>
+      <div class="cart-title">
+        <h2 id="cart-heading">Your coffee, your way</h2>
+        <p>A little pick-me-up, just a tap away.</p>
+      </div>
+      <button class="cart-toggle" type="button" aria-expanded="true" aria-controls="cart-body" aria-label="Minimize coffee cart">−</button>
+    </header>
+    <div class="cart-body" id="cart-body">
+      <form id="quick-order" action="/order-online" method="get">
+        <label class="cart-label" for="cart-drink">Choose your coffee</label>
+        <select id="cart-drink" name="drink">
+          <option value="maple-oat-latte" data-price="5.50">Maple Oat Latte · $5.50</option>
+          <option value="dark-roast-espresso" data-price="3.00">Dark Roast Espresso · $3.00</option>
+          <option value="cold-brew" data-price="4.50">Cold Brew · $4.50</option>
+        </select>
+        <div class="cart-options">
+          <fieldset>
+            <legend>Make it</legend>
+            <div class="cart-temperature">
+              <label><input type="radio" name="temperature" value="hot" checked> Hot</label>
+              <label><input type="radio" name="temperature" value="iced"> Iced</label>
+            </div>
+          </fieldset>
+          <label class="cart-label cart-quantity" for="cart-quantity">Quantity
+            <input id="cart-quantity" name="quantity" type="number" min="1" max="10" step="1" value="1" required>
+          </label>
+        </div>
+        <div class="cart-total"><span>Item total</span><output id="cart-total" for="cart-drink cart-quantity" aria-live="polite">$5.50</output></div>
+        <button class="btn cart-submit" type="submit">Add to cart <span aria-hidden="true">↗</span></button>
+      </form>
+      <p class="cart-status" id="cart-status" role="status">Your cart is ready for a coffee.</p>
+      <button class="cart-clear" type="button" hidden>Clear cart</button>
+      <details class="cart-tools">
+        <summary>Move this cart</summary>
+        <p>Drag the header grip, or focus it and use the arrow keys. You can also choose a corner below.</p>
+        <label for="cart-position">Position</label>
+        <select id="cart-position">
+          <option value="">Choose a corner…</option>
+          <option value="bottom-right">Bottom right</option>
+          <option value="bottom-left">Bottom left</option>
+          <option value="top-right">Top right</option>
+          <option value="top-left">Top left</option>
+        </select>
+      </details>
+    </div>
+  </aside>
+  <div id="cart-movement" class="visually-hidden" aria-live="polite"></div>
+
+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      const body = document.getElementById('cart-body');
+      const toggle = panel.querySelector('.cart-toggle');
+      const movement = document.getElementById('cart-movement');
+      const position = document.getElementById('cart-position');
+      let offsetX = 0;
+      let offsetY = 0;
+      let moved = false;
+      let announcementTimer;
+
+      function announce(message) {
+        clearTimeout(announcementTimer);
+        movement.textContent = message;
+        announcementTimer = setTimeout(() => { movement.textContent = ''; }, 1500);
+      }
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth - 12);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight - 12);
+        panel.style.left = `${Math.max(Math.min(12, maxLeft), Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(Math.min(12, maxTop), Math.min(top, maxTop))}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      }
+
+      function keepInView() {
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || !event.isPrimary) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        moved = false;
+        handle.setPointerCapture(event.pointerId);
+        handle.focus({ preventScroll: true });
+      });
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        moved = true;
+        handle.classList.add('dragging');
+        position.value = '';
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+      function release(event) {
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+      }
+      handle.addEventListener('pointerup', release);
+      handle.addEventListener('pointercancel', release);
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+        if (moved) announce('Coffee cart moved.');
+      });
+      handle.addEventListener('keydown', (event) => {
+        const directions = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+        const direction = directions[event.key];
+        if (!direction) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + direction[0], rect.top + direction[1]);
+        position.value = '';
+        announce(`Coffee cart moved ${event.key.slice(5).toLowerCase()}.`);
+      });
+      position.addEventListener('change', () => {
+        if (!position.value) return;
+        moveTo(position.value.endsWith('right') ? window.innerWidth - panel.offsetWidth - 12 : 12,
+          position.value.startsWith('bottom') ? window.innerHeight - panel.offsetHeight - 12 : 12);
+        announce(`Coffee cart moved to ${position.selectedOptions[0].textContent.toLowerCase()}.`);
+      });
+      toggle.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        toggle.setAttribute('aria-expanded', String(!body.hidden));
+        toggle.setAttribute('aria-label', body.hidden ? 'Expand coffee cart' : 'Minimize coffee cart');
+        toggle.textContent = body.hidden ? '+' : '−';
+        keepInView();
+      });
+      window.addEventListener('resize', keepInView);
+      new ResizeObserver(keepInView).observe(panel);
+
+      const form = document.getElementById('quick-order');
+      const drink = document.getElementById('cart-drink');
+      const quantity = document.getElementById('cart-quantity');
+      const total = document.getElementById('cart-total');
+      const status = document.getElementById('cart-status');
+      const clear = panel.querySelector('.cart-clear');
+      const hot = form.querySelector('[value="hot"]');
+      const iced = form.querySelector('[value="iced"]');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      let cartCount = 0;
+      let cartCents = 0;
+      const price = () => Math.round(Number(drink.selectedOptions[0].dataset.price) * 100);
+      function updateTotal() {
+        const cold = drink.value === 'cold-brew';
+        hot.disabled = cold;
+        if (cold) iced.checked = true;
+        total.value = quantity.validity.valid ? money.format(price() * Number(quantity.value) / 100) : '—';
+      }
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        cartCount += Number(quantity.value);
+        cartCents += price() * Number(quantity.value);
+        status.textContent = `${quantity.value} ${form.elements.temperature.value} ${drink.selectedOptions[0].textContent.split(' · ')[0]} added. Your cart: ${cartCount} ${cartCount === 1 ? 'drink' : 'drinks'} · ${money.format(cartCents / 100)}. Cart is saved for this page visit.`;
+        clear.hidden = false;
+      });
+      clear.addEventListener('click', () => {
+        cartCount = 0;
+        cartCents = 0;
+        status.textContent = 'Cart cleared. Ready for a fresh start.';
+        form.querySelector('[type="submit"]').focus();
+        clear.hidden = true;
+      });
+      updateTotal();
+      panel.classList.add('is-ready');
+    })();
+  </script>
 </body>
 
