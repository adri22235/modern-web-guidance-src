+  <aside class="coffee-cart" data-draggable aria-label="Quick coffee order">
+    <header class="cart-handle" data-drag-handle tabindex="0" aria-label="Move coffee cart. Drag or use arrow keys.">
+      <span class="cart-grip" aria-hidden="true">⠿</span>
+      <div class="cart-heading">
+        <h2>Your coffee, your way</h2>
+        <p>QUICK ORDER · DRAG TO MOVE</p>
+      </div>
+      <button class="cart-toggle" type="button" aria-label="Minimize coffee cart" aria-expanded="true" aria-controls="cart-body">−</button>
+    </header>
+    <div class="cart-body" id="cart-body">
+      <p class="cart-eyebrow">A LITTLE PICK-ME-UP</p>
+      <h3>Make it a coffee break.</h3>
+      <p class="cart-description">Your Daily Grind favorites, a click away.</p>
+      <label for="cart-drink">Your coffee</label>
+      <select id="cart-drink">
+        <option value="latte" data-price="5.50">Maple Oat Latte · $5.50</option>
+        <option value="espresso" data-price="3.00">Dark Roast Espresso · $3.00</option>
+        <option value="cold-brew" data-price="4.50">Cold Brew · $4.50</option>
+      </select>
+      <div class="cart-row">
+        <label id="cart-quantity-label">Quantity</label>
+        <div class="cart-stepper" role="group" aria-labelledby="cart-quantity-label">
+          <button type="button" id="cart-minus" aria-label="Decrease quantity" disabled>−</button>
+          <output id="cart-quantity" aria-live="polite">1</output>
+          <button type="button" id="cart-plus" aria-label="Increase quantity">+</button>
+        </div>
+      </div>
+      <button type="button" class="btn cart-add" id="cart-add">Add to cart · $5.50</button>
+      <div class="cart-summary cart-row">
+        <span id="cart-total">0 items · $0.00</span>
+        <a class="cart-checkout" href="/order-online" hidden>Continue →</a>
+      </div>
+      <p class="cart-status" role="status"></p>
+    </div>
+  </aside>
+
+  <script>
+    (() => {
+      const cart = document.querySelector('[data-draggable]');
+      const handle = cart.querySelector('[data-drag-handle]');
+      const toggle = cart.querySelector('.cart-toggle');
+      const body = document.getElementById('cart-body');
+      const drink = document.getElementById('cart-drink');
+      const minus = document.getElementById('cart-minus');
+      const plus = document.getElementById('cart-plus');
+      const quantityOutput = document.getElementById('cart-quantity');
+      const add = document.getElementById('cart-add');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      let quantity = 1;
+      let items = 0;
+      let total = 0;
+      let drag = null;
+
+      function updateOrder() {
+        quantityOutput.value = quantity;
+        minus.disabled = quantity === 1;
+        plus.disabled = quantity === 20;
+        add.textContent = `Add to cart · ${money.format(Number(drink.selectedOptions[0].dataset.price) * quantity)}`;
+      }
+      minus.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); updateOrder(); });
+      plus.addEventListener('click', () => { quantity = Math.min(20, quantity + 1); updateOrder(); });
+      drink.addEventListener('change', updateOrder);
+      add.addEventListener('click', () => {
+        const selected = drink.selectedOptions[0];
+        items += quantity;
+        total += Math.round(Number(selected.dataset.price) * 100) * quantity;
+        document.getElementById('cart-total').textContent = `${items} ${items === 1 ? 'item' : 'items'} · ${money.format(total / 100)}`;
+        const checkout = cart.querySelector('.cart-checkout');
+        checkout.hidden = false;
+        cart.querySelector('.cart-status').textContent = `${quantity} × ${selected.textContent.split(' · ')[0]} added to your cart.`;
+        const order = JSON.parse(checkout.dataset.order || '{}');
+        order[drink.value] = (order[drink.value] || 0) + quantity;
+        checkout.dataset.order = JSON.stringify(order);
+        checkout.href = `/order-online?${new URLSearchParams(order)}`;
+      });
+
+      function moveTo(left, top) {
+        const margin = 12;
+        cart.style.left = `${Math.max(margin, Math.min(left, window.innerWidth - cart.offsetWidth - margin))}px`;
+        cart.style.top = `${Math.max(margin, Math.min(top, window.innerHeight - cart.offsetHeight - margin))}px`;
+        cart.style.right = 'auto';
+        cart.style.bottom = 'auto';
+      }
+      function keepInView() {
+        const bounds = cart.getBoundingClientRect();
+        moveTo(bounds.left, bounds.top);
+      }
+      toggle.addEventListener('click', () => {
+        body.hidden = !body.hidden;
+        toggle.setAttribute('aria-expanded', String(!body.hidden));
+        toggle.setAttribute('aria-label', body.hidden ? 'Expand coffee cart' : 'Minimize coffee cart');
+        toggle.textContent = body.hidden ? '+' : '−';
+        keepInView();
+      });
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.target.closest('button') || !event.isPrimary || event.button !== 0) return;
+        const bounds = cart.getBoundingClientRect();
+        drag = { id: event.pointerId, x: event.clientX - bounds.left, y: event.clientY - bounds.top };
+        handle.setPointerCapture(event.pointerId);
+        handle.focus({ preventScroll: true });
+        event.preventDefault();
+      });
+      handle.addEventListener('pointermove', (event) => {
+        if (drag && event.pointerId === drag.id) moveTo(event.clientX - drag.x, event.clientY - drag.y);
+      });
+      function endDrag(event) {
+        if (!drag || event.pointerId !== drag.id) return;
+        drag = null;
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', () => { drag = null; });
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const direction = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }[event.key];
+        if (!direction) return;
+        event.preventDefault();
+        const bounds = cart.getBoundingClientRect();
+        const step = event.shiftKey ? 40 : 10;
+        moveTo(bounds.left + direction[0] * step, bounds.top + direction[1] * step);
+      });
+      window.addEventListener('resize', keepInView);
+    })();
+  </script>
 </body>
 
