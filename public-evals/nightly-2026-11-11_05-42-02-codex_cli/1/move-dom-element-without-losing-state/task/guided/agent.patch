+  <script>
+    const player = document.getElementById('roasting-player');
+    const videoHome = document.getElementById('video-home');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const hero = document.querySelector('.hero');
+    const toggle = document.getElementById('theater-toggle');
+    const status = document.getElementById('video-status');
+
+    if (typeof heroSlot.moveBefore === 'function') {
+      toggle.disabled = false;
+      let theaterMode = false;
+
+      toggle.addEventListener('click', () => {
+        const nextMode = !theaterMode;
+        const destination = nextMode ? heroSlot : videoHome;
+
+        // Atomic reparenting keeps the iframe's browsing context and playback alive.
+        destination.moveBefore(player, null);
+        theaterMode = nextMode;
+        hero.classList.toggle('is-theater', theaterMode);
+        toggle.setAttribute('aria-pressed', String(theaterMode));
+        toggle.textContent = theaterMode ? 'Exit theater mode' : 'Theater mode';
+        status.textContent = theaterMode
+          ? 'The video is now in the hero. Playback continues uninterrupted.'
+          : 'The video is back in this section. Playback continues uninterrupted.';
+        toggle.focus({ preventScroll: true });
+        player.scrollIntoView({ block: 'center', behavior: 'instant' });
+      });
+    } else {
+      // A remove-and-insert fallback would reload YouTube and lose playback state.
+      status.textContent = 'Theater mode requires a browser that supports moving video without reloading. You can still watch here or use fullscreen.';
+      toggle.setAttribute('aria-describedby', 'video-status');
+    }
+  </script>
+
