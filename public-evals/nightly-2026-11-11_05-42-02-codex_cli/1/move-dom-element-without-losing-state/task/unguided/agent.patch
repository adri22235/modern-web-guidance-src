+  <script>
+    const hero = document.querySelector('.hero');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const videoHome = document.getElementById('video-home');
+    const player = document.getElementById('roasting-player');
+    const toggle = document.getElementById('theater-toggle');
+    const canMoveWithoutReload = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionFallbackPlayer() {
+      if (canMoveWithoutReload || !theaterMode) return;
+      // Older browsers reload an iframe when reparenting it. Keep it connected
+      // and position it over the hero's reserved slot instead.
+      const slot = heroSlot.getBoundingClientRect();
+      player.style.position = 'absolute';
+      player.style.top = `${slot.top + window.scrollY}px`;
+      player.style.left = `${slot.left + window.scrollX}px`;
+      player.style.width = `${slot.width}px`;
+      heroSlot.style.height = `${player.getBoundingClientRect().height}px`;
+    }
+
+    toggle.addEventListener('click', () => {
+      theaterMode = !theaterMode;
+      hero.classList.toggle('is-theater', theaterMode);
+      heroSlot.hidden = !theaterMode;
+
+      if (canMoveWithoutReload) {
+        // Moving the existing connected node preserves the iframe browsing
+        // context, including playback. Never replace it or change its src.
+        (theaterMode ? heroSlot : videoHome).moveBefore(player, null);
+      } else if (theaterMode) {
+        positionFallbackPlayer();
+      } else {
+        player.style.removeProperty('position');
+        player.style.removeProperty('top');
+        player.style.removeProperty('left');
+        player.style.removeProperty('width');
+        heroSlot.style.removeProperty('height');
+      }
+
+      toggle.setAttribute('aria-pressed', String(theaterMode));
+      toggle.textContent = theaterMode ? 'Exit theater mode' : 'Enter theater mode';
+      if (theaterMode) hero.scrollIntoView({ block: 'start' });
+      else player.scrollIntoView({ block: 'center' });
+    });
+
+    if (!canMoveWithoutReload) {
+      new ResizeObserver(positionFallbackPlayer).observe(player);
+      new ResizeObserver(positionFallbackPlayer).observe(hero);
+      window.addEventListener('resize', positionFallbackPlayer);
+    }
+  </script>
