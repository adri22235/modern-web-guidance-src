new file mode 100644
index 0000000..cd5b9ae
--- /dev/null
+++ b/passkeys.js
@@ -0,0 +1,66 @@
+const STORAGE_KEY = 'daily-grind.passkeys.v1';
+const examples = [
+  { id: 'macbook', name: 'MacBook Pro', provider: 'iCloud Keychain', createdAt: '2026-10-12', lastUsedAt: '2026-11-11', current: true, icon: 'laptop' },
+  { id: 'iphone', name: 'iPhone 15', provider: 'iCloud Keychain', createdAt: '2026-10-12', lastUsedAt: '2026-11-10', icon: 'phone' },
+  { id: 'windows', name: 'Windows PC', provider: 'Windows Hello', createdAt: '2026-09-28', lastUsedAt: '2026-10-28', icon: 'laptop' }
+];
+
+// A connected account must get its credential IDs from an authenticated server.
+// Display names are account labels, not WebAuthn user display names.
+export function createPasskeyStore({ apiBase, csrfToken, storage, request = globalThis.fetch, credentialAPI = globalThis.PublicKeyCredential } = {}) {
+  let keys = [];
+  let rpId;
+  const demo = !apiBase;
+  async function api(path = '', options = {}) {
+    const response = await request(`${apiBase}${path}`, {
+      ...options, credentials: 'same-origin', headers: {
+        'Content-Type': 'application/json', ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {})
+      }
+    });
+    if (!response.ok) throw new Error(response.status === 401 ? 'Your session has expired. Sign in again to manage passkeys.' : 'We couldn’t save that change. Please try again.');
+    return response.status === 204 ? null : response.json();
+  }
+  function persist(next) {
+    // Save first so a storage failure never appears as a successful mutation.
+    storage?.setItem(STORAGE_KEY, JSON.stringify(next));
+    keys = next;
+  }
+  return {
+    demo,
+    get keys() { return keys.map(key => ({ ...key })); },
+    async load() {
+      if (demo) {
+        let saved;
+        try { saved = JSON.parse(storage?.getItem(STORAGE_KEY) ?? 'null'); } catch { /* Reset malformed or inaccessible storage. */ }
+        keys = Array.isArray(saved) && saved.every(key => key && typeof key.id === 'string' && typeof key.name === 'string') ? saved : examples.map(key => ({ ...key }));
+      } else {
+        const result = await api();
+        if (!Array.isArray(result.passkeys) || typeof result.rpId !== 'string') throw new Error('Passkeys could not be loaded. Please try again.');
+        keys = result.passkeys;
+        rpId = result.rpId;
+      }
+      return this.keys;
+    },
+    async rename(id, input) {
+      const name = input.trim();
+      if (!name || name.length > 60) throw new Error('Enter a name between 1 and 60 characters.');
+      if (!keys.some(key => key.id === id)) throw new Error('This passkey is no longer available.');
+      if (!demo) await api(`/${encodeURIComponent(id)}`, { method: 'PATCH', body: JSON.stringify({ name }) });
+      const next = keys.map(key => key.id === id ? { ...key, name } : key);
+      if (demo) persist(next); else keys = next;
+    },
+    async remove(id) {
+      const key = keys.find(key => key.id === id);
+      if (!key) throw new Error('This passkey is no longer available.');
+      if (!demo) await api(`/${encodeURIComponent(id)}`, { method: 'DELETE' });
+      const next = keys.filter(key => key.id !== id);
+      if (demo) { persist(next); return 'demo'; }
+      keys = next;
+      if (!key.credentialId || typeof credentialAPI?.signalUnknownCredential !== 'function') return 'unsupported';
+      try {
+        await credentialAPI.signalUnknownCredential({ rpId, credentialId: key.credentialId });
+        return 'signaled';
+      } catch { return 'failed'; }
+    }
+  };
+}
