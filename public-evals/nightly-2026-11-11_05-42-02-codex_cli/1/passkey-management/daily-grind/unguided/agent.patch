+test('invalid names and storage failures leave existing data intact', async () => {
+  const store = createPasskeyStore({ storage: { setItem() { throw new Error('Storage full'); } } });
+  await store.load();
+  await assert.rejects(store.rename('macbook', '  '), /between 1 and 60/);
+  await assert.rejects(store.rename('macbook', 'a'.repeat(61)), /between 1 and 60/);
+  await assert.rejects(store.remove('macbook'), /Storage full/);
