+test('rename persists the trimmed account label without signaling user details', async () => {
+  let sent;
+  const store = createPasskeyStore({ apiBase: '/api/account/passkeys', request: async (_, options) => {
+    if (options.method) { sent = options; return response(204); }
+    return response(200, account);
+  } });
+  await store.load();
+  await store.rename('key/1', '  Home laptop  ');
