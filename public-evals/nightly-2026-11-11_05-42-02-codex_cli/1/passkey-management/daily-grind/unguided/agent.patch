+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPasskeyStore } from '../passkeys.js';
+
+function memoryStorage() {
+  const data = new Map();
+  return { getItem: key => data.get(key) ?? null, setItem: (key, value) => data.set(key, value) };
+}
+const account = { rpId: 'coffee.example', passkeys: [{ id: 'key/1', name: 'Laptop', credentialId: 'Y3JlZGVudGlhbA' }] };
+const response = (status, data) => ({ ok: status >= 200 && status < 300, status, json: async () => structuredClone(data) });
+
+test('demo edits persist across reloads, including an empty list, without authenticator signals', async () => {
+  const storage = memoryStorage();
+  let signals = 0;
+  const options = { storage, credentialAPI: { signalUnknownCredential: () => signals++ } };
+  const store = createPasskeyStore(options);
+  await store.load();
+  await store.rename('macbook', '  Work laptop  ');
+  const reloaded = createPasskeyStore(options);
+  await reloaded.load();
+  assert.equal(reloaded.keys[0].name, 'Work laptop');
+  for (const key of reloaded.keys) assert.equal(await reloaded.remove(key.id), 'demo');
+  await store.load();
+  assert.equal(store.keys.length, 0);
+  assert.equal(signals, 0);
+});
