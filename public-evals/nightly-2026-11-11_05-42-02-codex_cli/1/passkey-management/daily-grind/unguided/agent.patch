+test('deletion signals the exact credential only after server confirmation', async () => {
+  const events = [];
+  const store = createPasskeyStore({ apiBase: '/api/account/passkeys', csrfToken: 'csrf', request: async (url, options) => {
+    if (!options.method) return response(200, account);
+    events.push('deleted');
+    assert.equal(url, '/api/account/passkeys/key%2F1');
+    assert.equal(options.credentials, 'same-origin');
+    assert.equal(options.headers['X-CSRF-Token'], 'csrf');
+    return response(204);
+  }, credentialAPI: { async signalUnknownCredential(value) {
+    events.push('signaled');
+    assert.deepEqual(value, { rpId: account.rpId, credentialId: account.passkeys[0].credentialId });
+  } } });
+  await store.load();
+  assert.equal(await store.remove('key/1'), 'signaled');
+  assert.deepEqual(events, ['deleted', 'signaled']);
+  assert.equal(store.keys.length, 0);
+});
+
+test('failed deletion does not remove or signal a credential', async () => {
+  let signals = 0;
+  const store = createPasskeyStore({ apiBase: '/api/account/passkeys', request: async (_, options) => response(options.method ? 401 : 200, account), credentialAPI: { signalUnknownCredential: () => signals++ } });
+  await store.load();
+  await assert.rejects(store.remove('key/1'), /session has expired/);
+  assert.equal(store.keys.length, 1);
+  assert.equal(signals, 0);
+});
+
+test('unsupported browsers and rejected signals do not undo successful account deletion', async () => {
+  for (const [credentialAPI, expected] of [[{}, 'unsupported'], [{ signalUnknownCredential: async () => { throw new Error('Rejected'); } }, 'failed']]) {
+    const store = createPasskeyStore({ apiBase: '/api/account/passkeys', credentialAPI, request: async (_, options) => response(options.method ? 204 : 200, account) });
+    await store.load();
+    assert.equal(await store.remove('key/1'), expected);
+    assert.equal(store.keys.length, 0);
+  }
+});
