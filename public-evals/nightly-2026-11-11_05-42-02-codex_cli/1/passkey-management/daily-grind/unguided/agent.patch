@@ -0,0 +1,139 @@
+import { createPasskeyStore } from './passkeys.js';
+
+const $ = selector => document.querySelector(selector);
+let storage;
+try { storage = window.localStorage; } catch { /* Mutations report unavailable persistence. */ }
+const config = window.DailyGrindAccount || {};
+const store = createPasskeyStore({ ...config, storage: storage || { setItem() { throw new Error('Browser storage is unavailable. Allow site storage to save your changes.'); } } });
+const list = $('#key-list');
+const dialog = $('#manage-dialog');
+const form = $('#manage-form');
+const input = $('#key-name');
+const confirm = $('#confirm');
+let selected;
+let action;
+let busy = false;
+let toastTimeout;
+
+function icon(name) {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  const use = document.createElementNS(svg.namespaceURI, 'use');
+  use.setAttribute('href', `#${name}`);
+  svg.setAttribute('aria-hidden', 'true');
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function date(value) {
+  if (!value) return 'Not used yet';
+  const parsed = new Date(value);
+  return Number.isNaN(parsed.getTime()) ? 'Unknown date' : new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(parsed);
+}
+function toast(message) {
+  clearTimeout(toastTimeout);
+  $('#toast').textContent = message;
+  toastTimeout = setTimeout(() => { $('#toast').textContent = ''; }, 9000);
+}
+function render() {
+  list.replaceChildren();
+  $('#key-count').textContent = store.keys.length;
+  if (!store.keys.length) {
+    const empty = element('div', 'empty');
+    empty.append(icon('key'), element('h3', '', 'No passkeys registered'), element('p', '', 'Your registered passkeys will appear here.'));
+    list.append(empty);
+  }
+  for (const key of store.keys) {
+    const row = element('article', 'key-row');
+    const device = element('div', 'device-icon');
+    device.append(icon(key.icon === 'phone' ? 'phone' : 'laptop'));
+    const info = element('div', 'key-info');
+    const name = element('div', 'key-name');
+    name.append(element('h3', '', key.name));
+    if (key.current) name.append(element('span', 'current', 'This device'));
+    const provider = element('p', '', key.provider || 'Passkey provider');
+    const dates = element('p', '', `Added ${date(key.createdAt)}`);
+    dates.append(element('span', '', '·'), document.createTextNode(`Last used ${date(key.lastUsedAt)}`));
+    info.append(name, provider, dates);
+    const actions = element('div', 'key-actions');
+    for (const type of ['rename', 'delete']) {
+      const button = element('button', `icon-button ${type === 'delete' ? 'danger' : ''}`);
+      button.type = 'button';
+      button.setAttribute('aria-label', `${type === 'rename' ? 'Rename' : 'Delete'} ${key.name}`);
+      button.title = `${type === 'rename' ? 'Rename' : 'Delete'} passkey`;
+      button.append(icon(type === 'rename' ? 'edit' : 'trash'));
+      button.addEventListener('click', () => openDialog(key, type));
+      actions.append(button);
+    }
+    row.append(device, info, actions);
+    list.append(row);
+  }
+}
+function openDialog(key, type) {
+  selected = key;
+  action = type;
+  const deleting = type === 'delete';
+  $('#dialog-title').textContent = deleting ? 'Remove this passkey?' : 'Rename your passkey';
+  $('#dialog-description').textContent = deleting ? `“${key.name}” will no longer be available to sign in to your Daily Grind account.${store.demo ? ' This only removes the example in this demo.' : ''}` : 'Make this passkey a little easier to recognize.';
+  $('#rename-field').classList.toggle('hidden', deleting);
+  input.disabled = deleting;
+  input.value = key.name;
+  $('#delete-warning').classList.toggle('hidden', !deleting);
+  $('#delete-warning').textContent = store.keys.length === 1 ? 'This is your last passkey. Make sure you have another way to sign in before removing it.' : key.current ? 'This is the passkey for your current device. Your current session will stay signed in.' : 'This action can’t be undone. You can register a new passkey on this device later.';
+  $('#form-error').textContent = '';
+  confirm.textContent = deleting ? 'Remove passkey' : 'Save name';
+  confirm.className = `button ${deleting ? 'destructive' : 'primary'}`;
+  dialog.showModal();
+  (deleting ? $('#cancel') : input).focus();
+  if (!deleting) input.select();
+}
+$('#cancel').addEventListener('click', () => { if (!busy) dialog.close(); });
+dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  busy = true;
+  confirm.disabled = true;
+  $('#cancel').disabled = true;
+  $('#form-error').textContent = '';
+  try {
+    let message;
+    if (action === 'rename') {
+      await store.rename(selected.id, input.value);
+      message = 'Passkey name updated.';
+    } else {
+      const sync = await store.remove(selected.id);
+      message = sync === 'demo' ? 'Example passkey removed. Your real passkeys haven’t changed.' : sync === 'signaled' ? 'Passkey removed. Your browser was notified to update its saved credentials.' : 'Passkey removed from your account. Remove the saved entry in your device’s password manager, too.';
+    }
+    dialog.close();
+    render();
+    list.querySelector('button')?.focus();
+    toast(message);
+  } catch (error) { $('#form-error').textContent = error.message || 'Something went wrong. Please try again.'; }
+  finally { busy = false; confirm.disabled = false; $('#cancel').disabled = false; }
+});
+$('#help-link').addEventListener('click', event => { event.preventDefault(); $('#help-dialog').showModal(); });
+$('#close-help').addEventListener('click', () => $('#help-dialog').close());
+if (!store.demo) {
+  $('#mode-label').textContent = 'Your account';
+  $('#sync-message').textContent = 'When you remove a passkey, we notify supported browsers to keep your authenticator up to date. Other browsers may require manual removal.';
+  $('#help-dialog p:last-of-type').remove();
+}
+async function load() {
+  list.textContent = 'Loading your passkeys…';
+  list.setAttribute('aria-busy', 'true');
+  try { await store.load(); render(); }
+  catch (error) {
+    $('#key-count').textContent = '—';
+    const failure = element('div', 'empty', error.message || 'Passkeys could not be loaded.');
+    const retry = element('button', 'button', 'Try again');
+    retry.addEventListener('click', load);
+    failure.append(document.createElement('br'), retry);
+    list.replaceChildren(failure);
+  } finally { list.setAttribute('aria-busy', 'false'); }
+}
+load();
