--- /dev/null
+++ b/passkey-store.mjs
@@ -0,0 +1,84 @@
+const STORAGE_KEY = 'daily-grind-passkeys-v1';
+const seed = {
+  // Demo credentials are display data only and must never reach the Signal API.
+  demo: true,
+  rpId: null,
+  userId: 'amFtaWUtZGF2aXM',
+  user: { displayName: 'Jamie Davis' },
+  credentials: [
+    { id: 'bWFjYm9vay1wcm8', name: 'MacBook Pro', provider: 'iCloud Keychain', device: 'laptop', current: true, registeredAt: Date.UTC(2026, 9, 12), lastUsedAt: Date.UTC(2026, 10, 11) },
+    { id: 'aXBob25lLTE1', name: 'iPhone 15', provider: 'iCloud Keychain', device: 'phone', registeredAt: Date.UTC(2026, 9, 12), lastUsedAt: Date.UTC(2026, 10, 10) },
+    { id: 'eXViaWtleS01', name: 'YubiKey 5', provider: 'Security key', device: 'usb', registeredAt: Date.UTC(2026, 9, 18), lastUsedAt: Date.UTC(2026, 10, 4) }
+  ]
+};
+export const validBase64URL = value => typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+export function validateSnapshot(data, demo = false) {
+  if (!data || !Array.isArray(data.credentials) || !validBase64URL(data.userId) || (!demo && (typeof data.rpId !== 'string' || !data.rpId.trim()))) throw new Error('Your passkey details could not be loaded. Please try again.');
+  if (new Set(data.credentials.map(key => key.id)).size !== data.credentials.length || data.credentials.some(key => !validBase64URL(key.id) || typeof key.name !== 'string' || !Number.isFinite(key.registeredAt) || (key.lastUsedAt != null && !Number.isFinite(key.lastUsedAt)))) throw new Error('Your passkey details could not be loaded. Please try again.');
+  return { ...data, demo };
+}
+function cleanName(name) {
+  if (typeof name !== 'string' || !name.trim() || name.trim().length > 50) throw new Error('Enter a name between 1 and 50 characters.');
+  return name.trim();
+}
+export function createDemoStore(storage) {
+  function read() {
+    const saved = storage.getItem(STORAGE_KEY);
+    return validateSnapshot(saved ? JSON.parse(saved) : structuredClone(seed), true);
+  }
+  function mutate(id, update) {
+    const data = read();
+    const index = data.credentials.findIndex(key => key.id === id);
+    if (index < 0) throw new Error('This passkey is no longer available. Reload to see your latest passkeys.');
+    update(data, index);
+    storage.setItem(STORAGE_KEY, JSON.stringify(data));
+    return data;
+  }
+  return {
+    list: async () => read(),
+    rename: async (id, name) => mutate(id, (data, index) => { data.credentials[index].name = cleanName(name); }),
+    remove: async id => mutate(id, (data, index) => { data.credentials.splice(index, 1); }),
+    reset: async () => { storage.removeItem(STORAGE_KEY); return read(); }
+  };
+}
+export function createApiStore(fetcher = fetch) {
+  async function request(path, options = {}) {
+    const response = await fetcher(path, { credentials: 'same-origin', cache: 'no-store', ...options, headers: { Accept: 'application/json', ...options.headers } });
+    if (!response.ok) {
+      if (response.status === 401) throw new Error('Your session has expired. Please sign in again.');
+      throw new Error('We couldn’t save your changes. Please try again.');
+    }
+    return response;
+  }
+  async function list() {
+    const response = await request('/api/credentials');
+    return validateSnapshot(await response.json());
+  }
+  async function refreshAfterMutation() {
+    try { return await list(); }
+    catch { throw new Error('Your change was saved, but the list could not refresh. Reload before making more changes.'); }
+  }
+  return {
+    list,
+    async rename(id, name) {
+      await request(`/api/credential/${encodeURIComponent(id)}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: cleanName(name) }) });
+      return refreshAfterMutation();
+    },
+    async remove(id) {
+      await request(`/api/credential/${encodeURIComponent(id)}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
+      return refreshAfterMutation();
+    }
+  };
+}
+export async function syncAcceptedCredentials(snapshot, authenticator = globalThis.PublicKeyCredential) {
+  if (snapshot.demo) return 'demo';
+  if (!authenticator || typeof authenticator.signalAllAcceptedCredentials !== 'function') return 'unsupported';
+  try {
+    validateSnapshot(snapshot);
+    await authenticator.signalAllAcceptedCredentials({ rpId: snapshot.rpId, userId: snapshot.userId, allAcceptedCredentialIds: snapshot.credentials.map(key => key.id) });
+    return 'sent';
+  } catch (error) {
+    console.warn('Passkey synchronization could not complete:', error);
+    return 'failed';
+  }
+}
