diff --git a/tests/passkeys.test.mjs b/tests/passkeys.test.mjs
new file mode 100644
index 0000000..a794ce6
--- /dev/null
+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,96 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createDemoStore, createApiStore, syncAcceptedCredentials, validBase64URL } from '../passkey-store.mjs';
+
+function memoryStorage() {
+  const values = new Map();
+  return { getItem: key => values.get(key), setItem: (key, value) => values.set(key, value), removeItem: key => values.delete(key) };
+}
+const live = () => ({ rpId: 'dailygrind.example', userId: 'amFtaWU', credentials: [{ id: 'bWFjYm9vaw', name: 'MacBook', registeredAt: 1791763200000 }] });
+
+test('demo edits persist across store instances and deleting the final key stays empty', async () => {
+  const storage = memoryStorage();
+  const store = createDemoStore(storage);
+  const original = await store.list();
+  await store.rename(original.credentials[0].id, '  My work laptop  ');
+  const reloaded = createDemoStore(storage);
+  assert.equal((await reloaded.list()).credentials[0].name, 'My work laptop');
+  for (const key of original.credentials) await reloaded.remove(key.id);
+  assert.deepEqual((await createDemoStore(storage).list()).credentials, []);
+  assert.equal((await store.reset()).credentials.length, 3);
+});
+
+test('invalid names and stale credential IDs do not modify saved data', async () => {
+  const store = createDemoStore(memoryStorage());
+  const before = await store.list();
+  await assert.rejects(store.rename(before.credentials[0].id, '  '));
+  await assert.rejects(store.rename(before.credentials[0].id, 'x'.repeat(51)));
+  await assert.rejects(store.remove('missing'));
+  assert.deepEqual(await store.list(), before);
+});
+
+test('Signal API gets server RP ID and the authoritative remaining list, including an empty list', async () => {
+  const calls = [];
+  const authenticator = { signalAllAcceptedCredentials: async payload => calls.push(payload) };
+  const data = live();
+  assert.equal(await syncAcceptedCredentials(data, authenticator), 'sent');
+  data.credentials = [];
+  await syncAcceptedCredentials(data, authenticator);
+  assert.deepEqual(calls, [
+    { rpId: 'dailygrind.example', userId: 'amFtaWU', allAcceptedCredentialIds: ['bWFjYm9vaw'] },
+    { rpId: 'dailygrind.example', userId: 'amFtaWU', allAcceptedCredentialIds: [] }
+  ]);
+});
+
+test('demo data never signals real authenticators; missing APIs degrade safely', async () => {
+  let calls = 0;
+  assert.equal(await syncAcceptedCredentials(await createDemoStore(memoryStorage()).list(), { signalAllAcceptedCredentials: async () => calls++ }), 'demo');
+  assert.equal(calls, 0);
+  assert.equal(await syncAcceptedCredentials(live(), {}), 'unsupported');
+});
+
+test('malformed IDs are rejected and provider failures are nonfatal', async t => {
+  t.mock.method(console, 'warn', () => {});
+  for (const id of ['', 'a', 'not=padded', 'bad+id', 'bad/id']) assert.equal(validBase64URL(id), false);
+  let calls = 0;
+  const data = live();
+  data.credentials[0].id = 'invalid=value';
+  assert.equal(await syncAcceptedCredentials(data, { signalAllAcceptedCredentials: async () => calls++ }), 'failed');
+  assert.equal(calls, 0);
+  assert.equal(await syncAcceptedCredentials(live(), { signalAllAcceptedCredentials: async () => { throw new Error('Provider unavailable'); } }), 'failed');
+});
+
+test('live deletion uses authenticated requests and reloads before synchronization', async () => {
+  const calls = [];
+  const store = createApiStore(async (path, options) => {
+    calls.push({ path, options });
+    return { ok: true, json: async () => ({ ...live(), credentials: [] }) };
+  });
+  const after = await store.remove('bWFjYm9vaw');
+  assert.equal(calls[0].path, '/api/credential/bWFjYm9vaw');
+  assert.equal(calls[0].options.method, 'DELETE');
+  assert.equal(calls[0].options.credentials, 'same-origin');
+  assert.equal(calls[1].path, '/api/credentials');
+  assert.equal(calls[1].options.cache, 'no-store');
+  assert.equal(after.demo, false);
+  assert.deepEqual(after.credentials, []);
+});
+
+test('failed writes never reload or report a successful mutation', async () => {
+  let calls = 0;
+  const store = createApiStore(async () => { calls++; return { ok: false, status: 401 }; });
+  await assert.rejects(store.remove('bWFjYm9vaw'), /session has expired/);
+  assert.equal(calls, 1);
+});
+
+test('nickname update only submits a label and refreshes the list', async () => {
+  const calls = [];
+  const store = createApiStore(async (path, options) => {
+    calls.push({ path, options });
+    return { ok: true, json: async () => live() };
+  });
+  await store.rename('bWFjYm9vaw', '  Work computer  ');
+  assert.equal(calls[0].options.method, 'PUT');
+  assert.deepEqual(JSON.parse(calls[0].options.body), { name: 'Work computer' });
+  assert.equal(calls[1].path, '/api/credentials');
+});
