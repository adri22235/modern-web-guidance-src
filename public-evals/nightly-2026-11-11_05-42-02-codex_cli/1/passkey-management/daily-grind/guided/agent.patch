@@ -0,0 +1,176 @@
+import { createDemoStore, createApiStore, syncAcceptedCredentials } from './passkey-store.mjs';
+
+const $ = selector => document.querySelector(selector);
+const demo = document.documentElement.dataset.passkeyMode === 'demo';
+// localStorage is accessed lazily so privacy restrictions can be reported in the UI.
+const browserStorage = { getItem: key => localStorage.getItem(key), setItem: (key, value) => localStorage.setItem(key, value), removeItem: key => localStorage.removeItem(key) };
+const store = demo ? createDemoStore(browserStorage) : createApiStore();
+let snapshot;
+let selectedId;
+let toastTimer;
+let busy = false;
+let syncVersion = 0;
+const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+
+function icon(name, className = 'icon') {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('class', className);
+  svg.setAttribute('aria-hidden', 'true');
+  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
+  use.setAttribute('href', `#i-${name}`);
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function notify(message) {
+  clearTimeout(toastTimer);
+  $('#status').textContent = message;
+  $('#status').classList.add('visible');
+  toastTimer = setTimeout(() => $('#status').classList.remove('visible'), 6500);
+}
+function formatDate(timestamp) { return dateFormat.format(new Date(timestamp)); }
+function render() {
+  const list = $('#passkey-list');
+  list.replaceChildren();
+  list.setAttribute('aria-busy', 'false');
+  $('#key-count').textContent = snapshot.credentials.length;
+  if (!snapshot.credentials.length) {
+    const empty = element('div', 'empty-state');
+    empty.append(icon('key'), element('h3', '', 'No passkeys yet'), element('p', '', 'You have no passkeys connected to your account.\nUse another sign-in method to access your account.'));
+    list.append(empty);
+  }
+  for (const key of snapshot.credentials) {
+    const row = element('article', 'passkey-row');
+    const deviceIcon = element('div', 'device-icon');
+    deviceIcon.append(icon(['laptop', 'phone', 'usb'].includes(key.device) ? key.device : 'key'));
+    const content = element('div', 'device-content');
+    const titleLine = element('div', 'device-name-line');
+    titleLine.append(element('h3', '', key.name));
+    if (key.current) titleLine.append(element('span', 'current-badge', 'This device'));
+    const dates = element('div', 'device-dates');
+    dates.append(element('span', '', `Added ${formatDate(key.registeredAt)}`), element('span', 'date-divider', '·'), element('span', '', key.lastUsedAt ? `Last used ${formatDate(key.lastUsedAt)}` : 'Not used yet'));
+    content.append(titleLine, element('p', 'provider', key.provider || 'Unknown passkey provider'), dates);
+    const actions = element('div', 'row-actions');
+    for (const action of ['rename', 'delete']) {
+      const button = element('button', `icon-button ${action}`);
+      button.type = 'button';
+      button.dataset.id = key.id;
+      button.dataset.action = action;
+      button.setAttribute('aria-label', `${action === 'rename' ? 'Rename' : 'Remove'} ${key.name}`);
+      button.title = `${action === 'rename' ? 'Rename' : 'Remove'} passkey`;
+      button.append(icon(action === 'rename' ? 'edit' : 'trash'));
+      actions.append(button);
+    }
+    row.append(deviceIcon, content, actions);
+    list.append(row);
+  }
+}
+function synchronize() {
+  const version = ++syncVersion;
+  if (demo) return;
+  $('#sync-note').textContent = 'Checking browser synchronization…';
+  // Passive provider synchronization must not block saving or closing a dialog.
+  void syncAcceptedCredentials(snapshot).then(result => {
+    if (version !== syncVersion) return;
+    $('#sync-note').textContent = result === 'sent'
+      ? 'Your browser has been notified of your current passkeys.'
+      : 'If an old passkey remains in your password manager, remove it there too.';
+  });
+}
+async function load() {
+  $('#passkey-list').setAttribute('aria-busy', 'true');
+  try {
+    snapshot = await store.list();
+    render();
+    synchronize();
+    if (!demo && snapshot.user?.displayName) {
+      $('.profile strong').textContent = snapshot.user.displayName;
+      $('.avatar').textContent = snapshot.user.displayName.split(/\s+/).slice(0, 2).map(part => part[0]).join('').toUpperCase();
+    }
+  } catch (error) {
+    const list = $('#passkey-list');
+    list.setAttribute('aria-busy', 'false');
+    list.replaceChildren(element('p', 'empty-state', demo ? 'Your saved demo could not be loaded. Allow browser storage or reset the demo below.' : error.message));
+    $('#key-count').textContent = '—';
+    const retry = element('button', 'retry-button', 'Try again');
+    retry.addEventListener('click', load);
+    list.append(retry);
+  }
+}
+$('#passkey-list').addEventListener('click', event => {
+  const button = event.target.closest('button[data-action]');
+  if (!button || busy) return;
+  const key = snapshot.credentials.find(key => key.id === button.dataset.id);
+  if (!key) return;
+  selectedId = key.id;
+  if (button.dataset.action === 'rename') {
+    $('#passkey-name').value = key.name;
+    $('#rename-error').textContent = '';
+    $('#rename-dialog').showModal();
+    $('#passkey-name').select();
+  } else {
+    $('#delete-name').textContent = key.name;
+    $('#delete-error').textContent = '';
+    $('#delete-warning').textContent = snapshot.credentials.length === 1
+      ? 'This is your last passkey. Make sure you have another way to sign in before removing it.'
+      : 'Your other passkeys will still work. You can’t undo this removal.';
+    $('#delete-dialog').showModal();
+  }
+});
+for (const dialog of document.querySelectorAll('dialog')) {
+  dialog.querySelectorAll('[data-close]').forEach(button => button.addEventListener('click', () => { if (!busy) dialog.close(); }));
+  dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+}
+async function mutate(event, action) {
+  event.preventDefault();
+  if (busy) return;
+  const prefix = action === 'rename' ? 'rename' : 'delete';
+  const dialog = $(`#${prefix}-dialog`);
+  const error = $(`#${prefix}-error`);
+  const name = $('#passkey-name').value.trim();
+  if (action === 'rename' && !name) { error.textContent = 'Please enter a name for this passkey.'; $('#passkey-name').focus(); return; }
+  busy = true;
+  error.textContent = '';
+  const controls = [...dialog.querySelectorAll('button,input')];
+  controls.forEach(control => { control.disabled = true; });
+  const submit = dialog.querySelector('[type="submit"]');
+  const originalLabel = submit.textContent;
+  submit.textContent = action === 'rename' ? 'Saving…' : 'Removing…';
+  dialog.setAttribute('aria-busy', 'true');
+  try {
+    snapshot = action === 'rename' ? await store.rename(selectedId, name) : await store.remove(selectedId);
+    dialog.close();
+    render();
+    if (action === 'delete') {
+      $('#passkeys-title').focus();
+      synchronize();
+    } else {
+      [...document.querySelectorAll('[data-action="rename"]')].find(button => button.dataset.id === selectedId)?.focus();
+    }
+    notify(action === 'rename' ? 'Passkey name updated. A little more you.' : 'Passkey removed. Your account is up to date.');
+  } catch (failure) {
+    error.textContent = failure.message || 'Something went wrong. Please try again.';
+  } finally {
+    busy = false;
+    controls.forEach(control => { control.disabled = false; });
+    submit.textContent = originalLabel;
+    dialog.removeAttribute('aria-busy');
+  }
+}
+$('#rename-form').addEventListener('submit', event => mutate(event, 'rename'));
+$('#delete-form').addEventListener('submit', event => mutate(event, 'delete'));
+$('#learn-more').addEventListener('click', () => $('#learn-dialog').showModal());
+if (demo) {
+  $('#demo-note').hidden = false;
+  $('#sync-note').textContent = 'Demo changes stay in this browser and don’t affect real passkeys.';
+  $('#reset-demo').addEventListener('click', async () => {
+    try { snapshot = await store.reset(); render(); notify('Demo passkeys restored.'); }
+    catch { notify('Browser storage is unavailable. Please allow storage to use the demo.'); }
+  });
+}
+void load();
