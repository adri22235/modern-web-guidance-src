+import { useEffect, useState } from "react";
+import { startRegistration } from "@simplewebauthn/browser";
+import {
+  ArrowLeftIcon,
+  ArrowRightOnRectangleIcon,
+  CheckCircleIcon,
+  ComputerDesktopIcon,
+  KeyIcon,
+  LockClosedIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+} from "@heroicons/react/24/outline";
+import { syncPasskeys, type PasskeySnapshot } from "../lib/passkey-sync";
+
+const endpoint = `${import.meta.env.BASE_URL}api/account/passkeys`;
+const button =
+  "inline-flex items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold transition-colors disabled:opacity-50 disabled:cursor-wait focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gray-800";
+
+export default function AccountSettings() {
+  const [account, setAccount] = useState<PasskeySnapshot | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [signedOut, setSignedOut] = useState(false);
+  const [supported, setSupported] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [syncWarning, setSyncWarning] = useState<string | null>(null);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState("");
+  const [removing, setRemoving] = useState<string | null>(null);
+
+  async function request(method = "GET", body?: unknown) {
+    const response = await fetch(endpoint, {
+      method,
+      headers: { "Content-Type": "application/json" },
+      ...(body ? { body: JSON.stringify(body) } : {}),
+    });
+    if (response.status === 401) {
+      setSignedOut(true);
+      setAccount(null);
+      throw new Error("Please sign in to manage your account.");
+    }
+    const data = await response.json();
+    if (!response.ok)
+      throw new Error(data.error || "Something went wrong. Please try again.");
+    return data;
+  }
+  async function accept(data: PasskeySnapshot) {
+    setAccount(data);
+    setSyncWarning(await syncPasskeys(data));
+  }
+  async function load() {
+    setLoading(true);
+    setError("");
+    try {
+      await accept(await request());
+    } catch (error) {
+      setError(
+        error instanceof Error
+          ? error.message
+          : "Unable to load your passkeys.",
+      );
+    } finally {
+      setLoading(false);
+    }
+  }
+  useEffect(() => {
+    setSupported(Boolean(window.PublicKeyCredential && window.isSecureContext));
+    void load();
+  }, []);
+
+  async function mutate(method: string, body: unknown, message: string) {
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      const data = await request(method, body);
+      setEditing(null);
+      setRemoving(null);
+      setNotice(message);
+      await accept(data);
+    } catch (error) {
+      setError(
+        error instanceof Error ? error.message : "Unable to save your changes.",
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function addPasskey() {
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      const optionsJSON = await request("POST", { action: "options" });
+      const credential = await startRegistration({ optionsJSON });
+      const data = await request("POST", { action: "register", credential });
+      await accept(data);
+      setNotice("Passkey added. Give it a name you’ll recognize.");
+      setEditing(data.passkeys[data.passkeys.length - 1].id);
+      setName("New passkey");
+    } catch (error) {
+      setError(
+        error instanceof Error && error.name === "NotAllowedError"
+          ? "Passkey creation was canceled or timed out. You can try again."
+          : error instanceof Error
+            ? error.message
+            : "Unable to add a passkey.",
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function signOut() {
+    setBusy(true);
+    setError("");
+    try {
+      const response = await fetch(
+        `${import.meta.env.BASE_URL}api/account/logout`,
+        { method: "POST" },
+      );
+      if (!response.ok)
+        throw new Error("Unable to sign out. Please try again.");
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    } catch (error) {
+      setError((error as Error).message);
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="mx-auto max-w-5xl px-5 py-10 sm:px-10 sm:py-14">
+      <a
+        href={import.meta.env.BASE_URL}
+        className="mb-7 inline-flex items-center gap-2 text-xs text-gray-500 hover:text-gray-900"
+      >
+        <ArrowLeftIcon className="h-3.5 w-3.5" /> Back to the news
+      </a>
+      <div className="mb-9 flex flex-wrap items-end justify-between gap-4 border-b border-gray-200 pb-7">
+        <div>
+          <p className="mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-500">
+            Your reader account
+          </p>
+          <h1 className="font-brand text-4xl sm:text-5xl">Account settings</h1>
+          <p className="mt-2 text-sm text-gray-500">
+            A little housekeeping. More peace of mind.
+          </p>
+        </div>
+        {account && (
+          <button
+            onClick={signOut}
+            disabled={busy}
+            className={`${button} text-gray-600 hover:bg-gray-100`}
+          >
+            <ArrowRightOnRectangleIcon className="h-4 w-4" /> Sign out
+          </button>
+        )}
+      </div>
+      <div className="grid items-start gap-8 md:grid-cols-[180px_1fr] md:gap-10">
+        <aside>
+          <p className="mb-3 text-[10px] font-bold uppercase tracking-widest text-gray-400">
+            Settings
+          </p>
+          <a
+            href="#security"
+            aria-current="page"
+            className="flex items-center gap-3 rounded-md border border-gray-200 bg-gray-50 px-4 py-3 text-sm font-semibold"
+          >
+            <ShieldCheckIcon className="h-5 w-5" /> Sign-in & security
+          </a>
+          <div className="mt-6 hidden px-1 text-xs leading-5 text-gray-500 md:block">
+            <LockClosedIcon className="mb-2 h-4 w-4" />
+            <p>Your account, under your control.</p>
+          </div>
+        </aside>
+        <div id="security" className="min-w-0">
+          {error && !signedOut && (
+            <div
+              role="alert"
+              className="mb-5 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800"
+            >
+              {error}{" "}
+              {!account && (
+                <button onClick={load} className="ml-2 underline">
+                  Try again
+                </button>
+              )}
+            </div>
+          )}
+          {notice && (
+            <p
+              role="status"
+              className="mb-5 flex items-center gap-2 rounded-md bg-emerald-50 p-4 text-sm text-emerald-800"
+            >
+              <CheckCircleIcon className="h-5 w-5 shrink-0" />
+              {notice}
+            </p>
+          )}
+          {loading ? (
+            <p role="status" className="py-10 text-sm text-gray-500">
+              Loading your account…
+            </p>
+          ) : signedOut ? (
+            <div className="rounded-lg border border-gray-200 p-8">
+              <LockClosedIcon className="mb-4 h-8 w-8" />
+              <h2 className="font-brand text-2xl">Make yourself at home</h2>
+              <p className="mt-2 mb-6 text-sm text-gray-500">
+                Sign in to view and manage your registered passkeys.
+              </p>
+              <a
+                className={`${button} bg-gray-900 text-white hover:bg-gray-700`}
+                href={`${import.meta.env.BASE_URL}signin`}
+              >
+                Sign in to your account
+              </a>
+            </div>
+          ) : (
+            account && (
+              <>
+                <section
+                  className="mb-6 rounded-lg border border-gray-200 p-5 sm:p-6"
+                  aria-labelledby="profile-heading"
+                >
+                  <div className="flex items-start justify-between gap-4">
+                    <div>
+                      <p className="mb-2 text-[10px] font-semibold uppercase tracking-widest text-gray-500">
+                        Signed in as {account.user.name}
+                      </p>
+                      <h2
+                        id="profile-heading"
+                        className="text-base font-semibold"
+                      >
+                        {account.user.displayName}
+                      </h2>
+                      <p className="mt-1 text-xs leading-5 text-gray-500">
+                        Your display name appears in your authenticator.
+                      </p>
+                    </div>
+                    <button
+                      disabled={busy}
+                      onClick={() => {
+                        setEditing("profile");
+                        setName(account.user.displayName);
+                        setRemoving(null);
+                      }}
+                      className={`${button} border border-gray-200 hover:bg-gray-50`}
+                    >
+                      <PencilSquareIcon className="h-4 w-4" />
+                      <span>Edit name</span>
+                    </button>
+                  </div>
+                  {editing === "profile" && renderEditor("profile")}
+                </section>
+                <section
+                  aria-labelledby="passkeys-heading"
+                  className="overflow-hidden rounded-lg border border-gray-200"
+                >
+                  <div className="border-b border-gray-200 p-5 sm:p-6">
+                    <div className="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100">
+                      <KeyIcon className="h-6 w-6 text-gray-700" />
+                    </div>
+                    <div className="flex flex-wrap items-center justify-between gap-4">
+                      <h2 id="passkeys-heading" className="font-brand text-3xl">
+                        Your passkeys{" "}
+                        <span className="ml-2 align-middle font-sans text-xs text-gray-500">
+                          {account.passkeys.length}
+                        </span>
+                      </h2>
+                      <button
+                        onClick={addPasskey}
+                        disabled={busy || !supported}
+                        className={`${button} bg-gray-900 text-white hover:bg-gray-700`}
+                      >
+                        <PlusIcon className="h-4 w-4" />
+                        Add a passkey
+                      </button>
+                    </div>
+                    <p className="mt-3 max-w-lg text-sm leading-6 text-gray-500">
+                      A safer, simpler way to sign in. Manage the passkeys
+                      connected to your DevTools Times account.
+                    </p>
+                  </div>
+                  {!supported && (
+                    <p className="border-b border-gray-200 bg-amber-50 px-6 py-3 text-xs text-amber-900">
+                      To add a passkey, use a browser that supports passkeys
+                      over a secure connection.
+                    </p>
+                  )}
+                  {account.passkeys.length === 0 ? (
+                    <div className="px-6 py-10 text-center">
+                      <KeyIcon className="mx-auto mb-3 h-8 w-8 text-gray-300" />
+                      <h3 className="text-sm font-semibold">No passkeys yet</h3>
+                      <p className="mt-2 text-sm text-gray-500">
+                        Add your first passkey for this account and browser.
+                      </p>
+                    </div>
+                  ) : (
+                    <ul className="divide-y divide-gray-200">
+                      {account.passkeys.map((key) => (
+                        <li key={key.id} className="p-5 sm:p-6">
+                          <div className="flex items-center gap-3">
+                            <div className="hidden h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-50 sm:flex">
+                              <ComputerDesktopIcon className="h-5 w-5 text-gray-500" />
+                            </div>
+                            <div className="min-w-0 flex-1">
+                              <h3 className="break-words text-sm font-semibold">
+                                {key.name}
+                              </h3>
+                              <p className="mt-1 text-xs text-gray-500">
+                                Added{" "}
+                                {new Date(key.createdAt).toLocaleDateString(
+                                  "en-US",
+                                  {
+                                    month: "short",
+                                    day: "numeric",
+                                    year: "numeric",
+                                    timeZone: "UTC",
+                                  },
+                                )}
+                              </p>
+                            </div>
+                            <button
+                              disabled={busy}
+                              aria-label={`Rename ${key.name}`}
+                              onClick={() => {
+                                setEditing(key.id);
+                                setName(key.name);
+                                setRemoving(null);
+                              }}
+                              className={`${button} px-2 text-gray-500 hover:bg-gray-100`}
+                            >
+                              <PencilSquareIcon className="h-4 w-4" />
+                            </button>
+                            <button
+                              disabled={busy}
+                              aria-label={`Remove ${key.name}`}
+                              onClick={() => {
+                                setRemoving(key.id);
+                                setEditing(null);
+                              }}
+                              className={`${button} px-2 text-gray-500 hover:bg-red-50 hover:text-red-700`}
+                            >
+                              <TrashIcon className="h-4 w-4" />
+                            </button>
+                          </div>
+                          {editing === key.id && renderEditor(key.id)}
+                          {removing === key.id && (
+                            <div className="mt-4 rounded-md border border-red-200 bg-red-50 p-4">
+                              <h4 className="text-sm font-semibold text-red-900">
+                                Remove “{key.name}”?
+                              </h4>
+                              <p className="mt-2 text-xs leading-5 text-red-800">
+                                You won’t be able to sign in with this passkey.{" "}
+                                {account.passkeys.length === 1 &&
+                                  "This is your last passkey; you can still sign in with your password. "}
+                                You may also need to remove it from your
+                                password manager.
+                              </p>
+                              <div className="mt-3 flex gap-2">
+                                <button
+                                  disabled={busy}
+                                  onClick={() =>
+                                    mutate(
+                                      "DELETE",
+                                      { id: key.id },
+                                      "Passkey removed from your account.",
+                                    )
+                                  }
+                                  className={`${button} bg-red-700 text-white hover:bg-red-800`}
+                                >
+                                  Remove passkey
+                                </button>
+                                <button
+                                  disabled={busy}
+                                  onClick={() => setRemoving(null)}
+                                  className={`${button} bg-white text-gray-700`}
+                                >
+                                  Keep passkey
+                                </button>
+                              </div>
+                            </div>
+                          )}
+                        </li>
+                      ))}
+                    </ul>
+                  )}
+                  <div className="flex items-start gap-2 border-t border-gray-200 bg-gray-50 px-5 py-4 text-xs leading-5 text-gray-500 sm:px-6">
+                    <ShieldCheckIcon className="mt-0.5 h-4 w-4 shrink-0" />
+                    <p>
+                      Your fingerprint, face, or device PIN stays on your
+                      device. It’s never shared with us.
+                    </p>
+                  </div>
+                </section>
+                {syncWarning && (
+                  <div
+                    role="status"
+                    className="mt-4 rounded-md border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-900"
+                  >
+                    {syncWarning}
+                    <button
+                      disabled={busy}
+                      onClick={load}
+                      className="ml-2 font-semibold underline"
+                    >
+                      Retry sync
+                    </button>
+                  </div>
+                )}
+                <div className="mt-8 border-t border-gray-200 pt-6">
+                  <h3 className="text-sm font-semibold">
+                    A name that makes sense to you
+                  </h3>
+                  <p className="mt-2 text-xs leading-6 text-gray-500">
+                    Use names like “Personal laptop” or “Work security key” to
+                    tell your passkeys apart. These labels are just for your
+                    account. Your authenticator uses the display name above.
+                  </p>
+                </div>
+              </>
+            )
+          )}
+        </div>
+      </div>
+    </div>
+  );
+
+  function renderEditor(id: string) {
+    return (
+      <form
+        className="mt-4"
+        onSubmit={(event) => {
+          event.preventDefault();
+          void mutate(
+            "PATCH",
+            { id, name, ...(id === "profile" ? { action: "profile" } : {}) },
+            id === "profile" ? "Display name updated." : "Passkey renamed.",
+          );
+        }}
+      >
+        <label
+          htmlFor={`name-${id}`}
+          className="mb-2 block text-xs font-semibold"
+        >
+          {id === "profile" ? "Display name" : "Passkey name"}
+        </label>
+        <input
+          autoFocus
+          id={`name-${id}`}
+          value={name}
+          onChange={(event) => setName(event.target.value)}
+          required
+          maxLength={64}
+          disabled={busy}
+          className="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-2 focus:outline-gray-800"
+        />
+        <div className="mt-3 flex gap-2">
+          <button
+            disabled={busy || !name.trim()}
+            className={`${button} bg-gray-900 text-white`}
+          >
+            {busy ? "Saving…" : "Save name"}
+          </button>
+          <button
+            type="button"
+            disabled={busy}
+            onClick={() => setEditing(null)}
+            className={`${button} border border-gray-200`}
+          >
+            Cancel
+          </button>
+        </div>
+      </form>
+    );
+  }
+}
