diff --git a/src/lib/account-store.ts b/src/lib/account-store.ts
new file mode 100644
index 0000000..febb34f
--- /dev/null
+++ b/src/lib/account-store.ts
@@ -0,0 +1,78 @@
+import { createHash, randomBytes } from "node:crypto";
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+export interface Passkey {
+  id: string;
+  name: string;
+  createdAt: string;
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+}
+export interface Account {
+  userId: string;
+  username: string;
+  displayName: string;
+  passkeys: Passkey[];
+}
+// Use a persistent volume for this directory in deployed installations.
+const directory =
+  process.env.ACCOUNT_DATA_DIR || join(process.cwd(), ".data", "accounts");
+const queues = new Map<string, Promise<unknown>>();
+
+export async function withAccount<T>(
+  username: string,
+  rpId: string,
+  update: (account: Account) => T | Promise<T>,
+): Promise<T> {
+  const key = createHash("sha256")
+    .update(JSON.stringify([username, rpId]))
+    .digest("hex");
+  const previous = queues.get(key) || Promise.resolve();
+  const task = previous
+    .catch(() => {})
+    .then(async () => {
+      await mkdir(directory, { recursive: true, mode: 0o700 });
+      const file = join(directory, `${key}.json`);
+      let account: Account;
+      try {
+        account = JSON.parse(await readFile(file, "utf8"));
+      } catch (error) {
+        if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+        account = {
+          userId: randomBytes(32).toString("base64url"),
+          username,
+          displayName: username,
+          passkeys: [],
+        };
+      }
+      const result = await update(account);
+      const temporary = `${file}.${randomBytes(8).toString("hex")}.tmp`;
+      await writeFile(temporary, JSON.stringify(account), { mode: 0o600 });
+      await rename(temporary, file);
+      return result;
+    });
+  queues.set(key, task);
+  try {
+    return await task;
+  } finally {
+    if (queues.get(key) === task) queues.delete(key);
+  }
+}
+
+export function publicAccount(account: Account, rpId: string) {
+  return {
+    user: {
+      id: account.userId,
+      name: account.username,
+      displayName: account.displayName,
+    },
+    rpId,
+    passkeys: account.passkeys.map(({ id, name, createdAt }) => ({
+      id,
+      name,
+      createdAt,
+    })),
+  };
+}
