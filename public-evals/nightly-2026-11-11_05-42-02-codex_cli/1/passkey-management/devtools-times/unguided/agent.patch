+import type { APIRoute } from "astro";
+import { json, sameOrigin } from "../../../lib/http";
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  if (!session) return json({ error: "Sessions are unavailable." }, 503);
+  try {
+    const { username, password } = await request.json();
+    if (
+      typeof username !== "string" ||
+      !username.trim() ||
+      username.length > 256 ||
+      typeof password !== "string" ||
+      !password
+    ) {
+      return json({ error: "Enter your username and password." }, 400);
+    }
+    const response = await fetch(
+      "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login",
+      {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ username, password }),
+        signal: AbortSignal.timeout(15000),
+      },
+    );
+    if (!response.ok)
+      return json(
+        { error: "Unable to sign in. Check your username and password." },
+        response.status === 429 ? 429 : 401,
+      );
+    // Only the identity verified by the upstream password service enters the session.
+    await session.regenerate();
+    session.set("accountUsername", username, { ttl: 86400 });
+    return json({ ok: true });
+  } catch {
+    return json(
+      { error: "Sign in is temporarily unavailable. Please try again." },
+      503,
+    );
+  }
+};
