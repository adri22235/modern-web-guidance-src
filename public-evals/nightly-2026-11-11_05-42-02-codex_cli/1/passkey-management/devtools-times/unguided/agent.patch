--- /dev/null
+++ b/tests/passkey-sync.test.ts
@@ -0,0 +1,86 @@
+import { test, afterEach } from "node:test";
+import assert from "node:assert/strict";
+import { syncPasskeys, type PasskeySnapshot } from "../src/lib/passkey-sync.ts";
+
+const original = Object.getOwnPropertyDescriptor(
+  globalThis,
+  "PublicKeyCredential",
+);
+afterEach(() => {
+  if (original)
+    Object.defineProperty(globalThis, "PublicKeyCredential", original);
+  else Reflect.deleteProperty(globalThis, "PublicKeyCredential");
+});
+const snapshot: PasskeySnapshot = {
+  rpId: "example.com",
+  user: { id: "dXNlcg", name: "reader", displayName: "Reader" },
+  passkeys: [{ id: "a2V5", name: "Laptop", createdAt: "2026-11-11T00:00:00Z" }],
+};
+function api(value: unknown) {
+  Object.defineProperty(globalThis, "PublicKeyCredential", {
+    configurable: true,
+    value,
+  });
+}
+
+test("sends server credential IDs and account details, without confusing key labels with display names", async () => {
+  const calls: unknown[] = [];
+  api({
+    signalAllAcceptedCredentials: async (options: unknown) => {
+      calls.push(options);
+    },
+    signalCurrentUserDetails: async (options: unknown) => {
+      calls.push(options);
+    },
+  });
+  assert.equal(await syncPasskeys(snapshot), null);
+  assert.deepEqual(calls, [
+    {
+      rpId: "example.com",
+      userId: "dXNlcg",
+      allAcceptedCredentialIds: ["a2V5"],
+    },
+    {
+      rpId: "example.com",
+      userId: "dXNlcg",
+      name: "reader",
+      displayName: "Reader",
+    },
+  ]);
+});
+test("signals an empty accepted list when the last key has been removed", async () => {
+  let ids: string[] | undefined;
+  api({
+    signalAllAcceptedCredentials: async (options: {
+      allAcceptedCredentialIds: string[];
+    }) => {
+      ids = options.allAcceptedCredentialIds;
+    },
+    signalCurrentUserDetails: async () => {},
+  });
+  await syncPasskeys({ ...snapshot, passkeys: [] });
+  assert.deepEqual(ids, []);
+});
+test("uses supported signals even when the other API is unavailable", async () => {
+  let called = false;
+  api({
+    signalAllAcceptedCredentials: async () => {
+      called = true;
+    },
+  });
+  assert.match((await syncPasskeys(snapshot))!, /not fully supported/);
+  assert.equal(called, true);
+});
+test("reports sync rejection separately from successful account updates", async () => {
+  api({
+    signalAllAcceptedCredentials: async () => {
+      throw new Error("Unavailable");
+    },
+    signalCurrentUserDetails: async () => {},
+  });
+  assert.match((await syncPasskeys(snapshot))!, /account is saved/);
+});
+test("handles browsers without WebAuthn", async () => {
+  api(undefined);
+  assert.match((await syncPasskeys(snapshot))!, /not fully supported/);
+});
