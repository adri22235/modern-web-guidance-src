new file mode 100644
index 0000000..abbe6fd
--- /dev/null
+++ b/src/pages/api/account/passkey-login.ts
@@ -0,0 +1,88 @@
+import type { APIRoute } from "astro";
+import {
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import { withAccount } from "../../../lib/account-store";
+import { json, sameOrigin } from "../../../lib/http";
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  if (!session) return json({ error: "Sessions are unavailable." }, 503);
+  const origin = new URL(request.url).origin;
+  const rpId = new URL(origin).hostname;
+  try {
+    const body = await request.json();
+    if (body.action === "options") {
+      if (
+        typeof body.username !== "string" ||
+        !body.username.trim() ||
+        body.username.length > 256
+      )
+        return json({ error: "Enter your username first." }, 400);
+      const options = await generateAuthenticationOptions({
+        rpID: rpId,
+        userVerification: "required",
+      });
+      session.set("passkeyLoginChallenge", {
+        username: body.username,
+        challenge: options.challenge,
+        expires: Date.now() + 300000,
+      });
+      return json(options);
+    }
+    if (body.action !== "verify")
+      return json({ error: "Invalid operation." }, 400);
+    const pending = (await session.get("passkeyLoginChallenge")) as
+      { username: string; challenge: string; expires: number } | undefined;
+    session.delete("passkeyLoginChallenge");
+    if (!pending || pending.expires < Date.now())
+      return json({ error: "Sign in expired. Please try again." }, 400);
+    const verified = await withAccount(
+      pending.username,
+      rpId,
+      async (account) => {
+        const key = account.passkeys.find(
+          (key) => key.id === body.credential?.id,
+        );
+        if (!key || body.credential.response?.userHandle !== account.userId)
+          return false;
+        const result = await verifyAuthenticationResponse({
+          response: body.credential,
+          expectedChallenge: pending.challenge,
+          expectedOrigin: origin,
+          expectedRPID: rpId,
+          requireUserVerification: true,
+          credential: {
+            id: key.id,
+            publicKey: new Uint8Array(Buffer.from(key.publicKey, "base64url")),
+            counter: key.counter,
+          },
+        });
+        if (!result.verified) return false;
+        key.counter = result.authenticationInfo.newCounter;
+        return true;
+      },
+    );
+    if (!verified)
+      return json(
+        {
+          error:
+            "This passkey cannot sign in to that account. Use your password or another passkey.",
+        },
+        401,
+      );
+    await session.regenerate();
+    session.set("accountUsername", pending.username, { ttl: 86400 });
+    return json({ ok: true });
+  } catch {
+    return json(
+      {
+        error:
+          "Unable to verify this passkey. Please try again or use your password.",
+      },
+      400,
+    );
+  }
+};
diff --git a/src/pages/api/account/passkeys.ts b/src/pages/api/account/passkeys.ts
new file mode 100644
index 0000000..b3f5c67
--- /dev/null
+++ b/src/pages/api/account/passkeys.ts
@@ -0,0 +1,119 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+} from "@simplewebauthn/server";
+import { publicAccount, withAccount } from "../../../lib/account-store";
+import { json, sameOrigin } from "../../../lib/http";
+
+const handle: APIRoute = async ({ request, session }) => {
+  if (request.method !== "GET" && !sameOrigin(request))
+    return json({ error: "Invalid request origin." }, 403);
+  const username = await session?.get("accountUsername");
+  if (typeof username !== "string")
+    return json({ error: "Please sign in to manage your passkeys." }, 401);
+  const origin = new URL(request.url).origin;
+  const rpId = new URL(origin).hostname;
+  try {
+    const body = request.method === "GET" ? {} : await request.json();
+    return await withAccount(username, rpId, async (account) => {
+      if (request.method === "GET") return json(publicAccount(account, rpId));
+      if (request.method === "POST" && body.action === "options") {
+        const options = await generateRegistrationOptions({
+          rpName: "The DevTools Times",
+          rpID: rpId,
+          userID: new Uint8Array(Buffer.from(account.userId, "base64url")),
+          userName: account.username,
+          userDisplayName: account.displayName,
+          excludeCredentials: account.passkeys.map(({ id, transports }) => ({
+            id,
+            transports,
+          })),
+          authenticatorSelection: {
+            residentKey: "required",
+            userVerification: "required",
+          },
+        });
+        session!.set("passkeyChallenge", {
+          challenge: options.challenge,
+          expires: Date.now() + 300000,
+        });
+        return json(options);
+      }
+      if (request.method === "POST" && body.action === "register") {
+        const pending = (await session!.get("passkeyChallenge")) as
+          { challenge: string; expires: number } | undefined;
+        session!.delete("passkeyChallenge");
+        if (!pending || pending.expires < Date.now())
+          return json(
+            { error: "Registration expired. Please try again." },
+            400,
+          );
+        const result = await verifyRegistrationResponse({
+          response: body.credential,
+          expectedChallenge: pending.challenge,
+          expectedOrigin: origin,
+          expectedRPID: rpId,
+          requireUserVerification: true,
+        });
+        if (!result.verified || !result.registrationInfo)
+          return json({ error: "The passkey could not be verified." }, 400);
+        const { credential } = result.registrationInfo;
+        if (account.passkeys.some((key) => key.id === credential.id))
+          return json({ error: "This passkey is already registered." }, 409);
+        account.passkeys.push({
+          id: credential.id,
+          name: "New passkey",
+          createdAt: new Date().toISOString(),
+          publicKey: Buffer.from(credential.publicKey).toString("base64url"),
+          counter: credential.counter,
+          transports: credential.transports,
+        });
+      } else if (request.method === "PATCH") {
+        if (
+          typeof body.name !== "string" ||
+          !body.name.trim() ||
+          body.name.trim().length > 64
+        )
+          return json(
+            { error: "Use a name between 1 and 64 characters." },
+            400,
+          );
+        if (body.action === "profile") account.displayName = body.name.trim();
+        else {
+          const key = account.passkeys.find((key) => key.id === body.id);
+          if (!key)
+            return json(
+              { error: "This passkey no longer exists. Refresh the list." },
+              404,
+            );
+          key.name = body.name.trim();
+        }
+      } else if (request.method === "DELETE") {
+        if (!account.passkeys.some((key) => key.id === body.id))
+          return json(
+            { error: "This passkey no longer exists. Refresh the list." },
+            404,
+          );
+        account.passkeys = account.passkeys.filter((key) => key.id !== body.id);
+      } else return json({ error: "Invalid operation." }, 400);
+      return json(publicAccount(account, rpId));
+    });
+  } catch (error) {
+    if (error instanceof SyntaxError)
+      return json({ error: "Invalid request." }, 400);
+    return json(
+      {
+        error:
+          request.method === "POST"
+            ? "Unable to register this passkey. Please try again."
+            : "Unable to update your account. Please try again.",
+      },
+      500,
+    );
+  }
+};
+export const GET = handle;
+export const POST = handle;
+export const PATCH = handle;
+export const DELETE = handle;
