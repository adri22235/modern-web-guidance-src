@@ -0,0 +1,68 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+test("persists account changes, isolates readers and RP IDs, and serializes updates", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "times-passkeys-"));
+  process.env.ACCOUNT_DATA_DIR = directory;
+  const { withAccount, publicAccount } =
+    await import("../src/lib/account-store.ts");
+  try {
+    const initial = await withAccount("reader", "example.com", (account) => ({
+      ...account,
+    }));
+    await Promise.all(
+      Array.from({ length: 8 }, (_, index) =>
+        withAccount("reader", "example.com", async (account) => {
+          account.passkeys.push({
+            id: `key-${index}`,
+            name: `Key ${index}`,
+            createdAt: new Date().toISOString(),
+            publicKey: "private-server-data",
+            counter: 0,
+          });
+        }),
+      ),
+    );
+    const saved = await withAccount("reader", "example.com", (account) =>
+      publicAccount(account, "example.com"),
+    );
+    assert.equal(saved.user.id, initial.userId);
+    assert.equal(saved.passkeys.length, 8);
+    assert.equal(JSON.stringify(saved).includes("private-server-data"), false);
+    assert.equal(
+      await withAccount(
+        "other",
+        "example.com",
+        (account) => account.passkeys.length,
+      ),
+      0,
+    );
+    assert.equal(
+      await withAccount(
+        "reader",
+        "other.example.com",
+        (account) => account.passkeys.length,
+      ),
+      0,
+    );
+    await assert.rejects(
+      withAccount("reader", "example.com", (account) => {
+        account.passkeys = [];
+        throw new Error("Rejected");
+      }),
+    );
+    assert.equal(
+      await withAccount(
+        "reader",
+        "example.com",
+        (account) => account.passkeys.length,
+      ),
+      8,
+    );
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+});
diff --git a/tests/http.test.ts b/tests/http.test.ts
