new file mode 100644
index 0000000..2139f14
--- /dev/null
+++ b/src/lib/passkey-sync.ts
@@ -0,0 +1,59 @@
+export interface PasskeySnapshot {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  passkeys: { id: string; name: string; createdAt: string }[];
+}
+
+type SignalAPI = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (options: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+};
+
+// Only call with a complete, server-confirmed snapshot of the signed-in account.
+export async function syncPasskeys(
+  snapshot: PasskeySnapshot,
+): Promise<string | null> {
+  const api = (
+    globalThis as typeof globalThis & { PublicKeyCredential?: SignalAPI }
+  ).PublicKeyCredential;
+  const tasks: Promise<void>[] = [];
+  if (api?.signalAllAcceptedCredentials) {
+    tasks.push(
+      Promise.resolve().then(() =>
+        api.signalAllAcceptedCredentials!({
+          rpId: snapshot.rpId,
+          userId: snapshot.user.id,
+          allAcceptedCredentialIds: snapshot.passkeys.map((key) => key.id),
+        }),
+      ),
+    );
+  }
+  if (api?.signalCurrentUserDetails) {
+    tasks.push(
+      Promise.resolve().then(() =>
+        api.signalCurrentUserDetails!({
+          rpId: snapshot.rpId,
+          userId: snapshot.user.id,
+          name: snapshot.user.name,
+          displayName: snapshot.user.displayName,
+        }),
+      ),
+    );
+  }
+  const results = await Promise.allSettled(tasks);
+  if (results.some((result) => result.status === "rejected")) {
+    return "Your account is saved, but the browser could not update your authenticator. Retry syncing or update your password manager manually.";
+  }
+  return tasks.length < 2
+    ? "Automatic authenticator updates are not fully supported in this browser. You may need to update saved details or remove old passkeys in your password manager."
+    : null;
+}
