+import type { APIRoute } from 'astro';
+import { accountFetch, json, sameOrigin } from '../../../lib/account-server';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Request origin is not allowed.' }, 403);
+  if (!session) return json({ error: 'Sign-in is temporarily unavailable.' }, 503);
+  try {
+    const { username, password } = await request.json();
+    if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || !password) {
+      return json({ error: 'Enter your username and password.' }, 400);
+    }
+    const response = await accountFetch('/login', undefined, {
+      method: 'POST', body: JSON.stringify({ username, password }),
+    });
+    if (!response.ok) return json({ error: 'Sign-in failed. Check your username and password.' }, response.status === 401 ? 401 : 400);
+    const data = await response.json();
+    if (typeof data.token !== 'string' || !data.token) {
+      return json({ error: 'The account service did not return a sign-in token.' }, 502);
+    }
+    await session.regenerate();
+    await session.set('account', { token: data.token, username: username.trim(), expiresAt: Date.now() + 60 * 60 * 1000 });
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Sign-in is unavailable. Please try again.' }, 502);
+  }
+};
