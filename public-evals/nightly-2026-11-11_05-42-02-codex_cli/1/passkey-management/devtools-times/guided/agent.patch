+import type { APIRoute } from 'astro';
+import { getAccount, json, listPasskeys } from '../../../../lib/account-server';
+
+export const GET: APIRoute = async ({ session }) => {
+  const account = await getAccount(session);
+  if (!account) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  try {
+    return json(await listPasskeys(account.token));
+  } catch {
+    return json({ error: 'We could not load your passkeys. Please try again.' }, 502);
+  }
+};
