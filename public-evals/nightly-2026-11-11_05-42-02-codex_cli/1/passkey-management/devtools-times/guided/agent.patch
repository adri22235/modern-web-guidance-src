diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..b1c238e
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,160 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, ShieldCheckIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { isBase64Url, isPasskeyList, type Passkey, type PasskeyList } from '../lib/passkeys';
+import providerRegistry from '../lib/passkey-providers.json';
+
+const providers: Record<string, { name: string; icon_light?: string }> = providerRegistry;
+function providerFor(key: Passkey) {
+  if (!key.aaguid || key.aaguid === '00000000-0000-0000-0000-000000000000') return undefined;
+  return providers[key.aaguid.toLowerCase()];
+}
+
+type SignalAPI = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+};
+
+async function syncPasskeys(data: PasskeyList): Promise<string> {
+  const api = window.PublicKeyCredential as SignalAPI | undefined;
+  if (!api?.signalAllAcceptedCredentials) {
+    return 'Your browser does not support automatic passkey updates. Remove any deleted keys from your password manager too.';
+  }
+  if (!data.rpId || !isBase64Url(data.userId) || !data.credentials.every(key => isBase64Url(key.id))) {
+    console.warn('Passkey synchronization skipped: invalid server identifiers.');
+    return 'Automatic passkey updates are unavailable. You can manage saved keys in your password manager.';
+  }
+  try {
+    await api.signalAllAcceptedCredentials({ rpId: data.rpId, userId: data.userId,
+      allAcceptedCredentialIds: data.credentials.map(key => key.id) });
+    return 'Your browser has been notified of your current passkeys. Other password managers may need a manual update.';
+  } catch (error) {
+    console.warn('Passkey synchronization was unavailable.', error);
+    return 'Your account is up to date. Automatic browser updates were unavailable; check your password manager for removed keys.';
+  }
+}
+
+function dateLabel(value: number | null | undefined) {
+  if (value == null) return 'Not used yet';
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? 'Date unavailable' : date.toLocaleDateString(undefined, {
+    year: 'numeric', month: 'short', day: 'numeric',
+  });
+}
+
+const button = 'inline-flex items-center justify-center gap-2 rounded border border-gray-300 px-3 py-2 text-sm font-medium hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50 disabled:cursor-wait';
+
+export default function PasskeySettings() {
+  const [data, setData] = useState<PasskeyList | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [syncNote, setSyncNote] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [editing, setEditing] = useState<string | null>(null);
+  const [name, setName] = useState('');
+  const [removing, setRemoving] = useState<Passkey | null>(null);
+  const [needsReload, setNeedsReload] = useState(false);
+  const dialog = useRef<HTMLDialogElement>(null);
+  const heading = useRef<HTMLHeadingElement>(null);
+  const trigger = useRef<HTMLButtonElement | null>(null);
+  const endpoint = `${import.meta.env.BASE_URL}api/account/passkeys`;
+
+  async function load(signal?: AbortSignal) {
+    setLoading(true);
+    setError('');
+    try {
+      const response = await fetch(endpoint, { signal, cache: 'no-store' });
+      const result = await response.json();
+      if (!response.ok) throw new Error(result.error || 'Could not load passkeys.');
+      if (!isPasskeyList(result)) throw new Error('The account service returned an invalid passkey list.');
+      if (signal?.aborted) return;
+      setData(result);
+      setNeedsReload(false);
+      setSyncNote(await syncPasskeys(result));
+    } catch (error) {
+      if (!signal?.aborted) setError(error instanceof Error ? error.message : 'Could not load passkeys.');
+    } finally {
+      if (!signal?.aborted) setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    const controller = new AbortController();
+    void load(controller.signal);
+    return () => controller.abort();
+  }, []);
+
+  useEffect(() => {
+    if (removing) dialog.current?.showModal();
+    else dialog.current?.close();
+  }, [removing]);
+
+  async function update(key: Passkey, method: 'PUT' | 'DELETE') {
+    setBusy(true);
+    setError('');
+    setMessage('');
+    try {
+      const response = await fetch(`${endpoint}/${encodeURIComponent(key.id)}`, {
+        method, headers: { 'Content-Type': 'application/json' },
+        ...(method === 'PUT' ? { body: JSON.stringify({ name: name.trim() }) } : {}),
+      });
+      const result = await response.json();
+      if (!response.ok) {
+        if (result.saved) setNeedsReload(true);
+        throw new Error(result.error || 'Could not update passkey.');
+      }
+      if (!isPasskeyList(result)) {
+        setNeedsReload(true);
+        throw new Error('Reload your passkeys to see the latest changes.');
+      }
+      setData(result);
+      setEditing(null);
+      setRemoving(null);
+      setMessage(method === 'DELETE' ? `“${key.name || 'Passkey'}” was removed from your account.` : 'Passkey name updated.');
+      if (method === 'DELETE') {
+        heading.current?.focus();
+        setSyncNote(await syncPasskeys(result));
+      } else {
+        requestAnimationFrame(() => document.getElementById(`rename-${key.id}`)?.focus());
+      }
+    } catch (error) {
+      setError(error instanceof Error ? error.message : 'Could not update passkey.');
+      setRemoving(null);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return <section aria-labelledby="passkeys-title" className="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
+    <div className="border-b border-gray-200 p-6 sm:p-8">
+      <div className="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-gray-100"><KeyIcon aria-hidden="true" className="h-6 w-6" /></div>
+      <h2 id="passkeys-title" ref={heading} tabIndex={-1} className="text-xl font-bold text-gray-900">Passkeys</h2>
+      <p className="mt-2 max-w-2xl text-sm leading-6 text-gray-600">Manage the passkeys you use to sign in to The DevTools Times. Give each a recognizable name, or remove one you no longer use.</p>
+    </div>
+    <div className="px-6 sm:px-8">
+      {message && <p role="status" className="my-4 rounded bg-green-50 p-3 text-sm text-green-800">{message}</p>}
+      {error && <div role="alert" className="my-4 rounded bg-red-50 p-3 text-sm text-red-800"><p>{error}</p><button type="button" className={`${button} mt-3`} disabled={busy || loading} onClick={() => void load()}>Reload passkeys</button></div>}
+      {loading ? <p role="status" className="py-8 text-sm text-gray-600">Loading your passkeys…</p> : data && <>
+        <p className="pt-6 text-xs font-semibold uppercase tracking-wider text-gray-500">{data.credentials.length} registered {data.credentials.length === 1 ? 'passkey' : 'passkeys'}</p>
+        {data.credentials.length === 0 ? <div className="py-10 text-center"><KeyIcon aria-hidden="true" className="mx-auto mb-3 h-8 w-8 text-gray-400" /><h3 className="font-semibold">No passkeys registered</h3><p className="mt-2 text-sm text-gray-600">Passkeys registered to your account will appear here.</p></div> :
+          <ul className="divide-y divide-gray-200">{data.credentials.map(key => <li key={key.id} className="flex flex-col gap-4 py-6 sm:flex-row sm:items-start">
+            <div className="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-gray-50">{providerFor(key)?.icon_light ? <img src={providerFor(key)!.icon_light} alt="" width={24} height={24} /> : <KeyIcon aria-hidden="true" className="h-5 w-5 text-gray-600" />}</div>
+            <div className="min-w-0 flex-1">
+              {editing === key.id ? <form onSubmit={event => { event.preventDefault(); void update(key, 'PUT'); }}>
+                <label htmlFor="passkey-name" className="mb-2 block text-sm font-semibold">Passkey display name</label>
+                <input autoFocus id="passkey-name" value={name} onChange={event => setName(event.target.value)} required maxLength={80} disabled={busy || needsReload} className="w-full rounded border border-gray-400 px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2" />
+                <p className="mt-2 text-xs text-gray-500">This label is used only in your DevTools Times account.</p>
+                <div className="mt-3 flex gap-2"><button className={`${button} bg-gray-900 text-white hover:bg-gray-700`} disabled={busy || needsReload || !name.trim()}>{busy ? 'Saving…' : 'Save name'}</button><button type="button" className={button} disabled={busy} onClick={() => { setEditing(null); requestAnimationFrame(() => document.getElementById(`rename-${key.id}`)?.focus()); }}>Cancel</button></div>
+              </form> : <><h3 className="break-words font-semibold text-gray-900">{key.name || providerFor(key)?.name || 'Passkey'}</h3><p className="mt-1 text-xs text-gray-500">{providerFor(key)?.name || 'Unknown passkey provider'}</p><dl className="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs leading-5 text-gray-500"><div><dt className="inline">Added </dt><dd className="inline">{dateLabel(key.registeredAt)}</dd></div><div><dt className="inline">Last used </dt><dd className="inline">{dateLabel(key.lastUsedAt)}</dd></div></dl></>}
+            </div>
+            {editing !== key.id && <div className="flex gap-2"><button id={`rename-${key.id}`} type="button" className={button} disabled={busy || needsReload} aria-label={`Rename ${key.name || 'passkey'}`} onClick={() => { setEditing(key.id); setName(key.name); }}><PencilSquareIcon aria-hidden="true" className="h-4 w-4" />Rename</button><button type="button" className={`${button} text-red-700`} disabled={busy || needsReload} aria-label={`Remove ${key.name || 'passkey'}`} onClick={event => { trigger.current = event.currentTarget; setRemoving(key); }}><TrashIcon aria-hidden="true" className="h-4 w-4" />Remove</button></div>}
+          </li>)}</ul>}
+      </>}
+    </div>
+    <div className="flex items-start gap-3 border-t border-gray-200 bg-gray-50 px-6 py-5 sm:px-8"><ShieldCheckIcon aria-hidden="true" className="mt-0.5 h-5 w-5 shrink-0 text-gray-500" /><div className="text-xs leading-5 text-gray-600"><p className="font-semibold text-gray-700">Keep your sign-in options up to date</p><p role="status">{syncNote || 'Supported browsers can update your password manager when a passkey is removed.'}</p></div></div>
+    <dialog ref={dialog} aria-labelledby="remove-passkey-title" aria-describedby="remove-passkey-description" onCancel={event => { if (busy) event.preventDefault(); else setRemoving(null); }} onClose={() => { setRemoving(null); if (!trigger.current?.isConnected) heading.current?.focus(); }} className="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xl backdrop:bg-black/40">
+      <h2 id="remove-passkey-title" className="text-xl font-bold">Remove this passkey?</h2>
+      <p id="remove-passkey-description" className="mt-3 break-words text-sm leading-6 text-gray-600">“{removing?.name || 'Passkey'}” will no longer work for signing in. Make sure you can sign in with your password or another passkey.{data?.credentials.length === 1 ? ' This is your last registered passkey.' : ''}</p>
+      <div className="mt-6 flex justify-end gap-3"><button autoFocus type="button" className={button} disabled={busy} onClick={() => setRemoving(null)}>Cancel</button><button type="button" className={`${button} border-red-700 bg-red-700 text-white hover:bg-red-800`} disabled={busy} onClick={() => removing && void update(removing, 'DELETE')}>{busy ? 'Removing…' : 'Remove passkey'}</button></div>
+    </dialog>
+  </section>;
+}
