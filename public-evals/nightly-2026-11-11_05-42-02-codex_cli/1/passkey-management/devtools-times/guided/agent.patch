diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..02bfd76
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,29 @@
+export interface Passkey {
+  id: string;
+  name: string;
+  aaguid?: string;
+  registeredAt: number;
+  lastUsedAt?: number | null;
+}
+
+export interface PasskeyList {
+  rpId: string;
+  userId: string;
+  credentials: Passkey[];
+}
+
+export function isBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 &&
+    value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+export function isPasskeyList(value: unknown): value is PasskeyList {
+  if (!value || typeof value !== 'object') return false;
+  const data = value as PasskeyList;
+  return typeof data.rpId === 'string' && data.rpId.length > 0 &&
+    isBase64Url(data.userId) && Array.isArray(data.credentials) &&
+    data.credentials.every(key => key && isBase64Url(key.id) &&
+      typeof key.name === 'string' && Number.isFinite(key.registeredAt) &&
+      (key.aaguid === undefined || typeof key.aaguid === 'string') &&
+      (key.lastUsedAt == null || Number.isFinite(key.lastUsedAt)));
+}
