+++ b/src/pages/api/account/passkeys/[id].ts
@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { accountFetch, getAccount, json, listPasskeys, sameOrigin } from '../../../../lib/account-server';
+import { isBase64Url } from '../../../../lib/passkeys';
+
+const mutate: APIRoute = async ({ request, session, params }) => {
+  if (!sameOrigin(request)) return json({ error: 'Request origin is not allowed.' }, 403);
+  const account = await getAccount(session);
+  if (!account) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  if (!isBase64Url(params.id)) return json({ error: 'Invalid passkey.' }, 400);
+  let name: string | undefined;
+  if (request.method === 'PUT') {
+    try {
+      const body = await request.json();
+      if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 80) {
+        return json({ error: 'Enter a passkey name between 1 and 80 characters.' }, 400);
+      }
+      name = body.name.trim();
+    } catch {
+      return json({ error: 'Invalid request.' }, 400);
+    }
+  }
+  try {
+    const before = await listPasskeys(account.token);
+    if (!before.credentials.some(key => key.id === params.id)) return json({ error: 'Passkey not found.' }, 404);
+    const response = await accountFetch(`/credential/${encodeURIComponent(params.id)}`, account.token, {
+      method: request.method,
+      ...(name !== undefined ? { body: JSON.stringify({ name }) } : {}),
+    });
+    if (!response.ok) return json({ error: 'Your passkey could not be updated. Please try again.' }, response.status === 404 ? 404 : 502);
+    // Return the authoritative full list, including an empty list after the last deletion.
+    try {
+      return json(await listPasskeys(account.token));
+    } catch {
+      return json({ error: 'Your change was saved, but the list could not be refreshed. Reload before making another change.', saved: true }, 502);
+    }
+  } catch {
+    return json({ error: 'The account service is unavailable. Please try again.' }, 502);
+  }
+};
+
+export const PUT = mutate;
+export const DELETE = mutate;
