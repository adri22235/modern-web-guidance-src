@@ -0,0 +1,42 @@
+import type { APIContext } from 'astro';
+import { isPasskeyList, type PasskeyList } from './passkeys';
+
+// The account service owns authentication, credential storage and ownership checks.
+const accountApi = (import.meta.env.ACCOUNT_API_URL ||
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api').replace(/\/$/, '');
+
+export const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), {
+  status,
+  headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export function sameOrigin(request: Request) {
+  return request.headers.get('origin') === new URL(request.url).origin;
+}
+
+export async function getAccount(session: APIContext['session']) {
+  const account = await session?.get('account');
+  if (!account || account.expiresAt <= Date.now()) return null;
+  return account;
+}
+
+export async function accountFetch(path: string, token?: string, init: RequestInit = {}) {
+  return fetch(`${accountApi}${path}`, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+    signal: AbortSignal.timeout(15000),
+    redirect: 'error',
+  });
+}
+
+export async function listPasskeys(token: string): Promise<PasskeyList> {
+  const response = await accountFetch('/credentials', token);
+  if (!response.ok) throw new Error('Could not load passkeys.');
+  const data: unknown = await response.json();
+  if (!isPasskeyList(data)) throw new Error('Invalid credential response.');
+  // Never expose public keys or other upstream credential internals.
+  return { rpId: data.rpId, userId: data.userId, credentials: data.credentials.map(key => ({
+    id: key.id, name: key.name, aaguid: key.aaguid,
+    registeredAt: key.registeredAt, lastUsedAt: key.lastUsedAt,
+  })) };
+}
