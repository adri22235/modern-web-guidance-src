+  <script>
+    {
+      const trail = document.querySelector('.breadcrumbs ol');
+      const path = window.location.pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '');
+      const segments = path.split('/').filter(Boolean);
+      const labels = {
+        '/menu': 'Menu',
+        '/menu/seasonal': 'Maple Oat Latte',
+        '/menu/espresso': 'Dark Roast Espresso',
+        '/menu/cold-brew': 'Cold Brew',
+        '/locations': 'Locations',
+        '/rewards': 'Rewards',
+        '/account': 'My Account',
+        '/logout': 'Logout',
+        '/order-online': 'Order Online',
+        '/about': 'Our Story',
+        '/careers': 'Join the Team',
+        '/contact': 'Contact Us',
+        '/privacy-policy': 'Privacy'
+      };
+
+      if (segments.length) {
+        trail.querySelector('a').removeAttribute('aria-current');
+      }
+
+      segments.forEach((segment, index) => {
+        const href = '/' + segments.slice(0, index + 1).join('/');
+        const item = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = href;
+        link.textContent = labels[href] || segment.replace(/-/g, ' ').replace(/\b\w/g, letter => letter.toUpperCase());
+        if (index === segments.length - 1) {
+          link.setAttribute('aria-current', 'page');
+        }
+        item.append(link);
+        trail.append(item);
+      });
+    }
+  </script>
 </body>
 
