+  <script src="vendor/html2canvas.min.js"></script>
+  <script>
+    (() => {
+      const card = document.getElementById('export_element');
+      const message = document.getElementById('gift-message');
+      const cardMessage = document.getElementById('gift-card-message');
+      const canvas = document.getElementById('gift-canvas');
+      const exportButton = document.getElementById('gift-export');
+      const status = document.getElementById('gift-status');
+      const customColor = document.getElementById('gift-custom-color');
+      let revision = 0;
+      let renderTimer;
+      let currentRender;
+
+      async function renderCard(version) {
+        try {
+          await document.fonts.ready;
+          if (version !== revision) return;
+          const rendered = await html2canvas(card, { scale: 2, backgroundColor: null, logging: false });
+          if (version !== revision) return;
+          canvas.width = rendered.width;
+          canvas.height = rendered.height;
+          canvas.getContext('2d').drawImage(rendered, 0, 0);
+          canvas.setAttribute('aria-label', 'Gift card: ' + cardMessage.textContent);
+          exportButton.disabled = false;
+          status.textContent = '';
+        } catch (error) {
+          if (version === revision) status.textContent = 'Unable to render your card. Please reload and try again.';
+        }
+      }
+
+      function scheduleRender() {
+        revision++;
+        exportButton.disabled = true;
+        clearTimeout(renderTimer);
+        renderTimer = setTimeout(() => { currentRender = renderCard(revision); }, 150);
+      }
+
+      function setColor(color) {
+        card.style.backgroundColor = color;
+        // Pick readable ink using the relative luminance of the selected background.
+        const channels = color.match(/[a-f\d]{2}/gi).map(value => {
+          const channel = parseInt(value, 16) / 255;
+          return channel <= .04045 ? channel / 12.92 : Math.pow((channel + .055) / 1.055, 2.4);
+        });
+        const luminance = channels[0] * .2126 + channels[1] * .7152 + channels[2] * .0722;
+        card.style.color = luminance > .3 ? '#3e2723' : '#fff8ec';
+        customColor.value = color;
+        scheduleRender();
+      }
+
+      message.addEventListener('input', () => {
+        cardMessage.textContent = message.value || 'A little coffee, just for you.';
+        document.getElementById('gift-count').textContent = message.value.length;
+        scheduleRender();
+      });
+      document.querySelectorAll('input[name="gift-color"]').forEach(input => {
+        input.addEventListener('change', () => setColor(input.value));
+      });
+      customColor.addEventListener('input', () => {
+        document.querySelectorAll('input[name="gift-color"]').forEach(input => { input.checked = input.value === customColor.value; });
+        setColor(customColor.value);
+      });
+      exportButton.addEventListener('click', async () => {
+        exportButton.disabled = true;
+        status.textContent = 'Preparing your download…';
+        const version = revision;
+        try {
+          await currentRender;
+          const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
+          if (!blob) throw new Error('Image export failed');
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-gift-card.png';
+          document.body.appendChild(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 10000);
+          status.textContent = 'Your gift card download is ready.';
+        } catch (error) {
+          status.textContent = 'Unable to download. Please try again.';
+        } finally {
+          if (version === revision) exportButton.disabled = false;
+        }
+      });
+      document.getElementById('gift-count').textContent = message.value.length;
+      new ResizeObserver(scheduleRender).observe(card);
+      scheduleRender();
+    })();
+  </script>
 </body>
 
