+  <script>
+    (() => {
+      // Keep native and fallback policies identical: formatting only, no attributes.
+      const elements = ['p', 'br', 'strong', 'b', 'em', 'i', 'ul', 'ol', 'li', 'blockquote'];
+      let domPurifyPromise;
+
+      function loadDOMPurify() {
+        if (!domPurifyPromise) {
+          domPurifyPromise = new Promise((resolve, reject) => {
+            const script = document.createElement('script');
+            script.src = 'vendor/dompurify/purify.min.js';
+            script.onload = () => {
+              if (window.DOMPurify?.isSupported) resolve(window.DOMPurify);
+              else reject(new Error('Sanitizer unavailable'));
+            };
+            script.onerror = () => {
+              script.remove();
+              reject(new Error('Sanitizer could not load'));
+            };
+            document.head.append(script);
+          }).catch((error) => {
+            domPurifyPromise = undefined;
+            throw error;
+          });
+        }
+        return domPurifyPromise;
+      }
+
+      async function renderReview(container, untrustedHTML) {
+        if ('setHTML' in Element.prototype) {
+          container.setHTML(untrustedHTML, { sanitizer: { elements, attributes: [] } });
+        } else {
+          const DOMPurify = await loadDOMPurify();
+          const fragment = DOMPurify.sanitize(untrustedHTML, {
+            ALLOWED_TAGS: [...elements, '#text'],
+            ALLOWED_ATTR: [],
+            ALLOW_ARIA_ATTR: false,
+            ALLOW_DATA_ATTR: false,
+            KEEP_CONTENT: false,
+            RETURN_DOM_FRAGMENT: true
+          });
+          // Move sanitized nodes directly; never serialize and reparse them.
+          container.replaceChildren(fragment);
+        }
+      }
+
+      document.querySelectorAll('.reviews').forEach((reviews) => {
+        const form = reviews.querySelector('form');
+        const input = form.querySelector('textarea');
+        const button = form.querySelector('button');
+        const status = form.querySelector('[role="status"]');
+
+        input.addEventListener('input', () => {
+          input.setCustomValidity('');
+          input.removeAttribute('aria-invalid');
+        });
+
+        form.addEventListener('submit', async (event) => {
+          event.preventDefault();
+          if (button.disabled || !form.reportValidity()) return;
+          button.disabled = true;
+          status.textContent = 'Posting your review…';
+
+          try {
+            const content = document.createElement('div');
+            content.className = 'review-content';
+            await renderReview(content, input.value);
+
+            if (!content.textContent.trim()) {
+              const message = 'Please add review text using the supported formatting.';
+              input.setCustomValidity(message);
+              input.setAttribute('aria-invalid', 'true');
+              status.textContent = message;
+              input.reportValidity();
+              input.focus();
+              return;
+            }
+
+            const item = document.createElement('li');
+            item.append(content);
+            reviews.querySelector('.review-list').append(item);
+            reviews.querySelector('.review-empty').hidden = true;
+            form.reset();
+            status.textContent = `Your review for ${reviews.dataset.drink} has been posted.`;
+          } catch {
+            // Fail closed: leave the draft intact and never display raw markup.
+            status.textContent = 'Your review could not be posted safely. Please try again.';
+          } finally {
+            button.disabled = false;
+          }
+        });
+
+        // There is no server endpoint; expose the form only after its handler exists.
+        form.hidden = false;
+      });
+    })();
+  </script>
