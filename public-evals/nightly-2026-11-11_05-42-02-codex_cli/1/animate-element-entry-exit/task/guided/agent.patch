+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const promoStatus = document.getElementById('promoStatus');
+    let promoNumber = 0;
+    let exiting = false;
+
+    function updatePromoControls() {
+      const count = domContainer.querySelectorAll('.card:not([hidden])').length;
+      removeBtn.disabled = exiting || count === 0;
+      toggleBtn.disabled = exiting;
+      toggleBtn.setAttribute('aria-pressed', String(toggleCard.isConnected && !toggleCard.hidden));
+      promoStatus.textContent = `${count} ${count === 1 ? 'promo' : 'promos'} available.`;
+    }
+
+    async function hidePromo(card, remove = false) {
+      exiting = true;
+      updatePromoControls();
+      // Keep the card displayed throughout the exit, including in browsers
+      // that parse allow-discrete but cannot transition display.
+      card.dataset.closing = '';
+      card.inert = true;
+      let timeout;
+      try {
+        const animations = card.getAnimations();
+        if (animations.length) {
+          await Promise.race([
+            Promise.allSettled(animations.map(animation => animation.finished)),
+            new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+          ]);
+        }
+        card.hidden = true;
+        if (remove) card.remove();
+      } finally {
+        clearTimeout(timeout);
+        delete card.dataset.closing;
+        card.inert = false;
+        exiting = false;
+        updatePromoControls();
+      }
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${++promoNumber}`;
+      const description = document.createElement('p');
+      description.textContent = 'Take 15% off your next handcrafted drink when you bring a reusable cup.';
+      card.append(heading, description);
+      domContainer.append(card);
+      updatePromoControls();
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not([hidden])');
+      const lastCard = cards[cards.length - 1];
+      if (lastCard && !exiting) hidePromo(lastCard, true);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (exiting) return;
+      if (toggleCard.isConnected && !toggleCard.hidden) {
+        hidePromo(toggleCard);
+      } else {
+        // Restore the featured promo even if it was the last card removed.
+        if (!toggleCard.isConnected) domContainer.prepend(toggleCard);
+        toggleCard.hidden = false;
+        updatePromoControls();
+      }
+    });
+  </script>
