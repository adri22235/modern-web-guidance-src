+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const promoStatus = document.getElementById('promoStatus');
+    const offers = [
+      ['A Perfect Pair', 'Add a freshly baked pastry to any large coffee and save 20% on your pastry.'],
+      ['Bring Your Favorite Cup', 'Bring a reusable cup and enjoy 50¢ off your favorite handcrafted drink.'],
+      ['Beans for the Weekend', 'Pick up a bag of our house blend and enjoy a complimentary drip coffee.']
+    ];
+    let nextPromo = 0;
+    const cardAnimations = new WeakMap();
+
+    function updateControls() {
+      const visibleCards = domContainer.querySelectorAll('.card:not([hidden]):not([data-exiting])');
+      removeBtn.disabled = visibleCards.length === 0;
+      toggleBtn.disabled = toggleCard.hasAttribute('data-exiting');
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show Featured Promo' : 'Hide Featured Promo';
+      promoStatus.textContent = `${visibleCards.length} promo${visibleCards.length === 1 ? '' : 's'} on display.`;
+    }
+
+    async function animateCard(card, entering) {
+      cardAnimations.get(card)?.cancel();
+      if (!card.animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
+      const frames = [
+        { opacity: 0, transform: 'scale(0.92)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      const animation = card.animate(entering ? frames : frames.slice().reverse(), {
+        duration: 260,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+      cardAnimations.set(card, animation);
+      try {
+        await animation.finished;
+      } catch (error) {
+        if (error.name !== 'AbortError') throw error;
+      } finally {
+        // The caller hides or removes the card in the same frame after this resolves.
+        animation.cancel();
+        if (cardAnimations.get(card) === animation) cardAnimations.delete(card);
+      }
+    }
+
+    async function dismissCard(card) {
+      if (card.hasAttribute('data-exiting')) return;
+      card.setAttribute('data-exiting', '');
+      updateControls();
+      await animateCard(card, false);
+      if (card === toggleCard) {
+        card.hidden = true;
+        card.removeAttribute('data-exiting');
+      } else {
+        card.remove();
+      }
+      updateControls();
+    }
+
+    addBtn.addEventListener('click', () => {
+      const [title, description] = offers[nextPromo % offers.length];
+      nextPromo += 1;
+      const card = document.createElement('article');
+      card.className = 'card';
+      const label = document.createElement('span');
+      label.className = 'promo-label';
+      label.textContent = `Coffee perk ${nextPromo}`;
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+      const copy = document.createElement('p');
+      copy.textContent = description;
+      card.append(label, heading, copy);
+      domContainer.append(card);
+      animateCard(card, true);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not([hidden]):not([data-exiting])');
+      const lastCard = cards[cards.length - 1];
+      if (lastCard) dismissCard(lastCard);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (toggleCard.hidden) {
+        toggleCard.hidden = false;
+        animateCard(toggleCard, true);
+        updateControls();
+      } else {
+        dismissCard(toggleCard);
+      }
+    });
+
+    // Animate the initial featured offer as well as subsequently added offers.
+    animateCard(toggleCard, true);
+    updateControls();
+  </script>
 </body>
 
