diff --git a/src/components/ArticleTeaserAction.astro b/src/components/ArticleTeaserAction.astro
new file mode 100644
index 0000000..ed0764d
--- /dev/null
+++ b/src/components/ArticleTeaserAction.astro
@@ -0,0 +1,75 @@
+---
+interface Props {
+    articleId: string;
+    title: string;
+}
+
+const { articleId, title } = Astro.props;
+---
+
+<div class="mt-4 flex flex-wrap items-center gap-3">
+    <span class="teaser-badge">Editor's pick</span>
+    <a
+        class="teaser-action"
+        href={`${import.meta.env.BASE_URL}articles/${articleId}`}
+        aria-label={`Read article: ${title}`}
+    >Read article <span aria-hidden="true">&rarr;</span></a>
+</div>
+
+<style>
+    .teaser-badge {
+        display: var(--teaser-badge-display, none);
+        padding: 0.25rem 0.5rem;
+        border-radius: 0.25rem;
+        background: var(--color-amber-100);
+        color: var(--color-amber-900);
+        font-size: 0.75rem;
+        font-weight: 600;
+    }
+
+    .teaser-action {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        min-block-size: 2.75rem;
+        padding: 0.5rem 0.875rem;
+        border: 1px solid var(--color-amber-800);
+        border-radius: 0.25rem;
+        background: var(--teaser-action-background, transparent);
+        color: var(--teaser-action-color, var(--color-amber-800));
+        font-size: 0.875rem;
+        font-weight: 600;
+    }
+
+    .teaser-action:hover {
+        text-decoration: underline;
+        text-underline-offset: 0.2em;
+    }
+
+    .teaser-action:focus-visible {
+        outline: 2px solid var(--color-amber-800);
+        outline-offset: 3px;
+    }
+
+    @container style(--surface: featured) {
+        .teaser-badge {
+            display: inline-flex;
+        }
+
+        .teaser-action {
+            background: var(--color-amber-800);
+            color: white;
+        }
+    }
+
+    @container style(--surface: standard) {
+        .teaser-badge {
+            display: none;
+        }
+
+        .teaser-action {
+            background: transparent;
+            color: var(--color-amber-800);
+        }
+    }
+</style>
