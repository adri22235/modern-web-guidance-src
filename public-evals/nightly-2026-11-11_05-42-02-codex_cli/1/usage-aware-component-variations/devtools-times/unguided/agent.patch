   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* Section context is inherited by every teaser, including nested components.
+   Standard sections reset the context when nested inside featured sections. */
+section[data-presentation] {
+  --teaser-badge-display: none;
+  --teaser-action-background: transparent;
+  --teaser-action-color: var(--color-amber-800);
+  --teaser-action-hover-background: var(--color-amber-50);
+}
+
+section[data-presentation="featured"] {
+  --teaser-badge-display: inline-flex;
+  --teaser-action-background: var(--color-amber-400);
+  --teaser-action-color: var(--color-gray-900);
+  --teaser-action-hover-background: var(--color-amber-300);
+}
+
+.teaser-badge {
+  display: var(--teaser-badge-display, none);
+  padding: 0.2rem 0.5rem;
+  border-radius: 0.25rem;
+  background: var(--color-amber-100);
+  color: var(--color-amber-900);
+  font-size: 0.75rem;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.teaser-action {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5rem;
+  padding: 0.5rem 0.875rem;
+  border: 1px solid currentColor;
+  border-radius: 0.25rem;
+  background: var(--teaser-action-background, transparent);
+  color: var(--teaser-action-color, var(--color-amber-800));
+  font-size: 0.875rem;
+  font-weight: 600;
+  transition: background-color 150ms ease;
+}
+
+.teaser-action:hover {
+  background: var(--teaser-action-hover-background, var(--color-amber-50));
+}
+
+.teaser-action:focus-visible {
+  outline: 2px solid var(--color-amber-800);
+  outline-offset: 3px;
+}
