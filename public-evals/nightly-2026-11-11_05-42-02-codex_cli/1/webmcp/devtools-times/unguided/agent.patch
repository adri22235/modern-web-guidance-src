diff --git a/src/utils/article-tools.ts b/src/utils/article-tools.ts
new file mode 100644
index 0000000..5fac376
--- /dev/null
+++ b/src/utils/article-tools.ts
@@ -0,0 +1,54 @@
+import { registerBrowserTool } from './browser-tools';
+
+const utilities: Record<string, { name: string; path: string; description: string }> = {
+  'coffee-alchemy': {
+    name: 'brew_coffee', path: 'coffee-brew',
+    description: 'Run this article\'s coffee brewing request. Returns HTTP status and response, including brewing errors.',
+  },
+  'coastal-pulse': {
+    name: 'get_tide_levels', path: 'tide-levels',
+    description: 'Fetch this article\'s tide levels. Returns HTTP status, final URL, redirect information and response.',
+  },
+  'silent-architects': {
+    name: 'get_plant_stats', path: 'plant-stats',
+    description: 'Fetch this article\'s plant statistics using the current browser cookies. Returns HTTP status and response, including header errors.',
+  },
+  'super-bowl-lx': {
+    name: 'get_article_popularity', path: 'article-popularity',
+    description: 'Fetch popularity for an article ID. Returns HTTP status and popularity data.',
+  },
+};
+
+let dispose = () => {};
+function registerArticleTools() {
+  dispose();
+  dispose = () => {};
+  const slug = document.querySelector<HTMLElement>('[data-article-slug]')?.dataset.articleSlug;
+  const utility = slug && utilities[slug];
+  if (!utility) return;
+  const popularity = utility.path === 'article-popularity';
+  dispose = registerBrowserTool({
+    name: utility.name,
+    description: utility.description,
+    inputSchema: {
+      type: 'object',
+      properties: popularity ? { id: { type: 'string', minLength: 1, description: 'Article ID, such as super-bowl-lx.' } } : {},
+      ...(popularity ? { required: ['id'] } : {}),
+      additionalProperties: false,
+    },
+    execute: async ({ id }) => {
+      if (popularity && (typeof id !== 'string' || !id.trim())) throw new Error('An article ID is required.');
+      const url = new URL(`${import.meta.env.BASE_URL}api/${utility.path}`, location.origin);
+      if (popularity) url.searchParams.set('id', id as string);
+      const response = await fetch(url);
+      const text = await response.text();
+      let body: unknown = text;
+      try { body = JSON.parse(text); } catch { /* Redirect targets may return HTML. */ }
+      return JSON.stringify({ ok: response.ok, status: response.status, statusText: response.statusText,
+        redirected: response.redirected, url: response.url, body });
+    },
+  });
+}
+
+document.addEventListener('astro:page-load', registerArticleTools);
+document.addEventListener('astro:before-swap', () => { dispose(); dispose = () => {}; });
diff --git a/src/utils/browser-tools.ts b/src/utils/browser-tools.ts
new file mode 100644
index 0000000..3c63a72
--- /dev/null
+++ b/src/utils/browser-tools.ts
@@ -0,0 +1,50 @@
+import type { FormEvent } from 'react';
+
+export interface BrowserTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: Record<string, unknown>) => Promise<unknown>;
+}
+
+interface ModelContext {
+  registerTool: (tool: BrowserTool) => void | Promise<void>;
+  unregisterTool: (name: string) => void | Promise<void>;
+}
+
+// Support both the current API and browsers using the earlier navigator API.
+export function registerBrowserTool(tool: BrowserTool) {
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context) return () => {};
+  try {
+    const registered = context.registerTool(tool);
+    let disposed = false;
+    void Promise.resolve(registered).catch(error => console.warn(`Could not register browser tool ${tool.name}`, error));
+    return () => {
+      if (disposed) return;
+      disposed = true;
+      try {
+        void Promise.resolve(context.unregisterTool(tool.name)).catch(console.warn);
+      } catch (error) { console.warn(error); }
+    };
+  } catch (error) {
+    console.warn(`Could not register browser tool ${tool.name}`, error);
+    return () => {};
+  }
+}
+
+export function respondToAgent(event: FormEvent<HTMLFormElement>, result: Promise<unknown>) {
+  const native = event.nativeEvent as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<unknown>) => void;
+  };
+  if (native.agentInvoked && native.respondWith) native.respondWith(result);
+  void result.catch(console.error);
+}
+
+export async function getJson(path: string, init?: RequestInit) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, init);
+  if (!response.ok) throw new Error(`Request failed: ${response.status} ${response.statusText}`);
+  return response.json();
+}
