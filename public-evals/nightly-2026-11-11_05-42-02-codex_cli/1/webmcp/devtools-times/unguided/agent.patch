+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+
+async function loadSource(file, transform = source => source) {
+  const source = transform(await readFile(new URL(file, import.meta.url), 'utf8'))
+    .replaceAll('import.meta.env.BASE_URL', '"/devtools-times/"');
+  const js = stripTypeScriptTypes(source, { mode: 'transform' });
+  return import(`data:text/javascript;base64,${Buffer.from(js).toString('base64')}`);
+}
+const helper = await loadSource('../src/utils/browser-tools.ts');
+
+test('unsupported browsers retain normal form submission behavior', () => {
+  globalThis.document = {};
+  assert.doesNotThrow(() => helper.registerBrowserTool({ name: 'test' })());
+  assert.doesNotThrow(() => helper.respondToAgent({ nativeEvent: {} }, Promise.resolve([])));
+});
+
+test('registration and cleanup use the available browser API once', () => {
+  const calls = [];
+  globalThis.document = { modelContext: {
+    registerTool: tool => calls.push(['register', tool.name]),
+    unregisterTool: name => calls.push(['unregister', name]),
+  } };
+  const cleanup = helper.registerBrowserTool({ name: 'test' });
+  cleanup();
+  cleanup();
+  assert.deepEqual(calls, [['register', 'test'], ['unregister', 'test']]);
+});
+
+test('agent form submissions receive the result promise', async () => {
+  let result;
+  helper.respondToAgent({ nativeEvent: { agentInvoked: true, respondWith: value => { result = value; } } }, Promise.resolve(['article']));
+  assert.deepEqual(await result, ['article']);
+});
+
+test('article tools follow navigation and preserve API errors and redirects', async () => {
+  let slug = 'coffee-alchemy';
+  const tools = new Map();
+  const events = new Map();
+  globalThis.document = {
+    modelContext: {
+      registerTool: tool => { assert.equal(tools.has(tool.name), false); tools.set(tool.name, tool); },
+      unregisterTool: name => tools.delete(name),
+    },
+    querySelector: () => slug ? { dataset: { articleSlug: slug } } : null,
+    addEventListener: (name, callback) => events.set(name, callback),
+  };
+  globalThis.location = { origin: 'https://example.com' };
+  globalThis.__registerBrowserTool = helper.registerBrowserTool;
+  await loadSource('../src/utils/article-tools.ts', source => source.replace("import { registerBrowserTool } from './browser-tools';", 'const registerBrowserTool = globalThis.__registerBrowserTool;'));
+  events.get('astro:page-load')();
+  let requested;
+  globalThis.fetch = async url => {
+    requested = String(url);
+    return { ok: false, status: 500, statusText: 'Internal Server Error', redirected: false,
+      url: requested, text: async () => '{"error":"Coffee machine broken"}' };
+  };
+  const failure = JSON.parse(await tools.get('brew_coffee').execute({}));
+  assert.equal(requested, 'https://example.com/devtools-times/api/coffee-brew');
+  assert.equal(failure.status, 500);
+  assert.equal(failure.body.error, 'Coffee machine broken');
+  events.get('astro:before-swap')();
+  assert.equal(tools.size, 0);
+  slug = 'super-bowl-lx';
+  events.get('astro:page-load')();
+  const popularity = tools.get('get_article_popularity');
+  await assert.rejects(popularity.execute({}), /article ID/);
+  await popularity.execute({ id: 'a & b' });
+  assert.equal(new URL(requested).searchParams.get('id'), 'a & b');
+  events.get('astro:before-swap')();
+  slug = 'coastal-pulse';
+  events.get('astro:page-load')();
+  globalThis.fetch = async () => ({ ok: false, status: 404, statusText: 'Not Found', redirected: true,
+    url: 'https://example.com/api/tide-levels-v2', text: async () => '<html>Not found</html>' });
+  const redirect = JSON.parse(await tools.get('get_tide_levels').execute({}));
+  assert.equal(redirect.redirected, true);
+  assert.equal(redirect.body, '<html>Not found</html>');
+  events.get('astro:before-swap')();
