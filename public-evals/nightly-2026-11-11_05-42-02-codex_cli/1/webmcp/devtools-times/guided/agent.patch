diff --git a/tests/browser-tools.test.mjs b/tests/browser-tools.test.mjs
new file mode 100644
index 0000000..051bc23
--- /dev/null
+++ b/tests/browser-tools.test.mjs
@@ -0,0 +1,119 @@
+import assert from 'node:assert/strict';
+import { after, afterEach, test } from 'node:test';
+import { execFileSync } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { pathToFileURL } from 'node:url';
+import { join } from 'node:path';
+
+// Compile only the client modules. No server, DOM implementation, or application
+// entrypoint is started or imported by these checks.
+const directory = mkdtempSync(join(process.cwd(), '.tool-tests-'));
+for (const name of ['browser-tools', 'articles']) {
+  execFileSync('node_modules/.bin/esbuild', [`src/lib/${name}.ts`, '--bundle', '--platform=node', '--format=esm', '--external:react-dom',
+    '--define:import.meta.env.BASE_URL="/devtools-times/"', `--outfile=${directory}/${name}.mjs`], { stdio: 'pipe' });
+}
+after(() => rmSync(directory, { recursive: true, force: true }));
+const { createBrowserTools } = await import(pathToFileURL(join(directory, 'browser-tools.mjs')));
+const { respondToAgent } = await import(pathToFileURL(join(directory, 'articles.mjs')));
+const tools = createBrowserTools();
+const originalFetch = globalThis.fetch;
+afterEach(() => { globalThis.fetch = originalFetch; delete globalThis.window; delete globalThis.document; delete globalThis.location; });
+const options = () => ({ signal: new AbortController().signal });
+const articles = [{ slug: 'coffee', title: 'Coffee science', summary: 'Roast and extraction' }, { slug: 'plants', title: 'Plants', summary: 'Carbon sinks' }];
+const json = value => Response.json(value);
+
+test('search validates inputs before fetching', async () => {
+  globalThis.fetch = () => assert.fail('Unexpected fetch');
+  for (const query of ['', '  ', 42, null]) assert.ok((await tools.search.execute({ query }, options())).error);
+});
+
+test('search matches title and summary, trims input, and uses the site base path', async () => {
+  const context = options();
+  globalThis.fetch = async (url, init) => {
+    assert.equal(url, '/devtools-times/api/articles.json');
+    assert.equal(init.signal, context.signal);
+    return json(articles);
+  };
+  const result = await tools.search.execute({ query: '  EXTRACTION  ' }, context);
+  assert.equal(result.articles[0].url, '/devtools-times/articles/coffee');
+  assert.equal(result.articles.length, 1);
+  assert.deepEqual((await tools.search.execute({ query: 'absent' }, context)).articles, []);
+});
+
+test('reading list returns only the visitor’s saved articles', async () => {
+  globalThis.fetch = async url => json(url.endsWith('articles.json') ? articles : { readingList: ['plants'] });
+  const result = await tools.readingList.execute({}, options());
+  assert.deepEqual(result.articles, [articles[1]]);
+});
+
+test('saving validates arguments and rejects nonexistent articles without posting', async () => {
+  globalThis.fetch = async (_url, init) => { assert.notEqual(init.method, 'POST'); return json(articles); };
+  assert.ok((await tools.save.execute({ slug: 'coffee', saved: 'true' }, options())).error);
+  assert.ok((await tools.save.execute({ slug: 'missing', saved: true }, options())).error);
+});
+
+test('save retries send desired state and publish the returned list for the UI', async () => {
+  globalThis.window = new EventTarget();
+  const updates = [];
+  window.addEventListener('devtools-times:reading-list-changed', event => updates.push(event.detail));
+  const context = options();
+  const bodies = [];
+  globalThis.fetch = async (_url, init) => {
+    assert.equal(init.signal, context.signal);
+    if (init.method !== 'POST') return json(articles);
+    bodies.push(JSON.parse(init.body));
+    return json({ readingList: ['coffee'] });
+  };
+  for (let index = 0; index < 2; index++) await tools.save.execute({ slug: 'coffee', saved: true }, context);
+  assert.deepEqual(bodies, [{ slug: 'coffee', saved: true }, { slug: 'coffee', saved: true }]);
+  assert.deepEqual(updates, [['coffee'], ['coffee']]);
+});
+
+test('HTTP failures are actionable and cancellations stay cancelled', async () => {
+  globalThis.fetch = async () => new Response(null, { status: 500 });
+  assert.match((await tools.search.execute({ query: 'coffee' }, options())).error, /500/);
+  const controller = new AbortController();
+  controller.abort();
+  globalThis.fetch = async (_url, { signal }) => { signal.throwIfAborted(); };
+  await assert.rejects(tools.search.execute({ query: 'coffee' }, { signal: controller.signal }), { name: 'AbortError' });
+});
+
+test('article reading is limited to the article body', () => {
+  globalThis.location = { href: 'https://example.com/devtools-times/articles/coffee' };
+  globalThis.document = { querySelector: () => ({
+    dataset: { articleSlug: 'coffee' },
+    querySelector: selector => selector === 'h1' ? { textContent: ' Coffee science ' } : { innerText: 'Article body only' },
+  }) };
+  assert.deepEqual(tools.read.execute(), { slug: 'coffee', title: 'Coffee science', text: 'Article body only', url: location.href });
+  document.querySelector = () => null;
+  assert.ok(tools.read.execute().error);
+});
+
+test('agent form submissions receive results while ordinary submissions need no WebMCP', async () => {
+  let response;
+  respondToAgent({ agentInvoked: true, respondWith: result => { response = result; } }, Promise.resolve({ articles }));
+  assert.deepEqual(JSON.parse(await response), { articles });
+  assert.doesNotThrow(() => respondToAgent({}, Promise.resolve({})));
+});
+
+test('article utility failures preserve status and response details', async () => {
+  globalThis.fetch = async (url, init) => {
+    assert.equal(url, '/devtools-times/api/coffee-brew');
+    assert.ok(init.signal instanceof AbortSignal);
+    return Response.json({ message: 'Coffee machine is currently broken.' }, { status: 500 });
+  };
+  const result = await tools.coffeeBrew.execute({}, options());
+  assert.equal(result.status, 500);
+  assert.equal(result.ok, false);
+  assert.match(result.data.message, /broken/);
+  assert.ok(result.error);
+});
+
+test('popularity validates identifiers and encodes query parameters', async () => {
+  globalThis.fetch = async url => {
+    assert.equal(url, '/devtools-times/api/article-popularity?id=a%26b');
+    return json({ views: 100 });
+  };
+  assert.ok((await tools.popularity.execute({ id: '' }, options())).error);
+  assert.equal((await tools.popularity.execute({ id: 'a&b' }, options())).data.views, 100);
+});
