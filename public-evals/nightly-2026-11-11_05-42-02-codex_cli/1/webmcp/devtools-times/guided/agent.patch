diff --git a/src/components/BrowserTools.tsx b/src/components/BrowserTools.tsx
new file mode 100644
index 0000000..f5e8476
--- /dev/null
+++ b/src/components/BrowserTools.tsx
@@ -0,0 +1,15 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { createBrowserTools } from '../lib/browser-tools';
+
+export default function BrowserTools({ articleSlug }: { articleSlug?: string }) {
+  const tools = createBrowserTools();
+  useWebMCP(tools.search);
+  useWebMCP(tools.readingList);
+  useWebMCP(tools.save);
+  useWebMCP({ ...tools.read, enabled: Boolean(articleSlug) });
+  useWebMCP({ ...tools.popularity, enabled: Boolean(articleSlug) });
+  useWebMCP({ ...tools.plantStats, enabled: articleSlug === 'silent-architects' });
+  useWebMCP({ ...tools.tideLevels, enabled: articleSlug === 'coastal-pulse' });
+  useWebMCP({ ...tools.coffeeBrew, enabled: articleSlug === 'coffee-alchemy' });
+  return null;
+}
