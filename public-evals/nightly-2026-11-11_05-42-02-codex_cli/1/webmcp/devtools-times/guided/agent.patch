index 0000000..d54e0d3
--- /dev/null
+++ b/src/lib/articles.ts
@@ -0,0 +1,77 @@
+import { flushSync } from 'react-dom';
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export function filterArticles(articles: Article[], query: string): Article[] {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export const readingListChanged = 'devtools-times:reading-list-changed';
+let lastReadingList: string[] | undefined;
+export const getLastReadingList = () => lastReadingList;
+
+async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please try again.`);
+  return response.json();
+}
+
+export const getArticles = (signal?: AbortSignal) => request<Article[]>('articles.json', { signal });
+
+// Article demos intentionally include failing services. Preserve their status
+// and response details so agents can distinguish service failures from success.
+export async function getArticleUtility(endpoint: string, signal: AbortSignal, id?: string) {
+  const query = id === undefined ? '' : `?id=${encodeURIComponent(id)}`;
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${endpoint}${query}`, { signal });
+  const text = await response.text();
+  let data: unknown;
+  try { data = JSON.parse(text); } catch { data = text.slice(0, 1000); }
+  return {
+    ok: response.ok, status: response.status, redirected: response.redirected,
+    url: response.url, data,
+    ...(response.ok ? {} : { error: `Article service failed (${response.status}).` }),
+  };
+}
+export async function getReadingList(signal?: AbortSignal): Promise<string[]> {
+  const data = await request<{ readingList: string[] }>('reading-list.json', { signal });
+  return data.readingList;
+}
+
+// Explicit desired state makes repeated agent submissions safe. Omitting saved
+// preserves the existing toggle behavior used by bookmark buttons.
+export async function saveArticle(slug: string, saved?: boolean, signal?: AbortSignal): Promise<string[]> {
+  if (!slug.trim()) throw new Error('Choose an article slug.');
+  const data = await request<{ readingList: string[] }>('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, saved }),
+    signal,
+  });
+  lastReadingList = data.readingList;
+  flushSync(() => window.dispatchEvent(new CustomEvent(readingListChanged, { detail: data.readingList })));
+  return data.readingList;
+}
+
+// React exposes the underlying SubmitEvent through nativeEvent. Unsupported
+// browsers simply use the same normal form submission handler.
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submission = event as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<string>) => void;
+  };
+  if (submission.agentInvoked && submission.respondWith) {
+    submission.respondWith(result.then(value => JSON.stringify(value)));
+  }
+}
+
+export function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
diff --git a/src/lib/browser-tools.ts b/src/lib/browser-tools.ts
new file mode 100644
index 0000000..1994a64
--- /dev/null
+++ b/src/lib/browser-tools.ts
@@ -0,0 +1,122 @@
+import type { WebMCPOptions } from 'use-webmcp-tool';
+import { errorMessage, filterArticles, getArticles, getArticleUtility, getReadingList, saveArticle } from './articles';
+
+const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+
+function articleUtility(name: string, description: string, endpoint: string) {
+  return {
+    name, description, inputSchema: emptySchema,
+    async execute(_input: Record<string, unknown>, { signal }: { signal: AbortSignal }) {
+      try { return await getArticleUtility(endpoint, signal); }
+      catch (error) {
+        signal.throwIfAborted();
+        return { error: errorMessage(error) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  };
+}
+
+export function createBrowserTools() {
+  return {
+    plantStats: articleUtility('get_plant_stats', 'Retrieve the plant statistics service response for this article.', 'plant-stats'),
+    tideLevels: articleUtility('get_tide_levels', 'Retrieve the coastal article’s tide service response, including redirect details.', 'tide-levels'),
+    coffeeBrew: articleUtility('get_coffee_brew_status', 'Retrieve the coffee article’s brewing service status.', 'coffee-brew'),
+    popularity: {
+      name: 'get_article_popularity',
+      description: 'Retrieve article popularity statistics.',
+      inputSchema: {
+        type: 'object', properties: { id: { type: 'string', minLength: 1, description: 'Article identifier to look up.' } },
+        required: ['id'], additionalProperties: false,
+      },
+      async execute(input, { signal }) {
+        if (typeof input?.id !== 'string' || !input.id.trim()) return { error: 'Provide an article id.' };
+        try { return await getArticleUtility('article-popularity', signal, input.id); }
+        catch (error) {
+          signal.throwIfAborted();
+          return { error: errorMessage(error) };
+        }
+      },
+      annotations: { readOnlyHint: true },
+    } satisfies WebMCPOptions<Record<string, unknown>, unknown>,
+    search: {
+      name: 'search_articles',
+      description: 'Find articles in The DevTools Times by title or summary.',
+      inputSchema: {
+        type: 'object',
+        properties: { query: { type: 'string', minLength: 1, description: 'Words to find in article titles or summaries.' } },
+        required: ['query'], additionalProperties: false,
+      },
+      async execute(input, { signal }) {
+        if (typeof input?.query !== 'string' || !input.query.trim()) return { error: 'Provide a nonempty query.' };
+        try {
+          return { articles: filterArticles(await getArticles(signal), input.query).map(article => ({
+            ...article, url: `${import.meta.env.BASE_URL}articles/${article.slug}`,
+          })) };
+        } catch (error) {
+          signal.throwIfAborted();
+          return { error: errorMessage(error) };
+        }
+      },
+      annotations: { readOnlyHint: true },
+    } satisfies WebMCPOptions<Record<string, unknown>, unknown>,
+
+    readingList: {
+      name: 'get_reading_list',
+      description: 'Retrieve the current visitor’s saved articles.',
+      inputSchema: emptySchema,
+      async execute(_input, { signal }) {
+        try {
+          const [slugs, articles] = await Promise.all([getReadingList(signal), getArticles(signal)]);
+          return { readingList: slugs, articles: articles.filter(article => slugs.includes(article.slug)) };
+        } catch (error) {
+          signal.throwIfAborted();
+          return { error: errorMessage(error) };
+        }
+      },
+      annotations: { readOnlyHint: true },
+    } satisfies WebMCPOptions<Record<string, unknown>, unknown>,
+
+    save: {
+      name: 'set_article_saved',
+      description: 'Save an article to the visitor’s reading list or remove it.',
+      inputSchema: {
+        type: 'object', properties: {
+          slug: { type: 'string', minLength: 1, description: 'Article identifier returned by search_articles.' },
+          saved: { type: 'boolean', description: 'Whether the article should be in the reading list.' },
+        }, required: ['slug', 'saved'], additionalProperties: false,
+      },
+      async execute(input, { signal }) {
+        if (typeof input?.slug !== 'string' || !input.slug.trim() || typeof input.saved !== 'boolean') {
+          return { error: 'Provide an article slug and a saved boolean.' };
+        }
+        try {
+          const articles = await getArticles(signal);
+          if (!articles.some(article => article.slug === input.slug)) return { error: 'Article not found. Use search_articles to find its slug.' };
+          return { readingList: await saveArticle(input.slug, input.saved, signal) };
+        } catch (error) {
+          signal.throwIfAborted();
+          return { error: errorMessage(error) };
+        }
+      },
+      annotations: { readOnlyHint: false },
+    } satisfies WebMCPOptions<Record<string, unknown>, unknown>,
+
+    read: {
+      name: 'read_current_article',
+      description: 'Read the title and full text of the article currently displayed. Open an article from search results first.',
+      inputSchema: emptySchema,
+      execute() {
+        const article = document.querySelector<HTMLElement>('[data-article-slug]');
+        if (!article) return { error: 'Open an article page first.' };
+        return {
+          slug: article.dataset.articleSlug,
+          title: article.querySelector('h1')?.textContent?.trim(),
+          text: article.querySelector<HTMLElement>('[data-article-body]')?.innerText,
+          url: location.href,
+        };
+      },
+      annotations: { readOnlyHint: true },
+    } satisfies WebMCPOptions<Record<string, unknown>, unknown>,
+  };
+}
