+  <script>
+    (() => {
+      const menu = new Map([
+        ['maple-oat-latte', { name: 'Maple Oat Latte', priceCents: 550 }],
+        ['dark-roast-espresso', { name: 'Dark Roast Espresso', priceCents: 300 }],
+        ['cold-brew', { name: 'Cold Brew', priceCents: 450 }],
+      ]);
+      const order = new Map();
+      const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const status = document.getElementById('order-status');
+      const clearButton = document.getElementById('clear-order');
+
+      function getOrder() {
+        const items = Array.from(order, ([coffee, quantity]) => ({
+          coffee, ...menu.get(coffee), quantity,
+          subtotalCents: menu.get(coffee).priceCents * quantity,
+        }));
+        return {
+          items,
+          totalCents: items.reduce((total, item) => total + item.subtotalCents, 0),
+          currency: 'USD',
+          status: 'local_draft',
+        };
+      }
+
+      function renderOrder(message) {
+        const current = getOrder();
+        const rows = current.items.map(item => {
+          const row = document.createElement('li');
+          row.textContent = `${item.quantity} × ${item.name} — ${currency.format(item.subtotalCents / 100)}`;
+          return row;
+        });
+        document.getElementById('order-items').replaceChildren(...rows);
+        document.getElementById('empty-order').hidden = current.items.length > 0;
+        document.getElementById('order-total').textContent = currency.format(current.totalCents / 100);
+        clearButton.disabled = current.items.length === 0;
+        status.textContent = message;
+      }
+
+      // Both the forms and WebMCP tools use these same validated actions.
+      function addCoffee(coffee, input = {}) {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some(key => key !== 'quantity')) {
+          return { error: 'Provide an object containing only an optional quantity.' };
+        }
+        const quantity = input.quantity === undefined ? 1 : input.quantity;
+        if (!menu.has(coffee) || !Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          return { error: 'Quantity must be a whole number from 1 to 10.' };
+        }
+        const nextQuantity = (order.get(coffee) || 0) + quantity;
+        if (nextQuantity > 99) {
+          return { error: 'An order can contain at most 99 of each coffee. Clear the order to start again.' };
+        }
+        order.set(coffee, nextQuantity);
+        renderOrder(`Added ${quantity} × ${menu.get(coffee).name}. Your order total is ${currency.format(getOrder().totalCents / 100)}.`);
+        return getOrder();
+      }
+
+      function clearOrder() {
+        order.clear();
+        renderOrder('Your order has been cleared.');
+        return getOrder();
+      }
+
+      document.querySelectorAll('.order-form').forEach(form => {
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          if (!form.reportValidity()) return;
+          const result = addCoffee(form.dataset.coffee, { quantity: form.elements.quantity.valueAsNumber });
+          if (result.error) status.textContent = result.error;
+        });
+      });
+      clearButton.addEventListener('click', clearOrder);
+
+      // Native browser agents discover these tools through WebMCP on supported
+      // secure contexts. Ordinary ordering works when the API is unavailable.
+      if (document.modelContext?.registerTool) {
+        const tools = Array.from(menu, ([coffee, item]) => ({
+          name: `order_${coffee.replaceAll('-', '_')}`,
+          description: `Add ${item.name} to the visible local draft order. Does not submit an order or take payment.`,
+          inputSchema: {
+            type: 'object',
+            properties: {
+              quantity: {
+                type: 'integer', minimum: 1, maximum: 10, default: 1,
+                description: 'Number of coffees to add.',
+              },
+            },
+            additionalProperties: false,
+          },
+          execute: input => addCoffee(coffee, input),
+          annotations: { readOnlyHint: false, consequentialHint: false },
+        }));
+        tools.push({
+          name: 'get_coffee_order',
+          description: 'Read the current local draft coffee order, quantities, and prices in cents.',
+          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+          execute: getOrder,
+          annotations: { readOnlyHint: true },
+        }, {
+          name: 'clear_coffee_order',
+          description: 'Remove all coffees from the visible local draft order.',
+          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+          execute: clearOrder,
+          annotations: { readOnlyHint: false, consequentialHint: false },
+        });
+        tools.forEach(async tool => {
+          try {
+            await document.modelContext.registerTool(tool);
+          } catch (error) {
+            console.warn(`Could not register WebMCP tool ${tool.name}.`, error);
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
