+  <script>
+    (() => {
+      const menu = {
+        'maple-oat-latte': { name: 'Maple Oat Latte', prices: { regular: 550, large: 650 } },
+        'dark-roast-espresso': { name: 'Dark Roast Espresso', prices: { single: 300, double: 400 } },
+        'cold-brew': { name: 'Cold Brew', prices: { regular: 450, large: 550 } }
+      };
+      const items = [];
+      const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+      const status = document.getElementById('order-status');
+      const snapshot = () => ({
+        currency: 'USD',
+        demo: true,
+        items: items.map(item => ({ ...item, lineTotalCents: item.unitPriceCents * item.quantity })),
+        itemCount: items.reduce((sum, item) => sum + item.quantity, 0),
+        totalCents: items.reduce((sum, item) => sum + item.unitPriceCents * item.quantity, 0)
+      });
+
+      function render(message) {
+        const order = snapshot();
+        const list = document.getElementById('order-items');
+        list.replaceChildren();
+        for (const item of order.items) {
+          const row = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${item.quantity} × ${item.name} (${item.size}) — ${money(item.lineTotalCents)}`;
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'remove-item';
+          remove.textContent = 'Remove';
+          remove.setAttribute('aria-label', `Remove ${item.name}, ${item.size}`);
+          remove.addEventListener('click', () => {
+            removeItem(item.id);
+            document.getElementById('clear-order').focus();
+            if (!items.length) document.querySelector('.order-form button').focus();
+          });
+          row.append(label, remove);
+          list.append(row);
+        }
+        document.getElementById('empty-order').hidden = order.items.length > 0;
+        document.getElementById('order-count').textContent = `(${order.itemCount})`;
+        document.getElementById('order-total').textContent = money(order.totalCents);
+        document.getElementById('clear-order').disabled = !order.items.length;
+        status.textContent = message;
+      }
+
+      // UI and agent tools use the same validated actions and state.
+      function addItem(coffee, input = {}) {
+        if (!input || typeof input !== 'object' || Array.isArray(input)) throw new Error('Provide an object with size and quantity.');
+        if (Object.keys(input).some(key => !['size', 'quantity'].includes(key))) throw new Error('Only size and quantity are accepted.');
+        const product = menu[coffee];
+        const size = input.size === undefined ? Object.keys(product.prices)[0] : input.size;
+        const quantity = input.quantity === undefined ? 1 : input.quantity;
+        if (typeof size !== 'string' || !Object.hasOwn(product.prices, size)) throw new Error(`Choose a size: ${Object.keys(product.prices).join(', ')}.`);
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) throw new Error('Quantity must be a whole number from 1 to 10.');
+        const id = `${coffee}:${size}`;
+        const existing = items.find(item => item.id === id);
+        if (existing && existing.quantity + quantity > 10) throw new Error('You can order at most 10 of each coffee and size.');
+        if (existing) existing.quantity += quantity;
+        else items.push({ id, coffee, name: product.name, size, quantity, unitPriceCents: product.prices[size] });
+        render(`Added ${quantity} × ${product.name} (${size}) to your order.`);
+        return snapshot();
+      }
+
+      function removeItem(id) {
+        const index = items.findIndex(item => item.id === id);
+        if (index === -1) throw new Error('Order item not found. Use get_coffee_order to see item IDs.');
+        const [removed] = items.splice(index, 1);
+        render(`Removed ${removed.name} (${removed.size}) from your order.`);
+        return snapshot();
+      }
+
+      function clearOrder() {
+        items.length = 0;
+        render('Your order has been cleared.');
+        return snapshot();
+      }
+
+      for (const form of document.querySelectorAll('.order-form')) {
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          try {
+            addItem(form.dataset.coffee, { size: form.elements.size.value, quantity: Number(form.elements.quantity.value) });
+          } catch (error) {
+            status.textContent = error.message;
+          }
+        });
+      }
+      document.getElementById('clear-order').addEventListener('click', () => {
+        clearOrder();
+        document.querySelector('.order-form button').focus();
+      });
+
+      const result = (action, allowedKeys = [], requiredKeys = []) => async (input = {}) => {
+        try {
+          if (!input || typeof input !== 'object' || Array.isArray(input)) throw new Error('Tool input must be an object.');
+          if (Object.keys(input).some(key => !allowedKeys.includes(key))) throw new Error(`Accepted fields: ${allowedKeys.join(', ') || 'none'}.`);
+          if (requiredKeys.some(key => typeof input[key] !== 'string' || !input[key])) throw new Error(`Required fields: ${requiredKeys.join(', ')}.`);
+          return { content: [{ type: 'text', text: JSON.stringify(action(input)) }] };
+        } catch (error) {
+          return { isError: true, content: [{ type: 'text', text: error.message }] };
+        }
+      };
+      const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+      const tools = Object.entries(menu).map(([coffee, product]) => ({
+        name: `order_${coffee.replaceAll('-', '_')}`,
+        description: `Add ${product.name} to the on-page demo coffee order. No purchase or payment is made. Prices in USD: ${Object.entries(product.prices).map(([size, price]) => `${size} ${money(price)}`).join(', ')}. Defaults to ${Object.keys(product.prices)[0]} and quantity 1. Maximum 10 per coffee and size in the order. Returns the full order with prices in cents.`,
+        inputSchema: {
+          type: 'object',
+          properties: {
+            size: { type: 'string', enum: Object.keys(product.prices), default: Object.keys(product.prices)[0] },
+            quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1 }
+          },
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: false, destructiveHint: false },
+        execute: result(input => addItem(coffee, input), ['size', 'quantity'])
+      }));
+      tools.push(
+        {
+          name: 'get_coffee_order',
+          description: 'Read the current on-page demo order, item IDs, quantities, and USD totals in cents.',
+          inputSchema: emptySchema,
+          annotations: { readOnlyHint: true },
+          execute: result(snapshot)
+        },
+        {
+          name: 'remove_coffee_order_item',
+          description: 'Remove an entire coffee and size line from the on-page demo order using its ID from get_coffee_order.',
+          inputSchema: { type: 'object', properties: { id: { type: 'string' } }, required: ['id'], additionalProperties: false },
+          annotations: { readOnlyHint: false, destructiveHint: true },
+          execute: result(input => removeItem(input.id), ['id'], ['id'])
+        },
+        {
+          name: 'clear_coffee_order',
+          description: 'Clear all items from the on-page demo coffee order. Returns the empty order.',
+          inputSchema: emptySchema,
+          annotations: { readOnlyHint: false, destructiveHint: true },
+          execute: result(clearOrder)
+        }
+      );
+
+      // Explicit fallback discovery surface for agents with page JavaScript access.
+      // Example: await window.coffeeOrdering.invoke('order_cold_brew', { size: 'large', quantity: 2 })
+      window.coffeeOrdering = Object.freeze({
+        listTools: () => tools.map(({ execute, ...definition }) => structuredClone(definition)),
+        invoke: async (name, input = {}) => {
+          const tool = tools.find(candidate => candidate.name === name);
+          if (!tool) return { isError: true, content: [{ type: 'text', text: `Unknown coffee tool: ${name}` }] };
+          return tool.execute(input);
+        }
+      });
+
+      // Current WebMCP API, with compatibility for earlier browser implementations.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool === 'function') {
+        for (const tool of tools) {
+          try {
+            Promise.resolve(modelContext.registerTool(tool)).catch(error => {
+              console.warn(`Could not register coffee tool ${tool.name}:`, error);
+            });
+          }
+          catch (error) { console.warn(`Could not register coffee tool ${tool.name}:`, error); }
+        }
+      }
+    })();
+  </script>
 </body>
 
