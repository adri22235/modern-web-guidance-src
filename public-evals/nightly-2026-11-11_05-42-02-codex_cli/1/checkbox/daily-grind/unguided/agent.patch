+    .customizations {
+      border: 0;
+      border-top: 1px solid var(--secondary);
+      margin-top: 20px;
+      padding-top: 12px;
+      text-align: left;
+      min-width: 0;
+    }
+
+    .customizations legend {
+      padding-right: 8px;
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: 700;
+      letter-spacing: 0.06em;
+      text-transform: uppercase;
+    }
+
+    .customization {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      padding: 10px 12px;
+      margin-top: 8px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: #faf7f5;
+      cursor: pointer;
+      font-size: 0.9rem;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .customization:hover {
+      border-color: var(--primary);
+    }
+
+    .customization:has(input:checked) {
+      background: #fff1dd;
+      border-color: #97601b;
+    }
+
+    .option-control {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex: 0 0 22px;
+      width: 22px;
+      height: 22px;
+    }
+
+    .option-control input {
+      appearance: none;
+      width: 22px;
+      height: 22px;
+      margin: 0;
+      border: 2px solid #886e64;
+      border-radius: 5px;
+      background: white;
+      cursor: pointer;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .option-control input:checked {
+      background: var(--primary);
+      border-color: var(--primary);
+    }
+
+    .option-control input:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .option-check {
+      position: absolute;
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      pointer-events: none;
+      opacity: 0;
+      transform: scale(0.5) rotate(-15deg);
+      transition: opacity 180ms ease, transform 180ms ease;
+    }
+
+    input:checked + .option-check {
+      opacity: 1;
+      transform: scale(1) rotate(0);
+    }
+
+    .option-icon {
+      width: 20px;
+      height: 20px;
+      margin-left: auto;
+      flex-shrink: 0;
+      fill: none;
+      stroke: #795548;
+      stroke-width: 1.7;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .customization, .option-control input, .option-check {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .option-control input {
+        appearance: auto;
+      }
+
+      .option-check {
+        display: none;
+      }
+
+      .option-control input:focus-visible {
+        outline-color: Highlight;
+      }
+
+      .customization:has(input:checked) {
+        border-color: Highlight;
+      }
+
+      .option-icon {
+        stroke: CanvasText;
+      }
+    }
+
