   </footer>
 
+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menu = document.getElementById('seasonal-menu');
+    const supportsHighlights = typeof CSS !== 'undefined' &&
+      CSS.highlights && typeof Highlight !== 'undefined';
+
+    function collectMenuText() {
+      const nodes = [];
+      for (const card of menu.querySelectorAll('.card')) {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+        while (walker.nextNode()) nodes.push(walker.currentNode);
+      }
+      return nodes;
+    }
+
+    let textNodes = collectMenuText();
+
+    searchInput.addEventListener('input', () => {
+      if (supportsHighlights) {
+        CSS.highlights.delete('menu-search');
+      } else {
+        for (const mark of menu.querySelectorAll('mark.search-match')) {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        }
+        menu.normalize();
+        textNodes = collectMenuText();
+      }
+
+      const term = searchInput.value;
+      if (!term) return;
+
+      // Treat punctuation as literal text, never as a regular expression or HTML.
+      const pattern = new RegExp(term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
+      const ranges = [];
+
+      for (const node of textNodes) {
+        const text = node.textContent;
+        const matches = Array.from(text.matchAll(pattern));
+        if (!matches.length) continue;
+
+        if (supportsHighlights) {
+          for (const match of matches) {
+            const range = document.createRange();
+            range.setStart(node, match.index);
+            range.setEnd(node, match.index + match[0].length);
+            ranges.push(range);
+          }
+        } else {
+          const fragment = document.createDocumentFragment();
+          let offset = 0;
+          for (const match of matches) {
+            fragment.append(text.slice(offset, match.index));
+            const mark = document.createElement('mark');
+            mark.className = 'search-match';
+            mark.textContent = match[0];
+            fragment.append(mark);
+            offset = match.index + match[0].length;
+          }
+          fragment.append(text.slice(offset));
+          node.replaceWith(fragment);
+        }
+      }
+
+      if (supportsHighlights) {
+        CSS.highlights.set('menu-search', new Highlight(...ranges));
+      }
+    });
+  </script>
+
 </body>
 
