+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-time');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // These are a wall-clock time and a calendar date, never timestamps.
+      // Keep the native input strings intact: Date/UTC conversions shift them
+      // when a customer changes time zones or crosses a daylight saving boundary.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupTime === 'string') pickupTime.value = saved.pickupTime;
+          if (typeof saved.coffeeAnniversary === 'string') anniversary.value = saved.coffeeAnniversary;
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can still choose your time and date.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupTime: pickupTime.value,
+            coffeeAnniversary: anniversary.value
+          }));
+          status.textContent = 'Preferences saved. Your time and date stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Please allow browser storage and try again.';
+        }
+      });
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+    })();
+  </script>
+
 </body>
 
