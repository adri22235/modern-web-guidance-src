+  <script>
+    (() => {
+      const form = document.getElementById('coffee-preferences');
+      const pickupTime = document.getElementById('pickup-reminder-time');
+      const anniversaryDate = document.getElementById('coffee-anniversary-date');
+      const status = document.getElementById('preference-status');
+      const storageKey = 'daily-grind.coffee-preferences';
+
+      // These are floating wall-clock/calendar values, never instants.
+      // Keep input.value strings (HH:mm and YYYY-MM-DD) through save/load.
+      // Date, valueAsDate, valueAsNumber and UTC conversions would add zone drift.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminderTime === 'string') {
+            pickupTime.value = saved.pickupReminderTime;
+          }
+          if (typeof saved.coffeeAnniversaryDate === 'string') {
+            anniversaryDate.value = saved.coffeeAnniversaryDate;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can still choose your time and date.';
+      }
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminderTime: pickupTime.value,
+            coffeeAnniversaryDate: anniversaryDate.value,
+          }));
+          status.textContent = 'Preferences saved. Your selected time and date stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved in this browser. Your selections are still shown; please try saving again.';
+        }
+      });
+    })();
+  </script>
