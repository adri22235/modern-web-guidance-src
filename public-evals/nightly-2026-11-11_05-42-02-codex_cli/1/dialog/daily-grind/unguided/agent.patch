+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Espresso with creamy oat milk and a hint of Vermont maple syrup. Served hot.',
+        sizes: ['Small (8 oz)', 'Medium (12 oz)', 'Large (16 oz)'],
+        milk: 'oat'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey dark roast espresso, freshly pulled for a rich morning boost. Served hot.',
+        sizes: ['Single shot', 'Double shot'],
+        milk: 'none'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours for maximum smoothness and a mellow finish. Served over ice.',
+        sizes: ['Small (12 oz)', 'Medium (16 oz)', 'Large (20 oz)'],
+        milk: 'none'
+      }
+    };
+    const dialog = document.querySelector('#order-dialog');
+    const form = document.querySelector('#order-form');
+    const drink = document.querySelector('#drink');
+    const size = document.querySelector('#size');
+    const milk = document.querySelector('#milk');
+    const quantity = document.querySelector('#quantity');
+    const confirmation = document.querySelector('#discard-confirmation');
+    const keepEditing = document.querySelector('#keep-editing');
+    const summary = document.querySelector('#order-summary');
+    let hasChanges = false;
+    let opener;
+    let previousFocus;
+
+    function updateDrink() {
+      const details = drinks[drink.value];
+      document.querySelector('#drink-description').textContent = details.description;
+      size.replaceChildren(...details.sizes.map(label => new Option(label, label)));
+      milk.value = details.milk;
+    }
+
+    function requestClose() {
+      if (!hasChanges) {
+        dialog.close();
+        return;
+      }
+      if (confirmation.hidden) {
+        previousFocus = document.activeElement;
+        confirmation.hidden = false;
+      }
+      keepEditing.focus();
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        form.reset();
+        drink.value = button.dataset.drink;
+        updateDrink();
+        hasChanges = false;
+        confirmation.hidden = true;
+        summary.textContent = '';
+        dialog.showModal();
+      });
+    });
+
+    drink.addEventListener('change', updateDrink);
+    function markChanged() {
+      hasChanges = true;
+      summary.textContent = '';
+    }
+    form.addEventListener('input', markChanged);
+    form.addEventListener('change', markChanged);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      summary.textContent = `${quantity.value} × ${drinks[drink.value].name}, ${size.value}, ${milk.selectedOptions[0].textContent.toLowerCase()}. This is your order preview; no order has been placed.`;
+    });
+    document.querySelector('#close-dialog').addEventListener('click', requestClose);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      requestClose();
+    });
+    // Only an interaction that starts and ends outside the panel closes it.
+    let backdropPointerDown = false;
+    function outsidePanel(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+    dialog.addEventListener('pointerdown', event => {
+      backdropPointerDown = event.target === dialog && outsidePanel(event);
+    });
+    dialog.addEventListener('click', event => {
+      if (backdropPointerDown && event.target === dialog && outsidePanel(event)) requestClose();
+      backdropPointerDown = false;
+    });
+    keepEditing.addEventListener('click', () => {
+      confirmation.hidden = true;
+      previousFocus?.focus();
+    });
+    document.querySelector('#discard-changes').addEventListener('click', () => {
+      hasChanges = false;
+      dialog.close();
+    });
+    dialog.addEventListener('close', () => {
+      opener?.focus();
+    });
+  </script>
