+  <dialog id="order-dialog" class="order-dialog" closedby="any" aria-labelledby="drink-title" aria-describedby="drink-description">
+    <h2 id="drink-title">Maple Oat Latte</h2>
+    <p id="drink-description"></p>
+    <form id="order-options">
+      <label for="drink-choice">Drink</label>
+      <select id="drink-choice" name="drink" autofocus>
+        <option value="maple">Maple Oat Latte</option>
+        <option value="espresso">Dark Roast Espresso</option>
+        <option value="cold-brew">Cold Brew</option>
+      </select>
+      <label for="drink-size">Size</label>
+      <select id="drink-size" name="size">
+        <option value="regular">Regular</option>
+        <option value="large">Large</option>
+      </select>
+      <label for="drink-milk">Milk</label>
+      <select id="drink-milk" name="milk">
+        <option value="oat">Oat milk</option>
+        <option value="whole">Whole milk</option>
+        <option value="none">No milk</option>
+      </select>
+      <label for="drink-quantity">Quantity</label>
+      <input id="drink-quantity" name="quantity" type="number" min="1" max="20" step="1" value="1" required>
+      <label for="drink-notes">Special requests (optional)</label>
+      <textarea id="drink-notes" name="notes" rows="2" maxlength="500"></textarea>
+    </form>
+    <p id="discard-notice" class="discard-notice" role="status">You have changed your order options. To close this dialog, confirm with Discard changes.</p>
+    <div class="dialog-actions">
+      <button type="button" id="discard-changes" class="btn" aria-describedby="discard-notice">Discard changes</button>
+      <button type="button" id="close-dialog" class="btn">Close</button>
+    </div>
+  </dialog>
+
+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Espresso with creamy oat milk and a hint of Vermont maple syrup. Served hot.',
+        milk: 'oat'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey dark roast espresso, freshly pulled for a morning boost. Served hot.',
+        milk: 'none'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coffee steeped for 18 hours for maximum smoothness. Served over ice; add milk to taste.',
+        milk: 'none'
+      }
+    };
+    const dialog = document.getElementById('order-dialog');
+    const form = document.getElementById('order-options');
+    const drinkChoice = document.getElementById('drink-choice');
+    const milkChoice = document.getElementById('drink-milk');
+    const notice = document.getElementById('discard-notice');
+    const discard = document.getElementById('discard-changes');
+    let dirty = false;
+
+    function showDrinkDetails() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-title').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+    }
+
+    function markChanged() {
+      // Changes stay protected even if the user later restores the initial values.
+      dirty = true;
+      dialog.setAttribute('closedby', 'none');
+      notice.classList.add('visible');
+      discard.classList.add('visible');
+    }
+
+    function requestDismiss() {
+      if (dirty) {
+        discard.focus();
+        return;
+      }
+      dialog.close();
+    }
+
+    document.querySelectorAll('[data-drink]').forEach((button) => {
+      button.addEventListener('click', () => {
+        form.reset();
+        dirty = false;
+        notice.classList.remove('visible');
+        discard.classList.remove('visible');
+        dialog.setAttribute('closedby', 'any');
+        drinkChoice.value = button.dataset.drink;
+        milkChoice.value = drinks[drinkChoice.value].milk;
+        showDrinkDetails();
+        dialog.showModal();
+      });
+    });
+
+    form.addEventListener('input', markChanged);
+    form.addEventListener('change', markChanged);
+    // Enter in an order field must not navigate or bypass the discard guard.
+    form.addEventListener('submit', (event) => event.preventDefault());
+    drinkChoice.addEventListener('change', () => {
+      showDrinkDetails();
+      milkChoice.value = drinks[drinkChoice.value].milk;
+    });
+    document.getElementById('close-dialog').addEventListener('click', requestDismiss);
+    dialog.addEventListener('cancel', (event) => {
+      // Also protects browsers that do not support closedby="none".
+      if (dirty) {
+        event.preventDefault();
+        requestDismiss();
+      }
+    });
+    discard.addEventListener('click', () => {
+      if (!dirty) return;
+      form.reset();
+      dirty = false;
+      dialog.close();
+    });
+
+    // Supply light dismissal only where closedby is unavailable. Require both
+    // ends of the gesture outside so a text-selection drag cannot dismiss it.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (event) => {
+        const rect = dialog.getBoundingClientRect();
+        return event.clientX < rect.left || event.clientX > rect.right ||
+          event.clientY < rect.top || event.clientY > rect.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (event) => {
+        pressedOutside = outside(event);
+      });
+      dialog.addEventListener('pointerup', (event) => {
+        if (pressedOutside && outside(event)) requestDismiss();
+        pressedOutside = false;
+      });
+      dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+    }
+  </script>
+
 </body>
 
 </html>
