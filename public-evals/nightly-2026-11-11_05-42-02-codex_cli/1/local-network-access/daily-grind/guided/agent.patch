diff --git a/tests/connections.test.mjs b/tests/connections.test.mjs
new file mode 100644
index 0000000..7d83474
--- /dev/null
+++ b/tests/connections.test.mjs
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { validateEndpoint, queryPermission, checkEndpoint } from '../connections.mjs';
+
+test('LAN card accepts private networks and rejects public or loopback targets', () => {
+  for (const host of ['192.168.1.100', '10.1.2.3', '172.16.0.1', '172.31.255.254', '169.254.1.1', 'brewer.local', '[fd00::1]', '[fe80::1]']) {
+    assert.equal(validateEndpoint(`http://${host}:8080/api/status`, 'local'), `http://${host}:8080/api/status`);
+  }
+  for (const host of ['example.com', '8.8.8.8', '172.15.0.1', '172.32.0.1', '192.169.1.1', '127.0.0.1', 'localhost', '[::1]', '[2001:4860::1]']) {
+    assert.throws(() => validateEndpoint(`http://${host}/status`, 'local'), /private LAN/);
+  }
+});
+
+test('helper card is restricted to this computer', () => {
+  for (const host of ['127.0.0.1', '127.1.2.3', 'localhost', 'app.localhost', '[::1]']) {
+    assert.equal(validateEndpoint(`http://${host}:45678/health`, 'loopback'), `http://${host}:45678/health`);
+  }
+  for (const host of ['192.168.1.100', 'brewer.local', 'example.com', 'localhost.example.com']) {
+    assert.throws(() => validateEndpoint(`https://${host}/health`, 'loopback'), /loopback address/);
+  }
+});
+
+test('URL validation rejects credentials, non-HTTP protocols, fragments and malformed values', () => {
+  for (const value of ['not a URL', 'ftp://192.168.1.100/status', 'http://user:secret@192.168.1.100/status', 'http://192.168.1.100/status#fragment', 'http://999.999.999.999']) {
+    assert.throws(() => validateEndpoint(value, 'local'));
+  }
+});
+
+test('each request declares its address space and requires a readable successful response', async (t) => {
+  const calls = [];
+  const fetchMock = t.mock.method(globalThis, 'fetch', async (url, options) => {
+    calls.push({ url, options });
+    return new Response(null, { status: 204 });
+  });
+  const controller = new AbortController();
+  for (const space of ['local', 'loopback']) {
+    await checkEndpoint('http://127.0.0.1:45678/health', space, controller.signal);
+    const { options } = calls.at(-1);
+    assert.equal(options.targetAddressSpace, space);
+    assert.equal(options.mode, 'cors');
+    assert.equal(options.credentials, 'omit');
+    assert.equal(options.redirect, 'error');
+    assert.equal(options.cache, 'no-store');
+    assert.equal(options.referrerPolicy, 'no-referrer');
+    assert.equal(options.signal, controller.signal);
+  }
+  fetchMock.mock.mockImplementation(async () => new Response(null, { status: 503 }));
+  await assert.rejects(checkEndpoint('http://192.168.1.100/status', 'local'), /HTTP 503/);
+  fetchMock.mock.mockImplementation(async () => ({ ok: false, status: 0, type: 'opaque' }));
+  await assert.rejects(checkEndpoint('http://192.168.1.100/status', 'local'), /HTTP 0/);
+  fetchMock.mock.mockImplementation(async () => { throw new TypeError('Network blocked'); });
+  await assert.rejects(checkEndpoint('http://192.168.1.100/status', 'local'), /Network blocked/);
+});
+
+test('permission checks use granular names and safely handle unsupported browsers', async (t) => {
+  const names = [];
+  const original = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+  t.after(() => {
+    if (original) Object.defineProperty(globalThis, 'navigator', original);
+    else delete globalThis.navigator;
+  });
+  Object.defineProperty(globalThis, 'navigator', { configurable: true, value: { permissions: { query: async ({ name }) => {
+    names.push(name);
+    return { state: 'prompt' };
+  } } } });
+  assert.equal((await queryPermission('local')).state, 'prompt');
+  assert.equal((await queryPermission('loopback')).state, 'prompt');
+  assert.deepEqual(names, ['local-network', 'loopback-network']);
+  navigator.permissions.query = async () => { throw new TypeError('Unknown permission'); };
+  assert.equal(await queryPermission('local'), null);
+  navigator.permissions = undefined;
+  assert.equal(await queryPermission('loopback'), null);
+});
