@@ -0,0 +1,48 @@
+// Connections are made by the user's browser, never by a public server proxy.
+export function validateEndpoint(value, space) {
+  let url;
+  try { url = new URL(value); } catch { throw new Error('Enter a complete http:// or https:// status URL.'); }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const ipv4 = /^\d+\.\d+\.\d+\.\d+$/.test(host) ? host.split('.').map(Number) : null;
+  const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || ipv4?.[0] === 127;
+  const local = (ipv4 && (ipv4[0] === 10 || (ipv4[0] === 172 && ipv4[1] >= 16 && ipv4[1] <= 31) ||
+    (ipv4[0] === 192 && ipv4[1] === 168) || (ipv4[0] === 169 && ipv4[1] === 254))) ||
+    host.endsWith('.local') || /^\[f[cd][\da-f]{2}:/.test(host) || /^\[fe[89ab][\da-f]:/.test(host);
+  if (space === 'loopback' ? !loopback : !local) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address such as 127.0.0.1, localhost, or [::1] for your desktop helper.'
+      : 'Use a private LAN address such as 192.168.1.100 or brewer.local for the brewer.');
+  }
+  return url.href;
+}
+
+export async function queryPermission(space) {
+  try {
+    return await navigator.permissions.query({ name: space === 'local' ? 'local-network' : 'loopback-network' });
+  } catch {
+    // Unknown permission names are normal in browsers without granular LNA support.
+    // Keep the first connection behind the user's explicit Connect action.
+    return null;
+  }
+}
+
+export async function checkEndpoint(url, space, signal) {
+  const response = await fetch(url, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: space,
+    credentials: 'omit',
+    cache: 'no-store',
+    redirect: 'error',
+    referrerPolicy: 'no-referrer',
+    signal,
+  });
+  if (!response.ok || response.type === 'opaque') {
+    throw new Error(`The endpoint returned HTTP ${response.status}. Check the status path and device configuration.`);
+  }
+  // The health contract requires a successful status, not any particular body format.
+  await response.body?.cancel();
+}
