--- /dev/null
+++ b/equipment.mjs
@@ -0,0 +1,121 @@
+import { validateEndpoint, queryPermission, checkEndpoint } from './connections.mjs';
+
+for (const form of document.querySelectorAll('.connection-card')) {
+  const space = form.dataset.space;
+  const input = form.elements.endpoint;
+  const connect = form.querySelector('[type="submit"]');
+  const disconnect = form.querySelector('[data-disconnect]');
+  const badge = form.querySelector('.status-label');
+  const message = form.querySelector('[role="status"]');
+  const initialLabel = connect.textContent;
+  let controller;
+  let permission;
+  const deniedMessage = `Access blocked. Allow ${space === 'local' ? 'Local network' : 'Loopback network'} access in your browser’s site settings, then try again.`;
+
+  function show(state, label, detail) {
+    form.dataset.state = state;
+    badge.textContent = label;
+    message.textContent = detail;
+  }
+
+  function resetControls() {
+    connect.disabled = false;
+    connect.textContent = initialLabel;
+    input.readOnly = false;
+    form.removeAttribute('aria-busy');
+    disconnect.hidden = true;
+  }
+
+  function stop() {
+    controller?.abort();
+    controller = null;
+    resetControls();
+  }
+
+  function onPermissionChange() {
+    if (permission.state === 'denied') {
+      stop();
+      show('error', 'Permission blocked', deniedMessage);
+    } else if (form.dataset.state !== 'connecting' && form.dataset.state !== 'connected') {
+      show('idle', 'Not connected', 'Ready to try connecting. Your browser may ask you to allow access.');
+    }
+  }
+
+  async function updatePermission() {
+    const next = await queryPermission(space);
+    permission?.removeEventListener('change', onPermissionChange);
+    permission = next;
+    permission?.addEventListener('change', onPermissionChange);
+    if (permission?.state === 'denied') onPermissionChange();
+    return permission?.state;
+  }
+
+  // Permission checks do not contact equipment or trigger connection prompts.
+  updatePermission();
+
+  input.addEventListener('input', () => {
+    input.setCustomValidity('');
+    input.removeAttribute('aria-invalid');
+    if (form.dataset.state !== 'idle') {
+      stop();
+      show('idle', 'Not connected', 'Address changed. Connect to check this endpoint.');
+    }
+  });
+
+  disconnect.addEventListener('click', () => {
+    stop();
+    show('idle', 'Not connected', 'Disconnected from this page. Equipment remains powered on.');
+    connect.focus();
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (controller) return;
+    let url;
+    try {
+      url = validateEndpoint(input.value.trim(), space);
+    } catch (error) {
+      input.setCustomValidity(error.message);
+      input.setAttribute('aria-invalid', 'true');
+      input.reportValidity();
+      return;
+    }
+    if (!window.isSecureContext) {
+      show('error', 'Secure page required', 'Open this homepage over HTTPS to connect to local equipment.');
+      return;
+    }
+
+    const attempt = new AbortController();
+    controller = attempt;
+    input.readOnly = true;
+    connect.disabled = true;
+    connect.textContent = 'Connecting…';
+    disconnect.hidden = false;
+    form.setAttribute('aria-busy', 'true');
+    show('connecting', 'Connecting', 'Allow access if your browser asks. Checking the status endpoint…');
+    let timeout;
+    try {
+      if (await updatePermission() === 'denied' || attempt.signal.aborted) return;
+      timeout = setTimeout(() => attempt.abort('timeout'), 30000);
+      await checkEndpoint(url, space, attempt.signal);
+      if (controller !== attempt) return;
+      show('connected', 'Connected', `Status endpoint reached at ${new Date().toLocaleTimeString()}. Connect again to refresh.`);
+    } catch (error) {
+      if (controller !== attempt) return;
+      const state = await updatePermission();
+      if (controller !== attempt) return;
+      const hint = space === 'local'
+        ? 'Check the brewer is on and you’re on the same private Wi-Fi.'
+        : 'Check the desktop helper is running on this computer and its port is correct.';
+      show('error', state === 'denied' ? 'Permission blocked' : 'Could not connect', state === 'denied' ? deniedMessage :
+        `${attempt.signal.aborted ? 'The connection timed out.' : error instanceof TypeError ? 'The browser could not reach the endpoint.' : error.message} ${hint} Check browser permissions and the endpoint’s CORS settings. If local HTTP is unsupported, try a current Chrome or Edge browser or a trusted HTTPS endpoint.`);
+    } finally {
+      clearTimeout(timeout);
+      if (controller === attempt) {
+        controller = null;
+        resetControls();
+        disconnect.hidden = form.dataset.state !== 'connected';
+      }
+    }
+  });
+}
