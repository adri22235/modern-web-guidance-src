+++ b/src/components/DiagnosticsConnections.tsx
@@ -0,0 +1,208 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import type { FormEvent } from 'react';
+
+type AddressSpace = 'local' | 'loopback';
+type NetworkRequestInit = RequestInit & { targetAddressSpace: AddressSpace };
+
+function endpoint(value: string, space: AddressSpace): URL {
+  const url = new URL(value);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS status URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const octets = host.split('.').map(Number);
+  const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+  const loopback = (ipv4 && octets[0] === 127) || host === '[::1]' || host === 'localhost' || host.endsWith('.localhost');
+  const local = (ipv4 && (octets[0] === 10 || (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+    (octets[0] === 192 && octets[1] === 168) || (octets[0] === 169 && octets[1] === 254))) ||
+    host.endsWith('.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/.test(host);
+  if (!(space === 'loopback' ? loopback : local)) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address such as 127.0.0.1, localhost, or [::1].'
+      : 'Use a private LAN address such as 192.168.1.100 or device.local.');
+  }
+  return url;
+}
+
+function Connection({ space, title, initialUrl, description }: {
+  space: AddressSpace; title: string; initialUrl: string; description: string;
+}) {
+  const id = useId();
+  const [url, setUrl] = useState(initialUrl);
+  const [permission, setPermission] = useState<PermissionState | 'unknown'>('unknown');
+  const [ready, setReady] = useState(false);
+  const [secure, setSecure] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState('Ready to check a connection.');
+  const [result, setResult] = useState('');
+  const [invalid, setInvalid] = useState(false);
+  const active = useRef<AbortController | null>(null);
+  const permissionName = space === 'local' ? 'local-network' : 'loopback-network';
+  const permissionLabel = space === 'local' ? 'Local network' : 'Loopback network';
+
+  useEffect(() => {
+    let disposed = false;
+    let status: PermissionStatus | undefined;
+    const update = () => {
+      if (!disposed && status) {
+        setPermission(status.state);
+        if (status.state === 'denied') {
+          active.current?.abort();
+          setResult('');
+          setMessage('Access blocked. Update browser site settings, then reconnect.');
+        }
+      }
+    };
+    setSecure(window.isSecureContext);
+    setReady(true);
+    async function checkPermission() {
+      try {
+        // New granular permission names may not yet appear in TypeScript's DOM types.
+        status = await navigator.permissions.query({ name: permissionName as PermissionName });
+        if (disposed) return;
+        update();
+        status.addEventListener('change', update);
+      } catch {
+        // Unsupported permission queries still allow an explicit connection attempt.
+        if (!disposed) setPermission('unknown');
+      }
+    }
+    void checkPermission();
+    return () => {
+      disposed = true;
+      status?.removeEventListener('change', update);
+      active.current?.abort();
+    };
+  }, [permissionName]);
+
+  async function connect(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (active.current) return;
+    setResult('');
+    let target: URL;
+    try {
+      target = endpoint(url, space);
+    } catch (error) {
+      setInvalid(true);
+      setMessage(error instanceof Error ? error.message : 'Enter a valid status URL.');
+      event.currentTarget.querySelector('input')?.focus();
+      return;
+    }
+    if (!window.isSecureContext || permission === 'denied') return;
+    setInvalid(false);
+    const controller = new AbortController();
+    active.current = controller;
+    let timedOut = false;
+    const timeout = window.setTimeout(() => {
+      timedOut = true;
+      controller.abort();
+    }, 20000);
+    setBusy(true);
+    setMessage('Connecting… Allow browser access if prompted.');
+    try {
+      const options: NetworkRequestInit = {
+        method: 'GET',
+        mode: 'cors',
+        credentials: 'omit',
+        redirect: 'error',
+        cache: 'no-store',
+        referrerPolicy: 'no-referrer',
+        targetAddressSpace: space,
+        signal: controller.signal,
+      };
+      const response = await fetch(target.href, options);
+      if (!response.ok) throw new Error(`The endpoint returned HTTP ${response.status}. Check the status URL and service logs.`);
+      // Bound the preview so a streaming or oversized response cannot fill the page.
+      const reader = response.body?.getReader();
+      let preview = '';
+      if (reader) {
+        const decoder = new TextDecoder();
+        let bytes = 0;
+        try {
+          while (bytes < 8192) {
+            const { done, value } = await reader.read();
+            if (done) break;
+            const remaining = 8192 - bytes;
+            preview += decoder.decode(value.subarray(0, remaining), { stream: true });
+            bytes += value.byteLength;
+          }
+          preview += decoder.decode();
+          if (bytes >= 8192) preview += '\n[Preview limited to 8 KB]';
+        } finally {
+          await reader.cancel();
+        }
+      }
+      if (controller.signal.aborted) throw new DOMException('Connection aborted', 'AbortError');
+      setResult(preview || '(Empty response)');
+      setMessage(`Connection verified · HTTP ${response.status} · ${new Date().toLocaleTimeString()}. This is a one-time check.`);
+    } catch (error) {
+      setMessage(controller.signal.aborted
+        ? timedOut ? 'Connection timed out after 20 seconds. Check the service and retry.' : 'Connection cancelled.'
+        : error instanceof TypeError
+          ? 'Could not connect. Check the address, service, browser permissions, and CORS setup below. Your browser may not support HTTP local connections; try HTTPS or a current Chrome or Edge browser.'
+          : error instanceof Error ? error.message : 'Connection failed. Please retry.');
+    } finally {
+      window.clearTimeout(timeout);
+      if (active.current === controller) {
+        active.current = null;
+        setBusy(false);
+      }
+    }
+  }
+
+  return (
+    <form onSubmit={connect} aria-labelledby={`${id}-title`} className="min-w-0 border border-gray-300 bg-white p-5">
+      <h3 id={`${id}-title`} className="text-lg font-bold text-gray-900">{title}</h3>
+      <p className="mt-1 text-sm text-gray-600">{description}</p>
+      <p className="my-4 text-xs font-medium text-gray-700">
+        {permissionLabel} permission: {permission === 'unknown' ? 'checked by browser when connecting' : permission === 'prompt' ? 'ask on connect' : permission}
+      </p>
+      <label htmlFor={`${id}-url`} className="mb-2 block text-sm font-semibold">Status URL (required)</label>
+      <input id={`${id}-url`} name="endpoint" type="url" required value={url}
+        onChange={event => { setUrl(event.target.value); setInvalid(false); setResult(''); setMessage('Ready to check a connection.'); }}
+        disabled={busy} autoComplete="off" autoCapitalize="none" autoCorrect="off" spellCheck={false}
+        aria-invalid={invalid} aria-describedby={`${id}-status`}
+        className="min-h-12 w-full rounded-sm border border-gray-500 px-3 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:bg-gray-100" />
+      <div className="mt-3 flex flex-wrap gap-3">
+        <button type="submit" disabled={!ready || !secure || busy || permission === 'denied'}
+          className="min-h-12 rounded-sm bg-gray-900 px-5 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:opacity-50">
+          {busy ? 'Connecting…' : 'Connect'}
+        </button>
+        {busy && <button type="button" onClick={() => active.current?.abort()}
+          className="min-h-12 rounded-sm border border-gray-500 px-4 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600">Cancel</button>}
+      </div>
+      <p id={`${id}-status`} role="status" className="mt-3 break-words text-sm text-gray-700">{message}</p>
+      {ready && !secure && <p className="mt-3 text-sm text-red-800">Open The DevTools Times over HTTPS to enable device connections.</p>}
+      {permission === 'denied' && <p className="mt-3 text-sm text-red-800">Open this site’s browser settings, allow {permissionLabel.toLowerCase()} access, then retry. Reload if your browser requires it.</p>}
+      {result && <pre aria-label={`${title} response`} tabIndex={0} className="mt-4 max-h-52 overflow-auto whitespace-pre-wrap break-all bg-gray-100 p-3 text-xs">{result}</pre>}
+    </form>
+  );
+}
+
+export default function DiagnosticsConnections() {
+  const id = useId();
+  return (
+    <section aria-labelledby={`${id}-heading`} className="border-y border-gray-300 bg-gray-50 p-4 sm:p-6">
+      <div className="mb-5 border-l-4 border-amber-400 pl-4">
+        <p className="text-xs font-bold uppercase tracking-widest text-gray-600">Developer toolbox</p>
+        <h2 id={`${id}-heading`} className="mt-1 font-brand text-3xl text-gray-900">Diagnostics connections</h2>
+        <p className="mt-2 max-w-3xl text-sm text-gray-700">Check your test hardware and local companion directly from this browser. Choose Connect to allow access to each endpoint. Responses stay in this widget.</p>
+      </div>
+      <div className="grid gap-4 md:grid-cols-2">
+        <Connection space="local" title="Hardware test device" initialUrl="http://192.168.1.100:8080/api/status"
+          description="Connect to a device on your private Wi-Fi LAN. Keep this machine and the device on the same network." />
+        <Connection space="loopback" title="Companion CLI" initialUrl="http://127.0.0.1:45678/health"
+          description="Connect to a companion service running on this machine. Start your CLI and use its HTTP health endpoint." />
+      </div>
+      <details className="mt-4 text-sm text-gray-700">
+        <summary className="cursor-pointer py-3 font-semibold focus-visible:outline-2 focus-visible:outline-amber-600">Endpoint setup & troubleshooting</summary>
+        <div className="mt-2 space-y-2 leading-relaxed">
+          <p>The example ports and paths are placeholders. Replace them with your device’s read-only status endpoint and your CLI’s health endpoint. Each check sends one GET request; it does not maintain a live session.</p>
+          <p>Both endpoints must allow this site’s origin using the standard CORS response header <code>Access-Control-Allow-Origin</code>. Requests omit credentials. Configure the device or CLI to allow the origin shown in your address bar; the site cannot fix CORS on its behalf.</p>
+          <p>If access fails, check the service is running, the port is reachable, and your firewall allows it. For hardware, check Wi-Fi isolation or VPN routing. Allow local network or loopback network access in browser site settings and any operating system prompt.</p>
+          <p>Browser support varies. If your browser blocks HTTP connections, use a trusted HTTPS endpoint or a current Chrome or Edge browser. Permission and CORS checks still apply.</p>
+        </div>
+      </details>
+    </section>
+  );
+}
