+import { useEffect, useRef, useState } from 'react';
+
+type AddressSpace = 'local' | 'loopback';
+type NetworkPermission = 'local-network' | 'loopback-network';
+type Permission = PermissionState | 'unknown';
+
+function validateEndpoint(value: string, space: AddressSpace): URL {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new Error('Enter a complete HTTP or HTTPS endpoint URL.');
+  }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const ip = host.split('.').map(Number);
+  const ipv4 = /^\d+\.\d+\.\d+\.\d+$/.test(host) && ip.every(part => part >= 0 && part <= 255);
+  const loopback = (ipv4 && ip[0] === 127) || host === '[::1]' || host === 'localhost' || host.endsWith('.localhost');
+  const privateLan = (ipv4 && (ip[0] === 10 || (ip[0] === 172 && ip[1] >= 16 && ip[1] <= 31) ||
+    (ip[0] === 192 && ip[1] === 168) || (ip[0] === 169 && ip[1] === 254))) ||
+    host.endsWith('.local') || /^\[(?:f[cd][0-9a-f]{2}:|fe[89ab][0-9a-f]:)/.test(host);
+  if (space === 'loopback' ? !loopback : !privateLan) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address such as 127.0.0.1, localhost, or [::1].'
+      : 'Use a private LAN address such as 192.168.1.100 or device.local.');
+  }
+  return url;
+}
+
+function ConnectionCard({ space, title, description, initialUrl }: {
+  space: AddressSpace;
+  title: string;
+  description: string;
+  initialUrl: string;
+}) {
+  const permissionName: NetworkPermission = space === 'local' ? 'local-network' : 'loopback-network';
+  const [endpoint, setEndpoint] = useState(initialUrl);
+  const [permission, setPermission] = useState<Permission>('unknown');
+  const [secure, setSecure] = useState(false);
+  const [status, setStatus] = useState<'idle' | 'checking' | 'success' | 'error'>('idle');
+  const [message, setMessage] = useState('No connection attempted.');
+  const [output, setOutput] = useState('');
+  const activeRequest = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    setSecure(window.isSecureContext);
+    let disposed = false;
+    let permissionStatus: PermissionStatus | undefined;
+    const updatePermission = () => {
+      if (disposed || !permissionStatus) return;
+      setPermission(permissionStatus.state);
+      if (permissionStatus.state === 'denied') {
+        const request = activeRequest.current;
+        activeRequest.current = null;
+        request?.abort();
+        setStatus('error');
+        setOutput('');
+        setMessage('Access blocked. Allow access in browser site settings, then try again.');
+      }
+    };
+    // Querying permission never contacts a device or triggers a permission prompt.
+    navigator.permissions?.query({ name: permissionName as PermissionName })
+      .then(result => {
+        if (disposed) return;
+        permissionStatus = result;
+        updatePermission();
+        result.addEventListener('change', updatePermission);
+      })
+      .catch(() => { /* Unsupported permission names still allow a user-initiated attempt. */ });
+    return () => {
+      disposed = true;
+      permissionStatus?.removeEventListener('change', updatePermission);
+      activeRequest.current?.abort();
+    };
+  }, [permissionName]);
+
+  function cancel() {
+    const request = activeRequest.current;
+    activeRequest.current = null;
+    request?.abort();
+    setStatus('idle');
+    setMessage('Connection check canceled.');
+  }
+
+  async function connect(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (activeRequest.current) return;
+    setOutput('');
+    if (!window.isSecureContext || permission === 'denied') {
+      setStatus('error');
+      setMessage(!window.isSecureContext
+        ? 'Open this site over HTTPS to connect to local devices.'
+        : 'Allow access in browser site settings, then try again.');
+      return;
+    }
+    let url: URL;
+    try {
+      url = validateEndpoint(endpoint.trim(), space);
+    } catch (error) {
+      setStatus('error');
+      setMessage((error as Error).message);
+      return;
+    }
+    const controller = new AbortController();
+    activeRequest.current = controller;
+    setStatus('checking');
+    setMessage('Waiting for permission and endpoint response…');
+    let timedOut = false;
+    const timer = window.setTimeout(() => {
+      timedOut = true;
+      controller.abort();
+    }, 15000);
+    try {
+      // Keep the request in the browser: a server proxy would reach the server's LAN.
+      const options: RequestInit & { targetAddressSpace: AddressSpace } = {
+        method: 'GET',
+        mode: 'cors',
+        credentials: 'omit',
+        cache: 'no-store',
+        redirect: 'error',
+        referrerPolicy: 'no-referrer',
+        targetAddressSpace: space,
+        signal: controller.signal,
+      };
+      const start = performance.now();
+      const response = await fetch(url.href, options);
+      if (!response.ok) throw new Error(`Endpoint returned HTTP ${response.status}. Check the endpoint path and service logs.`);
+      const body = await response.text();
+      if (activeRequest.current !== controller || controller.signal.aborted) return;
+      let formatted = body;
+      try { formatted = JSON.stringify(JSON.parse(body), null, 2); } catch { /* Plain-text health endpoints are supported too. */ }
+      setOutput(formatted.length > 8000 ? `${formatted.slice(0, 8000)}\n… response truncated` : formatted);
+      setStatus('success');
+      setMessage(`Reachable · HTTP ${response.status} · ${Math.round(performance.now() - start)} ms. Checked ${new Date().toLocaleTimeString()}.`);
+    } catch (error) {
+      if (activeRequest.current !== controller) return;
+      setStatus('error');
+      setMessage(timedOut
+        ? 'Timed out after 15 seconds. Check the service and address, and approve browser access before retrying.'
+        : error instanceof TypeError
+          ? 'Could not connect. Check browser site permissions, the service address, CORS settings, and browser support for local network access.'
+          : (error as Error).message);
+    } finally {
+      window.clearTimeout(timer);
+      if (activeRequest.current === controller) activeRequest.current = null;
+    }
+  }
+
+  const badge = { idle: 'Not checked', checking: 'Connecting', success: 'Reachable', error: 'Needs attention' }[status];
+  const color = status === 'success' ? 'bg-emerald-100 text-emerald-900' : status === 'error' ? 'bg-amber-100 text-amber-900' : 'bg-gray-100 text-gray-600';
+
+  return (
+    <div className="min-w-0 rounded-lg border border-gray-200 bg-white p-5">
+      <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
+        <h3 className="font-bold text-gray-900">{title}</h3>
+        <span className={`rounded-full px-2.5 py-1 text-xs font-medium ${color}`}>{badge}</span>
+      </div>
+      <p className="mb-4 text-sm text-gray-600">{description}</p>
+      <form onSubmit={connect}>
+        <label htmlFor={`diagnostics-${space}`} className="mb-1 block text-xs font-semibold text-gray-700">Endpoint URL</label>
+        <input id={`diagnostics-${space}`} type="url" required value={endpoint}
+          onChange={event => {
+            setEndpoint(event.target.value);
+            setStatus('idle');
+            setMessage('No connection attempted for this endpoint.');
+            setOutput('');
+          }}
+          disabled={status === 'checking'} spellCheck={false} autoComplete="off"
+          aria-describedby={`diagnostics-${space}-help diagnostics-${space}-status`}
+          className="w-full rounded border border-gray-300 px-3 py-2 font-mono text-sm focus:border-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-300 disabled:bg-gray-50" />
+        <p id={`diagnostics-${space}-help`} className="mt-2 text-xs leading-relaxed text-gray-500">
+          {space === 'local' ? 'Keep the test device on the same Wi-Fi LAN.' : 'Start your companion CLI’s HTTP service on this machine.'}
+        </p>
+        <div className="mt-4 flex flex-wrap items-center gap-3">
+          <button type="submit" disabled={status === 'checking' || !secure || permission === 'denied'}
+            className="rounded bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 disabled:cursor-not-allowed disabled:opacity-50">
+            {status === 'checking' ? 'Connecting…' : status === 'success' ? 'Check again' : 'Connect'}
+          </button>
+          {status === 'checking' && <button type="button" onClick={cancel} className="rounded px-2 py-2 text-sm underline focus-visible:outline-2">Cancel</button>}
+          <span className="text-xs text-gray-500">Permission: {permission === 'unknown' ? 'checked by browser on connect' : permission === 'prompt' ? 'ask on connect' : permission}</span>
+        </div>
+      </form>
+      {!secure && <p className="mt-3 text-sm text-amber-900">Open this site over HTTPS to enable connections.</p>}
+      {permission === 'denied' && <p className="mt-3 text-sm text-amber-900">In browser site settings, allow {space === 'local' ? 'Local network' : 'Loopback network'} access, then retry. Reload if your browser does not update the permission here.</p>}
+      <p id={`diagnostics-${space}-status`} role="status" aria-live="polite" className="mt-3 text-xs leading-relaxed text-gray-600">{message}</p>
+      {output && <details className="mt-3 text-xs text-gray-700" open>
+        <summary className="cursor-pointer font-semibold">Endpoint response</summary>
+        <pre className="mt-2 max-h-48 overflow-auto whitespace-pre-wrap break-all rounded bg-gray-50 p-3">{output}</pre>
+      </details>}
+    </div>
+  );
+}
+
+export default function DiagnosticsConnections() {
+  return (
+    <section aria-labelledby="diagnostics-heading" className="mx-4 my-6 rounded-xl border border-gray-200 bg-gray-50 p-4 sm:mx-6 sm:p-6">
+      <div className="mb-5 border-b border-gray-200 pb-4">
+        <p className="mb-1 text-xs font-semibold uppercase tracking-widest text-gray-500">Developer workbench</p>
+        <h2 id="diagnostics-heading" className="font-brand text-3xl text-gray-900">Diagnostics connections</h2>
+        <p className="mt-2 max-w-3xl text-sm leading-relaxed text-gray-600">Check your hardware test device or companion CLI directly from this browser. Connect asks for browser access when needed and sends a single read-only GET request to your endpoint.</p>
+      </div>
+      <div className="grid gap-4 md:grid-cols-2">
+        <ConnectionCard space="local" title="Hardware test device" description="Connect to a device on your private network." initialUrl="http://192.168.1.100:8080/api/status" />
+        <ConnectionCard space="loopback" title="Local companion CLI" description="Connect to the CLI running on your own machine." initialUrl="http://127.0.0.1:45678/health" />
+      </div>
+      <details className="mt-4 text-xs leading-relaxed text-gray-600">
+        <summary className="cursor-pointer font-semibold text-gray-700">Connection requirements & troubleshooting</summary>
+        <p className="mt-2">Use HTTPS for this site and a browser that supports local network access. Allow Local network or Loopback network access when prompted. If access is blocked, change this site’s browser permissions and retry. Browser support varies; a failed request may also mean mixed content or a certificate was blocked.</p>
+        <p className="mt-2">The device and CLI must expose an HTTP(S) endpoint and return a standard Access-Control-Allow-Origin header permitting this site’s origin. JSON and plain-text responses are supported. LAN and loopback permissions are separate; granting one may not grant the other. These checks do not keep a persistent connection open.</p>
+      </details>
+    </section>
+  );
+}
