+  <script>
+    const signinForm = document.getElementById('signin-form');
+    const signinButton = signinForm.querySelector('button');
+    const signinStatus = document.getElementById('signin-status');
+
+    async function registerPasskeySilently() {
+      try {
+        // Never fall back to an interactive registration on older browsers.
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential !== 'function' ||
+            typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+            typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+            typeof PublicKeyCredential.prototype.toJSON !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // The authenticated server must supply rp.id and excludeCredentials,
+        // and bind this challenge to a conditional registration in the session.
+        // Verification must relax user presence only for that conditional challenge.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(
+          await optionsResponse.json()
+        );
+        if (!publicKey.rp?.id) return;
+
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        try {
+          const encodedResponse = credential.toJSON();
+          const verification = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encodedResponse)
+          });
+          if (!verification.ok) throw new Error('Registration rejected');
+          if (verification.status !== 204) {
+            const result = await verification.json();
+            if (result.verified !== true) throw new Error('Registration not verified');
+          }
+        } catch {
+          // Signal only the credential from this attempt, using the server's RP ID.
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id,
+              credentialId: credential.id
+            });
+          }
+        }
+      } catch {
+        // Unsupported providers, cancellations, and failures never affect sign-in UI.
+      }
+    }
+
+    signinForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (signinButton.disabled) return;
+      signinButton.disabled = true;
+      signinStatus.textContent = '';
+
+      try {
+        // Contract: a 2xx response establishes a fully authenticated session.
+        // If MFA is added, invoke registration only after its final success.
+        const response = await fetch(signinForm.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: signinForm.elements.username.value,
+            password: signinForm.elements.password.value
+          })
+        });
+        if (!response.ok) throw new Error('Sign-in failed');
+
+        signinForm.elements.password.value = '';
+        signinStatus.textContent = 'You are signed in.';
+        void registerPasskeySilently();
+      } catch {
+        signinStatus.textContent = 'Unable to sign in. Check your credentials and try again.';
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
