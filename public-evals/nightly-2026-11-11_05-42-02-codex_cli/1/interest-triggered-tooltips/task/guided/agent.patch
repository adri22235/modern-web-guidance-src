+  <script type="module">
+    // Static ARIA above is available before any polyfill loads. Keep link activation
+    // for navigation; interest reveals hints without moving keyboard focus.
+    async function enableTooltips() {
+      if (!("popover" in HTMLElement.prototype)) {
+        await import("https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js");
+      }
+
+      // Load positioning before enabling hover/focus in unsupported browsers.
+      if (!CSS.supports("anchor-name: --a")) {
+        await import("https://unpkg.com/@oddbird/css-anchor-positioning@0.10.2/dist/css-anchor-positioning.js");
+      }
+
+      if (!("interestForElement" in HTMLButtonElement.prototype)) {
+        await import("https://unpkg.com/interestfor@1.0.12/src/interestfor.min.js");
+      }
+    }
+
+    enableTooltips().catch((error) => console.error("Unable to enable item tooltips:", error));
+  </script>
