+      width: 240px;
+      max-width: calc(100vw - 40px);
+      margin-bottom: 8px;
+      padding: 12px 14px;
+      border-radius: 6px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
+      font-size: 0.875rem;
+      line-height: 1.5;
+      text-align: left;
+      z-index: 1001;
+      visibility: hidden;
+      opacity: 0;
+    }
+
+    /* Bridge the gap so the tooltip stays open when the pointer enters it. */
+    .item-tooltip::before {
+      content: "";
+      position: absolute;
+      top: -8px;
+      right: -8px;
+      bottom: -8px;
+      left: -8px;
+    }
+
+    .item-action:hover .item-tooltip,
+    .item-action .btn:focus + .item-tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    .item-action[data-dismissed] .item-tooltip {
+      visibility: hidden;
+      opacity: 0;
+    }
+
+    @supports (anchor-name: --item) and (position-area: top) and (position-try-fallbacks: flip-block) {
+      .item-tooltip {
+        position: fixed;
+        position-anchor: var(--item-anchor);
+        inset: auto;
+        transform: none;
+        margin: 8px;
+        position-area: top;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
