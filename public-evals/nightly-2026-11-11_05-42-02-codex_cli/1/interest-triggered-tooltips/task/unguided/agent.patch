+  <script>
+    // CSS handles hover and focus even when JavaScript is unavailable.
+    var itemActions = document.querySelectorAll('.item-action');
+    Array.prototype.forEach.call(itemActions, function (action) {
+      action.addEventListener('mouseenter', function () {
+        action.removeAttribute('data-dismissed');
+      });
+      action.querySelector('.btn').addEventListener('focus', function () {
+        action.removeAttribute('data-dismissed');
+      });
+    });
+    document.addEventListener('keydown', function (event) {
+      if (event.key === 'Escape' || event.key === 'Esc') {
+        Array.prototype.forEach.call(itemActions, function (action) {
+          action.setAttribute('data-dismissed', '');
+        });
+      }
+    });
+  </script>
