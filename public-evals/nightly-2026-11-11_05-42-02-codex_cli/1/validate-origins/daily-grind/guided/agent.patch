diff --git a/origin-validation.mjs b/origin-validation.mjs
new file mode 100644
index 0000000..ed315ed
--- /dev/null
+++ b/origin-validation.mjs
@@ -0,0 +1,78 @@
+// Deployment configuration: the ordering service must use this exact origin.
+export const ORDERING_ORIGIN = 'https://orders.dailygrind.coffee';
+// Only this explicitly controlled registrable domain may use the subdomain fallback.
+const SITE_DOMAIN = 'dailygrind.coffee';
+
+export function parseWebUrl(candidate, baseUrl) {
+  try {
+    const value = typeof candidate === 'string' ? candidate : candidate?.href;
+    if (typeof value !== 'string' || !value.trim()) return null;
+    const url = new URL(value, baseUrl);
+    if (!['https:', 'http:'].includes(url.protocol) || url.username || url.password) return null;
+    return url;
+  } catch {
+    return null;
+  }
+}
+
+export function isTrustedOrderingMessage(event) {
+  try {
+    if ('Origin' in globalThis) {
+      let sender;
+      try {
+        sender = Origin.from(event);
+      } catch {
+        // Synthetic MessageEvents lack the browser's internal sender origin.
+        sender = Origin.from(event.origin);
+      }
+      return !sender.opaque && sender.isSameOrigin(Origin.from(ORDERING_ORIGIN));
+    }
+    const sender = new URL(event.origin);
+    return sender.origin !== 'null' && sender.origin === new URL(ORDERING_ORIGIN).origin;
+  } catch {
+    return false;
+  }
+}
+
+export function isAllowedSameSiteUrl(candidate, baseUrl) {
+  const url = parseWebUrl(candidate, baseUrl);
+  const base = parseWebUrl(baseUrl);
+  if (!url || !base) return false;
+  try {
+    if ('Origin' in globalThis) {
+      const origin = Origin.from(url);
+      return !origin.opaque && origin.isSameSite(Origin.from(base));
+    }
+    // URL has no Public Suffix List. Never infer a registrable domain by splitting
+    // arbitrary hostnames (e.g. co.uk or github.io). Unknown deployments fail closed
+    // to same-origin; our explicitly configured domain permits subdomains.
+    const belongsToSite = (host) => host === SITE_DOMAIN || host.endsWith(`.${SITE_DOMAIN}`);
+    return url.origin === base.origin || (
+      url.protocol === base.protocol && belongsToSite(url.hostname) && belongsToSite(base.hostname)
+    );
+  } catch {
+    return false;
+  }
+}
+
+export function createWidgetValidator(expectedWindow) {
+  let pinned = false;
+  let pinnedOrigin;
+  return (event) => {
+    if (!expectedWindow || event.source !== expectedWindow || event.origin !== 'null') return false;
+    try {
+      // Do not parse event.origin here: every opaque origin serializes as "null".
+      const sender = 'Origin' in globalThis ? Origin.from(event) : null;
+      if (sender && !sender.opaque) return false;
+      if (!pinned) {
+        if (event.data?.type !== 'init') return false;
+        pinnedOrigin = sender;
+        pinned = true;
+      }
+      // Without Origin, the captured WindowProxy is the available identity check.
+      return sender ? sender.isSameOrigin(pinnedOrigin) : true;
+    } catch {
+      return false;
+    }
+  };
+}
diff --git a/origin-validation.test.mjs b/origin-validation.test.mjs
new file mode 100644
index 0000000..74f5b9e
--- /dev/null
+++ b/origin-validation.test.mjs
@@ -0,0 +1,102 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  ORDERING_ORIGIN, createWidgetValidator, isAllowedSameSiteUrl,
+  isTrustedOrderingMessage, parseWebUrl,
+} from './origin-validation.mjs';
+
+test('ordering origin is exact and normalized; hostile and opaque origins fail closed', () => {
+  assert.equal(isTrustedOrderingMessage({ origin: `${ORDERING_ORIGIN}:443` }), true);
+  for (const origin of [
+    `${ORDERING_ORIGIN}.attacker.test`, 'https://evilorders.dailygrind.coffee',
+    'http://orders.dailygrind.coffee', `${ORDERING_ORIGIN}:8443`,
+    'null', 'not a URL', 'data:text/plain,hello',
+  ]) assert.equal(isTrustedOrderingMessage({ origin }), false, origin);
+});
+
+test('redirects parse relative URLs and reject dangerous schemes, credentials and spoofed sites', () => {
+  const base = 'https://www.dailygrind.coffee/account';
+  for (const url of ['/menu', '//billing.dailygrind.coffee/orders', 'https://dailygrind.coffee:8443/menu']) {
+    assert.equal(isAllowedSameSiteUrl(url, base), true, url);
+  }
+  for (const url of [
+    'https://dailygrind.coffee.attacker.test', 'https://evildailygrind.coffee',
+    'http://dailygrind.coffee', 'https://dailygrind.coffee@attacker.test',
+    'https://user:password@dailygrind.coffee', 'javascript:alert(1)',
+    'data:text/html,test', 'blob:https://www.dailygrind.coffee/id', 'https://[', '',
+  ]) assert.equal(isAllowedSameSiteUrl(url, base), false, url);
+  assert.equal(parseWebUrl('/menu', base).href, 'https://www.dailygrind.coffee/menu');
+  assert.equal(isAllowedSameSiteUrl({ href: '/menu' }, base), true);
+});
+
+test('fallback never guesses shared public suffixes or trusts unknown subdomains', () => {
+  for (const [base, target] of [
+    ['https://a.co.uk', 'https://b.co.uk'],
+    ['https://alice.github.io', 'https://bob.github.io'],
+    ['https://app.example.com', 'https://billing.example.com'],
+    ['https://attacker.test', 'https://dailygrind.coffee'],
+  ]) assert.equal(isAllowedSameSiteUrl(target, base), false);
+  assert.equal(isAllowedSameSiteUrl('/menu', 'http://localhost:11222'), true);
+  assert.equal(isAllowedSameSiteUrl('http://localhost:9999', 'http://localhost:11222'), false);
+});
+
+test('fallback pins only the expected sandbox on init and rejects other null-origin frames', () => {
+  const widget = {};
+  const validate = createWidgetValidator(widget);
+  const event = (source, type, origin = 'null') => ({ source, origin, data: { type } });
+  assert.equal(validate(event({}, 'init')), false);
+  assert.equal(validate(event(widget, 'recommendation')), false);
+  assert.equal(validate(event(widget, 'init', ORDERING_ORIGIN)), false);
+  assert.equal(validate(event(widget, 'init')), true);
+  assert.equal(validate(event(widget, 'recommendation')), true);
+  assert.equal(validate(event({}, 'init')), false);
+  assert.equal(validate(event({}, 'recommendation')), false);
+  assert.equal(createWidgetValidator(null)(event(null, 'init')), false);
+});
+
+test('Origin branch preserves opaque identity, never falls back to serialized null or re-pins', (t) => {
+  // Model the opaque identity API contract; this does not simulate browser support.
+  const identity = () => ({ opaque: true, isSameOrigin(other) { return this === other; } });
+  const previous = Object.getOwnPropertyDescriptor(globalThis, 'Origin');
+  t.after(() => previous ? Object.defineProperty(globalThis, 'Origin', previous) : delete globalThis.Origin);
+  globalThis.Origin = { from(event) {
+    if (!event.internalOrigin) throw new TypeError('No internal origin');
+    return event.internalOrigin;
+  } };
+  const widget = {};
+  const first = identity();
+  const other = identity();
+  const validate = createWidgetValidator(widget);
+  const event = (internalOrigin, type = 'init', source = widget) => ({
+    origin: 'null', internalOrigin, source, data: { type },
+  });
+  assert.equal(validate(event(first, 'recommendation')), false);
+  assert.equal(validate(event(other, 'init', {})), false);
+  assert.equal(validate(event(undefined)), false);
+  assert.equal(validate(event(first)), true);
+  assert.equal(validate(event(first, 'recommendation')), true);
+  assert.equal(validate(event(other)), false);
+  assert.equal(validate(event(other, 'recommendation')), false);
+  assert.equal(validate(event(first, 'recommendation')), true);
+});
+
+test('Origin branch uses structured comparisons for URLs and synthetic ordering events', (t) => {
+  const calls = [];
+  const previous = Object.getOwnPropertyDescriptor(globalThis, 'Origin');
+  t.after(() => previous ? Object.defineProperty(globalThis, 'Origin', previous) : delete globalThis.Origin);
+  globalThis.Origin = { from(value) {
+    if (typeof value !== 'string' && !(value instanceof URL)) throw new TypeError();
+    const url = new URL(value);
+    return {
+      opaque: url.origin === 'null',
+      url,
+      isSameOrigin(other) { return url.origin === other.url.origin; },
+      isSameSite(other) { calls.push([url.href, other.url.href]); return true; },
+    };
+  } };
+  assert.equal(isTrustedOrderingMessage({ origin: ORDERING_ORIGIN }), true);
+  assert.equal(isTrustedOrderingMessage({ origin: 'null' }), false);
+  assert.equal(isAllowedSameSiteUrl('/menu', 'https://dailygrind.coffee'), true);
+  assert.deepEqual(calls, [['https://dailygrind.coffee/menu', 'https://dailygrind.coffee/']]);
+  assert.equal(isAllowedSameSiteUrl('javascript:alert(1)', 'https://dailygrind.coffee'), false);
+});
