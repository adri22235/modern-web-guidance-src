+<!doctype html>
+<html lang="en">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Coffee recommendation</title>
+<style>
+  body { margin: 8px; text-align: center; font: 1rem 'Segoe UI', sans-serif; }
+  button { background: #4e342e; color: white; border: 0; border-radius: 5px; padding: 10px 20px; cursor: pointer; }
+</style>
+<button type="button">Pick today's coffee</button>
+<script>
+  // No customer data is sent. Derive the exact parent target from the embed URL.
+  const parentOrigin = new URL(document.referrer).origin;
+  parent.postMessage({ type: 'init' }, parentOrigin);
+  document.querySelector('button').addEventListener('click', () => {
+    parent.postMessage({ type: 'recommendation', text: 'Try our Maple Oat Latte today.' }, parentOrigin);
+  });
+</script>
+</html>
diff --git a/daily-grind.mjs b/daily-grind.mjs
new file mode 100644
index 0000000..8eec45f
--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,52 @@
+import {
+  ORDERING_ORIGIN, createWidgetValidator, isAllowedSameSiteUrl,
+  isTrustedOrderingMessage, parseWebUrl,
+} from './origin-validation.mjs';
+
+const baseUrl = window.location.href;
+const status = document.querySelector('#ordering-status');
+let orderingWindow = null;
+
+document.querySelector('#order-now').addEventListener('click', (event) => {
+  event.preventDefault();
+  orderingWindow = window.open(`${ORDERING_ORIGIN}/order-online`, 'daily-grind-order');
+  if (!orderingWindow) status.textContent = 'Please allow popups to order online.';
+});
+
+const widget = document.querySelector('#coffee-widget');
+const acceptsWidgetMessage = createWidgetValidator(widget.contentWindow);
+window.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+  if (event.source === orderingWindow && orderingWindow && isTrustedOrderingMessage(event)) {
+    if (data.type === 'order-complete') {
+      status.textContent = 'Thanks! Your order has been received.';
+    } else if (data.type === 'redirect' && typeof data.url === 'string') {
+      const url = parseWebUrl(data.url, baseUrl);
+      if (url && isAllowedSameSiteUrl(url, baseUrl)) window.location.assign(url.href);
+    }
+    return;
+  }
+  if (acceptsWidgetMessage(event) && data.type === 'recommendation' &&
+      typeof data.text === 'string' && data.text.length <= 200) {
+    document.querySelector('#widget-status').textContent = data.text;
+  }
+});
+
+// Install the receiver before starting the sandbox, so its init cannot race it.
+widget.src = './coffee-widget.html';
+
+// Validate at activation as well as on load, so changed/dynamic links are covered.
+function validateLink(link) {
+  const url = parseWebUrl(link.href, baseUrl);
+  if (!url) return false;
+  if (!isAllowedSameSiteUrl(url, baseUrl)) link.relList.add('external', 'noopener', 'noreferrer');
+  return true;
+}
+document.querySelectorAll('a[href]').forEach(validateLink);
+for (const type of ['click', 'auxclick']) {
+  document.addEventListener(type, (event) => {
+    const link = event.target.closest?.('a[href]');
+    if (link && !validateLink(link)) event.preventDefault();
+  });
+}
