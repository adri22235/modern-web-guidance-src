diff --git a/test/app.test.js b/test/app.test.js
new file mode 100644
index 0000000..5855cef
--- /dev/null
+++ b/test/app.test.js
@@ -0,0 +1,94 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const { createHandler } = require('../app');
+
+const handler = createHandler({ reportOnly: false });
+function request(url, { method = 'GET', headers = {}, encrypted = false, handle = handler } = {}) {
+  const response = {
+    headers: {}, statusCode: 200,
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    end(body) { this.body = body?.toString() || ''; },
+  };
+  handle({ url, method, headers: { host: 'coffee.example', ...headers }, socket: { encrypted } }, response);
+  return response;
+}
+
+test('all public links and the stylesheet are served without exposing private files', () => {
+  const html = request('/').body;
+  for (const [, url] of html.matchAll(/href="([^"]+)"/g)) {
+    assert.equal(request(url).statusCode, 200, url);
+  }
+  assert.match(request('/styles.css').headers['content-type'], /^text\/css/);
+  for (const url of ['/server.js', '/app.js', '/package.json', '/.git/config', '/missing', '/%2e%2e/package.json']) {
+    assert.equal(request(url).statusCode, 404, url);
+  }
+});
+
+test('markup needs no inline styles, scripts, event handlers, or unsafe DOM sinks', () => {
+  const html = fs.readFileSync('index.html', 'utf8');
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle\s*=|\son\w+\s*=|javascript:/i);
+  assert.match(html, /<form action="\/logout" method="post"/);
+});
+
+test('security headers cover successful, error, asset and logout responses', () => {
+  for (const url of ['/', '/styles.css', '/missing', '/logout', '//invalid']) {
+    const res = request(url);
+    assert.match(res.headers['content-security-policy'], /script-src 'none'/);
+    assert.match(res.headers['content-security-policy'], /style-src-attr 'none'/);
+    assert.match(res.headers['content-security-policy'], /trusted-types 'none'/);
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['x-frame-options'], 'DENY');
+    assert.equal(res.headers['referrer-policy'], 'no-referrer');
+    assert.equal(res.headers['cache-control'], 'no-store');
+  }
+  assert.equal(request('/').headers['strict-transport-security'], undefined);
+  assert.equal(request('/', { encrypted: true }).headers['strict-transport-security'], 'max-age=31536000');
+});
+
+test('GET and HEAD logout requests never sign out, including speculative requests', () => {
+  for (const method of ['GET', 'HEAD']) {
+    const res = request('/logout', { method, headers: { 'sec-purpose': 'prefetch' } });
+    assert.equal(res.statusCode, 200);
+    assert.equal(res.headers['clear-site-data'], undefined);
+    assert.equal(res.headers['set-cookie'], undefined);
+    if (method === 'HEAD') assert.equal(res.body, '');
+    else assert.match(res.body, /method="post"/);
+  }
+});
+
+test('same-origin POST clears cookies and site data on both logout paths', () => {
+  for (const url of ['/logout', '/logout/']) {
+    const res = request(url, { method: 'POST', headers: { origin: 'https://coffee.example', 'sec-fetch-site': 'same-origin' } });
+    assert.equal(res.statusCode, 200);
+    assert.match(res.headers['set-cookie'], /session=;.*Max-Age=0/);
+    assert.equal(res.headers['clear-site-data'], '"cache", "cookies", "storage"');
+    assert.match(res.body, /You’re signed out/);
+  }
+});
+
+test('cross-origin and missing-origin POSTs cannot clear a session', () => {
+  for (const headers of [{}, { origin: 'null' }, { origin: 'https://evil.example' },
+    { origin: 'https://coffee.example', 'sec-fetch-site': 'cross-site' }]) {
+    const res = request('/logout', { method: 'POST', headers });
+    assert.equal(res.statusCode, 403);
+    assert.equal(res.headers['clear-site-data'], undefined);
+    assert.equal(res.headers['set-cookie'], undefined);
+  }
+});
+
+test('HEAD is bodyless; unsupported methods and malformed targets fail safely', () => {
+  assert.equal(request('/', { method: 'HEAD' }).body, '');
+  assert.equal(request('//evil.example').statusCode, 400);
+  assert.equal(request('/', { method: 'POST' }).statusCode, 405);
+  const res = request('/logout', { method: 'DELETE' });
+  assert.equal(res.statusCode, 405);
