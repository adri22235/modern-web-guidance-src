new file mode 100644
index 0000000..8042edf
--- /dev/null
+++ b/app.js
@@ -0,0 +1,85 @@
+const fs = require('node:fs');
+const path = require('node:path');
+
+const policy = [
+  "default-src 'none'", "script-src 'none'", "script-src-attr 'none'",
+  "style-src 'self'", "style-src-attr 'none'",
+  'img-src https://images.unsplash.com', "base-uri 'none'",
+  "object-src 'none'", "frame-ancestors 'none'", "form-action 'self'",
+  "require-trusted-types-for 'script'", "trusted-types 'none'",
+].join('; ');
+
+const pageRoutes = new Set([
+  '/', '/menu', '/locations', '/rewards', '/account', '/order-online',
+  '/menu/seasonal', '/menu/espresso', '/menu/cold-brew', '/about',
+  '/careers', '/contact', '/privacy-policy', '/index.html',
+]);
+
+function logoutPage(complete) {
+  return `<!DOCTYPE html>
+<html lang="en"><head><meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>${complete ? 'Signed out' : 'Sign out'} | The Daily Grind</title>
+<link rel="stylesheet" href="/styles.css"></head>
+<body><main class="container logout-message"><h1>${complete ? 'You’re signed out' : 'Sign out'}</h1>
+${complete ? '<p>Your browsing session has ended.</p><a class="btn" href="/">Back to The Daily Grind</a>' : '<form action="/logout" method="post"><button class="btn" type="submit">Sign out</button></form>'}
+</main></body></html>`;
+}
+
+function createHandler({ reportOnly = process.env.CSP_REPORT_ONLY === '1' } = {}) {
+  // Only explicitly public files are served, never source or package metadata.
+  const html = fs.readFileSync(path.join(__dirname, 'index.html'));
+  const css = fs.readFileSync(path.join(__dirname, 'styles.css'));
+
+  return (req, res) => {
+    res.setHeader(reportOnly ? 'Content-Security-Policy-Report-Only' : 'Content-Security-Policy', policy);
+    res.setHeader('X-Frame-Options', 'DENY');
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=()');
+    res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+    res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+    res.setHeader('Cache-Control', 'no-store');
+    res.setHeader('X-DNS-Prefetch-Control', 'off');
+    // TLS-terminating proxies must set HSTS themselves; do not trust forwarded headers.
+    if (req.socket?.encrypted) res.setHeader('Strict-Transport-Security', 'max-age=31536000');
+
+    const send = (status, body, type = 'text/html; charset=utf-8') => {
+      res.statusCode = status;
+      res.setHeader('Content-Type', type);
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    let pathname;
+    try {
+      if (!req.url.startsWith('/') || req.url.startsWith('//')) throw new Error('Invalid target');
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return send(400, 'Bad request', 'text/plain; charset=utf-8');
+    }
+
+    const logout = pathname === '/logout' || pathname === '/logout/';
+    if (logout && req.method === 'POST') {
+      // Same-origin form POST prevents cross-site logout and speculative GETs.
+      let origin;
+      try { origin = new URL(req.headers.origin); } catch { /* Rejected below. */ }
+      if (!origin || !['http:', 'https:'].includes(origin.protocol) ||
+          origin.host !== req.headers.host || req.headers['sec-fetch-site'] === 'cross-site') {
+        return send(403, 'Forbidden', 'text/plain; charset=utf-8');
+      }
+      // No authentication backend exists. Reserve 'session' for any future integration.
+      res.setHeader('Set-Cookie', 'session=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; SameSite=Lax');
+      res.setHeader('Clear-Site-Data', '"cache", "cookies", "storage"');
+      return send(200, logoutPage(true));
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', logout ? 'GET, HEAD, POST' : 'GET, HEAD');
+      return send(405, 'Method not allowed', 'text/plain; charset=utf-8');
+    }
+    if (logout) return send(200, logoutPage(false));
+    if (pathname === '/styles.css') return send(200, css, 'text/css; charset=utf-8');
+    if (pageRoutes.has(pathname)) return send(200, html);
+    return send(404, 'Not found', 'text/plain; charset=utf-8');
+  };
+}
+
+module.exports = { createHandler };
