--- /dev/null
+++ b/app.js
@@ -0,0 +1,123 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+
+// Explicit assets prevent access to source, configuration, and arbitrary files.
+const pages = new Set([
+  '/', '/index.html', '/menu', '/locations', '/rewards', '/account',
+  '/order-online', '/menu/seasonal', '/menu/espresso', '/menu/cold-brew',
+  '/about', '/careers', '/contact', '/privacy-policy',
+]);
+const policy = [
+  "default-src 'none'", "script-src 'none'", "script-src-attr 'none'",
+  "style-src 'self'", "style-src-attr 'none'",
+  "img-src 'self' https://images.unsplash.com", "connect-src 'none'",
+  "object-src 'none'", "base-uri 'none'", "frame-ancestors 'none'",
+  "form-action 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'",
+  'report-to default', 'report-uri /security-reports',
+].join('; ');
+
+function createHandler({
+  policyMode = process.env.SECURITY_POLICY_MODE || 'enforce',
+  httpsOnly = process.env.HTTPS_ONLY === '1',
+  sessionCookie = process.env.SESSION_COOKIE_NAME || '__Host-session',
+  onReport = (summary) => console.info('security-policy-report', JSON.stringify(summary)),
+} = {}) {
+  if (!['enforce', 'report-only'].includes(policyMode)) throw new Error('Invalid SECURITY_POLICY_MODE');
+  if (!/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(sessionCookie)) throw new Error('Invalid SESSION_COOKIE_NAME');
+  const html = fs.readFileSync(path.join(__dirname, 'index.html'));
+  const css = fs.readFileSync(path.join(__dirname, 'styles.css'));
+
+  return async function handle(req, res) {
+    const headers = {
+      'Cache-Control': 'no-store',
+      'X-Content-Type-Options': 'nosniff',
+      'X-Frame-Options': 'DENY',
+      'Referrer-Policy': 'no-referrer',
+      'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), focus-without-user-activation=()',
+      'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+      'Cross-Origin-Resource-Policy': 'same-origin',
+      'Reporting-Endpoints': 'default="/security-reports"',
+      Vary: 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+      'Content-Security-Policy': policyMode === 'enforce' ? policy : "frame-ancestors 'none'; base-uri 'none'; object-src 'none'",
+    };
+    if (policyMode === 'report-only') headers['Content-Security-Policy-Report-Only'] = policy;
+    // Opt in only after HTTPS is configured at the deployment's reverse proxy.
+    if (httpsOnly) headers['Strict-Transport-Security'] = 'max-age=300';
+
+    const send = (status, body = '', type = 'text/plain; charset=utf-8', extra = {}) => {
+      res.writeHead(status, { ...headers, 'Content-Type': type, ...extra });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+
+    let pathname;
+    try {
+      // Never trust the Host header or treat an absolute request target as a local route.
+      if (!req.url.startsWith('/') || req.url.startsWith('//')) throw new Error('Invalid target');
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return send(400, 'Bad request');
+    }
+
+    const site = req.headers['sec-fetch-site'];
+    const logout = pathname === '/logout' || pathname === '/logout/';
+    const navigation = ['GET', 'HEAD'].includes(req.method)
+      && req.headers['sec-fetch-mode'] === 'navigate'
+      && req.headers['sec-fetch-dest'] === 'document';
+    if ((site === 'cross-site' || site === 'same-site') && (logout || !navigation)) {
+      return send(403, 'Forbidden');
+    }
+
+    if (pathname === '/security-reports') {
+      if (req.method !== 'POST') return send(405, 'Method not allowed', undefined, { Allow: 'POST' });
+      const type = (req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+      if (!['application/csp-report', 'application/reports+json'].includes(type)) return send(415, 'Unsupported media type');
+      // Reports are untrusted input. Bound memory and log volume per request.
+      let length = 0;
+      const chunks = [];
+      try {
+        for await (const chunk of req) {
+          length += Buffer.byteLength(chunk);
+          if (length > 16384) return send(413, 'Report too large');
+          chunks.push(Buffer.from(chunk));
+        }
+        const payload = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+        const reports = Array.isArray(payload) ? payload : [payload];
+        if (!reports.length || reports.length > 20) return send(400, 'Invalid reports');
+        const summaries = reports.map((report) => {
+          const body = report?.['csp-report'] || report?.body;
+          const directive = body?.['effective-directive'] || body?.effectiveDirective;
+          if (typeof directive !== 'string' || !/^[a-z-]{1,64}$/.test(directive)) throw new Error('Invalid report');
+          return { directive, disposition: body.disposition === 'report' ? 'report' : 'enforce' };
+        });
+        // Exclude URLs, samples, cookies, headers, and arbitrary user-supplied fields.
+        for (const summary of summaries) onReport(summary);
+        return send(204);
+      } catch {
+        return send(400, 'Invalid reports');
+      }
+    }
+
+    if (!['GET', 'HEAD', ...(logout ? ['POST'] : [])].includes(req.method)) {
+      return send(405, 'Method not allowed', undefined, { Allow: logout ? 'GET, HEAD, POST' : 'GET, HEAD' });
+    }
+    if (logout) {
+      // Do not let speculative fetching or link previews sign the visitor out.
+      if (/prefetch|prerender/i.test(`${req.headers['sec-purpose'] || ''} ${req.headers.purpose || ''}`)) {
+        return send(204);
+      }
+      if (req.method === 'HEAD') return send(200);
+      const secure = httpsOnly || Boolean(req.socket?.encrypted) || sessionCookie.startsWith('__Host-') || sessionCookie.startsWith('__Secure-');
+      return send(200, '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Signed out | The Daily Grind</title></head><body><main><h1>You are signed out</h1><p><a href="/">Return to The Daily Grind</a></p></main></body></html>', 'text/html; charset=utf-8', {
+        'Clear-Site-Data': '"cookies", "storage", "cache"',
+        'Set-Cookie': `${sessionCookie}=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Path=/; HttpOnly; SameSite=Lax${secure ? '; Secure' : ''}`,
+      });
+    }
+    if (pathname === '/styles.css') return send(200, css, 'text/css; charset=utf-8');
+    if (pages.has(pathname)) return send(200, html, 'text/html; charset=utf-8');
+    return send(404, 'Not found');
+  };
+}
+
+module.exports = { createHandler };
