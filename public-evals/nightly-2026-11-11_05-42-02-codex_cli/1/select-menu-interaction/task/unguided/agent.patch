+  <script>
+    const orderForm = document.getElementById('order-form');
+    const localShop = document.getElementById('local-shop');
+    const shopError = document.getElementById('local-shop-error');
+
+    // Keep native required validation as a fallback when JavaScript is unavailable.
+    orderForm.noValidate = true;
+
+    function validateShop() {
+      const isValid = localShop.validity.valid;
+      shopError.hidden = isValid;
+      shopError.textContent = isValid ? '' : 'Please select your local shop.';
+      localShop.setAttribute('aria-invalid', String(!isValid));
+      return isValid;
+    }
+
+    localShop.addEventListener('blur', validateShop);
+    localShop.addEventListener('change', validateShop);
+    orderForm.addEventListener('submit', (event) => {
+      if (!validateShop()) {
+        event.preventDefault();
+        localShop.focus();
+      }
+    });
+    orderForm.addEventListener('reset', () => {
+      shopError.hidden = true;
+      shopError.textContent = '';
+      localShop.removeAttribute('aria-invalid');
+    });
+  </script>
+
 </body>
 
