+  <script>
+    const shop = document.getElementById('local-shop');
+    const shopError = document.getElementById('shop-error');
+    const announcement = document.getElementById('order-announcement');
+    let interacted = false;
+    let announceTimer;
+
+    function updateShopError(showError, announce = false) {
+      const wasInvalid = shop.getAttribute('aria-invalid') === 'true';
+      shop.setAttribute('aria-invalid', String(showError));
+      if (showError) shop.setAttribute('aria-describedby', shopError.id);
+      else shop.removeAttribute('aria-describedby');
+      clearTimeout(announceTimer);
+      announcement.textContent = '';
+      if (showError && !wasInvalid && announce) {
+        announceTimer = setTimeout(() => {
+          announcement.textContent = shopError.textContent;
+        }, 500);
+      }
+    }
+
+    shop.addEventListener('change', () => {
+      interacted = true;
+      updateShopError(!shop.validity.valid, true);
+    });
+    shop.addEventListener('input', () => {
+      if (shop.validity.valid) updateShopError(false);
+    });
+    shop.addEventListener('blur', () => {
+      if (interacted) updateShopError(!shop.validity.valid, true);
+    });
+    // Native validation blocks submission and focuses the required select.
+    shop.addEventListener('invalid', () => {
+      interacted = true;
+      updateShopError(true);
+    });
+    shop.form.addEventListener('reset', () => {
+      interacted = false;
+      updateShopError(false);
+    });
+  </script>
+
