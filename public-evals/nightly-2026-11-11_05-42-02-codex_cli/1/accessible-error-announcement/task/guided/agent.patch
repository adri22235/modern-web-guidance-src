+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const error = document.getElementById('newsletter-email-error');
+    const announcer = document.getElementById('newsletter-announcer');
+    const status = newsletter.querySelector('.newsletter-status');
+    let announcementTimer;
+    let announced = false;
+
+    function syncEmailError(announce = false) {
+      // Match the visual state, not the untouched field's raw validity.
+      const shown = email.matches(':user-invalid');
+      email.setAttribute('aria-invalid', String(shown));
+      if (shown) {
+        email.setAttribute('aria-describedby', error.id);
+        if (announce && !announced) {
+          announced = true;
+          announcementTimer = setTimeout(() => {
+            // The user may have fixed the value while this announcement waited.
+            if (email.matches(':user-invalid')) {
+              announcer.textContent = `Email address: ${error.textContent}`;
+            }
+          }, 500);
+        }
+      } else {
+        email.removeAttribute('aria-describedby');
+        clearTimeout(announcementTimer);
+        announcer.textContent = '';
+        announced = false;
+      }
+    }
+
+    function syncAfterInteraction() {
+      syncEmailError(true);
+      // Native interaction flags can settle after blur/change/invalid dispatch.
+      requestAnimationFrame(() => syncEmailError(true));
+    }
+
+    email.addEventListener('blur', syncAfterInteraction);
+    email.addEventListener('change', syncAfterInteraction);
+    email.addEventListener('invalid', syncAfterInteraction);
+    email.addEventListener('input', () => {
+      status.textContent = '';
+      syncEmailError();
+      requestAnimationFrame(() => syncEmailError());
+    });
+    newsletter.addEventListener('reset', () => {
+      status.textContent = '';
+      requestAnimationFrame(() => syncEmailError());
+    });
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncEmailError();
+      // This static site has no newsletter subscription endpoint yet.
+      status.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+    syncEmailError();
+  </script>
+
 </body>
 
