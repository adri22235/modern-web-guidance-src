+  <script>
+    (() => {
+      const definitions = {
+        urgent: { label: 'Checkout', priority: 0, steps: 35 },
+        standard: { label: 'Menu update', priority: 1, steps: 70 },
+        background: { label: 'Telemetry logging', priority: 2, steps: 100 }
+      };
+      const queue = [];
+      const activity = [];
+      let nextId = 0;
+      let completed = 0;
+      let scheduled = false;
+      let activeId = null;
+      const list = document.getElementById('queue-list');
+      const status = document.getElementById('queue-status');
+
+      function log(message) {
+        activity.unshift({ message, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) });
+        activity.length = Math.min(activity.length, 20);
+        document.getElementById('activity-list').replaceChildren(...activity.map(entry => {
+          const item = document.createElement('li');
+          const time = document.createElement('time');
+          time.textContent = entry.time;
+          item.append(time, document.createTextNode(entry.message));
+          return item;
+        }));
+      }
+
+      function render() {
+        document.getElementById('queue-count').textContent = `${queue.length} pending`;
+        document.getElementById('completed-count').textContent = `${completed} completed`;
+        const current = queue[0];
+        const statusText = current ? `Running ${current.label.toLowerCase()}` : 'Ready for tasks';
+        if (status.textContent !== statusText) status.textContent = statusText;
+        if (!current) {
+          const empty = document.createElement('li');
+          empty.className = 'queue-empty';
+          empty.textContent = 'All clear. Add a task to get started.';
+          list.replaceChildren(empty);
+          return;
+        }
+        list.replaceChildren(...queue.map((task, index) => {
+          const item = document.createElement('li');
+          item.className = 'queue-task';
+          const heading = document.createElement('div');
+          heading.className = 'task-heading';
+          const label = document.createElement('span');
+          label.textContent = `${task.label} #${task.id}`;
+          const state = document.createElement('span');
+          state.className = 'task-state';
+          const percent = Math.round(task.done / task.steps * 100);
+          state.textContent = `${task.kind} · ${index === 0 ? `${percent}%` : task.done ? 'Paused' : 'Queued'}`;
+          heading.append(label, state);
+          const progress = document.createElement('progress');
+          progress.max = task.steps;
+          progress.value = task.done;
+          progress.setAttribute('aria-label', `${task.label} #${task.id} progress`);
+          item.append(heading, progress);
+          return item;
+        }));
+      }
+
+      function enqueue(kinds) {
+        for (const kind of kinds) {
+          const task = { ...definitions[kind], kind, id: ++nextId, done: 0 };
+          queue.push(task);
+          log(`${task.label} #${task.id} queued · ${kind}`);
+        }
+        // Stable FIFO order within each priority, reconsidered after every chunk.
+        queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+        render();
+        if (!scheduled) {
+          scheduled = true;
+          setTimeout(runChunk, 0);
+        }
+      }
+
+      function runChunk() {
+        const task = queue[0];
+        if (!task) {
+          scheduled = false;
+          activeId = null;
+          render();
+          return;
+        }
+        if (activeId !== task.id) {
+          if (activeId !== null && queue.some(item => item.id === activeId)) {
+            log(`Higher-priority work arrived · pausing task #${activeId}`);
+          }
+          log(`${task.done ? 'Resumed' : 'Started'} ${task.label.toLowerCase()} #${task.id}`);
+          activeId = task.id;
+        }
+        // Bound CPU work to 4ms, then yield to input, rendering, and new tasks.
+        const deadline = performance.now() + 4;
+        while (performance.now() < deadline) {
+          task.checksum = ((task.checksum || 0) + 1) % 1000003;
+        }
+        task.done++;
+        if (task.done === task.steps) {
+          queue.shift();
+          completed++;
+          log(`Completed ${task.label.toLowerCase()} #${task.id}`);
+          activeId = null;
+        }
+        render();
+        // A timer yield also works in browsers without the Scheduler API.
+        setTimeout(runChunk, 20);
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        enqueue(['background', 'standard', 'urgent']);
+      });
+    })();
+  </script>
 </body>
 
