   </footer>
 
+  <div id="latte-tooltip" class="info-tooltip" role="tooltip" data-placement="top" hidden>
+    Made with oat milk and Vermont maple syrup for a creamy, gently sweet seasonal sip.
+    <span class="tooltip-arrow" aria-hidden="true"></span>
+  </div>
+
+  <script>
+    const anchor = document.getElementById('anchor');
+    const tooltip = document.getElementById('latte-tooltip');
+    const arrow = tooltip.querySelector('.tooltip-arrow');
+    let closeTimer;
+
+    function positionTooltip() {
+      if (tooltip.hidden) return;
+      const rect = anchor.getBoundingClientRect();
+      const { width, height } = tooltip.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const left = (viewport?.offsetLeft ?? 0) + 12;
+      const top = (viewport?.offsetTop ?? 0) + 12;
+      const right = left + (viewport?.width ?? document.documentElement.clientWidth) - 24;
+      const bottom = top + (viewport?.height ?? document.documentElement.clientHeight) - 24;
+      const centerX = rect.left + rect.width / 2;
+      const centerY = rect.top + rect.height / 2;
+      const gap = 12;
+      const candidates = [
+        { side: 'top', x: centerX - width / 2, y: rect.top - height - gap },
+        { side: 'bottom', x: centerX - width / 2, y: rect.bottom + gap },
+        { side: 'right', x: rect.right + gap, y: centerY - height / 2 },
+        { side: 'left', x: rect.left - width - gap, y: centerY - height / 2 }
+      ];
+      const overflow = ({ x, y }) => Math.max(left - x, 0) + Math.max(x + width - right, 0)
+        + Math.max(top - y, 0) + Math.max(y + height - bottom, 0);
+      const best = candidates.reduce((a, b) => overflow(b) < overflow(a) ? b : a);
+      const clamp = (value, min, max) => Math.max(min, Math.min(value, max));
+      const x = clamp(best.x, left, right - width);
+      const y = clamp(best.y, top, bottom - height);
+      tooltip.style.left = `${x}px`;
+      tooltip.style.top = `${y}px`;
+      tooltip.dataset.placement = best.side;
+      const vertical = best.side === 'top' || best.side === 'bottom';
+      arrow.style.left = vertical ? `${clamp(centerX - x - 5, 12, width - 22)}px` : '';
+      arrow.style.top = vertical ? '' : `${clamp(centerY - y - 5, 12, height - 22)}px`;
+    }
+
+    function showTooltip() {
+      clearTimeout(closeTimer);
+      tooltip.hidden = false;
+      anchor.setAttribute('aria-expanded', 'true');
+      positionTooltip();
+    }
+
+    function hideTooltip() {
+      clearTimeout(closeTimer);
+      tooltip.hidden = true;
+      anchor.setAttribute('aria-expanded', 'false');
+    }
+
+    const scheduleClose = () => { closeTimer = setTimeout(hideTooltip, 150); };
+    anchor.addEventListener('mouseenter', showTooltip);
+    anchor.addEventListener('mouseleave', scheduleClose);
+    anchor.addEventListener('focus', showTooltip);
+    anchor.addEventListener('blur', hideTooltip);
+    anchor.addEventListener('click', showTooltip);
+    tooltip.addEventListener('mouseenter', () => clearTimeout(closeTimer));
+    tooltip.addEventListener('mouseleave', scheduleClose);
+    document.addEventListener('pointerdown', (event) => {
+      if (!anchor.contains(event.target) && !tooltip.contains(event.target)) hideTooltip();
+    });
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') hideTooltip();
+    });
+    window.addEventListener('resize', positionTooltip);
+    window.addEventListener('scroll', positionTooltip, true);
+    window.visualViewport?.addEventListener('resize', positionTooltip);
+    window.visualViewport?.addEventListener('scroll', positionTooltip);
+    new ResizeObserver(positionTooltip).observe(tooltip);
+  </script>
