+  <script>
+    const anchor = document.getElementById('anchor');
+    const tooltip = document.getElementById('latte-tooltip');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativePosition = nativePopover && CSS.supports('anchor-name: --info') &&
+      CSS.supports('container-type: anchored');
+    let isOpen = false;
+    let frame;
+
+    // Browsers without anchored queries use the same placement for both bubble and arrow.
+    function positionTooltip() {
+      if (!isOpen || nativePosition) return;
+      const bounds = anchor.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 12;
+      const topEdge = (viewport?.offsetTop ?? 0) + 12;
+      const rightEdge = leftEdge + (viewport?.width ?? innerWidth) - 24;
+      const bottomEdge = topEdge + (viewport?.height ?? innerHeight) - 24;
+      const gap = 12;
+      tooltip.style.width = `${Math.min(260, rightEdge - leftEdge)}px`;
+      tooltip.style.removeProperty('--tooltip-max-height');
+      const height = tooltip.offsetHeight;
+      const above = bounds.top - topEdge - gap;
+      const below = bottomEdge - bounds.bottom - gap;
+      const side = above >= height || above >= below ? 'top' : 'bottom';
+      const available = Math.max(0, side === 'top' ? above : below);
+      tooltip.style.setProperty('--tooltip-max-height', `${Math.max(0, available - 28)}px`);
+      const width = tooltip.offsetWidth;
+      const center = bounds.left + bounds.width / 2;
+      const left = Math.max(leftEdge, Math.min(center - width / 2, rightEdge - width));
+      const top = side === 'top' ? bounds.top - gap - tooltip.offsetHeight : bounds.bottom + gap;
+      tooltip.style.left = `${left}px`;
+      tooltip.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - tooltip.offsetHeight))}px`;
+      tooltip.style.setProperty('--arrow-x', `${Math.max(12, Math.min(center - left, width - 12))}px`);
+      tooltip.dataset.side = side;
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(frame);
+      frame = requestAnimationFrame(positionTooltip);
+    }
+
+    function closeTooltip() {
+      if (nativePopover) tooltip.hidePopover();
+      else {
+        tooltip.hidden = true;
+        isOpen = false;
+        anchor.setAttribute('aria-expanded', 'false');
+      }
+    }
+
+    if (!nativePosition) tooltip.classList.add('manual-position');
+    if (nativePopover) {
+      tooltip.addEventListener('toggle', (event) => {
+        isOpen = event.newState === 'open';
+        positionTooltip();
+      });
+    } else {
+      tooltip.hidden = true;
+      anchor.setAttribute('aria-expanded', 'false');
+      anchor.addEventListener('click', () => {
+        isOpen = !isOpen;
+        tooltip.hidden = !isOpen;
+        anchor.setAttribute('aria-expanded', String(isOpen));
+        positionTooltip();
+      });
+      document.addEventListener('click', (event) => {
+        if (!anchor.contains(event.target) && !tooltip.contains(event.target)) closeTooltip();
+      });
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') closeTooltip();
+      });
+    }
+    // Keep the tooltip from covering the next control when keyboard focus moves on.
+    anchor.addEventListener('blur', closeTooltip);
+    window.addEventListener('resize', schedulePosition);
+    window.addEventListener('scroll', schedulePosition, { capture: true, passive: true });
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+  </script>
