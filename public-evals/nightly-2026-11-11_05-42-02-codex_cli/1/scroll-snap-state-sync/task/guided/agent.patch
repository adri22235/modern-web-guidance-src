+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = [...panel.querySelectorAll('.drink-section h3')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function setActive(heading) {
+      links.forEach(link => {
+        if (link.hash === `#${heading.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncSettledSection() {
+      const snapTop = panel.getBoundingClientRect().top
+        + parseFloat(getComputedStyle(panel).scrollPaddingBlockStart);
+      const nearest = headings.reduce((closest, heading) =>
+        Math.abs(heading.getBoundingClientRect().top - snapTop)
+          < Math.abs(closest.getBoundingClientRect().top - snapTop) ? heading : closest);
+      setActive(nearest);
+    }
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (headings.includes(event.snapTargetBlock)) setActive(event.snapTargetBlock);
+      });
+    } else {
+      // Observe visibility, but commit the active link only after scrolling settles.
+      let settleTimer;
+      const scheduleSync = () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(syncSettledSection, 150);
+      };
+      const observer = new IntersectionObserver(scheduleSync, { root: panel });
+      headings.forEach(heading => observer.observe(heading));
+      panel.addEventListener('scroll', scheduleSync, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        clearTimeout(settleTimer);
+        syncSettledSection();
+      });
+    }
+
+    function navigateTo(heading, behavior) {
+      heading.focus({ preventScroll: true });
+      const top = panel.scrollTop + heading.getBoundingClientRect().top
+        - panel.getBoundingClientRect().top
+        - parseFloat(getComputedStyle(panel).scrollPaddingBlockStart);
+      const alreadyAligned = Math.abs(panel.scrollTop - top) < 1;
+      panel.scrollTo({ top, behavior });
+      // Smooth navigation updates via the settle event, including in the fallback.
+      if (behavior === 'instant' || alreadyAligned) syncSettledSection();
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        history.pushState(null, '', link.hash);
+        navigateTo(document.getElementById(link.hash.slice(1)), reducedMotion.matches ? 'instant' : 'smooth');
+      });
+    });
+
+    function restoreFragment() {
+      const heading = headings.find(heading => `#${heading.id}` === location.hash);
+      if (heading) navigateTo(heading, 'instant');
+      else syncSettledSection();
+    }
+
+    window.addEventListener('hashchange', restoreFragment);
+    restoreFragment();
+  </script>
+
