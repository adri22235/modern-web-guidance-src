+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = links.map(link => document.getElementById(link.hash.slice(1)));
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let settleTimer;
+
+    function updateActiveLink() {
+      const snapTop = panel.getBoundingClientRect().top + parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      const activeHeader = headers.reduce((closest, header) =>
+        Math.abs(header.getBoundingClientRect().top - snapTop) <
+        Math.abs(closest.getBoundingClientRect().top - snapTop) ? header : closest
+      );
+
+      links.forEach((link, index) => {
+        const active = headers[index] === activeHeader;
+        link.classList.toggle('is-active', active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scrollToHeader(header, behavior) {
+      const top = panel.scrollTop + header.getBoundingClientRect().top -
+        panel.getBoundingClientRect().top - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      panel.scrollTo({ top, behavior });
+    }
+
+    links.forEach((link, index) => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        history.pushState(null, '', link.hash);
+        headers[index].focus({ preventScroll: true });
+        scrollToHeader(headers[index], reducedMotion.matches ? 'instant' : 'smooth');
+        // Also update when selecting the section already in view.
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(updateActiveLink, 180);
+      });
+    });
+
+    // scrollend covers snapping and smooth scrolling; the timer supports older browsers.
+    panel.addEventListener('scrollend', updateActiveLink);
+    panel.addEventListener('scroll', () => {
+      clearTimeout(settleTimer);
+      settleTimer = setTimeout(updateActiveLink, 180);
+    }, { passive: true });
+
+    function restoreHash() {
+      const header = headers.find(header => '#' + header.id === location.hash);
+      if (header) scrollToHeader(header, 'instant');
+      updateActiveLink();
+    }
+
+    window.addEventListener('hashchange', restoreHash);
+    restoreHash();
+  </script>
