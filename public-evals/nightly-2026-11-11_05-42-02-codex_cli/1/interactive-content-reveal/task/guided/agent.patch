+  <script>
+    document.querySelectorAll('.product-card').forEach((card) => {
+      const updateSpotlight = (event) => {
+        if (event.pointerType === 'touch') return;
+
+        // Read current bounds so scrolling and layout changes cannot offset the reveal.
+        const rect = card.getBoundingClientRect();
+        card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
+        card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
+        card.setAttribute('data-spotlight', '');
+      };
+
+      const resetSpotlight = () => card.removeAttribute('data-spotlight');
+      card.addEventListener('pointerenter', updateSpotlight);
+      card.addEventListener('pointermove', updateSpotlight);
+      card.addEventListener('pointerleave', resetSpotlight);
+      card.addEventListener('pointercancel', resetSpotlight);
+      window.addEventListener('blur', resetSpotlight);
+    });
+  </script>
