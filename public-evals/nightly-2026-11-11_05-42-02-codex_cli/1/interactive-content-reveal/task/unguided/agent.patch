+      background: #fff3e0;
+    }
+
+    @media (hover: hover) and (pointer: fine) {
+      .spotlight-ready .product-spotlight {
+        -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
