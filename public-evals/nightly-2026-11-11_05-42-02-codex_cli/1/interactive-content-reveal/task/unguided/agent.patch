+  <script>
+    const spotlightSupported = CSS.supports('mask-image', 'radial-gradient(black, transparent)')
+      || CSS.supports('-webkit-mask-image', 'radial-gradient(black, transparent)');
+
+    if (spotlightSupported) {
+      document.querySelectorAll('.product-card').forEach((card) => {
+        card.classList.add('spotlight-ready');
+
+        const moveSpotlight = (event) => {
+          const bounds = card.getBoundingClientRect();
+          card.style.setProperty('--mouse-x', `${event.clientX - bounds.left}px`);
+          card.style.setProperty('--mouse-y', `${event.clientY - bounds.top}px`);
+        };
+
+        const resetSpotlight = () => {
+          card.style.setProperty('--inner-size', '0px');
+          card.style.setProperty('--outer-size', '0px');
+        };
+
+        card.addEventListener('pointerenter', (event) => {
+          if (event.pointerType === 'touch') return;
+          moveSpotlight(event);
+          card.style.setProperty('--inner-size', '110px');
+          card.style.setProperty('--outer-size', '180px');
+        });
+        card.addEventListener('pointermove', (event) => {
+          if (event.pointerType !== 'touch') moveSpotlight(event);
+        });
+        card.addEventListener('pointerleave', resetSpotlight);
+        card.addEventListener('pointercancel', resetSpotlight);
+      });
+    }
+  </script>
