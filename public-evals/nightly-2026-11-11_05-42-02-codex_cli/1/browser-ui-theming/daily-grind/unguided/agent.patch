+      const extras = order.getAll('extra');
+      const notes = order.get('notes').trim();
+      document.getElementById('order-status').textContent =
+        `${order.get('size')} ${order.get('temperature').toLowerCase()} ${order.get('coffee')} with ${order.get('milk').toLowerCase()} milk, ${sweetness[Number(order.get('sweetness'))]}` +
+        `${extras.length ? `; ${extras.join(', ')}` : ''}. Pickup: ${order.get('pickup-date')} at ${order.get('pickup-time')}. ` +
+        `Sleeve color: ${order.get('sleeve-color')}.${notes ? ` Special requests: ${notes}` : ''} This is a preview; your order has not been placed.`;
