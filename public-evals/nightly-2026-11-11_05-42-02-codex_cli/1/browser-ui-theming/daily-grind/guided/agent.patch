+
+    form.addEventListener('input', () => { summary.textContent = ''; });
+    form.addEventListener('change', () => { summary.textContent = ''; });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      const coffee = form.elements.coffee.selectedOptions[0].textContent;
+      const milk = form.elements.milk.selectedOptions[0].textContent;
+      const extras = data.getAll('extras');
+      const pickup = [data.get('pickup_date'), data.get('pickup_time')].filter(Boolean).join(' at ');
+      summary.textContent = `${data.get('size')} ${coffee}, ${milk.toLowerCase()}, sweetness ${data.get('sweetness')} of 4.${extras.length ? ` Extras: ${extras.join(', ')}.` : ''}${pickup ? ` Requested pickup: ${pickup}.` : ''}${data.get('notes').trim() ? ` Special requests: ${data.get('notes').trim()}.` : ''} Your drink is ready to review; no order has been placed.`;
+    });
