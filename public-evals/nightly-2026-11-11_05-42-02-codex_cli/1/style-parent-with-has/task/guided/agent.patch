+  <script>
+    const contactForm = document.getElementById('contact-form');
+    const contactFields = [...contactForm.querySelectorAll('input, textarea')];
+    const announcer = document.getElementById('contact-announcer');
+    const contactStatus = document.getElementById('contact-status');
+    let announcementTimer;
+
+    function updateConstraint(field) {
+      // Treat whitespace-only names and messages as empty without restricting names.
+      field.setCustomValidity(field.value.trim() ? '' : 'Please fill out this field.');
+    }
+
+    function syncError(field, invalid, announce = false) {
+      const wasInvalid = field.getAttribute('aria-invalid') === 'true';
+      field.setAttribute('aria-invalid', String(invalid));
+      field.closest('.contact-field').classList.toggle('has-error', invalid);
+      if (invalid) {
+        field.setAttribute('aria-describedby', field.dataset.error);
+      } else {
+        field.removeAttribute('aria-describedby');
+      }
+      if (!invalid || announce) {
+        clearTimeout(announcementTimer);
+        announcer.textContent = '';
+      }
+      if (invalid && announce && !wasInvalid) {
+        announcementTimer = setTimeout(() => {
+          announcer.textContent = document.getElementById(field.dataset.error).textContent;
+        }, 500);
+      }
+    }
+
+    contactFields.forEach((field) => {
+      field.addEventListener('blur', () => {
+        updateConstraint(field);
+        syncError(field, !field.validity.valid, true);
+      });
+      field.addEventListener('input', () => {
+        updateConstraint(field);
+        contactStatus.textContent = '';
+        // Clear corrected errors immediately; defer new errors until blur or submit.
+        syncError(field, !field.validity.valid && (
+          field.getAttribute('aria-invalid') === 'true' || field.matches(':user-invalid')
+        ));
+      });
+      field.addEventListener('invalid', () => {
+        clearTimeout(announcementTimer);
+        announcer.textContent = '';
+        syncError(field, true);
+      });
+    });
+
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // No delivery endpoint is configured; preserve the customer's draft.
+      contactStatus.textContent = 'Your message has not been sent. Message delivery is not connected yet.';
+    });
+  </script>
