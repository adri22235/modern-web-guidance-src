+  <script>
+    const contactForm = document.getElementById('contact-form');
+    const contactFields = [...contactForm.querySelectorAll('input, textarea')];
+    const contactStatus = document.getElementById('contact-status');
+    const touchedFields = new Set();
+
+    function validateField(field) {
+      const error = document.getElementById(field.getAttribute('aria-describedby'));
+      let message = '';
+
+      // Trim for validation so whitespace alone never satisfies a required field.
+      field.setCustomValidity('');
+      if (!field.value.trim()) {
+        message = `Please enter your ${field.name}.`;
+      } else if (field.validity.typeMismatch) {
+        message = 'Please enter a valid email address, such as name@example.com.';
+      }
+
+      field.setCustomValidity(message);
+      field.closest('.form-field').classList.toggle('has-error', Boolean(message));
+      field.setAttribute('aria-invalid', String(Boolean(message)));
+      error.textContent = message;
+      error.hidden = !message;
+      return !message;
+    }
+
+    contactFields.forEach((field) => {
+      field.addEventListener('blur', () => {
+        touchedFields.add(field);
+        validateField(field);
+      });
+      field.addEventListener('input', () => {
+        contactStatus.textContent = '';
+        if (touchedFields.has(field)) validateField(field);
+      });
+    });
+
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      let firstInvalidField;
+      contactFields.forEach((field) => {
+        touchedFields.add(field);
+        if (!validateField(field) && !firstInvalidField) firstInvalidField = field;
+      });
+
+      if (firstInvalidField) {
+        contactStatus.textContent = 'Please correct the highlighted fields.';
+        firstInvalidField.focus();
+        return;
+      }
+
+      contactStatus.textContent = 'Your message has not been sent. Message delivery is currently unavailable. Please keep your message and try again later.';
+    });
+  </script>
