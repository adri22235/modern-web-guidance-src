diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..0393a8a
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,43 @@
+const form = document.querySelector('#newsletter-form');
+const status = document.querySelector('#newsletter-status');
+const button = form.querySelector('button');
+
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (['connect-src', 'form-action', 'img-src'].includes(event.effectiveDirective)) {
+    status.textContent = 'A request was blocked by our security settings. Please try again later.';
+  }
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (button.disabled || !form.reportValidity()) return;
+  button.disabled = true;
+  status.textContent = 'Signing you up…';
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 10000);
+  try {
+    const response = await fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      credentials: 'same-origin',
+      redirect: 'error',
+      signal: controller.signal,
+      body: JSON.stringify({ email: form.elements.email.value.trim() }),
+    });
+    if (!response.ok) {
+      status.textContent = response.status === 400
+        ? 'Please enter a valid email address and try again.'
+        : 'We couldn’t save your signup. Please try again later.';
+      return;
+    }
+    status.textContent = 'You’re on the list! Thanks for signing up.';
+    form.reset();
+  } catch (error) {
+    status.textContent = error.name === 'AbortError'
+      ? 'The request took too long. Please try again.'
+      : 'We couldn’t connect to save your signup. Please check your connection and try again.';
+  } finally {
+    clearTimeout(timeout);
+    button.disabled = false;
+  }
+});
