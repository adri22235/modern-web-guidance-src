+import { createServer } from 'node:http';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const dataFile = resolve(process.env.NEWSLETTER_DATA_FILE || resolve(root, 'data/newsletter.jsonl'));
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+const policy = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+function reply(response, code, message) {
+  response.writeHead(code, { 'Content-Type': 'application/json; charset=utf-8' });
+  response.end(JSON.stringify({ message }));
+}
+
+async function subscribe(request, response) {
+  // Requiring JSON also prevents cross-origin HTML forms from posting signups.
+  if (request.headers['sec-fetch-site'] === 'cross-site') {
+    reply(response, 403, 'Request not allowed.');
+    return;
+  }
+  if (request.headers['content-type']?.split(';')[0].trim().toLowerCase() !== 'application/json') {
+    reply(response, 415, 'Send application/json.');
+    return;
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size > 4096) {
+      reply(response, 413, 'Request too large.');
+      return;
+    }
+    chunks.push(chunk);
+  }
+  let body;
+  try {
+    body = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+  } catch {
+    reply(response, 400, 'Invalid signup.');
+    return;
+  }
+  const email = typeof body?.email === 'string' ? body.email.trim() : '';
+  if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+    reply(response, 400, 'Enter a valid email address.');
+    return;
+  }
+  await mkdir(dirname(dataFile), { recursive: true, mode: 0o700 });
+  await appendFile(dataFile, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+  reply(response, 201, 'Signup saved.');
+}
+
+const server = createServer(async (request, response) => {
+  response.setHeader('Content-Security-Policy', policy);
+  response.setHeader('X-Content-Type-Options', 'nosniff');
+  response.setHeader('Referrer-Policy', 'no-referrer');
+  response.setHeader('X-Frame-Options', 'DENY');
+  response.setHeader('Cache-Control', 'no-store');
+  try {
+    const pathname = new URL(request.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter') {
+      if (request.method !== 'POST') {
+        response.setHeader('Allow', 'POST');
+        reply(response, 405, 'Method not allowed.');
+      } else {
+        await subscribe(request, response);
+      }
+      return;
+    }
+    const asset = assets.get(pathname);
+    if (!asset) return reply(response, 404, 'Not found.');
+    if (!['GET', 'HEAD'].includes(request.method)) {
+      response.setHeader('Allow', 'GET, HEAD');
+      return reply(response, 405, 'Method not allowed.');
+    }
+    const content = await readFile(resolve(root, asset[0]));
+    response.writeHead(200, { 'Content-Type': asset[1] });
+    response.end(request.method === 'HEAD' ? undefined : content);
+  } catch {
+    if (!response.headersSent && !response.destroyed) {
+      reply(response, 500, 'Unable to complete the request. Please try again later.');
+    } else {
+      response.end();
+    }
+  }
+});
+
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..c4e39c8
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,159 @@
+:root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+
+.section-title { text-align: center; }
+.newsletter { margin-top: 48px; padding: 32px; background: var(--secondary); border-radius: 8px; }
+.newsletter p { margin-top: 8px; }
+.newsletter form { margin-top: 20px; }
+.newsletter label { display: block; font-weight: 600; margin-bottom: 6px; }
+.signup-fields { display: flex; gap: 12px; flex-wrap: wrap; }
+.signup-fields input { flex: 1 1 240px; min-width: 0; padding: 12px; border: 1px solid var(--primary); border-radius: 5px; font: inherit; }
+.signup-fields button { margin-top: 0; border: 0; font: inherit; cursor: pointer; }
+.signup-fields button:disabled { opacity: 0.65; cursor: wait; }
+:focus-visible { outline: 3px solid #b36b00; outline-offset: 3px; }
+.request-status { min-height: 1.6em; }
+@media (max-width: 640px) { nav { flex-wrap: wrap; gap: 12px; } nav ul { flex-wrap: wrap; gap: 12px; } nav ul li { margin-left: 0; } .hero h1 { font-size: 2.3rem; } .newsletter { padding: 24px; } }
