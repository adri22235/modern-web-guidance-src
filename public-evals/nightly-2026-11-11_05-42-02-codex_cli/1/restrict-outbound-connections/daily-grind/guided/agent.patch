+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { randomBytes } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const assets = {
+  '/': ['index.html', 'text/html; charset=utf-8'],
+  '/index.html': ['index.html', 'text/html; charset=utf-8'],
+  '/styles.css': ['styles.css', 'text/css; charset=utf-8'],
+  '/newsletter.js': ['newsletter.js', 'text/javascript; charset=utf-8'],
+};
+
+async function readBody(req, limit = 4096) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > limit) throw Object.assign(new Error('Payload too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+export function createHandler({ dataDir = process.env.DATA_DIR || join(root, 'data') } = {}) {
+  return async (req, res) => {
+    const nonce = randomBytes(24).toString('base64');
+    res.setHeader('Connection-Allowlist', '(response-origin "https://images.unsplash.com"); report-to=connections');
+    res.setHeader('Reporting-Endpoints', 'connections="/api/security-reports"');
+    res.setHeader('Content-Security-Policy', [
+      "default-src 'none'", "connect-src 'self'", "img-src 'self' https://images.unsplash.com",
+      "style-src 'self'", `script-src 'nonce-${nonce}'`, "script-src-attr 'none'",
+      "form-action 'self'", "worker-src 'none'", "frame-src 'none'", "object-src 'none'",
+      "base-uri 'none'", "frame-ancestors 'none'", "require-trusted-types-for 'script'",
+      'report-to connections',
+    ].join('; '));
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('X-DNS-Prefetch-Control', 'off');
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('Cache-Control', 'no-store');
+    const reply = (code, message) => {
+      res.statusCode = code;
+      const json = (req.headers.accept || '').includes('application/json');
+      res.setHeader('Content-Type', json ? 'application/json; charset=utf-8' : 'text/plain; charset=utf-8');
+      res.end(json ? JSON.stringify({ message }) : message);
+    };
+    try {
+      const path = new URL(req.url, 'http://localhost').pathname;
+      if (req.method === 'POST' && ['/api/newsletter', '/api/security-reports'].includes(path)) {
+        const origin = req.headers.origin;
+        if (req.headers['sec-fetch-site'] === 'cross-site' ||
+            (origin && new URL(origin).host !== req.headers.host)) {
+          return reply(403, 'Request not allowed.');
+        }
+        const body = await readBody(req, path === '/api/security-reports' ? 65536 : 4096);
+        if (path === '/api/security-reports') {
+          // Count reports without storing URLs or other potentially sensitive report data.
+          console.info('Browser security report received');
+          res.writeHead(204).end();
+          return;
+        }
+        if (req.headers['content-type']?.split(';')[0].trim() !== 'application/x-www-form-urlencoded') {
+          return reply(415, 'Unsupported request format.');
+        }
+        const email = new URLSearchParams(body).get('email')?.trim();
+        if (!email || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+          return reply(400, 'Please enter a valid email address.');
+        }
+        await mkdir(dataDir, { recursive: true, mode: 0o700 });
+        await appendFile(join(dataDir, 'newsletter.jsonl'), JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+        return reply(201, 'Thanks! You’re subscribed to The Daily Grind newsletter.');
+      }
+      if (!['GET', 'HEAD'].includes(req.method)) {
+        res.setHeader('Allow', assets[path] ? 'GET, HEAD' : 'POST');
+        return reply(405, 'Method not allowed.');
+      }
+      if (!assets[path]) return reply(404, 'Page not found.');
+      const [file, type] = assets[path];
+      let body = await readFile(join(root, file), 'utf8');
+      if (file === 'index.html') body = body.replace('{{NONCE}}', nonce);
+      res.setHeader('Content-Type', type);
+      res.end(req.method === 'HEAD' ? undefined : body);
+    } catch (error) {
+      reply(error.status || 500, 'We couldn’t process your request. Please try again.');
+    }
+  };
+}
