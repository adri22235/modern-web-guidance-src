+  <script>
+    const cart = document.querySelector('.SwipeableList');
+    const count = document.querySelector('#cart-count');
+    const status = document.querySelector('.cart-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    cart.querySelectorAll('.SwipeableList-item').forEach((item) => {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const button = item.querySelector('.cart-remove');
+      let gesture = null;
+      let removing = false;
+
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      };
+
+      const remove = (direction = -1) => {
+        if (removing) return;
+        removing = true;
+        gesture = null;
+        const hadFocus = item.contains(document.activeElement);
+        const nextButton = item.nextElementSibling?.querySelector('button')
+          || item.previousElementSibling?.querySelector('button');
+        item.style.height = `${item.getBoundingClientRect().height}px`;
+        item.classList.remove('is-dragging');
+        item.classList.add('is-ready');
+        button.disabled = true;
+        content.style.transform = `translateX(${direction * track.clientWidth}px)`;
+
+        // Reveal the action color before collapsing the whole row, including its spacing.
+        window.setTimeout(() => {
+          item.style.height = '0px';
+          item.style.paddingBottom = '0px';
+          item.style.opacity = '0';
+          window.setTimeout(() => {
+            item.remove();
+            const remaining = cart.children.length;
+            count.textContent = `${remaining} ${remaining === 1 ? 'item' : 'items'}`;
+            status.textContent = remaining
+              ? `${item.dataset.name} removed. ${count.textContent} in your cart.`
+              : 'Your cart is empty. Explore our seasonal favorites above.';
+            if (hadFocus) {
+              if (nextButton?.isConnected && !nextButton.disabled) nextButton.focus();
+              else {
+                const heading = document.querySelector('#cart-title');
+                heading.tabIndex = -1;
+                heading.focus();
+              }
+            }
+          }, reducedMotion.matches ? 0 : 280);
+        }, reducedMotion.matches ? 0 : 220);
+      };
+
+      button.addEventListener('click', () => remove());
+      track.addEventListener('pointerdown', (event) => {
+        if (removing || gesture || !event.isPrimary || event.button !== 0
+          || event.target.closest('button')) return;
+        gesture = {
+          id: event.pointerId, x: event.clientX, y: event.clientY,
+          offset: 0, dragging: false,
+          threshold: Math.min(120, track.clientWidth * 0.3)
+        };
+      });
+
+      track.addEventListener('pointermove', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) {
+            reset();
+            return;
+          }
+          if (Math.abs(dx) <= 8) return;
+          gesture.dragging = true;
+          track.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.offset = dx;
+        content.style.transform = `translateX(${dx}px)`;
+        item.classList.toggle('is-ready', Math.abs(dx) >= gesture.threshold);
+        track.querySelectorAll('.swipe-action span').forEach((label) => {
+          label.textContent = Math.abs(dx) >= gesture.threshold ? 'Release to remove' : 'Remove';
+        });
+      });
+
+      track.addEventListener('pointerup', (event) => {
+        if (!gesture || event.pointerId !== gesture.id) return;
+        if (gesture.dragging && Math.abs(gesture.offset) >= gesture.threshold) {
+          remove(Math.sign(gesture.offset));
+        } else reset();
+      });
+      track.addEventListener('pointercancel', reset);
+      track.addEventListener('lostpointercapture', () => {
+        if (gesture) reset();
+      });
+      track.addEventListener('pointerleave', () => {
+        if (gesture && !gesture.dragging) reset();
+      });
+      item.classList.add('is-initialized');
+    });
+  </script>
+
