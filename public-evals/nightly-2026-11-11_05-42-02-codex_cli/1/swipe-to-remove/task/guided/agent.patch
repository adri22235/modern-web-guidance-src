+  <script>
+    const list = document.querySelector('.SwipeableList');
+    const heading = document.getElementById('cart-heading');
+    const status = document.querySelector('.SwipeableList-status');
+    const handles = new WeakMap();
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const resizeObserver = needsScrollWorkaround ? new ResizeObserver((entries) => {
+      for (const { target } of entries) target.scrollLeft = target.clientWidth;
+    }) : null;
+
+    const viewportObserver = new IntersectionObserver((entries) => {
+      for (const { target: item, isIntersecting } of entries) {
+        if (item.classList.contains('is-removing')) continue;
+        const handle = handles.get(item);
+        if (isIntersecting) {
+          const active = handle ?? setupItem(item);
+          active.observer.observe(active.content);
+        } else if (handle) {
+          handle.observer.unobserve(handle.content);
+        }
+      }
+    });
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      item.classList.add('is-initialized');
+      // Center before observing so initialization cannot be mistaken for a swipe.
+      if (needsScrollWorkaround) {
+        track.scrollLeft = track.clientWidth;
+        resizeObserver.observe(track);
+      }
+
+      const observer = new IntersectionObserver((entries) => {
+        const entry = entries[entries.length - 1];
+        if (!entry.rootBounds) return;
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        const direction = offset > 0 ? 'right' : 'left';
+        if (offset !== 0) item.dataset.swipeDirection = direction;
+        item.classList.toggle('is-activating', entry.intersectionRatio < 0.8);
+        // Commit once more than 80% of the content has left the track.
+        if (entry.intersectionRatio < 0.2) commit(direction, entry);
+      }, { root: track, threshold: [0.2, 0.8] });
+
+      function commit(direction, entry) {
+        if (item.classList.contains('is-removing')) return;
+        viewportObserver.unobserve(item);
+        observer.disconnect();
+        resizeObserver?.unobserve(track);
+        removeItem(item, content, direction, entry);
+      }
+
+      const handle = { track, content, observer, commit };
+      handles.set(item, handle);
+      return handle;
+    }
+
+    async function removeItem(item, content, direction, entry) {
+      const rows = [...list.children].filter(row => !row.classList.contains('is-removing'));
+      if (item.contains(document.activeElement)) {
+        const index = rows.indexOf(item);
+        const next = rows[index + 1] ?? rows[index - 1];
+        (next?.querySelector('button') ?? heading).focus({ preventScroll: true });
+      }
+      item.classList.add('is-removing');
+      item.inert = true;
+      const name = item.querySelector('.SwipeableList-label').textContent;
+      const remaining = rows.length - 1;
+      document.querySelector('.cart-count').textContent = `${remaining} ${remaining === 1 ? 'item' : 'items'}`;
+      status.textContent = `${name} removed from cart. ${remaining} ${remaining === 1 ? 'item' : 'items'} remaining.`;
+
+      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      const options = { duration: reduce ? 100 : 300, easing: 'ease', fill: 'forwards' };
+      const rect = entry.boundingClientRect;
+      const offset = rect.x - entry.rootBounds.x;
+      const distance = direction === 'right' ? rect.width - offset : -(rect.width + offset);
+      const animations = [item.animate([{ height: `${item.getBoundingClientRect().height}px` }, { height: '0px' }], options)];
+      if (!reduce) animations.push(content.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${distance}px)` }], options));
+      await Promise.allSettled(animations.map(animation => animation.finished));
+      document.querySelector('.cart-empty').hidden = list.querySelector('.SwipeableList-item:not(.is-removing)') !== null;
+      // Safari can pass a removed row's remaining swipe momentum to the next row.
+      if (globalThis.GestureEvent) setTimeout(() => item.remove(), 5000);
+      else item.remove();
+    }
+
+    for (const item of list.children) viewportObserver.observe(item);
+
+    list.addEventListener('click', (event) => {
+      const button = event.target.closest('.SwipeableList-action');
+      if (!button) return;
+      const item = button.closest('.SwipeableList-item');
+      const handle = handles.get(item) ?? setupItem(item);
+      handle.commit('left', {
+        boundingClientRect: handle.content.getBoundingClientRect(),
+        rootBounds: handle.track.getBoundingClientRect(),
+      });
+    });
+  </script>
