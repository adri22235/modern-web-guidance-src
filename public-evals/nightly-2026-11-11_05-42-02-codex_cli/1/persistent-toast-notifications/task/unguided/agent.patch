+  <template id="rewards-toast">
+    <article class="toast" data-tone="rewards">
+      <span class="toast-icon" aria-hidden="true">☆</span>
+      <div class="toast-copy">
+        <h3>A little perk for your day</h3>
+        <p>Sample update: you’ve earned a free coffee reward.</p>
+      </div>
+      <button type="button" class="toast-close" aria-label="Dismiss rewards notification">×</button>
+    </article>
+  </template>
+  <template id="tip-toast">
+    <article class="toast" data-tone="tip">
+      <span class="toast-icon" aria-hidden="true">i</span>
+      <div class="toast-copy">
+        <h3>Keep your beans at their best</h3>
+        <p>Store coffee in an airtight container, away from heat and light.</p>
+      </div>
