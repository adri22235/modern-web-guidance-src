+    </article>
+  </template>
+
+  <script>
+    (() => {
+      const stack = document.querySelector('.toast-stack');
+      const active = new Map();
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function showToast(trigger) {
+        const template = document.getElementById(trigger.dataset.toast);
+        if (!(template instanceof HTMLTemplateElement)) return;
+        const source = template.content.querySelector('.toast');
+        if (!source) return;
+
+        // Keep the stack compact, including on small screens.
+        const limit = window.innerHeight < 600 ? 2 : 3;
+        if (active.size >= limit) {
+          const oldest = [...active.keys()].find(toast => !toast.contains(document.activeElement));
+          if (!oldest) return;
+          active.get(oldest).remove(true);
+        }
+
+        const toast = source.cloneNode(true);
+        let timer;
+        let remaining = 6000;
+        let started;
+        let leaving = false;
+        let hovered = false;
+
+        function pause() {
+          if (!timer) return;
+          clearTimeout(timer);
+          timer = null;
+          remaining -= performance.now() - started;
+        }
+
+        function resume() {
+          if (leaving || timer || hovered || toast.contains(document.activeElement)) return;
+          started = performance.now();
+          timer = setTimeout(() => remove(), Math.max(0, remaining));
+        }
+
+        function remove(immediately = false) {
+          if (leaving) return;
+          leaving = true;
+          clearTimeout(timer);
+          active.delete(toast);
+          if (toast.contains(document.activeElement) && trigger.isConnected) trigger.focus();
+          if (immediately || reducedMotion.matches) {
+            toast.remove();
+          } else {
+            toast.classList.add('is-leaving');
+            setTimeout(() => toast.remove(), 180);
+          }
+        }
+
+        toast.querySelector('.toast-close')?.addEventListener('click', () => remove());
+        toast.addEventListener('pointerenter', () => { hovered = true; pause(); });
+        toast.addEventListener('pointerleave', () => { hovered = false; resume(); });
+        toast.addEventListener('focusin', pause);
+        toast.addEventListener('focusout', () => queueMicrotask(resume));
+        toast.addEventListener('keydown', event => {
+          if (event.key === 'Escape') { event.stopPropagation(); remove(); }
+        });
+        active.set(toast, { remove });
+        stack.append(toast);
+        resume();
+      }
+
+      document.addEventListener('click', event => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger) return;
+        if (trigger.matches('a')) event.preventDefault();
+        showToast(trigger);
+      });
+    })();
+  </script>
