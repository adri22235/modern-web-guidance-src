+  <p class="visually-hidden">Notification announcements</p>
+  <div id="toast-announcements" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
+
+  <script>
+    (() => {
+      const stack = document.getElementById('toast-stack');
+      const announcements = document.getElementById('toast-announcements');
+      const supportsPopover = 'popover' in HTMLElement.prototype;
+      const triggers = new WeakMap();
+      const closingTimers = new WeakMap();
+      let announcementTimer;
+
+      function showToast(toast, trigger) {
+        clearTimeout(closingTimers.get(toast));
+        closingTimers.delete(toast);
+        toast.classList.remove('is-closing');
+        triggers.set(toast, trigger);
+        if (!toast.hidden) return;
+
+        stack.append(toast);
+        toast.hidden = false;
+        stack.hidden = false;
+        stack.classList.add('is-open');
+        if (supportsPopover && !stack.matches(':popover-open')) stack.showPopover();
+
+        const message = toast.querySelector('.toast-content').textContent.trim().replace(/\s+/g, ' ');
+        if (typeof document.ariaNotify === 'function') {
+          document.ariaNotify(message, { priority: 'normal' });
+        } else {
+          clearTimeout(announcementTimer);
+          announcements.textContent = '';
+          announcementTimer = setTimeout(() => {
+            announcements.textContent = [...stack.querySelectorAll('.toast:not([hidden]):not(.is-closing) .toast-content')]
+              .map(content => content.textContent.trim().replace(/\s+/g, ' ')).join(' ');
+          }, 100);
+        }
+      }
+
+      function dismissToast(toast) {
+        if (closingTimers.has(toast)) return;
+        toast.classList.add('is-closing');
+        const delay = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 180;
+        closingTimers.set(toast, setTimeout(() => {
+          const hadFocus = toast.contains(document.activeElement);
+          toast.hidden = true;
+          toast.classList.remove('is-closing');
+          closingTimers.delete(toast);
+          const nextToast = stack.querySelector('.toast:not([hidden]):not(.is-closing)');
+          if (!stack.querySelector('.toast:not([hidden])')) {
+            if (supportsPopover) stack.hidePopover();
+            stack.classList.remove('is-open');
+            stack.hidden = true;
+            announcements.textContent = '';
+          }
+          if (hadFocus) {
+            const focusTarget = nextToast?.querySelector('.toast-close') || triggers.get(toast);
+            if (focusTarget?.isConnected) focusTarget.focus({ preventScroll: true });
+          }
+        }, delay));
+      }
+
+      document.addEventListener('click', event => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (trigger) {
+          const toast = document.getElementById(trigger.dataset.toast);
+          if (!toast?.matches('.toast')) return;
+          event.preventDefault();
+          showToast(toast, trigger);
+        }
+        const close = event.target.closest('.toast-close');
+        if (close && stack.contains(close)) dismissToast(close.closest('.toast'));
+      });
+    })();
+  </script>
+
