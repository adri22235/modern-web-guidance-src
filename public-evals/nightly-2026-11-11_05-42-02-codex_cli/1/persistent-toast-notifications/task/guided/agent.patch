+    <article id="espresso-toast" class="toast" aria-labelledby="espresso-toast-title" hidden>
+      <div class="toast-content">
+        <h3 id="espresso-toast-title">Your morning boost</h3>
+        <p>Our Dark Roast Espresso is bold, smoky, and full of flavor.</p>
+      </div>
+      <button type="button" class="toast-close" aria-label="Dismiss espresso tasting note">&times;</button>
+    </article>
+    <article id="cold-brew-toast" class="toast" aria-labelledby="cold-brew-toast-title" hidden>
+      <div class="toast-content">
+        <h3 id="cold-brew-toast-title">Good things take time</h3>
+        <p>Our Cold Brew steeps for 18 hours for an extra-smooth sip.</p>
+      </div>
+      <button type="button" class="toast-close" aria-label="Dismiss cold brew tasting note">&times;</button>
+    </article>
