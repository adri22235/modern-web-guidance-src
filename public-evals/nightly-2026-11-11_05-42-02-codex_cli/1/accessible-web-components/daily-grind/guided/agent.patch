diff --git a/favorite-toggle.js b/favorite-toggle.js
new file mode 100644
index 0000000..ffaa831
--- /dev/null
+++ b/favorite-toggle.js
@@ -0,0 +1,75 @@
+// Usage: <favorite-toggle drink-id="cold-brew" drink-name="Cold Brew"></favorite-toggle>
+// The optional boolean `favorite` attribute also reflects the `favorite` property.
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['favorite', 'drink-name'];
+
+  #button;
+  #icon;
+  #label;
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  get #storageKey() {
+    const drinkId = this.getAttribute('drink-id');
+    return drinkId ? `daily-grind:favorite:${drinkId}` : null;
+  }
+
+  connectedCallback() {
+    // Reconnecting an existing element must not duplicate its control or listener.
+    if (this.#button) return;
+
+    this.#button = document.createElement('button');
+    this.#button.type = 'button';
+    this.#icon = document.createElement('span');
+    this.#icon.setAttribute('aria-hidden', 'true');
+    this.#label = document.createElement('span');
+    this.#button.append(this.#icon, this.#label);
+    this.#button.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+      try {
+        if (this.#storageKey) {
+          localStorage.setItem(this.#storageKey, String(this.favorite));
+        }
+      } catch {
+        // Storage may be blocked; the control still works for this visit.
+      }
+      this.dispatchEvent(new CustomEvent('change', {
+        bubbles: true,
+        detail: { drinkId: this.getAttribute('drink-id'), favorite: this.favorite }
+      }));
+    });
+
+    try {
+      const saved = this.#storageKey ? localStorage.getItem(this.#storageKey) : null;
+      if (saved !== null) this.favorite = saved === 'true';
+    } catch {
+      // Keep the markup's initial state when storage is unavailable.
+    }
+
+    this.append(this.#button);
+    this.#render();
+  }
+
+  attributeChangedCallback() {
+    this.#render();
+  }
+
+  #render() {
+    if (!this.#button) return;
+    const drinkName = this.getAttribute('drink-name') || 'this drink';
+    this.#button.setAttribute('aria-label', `Favorite ${drinkName}`);
+    this.#button.setAttribute('aria-pressed', String(this.favorite));
+    this.#icon.textContent = this.favorite ? '♥' : '♡';
+    this.#label.textContent = this.favorite ? 'Favorited' : 'Favorite';
+  }
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
