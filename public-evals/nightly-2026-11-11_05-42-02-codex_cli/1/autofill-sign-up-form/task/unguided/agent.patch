+  <script>
+    const signupForm = document.getElementById('signup-form');
+    const signupStatus = document.getElementById('signup-status');
+
+    signupForm.addEventListener('submit', function (event) {
+      event.preventDefault();
+      if (!signupForm.elements.name.value.trim()) {
+        signupForm.elements.name.setCustomValidity('Please enter your name.');
+        signupForm.elements.name.reportValidity();
+        return;
+      }
+      signupStatus.textContent = 'Your details passed validation. Account creation is not available yet; nothing has been sent or saved.';
+      signupForm.elements.password.value = '';
+    });
+
+    signupForm.addEventListener('input', function () {
+      signupForm.elements.name.setCustomValidity('');
+      signupStatus.textContent = '';
+    });
+  </script>
