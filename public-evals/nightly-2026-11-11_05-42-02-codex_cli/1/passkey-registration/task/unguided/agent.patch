+  <script>
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const registerStatus = document.getElementById('register-status');
+
+    function decodeBase64url(value) {
+      if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+={0,2}$/.test(value)) {
+        throw new Error('Invalid passkey options.');
+      }
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/').replace(/=+$/, '');
+      const bytes = atob(base64 + '='.repeat((4 - base64.length % 4) % 4));
+      return Uint8Array.from(bytes, (character) => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(buffer) {
+      let binary = '';
+      for (const byte of new Uint8Array(buffer)) binary += String.fromCharCode(byte);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseCreationOptions(options) {
+      if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      }
+      // Compatibility for browsers predating the WebAuthn JSON helpers.
+      const publicKey = {
+        ...options,
+        challenge: decodeBase64url(options.challenge),
+        user: { ...options.user, id: decodeBase64url(options.user.id) }
+      };
+      if (options.excludeCredentials) {
+        publicKey.excludeCredentials = options.excludeCredentials.map((credential) => ({
+          ...credential, id: decodeBase64url(credential.id)
+        }));
+      }
+      if (options.extensions?.prf || options.extensions?.largeBlob?.write) {
+        // These extensions contain additional binary fields; require native parsing.
+        throw new Error('A newer browser is needed for these passkey options.');
+      }
+      return publicKey;
+    }
+
+    function serializeCredential(credential) {
+      if (typeof credential.toJSON === 'function') return credential.toJSON();
+      return {
+        id: credential.id,
+        rawId: encodeBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        response: {
+          clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+          attestationObject: encodeBase64url(credential.response.attestationObject),
+          transports: credential.response.getTransports?.() || []
+        },
+        clientExtensionResults: credential.getClientExtensionResults()
+      };
+    }
+
+    async function postRegistrationJSON(url, body) {
+      const response = await fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        mode: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body)
+      });
+      if (!response.ok) throw new Error('Passkey registration failed. Please try again.');
+      return response.json();
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registerButton.disabled) return;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      registerStatus.textContent = 'Preparing your passkey…';
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential ||
+            typeof navigator.credentials?.create !== 'function') {
+          throw new Error('Passkeys require a supported browser and a secure connection.');
+        }
+        const options = await postRegistrationJSON('/api/register/options', { promotion: true });
+        const publicKey = parseCreationOptions(options);
+        registerStatus.textContent = 'Follow your device’s instructions to create a passkey.';
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential || credential.type !== 'public-key') {
+          throw new Error('No passkey was created. Please try again.');
+        }
+        registerStatus.textContent = 'Verifying your passkey…';
+        // The server must validate the session-bound, single-use challenge,
+        // expected origin/RP ID, and authenticator response before returning verified.
+        const result = await postRegistrationJSON('/api/register/verify', serializeCredential(credential));
+        if (result.verified !== true) {
+          throw new Error('Your passkey could not be verified. Please try again.');
+        }
+        registerStatus.textContent = 'Passkey created successfully.';
+      } catch (error) {
+        if (error.name === 'NotAllowedError' || error.name === 'AbortError') {
+          registerStatus.textContent = 'Passkey creation was cancelled or timed out. You can try again.';
+        } else if (error.name === 'InvalidStateError') {
+          registerStatus.textContent = 'A passkey already exists for this account on this device.';
+        } else {
+          registerStatus.textContent = 'Unable to create a passkey. Check your connection and browser support, then try again.';
+        }
+      } finally {
+        registerButton.disabled = false;
+        registerButton.removeAttribute('aria-busy');
+      }
+    });
+  </script>
