+  <script>
+    const reviewsScroll = document.querySelector('.reviews-scroll');
+    const topHint = document.querySelector('.scroll-hint-top');
+    const bottomHint = document.querySelector('.scroll-hint-bottom');
+
+    function updateReviewHints() {
+      topHint.hidden = reviewsScroll.scrollTop <= 0;
+      bottomHint.hidden = reviewsScroll.scrollHeight - reviewsScroll.clientHeight - reviewsScroll.scrollTop <= 1;
+    }
+
+    reviewsScroll.addEventListener('scroll', updateReviewHints, { passive: true });
+    window.addEventListener('resize', updateReviewHints);
+
+    const reviewsResizeObserver = new ResizeObserver(updateReviewHints);
+    reviewsResizeObserver.observe(reviewsScroll);
+    reviewsResizeObserver.observe(document.querySelector('.reviews-list'));
+    updateReviewHints();
+  </script>
