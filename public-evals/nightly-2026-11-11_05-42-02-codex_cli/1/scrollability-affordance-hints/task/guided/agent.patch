+      letter-spacing: 2px;
+    }
+
+    .reviews-scroll {
+      height: 360px;
+      overflow-y: auto;
+      scrollbar-gutter: stable;
+      container-type: scroll-state;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      scroll-padding-block: 20px;
+    }
+
+    .reviews-scroll:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .reviews-scroll::before,
+    .reviews-scroll::after {
+      content: "";
+      display: block;
+      position: sticky;
+      height: 16px;
+      z-index: 1;
+      pointer-events: none;
+      opacity: 0;
+    }
+
+    .reviews-scroll::before {
+      top: 0;
+      margin-bottom: -16px;
+      background: radial-gradient(farthest-side at 50% 0, rgb(78 52 46 / .25), transparent);
+    }
+
+    .reviews-scroll::after {
+      bottom: 0;
+      margin-top: -16px;
+      background: radial-gradient(farthest-side at 50% 100%, rgb(78 52 46 / .25), transparent);
+    }
+
+    @container scroll-state(scrollable: top) {
+      .reviews-scroll::before { opacity: 1; }
+    }
+
+    @container scroll-state(scrollable: bottom) {
+      .reviews-scroll::after { opacity: 1; }
+    }
+
+    @supports not (container-type: scroll-state) {
+      @supports (animation-timeline: scroll()) {
+        .reviews-scroll::before,
+        .reviews-scroll::after {
+          animation: review-shadow linear both;
+          animation-timeline: scroll();
+        }
+
+        .reviews-scroll::before { animation-range: 0 1px; }
+        .reviews-scroll::after {
+          animation-direction: reverse;
+          animation-range: calc(100% - 1px) 100%;
+        }
+      }
+    }
+
+    @keyframes review-shadow {
+      to { opacity: 1; }
+    }
+
+    .reviews-scroll.more-start::before,
+    .reviews-scroll.more-end::after {
+      opacity: 1;
+    }
+
+    .review-edge {
+      height: 1px;
+    }
+
+    .review-list {
+      list-style: none;
+      padding: 0 24px;
+    }
+
+    .review-list li {
+      padding: 22px 0;
+    }
+
+    .review-list li + li {
+      border-top: 1px solid #ede7e4;
+    }
+
+    .review-list blockquote {
+      margin: 8px 0 10px;
+    }
+
+    .review-author {
+      font-size: .9rem;
+      font-weight: 600;
+    }
