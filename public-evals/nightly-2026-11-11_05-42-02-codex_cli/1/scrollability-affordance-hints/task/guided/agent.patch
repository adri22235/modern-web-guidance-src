+  <script>
+    // Older browsers use edge visibility to provide the same scroll hints.
+    if (!CSS.supports('container-type', 'scroll-state') &&
+        !CSS.supports('animation-timeline', 'scroll()')) {
+      const scroller = document.querySelector('.reviews-scroll');
+      const observer = new IntersectionObserver(entries => {
+        for (const entry of entries) {
+          const edge = entry.target.dataset.reviewEdge;
+          scroller.classList.toggle(`more-${edge}`, entry.intersectionRatio < 1);
+        }
+      }, { root: scroller, threshold: 1 });
+
+      scroller.querySelectorAll('[data-review-edge]').forEach(edge => observer.observe(edge));
+    }
+  </script>
