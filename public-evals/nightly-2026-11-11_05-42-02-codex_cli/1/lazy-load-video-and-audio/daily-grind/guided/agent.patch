diff --git a/media-loader.js b/media-loader.js
new file mode 100644
index 0000000..4a54937
--- /dev/null
+++ b/media-loader.js
@@ -0,0 +1,44 @@
+// Inert URLs in the HTML prevent speculative poster and metadata fetches,
+// including in browsers that do not implement native media lazy loading.
+const players = document.querySelectorAll('[data-deferred-media]');
+
+function activate(player) {
+  if (!player.hasAttribute('data-deferred-media')) return;
+  player.removeAttribute('data-deferred-media');
+
+  if (player.dataset.poster) {
+    player.poster = player.dataset.poster;
+    delete player.dataset.poster;
+  }
+  player.preload = player.dataset.preload || 'metadata';
+  delete player.dataset.preload;
+
+  for (const source of player.querySelectorAll('source[data-src]')) {
+    source.src = source.dataset.src;
+    delete source.dataset.src;
+  }
+  player.load();
+}
+
+// Use the same conservative threshold in every browser. Native loading="lazy"
+// remains a hint, while withheld URLs guarantee no offscreen media requests.
+const observer = 'IntersectionObserver' in window
+  ? new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (!entry.isIntersecting) continue;
+      activate(entry.target);
+      observer.unobserve(entry.target);
+    }
+  }, { rootMargin: '200px 0px' })
+  : null;
+
+for (const player of players) {
+  observer?.observe(player);
+  // Keyboard or pointer intent also makes players usable without an observer.
+  const onIntent = () => {
+    activate(player);
+    observer?.unobserve(player);
+  };
+  player.addEventListener('focusin', onIntent, { once: true });
+  player.addEventListener('pointerdown', onIntent, { once: true });
+}
