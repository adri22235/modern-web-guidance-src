diff --git a/media.js b/media.js
new file mode 100644
index 0000000..7fd8edb
--- /dev/null
+++ b/media.js
@@ -0,0 +1,69 @@
+// Keep request-bearing attributes absent until each player is near the viewport.
+(() => {
+  const players = document.querySelectorAll('[data-deferred-media]');
+
+  function loadPlayer(player) {
+    if (player.dataset.loaded) return;
+    player.dataset.loaded = 'true';
+    const media = player.querySelector('video, audio');
+    const status = player.querySelector('.media-status');
+    media.addEventListener('error', () => {
+      status.hidden = false;
+      status.textContent = 'This player is unavailable. Please try again later or visit the credits link.';
+    });
+
+    player.querySelectorAll('[data-poster]').forEach(element => {
+      element.poster = element.dataset.poster;
+      delete element.dataset.poster;
+    });
+    player.querySelectorAll('[data-src]').forEach(element => {
+      element.src = element.dataset.src;
+      delete element.dataset.src;
+    });
+    media.preload = 'metadata';
+    media.load();
+  }
+
+  // Keyboard and pointer interaction also work before an observer callback arrives.
+  players.forEach(player => {
+    player.addEventListener('focusin', () => loadPlayer(player), { once: true });
+    player.addEventListener('pointerdown', () => loadPlayer(player), { once: true });
+  });
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver(entries => {
+      entries.forEach(entry => {
+        if (!entry.isIntersecting) return;
+        loadPlayer(entry.target);
+        observer.unobserve(entry.target);
+      });
+    }, { rootMargin: '200px 0px', threshold: 0 });
+    players.forEach(player => observer.observe(player));
+  } else {
+    // Retain deferred downloads in older browsers instead of loading everything.
+    const pending = new Set(players);
+    let scheduled = false;
+    function checkPlayers() {
+      scheduled = false;
+      pending.forEach(player => {
+        const rect = player.getBoundingClientRect();
+        if (rect.bottom >= -200 && rect.top <= window.innerHeight + 200) {
+          loadPlayer(player);
+          pending.delete(player);
+        }
+      });
+      if (!pending.size) {
+        window.removeEventListener('scroll', scheduleCheck);
+        window.removeEventListener('resize', scheduleCheck);
+      }
+    }
+    function scheduleCheck() {
+      if (scheduled) return;
+      scheduled = true;
+      window.requestAnimationFrame(checkPlayers);
+    }
+    window.addEventListener('scroll', scheduleCheck, { passive: true });
+    window.addEventListener('resize', scheduleCheck);
+    checkPlayers();
+  }
+})();
