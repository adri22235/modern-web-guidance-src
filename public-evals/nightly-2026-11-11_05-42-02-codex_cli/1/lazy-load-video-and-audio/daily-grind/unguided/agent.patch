index 0000000..5eb9757
--- /dev/null
+++ b/media.test.cjs
@@ -0,0 +1,101 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+const script = readFileSync(`${__dirname}/media.js`, 'utf8');
+
+function fixture(observerSupported = true) {
+  const makePlayer = top => {
+    const events = {};
+    const media = {
+      preload: 'none', loads: 0, dataset: { poster: 'poster.jpg' },
+      addEventListener(name, callback) { events[`media:${name}`] = callback; },
+      load() { this.loads++; },
+    };
+    const source = { dataset: { src: 'clip.mp4' } };
+    const artwork = { dataset: { src: 'art.jpg' } };
+    const status = { hidden: true };
+    return {
+      dataset: {}, media, source, artwork, events, status, top,
+      querySelector(selector) { return selector === '.media-status' ? status : media; },
+      querySelectorAll(selector) { return selector === '[data-poster]' ? [media] : [source, artwork]; },
+      addEventListener(name, callback) { events[name] = callback; },
+      getBoundingClientRect() { return { top: this.top, bottom: this.top + 300 }; },
+    };
+  };
+  const players = [makePlayer(100), makePlayer(1500), makePlayer(2400)];
+  const listeners = {};
+  let observer;
+  const window = {
+    innerHeight: 800,
+    addEventListener(name, callback) { listeners[name] = callback; },
+    removeEventListener(name) { delete listeners[name]; },
+    requestAnimationFrame(callback) { callback(); },
+  };
+  class IntersectionObserver {
+    constructor(callback, options) { this.callback = callback; this.options = options; this.observed = new Set(); observer = this; }
+    observe(player) { this.observed.add(player); }
+    unobserve(player) { this.observed.delete(player); }
+  }
+  if (observerSupported) window.IntersectionObserver = IntersectionObserver;
+  runInNewContext(script, { document: { querySelectorAll: () => players }, window, IntersectionObserver });
+  return { players, observer, listeners };
+}
+
+test('HTML keeps every player, poster, and artwork inert before JavaScript', () => {
+  const html = readFileSync(`${__dirname}/index.html`, 'utf8');
+  const media = html.match(/<(?:video|audio)\b[^>]*>/g);
+  assert.equal(media.length, 3);
+  for (const tag of media) {
+    assert.match(tag, /preload="none"/);
+    assert.doesNotMatch(tag, /\s(?:src|poster|autoplay)=/);
+  }
+  for (const tag of html.match(/<(?:source|img)\b[^>]*>/g)) {
+    assert.match(tag, /data-src=/);
+    assert.doesNotMatch(tag, /\ssrc=/);
+  }
+  assert.doesNotMatch(html, /rel=["'](?:preload|prefetch)["']/);
+});
+
+test('only approaching players load their sources, posters, and metadata once', () => {
+  const { players, observer } = fixture();
+  assert.equal(observer.options.rootMargin, '200px 0px');
+  players.forEach(player => assert.equal(player.media.loads, 0));
+  observer.callback([{ target: players[1], isIntersecting: false }]);
+  assert.equal(players[1].source.src, undefined);
+  observer.callback([{ target: players[0], isIntersecting: true }]);
+  assert.equal(players[0].media.poster, 'poster.jpg');
+  assert.equal(players[0].source.src, 'clip.mp4');
+  assert.equal(players[0].artwork.src, 'art.jpg');
+  assert.equal(players[0].media.preload, 'metadata');
+  assert.equal(observer.observed.has(players[0]), false);
+  players[0].events.focusin();
+  assert.equal(players[0].media.loads, 1);
+  assert.equal(players[1].media.poster, undefined);
+  assert.equal(players[2].artwork.src, undefined);
+});
+
+test('keyboard interaction loads a player and media errors have a visible message', () => {
+  const { players } = fixture();
+  players[2].events.focusin();
+  assert.equal(players[2].media.loads, 1);
+  players[2].events['media:error']();
+  assert.equal(players[2].status.hidden, false);
+  assert.match(players[2].status.textContent, /unavailable/);
+});
+
+test('fallback defers offscreen assets and loads them when scrolled near', () => {
+  const { players, listeners } = fixture(false);
+  assert.equal(players[0].media.loads, 1);
+  assert.equal(players[1].source.src, undefined);
+  assert.equal(players[2].artwork.src, undefined);
+  players[1].top = 950;
+  listeners.scroll();
+  assert.equal(players[1].media.loads, 1);
+  assert.equal(players[2].media.loads, 0);
+  players[2].top = 500;
+  listeners.resize();
+  assert.equal(players[2].media.loads, 1);
+  assert.equal(listeners.scroll, undefined);
+  assert.equal(listeners.resize, undefined);
+});
