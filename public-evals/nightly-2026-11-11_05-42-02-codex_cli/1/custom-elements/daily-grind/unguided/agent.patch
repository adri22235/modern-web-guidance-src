+# The Daily Grind
+
+The static page loads `coffee-card.js` as a native JavaScript module. No build is required.
+
+`<coffee-card>` is an autonomous custom element with an open shadow root. Its
+styles inherit the page's font, text color, and theme custom properties.
+
+| Attribute / property | Type | Behavior |
+| --- | --- | --- |
+| `name` | string | Heading; defaults to an empty string. |
+| `description` | string | Description; defaults to an empty string. |
+| `href` | string | Details URL; relative and HTTP(S) links are supported. |
+| `price` | number | Optional USD price. Missing prices are hidden. Invalid, negative, or nonfinite values read as zero. |
+| `disabled` | boolean | Presence disables the details link, including `disabled="false"`. |
+
+Property assignments reflect to attributes, and attribute changes update properties
+and the rendered card. Assigning `null` or `undefined` to a string or price
+property removes its attribute. Set `card.disabled = false` or remove the
+attribute to enable the link. Text is rendered as text, never as HTML.
+
+```html
+<coffee-card name="Cold Brew" description="Steeped for 18 hours."
+  href="/menu/cold-brew" price="4.5"></coffee-card>
+```
+
+```js
+const card = document.querySelector('coffee-card');
+card.price = 5; // Reflects price="5" and displays $5.00.
+card.disabled = true; // Adds the disabled attribute.
+card.setAttribute('name', 'Iced Cold Brew'); // Updates card.name and the heading.
+```
+
+Connecting a card restores properties set before registration, attaches its click
+handler, and renders current attributes. Disconnecting removes the handler;
+reconnecting restores it without duplicating the shadow content.
diff --git a/coffee-card.js b/coffee-card.js
new file mode 100644
index 0000000..430647a
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,128 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host { display: block; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    .price { margin-top: 10px; font-weight: bold; }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+    a[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
+    [hidden] { display: none; }
+  </style>
+  <article aria-labelledby="name">
+    <h3 id="name"></h3>
+    <p class="description"></p>
+    <p class="price" hidden></p>
+    <a>View Details</a>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'disabled'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this._name = this.shadowRoot.querySelector('h3');
+    this._description = this.shadowRoot.querySelector('.description');
+    this._price = this.shadowRoot.querySelector('.price');
+    this._link = this.shadowRoot.querySelector('a');
+    this._onClick = (event) => {
+      if (this.disabled) event.preventDefault();
+    };
+  }
+
+  connectedCallback() {
+    // Preserve properties assigned before the browser registered this element.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.prototype.hasOwnProperty.call(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this._link.addEventListener('click', this._onClick);
+    this.render();
+  }
+
+  disconnectedCallback() {
+    this._link.removeEventListener('click', this._onClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this._setString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this._setString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this._setString('href', value); }
+
+  get price() {
+    const value = Number(this.getAttribute('price'));
+    return Number.isFinite(value) && value >= 0 ? value : 0;
+  }
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    this.setAttribute('price', String(Number.isFinite(number) && number >= 0 ? number : 0));
+  }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  _setString(attribute, value) {
+    if (value == null) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  render() {
+    this._name.textContent = this.name;
+    this._description.textContent = this.description;
+    this._price.hidden = !this.hasAttribute('price');
+    this._price.textContent = new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(this.price);
+
+    // Only allow ordinary web links, including relative menu URLs.
+    let safeHref = '';
+    try {
+      const url = new URL(this.href, this.ownerDocument.baseURI);
+      if (this.href && ['http:', 'https:'].includes(url.protocol)) safeHref = this.href;
+    } catch { /* Invalid URLs leave the details link inactive. */ }
+    const inactive = this.disabled || !safeHref;
+    if (inactive) this._link.removeAttribute('href');
+    else this._link.setAttribute('href', safeHref);
+    this._link.setAttribute('aria-disabled', String(inactive));
+    if (inactive) this._link.setAttribute('tabindex', '-1');
+    else this._link.removeAttribute('tabindex');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
