+  <!--
+    Seasonal card API:
+    Slots: title, description, action (native headings and links remain page-owned).
+    Parts: surface, content, actions.
+    Variants: default (attribute omitted), featured, subtle.
+    Optional inherited tokens: --card-background, --card-color, --card-heading-color,
+    --card-border-color, --card-radius, --card-padding. Site coffee tokens are fallbacks.
+  -->
+  <template id="seasonal-card-template">
+    <style>
+      /* These priority tiers are local to each shadow root. */
+      @layer reset, base, variants, layout;
+
+      @layer reset {
+        :host, article, div, footer {
+          box-sizing: border-box;
+        }
+
+        article, div, footer {
+          margin: 0;
+          padding: 0;
+        }
+      }
+
+      @layer base {
+        :host {
+          display: block;
+          min-inline-size: 0;
+          container: seasonal-card / inline-size;
+          font: inherit;
+          color: var(--card-color, var(--text, #3e2723));
+          background: var(--card-background, white);
+          border: 1px solid var(--card-border-color, transparent);
+          border-radius: var(--card-radius, 8px);
+          box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+        }
+
+        article {
+          display: grid;
+          gap: 10px;
+          padding: var(--card-padding, 20px);
+          text-align: center;
+          overflow-wrap: anywhere;
+        }
+
+        .content, .actions {
+          min-inline-size: 0;
+        }
+
+        .content {
+          display: grid;
+          gap: 10px;
+        }
+
+        .actions {
+          align-self: end;
+        }
+
+        ::slotted([slot="title"]) {
+          margin: 0;
+          color: var(--card-heading-color, var(--primary, #4e342e));
+        }
+
+        ::slotted([slot="description"]) {
+          margin: 0;
+        }
+
+        ::slotted([slot="action"]) {
+          margin: 0;
+          max-inline-size: 100%;
+        }
+      }
+
+      @layer variants {
+        /* Public tokens remain inherited; variants only change fallback values. */
+        :host([variant="featured"]) {
+          border-color: var(--card-border-color, var(--accent, #ffab40));
+          border-block-start-width: 4px;
+        }
+
+        :host([variant="subtle"]) {
+          background: var(--card-background, var(--secondary, #d7ccc8));
+          box-shadow: none;
+        }
+      }
+
+      @layer layout {
+        /* Query the host's available width, and change only its descendants. */
+        @container seasonal-card (min-width: 28rem) {
+          article {
+            grid-template-columns: minmax(0, 1fr) minmax(0, auto);
+            align-items: center;
+            gap: 1.5rem;
+            text-align: start;
+          }
+
+          .actions {
+            align-self: center;
+          }
+        }
+      }
+    </style>
+    <article part="surface">
+      <div class="content" part="content">
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+      </div>
+      <footer class="actions" part="actions">
+        <slot name="action"></slot>
+      </footer>
+    </article>
+  </template>
+
+  <script type="module">
+    const cardTemplate = document.getElementById('seasonal-card-template');
+
+    class SeasonalCard extends HTMLElement {
+      constructor() {
+        super();
+        const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+        root.append(cardTemplate.content.cloneNode(true));
+      }
+    }
+
+    customElements.define('seasonal-card', SeasonalCard);
+  </script>
 </body>
 
