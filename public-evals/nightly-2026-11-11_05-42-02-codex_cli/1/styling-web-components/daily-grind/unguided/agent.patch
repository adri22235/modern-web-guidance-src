+  <!-- Slots accept page content; parts expose selected internal styling hooks.
+       Theme variables and typography inherit through the shadow boundary. -->
+  <template id="coffee-card-template">
+    <style>
+      @layer reset, base, variants, layout;
+
+      @layer reset {
+        *, *::before, *::after { box-sizing: border-box; }
+        header, footer { margin: 0; padding: 0; }
+        ::slotted(*) { margin: 0; }
+      }
+
+      @layer base {
+        :host {
+          display: block;
+          min-width: 0;
+          container: coffee-card / inline-size;
+          color: var(--text, #3e2723);
+          font: inherit;
+          background: var(--card-background, white);
+          border: 1px solid transparent;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+        }
+
+        .surface {
+          display: grid;
+          grid-template-rows: auto 1fr auto;
+          gap: 10px;
+          height: 100%;
+          padding: 20px;
+          text-align: center;
+          overflow-wrap: anywhere;
+        }
+
+        .heading { color: var(--primary, #4e342e); }
+        ::slotted([slot="title"]) { font-size: 1.17em; }
+        ::slotted([slot="action"]) { max-width: 100%; }
+        .actions { align-self: end; }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          border-top: 4px solid var(--accent, #ffab40);
+        }
+
+        :host([variant="outlined"]) {
+          border-color: var(--secondary, #d7ccc8);
+          box-shadow: none;
+        }
+      }
+
+      @layer layout {
+        /* Query the host's width, never the viewport or the queried element. */
+        @container coffee-card (max-width: 18rem) {
+          .surface { padding: 16px; }
+        }
+
+        @container coffee-card (min-width: 28rem) {
+          .surface {
+            grid-template-columns: minmax(0, 1fr) auto;
+            grid-template-rows: auto 1fr;
+            column-gap: 24px;
+            text-align: start;
+          }
+
+          .heading, .description { grid-column: 1; }
+          .actions { grid-column: 2; grid-row: 1 / 3; align-self: center; }
+        }
+      }
+    </style>
+    <article class="surface" part="surface">
+      <header class="heading" part="heading"><slot name="title"></slot></header>
+      <div class="description" part="description"><slot name="description"></slot></div>
+      <footer class="actions" part="actions"><slot name="action"></slot></footer>
+    </article>
+  </template>
+  <script type="module">
+    class CoffeeCard extends HTMLElement {
+      constructor() {
+        super();
+        const template = document.getElementById('coffee-card-template');
+        this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
