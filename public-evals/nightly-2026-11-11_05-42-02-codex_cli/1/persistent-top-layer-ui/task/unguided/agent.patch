+  <script>
+    const overlay = document.getElementById('feedback-overlay');
+    const dialog = document.getElementById('feedback-dialog');
+    const launcher = document.getElementById('open-feedback');
+    const moveButton = document.getElementById('move-feedback');
+    const form = document.getElementById('feedback-form');
+    const success = document.getElementById('feedback-success');
+    const hosts = [
+      { element: document.getElementById('seasonal-section'), label: 'Seasonal favorites' },
+      { element: document.getElementById('footer-section'), label: 'Footer' },
+      { element: document.getElementById('hero-section'), label: 'Hero' }
+    ];
+    let hostIndex = 0;
+    let returnFocus = launcher;
+    let previousOverflow = '';
+    const inertElements = new Map();
+
+    // Only the branches outside the modal become inert, even when its host changes.
+    function restorePage() {
+      inertElements.forEach((wasInert, element) => { element.inert = wasInert; });
+      inertElements.clear();
+    }
+    function isolateModal() {
+      let branch = overlay;
+      while (branch.parentElement) {
+        for (const sibling of branch.parentElement.children) {
+          if (sibling !== branch && sibling instanceof HTMLElement && sibling.tagName !== 'SCRIPT') {
+            inertElements.set(sibling, sibling.inert);
+            sibling.inert = true;
+          }
+        }
+        branch = branch.parentElement;
+        if (branch === document.body) break;
+      }
+    }
+    function openFeedback() {
+      if (!overlay.hidden) return;
+      returnFocus = document.activeElement;
+      previousOverflow = document.body.style.overflow;
+      overlay.hidden = false;
+      document.body.style.overflow = 'hidden';
+      isolateModal();
+      document.getElementById('close-feedback').focus({ preventScroll: true });
+    }
+    function closeFeedback() {
+      overlay.hidden = true;
+      restorePage();
+      document.body.style.overflow = previousOverflow;
+      if (returnFocus instanceof HTMLElement && returnFocus.isConnected) returnFocus.focus({ preventScroll: true });
+    }
+    function updateLocation() {
+      document.getElementById('modal-location').textContent = 'Viewing in: ' + hosts[hostIndex].label;
+      moveButton.title = 'Move feedback to ' + hosts[(hostIndex + 1) % hosts.length].label;
+    }
+    moveButton.addEventListener('click', () => {
+      const focused = document.activeElement;
+      const selection = focused instanceof HTMLTextAreaElement || focused instanceof HTMLInputElement
+        ? { start: focused.selectionStart, end: focused.selectionEnd, direction: focused.selectionDirection } : null;
+      const scrollTop = dialog.scrollTop;
+      restorePage();
+      hostIndex = (hostIndex + 1) % hosts.length;
+      const host = hosts[hostIndex].element;
+      // moveBefore preserves native focus and element state in supporting browsers.
+      // The fallback moves the same node and explicitly restores focus and selection.
+      if (typeof host.moveBefore === 'function') host.moveBefore(overlay, null);
+      else host.appendChild(overlay);
+      isolateModal();
+      updateLocation();
+      if (focused instanceof HTMLElement && overlay.contains(focused)) {
+        focused.focus({ preventScroll: true });
+        if (selection && selection.start !== null) focused.setSelectionRange(selection.start, selection.end, selection.direction);
+      }
+      dialog.scrollTop = scrollTop;
+    });
+    launcher.addEventListener('click', openFeedback);
+    document.getElementById('close-feedback').addEventListener('click', closeFeedback);
+    overlay.addEventListener('click', event => { if (event.target === overlay) closeFeedback(); });
+    document.addEventListener('keydown', event => {
+      if (overlay.hidden) return;
+      if (event.key === 'Escape') { event.preventDefault(); closeFeedback(); }
+      if (event.key === 'Tab') {
+        const focusable = [...dialog.querySelectorAll('button, input, select, textarea, [tabindex="0"]')]
+          .filter(element => !element.disabled && element.getClientRects().length > 0);
+        const first = focusable[0];
+        const last = focusable[focusable.length - 1];
+        if (event.shiftKey && (document.activeElement === first || document.activeElement === dialog)) {
+          event.preventDefault(); last.focus();
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault(); first.focus();
+        }
+      }
+    });
+    document.addEventListener('focusin', event => {
+      if (!overlay.hidden && !dialog.contains(event.target)) dialog.focus({ preventScroll: true });
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      form.hidden = true;
+      success.hidden = false;
+      success.focus({ preventScroll: true });
+    });
+    document.getElementById('edit-feedback').addEventListener('click', () => {
+      success.hidden = true;
+      form.hidden = false;
+      document.getElementById('feedback-message').focus({ preventScroll: true });
+    });
+    hosts[hostIndex].element.appendChild(overlay);
+    updateLocation();
+    openFeedback();
+  </script>
