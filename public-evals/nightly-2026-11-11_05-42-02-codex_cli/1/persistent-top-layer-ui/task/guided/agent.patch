+  <button class="feedback-launch" id="open-feedback" type="button" aria-haspopup="dialog" aria-controls="feedback-dialog">Give feedback</button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('open-feedback');
+    const feedbackLocation = document.getElementById('feedback-location');
+    const feedbackSections = [
+      { element: document.getElementById('favorites-section'), name: 'Seasonal Favorites' },
+      { element: document.getElementById('welcome-section'), name: 'Welcome' }
+    ];
+    let usedMoveFallback = false;
+
+    feedbackLauncher.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    document.getElementById('move-feedback').addEventListener('click', () => {
+      const destination = feedbackSections.find(section => section.element !== feedbackDialog.parentElement);
+
+      if (typeof destination.element.moveBefore === 'function') {
+        // An atomic move preserves the top layer, modality, focus, and form state.
+        destination.element.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const focusedElement = document.activeElement;
+        const scrollPosition = feedbackDialog.scrollTop;
+        // Explicitly close first: some engines retain `open` after detaching,
+        // even though the dialog is no longer in the modal top layer.
+        if (wasOpen) feedbackDialog.close();
+        destination.element.appendChild(feedbackDialog);
+        if (wasOpen) {
+          feedbackDialog.showModal();
+          if (feedbackDialog.contains(focusedElement)) focusedElement.focus();
+          feedbackDialog.scrollTop = scrollPosition;
+          usedMoveFallback = true;
+        }
+      }
+
+      feedbackLocation.textContent = destination.name;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      // Ignore the queued close event from a synchronous fallback move.
+      if (feedbackDialog.open) return;
+      feedbackDialog.returnValue = '';
+      // Reopening in the fallback replaces the browser's remembered invoker.
+      if (usedMoveFallback) feedbackLauncher.focus();
+      usedMoveFallback = false;
+    });
+  </script>
+
