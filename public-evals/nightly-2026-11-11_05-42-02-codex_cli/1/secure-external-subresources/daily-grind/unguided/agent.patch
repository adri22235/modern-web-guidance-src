+      },
+      "latte": {
+        "url": "https://images.unsplash.com/photo-1541167760496-1628856ab772?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-dtnD0xter30KbjXWTaSibu9xBLshJa+/TONLhfwUNjEj71lGWoO0aIqXZvRiC7iU"
+      },
+      "espresso": {
+        "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-Yl309C3L1ztIQVEAWthyto6bmQ0NCfR6Fh0FKlo8X3ivrTz/hzKSRVHh4ZXfJ2SX"
+      },
+      "coldBrew": {
+        "url": "https://images.unsplash.com/photo-1517701604599-bb29b565090c?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-8BVYoeCa4BfhP0cdbKGlxiGxgD6YRYCANIIF9K4gA7wJ+qrwR9xBeHLywbueB0EJ"
+      }
+    };
+
+    async function fetchVerified(resource) {
+      const response = await fetch(resource.url, {
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer',
+        integrity: resource.integrity
+      });
+      if (!response.ok) {
+        throw new Error(`Resource request failed: ${response.status}`);
+      }
+      return response;
+    }
+
+    async function loadFont() {
+      const response = await fetchVerified(resources.font);
+      const font = new FontFace('Lora', await response.arrayBuffer(), {
+        weight: '700',
+        style: 'normal',
+        display: 'swap'
+      });
+      document.fonts.add(await font.load());
+    }
+
+    const imageURLs = new Set();
+
+    async function loadImage(name, target) {
+      const response = await fetchVerified(resources[name]);
+      const objectURL = URL.createObjectURL(await response.blob());
+      try {
+        // Decode before showing the image; the object URL contains verified bytes.
+        const image = target instanceof HTMLImageElement ? target : new Image();
+        image.src = objectURL;
+        await image.decode();
+        if (target instanceof HTMLImageElement) {
+          target.hidden = false;
+        } else {
+          target.style.backgroundImage =
+            `linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("${objectURL}")`;
+        }
+        imageURLs.add(objectURL);
+      } catch (error) {
+        URL.revokeObjectURL(objectURL);
+        throw error;
+      }
+    }
+
+    // Keep CSS background URLs alive, including when restored from the back cache.
+    window.addEventListener('pagehide', event => {
+      if (!event.persisted) {
+        imageURLs.forEach(url => URL.revokeObjectURL(url));
+        imageURLs.clear();
+      }
+    });
+
+    // Each failure leaves the readable fallback intact; never retry without SRI.
+    const loads = [
+      loadFont(),
+      loadImage('hero', document.querySelector('.hero')),
+      ...['latte', 'espresso', 'coldBrew'].map(name =>
+        loadImage(name, document.getElementById(`${name}-image`)))
+    ];
+    loads.forEach(load => load.catch(error => {
+      console.warn('A verified resource could not be loaded.', error);
+    }));
+
+    // The deferred, integrity-checked date library runs before DOMContentLoaded.
+    document.addEventListener('DOMContentLoaded', () => {
+      if (typeof window.dayjs === 'function') {
+        document.getElementById('copyright-year').textContent = window.dayjs().format('YYYY');
+      }
+    });
+  </script>
