+  <script>
+    // img integrity attributes and CSS font/background URLs do not provide
+    // interoperable SRI enforcement. Only consume bytes verified by Fetch.
+    // Update each hash from trusted bytes whenever its URL/content changes.
+    const resources = {
+      "font": {
+        "url": "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.2.5/files/lora-latin-700-normal.woff2",
+        "integrity": "sha384-eduTq0nbJRox0ZxXDajngp8m4uCWhvGQvhTRwsqTY1ItH3f0Iea7Vmhgk6rVm1vZ"
