+  <script type="module">
+    // Native scroll-state queries track the browser's actual snap target.
+    // Older browsers update the decorative highlight once scrolling settles.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const carousel = document.querySelector('.carousel');
+      const items = [...carousel.querySelectorAll('.carousel-item')];
+      const updateHighlight = () => {
+        const bounds = carousel.getBoundingClientRect();
+        const center = bounds.left + carousel.clientWidth / 2;
+        const nearest = items.reduce((closest, item) => {
+          const distance = (element) => {
+            const rect = element.getBoundingClientRect();
+            return Math.abs(rect.left + rect.width / 2 - center);
+          };
+          return distance(item) < distance(closest) ? item : closest;
+        });
+        items.forEach(item => item.classList.toggle('is-snapped', item === nearest));
+      };
+
+      if ('onscrollend' in carousel) {
+        carousel.addEventListener('scrollend', updateHighlight);
+      } else {
+        let settleTimer;
+        carousel.addEventListener('scroll', () => {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(updateHighlight, 150);
+        }, { passive: true });
+      }
+
+      new ResizeObserver(updateHighlight).observe(carousel);
+      updateHighlight();
+    }
+  </script>
