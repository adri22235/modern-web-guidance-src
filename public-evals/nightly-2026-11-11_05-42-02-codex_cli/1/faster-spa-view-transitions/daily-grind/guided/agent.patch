+++ b/app.js
@@ -0,0 +1,84 @@
+(() => {
+  const views = new Map(
+    [...document.querySelectorAll('[data-view]')].map(view => [view.dataset.view, view])
+  );
+  const routes = new Map([
+    ['#/', 'home'],
+    ['#/menu', 'menu'],
+    ['#/locations', 'locations'],
+    ['#/rewards', 'rewards'],
+    ['#/account', 'account']
+  ]);
+  const titles = {
+    home: 'The Daily Grind | Artisanal Coffee',
+    menu: 'Menu | The Daily Grind',
+    locations: 'Locations | The Daily Grind',
+    rewards: 'Rewards | The Daily Grind',
+    account: 'My Account | The Daily Grind'
+  };
+  const scrollPositions = new Map();
+  let activeRoute;
+
+  // The cache is bounded to five permanent view trees. Never replace their DOM:
+  // inputs, expanded details, listeners, and cached rendering survive navigation.
+  function showRoute({ initial = false } = {}) {
+    const route = routes.get(location.hash || '#/') || 'home';
+    if (route === activeRoute) return;
+
+    if (activeRoute) scrollPositions.set(activeRoute, window.scrollY);
+    for (const [name, view] of views) {
+      const inactive = name !== route;
+      view.classList.toggle('inactive', inactive);
+      view.toggleAttribute('inert', inactive);
+      view.setAttribute('aria-hidden', String(inactive));
+    }
+    activeRoute = route;
+    document.title = titles[route];
+    for (const link of document.querySelectorAll('nav a')) {
+      if (routes.get(link.hash) === route) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+    if (!initial) {
+      views.get(route).focus({ preventScroll: true });
+      window.scrollTo({ top: scrollPositions.get(route) || 0, behavior: 'instant' });
+    }
+  }
+
+  // Only handle our routes and ordinary clicks; retain new-tab and external links.
+  document.addEventListener('click', event => {
+    const link = event.target.closest('a[href]');
+    if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey ||
+        event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') ||
+        (link.target && link.target !== '_self')) return;
+    const url = new URL(link.href, location.href);
+    if (url.origin !== location.origin || url.pathname !== location.pathname ||
+        url.search !== location.search || !routes.has(url.hash)) return;
+    event.preventDefault();
+    if (url.hash === location.hash) return;
+    history.pushState(null, '', url.hash);
+    showRoute();
+  });
+
+  // Hash URLs work on static hosts and support bookmarks and browser history.
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+  window.addEventListener('popstate', () => showRoute());
+  window.addEventListener('hashchange', () => showRoute());
+  showRoute({ initial: true });
+
+  const search = document.getElementById('menu-search');
+  search.addEventListener('input', () => {
+    const query = search.value.trim().toLowerCase();
+    let matches = 0;
+    for (const card of document.querySelectorAll('#menu-items .card')) {
+      card.hidden = !card.textContent.toLowerCase().includes(query);
+      if (!card.hidden) matches++;
+    }
+    document.getElementById('menu-empty').hidden = matches !== 0;
+  });
+
+  document.getElementById('account-form').addEventListener('submit', event => {
+    event.preventDefault();
+    document.getElementById('account-status').textContent =
+      'Preferences kept for this tab. They will reset when you reload or close it.';
+  });
+})();
