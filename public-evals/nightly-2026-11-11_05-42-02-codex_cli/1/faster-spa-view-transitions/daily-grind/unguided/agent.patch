+(() => {
+  const outlet = document.querySelector('#views');
+  const home = outlet.querySelector('[data-view="/"]');
+  const views = new Map([['/', { element: home, scroll: 0 }]]);
+  const routes = new Map([
+    ['/', 'Home'], ['/menu', 'Menu'], ['/locations', 'Locations'],
+    ['/rewards', 'Rewards'], ['/account', 'My Account'],
+  ]);
+  let activeRoute = '/';
+
+  // The document owns scrolling; restore each retained view's position ourselves.
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+  function setupView(route, element) {
+    if (route === '/menu') {
+      const search = element.querySelector('[name="menu-search"]');
+      const category = element.querySelector('[name="category"]');
+      const cards = [...element.querySelectorAll('[data-category]')];
+      const filter = () => {
+        let count = 0;
+        for (const card of cards) {
+          card.hidden = !(category.value === 'all' || card.dataset.category === category.value)
+            || !card.textContent.toLowerCase().includes(search.value.trim().toLowerCase());
+          if (!card.hidden) count++;
+        }
+        element.querySelector('[data-results]').textContent = count
+          ? `${count} drink${count === 1 ? '' : 's'} found.` : 'No drinks found. Try another search or category.';
+      };
+      search.addEventListener('input', filter);
+      category.addEventListener('change', filter);
+      filter();
+    }
+
+    if (route === '/locations') {
+      const search = element.querySelector('[name="location-search"]');
+      const cards = [...element.querySelectorAll('[data-location]')];
+      const filter = () => {
+        let count = 0;
+        for (const card of cards) {
+          card.hidden = !card.querySelector('h3').textContent.toLowerCase()
+            .includes(search.value.trim().toLowerCase());
+          if (!card.hidden) count++;
+        }
+        element.querySelector('[data-results]').textContent = count
+          ? `${count} location${count === 1 ? '' : 's'} found.` : 'No locations found. Try another neighborhood.';
+      };
+      search.addEventListener('input', filter);
+      filter();
+    }
+
+    if (route === '/account') {
+      element.querySelector('form').addEventListener('submit', (event) => {
+        event.preventDefault();
+        element.querySelector('[role="status"]').textContent = 'Preferences saved for this visit.';
+      });
+    }
+  }
+
+  function getView(route) {
+    if (!views.has(route)) {
+      const element = document.createElement('div');
+      element.dataset.view = route;
+      element.hidden = true;
+      element.inert = true;
+      const template = document.getElementById(`view-${route.slice(1)}`);
+      element.append(template.content.cloneNode(true));
+      outlet.append(element);
+      setupView(route, element);
+      views.set(route, { element, scroll: 0 });
+    }
+    return views.get(route);
+  }
+
+  function navigate(initial = false) {
+    const [path, query = ''] = (location.hash.slice(1) || '/').split('?');
+    const route = routes.has(path) ? path : '/not-found';
+    const previous = views.get(activeRoute);
+    const next = getView(route);
+    const switching = route !== activeRoute;
+
+    if (switching) {
+      previous.scroll = window.scrollY;
+      // Keep nodes attached: form values, listeners and other local DOM state survive.
+      previous.element.hidden = true;
+      previous.element.inert = true;
+      next.element.hidden = false;
+      next.element.inert = false;
+      activeRoute = route;
+    }
+
+    if (route === '/menu') {
+      const category = new URLSearchParams(query).get('category');
+      const select = next.element.querySelector('[name="category"]');
+      if (category && [...select.options].some(option => option.value === category)) {
+        select.value = category;
+        select.dispatchEvent(new Event('change'));
+      }
+    }
+
+    document.title = `${routes.get(route) || 'Page not found'} | The Daily Grind`;
+    document.querySelectorAll('nav a').forEach(link => {
+      if (link.getAttribute('href') === `#${route}`) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+
+    if (switching && !initial) {
+      next.element.querySelector('h1')?.focus({ preventScroll: true });
+    }
+    if (switching) window.scrollTo(0, next.scroll);
+  }
+
+  home.querySelector('h1').tabIndex = -1;
+  window.addEventListener('hashchange', () => navigate());
+  navigate(true);
+})();
