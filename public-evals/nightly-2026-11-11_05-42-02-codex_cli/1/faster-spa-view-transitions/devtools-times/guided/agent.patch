 @import "tailwindcss";
 
+/* Keep inactive sections connected so islands, controls and rendering state survive. */
+[data-section-view].inactive {
+  content-visibility: hidden;
+  contain-intrinsic-size: none;
+  position: absolute;
+  inset: 0 0 auto;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  [data-section-view].inactive {
+    display: none;
+  }
+}
+
+[data-section-link][aria-current="page"] {
+  color: var(--color-amber-800);
+  text-decoration: underline;
+  text-underline-offset: 0.3em;
+}
