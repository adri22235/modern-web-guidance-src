new file mode 100644
index 0000000..77b0556
--- /dev/null
+++ b/src/pages/world.astro
@@ -0,0 +1,15 @@
+---
+import Layout from '../layouts/Layout.astro';
+import SimpleTeaserGrid from '../components/SimpleTeaserGrid.astro';
+import { getCollection } from 'astro:content';
+
+// Show the same World selection as the front page.
+const articles = await getCollection('articles');
+articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+const worldArticles = articles.slice(8, 11);
+---
+
+<Layout title="World | The DevTools Times" sectionView>
+  <h1 class="sr-only">World</h1>
+  <SimpleTeaserGrid title="World" articles={worldArticles} />
+</Layout>
diff --git a/src/scripts/section-navigation.ts b/src/scripts/section-navigation.ts
new file mode 100644
index 0000000..b9880a6
--- /dev/null
+++ b/src/scripts/section-navigation.ts
@@ -0,0 +1,124 @@
+import visibleDirective from 'astro/client/visible.js';
+
+/** Section views stay connected: revisits reuse the actual DOM, including hydrated islands. */
+const host = document.querySelector<HTMLElement>('[data-section-views]');
+const initialView = host?.querySelector<HTMLElement>('[data-section-view]');
+const pathConfig = document.querySelector<HTMLElement>('[data-section-paths]');
+
+if (host && initialView && pathConfig) {
+  // A direct entry to Reports/Multimedia has no client:visible islands. Register
+  // their directive before adopting article views; DOMParser scripts do not run.
+  const astro = (window as Window & { Astro: Record<string, unknown> }).Astro;
+  if (!astro.visible) {
+    astro.visible = visibleDirective;
+    window.dispatchEvent(new Event('astro:visible'));
+  }
+  type View = { element: HTMLElement; title: string; scroll: number };
+  const pathKey = (url: URL) => url.pathname.replace(/\/$/, '') || '/';
+  const allowedPaths = new Set<string>(
+    JSON.parse(pathConfig.dataset.sectionPaths!).map((path: string) => pathKey(new URL(path, location.origin))),
+  );
+  const views = new Map<string, View>();
+  // Category flyouts can add more routes than the five primary sections. Bound memory use.
+  const maxViews = 8;
+  let activeKey = pathKey(new URL(location.href));
+  views.set(activeKey, { element: initialView, title: document.title, scroll: window.scrollY });
+  let pending: AbortController | undefined;
+  let navigation = 0;
+  history.scrollRestoration = 'manual';
+
+  function updateNavigation() {
+    document.querySelectorAll<HTMLAnchorElement>('[data-section-link]').forEach(link => {
+      if (pathKey(new URL(link.href)) === activeKey) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+  }
+
+  async function navigate(url: URL, traversal = false) {
+    const request = ++navigation;
+    pending?.abort();
+    pending = undefined;
+    const key = pathKey(url);
+    const current = views.get(activeKey)!;
+    current.scroll = window.scrollY;
+    let target = views.get(key);
+
+    try {
+      if (!target) {
+        const controller = new AbortController();
+        pending = controller;
+        host!.setAttribute('aria-busy', 'true');
+        const response = await fetch(url, { signal: controller.signal });
+        if (!response.ok || response.redirected || !response.headers.get('content-type')?.includes('text/html')) {
+          throw new Error('Section unavailable');
+        }
+        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
+        const element = page.querySelector<HTMLElement>('[data-section-views] > [data-section-view]');
+        if (!element) throw new Error('Not a section view');
+        if (request !== navigation) return;
+        target = { element: document.adoptNode(element), title: page.title, scroll: 0 };
+        // Insert hidden first so deferred islands are not hydrated just for insertion.
+        target.element.classList.add('inactive');
+        target.element.inert = true;
+        target.element.setAttribute('aria-hidden', 'true');
+        host!.append(target.element);
+        views.set(key, target);
+      }
+      if (request !== navigation) return;
+      current.scroll = window.scrollY;
+      if (!traversal && location.href !== url.href) history.pushState(null, '', url);
+
+      current.element.classList.add('inactive');
+      current.element.inert = true;
+      current.element.setAttribute('aria-hidden', 'true');
+      target.element.classList.remove('inactive');
+      target.element.inert = false;
+      target.element.removeAttribute('aria-hidden');
+      target.element.setAttribute('aria-label', target.title);
+      activeKey = key;
+      document.title = target.title;
+      // Refresh insertion order for the least-recently-used eviction policy.
+      views.delete(key);
+      views.set(key, target);
+      while (views.size > maxViews) {
+        const oldest = views.keys().next().value!;
+        views.get(oldest)!.element.remove();
+        views.delete(oldest);
+        // Astro islands defer React cleanup until this lifecycle event.
+        document.dispatchEvent(new Event('astro:after-swap'));
+      }
+      updateNavigation();
+      target.element.focus({ preventScroll: true });
+      window.scrollTo({ top: target.scroll, behavior: 'instant' });
+    } catch (error) {
+      if (request !== navigation || (error instanceof DOMException && error.name === 'AbortError')) return;
+      // Keep ordinary document navigation as the fallback for network or parsing failures.
+      location.assign(url.href);
+    } finally {
+      if (request === navigation) {
+        host!.removeAttribute('aria-busy');
+        pending = undefined;
+      }
+    }
+  }
+
+  document.addEventListener('click', event => {
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
+    if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self') || link.hasAttribute('data-astro-reload')) return;
+    const url = new URL(link.href);
+    if (url.origin !== location.origin || url.search || url.hash || !allowedPaths.has(pathKey(url))) return;
+    event.preventDefault();
+    void navigate(url);
+  });
+
+  window.addEventListener('popstate', () => {
+    const url = new URL(location.href);
+    if (url.search || url.hash || !allowedPaths.has(pathKey(url))) {
+      location.reload();
+      return;
+    }
+    void navigate(url, true);
+  });
+  updateNavigation();
+}
