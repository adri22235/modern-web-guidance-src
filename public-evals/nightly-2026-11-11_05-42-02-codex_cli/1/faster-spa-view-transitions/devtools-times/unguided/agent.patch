diff --git a/src/scripts/section-views.js b/src/scripts/section-views.js
new file mode 100644
index 0000000..0143090
--- /dev/null
+++ b/src/scripts/section-views.js
@@ -0,0 +1,77 @@
+// Every panel stays connected to the document, including its hydrated islands.
+// `hidden` removes inactive panels from layout, keyboard navigation and the
+// accessibility tree without discarding their DOM or component state.
+const mounted = new WeakSet();
+
+export function mountSectionViews(root) {
+    if (mounted.has(root)) return;
+    mounted.add(root);
+
+    const panels = [...root.querySelectorAll('[data-section-view]')];
+    const links = [...root.querySelectorAll('[data-section-link]')];
+    const normalizePath = path => path.replace(/\/$/, '') || '/';
+    const routes = new Map(links.map(link => [
+        normalizePath(new URL(link.href).pathname), link.dataset.sectionLink,
+    ]));
+    const positions = new Map();
+    let active = panels.find(panel => !panel.hidden)?.dataset.sectionView;
+    const previousScrollRestoration = history.scrollRestoration;
+    history.scrollRestoration = 'manual';
+
+    function show(id, restoreScroll = true) {
+        const panel = panels.find(panel => panel.dataset.sectionView === id);
+        if (!panel) return;
+        const changed = active !== id;
+        if (changed) positions.set(active, [window.scrollX, window.scrollY]);
+        for (const item of panels) item.hidden = item !== panel;
+        for (const link of links) {
+            if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'page');
+            else link.removeAttribute('aria-current');
+        }
+        active = id;
+        document.title = panel.dataset.title;
+        if (changed && restoreScroll) {
+            panel.focus({ preventScroll: true });
+            const [left, top] = positions.get(id) || [0, 0];
+            window.scrollTo({ left, top, behavior: 'instant' });
+        }
+    }
+
+    function onClick(event) {
+        if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+            event.ctrlKey || event.shiftKey || event.altKey) return;
+        const link = event.target.closest?.('a[href]');
+        if (!link || link.hasAttribute('download') || link.hasAttribute('data-astro-reload') ||
+            (link.target && link.target !== '_self')) return;
+        const url = new URL(link.href, location.href);
+        const id = routes.get(normalizePath(url.pathname));
+        if (!id || url.origin !== location.origin || url.hash) return;
+
+        // These routes are already mounted; no request or document swap is needed.
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        if (url.href !== location.href) {
+            history.pushState({ ...history.state, sectionView: id }, '', url.href);
+        }
+        show(id);
+    }
+
+    function onPopState(event) {
+        const url = new URL(location.href);
+        const id = routes.get(normalizePath(url.pathname));
+        if (!id) return;
+        // A section history entry needs no fetch or swap.
+        event.stopImmediatePropagation();
+        show(id);
+    }
+
+    document.addEventListener('click', onClick, { capture: true });
+    window.addEventListener('popstate', onPopState, { capture: true });
+    document.addEventListener('astro:before-swap', () => {
+        document.removeEventListener('click', onClick, { capture: true });
+        window.removeEventListener('popstate', onPopState, { capture: true });
+        history.scrollRestoration = previousScrollRestoration;
+        mounted.delete(root);
+    }, { once: true });
+    show(routes.get(normalizePath(location.pathname)) || active, false);
+}
diff --git a/tests/section-views.test.js b/tests/section-views.test.js
new file mode 100644
index 0000000..744e525
--- /dev/null
+++ b/tests/section-views.test.js
@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mountSectionViews } from '../src/scripts/section-views.js';
+
+// A small DOM/History fixture exercises the router without starting a server.
+function fixture(initial = 'top-news') {
+    const ids = ['top-news', 'world', 'politics', 'multimedia', 'reports'];
+    const panels = ids.map(id => ({
+        dataset: { sectionView: id, title: `${id} title` },
+        hidden: id !== initial,
+        focus(options) { this.focusOptions = options; },
+        input: { value: '' },
+    }));
+    const links = ids.map(id => ({
+        href: `https://example.test/devtools-times/${id === 'top-news' ? '' : id}`,
+        dataset: { sectionLink: id }, target: '', attributes: {},
+        closest() { return this; },
+        hasAttribute(name) { return name in this.attributes; },
+        setAttribute(name, value) { this.attributes[name] = value; },
+        removeAttribute(name) { delete this.attributes[name]; },
+    }));
+    const root = { querySelectorAll: selector => selector === '[data-section-view]' ? panels : links };
+    const document = new EventTarget();
+    const window = new EventTarget();
+    Object.assign(window, { scrollX: 0, scrollY: 0, scrollTo({ left, top }) { this.scrollX = left; this.scrollY = top; } });
+    const location = new URL(links[ids.indexOf(initial)].href);
+    const entries = [location.href];
+    const history = {
+        state: null, scrollRestoration: 'auto',
+        pushState(state, _, href) { this.state = state; entries.push(href); location.href = href; },
+    };
+    Object.assign(globalThis, { document, window, history, location });
+    function click(link, options = {}) {
+        const event = new Event('click', { cancelable: true });
+        Object.defineProperty(event, 'target', { value: link });
+        Object.assign(event, { button: 0, ...options });
+        document.dispatchEvent(event);
+        return event;
+    }
+    function pop(id) {
+        location.href = links[ids.indexOf(id)].href;
+        window.dispatchEvent(new Event('popstate'));
+    }
+    const cleanup = () => document.dispatchEvent(new Event('astro:before-swap'));
+    return { root, panels, links, document, window, history, location, entries, click, pop, cleanup };
+}
+
+test('switching all sections preserves panel identity, local state and scroll position', () => {
+    const f = fixture();
+    mountSectionViews(f.root);
+    const originalPanels = [...f.panels];
+    f.panels[0].input.value = 'unfinished interaction';
+    f.window.scrollY = 420;
+    for (let i = 1; i < f.links.length; i++) {
+        assert.equal(f.click(f.links[i]).defaultPrevented, true);
+        assert.deepEqual(f.panels.map(p => p.hidden), f.panels.map((_, index) => index !== i));
+        assert.equal(f.document.title, `${f.links[i].dataset.sectionLink} title`);
+        assert.equal(f.links[i].attributes['aria-current'], 'page');
+        assert.equal(f.window.scrollY, 0);
+    }
+    f.click(f.links[0]);
+    assert.equal(f.panels[0].input.value, 'unfinished interaction');
+    assert.equal(f.window.scrollY, 420);
+    f.panels.forEach((panel, i) => assert.equal(panel, originalPanels[i]));
+    assert.equal(f.entries.length, 6);
+    f.click(f.links[0]);
+    assert.equal(f.entries.length, 6, 'clicking the current URL does not add history');
+    f.cleanup();
+});
+
+test('direct entry and back/forward navigation select existing views without adding history', () => {
+    const f = fixture('reports');
+    mountSectionViews(f.root);
+    f.click(f.links[1]);
+    f.panels[1].input.value = 'world state';
+    f.window.scrollY = 130;
+    f.pop('reports');
+    assert.equal(f.panels[4].hidden, false);
+    f.pop('world');
+    assert.equal(f.panels[1].hidden, false);
+    assert.equal(f.panels[1].input.value, 'world state');
+    assert.equal(f.window.scrollY, 130);
+    assert.equal(f.entries.length, 2);
+    f.cleanup();
+});
+
+test('modified clicks, downloads, external URLs, hash links and article links keep normal navigation', () => {
+    const f = fixture();
+    mountSectionViews(f.root);
+    for (const options of [{ ctrlKey: true }, { metaKey: true }, { shiftKey: true }, { altKey: true }, { button: 1 }]) {
+        assert.equal(f.click(f.links[1], options).defaultPrevented, false);
+    }
+    for (const href of ['https://elsewhere.test/devtools-times/world', 'https://example.test/devtools-times/articles/story', `${f.links[1].href}#heading`]) {
+        assert.equal(f.click({ ...f.links[1], href }).defaultPrevented, false);
+    }
+    assert.equal(f.click({ ...f.links[1], target: '_blank' }).defaultPrevented, false);
+    assert.equal(f.click({ ...f.links[1], attributes: { download: '' } }).defaultPrevented, false);
+    assert.equal(f.entries.length, 1);
+    f.cleanup();
+});
+
+test('mounting is idempotent and cleanup removes navigation listeners', () => {
+    const f = fixture();
+    mountSectionViews(f.root);
+    mountSectionViews(f.root);
+    f.click(f.links[1]);
+    assert.equal(f.entries.length, 2);
+    assert.equal(f.history.scrollRestoration, 'manual');
+    f.cleanup();
+    assert.equal(f.history.scrollRestoration, 'auto');
+    assert.equal(f.click(f.links[2]).defaultPrevented, false);
+});
