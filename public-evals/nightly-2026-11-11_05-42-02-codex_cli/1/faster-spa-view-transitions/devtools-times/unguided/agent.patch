@@ -0,0 +1,139 @@
+---
+import ArticleTeaser from '../components/ArticleTeaser.astro';
+import TopStoryTeaserGrid from '../components/TopStoryTeaserGrid.astro';
+import Ad from '../components/AdSlotBanner';
+import { getCollection } from 'astro:content';
+import SimpleTeaserGrid from '../components/SimpleTeaserGrid.astro';
+import type { RenderResult } from 'astro:content';
+
+export interface Props {
+  initialView?: 'top-news' | 'world' | 'politics' | 'multimedia' | 'reports';
+}
+const { initialView = 'top-news' } = Astro.props;
+const sections = [
+  { id: 'top-news', label: 'Top News', path: '' },
+  { id: 'world', label: 'World', path: 'world' },
+  { id: 'politics', label: 'Politics', path: 'politics' },
+  { id: 'multimedia', label: 'Multimedia', path: 'multimedia' },
+  { id: 'reports', label: 'Reports', path: 'reports' },
+];
+const multimedia = await getCollection('multimedia');
+const reports = await getCollection('reports');
+const baseUrl = import.meta.env.BASE_URL;
+const articles = await getCollection('articles');
+articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+// Slicing articles for different sections
+const topArticle = articles[0];
+const topStories = articles.slice(1, 4);
+const topNewsArticles = articles.slice(4, 8);      // 4 articles for the new grid
+const worldNewsArticles = articles.slice(8, 11);    // 3 articles for the old grid
+const politicsArticles = articles.slice(11, 15);   // 4 articles for the new grid
+
+// Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+politicsArticles[2] = {
+    id: 'public-transit-overhaul',
+    data: {
+      title: 'What\'s new in DevTools',
+      summary: 'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+      author: 'Chrome DevTools Team',
+      date: new Date('2025-09-16T00:00:00.000Z'),
+      category: 'Web Development',
+      image: 'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+      image_caption: '',
+      readingTime: 3
+    },
+    body: '',
+    collection: 'articles',
+    slug: 'public-transit-overhaul',
+    render: async () => '' as unknown as RenderResult,
+  };
+---
+
+<div data-section-views>
+    <nav aria-label="Main sections" class="flex items-center gap-6 overflow-x-auto border-b border-gray-300 px-6 py-3 text-sm font-semibold">
+        {sections.map(section => (
+            <a href={`${baseUrl}${section.path}`} data-section-link={section.id} data-astro-prefetch="false"
+                aria-current={initialView === section.id ? 'page' : undefined}
+                class="whitespace-nowrap hover:text-amber-700 aria-[current=page]:text-amber-700 aria-[current=page]:underline underline-offset-8">
+                {section.label}
+            </a>
+        ))}
+    </nav>
+    <div data-section-view="top-news" data-title="The DevTools Times" hidden={initialView !== 'top-news'} tabindex="-1" role="region" aria-label="Top News">
+        <!-- Top Stories Bar -->
+        <div class="bg-white border-b border-gray-300">
+            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+                    {topStories.map(article => (
+                        <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
+                            <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                            </a>
+                            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                        </div>
+                    ))}
+                </div>
+            </div>
+        </div>
+
+        <!-- Main Content Area -->
+        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+            <ArticleTeaser article={topArticle} large={true} />
+        </div>
+
+        <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+            <section class="p-4 md:p-6 text-center">
+                <Ad client:visible />
+            </section>
+
+            <!-- "Top News" section with the new grid variant -->
+            <TopStoryTeaserGrid title="Top News" articles={topNewsArticles} />
+
+            <section class="p-4 md:p-6 text-center">
+                <Ad client:visible />
+            </section>
+
+        </div>
+    </div>
+    <div data-section-view="world" data-title="World | The DevTools Times" hidden={initialView !== 'world'} tabindex="-1" role="region" aria-label="World">
+        <SimpleTeaserGrid title="World" articles={worldNewsArticles} />
+    </div>
+    <div data-section-view="politics" data-title="Politics | The DevTools Times" hidden={initialView !== 'politics'} tabindex="-1" role="region" aria-label="Politics">
+        <TopStoryTeaserGrid title="Politics" articles={politicsArticles} />
+    </div>
+    <div data-section-view="multimedia" data-title="Multimedia | The DevTools Times" hidden={initialView !== 'multimedia'} tabindex="-1" role="region" aria-label="Multimedia">
+        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Multimedia</h1>
+            <div class="prose max-w-none">
+                <p>Watch our latest multimedia content.</p>
+                <ul>
+                    {multimedia.map(item => <li><a href={`${baseUrl}multimedia/${item.id}`}>{item.data.title}</a></li>)}
+                </ul>
+            </div>
+        </div>
+    </div>
+    <div data-section-view="reports" data-title="Reports | The DevTools Times" hidden={initialView !== 'reports'} tabindex="-1" role="region" aria-label="Reports">
+        <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Reports</h1>
+            <div class="prose max-w-none">
+                <p>Read our latest reports.</p>
+                <ul>
+                    {reports.map(report => <li><a href={`${baseUrl}reports/${report.id}`}>{report.data.title}</a></li>)}
+                </ul>
+            </div>
+        </div>
+    </div>
+</div>
+
+<script>
+    import { mountSectionViews } from '../scripts/section-views.js';
+
+    function initializeSectionViews() {
+        const root = document.querySelector<HTMLElement>('[data-section-views]');
+        if (root) mountSectionViews(root);
+    }
+
+    initializeSectionViews();
+    document.addEventListener('astro:page-load', initializeSectionViews);
+</script>
