+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const error = document.getElementById('newsletter-error');
+    const status = document.getElementById('newsletter-status');
+    const announcer = document.getElementById('newsletter-announcer');
+    let announcement;
+
+    // Use native email constraints, but control when feedback becomes visible.
+    newsletter.noValidate = true;
+
+    function clearFeedback() {
+      clearTimeout(announcement);
+      email.setAttribute('aria-invalid', 'false');
+      email.removeAttribute('aria-describedby');
+      error.hidden = true;
+      status.textContent = '';
+      announcer.textContent = '';
+    }
+
+    function validateEmail() {
+      clearFeedback();
+      if (email.validity.valid) return true;
+
+      error.textContent = email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter an email address in the format you@example.com.';
+      error.hidden = false;
+      email.setAttribute('aria-invalid', 'true');
+      email.setAttribute('aria-describedby', 'newsletter-error');
+      return false;
+    }
+
+    email.addEventListener('blur', () => {
+      if (!validateEmail()) {
+        // Allow the next focused control to be announced first.
+        announcement = setTimeout(() => {
+          announcer.textContent = error.textContent;
+        }, 500);
+      }
+    });
+    email.addEventListener('focus', clearFeedback);
+    email.addEventListener('input', clearFeedback);
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Enter can submit without a blur; finish editing before showing feedback.
+      email.blur();
+      if (!validateEmail()) {
+        announcer.textContent = error.textContent;
+        return;
+      }
+
+      // This static site has no mailing-list service configured yet.
+      status.textContent = 'Newsletter signup is not available yet. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
