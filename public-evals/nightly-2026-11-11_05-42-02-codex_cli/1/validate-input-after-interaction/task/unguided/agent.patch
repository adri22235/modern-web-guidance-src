@@ -206,7 +271,37 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-error');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    // Keep validation quiet until the user leaves the email field.
+    newsletterEmail.addEventListener('blur', () => {
+      const valid = newsletterEmail.validity.valid;
+      newsletterEmail.setAttribute('aria-invalid', String(!valid));
+      newsletterError.textContent = valid ? '' : 'Please enter a valid email address.';
+    });
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterError.textContent = '';
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Enter-key submission also leaves the field before validation appears.
+      newsletterEmail.blur();
+      if (!newsletterEmail.validity.valid) return;
+
+      // Replace this message with the signup request when a service is connected.
+      newsletterStatus.textContent = 'Signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
