+  <script>
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const animations = new WeakMap();
+
+    function setExpanded(panel, expanded) {
+      // Capture the visible height before cancelling an interrupted animation.
+      const startHeight = panel.getBoundingClientRect().height;
+      animations.get(panel)?.cancel();
+      panel.hidden = false;
+      panel.inert = !expanded;
+      panel.style.height = 'auto';
+      const endHeight = expanded ? panel.getBoundingClientRect().height : 0;
+
+      const finish = () => {
+        panel.hidden = !expanded;
+        panel.style.height = expanded ? 'auto' : '0px';
+        animations.delete(panel);
+      };
+
+      if (reducedMotion.matches || startHeight === endHeight) {
+        finish();
+        return;
+      }
+
+      panel.style.height = `${endHeight}px`;
+      const animation = panel.animate(
+        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
+        { duration: 300, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' }
+      );
+      animations.set(panel, animation);
+      animation.onfinish = finish;
+    }
+
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    faqTrigger.addEventListener('click', () => {
+      const expanded = faqTrigger.getAttribute('aria-expanded') !== 'true';
+      faqTrigger.setAttribute('aria-expanded', String(expanded));
+      setExpanded(faqContent, expanded);
+    });
+
+    document.getElementById('alert-dismiss').addEventListener('click', () => {
+      faqTrigger.focus({ preventScroll: true });
+      setExpanded(document.getElementById('promo-alert'), false);
+    });
+  </script>
+
