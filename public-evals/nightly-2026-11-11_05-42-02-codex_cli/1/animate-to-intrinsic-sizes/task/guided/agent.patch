+  <script>
+    const faqTrigger = document.querySelector('#faq-trigger');
+    const faqContent = document.querySelector('#faq-content');
+    const promoAlert = document.querySelector('#promo-alert');
+    const alertDismiss = document.querySelector('#alert-dismiss');
+    const revisions = new WeakMap();
+
+    function setExpanded(element, expanded) {
+      const revision = (revisions.get(element) || 0) + 1;
+      revisions.set(element, revision);
+
+      if (expanded && element.hidden) {
+        element.hidden = false;
+        // Commit the collapsed layout before starting the opening transition.
+        element.getBoundingClientRect();
+      }
+
+      element.inert = !expanded;
+      element.classList.toggle('is-collapsed', !expanded);
+
+      // No transitions are returned under reduced motion, so hiding is immediate.
+      const transitions = element.getAnimations();
+      Promise.allSettled(transitions.map(animation => animation.finished)).then(() => {
+        // An older collapse must not hide content reopened during its animation.
+        if (revisions.get(element) === revision && !expanded) {
+          element.hidden = true;
+        }
+      });
+    }
+
+    faqTrigger.addEventListener('click', () => {
+      const expanded = faqTrigger.getAttribute('aria-expanded') !== 'true';
+      faqTrigger.setAttribute('aria-expanded', String(expanded));
+      setExpanded(faqContent, expanded);
+    });
+
+    alertDismiss.addEventListener('click', () => {
+      if (promoAlert.contains(document.activeElement)) {
+        document.querySelector('nav a').focus({ preventScroll: true });
+      }
+      setExpanded(promoAlert, false);
+    });
+  </script>
