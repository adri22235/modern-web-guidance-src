+  <script>
+    (() => {
+      // Backend contract (same-origin JSON; session is an HttpOnly cookie):
+      // GET /api/auth/session -> { authenticated: boolean }
+      // POST /api/auth/passkey/options -> PublicKeyCredentialRequestOptions JSON
+      //   with base64url challenge/credential IDs and a fresh, session-bound challenge.
+      // POST /api/auth/passkey/verify -> { authenticated: true } after verifying
+      //   challenge, origin, RP ID, signature and user verification on the server.
+      // POST /api/auth/password { username, password } -> { authenticated: true }
+      // POST /api/auth/logout -> { authenticated: false }
+      // Mutating endpoints must validate Origin/CSRF and rate-limit attempts.
+      const form = document.getElementById('signin-form');
+      const username = document.getElementById('username');
+      const password = document.getElementById('password');
+      const status = document.getElementById('signin-status');
+      const passkeyButton = document.getElementById('passkey-submit');
+      const logout = document.getElementById('logout');
+      const continueLink = document.getElementById('signin-continue');
+      const signinLink = document.getElementById('signin-link');
+      const passkeysSupported = window.isSecureContext && !!window.PublicKeyCredential && !!navigator.credentials;
+      let authenticated = false;
+      let busy = false;
+      let pendingDestination = null;
+      let passkeyController = null;
+      let conditionalAvailable = false;
+
+      function message(text, error = false) {
+        status.textContent = text;
+        status.dataset.error = String(error);
+      }
+
+      function setBusy(value) {
+        busy = value;
+        form.setAttribute('aria-busy', String(value));
+        form.querySelectorAll('button').forEach(button => { button.disabled = value; });
+      }
+
+      async function request(path, body, signal) {
+        const response = await fetch('/api/auth/' + path, {
+          method: body === undefined ? 'GET' : 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { Accept: 'application/json', ...(body === undefined ? {} : { 'Content-Type': 'application/json' }) },
+          ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+          signal: signal || AbortSignal.timeout(10000)
+        });
+        if (!response.ok) {
+          if (response.status === 401 && path === 'password') throw new Error('Check your email and password and try again.');
+          throw new Error('Sign-in is unavailable right now. Please try again later.');
+        }
+        if (!(response.headers.get('content-type') || '').includes('application/json')) {
+          throw new Error('Sign-in is unavailable right now. Please try again later.');
+        }
+        return response.json();
+      }
+
+      function stopPasskeys() {
+        passkeyController?.abort();
+        passkeyController = null;
+      }
+
+      function updateSession(value) {
+        authenticated = value;
+        form.hidden = value;
+        signinLink.hidden = value;
+        logout.hidden = !value;
+        document.getElementById('signin-heading').textContent = value ? 'Good to see you again.' : 'Welcome back.';
+        continueLink.hidden = !value || !pendingDestination;
+        if (value) {
+          stopPasskeys();
+          password.value = '';
+          message('You’re signed in. Keep exploring, or pick up where you left off.');
+          if (pendingDestination) {
+            continueLink.href = pendingDestination.href;
+            continueLink.textContent = 'Continue to ' + pendingDestination.label;
+          }
+        }
+      }
+
+      document.querySelectorAll('[data-signin]').forEach(link => {
+        link.addEventListener('click', event => {
+          if (authenticated || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
+          event.preventDefault();
+          const labels = { rewards: 'rewards', account: 'your account', order: 'your order' };
+          pendingDestination = link === signinLink ? null : { href: link.getAttribute('href'), label: labels[link.dataset.signin] };
+          document.getElementById('signin-description').textContent = pendingDestination
+            ? 'Sign in here to continue to ' + pendingDestination.label + '. Your place on this page is saved.'
+            : 'Sign in here with a saved password or passkey, then keep exploring.';
+          username.focus({ preventScroll: true });
+          document.getElementById('signin').scrollIntoView({ block: 'center', behavior: 'auto' });
+        });
+      });
+
+      function decode(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')), char => char.charCodeAt(0));
+      }
+
+      function encode(buffer) {
+        return btoa(String.fromCharCode(...new Uint8Array(buffer))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      async function signInWithPasskey(conditional = false) {
+        if (!passkeysSupported || authenticated || busy) return;
+        stopPasskeys();
+        const controller = new AbortController();
+        passkeyController = controller;
+        if (!conditional) { setBusy(true); message('Choose your passkey in your browser to sign in.'); }
+        try {
+          const options = await request('passkey/options', {}, controller.signal);
+          options.challenge = decode(options.challenge);
+          if (conditional) options.allowCredentials = [];
+          else if (options.allowCredentials) {
+            options.allowCredentials = options.allowCredentials.map(item => ({ ...item, id: decode(item.id) }));
+          }
+          const credential = await navigator.credentials.get({
+            publicKey: options,
+            ...(conditional ? { mediation: 'conditional' } : {}),
+            signal: controller.signal
+          });
+          if (!credential || controller.signal.aborted) return;
+          setBusy(true);
+          const result = await request('passkey/verify', {
+            id: credential.id,
+            rawId: encode(credential.rawId),
+            type: credential.type,
+            response: {
+              authenticatorData: encode(credential.response.authenticatorData),
+              clientDataJSON: encode(credential.response.clientDataJSON),
+              signature: encode(credential.response.signature),
+              userHandle: credential.response.userHandle ? encode(credential.response.userHandle) : null
+            },
+            clientExtensionResults: credential.getClientExtensionResults()
+          }, controller.signal);
+          if (result.authenticated !== true) throw new Error('We couldn’t verify your passkey. Please try again.');
+          updateSession(true);
+        } catch (error) {
+          if (controller.signal.aborted) return;
+          if (!conditional) message(error.name === 'NotAllowedError'
+            ? 'No passkey selected. Try again or use your password.'
+            : 'We couldn’t sign you in with a passkey. Try again or use your password.', true);
+          else if (busy) message('We couldn’t verify your passkey. Try again or use your password.', true);
+        } finally {
+          if (passkeyController === controller) {
+            passkeyController = null;
+            setBusy(false);
+          }
+          if (authenticated) setBusy(false);
+        }
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (busy) return;
+        stopPasskeys();
+        setBusy(true);
+        message('Signing you in…');
+        try {
+          const result = await request('password', { username: username.value.trim(), password: password.value });
+          if (result.authenticated !== true) throw new Error('We couldn’t sign you in. Please try again.');
+          updateSession(true);
+        } catch (error) {
+          message(error instanceof TypeError ? 'Unable to connect. Please try again.' : error.message, true);
+        } finally {
+          setBusy(false);
+          if (!authenticated && conditionalAvailable) void signInWithPasskey(true);
+        }
+      });
+
+      passkeyButton.hidden = !passkeysSupported;
+      passkeyButton.addEventListener('click', () => void signInWithPasskey());
+      logout.addEventListener('click', async () => {
+        logout.disabled = true;
+        try {
+          const result = await request('logout', {});
+          if (result.authenticated !== false) throw new Error('Could not sign out. Please try again.');
+          pendingDestination = null;
+          updateSession(false);
+          message('You’re signed out. See you for your next cup.');
+          username.focus({ preventScroll: true });
+          if (conditionalAvailable) void signInWithPasskey(true);
+        } catch { message('Could not sign out. Please try again.', true); }
+        finally { logout.disabled = false; }
+      });
+
+      async function initialize() {
+        try {
+          const session = await request('session');
+          // Do not let a late session response interrupt an active sign-in.
+          if (!busy && session.authenticated === true) updateSession(true);
+        } catch { /* A static deployment may not have its auth service connected yet. */ }
+        if (passkeysSupported && PublicKeyCredential.isConditionalMediationAvailable) {
+          try { conditionalAvailable = await PublicKeyCredential.isConditionalMediationAvailable(); }
+          catch { conditionalAvailable = false; }
+        }
+        if (passkeysSupported) document.getElementById('passkey-help').textContent =
+          'Choose a saved password or passkey from your browser, or use the passkey button.';
+        if (conditionalAvailable) void signInWithPasskey(true);
+      }
+      window.addEventListener('pagehide', stopPasskeys);
+      window.addEventListener('pageshow', event => {
+        if (event.persisted && conditionalAvailable) void signInWithPasskey(true);
+      });
+      void initialize();
+    })();
+  </script>
