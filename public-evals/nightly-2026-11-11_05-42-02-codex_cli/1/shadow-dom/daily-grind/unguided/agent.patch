diff --git a/components/drink-card.js b/components/drink-card.js
new file mode 100644
index 0000000..65cb4a9
--- /dev/null
+++ b/components/drink-card.js
@@ -0,0 +1,86 @@
+// Content stays in the page; layout and presentation live in the shadow root.
+const drinkCardTemplate = document.createElement('template');
+drinkCardTemplate.innerHTML = `
+  <style>
+    :host {
+      all: initial;
+      display: block;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      font-size: 16px;
+      line-height: 1.6;
+      color: #3e2723;
+    }
+
+    *, ::slotted(*) {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    ::slotted(*) {
+      all: unset;
+      box-sizing: border-box;
+    }
+
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    h3 {
+      margin-bottom: 10px;
+      color: #4e342e;
+      font-size: 1.17em;
+    }
+
+    ::slotted([slot="badge"]) {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      color: #3e2723;
+      font-size: 0.75rem;
+      font-weight: bold;
+    }
+
+    ::slotted([slot="action"]) {
+      display: inline-block;
+      background: #4e342e;
+      color: white;
+      padding: 10px 20px;
+      border-radius: 5px;
+      margin-top: 15px;
+      text-decoration: none;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    ::slotted([slot="action"]:hover) {
+      background: #3e2723;
+    }
+
+    ::slotted([slot="action"]:focus-visible) {
+      outline: 2px solid #4e342e;
+      outline-offset: 3px;
+    }
+  </style>
+  <article>
+    <slot name="badge"></slot>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <slot name="action"></slot>
+  </article>
+`;
+
+customElements.define('drink-card', class extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' })
+      .append(drinkCardTemplate.content.cloneNode(true));
+  }
+});
