+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const drinks = document.getElementById('favorites-drinks');
+    const cards = Array.from(drinks.querySelectorAll('.card'));
+    const status = document.getElementById('favorites-status');
+    const filters = document.getElementById('favorites-filters');
+    const temperature = document.getElementById('favorites-temperature');
+    const detailsToggle = document.getElementById('favorites-details-toggle');
+    const filtersToggle = document.getElementById('favorites-filters-toggle');
+    const copyButton = document.getElementById('favorites-copy');
+    let lastMessage = '';
+    let feedbackTimer;
+
+    function announce(message) {
+      if (message === lastMessage) message += '\u00a0';
+      lastMessage = message;
+      status.textContent = message;
+    }
+
+    toolbar.querySelectorAll('[data-view]').forEach((button) => {
+      button.addEventListener('click', () => {
+        drinks.dataset.view = button.dataset.view;
+        toolbar.querySelectorAll('[data-view]').forEach((item) => {
+          item.setAttribute('aria-pressed', String(item === button));
+        });
+      });
+    });
+
+    detailsToggle.addEventListener('click', () => {
+      const show = detailsToggle.getAttribute('aria-pressed') !== 'true';
+      detailsToggle.setAttribute('aria-pressed', String(show));
+      drinks.dataset.details = String(show);
+    });
+
+    function applyFilters() {
+      const enabled = filtersToggle.getAttribute('aria-pressed') === 'true';
+      cards.forEach((card) => {
+        card.hidden = enabled && temperature.value !== 'all' && card.dataset.temperature !== temperature.value;
+      });
+      announce(`${cards.filter((card) => !card.hidden).length} featured drinks shown.`);
+    }
+
+    filtersToggle.addEventListener('click', () => {
+      const show = filtersToggle.getAttribute('aria-pressed') !== 'true';
+      filtersToggle.setAttribute('aria-pressed', String(show));
+      filtersToggle.setAttribute('aria-expanded', String(show));
+      filters.hidden = !show;
+      applyFilters();
+    });
+    temperature.addEventListener('change', applyFilters);
+
+    async function copyDrinks() {
+      clearTimeout(feedbackTimer);
+      const text = 'Seasonal Favorites\n\n' + cards.map((card) =>
+        `${card.querySelector('h3').textContent} — ${card.querySelector('p').textContent}`
+      ).join('\n');
+      try {
+        await navigator.clipboard.writeText(text);
+        announce('Featured drinks list copied.');
+      } catch {
+        announce('Could not copy the drinks list. Please try again.');
+      }
+      feedbackTimer = setTimeout(() => { status.textContent = ''; }, 5000);
+    }
+
+    if ('CommandEvent' in window) {
+      drinks.addEventListener('command', (event) => {
+        if (event.command === '--copy' && event.source === copyButton) copyDrinks();
+      });
+    } else {
+      copyButton.addEventListener('click', copyDrinks);
+    }
+
+    // Use native toolbar navigation where supported, with one tab stop elsewhere.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      const buttons = Array.from(toolbar.querySelectorAll('button'));
+      buttons.forEach((button, index) => { button.tabIndex = index === 0 ? 0 : -1; });
+      toolbar.addEventListener('focusin', (event) => {
+        if (buttons.includes(event.target)) {
+          buttons.forEach((button) => { button.tabIndex = button === event.target ? 0 : -1; });
+        }
+      });
+      toolbar.addEventListener('keydown', (event) => {
+        const index = buttons.indexOf(document.activeElement);
+        if (index === -1) return;
+        const rtl = getComputedStyle(toolbar).direction === 'rtl';
+        let next;
+        if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = buttons.length - 1;
+        else if (event.key === 'ArrowRight') next = index + (rtl ? -1 : 1);
+        else if (event.key === 'ArrowLeft') next = index + (rtl ? 1 : -1);
+        else return;
+        event.preventDefault();
+        buttons[(next + buttons.length) % buttons.length].focus();
+      });
+    }
+  </script>
