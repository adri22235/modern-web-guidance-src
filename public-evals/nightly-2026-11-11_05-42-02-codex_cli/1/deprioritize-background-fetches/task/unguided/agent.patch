diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,40 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Load data</title>
+    <style>
+      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #fafafa; }
+      button { padding: 12px 24px; border: 0; border-radius: 6px; background: #171717; color: white; font: 500 16px system-ui, sans-serif; cursor: pointer; }
+      button:focus-visible { outline: 3px solid #737373; outline-offset: 4px; }
+    </style>
+  </head>
+  <body>
+    <button type="button" aria-live="polite">Load data</button>
+    <script>
+      const button = document.querySelector('button');
+
+      button.addEventListener('click', () => {
+        const dataRequest = fetch('/api/data', { priority: 'high' });
+
+        fetch('/api/analytics', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ click: 1 }),
+          priority: 'low',
+          keepalive: true
+        }).catch(() => {});
+
+        button.textContent = 'Loading…';
+        dataRequest
+          .then(response => {
+            if (!response.ok) throw new Error('Data request failed');
+            return response.json();
+          })
+          .then(() => { button.textContent = 'Data loaded'; })
+          .catch(() => { button.textContent = 'Try again'; });
+      });
+    </script>
+  </body>
+</html>
