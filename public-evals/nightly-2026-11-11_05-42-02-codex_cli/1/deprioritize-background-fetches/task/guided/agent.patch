diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,52 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Load data</title>
+    <style>
+      body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: #fafafa; font-family: system-ui, sans-serif; }
+      button { padding: 12px 24px; border: 1px solid #222; border-radius: 6px; background: #222; color: #fff; font: inherit; cursor: pointer; }
+      button:disabled { opacity: 0.6; cursor: wait; }
+      button:focus-visible { outline: 3px solid #477cdb; outline-offset: 4px; }
+    </style>
+  </head>
+  <body>
+    <button type="button" id="load" aria-live="polite">Load data</button>
+    <script type="module">
+      const button = document.querySelector('#load');
+
+      button.addEventListener('click', () => {
+        button.disabled = true;
+        button.textContent = 'Loading…';
+
+        // Start both requests immediately; analytics never blocks the data.
+        fetch('/api/data', { priority: 'high' })
+          .then(response => {
+            if (!response.ok) throw new Error(`Data request failed: ${response.status}`);
+            return response.json();
+          })
+          .then(data => {
+            console.log('Data:', data);
+            button.textContent = 'Data loaded';
+          })
+          .catch(error => {
+            console.error(error);
+            button.textContent = 'Retry loading data';
+          })
+          .finally(() => { button.disabled = false; });
+
+        fetch('/api/analytics', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ click: 1 }),
+          priority: 'low'
+        })
+          .then(response => {
+            if (!response.ok) throw new Error(`Analytics request failed: ${response.status}`);
+          })
+          .catch(error => console.error(error));
+      });
+    </script>
+  </body>
+</html>
