+  <script>
+    const feature = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchors = CSS.supports('anchor-name: --rewards-link') &&
+      CSS.supports('top: anchor(bottom)') && CSS.supports('position-area: bottom');
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Keep the overlay tethered even in browsers without CSS anchors.
+    // A frame loop also follows layout shifts, font changes, and scrolling.
+    function trackFeature() {
+      if (!tourOpen) return;
+      const rect = feature.getBoundingClientRect();
+      const width = tourStep.offsetWidth;
+      const height = tourStep.offsetHeight;
+      const left = Math.max(12, Math.min(rect.left + (rect.width - width) / 2,
+        window.innerWidth - width - 12));
+      const below = rect.bottom + 12;
+      const top = below + height <= window.innerHeight - 12 ? below :
+        Math.max(12, rect.top - height - 12);
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${top}px`;
+      trackingFrame = requestAnimationFrame(trackFeature);
+    }
+
+    feature.addEventListener('click', (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+    feature.addEventListener('auxclick', (event) => {
+      if (tourOpen) event.preventDefault();
+    });
+
+    closeTour.addEventListener('click', () => {
+      tourOpen = false;
+      cancelAnimationFrame(trackingFrame);
+      if (hasPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      feature.focus({ preventScroll: true });
+    });
+
+    tourStep.hidden = false;
+    if (hasPopover) tourStep.showPopover();
+    if (!hasAnchors) trackFeature();
+    closeTour.focus({ preventScroll: true });
+  </script>
+
 </body>
 
