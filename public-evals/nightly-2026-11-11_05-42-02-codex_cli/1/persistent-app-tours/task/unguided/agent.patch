+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    let tourFrame;
+
+    // Follow the link even when scrolling, resizing, or layout changes move it.
+    function positionTour() {
+      const anchor = rewardsLink.getBoundingClientRect();
+      const center = anchor.left + anchor.width / 2;
+      const left = Math.max(16, Math.min(
+        center - tourStep.offsetWidth / 2,
+        document.documentElement.clientWidth - tourStep.offsetWidth - 16
+      ));
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${anchor.bottom + 16}px`;
+      tourStep.style.setProperty('--arrow-left', `${center - left}px`);
+      tourFrame = requestAnimationFrame(positionTour);
+    }
+
+    rewardsLink.addEventListener('click', (event) => {
+      if (!tourStep.hidden) event.preventDefault();
+    });
+
+    document.getElementById('close-tour').addEventListener('click', () => {
+      tourStep.hidden = true;
+      rewardsLink.setAttribute('aria-expanded', 'false');
+      cancelAnimationFrame(tourFrame);
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    positionTour();
+  </script>
 </body>
 
