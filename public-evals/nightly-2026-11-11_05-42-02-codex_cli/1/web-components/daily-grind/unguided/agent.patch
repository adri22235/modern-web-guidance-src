diff --git a/tests/components.test.mjs b/tests/components.test.mjs
new file mode 100644
index 0000000..a4cad55
--- /dev/null
+++ b/tests/components.test.mjs
@@ -0,0 +1,103 @@
+import { readFileSync } from 'node:fs';
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { Window } from 'happy-dom';
+
+const source = readFileSync(new URL('../components/daily-grind.js', import.meta.url), 'utf8');
+const homepage = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+
+function setup(t, markup) {
+  const window = new Window({ settings: {
+    disableCSSFileLoading: true,
+    disableJavaScriptFileLoading: true,
+    enableJavaScriptEvaluation: true,
+    // Only the checked-in component source is evaluated in this test environment.
+    suppressInsecureJavaScriptEnvironmentWarning: true,
+  } });
+  t.after(() => window.close());
+  window.eval(source);
+  window.document.body.innerHTML = markup;
+  return window;
+}
+
+test('homepage upgrades all components and retains all original destinations', t => {
+  const { document } = setup(t, homepage);
+  const components = document.querySelectorAll('site-navigation, coffee-hero, coffee-menu, coffee-card, site-footer');
+  assert.equal(components.length, 7);
+  for (const component of components) {
+    assert.ok(component.shadowRoot);
+    assert.ok(component.shadowRoot.querySelector('style'));
+  }
+  const destinations = Array.from(components).flatMap(component =>
+    Array.from(component.shadowRoot.querySelectorAll('a[href]'), link => link.getAttribute('href')));
+  for (const path of ['/menu', '/locations', '/rewards', '/account', '/logout', '/order-online',
+    '/menu/seasonal', '/menu/espresso', '/menu/cold-brew', '/about', '/careers', '/contact', '/privacy-policy']) {
+    assert.ok(destinations.includes(path), `${path} is preserved`);
+  }
+  assert.equal(document.querySelector('coffee-hero').shadowRoot.querySelectorAll('h1').length, 1);
+});
+
+test('cards update safely from attributes without destroying an open disclosure', t => {
+  const { document } = setup(t, '<coffee-card name="Latte" notes="Maple finish" href="/menu/seasonal"></coffee-card>');
+  const card = document.querySelector('coffee-card');
+  const root = card.shadowRoot;
+  root.querySelector('details').open = true;
+  card.setAttribute('name', '<b>New latte</b>');
+  assert.equal(root.querySelector('h3').textContent, '<b>New latte</b>');
+  assert.equal(root.querySelector('h3 b'), null);
+  assert.equal(root.querySelector('a').getAttribute('aria-label'), 'View details for <b>New latte</b>');
+  assert.equal(root.querySelector('details').open, true);
+  card.removeAttribute('notes');
+  assert.equal(root.querySelector('details').hidden, true);
+  assert.equal(root.querySelector('.badge').hidden, true);
+});
+
+test('filters toggle card visibility, pressed state, and live announcements', t => {
+  const { document } = setup(t, homepage);
+  const menu = document.querySelector('coffee-menu');
+  const cards = Array.from(menu.querySelectorAll('coffee-card'));
+  const filter = value => menu.shadowRoot.querySelector(`[data-filter="${value}"]`).click();
+  filter('cold');
+  assert.deepEqual(cards.map(card => card.hidden), [true, true, false]);
+  assert.equal(menu.shadowRoot.querySelector('[role="status"]').textContent, '1 cold drink shown.');
+  assert.equal(menu.shadowRoot.querySelectorAll('[aria-pressed="true"]').length, 1);
+  filter('warm');
+  assert.deepEqual(cards.map(card => card.hidden), [false, false, true]);
+  cards[2].setAttribute('category', 'warm');
+  assert.equal(cards[2].hidden, false);
+  filter('all');
+  assert.ok(cards.every(card => !card.hidden));
+  assert.equal(menu.shadowRoot.querySelector('[role="status"]').textContent, '3 drinks shown.');
+});
+
+test('navigation supports Escape and remains functional after reconnecting', t => {
+  const window = setup(t, '<site-navigation></site-navigation>');
+  const nav = window.document.querySelector('site-navigation');
+  const button = nav.shadowRoot.querySelector('button');
+  button.click();
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
+  nav.shadowRoot.querySelector('a').dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  assert.equal(nav.shadowRoot.activeElement, button);
+  nav.remove();
+  window.document.body.append(nav);
+  button.click();
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
+  assert.ok(nav.shadowRoot.querySelector('ul').classList.contains('open'));
+  nav.shadowRoot.querySelector('li a').click();
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+});
+
+test('menu keeps one handler after reconnecting and filters newly slotted cards', async t => {
+  const window = setup(t, '<coffee-menu><coffee-card category="warm"></coffee-card></coffee-menu>');
+  const menu = window.document.querySelector('coffee-menu');
+  menu.remove();
+  window.document.body.append(menu);
+  menu.shadowRoot.querySelector('[data-filter="cold"]').click();
+  const card = window.document.createElement('coffee-card');
+  card.setAttribute('category', 'warm');
+  menu.append(card);
+  await window.happyDOM.whenAsyncComplete();
+  assert.equal(card.hidden, true);
+  assert.equal(menu.shadowRoot.querySelector('[role="status"]').textContent, '0 cold drinks shown.');
+});
