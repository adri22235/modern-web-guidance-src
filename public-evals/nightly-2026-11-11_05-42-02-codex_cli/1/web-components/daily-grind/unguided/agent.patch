+const sharedStyles = `
+  :host { box-sizing: border-box; font-family: inherit; color: inherit; }
+  *, *::before, *::after { box-sizing: border-box; }
+  a { color: inherit; }
+  button, input { font: inherit; }
+  button, summary { cursor: pointer; }
+  a:focus-visible, button:focus-visible, summary:focus-visible {
+    outline: 3px solid var(--focus, #a65c24); outline-offset: 5px;
+  }
+  .button { display: inline-flex; align-items: center; justify-content: center;
+    gap: 18px; padding: 14px 23px; background: var(--primary, #3c4c35);
+    color: #fff; border: 1px solid transparent; text-decoration: none;
+    border-radius: 3px; font-size: .85rem; font-weight: 600; }
+  .button:hover { background: #283824; }
+  .eyebrow { font-size: .68rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
+  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; } }
+`;
+
+class SiteNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>${sharedStyles}
+        :host { display: block; background: var(--paper, #faf8f3); }
+        nav { max-width: 1240px; margin: auto; padding: 24px 40px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
+        .brand { text-decoration: none; display: flex; align-items: center; gap: 12px; }
+        .mark { border: 1px solid currentColor; border-radius: 50%; width: 40px; height: 40px; display: grid; place-items: center; font-size: 22px; }
+        .wordmark { font-size: .98rem; letter-spacing: .12em; font-weight: 800; }
+        small { display: block; font-size: .55rem; font-weight: 500; letter-spacing: .25em; margin-top: 4px; }
+        ul { display: flex; align-items: center; gap: 28px; list-style: none; padding: 0; margin: 0; }
+        li a { text-decoration: none; font-size: .78rem; }
+        li a:hover { text-decoration: underline; text-underline-offset: 5px; }
+        .logout { border: 1px solid #c8c7ba; border-radius: 3px; padding: 9px 15px; }
+        button { display: none; border: 1px solid #c8c7ba; border-radius: 3px; padding: 10px 14px; background: transparent; color: inherit; }
+        @media (max-width: 760px) {
+          nav { flex-wrap: wrap; padding: 20px 24px; gap: 18px; }
+          button { display: block; }
+          ul { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0; }
+          ul.open { display: flex; }
+          li a { display: block; padding: 13px 4px; }
+          .logout { margin-top: 8px; padding: 12px; }
+          .wordmark { font-size: .8rem; }
+        }
+      </style>
+      <nav aria-label="Main navigation">
+        <a href="/" class="brand" aria-label="The Daily Grind home">
+          <span class="mark" aria-hidden="true">☕</span>
+          <span class="wordmark">THE DAILY GRIND<small>COFFEE & COMMUNITY</small></span>
+        </a>
+        <button type="button" aria-expanded="false" aria-controls="navigation-links">Menu</button>
+        <ul id="navigation-links">
+          <li><a href="/menu">Menu</a></li><li><a href="/locations">Locations</a></li>
+          <li><a href="/rewards">Rewards</a></li><li><a href="/account">My Account</a></li>
+          <li><a href="/logout" class="logout">Logout <span aria-hidden="true">↗</span></a></li>
+        </ul>
+      </nav>`;
+  }
+  connectedCallback() {
+    this.controller?.abort();
+    this.controller = new AbortController();
+    const button = this.shadowRoot.querySelector('button');
+    const links = this.shadowRoot.querySelector('ul');
+    const close = () => {
+      button.setAttribute('aria-expanded', 'false');
+      links.classList.remove('open');
+    };
+    button.addEventListener('click', () => {
+      const open = button.getAttribute('aria-expanded') !== 'true';
+      button.setAttribute('aria-expanded', String(open));
+      links.classList.toggle('open', open);
+    }, { signal: this.controller.signal });
+    this.shadowRoot.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
+        close();
+        button.focus();
+      }
+    }, { signal: this.controller.signal });
+    links.addEventListener('click', (event) => {
+      if (event.target.closest('a')) close();
+    }, { signal: this.controller.signal });
+  }
+  disconnectedCallback() { this.controller.abort(); }
+}
+
+class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>${sharedStyles}
+        :host { display: block; }
+        header { min-height: 550px; display: grid; align-items: center; position: relative; isolation: isolate; background: #29251d; color: #fff; overflow: hidden; }
+        header::before { content: ''; position: absolute; inset: 0; z-index: -1;
+          background: linear-gradient(90deg, rgba(19,24,18,.85), rgba(19,24,18,.4) 55%, rgba(19,24,18,.12)),
+          url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1920&q=85') center 55% / cover; }
+        .content { width: 100%; max-width: 1240px; margin: auto; padding: 74px 40px; }
+        .eyebrow { color: #e2d9bb; margin: 0 0 24px; }
+        h1 { font-family: Georgia, 'Times New Roman', serif; font-weight: 400; font-size: clamp(3rem, 6vw, 5.3rem); line-height: 1.06; letter-spacing: -.035em; margin: 0; max-width: 660px; }
+        .description { max-width: 370px; color: #e4e2da; line-height: 1.8; font-size: .94rem; margin: 23px 0 28px; }
+        .button { background: #f1e8d5; color: #293526; }
+        .button:hover { background: #fff6e4; }
+        .footnote { display: block; font-size: .65rem; letter-spacing: .04em; color: #e4e2da; margin-top: 24px; }
+        @media (max-width: 600px) { header { min-height: 490px; } .content { padding: 60px 24px; } }
+      </style>
+      <header>
+        <div class="content">
+          <p class="eyebrow"><slot name="eyebrow">A little ritual. A better day.</slot></p>
+          <h1><slot name="heading">Wake Up<br>Your Senses</slot></h1>
+          <p class="description"><slot>Ethically sourced, locally roasted, delivered to your cup.</slot></p>
+          <a class="button" href="/order-online">Order Now <span aria-hidden="true">↗</span></a>
+          <span class="footnote">GOOD COFFEE. GOOD PEOPLE. EVERY DAY.</span>
+        </div>
+      </header>`;
+  }
+}
+
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'image', 'image-alt', 'href', 'badge', 'notes', 'category'];
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>${sharedStyles}
+        :host { display: block; height: 100%; }
+        :host([hidden]) { display: none !important; }
+        article { height: 100%; display: flex; flex-direction: column; background: #fffefa; border: 1px solid #e4e1d7; border-radius: 5px; overflow: hidden; }
+        .photo { position: relative; aspect-ratio: 1.48; background: #dfd7ca; overflow: hidden; }
+        img { width: 100%; height: 100%; object-fit: cover; display: block; }
+        .badge { position: absolute; top: 16px; left: 16px; background: #faf8ef; color: #3b4a32; padding: 6px 10px; border-radius: 2px; font-size: .57rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
+        .body { padding: 25px 25px 22px; display: flex; flex-direction: column; flex: 1; }
+        h3 { font-family: Georgia, 'Times New Roman', serif; font-size: 1.55rem; line-height: 1.2; font-weight: 400; margin: 0 0 12px; }
+        .description { margin: 0 0 18px; font-size: .82rem; line-height: 1.8; color: #6d7066; }
+        details { margin-top: auto; border-top: 1px solid #e6e4dc; padding-top: 14px; font-size: .75rem; color: #59634f; }
+        summary { padding: 4px 0; }
+        .notes { line-height: 1.7; margin: 10px 0; }
+        a { display: flex; align-items: center; justify-content: space-between; font-size: .77rem; font-weight: 600; text-decoration: none; padding: 18px 0 0; }
+        a:hover { text-decoration: underline; text-underline-offset: 4px; }
+      </style>
+      <article aria-labelledby="coffee-name">
+        <div class="photo"><img loading="lazy" width="600" height="405"><span class="badge"></span></div>
+        <div class="body"><h3 id="coffee-name"></h3><p class="description"></p>
+          <details><summary>Tasting notes</summary><p class="notes"></p></details>
+          <a>View Details <span aria-hidden="true">↗</span></a>
+        </div>
+      </article>`;
+  }
+  connectedCallback() { this.update(); }
+  attributeChangedCallback() { this.update(); }
+  update() {
+    const root = this.shadowRoot;
+    const name = this.getAttribute('name') || 'Coffee';
+    root.querySelector('h3').textContent = name;
+    root.querySelector('.description').textContent = this.getAttribute('description') || '';
+    const image = root.querySelector('img');
+    const source = this.getAttribute('image');
+    if (source) image.setAttribute('src', source);
+    else image.removeAttribute('src');
+    image.alt = this.getAttribute('image-alt') || '';
+    const badge = root.querySelector('.badge');
+    badge.textContent = this.getAttribute('badge') || '';
+    badge.hidden = !badge.textContent;
+    root.querySelector('.notes').textContent = this.getAttribute('notes') || '';
+    root.querySelector('details').hidden = !this.getAttribute('notes');
+    const link = root.querySelector('a');
+    link.href = this.getAttribute('href') || '/menu';
+    link.setAttribute('aria-label', `View details for ${name}`);
+    this.dispatchEvent(new CustomEvent('coffee-card-change', { bubbles: true }));
+  }
+}
+
+class CoffeeMenu extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>${sharedStyles}
+        :host { display: block; }
+        section { max-width: 1240px; margin: auto; padding: 70px 40px 76px; }
+        .eyebrow { color: #7d775f; margin: 0 0 12px; }
+        .heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
+        h2 { font: 400 clamp(2rem, 4vw, 2.7rem)/1.2 Georgia, 'Times New Roman', serif; letter-spacing: -.03em; margin: 0; }
+        .intro { color: #727568; font-size: .84rem; line-height: 1.7; margin: 14px 0 0; }
+        .filters { display: flex; gap: 4px; background: #eeeee5; padding: 4px; border-radius: 4px; flex-shrink: 0; }
+        button { min-height: 40px; padding: 8px 17px; border: 0; border-radius: 3px; color: #626958; background: transparent; font-size: .75rem; }
+        button[aria-pressed="true"] { background: #fffefa; color: #2d3f29; box-shadow: 0 1px 4px #28382414; font-weight: 600; }
+        button:hover { color: #253b21; }
+        .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 32px; }
+        ::slotted(coffee-card[hidden]) { display: none !important; }
+        .status { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+        .all-menu { margin-top: 30px; text-align: center; }
+        .all-menu a { font-size: .76rem; text-underline-offset: 6px; text-decoration-color: #a7ad9e; }
+        @media (max-width: 850px) { .grid { gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); } .heading { align-items: start; flex-direction: column; } }
+        @media (max-width: 560px) { section { padding: 48px 24px; } .grid { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
+      </style>
+      <section aria-labelledby="menu-heading">
+        <p class="eyebrow">Your next favorite is here</p>
+        <div class="heading"><div><h2 id="menu-heading">Seasonal Favorites</h2>
+          <p class="intro">Familiar comforts. A fresh twist. Crafted with a little extra care.</p></div>
+          <div class="filters" role="group" aria-label="Filter drinks by temperature">
+            <button type="button" data-filter="all" aria-pressed="true">All drinks</button>
+            <button type="button" data-filter="warm" aria-pressed="false">Warm</button>
+            <button type="button" data-filter="cold" aria-pressed="false">Cold</button>
+          </div>
+        </div>
+        <div class="grid"><slot></slot></div>
+        <p class="status" role="status" aria-live="polite" aria-atomic="true"></p>
+        <div class="all-menu"><a href="/menu">Explore the full menu <span aria-hidden="true">↗</span></a></div>
+      </section>`;
+    this.filter = 'all';
+  }
+  connectedCallback() {
+    this.controller?.abort();
+    this.controller = new AbortController();
+    this.shadowRoot.querySelector('.filters').addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-filter]');
+      if (!button) return;
+      this.filter = button.dataset.filter;
+      this.applyFilter(true);
+    }, { signal: this.controller.signal });
+    this.shadowRoot.querySelector('slot').addEventListener('slotchange', () => this.applyFilter(), { signal: this.controller.signal });
+    this.addEventListener('coffee-card-change', () => this.applyFilter(), { signal: this.controller.signal });
+    this.applyFilter();
+  }
+  applyFilter(announce = false) {
+    const cards = this.shadowRoot.querySelector('slot').assignedElements().filter(element => element.localName === 'coffee-card');
+    for (const card of cards) card.hidden = this.filter !== 'all' && card.getAttribute('category') !== this.filter;
+    for (const button of this.shadowRoot.querySelectorAll('[data-filter]')) {
+      button.setAttribute('aria-pressed', String(button.dataset.filter === this.filter));
+    }
+    if (announce || this.shadowRoot.querySelector('.status').textContent) {
+      const count = cards.filter(card => !card.hidden).length;
+      this.shadowRoot.querySelector('.status').textContent = `${count} ${this.filter === 'all' ? '' : this.filter + ' '}drink${count === 1 ? '' : 's'} shown.`;
+    }
+  }
+  disconnectedCallback() { this.controller.abort(); }
+}
+
+class SiteFooter extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>${sharedStyles}
+        :host { display: block; background: #eaece2; border-top: 1px solid #dfe2d6; }
+        footer { max-width: 1240px; margin: auto; padding: 35px 40px; }
+        .row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
+        .brand { font: 400 1.25rem Georgia, 'Times New Roman', serif; margin: 0; }
+        .tagline { font-size: .72rem; color: #6e7665; margin: 7px 0 0; }
+        ul { display: flex; flex-wrap: wrap; gap: 24px; padding: 0; margin: 0; list-style: none; }
+        a { text-decoration: none; font-size: .73rem; }
+        a:hover { text-decoration: underline; text-underline-offset: 5px; }
+        .copyright { font-size: .65rem; color: #707766; border-top: 1px solid #d4d9cb; padding-top: 24px; margin: 28px 0 0; }
+        @media (max-width: 650px) { footer { padding: 30px 24px; } .row { flex-direction: column; align-items: start; } ul { gap: 18px; } }
+      </style>
+      <footer><div class="row"><div><p class="brand">The Daily Grind.</p><p class="tagline">Rooted in coffee. Made for community.</p></div>
+        <nav aria-label="Footer"><ul><li><a href="/about">Our Story</a></li><li><a href="/careers">Join the Team</a></li>
+          <li><a href="/contact">Contact Us</a></li><li><a href="/privacy-policy">Privacy</a></li></ul></nav>
+      </div><p class="copyright">© 2026 The Daily Grind Coffee Co. All rights reserved.</p></footer>`;
+  }
+}
+
+for (const [name, component] of [
+  ['site-navigation', SiteNavigation], ['coffee-hero', CoffeeHero],
+  ['coffee-card', CoffeeCard], ['coffee-menu', CoffeeMenu], ['site-footer', SiteFooter],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
