diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..f35d18f
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,43 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background: var(--light);
+}
+
+.container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }
+h2 { margin: 0; text-align: center; }
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+/* Useful document flow before upgrade, and when JavaScript is unavailable. */
+grind-navigation, grind-hero, coffee-card, grind-footer { display: block; }
+
+.skip-link {
+  position: fixed;
+  top: 8px;
+  left: 8px;
+  z-index: 1001;
+  padding: 10px 20px;
+  color: white;
+  background: var(--primary);
+  transform: translateY(-160%);
+}
+.skip-link:focus { transform: translateY(0); }
+.skip-link:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
+#main { scroll-margin-top: 6rem; }
