@@ -0,0 +1,34 @@
+import { createTemplate, attachTemplate, actionStyles } from './shared.js';
+
+const template = createTemplate(`
+  <article part="card">
+    <slot name="heading"></slot>
+    <div class="description"><slot></slot></div>
+    <div class="action"><slot name="action"></slot></div>
+  </article>
+`, `
+  :host { min-width: 0; }
+  article {
+    height: 100%;
+    display: flex;
+    flex-direction: column;
+    background: white;
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+    text-align: center;
+    overflow-wrap: anywhere;
+  }
+  ::slotted([slot="heading"]) { margin-bottom: 10px; color: var(--primary, #4e342e); }
+  .description { flex: 1; }
+  ${actionStyles}
+`);
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    attachTemplate(this, template);
+  }
+}
+
+if (!customElements.get('coffee-card')) customElements.define('coffee-card', CoffeeCard);
