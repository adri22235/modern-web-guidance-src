diff --git a/components/grind-navigation.js b/components/grind-navigation.js
new file mode 100644
index 0000000..afaf8b4
--- /dev/null
+++ b/components/grind-navigation.js
@@ -0,0 +1,108 @@
+import { createTemplate, attachTemplate } from './shared.js';
+
+const template = createTemplate(`
+  <nav aria-label="Main" part="navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="links" hidden>Menu</button>
+    <div id="links"><slot></slot></div>
+  </nav>
+`, `
+  :host {
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    --component-focus-color: var(--accent, #ffab40);
+  }
+  nav {
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 1rem 5%;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 20px;
+  }
+  #links { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 20px; }
+  ::slotted(a) { color: white; text-decoration: none; font-size: 0.9rem; }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted([slot="brand"]) { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+  ::slotted(.logout-link) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+  button {
+    font: inherit;
+    color: white;
+    background: transparent;
+    border: 1px solid var(--accent, #ffab40);
+    border-radius: 4px;
+    min-height: 44px;
+    padding: 8px 14px;
+    cursor: pointer;
+  }
+  @media (max-width: 48rem) {
+    nav { flex-wrap: wrap; gap: 12px; }
+    ::slotted([slot="brand"]) { font-size: clamp(1rem, 4vw, 1.5rem); }
+    #links { flex-basis: 100%; flex-direction: column; align-items: stretch; }
+    ::slotted(a:not([slot="brand"])) { padding: 10px 12px; }
+  }
+`);
+
+export class GrindNavigation extends HTMLElement {
+  #controller;
+  #media;
+  #button;
+  #links;
+
+  constructor() {
+    super();
+    attachTemplate(this, template);
+    this.#button = this.shadowRoot.querySelector('button');
+    this.#links = this.shadowRoot.querySelector('#links');
+  }
+
+  connectedCallback() {
+    // Reconnecting an instance must not accumulate event listeners.
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const { signal } = this.#controller;
+    this.#media = window.matchMedia('(max-width: 48rem)');
+    this.#syncLayout();
+    this.#media.addEventListener('change', () => this.#syncLayout(), { signal });
+    this.#button.addEventListener('click', () => {
+      this.#setOpen(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && this.#media.matches && !this.#links.hidden) {
+        event.preventDefault();
+        this.#setOpen(false);
+        this.#button.focus();
+      }
+    }, { signal });
+    this.addEventListener('click', (event) => {
+      if (this.#media.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.#button.focus();
+        this.#setOpen(false);
+      }
+    }, { signal });
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+  }
+
+  #syncLayout() {
+    const focused = this.shadowRoot.activeElement || document.activeElement;
+    const focusInLinks = focused instanceof Element && this.contains(focused) && focused.slot !== 'brand';
+    this.#button.hidden = !this.#media.matches;
+    this.#setOpen(false);
+    if (this.#media.matches && focusInLinks) this.#button.focus();
+    if (!this.#media.matches && focused === this.#button) {
+      this.querySelector('a:not([slot="brand"])')?.focus();
+    }
+  }
+
+  #setOpen(open) {
+    this.#button.setAttribute('aria-expanded', String(open));
+    this.#links.hidden = this.#media.matches && !open;
+  }
+}
+
+if (!customElements.get('grind-navigation')) customElements.define('grind-navigation', GrindNavigation);
diff --git a/components/shared.js b/components/shared.js
new file mode 100644
index 0000000..7ceb778
--- /dev/null
+++ b/components/shared.js
@@ -0,0 +1,39 @@
+// Each component clones a module-scoped template; content remains consumer-owned.
+export function createTemplate(markup, styles) {
+  const template = document.createElement('template');
+  template.innerHTML = `<style>${baseStyles}\n${styles}</style>${markup}`;
+  return template;
+}
+
+export function attachTemplate(element, template) {
+  element.attachShadow({ mode: 'open', delegatesFocus: true });
+  element.shadowRoot.append(template.content.cloneNode(true));
+}
+
+const baseStyles = `
+  :host { display: block; color: var(--text, #3e2723); }
+  *, *::before, *::after { box-sizing: border-box; }
+  [hidden] { display: none !important; }
+  ::slotted(*) { box-sizing: border-box; margin: 0; }
+  button:focus-visible, ::slotted(a:focus-visible) {
+    outline: 3px solid var(--component-focus-color, var(--primary, #4e342e));
+    outline-offset: 4px;
+  }
+`;
+
+export const actionStyles = `
+  ::slotted(a[slot="action"]) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+  ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+  @media (prefers-reduced-motion: reduce) {
+    ::slotted(a[slot="action"]) { transition: none; }
+  }
+`;
