+  <!-- The server can flush the page above before these cards are ready, then
+       send this template later in the SAME HTML response. Keep it under body
+       so its patch can reach the markers inside the seasonal section. -->
+  <template id="initial-seasonal-cards" for="seasonal-cards">
+    <div class="card" data-seasonal-card>
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card" data-seasonal-card>
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card" data-seasonal-card>
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script type="module">
+    const cards = document.querySelector('#seasonal-cards');
+    const menuStatus = document.querySelector('#menu-status');
+    const refreshButton = document.querySelector('#refresh-menu');
+
+    // Older parsers leave the template inert. Clone only this app-authored
+    // initial markup; never use this fallback for server or customer HTML.
+    const initialCards = document.querySelector('#initial-seasonal-cards');
+    if (initialCards && !cards.querySelector('[data-seasonal-card]')) {
+      cards.replaceChildren(initialCards.content.cloneNode(true));
+      initialCards.remove();
+    }
+
+    // Server integration contract (all responses are same-origin):
+    // GET /api/menu/seasonal: text/html containing card children, not a page
+    // or template patches. A refresh replaces only #seasonal-cards.
+    // GET /api/reviews: text/html containing customer-submitted reviews.
+    // GET /api/cms/promo: text/html from our trusted CMS ONLY, including its
+    // widget script. Never mix customer HTML into this response.
+    // GET /api/menu/events: text/event-stream; emit "event: menu-changed"
+    // followed by a data line and a blank line after each menu publication.
+    async function fetchHTML(path, signal) {
+      const response = await fetch(path, {
+        signal,
+        cache: 'no-store',
+        credentials: 'same-origin',
+        redirect: 'error',
+        headers: { Accept: 'text/html' }
+      });
+      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error(`Expected an HTML fragment from ${path}`);
+      }
+      return response.text();
+    }
+
+    let menuRequest;
+    async function refreshSeasonalFavorites() {
+      // A newer publication supersedes an older request, even if responses
+      // arrive out of order. Preserve the visible menu on network failures.
+      menuRequest?.abort();
+      const request = new AbortController();
+      menuRequest = request;
+      cards.setAttribute('aria-busy', 'true');
+      menuStatus.textContent = 'Refreshing seasonal favorites…';
+      try {
+        const html = await fetchHTML('/api/menu/seasonal', request.signal);
+        if (request.signal.aborted) return;
+        cards.setHTML(html);
+        menuStatus.textContent = 'Seasonal favorites are up to date.';
+      } catch (error) {
+        if (!request.signal.aborted) {
+          menuStatus.textContent = 'Could not refresh the menu. Please try again.';
+        }
+      } finally {
+        if (menuRequest === request) cards.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    // setHTML uses the browser sanitizer: scripts, event handlers, and other
+    // executable customer content must never reach a script-enabled sink.
+    if (typeof cards.setHTML === 'function') {
+      refreshButton.hidden = false;
+      refreshButton.addEventListener('click', refreshSeasonalFavorites);
+      document.addEventListener('menu-changed', refreshSeasonalFavorites);
+      if ('EventSource' in window) {
+        const menuEvents = new EventSource('/api/menu/events');
+        menuEvents.addEventListener('menu-changed', refreshSeasonalFavorites);
+        // Also refresh after a connection/reconnection to catch missed events.
+        menuEvents.addEventListener('open', refreshSeasonalFavorites);
+        menuEvents.addEventListener('error', () => {
+          menuStatus.textContent = 'Live updates are reconnecting. You can still refresh the menu.';
+        });
+      }
+    } else {
+      menuStatus.textContent = 'For live menu updates, use a browser with native HTML sanitization.';
+    }
+
+    async function loadReviews() {
+      const reviews = document.querySelector('#customer-reviews');
+      try {
+        if (typeof reviews.setHTML !== 'function') {
+          reviews.textContent = 'Customer reviews are unavailable in this browser.';
+          return;
+        }
+        const html = await fetchHTML('/api/reviews');
+        reviews.setHTML(html);
+      } catch (error) {
+        reviews.textContent = 'Customer reviews are temporarily unavailable.';
+      } finally {
+        reviews.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    async function loadPromo() {
+      const promo = document.querySelector('#cms-promo');
+      try {
+        if (typeof promo.setHTMLUnsafe !== 'function') return;
+        const html = await fetchHTML('/api/cms/promo');
+        // This is the only script-enabled insertion point. The CMS endpoint
+        // must contain exclusively trusted, first-party editorial HTML/scripts.
+        // runScripts requires the renewed HTML insertion API; older versions
+        // may display the promo without executing its embedded widget.
+        promo.setHTMLUnsafe(html, { runScripts: true });
+      } catch (error) {
+        document.querySelector('#promo-status').textContent =
+          'Our latest promotion is temporarily unavailable. Explore rewards above.';
+      } finally {
+        promo.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    void loadReviews();
+    void loadPromo();
+  </script>
+
 </body>
 
