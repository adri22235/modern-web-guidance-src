+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </article>
+  </template>
+
+  <script type="module">
+    /* Server contract (this static app does not implement these routes):
+       GET /api/menu/seasonal -> text/html, card fragments only, no page shell.
+       GET /api/reviews/seasonal -> text/html, customer review fragments.
+       GET /api/cms/seasonal-promo -> text/html, trusted first-party CMS markup
+         with its embedded widget script. Never include user-authored HTML here.
+       GET /api/menu/events -> text/event-stream; emit event: menu-changed
+         whenever the menu is published. EventSource reconnects automatically.
+       Other app code can also dispatch a menu-changed event on document.
+       Sanitize reviews server-side too when displaying them in other clients. */
+    const cards = document.getElementById('seasonal-cards');
+    const menuStatus = document.getElementById('menu-status');
+    const refreshButton = document.getElementById('refresh-menu');
+    const reviews = document.getElementById('customer-reviews');
+    const reviewsStatus = document.getElementById('reviews-status');
+    const promo = document.getElementById('seasonal-promo');
+    const promoStatus = document.getElementById('promo-status');
+
+    // Graceful fallback: older parsers leave both the markers and template inert.
+    // Only clone this known, server-authored initial template, never fetched HTML.
+    if (!('htmlFor' in HTMLTemplateElement.prototype)) {
+      const initial = document.getElementById('initial-seasonal-cards');
+      cards.replaceChildren(initial.content.cloneNode(true));
+      initial.remove();
+    }
+    cards.setAttribute('aria-busy', 'false');
+    menuStatus.textContent = 'Seasonal favorites are ready.';
+    refreshButton.hidden = false;
+
+    const cardRules = {
+      elements: ['article', 'div', 'h3', 'p', 'a', 'strong', 'em'],
+      attributes: ['class', 'href']
+    };
+    const reviewRules = {
+      elements: ['figure', 'blockquote', 'figcaption', 'p', 'strong', 'em', 'b', 'i'],
+      attributes: []
+    };
+    let purifierPromise;
+
+    async function safeSetHTML(target, html, rules) {
+      if ('setHTML' in Element.prototype) {
+        target.setHTML(html, { sanitizer: rules });
+      } else {
+        // Load the sanitizer only in browsers without native safe insertion.
+        purifierPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.4.17/dist/purify.es.mjs')
+          .then(module => module.default);
+        const purifier = await purifierPromise;
+        target.replaceChildren(purifier.sanitize(html, {
+          ALLOWED_TAGS: [...rules.elements, '#text'],
+          ALLOWED_ATTR: rules.attributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false,
+          RETURN_DOM_FRAGMENT: true
+        }));
+      }
+    }
+
+    async function fetchHTML(path) {
+      const response = await fetch(path, {
+        headers: { Accept: 'text/html' },
+        cache: 'no-store',
+        credentials: 'same-origin',
+        redirect: 'error',
+        signal: AbortSignal.timeout(15000)
+      });
+      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error('HTML fragment unavailable');
+      }
+      return response;
+    }
+
+    // Coalesce bursts without losing a change that arrives during a request.
+    let refreshing = false;
+    let refreshAgain = false;
+    async function refreshMenu() {
+      refreshAgain = true;
+      if (refreshing) return;
+      refreshing = true;
+      refreshButton.disabled = true;
+      cards.setAttribute('aria-busy', 'true');
+      menuStatus.textContent = 'Refreshing seasonal favorites…';
+      try {
+        do {
+          refreshAgain = false;
+          const response = await fetchHTML('/api/menu/seasonal');
+          const next = document.createElement('div');
+          await safeSetHTML(next, await response.text(), cardRules);
+          if (!next.querySelector('.card')) throw new Error('No menu cards');
+          // Commit only a complete, sanitized response, retaining cards on failure.
+          // Wait for keyboard users to leave the cards before replacing links.
+          if (cards.contains(document.activeElement)) {
+            await new Promise(resolve => {
+              const onFocusOut = () => queueMicrotask(() => {
+                if (!cards.contains(document.activeElement)) {
+                  cards.removeEventListener('focusout', onFocusOut);
+                  resolve();
+                }
+              });
+              cards.addEventListener('focusout', onFocusOut);
+            });
+          }
+          // Discard stale results when a newer publication is already pending.
+          if (refreshAgain) continue;
+          cards.replaceChildren(...next.childNodes);
+          menuStatus.textContent = 'Seasonal favorites updated.';
+        } while (refreshAgain);
+      } catch {
+        menuStatus.textContent = 'Could not refresh favorites. Please try again.';
+      } finally {
+        refreshing = false;
+        refreshButton.disabled = false;
+        cards.setAttribute('aria-busy', 'false');
+        if (refreshAgain) void refreshMenu();
+      }
+    }
+
+    async function loadReviews() {
+      try {
+        const response = await fetchHTML('/api/reviews/seasonal');
+        await safeSetHTML(reviews, await response.text(), reviewRules);
+        reviewsStatus.textContent = reviews.textContent.trim()
+          ? 'Customer reviews loaded.' : 'No customer reviews yet.';
+      } catch {
+        reviewsStatus.textContent = 'Customer reviews are currently unavailable.';
+      } finally {
+        reviews.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    async function loadPromo() {
+      try {
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        // This is the ONLY script-capable insertion path. The endpoint must be
+        // controlled by our CMS, with no customer input or arbitrary URL option.
+        if ('streamHTMLUnsafe' in Element.prototype && response.body) {
+          await response.body.pipeThrough(new TextDecoderStream())
+            .pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+        } else {
+          // Buffered fallback with equivalent script execution for trusted CMS.
+          const html = await response.text();
+          const range = document.createRange();
+          range.selectNodeContents(promo);
+          promo.replaceChildren(range.createContextualFragment(html));
+        }
+      } catch {
+        promoStatus.textContent = 'The latest promotion is currently unavailable.';
+      }
+    }
+
+    refreshButton.addEventListener('click', refreshMenu);
+    document.addEventListener('menu-changed', refreshMenu);
+    if ('EventSource' in window) {
+      const changes = new EventSource('/api/menu/events');
+      changes.addEventListener('menu-changed', refreshMenu);
+      // Refetch on every connection, including reconnection, to recover missed events.
+      changes.addEventListener('open', refreshMenu);
+      changes.addEventListener('error', () => {
+        if (!refreshing) menuStatus.textContent = 'Live updates unavailable. Use Refresh favorites to try again.';
+      });
+    }
+    void loadReviews();
+    void loadPromo();
+  </script>
+
 </body>
 
