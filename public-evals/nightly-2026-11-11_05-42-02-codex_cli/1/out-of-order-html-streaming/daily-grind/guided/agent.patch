+  <!-- The server can flush the shell above, then emit this template as soon as
+       the menu is ready, before closing the SAME HTML response. The body-level
+       template can reach the named range inside main. Do not put raw reviews
+       or CMS scripts in this template: those have separate trust boundaries. -->
+  <template for="seasonal-cards" id="initial-seasonal-cards">
+        <article class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </article>
+        <article class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </article>
+        <article class="card">
+          <h3>Cold Brew</h3>
