diff --git a/src/scripts/page-transitions.ts b/src/scripts/page-transitions.ts
new file mode 100644
index 0000000..dc5c924
--- /dev/null
+++ b/src/scripts/page-transitions.ts
@@ -0,0 +1,71 @@
+// Astro's loader already waits for destination stylesheets. Extend preparation
+// rather than starting an animation in page-load, after the new page is visible.
+const unreadyDocuments = new WeakSet<Document>();
+const assetTimeout = 3000;
+
+async function prepareImages(page: Document, url: URL): Promise<void> {
+  await Promise.all(Array.from(page.images, async (image) => {
+    const source = image.getAttribute("src");
+    if (!source) return;
+
+    // Detached, eager images also cover lazy images at restored history scroll
+    // positions. Match request attributes so the destination reuses the cache.
+    const preload = new Image();
+    preload.decoding = "async";
+    if (image.hasAttribute("crossorigin")) preload.crossOrigin = image.crossOrigin;
+    preload.referrerPolicy = image.referrerPolicy;
+    if (image.sizes) preload.sizes = image.sizes;
+    if (image.srcset) preload.srcset = image.srcset;
+    preload.src = new URL(source, url).href;
+    // An image error is a settled state too (some demo articles intentionally
+    // use inaccessible images). Wait for the remaining images in either case.
+    await preload.decode().catch(() => undefined);
+  }));
+}
+
+async function prepareAssets(page: Document, url: URL, signal: AbortSignal): Promise<boolean> {
+  if (signal.aborted) return false;
+
+  let timeout: ReturnType<typeof setTimeout>;
+  let onAbort: () => void;
+  const interrupted = new Promise<boolean>((resolve) => {
+    timeout = setTimeout(() => resolve(false), assetTimeout);
+    onAbort = () => resolve(false);
+    signal.addEventListener("abort", onAbort, { once: true });
+  });
+
+  try {
+    return await Promise.race([
+      Promise.all([
+        prepareImages(page, url),
+        // The shared headline font must have its final metrics before capture.
+        document.fonts.load('500 32px "Grenze"'),
+        document.fonts.ready,
+      ]).then(() => true, () => false),
+      interrupted,
+    ]);
+  } finally {
+    clearTimeout(timeout!);
+    signal.removeEventListener("abort", onAbort!);
+  }
+}
+
+document.addEventListener("astro:before-preparation", (event) => {
+  const load = event.loader;
+  event.loader = async () => {
+    await load();
+    if (event.defaultPrevented || event.signal.aborted) return;
+
+    const ready = await prepareAssets(event.newDocument, event.to, event.signal);
+    if (!ready) unreadyDocuments.add(event.newDocument);
+  };
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  // A slow asset must never trap navigation or animate partial content.
+  // Keep readiness local to each document so rapid navigations cannot race.
+  if (unreadyDocuments.has(event.newDocument) ||
+      window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+    event.viewTransition.skipTransition();
+  }
+});
