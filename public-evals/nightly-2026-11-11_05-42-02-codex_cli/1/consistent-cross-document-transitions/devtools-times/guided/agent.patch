diff --git a/src/components/PageTransitions.astro b/src/components/PageTransitions.astro
new file mode 100644
index 0000000..6cf145c
--- /dev/null
+++ b/src/components/PageTransitions.astro
@@ -0,0 +1,68 @@
+---
+import { ClientRouter } from 'astro:transitions';
+---
+
+<ClientRouter fallback="swap" />
+
+<script>
+  import type { TransitionBeforePreparationEvent, TransitionBeforeSwapEvent } from 'astro:transitions/client';
+
+  const incompletePages = new WeakSet<Document>();
+  let navigated = false;
+
+  async function decodeImage(source: HTMLImageElement, base: URL) {
+    const image = new Image();
+    // Match the destination request, including intentional credentialed images.
+    if (source.hasAttribute('crossorigin')) image.crossOrigin = source.crossOrigin;
+    image.referrerPolicy = source.referrerPolicy;
+    image.sizes = source.sizes;
+    image.srcset = source.srcset;
+    image.src = new URL(source.getAttribute('src')!, base).href;
+    await image.decode();
+  }
+
+  document.addEventListener('astro:before-preparation', (event) => {
+    const preparation = event as TransitionBeforePreparationEvent;
+    const load = preparation.loader;
+    preparation.loader = async () => {
+      await load();
+      if (preparation.signal.aborted || preparation.defaultPrevented) return;
+
+      // Astro has parsed the complete destination document. Its router also
+      // preloads destination stylesheets before taking either snapshot.
+      const images = preparation.newDocument.querySelectorAll<HTMLImageElement>('[data-transition-critical]');
+      const resources = Promise.all([
+        document.fonts.load('500 1em Grenze'),
+        ...Array.from(images, (image) => decodeImage(image, preparation.to)),
+      ]).then(() => true, () => false);
+
+      // Keep the current page interactive while loading. Failed or slow media
+      // must not freeze navigation or animate an incomplete destination.
+      let timer: ReturnType<typeof setTimeout>;
+      let onAbort: () => void;
+      const interrupted = new Promise<boolean>((resolve) => {
+        timer = setTimeout(() => resolve(false), 1800);
+        onAbort = () => resolve(false);
+        preparation.signal.addEventListener('abort', onAbort, { once: true });
+      });
+      const ready = await Promise.race([resources, interrupted]);
+      clearTimeout(timer!);
+      preparation.signal.removeEventListener('abort', onAbort!);
+      if (!ready) incompletePages.add(preparation.newDocument);
+    };
+  });
+
+  document.addEventListener('astro:before-swap', (event) => {
+    const swap = event as TransitionBeforeSwapEvent;
+    navigated = true;
+    if (incompletePages.has(swap.newDocument)) swap.viewTransition.skipTransition();
+  });
+
+  document.addEventListener('astro:page-load', () => {
+    // Announce the new view and preserve a useful keyboard starting point.
+    if (navigated && !location.hash) {
+      document.getElementById('page-content')?.focus({ preventScroll: true });
+    }
+    navigated = false;
+  });
+</script>
