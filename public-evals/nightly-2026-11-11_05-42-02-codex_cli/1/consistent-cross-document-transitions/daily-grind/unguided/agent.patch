+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <link rel="preload" as="image" fetchpriority="high" href="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&amp;fit=crop&amp;w=1350&amp;q=80">
+  <!-- Head styles block rendering, so the header and layout are ready for capture.
+       Keep any future initial theme/layout scripts here with blocking="render". -->
+  <link rel="stylesheet" href="/styles.css" blocking="render">
+  <!-- Wait through the main content's closing tag, without waiting for the footer. -->
+  <link rel="expect" href="#page-content" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <a class="logo" href="/" aria-label="The Daily Grind home">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Your Neighborhood Coffee Stop</h1>
+    <p>A fresh cup and a warm welcome. Make The Daily Grind part of your day.</p>
+    <a href="/menu" class="btn">Explore Our Menu</a>
+  </header>
+
+  <main class="container" id="page-content">
+    <section aria-labelledby="locations-heading">
+      <h2 id="locations-heading" style="text-align: center;">Visit The Daily Grind</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Plan Your Visit</h3>
+          <p>For current location details and opening hours, get in touch with our team.</p>
+          <a href="/contact" class="btn">Contact Us</a>
+        </div>
+        <div class="card">
+          <h3>Find Your Favorite</h3>
+          <p>Explore our seasonal favorites before your next coffee stop.</p>
+          <a href="/menu" class="btn">View the Menu</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
