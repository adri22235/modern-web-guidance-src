+  <script>
+    document.querySelectorAll('.drink-reveal').forEach(reveal => {
+      const content = reveal.querySelector('.card');
+      const panel = reveal.querySelector('.drink-actions');
+      const trigger = reveal.querySelector('.actions-toggle');
+      const syncState = () => {
+        const expanded = reveal.scrollLeft > (reveal.scrollWidth - reveal.clientWidth) / 2;
+        trigger.setAttribute('aria-expanded', String(expanded));
+        // Keep off-screen controls out of the tab order and accessibility tree.
+        if (!expanded && panel.contains(document.activeElement)) {
+          trigger.focus({ preventScroll: true });
+        }
+        panel.inert = !expanded;
+      };
+      const setOpen = open => {
+        reveal.scrollTo({ left: open ? reveal.scrollWidth - reveal.clientWidth : 0 });
+      };
+
+      trigger.addEventListener('click', () => {
+        setOpen(trigger.getAttribute('aria-expanded') !== 'true');
+      });
+      reveal.addEventListener('keydown', event => {
+        if (event.key === 'Escape') {
+          setOpen(false);
+          trigger.focus({ preventScroll: true });
+        }
+      });
+      content.addEventListener('focusin', event => {
+        if (event.target.matches(':focus-visible')) setOpen(false);
+      });
+
+      if ('onscrollsnapchange' in reveal) {
+        reveal.addEventListener('scrollsnapchange', syncState);
+      } else {
+        // Safari and Firefox fallback: observe native scrolling without intercepting gestures.
+        let frame = null;
+        let settleTimer;
+        reveal.addEventListener('scroll', () => {
+          if (frame === null) {
+            frame = requestAnimationFrame(() => {
+              frame = null;
+              syncState();
+            });
+          }
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(syncState, 150);
+        }, { passive: true });
+        reveal.addEventListener('scrollend', syncState);
+      }
+      window.addEventListener('load', syncState, { once: true });
+      window.addEventListener('pageshow', syncState);
+      syncState();
+    });
+
+    document.querySelectorAll('.favorite-toggle').forEach(button => {
+      button.addEventListener('click', () => {
+        const saved = button.getAttribute('aria-pressed') !== 'true';
+        button.setAttribute('aria-pressed', String(saved));
+        button.textContent = saved ? 'Saved Favorite' : 'Save Favorite';
+        document.querySelector('.favorite-status').textContent =
+          `${button.dataset.drink} ${saved ? 'saved to' : 'removed from'} your favorites for this visit.`;
+      });
+    });
+  </script>
