+  <script>
+    const drinkCards = [...document.querySelectorAll('.drink-card')];
+    const revealWidth = 132;
+
+    function setActions(card, direction) {
+      const toggle = card.querySelector('.actions-toggle');
+      const actions = card.querySelector('.drink-actions');
+      if (!direction && actions.contains(document.activeElement)) toggle.focus();
+      card.dataset.direction = direction;
+      card.style.setProperty('--offset', `${direction * revealWidth}px`);
+      card.classList.toggle('reveal-left', direction > 0);
+      card.classList.toggle('actions-open', direction !== 0);
+      toggle.setAttribute('aria-expanded', String(direction !== 0));
+      actions.inert = direction === 0;
+    }
+
+    drinkCards.forEach(card => {
+      const content = card.querySelector('.drink-content');
+      const toggle = card.querySelector('.actions-toggle');
+      let gesture = null;
+      let suppressClickUntil = 0;
+
+      function openActions(direction) {
+        drinkCards.forEach(other => {
+          if (other !== card) setActions(other, 0);
+        });
+        setActions(card, direction);
+      }
+
+      toggle.addEventListener('click', () => {
+        openActions(Number(card.dataset.direction) ? 0 : -1);
+      });
+
+      // A drag must never activate a link or the Actions toggle on release.
+      card.addEventListener('click', event => {
+        if (Date.now() < suppressClickUntil) {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+        }
+      }, true);
+
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || gesture) return;
+        gesture = {
+          id: event.pointerId, x: event.clientX, y: event.clientY,
+          start: Number(card.dataset.direction) || 0, dx: 0, dragging: false
+        };
+      });
+
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 10) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { gesture = null; return; }
+          gesture.dragging = true;
+          content.setPointerCapture(event.pointerId);
+          card.classList.add('dragging');
+        }
+        gesture.dx = dx;
+        const offset = Math.max(-revealWidth, Math.min(revealWidth, gesture.start * revealWidth + dx));
+        card.classList.toggle('reveal-left', offset > 0);
+        card.classList.add('actions-open');
+        card.style.setProperty('--offset', `${offset}px`);
+      });
+
+      function finishGesture(event) {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const { start, dx, dragging } = gesture;
+        gesture = null;
+        card.classList.remove('dragging');
+        if (dragging) {
+          suppressClickUntil = Date.now() + 400;
+          let direction = start;
+          if (event.type === 'pointerup' && Math.abs(dx) >= 48) {
+            direction = start ? (Math.sign(dx) === start ? start : 0) : Math.sign(dx);
+          }
+          openActions(direction);
+        }
+        if (content.hasPointerCapture(event.pointerId)) content.releasePointerCapture(event.pointerId);
+      }
+
+      content.addEventListener('pointerup', finishGesture);
+      content.addEventListener('pointercancel', finishGesture);
+      content.addEventListener('lostpointercapture', finishGesture);
+    });
+
+    document.addEventListener('pointerdown', event => {
+      if (!event.target.closest('.drink-card')) drinkCards.forEach(card => setActions(card, 0));
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape') drinkCards.forEach(card => setActions(card, 0));
+    });
+  </script>
