diff --git a/tests/translation.test.cjs b/tests/translation.test.cjs
new file mode 100644
index 0000000..6830235
--- /dev/null
+++ b/tests/translation.test.cjs
@@ -0,0 +1,140 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+const script = readFileSync(new URL('../translation.js', `file://${__filename}`), 'utf8');
+
+function setup(Translator) {
+  function element(textContent = '') {
+    return {
+      textContent, disabled: true, value: 'en', listeners: {},
+      addEventListener(type, handler) { this.listeners[type] = handler; },
+    };
+  }
+  const selector = element();
+  const button = element();
+  const status = element();
+  const passages = [element('Coffee description'), element('Our story')];
+  const elements = { 'menu-language': selector, 'translate-button': button, 'translation-status': status };
+  vm.runInNewContext(script, {
+    window: Translator ? { Translator } : {},
+    document: {
+      getElementById: (id) => elements[id],
+      querySelectorAll: () => passages,
+    },
+  });
+  return {
+    selector, button, status, passages,
+    async select(value) { selector.value = value; await selector.listeners.change(); },
+    click: () => button.listeners.click(),
+  };
+}
+
+test('unsupported browsers retain English and disable translation', () => {
+  const page = setup();
+  assert.equal(page.selector.disabled, true);
+  assert.equal(page.button.disabled, true);
+  assert.match(page.status.textContent, /unavailable in this browser/);
+  assert.equal(page.passages[0].textContent, 'Coffee description');
+});
+
+test('downloads from a click, translates originals, caches results and restores English', async () => {
+  let creationCount = 0;
+  let checkedOptions;
+  let destroyed = false;
+  const page = setup({
+    async availability(options) { checkedOptions = options; return 'downloadable'; },
+    create(options) {
+      creationCount++;
+      assert.equal(options.sourceLanguage, checkedOptions.sourceLanguage);
+      assert.equal(options.targetLanguage, checkedOptions.targetLanguage);
+      options.monitor({ addEventListener(type, callback) {
+        assert.equal(type, 'downloadprogress');
+        callback({ loaded: 0.5 });
+      } });
+      assert.match(page.status.textContent, /50%/);
+      return Promise.resolve({
+        translate: async (text) => `Translated: ${text}`,
+        destroy() { destroyed = true; },
+      });
+    },
+  });
+  await page.select('ar');
+  assert.equal(creationCount, 0);
+  const translation = page.click();
+  assert.equal(creationCount, 1, 'create runs synchronously within click');
+  await translation;
+  assert.equal(page.passages[0].textContent, 'Translated: Coffee description');
+  assert.equal(page.passages[1].textContent, 'Translated: Our story');
+  assert.equal(page.passages[0].lang, 'ar');
+  assert.equal(page.passages[0].dir, 'rtl');
+  assert.equal(destroyed, true);
+  await page.select('en');
+  assert.equal(page.passages[0].textContent, 'Coffee description');
+  assert.equal(page.passages[0].lang, 'en');
+  assert.equal(page.passages[0].dir, 'ltr');
+  await page.select('ar');
+  assert.equal(page.passages[0].textContent, 'Translated: Coffee description');
+  assert.equal(creationCount, 1);
+});
+
+test('unavailable language pairs and rejected availability leave content intact', async () => {
+  const page = setup({ async availability({ targetLanguage }) {
+    if (targetLanguage === 'fr') throw new Error('Policy blocked');
+    return 'unavailable';
+  } });
+  await page.select('es');
+  assert.equal(page.button.disabled, true);
+  assert.match(page.status.textContent, /unavailable on your device/);
+  await page.select('fr');
+  assert.equal(page.button.disabled, true);
+  assert.match(page.status.textContent, /Could not check/);
+  assert.equal(page.passages[0].textContent, 'Coffee description');
+});
+
+test('partial translation failures do not replace any text and allow retry', async () => {
+  const page = setup({
+    availability: async () => 'available',
+    create: async () => ({
+      async translate(text) {
+        if (text === 'Our story') throw new Error('Translation failed');
+        return 'Translated coffee';
+      },
+      destroy() {},
+    }),
+  });
+  await page.select('es');
+  await page.click();
+  assert.equal(page.passages[0].textContent, 'Coffee description');
+  assert.equal(page.button.disabled, false);
+  assert.match(page.status.textContent, /could not finish/);
+});
+
+test('switching to English while a model loads ignores stale results and cleans up', async () => {
+  let resolveCreation;
+  let destroyed = false;
+  const page = setup({
+    availability: async () => 'downloading',
+    create: () => new Promise((resolve) => { resolveCreation = resolve; }),
+  });
+  await page.select('ja');
+  const translation = page.click();
+  await page.select('en');
+  resolveCreation({ destroy() { destroyed = true; } });
+  await translation;
+  assert.equal(page.passages[0].textContent, 'Coffee description');
+  assert.match(page.status.textContent, /Original English/);
+  assert.equal(destroyed, true);
+});
+
+test('an outdated language availability check cannot enable the wrong language', async () => {
+  let resolveAvailability;
+  const page = setup({ availability: () => new Promise((resolve) => { resolveAvailability = resolve; }) });
+  const checking = page.select('es');
+  await page.select('en');
+  resolveAvailability('available');
+  await checking;
+  assert.equal(page.button.disabled, true);
+  assert.match(page.status.textContent, /Original English/);
+});
diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..0c8fc63
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,115 @@
+(() => {
+  const selector = document.getElementById('menu-language');
+  const button = document.getElementById('translate-button');
+  const status = document.getElementById('translation-status');
+  const passages = Array.from(document.querySelectorAll('[data-translatable]'));
+  const originals = passages.map((element) => element.textContent);
+  const cache = new Map([['en', originals]]);
+  let revision = 0;
+  let readyOptions = null;
+  let activeTranslator = null;
+
+  function display(texts, language) {
+    passages.forEach((element, index) => {
+      element.textContent = texts[index];
+      element.lang = language;
+      element.dir = language === 'ar' ? 'rtl' : 'ltr';
+    });
+  }
+
+  if (!('Translator' in window)) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome. The original English text is shown.';
+    return;
+  }
+
+  selector.disabled = false;
+  status.textContent = 'Choose a language, then select Translate. Your text stays on this device.';
+
+  selector.addEventListener('change', async () => {
+    const request = ++revision;
+    const language = selector.value;
+    readyOptions = null;
+    button.disabled = true;
+    button.textContent = 'Translate';
+    if (activeTranslator) {
+      activeTranslator.destroy();
+      activeTranslator = null;
+    }
+
+    if (cache.has(language)) {
+      display(cache.get(language), language);
+      status.textContent = language === 'en'
+        ? 'Original English text restored.'
+        : 'Saved on-device translation displayed. AI translations may contain errors.';
+      return;
+    }
+
+    status.textContent = 'Checking on-device language support…';
+    const options = { sourceLanguage: 'en', targetLanguage: language };
+    try {
+      const availability = await window.Translator.availability(options);
+      if (request !== revision) return;
+      if (availability === 'unavailable') {
+        status.textContent = 'This language is unavailable on your device. Choose another language or English. The displayed text has not changed.';
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device. Select Translate to continue.'
+        : 'A language pack is needed. Select Translate to download it and translate on your device.';
+    } catch {
+      if (request === revision) {
+        status.textContent = 'Could not check language support. Choose another language or select this language again to retry.';
+      }
+    }
+  });
+
+  button.addEventListener('click', async () => {
+    if (!readyOptions || button.disabled) return;
+    const request = revision;
+    const options = readyOptions;
+    let translator;
+    button.disabled = true;
+    button.textContent = 'Translating…';
+    status.textContent = 'Preparing on-device translation…';
+
+    try {
+      // Create directly in the click handler, before any await, to retain user activation.
+      translator = await window.Translator.create({
+        ...options,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            if (request === revision) {
+              status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%. Translation will start automatically.`;
+            }
+          });
+        },
+      });
+      if (request !== revision) return;
+      activeTranslator = translator;
+      status.textContent = 'Translating coffee descriptions and our story on your device…';
+      const translated = [];
+      for (const original of originals) {
+        translated.push(await translator.translate(original));
+        if (request !== revision) return;
+      }
+      // Commit together so failures never leave a partially translated page.
+      cache.set(options.targetLanguage, translated);
+      display(translated, options.targetLanguage);
+      readyOptions = null;
+      status.textContent = 'Translated on your device. AI translations may contain errors. Select English to restore the original.';
+    } catch {
+      if (request === revision) {
+        status.textContent = 'Translation could not finish. Your displayed text has not changed. Check your connection if a language pack is needed, then select Translate to retry.';
+      }
+    } finally {
+      if (translator) translator.destroy();
+      if (activeTranslator === translator) activeTranslator = null;
+      if (request === revision) {
+        button.textContent = 'Translate';
+        button.disabled = !readyOptions;
+      }
+    }
+  });
+})();
