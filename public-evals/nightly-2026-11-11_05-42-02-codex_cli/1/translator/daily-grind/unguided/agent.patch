diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..c9f905e
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,160 @@
+(() => {
+  'use strict';
+
+  const select = document.querySelector('#language-select');
+  const translateButton = document.querySelector('#translate-button');
+  const restoreButton = document.querySelector('#restore-button');
+  const status = document.querySelector('#translation-status');
+  const nodes = [...document.querySelectorAll('[data-translate]')];
+  // Always translate from the original, never from a previous translation.
+  const originals = nodes.map(node => node.textContent);
+  const translations = new Map([
+    ['en', originals],
+    ['es', [
+      'Leche de avena cremosa con un toque de sirope de arce de Vermont.',
+      'Intenso, ahumado y perfecto para empezar la mañana con energía.',
+      'Infusionado en frío durante 18 horas para lograr la máxima suavidad.',
+      'En The Daily Grind, un gran café empieza con el cuidado de cada detalle. Obtenemos nuestros granos de forma ética y los tostamos localmente para realzar el carácter de cada taza.',
+      'Desde el primer sorbo de la mañana hasta una tarde con amigos, estamos aquí para darle un poco más de calidez a tu día a día. Entra, baja el ritmo y encuentra tu favorito.'
+    ]],
+    ['fr', [
+      'Un lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.',
+      'Intense, fumé et parfait pour bien démarrer la matinée.',
+      'Infusé à froid pendant 18 heures pour une douceur incomparable.',
+      'Chez The Daily Grind, un excellent café commence par le soin apporté à chaque détail. Nous nous approvisionnons en grains de manière éthique et les torréfions localement pour révéler le caractère de chaque tasse.',
+      'De votre première gorgée du matin à un après-midi entre amis, nous sommes là pour rendre le quotidien un peu plus chaleureux. Entrez, prenez votre temps et trouvez votre café préféré.'
+    ]],
+    ['de', [
+      'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      'Kräftig, rauchig und perfekt für einen schwungvollen Start in den Morgen.',
+      'Für maximale Milde 18 Stunden kalt gezogen.',
+      'Bei The Daily Grind beginnt großartiger Kaffee mit Sorgfalt. Wir beziehen unsere Bohnen aus ethischem Anbau und rösten sie vor Ort, um den Charakter jeder Tasse zur Geltung zu bringen.',
+      'Vom ersten Schluck am Morgen bis zum Nachmittag mit Freunden: Wir möchten deinen Alltag ein wenig herzlicher machen. Komm herein, lass dir Zeit und finde deinen Lieblingskaffee.'
+    ]],
+    ['ja', [
+      'クリーミーなオーツミルクに、バーモント州産メープルシロップをほんのり加えました。',
+      '力強くスモーキーな味わいで、朝の元気をチャージするのにぴったりです。',
+      '18時間かけてじっくり水出しし、とびきりまろやかに仕上げました。',
+      'The Daily Grindのおいしいコーヒーは、一つひとつの丁寧な仕事から生まれます。倫理的に調達した豆を地元で焙煎し、一杯ごとの個性を引き出しています。',
+      '朝の最初のひと口から、友人と過ごす午後まで。私たちは、毎日に少しのぬくもりをお届けします。どうぞお立ち寄りください。ゆっくりと、お気に入りの一杯を見つけてください。'
+    ]]
+  ]);
+  let currentLanguage = 'en';
+  let request = 0;
+  let activeTranslator = null;
+  let busy = false;
+  const languageName = () => select.selectedOptions[0].textContent;
+  const nativeSupported = globalThis.isSecureContext && 'Translator' in globalThis;
+
+  function controls() {
+    translateButton.disabled = busy || select.value === currentLanguage;
+    restoreButton.disabled = !busy && currentLanguage === 'en';
+  }
+
+  function display(language, texts) {
+    nodes.forEach((node, index) => {
+      node.textContent = texts[index];
+      node.lang = language;
+    });
+    currentLanguage = language;
+    select.value = language;
+  }
+
+  function cancel() {
+    request += 1;
+    if (activeTranslator) activeTranslator.destroy();
+    activeTranslator = null;
+    busy = false;
+    nodes.forEach(node => node.removeAttribute('aria-busy'));
+  }
+
+  function selectionMessage() {
+    status.textContent = select.value === currentLanguage
+      ? `${languageName()} · ${currentLanguage === 'en' ? 'Original text' : 'Translation shown'}`
+      : translations.has(select.value)
+        ? `${languageName()} is ready on this device. Select Translate to read it.`
+        : 'Uses your browser’s on-device translator. A language pack may need to download; your text stays on this device.';
+    controls();
+  }
+
+  if (!nativeSupported) {
+    [...select.options].forEach(option => {
+      if (!translations.has(option.value)) {
+        option.disabled = true;
+        option.textContent += ' — requires browser translation';
+      }
+    });
+    status.textContent = 'English · Original text. Five languages are available; additional languages need a browser with on-device translation support.';
+  }
+  select.disabled = false;
+  controls();
+
+  select.addEventListener('change', () => {
+    cancel();
+    selectionMessage();
+  });
+
+  restoreButton.addEventListener('click', () => {
+    cancel();
+    display('en', originals);
+    status.textContent = 'English · Original text restored';
+    controls();
+  });
+
+  translateButton.addEventListener('click', async () => {
+    const language = select.value;
+    const name = languageName();
+    const id = ++request;
+    if (translations.has(language)) {
+      display(language, translations.get(language));
+      status.textContent = `${name} · ${language === 'en' ? 'Original text' : 'Translated on this device'}`;
+      controls();
+      return;
+    }
+
+    let translator;
+    busy = true;
+    controls();
+    nodes.forEach(node => node.setAttribute('aria-busy', 'true'));
+    status.textContent = `Preparing ${name} on this device… A language pack may download the first time.`;
+    try {
+      // Create directly within the click handler to preserve user activation
+      // when the browser needs to download a model.
+      translator = await globalThis.Translator.create({
+        sourceLanguage: 'en',
+        targetLanguage: language,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (id !== request) return;
+            const percent = Math.round(event.loaded * 100);
+            status.textContent = `Downloading ${name} language pack… ${percent}%`;
+          });
+        }
+      });
+      if (id !== request) return;
+      activeTranslator = translator;
+      status.textContent = `Translating into ${name} on this device…`;
+      const texts = [];
+      for (const original of originals) {
+        texts.push(await translator.translate(original));
+        if (id !== request) return;
+      }
+      // Commit all text together so a failure never leaves mixed languages.
+      translations.set(language, texts);
+      display(language, texts);
+      status.textContent = `${name} · Translated on this device`;
+    } catch (error) {
+      if (id !== request) return;
+      status.textContent = `Couldn’t translate into ${name}. Your browser may not support this language, or the language pack could not download. Try again or choose a ready-offline language. The displayed text has been kept.`;
+    } finally {
+      // A cancelled request must not clear a newer request's state.
+      if (id === request) {
+        activeTranslator = null;
+        busy = false;
+        nodes.forEach(node => node.removeAttribute('aria-busy'));
+        controls();
+      }
+      if (translator && activeTranslator !== translator) translator.destroy();
+    }
+  });
+})();
