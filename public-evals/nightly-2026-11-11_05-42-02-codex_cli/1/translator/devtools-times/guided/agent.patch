diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..f9eaf13
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,171 @@
+type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+type TranslatorSession = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type TranslatorFactory = {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    monitor: (monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }) => void;
+  }): Promise<TranslatorSession>;
+};
+
+// Text nodes preserve article links, emphasis, and event handlers. Never insert
+// model output as HTML, and never send scripts, code, or interactive UI to AI.
+function articleText() {
+  const nodes = new Map<Text, string>();
+  document.querySelectorAll<HTMLElement>('[data-translation-content]').forEach(region => {
+    const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT);
+    while (walker.nextNode()) {
+      const node = walker.currentNode as Text;
+      if (node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, button, select, textarea, [translate="no"], [contenteditable]')) {
+        nodes.set(node, node.textContent);
+      }
+    }
+  });
+  return nodes;
+}
+
+class ArticleTranslation extends HTMLElement {
+  private generation = 0;
+  private checkGeneration = 0;
+  private session?: TranslatorSession;
+  private originals = new Map<Text, string>();
+  private regions: { element: HTMLElement; lang: string | null; dir: string | null }[] = [];
+  private busy = false;
+  private translated = false;
+  private factory?: TranslatorFactory;
+  private select!: HTMLSelectElement;
+  private translateButton!: HTMLButtonElement;
+  private restoreButton!: HTMLButtonElement;
+  private status!: HTMLElement;
+
+  connectedCallback() {
+    if (!document.querySelector('[data-translation-content]')) return;
+    this.hidden = false;
+    this.select = this.querySelector('select')!;
+    this.translateButton = this.querySelector('[data-translate]')!;
+    this.restoreButton = this.querySelector('[data-restore]')!;
+    this.status = this.querySelector('[role="status"]')!;
+    this.factory = (window as Window & { Translator?: TranslatorFactory }).Translator;
+    this.originals = articleText();
+    this.regions = Array.from(document.querySelectorAll<HTMLElement>('[data-translation-content]'), element => ({
+      element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir'),
+    }));
+    this.select.onchange = () => void this.checkAvailability();
+    this.translateButton.onclick = () => void this.translate();
+    this.restoreButton.onclick = () => this.restore();
+    void this.checkAvailability();
+  }
+
+  disconnectedCallback() {
+    this.generation++;
+    this.checkGeneration++;
+    this.session?.destroy();
+    this.session = undefined;
+  }
+
+  private async checkAvailability() {
+    const check = ++this.checkGeneration;
+    this.translateButton.disabled = true;
+    if (!this.factory) {
+      this.select.disabled = true;
+      this.status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome. You can still read the English original.';
+      return;
+    }
+    this.status.textContent = 'Checking this language…';
+    try {
+      const availability = await this.factory.availability({ sourceLanguage: 'en', targetLanguage: this.select.value });
+      if (check !== this.checkGeneration || !this.isConnected) return;
+      this.translateButton.disabled = availability === 'unavailable' || this.busy;
+      this.status.textContent = availability === 'unavailable'
+        ? 'This language pair is unavailable on your device. Choose another language.'
+        : availability === 'available'
+          ? 'Ready to translate on your device. AI translations may contain errors.'
+          : 'First use requires a language-pack download. Select Translate to begin; translation runs on your device.';
+    } catch {
+      if (check === this.checkGeneration && this.isConnected) {
+        this.status.textContent = 'Could not check translation availability. Choose a language to try again.';
+      }
+    }
+  }
+
+  private async translate() {
+    if (!this.factory || this.busy) return;
+    const run = ++this.generation;
+    const language = this.select.value;
+    const current = () => run === this.generation && this.isConnected;
+    this.busy = true;
+    this.select.disabled = true;
+    this.translateButton.disabled = true;
+    this.translateButton.textContent = 'Translating…';
+    this.restoreButton.disabled = false;
+    this.status.textContent = 'Preparing on-device translation…';
+    let session: TranslatorSession | undefined;
+    try {
+      // Call create directly from the click handler: an awaited availability
+      // check here could consume the user activation required for downloads.
+      session = await this.factory.create({
+        sourceLanguage: 'en', targetLanguage: language,
+        monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+          if (current()) this.status.textContent = `Downloading language pack… ${Math.round(event.loaded * 100)}%`;
+        }),
+      });
+      if (!current()) return;
+      this.session = session;
+      const results = new Map<string, string>();
+      const texts = [...new Set([...this.originals.values()].map(text => text.trim()))];
+      for (const [index, text] of texts.entries()) {
+        if (!current()) return;
+        this.status.textContent = `Translating article text… ${index + 1} of ${texts.length}`;
+        results.set(text, await session.translate(text));
+      }
+      if (!current()) return;
+      // Apply only after every translation succeeds, preserving the current
+      // readable version on error and always translating from the original.
+      this.originals.forEach((text, node) => {
+        // Keep boundary whitespace around inline links and emphasized text.
+        node.textContent = text.replace(/\S[\s\S]*\S|\S/, () => results.get(text.trim())!.trim());
+      });
+      this.regions.forEach(({ element }) => {
+        element.lang = language;
+        element.dir = language === 'ar' ? 'rtl' : 'ltr';
+      });
+      this.translated = true;
+      this.status.textContent = `Translated to ${this.select.selectedOptions[0].textContent} on your device. AI translations may contain errors.`;
+    } catch {
+      if (current()) this.status.textContent = 'Translation could not finish. Your current text has been kept. Try again or choose another language.';
+    } finally {
+      session?.destroy();
+      if (this.session === session) this.session = undefined;
+      if (current()) this.finish();
+    }
+  }
+
+  private finish() {
+    this.busy = false;
+    this.select.disabled = false;
+    this.translateButton.disabled = false;
+    this.translateButton.textContent = 'Translate';
+    this.restoreButton.disabled = !this.translated;
+  }
+
+  private restore() {
+    this.generation++;
+    this.session?.destroy();
+    this.session = undefined;
+    this.originals.forEach((text, node) => { node.textContent = text; });
+    this.regions.forEach(({ element, lang, dir }) => {
+      if (lang === null) element.removeAttribute('lang'); else element.lang = lang;
+      if (dir === null) element.removeAttribute('dir'); else element.dir = dir;
+    });
+    this.translated = false;
+    this.finish();
+    this.status.textContent = 'Showing the English original.';
+  }
+}
+
+if (!customElements.get('article-translation')) {
+  customElements.define('article-translation', ArticleTranslation);
+}
