diff --git a/src/scripts/articleTranslation.ts b/src/scripts/articleTranslation.ts
new file mode 100644
index 0000000..9c6a7cb
--- /dev/null
+++ b/src/scripts/articleTranslation.ts
@@ -0,0 +1,132 @@
+import { translateTexts, type TranslatorAPI } from '../utils/translation';
+
+type OriginalRegion = { element: HTMLElement; lang: string | null; dir: string | null };
+
+class ArticleTranslation extends HTMLElement {
+  private originals = new Map<Text, string>();
+  private regions: OriginalRegion[] = [];
+  private request?: AbortController;
+  private activeLanguage = 'en';
+  private api?: TranslatorAPI;
+  private form!: HTMLFormElement;
+  private select!: HTMLSelectElement;
+  private submit!: HTMLButtonElement;
+  private restore!: HTMLButtonElement;
+  private status!: HTMLElement;
+
+  connectedCallback() {
+    this.form = this.querySelector('form')!;
+    this.select = this.querySelector('select')!;
+    this.submit = this.querySelector('[type="submit"]')!;
+    this.restore = this.querySelector('[type="button"]')!;
+    this.status = this.querySelector('[role="status"]')!;
+    this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    this.submit.disabled = !this.api;
+    this.message(this.api
+      ? 'Articles and teasers stay on your device. First use may download a language pack.'
+      : 'Translation is unavailable in this browser. Try a desktop browser with the on-device Translator API.');
+    this.form.addEventListener('submit', this.translate);
+    this.restore.addEventListener('click', this.showOriginal);
+    this.select.addEventListener('change', this.languageChanged);
+  }
+
+  disconnectedCallback() {
+    this.request?.abort();
+    this.form.removeEventListener('submit', this.translate);
+    this.restore.removeEventListener('click', this.showOriginal);
+    this.select.removeEventListener('change', this.languageChanged);
+  }
+
+  private message(text: string, error = false) {
+    this.status.textContent = text;
+    this.status.toggleAttribute('data-error', error);
+  }
+
+  private languageChanged = () => {
+    if (this.api) this.submit.disabled = this.select.value === this.activeLanguage;
+  };
+
+  private collect() {
+    if (this.regions.length) return;
+    document.querySelectorAll<HTMLElement>('[data-translate]').forEach(element => {
+      this.regions.push({ element, lang: element.getAttribute('lang'), dir: element.getAttribute('dir') });
+      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
+        acceptNode(node) {
+          return node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, button, textarea, [translate="no"]')
+            ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+        },
+      });
+      while (walker.nextNode()) {
+        const node = walker.currentNode as Text;
+        this.originals.set(node, node.data);
+      }
+    });
+  }
+
+  private translate = async (event: Event) => {
+    event.preventDefault();
+    if (!this.api || this.request) return;
+    this.collect();
+    if (!this.originals.size) {
+      this.message('No article text to translate on this page.');
+      return;
+    }
+    const target = this.select.value;
+    const request = new AbortController();
+    this.request = request;
+    this.submit.disabled = true;
+    this.select.disabled = true;
+    this.submit.textContent = 'Translating…';
+    this.restore.hidden = false;
+    this.restore.textContent = 'Cancel';
+    this.message('Preparing on-device translation…');
+    try {
+      const results = await translateTexts(this.api, target, [...this.originals.values()], request.signal, message => this.message(message));
+      if (request.signal.aborted || !this.isConnected) return;
+      // Commit only once every text has translated successfully, preserving all markup.
+      [...this.originals.keys()].forEach((node, index) => { node.data = results[index]; });
+      this.regions.forEach(({ element }) => {
+        element.lang = target;
+        element.dir = target === 'ar' ? 'rtl' : 'ltr';
+      });
+      this.activeLanguage = target;
+      const language = this.select.selectedOptions[0].textContent;
+      this.message(`Now reading in ${language}. Machine translations may contain errors.`);
+    } catch (error) {
+      if (request.signal.aborted) return;
+      const name = error instanceof Error ? error.name : '';
+      this.message(name === 'NotSupportedError'
+        ? 'This language pair is unavailable on your device. Please choose another language.'
+        : name === 'NotAllowedError'
+          ? 'Your browser could not start translation. Allow the language-pack download, then try again.'
+          : 'Translation could not finish. Check your connection for the language pack and try again. Your displayed text has been kept.', true);
+    } finally {
+      if (this.request === request) {
+        this.request = undefined;
+        this.select.disabled = false;
+        this.submit.disabled = this.select.value === this.activeLanguage;
+        this.submit.textContent = 'Translate ↗';
+        this.restore.textContent = 'Show original';
+        this.restore.hidden = this.activeLanguage === 'en';
+      }
+    }
+  };
+
+  private showOriginal = () => {
+    this.request?.abort();
+    this.request = undefined;
+    this.originals.forEach((text, node) => { node.data = text; });
+    this.regions.forEach(({ element, lang, dir }) => {
+      if (lang === null) element.removeAttribute('lang'); else element.lang = lang;
+      if (dir === null) element.removeAttribute('dir'); else element.dir = dir;
+    });
+    this.activeLanguage = 'en';
+    this.select.disabled = false;
+    this.submit.disabled = !this.api;
+    this.submit.textContent = 'Translate ↗';
+    this.restore.hidden = true;
+    this.message('Showing the original English articles and teasers.');
+  };
+}
+
+if (!customElements.get('article-translation')) customElements.define('article-translation', ArticleTranslation);
diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..b9370bd
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,53 @@
+export interface OnDeviceTranslator {
+  translate(text: string, options?: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+export interface TranslatorAPI {
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal: AbortSignal;
+    monitor: (monitor: EventTarget) => void;
+  }): Promise<OnDeviceTranslator>;
+}
+
+/** Always translate from the original copy, never from a previous translation. */
+export async function translateTexts(
+  api: TranslatorAPI,
+  targetLanguage: string,
+  texts: string[],
+  signal: AbortSignal,
+  onProgress: (message: string) => void,
+): Promise<string[]> {
+  // Call create before any await to retain the click's user activation for downloads.
+  const translator = await api.create({
+    sourceLanguage: 'en',
+    targetLanguage,
+    signal,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => {
+        const loaded = (event as Event & { loaded: number }).loaded;
+        if (!signal.aborted) onProgress(`Downloading language pack… ${Math.round(loaded * 100)}%`);
+      });
+    },
+  });
+  try {
+    const cache = new Map<string, string>();
+    const results: string[] = [];
+    for (const text of texts) {
+      signal.throwIfAborted();
+      const trimmed = text.trim();
+      if (!cache.has(trimmed)) {
+        cache.set(trimmed, await translator.translate(trimmed, { signal }));
+      }
+      signal.throwIfAborted();
+      // Preserve whitespace around inline elements, links, and emphasized text.
+      results.push(text.replace(trimmed, () => cache.get(trimmed)!));
+      onProgress(`Translating… ${Math.round((results.length / texts.length) * 100)}%`);
+    }
+    return results;
+  } finally {
+    translator.destroy();
+  }
+}
diff --git a/tests/translation.test.ts b/tests/translation.test.ts
new file mode 100644
index 0000000..d307024
--- /dev/null
+++ b/tests/translation.test.ts
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { translateTexts, type TranslatorAPI } from '../src/utils/translation.ts';
+
+test('translates original English, deduplicates repeated copy, and preserves whitespace', async () => {
+  const calls: string[] = [];
+  let destroyed = false;
+  const api: TranslatorAPI = {
+    async create(options) {
+      assert.equal(options.sourceLanguage, 'en');
+      assert.equal(options.targetLanguage, 'es');
+      return {
+        async translate(text) { calls.push(text); return 'Hola'; },
+        destroy() { destroyed = true; },
+      };
+    },
+  };
+  const results = await translateTexts(api, 'es', [' Hello ', '\nHello\n'], new AbortController().signal, () => {});
+  assert.deepEqual(results, [' Hola ', '\nHola\n']);
+  assert.deepEqual(calls, ['Hello']);
+  assert.equal(destroyed, true);
+});
+
+test('creates the translator synchronously within the initiating user gesture', async () => {
+  let created = false;
+  const api: TranslatorAPI = {
+    async create() {
+      created = true;
+      return { async translate(text) { return text; }, destroy() {} };
+    },
+  };
+  const pending = translateTexts(api, 'fr', ['News'], new AbortController().signal, () => {});
+  assert.equal(created, true);
+  await pending;
+});
+
+test('reports language-pack progress and translation progress', async () => {
+  const messages: string[] = [];
+  const api: TranslatorAPI = {
+    async create(options) {
+      const monitor = new EventTarget();
+      options.monitor(monitor);
+      monitor.dispatchEvent(Object.assign(new Event('downloadprogress'), { loaded: 0.5 }));
+      return { async translate() { return 'Noticias'; }, destroy() {} };
+    },
+  };
+  await translateTexts(api, 'es', ['News'], new AbortController().signal, message => messages.push(message));
+  assert.deepEqual(messages, ['Downloading language pack… 50%', 'Translating… 100%']);
+});
+
+test('rejects the whole result on failure and releases the translator', async () => {
+  let destroyed = false;
+  const api: TranslatorAPI = {
+    async create() {
+      return {
+        async translate(text) { if (text === 'Body') throw new Error('Failed'); return 'Titre'; },
+        destroy() { destroyed = true; },
+      };
+    },
+  };
+  await assert.rejects(translateTexts(api, 'fr', ['Headline', 'Body'], new AbortController().signal, () => {}), /Failed/);
+  assert.equal(destroyed, true);
+});
+
+test('cancels in-flight translation without publishing results and releases resources', async () => {
+  const request = new AbortController();
+  let destroyed = false;
+  let calls = 0;
+  const api: TranslatorAPI = {
+    async create() {
+      return {
+        async translate() { calls++; request.abort(); return 'Titre'; },
+        destroy() { destroyed = true; },
+      };
+    },
+  };
+  await assert.rejects(translateTexts(api, 'fr', ['Headline', 'Body'], request.signal, () => {}), { name: 'AbortError' });
+  assert.equal(calls, 1);
+  assert.equal(destroyed, true);
+});
