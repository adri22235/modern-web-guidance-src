+  <script>
+    (() => {
+      // Numeric date components use the visitor's local time zone; months are zero-based.
+      // Promotion start is assumed to be January 1, 2026 at local midnight.
+      const promotionStart = new Date(2026, 0, 1, 0, 0, 0);
+      const promotionEnd = new Date(2026, 2, 1, 0, 0, 0);
+      const millisecondsPerHour = 60 * 60 * 1000;
+
+      function formatDuration(milliseconds) {
+        const totalHours = Math.floor(Math.max(0, milliseconds) / millisecondsPerHour);
+        const days = Math.floor(totalHours / 24);
+        const hours = totalHours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} and ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotionTimer() {
+        const now = new Date();
+        const remaining = promotionEnd - now;
+        document.getElementById('maple-countdown').textContent = remaining <= 0
+          ? 'Offer ended · 0 days and 0 hours left'
+          : `${formatDuration(remaining)} left`;
+        document.getElementById('maple-elapsed').textContent = now < promotionStart
+          ? 'Promotion has not started yet · 0 days and 0 hours elapsed'
+          : `${formatDuration(now - promotionStart)} elapsed since the promotion started`;
+      }
+
+      updatePromotionTimer();
+      // Recompute from the current clock so long visits and background tabs stay accurate.
+      setInterval(updatePromotionTimer, 60 * 1000);
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotionTimer();
+      });
+    })();
+  </script>
+
