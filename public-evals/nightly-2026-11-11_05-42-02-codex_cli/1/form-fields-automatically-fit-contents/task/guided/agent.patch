+  <script>
+    const preferences = document.getElementById('coffee-preferences');
+    const preview = document.getElementById('preference-preview');
+
+    preferences.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(preferences);
+      const name = data.get('name').trim();
+      const notes = data.get('notes').trim();
+      preview.textContent = `${data.get('coffee')}${name ? ` for ${name}` : ''}${notes ? ` — ${notes}` : ''}.`;
+    });
+
+    preferences.addEventListener('input', () => {
+      preview.textContent = '';
+    });
+  </script>
