+  <script>
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeToggle = document.getElementById('theme-toggle');
+    const themeReset = document.getElementById('theme-reset');
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+
+    function isDark() {
+      return themeMeta.content === 'dark' ||
+        (themeMeta.content === 'light dark' && systemTheme.matches);
+    }
+
+    function updateThemeControls() {
+      themeToggle.setAttribute('aria-pressed', String(isDark()));
+      themeReset.hidden = themeMeta.content === 'light dark';
+    }
+
+    function setTheme(theme) {
+      themeMeta.content = theme;
+      updateThemeControls();
+      try {
+        if (theme === 'light dark') {
+          localStorage.removeItem('daily-grind-theme');
+        } else {
+          localStorage.setItem('daily-grind-theme', theme);
+        }
+      } catch {}
+    }
+
+    themeToggle.addEventListener('click', () => setTheme(isDark() ? 'light' : 'dark'));
+    themeReset.addEventListener('click', () => setTheme('light dark'));
+    systemTheme.addEventListener('change', updateThemeControls);
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'daily-grind-theme' || event.key === null) {
+        themeMeta.content = event.newValue === 'light' || event.newValue === 'dark'
+          ? event.newValue : 'light dark';
+        updateThemeControls();
+      }
+    });
+    updateThemeControls();
+    themeToggle.hidden = false;
+  </script>
+
