+<div class="order-status" role="status" aria-live="polite" aria-atomic="true"></div>
+  <script>
+    let nextId = 0;
+    let statusTimer;
+    const status = document.querySelector('.order-status');
+    const triggers = new Map();
+    const items = menu => [...menu.children].filter(el => el.matches('[role^="menuitem"]'));
+
+    function closeMenu(menu, restoreFocus = false) {
+      menu.querySelectorAll('[role="menu"]').forEach(child => closeMenu(child));
+      menu.hidden = true;
+      const trigger = triggers.get(menu);
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+    function closeAll() {
+      document.querySelectorAll('[role="menu"]').forEach(menu => closeMenu(menu));
+    }
+    function openMenu(menu, last = false) {
+      const trigger = triggers.get(menu);
+      const parent = trigger.closest('[role="menu"]');
+      if (parent) {
+        [...parent.children].filter(el => el.matches('[role="menu"]') && el !== menu).forEach(el => closeMenu(el));
+      } else closeAll();
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      const rect = trigger.getBoundingClientRect();
+      const width = menu.offsetWidth;
+      let left = parent ? rect.right + 8 : rect.left;
+      if (left + width > innerWidth - 12) left = parent ? rect.left - width - 8 : innerWidth - width - 12;
+      menu.style.left = Math.max(12, left) + 'px';
+      menu.style.top = Math.max(12, Math.min(parent ? rect.top : rect.bottom + 8, innerHeight - menu.offsetHeight - 12)) + 'px';
+      const options = items(menu);
+      (last ? options.at(-1) : options[0])?.focus();
+    }
+    function createMenu(host, label, nested = false, className = '') {
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.className = className;
+      trigger.textContent = label;
+      const arrow = document.createElement('span');
+      arrow.className = 'chevron';
+      arrow.textContent = nested ? '›' : '▾';
+      arrow.setAttribute('aria-hidden', 'true');
+      trigger.append(arrow);
+      if (nested) { trigger.setAttribute('role', 'menuitem'); trigger.tabIndex = -1; }
+      const menu = document.createElement('div');
+      menu.id = 'menu-' + ++nextId;
+      trigger.id = 'trigger-' + nextId;
+      menu.className = 'menu';
+      menu.setAttribute('role', 'menu');
+      menu.setAttribute('aria-labelledby', trigger.id);
+      menu.hidden = true;
+      trigger.setAttribute('aria-haspopup', 'menu');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', menu.id);
+      triggers.set(menu, trigger);
+      trigger.addEventListener('click', () => menu.hidden ? openMenu(menu) : closeMenu(menu, true));
+      trigger.addEventListener('keydown', event => {
+        if (['ArrowDown', 'ArrowUp'].includes(event.key) && !nested) {
+          event.preventDefault(); openMenu(menu, event.key === 'ArrowUp');
+        } else if (event.key === 'ArrowRight' && nested) {
+          event.preventDefault(); event.stopPropagation(); openMenu(menu);
+        }
+      });
+      host.append(trigger, menu);
+      return menu;
+    }
+    function action(menu, label, handler, role = 'menuitem', checked = false) {
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.textContent = label;
+      button.setAttribute('role', role);
+      button.tabIndex = -1;
+      if (role !== 'menuitem') button.setAttribute('aria-checked', String(checked));
+      button.addEventListener('click', () => handler(button));
+      menu.append(button);
+      return button;
+    }
+    function heading(menu, text) {
+      const label = document.createElement('div');
+      label.className = 'menu-label'; label.textContent = text;
+      label.setAttribute('role', 'presentation'); menu.append(label);
+    }
+    function link(menu, label, href) {
+      const anchor = document.createElement('a');
+      anchor.textContent = label; anchor.href = href;
+      anchor.setAttribute('role', 'menuitem'); anchor.tabIndex = -1;
+      menu.append(anchor);
+    }
+    const drinks = createMenu(document.querySelector('#drink-menu-root'), 'Menu', false, 'nav-trigger');
+    heading(drinks, 'Find your daily favorite');
+    const hot = createMenu(drinks, 'Hot drinks', true);
+    const espresso = createMenu(hot, 'Espresso drinks', true);
+    link(espresso, 'Latte', '/menu/latte');
+    link(espresso, 'Cappuccino', '/menu/cappuccino');
+    link(espresso, 'Dark Roast Espresso', '/menu/espresso');
+    link(hot, 'Brewed coffee', '/menu/coffee');
+    link(hot, 'Tea & chocolate', '/menu/tea');
+    const cold = createMenu(drinks, 'Cold drinks', true);
+    link(cold, 'Cold Brew', '/menu/cold-brew');
+    link(cold, 'Iced latte', '/menu/iced-latte');
+    link(drinks, 'Seasonal favorites', '#seasonal-favorites');
+    link(drinks, 'View full menu', '/menu');
+
+    document.querySelectorAll('.order-controls').forEach(host => {
+      const state = { size: 'Regular', milk: host.dataset.milk, extra: false };
+      const summary = document.createElement('p');
+      summary.className = 'order-summary';
+      const update = () => summary.textContent = `${state.size} · ${state.milk}${state.extra ? ' · Extra shot' : ''}`;
+      update();
+      const menu = createMenu(host, 'Order options', false, 'btn');
+      triggers.get(menu).setAttribute('aria-label', 'Order options for ' + host.dataset.drink);
+      heading(menu, host.dataset.drink);
+      const customize = createMenu(menu, 'Customize drink', true);
+      function choices(label, key, options) {
+        const submenu = createMenu(customize, label, true);
+        heading(submenu, 'Choose one');
+        options.forEach(value => action(submenu, value, button => {
+          items(submenu).forEach(item => item.setAttribute('aria-checked', String(item === button)));
+          state[key] = value; update();
+        }, 'menuitemradio', state[key] === value));
+      }
+      choices('Size', 'size', ['Small', 'Regular', 'Large']);
+      choices('Milk', 'milk', ['No milk', 'Whole milk', 'Oat milk', 'Almond milk']);
+      action(customize, 'Extra espresso shot', button => {
+        state.extra = !state.extra;
+        button.setAttribute('aria-checked', String(state.extra)); update();
+      }, 'menuitemcheckbox');
+      menu.append(document.createElement('hr'));
+      action(menu, 'Add to order', () => {
+        closeMenu(menu, true);
+        clearTimeout(statusTimer);
+        status.textContent = `Added to your order: ${host.dataset.drink} — ${summary.textContent}.`;
+        statusTimer = setTimeout(() => status.textContent = '', 6000);
+      });
+      action(menu, 'Reset customizations', () => {
+        state.size = 'Regular'; state.milk = host.dataset.milk; state.extra = false;
+        customize.querySelectorAll('[role="menuitemradio"]').forEach(item => {
+          const key = item.closest('[role="menu"]').getAttribute('aria-labelledby');
+          const field = document.getElementById(key).textContent.startsWith('Size') ? 'size' : 'milk';
+          item.setAttribute('aria-checked', String(item.textContent === state[field]));
+        });
+        customize.querySelector('[role="menuitemcheckbox"]').setAttribute('aria-checked', 'false');
+        update(); closeMenu(menu, true);
+      });
+      host.append(summary);
+    });
+    document.querySelector('main section').id = 'seasonal-favorites';
+    document.addEventListener('keydown', event => {
+      const menu = event.target.closest('[role="menu"]');
+      if (!menu) return;
+      const options = items(menu);
+      const index = options.indexOf(document.activeElement);
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
+        options[next]?.focus();
+      } else if (event.key === 'Escape' || event.key === 'ArrowLeft') {
+        event.preventDefault(); closeMenu(menu, true);
+      } else if (event.key === 'Tab') {
+        // Return to the trigger so normal Tab order continues from this component.
+        let root = menu;
+        while (triggers.get(root).closest('[role="menu"]')) root = triggers.get(root).closest('[role="menu"]');
+        triggers.get(root).focus(); closeAll();
+      }
+    });
+    document.addEventListener('click', event => {
+      if (!event.target.closest('[aria-haspopup="menu"], [role="menu"]')) closeAll();
+      if (event.target.closest('a[role="menuitem"]')) closeAll();
+    });
+    document.addEventListener('focusin', event => {
+      if (!event.target.closest('[aria-haspopup="menu"], [role="menu"]')) closeAll();
+    });
+    window.addEventListener('resize', closeAll);
+    window.addEventListener('scroll', closeAll, { passive: true });
+  </script>
 </body>
 
