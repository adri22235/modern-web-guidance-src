+    espresso: { name: 'Dark Roast Espresso', size: 'Small', milk: 'No milk', decaf: false, extra: false },
+    'cold-brew': { name: 'Cold Brew', size: 'Medium', milk: 'No milk', decaf: false, extra: false }
+  };
+  const branch = (label, items) => ({ label, items });
+  const link = (label, href) => ({ label, href });
+  const navigation = [
+    { heading: 'Explore the menu' },
+    branch('Coffee', [
+      branch('Hot coffee', [link('Maple Oat Latte', '/menu/seasonal'), link('Dark Roast Espresso', '/menu/espresso'), link('All hot drinks', '/menu/hot')]),
+      branch('Iced coffee', [link('Cold Brew', '/menu/cold-brew'), link('Iced lattes', '/menu/iced-lattes')])
+    ]),
+    branch('Tea & more', [link('Hot tea', '/menu/tea'), link('Iced tea', '/menu/iced-tea'), link('Hot chocolate', '/menu/hot-chocolate')]),
+    link('Seasonal favorites', '#seasonal-heading'),
