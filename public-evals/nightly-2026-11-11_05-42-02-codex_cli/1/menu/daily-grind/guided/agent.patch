+  const isOpen = panel => nativePopover ? panel.matches(':popover-open') : panel.hasAttribute('data-open');
+  const groupFor = panel => panel.firstElementChild;
+  const rootFor = panel => panel.parentElement.closest('.menu-panel') ? rootFor(panel.parentElement.closest('.menu-panel')) : panel;
