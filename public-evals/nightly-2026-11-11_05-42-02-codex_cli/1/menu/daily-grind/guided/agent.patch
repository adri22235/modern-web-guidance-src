+    if (top + height > innerHeight - 12 && !nested) top = rect.top - height - gap;
+    panel.style.top = `${Math.max(12, Math.min(top, innerHeight - height - 12))}px`;
+  }
+
+  function sync(panel, open) {
+    panel.toggleAttribute('data-open', open);
+    triggerFor(panel).setAttribute('aria-expanded', String(open));
