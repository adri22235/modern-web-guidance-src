+      delete panel.dataset.bridge;
+    }
+  }
+
+  function hide(panel) {
+    [...panel.querySelectorAll('.menu-panel')].reverse().forEach(child => {
+      if (isOpen(child)) hide(child);
+    });
+    if (!isOpen(panel)) return;
+    if (nativePopover) panel.hidePopover();
