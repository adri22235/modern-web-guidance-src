+
+  function position(panel) {
+    if (anchors && nativePopover) return;
+    const trigger = triggerFor(panel);
+    const rect = trigger.getBoundingClientRect();
+    const nested = !!trigger.closest('.menu-panel');
+    const width = panel.offsetWidth;
+    const height = panel.offsetHeight;
+    const gap = 6;
+    let left = nested ? rect.right + gap : rect.left;
+    let top = nested ? rect.top : rect.bottom + gap;
+    if (left + width > innerWidth - 12) left = nested ? rect.left - width - gap : rect.right - width;
+    // On phones there may be no room on either side: open below the trigger.
