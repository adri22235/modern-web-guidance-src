+  }
+
+  function close(panel, fromPointer = false) {
+    triggerFor(panel).focus({ preventScroll: true, focusVisible: !fromPointer });
+    hide(panel);
+  }
+
+  function show(panel, enter) {
+    if (enter) entering.set(panel, enter);
+    if (isOpen(panel)) {
+      if (enter) sync(panel, true);
+      return;
+    }
+    const parent = triggerFor(panel).closest('.menu-panel');
