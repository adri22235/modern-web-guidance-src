+++ b/scripts/build.mjs
@@ -0,0 +1,10 @@
+import { cp, mkdir, rm } from 'node:fs/promises';
+
+// Explicit allowlist: never publish tooling, audit notes, or repository metadata.
+const output = new URL('../dist/', import.meta.url);
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+for (const path of ['index.html', 'privacy-policy', 'assets', '_headers']) {
+  await cp(new URL(`../${path}`, import.meta.url), new URL(path, output), { recursive: true });
+}
+console.log('Built static website in dist/ with privacy headers.');
diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000..f9af9a2
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,85 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir, access } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const pages = ['index.html', 'privacy-policy/index.html'];
+const read = (path) => readFile(resolve(root, path), 'utf8');
+const headerText = await read('_headers');
+const headers = Object.fromEntries([...headerText.matchAll(/^  ([\w-]+): (.+)$/gm)]
+  .map(([, name, value]) => [name.toLowerCase(), value]));
+const parsePolicy = (value) => Object.fromEntries(value.split(';').filter((x) => x.trim())
+  .map((part) => { const [name, ...sources] = part.trim().split(/\s+/); return [name, sources.join(' ')]; }));
+
+test('headers enforce privacy boundaries on every path', () => {
+  assert.ok(headerText.startsWith('/*\n'));
+  const policy = parsePolicy(headers['content-security-policy']);
+  for (const directive of ['default-src', 'script-src', 'script-src-attr', 'style-src-attr',
+    'connect-src', 'worker-src', 'frame-src', 'object-src', 'base-uri', 'form-action', 'frame-ancestors']) {
+    assert.equal(policy[directive], "'none'", directive);
+  }
+  assert.equal(policy['style-src'], "'self'");
+  assert.equal(policy['img-src'], "'self'");
+  assert.equal(policy['require-trusted-types-for'], "'script'");
+  assert.equal(policy['trusted-types'], "'none'");
+  assert.doesNotMatch(headers['content-security-policy'], /unsafe-|report-uri|report-to|https?:/);
+  assert.equal(headers['referrer-policy'], 'no-referrer');
+  assert.equal(headers['x-content-type-options'], 'nosniff');
+  assert.equal(headers['x-frame-options'], 'DENY');
+  assert.equal(headers['x-dns-prefetch-control'], 'off');
+  assert.match(headers['strict-transport-security'], /^max-age=\d+$/);
+  for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics']) {
+    assert.ok(headers['permissions-policy'].split(', ').includes(`${feature}=()`), feature);
+  }
+});
+
+// This intentionally strict static-site guard requires review before adding any
+// executable content, data collection, third-party resource, or resource hint.
+for (const page of pages) {
+  test(`${page}: no collection, executable markup, or third-party requests`, async () => {
+    const html = await read(page);
+    assert.doesNotMatch(html, /<(?:script|style|iframe|object|embed|form|input|textarea|select|base)\b/i);
+    assert.doesNotMatch(html, /\s(?:on[\w-]+|style|ping|srcset)\s*=/i);
+    assert.doesNotMatch(html, /rel\s*=\s*["'][^"']*(?:preconnect|dns-prefetch|prefetch|prerender|modulepreload)/i);
+    assert.match(html, /<meta name="referrer" content="no-referrer">/);
+    const meta = html.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/);
+    assert.ok(meta);
+    assert.ok(html.indexOf(meta[0]) < html.indexOf('<link'), 'CSP must precede resources');
+    const policy = parsePolicy(headers['content-security-policy']);
+    delete policy['frame-ancestors']; // HTTP-only; unsupported in meta CSP.
+    assert.deepEqual(parsePolicy(meta[1]), policy);
+    for (const [, attribute, url] of html.matchAll(/\b(href|src|action)="([^"]+)"/g)) {
+      assert.match(url, /^\/(?!\/)|^#/, `${attribute} must stay on this origin`);
+      if (attribute === 'src' || url.startsWith('/assets/')) {
+        await access(resolve(root, url.slice(1)));
+      }
+    }
+  });
+}
+
+test('stylesheet uses only existing local resources and no remote imports', async () => {
+  const css = await read('assets/styles.css');
+  assert.doesNotMatch(css, /@import|https?:|\/\//i);
+  const resources = [...css.matchAll(/url\(['"]?([^'"\s)]+)['"]?\)/g)];
+  assert.ok(resources.length > 0, 'preserve the hero image');
+  for (const [, url] of resources) {
+    assert.match(url, /^\/assets\//);
+    await access(resolve(root, url.slice(1)));
+  }
+});
+
+test('published assets contain no client-side programs', async () => {
+  async function inspect(path) {
+    for (const entry of await readdir(path, { withFileTypes: true })) {
+      const full = resolve(path, entry.name);
+      if (entry.isDirectory()) await inspect(full);
+      else assert.ok(['.css', '.jpg'].some((extension) => entry.name.endsWith(extension)), full);
+    }
+  }
+  await inspect(resolve(root, 'assets'));
+  const home = await read('index.html');
+  assert.match(home, /href="\/privacy-policy\/"/);
+  await access(resolve(root, 'privacy-policy/index.html'));
+});
