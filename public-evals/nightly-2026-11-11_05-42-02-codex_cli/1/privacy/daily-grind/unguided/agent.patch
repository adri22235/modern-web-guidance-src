+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; base-uri 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; form-action 'none'; upgrade-insecure-requests">
+  <title>Privacy | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/styles.css">
+</head>
+<body>
+  <nav aria-label="Main navigation">
+    <a class="logo" href="/">THE DAILY GRIND</a>
+    <a href="/">Back to home</a>
+  </nav>
+  <main class="container privacy-copy">
+    <h1>Your privacy at The Daily Grind</h1>
+    <p>This notice covers the static Daily Grind website. You can browse its pages without providing personal information.</p>
+    <h2>Only what is needed to show the page</h2>
+    <p>These pages have no analytics, advertising trackers, third-party embeds, or client-side scripts. They do not set cookies or save information in your browser’s local storage. Images and styles are served from this website, so viewing them does not contact an external image or font provider.</p>
+    <h2>Connection information</h2>
+    <p>To deliver a page, the hosting provider receives connection information such as your IP address and requested URL. Its logging and retention settings are managed by the website operator. This website’s source code does not determine whether the host keeps access logs or how long they are kept. Avoid including personal information in URLs.</p>
+    <h2>Accounts and ordering</h2>
+    <p>This static website does not collect account details, payment information, or order data. If account or ordering services are added, their data practices must be explained before information is collected.</p>
+    <h2>Privacy choices</h2>
+    <p>No consent preference is needed for optional tracking because these pages contain none. Your browser controls its own history and cache. Clearing site data in your browser does not delete records that a hosting provider may hold.</p>
+    <h2>Questions</h2>
+    <p>Ask the Daily Grind team in store about privacy or information you have provided directly to the business. Please do not send passwords or payment details.</p>
+    <p>Last updated: November 11, 2026.</p>
+  </main>
+  <footer><p>&copy; 2026 The Daily Grind Coffee Co.</p></footer>
+</body>
+</html>
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..18aaee4
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,16 @@
+import { cp, mkdir, rm, writeFile } from 'node:fs/promises';
+import { headers } from './security-policy.mjs';
+
+// Publish only public assets; never publish repository files or audit notes.
+await rm('dist', { recursive: true, force: true });
+await mkdir('dist', { recursive: true });
+for (const path of ['index.html', 'assets', 'privacy-policy']) {
+  await cp(path, `dist/${path}`, { recursive: true });
+}
+await writeFile('dist/_headers', `/*\n${Object.entries(headers).map(([key, value]) => `  ${key}: ${value}`).join('\n')}\n`);
+await writeFile('vercel.json', `${JSON.stringify({
+  buildCommand: 'npm run build',
+  outputDirectory: 'dist',
+  headers: [{ source: '/(.*)', headers: Object.entries(headers).map(([key, value]) => ({ key, value })) }],
+}, null, 2)}\n`);
+console.log('Built static site in dist/ with deployment security headers.');
diff --git a/scripts/privacy.test.mjs b/scripts/privacy.test.mjs
new file mode 100644
index 0000000..28cf571
--- /dev/null
+++ b/scripts/privacy.test.mjs
@@ -0,0 +1,34 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile, readdir, stat } from 'node:fs/promises';
+import { csp, headers } from './security-policy.mjs';
+
+test('public pages have no scripts, collection surfaces, or third-party requests', async () => {
+  for (const file of ['index.html', 'privacy-policy/index.html']) {
+    const html = await readFile(file, 'utf8');
+    assert.ok(html.includes(`content="${csp}"`), `${file}: CSP matches deployment policy`);
+    assert.match(html, /<meta name="referrer" content="no-referrer">/);
+    assert.doesNotMatch(html, /<\s*(script|form|input|textarea|iframe|object|embed)\b/i);
+    assert.doesNotMatch(html, /\son\w+\s*=|\sstyle\s*=/i);
+    assert.doesNotMatch(html, /(?:src|href|action)\s*=\s*["']\s*(?:https?:|\/\/|javascript:|data:)/i);
+    for (const [, target] of html.matchAll(/(?:src|href)="([^"]+)"/g)) {
+      if (target.startsWith('/assets/')) await stat(`.${target}`);
+    }
+  }
+  const css = await readFile('assets/styles.css', 'utf8');
+  assert.doesNotMatch(css, /@import|https?:|url\(\s*["']?\/\//i);
+  for (const [, path] of css.matchAll(/url\(['"]?(\/[^)'"\s]+)/g)) await stat(`.${path}`);
+  const photo = await readFile('assets/coffee.jpg');
+  assert.equal(photo.subarray(0, 3).toString('hex'), 'ffd8ff', 'local hero is a JPEG');
+});
+
+test('production artifacts carry the restrictive headers and contain only public files', async () => {
+  const config = JSON.parse(await readFile('vercel.json', 'utf8'));
+  assert.deepEqual(Object.fromEntries(config.headers[0].headers.map(({ key, value }) => [key, value])), headers);
+  const netlifyHeaders = await readFile('dist/_headers', 'utf8');
+  for (const [key, value] of Object.entries(headers)) assert.ok(netlifyHeaders.includes(`  ${key}: ${value}\n`));
+  assert.deepEqual((await readdir('dist')).sort(), ['_headers', 'assets', 'index.html', 'privacy-policy']);
+  for (const file of ['index.html', 'assets/styles.css', 'assets/coffee.jpg', 'privacy-policy/index.html']) {
+    assert.deepEqual(await readFile(`dist/${file}`), await readFile(file));
+  }
+});
