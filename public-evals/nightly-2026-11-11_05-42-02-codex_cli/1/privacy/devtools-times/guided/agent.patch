new file mode 100644
index 0000000..56cf785
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,22 @@
+const authBase = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/';
+
+// Keep the payload explicit: never include form metadata or browser identifiers.
+export async function submitCredentials(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<boolean> {
+  const response = await fetch(`${authBase}${action}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'no-store',
+    redirect: 'error',
+    signal: AbortSignal.timeout(15_000),
+  });
+
+  // Do not expose backend errors or retain returned tokens/profile data.
+  return response.ok;
+}
diff --git a/src/utils/privacyHeaders.ts b/src/utils/privacyHeaders.ts
new file mode 100644
index 0000000..f0f395d
--- /dev/null
+++ b/src/utils/privacyHeaders.ts
@@ -0,0 +1,17 @@
+export function applyDocumentPrivacy(response: Response, pathname: string, base: string): Response {
+  if (!response.headers.get('Content-Type')?.toLowerCase().startsWith('text/html')) {
+    return response;
+  }
+
+  response.headers.set('Referrer-Policy', 'no-referrer');
+  response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=()');
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+
+  const basePath = base.replace(/\/$/, '');
+  const documentPath = pathname.replace(/\/$/, '');
+  if (documentPath === `${basePath}/signin` || documentPath === `${basePath}/signup`) {
+    response.headers.set('Cache-Control', 'no-store');
+  }
+
+  return response;
+}
diff --git a/tests/privacy.test.mjs b/tests/privacy.test.mjs
new file mode 100644
index 0000000..4e0e281
--- /dev/null
+++ b/tests/privacy.test.mjs
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { submitCredentials } from '../src/utils/auth.ts';
+import { applyDocumentPrivacy } from '../src/utils/privacyHeaders.ts';
+
+for (const action of ['login', 'register']) {
+  test(`${action} sends only credentials without cookies, referrer, caching, or redirects`, async (t) => {
+    let calls = 0;
+    t.mock.method(globalThis, 'fetch', async (url, options) => {
+      calls++;
+      assert.equal(url, `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`);
+      assert.equal(options.method, 'POST');
+      assert.deepEqual(options.headers, { 'Content-Type': 'application/json' });
+      assert.deepEqual(JSON.parse(options.body), { username: 'demo-reader', password: 'demo-only-123' });
+      assert.equal(options.credentials, 'omit');
+      assert.equal(options.referrerPolicy, 'no-referrer');
+      assert.equal(options.cache, 'no-store');
+      assert.equal(options.redirect, 'error');
+      assert.ok(options.signal instanceof AbortSignal);
+      return { ok: true, json() { throw new Error('Response tokens must not be read'); } };
+    });
+    assert.equal(await submitCredentials(action, 'demo-reader', 'demo-only-123'), true);
+    assert.equal(calls, 1);
+  });
+}
+
+test('backend failures are reduced to a boolean without reading sensitive error details', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => ({
+    ok: false,
+    json() { throw new Error('Backend details must not be read'); },
+  }));
+  assert.equal(await submitCredentials('login', 'demo-reader', 'demo-only-123'), false);
+});
+
+test('network errors propagate to the form’s generic error handler', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => { throw new TypeError('network failure'); });
+  await assert.rejects(submitCredentials('register', 'demo-reader', 'demo-only-123'), TypeError);
+});
+
+test('HTML documents get privacy headers without altering their content or status', async () => {
+  const response = new Response('<h1>News</h1>', {
+    status: 404,
+    headers: { 'Content-Type': 'text/html; charset=utf-8', 'X-Existing': 'kept' },
+  });
+  assert.equal(applyDocumentPrivacy(response, '/devtools-times/missing', '/devtools-times/'), response);
+  assert.equal(response.headers.get('Referrer-Policy'), 'no-referrer');
+  assert.equal(response.headers.get('Permissions-Policy'), 'camera=(), microphone=(), geolocation=(), payment=(), usb=()');
+  assert.equal(response.headers.get('X-Content-Type-Options'), 'nosniff');
+  assert.equal(response.headers.get('X-Existing'), 'kept');
+  assert.equal(response.headers.get('Cache-Control'), null);
+  assert.equal(response.status, 404);
+  assert.equal(await response.text(), '<h1>News</h1>');
+});
+
+test('account documents cannot be cached, at root or under a base path, with either slash form', () => {
+  for (const base of ['/', '/devtools-times/']) {
+    for (const route of ['signin', 'signup']) {
+      for (const suffix of ['', '/']) {
+        const response = new Response('', { headers: { 'Content-Type': 'text/html', 'Cache-Control': 'public, max-age=3600' } });
+        applyDocumentPrivacy(response, `${base}${route}${suffix}`, base);
+        assert.equal(response.headers.get('Cache-Control'), 'no-store');
+      }
+    }
+  }
+});
+
+test('JSON endpoints and assets keep their existing headers', () => {
+  for (const type of ['application/json', 'text/css', 'image/svg+xml']) {
+    const response = new Response('{}', { headers: { 'Content-Type': type, 'Cache-Control': 'max-age=60' } });
+    const before = [...response.headers];
+    applyDocumentPrivacy(response, '/devtools-times/signup', '/devtools-times/');
+    assert.deepEqual([...response.headers], before);
+  }
+});
