diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..c1532ce
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,14 @@
+const accountService = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+// Credentials are sent only after form submission, without cookies or referrer data.
+export function submitCredentials(action: 'login' | 'register', username: string, password: string) {
+  return fetch(`${accountService}/${action}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'no-store',
+    redirect: 'error',
+  });
+}
diff --git a/tests/auth.test.mjs b/tests/auth.test.mjs
new file mode 100644
index 0000000..d6f7392
--- /dev/null
+++ b/tests/auth.test.mjs
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { submitCredentials } from '../src/utils/auth.ts';
+
+for (const action of ['login', 'register']) {
+  test(`${action} sends only credentials and excludes ambient browser data`, async (t) => {
+    const response = new Response(null, { status: 204 });
+    let sentRequest;
+    t.mock.method(globalThis, 'fetch', async (url, options) => {
+      sentRequest = new Request(url, options);
+      return response;
+    });
+
+    assert.equal(await submitCredentials(action, 'demo-reader', 'example-pass8'), response);
+    assert.equal(sentRequest.url, `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`);
+    assert.equal(sentRequest.method, 'POST');
+    assert.equal(sentRequest.credentials, 'omit');
+    assert.equal(sentRequest.referrerPolicy, 'no-referrer');
+    assert.equal(sentRequest.cache, 'no-store');
+    assert.equal(sentRequest.redirect, 'error');
+    assert.equal(sentRequest.headers.get('Content-Type'), 'application/json');
+    assert.equal(sentRequest.headers.has('Cookie'), false);
+    assert.equal(sentRequest.headers.has('Authorization'), false);
+    assert.equal(sentRequest.url.includes('example-pass8'), false);
+    assert.deepEqual(await sentRequest.json(), { username: 'demo-reader', password: 'example-pass8' });
+  });
+}
+
+test('network failures propagate without logging credentials or retrying', async (t) => {
+  const failure = new TypeError('Network unavailable');
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => { throw failure; });
+  const consoleMock = t.mock.method(console, 'error', () => {});
+  await assert.rejects(submitCredentials('login', 'demo-reader', 'example-pass8'), failure);
+  assert.equal(fetchMock.mock.callCount(), 1);
+  assert.equal(consoleMock.mock.callCount(), 0);
+});
