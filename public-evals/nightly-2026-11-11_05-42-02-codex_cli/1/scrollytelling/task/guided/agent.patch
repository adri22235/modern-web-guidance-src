+  <script>
+    (() => {
+      const nativeTimelines = CSS.supports('animation-timeline: view()') &&
+        CSS.supports('animation-range: 0% 100%') && CSS.supports('timeline-scope: --source');
+      if (nativeTimelines || !('IntersectionObserver' in window)) return;
+
+      const story = document.querySelector('.coffee-story');
+      const steps = [...document.querySelectorAll('#tracked > section')];
+      const visuals = [...document.querySelectorAll('#animated > section')];
+      const motion = matchMedia('(prefers-reduced-motion: reduce)');
+      let observer;
+
+      function configure() {
+        observer?.disconnect();
+        story.classList.remove('scroll-fallback');
+        visuals.forEach(visual => visual.classList.remove('is-active'));
+        if (motion.matches) return;
+
+        // Start correctly even when the page is restored midway through the story.
+        function update() {
+          const center = window.innerHeight / 2;
+          const closest = steps.reduce((best, step, index) => {
+            const bounds = step.getBoundingClientRect();
+            const distance = Math.abs((bounds.top + bounds.bottom) / 2 - center);
+            return distance < best.distance ? { index, distance } : best;
+          }, { index: 0, distance: Infinity }).index;
+          visuals.forEach((visual, index) => visual.classList.toggle('is-active', index === closest));
+        }
+
+        story.classList.add('scroll-fallback');
+        observer = new IntersectionObserver(update, {
+          rootMargin: '-40% 0px -40% 0px',
+          threshold: [0, 0.5, 1]
+        });
+        steps.forEach(step => observer.observe(step));
+        update();
+      }
+
+      motion.addEventListener('change', configure);
+      configure();
+    })();
+  </script>
