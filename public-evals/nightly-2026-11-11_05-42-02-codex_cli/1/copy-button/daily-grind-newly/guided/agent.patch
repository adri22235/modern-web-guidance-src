+  <script>
+    const copyTimers = new WeakMap();
+    let lastCopyMessage = '';
+
+    function reportCopy(button, succeeded) {
+      const status = button.nextElementSibling;
+      clearTimeout(copyTimers.get(button));
+      let message = succeeded ? 'Copied' : 'Copy failed. Please try again.';
+      if (message === lastCopyMessage) message += '\u00A0';
+      lastCopyMessage = message;
+      status.textContent = message;
+      copyTimers.set(button, setTimeout(() => {
+        status.textContent = '';
+      }, 3000));
+    }
+
+    document.addEventListener('command', async (event) => {
+      if (event.command !== '--copy' || !event.source.matches('.copy-button')) return;
+      const text = event.target.innerText.trim();
+      try {
+        await navigator.clipboard.writeText(text);
+        reportCopy(event.source, true);
+      } catch {
+        reportCopy(event.source, false);
+      }
+    }, true);
+  </script>
