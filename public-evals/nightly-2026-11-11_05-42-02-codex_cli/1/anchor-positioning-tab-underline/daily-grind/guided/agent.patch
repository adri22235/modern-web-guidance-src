     nav ul {
       display: flex;
+      align-items: center;
       list-style: none;
+      position: relative;
+    }
+
+    nav ul::before {
+      content: '';
+      position: absolute;
+      pointer-events: none;
+      inset-block-start: var(--indicator-top, 100%);
+      inset-inline-start: var(--indicator-left, 0px);
+      inset-inline-end: calc(100% - var(--indicator-left, 0px) - var(--indicator-width, 0px));
+      border-block-end: 2px solid var(--accent);
+    }
+
+    .nav-link {
+      display: inline-block;
+      padding-block: 5px;
+    }
+
+    .nav-link[aria-current="page"] {
+      anchor-name: --active-nav;
+    }
+
+    @supports (position-anchor: --active-nav) {
+      nav ul::before {
+        position-anchor: --active-nav;
+        inset-block-start: calc(anchor(bottom) + 2px);
+        inset-inline-start: anchor(left);
+        inset-inline-end: anchor(right);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul.indicator-ready::before {
+        transition: inset 0.3s ease;
+      }
     }
 
