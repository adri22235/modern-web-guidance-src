+  <script>
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+    const darkMode = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+
+    function syncThemeControl() {
+      darkMode.checked = themeMeta.content === 'dark' ||
+        (themeMeta.content === 'light dark' && systemTheme.matches);
+      darkModeState.textContent = darkMode.checked ? 'On' : 'Off';
+    }
+
+    darkMode.addEventListener('change', () => {
+      const selectedTheme = darkMode.checked ? 'dark' : 'light';
+      const deviceTheme = systemTheme.matches ? 'dark' : 'light';
+      // Choosing the device's current theme restores following the device.
+      themeMeta.content = selectedTheme === deviceTheme ? 'light dark' : selectedTheme;
+      try {
+        if (selectedTheme === deviceTheme) {
+          localStorage.removeItem('daily-grind-theme');
+        } else {
+          localStorage.setItem('daily-grind-theme', selectedTheme);
+        }
+      } catch { /* The preference still applies for this visit. */ }
+      syncThemeControl();
+    });
+
+    systemTheme.addEventListener('change', syncThemeControl);
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'daily-grind-theme' || event.key === null) {
+        themeMeta.content = event.newValue === 'dark' || event.newValue === 'light'
+          ? event.newValue : 'light dark';
+        syncThemeControl();
+      }
+    });
+
+    syncThemeControl();
+    document.querySelector('.preferences').hidden = false;
+  </script>
+
