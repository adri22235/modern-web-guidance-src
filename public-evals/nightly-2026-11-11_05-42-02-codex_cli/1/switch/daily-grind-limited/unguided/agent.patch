+  <script>
+    const darkMode = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+
+    darkMode.checked = document.documentElement.dataset.theme === 'dark';
+    darkModeState.textContent = darkMode.checked ? 'On' : 'Off';
+
+    darkMode.addEventListener('change', () => {
+      document.documentElement.dataset.theme = darkMode.checked ? 'dark' : 'light';
+      darkModeState.textContent = darkMode.checked ? 'On' : 'Off';
+      try {
+        localStorage.setItem('daily-grind-dark-mode', String(darkMode.checked));
+      } catch {
+        // The switch still works for this visit when storage is unavailable.
+      }
+    });
+  </script>
