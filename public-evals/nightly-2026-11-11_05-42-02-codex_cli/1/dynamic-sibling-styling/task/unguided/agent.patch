+  <script>
+    // Fallback for browsers without CSS sibling-index()/sibling-count().
+    // Recalculate only when collection membership changes, including new collections.
+    const collections = '.grid, .fan-container, .circle-container';
+    function updateCollections() {
+      document.querySelectorAll(collections).forEach(container => {
+        const selector = container.matches('.grid') ? '.card' : container.matches('.fan-container') ? '.fan-card' : '.circle-orb';
+        const items = [...container.children].filter(item => item.matches(selector));
+        items.forEach((item, index) => {
+          if (item.matches('.card')) item.classList.add('spectrum-card');
+          item.style.setProperty('--item-index', index);
+          item.style.setProperty('--item-count', items.length);
+        });
+      });
+    }
+    updateCollections();
+    new MutationObserver(updateCollections).observe(document.querySelector('main'), { childList: true, subtree: true });
+  </script>
