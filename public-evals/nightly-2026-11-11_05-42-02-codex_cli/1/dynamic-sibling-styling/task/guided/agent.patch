+  <script>
+    // Older browsers get the same live, collection-local calculations.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const updateSiblings = () => {
+        const parents = new Set([...document.querySelectorAll(selector)].map(item => item.parentElement));
+        parents.forEach(parent => {
+          [...parent.children].forEach((item, index) => {
+            if (!item.matches(selector)) return;
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', parent.children.length);
+          });
+        });
+      };
+      updateSiblings();
+      new MutationObserver(updateSiblings).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true
+      });
+    }
+  </script>
+
