+      padding: 16px;
+    }
+
+    .media-card {
+      display: grid;
+      grid-template-columns: 200px minmax(0, 1fr);
+      align-items: center;
+      gap: 24px;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+    }
+
+    .media-card + .media-card {
+      margin-top: 16px;
+    }
+
+    .media-card img {
+      display: block;
+      width: 200px;
+      height: 180px;
+      object-fit: cover;
+      background: var(--secondary);
+    }
+
+    .media-card-content {
+      padding: 20px 24px 20px 0;
+    }
+
+    .media-card.target {
+      scroll-initial-target: nearest;
+      outline: 2px solid var(--primary);
+      outline-offset: -2px;
+    }
+
+    .featured-label {
+      display: inline-block;
+      margin-bottom: 6px;
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.06em;
+      text-transform: uppercase;
+    }
+
+    .media-feed:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    @media (max-width: 600px) {
+      .media-card {
+        grid-template-columns: 1fr;
+        gap: 0;
+      }
+
+      .media-card img {
+        width: 100%;
+        height: 180px;
+      }
+
+      .media-card-content {
+        padding: 16px;
+      }
+    }
+
