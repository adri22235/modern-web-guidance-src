+  <script type="module">
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const controls = document.querySelector('.gallery-thumbnails');
+    const thumbnails = [...controls.querySelectorAll('.thumbnail')];
+    const status = document.getElementById('gallery-status');
+    const hasSnapChanging = 'onscrollsnapchanging' in gallery;
+    const hasSnapChange = 'onscrollsnapchange' in gallery;
+    const hasScrollEnd = 'onscrollend' in gallery;
+    let activeIndex = -1;
+    let pendingIndex = -1;
+    let navigationTarget = null;
+    let frame = null;
+    let settleTimer;
+
+    // Center geometry matches scroll-snap-align and stays local to this track.
+    function closestIndex() {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      let nearest = 0;
+      let distance = Infinity;
+      items.forEach((item, index) => {
+        const nextDistance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        if (nextDistance < distance) {
+          nearest = index;
+          distance = nextDistance;
+        }
+      });
+      return nearest;
+    }
+
+    function preview(index) {
+      if (index < 0 || index === pendingIndex) return;
+      pendingIndex = index;
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    }
+
+    function activate(index, announce = true) {
+      if (index < 0) return;
+      if (frame !== null) cancelAnimationFrame(frame);
+      frame = null;
+      navigationTarget = null;
+      pendingIndex = -1;
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+      if (announce && activeIndex !== index) {
+        status.textContent = `Photo ${index + 1} of ${items.length}: ${items[index].querySelector('figcaption').textContent}`;
+      }
+      activeIndex = index;
+    }
+
+    if (hasSnapChanging) {
+      gallery.addEventListener('scrollsnapchanging', event => {
+        preview(items.indexOf(event.snapTargetInline));
+      });
+    }
+    if (hasSnapChange) {
+      gallery.addEventListener('scrollsnapchange', event => {
+        activate(items.indexOf(event.snapTargetInline));
+      });
+    }
+
+    // Also clean up a gesture that returns to the same snap target.
+    const settle = () => activate(closestIndex());
+    if (hasScrollEnd) gallery.addEventListener('scrollend', settle);
+    gallery.addEventListener('scroll', () => {
+      if (!hasSnapChanging && navigationTarget === null && frame === null) {
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          preview(closestIndex());
+        });
+      }
+      if (!hasScrollEnd) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, 160);
+      }
+    }, { passive: true });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        const item = items[index];
+        const left = item.offsetLeft + item.offsetWidth / 2 - gallery.clientWidth / 2;
+        if (Math.abs(gallery.scrollLeft - left) < 1) {
+          activate(index);
+          return;
+        }
+        navigationTarget = index;
+        preview(index);
+        gallery.scrollTo({ left });
+      });
+    });
+
+    // Direct input can interrupt a thumbnail's smooth scroll.
+    ['pointerdown', 'wheel', 'keydown'].forEach(type => {
+      gallery.addEventListener(type, () => { navigationTarget = null; }, { passive: true });
+    });
+
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      controls.setAttribute('role', 'toolbar');
+      function syncTabStops() {
+        const focused = thumbnails.indexOf(document.activeElement);
+        thumbnails.forEach((thumbnail, index) => {
+          thumbnail.tabIndex = index === (focused < 0 ? Math.max(activeIndex, 0) : focused) ? 0 : -1;
+        });
+      }
+      controls.addEventListener('focusin', syncTabStops);
+      controls.addEventListener('keydown', event => {
+        const current = thumbnails.indexOf(document.activeElement);
+        if (current < 0 || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+        event.preventDefault();
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? thumbnails.length - 1
+          : (current + (event.key === 'ArrowRight' ? 1 : -1) + thumbnails.length) % thumbnails.length;
+        thumbnails[next].focus({ preventScroll: true });
+      });
+      syncTabStops();
+    }
+
+    // Account for restored scroll positions without announcing page load.
+    const initialize = () => activate(closestIndex(), false);
+    initialize();
+    window.addEventListener('load', initialize, { once: true });
+    window.addEventListener('pageshow', initialize);
+  </script>
