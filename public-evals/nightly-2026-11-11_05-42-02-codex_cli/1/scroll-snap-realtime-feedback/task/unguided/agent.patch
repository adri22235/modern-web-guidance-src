+  <script>
+    (() => {
+      const gallery = document.getElementById('gallery');
+      const slides = [...gallery.querySelectorAll('.gallery-item')];
+      const indicators = [...document.querySelectorAll('.gallery-indicator')];
+      const status = document.querySelector('.gallery-status');
+      const hasSnapChanging = 'onscrollsnapchanging' in gallery;
+      const hasSnapChange = 'onscrollsnapchange' in gallery;
+      const hasScrollEnd = 'onscrollend' in gallery;
+      let activeIndex = 0;
+      let settleTimer;
+      let scrollFrame;
+
+      function preview(index) {
+        indicators.forEach((button, i) => {
+          button.classList.toggle('pending', i === index);
+        });
+      }
+
+      function nearestIndex() {
+        const bounds = gallery.getBoundingClientRect();
+        const center = bounds.left + gallery.clientLeft + gallery.clientWidth / 2;
+        let nearest = 0;
+        let distance = Infinity;
+        slides.forEach((slide, i) => {
+          const rect = slide.getBoundingClientRect();
+          const delta = Math.abs(rect.left + rect.width / 2 - center);
+          if (delta < distance) {
+            nearest = i;
+            distance = delta;
+          }
+        });
+        return nearest;
+      }
+
+      function settle(index = nearestIndex()) {
+        clearTimeout(settleTimer);
+        cancelAnimationFrame(scrollFrame);
+        indicators.forEach((button, i) => {
+          button.classList.remove('pending');
+          button.classList.toggle('active', i === index);
+          if (i === index) button.setAttribute('aria-current', 'true');
+          else button.removeAttribute('aria-current');
+        });
+        if (index !== activeIndex) {
+          status.textContent = `Photo ${index + 1} of ${slides.length}: ${slides[index].querySelector('figcaption').textContent}`;
+        }
+        activeIndex = index;
+      }
+
+      function goTo(index) {
+        preview(index);
+        const target = slides[index].getBoundingClientRect();
+        const bounds = gallery.getBoundingClientRect();
+        const left = gallery.scrollLeft + target.left - bounds.left - gallery.clientLeft;
+        gallery.scrollTo({ left });
+        // Clicking the current slide produces no scroll or snap events.
+        if (Math.abs(gallery.scrollLeft - left) < 1) settle(index);
+      }
+
+      indicators.forEach((button, index) => {
+        button.addEventListener('click', () => goTo(index));
+      });
+
+      if (hasSnapChanging) {
+        gallery.addEventListener('scrollsnapchanging', (event) => {
+          const index = slides.indexOf(event.snapTargetInline);
+          if (index !== -1) preview(index);
+        });
+      }
+      if (hasSnapChange) {
+        gallery.addEventListener('scrollsnapchange', (event) => {
+          const index = slides.indexOf(event.snapTargetInline);
+          if (index !== -1) settle(index);
+        });
+      }
+
+      gallery.addEventListener('scroll', () => {
+        if (!hasSnapChanging) {
+          cancelAnimationFrame(scrollFrame);
+          scrollFrame = requestAnimationFrame(() => preview(nearestIndex()));
+        }
+        if (!hasScrollEnd) {
+          clearTimeout(settleTimer);
+          settleTimer = setTimeout(() => settle(), 180);
+        }
+      }, { passive: true });
+      if (hasScrollEnd) gallery.addEventListener('scrollend', () => settle());
+
+      gallery.addEventListener('keydown', (event) => {
+        const current = nearestIndex();
+        let target;
+        if (event.key === 'ArrowRight') target = Math.min(current + 1, slides.length - 1);
+        if (event.key === 'ArrowLeft') target = Math.max(current - 1, 0);
+        if (event.key === 'Home') target = 0;
+        if (event.key === 'End') target = slides.length - 1;
+        if (target !== undefined) {
+          event.preventDefault();
+          goTo(target);
+        }
+      });
+      window.addEventListener('resize', () => settle());
+      settle();
+    })();
+  </script>
