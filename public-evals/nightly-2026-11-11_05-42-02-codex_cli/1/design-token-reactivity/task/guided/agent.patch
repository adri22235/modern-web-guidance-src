+    #target-container {
+      --card-density: 1;
+    }
+
+    /* Resolve the inherited density on each card when its padding is computed. */
+    @function --card-padding() returns <length> {
+      result: calc(20px * var(--card-density, 1));
+    }
+
+    #toggle-spacious {
+      display: none;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--text);
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    #toggle-spacious:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @supports (padding: --card-padding()) {
+      #target-container .card {
+        padding: --card-padding();
+      }
+
+      #toggle-spacious {
+        display: inline-block;
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
