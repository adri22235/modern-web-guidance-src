+  <script>
+    const carousel = document.querySelector('.carousel');
+    const slides = Array.from(carousel.querySelectorAll('.card'));
+    const status = carousel.querySelector('.carousel-status');
+    let currentSlide = 0;
+
+    function showSlide(index) {
+      currentSlide = (index + slides.length) % slides.length;
+      slides.forEach((slide, slideIndex) => {
+        slide.hidden = slideIndex !== currentSlide;
+      });
+      status.textContent = `${currentSlide + 1} / ${slides.length} — ${slides[currentSlide].querySelector('h3').textContent}`;
+    }
+
+    carousel.querySelectorAll('[data-direction]').forEach((button) => {
+      button.addEventListener('click', () => {
+        showSlide(currentSlide + Number(button.dataset.direction));
+      });
+    });
+
+    carousel.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
+        event.preventDefault();
+        // Keep keyboard focus visible when moving away from a card's link.
+        if (slides[currentSlide].contains(document.activeElement)) carousel.focus();
+        showSlide(currentSlide + (event.key === 'ArrowRight' ? 1 : -1));
+      }
+    });
+  </script>
