+  <script type="module">
+    const carousel = document.querySelector('.carousel');
+    const track = carousel.querySelector('.carousel-track');
+    const slides = [...track.children];
+    const controls = carousel.querySelector('.carousel-controls');
+    const previous = controls.querySelector('[data-direction="previous"]');
+    const next = controls.querySelector('[data-direction="next"]');
+    const markers = carousel.querySelector('.carousel-markers');
+    const status = carousel.querySelector('[role="status"]');
+    let pendingTarget = null;
+    let settledIndex = 0;
+    let activeIndex = -1;
+    let frame = null;
+    let settleTimer;
+
+    function slideOffset(slide) {
+      return slide.getBoundingClientRect().left - track.getBoundingClientRect().left
+        + slide.offsetWidth / 2 - track.clientWidth / 2;
+    }
+
+    function nearestIndex() {
+      return slides.reduce((nearest, slide, index) =>
+        Math.abs(slideOffset(slide)) < Math.abs(slideOffset(slides[nearest])) ? index : nearest, 0);
+    }
+
+    function updateMarkers(index) {
+      if (index === activeIndex) return;
+      activeIndex = index;
+      [...markers.children].forEach((marker, i) => {
+        if (i === index) marker.setAttribute('aria-current', 'true');
+        else marker.removeAttribute('aria-current');
+      });
+    }
+
+    function goTo(index) {
+      index = Math.max(0, Math.min(index, slides.length - 1));
+      pendingTarget = index;
+      updateMarkers(index);
+      const offset = slideOffset(slides[index]);
+      if (Math.abs(offset) < 1) {
+        settle();
+        return;
+      }
+      track.scrollBy({ left: offset });
+    }
+
+    function settle() {
+      const index = nearestIndex();
+      // Ignore a stale scrollend from an earlier navigation.
+      if (pendingTarget !== null && Math.abs(slideOffset(slides[pendingTarget])) > 1) return;
+      pendingTarget = null;
+      updateMarkers(index);
+      previous.disabled = index === 0;
+      next.disabled = index === slides.length - 1;
+      if (index !== settledIndex) {
+        status.textContent = `Slide ${index + 1} of ${slides.length}: ${slides[index].querySelector('h3').textContent}`;
+        settledIndex = index;
+      }
+    }
+
+    slides.forEach((slide, index) => {
+      const marker = document.createElement('button');
+      marker.type = 'button';
+      marker.setAttribute('aria-label', `Show ${slide.querySelector('h3').textContent}`);
+      marker.setAttribute('aria-controls', track.id);
+      marker.addEventListener('click', () => goTo(index));
+      markers.append(marker);
+    });
+
+    previous.addEventListener('click', () => goTo((pendingTarget ?? nearestIndex()) - 1));
+    next.addEventListener('click', () => goTo((pendingTarget ?? nearestIndex()) + 1));
+
+    // Direct scrolling supersedes a pending button navigation.
+    ['pointerdown', 'wheel', 'keydown'].forEach(type => {
+      track.addEventListener(type, () => { pendingTarget = null; }, { passive: true });
+    });
+
+    const hasScrollEnd = 'onscrollend' in track;
+    track.addEventListener('scroll', () => {
+      if (pendingTarget === null && frame === null) {
+        frame = requestAnimationFrame(() => {
+          if (pendingTarget === null) updateMarkers(nearestIndex());
+          frame = null;
+        });
+      }
+      if (!hasScrollEnd) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, 150);
+      }
+    }, { passive: true });
+    if (hasScrollEnd) track.addEventListener('scrollend', settle);
+
+    controls.hidden = false;
+    markers.hidden = false;
+    settle();
+  </script>
