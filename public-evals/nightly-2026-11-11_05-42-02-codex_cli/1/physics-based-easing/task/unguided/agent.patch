       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .card.spring,
+    .card.bounce {
+      transition: transform 220ms ease-out, box-shadow 220ms ease-out;
+    }
+
+    .card.spring {
+      --card-motion: spring;
+    }
+
+    .card.bounce {
+      --card-motion: bounce;
+    }
+
+    .card.spring:focus-within,
+    .card.bounce:focus-within {
+      animation: var(--card-motion) 650ms both;
+      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
+    }
+
+    @media (hover: hover) and (pointer: fine) {
+      .card.spring:hover,
+      .card.bounce:hover {
+        animation: var(--card-motion) 650ms both;
+        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.14);
+      }
+    }
+
+    @keyframes spring {
+      0% { transform: scale(1); animation-timing-function: ease-out; }
+      45% { transform: scale(1.07); animation-timing-function: ease-in-out; }
+      70% { transform: scale(1.025); animation-timing-function: ease-in-out; }
+      85% { transform: scale(1.045); animation-timing-function: ease-in-out; }
+      100% { transform: scale(1.04); }
+    }
+
+    @keyframes bounce {
+      0% { transform: translateY(0); animation-timing-function: ease-out; }
+      35% { transform: translateY(-10px); animation-timing-function: ease-in; }
+      55% { transform: translateY(0); animation-timing-function: ease-out; }
+      75% { transform: translateY(-4px); animation-timing-function: ease-in; }
+      100% { transform: translateY(0); }
+    }
+
+    .card .btn:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        animation: none !important;
+        transition: none;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
