+
+        const selector = link.dataset.scrollTarget || link.getAttribute('href');
+        let target;
+        try {
+          target = document.getElementById(decodeURIComponent(selector.replace(/^#/, '')));
+        } catch {
+          return;
+        }
+        if (!target) return;
+
+        event.preventDefault();
+        cancelScroll();
+        highlight?.cancel();
+
+        const navHeight = document.querySelector('nav').getBoundingClientRect().height;
+        const top = Math.max(0, Math.min(
+          window.scrollY + target.getBoundingClientRect().top - navHeight - 16,
+          document.documentElement.scrollHeight - window.innerHeight
+        ));
+        let frame;
+        let lastPosition = window.scrollY;
+        let stableSince = performance.now();
+        const startedAt = stableSince;
+
+        const cancel = () => {
+          cancelAnimationFrame(frame);
+          window.removeEventListener('wheel', cancel);
+          window.removeEventListener('touchstart', cancel);
+          window.removeEventListener('pointerdown', cancel);
+          window.removeEventListener('keydown', onKeydown);
+        };
+        const onKeydown = (event) => {
+          if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(event.key)) cancel();
+        };
+        cancelScroll = cancel;
+        window.addEventListener('wheel', cancel, { passive: true });
+        window.addEventListener('touchstart', cancel, { passive: true });
+        window.addEventListener('pointerdown', cancel, { passive: true });
+        window.addEventListener('keydown', onKeydown);
+
+        const checkScroll = (now) => {
+          const position = window.scrollY;
+          if (position !== lastPosition) {
+            lastPosition = position;
+            stableSince = now;
+          }
+          // Wait for arrival AND a stable viewport, including in browsers without scrollend.
+          if (Math.abs(position - top) <= 1 && now - stableSince >= 160 && now - startedAt >= 160) {
