+  <script>
+    let currentScrollId = 0;
+    const navigation = document.querySelector('nav');
+
+    async function scrollToSection(target) {
+      const top = Math.max(0, Math.min(
+        target.getBoundingClientRect().top + window.scrollY - navigation.offsetHeight - 16,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      // Install the fallback before scrolling so even instant scrolls are observed.
+      let idleTimer;
+      let finish;
+      const settled = new Promise((resolve) => {
+        finish = () => {
+          clearTimeout(idleTimer);
+          window.removeEventListener('scroll', onScroll);
+          window.removeEventListener('scrollend', finish);
+          resolve();
+        };
+        function onScroll() {
+          clearTimeout(idleTimer);
+          idleTimer = setTimeout(finish, 100);
+        }
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', finish);
+      });
+
+      try {
+        // Window.scrollTo avoids the root-scroller scrollIntoView promise bug.
+        const result = window.scrollTo({
+          top,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
+            ? 'instant' : 'smooth'
+        });
+        if (result && typeof result.then === 'function') {
+          await result;
+        } else {
+          // Also resolves when already at the destination and no events fire.
+          idleTimer = setTimeout(finish, 100);
+          await settled;
+        }
+      } finally {
+        finish();
+      }
+    }
+
+    navigation.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const target = document.getElementById(link.hash.slice(1));
+      if (!target) return;
+
+      event.preventDefault();
+      const scrollId = ++currentScrollId;
+      document.querySelectorAll('.section-arrived').forEach((section) => {
+        section.classList.remove('section-arrived');
+      });
+
+      await scrollToSection(target);
+      if (scrollId !== currentScrollId) return;
+
+      if (window.location.hash !== link.hash) history.pushState(null, '', link.hash);
+      target.focus({ preventScroll: true });
+      target.classList.add('section-arrived');
+    });
+
+    document.querySelector('main').addEventListener('animationend', (event) => {
+      if (event.animationName === 'section-arrival') {
+        event.target.classList.remove('section-arrived');
+      }
+    });
+  </script>
+
