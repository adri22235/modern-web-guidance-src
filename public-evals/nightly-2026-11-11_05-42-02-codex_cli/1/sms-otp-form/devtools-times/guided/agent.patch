--- /dev/null
+++ b/tests/phone-verification.test.ts
@@ -0,0 +1,81 @@
+import { afterEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { challengeAvailable, createChallenge, formatSms, matchesCode, normalizePhone, sendSms, CODE_LIFETIME, MAX_ATTEMPTS } from '../src/lib/phone-verification.ts';
+
+test('normalizes international numbers without guessing a country', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), '+12025550123');
+  assert.equal(normalizePhone('+44 7700 900123'), '+447700900123');
+  for (const invalid of ['2025550123', '+0123456789', '+12', '+1234567890123456', '+1e2025550123', null, 123]) {
+    assert.equal(normalizePhone(invalid), null);
+  }
+});
+
+test('stores a salted digest, not the code, with a five-minute expiry', () => {
+  const { code, challenge } = createChallenge('+12025550123', 1000);
+  assert.match(code, /^[0-9]{6}$/);
+  assert.equal(challenge.expiresAt, 1000 + CODE_LIFETIME);
+  assert.equal(challenge.attempts, 0);
+  assert.equal(matchesCode(challenge, code), true);
+  assert.equal(matchesCode(challenge, code === '000000' ? '999999' : '000000'), false);
+  assert.equal('code' in challenge, false);
+  assert.notEqual(createChallenge(challenge.phone).challenge.salt, challenge.salt);
+});
+
+test('preserves leading zeros and rejects malformed codes', () => {
+  const { challenge } = createChallenge('+12025550123');
+  challenge.digest = createHash('sha256').update(`${challenge.salt}:012345`).digest('hex');
+  assert.equal(matchesCode(challenge, '012345'), true);
+  for (const invalid of ['12345', '0123456', ' 012345', '12a345', '１２３４５６']) {
+    assert.equal(matchesCode(challenge, invalid), false);
+  }
+});
+
+test('rejects expired, exhausted, absent, and phone-mismatched challenges', () => {
+  const { challenge } = createChallenge('+12025550123', 1000);
+  assert.equal(challengeAvailable(challenge, challenge.phone, 1001), true);
+  assert.equal(challengeAvailable(challenge, challenge.phone, challenge.expiresAt), false);
+  assert.equal(challengeAvailable({ ...challenge, attempts: MAX_ATTEMPTS }, challenge.phone, 1001), false);
+  assert.equal(challengeAvailable(challenge, '+447700900123', 1001), false);
+  assert.equal(challengeAvailable(undefined, challenge.phone, 1001), false);
+});
+
+test('SMS ends with exactly the origin-bound domain and code', () => {
+  const sms = formatSms('news.example.com', '012345');
+  assert.ok(sms.startsWith('Your DevTools Times verification code is 012345.'));
+  assert.equal(sms.split('\n').at(-1), '@news.example.com #012345');
+});
+
+const originalFetch = globalThis.fetch;
+const originalEnv = { ...process.env };
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  for (const key of ['TWILIO_ACCOUNT_SID', 'TWILIO_AUTH_TOKEN', 'TWILIO_FROM_NUMBER']) {
+    if (originalEnv[key] === undefined) delete process.env[key];
+    else process.env[key] = originalEnv[key];
+  }
+});
+
+test('delivery fails closed when SMS credentials are missing', async () => {
+  delete process.env.TWILIO_ACCOUNT_SID;
+  globalThis.fetch = async () => { throw new Error('Network must not be called'); };
+  await assert.rejects(sendSms('+12025550123', 'news.example.com', '012345'), /not configured/);
+});
+
+test('sends an encoded, domain-bound message and surfaces provider failures', async () => {
+  process.env.TWILIO_ACCOUNT_SID = 'ACtest';
+  process.env.TWILIO_AUTH_TOKEN = 'test-token';
+  process.env.TWILIO_FROM_NUMBER = '+12025550000';
+  globalThis.fetch = async (url, options) => {
+    assert.equal(url, 'https://api.twilio.com/2010-04-01/Accounts/ACtest/Messages.json');
+    assert.equal(options?.method, 'POST');
+    const body = options?.body as URLSearchParams;
+    assert.equal(body.get('To'), '+12025550123');
+    assert.equal(body.get('From'), '+12025550000');
+    assert.equal(body.get('Body')?.split('\n').at(-1), '@news.example.com #012345');
+    return new Response('{}', { status: 201 });
+  };
+  await sendSms('+12025550123', 'news.example.com', '012345');
+  globalThis.fetch = async () => new Response('{}', { status: 400 });
+  await assert.rejects(sendSms('+12025550123', 'news.example.com', '012345'), /delivery failed/);
+});
