diff --git a/src/lib/phone-verification.ts b/src/lib/phone-verification.ts
new file mode 100644
index 0000000..cc924d3
--- /dev/null
+++ b/src/lib/phone-verification.ts
@@ -0,0 +1,63 @@
+import { createHash, randomBytes, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LIFETIME = 5 * 60_000;
+export const RESEND_DELAY = 60_000;
+export const MAX_ATTEMPTS = 5;
+
+export interface PhoneChallenge {
+  phone: string;
+  salt: string;
+  digest: string;
+  expiresAt: number;
+  attempts: number;
+}
+
+export function normalizePhone(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const phone = value.replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(phone) ? phone : null;
+}
+
+function hashCode(salt: string, code: string) {
+  return createHash('sha256').update(`${salt}:${code}`).digest('hex');
+}
+
+export function createChallenge(phone: string, now = Date.now()) {
+  const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+  const salt = randomBytes(32).toString('hex');
+  const challenge: PhoneChallenge = {
+    phone, salt, digest: hashCode(salt, code),
+    expiresAt: now + CODE_LIFETIME, attempts: 0,
+  };
+  return { code, challenge };
+}
+
+export function matchesCode(challenge: PhoneChallenge, code: string) {
+  return /^[0-9]{6}$/.test(code) && timingSafeEqual(
+    Buffer.from(challenge.digest, 'hex'),
+    Buffer.from(hashCode(challenge.salt, code), 'hex'),
+  );
+}
+
+export function challengeAvailable(challenge: PhoneChallenge | undefined, phone: string | null, now = Date.now()): challenge is PhoneChallenge {
+  return !!challenge && challenge.phone === phone && challenge.expiresAt > now && challenge.attempts < MAX_ATTEMPTS;
+}
+
+export function formatSms(hostname: string, code: string) {
+  return `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${hostname} #${code}`;
+}
+
+export async function sendSms(phone: string, hostname: string, code: string) {
+  const { TWILIO_ACCOUNT_SID: sid, TWILIO_AUTH_TOKEN: token, TWILIO_FROM_NUMBER: from } = process.env;
+  if (!sid || !token || !from) throw new Error('SMS service is not configured.');
+  const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams({ To: phone, From: from, Body: formatSms(hostname, code) }),
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (!response.ok) throw new Error('SMS delivery failed.');
+}
