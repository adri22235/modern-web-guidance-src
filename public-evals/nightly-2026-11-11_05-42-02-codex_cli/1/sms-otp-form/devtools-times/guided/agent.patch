+import type { APIRoute } from 'astro';
+import { challengeAvailable, createChallenge, matchesCode, normalizePhone, sendSms, MAX_ATTEMPTS, RESEND_DELAY } from '../../lib/phone-verification';
+
+const REGISTER_URL = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+function json(data: object, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  // This app disables Astro's global origin check; protect this mutation explicitly.
+  if (request.headers.get('Origin') !== url.origin) {
+    return json({ error: 'Please submit the form from this website.' }, 403);
+  }
+  if (!session) return json({ error: 'Sign-up is temporarily unavailable.' }, 503);
+
+  let body;
+  try { body = await request.json(); } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+
+  if (body.action === 'send') {
+    const phone = normalizePhone(body.phone);
+    if (!phone) return json({ error: 'Enter a phone number with its country code, such as +1 202 555 0123.' }, 400);
+    if (!process.env.TWILIO_ACCOUNT_SID || !process.env.TWILIO_AUTH_TOKEN || !process.env.TWILIO_FROM_NUMBER) {
+      return json({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+    }
+    const now = Date.now();
+    const previous = await session.get('signupSends');
+    const sends = previous && previous.resetAt > now ? previous : { count: 0, nextAt: 0, resetAt: now + 3_600_000 };
+    if (now < sends.nextAt || sends.count >= 5) {
+      const retryAfter = Math.ceil(((sends.count >= 5 ? sends.resetAt : sends.nextAt) - now) / 1000);
+      return json({ error: `Please wait ${retryAfter} seconds before requesting another code.`, retryAfter }, 429);
+    }
+    // Reserve the send before contacting the provider, including failed delivery attempts.
+    await session.set('signupSends', { ...sends, count: sends.count + 1, nextAt: now + RESEND_DELAY });
+    await session.delete('signupChallenge');
+    const { challenge, code } = createChallenge(phone, now);
+    try {
+      await sendSms(phone, url.hostname, code);
+      await session.set('signupChallenge', challenge);
+      return json({ phone, retryAfter: RESEND_DELAY / 1000 });
+    } catch {
+      return json({ error: 'We could not send the SMS. Please wait a minute and try again.' }, 502);
+    }
+  }
+
+  if (body.action !== 'register') return json({ error: 'Unknown action.' }, 400);
+  const { username, password, code } = body;
+  if (typeof username !== 'string' || !username.trim() || username.length > 100 ||
+      typeof password !== 'string' || password.length < 8 || password.length > 256 || !/[0-9]/.test(password)) {
+    return json({ error: 'Enter a username and a password of at least 8 characters containing a number.' }, 400);
+  }
+  const challenge = await session.get('signupChallenge');
+  if (!challengeAvailable(challenge, normalizePhone(body.phone))) {
+    return json({ error: 'Your code expired or is no longer available. Request a new code.', codeUnavailable: true }, 400);
+  }
+  const updated = { ...challenge, attempts: challenge.attempts + 1 };
+  await session.set('signupChallenge', updated);
+  if (typeof code !== 'string' || !matchesCode(challenge, code)) {
+    const remaining = MAX_ATTEMPTS - updated.attempts;
+    return json({ error: remaining ? `That code is incorrect. ${remaining} attempts remaining.` : 'Too many incorrect attempts. Request a new code.', codeUnavailable: remaining === 0 }, 400);
+  }
+
+  // Consume the code before registering. Never trust a browser's "verified" flag.
+  await session.delete('signupChallenge');
+  try {
+    const response = await fetch(REGISTER_URL, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) {
+      return json({ error: 'Registration failed. Your username may already be taken. Request a new code to try again.', codeUnavailable: true }, 400);
+    }
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Registration could not be confirmed. Try signing in, or request a new code to try again.', codeUnavailable: true }, 502);
+  }
+};
diff --git a/tests/phone-verification.test.ts b/tests/phone-verification.test.ts
