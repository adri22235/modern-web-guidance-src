+import { after, beforeEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { POST } from '../src/pages/api/signup.ts';
+import { extractOTP, normalizePhoneNumber } from '../src/utils/signup.ts';
+
+const keys = ['TWILIO_ACCOUNT_SID', 'TWILIO_AUTH_TOKEN', 'TWILIO_VERIFY_SERVICE_SID'];
+const originalEnv = keys.map((key) => process.env[key]);
+beforeEach(() => keys.forEach((key) => { process.env[key] = 'test-only'; }));
+after(() => keys.forEach((key, i) => {
+  if (originalEnv[i] === undefined) delete process.env[key];
+  else process.env[key] = originalEnv[i];
+}));
+
+const phone = '+12025550123';
+const details = { action: 'register', username: 'reader', password: 'password1', phone, code: '123456' };
+const pending = () => ({ phone, sentAt: Date.now() - 61_000, expiresAt: Date.now() + 600_000, attempts: 0, verified: false });
+function context(body, challenge, origin = 'https://example.com') {
+  const values = new Map(challenge ? [['signupChallenge', challenge]] : []);
+  return {
+    request: new Request('https://example.com/devtools-times/api/signup', {
+      method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    }),
+    session: {
+      get: async (key) => values.get(key),
+      set: async (key, value) => { values.set(key, structuredClone(value)); },
+      delete: async (key) => { values.delete(key); },
+    },
+  };
+}
+function mockProvider(t, responses) {
+  const calls = [];
+  t.mock.method(globalThis, 'fetch', async (url, options) => {
+    calls.push({ url, options });
+    const next = responses.shift();
+    assert.ok(next, 'Unexpected external request');
+    if (next instanceof Error) throw next;
+    return Response.json(next.body, { status: next.status ?? 200 });
+  });
+  return calls;
+}
