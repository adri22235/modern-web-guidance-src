index 0000000..07e00e2
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,117 @@
+import type { APIRoute } from 'astro';
+import { normalizePhoneNumber } from '../../utils/signup.ts';
+
+type Challenge = {
+  phone: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+  verified: boolean;
+};
+
+const reply = (body: object, status = 200) => Response.json(body, {
+  status,
+  headers: { 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request, session }) => {
+  // This endpoint uses a session cookie; do not accept cross-origin submissions.
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return reply({ error: 'Please submit this form from this website.' }, 403);
+  }
+  if (!session) return reply({ error: 'Sign-up is temporarily unavailable.' }, 503);
+
+  let body;
+  try {
+    body = await request.json();
+    if (!body || typeof body !== 'object') throw new Error();
+  } catch {
+    return reply({ error: 'Invalid request.' }, 400);
+  }
+  const phone = typeof body.phone === 'string' ? normalizePhoneNumber(body.phone) : null;
+  if (!phone) return reply({ error: 'Enter a valid phone number including its country code.' }, 400);
+  if (body.action !== 'send' && body.action !== 'register') {
+    return reply({ error: 'Invalid request.' }, 400);
+  }
+
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) {
+    return reply({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+  }
+  const verify = async (resource: string, parameters: Record<string, string>) => {
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(service)}/${resource}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams(parameters),
+      signal: AbortSignal.timeout(15_000),
+    });
+    return { response, data: await response.json() };
+  };
+
+  const challenge = await session.get('signupChallenge') as Challenge | undefined;
+  const now = Date.now();
+  try {
+    if (body.action === 'send') {
+      const retryAfter = challenge ? Math.ceil((challenge.sentAt + 60_000 - now) / 1000) : 0;
+      if (retryAfter > 0) return reply({ error: 'Please wait before requesting another code.', retryAfter }, 429);
+      // Persist the cooldown before contacting the provider, including on delivery failures.
+      await session.set('signupChallenge', {
+        phone, sentAt: now, expiresAt: now, attempts: 0, verified: false,
+      });
+      const { response, data } = await verify('Verifications', { To: phone, Channel: 'sms' });
+      if (!response.ok || data.status !== 'pending') {
+        return reply({ error: 'We could not send a code. Check your number and try again in a minute.', retryAfter: 60 }, response.status === 429 ? 429 : 502);
+      }
+      await session.set('signupChallenge', {
+        phone, sentAt: now, expiresAt: now + 10 * 60_000, attempts: 0, verified: false,
+      });
+      return reply({ retryAfter: 60 });
+    }
+
+    if (typeof body.username !== 'string' || !body.username.trim() ||
+        typeof body.password !== 'string' || body.password.length < 8 || !/\d/.test(body.password)) {
+      return reply({ error: 'Enter a username and a password of at least 8 characters containing a number.' }, 400);
+    }
+    if (!challenge || challenge.phone !== phone || challenge.expiresAt <= now) {
+      return reply({ error: 'Your code has expired. Request a new code.', code: 'expired' }, 400);
+    }
+    if (typeof body.code !== 'string' || !/^\d{6}$/.test(body.code)) {
+      return reply({ error: 'Enter the six-digit code from your text message.' }, 400);
+    }
+    if (!challenge.verified) {
+      if (challenge.attempts >= 5) return reply({ error: 'Too many attempts. Request a new code.', code: 'expired' }, 429);
+      challenge.attempts += 1;
+      await session.set('signupChallenge', challenge);
+      const { response, data } = await verify('VerificationCheck', { To: phone, Code: body.code });
+      if (response.status === 404) {
+        challenge.expiresAt = now;
+        await session.set('signupChallenge', challenge);
+        return reply({ error: 'Your code has expired. Request a new code.', code: 'expired' }, 400);
+      }
+      if (!response.ok || data.status !== 'approved') {
+        return reply({ error: 'That code could not be verified. Check it and try again.' }, 400);
+      }
+      challenge.verified = true;
+      await session.set('signupChallenge', challenge);
+    }
+
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password, phoneNumber: phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) {
+      return reply({ error: 'Registration failed. Try another username or try again later. Your phone verification is saved for this session.' }, 502);
+    }
+    await session.delete('signupChallenge');
+    return reply({ success: true });
+  } catch {
+    return reply({ error: 'Unable to connect. Please try again. If you requested a code, wait a minute before resending.' }, 502);
+  }
+};
