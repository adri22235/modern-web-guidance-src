+test('normalizes international phones and rejects missing country codes or invalid characters', () => {
+  assert.equal(normalizePhoneNumber(' +1 (202) 555-0123 '), phone);
+  for (const value of ['2025550123', '+0123456789', '+123', '+1234567890123456', '+1abc2025550123']) {
+    assert.equal(normalizePhoneNumber(value), null);
+  }
+});
+
+test('extracts pasted and origin-bound codes without losing leading zeros', () => {
+  for (const value of ['012345', '012 345', '012-345', 'Your code is 012345.', 'Your code is 999999.\n@example.com #012345']) {
+    assert.equal(extractOTP(value), '012345');
+  }
+  assert.equal(extractOTP('012'), '012');
+  assert.equal(extractOTP('1234567'), '');
+});
+
+test('rejects cross-origin submissions before contacting providers', async (t) => {
+  const calls = mockProvider(t, []);
+  assert.equal((await POST(context(details, pending(), 'https://other.com'))).status, 403);
+  assert.equal(calls.length, 0);
+});
+
+test('fails closed when SMS credentials are absent', async (t) => {
+  const calls = mockProvider(t, []);
+  delete process.env.TWILIO_AUTH_TOKEN;
+  assert.equal((await POST(context({ action: 'send', phone }))).status, 503);
+  assert.equal(calls.length, 0);
+});
+
+test('sends an SMS and stores a session-bound challenge', async (t) => {
+  const calls = mockProvider(t, [{ body: { status: 'pending' } }]);
+  const ctx = context({ action: 'send', phone: '+1 (202) 555-0123' });
+  const response = await POST(ctx);
+  assert.equal(response.status, 200);
+  assert.equal((await response.json()).retryAfter, 60);
+  assert.equal(calls[0].options.body.get('To'), phone);
+  assert.equal(calls[0].options.body.get('Channel'), 'sms');
+  assert.equal((await ctx.session.get('signupChallenge')).verified, false);
+});
+
+test('enforces resend cooldown even when changing the number', async (t) => {
+  const calls = mockProvider(t, []);
+  const response = await POST(context({ action: 'send', phone: '+442079460123' }, { ...pending(), sentAt: Date.now() }));
+  assert.equal(response.status, 429);
+  assert.ok((await response.json()).retryAfter > 0);
+  assert.equal(calls.length, 0);
+});
+
+test('does not register with no challenge, an expired code, a different phone, or invalid input', async (t) => {
+  const calls = mockProvider(t, []);
+  for (const challenge of [undefined, { ...pending(), expiresAt: 0 }, { ...pending(), phone: '+442079460123' }]) {
+    assert.equal((await POST(context(details, challenge))).status, 400);
+  }
+  assert.equal((await POST(context({ ...details, code: '123' }, pending()))).status, 400);
+  assert.equal((await POST(context({ ...details, password: 'weak' }, pending()))).status, 400);
+  assert.equal(calls.length, 0);
+});
+
+test('rejects incorrect codes and limits verification attempts', async (t) => {
+  const calls = mockProvider(t, [{ body: { status: 'pending' } }]);
+  const ctx = context(details, pending());
+  assert.equal((await POST(ctx)).status, 400);
+  assert.equal((await ctx.session.get('signupChallenge')).attempts, 1);
+  assert.equal((await POST(context(details, { ...pending(), attempts: 5 }))).status, 429);
+  assert.equal(calls.length, 1);
+});
+
+test('handles provider-expired verification codes', async (t) => {
+  mockProvider(t, [{ status: 404, body: {} }]);
+  const ctx = context(details, pending());
+  const response = await POST(ctx);
+  assert.equal(response.status, 400);
+  assert.equal((await response.json()).code, 'expired');
+  assert.ok((await ctx.session.get('signupChallenge')).expiresAt <= Date.now());
+});
+
+test('registers only after approval and consumes verification', async (t) => {
+  const calls = mockProvider(t, [{ body: { status: 'approved' } }, { body: { success: true } }]);
+  const ctx = context(details, pending());
+  assert.equal((await POST(ctx)).status, 200);
+  assert.ok(calls[0].url.endsWith('/VerificationCheck'));
+  assert.equal(calls[0].options.body.get('Code'), '123456');
+  assert.deepEqual(JSON.parse(calls[1].options.body), { username: 'reader', password: 'password1', phoneNumber: phone });
+  assert.equal(await ctx.session.get('signupChallenge'), undefined);
+  assert.equal((await POST(context(details))).status, 400);
+});
+
+test('preserves approval for registration retries without rechecking a consumed SMS code', async (t) => {
+  const calls = mockProvider(t, [{ body: { status: 'approved' } }, { status: 500, body: {} }, { body: { success: true } }]);
+  const ctx = context(details, pending());
+  assert.equal((await POST(ctx)).status, 502);
+  assert.equal((await ctx.session.get('signupChallenge')).verified, true);
+  const retry = { ...ctx, request: context(details).request };
+  assert.equal((await POST(retry)).status, 200);
+  assert.equal(calls.filter((call) => call.url.endsWith('/VerificationCheck')).length, 1);
+});
