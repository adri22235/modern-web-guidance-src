+test('retains cooldown after provider delivery or network failure', async (t) => {
+  mockProvider(t, [new Error('offline')]);
+  const ctx = context({ action: 'send', phone });
+  assert.equal((await POST(ctx)).status, 502);
+  assert.ok((await ctx.session.get('signupChallenge')).sentAt > 0);
+  assert.equal((await POST({ ...ctx, request: context({ action: 'send', phone }).request })).status, 429);
+});
