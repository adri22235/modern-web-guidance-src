new file mode 100644
index 0000000..4c41f98
--- /dev/null
+++ b/src/utils/signup.ts
@@ -0,0 +1,14 @@
+/** Accept familiar formatting, but require an explicit international country code. */
+export function normalizePhoneNumber(value: string): string | null {
+  const normalized = value.trim().replace(/[\s().-]/g, '');
+  return /^\+[1-9]\d{7,14}$/.test(normalized) ? normalized : null;
+}
+
+/** Handles both pasted codes and complete, origin-bound SMS messages. */
+export function extractOTP(value: string): string {
+  const boundCode = value.match(/#(\d{6})\b/);
+  if (boundCode) return boundCode[1];
+  const digits = value.trim().replace(/[\s-]/g, '');
+  if (/^\d{0,6}$/.test(digits)) return digits;
+  return value.match(/\b\d{6}\b/)?.[0] ?? '';
+}
