new file mode 100644
index 0000000..f1cc981
--- /dev/null
+++ b/verification.js
@@ -0,0 +1,215 @@
+(() => {
+  'use strict';
+  const phoneForm = document.querySelector('#phone-form');
+  const otpForm = document.querySelector('#otp-form');
+  const phone = document.querySelector('#phone');
+  const code = document.querySelector('#otp');
+  const sendButton = document.querySelector('#send-button');
+  const verifyButton = document.querySelector('#verify-button');
+  const resendButton = document.querySelector('#resend-button');
+  const error = document.querySelector('#form-error');
+  const status = document.querySelector('#form-status');
+  let challengeId = null;
+  let verifiedPhone = '';
+  let smsController = null;
+  let cooldownTimer = null;
+  let cooldownUntil = 0;
+  let busy = false;
+
+  function stopListening() {
+    smsController?.abort();
+    smsController = null;
+  }
+
+  function clearMessages() {
+    error.textContent = '';
+    status.textContent = '';
+  }
+
+  async function listenForSms() {
+    stopListening();
+    if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController();
+    smsController = controller;
+    const timeout = setTimeout(() => controller.abort(), 120000);
+    try {
+      const credential = await navigator.credentials.get({otp: {transport: ['sms']}, signal: controller.signal});
+      if (controller.signal.aborted || otpForm.hidden || !credential || !/^[0-9]{6}$/.test(credential.code)) return;
+      code.value = credential.code;
+      code.setCustomValidity('');
+      code.removeAttribute('aria-invalid');
+      otpForm.requestSubmit();
+    } catch {
+      // User dismissal, unavailable SMS access, or timeout: manual entry stays available.
+    } finally {
+      clearTimeout(timeout);
+      if (smsController === controller) smsController = null;
+    }
+  }
+
+  async function post(url, payload) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch(url, {
+        method: 'POST', credentials: 'same-origin',
+        headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
+        body: JSON.stringify(payload), signal: controller.signal
+      });
+      if (!response.headers.get('content-type')?.includes('application/json')) {
+        throw new Error('Text verification is unavailable right now. Please try again later.');
+      }
+      const data = await response.json();
+      if (!response.ok) {
+        if (response.status === 429) throw new Error('Too many attempts. Please wait a few minutes and try again.');
+        if (response.status === 400 || response.status === 401 || response.status === 410) {
+          throw new Error(url === otpForm.action || url === '/api/auth/verify-code'
+            ? 'That code is incorrect or has expired. Try again or request a new code.'
+            : 'We couldn’t send a code to that number. Check the number and try again.');
+        }
+        throw new Error('Text verification is unavailable right now. Please try again later.');
+      }
+      return data;
+    } catch (failure) {
+      if (failure.name === 'AbortError') throw new Error('The request timed out. Please try again.');
+      if (failure instanceof TypeError) throw new Error('Couldn’t connect. Check your connection and try again.');
+      throw failure;
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  function purpose() {
+    return document.querySelector('input[name="purpose"]:checked').value;
+  }
+
+  function startCooldown(seconds = 30) {
+    clearInterval(cooldownTimer);
+    cooldownUntil = Date.now() + seconds * 1000;
+    const update = () => {
+      const remaining = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+      resendButton.disabled = remaining > 0 || busy;
+      resendButton.textContent = remaining > 0 ? `Resend in ${remaining}s` : 'Resend code';
+      if (!remaining) clearInterval(cooldownTimer);
+    };
+    update();
+    cooldownTimer = setInterval(update, 1000);
+  }
+
+  function setBusy(value) {
+    busy = value;
+    sendButton.disabled = value;
+    verifyButton.disabled = value;
+    resendButton.disabled = value || Date.now() < cooldownUntil;
+    document.querySelector('#change-number').disabled = value;
+    phoneForm.setAttribute('aria-busy', String(value));
+    otpForm.setAttribute('aria-busy', String(value));
+  }
+
+  async function requestCode(isResend = false) {
+    if (busy) return;
+    clearMessages();
+    stopListening();
+    setBusy(true);
+    sendButton.textContent = 'Sending code…';
+    try {
+      const data = await post(phoneForm.action, {phone: verifiedPhone, purpose: purpose()});
+      if (typeof data.challengeId !== 'string' || !data.challengeId) {
+        throw new Error('Text verification is unavailable right now. Please try again later.');
+      }
+      challengeId = data.challengeId;
+      phoneForm.hidden = true;
+      otpForm.hidden = false;
+      document.querySelector('#phone-step').removeAttribute('aria-current');
+      document.querySelector('#code-step').setAttribute('aria-current', 'step');
+      document.querySelector('#sent-to').textContent = `Code sent to ${verifiedPhone}`;
+      code.value = '';
+      code.setCustomValidity('');
+      code.removeAttribute('aria-invalid');
+      startCooldown();
+      status.textContent = isResend ? 'A new code is on its way. Use the most recent text message.' : 'Code sent. Your device may offer to fill it in automatically.';
+      code.focus();
+      listenForSms();
+    } catch (failure) {
+      error.textContent = failure.message;
+    } finally {
+      setBusy(false);
+      sendButton.innerHTML = 'Send verification code <span aria-hidden="true">→</span>';
+    }
+  }
+
+  phone.addEventListener('input', () => {
+    phone.setCustomValidity('');
+    phone.removeAttribute('aria-invalid');
+    error.textContent = '';
+  });
+  phoneForm.addEventListener('submit', event => {
+    event.preventDefault();
+    const digits = phone.value.replace(/\D/g, '');
+    const national = digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
+    if (!/^[2-9][0-9]{9}$/.test(national)) {
+      phone.setCustomValidity('Enter a valid 10-digit US mobile number, including the area code.');
+      phone.setAttribute('aria-invalid', 'true');
+      phone.reportValidity();
+      return;
+    }
+    verifiedPhone = `+1${national}`;
+    requestCode();
+  });
+
+  code.addEventListener('input', () => {
+    code.setCustomValidity('');
+    code.removeAttribute('aria-invalid');
+    error.textContent = '';
+  });
+  code.addEventListener('invalid', () => {
+    code.setCustomValidity('Enter the complete 6-digit code from your text message.');
+    code.setAttribute('aria-invalid', 'true');
+  });
+  otpForm.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy || !challengeId) return;
+    stopListening();
+    clearMessages();
+    setBusy(true);
+    verifyButton.textContent = 'Verifying…';
+    try {
+      const data = await post(otpForm.action, {challengeId, code: code.value, purpose: purpose()});
+      if (data.verified !== true) throw new Error('That code is incorrect or has expired. Try again or request a new code.');
+      clearInterval(cooldownTimer);
+      status.textContent = 'You’re signed in. Taking you to your next good thing…';
+      // Authentication must be established by the server using a secure session cookie.
+      window.location.assign(purpose() === 'order' ? '/order-online' : '/rewards');
+    } catch (failure) {
+      error.textContent = failure.message;
+      code.setAttribute('aria-invalid', 'true');
+      code.focus();
+    } finally {
+      setBusy(false);
+      verifyButton.innerHTML = 'Verify &amp; continue <span aria-hidden="true">→</span>';
+    }
+  });
+  resendButton.addEventListener('click', () => requestCode(true));
+  document.querySelector('#change-number').addEventListener('click', () => {
+    stopListening();
+    clearInterval(cooldownTimer);
+    challengeId = null;
+    code.value = '';
+    otpForm.hidden = true;
+    phoneForm.hidden = false;
+    clearMessages();
+    document.querySelector('#code-step').removeAttribute('aria-current');
+    document.querySelector('#phone-step').setAttribute('aria-current', 'step');
+    phone.focus();
+  });
+  document.querySelectorAll('[data-purpose]').forEach(link => {
+    link.addEventListener('click', () => {
+      document.querySelector(`#purpose-${link.dataset.purpose}`).checked = true;
+      (otpForm.hidden ? phone : code).focus({preventScroll: true});
+    });
+  });
+  window.addEventListener('pagehide', () => {
+    stopListening();
+    clearInterval(cooldownTimer);
+  });
+})();
