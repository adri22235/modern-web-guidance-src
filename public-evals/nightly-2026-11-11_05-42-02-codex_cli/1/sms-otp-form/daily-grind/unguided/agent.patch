+(() => {
+  'use strict';
+  const phoneForm = document.querySelector('#phone-form');
+  const codeForm = document.querySelector('#code-form');
+  const phoneInput = document.querySelector('#phone');
+  const codeInput = document.querySelector('#code');
+  const resendButton = document.querySelector('#resend');
+  let purpose = 'rewards';
+  let phone = '';
+  let challengeId = '';
+  let otpController;
+  let cooldownTimer;
+  let busy = false;
+
+  function message(target, text, error = false) {
+    const element = document.querySelector(`#${target}-message`);
+    element.textContent = text;
+    element.classList.toggle('error', error);
+    document.querySelector(`#${target}`).setAttribute('aria-invalid', String(error));
+  }
+
+  function stopListening() {
+    otpController?.abort();
+    otpController = undefined;
+  }
+
+  function listenForCode() {
+    stopListening();
+    if (!('OTPCredential' in window) || !window.isSecureContext || !navigator.credentials) return;
+    const controller = new AbortController();
+    otpController = controller;
+    const timeout = setTimeout(() => controller.abort(), 120000);
+    navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal })
+      .then(credential => {
+        if (credential && !controller.signal.aborted && !codeForm.hidden) {
+          codeInput.value = credential.code;
+          message('code', 'Code filled from your text message. Select Verify & continue.');
+          codeInput.focus();
+        }
+      })
+      .catch(() => { /* Manual entry and platform autofill remain available. */ })
+      .finally(() => clearTimeout(timeout));
+  }
+
+  async function request(path, body) {
+    // The server must rate-limit requests, bind challenges to a session, and verify
+    // expiry and single use. Never generate or validate authentication codes here.
+    const response = await fetch(path, {
+      method: 'POST', credentials: 'same-origin',
+      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+      body: JSON.stringify(body), signal: AbortSignal.timeout(15000)
+    });
+    const data = await response.json().catch(() => null);
+    if (!response.ok || !data) {
+      if (response.status === 429) throw new Error('Too many attempts. Please wait a few minutes and try again.');
+      throw new Error(path.endsWith('verify-code')
+        ? 'We couldn’t verify that code. Check the code and try again, or request a new one.'
+        : 'We couldn’t send a code right now. Please try again shortly.');
+    }
+    return data;
+  }
+
+  function setBusy(form, value) {
+    busy = value;
+    form.querySelectorAll('button').forEach(button => { button.disabled = value; });
+    form.setAttribute('aria-busy', String(value));
+    document.querySelectorAll('[data-mode]').forEach(button => { button.disabled = value; });
+  }
+
+  function startCooldown() {
+    clearInterval(cooldownTimer);
+    let seconds = 30;
+    resendButton.disabled = true;
+    resendButton.textContent = `Resend in ${seconds}s`;
+    cooldownTimer = setInterval(() => {
+      seconds -= 1;
+      resendButton.textContent = seconds ? `Resend in ${seconds}s` : 'Resend code';
+      if (!seconds) { clearInterval(cooldownTimer); resendButton.disabled = false; }
+    }, 1000);
+  }
+
+  function resetFlow() {
+    stopListening();
+    clearInterval(cooldownTimer);
+    challengeId = '';
+    codeInput.value = '';
+    codeForm.hidden = true;
+    phoneForm.hidden = false;
+    resendButton.textContent = 'Resend code';
+    resendButton.disabled = false;
+    message('code', '');
+  }
+
+  function selectPurpose(next) {
+    if (busy) return;
+    if (purpose !== next) resetFlow();
+    purpose = next;
+    document.querySelectorAll('[data-mode]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mode === purpose)));
+    document.querySelector('#signin-title').innerHTML = purpose === 'order' ? 'Your next coffee,<br>just a little closer.' : 'Your daily ritual,<br>rewarded.';
+    document.querySelector('#panel-description').textContent = purpose === 'order'
+      ? 'Sign in with your mobile number to order ahead, skip the wait, and get to the good part.'
+      : 'Sign in or join to earn points, find your favorites, and make your next coffee a little sweeter.';
+  }
+
+  document.querySelectorAll('[data-mode]').forEach(button => button.addEventListener('click', () => selectPurpose(button.dataset.mode)));
+  document.querySelectorAll('[data-purpose]').forEach(link => link.addEventListener('click', () => {
+    selectPurpose(link.dataset.purpose);
+    if (!busy) (codeForm.hidden ? phoneInput : codeInput).focus({ preventScroll: true });
+  }));
+
+  phoneForm.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    let digits = phoneInput.value.replace(/\D/g, '');
+    if (digits.length === 11 && digits.startsWith('1')) digits = digits.slice(1);
+    if (!/^[2-9]\d{2}[2-9]\d{6}$/.test(digits)) {
+      message('phone', 'Enter a valid 10-digit US mobile number, including the area code.', true);
+      phoneInput.focus();
+      return;
+    }
+    phone = `+1${digits}`;
+    setBusy(phoneForm, true);
+    message('phone', 'Sending your verification code…');
+    try {
+      const data = await request('/api/auth/send-code', { phone, purpose });
+      if (!data.challengeId) throw new Error('We couldn’t send a code right now. Please try again shortly.');
+      challengeId = data.challengeId;
+      document.querySelector('#destination').textContent = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
+      phoneForm.hidden = true;
+      codeForm.hidden = false;
+      message('phone', '');
+      message('code', 'Code sent. It expires in 5 minutes.');
+      codeInput.focus();
+      startCooldown();
+      listenForCode();
+    } catch (error) {
+      message('phone', error.name === 'TimeoutError' ? 'The request timed out. Please try again.' : error instanceof TypeError ? 'Unable to connect. Check your connection and try again.' : error.message, true);
+    } finally { setBusy(phoneForm, false); }
+  });
+
+  codeInput.addEventListener('input', () => {
+    codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, 6);
+    if (codeInput.getAttribute('aria-invalid') === 'true') message('code', '');
+  });
+  phoneInput.addEventListener('input', () => { if (phoneInput.getAttribute('aria-invalid') === 'true') message('phone', ''); });
+  document.querySelector('#change-phone').addEventListener('click', () => { resetFlow(); phoneInput.focus(); });
+
+  resendButton.addEventListener('click', async () => {
+    if (busy) return;
+    stopListening();
+    setBusy(codeForm, true);
+    message('code', 'Sending a new code…');
+    let sent = false;
+    try {
+      const data = await request('/api/auth/send-code', { phone, purpose });
+      if (!data.challengeId) throw new Error('We couldn’t resend the code. Please try again.');
+      challengeId = data.challengeId;
+      codeInput.value = '';
+      message('code', 'A new code is on its way. Use the most recent text.');
+      sent = true;
+      listenForCode();
+      codeInput.focus();
+    } catch (error) { message('code', 'We couldn’t resend the code. Please try again shortly.', true); }
+    finally {
+      setBusy(codeForm, false);
+      if (sent) startCooldown();
+    }
+  });
+
+  codeForm.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (busy) return;
+    if (!/^\d{6}$/.test(codeInput.value)) {
+      message('code', 'Enter all 6 digits from your text message.', true);
+      codeInput.focus();
+      return;
+    }
+    stopListening();
+    clearInterval(cooldownTimer);
+    setBusy(codeForm, true);
+    message('code', 'Verifying your code…');
+    try {
+      const data = await request('/api/auth/verify-code', { challengeId, code: codeInput.value, purpose });
+      if (data.verified !== true) throw new Error('That code is incorrect or has expired. Try again or request a new code.');
+      message('code', 'You’re verified! Taking you to your next good thing…');
+      window.location.assign(purpose === 'order' ? '/order-online' : '/rewards');
+    } catch (error) {
+      message('code', error instanceof TypeError ? 'Unable to connect. Check your connection and try again.' : error.message, true);
+      setBusy(codeForm, false);
+      resendButton.textContent = 'Resend code';
+      codeInput.focus();
+    }
+  });
+  window.addEventListener('pagehide', () => { stopListening(); clearInterval(cooldownTimer); });
+})();
