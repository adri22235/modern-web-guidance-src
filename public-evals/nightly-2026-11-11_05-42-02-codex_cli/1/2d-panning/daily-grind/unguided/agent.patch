+  <script>
+    const viewport = document.querySelector('.map-viewport');
+    const markers = [...document.querySelectorAll('.cafe-marker')];
+    let gesture = null;
+    let suppressClick = false;
+
+    function resetMap() {
+      viewport.scrollLeft = 790 - viewport.clientWidth / 2;
+      viewport.scrollTop = 650 - viewport.clientHeight / 2;
+    }
+
+    viewport.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0 || gesture) return;
+      suppressClick = false;
+      gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, moved: false };
+      // Capture on the original target so a stationary marker press still clicks it.
+      event.target.setPointerCapture(event.pointerId);
+      viewport.classList.add('is-dragging');
+    });
+
+    viewport.addEventListener('pointermove', (event) => {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      const dx = event.clientX - gesture.x;
+      const dy = event.clientY - gesture.y;
+      if (!gesture.moved && Math.hypot(dx, dy) < 4) return;
+      gesture.moved = true;
+      // Apply both components on every event, with no axis selection or lock.
+      viewport.scrollLeft -= dx;
+      viewport.scrollTop -= dy;
+      gesture.x = event.clientX;
+      gesture.y = event.clientY;
+    });
+
+    function endGesture(event) {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      suppressClick = gesture.moved;
+      gesture = null;
+      viewport.classList.remove('is-dragging');
+    }
+    viewport.addEventListener('pointerup', endGesture);
+    viewport.addEventListener('pointercancel', endGesture);
+    viewport.addEventListener('lostpointercapture', endGesture);
+    viewport.addEventListener('dragstart', (event) => event.preventDefault());
+    viewport.addEventListener('click', (event) => {
+      if (suppressClick && event.detail !== 0) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        suppressClick = false;
+      }
+    }, true);
+
+    viewport.addEventListener('wheel', (event) => {
+      if (event.ctrlKey) return; // Preserve browser pinch-to-zoom.
+      event.preventDefault();
+      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewport.clientHeight : 1;
+      viewport.scrollLeft += (event.shiftKey && !event.deltaX ? event.deltaY : event.deltaX) * unit;
+      viewport.scrollTop += (event.shiftKey && !event.deltaX ? 0 : event.deltaY) * unit;
+    }, { passive: false });
+
+    markers.forEach((marker) => marker.addEventListener('click', () => {
+      markers.forEach((item) => item.setAttribute('aria-pressed', String(item === marker)));
+      document.querySelector('#cafe-name').textContent = 'The Daily Grind · ' + marker.dataset.name;
+      document.querySelector('#cafe-description').textContent = marker.dataset.description;
+      document.querySelector('#cafe-tag').textContent = marker.dataset.tag;
+    }));
+    document.querySelector('.map-reset').addEventListener('click', resetMap);
+    resetMap();
+  </script>
