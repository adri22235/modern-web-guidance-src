+      animation: reveal-line 800ms ease both;
+    }
+
+    .card h3 .text-line {
+      --line-color: #a66b36;
+      --line-offset: 0.18em;
+      --line-inset: 0.18em;
+    }
+
+    .card h3 .text-line::after { animation-delay: 150ms; }
+    .card:nth-child(2) h3 .text-line::after { animation-delay: 300ms; }
+    .card:nth-child(3) h3 .text-line::after { animation-delay: 450ms; }
+
+    @keyframes reveal-line {
+      from {
+        clip-path: inset(-0.5em calc(100% - var(--line-inset)) -0.5em var(--line-inset));
+      }
+      to {
+        clip-path: inset(-0.5em var(--line-inset) -0.5em var(--line-inset));
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .text-line::after {
+        animation: none !important;
+        transition: none !important;
+      }
+    }
