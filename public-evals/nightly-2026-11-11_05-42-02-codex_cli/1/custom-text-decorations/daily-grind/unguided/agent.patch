+    /* Keep the glyphs still while a native, ink-skipping underline reveals. */
+    .text-line {
+      --line-offset: 0.22em;
+      --line-inset: 0.06em;
+      --line-color: var(--accent);
+      --line-thickness: 0.08em;
+      position: relative;
+      display: inline-block;
+    }
+
+    .text-line::after {
+      content: attr(data-line-text) / "";
+      position: absolute;
+      inset: 0;
+      color: transparent;
+      pointer-events: none;
+      text-decoration-line: underline;
+      text-decoration-color: var(--line-color);
+      text-decoration-thickness: var(--line-thickness);
+      text-underline-offset: var(--line-offset);
+      text-decoration-skip-ink: auto;
+      clip-path: inset(-0.5em var(--line-inset) -0.5em var(--line-inset));
+    }
+
+    nav a .text-line::after,
+    .footer-links a .text-line::after {
+      clip-path: inset(-0.5em calc(100% - var(--line-inset)) -0.5em var(--line-inset));
+      transition: clip-path 360ms ease;
+    }
+
+    nav a:is(:hover, :focus-visible) .text-line::after,
+    .footer-links a:is(:hover, :focus-visible) .text-line::after {
+      clip-path: inset(-0.5em var(--line-inset) -0.5em var(--line-inset));
+    }
+
+    a:focus-visible {
