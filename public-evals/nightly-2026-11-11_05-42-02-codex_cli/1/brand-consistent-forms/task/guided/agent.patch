+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-preference');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const storageKey = 'daily-grind-subscription-preferences';
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-value').value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--fill', `${(Number(roast.value) - 1) * 25}%`);
+      const complete = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      progress.value = complete;
+      progress.textContent = `${Math.round(complete / 3 * 100)}%`;
+      document.getElementById('setup-count').textContent = `${complete} of 3 details complete`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        for (const radio of form.querySelectorAll('input[name="frequency"]')) {
+          radio.checked = radio.value === saved.frequency;
+        }
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        document.getElementById('subscription-emails').checked = saved.emailUpdates === true;
+      }
+    } catch {
+      // Storage may be unavailable or contain an older preference format.
+    }
+
+    form.addEventListener('input', () => {
+      updateSetup();
+      status.textContent = '';
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(form);
+      try {
+        localStorage.setItem(storageKey, JSON.stringify({
+          email: data.get('email'),
+          frequency: data.get('frequency'),
+          roast: Number(data.get('roast')),
+          emailUpdates: data.has('email_updates')
+        }));
+        status.textContent = `Preferences saved in this browser: ${roastNames[Number(roast.value) - 1]} roast, delivered ${data.get('frequency')}. No subscription has been started.`;
+      } catch {
+        status.textContent = 'This browser couldn’t save your preferences. Please allow browser storage and try again.';
+      }
+    });
+    updateSetup();
+    document.getElementById('save-preferences').disabled = false;
+  </script>
 </body>
 
