+  <script>
+    const form = document.getElementById('subscription-form');
+    const nameInput = document.getElementById('subscriber-name');
+    const emailInput = document.getElementById('subscriber-email');
+    const roast = document.getElementById('roast-level');
+    const roastDescription = document.getElementById('roast-description');
+    const progress = document.getElementById('setup-progress');
+    const progressText = document.getElementById('progress-text');
+    const saveStatus = document.getElementById('save-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updatePlan() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastDescription.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      const ready = Number(Boolean(nameInput.value.trim()))
+        + Number(Boolean(emailInput.value) && emailInput.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked')))
+        + 1; // The medium roast default is ready to use.
+      progress.value = ready;
+      progress.textContent = `${ready * 25}%`;
+      progressText.textContent = `${ready} of 4 details ready · ${ready * 25}%`;
+    }
+
+    form.addEventListener('input', () => {
+      nameInput.setCustomValidity(nameInput.value && !nameInput.value.trim() ? 'Please enter your name.' : '');
+      saveStatus.textContent = '';
+      updatePlan();
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      const plan = {
+        name: nameInput.value.trim(),
+        email: emailInput.value,
+        frequency: form.querySelector('input[name="frequency"]:checked').value,
+        roast: roast.value,
+        receiveEmails: document.getElementById('receive-emails').checked
+      };
+      try {
+        localStorage.setItem('daily-grind-coffee-plan', JSON.stringify(plan));
+        saveStatus.textContent = `Your coffee plan is saved in this browser, ${plan.name}. No order has been placed.`;
+      } catch {
+        saveStatus.textContent = 'Your browser could not save this plan. Your selections are still available here; please allow local storage and try again.';
+      }
+    });
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-coffee-plan'));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.name === 'string') nameInput.value = saved.name;
+        if (typeof saved.email === 'string') emailInput.value = saved.email;
+        for (const radio of form.querySelectorAll('input[name="frequency"]')) radio.checked = radio.value === saved.frequency;
+        if (['1', '2', '3', '4', '5'].includes(saved.roast)) roast.value = saved.roast;
+        document.getElementById('receive-emails').checked = saved.receiveEmails === true;
+      }
+    } catch { /* The form also works when browser storage is unavailable. */ }
+    updatePlan();
+  </script>
 </body>
 
