+  <script>
+    const list = document.querySelector('#list-page');
+    const detail = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const cards = [...document.querySelectorAll('.thumbnail')];
+    const extras = {
+      'maple-oat-latte': ['Our smooth espresso meets velvety oat milk and a touch of Vermont maple syrup. A gently sweet companion for slow mornings and crisp afternoons.', 'Mellow espresso · Maple sweetness · Creamy oat milk'],
+      'dark-roast-espresso': ['A deeply roasted espresso with a full body and a lingering finish. Savor a small cup with bold character, crafted to bring a little warmth to your daily ritual.', 'Full-bodied · Toasted notes · Rich finish'],
+      'cold-brew': ['Time makes all the difference. Steeped for 18 hours, our cold brew is smooth and refreshing, with a rounded flavor that shines over ice.', 'Slow-steeped · Smooth body · Refreshing finish']
+    };
+    let activeCard = null;
+    let listScroll = 0;
+    let currentTransition = null;
+    let openedFromList = false;
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    function cardFromURL() {
+      return cards.find(card => '#' + card.dataset.coffee === location.hash) || null;
+    }
+
+    function show(card, moveFocus = true) {
+      currentTransition?.skipTransition();
+      // Clear names before assigning the one selected pair.
+      document.querySelectorAll('[style*="view-transition-name"]').forEach(el => {
+        el.style.viewTransitionName = '';
+      });
+      const sharedCard = card || activeCard;
+      const image = sharedCard?.querySelector('img');
+      const heading = sharedCard?.querySelector('.title');
+      if (card && !activeCard) listScroll = window.scrollY;
+      if (image) image.style.viewTransitionName = 'coffee-image';
+      if (heading) heading.style.viewTransitionName = 'coffee-title';
+      hero.style.viewTransitionName = 'coffee-image';
+      title.style.viewTransitionName = 'coffee-title';
+
+      const update = () => {
+        if (card) {
+          const photo = card.querySelector('img');
+          hero.src = photo.src;
+          hero.alt = photo.alt;
+          title.textContent = card.querySelector('.title').textContent;
+          document.querySelector('#description').textContent = extras[card.dataset.coffee][0];
+          document.querySelector('#tasting-notes').textContent = extras[card.dataset.coffee][1];
+        }
+        list.hidden = Boolean(card);
+        detail.hidden = !card;
+        document.title = card ? title.textContent + ' | The Daily Grind' : 'The Daily Grind | Artisanal Coffee';
+        activeCard = card;
+        if (moveFocus) {
+          if (card) {
+            window.scrollTo(0, document.querySelector('main').offsetTop - document.querySelector('nav').offsetHeight - 24);
+            title.focus({ preventScroll: true });
+          } else {
+            window.scrollTo(0, listScroll);
+            (sharedCard?.querySelector('a') || document.querySelector('#list-heading')).focus({ preventScroll: true });
+          }
+        }
+      };
+      if (document.startViewTransition && !reducedMotion.matches && moveFocus) {
+        const transition = document.startViewTransition(update);
+        currentTransition = transition;
+        transition.finished.catch(() => {}).finally(() => {
+          if (currentTransition === transition) currentTransition = null;
+        });
+      } else {
+        update();
+      }
+    }
+
+    list.addEventListener('click', event => {
+      const link = event.target.closest('.title a');
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      event.preventDefault();
+      const card = link.closest('.thumbnail');
+      history.pushState(null, '', link.hash);
+      openedFromList = true;
+      show(card);
+    });
+    document.querySelector('#back').addEventListener('click', () => {
+      if (openedFromList) {
+        history.back();
+      } else {
+        history.replaceState(null, '', location.pathname + location.search);
+        show(null);
+      }
+    });
+    window.addEventListener('popstate', () => {
+      show(cardFromURL());
+      openedFromList = false;
+    });
+    show(cardFromURL(), false);
+  </script>
 </body>
 
