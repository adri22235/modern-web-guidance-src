+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const homeHero = document.querySelector('#home-hero');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const descriptions = {
+      maple: 'A little comfort in every sip. Our Maple Oat Latte pairs rich espresso with silky steamed oat milk and a hint of Vermont maple syrup. Gently sweet, wonderfully creamy, and made for slow mornings.',
+      espresso: 'Small cup. Bold character. Our dark roast brings deep, smoky notes and a rich crema to a carefully pulled espresso. Enjoy it slowly or make it your morning boost.',
+      'cold-brew': 'Good things take time. Steeped for 18 hours, our Cold Brew is mellow, full-bodied, and exceptionally smooth. Served over ice for a refreshing finish.'
+    };
+    let selectedCard;
+    let listScroll = 0;
+    let navigating = false;
+
+    async function navigate(update, focusTarget, cleanup = () => {}) {
+      navigating = true;
+      const commit = () => {
+        update();
+        // Move focus as soon as the old view becomes hidden.
+        focusTarget.focus({ preventScroll: true });
+      };
+      try {
+        if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          const transition = document.startViewTransition(commit);
+          // A skipped animation still commits the accessible navigation.
+          await transition.finished.catch(() => {});
+        } else {
+          commit();
+        }
+      } finally {
+        cleanup();
+        navigating = false;
+      }
+    }
+
+    listPage.addEventListener('click', (event) => {
+      const card = event.target.closest('.thumbnail');
+      if (!card || navigating) return;
+      selectedCard = card;
+      listScroll = window.scrollY;
+      card.classList.add('selected');
+      const image = card.querySelector('img');
+      hero.src = image.src;
+      hero.alt = image.alt;
+      title.textContent = card.querySelector('.title').textContent;
+      document.querySelector('#description').textContent = descriptions[card.dataset.drink];
+      // Decode the shared image before capturing the new state.
+      navigating = true;
+      hero.decode().catch(() => {}).then(() => navigate(() => {
+        listPage.hidden = true;
+        homeHero.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo({ top: 0, behavior: 'instant' });
+      }, title));
+    });
+
+    document.querySelector('#back').addEventListener('click', () => {
+      if (navigating || !selectedCard) return;
+      navigate(() => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        homeHero.hidden = false;
+        window.scrollTo({ top: listScroll, behavior: 'instant' });
+      }, document.querySelector('#list-heading'), () => {
+        selectedCard.classList.remove('selected');
+      });
+    });
+  </script>
