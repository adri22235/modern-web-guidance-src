+  <script>
+    const faq = document.getElementById('coffee-faq');
+    const faqTriggers = faq.querySelectorAll('.faq-trigger');
+
+    function setFaqExpanded(trigger, expanded) {
+      const panel = document.getElementById(trigger.getAttribute('aria-controls'));
+      trigger.setAttribute('aria-expanded', String(expanded));
+      panel.classList.toggle('is-open', expanded);
+      panel.setAttribute('aria-hidden', String(!expanded));
+      panel.inert = !expanded;
+    }
+
+    faqTriggers.forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const shouldOpen = trigger.getAttribute('aria-expanded') !== 'true';
+        faqTriggers.forEach((item) => setFaqExpanded(item, item === trigger && shouldOpen));
+      });
+    });
+  </script>
