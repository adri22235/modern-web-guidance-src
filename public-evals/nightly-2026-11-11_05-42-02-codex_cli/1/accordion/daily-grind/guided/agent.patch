+  <script>
+    (() => {
+      const triggers = [...document.querySelectorAll('#coffee-faq .faq-trigger')];
+      const animations = new Map();
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      function setExpanded(trigger, expanded) {
+        const panel = document.getElementById(trigger.getAttribute('aria-controls'));
+        // Capture the current rendered size before cancelling to support rapid reversals.
+        const startHeight = panel.getBoundingClientRect().height;
+        animations.get(panel)?.cancel();
+        animations.delete(panel);
+        trigger.setAttribute('aria-expanded', String(expanded));
+        if (!expanded && panel.contains(document.activeElement)) trigger.focus();
+        panel.inert = !expanded;
+        panel.hidden = false;
+
+        const finish = () => {
+          panel.hidden = !expanded;
+          animations.delete(panel);
+        };
+
+        if (reducedMotion.matches || !panel.animate) {
+          finish();
+          return;
+        }
+
+        const animation = panel.animate(
+          [{ height: `${startHeight}px` }, { height: `${expanded ? panel.scrollHeight : 0}px` }],
+          { duration: 300, easing: 'ease-in-out' }
+        );
+        animations.set(panel, animation);
+        animation.onfinish = finish;
+      }
+
+      for (const trigger of triggers) {
+        const panel = document.getElementById(trigger.getAttribute('aria-controls'));
+        // Leave every answer readable when JavaScript is unavailable.
+        trigger.setAttribute('aria-expanded', 'false');
+        panel.hidden = true;
+        panel.inert = true;
+
+        trigger.addEventListener('click', () => {
+          const expanded = trigger.getAttribute('aria-expanded') !== 'true';
+          for (const other of triggers) {
+            if (other !== trigger && other.getAttribute('aria-expanded') === 'true') {
+              setExpanded(other, false);
+            }
+          }
+          setExpanded(trigger, expanded);
+        });
+      }
+    })();
+  </script>
