+  <script>
+    const carousel = document.querySelector('.seasonal-carousel');
+    const cards = Array.from(carousel.querySelectorAll('.card'));
+    const position = document.getElementById('seasonal-position');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let activeIndex = 0;
+    let slideAnimation;
+
+    carousel.querySelectorAll('button[data-direction]').forEach((button) => {
+      button.addEventListener('click', () => {
+        const direction = Number(button.dataset.direction);
+        slideAnimation?.cancel();
+        cards[activeIndex].hidden = true;
+        activeIndex = (activeIndex + direction + cards.length) % cards.length;
+        const activeCard = cards[activeIndex];
+        activeCard.hidden = false;
+        position.textContent = `${activeIndex + 1} / ${cards.length}`;
+
+        if (!reducedMotion.matches) {
+          slideAnimation = activeCard.animate(
+            [
+              { transform: `translateX(${direction * 100}%)` },
+              { transform: 'translateX(0)' }
+            ],
+            { duration: 350, easing: 'ease-out' }
+          );
+        }
+      });
+    });
+  </script>
