+  <script type="module">
+    const track = document.querySelector('#seasonal-track');
+    const slides = [...track.children];
+    const previous = document.querySelector('#seasonal-previous');
+    const next = document.querySelector('#seasonal-next');
+    const status = document.querySelector('#seasonal-status');
+    let current = 0;
+    let pending = null;
+
+    const position = (slide) =>
+      slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
+
+    function sync() {
+      // Ignore completion from an interrupted scroll until the latest target lands.
+      if (pending !== null && Math.abs(track.scrollLeft - position(slides[pending])) > 1) return;
+      const index = slides.reduce((nearest, slide, candidate) =>
+        Math.abs(position(slide) - track.scrollLeft) <
+        Math.abs(position(slides[nearest]) - track.scrollLeft) ? candidate : nearest, 0);
+      pending = null;
+      previous.disabled = index === 0;
+      next.disabled = index === slides.length - 1;
+      slides.forEach((slide, candidate) => { slide.inert = candidate !== index; });
+      if (index !== current) {
+        current = index;
+        status.textContent = `${index + 1} of ${slides.length}`;
+      }
+    }
+
+    function step(direction) {
+      pending = Math.max(0, Math.min(slides.length - 1, (pending ?? current) + direction));
+      track.scrollTo({ left: position(slides[pending]) });
+      // Instant scrolling (including reduced motion) may not emit scrollend.
+      if (Math.abs(track.scrollLeft - position(slides[pending])) <= 1) sync();
+    }
+
+    previous.addEventListener('click', () => step(-1));
+    next.addEventListener('click', () => step(1));
+    // Native touch or keyboard input takes over from a pending button scroll.
+    for (const event of ['pointerdown', 'wheel', 'keydown']) {
+      track.addEventListener(event, () => { pending = null; }, { passive: true });
+    }
+    if ('onscrollend' in track) {
+      track.addEventListener('scrollend', sync);
+    } else {
+      let timer;
+      track.addEventListener('scroll', () => {
+        clearTimeout(timer);
+        timer = setTimeout(sync, 150);
+      }, { passive: true });
+    }
+    sync();
+    document.querySelector('.carousel-controls').hidden = false;
+  </script>
+
