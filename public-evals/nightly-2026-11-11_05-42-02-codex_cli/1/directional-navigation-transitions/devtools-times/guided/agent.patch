index 0000000..f9e46ea
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,178 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-carousel class="block bg-white border-b border-gray-300">
+    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4" aria-label="Top Stories" aria-roledescription="carousel">
+        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
+            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-900">Top Stories</h2>
+            <div data-controls hidden class="items-center gap-2">
+                <button type="button" data-previous class="carousel-button">&larr; Previous</button>
+                <button type="button" data-next class="carousel-button">Next &rarr;</button>
+            </div>
+        </div>
+        <div class="carousel-track" tabindex="0" role="group" aria-label="Stories">
+            {articles.map((article, index) => (
+                <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                    </a>
+                    <time datetime={article.data.date.toISOString()} class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</time>
+                </div>
+            ))}
+        </div>
+        <nav data-markers hidden class="items-center justify-center gap-2 mt-3" aria-label="Choose a top story">
+            {articles.map((article, index) => (
+                <button type="button" data-marker={index} class="carousel-marker" aria-label={`Go to story ${index + 1}: ${article.data.title}`} aria-current={index === 0 ? 'true' : undefined}>
+                    <span aria-hidden="true">{index + 1}</span>
+                </button>
+            ))}
+        </nav>
+        <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-status></p>
+    </section>
+</top-stories-carousel>
+
+<style>
+    [data-controls]:not([hidden]), [data-markers]:not([hidden]) {
+        display: flex;
+    }
+
+    .carousel-track {
+        display: flex;
+        overflow-x: auto;
+        scroll-snap-type: x mandatory;
+        touch-action: manipulation;
+        scrollbar-width: thin;
+    }
+
+    .carousel-slide {
+        flex: 0 0 100%;
+        min-width: 0;
+        padding: 0.25rem;
+        scroll-snap-align: center;
+        overflow-wrap: anywhere;
+    }
+
+    .carousel-button, .carousel-marker {
+        border: 1px solid var(--color-gray-300);
+        border-radius: 0.25rem;
+        color: var(--color-gray-900);
+        background: white;
+        cursor: pointer;
+        touch-action: manipulation;
+        font-size: 0.875rem;
+        min-height: 2.5rem;
+    }
+
+    .carousel-button { padding: 0.5rem 0.75rem; }
+    .carousel-marker { min-width: 2.5rem; }
+    .carousel-button:hover:enabled, .carousel-marker:hover { background: var(--color-amber-100); }
+    .carousel-marker[aria-current="true"] { background: var(--color-amber-400); border-color: var(--color-amber-400); }
+    .carousel-button:disabled { opacity: 0.4; cursor: default; }
+
+    .carousel-track:focus-visible, button:focus-visible, a:focus-visible {
+        outline: 2px solid var(--color-gray-900);
+        outline-offset: 2px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+        .carousel-track { scroll-behavior: smooth; }
+    }
+</style>
+
+<script>
+    class TopStoriesCarousel extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const track = this.querySelector<HTMLElement>('.carousel-track')!;
+            const slides = Array.from(this.querySelectorAll<HTMLElement>('.carousel-slide'));
+            const previous = this.querySelector<HTMLButtonElement>('[data-previous]')!;
+            const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
+            const markers = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-marker]'));
+            const status = this.querySelector<HTMLElement>('[data-status]')!;
+            if (!slides.length) return;
+
+            let pending: number | null = null;
+            let settled = 0;
+            let frame = 0;
+            let timer: ReturnType<typeof setTimeout>;
+
+            const offset = (slide: HTMLElement) => {
+                const bounds = track.getBoundingClientRect();
+                const slideBounds = slide.getBoundingClientRect();
+                return slideBounds.left + slideBounds.width / 2 - bounds.left - track.clientWidth / 2;
+            };
+            const currentIndex = () => slides.reduce((nearest, slide, index) =>
+                Math.abs(offset(slide)) < Math.abs(offset(slides[nearest])) ? index : nearest, 0);
+            const mark = (index: number) => {
+                markers.forEach((marker, i) => {
+                    if (i === index) marker.setAttribute('aria-current', 'true');
+                    else marker.removeAttribute('aria-current');
+                });
+            };
+            const updateButtons = (index: number) => {
+                previous.disabled = index === 0;
+                next.disabled = index === slides.length - 1;
+            };
+            const settle = () => {
+                const index = currentIndex();
+                // A previous scroll can finish just after another click starts a new one.
+                if (pending !== null && Math.abs(offset(slides[pending])) > 1) return;
+                pending = null;
+                mark(index);
+                updateButtons(index);
+                if (index !== settled) {
+                    status.textContent = `Story ${index + 1} of ${slides.length}: ${slides[index].querySelector('h3')!.textContent}`;
+                    settled = index;
+                }
+            };
+            const goTo = (index: number) => {
+                index = Math.max(0, Math.min(slides.length - 1, index));
+                pending = index;
+                mark(index);
+                updateButtons(index);
+                // Scroll the track only; positive offsets bring the next story in from the right.
+                track.scrollBy({ left: offset(slides[index]) });
+                if (Math.abs(offset(slides[index])) <= 1) settle();
+            };
+
+            previous.addEventListener('click', () => goTo((pending ?? currentIndex()) - 1));
+            next.addEventListener('click', () => goTo((pending ?? currentIndex()) + 1));
+            markers.forEach((marker, index) => marker.addEventListener('click', () => goTo(index)));
+            // Direct interaction takes over from a button-initiated scroll.
+            for (const event of ['pointerdown', 'wheel', 'keydown']) {
+                track.addEventListener(event, () => { pending = null; }, { passive: true });
+            }
+            const supportsScrollEnd = 'onscrollend' in track;
+            track.addEventListener('scroll', () => {
+                if (pending === null && !frame) {
+                    frame = requestAnimationFrame(() => {
+                        frame = 0;
+                        if (pending === null) mark(currentIndex());
+                    });
+                }
+                if (!supportsScrollEnd) {
+                    clearTimeout(timer);
+                    timer = setTimeout(settle, 150);
+                }
+            }, { passive: true });
+            if (supportsScrollEnd) track.addEventListener('scrollend', settle);
+
+            updateButtons(0);
+            this.querySelector<HTMLElement>('[data-controls]')!.hidden = slides.length < 2;
+            this.querySelector<HTMLElement>('[data-markers]')!.hidden = slides.length < 2;
+        }
+    }
+
+    if (!customElements.get('top-stories-carousel')) {
+        customElements.define('top-stories-carousel', TopStoriesCarousel);
+    }
+</script>
