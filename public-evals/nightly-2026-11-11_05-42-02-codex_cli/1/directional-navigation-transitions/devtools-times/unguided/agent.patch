diff --git a/src/components/TopStoriesCarousel.astro b/src/components/TopStoriesCarousel.astro
new file mode 100644
index 0000000..ee89e43
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,139 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-carousel class="block bg-white border-b border-gray-300" role="region" aria-label="Top Stories" aria-roledescription="carousel">
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
+            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-900">Top Stories</h2>
+            {articles.length > 1 && (
+                <div class="flex items-center gap-3">
+                    <span data-counter class="text-xs text-gray-500" aria-hidden="true">1 / {articles.length}</span>
+                    <button type="button" data-previous class="carousel-button">← Previous</button>
+                    <button type="button" data-next class="carousel-button">Next →</button>
+                </div>
+            )}
+        </div>
+        <div class="overflow-hidden">
+            <div class="grid" data-slides>
+                {articles.map((article, index) => (
+                    <article
+                        data-slide
+                        class="story-slide"
+                        hidden={index !== 0}
+                        inert={index !== 0}
+                        aria-hidden={index !== 0 ? 'true' : undefined}
+                        role="group"
+                        aria-roledescription="slide"
+                        aria-label={`${index + 1} of ${articles.length}`}
+                    >
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                        </a>
+                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                    </article>
+                ))}
+            </div>
+        </div>
+        <p data-status class="sr-only" aria-live="polite" aria-atomic="true"></p>
+    </div>
+</top-stories-carousel>
+
+<style>
+    .story-slide {
+        grid-area: 1 / 1;
+        min-width: 0;
+    }
+
+    .story-slide[hidden] {
+        display: none;
+    }
+
+    .carousel-button {
+        border: 1px solid var(--color-gray-300);
+        padding: 0.375rem 0.75rem;
+        font-size: 0.875rem;
+        font-weight: 600;
+        cursor: pointer;
+    }
+
+    .carousel-button:hover {
+        background: var(--color-amber-100);
+    }
+
+    .carousel-button:focus-visible {
+        outline: 2px solid var(--color-gray-900);
+        outline-offset: 3px;
+    }
+
+    .carousel-button:disabled {
+        cursor: default;
+        opacity: 0.5;
+    }
+</style>
+
+<script>
+    class TopStoriesCarousel extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
+            const previous = this.querySelector<HTMLButtonElement>('[data-previous]');
+            const next = this.querySelector<HTMLButtonElement>('[data-next]');
+            const counter = this.querySelector<HTMLElement>('[data-counter]');
+            const status = this.querySelector<HTMLElement>('[data-status]');
+            if (slides.length < 2 || !previous || !next) return;
+
+            let current = 0;
+            let transitioning = false;
+
+            const changeStory = async (direction: number) => {
+                if (transitioning) return;
+                transitioning = true;
+                previous.disabled = next.disabled = true;
+
+                const target = (current + direction + slides.length) % slides.length;
+                const outgoing = slides[current];
+                const incoming = slides[target];
+                outgoing.inert = true;
+                outgoing.setAttribute('aria-hidden', 'true');
+                incoming.hidden = false;
+
+                const duration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 320;
+                const options = { duration, easing: 'ease-in-out' };
+                const animations = [
+                    outgoing.animate([
+                        { transform: 'translateX(0)' },
+                        { transform: `translateX(${-direction * 100}%)` },
+                    ], options),
+                    incoming.animate([
+                        { transform: `translateX(${direction * 100}%)` },
+                        { transform: 'translateX(0)' },
+                    ], options),
+                ];
+
+                await Promise.allSettled(animations.map(animation => animation.finished));
+                outgoing.hidden = true;
+                incoming.inert = false;
+                incoming.removeAttribute('aria-hidden');
+                current = target;
+                if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
+                if (status) status.textContent = `Story ${current + 1} of ${slides.length}: ${incoming.querySelector('h3')?.textContent}`;
+                previous.disabled = next.disabled = false;
+                transitioning = false;
+            };
+
+            previous.addEventListener('click', () => changeStory(-1));
+            next.addEventListener('click', () => changeStory(1));
+        }
+    }
+
+    customElements.define('top-stories-carousel', TopStoriesCarousel);
+</script>
