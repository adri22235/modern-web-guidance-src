+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const toggle = document.getElementById('roast-toggle');
+      const context = canvas.getContext('2d');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const beans = Array.from({ length: 42 }, () => ({
+        x: Math.random() * canvas.width,
+        y: 35 + Math.random() * 130,
+        angle: Math.random() * Math.PI * 2,
+        speed: 25 + Math.random() * 35
+      }));
+      let inView = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let userPaused = false;
+      let running = false;
+      let frameId = null;
+      let intervalId = null;
+      let lastFrame = null;
+      let elapsed = 0;
+
+      function drawBeans(delta = 0) {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach((bean) => {
+          bean.x = (bean.x + bean.speed * delta) % canvas.width;
+          bean.angle += delta * 1.5;
+          context.save();
+          context.translate(bean.x, bean.y + Math.sin(bean.angle) * 12);
+          context.rotate(bean.angle);
+          context.fillStyle = '#a56b3f';
+          context.beginPath();
+          context.ellipse(0, 0, 14, 9, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#41271b';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-10, 0);
+          context.bezierCurveTo(-3, -5, 3, 5, 10, 0);
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(timestamp) {
+        frameId = null;
+        if (!running || reducedMotion.matches || !context) return;
+        const delta = lastFrame === null ? 0 : Math.min((timestamp - lastFrame) / 1000, 0.05);
+        lastFrame = timestamp;
+        drawBeans(delta);
+        frameId = requestAnimationFrame(animate);
+      }
+
+      // All visibility signals share one lifecycle, preventing duplicate loops/timers.
+      function stop() {
+        running = false;
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = intervalId = lastFrame = null;
+      }
+
+      function sync() {
+        const shouldRun = inView && !renderingSkipped && !document.hidden && pageActive && !userPaused;
+        if (!shouldRun) {
+          stop();
+          return;
+        }
+        if (running) return;
+        running = true;
+        drawBeans();
+        if (context && !reducedMotion.matches) frameId = requestAnimationFrame(animate);
+        intervalId = setInterval(() => {
+          elapsed += 1;
+          temperature.textContent = (185 + 20 * Math.sin(elapsed / 30)).toFixed(1);
+        }, 1000);
+      }
+
+      // Listen on the widget itself: this event does not reliably bubble.
+      // Viewport detection also handles browsers with CSS support but no event support.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          sync();
+        });
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          inView = entries[0].isIntersecting;
+          sync();
+        }, { rootMargin: '0px', threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Event-driven fallback for browsers without either visibility API.
+        let checkId = null;
+        function checkViewport() {
+          checkId = null;
+          const rect = widget.getBoundingClientRect();
+          inView = rect.bottom > 0 && rect.top < window.innerHeight &&
+            rect.right > 0 && rect.left < window.innerWidth;
+          sync();
+        }
+        function scheduleCheck() {
+          if (checkId === null) checkId = requestAnimationFrame(checkViewport);
+        }
+        window.addEventListener('scroll', scheduleCheck, { passive: true, capture: true });
+        window.addEventListener('resize', scheduleCheck, { passive: true });
+        window.addEventListener('pageshow', scheduleCheck);
+        window.addEventListener('load', scheduleCheck);
+        checkViewport();
+      }
+
+      document.addEventListener('visibilitychange', sync);
+      window.addEventListener('pagehide', () => { pageActive = false; stop(); });
+      window.addEventListener('pageshow', () => { pageActive = true; sync(); });
+      toggle.addEventListener('click', () => {
+        userPaused = !userPaused;
+        toggle.setAttribute('aria-pressed', String(userPaused));
+        toggle.textContent = userPaused ? 'Resume simulation' : 'Pause simulation';
+        sync();
+      });
+      function updateMotionPreference() {
+        stop();
+        sync();
+      }
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', updateMotionPreference);
+      } else {
+        reducedMotion.addListener(updateMotionPreference);
+      }
+    })();
+  </script>
 </body>
 
