+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var temperatureValue = document.getElementById('roast-temp-value');
+      var context = canvas.getContext('2d');
+      var frameId = null;
+      var temperatureInterval = null;
+      var running = false;
+      var inViewport = false;
+      var renderingSkipped = false;
+      var pageActive = true;
+      var lastFrameTime = null;
+      var roastTime = 0;
+      var temperature = 180;
+      var beans = [];
+
+      for (var i = 0; i < 42; i++) {
+        beans.push({
+          phase: Math.random() * Math.PI * 2,
+          radius: 0.25 + Math.random() * 0.7,
+          speed: 0.6 + Math.random() * 0.6,
+          size: 8 + Math.random() * 6
+        });
+      }
+
+      function drawBeans() {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach(function (bean) {
+          var angle = bean.phase + roastTime * bean.speed;
+          var x = canvas.width / 2 + Math.cos(angle) * canvas.width * 0.44 * bean.radius;
+          var y = canvas.height / 2 + Math.sin(angle) * canvas.height * 0.37 * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(angle * 2);
+          context.scale(1, 0.65);
+          context.beginPath();
+          context.arc(0, 0, bean.size, 0, Math.PI * 2);
+          context.fillStyle = 'hsl(25, 42%, ' + (42 - (temperature - 180) * 0.35) + '%)';
+          context.fill();
+          context.beginPath();
+          context.moveTo(0, -bean.size * 0.8);
+          context.bezierCurveTo(-bean.size * 0.5, 0, bean.size * 0.5, 0, 0, bean.size * 0.8);
+          context.strokeStyle = '#281b17';
+          context.lineWidth = 2;
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(timestamp) {
+        frameId = null;
+        if (!running) return;
+        if (lastFrameTime !== null) {
+          roastTime += Math.min((timestamp - lastFrameTime) / 1000, 0.05);
+        }
+        lastFrameTime = timestamp;
+        drawBeans();
+        frameId = window.requestAnimationFrame(animate);
+      }
+
+      // All visibility signals share one idempotent start/stop path.
+      function syncActivity() {
+        var shouldRun = inViewport && !renderingSkipped && !document.hidden && pageActive;
+        if (shouldRun === running) return;
+        running = shouldRun;
+        if (running) {
+          lastFrameTime = null;
+          if (context) frameId = window.requestAnimationFrame(animate);
+          temperatureInterval = window.setInterval(function () {
+            temperature = Math.min(220, Math.max(180, temperature + (220 - temperature) * 0.025 + (Math.random() - 0.5) * 0.8));
+            temperatureValue.textContent = temperature.toFixed(1);
+          }, 1000);
+        } else {
+          if (frameId !== null) window.cancelAnimationFrame(frameId);
+          if (temperatureInterval !== null) window.clearInterval(temperatureInterval);
+          frameId = null;
+          temperatureInterval = null;
+          lastFrameTime = null;
+        }
+      }
+
+      function checkViewport() {
+        var bounds = widget.getBoundingClientRect();
+        inViewport = bounds.bottom > 0 && bounds.top < window.innerHeight &&
+          bounds.right > 0 && bounds.left < window.innerWidth && bounds.width > 0 && bounds.height > 0;
+        syncActivity();
+      }
+
+      // Native rendering state can skip work even while an element is near the viewport.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      // Observe actual intersection as auto rendering may include an offscreen buffer.
+      if ('IntersectionObserver' in window) {
+        var observer = new IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            inViewport = entry.isIntersecting && entry.intersectionRatio > 0;
+          });
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Event-driven fallback: no polling timer or animation loop while offscreen.
+        window.addEventListener('scroll', checkViewport, true);
+        window.addEventListener('resize', checkViewport);
+        window.addEventListener('load', checkViewport);
+      }
+
+      document.addEventListener('visibilitychange', checkViewport);
+      window.addEventListener('pagehide', function () {
+        pageActive = false;
+        syncActivity();
+      });
+      window.addEventListener('pageshow', function () {
+        pageActive = true;
+        checkViewport();
+      });
+      checkViewport();
+    }());
+  </script>
+
