+    /* Sticky section headers
+       The .sticky-container is the sticky element AND a named scroll-state
+       container. Its descendant .sticky-header is restyled via a container
+       query while the container is stuck. Naming the container ("section-header")
+       keeps these queries scoped so they never match the sticky site <nav>. */
+    :root {
+      /* Height of the sticky site nav (kept in sync by script below). */
+      --nav-height: 4.4rem;
+    }
+
+    .intro {
+      text-align: center;
+      max-width: 750px;
