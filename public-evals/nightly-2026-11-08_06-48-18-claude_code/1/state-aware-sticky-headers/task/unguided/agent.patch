+
+    .content-section {
+      margin-bottom: 60px;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just beneath the site navigation instead of underneath it. */
+      top: var(--nav-height);
+      z-index: 900; /* below nav (1000), above cards */
+      container-type: scroll-state;
+      container-name: section-header;
+      margin-bottom: 20px;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 1.5rem;
+      border-radius: 8px;
+      text-align: center;
+      font-size: 1.6rem;
+      box-shadow: none;
+      transition: background-color 0.25s, color 0.25s, padding 0.25s,
+        box-shadow 0.25s, font-size 0.25s, border-radius 0.25s;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
