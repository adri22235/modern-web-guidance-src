+  <script>
+    (function () {
+      // Keep --nav-height in sync with the real nav so headers stick right below it.
+      var nav = document.querySelector('nav');
+      var root = document.documentElement;
+      function syncNavHeight() {
+        root.style.setProperty('--nav-height', nav.offsetHeight + 'px');
+      }
+      syncNavHeight();
+      if ('ResizeObserver' in window) new ResizeObserver(syncNavHeight).observe(nav);
+
+      // Fallback for browsers without scroll-state container queries:
+      // toggle .is-stuck when a sticky container is pinned below the nav.
+      if (window.CSS && CSS.supports('container-type: scroll-state')) return;
+      var containers = Array.prototype.slice.call(document.querySelectorAll('.sticky-container'));
+      var ticking = false;
+      function update() {
+        ticking = false;
+        var top = nav.offsetHeight;
+        containers.forEach(function (el) {
+          var rect = el.getBoundingClientRect();
+          var parentRect = el.parentElement.getBoundingClientRect();
+          // Stuck when pinned at the sticky offset while its section has scrolled past it.
+          var stuck = Math.abs(rect.top - top) < 1 && parentRect.top < top;
+          el.classList.toggle('is-stuck', stuck);
+        });
+      }
+      function onScroll() {
+        if (!ticking) { ticking = true; requestAnimationFrame(update); }
+      }
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll);
+      update();
+    })();
+  </script>
+
