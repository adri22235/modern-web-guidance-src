+    /* Sticky section headers (scroll root: the document/viewport) */
+    .sticky-section {
+      margin-top: 60px;
+      /* Prevent scroll-anchoring oscillation when the stuck header's padding shrinks */
+      overflow-anchor: none;
+    }
+
+    .sticky-container {
+      position: sticky;
+      /* Stick just below the site nav, which is itself sticky at top: 0 */
+      top: var(--nav-height);
+      z-index: 10;
+      /* Named container so queries don't collide with any other containers */
+      container-type: scroll-state;
+      container-name: section-header;
+    }
+
+    .sticky-header {
+      background: var(--secondary);
+      color: var(--primary);
+      padding: 1.25rem 1.5rem;
+      border-radius: 8px;
+      font-size: 1.5rem;
+      transition: background-color 0.3s, color 0.3s, box-shadow 0.3s, padding 0.3s, border-radius 0.3s;
+    }
+
+    .sticky-header small {
+      display: block;
+      font-size: 0.85rem;
+      font-weight: normal;
+      opacity: 0.8;
+    }
+
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
+        background: var(--stuck-blue);
+        color: white;
+        padding: 0.5rem 1.5rem;
+        border-radius: 0 0 8px 8px;
+        box-shadow: 0 4px 10px rgb(0 0 0 / 0.25);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .sticky-header {
+        transition: none;
+      }
+    }
+
+    .section-body {
+      padding: 20px 0;
+    }
+
+    .section-body > p {
+      margin-bottom: 1rem;
+    }
+
+    .card img {
+      width: 100%;
+      height: 160px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 12px;
+    }
+
+    .card {
+      text-align: left;
+    }
+
+    .grid .card {
+      text-align: center;
+    }
+
+    .location-list {
+      list-style: none;
+      display: grid;
+      gap: 16px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
