     .btn:hover {
       background: #3e2723;
     }
 
+    /* Media Scroller */
+    .media-section {
+      margin-top: 60px;
+    }
+
+    .media-scroller {
+      position: relative; /* makes card offsetTop relative to the scroller */
+      height: 420px;
+      max-width: 520px;
+      margin: 20px auto 0;
+      padding: 16px;
+      overflow-y: auto;
+      overscroll-behavior: contain;
+      scroll-behavior: auto; /* never animate the initial positioning */
+      background: var(--secondary);
+      border-radius: 12px;
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+    }
+
+    .media-card {
+      flex: 0 0 auto;
+      background: white;
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .media-card img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 488 / 300; /* matches width/height attrs: space reserved before load */
+      object-fit: cover;
+      background: #bcaaa4;
+    }
+
+    .media-card .media-body {
+      padding: 12px 16px 16px;
+    }
+
+    .media-card h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    .media-card.target {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .media-scroller.is-ready {
+        scroll-behavior: smooth; /* only for user-initiated scrolling after setup */
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
