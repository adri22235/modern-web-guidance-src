+  <script>
+    (() => {
+      const slider = document.getElementById('brew-strength-slider');
+      const output = document.getElementById('brew-strength-value');
+      const desc = document.getElementById('brew-strength-desc');
+      const levels = {
+        1: ['Mild', 'A light roast that is bright, floral, and gentle.'],
+        2: ['Smooth', 'A medium-light roast with mellow notes of honey and almond.'],
+        3: ['Balanced', 'A medium roast with caramel sweetness and a clean finish.'],
+        4: ['Bold', 'A medium-dark roast with rich cocoa and toasted nut flavors.'],
+        5: ['Extra Bold', 'A dark roast that is smoky, intense, and full-bodied.']
+      };
+
+      function sync() {
+        const [label, text] = levels[slider.value];
+        // Fallback for browsers without typed attr(); also keeps the fill live in WebKit/Blink.
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', slider.value);
+        slider.setAttribute('aria-valuetext', `${slider.value} of ${slider.max}, ${label}`);
+        output.value = label;
+        desc.textContent = text;
+      }
+
+      sync();
+      slider.addEventListener('input', sync);
+    })();
+  </script>
+
