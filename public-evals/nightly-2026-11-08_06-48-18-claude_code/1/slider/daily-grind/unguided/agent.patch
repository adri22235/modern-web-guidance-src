+  <script>
+    (function () {
+      var range = document.getElementById('brew-strength');
+      if (!range) return;
+      var output = document.getElementById('brew-strength-output');
+      var desc = document.getElementById('brew-strength-desc');
+      var levels = {
+        1: ['Mild', 'Light and delicate, perfect for slow mornings.'],
+        2: ['Smooth', 'Soft and mellow with a hint of sweetness.'],
+        3: ['Balanced', 'A well-rounded cup with gentle body and bright notes.'],
+        4: ['Bold', 'Rich and full-bodied with deep roasted flavor.'],
+        5: ['Intense', 'Maximum kick: dark, smokey, and unapologetic.']
+      };
+
+      function update() {
+        var min = Number(range.min) || 0;
+        var max = Number(range.max) || 100;
+        var val = Number(range.value);
+        var pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
+        range.style.setProperty('--fill', pct + '%');
+        var level = levels[val] || [String(val), ''];
+        output.textContent = val + ' \u00b7 ' + level[0];
+        range.setAttribute('aria-valuetext', val + ' of ' + max + ', ' + level[0]);
+        desc.textContent = level[1];
+      }
+
+      range.addEventListener('input', update);
+      range.addEventListener('change', update);
+      update();
+    })();
+  </script>
+
