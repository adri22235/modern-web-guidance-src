+  <script>
+    /*
+     * Location-agnostic preferences.
+     *
+     * The pickup time and anniversary are stored as the exact wall-clock /
+     * calendar strings the user picked ("HH:MM" and "YYYY-MM-DD"). They are
+     * never converted to Date objects, timestamps, or UTC for storage, so a
+     * time-zone change (travel, DST) can't shift them. Display formatting
+     * pins the formatter to UTC on a UTC-built value so the browser's local
+     * offset is never applied to the stored values.
+     */
+    (function () {
+      var STORAGE_KEY = 'dailyGrind.prefs.v1';
+      var TIME_RE = /^([01]\d|2[0-3]):([0-5]\d)$/;
+      var DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+      var form = document.getElementById('prefs-form');
+      var timeInput = document.getElementById('pickup-time');
+      var dateInput = document.getElementById('anniversary-date');
+      var pickupSummary = document.getElementById('pickup-summary');
+      var annivSummary = document.getElementById('anniversary-summary');
+      var status = document.getElementById('prefs-status');
+      var clearBtn = document.getElementById('prefs-clear');
+
+      function isValidTime(s) {
+        return typeof s === 'string' && TIME_RE.test(s);
+      }
+
+      function parseDate(s) {
+        var m = typeof s === 'string' && DATE_RE.exec(s);
+        if (!m) return null;
+        var y = +m[1], mo = +m[2], d = +m[3];
+        if (mo < 1 || mo > 12 || d < 1 || d > daysInMonth(y, mo)) return null;
+        return { y: y, m: mo, d: d };
+      }
+
+      function daysInMonth(y, m) {
+        // Day 0 of the next month in UTC = last day of month m; no local offset involved.
+        return new Date(Date.UTC(y, m, 0)).getUTCDate();
+      }
+
+      // Normalise a time value to "HH:MM" (some browsers may return "HH:MM:SS").
+      function normaliseTime(s) {
+        if (typeof s !== 'string') return '';
+        s = s.slice(0, 5);
+        return isValidTime(s) ? s : '';
+      }
+
+      function load() {
+        try {
+          var raw = localStorage.getItem(STORAGE_KEY);
+          var data = raw ? JSON.parse(raw) : {};
+          return {
+            pickupTime: isValidTime(data.pickupTime) ? data.pickupTime : '',
+            anniversaryDate: parseDate(data.anniversaryDate) ? data.anniversaryDate : ''
+          };
+        } catch (e) {
+          return { pickupTime: '', anniversaryDate: '' };
+        }
+      }
+
+      function save(prefs) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+          return true;
+        } catch (e) {
+          return false;
+        }
+      }
+
+      function formatTime(hhmm) {
+        var h = +hhmm.slice(0, 2), mi = +hhmm.slice(3, 5);
+        return new Intl.DateTimeFormat(undefined, {
+          hour: 'numeric', minute: '2-digit', timeZone: 'UTC'
+        }).format(new Date(Date.UTC(2000, 0, 1, h, mi)));
+      }
+
+      function formatDate(p) {
+        return new Intl.DateTimeFormat(undefined, {
+          year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'
+        }).format(new Date(Date.UTC(p.y, p.m - 1, p.d)));
+      }
+
+      // Today's calendar date wherever the user currently is.
+      function todayParts() {
+        var now = new Date();
+        return { y: now.getFullYear(), m: now.getMonth() + 1, d: now.getDate() };
+      }
+
+      // Pure calendar-day difference (no hours, so DST can't skew it).
+      function dayNumber(p) {
+        return Math.round(Date.UTC(p.y, p.m - 1, p.d) / 86400000);
+      }
+
+      // Anniversary falls on the same month/day each year; Feb 29 -> Feb 28 in non-leap years.
+      function anniversaryInYear(p, year) {
+        return { y: year, m: p.m, d: Math.min(p.d, daysInMonth(year, p.m)) };
+      }
+
+      function describeAnniversary(p) {
+        var today = todayParts();
+        var t = dayNumber(today);
+        if (dayNumber(p) > t) {
+          return 'Starts on ' + formatDate(p) + '.';
+        }
+        var next = anniversaryInYear(p, today.y);
+        if (dayNumber(next) < t) next = anniversaryInYear(p, today.y + 1);
+        var years = next.y - p.y;
+        var diff = dayNumber(next) - t;
+        var label = years + (years === 1 ? ' year' : ' years');
+        if (diff === 0) {
+          return years === 0
+            ? 'Your coffee journey starts today! ☕'
+            : 'Happy ' + label + ' coffee anniversary! ☕';
+        }
+        return formatDate(p) + ' — ' + label + ' in ' + diff + (diff === 1 ? ' day.' : ' days.');
+      }
+
+      function render(prefs) {
+        timeInput.value = prefs.pickupTime;
+        dateInput.value = prefs.anniversaryDate;
+        updateSummaries();
+      }
+
+      function updateSummaries() {
+        var t = normaliseTime(timeInput.value);
+        pickupSummary.textContent = t
+          ? 'Every day at ' + formatTime(t) + ' local time, wherever you are.'
+          : 'No reminder set.';
+        var p = parseDate(dateInput.value);
+        annivSummary.textContent = p ? describeAnniversary(p) : 'No anniversary set.';
+      }
+
+      timeInput.addEventListener('input', updateSummaries);
+      dateInput.addEventListener('input', updateSummaries);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var t = normaliseTime(timeInput.value);
+        var d = parseDate(dateInput.value) ? dateInput.value : '';
+        if (timeInput.value && !t) {
+          status.textContent = 'Please enter a valid reminder time.';
+          return;
+        }
+        if (dateInput.value && !d) {
+          status.textContent = 'Please enter a valid anniversary date.';
+          return;
+        }
+        var ok = save({ pickupTime: t, anniversaryDate: d });
+        status.textContent = ok ? 'Saved!' : 'Could not save preferences in this browser.';
+        render({ pickupTime: t, anniversaryDate: d });
+      });
+
+      clearBtn.addEventListener('click', function () {
+        try { localStorage.removeItem(STORAGE_KEY); } catch (e) { /* ignore */ }
+        render({ pickupTime: '', anniversaryDate: '' });
+        status.textContent = 'Preferences cleared.';
+      });
+
+      render(load());
+    })();
+  </script>
+
 </body>
 
