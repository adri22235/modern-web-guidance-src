+  <script type="module">
+    // Pickup time and anniversary are location-agnostic values: they are stored
+    // as Temporal.PlainTime / Temporal.PlainDate ISO strings ("08:00", "2019-03-14")
+    // with no time zone or offset, so they never shift when the user travels.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const STORAGE_KEY = 'dailyGrind.coffeePrefs';
+    const form = document.getElementById('prefs-form');
+    const timeInput = document.getElementById('pickup-time');
+    const dateInput = document.getElementById('anniversary-date');
+    const pickupSummary = document.getElementById('pickup-summary');
+    const anniversarySummary = document.getElementById('anniversary-summary');
+    const status = document.getElementById('prefs-status');
+
+    const parse = (Type, value) => {
+      try { return value ? Type.from(value) : null; } catch { return null; }
+    };
+
+    function loadPrefs() {
+      try {
+        const raw = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '{}');
+        return {
+          pickupTime: parse(Temporal.PlainTime, raw.pickupTime),
+          anniversary: parse(Temporal.PlainDate, raw.anniversaryDate),
+        };
+      } catch {
+        return { pickupTime: null, anniversary: null };
+      }
+    }
+
+    function savePrefs({ pickupTime, anniversary }) {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify({
+        pickupTime: pickupTime?.toString({ smallestUnit: 'minute' }) ?? null,
+        anniversaryDate: anniversary?.toString() ?? null,
+      }));
+    }
+
+    function describePickup(time) {
+      if (!time) return '';
+      const label = time.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+      return `We'll remind you every day at ${label}, local time.`;
+    }
+
+    function describeAnniversary(date) {
+      if (!date) return '';
+      const today = Temporal.Now.plainDateISO();
+      const label = date.toLocaleString(undefined, { dateStyle: 'long' });
+      // Recurring annual date: PlainMonthDay -> PlainDate for a given year.
+      // Feb 29 is constrained to Feb 28 in non-leap years.
+      const monthDay = date.toPlainMonthDay();
+      let next = monthDay.toPlainDate({ year: today.year });
+      if (Temporal.PlainDate.compare(next, today) < 0) {
+        next = monthDay.toPlainDate({ year: today.year + 1 });
+      }
+      const days = today.until(next, { largestUnit: 'day' }).days;
+      const years = next.year - date.year;
+      if (years <= 0) return `Saved: ${label}.`;
+      if (days === 0) return `Happy ${years}-year coffee anniversary! ☕ Your next drink is on us.`;
+      return `${label} — your ${years}-year anniversary is in ${days} day${days === 1 ? '' : 's'}.`;
+    }
+
+    function render(prefs) {
+      pickupSummary.textContent = describePickup(prefs.pickupTime);
+      anniversarySummary.textContent = describeAnniversary(prefs.anniversary);
+    }
+
+    // Restore saved values into the inputs exactly as stored (no Date conversion).
+    const saved = loadPrefs();
+    if (saved.pickupTime) timeInput.value = saved.pickupTime.toString({ smallestUnit: 'minute' });
+    if (saved.anniversary) dateInput.value = saved.anniversary.toString();
+    dateInput.max = Temporal.Now.plainDateISO().toString();
+    render(saved);
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const prefs = {
+        pickupTime: parse(Temporal.PlainTime, timeInput.value),
+        anniversary: parse(Temporal.PlainDate, dateInput.value),
+      };
+      if (!prefs.pickupTime || !prefs.anniversary) {
+        status.textContent = 'Please choose both a pickup time and an anniversary date.';
+        return;
+      }
+      savePrefs(prefs);
+      render(prefs);
+      status.textContent = 'Preferences saved.';
+    });
+
+    // Daily pickup reminder: compare the stored wall-clock time to the *current*
+    // local wall-clock time, so it fires at the chosen time in whatever zone the
+    // device is in now.
+    let lastNotified = null;
+    function checkReminder() {
+      const { pickupTime } = loadPrefs();
+      if (!pickupTime) return;
+      const now = Temporal.Now.plainDateTimeISO();
+      const today = now.toPlainDate().toString();
+      const nowMinute = now.toPlainTime().round({ smallestUnit: 'minute', roundingMode: 'floor' });
+      if (lastNotified !== today && nowMinute.equals(pickupTime)) {
+        lastNotified = today;
+        const msg = 'Time for your Daily Grind pickup! ☕';
+        if ('Notification' in window && Notification.permission === 'granted') {
+          new Notification('The Daily Grind', { body: msg });
+        } else {
+          status.textContent = msg;
+        }
+      }
+    }
+    form.addEventListener('submit', () => {
+      if ('Notification' in window && Notification.permission === 'default') {
+        Notification.requestPermission();
+      }
+    });
+    setInterval(checkReminder, 30_000);
+    checkReminder();
+  </script>
+
