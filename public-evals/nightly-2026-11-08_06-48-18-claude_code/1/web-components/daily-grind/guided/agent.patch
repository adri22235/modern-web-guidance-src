diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..5b5c1fb
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,295 @@
+/**
+ * <coffee-card> — a menu item card with an optional "favorite" toggle.
+ *
+ * Content lives in the Light DOM so it is indexable, styleable by the page,
+ * and still readable if this script never loads:
+ *
+ *   <coffee-card item-id="maple-oat-latte" price="$5.25">
+ *     <img slot="media" src="…" alt="" width="600" height="400">
+ *     <h3 slot="title">Maple Oat Latte</h3>
+ *     <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+ *     <a slot="action" href="/menu/seasonal">View details</a>
+ *   </coffee-card>
+ *
+ * Attributes
+ *   item-id     Stable id used to persist the favorite state (enables the toggle).
+ *   price       Optional price label rendered in a badge.
+ *   favorited   Boolean; reflects / sets the favorite state.
+ *
+ * Events
+ *   favorite-change  (bubbles, composed) detail: { itemId, name, favorited }
+ *
+ * Styling hooks
+ *   Custom properties: --dg-primary, --dg-primary-strong, --dg-accent,
+ *                      --dg-surface, --dg-radius, --dg-shadow
+ *   Parts: card, media, badge, favorite, action
+ *   States: coffee-card:state(favorited)
+ */
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+const readFavorites = () => {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+};
+
+const writeFavorites = (set) => {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) — state stays in memory */
+  }
+};
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_primary: var(--dg-primary, #4e342e);
+    --_primary-strong: var(--dg-primary-strong, #3e2723);
+    --_accent: var(--dg-accent, #ffab40);
+    --_surface: var(--dg-surface, #fff);
+    --_radius: var(--dg-radius, 8px);
+    --_shadow: var(--dg-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+
+    display: block;
+    container-type: inline-size;
+  }
+  :host([hidden]) { display: none; }
+
+  .card {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    block-size: 100%;
+    background: var(--_surface);
+    border-radius: var(--_radius);
+    box-shadow: var(--_shadow);
+    overflow: hidden;
+    text-align: center;
+    transition: box-shadow 0.2s, translate 0.2s;
+  }
+  .card:has(:focus-visible),
+  .card:hover {
+    box-shadow: 0 6px 18px rgb(0 0 0 / 0.15);
+  }
+  @media (prefers-reduced-motion: no-preference) {
+    .card:hover { translate: 0 -2px; }
+  }
+
+  .media { aspect-ratio: 3 / 2; background: var(--dg-secondary, #d7ccc8); }
+  .media[hidden] { display: none; }
+  ::slotted([slot="media"]) {
+    display: block;
+    inline-size: 100%;
+    block-size: 100%;
+    object-fit: cover;
+  }
+
+  .body {
+    display: flex;
+    flex: 1;
+    flex-direction: column;
+    align-items: center;
+    gap: 0.5rem;
+    padding: 1.25rem;
+  }
+  ::slotted([slot="title"]) {
+    margin: 0;
+    color: var(--_primary);
+    font-size: 1.2rem;
+    line-height: 1.3;
+  }
+  ::slotted(p) { margin: 0; }
+
+  .footer { margin-block-start: auto; padding-block-start: 0.75rem; }
+
+  /* The action is a consumer-owned <a>; give it a button look by default. */
+  ::slotted([slot="action"]) {
+    display: inline-block;
+    padding: 0.6rem 1.25rem;
+    border-radius: 5px;
+    background: var(--_primary);
+    color: #fff;
+    text-decoration: none;
+    transition: background 0.2s;
+  }
+  ::slotted([slot="action"]:hover) { background: var(--_primary-strong); }
+  ::slotted([slot="action"]:focus-visible) {
+    outline: 3px solid var(--_accent);
+    outline-offset: 2px;
+  }
+
+  .badge {
+    position: absolute;
+    inset-block-start: 0.75rem;
+    inset-inline-start: 0.75rem;
+    padding: 0.15rem 0.6rem;
+    border-radius: 999px;
+    background: var(--_accent);
+    color: var(--_primary-strong);
+    font-size: 0.85rem;
+    font-weight: 700;
+  }
+  .badge:empty { display: none; }
+
+  .favorite {
+    position: absolute;
+    inset-block-start: 0.5rem;
+    inset-inline-end: 0.5rem;
+    display: grid;
+    place-items: center;
+    inline-size: 2.75rem;
+    block-size: 2.75rem;
+    padding: 0;
+    border: 0;
+    border-radius: 50%;
+    background: rgb(255 255 255 / 0.9);
+    color: var(--_primary);
+    font: inherit;
+    cursor: pointer;
+    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
+  }
+  .favorite[hidden] { display: none; }
+  .favorite:hover { background: #fff; }
+  .favorite:focus-visible {
+    outline: 3px solid var(--_accent);
+    outline-offset: 2px;
+  }
+  .favorite svg { inline-size: 1.4rem; block-size: 1.4rem; }
+  .favorite path {
+    fill: transparent;
+    stroke: currentColor;
+    stroke-width: 2;
+    transition: fill 0.2s;
+  }
+  .favorite[aria-pressed="true"] { color: #c62828; }
+  .favorite[aria-pressed="true"] path { fill: currentColor; }
+
+  /* Wide cards (e.g. single-column layouts) switch to a side-by-side layout. */
+  @container (min-width: 34rem) {
+    .card { flex-direction: row; text-align: start; }
+    .media { flex: 0 0 40%; aspect-ratio: auto; }
+    .body { align-items: flex-start; }
+  }
+
+  @media (forced-colors: active) {
+    .card { border: 1px solid CanvasText; }
+    .favorite { border: 1px solid ButtonText; }
+    .favorite[aria-pressed="true"] path { fill: ButtonText; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <button class="favorite" part="favorite" type="button" aria-pressed="false" hidden>
+      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <path d="M12 21s-7.5-4.6-9.5-9.2C1.1 8.4 3.3 5 6.8 5c2 0 3.6 1.1 5.2 3 1.6-1.9 3.2-3 5.2-3 3.5 0 5.7 3.4 4.3 6.8C19.5 16.4 12 21 12 21z"/>
+      </svg>
+    </button>
+    <div class="body">
+      <slot name="title"></slot>
+      <span class="badge" part="badge"></span>
+      <slot></slot>
+      <div class="footer" part="action"><slot name="action"></slot></div>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['price', 'item-id', 'favorited'];
+
+  #internals = this.attachInternals();
+  #button;
+  #badge;
+  #titleSlot;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#button = root.querySelector('.favorite');
+    this.#badge = root.querySelector('.badge');
+    this.#titleSlot = root.querySelector('slot[name="title"]');
+
+    this.#button.addEventListener('click', () => this.toggleFavorite());
+    this.#titleSlot.addEventListener('slotchange', () => this.#updateLabel());
+
+    const media = root.querySelector('.media');
+    const mediaSlot = media.querySelector('slot');
+    const syncMedia = () => { media.hidden = mediaSlot.assignedElements().length === 0; };
+    mediaSlot.addEventListener('slotchange', syncMedia);
+    syncMedia();
+  }
+
+  connectedCallback() {
+    // Restore persisted state on (re)connect unless markup set it explicitly.
+    if (this.itemId && !this.hasAttribute('favorited') && readFavorites().has(this.itemId)) {
+      this.toggleAttribute('favorited', true);
+    }
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    this.#sync();
+  }
+
+  get itemId() { return this.getAttribute('item-id') ?? ''; }
+  set itemId(v) { v ? this.setAttribute('item-id', v) : this.removeAttribute('item-id'); }
+
+  get price() { return this.getAttribute('price') ?? ''; }
+  set price(v) { v ? this.setAttribute('price', v) : this.removeAttribute('price'); }
+
+  get favorited() { return this.hasAttribute('favorited'); }
+  set favorited(on) { this.toggleAttribute('favorited', Boolean(on)); }
+
+  /** Visible name of the item, taken from the slotted title. */
+  get name() {
+    const [title] = this.#titleSlot.assignedElements();
+    return title?.textContent.trim() ?? '';
+  }
+
+  toggleFavorite(force = !this.favorited) {
+    if (force === this.favorited) return;
+    this.favorited = force;
+
+    if (this.itemId) {
+      const favorites = readFavorites();
+      force ? favorites.add(this.itemId) : favorites.delete(this.itemId);
+      writeFavorites(favorites);
+    }
+
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { itemId: this.itemId, name: this.name, favorited: force },
+    }));
+  }
+
+  #sync() {
+    const on = this.favorited;
+    // Public styling hook (coffee-card:state(favorited)); internal styles use aria-pressed.
+    on ? this.#internals.states?.add('favorited') : this.#internals.states?.delete('favorited');
+    this.#button.setAttribute('aria-pressed', String(on));
+    this.#button.hidden = !this.itemId;
+    this.#badge.textContent = this.price;
+    this.#updateLabel();
+  }
+
+  #updateLabel() {
+    // A toggle button keeps a constant label; aria-pressed conveys the state.
+    const name = this.name;
+    this.#button.setAttribute('aria-label', name ? `Favorite ${name}` : 'Favorite');
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
diff --git a/components/favorites-summary.js b/components/favorites-summary.js
new file mode 100644
index 0000000..0a9a465
--- /dev/null
+++ b/components/favorites-summary.js
@@ -0,0 +1,110 @@
+/**
+ * <favorites-summary> — a polite live region that summarizes which
+ * <coffee-card> elements are favorited, and offers to clear them.
+ *
+ *   <favorites-summary></favorites-summary>
+ *
+ * Attributes
+ *   scope   Optional CSS selector for the container whose cards are counted
+ *           (defaults to the whole document).
+ *
+ * Styling hooks
+ *   Custom properties: --dg-primary, --dg-accent, --dg-secondary
+ *   Parts: summary, clear
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    display: block;
+    margin-block: 1rem;
+    text-align: center;
+  }
+  :host([hidden]) { display: none; }
+
+  .wrap {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5rem 1rem;
+  }
+  .summary { margin: 0; }
+  .clear {
+    min-block-size: 2.75rem;
+    padding: 0.35rem 0.9rem;
+    border: 1px solid var(--dg-primary, #4e342e);
+    border-radius: 4px;
+    background: transparent;
+    color: var(--dg-primary, #4e342e);
+    font: inherit;
+    cursor: pointer;
+  }
+  .clear:hover { background: var(--dg-secondary, #d7ccc8); }
+  .clear:focus-visible {
+    outline: 3px solid var(--dg-accent, #ffab40);
+    outline-offset: 2px;
+  }
+  .clear[hidden] { display: none; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="wrap">
+    <p class="summary" part="summary" role="status"></p>
+    <button class="clear" part="clear" type="button" hidden>Clear favorites</button>
+  </div>
+`;
+
+const listFormat = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' });
+
+export class FavoritesSummary extends HTMLElement {
+  #status;
+  #clear;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#status = root.querySelector('.summary');
+    this.#clear = root.querySelector('.clear');
+    this.#clear.addEventListener('click', () => this.#clearAll());
+  }
+
+  connectedCallback() {
+    document.addEventListener('favorite-change', this.#update);
+    // Cards restore persisted state during their upgrade; render once they exist.
+    customElements.whenDefined('coffee-card').then(this.#update);
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('favorite-change', this.#update);
+  }
+
+  get #cards() {
+    const scope = this.getAttribute('scope');
+    const root = (scope && document.querySelector(scope)) || document;
+    return [...root.querySelectorAll('coffee-card')];
+  }
+
+  #update = () => {
+    const names = this.#cards.filter((c) => c.favorited).map((c) => c.name);
+    this.#status.textContent = names.length
+      ? `Your favorites: ${listFormat.format(names)}.`
+      : 'Tap the heart on any drink to save it as a favorite.';
+    this.#clear.hidden = names.length === 0;
+  };
+
+  #clearAll() {
+    for (const card of this.#cards) card.toggleFavorite?.(false);
+    // The button disappears, so move focus somewhere sensible.
+    this.#status.tabIndex = -1;
+    this.#status.focus();
+  }
+}
+
+if (!customElements.get('favorites-summary')) {
+  customElements.define('favorites-summary', FavoritesSummary);
+}
