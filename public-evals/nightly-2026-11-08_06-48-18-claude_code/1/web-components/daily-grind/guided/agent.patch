diff --git a/components/site-nav.js b/components/site-nav.js
new file mode 100644
index 0000000..b6d1a13
--- /dev/null
+++ b/components/site-nav.js
@@ -0,0 +1,243 @@
+/**
+ * <site-nav> — sticky, responsive site navigation with a disclosure menu on
+ * narrow widths.
+ *
+ *   <site-nav label="Main">
+ *     <a slot="brand" href="/">The Daily Grind</a>
+ *     <a href="/menu">Menu</a>
+ *     <a href="/logout" data-variant="outline">Logout</a>
+ *   </site-nav>
+ *
+ * Links stay in the Light DOM, so they work (unstyled-but-usable) without JS.
+ * The component marks the link matching the current URL with aria-current.
+ *
+ * Attributes
+ *   label   Accessible name for the navigation landmark (default "Main").
+ *
+ * Styling hooks
+ *   Custom properties: --dg-primary, --dg-accent, --dg-nav-fg
+ *   Parts: nav, toggle, menu
+ *   States: site-nav:state(open)
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--dg-primary, #4e342e);
+    --_fg: var(--dg-nav-fg, #fff);
+    --_accent: var(--dg-accent, #ffab40);
+
+    display: block;
+    position: sticky;
+    inset-block-start: 0;
+    z-index: 1000;
+    container-type: inline-size;
+    background: var(--_bg);
+    color: var(--_fg);
+  }
+
+  nav {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 0.5rem 1.25rem;
+    padding: 1rem 5%;
+  }
+
+  ::slotted([slot="brand"]) {
+    color: inherit;
+    font-size: 1.5rem;
+    font-weight: 700;
+    letter-spacing: 1px;
+    text-decoration: none;
+    text-transform: uppercase;
+  }
+
+  .menu {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.5rem 1.25rem;
+  }
+
+  ::slotted(a:not([slot])) {
+    color: inherit;
+    font-size: 0.9rem;
+    text-decoration: none;
+    padding-block: 0.25rem;
+    border-block-end: 2px solid transparent;
+    transition: color 0.2s, border-color 0.2s;
+  }
+  ::slotted(a:not([slot]):hover) { color: var(--_accent); }
+  ::slotted(a[aria-current]) { border-block-end-color: var(--_accent); }
+  ::slotted(a[data-variant="outline"]) {
+    padding: 0.3rem 0.75rem;
+    border: 1px solid var(--_accent);
+    border-radius: 4px;
+  }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--_accent);
+    outline-offset: 3px;
+    border-radius: 2px;
+  }
+
+  .toggle {
+    display: none;
+    align-items: center;
+    gap: 0.5rem;
+    min-block-size: 2.75rem;
+    padding: 0.4rem 0.8rem;
+    border: 1px solid currentColor;
+    border-radius: 4px;
+    background: transparent;
+    color: inherit;
+    font: inherit;
+    cursor: pointer;
+  }
+  .toggle:focus-visible {
+    outline: 3px solid var(--_accent);
+    outline-offset: 2px;
+  }
+  .bars, .bars::before, .bars::after {
+    display: block;
+    inline-size: 1.1rem;
+    block-size: 2px;
+    background: currentColor;
+    transition: rotate 0.2s, translate 0.2s, opacity 0.2s;
+  }
+  .bars { position: relative; }
+  .bars::before, .bars::after { content: ""; position: absolute; }
+  .bars::before { translate: 0 -6px; }
+  .bars::after { translate: 0 6px; }
+  .toggle[aria-expanded="true"] .bars { background: transparent; }
+  .toggle[aria-expanded="true"] .bars::before { translate: 0; rotate: 45deg; }
+  .toggle[aria-expanded="true"] .bars::after { translate: 0; rotate: -45deg; }
+
+  @container (max-width: 48rem) {
+    .toggle { display: inline-flex; }
+    .menu {
+      flex-basis: 100%;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 0;
+    }
+    .toggle[aria-expanded="false"] + .menu { display: none; }
+    ::slotted(a:not([slot])) {
+      padding-block: 0.75rem;
+      font-size: 1rem;
+    }
+    ::slotted(a[data-variant="outline"]) {
+      margin-block-start: 0.5rem;
+      text-align: center;
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    .bars, .bars::before, .bars::after { transition: none; }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <span class="bars" aria-hidden="true"></span>
+      <span>Menu</span>
+    </button>
+    <div class="menu" id="menu" part="menu"><slot></slot></div>
+  </nav>
+`;
+
+export class SiteNav extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #internals = this.attachInternals();
+  #nav;
+  #toggle;
+  #slot;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#slot = root.querySelector('slot:not([name])');
+
+    this.#toggle.addEventListener('click', () => this.toggle());
+    this.#slot.addEventListener('slotchange', () => this.#markCurrent());
+    this.addEventListener('keydown', this.#onKeydown);
+    // Close after choosing a link (relevant for in-page anchors / SPA routing).
+    this.addEventListener('click', (e) => {
+      if (e.target.closest?.('a')) this.toggle(false);
+    });
+  }
+
+  connectedCallback() {
+    this.#nav.setAttribute('aria-label', this.label);
+    document.addEventListener('pointerdown', this.#onOutsidePointer);
+    this.addEventListener('focusout', this.#onFocusOut);
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('pointerdown', this.#onOutsidePointer);
+    this.removeEventListener('focusout', this.#onFocusOut);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'label' && oldValue !== newValue) {
+      this.#nav.setAttribute('aria-label', this.label);
+    }
+  }
+
+  get label() { return this.getAttribute('label') || 'Main'; }
+  set label(v) { v ? this.setAttribute('label', v) : this.removeAttribute('label'); }
+
+  #open = false;
+  get open() { return this.#open; }
+
+  toggle(force = !this.open) {
+    if (force === this.open) return;
+    this.#open = force;
+    // Public styling hook; internal styles key off aria-expanded so the menu
+    // still works where custom states are unsupported.
+    force ? this.#internals.states?.add('open') : this.#internals.states?.delete('open');
+    this.#toggle.setAttribute('aria-expanded', String(force));
+  }
+
+  #onKeydown = (e) => {
+    if (e.key === 'Escape' && this.open) {
+      this.toggle(false);
+      this.#toggle.focus();
+    }
+  };
+
+  #onOutsidePointer = (e) => {
+    if (this.open && !e.composedPath().includes(this)) this.toggle(false);
+  };
+
+  #onFocusOut = (e) => {
+    // Collapse when keyboard focus leaves the navigation entirely.
+    if (this.open && e.relatedTarget && !this.contains(e.relatedTarget)
+        && !this.shadowRoot.contains(e.relatedTarget)) {
+      this.toggle(false);
+    }
+  };
+
+  #markCurrent() {
+    const here = location.pathname.replace(/\/$/, '') || '/';
+    for (const link of this.#slot.assignedElements()) {
+      if (!(link instanceof HTMLAnchorElement) || link.hasAttribute('data-no-current')) continue;
+      const path = new URL(link.href, location.href).pathname.replace(/\/$/, '') || '/';
+      if (path === here) link.setAttribute('aria-current', 'page');
+    }
+  }
+}
+
