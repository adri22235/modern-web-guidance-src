+import { attachTemplate, baseStyles, buttonStyles, define } from './shared-styles.js';
+
+const template = `
+  <style>
+    ${baseStyles}
+    :host {
+      --_image: none;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      min-height: var(--dg-hero-height, 60vh);
+      padding: 2rem 20px;
+      background:
+        linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        var(--_image) center / cover no-repeat,
+        var(--primary, #4e342e);
+      color: #fff;
+      text-align: center;
+    }
+    ::slotted([slot="heading"]) {
+      margin: 0 0 1rem;
+      font-size: clamp(2rem, 6vw, 3rem);
+      line-height: 1.2;
+    }
+    ::slotted(p) {
+      margin: 0;
+      max-width: 40ch;
+    }
+    .actions {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 12px;
+      margin-top: 15px;
+    }
+    ${buttonStyles('::slotted(a)', '::slotted(a:hover)', '::slotted(a:focus-visible)')}
+  </style>
+  <slot name="heading"></slot>
+  <slot></slot>
+  <div class="actions" part="actions"><slot name="actions"></slot></div>
+`;
+
+/**
+ * <hero-banner>
+ *
+ * Full-width hero with a darkened background image. The background image is
+ * purely decorative, so it is applied via CSS rather than as an <img>.
+ *
+ * Attributes:
+ *   image   Background image URL
+ *
+ * Slots:
+ *   heading    Main heading (typically an <h1>)
+ *   (default)  Supporting copy
+ *   actions    Call-to-action links (styled as buttons)
+ *
+ * CSS custom properties: --dg-hero-height
+ * CSS parts: actions
+ */
+class HeroBanner extends HTMLElement {
+  static observedAttributes = ['image'];
+
+  constructor() {
+    super();
+    attachTemplate(this, template);
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name !== 'image') return;
+    if (value) {
+      // CSS.escape isn't for URLs; JSON.stringify yields a safely quoted CSS string.
+      this.style.setProperty('--_image', `url(${JSON.stringify(value)})`);
+    } else {
+      this.style.removeProperty('--_image');
+    }
+  }
+}
+
+define('hero-banner', HeroBanner);
+
+export { HeroBanner };
