@@ -0,0 +1,89 @@
+/**
+ * Shared styling helpers for Daily Grind web components.
+ *
+ * Design tokens (colors) are defined as CSS custom properties on :root in
+ * index.html. Custom properties inherit through shadow boundaries, so every
+ * component can be themed from the page without breaking encapsulation.
+ */
+
+/** Base rules every component's shadow root should include. */
+export const baseStyles = `
+  :host {
+    box-sizing: border-box;
+  }
+  *, *::before, *::after {
+    box-sizing: inherit;
+  }
+  [hidden] {
+    display: none !important;
+  }
+  .visually-hidden {
+    position: absolute !important;
+    width: 1px;
+    height: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+    border: 0;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      transition-duration: 0.01ms !important;
+      animation-duration: 0.01ms !important;
+    }
+  }
+`;
+
+/**
+ * Button styles, generated for an arbitrary selector so they can be applied
+ * both to shadow-internal elements (e.g. `.btn`) and to slotted light-DOM
+ * links (e.g. `::slotted(a)`).
+ */
+export function buttonStyles(selector, hoverSelector = `${selector}:hover`, focusSelector = `${selector}:focus-visible`) {
+  return `
+    ${selector} {
+      display: inline-block;
+      background: var(--dg-btn-bg, var(--primary, #4e342e));
+      color: var(--dg-btn-color, #fff);
+      padding: 10px 20px;
+      text-decoration: none;
+      border: 0;
+      border-radius: 5px;
+      font: inherit;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+    ${hoverSelector} {
+      background: var(--dg-btn-bg-hover, var(--text, #3e2723));
+    }
+    ${focusSelector} {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 2px;
+    }
+  `;
+}
+
+/**
+ * Create a shadow root populated from a template string.
+ * Uses a cached <template> per component class so parsing happens once.
+ */
+const templateCache = new WeakMap();
+export function attachTemplate(host, html) {
+  const ctor = host.constructor;
+  let tpl = templateCache.get(ctor);
+  if (!tpl) {
+    tpl = document.createElement('template');
+    tpl.innerHTML = html;
+    templateCache.set(ctor, tpl);
+  }
+  const root = host.shadowRoot ?? host.attachShadow({ mode: 'open' });
+  root.replaceChildren(tpl.content.cloneNode(true));
+  return root;
+}
+
+/** Define a custom element only once (safe for repeated module loads). */
+export function define(name, ctor) {
+  if (!customElements.get(name)) customElements.define(name, ctor);
+}
