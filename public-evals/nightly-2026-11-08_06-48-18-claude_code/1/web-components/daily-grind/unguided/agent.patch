@@ -0,0 +1,82 @@
+import { attachTemplate, baseStyles, define } from './shared-styles.js';
+
+const template = `
+  <style>
+    ${baseStyles}
+    :host {
+      display: block;
+    }
+    .heading {
+      text-align: center;
+    }
+    ::slotted([slot="heading"]) {
+      margin: 0;
+    }
+    .status {
+      margin: 0.25rem 0 0;
+      text-align: center;
+      font-size: 0.9rem;
+      color: var(--primary, #4e342e);
+      min-height: 1.6em;
+    }
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(var(--dg-grid-min, 250px), 1fr));
+      gap: var(--dg-grid-gap, 20px);
+      margin-top: 20px;
+      padding: 0;
+      list-style: none;
+    }
+  </style>
+  <div class="heading" part="heading"><slot name="heading"></slot></div>
+  <p class="status" part="status" role="status" aria-live="polite"></p>
+  <div class="grid" part="grid"><slot></slot></div>
+`;
+
+/**
+ * <card-grid>
+ *
+ * Responsive grid section for <coffee-card> elements. It listens for
+ * `favorite-change` events from its cards and announces changes through a
+ * polite live region, so screen reader users hear the result of a toggle.
+ *
+ * Slots:
+ *   heading    Section heading (e.g. an <h2>)
+ *   (default)  Cards
+ *
+ * CSS custom properties: --dg-grid-min, --dg-grid-gap
+ * CSS parts: heading, status, grid
+ */
+class CardGrid extends HTMLElement {
+  #status;
+
+  constructor() {
+    super();
+    const root = attachTemplate(this, template);
+    this.#status = root.querySelector('.status');
+    this.addEventListener('favorite-change', (e) => this.#onFavoriteChange(e));
+  }
+
+  connectedCallback() {
+    // Expose the grid as a labelled region when a heading is provided.
+    const heading = this.querySelector('[slot="heading"]');
+    if (heading) {
+      if (!heading.id) heading.id = `card-grid-heading-${crypto.randomUUID?.() ?? Date.now()}`;
+      this.setAttribute('role', 'region');
+      this.setAttribute('aria-labelledby', heading.id);
+    }
+  }
+
+  #onFavoriteChange(event) {
+    const { name, favorite } = event.detail;
+    const count = this.querySelectorAll('coffee-card[favorite]').length;
+    const action = favorite ? 'added to' : 'removed from';
+    const subject = name || 'Item';
+    this.#status.textContent =
+      `${subject} ${action} favorites. ` + `${count} favorite${count === 1 ? '' : 's'} saved.`;
+  }
+}
+
+define('card-grid', CardGrid);
+
+export { CardGrid };
diff --git a/components/coffee-card.js b/components/coffee-card.js
new file mode 100644
index 0000000..d52d913
--- /dev/null
+++ b/components/coffee-card.js
@@ -0,0 +1,290 @@
+import { attachTemplate, baseStyles, buttonStyles, define } from './shared-styles.js';
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage may be unavailable (private mode, quota) — favorites stay in memory */
+  }
+}
+
+const template = `
+  <style>
+    ${baseStyles}
+    :host {
+      display: block;
+      container-type: inline-size;
+    }
+    article {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+      background: var(--dg-card-bg, #fff);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      overflow: hidden;
+      text-align: center;
+      transition: box-shadow 0.3s, transform 0.3s;
+    }
+    article:hover,
+    article:focus-within {
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
+      transform: translateY(-2px);
+    }
+    figure {
+      margin: 0;
+      aspect-ratio: 3 / 2;
+      background: var(--secondary, #d7ccc8);
+    }
+    img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+    .body {
+      display: flex;
+      flex-direction: column;
+      flex: 1;
+      padding: 20px;
+    }
+    .title {
+      margin: 0 0 10px;
+      font-size: 1.17rem;
+      font-weight: bold;
+      color: var(--primary, #4e342e);
+    }
+    .description {
+      flex: 1;
+    }
+    ::slotted(p) {
+      margin: 0;
+    }
+    .actions {
+      margin-top: 15px;
+    }
+    ${buttonStyles('.btn')}
+
+    .favorite {
+      position: absolute;
+      top: 10px;
+      right: 10px;
+      display: grid;
+      place-items: center;
+      width: 44px;
+      height: 44px;
+      padding: 0;
+      border: 0;
+      border-radius: 50%;
+      background: rgba(255, 255, 255, 0.92);
+      color: var(--primary, #4e342e);
+      cursor: pointer;
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
+      transition: transform 0.2s, color 0.2s;
+    }
+    .favorite:hover {
+      transform: scale(1.08);
+    }
+    .favorite:focus-visible {
+      outline: 3px solid var(--accent, #ffab40);
+      outline-offset: 2px;
+    }
+    .favorite svg {
+      width: 22px;
+      height: 22px;
+      fill: transparent;
+      stroke: currentColor;
+      stroke-width: 2;
+      transition: fill 0.2s;
+    }
+    .favorite[aria-pressed="true"] {
+      color: #c62828;
+    }
+    .favorite[aria-pressed="true"] svg {
+      fill: currentColor;
+    }
+    /* When there's no image, keep the heart from overlapping the title. */
+    :host(:not([image])) .body {
+      padding-top: 60px;
+    }
+  </style>
+  <article part="card">
+    <figure part="media" hidden>
+      <img part="image" loading="lazy" decoding="async" alt="">
+    </figure>
+    <button class="favorite" part="favorite" type="button" aria-pressed="false">
+      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+        <path d="M12 21s-7.5-4.6-10-9.3C.3 8.4 2.3 4 6.3 4c2.2 0 3.7 1.2 4.7 2.6l1 1.4 1-1.4C14 5.2 15.5 4 17.7 4c4 0 6 4.4 4.3 7.7C19.5 16.4 12 21 12 21z"/>
+      </svg>
+      <span class="visually-hidden favorite-label">Add to favorites</span>
+    </button>
+    <div class="body">
+      <div class="title" role="heading" aria-level="3" part="title"><slot name="name"></slot></div>
+      <div class="description" part="description"><slot></slot></div>
+      <div class="actions">
+        <a class="btn" part="link" hidden>
+          <span class="link-text">View Details</span><span class="visually-hidden link-context"></span>
+        </a>
+      </div>
+    </div>
+  </article>
+`;
+
+/**
+ * <coffee-card>
+ *
+ * A menu item card with an optional image, a details link and a persistent
+ * "favorite" toggle.
+ *
+ * Attributes:
+ *   href          URL of the details page (link hidden when absent)
+ *   image         Image URL
+ *   image-alt     Alt text for the image (omit for decorative images)
+ *   heading-level Heading level for the item name, 1–6 (default 3)
+ *   link-label    Visible link text (default "View Details")
+ *   item-id       Stable id used to persist favorites (defaults to href)
+ *   favorite      Reflects / sets the favorited state
+ *
+ * Slots:
+ *   name          The item name (rendered as a heading)
+ *   (default)     Description content
+ *
+ * Events:
+ *   favorite-change  { detail: { id, name, favorite } } — bubbles, composed
+ *
+ * CSS parts: card, media, image, title, description, link, favorite
+ */
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href', 'image', 'image-alt', 'heading-level', 'link-label', 'favorite'];
+
+  #root;
+  #els;
+
+  constructor() {
+    super();
+    this.#root = attachTemplate(this, template);
+    const $ = (s) => this.#root.querySelector(s);
+    this.#els = {
+      figure: $('figure'),
+      img: $('img'),
+      title: $('.title'),
+      nameSlot: $('slot[name="name"]'),
+      link: $('.btn'),
+      linkText: $('.link-text'),
+      linkContext: $('.link-context'),
+      favorite: $('.favorite'),
+      favoriteLabel: $('.favorite-label'),
+    };
+
+    this.#els.favorite.addEventListener('click', () => this.toggleFavorite());
+    this.#els.nameSlot.addEventListener('slotchange', () => this.#updateLabels());
+    this.#els.img.addEventListener('error', () => {
+      this.#els.figure.hidden = true;
+    });
+  }
+
+  connectedCallback() {
+    // Restore persisted favorite state unless explicitly set in markup.
+    if (!this.hasAttribute('favorite') && this.itemId && readFavorites().has(this.itemId)) {
+      this.toggleAttribute('favorite', true);
+    }
+    this.#updateLabels();
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    const { figure, img, title, link, linkText } = this.#els;
+    switch (name) {
+      case 'href':
+        link.hidden = value == null;
+        if (value == null) link.removeAttribute('href');
+        else link.href = value;
+        break;
+      case 'image':
+        figure.hidden = !value;
+        if (value) img.src = value;
+        else img.removeAttribute('src');
+        break;
+      case 'image-alt':
+        img.alt = value ?? '';
+        break;
+      case 'heading-level': {
+        const level = Math.min(6, Math.max(1, parseInt(value, 10) || 3));
+        title.setAttribute('aria-level', String(level));
+        break;
+      }
+      case 'link-label':
+        linkText.textContent = value || 'View Details';
+        break;
+      case 'favorite':
+        this.#updateLabels();
+        break;
+    }
+  }
+
+  /** The item name as plain text, taken from the `name` slot. */
+  get name() {
+    return this.#els.nameSlot
+      .assignedNodes({ flatten: true })
+      .map((n) => n.textContent)
+      .join('')
+      .trim();
+  }
+
+  get itemId() {
+    return this.getAttribute('item-id') || this.getAttribute('href') || '';
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  toggleFavorite(force) {
+    const next = force ?? !this.favorite;
+    this.favorite = next;
+
+    if (this.itemId) {
+      const favorites = readFavorites();
+      next ? favorites.add(this.itemId) : favorites.delete(this.itemId);
+      writeFavorites(favorites);
+    }
+
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { id: this.itemId, name: this.name, favorite: next },
+      }),
+    );
+  }
+
+  #updateLabels() {
+    const { favorite, favoriteLabel, linkContext } = this.#els;
+    const name = this.name;
+    const isFav = this.favorite;
+
+    favorite.setAttribute('aria-pressed', String(isFav));
+    // Constant label + aria-pressed is the recommended toggle pattern.
+    favoriteLabel.textContent = name ? `Favorite ${name}` : 'Favorite';
+    // Give the generic "View Details" link a unique accessible name.
+    linkContext.textContent = name ? `: ${name}` : '';
+  }
+}
+
+define('coffee-card', CoffeeCard);
+
+export { CoffeeCard };
