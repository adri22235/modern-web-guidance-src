+    .bars::before,
+    .bars::after {
+      content: "";
+      position: absolute;
+      left: 0;
+    }
+    .bars::before { top: -6px; }
+    .bars::after { top: 6px; }
+    .toggle[aria-expanded="true"] .bars { background: transparent; }
+    .toggle[aria-expanded="true"] .bars::before { transform: translateY(6px) rotate(45deg); }
+    .toggle[aria-expanded="true"] .bars::after { transform: translateY(-6px) rotate(-45deg); }
+
+    @media (max-width: 720px) {
+      .toggle {
+        display: inline-flex;
+      }
+      .menu {
+        flex-basis: 100%;
+        flex-direction: column;
+        align-items: flex-start;
+        gap: 14px;
+        padding-top: 1rem;
+      }
+      .menu:not(.open) {
+        display: none;
+      }
+    }
+  </style>
+  <nav part="nav">
+    <slot name="brand"></slot>
+    <button class="toggle" part="toggle" type="button" aria-expanded="false" aria-controls="menu">
+      <span class="bars" aria-hidden="true"></span>
+      <span class="toggle-label">Menu</span>
+    </button>
+    <div class="menu" id="menu" part="menu"><slot></slot></div>
+  </nav>
+`;
+
+/**
+ * <site-nav>
+ *
+ * Sticky site navigation with a collapsible, keyboard-accessible menu on
+ * narrow screens. Links stay in the light DOM (good for SEO and no-JS).
+ *
+ * Attributes:
+ *   label   Accessible name for the navigation landmark (default "Main")
+ *
+ * Slots:
+ *   brand      Logo / home link
+ *   (default)  Navigation links (<a> elements)
+ *
+ * Behaviour:
+ *   - Toggle button exposes aria-expanded / aria-controls
+ *   - Escape closes the menu and returns focus to the toggle
+ *   - Selecting a link or resizing to desktop closes the menu
+ *   - The link matching the current URL gets aria-current="page"
+ *
+ * CSS parts: nav, toggle, menu
+ */
+class SiteNav extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+  #toggle;
+  #menu;
+  #mql = window.matchMedia('(max-width: 720px)');
+  #onMqlChange = () => {
+    if (!this.#mql.matches) this.close();
+  };
+
+  constructor() {
+    super();
+    const root = attachTemplate(this, template);
+    this.#nav = root.querySelector('nav');
+    this.#toggle = root.querySelector('.toggle');
+    this.#menu = root.querySelector('.menu');
+    this.#nav.setAttribute('aria-label', 'Main');
+
+    this.#toggle.addEventListener('click', () => (this.expanded ? this.close() : this.open()));
+    this.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && this.expanded) {
+        this.close();
+        this.#toggle.focus();
+      }
+    });
+    this.addEventListener('click', (e) => {
+      if (e.target instanceof Element && e.target.closest('a') && this.expanded) this.close();
+    });
+    // Close when focus leaves the navigation entirely.
+    this.addEventListener('focusout', (e) => {
+      if (this.expanded && e.relatedTarget && !this.contains(e.relatedTarget) && !this.shadowRoot.contains(e.relatedTarget)) {
+        this.close();
+      }
+    });
+  }
+
+  connectedCallback() {
+    this.#mql.addEventListener('change', this.#onMqlChange);
+    this.#markCurrent();
+  }
+
+  disconnectedCallback() {
+    this.#mql.removeEventListener('change', this.#onMqlChange);
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'label') this.#nav.setAttribute('aria-label', value || 'Main');
+  }
+
+  get expanded() {
+    return this.#toggle.getAttribute('aria-expanded') === 'true';
+  }
+
+  open() {
+    this.#toggle.setAttribute('aria-expanded', 'true');
+    this.#menu.classList.add('open');
+  }
+
+  close() {
+    this.#toggle.setAttribute('aria-expanded', 'false');
+    this.#menu.classList.remove('open');
+  }
+
+  #markCurrent() {
+    const here = window.location.pathname.replace(/\/$/, '') || '/';
+    for (const link of this.querySelectorAll('a[href]')) {
+      if (link.hasAttribute('aria-current')) continue;
+      const path = new URL(link.href, window.location.href).pathname.replace(/\/$/, '') || '/';
+      if (path === here && link.getAttribute('slot') !== 'brand') link.setAttribute('aria-current', 'page');
+    }
+  }
+}
+
+define('site-nav', SiteNav);
+
+export { SiteNav };
