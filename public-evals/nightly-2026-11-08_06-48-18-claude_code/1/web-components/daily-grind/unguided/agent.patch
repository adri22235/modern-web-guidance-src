+      gap: 0.5rem;
+      background: transparent;
+      color: inherit;
+      border: 1px solid rgba(255, 255, 255, 0.6);
+      border-radius: 4px;
+      padding: 6px 10px;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+    .toggle:focus-visible {
+      outline: 2px solid var(--accent, #ffab40);
