+import { attachTemplate, baseStyles, define } from './shared-styles.js';
+
+const template = `
+  <style>
+    ${baseStyles}
+    :host {
+      display: block;
+      background: var(--secondary, #d7ccc8);
+      color: var(--text, #3e2723);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+    nav {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      margin-bottom: 20px;
+    }
+    ::slotted(a) {
+      padding: 0 10px;
+      color: inherit;
+      text-decoration: none;
+      font-size: 0.85rem;
+      border-left: 1px solid currentColor;
+      line-height: 1.2;
+    }
+    ::slotted(a:first-child) {
+      border-left: 0;
+    }
+    ::slotted(a:hover) {
+      text-decoration: underline;
+    }
+    ::slotted(a:focus-visible) {
+      outline: 2px solid var(--primary, #4e342e);
+      outline-offset: 2px;
+    }
+    ::slotted(p) {
+      margin: 0;
+    }
+  </style>
+  <nav part="links"><slot name="links"></slot></nav>
+  <slot></slot>
+`;
+
+/**
+ * <site-footer>
+ *
+ * Site footer with a labelled secondary navigation landmark.
+ *
+ * Attributes:
+ *   label   Accessible name for the link navigation (default "Footer")
+ *
+ * Slots:
+ *   links      Footer links (<a slot="links">)
+ *   (default)  Additional content such as copyright text
+ *
+ * CSS parts: links
+ */
+class SiteFooter extends HTMLElement {
+  static observedAttributes = ['label'];
+
+  #nav;
+
+  constructor() {
+    super();
+    this.#nav = attachTemplate(this, template).querySelector('nav');
+    this.#nav.setAttribute('aria-label', 'Footer');
+  }
+
+  connectedCallback() {
+    // <footer> semantics (contentinfo landmark) for the custom element host.
+    if (!this.hasAttribute('role')) this.setAttribute('role', 'contentinfo');
+  }
+
+  attributeChangedCallback(name, _old, value) {
+    if (name === 'label') this.#nav.setAttribute('aria-label', value || 'Footer');
+  }
+}
+
+define('site-footer', SiteFooter);
+
+export { SiteFooter };
