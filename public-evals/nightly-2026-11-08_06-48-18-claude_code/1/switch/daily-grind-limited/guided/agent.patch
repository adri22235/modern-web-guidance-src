+  <script>
+    (() => {
+      const KEY = 'pref:seasonal-specials';
+      const toggle = document.getElementById('pref-specials');
+      const status = document.getElementById('pref-specials-status');
+
+      const render = () => {
+        status.textContent = toggle.checked
+          ? 'On — you\'ll receive seasonal specials emails.'
+          : 'Off — you won\'t receive seasonal specials emails.';
+      };
+
+      try {
+        toggle.checked = localStorage.getItem(KEY) === 'on';
+      } catch { /* storage unavailable; use default (off) */ }
+      render();
+
+      toggle.addEventListener('change', () => {
+        try {
+          localStorage.setItem(KEY, toggle.checked ? 'on' : 'off');
+        } catch { /* ignore storage errors */ }
+        render();
+      });
+    })();
+  </script>
+
