+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('https://esm.sh/input-switch-polyfill');
+    }
+
+    const KEY = 'pref:seasonal-specials';
+    const toggle = document.getElementById('pref-specials');
+    const status = document.getElementById('pref-status');
+
+    const render = () => {
+      status.textContent = `Seasonal specials emails are ${toggle.checked ? 'on' : 'off'}.`;
+    };
+
+    try {
+      toggle.checked = localStorage.getItem(KEY) === 'true';
+    } catch { /* storage unavailable */ }
+    render();
+
+    toggle.addEventListener('change', () => {
+      try {
+        localStorage.setItem(KEY, String(toggle.checked));
+      } catch { /* storage unavailable */ }
+      render();
+    });
+  </script>
+
