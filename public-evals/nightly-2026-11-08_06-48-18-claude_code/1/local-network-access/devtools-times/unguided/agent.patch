@@ -0,0 +1,49 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+
+const siteOrigin = Astro.url.origin;
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-5xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2 pb-2 border-b-2">Developer Diagnostics</h1>
+    <p class="text-gray-700 mb-8">
+      Connect this page to a hardware test device on your private network and to the companion CLI on your
+      computer to check that both are reachable and healthy.
+    </p>
+
+    <DiagnosticsConnect client:only="react" />
+
+    <details class="mt-10 border-t border-gray-200 pt-6">
+      <summary class="cursor-pointer font-semibold text-gray-900">Setting up a target</summary>
+      <div class="prose prose-sm max-w-none mt-4">
+        <p>
+          The widget sends a single read-only <code>GET /diagnostics/v1/status</code> request with an
+          <code>Authorization: Bearer &lt;pairing-token&gt;</code> header. To accept it, the device or CLI must:
+        </p>
+        <ul>
+          <li>Generate a random pairing token and show it locally (device display or terminal output).</li>
+          <li>
+            Answer the CORS preflight (<code>OPTIONS</code>) and the <code>GET</code> with
+            <code>Access-Control-Allow-Origin: {siteOrigin}</code> (this exact origin, never <code>*</code>),
+            <code>Access-Control-Allow-Headers: Authorization, Accept</code>,
+            <code>Access-Control-Allow-Methods: GET</code>, and
+            <code>Access-Control-Allow-Private-Network: true</code>.
+          </li>
+          <li>Reject requests with a missing or wrong token with <code>401</code>.</li>
+          <li>
+            Validate the <code>Host</code> header (accept only its own IP / <code>127.0.0.1</code> /
+            <code>localhost</code>) to defend against DNS rebinding.
+          </li>
+          <li>Return a small JSON body (under 64 KB), e.g. <code>{'{"name":"rig-01","firmware":"2.4.1","uptime":3600}'}</code>.</li>
+          <li>The companion CLI should bind to <code>127.0.0.1</code> only, not <code>0.0.0.0</code>.</li>
+        </ul>
+        <p>
+          In Chrome, the first connection triggers a Local Network Access permission prompt; you must allow it for the
+          request to go through.
+        </p>
+      </div>
+    </details>
+  </div>
+</Layout>
