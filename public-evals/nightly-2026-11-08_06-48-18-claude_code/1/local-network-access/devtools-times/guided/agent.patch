@@ -0,0 +1,38 @@
+---
+import Layout from '../layouts/Layout.astro';
+import DiagnosticsConnect from '../components/DiagnosticsConnect';
+
+const siteOrigin = new URL(Astro.site ?? Astro.url).origin;
+---
+
+<Layout title="Developer Diagnostics | The DevTools Times">
+  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex flex-col gap-8">
+    <header class="border-b border-gray-300 pb-6">
+      <p class="text-xs font-bold uppercase tracking-wider text-amber-600">Developer tools</p>
+      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mt-1">Diagnostics connection</h1>
+      <p class="text-gray-700 mt-3 max-w-3xl">
+        Connect this page to a hardware test device on your private Wi‑Fi network and to the
+        companion CLI running on your own machine. Requests go directly from your browser to those
+        targets — nothing is relayed through our servers — and only after you click
+        <strong>Connect</strong> and approve your browser’s permission prompt.
+      </p>
+    </header>
+
+    <DiagnosticsConnect client:only="react" />
+
+    <section class="prose prose-sm max-w-3xl text-gray-700">
+      <h2>Setting up your targets</h2>
+      <p>
+        Your device or CLI must allow cross-origin requests from this site by answering
+        <code>GET</code> requests (and <code>OPTIONS</code> preflights) with:
+      </p>
+      <pre><code>Access-Control-Allow-Origin: {siteOrigin}</code></pre>
+      <p>
+        Only allow this exact origin — avoid <code>*</code>, so other websites can’t read data from
+        your device. Browsers that support Local Network Access (Chrome and Edge 145+) will ask you
+        once per site for “Local network” and “Loopback network” access; you can change that later
+        in site settings.
+      </p>
+    </section>
+  </div>
+</Layout>
