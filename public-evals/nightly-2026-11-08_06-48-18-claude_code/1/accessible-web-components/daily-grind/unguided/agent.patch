diff --git a/favorite-toggle.js b/favorite-toggle.js
new file mode 100644
index 0000000..09f6b2f
--- /dev/null
+++ b/favorite-toggle.js
@@ -0,0 +1,179 @@
+/**
+ * <favorite-toggle> — a reusable on/off switch for marking an item as a favorite.
+ *
+ * Attributes:
+ *   item-id  Stable key used to persist the state in localStorage (optional;
+ *            without it the state is not persisted).
+ *   label    Accessible name, e.g. "Favorite Maple Oat Latte". Defaults to "Favorite".
+ *   checked  Present when the toggle is on. Reflects the `checked` property.
+ *   disabled Prevents interaction.
+ *
+ * Events:
+ *   change   Fired when the user toggles. `event.detail` = { checked, itemId }.
+ *
+ * Styling hooks (CSS custom properties):
+ *   --favorite-toggle-on     Track color when on   (default: #ffab40)
+ *   --favorite-toggle-off    Track color when off  (default: #bcaaa4)
+ *   --favorite-toggle-text   Label text color      (default: inherit)
+ */
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
+    return parsed && typeof parsed === 'object' ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+function writeFavorite(id, on) {
+  try {
+    const favorites = readFavorites();
+    if (on) favorites[id] = true;
+    else delete favorites[id];
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(favorites));
+  } catch {
+    /* Storage unavailable (private mode, quota) — keep in-memory state only. */
+  }
+}
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-block;
+      --_on: var(--favorite-toggle-on, #ffab40);
+      --_off: var(--favorite-toggle-off, #bcaaa4);
+    }
+    :host([hidden]) { display: none; }
+
+    button {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5rem;
+      padding: 0.25rem 0.5rem;
+      border: 0;
+      border-radius: 999px;
+      background: transparent;
+      color: var(--favorite-toggle-text, inherit);
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+    button:focus-visible {
+      outline: 2px solid var(--_on);
+      outline-offset: 2px;
+    }
+    button:disabled { cursor: not-allowed; opacity: 0.5; }
+
+    .track {
+      position: relative;
+      width: 2.5rem;
+      height: 1.4rem;
+      border-radius: 999px;
+      background: var(--_off);
+      transition: background-color 0.2s;
+      flex-shrink: 0;
+    }
+    .thumb {
+      position: absolute;
+      top: 0.15rem;
+      left: 0.15rem;
+      width: 1.1rem;
+      height: 1.1rem;
+      border-radius: 50%;
+      background: #fff;
+      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
+      display: grid;
+      place-items: center;
+      font-size: 0.7rem;
+      line-height: 1;
+      color: var(--_off);
+      transition: transform 0.2s, color 0.2s;
+    }
+    button[aria-checked="true"] .track { background: var(--_on); }
+    button[aria-checked="true"] .thumb {
+      transform: translateX(1.1rem);
+      color: #c62828;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .track, .thumb { transition: none; }
+    }
+  </style>
+  <button type="button" role="switch" aria-checked="false" part="button">
+    <span class="track" part="track" aria-hidden="true">
+      <span class="thumb" part="thumb">&#9829;</span>
+    </span>
+    <span class="text" part="label">Favorite</span>
+  </button>
+`;
+
+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['checked', 'label', 'disabled', 'item-id'];
+
+  #button;
+  #onStorage = (event) => {
+    if (event.key === STORAGE_KEY || event.key === null) this.#loadPersisted();
+  };
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.appendChild(template.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#button.addEventListener('click', () => this.toggle());
+  }
+
+  connectedCallback() {
+    this.#loadPersisted();
+    this.#render();
+    window.addEventListener('storage', this.#onStorage);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('storage', this.#onStorage);
+  }
+
+  attributeChangedCallback(name) {
+    if (name === 'item-id' && this.isConnected) this.#loadPersisted();
+    this.#render();
+  }
+
+  get checked() { return this.hasAttribute('checked'); }
+  set checked(value) { this.toggleAttribute('checked', Boolean(value)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  get itemId() { return this.getAttribute('item-id'); }
+
+  /** Flip the state as if the user clicked; persists and fires `change`. */
+  toggle() {
+    if (this.disabled) return;
+    this.checked = !this.checked;
+    if (this.itemId) writeFavorite(this.itemId, this.checked);
+    this.dispatchEvent(new CustomEvent('change', {
+      bubbles: true,
+      composed: true,
+      detail: { checked: this.checked, itemId: this.itemId },
+    }));
+  }
+
+  #loadPersisted() {
+    if (!this.itemId) return;
+    this.checked = Boolean(readFavorites()[this.itemId]);
+  }
+
+  #render() {
+    if (!this.#button) return;
+    this.#button.setAttribute('aria-checked', String(this.checked));
+    this.#button.setAttribute('aria-label', this.getAttribute('label') || 'Favorite');
+    this.#button.disabled = this.disabled;
+  }
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
