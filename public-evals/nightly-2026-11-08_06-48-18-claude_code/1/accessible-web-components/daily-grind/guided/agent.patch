@@ -0,0 +1,251 @@
+/**
+ * <favorite-toggle> — a reusable, accessible on/off switch for marking an item as a favorite.
+ *
+ * Usage:
+ *   <favorite-toggle name="favorites" value="cold-brew" storage-key="cold-brew"
+ *                    aria-label="Favorite Cold Brew">Favorite</favorite-toggle>
+ *
+ * Attributes:
+ *   checked      Initial (default) state, like a native checkbox's `checked` attribute.
+ *   disabled     Disables the control.
+ *   name/value   Form submission: submits `value` (default "on") under `name` when on.
+ *   storage-key  Optional. Persists the state in localStorage under "favorite:<key>".
+ *
+ * Properties: checked (boolean), defaultChecked, disabled, value, form, name.
+ * Events: `input` and `change` (bubbling) whenever the user toggles it.
+ * Styling: `:state(checked)` on the host; parts `track`, `thumb`, `label`;
+ *          custom properties --favorite-on-color, --favorite-off-color, --favorite-focus-color.
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.5em;
+      cursor: pointer;
+      user-select: none;
+      border-radius: 999px;
+      font: inherit;
+      color: inherit;
+      -webkit-tap-highlight-color: transparent;
+    }
+    :host([hidden]) { display: none; }
+    :host(:focus-visible) {
+      outline: 3px solid var(--favorite-focus-color, #ff8c00);
+      outline-offset: 4px;
+    }
+    :host(:disabled) {
+      cursor: not-allowed;
+      opacity: 0.55;
+    }
+    .track {
+      position: relative;
+      inline-size: 2.75em;
+      block-size: 1.5em;
+      border-radius: 999px;
+      background: var(--favorite-off-color, #bcaaa4);
+      transition: background-color 0.2s ease;
+      flex: none;
+    }
+    .thumb {
+      position: absolute;
+      inset-block-start: 0.15em;
+      inset-inline-start: 0.15em;
+      inline-size: 1.2em;
+      block-size: 1.2em;
+      border-radius: 50%;
+      background: #fff;
+      box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
+      display: grid;
+      place-items: center;
+      transition: translate 0.2s ease;
+    }
+    .thumb svg {
+      inline-size: 0.8em;
+      block-size: 0.8em;
+      fill: none;
+      stroke: var(--favorite-off-color, #bcaaa4);
+      stroke-width: 2.5;
+      transition: fill 0.2s ease, stroke 0.2s ease;
+    }
+    :host(:state(checked)) .track {
+      background: var(--favorite-on-color, #c62828);
+    }
+    :host(:state(checked)) .thumb {
+      translate: 1.25em 0;
+    }
+    :host(:dir(rtl):state(checked)) .thumb {
+      translate: -1.25em 0;
+    }
+    :host(:state(checked)) .thumb svg {
+      fill: var(--favorite-on-color, #c62828);
+      stroke: var(--favorite-on-color, #c62828);
+    }
+    @media (prefers-reduced-motion: reduce) {
+      .track, .thumb, .thumb svg { transition: none; }
+    }
+    @media (forced-colors: active) {
+      .track { border: 1px solid CanvasText; }
+      :host(:state(checked)) .track { background: Highlight; }
+    }
+  </style>
+  <span class="track" part="track" aria-hidden="true">
+    <span class="thumb" part="thumb">
+      <svg viewBox="0 0 24 24" focusable="false">
+        <path d="M12 21s-7.5-4.6-9.6-9.3C.9 8.2 3 4.5 6.6 4.5c2.1 0 3.5 1.1 4.4 2.4h2c.9-1.3 2.3-2.4 4.4-2.4 3.6 0 5.7 3.7 4.2 7.2C19.5 16.4 12 21 12 21z"/>
+      </svg>
+    </span>
+  </span>
+  <span class="label" part="label"><slot>Favorite</slot></span>
+`;
+
+const STORAGE_PREFIX = 'favorite:';
+
+function readStored(key) {
+  try {
+    const v = localStorage.getItem(STORAGE_PREFIX + key);
+    return v === null ? null : v === 'true';
+  } catch {
+    return null; // storage unavailable (privacy mode, sandboxed iframe, etc.)
+  }
+}
+
+function writeStored(key, on) {
+  try {
+    localStorage.setItem(STORAGE_PREFIX + key, String(on));
+  } catch {
+    /* ignore */
+  }
+}
+
+export class FavoriteToggle extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['checked', 'value'];
+
+  #internals;
+  #checked = false;
+  #dirty = false; // true once the state has been set by user, script, or storage
+  #formDisabled = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'switch';
+    this.#internals.ariaChecked = 'false';
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+
+    this.addEventListener('click', this.#onClick);
+    this.addEventListener('keydown', this.#onKeyDown);
+  }
+
+  connectedCallback() {
+    // Host is the interactive control (role lives on the host), so it takes focus itself.
+    if (!this.hasAttribute('tabindex')) this.tabIndex = 0;
+
+    if (!this.#dirty) {
+      const key = this.storageKey;
+      const stored = key ? readStored(key) : null;
+      if (stored !== null) {
+        this.#dirty = true;
+        this.#setChecked(stored);
+      } else {
+        this.#setChecked(this.defaultChecked);
+      }
+    }
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'checked' && !this.#dirty) this.#setChecked(newVal !== null);
+    if (name === 'value') this.#syncFormValue();
+  }
+
+  // --- Public API ---------------------------------------------------------
+
+  get checked() { return this.#checked; }
+  set checked(on) {
+    this.#dirty = true;
+    this.#setChecked(!!on);
+  }
+
+  get defaultChecked() { return this.hasAttribute('checked'); }
+  set defaultChecked(on) { this.toggleAttribute('checked', !!on); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(on) { this.toggleAttribute('disabled', !!on); }
+
+  get value() { return this.getAttribute('value') ?? 'on'; }
+  set value(v) { this.setAttribute('value', String(v)); }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(v) { this.setAttribute('name', String(v)); }
+
+  get storageKey() { return this.getAttribute('storage-key') ?? ''; }
+  set storageKey(v) {
+    v ? this.setAttribute('storage-key', v) : this.removeAttribute('storage-key');
+  }
+
+  get form() { return this.#internals.form; }
+  get type() { return 'checkbox'; }
+
+  toggle(force) {
+    this.checked = force === undefined ? !this.#checked : !!force;
+    return this.#checked;
+  }
+
+  // --- Form lifecycle -----------------------------------------------------
+
+  formDisabledCallback(disabled) {
+    // Don't touch the host's `disabled` attribute here (fieldset toggles would stick).
+    this.#formDisabled = disabled;
+    this.#internals.ariaDisabled = String(disabled);
+  }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#setChecked(this.defaultChecked);
+    if (this.storageKey) writeStored(this.storageKey, this.#checked);
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#setChecked(state != null);
+  }
+
+  // --- Internals ----------------------------------------------------------
+
+  #setChecked(on) {
+    this.#checked = on;
+    this.#internals.ariaChecked = String(on);
+    if (on) this.#internals.states.add('checked');
+    else this.#internals.states.delete('checked');
+    this.#syncFormValue();
+  }
+
+  #syncFormValue() {
+    this.#internals.setFormValue(this.#checked ? this.value : null);
+  }
+
+  #userToggle() {
+    if (this.#formDisabled) return;
+    this.checked = !this.#checked;
+    if (this.storageKey) writeStored(this.storageKey, this.#checked);
+    this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+
+  #onClick = () => this.#userToggle();
+
+  #onKeyDown = (e) => {
+    if (e.key === ' ' || e.key === 'Enter') {
+      e.preventDefault(); // stop page scroll on Space
+      this.#userToggle();
+    }
+  };
+}
+
+if (!customElements.get('favorite-toggle')) {
+  customElements.define('favorite-toggle', FavoriteToggle);
+}
