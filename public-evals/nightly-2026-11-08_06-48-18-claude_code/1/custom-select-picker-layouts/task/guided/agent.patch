+  <script>
+    // Native <select> only maps Up/Down; add Left/Right so arrows follow the 3-column grid.
+    document.getElementById('roast-picker').addEventListener('keydown', (e) => {
+      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+      const select = e.currentTarget;
+      const current = document.activeElement;
+      if (!select.matches(':open') || !(current instanceof HTMLOptionElement)) return;
+      const x = current.getBoundingClientRect().left;
+      const dir = e.key === 'ArrowRight' ? 1 : -1;
+      const next = [...select.options]
+        .map((o) => ({ o, dx: (o.getBoundingClientRect().left - x) * dir }))
+        .filter(({ dx }) => dx > 1)
+        .sort((a, b) => a.dx - b.dx)[0];
+      if (next) {
+        e.preventDefault();
+        next.o.focus();
+      }
+    });
+  </script>
