+      display: none;
+    }
+
+    @supports (appearance: base-select) {
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+        flex: 1;
+        font-weight: 600;
+      }
+
+      .roast-select selectedcontent img {
+        width: 28px;
+        height: 28px;
+        border-radius: 50%;
+        object-fit: cover;
+      }
+
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+
+      /* 3-column grid picker */
+      .roast-select::picker(select) {
+        padding: 12px;
+        margin-top: 6px;
+        border: none;
+        border-radius: 12px;
+        background: var(--light);
+        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
+        width: min(480px, 92vw);
+        justify-self: anchor-center;
+        position-try-fallbacks: flip-block;
+      }
+
+      .roast-select:open::picker(select) {
+        display: grid;
+        grid-template-columns: repeat(3, 1fr);
+        gap: 10px;
+      }
+
+      .roast-select option {
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 4px;
+        padding: 8px 8px 10px;
+        border: 2px solid transparent;
+        border-radius: 10px;
+        background: white;
+        color: var(--text);
+        text-align: center;
+        cursor: pointer;
+        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
+      }
+
+      .roast-select option::checkmark {
+        display: none;
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        border-color: var(--secondary);
+        transform: translateY(-2px);
+        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.12);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        border-color: var(--accent);
+        background: #fff8ee;
+      }
+
+      .roast-select option img {
+        width: 100%;
+        aspect-ratio: 4 / 3;
+        object-fit: cover;
+        border-radius: 6px;
+        margin-bottom: 4px;
+      }
+
+      .roast-name {
