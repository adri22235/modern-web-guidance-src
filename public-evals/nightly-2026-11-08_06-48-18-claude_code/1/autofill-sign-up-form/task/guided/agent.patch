+  <script>
+    (() => {
+      const form = document.getElementById('signup-form');
+      const password = document.getElementById('signup-password');
+      const toggle = document.getElementById('signup-toggle-password');
+
+      toggle.addEventListener('click', () => {
+        const show = password.type === 'password';
+        password.type = show ? 'text' : 'password';
+        toggle.setAttribute('aria-pressed', String(show));
+        toggle.textContent = show ? 'Hide password' : 'Show password';
+      });
+
+      // Keep aria-invalid in sync with the :user-invalid visual state
+      const syncAria = (el) => {
+        if (!el.matches || !el.matches('input')) return;
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      };
+      form.addEventListener('blur', (e) => syncAria(e.target), true);
+      form.addEventListener('input', (e) => {
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+      });
+      form.addEventListener('invalid', (e) => {
+        // Submission attempts mark fields as user-interacted
+        requestAnimationFrame(() => syncAria(e.target));
+      }, true);
+
+      // Prevent double-posts once a valid submission is underway
+      form.addEventListener('submit', () => {
+        password.type = 'password';
+        form.querySelector('button[type="submit"]').disabled = true;
+      });
+    })();
+  </script>
+
