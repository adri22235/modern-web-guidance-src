+      object-fit: cover;
+    }
+
+    .hovercard-body {
+      padding: 14px 16px 16px;
+    }
+
+    .hovercard-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 12px;
+    }
+
+    .hovercard h4 {
+      font-size: 1.1rem;
+      color: var(--primary);
+    }
+
+    .hovercard .price {
+      font-weight: bold;
+      color: var(--primary);
+      white-space: nowrap;
+    }
+
+    .hovercard .url {
+      font-size: 0.75rem;
+      color: #8d6e63;
+      margin-bottom: 8px;
+    }
+
+    .hovercard .summary {
+      font-size: 0.9rem;
+      margin-bottom: 10px;
