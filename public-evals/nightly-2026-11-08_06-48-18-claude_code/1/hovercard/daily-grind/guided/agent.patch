+
+    .hovercard dd {
+      font-weight: 600;
+    }
+
+    .hovercard .tags {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 6px;
+      list-style: none;
+      margin-bottom: 12px;
+    }
+
+    .hovercard .tags li {
+      font-size: 0.72rem;
+      border: 1px solid var(--secondary);
+      border-radius: 999px;
+      padding: 2px 8px;
+    }
+
+    .hovercard .order-link {
+      display: inline-block;
+      background: var(--accent);
