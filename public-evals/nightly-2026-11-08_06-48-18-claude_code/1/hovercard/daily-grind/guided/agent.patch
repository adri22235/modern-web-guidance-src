+    /* Hovercards (drink page previews) */
+    [interestfor] {
+      /* Polyfill reads the custom properties; native reads interest-delay-*. */
+      --interest-delay-start: 0.3s;
+      --interest-delay-end: 0.2s;
+      interest-delay-start: var(--interest-delay-start);
+      interest-delay-end: var(--interest-delay-end);
+    }
+
+    /* Skip the open delay when moving between triggers while a card is open. */
+    :root:has(:is(:interest-source, .interest-source)) [interestfor] {
+      --interest-delay-start: 0s;
+      interest-delay-start: 0s;
+    }
+
+    /* Explicit anchor names: the anchor-positioning polyfill ignores implicit anchors. */
+    #trigger-maple { anchor-name: --trigger-maple; }
+    #trigger-espresso { anchor-name: --trigger-espresso; }
+    #trigger-cold-brew { anchor-name: --trigger-cold-brew; }
+    #preview-maple { position-anchor: --trigger-maple; }
+    #preview-espresso { position-anchor: --trigger-espresso; }
+    #preview-cold-brew { position-anchor: --trigger-cold-brew; }
+
+    [popover].hovercard {
+      width: min(320px, calc(100vw - 24px));
+      padding: 0;
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      background: white;
+      color: var(--text);
+      text-align: start;
+      box-shadow: 0 12px 32px rgba(62, 39, 35, 0.25);
+      overflow: hidden;
+
+      /* Tether below the trigger, flipping when it would overflow the viewport. */
+      inset: auto;
+      margin: 8px 0;
+      top: anchor(bottom);
+      left: anchor(left);
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      opacity: 0;
+      transform: translateY(-8px) scale(0.96);
+      transform-origin: top left;
+    }
+
+    [popover].hovercard:is(:popover-open, .\:popover-open) {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+    }
+
+    @starting-style {
+      [popover].hovercard:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        transform: translateY(-8px) scale(0.96);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover].hovercard {
