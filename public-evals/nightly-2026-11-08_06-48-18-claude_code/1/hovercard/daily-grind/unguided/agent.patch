+    (function () {
+      var OPEN_DELAY = 300;
+      var CLOSE_DELAY = 200;
+      var GAP = 10;
+      var MARGIN = 12;
+      var openCard = null;
+
+      function position(trigger, card) {
+        var r = trigger.getBoundingClientRect();
+        var cw = card.offsetWidth;
+        var ch = card.offsetHeight;
+        var vw = document.documentElement.clientWidth;
+        var vh = window.innerHeight;
+        var above = r.bottom + GAP + ch > vh - MARGIN && r.top - GAP - ch >= MARGIN;
+        var top = above ? r.top - GAP - ch : r.bottom + GAP;
+        var left = r.left + r.width / 2 - cw / 2;
+        left = Math.max(MARGIN, Math.min(left, vw - cw - MARGIN));
+        card.style.top = Math.round(top) + 'px';
+        card.style.left = Math.round(left) + 'px';
+        card.classList.toggle('is-above', above);
+        var arrow = card.querySelector('.hovercard__arrow');
+        var ax = r.left + r.width / 2 - left - 6;
+        arrow.style.left = Math.max(14, Math.min(ax, cw - 26)) + 'px';
+      }
+
