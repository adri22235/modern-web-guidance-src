+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const button = scroller && scroller.querySelector('.back-to-top');
+      const sentinel = scroller && scroller.querySelector('.scroll-sentinel');
+      if (!scroller || !button || !sentinel) return;
+
+      function setVisible(visible) {
+        button.classList.toggle('is-visible', visible);
+        // inert removes it from tab order + accessibility tree while hidden
+        button.inert = !visible;
+        button.setAttribute('aria-hidden', String(!visible));
+        if (!visible) button.tabIndex = -1; else button.removeAttribute('tabindex');
+      }
+
+      setVisible(false);
+
+      if ('IntersectionObserver' in window) {
+        // Fires only when the sentinel crosses the scroller's viewport — no per-frame scroll work
+        new IntersectionObserver(function (entries) {
+          setVisible(!entries[entries.length - 1].isIntersecting);
+        }, { root: scroller, threshold: 0 }).observe(sentinel);
+      } else {
+        // Fallback: passive, rAF-throttled scroll listener
+        let ticking = false;
+        scroller.addEventListener('scroll', function () {
+          if (ticking) return;
+          ticking = true;
+          requestAnimationFrame(function () {
+            setVisible(scroller.scrollTop > sentinel.offsetHeight);
+            ticking = false;
+          });
+        }, { passive: true });
+      }
+
+      button.addEventListener('click', function () {
+        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        scroller.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
+        // Move focus to the top so keyboard users aren't stranded on a button that's about to hide
+        scroller.focus({ preventScroll: true });
+      });
+    })();
