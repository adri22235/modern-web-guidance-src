+      visibility: hidden;
+      pointer-events: none;
+      transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
+      z-index: 10;
+    }
+
+    /* Arrow pointing down at the button */
+    .tooltip::after {
+      content: "";
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border: 7px solid transparent;
+      border-top-color: var(--primary);
+    }
+
+    .tooltip strong {
+      display: block;
+      color: var(--accent);
+      margin-bottom: 6px;
+    }
+
+    .tooltip ul {
+      list-style: none;
+    }
+
+    .tooltip li {
+      display: flex;
+      justify-content: space-between;
+      gap: 10px;
+    }
+
+    .tooltip li span:last-child {
+      font-weight: 600;
+    }
+
+    .tooltip-wrap:hover .tooltip,
+    .tooltip-wrap:focus-within .tooltip {
+      opacity: 1;
+      visibility: visible;
+      transform: translate(-50%, -8px);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .tooltip {
+        transition: none;
+      }
+    }
