diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,37 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Brand — Watch</title>
+<meta name="description" content="Watch our film.">
+
+<!-- LCP element: discover the poster immediately, at top priority -->
+<link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+<!-- Critical header font: preload (crossorigin is required for font preloads) -->
+<link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+<!-- secondary-font.woff2 is intentionally NOT preloaded so it can't compete with the poster -->
+
+<style>
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-weight:700;font-display:swap}
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:optional}
+*{box-sizing:border-box;margin:0}
+html{background:#000;color:#fff;font:16px/1.5 Secondary,system-ui,sans-serif}
+body{min-height:100vh;display:grid;place-items:center;padding:1.5rem;text-align:center}
+main{display:grid;justify-items:center;gap:1.5rem;width:100%}
+h1{font:700 clamp(2rem,6vw,4rem)/1.1 Brand,system-ui,sans-serif}
+video{display:block;width:min(100%,960px);height:auto;aspect-ratio:16/9;background:#111}
+a{color:inherit}
+</style>
+</head>
+<body>
+<main>
+  <h1>See it in motion</h1>
+  <!-- preload="none": no video bytes fetched until play, so bandwidth goes to the poster -->
+  <video controls playsinline preload="none" poster="poster.jpg" width="1920" height="1080">
+    <source src="video.mp4" type="video/mp4">
+  </video>
+  <p><a href="#signup">Get started</a></p>
+</main>
+</body>
+</html>
