diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,32 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Watch</title>
+<!-- LCP: the video poster isn't fetched early by default and images default to low priority -->
+<link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+<!-- Critical header font (fonts are high priority by default) -->
+<link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+<!-- Secondary UI font: start early, but don't compete with critical resources -->
+<link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low">
+<style>
+@font-face{font-family:Brand;src:url(brand-font.woff2) format("woff2");font-display:swap}
+@font-face{font-family:Secondary;src:url(secondary-font.woff2) format("woff2");font-display:optional}
+*{box-sizing:border-box}
+body{margin:0;background:#000;color:#fff;font:1rem/1.5 Secondary,system-ui,sans-serif;font-size-adjust:from-font;display:grid;place-items:center;min-height:100vh;padding:1rem;text-align:center}
+h1{font-family:Brand,system-ui,sans-serif;font-size-adjust:from-font;font-size:clamp(2rem,6vw,4rem);margin:0 0 1rem}
+video{display:block;width:100%;max-width:1280px;height:auto;aspect-ratio:16/9;background:#111}
+a{color:inherit}
+</style>
+</head>
+<body>
+<main>
+  <h1>See it in motion</h1>
+  <video controls playsinline preload="none" poster="poster.jpg" width="1280" height="720">
+    <source src="video.mp4" type="video/mp4">
+  </video>
+  <p><a href="#">Get started</a></p>
+</main>
+</body>
+</html>
