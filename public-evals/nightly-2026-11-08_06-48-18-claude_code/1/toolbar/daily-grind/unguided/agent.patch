+  <script>
+    (function () {
+      var toolbar = document.getElementById('favorites-actions');
+      var list = document.getElementById('favorites-list');
+      var filtersPanel = document.getElementById('favorites-filters');
+      var status = document.getElementById('favorites-status');
+      var emptyMsg = document.getElementById('favorites-empty');
+      if (!toolbar || !list) return;
+
+      var buttons = Array.prototype.slice.call(toolbar.querySelectorAll('.icon-btn'));
+      var cards = Array.prototype.slice.call(list.querySelectorAll('.card'));
+
+      function announce(msg) {
+        status.textContent = '';
+        // Small delay so repeated identical messages are still announced.
+        setTimeout(function () { status.textContent = msg; }, 50);
+      }
+
+      function setLabel(btn, label) {
+        btn.setAttribute('aria-label', label);
+        btn.setAttribute('data-tooltip', label);
+      }
+
+      // --- Layout: grid / list ---
+      function setView(view) {
+        list.classList.toggle('list-view', view === 'list');
+        buttons.forEach(function (b) {
+          if (b.dataset.action === 'view') {
+            b.setAttribute('aria-pressed', String(b.dataset.view === view));
+          }
+        });
+        announce(view === 'list' ? 'Showing drinks as a list' : 'Showing drinks as a grid');
+      }
+
+      // --- Toggle drink details ---
+      function toggleDetails(btn) {
+        var show = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(show));
+        list.classList.toggle('details-hidden', !show);
+        setLabel(btn, show ? 'Hide drink details' : 'Show drink details');
+        announce(show ? 'Drink details shown' : 'Drink details hidden');
+      }
+
+      // --- Toggle filters ---
+      function applyFilters() {
+        var checked = {};
+        filtersPanel.querySelectorAll('input[name="favorites-filter"]').forEach(function (input) {
+          checked[input.value] = input.checked;
+        });
+        var filtersActive = !filtersPanel.hidden;
+        var visible = 0;
+        cards.forEach(function (card) {
+          var show = true;
+          if (filtersActive) {
+            if (!checked[card.dataset.temp]) show = false;
+            if (checked['dairy-free'] && card.dataset.dairyFree !== 'true') show = false;
+          }
+          card.hidden = !show;
+          if (show) visible++;
+        });
+        emptyMsg.hidden = visible !== 0;
+        return visible;
+      }
+
+      function toggleFilters(btn) {
+        var show = btn.getAttribute('aria-pressed') !== 'true';
+        btn.setAttribute('aria-pressed', String(show));
+        filtersPanel.hidden = !show;
+        setLabel(btn, show ? 'Hide filters' : 'Show filters');
+        var count = applyFilters();
+        announce(show
+          ? 'Filters on. ' + count + ' of ' + cards.length + ' drinks shown'
+          : 'Filters off. Showing all drinks');
+      }
+
+      filtersPanel.addEventListener('change', function () {
+        var count = applyFilters();
+        announce(count + ' of ' + cards.length + ' drinks shown');
+      });
+
+      // --- Copy featured drinks list ---
+      function getDrinksText() {
+        return 'The Daily Grind – Seasonal Favorites\n' + cards.map(function (card) {
+          var name = card.querySelector('h3').textContent.trim();
+          var desc = card.querySelector('p').textContent.trim();
+          return '• ' + name + ' – ' + desc;
+        }).join('\n');
+      }
+
+      function fallbackCopy(text) {
+        var ta = document.createElement('textarea');
+        ta.value = text;
+        ta.setAttribute('readonly', '');
+        ta.style.position = 'fixed';
+        ta.style.opacity = '0';
+        document.body.appendChild(ta);
+        ta.select();
+        var ok = false;
+        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
+        document.body.removeChild(ta);
+        return ok ? Promise.resolve() : Promise.reject(new Error('Copy failed'));
+      }
+
+      var copyTimer;
+      function copyDrinks(btn) {
+        var text = getDrinksText();
+        var attempt = (navigator.clipboard && window.isSecureContext)
+          ? navigator.clipboard.writeText(text).catch(function () { return fallbackCopy(text); })
+          : fallbackCopy(text);
+
+        attempt.then(function () {
+          btn.classList.add('copied');
+          btn.querySelector('.icon-copy').hidden = true;
+          btn.querySelector('.icon-check').hidden = false;
+          setLabel(btn, 'Copied!');
+          announce('Featured drinks list copied to clipboard');
+          clearTimeout(copyTimer);
+          copyTimer = setTimeout(function () {
+            btn.classList.remove('copied');
+            btn.querySelector('.icon-copy').hidden = false;
+            btn.querySelector('.icon-check').hidden = true;
+            setLabel(btn, 'Copy featured drinks list');
+          }, 2000);
+        }, function () {
+          announce('Unable to copy the drinks list');
+        });
+      }
+
+      toolbar.addEventListener('click', function (e) {
+        var btn = e.target.closest('.icon-btn');
+        if (!btn) return;
+        focusButton(btn);
+        switch (btn.dataset.action) {
+          case 'view': setView(btn.dataset.view); break;
+          case 'details': toggleDetails(btn); break;
+          case 'filters': toggleFilters(btn); break;
+          case 'copy': copyDrinks(btn); break;
+        }
+      });
+
+      // --- Roving tabindex keyboard navigation (WAI-ARIA toolbar pattern) ---
+      function focusButton(btn) {
+        buttons.forEach(function (b) { b.tabIndex = b === btn ? 0 : -1; });
+        btn.focus();
+      }
+
+      toolbar.addEventListener('keydown', function (e) {
+        var idx = buttons.indexOf(document.activeElement);
+        if (idx === -1) return;
+        var next = null;
+        switch (e.key) {
+          case 'ArrowRight': next = buttons[(idx + 1) % buttons.length]; break;
+          case 'ArrowLeft': next = buttons[(idx - 1 + buttons.length) % buttons.length]; break;
+          case 'Home': next = buttons[0]; break;
+          case 'End': next = buttons[buttons.length - 1]; break;
+        }
+        if (next) {
+          e.preventDefault();
+          focusButton(next);
+        }
+      });
+    })();
+  </script>
+
 </body>
 
