+
+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const list = document.getElementById('favorites-list');
+      const filters = document.getElementById('favorites-filters');
+      const status = document.getElementById('favorites-status');
+      const items = [...bar.querySelectorAll('button')];
+      const viewButtons = items.filter((b) => b.dataset.view);
+      let statusTimer;
+      let lastMessage = '';
+
+      function announce(message) {
+        clearTimeout(statusTimer);
+        // VoiceOver skips identical consecutive messages; a trailing NBSP makes it differ
+        if (message === lastMessage) message += '\u00A0';
+        lastMessage = message;
+        status.textContent = message;
+        statusTimer = setTimeout(() => { status.textContent = ''; }, 3000);
+      }
+
+      // Layout: mutually exclusive grid/list toggle
+      function setView(view) {
+        viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
+        list.classList.toggle('is-list', view === 'list');
+      }
+
+      // On/off toggles
+      const toggles = {
+        details(on) {
+          list.classList.toggle('hide-details', !on);
+        },
+        filters(on) {
+          filters.hidden = !on;
+          if (!on) {
+            // Reset filtering when the panel is closed so no drinks stay hidden unexpectedly
+            filters.querySelector('input[value="all"]').checked = true;
+            applyFilter('all');
+          }
+        },
+      };
+
+      function applyFilter(temp) {
+        list.querySelectorAll('.card').forEach((card) => {
+          card.hidden = temp !== 'all' && card.dataset.temp !== temp;
+        });
+      }
+
+      filters.addEventListener('change', (e) => {
+        applyFilter(e.target.value);
+        const count = list.querySelectorAll('.card:not([hidden])').length;
+        announce(`Showing ${count} drink${count === 1 ? '' : 's'}`);
+      });
+
+      // Copy the featured drinks list
+      const copyButton = bar.querySelector('[data-action="copy"]');
+      let copyTimer;
+
+      async function copyList() {
+        const text = [...list.querySelectorAll('.card:not([hidden])')]
+          .map((card) => {
+            const name = card.querySelector('h3').textContent.trim();
+            const desc = card.querySelector('p')?.textContent.trim();
+            return desc ? `- ${name}: ${desc}` : `- ${name}`;
+          })
+          .join('\n');
+        clearTimeout(copyTimer);
+        copyButton.removeAttribute('data-copied');
+        copyButton.removeAttribute('data-failed');
+        let ok = true;
+        try {
+          await navigator.clipboard.writeText(`Seasonal Favorites\n${text}`);
+        } catch {
+          ok = false;
+        }
+        copyButton.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        announce(ok ? 'Featured drinks list copied' : 'Copy failed');
+        copyTimer = setTimeout(() => {
+          copyButton.removeAttribute('data-copied');
+          copyButton.removeAttribute('data-failed');
+        }, 2000);
+      }
+
+      bar.addEventListener('click', (e) => {
+        const button = e.target.closest('button');
+        if (!button) return;
+        if (button.dataset.view) {
+          setView(button.dataset.view);
+        } else if (button.dataset.toggle) {
+          const on = button.getAttribute('aria-pressed') !== 'true';
+          button.setAttribute('aria-pressed', String(on));
+          toggles[button.dataset.toggle](on);
+        } else if (button.dataset.action === 'copy') {
+          copyList();
+        }
+      });
+
+      // Roving tabindex fallback where native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener('keydown', (e) => {
+          const index = items.indexOf(document.activeElement);
+          if (index === -1) return;
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          let next;
+          if (e.key in steps) next = (index + steps[e.key] + items.length) % items.length;
+          else if (e.key === 'Home') next = 0;
+          else if (e.key === 'End') next = items.length - 1;
+          else return;
+          e.preventDefault();
+          items[next].focus();
+        });
+      }
+    })();
+  </script>
 </body>
 
