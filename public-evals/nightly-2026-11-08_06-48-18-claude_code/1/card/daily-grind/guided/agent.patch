+  <script>
+    (() => {
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const order = JSON.parse(sessionStorage.getItem('order') || '[]');
+      const countEls = document.querySelectorAll('.order-count');
+      const renderCount = () => countEls.forEach((el) => { el.textContent = order.length; });
+      renderCount();
+
+      for (const form of document.querySelectorAll('.order-form')) {
+        const price = form.querySelector('.price');
+        const status = form.querySelector('.order-status');
+        const selected = () => form.querySelector('input[name="size"]:checked');
+        const showPrice = () => { price.textContent = money.format(Number(selected().dataset.price)); };
+
+        form.addEventListener('change', (e) => {
+          if (e.target.name === 'size') showPrice();
+        });
+
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const size = selected();
+          const label = size.closest('label').querySelector('.size-long').textContent;
+          order.push({ item: form.elements.namedItem('item').value, size: size.value, price: Number(size.dataset.price) });
+          sessionStorage.setItem('order', JSON.stringify(order));
+          renderCount();
+          status.textContent = `Added ${label} ${form.elements.namedItem('drink').value} to your order.`;
+        });
+
+        showPrice();
+      }
+    })();
+  </script>
+
