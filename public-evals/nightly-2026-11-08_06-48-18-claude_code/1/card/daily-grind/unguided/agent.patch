+  <script>
+    (function () {
+      var STORAGE_KEY = 'dailyGrindOrder';
+      var countEl = document.querySelector('.order-count');
+      var toast = document.querySelector('.toast');
+      var toastTimer;
+
+      function loadOrder() {
+        try {
+          var saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
+          return Array.isArray(saved) ? saved : [];
+        } catch (e) {
+          return [];
+        }
+      }
+
+      function saveOrder(order) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(order));
+        } catch (e) { /* storage unavailable: keep in memory only */ }
+      }
+
+      var order = loadOrder();
+
+      function renderCount(animate) {
+        var total = order.reduce(function (sum, item) { return sum + item.qty; }, 0);
+        countEl.textContent = total;
+        countEl.setAttribute('aria-label', total + (total === 1 ? ' item' : ' items') + ' in order');
+        if (animate) {
+          countEl.classList.remove('bump');
+          void countEl.offsetWidth;
+          countEl.classList.add('bump');
+        }
+      }
+
+      function showToast(message) {
+        toast.textContent = message;
+        toast.classList.add('is-visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(function () {
+          toast.classList.remove('is-visible');
+        }, 2600);
+      }
+
+      function formatPrice(n) {
+        return '$' + Number(n).toFixed(2);
+      }
+
+      document.querySelectorAll('.drink').forEach(function (card) {
+        var form = card.querySelector('.drink__form');
+        var priceEl = card.querySelector('.drink__price');
+        var button = card.querySelector('.drink__add');
+        var name = card.querySelector('.drink__title').textContent.trim();
+        var resetTimer;
+
+        form.addEventListener('change', function (e) {
+          if (e.target.name === 'size') {
+            priceEl.textContent = formatPrice(e.target.dataset.price);
+          }
+        });
+
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          var selected = form.querySelector('input[name="size"]:checked');
+          if (!selected) return;
+
+          var drink = form.elements.drink.value;
+          var size = selected.value;
+          var price = parseFloat(selected.dataset.price);
+          var existing = order.find(function (item) {
+            return item.drink === drink && item.size === size;
+          });
+
+          if (existing) {
+            existing.qty += 1;
+          } else {
+            order.push({ drink: drink, name: name, size: size, price: price, qty: 1 });
+          }
+          saveOrder(order);
+          renderCount(true);
+
+          var sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+          showToast('Added ' + sizeLabel + ' ' + name + ' (' + formatPrice(price) + ') to your order');
+
+          button.dataset.state = 'added';
+          button.textContent = 'Added \u2713';
+          clearTimeout(resetTimer);
+          resetTimer = setTimeout(function () {
+            delete button.dataset.state;
+            button.textContent = 'Add to Order';
+          }, 1500);
+        });
+      });
+
+      renderCount(false);
+    })();
+  </script>
+
