+  <div id="tour-step" popover="manual" role="dialog" aria-labelledby="tour-step-title" aria-describedby="tour-step-desc">
+    <h4 id="tour-step-title">Earn points with Rewards</h4>
+    <p id="tour-step-desc">Every purchase earns you points toward free drinks and treats. Check your balance here anytime.</p>
+    <button type="button" class="tour-close" popovertarget="tour-step" popovertargetaction="hide">Got it</button>
+  </div>
+
+  <script>
+    (function () {
+      var link = document.getElementById('feature');
+      var tour = document.getElementById('tour-step');
+      var supportsPopover = typeof tour.showPopover === 'function';
+      var supportsAnchor = window.CSS && CSS.supports && CSS.supports('anchor-name: --a');
+
+      function isOpen() {
+        return supportsPopover ? tour.matches(':popover-open') : !tour.hidden;
+      }
+
+      // JS fallback positioning for browsers without CSS anchor positioning.
+      function position() {
+        if (supportsAnchor || !isOpen()) return;
+        var r = link.getBoundingClientRect();
+        var w = tour.offsetWidth;
+        var margin = 8;
+        var center = r.left + r.width / 2;
+        var left = Math.min(Math.max(center - w / 2, margin), window.innerWidth - w - margin);
+        tour.style.translate = 'none';
+        tour.style.top = (r.bottom + 12) + 'px';
+        tour.style.left = left + 'px';
+        tour.style.setProperty('--arrow-left', (center - left) + 'px');
+      }
+
+      function open() {
+        if (supportsPopover) {
+          tour.showPopover();
+        } else {
+          tour.hidden = false;
+          tour.style.display = 'block';
+        }
+        link.classList.add('tour-highlight');
+        position();
+      }
+
+      function close() {
+        if (supportsPopover) {
+          if (isOpen()) tour.hidePopover();
+        } else {
+          tour.hidden = true;
+          tour.style.display = 'none';
+        }
+        link.classList.remove('tour-highlight');
+      }
+
+      // Keep the Rewards link from navigating away while the tour is open.
+      link.addEventListener('click', function (e) {
+        if (isOpen()) e.preventDefault();
+      });
+
+      // popover="manual" ignores outside clicks and Escape (no light dismiss),
+      // so only the "Got it" button closes it.
+      tour.addEventListener('beforetoggle', function (e) {
+        if (e.newState === 'closed') link.classList.remove('tour-highlight');
+      });
+
+      if (!supportsPopover) {
+        tour.querySelector('.tour-close').addEventListener('click', close);
+      }
+
+      if (!supportsAnchor) {
+        window.addEventListener('scroll', position, { passive: true });
+        window.addEventListener('resize', position);
+        if (window.ResizeObserver) new ResizeObserver(position).observe(link);
+      }
+
+      open();
+    })();
+  </script>
+
 </body>
 
