+  <script type="module">
+    // Load polyfills only when native support is missing.
+    const polyfills = [];
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      polyfills.push(import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js"));
+    }
+    if (!CSS.supports("anchor-name: --a")) {
+      polyfills.push(import("https://unpkg.com/@oddbird/css-anchor-positioning"));
+    }
+    await Promise.allSettled(polyfills);
+
+    const tourStep = document.getElementById("tour-step");
+    const rewardsLink = document.getElementById("feature");
+    const isTourOpen = () => tourStep.matches(":is(:popover-open, .\\:popover-open)");
+
+    // Keep the user on the page while the tour step is showing.
+    rewardsLink.addEventListener("click", (event) => {
+      if (isTourOpen()) event.preventDefault();
+    });
+
+    // Return focus to the related control once the tour step is dismissed.
+    tourStep.addEventListener("toggle", (event) => {
+      if (event.newState === "closed") rewardsLink.focus();
+    });
+
+    // Open by default (manual popover: no light dismiss, closes only via the button).
+    tourStep.showPopover();
+  </script>
+
 </body>
 
