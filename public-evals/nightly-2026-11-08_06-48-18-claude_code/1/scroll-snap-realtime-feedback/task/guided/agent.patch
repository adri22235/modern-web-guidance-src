+  <script>
+    (() => {
+      const container = document.getElementById('gallery');
+      const items = [...container.querySelectorAll('.gallery-item')];
+      const thumbnails = [...document.querySelectorAll('.thumbnail')];
+
+      // Mid-scroll feedback: mark the thumbnail we're heading towards.
+      const setPending = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => thumb.classList.remove('pending'));
+        thumbnails[index].classList.add('pending');
+      };
+
+      // Scroll settled: clear pending, set active + aria-current.
+      const setActive = (index) => {
+        if (!thumbnails[index]) return;
+        thumbnails.forEach((thumb) => {
+          thumb.classList.remove('pending', 'active');
+          thumb.removeAttribute('aria-current');
+        });
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+      };
+
+      // Items use scroll-snap-align: center, so compare centers.
+      const findClosestItemIndex = () => {
+        const containerCenter = container.scrollLeft + container.clientWidth / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+        items.forEach((item, index) => {
+          const distance = Math.abs(containerCenter - (item.offsetLeft + item.offsetWidth / 2));
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+        return closestIndex;
+      };
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        container.addEventListener('scrollsnapchanging', (event) => {
+          setPending(items.indexOf(event.snapTargetInline));
+        });
+        container.addEventListener('scrollsnapchange', (event) => {
+          setActive(items.indexOf(event.snapTargetInline));
+        });
+      } else {
+        // Fallback: emulate snap prediction with scroll + rAF geometry.
+        let rafId = null;
+        let scrollTimeout;
+        const settle = () => {
+          clearTimeout(scrollTimeout);
+          setActive(findClosestItemIndex());
+        };
+
+        container.addEventListener('scroll', () => {
+          if (!rafId) {
+            rafId = requestAnimationFrame(() => {
+              rafId = null;
+              setPending(findClosestItemIndex());
+            });
+          }
+          // Debounce for browsers without scrollend.
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(settle, 100);
+        }, { passive: true });
+
+        container.addEventListener('scrollend', settle);
+      }
+
+      // Clicking a thumbnail scrolls its photo into view; the snap
+      // handlers above take care of pending/active state.
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          const item = items[index];
+          container.scrollTo({
+            left: item.offsetLeft - (container.clientWidth - item.offsetWidth) / 2,
+            behavior: reduceMotion.matches ? 'instant' : 'smooth',
+          });
+        });
+      });
+
+      // Sync initial state (scroll position may be restored by the browser).
+      const initActiveItem = () => setActive(findClosestItemIndex());
+      if (document.readyState === 'complete') {
+        initActiveItem();
+      } else {
+        window.addEventListener('load', initActiveItem, { once: true });
+      }
+
+      // Roving tabindex fallback where native focusgroup isn't supported.
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        document.querySelectorAll('[focusgroup~="toolbar"]').forEach((group) => {
+          group.setAttribute('role', 'toolbar');
+          const controls = () => [...group.querySelectorAll('button')]
+            .filter((el) => el.closest('[focusgroup]') === group && !el.disabled);
+
+          const syncTabIndex = () => {
+            const list = controls();
+            let current = list.indexOf(document.activeElement);
+            if (current < 0) {
+              current = list.findIndex((el) => el.getAttribute('aria-current') === 'true');
+            }
+            if (current < 0) current = 0;
+            list.forEach((el, i) => { el.tabIndex = i === current ? 0 : -1; });
+          };
+
+          group.addEventListener('focusin', syncTabIndex);
+          group.addEventListener('keydown', (event) => {
+            if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
+            const list = controls();
+            const current = list.indexOf(document.activeElement);
+            if (current < 0) return;
+            const next = (current + (event.key === 'ArrowLeft' ? -1 : 1) + list.length) % list.length;
+            event.preventDefault();
+            list.forEach((el, i) => { el.tabIndex = i === next ? 0 : -1; });
+            list[next].focus({ preventScroll: true });
+          }, true);
+
+          syncTabIndex();
+        });
+      }
+    })();
+  </script>
