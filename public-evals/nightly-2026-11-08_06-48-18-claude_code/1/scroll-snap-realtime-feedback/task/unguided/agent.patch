+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbs = Array.from(document.querySelectorAll('.thumbnail'));
+      if (!items.length || items.length !== thumbs.length) return;
+
+      let activeIndex = 0;
+      let pendingIndex = -1;
+      let programmaticTarget = -1; // set when a thumbnail click drives the scroll
+      let lastScrollLeft = gallery.scrollLeft;
+      let scrollDirection = 0;
+
+      function setPending(index) {
+        if (index === pendingIndex) return;
+        if (pendingIndex !== -1) thumbs[pendingIndex].classList.remove('pending');
+        pendingIndex = index;
+        // No need to flag the already-active thumbnail as pending.
+        if (index !== -1 && index !== activeIndex) thumbs[index].classList.add('pending');
+      }
+
+      function setActive(index) {
+        thumbs.forEach(function (t) { t.classList.remove('pending'); });
+        pendingIndex = -1;
+        programmaticTarget = -1;
+        if (index < 0) return;
+        thumbs.forEach(function (t, i) {
+          const isActive = i === index;
+          t.classList.toggle('active', isActive);
+          if (isActive) t.setAttribute('aria-current', 'true');
+          else t.removeAttribute('aria-current');
+        });
+        activeIndex = index;
+      }
+
+      // Index of the item whose center is closest to the container's center.
+      function nearestIndex() {
+        const center = gallery.scrollLeft + gallery.clientWidth / 2;
+        let best = 0;
+        let bestDist = Infinity;
+        items.forEach(function (item, i) {
+          const d = Math.abs(item.offsetLeft - gallery.offsetLeft + item.offsetWidth / 2 - center);
+          if (d < bestDist) { bestDist = d; best = i; }
+        });
+        return best;
+      }
+
+      // Fallback estimate of where a swipe is heading: the next item in the
+      // direction of travel once the user has moved off the active one.
+      function predictedIndex() {
+        const nearest = nearestIndex();
+        if (nearest !== activeIndex || scrollDirection === 0) return nearest;
+        const next = activeIndex + scrollDirection;
+        const step = items[0].offsetWidth || 1;
+        const start = items[activeIndex].offsetLeft - items[0].offsetLeft;
+        const moved = Math.abs(gallery.scrollLeft - start);
+        if (next >= 0 && next < items.length && moved > step * 0.1) return next;
+        return nearest;
+      }
+
+      const supportsSnapEvents = 'onscrollsnapchanging' in window && 'onscrollsnapchange' in window;
+
+      if (supportsSnapEvents) {
+        // Native: the browser tells us the snap target mid-gesture and on settle.
+        gallery.addEventListener('scrollsnapchanging', function (e) {
+          if (programmaticTarget !== -1) return;
+          const idx = items.indexOf(e.snapTargetInline);
+          if (idx !== -1) setPending(idx);
+        });
+        gallery.addEventListener('scrollsnapchange', function (e) {
+          const idx = items.indexOf(e.snapTargetInline);
+          if (idx !== -1) setActive(idx);
+        });
+        // Safety net: always clear pending state when scrolling ends, even if
+        // the snap target didn't change (e.g. swipe cancelled).
+        gallery.addEventListener('scrollend', function () {
+          setActive(nearestIndex());
+        });
+      } else {
+        let settleTimer = null;
+        const supportsScrollEnd = 'onscrollend' in window;
+
+        function onSettled() {
+          settleTimer = null;
+          scrollDirection = 0;
+          setActive(nearestIndex());
+        }
+
+        gallery.addEventListener('scroll', function () {
+          const delta = gallery.scrollLeft - lastScrollLeft;
+          if (delta !== 0) scrollDirection = delta > 0 ? 1 : -1;
+          lastScrollLeft = gallery.scrollLeft;
+
+          if (programmaticTarget === -1) setPending(predictedIndex());
+
+          if (!supportsScrollEnd) {
+            clearTimeout(settleTimer);
+            settleTimer = setTimeout(onSettled, 120);
+          }
+        }, { passive: true });
+
+        if (supportsScrollEnd) gallery.addEventListener('scrollend', onSettled);
+      }
+
+      thumbs.forEach(function (thumb, i) {
+        thumb.addEventListener('click', function () {
+          if (i === activeIndex && pendingIndex === -1) return;
+          programmaticTarget = i;
+          setPending(i);
+          const left = items[i].offsetLeft - items[0].offsetLeft;
+          gallery.scrollTo({ left: left });
+        });
+      });
+
+      // Keyboard support on the gallery itself.
+      gallery.addEventListener('keydown', function (e) {
+        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
+        e.preventDefault();
+        const base = programmaticTarget !== -1 ? programmaticTarget : activeIndex;
+        const next = Math.max(0, Math.min(items.length - 1, base + (e.key === 'ArrowRight' ? 1 : -1)));
+        if (next !== base) thumbs[next].click();
+      });
+
+      // Keep the active slide aligned when the viewport resizes.
+      window.addEventListener('resize', function () {
+        const prev = gallery.style.scrollBehavior;
+        gallery.style.scrollBehavior = 'auto';
+        gallery.scrollLeft = items[activeIndex].offsetLeft - items[0].offsetLeft;
+        gallery.style.scrollBehavior = prev;
+      });
+    })();
+  </script>
