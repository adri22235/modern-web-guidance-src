+    /* Store Picker */
+    .store-picker {
+      margin-top: 1.25rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+    }
+
+    .store-picker label {
+      font-size: 0.85rem;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      opacity: 0.85;
+    }
+
+    .store-select {
+      min-width: 260px;
+      padding: 10px 16px;
+      font: inherit;
+      font-size: 0.95rem;
+      color: var(--text);
+      background: rgba(255, 255, 255, 0.95);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid rgba(255, 171, 64, 0.6);
+      outline-offset: 2px;
+    }
+
+    /* Customizable select: animatable native picker + rotating arrow */
+    @supports (appearance: base-select) {
+
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 12px;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.3s ease;
+      }
+
+      .store-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .store-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        border: 1px solid var(--secondary);
+        border-radius: 8px;
+        background: white;
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
+        opacity: 0;
+        translate: 0 -8px;
+        transition:
+          opacity 0.25s ease,
+          translate 0.25s ease,
+          display 0.25s allow-discrete,
+          overlay 0.25s allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+        translate: 0 0;
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+          translate: 0 -8px;
+        }
+      }
+
+      .store-select option {
+        padding: 8px 12px;
+        border-radius: 4px;
+        color: var(--text);
+        text-align: left;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus-visible {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        font-weight: 600;
+      }
+
+      .store-select option::checkmark {
+        color: var(--accent);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      .store-select::picker-icon,
+      .store-select::picker(select) {
+        transition: none;
+      }
+    }
+
