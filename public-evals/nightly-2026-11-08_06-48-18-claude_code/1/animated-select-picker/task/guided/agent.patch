+    /* Store picker (customizable select) */
+    :root {
+      interpolate-size: allow-keywords;
+    }
+
+    .store-picker {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+      margin-top: 1.25rem;
+    }
+
+    .store-picker label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+    }
+
+    .store-select,
+    .store-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .store-select {
+      width: min(280px, 80vw);
+      padding: 0.6rem 1rem;
+      font: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      background: var(--light);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .store-select::picker-icon {
+      color: var(--primary);
+      transition: rotate 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .store-select:open::picker-icon {
+      rotate: 180deg;
+    }
+
+    .store-select::picker(select) {
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.25);
+      padding: 0.35rem;
+      margin-top: 0.25rem;
+      width: anchor-size(width);
+
+      opacity: 0;
+      translate: 0 -6px;
+      transition:
+        display 0.25s,
+        overlay 0.25s,
+        opacity 0.25s ease,
+        translate 0.25s ease;
+      transition-behavior: allow-discrete;
+    }
+
+    .store-select:open::picker(select) {
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @starting-style {
+      .store-select:open::picker(select) {
+        opacity: 0;
+        translate: 0 -6px;
+      }
+    }
+
+    .store-select option {
+      padding: 0.5rem 0.75rem;
+      border-radius: 5px;
+      cursor: pointer;
+    }
+
+    .store-select option:hover,
+    .store-select option:focus-visible {
+      background: var(--secondary);
+    }
+
+    .store-select option:checked {
+      font-weight: 700;
+      background: #efebe9;
+    }
+
+    .store-select option::checkmark {
+      color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
