+  <script type="module">
+    // ---- Safe HTML rendering ------------------------------------------------
+    // Reviews are untrusted user markup. They are always stored raw and only
+    // ever reach the DOM through safeSetHTML(), which uses the native Sanitizer
+    // API (Element.setHTML) and falls back to DOMPurify where it is missing.
+
+    const ALLOWED_ELEMENTS = [
+      'p', 'br', 'b', 'strong', 'i', 'em', 'u', 's',
+      'ul', 'ol', 'li', 'blockquote', 'code', 'a'
+    ];
+    const ALLOWED_ATTRIBUTES = ['href'];
+
+    const DOMPURIFY_SRC = 'https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js';
+    const DOMPURIFY_SRI = 'sha384-JEyTNhjM6R1ElGoJns4U2Ln4ofPcqzSsynQkmEc/KGy6336qAZl70tDLufbkla+3';
+
+    let domPurifyPromise;
+
+    // Only download DOMPurify in browsers without the native Sanitizer API.
+    function loadDOMPurify() {
+      domPurifyPromise ??= new Promise((resolve, reject) => {
+        const script = document.createElement('script');
+        script.src = DOMPURIFY_SRC;
+        script.integrity = DOMPURIFY_SRI;
+        script.crossOrigin = 'anonymous';
+        script.referrerPolicy = 'no-referrer';
+        script.onload = () => window.DOMPurify ? resolve(window.DOMPurify) : reject(new Error('DOMPurify unavailable'));
+        script.onerror = () => reject(new Error('Failed to load DOMPurify'));
+        document.head.append(script);
+      });
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // setHTML() always strips XSS-unsafe content (scripts, on* handlers,
+        // javascript: URLs); our config narrows it further to basic formatting.
+        el.setHTML(html, {
+          sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES }
+        });
+      } else {
+        try {
+          const DOMPurify = await loadDOMPurify();
+          el.innerHTML = DOMPurify.sanitize(html, {
+            ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+            ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+            // Match native Sanitizer behaviour.
+            ALLOW_ARIA_ATTR: false,
+            ALLOW_DATA_ATTR: false,
+            KEEP_CONTENT: false
+          });
+        } catch {
+          // Fail closed: if no sanitizer is available, show plain text only.
+          el.textContent = html;
+          return;
+        }
+      }
+
+      // User-supplied links must not pass page authority or window access.
+      for (const link of el.querySelectorAll('a[href]')) {
+        link.rel = 'nofollow ugc noopener noreferrer';
+      }
+    }
+
+    // ---- Review data ----------------------------------------------------------
+
+    const DRINKS = {
+      'maple-oat-latte': 'Maple Oat Latte',
+      'dark-roast-espresso': 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+
+    const STORAGE_KEY = 'dailyGrind.reviews.v1';
+
+    const SEED_REVIEWS = [
+      {
+        drink: 'maple-oat-latte', name: 'Priya', rating: 5, date: '2026-10-21T08:15:00Z',
+        body: '<p><strong>Autumn in a cup!</strong> The maple is subtle, not syrupy.</p><ul><li>Silky oat milk</li><li>Perfect foam</li></ul>'
+      },
+      {
+        drink: 'dark-roast-espresso', name: 'Marcus', rating: 4, date: '2026-10-28T07:02:00Z',
+        body: '<p>Bold and <em>smokey</em> as promised.</p><blockquote>Gets me through Monday standups.</blockquote>'
+      },
+      {
+        drink: 'cold-brew', name: 'Jo', rating: 5, date: '2026-11-02T13:40:00Z',
+        body: '<p>Smoothest cold brew in town &mdash; zero bitterness. <b>Try it with a splash of oat milk.</b></p>'
+      }
+    ];
+
+    function loadReviews() {
+      try {
+        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
+        if (Array.isArray(stored)) return stored;
+      } catch { /* fall through to seed data */ }
+      return [...SEED_REVIEWS];
+    }
+
+    function saveReviews(reviews) {
+      try {
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(reviews));
+      } catch { /* storage unavailable; keep in memory only */ }
+    }
+
+    let reviews = loadReviews();
+
+    // ---- Rendering ------------------------------------------------------------
+
+    const list = document.getElementById('review-list');
+    const filter = document.getElementById('review-filter');
+    const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+    function renderReview(review) {
+      const item = document.createElement('li');
+      item.className = 'review';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const who = document.createElement('span');
+      const name = document.createElement('strong');
+      name.textContent = String(review.name ?? 'Anonymous');
+      who.append(name, ` on ${DRINKS[review.drink] ?? 'a seasonal drink'}`);
+
+      const rating = Math.min(5, Math.max(1, Number(review.rating) || 0));
+      const stars = document.createElement('span');
+      stars.className = 'rating';
+      stars.setAttribute('role', 'img');
+      stars.setAttribute('aria-label', `${rating} out of 5 stars`);
+      stars.textContent = '★'.repeat(rating) + '☆'.repeat(5 - rating);
+
+      const time = document.createElement('time');
+      const date = new Date(review.date);
+      if (!Number.isNaN(date.getTime())) {
+        time.dateTime = date.toISOString();
+        time.textContent = dateFormat.format(date);
+      }
+
+      meta.append(who, stars, time);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      safeSetHTML(body, String(review.body ?? ''));
+
+      item.append(meta, body);
+      return item;
+    }
+
+    function renderReviews() {
+      const selected = filter.value;
+      const visible = reviews
+        .filter((r) => selected === 'all' || r.drink === selected)
+        .sort((a, b) => new Date(b.date) - new Date(a.date));
+
+      if (visible.length === 0) {
+        const empty = document.createElement('li');
+        empty.textContent = 'No reviews yet — be the first!';
+        list.replaceChildren(empty);
+      } else {
+        list.replaceChildren(...visible.map(renderReview));
+      }
+
+      for (const slug of Object.keys(DRINKS)) {
+        const count = reviews.filter((r) => r.drink === slug).length;
+        const target = document.querySelector(`[data-review-count="${slug}"]`);
+        if (target) target.textContent = `${count} review${count === 1 ? '' : 's'}`;
+      }
+    }
+
+    filter.addEventListener('change', renderReviews);
+
+    // ---- Form -----------------------------------------------------------------
+
+    const form = document.getElementById('review-form');
+    const bodyInput = document.getElementById('review-body');
+    const bodyError = document.getElementById('review-body-error');
+    const preview = document.getElementById('review-preview');
+    const status = document.getElementById('review-status');
+
+    // Live preview uses exactly the same sanitizer as the published review.
+    bodyInput.addEventListener('input', () => {
+      bodyInput.setCustomValidity('');
+      bodyInput.removeAttribute('aria-invalid');
+      bodyError.textContent = '';
+      safeSetHTML(preview, bodyInput.value);
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      // Reject reviews that are empty once unsafe/disallowed markup is stripped.
+      const probe = document.createElement('div');
+      await safeSetHTML(probe, bodyInput.value);
+      if (bodyInput.value.trim() && !probe.textContent.trim()) {
+        bodyInput.setCustomValidity('Your review has no readable text after unsupported HTML was removed.');
+      }
+
+      for (const field of form.elements) {
+        if (field.willValidate) {
+          if (field.checkValidity()) field.removeAttribute('aria-invalid');
+          else field.setAttribute('aria-invalid', 'true');
+        }
+      }
+
+      if (!form.checkValidity()) {
+        bodyError.textContent = bodyInput.validationMessage;
+        form.querySelector(':invalid')?.focus();
+        form.reportValidity();
+        return;
+      }
+
+      const data = new FormData(form);
+      const drink = String(data.get('drink'));
+      reviews.push({
+        drink,
+        name: String(data.get('name')).trim(),
+        rating: Number(data.get('rating')),
+        body: String(data.get('body')),
+        date: new Date().toISOString()
+      });
+      saveReviews(reviews);
+
+      if (filter.value !== 'all' && filter.value !== drink) filter.value = drink;
+      renderReviews();
+
+      form.reset();
+      preview.replaceChildren();
+      bodyError.textContent = '';
+      status.textContent = `Thanks! Your review of ${DRINKS[drink]} was posted.`;
+    });
+
+    renderReviews();
+  </script>
+
