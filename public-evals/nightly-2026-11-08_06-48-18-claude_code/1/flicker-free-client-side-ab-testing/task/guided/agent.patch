diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,231 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Lumen — Ship faster with less noise</title>
+  <meta name="description" content="Lumen helps product teams plan, build, and ship without the busywork.">
+
+  <!-- Open the connection to the experiment CDN as early as possible to keep render-blocking time short. -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="preconnect" href="https://images.unsplash.com">
+
+  <!--
+    Anti-flicker FALLBACK, only for browsers that don't support blocking="render"
+    (e.g. Firefox). It runs BEFORE the SDK tag so the hide class is always in place
+    before the SDK could run, even from cache. Supporting browsers skip it entirely.
+  -->
+  <style>
+    html.ab-loading { opacity: 0 !important; }
+  </style>
+  <script>
+    (function () {
+      var root = document.documentElement;
+      var supportsBlocking = 'blocking' in HTMLScriptElement.prototype;
+      // Called once the experiment script has run (or failed); safe to call repeatedly.
+      window.__abReveal = function () { root.classList.remove('ab-loading'); };
+      if (!supportsBlocking) {
+        root.classList.add('ab-loading');
+        // Safety net so a slow/unavailable CDN never leaves the page blank.
+        setTimeout(window.__abReveal, 3000);
+      }
+    })();
+  </script>
+
+  <!--
+    Experiment SDK:
+    - async: doesn't block HTML parsing, so the DOM is built while the SDK downloads.
+    - blocking="render": the browser won't paint until the SDK has executed, so the
+      original content is never shown before the variant is applied.
+    - onload/onerror: reveal the page in fallback browsers as soon as the SDK is done
+      (an async script's load event fires right after it executes).
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+    onload="window.__abReveal()"
+    onerror="window.__abReveal()"
+  ></script>
+
+  <style>
+    :root {
+      color-scheme: light dark;
+      --bg: light-dark(#fbfaf7, #0f1115);
+      --fg: light-dark(#14161a, #eef0f3);
+      --muted: light-dark(#5a606b, #a3a9b4);
+      --accent: light-dark(#4f46e5, #8b85ff);
+      --accent-fg: light-dark(#fff, #0f1115);
+      --radius: 0.75rem;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+    }
+
+    *, *::before, *::after { box-sizing: border-box; }
+
+    body {
+      margin: 0;
+      background: var(--bg);
+      color: var(--fg);
+      line-height: 1.5;
+    }
+
+    .site-header {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      max-width: 72rem;
+      margin-inline: auto;
+      padding: 1.25rem 1.5rem;
+    }
+
+    .logo {
+      font-weight: 800;
+      font-size: 1.25rem;
+      letter-spacing: -0.02em;
+      color: inherit;
+      text-decoration: none;
+    }
+
+    .site-header nav a {
+      color: var(--muted);
+      text-decoration: none;
+      margin-inline-start: 1.5rem;
+    }
+    .site-header nav a:hover { color: var(--fg); }
+
+    .hero {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
+      gap: clamp(2rem, 5vw, 4rem);
+      align-items: center;
+      max-width: 72rem;
+      margin-inline: auto;
+      padding: clamp(2rem, 8vw, 6rem) 1.5rem;
+    }
+
+    .eyebrow {
+      display: inline-block;
+      margin: 0 0 1rem;
+      padding: 0.25rem 0.75rem;
+      border-radius: 999px;
+      background: color-mix(in oklab, var(--accent) 12%, transparent);
+      color: var(--accent);
+      font-size: 0.875rem;
+      font-weight: 600;
+    }
+
+    .hero h1 {
+      margin: 0 0 1rem;
+      font-size: clamp(2.25rem, 5vw + 1rem, 4rem);
+      line-height: 1.05;
+      letter-spacing: -0.03em;
+      text-wrap: balance;
+    }
+
+    .hero p.lede {
+      margin: 0 0 2rem;
+      max-width: 34rem;
+      font-size: 1.125rem;
+      color: var(--muted);
+      text-wrap: pretty;
+    }
+
+    .cta-row {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: 1rem;
+    }
+
+    .cta-button {
+      display: inline-block;
+      padding: 0.9rem 1.6rem;
+      border-radius: var(--radius);
+      background: var(--accent);
+      color: var(--accent-fg);
+      font-weight: 700;
+      font-size: 1.0625rem;
+      text-decoration: none;
+      transition: transform 150ms ease, box-shadow 150ms ease;
+    }
+    .cta-button:hover {
+      transform: translateY(-1px);
+      box-shadow: 0 8px 24px color-mix(in oklab, var(--accent) 35%, transparent);
+    }
+    .cta-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .cta-note { color: var(--muted); font-size: 0.9375rem; }
+
+    .hero-media img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      border-radius: calc(var(--radius) * 1.5);
+      box-shadow: 0 24px 60px rgb(0 0 0 / 0.18);
+    }
+
+    /*
+      Variant styling hooks. The experiment SDK can either rewrite DOM nodes
+      (targeted via the data-experiment attributes below) or simply set
+      <html data-variant="..."> and let CSS do the work.
+    */
+    [data-variant="b"] .cta-button { background: light-dark(#059669, #34d399); }
+    [data-variant="b"] .eyebrow {
+      color: light-dark(#059669, #34d399);
+      background: color-mix(in oklab, light-dark(#059669, #34d399) 12%, transparent);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .cta-button { transition: none; }
+      .cta-button:hover { transform: none; }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a class="logo" href="/">Lumen</a>
+    <nav aria-label="Primary">
+      <a href="#features">Features</a>
+      <a href="#pricing">Pricing</a>
+      <a href="#login">Log in</a>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-title" data-experiment="homepage-hero">
+      <div class="hero-copy">
+        <p class="eyebrow" data-experiment-slot="eyebrow">New: AI-assisted planning</p>
+        <h1 id="hero-title" data-experiment-slot="headline">Ship faster with less noise.</h1>
+        <p class="lede" data-experiment-slot="subheadline">
+          Lumen brings your roadmap, tasks, and team updates into one calm workspace,
+          so you can spend less time in meetings and more time building.
+        </p>
+        <div class="cta-row">
+          <a class="cta-button" href="#signup" data-experiment-slot="cta">Start free trial</a>
+          <span class="cta-note" data-experiment-slot="cta-note">No credit card required</span>
+        </div>
+      </div>
+
+      <div class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80"
+          srcset="
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=80 600w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1200&q=80 1200w,
+            https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1800&q=80 1800w"
+          sizes="(min-width: 72rem) 36rem, (min-width: 48rem) 50vw, 100vw"
+          width="1200"
+          height="900"
+          alt="A product team collaborating around a table with laptops"
+          fetchpriority="high"
+        >
+      </div>
+    </section>
+  </main>
+</body>
+</html>
