+<!doctype html>
+<html lang="en" class="exp-pending">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>Lumen — Ship faster with less effort</title>
+  <meta name="description" content="Lumen helps teams plan, build, and ship products faster." />
+
+  <!-- Open connections to the experiment CDN as early as possible to keep the hidden window short. -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin />
+  <link rel="dns-prefetch" href="https://cdn.example.com" />
+
+  <!--
+    ANTI-FLICKER GUARD
+    This must stay inline in <head> and come BEFORE any visible content, so
+    the page is hidden from the very first paint. It is removed once the
+    experiment variant has been applied, or after a safety timeout so a slow
+    or unreachable CDN never leaves users staring at a blank page.
+  -->
+  <style id="exp-antiflicker">
+    html.exp-pending body { opacity: 0 !important; visibility: hidden !important; }
+  </style>
+  <noscript>
+    <!-- Without JS the experiment can't run, so always show the original content. -->
+    <style>html.exp-pending body { opacity: 1 !important; visibility: visible !important; }</style>
+  </noscript>
+
+  <script>
+    (function () {
+      var TIMEOUT_MS = 2000; // max time content may be hidden
+      var SDK_URL = 'https://cdn.example.com/experiment-sdk.js';
+      var doc = document.documentElement;
+      var revealed = false;
+
+      function reveal(reason) {
+        if (revealed) return;
+        revealed = true;
+        clearTimeout(timer);
+        // Wait one frame so DOM changes made by the SDK are committed before
+        // the page becomes visible.
+        requestAnimationFrame(function () {
+          doc.classList.remove('exp-pending');
+          doc.setAttribute('data-exp-reveal', reason);
+        });
+      }
+
+      // Public hook: the SDK (or its config) can call this once the variant is applied.
+      window.__expReveal = function () { reveal('sdk'); };
+
+      // Safety net: never keep the page hidden longer than TIMEOUT_MS.
+      var timer = setTimeout(function () { reveal('timeout'); }, TIMEOUT_MS);
+
+      function onSdkLoaded() {
+        var sdk = window.ExperimentSDK || window.experimentSDK;
+        // Prefer an explicit "variant applied" signal if the SDK exposes one.
+        try {
+          if (sdk && typeof sdk.ready === 'function') {
+            var r = sdk.ready(function () { reveal('sdk'); });
+            if (r && typeof r.then === 'function') {
+              r.then(function () { reveal('sdk'); }, function () { reveal('sdk-error'); });
+            }
+            return;
+          }
+          if (sdk && typeof sdk.onReady === 'function') {
+            sdk.onReady(function () { reveal('sdk'); });
+            return;
+          }
+        } catch (e) {
+          reveal('sdk-error');
+          return;
+        }
+        // Otherwise assume the SDK applied its changes synchronously on execution.
+        // If the body hasn't been parsed yet, wait for it so DOM edits can land.
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', function () { reveal('loaded'); });
+        } else {
+          reveal('loaded');
+        }
+      }
+
+      var s = document.createElement('script');
+      s.src = SDK_URL;
+      s.async = true;
+      s.crossOrigin = 'anonymous';
+      s.onload = onSdkLoaded;
+      s.onerror = function () { reveal('sdk-error'); };
+      document.head.appendChild(s);
+    })();
+  </script>
+
+  <style>
+    :root {
+      --bg: #0b1020;
+      --fg: #f5f7ff;
+      --muted: #b6bdd6;
+      --accent: #6c5ce7;
+      --accent-hover: #5a4bd4;
+      --radius: 12px;
+    }
+    * { box-sizing: border-box; }
+    html, body { margin: 0; padding: 0; }
+    body {
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+      color: var(--fg);
+      background: var(--bg);
+      line-height: 1.5;
+      transition: opacity .15s ease-out;
+    }
+    a { color: inherit; }
+
+    .nav {
+      position: absolute; inset: 0 0 auto 0; z-index: 2;
+      display: flex; align-items: center; justify-content: space-between;
+      padding: 1.25rem clamp(1rem, 5vw, 4rem);
+    }
+    .logo { font-weight: 800; font-size: 1.25rem; letter-spacing: -.02em; text-decoration: none; }
+    .nav-links { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
+    .nav-links a { text-decoration: none; color: var(--muted); }
+    .nav-links a:hover { color: var(--fg); }
+
+    .hero {
+      position: relative;
+      min-height: 100vh;
+      display: grid; place-items: center;
+      padding: 6rem clamp(1rem, 5vw, 4rem) 4rem;
+      background:
+        linear-gradient(180deg, rgba(11,16,32,.55) 0%, rgba(11,16,32,.85) 70%, var(--bg) 100%),
+        url("https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1920&q=80") center / cover no-repeat;
+      text-align: center;
+    }
+    .hero-inner { max-width: 760px; }
+    .eyebrow {
+      display: inline-block; margin-bottom: 1rem;
+      padding: .35rem .8rem; border-radius: 999px;
+      background: rgba(108,92,231,.2); border: 1px solid rgba(108,92,231,.5);
+      font-size: .85rem; color: #d7d1ff;
+    }
+    .hero h1 {
+      margin: 0 0 1rem;
+      font-size: clamp(2.25rem, 6vw, 4rem);
+      line-height: 1.1; letter-spacing: -.03em;
+    }
+    .hero p { margin: 0 auto 2rem; max-width: 600px; font-size: clamp(1rem, 2vw, 1.25rem); color: var(--muted); }
+
+    .cta-group { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
+    .btn {
+      display: inline-block; padding: .9rem 1.75rem; border-radius: var(--radius);
+      font-weight: 600; font-size: 1.05rem; text-decoration: none;
+      transition: background-color .15s, transform .15s, box-shadow .15s;
+    }
+    .btn-primary { background: var(--accent); color: #fff; box-shadow: 0 10px 30px rgba(108,92,231,.4); }
+    .btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); }
+    .btn-secondary { border: 1px solid rgba(255,255,255,.3); color: var(--fg); }
+    .btn-secondary:hover { background: rgba(255,255,255,.08); }
+    .btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
+    .fine-print { margin-top: 1rem; font-size: .85rem; color: var(--muted); }
+
+    footer { padding: 2rem; text-align: center; color: var(--muted); font-size: .85rem; }
+
+    @media (max-width: 600px) { .nav-links { display: none; } }
+    @media (prefers-reduced-motion: reduce) { body, .btn { transition: none; } }
+  </style>
+</head>
+<body>
+  <header class="nav">
+    <a href="/" class="logo">Lumen</a>
+    <nav aria-label="Primary">
+      <ul class="nav-links">
+        <li><a href="#features">Features</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#login">Log in</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <!-- data-experiment-* attributes give the A/B SDK stable hooks to target. -->
+    <section class="hero" data-experiment="hero">
+      <div class="hero-inner">
+        <span class="eyebrow" data-experiment-slot="eyebrow">New: AI-powered planning</span>
+        <h1 data-experiment-slot="headline">Ship your best work, faster.</h1>
+        <p data-experiment-slot="subheadline">
+          Lumen brings planning, building, and shipping into one place, so your team
+          spends less time coordinating and more time creating.
+        </p>
+        <div class="cta-group">
+          <a href="#signup" class="btn btn-primary" id="hero-cta" data-experiment-slot="cta">
+            Start your free trial
+          </a>
+          <a href="#demo" class="btn btn-secondary">Watch demo</a>
+        </div>
+        <p class="fine-print">No credit card required · Cancel anytime</p>
+      </div>
+    </section>
+  </main>
+
+  <footer>&copy; 2026 Lumen, Inc. All rights reserved.</footer>
+</body>
+</html>
