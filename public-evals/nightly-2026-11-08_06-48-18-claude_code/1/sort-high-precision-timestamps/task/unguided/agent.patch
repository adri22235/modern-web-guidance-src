+  <script src="order-timeline.js"></script>
+  <script>
+    (function () {
+      const { buildTimeline, formatTimestampNs, formatDurationNs } = window.OrderTimeline;
+      const btn = document.getElementById('load-timeline-btn');
+      const statusEl = document.getElementById('timeline-status');
+      const statsEl = document.getElementById('timeline-stats');
+      const tableWrap = document.getElementById('timeline-table-wrap');
+      const tbody = document.getElementById('timeline-body');
+
+      function setStatus(text, isError) {
+        statusEl.textContent = text;
+        statusEl.classList.toggle('error', Boolean(isError));
+      }
+
+      function cell(text, className) {
+        const td = document.createElement('td');
+        td.textContent = text;
+        if (className) td.className = className;
+        return td;
+      }
+
+      function renderStats(stats, invalidCount) {
+        const items = [
+          ['Events', String(stats.count)],
+          ['Total span', formatDurationNs(stats.spanNs)],
+          ['Shortest gap', stats.minGapNs === null ? '—' : formatDurationNs(stats.minGapNs)],
+          ['Longest gap', stats.maxGapNs === null ? '—' : formatDurationNs(stats.maxGapNs)],
+          ['Mean gap', stats.meanGapNs === null ? '—' : formatDurationNs(stats.meanGapNs)],
+          ['Simultaneous', String(stats.ties)],
+          ['Reordered', String(stats.reordered)],
+        ];
+        if (invalidCount) items.push(['Rejected', String(invalidCount)]);
+        statsEl.replaceChildren(...items.map(([label, value]) => {
+          const div = document.createElement('div');
+          div.className = 'stat';
+          const l = document.createElement('span');
+          l.className = 'label';
+          l.textContent = label;
+          const v = document.createElement('span');
+          v.className = 'value';
+          v.textContent = value;
+          div.append(l, v);
+          return div;
+        }));
+        statsEl.hidden = false;
+      }
+
+      function renderTable(events) {
+        tbody.replaceChildren(...events.map((ev, i) => {
+          const tr = document.createElement('tr');
+          if (ev.gapNs === 0n) tr.className = 'tie';
+          const ts = cell(formatTimestampNs(ev.ns), 'mono');
+          ts.title = `Original: ${ev.timestamp}\nEpoch ns: ${ev.ns}`;
+          const pos = cell(String(i + 1), 'num');
+          if (ev.index !== i) {
+            const moved = document.createElement('span');
+            moved.className = 'moved';
+            moved.textContent = ` (arrived #${ev.index + 1})`;
+            pos.append(moved);
+          }
+          tr.append(
+            pos,
+            ts,
+            cell(ev.service ?? ''),
+            cell(ev.type ?? ''),
+            cell(ev.orderId ?? ''),
+            cell(ev.gapNs === null ? '—' : formatDurationNs(ev.gapNs), 'mono num gap'),
+            cell(formatDurationNs(ev.sinceStartNs), 'mono num'),
+          );
+          return tr;
+        }));
+        tableWrap.hidden = false;
+      }
+
+      btn.addEventListener('click', async () => {
+        btn.disabled = true;
+        setStatus('Loading order events…');
+        try {
+          const res = await fetch('order-events.json', { cache: 'no-store' });
+          if (!res.ok) throw new Error(`Request failed (${res.status})`);
+          const batch = await res.json();
+          if (!Array.isArray(batch.events)) throw new Error('Batch has no events array');
+
+          const { events, invalid, stats } = buildTimeline(batch.events);
+          renderStats(stats, invalid.length);
+          renderTable(events);
+
+          let msg = `Sorted ${events.length} events from batch ${batch.batchId ?? '(unnamed)'}.`;
+          if (invalid.length) {
+            msg += ` Skipped ${invalid.length} with invalid timestamps: ` +
+              invalid.map(e => `${e.id ?? '#' + (e.index + 1)} (${e.error})`).join('; ');
+          }
+          setStatus(msg, invalid.length > 0);
+        } catch (err) {
+          setStatus(`Could not load order events: ${err.message}`, true);
+        } finally {
+          btn.disabled = false;
+        }
+      });
+    })();
+  </script>
+
 </body>
 
