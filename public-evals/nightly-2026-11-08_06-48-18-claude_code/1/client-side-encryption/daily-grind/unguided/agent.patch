+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  SUITES, generateStoreKey, sealNote, openNote, selectRecipientKey, toB64u, fromB64u, MAX_NOTE_CHARS,
+} from '../src/delivery-notes/crypto.js';
+
+async function setup(suiteId) {
+  const k = await generateStoreKey(suiteId, `${suiteId}-test`);
+  const bundle = { v: 1, keys: [{ suite: suiteId, kid: k.kid, publicKey: toB64u(k.publicKey), fingerprint: k.fingerprint }] };
+  const keyring = { [k.kid]: { suite: suiteId, publicKey: k.publicKey, secretKey: k.secretKey } };
+  return { k, bundle, keyring };
+}
+
+for (const suiteId of Object.keys(SUITES)) {
+  test(`${suiteId}: round trip`, async () => {
+    const { k, bundle, keyring } = await setup(suiteId);
+    const r = await selectRecipientKey(bundle, suiteId, [k.fingerprint]);
+    const note = 'Gate code 4821 ☕ — leave with concierge, nut allergy!';
+    const env = await sealNote(r, note, { orderRef: 'DG-1042' });
+    assert.equal(env.suite, suiteId);
+    assert.ok(!JSON.stringify(env).includes('4821'));
+    assert.equal(await openNote(env, keyring), note);
+  });
+
+  test(`${suiteId}: tampering is detected`, async () => {
+    const { k, bundle, keyring } = await setup(suiteId);
+    const r = await selectRecipientKey(bundle, suiteId);
+    const env = await sealNote(r, 'secret', { orderRef: 'DG-1' });
+    const ct = fromB64u(env.ct); ct[0] ^= 1;
+    await assert.rejects(openNote({ ...env, ct: toB64u(ct) }, keyring), /Authentication failed/);
+    await assert.rejects(openNote({ ...env, orderRef: 'DG-2' }, keyring), /Authentication failed/);
+    await assert.rejects(openNote({ ...env, createdAt: new Date(0).toISOString() }, keyring), /Authentication failed/);
+    const kc = fromB64u(env.enc); kc[5] ^= 1;
+    await assert.rejects(openNote({ ...env, enc: toB64u(kc) }, keyring), /Authentication failed/);
+  });
+
+  test(`${suiteId}: wrong key cannot decrypt`, async () => {
+    const a = await setup(suiteId);
+    const b = await setup(suiteId);
+    const env = await sealNote(await selectRecipientKey(a.bundle, suiteId), 'secret');
+    await assert.rejects(openNote(env, b.keyring), /Authentication failed/);
+  });
+}
+
+test('suite downgrade / mixing is rejected', async () => {
+  const x = await setup('XWING-768');
+  const env = await sealNote(await selectRecipientKey(x.bundle, 'XWING-768'), 'secret');
+  await assert.rejects(openNote({ ...env, suite: 'MLKEM-1024' }, x.keyring), /No matching store key/);
+  await assert.rejects(openNote({ ...env, suite: 'X25519' }, x.keyring), /Unsupported encryption suite/);
+});
+
+test('key bundle validation', async () => {
+  const { k, bundle } = await setup('XWING-768');
+  await assert.rejects(selectRecipientKey(bundle, 'XWING-768', ['00']), /not pinned/);
+  const bad = structuredClone(bundle); bad.keys[0].fingerprint = 'ff';
+  await assert.rejects(selectRecipientKey(bad, 'XWING-768'), /fingerprint mismatch/);
+  const short = structuredClone(bundle); short.keys[0].publicKey = toB64u(k.publicKey.slice(1)); delete short.keys[0].fingerprint;
+  await assert.rejects(selectRecipientKey(short, 'XWING-768'), /invalid length/);
+  const exp = structuredClone(bundle); exp.keys[0].expires = '2000-01-01T00:00:00Z';
+  await assert.rejects(selectRecipientKey(exp, 'XWING-768'), /expired/);
+  await assert.rejects(selectRecipientKey(bundle, 'MLKEM-1024'), /has not published/);
+});
+
+test('input limits', async () => {
+  const { bundle } = await setup('XWING-768');
+  const r = await selectRecipientKey(bundle, 'XWING-768');
+  await assert.rejects(sealNote(r, '   '), /empty/);
+  await assert.rejects(sealNote(r, 'x'.repeat(MAX_NOTE_CHARS + 1)), /exceeds/);
+  await assert.rejects(sealNote(r, 'ok', { orderRef: '<script>' }), /Order reference/);
+});
