@@ -0,0 +1,360 @@
+// Encrypted delivery notes for The Daily Grind.
+//
+// Flow (envelope encryption, all in the browser via WebCrypto):
+//   1. Recipient setup: the delivery team's key pair is generated once with
+//      extractable:false and persisted in IndexedDB. Its public key is what a
+//      customer's browser encrypts to. (In production, the public key would be
+//      published by the server and the private key would live with the store.)
+//   2. Per note: the sender encapsulates a fresh one-time key against the
+//      recipient public key, encrypts the note with AEAD and a fresh 12-byte IV,
+//      and binds the order ID + suite + version as additional authenticated data.
+//
+// Suites, best first:
+//   - MLKEM768-X25519 hybrid post-quantum KEM + ChaCha20-Poly1305
+//   - X25519 ephemeral-static key agreement + HKDF-SHA-256 + AES-GCM
+//   - ECDH P-256 ephemeral-static key agreement + HKDF-SHA-256 + AES-GCM
+
+const VERSION = 1;
+const SUITES = {
+  PQ: 'MLKEM768-X25519+ChaCha20-Poly1305',
+  X25519: 'X25519+HKDF-SHA256+AES-GCM',
+  P256: 'ECDH-P256+HKDF-SHA256+AES-GCM',
+};
+const HKDF_INFO = new TextEncoder().encode(`daily-grind-delivery-note-v${VERSION}`);
+const MAX_NOTE_LENGTH = 500;
+
+// ---------- encoding helpers ----------
+
+function toBase64(bytes) {
+  if (typeof bytes.toBase64 === 'function') return bytes.toBase64();
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin);
+}
+
+function fromBase64(str) {
+  if (typeof Uint8Array.fromBase64 === 'function') return Uint8Array.fromBase64(str);
+  return Uint8Array.from(atob(str), (c) => c.charCodeAt(0));
+}
+
+function aadFor(suite, orderId) {
+  return new TextEncoder().encode(JSON.stringify({ v: VERSION, suite, orderId }));
+}
+
+// ---------- capability detection ----------
+
+function supportsPostQuantum() {
+  try {
+    return (
+      typeof globalThis.SubtleCrypto?.supports === 'function' &&
+      SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305') &&
+      SubtleCrypto.supports('decapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+    );
+  } catch {
+    return false;
+  }
+}
+
+function classicalAlg(suite) {
+  return suite === SUITES.X25519 ? { name: 'X25519' } : { name: 'ECDH', namedCurve: 'P-256' };
+}
+
+// ---------- recipient key storage (IndexedDB) ----------
+
+const DB_NAME = 'daily-grind-secure-notes';
+const STORE = 'keys';
+const KEY_ID = 'delivery-recipient';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function idb(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const req = fn(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(req.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+async function generateRecipient() {
+  if (supportsPostQuantum()) {
+    try {
+      const keyPair = await crypto.subtle.generateKey('MLKEM768-X25519', false, [
+        'encapsulateKey',
+        'decapsulateKey',
+      ]);
+      return { suite: SUITES.PQ, keyPair };
+    } catch {
+      /* fall through to classical */
+    }
+  }
+  try {
+    const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+    return { suite: SUITES.X25519, keyPair };
+  } catch {
+    const keyPair = await crypto.subtle.generateKey(
+      { name: 'ECDH', namedCurve: 'P-256' },
+      false,
+      ['deriveBits'],
+    );
+    return { suite: SUITES.P256, keyPair };
+  }
+}
+
+async function loadOrCreateRecipient({ rotate = false } = {}) {
+  if (!rotate) {
+    try {
+      const existing = await idb('readonly', (s) => s.get(KEY_ID));
+      if (existing?.keyPair && existing.suite) return existing;
+    } catch {
+      /* IndexedDB unavailable (e.g. private mode) — use an in-memory key */
+    }
+  }
+  const record = await generateRecipient();
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey(record.suite === SUITES.PQ ? 'raw-public' : 'raw', record.keyPair.publicKey),
+  );
+  const full = { ...record, publicKey: toBase64(publicKeyBytes), createdAt: Date.now() };
+  try {
+    await idb('readwrite', (s) => s.put(full, KEY_ID));
+  } catch {
+    /* non-persistent fallback */
+  }
+  return full;
+}
+
+// ---------- key establishment ----------
+
+async function deriveAesKey(privateKey, peerPublicKey, suite) {
+  const bits = await crypto.subtle.deriveBits(
+    { ...classicalAlg(suite), public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', bits, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    { name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info: HKDF_INFO },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+async function encapsulate(suite, publicKeyB64) {
+  const pubBytes = fromBase64(publicKeyB64);
+  if (suite === SUITES.PQ) {
+    const pub = await crypto.subtle.importKey('raw-public', pubBytes, 'MLKEM768-X25519', true, [
+      'encapsulateKey',
+    ]);
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      'MLKEM768-X25519',
+      pub,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt'],
+    );
+    return { key: sharedKey, capsule: new Uint8Array(ciphertext) };
+  }
+  // Ephemeral-static key agreement: the ephemeral public key is the capsule.
+  const alg = classicalAlg(suite);
+  const pub = await crypto.subtle.importKey('raw', pubBytes, alg, true, []);
+  const ephemeral = await crypto.subtle.generateKey(alg, false, ['deriveBits']);
+  const capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const key = await deriveAesKey(ephemeral.privateKey, pub, suite);
+  return { key, capsule };
+}
+
+async function decapsulate(suite, privateKey, capsule) {
+  if (suite === SUITES.PQ) {
+    return crypto.subtle.decapsulateKey(
+      'MLKEM768-X25519',
+      privateKey,
+      capsule,
+      'ChaCha20-Poly1305',
+      false,
+      ['decrypt'],
+    );
+  }
+  const ephemeralPub = await crypto.subtle.importKey('raw', capsule, classicalAlg(suite), true, []);
+  return deriveAesKey(privateKey, ephemeralPub, suite);
+}
+
+// ---------- seal / open ----------
+
+export async function sealNote(recipient, orderId, plaintext) {
+  const { suite, publicKey } = recipient;
+  const { key, capsule } = await encapsulate(suite, publicKey);
+  const iv = crypto.getRandomValues(new Uint8Array(12)); // fresh per message
+  const ct = await crypto.subtle.encrypt(
+    { name: key.algorithm.name, iv, additionalData: aadFor(suite, orderId) },
+    key,
+    new TextEncoder().encode(plaintext),
+  );
+  return {
+    v: VERSION,
+    suite,
+    orderId,
+    capsule: toBase64(capsule),
+    iv: toBase64(iv),
+    ciphertext: toBase64(new Uint8Array(ct)),
+  };
+}
+
+export async function openNote(recipient, envelope) {
+  if (envelope?.v !== VERSION) throw new Error('Unsupported envelope version.');
+  if (envelope.suite !== recipient.suite) {
+    throw new Error('Envelope was sealed for a different key suite.');
+  }
+  const key = await decapsulate(envelope.suite, recipient.keyPair.privateKey, fromBase64(envelope.capsule));
+  const pt = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv: fromBase64(envelope.iv),
+      additionalData: aadFor(envelope.suite, envelope.orderId),
+    },
+    key,
+    fromBase64(envelope.ciphertext),
+  );
+  return new TextDecoder().decode(pt);
+}
+
+// ---------- UI wiring ----------
+
+function init() {
+  const root = document.getElementById('secure-notes');
+  if (!root) return;
+
+  const form = root.querySelector('#note-form');
+  const orderInput = root.querySelector('#note-order');
+  const noteInput = root.querySelector('#note-text');
+  const counter = root.querySelector('#note-count');
+  const suiteOut = root.querySelector('#note-suite');
+  const status = root.querySelector('#note-status');
+  const envelopeOut = root.querySelector('#note-envelope');
+  const decryptBtn = root.querySelector('#note-decrypt');
+  const rotateBtn = root.querySelector('#note-rotate');
+  const tamperBtn = root.querySelector('#note-tamper');
+  const decryptedOut = root.querySelector('#note-decrypted');
+  const submitBtn = form.querySelector('button[type="submit"]');
+
+  if (!globalThis.isSecureContext || !globalThis.crypto?.subtle) {
+    status.textContent =
+      'Encrypted notes require a secure (HTTPS) connection. Please reload this page over HTTPS.';
+    form.querySelectorAll('input, textarea, button').forEach((el) => (el.disabled = true));
+    return;
+  }
+
+  let recipient;
+  let envelope;
+
+  const setStatus = (msg) => (status.textContent = msg);
+  const describeSuite = () => {
+    const pq = recipient.suite === SUITES.PQ;
+    suiteOut.textContent = `${recipient.suite}${pq ? ' — hybrid post-quantum' : ' — classical fallback'}`;
+    suiteOut.dataset.pq = String(pq);
+  };
+  const resetEnvelope = () => {
+    envelope = undefined;
+    envelopeOut.textContent = '';
+    decryptedOut.textContent = '';
+    decryptBtn.disabled = true;
+    tamperBtn.disabled = true;
+  };
+
+  const ready = loadOrCreateRecipient()
+    .then((r) => {
+      recipient = r;
+      describeSuite();
+      submitBtn.disabled = false;
+      rotateBtn.disabled = false;
+    })
+    .catch((err) => {
+      setStatus(`Could not set up encryption keys: ${err.message}`);
+    });
+
+  noteInput.maxLength = MAX_NOTE_LENGTH;
+  const updateCount = () => (counter.textContent = `${noteInput.value.length}/${MAX_NOTE_LENGTH}`);
+  noteInput.addEventListener('input', updateCount);
+  updateCount();
+
+  form.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    if (!form.reportValidity()) return;
+    await ready;
+    if (!recipient) return;
+    submitBtn.disabled = true;
+    try {
+      envelope = await sealNote(recipient, orderInput.value.trim(), noteInput.value);
+      envelopeOut.textContent = JSON.stringify(envelope, null, 2);
+      decryptedOut.textContent = '';
+      noteInput.value = ''; // don't leave plaintext lying around in the form
+      updateCount();
+      decryptBtn.disabled = false;
+      tamperBtn.disabled = false;
+      setStatus(
+        `Note sealed for order ${envelope.orderId}. Only the delivery team's private key can open it.`,
+      );
+    } catch (err) {
+      setStatus(`Encryption failed: ${err.message}`);
+    } finally {
+      submitBtn.disabled = false;
+    }
+  });
+
+  decryptBtn.addEventListener('click', async () => {
+    if (!envelope) return;
+    try {
+      decryptedOut.textContent = await openNote(recipient, envelope);
+      setStatus('Delivery team view: note decrypted and authenticated.');
+    } catch (err) {
+      decryptedOut.textContent = '';
+      setStatus(
+        err.name === 'OperationError'
+          ? 'Authentication failed — this note was tampered with or sealed for another key.'
+          : `Decryption failed: ${err.message}`,
+      );
+    }
+  });
+
+  tamperBtn.addEventListener('click', () => {
+    if (!envelope) return;
+    // Simulate an attacker changing the order the note is bound to.
+    envelope = { ...envelope, orderId: `${envelope.orderId}-X` };
+    envelopeOut.textContent = JSON.stringify(envelope, null, 2);
+    decryptedOut.textContent = '';
+    setStatus('Envelope metadata modified. Try decrypting to see authentication reject it.');
+  });
+
+  rotateBtn.addEventListener('click', async () => {
+    rotateBtn.disabled = true;
+    try {
+      recipient = await loadOrCreateRecipient({ rotate: true });
+      describeSuite();
+      setStatus('Delivery key rotated. Previously sealed notes can no longer be opened.');
+    } catch (err) {
+      setStatus(`Key rotation failed: ${err.message}`);
+    } finally {
+      rotateBtn.disabled = false;
+    }
+  });
+
+  resetEnvelope();
+}
+
+init();
