+  <script type="module">
+    // Load WebAuthn polyfills (getClientCapabilities, parseCreationOptionsFromJSON, toJSON)
+    // for browsers that support PublicKeyCredential but not these newer helpers.
+    const polyfillsReady = import('https://esm.sh/webauthn-polyfills').catch(() => {});
+
+    const form = document.getElementById('signin-form');
+    const status = document.getElementById('signin-status');
+    const button = form.querySelector('[data-testid="signin-button"]');
+
+    // Shared controller for any pending conditional-get (autofill) request on this page.
+    // Must be aborted before calling navigator.credentials.create().
+    let autofillAbortController = new AbortController();
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      status.textContent = '';
+      status.classList.remove('error');
+      button.disabled = true;
+
+      try {
+        const response = await fetch('/api/signin', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify({
+            username: form.username.value.trim(),
+            password: form.password.value,
+          }),
+        });
+
+        if (!response.ok) {
+          throw new Error('Sign-in failed');
+        }
+
+        status.textContent = 'Signed in. Welcome back!';
+        form.password.value = '';
+
+        // Fire-and-forget: silently upgrade the account with a passkey.
+        triggerConditionalCreate().catch(() => {});
+      } catch {
+        status.textContent = 'Incorrect username or password.';
+        status.classList.add('error');
+      } finally {
+        button.disabled = false;
+      }
+    });
+
+    async function signalUnknown(rpId, credentialId) {
+      if (rpId && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+        } catch {
+          // Ignore — best-effort cleanup only.
+        }
+      }
+    }
+
+    async function triggerConditionalCreate() {
+      if (!window.PublicKeyCredential) return;
+      await polyfillsReady;
+      if (typeof PublicKeyCredential.getClientCapabilities !== 'function') return;
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalCreate !== true) return;
+
+      // Clear any pending conditional-get so it doesn't conflict with create().
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      // Server options must include rp.id and excludeCredentials for the user's existing passkeys.
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        body: JSON.stringify({ conditional: true }),
+      });
+      if (!optionsResponse.ok) return;
+
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(await optionsResponse.json());
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+      } catch (e) {
+        // Silently ignore expected outcomes (already registered, declined, aborted).
+        if (!['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e?.name)) {
+          console.error('Unexpected conditional create error:', e);
+        }
+        return;
+      }
+      if (!credential) return;
+
+      const encodedResponse = credential.toJSON();
+      // Always use the server-provided rp.id — never window.location.hostname.
+      const rpId = publicKey.rp?.id;
+
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(encodedResponse),
+        });
+        if (!verifyResponse.ok) {
+          await signalUnknown(rpId, encodedResponse.id);
+        }
+      } catch (err) {
+        console.error('Passkey verification network failure:', err);
+        await signalUnknown(rpId, encodedResponse.id);
+      }
+    }
+  </script>
+
