+  <script>
+    // Load the Invoker Commands polyfill only where native support is missing.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      (async () => {
+        try {
+          await import('https://esm.run/invokers-polyfill');
+        } catch (err) {
+          console.error('Error loading invokers polyfill:', err);
+        }
+      })();
+    }
+
+    const actionTarget = document.getElementById('action-target');
+    const toggleCommands = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+
+    // The `command` event does not bubble, so listen on the target itself.
+    actionTarget.addEventListener('command', (event) => {
+      const { command, source } = event;
+
+      if (command in toggleCommands) {
+        const isOn = actionTarget.classList.toggle(toggleCommands[command]);
+        source?.setAttribute('aria-pressed', String(isOn));
+      } else if (command === '--reset') {
+        actionTarget.classList.remove(...Object.values(toggleCommands));
+        document
+          .querySelectorAll('button[commandfor="action-target"][aria-pressed]')
+          .forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
+      }
+    });
+  </script>
+
