+  <script>
+    (() => {
+      const target = document.getElementById('action-target');
+      const classes = { '--spin': 'is-spun', '--grow': 'is-grown', '--round': 'is-rounded' };
+      const buttons = document.querySelectorAll('[commandfor="action-target"]');
+
+      const syncPressed = () => {
+        buttons.forEach((btn) => {
+          const cls = classes[btn.getAttribute('command')];
+          if (cls) btn.setAttribute('aria-pressed', String(target.classList.contains(cls)));
+        });
+      };
+
+      target.addEventListener('command', (event) => {
+        const { command } = event;
+        if (command === '--reset') {
+          target.classList.remove(...Object.values(classes));
+        } else if (classes[command]) {
+          target.classList.toggle(classes[command]);
+        } else {
+          return;
+        }
+        syncPressed();
+      });
+
+      // Minimal fallback for browsers without the Invoker Commands API.
+      if (!('command' in HTMLButtonElement.prototype)) {
+        document.addEventListener('click', (e) => {
+          const btn = e.target.closest('button[commandfor][command]');
+          if (!btn) return;
+          const el = document.getElementById(btn.getAttribute('commandfor'));
+          const command = btn.getAttribute('command');
+          if (!el || !command.startsWith('--')) return;
+          const evt = new Event('command', { cancelable: true });
+          Object.defineProperties(evt, {
+            command: { value: command },
+            source: { value: btn },
+          });
+          el.dispatchEvent(evt);
+        });
+      }
+    })();
+  </script>
+
