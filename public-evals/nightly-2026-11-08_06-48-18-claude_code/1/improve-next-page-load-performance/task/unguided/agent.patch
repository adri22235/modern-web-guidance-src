+
+  <!--
+    Link prefetching.
+    Same-origin links are prefetched when the user shows intent (hover / focus /
+    pointerdown), so the next page loads almost instantly on click.
+    Links that trigger side effects on GET (e.g. /logout) must never be
+    prefetched: they are excluded by URL pattern AND by the data-no-prefetch
+    attribute. Add data-no-prefetch to any other link with side effects.
+  -->
+  <script type="speculationrules">
+  {
+    "prefetch": [{
+      "source": "document",
+      "where": {
+        "and": [
+          { "href_matches": "/*" },
+          { "not": { "href_matches": ["/logout", "/logout/*"] } },
+          { "not": { "selector_matches": "[data-no-prefetch], [rel~=nofollow], [download]" } }
+        ]
+      },
+      "eagerness": "moderate"
+    }]
+  }
+  </script>
+  <script>
+    // Fallback for browsers without Speculation Rules support (Firefox, Safari):
+    // inject <link rel="prefetch"> on hover / focus / touch, with the same exclusions.
+    (function () {
+      if (HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules')) return;
+      var conn = navigator.connection;
+      if (conn && (conn.saveData || /2g/.test(conn.effectiveType || ''))) return;
+
+      var EXCLUDED_PATHS = [/^\/logout(\/|$)/i];
+      var done = new Set();
+      var timer;
+
+      function eligible(a) {
+        if (!a || !a.href || a.hasAttribute('data-no-prefetch') || a.hasAttribute('download')) return false;
+        if (/(^|\s)nofollow(\s|$)/i.test(a.rel)) return false;
+        var url = new URL(a.href, location.href);
+        if (url.origin !== location.origin || !/^https?:$/.test(url.protocol)) return false;
+        if (url.pathname === location.pathname && url.search === location.search) return false;
+        return !EXCLUDED_PATHS.some(function (re) { return re.test(url.pathname); });
+      }
+
+      function prefetch(a) {
+        var url = new URL(a.href, location.href);
+        url.hash = '';
+        var key = url.href;
+        if (done.has(key)) return;
+        done.add(key);
+        var link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = key;
+        document.head.appendChild(link);
+      }
+
+      function onIntent(e, delay) {
+        var a = e.target.closest && e.target.closest('a[href]');
+        if (!eligible(a)) return;
+        clearTimeout(timer);
+        if (delay) timer = setTimeout(function () { prefetch(a); }, delay);
+        else prefetch(a);
+      }
+
+      document.addEventListener('mouseover', function (e) { onIntent(e, 65); }, { passive: true });
+      document.addEventListener('mouseout', function () { clearTimeout(timer); }, { passive: true });
+      document.addEventListener('focusin', function (e) { onIntent(e, 0); });
+      document.addEventListener('touchstart', function (e) { onIntent(e, 0); }, { passive: true });
+    })();
+  </script>
