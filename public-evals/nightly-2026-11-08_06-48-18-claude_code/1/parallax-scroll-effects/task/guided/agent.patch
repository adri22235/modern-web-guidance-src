+    /* Parallax Section
+       CSS-only, scroll-driven. Static by default; motion is layered on
+       only when the browser supports view timelines AND the user has no
+       reduced-motion preference (progressive enhancement, no JS). */
+    .parallax {
+      position: relative;
+      height: 100vh;
+      min-height: 32rem;
+      overflow: clip;
+      isolation: isolate;
+      display: grid;
+      place-items: center;
+      color: white;
+      background: var(--primary);
+      view-timeline: --parallax;
+    }
+
+    .parallax__layer {
+      position: absolute;
+      inset: 0;
+      pointer-events: none;
+    }
+
+    /* Layer 0 – far background: oversized so it never reveals edges while shifting */
+    .parallax__layer--back {
+      inset: -20% 0;
+      z-index: -3;
+      background:
+        linear-gradient(rgba(30, 18, 14, 0.65), rgba(30, 18, 14, 0.8)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=70') center / cover no-repeat;
+    }
+
+    /* Layer 1 – mid-ground: soft warm glows ("steam") */
+    .parallax__layer--mid {
+      z-index: -2;
+      background:
+        radial-gradient(circle at 18% 30%, rgba(255, 171, 64, 0.35), transparent 22%),
+        radial-gradient(circle at 82% 70%, rgba(215, 204, 200, 0.25), transparent 26%),
+        radial-gradient(circle at 60% 15%, rgba(255, 171, 64, 0.2), transparent 18%);
+    }
+
+    /* Layer 2 – near-ground: floating cup photos */
+    .parallax__layer--front {
+      z-index: -1;
+    }
+
+    .parallax__photo {
+      position: absolute;
+      width: clamp(130px, 22vw, 280px);
+      aspect-ratio: 4 / 5;
+      object-fit: cover;
+      border-radius: 12px;
+      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
+    }
+
+    .parallax__photo--left {
+      left: 6%;
+      top: 58%;
+      rotate: -6deg;
+    }
+
+    .parallax__photo--right {
+      right: 6%;
+      top: 8%;
+      rotate: 5deg;
+    }
+
+    /* Content layer – stays in normal flow for readability */
+    .parallax__content {
+      max-width: 36rem;
+      padding: 2rem;
+      text-align: center;
+      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
+    }
+
+    .parallax__content h2 {
+      font-size: clamp(2rem, 5vw, 3rem);
+      line-height: 1.15;
+      margin-bottom: 1rem;
+    }
+
+    .parallax__content p {
+      font-size: 1.1rem;
+    }
+
+    @media (max-width: 640px) {
+      .parallax__photo {
+        opacity: 0.55;
+      }
+    }
+
+    @keyframes parallax-shift {
+      from {
+        translate: 0 var(--parallax-from);
+      }
+
+      to {
+        translate: 0 var(--parallax-to);
+      }
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .parallax__layer,
+        .parallax__content {
+          animation: parallax-shift linear both;
+          /* Must come after the shorthand, which would otherwise reset it */
+          animation-timeline: --parallax;
+        }
+
+        /* Negative-to-positive = drifts down relative to the section = slower than scroll (far away).
+           Positive-to-negative = drifts up = faster than scroll (close by). */
+        .parallax__layer--back {
+          --parallax-from: -15vh;
+          --parallax-to: 15vh;
+        }
+
+        .parallax__layer--mid {
+          --parallax-from: -6vh;
+          --parallax-to: 6vh;
+        }
+
+        .parallax__layer--front {
+          --parallax-from: 20vh;
+          --parallax-to: -20vh;
+        }
+
+        .parallax__content {
+          --parallax-from: 6vh;
+          --parallax-to: -6vh;
+        }
+      }
+    }
+
