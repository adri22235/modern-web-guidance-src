+    /* ==========================================================
+       Parallax "Bean to Cup" section
+       Pure CSS scroll-driven animations (no JavaScript).
+       - Only `transform` is animated, so work stays on the compositor.
+       - Motion is opt-in: it only runs when the browser supports
+         scroll-driven animations AND the user has not asked for
+         reduced motion. Everyone else gets a static, layered scene.
+       ========================================================== */
+    .parallax {
+      position: relative;
+      min-height: 90vh;
+      display: grid;
+      place-items: center;
+      padding: 6rem 20px;
+      color: white;
+      background: #2b1d18;
+      /* `clip` (not `hidden`) so the section does not become a scroll
+         container — the view timeline must track the page scroller. */
+      overflow: clip;
+      isolation: isolate;
+      view-timeline: --parallax block;
+    }
+
+    .parallax__layer {
+      position: absolute;
+      /* Oversized so translating never reveals an empty edge. */
+      inset: -25% 0;
+      pointer-events: none;
+    }
+
+    /* Layer 1 — the far background photograph (slowest). */
+    .parallax__layer--back {
+      z-index: -3;
+      background:
+        linear-gradient(rgba(30, 18, 14, 0.55), rgba(30, 18, 14, 0.75)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=70') center / cover no-repeat;
+    }
+
+    /* Layers 2 & 3 — scattered coffee beans at two depths. */
+    .parallax__layer--mid {
+      z-index: -2;
+      opacity: 0.55;
+    }
+
+    .parallax__layer--front {
+      z-index: -1;
+    }
+
+    .bean {
+      position: absolute;
+      left: var(--x);
+      top: var(--y);
+      width: calc(var(--s) * 0.72);
+      height: var(--s);
+      border-radius: 50%;
+      background: radial-gradient(ellipse at 35% 30%, #8d5b3e, #4e2c1c 60%, #2e1a10);
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);
+      transform: rotate(var(--r, 0deg));
+    }
+
+    /* The bean's centre crease. */
+    .bean::after {
+      content: "";
+      position: absolute;
+      inset: 12% 46%;
+      border-radius: 50%;
+      background: #1f110a;
+      box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
+    }
+
+    .parallax__layer--mid .bean {
+      filter: blur(1.5px);
+    }
+
+    /* Foreground content scrolls at normal speed. */
+    .parallax__content {
+      position: relative;
+      max-width: 640px;
+      text-align: center;
+      padding: 2.5rem 2rem;
+      border-radius: 12px;
+      background: rgba(30, 18, 14, 0.6);
+      backdrop-filter: blur(4px);
+      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
+    }
+
+    .parallax__content h2 {
+      font-size: clamp(1.8rem, 4vw, 2.6rem);
+      margin-bottom: 1rem;
+      color: var(--accent);
+    }
+
+    .parallax__content p {
+      font-size: 1.05rem;
+      color: #f5ede9;
+    }
+
+    .parallax__content .btn {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+    }
+
+    .parallax__content .btn:hover,
+    .parallax__content .btn:focus-visible {
+      background: #ffc777;
+    }
+
+    .parallax__content .btn:focus-visible {
+      outline: 3px solid white;
+      outline-offset: 3px;
+    }
+
+    @keyframes parallax-shift {
+      from { transform: translate3d(0, calc(var(--depth) * -1), 0); }
+      to   { transform: translate3d(0, var(--depth), 0); }
+    }
+
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .parallax__layer {
+          will-change: transform;
+          animation: parallax-shift linear both;
+          animation-timeline: --parallax;
+          animation-range: cover 0% cover 100%;
+        }
+
+        /* Larger --depth = more travel = feels closer to the viewer.
+           Back layer drifts with the scroll (slow), the bean layers
+           counter-move progressively faster for depth. */
+        .parallax__layer--back  { --depth: 12%; }
+        .parallax__layer--mid   { --depth: -8%; }
+        .parallax__layer--front { --depth: -20%; }
+      }
+    }
+
