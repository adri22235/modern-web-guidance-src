+  <script>
+    // Last-resort fallback for browsers without scroll-state queries or
+    // scroll-driven animations: toggle indicator classes via IntersectionObserver.
+    if (!CSS.supports('container-type', 'scroll-state') && !CSS.supports('animation-timeline', 'scroll()')) {
+      for (const scroller of document.querySelectorAll('.reviews-scroller')) {
+        const list = scroller.querySelector('.review-list');
+        const [first, last] = [list.firstElementChild, list.lastElementChild];
+        const observer = new IntersectionObserver(entries => {
+          for (const { target, intersectionRatio } of entries) {
+            scroller.classList.toggle(target === first ? 'more-top' : 'more-bottom', intersectionRatio < 1);
+          }
+        }, { root: scroller, threshold: 1, rootMargin: '1px' });
+        observer.observe(first);
+        observer.observe(last);
+      }
+    }
+  </script>
+
