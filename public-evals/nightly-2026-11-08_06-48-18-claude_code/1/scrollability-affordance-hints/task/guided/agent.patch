+    /* Scroll indicators: sticky first/last children of the scroller, so they
+       stay pinned to the scrollport edges while taking up no layout space. */
+    .indicator-top,
+    .indicator-bottom {
+      position: sticky;
+      display: block;
+      height: var(--indicator-size);
+      z-index: 1;
