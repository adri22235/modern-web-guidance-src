+  <script>
+    (function () {
+      var wrapper = document.querySelector('.reviews-wrapper');
+      if (!wrapper) return;
+      var scroller = wrapper.querySelector('.reviews-scroll');
+      var top = wrapper.querySelector('.indicator-top');
+      var bottom = wrapper.querySelector('.indicator-bottom');
+      var THRESHOLD = 1; // tolerate sub-pixel rounding
+
+      function update() {
+        var maxScroll = scroller.scrollHeight - scroller.clientHeight;
+        top.classList.toggle('visible', scroller.scrollTop > THRESHOLD);
+        bottom.classList.toggle('visible', maxScroll - scroller.scrollTop > THRESHOLD);
+      }
+
+      scroller.addEventListener('scroll', update, { passive: true });
+      window.addEventListener('resize', update);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(update).observe(scroller);
+      }
+      update();
+    })();
+  </script>
