+  <!--
+    Inline sign-in. Returning customers can sign in without leaving the page,
+    using passkeys (WebAuthn conditional UI / autofill) or passwords saved in
+    their browser's password manager. Without JavaScript the form still posts
+    to /login, and the protected links simply navigate as before.
+  -->
+  <dialog class="signin-dialog" id="signin-dialog" aria-labelledby="signin-title">
+    <div class="signin-header">
+      <h2 id="signin-title">Welcome back</h2>
+      <p id="signin-subtitle">Sign in to continue.</p>
+      <button type="button" class="signin-close" id="signin-close" aria-label="Close sign-in">&times;</button>
+    </div>
+    <div class="signin-body">
+      <form id="signin-form" method="post" action="/login" novalidate>
+        <input type="hidden" name="next" id="signin-next" value="">
+
+        <label for="signin-username">Email</label>
+        <!-- "webauthn" token lets the browser offer saved passkeys in the autofill menu alongside saved passwords -->
+        <input type="email" id="signin-username" name="username" autocomplete="username webauthn"
+          autocapitalize="none" spellcheck="false" required>
+
+        <label for="signin-password">Password</label>
+        <input type="password" id="signin-password" name="password" autocomplete="current-password" required>
+
+        <p class="signin-error" id="signin-error" role="alert" aria-live="assertive"></p>
+
+        <button type="submit" class="btn" id="signin-submit">Sign In</button>
+      </form>
+
+      <div id="passkey-section" hidden>
+        <div class="signin-divider">or</div>
+        <button type="button" class="btn btn-outline" id="passkey-button">Sign in with a passkey</button>
+      </div>
+
+      <p class="signin-footer">
+        New here? <a href="/register" id="signin-register">Create an account</a>
+        &middot;
+        <a href="/forgot-password">Forgot password?</a>
+      </p>
+    </div>
+  </dialog>
+
+  <script>
+    (() => {
+      'use strict';
+
+      // Backend endpoints (same-origin, cookie-based session).
+      const API = {
+        session: '/api/auth/session',              // GET  -> { authenticated, user: { name, email } }
+        passwordLogin: '/api/auth/login',           // POST { username, password } -> { user }
+        passkeyOptions: '/api/auth/passkey/options', // POST -> PublicKeyCredentialRequestOptionsJSON
+        passkeyVerify: '/api/auth/passkey/verify',  // POST AuthenticationResponseJSON -> { user }
+      };
+
+      const DESTINATION_LABELS = {
+        '/rewards': 'Sign in to view your rewards.',
+        '/account': 'Sign in to manage your account.',
+        '/order-online': 'Sign in to start your order.',
+      };
+
+      const body = document.body;
+      const dialog = document.getElementById('signin-dialog');
+      const form = document.getElementById('signin-form');
+      const usernameInput = document.getElementById('signin-username');
+      const passwordInput = document.getElementById('signin-password');
+      const submitBtn = document.getElementById('signin-submit');
+      const errorEl = document.getElementById('signin-error');
+      const subtitleEl = document.getElementById('signin-subtitle');
+      const nextInput = document.getElementById('signin-next');
+      const passkeySection = document.getElementById('passkey-section');
+      const passkeyBtn = document.getElementById('passkey-button');
+      const greetingEl = document.getElementById('nav-greeting');
+
+      let signedIn = false;
+      let pendingDestination = null;
+      let conditionalAbort = null;
+
+      const webAuthnSupported = typeof window.PublicKeyCredential === 'function' &&
+        !!navigator.credentials && typeof navigator.credentials.get === 'function';
+
+      // ---------- Session state ----------
+
+      function setSignedIn(user) {
+        signedIn = !!user;
+        body.classList.toggle('is-signed-in', signedIn);
+        greetingEl.textContent = signedIn && user.name ? `Hi, ${user.name}` : '';
+      }
+
+      async function refreshSession() {
+        try {
+          const res = await fetch(API.session, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
+          if (!res.ok) return setSignedIn(null);
+          const data = await res.json();
+          setSignedIn(data && data.authenticated ? (data.user || {}) : null);
+        } catch {
+          setSignedIn(null);
+        }
+      }
+
+      // ---------- Helpers ----------
+
+      function b64urlToBuffer(value) {
+        const b64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = b64 + '='.repeat((4 - (b64.length % 4)) % 4);
+        const bin = atob(padded);
+        const bytes = new Uint8Array(bin.length);
+        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let bin = '';
+        for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
+        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseRequestOptions(json) {
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+        }
+        return {
+          ...json,
+          challenge: b64urlToBuffer(json.challenge),
+          allowCredentials: (json.allowCredentials || []).map((c) => ({ ...c, id: b64urlToBuffer(c.id) })),
+        };
+      }
+
+      function credentialToJSON(cred) {
+        if (typeof cred.toJSON === 'function') return cred.toJSON();
+        const r = cred.response;
+        return {
+          id: cred.id,
+          rawId: bufferToB64url(cred.rawId),
+          type: cred.type,
+          authenticatorAttachment: cred.authenticatorAttachment || undefined,
+          clientExtensionResults: cred.getClientExtensionResults ? cred.getClientExtensionResults() : {},
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : undefined,
+          },
+        };
+      }
+
+      async function postJSON(url, payload) {
+        const res = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: payload === undefined ? undefined : JSON.stringify(payload),
+        });
+        let data = null;
+        try { data = await res.json(); } catch { /* empty body */ }
+        if (!res.ok) {
+          const err = new Error((data && data.message) || 'Sign-in failed. Please try again.');
+          err.status = res.status;
+          throw err;
+        }
+        return data || {};
+      }
+
+      function showError(message) {
+        errorEl.textContent = message || '';
+      }
+
+      function setBusy(busy) {
+        submitBtn.disabled = busy;
+        passkeyBtn.disabled = busy;
+        submitBtn.textContent = busy ? 'Signing in…' : 'Sign In';
+      }
+
+      function abortConditional() {
+        if (conditionalAbort) {
+          conditionalAbort.abort();
+          conditionalAbort = null;
+        }
+      }
+
+      // ---------- Completing sign-in ----------
+
+      function onSignedIn(user) {
+        setSignedIn(user || {});
+        abortConditional();
+        const destination = pendingDestination;
+        pendingDestination = null;
+        form.reset();
+        dialog.close();
+        if (destination) window.location.assign(destination);
+      }
+
+      // ---------- Passkeys ----------
+
+      async function getPasskeyOptions() {
+        const json = await postJSON(API.passkeyOptions);
+        return parseRequestOptions(json);
+      }
+
+      async function verifyPasskey(credential) {
+        const data = await postJSON(API.passkeyVerify, credentialToJSON(credential));
+        onSignedIn(data.user);
+      }
+
+      // Conditional UI: saved passkeys appear in the email field's autofill
+      // dropdown next to saved passwords. Must start before the field is focused.
+      async function startConditionalPasskey() {
+        if (!webAuthnSupported || typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+        try {
+          if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+          abortConditional();
+          const controller = new AbortController();
+          conditionalAbort = controller;
+          const publicKey = await getPasskeyOptions();
+          if (controller.signal.aborted) return;
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey,
+            signal: controller.signal,
+          });
+          if (!credential || controller.signal.aborted) return;
+          setBusy(true);
+          showError('');
+          try {
+            await verifyPasskey(credential);
+          } finally {
+            setBusy(false);
+          }
+        } catch (err) {
+          if (err && (err.name === 'AbortError' || err.name === 'NotAllowedError')) return; // cancelled/dismissed
+          if (err && err.status) showError(err.message);
+        }
+      }
+
+      // Explicit button: opens the browser/OS passkey picker (e.g. phone or security key).
+      async function signInWithPasskey() {
+        abortConditional();
+        showError('');
+        setBusy(true);
+        try {
+          const publicKey = await getPasskeyOptions();
+          const credential = await navigator.credentials.get({ publicKey, mediation: 'optional' });
+          if (credential) await verifyPasskey(credential);
+        } catch (err) {
+          if (err && err.name === 'NotAllowedError') {
+            showError('Passkey sign-in was cancelled.');
+          } else if (err && err.name !== 'AbortError') {
+            showError(err.message || 'Passkey sign-in failed. Please try again.');
+          }
+          // Re-arm autofill so the user can still pick a passkey from the field.
+          if (dialog.open) startConditionalPasskey();
+        } finally {
+          setBusy(false);
+        }
+      }
+
+      // ---------- Passwords ----------
+
+      async function signInWithPassword(event) {
+        event.preventDefault();
+        showError('');
+        const username = usernameInput.value.trim();
+        const password = passwordInput.value;
+        if (!username || !password) {
+          showError('Please enter your email and password.');
+          (username ? passwordInput : usernameInput).focus();
+          return;
+        }
+        setBusy(true);
+        try {
+          const data = await postJSON(API.passwordLogin, { username, password });
+          // Offer to save/update the password in the browser's password manager,
+          // since fetch-based logins don't always trigger the save prompt.
+          if (window.PasswordCredential && navigator.credentials && navigator.credentials.store) {
+            try {
+              await navigator.credentials.store(new PasswordCredential({
+                id: username,
+                password,
+                name: (data.user && data.user.name) || username,
+              }));
+            } catch { /* not fatal */ }
+          }
+          onSignedIn(data.user);
+        } catch (err) {
+          showError(err.status === 401
+            ? 'That email and password don’t match our records.'
+            : (err.message || 'Sign-in failed. Please try again.'));
+          passwordInput.select();
+        } finally {
+          setBusy(false);
+        }
+      }
+
+      // ---------- Dialog ----------
+
+      function openSignIn(destination) {
+        if (typeof dialog.showModal !== 'function') {
+          // Very old browsers: fall back to the full sign-in page.
+          const next = destination ? `?next=${encodeURIComponent(destination)}` : '';
+          window.location.assign(`/login${next}`);
+          return;
+        }
+        pendingDestination = destination || null;
+        nextInput.value = destination || window.location.pathname;
+        let path = '';
+        try { path = destination ? new URL(destination, window.location.href).pathname : ''; } catch { /* ignore */ }
+        subtitleEl.textContent = DESTINATION_LABELS[path] || 'Sign in to continue.';
+        showError('');
+        setBusy(false);
+
+        // Start passkey autofill before focusing the field.
+        startConditionalPasskey();
+        if (!dialog.open) dialog.showModal();
+        usernameInput.focus();
+      }
+
+      function closeSignIn() {
+        dialog.close();
+      }
+
+      dialog.addEventListener('close', () => {
+        abortConditional();
+        pendingDestination = null;
+        passwordInput.value = '';
+        showError('');
+      });
+
+      // Close when clicking the backdrop.
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) closeSignIn();
+      });
+
+      document.getElementById('signin-close').addEventListener('click', closeSignIn);
+      form.addEventListener('submit', signInWithPassword);
+      passkeyBtn.addEventListener('click', signInWithPasskey);
+
+      if (webAuthnSupported) passkeySection.hidden = false;
+
+      // ---------- Link interception ----------
+
+      function isPlainLeftClick(event) {
+        return event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
+      }
+
+      document.addEventListener('click', (event) => {
+        if (event.defaultPrevented || !isPlainLeftClick(event)) return;
+        const link = event.target.closest('a');
+        if (!link) return;
+
+        if (link.id === 'signin-link') {
+          event.preventDefault();
+          openSignIn(null);
+          return;
+        }
+
+        if (link.id === 'logout-link') {
+          // Stop the browser from silently re-signing the user in with a stored credential.
+          if (navigator.credentials && navigator.credentials.preventSilentAccess) {
+            navigator.credentials.preventSilentAccess().catch(() => {});
+          }
+          return;
+        }
+
+        if (link.hasAttribute('data-requires-auth') && !signedIn) {
+          event.preventDefault();
+          openSignIn(link.href);
+        }
+      });
+
+      refreshSession();
+    })();
+  </script>
+
 </body>
 
