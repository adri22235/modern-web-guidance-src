+  <!-- Inline sign-in, shown only when the browser has no saved credentials to offer instantly -->
+  <dialog id="signin-dialog" class="signin-dialog" aria-labelledby="signin-title" closedby="any">
+    <form method="dialog">
+      <button class="close" aria-label="Close sign-in" value="cancel">&times;</button>
+    </form>
+    <h2 id="signin-title">Welcome back</h2>
+    <p class="context" id="signin-context">Sign in to your Daily Grind account.</p>
+
+    <!-- Works without JavaScript as a regular POST; enhanced to sign in in place -->
+    <form id="signin-form" action="/signin" method="post">
+      <label for="email">Email
+        <input type="email" id="email" name="email" autocomplete="username webauthn" spellcheck="false"
+          enterkeyhint="next" required autofocus>
+      </label>
+      <label for="current-password">Password
+        <input type="password" id="current-password" name="password" autocomplete="current-password"
+          enterkeyhint="done" required>
+      </label>
+      <label class="show-password"><input type="checkbox" id="show-password"> Show password</label>
+      <p class="signin-error" id="signin-error" role="alert"></p>
+      <button type="submit" class="primary">Sign in</button>
+      <p class="divider">or</p>
+      <button type="button" class="secondary" id="passkey-button" hidden>Sign in with a passkey</button>
+      <div class="links">
+        <a href="/forgot-password">Forgot password?</a>
+        <a href="/register">Create account</a>
+      </div>
+    </form>
+  </dialog>
+
+  <script type="module">
+    // ---------------------------------------------------------------------
+    // In-place sign-in for returning customers.
+    //
+    // Assumed server endpoints:
+    //   GET  /api/session        -> 200 { name } when signed in, 401 otherwise
+    //   POST /api/login/options  -> WebAuthn request options JSON (challenge, rpId, userVerification)
+    //   POST /api/login/verify   -> verify passkey assertion (404 if credential unknown)
+    //   POST /api/login/password -> verify { username, password }
+    // ---------------------------------------------------------------------
+
+    // Polyfills parseRequestOptionsFromJSON / toJSON / getClientCapabilities where PublicKeyCredential exists.
+    try {
+      await import('https://esm.sh/webauthn-polyfills');
+    } catch (err) {
+      console.warn('WebAuthn polyfills failed to load', err);
+    }
+
+    const body = document.body;
+    const dialog = document.getElementById('signin-dialog');
+    const form = document.getElementById('signin-form');
+    const contextText = document.getElementById('signin-context');
+    const errorText = document.getElementById('signin-error');
+    const passkeyButton = document.getElementById('passkey-button');
+    const passwordInput = document.getElementById('current-password');
+    const greeting = document.getElementById('user-greeting');
+
+    const hasWebAuthn = 'PublicKeyCredential' in window;
+    let pendingDestination = null; // URL to continue to after sign-in (null = stay on page)
+    let conditionalController = null;
+    let isAuthenticating = false;
+
+    function setSignedIn(user) {
+      body.dataset.signedIn = 'true';
+      greeting.textContent = user?.name ? `Hi, ${user.name}` : 'Signed in';
+    }
+
+    function completeSignIn(user) {
+      setSignedIn(user);
+      if (dialog.open) dialog.close('signed-in');
+      if (pendingDestination) {
+        const destination = pendingDestination;
+        pendingDestination = null;
+        location.assign(destination);
+      }
+    }
+
+    // Restore the visible state for visitors who already have a session.
+    fetch('/api/session', { credentials: 'same-origin' })
+      .then((res) => (res.ok ? res.json() : null))
+      .then((user) => user && setSignedIn(user))
+      .catch(() => {});
+
+    // ---- WebAuthn helpers ----------------------------------------------
+    async function getRequestOptions() {
+      const res = await fetch('/api/login/options', { method: 'POST' });
+      if (!res.ok) throw new Error('Failed to fetch authentication options');
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    async function verifyCredential(cred, publicKey) {
+      if (!cred) throw new DOMException('No credential returned', 'NotAllowedError');
+
+      if (cred.type === 'public-key') {
+        const encoded = cred.toJSON();
+        const res = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+        if (res.status === 404) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId, // server-provided RP ID, never location.hostname
+              credentialId: encoded.id,
+            });
+          }
+          throw new Error('That passkey is no longer recognized. Please sign in with your email and password.');
+        }
+        if (!res.ok) throw new Error('Passkey sign-in failed. Please try again.');
+        return res.json();
+      }
+
+      if (cred.type === 'password') {
+        return passwordSignIn(cred.id, cred.password);
+      }
+
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    async function passwordSignIn(username, password) {
+      const res = await fetch('/api/login/password', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password }),
+      });
+      if (!res.ok) throw new Error('Incorrect email or password.');
+      return res.json();
+    }
+
+    async function isImmediateUiSupported() {
+      if (!hasWebAuthn || !PublicKeyCredential.getClientCapabilities) return false;
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities?.immediateGet);
+      } catch {
+        return false;
+      }
+    }
+
+    // Immediate UI: shows the browser's account chooser only if local passkeys
+    // or saved passwords exist; otherwise rejects fast with NotAllowedError.
+    async function authenticateWithImmediateUi() {
+      if (!(await isImmediateUiSupported())) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+      // A pending conditional request must be aborted before an immediate one.
+      conditionalController?.abort();
+      const publicKey = await getRequestOptions();
+      const cred = await navigator.credentials.get({
+        password: true,
+        publicKey,
+        uiMode: 'immediate', // no `signal` allowed here
+      });
+      return verifyCredential(cred, publicKey);
+    }
+
+    // Conditional UI: passkeys appear in the email field's autofill suggestions.
+    async function startConditionalUi() {
+      if (!hasWebAuthn || !PublicKeyCredential.isConditionalMediationAvailable) return;
+      if (!(await PublicKeyCredential.isConditionalMediationAvailable())) return;
+      conditionalController?.abort();
+      conditionalController = new AbortController();
+      try {
+        const publicKey = await getRequestOptions();
+        const cred = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: conditionalController.signal,
+        });
+        completeSignIn(await verifyCredential(cred, publicKey));
+      } catch (err) {
+        if (err.name !== 'AbortError' && err.name !== 'NotAllowedError') {
+          errorText.textContent = err.message;
+        }
+      }
+    }
+
+    // ---- Inline sign-in dialog (fallback) ------------------------------
+    function openSignInDialog(label) {
+      contextText.textContent = label
+        ? `Sign in to continue to ${label}.`
+        : 'Sign in to your Daily Grind account.';
+      errorText.textContent = '';
+      dialog.showModal();
+      startConditionalUi();
+    }
+
+    dialog.addEventListener('close', () => {
+      conditionalController?.abort();
+      if (dialog.returnValue !== 'signed-in') pendingDestination = null;
+      dialog.returnValue = '';
+      passwordInput.value = '';
+    });
+
+    // Light-dismiss fallback where `closedby` is unsupported.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+    }
+
+    document.getElementById('show-password').addEventListener('change', (e) => {
+      passwordInput.type = e.target.checked ? 'text' : 'password';
+    });
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      errorText.textContent = '';
+      const username = form.email.value.trim();
+      const password = passwordInput.value;
+      try {
+        const user = await passwordSignIn(username, password);
+        // Let supporting browsers offer to save the password for next time.
+        if ('PasswordCredential' in window) {
+          try {
+            await navigator.credentials.store(new PasswordCredential({ id: username, password, name: user?.name }));
+          } catch {}
+        }
+        completeSignIn(user);
+      } catch (err) {
+        errorText.textContent = err.message;
+      }
+    });
+
+    // Modal passkey prompt: allows cross-device (QR) and security keys.
+    if (hasWebAuthn) {
+      passkeyButton.hidden = false;
+      passkeyButton.addEventListener('click', async () => {
+        errorText.textContent = '';
+        conditionalController?.abort();
+        try {
+          const publicKey = await getRequestOptions();
+          const cred = await navigator.credentials.get({ publicKey });
+          completeSignIn(await verifyCredential(cred, publicKey));
+        } catch (err) {
+          if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
+            errorText.textContent = err.message;
+          }
+          startConditionalUi();
+        }
+      });
+    }
+
+    // ---- Intercept account-related links ---------------------------------
+    for (const link of document.querySelectorAll('a[data-requires-auth]')) {
+      link.addEventListener('click', async (event) => {
+        // Respect new-tab / modified clicks and already signed-in visitors.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        if (body.dataset.signedIn === 'true') return;
+
+        event.preventDefault();
+        if (isAuthenticating) return;
+        isAuthenticating = true;
+
+        // "Sign in" keeps the visitor on the current page; other links continue to their destination.
+        pendingDestination = link.hasAttribute('data-auth-inplace') ? null : link.href;
+        const label = link.dataset.authLabel;
+
+        try {
+          completeSignIn(await authenticateWithImmediateUi());
+        } catch (err) {
+          // No local credentials, dismissed chooser, or unsupported browser:
+          // fall back to the inline sign-in dialog without leaving the page.
+          openSignInDialog(label);
+          if (err.name !== 'NotAllowedError') {
+            errorText.textContent = err.message;
+            console.error('Authentication error:', err);
+          }
+        } finally {
+          isAuthenticating = false;
+        }
+      });
+    }
+  </script>
+
 </body>
 
