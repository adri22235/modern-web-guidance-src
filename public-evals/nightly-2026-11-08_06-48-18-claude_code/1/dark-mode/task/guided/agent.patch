+  <script>
+    // Theme picker: "light dark" = follow system, "light"/"dark" = forced.
+    // The choice is written to <meta name="color-scheme">, which CSS maps onto
+    // the root element's color-scheme so every token and native control follows.
+    (() => {
+      const STORAGE_KEY = "color-scheme";
+      const VALID = ["light dark", "light", "dark"];
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const select = document.getElementById("theme-select");
+      const systemOption = select.querySelector('option[value="light dark"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const readStored = () => {
+        try {
+          const value = localStorage.getItem(STORAGE_KEY);
+          return VALID.includes(value) ? value : "light dark";
+        } catch {
+          return "light dark";
+        }
+      };
+
+      const apply = (value) => {
+        meta.content = value;
+        select.value = value;
+      };
+
+      const updateSystemLabel = () => {
+        systemOption.textContent = `System default (currently ${systemDark.matches ? "dark" : "light"})`;
+      };
+
+      select.addEventListener("change", () => {
+        const value = VALID.includes(select.value) ? select.value : "light dark";
+        apply(value);
+        try {
+          if (value === "light dark") localStorage.removeItem(STORAGE_KEY);
+          else localStorage.setItem(STORAGE_KEY, value);
+        } catch { /* still applied for this page view */ }
+      });
+
+      // Keep in sync with changes made in other tabs
+      window.addEventListener("storage", (event) => {
+        if (event.key === STORAGE_KEY || event.key === null) apply(readStored());
+      });
+
+      // Keep the "System default" label accurate as the OS preference changes
+      systemDark.addEventListener("change", updateSystemLabel);
+
+      updateSystemLabel();
+      apply(readStored());
+    })();
+
+    // Late night specials filter
+    (() => {
+      const filter = document.getElementById("late-night-filter");
+      const specials = document.querySelectorAll(".late-night .special");
+      filter.addEventListener("change", () => {
+        for (const item of specials) {
+          item.hidden = filter.value !== "all" && item.dataset.category !== filter.value;
+        }
+      });
+    })();
+  </script>
+
