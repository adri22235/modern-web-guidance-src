+  <script>
+    (function () {
+      const trigger = document.getElementById('trigger-btn');
+      const panel = document.getElementById('action-panel');
+
+      // Action buttons: close the panel, return focus, then navigate.
+      panel.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-href]');
+        if (!btn) return;
+        panel.hidePopover();
+        trigger.focus();
+        window.location.href = btn.dataset.href;
+      });
+
+      // Keep aria-expanded in sync (popovertarget does this for AT, this also drives styling).
+      panel.addEventListener('toggle', (e) => {
+        trigger.setAttribute('aria-expanded', e.newState === 'open' ? 'true' : 'false');
+        if (e.newState === 'open') {
+          const first = panel.querySelector('button');
+          if (first) first.focus();
+        }
+      });
+      trigger.setAttribute('aria-expanded', 'false');
+
+      // JS fallback positioning for browsers without CSS anchor positioning.
+      if (window.CSS && CSS.supports('anchor-name: --a')) return;
+
+      const GAP = 6;
+      const MARGIN = 8;
+
+      function position() {
+        if (!panel.matches(':popover-open')) return;
+        const t = trigger.getBoundingClientRect();
+        const pw = panel.offsetWidth;
+        const ph = panel.offsetHeight;
+        const vw = document.documentElement.clientWidth;
+        const vh = document.documentElement.clientHeight;
+
+        // Default: below trigger, left-aligned.
+        let top = t.bottom + GAP;
+        let left = t.left;
+
+        // Flip vertically if it overflows the bottom and there's more room above.
+        if (top + ph > vh - MARGIN && t.top - GAP - ph >= MARGIN) {
+          top = t.top - GAP - ph;
+        }
+        // Flip horizontally (align right edges) if it overflows the right edge.
+        if (left + pw > vw - MARGIN && t.right - pw >= MARGIN) {
+          left = t.right - pw;
+        }
+        // Final clamp so it is never cut off.
+        top = Math.max(MARGIN, Math.min(top, vh - ph - MARGIN));
+        left = Math.max(MARGIN, Math.min(left, vw - pw - MARGIN));
+
+        panel.style.top = top + 'px';
+        panel.style.left = left + 'px';
+      }
+
+      panel.addEventListener('toggle', (e) => {
+        if (e.newState === 'open') position();
+      });
+      window.addEventListener('resize', position);
+      window.addEventListener('scroll', position, { passive: true, capture: true });
+    })();
+  </script>
