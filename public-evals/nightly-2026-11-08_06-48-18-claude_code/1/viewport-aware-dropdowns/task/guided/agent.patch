+    /* Options dropdown */
+    .options-trigger {
+      /* Explicit anchor name: required by the anchor-positioning polyfill,
+         which does not understand implicit popovertarget anchors. */
+      anchor-name: --options-trigger;
+      display: inline-flex;
+      align-items: center;
+      gap: 6px;
+      background: none;
+      border: 1px solid transparent;
+      border-radius: 4px;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      padding: 5px 10px;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .options-trigger:hover,
+    .options-trigger:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .options-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .options-trigger .chevron {
+      font-size: 0.7em;
+      transition: transform 0.2s;
+    }
+
+    .options-trigger[aria-expanded="true"] .chevron {
+      transform: rotate(180deg);
+    }
+
+    .action-panel {
+      /* Rendered in the top layer via popover; tethered to the trigger. */
+      position-anchor: --options-trigger;
+      inset: auto;
+      top: anchor(bottom);
+      left: anchor(left);
+      margin: 6px 0 0;
+      /* Flip vertically, horizontally, or both if the panel would overflow. */
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+
+      min-width: 200px;
+      padding: 6px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
+    }
+
+    .action-panel:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 2px;
+    }
+
+    .action-item {
+      display: block;
+      width: 100%;
+      background: none;
+      border: 0;
+      border-radius: 5px;
+      color: inherit;
+      font: inherit;
+      font-size: 0.9rem;
+      text-align: start;
+      padding: 8px 12px;
+      cursor: pointer;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background: var(--secondary);
+      color: var(--primary);
+    }
+
+    .action-item:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: -2px;
+    }
+
