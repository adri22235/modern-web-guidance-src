+    /* Loyalty Rewards */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .rewards {
+      margin-top: 60px;
+    }
+
+    .rewards h2 {
+      text-align: center;
+    }
+
+    .rewards-card {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      margin-top: 20px;
+      padding: 40px 30px;
+      background: var(--primary);
+      color: var(--light);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex-shrink: 0;
+    }
+
+    progress.progress-ring {
+      --size: 200px;
+      --thickness: 18px;
+      --track-color: rgba(215, 204, 200, 0.25);
+      --fill-color: var(--accent);
+      --value: calc(attr(value type(<number>)) / attr(max type(<number>)) * 100);
+
+      appearance: none;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      border: var(--thickness) solid transparent;
+      background: conic-gradient(var(--fill-color) calc(var(--value) * 1%), var(--track-color) 0) border-box;
+      background-clip: border-area;
+      color: var(--fill-color);
+      transition: --value 0s ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.6s;
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(transparent calc(50% - var(--thickness)),
+            black calc(50% - var(--thickness) + 0.5px));
+      }
+    }
+
+    /* Hide native progress bar UI */
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      background: none;
+    }
+
+    .ring-content {
+      position: absolute;
+      display: flex;
