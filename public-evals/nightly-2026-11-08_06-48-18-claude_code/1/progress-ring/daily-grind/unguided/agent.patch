+  <script>
+    (function () {
+      var card = document.querySelector('.rewards-card');
+      if (!card) return;
+      var goal = Math.max(1, parseInt(card.dataset.goal, 10) || 10);
+      var stamps = Math.min(goal, Math.max(0, parseInt(card.dataset.stamps, 10) || 0));
+      var remaining = goal - stamps;
+
+      var ring = card.querySelector('.progress-ring');
+      var fill = card.querySelector('.progress-ring-fill');
+      var circumference = 2 * Math.PI * fill.r.baseVal.value;
+      fill.style.strokeDasharray = circumference;
+      fill.style.strokeDashoffset = circumference;
+      requestAnimationFrame(function () {
+        requestAnimationFrame(function () {
+          fill.style.strokeDashoffset = circumference * (1 - stamps / goal);
+        });
+      });
+
+      ring.setAttribute('aria-valuemax', goal);
+      ring.setAttribute('aria-valuenow', stamps);
+      ring.setAttribute('aria-valuetext', stamps + ' of ' + goal + ' drinks earned');
+      document.getElementById('stamp-count').textContent = stamps;
+      document.getElementById('stamp-goal').textContent = goal;
+      document.getElementById('stamp-remaining').textContent = remaining === 0
+        ? 'Free drink ready!'
+        : remaining + ' more to a free drink';
+      if (remaining === 0) card.querySelector('.rewards-details h3').textContent = 'Your free drink is ready!';
+
+      var row = document.getElementById('stamp-row');
+      for (var i = 1; i <= goal; i++) {
+        var li = document.createElement('li');
+        li.className = 'stamp' + (i <= stamps ? ' earned' : '') + (i === goal && i > stamps ? ' reward' : '');
+        li.textContent = i <= stamps ? '\u2615' : (i === goal ? '\u2605' : '');
+        row.appendChild(li);
+      }
+    })();
+  </script>
