+    .feedback-log {
+      max-height: 320px;
+      overflow-y: auto;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 10px 20px;
+      /* Firefox + modern Chromium */
+      scrollbar-width: thin;
+      scrollbar-color: #ffab40 #4e342e;
+    }
+
+    /* WebKit / older Chromium */
+    .feedback-log::-webkit-scrollbar {
+      width: 8px;
+    }
+
+    .feedback-log::-webkit-scrollbar-track {
+      background: #4e342e;
+      border-radius: 0 8px 8px 0;
+    }
+
+    .feedback-log::-webkit-scrollbar-thumb {
+      background-color: #ffab40;
+      border-radius: 4px;
+    }
+
+    .feedback-log::-webkit-scrollbar-thumb:hover {
+      background-color: #ff9100;
+    }
+
+    .feedback-entry {
+      padding: 15px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .feedback-entry:last-child {
+      border-bottom: none;
+    }
+
+    .feedback-entry blockquote {
+      font-style: italic;
+      margin-bottom: 6px;
+    }
+
+    .feedback-meta {
+      display: flex;
+      justify-content: space-between;
+      font-size: 0.85rem;
+      color: var(--primary);
+    }
+
+    .feedback-rating {
+      color: var(--accent);
+      letter-spacing: 2px;
+    }
+
