+  <script>
+    // The "View Details" links declare their preview target with the
+    // `interestfor` attribute (Interest Invokers). The browser handles hover,
+    // keyboard focus and touch long-press, then fires `interest` /
+    // `loseinterest` on the target; we only listen on the preview box itself.
+    (() => {
+      const preview = document.getElementById('seasonal-preview');
+      const text = preview.querySelector('.seasonal-preview-text');
+      const DEFAULT_TEXT = 'Select a drink to preview';
+
+      const show = (source) => {
+        if (!source || !source.dataset.drink) return;
+        text.textContent = `Preview: ${source.dataset.drink}`;
+        preview.style.setProperty('--preview-accent', source.dataset.accent || 'var(--accent)');
+        preview.classList.add('is-active');
+      };
+      const reset = () => {
+        text.textContent = DEFAULT_TEXT;
+        preview.style.removeProperty('--preview-accent');
+        preview.classList.remove('is-active');
+      };
+
+      preview.addEventListener('interest', (e) => show(e.source));
+      preview.addEventListener('loseinterest', reset);
+
+      // Fallback for browsers without Interest Invokers: one delegated
+      // listener set on the grid, still keyed off the declarative attribute.
+      if (!('interestForElement' in HTMLAnchorElement.prototype)) {
+        const grid = preview.closest('section').querySelector('.grid');
+        const invoker = (el) => el.closest && el.closest('[interestfor="seasonal-preview"]');
+        let pressTimer;
+        grid.addEventListener('pointerover', (e) => { const b = invoker(e.target); if (b) show(b); });
+        grid.addEventListener('pointerout', (e) => {
+          const b = invoker(e.target);
+          if (b && !b.contains(e.relatedTarget) && document.activeElement !== b) reset();
+        });
+        grid.addEventListener('focusin', (e) => { const b = invoker(e.target); if (b) show(b); });
+        grid.addEventListener('focusout', (e) => { if (invoker(e.target)) reset(); });
+        grid.addEventListener('touchstart', (e) => {
+          const b = invoker(e.target);
+          if (b) pressTimer = setTimeout(() => show(b), 500);
+        }, { passive: true });
+        ['touchend', 'touchcancel', 'touchmove'].forEach((t) =>
+          grid.addEventListener(t, () => clearTimeout(pressTimer), { passive: true }));
+      }
+    })();
+  </script>
