+    /* Seasonal Favorites: container-query driven drink cards.
+       Each grid item is a size container, so the card inside adapts to
+       the width it is actually given, not to the viewport. */
+    .drink-grid {
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
+    }
+
+    .drink-grid .drink--featured {
+      grid-column: 1 / -1;
+    }
+
+    .drink {
+      container: drink-card / inline-size;
+      display: flex;
+    }
+
+    .drink-card {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      padding: 0;
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .drink-card__media {
+      aspect-ratio: 4 / 3;
+      background: var(--secondary);
+    }
+
+    .drink-card__media img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    .drink-card__body {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 20px;
+    }
+
+    .drink-card__body p {
+      flex: 1;
+    }
+
+    .drink-card__tag {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.7rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+      text-transform: uppercase;
+      padding: 2px 10px;
+      border-radius: 999px;
+      margin-bottom: 8px;
+    }
+
+    /* Wide container: image and text side by side */
+    @container drink-card (min-width: 34rem) {
+      .drink-card {
+        flex-direction: row;
+        text-align: left;
+      }
+
+      .drink-card__media {
+        flex: 0 0 42%;
+        aspect-ratio: auto;
+        min-height: 220px;
+      }
+
+      .drink-card__body {
+        align-items: flex-start;
+        justify-content: center;
+        padding: 28px 32px;
+      }
+
+      .drink-card__body p {
+        flex: 0 0 auto;
+      }
+
+      .drink-card h3 {
+        font-size: 1.5rem;
+      }
+    }
+
+    /* Very wide container (e.g. featured card on desktop) */
+    @container drink-card (min-width: 52rem) {
+      .drink-card__media {
+        flex-basis: 50%;
+        min-height: 300px;
+      }
+
+      .drink-card__body {
+        padding: 40px 48px;
+      }
+
+      .drink-card h3 {
+        font-size: 2rem;
+      }
+
+      .drink-card__body p {
+        font-size: 1.1rem;
+      }
+    }
+
