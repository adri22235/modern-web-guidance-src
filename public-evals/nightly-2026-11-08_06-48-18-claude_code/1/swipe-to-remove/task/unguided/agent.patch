+  <script>
+    (function () {
+      var THRESHOLD_RATIO = 0.4; // fraction of item width needed to trigger removal
+      var DRAG_START = 8;        // px before we decide horizontal vs vertical intent
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      var list = document.querySelector('.SwipeableList');
+      if (!list) return;
+      var totalEl = document.querySelector('.cart-total');
+      var emptyEl = document.querySelector('.cart-empty');
+      var summaryEl = document.querySelector('.cart-summary');
+
+      function updateTotal() {
+        var items = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        var total = 0;
+        items.forEach(function (li) { total += parseFloat(li.dataset.price) || 0; });
+        totalEl.textContent = '$' + total.toFixed(2);
+        var empty = items.length === 0;
+        emptyEl.hidden = !empty;
+        summaryEl.hidden = empty;
+      }
+
+      function removeItem(item, direction) {
+        if (item.classList.contains('is-removing')) return;
+        var content = item.querySelector('.SwipeableList-content');
+        item.classList.add('is-past-threshold');
+        content.style.transform = 'translateX(' + (direction * 100) + '%)';
+
+        // Lock current height, then animate it to zero.
+        item.style.height = item.offsetHeight + 'px';
+        void item.offsetHeight; // force reflow
+        item.classList.add('is-removing');
+        item.style.height = '0px';
+        updateTotal();
+
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          item.remove();
+        }
+        if (reduceMotion) { finish(); return; }
+        item.addEventListener('transitionend', function (e) {
+          if (e.target === item && e.propertyName === 'height') finish();
+        });
+        setTimeout(finish, 500); // fallback if transitionend doesn't fire
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(function (item) {
+        var track = item.querySelector('.SwipeableList-track');
+        var content = item.querySelector('.SwipeableList-content');
+        var removeBtn = item.querySelector('.SwipeableList-remove');
+        var startX = 0, startY = 0, dx = 0;
+        var pointerId = null;
+        var dragging = false;
+
+        removeBtn.addEventListener('click', function () { removeItem(item, -1); });
+
+        track.addEventListener('pointerdown', function (e) {
+          if (e.button !== 0 || e.target.closest('button')) return;
+          if (item.classList.contains('is-removing')) return;
+          pointerId = e.pointerId;
+          startX = e.clientX;
+          startY = e.clientY;
+          dx = 0;
+          dragging = false;
+        });
+
+        track.addEventListener('pointermove', function (e) {
+          if (e.pointerId !== pointerId) return;
+          var moveX = e.clientX - startX;
+          var moveY = e.clientY - startY;
+
+          if (!dragging) {
+            if (Math.abs(moveX) < DRAG_START && Math.abs(moveY) < DRAG_START) return;
+            if (Math.abs(moveY) > Math.abs(moveX)) { pointerId = null; return; } // vertical scroll
+            dragging = true;
+            item.classList.add('is-dragging');
+            track.setPointerCapture(e.pointerId);
+          }
+
+          dx = moveX;
+          content.style.transform = 'translateX(' + dx + 'px)';
+          var past = Math.abs(dx) > track.offsetWidth * THRESHOLD_RATIO;
+          item.classList.toggle('is-past-threshold', past);
+        });
+
+        function endDrag(e) {
+          if (e.pointerId !== pointerId) return;
+          pointerId = null;
+          if (!dragging) return;
+          dragging = false;
+          item.classList.remove('is-dragging');
+
+          if (e.type !== 'pointercancel' && Math.abs(dx) > track.offsetWidth * THRESHOLD_RATIO) {
+            removeItem(item, dx > 0 ? 1 : -1);
+          } else {
+            item.classList.remove('is-past-threshold');
+            content.style.transform = '';
+          }
+        }
+
+        track.addEventListener('pointerup', endDrag);
+        track.addEventListener('pointercancel', endDrag);
+      });
+
+      updateTotal();
+    })();
+  </script>
+
