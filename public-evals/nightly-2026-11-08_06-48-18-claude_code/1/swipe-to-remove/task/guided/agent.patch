+  <script>
+    (() => {
+      const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const status = document.getElementById('cart-status');
+      const swipeObservers = new WeakMap();
+
+      const trackResizeObserver = needsScrollWorkaround
+        ? new ResizeObserver((entries) => {
+            for (const entry of entries) entry.target.scrollLeft = entry.target.clientWidth;
+          })
+        : null;
+
+      // Lazily wires items up as they enter the viewport; pauses offscreen ones.
+      const viewportObserver = new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          const item = entry.target;
+          if (entry.isIntersecting) {
+            const handle = swipeObservers.get(item) ?? setupItem(item);
+            handle.observer.observe(handle.content);
+          } else {
+            swipeObservers.get(item)?.observer.unobserve(swipeObservers.get(item).content);
+          }
+        }
+      });
+
+      function setupItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = track.querySelector('.SwipeableList-content');
+        item.classList.add('is-initialized');
+
+        // Must run after .is-initialized and before the inner observer attaches.
+        if (needsScrollWorkaround) {
+          track.scrollLeft = track.clientWidth;
+          trackResizeObserver.observe(track);
+        }
+
+        const activateThreshold = 0.8;
+        const commitThreshold = 0.2;
+
+        const observer = new IntersectionObserver((entries) => {
+          const entry = entries.at(-1);
+          const ratio = entry.intersectionRatio;
+          const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+          const direction = offset > 0 ? 'left' : 'right';
+
+          if (ratio < commitThreshold) {
+            // Slide the rest of the way off-screen in the swipe direction.
+            const width = entry.boundingClientRect.width;
+            const translate = direction === 'left' ? width - offset : -(offset + width);
+            removeItem(item, translate);
+            return;
+          }
+
+          item.classList.toggle('is-activating', ratio < activateThreshold);
+          if (offset !== 0) item.dataset.swipeDirection = direction;
+        }, { root: track, threshold: [commitThreshold, activateThreshold] });
+
+        const handle = { observer, content, track };
+        swipeObservers.set(item, handle);
+        return handle;
+      }
+
+      async function removeItem(item, translate) {
+        if (item.classList.contains('is-removing')) return;
+        const handle = swipeObservers.get(item);
+        const content = item.querySelector('.SwipeableList-content');
+        const name = item.querySelector('h3').textContent;
+
+        viewportObserver.unobserve(item);
+        if (handle) {
+          handle.observer.disconnect();
+          if (needsScrollWorkaround) trackResizeObserver.unobserve(handle.track);
+        }
+
+        // Move focus somewhere sensible before the row disappears.
+        if (item.contains(document.activeElement)) {
+          const next = item.nextElementSibling ?? item.previousElementSibling;
+          (next?.querySelector('.SwipeableList-track') ?? document.getElementById('cart-heading')).focus?.();
+        }
+
+        const height = item.getBoundingClientRect().height;
+        const opts = { duration: reduceMotion.matches ? 0 : 300, easing: 'ease', fill: 'forwards' };
+
+        item.classList.add('is-removing');
+        item.animate([{ height: `${height}px` }, { height: '0px' }], opts);
+        content.animate([{ translate: `${translate}px` }], opts);
+        await Promise.allSettled(item.getAnimations({ subtree: true }).map((a) => a.finished));
+
+        status.textContent = `${name} removed from cart.`;
+
+        const finish = () => {
+          const list = item.parentElement;
+          item.remove();
+          if (list && !list.querySelector('.SwipeableList-item')) {
+            list.hidden = true;
+            list.nextElementSibling.hidden = false;
+            document.querySelector('.cart-hint').hidden = true;
+          }
+        };
+
+        // Safari scroll-latching bug: defer DOM removal until gesture momentum settles.
+        if (globalThis.GestureEvent) {
+          item.inert = true;
+          setTimeout(finish, 5000);
+        } else {
+          finish();
+        }
+      }
+
+      function setupList(list) {
+        for (const item of list.children) {
+          if (item.matches('.SwipeableList-item')) viewportObserver.observe(item);
+        }
+
+        new MutationObserver((mutations) => {
+          for (const m of mutations) {
+            for (const node of m.addedNodes) {
+              if (node.nodeType === Node.ELEMENT_NODE && node.matches('.SwipeableList-item')) {
+                viewportObserver.observe(node);
+              }
+            }
+          }
+        }).observe(list, { childList: true });
+
+        // Accessible, non-gesture alternative.
+        list.addEventListener('click', (e) => {
+          const btn = e.target.closest('.cart-item-remove');
+          if (!btn) return;
+          const item = btn.closest('.SwipeableList-item');
+          removeItem(item, -item.getBoundingClientRect().width);
+        });
+      }
+
+      // Heading must be focusable as a fallback focus target.
+      document.getElementById('cart-heading').tabIndex = -1;
+      document.querySelectorAll('.SwipeableList').forEach(setupList);
+    })();
+  </script>
