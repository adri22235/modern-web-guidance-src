diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..ba88bc6
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,359 @@
+/**
+ * <star-rating> — a form-associated custom element.
+ *
+ * Behaves like a native form control:
+ *  - submits its value under its `name` attribute (no hidden <input>)
+ *  - supports `required` via native constraint validation
+ *  - resets to its `value` attribute on form reset
+ *  - is disabled by its own `disabled` attribute or a `<fieldset disabled>`
+ *  - restores its value on back/forward navigation and reload
+ *
+ * Attributes: name, value (default value), max (default 5), required, disabled
+ * Events: `input` and `change` fire when the user picks a rating.
+ * Custom state: `:state(user-invalid)` once the user has interacted
+ * (or tried to submit) and the control is still invalid.
+ */
+
+const LABELS_5 = ['Poor', 'Fair', 'Good', 'Great', 'Excellent'];
+
+const STAR_SVG = `
+  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+    <path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09
+             1.12-6.55L2.48 9.42l6.58-.96L12 2.5z"/>
+  </svg>`;
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      --star-size: 2rem;
+      --star-empty: #d7ccc8;
+      --star-filled: #ffab40;
+      --star-hover: #ffcc80;
+      --star-outline: #4e342e;
+      display: inline-flex;
+      align-items: center;
+      gap: 0.75rem;
+      flex-wrap: wrap;
+    }
+    :host([hidden]) { display: none; }
+
+    .stars {
+      display: inline-flex;
+      gap: 0.125rem;
+      border-radius: 6px;
+      outline: 2px solid transparent;
+      outline-offset: 2px;
+    }
+    .stars.user-invalid { outline-color: #c62828; }
+
+    button {
+      all: unset;
+      box-sizing: border-box;
+      inline-size: calc(var(--star-size) + 0.5rem);
+      block-size: calc(var(--star-size) + 0.5rem);
+      display: grid;
+      place-items: center;
+      cursor: pointer;
+      border-radius: 4px;
+      color: var(--star-empty);
+      transition: color 0.15s, transform 0.15s;
+    }
+    button:focus-visible {
+      outline: 2px solid var(--star-outline);
+      outline-offset: 1px;
+    }
+    svg {
+      inline-size: var(--star-size);
+      block-size: var(--star-size);
+      fill: currentColor;
+      stroke: var(--star-outline);
+      stroke-width: 0.75;
+      stroke-linejoin: round;
+    }
+    button.on { color: var(--star-filled); }
+
+    /* Hover preview: fill up to the hovered star, empty the rest. */
+    @media (hover: hover) {
+      .stars:hover button:not(:disabled) { color: var(--star-hover); }
+      .stars:hover button:hover ~ button:not(:disabled) { color: var(--star-empty); }
+      button:not(:disabled):hover { transform: scale(1.1); }
+    }
+
+    button:disabled { cursor: not-allowed; }
+    :host(:disabled) .stars,
+    :host(:disabled) .label { opacity: 0.45; }
+
+    .label {
+      font-size: 0.9rem;
+      color: #6d4c41;
+      min-inline-size: 6.5em;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      button { transition: none; }
+    }
+    @media (forced-colors: active) {
+      button.on svg { fill: Highlight; }
+      .stars.user-invalid { outline-color: Mark; }
+    }
+  </style>
+  <div class="stars" part="stars"></div>
+  <span class="label" part="label" aria-hidden="true"></span>
+`;
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'max', 'required'];
+
+  #internals;
+  #group;
+  #labelEl;
+  #stars = [];
+  #value = '';
+  #dirty = false; // like <input>'s dirty value flag: user/script set the value
+  #interacted = false; // user changed it or a submission attempt flagged it
+  #pointerActive = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'radiogroup';
+
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+    this.#group = root.querySelector('.stars');
+    this.#labelEl = root.querySelector('.label');
+
+    this.#group.addEventListener('click', (e) => this.#onClick(e));
+    this.#group.addEventListener('keydown', (e) => this.#onKeydown(e));
+    this.#group.addEventListener('pointerdown', () => {
+      this.#pointerActive = true;
+    });
+    this.#group.addEventListener('focusin', (e) => this.#onFocusIn(e));
+    document.addEventListener('pointerup', () => {
+      this.#pointerActive = false;
+    });
+
+    // Fired by the browser when a submit/checkValidity() finds us invalid.
+    this.addEventListener('invalid', () => {
+      this.#interacted = true;
+      this.#updateUserInvalid();
+    });
+
+    this.#renderStars();
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#setValue(this.getAttribute('value') ?? '');
+    this.#validate();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'max') {
+      this.#renderStars();
+      this.#setValue(this.#value); // re-clamp
+    } else if (name === 'value') {
+      if (!this.#dirty) this.#setValue(newValue ?? '');
+    } else if (name === 'required') {
+      this.#internals.ariaRequired = newValue !== null ? 'true' : null;
+      this.#validate();
+    }
+  }
+
+  /* ---------- Form-associated lifecycle ---------- */
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#interacted = false;
+    this.#setValue(this.getAttribute('value') ?? '');
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable internal controls only; never toggle `disabled` on the host,
+    // or re-enabling an ancestor <fieldset> would leave the host stuck.
+    for (const star of this.#stars) star.disabled = disabled;
+    // willValidate changes with disabled state, so refresh the error UI.
+    this.#updateUserInvalid();
+  }
+
+  formStateRestoreCallback(state) {
+    this.#dirty = true;
+    this.#setValue(typeof state === 'string' ? state : '');
+  }
+
+  /* ---------- Public API (mirrors native controls) ---------- */
+
+  get value() { return this.#value; }
+  set value(v) {
+    this.#dirty = true;
+    this.#setValue(v);
+  }
+
+  get valueAsNumber() { return this.#value ? Number(this.#value) : NaN; }
+
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(v) { this.setAttribute('value', v); }
+
+  get max() {
+    const n = parseInt(this.getAttribute('max'), 10);
+    return Number.isInteger(n) && n > 0 && n <= 10 ? n : 5;
+  }
+  set max(v) { this.setAttribute('max', v); }
+
+  get name() { return this.getAttribute('name'); }
+  set name(v) { this.setAttribute('name', v); }
+
+  get required() { return this.hasAttribute('required'); }
+  set required(v) { this.toggleAttribute('required', Boolean(v)); }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(v) { this.toggleAttribute('disabled', Boolean(v)); }
+
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get type() { return this.localName; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+
+  /* ---------- Internals ---------- */
+
+  #labelFor(n) {
+    const max = this.max;
+    if (max === 5) return LABELS_5[n - 1];
+    return `${n} of ${max}`;
+  }
+
+  #renderStars() {
+    const max = this.max;
+    const disabled = this.matches(':disabled');
+    this.#group.replaceChildren();
+    this.#stars = [];
+    for (let i = 1; i <= max; i++) {
+      const star = document.createElement('button');
+      star.type = 'button';
+      star.setAttribute('role', 'radio');
+      star.dataset.value = String(i);
+      star.setAttribute(
+        'aria-label',
+        `${i} ${i === 1 ? 'star' : 'stars'}${max === 5 ? `, ${LABELS_5[i - 1]}` : ''}`,
+      );
+      star.disabled = disabled;
+      star.innerHTML = STAR_SVG;
+      this.#stars.push(star);
+    }
+    this.#group.append(...this.#stars);
+  }
+
+  #setValue(raw) {
+    const n = parseInt(raw, 10);
+    const v = Number.isInteger(n) && n >= 1 ? String(Math.min(n, this.max)) : '';
+    this.#value = v;
+    // `null` submits nothing when empty; the second arg is the restore state.
+    this.#internals.setFormValue(v || null, v);
+    this.#syncStars();
+    this.#validate();
+  }
+
+  #syncStars() {
+    const current = Number(this.#value) || 0;
+    const tabbableIndex = current ? current - 1 : 0;
+    this.#stars.forEach((star, i) => {
+      star.classList.toggle('on', i < current);
+      star.setAttribute('aria-checked', String(i + 1 === current));
+      star.tabIndex = i === tabbableIndex ? 0 : -1; // roving tabindex
+    });
+    this.#labelEl.textContent = current ? this.#labelFor(current) : 'Not rated';
+  }
+
+  #validate() {
+    if (this.required && !this.#value) {
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please choose a star rating.',
+        this.#tabbableStar(),
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+    this.#updateUserInvalid();
+  }
+
+  #updateUserInvalid() {
+    const show =
+      this.#interacted &&
+      this.#internals.willValidate &&
+      !this.#internals.validity.valid;
+    this.#group.classList.toggle('user-invalid', show);
+    this.#internals.ariaInvalid = show ? 'true' : null;
+    try {
+      if (show) this.#internals.states.add('user-invalid');
+      else this.#internals.states.delete('user-invalid');
+    } catch {
+      // CustomStateSet unsupported: expose an attribute hook instead.
+      this.toggleAttribute('data-user-invalid', show);
+    }
+  }
+
+  #tabbableStar() {
+    return this.#stars.find((s) => s.tabIndex === 0) ?? this.#stars[0];
+  }
+
+  #commit(n) {
+    if (this.matches(':disabled')) return;
+    const before = this.#value;
+    this.#dirty = true;
+    this.#interacted = true;
+    this.#setValue(n);
+    this.#tabbableStar()?.focus();
+    if (this.#value !== before) {
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    }
+  }
+
+  #onClick(e) {
+    const star = e.target.closest('button');
+    if (!star || star.disabled) return;
+    this.#commit(Number(star.dataset.value));
+  }
+
+  #onKeydown(e) {
+    const current = Number(this.#value) || 0;
+    const max = this.max;
+    let next;
+    switch (e.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = Math.min(max, current + 1);
+        break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = Math.max(1, current - 1);
+        break;
+      case 'Home':
+        next = 1;
+        break;
+      case 'End':
+        next = max;
+        break;
+      default:
+        return;
+    }
+    e.preventDefault();
+    this.#commit(next);
+  }
+
