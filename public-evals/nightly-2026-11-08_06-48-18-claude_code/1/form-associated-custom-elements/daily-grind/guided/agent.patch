+        if (!(key in LABELS) || value === '') continue;
+        const dt = document.createElement('dt');
+        dt.textContent = LABELS[key];
+        const dd = document.createElement('dd');
+        dd.textContent = ['overall', 'flavor', 'aroma'].includes(key)
+          ? `${'★'.repeat(Number(value))} (${value}/5)`
+          : drink.name === key ? drink.selectedOptions[0].textContent : value;
+        list.append(dt, dd);
+      }
+      if (data.get('skip-ratings')) {
+        const dt = document.createElement('dt');
+        dt.textContent = 'Ratings';
+        const dd = document.createElement('dd');
+        dd.textContent = 'Skipped';
+        list.append(dt, dd);
+      }
+      box.append(heading, list);
+
+      form.reset();
+      // Show the summary after reset (the reset handler clears the output).
+      setTimeout(() => result.replaceChildren(box));
