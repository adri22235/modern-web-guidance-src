+    /* ==========================================================
+       Progressive enhancements
+       Every block below only activates in browsers that support
+       the newer CSS @-rule it relies on. Older browsers keep the
+       baseline styles above unchanged.
+       ========================================================== */
+
+    /* --- Navigation: transform when actually stuck ---
+       Requires @container scroll-state() queries. */
+    @supports (container-type: scroll-state) {
+      nav {
+        container-type: scroll-state;
+        container-name: site-nav;
+      }
+
+      .nav-inner {
+        transition: background-color 0.3s, box-shadow 0.3s;
+      }
+
+      @container site-nav scroll-state(stuck: top) {
+        .nav-inner {
+          /* Paint-only changes (no box-model shifts) to avoid scroll-anchoring flicker */
+          background-color: rgb(62 39 35 / 0.97);
+          box-shadow: 0 4px 12px rgb(0 0 0 / 0.3), inset 0 -2px 0 var(--accent);
+        }
+      }
+    }
+
+    /* --- Hero: animated warm glow ---
+       Requires @property (to interpolate a typed custom property).
+       The animation name is exposed through a registered property, so
+       browsers without @property never see it and fall back to "none". */
+    @property --hero-glow-angle {
+      syntax: "<angle>";
+      inherits: false;
+      initial-value: 0deg;
+    }
+
+    @property --hero-glow-animation {
+      syntax: "*";
+      inherits: false;
+      initial-value: hero-glow-spin;
+    }
+
+    @keyframes hero-glow-spin {
+      to {
+        --hero-glow-angle: 360deg;
+      }
+    }
+
+    .hero {
+      position: relative;
+      isolation: isolate;
+    }
+
+    .hero::before {
+      content: "";
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      pointer-events: none;
+      background: conic-gradient(from var(--hero-glow-angle) at 50% 120%,
+          rgb(255 171 64 / 0.35), transparent 25%, rgb(255 171 64 / 0.2) 50%, transparent 75%, rgb(255 171 64 / 0.35));
+      mix-blend-mode: soft-light;
+      /* Without @property, --hero-glow-angle has no value, so the gradient is
+         invalid at computed-value time (background: none) and the animation
+         name falls back to "none": the layer stays inert. */
+      animation: var(--hero-glow-animation, none) 18s linear infinite;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .hero::before {
+        animation-play-state: paused;
+      }
+    }
+
+    /* --- Seasonal favorite cards: size-aware layout ---
+       Requires @container size queries. */
+    @supports (container-type: inline-size) {
+      .grid > .card {
+        container-type: inline-size;
+        container-name: card;
+      }
+
+      .card h3 {
+        font-size: clamp(1.15rem, 1rem + 2.5cqi, 1.5rem);
+      }
+
+      @container card (min-width: 320px) {
+        .card h3,
+        .card p {
+          text-align: start;
+        }
+
+        .card h3 {
+          padding-bottom: 0.4rem;
+          border-bottom: 2px solid var(--accent);
+        }
+
+        .card .btn {
+          display: block;
+          text-align: center;
+        }
+      }
+    }
