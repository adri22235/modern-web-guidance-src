+  <script type="module">
+    // Seasonal Favorites arrive as HTML strings (e.g. from a CMS/API), so they are
+    // treated as untrusted and sanitized before touching the DOM.
+    const seasonalFavorites = [
+      `<div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <a href="/menu/espresso" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </div>`,
+    ];
+
+    // Strict allowlist: only the markup a card needs. Anything else (script,
+    // img, iframe, on* handlers, style, javascript: URLs) is stripped.
+    const ALLOWED_ELEMENTS = ['div', 'h3', 'p', 'a', 'strong', 'em', 'br'];
+    const ALLOWED_ATTRIBUTES = ['class', 'href'];
+
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      // Only downloaded in browsers without the native Sanitizer API.
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        // Native Sanitizer API: parses, sanitizes and inserts in one step and
+        // needs no Trusted Types policy.
+        el.setHTML(html, {
+          sanitizer: { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES },
+        });
+        return;
+      }
+      const DOMPurify = await loadDOMPurify();
+      // RETURN_TRUSTED_TYPE yields TrustedHTML (via the CSP-allowed "dompurify"
+      // policy) so the innerHTML sink accepts it under enforcement.
+      el.innerHTML = DOMPurify.sanitize(html, {
+        ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+        ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+        ALLOW_ARIA_ATTR: false,
+        ALLOW_DATA_ATTR: false,
+        KEEP_CONTENT: false,
+        RETURN_TRUSTED_TYPE: true,
+      });
+    }
+
+    const grid = document.getElementById('seasonal-favorites');
+    try {
+      await safeSetHTML(grid, seasonalFavorites.join(''));
+    } catch (err) {
+      console.error('Unable to render Seasonal Favorites safely:', err);
+      const fallback = document.createElement('p');
+      fallback.textContent = 'Seasonal favorites are unavailable right now. ';
+      const link = document.createElement('a');
+      link.href = '/menu';
+      link.textContent = 'Browse the full menu.';
+      fallback.append(link);
+      grid.replaceChildren(fallback);
+    }
+  </script>
+
