+  <script>
+    // Layout switching
+    const favorites = document.querySelector('.favorites');
+    document.querySelector('.layout-switch').addEventListener('change', (e) => {
+      if (e.target.name === 'layout') favorites.dataset.layout = e.target.value;
+    });
+
+    // Spatial (arrow-key) navigation with a roving tabindex.
+    // Candidates are chosen from live geometry, so it works in any layout mode.
+    function initSpatialNav(container, itemSelector) {
+      const TOLERANCE = 1;
+      const WEIGHT = 2;
+      const DIRS = {
+        ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
+      };
+      const items = () => [...container.querySelectorAll(itemSelector)];
+      const candidates = () => items().filter((el) => el.checkVisibility());
+
+      function setActive(el) {
+        for (const item of items()) item.tabIndex = item === el ? 0 : -1;
+      }
+
+      function findNext(current, dir) {
+        const c = current.getBoundingClientRect();
+        const horizontal = dir === 'left' || dir === 'right';
+        let bestAligned = null, bestAlignedGap = Infinity, bestAlignedOff = Infinity;
+        let bestFallback = null, bestScore = Infinity;
+
+        for (const el of candidates()) {
+          if (el === current) continue;
+          const r = el.getBoundingClientRect();
+          let gap;
+          switch (dir) {
+            case 'right': if (r.left < c.right - TOLERANCE) continue; gap = r.left - c.right; break;
+            case 'left': if (r.right > c.left + TOLERANCE) continue; gap = c.left - r.right; break;
+            case 'down': if (r.top < c.bottom - TOLERANCE) continue; gap = r.top - c.bottom; break;
+            case 'up': if (r.bottom > c.top + TOLERANCE) continue; gap = c.top - r.bottom; break;
+          }
+          gap = Math.max(0, gap);
+          const overlaps = horizontal
+            ? r.top < c.bottom && r.bottom > c.top
+            : r.left < c.right && r.right > c.left;
+          const offset = horizontal
+            ? Math.abs((r.top + r.bottom) / 2 - (c.top + c.bottom) / 2)
+            : Math.abs((r.left + r.right) / 2 - (c.left + c.right) / 2);
+
+          if (overlaps) {
+            if (gap < bestAlignedGap || (gap === bestAlignedGap && offset < bestAlignedOff)) {
+              bestAligned = el; bestAlignedGap = gap; bestAlignedOff = offset;
+            }
+          } else if (!bestAligned) {
+            const score = gap + WEIGHT * offset;
+            if (score < bestScore) { bestFallback = el; bestScore = score; }
+          }
+        }
+        return bestAligned ?? bestFallback;
+      }
+
+      function moveTo(el, e) {
+        e.preventDefault();
+        setActive(el);
+        el.focus({ preventScroll: true });
+        el.closest('[role="gridcell"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+      }
+
+      container.addEventListener('keydown', (e) => {
+        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+        const target = e.composedPath()[0];
+        if (!(target instanceof Element) || !target.matches(itemSelector)) return;
+        if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+
+        let next = null;
+        if (e.key in DIRS) {
+          next = findNext(target, DIRS[e.key]);
+        } else if (e.key === 'Home' || e.key === 'End') {
+          const list = candidates();
+          next = e.key === 'Home' ? list[0] : list.at(-1);
+          if (next === target) next = null;
+        }
+        // No candidate: leave the event alone so the page scrolls natively.
+        if (next) moveTo(next, e);
+      });
+
+      // Keep the roving tab stop in sync with mouse/programmatic focus.
+      container.addEventListener('focusin', (e) => {
+        if (e.target.matches(itemSelector)) setActive(e.target);
+      });
+
+      setActive(candidates()[0]);
+    }
+
+    document.querySelectorAll('[data-spatial-nav]').forEach((el) => initSpatialNav(el, '.card .btn'));
+  </script>
+
