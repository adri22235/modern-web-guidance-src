+  <script>
+    /**
+     * Spatial (2D) arrow-key navigation for a card grid.
+     *
+     * Navigation is computed from each card's on-screen geometry rather than
+     * from a fixed column count, so it stays correct for any layout: the
+     * responsive auto-fit grid (1–N columns), the single-column list mode,
+     * uneven last rows, and right-to-left documents (Left/Right are visual).
+     *
+     * Uses a roving tabindex so the whole grid is a single Tab stop.
+     */
+    function initSpatialGrid(container, { itemSelector } = {}) {
+      const getItems = () =>
+        Array.from(container.querySelectorAll(itemSelector)).filter((el) => {
+          // Skip hidden items (display: none, collapsed, etc.)
+          const r = el.getBoundingClientRect();
+          return r.width > 0 && r.height > 0 && !el.closest('[hidden], [inert]');
+        });
+
+      let current = null;
+
+      function setActive(el, { focus = false } = {}) {
+        const items = getItems();
+        if (!items.length) return;
+        if (!el || !items.includes(el)) el = items[0];
+        for (const item of items) item.tabIndex = item === el ? 0 : -1;
+        current = el;
+        if (focus) {
+          el.focus();
+          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          el.closest('li, .card')?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
+        }
+      }
+
+      // Rect of the visual card that contains the focus target.
+      const boxOf = (el) => (el.closest('.card') || el).getBoundingClientRect();
+
+      /**
+       * Find the best candidate in a direction.
+       * Primary axis distance is measured edge-to-edge; items that overlap the
+       * current item on the cross axis (same row / column) are strongly
+       * preferred, then the closest by cross-axis center offset.
+       */
+      function findInDirection(from, dir) {
+        const a = boxOf(from);
+        const horizontal = dir === 'left' || dir === 'right';
+        const EPS = 1;
+        let best = null;
+        let bestScore = Infinity;
+
+        for (const el of getItems()) {
+          if (el === from) continue;
+          const b = boxOf(el);
+
+          // Only consider items that lie entirely beyond the current item's
+          // edge in the requested direction (cards never overlap in the grid).
+          let primary;
+          switch (dir) {
+            case 'right': primary = b.left - a.right; break;
+            case 'left': primary = a.left - b.right; break;
+            case 'down': primary = b.top - a.bottom; break;
+            case 'up': primary = a.top - b.bottom; break;
+          }
+          if (primary < -EPS) continue;
+          primary = Math.max(0, primary);
+
+          // Cross-axis overlap and center offset
+          const overlap = horizontal
+            ? Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top)
+            : Math.min(a.right, b.right) - Math.max(a.left, b.left);
+          const crossOffset = horizontal
+            ? Math.abs((a.top + a.bottom) / 2 - (b.top + b.bottom) / 2)
+            : Math.abs((a.left + a.right) / 2 - (b.left + b.right) / 2);
+
+          // Items aligned on the cross axis always win over misaligned ones.
+          const aligned = overlap > EPS;
+          const score = (aligned ? 0 : 1e6) + primary + crossOffset * (aligned ? 0.5 : 2);
+
+          if (score < bestScore) {
+            bestScore = score;
+            best = el;
+          }
+        }
+        return best;
+      }
+
+      container.addEventListener('keydown', (event) => {
+        const target = event.target.closest(itemSelector);
+        if (!target || !container.contains(target)) return;
+        if (event.altKey || event.metaKey || event.shiftKey) return;
+        if (event.ctrlKey && event.key.startsWith('Arrow')) return;
+
+        const items = getItems();
+        let next = null;
+
+        switch (event.key) {
+          case 'ArrowRight': next = findInDirection(target, 'right'); break;
+          case 'ArrowLeft': next = findInDirection(target, 'left'); break;
+          case 'ArrowDown': next = findInDirection(target, 'down'); break;
+          case 'ArrowUp': next = findInDirection(target, 'up'); break;
+          case 'Home':
+            next = event.ctrlKey ? items[0] : firstInRow(target, items);
+            break;
+          case 'End':
+            next = event.ctrlKey ? items[items.length - 1] : lastInRow(target, items);
+            break;
+          default:
+            return;
+        }
+
+        // Always consume handled keys so the page doesn't scroll at edges.
+        event.preventDefault();
+        if (next && next !== target) setActive(next, { focus: true });
+      });
+
+      // Home/End: first/last item in the current visual row. In a
+      // single-column layout every row has one item, so jump to the
+      // first/last item overall (the expected 1D behaviour).
+      function rowOf(target, items) {
+        const a = boxOf(target);
+        const row = items.filter((el) => {
+          const b = boxOf(el);
+          return Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top) > 1;
+        });
+        return row.length > 1 ? row.sort((x, y) => boxOf(x).left - boxOf(y).left) : null;
+      }
+      function firstInRow(target, items) {
+        const row = rowOf(target, items);
+        if (!row) return items[0];
+        return isRTL() ? row[row.length - 1] : row[0];
+      }
+      function lastInRow(target, items) {
+        const row = rowOf(target, items);
+        if (!row) return items[items.length - 1];
+        return isRTL() ? row[0] : row[row.length - 1];
+      }
+      const isRTL = () => getComputedStyle(container).direction === 'rtl';
+
+      // Keep roving tabindex in sync with pointer clicks / programmatic focus.
+      container.addEventListener('focusin', (event) => {
+        const target = event.target.closest(itemSelector);
+        if (target && target !== current) setActive(target);
+      });
+
+      // Re-sync when items are added/removed or become hidden.
+      new MutationObserver(() => setActive(current)).observe(container, {
+        childList: true, subtree: true, attributes: true, attributeFilter: ['hidden', 'class', 'style'],
+      });
+
+      // No resize handling is needed: geometry is read fresh on every
+      // keypress, so column-count changes and grid/list switches just work.
+
+      setActive(null);
+      return { setActive, refresh: () => setActive(current) };
+    }
+
+    (function () {
+      const grid = document.getElementById('seasonal-grid');
+      const status = document.getElementById('layout-status');
+      const toggles = document.querySelectorAll('[data-layout-option]');
+      const STORAGE_KEY = 'daily-grind:card-layout';
+
+      initSpatialGrid(grid, { itemSelector: '.card .btn' });
+
+      function applyLayout(layout, announce) {
+        grid.dataset.layout = layout;
+        toggles.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.layoutOption === layout)));
+        if (announce) status.textContent = layout === 'list' ? 'List layout' : 'Grid layout';
+        try { localStorage.setItem(STORAGE_KEY, layout); } catch (e) { /* storage unavailable */ }
+      }
+
+      let saved = null;
+      try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) { /* storage unavailable */ }
+      if (saved === 'grid' || saved === 'list') applyLayout(saved, false);
+
+      toggles.forEach((btn) => btn.addEventListener('click', () => applyLayout(btn.dataset.layoutOption, true)));
+    })();
+  </script>
+
