+    .unified-card {
+      display: flex;
+      align-items: stretch;
+      max-width: 760px;
+      margin: 0 auto;
+      filter: drop-shadow(0 8px 14px rgba(62, 39, 35, 0.25));
+    }
+
+    .unified-card .card-body {
