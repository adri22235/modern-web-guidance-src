     .btn:hover {
       background: #3e2723;
     }
 
+    /* Shaped Elements */
+    .shaped-section {
+      margin-top: 60px;
+    }
+
+    .shaped-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+      gap: 32px;
+      align-items: center;
+      margin-top: 24px;
+    }
+
+    /* 1) Barista avatar: masked directly with an objectBoundingBox SVG mask,
+       so the splat stretches to whatever size the image is rendered at. */
+    .barista-feature {
+      text-align: center;
+    }
+
+    .shaped-avatar {
+      display: block;
+      width: min(100%, 280px);
+      height: auto;
+      aspect-ratio: 1;
+      margin: 0 auto 12px;
+      object-fit: cover;
+      object-position: center top;
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    .barista-feature h3 {
+      color: var(--primary);
+    }
+
+    /* 2) Loyalty banner: unmasked text body + masked decorative accent.
+       drop-shadow (not box-shadow) follows the accent's masked outline. */
+    .unified-card {
+      display: flex;
+      filter: drop-shadow(0 8px 14px rgba(62, 39, 35, 0.3));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: var(--light);
+      padding: 24px;
+      border-radius: 16px 0 0 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 6px;
+    }
+
+    .card-accent {
+      flex: 0 0 64px;
+      background-color: var(--primary);
+      border-radius: 0 16px 16px 0;
+      -webkit-mask-image: url(#card-accent-mask);
+      mask-image: url(#card-accent-mask);
+    }
+
+    /* 3) Promo card: a radial-gradient mask punches a circular notch out of the top edge. */
+    .gradient-masked-card {
+      background: linear-gradient(135deg, var(--accent), #e65100);
+      color: white;
+      padding: 48px 24px 24px;
+      border-radius: 16px;
+      text-align: center;
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent 22px, black 23px);
+      mask-image: radial-gradient(circle at 50% 0%, transparent 22px, black 23px);
+    }
+
+    .gradient-masked-card .btn {
+      background: white;
+      color: #bf360c;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
