+  <script>
+    (function () {
+      'use strict';
+
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempEl = document.getElementById('roast-temp-value');
+      var stageEl = document.getElementById('roast-stage');
+      var statusEl = document.getElementById('roast-status');
+      if (!widget || !canvas || !canvas.getContext || !tempEl) return;
+
+      var ctx = canvas.getContext('2d');
+      var reduceMotion = !!(window.matchMedia &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches);
+
+      // ---- rAF with fallback for very old browsers ----
+      var raf = window.requestAnimationFrame || window.webkitRequestAnimationFrame ||
+        function (cb) { return window.setTimeout(cb, 1000 / 60); };
+      var caf = window.cancelAnimationFrame || window.webkitCancelAnimationFrame ||
+        function (id) { window.clearTimeout(id); };
+      var now = (window.performance && performance.now) ?
+        function () { return performance.now(); } : function () { return Date.now(); };
+
+      // ---- Simulated roast profile (temperature in °C) ----
+      // Charge hot, dip to turning point, climb through first crack, drop & repeat.
+      var CYCLE_SECONDS = 90;
+      var roastTime = 0;          // seconds into current roast
+      var temp = 200;
+      var TEMP_INTERVAL_MS = 1000;
+
+      function targetTemp(t) {
+        if (t < 10) return 200 - (200 - 95) * (t / 10);           // charge -> turning point
+        var p = (t - 10) / (CYCLE_SECONDS - 10);                  // 0..1
+        return 95 + (228 - 95) * (1 - Math.pow(1 - p, 1.6));      // declining rate of rise
+      }
+
+      function stageFor(t) {
+        if (t < 10) return 'Charge — beans hit the drum';
+        if (t < 30) return 'Drying phase';
+        if (temp < 196) return 'Maillard browning';
+        if (temp < 205) return 'First crack!';
+        if (temp < 220) return 'Development';
+        return 'Dropping — cooling tray';
+      }
+
+      // 0 = green, 1 = dark roast; follows the temperature reading
+      function roastLevel() {
+        return Math.max(0, Math.min(1, (temp - 120) / (228 - 120)));
+      }
+
+      function tickTemperature() {
+        roastTime += TEMP_INTERVAL_MS / 1000;
+        if (roastTime >= CYCLE_SECONDS) roastTime = 0;
+        var noise = (Math.random() - 0.5) * 0.8;
+        temp = targetTemp(roastTime) + noise;
+        tempEl.textContent = temp.toFixed(1);
+        if (stageEl) stageEl.textContent = stageFor(roastTime);
+      }
+
+      // ---- Canvas setup ----
+      var width = 0, height = 0, dpr = 1;
+      function resize() {
+        var rect = canvas.getBoundingClientRect();
+        dpr = Math.min(window.devicePixelRatio || 1, 2);
+        width = Math.max(1, rect.width);
+        height = Math.max(1, rect.height);
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        if (!running) draw(0); // keep a static frame when paused
+      }
+
+      // ---- Beans ----
+      var BEAN_COUNT = 70;
+      var beans = [];
+      for (var i = 0; i < BEAN_COUNT; i++) {
+        beans.push({
+          angle: Math.random() * Math.PI * 2,   // position around the drum
+          radius: 0.25 + Math.random() * 0.7,   // fraction of drum radius
+          speed: 0.6 + Math.random() * 0.8,
+          rot: Math.random() * Math.PI * 2,
+          spin: (Math.random() - 0.5) * 4,
+          size: 9 + Math.random() * 5,
+          shade: (Math.random() - 0.5) * 0.12
+        });
+      }
+
+      function lerp(a, b, t) { return a + (b - a) * t; }
+      function beanColor(level, shade) {
+        // green (#8a9a5b) -> tan (#c8a165) -> brown (#7b4a2a) -> dark (#3b2116)
+        var stops = [[138, 154, 91], [200, 161, 101], [123, 74, 42], [59, 33, 22]];
+        var l = Math.max(0, Math.min(0.999, level + shade)) * (stops.length - 1);
+        var idx = Math.floor(l), f = l - idx;
+        var a = stops[idx], b = stops[idx + 1];
+        return 'rgb(' + Math.round(lerp(a[0], b[0], f)) + ',' +
+          Math.round(lerp(a[1], b[1], f)) + ',' + Math.round(lerp(a[2], b[2], f)) + ')';
+      }
+
+      function drawBean(x, y, size, rot, color) {
+        ctx.save();
+        ctx.translate(x, y);
+        ctx.rotate(rot);
+        ctx.fillStyle = color;
+        ctx.beginPath();
+        if (ctx.ellipse) {
+          ctx.ellipse(0, 0, size, size * 0.68, 0, 0, Math.PI * 2);
+        } else {
+          ctx.scale(1, 0.68);
+          ctx.arc(0, 0, size, 0, Math.PI * 2);
+          ctx.scale(1, 1 / 0.68);
+        }
+        ctx.fill();
+        // center crease
+        ctx.strokeStyle = 'rgba(0,0,0,0.35)';
+        ctx.lineWidth = 1.5;
+        ctx.beginPath();
+        ctx.moveTo(-size * 0.8, 0);
+        ctx.quadraticCurveTo(0, size * 0.25, size * 0.8, 0);
+        ctx.stroke();
+        ctx.restore();
+      }
+
+      var drumAngle = 0;
+      function draw(dt) {
+        var cx = width / 2, cy = height / 2 + 10;
+        var R = Math.min(width, height) * 0.42;
+        var level = roastLevel();
+
+        drumAngle += dt * 0.8;
+
+        // background glow intensifies with heat
+        ctx.fillStyle = '#2b1d17';
+        ctx.fillRect(0, 0, width, height);
+        if (ctx.createRadialGradient) {
+          var g = ctx.createRadialGradient(cx, cy + R, R * 0.2, cx, cy, R * 1.6);
+          g.addColorStop(0, 'rgba(255,120,30,' + (0.15 + level * 0.35).toFixed(3) + ')');
+          g.addColorStop(1, 'rgba(0,0,0,0)');
+          ctx.fillStyle = g;
+          ctx.fillRect(0, 0, width, height);
+        }
+
+        // drum
+        ctx.fillStyle = '#1a110d';
+        ctx.beginPath();
+        ctx.arc(cx, cy, R, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#6d4c41';
+        ctx.lineWidth = 6;
+        ctx.stroke();
+
+        // drum vanes
+        ctx.strokeStyle = 'rgba(141,110,99,0.5)';
+        ctx.lineWidth = 3;
+        for (var v = 0; v < 6; v++) {
+          var a = drumAngle + v * Math.PI / 3;
+          ctx.beginPath();
+          ctx.moveTo(cx + Math.cos(a) * R * 0.75, cy + Math.sin(a) * R * 0.75);
+          ctx.lineTo(cx + Math.cos(a) * R * 0.98, cy + Math.sin(a) * R * 0.98);
+          ctx.stroke();
+        }
+
+        // beans tumble: carried up the right side by rotation, then fall back to the bed
+        for (var i = 0; i < beans.length; i++) {
+          var b = beans[i];
+          b.angle += dt * b.speed;
+          b.rot += dt * b.spin;
+          // keep beans mostly in the lower portion (the bed) of the drum
+          var t = (Math.sin(b.angle) + 1) / 2;                  // 0..1
+          var theta = Math.PI * (0.15 + 0.7 * t) + Math.sin(b.angle * 0.5) * 0.3;
+          var r = R * 0.9 * b.radius;
+          var x = cx + Math.cos(theta) * r;
+          var y = cy + Math.sin(theta) * r;
+          drawBean(x, y, b.size, b.rot, beanColor(level, b.shade));
+        }
+
+        // wisps of smoke later in the roast
+        if (level > 0.55) {
+          var smokeAlpha = (level - 0.55) * 0.5;
+          ctx.fillStyle = 'rgba(220,220,220,' + smokeAlpha.toFixed(3) + ')';
+          for (var s = 0; s < 5; s++) {
+            var phase = (drumAngle * 0.4 + s / 5) % 1;
+            ctx.beginPath();
+            ctx.arc(cx - R * 0.4 + s * R * 0.2 + Math.sin(phase * 6 + s) * 8,
+              cy - R * 0.2 - phase * R * 0.9, 6 + phase * 14, 0, Math.PI * 2);
+            ctx.fill();
+          }
+        }
+      }
+
+      // ---- Run / pause control ----
+      var running = false;
+      var rafId = null;
+      var tempTimer = null;
+      var lastFrame = 0;
+      var inView = false;
+      var pageVisible = true;
+
+      function frame() {
+        if (!running) return;
+        // Use our own clock: legacy rAF/timeout fallbacks use differing timestamp bases.
+        var t = now();
+        var dt = Math.min(0.05, (t - lastFrame) / 1000); // clamp to avoid jumps
+        lastFrame = t;
+        draw(reduceMotion ? dt * 0.25 : dt);
+        rafId = raf(frame);
+      }
+
+      function start() {
+        if (running) return;
+        running = true;
+        lastFrame = now();
+        rafId = raf(frame);
+        tempTimer = window.setInterval(tickTemperature, TEMP_INTERVAL_MS);
+        if (statusEl) statusEl.textContent = '';
+      }
+
+      function stop() {
+        if (!running) return;
+        running = false;
+        if (rafId !== null) { caf(rafId); rafId = null; }
+        if (tempTimer !== null) { window.clearInterval(tempTimer); tempTimer = null; }
+        if (statusEl) statusEl.textContent = 'Paused';
+      }
+
+      function update() {
+        if (inView && pageVisible) start(); else stop();
+      }
+
+      // Pause when the tab is hidden too (rAF is throttled there, but setInterval is not).
+      var hiddenProp = 'hidden' in document ? 'hidden' :
+        ('webkitHidden' in document ? 'webkitHidden' : null);
+      if (hiddenProp) {
+        var visEvent = hiddenProp === 'hidden' ? 'visibilitychange' : 'webkitvisibilitychange';
+        document.addEventListener(visEvent, function () {
+          pageVisible = !document[hiddenProp];
+          update();
+        }, false);
+        pageVisible = !document[hiddenProp];
+      }
+
+      // ---- Visibility detection: IntersectionObserver, with scroll/resize fallback ----
+      function isInViewport() {
+        var rect = widget.getBoundingClientRect();
+        var vh = window.innerHeight || document.documentElement.clientHeight;
+        var vw = window.innerWidth || document.documentElement.clientWidth;
+        return rect.bottom > 0 && rect.right > 0 && rect.top < vh && rect.left < vw;
+      }
+
+      if ('IntersectionObserver' in window) {
+        var io = new IntersectionObserver(function (entries) {
+          var entry = entries[entries.length - 1];
+          // Older implementations may lack isIntersecting; fall back to ratio.
+          inView = typeof entry.isIntersecting === 'boolean' ?
+            entry.isIntersecting : entry.intersectionRatio > 0;
+          update();
+        }, { threshold: 0 });
+        io.observe(widget);
+      } else {
+        var pending = false;
+        var check = function () {
+          pending = false;
+          var vis = isInViewport();
+          if (vis !== inView) { inView = vis; update(); }
+        };
+        // Throttle via timeout so the check itself never depends on rAF.
+        var schedule = function () {
+          if (pending) return;
+          pending = true;
+          window.setTimeout(check, 100);
+        };
+        var add = window.addEventListener ?
+          function (t, fn) { window.addEventListener(t, fn, false); } :
+          function (t, fn) { window.attachEvent('on' + t, fn); };
+        add('scroll', schedule);
+        add('resize', schedule);
+        add('orientationchange', schedule);
+        add('load', schedule);
+        check();
+      }
+
+      var resizeTimer = null;
+      if (window.addEventListener) {
+        window.addEventListener('resize', function () {
+          window.clearTimeout(resizeTimer);
+          resizeTimer = window.setTimeout(resize, 150);
+        }, false);
+      }
+
+      resize();
+      tickTemperature();
+      draw(0);
+    })();
+  </script>
+
 </body>
 
