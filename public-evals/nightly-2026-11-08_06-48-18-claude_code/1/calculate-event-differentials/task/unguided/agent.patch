+  <script>
+    (function () {
+      'use strict';
+
+      var HOUR_MS = 60 * 60 * 1000;
+
+      function parseDate(iso) {
+        var parts = iso.split('-').map(Number);
+        return { year: parts[0], month: parts[1], day: parts[2] };
+      }
+
+      function plural(n, word) {
+        return n + ' ' + word + (n === 1 ? '' : 's');
+      }
+
+      function formatSpan(span) {
+        return plural(span.days, 'day') + ' and ' + plural(span.hours, 'hour');
+      }
+
+      // Each "clock" below exposes span(from, to) -> { days, hours }: whole
+      // local calendar days plus leftover whole hours, so DST transitions
+      // don't skew the result.
+
+      // Preferred: the Temporal API (Chrome 144+, Firefox 139+). It does
+      // time-zone- and DST-aware calendar arithmetic natively.
+      function makeTemporalClock(T) {
+        var tz = T.Now.timeZoneId();
+        function midnight(d) {
+          // startOfDay() handles zones where midnight is skipped by DST.
+          return T.PlainDate.from(d).toZonedDateTime({ timeZone: tz }).startOfDay();
+        }
+        function span(from, to) {
+          var dur = from.until(to, { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' });
+          return { days: dur.days, hours: dur.hours };
+        }
+        return {
+          now: function () { return T.Now.zonedDateTimeISO(tz); },
+          midnight: midnight,
+          compare: function (a, b) { return T.ZonedDateTime.compare(a, b); },
+          span: span,
+          label: function (zdt) {
+            return zdt.toLocaleString(undefined, { dateStyle: 'long', timeStyle: 'short' });
+          }
+        };
+      }
+
+      // Fallback for browsers without Temporal: legacy Date, which already
+      // uses the local time zone for its component constructors/getters.
+      function makeDateClock() {
+        function midnight(d) {
+          return new Date(d.year, d.month - 1, d.day, 0, 0, 0, 0);
+        }
+        function addDays(date, n) {
+          var r = new Date(date.getTime());
+          r.setDate(r.getDate() + n); // calendar-aware, keeps local wall time
+          return r;
+        }
+        function span(from, to) {
+          // Estimate, then correct for DST-length days.
+          var days = Math.floor((to - from) / (24 * HOUR_MS));
+          while (days > 0 && addDays(from, days) > to) days--;
+          while (addDays(from, days + 1) <= to) days++;
+          var hours = Math.floor((to - addDays(from, days)) / HOUR_MS);
+          return { days: days, hours: hours };
+        }
+        return {
+          now: function () { return new Date(); },
+          midnight: midnight,
+          compare: function (a, b) { return a - b; },
+          span: span,
+          label: function (date) {
+            return date.toLocaleString(undefined, { dateStyle: 'long', timeStyle: 'short' });
+          }
+        };
+      }
+
+      function getClock() {
+        if (typeof Temporal !== 'undefined' && Temporal.Now &&
+            typeof Temporal.Now.zonedDateTimeISO === 'function') {
+          try { return makeTemporalClock(Temporal); } catch (e) { /* fall through */ }
+        }
+        return makeDateClock();
+      }
+
+      function render() {
+        var el = document.getElementById('maple-promo');
+        if (!el) return;
+
+        var clock = getClock();
+        var start = clock.midnight(parseDate(el.dataset.promoStart));
+        var end = clock.midnight(parseDate(el.dataset.promoEnd));
+        var now = clock.now();
+
+        var remainingEl = el.querySelector('.promo-remaining');
+        var elapsedEl = el.querySelector('.promo-elapsed');
+        var endLabel = clock.label(end);
+        var startLabel = clock.label(start);
+
+        if (clock.compare(now, start) < 0) {
+          el.dataset.state = 'upcoming';
+          remainingEl.innerHTML = 'Starts in <strong>' + formatSpan(clock.span(now, start)) +
+            '</strong> (' + startLabel + ').';
+          elapsedEl.textContent = 'Available until ' + endLabel + '.';
+        } else if (clock.compare(now, end) < 0) {
+          el.dataset.state = 'active';
+          remainingEl.innerHTML = '<strong>' + formatSpan(clock.span(now, end)) +
+            '</strong> left &mdash; offer ends ' + endLabel + '.';
+          elapsedEl.textContent = 'Running for ' + formatSpan(clock.span(start, now)) +
+            ' since ' + startLabel + '.';
+        } else {
+          el.dataset.state = 'ended';
+          remainingEl.innerHTML = '<strong>This offer has ended</strong> (' + endLabel + ').';
+          elapsedEl.textContent = formatSpan(clock.span(start, now)) +
+            ' since the promotion began on ' + startLabel + '.';
+        }
+      }
+
+      // pageshow fires on the initial load and when the page is restored
+      // from the back/forward cache, so the numbers are never stale.
+      window.addEventListener('pageshow', render);
+    })();
+  </script>
+
