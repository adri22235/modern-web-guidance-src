+
+  <script type="module">
+    // Countdown for the Maple Oat Latte promotion, computed once on page load
+    // in the visitor's local time zone using Temporal (polyfilled where missing).
+    if (typeof Temporal === 'undefined') {
+      try {
+        const mod = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = mod.Temporal;
+      } catch {
+        // Polyfill unavailable: keep the static "Offer ends" fallback text.
+      }
+    }
+
+    const el = document.getElementById('maple-promo');
+    if (el && typeof Temporal !== 'undefined') {
+      const tz = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(tz);
+      // Midnight (start of day) on each date, in the visitor's local zone.
+      const start = Temporal.PlainDate.from(el.dataset.start).toZonedDateTime({ timeZone: tz });
+      const end = Temporal.PlainDate.from(el.dataset.end).toZonedDateTime({ timeZone: tz });
+
+      // Durations under an hour truncate to zero, which formats as an empty string.
+      const fmt = (d) => (d.blank ? 'less than an hour' : d.toLocaleString(undefined, { style: 'long' }));
+      const remainingEl = el.querySelector('.promo-remaining');
+      const elapsedEl = el.querySelector('.promo-elapsed');
+      const endLabel = end.toLocaleString(undefined, { dateStyle: 'long', timeStyle: 'short' });
+
+      const remaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' });
+      const sinceStart = now.since(start, { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' });
+
+      const strong = (text) => Object.assign(document.createElement('strong'), { textContent: text });
+      const time = (text, iso) => Object.assign(document.createElement('time'), { textContent: text, dateTime: iso });
+
+      if (Temporal.ZonedDateTime.compare(now, start) < 0) {
+        // Promotion hasn't started yet.
+        const untilStart = now.until(start, { largestUnit: 'day', smallestUnit: 'hour', roundingMode: 'trunc' });
+        remainingEl.replaceChildren('Starts in ', strong(fmt(untilStart)), '.');
+      } else if (Temporal.ZonedDateTime.compare(now, end) < 0) {
+        remainingEl.replaceChildren(strong(fmt(remaining)), ' left — ends ', time(endLabel, end.toString({ timeZoneName: 'never' })), '.');
+        elapsedEl.replaceChildren('Running for ', strong(fmt(sinceStart)), '.');
+        elapsedEl.hidden = false;
+      } else {
+        // Offer is over; elapsed is measured from start to end.
+        const ran = start.until(end, { largestUnit: 'day' });
+        remainingEl.replaceChildren('This offer ended ', time(endLabel, end.toString({ timeZoneName: 'never' })), '.');
+        elapsedEl.replaceChildren('Ran for ', strong(fmt(ran)), '; ', strong(fmt(sinceStart)), ' since it began.');
+        elapsedEl.hidden = false;
+      }
+    }
+  </script>
