+  <script>
+    (() => {
+      // Priority levels: lower rank runs first.
+      const PRIORITIES = {
+        urgent: { rank: 0, label: 'Urgent', native: 'user-blocking' },
+        standard: { rank: 1, label: 'Standard', native: 'user-visible' },
+        background: { rank: 2, label: 'Background', native: 'background' },
+      };
+
+      const TEMPLATES = {
+        urgent: { names: ['Checkout: process payment', 'Checkout: validate cart', 'Checkout: confirm order'], work: 400 },
+        standard: { names: ['Menu: sync seasonal items', 'Menu: refresh prices', 'Menu: rebuild allergen info'], work: 900 },
+        background: { names: ['Telemetry: flush page views', 'Telemetry: compress session logs', 'Telemetry: upload metrics'], work: 1400 },
+      };
+
+      const SLICE_MS = 8; // max time a single chunk may hold the main thread
+
+      // Yield back to the browser so input, rendering and animations can run.
+      const yieldToMain = () => {
+        if (globalThis.scheduler && typeof scheduler.yield === 'function') return scheduler.yield();
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      };
+
+      const $ = (id) => document.getElementById(id);
+      const queueEl = $('ops-queue');
+      const logEl = $('ops-log');
+      const queuedEl = $('ops-queued');
+      const completedEl = $('ops-completed');
+      const longestEl = $('ops-longest');
+      $('ops-mode').textContent = globalThis.scheduler && scheduler.yield ? 'scheduler.yield()' : 'setTimeout fallback';
+
+      const queue = [];
+      let seq = 0;
+      let completed = 0;
+      let running = false;
+      let current = null;
+
+      // Simulated CPU-heavy work: `units` iterations of hashing-ish math.
+      const doWork = (task) => {
+        const deadline = performance.now() + SLICE_MS;
+        let acc = task.acc;
+        while (task.done < task.total && performance.now() < deadline) {
+          for (let i = 0; i < 2000; i++) acc = (acc * 31 + i) % 1000003;
+          task.done++;
+        }
+        task.acc = acc;
+      };
+
+      // Highest priority first; FIFO within the same priority.
+      const pickNext = () => {
+        let best = null;
+        for (const t of queue) {
+          if (!best || t.rank < best.rank || (t.rank === best.rank && t.id < best.id)) best = t;
+        }
+        return best;
+      };
+
+      const enqueue = (priority, render = true) => {
+        const tpl = TEMPLATES[priority];
+        const p = PRIORITIES[priority];
+        const task = {
+          id: ++seq,
+          priority,
+          rank: p.rank,
+          name: tpl.names[Math.floor(Math.random() * tpl.names.length)],
+          total: Math.round(tpl.work * (0.75 + Math.random() * 0.5)),
+          done: 0,
+          acc: 1,
+          queuedAt: performance.now(),
+          el: null,
+          bar: null,
+        };
+        task.el = document.createElement('li');
+        task.el.className = 'ops-task';
+        task.el.dataset.priority = priority;
+        task.el.innerHTML =
+          '<div class="ops-task-head"><span></span><span class="ops-badge"></span></div>' +
+          '<div class="ops-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>';
+        task.el.querySelector('.ops-task-head span').textContent = `#${task.id} ${task.name}`;
+        task.el.querySelector('.ops-badge').textContent = p.label;
+        task.bar = task.el.querySelector('.ops-progress');
+        queue.push(task);
+        if (render) renderQueue();
+        run();
+        return task;
+      };
+
+      const renderQueue = () => {
+        const sorted = [...queue].sort((a, b) => a.rank - b.rank || a.id - b.id);
+        queueEl.replaceChildren(...sorted.map((t) => t.el));
+        if (!sorted.length) {
+          const li = document.createElement('li');
+          li.className = 'ops-empty';
+          li.textContent = 'Queue is empty. Add a task above.';
+          queueEl.append(li);
+        }
+        queuedEl.textContent = queue.length;
+      };
+
+      const updateProgress = (task) => {
+        const pct = Math.round((task.done / task.total) * 100);
+        task.bar.firstElementChild.style.width = pct + '%';
+        task.bar.setAttribute('aria-valuenow', pct);
+      };
+
+      const logCompletion = (task) => {
+        const li = document.createElement('li');
+        const time = document.createElement('time');
+        const elapsed = Math.round(performance.now() - task.queuedAt);
+        time.textContent = new Date().toLocaleTimeString();
+        li.append(time, `#${task.id} [${PRIORITIES[task.priority].label}] ${task.name} — done in ${elapsed} ms`);
+        logEl.append(li);
+        logEl.scrollTop = logEl.scrollHeight;
+        completedEl.textContent = ++completed;
+      };
+
+      // Cooperative scheduler loop: one slice of the most important task, then yield.
+      async function run() {
+        if (running) return;
+        running = true;
+        try {
+          while (queue.length) {
+            const task = pickNext();
+            if (current !== task) {
+              if (current) current.el.classList.remove('running');
+              current = task;
+              task.el.classList.add('running');
+            }
+            doWork(task);
+            updateProgress(task);
+            if (task.done >= task.total) {
+              queue.splice(queue.indexOf(task), 1);
+              current = null;
+              logCompletion(task);
+              renderQueue();
+            }
+            await yieldToMain();
+          }
+        } finally {
+          running = false;
+        }
+      }
+
+      // Responsiveness monitor: measures the longest gap between animation frames.
+      let lastFrame = performance.now();
+      let longest = 0;
+      const frame = (now) => {
+        const gap = now - lastFrame;
+        lastFrame = now;
+        if (gap > longest && document.visibilityState === 'visible') {
+          longest = gap;
+          longestEl.textContent = Math.round(gap) + ' ms';
+        }
+        requestAnimationFrame(frame);
+      };
+      requestAnimationFrame(frame);
+      document.addEventListener('visibilitychange', () => { lastFrame = performance.now(); });
+
+      document.querySelectorAll('[data-ops-add]').forEach((btn) => {
+        btn.addEventListener('click', () => enqueue(btn.dataset.opsAdd));
+      });
+
+      // Mixed batch: added in shuffled order, executed strictly by priority.
+      $('ops-batch').addEventListener('click', () => {
+        const mix = ['background', 'standard', 'urgent', 'background', 'standard', 'urgent', 'background', 'standard'];
+        for (let i = mix.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [mix[i], mix[j]] = [mix[j], mix[i]];
+        }
+        mix.forEach((p) => enqueue(p, false));
+        renderQueue();
+      });
+
+      $('ops-clear').addEventListener('click', () => {
+        logEl.replaceChildren();
+        completed = 0;
+        completedEl.textContent = '0';
+        longest = 0;
+        longestEl.textContent = '0 ms';
+      });
+
+      renderQueue();
+    })();
+  </script>
+
