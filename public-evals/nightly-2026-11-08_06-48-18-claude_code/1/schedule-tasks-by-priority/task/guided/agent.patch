+  <script type="module">
+    // ---- Scheduler support -------------------------------------------------
+    // Prefer the native Prioritized Task Scheduling API. Where it's missing
+    // (e.g. Safari), load the official polyfill; if that also fails, fall back
+    // to a tiny setTimeout-based priority queue so the demo still works.
+    const PRIORITY_ORDER = ['user-blocking', 'user-visible', 'background'];
+    let schedulerMode = 'native';
+
+    function installMinimalScheduler() {
+      const queues = { 'user-blocking': [], 'user-visible': [], background: [] };
+      let pumping = false;
+      const pump = () => {
+        pumping = false;
+        const next = PRIORITY_ORDER.map((p) => queues[p]).find((q) => q.length);
+        if (!next) return;
+        next.shift()();
+        if (PRIORITY_ORDER.some((p) => queues[p].length)) schedule();
+      };
+      const schedule = () => {
+        if (!pumping) { pumping = true; setTimeout(pump, 0); }
+      };
+      window.scheduler = {
+        postTask(cb, { priority = 'user-visible' } = {}) {
+          return new Promise((resolve, reject) => {
+            queues[priority].push(() => {
+              try { resolve(cb()); } catch (err) { reject(err); }
+            });
+            schedule();
+          });
+        },
+      };
+      schedulerMode = 'fallback';
+    }
+
+    async function ensureScheduler() {
+      if ('scheduler' in window && 'postTask' in window.scheduler) return;
+      try {
+        await new Promise((resolve, reject) => {
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = resolve;
+          script.onerror = reject;
+          document.head.append(script);
+        });
+        schedulerMode = 'polyfill';
+      } catch {
+        installMinimalScheduler();
+      }
+    }
+
+    // Yield to the main thread so input and rendering can happen between chunks.
+    // Inside a postTask callback, native scheduler.yield() keeps the task's priority.
+    function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        return window.scheduler.yield();
+      }
+      return new Promise((resolve) => setTimeout(resolve, 0));
+    }
+
+    // ---- Task definitions --------------------------------------------------
+    const TASKS = {
+      checkout: {
+        priority: 'user-blocking',
+        label: 'Checkout',
+        names: ['Authorize card payment', 'Reserve pickup slot', 'Confirm mobile order', 'Apply rewards discount'],
+        steps: 40,
+      },
+      menu: {
+        priority: 'user-visible',
+        label: 'Menu update',
+        names: ['Refresh seasonal menu', 'Sync pastry inventory', 'Update espresso pricing', 'Publish daily specials'],
+        steps: 60,
+      },
+      telemetry: {
+        priority: 'background',
+        label: 'Telemetry',
+        names: ['Flush grinder metrics', 'Log barista queue times', 'Upload espresso shot stats', 'Archive POS events'],
+        steps: 80,
+      },
+    };
+    const PRIORITY_LABEL = { 'user-blocking': 'Urgent', 'user-visible': 'Standard', background: 'Background' };
+
+    // ---- UI state ------------------------------------------------------------
+    const log = document.getElementById('ops-log');
+    const counts = { 'user-blocking': 0, 'user-visible': 0, background: 0, done: 0 };
+    const countEls = Object.fromEntries(
+      [...document.querySelectorAll('[data-count]')].map((el) => [el.dataset.count, el])
+    );
+    let taskId = 0;
+
+    function renderCounts() {
+      for (const [key, el] of Object.entries(countEls)) el.textContent = counts[key];
+    }
+
+    function createLogEntry(name, priority) {
+      const li = document.createElement('li');
+      li.dataset.state = 'queued';
+      const badge = document.createElement('span');
+      badge.className = `ops-badge ${priority}`;
+      badge.textContent = PRIORITY_LABEL[priority];
+      const text = document.createElement('span');
+      text.className = 'ops-task-name';
+      text.textContent = name;
+      const status = document.createElement('small');
+      status.textContent = 'Queued';
+      text.append(status);
+      const progress = document.createElement('progress');
+      progress.max = 100;
+      progress.value = 0;
+      progress.setAttribute('aria-label', `${name} progress`);
+      li.append(badge, text, progress);
+      log.append(li);
+      return { li, status, progress };
+    }
+
+    // Simulated CPU-heavy unit of work (~4–6ms each).
+    function busyWork(ms) {
+      const end = performance.now() + ms;
+      let x = 0;
+      while (performance.now() < end) x += Math.sqrt(Math.random());
+      return x;
+    }
+
+    // ---- Queueing ------------------------------------------------------------
+    function enqueue(type) {
+      const def = TASKS[type];
+      const id = ++taskId;
+      const name = `#${id} ${def.label}: ${def.names[id % def.names.length]}`;
+      const { li, status, progress } = createLogEntry(name, def.priority);
+      const queuedAt = performance.now();
+
+      counts[def.priority]++;
+      renderCounts();
+
+      return window.scheduler
+        .postTask(async () => {
+          counts[def.priority]--;
+          renderCounts();
+          li.dataset.state = 'running';
+          status.textContent = `Running (waited ${Math.round(performance.now() - queuedAt)} ms)`;
+          const startedAt = performance.now();
+
+          // Break the long job into chunks and yield whenever a 50ms budget is spent.
+          let deadline = performance.now() + 50;
+          for (let step = 1; step <= def.steps; step++) {
+            busyWork(4 + Math.random() * 2);
+            if (performance.now() >= deadline) {
+              progress.value = Math.round((step / def.steps) * 100);
+              await yieldToMain();
+              deadline = performance.now() + 50;
+            }
+          }
+
+          progress.value = 100;
+          li.dataset.state = 'done';
+          status.textContent = `Done in ${Math.round(performance.now() - startedAt)} ms`;
+          counts.done++;
+          renderCounts();
+        }, { priority: def.priority })
+        .catch((err) => {
+          li.dataset.state = 'error';
+          status.textContent = `Failed: ${err.message}`;
+        });
+    }
+
+    function runBatch() {
+      // Deliberately enqueue in a scrambled order: the scheduler still runs
+      // all urgent checkouts first, then menu updates, then telemetry.
+      const mix = ['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout', 'telemetry', 'checkout', 'menu'];
+      mix.forEach(enqueue);
+    }
+
+    // ---- Wire up -------------------------------------------------------------
+    await ensureScheduler();
+    document.getElementById('ops-mode').textContent =
+      `Scheduler: ${{ native: 'native API', polyfill: 'polyfill', fallback: 'basic fallback' }[schedulerMode]}`;
+
+    document.querySelector('.ops-controls').addEventListener('click', (event) => {
+      const button = event.target.closest('button');
+      if (!button) return;
+      if (button.dataset.task) enqueue(button.dataset.task);
+      else if (button.dataset.action === 'batch') runBatch();
+      else if (button.dataset.action === 'clear') {
+        log.querySelectorAll('li[data-state="done"], li[data-state="error"]').forEach((li) => li.remove());
+        counts.done = 0;
+        renderCounts();
+      }
+    });
+
+    const pulseCount = document.getElementById('ops-pulse-count');
+    let taps = 0;
+    document.getElementById('ops-pulse-btn').addEventListener('click', () => {
+      pulseCount.textContent = ++taps;
+    });
+  </script>
+
 </body>
 
