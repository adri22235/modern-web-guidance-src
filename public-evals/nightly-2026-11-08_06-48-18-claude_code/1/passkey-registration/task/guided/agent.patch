+  <script type="module">
+    const registerButton = document.getElementById('register-button');
+    const statusEl = document.getElementById('passkey-status');
+
+    function setStatus(message, state = 'info') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    // Load the JSON (de)serialization polyfill only for browsers that support
+    // WebAuthn but lack parseCreationOptionsFromJSON / toJSON. Version pinned.
+    async function ensureJSONHelpers() {
+      if (
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+        typeof PublicKeyCredential.prototype.toJSON !== 'function'
+      ) {
+        await import('https://esm.sh/webauthn-polyfills@0.1.7');
+      }
+    }
+
+    async function isPasskeyCreationSupported() {
+      if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) {
+        return false;
+      }
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        try {
+          const caps = await PublicKeyCredential.getClientCapabilities();
+          return Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+        } catch {
+          // Fall through to legacy feature checks.
+        }
+      }
+      // Fallback for browsers without getClientCapabilities().
+      const [platform, conditional] = await Promise.all([
+        PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable?.() ?? false,
+        PublicKeyCredential.isConditionalMediationAvailable?.() ?? false,
+      ]);
+      return Boolean(platform && conditional);
+    }
+
+    async function signalUnknown(rpId, credentialId) {
+      if (typeof PublicKeyCredential.signalUnknownCredential !== 'function' || !rpId) return;
+      try {
+        await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+      } catch (err) {
+        console.warn('signalUnknownCredential failed:', err);
+      }
+    }
+
+    async function registerPasskey() {
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      setStatus('Preparing passkey creation…');
+
+      try {
+        await ensureJSONHelpers();
+
+        // 1. Fetch creation options from the server (challenge is generated server-side).
+        let optionsJSON;
+        try {
+          const res = await fetch('/api/register/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify({ promotion: true }),
+          });
+          if (!res.ok) throw new Error(`Options request failed (${res.status})`);
+          optionsJSON = await res.json();
+        } catch (err) {
+          console.error(err);
+          setStatus('We couldn’t start passkey creation. Please try again later.', 'error');
+          return;
+        }
+
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+        // 2. Create the credential.
+        let credential;
+        try {
+          setStatus('Follow your device’s prompt to create a passkey.');
+          credential = await navigator.credentials.create({ publicKey });
+        } catch (err) {
+          switch (err.name) {
+            case 'InvalidStateError':
+              setStatus('A passkey already exists for this account on this device.', 'error');
+              break;
+            case 'NotAllowedError':
+              setStatus('Passkey creation was cancelled.');
+              break;
+            case 'AbortError':
+              setStatus('Passkey creation was aborted.');
+              break;
+            case 'SecurityError':
+              console.error('WebAuthn security error (RP ID / secure context):', err);
+              setStatus('Passkeys can’t be created on this site right now.', 'error');
+              break;
+            default:
+              console.error(err);
+              setStatus('Something went wrong while creating your passkey.', 'error');
+          }
+          return; // Do not signal unknown credential for client-side failures.
+        }
+        if (!credential) {
+          setStatus('Passkey creation was cancelled.');
+          return;
+        }
+
+        // 3. Verify the registration on the server.
+        const encodedCredential = credential.toJSON();
+        const rpId = publicKey.rp?.id; // Always use the server-provided RP ID.
+        try {
+          const res = await fetch('/api/register/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+            body: JSON.stringify(encodedCredential),
+          });
+          if (!res.ok) {
+            await signalUnknown(rpId, encodedCredential.id);
+            setStatus('We couldn’t verify your new passkey. Please try again.', 'error');
+            return;
+          }
+        } catch (err) {
+          console.error('Passkey verification network failure:', err);
+          await signalUnknown(rpId, encodedCredential.id);
+          setStatus('We couldn’t verify your new passkey. Please try again.', 'error');
+          return;
+        }
+
+        setStatus('Your passkey has been created. You can use it next time you sign in.', 'success');
+      } catch (err) {
+        console.error(err);
+        setStatus('Something went wrong while creating your passkey.', 'error');
+      } finally {
+        registerButton.disabled = false;
+        registerButton.removeAttribute('aria-busy');
+      }
+    }
+
+    // Gate the button on capability detection at page load.
+    isPasskeyCreationSupported()
+      .then((supported) => {
+        if (supported) {
+          registerButton.disabled = false;
+          registerButton.addEventListener('click', registerPasskey);
+        } else {
+          registerButton.disabled = true;
+          setStatus('Passkeys aren’t supported on this device. You can keep signing in with your password.');
+        }
+      })
+      .catch(() => {
+        registerButton.disabled = true;
+      });
+  </script>
+
 </body>
 
