diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,99 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Scrollbar: thumb vs. track is ~8:1, well above the WCAG 3:1 non-text minimum */
+      --scrollbar-thumb: var(--primary);
+      --scrollbar-thumb-hover: var(--text);
+      --scrollbar-track: var(--secondary);
+      --scrollbar-size: 14px;
     }
 
+    /* Users who asked their OS for more contrast: near-black thumb on white track, wider bar */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-thumb: #1b0f0c;
+        --scrollbar-thumb-hover: #000;
+        --scrollbar-track: #fff;
+        --scrollbar-size: 18px;
+      }
+    }
+
+    /* Scrollbars
+       Chromium/Safari get the ::-webkit-scrollbar rules (supports custom width and borders).
+       Chrome 121+ ignores those once scrollbar-color is set, so the standard properties
+       are only applied in browsers without the -webkit- pseudo-elements (Firefox). */
+    @supports not selector(::-webkit-scrollbar) {
+      html {
+        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+        scrollbar-width: auto;
+      }
+    }
+
+    ::-webkit-scrollbar {
+      width: var(--scrollbar-size);
+      height: var(--scrollbar-size);
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+      border-left: 1px solid var(--scrollbar-thumb);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background: var(--scrollbar-thumb);
+      border: 3px solid var(--scrollbar-track);
+      border-radius: var(--scrollbar-size);
+      min-height: 40px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover,
+    ::-webkit-scrollbar-thumb:active {
+      background: var(--scrollbar-thumb-hover);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    @media (prefers-contrast: more) {
+      ::-webkit-scrollbar-track {
+        border-left-width: 2px;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-width: 2px;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: defer to the user's system palette */
+    @media (forced-colors: active) {
+      html {
+        scrollbar-color: auto;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: Canvas;
+        border-left-color: CanvasText;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background: CanvasText;
+        border-color: Canvas;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background: Highlight;
+      }
+
+      ::-webkit-scrollbar-corner {
+        background: Canvas;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
