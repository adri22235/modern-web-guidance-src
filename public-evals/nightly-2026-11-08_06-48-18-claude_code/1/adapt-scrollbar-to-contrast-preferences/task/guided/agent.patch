diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -19,8 +19,45 @@
       margin: 0;
       padding: 0;
     }
 
+    /* Scrollbars: espresso thumb on latte track (~7.4:1 contrast) */
+    html {
+      --scrollbar-thumb: var(--primary);
+      --scrollbar-track: var(--secondary);
+
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      /* Full width (not thin) for a larger target; also makes macOS
+         overlay scrollbars honor the custom colors */
+      scrollbar-width: auto;
+    }
+
+    /* Stark black-on-white scrollbars for users who request more contrast */
+    @media (prefers-contrast: more) {
+      html {
+        --scrollbar-thumb: #000000;
+        --scrollbar-track: #ffffff;
+      }
+    }
+
+    /* Legacy fallback for WebKit/Blink without scrollbar-color support */
+    @supports not (scrollbar-color: auto) {
+      ::-webkit-scrollbar {
+        width: 14px;
+        height: 14px;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border: 3px solid var(--scrollbar-track);
+        border-radius: 7px;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
