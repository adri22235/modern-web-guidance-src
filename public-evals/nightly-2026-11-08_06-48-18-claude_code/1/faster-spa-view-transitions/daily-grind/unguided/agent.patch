+      function getView(path) {
+        var entry = cache[path];
+        if (entry) return entry;
+        var def = views[path];
+        var out = def.create();
+        var node = out.node || out;
+        node.setAttribute('data-view', path);
+        node.setAttribute('tabindex', '-1');
+        node.hidden = true;
+        app.appendChild(node);
+        entry = cache[path] = { node: node, onShow: out.onShow || null, scrollY: 0, title: def.title };
+        return entry;
+      }
