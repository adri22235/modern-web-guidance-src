+      function prewarm() {
+        var pending = Object.keys(views).filter(function (p) { return !cache[p]; });
+        (function step() {
+          var p = pending.shift();
+          if (!p) return;
+          idle(function () { if (!cache[p]) getView(p); step(); });
+        })();
+      }
