+      function parse() {
+        var path = location.hash.replace(/^#/, '') || '/';
+        return (path === '/' || views[path]) ? path : '/';
+      }
+
+      function show(path, fromUser) {
+        if (path === current) return;
+        var next = getView(path);
+        var prev = current && cache[current];
+
+        if (prev) {
+          prev.scrollY = window.scrollY; // remember where the user was
+          prev.node.hidden = true;       // detach from layout, keep DOM + state
+        }
+        next.node.hidden = false;
+        if (next.onShow) next.onShow();
+        current = path;
+
+        window.scrollTo(0, next.scrollY);
+        document.title = next.title ? next.title + ' | The Daily Grind' : BASE_TITLE;
+        navLinks.forEach(function (a) {
+          if (a.getAttribute('data-route') === path) a.setAttribute('aria-current', 'page');
+          else a.removeAttribute('aria-current');
+        });
