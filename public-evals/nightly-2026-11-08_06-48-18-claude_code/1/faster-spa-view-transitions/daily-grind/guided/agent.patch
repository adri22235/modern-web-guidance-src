+// The Daily Grind — client-side SPA router.
+//
+// Views are rendered lazily on first visit and then kept alive in the DOM.
+// Inactive views are hidden with `content-visibility: hidden` (see index.html),
+// so the browser skips their layout/paint but keeps their cached rendering
+// state, DOM, form values and listeners. Returning to a view is a class toggle
+// instead of a full rebuild. The number of views is small and fixed, so no
+// eviction strategy is needed.
+
+const MENU = [
+  { id: 'seasonal', cat: 'seasonal', name: 'Maple Oat Latte', desc: 'Creamy oat milk with a hint of Vermont maple syrup.', price: 5.75 },
+  { id: 'pumpkin-chai', cat: 'seasonal', name: 'Spiced Pumpkin Chai', desc: 'Black tea, real pumpkin, cinnamon and clove.', price: 5.5 },
+  { id: 'espresso', cat: 'espresso', name: 'Dark Roast Espresso', desc: 'Bold, smokey, and perfect for a morning boost.', price: 3.25 },
+  { id: 'cortado', cat: 'espresso', name: 'Cortado', desc: 'Equal parts espresso and steamed whole milk.', price: 4.25 },
+  { id: 'flat-white', cat: 'espresso', name: 'Flat White', desc: 'Ristretto shots with velvety microfoam.', price: 4.75 },
+  { id: 'cold-brew', cat: 'cold', name: 'Cold Brew', desc: 'Steeped for 18 hours for maximum smoothness.', price: 4.5 },
+  { id: 'nitro', cat: 'cold', name: 'Nitro Cold Brew', desc: 'Cold brew infused with nitrogen for a creamy pour.', price: 5.25 },
+  { id: 'croissant', cat: 'bakery', name: 'Butter Croissant', desc: 'Laminated in house every morning.', price: 3.75 },
+  { id: 'banana-bread', cat: 'bakery', name: 'Banana Walnut Bread', desc: 'Moist, toasty, and lightly sweet.', price: 3.5 },
+];
+
+const CATEGORIES = [
+  ['all', 'All'],
+  ['seasonal', 'Seasonal'],
+  ['espresso', 'Espresso'],
+  ['cold', 'Cold'],
+  ['bakery', 'Bakery'],
+];
+
+const LOCATIONS = [
+  { name: 'Downtown Roastery', address: '120 Main St', hours: '6am – 8pm', tags: 'roastery wifi seating' },
+  { name: 'Riverside Kiosk', address: '8 Harbor Walk', hours: '7am – 3pm', tags: 'walk-up' },
+  { name: 'University Commons', address: '455 College Ave', hours: '7am – 10pm', tags: 'wifi seating study' },
+  { name: 'Northgate Drive-Thru', address: '2210 N Grand Blvd', hours: '5:30am – 7pm', tags: 'drive-thru' },
+  { name: 'Old Town Café', address: '31 Mill Lane', hours: '7am – 6pm', tags: 'seating patio pastries' },
+];
+
+const REWARDS = [
+  { id: 'shot', name: 'Extra espresso shot', cost: 25 },
+  { id: 'pastry', name: 'Any bakery item', cost: 75 },
+  { id: 'drink', name: 'Any handcrafted drink', cost: 150 },
+  { id: 'beans', name: '12oz bag of whole beans', cost: 400 },
+];
+
+const money = (n) => `$${n.toFixed(2)}`;
+
+// ---------------------------------------------------------------------------
+// View renderers: run once per view; afterwards the DOM is preserved.
+// Each may return an `enter(param)` hook that runs on every activation.
+// ---------------------------------------------------------------------------
+
+function renderMenu(root) {
+  root.innerHTML = `
+    <div class="container">
+      <h1 class="page-title">Our Menu</h1>
+      <p class="page-lead">Every drink is made to order with beans roasted in-house this week.</p>
+      <div class="tabs" role="group" aria-label="Filter by category">
+        ${CATEGORIES.map(([id, label]) => `<button type="button" data-cat="${id}" aria-pressed="${id === 'all'}">${label}</button>`).join('')}
+      </div>
+      <div class="grid">
+        ${MENU.map((item) => `
+          <article class="card menu-item" id="menu-${item.id}" data-cat="${item.cat}">
+            <h3>${item.name}</h3>
+            <p>${item.desc}</p>
+            <p class="price">${money(item.price)}</p>
+            <a href="/order-online" class="btn">Order</a>
+          </article>`).join('')}
+      </div>
+    </div>`;
+
+  const buttons = root.querySelectorAll('.tabs button');
+  const items = root.querySelectorAll('.menu-item');
+
+  const setCategory = (cat) => {
+    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
+    items.forEach((el) => { el.hidden = cat !== 'all' && el.dataset.cat !== cat; });
+  };
+
+  root.querySelector('.tabs').addEventListener('click', (e) => {
+    const btn = e.target.closest('button[data-cat]');
+    if (btn) setCategory(btn.dataset.cat);
+  });
+
+  return (param) => {
+    items.forEach((el) => el.classList.remove('highlight'));
+    if (!param) return false;
+    const target = root.querySelector(`#menu-${CSS.escape(param)}`);
+    if (!target) return false;
+    if (target.hidden) setCategory('all');
+    target.classList.add('highlight');
+    return target; // router scrolls this into view
+  };
+}
+
+function renderLocations(root) {
+  root.innerHTML = `
+    <div class="container">
+      <h1 class="page-title">Find a Daily Grind</h1>
+      <p class="page-lead">Five neighborhood shops, one obsession with great coffee.</p>
+      <label class="visually-hidden" for="loc-search">Search locations</label>
+      <input id="loc-search" class="search" type="search" placeholder="Search by name, street, or feature (e.g. wifi)" autocomplete="off">
+      <p class="muted" style="text-align:center;margin-top:8px" aria-live="polite" id="loc-count"></p>
+      <div class="grid">
+        ${LOCATIONS.map((l) => `
+          <article class="card left location" data-search="${`${l.name} ${l.address} ${l.tags}`.toLowerCase()}">
+            <h3>${l.name}</h3>
+            <p>${l.address}</p>
+            <p class="muted">Open ${l.hours}</p>
+            <p class="muted">${l.tags.split(' ').join(' · ')}</p>
+          </article>`).join('')}
+      </div>
+    </div>`;
+
+  const input = root.querySelector('#loc-search');
+  const cards = root.querySelectorAll('.location');
+  const count = root.querySelector('#loc-count');
+
+  const filter = () => {
+    const q = input.value.trim().toLowerCase();
+    let shown = 0;
+    cards.forEach((c) => {
+      const match = !q || c.dataset.search.includes(q);
+      c.hidden = !match;
+      if (match) shown++;
+    });
+    count.textContent = `${shown} of ${cards.length} locations`;
+  };
+  input.addEventListener('input', filter);
+  filter();
+}
+
+function renderRewards(root) {
+  let points = 180;
+  root.innerHTML = `
+    <div class="container narrow">
+      <h1 class="page-title">Grind Rewards</h1>
+      <p class="page-lead">Earn 10 points for every dollar. Redeem them for treats on us.</p>
+      <div class="card">
+        <h3>Your balance</h3>
+        <p style="font-size:2rem;font-weight:bold" id="pts" aria-live="polite"></p>
+        <label class="muted" for="pts-meter">Progress to a free bag of beans</label>
+        <meter id="pts-meter" class="meter" min="0" max="400" low="150" high="399" optimum="400"></meter>
+      </div>
+      <div class="grid">
+        ${REWARDS.map((r) => `
+          <div class="card">
+            <h3>${r.name}</h3>
+            <p class="muted">${r.cost} points</p>
+            <button type="button" class="btn" data-reward="${r.id}" data-cost="${r.cost}">Redeem</button>
+          </div>`).join('')}
+      </div>
+      <p class="muted" id="redeem-status" role="status" style="text-align:center;margin-top:16px"></p>
+    </div>`;
+
+  const ptsEl = root.querySelector('#pts');
+  const meter = root.querySelector('#pts-meter');
+  const status = root.querySelector('#redeem-status');
+  const buttons = root.querySelectorAll('[data-reward]');
+
+  const update = () => {
+    ptsEl.textContent = `${points} pts`;
+    meter.value = Math.min(points, 400);
+    buttons.forEach((b) => { b.disabled = Number(b.dataset.cost) > points; b.style.opacity = b.disabled ? 0.5 : 1; });
+  };
+
+  root.addEventListener('click', (e) => {
+    const btn = e.target.closest('[data-reward]');
+    if (!btn || btn.disabled) return;
+    const reward = REWARDS.find((r) => r.id === btn.dataset.reward);
+    points -= reward.cost;
+    status.textContent = `Redeemed: ${reward.name}. Show this screen at the counter.`;
+    update();
+  });
+  update();
+}
+
+function renderAccount(root) {
+  root.innerHTML = `
+    <div class="container narrow">
+      <h1 class="page-title">My Account</h1>
+      <p class="page-lead">Manage your profile and how you like your coffee.</p>
+      <form class="card" id="account-form">
+        <div class="field">
+          <label for="acct-name">Name</label>
+          <input id="acct-name" name="name" autocomplete="name" value="Alex Barista">
+        </div>
+        <div class="field">
+          <label for="acct-email">Email</label>
+          <input id="acct-email" name="email" type="email" autocomplete="email" value="alex@example.com">
+        </div>
+        <div class="field">
+          <label for="acct-store">Home store</label>
+          <select id="acct-store" name="store">
+            ${LOCATIONS.map((l) => `<option>${l.name}</option>`).join('')}
+          </select>
+        </div>
+        <div class="field">
+          <label for="acct-milk">Default milk</label>
+          <select id="acct-milk" name="milk">
+            <option>Whole</option><option>Oat</option><option>Almond</option><option>Skim</option><option>None</option>
+          </select>
+        </div>
+        <button type="submit" class="btn">Save changes</button>
+        <p class="muted" role="status" id="acct-status" style="margin-top:10px"></p>
+      </form>
+    </div>`;
+
+  const form = root.querySelector('#account-form');
+  const status = root.querySelector('#acct-status');
+  form.addEventListener('input', () => { status.textContent = 'You have unsaved changes.'; });
+  form.addEventListener('submit', (e) => {
+    e.preventDefault();
+    if (!form.reportValidity()) return;
+    status.textContent = 'Saved.';
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Router
+// ---------------------------------------------------------------------------
+
+const VIEWS = {
+  home: { el: document.getElementById('view-home'), title: 'The Daily Grind | Artisanal Coffee', path: '/', rendered: true },
+  menu: { el: document.getElementById('view-menu'), title: 'Menu | The Daily Grind', path: '/menu', render: renderMenu },
+  locations: { el: document.getElementById('view-locations'), title: 'Locations | The Daily Grind', path: '/locations', render: renderLocations },
+  rewards: { el: document.getElementById('view-rewards'), title: 'Rewards | The Daily Grind', path: '/rewards', render: renderRewards },
+  account: { el: document.getElementById('view-account'), title: 'My Account | The Daily Grind', path: '/account', render: renderAccount },
+};
+
+const navLinks = document.querySelectorAll('nav a[data-spa]');
+const scrollPositions = new Map();
+let current = null;
+
+/** Map a pathname to { name, param }, or null if it isn't an SPA route. */
+function resolve(pathname) {
+  const path = pathname.replace(/\/+$/, '') || '/';
+  if (path === '/' || path === '/index.html') return { name: 'home' };
+  const [, first, second] = path.split('/');
+  if (first in VIEWS && first !== 'home') return { name: first, param: second ? decodeURIComponent(second) : null };
+  return null;
+}
+
+function activate({ name, param }, { restoreScroll, focus = true }) {
+  const view = VIEWS[name];
+
+  if (current && current !== view) scrollPositions.set(current, window.scrollY);
+
+  if (!view.rendered) {
+    view.enter = view.render(view.el) || null;
+    view.rendered = true;
+  }
+
+  for (const v of Object.values(VIEWS)) {
+    const active = v === view;
+    v.el.classList.toggle('inactive', !active);
+    v.el.toggleAttribute('inert', !active);
+    v.el.setAttribute('aria-hidden', String(!active));
+  }
+
+  navLinks.forEach((a) => {
+    const match = resolve(new URL(a.href).pathname)?.name === name;
+    if (match) a.setAttribute('aria-current', 'page');
+    else a.removeAttribute('aria-current');
+  });
+
+  document.title = view.title;
+  current = view;
+
+  const scrollTarget = view.enter ? view.enter(param) : null;
+
+  // Move focus to the new view for a logical tab order / SR announcement.
+  if (focus) view.el.focus({ preventScroll: true });
+
+  if (scrollTarget) {
+    scrollTarget.scrollIntoView({ block: 'center' });
+  } else {
+    window.scrollTo(0, restoreScroll ? (scrollPositions.get(view) ?? 0) : 0);
+  }
+}
+
+function transition(update) {
+  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  if (!document.startViewTransition || reduce) {
+    update();
+    return;
+  }
+  document.startViewTransition(update);
+}
+
+function navigate(url, { replace = false } = {}) {
+  const route = resolve(url.pathname);
+  if (!route) return false;
+  const sameEntry = url.href === location.href;
+  if (replace || sameEntry) history.replaceState(null, '', url);
+  else history.pushState(null, '', url);
+  // Fresh navigations to a cached view return to its last scroll position,
+  // matching the "pick up where you left off" behaviour of tabbed apps.
+  transition(() => activate(route, { restoreScroll: true }));
+  return true;
+}
+
+document.addEventListener('click', (e) => {
+  if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+  const a = e.target.closest('a[data-spa]');
+  if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
+  const url = new URL(a.href);
+  if (url.origin !== location.origin) return;
+  if (navigate(url)) e.preventDefault();
+});
+
+window.addEventListener('popstate', () => {
+  const route = resolve(location.pathname);
+  if (route) transition(() => activate(route, { restoreScroll: true }));
+});
+
+// We restore per-view scroll positions ourselves.
+history.scrollRestoration = 'manual';
+
+// Initial route (supports deep links when the server falls back to index.html).
+const initial = resolve(location.pathname) ?? { name: 'home' };
+activate(initial, { restoreScroll: false, focus: false });
