--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,27 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+/* ---------------------------------------------------------------------------
+ * SPA view cache (see src/scripts/view-cache.ts)
+ * Views the user has left stay in the DOM. `content-visibility: hidden` skips
+ * their layout/paint while keeping their rendering state cached, so going
+ * back to them is nearly instant.
+ * ------------------------------------------------------------------------- */
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view-inactive {
+  content-visibility: hidden;
+  /* Take hidden views out of the flow so they never affect page layout. */
+  position: absolute;
+  inset-inline: 0;
+  top: 0;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view-inactive {
+    display: none;
+  }
+}
