index 0000000..6bfba46
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,225 @@
+// Minimal homepage server for The Daily Grind.
+// No dependencies: `node server.mjs` (PORT defaults to 11222).
+//
+// Every document response carries a Connection-Allowlist header (with a CSP fallback
+// for browsers without it) limiting the page to our own origin and the Unsplash
+// image host, so an injected script cannot send customer data anywhere else.
+
+import { createServer } from 'node:http';
+import { readFile, appendFile, mkdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const DATA_DIR = path.join(ROOT, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const PORT = Number(process.env.PORT) || 11222;
+const MAX_BODY_BYTES = 10 * 1024;
+
+// ---- Outbound connection policy -------------------------------------------------
+
+// The only third-party endpoint the page may reach. Origin-only, no trailing slash,
+// so every path on the host matches.
+const ALLOWED_EXTERNAL = ['https://images.unsplash.com'];
+const REPORT_ENDPOINT_NAME = 'security-reports';
+const REPORT_ENDPOINT_PATH = '/api/security-reports';
+
+// RFC 9651 Inner List. `response-origin` = our own origin. A malformed value makes the
+// browser fail closed (block everything), so keep this format exact.
+// Redirects stay at the default `block`; same-origin 3xx responses are blocked too.
+const CONNECTION_ALLOWLIST = `(response-origin ${ALLOWED_EXTERNAL.map((u) => `"${u}"`).join(' ')}); report-to=${REPORT_ENDPOINT_NAME}`;
+
+// Fallback for browsers without Connection-Allowlist (Firefox, Safari). Supporting
+// browsers enforce both.
+const CONTENT_SECURITY_POLICY = [
+  "default-src 'self'",
+  "script-src 'self'",
+  "style-src 'self'",
+  `img-src 'self' ${ALLOWED_EXTERNAL.join(' ')}`,
+  "connect-src 'self'",
+  "font-src 'self'",
+  "form-action 'self'", // default-src does not cover form submissions
+  "worker-src 'self'", // no blob: workers that could bypass the policy
+  "frame-src 'none'",
+  "object-src 'none'",
+  "base-uri 'self'",
+  "frame-ancestors 'none'",
+  `report-to ${REPORT_ENDPOINT_NAME}`,
+].join('; ');
+
+// Browsers only honor Connection-Allowlist on these destinations.
+const POLICY_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+function setSecurityHeaders(req, res) {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.appendHeader('Vary', 'Sec-Fetch-Dest');
+
+  const dest = req.headers['sec-fetch-dest'];
+  // Missing header (older clients): treat as a document so we still send the policy.
+  if (dest && !POLICY_DESTS.has(String(dest).toLowerCase())) return;
+
+  res.setHeader('Reporting-Endpoints', `${REPORT_ENDPOINT_NAME}="${REPORT_ENDPOINT_PATH}"`);
+  res.setHeader('Connection-Allowlist', CONNECTION_ALLOWLIST);
+  res.setHeader('Content-Security-Policy', CONTENT_SECURITY_POLICY);
+}
+
+// ---- Static files (explicit allowlist, no path traversal possible) ----------------
+
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/app.js': { file: 'app.js', type: 'text/javascript; charset=utf-8' },
+};
+
+async function serveStatic(req, res, entry) {
+  const body = await readFile(path.join(ROOT, entry.file));
+  res.writeHead(200, {
+    'Content-Type': entry.type,
+    'Content-Length': body.length,
+    'Cache-Control': 'no-cache',
+  });
+  res.end(req.method === 'HEAD' ? undefined : body);
+}
+
+// ---- Helpers ----------------------------------------------------------------------
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    const chunks = [];
+    let size = 0;
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function sendJson(res, status, payload) {
+  const body = JSON.stringify(payload);
+  res.writeHead(status, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Content-Length': Buffer.byteLength(body),
+    'Cache-Control': 'no-store',
+  });
+  res.end(body);
+}
+
+const escapeHtml = (s) =>
+  String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
+
+// Plain HTML result page for the no-JavaScript form submission path. Returned with
+// 200/4xx directly (no redirect), since Connection-Allowlist blocks 3xx by default.
+function sendHtmlResult(req, res, status, message) {
+  setSecurityHeaders(req, res);
+  const body = `<!DOCTYPE html>
+<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
+<title>Newsletter | The Daily Grind</title><link rel="stylesheet" href="/styles.css"></head>
+<body><main class="container"><section class="newsletter"><h1>${escapeHtml(message)}</h1>
+<a class="btn" href="/">Back to the homepage</a></section></main></body></html>`;
+  res.writeHead(status, {
+    'Content-Type': 'text/html; charset=utf-8',
+    'Content-Length': Buffer.byteLength(body),
+    'Cache-Control': 'no-store',
+  });
+  res.end(body);
+}
+
+// Pragmatic email check; real verification happens via a confirmation email.
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+// ---- Routes -----------------------------------------------------------------------
+
+async function handleNewsletter(req, res) {
+  const contentType = String(req.headers['content-type'] || '').split(';')[0].trim().toLowerCase();
+  const wantsJson = contentType === 'application/json';
+
+  const reply = (status, message, extra = {}) =>
+    wantsJson ? sendJson(res, status, { message, ...extra }) : sendHtmlResult(req, res, status, message);
+
+  // Reject cross-site form posts (CSRF) when the browser tells us the origin.
+  const site = req.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') {
+    return reply(403, 'This request was not allowed.');
+  }
+
+  let fields;
+  try {
+    const raw = await readBody(req);
+    if (wantsJson) fields = JSON.parse(raw || '{}');
+    else if (contentType === 'application/x-www-form-urlencoded') fields = Object.fromEntries(new URLSearchParams(raw));
+    else return reply(415, 'Unsupported request format.');
+  } catch (err) {
+    if (err.status === 413) return reply(413, 'That request was too large.');
+    return reply(400, 'We could not read that request. Please try again.');
+  }
+
+  // Honeypot filled in: pretend success so bots get no signal.
+  if (fields && typeof fields.website === 'string' && fields.website.trim() !== '') {
+    return reply(200, "Thanks! You're on the list.");
+  }
+
+  const email = typeof fields?.email === 'string' ? fields.email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return reply(400, 'Please enter a valid email address, like name@example.com.', { field: 'email' });
+  }
+
+  await mkdir(DATA_DIR, { recursive: true });
+  await appendFile(SUBSCRIBERS_FILE, JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n');
+  return reply(200, "Thanks! You're on the list. Watch your inbox for our next brew.");
+}
+
+async function handleSecurityReport(req, res) {
+  try {
+    const raw = await readBody(req);
+    console.warn('[security-report]', raw);
+  } catch {
+    // Ignore malformed or oversized reports.
+  }
+  res.writeHead(204);
+  res.end();
+}
+
+const server = createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, 'http://localhost');
+
+    if (pathname === '/api/newsletter') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return sendJson(res, 405, { message: 'Method not allowed.' });
+      }
+      return await handleNewsletter(req, res);
+    }
+
+    if (pathname === REPORT_ENDPOINT_PATH && req.method === 'POST') {
+      return await handleSecurityReport(req, res);
+    }
+
+    const entry = STATIC_FILES[pathname];
+    if (entry && (req.method === 'GET' || req.method === 'HEAD')) {
+      setSecurityHeaders(req, res);
+      return await serveStatic(req, res, entry);
+    }
+
+    setSecurityHeaders(req, res);
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) sendJson(res, 500, { message: 'Something went wrong on our end. Please try again.' });
+    else res.end();
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on http://localhost:${PORT}`);
+});
