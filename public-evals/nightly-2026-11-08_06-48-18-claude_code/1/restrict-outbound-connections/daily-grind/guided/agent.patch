+// Newsletter signup. Served as an external file so the page works under a strict
+// `script-src 'self'` Content Security Policy (no inline scripts allowed).
+const form = document.getElementById('newsletter-form');
+
+if (form) {
+  const email = form.elements.namedItem('email');
+  const emailError = document.getElementById('newsletter-email-error');
+  const status = document.getElementById('newsletter-status');
+  const submit = form.querySelector('button[type="submit"]');
+
+  const MESSAGES = {
+    network:
+      "Sorry, we couldn't reach our server, so you're not subscribed yet. Check your connection and try again.",
+    server: 'Something went wrong on our end and you are not subscribed yet. Please try again in a few minutes.',
+    timeout: 'Our server took too long to respond. Please try again.',
+  };
+
+  const setStatus = (state, text) => {
+    status.dataset.state = state;
+    status.textContent = text;
+  };
+
+  const showEmailError = (text) => {
+    email.setAttribute('aria-invalid', 'true');
+    emailError.textContent = text;
+  };
+
+  const clearEmailError = () => {
+    email.removeAttribute('aria-invalid');
+    emailError.textContent = '';
+  };
+
+  const validateEmail = () => {
+    if (email.validity.valueMissing) {
+      showEmailError('Please enter your email address.');
+      return false;
+    }
+    if (!email.validity.valid) {
+      showEmailError('Please enter a valid email address, like name@example.com.');
+      return false;
+    }
+    clearEmailError();
+    return true;
+  };
+
+  // Clear errors while typing; validate once the user leaves the field.
+  email.addEventListener('input', () => {
+    if (email.getAttribute('aria-invalid') === 'true' && email.validity.valid) clearEmailError();
+  });
+  email.addEventListener('blur', () => {
+    if (email.value !== '') validateEmail();
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    setStatus('', '');
+
+    if (!validateEmail()) {
+      email.focus();
+      return;
+    }
+
+    submit.disabled = true;
+    setStatus('pending', 'Subscribing…');
+
+    try {
+      // Same-origin endpoint only. Requests elsewhere are blocked by the
+      // Connection-Allowlist / CSP headers and land in the catch below.
+      const response = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify(Object.fromEntries(new FormData(form))),
+        credentials: 'same-origin',
+        signal: AbortSignal.timeout(10000),
+      });
+
+      let data = null;
+      try {
+        data = await response.json();
+      } catch {
+        // Non-JSON response body; fall through to generic handling.
+      }
+
+      if (response.ok) {
+        setStatus('success', data?.message ?? "Thanks! You're on the list.");
+        form.reset();
+      } else if (response.status === 400 && data?.field === 'email') {
+        setStatus('error', data.message);
+        showEmailError(data.message);
+        email.focus();
+      } else {
+        setStatus('error', data?.message ?? MESSAGES.server);
+      }
+    } catch (error) {
+      // TypeError: network failure, offline, or the request was blocked by the
+      // page's connection policy (e.g. net::ERR_NETWORK_ACCESS_REVOKED).
+      const isTimeout = error instanceof DOMException && error.name === 'TimeoutError';
+      setStatus('error', isTimeout ? MESSAGES.timeout : MESSAGES.network);
+    } finally {
+      submit.disabled = false;
+    }
+  });
+}
