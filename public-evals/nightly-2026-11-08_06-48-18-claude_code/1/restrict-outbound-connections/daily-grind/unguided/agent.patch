new file mode 100644
index 0000000..8941a2d
--- /dev/null
+++ b/public/newsletter.js
@@ -0,0 +1,79 @@
+(function () {
+  'use strict';
+
+  var form = document.getElementById('newsletter-form');
+  var input = document.getElementById('newsletter-email');
+  var status = document.getElementById('newsletter-status');
+  if (!form || !input || !status) return;
+
+  var button = form.querySelector('button[type="submit"]');
+  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+  var GENERIC_ERROR =
+    "Sorry, we couldn't sign you up right now. Please check your connection and try again in a moment.";
+
+  function show(message, kind) {
+    status.textContent = message;
+    status.className = 'form-status' + (kind ? ' ' + kind : '');
+  }
+
+  // No-JS fallback redirects back with ?subscribed=1.
+  if (/[?&]subscribed=1(&|$)/.test(window.location.search)) {
+    show("Thanks! You're on the list.", 'success');
+  }
+
+  // If the Content Security Policy blocks a request (e.g. something tries to
+  // reach a host other than ours), tell the customer instead of failing silently.
+  document.addEventListener('securitypolicyviolation', function (e) {
+    if (e.effectiveDirective === 'connect-src' || e.effectiveDirective === 'form-action') {
+      show("That request couldn't go through because it was blocked for your security. Please try again.", 'error');
+    }
+  });
+
+  form.addEventListener('submit', function (event) {
+    event.preventDefault();
+
+    var email = input.value.trim();
+    if (!EMAIL_RE.test(email) || email.length > 254) {
+      show('Please enter a valid email address.', 'error');
+      input.focus();
+      return;
+    }
+
+    button.disabled = true;
+    show('Signing you up…');
+
+    var controller = typeof AbortController === 'function' ? new AbortController() : null;
+    var timer = controller ? setTimeout(function () { controller.abort(); }, 10000) : null;
+
+    fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ email: email }),
+      credentials: 'same-origin',
+      signal: controller ? controller.signal : undefined
+    })
+      .then(function (res) {
+        return res.json().catch(function () { return {}; }).then(function (data) {
+          if (!res.ok) {
+            throw new Error(data && data.error ? data.error : GENERIC_ERROR);
+          }
+          return data;
+        });
+      })
+      .then(function (data) {
+        show((data && data.message) || "Thanks! You're on the list.", 'success');
+        form.reset();
+      })
+      .catch(function (err) {
+        // Network failure, timeout, CSP block (TypeError) or server-side error.
+        var msg = err && err.name !== 'TypeError' && err.name !== 'AbortError' && err.message
+          ? err.message
+          : GENERIC_ERROR;
+        show(msg, 'error');
+      })
+      .then(function () {
+        if (timer) clearTimeout(timer);
+        button.disabled = false;
+      });
+  });
+})();
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000..55cc032
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,217 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Newsletter */
+.newsletter {
+  background: white;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  padding: 30px 20px;
+  margin-top: 40px;
+  text-align: center;
+}
+
+.newsletter h2 {
+  color: var(--primary);
+  margin-bottom: 5px;
+}
+
+.newsletter-form {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 10px;
+  margin-top: 15px;
+}
+
+.newsletter-form input[type="email"] {
+  flex: 1 1 260px;
+  max-width: 360px;
+  padding: 10px 12px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+  font: inherit;
+}
+
+.newsletter-form button {
+  margin-top: 0;
+  border: none;
+  cursor: pointer;
+  font: inherit;
+}
+
+.newsletter-form button:disabled {
+  opacity: 0.6;
+  cursor: wait;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.form-status {
+  min-height: 1.6em;
+  margin-top: 12px;
+  font-size: 0.95rem;
+}
+
+.form-status.success {
+  color: #2e7d32;
+}
+
+.form-status.error {
+  color: #c62828;
+}
diff --git a/server.js b/server.js
new file mode 100644
index 0000000..2639688
--- /dev/null
+++ b/server.js
@@ -0,0 +1,196 @@
+'use strict';
+
+const http = require('node:http');
+const fs = require('node:fs');
+const fsp = require('node:fs/promises');
+const path = require('node:path');
+
+const PORT = Number(process.env.PORT) || 11222;
+const HOST = process.env.HOST || '0.0.0.0';
+const PUBLIC_DIR = path.join(__dirname, 'public');
+const DATA_DIR = path.join(__dirname, 'data');
+const SUBSCRIBERS_FILE = path.join(DATA_DIR, 'subscribers.jsonl');
+const MAX_BODY_BYTES = 4 * 1024;
+
+// The page may only talk to this server ('self') and load photos from Unsplash.
+// No inline scripts/styles are allowed, so an injected <script> or handler can't
+// run, and even if one did, connect-src/form-action/img-src stop it from sending
+// data to any other host.
+const CSP = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "font-src 'self'",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "manifest-src 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-src 'none'",
+  "worker-src 'none'",
+  "frame-ancestors 'none'",
+].join('; ');
+
+const SECURITY_HEADERS = {
+  'Content-Security-Policy': CSP,
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'no-referrer',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=()',
+};
+
+// Explicit allowlist of static files: no directory traversal possible.
+const STATIC_FILES = {
+  '/': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/index.html': { file: 'index.html', type: 'text/html; charset=utf-8' },
+  '/styles.css': { file: 'styles.css', type: 'text/css; charset=utf-8' },
+  '/newsletter.js': { file: 'newsletter.js', type: 'text/javascript; charset=utf-8' },
+};
+
+const EMAIL_RE = /^[^\s@<>"']+@[^\s@<>"']+\.[^\s@<>"']+$/;
+
+function send(res, status, body, headers = {}) {
+  res.writeHead(status, { ...SECURITY_HEADERS, ...headers });
+  res.end(body);
+}
+
+function sendJson(res, status, obj) {
+  send(res, status, JSON.stringify(obj), {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Cache-Control': 'no-store',
+  });
+}
+
+function wantsJson(req) {
+  return (req.headers['content-type'] || '').startsWith('application/json');
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+// Reject cross-site submissions: browsers always send Origin on POST.
+function isSameOrigin(req) {
+  const origin = req.headers.origin;
+  if (!origin) return true; // non-browser clients (curl, server-to-server)
+  try {
+    return new URL(origin).host === req.headers.host;
+  } catch {
+    return false;
+  }
+}
+
+async function handleNewsletter(req, res) {
+  const json = wantsJson(req);
+  const fail = (status, error) =>
+    json
+      ? sendJson(res, status, { error })
+      : send(res, status, error, { 'Content-Type': 'text/plain; charset=utf-8' });
+
+  if (!isSameOrigin(req)) return fail(403, 'Request not allowed.');
+
+  let email;
+  try {
+    const raw = await readBody(req);
+    if (json) {
+      email = JSON.parse(raw).email;
+    } else {
+      email = new URLSearchParams(raw).get('email');
+    }
+  } catch (err) {
+    return fail(err.status || 400, err.status === 413 ? 'Request too large.' : 'Invalid request.');
+  }
+
+  email = typeof email === 'string' ? email.trim().toLowerCase() : '';
+  if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
+    return fail(400, 'Please enter a valid email address.');
+  }
+
+  try {
+    await fsp.mkdir(DATA_DIR, { recursive: true });
+    await fsp.appendFile(
+      SUBSCRIBERS_FILE,
+      JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n',
+      { mode: 0o600 }
+    );
+  } catch (err) {
+    console.error('Failed to save subscriber:', err);
+    return fail(500, "Sorry, we couldn't sign you up right now. Please try again later.");
+  }
+
+  const message = "Thanks! You're on the list.";
+  if (json) return sendJson(res, 201, { message });
+  // No-JS fallback: plain form POST, then send them back to the homepage.
+  return send(res, 303, '', { Location: '/?subscribed=1' });
+}
+
+function serveStatic(req, res, pathname) {
+  const entry = STATIC_FILES[pathname];
+  if (!entry) {
+    return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  const filePath = path.join(PUBLIC_DIR, entry.file);
+  fs.stat(filePath, (err, stat) => {
+    if (err) {
+      return send(res, 404, 'Not found', { 'Content-Type': 'text/plain; charset=utf-8' });
+    }
+    res.writeHead(200, {
+      ...SECURITY_HEADERS,
+      'Content-Type': entry.type,
+      'Content-Length': stat.size,
+      'Cache-Control': entry.file === 'index.html' ? 'no-cache' : 'public, max-age=3600',
+    });
+    if (req.method === 'HEAD') return res.end();
+    fs.createReadStream(filePath).pipe(res);
+  });
+}
+
+const server = http.createServer((req, res) => {
+  let pathname;
+  try {
+    pathname = new URL(req.url, 'http://localhost').pathname;
+  } catch {
+    return send(res, 400, 'Bad request', { 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+
+  if (pathname === '/api/newsletter') {
+    if (req.method !== 'POST') {
+      return send(res, 405, 'Method not allowed', { Allow: 'POST', 'Content-Type': 'text/plain; charset=utf-8' });
+    }
+    handleNewsletter(req, res).catch((err) => {
+      console.error(err);
+      if (!res.headersSent) sendJson(res, 500, { error: 'Something went wrong.' });
+    });
+    return;
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    return send(res, 405, 'Method not allowed', { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+  }
+  serveStatic(req, res, pathname);
+});
+
+if (require.main === module) {
+  server.listen(PORT, HOST, () => {
+    console.log(`Daily Grind listening on http://${HOST}:${PORT}`);
+  });
+}
+
+module.exports = { server, CSP };
