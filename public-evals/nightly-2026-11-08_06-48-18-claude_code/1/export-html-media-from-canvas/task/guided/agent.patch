+  <script>
+    (() => {
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const card = document.getElementById('export_element');
+      const form = document.getElementById('gift_form');
+      const nameInput = document.getElementById('gift_name');
+      const messageInput = document.getElementById('gift_message');
+      const customColor = document.getElementById('gift_custom_color');
+      const nameOut = document.getElementById('gc_name');
+      const messageOut = document.getElementById('gc_message');
+      const exportBtn = document.getElementById('gift_export');
+
+      const CARD_W = 600;
+      const CARD_H = 340;
+      const FONT = "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif";
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function';
+
+      const state = { name: 'For You', message: 'Enjoy a cup on me!', bg: '#4e342e', ink: '#fff8e1' };
+
+      // Pick light or dark text depending on background luminance.
+      function inkFor(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const [r, g, b] = [n >> 16, (n >> 8) & 255, n & 255].map((c) => {
+          c /= 255;
+          return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+        });
+        const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+        return lum > 0.4 ? '#3e2723' : '#fff8e1';
+      }
+
+      function update() {
+        state.name = nameInput.value.trim() || 'For You';
+        state.message = messageInput.value.trim() || 'Enjoy a cup on me!';
+        const checked = form.querySelector('input[name="color"]:checked');
+        state.bg = checked ? checked.value : customColor.value;
+        state.ink = inkFor(state.bg);
+
+        nameOut.textContent = state.name;
+        messageOut.textContent = state.message;
+        card.style.setProperty('--card-bg', state.bg);
+        card.style.setProperty('--card-ink', state.ink);
+        canvas.setAttribute('aria-label', `Gift card preview: ${state.name}. ${state.message}`);
+
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint?.();
+        } else {
+          drawFallback();
+        }
+      }
+
+      // --- Native path: HTML-in-Canvas renders the real #export_element ---
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = () => {
+          ctx.reset();
+          ctx.drawElementImage(card, 0, 0, canvas.width, canvas.height);
+        };
+      }
+
+      // --- Fallback path: redraw the same design with the 2D API ---
+      function wrapLines(text, maxWidth, maxLines) {
+        const words = text.split(/\s+/);
+        const lines = [];
+        let line = '';
+        for (const word of words) {
+          const test = line ? `${line} ${word}` : word;
+          if (ctx.measureText(test).width <= maxWidth || !line) {
+            line = test;
+          } else {
+            lines.push(line);
+            line = word;
+          }
+        }
+        if (line) lines.push(line);
+        if (lines.length > maxLines) {
+          lines.length = maxLines;
+          let last = lines[maxLines - 1];
+          while (last && ctx.measureText(`${last}…`).width > maxWidth) last = last.slice(0, -1);
+          lines[maxLines - 1] = `${last}…`;
+        }
+        // Hard-break single words that are still too long.
+        return lines.map((l) => {
+          while (ctx.measureText(l).width > maxWidth && l.length > 1) l = l.slice(0, -2) + '…';
+          return l;
+        });
+      }
+
+      function drawFallback() {
+        const s = canvas.width / CARD_W;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.scale(s, canvas.height / CARD_H);
+
+        // Rounded card background
+        ctx.save();
+        ctx.beginPath();
+        ctx.roundRect(0, 0, CARD_W, CARD_H, 18);
+        ctx.clip();
+        ctx.fillStyle = state.bg;
+        ctx.fillRect(0, 0, CARD_W, CARD_H);
+        ctx.fillStyle = 'rgb(255 255 255 / 0.22)';
+        ctx.beginPath();
+        ctx.arc(CARD_W * 1.05, CARD_H * -0.1, 120, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.fillStyle = 'rgb(255 255 255 / 0.12)';
+        ctx.beginPath();
+        ctx.arc(CARD_W * 0.92, CARD_H * 1.15, 90, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.restore();
+
+        const padX = 36;
+        const innerW = CARD_W - padX * 2;
+        ctx.textBaseline = 'alphabetic';
+        ctx.fillStyle = state.ink;
+
+        // Top row
+        ctx.font = `700 14px ${FONT}`;
+        ctx.letterSpacing = '3px';
+        ctx.fillText('THE DAILY GRIND', padX, 52);
+        ctx.letterSpacing = '0px';
+        ctx.font = `34px ${FONT}`;
+        ctx.textAlign = 'right';
+        ctx.fillText('☕', CARD_W - padX, 58);
+        ctx.textAlign = 'left';
+
+        // Label, name, message
+        let y = 140;
+        ctx.font = `700 13px ${FONT}`;
+        ctx.letterSpacing = '2px';
+        ctx.fillStyle = '#ffab40';
+        ctx.fillText('GIFT CARD', padX, y);
+        ctx.letterSpacing = '0px';
+
+        ctx.fillStyle = state.ink;
+        ctx.font = `700 34px ${FONT}`;
+        const nameLines = wrapLines(state.name, innerW, 1);
+        y += 40;
+        ctx.fillText(nameLines[0], padX, y);
+
+        ctx.font = `italic 18px ${FONT}`;
+        y += 12;
+        for (const line of wrapLines(state.message, innerW, 3)) {
+          y += 25;
+          ctx.fillText(line, padX, y);
+        }
+
+        // Bottom line
+        ctx.globalAlpha = 0.85;
+        ctx.font = `12px ${FONT}`;
+        ctx.letterSpacing = '1px';
+        ctx.fillText('Ethically sourced · Locally roasted · Delivered to your cup', padX, CARD_H - 32);
+        ctx.letterSpacing = '0px';
+        ctx.globalAlpha = 1;
+      }
+
+      // Keep the canvas backing store matched to device pixels for a crisp export.
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        const w = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        const h = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        // Never export smaller than the card's design size.
+        const scale = Math.max(1, CARD_W / w);
+        canvas.width = Math.round(w * scale);
+        canvas.height = Math.round(h * scale);
+        if (supportsHtmlInCanvas) canvas.requestPaint?.();
+        else drawFallback();
+      });
+      const supportsDpcBox = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      observer.observe(canvas, supportsDpcBox ? { box: 'device-pixel-content-box' } : {});
+
+      form.addEventListener('input', (e) => {
+        // Choosing a custom color deselects the preset swatches.
+        if (e.target === customColor) {
+          form.querySelectorAll('input[name="color"]').forEach((r) => { r.checked = false; });
+        }
+        update();
+      });
+      customColor.addEventListener('click', () => {
+        form.querySelectorAll('input[name="color"]').forEach((r) => { r.checked = false; });
+        update();
+      });
+      form.addEventListener('submit', (e) => e.preventDefault());
+
+      exportBtn.addEventListener('click', () => {
+        canvas.toBlob((blob) => {
+          if (!blob) return;
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          const slug = state.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'gift';
+          link.download = `daily-grind-gift-card-${slug}.png`;
+          link.href = url;
+          document.body.append(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 1000);
+        }, 'image/png');
+      });
+
+      if (document.fonts?.ready) document.fonts.ready.then(update); else update();
+      update();
+    })();
+  </script>
 </body>
 
