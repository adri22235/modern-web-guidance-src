+  <script>
+    (function () {
+      const card = document.getElementById('export_element');
+      const canvas = document.getElementById('gift_canvas');
+      const ctx = canvas.getContext('2d');
+      const SCALE = 3; // export resolution multiplier
+
+      const nameInput = document.getElementById('gc_name_input');
+      const messageInput = document.getElementById('gc_message_input');
+      const fromInput = document.getElementById('gc_from_input');
+      const amountInput = document.getElementById('gc_amount_input');
+      const customColor = document.getElementById('gc_custom_color');
+      const messageCount = document.getElementById('gc_message_count');
+      const exportBtn = document.getElementById('gc_export_btn');
+
+      const out = {
+        name: document.getElementById('gc_name'),
+        message: document.getElementById('gc_message'),
+        from: document.getElementById('gc_from'),
+        amount: document.getElementById('gc_amount')
+      };
+
+      function luminance(hex) {
+        const n = parseInt(hex.slice(1), 16);
+        const ch = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map(v => {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
+      }
+
+      function setBackground(hex) {
+        const light = luminance(hex) > 0.4;
+        card.style.setProperty('--card-bg', hex);
+        card.style.setProperty('--card-fg', light ? '#3e2723' : '#fff8f0');
+        card.style.setProperty('--card-accent', light ? '#8a3c00' : '#ffab40');
+      }
+
+      function syncCard() {
+        const name = nameInput.value.trim();
+        const msg = messageInput.value.trim();
+        const from = fromInput.value.trim();
+        out.name.textContent = name ? 'For ' + name : 'A Gift For You';
+        out.message.textContent = msg;
+        out.message.style.display = msg ? '' : 'none';
+        out.from.textContent = from ? '— From ' + from : '';
+        out.from.style.display = from ? '' : 'none';
+        out.amount.textContent = amountInput.value;
+        messageCount.textContent = messageInput.value.length + ' / ' + messageInput.maxLength;
+        scheduleRender();
+      }
+
+      // --- Canvas rendering of the HTML card's elements ---
+
+      function roundRectPath(c, x, y, w, h, r) {
+        r = Math.min(r, w / 2, h / 2);
+        c.beginPath();
+        c.moveTo(x + r, y);
+        c.arcTo(x + w, y, x + w, y + h, r);
+        c.arcTo(x + w, y + h, x, y + h, r);
+        c.arcTo(x, y + h, x, y, r);
+        c.arcTo(x, y, x + w, y, r);
+        c.closePath();
+      }
+
+      function wrapLines(c, text, maxWidth, letterSpacing) {
+        const measure = s => c.measureText(s).width + letterSpacing * s.length;
+        const lines = [];
+        text.split('\n').forEach(paragraph => {
+          const words = paragraph.split(/\s+/).filter(Boolean);
+          let line = '';
+          words.forEach(word => {
+            const test = line ? line + ' ' + word : word;
+            if (measure(test) <= maxWidth || !line) {
+              line = test;
+            } else {
+              lines.push(line);
+              line = word;
+            }
+            // Break single words that are wider than the box
+            while (measure(line) > maxWidth && line.length > 1) {
+              let i = line.length - 1;
+              while (i > 1 && measure(line.slice(0, i)) > maxWidth) i--;
+              lines.push(line.slice(0, i));
+              line = line.slice(i);
+            }
+          });
+          if (line) lines.push(line);
+        });
+        return lines;
+      }
+
+      function render() {
+        const cardRect = card.getBoundingClientRect();
+        const W = cardRect.width;
+        const H = cardRect.height;
+        if (!W || !H) return;
+
+        canvas.width = Math.round(W * SCALE);
+        canvas.height = Math.round(H * SCALE);
+        ctx.setTransform(SCALE, 0, 0, SCALE, 0, 0);
+        ctx.clearRect(0, 0, W, H);
+
+        const cardStyle = getComputedStyle(card);
+        const radius = parseFloat(cardStyle.borderTopLeftRadius) || 0;
+
+        // Card background (clipped to rounded corners)
+        ctx.save();
+        roundRectPath(ctx, 0, 0, W, H, radius);
+        ctx.clip();
+        ctx.fillStyle = cardStyle.backgroundColor;
+        ctx.fillRect(0, 0, W, H);
+
+        // Decorative circles
+        card.querySelectorAll('.gc-circle').forEach(el => {
+          const r = el.getBoundingClientRect();
+          const s = getComputedStyle(el);
+          ctx.globalAlpha = parseFloat(s.opacity);
+          ctx.fillStyle = s.backgroundColor;
+          ctx.beginPath();
+          ctx.arc(r.left - cardRect.left + r.width / 2, r.top - cardRect.top + r.height / 2,
+            r.width / 2, 0, Math.PI * 2);
+          ctx.fill();
+        });
+        ctx.globalAlpha = 1;
+
+        // Text elements
+        card.querySelectorAll('[data-render]').forEach(el => {
+          if (!el.textContent.trim() || el.offsetParent === null) return;
+          const r = el.getBoundingClientRect();
+          const s = getComputedStyle(el);
+          const x = r.left - cardRect.left + parseFloat(s.paddingLeft);
+          const y = r.top - cardRect.top + parseFloat(s.paddingTop);
+          const width = r.width - parseFloat(s.paddingLeft) - parseFloat(s.paddingRight);
+          const fontSize = parseFloat(s.fontSize);
+          const lineHeight = s.lineHeight === 'normal' ? fontSize * 1.2 : parseFloat(s.lineHeight);
+          const letterSpacing = s.letterSpacing === 'normal' ? 0 : parseFloat(s.letterSpacing) || 0;
+          let text = el.textContent.replace(/\s+/g, ' ').trim();
+          if (s.textTransform === 'uppercase') text = text.toUpperCase();
+
+          ctx.font = [s.fontStyle, s.fontWeight, fontSize + 'px', s.fontFamily].join(' ');
+          ctx.fillStyle = s.color;
+          ctx.globalAlpha = parseFloat(s.opacity);
+          ctx.textBaseline = 'middle';
+          ctx.textAlign = 'left';
+          if ('letterSpacing' in ctx) ctx.letterSpacing = letterSpacing + 'px';
+
+          const spacingForMeasure = 'letterSpacing' in ctx ? 0 : letterSpacing;
+          const lines = wrapLines(ctx, text, width + 1, spacingForMeasure);
+          lines.forEach((line, i) => {
+            ctx.fillText(line, x, y + lineHeight * i + lineHeight / 2);
+          });
+        });
+        ctx.globalAlpha = 1;
+        if ('letterSpacing' in ctx) ctx.letterSpacing = '0px';
+        ctx.restore();
+      }
+
+      let frame = null;
+      function scheduleRender() {
+        if (frame) cancelAnimationFrame(frame);
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          render();
+        });
+      }
+
+      function exportImage() {
+        render();
+        exportBtn.disabled = true;
+        const safeName = (nameInput.value.trim() || 'gift-card')
+          .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'gift-card';
+        const filename = 'daily-grind-' + safeName + '.png';
+        const finish = url => {
+          const a = document.createElement('a');
+          a.href = url;
+          a.download = filename;
+          document.body.appendChild(a);
+          a.click();
+          a.remove();
+          exportBtn.disabled = false;
+        };
+        if (canvas.toBlob) {
+          canvas.toBlob(blob => {
+            if (!blob) { finish(canvas.toDataURL('image/png')); return; }
+            const url = URL.createObjectURL(blob);
+            finish(url);
+            setTimeout(() => URL.revokeObjectURL(url), 1000);
+          }, 'image/png');
+        } else {
+          finish(canvas.toDataURL('image/png'));
+        }
+      }
+
+      // --- Events ---
+      [nameInput, messageInput, fromInput].forEach(el => el.addEventListener('input', syncCard));
+      amountInput.addEventListener('change', syncCard);
+
+      document.querySelectorAll('input[name="gc_bg"]').forEach(radio => {
+        radio.addEventListener('change', () => {
+          if (radio.checked) {
+            setBackground(radio.value);
+            customColor.value = radio.value;
+            scheduleRender();
+          }
+        });
+      });
+
+      customColor.addEventListener('input', () => {
+        document.querySelectorAll('input[name="gc_bg"]').forEach(r => { r.checked = false; });
+        setBackground(customColor.value);
+        scheduleRender();
+      });
+
+      exportBtn.addEventListener('click', exportImage);
+      window.addEventListener('resize', scheduleRender);
+      if (window.ResizeObserver) new ResizeObserver(scheduleRender).observe(card);
+      // Re-render after the CSS background transition finishes so colors match
+      card.addEventListener('transitionend', scheduleRender);
+
+      setBackground(document.querySelector('input[name="gc_bg"]:checked').value);
+      syncCard();
+      if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleRender);
+    })();
+  </script>
+
 </body>
 
