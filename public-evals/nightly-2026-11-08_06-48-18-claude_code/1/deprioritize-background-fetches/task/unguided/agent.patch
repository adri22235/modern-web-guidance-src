diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Load</title>
+</head>
+<body>
+<button id="go" type="button">Load</button>
+<pre id="out"></pre>
+<script>
+const out = document.getElementById('out');
+
+document.getElementById('go').addEventListener('click', () => {
+  // Mission-critical: ask the browser to prioritize this request.
+  const data = fetch('/api/data', { priority: 'high' })
+    .then(r => {
+      if (!r.ok) throw new Error('HTTP ' + r.status);
+      return r.text();
+    })
+    .then(t => { out.textContent = t; })
+    .catch(e => { out.textContent = 'Error: ' + e.message; });
+
+  // Analytics: low priority, survives page unload, failures ignored.
+  const analytics = fetch('/api/analytics', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ click: 1 }),
+    priority: 'low',
+    keepalive: true
+  }).catch(() => {});
+
+  // Both requests start immediately and run concurrently.
+  Promise.allSettled([data, analytics]);
+});
+</script>
+</body>
+</html>
