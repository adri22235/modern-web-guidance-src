   </footer>
 
+  <script>
+    // Give each card in a grid its position index so the CSS can stagger the animation
+    document.querySelectorAll('.grid').forEach(grid => {
+      grid.querySelectorAll(':scope > .card').forEach((card, i) => {
+        card.style.setProperty('--i', i);
+      });
+    });
+  </script>
