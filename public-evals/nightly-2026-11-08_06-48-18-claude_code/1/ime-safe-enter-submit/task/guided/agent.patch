+  <section class="container feedback" aria-labelledby="feedback-heading">
+    <h2 id="feedback-heading">Send Us Feedback</h2>
+    <form id="feedback-form" action="/feedback" method="POST">
+      <label for="feedback-message">Your feedback <span aria-hidden="true">*</span></label>
+      <p id="feedback-hint" class="hint">Press Enter to send, Shift+Enter for a new line.</p>
+      <textarea id="feedback-message" name="message" required maxlength="2000"
+        aria-describedby="feedback-hint" enterkeyhint="send"></textarea>
+      <button type="submit" class="btn">Send</button>
+      <p id="feedback-status" class="feedback-status" role="status"></p>
+    </form>
+  </section>
