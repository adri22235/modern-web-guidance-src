diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,79 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Mixed Fonts &amp; Independent Theme</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+    }
+
+    body {
+      margin: 0;
+      padding: 2rem;
+      font-family: system-ui, sans-serif;
+      line-height: 1.5;
+      max-width: 65ch;
+      margin-inline: auto;
+    }
+
+    /* Mixed fonts: inline code inherits the x-height ratio of the primary font,
+       so the monospace text appears the same visual size as the body text. */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", serif;
+      font-size: 1.125rem;
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: ui-monospace, "Cascadia Code", Menlo, Consolas, monospace;
+      /* Reset UA monospace shrinking so font-size-adjust alone does the normalization */
+      font-size: inherit;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in srgb, currentColor 10%, transparent);
+    }
+
+    /* Independent theme: not nested under the primary font, so lock in an explicit
+       x-height aspect ratio instead of deriving it from a parent font. */
+    #independent-theme-container {
+      font-family: "Courier New", Courier, monospace;
+      font-size-adjust: 0.5;
+      margin-block-start: 2rem;
+      padding: 1rem 1.25rem;
+      border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
+      border-radius: 0.5rem;
+    }
+
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container code {
+        /* Monospace faces typically render larger; nudge them down manually */
+        font-size: 0.9em;
+      }
+    }
+
+    @supports not (font-size-adjust: 0.5) {
+      #independent-theme-container {
+        /* Courier New has a small x-height (~0.42); compensate manually */
+        font-size: 1.15rem;
+        line-height: 1.6;
+      }
+    }
+  </style>
+</head>
+<body>
+  <p id="mixed-fonts-container">
+    To install dependencies, run <code>pnpm install</code> in your project folder,
+    then call <code>fetch()</code> to load data. The inline code keeps the same
+    visual height as the surrounding serif text.
+  </p>
+
+  <div id="independent-theme-container">
+    <p>
+      This independent theme uses its own font family, with its proportions locked
+      to a fixed x-height aspect ratio of 0.5.
+    </p>
+  </div>
+</body>
+</html>
