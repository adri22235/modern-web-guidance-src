diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,84 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Mixed Fonts &amp; font-size-adjust</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+      font-family: Georgia, "Times New Roman", serif;
+      line-height: 1.6;
+    }
+
+    body {
+      max-width: 42rem;
+      margin: 3rem auto;
+      padding: 0 1.25rem;
+    }
+
+    /*
+     * Mixed fonts: serif body text + monospace inline code.
+     * `font-size-adjust: from-font` reads the x-height/font-size ratio of the
+     * primary font and scales every fallback/child font (incl. <code>) so their
+     * x-heights match. The value is inherited, so <code> picks it up as well.
+     */
+    #mixed-fonts-container {
+      font-size: 1.25rem;
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, ui-monospace, monospace;
+      /* Undo the UA's shrinking of monospace text so adjustment alone governs size */
+      font-size: inherit;
+      padding: 0.1em 0.3em;
+      border-radius: 0.25em;
+      background: color-mix(in srgb, currentColor 10%, transparent);
+    }
+
+    /*
+     * Independent theme: does not inherit the page's adjustment. Instead it locks
+     * a specific numeric aspect value (x-height = 0.5 × font-size) so its text
+     * proportions stay fixed regardless of which fonts actually load.
+     */
+    #independent-theme-container {
+      font-family: Verdana, "Trebuchet MS", system-ui, sans-serif;
+      font-size-adjust: ex-height 0.5;
+
+      /* Lock the container box's own proportions as well */
+      aspect-ratio: 16 / 9;
+      display: grid;
+      place-content: center;
+      gap: 0.5rem;
+      margin-top: 2rem;
+      padding: 1.5rem;
+      border-radius: 0.75rem;
+      background: #1e293b;
+      color: #f1f5f9;
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Courier, ui-monospace, monospace;
+      font-size: inherit;
+    }
+  </style>
+</head>
+<body>
+  <h1>Normalizing mixed fonts</h1>
+
+  <p id="mixed-fonts-container">
+    This sentence uses a serif typeface, while inline code like
+    <code>font-size-adjust: from-font</code> uses a monospace face. Thanks to
+    <code>font-size-adjust</code>, both share the same visual x-height.
+  </p>
+
+  <div id="independent-theme-container">
+    <strong>Independent theme</strong>
+    <span>
+      Locked at <code>font-size-adjust: ex-height 0.5</code> — proportions stay
+      the same no matter which font is rendered.
+    </span>
+  </div>
+</body>
+</html>
