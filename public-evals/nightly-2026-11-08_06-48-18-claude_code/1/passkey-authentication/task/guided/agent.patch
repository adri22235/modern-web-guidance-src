+  <script type="module">
+    // Fills in getClientCapabilities / parseRequestOptionsFromJSON / toJSON where missing.
+    import 'https://esm.sh/webauthn-polyfills';
+
+    const OPTIONS_ENDPOINT = '/api/login/options';
+    const VERIFY_ENDPOINT = '/api/login/verify';
+
+    const statusEl = document.getElementById('auth-status');
+    const passkeyButton = document.getElementById('passkey-button');
+
+    let autofillAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.className = `auth-status ${state}`.trim();
+    }
+
+    async function fetchLoginOptions() {
+      const res = await fetch(OPTIONS_ENDPOINT, {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+      });
+      if (!res.ok) throw new Error(`Failed to load passkey options (${res.status})`);
+      return PublicKeyCredential.parseRequestOptionsFromJSON(await res.json());
+    }
+
+    async function verifyCredential(credential, publicKey) {
+      const encoded = credential.toJSON();
+      let response;
+      try {
+        response = await fetch(VERIFY_ENDPOINT, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+      } catch (err) {
+        console.error('Verification request error:', err);
+        setStatus('Could not reach the server. Please try again.', 'error');
+        return false;
+      }
+
+      if (response.ok) {
+        let username = '';
+        try {
+          const data = await response.json();
+          username = data?.username ?? data?.user?.name ?? '';
+        } catch { /* body is optional */ }
+        setStatus(username ? `Signed in as ${username}.` : 'Signed in successfully.', 'success');
+        return true;
+      }
+
+      if (response.status === 404) {
+        setStatus('This passkey is no longer registered. Please use another sign-in method.', 'error');
+        // Unauthenticated + credential unknown to server: let the passkey provider drop it.
+        if (PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          } catch (err) {
+            console.warn('signalUnknownCredential failed:', err);
+          }
+        }
+      } else {
+        setStatus('Passkey sign-in failed. Please try again.', 'error');
+      }
+      return false;
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential) return;
+
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch {
+        return;
+      }
+      if (capabilities?.conditionalGet !== true) return;
+
+      try {
+        const publicKey = await fetchLoginOptions();
+        // Registers passkeys as autofill suggestions on the username field; no modal.
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: 'conditional',
+          signal: autofillAbortController.signal,
+        });
+        const ok = await verifyCredential(credential, publicKey);
+        if (!ok) initializeConditionalAutofill();
+      } catch (err) {
+        if (err.name === 'NotAllowedError' || err.name === 'AbortError') return;
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    async function signInWithPasskey() {
+      if (!window.PublicKeyCredential) {
+        setStatus('Passkeys are not supported in this browser.', 'error');
+        return;
+      }
+
+      // Cancel the pending autofill request so the explicit prompt can show.
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      passkeyButton.disabled = true;
+      setStatus('Waiting for your passkey…');
+
+      let publicKey;
+      let credential;
+      try {
+        publicKey = await fetchLoginOptions();
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          setStatus('Passkey sign-in was cancelled.');
+        } else if (err.name === 'AbortError') {
+          setStatus('');
+        } else {
+          console.error('Passkey sign-in error:', err);
+          setStatus('Passkey sign-in failed. Please try again.', 'error');
+        }
+        passkeyButton.disabled = false;
+        // Re-arm autofill suggestions after a cancelled explicit prompt.
+        initializeConditionalAutofill();
+        return;
+      }
+
+      const ok = await verifyCredential(credential, publicKey);
+      passkeyButton.disabled = false;
+      if (!ok) initializeConditionalAutofill();
+    }
+
+    passkeyButton.addEventListener('click', signInWithPasskey);
+    initializeConditionalAutofill();
+  </script>
+
 </body>
 
