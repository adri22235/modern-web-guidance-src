   </footer>
 
+  <script>
+    (() => {
+      'use strict';
+
+      // Assumption: the server issues a fresh WebAuthn challenge here
+      // (PublicKeyCredentialRequestOptions in JSON form, base64url-encoded binaries).
+      const OPTIONS_URL = '/api/login/options';
+      const VERIFY_URL = '/api/login/verify';
+
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+
+      // Controller for the pending conditional-UI (autofill) request, if any.
+      let conditionalController = null;
+      let busy = false;
+
+      // ---------- helpers ----------
+
+      function setStatus(message, type) {
+        statusEl.textContent = message;
+        statusEl.classList.remove('success', 'error');
+        if (type) statusEl.classList.add(type);
+      }
+
+      function b64urlToBuffer(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+        return bytes.buffer;
+      }
+
+      function bufferToB64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function parseRequestOptions(json) {
+        // Accept either { publicKey: {...} } or the bare options object.
+        const opts = json && json.publicKey ? json.publicKey : json;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(opts);
+        }
+        return {
+          ...opts,
+          challenge: b64urlToBuffer(opts.challenge),
+          allowCredentials: (opts.allowCredentials || []).map((c) => ({
+            ...c,
+            id: b64urlToBuffer(c.id),
+          })),
+        };
+      }
+
+      function credentialToJSON(credential) {
+        if (typeof credential.toJSON === 'function') {
+          try { return credential.toJSON(); } catch (_) { /* fall through */ }
+        }
+        const r = credential.response;
+        return {
+          id: credential.id,
+          rawId: bufferToB64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: bufferToB64url(r.clientDataJSON),
+            authenticatorData: bufferToB64url(r.authenticatorData),
+            signature: bufferToB64url(r.signature),
+            userHandle: r.userHandle ? bufferToB64url(r.userHandle) : null,
+          },
+        };
+      }
+
+      async function fetchRequestOptions() {
+        const res = await fetch(OPTIONS_URL, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify({}),
+        });
+        if (!res.ok) throw new Error(`Could not start sign-in (${res.status}).`);
+        return parseRequestOptions(await res.json());
+      }
+
+      async function verifyCredential(credential) {
+        const res = await fetch(VERIFY_URL, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(credentialToJSON(credential)),
+        });
+        let data = {};
+        try { data = await res.json(); } catch (_) { /* empty body is fine */ }
+        if (!res.ok || data.verified === false || data.success === false) {
+          throw new Error(data.error || data.message || 'Passkey verification failed.');
+        }
+        return data;
+      }
+
+      function onSignedIn(data, credential) {
+        const name = (data && (data.username || (data.user && (data.user.name || data.user.username))))
+          || usernameField.value.trim();
+        setStatus(name ? `Signed in as ${name}.` : 'Signed in successfully.', 'success');
+        usernameField.disabled = true;
+        authButton.disabled = true;
+        document.dispatchEvent(new CustomEvent('passkey:signed-in', { detail: { data, credentialId: credential.id } }));
+      }
+
+      function isAbort(err) {
+        return err && (err.name === 'AbortError' || err === 'conditional-aborted');
+      }
+
+      // ---------- conditional UI (autofill) ----------
+
+      async function startConditionalUI() {
+        if (busy) return;
+        if (!window.PublicKeyCredential ||
+          typeof PublicKeyCredential.isConditionalMediationAvailable !== 'function') return;
+
+        let available = false;
+        try { available = await PublicKeyCredential.isConditionalMediationAvailable(); } catch (_) { }
+        if (!available) return;
+
+        abortConditionalUI();
+        const controller = new AbortController();
+        conditionalController = controller;
+
+        try {
+          const publicKey = await fetchRequestOptions();
+          if (controller.signal.aborted) return;
+
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: 'conditional',
+            signal: controller.signal,
+          });
+          if (!credential) return;
+
+          busy = true;
+          setStatus('Verifying passkey…');
+          const data = await verifyCredential(credential);
+          onSignedIn(data, credential);
+        } catch (err) {
+          if (isAbort(err)) return;
+          console.error(err);
+          setStatus(err.message || 'Passkey sign-in failed.', 'error');
+          busy = false;
+          // Re-arm autofill so the user can try again.
+          if (conditionalController === controller) conditionalController = null;
+          setTimeout(startConditionalUI, 0);
+          return;
+        } finally {
+          if (conditionalController === controller) conditionalController = null;
+        }
+      }
+
+      function abortConditionalUI() {
+        if (conditionalController) {
+          conditionalController.abort('conditional-aborted');
+          conditionalController = null;
+        }
+      }
+
+      // ---------- explicit button (modal) ----------
+
+      async function signInWithPasskey() {
+        if (busy) return;
+        if (!window.PublicKeyCredential) {
+          setStatus('Passkeys are not supported in this browser.', 'error');
+          return;
+        }
+
+        // Only one WebAuthn request may be pending at a time.
+        abortConditionalUI();
+        busy = true;
+        authButton.disabled = true;
+        setStatus('Waiting for your passkey…');
+
+        try {
+          const publicKey = await fetchRequestOptions();
+          // Ask for biometrics/PIN directly via the modal prompt.
+          publicKey.userVerification = 'required';
+          const credential = await navigator.credentials.get({ publicKey, mediation: 'required' });
+          if (!credential) throw new Error('No passkey was selected.');
+
+          setStatus('Verifying passkey…');
+          const data = await verifyCredential(credential);
+          onSignedIn(data, credential);
+        } catch (err) {
+          busy = false;
+          authButton.disabled = false;
+          if (err && err.name === 'NotAllowedError') {
+            setStatus('Sign-in was cancelled or timed out.', 'error');
+          } else if (!isAbort(err)) {
+            console.error(err);
+            setStatus((err && err.message) || 'Passkey sign-in failed.', 'error');
+          }
+          startConditionalUI();
+        }
+      }
+
+      authButton.addEventListener('click', signInWithPasskey);
+      document.getElementById('signin-form').addEventListener('submit', (e) => {
+        e.preventDefault();
+        signInWithPasskey();
+      });
+
+      // Arm autofill on load so suggestions appear as soon as the field is focused;
+      // also (re)arm on focus in case a previous request ended.
+      usernameField.addEventListener('focus', () => {
+        if (!conditionalController && !busy) startConditionalUI();
+      });
+      startConditionalUI();
+    })();
+  </script>
+
 </body>
 
