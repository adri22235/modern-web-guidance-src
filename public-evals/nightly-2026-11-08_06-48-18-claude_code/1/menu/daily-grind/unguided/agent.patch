+                this.typeahead(e.key, list, idx);
+              }
+          }
+        }
+
+        typeahead(char, list, idx) {
+          clearTimeout(this.typeTimer);
+          this.typeBuffer += char.toLowerCase();
+          this.typeTimer = setTimeout(() => { this.typeBuffer = ''; }, 500);
+          const ordered = [...list.slice(idx + 1), ...list.slice(0, idx + 1)];
+          const match = ordered.find((i) => i.textContent.trim().toLowerCase().startsWith(this.typeBuffer))
+            || ordered.find((i) => i.textContent.trim().toLowerCase().startsWith(char.toLowerCase()));
+          this.focusItem(match);
+        }
+
+        onClick(e) {
+          if (e.target.closest('.dm-trigger') === this.trigger) {
+            this.isOpen ? this.close() : this.open('first');
+            return;
+          }
+
+          const item = e.target.closest(ITEM_SELECTOR);
+          if (!item || !this.root.contains(item)) return;
+
+          if (item.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
+
+          const sub = this.submenuOf(item);
+          if (sub) {
+            sub.hidden ? this.openSub(item, true) : this.closeSub(sub);
+            return;
+          }
+
+          const role = item.getAttribute('role');
+          if (role === 'menuitemradio') {
+            const group = item.dataset.group;
+            this.root.querySelectorAll(`[role="menuitemradio"][data-group="${group}"]`)
+              .forEach((r) => r.setAttribute('aria-checked', String(r === item)));
+            this.emit('dm:change', item);
+            return;
+          }
+          if (role === 'menuitemcheckbox') {
