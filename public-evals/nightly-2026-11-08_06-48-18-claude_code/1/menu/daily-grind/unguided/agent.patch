+                this.close({ returnFocus: true });
+              } else {
+                const parent = this.parentItemOf(menu);
+                this.closeSub(menu);
+                this.focusItem(parent);
+              }
+              break;
+            case 'Enter': case ' ':
+              e.preventDefault();
+              item.click();
+              break;
+            case 'Tab':
+              // Let focus continue naturally from the trigger's position.
+              this.trigger.focus();
+              this.close();
+              break;
