+
+  <script>
+    (() => {
+      'use strict';
+
+      let uidCounter = 0;
+      const uid = (prefix) => `${prefix}-${++uidCounter}`;
+      const ensureId = (el, prefix) => el.id || (el.id = uid(prefix));
+      const ITEM_SELECTOR = '[role="menuitem"], [role="menuitemradio"], [role="menuitemcheckbox"]';
+
+      /**
+       * Accessible dropdown menu with arbitrarily nested submenus.
+       * Follows the WAI-ARIA "menu button" pattern:
+       *  - Trigger: Enter/Space/click toggles, ArrowDown/ArrowUp opens to first/last item.
+       *  - Items: Arrow keys move, Home/End jump, ArrowRight/Enter opens a submenu,
+       *    ArrowLeft/Escape closes it, Tab closes everything, letters type-ahead.
+       *  - menuitemradio / menuitemcheckbox toggle in place and keep the menu open.
+       * Emits bubbling `dm:select` (actions) and `dm:change` (options) events on the root.
+       */
+      class DropdownMenu {
+        static instances = new Set();
+
+        constructor(root) {
+          this.root = root;
+          this.trigger = root.querySelector(':scope > .dm-trigger');
+          this.menu = root.querySelector(':scope > .dm-menu');
+          this.hoverTimer = null;
+          this.lastHovered = null;
+          this.typeBuffer = '';
+          this.typeTimer = null;
+
+          root.querySelectorAll('[role="menu"]').forEach((m) => {
+            ensureId(m, 'dm-menu');
+            m.hidden = true;
+          });
+          root.querySelectorAll(ITEM_SELECTOR).forEach((item) => { item.tabIndex = -1; });
+
+          ensureId(this.trigger, 'dm-trigger');
+          this.trigger.setAttribute('aria-haspopup', 'menu');
+          this.trigger.setAttribute('aria-expanded', 'false');
+          this.trigger.setAttribute('aria-controls', this.menu.id);
+          if (!this.menu.hasAttribute('aria-label')) {
+            this.menu.setAttribute('aria-labelledby', this.trigger.id);
+          }
+
+          root.querySelectorAll('.dm-menu [aria-haspopup="menu"]').forEach((parent) => {
+            const sub = parent.nextElementSibling;
+            parent.setAttribute('aria-controls', sub.id);
+            parent.setAttribute('aria-expanded', 'false');
+          });
+
+          root.addEventListener('keydown', (e) => this.onKeydown(e));
+          root.addEventListener('click', (e) => this.onClick(e));
+          root.addEventListener('mouseover', (e) => this.onMouseover(e));
+          root.addEventListener('focusout', (e) => {
+            if (e.relatedTarget && !root.contains(e.relatedTarget)) this.close();
+          });
+          document.addEventListener('pointerdown', (e) => {
+            if (this.isOpen && !root.contains(e.target)) this.close();
+          });
+          window.addEventListener('resize', () => this.close());
+
+          DropdownMenu.instances.add(this);
+        }
+
+        get isOpen() { return !this.menu.hidden; }
+
+        items(menu) {
+          return [...menu.querySelectorAll(ITEM_SELECTOR)]
+            .filter((i) => i.closest('[role="menu"]') === menu);
+        }
+
+        submenuOf(item) {
+          return item.getAttribute('aria-haspopup') === 'menu' && item !== this.trigger
+            ? document.getElementById(item.getAttribute('aria-controls'))
+            : null;
+        }
+
+        parentItemOf(menu) {
+          return menu === this.menu
+            ? this.trigger
+            : this.root.querySelector(`[aria-controls="${menu.id}"]`);
+        }
+
+        focusItem(item) {
+          if (item) item.focus({ preventScroll: true });
+        }
+
+        open(focus = 'first') {
+          DropdownMenu.instances.forEach((inst) => { if (inst !== this) inst.close(); });
+          if (!this.isOpen) {
+            this.menu.hidden = false;
+            this.trigger.setAttribute('aria-expanded', 'true');
+            this.root.classList.add('is-open');
+            this.position(this.menu, false);
+          }
+          const list = this.items(this.menu);
+          this.focusItem(focus === 'last' ? list[list.length - 1] : list[0]);
+        }
+
+        close({ returnFocus = false } = {}) {
+          if (!this.isOpen) return;
+          clearTimeout(this.hoverTimer);
+          this.closeSubmenusIn(this.menu);
+          this.menu.hidden = true;
+          this.trigger.setAttribute('aria-expanded', 'false');
+          this.root.classList.remove('is-open');
+          this.lastHovered = null;
+          if (returnFocus) this.trigger.focus();
+        }
+
+        openSub(item, focusFirst) {
+          const sub = this.submenuOf(item);
+          this.closeSiblingSubs(item);
+          if (sub.hidden) {
+            sub.hidden = false;
+            item.setAttribute('aria-expanded', 'true');
+            this.position(sub, true);
+          }
+          if (focusFirst) this.focusItem(this.items(sub)[0]);
+        }
+
+        closeSub(sub) {
+          this.closeSubmenusIn(sub);
+          sub.hidden = true;
+          this.parentItemOf(sub).setAttribute('aria-expanded', 'false');
+        }
+
+        closeSubmenusIn(menu) {
+          menu.querySelectorAll('[role="menu"]').forEach((s) => {
+            if (!s.hidden) {
+              s.hidden = true;
+              this.parentItemOf(s).setAttribute('aria-expanded', 'false');
+            }
+          });
+        }
+
+        closeSiblingSubs(item) {
+          const menu = item.closest('[role="menu"]');
+          this.items(menu).forEach((other) => {
+            const sub = other !== item && this.submenuOf(other);
+            if (sub && !sub.hidden) this.closeSub(sub);
+          });
+        }
+
+        // Keep menus inside the viewport by flipping horizontally / vertically.
+        position(menu, isSub) {
+          menu.classList.remove('dm-flip-x', 'dm-flip-y');
+          if (getComputedStyle(menu).position !== 'absolute') return;
+          const r = menu.getBoundingClientRect();
+          if (r.right > window.innerWidth - 8) menu.classList.add('dm-flip-x');
+          if (isSub && r.bottom > window.innerHeight - 8) menu.classList.add('dm-flip-y');
+        }
+
+        onKeydown(e) {
+          if (e.target === this.trigger) {
+            if (e.key === 'ArrowDown') { e.preventDefault(); this.open('first'); }
+            else if (e.key === 'ArrowUp') { e.preventDefault(); this.open('last'); }
+            else if (e.key === 'Escape' && this.isOpen) { e.preventDefault(); this.close({ returnFocus: true }); }
