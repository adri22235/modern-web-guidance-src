+              break;
+            case 'ArrowLeft':
+              if (!isTop) {
+                e.preventDefault();
+                const parent = this.parentItemOf(menu);
+                this.closeSub(menu);
+                this.focusItem(parent);
+              }
+              break;
+            case 'Escape':
+              e.preventDefault();
+              e.stopPropagation();
