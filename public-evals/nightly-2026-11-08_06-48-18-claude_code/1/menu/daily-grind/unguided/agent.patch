+            this.emit('dm:change', item);
+            return;
+          }
+
+          // Plain action/link item: run it and close.
+          this.emit('dm:select', item);
+          this.close({ returnFocus: !item.hasAttribute('href') });
+        }
+
+        onMouseover(e) {
+          const item = e.target.closest(ITEM_SELECTOR);
+          if (!item || !this.root.contains(item) || item === this.lastHovered) return;
+          this.lastHovered = item;
+          clearTimeout(this.hoverTimer);
+          this.focusItem(item);
+          const hasSub = !!this.submenuOf(item);
+          // Small delay ("hover intent") so diagonal mouse movement doesn't collapse submenus.
+          this.hoverTimer = setTimeout(() => {
+            if (!this.isOpen) return;
+            if (hasSub && window.matchMedia('(min-width: 601px)').matches) this.openSub(item, false);
+            else if (!hasSub) this.closeSiblingSubs(item);
+          }, 150);
+        }
+
+        emit(type, item) {
+          this.root.dispatchEvent(new CustomEvent(type, {
+            bubbles: true,
+            detail: { item, action: item.dataset.action, value: item.dataset.value, checked: item.getAttribute('aria-checked') === 'true' },
+          }));
+        }
+      }
+
+      // ---------- Toast + cart ----------
+      const toastEl = document.getElementById('toast');
+      let toastTimer;
+      const toast = (msg) => {
+        toastEl.textContent = msg;
+        toastEl.classList.add('show');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(() => toastEl.classList.remove('show'), 2800);
+      };
+
+      const cartCountEl = document.getElementById('cart-count');
+      let cartCount = 0;
+      const bumpCart = () => {
+        cartCount += 1;
+        cartCountEl.textContent = cartCount;
+        cartCountEl.setAttribute('aria-label', `${cartCount} item${cartCount === 1 ? '' : 's'} in order`);
+      };
+
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      // ---------- Seasonal card customization ----------
+      const template = document.getElementById('customize-template');
+
+      document.querySelectorAll('.card[data-drink]').forEach((card) => {
+        const host = card.querySelector('[data-customize]');
+        host.appendChild(template.content.cloneNode(true));
+        host.querySelector('.dm-menu').setAttribute('aria-label', `Customize ${card.dataset.drink}`);
+        new DropdownMenu(host);
+
+        const base = parseFloat(card.dataset.price);
+        const totalEl = card.querySelector('[data-total]');
+        const summaryEl = card.querySelector('[data-summary]');
+        const detailsHref = card.querySelector('.card-actions > a').getAttribute('href');
+
+        const checkedRadio = (group) => host.querySelector(`[role="menuitemradio"][data-group="${group}"][aria-checked="true"]`);
+        const checkedOptions = () => [...host.querySelectorAll('[role="menuitemcheckbox"][aria-checked="true"]')];
+
+        const applyDefaults = () => {
+          host.querySelectorAll('[role="menuitemcheckbox"]').forEach((c) => c.setAttribute('aria-checked', 'false'));
