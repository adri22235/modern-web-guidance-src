+          const menu = item.closest('[role="menu"]');
+          const list = this.items(menu);
+          const idx = list.indexOf(item);
+          const isTop = menu === this.menu;
+
+          switch (e.key) {
+            case 'ArrowDown':
+              e.preventDefault(); this.focusItem(list[(idx + 1) % list.length]); break;
+            case 'ArrowUp':
+              e.preventDefault(); this.focusItem(list[(idx - 1 + list.length) % list.length]); break;
+            case 'Home': case 'PageUp':
+              e.preventDefault(); this.focusItem(list[0]); break;
+            case 'End': case 'PageDown':
+              e.preventDefault(); this.focusItem(list[list.length - 1]); break;
+            case 'ArrowRight':
