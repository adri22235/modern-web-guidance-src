+            } else {
+              host.querySelectorAll(`[role="menuitemradio"][data-group="${key}"]`)
+                .forEach((r) => r.setAttribute('aria-checked', String(r.dataset.value === val)));
+            }
+          });
+        };
+
+        const describe = () => {
+          const size = checkedRadio('size');
+          const milk = checkedRadio('milk');
+          const options = checkedOptions();
+          const total = base + [size, milk, ...options]
+            .reduce((sum, el) => sum + (el ? parseFloat(el.dataset.price || 0) : 0), 0);
+          const parts = [size?.dataset.label, milk?.dataset.label, ...options.map((o) => o.dataset.label)].filter(Boolean);
+          return { size, milk, options, total, text: parts.join(' · ') };
+        };
+
+        const render = () => {
+          const d = describe();
+          totalEl.textContent = money(d.total);
+          summaryEl.textContent = d.text;
+          host.querySelector('[data-hint="size"]').textContent = d.size?.dataset.label || '';
+          host.querySelector('[data-hint="milk"]').textContent = d.milk?.dataset.label || 'None';
+          host.querySelector('[data-hint="extras"]').textContent = d.options.length ? `${d.options.length} selected` : '';
+        };
+
+        host.addEventListener('dm:change', render);
+
+        host.addEventListener('dm:select', (e) => {
+          const d = describe();
+          const name = `${d.size?.dataset.label || ''} ${card.dataset.drink}`.trim();
+          switch (e.detail.action) {
+            case 'add':
+              bumpCart();
+              toast(`Added ${name} (${money(d.total)}) to your order.`);
+              break;
+            case 'save':
+              toast(`Saved "${name}" to your favorites.`);
+              break;
+            case 'reset':
+              applyDefaults();
+              render();
+              toast(`${card.dataset.drink} reset to the house recipe.`);
+              break;
+            case 'copy-link': {
+              const url = new URL(detailsHref, location.href).href;
+              (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
+                .then(() => toast('Link copied to clipboard.'))
+                .catch(() => toast(url));
+              break;
+            }
+            case 'email': {
+              const url = new URL(detailsHref, location.href).href;
+              location.href = `mailto:?subject=${encodeURIComponent(`Try the ${card.dataset.drink} at The Daily Grind`)}&body=${encodeURIComponent(`${d.text}\n${url}`)}`;
+              break;
+            }
+          }
+        });
+
+        applyDefaults();
+        render();
+      });
+
+      // ---------- Nav menus ----------
+      document.querySelectorAll('nav [data-menu]').forEach((root) => {
+        new DropdownMenu(root);
+        root.addEventListener('dm:change', (e) => {
+          const { item, checked } = e.detail;
+          if (item.getAttribute('role') === 'menuitemradio') {
+            toast(`Default fulfillment set to ${item.textContent.trim().toLowerCase()}.`);
+          } else {
+            toast(`${item.textContent.trim()} ${checked ? 'enabled' : 'disabled'}.`);
+          }
+        });
+      });
+    })();
+  </script>
