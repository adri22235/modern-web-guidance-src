+    /* Promo alert: a non-modal <dialog> rendered in normal flow.
+       <form method="dialog"> closes it with no JavaScript. */
+    #promo-alert {
+      /* Undo UA dialog positioning so it sits in flow and pushes content */
+      position: static;
+      inset: auto;
+      margin: 0;
+      width: auto;
+      max-width: none;
+      height: auto;
+      max-height: none;
+      border: 0;
+      padding: 0;
+      background: var(--accent);
+      color: var(--text);
+      /* 1fr -> 0fr row animates the natural height down to zero in all modern browsers */
+      display: grid;
+      grid-template-rows: 1fr;
+      opacity: 1;
+    }
+
+    #promo-alert:not([open]) {
+      display: none;
+      grid-template-rows: 0fr;
+      opacity: 0;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      #promo-alert {
+        transition: grid-template-rows 0.35s ease-in-out, opacity 0.35s ease-in-out, display 0.35s;
+        /* Keeps the dialog rendered until the collapse finishes */
+        transition-behavior: allow-discrete;
+      }
+    }
+
+    .promo-alert__clip {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    .promo-alert__body {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 1rem;
+      padding: 0.6rem 5%;
+      font-size: 0.95rem;
+    }
+
+    .promo-alert__body form {
+      display: contents;
+    }
+
