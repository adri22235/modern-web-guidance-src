+      flex-shrink: 0;
+      display: grid;
+      place-items: center;
+      inline-size: 2rem;
+      block-size: 2rem;
+      border: 0;
+      border-radius: 50%;
+      background: transparent;
+      color: inherit;
+      font-size: 1.4rem;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    #alert-dismiss:hover {
+      background: rgba(0, 0, 0, 0.1);
+    }
+
+    #alert-dismiss:focus-visible {
+      outline: 2px solid var(--text);
