+  <script>
+    (() => {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-email-error');
+      const status = document.getElementById('newsletter-status');
+
+      const messageFor = (el) => {
+        if (el.validity.valueMissing) return '\u26A0 Please enter your email address.';
+        if (el.validity.typeMismatch) return '\u26A0 Please enter a valid email address, like you@example.com.';
+        return el.validationMessage ? `\u26A0 ${el.validationMessage}` : '';
+      };
+
+      /*
+        Mirror the browser's interaction-aware :user-invalid state into both the
+        visible message and the ARIA state. Because the live region's text is only
+        set while :user-invalid matches, screen readers announce the error exactly
+        when it appears visually, and it is cleared the moment the email is valid.
+        The text is only rewritten when it changes, so typing does not re-announce.
+      */
+      const sync = () => {
+        const isUserInvalid = input.matches(':user-invalid');
+        const message = isUserInvalid ? messageFor(input) : '';
+
+        if (isUserInvalid) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+
+        if (error.textContent !== message) {
+          error.textContent = message;
+        }
+      };
+
+      // blur shows the error after first interaction; input/change clear it as soon as it is fixed.
+      input.addEventListener('blur', sync);
+      input.addEventListener('input', () => {
+        status.textContent = '';
+        sync();
+      });
+      input.addEventListener('change', sync);
+      // Fired on a submit attempt with an invalid value. Suppress the native bubble so the
+      // error isn't announced twice, move focus to the field, then sync once :user-invalid applies.
+      input.addEventListener('invalid', (event) => {
+        event.preventDefault();
+        input.focus();
+        setTimeout(sync);
+      });
+
+      form.addEventListener('submit', (event) => {
+        // No backend wired up for the demo: confirm inline instead of navigating.
+        event.preventDefault();
+        const email = input.value.trim();
+        form.reset();
+        status.textContent = `Thanks! ${email} is now subscribed.`;
+      });
+
+      // Resetting clears the user-interacted flag, so clear the error state too.
+      form.addEventListener('reset', () => setTimeout(sync));
+    })();
+  </script>
+
