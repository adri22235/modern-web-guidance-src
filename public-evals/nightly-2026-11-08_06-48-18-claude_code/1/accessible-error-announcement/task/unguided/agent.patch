+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      var success = document.getElementById('newsletter-success');
+      // Error state is only revealed after the user has interacted:
+      // leaving a changed field (blur) or attempting to submit.
+      var interacted = false;
+
+      function getError() {
+        var value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address, like name@example.com.';
+        }
+        return '';
+      }
+
+      function showError(message) {
+        // Only touch the live region when the text actually changes, so it is
+        // not re-announced on every keystroke.
+        if (error.textContent !== message) error.textContent = message;
+        input.setAttribute('aria-invalid', 'true');
+        input.setAttribute('aria-describedby', error.id);
+      }
+
+      function clearError() {
+        if (error.textContent !== '') error.textContent = '';
+        input.removeAttribute('aria-invalid');
+        input.removeAttribute('aria-describedby');
+      }
+
+      function sync() {
+        var message = getError();
+        if (interacted && message) {
+          showError(message);
+        } else {
+          clearError();
+        }
+        return message;
+      }
+
+      input.addEventListener('input', function () {
+        success.textContent = '';
+        // Before interaction: never show/announce. After: clear immediately once
+        // valid, and keep the message accurate while still invalid.
+        sync();
+      });
+
+      input.addEventListener('change', function () {
+        // `change` fires on blur after the value was modified.
+        interacted = true;
+        sync();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        interacted = true;
+        var message = sync();
+        if (message) {
+          input.focus();
+          return;
+        }
+        success.textContent = 'Thanks for subscribing! Check your inbox to confirm.';
+        form.reset();
+        interacted = false;
+        clearError();
+      });
+    })();
+  </script>
