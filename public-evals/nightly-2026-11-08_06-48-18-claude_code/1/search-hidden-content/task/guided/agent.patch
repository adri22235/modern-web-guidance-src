+  <script>
+    // Wholesale/Catering tabs: keep one tab open (clicking the open tab won't collapse it)
+    document.querySelectorAll('.wholesale-tab > summary').forEach((summary) => {
+      summary.addEventListener('click', (e) => {
+        if (summary.parentElement.open) e.preventDefault();
+      });
+    });
+
+    // Reveal coupon: one-way reveal of a hidden="until-found" panel
+    (() => {
+      const button = document.getElementById('reveal-coupon');
+      const panel = document.getElementById('coupon-panel');
+
+      const markRevealed = () => {
+        button.setAttribute('aria-expanded', 'true');
+        button.disabled = true;
+        button.textContent = 'Coupon Revealed';
+      };
+
+      button.addEventListener('click', () => {
+        panel.removeAttribute('hidden');
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      });
+
+      // Find-in-page revealed it: browser removes `hidden`; sync the button
+      panel.addEventListener('beforematch', markRevealed);
+
+      // Browsers without hidden="until-found" would hide it unsearchably: show it instead
+      if (!('onbeforematch' in HTMLElement.prototype)) {
+        panel.removeAttribute('hidden');
+        markRevealed();
+      }
+    })();
+  </script>
