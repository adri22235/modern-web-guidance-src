+  <script>
+    // Reveal coupon: one-way. Also syncs state if find-in-page reveals it first.
+    (function () {
+      var btn = document.getElementById('reveal-coupon-btn');
+      var panel = document.getElementById('coupon-panel');
+
+      function markRevealed() {
+        btn.disabled = true;
+        btn.setAttribute('aria-expanded', 'true');
+        btn.textContent = 'Coupon Revealed';
+      }
+
+      btn.addEventListener('click', function () {
+        panel.removeAttribute('hidden');
+        markRevealed();
+        panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+
+      // Fired when find-in-page / fragment navigation is about to reveal the panel
+      panel.addEventListener('beforematch', markRevealed);
+    })();
+
+    // Tabs: keep one tab always open (clicking the active tab won't close it)
+    document.querySelectorAll('.wholesale-tab > summary').forEach(function (summary) {
+      summary.addEventListener('click', function (e) {
+        if (summary.parentElement.open) e.preventDefault();
+      });
+    });
+  </script>
+
