+  <script>
+    (function () {
+      const viewport = document.getElementById('cafe-map');
+      if (!viewport) return;
+
+      const info = document.getElementById('map-info');
+      const pins = viewport.querySelectorAll('.map-pin');
+      const DRAG_THRESHOLD = 5; // px before a press becomes a pan (keeps pin clicks working)
+      const FRICTION = 0.94;    // per-frame velocity decay for momentum
+
+      // Free 2D panning: both scroll axes are updated from the same pointer delta
+      // on every move, so diagonal drags and mid-gesture direction changes are
+      // followed exactly with no axis locking.
+      function panBy(dx, dy) {
+        viewport.scrollLeft += dx;
+        viewport.scrollTop += dy;
+      }
+
+      let activePointer = null;
+      let startX = 0, startY = 0, lastX = 0, lastY = 0, lastT = 0;
+      let vx = 0, vy = 0;
+      let dragging = false;
+      let suppressClick = false;
+      let momentumFrame = null;
+
+      function stopMomentum() {
+        if (momentumFrame !== null) {
+          cancelAnimationFrame(momentumFrame);
+          momentumFrame = null;
+        }
+      }
+
+      function startMomentum() {
+        stopMomentum();
+        let prev = performance.now();
+        function step(now) {
+          const dt = Math.min(now - prev, 50);
+          prev = now;
+          if (Math.hypot(vx, vy) < 0.02) { momentumFrame = null; return; }
+          panBy(-vx * dt, -vy * dt);
+          const decay = Math.pow(FRICTION, dt / 16.67);
+          vx *= decay;
+          vy *= decay;
+          momentumFrame = requestAnimationFrame(step);
+        }
+        momentumFrame = requestAnimationFrame(step);
+      }
+
+      viewport.addEventListener('pointerdown', (e) => {
+        if (activePointer !== null) return;
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        if (e.target.closest('.map-info')) return; // allow selecting popup text
+        stopMomentum();
+        activePointer = e.pointerId;
+        startX = lastX = e.clientX;
+        startY = lastY = e.clientY;
+        lastT = performance.now();
+        vx = vy = 0;
+        dragging = false;
+      });
+
+      viewport.addEventListener('pointermove', (e) => {
+        if (e.pointerId !== activePointer) return;
+        const x = e.clientX, y = e.clientY;
+
+        if (!dragging) {
+          if (Math.hypot(x - startX, y - startY) < DRAG_THRESHOLD) return;
+          dragging = true;
+          viewport.classList.add('is-dragging');
+          try { viewport.setPointerCapture(e.pointerId); } catch (_) { }
+        }
+
+        const dx = x - lastX;
+        const dy = y - lastY;
+        const now = performance.now();
+        const dt = Math.max(now - lastT, 1);
+
+        panBy(-dx, -dy);
+
+        // Smoothed velocity (px/ms) for release momentum
+        vx = 0.8 * (dx / dt) + 0.2 * vx;
+        vy = 0.8 * (dy / dt) + 0.2 * vy;
+
+        lastX = x; lastY = y; lastT = now;
+        e.preventDefault();
+      });
+
+      function endPointer(e) {
+        if (e.pointerId !== activePointer) return;
+        activePointer = null;
+        if (!dragging) return;
+        dragging = false;
+        suppressClick = true;
+        viewport.classList.remove('is-dragging');
+        // Only fling if the pointer was still moving at release
+        if (e.type === 'pointerup' && performance.now() - lastT < 80) startMomentum();
+      }
+
+      viewport.addEventListener('pointerup', endPointer);
+      viewport.addEventListener('pointercancel', endPointer);
+      viewport.addEventListener('lostpointercapture', endPointer);
+
+      // A drag that ends on a pin should not count as a click on it.
+      viewport.addEventListener('click', (e) => {
+        if (suppressClick) {
+          suppressClick = false;
+          e.stopPropagation();
+          e.preventDefault();
+        }
+      }, true);
+      viewport.addEventListener('pointerdown', () => { suppressClick = false; }, true);
+
+      // Stop momentum when the user takes over with the wheel / trackpad
+      // (native wheel scrolling already supports both axes at once).
+      viewport.addEventListener('wheel', stopMomentum, { passive: true });
+
+      // Keyboard: track held arrow keys so two keys together pan diagonally.
+      const held = new Set();
+      const KEY_DIRS = {
+        ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1]
+      };
+      let keyFrame = null;
+      let keyPrev = 0;
+
+      function keyStep(now) {
+        if (held.size === 0) { keyFrame = null; return; }
+        const dt = Math.min(now - keyPrev, 50);
+        keyPrev = now;
+        let dx = 0, dy = 0;
+        held.forEach((k) => { dx += KEY_DIRS[k][0]; dy += KEY_DIRS[k][1]; });
+        const len = Math.hypot(dx, dy) || 1;
+        const speed = 0.8; // px per ms
+        panBy((dx / len) * speed * dt, (dy / len) * speed * dt);
+        keyFrame = requestAnimationFrame(keyStep);
+      }
+
+      viewport.addEventListener('keydown', (e) => {
+        if (!(e.key in KEY_DIRS)) return;
+        e.preventDefault();
+        stopMomentum();
+        held.add(e.key);
+        if (keyFrame === null) {
+          keyPrev = performance.now();
+          keyFrame = requestAnimationFrame(keyStep);
+        }
+      });
+      viewport.addEventListener('keyup', (e) => { held.delete(e.key); });
+      viewport.addEventListener('blur', () => { held.clear(); });
+
+      // Location popups
+      function showInfo(pin) {
+        pins.forEach((p) => p.classList.toggle('active', p === pin));
+        info.querySelector('h4').textContent = pin.dataset.name;
+        info.querySelector('.info-address').textContent = pin.dataset.address;
+        info.querySelector('.info-hours').textContent = 'Hours: ' + pin.dataset.hours;
+        info.style.left = pin.style.left;
+        info.style.top = pin.style.top;
+        info.hidden = false;
+      }
+
+      function hideInfo() {
+        info.hidden = true;
+        pins.forEach((p) => p.classList.remove('active'));
+      }
+
+      pins.forEach((pin) => pin.addEventListener('click', () => showInfo(pin)));
+      info.querySelector('.close').addEventListener('click', hideInfo);
+
+      // Center on the flagship store
+      function recenter(smooth) {
+        stopMomentum();
+        const left = 1200 - viewport.clientWidth / 2;
+        const top = 900 - viewport.clientHeight / 2;
+        viewport.scrollTo({ left, top, behavior: smooth ? 'smooth' : 'auto' });
+      }
+
+      document.getElementById('map-recenter').addEventListener('click', () => recenter(true));
+      recenter(false);
+    })();
+  </script>
+
