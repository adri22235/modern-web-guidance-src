+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const fields = {
+        number: document.getElementById('card-number'),
+        name: document.getElementById('card-name'),
+        expiry: document.getElementById('card-expiry'),
+        cvc: document.getElementById('card-cvc')
+      };
+
+      const digitsOnly = (value) => value.replace(/\D/g, '');
+
+      // Luhn checksum for card numbers
+      function passesLuhn(num) {
+        let sum = 0;
+        let double = false;
+        for (let i = num.length - 1; i >= 0; i--) {
+          let d = parseInt(num[i], 10);
+          if (double) {
+            d *= 2;
+            if (d > 9) d -= 9;
+          }
+          sum += d;
+          double = !double;
+        }
+        return sum % 10 === 0;
+      }
+
+      const isAmex = (num) => /^3[47]/.test(num);
+
+      const validators = {
+        number(value) {
+          const num = digitsOnly(value);
+          if (!num) return 'Card number is required.';
+          if (num.length < 13 || num.length > 19) return 'Card number must be 13–19 digits.';
+          if (!passesLuhn(num)) return 'Please enter a valid card number.';
+          return '';
+        },
+        name(value) {
+          const name = value.trim();
+          if (!name) return 'Name on card is required.';
+          if (!/^[\p{L}][\p{L}' .-]*$/u.test(name)) return 'Please enter a valid name.';
+          return '';
+        },
+        expiry(value) {
+          const match = value.match(/^(\d{2})\/(\d{2})$/);
+          if (!match) return 'Use the format MM/YY.';
+          const month = parseInt(match[1], 10);
+          const year = 2000 + parseInt(match[2], 10);
+          if (month < 1 || month > 12) return 'Please enter a valid month.';
+          const now = new Date();
+          const endOfExpiryMonth = new Date(year, month, 1); // first day of the following month
+          if (endOfExpiryMonth <= now) return 'This card has expired.';
+          return '';
+        },
+        cvc(value) {
+          const cvc = digitsOnly(value);
+          const expected = isAmex(digitsOnly(fields.number.value)) ? 4 : 3;
+          if (!cvc) return 'Security code is required.';
+          if (cvc.length !== expected) return `Security code must be ${expected} digits.`;
+          return '';
+        }
+      };
+
+      function showError(key, message) {
+        const input = fields[key];
+        document.getElementById(input.getAttribute('aria-describedby')).textContent = message;
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+      }
+
+      function validate(key) {
+        const message = validators[key](fields[key].value);
+        showError(key, message);
+        return !message;
+      }
+
+      // Input formatting
+      fields.number.addEventListener('input', () => {
+        const num = digitsOnly(fields.number.value).slice(0, 19);
+        const groups = isAmex(num)
+          ? [num.slice(0, 4), num.slice(4, 10), num.slice(10, 15)]
+          : num.match(/.{1,4}/g) || [];
+        fields.number.value = groups.filter(Boolean).join(' ');
+      });
+
+      fields.expiry.addEventListener('input', (e) => {
+        let val = digitsOnly(fields.expiry.value).slice(0, 4);
+        if (val.length === 1 && val > '1') val = '0' + val;
+        if (val.length >= 3 || (val.length === 2 && e.inputType !== 'deleteContentBackward')) {
+          val = val.slice(0, 2) + '/' + val.slice(2);
+        }
+        fields.expiry.value = val;
+      });
+
+      fields.cvc.addEventListener('input', () => {
+        fields.cvc.value = digitsOnly(fields.cvc.value).slice(0, 4);
+      });
+
+      // Validate on blur; clear errors as the user fixes them
+      Object.keys(fields).forEach((key) => {
+        fields[key].addEventListener('blur', () => {
+          if (fields[key].value) validate(key);
+        });
+        fields[key].addEventListener('input', () => {
+          if (fields[key].getAttribute('aria-invalid') === 'true') validate(key);
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        const results = Object.keys(fields).map(validate);
+        if (results.includes(false)) {
+          e.preventDefault();
+          const firstInvalid = Object.values(fields).find(
+            (input) => input.getAttribute('aria-invalid') === 'true'
+          );
+          firstInvalid.focus();
+          return;
+        }
+        // Normalize the card number to digits only before it is submitted
+        fields.number.value = digitsOnly(fields.number.value);
+      });
+    })();
+  </script>
+
 </body>
 
