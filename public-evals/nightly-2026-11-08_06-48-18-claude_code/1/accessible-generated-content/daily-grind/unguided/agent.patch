+    /* ------------------------------------------------------------------
+       Decorative icons & flourishes
+       All icons below are purely decorative. They are drawn with CSS
+       shapes (borders, radii, gradients) using empty `content`, so there
+       is no text for assistive technology to announce. Where a text
+       glyph is used, the CSS alt-text syntax `content: "x" / ""` marks it
+       as decorative, with an empty-string fallback declared first so that
+       browsers lacking alt-text support render nothing rather than
+       exposing the glyph to screen readers. Icon elements in the markup
+       carry aria-hidden="true" as an additional guarantee.
+       ------------------------------------------------------------------ */
+
+    .visually-hidden {
+      position: absolute !important;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0 0 0 0);
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    /* Section heading flourish: ── ✦ Seasonal Favorites ✦ ── */
+    .section-title {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.75rem;
+      text-align: center;
+      color: var(--primary);
+      letter-spacing: 0.5px;
+    }
+
+    .section-title::before,
+    .section-title::after {
+      /* Fallback: render nothing where alt-text syntax is unsupported */
+      content: "";
+      /* Decorative glyph with empty alternative text */
+      content: "\2726" / "";
+      flex: 0 1 120px;
+      color: var(--accent);
+      font-size: 0.9rem;
+      line-height: 1;
+      /* Gradient rule leading into the sparkle */
+      background: linear-gradient(to right, transparent, var(--secondary)) left center / calc(100% - 1.25rem) 2px no-repeat;
+      text-align: right;
+      min-height: 2px;
+    }
+
+    .section-title::after {
+      background: linear-gradient(to left, transparent, var(--secondary)) right center / calc(100% - 1.25rem) 2px no-repeat;
+      text-align: left;
+    }
+
+    /* Drink card headings */
+    .card h3 {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.6rem;
+      padding-bottom: 0.6rem;
+    }
+
+    /* Small underline flourish: dot – line – dot */
+    .card h3::after {
+      content: "";
+      width: 56px;
+      height: 6px;
+      background:
+        radial-gradient(circle, var(--accent) 2.5px, transparent 3px) left center / 6px 6px no-repeat,
+        radial-gradient(circle, var(--accent) 2.5px, transparent 3px) right center / 6px 6px no-repeat,
+        linear-gradient(var(--secondary), var(--secondary)) center / calc(100% - 16px) 2px no-repeat;
+    }
+
+    /* Drink icon container (aria-hidden span inside each h3) */
+    .drink-icon {
+      position: relative;
+      display: block;
+      width: 48px;
+      height: 48px;
+      border-radius: 50%;
+      background: radial-gradient(circle at 30% 30%, #fff3e0, var(--secondary));
+      box-shadow: inset 0 0 0 2px rgba(78, 52, 46, 0.15);
+      color: var(--primary);
+    }
+
+    .drink-icon::before,
+    .drink-icon::after {
+      content: "";
+      position: absolute;
+      box-sizing: border-box;
+    }
+
+    /* Hot latte: mug with handle and steam */
+    .drink-icon--latte::before {
+      /* mug body */
+      left: 12px;
+      bottom: 11px;
+      width: 19px;
+      height: 16px;
+      border: 2.5px solid currentColor;
+      border-top-width: 3px;
