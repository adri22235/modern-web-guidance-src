+      width: 2.5px;
+      height: 14px;
+      background: var(--accent);
+      transform: rotate(18deg);
+      transform-origin: bottom center;
+      border-radius: 2px;
+    }
+
+    /* Buttons */
+    .btn {
+      position: relative;
+      display: inline-flex;
+      align-items: center;
+      gap: 0.55rem;
+      overflow: hidden;
+      isolation: isolate;
+      transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
+    }
+
+    .btn:hover {
+      transform: translateY(-1px);
+      box-shadow: 0 4px 10px rgba(62, 39, 35, 0.3);
+    }
+
+    .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* Sheen that sweeps across on hover/focus */
+    .btn::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      background: linear-gradient(110deg, transparent 30%, rgba(255, 171, 64, 0.35) 50%, transparent 70%);
+      transform: translateX(-100%);
+      transition: transform 0.6s ease;
+      pointer-events: none;
+    }
+
+    .btn:hover::after,
+    .btn:focus-visible::after {
+      transform: translateX(100%);
+    }
+
+    /* "Order Now": takeaway cup icon (lid + tapered cup) */
+    .btn--order {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 600;
+      padding: 12px 24px;
+    }
+
+    .btn--order:hover {
+      background: #ffc777;
+    }
+
+    .btn--order::before {
+      content: "";
+      flex: none;
+      width: 12px;
+      height: 15px;
+      box-sizing: border-box;
+      border: 2px solid currentColor;
+      border-top-width: 4px;
+      border-radius: 3px 3px 2px 2px;
+      clip-path: polygon(0 0, 100% 0, 85% 100%, 15% 100%);
+      background: linear-gradient(currentColor, currentColor) center 55% / 100% 2px no-repeat;
+    }
+
+    /* "View Details": chevron that nudges forward on hover */
+    .btn--details::before {
+      content: "";
+      order: 2;
+      flex: none;
+      width: 7px;
+      height: 7px;
+      border-top: 2px solid currentColor;
+      border-right: 2px solid currentColor;
+      transform: rotate(45deg);
+      transition: transform 0.25s ease;
+    }
+
+    .btn--details:hover::before,
+    .btn--details:focus-visible::before {
+      transform: translateX(3px) rotate(45deg);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .btn,
+      .btn::after,
+      .btn--details::before {
+        transition: none;
+      }
+
+      .btn:hover {
+        transform: none;
+      }
+
+      .btn--details:hover::before,
+      .btn--details:focus-visible::before {
+        transform: rotate(45deg);
+      }
+    }
+
+    /* Windows High Contrast / forced colors: keep icons visible via
