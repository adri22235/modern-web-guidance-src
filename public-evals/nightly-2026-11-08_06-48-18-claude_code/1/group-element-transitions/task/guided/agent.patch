+  <script>
+    (() => {
+      const beans = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Light roast · jasmine, lemon, bergamot', roast: '#b8875a' },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Medium roast · caramel, red apple, cocoa', roast: '#8a5a36' },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Dark roast · cedar, dark chocolate, spice', roast: '#4a2c1a' },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Medium roast · toffee, orange, almond', roast: '#7a4b2c' },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Light roast · blackcurrant, grapefruit', roast: '#a8784c' },
+        { id: 'house', name: 'Daily Grind House Blend', notes: 'Medium-dark · brown sugar, hazelnut', roast: '#5e3a22' },
+      ];
+
+      const availableList = document.getElementById('bean-available');
+      const selectedList = document.getElementById('bean-selected');
+      const availableCount = document.getElementById('bean-available-count');
+      const selectedCount = document.getElementById('bean-selected-count');
+      const status = document.getElementById('bean-status');
+
+      const selected = new Set(['house']);
+      const cards = new Map();
+
+      for (const bean of beans) {
+        const li = document.createElement('li');
+        li.className = 'bean';
+        // Unique name per card so each one is tracked individually; the shared
+        // .bean view-transition-class supplies the common animation.
+        li.style.viewTransitionName = `bean-${bean.id}`;
+        li.style.setProperty('--roast', bean.roast);
+        li.innerHTML = `
+          <span class="bean-swatch" aria-hidden="true"></span>
+          <span class="bean-info"><strong></strong><span></span></span>
+          <button type="button" class="bean-toggle"></button>`;
+        li.querySelector('strong').textContent = bean.name;
+        li.querySelector('.bean-info span').textContent = bean.notes;
+        const button = li.querySelector('button');
+        button.addEventListener('click', () => toggle(bean));
+        cards.set(bean.id, { li, button });
+      }
+
+      function render() {
+        for (const bean of beans) {
+          const { li, button } = cards.get(bean.id);
+          const isSelected = selected.has(bean.id);
+          button.textContent = isSelected ? 'Remove' : 'Add';
+          button.setAttribute('aria-label', `${isSelected ? 'Remove' : 'Add'} ${bean.name}`);
+          // appendChild moves existing nodes, keeping catalog order in both lists.
+          (isSelected ? selectedList : availableList).appendChild(li);
+        }
+        const n = selected.size;
+        availableCount.textContent = `${beans.length - n} left`;
+        selectedCount.textContent = `${n} ${n === 1 ? 'bag' : 'bags'}`;
+      }
+
+      function toggle(bean) {
+        const adding = !selected.has(bean.id);
+        const update = () => {
+          adding ? selected.add(bean.id) : selected.delete(bean.id);
+          render();
+          // Moving the node drops focus; return it to the same card's button.
+          cards.get(bean.id).button.focus({ preventScroll: true });
+          status.textContent = `${bean.name} ${adding ? 'added to' : 'removed from'} your bean box.`;
+        };
+
+        if (document.startViewTransition) {
+          document.startViewTransition(update);
+        } else {
+          update();
+        }
+      }
+
+      render();
+    })();
+  </script>
+
 </body>
 
