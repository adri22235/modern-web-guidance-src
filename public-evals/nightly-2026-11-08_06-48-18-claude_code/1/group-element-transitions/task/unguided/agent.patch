+  <script>
+    (function () {
+      const BEANS = [
+        { id: 'ethiopia', name: 'Ethiopia Yirgacheffe', notes: 'Jasmine, lemon, bergamot', roast: 'Light', color: '#a0522d', price: 18 },
+        { id: 'colombia', name: 'Colombia Huila', notes: 'Caramel, red apple, cocoa', roast: 'Medium', color: '#7b4a2a', price: 16 },
+        { id: 'sumatra', name: 'Sumatra Mandheling', notes: 'Cedar, dark chocolate, earth', roast: 'Dark', color: '#3e2316', price: 17 },
+        { id: 'guatemala', name: 'Guatemala Antigua', notes: 'Toffee, spice, orange peel', roast: 'Medium', color: '#6b3e22', price: 17 },
+        { id: 'kenya', name: 'Kenya AA', notes: 'Blackcurrant, grapefruit, wine', roast: 'Light', color: '#94502c', price: 20 },
+        { id: 'brazil', name: 'Brazil Cerrado', notes: 'Peanut, milk chocolate, honey', roast: 'Medium-Dark', color: '#55311c', price: 15 }
+      ];
+
+      // Ids currently in the user's box, in the order they were added.
+      let selected = ['colombia', 'sumatra'];
+
+      const availableEl = document.getElementById('available-beans');
+      const selectedEl = document.getElementById('selected-beans');
+      const availableCount = document.getElementById('available-count');
+      const selectedCount = document.getElementById('selected-count');
+      const totalEl = document.getElementById('bean-total');
+      const clearBtn = document.getElementById('clear-beans');
+      const statusEl = document.getElementById('bean-status');
+
+      const byId = Object.fromEntries(BEANS.map(b => [b.id, b]));
+      const cards = new Map(); // id -> persistent <li> element
+
+      function buildCard(bean) {
+        const li = document.createElement('li');
+        li.className = 'bean-card';
+        li.dataset.id = bean.id;
+        // Unique name per card so the browser can track it between states;
+        // the shared `view-transition-class: bean-card` (in CSS) gives them all the same animation.
+        li.style.viewTransitionName = 'bean-' + bean.id;
+        li.innerHTML =
+          '<span class="bean-swatch" aria-hidden="true"></span>' +
+          '<div class="bean-info">' +
+            '<h4></h4>' +
+            '<div class="bean-meta"></div>' +
+          '</div>' +
+          '<button type="button" class="bean-btn"></button>';
+        li.querySelector('.bean-swatch').style.setProperty('--roast', bean.color);
+        li.querySelector('h4').textContent = bean.name;
+        li.querySelector('.bean-meta').textContent = bean.roast + ' roast · ' + bean.notes + ' · $' + bean.price;
+        return li;
+      }
+
+      function emptyState(text) {
+        const li = document.createElement('li');
+        li.className = 'bean-empty';
+        li.textContent = text;
+        return li;
+      }
+
+      function setButton(li, inSelection) {
+        const btn = li.querySelector('.bean-btn');
+        const name = byId[li.dataset.id].name;
+        btn.className = 'bean-btn ' + (inSelection ? 'remove' : 'add');
+        btn.textContent = inSelection ? 'Remove' : 'Add';
+        btn.setAttribute('aria-label', (inSelection ? 'Remove ' : 'Add ') + name);
+        btn.dataset.action = inSelection ? 'remove' : 'add';
+      }
+
+      function render() {
+        const available = BEANS.filter(b => !selected.includes(b.id));
+
+        availableEl.replaceChildren(
+          ...(available.length
+            ? available.map(b => { const c = cards.get(b.id); setButton(c, false); return c; })
+            : [emptyState('Every bean is in your box!')])
+        );
+
+        selectedEl.replaceChildren(
+          ...(selected.length
+            ? selected.map(id => { const c = cards.get(id); setButton(c, true); return c; })
+            : [emptyState('Your box is empty. Add some beans to get started.')])
+        );
+
+        availableCount.textContent = available.length + ' left';
+        selectedCount.textContent = selected.length + (selected.length === 1 ? ' bag' : ' bags');
+        const total = selected.reduce((sum, id) => sum + byId[id].price, 0);
+        totalEl.textContent = 'Total: $' + total.toFixed(2);
+        clearBtn.disabled = selected.length === 0;
+      }
+
+      // Run any DOM update inside a view transition so all bean cards
+      // animate simultaneously to their new positions.
+      function update(mutate, focusId) {
+        const apply = () => {
+          mutate();
+          render();
+        };
+        const restoreFocus = () => {
+          if (!focusId) return;
+          const btn = cards.get(focusId)?.querySelector('.bean-btn');
+          btn?.focus({ preventScroll: true });
+        };
+
+        if (!document.startViewTransition) {
+          apply();
+          restoreFocus();
+          return;
+        }
+        const transition = document.startViewTransition(apply);
+        transition.updateCallbackDone.then(restoreFocus);
+      }
+
+      BEANS.forEach(b => cards.set(b.id, buildCard(b)));
+
+      document.getElementById('bean-selection').addEventListener('click', e => {
+        const btn = e.target.closest('.bean-btn[data-action]');
+        if (!btn) return;
+        const id = btn.closest('.bean-card').dataset.id;
+        const name = byId[id].name;
+
+        if (btn.dataset.action === 'add') {
+          update(() => { selected = [...selected, id]; }, id);
+          statusEl.textContent = name + ' added to your box.';
+        } else {
+          update(() => { selected = selected.filter(s => s !== id); }, id);
+          statusEl.textContent = name + ' removed from your box.';
+        }
+      });
+
+      clearBtn.addEventListener('click', () => {
+        update(() => { selected = []; });
+        statusEl.textContent = 'All beans removed from your box.';
+      });
+
+      render();
+    })();
+  </script>
+
