+  <script>
+    (function () {
+      // Run a CSS exit animation (via class), then call done once it finishes.
+      // A timeout fallback guards against animationend never firing.
+      function animateOut(el, done) {
+        var finished = false;
+        function finish() {
+          if (finished) return;
+          finished = true;
+          el.removeEventListener('animationend', onEnd);
+          clearTimeout(timer);
+          el.classList.remove('is-closing');
+          done();
+        }
+        function onEnd(e) { if (e.target === el) finish(); }
+        el.classList.add('is-closing');
+        el.addEventListener('animationend', onEnd);
+        var timer = setTimeout(finish, 400);
+        // Return a cancel function (used if the element is re-opened mid-exit).
+        return function cancel() {
+          if (finished) return;
+          finished = true;
+          el.removeEventListener('animationend', onEnd);
+          clearTimeout(timer);
+          el.classList.remove('is-closing');
+        };
+      }
+
+      // ----- Logout confirmation modal -----
+      var dialog = document.getElementById('logout-dialog');
+      var openBtn = document.getElementById('open-dialog-btn');
+      var closeBtn = document.getElementById('close-dialog-btn');
+      var cancelBtn = dialog.querySelector('[data-dialog-cancel]');
+
+      function openDialog() {
+        if (dialog.open) return;
+        dialog.classList.remove('is-closing');
+        if (typeof dialog.showModal === 'function') {
+          dialog.showModal();
+        } else {
+          dialog.setAttribute('open', '');
+        }
+      }
+
+      function closeDialog() {
+        if (!dialog.open || dialog.classList.contains('is-closing')) return;
+        animateOut(dialog, function () {
+          if (typeof dialog.close === 'function') dialog.close();
+          else dialog.removeAttribute('open');
+          openBtn.focus();
+        });
+      }
+
+      openBtn.addEventListener('click', function (e) {
+        e.preventDefault();
+        openDialog();
+      });
+      closeBtn.addEventListener('click', closeDialog);
+      cancelBtn.addEventListener('click', closeDialog);
+
+      // Escape key: animate out instead of closing instantly.
+      dialog.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        closeDialog();
+      });
+
+      // Click on the backdrop (outside the content box) closes the modal.
+      dialog.addEventListener('click', function (e) {
+        if (e.target === dialog) closeDialog();
+      });
+
+      // ----- Floating info overlay -----
+      var overlay = document.getElementById('info-overlay');
+      var overlayTrigger = document.getElementById('foobar');
+      var overlayClose = document.getElementById('info-overlay-close');
+
+      var cancelOverlayExit = null;
+
+      function showOverlay() {
+        if (cancelOverlayExit) {
+          cancelOverlayExit();
+          cancelOverlayExit = null;
+        }
+        overlay.hidden = false;
+      }
+
+      function hideOverlay() {
+        if (overlay.hidden || overlay.classList.contains('is-closing')) return;
+        cancelOverlayExit = animateOut(overlay, function () {
+          cancelOverlayExit = null;
+          overlay.hidden = true;
+        });
+      }
+
+      overlayTrigger.addEventListener('click', showOverlay);
+      overlayClose.addEventListener('click', hideOverlay);
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && !dialog.open) hideOverlay();
+      });
+    })();
+  </script>
