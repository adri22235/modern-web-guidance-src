+  <dialog id="logout-dialog" class="modal" aria-labelledby="logout-title" aria-describedby="logout-desc" closedby="any">
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-desc">Are you sure you want to log out of your Daily Grind account?</p>
+    <div class="modal-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside id="offline-notice" class="floating-notice" popover role="status">
+    <strong>Heads up</strong>
+    online ordering is currently offline
+    <button type="button" class="notice-close" aria-label="Dismiss notice">&times;</button>
+  </aside>
+
+  <script type="module">
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      try {
+        await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+      } catch (err) {
+        console.warn('Popover polyfill failed to load', err);
+      }
+    }
+
+    // Firefox parses allow-discrete but can't transition display, so probe it.
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) return (supportsDisplayTransition = false);
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    const supportsTopLayerExit = () => window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+
+    // Plays the CSS exit transition before removing the element from the top layer.
+    async function closeTopLayer(el, close) {
+      if (!supportsTopLayerExit()) {
+        el.setAttribute('data-closing', '');
+        const animations = el.getAnimations({ subtree: true });
+        if (animations.length) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!el.hasAttribute('data-closing')) return;
+        el.removeAttribute('data-closing');
+      }
+      close();
+    }
+
+    // Logout confirmation modal
+    const dialog = document.getElementById('logout-dialog');
+    const closeDialog = () => closeTopLayer(dialog, () => dialog.close());
+
+    document.getElementById('open-dialog-btn').addEventListener('click', (e) => {
+      e.preventDefault();
+      dialog.removeAttribute('data-closing');
+      dialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+
+    // Esc / back gesture / closedby light dismiss: route through animated close.
+    dialog.addEventListener('cancel', (e) => {
+      e.preventDefault();
+      closeDialog();
+    });
+
+    // Light-dismiss fallback where closedby is unsupported (Safari).
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) closeDialog(); });
+    }
+
+    // Floating offline notice
+    const notice = document.getElementById('offline-notice');
+    const trigger = document.getElementById('foobar');
+    notice.querySelector('.notice-close').addEventListener('click', () => {
+      closeTopLayer(notice, () => {
+        notice.hidePopover();
+        trigger.focus(); // the close button disappears, so return focus to the trigger
+      });
+    });
+    notice.addEventListener('beforetoggle', (e) => {
+      if (e.newState === 'open') notice.removeAttribute('data-closing');
+    });
+  </script>
