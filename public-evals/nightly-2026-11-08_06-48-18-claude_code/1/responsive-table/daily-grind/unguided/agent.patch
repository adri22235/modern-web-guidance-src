+    /* Nutrition & Pricing Table */
+    .nutrition {
+      margin-top: 40px;
+    }
+
+    .nutrition h3 {
+      color: var(--primary);
+      text-align: center;
+      margin-bottom: 0.5rem;
+    }
+
+    .table-scroll {
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-scroll:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      min-width: 640px;
+      border-collapse: separate;
+      border-spacing: 0;
+      font-size: 0.95rem;
+    }
+
+    .nutrition-table caption {
+      caption-side: top;
+      text-align: left;
+      padding: 12px 16px;
+      font-size: 0.9rem;
+      color: var(--text);
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 16px;
+      border-bottom: 1px solid var(--secondary);
+      text-align: right;
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+      vertical-align: bottom;
+    }
+
+    .nutrition-table .unit {
+      display: block;
+      font-weight: normal;
+      font-size: 0.8rem;
+      opacity: 0.9;
+    }
+
+    /* Row headers (drink names) stay pinned while scrolling sideways */
+    .nutrition-table th[scope="row"],
+    .nutrition-table thead th:first-child {
+      position: sticky;
+      left: 0;
+      text-align: left;
+      z-index: 1;
+    }
+
+    .nutrition-table th[scope="row"] {
+      background: #efebe9;
+      color: var(--primary);
+      box-shadow: 2px 0 0 var(--secondary);
+    }
+
+    .nutrition-table thead th:first-child {
+      z-index: 2;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .nutrition-table tbody tr:hover td {
+      background: #fbf8f7;
+    }
+
+    .table-note {
+      font-size: 0.85rem;
+      margin-top: 10px;
+      text-align: center;
+    }
+
+    .scroll-hint {
+      display: none;
+      font-size: 0.85rem;
+      text-align: center;
+      margin-bottom: 8px;
+    }
+
+    @media (max-width: 680px) {
+      .scroll-hint {
+        display: block;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+      }
+    }
+
