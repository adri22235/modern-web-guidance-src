+  <script>
+    (function () {
+      var iframe = document.getElementById('roast-video');
+      var button = document.getElementById('theater-toggle');
+      var inlineSlot = document.getElementById('inline-slot');
+      var inlineDock = document.getElementById('inline-dock');
+      var theaterSlot = document.getElementById('theater-slot');
+      var theaterDock = document.getElementById('theater-dock');
+      var theater = false;
+
+      // Element.prototype.moveBefore() (Chrome 133+, Firefox 144+) moves a node
+      // without the remove/insert cycle, so the iframe keeps its browsing context
+      // (no reload, playback continues) and focus is preserved.
+      var hasMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      // ---- Fallback for browsers without moveBefore ---------------------------
+      // A classic appendChild() move unloads and reloads the iframe. To soften that,
+      // we track playback via the YouTube IFrame API and, on move, reload the embed
+      // at the same timestamp (and autoplay it if it was playing).
+      var player = null;
+
+      function attachPlayer() {
+        if (!window.YT || !YT.Player) return;
+        player = new YT.Player(iframe);
+      }
+
+      if (!hasMoveBefore) {
+        var prevReady = window.onYouTubeIframeAPIReady;
+        window.onYouTubeIframeAPIReady = function () {
+          if (typeof prevReady === 'function') prevReady();
+          attachPlayer();
+        };
+        var tag = document.createElement('script');
+        tag.src = 'https://www.youtube.com/iframe_api';
+        tag.async = true;
+        document.head.appendChild(tag);
+      }
+
+      function readPlaybackState() {
+        try {
+          if (player && typeof player.getCurrentTime === 'function') {
+            var ps = player.getPlayerState();
+            return {
+              time: player.getCurrentTime() || 0,
+              playing: ps === YT.PlayerState.PLAYING || ps === YT.PlayerState.BUFFERING
+            };
+          }
+        } catch (e) { /* player not ready / cross-origin hiccup */ }
+        return null;
+      }
+
+      function fallbackMove(node, parent) {
+        if (node !== iframe) {
+          parent.appendChild(node);
+          return;
+        }
+        var state = readPlaybackState();
+        // Detach first so the src update and re-insertion cause a single load.
+        if (iframe.parentNode) iframe.parentNode.removeChild(iframe);
+        if (state) {
+          var url = new URL(iframe.src);
+          url.searchParams.set('start', String(Math.floor(state.time)));
+          url.searchParams.set('autoplay', state.playing ? '1' : '0');
+          iframe.src = url.toString();
+        }
+        parent.appendChild(iframe);
+        // The old player is bound to the unloaded document; bind a fresh one.
+        player = null;
+        attachPlayer();
+      }
+
+      function move(node, parent) {
+        if (hasMoveBefore) {
+          try {
+            parent.moveBefore(node, null);
+            return;
+          } catch (e) {
+            // e.g. moving between disconnected trees; fall through.
+          }
+        }
+        fallbackMove(node, parent);
+      }
+
+      function setTheater(on) {
+        if (on === theater) return;
+        theater = on;
+        var hadFocus = document.activeElement === button;
+
+        move(iframe, on ? theaterSlot : inlineSlot);
+        move(button, on ? theaterDock : inlineDock);
+
+        document.body.classList.toggle('theater-mode', on);
+        button.setAttribute('aria-pressed', String(on));
+        button.textContent = on ? 'Exit theater mode' : 'Theater mode';
+        if (hadFocus && document.activeElement !== button) button.focus({ preventScroll: true });
+
+        if (on) {
+          window.scrollTo({ top: 0, behavior: 'smooth' }); // hero sits directly under the sticky nav
+        } else {
+          inlineDock.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        }
+      }
+
+      button.addEventListener('click', function () { setTheater(!theater); });
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && theater) setTheater(false);
+      });
+    })();
+  </script>
