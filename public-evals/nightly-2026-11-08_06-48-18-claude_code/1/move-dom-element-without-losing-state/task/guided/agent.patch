+  <script>
+    (() => {
+      const frame = document.getElementById('video-frame');
+      const iframe = document.getElementById('roast-video');
+      const homeSlot = document.getElementById('video-home-slot');
+      const heroSlot = document.getElementById('hero-theater-slot');
+      const hero = document.getElementById('hero');
+      const section = document.getElementById('video-section');
+      const toggle = document.getElementById('theater-toggle');
+      const status = document.getElementById('theater-status');
+
+      const supportsMoveBefore = 'moveBefore' in Element.prototype;
+
+      // --- Fallback playback tracking (only needed without moveBefore) ---
+      // Older browsers reload an <iframe> whenever it is detached and re-inserted.
+      // We listen to the YouTube embed's postMessage events (enabled via
+      // enablejsapi=1) so we can resume at the same time after the reload.
+      const player = { time: 0, playing: false };
+      const YT_ORIGINS = ['https://www.youtube-nocookie.com', 'https://www.youtube.com'];
+
+      function startListening() {
+        iframe.contentWindow?.postMessage(
+          JSON.stringify({ event: 'listening', id: iframe.id, channel: 'widget' }), '*');
+      }
+
+      if (!supportsMoveBefore) {
+        window.addEventListener('message', (e) => {
+          if (e.source !== iframe.contentWindow || !YT_ORIGINS.includes(e.origin)) return;
+          let data;
+          try { data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch { return; }
+          const info = data && data.info;
+          if (!info) return;
+          if (typeof info.currentTime === 'number') player.time = info.currentTime;
+          if (typeof info.playerState === 'number') player.playing = info.playerState === 1;
+          if (data.event === 'onStateChange' && typeof info === 'number') player.playing = info === 1;
+        });
+        // Re-handshake every time the embed (re)loads.
+        iframe.addEventListener('load', startListening);
+        startListening();
+      }
+
+      function fallbackMove(target) {
+        // Rewrite src so the inevitable reload resumes where the viewer left off.
+        const url = new URL(iframe.src);
+        if (player.time > 1) url.searchParams.set('start', String(Math.floor(player.time)));
+        if (player.playing) url.searchParams.set('autoplay', '1');
+        else url.searchParams.delete('autoplay');
+        iframe.src = url.toString();
+        target.appendChild(frame);
+      }
+
+      function moveVideo(target) {
+        if (frame.parentNode === target) return;
+        if (supportsMoveBefore) {
+          // Atomic move: the iframe keeps its browsing context, so no reload
+          // and no interruption of playback.
+          target.moveBefore(frame, null);
+        } else {
+          fallbackMove(target);
+        }
+      }
+
+      toggle.addEventListener('click', () => {
+        const entering = toggle.getAttribute('aria-pressed') !== 'true';
+        moveVideo(entering ? heroSlot : homeSlot);
+        hero.classList.toggle('is-theater', entering);
+        section.classList.toggle('is-theater', entering);
+        toggle.setAttribute('aria-pressed', String(entering));
+        toggle.textContent = entering ? 'Exit theater mode' : 'Theater mode';
+        status.textContent = entering
+          ? 'Video moved to theater mode at the top of the page.'
+          : 'Video returned to its original position.';
+        (entering ? hero : section).scrollIntoView({
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
+          block: 'start',
+        });
+      });
+    })();
+  </script>
