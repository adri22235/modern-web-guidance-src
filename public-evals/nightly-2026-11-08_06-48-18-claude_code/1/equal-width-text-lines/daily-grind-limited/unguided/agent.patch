+  <script>
+    // Measure each lockup line at a reference size and store the ratio of
+    // font-size to line width. CSS multiplies that by the container width,
+    // so resizing needs no further JS; we only re-measure when fonts change.
+    (function () {
+      var REF = 100;
+      function fit() {
+        document.querySelectorAll('.lockup__line').forEach(function (line) {
+          line.style.setProperty('font-size', REF + 'px');
+          var range = document.createRange();
+          range.selectNodeContents(line);
+          var textW = range.getBoundingClientRect().width;
+          line.style.removeProperty('font-size');
+          if (textW > 0) line.style.setProperty('--fit', (REF / textW).toFixed(5));
+        });
+      }
+      fit();
+      if (document.fonts) {
+        document.fonts.ready.then(fit);
+        document.fonts.addEventListener && document.fonts.addEventListener('loadingdone', fit);
+      }
+    })();
+  </script>
