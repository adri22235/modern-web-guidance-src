+  <script type="module">
+    // Fills gaps in PublicKeyCredential.parseRequestOptionsFromJSON / toJSON on older browsers.
+    import 'https://esm.sh/webauthn-polyfills@0.1.7';
+
+    const button = document.getElementById('reauth-btn');
+    const statusEl = document.getElementById('reauth-status');
+    let reauthAbortController = new AbortController();
+
+    function setStatus(message, state = '') {
+      statusEl.textContent = message;
+      statusEl.dataset.state = state;
+    }
+
+    async function triggerButtonReauth() {
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        setStatus('This browser does not support passkeys, so identity verification is unavailable.', 'error');
+        return;
+      }
+
+      // Cancel any in-flight WebAuthn request to avoid prompt collisions.
+      reauthAbortController.abort();
+      reauthAbortController = new AbortController();
+
+      button.disabled = true;
+      setStatus('Waiting for passkey verification…');
+
+      try {
+        // Server returns a fresh challenge with allowCredentials limited to the signed-in user's passkeys.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { Accept: 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error(`Could not start verification (HTTP ${optionsResponse.status}).`);
+        }
+        const optionsJSON = await optionsResponse.json();
+
+        // Reauthentication must be scoped to the current user's credentials. An empty list would
+        // fall back to discoverable credentials and could let a different account's passkey answer.
+        if (!Array.isArray(optionsJSON.allowCredentials) || optionsJSON.allowCredentials.length === 0) {
+          throw new Error('No passkeys are registered for this account. Add a passkey before making sensitive changes.');
+        }
+
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: reauthAbortController.signal,
+        });
+        if (!credential) {
+          throw new Error('No credential was returned.');
+        }
+
+        const encodedCredential = credential.toJSON();
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+          body: JSON.stringify(encodedCredential),
+        });
+
+        if (verifyResponse.ok) {
+          setStatus('Identity confirmed. You can now update your account settings.', 'success');
+          document.dispatchEvent(new CustomEvent('reauth:success'));
+          return;
+        }
+
+        if (verifyResponse.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+          // Tell the password manager this passkey no longer exists on the server.
+          // Always use the server-provided rpId, never window.location.hostname.
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rpId,
+            credentialId: encodedCredential.id,
+          }).catch(() => {});
+        }
+        throw new Error('We could not verify your identity. Please try again.');
+      } catch (err) {
+        if (err.name === 'AbortError') {
+          return; // Superseded by a newer attempt.
+        }
+        if (err.name === 'NotAllowedError') {
+          setStatus('Verification was cancelled or timed out.', 'error');
+        } else {
+          setStatus(err.message || 'Verification failed.', 'error');
+        }
+      } finally {
+        button.disabled = false;
+      }
+    }
+
+    button.addEventListener('click', triggerButtonReauth);
+  </script>
+
