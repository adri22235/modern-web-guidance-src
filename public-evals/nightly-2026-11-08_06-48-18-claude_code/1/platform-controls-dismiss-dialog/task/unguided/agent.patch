+  <script>
+    (function () {
+      var supportsDialog = typeof HTMLDialogElement === 'function' &&
+        typeof HTMLDialogElement.prototype.showModal === 'function';
+      var activeDialog = null;   // dialog currently open
+      var returnFocusTo = null;  // element to refocus after closing
+      var historyEntryPushed = false;
+
+      // A reload while a dialog entry is current would leave a stale entry; clear it.
+      if (history.state && history.state.drinkDialog) {
+        history.replaceState(null, '');
+      }
+
+      function openDialog(dialog, trigger) {
+        if (!supportsDialog) {
+          // Very old browsers: fall back to the full menu page.
+          var link = dialog.querySelector('.dialog-actions a[href]');
+          if (link) window.location.href = link.href;
+          return;
+        }
+        if (activeDialog) return;
+        activeDialog = dialog;
+        returnFocusTo = trigger;
+        dialog.showModal(); // native modal: focus trap, inert background, Escape to close
+        if (trigger) trigger.setAttribute('aria-expanded', 'true');
+
+        // Add a history entry so the mobile back gesture / browser Back button
+        // dismisses the dialog instead of leaving the page.
+        history.pushState({ drinkDialog: dialog.id }, '');
+        historyEntryPushed = true;
+      }
+
+      function handleClosed(dialog) {
+        if (dialog !== activeDialog) return;
+        activeDialog = null;
+
+        // Closed via Escape, close button, backdrop, or a platform CloseWatcher:
+        // remove the history entry we added so Back behaves normally afterwards.
+        if (historyEntryPushed) {
+          historyEntryPushed = false;
+          if (history.state && history.state.drinkDialog === dialog.id) {
+            history.back();
+          }
+        }
+
+        if (returnFocusTo) {
+          returnFocusTo.setAttribute('aria-expanded', 'false');
+          returnFocusTo.focus();
+          returnFocusTo = null;
+        }
+      }
+
+      document.querySelectorAll('[data-dialog-target]').forEach(function (trigger) {
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.addEventListener('click', function () {
+          var dialog = document.getElementById(trigger.getAttribute('data-dialog-target'));
+          if (dialog) openDialog(dialog, trigger);
+        });
+      });
+
+      document.querySelectorAll('.drink-dialog').forEach(function (dialog) {
+        dialog.addEventListener('close', function () { handleClosed(dialog); });
+
+        dialog.addEventListener('click', function (event) {
+          // Close buttons
+          if (event.target.closest('[data-dialog-close]')) {
+            dialog.close();
+            return;
+          }
+          // Clicks on the backdrop target the <dialog> itself, outside its content box.
+          if (event.target === dialog) {
+            var rect = dialog.getBoundingClientRect();
+            var inside = event.clientX >= rect.left && event.clientX <= rect.right &&
+              event.clientY >= rect.top && event.clientY <= rect.bottom;
+            if (!inside) dialog.close();
+          }
+        });
+      });
+
+      // Browser Back button / mobile back gesture.
+      window.addEventListener('popstate', function () {
+        if (activeDialog && historyEntryPushed) {
+          historyEntryPushed = false; // entry already popped by the browser
+          activeDialog.close();
+        }
+      });
+    })();
+  </script>
