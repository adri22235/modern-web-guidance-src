+        return li;
+      }));
+    }
+
+    let worker;
+    let renderId = 0;
+
+    function render(colors) {
+      // Restart the worker so a new click cancels any render still in progress.
+      worker?.terminate();
+      worker = new Worker(new URL('./smallpt-worker.js', import.meta.url), { type: 'module' });
+
+      const id = ++renderId;
+      const spp = Number(sppSelect.value);
+      const { width, height } = canvas;
+      showSwatches(colors);
+      progress.value = 0;
+      status.textContent = `Rendering at ${spp} samples/pixel…`;
+
+      worker.onmessage = ({ data }) => {
+        if (data.id !== id) return;
+        ctx.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+        progress.value = data.progress;
+        if (data.progress >= 1) {
