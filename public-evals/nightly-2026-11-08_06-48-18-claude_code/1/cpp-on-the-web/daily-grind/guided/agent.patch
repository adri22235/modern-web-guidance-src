+
+    // Sphere indices in smallpt's scene. (3 = front wall behind the camera, 8 = light.)
+    const SPHERES = [
+      { index: 0, name: 'Left wall', rgb: [0.75, 0.25, 0.25], kind: 'wall' },
+      { index: 1, name: 'Right wall', rgb: [0.25, 0.25, 0.75], kind: 'wall' },
+      { index: 2, name: 'Back wall', rgb: [0.75, 0.75, 0.75], kind: 'wall' },
+      { index: 4, name: 'Floor', rgb: [0.75, 0.75, 0.75], kind: 'wall' },
+      { index: 5, name: 'Ceiling', rgb: [0.75, 0.75, 0.75], kind: 'wall' },
+      { index: 6, name: 'Mirror ball', rgb: [0.999, 0.999, 0.999], kind: 'ball' },
+      { index: 7, name: 'Glass ball', rgb: [0.999, 0.999, 0.999], kind: 'ball' },
+    ];
+
+    function hslToRgb(h, s, l) {
+      const k = (n) => (n + h / 30) % 12;
+      const a = s * Math.min(l, 1 - l);
+      const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+      return [f(0), f(8), f(4)];
+    }
+
+    function randomColors() {
+      return SPHERES.map((sphere) => {
+        // Walls stay at or below smallpt's original 0.75 albedo so the scene keeps
+        // converging nicely; the balls get lighter tints so they stay reflective.
+        const [lightness, max] = sphere.kind === 'wall' ? [0.3 + Math.random() * 0.3, 0.75] : [0.75 + Math.random() * 0.15, 0.999];
+        const rgb = hslToRgb(Math.random() * 360, 0.4 + Math.random() * 0.6, lightness);
+        return { ...sphere, rgb: rgb.map((c) => Math.min(c, max)) };
+      });
+    }
+
+    function showSwatches(colors) {
+      swatches.replaceChildren(...colors.map(({ name, rgb }) => {
+        const li = document.createElement('li');
+        const dot = document.createElement('span');
+        dot.style.background = `rgb(${rgb.map((c) => Math.round(c ** (1 / 2.2) * 255)).join(' ')})`;
