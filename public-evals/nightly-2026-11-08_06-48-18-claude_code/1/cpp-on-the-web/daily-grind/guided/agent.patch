diff --git a/smallpt-worker.js b/smallpt-worker.js
new file mode 100644
index 0000000..2385eca
--- /dev/null
+++ b/smallpt-worker.js
@@ -0,0 +1,38 @@
+// Module Web Worker that runs the smallpt WebAssembly path tracer off the main thread.
+import initSmallpt from './wasm/smallpt.js';
+
+const wasmReady = initSmallpt();
+const BAND = 8; // rows rendered per Wasm call, between progress updates
+
+self.onmessage = async ({ data }) => {
+  const { id, width, height, spp, colors } = data;
+  const wasm = await wasmReady;
+
+  wasm._reset_sphere_colors();
+  for (const { index, rgb } of colors ?? []) {
+    wasm._set_sphere_color(index, rgb[0], rgb[1], rgb[2]);
+  }
+
+  const ptr = wasm._begin_render(width, height, spp);
+  const byteLength = width * height * 4;
+  const start = performance.now();
+
+  // smallpt renders scanlines bottom-up (y=0 is the bottom image row).
+  for (let y = 0; y < height; y += BAND) {
+    wasm._render_rows(y, y + BAND);
+    const done = Math.min(y + BAND, height);
+    // Re-read HEAPU8 after each call: memory growth would detach the old buffer.
+    const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, ptr, byteLength).slice();
+    self.postMessage(
+      {
+        id,
+        pixels,
+        width,
+        height,
+        progress: done / height,
+        elapsed: performance.now() - start,
+      },
+      [pixels.buffer],
+    );
+  }
+};
