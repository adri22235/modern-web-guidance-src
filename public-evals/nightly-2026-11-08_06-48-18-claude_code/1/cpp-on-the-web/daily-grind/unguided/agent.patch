+// smallpt, a Path Tracer by Kevin Beason, 2008 — http://www.kevinbeason.com/smallpt/
+// Original is released under the MIT license. Adapted for WebAssembly:
+//  - main() replaced with an exported progressive-rendering API
+//  - erand48 replaced with a portable xorshift RNG (one state per call)
+//  - sphere colors are configurable from JavaScript
+//  - recursion depth hard-capped to keep the wasm stack bounded
+#include <math.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <emscripten/emscripten.h>
+
+static inline double rnd(uint64_t *s) {  // xorshift64*, returns [0,1)
+  uint64_t x = *s; x ^= x >> 12; x ^= x << 25; x ^= x >> 27; *s = x;
+  return ((x * 2685821657736338717ULL) >> 11) * (1.0 / 9007199254740992.0);
+}
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+  Vec operator%(const Vec &b) const { return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x); }
+};
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };
+struct Sphere {
+  double rad; Vec p, e, c; Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p-r.o;
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+static Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite
+};
+static const int NUM_SPHERES = sizeof(spheres)/sizeof(Sphere);
+
+static inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+static inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+static inline bool intersect(const Ray &r, double &t, int &id){
+  double d, inf=t=1e20;
+  for(int i=NUM_SPHERES;i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+static Vec radiance(const Ray &r, int depth, uint64_t *Xi){
+  double t; int id=0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z;
+  if (++depth>5) { if (rnd(Xi)<p && depth<64) f=f*(1/p); else return obj.e; }
+  if (obj.refl == DIFF){
+    double r1=2*M_PI*rnd(Xi), r2=rnd(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));
+  bool into = n.dot(nl)>0;
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c=1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c, Tr=1-Re, P=.25+.5*Re, RP=Re/P, TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (rnd(Xi)<P ?
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// ---- Exported progressive API ----
+static int W = 0, H = 0, passes = 0;
+static Vec *accum = 0;
+static uint8_t *rgba = 0;
+
+extern "C" {
+EMSCRIPTEN_KEEPALIVE void set_sphere_color(int i, double r, double g, double b){
+  if (i>=0 && i<NUM_SPHERES) spheres[i].c = Vec(r,g,b);
+}
+EMSCRIPTEN_KEEPALIVE int num_spheres(){ return NUM_SPHERES; }
+
+EMSCRIPTEN_KEEPALIVE int init(int w, int h){
+  free(accum); free(rgba);
+  W=w; H=h; passes=0;
+  accum = (Vec*)calloc((size_t)w*h*4, sizeof(Vec));  // 4 subpixels per pixel
+  rgba = (uint8_t*)malloc((size_t)w*h*4);
+  return accum && rgba;
+}
+
+// One pass = 2x2 subpixels x 1 sample each (4 samples per pixel), as in smallpt.
+// After N passes the image equals smallpt run with N*4 samples per pixel.
+// Returns pointer to an RGBA8 buffer holding the running average (top row first).
+EMSCRIPTEN_KEEPALIVE uint8_t* render_pass(uint32_t seed){
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(W*.5135/H), cy=(cx%cam.d).norm()*.5135;
+  passes++;
+  for (int y=0; y<H; y++){
+    uint64_t Xi = ((uint64_t)seed<<32) ^ (uint64_t)(y*2654435761u + 1) ^ 0x9E3779B97F4A7C15ULL;
+    for (int k=0;k<4;k++) rnd(&Xi);
+    for (int x=0; x<W; x++){
+      int i=(H-y-1)*W+x;  // flip so row 0 is the top
+      Vec c;
+      for (int sy=0, s=0; sy<2; sy++) for (int sx=0; sx<2; sx++, s++){
+        double r1=2*rnd(&Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+        double r2=2*rnd(&Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+        Vec d = cx*(((sx+.5+dx)/2+x)/W-.5) + cy*(((sy+.5+dy)/2+y)/H-.5) + cam.d;
+        Vec &a = accum[i*4+s];
+        a = a + radiance(Ray(cam.o+d*140,d.norm()),0,&Xi);
+        // As in smallpt: clamp the per-subpixel *average*, then box-filter the 4 subpixels
+        Vec r = a*(1.0/passes);
+        c = c + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+      rgba[i*4]=toInt(c.x); rgba[i*4+1]=toInt(c.y); rgba[i*4+2]=toInt(c.z); rgba[i*4+3]=255;
+    }
+  }
+  return rgba;
+}
+}
diff --git a/wasm/smallpt-worker.js b/wasm/smallpt-worker.js
new file mode 100644
index 0000000..532dcd9
--- /dev/null
+++ b/wasm/smallpt-worker.js
@@ -0,0 +1,26 @@
+// Web Worker that drives the smallpt WebAssembly module progressively,
+// posting the running-average image back to the page after every pass.
+importScripts('smallpt.js');
+
+const modReady = createSmallpt();
+let job = 0; // incremented on every new render; stale loops bail out
+
+self.onmessage = async (e) => {
+  const { width, height, maxPasses, colors } = e.data;
+  const m = await modReady;
+  const id = ++job;
+  colors.forEach(([r, g, b], i) => m._set_sphere_color(i, r, g, b));
+  if (!m._init(width, height)) { self.postMessage({ type: 'error', message: 'Out of memory' }); return; }
+  const start = performance.now();
+  for (let pass = 1; pass <= maxPasses; pass++) {
+    const ptr = m._render_pass((Math.random() * 0xffffffff) >>> 0);
+    if (id !== job) return;
+    // Copy out of wasm memory (it may grow/move) and transfer to the page.
+    const pixels = m.HEAPU8.slice(ptr, ptr + width * height * 4);
+    self.postMessage({ type: 'frame', pixels, width, height, spp: pass * 4,
+      done: pass === maxPasses, ms: performance.now() - start }, [pixels.buffer]);
+    // Yield so a new "render" message can preempt this loop.
+    await new Promise((r) => setTimeout(r, 0));
+    if (id !== job) return;
+  }
+};
