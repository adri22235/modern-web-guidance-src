+  <script>
+    (() => {
+      const WIDTH = 320, HEIGHT = 240, MAX_PASSES = 64; // 64 passes x 4 = 256 spp
+      // smallpt scene order: Left, Right, Back, Front, Bottom, Top, Mirror, Glass, Light
+      const DEFAULT_COLORS = [
+        [.75, .25, .25], [.25, .25, .75], [.75, .75, .75], [0, 0, 0],
+        [.75, .75, .75], [.75, .75, .75], [.999, .999, .999], [.999, .999, .999], [0, 0, 0],
+      ];
+
+      const canvas = document.getElementById('smallpt-canvas');
+      const ctx = canvas.getContext('2d');
+      const button = document.getElementById('smallpt-randomize');
+      const status = document.getElementById('smallpt-status');
+
+      const hsv = (h, s, v) => {
+        const f = (n) => { const k = (n + h * 6) % 6; return v - v * s * Math.max(0, Math.min(k, 4 - k, 1)); };
+        return [f(5), f(3), f(1)];
+      };
+      const rand = (a, b) => a + Math.random() * (b - a);
+      const randomColors = () => [
+        hsv(Math.random(), rand(.5, .85), .75),      // left wall
+        hsv(Math.random(), rand(.5, .85), .75),      // right wall
+        hsv(Math.random(), rand(0, .35), .75),       // back wall
+        [0, 0, 0],                                   // front (behind camera)
+        hsv(Math.random(), rand(0, .35), .75),       // floor
+        hsv(Math.random(), rand(0, .25), .75),       // ceiling
+        hsv(Math.random(), rand(.15, .6), .999),     // mirror sphere tint
+        hsv(Math.random(), rand(.15, .6), .999),     // glass sphere tint
+        [0, 0, 0],                                   // light (emissive only)
+      ];
+
+      if (typeof WebAssembly !== 'object' || typeof Worker !== 'function') {
+        status.textContent = 'Your browser does not support WebAssembly workers.';
+        button.disabled = true;
+        return;
+      }
+
+      const worker = new Worker('wasm/smallpt-worker.js');
+      worker.onmessage = ({ data }) => {
+        if (data.type === 'error') { status.textContent = 'Error: ' + data.message; return; }
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), data.width, data.height), 0, 0);
+        const secs = (data.ms / 1000).toFixed(1);
+        status.textContent = data.done
+          ? `Done: ${data.spp} samples/pixel in ${secs}s`
+          : `Rendering… ${data.spp} samples/pixel (${secs}s)`;
+      };
+      worker.onerror = (e) => { status.textContent = 'Failed to load path tracer: ' + (e.message || 'unknown error'); };
+
+      const render = (colors) => {
+        status.textContent = 'Rendering…';
+        worker.postMessage({ width: WIDTH, height: HEIGHT, maxPasses: MAX_PASSES, colors });
+      };
+      button.addEventListener('click', () => render(randomColors()));
+      render(DEFAULT_COLORS);
+    })();
+  </script>
+
