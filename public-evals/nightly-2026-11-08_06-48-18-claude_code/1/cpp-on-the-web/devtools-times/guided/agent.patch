diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..956e727
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,45 @@
+// Module worker that runs the smallpt WebAssembly path tracer off the main thread.
+// Message in:  { width, height, spp, colors?: Array<[r, g, b] | null> }
+// Messages out: { type: 'progress', pixels, rowsDone, height } (pixels transferred)
+//               { type: 'done', pixels, ms }  |  { type: 'error', message }
+import createSmallpt from './smallpt.js';
+
+const modulePromise = createSmallpt();
+const ROWS_PER_CHUNK = 8;
+
+self.onmessage = async ({ data }) => {
+  try {
+    const wasm = await modulePromise;
+    const { width, height, spp, colors } = data;
+
+    wasm._reset_sphere_colors();
+    colors?.forEach((c, i) => {
+      if (c) wasm._set_sphere_color(i, c[0], c[1], c[2]);
+    });
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._begin_render(width, height, spp);
+    const start = performance.now();
+
+    // smallpt's y = 0 is the bottom row, so render from the top (y = height-1)
+    // down for a natural progressive reveal.
+    for (let rowsDone = 0; rowsDone < height; ) {
+      const n = Math.min(ROWS_PER_CHUNK, height - rowsDone);
+      const yTop = height - rowsDone;
+      wasm._render_rows(yTop - n, yTop);
+      rowsDone += n;
+
+      // Read HEAPU8 fresh after the call (memory growth can detach the old buffer).
+      const pixels = wasm.HEAPU8.slice(ptr, ptr + byteLength);
+      const done = rowsDone === height;
+      self.postMessage(
+        done
+          ? { type: 'done', pixels, ms: performance.now() - start }
+          : { type: 'progress', pixels, rowsDone, height },
+        [pixels.buffer],
+      );
+    }
+  } catch (err) {
+    self.postMessage({ type: 'error', message: String(err?.message ?? err) });
+  }
+};
diff --git a/src/components/SmallptRender.astro b/src/components/SmallptRender.astro
new file mode 100644
index 0000000..47b3aa8
--- /dev/null
+++ b/src/components/SmallptRender.astro
@@ -0,0 +1,181 @@
+---
+// Client-side path tracing demo: Kevin Beason's smallpt compiled to WebAssembly
+// (see /wasm). The heavy lifting runs in a Web Worker so the page stays responsive.
+const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+const workerUrl = `${base}smallpt/worker.js`;
+const WIDTH = 400;
+const HEIGHT = 300;
+---
+<section class="p-4 md:p-6" data-smallpt data-worker-url={workerUrl}>
+    <h2 class="text-3xl font-bold border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+        Rendered in Your Browser
+    </h2>
+
+    <div class="grid md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-6 items-start">
+        <figure class="m-0">
+            <canvas
+                width={WIDTH}
+                height={HEIGHT}
+                class="w-full h-auto bg-gray-900 [image-rendering:pixelated]"
+                style={`aspect-ratio: ${WIDTH} / ${HEIGHT}`}
+                role="img"
+                aria-label="Path-traced Cornell box with a mirror sphere and a glass sphere"
+                data-canvas
+            ></canvas>
+            <figcaption class="text-xs text-gray-500 mt-2">
+                <a href="http://www.kevinbeason.com/smallpt/" class="underline hover:text-amber-400">smallpt</a>,
+                Kevin Beason's 99-line C++ path tracer, compiled to WebAssembly and running in a Web Worker on your device.
+            </figcaption>
+        </figure>
+
+        <div class="space-y-4">
+            <p class="text-gray-700">
+                Every pixel here comes from tracing random light paths through a Cornell box scene.
+                Nothing is downloaded except about 30&nbsp;KB of WebAssembly. Your own CPU does the rendering.
+            </p>
+
+            <label class="block text-sm font-medium text-gray-700">
+                Quality
+                <select data-spp class="mt-1 block w-full border border-gray-300 rounded px-2 py-1.5 bg-white">
+                    <option value="16" selected>Draft: 16 samples per pixel</option>
+                    <option value="64">Good: 64 samples per pixel</option>
+                    <option value="256">High: 256 samples per pixel (slow)</option>
+                </select>
+            </label>
+
+            <button
+                type="button"
+                data-randomize
+                class="w-full bg-gray-900 text-white font-semibold px-4 py-2 rounded hover:bg-amber-400 hover:text-gray-900 transition-colors disabled:opacity-60 disabled:cursor-wait"
+            >
+                Render again with random sphere colors
+            </button>
+
+            <ul data-swatches class="flex flex-wrap gap-2" aria-label="Current sphere colors"></ul>
+
+            <div>
+                <progress data-progress max="100" value="0" class="w-full h-2 accent-amber-400"></progress>
+                <p data-status class="text-sm text-gray-600 mt-1" role="status" aria-live="polite">Loading renderer…</p>
+            </div>
+        </div>
+    </div>
+</section>
+
+<script>
+    type RGB = [number, number, number];
+
+    // Sphere indices in smallpt's scene array.
+    const SPHERES = [
+        { id: 0, name: 'Left wall', kind: 'diffuse', default: [0.75, 0.25, 0.25] },
+        { id: 1, name: 'Right wall', kind: 'diffuse', default: [0.25, 0.25, 0.75] },
+        { id: 2, name: 'Back wall', kind: 'diffuse', default: [0.75, 0.75, 0.75] },
+        { id: 4, name: 'Floor', kind: 'diffuse', default: [0.75, 0.75, 0.75] },
+        { id: 5, name: 'Ceiling', kind: 'diffuse', default: [0.75, 0.75, 0.75] },
+        { id: 6, name: 'Mirror sphere', kind: 'tint', default: [0.999, 0.999, 0.999] },
+        { id: 7, name: 'Glass sphere', kind: 'tint', default: [0.999, 0.999, 0.999] },
+    ] as const;
+
+    function hslToRgb(h: number, s: number, l: number): RGB {
+        const k = (n: number) => (n + h / 30) % 12;
+        const a = s * Math.min(l, 1 - l);
+        const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+        return [f(0), f(8), f(4)];
+    }
+
+    function randomColor(kind: 'diffuse' | 'tint'): RGB {
+        const h = Math.random() * 360;
+        // Diffuse albedo stays below 1 to keep energy conservation; tints stay bright
+        // so the mirror/glass spheres still read as mirror and glass.
+        const rgb = kind === 'diffuse'
+            ? hslToRgb(h, 0.35 + Math.random() * 0.5, 0.3 + Math.random() * 0.35)
+            : hslToRgb(h, 0.4 + Math.random() * 0.5, 0.7 + Math.random() * 0.15);
+        return rgb.map((v) => Math.min(0.999, v)) as RGB;
+    }
+
+    const toCss = ([r, g, b]: RGB) =>
+        `rgb(${[r, g, b].map((v) => Math.round(Math.pow(v, 1 / 2.2) * 255)).join(' ')})`;
+
+    function initSmallpt(root: HTMLElement) {
+        const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
+        const ctx = canvas.getContext('2d')!;
+        const button = root.querySelector<HTMLButtonElement>('[data-randomize]')!;
+        const sppSelect = root.querySelector<HTMLSelectElement>('[data-spp]')!;
+        const swatches = root.querySelector<HTMLUListElement>('[data-swatches]')!;
+        const progress = root.querySelector<HTMLProgressElement>('[data-progress]')!;
+        const status = root.querySelector<HTMLElement>('[data-status]')!;
+        const workerUrl = root.dataset.workerUrl!;
+        const { width, height } = canvas;
+
+        let worker: Worker | null = null;
+
+        function showSwatches(colors: { name: string; rgb: RGB }[]) {
+            swatches.replaceChildren(
+                ...colors.map(({ name, rgb }) => {
+                    const li = document.createElement('li');
+                    li.className = 'flex items-center gap-1.5 text-xs text-gray-600';
+                    const dot = document.createElement('span');
+                    dot.className = 'inline-block size-4 rounded-full border border-gray-300';
+                    dot.style.background = toCss(rgb);
+                    li.append(dot, name);
+                    return li;
+                }),
+            );
+        }
+
+        function render(randomize: boolean) {
+            // Cancel any in-flight render by replacing the worker.
+            worker?.terminate();
+            worker = new Worker(workerUrl, { type: 'module' });
+
+            const chosen = SPHERES.map((s) => ({
+                ...s,
+                rgb: (randomize ? randomColor(s.kind) : [...s.default]) as RGB,
+            }));
+            const colors: (RGB | null)[] = [];
+            chosen.forEach((s) => (colors[s.id] = s.rgb));
+            showSwatches(chosen);
+
+            const spp = Number(sppSelect.value);
+            button.disabled = true;
+            progress.value = 0;
+            status.textContent = `Rendering ${width}×${height} at ${spp} samples per pixel…`;
+
+            worker.onmessage = ({ data }) => {
+                if (data.type === 'error') {
+                    status.textContent = `Render failed: ${data.message}`;
+                    button.disabled = false;
+                    return;
+                }
+                ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), width, height), 0, 0);
+                if (data.type === 'progress') {
+                    progress.value = (100 * data.rowsDone) / data.height;
+                } else {
+                    progress.value = 100;
+                    status.textContent = `Rendered ${width}×${height} at ${spp} spp in ${(data.ms / 1000).toFixed(1)} s.`;
+                    button.disabled = false;
+                    worker?.terminate();
+                    worker = null;
+                }
+            };
+            worker.onerror = (e) => {
+                status.textContent = `Render failed: ${e.message || 'could not load WebAssembly worker'}`;
+                button.disabled = false;
+            };
+            worker.postMessage({ width, height, spp, colors });
+        }
+
+        button.addEventListener('click', () => render(true));
+
+        // Start the first (default-colored) render only when the section approaches the
+        // viewport, so it doesn't compete with the page's initial load.
+        const io = new IntersectionObserver((entries) => {
+            if (entries.some((e) => e.isIntersecting)) {
+                io.disconnect();
+                render(false);
+            }
+        }, { rootMargin: '200px' });
+        io.observe(root);
+    }
+
+    document.querySelectorAll<HTMLElement>('[data-smallpt]').forEach(initSmallpt);
+</script>
