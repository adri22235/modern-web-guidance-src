@@ -0,0 +1,11 @@
+#!/bin/sh
+# Compile smallpt to WebAssembly. Requires Emscripten (emcc/em++) on PATH.
+# Output goes to public/smallpt/, where it is served as a static asset.
+set -e
+cd "$(dirname "$0")"
+em++ -O3 smallpt.cpp -o ../public/smallpt/smallpt.js \
+  -sMODULARIZE=1 -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH=1 -sSTACK_SIZE=1048576 \
+  -sEXPORTED_FUNCTIONS=_init,_reset,_render_rows,_finish_pass,_image,_sphere_count,_set_sphere_color \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8
