diff --git a/public/smallpt/worker.js b/public/smallpt/worker.js
new file mode 100644
index 0000000..77bf098
--- /dev/null
+++ b/public/smallpt/worker.js
@@ -0,0 +1,49 @@
+// Web Worker that runs the smallpt WebAssembly module off the main thread.
+// Messages in:  { type: 'render', id, width, height, maxPasses, colors: {index: [r,g,b]} }
+//               { type: 'stop' }
+// Messages out: { type: 'ready' }
+//               { type: 'frame', id, pass, spp, ms, pixels (ArrayBuffer RGBA8) }
+//               { type: 'done', id, spp, ms }  (id echoes the request)
+importScripts('smallpt.js');
+
+let mod = null;
+let job = 0;          // incremented for each new render request; stale loops bail out
+let size = [0, 0];
+
+const ready = createSmallpt().then((m) => {
+  mod = m;
+  self.postMessage({ type: 'ready', spheres: m._sphere_count() });
+});
+
+const yieldToEvents = () => new Promise((r) => setTimeout(r, 0));
+
+async function render({ id, width, height, maxPasses, colors }) {
+  await ready;
+  const myJob = ++job;
+  if (size[0] !== width || size[1] !== height) {
+    mod._init(width, height);
+    size = [width, height];
+  }
+  for (const [i, c] of Object.entries(colors || {})) {
+    mod._set_sphere_color(Number(i), c[0], c[1], c[2]);
+  }
+  mod._reset();
+  const t0 = performance.now();
+  for (let pass = 0; pass < maxPasses; pass++) {
+    mod._render_rows(0, height, pass);
+    const passes = mod._finish_pass();
+    const ptr = mod._image();
+    const pixels = mod.HEAPU8.slice(ptr, ptr + width * height * 4).buffer;
+    const ms = performance.now() - t0;
+    self.postMessage({ type: 'frame', id, pass: passes, spp: passes * 4, ms, pixels }, [pixels]);
+    await yieldToEvents(); // let a newer 'render' / 'stop' message preempt us
+    if (myJob !== job) return;
+  }
+  self.postMessage({ type: 'done', id, spp: maxPasses * 4, ms: performance.now() - t0 });
+}
+
+self.onmessage = (e) => {
+  const msg = e.data;
+  if (msg.type === 'render') render(msg);
+  else if (msg.type === 'stop') job++;
+};
diff --git a/src/components/SmallptRenderer.tsx b/src/components/SmallptRenderer.tsx
new file mode 100644
index 0000000..68b8936
--- /dev/null
+++ b/src/components/SmallptRenderer.tsx
@@ -0,0 +1,176 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const MAX_PASSES = 64; // 4 spp per pass -> 256 spp total
+
+type RGB = [number, number, number];
+
+// Sphere indices in smallpt's scene table (see wasm/smallpt.cpp).
+const LEFT = 0, RIGHT = 1, BACK = 2, BOTTOM = 4, TOP = 5, MIRROR = 6, GLASS = 7;
+
+// The original smallpt scene colours.
+const ORIGINAL_COLORS: Record<number, RGB> = {
+  [LEFT]: [0.75, 0.25, 0.25],
+  [RIGHT]: [0.25, 0.25, 0.75],
+  [BACK]: [0.75, 0.75, 0.75],
+  [BOTTOM]: [0.75, 0.75, 0.75],
+  [TOP]: [0.75, 0.75, 0.75],
+  [MIRROR]: [0.999, 0.999, 0.999],
+  [GLASS]: [0.999, 0.999, 0.999],
+};
+
+function hsvToRgb(h: number, s: number, v: number): RGB {
+  const f = (n: number) => {
+    const k = (n + h * 6) % 6;
+    return v - v * s * Math.max(0, Math.min(k, 4 - k, 1));
+  };
+  return [f(5), f(3), f(1)];
+}
+
+// Random colours that keep albedo < 1 so the path tracer stays energy-conserving.
+function randomColors(): Record<number, RGB> {
+  const diffuse = () => hsvToRgb(Math.random(), 0.3 + Math.random() * 0.6, 0.55 + Math.random() * 0.25);
+  const tint = () => hsvToRgb(Math.random(), Math.random() * 0.6, 0.999);
+  return {
+    [LEFT]: diffuse(),
+    [RIGHT]: diffuse(),
+    [BACK]: diffuse(),
+    [BOTTOM]: diffuse(),
+    [TOP]: diffuse(),
+    [MIRROR]: tint(),
+    [GLASS]: tint(),
+  };
+}
+
+const toCss = ([r, g, b]: RGB) =>
+  `rgb(${Math.round(r * 255)}, ${Math.round(g * 255)}, ${Math.round(b * 255)})`;
+
+const LABELS: [number, string][] = [
+  [LEFT, 'Left wall'],
+  [RIGHT, 'Right wall'],
+  [BACK, 'Back wall'],
+  [BOTTOM, 'Floor'],
+  [TOP, 'Ceiling'],
+  [MIRROR, 'Mirror ball'],
+  [GLASS, 'Glass ball'],
+];
+
+export default function SmallptRenderer() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobRef = useRef(0);
+  const [colors, setColors] = useState<Record<number, RGB>>(ORIGINAL_COLORS);
+  const [status, setStatus] = useState('Loading WebAssembly…');
+  const [rendering, setRendering] = useState(false);
+
+  const start = useCallback((c: Record<number, RGB>) => {
+    const worker = workerRef.current;
+    if (!worker) return;
+    jobRef.current++;
+    setColors(c);
+    setRendering(true);
+    setStatus('Rendering…');
+    worker.postMessage({ type: 'render', id: jobRef.current, width: WIDTH, height: HEIGHT, maxPasses: MAX_PASSES, colors: c });
+  }, []);
+
+  useEffect(() => {
+    let worker: Worker;
+    try {
+      worker = new Worker(`${import.meta.env.BASE_URL}smallpt/worker.js`);
+    } catch (err) {
+      setStatus(`Could not start worker: ${err}`);
+      return;
+    }
+    workerRef.current = worker;
+    const ctx = canvasRef.current?.getContext('2d');
+
+    worker.onmessage = (e: MessageEvent) => {
+      const msg = e.data;
+      // Drop frames from superseded render requests.
+      if ((msg.type === 'frame' || msg.type === 'done') && msg.id !== jobRef.current) return;
+      if (msg.type === 'frame' && ctx) {
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(msg.pixels), WIDTH, HEIGHT), 0, 0);
+        setStatus(`${msg.spp} samples/pixel · ${(msg.ms / 1000).toFixed(1)}s`);
+      } else if (msg.type === 'done') {
+        setRendering(false);
+        setStatus(`Done: ${msg.spp} samples/pixel in ${(msg.ms / 1000).toFixed(1)}s`);
+      }
+    };
+    worker.onerror = (e) => {
+      setRendering(false);
+      setStatus(`Error: ${e.message || 'failed to load path tracer'}`);
+    };
+
+    start(ORIGINAL_COLORS);
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [start]);
+
+  const stop = () => {
+    workerRef.current?.postMessage({ type: 'stop' });
+    setRendering(false);
+    setStatus((s) => s.replace(/^Done: /, '') + ' (stopped)');
+  };
+
+  return (
+    <div className="flex flex-col md:flex-row gap-6 items-start text-left">
+      <div className="w-full md:w-auto">
+        <canvas
+          ref={canvasRef}
+          width={WIDTH}
+          height={HEIGHT}
+          className="w-full md:w-[480px] bg-black"
+          style={{ imageRendering: 'auto', aspectRatio: `${WIDTH} / ${HEIGHT}` }}
+          aria-label="Path-traced Cornell box rendered by smallpt"
+        />
+        <p className="text-xs text-gray-500 mt-1 font-mono" aria-live="polite">{status}</p>
+      </div>
+      <div className="flex-1">
+        <p className="text-gray-700 mb-4">
+          This image is being path traced right now, in your browser, by{' '}
+          <a className="underline hover:text-amber-400" href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noreferrer">
+            smallpt
+          </a>
+          , Kevin Beason's 99-line C++ global illumination renderer, compiled to WebAssembly. It refines
+          progressively up to {MAX_PASSES * 4} samples per pixel in a background worker.
+        </p>
+        <div className="flex flex-wrap gap-2 mb-4">
+          <button
+            type="button"
+            onClick={() => start(randomColors())}
+            className="px-4 py-2 bg-amber-400 text-white font-semibold hover:bg-amber-700 transition-colors"
+          >
+            Randomize colors &amp; render again
+          </button>
+          <button
+            type="button"
+            onClick={() => start(ORIGINAL_COLORS)}
+            className="px-4 py-2 border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors"
+          >
+            Original colors
+          </button>
+          {rendering && (
+            <button
+              type="button"
+              onClick={stop}
+              className="px-4 py-2 border border-gray-300 text-gray-700 hover:bg-gray-100 transition-colors"
+            >
+              Stop
+            </button>
+          )}
+        </div>
+        <ul className="grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-gray-600">
+          {LABELS.map(([i, label]) => (
+            <li key={i} className="flex items-center gap-2">
+              <span className="inline-block w-4 h-4 border border-gray-300" style={{ background: toCss(colors[i]) }} />
+              {label}
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  );
+}
