+  <script type="module">
+    // Load the Temporal polyfill only where the native API is missing (e.g. Safari).
+    if (typeof Temporal === 'undefined') {
+      const module = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = module.Temporal;
+    }
+
+    // Islamic calendar variants differ in engine support; use the first one that works.
+    const CALENDAR_CANDIDATES = {
+      islamic: ['islamic-umalqura', 'islamic-civil', 'islamic-tbla', 'islamic'],
+      hebrew: ['hebrew'],
+      japanese: ['japanese'],
+    };
+
+    const supported = (() => {
+      try { return new Set(Intl.supportedValuesOf('calendar')); } catch { return null; }
+    })();
+
+    function resolveCalendar(candidates) {
+      const probe = Temporal.PlainDate.from('2000-01-01');
+      for (const id of candidates) {
+        if (supported && !supported.has(id)) continue;
+        try {
+          probe.withCalendar(id);
+          return id;
+        } catch { /* try next */ }
+      }
+      return null;
+    }
+
+    const resolved = Object.fromEntries(
+      Object.entries(CALENDAR_CANDIDATES).map(([key, ids]) => [key, resolveCalendar(ids)])
+    );
+
+    const input = document.getElementById('calendar-date-input');
+    const errorEl = document.getElementById('calendar-error');
+    const cards = document.querySelectorAll('.calendar-card');
+
+    function el(tag, props = {}, ...children) {
+      const node = Object.assign(document.createElement(tag), props);
+      node.append(...children);
+      return node;
+    }
+
+    function renderCard(card, isoDate, today) {
+      const body = card.querySelector('.calendar-body');
+      const calendarId = resolved[card.dataset.calendar];
+      if (!calendarId) {
+        body.replaceChildren('This calendar is not supported by your browser.');
+        return;
+      }
+
+      const date = isoDate.withCalendar(calendarId);
+      const todayInCal = today.withCalendar(calendarId);
+      const cmp = Temporal.PlainDate.compare(date, todayInCal);
+      const relative = cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+
+      const localeTag = `en-u-ca-${calendarId}`;
+      const localized = date.toLocaleString(localeTag, {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric',
+        era: calendarId === 'japanese' ? 'long' : undefined,
+      });
+      const monthName = (d) => d.toLocaleString(localeTag, { month: 'long' });
+
+      const rows = [
+        ['Calendar', calendarId],
+        ['Year', String(date.year)],
+        ['Month', String(date.month)],
+        ['Month code', date.monthCode],
+        ['Months in year', String(date.monthsInYear)],
+      ];
+      if (date.era) rows.splice(1, 0, ['Era', `${date.era} ${date.eraYear}`]);
+
+      const dl = el('dl');
+      for (const [term, value] of rows) dl.append(el('dt', { textContent: term }), el('dd', { textContent: value }));
+      const badge = el('span', { className: 'relative-badge', textContent: relative });
+      badge.dataset.relative = relative;
+      dl.append(el('dt', { textContent: 'Timeline' }), el('dd', {}, badge));
+
+      // Month breakdown: never assume 12 months or fixed lengths.
+      const tbody = el('tbody');
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthDate = date.with({ month: m, day: 1 });
+        const row = el('tr', {},
+          el('td', { textContent: String(m) }),
+          el('td', { textContent: monthName(monthDate) }),
+          el('td', { textContent: monthDate.monthCode }),
+          el('td', { textContent: String(monthDate.daysInMonth) }),
+        );
+        if (m === date.month) row.className = 'current';
+        tbody.append(row);
+      }
+      const table = el('table', { className: 'month-table' },
+        el('thead', {}, el('tr', {},
+          el('th', { textContent: '#' }),
+          el('th', { textContent: 'Month' }),
+          el('th', { textContent: 'Code' }),
+          el('th', { textContent: 'Days' }),
+        )),
+        tbody,
+      );
+      const details = el('details', {},
+        el('summary', { textContent: `Months of ${date.year} (${date.monthsInYear})` }),
+        table,
+      );
+
+      body.replaceChildren(el('p', { className: 'localized', textContent: localized }), dl, details);
+    }
+
+    function update() {
+      errorEl.hidden = true;
+      let isoDate;
+      try {
+        isoDate = Temporal.PlainDate.from(input.value);
+      } catch {
+        errorEl.textContent = 'Please choose a valid date.';
+        errorEl.hidden = false;
+        return;
+      }
+      const today = Temporal.Now.plainDateISO();
+      for (const card of cards) {
+        try {
+          renderCard(card, isoDate, today);
+        } catch (err) {
+          card.querySelector('.calendar-body').replaceChildren(`Unable to convert this date: ${err.message}`);
+        }
+      }
+    }
+
+    input.value = Temporal.Now.plainDateISO().toString();
+    input.addEventListener('input', update);
+    document.getElementById('calendar-form').addEventListener('submit', (e) => e.preventDefault());
+    update();
+  </script>
+
 </body>
 
