+  <script type="module">
+    // World Calendar Converter — uses the Temporal API (native, or a polyfill when unavailable).
+    const POLYFILL_URL = 'https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/+esm';
+
+    async function loadTemporal() {
+      if (globalThis.Temporal) return globalThis.Temporal;
+      const mod = await import(POLYFILL_URL);
+      return mod.Temporal;
+    }
+
+    const input = document.getElementById('calendar-date-input');
+    const todayBtn = document.getElementById('calendar-today-btn');
+    const statusEl = document.getElementById('calendar-status');
+    const cards = Array.from(document.querySelectorAll('#calendar-cards .calendar-card'));
+
+    function el(tag, props = {}, children = []) {
+      const node = document.createElement(tag);
+      for (const [k, v] of Object.entries(props)) {
+        if (k === 'className') node.className = v;
+        else if (k === 'text') node.textContent = v;
+        else node.setAttribute(k, v);
+      }
+      for (const c of [].concat(children)) node.append(c);
+      return node;
+    }
+
+    function fmt(date, locale, calendar, opts) {
+      try {
+        return date.toLocaleString(`${locale}-u-ca-${calendar}`, { calendar, ...opts });
+      } catch {
+        return date.toLocaleString(locale, opts);
+      }
+    }
+
+    function relationTo(Temporal, date) {
+      const today = Temporal.Now.plainDateISO();
+      const cmp = Temporal.PlainDate.compare(date, today);
+      return cmp < 0 ? 'Past' : cmp > 0 ? 'Future' : 'Today';
+    }
+
+    function renderCard(Temporal, card, isoDate) {
+      const calendar = card.dataset.calendar;
+      const locale = card.dataset.locale;
+      const date = isoDate.withCalendar(calendar);
+      const relation = relationTo(Temporal, isoDate);
+
+      const dateOpts = { year: 'numeric', month: 'long', day: 'numeric' };
+      if (calendar === 'japanese') dateOpts.era = 'long';
+
+      const localized = fmt(date, locale, calendar, dateOpts);
+      const localizedEn = fmt(date, 'en-US', calendar, dateOpts);
+
+      const rows = [];
+      if (date.era) {
+        const eraName = fmt(date, 'en-US', calendar, { era: 'long', year: 'numeric' })
+          .replace(/[\d,\s]+/g, ' ').trim();
+        rows.push(['Era', `${eraName || date.era} (${date.era})`]);
+        rows.push(['Era year', String(date.eraYear)]);
+      }
+      rows.push(['Year', String(date.year)]);
+      rows.push(['Month', String(date.month)]);
+      rows.push(['Month code', date.monthCode]);
+      rows.push(['Day', String(date.day)]);
+      rows.push(['Months in year', String(date.monthsInYear)]);
+      rows.push(['Days in year', String(date.daysInYear)]);
+
+      const dl = el('dl');
+      for (const [k, v] of rows) {
+        dl.append(el('dt', { text: k }), el('dd', { text: v, 'data-field': k.toLowerCase().replace(/\s+/g, '-') }));
+      }
+      dl.append(
+        el('dt', { text: 'Relative to today' }),
+        el('dd', { 'data-field': 'relation' }, el('span', {
+          className: `relation-badge ${relation.toLowerCase()}`, text: relation
+        }))
+      );
+
+      // Month breakdown for this calendar year
+      const tbody = el('tbody');
+      const firstOfYear = date.with({ month: 1, day: 1 });
+      for (let m = 1; m <= date.monthsInYear; m++) {
+        const monthStart = firstOfYear.with({ month: m, day: 1 });
+        const name = fmt(monthStart, 'en-US', calendar, { month: 'long' });
+        const tr = el('tr', m === date.month ? { className: 'current-month' } : {}, [
+          el('td', { text: String(m) }),
+          el('td', { text: name }),
+          el('td', { text: monthStart.monthCode }),
+          el('td', { text: String(monthStart.daysInMonth) }),
+        ]);
+        tbody.append(tr);
+      }
+      const table = el('table', { className: 'month-table' }, [
+        el('thead', {}, el('tr', {}, [
+          el('th', { text: '#' }), el('th', { text: 'Month' }),
+          el('th', { text: 'Code' }), el('th', { text: 'Days' }),
+        ])),
+        tbody,
+      ]);
+      const details = el('details', {}, [
+        el('summary', { text: `Months of ${date.year} (${date.monthsInYear})` }),
+        table,
+      ]);
+
+      card.replaceChildren(
+        el('h3', { text: card.dataset.label }),
+        el('p', { className: 'localized', lang: locale, text: localized }),
+        el('p', { className: 'localized-en', text: localizedEn }),
+        dl,
+        details,
+      );
+    }
+
+    async function init() {
+      let Temporal;
+      try {
+        Temporal = await loadTemporal();
+      } catch (err) {
+        statusEl.textContent = 'Sorry, the calendar converter is not supported in this browser.';
+        return;
+      }
+
+      const today = Temporal.Now.plainDateISO();
+      input.value = today.toString();
+
+      function update() {
+        if (!input.value) {
+          statusEl.textContent = 'Please choose a date.';
+          return;
+        }
+        let iso;
+        try {
+          iso = Temporal.PlainDate.from(input.value);
+        } catch {
+          statusEl.textContent = 'That date could not be read. Please try another.';
+          return;
+        }
+        statusEl.textContent = `Showing ${iso.toLocaleString('en-US', {
+          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
+        })} (Gregorian)`;
+        for (const card of cards) {
+          try {
+            renderCard(Temporal, card, iso);
+          } catch (err) {
+            card.replaceChildren(
+              el('h3', { text: card.dataset.label }),
+              el('p', { text: 'This date is outside the supported range for this calendar.' })
+            );
+          }
+        }
+      }
+
+      input.addEventListener('input', update);
+      input.addEventListener('change', update);
+      todayBtn.addEventListener('click', () => {
+        input.value = Temporal.Now.plainDateISO().toString();
+        update();
+      });
+      update();
+    }
+
+    init();
+  </script>
+
 </body>
 
