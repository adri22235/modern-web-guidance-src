+        const z = modelView.transformPoint(new DOMPoint(0, 0, 1));
+        const n = { x: z.x - c.x, y: z.y - c.y, z: z.z - c.z };
+        const facing = -(n.x * c.x + n.y * c.y + n.z * c.z) /
+          (Math.hypot(n.x, n.y, n.z) * Math.hypot(c.x, c.y, c.z));
+
+        if (facing > 0.15) {
+          canvas.updateElementGeometry(face.panel, {
+            canvasTransform: computeCanvasTransform(face.panel, mvp),
+            preserveHitTestOrder: true,
+          });
+          face.hitTestable = true;
+        } else if (face.hitTestable) {
+          canvas.clearElementGeometry(face.panel);
+          face.hitTestable = false;
+          hovering = false; // pointerleave may not fire once the element leaves hit testing
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = (event) => {
+          for (const face of faces) {
+            if (!face.panel) continue;
+            const changed = !event.changedElements || !face.textureState.uploaded ||
+              Array.from(event.changedElements).some((el) => el === face.panel || face.panel.contains(el));
+            if (!changed) continue;
+            try {
+              uploadElement(face);
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+          render();
+        };
+      }
+
+      // ---------- Render loop, paused while the stage is off-screen ----------
+      let rafId = 0;
+      let running = false;
+      let last = 0;
+
+      function frame(now) {
+        const dt = Math.min(0.05, (now - last) / 1000);
+        last = now;
+        step(dt);
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint(); // onpaint uploads changed panels, renders and syncs geometry
+        } else {
+          render();
+        }
+        rafId = requestAnimationFrame(frame);
+      }
+      function start() {
+        if (running) return;
+        running = true;
+        last = performance.now();
+        rafId = requestAnimationFrame(frame);
+      }
+      function stop() {
+        running = false;
+        cancelAnimationFrame(rafId);
+      }
+
+      if ('contentVisibility' in document.documentElement.style) {
+        stage.addEventListener('contentvisibilityautostatechange', (event) => {
+          event.skipped ? stop() : start();
+        });
+      } else {
+        new IntersectionObserver(([entry]) => {
+          entry.isIntersecting ? start() : stop();
+        }, { rootMargin: '200px' }).observe(stage);
+      }
+      start();
+    }
+  </script>
+
 </body>
 
 </html>
