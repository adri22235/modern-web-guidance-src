diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,51 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /*
+     * Scroll-driven reveal (CSS only).
+     * Cards grow from 50% to 100% as they enter the viewport and shrink
+     * back to 50% as they leave. Only applied when:
+     *  - the browser supports scroll-driven animations (otherwise cards
+     *    simply render at full size), and
+     *  - the user has not requested reduced motion.
+     * `scale` doesn't affect layout, and the view timeline tracks the
+     * untransformed box, so there is no layout shift or feedback loop.
+     */
+    @keyframes card-reveal {
+      entry 0% {
+        scale: 0.5;
+      }
+
+      entry 100% {
+        scale: 1;
+      }
+
+      exit 0% {
+        scale: 1;
+      }
+
+      exit 100% {
+        scale: 0.5;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .card {
+          animation: card-reveal linear both;
+          animation-timeline: view();
+        }
+
+        /* Keep a card at full size while a keyboard user is inside it,
+           even if focus scrolled it only partially into view. */
+        .card:focus-within {
+          animation: none;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
