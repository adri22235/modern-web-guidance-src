+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const input = document.getElementById('newsletter-email');
+      const error = document.getElementById('newsletter-error');
+
+      function getError() {
+        const value = input.value.trim();
+        if (!value) return 'Please enter your email address.';
+        // Native check plus require a dot in the domain (e.g. name@site.com)
+        if (input.validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
+          return 'Please enter a valid email address.';
+        }
+        return '';
+      }
+
+      function showError(message) {
+        error.textContent = message;
+        input.setAttribute('aria-invalid', message ? 'true' : 'false');
+      }
+
+      // Validate only once the user leaves the field (skip empty blurs so
+      // tabbing past it doesn't nag).
+      input.addEventListener('blur', function () {
+        if (input.value.trim() === '') {
+          showError('');
+          return;
+        }
+        showError(getError());
+      });
+
+      // While typing, never add an error — only clear an existing one once
+      // the value becomes valid.
+      input.addEventListener('input', function () {
+        if (input.getAttribute('aria-invalid') === 'true' && !getError()) {
+          showError('');
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const message = getError();
+        showError(message);
+        if (message) {
+          input.focus();
+          return;
+        }
+        // TODO: wire up to the real newsletter provider endpoint.
+        const success = document.createElement('p');
+        success.className = 'newsletter-success';
+        success.setAttribute('role', 'status');
+        success.textContent = "Thanks for subscribing! Check your inbox for a welcome email.";
+        form.querySelector('.newsletter-row').replaceWith(success);
+      });
+    })();
+  </script>
+
 </body>
 
