+  <script>
+    (() => {
+      const form = document.querySelector('.newsletter');
+      const email = form.querySelector('input[type="email"]');
+
+      // Keep aria-invalid in sync with the visual :user-invalid state, so screen
+      // readers also only hear about errors after the user leaves the field.
+      const syncAria = () => {
+        if (email.matches(':user-invalid')) {
+          email.setAttribute('aria-invalid', 'true');
+        } else {
+          email.removeAttribute('aria-invalid');
+        }
+      };
+      email.addEventListener('blur', syncAria);
+      email.addEventListener('invalid', syncAria);
+      // Once an error is showing, clear it as soon as the input becomes valid.
+      email.addEventListener('input', () => {
+        if (email.hasAttribute('aria-invalid')) syncAria();
+      });
+
+      // Static site: no subscribe endpoint yet, so confirm in place.
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const msg = document.createElement('p');
+        msg.className = 'success-msg';
+        msg.setAttribute('role', 'status');
+        msg.textContent = `Thanks! We'll send the newsletter to ${email.value}.`;
+        form.replaceChildren(msg);
+      });
+    })();
+  </script>
+
