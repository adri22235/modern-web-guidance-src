+  <script>
+    // Detect whether this tab was opened in the background during initial load.
+    (() => {
+      if ('VisibilityStateEntry' in window) {
+        // The performance timeline records visibility changes from navigation
+        // start, so this is accurate no matter when this script executes.
+        const entries = performance.getEntriesByType('visibility-state');
+        const firstHidden = entries.find((entry) => entry.name === 'hidden');
+        console.log({
+          backgrounded: entries.length > 0 && entries[0].name === 'hidden',
+          // Precise browser timestamp (ms since navigation start) when the page
+          // was first hidden, or null if it hasn't been hidden yet.
+          timestamp: firstHidden ? firstHidden.startTime : null,
+        });
+      } else {
+        // Fallback: only reflects the state at the moment this script runs.
+        const backgrounded = document.visibilityState === 'hidden';
+        console.log({
+          backgrounded,
+          timestamp: backgrounded ? 0 : null,
+          note: 'VisibilityStateEntry is unsupported; fell back to document.visibilityState. ' +
+            'This is unreliable for async/deferred scripts: if the tab was opened in the ' +
+            'background and foregrounded before this script ran, it will report false. ' +
+            'The timestamp is also an approximation.',
+        });
+      }
+    })();
+  </script>
+
 </body>
 
