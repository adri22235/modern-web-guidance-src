diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -152,8 +152,38 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
   </style>
+  <script>
+    // Detect whether this tab was opened in the background during initial page load.
+    (function () {
+      var result = { backgrounded: false, timestamp: Date.now() };
+
+      var supportsVisibilityEntries =
+        typeof PerformanceObserver !== 'undefined' &&
+        Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+        PerformanceObserver.supportedEntryTypes.indexOf('visibility-state') !== -1;
+
+      if (supportsVisibilityEntries) {
+        // The browser records the initial visibility state as the first
+        // 'visibility-state' entry (startTime 0), no matter when this script runs.
+        var entries = performance.getEntriesByType('visibility-state');
+        if (entries.length > 0) {
+          result.backgrounded = entries[0].name === 'hidden';
+          console.log(result);
+          return;
+        }
+      }
+
+      // Fallback: read the current visibility state. This only reflects the
+      // state at the moment the script executes, not at navigation start.
+      result.backgrounded = document.visibilityState === 'hidden' || document.hidden === true;
+      result.note =
+        'Fallback check (document.visibilityState) used: it only reflects visibility when the script runs, ' +
+        'so it is unreliable for async/deferred scripts, which may run after the user has switched to (or away from) the tab.';
+      console.log(result);
+    })();
+  </script>
 </head>
 
 <body>
 
