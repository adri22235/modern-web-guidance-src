diff --git a/src/utils/consent.ts b/src/utils/consent.ts
new file mode 100644
index 0000000..ef940e3
--- /dev/null
+++ b/src/utils/consent.ts
@@ -0,0 +1,99 @@
+/**
+ * Privacy-by-design consent store.
+ *
+ * - Nothing optional (analytics, advertising) runs until the visitor opts in.
+ * - Browser privacy signals (Global Privacy Control, Do Not Track) are honoured
+ *   as an opt-out and suppress the consent prompt entirely.
+ * - The choice is stored only on the visitor's device (localStorage); it is
+ *   never sent to our servers or third parties.
+ */
+
+export type ConsentCategory = 'analytics' | 'advertising';
+
+export interface ConsentState {
+  analytics: boolean;
+  advertising: boolean;
+  /** ISO date (day precision only — no need for a precise timestamp). */
+  decidedOn: string;
+  version: number;
+}
+
+/** Bump when categories or their descriptions change to re-ask visitors. */
+export const CONSENT_VERSION = 1;
+const STORAGE_KEY = 'dtt-privacy-consent';
+
+export const CONSENT_CHANGE_EVENT = 'dtt:consent-change';
+export const OPEN_PREFERENCES_EVENT = 'dtt:open-privacy-preferences';
+
+export const ANALYTICS_SCRIPT_SRC =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+/** True when the browser sends an explicit "do not sell / do not track" signal. */
+export function hasBrowserOptOutSignal(): boolean {
+  if (typeof navigator === 'undefined') return false;
+  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+  return nav.globalPrivacyControl === true || nav.doNotTrack === '1';
+}
+
+export function getConsent(): ConsentState | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as ConsentState;
+    if (parsed.version !== CONSENT_VERSION) return null;
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+export function setConsent(choices: Pick<ConsentState, ConsentCategory>): ConsentState {
+  const state: ConsentState = {
+    analytics: !!choices.analytics,
+    advertising: !!choices.advertising,
+    decidedOn: new Date().toISOString().slice(0, 10),
+    version: CONSENT_VERSION,
+  };
+  try {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+  } catch {
+    // Storage unavailable (e.g. blocked) — fall back to the privacy-preserving default.
+  }
+  window.dispatchEvent(new CustomEvent(CONSENT_CHANGE_EVENT, { detail: state }));
+  return state;
+}
+
+/**
+ * Whether a category may run. Defaults to `false` (opt-in), and a browser
+ * opt-out signal always wins over a stored choice.
+ */
+export function hasConsent(category: ConsentCategory): boolean {
+  if (hasBrowserOptOutSignal()) return false;
+  return getConsent()?.[category] === true;
+}
+
+export function openPrivacyPreferences(): void {
+  window.dispatchEvent(new Event(OPEN_PREFERENCES_EVENT));
+}
+
+let analyticsLoaded = false;
+
+/** Injects the third-party analytics script only after explicit consent. */
+export function loadAnalyticsIfConsented(): void {
+  if (analyticsLoaded || !hasConsent('analytics')) return;
+  if (document.querySelector(`script[src="${ANALYTICS_SCRIPT_SRC}"]`)) {
+    analyticsLoaded = true;
+    return;
+  }
+  const script = document.createElement('script');
+  script.src = ANALYTICS_SCRIPT_SRC;
+  script.defer = true;
+  script.referrerPolicy = 'strict-origin';
+  document.head.appendChild(script);
+  analyticsLoaded = true;
+}
+
+export function isAnalyticsLoaded(): boolean {
+  return analyticsLoaded;
+}
