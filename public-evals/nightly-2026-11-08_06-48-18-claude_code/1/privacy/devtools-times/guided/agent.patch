diff --git a/src/components/PrivacyPreferences.tsx b/src/components/PrivacyPreferences.tsx
new file mode 100644
index 0000000..b67efa6
--- /dev/null
+++ b/src/components/PrivacyPreferences.tsx
@@ -0,0 +1,202 @@
+import React, { useEffect, useId, useState } from 'react';
+import {
+  OPEN_PREFERENCES_EVENT,
+  getConsent,
+  hasBrowserOptOutSignal,
+  isAnalyticsLoaded,
+  loadAnalyticsIfConsented,
+  setConsent,
+} from '../utils/consent';
+
+const baseUrl = import.meta.env.BASE_URL.endsWith('/')
+  ? import.meta.env.BASE_URL
+  : `${import.meta.env.BASE_URL}/`;
+
+/**
+ * Consent banner + preferences panel.
+ *
+ * Shown on first visit (unless the browser sends GPC/DNT), and re-openable at any
+ * time via the "Manage Privacy Preferences" link in the footer. "Reject all" is
+ * as prominent as "Accept all", and nothing optional is pre-selected.
+ */
+export default function PrivacyPreferences() {
+  const [open, setOpen] = useState(false);
+  const [customizing, setCustomizing] = useState(false);
+  const [analytics, setAnalytics] = useState(false);
+  const [advertising, setAdvertising] = useState(false);
+  const [optOutSignal, setOptOutSignal] = useState(false);
+  const headingId = useId();
+  const descId = useId();
+
+  useEffect(() => {
+    const signal = hasBrowserOptOutSignal();
+    setOptOutSignal(signal);
+
+    const stored = getConsent();
+    if (stored) {
+      setAnalytics(stored.analytics);
+      setAdvertising(stored.advertising);
+    }
+    // Ask only if no decision has been made and the browser hasn't already said "no".
+    if (!stored && !signal) setOpen(true);
+
+    loadAnalyticsIfConsented();
+
+    const onOpen = () => {
+      const current = getConsent();
+      setAnalytics(current?.analytics ?? false);
+      setAdvertising(current?.advertising ?? false);
+      setCustomizing(true);
+      setOpen(true);
+    };
+    // Event delegation so the footer link works across client-side navigations.
+    const onClick = (e: MouseEvent) => {
+      const trigger = (e.target as Element | null)?.closest?.('[data-open-privacy-preferences]');
+      if (trigger) {
+        e.preventDefault();
+        onOpen();
+      }
+    };
+    window.addEventListener(OPEN_PREFERENCES_EVENT, onOpen);
+    document.addEventListener('click', onClick);
+    return () => {
+      window.removeEventListener(OPEN_PREFERENCES_EVENT, onOpen);
+      document.removeEventListener('click', onClick);
+    };
+  }, []);
+
+  const save = (choices: { analytics: boolean; advertising: boolean }) => {
+    const wasLoaded = isAnalyticsLoaded();
+    const state = setConsent(choices);
+    setAnalytics(state.analytics);
+    setAdvertising(state.advertising);
+    setOpen(false);
+    setCustomizing(false);
+
+    if (wasLoaded && !state.analytics) {
+      // A third-party script can't be reliably unloaded; reload to stop it.
+      window.location.reload();
+      return;
+    }
+    loadAnalyticsIfConsented();
+  };
+
+  if (!open) return null;
+
+  const buttonBase =
+    'px-4 py-2 text-sm font-semibold rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900';
+
+  return (
+    <section
+      role="dialog"
+      aria-modal="false"
+      aria-labelledby={headingId}
+      aria-describedby={descId}
+      className="fixed inset-x-0 bottom-0 z-[100] p-4"
+    >
+      <div className="max-w-3xl mx-auto bg-white border border-gray-300 rounded-lg shadow-xl p-5 text-gray-800">
+        <h2 id={headingId} className="text-lg font-bold mb-2">
+          Your privacy choices
+        </h2>
+        <p id={descId} className="text-sm text-gray-600 mb-4">
+          We only use what's strictly necessary to run the site (e.g. remembering your reading
+          list and this choice) by default. With your permission we'd also like to measure which
+          links and buttons are clicked to improve the site. You can change your mind at any time
+          via "Manage Privacy Preferences" in the footer. See our{' '}
+          <a href={`${baseUrl}legal/privacy`} className="underline">
+            Privacy Policy
+          </a>{' '}
+          for details.
+        </p>
+
+        {optOutSignal && (
+          <p className="text-sm mb-4 p-3 bg-blue-50 text-blue-900 rounded-md">
+            Your browser is sending a Global Privacy Control or Do Not Track signal. We honour it:
+            optional analytics and advertising stay off regardless of the settings below.
+          </p>
+        )}
+
+        {customizing && (
+          <fieldset className="mb-4 space-y-3">
+            <legend className="sr-only">Cookie and tracking categories</legend>
+            <div className="flex items-start gap-3">
+              <input id="consent-necessary" type="checkbox" checked disabled className="mt-1" />
+              <label htmlFor="consent-necessary" className="text-sm">
+                <span className="font-semibold">Strictly necessary</span> — session cookie for your
+                reading list and storage of your privacy choice on this device. Always on.
+              </label>
+            </div>
+            <div className="flex items-start gap-3">
+              <input
+                id="consent-analytics"
+                type="checkbox"
+                checked={analytics}
+                disabled={optOutSignal}
+                onChange={(e) => setAnalytics(e.target.checked)}
+                className="mt-1"
+              />
+              <label htmlFor="consent-analytics" className="text-sm">
+                <span className="font-semibold">Analytics</span> — sends the label of the link or
+                button you click and the time of the click to our analytics provider. No account
+                details, form contents or identifiers are sent.
+              </label>
+            </div>
+            <div className="flex items-start gap-3">
+              <input
+                id="consent-advertising"
+                type="checkbox"
+                checked={advertising}
+                disabled={optOutSignal}
+                onChange={(e) => setAdvertising(e.target.checked)}
+                className="mt-1"
+              />
+              <label htmlFor="consent-advertising" className="text-sm">
+                <span className="font-semibold">Advertising</span> — allows ad slots to be filled
+                by our ad partner.
+              </label>
+            </div>
+          </fieldset>
+        )}
+
+        <div className="flex flex-wrap gap-2 justify-end">
+          {customizing ? (
+            <button
+              type="button"
+              data-skip-tracking="true"
+              onClick={() => save({ analytics, advertising })}
+              className={`${buttonBase} border border-gray-900 text-gray-900 bg-white hover:bg-gray-100`}
+            >
+              Save choices
+            </button>
+          ) : (
+            <button
+              type="button"
+              data-skip-tracking="true"
+              onClick={() => setCustomizing(true)}
+              className={`${buttonBase} border border-gray-900 text-gray-900 bg-white hover:bg-gray-100`}
+            >
+              Customize
+            </button>
+          )}
+          <button
+            type="button"
+            data-skip-tracking="true"
+            onClick={() => save({ analytics: false, advertising: false })}
+            className={`${buttonBase} text-white bg-gray-900 hover:bg-gray-800`}
+          >
+            Reject all
+          </button>
+          <button
+            type="button"
+            data-skip-tracking="true"
+            disabled={optOutSignal}
+            onClick={() => save({ analytics: true, advertising: true })}
+            className={`${buttonBase} text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-50 disabled:cursor-not-allowed`}
+          >
+            Accept all
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
