 import { defineMiddleware } from 'astro:middleware';
 
+/**
+ * Privacy-focused response headers applied to every response.
+ * - Referrer-Policy: never leak full URLs (paths, query strings) to other origins.
+ * - Permissions-Policy: deny powerful/tracking-prone features the site doesn't use,
+ *   for us and for any embedded third parties, and opt out of Topics/FLoC.
+ * - X-Content-Type-Options: prevent MIME sniffing.
+ */
+const PRIVACY_HEADERS: Record<string, string> = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy': [
+    'accelerometer=()',
+    'ambient-light-sensor=()',
+    'autoplay=(self)',
+    'bluetooth=()',
+    'browsing-topics=()',
+    'camera=()',
+    'display-capture=()',
+    'geolocation=()',
+    'gyroscope=()',
+    'hid=()',
+    'interest-cohort=()',
+    'magnetometer=()',
+    'microphone=()',
+    'midi=()',
+    'payment=()',
+    'serial=()',
+    'usb=()',
+    'xr-spatial-tracking=()',
+  ].join(', '),
+  'X-Content-Type-Options': 'nosniff',
+};
+
+/** Pages that handle credentials: never cache, never index, never send a referrer. */
+const SENSITIVE_PATHS = [/\/signin\/?$/, /\/signup\/?$/];
+
 export const onRequest = defineMiddleware(async (context, next) => {
   if (context.session) {
     // Initialize the reading list if it doesn't exist
@@ -9,5 +44,22 @@ export const onRequest = defineMiddleware(async (context, next) => {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+
+  const response = await next();
+
+  try {
+    for (const [name, value] of Object.entries(PRIVACY_HEADERS)) {
+      if (!response.headers.has(name)) response.headers.set(name, value);
+    }
+
+    if (SENSITIVE_PATHS.some((re) => re.test(context.url.pathname))) {
+      response.headers.set('Cache-Control', 'no-store');
+      response.headers.set('Referrer-Policy', 'no-referrer');
