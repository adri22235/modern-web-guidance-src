diff --git a/src/utils/consent.ts b/src/utils/consent.ts
new file mode 100644
index 0000000..5890dee
--- /dev/null
+++ b/src/utils/consent.ts
@@ -0,0 +1,59 @@
+/**
+ * Privacy-by-design consent handling.
+ *
+ * - Nothing optional (analytics, ads) loads until the visitor explicitly opts in.
+ * - Browser privacy signals (Global Privacy Control, Do Not Track) are honoured
+ *   as an opt-out and cannot be overridden by a stored "granted" choice.
+ * - The choice is stored only in localStorage (never sent to a server) and
+ *   expires after CONSENT_MAX_AGE_DAYS so visitors are asked again periodically.
+ */
+
+export const CONSENT_STORAGE_KEY = 'dt-privacy-consent';
+export const CONSENT_MAX_AGE_DAYS = 180;
+export const CONSENT_CHANGE_EVENT = 'dt:consent-change';
+
+export type ConsentValue = 'granted' | 'denied';
+
+interface StoredConsent {
+  analytics: ConsentValue;
+  updatedAt: string;
+}
+
+export function hasBrowserPrivacySignal(): boolean {
+  if (typeof navigator === 'undefined') return false;
+  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+  return nav.globalPrivacyControl === true || nav.doNotTrack === '1';
+}
+
+export function readConsent(): StoredConsent | null {
+  try {
+    const raw = localStorage.getItem(CONSENT_STORAGE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as StoredConsent;
+    if (parsed.analytics !== 'granted' && parsed.analytics !== 'denied') return null;
+    const ageMs = Date.now() - new Date(parsed.updatedAt).getTime();
+    if (!(ageMs >= 0 && ageMs < CONSENT_MAX_AGE_DAYS * 24 * 60 * 60 * 1000)) {
+      localStorage.removeItem(CONSENT_STORAGE_KEY);
+      return null;
+    }
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+export function writeConsent(analytics: ConsentValue): void {
+  try {
+    const value: StoredConsent = { analytics, updatedAt: new Date().toISOString() };
+    localStorage.setItem(CONSENT_STORAGE_KEY, JSON.stringify(value));
+  } catch {
+    // Storage unavailable (private mode etc.) – treat as session-only choice.
+  }
+  document.dispatchEvent(new CustomEvent(CONSENT_CHANGE_EVENT, { detail: { analytics } }));
+}
+
+/** True only when the visitor opted in and no browser opt-out signal is present. */
+export function hasAnalyticsConsent(): boolean {
+  if (hasBrowserPrivacySignal()) return false;
+  return readConsent()?.analytics === 'granted';
+}
