new file mode 100644
index 0000000..7d4803e
--- /dev/null
+++ b/src/components/AuthPrivacyNotice.tsx
@@ -0,0 +1,35 @@
+import React from 'react';
+
+interface Props {
+  mode: 'signin' | 'signup';
+}
+
+const privacyUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}legal/privacy`;
+
+/**
+ * Just-in-time transparency notice shown next to the credential fields:
+ * what we collect, why, who processes it and what we do NOT do.
+ */
+export default function AuthPrivacyNotice({ mode }: Props) {
+  return (
+    <div className="mt-6 text-xs text-gray-600 border-t border-gray-200 pt-4 space-y-2" id={`${mode}-privacy-notice`}>
+      <p>
+        <strong>What we collect:</strong>{' '}
+        {mode === 'signup'
+          ? 'only a username and a password — no email address, real name or phone number. Please don’t use your real name or email as your username.'
+          : 'only the username and password you enter, to verify your account.'}
+      </p>
+      <p>
+        <strong>Who processes it:</strong> your credentials are sent over an encrypted (HTTPS) connection to our
+        authentication service, hosted on Google Cloud (<code>us-central1-web-devrel-apps.cloudfunctions.net</code>).
+        They are not shared with advertisers, and no analytics or ad scripts run on this page.
+      </p>
+      <p>
+        <a href={privacyUrl} className="underline hover:text-gray-900">
+          Privacy Policy
+        </a>{' '}
+        — how long we keep your data and how to delete your account.
+      </p>
+    </div>
+  );
+}
