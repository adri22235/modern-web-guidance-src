diff --git a/src/components/PrivacyConsent.astro b/src/components/PrivacyConsent.astro
new file mode 100644
index 0000000..c208590
--- /dev/null
+++ b/src/components/PrivacyConsent.astro
@@ -0,0 +1,143 @@
+---
+/**
+ * Consent banner + loader for optional third-party scripts.
+ * Third-party scripts are NOT referenced in the page markup; they are injected
+ * here only after an explicit opt-in, and never on pages that opt out of
+ * tracking (e.g. sign-in / sign-up), via `data-analytics="off"` on <html>.
+ */
+const baseUrl = import.meta.env.BASE_URL;
+const privacyUrl = `${baseUrl.replace(/\/?$/, '/')}legal/privacy`;
+---
+
+<div
+  id="privacy-consent"
+  role="dialog"
+  aria-modal="false"
+  aria-labelledby="privacy-consent-title"
+  aria-describedby="privacy-consent-desc"
+  hidden
+  class="fixed inset-x-0 bottom-0 z-50 border-t border-gray-300 bg-white p-4 shadow-lg sm:inset-x-auto sm:bottom-4 sm:left-4 sm:max-w-md sm:rounded-lg sm:border"
+>
+  <h2 id="privacy-consent-title" class="text-base font-bold text-gray-900">Your privacy choices</h2>
+  <div id="privacy-consent-desc" class="mt-2 space-y-2 text-sm text-gray-700">
+    <p>
+      We only use what is strictly necessary to run this site by default. With your permission we would
+      also load an <strong>analytics script</strong> from our provider
+      (<code class="text-xs">us-central1-web-devrel-apps.cloudfunctions.net</code>) that records which
+      links and buttons you click (element type, its label and a timestamp). Your IP address is
+      visible to that provider when the script loads.
+    </p>
+    <p>
+      Analytics is never loaded on sign-in or sign-up pages, and is switched off automatically if your
+      browser sends Global Privacy Control or Do Not Track. You can change your choice at any time via
+      “Manage Privacy Preferences” in the footer.
+      <a href={privacyUrl} class="underline">Read our Privacy Policy</a>.
+    </p>
+    <p id="privacy-consent-signal" class="hidden rounded bg-gray-100 p-2 text-xs">
+      Your browser is sending a privacy signal (GPC/DNT), so analytics stays off regardless of the choice below.
+    </p>
+  </div>
+  <div class="mt-4 flex gap-3">
+    <button
+      type="button"
+      data-consent-choice="denied"
+      data-skip-tracking="true"
+      class="flex-1 rounded border border-gray-900 px-3 py-2 text-sm font-semibold text-gray-900 hover:bg-gray-100"
+    >
+      Reject analytics
+    </button>
+    <button
+      type="button"
+      data-consent-choice="granted"
+      data-skip-tracking="true"
+      class="flex-1 rounded border border-gray-900 bg-gray-900 px-3 py-2 text-sm font-semibold text-white hover:bg-gray-800"
+    >
+      Allow analytics
+    </button>
+  </div>
+</div>
+
+<script>
+  import {
+    hasAnalyticsConsent,
+    hasBrowserPrivacySignal,
+    readConsent,
+    writeConsent,
+    type ConsentValue,
+  } from '../utils/consent';
+
+  const ANALYTICS_SRC =
+    'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+  let analyticsLoaded = false;
+
+  function trackingDisabledOnPage(): boolean {
+    return document.documentElement.dataset.analytics === 'off';
+  }
+
+  function loadAnalytics() {
+    if (analyticsLoaded || trackingDisabledOnPage() || !hasAnalyticsConsent()) return;
+    analyticsLoaded = true;
+    const script = document.createElement('script');
+    script.src = ANALYTICS_SRC;
+    script.defer = true;
+    script.referrerPolicy = 'strict-origin';
+    document.head.appendChild(script);
+  }
+
+  function banner(): HTMLElement | null {
+    return document.getElementById('privacy-consent');
+  }
+
+  function showBanner() {
+    const el = banner();
+    if (!el) return;
+    document.getElementById('privacy-consent-signal')?.classList.toggle('hidden', !hasBrowserPrivacySignal());
+    el.hidden = false;
+  }
+
+  function hideBanner() {
+    const el = banner();
+    if (el) el.hidden = true;
+  }
+
+  function init() {
+    // Ask only when no valid choice exists and no browser opt-out signal is set
+    // (a GPC/DNT signal already is the visitor's answer).
+    if (!readConsent() && !hasBrowserPrivacySignal()) {
+      showBanner();
+    } else {
+      hideBanner();
+    }
+    loadAnalytics();
+  }
+
+  // Delegated so it keeps working across client-side navigations.
+  document.addEventListener('click', (event) => {
+    const target = event.target as HTMLElement | null;
+    if (!target) return;
+
+    if (target.closest('[data-privacy-settings]')) {
+      event.preventDefault();
+      showBanner();
+      return;
+    }
+
+    const choiceEl = target.closest<HTMLElement>('[data-consent-choice]');
+    if (choiceEl) {
+      const choice = choiceEl.dataset.consentChoice as ConsentValue;
+      writeConsent(choice);
+      hideBanner();
+      if (choice === 'granted') {
+        loadAnalytics();
+      } else if (analyticsLoaded) {
+        // A loaded third-party script cannot be reliably unloaded; reload so
+        // the withdrawal takes effect immediately.
+        window.location.reload();
+      }
+    }
+  });
+
+  // Run now (module scripts execute after parsing) and after every client-side navigation.
+  init();
+  document.addEventListener('astro:after-swap', init);
+</script>
