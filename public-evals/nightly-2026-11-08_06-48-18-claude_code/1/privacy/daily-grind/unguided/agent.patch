+#!/usr/bin/env node
+/**
+ * Static privacy & third-party audit for The Daily Grind website.
+ *
+ *   pnpm run audit:privacy
+ *
+ * Fails (exit 1) if:
+ *  - any HTML/CSS/JS references a third-party origin not in privacy/third-parties.json
+ *  - known tracker / ad-tech / analytics hosts or snippets appear anywhere
+ *  - inline <script>/<style>, inline event handlers, style="" or javascript: URLs
+ *    are used (they would require weakening the CSP)
+ *  - forms with sensitive fields submit via GET or to another origin
+ *  - target="_blank" links lack rel="noopener noreferrer"
+ *  - required security/privacy headers are missing from _headers
+ *  - the meta CSP and header CSP disagree on core directives
+ *
+ * No dependencies; Node 18+.
+ */
+import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs';
+import { join, relative, extname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url));
+const SKIP_DIRS = new Set(['node_modules', '.git', 'scripts', 'privacy', 'dist']);
+const SCAN_EXT = new Set(['.html', '.htm', '.css', '.js', '.mjs', '.svg', '.json', '.webmanifest']);
+
+const TRACKER_PATTERNS = [
+  /google-analytics\.com/i, /googletagmanager\.com/i, /\bgtag\s*\(/, /\bga\s*\(\s*['"]create/,
+  /doubleclick\.net/i, /googlesyndication\.com/i, /googleadservices\.com/i,
+  /connect\.facebook\.net/i, /\bfbq\s*\(/, /facebook\.com\/tr/i,
+  /hotjar\.com/i, /clarity\.ms/i, /mixpanel\.com/i, /segment\.(com|io)/i, /amplitude\.com/i,
+  /fullstory\.com/i, /mouseflow\.com/i, /crazyegg\.com/i, /quantserve\.com/i, /scorecardresearch\.com/i,
+  /tiktok\.com\/i18n\/pixel/i, /analytics\.tiktok\.com/i, /snap\.licdn\.com/i, /ads-twitter\.com/i,
+  /static\.ads-twitter\.com/i, /bat\.bing\.com/i, /pinimg\.com\/ct/i, /hs-scripts\.com/i,
+  /fonts\.googleapis\.com/i, /fonts\.gstatic\.com/i, // leak IPs to Google on every page view
+  /\bFingerprintJS\b/i, /\bfingerprintjs\b/i, /canvas\.toDataURL\s*\(/
+];
+
+const REQUIRED_HEADERS = [
+  'Content-Security-Policy',
+  'Strict-Transport-Security',
+  'Referrer-Policy',
+  'X-Content-Type-Options',
+  'Permissions-Policy',
+  'Cross-Origin-Opener-Policy',
+  'Cross-Origin-Resource-Policy'
+];
+
+const CORE_CSP_DIRECTIVES = ['default-src', 'script-src', 'style-src', 'img-src', 'connect-src', 'form-action', 'object-src', 'base-uri'];
+
+const errors = [];
+const warnings = [];
+const err = (file, msg) => errors.push(`${file}: ${msg}`);
+const warn = (file, msg) => warnings.push(`${file}: ${msg}`);
+
+function walk(dir) {
+  const out = [];
+  for (const name of readdirSync(dir)) {
+    if (name.startsWith('.') || SKIP_DIRS.has(name)) continue;
+    const full = join(dir, name);
+    const st = statSync(full);
+    if (st.isDirectory()) out.push(...walk(full));
+    else if (SCAN_EXT.has(extname(name).toLowerCase()) && name !== 'package.json') out.push(full);
+  }
+  return out;
+}
+
+function loadRegister() {
+  const path = join(ROOT, 'privacy', 'third-parties.json');
+  if (!existsSync(path)) {
+    err('privacy/third-parties.json', 'third-party register is missing');
+    return new Set();
+  }
+  const reg = JSON.parse(readFileSync(path, 'utf8'));
+  const set = new Set();
+  for (const tp of reg.approved || []) {
+    for (const field of ['name', 'origin', 'purpose', 'dataShared', 'legalBasis', 'dpaSigned', 'reviewedOn']) {
+      if (tp[field] === undefined) err('privacy/third-parties.json', `entry ${tp.origin || tp.name || '?'} missing "${field}"`);
+    }
+    if (tp.dpaSigned !== true) err('privacy/third-parties.json', `${tp.origin}: no signed DPA`);
+    if (tp.origin) set.add(new URL(tp.origin).origin);
+  }
+  if (reg.lastReviewed) {
+    const ageDays = (Date.now() - Date.parse(reg.lastReviewed)) / 86400000;
+    if (ageDays > 365) warn('privacy/third-parties.json', `register not reviewed in ${Math.round(ageDays)} days`);
+  }
+  return set;
+}
+
+// Matches absolute and protocol-relative URLs. Ignores XML namespaces and docs links in comments
+// are still flagged on purpose: comments ship to users too.
+const URL_RE = /(?:https?:)?\/\/(?:[a-z0-9-]+\.)+[a-z]{2,}(?::\d+)?[^\s"'`)<>]*/gi;
+const IGNORED_HOSTS = new Set(['www.w3.org']); // SVG/XML namespace identifiers, never fetched
+
+function stripComments(src, ext) {
+  if (ext === '.html' || ext === '.htm' || ext === '.svg') return src.replace(/<!--[\s\S]*?-->/g, '');
+  if (ext === '.css') return src.replace(/\/\*[\s\S]*?\*\//g, '');
+  if (ext === '.js' || ext === '.mjs') return src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:\\])\/\/[^\n]*/g, '$1');
+  return src;
+}
+
+function auditThirdParties(file, src, ext, approved) {
+  const code = stripComments(src, ext);
+  for (const m of code.matchAll(URL_RE)) {
+    let url;
+    try { url = new URL(m[0].startsWith('//') ? 'https:' + m[0] : m[0]); } catch { continue; }
+    if (IGNORED_HOSTS.has(url.hostname)) continue;
+    if (!approved.has(url.origin)) err(file, `unapproved third-party origin ${url.origin}`);
+    if (url.protocol === 'http:') err(file, `plaintext http:// resource ${url.origin}`);
+  }
+  for (const re of TRACKER_PATTERNS) {
+    if (re.test(src)) err(file, `tracker/ad-tech pattern detected: ${re}`);
+  }
+}
+
+function auditHtml(file, html) {
+  const code = stripComments(html, '.html');
+
+  for (const m of code.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)) {
+    if (m[2].trim() && !/type\s*=\s*["']?application\/(ld\+)?json/i.test(m[1])) err(file, 'inline <script> (move to an external first-party file)');
+    if (/\bsrc\s*=/.test(m[1]) && /\bintegrity\s*=/.test(m[1]) === false && /src\s*=\s*["']?(https?:)?\/\//i.test(m[1])) {
+      err(file, 'external script without Subresource Integrity');
+    }
+  }
+  if (/<style\b/i.test(code)) err(file, 'inline <style> block (requires style-src unsafe-inline)');
+  if (/\sstyle\s*=/i.test(code)) err(file, 'style="" attribute (requires style-src unsafe-inline)');
+  if (/\son[a-z]+\s*=/i.test(code)) err(file, 'inline event handler attribute');
+  if (/javascript:/i.test(code)) err(file, 'javascript: URL');
+
+  if (!/<meta[^>]+name=["']referrer["']/i.test(code)) warn(file, 'no <meta name="referrer">');
+
+  for (const m of code.matchAll(/<a\b[^>]*target\s*=\s*["']_blank["'][^>]*>/gi)) {
+    const rel = (m[0].match(/rel\s*=\s*["']([^"']*)["']/i) || [])[1] || '';
+    if (!/noopener/.test(rel) || !/noreferrer/.test(rel)) err(file, `target=_blank without rel="noopener noreferrer": ${m[0]}`);
+  }
+
+  for (const m of code.matchAll(/<form\b([^>]*)>([\s\S]*?)<\/form>/gi)) {
+    const attrs = m[1];
+    const body = m[2];
+    const method = ((attrs.match(/method\s*=\s*["']?(\w+)/i) || [])[1] || 'get').toLowerCase();
+    const action = (attrs.match(/action\s*=\s*["']([^"']*)["']/i) || [])[1] || '';
+    const sensitive = /type\s*=\s*["']?(password|email|tel)|autocomplete\s*=\s*["']?cc-|data-sensitive/i.test(body);
+    if (method === 'get' && sensitive) err(file, 'form with sensitive fields uses GET (data would leak into URLs/logs)');
+    if (/^(https?:)?\/\//i.test(action)) err(file, `form posts to another origin: ${action}`);
+    if (/action\s*=\s*["']\/logout/i.test(attrs) && method !== 'post') err(file, 'logout must be a POST');
+    for (const input of body.matchAll(/<input\b[^>]*>/gi)) {
+      const tag = input[0];
+      if (/type\s*=\s*["']?password/i.test(tag) && !/autocomplete\s*=/i.test(tag)) warn(file, 'password input without explicit autocomplete');
+      if (/type\s*=\s*["']?hidden/i.test(tag) && /value\s*=\s*["'][^"']*@[^"']*["']/i.test(tag)) err(file, 'hidden input appears to contain an email address');
+    }
+  }
+
+  if (/<a\b[^>]*href\s*=\s*["']\/logout["']/i.test(code)) err(file, 'logout implemented as a GET link');
+}
+
+function parseCsp(value) {
+  const map = new Map();
+  for (const part of value.split(';')) {
+    const [name, ...vals] = part.trim().split(/\s+/);
+    if (name) map.set(name.toLowerCase(), vals.sort().join(' '));
+  }
+  return map;
+}
+
+function auditHeaders(metaCsps) {
+  const path = join(ROOT, '_headers');
+  if (!existsSync(path)) {
+    err('_headers', 'missing security headers file');
+    return;
+  }
+  const txt = readFileSync(path, 'utf8');
+  for (const h of REQUIRED_HEADERS) {
+    if (!new RegExp(`^\\s+${h}:`, 'mi').test(txt)) err('_headers', `missing ${h}`);
+  }
+  const cspLine = txt.match(/^\s+Content-Security-Policy:\s*(.+)$/mi);
+  if (cspLine) {
+    const csp = parseCsp(cspLine[1]);
+    if (/unsafe-(inline|eval)/.test(cspLine[1])) err('_headers', 'CSP allows unsafe-inline/unsafe-eval');
+    if (!csp.has('frame-ancestors')) err('_headers', 'CSP missing frame-ancestors (clickjacking)');
+    for (const [file, metaValue] of metaCsps) {
+      const meta = parseCsp(metaValue);
+      for (const d of CORE_CSP_DIRECTIVES) {
+        if ((meta.get(d) || '') !== (csp.get(d) || '')) err(file, `meta CSP "${d}" differs from _headers CSP`);
+      }
+    }
+  }
+  if (!/Permissions-Policy:[^\n]*browsing-topics=\(\)/i.test(txt)) warn('_headers', 'Permissions-Policy does not opt out of browsing-topics');
+  if (!/Clear-Site-Data/i.test(txt)) warn('_headers', 'no Clear-Site-Data on logout');
+
+  const pkg = JSON.parse(readFileSync(join(ROOT, 'package.json'), 'utf8'));
+  if (!/--csp/.test(pkg.scripts?.start || '')) warn('package.json', 'dev server does not send a CSP header');
+}
+
+// ---------------------------------------------------------------------------
+const approved = loadRegister();
+approved.add('null');
+const files = walk(ROOT);
+const metaCsps = [];
+
+for (const full of files) {
+  const file = relative(ROOT, full);
+  const ext = extname(full).toLowerCase();
+  const src = readFileSync(full, 'utf8');
+  auditThirdParties(file, src, ext, approved);
+  if (ext === '.html' || ext === '.htm') {
+    auditHtml(file, src);
+    // CSP values contain single quotes ('self'), so match a double-quoted content attribute.
+    const m = src.match(/http-equiv="Content-Security-Policy"\s+content="([^"]+)"/i);
+    if (m) metaCsps.push([file, m[1]]);
+  }
+}
+
+auditHeaders(metaCsps);
+
+console.log(`Privacy audit: scanned ${files.length} file(s), ${approved.size - 1} approved third part${approved.size - 1 === 1 ? 'y' : 'ies'}.`);
+for (const w of warnings) console.log(`  warn  ${w}`);
+for (const e of errors) console.log(`  FAIL  ${e}`);
+if (errors.length) {
+  console.log(`\n${errors.length} problem(s) found.`);
+  process.exit(1);
+}
+console.log('OK — no third-party requests, trackers, or unsafe inline code found.');
