index 0000000..c2b1188
--- /dev/null
+++ b/assets/js/privacy.js
@@ -0,0 +1,546 @@
+/*!
+ * The Daily Grind — client-side privacy layer.
+ *
+ * Privacy-by-design principles implemented here:
+ *  1. Privacy as the default: nothing optional runs or is stored until the
+ *     user opts in. Global Privacy Control / Do Not Track are honoured as a
+ *     binding opt-out.
+ *  2. Data minimisation: tracking parameters are stripped from URLs, any
+ *     telemetry is reduced to an allow-listed set of coarse fields, and
+ *     free-text is scrubbed of PII before it could leave the page.
+ *  3. Purpose limitation & storage limitation: client storage is
+ *     category-scoped, consent-gated and time-limited; withdrawing consent
+ *     purges it immediately.
+ *  4. Third-party audit: every network resource the page loads is checked
+ *     against a first-party allow-list at runtime, and CSP violations are
+ *     surfaced (after redaction).
+ *  5. Secure handling: sensitive form fields are never sent via GET, never
+ *     cached by the browser, and are wiped when the page is hidden.
+ *
+ * This file has no dependencies and makes no third-party requests.
+ */
+(function () {
+  'use strict';
+
+  // ---------------------------------------------------------------------------
+  // Configuration
+  // ---------------------------------------------------------------------------
+  var CONFIG = {
+    // Bump when the purposes/categories change so users are asked again.
+    consentVersion: 1,
+    consentKey: 'dg_consent',
+    consentMaxAgeDays: 180,
+    storagePrefix: 'dg_',
+    categories: ['preferences', 'analytics'],
+    // Origins allowed to serve resources to this page. Keep in sync with CSP
+    // and THIRD_PARTY_AUDIT.md. Currently first-party only.
+    allowedOrigins: [window.location.origin],
+    // First-party, cookieless, aggregate metrics endpoint (only used with consent).
+    metricsEndpoint: '/api/metrics',
+    // Query parameters that exist only to track people across sites.
+    trackingParams: [
+      /^utm_/i, /^fbclid$/i, /^gclid$/i, /^gclsrc$/i, /^dclid$/i, /^gbraid$/i,
+      /^wbraid$/i, /^msclkid$/i, /^mc_(cid|eid)$/i, /^_hs(enc|mi)$/i, /^igshid$/i,
+      /^yclid$/i, /^twclid$/i, /^ttclid$/i, /^li_fat_id$/i, /^_ga$/i, /^_gl$/i,
+      /^mkt_tok$/i, /^oly_(anon|enc)_id$/i, /^vero_(conv|id)$/i, /^ref_?src$/i
+    ]
+  };
+
+  var DAY_MS = 24 * 60 * 60 * 1000;
+
+  // ---------------------------------------------------------------------------
+  // Safe storage access (storage can throw in private mode / when blocked)
+  // ---------------------------------------------------------------------------
+  function rawStore() {
+    try {
+      var s = window.localStorage;
+      var probe = CONFIG.storagePrefix + '__probe';
+      s.setItem(probe, '1');
+      s.removeItem(probe);
+      return s;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  var store = rawStore();
+
+  function readJSON(key) {
+    if (!store) return null;
+    try {
+      return JSON.parse(store.getItem(key));
+    } catch (e) {
+      store.removeItem(key); // corrupted or tampered: discard rather than trust
+      return null;
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Browser privacy signals
+  // ---------------------------------------------------------------------------
+  function hasOptOutSignal() {
+    var nav = window.navigator || {};
+    if (nav.globalPrivacyControl === true) return true;
+    var dnt = nav.doNotTrack || window.doNotTrack || nav.msDoNotTrack;
+    return dnt === '1' || dnt === 'yes';
+  }
+
+  // ---------------------------------------------------------------------------
+  // Consent management
+  // ---------------------------------------------------------------------------
+  function defaultConsent() {
+    var c = {};
+    CONFIG.categories.forEach(function (k) { c[k] = false; });
+    return c;
+  }
+
+  function getConsent() {
+    var saved = readJSON(CONFIG.consentKey);
+    var valid = saved &&
+      saved.v === CONFIG.consentVersion &&
+      typeof saved.expires === 'number' &&
+      saved.expires > Date.now();
+
+    if (!valid) {
+      if (saved && store) store.removeItem(CONFIG.consentKey);
+      return null;
+    }
+
+    var consent = defaultConsent();
+    CONFIG.categories.forEach(function (k) { consent[k] = saved.choices[k] === true; });
+
+    // An opt-out signal always wins over a stored opt-in.
+    if (hasOptOutSignal()) consent = defaultConsent();
+    return consent;
+  }
+
+  function setConsent(choices) {
+    var clean = defaultConsent();
+    if (!hasOptOutSignal()) {
+      CONFIG.categories.forEach(function (k) { clean[k] = choices && choices[k] === true; });
+    }
+
+    // Recording the choice itself is strictly necessary (it is how we
+    // remember that the user said "no"). It contains no identifiers.
+    if (store) {
+      store.setItem(CONFIG.consentKey, JSON.stringify({
+        v: CONFIG.consentVersion,
+        choices: clean,
+        // Day-granularity timestamp: enough to evidence consent, no more.
+        ts: new Date().toISOString().slice(0, 10),
+        expires: Date.now() + CONFIG.consentMaxAgeDays * DAY_MS
+      }));
+    }
+
+    // Storage limitation: withdrawing consent removes the data immediately.
+    CONFIG.categories.forEach(function (k) {
+      if (!clean[k]) purgeCategory(k);
+    });
+
+    document.dispatchEvent(new CustomEvent('dg:consentchange', { detail: clean }));
+    return clean;
+  }
+
+  function hasConsent(category) {
+    var c = getConsent();
+    return !!(c && c[category]);
+  }
+
+  // ---------------------------------------------------------------------------
+  // Consent-gated, category-scoped, expiring storage
+  // ---------------------------------------------------------------------------
+  function scopedKey(category, key) {
+    return CONFIG.storagePrefix + category + ':' + key;
+  }
+
+  var privacyStorage = {
+    /**
+     * Store a value only if the user consented to `category`.
+     * @param {string} category  one of CONFIG.categories
+     * @param {string} key
+     * @param {*} value          must be JSON-serialisable; never store PII here
+     * @param {number} [ttlDays] defaults to and is capped at consentMaxAgeDays
+     * @returns {boolean} whether the value was stored
+     */
+    set: function (category, key, value, ttlDays) {
+      if (!store || CONFIG.categories.indexOf(category) === -1) return false;
+      if (!hasConsent(category)) return false;
+      var ttl = Math.min(ttlDays || CONFIG.consentMaxAgeDays, CONFIG.consentMaxAgeDays);
+      store.setItem(scopedKey(category, key), JSON.stringify({
+        value: value,
+        expires: Date.now() + ttl * DAY_MS
+      }));
+      return true;
+    },
+    get: function (category, key) {
+      if (!store || !hasConsent(category)) return null;
+      var item = readJSON(scopedKey(category, key));
+      if (!item || typeof item.expires !== 'number' || item.expires <= Date.now()) {
+        store.removeItem(scopedKey(category, key));
+        return null;
+      }
+      return item.value;
+    },
+    remove: function (category, key) {
+      if (store) store.removeItem(scopedKey(category, key));
+    }
+  };
+
+  function purgeCategory(category) {
+    if (!store) return;
+    var prefix = CONFIG.storagePrefix + category + ':';
+    for (var i = store.length - 1; i >= 0; i--) {
+      var k = store.key(i);
+      if (k && k.indexOf(prefix) === 0) store.removeItem(k);
+    }
+  }
+
+  // Removes expired items and anything not owned by a known category.
+  function sweepStorage() {
+    if (!store) return;
+    var now = Date.now();
+    var consent = getConsent() || defaultConsent();
+    for (var i = store.length - 1; i >= 0; i--) {
+      var k = store.key(i);
+      if (!k || k.indexOf(CONFIG.storagePrefix) !== 0 || k === CONFIG.consentKey) continue;
+      var category = k.slice(CONFIG.storagePrefix.length).split(':')[0];
+      var item = readJSON(k);
+      if (!consent[category] || !item || typeof item.expires !== 'number' || item.expires <= now) {
+        store.removeItem(k);
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Data minimisation helpers
+  // ---------------------------------------------------------------------------
+  var PII_PATTERNS = [
+    { re: /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, label: '[email]' },
+    { re: /\b(?:\d[ -]?){13,19}\b/g, label: '[card]' },
+    { re: /\+?\d[\d\s().-]{7,}\d/g, label: '[phone]' },
+    { re: /\b\d{3}-\d{2}-\d{4}\b/g, label: '[ssn]' },
+    { re: /\b(?:\d{1,3}\.){3}\d{1,3}\b/g, label: '[ip]' },
+    { re: /\b(?:bearer|token|session|sid|auth)[=:\s]+[\w.~+/-]+/gi, label: '[secret]' }
+  ];
+
+  /** Scrub common PII patterns from free text before logging/sending. */
+  function redact(text) {
+    var out = String(text == null ? '' : text);
+    PII_PATTERNS.forEach(function (p) { out = out.replace(p.re, p.label); });
+    return out.slice(0, 500);
+  }
+
+  /** Keep only allow-listed keys (deny by default). */
+  function minimize(obj, allowedKeys) {
+    var out = {};
+    (allowedKeys || []).forEach(function (k) {
+      if (obj && Object.prototype.hasOwnProperty.call(obj, k)) {
+        out[k] = typeof obj[k] === 'string' ? redact(obj[k]) : obj[k];
+      }
+    });
+    return out;
+  }
+
+  /** Path with IDs generalised and no query string or fragment. */
+  function coarsePath(pathname) {
+    return String(pathname || '/')
+      .split('/')
+      .map(function (seg) {
+        if (/^\d+$/.test(seg)) return ':id';
+        if (/^[0-9a-f]{8,}$/i.test(seg) || /^[0-9a-f-]{36}$/i.test(seg)) return ':id';
+        if (seg.indexOf('@') !== -1) return ':redacted';
+        return seg;
+      })
+      .join('/');
+  }
+
+  /** Remove cross-site tracking parameters from the address bar. */
+  function stripTrackingParams() {
+    if (!window.history || !window.history.replaceState || !window.URL) return;
+    var url;
+    try { url = new URL(window.location.href); } catch (e) { return; }
+    var changed = false;
+    Array.from(url.searchParams.keys()).forEach(function (name) {
+      var isTracker = CONFIG.trackingParams.some(function (re) { return re.test(name); });
+      if (isTracker) {
+        url.searchParams.delete(name);
+        changed = true;
+      }
+    });
+    if (changed) {
+      window.history.replaceState(window.history.state, '', url.pathname + url.search + url.hash);
+    }
+  }
+
+  /** Strip tracking params from outbound links before navigation. */
+  function cleanLink(anchor) {
+    if (!anchor || !anchor.href) return;
+    var url;
+    try { url = new URL(anchor.href, window.location.href); } catch (e) { return; }
+    if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
+    var changed = false;
+    Array.from(url.searchParams.keys()).forEach(function (name) {
+      if (CONFIG.trackingParams.some(function (re) { return re.test(name); })) {
+        url.searchParams.delete(name);
+        changed = true;
+      }
+    });
+    if (changed) anchor.href = url.toString();
+
+    // External links: no opener access and no full referrer.
+    if (url.origin !== window.location.origin) {
+      var rel = (anchor.getAttribute('rel') || '').split(/\s+/);
+      ['noopener', 'noreferrer'].forEach(function (r) {
+        if (rel.indexOf(r) === -1) rel.push(r);
+      });
+      anchor.setAttribute('rel', rel.join(' ').trim());
+      anchor.setAttribute('referrerpolicy', 'no-referrer');
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Runtime third-party audit
+  // ---------------------------------------------------------------------------
+  var auditFindings = [];
+
+  function recordFinding(type, detail) {
+    var finding = { type: type, detail: redact(detail), at: new Date().toISOString() };
+    auditFindings.push(finding);
+    if (auditFindings.length > 50) auditFindings.shift();
+    if (window.console && console.warn) {
+      console.warn('[privacy-audit] ' + type + ': ' + finding.detail);
+    }
+  }
+
+  function originOf(url) {
+    try { return new URL(url, window.location.href).origin; } catch (e) { return null; }
+  }
+
+  function checkResource(name) {
+    var origin = originOf(name);
+    // data:, blob: etc. have opaque origins ("null") and are not network fetches.
+    if (!origin || origin === 'null') return;
+    if (CONFIG.allowedOrigins.indexOf(origin) === -1) {
+      // Only the origin is recorded; never the full URL (may carry identifiers).
+      recordFinding('third-party-request', origin);
+    }
+  }
+
+  function startThirdPartyAudit() {
+    if (window.performance && performance.getEntriesByType) {
+      performance.getEntriesByType('resource').forEach(function (e) { checkResource(e.name); });
+    }
+    if ('PerformanceObserver' in window) {
+      try {
+        new PerformanceObserver(function (list) {
+          list.getEntries().forEach(function (e) { checkResource(e.name); });
+        }).observe({ type: 'resource', buffered: true });
+      } catch (e) { /* unsupported entry type */ }
+    }
+
+    // Audit any third-party scripts/iframes/pixels injected into the DOM.
+    if ('MutationObserver' in window) {
+      new MutationObserver(function (mutations) {
+        mutations.forEach(function (m) {
+          m.addedNodes.forEach(function (node) {
+            if (node.nodeType !== 1) return;
+            var src = node.getAttribute && (node.getAttribute('src') || node.getAttribute('data'));
+            if (src && /^(SCRIPT|IFRAME|IMG|OBJECT|EMBED)$/.test(node.tagName)) checkResource(src);
+          });
+        });
+      }).observe(document.documentElement, { childList: true, subtree: true });
+    }
+
+    document.addEventListener('securitypolicyviolation', function (e) {
+      recordFinding('csp-violation', e.violatedDirective + ' blocked ' + (originOf(e.blockedURI) || e.blockedURI));
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Secure form handling
+  // ---------------------------------------------------------------------------
+  var SENSITIVE_SELECTOR = [
+    'input[type="password"]', 'input[type="email"]', 'input[type="tel"]',
+    'input[autocomplete^="cc-"]', 'input[data-sensitive]', 'textarea[data-sensitive]'
+  ].join(',');
+
+  function hardenForms() {
+    // Card security codes must never be retained in browser autofill history.
+    document.querySelectorAll('input[autocomplete="cc-csc"]').forEach(function (i) {
+      i.setAttribute('autocomplete', 'off');
+    });
+
+    document.addEventListener('submit', function (e) {
+      var form = e.target;
+      if (!(form instanceof HTMLFormElement)) return;
+      var method = (form.getAttribute('method') || 'get').toLowerCase();
+      if (method === 'dialog') return;
+
+      // Sensitive data must never end up in URLs (history, logs, Referer).
+      if (method === 'get' && form.querySelector(SENSITIVE_SELECTOR)) {
+        e.preventDefault();
+        recordFinding('insecure-form', 'blocked GET submission containing sensitive fields');
+        return;
+      }
+
+      // Never post data off-site or over plaintext.
+      var action = form.action ? new URL(form.action, window.location.href) : window.location;
+      if (action.origin !== window.location.origin || action.protocol !== window.location.protocol) {
+        e.preventDefault();
+        recordFinding('insecure-form', 'blocked submission to ' + action.origin);
+        return;
+      }
+
+      // Drop empty optional fields so we only send what the user actually gave.
+      form.querySelectorAll('input[data-optional], textarea[data-optional], select[data-optional]').forEach(function (el) {
+        if (!el.value) el.disabled = true;
+      });
+    }, true);
+
+    // Wipe sensitive values when the page is hidden so they don't persist in
+    // the back/forward cache or get restored on shared devices.
+    window.addEventListener('pagehide', function () {
+      document.querySelectorAll('input[type="password"], input[autocomplete^="cc-"], [data-sensitive]').forEach(function (el) {
+        el.value = '';
+      });
+    });
+  }
+
+  // ---------------------------------------------------------------------------
+  // Consent-gated, minimal, first-party aggregate metrics
+  // ---------------------------------------------------------------------------
+  var metricsSent = false;
+
+  function sendPageview() {
+    if (metricsSent || !hasConsent('analytics') || hasOptOutSignal()) return;
+    if (!navigator.sendBeacon) return;
+    metricsSent = true;
+    // No cookies, no user/device ID, no full URL, no referrer, no user agent,
+    // no screen size or timezone (fingerprinting surface). Just a coarse path.
+    var payload = minimize({ path: coarsePath(window.location.pathname), event: 'pageview' }, ['path', 'event']);
+    try {
+      navigator.sendBeacon(CONFIG.metricsEndpoint, new Blob([JSON.stringify(payload)], { type: 'application/json' }));
+    } catch (e) { /* best-effort only */ }
+  }
+
+  // ---------------------------------------------------------------------------
+  // UI: banner + preferences dialog
+  // ---------------------------------------------------------------------------
+  function initUI() {
+    var banner = document.getElementById('consent-banner');
+    var dialog = document.getElementById('consent-dialog');
+    var form = document.getElementById('consent-form');
+    var gpcNotice = document.getElementById('gpc-notice');
+    var optOut = hasOptOutSignal();
+
+    // A browser opt-out signal is treated as a final "no": record it and don't nag.
+    if (optOut && !getConsent()) setConsent(defaultConsent());
+
+    if (banner && !getConsent()) banner.hidden = false;
+
+    function syncForm() {
+      if (!form) return;
+      var c = getConsent() || defaultConsent();
+      CONFIG.categories.forEach(function (k) {
+        var box = form.elements[k];
+        if (!box) return;
+        box.checked = !!c[k];
+        box.disabled = optOut;
+      });
+      if (gpcNotice) gpcNotice.hidden = !optOut;
+    }
+
+    function openDialog() {
+      if (!dialog) return;
+      syncForm();
+      dialog.hidden = false;
+      if (typeof dialog.showModal === 'function') dialog.showModal();
+      else dialog.setAttribute('open', '');
+    }
+
+    function closeDialog() {
+      if (!dialog) return;
+      if (typeof dialog.close === 'function' && dialog.open) dialog.close();
+      dialog.removeAttribute('open');
+      dialog.hidden = true;
+    }
+
+    function decided() {
+      if (banner) banner.hidden = true;
+    }
+
+    document.addEventListener('click', function (e) {
+      var opener = e.target.closest('[data-privacy-open]');
+      if (opener) {
+        e.preventDefault();
+        openDialog();
+        return;
+      }
+      var choice = e.target.closest('[data-consent]');
+      if (choice) {
+        var all = choice.getAttribute('data-consent') === 'accept';
+        var c = defaultConsent();
+        CONFIG.categories.forEach(function (k) { c[k] = all; });
+        setConsent(c);
+        decided();
+        return;
+      }
+      var link = e.target.closest('a[href]');
+      if (link) cleanLink(link);
+    });
+
+    if (form) {
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var submitter = e.submitter;
+        var rejectAll = submitter && submitter.value === 'reject';
+        var c = defaultConsent();
+        if (!rejectAll) {
+          CONFIG.categories.forEach(function (k) {
+            c[k] = !!(form.elements[k] && form.elements[k].checked);
+          });
+        }
+        setConsent(c);
+        decided();
+        closeDialog();
+      });
+    }
+
+    if (dialog) {
+      dialog.addEventListener('close', function () { dialog.hidden = true; });
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Boot
+  // ---------------------------------------------------------------------------
+  stripTrackingParams();
+  startThirdPartyAudit();
+
+  function onReady() {
+    sweepStorage();
+    hardenForms();
+    initUI();
+    document.querySelectorAll('a[href]').forEach(cleanLink);
+    sendPageview();
+  }
+
+  document.addEventListener('dg:consentchange', function (e) {
+    if (e.detail && e.detail.analytics) sendPageview();
+  });
+
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
+  else onReady();
+
+  // Minimal public API for other first-party scripts.
+  window.DailyGrindPrivacy = Object.freeze({
+    hasConsent: hasConsent,
+    getConsent: getConsent,
+    setConsent: setConsent,
+    storage: Object.freeze(privacyStorage),
+    redact: redact,
+    minimize: minimize,
+    coarsePath: coarsePath,
+    auditReport: function () { return auditFindings.slice(); }
+  });
+})();
