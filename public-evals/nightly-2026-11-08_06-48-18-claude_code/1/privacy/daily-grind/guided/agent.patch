+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.privacy-notice {
+  max-width: 60ch;
+  margin: 0 auto 20px;
+  font-size: 0.85rem;
+}
+
+.privacy-notice h2 {
+  font-size: 1rem;
+  margin-bottom: 5px;
+}
