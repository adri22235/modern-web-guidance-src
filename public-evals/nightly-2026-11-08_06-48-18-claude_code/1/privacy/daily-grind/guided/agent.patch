diff --git a/js/privacy.js b/js/privacy.js
new file mode 100644
index 0000000..8890299
--- /dev/null
+++ b/js/privacy.js
@@ -0,0 +1,53 @@
+// Privacy-by-design helpers for The Daily Grind.
+//
+// Principles enforced here:
+//  - Data minimization: drop third-party tracking identifiers from the URL so
+//    they are never bookmarked, shared, logged by our server on later
+//    navigations, or exposed via Referer.
+//  - Secure data handling: on logout, wipe anything a script may have left in
+//    client-side storage. The server's `Clear-Site-Data` response header is the
+//    primary mechanism; this is a fallback for browsers that ignore it.
+//  - No fingerprinting, no analytics, no third-party requests, no DOM-XSS sinks
+//    (the page enforces Trusted Types with `trusted-types 'none'`).
+
+const TRACKING_PARAMS = new Set([
+  'fbclid', 'gclid', 'gbraid', 'wbraid', 'dclid', 'msclkid', 'twclid',
+  'ttclid', 'li_fat_id', 'igshid', 'yclid', 'mc_cid', 'mc_eid', '_hsenc',
+  '_hsmi', 'mkt_tok', 'ref_src',
+]);
+
+function isTrackingParam(name) {
+  const key = name.toLowerCase();
+  return key.startsWith('utm_') || TRACKING_PARAMS.has(key);
+}
+
+function stripTrackingParams() {
+  const url = new URL(window.location.href);
+  let changed = false;
+  for (const name of [...url.searchParams.keys()]) {
+    if (isTrackingParam(name)) {
+      url.searchParams.delete(name);
+      changed = true;
+    }
+  }
+  if (changed) {
+    history.replaceState(history.state, '', url);
+  }
+}
+
+function clearClientStorage() {
+  try {
+    localStorage.clear();
+    sessionStorage.clear();
+  } catch {
+    // Storage may be disabled or blocked; nothing to clear.
+  }
+}
+
+function wireLogout() {
+  const form = document.querySelector('form[data-logout]');
+  form?.addEventListener('submit', clearClientStorage);
+}
+
+stripTrackingParams();
+wireLogout();
