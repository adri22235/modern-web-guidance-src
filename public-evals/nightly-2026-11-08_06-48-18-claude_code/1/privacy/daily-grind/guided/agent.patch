new file mode 100644
index 0000000..bf94cf9
--- /dev/null
+++ b/docs/PRIVACY-BY-DESIGN.md
@@ -0,0 +1,66 @@
+# Privacy by design: The Daily Grind website
+
+Last reviewed: 2026-11-08. Review again whenever a script, embed, font, image
+host, form field, or cookie is added.
+
+## 1. Third-party audit
+
+Method: we listed every external URL in the HTML, CSS and JS
+(`grep -rnoE "https?://[^\"') ]+" index.html css js`) and checked which origins
+the page contacts when it loads.
+
+| Resource | Before | Data exposed | Decision |
+|---|---|---|---|
+| Hero photo (`images.unsplash.com`, imgix CDN) | Fetched on every page view | Visitor IP, User-Agent, `Referer`, and timing, sent to a third party | **Self-hosted** in `/images/hero.{webp,jpg}` with all EXIF/metadata stripped. Unsplash License permits this. |
+| Fonts | System font stack only | none | Keep. Do not add Google Fonts or other hosted fonts; self-host if needed. |
+| Analytics / tag managers / pixels | none | n/a | Keep none. Any future measurement must be first-party, aggregate, and cookieless. |
+| Social embeds / share widgets | none | n/a | If added, use plain share links or a click-to-load façade. |
+
+Result: the page loads **only same-origin resources**. The CSP
+(`default-src 'none'`, `*-src 'self'`) and `Connection-Allowlist: (response-origin)`
+enforce this, so any new third party is blocked until it is reviewed and added
+here on purpose.
+
+## 2. Data inventory and minimization
+
+| Data | Where | Purpose | Retention |
+|---|---|---|---|
+| Session cookie | Set by server after sign-in | Keep the user signed in | Session; cleared on logout via `Clear-Site-Data` |
+| Tracking URL params (`utm_*`, `gclid`, `fbclid`, …) | Incoming links | none | Removed from the address bar on load by `js/privacy.js` |
+| Client storage (`localStorage` / `sessionStorage`) | not used | n/a | Wiped on logout as a fallback |
+
+The site does not collect speculatively. New form fields must state why they
+are needed, inline next to the field, and should be optional unless the task
+cannot be done without them.
+
+## 3. Headers (see `_headers`, mirrored in `docs/nginx-privacy-headers.conf`)
+
+- **Content-Security-Policy**: same-origin only, no inline script or style,
+  Trusted Types enforced (`trusted-types 'none'` because no DOM sinks are used),
+  `frame-ancestors 'none'`, `form-action 'self'`. Violations are reported to
+  `/api/security-reports`.
+- **Connection-Allowlist**: network-layer allowlist that also blocks
+  preconnect, DNS-prefetch, and WebRTC exfiltration (Chromium 152+). CSP covers
+  other browsers.
+- **Referrer-Policy**: `strict-origin-when-cross-origin`, so paths and query
+  strings never leak cross-origin.
+- **Permissions-Policy**: denies all powerful and ad-tech features (camera,
+  geolocation, Topics, Protected Audience, Attribution Reporting, Shared
+  Storage, …). Only `publickey-credentials-get` (passkeys) is allowed, and only
+  for this origin.
+- **Clear-Site-Data** on `/logout`: `"cookies", "storage"`.
+- HSTS, `nosniff`, `X-Frame-Options: DENY`, COOP/CORP `same-origin`, and
+  `Cache-Control: private` / `no-store` for pages that may show account state.
+- **Global Privacy Control**: declared in `/.well-known/gpc.json`.
+
+## 4. Server-side requirements (outside this static bundle)
+
+- Session cookie: `Set-Cookie: __Host-session=…; Secure; HttpOnly; SameSite=Lax; Path=/`.
+- `POST /logout` must check a CSRF token or rely on `SameSite=Lax` plus the
+  `Sec-Fetch-Site: same-origin` request header. It must destroy the server
+  session and respond with `Clear-Site-Data: "cookies", "storage"`.
+- `/account/privacy` must provide self-service export and deletion of the
+  account, and be as easy to use as sign-up.
+- Scrub PII (emails, tokens, IPs, query strings) from access logs and from
+  `/api/security-reports` payloads before storing them. Rate-limit both endpoints.
+- If `Sec-GPC: 1` is present, treat it as an opt-out of any sale or sharing of data.
diff --git a/docs/nginx-privacy-headers.conf b/docs/nginx-privacy-headers.conf
new file mode 100644
index 0000000..3dd4266
--- /dev/null
+++ b/docs/nginx-privacy-headers.conf
@@ -0,0 +1,22 @@
+# nginx equivalent of /_headers (global block). Include inside the `server {}` block.
+# Per-path headers (/logout, /account/*) belong in matching `location` blocks.
+
+add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'report-sample'; style-src 'self' 'report-sample'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-src 'none'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'; report-to csp" always;
+add_header Reporting-Endpoints 'csp="/api/security-reports"' always;
+add_header Connection-Allowlist '(response-origin); redirects=allow; report-to=csp' always;
+add_header Referrer-Policy 'strict-origin-when-cross-origin' always;
+add_header Permissions-Policy 'accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), compute-pressure=(), display-capture=(), encrypted-media=(), focus-without-user-activation=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), join-ad-interest-group=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), private-aggregation=(), private-state-token-issuance=(), private-state-token-redemption=(), publickey-credentials-get=(self), run-ad-auction=(), screen-wake-lock=(), serial=(), shared-storage=(), shared-storage-select-url=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()' always;
+add_header Strict-Transport-Security 'max-age=31536000; includeSubDomains' always;
+add_header X-Content-Type-Options 'nosniff' always;
+add_header X-Frame-Options 'DENY' always;
+add_header Cross-Origin-Opener-Policy 'same-origin' always;
+add_header Cross-Origin-Resource-Policy 'same-origin' always;
+add_header Vary 'Sec-Fetch-Dest' always;
+
+# NOTE: nginx drops inherited add_header directives inside a location that sets its own;
+# repeat the global headers here (or use an include file) in real configs.
+location = /logout {
+    add_header Clear-Site-Data '"cookies", "storage"' always;
+    add_header Cache-Control "no-store" always;
+    # proxy_pass to the app server ...
+}
