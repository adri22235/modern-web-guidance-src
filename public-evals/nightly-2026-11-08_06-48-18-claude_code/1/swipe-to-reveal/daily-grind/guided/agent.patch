+    /* Seasonal Favorites: swipe-to-reveal drink actions */
+    .card.SwipeReveal {
+      padding: 0;
+    }
+
+    .SwipeReveal {
+      /* Column 1: full-width drink details. Column 2: auto-sized actions. */
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      /* No local bounce on the action strip; excess scroll chains to the page. */
+      overscroll-behavior: chain;
+    }
+
+    /* Mouse users without a horizontal-scrolling trackpad still need a handle. */
+    @media (pointer: fine) {
+      .SwipeReveal {
+        scrollbar-width: thin;
+        scrollbar-color: var(--secondary) transparent;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .swipe-hint {
+      display: block;
+      margin-top: 12px;
+      font-size: 0.75rem;
+      color: #8d6e63;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+    }
+
+    .swipe-action {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      gap: 4px;
+      min-inline-size: 84px;
+      padding: 0 12px;
+      border: 0;
+      font: inherit;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: white;
+      text-decoration: none;
+      cursor: pointer;
+      transition: filter 0.2s;
+    }
+
+    .swipe-action:hover {
+      filter: brightness(1.1);
+    }
+
+    .swipe-action:focus-visible {
+      outline: 3px solid var(--text);
+      outline-offset: -3px;
+    }
+
+    .swipe-action .icon {
+      font-size: 1.25rem;
+      line-height: 1;
