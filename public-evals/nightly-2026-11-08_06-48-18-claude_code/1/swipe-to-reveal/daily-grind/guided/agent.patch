+  <script>
+    // Tabbing back from the revealed actions into the drink details snaps the card closed.
+    for (const content of document.querySelectorAll('.SwipeReveal-content')) {
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+
+    // Actions only run when the user explicitly activates a revealed button.
+    const status = document.getElementById('drink-action-status');
+    const announce = (message) => { status.textContent = message; };
+
+    document.querySelector('.grid').addEventListener('click', async (event) => {
+      const button = event.target.closest('button[data-action]');
+      if (!button) return;
+      const drink = button.dataset.drink;
+
+      if (button.dataset.action === 'favorite') {
+        const pressed = button.getAttribute('aria-pressed') !== 'true';
+        button.setAttribute('aria-pressed', String(pressed));
+        announce(pressed ? `${drink} added to favorites` : `${drink} removed from favorites`);
+      } else if (button.dataset.action === 'share') {
+        const url = new URL(button.dataset.url, location.href).href;
+        try {
+          if (navigator.share) {
+            await navigator.share({ title: drink, text: `Try the ${drink} at The Daily Grind`, url });
+          } else {
+            await navigator.clipboard.writeText(url);
+            announce(`Link to ${drink} copied`);
+          }
+        } catch (err) {
+          if (err.name !== 'AbortError') announce(`Couldn't share ${drink}`);
+        }
+      }
+    });
+  </script>
+
