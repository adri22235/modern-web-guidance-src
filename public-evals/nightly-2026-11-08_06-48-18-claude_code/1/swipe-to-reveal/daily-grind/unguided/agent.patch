+  <div class="toast" role="status" aria-live="polite"></div>
+
+  <script>
+    (function () {
+      // Swiping only *reveals* actions; nothing runs until a button is tapped.
+      var DRAG_START = 8;       // px of movement before we decide on direction
+      var RUBBER_BAND = 0.25;   // resistance when dragging past the panel width
+      var cards = Array.prototype.slice.call(document.querySelectorAll('.swipe-card'));
+      var toast = document.querySelector('.toast');
+      var toastTimer;
+      var openCard = null;
+
+      function showToast(msg) {
+        toast.textContent = msg;
+        toast.classList.add('is-visible');
+        clearTimeout(toastTimer);
+        toastTimer = setTimeout(function () { toast.classList.remove('is-visible'); }, 2200);
+      }
+
+      function setupCard(card) {
+        var content = card.querySelector('.swipe-content');
+        var left = card.querySelector('.swipe-actions--left');
+        var right = card.querySelector('.swipe-actions--right');
+        var toggle = card.querySelector('.swipe-toggle');
+        var name = card.dataset.drink;
+        var offset = 0;
+        var state = null; // drag state
+
+        function setOffset(x) {
+          offset = x;
+          content.style.transform = x ? 'translate3d(' + x + 'px,0,0)' : '';
+        }
+
+        function setOpen(side) {
+          var x = side === 'left' ? left.offsetWidth : side === 'right' ? -right.offsetWidth : 0;
+          setOffset(x);
+          left.inert = side !== 'left';
+          right.inert = side !== 'right';
+          toggle.setAttribute('aria-expanded', String(side === 'right'));
+          toggle.setAttribute('aria-label', (side ? 'Hide' : 'Show') + ' actions for ' + name);
+          card.dataset.open = side || '';
+          if (side) {
+            if (openCard && openCard !== api) openCard.close();
+            openCard = api;
+          } else if (openCard === api) {
+            openCard = null;
+          }
+        }
+
+        var api = { card: card, close: function () { setOpen(null); } };
+
+        content.addEventListener('pointerdown', function (e) {
+          delete content.dataset.suppressClick;
+          if (e.button !== 0 || e.target.closest('.swipe-toggle')) return;
+          state = { id: e.pointerId, x: e.clientX, y: e.clientY, base: offset, dragging: false, moved: false };
+        });
+
+        content.addEventListener('pointermove', function (e) {
+          if (!state || e.pointerId !== state.id) return;
+          var dx = e.clientX - state.x;
+          var dy = e.clientY - state.y;
+
+          if (!state.dragging) {
+            if (Math.abs(dx) < DRAG_START && Math.abs(dy) < DRAG_START) return;
+            if (Math.abs(dy) > Math.abs(dx)) { state = null; return; } // vertical scroll wins
+            state.dragging = true;
+            state.moved = true;
+            card.classList.add('is-dragging');
+            try { content.setPointerCapture(e.pointerId); } catch (err) {}
+          }
+
+          var maxL = left.offsetWidth;
+          var maxR = right.offsetWidth;
+          var x = state.base + dx;
+          // Clamp with resistance so an over-swipe never "commits" anything.
+          if (x > maxL) x = maxL + (x - maxL) * RUBBER_BAND;
+          if (x < -maxR) x = -maxR + (x + maxR) * RUBBER_BAND;
+          setOffset(x);
+          e.preventDefault();
+        });
+
+        function endDrag(e) {
+          if (!state || e.pointerId !== state.id) return;
+          var wasDragging = state.dragging;
+          state = null;
+          card.classList.remove('is-dragging');
+          if (!wasDragging) return;
+
+          // Swallow the click the browser fires after a drag (cleared on the next press).
+          content.dataset.suppressClick = '1';
+
+          var maxL = left.offsetWidth;
+          var maxR = right.offsetWidth;
+          if (offset > maxL / 2) setOpen('left');
+          else if (offset < -maxR / 2) setOpen('right');
+          else setOpen(null);
+        }
+
+        content.addEventListener('pointerup', endDrag);
+        content.addEventListener('pointercancel', endDrag);
+        content.addEventListener('lostpointercapture', endDrag);
+
+        // A drag must never follow a link (e.g. "View Details"); a tap on an open card closes it.
+        content.addEventListener('click', function (e) {
+          if (content.dataset.suppressClick) {
+            delete content.dataset.suppressClick;
+            e.preventDefault();
+            e.stopPropagation();
+            return;
+          }
+          if (card.dataset.open && !e.target.closest('.swipe-toggle')) {
+            e.preventDefault();
+            setOpen(null);
+          }
+        }, true);
+
+        content.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        // Keyboard / mouse fallback for revealing actions without swiping.
+        toggle.addEventListener('click', function () {
+          var opening = !card.dataset.open;
+          setOpen(opening ? 'right' : null);
+          if (opening) {
+            var first = right.querySelector('.swipe-action');
+            if (first) first.focus({ preventScroll: true });
+          }
+        });
+
+        card.addEventListener('keydown', function (e) {
+          if (e.key === 'Escape' && card.dataset.open) {
+            setOpen(null);
+            toggle.focus();
+          }
+        });
+
+        // Explicit action: favorite toggles in place.
+        var fav = left.querySelector('[data-action="favorite"]');
+        fav.addEventListener('click', function () {
+          var on = fav.getAttribute('aria-pressed') !== 'true';
+          fav.setAttribute('aria-pressed', String(on));
+          fav.querySelector('.icon').innerHTML = on ? '&#9829;' : '&#9825;';
+          fav.querySelector('.label').textContent = on ? 'Saved' : 'Favorite';
+          fav.setAttribute('aria-label', (on ? 'Remove ' + name + ' from' : 'Save ' + name + ' to') + ' favorites');
+          showToast(on ? name + ' saved to favorites' : name + ' removed from favorites');
+        });
+
+        setOpen(null);
+        return api;
+      }
+
+      cards.forEach(setupCard);
+
+      // Tapping elsewhere closes the open card.
+      document.addEventListener('pointerdown', function (e) {
+        if (openCard && !openCard.card.contains(e.target)) openCard.close();
+      });
+
+      window.addEventListener('resize', function () {
+        if (openCard) openCard.close();
+      });
+    })();
+  </script>
+
 </body>
 
