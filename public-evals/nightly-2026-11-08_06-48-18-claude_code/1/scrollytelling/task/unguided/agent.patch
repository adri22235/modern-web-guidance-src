       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Scrollytelling (pure CSS: scroll-driven animations + timeline-scope) */
+    .scrolly {
+      /* Hoist the view timelines declared on #tracked sections so the
+         sibling #animated branch can reference them. */
+      timeline-scope: --chapter-1, --chapter-2, --chapter-3, --chapter-4;
+      display: grid;
+      grid-template-columns: 1fr 1fr;
+      gap: 40px;
+      margin-top: 80px;
+    }
+
+    .scrolly > h2 {
+      grid-column: 1 / -1;
+      text-align: center;
+    }
+
+    #tracked section {
+      min-height: 90vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      padding: 20px 0;
+    }
+
+    #tracked section:nth-child(1) { view-timeline-name: --chapter-1; }
+    #tracked section:nth-child(2) { view-timeline-name: --chapter-2; }
+    #tracked section:nth-child(3) { view-timeline-name: --chapter-3; }
+    #tracked section:nth-child(4) { view-timeline-name: --chapter-4; }
+
+    #tracked .step {
+      font-size: 0.8rem;
+      font-weight: bold;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+      color: var(--accent);
+    }
+
+    #tracked h3 {
+      font-size: 1.8rem;
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    #animated {
+      position: sticky;
+      top: calc(50vh - 30vh + 30px); /* centered below the sticky nav */
+      height: 60vh;
+      display: grid; /* stack all sections in the same cell */
+      align-self: start;
+    }
+
+    #animated section {
+      grid-area: 1 / 1;
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
+      background: var(--secondary);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    @supports (animation-timeline: view()) and (timeline-scope: --a) {
+      #animated section {
+        opacity: 0;
+        /* Only opacity/transform: compositor-friendly, runs off the main thread */
+        animation: reveal linear both;
+        animation-range: cover 0% cover 100%;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --chapter-1; }
+      #animated section:nth-child(2) { animation-timeline: --chapter-2; }
+      #animated section:nth-child(3) { animation-timeline: --chapter-3; }
+      #animated section:nth-child(4) { animation-timeline: --chapter-4; }
+
+      @keyframes reveal {
+        0% {
+          opacity: 0;
+          transform: translateY(40px) scale(0.94);
+        }
+        30%, 70% {
+          opacity: 1;
+          transform: none;
+        }
+        100% {
+          opacity: 0;
+          transform: translateY(-40px) scale(1.03);
+        }
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        @keyframes reveal {
+          0%, 25% { opacity: 0; }
+          35%, 65% { opacity: 1; }
+          75%, 100% { opacity: 0; }
+        }
+      }
+    }
+
+    /* Fallback: no scroll-driven animation support -> plain stacked images */
+    @supports not ((animation-timeline: view()) and (timeline-scope: --a)) {
+      #animated {
+        position: static;
+        height: auto;
+        gap: 20px;
+      }
+
+      #animated section {
+        grid-area: auto;
+        aspect-ratio: 4 / 3;
+      }
+    }
+
+    @media (max-width: 700px) {
+      .scrolly {
+        grid-template-columns: 1fr;
+      }
+
+      /* Pin the visual at the top, let the text scroll over the page below */
+      #animated {
+        grid-row: 2;
+        top: 80px;
+        height: 40vh;
+        z-index: 1;
+      }
+
+      #tracked {
+        grid-row: 3;
+      }
+
+      #tracked section {
+        min-height: 70vh;
+      }
+    }
   </style>
 </head>
 
