+    }
+
+    #tracked section {
+      min-height: 80vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      padding: 20px 0;
+    }
+
+    #tracked h3 {
+      color: var(--primary);
+      font-size: 1.75rem;
+      margin-bottom: 10px;
+    }
+
+    #tracked .step {
+      color: var(--accent);
+      font-weight: bold;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+      font-size: 0.8rem;
+    }
+
+    #animated {
+      grid-column: 2;
+      grid-row: 2;
+      display: grid;
+      gap: 20px;
+      align-content: start;
+    }
+
+    #animated section {
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
+    }
+
+    #animated img {
+      display: block;
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      aspect-ratio: 4 / 5;
+    }
+
+    /* Progressive enhancement: only stack + animate where scroll-driven animations are fully supported.
+       Unsupported browsers get a static column of images. */
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      /* Hoist the timeline names so #animated (a different DOM branch) can see them */
+      .story {
+        timeline-scope: --story-1, --story-2, --story-3, --story-4;
+      }
+
+      #tracked section:nth-child(1) { view-timeline: --story-1 block; }
+      #tracked section:nth-child(2) { view-timeline: --story-2 block; }
+      #tracked section:nth-child(3) { view-timeline: --story-3 block; }
+      #tracked section:nth-child(4) { view-timeline: --story-4 block; }
+
+      #animated {
+        position: sticky;
+        top: calc(20vh + 30px); /* 60vh box roughly centered below the sticky nav */
+        height: 60vh;
+        align-self: start;
+      }
+
+      #animated section {
+        grid-area: 1 / 1;
+        opacity: 0;
+        animation: story-fade-in auto linear both, story-fade-out auto linear forwards;
+        /* Declared after the shorthand so it isn't reset */
+        animation-range: cover 15% cover 40%, cover 60% cover 85%;
+
+        @media (prefers-reduced-motion: no-preference) {
+          animation-name: story-reveal-in, story-reveal-out;
+        }
+      }
+
+      #animated img {
+        aspect-ratio: auto;
+      }
+
+      #animated section:nth-child(1) { animation-timeline: --story-1; }
+      #animated section:nth-child(2) { animation-timeline: --story-2; }
+      #animated section:nth-child(3) { animation-timeline: --story-3; }
+      #animated section:nth-child(4) { animation-timeline: --story-4; }
+    }
+
+    /* Reduced motion: opacity-only crossfade */
+    @keyframes story-fade-in {
+      from { opacity: 0; }
+      to { opacity: 1; }
+    }
+
+    @keyframes story-fade-out {
+      from { opacity: 1; }
+      to { opacity: 0; }
+    }
+
+    /* Full motion: compositor-friendly opacity + transforms only */
+    @keyframes story-reveal-in {
+      from { opacity: 0; scale: 0.85; translate: 0 15%; }
+      to { opacity: 1; scale: 1; translate: 0 0; }
+    }
+
+    @keyframes story-reveal-out {
+      from { opacity: 1; scale: 1; translate: 0 0; }
+      to { opacity: 0; scale: 0.95; translate: 0 -10%; }
+    }
+
+    @media (max-width: 768px) {
+      .story {
+        grid-template-columns: 1fr;
+      }
+
+      /* Images sit behind the text in the same grid cell */
+      #tracked,
+      #animated {
+        grid-column: 1;
+        grid-row: 2;
+      }
+
+      #tracked {
+        position: relative;
+        z-index: 1;
+      }
+
+      #tracked section > div {
+        background: rgba(250, 250, 250, 0.92);
+        padding: 20px;
+        border-radius: 8px;
+      }
+
+      #animated img {
+        aspect-ratio: 16 / 9;
+      }
+    }
+
