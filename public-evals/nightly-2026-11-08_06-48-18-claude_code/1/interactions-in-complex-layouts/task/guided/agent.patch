+  <script>
+    (() => {
+      const board = document.getElementById('order-board');
+      const status = document.getElementById('board-status');
+      const columns = [...board.querySelectorAll('.board-column')];
+      const canMoveBefore = 'moveBefore' in Element.prototype;
+      let nextId = 1004;
+
+      // Atomic move keeps focus/state where supported; falls back to insertBefore.
+      const place = (parent, node, ref) =>
+        canMoveBefore ? parent.moveBefore(node, ref) : parent.insertBefore(node, ref);
+
+      const listOf = (col) => col.querySelector('.card-list');
+      const titleOf = (col) => col.querySelector('h3').textContent;
+
+      // Counts are batched into one rAF write per frame, only for dirty columns.
+      const dirty = new Set(columns);
+      let countFrame = 0;
+      const markDirty = (...cols) => {
+        cols.forEach((c) => dirty.add(c));
+        countFrame ||= requestAnimationFrame(() => {
+          countFrame = 0;
+          dirty.forEach((c) => {
+            c.querySelector('.column-count').textContent = listOf(c).childElementCount;
+          });
+          dirty.clear();
+        });
+      };
+      markDirty();
+
+      const announce = (card, col) => {
+        status.textContent = `${card.querySelector('.card-title').textContent} moved to ${titleOf(col)}`;
+      };
+
+      // ---- Drag and drop (delegated: 3 listeners total, regardless of card count) ----
+      let dragged = null;
+      let sourceCol = null;
+      let overCol = null;
+      let pointerY = 0;
+      let dropRef = null; // card to insert before (null = append)
+      let frame = 0;
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest?.('.card');
+        if (!card) return;
+        dragged = card;
+        sourceCol = card.closest('.board-column');
+        e.dataTransfer.effectAllowed = 'move';
+        e.dataTransfer.setData('text/plain', card.querySelector('.card-title').textContent);
+        // Defer so the drag image is captured before the card fades.
+        requestAnimationFrame(() => card.classList.add('is-dragging'));
+      });
+
+      board.addEventListener('dragover', (e) => {
+        if (!dragged) return;
+        const col = e.target.closest?.('.board-column');
+        if (!col) return;
+        e.preventDefault(); // allow drop; cheap, runs every event
+        e.dataTransfer.dropEffect = 'move';
+        pointerY = e.clientY;
+        if (col !== overCol) {
+          overCol?.classList.remove('is-over');
+          overCol?.querySelector('.drop-indicator').classList.remove('is-visible');
+          overCol = col;
+          col.classList.add('is-over');
+        }
+        // dragover fires ~every few ms; coalesce all work into one frame.
+        frame ||= requestAnimationFrame(updateIndicator);
+      });
+
+      // Binary search over cards: O(log n) geometry reads per frame, all reads
+      // happen before the single compositor-only write (translate), so no
+      // layout thrashing even with thousands of orders.
+      function updateIndicator() {
+        frame = 0;
+        if (!overCol || !dragged) return;
+        const scroller = overCol.querySelector('.card-scroll');
+        const cards = listOf(overCol).children;
+        const scrollRect = scroller.getBoundingClientRect();
+        let lo = 0, hi = cards.length;
+        while (lo < hi) {
+          const mid = (lo + hi) >> 1;
+          const r = cards[mid].getBoundingClientRect();
+          if (pointerY < r.top + r.height / 2) hi = mid; else lo = mid + 1;
+        }
+        dropRef = cards[lo] || null;
+        let y;
+        if (dropRef) {
+          y = dropRef.getBoundingClientRect().top - 5;
+        } else if (cards.length) {
+          y = cards[cards.length - 1].getBoundingClientRect().bottom + 3;
+        } else {
+          y = scrollRect.top + 8;
+        }
+        y = y - scrollRect.top + scroller.scrollTop;
+        const indicator = overCol.querySelector('.drop-indicator');
+        indicator.style.translate = `0 ${y}px`;
+        indicator.classList.add('is-visible');
+      }
+
+      board.addEventListener('drop', (e) => {
+        if (!dragged || !overCol) return;
+        e.preventDefault();
+        if (frame) { cancelAnimationFrame(frame); updateIndicator(); }
+        if (dropRef !== dragged) {
+          place(listOf(overCol), dragged, dropRef);
+          markDirty(sourceCol, overCol);
+          if (overCol !== sourceCol) announce(dragged, overCol);
+        }
+        endDrag();
+      });
+
+      board.addEventListener('dragend', endDrag);
+
+      function endDrag() {
+        if (frame) cancelAnimationFrame(frame);
+        frame = 0;
+        dragged?.classList.remove('is-dragging');
+        if (overCol) {
+          overCol.classList.remove('is-over');
+          overCol.querySelector('.drop-indicator').classList.remove('is-visible');
+        }
+        dragged = sourceCol = overCol = dropRef = null;
+      }
+
+      // ---- Keyboard: ← / → moves the focused card to the adjacent column ----
+      board.addEventListener('keydown', (e) => {
+        const card = e.target.closest?.('.card');
+        if (!card || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
+        const from = card.closest('.board-column');
+        const to = columns[columns.indexOf(from) + (e.key === 'ArrowRight' ? 1 : -1)];
+        if (!to) return;
+        e.preventDefault();
+        place(listOf(to), card, listOf(to).firstElementChild);
+        if (!canMoveBefore) card.focus();
+        markDirty(from, to);
+        announce(card, to);
+      });
+
+      // ---- Creating orders ----
+      const tpl = document.createElement('template');
+      tpl.innerHTML = '<li class="card" draggable="true" tabindex="0"><span class="card-title"></span><span class="card-meta"></span></li>';
+      const makeCard = (drink, customer) => {
+        const li = tpl.content.firstElementChild.cloneNode(true);
+        li.firstChild.textContent = drink;
+        li.lastChild.textContent = `#${nextId++}${customer ? ' · ' + customer : ''}`;
+        return li;
+      };
+
+      const queued = columns[0];
+      document.getElementById('new-order-form').addEventListener('submit', (e) => {
+        e.preventDefault();
+        const form = e.currentTarget;
+        const drink = form.drink.value.trim();
+        if (!drink) return;
+        listOf(queued).append(makeCard(drink, form.customer.value.trim()));
+        markDirty(queued);
+        form.reset();
+        form.drink.focus();
+      });
+
+      const drinks = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew', 'Flat White', 'Cortado',
+        'Chai Latte', 'Mocha', 'Americano', 'Cappuccino', 'Matcha Latte', 'Nitro Cold Brew'];
+      const names = ['Priya', 'Marcus', 'Elena', 'Kenji', 'Ava', 'Omar', 'Lucía', 'Noah', 'Zoe', 'Sam'];
+      document.getElementById('bulk-orders').addEventListener('click', () => {
+        // One fragment -> one DOM insertion -> one (column-scoped) layout.
+        const frag = document.createDocumentFragment();
+        for (let i = 0; i < 500; i++) {
+          frag.append(makeCard(drinks[(Math.random() * drinks.length) | 0],
+            names[(Math.random() * names.length) | 0]));
+        }
+        listOf(queued).append(frag);
+        markDirty(queued);
+      });
+    })();
+  </script>
 </body>
 
