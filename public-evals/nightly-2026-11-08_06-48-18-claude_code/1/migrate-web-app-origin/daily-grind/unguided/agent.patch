diff --git a/app-origins.js b/app-origins.js
new file mode 100644
index 0000000..204db77
--- /dev/null
+++ b/app-origins.js
@@ -0,0 +1,21 @@
+// Single source of truth for the origin move. Must stay in sync with
+// manifest.webmanifest (migrate_from), legacy.webmanifest (migrate_to)
+// and .well-known/web-app-origin-association.
+window.DG_ORIGINS = Object.freeze({
+  OLD: 'https://www.dailygrind.example',
+  NEW: 'https://app.dailygrind.example',
+  // Only keys with this prefix are treated as user configuration and migrated.
+  STORAGE_PREFIX: 'dg:',
+  MIGRATED_FLAG: 'dg:__migratedFromOldOrigin'
+});
+
+// Pick the manifest for the origin we're served from. The old origin keeps
+// serving a manifest (with migrate_to) so the browser can verify the move
+// and keep updating not-yet-migrated installs; everything else gets the new one.
+(function () {
+  var isOld = location.origin === window.DG_ORIGINS.OLD;
+  var link = document.createElement('link');
+  link.rel = 'manifest';
+  link.href = isOld ? '/legacy.webmanifest' : '/manifest.webmanifest';
+  document.head.appendChild(link);
+})();
