diff --git a/migrate-bridge.html b/migrate-bridge.html
new file mode 100644
index 0000000..89db6fd
--- /dev/null
+++ b/migrate-bridge.html
@@ -0,0 +1,42 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Daily Grind settings bridge</title>
+  <meta name="robots" content="noindex">
+  <script src="/app-origins.js"></script>
+</head>
+<body>
+<script>
+  // Embedded (hidden) by the NEW origin. Runs on the OLD origin, where the
+  // user's existing configuration lives, and hands it over via postMessage.
+  // Old and new origins are same-site, so this frame gets first-party
+  // (unpartitioned) storage.
+  (function () {
+    var O = window.DG_ORIGINS;
+    if (location.origin !== O.OLD || window.parent === window) return;
+
+    window.addEventListener('message', function (e) {
+      if (e.origin !== O.NEW || !e.data) return;
+      if (e.data.type === 'dg:request-config') {
+        var entries = {};
+        try {
+          for (var i = 0; i < localStorage.length; i++) {
+            var k = localStorage.key(i);
+            if (k && k.indexOf(O.STORAGE_PREFIX) === 0 && k !== O.MIGRATED_FLAG) {
+              entries[k] = localStorage.getItem(k);
+            }
+          }
+        } catch (err) { /* storage blocked: send what we have (nothing) */ }
+        e.source.postMessage({ type: 'dg:config', entries: entries }, O.NEW);
+      } else if (e.data.type === 'dg:config-imported') {
+        // Leave the old data in place (it's harmless and lets an unmigrated
+        // install keep working), just record that it was handed over.
+        try { localStorage.setItem(O.MIGRATED_FLAG, String(Date.now())); } catch (err) {}
+      }
+    });
+    window.parent.postMessage({ type: 'dg:bridge-ready' }, O.NEW);
+  })();
+</script>
+</body>
+</html>
diff --git a/migrate-config.js b/migrate-config.js
new file mode 100644
index 0000000..0ed2364
--- /dev/null
+++ b/migrate-config.js
@@ -0,0 +1,46 @@
+// Runs on the NEW origin: one-time import of user configuration
+// (localStorage "dg:*" keys) from the old origin via migrate-bridge.html.
+(function () {
+  var O = window.DG_ORIGINS;
+  if (!O || location.origin !== O.NEW) return;
+  try { if (localStorage.getItem(O.MIGRATED_FLAG)) return; } catch (e) { return; }
+
+  var frame = document.createElement('iframe');
+  frame.src = O.OLD + '/migrate-bridge.html';
+  frame.hidden = true;
+  frame.setAttribute('aria-hidden', 'true');
+  frame.tabIndex = -1;
+
+  var done = false;
+  function cleanup() {
+    window.removeEventListener('message', onMessage);
+    if (frame.parentNode) frame.parentNode.removeChild(frame);
+  }
+  // Give up quietly if the old origin is unreachable; retry on next load.
+  var timer = setTimeout(cleanup, 10000);
+
+  function onMessage(e) {
+    if (e.origin !== O.OLD || e.source !== frame.contentWindow || !e.data) return;
+    if (e.data.type === 'dg:bridge-ready') {
+      frame.contentWindow.postMessage({ type: 'dg:request-config' }, O.OLD);
+    } else if (e.data.type === 'dg:config' && !done) {
+      done = true;
+      clearTimeout(timer);
+      var entries = e.data.entries || {};
+      var imported = 0;
+      Object.keys(entries).forEach(function (k) {
+        if (k.indexOf(O.STORAGE_PREFIX) !== 0 || typeof entries[k] !== 'string') return;
+        // Never clobber anything the user already set on the new origin.
+        if (localStorage.getItem(k) === null) { localStorage.setItem(k, entries[k]); imported++; }
+      });
+      localStorage.setItem(O.MIGRATED_FLAG, String(Date.now()));
+      frame.contentWindow.postMessage({ type: 'dg:config-imported' }, O.OLD);
+      if (imported) window.dispatchEvent(new CustomEvent('dg:config-migrated', { detail: { count: imported } }));
+      setTimeout(cleanup, 0);
+    }
+  }
+  window.addEventListener('message', onMessage);
+
+  if (document.body) document.body.appendChild(frame);
+  else document.addEventListener('DOMContentLoaded', function () { document.body.appendChild(frame); });
+})();
