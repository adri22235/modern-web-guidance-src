diff --git a/js/import-legacy-settings.js b/js/import-legacy-settings.js
new file mode 100644
index 0000000..2343b35
--- /dev/null
+++ b/js/import-legacy-settings.js
@@ -0,0 +1,46 @@
+// Imports user configuration from the previous origin once, after the installed app
+// has been migrated. Web App Origin Migration only moves the installation
+// (shortcuts, icons); localStorage stays behind on the old origin.
+const OLD_ORIGIN = 'https://dailygrind.example.com';
+const BRIDGE_URL = `${OLD_ORIGIN}/migration-bridge.html`;
+const DONE_KEY = 'dailygrind:legacy-settings-imported';
+const TIMEOUT_MS = 10_000;
+
+if (!localStorage.getItem(DONE_KEY)) {
+  const iframe = document.createElement('iframe');
+  iframe.src = BRIDGE_URL;
+  iframe.hidden = true;
+  iframe.title = 'Settings import';
+
+  const cleanup = () => {
+    window.removeEventListener('message', onMessage);
+    clearTimeout(timer);
+    iframe.remove();
+  };
+
+  function onMessage(event) {
+    if (event.origin !== OLD_ORIGIN || event.source !== iframe.contentWindow) return;
+
+    if (event.data?.type === 'dailygrind:bridge-ready') {
+      iframe.contentWindow.postMessage({ type: 'dailygrind:request-settings' }, OLD_ORIGIN);
+      return;
+    }
+
+    if (event.data?.type === 'dailygrind:settings') {
+      const settings = event.data.settings ?? {};
+      for (const [key, value] of Object.entries(settings)) {
+        // Never overwrite anything the user has already set on the new origin.
+        if (typeof value === 'string' && localStorage.getItem(key) === null) {
+          localStorage.setItem(key, value);
+        }
+      }
+      localStorage.setItem(DONE_KEY, new Date().toISOString());
+      cleanup();
+    }
+  }
+
+  // If the old origin is unreachable, try again on a later visit.
+  const timer = setTimeout(cleanup, TIMEOUT_MS);
+  window.addEventListener('message', onMessage);
+  document.body.append(iframe);
+}
