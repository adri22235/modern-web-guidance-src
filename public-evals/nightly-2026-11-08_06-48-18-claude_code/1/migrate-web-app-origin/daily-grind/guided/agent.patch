diff --git a/legacy-origin/migration-banner.js b/legacy-origin/migration-banner.js
new file mode 100644
index 0000000..f55115d
--- /dev/null
+++ b/legacy-origin/migration-banner.js
@@ -0,0 +1,34 @@
+// Include on every page of the OLD origin:
+//   <script type="module" src="/migration-banner.js"></script>
+// Fallback for browsers without Web App Origin Migration (Firefox, Safari):
+// tell users the app has moved, since their old installation stays put.
+const NEW_URL = 'https://app.dailygrind.example.com/';
+const DISMISS_KEY = 'dailygrind:move-banner-dismissed';
+
+if (!localStorage.getItem(DISMISS_KEY)) {
+  const banner = document.createElement('aside');
+  banner.setAttribute('role', 'status');
+  banner.style.cssText =
+    'position:fixed;inset:auto 0 0 0;z-index:2000;display:flex;gap:1rem;align-items:center;' +
+    'justify-content:center;flex-wrap:wrap;padding:1rem;background:#3e2723;color:#fff;font:inherit;';
+
+  const text = document.createElement('p');
+  text.textContent = 'The Daily Grind has a new home. Open the new app and install it to keep your shortcut up to date.';
+
+  const link = document.createElement('a');
+  link.href = NEW_URL;
+  link.textContent = 'Go to the new app';
+  link.style.cssText = 'color:#3e2723;background:#ffab40;padding:.5rem 1rem;border-radius:4px;text-decoration:none;font-weight:bold;';
+
+  const close = document.createElement('button');
+  close.type = 'button';
+  close.textContent = 'Dismiss';
+  close.style.cssText = 'background:none;color:#fff;border:1px solid #fff;padding:.5rem 1rem;border-radius:4px;cursor:pointer;';
+  close.addEventListener('click', () => {
+    localStorage.setItem(DISMISS_KEY, '1');
+    banner.remove();
+  });
+
+  banner.append(text, link, close);
+  document.body.append(banner);
+}
diff --git a/legacy-origin/migration-bridge.html b/legacy-origin/migration-bridge.html
new file mode 100644
index 0000000..ce27abd
--- /dev/null
+++ b/legacy-origin/migration-bridge.html
@@ -0,0 +1,34 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Daily Grind settings bridge</title>
+  <!-- Served from the OLD origin (https://dailygrind.example.com/migration-bridge.html).
+       Only the new origin may frame this page. -->
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'">
+</head>
+<body>
+<script>
+  // Hands this origin's saved user configuration to the new origin.
+  // Data and permissions are origin-bound and are NOT moved by Web App Origin Migration.
+  (() => {
+    const NEW_ORIGIN = 'https://app.dailygrind.example.com';
+    if (window.parent === window) return;
+
+    window.addEventListener('message', (event) => {
+      if (event.origin !== NEW_ORIGIN || event.source !== window.parent) return;
+      if (event.data?.type !== 'dailygrind:request-settings') return;
+
+      const settings = {};
+      for (let i = 0; i < localStorage.length; i++) {
+        const key = localStorage.key(i);
+        settings[key] = localStorage.getItem(key);
+      }
+      window.parent.postMessage({ type: 'dailygrind:settings', settings }, NEW_ORIGIN);
+    });
+
+    window.parent.postMessage({ type: 'dailygrind:bridge-ready' }, NEW_ORIGIN);
+  })();
+</script>
+</body>
+</html>
