+
+    /* Entry: transition FROM these values when inserted or un-hidden */
+    @starting-style {
+      .promo-card {
+        opacity: 0;
+        scale: 0.85;
+      }
+    }
+
+    /* Exit: transition TO these values ([data-closing] covers browsers
+       that can't transition display, e.g. Firefox) */
+    .promo-card:where([hidden], [data-closing]) {
+      opacity: 0;
+      scale: 0.85;
+    }
+
+    .promo-card[hidden] {
+      display: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .promo-card {
+        scale: none;
+        transition-duration: 0.1s;
+      }
+
+      @starting-style {
+        .promo-card {
+          scale: none;
+        }
+      }
+
+      .promo-card:where([hidden], [data-closing]) {
+        scale: none;
+      }
+    }
