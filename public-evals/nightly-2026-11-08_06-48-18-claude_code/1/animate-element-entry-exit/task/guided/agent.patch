+  <script>
+    (() => {
+      const container = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+
+      const promos = [
+        { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink every Friday.', img: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80', alt: 'Fresh croissants on a tray' },
+        { title: 'Double Reward Points', text: 'Earn 2x points on every cold brew this week.', img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80', alt: 'Iced coffee in a glass' },
+        { title: 'Beans to Go: 20% Off', text: 'Take home a bag of our house roast for less.', img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80', alt: 'Roasted coffee beans' },
+        { title: 'Student Discount', text: 'Show your student ID for 15% off any order.', img: 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80', alt: 'Cozy cafe interior' }
+      ];
+      let promoCount = 0;
+
+      // Firefox parses allow-discrete but can't transition display, so probe for real support.
+      let supportsDisplayTransition;
+      function canTransitionDisplay() {
+        if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+        if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete')) {
+          return (supportsDisplayTransition = false);
+        }
+        const probe = document.createElement('div');
+        probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+        document.body.appendChild(probe);
+        getComputedStyle(probe).display;
+        probe.style.display = 'none';
+        supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+        probe.remove();
+        return supportsDisplayTransition;
+      }
+
+      async function waitForTransitions(el) {
+        const animations = el.getAnimations();
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000))
+          ]);
+        }
+      }
+
+      async function hideElement(el) {
+        if (canTransitionDisplay()) {
+          el.hidden = true;
+        } else {
+          el.setAttribute('data-closing', '');
+        }
+        await waitForTransitions(el);
+        // Skipped if showElement() cancelled the close mid-animation.
+        if (el.hasAttribute('data-closing')) {
+          el.removeAttribute('data-closing');
+          el.hidden = true;
+        }
+      }
+
+      function showElement(el) {
+        el.removeAttribute('data-closing');
+        el.hidden = false;
+      }
+
+      async function removeElement(el) {
+        el.setAttribute('data-removing', '');
+        if (el.hidden) {
+          el.remove();
+          return;
+        }
+        await hideElement(el);
+        el.remove();
+      }
+
+      function createPromoCard() {
+        const promo = promos[promoCount % promos.length];
+        promoCount++;
+        const card = document.createElement('div');
+        card.className = 'card promo-card';
+        const img = document.createElement('img');
+        img.src = promo.img;
+        img.alt = promo.alt;
+        img.width = 600;
+        img.height = 400;
+        img.loading = 'lazy';
+        const h3 = document.createElement('h3');
+        h3.textContent = promo.title;
+        const p = document.createElement('p');
+        p.textContent = promo.text;
+        card.append(img, h3, p);
+        return card;
+      }
+
+      addBtn.addEventListener('click', () => {
+        container.appendChild(createPromoCard());
+      });
+
+      removeBtn.addEventListener('click', () => {
+        // Ignore cards already animating out so rapid clicks remove successive cards.
+        const cards = container.querySelectorAll('.card:not([data-removing])');
+        const last = cards[cards.length - 1];
+        if (last) removeElement(last);
+      });
+
+      toggleBtn.addEventListener('click', () => {
+        const toggleCard = document.getElementById('toggleCard');
+        if (!toggleCard || toggleCard.hasAttribute('data-removing')) return;
+        const isHidden = toggleCard.hidden || toggleCard.hasAttribute('data-closing');
+        if (isHidden) {
+          showElement(toggleCard);
+        } else {
+          hideElement(toggleCard);
+        }
+        toggleBtn.setAttribute('aria-expanded', String(isHidden));
+      });
+    })();
+  </script>
+
