+  <script>
+    (function () {
+      var container = document.getElementById('domContainer');
+      var addBtn = document.getElementById('addBtn');
+      var removeBtn = document.getElementById('removeBtn');
+      var toggleBtn = document.getElementById('toggleBtn');
+      var toggleCard = document.getElementById('toggleCard');
+      var DURATION = 300;
+
+      var promos = [
+        { title: 'Free Pastry Friday', text: 'Get a free croissant with any large drink.', img: 'https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80', alt: 'Fresh croissants' },
+        { title: 'Double Rewards Points', text: 'Earn 2x points on every cold brew this week.', img: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80', alt: 'Iced coffee in a glass' },
+        { title: 'Beans to Go: 20% Off', text: 'Take home a bag of our house roast for less.', img: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80', alt: 'Roasted coffee beans' },
+        { title: 'Student Discount', text: 'Show your student ID for 15% off any order.', img: 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80', alt: 'Cozy cafe interior' }
+      ];
+      var count = 0;
+
+      function createCard() {
+        var promo = promos[count % promos.length];
+        count++;
+        var card = document.createElement('div');
+        card.className = 'card';
+        var img = document.createElement('img');
+        img.className = 'promo-img';
+        img.src = promo.img;
+        img.alt = promo.alt;
+        img.loading = 'lazy';
+        var badge = document.createElement('span');
+        badge.className = 'promo-badge';
+        badge.textContent = 'PROMO #' + count;
+        var h3 = document.createElement('h3');
+        h3.textContent = promo.title;
+        var p = document.createElement('p');
+        p.textContent = promo.text;
+        card.append(img, badge, h3, p);
+        return card;
+      }
+
+      // Run cb once the card's opacity transition ends (with a timeout fallback
+      // for reduced-motion or browsers that never fire transitionend).
+      function afterTransition(el, cb) {
+        var done = false;
+        function finish() {
+          if (done) return;
+          done = true;
+          el.removeEventListener('transitionend', onEnd);
+          cb();
+        }
+        function onEnd(e) {
+          if (e.target === el && e.propertyName === 'opacity') finish();
+        }
+        el.addEventListener('transitionend', onEnd);
+        setTimeout(finish, DURATION + 50);
+      }
+
+      addBtn.addEventListener('click', function () {
+        // @starting-style handles the fade/scale-in on insertion.
+        container.appendChild(createCard());
+      });
+
+      removeBtn.addEventListener('click', function () {
+        var cards = container.querySelectorAll('.card:not(.is-leaving)');
+        var last = cards[cards.length - 1];
+        if (!last) return;
+        last.classList.add('is-leaving');
+        afterTransition(last, function () {
+          last.remove();
+        });
+      });
+
+      toggleBtn.addEventListener('click', function () {
+        if (!toggleCard.isConnected) return;
+        // The hidden attribute flips immediately; CSS transitions with
+        // display: allow-discrete animate the fade/scale in both directions.
+        toggleCard.hidden = !toggleCard.hidden;
+        toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      });
+    })();
+  </script>
