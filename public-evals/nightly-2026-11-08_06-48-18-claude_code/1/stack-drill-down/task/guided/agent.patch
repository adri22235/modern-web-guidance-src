       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* ---------- Drill-down navigation stack ---------- */
+    html,
+    body {
+      height: 100%;
+      overflow: hidden;
+    }
+
+    .Stack {
+      /* dvh tracks the dynamic viewport on mobile as the address bar shows/hides. */
+      height: 100dvh;
+      display: grid;
+      grid-auto-flow: column;
+      grid-auto-columns: 100%;
+      grid-template-rows: 100%;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      overscroll-behavior-x: none;
+      scrollbar-width: none;
+    }
+
+    .Stack::-webkit-scrollbar {
+      display: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .Stack {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .Stack-view {
+      scroll-snap-align: start;
+      scroll-snap-stop: always;
+      min-width: 0;
+    }
+
+    /* Inner wrapper: the parallax transform lives here, never on the snap target. */
+    .Stack-viewContent {
+      width: 100%;
+      height: 100%;
+      background-color: var(--light);
+      color: var(--text);
+      overflow-y: auto;
+      overscroll-behavior-y: contain;
+    }
+
+    .Stack-viewContent:focus {
+      outline: none;
+    }
+
+    @supports (animation-timeline: view()) {
+      .Stack-viewContent {
+        animation: parallax linear both;
+        animation-timeline: view(inline);
+        animation-range: exit 0% exit 100%;
+      }
+
+      .Stack-view:not(:first-child) .Stack-viewContent {
+        animation: parallax linear both, shadow-fade linear both;
+        animation-timeline: view(inline), view(inline);
+        animation-range: exit 0% exit 100%, entry 0% exit 100%;
+      }
+
+      @keyframes parallax {
+        to {
+          transform: translateX(75%);
+          filter: brightness(0.8);
+        }
+      }
+
+      @keyframes shadow-fade {
+        0%, 100% { box-shadow: 0 0 1.5rem #0000; }
+        25%, 75% { box-shadow: 0 0 1.5rem #0006; }
+      }
+    }
+
+    /* ---------- Detail view ---------- */
+    .detail-bar {
+      position: sticky;
+      top: 0;
+      z-index: 10;
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0.75rem 5%;
+      background: var(--primary);
+      color: white;
+    }
+
+    .detail-bar h1 {
+      font-size: 1.15rem;
+      font-weight: 600;
+      white-space: nowrap;
+      overflow: hidden;
+      text-overflow: ellipsis;
+    }
+
+    .back {
+      flex: none;
+      display: inline-flex;
+      align-items: center;
+      gap: 0.35rem;
+      padding: 0.4rem 0.8rem 0.4rem 0.55rem;
+      border: 1px solid var(--accent);
+      border-radius: 999px;
+      background: transparent;
+      color: white;
+      font: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: background 0.2s, color 0.2s;
+    }
+
+    .back::before {
+      content: "";
+      width: 0.55em;
+      height: 0.55em;
+      border-left: 2px solid currentColor;
+      border-bottom: 2px solid currentColor;
+      transform: rotate(45deg);
+    }
+
+    .back:hover {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    .back:focus-visible,
+    .btn:focus-visible,
+    .related a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .detail-hero {
+      aspect-ratio: 16 / 9;
+      max-height: 55vh;
+      width: 100%;
+      object-fit: cover;
+      display: block;
+      background: var(--secondary);
+    }
+
+    .detail-body {
+      max-width: 760px;
+      margin: 0 auto;
+      padding: 32px 20px 56px;
+    }
+
+    .detail-price {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--primary);
+      font-weight: 700;
+      padding: 2px 12px;
+      border-radius: 999px;
+      margin-bottom: 12px;
+    }
+
+    .detail-body h2 {
+      color: var(--primary);
+      font-size: 1.2rem;
+      margin: 28px 0 10px;
+    }
+
+    .detail-lede {
+      font-size: 1.15rem;
+    }
+
+    .detail-facts {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
+      gap: 12px;
+    }
+
+    .detail-facts div {
+      background: white;
+      border-radius: 8px;
+      padding: 12px 16px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
+    }
+
+    .detail-facts dt {
+      font-size: 0.8rem;
+      text-transform: uppercase;
+      letter-spacing: 0.05em;
+      color: #6d4c41;
+    }
+
+    .detail-facts dd {
+      font-weight: 600;
+    }
+
+    .detail-notes {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 8px;
+      list-style: none;
+    }
+
+    .detail-notes li {
+      background: var(--secondary);
+      border-radius: 999px;
+      padding: 2px 12px;
+      font-size: 0.9rem;
+    }
+
+    .related {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+      gap: 12px;
+      list-style: none;
+    }
+
+    .related a {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 8px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
+      color: var(--primary);
+      font-weight: 600;
+      text-decoration: none;
+    }
+
+    .related img {
+      width: 56px;
