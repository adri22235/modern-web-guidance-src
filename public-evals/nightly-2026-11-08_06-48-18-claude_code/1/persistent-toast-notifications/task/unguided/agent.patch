+    /*
+     * Toast notifications
+     * - popover="manual" puts each toast in the browser's top layer (no z-index needed)
+     *   without blocking interaction or light-dismissing.
+     * - Every toast is an anchor named --toast and is also positioned against --toast.
+     *   An element resolves that name to the closest *preceding* toast in the top layer,
+     *   so each new toast sits directly above the previous one. When a toast is removed,
+     *   the next one re-anchors to whatever came before it – pure CSS restacking.
+     * - The first toast has no valid anchor, so the anchor() fallback pins it to the corner.
+     */
+    .toast {
+      position: fixed;
+      inset: auto 1rem auto auto;
+      bottom: anchor(top, 0.25rem);
+      margin: 0 0 0.75rem 0;
+      anchor-name: --toast;
+      position-anchor: --toast;
+      position-visibility: always;
+
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      min-width: 240px;
+      max-width: min(360px, calc(100vw - 2rem));
+      padding: 0.85rem 0.75rem 0.85rem 1rem;
+      border: none;
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      overflow: hidden;
+
+      /* exit (and base) state */
+      opacity: 0;
+      transform: translateX(110%);
+      transition:
+        opacity 0.3s ease,
+        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
+        display 0.35s allow-discrete,
+        overlay 0.35s allow-discrete;
+    }
+
+    .toast:popover-open {
