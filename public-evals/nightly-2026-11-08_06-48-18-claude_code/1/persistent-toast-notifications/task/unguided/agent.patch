+  <template id="toast-template">
+    <div class="toast" popover="manual" role="status" aria-live="polite">
+      <span class="toast-icon" aria-hidden="true">&#10003;</span>
+      <span class="toast-message">Added to cart!</span>
+      <button type="button" class="toast-close" aria-label="Close notification">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    (() => {
+      const TOAST_DURATION = 3000;
+      const EXIT_FALLBACK = 500;
+      const template = document.getElementById('toast-template');
+
+      function dismissToast(toast) {
+        if (toast.dataset.closing) return;
+        toast.dataset.closing = 'true';
+        clearTimeout(toast._timer);
+
+        const remove = () => toast.remove();
+        if (toast.matches(':popover-open')) {
+          toast.addEventListener('transitionend', (e) => {
+            if (e.target === toast && e.propertyName === 'opacity') remove();
+          });
+          // Safety net in case transitions are unsupported or interrupted.
+          setTimeout(remove, EXIT_FALLBACK);
+          toast.hidePopover();
+        } else {
+          remove();
+        }
+      }
+
+      function showToast() {
+        const toast = template.content.firstElementChild.cloneNode(true);
+        toast.querySelector('.toast-close').addEventListener('click', () => dismissToast(toast));
+        document.body.appendChild(toast);
+        toast.showPopover();
+        toast._timer = setTimeout(() => dismissToast(toast), TOAST_DURATION);
+      }
+
+      document.addEventListener('click', (e) => {
+        if (e.target.closest('.toast-trigger')) showToast();
+      });
+    })();
+  </script>
+
