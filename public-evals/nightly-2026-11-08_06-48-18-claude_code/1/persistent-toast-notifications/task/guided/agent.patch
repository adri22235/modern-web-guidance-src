+  <script type="module">
+    // Load the Popover polyfill only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const TOAST_DURATION = 3000;
+    let toastCount = 0;
+
+    function showToast(message) {
+      const toast = document.createElement("div");
+      const id = `toast-${++toastCount}`;
+      toast.id = id;
+      toast.className = "toast";
+      toast.setAttribute("popover", "manual");
+      toast.setAttribute("role", "status");
+      toast.setAttribute("aria-live", "polite");
+
+      const text = document.createElement("span");
+      text.textContent = message;
+
+      const close = document.createElement("button");
+      close.type = "button";
+      close.className = "toast-close";
+      close.setAttribute("popovertarget", id);
+      close.setAttribute("popovertargetaction", "hide");
+      close.setAttribute("aria-label", "Dismiss notification");
+      close.textContent = "×";
+
+      toast.append(text, close);
+      // Appended directly to <body> as the last child: no wrapper container.
+      document.body.append(toast);
+      toast.showPopover();
+
+      const timer = setTimeout(() => toast.hidePopover(), TOAST_DURATION);
+
+      // Once hidden (timer or close button), remove after the exit animation.
+      toast.addEventListener("toggle", (event) => {
+        if (event.newState !== "closed") return;
+        clearTimeout(timer);
+        const remove = () => toast.remove();
+        toast.addEventListener("transitionend", (e) => {
+          if (e.target === toast && e.propertyName === "opacity") remove();
+        });
+        // Fallback in case transitions are unsupported or skipped.
+        setTimeout(remove, 600);
+      });
+    }
+
+    document.addEventListener("click", (event) => {
+      const trigger = event.target.closest(".toast-trigger");
+      if (trigger) showToast(trigger.dataset.toast || "Added to cart!");
+    });
+  </script>
+
