+
+    /* Toast notifications
+       Each toast is an independent popover="manual" element promoted to the
+       top layer (no z-index needed). Toasts are appended as the last children
+       of <body>, so their stacking offset is derived purely in CSS from their
+       position among siblings: the newest toast sits at the bottom and older
+       ones move up. */
+    .toast {
+      --toast-gap: 0.75rem;
+      --toast-height: 3.5rem;
+      --toast-index: 0;
+
+      position: fixed;
+      inset: auto 1.25rem calc(1.25rem + var(--toast-index) * (var(--toast-height) + var(--toast-gap))) auto;
+      margin: 0;
+      block-size: var(--toast-height);
+      inline-size: max-content;
+      max-inline-size: calc(100vw - 2.5rem);
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0 0.5rem 0 1.1rem;
+      border: none;
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      font-weight: 600;
+      white-space: nowrap;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+
+      /* Exit state (also the state transitioned back to on hide) */
+      opacity: 0;
+      translate: 110% 0;
+      transition:
+        opacity 0.3s ease,
+        translate 0.35s cubic-bezier(0.22, 1, 0.36, 1),
+        inset-block-end 0.3s ease,
+        display 0.35s,
+        overlay 0.35s;
+      transition-behavior: allow-discrete;
+    }
+
+    /* Newest toast (last child) gets index 0; each older sibling moves up one slot. */
+    @supports (inset-block-end: calc(sibling-index() * 1px)) {
+      .toast {
+        --toast-index: calc(sibling-count() - sibling-index());
+      }
+    }
+
+    /* Fallback for browsers without sibling-index(): count following toast siblings. */
+    @supports not (inset-block-end: calc(sibling-index() * 1px)) {
+      .toast:has(+ .toast) { --toast-index: 1; }
+      .toast:has(+ .toast + .toast) { --toast-index: 2; }
+      .toast:has(+ .toast + .toast + .toast) { --toast-index: 3; }
+      .toast:has(+ .toast + .toast + .toast + .toast) { --toast-index: 4; }
+      .toast:has(+ .toast + .toast + .toast + .toast + .toast) { --toast-index: 5; }
+      .toast:has(+ .toast + .toast + .toast + .toast + .toast + .toast) { --toast-index: 6; }
+    }
+
+    .toast:is(:popover-open, .\:popover-open) {
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    @starting-style {
+      .toast:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        translate: 110% 0;
+      }
+    }
