+  <script type="module">
+    const panel = document.querySelector('.seasonal-panel');
+    const toc = document.querySelector('.toc-sidebar');
+    const links = [...toc.querySelectorAll('a[href^="#"]')];
+    const sections = [...panel.querySelectorAll('.drink-section')];
+    const headers = sections.map((section) => section.querySelector('header'));
+    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Highlight the TOC link for a section and expose it to assistive tech.
+    function setActive(id) {
+      for (const link of links) {
+        const isActive = link.hash === `#${id}`;
+        link.classList.toggle('is-active', isActive);
+        if (isActive) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      }
+    }
+
+    function sectionIdFor(header) {
+      return header?.closest('.drink-section')?.id;
+    }
+
+    // Preferred: fires once the panel settles on a new snap target (the article header).
+    if ('onscrollsnapchange' in HTMLElement.prototype) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const id = sectionIdFor(event.snapTargetBlock);
+        if (id) setActive(id);
+      });
+    } else {
+      // Fallback: track the top-most header still visible inside the panel.
+      const observer = new IntersectionObserver(() => {
+        const panelTop = panel.getBoundingClientRect().top;
+        let topHeader;
+        for (const header of headers) {
+          const { bottom } = header.getBoundingClientRect();
+          if (bottom < panelTop) continue;
+          if (!topHeader || bottom < topHeader.getBoundingClientRect().bottom) topHeader = header;
+        }
+        const id = sectionIdFor(topHeader);
+        if (id) setActive(id);
+      }, { root: panel, threshold: [0, 0.9] });
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    function scrollToSection(section, { focus = true } = {}) {
+      const header = section.querySelector('header');
+      const top = header.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+      panel.scrollTo({ top, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+      setActive(section.id);
+      // Move focus to the heading so keyboard users continue from the section, without a second jump.
+      if (focus) section.querySelector('h3')?.focus({ preventScroll: true });
+    }
+
+    // Scroll only the panel (not the whole page) when a TOC link is clicked.
+    toc.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link) return;
+      const section = document.getElementById(link.hash.slice(1));
+      if (!section || !panel.contains(section)) return;
+      event.preventDefault();
+      history.replaceState(null, '', link.hash);
+      scrollToSection(section);
+    });
+
+    // Honour a deep link such as #drink-cold-brew on load.
+    const initial = location.hash && document.getElementById(location.hash.slice(1));
+    if (initial && panel.contains(initial)) {
+      scrollToSection(initial, { focus: false });
+    }
+  </script>
+
