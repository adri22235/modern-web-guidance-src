+  <script>
+    (function () {
+      var toc = document.querySelector('.toc-sidebar');
+      var panel = document.querySelector('.seasonal-panel');
+      if (!toc || !panel) return;
+
+      var links = Array.prototype.slice.call(toc.querySelectorAll('a[href^="#"]'));
+      var sections = links.map(function (link) {
+        return document.getElementById(decodeURIComponent(link.hash.slice(1)));
+      });
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var activeIndex = -1;
+      var lockedUntilSettled = false;
+      var settleTimer = null;
+      var ticking = false;
+
+      function setActive(index) {
+        if (index === activeIndex || index < 0) return;
+        activeIndex = index;
+        links.forEach(function (link, i) {
+          var on = i === index;
+          link.classList.toggle('is-active', on);
+          if (on) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+        sections.forEach(function (section, i) {
+          if (section) section.classList.toggle('is-current', i === index);
+        });
+      }
+
+      // Offset of a section's header from the top of the panel's scroll content
+      function headerTop(section) {
+        var target = section.querySelector('header') || section;
+        return target.getBoundingClientRect().top - panel.getBoundingClientRect().top + panel.scrollTop;
+      }
+
+      // The section whose header is closest to (at or above) the snap line
+      function currentIndex() {
+        var line = panel.scrollTop + 32;
+        var best = 0;
+        sections.forEach(function (section, i) {
+          if (section && headerTop(section) - 24 <= line) best = i;
+        });
+        // At the very bottom, the last section may never reach the top
+        if (panel.scrollTop + panel.clientHeight >= panel.scrollHeight - 2) best = sections.length - 1;
+        return best;
+      }
+
+      function settle() {
+        lockedUntilSettled = false;
+        setActive(currentIndex());
+      }
+
+      panel.addEventListener('scroll', function () {
+        // Fallback for browsers without `scrollend`
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(settle, 150);
+        if (lockedUntilSettled || ticking) return;
+        ticking = true;
+        requestAnimationFrame(function () {
+          ticking = false;
+          if (!lockedUntilSettled) setActive(currentIndex());
+        });
+      }, { passive: true });
+
+      if ('onscrollend' in window) {
+        panel.addEventListener('scrollend', function () {
+          clearTimeout(settleTimer);
+          settle();
+        });
+      }
+
+      function scrollToIndex(index, behavior) {
+        var section = sections[index];
+        if (!section) return;
+        var marginTop = parseFloat(getComputedStyle(section.querySelector('header') || section).scrollMarginTop) || 0;
+        var top = Math.max(0, headerTop(section) - marginTop);
+        if (Math.abs(panel.scrollTop - top) < 1) {
+          setActive(index);
+          return;
+        }
+        lockedUntilSettled = true;
+        setActive(index);
+        panel.scrollTo({ top: top, behavior: behavior });
+      }
+
+      links.forEach(function (link, index) {
+        link.addEventListener('click', function (event) {
+          if (!sections[index]) return;
+          event.preventDefault();
+          scrollToIndex(index, reduceMotion.matches ? 'auto' : 'smooth');
+          if (history.replaceState) history.replaceState(null, '', link.hash);
+        });
+      });
+
+      // Honor a deep link like #cold-brew on load
+      var initial = links.findIndex(function (link) { return link.hash === location.hash; });
+      if (initial > -1) scrollToIndex(initial, 'auto');
+      else setActive(currentIndex());
+    })();
+  </script>
