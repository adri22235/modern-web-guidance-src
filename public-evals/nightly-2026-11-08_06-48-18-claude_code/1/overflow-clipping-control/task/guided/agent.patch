     .btn:hover {
       background: #3e2723;
     }
 
+
+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+    }
+
+    .showcase > h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+      align-items: start;
+    }
+
+    /* Card wrapper: children are clipped at the inner content box, so their
+       corners follow a concentric curve (28px outer radius - 16px padding). */
+    .nested-curve-parent {
+      background: var(--primary);
+      padding: 16px;
+      border-radius: 28px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
+      /* Fallback: clips roughly at the padding box */
+      overflow: hidden;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      background: var(--secondary);
+      color: var(--text);
+      padding: 14px 18px;
+    }
+
+    .nested-curve-footer h3 {
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        /* overflow: clip is required for overflow-clip-margin to apply */
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    @supports not (overflow-clip-margin: content-box) {
+      /* Approximate the concentric inner curve where clipping to the content box isn't supported */
+      .nested-curve-parent img {
+        border-radius: 12px 12px 0 0;
+      }
+
+      .nested-curve-footer {
+        border-radius: 0 0 12px 12px;
+      }
+    }
+
+    /* Promos block: clips overflowing text, but lets the button glow bleed
+       15px past the container edge. */
+    .safety-zone-parent {
+      background: #fff8e1;
+      border-radius: 16px;
+      padding: 20px;
+      max-height: 260px;
+      /* Fallback: clips overflowing content but also truncates the button glow */
+      overflow: hidden;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .promo-ticker {
+      white-space: nowrap;
+      font-weight: 600;
+      color: #bf360c;
+      margin-bottom: 12px;
+    }
+
+    .promo-glow-btn {
+      display: block;
+      width: 100%;
+      margin-top: 16px;
+      padding: 12px 20px;
+      border: none;
+      border-radius: 999px;
+      background: var(--accent);
+      color: var(--text);
+      font: inherit;
+      font-weight: 700;
+      cursor: pointer;
+      box-shadow: 0 0 24px 6px rgba(255, 171, 64, 0.75);
+      transition: box-shadow 0.3s;
+    }
+
+    .promo-glow-btn:hover,
+    .promo-glow-btn:focus-visible {
+      box-shadow: 0 0 32px 10px rgba(255, 171, 64, 0.9);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 15px;
+      }
+    }
+
