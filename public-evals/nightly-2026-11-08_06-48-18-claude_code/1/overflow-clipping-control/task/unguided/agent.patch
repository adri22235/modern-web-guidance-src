+    /* Showcase Section */
+    .showcase {
+      max-width: 1100px;
+      margin: 40px auto 0;
+      padding: 0 20px;
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
+      gap: 30px;
+      align-items: start;
+    }
+
+    /* Card wrapper: children are clipped at the content box, and the
+       clip edge automatically follows the concentric inner curve
+       (outer radius minus padding) — no manual radius math needed. */
+    .nested-curve-parent {
+      background: var(--primary);
+      color: white;
+      padding: 14px;
+      border-radius: 28px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
+      overflow: hidden; /* fallback for browsers without overflow: clip */
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      display: block;
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-parent .showcase-body {
+      background: white;
+      color: var(--text);
+      padding: 16px 20px;
+    }
+
+    .nested-curve-parent .showcase-body h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .nested-curve-parent .showcase-footer {
+      background: var(--accent);
+      color: var(--text);
+      padding: 12px 20px;
+      font-weight: 600;
+      display: flex;
+      justify-content: space-between;
+    }
+
+    /* Promos block: normal overflow (text) is clipped, but the clip edge
+       is extended 15px past the padding box so the button glow can bleed. */
+    .safety-zone-parent {
+      background: var(--secondary);
+      padding: 24px;
+      border-radius: 12px;
+      max-height: 260px;
+      overflow: hidden; /* fallback for browsers without overflow: clip */
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      color: var(--primary);
+      margin-bottom: 8px;
+    }
+
+    .safety-zone-parent p {
+      margin-bottom: 8px;
+    }
+
+    .glow-btn {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 700;
+      padding: 12px 26px;
+      border-radius: 999px;
+      text-decoration: none;
+      /* blur 12px + spread 3px = 15px reach, fits the safety zone */
+      box-shadow: 0 0 12px 3px rgba(255, 171, 64, 0.9);
+      transition: box-shadow 0.3s;
+    }
+
+    .glow-btn:hover {
+      box-shadow: 0 0 14px 1px rgba(255, 171, 64, 1);
+    }
+
