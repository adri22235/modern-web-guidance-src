+  <script>
+    (() => {
+      // Shared constructable stylesheet: parsed once, adopted by every instance.
+      const css = `
+        /* Lowest → highest priority. Later layers win regardless of specificity. */
+        @layer reset, tokens, base, layout, variants, states;
+
+        @layer reset {
+          *, *::before, *::after { box-sizing: border-box; margin: 0; }
+          ::slotted(*) { margin: 0; }
+        }
+
+        /* Map inherited site theme (custom properties cross the shadow
+           boundary) onto component-scoped tokens, with fallbacks so the
+           card still works on a page without the theme. --card-* are the
+           public hooks the page may override. */
+        @layer tokens {
+          :host {
+            --_bg: var(--card-bg, white);
+            --_ink: var(--card-ink, var(--text, #3e2723));
+            --_heading: var(--card-heading, var(--primary, #4e342e));
+            --_accent: var(--card-accent, var(--accent, #ffab40));
+            --_muted: var(--card-muted, var(--secondary, #d7ccc8));
+            --_btn-bg: var(--card-button-bg, var(--primary, #4e342e));
+            --_btn-ink: var(--card-button-ink, white);
+            --_radius: var(--card-radius, 8px);
+            --_shadow: var(--card-shadow, 0 2px 5px rgba(0, 0, 0, 0.1));
+            --_pad: var(--card-padding, 20px);
+          }
+        }
+
+        @layer base {
+          /* :host = the card's own outer box (overridable by page CSS). */
+          :host {
+            display: block;
+            container: drink-card / inline-size;
+            color: var(--_ink);
+            background: var(--_bg);
+            border-radius: var(--_radius);
+            box-shadow: var(--_shadow);
+            overflow: hidden;
+            text-align: center;
+            transition: transform 0.25s ease, box-shadow 0.25s ease;
+          }
+          :host([hidden]) { display: none; }
+
+          .card { display: grid; height: 100%; }
+
+          .media {
+            position: relative;
+            aspect-ratio: 4 / 3;
+            background: var(--_muted);
+            overflow: hidden;
+          }
+          ::slotted([slot="media"]) {
+            display: block;
+            width: 100%;
+            height: 100%;
+            object-fit: cover;
+          }
+          .media:not(.has-media) { display: none; }
+
+          .badge {
+            position: absolute;
+            top: 12px;
+            left: 12px;
+            padding: 2px 10px;
+            border-radius: 999px;
+            background: var(--_accent);
+            color: var(--_heading);
+            font-size: 0.75rem;
+            font-weight: 700;
+            text-transform: uppercase;
+            letter-spacing: 0.5px;
+          }
+          .badge:not(.has-badge) { display: none; }
+
+          .body {
+            display: flex;
+            flex-direction: column;
+            gap: 10px;
+            padding: var(--_pad);
+          }
+
+          ::slotted([slot="title"]) {
+            color: var(--_heading);
+            line-height: 1.25;
+          }
+
+          .description { flex: 1; }
+
+          .footer {
+            display: flex;
+            flex-wrap: wrap;
+            align-items: center;
+            justify-content: center;
+            gap: 12px;
+            margin-top: 5px;
+          }
+
+          .price {
+            font-weight: 700;
+            color: var(--_heading);
+          }
+          .price:not(.has-price) { display: none; }
+
+          .action {
+            display: inline-block;
+            background: var(--_btn-bg);
+            color: var(--_btn-ink);
+            padding: 10px 20px;
+            border-radius: 5px;
+            text-decoration: none;
+            transition: background 0.3s;
+          }
+          .action:focus-visible {
+            outline: 3px solid var(--_accent);
+            outline-offset: 2px;
+          }
+        }
+
+        /* Layout reacts to the card's OWN width, not the viewport. */
+        @layer layout {
+          @container drink-card (max-width: 240px) {
+            .body { --_pad: 14px; gap: 6px; }
+            .footer { flex-direction: column; gap: 6px; }
+            .action { width: 100%; text-align: center; }
+          }
+
+          @container drink-card (min-width: 480px) {
+            .card { grid-template-columns: minmax(200px, 45%) 1fr; }
+            .media { aspect-ratio: auto; min-height: 100%; }
+            .body { text-align: left; justify-content: center; padding: calc(var(--_pad) * 1.5); }
+            .footer { justify-content: flex-start; }
+            ::slotted([slot="title"]) { font-size: 1.6rem; }
+          }
+
+          @container drink-card (min-width: 760px) {
+            .card { grid-template-columns: 1fr 1fr; }
+            ::slotted([slot="title"]) { font-size: 2rem; }
+          }
+        }
+
+        /* Variants adjust the host's outer styling via attributes. */
+        @layer variants {
+          :host([variant="featured"]) {
+            --_bg: var(--card-bg, linear-gradient(135deg, #fff 60%, #fff3e0));
+            --_shadow: var(--card-shadow, 0 8px 24px rgba(78, 52, 46, 0.25));
+            outline: 2px solid var(--_accent);
+            outline-offset: -2px;
+          }
+          :host([variant="new"]) {
+            border-top: 4px solid var(--_accent);
+          }
+          :host([variant="compact"]) {
+            --_pad: var(--card-padding, 12px);
+            --_shadow: none;
+            border: 1px solid var(--_muted);
+          }
+          :host([variant="compact"]) .media { aspect-ratio: 16 / 9; }
+        }
+
+        @layer states {
+          :host(:hover), :host(:focus-within) {
+            transform: translateY(-3px);
+            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.15);
+          }
+          @media (prefers-reduced-motion: reduce) {
+            :host { transition: none; }
+            :host(:hover), :host(:focus-within) { transform: none; }
+          }
+        }
+      `;
+
+      let sheet = null;
+      if ('adoptedStyleSheets' in Document.prototype && 'replaceSync' in CSSStyleSheet.prototype) {
+        sheet = new CSSStyleSheet();
+        sheet.replaceSync(css);
+      }
+
+      const template = document.createElement('template');
+      template.innerHTML = `
+        <article class="card" part="card">
+          <div class="media" part="media">
+            <slot name="media"></slot>
+            <span class="badge" part="badge"><slot name="badge"></slot></span>
+          </div>
+          <div class="body" part="body">
+            <slot name="title"></slot>
+            <div class="description" part="description"><slot></slot></div>
+            <div class="footer" part="footer">
+              <span class="price" part="price"><slot name="price"></slot></span>
+              <slot name="action">
+                <a class="action" part="action" href="#"></a>
+              </slot>
+            </div>
+          </div>
+        </article>
+      `;
+
+      class DrinkCard extends HTMLElement {
+        static observedAttributes = ['href', 'action-label'];
+
+        constructor() {
+          super();
+          const root = this.attachShadow({ mode: 'open' });
+          if (sheet) {
+            root.adoptedStyleSheets = [sheet];
+          } else {
+            const style = document.createElement('style');
+            style.textContent = css;
+            root.append(style);
+          }
+          root.append(template.content.cloneNode(true));
+          this._action = root.querySelector('.action');
+
+          // Hide empty optional regions based on what was projected.
+          for (const name of ['media', 'badge', 'price']) {
+            const slot = root.querySelector(`slot[name="${name}"]`);
+            const wrap = root.querySelector(`.${name}`);
+            const sync = () => wrap.classList.toggle('has-' + name, slot.assignedNodes().length > 0);
+            slot.addEventListener('slotchange', sync);
+            sync();
+          }
+        }
+
+        connectedCallback() { this._render(); }
+        attributeChangedCallback() { this._render(); }
+
+        _render() {
+          const title = this.querySelector('[slot="title"]')?.textContent.trim();
+          const label = this.getAttribute('action-label') || 'View Details';
+          this._action.href = this.getAttribute('href') || '#';
+          this._action.textContent = label;
+          if (title) this._action.setAttribute('aria-label', `${label}: ${title}`);
+        }
+      }
+
+      if (!customElements.get('drink-card')) customElements.define('drink-card', DrinkCard);
+    })();
+  </script>
+
