@@ -0,0 +1,225 @@
+/**
+ * <drink-card> — encapsulated card for menu drinks.
+ *
+ * Slots
+ *   media   – optional <img>/<picture> hero (enables the side-by-side layout when wide)
+ *   badge   – optional short label ("New", "Limited")
+ *   title   – the drink name heading
+ *   (default) – description content
+ *   action  – call-to-action link(s)
+ *
+ * Attributes
+ *   variant="classic" | "featured" | "limited"   (default: classic)
+ *
+ * Theming (inherited custom properties; set on any ancestor, e.g. :root)
+ *   Site tokens it reads:  --primary, --secondary, --accent, --text, --light
+ *   Card overrides:        --drink-card-bg, --drink-card-fg, --drink-card-heading,
+ *                          --drink-card-accent, --drink-card-radius, --drink-card-shadow,
+ *                          --drink-card-padding, --drink-card-media-ratio
+ *
+ * Parts (style freely with drink-card::part(name))
+ *   card, media, header, badge, body, footer
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(/* css */ `
+  /* Priority tiers, lowest → highest. Page ::part() rules and inherited
+     custom properties still win over all of these. */
+  @layer reset, tokens, base, layout, variants, states;
+
+  @layer reset {
+    *, *::before, *::after { box-sizing: border-box; }
+    [hidden] { display: none !important; }
+  }
+
+  @layer tokens {
+    :host {
+      /* Private aliases: public overrides first, then the site's coffee theme,
+         then a hard fallback. Public props are never seeded on :host so they
+         stay overridable from anywhere up the tree. */
+      --_bg:       var(--drink-card-bg, white);
+      --_fg:       var(--drink-card-fg, var(--text, #3e2723));
+      --_heading:  var(--drink-card-heading, var(--primary, #4e342e));
+      --_accent:   var(--drink-card-accent, var(--accent, #ffab40));
+      --_muted:    var(--secondary, #d7ccc8);
+      --_radius:   var(--drink-card-radius, 8px);
+      --_shadow:   var(--drink-card-shadow, 0 2px 5px rgb(0 0 0 / 0.1));
+      --_pad:      var(--drink-card-padding, 20px);
+      --_ratio:    var(--drink-card-media-ratio, 16 / 9);
+      --_border:   transparent;
+    }
+  }
+
+  @layer base {
+    /* Outer styling of the host box itself. */
+    :host {
+      display: block;              /* custom elements are inline by default; containment needs a box */
+      container: drink-card / inline-size;
+      background: var(--_bg);
+      color: var(--_fg);
+      border: 2px solid var(--_border);
+      border-radius: var(--_radius);
+      box-shadow: var(--_shadow);
+      overflow: clip;
+      transition: box-shadow 0.25s, translate 0.25s;
+    }
+
+    .card {
+      block-size: 100%;
+      text-align: center;
+    }
+
+    .media { overflow: clip; }
+    .media:not(.has-content) { display: none; }
+
+    ::slotted(img), ::slotted(picture) {
+      display: block;
+      inline-size: 100%;
+      aspect-ratio: var(--_ratio);
+      object-fit: cover;
+    }
+
+    .header { color: var(--_heading); }
+
+    .badge:not(.has-content) { display: none; }
+    .badge {
+      display: inline-block;
+      margin-block-end: 0.4rem;
+      padding: 0.1rem 0.6rem;
+      border-radius: 999px;
+      background: var(--_accent);
+      color: var(--primary, #4e342e);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+    }
+
+    ::slotted([slot="title"]) {
+      margin: 0 0 10px;
+      font-size: clamp(1.1rem, 0.9rem + 3cqi, 1.6rem);
+      line-height: 1.2;
+    }
+
+    ::slotted(p) { margin: 0; }
+
+    .footer { margin-block-start: auto; }
+  }
+
+  @layer layout {
+    /* Narrow (default): stacked regions in source order. */
+    .card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .content {
+      display: flex;
+      flex: 1;
+      flex-direction: column;
+      gap: 0.25rem;
+      padding: var(--_pad);
+    }
+
+    /* Wide card with media: media column beside the text. Cards without
+       media stay single-column and never reserve an empty column. */
+    @container drink-card (min-width: 34rem) {
+      .card.with-media {
+        display: grid;
+        grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
+        text-align: start;
+      }
+      .card.with-media .media { block-size: 100%; }
+      .card.with-media ::slotted(img),
+      .card.with-media ::slotted(picture) {
+        block-size: 100%;
+        aspect-ratio: auto;
+      }
+      .card.with-media .content {
+        justify-content: center;
+        padding: calc(var(--_pad) * 1.6);
+      }
+      .card.with-media .footer { margin-block-start: 0.75rem; }
+    }
+
+    /* Very narrow: tighten spacing and hide the decorative hero. */
+    @container drink-card (max-width: 15rem) {
+      .content { padding: calc(var(--_pad) * 0.6); }
+      .media { display: none; }
+    }
+  }
+
+  @layer variants {
+    :host([variant="featured"]) {
+      --_border: var(--_accent);
+      --_shadow: var(--drink-card-shadow, 0 6px 18px rgb(78 52 46 / 0.25));
+    }
+
+    :host([variant="limited"]) {
+      --_bg:      var(--drink-card-bg, var(--primary, #4e342e));
+      --_fg:      var(--drink-card-fg, var(--light, #fafafa));
+      --_heading: var(--drink-card-heading, var(--_accent));
+      --_border:  var(--_accent);
+      border-style: dashed;
+    }
+  }
+
+  @layer states {
+    :host(:hover), :host(:focus-within) {
+      box-shadow: var(--_shadow), 0 8px 20px rgb(0 0 0 / 0.12);
+    }
+    @media (prefers-reduced-motion: no-preference) {
+      :host(:hover) { translate: 0 -3px; }
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <div class="media" part="media"><slot name="media"></slot></div>
+    <div class="content">
+      <header class="header" part="header">
+        <span class="badge" part="badge"><slot name="badge"></slot></span>
+        <slot name="title"></slot>
+      </header>
+      <div class="body" part="body"><slot></slot></div>
+      <footer class="footer" part="footer"><slot name="action"></slot></footer>
+    </div>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+
+    this.#card = root.querySelector('.card');
+
+    // Track which optional slots are filled so empty regions collapse
+    // and the media column only exists when there is media.
+    for (const slot of root.querySelectorAll('slot[name="media"], slot[name="badge"]')) {
+      slot.addEventListener('slotchange', () => {
+        const filled = slot.assignedElements().length > 0;
+        slot.parentElement.classList.toggle('has-content', filled);
+        if (slot.name === 'media') this.#card.classList.toggle('with-media', filled);
+      });
+    }
+  }
+
+  #card;
+
+  get variant() {
+    return this.getAttribute('variant') ?? 'classic';
+  }
+
+  set variant(value) {
+    this.setAttribute('variant', value);
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
