+  <script>
+    (function () {
+      var scroller = document.getElementById('scroller');
+      var status = document.getElementById('status');
+      var origins = scroller.querySelectorAll('.origin');
+      var isScrolling = false;
+      var endTimer = null;
+
+      // Scroll-active path: runs on every scroll event, so it does no layout
+      // reads and only touches the DOM once per scroll gesture.
+      function onScroll() {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.textContent = 'Scrolling...';
+        }
+        if (!supportsScrollEnd) {
+          clearTimeout(endTimer);
+          endTimer = setTimeout(onScrollEnd, 150);
+        }
+      }
+
+      // Runs once after scrolling stops: measure which origin occupies the
+      // most visible area inside the scroller.
+      function onScrollEnd() {
+        if (!isScrolling) return;
+        isScrolling = false;
+
+        var box = scroller.getBoundingClientRect();
+        var best = null;
+        var bestVisible = 0;
+        for (var i = 0; i < origins.length; i++) {
+          var r = origins[i].getBoundingClientRect();
+          var visible = Math.min(r.bottom, box.bottom) - Math.max(r.top, box.top);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = origins[i];
+          }
+        }
+        status.textContent = 'Scroll ended. Visible: ' +
+          (best ? best.getAttribute('data-origin') : 'None');
+      }
+
+      var supportsScrollEnd = 'onscrollend' in window;
+      scroller.addEventListener('scroll', onScroll, { passive: true });
+      if (supportsScrollEnd) {
+        scroller.addEventListener('scrollend', onScrollEnd);
+      }
+    })();
+  </script>
