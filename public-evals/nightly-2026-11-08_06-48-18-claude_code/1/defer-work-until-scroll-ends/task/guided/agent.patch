+  <script>
+    (() => {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const origins = scroller.querySelectorAll('.origin');
+      let isScrolling = false;
+
+      // Lightweight: touch the DOM only once per scroll gesture, no layout reads.
+      scroller.addEventListener('scroll', () => {
+        if (isScrolling) return;
+        isScrolling = true;
+        status.textContent = 'Scrolling…';
+      }, { passive: true });
+
+      // Heavier work (layout reads) deferred until scrolling has fully settled.
+      const onScrollEnd = () => {
+        isScrolling = false;
+        const box = scroller.getBoundingClientRect();
+        let best = null;
+        let bestVisible = -1;
+        for (const el of origins) {
+          const r = el.getBoundingClientRect();
+          const visible = Math.min(r.bottom, box.bottom) - Math.max(r.top, box.top);
+          if (visible > bestVisible) {
+            bestVisible = visible;
+            best = el;
+          }
+        }
+        if (best) status.textContent = `Scroll ended. Visible: ${best.dataset.origin}`;
+      };
+
+      scroller.addEventListener('scrollend', onScrollEnd);
+
+      // Fallback for browsers without scrollend: debounce scroll and dispatch it ourselves.
+      if (!('onscrollend' in window)) {
+        let timer;
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = setTimeout(() => scroller.dispatchEvent(new Event('scrollend')), 150);
+        }, { passive: true });
+      }
+    })();
+  </script>
+
