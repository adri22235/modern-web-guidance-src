+  <script type="module">
+    const navLinks = [...document.querySelectorAll('nav .nav-section-link')];
+    const sections = navLinks
+      .map(link => document.querySelector(link.getAttribute('href')))
+      .filter(Boolean);
+
+    const setCurrent = (activeLink, useClass) => {
+      for (const link of navLinks) {
+        const isActive = link === activeLink;
+        if (useClass) link.classList.toggle('target-current', isActive);
+        if (isActive) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      }
+    };
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native scrollspy: :target-current handles the visuals; mirror it to aria-current.
+      const syncAriaCurrent = () =>
+        setCurrent(document.querySelector('nav .nav-section-link:target-current'), false);
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback: IntersectionObserver watching a thin band across the middle of the viewport.
+      const visible = new Set();
+      const update = () => {
+        const atBottom =
+          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
+        const active = atBottom && visible.size
+          ? sections.at(-1)
+          : sections.find(section => visible.has(section));
+        setCurrent(navLinks.find(link => link.hash === `#${active?.id}`) ?? null, true);
+      };
+
+      const observer = new IntersectionObserver(entries => {
+        for (const entry of entries) {
+          if (entry.isIntersecting) visible.add(entry.target);
+          else visible.delete(entry.target);
+        }
+        update();
+      }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
+
+      sections.forEach(section => observer.observe(section));
+      // The last section may never reach mid-viewport; activate it at the page bottom.
+      window.addEventListener('scroll', update, { passive: true });
+    }
+  </script>
+
 </body>
 
