diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,61 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Seasonal coffee cards: parent restyles itself from the child "iced" checkbox via :has() */
+    .coffee-card {
+      --card-bg: white;
+      --card-border: transparent;
+      --card-heading: var(--primary);
+      --card-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+
+      position: relative;
+      background-color: var(--card-bg);
+      border: 2px solid var(--card-border);
+      box-shadow: var(--card-shadow);
+      transition: background-color 0.3s, border-color 0.3s, box-shadow 0.3s;
+    }
+
+    .coffee-card h3 {
+      color: var(--card-heading);
+      transition: color 0.3s;
+    }
+
+    .coffee-card:has(.iced-toggle:checked) {
+      --card-bg: #e1f5fe;
+      --card-border: #81d4fa;
+      --card-heading: #01579b;
+      --card-shadow: 0 4px 14px rgba(3, 155, 229, 0.25);
+    }
+
+    .coffee-card:has(.iced-toggle:checked) h3::after {
+      content: " \2744\FE0F" / "";
+    }
+
+    .iced-option {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 8px;
+      margin-top: 12px;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+
+    .iced-toggle {
+      width: 1.1rem;
+      height: 1.1rem;
+      accent-color: #0288d1;
+      cursor: pointer;
+    }
+
+    .iced-option:has(.iced-toggle:focus-visible) {
+      outline: 2px solid #0288d1;
+      outline-offset: 2px;
+      border-radius: 4px;
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
