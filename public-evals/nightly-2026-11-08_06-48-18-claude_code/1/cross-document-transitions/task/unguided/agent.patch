+  <script>
+    // Apply custom view transition types ('next' / 'previous') for cross-document
+    // navigations. Only set up when the user does not prefer reduced motion.
+    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+      const getPage = (url) => {
+        if (!url) return null;
+        try {
+          const u = new URL(url, location.href);
+          if (u.origin !== location.origin || u.pathname !== location.pathname) return null;
+          const n = parseInt(u.searchParams.get('page'), 10);
+          return Number.isFinite(n) && n > 0 ? n : 1;
+        } catch {
+          return null;
+        }
+      };
+
+      const directionFor = (fromUrl, toUrl) => {
+        const from = getPage(fromUrl);
+        const to = getPage(toUrl);
+        if (from === null || to === null || from === to) return null;
+        return to > from ? 'next' : 'previous';
+      };
+
+      // Outgoing page: tag the transition so the old snapshot animates correctly.
+      window.addEventListener('pageswap', (e) => {
+        if (!e.viewTransition || !e.activation) return;
+        const type = directionFor(location.href, e.activation.entry && e.activation.entry.url);
+        if (type) e.viewTransition.types.add(type);
+      });
+
+      // Incoming page: dynamically apply the transition type on page reveal.
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition) return;
+        let type = null;
+        const activation = window.navigation && navigation.activation;
+        if (activation && activation.from) {
+          type = directionFor(activation.from.url, activation.entry.url);
+        }
+        if (!type) type = sessionStorage.getItem('vt-direction');
+        sessionStorage.removeItem('vt-direction');
+        if (type === 'next' || type === 'previous') e.viewTransition.types.add(type);
+      });
+
+      // Fallback hint for browsers without navigation.activation.from.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest && e.target.closest('a#next, a#previous');
+        if (link) sessionStorage.setItem('vt-direction', link.id);
+      });
+    }
+  </script>
