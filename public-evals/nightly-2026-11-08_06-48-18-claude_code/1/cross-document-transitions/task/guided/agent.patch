   </style>
+  <!-- Hold first render until the pagination (and the cards above it) are parsed,
+       so the incoming page snapshot is complete. -->
+  <link rel="expect" href="#pagination" blocking="render">
+  <script>
+    // Apply directional view transition types on page reveal.
+    // Only set up when the user has not asked for reduced motion.
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const pageOf = (url) => {
+        try {
+          const n = parseInt(new URL(url, location.href).searchParams.get('page'), 10);
+          return Number.isInteger(n) && n > 0 ? n : 1;
+        } catch {
+          return null;
+        }
+      };
+
+      const sameDocPath = (url) => {
+        try {
+          return new URL(url, location.href).pathname === location.pathname;
+        } catch {
+          return false;
+        }
+      };
+
+      // Fallback for browsers without the Navigation API: remember which
+      // pagination link was clicked.
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest?.('#next, #previous');
+        if (link) sessionStorage.setItem('vt-direction', link.id);
+      });
+
+      window.addEventListener('pagereveal', (e) => {
+        const stored = sessionStorage.getItem('vt-direction');
+        sessionStorage.removeItem('vt-direction');
+        if (!e.viewTransition) return;
+
+        let type = null;
+        const activation = window.navigation?.activation;
+        const fromUrl = activation?.from?.url;
+        const toUrl = activation?.entry?.url;
+
+        if (fromUrl && toUrl && sameDocPath(fromUrl) && sameDocPath(toUrl)) {
+          const from = pageOf(fromUrl);
+          const to = pageOf(toUrl);
+          if (from !== null && to !== null && from !== to) {
+            type = to > from ? 'next' : 'previous';
+          }
+        } else if (!activation && (stored === 'next' || stored === 'previous')) {
+          type = stored;
+        }
+
+        if (type) e.viewTransition.types.add(type);
+      });
+    }
+  </script>
 </head>
 
