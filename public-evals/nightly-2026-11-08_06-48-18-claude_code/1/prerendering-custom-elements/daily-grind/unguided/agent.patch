diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..f85c0c7
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,121 @@
+// <drink-card> — hydrates server-rendered (Declarative Shadow DOM) drink cards in place.
+//
+// The markup, styles and favorite button are already in the HTML via
+// <template shadowrootmode="open">, so the browser paints a fully styled card
+// before this script runs. This module never re-renders: it only reuses the
+// existing shadow root, wires up the button and syncs persisted state.
+
+const STORAGE_KEY = 'daily-grind:favorites';
+
+function readFavorites() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
+    return new Set(Array.isArray(parsed) ? parsed : []);
+  } catch {
+    return new Set();
+  }
+}
+
+function writeFavorites(set) {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    // Storage unavailable (private mode, quota) — state stays in-memory only.
+  }
+}
+
+// Fallback for browsers without Declarative Shadow DOM support: attach the
+// shadow root from the inline template so the same markup is reused.
+function ensureShadowRoot(host) {
+  if (host.shadowRoot) return host.shadowRoot;
+  const template = host.querySelector(':scope > template[shadowrootmode]');
+  if (!template) return null;
+  const root = host.attachShadow({ mode: template.getAttribute('shadowrootmode') || 'open' });
+  root.appendChild(template.content);
+  template.remove();
+  return root;
+}
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorite'];
+
+  #internals = this.attachInternals?.();
+  #button = null;
+
+  connectedCallback() {
+    // Prefer the declaratively-created shadow root; never rebuild it.
+    const root = this.#internals?.shadowRoot ?? ensureShadowRoot(this);
+    if (!root || this.#button) return;
+
+    this.#button = root.querySelector('.fav');
+    if (!this.#button) return;
+
+    this.#button.addEventListener('click', this.#onToggle);
+
+    if (readFavorites().has(this.drinkId)) this.favorite = true;
+    else this.#sync();
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#onToggle);
+    this.#button = null;
+  }
+
+  attributeChangedCallback() {
+    this.#sync();
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id') || '';
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  #onToggle = () => {
+    this.favorite = !this.favorite;
+
+    const favorites = readFavorites();
+    if (this.favorite) favorites.add(this.drinkId);
+    else favorites.delete(this.drinkId);
+    writeFavorites(favorites);
+
+    this.dispatchEvent(
+      new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { id: this.drinkId, favorite: this.favorite },
+      }),
+    );
+  };
+
+  // Targeted attribute/text updates only — the rendered DOM is otherwise untouched.
+  #sync() {
+    const button = this.#button;
+    if (!button) return;
+    const on = this.favorite;
+    const name = this.querySelector('h3')?.textContent.trim() || 'this drink';
+    button.setAttribute('aria-pressed', String(on));
+    button.setAttribute('aria-label', `${on ? 'Remove' : 'Add'} ${name} ${on ? 'from' : 'to'} favorites`);
+    const label = button.querySelector('.fav-label');
+    if (label) label.textContent = on ? 'Favorited' : 'Favorite';
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
+
+// Keep multiple tabs in sync.
+window.addEventListener('storage', (event) => {
+  if (event.key !== STORAGE_KEY) return;
+  const favorites = readFavorites();
+  document.querySelectorAll('drink-card').forEach((card) => {
+    card.favorite = favorites.has(card.drinkId);
+  });
+});
