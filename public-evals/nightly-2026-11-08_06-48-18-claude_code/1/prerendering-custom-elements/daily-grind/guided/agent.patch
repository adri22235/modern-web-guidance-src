new file mode 100644
index 0000000..d720d81
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,86 @@
+// <drink-card>: hydrates server-rendered (Declarative Shadow DOM) drink cards in place.
+const STORAGE_KEY = 'daily-grind:favorites';
+
+const readFavorites = () => {
+  try {
+    return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) ?? '[]'));
+  } catch {
+    return new Set();
+  }
+};
+
+const writeFavorites = (set) => {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify([...set]));
+  } catch {
+    /* storage unavailable (private mode, quota) — favorite still toggles for this visit */
+  }
+};
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorite'];
+
+  #button;
+
+  constructor() {
+    super();
+
+    // Server markup is authoritative: reuse the declarative shadow root, never re-render.
+    if (!this.shadowRoot) {
+      // Fallback for engines that don't parse shadowrootmode: promote the inert template.
+      const template = this.querySelector(':scope > template[shadowrootmode]');
+      if (!template) return;
+      this.attachShadow({ mode: template.getAttribute('shadowrootmode') || 'open' })
+        .append(template.content);
+      template.remove();
+    }
+
+    this.#button = this.shadowRoot.querySelector('.fav');
+    // Attach listeners once here (not in connectedCallback, which re-runs on DOM moves).
+    this.#button?.addEventListener('click', () => this.toggleFavorite());
+  }
+
+  connectedCallback() {
+    // Restore persisted state by updating the existing button's state only.
+    if (this.drinkId && readFavorites().has(this.drinkId)) this.favorite = true;
+    this.#sync();
+  }
+
+  attributeChangedCallback() {
+    this.#sync();
+  }
+
+  get drinkId() {
+    return this.getAttribute('drink-id');
+  }
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  toggleFavorite() {
+    this.favorite = !this.favorite;
+
+    if (this.drinkId) {
+      const favorites = readFavorites();
+      this.favorite ? favorites.add(this.drinkId) : favorites.delete(this.drinkId);
+      writeFavorites(favorites);
+    }
+
+    this.dispatchEvent(new CustomEvent('favorite-change', {
+      bubbles: true,
+      composed: true,
+      detail: { id: this.drinkId, favorite: this.favorite },
+    }));
+  }
+
+  #sync() {
+    this.#button?.setAttribute('aria-pressed', String(this.favorite));
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
