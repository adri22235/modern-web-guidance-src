+            <h2 id="journal-title">Roaster's Journal</h2>
+            <p class="journal-byline">From the Roastery: How a bean finds its way to your cup</p>
+          </div>
+          <button type="button" class="btn summarize-btn" id="summarize-btn">&#10024; Summarize</button>
