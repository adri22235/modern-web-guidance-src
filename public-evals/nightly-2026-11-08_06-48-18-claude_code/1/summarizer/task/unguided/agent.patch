+  <script>
+    (() => {
+      const button = document.getElementById('summarize-btn');
+      const panel = document.getElementById('summary-panel');
+      const status = document.getElementById('summary-status');
+      const list = document.getElementById('summary-list');
+      const source = document.getElementById('journal-text');
+
+      // Chrome's built-in Summarizer API (Gemini Nano, on-device).
+      const hasSummarizer = 'Summarizer' in self;
+      let summarizer = null;
+      let cached = null;
+
+      const showStatus = (message) => {
+        panel.hidden = false;
+        status.textContent = message;
+        status.hidden = !message;
+      };
+
+      const unsupported = () => {
+        button.disabled = true;
+        button.title = "Your browser doesn't support on-device AI summaries yet.";
+        showStatus("Summaries use your browser's built-in AI, which isn't available here. " +
+          'Try a recent version of Chrome on desktop.');
+      };
+
+      const renderBullets = (markdown) => {
+        list.replaceChildren();
+        const lines = markdown
+          .split('\n')
+          .map((line) => line.trim())
+          .filter(Boolean)
+          .map((line) => line.replace(/^([-*•]|\d+\.)\s+/, '').replace(/\*\*(.+?)\*\*/g, '$1').replace(/\*(.+?)\*/g, '$1'));
+        for (const text of lines) {
+          const li = document.createElement('li');
+          li.textContent = text; // textContent: never inject model output as HTML
+          list.appendChild(li);
+        }
+      };
+
+      const getSummarizer = async () => {
+        if (summarizer) return summarizer;
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: "A coffee roaster's blog post explaining how they source their beans.",
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+        };
+        const availability = await Summarizer.availability(options);
+        if (availability === 'unavailable') return null;
+        if (availability !== 'available') showStatus('Downloading the on-device AI model…');
+        summarizer = await Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              showStatus(`Downloading the on-device AI model… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        return summarizer;
+      };
+
+      const summarize = async () => {
+        if (cached) {
+          panel.hidden = !panel.hidden;
+          button.textContent = panel.hidden ? '\u2728 Summarize' : 'Hide summary';
+          return;
+        }
+        button.disabled = true;
+        list.replaceChildren();
+        showStatus('Brewing your summary…');
+        try {
+          const s = await getSummarizer();
+          if (!s) return unsupported();
+          showStatus('Brewing your summary…');
+          const text = source.innerText.trim();
+          cached = await s.summarize(text, {
+            context: 'Summarize for a coffee customer skimming the page.',
+          });
+          renderBullets(cached);
+          showStatus('');
+          button.textContent = 'Hide summary';
+        } catch (err) {
+          console.error('Summarization failed:', err);
+          showStatus("Sorry, we couldn't generate a summary right now. Please try again.");
+        } finally {
+          if (!button.title) button.disabled = false;
+        }
+      };
+
+      if (!hasSummarizer) {
+        // Keep the page tidy: just disable the button and explain via tooltip.
+        button.disabled = true;
+        button.title = "Your browser doesn't support on-device AI summaries yet.";
+      } else {
+        button.addEventListener('click', summarize);
+      }
+    })();
+  </script>
+
