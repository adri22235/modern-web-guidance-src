+  <script type="module">
+    const button = document.getElementById('summarize-btn');
+    const statusEl = document.getElementById('summary-status');
+    const progressEl = document.getElementById('summary-progress');
+    const outputEl = document.getElementById('summary-output');
+    const listEl = document.getElementById('summary-list');
+    const sourceEl = document.getElementById('journal-text');
+
+    // Identical options must be passed to availability() and create().
+    const options = {
+      sharedContext: "A coffee shop's blog post about how it sources and roasts its coffee beans.",
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      expectedInputLanguages: ['en'],
+      outputLanguage: 'en',
+    };
+
+    const unsupported = (message) => {
+      button.disabled = true;
+      statusEl.textContent = message;
+    };
+
+    let summarizerPromise = null;
+
+    // Render plain-text key points as list items (textContent only – never innerHTML).
+    const renderPoints = (text) => {
+      const points = text
+        .split('\n')
+        .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+        .filter(Boolean);
+      listEl.replaceChildren(
+        ...points.map((point) => {
+          const li = document.createElement('li');
+          li.textContent = point;
+          return li;
+        })
+      );
+    };
+
+    const getSummarizer = () => {
+      summarizerPromise ??= Summarizer.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            progressEl.hidden = false;
+            progressEl.value = e.loaded;
+            statusEl.textContent = `Downloading on-device AI model… ${Math.round(e.loaded * 100)}%`;
+          });
+        },
+      }).catch((err) => {
+        summarizerPromise = null; // allow retry
+        throw err;
+      });
+      return summarizerPromise;
+    };
+
+    async function init() {
+      if (!('Summarizer' in self)) {
+        unsupported('Local AI summarization isn\u2019t supported in this browser.');
+        return;
+      }
+      try {
+        const availability = await Summarizer.availability(options);
+        if (availability === 'unavailable') {
+          unsupported('Local AI summarization isn\u2019t available on this device.');
+        } else if (availability !== 'available') {
+          statusEl.textContent = 'The first summary will download a small on-device AI model.';
+        }
+      } catch {
+        unsupported('Local AI summarization isn\u2019t available right now.');
+      }
+    }
+
+    // Summarizer.create() runs inside the click handler so model downloads have a user gesture.
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      button.setAttribute('aria-busy', 'true');
+      statusEl.textContent = 'Preparing summarizer…';
+      try {
+        const summarizer = await getSummarizer();
+        progressEl.hidden = true;
+        statusEl.textContent = 'Summarizing…';
+        listEl.replaceChildren();
+        outputEl.hidden = false;
+
+        let text = '';
+        const stream = summarizer.summarizeStreaming(sourceEl.innerText, {
+          context: 'Summarize for coffee drinkers curious about where their beans come from.',
+        });
+        for await (const chunk of stream) {
+          text += chunk;
+          renderPoints(text);
+        }
+        statusEl.textContent = 'Summary generated on your device.';
+        button.textContent = '✨ Summarize again';
+      } catch (err) {
+        console.error(err);
+        progressEl.hidden = true;
+        statusEl.textContent = 'Sorry, we couldn\u2019t generate a summary. Please try again.';
+      } finally {
+        button.disabled = false;
+        button.removeAttribute('aria-busy');
+      }
+    });
+
+    init();
+  </script>
+
 </body>
 
