+/**
+ * Server-only helpers for SMS one-time-passcode (OTP) phone verification.
+ *
+ * Verification state is kept in the visitor's Astro session so a code can only
+ * be redeemed by the browser that requested it. Codes are stored hashed, expire
+ * after a few minutes, and are protected by attempt and resend limits.
+ */
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export const CODE_LENGTH = 6;
+export const CODE_TTL_MS = 5 * 60 * 1000;
+export const RESEND_COOLDOWN_MS = 30 * 1000;
+export const MAX_VERIFY_ATTEMPTS = 5;
+export const MAX_SENDS_PER_WINDOW = 5;
+export const SEND_WINDOW_MS = 60 * 60 * 1000;
+
+export const SESSION_KEY = 'phoneVerification';
+
+export interface PhoneVerificationState {
+  phone: string;
+  codeHash: string;
+  expiresAt: number;
+  attempts: number;
+  lastSentAt: number;
+  sendTimestamps: number[];
+  verified: boolean;
+  verifiedAt?: number;
+}
+
+/** E.164: "+" followed by 8–15 digits, first digit non-zero. */
+const E164 = /^\+[1-9]\d{7,14}$/;
+
+/**
+ * Normalises user input into E.164. Accepts either a full international
+ * number ("+44 20 7946 0958") or a country calling code plus national number.
+ */
+export function normalizePhone(raw: unknown, countryCode?: unknown): string | null {
+  if (typeof raw !== 'string') return null;
+  const trimmed = raw.trim();
+  let digits = trimmed.replace(/[^\d]/g, '');
+  if (!digits) return null;
+
+  let candidate: string;
+  if (trimmed.startsWith('+')) {
+    candidate = `+${digits}`;
+  } else if (trimmed.startsWith('00')) {
+    candidate = `+${digits.slice(2)}`;
+  } else {
+    const cc = typeof countryCode === 'string' ? countryCode.replace(/[^\d]/g, '') : '';
+    if (!cc) return null;
+    // Drop a national trunk prefix ("0") when a country code is supplied.
+    digits = digits.replace(/^0+/, '');
+    candidate = `+${cc}${digits}`;
+  }
+  return E164.test(candidate) ? candidate : null;
+}
+
+/** Masks all but the last few digits, e.g. "+1 ••• ••• 4567". */
+export function maskPhone(phone: string): string {
+  const visible = phone.slice(-4);
+  return `${phone.slice(0, 2)}${'•'.repeat(Math.max(phone.length - 6, 0))}${visible}`;
+}
+
+export function generateCode(): string {
+  return randomInt(0, 10 ** CODE_LENGTH).toString().padStart(CODE_LENGTH, '0');
+}
+
+export function hashCode(code: string, phone: string): string {
+  const secret = import.meta.env.OTP_SECRET ?? process.env.OTP_SECRET ?? 'devtools-times-otp';
+  return createHash('sha256').update(`${secret}:${phone}:${code}`).digest('hex');
+}
+
+export function codesMatch(code: string, state: PhoneVerificationState): boolean {
+  const a = Buffer.from(hashCode(code, state.phone), 'hex');
+  const b = Buffer.from(state.codeHash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Builds the SMS body. The final line follows the WebOTP origin-bound format
+ * ("@host #code") so supporting browsers can read the code automatically.
+ */
+export function buildSmsBody(code: string, host: string): string {
+  return `${code} is your DevTools Times verification code. It expires in ${
+    CODE_TTL_MS / 60000
+  } minutes.\n\n@${host} #${code}`;
+}
+
+/**
+ * Sends the SMS. Uses Twilio when credentials are configured; otherwise logs
+ * the message to the server console (useful for local development).
+ */
+export async function sendSms(to: string, body: string): Promise<void> {
+  const env = { ...process.env, ...import.meta.env } as Record<string, string | undefined>;
+  const sid = env.TWILIO_ACCOUNT_SID;
+  const token = env.TWILIO_AUTH_TOKEN;
+  const from = env.TWILIO_FROM_NUMBER;
+
+  if (sid && token && from) {
+    const res = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams({ To: to, From: from, Body: body }),
+    });
+    if (!res.ok) {
+      throw new Error(`SMS provider responded with ${res.status}`);
+    }
+    return;
+  }
+
+  console.info(`[sms] To ${maskPhone(to)}:\n${body}`);
+}
+
+export function json(data: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers },
+  });
+}
diff --git a/src/pages/api/phone/send-code.ts b/src/pages/api/phone/send-code.ts
new file mode 100644
index 0000000..1d505f8
--- /dev/null
+++ b/src/pages/api/phone/send-code.ts
@@ -0,0 +1,89 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_TTL_MS,
+  MAX_SENDS_PER_WINDOW,
+  RESEND_COOLDOWN_MS,
+  SEND_WINDOW_MS,
+  SESSION_KEY,
+  buildSmsBody,
+  generateCode,
+  hashCode,
+  json,
+  maskPhone,
+  normalizePhone,
+  sendSms,
+  type PhoneVerificationState,
+} from '../../../lib/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (!session) {
+    return json({ error: 'SESSION_UNAVAILABLE', message: 'Verification is temporarily unavailable.' }, 503);
+  }
+
+  let body: { phone?: unknown; countryCode?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'INVALID_REQUEST', message: 'Invalid request body.' }, 400);
+  }
+
+  const phone = normalizePhone(body.phone, body.countryCode);
+  if (!phone) {
+    return json(
+      { error: 'INVALID_PHONE', message: 'Enter a valid mobile number, including the country code.' },
+      422,
+    );
+  }
+
+  const now = Date.now();
+  const previous = (await session.get(SESSION_KEY)) as PhoneVerificationState | undefined;
+  const sendTimestamps = (previous?.sendTimestamps ?? []).filter((t) => now - t < SEND_WINDOW_MS);
+
+  if (previous && previous.phone === phone && now - previous.lastSentAt < RESEND_COOLDOWN_MS) {
+    const retryAfter = Math.ceil((RESEND_COOLDOWN_MS - (now - previous.lastSentAt)) / 1000);
+    return json(
+      { error: 'RESEND_TOO_SOON', message: `Please wait ${retryAfter} seconds before requesting a new code.`, retryAfter },
+      429,
+      { 'Retry-After': String(retryAfter) },
+    );
+  }
+
+  if (sendTimestamps.length >= MAX_SENDS_PER_WINDOW) {
+    const retryAfter = Math.ceil((SEND_WINDOW_MS - (now - sendTimestamps[0])) / 1000);
+    return json(
+      { error: 'TOO_MANY_REQUESTS', message: 'Too many codes requested. Please try again later.', retryAfter },
+      429,
+      { 'Retry-After': String(retryAfter) },
+    );
+  }
+
+  const code = generateCode();
+  const host = import.meta.env.SMS_ORIGIN_HOST ?? process.env.SMS_ORIGIN_HOST ?? url.hostname;
+
+  try {
+    await sendSms(phone, buildSmsBody(code, host));
+  } catch (err) {
+    console.error('[sms] Failed to send verification code', err);
+    return json({ error: 'SMS_FAILED', message: 'We could not send a text message. Please try again.' }, 502);
+  }
+
+  const state: PhoneVerificationState = {
+    phone,
+    codeHash: hashCode(code, phone),
+    expiresAt: now + CODE_TTL_MS,
+    attempts: 0,
+    lastSentAt: now,
+    sendTimestamps: [...sendTimestamps, now],
+    verified: false,
+  };
+  await session.set(SESSION_KEY, state);
+
+  return json({
+    sent: true,
+    maskedPhone: maskPhone(phone),
+    expiresIn: CODE_TTL_MS / 1000,
+    resendAfter: RESEND_COOLDOWN_MS / 1000,
+    // Exposed only in development so the flow can be exercised without an SMS provider.
+    ...(import.meta.env.DEV ? { devCode: code } : {}),
+  });
+};
diff --git a/src/pages/api/phone/verify-code.ts b/src/pages/api/phone/verify-code.ts
new file mode 100644
index 0000000..71fb903
--- /dev/null
+++ b/src/pages/api/phone/verify-code.ts
@@ -0,0 +1,61 @@
+import type { APIRoute } from 'astro';
+import {
+  CODE_LENGTH,
+  MAX_VERIFY_ATTEMPTS,
+  SESSION_KEY,
+  codesMatch,
+  json,
+  type PhoneVerificationState,
+} from '../../../lib/phoneVerification';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) {
+    return json({ error: 'SESSION_UNAVAILABLE', message: 'Verification is temporarily unavailable.' }, 503);
+  }
+
+  let body: { code?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'INVALID_REQUEST', message: 'Invalid request body.' }, 400);
+  }
+
+  const code = typeof body.code === 'string' ? body.code.replace(/\D/g, '') : '';
+  if (code.length !== CODE_LENGTH) {
+    return json({ error: 'INVALID_CODE_FORMAT', message: `Enter the ${CODE_LENGTH}-digit code.` }, 422);
+  }
+
+  const state = (await session.get(SESSION_KEY)) as PhoneVerificationState | undefined;
+  if (!state) {
+    return json({ error: 'NO_PENDING_VERIFICATION', message: 'Request a new code to continue.' }, 400);
+  }
+  if (state.verified) {
+    return json({ verified: true, phone: state.phone });
+  }
+  if (Date.now() > state.expiresAt) {
+    return json({ error: 'CODE_EXPIRED', message: 'This code has expired. Request a new one.' }, 410);
+  }
+  if (state.attempts >= MAX_VERIFY_ATTEMPTS) {
+    return json({ error: 'TOO_MANY_ATTEMPTS', message: 'Too many incorrect attempts. Request a new code.' }, 429);
+  }
+
+  if (!codesMatch(code, state)) {
+    const attempts = state.attempts + 1;
+    await session.set(SESSION_KEY, { ...state, attempts });
+    const remaining = MAX_VERIFY_ATTEMPTS - attempts;
+    return json(
+      {
+        error: remaining > 0 ? 'INCORRECT_CODE' : 'TOO_MANY_ATTEMPTS',
+        message:
+          remaining > 0
+            ? `That code is incorrect. ${remaining} ${remaining === 1 ? 'attempt' : 'attempts'} left.`
+            : 'Too many incorrect attempts. Request a new code.',
+        attemptsRemaining: remaining,
+      },
+      remaining > 0 ? 400 : 429,
+    );
+  }
+
+  await session.set(SESSION_KEY, { ...state, verified: true, verifiedAt: Date.now(), codeHash: '' });
+  return json({ verified: true, phone: state.phone });
+};
