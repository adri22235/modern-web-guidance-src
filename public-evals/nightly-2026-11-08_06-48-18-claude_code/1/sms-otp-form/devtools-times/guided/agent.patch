+import type { APIRoute } from 'astro';
+import { issueCode, normalizePhone } from '../../../lib/phoneVerification';
+
+export const prerender = false;
+
+const json = (body: unknown, status = 200, headers: Record<string, string> = {}) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', ...headers } });
+
+export const POST: APIRoute = async ({ request, url }) => {
+  let payload: { phone?: unknown };
+  try {
+    payload = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body.' }, 400);
+  }
+  const phone = normalizePhone(payload.phone);
+  if (!phone) {
+    return json({ error: 'Enter a valid phone number including the country code, e.g. +1 555 010 1234.' }, 400);
+  }
+  // Host only (no scheme/port/path) for the origin-bound "@host #code" line.
+  const result = await issueCode(phone, url.hostname);
+  if (!result.ok) {
+    return json(
+      { error: result.error, retryAfterSeconds: result.retryAfterSeconds },
+      result.status,
+      result.retryAfterSeconds ? { 'Retry-After': String(result.retryAfterSeconds) } : {},
+    );
+  }
+  return json({ phone, expiresInSeconds: result.expiresInSeconds, resendInSeconds: result.resendInSeconds });
+};
