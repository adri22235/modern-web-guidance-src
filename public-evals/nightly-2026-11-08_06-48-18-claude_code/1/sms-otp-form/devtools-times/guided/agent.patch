+++ b/src/lib/phoneVerification.ts
@@ -0,0 +1,108 @@
+import { createHash, randomInt, randomBytes, timingSafeEqual } from 'node:crypto';
+
+/**
+ * In-memory SMS one-time passcode store.
+ *
+ * NOTE: This is process-local. In a multi-instance deployment, replace with a
+ * shared store (e.g. Redis/Firestore) and wire `sendSms` to a real SMS provider.
+ */
+
+export const OTP_LENGTH = 6;
+const OTP_TTL_MS = 5 * 60 * 1000;
+const RESEND_COOLDOWN_MS = 30 * 1000;
+const MAX_ATTEMPTS = 5;
+const TOKEN_TTL_MS = 15 * 60 * 1000;
+
+interface PendingCode {
+  hash: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+const pending = new Map<string, PendingCode>();
+const verifiedTokens = new Map<string, { phone: string; expiresAt: number }>();
+
+const E164 = /^\+[1-9]\d{7,14}$/;
+
+/** Normalise user input ("+1 (555) 010-1234") to E.164 ("+15550101234"). */
+export function normalizePhone(input: unknown): string | null {
+  if (typeof input !== 'string') return null;
+  const trimmed = input.trim();
+  const digits = trimmed.replace(/[^\d]/g, '');
+  const candidate = trimmed.startsWith('+') ? `+${digits}` : trimmed.startsWith('00') ? `+${digits.slice(2)}` : null;
+  return candidate && E164.test(candidate) ? candidate : null;
+}
+
+const hashCode = (phone: string, code: string) =>
+  createHash('sha256').update(`${phone}:${code}`).digest('hex');
+
+function sweep(now = Date.now()) {
+  for (const [k, v] of pending) if (v.expiresAt < now) pending.delete(k);
+  for (const [k, v] of verifiedTokens) if (v.expiresAt < now) verifiedTokens.delete(k);
+}
+
+/**
+ * Builds the origin-bound SMS body. The last line MUST be `@<host> #<code>`
+ * so WebOTP and `autocomplete="one-time-code"` can verify the domain.
+ */
+export function buildSmsMessage(code: string, host: string) {
+  return `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+}
+
+async function sendSms(to: string, body: string) {
+  // TODO: integrate SMS provider. For now, log so the flow can be exercised locally.
+  console.info(`[sms] to=${to}\n${body}`);
+}
+
+export type SendResult =
+  | { ok: true; expiresInSeconds: number; resendInSeconds: number }
+  | { ok: false; status: number; error: string; retryAfterSeconds?: number };
+
+export async function issueCode(phone: string, host: string): Promise<SendResult> {
+  const now = Date.now();
+  sweep(now);
+  const existing = pending.get(phone);
+  if (existing && now - existing.sentAt < RESEND_COOLDOWN_MS) {
+    const retryAfterSeconds = Math.ceil((RESEND_COOLDOWN_MS - (now - existing.sentAt)) / 1000);
+    return { ok: false, status: 429, error: `Please wait ${retryAfterSeconds}s before requesting another code.`, retryAfterSeconds };
+  }
+  const code = randomInt(0, 10 ** OTP_LENGTH).toString().padStart(OTP_LENGTH, '0');
+  pending.set(phone, { hash: hashCode(phone, code), expiresAt: now + OTP_TTL_MS, sentAt: now, attempts: 0 });
+  await sendSms(phone, buildSmsMessage(code, host));
+  return { ok: true, expiresInSeconds: OTP_TTL_MS / 1000, resendInSeconds: RESEND_COOLDOWN_MS / 1000 };
+}
+
+export type VerifyResult =
+  | { ok: true; token: string }
+  | { ok: false; status: number; error: string };
+
+export function verifyCode(phone: string, code: unknown): VerifyResult {
+  sweep();
+  if (typeof code !== 'string' || !new RegExp(`^\\d{${OTP_LENGTH}}$`).test(code)) {
+    return { ok: false, status: 400, error: `Enter the ${OTP_LENGTH}-digit code.` };
+  }
+  const entry = pending.get(phone);
+  if (!entry) return { ok: false, status: 400, error: 'This code has expired. Request a new one.' };
+  if (entry.attempts >= MAX_ATTEMPTS) {
+    pending.delete(phone);
+    return { ok: false, status: 429, error: 'Too many attempts. Request a new code.' };
+  }
+  entry.attempts++;
+  const a = Buffer.from(entry.hash, 'hex');
+  const b = Buffer.from(hashCode(phone, code), 'hex');
+  if (!timingSafeEqual(a, b)) {
+    const left = MAX_ATTEMPTS - entry.attempts;
+    return { ok: false, status: 400, error: left > 0 ? `That code is incorrect. ${left} attempt${left === 1 ? '' : 's'} left.` : 'Too many attempts. Request a new code.' };
+  }
+  pending.delete(phone);
+  const token = randomBytes(24).toString('base64url');
+  verifiedTokens.set(token, { phone, expiresAt: Date.now() + TOKEN_TTL_MS });
+  return { ok: true, token };
+}
+
+/** Returns the verified phone number for a token, if still valid. */
+export function phoneForToken(token: string): string | null {
+  sweep();
+  return verifiedTokens.get(token)?.phone ?? null;
+}
