+  <script>
+    (function () {
+      'use strict';
+
+      // Backend endpoints. The server must send the SMS ending with a WebOTP origin-bound line, e.g.:
+      //   Your Daily Grind code is 123456
+      //
+      //   @dailygrind.com #123456
+      var SEND_URL = '/api/otp/send';
+      var VERIFY_URL = '/api/otp/verify';
+      var CODE_LENGTH = 6;
+      var RESEND_COOLDOWN = 30; // seconds
+
+      var phoneForm = document.getElementById('phone-form');
+      var otpForm = document.getElementById('otp-form');
+      var phoneInput = document.getElementById('phone');
+      var phoneError = document.getElementById('phone-error');
+      var otpInput = document.getElementById('otp-code');
+      var otpError = document.getElementById('otp-error');
+      var sentTo = document.getElementById('otp-sent-to');
+      var sendBtn = document.getElementById('send-btn');
+      var verifyBtn = document.getElementById('verify-btn');
+      var resendBtn = document.getElementById('resend-btn');
+      var changeBtn = document.getElementById('change-phone-btn');
+      var status = document.getElementById('verify-status');
+
+      var state = { phone: null, purpose: 'rewards', busy: false };
+      var webOtpController = null;
+      var cooldownTimer = null;
+
+      function setStatus(msg, kind) {
+        status.className = 'status' + (kind ? ' ' + kind : '');
+        status.textContent = msg || '';
+      }
+
+      function setFieldError(input, el, msg) {
+        el.textContent = msg || '';
+        if (msg) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      }
+
+      // Normalize US numbers to E.164 (+1XXXXXXXXXX); returns null if invalid.
+      function normalizePhone(raw) {
+        var digits = String(raw).replace(/\D/g, '');
+        if (digits.length === 11 && digits.charAt(0) === '1') digits = digits.slice(1);
+        if (digits.length !== 10 || /^[01]/.test(digits)) return null;
+        return '+1' + digits;
+      }
+
+      function maskPhone(e164) {
+        return '(***) ***-' + e164.slice(-4);
+      }
+
+      function postJSON(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body)
+        }).then(function (res) {
+          return res.json().catch(function () { return {}; }).then(function (data) {
+            if (!res.ok) {
+              var err = new Error(data.message || 'Request failed');
+              err.status = res.status;
+              throw err;
+            }
+            return data;
+          });
+        });
+      }
+
+      function friendlyError(err, fallback) {
+        if (err && err.status === 429) return 'Too many attempts. Please wait a moment and try again.';
+        if (err && err.status && err.message && err.message !== 'Request failed') return err.message;
+        if (err instanceof TypeError) return 'We couldn\u2019t reach our servers. Check your connection and try again.';
+        return fallback;
+      }
+
+      function setBusy(btn, busy, busyLabel) {
+        state.busy = busy;
+        btn.disabled = busy;
+        if (busy) {
+          btn.dataset.label = btn.textContent;
+          btn.textContent = busyLabel;
+        } else if (btn.dataset.label) {
+          btn.textContent = btn.dataset.label;
+        }
+        btn.setAttribute('aria-busy', busy ? 'true' : 'false');
+      }
+
+      function startCooldown() {
+        var remaining = RESEND_COOLDOWN;
+        clearInterval(cooldownTimer);
+        resendBtn.disabled = true;
+        resendBtn.textContent = 'Resend code in ' + remaining + 's';
+        cooldownTimer = setInterval(function () {
+          remaining -= 1;
+          if (remaining <= 0) {
+            clearInterval(cooldownTimer);
+            resendBtn.disabled = false;
+            resendBtn.textContent = 'Resend code';
+          } else {
+            resendBtn.textContent = 'Resend code in ' + remaining + 's';
+          }
+        }, 1000);
+      }
+
+      function stopWebOtp() {
+        if (webOtpController) {
+          webOtpController.abort();
+          webOtpController = null;
+        }
+      }
+
+      // WebOTP API: read the code from the incoming SMS (Chrome on Android, with user consent).
+      // iOS/macOS Safari and others use autocomplete="one-time-code" to offer the code above the keyboard.
+      function listenForSmsCode() {
+        stopWebOtp();
+        if (!('OTPCredential' in window) || !navigator.credentials) return;
+        var controller = new AbortController();
+        webOtpController = controller;
+        navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal })
+          .then(function (otp) {
+            if (controller.signal.aborted || !otp || !otp.code) return;
+            var code = String(otp.code).replace(/\D/g, '').slice(0, CODE_LENGTH);
+            if (code.length !== CODE_LENGTH) return;
+            otpInput.value = code;
+            setFieldError(otpInput, otpError, '');
+            setStatus('Code received from your text message. Verifying\u2026');
+            submitCode();
+          })
+          .catch(function () { /* aborted, dismissed, or unsupported — user can type the code */ })
+          .finally(function () {
+            if (webOtpController === controller) webOtpController = null;
+          });
+      }
+
+      function requestCode() {
+        setBusy(sendBtn, true, 'Sending\u2026');
+        setStatus('');
+        return postJSON(SEND_URL, { phone: state.phone, purpose: state.purpose })
+          .then(function () {
+            listenForSmsCode();
+            startCooldown();
+            return true;
+          })
+          .catch(function (err) {
+            setStatus(friendlyError(err, 'We couldn\u2019t send a code. Please try again.'), 'error');
+            return false;
+          })
+          .finally(function () { setBusy(sendBtn, false); });
+      }
+
+      function showOtpStep() {
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.value = '';
+        setFieldError(otpInput, otpError, '');
+        sentTo.textContent = 'We texted a ' + CODE_LENGTH + '-digit code to ' + maskPhone(state.phone) + '.';
+        setStatus('Code sent. It may take up to a minute to arrive.');
+        otpInput.focus();
+      }
+
+      function showPhoneStep() {
+        stopWebOtp();
+        clearInterval(cooldownTimer);
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus('');
+        phoneInput.focus();
+      }
+
+      function submitCode() {
+        if (state.busy) return;
+        var code = otpInput.value.replace(/\D/g, '');
+        if (code.length !== CODE_LENGTH) {
+          setFieldError(otpInput, otpError, 'Enter the ' + CODE_LENGTH + '-digit code from your text message.');
+          otpInput.focus();
+          return;
+        }
+        setFieldError(otpInput, otpError, '');
+        stopWebOtp();
+        setBusy(verifyBtn, true, 'Verifying\u2026');
+        postJSON(VERIFY_URL, { phone: state.phone, code: code, purpose: state.purpose })
+          .then(function (data) {
+            clearInterval(cooldownTimer);
+            otpInput.value = '';
+            setStatus('You\u2019re verified! Redirecting\u2026', 'success');
+            var fallback = state.purpose === 'order' ? '/order-online' : '/rewards';
+            var next = data && typeof data.redirect === 'string' && /^\/(?!\/)/.test(data.redirect)
+              ? data.redirect : fallback; // only same-origin paths
+            window.location.assign(next);
+          })
+          .catch(function (err) {
+            setBusy(verifyBtn, false);
+            otpInput.value = '';
+            var msg = (err && (err.status === 400 || err.status === 401 || err.status === 422))
+              ? 'That code is incorrect or has expired. Try again or request a new code.'
+              : friendlyError(err, 'We couldn\u2019t verify your code. Please try again.');
+            setFieldError(otpInput, otpError, msg);
+            otpInput.focus();
+            listenForSmsCode();
+          });
+      }
+
+      phoneForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (state.busy) return;
+        var phone = normalizePhone(phoneInput.value);
+        if (!phone) {
+          setFieldError(phoneInput, phoneError, 'Enter a valid 10-digit US mobile number.');
+          phoneInput.focus();
+          return;
+        }
+        setFieldError(phoneInput, phoneError, '');
+        state.phone = phone;
+        var checked = phoneForm.querySelector('input[name="purpose"]:checked');
+        state.purpose = checked ? checked.value : 'rewards';
+        requestCode().then(function (ok) { if (ok) showOtpStep(); });
+      });
+
+      otpForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        submitCode();
+      });
+
+      // Keep only digits (handles paste like "123-456" or "Code: 123456") and auto-submit when complete.
+      otpInput.addEventListener('input', function () {
+        var digits = otpInput.value.replace(/\D/g, '').slice(0, CODE_LENGTH);
+        if (otpInput.value !== digits) otpInput.value = digits;
+        if (otpError.textContent) setFieldError(otpInput, otpError, '');
+        if (digits.length === CODE_LENGTH) submitCode();
+      });
+
+      resendBtn.addEventListener('click', function () {
+        if (state.busy || !state.phone) return;
+        otpInput.value = '';
+        requestCode().then(function (ok) {
+          if (ok) setStatus('A new code is on its way to ' + maskPhone(state.phone) + '.');
+          otpInput.focus();
+        });
+      });
+
+      changeBtn.addEventListener('click', showPhoneStep);
+
+      // Deep links: /#verify-order preselects online ordering.
+      if (location.hash === '#verify-order') {
+        var orderRadio = phoneForm.querySelector('input[value="order"]');
+        if (orderRadio) orderRadio.checked = true;
+      }
+    })();
+  </script>
+
 </body>
 
