+  <script>
+    /*
+     * SMS one-time passcode flow.
+     * Backend contract (POST, form-encoded):
+     *   /api/otp/send   { phone, purpose } -> 2xx when the SMS was sent
+     *   /api/otp/verify { phone, purpose, otp } -> 2xx JSON { redirect? } on success
+     * The SMS body MUST end with an origin-bound line so WebOTP and
+     * autocomplete="one-time-code" can verify the domain, e.g.:
+     *   Your Daily Grind code is 123456.
+     *
+     *   @dailygrind.example #123456
+     */
+    (() => {
+      const phoneForm = document.getElementById('phone-form');
+      const phoneInput = document.getElementById('phone-input');
+      const phoneStatus = document.getElementById('phone-status');
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpStatus = document.getElementById('otp-status');
+      const otpPhone = document.getElementById('otp-phone');
+      const otpPurpose = document.getElementById('otp-purpose');
+      const otpPhoneDisplay = document.getElementById('otp-phone-display');
+      const resendBtn = document.getElementById('resend-btn');
+      const changeBtn = document.getElementById('change-number-btn');
+
+      const DESTINATIONS = { rewards: '/rewards', order: '/order-online' };
+
+      const setStatus = (el, message, tone = '') => {
+        el.textContent = message;
+        if (tone) el.dataset.tone = tone; else delete el.dataset.tone;
+      };
+
+      // --- Keep aria-invalid in sync with :user-invalid ---
+      const syncAria = (input) => {
+        if (input.matches(':user-invalid')) input.setAttribute('aria-invalid', 'true');
+        else input.removeAttribute('aria-invalid');
+      };
+      for (const input of [phoneInput, otpInput]) {
+        input.addEventListener('blur', () => syncAria(input));
+        input.addEventListener('invalid', () => syncAria(input));
+        input.addEventListener('input', () => {
+          if (input.getAttribute('aria-invalid') === 'true') syncAria(input);
+        });
+      }
+
+      // --- WebOTP lifecycle ---
+      let otpAbortController = null;
+
+      function stopSmsOtpListener() {
+        if (otpAbortController) {
+          otpAbortController.abort();
+          otpAbortController = null;
+        }
+      }
+
+      async function startSmsOtpListener() {
+        if (!('OTPCredential' in window)) return;
+        stopSmsOtpListener();
+        const ac = new AbortController();
+        otpAbortController = ac;
+        try {
+          const otp = await navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal,
+          });
+          if (!otp || ac.signal.aborted) return;
+          otpInput.value = otp.code;
+          otpForm.requestSubmit(); // runs submit listeners + constraint validation
+        } catch (err) {
+          if (err && err.name === 'AbortError') return;
+          console.error('WebOTP error:', err);
+        }
+      }
+
+      window.addEventListener('pagehide', stopSmsOtpListener);
+
+      // --- Helpers ---
+      const normalizePhone = (value) => {
+        const digits = value.replace(/\D/g, '');
+        return digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
+      };
+      const formatPhone = (d) => `(${d.slice(0, 3)}) ${d.slice(3, 6)}-${d.slice(6)}`;
+
+      async function post(url, data) {
+        const res = await fetch(url, {
+          method: 'POST',
+          headers: { Accept: 'application/json' },
+          body: new URLSearchParams(data),
+        });
+        if (!res.ok) {
+          const err = new Error(`Request failed (${res.status})`);
+          err.status = res.status;
+          throw err;
+        }
+        return res.headers.get('content-type')?.includes('application/json') ? res.json() : {};
+      }
+
+      async function requestCode() {
+        const data = { phone: otpPhone.value, purpose: otpPurpose.value };
+        await post(phoneForm.action, data);
+      }
+
+      function showOtpStep() {
+        phoneForm.hidden = true;
+        otpForm.hidden = false;
+        otpInput.value = '';
+        otpInput.removeAttribute('aria-invalid');
+        setStatus(otpStatus, 'Code sent. It may take a moment to arrive.');
+        otpInput.focus();
+        startSmsOtpListener();
+      }
+
+      function showPhoneStep() {
+        stopSmsOtpListener();
+        otpForm.hidden = true;
+        phoneForm.hidden = false;
+        setStatus(phoneStatus, '');
+        phoneInput.focus();
+      }
+
+      // Validate phone as 10 US digits (formatting characters allowed)
+      const validatePhone = () => {
+        const ok = /^[\d\s()+.\-]*$/.test(phoneInput.value) && normalizePhone(phoneInput.value).length === 10;
+        phoneInput.setCustomValidity(phoneInput.value && !ok ? 'Enter a valid 10-digit US mobile number.' : '');
+      };
+      phoneInput.addEventListener('input', validatePhone);
+
+      // --- Step 1: send code ---
+      phoneForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        if (!phoneForm.reportValidity()) {
+          syncAria(phoneInput);
+          return;
+        }
+        const digits = normalizePhone(phoneInput.value);
+        const purpose = new FormData(phoneForm).get('purpose');
+        otpPhone.value = `+1${digits}`;
+        otpPurpose.value = purpose;
+        otpPhoneDisplay.textContent = formatPhone(digits);
+
+        const submitBtn = phoneForm.querySelector('button[type="submit"]');
+        submitBtn.disabled = true;
+        setStatus(phoneStatus, 'Sending your code…');
+        try {
+          await requestCode();
+          showOtpStep();
+        } catch (err) {
+          setStatus(phoneStatus, err.status === 429
+            ? 'Too many requests. Please wait a minute and try again.'
+            : "We couldn't send a code right now. Please try again.", 'error');
+        } finally {
+          submitBtn.disabled = false;
+        }
+      });
+
+      // --- Step 2: verify code ---
+      otpForm.addEventListener('submit', async (event) => {
+        stopSmsOtpListener(); // abort any in-flight WebOTP request
+        event.preventDefault();
+        if (!otpForm.reportValidity()) {
+          syncAria(otpInput);
+          return;
+        }
+        const submitBtn = otpForm.querySelector('button[type="submit"]');
+        submitBtn.disabled = true;
+        setStatus(otpStatus, 'Verifying…');
+        try {
+          const result = await post(otpForm.action, Object.fromEntries(new FormData(otpForm)));
+          setStatus(otpStatus, 'Verified! Redirecting…', 'success');
+          window.location.assign(result.redirect || DESTINATIONS[otpPurpose.value] || '/');
+        } catch (err) {
+          setStatus(otpStatus, err.status === 400 || err.status === 401
+            ? "That code didn't match or has expired. Check the text and try again."
+            : 'Something went wrong verifying your code. Please try again.', 'error');
+          otpInput.setAttribute('aria-invalid', 'true');
+          otpInput.select();
+          submitBtn.disabled = false;
+        }
+      });
+
+      // --- Resend / change number ---
+      resendBtn.addEventListener('click', async () => {
+        stopSmsOtpListener();
+        resendBtn.disabled = true;
+        setStatus(otpStatus, 'Sending a new code…');
+        try {
+          await requestCode();
+          otpInput.value = '';
+          setStatus(otpStatus, 'A new code is on its way.');
+          otpInput.focus();
+          startSmsOtpListener();
+        } catch {
+          setStatus(otpStatus, "We couldn't resend the code. Please try again shortly.", 'error');
+        } finally {
+          // Simple cooldown to discourage SMS spamming
+          setTimeout(() => { resendBtn.disabled = false; }, 30000);
+        }
+      });
+
+      changeBtn.addEventListener('click', showPhoneStep);
+    })();
+  </script>
+
 </body>
 
 </html>
