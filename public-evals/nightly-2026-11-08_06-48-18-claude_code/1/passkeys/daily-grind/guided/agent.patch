index 0000000..61c3d52
--- /dev/null
+++ b/js/mock-server.js
@@ -0,0 +1,599 @@
+/**
+ * In-browser stand-in for the Daily Grind account API.
+ *
+ * The site is served as static files, so this module plays the role of the
+ * backend: it owns the "database" (localStorage), the session
+ * (sessionStorage), WebAuthn options generation and assertion/attestation
+ * verification (challenge, origin, RP ID hash, UP flag, signature, counter).
+ *
+ * In production, replace this with a real backend that uses a vetted FIDO2
+ * library such as SimpleWebAuthn (`@simplewebauthn/server`). The HTTP contract
+ * implemented by `handle()` mirrors the routes the client calls in `api.js`,
+ * so swapping it for `fetch()` requires no client-side changes.
+ */
+
+// Predefined Relying Party configuration. A real server hard-codes its
+// registrable domain here (e.g. "dailygrind.example"); for this static demo
+// the server is "hosted" on whatever origin serves the page.
+const RP_ID = location.hostname;
+const RP_NAME = 'The Daily Grind';
+const EXPECTED_ORIGIN = location.origin;
+
+const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const DB_KEY = 'dg.db.v1';
+const SESSION_KEY = 'dg.session.v1';
+
+/* ------------------------------------------------------------------ */
+/* Encoding helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+const textEncoder = new TextEncoder();
+
+function toBase64Url(bytes) {
+  let binary = '';
+  for (const b of new Uint8Array(bytes)) binary += String.fromCharCode(b);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function fromBase64Url(value) {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+}
+
+function randomBase64Url(size = 32) {
+  return toBase64Url(crypto.getRandomValues(new Uint8Array(size)));
+}
+
+async function sha256(data) {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', data));
+}
+
+function equalBytes(a, b) {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+}
+
+function concatBytes(...parts) {
+  const out = new Uint8Array(parts.reduce((n, p) => n + p.length, 0));
+  let offset = 0;
+  for (const p of parts) {
+    out.set(p, offset);
+    offset += p.length;
+  }
+  return out;
+}
+
+function formatUuid(bytes) {
+  const hex = [...bytes].map((b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+/* ------------------------------------------------------------------ */
+/* Persistence                                                         */
+/* ------------------------------------------------------------------ */
+
+function loadDb() {
+  try {
+    const db = JSON.parse(localStorage.getItem(DB_KEY));
+    if (db && db.users && db.credentials) return db;
+  } catch { /* fall through to a fresh database */ }
+  return { users: {}, credentials: {} };
+}
+
+function saveDb(db) {
+  localStorage.setItem(DB_KEY, JSON.stringify(db));
+}
+
+function loadSession() {
+  try {
+    return JSON.parse(sessionStorage.getItem(SESSION_KEY)) || {};
+  } catch {
+    return {};
+  }
+}
+
+function saveSession(session) {
+  sessionStorage.setItem(SESSION_KEY, JSON.stringify(session));
+}
+
+/* ------------------------------------------------------------------ */
+/* WebAuthn parsing & verification                                    */
+/* ------------------------------------------------------------------ */
+
+class HttpError extends Error {
+  constructor(status, error, message) {
+    super(message);
+    this.status = status;
+    this.error = error;
+  }
+}
+
+function parseClientData(clientDataJSONb64) {
+  const raw = fromBase64Url(clientDataJSONb64);
+  return { raw, data: JSON.parse(new TextDecoder().decode(raw)) };
+}
+
+function verifyClientData(data, expectedType, expectedChallenge) {
+  if (data.type !== expectedType) {
+    throw new HttpError(400, 'bad_type', 'Unexpected WebAuthn ceremony type.');
+  }
+  if (!expectedChallenge || data.challenge !== expectedChallenge) {
+    throw new HttpError(400, 'bad_challenge', 'The challenge did not match. Please try again.');
+  }
+  if (data.origin !== EXPECTED_ORIGIN) {
+    throw new HttpError(400, 'bad_origin', 'The request came from an unexpected origin.');
+  }
+}
+
+function parseAuthenticatorData(bytes) {
+  if (bytes.length < 37) throw new HttpError(400, 'bad_auth_data', 'Malformed authenticator data.');
+  const flagsByte = bytes[32];
+  const flags = {
+    up: !!(flagsByte & 0x01),
+    uv: !!(flagsByte & 0x04),
+    be: !!(flagsByte & 0x08),
+    bs: !!(flagsByte & 0x10),
+    at: !!(flagsByte & 0x40),
+  };
+  const counter = new DataView(bytes.buffer, bytes.byteOffset + 33, 4).getUint32(0);
+  let aaguid;
+  if (flags.at && bytes.length >= 37 + 16) {
+    aaguid = formatUuid(bytes.slice(37, 53));
+  }
+  return { rpIdHash: bytes.slice(0, 32), flags, counter, aaguid };
+}
+
+async function verifyAuthenticatorData(authData, { requireUserVerification }) {
+  const expectedHash = await sha256(textEncoder.encode(RP_ID));
+  if (!equalBytes(authData.rpIdHash, expectedHash)) {
+    throw new HttpError(400, 'bad_rp_id', 'The passkey belongs to a different site.');
+  }
+  if (!authData.flags.up) {
+    throw new HttpError(400, 'no_user_presence', 'User presence was not confirmed.');
+  }
+  if (requireUserVerification && !authData.flags.uv) {
+    throw new HttpError(400, 'no_user_verification', 'User verification is required.');
+  }
+}
+
+// Convert an ASN.1 DER ECDSA signature into the raw r||s form WebCrypto expects.
+function derToRawEcdsa(der, size = 32) {
+  let offset = 2;
+  if (der[1] & 0x80) offset += der[1] & 0x7f;
+  const readInt = () => {
+    if (der[offset] !== 0x02) throw new HttpError(400, 'bad_signature', 'Malformed signature.');
+    const len = der[offset + 1];
+    let int = der.slice(offset + 2, offset + 2 + len);
+    offset += 2 + len;
+    while (int.length > size && int[0] === 0) int = int.slice(1);
+    const out = new Uint8Array(size);
+    out.set(int, size - int.length);
+    return out;
+  };
+  return concatBytes(readInt(), readInt());
+}
+
+async function verifySignature(credential, signedData, signature) {
+  const spki = fromBase64Url(credential.credentialPublicKey);
+  if (credential.publicKeyAlgorithm === -7) {
+    const key = await crypto.subtle.importKey('spki', spki, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+    return crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, derToRawEcdsa(signature), signedData);
+  }
+  if (credential.publicKeyAlgorithm === -257) {
+    const key = await crypto.subtle.importKey('spki', spki, { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, false, ['verify']);
+    return crypto.subtle.verify('RSASSA-PKCS1-v1_5', key, signature, signedData);
+  }
+  throw new HttpError(400, 'unsupported_alg', 'Unsupported passkey algorithm.');
+}
+
+let aaguidRegistryPromise;
+function loadAaguidRegistry() {
+  aaguidRegistryPromise ??= fetch(AAGUID_REGISTRY_URL)
+    .then((r) => (r.ok ? r.json() : {}))
+    .catch(() => ({}));
+  return aaguidRegistryPromise;
+}
+
+async function describeProvider(aaguid) {
+  // AAGUID is a UX hint only (provider name/icon); never use it for security decisions.
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: 'Unknown passkey provider', providerIcon: undefined };
+  }
+  const registry = await loadAaguidRegistry();
+  const provider = registry[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+    providerIconDark: provider?.icon_dark,
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Route helpers                                                       */
+/* ------------------------------------------------------------------ */
+
+function publicUser(user) {
+  return {
+    name: user.name,
+    displayName: user.displayName,
+    userId: user.passkeyUserId,
+    rpId: RP_ID,
+  };
+}
+
+function requireUser(db, session) {
+  const user = session.userId && db.users[session.userId];
+  if (!user) throw new HttpError(401, 'unauthenticated', 'Please sign in.');
+  return user;
+}
+
+function requireRecentReauth(session) {
+  if (!session.reauthAt || Date.now() - session.reauthAt > REAUTH_WINDOW_MS) {
+    throw new HttpError(401, 'reauth_required', 'Please confirm it’s you to continue.');
+  }
+}
+
+function credentialsFor(db, user) {
+  return Object.values(db.credentials)
+    .filter((c) => c.passkeyUserId === user.passkeyUserId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+function publicCredential(c) {
+  return {
+    id: c.id,
+    name: c.name,
+    providerIcon: c.providerIcon,
+    providerIconDark: c.providerIconDark,
+    aaguid: c.aaguid,
+    credentialDeviceType: c.credentialDeviceType,
+    credentialBackedUp: c.credentialBackedUp,
+    transports: c.transports,
+    registeredAt: c.registeredAt,
+    lastUsedAt: c.lastUsedAt,
+  };
+}
+
+function normalizeEmail(value) {
+  const email = String(value ?? '').trim().toLowerCase();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+    throw new HttpError(400, 'invalid_email', 'Please enter a valid email address.');
+  }
+  return email;
+}
+
+function normalizeDisplayName(value) {
+  const name = String(value ?? '').trim();
+  if (!name || name.length > 64) {
+    throw new HttpError(400, 'invalid_name', 'Please enter a name (up to 64 characters).');
+  }
+  return name;
+}
+
+function findUserByEmail(db, email) {
+  return Object.values(db.users).find((u) => u.name === email);
+}
+
+function creationOptions(session, user, existing, { promotion = false } = {}) {
+  const challenge = randomBase64Url();
+  session.registration = { challenge, userVerification: 'preferred' };
+  return {
+    challenge,
+    rp: { id: RP_ID, name: RP_NAME },
+    user: { id: user.passkeyUserId, name: user.name, displayName: user.displayName },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 },
+    ],
+    timeout: 300000,
+    attestation: 'none',
+    excludeCredentials: existing.map((c) => ({ type: 'public-key', id: c.id, transports: c.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(promotion && { authenticatorAttachment: 'platform' }),
+    },
+    hints: promotion ? ['client-device'] : [],
+  };
+}
+
+async function verifyRegistration(session, body) {
+  const expected = session.registration;
+  delete session.registration; // Challenges are single-use.
+  const { response } = body ?? {};
+  if (!response?.clientDataJSON || !response?.authenticatorData || !response?.publicKey) {
+    throw new HttpError(400, 'bad_request', 'Incomplete registration response.');
+  }
+  const clientData = parseClientData(response.clientDataJSON);
+  verifyClientData(clientData.data, 'webauthn.create', expected?.challenge);
+  const authData = parseAuthenticatorData(fromBase64Url(response.authenticatorData));
+  // userVerification was "preferred", so UV-less authenticators are accepted.
+  await verifyAuthenticatorData(authData, { requireUserVerification: expected.userVerification === 'required' });
+  if (![-7, -257].includes(response.publicKeyAlgorithm)) {
+    throw new HttpError(400, 'unsupported_alg', 'Unsupported passkey algorithm.');
+  }
+  if (!body.id || body.id !== body.rawId) {
+    throw new HttpError(400, 'bad_request', 'Invalid credential ID.');
+  }
+  return { authData, response };
+}
+
+async function buildStoredCredential(body, user, authData, response) {
+  const provider = await describeProvider(authData.aaguid);
+  return {
+    id: body.id,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: response.publicKey,
+    publicKeyAlgorithm: response.publicKeyAlgorithm,
+    credentialType: 'public-key',
+    credentialDeviceType: authData.flags.be ? 'multiDevice' : 'singleDevice',
+    credentialBackedUp: authData.flags.bs,
+    aaguid: authData.aaguid ?? ZERO_AAGUID,
+    ...provider,
+    transports: response.transports ?? [],
+    registeredAt: Date.now(),
+    lastUsedAt: undefined,
+    counter: authData.counter,
+  };
+}
+
+function requestOptions(session, purpose, allowCredentials) {
+  const challenge = randomBase64Url();
+  // Persist the expected UV level server-side rather than trusting the client.
+  session[purpose] = { challenge, userVerification: 'preferred' };
+  return {
+    challenge,
+    rpId: RP_ID,
+    allowCredentials: allowCredentials.map((c) => ({ type: 'public-key', id: c.id, transports: c.transports })),
+    userVerification: 'preferred',
+    timeout: 300000,
+  };
+}
+
+async function verifyAssertion(db, session, purpose, body) {
+  const expected = session[purpose];
+  delete session[purpose];
+  const { response } = body ?? {};
+  if (!body?.id || !response?.clientDataJSON || !response?.authenticatorData || !response?.signature) {
+    throw new HttpError(400, 'bad_request', 'Incomplete sign-in response.');
+  }
+  const credential = db.credentials[body.id];
+  if (!credential) {
+    // Explicit 404 lets the client call PublicKeyCredential.signalUnknownCredential().
+    throw new HttpError(404, 'unknown_credential', 'This passkey is no longer registered with The Daily Grind.');
+  }
+  const clientData = parseClientData(response.clientDataJSON);
+  verifyClientData(clientData.data, 'webauthn.get', expected?.challenge);
+  const authDataBytes = fromBase64Url(response.authenticatorData);
+  const authData = parseAuthenticatorData(authDataBytes);
+  await verifyAuthenticatorData(authData, { requireUserVerification: expected.userVerification === 'required' });
+
+  if (response.userHandle && response.userHandle !== credential.passkeyUserId) {
+    throw new HttpError(400, 'user_mismatch', 'The passkey does not match its account.');
+  }
+
+  const signedData = concatBytes(authDataBytes, await sha256(clientData.raw));
+  const valid = await verifySignature(credential, signedData, fromBase64Url(response.signature));
+  if (!valid) throw new HttpError(400, 'bad_signature', 'Passkey signature could not be verified.');
+
+  if ((authData.counter !== 0 || credential.counter !== 0) && authData.counter <= credential.counter) {
+    throw new HttpError(400, 'counter_regression', 'This passkey may have been cloned. Contact support.');
+  }
+
+  credential.counter = authData.counter;
+  credential.credentialBackedUp = authData.flags.bs;
+  credential.lastUsedAt = Date.now();
+  return credential;
+}
+
+/* ------------------------------------------------------------------ */
+/* Routes                                                              */
+/* ------------------------------------------------------------------ */
+
+const routes = {
+  'GET /api/session': (db, session) => {
+    const user = session.userId && db.users[session.userId];
+    return { signedIn: !!user, user: user ? publicUser(user) : null };
+  },
+
+  // --- Customer registration (passkey-first sign-up) ---
+  'POST /api/signup/options': (db, session, body) => {
+    const email = normalizeEmail(body?.name);
+    const displayName = normalizeDisplayName(body?.displayName);
+    if (findUserByEmail(db, email)) {
+      throw new HttpError(409, 'account_exists', 'An account with that email already exists. Sign in instead.');
+    }
+    const pendingUser = { passkeyUserId: randomBase64Url(32), name: email, displayName };
+    session.pendingUser = pendingUser;
+    return creationOptions(session, pendingUser, []);
+  },
+
+  'POST /api/signup/verify': async (db, session, body) => {
+    const pendingUser = session.pendingUser;
+    delete session.pendingUser;
+    if (!pendingUser) throw new HttpError(400, 'no_pending_signup', 'Sign-up expired. Please start again.');
+    if (findUserByEmail(db, pendingUser.name)) {
+      throw new HttpError(409, 'account_exists', 'An account with that email already exists. Sign in instead.');
+    }
+    const { authData, response } = await verifyRegistration(session, body);
+    if (db.credentials[body.id]) throw new HttpError(409, 'duplicate_credential', 'This passkey is already registered.');
+    const user = { ...pendingUser, createdAt: Date.now() };
+    db.users[user.passkeyUserId] = user;
+    db.credentials[body.id] = await buildStoredCredential(body, user, authData, response);
+    session.userId = user.passkeyUserId;
+    session.reauthAt = Date.now();
+    return { signedIn: true, user: publicUser(user) };
+  },
+
+  // --- Sign-in ---
+  'POST /api/signin/options': (db, session, body) => {
+    // Discoverable credentials: empty allowCredentials lets the provider list accounts.
+    let allow = [];
+    if (body?.name) {
+      const user = findUserByEmail(db, String(body.name).trim().toLowerCase());
+      if (user) allow = credentialsFor(db, user);
+    }
+    return requestOptions(session, 'signin', allow);
+  },
+
+  'POST /api/signin/verify': async (db, session, body) => {
+    const credential = await verifyAssertion(db, session, 'signin', body);
+    const user = db.users[credential.passkeyUserId];
+    if (!user) throw new HttpError(404, 'unknown_credential', 'This passkey is no longer registered.');
+    session.userId = user.passkeyUserId;
+    session.reauthAt = Date.now();
+    return { signedIn: true, user: publicUser(user) };
+  },
+
+  'POST /api/signout': (db, session) => {
+    for (const key of Object.keys(session)) delete session[key];
+    return { signedIn: false };
+  },
+
+  // --- Reauthentication (step-up) ---
+  'POST /api/reauth/options': (db, session) => {
+    const user = requireUser(db, session);
+    // Constrain to the signed-in user's own passkeys to prevent account mixing.
+    return requestOptions(session, 'reauth', credentialsFor(db, user));
+  },
+
+  'POST /api/reauth/verify': async (db, session, body) => {
+    const user = requireUser(db, session);
+    const credential = await verifyAssertion(db, session, 'reauth', body);
+    if (credential.passkeyUserId !== user.passkeyUserId) {
+      throw new HttpError(403, 'wrong_account', 'That passkey belongs to a different account.');
+    }
+    session.reauthAt = Date.now();
+    return { verified: true };
+  },
+
+  // --- Passkey management ---
+  'GET /api/credentials': (db, session) => {
+    const user = requireUser(db, session);
+    return {
+      rpId: RP_ID,
+      userId: user.passkeyUserId,
+      credentials: credentialsFor(db, user).map(publicCredential),
+    };
+  },
+
+  'POST /api/credentials/options': (db, session, body) => {
+    const user = requireUser(db, session);
+    return creationOptions(session, user, credentialsFor(db, user), { promotion: !!body?.promotion });
+  },
+
+  'POST /api/credentials/verify': async (db, session, body) => {
+    const user = requireUser(db, session);
+    const { authData, response } = await verifyRegistration(session, body);
+    if (db.credentials[body.id]) throw new HttpError(409, 'duplicate_credential', 'This passkey is already registered.');
+    const stored = await buildStoredCredential(body, user, authData, response);
+    db.credentials[body.id] = stored;
+    return publicCredential(stored);
+  },
+
+  'PUT /api/credentials/:id': (db, session, body, params) => {
+    const user = requireUser(db, session);
+    const cred = db.credentials[params.id];
+    if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+      throw new HttpError(404, 'not_found', 'Passkey not found.');
+    }
+    const name = String(body?.name ?? '').trim();
+    if (!name || name.length > 64) throw new HttpError(400, 'invalid_name', 'Use 1–64 characters for the passkey name.');
+    cred.name = name;
+    return publicCredential(cred);
+  },
+
+  'DELETE /api/credentials/:id': (db, session, body, params) => {
+    const user = requireUser(db, session);
+    const cred = db.credentials[params.id];
+    if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+      throw new HttpError(404, 'not_found', 'Passkey not found.');
+    }
+    if (credentialsFor(db, user).length <= 1) {
+      throw new HttpError(409, 'last_credential', 'You can’t remove your only passkey — add another one first.');
+    }
+    requireRecentReauth(session);
+    delete db.credentials[params.id];
+    return { success: true };
+  },
+
+  // --- Profile ---
+  'PUT /api/user': (db, session, body) => {
+    const user = requireUser(db, session);
+    const name = normalizeEmail(body?.name);
+    const displayName = normalizeDisplayName(body?.displayName);
+    const existing = findUserByEmail(db, name);
+    if (existing && existing.passkeyUserId !== user.passkeyUserId) {
+      throw new HttpError(409, 'email_taken', 'That email is already used by another account.');
+    }
+    requireRecentReauth(session);
+    user.name = name;
+    user.displayName = displayName;
+    return publicUser(user);
+  },
+};
+
+function matchRoute(method, path) {
+  for (const [key, handler] of Object.entries(routes)) {
+    const [routeMethod, routePath] = key.split(' ');
+    if (routeMethod !== method) continue;
+    const routeParts = routePath.split('/');
+    const pathParts = path.split('/');
+    if (routeParts.length !== pathParts.length) continue;
+    const params = {};
+    const ok = routeParts.every((part, i) => {
+      if (part.startsWith(':')) {
+        params[part.slice(1)] = decodeURIComponent(pathParts[i]);
+        return true;
+      }
+      return part === pathParts[i];
+    });
+    if (ok) return { handler, params };
+  }
+  return null;
+}
+
+function json(status, payload) {
+  return new Response(JSON.stringify(payload), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+/**
+ * Handle an API request and return a fetch-compatible Response.
+ * @param {string} method
+ * @param {string} path
+ * @param {unknown} [body]
+ */
+export async function handle(method, path, body) {
+  const match = matchRoute(method, path);
+  if (!match) return json(404, { error: 'not_found', message: 'Unknown endpoint.' });
+
+  const db = loadDb();
+  const session = loadSession();
+  try {
+    const result = await match.handler(db, session, body, match.params);
+    saveDb(db);
+    saveSession(session);
+    return json(200, result);
+  } catch (err) {
+    saveSession(session); // Persist consumed challenges even on failure.
+    if (err instanceof HttpError) {
+      return json(err.status, { error: err.error, message: err.message });
+    }
+    console.warn('Account API error:', err);
+    return json(500, { error: 'server_error', message: 'Something went wrong. Please try again.' });
+  }
+}
