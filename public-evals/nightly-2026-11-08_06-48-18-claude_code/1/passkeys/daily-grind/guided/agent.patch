+/**
+ * "My Account" passkey UI: customer registration, sign-in (button +
+ * conditional autofill), saved passkey management, profile updates and
+ * step-up reauthentication — all using the native WebAuthn browser APIs.
+ */
+import { api, readJson } from './api.js';
+
+// Invoker Commands drive the dialogs declaratively; polyfill only where missing.
+if (!('commandForElement' in HTMLButtonElement.prototype)) {
+  await import('invokers-polyfill');
+}
+
+const webAuthnAvailable = 'PublicKeyCredential' in window;
+if (webAuthnAvailable) {
+  // Fills in getClientCapabilities / parse*OptionsFromJSON / toJSON on older engines.
+  await import('webauthn-polyfills');
+}
+
+/* ------------------------------------------------------------------ */
+/* Elements                                                            */
+/* ------------------------------------------------------------------ */
+
+const $ = (id) => document.getElementById(id);
+
+const accountDialog = $('account-dialog');
+const statusEl = $('account-status');
+const signedOutView = $('signed-out-view');
+const signedInView = $('signed-in-view');
+const signinPanel = $('signin-panel');
+const signupPanel = $('signup-panel');
+const signinForm = $('signin-form');
+const signinEmail = $('signin-email');
+const signupForm = $('signup-form');
+const unsupportedNote = $('passkey-unsupported');
+const greeting = $('account-greeting');
+const profileForm = $('profile-form');
+const passkeyList = $('passkey-list');
+const passkeyEmpty = $('passkey-empty');
+const addPasskeyBtn = $('add-passkey-btn');
+const addPasskeyNote = $('add-passkey-note');
+const signoutBtn = $('signout-btn');
+const navLogout = $('nav-logout');
+const navAccount = $('nav-account');
+
+const renameDialog = $('rename-dialog');
+const renameForm = $('rename-form');
+const renameInput = $('rename-input');
+const deleteDialog = $('delete-dialog');
+const deleteName = $('delete-passkey-name');
+const reauthDialog = $('reauth-dialog');
+const reauthReason = $('reauth-reason');
+const reauthBtn = $('reauth-btn');
+const reauthError = $('reauth-error');
+
+/* ------------------------------------------------------------------ */
+/* State & helpers                                                     */
+/* ------------------------------------------------------------------ */
+
+let currentUser = null;
+let capabilities = {};
+let canCreatePasskey = false;
+let conditionalController = null;
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const dateTimeFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+function setStatus(message = '', tone = 'info') {
+  statusEl.textContent = message;
+  statusEl.dataset.tone = tone;
+  statusEl.hidden = !message;
+}
+
+async function busy(button, task) {
+  const buttons = button ? [button] : [];
+  for (const b of buttons) {
+    b.disabled = true;
+    b.setAttribute('aria-busy', 'true');
+  }
+  try {
+    return await task();
+  } finally {
+    for (const b of buttons) {
+      b.disabled = false;
+      b.removeAttribute('aria-busy');
+    }
+  }
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value) {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+function describeWebAuthnError(err, action) {
+  switch (err?.name) {
+    case 'NotAllowedError':
+      return null; // User cancelled or timed out — not worth an error banner.
+    case 'AbortError':
+      return null;
+    case 'InvalidStateError':
+      return action === 'create'
+        ? 'A passkey for this account already exists in this password manager.'
+        : 'That passkey can’t be used right now.';
+    case 'SecurityError':
+      return 'Passkeys need a secure (HTTPS) connection on the correct domain.';
+    default:
+      console.warn(`Passkey ${action} failed:`, err);
+      return 'Something went wrong with your passkey. Please try again.';
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Signal API (passive password-manager sync)                          */
+/* ------------------------------------------------------------------ */
+
+async function signalUnknown(rpId, credentialId) {
+  if (!webAuthnAvailable || !PublicKeyCredential.signalUnknownCredential) return;
+  if (!rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+async function signalAccepted(rpId, userId, credentials) {
+  if (!webAuthnAvailable || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid Base64URL IDs are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+async function signalUserDetails({ rpId, userId, name, displayName }) {
+  if (!webAuthnAvailable || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Sign-in                                                             */
+/* ------------------------------------------------------------------ */
+
+function abortConditionalSignin() {
+  conditionalController?.abort();
+  conditionalController = null;
+}
+
+/** Shared verification step for both autofill and button sign-ins. */
+async function completeSignin(publicKey, credential) {
+  const encoded = credential.toJSON();
+  try {
+    const response = await api.signinVerify(encoded);
+    const body = await readJson(response);
+    if (!response.ok) {
+      if (response.status === 404) {
+        // Unauthenticated + credential unknown to the server: let the password manager hide it.
+        await signalUnknown(publicKey.rpId, encoded.id);
+      }
+      setStatus(body.message || 'We couldn’t sign you in with that passkey.', 'error');
+      return false;
+    }
+    await onSignedIn(body.user, `Welcome back, ${body.user.displayName}!`);
+    return true;
+  } catch (err) {
+    console.warn('Sign-in verification request failed:', err);
+    setStatus('We couldn’t reach the server. Please try again.', 'error');
+    return false;
+  }
+}
+
+async function startConditionalSignin() {
+  if (!webAuthnAvailable || currentUser || capabilities.conditionalGet !== true) return;
+  abortConditionalSignin();
+  const controller = new AbortController();
+  conditionalController = controller;
+
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await readJson(await api.signinOptions()));
+  let credential;
+  try {
+    credential = await navigator.credentials.get({
+      publicKey,
+      mediation: 'conditional',
+      signal: controller.signal,
+    });
+  } catch (err) {
+    if (!['NotAllowedError', 'AbortError'].includes(err.name)) {
+      console.warn('Conditional passkey sign-in error:', err);
+    }
+    return;
+  }
+  if (controller !== conditionalController || !credential) return;
+  conditionalController = null;
+  const ok = await completeSignin(publicKey, credential);
+  if (!ok) startConditionalSignin();
+}
+
+async function signinWithButton(event) {
+  event.preventDefault();
+  const submitter = event.submitter ?? signinForm.querySelector('[type="submit"]');
+  setStatus();
+  // Abort the pending autofill request to avoid passkey prompt collisions.
+  abortConditionalSignin();
+
+  await busy(submitter, async () => {
+    const email = signinEmail.value.trim();
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(await readJson(await api.signinOptions(email)));
+    let credential;
+    try {
+      credential = await navigator.credentials.get({ publicKey });
+    } catch (err) {
+      const message = describeWebAuthnError(err, 'get');
+      if (message) setStatus(message, 'error');
+      startConditionalSignin(); // Re-arm autofill after a cancelled prompt.
+      return;
+    }
+    const ok = await completeSignin(publicKey, credential);
+    if (!ok) startConditionalSignin();
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Registration (new customer + additional passkeys)                   */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Run a passkey creation ceremony and send the result to `verify`.
+ * Returns the parsed verification body, or null when it did not succeed.
+ */
+async function createPasskey(optionsResponse, verify) {
+  const optionsBody = await readJson(optionsResponse);
+  if (!optionsResponse.ok) {
+    setStatus(optionsBody.message || 'We couldn’t start passkey creation.', 'error');
+    return null;
+  }
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsBody);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    const message = describeWebAuthnError(err, 'create');
+    if (message) setStatus(message, 'error');
+    return null; // Don't signal unknown for standard WebAuthn cancellations.
+  }
+
+  const encoded = credential.toJSON();
+  try {
+    const response = await verify(encoded);
+    const body = await readJson(response);
+    if (!response.ok) {
+      // The server rejected the new credential: it is orphaned in the password manager.
+      await signalUnknown(publicKey.rp.id, encoded.id);
+      setStatus(body.message || 'We couldn’t save your passkey.', 'error');
+      return null;
+    }
+    return body;
+  } catch (err) {
+    console.warn('Passkey verification request failed:', err);
+    await signalUnknown(publicKey.rp.id, encoded.id);
+    setStatus('We couldn’t reach the server. Please try again.', 'error');
+    return null;
+  }
+}
+
+async function signup(event) {
+  event.preventDefault();
+  const submitter = event.submitter ?? signupForm.querySelector('[type="submit"]');
+  setStatus();
+  abortConditionalSignin();
+
+  await busy(submitter, async () => {
+    const data = new FormData(signupForm);
+    const body = await createPasskey(
+      await api.signupOptions({ name: data.get('email'), displayName: data.get('name') }),
+      api.signupVerify,
+    );
+    if (body?.signedIn) {
+      signupForm.reset();
+      await onSignedIn(body.user, `Welcome to The Daily Grind, ${body.user.displayName}! Your passkey is ready.`);
+    } else {
+      startConditionalSignin();
+    }
+  });
+}
+
+async function addPasskey() {
+  setStatus();
+  await busy(addPasskeyBtn, async () => {
+    const created = await createPasskey(await api.credentialOptions(false), api.credentialVerify);
+    if (created) {
+      setStatus(`Passkey saved (${created.name}).`, 'success');
+      await refreshPasskeys();
+    }
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* Reauthentication                                                    */
+/* ------------------------------------------------------------------ */
+
+/** Open the "Confirm it's you" dialog; resolves true once verified. */
+function requestReauth(reason) {
+  return new Promise((resolve) => {
+    reauthReason.textContent = reason;
+    reauthError.textContent = '';
+    reauthDialog.returnValue = '';
+    reauthDialog.addEventListener(
+      'close',
+      () => {
+        resolve(reauthDialog.returnValue === 'verified');
+        reauthDialog.returnValue = '';
+      },
+      { once: true },
+    );
+    reauthDialog.showModal();
+  });
+}
+
+async function performReauth() {
+  reauthError.textContent = '';
+  await busy(reauthBtn, async () => {
+    const optionsResponse = await api.reauthOptions();
+    const optionsBody = await readJson(optionsResponse);
+    if (!optionsResponse.ok) {
+      reauthError.textContent = optionsBody.message || 'We couldn’t start verification.';
+      return;
+    }
+    // allowCredentials is limited to this account's passkeys by the server.
+    const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsBody);
+    let credential;
+    try {
+      credential = await navigator.credentials.get({ publicKey });
+    } catch (err) {
+      reauthError.textContent = describeWebAuthnError(err, 'get') ?? 'Verification was cancelled.';
+      return;
+    }
+    const encoded = credential.toJSON();
+    try {
+      const response = await api.reauthVerify(encoded);
+      const body = await readJson(response);
+      if (response.ok) {
+        reauthDialog.close('verified');
+        return;
+      }
+      if (response.status === 404) await signalUnknown(publicKey.rpId, encoded.id);
+      reauthError.textContent = body.message || 'We couldn’t verify that passkey.';
+    } catch (err) {
+      console.warn('Reauthentication request failed:', err);
+      reauthError.textContent = 'We couldn’t reach the server. Please try again.';
+    }
+  });
+}
+
+/**
+ * Run a sensitive request; if the server asks for a fresh verification,
+ * prompt the user with their passkey and retry once.
+ */
+async function withReauth(reason, request) {
+  let response = await request();
+  if (response.status === 401) {
+    const body = await readJson(response.clone());
+    if (body.error === 'reauth_required') {
+      const verified = await requestReauth(reason);
+      if (!verified) return null;
+      response = await request();
+    }
+  }
+  return response;
+}
+
+/* ------------------------------------------------------------------ */
+/* Passkey management                                                  */
+/* ------------------------------------------------------------------ */
+
+const keyIconSvg =
+  'data:image/svg+xml,' +
+  encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4e342e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/><path d="M10.85 12.15 19 4M18 5l2 2M15 8l2 2"/></svg>',
+  );
+
+function renderPasskeys(credentials) {
+  passkeyList.replaceChildren();
+  passkeyEmpty.hidden = credentials.length > 0;
+
+  for (const cred of credentials) {
+    const item = document.createElement('li');
+    item.className = 'passkey-item';
+
+    const icon = document.createElement('img');
+    icon.className = 'passkey-icon';
+    icon.src = cred.providerIcon || keyIconSvg;
+    icon.alt = '';
+    icon.width = 32;
+    icon.height = 32;
+
+    const info = document.createElement('div');
+    info.className = 'passkey-info';
+    const title = document.createElement('strong');
+    title.textContent = cred.name;
+    const meta = document.createElement('small');
+    const created = `Created ${dateFormat.format(cred.registeredAt)}`;
+    const used = cred.lastUsedAt ? `Last used ${dateTimeFormat.format(cred.lastUsedAt)}` : 'Not used yet';
+    const synced = cred.credentialBackedUp ? 'Synced' : 'This device only';
+    meta.textContent = `${created} · ${used} · ${synced}`;
+    info.append(title, meta);
+
+    const actions = document.createElement('div');
+    actions.className = 'passkey-actions';
+    const rename = document.createElement('button');
+    rename.type = 'button';
+    rename.className = 'btn-secondary';
+    rename.textContent = 'Rename';
+    rename.setAttribute('aria-label', `Rename ${cred.name}`);
+    rename.addEventListener('click', () => openRename(cred));
+
+    const remove = document.createElement('button');
+    remove.type = 'button';
+    remove.className = 'btn-danger';
+    remove.textContent = 'Delete';
+    remove.setAttribute('aria-label', `Delete ${cred.name}`);
+    remove.disabled = credentials.length === 1;
+    if (remove.disabled) remove.title = 'Add another passkey before deleting your only one.';
+    remove.addEventListener('click', () => openDelete(cred));
+
+    actions.append(rename, remove);
+    item.append(icon, info, actions);
+    passkeyList.append(item);
+  }
+}
+
+async function refreshPasskeys() {
+  const response = await api.listCredentials();
+  if (!response.ok) return;
+  const { rpId, userId, credentials } = await readJson(response);
+  renderPasskeys(credentials);
+  // Keep the user's password managers in sync with the server's list.
+  await signalAccepted(rpId, userId, credentials);
+}
+
+function openRename(cred) {
+  renameForm.dataset.credentialId = cred.id;
+  renameInput.value = cred.name;
+  renameDialog.returnValue = '';
+  renameDialog.showModal();
+}
+
+renameDialog.addEventListener('close', async () => {
+  const choice = renameDialog.returnValue;
+  renameDialog.returnValue = '';
+  if (choice !== 'save') return;
+  const id = renameForm.dataset.credentialId;
+  const response = await api.renameCredential(id, renameInput.value.trim());
+  const body = await readJson(response);
+  if (!response.ok) {
+    setStatus(body.message || 'We couldn’t rename that passkey.', 'error');
+    return;
+  }
+  // Nickname is a server-side label only; no Signal API call is needed.
+  setStatus(`Passkey renamed to “${body.name}”.`, 'success');
+  await refreshPasskeys();
+});
+
+function openDelete(cred) {
+  deleteDialog.dataset.credentialId = cred.id;
+  deleteName.textContent = cred.name;
+  deleteDialog.returnValue = '';
+  deleteDialog.showModal();
+}
+
+deleteDialog.addEventListener('close', async () => {
+  const choice = deleteDialog.returnValue;
+  deleteDialog.returnValue = '';
+  if (choice !== 'delete') return;
+  const id = deleteDialog.dataset.credentialId;
+  const response = await withReauth('Deleting a passkey is a security change. Confirm it’s you with one of your passkeys.', () =>
+    api.deleteCredential(id),
+  );
+  if (!response) {
+    setStatus('Passkey not deleted — verification was cancelled.', 'info');
+    return;
+  }
+  const body = await readJson(response);
+  if (!response.ok) {
+    setStatus(body.message || 'We couldn’t delete that passkey.', 'error');
+    return;
+  }
+  setStatus('Passkey deleted. Remember to also remove it from your password manager if it’s still listed.', 'success');
+  await refreshPasskeys(); // Includes signalAllAcceptedCredentials with the remaining IDs.
+});
+
+/* ------------------------------------------------------------------ */
+/* Profile                                                             */
+/* ------------------------------------------------------------------ */
+
+function renderProfile(user) {
+  greeting.textContent = `Hi, ${user.displayName}`;
+  profileForm.elements.displayName.value = user.displayName;
+  profileForm.elements.email.value = user.name;
+}
+
+async function updateProfile(event) {
+  event.preventDefault();
+  const submitter = event.submitter ?? profileForm.querySelector('[type="submit"]');
+  setStatus();
+  const data = new FormData(profileForm);
+  const profile = { name: String(data.get('email')).trim(), displayName: String(data.get('displayName')).trim() };
+  if (profile.name === currentUser.name && profile.displayName === currentUser.displayName) {
+    setStatus('No changes to save.', 'info');
+    return;
+  }
+
+  await busy(submitter, async () => {
+    const response = await withReauth('Changing your account details requires a quick passkey check.', () =>
+      api.updateUser(profile),
+    );
+    if (!response) {
+      setStatus('Changes not saved — verification was cancelled.', 'info');
+      return;
+    }
+    const body = await readJson(response);
+    if (!response.ok) {
+      setStatus(body.message || 'We couldn’t update your profile.', 'error');
+      return;
+    }
+    currentUser = body;
+    renderProfile(body);
+    // Update the username / display name shown by password managers.
+    await signalUserDetails(body);
+    setStatus('Profile updated.', 'success');
+  });
+}
+
+/* ------------------------------------------------------------------ */
+/* View state                                                          */
+/* ------------------------------------------------------------------ */
+
+function showSignupPanel(show) {
+  signinPanel.hidden = show;
+  signupPanel.hidden = !show;
+  setStatus();
+  (show ? signupForm.elements.name : signinEmail).focus();
+}
+
+function render() {
+  const signedIn = !!currentUser;
+  signedOutView.hidden = signedIn;
+  signedInView.hidden = !signedIn;
+  navLogout.hidden = !signedIn;
+  navAccount.textContent = signedIn ? `My Account (${currentUser.displayName})` : 'My Account';
+  if (signedIn) renderProfile(currentUser);
+}
+
+async function onSignedIn(user, message) {
+  currentUser = user;
+  render();
+  setStatus(message, 'success');
+  if (!accountDialog.open) accountDialog.showModal();
+  await refreshPasskeys();
+}
+
+async function signOut() {
+  await api.signout();
+  currentUser = null;
+  passkeyList.replaceChildren();
+  render();
+  signinPanel.hidden = false;
+  signupPanel.hidden = true;
+  setStatus('You’ve been signed out.', 'info');
+  startConditionalSignin();
+}
+
+async function onAccountOpen() {
+  if (currentUser) {
+    await refreshPasskeys();
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Init                                                                */
+/* ------------------------------------------------------------------ */
+
+async function init() {
+  if (webAuthnAvailable) {
+    capabilities = await PublicKeyCredential.getClientCapabilities();
+  }
+  // Polyfilled engines can't report passkeyPlatformAuthenticator; fall back to UVPAA there.
+  const platformAuthenticator =
+    capabilities.passkeyPlatformAuthenticator ?? capabilities.userVerifyingPlatformAuthenticator;
+  canCreatePasskey = webAuthnAvailable && !!platformAuthenticator && !!capabilities.conditionalGet;
+
+  unsupportedNote.hidden = canCreatePasskey;
+  for (const button of [signupForm.querySelector('[type="submit"]'), addPasskeyBtn]) {
+    button.disabled = !canCreatePasskey;
+  }
+  addPasskeyNote.hidden = canCreatePasskey;
+  signinForm.querySelector('[type="submit"]').disabled = !webAuthnAvailable;
+
+  const sessionBody = await readJson(await api.session());
+  currentUser = sessionBody.signedIn ? sessionBody.user : null;
+  render();
+
+  signinForm.addEventListener('submit', signinWithButton);
+  signupForm.addEventListener('submit', signup);
+  profileForm.addEventListener('submit', updateProfile);
+  addPasskeyBtn.addEventListener('click', addPasskey);
+  reauthBtn.addEventListener('click', performReauth);
+  signoutBtn.addEventListener('click', signOut);
+  navLogout.addEventListener('click', async () => {
+    await signOut();
+    accountDialog.showModal();
+  });
+  $('show-signup').addEventListener('click', () => showSignupPanel(true));
+  $('show-signin').addEventListener('click', () => showSignupPanel(false));
+
+  // The native `command` event fires on the dialog before it opens.
+  accountDialog.addEventListener('command', (event) => {
+    if (event.command === 'show-modal') onAccountOpen();
+  });
+  accountDialog.addEventListener('close', () => setStatus());
+
+  if (location.hash === '#account' || location.pathname === '/account') {
+    accountDialog.showModal();
+    onAccountOpen();
+  } else if (currentUser) {
+    // Management page-load sync even when the dialog stays closed.
+    refreshPasskeys();
+  }
+
+  startConditionalSignin();
+}
+
+init();
