+++ b/js/api.js
@@ -0,0 +1,46 @@
+/**
+ * Thin request layer for the account API.
+ *
+ * Every call resolves to a standard `Response`. Today requests are served by
+ * the in-browser mock backend; to use a real server, replace `send()` with:
+ *
+ *   fetch(path, { method, credentials: 'same-origin',
+ *     headers: body ? { 'Content-Type': 'application/json' } : undefined,
+ *     body: body ? JSON.stringify(body) : undefined });
+ */
+import { handle } from './mock-server.js';
+
+function send(method, path, body) {
+  return handle(method, path, body);
+}
+
+export const api = {
+  session: () => send('GET', '/api/session'),
+
+  signupOptions: (profile) => send('POST', '/api/signup/options', profile),
+  signupVerify: (credential) => send('POST', '/api/signup/verify', credential),
+
+  signinOptions: (name) => send('POST', '/api/signin/options', name ? { name } : {}),
+  signinVerify: (credential) => send('POST', '/api/signin/verify', credential),
+  signout: () => send('POST', '/api/signout'),
+
+  reauthOptions: () => send('POST', '/api/reauth/options'),
+  reauthVerify: (credential) => send('POST', '/api/reauth/verify', credential),
+
+  listCredentials: () => send('GET', '/api/credentials'),
+  credentialOptions: (promotion = false) => send('POST', '/api/credentials/options', { promotion }),
+  credentialVerify: (credential) => send('POST', '/api/credentials/verify', credential),
+  renameCredential: (id, name) => send('PUT', `/api/credentials/${encodeURIComponent(id)}`, { name }),
+  deleteCredential: (id) => send('DELETE', `/api/credentials/${encodeURIComponent(id)}`),
+
+  updateUser: (profile) => send('PUT', '/api/user', profile),
+};
+
+/** Read a JSON body, tolerating empty/invalid payloads. */
+export async function readJson(response) {
+  try {
+    return await response.json();
+  } catch {
+    return {};
+  }
+}
