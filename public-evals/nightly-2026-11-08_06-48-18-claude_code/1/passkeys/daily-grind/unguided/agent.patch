index 0000000..69b9f5d
--- /dev/null
+++ b/js/passkeys/encoding.js
@@ -0,0 +1,335 @@
+// Low-level encoding helpers shared by the WebAuthn client and the
+// relying-party verifier: base64url, a minimal CBOR decoder, authenticator
+// data parsing and COSE key -> WebCrypto conversion.
+
+const textEncoder = new TextEncoder();
+const textDecoder = new TextDecoder();
+
+export function utf8Encode(str) {
+  return textEncoder.encode(str);
+}
+
+export function utf8Decode(bytes) {
+  return textDecoder.decode(bytes);
+}
+
+export function toBytes(input) {
+  if (input instanceof Uint8Array) return input;
+  if (input instanceof ArrayBuffer) return new Uint8Array(input);
+  if (ArrayBuffer.isView(input)) {
+    return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+  }
+  throw new TypeError('Expected binary data');
+}
+
+export function bufferToBase64url(input) {
+  const bytes = toBytes(input);
+  let binary = '';
+  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64urlToBytes(str) {
+  if (typeof str !== 'string') throw new TypeError('Expected base64url string');
+  const base64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+}
+
+export function base64urlToBuffer(str) {
+  const bytes = base64urlToBytes(str);
+  return bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
+}
+
+export function randomBytes(length) {
+  const bytes = new Uint8Array(length);
+  crypto.getRandomValues(bytes);
+  return bytes;
+}
+
+export function concatBytes(...parts) {
+  const total = parts.reduce((sum, p) => sum + p.length, 0);
+  const out = new Uint8Array(total);
+  let offset = 0;
+  for (const p of parts) {
+    out.set(p, offset);
+    offset += p.length;
+  }
+  return out;
+}
+
+export function bytesEqual(a, b) {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+}
+
+export async function sha256(data) {
+  return new Uint8Array(await crypto.subtle.digest('SHA-256', toBytes(data)));
+}
+
+/* ------------------------------------------------------------------ */
+/* Minimal CBOR decoder (RFC 8949) – enough for attestation objects    */
+/* and COSE keys.                                                       */
+/* ------------------------------------------------------------------ */
+
+export function decodeCbor(input) {
+  const bytes = toBytes(input);
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  let offset = 0;
+
+  function readLength(additional) {
+    if (additional < 24) return additional;
+    if (additional === 24) return view.getUint8(offset++);
+    if (additional === 25) {
+      const v = view.getUint16(offset);
+      offset += 2;
+      return v;
+    }
+    if (additional === 26) {
+      const v = view.getUint32(offset);
+      offset += 4;
+      return v;
+    }
+    if (additional === 27) {
+      const hi = view.getUint32(offset);
+      const lo = view.getUint32(offset + 4);
+      offset += 8;
+      const v = hi * 2 ** 32 + lo;
+      if (!Number.isSafeInteger(v)) throw new Error('CBOR integer too large');
+      return v;
+    }
+    throw new Error('Unsupported CBOR length encoding');
+  }
+
+  function readItem() {
+    if (offset >= bytes.length) throw new Error('Unexpected end of CBOR data');
+    const initial = view.getUint8(offset++);
+    const major = initial >> 5;
+    const additional = initial & 0x1f;
+
+    switch (major) {
+      case 0:
+        return readLength(additional);
+      case 1:
+        return -1 - readLength(additional);
+      case 2: {
+        const len = readLength(additional);
+        const out = bytes.slice(offset, offset + len);
+        offset += len;
+        return out;
+      }
+      case 3: {
+        const len = readLength(additional);
+        const out = utf8Decode(bytes.subarray(offset, offset + len));
+        offset += len;
+        return out;
+      }
+      case 4: {
+        const len = readLength(additional);
+        const arr = [];
+        for (let i = 0; i < len; i++) arr.push(readItem());
+        return arr;
+      }
+      case 5: {
+        const len = readLength(additional);
+        const map = new Map();
+        for (let i = 0; i < len; i++) {
+          const key = readItem();
+          map.set(key, readItem());
+        }
+        return map;
+      }
+      case 6:
+        readLength(additional); // tag number – ignored
+        return readItem();
+      case 7:
+        if (additional === 20) return false;
+        if (additional === 21) return true;
+        if (additional === 22) return null;
+        if (additional === 23) return undefined;
+        if (additional === 26) {
+          const v = view.getFloat32(offset);
+          offset += 4;
+          return v;
+        }
+        if (additional === 27) {
+          const v = view.getFloat64(offset);
+          offset += 8;
+          return v;
+        }
+        throw new Error('Unsupported CBOR simple value');
+      default:
+        throw new Error('Invalid CBOR major type');
+    }
+  }
+
+  const value = readItem();
+  return { value, bytesRead: offset };
+}
+
+/* ------------------------------------------------------------------ */
+/* Authenticator data                                                   */
+/* ------------------------------------------------------------------ */
+
+export const AuthFlags = Object.freeze({
+  UP: 0x01, // user present
+  UV: 0x04, // user verified
+  BE: 0x08, // backup eligible
+  BS: 0x10, // backup state
+  AT: 0x40, // attested credential data included
+  ED: 0x80, // extension data included
+});
+
+function formatAaguid(bytes) {
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+export function parseAuthenticatorData(input) {
+  const bytes = toBytes(input);
+  if (bytes.length < 37) throw new Error('Authenticator data is too short');
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+
+  const rpIdHash = bytes.slice(0, 32);
+  const flags = bytes[32];
+  const signCount = view.getUint32(33);
+  const result = {
+    rpIdHash,
+    flags,
+    userPresent: Boolean(flags & AuthFlags.UP),
+    userVerified: Boolean(flags & AuthFlags.UV),
+    backupEligible: Boolean(flags & AuthFlags.BE),
+    backedUp: Boolean(flags & AuthFlags.BS),
+    signCount,
+  };
+
+  if (flags & AuthFlags.AT) {
+    let offset = 37;
+    const aaguid = bytes.slice(offset, offset + 16);
+    offset += 16;
+    const credIdLen = view.getUint16(offset);
+    offset += 2;
+    const credentialId = bytes.slice(offset, offset + credIdLen);
+    offset += credIdLen;
+    const { value: coseKey } = decodeCbor(bytes.subarray(offset));
+    result.attestedCredential = {
+      aaguid: formatAaguid(aaguid),
+      credentialId,
+      coseKey,
+    };
+  }
+
+  return result;
+}
+
+/* ------------------------------------------------------------------ */
+/* COSE keys -> WebCrypto                                               */
+/* ------------------------------------------------------------------ */
+
+export const CoseAlg = Object.freeze({ ES256: -7, EdDSA: -8, ES384: -35, ES512: -36, RS256: -257 });
+
+const EC_CURVES = { 1: 'P-256', 2: 'P-384', 3: 'P-521' };
+
+/** Convert a decoded COSE_Key map into a JWK + algorithm descriptor. */
+export function coseKeyToJwk(coseKey) {
+  const kty = coseKey.get(1);
+  const alg = coseKey.get(3);
+
+  if (kty === 2) {
+    const crv = EC_CURVES[coseKey.get(-1)];
+    if (!crv) throw new Error('Unsupported EC curve');
+    return {
+      alg,
+      jwk: {
+        kty: 'EC',
+        crv,
+        x: bufferToBase64url(coseKey.get(-2)),
+        y: bufferToBase64url(coseKey.get(-3)),
+        ext: true,
+      },
+    };
+  }
+
+  if (kty === 3) {
+    return {
+      alg: alg ?? CoseAlg.RS256,
+      jwk: {
+        kty: 'RSA',
+        n: bufferToBase64url(coseKey.get(-1)),
+        e: bufferToBase64url(coseKey.get(-2)),
+        ext: true,
+      },
+    };
+  }
+
+  if (kty === 1 && coseKey.get(-1) === 6) {
+    return {
+      alg: alg ?? CoseAlg.EdDSA,
+      jwk: { kty: 'OKP', crv: 'Ed25519', x: bufferToBase64url(coseKey.get(-2)), ext: true },
+    };
+  }
+
+  throw new Error('Unsupported credential public key type');
+}
+
+function ecCoordinateLength(crv) {
+  return { 'P-256': 32, 'P-384': 48, 'P-521': 66 }[crv];
+}
+
+/** WebAuthn ECDSA signatures are ASN.1 DER; WebCrypto wants raw r||s. */
+function derToRawEcdsa(der, size) {
+  let offset = 0;
+  if (der[offset++] !== 0x30) throw new Error('Invalid ECDSA signature');
+  let seqLen = der[offset++];
+  if (seqLen & 0x80) offset += seqLen & 0x7f; // long-form length
+
+  function readInt() {
+    if (der[offset++] !== 0x02) throw new Error('Invalid ECDSA signature');
+    const len = der[offset++];
+    let int = der.subarray(offset, offset + len);
+    offset += len;
+    while (int.length > size && int[0] === 0) int = int.subarray(1);
+    if (int.length > size) throw new Error('Invalid ECDSA signature');
+    const out = new Uint8Array(size);
+    out.set(int, size - int.length);
+    return out;
+  }
+
+  return concatBytes(readInt(), readInt());
+}
+
+export async function verifySignature({ jwk, alg }, signature, data) {
+  const sig = toBytes(signature);
+  const msg = toBytes(data);
+
+  if (jwk.kty === 'EC') {
+    const hash = { 'P-256': 'SHA-256', 'P-384': 'SHA-384', 'P-521': 'SHA-512' }[jwk.crv];
+    const key = await crypto.subtle.importKey('jwk', jwk, { name: 'ECDSA', namedCurve: jwk.crv }, false, ['verify']);
+    const raw = derToRawEcdsa(sig, ecCoordinateLength(jwk.crv));
+    return crypto.subtle.verify({ name: 'ECDSA', hash }, key, raw, msg);
+  }
+
+  if (jwk.kty === 'RSA') {
+    if (alg !== CoseAlg.RS256) throw new Error('Unsupported RSA algorithm');
+    const key = await crypto.subtle.importKey(
+      'jwk',
+      jwk,
+      { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' },
+      false,
+      ['verify'],
+    );
+    return crypto.subtle.verify('RSASSA-PKCS1-v1_5', key, sig, msg);
+  }
+
+  if (jwk.kty === 'OKP') {
+    const key = await crypto.subtle.importKey('jwk', jwk, { name: 'Ed25519' }, false, ['verify']);
+    return crypto.subtle.verify('Ed25519', key, sig, msg);
+  }
+
+  throw new Error('Unsupported key type');
+}
diff --git a/js/passkeys/relying-party.js b/js/passkeys/relying-party.js
new file mode 100644
index 0000000..1f3aa3b
--- /dev/null
+++ b/js/passkeys/relying-party.js
@@ -0,0 +1,632 @@
+// Relying-party ("server") logic for The Daily Grind customer accounts.
+//
+// The Daily Grind homepage is a static site, so this module plays the role
+// of the account backend: it issues single-use challenges, verifies
+// WebAuthn registration/authentication responses (origin, RP ID hash,
+// user presence/verification, signature, sign counter) with WebCrypto, and
+// persists users, credentials and the session in localStorage.
+//
+// Every public method takes and returns plain JSON so it maps 1:1 onto
+// HTTP endpoints. To move to a real backend, replace the calls in
+// account-service.js with fetch() calls and run this same logic server-side
+// (e.g. with SimpleWebAuthn / py_webauthn / webauthn4j).
+
+import {
+  base64urlToBytes,
+  bufferToBase64url,
+  bytesEqual,
+  concatBytes,
+  coseKeyToJwk,
+  decodeCbor,
+  parseAuthenticatorData,
+  randomBytes,
+  sha256,
+  utf8Decode,
+  utf8Encode,
+  verifySignature,
+} from './encoding.js';
+
+const STORAGE_KEY = 'dailygrind.accounts.v1';
+const SESSION_KEY = 'dailygrind.session.v1';
+const CHALLENGE_KEY = 'dailygrind.challenges.v1';
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+const CEREMONY_TIMEOUT_MS = 5 * 60 * 1000;
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+const SESSION_TTL_MS = 30 * 24 * 60 * 60 * 1000;
+
+// Friendly names for common passkey providers (from the community
+// passkey-authenticator-aaguids list).
+const KNOWN_AAGUIDS = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+};
+
+export class AccountError extends Error {
+  constructor(message, { code = 'bad-request', status = 400 } = {}) {
+    super(message);
+    this.name = 'AccountError';
+    this.code = code;
+    this.status = status;
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Persistence                                                          */
+/* ------------------------------------------------------------------ */
+
+function readJSON(storage, key, fallback) {
+  try {
+    const raw = storage.getItem(key);
+    return raw ? JSON.parse(raw) : fallback;
+  } catch {
+    return fallback;
+  }
+}
+
+function writeJSON(storage, key, value) {
+  storage.setItem(key, JSON.stringify(value));
+}
+
+function loadDb() {
+  const db = readJSON(localStorage, STORAGE_KEY, null);
+  if (db && Array.isArray(db.users) && Array.isArray(db.credentials)) return db;
+  return { users: [], credentials: [] };
+}
+
+function saveDb(db) {
+  writeJSON(localStorage, STORAGE_KEY, db);
+}
+
+function normalizeEmail(email) {
+  return String(email || '').trim().toLowerCase();
+}
+
+function validateProfile({ email, displayName }) {
+  const cleanEmail = normalizeEmail(email);
+  const cleanName = String(displayName || '').trim().replace(/\s+/g, ' ');
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail) || cleanEmail.length > 254) {
+    throw new AccountError('Please enter a valid email address.', { code: 'invalid-email' });
+  }
+  if (cleanName.length < 1 || cleanName.length > 64) {
+    throw new AccountError('Please enter a name between 1 and 64 characters.', { code: 'invalid-name' });
+  }
+  return { email: cleanEmail, displayName: cleanName };
+}
+
+/* ------------------------------------------------------------------ */
+/* Challenges (single use, short lived)                                 */
+/* ------------------------------------------------------------------ */
+
+function storeChallenge(record) {
+  const now = Date.now();
+  const all = readJSON(sessionStorage, CHALLENGE_KEY, {});
+  for (const [k, v] of Object.entries(all)) if (v.expiresAt < now) delete all[k];
+  const challenge = bufferToBase64url(randomBytes(32));
+  all[challenge] = { ...record, expiresAt: now + CHALLENGE_TTL_MS };
+  writeJSON(sessionStorage, CHALLENGE_KEY, all);
+  return challenge;
+}
+
+function consumeChallenge(challenge, expectedPurpose) {
+  const all = readJSON(sessionStorage, CHALLENGE_KEY, {});
+  const record = all[challenge];
+  if (record) {
+    delete all[challenge];
+    writeJSON(sessionStorage, CHALLENGE_KEY, all);
+  }
+  if (!record || record.expiresAt < Date.now() || record.purpose !== expectedPurpose) {
+    throw new AccountError('This request has expired. Please try again.', { code: 'invalid-challenge' });
+  }
+  return record;
+}
+
+/* ------------------------------------------------------------------ */
+/* Session                                                              */
+/* ------------------------------------------------------------------ */
+
+function readSession() {
+  const session = readJSON(localStorage, SESSION_KEY, null);
+  if (!session) return null;
+  if (session.expiresAt < Date.now()) {
+    localStorage.removeItem(SESSION_KEY);
+    return null;
+  }
+  return session;
+}
+
+function startSession(userId, credentialId) {
+  const now = Date.now();
+  const session = {
+    userId,
+    credentialId,
+    authenticatedAt: now,
+    lastVerifiedAt: now,
+    expiresAt: now + SESSION_TTL_MS,
+  };
+  writeJSON(localStorage, SESSION_KEY, session);
+  return session;
+}
+
+function requireSession(db) {
+  const session = readSession();
+  const user = session && db.users.find((u) => u.id === session.userId);
+  if (!user) {
+    localStorage.removeItem(SESSION_KEY);
+    throw new AccountError('Please sign in to continue.', { code: 'unauthenticated', status: 401 });
+  }
+  return { session, user };
+}
+
+function requireRecentVerification(session) {
+  if (Date.now() - session.lastVerifiedAt > REAUTH_WINDOW_MS) {
+    throw new AccountError('Please confirm it’s you with your passkey to continue.', {
+      code: 'reauth-required',
+      status: 403,
+    });
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Response verification                                                */
+/* ------------------------------------------------------------------ */
+
+function rpId() {
+  return location.hostname;
+}
+
+function expectedOrigin() {
+  return location.origin;
+}
+
+/** Read clientDataJSON just far enough to look up the pending challenge. */
+function peekClientData(response) {
+  try {
+    const clientData = JSON.parse(utf8Decode(base64urlToBytes(response.response.clientDataJSON)));
+    if (typeof clientData?.challenge === 'string') return clientData;
+  } catch {
+    /* handled below */
+  }
+  throw new AccountError('Malformed passkey response.', { code: 'invalid-response' });
+}
+
+function parseClientData(b64, expectedType) {
+  let clientData;
+  try {
+    clientData = JSON.parse(utf8Decode(base64urlToBytes(b64)));
+  } catch {
+    throw new AccountError('Malformed passkey response.', { code: 'invalid-response' });
+  }
+  if (clientData.type !== expectedType) {
+    throw new AccountError('Unexpected passkey response type.', { code: 'invalid-response' });
+  }
+  if (clientData.origin !== expectedOrigin()) {
+    throw new AccountError('Passkey response came from an unexpected origin.', { code: 'invalid-origin' });
+  }
+  if (clientData.crossOrigin === true) {
+    throw new AccountError('Cross-origin passkey requests are not allowed.', { code: 'invalid-origin' });
+  }
+  return clientData;
+}
+
+async function checkAuthData(authData, { requireUV }) {
+  const expectedHash = await sha256(utf8Encode(rpId()));
+  if (!bytesEqual(authData.rpIdHash, expectedHash)) {
+    throw new AccountError('Passkey was created for a different website.', { code: 'invalid-rp' });
+  }
+  if (!authData.userPresent) {
+    throw new AccountError('User presence was not confirmed.', { code: 'user-not-present' });
+  }
+  if (requireUV && !authData.userVerified) {
+    throw new AccountError('Your device did not verify your identity (PIN, fingerprint or face).', {
+      code: 'user-not-verified',
+    });
+  }
+}
+
+async function verifyRegistrationResponse(response, challengeRecord) {
+  if (response?.type !== 'public-key' || !response.response?.attestationObject) {
+    throw new AccountError('Malformed passkey response.', { code: 'invalid-response' });
+  }
+  const clientData = parseClientData(response.response.clientDataJSON, 'webauthn.create');
+  if (clientData.challenge !== challengeRecord.challenge) {
+    throw new AccountError('This request has expired. Please try again.', { code: 'invalid-challenge' });
+  }
+
+  const { value: attestation } = decodeCbor(base64urlToBytes(response.response.attestationObject));
+  const authData = parseAuthenticatorData(attestation.get('authData'));
+  await checkAuthData(authData, { requireUV: true });
+
+  if (!authData.attestedCredential) {
+    throw new AccountError('The passkey did not include a public key.', { code: 'invalid-response' });
+  }
+  const { credentialId, coseKey, aaguid } = authData.attestedCredential;
+  const credentialIdB64 = bufferToBase64url(credentialId);
+  if (credentialIdB64 !== response.rawId || credentialId.length > 1023) {
+    throw new AccountError('Passkey ID mismatch.', { code: 'invalid-response' });
+  }
+
+  // attestation: 'none' was requested – we trust the key, not the device model.
+  const publicKey = coseKeyToJwk(coseKey);
+
+  return {
+    id: credentialIdB64,
+    publicKey,
+    signCount: authData.signCount,
+    aaguid,
+    transports: Array.isArray(response.response.transports) ? response.response.transports : [],
+    backupEligible: authData.backupEligible,
+    backedUp: authData.backedUp,
+    authenticatorAttachment: response.authenticatorAttachment || null,
+  };
+}
+
+async function verifyAuthenticationResponse(response, challengeRecord, credential) {
+  const r = response?.response;
+  if (response?.type !== 'public-key' || !r?.authenticatorData || !r?.signature) {
+    throw new AccountError('Malformed passkey response.', { code: 'invalid-response' });
+  }
+  const clientData = parseClientData(r.clientDataJSON, 'webauthn.get');
+  if (clientData.challenge !== challengeRecord.challenge) {
+    throw new AccountError('This request has expired. Please try again.', { code: 'invalid-challenge' });
+  }
+
+  const authDataBytes = base64urlToBytes(r.authenticatorData);
+  const authData = parseAuthenticatorData(authDataBytes);
+  await checkAuthData(authData, { requireUV: true });
+
+  const clientDataHash = await sha256(base64urlToBytes(r.clientDataJSON));
+  const valid = await verifySignature(
+    credential.publicKey,
+    base64urlToBytes(r.signature),
+    concatBytes(authDataBytes, clientDataHash),
+  );
+  if (!valid) {
+    throw new AccountError('Passkey signature could not be verified.', { code: 'invalid-signature' });
+  }
+
+  // Sign counter: if both sides use counters, a non-increasing value hints at a cloned key.
+  if ((authData.signCount > 0 || credential.signCount > 0) && authData.signCount <= credential.signCount) {
+    throw new AccountError('This passkey appears to have been cloned and was rejected.', { code: 'counter' });
+  }
+
+  return authData;
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                           */
+/* ------------------------------------------------------------------ */
+
+function publicUser(user) {
+  return {
+    id: user.id,
+    email: user.email,
+    displayName: user.displayName,
+    createdAt: user.createdAt,
+  };
+}
+
+function publicCredential(c, currentCredentialId) {
+  return {
+    id: c.id,
+    name: c.name,
+    provider: KNOWN_AAGUIDS[c.aaguid] || null,
+    createdAt: c.createdAt,
+    lastUsedAt: c.lastUsedAt,
+    backedUp: c.backedUp,
+    backupEligible: c.backupEligible,
+    transports: c.transports,
+    isCurrent: c.id === currentCredentialId,
+  };
+}
+
+function defaultPasskeyName(aaguid, existing) {
+  const base = KNOWN_AAGUIDS[aaguid] || 'Passkey';
+  const taken = new Set(existing.map((c) => c.name));
+  if (!taken.has(base)) return base;
+  let i = 2;
+  while (taken.has(`${base} (${i})`)) i++;
+  return `${base} (${i})`;
+}
+
+function creationOptions({ challenge, user, excludeCredentials }) {
+  return {
+    challenge,
+    rp: { id: rpId(), name: 'The Daily Grind' },
+    user: { id: user.id, name: user.email, displayName: user.displayName },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -8 }, // EdDSA
+      { type: 'public-key', alg: -7 }, // ES256
+      { type: 'public-key', alg: -257 }, // RS256
+    ],
+    timeout: CEREMONY_TIMEOUT_MS,
+    attestation: 'none',
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'required',
+    },
+    excludeCredentials: excludeCredentials.map((c) => ({
+      type: 'public-key',
+      id: c.id,
+      transports: c.transports,
+    })),
+    hints: [],
+    extensions: { credProps: true },
+  };
+}
+
+export const relyingParty = {
+  rpId,
+
+  /** GET /api/session */
+  async getSession() {
+    const db = loadDb();
+    const session = readSession();
+    const user = session && db.users.find((u) => u.id === session.userId);
+    if (!user) return null;
+    return {
+      user: publicUser(user),
+      authenticatedAt: session.authenticatedAt,
+      lastVerifiedAt: session.lastVerifiedAt,
+      reauthWindowMs: REAUTH_WINDOW_MS,
+    };
+  },
+
+  /** POST /api/register/options – new customer sign-up. */
+  async startRegistration({ email, displayName }) {
+    const profile = validateProfile({ email, displayName });
+    const db = loadDb();
+    if (db.users.some((u) => u.email === profile.email)) {
+      throw new AccountError('An account with this email already exists. Sign in with your passkey instead.', {
+        code: 'email-taken',
+        status: 409,
+      });
+    }
+    // Random, opaque user handle – never put personal data in user.id.
+    const pendingUser = { id: bufferToBase64url(randomBytes(32)), ...profile };
+    const challenge = storeChallenge({ purpose: 'register', pendingUser });
+    return creationOptions({ challenge, user: pendingUser, excludeCredentials: [] });
+  },
+
+  /** POST /api/register/verify */
+  async finishRegistration(response) {
+    const clientData = peekClientData(response);
+    const record = consumeChallenge(clientData.challenge, 'register');
+    const verified = await verifyRegistrationResponse(response, { ...record, challenge: clientData.challenge });
+
+    const db = loadDb();
+    if (db.users.some((u) => u.email === record.pendingUser.email)) {
+      throw new AccountError('An account with this email already exists.', { code: 'email-taken', status: 409 });
+    }
+    if (db.credentials.some((c) => c.id === verified.id)) {
+      throw new AccountError('This passkey is already registered.', { code: 'duplicate-credential', status: 409 });
+    }
+
+    const now = Date.now();
+    const user = { ...record.pendingUser, createdAt: now, updatedAt: now };
+    db.users.push(user);
+    db.credentials.push({
+      ...verified,
+      userId: user.id,
+      name: defaultPasskeyName(verified.aaguid, []),
+      createdAt: now,
+      lastUsedAt: now,
+    });
+    saveDb(db);
+    startSession(user.id, verified.id);
+    return { user: publicUser(user) };
+  },
+
+  /** POST /api/passkeys/options – add another passkey to the signed-in account. */
+  async startAddPasskey() {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    requireRecentVerification(session);
+    const existing = db.credentials.filter((c) => c.userId === user.id);
+    const challenge = storeChallenge({ purpose: 'add-passkey', userId: user.id });
+    return creationOptions({ challenge, user, excludeCredentials: existing });
+  },
+
+  /** POST /api/passkeys/verify */
+  async finishAddPasskey(response) {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    const clientData = peekClientData(response);
+    const record = consumeChallenge(clientData.challenge, 'add-passkey');
+    if (record.userId !== user.id) {
+      throw new AccountError('Session changed. Please try again.', { code: 'invalid-challenge' });
+    }
+    requireRecentVerification(session);
+    const verified = await verifyRegistrationResponse(response, { ...record, challenge: clientData.challenge });
+    if (db.credentials.some((c) => c.id === verified.id)) {
+      throw new AccountError('This passkey is already registered.', { code: 'duplicate-credential', status: 409 });
+    }
+    const existing = db.credentials.filter((c) => c.userId === user.id);
+    const now = Date.now();
+    const credential = {
+      ...verified,
+      userId: user.id,
+      name: defaultPasskeyName(verified.aaguid, existing),
+      createdAt: now,
+      lastUsedAt: null,
+    };
+    db.credentials.push(credential);
+    saveDb(db);
+    return { passkey: publicCredential(credential, session.credentialId) };
+  },
+
+  /**
+   * POST /api/authenticate/options
+   * purpose: 'signin' (discoverable, any account) or 'reauth' (current account only).
+   */
+  async startAuthentication({ purpose = 'signin' } = {}) {
+    const db = loadDb();
+    let allowCredentials = [];
+    let userId = null;
+    if (purpose === 'reauth') {
+      const { user } = requireSession(db);
+      userId = user.id;
+      allowCredentials = db.credentials
+        .filter((c) => c.userId === user.id)
+        .map((c) => ({ type: 'public-key', id: c.id, transports: c.transports }));
+    } else if (purpose !== 'signin') {
+      throw new AccountError('Unknown authentication purpose.');
+    }
+    const challenge = storeChallenge({ purpose, userId });
+    return {
+      challenge,
+      rpId: rpId(),
+      timeout: CEREMONY_TIMEOUT_MS,
+      userVerification: 'required',
+      allowCredentials,
+    };
+  },
+
+  /** POST /api/authenticate/verify */
+  async finishAuthentication(response, { purpose = 'signin' } = {}) {
+    const clientData = peekClientData(response);
+    const record = consumeChallenge(clientData.challenge, purpose);
+
+    const db = loadDb();
+    const credential = db.credentials.find((c) => c.id === response.rawId);
+    if (!credential) {
+      const err = new AccountError(
+        'This passkey isn’t linked to a Daily Grind account. It may have been removed — try another passkey or create an account.',
+        { code: 'unknown-credential', status: 404 },
+      );
+      err.credentialId = response.rawId;
+      throw err;
+    }
+    if (response.response.userHandle && response.response.userHandle !== credential.userId) {
+      throw new AccountError('Passkey does not match this account.', { code: 'user-mismatch', status: 401 });
+    }
+    if (purpose === 'reauth') {
+      const { user } = requireSession(db);
+      if (record.userId !== user.id || credential.userId !== user.id) {
+        throw new AccountError('Please use a passkey for the account you’re signed in to.', {
+          code: 'user-mismatch',
+          status: 401,
+        });
+      }
+    }
+
+    const authData = await verifyAuthenticationResponse(
+      response,
+      { ...record, challenge: clientData.challenge },
+      credential,
+    );
+
+    credential.signCount = authData.signCount;
+    credential.backedUp = authData.backedUp;
+    credential.lastUsedAt = Date.now();
+    saveDb(db);
+
+    const user = db.users.find((u) => u.id === credential.userId);
+    if (purpose === 'reauth') {
+      const session = readSession();
+      session.lastVerifiedAt = Date.now();
+      session.credentialId = credential.id;
+      writeJSON(localStorage, SESSION_KEY, session);
+    } else {
+      startSession(user.id, credential.id);
+    }
+    return { user: publicUser(user) };
+  },
+
+  /** POST /api/logout */
+  async signOut() {
+    localStorage.removeItem(SESSION_KEY);
+  },
+
+  /** GET /api/passkeys */
+  async listPasskeys() {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    return db.credentials
+      .filter((c) => c.userId === user.id)
+      .sort((a, b) => a.createdAt - b.createdAt)
+      .map((c) => publicCredential(c, session.credentialId));
+  },
+
+  /** PATCH /api/passkeys/:id */
+  async renamePasskey(id, name) {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    const credential = db.credentials.find((c) => c.id === id && c.userId === user.id);
+    if (!credential) throw new AccountError('Passkey not found.', { code: 'not-found', status: 404 });
+    const clean = String(name || '').trim().replace(/\s+/g, ' ');
+    if (clean.length < 1 || clean.length > 48) {
+      throw new AccountError('Passkey names must be 1–48 characters.', { code: 'invalid-name' });
+    }
+    credential.name = clean;
+    saveDb(db);
+    return publicCredential(credential, session.credentialId);
+  },
+
+  /** DELETE /api/passkeys/:id – requires recent verification. */
+  async deletePasskey(id) {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    requireRecentVerification(session);
+    const owned = db.credentials.filter((c) => c.userId === user.id);
+    if (!owned.some((c) => c.id === id)) {
+      throw new AccountError('Passkey not found.', { code: 'not-found', status: 404 });
+    }
+    if (owned.length <= 1) {
+      throw new AccountError(
+        'You can’t remove your only passkey — you’d be locked out. Add another passkey first.',
+        { code: 'last-credential', status: 409 },
+      );
+    }
+    db.credentials = db.credentials.filter((c) => c.id !== id);
+    saveDb(db);
+    return { remainingIds: owned.filter((c) => c.id !== id).map((c) => c.id) };
+  },
+
+  /** PATCH /api/profile – email changes require recent verification. */
+  async updateProfile({ email, displayName }) {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    const profile = validateProfile({ email, displayName });
+    if (profile.email !== user.email) {
+      requireRecentVerification(session);
+      if (db.users.some((u) => u.id !== user.id && u.email === profile.email)) {
+        throw new AccountError('That email is already used by another account.', { code: 'email-taken', status: 409 });
+      }
+    }
+    user.email = profile.email;
+    user.displayName = profile.displayName;
+    user.updatedAt = Date.now();
+    saveDb(db);
+    return { user: publicUser(user) };
+  },
+
+  /** DELETE /api/account – requires recent verification. */
+  async deleteAccount() {
+    const db = loadDb();
+    const { session, user } = requireSession(db);
+    requireRecentVerification(session);
+    const removedIds = db.credentials.filter((c) => c.userId === user.id).map((c) => c.id);
+    db.users = db.users.filter((u) => u.id !== user.id);
+    db.credentials = db.credentials.filter((c) => c.userId !== user.id);
+    saveDb(db);
+    localStorage.removeItem(SESSION_KEY);
+    return { userId: user.id, removedIds };
+  },
+};
