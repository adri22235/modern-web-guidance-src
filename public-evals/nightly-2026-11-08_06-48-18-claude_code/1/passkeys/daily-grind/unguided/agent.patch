+// "My Account" UI for The Daily Grind: passkey sign-up, sign-in (button +
+// autofill), saved passkey management, profile updates and re-verification.
+
+import { AccountError, PasskeyError, accountService } from './passkeys/account-service.js';
+import { isConditionalMediationAvailable, isWebAuthnSupported } from './passkeys/webauthn-client.js';
+
+const $ = (id) => document.getElementById(id);
+
+const els = {
+  dialog: $('account-dialog'),
+  close: $('account-close'),
+  title: $('account-title'),
+  subtitle: $('account-subtitle'),
+  status: $('account-status'),
+  unsupported: $('unsupported-notice'),
+  signedOut: $('signed-out-view'),
+  signedIn: $('signed-in-view'),
+  tabSignin: $('tab-signin'),
+  tabRegister: $('tab-register'),
+  panelSignin: $('panel-signin'),
+  panelRegister: $('panel-register'),
+  signinForm: $('signin-form'),
+  signinButton: $('signin-button'),
+  signinEmail: $('signin-email'),
+  gotoRegister: $('goto-register'),
+  registerForm: $('register-form'),
+  registerButton: $('register-button'),
+  registerName: $('register-name'),
+  registerEmail: $('register-email'),
+  profileForm: $('profile-form'),
+  profileName: $('profile-name'),
+  profileEmail: $('profile-email'),
+  profileSave: $('profile-save'),
+  addPasskey: $('add-passkey'),
+  passkeyList: $('passkey-list'),
+  passkeyTemplate: $('passkey-item-template'),
+  verifyStatus: $('verify-status'),
+  verifyNow: $('verify-now'),
+  deleteAccount: $('delete-account'),
+  signout: $('signout-button'),
+  accountLink: $('account-link'),
+  logoutLink: $('logout-link'),
+  navGreeting: $('nav-greeting'),
+  confirm: $('confirm-dialog'),
+  confirmTitle: $('confirm-title'),
+  confirmMessage: $('confirm-message'),
+  confirmOk: $('confirm-ok'),
+};
+
+const state = {
+  session: null,
+  supported: isWebAuthnSupported(),
+  verifyTimer: null,
+};
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                              */
+/* ------------------------------------------------------------------ */
+
+function showStatus(message, type = 'info') {
+  els.status.textContent = message;
+  els.status.className = `status ${type}`;
+  els.status.hidden = !message;
+}
+
+function clearStatus() {
+  showStatus('');
+}
+
+function showError(err) {
+  if (err instanceof PasskeyError && (err.code === 'cancelled' || err.code === 'aborted')) {
+    showStatus(err.message, 'info');
+    return;
+  }
+  if (err instanceof AccountError || err instanceof PasskeyError) {
+    showStatus(err.message, 'error');
+    if (err.code === 'unauthenticated') refresh();
+    return;
+  }
+  console.error(err);
+  showStatus('Something went wrong. Please try again.', 'error');
+}
+
+async function busy(button, task) {
+  const buttons = els.dialog.querySelectorAll('button');
+  const label = button?.querySelector('span') || button;
+  const original = label?.textContent;
+  buttons.forEach((b) => (b.disabled = true));
+  if (button && label) label.textContent = 'Waiting for your passkey…';
+  try {
+    return await task();
+  } finally {
+    buttons.forEach((b) => (b.disabled = false));
+    if (button && label) label.textContent = original;
+  }
+}
+
+function formatDate(ts) {
+  if (!ts) return 'never';
+  return new Date(ts).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+}
+
+function formatRelative(ts) {
+  if (!ts) return 'never';
+  const diff = Date.now() - ts;
+  const minutes = Math.round(diff / 60000);
+  if (minutes < 1) return 'just now';
+  if (minutes < 60) return `${minutes} min ago`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 24) return `${hours} hr ago`;
+  return formatDate(ts);
+}
+
+/** Promise-based confirmation dialog. */
+function confirmDialog({ title, message, confirmLabel = 'Continue', danger = false }) {
+  return new Promise((resolve) => {
+    els.confirmTitle.textContent = title;
+    els.confirmMessage.textContent = message;
+    els.confirmOk.textContent = confirmLabel;
+    els.confirmOk.classList.toggle('btn-danger', danger);
+    els.confirm.returnValue = '';
+    els.confirm.addEventListener('close', () => resolve(els.confirm.returnValue === 'confirm'), { once: true });
+    els.confirm.showModal();
+    els.confirmOk.focus();
+  });
+}
+
+const confirmReauth = (action) => () =>
+  confirmDialog({
+    title: 'Confirm it’s you',
+    message: `To ${action}, please verify with one of your saved passkeys.`,
+    confirmLabel: 'Verify with passkey',
+  });
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                            */
+/* ------------------------------------------------------------------ */
+
+function renderNav() {
+  const user = state.session?.user;
+  els.navGreeting.hidden = !user;
+  els.navGreeting.textContent = user ? `Hi, ${user.displayName.split(' ')[0]}` : '';
+  els.logoutLink.hidden = !user;
+}
+
+function selectTab(which) {
+  const signin = which === 'signin';
+  els.tabSignin.setAttribute('aria-selected', String(signin));
+  els.tabRegister.setAttribute('aria-selected', String(!signin));
+  els.tabSignin.tabIndex = signin ? 0 : -1;
+  els.tabRegister.tabIndex = signin ? -1 : 0;
+  els.panelSignin.hidden = !signin;
+  els.panelRegister.hidden = signin;
+  els.subtitle.textContent = signin
+    ? 'Sign in with a passkey — no password needed.'
+    : 'Join in seconds and start earning rewards.';
+  if (signin) startAutofill();
+  else accountService.stopAutofillSignIn();
+}
+
+function renderVerifyStatus() {
+  const s = state.session;
+  if (!s) return;
+  const fresh = Date.now() - s.lastVerifiedAt < s.reauthWindowMs;
+  els.verifyStatus.textContent = fresh
+    ? `✓ Verified ${formatRelative(s.lastVerifiedAt)}`
+    : `Last verified ${formatRelative(s.lastVerifiedAt)}`;
+}
+
+function renderPasskeys(passkeys) {
+  els.passkeyList.replaceChildren();
+  for (const pk of passkeys) {
+    const item = els.passkeyTemplate.content.firstElementChild.cloneNode(true);
+    item.dataset.id = pk.id;
+
+    const name = item.querySelector('.passkey-name');
+    name.textContent = pk.name;
+    if (pk.isCurrent) {
+      const badge = document.createElement('span');
+      badge.className = 'badge current';
+      badge.textContent = 'Used this session';
+      name.append(badge);
+    }
+    if (pk.backedUp) {
+      const badge = document.createElement('span');
+      badge.className = 'badge';
+      badge.textContent = 'Synced';
+      badge.title = 'Backed up and available on your other devices';
+      name.append(badge);
+    }
+
+    const meta = [];
+    if (pk.provider && pk.provider !== pk.name) meta.push(pk.provider);
+    meta.push(`Added ${formatDate(pk.createdAt)}`);
+    meta.push(`Last used ${formatRelative(pk.lastUsedAt)}`);
+    item.querySelector('.passkey-meta').textContent = meta.join(' · ');
+
+    const removeBtn = item.querySelector('[data-action="delete"]');
+    if (passkeys.length <= 1) {
+      removeBtn.disabled = true;
+      removeBtn.title = 'Add another passkey before removing your only one';
+    }
+
+    els.passkeyList.append(item);
+  }
+}
+
+async function loadPasskeys() {
+  try {
+    renderPasskeys(await accountService.listPasskeys());
+  } catch (err) {
+    showError(err);
+  }
+}
+
+async function refresh() {
+  state.session = await accountService.getSession();
+  renderNav();
+
+  const user = state.session?.user;
+  els.unsupported.hidden = state.supported;
+  els.signedOut.hidden = Boolean(user);
+  els.signedIn.hidden = !user;
+  clearInterval(state.verifyTimer);
+
+  if (user) {
+    accountService.stopAutofillSignIn();
+    els.title.textContent = `Welcome back, ${user.displayName}`;
+    els.subtitle.textContent = `${user.email} · Member since ${formatDate(user.createdAt)}`;
+    els.profileName.value = user.displayName;
+    els.profileEmail.value = user.email;
+    renderVerifyStatus();
+    state.verifyTimer = setInterval(renderVerifyStatus, 30000);
+    await loadPasskeys();
+  } else {
+    els.title.textContent = 'My Account';
+    selectTab(els.tabRegister.getAttribute('aria-selected') === 'true' ? 'register' : 'signin');
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Passkey autofill (conditional mediation)                             */
+/* ------------------------------------------------------------------ */
+
+async function startAutofill() {
+  if (!els.dialog.open || state.session || !(await isConditionalMediationAvailable())) return;
+  try {
+    const result = await accountService.startAutofillSignIn();
+    if (result) await onSignedIn(result.user);
+  } catch (err) {
+    showError(err);
+    // The customer picked a passkey the server rejected – re-arm autofill so they can try another.
+    if (err instanceof AccountError && !state.session && els.dialog.open) setTimeout(startAutofill, 0);
+  }
+}
+
+async function onSignedIn(user, message) {
+  els.signinForm.reset();
+  els.registerForm.reset();
+  await refresh();
+  showStatus(message || `Welcome back, ${user.displayName}! You’re signed in.`, 'success');
+}
+
+/* ------------------------------------------------------------------ */
+/* Dialog open / close                                                  */
+/* ------------------------------------------------------------------ */
+
+async function openAccount() {
+  clearStatus();
+  if (!els.dialog.open) els.dialog.showModal();
+  await refresh();
+  if (!state.session) {
+    (els.panelSignin.hidden ? els.registerName : els.signinButton).focus();
+  }
+}
+
+function closeAccount() {
+  els.dialog.close();
+}
+
+els.dialog.addEventListener('close', () => {
+  accountService.stopAutofillSignIn();
+  clearInterval(state.verifyTimer);
+  if (location.hash === '#account') {
+    history.replaceState(null, '', location.pathname + location.search);
+  }
+});
+
+els.dialog.addEventListener('click', (e) => {
+  if (e.target === els.dialog) closeAccount(); // backdrop click
+});
+
+els.close.addEventListener('click', closeAccount);
+
+els.accountLink.addEventListener('click', (e) => {
+  e.preventDefault();
+  history.replaceState(null, '', '#account');
+  openAccount();
+});
+
+window.addEventListener('hashchange', () => {
+  if (location.hash === '#account') openAccount();
+});
+
+/* ------------------------------------------------------------------ */
+/* Signed-out actions                                                   */
+/* ------------------------------------------------------------------ */
+
+els.tabSignin.addEventListener('click', () => {
+  clearStatus();
+  selectTab('signin');
+});
+els.tabRegister.addEventListener('click', () => {
+  clearStatus();
+  selectTab('register');
+});
+els.gotoRegister.addEventListener('click', () => {
+  clearStatus();
+  const email = els.signinEmail.value.trim();
+  selectTab('register');
+  if (email && !els.registerEmail.value) els.registerEmail.value = email;
+  els.registerName.focus();
+});
+
+// Arrow-key navigation between tabs.
+for (const tab of [els.tabSignin, els.tabRegister]) {
+  tab.addEventListener('keydown', (e) => {
+    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
+    const next = tab === els.tabSignin ? els.tabRegister : els.tabSignin;
+    next.click();
+    next.focus();
+  });
+}
+
+els.signinForm.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  clearStatus();
+  if (!state.supported) return showStatus('Passkeys aren’t supported in this browser.', 'error');
+  try {
+    const { user } = await busy(els.signinButton, () => accountService.signIn());
+    await onSignedIn(user);
+  } catch (err) {
+    showError(err);
+    startAutofill();
+  }
+});
+
+els.registerForm.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  clearStatus();
+  if (!els.registerForm.reportValidity()) return;
+  if (!state.supported) return showStatus('Passkeys aren’t supported in this browser.', 'error');
+  try {
+    const { user } = await busy(els.registerButton, () =>
+      accountService.register({ displayName: els.registerName.value, email: els.registerEmail.value }),
+    );
+    await onSignedIn(user, `Welcome to The Daily Grind, ${user.displayName}! Your passkey is saved.`);
+  } catch (err) {
+    showError(err);
+    if (err instanceof AccountError && err.code === 'email-taken') {
+      els.signinEmail.value = els.registerEmail.value.trim();
+    }
+  }
+});
+
+/* ------------------------------------------------------------------ */
+/* Signed-in actions                                                    */
+/* ------------------------------------------------------------------ */
+
+els.profileForm.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  clearStatus();
+  if (!els.profileForm.reportValidity()) return;
+  const profile = { displayName: els.profileName.value, email: els.profileEmail.value };
+  try {
+    await busy(null, () => accountService.updateProfile(profile, confirmReauth('change your email')));
+    await refresh();
+    showStatus('Your profile has been updated.', 'success');
+  } catch (err) {
+    showError(err);
+  }
+});
+
+els.addPasskey.addEventListener('click', async () => {
+  clearStatus();
+  if (!state.supported) return showStatus('Passkeys aren’t supported in this browser.', 'error');
+  try {
+    const { passkey } = await busy(els.addPasskey, () =>
+      accountService.addPasskey(confirmReauth('add a new passkey'), () =>
+        confirmDialog({
+          title: 'Identity confirmed',
+          message: 'Now create your new passkey. Your device or password manager will guide you.',
+          confirmLabel: 'Create passkey',
+        }),
+      ),
+    );
+    await refresh();
+    showStatus(`“${passkey.name}” was added. You can rename it to tell your passkeys apart.`, 'success');
+  } catch (err) {
+    showError(err);
+  }
+});
+
+els.passkeyList.addEventListener('click', async (e) => {
+  const button = e.target.closest('button[data-action]');
+  if (!button) return;
+  const item = button.closest('.passkey-item');
+  const id = item.dataset.id;
+  const form = item.querySelector('.rename-form');
+  const name = item.querySelector('.passkey-name').firstChild.textContent;
+
+  switch (button.dataset.action) {
+    case 'rename': {
+      form.hidden = false;
+      const input = form.querySelector('input');
+      input.value = name;
+      input.focus();
+      input.select();
+      break;
+    }
+    case 'cancel-rename':
+      form.hidden = true;
+      break;
+    case 'delete': {
+      clearStatus();
+      const ok = await confirmDialog({
+        title: 'Remove passkey?',
+        message: `“${name}” will no longer sign you in to The Daily Grind. You may also want to delete it from your device or password manager.`,
+        confirmLabel: 'Remove',
+        danger: true,
+      });
+      if (!ok) return;
+      try {
+        await busy(null, () => accountService.deletePasskey(id, confirmReauth('remove this passkey')));
+        await refresh();
+        showStatus(`“${name}” was removed.`, 'success');
+      } catch (err) {
+        showError(err);
+      }
+      break;
+    }
+  }
+});
+
+els.passkeyList.addEventListener('submit', async (e) => {
+  e.preventDefault();
+  const item = e.target.closest('.passkey-item');
+  const value = e.target.querySelector('input').value;
+  clearStatus();
+  try {
+    await accountService.renamePasskey(item.dataset.id, value);
+    await loadPasskeys();
+    showStatus('Passkey renamed.', 'success');
+  } catch (err) {
+    showError(err);
+  }
+});
+
+els.passkeyList.addEventListener('keydown', (e) => {
+  if (e.key === 'Escape' && e.target.matches('.rename-form input')) {
+    e.preventDefault();
+    e.stopPropagation();
+    e.target.closest('.rename-form').hidden = true;
+  }
+});
+
+els.verifyNow.addEventListener('click', async () => {
+  clearStatus();
+  if (!state.supported) return showStatus('Passkeys aren’t supported in this browser.', 'error');
+  try {
+    await busy(els.verifyNow, () => accountService.reauthenticate());
+    await refresh();
+    showStatus('Thanks — you’re verified for the next 5 minutes.', 'success');
+  } catch (err) {
+    showError(err);
+  }
+});
+
+els.deleteAccount.addEventListener('click', async () => {
+  clearStatus();
+  const ok = await confirmDialog({
+    title: 'Delete your account?',
+    message: 'This permanently deletes your profile, rewards balance and saved passkeys. This can’t be undone.',
+    confirmLabel: 'Delete account',
+    danger: true,
+  });
+  if (!ok) return;
+  try {
+    await busy(null, () => accountService.deleteAccount(confirmReauth('delete your account')));
+    await refresh();
+    showStatus('Your account has been deleted. We’re sorry to see you go!', 'success');
+  } catch (err) {
+    showError(err);
+  }
+});
+
+async function signOut() {
+  await accountService.signOut();
+  await refresh();
+}
+
+els.signout.addEventListener('click', async () => {
+  await signOut();
+  showStatus('You’ve been signed out.', 'success');
+});
+
+els.logoutLink.addEventListener('click', async (e) => {
+  e.preventDefault();
+  await signOut();
+});
+
+// Keep multiple tabs in sync (sign-in/out elsewhere).
+window.addEventListener('storage', (e) => {
+  if (e.key && e.key.startsWith('dailygrind.')) refresh();
+});
+
+/* ------------------------------------------------------------------ */
+/* Boot                                                                 */
+/* ------------------------------------------------------------------ */
+
+refresh().then(() => {
+  if (location.hash === '#account') openAccount();
+});
diff --git a/js/passkeys/account-service.js b/js/passkeys/account-service.js
new file mode 100644
index 0000000..a40c97b
--- /dev/null
+++ b/js/passkeys/account-service.js
@@ -0,0 +1,183 @@
+// Orchestrates the passkey flows used by the My Account UI: it pairs the
+// relying-party "endpoints" with the browser WebAuthn ceremonies, keeps
+// password managers in sync through the Signal API, and transparently
+// asks the customer to re-verify before sensitive actions.
+
+import { AccountError, relyingParty as api } from './relying-party.js';
+import {
+  createPasskey,
+  getPasskey,
+  PasskeyError,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+  signalUnknownCredential,
+} from './webauthn-client.js';
+
+export { AccountError, PasskeyError };
+
+let conditionalController = null;
+
+function cancelConditional() {
+  if (conditionalController) {
+    conditionalController.abort(new DOMException('Superseded', 'AbortError'));
+    conditionalController = null;
+  }
+}
+
+async function handleUnknownCredential(err) {
+  if (err instanceof AccountError && err.code === 'unknown-credential' && err.credentialId) {
+    // Tell the password manager this passkey no longer works here so it stops offering it.
+    await signalUnknownCredential({ rpId: api.rpId(), credentialId: err.credentialId });
+  }
+}
+
+async function syncCredentials(user) {
+  const passkeys = await api.listPasskeys();
+  await signalAllAcceptedCredentials({
+    rpId: api.rpId(),
+    userId: user.id,
+    allAcceptedCredentialIds: passkeys.map((p) => p.id),
+  });
+  return passkeys;
+}
+
+export const accountService = {
+  getSession: () => api.getSession(),
+
+  /** Create a new customer account protected by a passkey. */
+  async register({ email, displayName }) {
+    cancelConditional();
+    const options = await api.startRegistration({ email, displayName });
+    const credential = await createPasskey(options);
+    return api.finishRegistration(credential);
+  },
+
+  /** Explicit "Sign in with a passkey" button (modal account picker). */
+  async signIn() {
+    cancelConditional();
+    const options = await api.startAuthentication({ purpose: 'signin' });
+    const credential = await getPasskey(options);
+    try {
+      const result = await api.finishAuthentication(credential, { purpose: 'signin' });
+      syncCredentials(result.user).catch(() => {});
+      return result;
+    } catch (err) {
+      await handleUnknownCredential(err);
+      throw err;
+    }
+  },
+
+  /**
+   * Passkey autofill: keeps a conditional request pending while the sign-in
+   * form is visible. Resolves with the result once the customer picks a
+   * passkey from the username field's autofill menu; resolves null if aborted.
+   */
+  async startAutofillSignIn() {
+    cancelConditional();
+    const controller = new AbortController();
+    conditionalController = controller;
+    try {
+      const options = await api.startAuthentication({ purpose: 'signin' });
+      const credential = await getPasskey(options, { signal: controller.signal, conditional: true });
+      const result = await api.finishAuthentication(credential, { purpose: 'signin' });
+      syncCredentials(result.user).catch(() => {});
+      return result;
+    } catch (err) {
+      if (controller.signal.aborted || (err instanceof PasskeyError && err.code === 'aborted')) return null;
+      await handleUnknownCredential(err);
+      throw err;
+    } finally {
+      if (conditionalController === controller) conditionalController = null;
+    }
+  },
+
+  stopAutofillSignIn: cancelConditional,
+
+  async signOut() {
+    cancelConditional();
+    await api.signOut();
+  },
+
+  /** Confirm the signed-in customer is present, refreshing the re-auth window. */
+  async reauthenticate() {
+    cancelConditional();
+    const options = await api.startAuthentication({ purpose: 'reauth' });
+    const credential = await getPasskey(options);
+    try {
+      return await api.finishAuthentication(credential, { purpose: 'reauth' });
+    } catch (err) {
+      await handleUnknownCredential(err);
+      throw err;
+    }
+  },
+
+  /**
+   * Run a sensitive action; if the server says verification is stale,
+   * prompt for the passkey (after `confirmReauth` resolves true) and retry once.
+   * `confirmContinue` (optional) is awaited between re-verification and the
+   * retry, so ceremonies that need a fresh user gesture (passkey creation on
+   * Safari) get one.
+   */
+  async withReauth(action, confirmReauth, confirmContinue) {
+    try {
+      return await action();
+    } catch (err) {
+      if (!(err instanceof AccountError) || err.code !== 'reauth-required') throw err;
+      if (confirmReauth && !(await confirmReauth())) {
+        throw new PasskeyError('Verification was cancelled.', { code: 'cancelled' });
+      }
+      await this.reauthenticate();
+      if (confirmContinue && !(await confirmContinue())) {
+        throw new PasskeyError('Cancelled.', { code: 'cancelled' });
+      }
+      return action();
+    }
+  },
+
+  async listPasskeys() {
+    const session = await api.getSession();
+    if (!session) throw new AccountError('Please sign in to continue.', { code: 'unauthenticated', status: 401 });
+    return syncCredentials(session.user);
+  },
+
+  async addPasskey(confirmReauth, confirmContinue) {
+    return this.withReauth(async () => {
+      const options = await api.startAddPasskey();
+      const credential = await createPasskey(options);
+      return api.finishAddPasskey(credential);
+    }, confirmReauth, confirmContinue);
+  },
+
+  renamePasskey: (id, name) => api.renamePasskey(id, name),
+
+  async deletePasskey(id, confirmReauth) {
+    const session = await api.getSession();
+    const result = await this.withReauth(() => api.deletePasskey(id), confirmReauth);
+    const rpId = api.rpId();
+    await signalUnknownCredential({ rpId, credentialId: id });
+    if (session) {
+      await signalAllAcceptedCredentials({ rpId, userId: session.user.id, allAcceptedCredentialIds: result.remainingIds });
+    }
+    return result;
+  },
+
+  async updateProfile(profile, confirmReauth) {
+    const { user } = await this.withReauth(() => api.updateProfile(profile), confirmReauth);
+    // Update the username/display name shown in password managers' passkey pickers.
+    await signalCurrentUserDetails({
+      rpId: api.rpId(),
+      userId: user.id,
+      name: user.email,
+      displayName: user.displayName,
+    });
+    return { user };
+  },
+
+  async deleteAccount(confirmReauth) {
+    const result = await this.withReauth(() => api.deleteAccount(), confirmReauth);
+    const rpId = api.rpId();
+    await signalAllAcceptedCredentials({ rpId, userId: result.userId, allAcceptedCredentialIds: [] });
+    await Promise.all(result.removedIds.map((credentialId) => signalUnknownCredential({ rpId, credentialId })));
+    return result;
+  },
+};
