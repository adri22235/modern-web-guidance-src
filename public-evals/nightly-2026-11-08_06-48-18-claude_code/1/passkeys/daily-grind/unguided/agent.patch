+++ b/js/passkeys/webauthn-client.js
@@ -0,0 +1,219 @@
+// Browser-side WebAuthn ceremonies. Takes JSON options from the relying
+// party, calls navigator.credentials, and returns JSON-serialisable
+// responses (the standard RegistrationResponseJSON / AuthenticationResponseJSON
+// shapes) that can be POSTed to a server.
+
+import { base64urlToBuffer, bufferToBase64url } from './encoding.js';
+
+export class PasskeyError extends Error {
+  constructor(message, { code = 'unknown', cause } = {}) {
+    super(message);
+    this.name = 'PasskeyError';
+    this.code = code;
+    if (cause) this.cause = cause;
+  }
+}
+
+export function isWebAuthnSupported() {
+  return (
+    window.isSecureContext &&
+    typeof window.PublicKeyCredential === 'function' &&
+    typeof navigator.credentials?.create === 'function'
+  );
+}
+
+export async function isConditionalMediationAvailable() {
+  if (!isWebAuthnSupported()) return false;
+  try {
+    if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+      const caps = await PublicKeyCredential.getClientCapabilities();
+      if (typeof caps.conditionalGet === 'boolean') return caps.conditionalGet;
+    }
+    if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+      return await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch {
+    /* fall through */
+  }
+  return false;
+}
+
+export async function isPlatformAuthenticatorAvailable() {
+  if (!isWebAuthnSupported()) return false;
+  try {
+    return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+  } catch {
+    return false;
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* JSON <-> binary option conversion                                    */
+/* ------------------------------------------------------------------ */
+
+function decodeDescriptor(d) {
+  return { ...d, id: base64urlToBuffer(d.id) };
+}
+
+function toCreationOptions(json) {
+  if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+    try {
+      return PublicKeyCredential.parseCreationOptionsFromJSON(json);
+    } catch {
+      /* fall back to manual conversion */
+    }
+  }
+  return {
+    ...json,
+    challenge: base64urlToBuffer(json.challenge),
+    user: { ...json.user, id: base64urlToBuffer(json.user.id) },
+    excludeCredentials: (json.excludeCredentials || []).map(decodeDescriptor),
+  };
+}
+
+function toRequestOptions(json) {
+  if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+    try {
+      return PublicKeyCredential.parseRequestOptionsFromJSON(json);
+    } catch {
+      /* fall back to manual conversion */
+    }
+  }
+  return {
+    ...json,
+    challenge: base64urlToBuffer(json.challenge),
+    allowCredentials: (json.allowCredentials || []).map(decodeDescriptor),
+  };
+}
+
+function serializeRegistration(cred) {
+  const r = cred.response;
+  return {
+    id: cred.id,
+    rawId: bufferToBase64url(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? null,
+    clientExtensionResults: cred.getClientExtensionResults?.() ?? {},
+    response: {
+      clientDataJSON: bufferToBase64url(r.clientDataJSON),
+      attestationObject: bufferToBase64url(r.attestationObject),
+      transports: typeof r.getTransports === 'function' ? r.getTransports() : [],
+    },
+  };
+}
+
+function serializeAuthentication(cred) {
+  const r = cred.response;
+  return {
+    id: cred.id,
+    rawId: bufferToBase64url(cred.rawId),
+    type: cred.type,
+    authenticatorAttachment: cred.authenticatorAttachment ?? null,
+    clientExtensionResults: cred.getClientExtensionResults?.() ?? {},
+    response: {
+      clientDataJSON: bufferToBase64url(r.clientDataJSON),
+      authenticatorData: bufferToBase64url(r.authenticatorData),
+      signature: bufferToBase64url(r.signature),
+      userHandle: r.userHandle ? bufferToBase64url(r.userHandle) : null,
+    },
+  };
+}
+
+function mapDomException(err, context) {
+  if (err instanceof PasskeyError) return err;
+  const name = err?.name;
+  if (name === 'AbortError') {
+    return new PasskeyError('The passkey request was cancelled.', { code: 'aborted', cause: err });
+  }
+  if (name === 'NotAllowedError') {
+    return new PasskeyError(
+      context === 'create'
+        ? 'Passkey creation was cancelled or timed out.'
+        : 'Sign-in was cancelled or no passkey was selected.',
+      { code: 'cancelled', cause: err },
+    );
+  }
+  if (name === 'InvalidStateError' && context === 'create') {
+    return new PasskeyError('A passkey for this account already exists on this device or password manager.', {
+      code: 'already-registered',
+      cause: err,
+    });
+  }
+  if (name === 'SecurityError') {
+    return new PasskeyError('Passkeys are not allowed on this site address. Use HTTPS or localhost.', {
+      code: 'security',
+      cause: err,
+    });
+  }
+  if (name === 'NotSupportedError') {
+    return new PasskeyError('Your device does not support the required passkey options.', {
+      code: 'not-supported',
+      cause: err,
+    });
+  }
+  return new PasskeyError(err?.message || 'Something went wrong with your passkey.', { cause: err });
+}
+
+/* ------------------------------------------------------------------ */
+/* Ceremonies                                                           */
+/* ------------------------------------------------------------------ */
+
+export async function createPasskey(optionsJSON, { signal } = {}) {
+  if (!isWebAuthnSupported()) {
+    throw new PasskeyError('This browser does not support passkeys.', { code: 'unsupported' });
+  }
+  try {
+    const cred = await navigator.credentials.create({ publicKey: toCreationOptions(optionsJSON), signal });
+    if (!cred) throw new PasskeyError('No passkey was created.', { code: 'cancelled' });
+    return serializeRegistration(cred);
+  } catch (err) {
+    throw mapDomException(err, 'create');
+  }
+}
+
+/**
+ * Run an authentication ceremony.
+ * @param {object} optionsJSON PublicKeyCredentialRequestOptionsJSON
+ * @param {{ signal?: AbortSignal, conditional?: boolean }} opts
+ */
+export async function getPasskey(optionsJSON, { signal, conditional = false } = {}) {
+  if (!isWebAuthnSupported()) {
+    throw new PasskeyError('This browser does not support passkeys.', { code: 'unsupported' });
+  }
+  try {
+    const request = { publicKey: toRequestOptions(optionsJSON), signal };
+    if (conditional) request.mediation = 'conditional';
+    const cred = await navigator.credentials.get(request);
+    if (!cred) throw new PasskeyError('No passkey was selected.', { code: 'cancelled' });
+    return serializeAuthentication(cred);
+  } catch (err) {
+    throw mapDomException(err, 'get');
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Signal API – keep password managers in sync with the server.         */
+/* All calls are best effort and silently ignored when unsupported.     */
+/* ------------------------------------------------------------------ */
+
+async function safeSignal(method, payload) {
+  try {
+    if (typeof PublicKeyCredential?.[method] === 'function') {
+      await PublicKeyCredential[method](payload);
+    }
+  } catch (err) {
+    console.debug(`[passkeys] ${method} failed`, err);
+  }
+}
+
+export function signalUnknownCredential({ rpId, credentialId }) {
+  return safeSignal('signalUnknownCredential', { rpId, credentialId });
+}
+
+export function signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds }) {
+  return safeSignal('signalAllAcceptedCredentials', { rpId, userId, allAcceptedCredentialIds });
+}
+
+export function signalCurrentUserDetails({ rpId, userId, name, displayName }) {
+  return safeSignal('signalCurrentUserDetails', { rpId, userId, name, displayName });
+}
