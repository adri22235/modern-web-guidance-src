+import type { APIRoute } from 'astro';
+import { findUserByUsername, getRpId, getSessionUser, hasRecentReauth, json, listCredentials, toPublicCredential, unauthorized } from '../../../../lib/passkeys/server';
+
+/** Lists the signed-in user's passkeys plus the server rpId and user handle for Signal API sync. */
+export const GET: APIRoute = async ({ session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  const credentials = await listCredentials(user.passkeyUserId);
+  return json({
+    rpId: getRpId(url),
+    userId: user.passkeyUserId,
+    recentlyVerified: await hasRecentReauth(session),
+    credentials: credentials.map(toPublicCredential),
+  });
+};
