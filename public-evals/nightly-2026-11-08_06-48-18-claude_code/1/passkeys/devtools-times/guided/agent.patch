+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,34 @@
+import type { APIRoute } from 'astro';
+import { ensureUser, json, signIn } from '../../../lib/passkeys/server';
+
+const UPSTREAM = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Password sign-in. Proxies the existing upstream login API so that a
+ * successful sign-in also establishes a server session, which the passkey
+ * endpoints rely on.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(UPSTREAM, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Sign-in service unavailable.' }, 502);
+  }
+  const data = await upstream.json().catch(() => ({}));
+
+  if (upstream.ok) {
+    await ensureUser(username);
+    await signIn(session, username, 'password');
+  }
+  return json(data, upstream.status);
+};
