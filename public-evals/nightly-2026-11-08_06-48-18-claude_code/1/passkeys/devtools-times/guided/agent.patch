--- /dev/null
+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,35 @@
+import type { APIRoute } from 'astro';
+import { ensureUser, json, signIn } from '../../../lib/passkeys/server';
+
+const UPSTREAM = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+/**
+ * Account registration. Proxies the upstream register API and signs the new
+ * user in so they can immediately be offered a passkey.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  const { username, password } = await request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string') {
+    return json({ error: 'Username and password are required.' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(UPSTREAM, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Registration service unavailable.' }, 502);
+  }
+  const data = await upstream.json().catch(() => ({}));
+
+  if (upstream.ok) {
+    await ensureUser(username);
+    // Sign-up isn't a password *sign-in*, so conditional create is not armed;
+    // the UI shows an explicit passkey promotion instead.
+    await signIn(session, username, 'signup');
+  }
+  return json(data, upstream.status);
+};
