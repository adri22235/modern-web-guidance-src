diff --git a/src/pages/api/auth/passkeys/[id].ts b/src/pages/api/auth/passkeys/[id].ts
new file mode 100644
index 0000000..6c540fc
--- /dev/null
+++ b/src/pages/api/auth/passkeys/[id].ts
@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import {
+  deleteCredential, findUserByUsername, getRpId, getSessionUser, hasRecentReauth, json, listCredentials,
+  toPublicCredential, unauthorized, updateCredential,
+} from '../../../../lib/passkeys/server';
+
+/** Renames a passkey (server-side label only). */
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  const { name } = await request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) return json({ error: 'Name must be between 1 and 64 characters.' }, 400);
+
+  const updated = await updateCredential(params.id!, user.passkeyUserId, { name: trimmed });
+  if (!updated) return json({ error: 'Passkey not found.' }, 404);
+  return json(toPublicCredential(updated));
+};
+
+/** Deletes a passkey. Sensitive: requires a recent passkey reauthentication. */
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  if (!(await hasRecentReauth(session))) {
+    return json({ error: 'Please verify it’s you before removing a passkey.', code: 'REAUTH_REQUIRED' }, 403);
+  }
+
+  const removed = await deleteCredential(params.id!, user.passkeyUserId);
+  if (!removed) return json({ error: 'Passkey not found.' }, 404);
+
+  const credentials = await listCredentials(user.passkeyUserId);
+  return json({
+    success: true,
+    rpId: getRpId(url),
+    userId: user.passkeyUserId,
+    credentials: credentials.map(toPublicCredential),
+  });
+};
