@@ -0,0 +1,416 @@
+import React, { useEffect, useId, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, ShieldCheckIcon, TrashIcon, CloudIcon } from '@heroicons/react/24/outline';
+import {
+  API,
+  PasskeyError,
+  type PasskeyInfo,
+  canCreatePasskey,
+  formatDate,
+  getCapabilities,
+  postJSON,
+  readError,
+  reauthenticateWithPasskey,
+  registerPasskey,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+} from '../lib/passkeys/client';
+
+interface Props {
+  username: string;
+  displayName: string;
+}
+
+type Notice = { kind: 'success' | 'error'; text: string } | null;
+
+const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+const primaryButton =
+  'inline-flex items-center justify-center gap-2 py-2 px-4 rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+const secondaryButton =
+  'inline-flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-md border border-gray-300 text-sm font-medium text-gray-800 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed';
+
+export default function AccountSettings({ username, displayName: initialDisplayName }: Props) {
+  const [credentials, setCredentials] = useState<PasskeyInfo[] | null>(null);
+  const [server, setServer] = useState<{ rpId?: string; userId?: string }>({});
+  const [canCreate, setCanCreate] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [notice, setNotice] = useState<Notice>(null);
+
+  const [displayName, setDisplayName] = useState(initialDisplayName);
+  const [savedDisplayName, setSavedDisplayName] = useState(initialDisplayName);
+  const [savingProfile, setSavingProfile] = useState(false);
+
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+
+  const [pendingDelete, setPendingDelete] = useState<PasskeyInfo | null>(null);
+  const [deleting, setDeleting] = useState(false);
+  const [deleteError, setDeleteError] = useState<string | null>(null);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const dialogTitleId = useId();
+
+  const loadCredentials = async () => {
+    const res = await fetch(`${API}/passkeys`, { headers: { Accept: 'application/json' } });
+    if (res.status === 401) {
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+      return;
+    }
+    if (!res.ok) throw new Error(await readError(res, 'Couldn’t load your passkeys.'));
+    const data = await res.json();
+    setCredentials(data.credentials);
+    setServer({ rpId: data.rpId, userId: data.userId });
+    return data as { rpId: string; userId: string; credentials: PasskeyInfo[] };
+  };
+
+  useEffect(() => {
+    if (new URLSearchParams(window.location.search).get('passkey') === 'created') {
+      setNotice({ kind: 'success', text: 'Passkey created. You can now use it to sign in.' });
+    }
+    getCapabilities().then((caps) => setCanCreate(canCreatePasskey(caps)));
+    loadCredentials()
+      .then((data) => {
+        // Keep the user's passkey providers in sync with the server's list.
+        if (data) signalAllAcceptedCredentials(data.rpId, data.userId, data.credentials);
+      })
+      .catch((err) => {
+        setCredentials([]);
+        setNotice({ kind: 'error', text: err.message });
+      });
+  }, []);
+
+  /* ------------------------------ Profile -------------------------------- */
+
+  const handleProfileSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setNotice(null);
+    setSavingProfile(true);
+    try {
+      const res = await postJSON('account', { displayName }, 'PUT');
+      if (!res.ok) throw new Error(await readError(res, 'Couldn’t update your display name.'));
+      const data = await res.json();
+      setDisplayName(data.displayName);
+      setSavedDisplayName(data.displayName);
+      setNotice({ kind: 'success', text: 'Display name updated.' });
+      // Update the name shown by password managers for this account's passkeys.
+      await signalCurrentUserDetails(data.rpId, data.userId, data.name, data.displayName);
+    } catch (err) {
+      setNotice({ kind: 'error', text: (err as Error).message });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  /* ------------------------------ Create --------------------------------- */
+
+  const handleCreate = async () => {
+    setNotice(null);
+    setCreating(true);
+    try {
+      const created = await registerPasskey('manage');
+      if (created) setNotice({ kind: 'success', text: `Passkey “${created.name}” created.` });
+      await loadCredentials();
+    } catch (err) {
+      if (!(err instanceof PasskeyError && err.silent)) {
+        setNotice({ kind: 'error', text: (err as Error).message });
+      }
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  /* ------------------------------ Rename --------------------------------- */
+
+  const startRename = (cred: PasskeyInfo) => {
+    setEditingId(cred.id);
+    setRenameValue(cred.name);
+  };
+
+  const handleRename = async (e: React.FormEvent, cred: PasskeyInfo) => {
+    e.preventDefault();
+    setNotice(null);
+    try {
+      const res = await postJSON(`passkeys/${encodeURIComponent(cred.id)}`, { name: renameValue }, 'PUT');
+      if (!res.ok) throw new Error(await readError(res, 'Couldn’t rename the passkey.'));
+      const updated: PasskeyInfo = await res.json();
+      setCredentials((list) => list?.map((c) => (c.id === updated.id ? updated : c)) ?? null);
+      setEditingId(null);
+      setNotice({ kind: 'success', text: 'Passkey renamed.' });
+    } catch (err) {
+      setNotice({ kind: 'error', text: (err as Error).message });
+    }
+  };
+
+  /* ------------------------------ Delete --------------------------------- */
+
+  const openDelete = (cred: PasskeyInfo) => {
+    setPendingDelete(cred);
+    setDeleteError(null);
+    dialogRef.current?.showModal();
+  };
+
+  const closeDelete = () => {
+    dialogRef.current?.close();
+  };
+
+  const requestDelete = (id: string) => fetch(`${API}/passkeys/${encodeURIComponent(id)}`, { method: 'DELETE' });
+
+  const confirmDelete = async () => {
+    if (!pendingDelete) return;
+    setDeleting(true);
+    setDeleteError(null);
+    try {
+      let res = await requestDelete(pendingDelete.id);
+      if (res.status === 403) {
+        const data = await res.clone().json().catch(() => ({}));
+        if (data.code === 'REAUTH_REQUIRED') {
+          // Sensitive action: verify it's really the account owner, then retry.
+          await reauthenticateWithPasskey();
+          res = await requestDelete(pendingDelete.id);
+        }
+      }
+      if (!res.ok) throw new Error(await readError(res, 'Couldn’t remove the passkey.'));
+      const data = await res.json();
+      setCredentials(data.credentials);
+      setNotice({
+        kind: 'success',
+        text: `Passkey “${pendingDelete.name}” removed from your account.`,
+      });
+      closeDelete();
+      await signalAllAcceptedCredentials(data.rpId, data.userId, data.credentials);
+    } catch (err) {
+      if (err instanceof PasskeyError && err.silent) {
+        setDeleteError('Verification was cancelled. The passkey was not removed.');
+      } else {
+        setDeleteError((err as Error).message);
+      }
+    } finally {
+      setDeleting(false);
+    }
+  };
+
+  /* ------------------------------ Sign out ------------------------------- */
+
+  const handleSignOut = async () => {
+    await postJSON('logout');
+    window.location.assign(import.meta.env.BASE_URL);
+  };
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 space-y-8">
+      <div className="flex items-baseline justify-between gap-4">
+        <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+        <button type="button" onClick={handleSignOut} className={secondaryButton}>
+          Sign out
+        </button>
+      </div>
+
+      <div aria-live="polite">
+        {notice && (
+          <div
+            className={`p-3 text-sm rounded-lg ${
+              notice.kind === 'success' ? 'text-green-700 bg-green-100' : 'text-red-700 bg-red-100'
+            }`}
+            role={notice.kind === 'error' ? 'alert' : 'status'}
+          >
+            {notice.text}
+          </div>
+        )}
+      </div>
+
+      {/* Profile */}
+      <section aria-labelledby="profile-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 id="profile-heading" className="text-xl font-bold text-gray-800 mb-4">
+          Profile
+        </h2>
+        <form onSubmit={handleProfileSubmit} className="space-y-4">
+          <div>
+            <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Username
+            </label>
+            <input
+              id="account-username"
+              type="text"
+              value={username}
+              readOnly
+              autoComplete="username"
+              className={`${inputClass} bg-gray-50 text-gray-600`}
+            />
+          </div>
+          <div>
+            <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="account-display-name"
+              type="text"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              maxLength={64}
+              autoComplete="name"
+              aria-describedby="display-name-hint"
+              className={inputClass}
+            />
+            <p id="display-name-hint" className="text-xs text-gray-500 mt-1">
+              Shown next to your passkeys in your password manager.
+            </p>
+          </div>
+          <button
+            type="submit"
+            className={primaryButton}
+            disabled={savingProfile || displayName.trim() === savedDisplayName}
+          >
+            {savingProfile ? 'Saving…' : 'Save'}
+          </button>
+        </form>
+      </section>
+
+      {/* Passkeys */}
+      <section aria-labelledby="passkeys-heading" className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-2">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-800">
+              Passkeys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1 max-w-prose">
+              Sign in with your fingerprint, face, screen lock, or a security key instead of a password.
+            </p>
+          </div>
+          {canCreate && (
+            <button type="button" onClick={handleCreate} disabled={creating} className={primaryButton}>
+              <KeyIcon className="w-5 h-5" aria-hidden="true" />
+              {creating ? 'Creating…' : 'Create a passkey'}
+            </button>
+          )}
+        </div>
+
+        {!canCreate && credentials !== null && (
+          <p className="text-sm text-gray-600 bg-gray-50 border border-gray-200 rounded-md p-3 mt-4">
+            This browser or device doesn't support creating passkeys. Keep using a strong, unique password, or
+            open this page on a device that supports passkeys to add one.
+          </p>
+        )}
+
+        {credentials === null ? (
+          <p className="text-sm text-gray-500 mt-4" role="status">
+            Loading passkeys…
+          </p>
+        ) : credentials.length === 0 ? (
+          <p className="text-sm text-gray-600 mt-4">No passkeys found. Create one to sign in faster next time.</p>
+        ) : (
+          <ul className="mt-4 divide-y divide-gray-200 border-t border-b border-gray-200">
+            {credentials.map((cred) => (
+              <li key={cred.id} className="py-4 flex flex-wrap items-start gap-4">
+                {cred.providerIcon ? (
+                  <img src={cred.providerIcon} alt="" width={32} height={32} className="w-8 h-8 shrink-0" />
+                ) : (
+                  <KeyIcon className="w-8 h-8 shrink-0 text-gray-500" aria-hidden="true" />
+                )}
+
+                <div className="flex-1 min-w-48">
+                  {editingId === cred.id ? (
+                    <form onSubmit={(e) => handleRename(e, cred)} className="flex flex-wrap items-center gap-2">
+                      <label htmlFor={`rename-${cred.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${cred.id}`}
+                        type="text"
+                        value={renameValue}
+                        onChange={(e) => setRenameValue(e.target.value)}
+                        onKeyDown={(e) => e.key === 'Escape' && setEditingId(null)}
+                        required
+                        maxLength={64}
+                        autoFocus
+                        className={`${inputClass} flex-1 min-w-40 py-1.5`}
+                      />
+                      <button type="submit" className={secondaryButton}>
+                        Save
+                      </button>
+                      <button type="button" onClick={() => setEditingId(null)} className={secondaryButton}>
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-semibold text-gray-900 break-words">{cred.name}</p>
+                  )}
+                  <dl className="mt-1 text-xs text-gray-600 grid grid-cols-[auto_1fr] gap-x-2 gap-y-0.5">
+                    <dt>Created</dt>
+                    <dd>{formatDate(cred.registeredAt)}</dd>
+                    <dt>Last used</dt>
+                    <dd>{formatDate(cred.lastUsedAt)}</dd>
+                  </dl>
+                  {cred.credentialBackedUp && (
+                    <p className="mt-1 inline-flex items-center gap-1 text-xs text-gray-600">
+                      <CloudIcon className="w-4 h-4" aria-hidden="true" />
+                      Synced across your devices
+                    </p>
+                  )}
+                </div>
+
+                {editingId !== cred.id && (
+                  <div className="flex gap-2">
+                    <button
+                      type="button"
+                      onClick={() => startRename(cred)}
+                      className={secondaryButton}
+                      aria-label={`Rename passkey ${cred.name}`}
+                    >
+                      <PencilSquareIcon className="w-4 h-4" aria-hidden="true" />
+                      Rename
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => openDelete(cred)}
+                      className={`${secondaryButton} text-red-700 hover:bg-red-50`}
+                      aria-label={`Remove passkey ${cred.name}`}
+                    >
+                      <TrashIcon className="w-4 h-4" aria-hidden="true" />
+                      Remove
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <dialog
+        ref={dialogRef}
+        aria-labelledby={dialogTitleId}
+        onClose={() => setPendingDelete(null)}
+        className="m-auto max-w-md w-[calc(100%-2rem)] rounded-lg p-6 shadow-xl backdrop:bg-black/50"
+      >
+        <h2 id={dialogTitleId} className="text-lg font-bold text-gray-900">
+          Remove passkey?
+        </h2>
+        <p className="mt-2 text-sm text-gray-600">
+          “{pendingDelete?.name}” will no longer work for signing in to The DevTools Times.
+        </p>
+        <p className="mt-2 text-sm text-gray-600 flex gap-2">
+          <ShieldCheckIcon className="w-5 h-5 shrink-0 text-gray-700" aria-hidden="true" />
+          For your security, you may be asked to verify it's you with one of your passkeys first.
+        </p>
+        {deleteError && (
+          <p className="mt-3 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {deleteError}
+          </p>
+        )}
+        <div className="mt-6 flex justify-end gap-2">
+          <button type="button" onClick={closeDelete} className={secondaryButton} autoFocus>
+            Cancel
+          </button>
+          <button
+            type="button"
+            onClick={confirmDelete}
+            disabled={deleting}
+            className="inline-flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-md text-sm font-medium text-white bg-red-700 hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-red-700 disabled:opacity-60"
+          >
+            {deleting ? 'Removing…' : 'Remove passkey'}
+          </button>
+        </div>
+      </dialog>
+    </div>
+  );
+}
