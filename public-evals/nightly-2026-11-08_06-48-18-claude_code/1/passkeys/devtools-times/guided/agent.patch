@@ -0,0 +1,55 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  REAUTH_WINDOW_MS, findCredential, findUserByUsername, fromBase64Url, getExpectedOrigins, getRpId, getSessionUser,
+  json, takeChallenge, unauthorized, updateCredential,
+} from '../../../../lib/passkeys/server';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  const pending = await takeChallenge(session, 'reauth');
+  if (!pending) return json({ error: 'Verification request expired. Please try again.' }, 400);
+
+  const body = await request.json().catch(() => null);
+  if (!body?.id) return json({ error: 'Invalid request.' }, 400);
+
+  const credential = await findCredential(body.id);
+  if (!credential) {
+    return json({ error: 'This passkey is not registered.', code: 'UNKNOWN_CREDENTIAL' }, 404);
+  }
+  // The passkey must belong to the signed-in account.
+  if (credential.passkeyUserId !== user.passkeyUserId) {
+    return json({ error: 'This passkey belongs to a different account.' }, 403);
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      credential: {
+        id: credential.id,
+        publicKey: fromBase64Url(credential.credentialPublicKey),
+        counter: credential.counter,
+        transports: credential.transports as any,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return json({ error: `Verification failed: ${(err as Error).message}` }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Verification failed.' }, 400);
+
+  await updateCredential(credential.id, credential.passkeyUserId, {
+    counter: verification.authenticationInfo.newCounter,
+    lastUsedAt: Date.now(),
+  });
+  session?.set('reauthAt', Date.now());
+  return json({ verified: true, expiresInMs: REAUTH_WINDOW_MS });
+};
diff --git a/src/pages/api/auth/passkeys/register-options.ts b/src/pages/api/auth/passkeys/register-options.ts
new file mode 100644
index 0000000..e4a23f3
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register-options.ts
@@ -0,0 +1,55 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  CONDITIONAL_CREATE_WINDOW_MS, RP_NAME, findUserByUsername, fromBase64Url, getRpId, getSessionUser, json,
+  listCredentials, storeChallenge, unauthorized,
+} from '../../../../lib/passkeys/server';
+
+/**
+ * Creation options.
+ * Body: { mode: 'promotion' | 'conditional' | 'manage' }
+ *  - promotion: explicit offer after sign-up → platform authenticators only
+ *  - conditional: silent creation right after a password sign-in
+ *  - manage: account settings → any authenticator, including security keys
+ */
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  const { mode = 'manage' } = await request.json().catch(() => ({}));
+  if (!['promotion', 'conditional', 'manage'].includes(mode)) return json({ error: 'Invalid mode.' }, 400);
+
+  if (mode === 'conditional') {
+    const at = (await session?.get('passwordSignInAt')) as number | undefined;
+    if (!at || Date.now() - at > CONDITIONAL_CREATE_WINDOW_MS) {
+      return json({ error: 'Conditional create is only available right after a password sign-in.' }, 403);
+    }
+  }
+
+  const existing = await listCredentials(user.passkeyUserId);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: getRpId(url),
+    userID: fromBase64Url(user.passkeyUserId),
+    userName: user.username,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existing.map((c) => ({ id: c.id, transports: c.transports as any })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(mode !== 'manage' && { authenticatorAttachment: 'platform' }),
+    },
+  });
+
+  storeChallenge(session, {
+    kind: 'register',
+    challenge: options.challenge,
+    userVerification: 'preferred',
+    conditional: mode === 'conditional',
+  });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/register-verify.ts b/src/pages/api/auth/passkeys/register-verify.ts
new file mode 100644
index 0000000..3e57174
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register-verify.ts
@@ -0,0 +1,61 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  findUserByUsername, getExpectedOrigins, getRpId, getSessionUser, json, listCredentials, lookupProvider,
+  saveCredential, takeChallenge, toBase64Url, toPublicCredential, unauthorized,
+} from '../../../../lib/passkeys/server';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  const pending = await takeChallenge(session, 'register');
+  if (!pending) return json({ error: 'Registration request expired. Please try again.' }, 400);
+
+  const body = await request.json().catch(() => null);
+  if (!body) return json({ error: 'Invalid request.' }, 400);
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      // Options asked for 'preferred' UV, so don't reject authenticators without UV.
+      requireUserVerification: pending.userVerification === 'required',
+      // User presence may only be relaxed for conditional (automatic) creation.
+      requireUserPresence: !pending.conditional,
+    });
+  } catch (err) {
+    return json({ error: `Passkey verification failed: ${(err as Error).message}` }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey verification failed.' }, 400);
+
+  const info = verification.registrationInfo;
+  const existing = await listCredentials(user.passkeyUserId);
+  if (existing.some((c) => c.id === info.credential.id)) {
+    return json({ error: 'This passkey is already registered.' }, 409);
+  }
+
+  const provider = await lookupProvider(info.aaguid, request.headers.get('user-agent'));
+  const stored = {
+    id: info.credential.id,
+    passkeyUserId: user.passkeyUserId,
+    credentialPublicKey: toBase64Url(info.credential.publicKey),
+    credentialType: 'public-key' as const,
+    credentialDeviceType: info.credentialDeviceType,
+    credentialBackedUp: info.credentialBackedUp,
+    aaguid: info.aaguid,
+    providerIcon: provider.icon,
+    providerIconDark: provider.iconDark,
+    name: provider.name,
+    transports: info.credential.transports ?? body.response?.transports ?? [],
+    registeredAt: Date.now(),
+    counter: info.credential.counter,
+  };
+  await saveCredential(stored);
+  return json({ verified: true, credential: toPublicCredential(stored) });
+};
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
