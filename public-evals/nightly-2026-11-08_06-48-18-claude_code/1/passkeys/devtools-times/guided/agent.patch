+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getRpId, json, storeChallenge } from '../../../../lib/passkeys/server';
+
+/** Discoverable-credential request options for primary sign-in. */
+export const POST: APIRoute = async ({ session, url }) => {
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(url),
+    allowCredentials: [],
+    userVerification: 'preferred',
+  });
+  // UV expectation lives in the session, never in client input.
+  storeChallenge(session, { kind: 'login', challenge: options.challenge, userVerification: 'preferred' });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/login-verify.ts b/src/pages/api/auth/passkeys/login-verify.ts
new file mode 100644
index 0000000..7543c4a
--- /dev/null
+++ b/src/pages/api/auth/passkeys/login-verify.ts
@@ -0,0 +1,57 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  findCredential, findUserByPasskeyUserId, fromBase64Url, getExpectedOrigins, getRpId, json, signIn,
+  takeChallenge, updateCredential,
+} from '../../../../lib/passkeys/server';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const pending = await takeChallenge(session, 'login');
+  if (!pending) return json({ error: 'Sign-in request expired. Please try again.' }, 400);
+
+  const body = await request.json().catch(() => null);
+  if (!body?.id) return json({ error: 'Invalid request.' }, 400);
+
+  const credential = await findCredential(body.id);
+  if (!credential) {
+    // 404 lets the client tell the passkey provider this credential is gone.
+    return json({ error: 'This passkey is not registered with The DevTools Times.', code: 'UNKNOWN_CREDENTIAL' }, 404);
+  }
+  const user = await findUserByPasskeyUserId(credential.passkeyUserId);
+  if (!user) return json({ error: 'Account not found.', code: 'UNKNOWN_CREDENTIAL' }, 404);
+
+  const userHandle = body.response?.userHandle;
+  if (userHandle && userHandle !== user.passkeyUserId) {
+    return json({ error: 'Passkey does not match this account.' }, 400);
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: body,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: getExpectedOrigins(url),
+      expectedRPID: getRpId(url),
+      credential: {
+        id: credential.id,
+        publicKey: fromBase64Url(credential.credentialPublicKey),
+        counter: credential.counter,
+        transports: credential.transports as any,
+      },
+      requireUserVerification: pending.userVerification === 'required',
+    });
+  } catch (err) {
+    return json({ error: `Passkey verification failed: ${(err as Error).message}` }, 400);
+  }
+  if (!verification.verified) return json({ error: 'Passkey verification failed.' }, 400);
+
+  const info = verification.authenticationInfo;
+  await updateCredential(credential.id, credential.passkeyUserId, {
+    counter: info.newCounter,
+    lastUsedAt: Date.now(),
+    credentialBackedUp: info.credentialBackedUp,
+    credentialDeviceType: info.credentialDeviceType,
+  });
+  await signIn(session, user.username, 'passkey');
+  return json({ verified: true, username: user.username });
+};
diff --git a/src/pages/api/auth/passkeys/reauth-options.ts b/src/pages/api/auth/passkeys/reauth-options.ts
new file mode 100644
index 0000000..d3411c2
--- /dev/null
+++ b/src/pages/api/auth/passkeys/reauth-options.ts
@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { findUserByUsername, getRpId, getSessionUser, json, listCredentials, storeChallenge, unauthorized } from '../../../../lib/passkeys/server';
+
+/** Step-up options restricted to the signed-in user's own passkeys. */
+export const POST: APIRoute = async ({ session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+
+  const credentials = await listCredentials(user.passkeyUserId);
+  if (!credentials.length) {
+    return json({ error: 'There are no passkeys on this account to verify with.', code: 'NO_PASSKEYS' }, 409);
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID: getRpId(url),
+    allowCredentials: credentials.map((c) => ({ id: c.id, transports: c.transports as any })),
+    userVerification: 'required',
+  });
+  storeChallenge(session, { kind: 'reauth', challenge: options.challenge, userVerification: 'required' });
+  return json(options);
+};
