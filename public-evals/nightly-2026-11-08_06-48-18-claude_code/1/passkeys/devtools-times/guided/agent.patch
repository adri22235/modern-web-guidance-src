+import type { APIRoute } from 'astro';
+import { findUserByUsername, getRpId, getSessionUser, json, unauthorized, updateUserDisplayName } from '../../../lib/passkeys/server';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+  const user = await findUserByUsername(sessionUser.username);
+  if (!user) return unauthorized();
+  return json({ name: user.username, displayName: user.displayName, rpId: getRpId(url), userId: user.passkeyUserId });
+};
+
+/** Updates the account display name. */
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const sessionUser = await getSessionUser(session);
+  if (!sessionUser) return unauthorized();
+
+  const { displayName } = await request.json().catch(() => ({}));
+  const trimmed = typeof displayName === 'string' ? displayName.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return json({ error: 'Display name must be between 1 and 64 characters.' }, 400);
+  }
+
+  const user = await updateUserDisplayName(sessionUser.username, trimmed);
+  if (!user) return unauthorized();
+  return json({ name: user.username, displayName: user.displayName, rpId: getRpId(url), userId: user.passkeyUserId });
+};
