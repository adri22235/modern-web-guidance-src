diff --git a/src/lib/passkeys/client.ts b/src/lib/passkeys/client.ts
new file mode 100644
index 0000000..23f0b92
--- /dev/null
+++ b/src/lib/passkeys/client.ts
@@ -0,0 +1,245 @@
+/**
+ * Browser-side passkey helpers. Uses the native WebAuthn APIs directly;
+ * `webauthn-polyfills` backfills JSON (de)serialisation and
+ * getClientCapabilities() on older engines.
+ */
+
+export const API = `${import.meta.env.BASE_URL}api/auth`;
+
+export interface PasskeyInfo {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  providerIconDark?: string;
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  transports: string[];
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export type Capabilities = Partial<Record<
+  | 'conditionalCreate' | 'conditionalGet' | 'hybridTransport' | 'passkeyPlatformAuthenticator'
+  | 'userVerifyingPlatformAuthenticator' | 'relatedOrigins' | 'signalAllAcceptedCredentials'
+  | 'signalCurrentUserDetails' | 'signalUnknownCredential',
+  boolean
+>>;
+
+// Signal API and JSON helpers are newer than the bundled DOM typings.
+type PKC = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<Capabilities>;
+  parseCreationOptionsFromJSON: (json: unknown) => PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON: (json: unknown) => PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (o: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (o: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (o: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+type CredentialJSON = { id: string; [key: string]: unknown };
+
+export function webAuthnSupported(): boolean {
+  return typeof window !== 'undefined' && typeof window.PublicKeyCredential === 'function';
+}
+
+function pkc(): PKC {
+  return window.PublicKeyCredential as unknown as PKC;
+}
+
+let polyfills: Promise<unknown> | null = null;
+/** Loads the polyfills (only where WebAuthn exists — they touch PublicKeyCredential on import). */
+export function ensurePolyfills(): Promise<unknown> {
+  if (!webAuthnSupported()) return Promise.resolve();
+  polyfills ??= import('webauthn-polyfills').catch((e) => console.warn('webauthn-polyfills failed to load', e));
+  return polyfills;
+}
+
+export async function getCapabilities(): Promise<Capabilities> {
+  if (!webAuthnSupported()) return {};
+  await ensurePolyfills();
+  try {
+    return (await pkc().getClientCapabilities?.()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+/** Whether to offer "Create a passkey" (per guidance: needs a platform authenticator + conditional get). */
+export function canCreatePasskey(caps: Capabilities) {
+  return Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+}
+
+export function isValidBase64Url(value: unknown): value is string {
+  return typeof value === 'string' && value.length > 0 && value.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+export async function postJSON(path: string, body?: unknown, method = 'POST') {
+  return fetch(`${API}/${path}`, {
+    method,
+    headers: { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+}
+
+export async function readError(response: Response, fallback: string) {
+  const data = await response.json().catch(() => ({}));
+  return (data?.error as string) || fallback;
+}
+
+/* ---------------------------- Signal API --------------------------------- */
+
+export async function signalUnknownCredential(rpId: string | undefined, credentialId: string) {
+  if (!webAuthnSupported() || !pkc().signalUnknownCredential || !rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    await pkc().signalUnknownCredential!({ rpId, credentialId });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+export async function signalAllAcceptedCredentials(rpId: string | undefined, userId: string | undefined, credentials: { id: string }[]) {
+  if (!webAuthnSupported() || !pkc().signalAllAcceptedCredentials) return;
+  const ids = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !ids.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: invalid rpId, userId or credential IDs.');
+    return;
+  }
+  try {
+    await pkc().signalAllAcceptedCredentials!({ rpId, userId, allAcceptedCredentialIds: ids });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function signalCurrentUserDetails(rpId: string | undefined, userId: string | undefined, name: string, displayName: string) {
+  if (!webAuthnSupported() || !pkc().signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: invalid rpId or userId.');
+    return;
+  }
+  try {
+    await pkc().signalCurrentUserDetails!({ rpId, userId, name, displayName });
+  } catch (e) {
+    console.warn('signalCurrentUserDetails sync warning:', e);
+  }
+}
+
+/* ------------------------------ Errors ----------------------------------- */
+
+export class PasskeyError extends Error {
+  constructor(message: string, readonly silent = false) {
+    super(message);
+  }
+}
+
+/** Maps WebAuthn DOMExceptions to user-facing errors; cancellations are silent. */
+function toPasskeyError(err: unknown, action: 'create' | 'get'): PasskeyError {
+  const name = (err as DOMException)?.name;
+  switch (name) {
+    case 'NotAllowedError':
+    case 'AbortError':
+      return new PasskeyError('The passkey request was cancelled.', true);
+    case 'InvalidStateError':
+      return new PasskeyError('A passkey for this account already exists in this passkey provider.');
+    case 'SecurityError':
+      return new PasskeyError('Passkeys aren’t available on this site’s current address (secure context or RP ID mismatch).');
+    default:
+      return new PasskeyError(action === 'create' ? 'Couldn’t create a passkey. Please try again.' : 'Couldn’t use a passkey. Please try again.');
+  }
+}
+
+/* --------------------------- Registration -------------------------------- */
+
+export type RegisterMode = 'promotion' | 'conditional' | 'manage';
+
+/**
+ * Registers a passkey for the signed-in user.
+ * Returns the new credential, or null if silently skipped (conditional mode).
+ */
+export async function registerPasskey(mode: RegisterMode, signal?: AbortSignal): Promise<PasskeyInfo | null> {
+  await ensurePolyfills();
+  const optionsRes = await postJSON('passkeys/register-options', { mode });
+  if (!optionsRes.ok) {
+    if (mode === 'conditional') return null;
+    throw new PasskeyError(await readError(optionsRes, 'Couldn’t start passkey creation.'));
+  }
+  const publicKey = pkc().parseCreationOptionsFromJSON(await optionsRes.json());
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.create({
+      publicKey,
+      signal,
+      ...(mode === 'conditional' && { mediation: 'conditional' as CredentialMediationRequirement }),
+    })) as PublicKeyCredential;
+  } catch (err) {
+    if (mode === 'conditional') return null; // Never surface errors for automatic creation.
+    throw toPasskeyError(err, 'create');
+  }
+
+  const encoded = (credential as unknown as { toJSON(): CredentialJSON }).toJSON();
+  const rpId = publicKey.rp.id;
+  try {
+    const verifyRes = await postJSON('passkeys/register-verify', encoded);
+    if (!verifyRes.ok) {
+      await signalUnknownCredential(rpId, encoded.id);
+      if (mode === 'conditional') return null;
+      throw new PasskeyError(await readError(verifyRes, 'The server couldn’t verify your new passkey.'));
+    }
+    return (await verifyRes.json()).credential as PasskeyInfo;
+  } catch (err) {
+    if (err instanceof PasskeyError) throw err;
+    await signalUnknownCredential(rpId, encoded.id);
+    if (mode === 'conditional') return null;
+    throw new PasskeyError('Network error while saving your passkey.');
+  }
+}
+
+/* -------------------------- Authentication ------------------------------- */
+
+async function getAssertion(
+  optionsPath: string,
+  verifyPath: string,
+  init: { signal?: AbortSignal; mediation?: CredentialMediationRequirement },
+) {
+  await ensurePolyfills();
+  const optionsRes = await postJSON(optionsPath);
+  if (!optionsRes.ok) throw new PasskeyError(await readError(optionsRes, 'Couldn’t start passkey verification.'));
+  const publicKey = pkc().parseRequestOptionsFromJSON(await optionsRes.json());
+
+  let credential: PublicKeyCredential;
+  try {
+    credential = (await navigator.credentials.get({ publicKey, ...init })) as PublicKeyCredential;
+  } catch (err) {
+    throw toPasskeyError(err, 'get');
+  }
+
+  const encoded = (credential as unknown as { toJSON(): CredentialJSON }).toJSON();
+  let verifyRes: Response;
+  try {
+    verifyRes = await postJSON(verifyPath, encoded);
+  } catch {
+    throw new PasskeyError('Network error while verifying your passkey.');
+  }
+  if (!verifyRes.ok) {
+    if (verifyRes.status === 404) await signalUnknownCredential(publicKey.rpId, encoded.id);
+    throw new PasskeyError(await readError(verifyRes, 'Passkey verification failed.'));
+  }
+  return verifyRes.json();
+}
+
+/** Primary sign-in with a discoverable passkey (button or autofill). */
+export function signInWithPasskey(init: { signal?: AbortSignal; mediation?: CredentialMediationRequirement } = {}) {
+  return getAssertion('passkeys/login-options', 'passkeys/login-verify', init) as Promise<{ username: string }>;
+}
+
+/** Step-up verification restricted to the signed-in user's passkeys. */
+export function reauthenticateWithPasskey(signal?: AbortSignal) {
+  return getAssertion('passkeys/reauth-options', 'passkeys/reauth-verify', { signal });
+}
+
+/* ------------------------------ Formatting ------------------------------- */
+
+const dateFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+export function formatDate(epoch?: number) {
+  return epoch ? dateFormat.format(new Date(epoch)) : 'Never';
+}
diff --git a/src/lib/passkeys/server.ts b/src/lib/passkeys/server.ts
new file mode 100644
index 0000000..c7a606f
--- /dev/null
+++ b/src/lib/passkeys/server.ts
@@ -0,0 +1,311 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import type { AstroCookies, AstroSession } from 'astro';
+
+/* -------------------------------------------------------------------------- */
+/* Relying Party configuration                                                */
+/* -------------------------------------------------------------------------- */
+
+export const RP_NAME = 'The DevTools Times';
+
+/**
+ * The RP ID is a server-side constant. Set PASSKEY_RP_ID in production (for
+ * example to a registrable parent domain). When unset it falls back to the
+ * hostname of the incoming request, which is resolved on the server (Astro
+ * honours X-Forwarded-Host for the domains listed in `security.allowedDomains`).
+ */
+export function getRpId(url: URL): string {
+  return process.env.PASSKEY_RP_ID || url.hostname;
+}
+
+/** Origins accepted when verifying WebAuthn responses. */
+export function getExpectedOrigins(url: URL): string[] {
+  const configured = process.env.PASSKEY_ORIGINS?.split(',').map((o) => o.trim()).filter(Boolean);
+  if (configured?.length) return configured;
+  const origins = new Set([url.origin]);
+  // Behind TLS-terminating proxies the server may see plain http.
+  if (url.hostname !== 'localhost' && url.hostname !== '127.0.0.1') {
+    origins.add(`https://${url.host}`);
+  }
+  return [...origins];
+}
+
+/* -------------------------------------------------------------------------- */
+/* Persistence (small JSON file store)                                        */
+/* -------------------------------------------------------------------------- */
+
+export interface StoredUser {
+  username: string; // account username (WebAuthn user.name)
+  displayName: string;
+  passkeyUserId: string; // unpadded Base64URL WebAuthn user handle
+  createdAt: number;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL credential ID
+  passkeyUserId: string;
+  credentialPublicKey: string; // Base64URL
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  providerIconDark?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface DB {
+  users: StoredUser[];
+  credentials: StoredPasskeyCredential[];
+}
+
+const DATA_FILE = resolve(process.env.PASSKEY_DATA_FILE || '.data/passkeys.json');
+let cache: DB | null = null;
+let writeChain: Promise<void> = Promise.resolve();
+
+async function load(): Promise<DB> {
+  if (cache) return cache;
+  try {
+    cache = JSON.parse(await readFile(DATA_FILE, 'utf8')) as DB;
+  } catch {
+    cache = { users: [], credentials: [] };
+  }
+  return cache;
+}
+
+/** Serialises mutations and atomically persists the store. */
+async function mutate<T>(fn: (db: DB) => T): Promise<T> {
+  const run = writeChain.then(async () => {
+    const db = await load();
+    const result = fn(db);
+    await mkdir(dirname(DATA_FILE), { recursive: true });
+    const tmp = `${DATA_FILE}.${process.pid}.tmp`;
+    await writeFile(tmp, JSON.stringify(db, null, 2));
+    await rename(tmp, DATA_FILE);
+    return result;
+  });
+  writeChain = run.then(() => undefined, () => undefined);
+  return run;
+}
+
+export function toBase64Url(bytes: Uint8Array): string {
+  return Buffer.from(bytes).toString('base64url');
+}
+
+export function fromBase64Url(value: string): Uint8Array {
+  return new Uint8Array(Buffer.from(value, 'base64url'));
+}
+
+export async function findUserByUsername(username: string) {
+  const db = await load();
+  return db.users.find((u) => u.username === username);
+}
+
+export async function findUserByPasskeyUserId(passkeyUserId: string) {
+  const db = await load();
+  return db.users.find((u) => u.passkeyUserId === passkeyUserId);
+}
+
+export async function ensureUser(username: string): Promise<StoredUser> {
+  const existing = await findUserByUsername(username);
+  if (existing) return existing;
+  return mutate((db) => {
+    const found = db.users.find((u) => u.username === username);
+    if (found) return found;
+    const user: StoredUser = {
+      username,
+      displayName: username,
+      passkeyUserId: toBase64Url(randomBytes(32)),
+      createdAt: Date.now(),
+    };
+    db.users.push(user);
+    return user;
+  });
+}
+
+export async function updateUserDisplayName(username: string, displayName: string) {
+  return mutate((db) => {
+    const user = db.users.find((u) => u.username === username);
+    if (!user) return undefined;
+    user.displayName = displayName;
+    return { ...user };
+  });
+}
+
+export async function listCredentials(passkeyUserId: string) {
+  const db = await load();
+  return db.credentials
+    .filter((c) => c.passkeyUserId === passkeyUserId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export async function findCredential(id: string) {
+  const db = await load();
+  return db.credentials.find((c) => c.id === id);
+}
+
+export async function saveCredential(credential: StoredPasskeyCredential) {
+  return mutate((db) => {
+    const index = db.credentials.findIndex((c) => c.id === credential.id);
+    if (index === -1) db.credentials.push(credential);
+    else db.credentials[index] = credential;
+  });
+}
+
+export async function updateCredential(
+  id: string,
+  passkeyUserId: string,
+  patch: Partial<Pick<StoredPasskeyCredential, 'name' | 'counter' | 'lastUsedAt' | 'credentialBackedUp' | 'credentialDeviceType'>>,
+) {
+  return mutate((db) => {
+    const cred = db.credentials.find((c) => c.id === id && c.passkeyUserId === passkeyUserId);
+    if (!cred) return undefined;
+    Object.assign(cred, patch);
+    return { ...cred };
+  });
+}
+
+export async function deleteCredential(id: string, passkeyUserId: string) {
+  return mutate((db) => {
+    const before = db.credentials.length;
+    db.credentials = db.credentials.filter((c) => !(c.id === id && c.passkeyUserId === passkeyUserId));
+    return db.credentials.length !== before;
+  });
+}
+
+/** Public shape of a credential returned to the browser (no public key). */
+export function toPublicCredential(c: StoredPasskeyCredential) {
+  return {
+    id: c.id,
+    name: c.name,
+    aaguid: c.aaguid,
+    providerIcon: c.providerIcon,
+    providerIconDark: c.providerIconDark,
+    credentialDeviceType: c.credentialDeviceType,
+    credentialBackedUp: c.credentialBackedUp,
+    transports: c.transports,
+    registeredAt: c.registeredAt,
+    lastUsedAt: c.lastUsedAt,
+  };
+}
+
+/* -------------------------------------------------------------------------- */
+/* AAGUID → provider name / icon (UX hint only, never a security signal)      */
+/* -------------------------------------------------------------------------- */
+
+const AAGUID_REGISTRY_URL =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+type AaguidEntry = { name: string; icon_light?: string; icon_dark?: string };
+let registry: Promise<Record<string, AaguidEntry>> | null = null;
+
+function loadRegistry() {
+  registry ??= fetch(AAGUID_REGISTRY_URL, { signal: AbortSignal.timeout(5000) })
+    .then((r) => (r.ok ? r.json() : {}))
+    .catch(() => {
+      registry = null; // retry on the next registration
+      return {};
+    });
+  return registry;
+}
+
+export async function lookupProvider(aaguid: string, userAgent: string | null) {
+  if (aaguid !== ZERO_AAGUID) {
+    const entry = (await loadRegistry())[aaguid];
+    if (entry) return { name: entry.name, icon: entry.icon_light, iconDark: entry.icon_dark };
+  }
+  return { name: guessDeviceName(userAgent) ?? 'Unknown passkey provider' };
+}
+
+function guessDeviceName(ua: string | null): string | undefined {
+  if (!ua) return undefined;
+  const os = /iPhone|iPad/.test(ua) ? 'iOS' : /Android/.test(ua) ? 'Android' : /Mac OS X/.test(ua) ? 'macOS'
+    : /Windows/.test(ua) ? 'Windows' : /CrOS/.test(ua) ? 'ChromeOS' : /Linux/.test(ua) ? 'Linux' : undefined;
+  return os ? `Passkey on ${os}` : undefined;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Session helpers                                                            */
+/* -------------------------------------------------------------------------- */
+
+export interface SessionUser {
+  username: string;
+}
+
+export type ChallengeKind = 'register' | 'login' | 'reauth';
+
+export interface PendingChallenge {
+  kind: ChallengeKind;
+  challenge: string;
+  userVerification: 'preferred' | 'required';
+  conditional?: boolean;
+  createdAt: number;
+}
+
+const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+/** How long a passkey reauthentication unlocks sensitive actions. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+/** Conditional create is only allowed right after a password sign-in. */
+export const CONDITIONAL_CREATE_WINDOW_MS = 2 * 60 * 1000;
+
+export async function getSessionUser(session: AstroSession | undefined) {
+  const user = (await session?.get('user')) as SessionUser | undefined;
+  return user?.username ? user : undefined;
+}
+
+export async function signIn(session: AstroSession | undefined, username: string, method: 'password' | 'passkey' | 'signup') {
+  if (!session) throw new Error('Sessions are not configured');
+  const readingList = await session.get('readingList');
+  // Prevent session fixation.
+  await session.regenerate();
+  session.set('readingList', readingList ?? []);
+  session.set('user', { username } satisfies SessionUser);
+  session.set('signedInAt', Date.now());
+  if (method === 'password') session.set('passwordSignInAt', Date.now());
+  else session.delete('passwordSignInAt');
+  // A fresh passkey sign-in counts as a recent verification.
+  if (method === 'passkey') session.set('reauthAt', Date.now());
+  else session.delete('reauthAt');
+}
+
+export function signOut(session: AstroSession | undefined, _cookies?: AstroCookies) {
+  session?.destroy();
+}
+
+export function storeChallenge(session: AstroSession | undefined, pending: Omit<PendingChallenge, 'createdAt'>) {
+  session?.set('webauthnChallenge', { ...pending, createdAt: Date.now() } satisfies PendingChallenge);
+}
+
+/** Retrieves and consumes the pending challenge (single use). */
+export async function takeChallenge(session: AstroSession | undefined, kind: ChallengeKind) {
+  const pending = (await session?.get('webauthnChallenge')) as PendingChallenge | undefined;
+  session?.delete('webauthnChallenge');
+  if (!pending || pending.kind !== kind || Date.now() - pending.createdAt > CHALLENGE_TTL_MS) return undefined;
+  return pending;
+}
+
+export async function hasRecentReauth(session: AstroSession | undefined) {
+  const at = (await session?.get('reauthAt')) as number | undefined;
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+/* -------------------------------------------------------------------------- */
+/* Response helpers                                                           */
+/* -------------------------------------------------------------------------- */
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function unauthorized() {
+  return json({ error: 'You need to be signed in.', code: 'UNAUTHENTICATED' }, 401);
+}
