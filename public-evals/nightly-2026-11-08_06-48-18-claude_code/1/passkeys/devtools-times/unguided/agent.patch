+++ b/src/lib/auth/timesApi.ts
@@ -0,0 +1,26 @@
+/** Client for the external Times account API that owns password credentials. */
+const TIMES_API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface TimesApiResult {
+  ok: boolean;
+  status: number;
+  data: any;
+}
+
+async function call(path: 'login' | 'register', username: string, password: string): Promise<TimesApiResult> {
+  const response = await fetch(`${TIMES_API}/${path}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+  let data: any = {};
+  try {
+    data = await response.json();
+  } catch {
+    // non-JSON body
+  }
+  return { ok: response.ok, status: response.status, data };
+}
+
+export const verifyPassword = (username: string, password: string) => call('login', username, password);
+export const registerPassword = (username: string, password: string) => call('register', username, password);
