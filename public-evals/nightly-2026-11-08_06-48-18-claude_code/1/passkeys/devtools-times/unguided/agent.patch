new file mode 100644
index 0000000..0b29a31
--- /dev/null
+++ b/src/components/auth/PasskeyUpsell.tsx
@@ -0,0 +1,57 @@
+import React, { useState } from 'react';
+import { FingerPrintIcon } from '@heroicons/react/24/outline';
+import { describeError, isCancellation, registerPasskey } from '../../lib/auth/client';
+import { Alert, Button } from './ui';
+
+/**
+ * Offered right after a password sign-in/sign-up for accounts without a passkey.
+ */
+export default function PasskeyUpsell({ username, onDone }: { username: string; onDone: () => void }) {
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [created, setCreated] = useState(false);
+
+  const create = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      await registerPasskey();
+      setCreated(true);
+      setTimeout(onDone, 1200);
+    } catch (err) {
+      if (!isCancellation(err)) setError(describeError(err));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className="text-center" aria-live="polite">
+      <FingerPrintIcon className="w-12 h-12 mx-auto text-gray-800" aria-hidden="true" />
+      {created ? (
+        <>
+          <h3 className="mt-4 text-lg font-semibold text-gray-900">Passkey created</h3>
+          <p className="mt-2 text-sm text-gray-600">Next time, sign in with just your fingerprint, face, or screen lock.</p>
+        </>
+      ) : (
+        <>
+          <h3 className="mt-4 text-lg font-semibold text-gray-900">Welcome, {username}! Sign in faster next time</h3>
+          <p className="mt-2 mb-6 text-sm text-gray-600">
+            Create a passkey to sign in with your fingerprint, face, or screen lock. Passkeys can’t be phished
+            or leaked, and you won’t need to remember a password.
+          </p>
+          {error && <Alert kind="error">{error}</Alert>}
+          <div className="flex flex-col gap-2">
+            <Button onClick={create} loading={loading}>
+              <FingerPrintIcon className="w-5 h-5" aria-hidden="true" />
+              {loading ? 'Waiting for passkey…' : 'Create a passkey'}
+            </Button>
+            <Button variant="secondary" onClick={onDone} disabled={loading}>
+              Not now
+            </Button>
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/auth/ReauthDialog.tsx b/src/components/auth/ReauthDialog.tsx
new file mode 100644
index 0000000..0f932f8
--- /dev/null
+++ b/src/components/auth/ReauthDialog.tsx
@@ -0,0 +1,131 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { FingerPrintIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import {
+  api,
+  authenticateWithPasskey,
+  describeError,
+  isCancellation,
+  type PublicAccount,
+} from '../../lib/auth/client';
+import { Alert, Button, Divider, inputClass } from './ui';
+
+interface Props {
+  account: PublicAccount;
+  reason: string;
+  onSuccess: (account: PublicAccount) => void;
+  onCancel: () => void;
+}
+
+/** Modal that asks the signed-in user to confirm their identity before a sensitive change. */
+export default function ReauthDialog({ account, reason, onSuccess, onCancel }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState<'passkey' | 'password' | null>(null);
+  const hasPasskeys = account.passkeys.length > 0;
+
+  useEffect(() => {
+    const dialog = ref.current;
+    if (dialog && !dialog.open) dialog.showModal();
+    return () => dialog?.close();
+  }, []);
+
+  const withPasskey = async () => {
+    setError(null);
+    setBusy('passkey');
+    try {
+      const { account: fresh } = await authenticateWithPasskey({ purpose: 'reauth' });
+      onSuccess(fresh);
+    } catch (err) {
+      setError(isCancellation(err) ? 'Verification was cancelled. Try again to continue.' : describeError(err));
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const withPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setBusy('password');
+    try {
+      const fresh = await api<PublicAccount>('reauth/password', { body: { password } });
+      setPassword('');
+      onSuccess(fresh);
+    } catch (err) {
+      setError(describeError(err));
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  return (
+    <dialog
+      ref={ref}
+      onCancel={(e) => {
+        e.preventDefault();
+        if (!busy) onCancel();
+      }}
+      aria-labelledby="reauth-title"
+      className="m-auto w-full max-w-sm rounded-lg p-6 shadow-xl backdrop:bg-black/50"
+    >
+      <div className="text-center">
+        <ShieldCheckIcon className="w-10 h-10 mx-auto text-gray-800" aria-hidden="true" />
+        <h3 id="reauth-title" className="mt-3 text-lg font-semibold text-gray-900">
+          Confirm it’s you
+        </h3>
+        <p className="mt-1 mb-5 text-sm text-gray-600">{reason}</p>
+      </div>
+
+      {error && <Alert kind="error">{error}</Alert>}
+
+      {hasPasskeys && (
+        <Button onClick={withPasskey} loading={busy === 'passkey'} disabled={!!busy} className="w-full" autoFocus>
+          <FingerPrintIcon className="w-5 h-5" aria-hidden="true" />
+          {busy === 'passkey' ? 'Waiting for passkey…' : 'Verify with a passkey'}
+        </Button>
+      )}
+
+      {hasPasskeys && account.hasPassword && <Divider label="or" />}
+
+      {account.hasPassword && (
+        <form onSubmit={withPassword} className="space-y-3">
+          {/* Hidden username helps password managers fill the right credential */}
+          <input type="text" name="username" autoComplete="username" value={account.username} readOnly hidden />
+          <div>
+            <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700 mb-1">
+              Password
+            </label>
+            <input
+              id="reauth-password"
+              type="password"
+              autoComplete="current-password"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              required
+              autoFocus={!hasPasskeys}
+              className={inputClass}
+            />
+          </div>
+          <Button
+            type="submit"
+            variant={hasPasskeys ? 'secondary' : 'primary'}
+            loading={busy === 'password'}
+            disabled={!!busy}
+            className="w-full"
+          >
+            {busy === 'password' ? 'Verifying…' : 'Verify with password'}
+          </Button>
+        </form>
+      )}
+
+      <button
+        type="button"
+        onClick={onCancel}
+        disabled={!!busy}
+        className="mt-4 w-full text-sm text-gray-600 hover:text-gray-900 underline disabled:opacity-50"
+      >
+        Cancel
+      </button>
+    </dialog>
+  );
+}
diff --git a/src/components/auth/ui.tsx b/src/components/auth/ui.tsx
new file mode 100644
index 0000000..2efb040
--- /dev/null
+++ b/src/components/auth/ui.tsx
@@ -0,0 +1,69 @@
+import React from 'react';
+
+export const inputClass =
+  'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+const primary =
+  'bg-gray-900 text-white hover:bg-gray-800 focus:ring-gray-900 border-transparent';
+const secondary =
+  'bg-white text-gray-900 border-gray-300 hover:bg-gray-50 focus:ring-gray-400';
+const danger = 'bg-red-600 text-white hover:bg-red-700 focus:ring-red-600 border-transparent';
+
+export function Button({
+  variant = 'primary',
+  loading,
+  className = '',
+  children,
+  ...props
+}: React.ButtonHTMLAttributes<HTMLButtonElement> & {
+  variant?: 'primary' | 'secondary' | 'danger';
+  loading?: boolean;
+}) {
+  const v = variant === 'primary' ? primary : variant === 'danger' ? danger : secondary;
+  return (
+    <button
+      {...props}
+      disabled={props.disabled || loading}
+      aria-busy={loading || undefined}
+      className={`inline-flex items-center justify-center gap-2 py-2 px-4 border rounded-md shadow-sm text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed ${v} ${className}`}
+    >
+      {children}
+    </button>
+  );
+}
+
+export function Alert({ kind, children }: { kind: 'error' | 'success' | 'info'; children: React.ReactNode }) {
+  const styles =
+    kind === 'error'
+      ? 'text-red-700 bg-red-100'
+      : kind === 'success'
+        ? 'text-green-700 bg-green-100'
+        : 'text-blue-800 bg-blue-50';
+  return (
+    <div className={`mb-4 p-3 text-sm rounded-lg ${styles}`} role={kind === 'error' ? 'alert' : 'status'}>
+      {children}
+    </div>
+  );
+}
+
+export function Divider({ label }: { label: string }) {
+  return (
+    <div className="relative my-6" aria-hidden="true">
+      <div className="absolute inset-0 flex items-center">
+        <div className="w-full border-t border-gray-200" />
+      </div>
+      <div className="relative flex justify-center text-xs uppercase tracking-wide">
+        <span className="bg-white px-2 text-gray-500">{label}</span>
+      </div>
+    </div>
+  );
+}
+
+export function Card({ title, children }: { title: string; children: React.ReactNode }) {
+  return (
+    <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <h2 className="text-2xl font-bold mb-6 text-center text-gray-800">{title}</h2>
+      {children}
+    </div>
+  );
+}
