@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import {
+  errorJson,
+  getCurrentUser,
+  isRecentlyAuthenticated,
+  json,
+  toPublicAccount,
+  toPublicPasskey,
+} from '../../../../lib/auth/session';
+import { removePasskey, updatePasskey } from '../../../../lib/auth/store';
+import { getRelyingParty } from '../../../../lib/auth/webauthn';
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async (context) => {
+  const current = await getCurrentUser(context);
+  if (!current) return errorJson('UNAUTHENTICATED', 'Not signed in.', 401);
+  const { name } = await context.request.json().catch(() => ({}));
+  const trimmed = typeof name === 'string' ? name.trim() : '';
+  if (!trimmed || trimmed.length > 64) {
+    return errorJson('INVALID_NAME', 'Passkey names must be 1–64 characters.', 400);
+  }
+  const updated = await updatePasskey(current.user.id, context.params.id!, { name: trimmed });
+  if (!updated) return errorJson('NOT_FOUND', 'Passkey not found.', 404);
+  return json({ passkey: toPublicPasskey(updated) });
+};
+
+/** Delete a passkey. Requires recent authentication. */
+export const DELETE: APIRoute = async (context) => {
+  const current = await getCurrentUser(context);
+  if (!current) return errorJson('UNAUTHENTICATED', 'Not signed in.', 401);
+  const { user, auth } = current;
+  const id = context.params.id!;
+
+  if (!user.passkeys.some((p) => p.id === id)) return errorJson('NOT_FOUND', 'Passkey not found.', 404);
+  if (!user.hasPassword && user.passkeys.length <= 1) {
+    return errorJson(
+      'LAST_SIGN_IN_METHOD',
+      'This is your only way to sign in. Add another passkey before removing this one.',
+      400,
+    );
+  }
+  if (!isRecentlyAuthenticated(auth)) {
+    return errorJson('REAUTH_REQUIRED', 'Please confirm it’s you before removing a passkey.', 401);
+  }
+
+  await removePasskey(user.id, id);
+  const fresh = await getCurrentUser(context);
+  return json({ account: toPublicAccount(fresh!.user, fresh!.auth, getRelyingParty(context).rpID) });
+};
