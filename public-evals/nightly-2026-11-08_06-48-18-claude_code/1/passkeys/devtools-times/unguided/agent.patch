+import type { APIRoute } from 'astro';
+import { errorJson, json, signIn } from '../../../lib/auth/session';
+import { findUserByUsername, upsertPasswordUser } from '../../../lib/auth/store';
+import { registerPassword } from '../../../lib/auth/timesApi';
+
+/** Password sign-up, proxied to the Times API. Signs the new user in on success. */
+export const POST: APIRoute = async (context) => {
+  const { username, password } = await context.request.json().catch(() => ({}));
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return errorJson('INVALID_REQUEST', 'Username and password are required.', 400);
+  }
+  const existing = await findUserByUsername(username);
+  if (existing && !existing.hasPassword) {
+    return errorJson('USERNAME_TAKEN', 'That username is already taken.', 409);
+  }
+  try {
+    const result = await registerPassword(username.trim(), password);
+    if (!result.ok) return json(result.data, result.status);
+    const user = await upsertPasswordUser(username);
+    await signIn(context, user.id, 'password');
+    return json({ ok: true, username: user.username, passkeyCount: user.passkeys.length });
+  } catch (err) {
+    console.error('[auth] register failed', err);
+    return errorJson('UPSTREAM_ERROR', 'Could not reach the sign-up service.', 502);
+  }
+};
