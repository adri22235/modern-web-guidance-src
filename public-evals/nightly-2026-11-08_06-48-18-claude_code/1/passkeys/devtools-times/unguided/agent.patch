@@ -0,0 +1,29 @@
+import type { APIRoute } from 'astro';
+import { errorJson, getCurrentUser, json, markReauthenticated, toPublicAccount } from '../../../../lib/auth/session';
+import { verifyPassword } from '../../../../lib/auth/timesApi';
+import { getRelyingParty } from '../../../../lib/auth/webauthn';
+
+/** Reauthenticate the signed-in user with their password. */
+export const POST: APIRoute = async (context) => {
+  const current = await getCurrentUser(context);
+  if (!current) return errorJson('UNAUTHENTICATED', 'Not signed in.', 401);
+  if (!current.user.hasPassword) {
+    return errorJson('NO_PASSWORD', 'This account does not have a password. Use a passkey instead.', 400);
+  }
+  const { password } = await context.request.json().catch(() => ({}));
+  if (typeof password !== 'string' || !password) {
+    return errorJson('INVALID_REQUEST', 'Password is required.', 400);
+  }
+  try {
+    const result = await verifyPassword(current.user.username, password);
+    if (!result.ok) {
+      return errorJson('INVALID_PASSWORD', 'That password is incorrect.', 401, { upstream: result.data?.error });
+    }
+  } catch (err) {
+    console.error('[auth] password reauth failed', err);
+    return errorJson('UPSTREAM_ERROR', 'Could not reach the sign-in service.', 502);
+  }
+  await markReauthenticated(context, 'password');
+  const fresh = await getCurrentUser(context);
+  return json(toPublicAccount(fresh!.user, fresh!.auth, getRelyingParty(context).rpID));
+};
