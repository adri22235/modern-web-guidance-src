index 0000000..46c3aef
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,422 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  CheckIcon,
+  CloudIcon,
+  DevicePhoneMobileIcon,
+  FingerPrintIcon,
+  KeyIcon,
+  LockClosedIcon,
+  PencilIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+  XMarkIcon,
+} from '@heroicons/react/24/outline';
+import {
+  api,
+  describeError,
+  isCancellation,
+  isReauthRequired,
+  pageUrl,
+  passkeysSupported,
+  registerPasskey,
+  syncPasskeyProvider,
+  type PublicAccount,
+  type PublicPasskey,
+} from '../lib/auth/client';
+import ReauthDialog from './auth/ReauthDialog';
+import { Alert, Button, inputClass } from './auth/ui';
+
+const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
+const timeFmt = new Intl.DateTimeFormat('en-US', { timeStyle: 'short' });
+
+function relative(iso: string | null) {
+  if (!iso) return 'Never';
+  const diff = Date.now() - new Date(iso).getTime();
+  const min = Math.round(diff / 60000);
+  if (min < 1) return 'Just now';
+  if (min < 60) return `${min} min ago`;
+  const h = Math.round(min / 60);
+  if (h < 24) return `${h} hr ago`;
+  return dateFmt.format(new Date(iso));
+}
+
+interface PendingReauth {
+  reason: string;
+  resolve: (ok: boolean) => void;
+}
+
+export default function AccountSettings({ initialAccount }: { initialAccount: PublicAccount }) {
+  const [account, setAccount] = useState(initialAccount);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [supported, setSupported] = useState(true);
+  const [reauth, setReauth] = useState<PendingReauth | null>(null);
+  const [now, setNow] = useState(() => Date.now());
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    // Tell the passkey provider which credentials are still valid and the current username.
+    void syncPasskeyProvider(initialAccount);
+    const t = setInterval(() => setNow(Date.now()), 15000);
+    return () => clearInterval(t);
+  }, [initialAccount]);
+
+  const recentlyVerified = account.reauthValidUntil > now;
+
+  const refresh = useCallback(async () => {
+    const fresh = await api<PublicAccount>('me');
+    setAccount(fresh);
+    return fresh;
+  }, []);
+
+  const requestReauth = useCallback(
+    (reason: string) => new Promise<boolean>((resolve) => setReauth({ reason, resolve })),
+    [],
+  );
+
+  /** Run a sensitive action; if the server asks for reauthentication, prompt and retry once. */
+  const withReauth = useCallback(
+    async <T,>(reason: string, action: () => Promise<T>): Promise<T | undefined> => {
+      try {
+        return await action();
+      } catch (err) {
+        if (!isReauthRequired(err)) throw err;
+        const ok = await requestReauth(reason);
+        if (!ok) return undefined;
+        return await action();
+      }
+    },
+    [requestReauth],
+  );
+
+  const flash = (msg: string) => {
+    setError(null);
+    setNotice(msg);
+  };
+
+  const handleAdd = async () => {
+    setError(null);
+    setNotice(null);
+    setAdding(true);
+    try {
+      const result = await withReauth('For your security, verify your identity before adding a new passkey.', () =>
+        registerPasskey(),
+      );
+      if (result) {
+        if (result.account) setAccount(result.account);
+        else await refresh();
+        flash(`Passkey “${result.passkey.name}” created.`);
+      }
+    } catch (err) {
+      if (!isCancellation(err)) setError(describeError(err));
+    } finally {
+      setAdding(false);
+    }
+  };
+
+  const handleRename = async (passkey: PublicPasskey, name: string) => {
+    setError(null);
+    try {
+      const { passkey: updated } = await api<{ passkey: PublicPasskey }>(
+        `passkeys/${encodeURIComponent(passkey.id)}`,
+        { method: 'PATCH', body: { name } },
+      );
+      setAccount((a) => ({ ...a, passkeys: a.passkeys.map((p) => (p.id === updated.id ? updated : p)) }));
+      flash('Passkey renamed.');
+      return true;
+    } catch (err) {
+      setError(describeError(err));
+      return false;
+    }
+  };
+
+  const handleDelete = async (passkey: PublicPasskey) => {
+    setError(null);
+    setNotice(null);
+    try {
+      const result = await withReauth(
+        `Verify your identity to remove the passkey “${passkey.name}”.`,
+        () =>
+          api<{ account: PublicAccount }>(`passkeys/${encodeURIComponent(passkey.id)}`, {
+            method: 'DELETE',
+          }),
+      );
+      if (result) {
+        setAccount(result.account);
+        // Ask the passkey provider to hide the removed passkey from future sign-in prompts.
+        void syncPasskeyProvider(result.account);
+        flash(
+          `Passkey “${passkey.name}” removed. You may also want to delete it from your device or password manager.`,
+        );
+      }
+    } catch (err) {
+      setError(describeError(err));
+    }
+  };
+
+  const handleVerifyNow = async () => {
+    setError(null);
+    const ok = await requestReauth('Verify your identity to manage your sign-in methods for the next few minutes.');
+    if (ok) flash('Identity confirmed.');
+  };
+
+  const handleSignOut = async () => {
+    await api('logout', { method: 'POST' }).catch(() => undefined);
+    window.location.assign(pageUrl());
+  };
+
+  const onlyMethod = !account.hasPassword && account.passkeys.length <= 1;
+
+  return (
+    <div className="max-w-3xl mx-auto py-10 px-4 sm:px-6">
+      <h1 className="text-3xl font-bold text-gray-900">Account settings</h1>
+      <p className="mt-1 text-sm text-gray-600">Manage how you sign in to The DevTools Times.</p>
+
+      <div className="mt-6" aria-live="polite">
+        {error && <Alert kind="error">{error}</Alert>}
+        {notice && <Alert kind="success">{notice}</Alert>}
+      </div>
+
+      {/* Profile */}
+      <section className="mt-2 border border-gray-200 rounded-lg p-6" aria-labelledby="profile-heading">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div>
+            <h2 id="profile-heading" className="text-lg font-semibold text-gray-900">
+              Profile
+            </h2>
+            <dl className="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
+              <dt className="text-gray-500">Username</dt>
+              <dd className="font-medium text-gray-900">{account.username}</dd>
+              <dt className="text-gray-500">Member since</dt>
+              <dd className="text-gray-900">{dateFmt.format(new Date(account.createdAt))}</dd>
+              <dt className="text-gray-500">Password</dt>
+              <dd className="text-gray-900">{account.hasPassword ? 'Set' : 'Not set (passkey-only account)'}</dd>
+            </dl>
+          </div>
+          <Button variant="secondary" onClick={handleSignOut}>
+            Sign out
+          </Button>
+        </div>
+      </section>
+
+      {/* Passkeys */}
+      <section className="mt-6 border border-gray-200 rounded-lg p-6" aria-labelledby="passkeys-heading">
+        <div className="flex flex-wrap items-start justify-between gap-4">
+          <div className="max-w-lg">
+            <h2 id="passkeys-heading" className="text-lg font-semibold text-gray-900 flex items-center gap-2">
+              <FingerPrintIcon className="w-5 h-5" aria-hidden="true" /> Passkeys
+            </h2>
+            <p className="mt-1 text-sm text-gray-600">
+              Passkeys let you sign in securely with your fingerprint, face, screen lock, or security key. They
+              are stored on your device or in your password manager and can’t be phished.
+            </p>
+          </div>
+          {supported && (
+            <Button onClick={handleAdd} loading={adding}>
+              <PlusIcon className="w-4 h-4" aria-hidden="true" />
+              {adding ? 'Waiting for passkey…' : 'Create a passkey'}
+            </Button>
+          )}
+        </div>
+
+        {!supported && (
+          <div className="mt-4">
+            <Alert kind="info">This browser doesn’t support passkeys. Try a recent version of Chrome, Safari, Edge or Firefox.</Alert>
+          </div>
+        )}
+
+        <div className="mt-4 flex items-center gap-2 text-xs text-gray-600" role="status">
+          {recentlyVerified ? (
+            <>
+              <ShieldCheckIcon className="w-4 h-4 text-green-600" aria-hidden="true" />
+              Identity verified — you can add or remove passkeys until{' '}
+              {timeFmt.format(new Date(account.reauthValidUntil))}.
+            </>
+          ) : (
+            <>
+              <LockClosedIcon className="w-4 h-4" aria-hidden="true" />
+              Adding or removing passkeys requires confirming it’s you.
+              <button type="button" onClick={handleVerifyNow} className="underline font-medium text-gray-900">
+                Verify now
+              </button>
+            </>
+          )}
+        </div>
+
+        {account.passkeys.length === 0 ? (
+          <div className="mt-6 rounded-md border border-dashed border-gray-300 p-6 text-center text-sm text-gray-600">
+            <KeyIcon className="w-8 h-8 mx-auto mb-2 text-gray-400" aria-hidden="true" />
+            You haven’t created any passkeys yet.
+          </div>
+        ) : (
+          <ul className="mt-6 divide-y divide-gray-200 border-t border-b border-gray-200">
+            {account.passkeys.map((p) => (
+              <PasskeyRow
+                key={p.id}
+                passkey={p}
+                canDelete={!onlyMethod}
+                onRename={(name) => handleRename(p, name)}
+                onDelete={() => handleDelete(p)}
+              />
+            ))}
+          </ul>
+        )}
+        {onlyMethod && account.passkeys.length === 1 && (
+          <p className="mt-3 text-xs text-gray-500">
+            This passkey is your only way to sign in, so it can’t be removed. Create another passkey first.
+          </p>
+        )}
+      </section>
+
+      {reauth && (
+        <ReauthDialog
+          account={account}
+          reason={reauth.reason}
+          onSuccess={(fresh) => {
+            setAccount(fresh);
+            setNow(Date.now());
+            reauth.resolve(true);
+            setReauth(null);
+          }}
+          onCancel={() => {
+            reauth.resolve(false);
+            setReauth(null);
+          }}
+        />
+      )}
+    </div>
+  );
+}
+
+function PasskeyRow({
+  passkey,
+  canDelete,
+  onRename,
+  onDelete,
+}: {
+  passkey: PublicPasskey;
+  canDelete: boolean;
+  onRename: (name: string) => Promise<boolean>;
+  onDelete: () => Promise<void>;
+}) {
+  const [editing, setEditing] = useState(false);
+  const [name, setName] = useState(passkey.name);
+  const [confirming, setConfirming] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    if (editing) inputRef.current?.select();
+  }, [editing]);
+
+  const save = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (name.trim() === passkey.name) return setEditing(false);
+    setBusy(true);
+    if (await onRename(name.trim())) setEditing(false);
+    setBusy(false);
+  };
+
+  const remove = async () => {
+    setBusy(true);
+    await onDelete();
+    setBusy(false);
+    setConfirming(false);
+  };
+
+  const synced = passkey.backedUp || passkey.deviceType === 'multiDevice';
+  const isSecurityKey = !synced && (passkey.transports.includes('usb') || passkey.transports.includes('nfc'));
+
+  return (
+    <li className="py-4 flex flex-wrap items-center gap-4">
+      <div className="flex-shrink-0 w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center" aria-hidden="true">
+        {synced ? <CloudIcon className="w-5 h-5 text-gray-700" /> : isSecurityKey ? <KeyIcon className="w-5 h-5 text-gray-700" /> : <DevicePhoneMobileIcon className="w-5 h-5 text-gray-700" />}
+      </div>
+
+      <div className="flex-1 min-w-[12rem]">
+        {editing ? (
+          <form onSubmit={save} className="flex items-center gap-2">
+            <label htmlFor={`name-${passkey.id}`} className="sr-only">
+              Passkey name
+            </label>
+            <input
+              ref={inputRef}
+              id={`name-${passkey.id}`}
+              value={name}
+              maxLength={64}
+              onChange={(e) => setName(e.target.value)}
+              onKeyDown={(e) => {
+                if (e.key === 'Escape') {
+                  setName(passkey.name);
+                  setEditing(false);
+                }
+              }}
+              className={`${inputClass} py-1 text-sm`}
+              required
+            />
+            <button type="submit" disabled={busy} className="p-1 text-gray-700 hover:text-gray-900" aria-label="Save name">
+              <CheckIcon className="w-5 h-5" />
+            </button>
+            <button
+              type="button"
+              onClick={() => {
+                setName(passkey.name);
+                setEditing(false);
+              }}
+              className="p-1 text-gray-500 hover:text-gray-900"
+              aria-label="Cancel rename"
+            >
+              <XMarkIcon className="w-5 h-5" />
+            </button>
+          </form>
+        ) : (
+          <p className="font-medium text-gray-900 break-all">{passkey.name}</p>
+        )}
+        <p className="mt-1 text-xs text-gray-500 flex flex-wrap gap-x-3 gap-y-1">
+          {passkey.provider && passkey.provider !== passkey.name && <span>{passkey.provider}</span>}
+          <span>{synced ? 'Synced across devices' : isSecurityKey ? 'Security key' : 'This device only'}</span>
+          <span>Created {dateFmt.format(new Date(passkey.createdAt))}</span>
+          <span>Last used {relative(passkey.lastUsedAt)}</span>
+        </p>
+      </div>
+
+      {confirming ? (
+        <div className="flex items-center gap-2" role="group" aria-label={`Confirm removal of ${passkey.name}`}>
+          <span className="text-sm text-gray-700">Remove this passkey?</span>
+          <Button variant="danger" onClick={remove} loading={busy} className="py-1 px-3">
+            Remove
+          </Button>
+          <Button variant="secondary" onClick={() => setConfirming(false)} disabled={busy} className="py-1 px-3">
+            Cancel
+          </Button>
+        </div>
+      ) : (
+        !editing && (
+          <div className="flex items-center gap-1">
+            <button
+              type="button"
+              onClick={() => setEditing(true)}
+              className="p-2 rounded text-gray-600 hover:text-gray-900 hover:bg-gray-100"
+              aria-label={`Rename ${passkey.name}`}
+              title="Rename"
+            >
+              <PencilIcon className="w-5 h-5" />
+            </button>
+            <button
+              type="button"
+              onClick={() => setConfirming(true)}
+              disabled={!canDelete}
+              className="p-2 rounded text-gray-600 hover:text-red-700 hover:bg-red-50 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-gray-600"
+              aria-label={`Remove ${passkey.name}`}
+              title={canDelete ? 'Remove' : 'You can’t remove your only sign-in method'}
+            >
+              <TrashIcon className="w-5 h-5" />
+            </button>
+          </div>
+        )
+      )}
+    </li>
+  );
+}
