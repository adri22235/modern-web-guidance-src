+/**
+ * Browser-side helpers for passkey ceremonies and the auth API.
+ */
+import {
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  sendSignal,
+  startAuthentication,
+  startRegistration,
+  WebAuthnAbortService,
+  WebAuthnError,
+} from '@simplewebauthn/browser';
+import type { PublicAccount, PublicPasskey } from './session';
+
+export type { PublicAccount, PublicPasskey };
+
+const BASE = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
+export const authUrl = (path: string) => `${BASE}api/auth/${path}`;
+export const pageUrl = (path = '') => `${BASE}${path}`;
+
+export class ApiError extends Error {
+  constructor(
+    public code: string,
+    message: string,
+    public status: number,
+    public data: any = {},
+  ) {
+    super(message);
+  }
+}
+
+export async function api<T = any>(path: string, init: { method?: string; body?: unknown } = {}): Promise<T> {
+  const response = await fetch(authUrl(path), {
+    method: init.method ?? (init.body !== undefined ? 'POST' : 'GET'),
+    headers: init.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+    body: init.body !== undefined ? JSON.stringify(init.body) : undefined,
+    credentials: 'same-origin',
+  });
+  let data: any = {};
+  try {
+    data = await response.json();
+  } catch {
+    // ignore
+  }
+  if (!response.ok) {
+    throw new ApiError(data.error || 'UNKNOWN', data.message || data.error || 'Something went wrong.', response.status, data);
+  }
+  return data as T;
+}
+
+export const isReauthRequired = (err: unknown) => err instanceof ApiError && err.code === 'REAUTH_REQUIRED';
+
+export function passkeysSupported() {
+  return typeof window !== 'undefined' && browserSupportsWebAuthn();
+}
+
+export { browserSupportsWebAuthnAutofill };
+
+/** Error codes that just mean "the user dismissed the dialog". */
+export function isCancellation(err: unknown) {
+  if (err instanceof WebAuthnError) {
+    if (err.code === 'ERROR_CEREMONY_ABORTED') return true;
+    const cause = err.cause as Error | undefined;
+    return cause?.name === 'NotAllowedError' || cause?.name === 'AbortError';
+  }
+  return err instanceof Error && (err.name === 'NotAllowedError' || err.name === 'AbortError');
+}
+
+export function describeError(err: unknown): string {
+  if (err instanceof ApiError) return err.message;
+  if (err instanceof WebAuthnError) {
+    switch (err.code) {
+      case 'ERROR_AUTHENTICATOR_PREVIOUSLY_REGISTERED':
+        return 'A passkey for this account already exists on this device or password manager.';
+      case 'ERROR_INVALID_DOMAIN':
+      case 'ERROR_INVALID_RP_ID':
+        return 'Passkeys aren’t available on this domain. Make sure you are using HTTPS (or localhost).';
+      case 'ERROR_AUTHENTICATOR_MISSING_DISCOVERABLE_CREDENTIAL_SUPPORT':
+        return 'This security key can’t store passkeys. Try your device or password manager instead.';
+      case 'ERROR_AUTHENTICATOR_MISSING_USER_VERIFICATION_SUPPORT':
+        return 'This authenticator can’t verify your identity (PIN or biometrics required).';
+    }
+  }
+  if (isCancellation(err)) return 'The passkey request was cancelled or timed out.';
+  return 'Something went wrong with your passkey. Please try again.';
+}
+
+async function signal(opts: Parameters<typeof sendSignal>[0]) {
+  try {
+    await sendSignal(opts);
+  } catch {
+    // Signals are best-effort; unsupported browsers just ignore them.
+  }
+}
+
+/**
+ * Keep the user's passkey provider in sync with the server: hide deleted
+ * passkeys and update the displayed username.
+ */
+export async function syncPasskeyProvider(account: PublicAccount) {
+  await signal({
+    signalName: 'allAcceptedCredentials',
+    rpID: account.rpID,
+    userID: account.id,
+    allAcceptedCredentialIDs: account.passkeys.map((p) => p.id),
+  });
+  await signal({
+    signalName: 'currentUserDetails',
+    rpID: account.rpID,
+    userID: account.id,
+    userName: account.username,
+    userDisplayName: account.username,
+  });
+}
+
+/**
+ * Create a passkey. Signed out + username: creates a new passkey-only account.
+ * Signed in: adds a passkey to the current account.
+ * `autoRegister` performs a conditional create (no UI) right after a password sign-in.
+ */
+export async function registerPasskey(opts: { username?: string; autoRegister?: boolean } = {}) {
+  const optionsJSON = await api('passkeys/register-options', { body: { username: opts.username } });
+  const response = await startRegistration({ optionsJSON, useAutoRegister: opts.autoRegister });
+  const result = await api<{ passkey: PublicPasskey; account: PublicAccount | null }>('passkeys/register-verify', {
+    body: { response },
+  });
+  if (result.account) void syncPasskeyProvider(result.account);
+  return result;
+}
+
+/**
+ * Authenticate with a passkey.
+ * - purpose 'signin' + autofill: conditional UI on an input with autocomplete="username webauthn".
+ * - purpose 'reauth': confirm identity of the signed-in user.
+ */
+export async function authenticateWithPasskey(opts: { purpose: 'signin' | 'reauth'; autofill?: boolean }) {
+  const optionsJSON = await api('passkeys/login-options', { body: { purpose: opts.purpose } });
+  const response = await startAuthentication({ optionsJSON, useBrowserAutofill: opts.autofill });
+  try {
+    return await api<{ account: PublicAccount }>('passkeys/login-verify', { body: { response } });
+  } catch (err) {
+    if (err instanceof ApiError && err.code === 'UNKNOWN_CREDENTIAL') {
+      void signal({ signalName: 'unknownCredential', rpID: err.data.rpID, credentialID: err.data.credentialId });
+    }
+    throw err;
+  }
+}
+
+export function cancelPendingCeremony() {
+  WebAuthnAbortService.cancelCeremony();
+}
+
+/** Only allow same-site relative redirect targets. */
+export function safeNext(fallback = 'account') {
+  if (typeof window === 'undefined') return pageUrl(fallback);
+  const next = new URLSearchParams(window.location.search).get('next');
+  if (next && /^[a-zA-Z0-9/_-]*$/.test(next) && !next.startsWith('//')) {
+    return pageUrl(next.replace(/^\/+/, ''));
+  }
+  return pageUrl(fallback);
+}
diff --git a/src/lib/auth/session.ts b/src/lib/auth/session.ts
new file mode 100644
index 0000000..a032950
--- /dev/null
+++ b/src/lib/auth/session.ts
@@ -0,0 +1,172 @@
+import type { APIContext, AstroGlobal } from 'astro';
+import { findUserById, type StoredPasskey, type StoredUser } from './store';
+import { providerNameForAaguid } from './webauthn';
+
+/** How long after a sign-in / reauthentication sensitive actions are allowed. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+/** How long a WebAuthn challenge stays valid. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export type AuthMethod = 'password' | 'passkey';
+
+export interface AuthState {
+  userId: string;
+  method: AuthMethod;
+  /** Epoch ms of the last successful (re)authentication */
+  authenticatedAt: number;
+}
+
+export type ChallengePurpose = 'signup' | 'register' | 'signin' | 'reauth';
+
+export interface PendingChallenge {
+  challenge: string;
+  purpose: ChallengePurpose;
+  expires: number;
+  /** For register/reauth: the signed-in user. For signup: the new user's handle. */
+  userId?: string;
+  /** For signup: the requested username. */
+  username?: string;
+}
+
+type Ctx = Pick<APIContext, 'session'> | Pick<AstroGlobal, 'session'>;
+
+const AUTH_KEY = 'auth';
+const CHALLENGES_KEY = 'webauthnChallenges';
+const MAX_PENDING = 5;
+
+export async function getAuth(ctx: Ctx): Promise<AuthState | null> {
+  return ((await ctx.session?.get(AUTH_KEY)) as AuthState | undefined) ?? null;
+}
+
+export async function getCurrentUser(ctx: Ctx): Promise<{ user: StoredUser; auth: AuthState } | null> {
+  const auth = await getAuth(ctx);
+  if (!auth) return null;
+  const user = await findUserById(auth.userId);
+  if (!user) {
+    ctx.session?.delete(AUTH_KEY);
+    return null;
+  }
+  return { user, auth };
+}
+
+/** Start a fresh authenticated session (regenerating the ID to prevent fixation). */
+export async function signIn(ctx: Ctx, userId: string, method: AuthMethod) {
+  if (!ctx.session) throw new Error('Sessions are not configured');
+  const readingList = await ctx.session.get('readingList');
+  await ctx.session.regenerate();
+  ctx.session.set(AUTH_KEY, { userId, method, authenticatedAt: Date.now() } satisfies AuthState);
+  if (readingList !== undefined) ctx.session.set('readingList', readingList);
+}
+
+export async function markReauthenticated(ctx: Ctx, method: AuthMethod) {
+  const auth = await getAuth(ctx);
+  if (!auth) return;
+  ctx.session?.set(AUTH_KEY, { ...auth, method, authenticatedAt: Date.now() } satisfies AuthState);
+}
+
+export async function signOut(ctx: Ctx) {
+  ctx.session?.delete(AUTH_KEY);
+  ctx.session?.delete(CHALLENGES_KEY);
+  await ctx.session?.regenerate();
+}
+
+export function isRecentlyAuthenticated(auth: AuthState) {
+  return Date.now() - auth.authenticatedAt < REAUTH_WINDOW_MS;
+}
+
+export async function saveChallenge(ctx: Ctx, pending: Omit<PendingChallenge, 'expires'>) {
+  const now = Date.now();
+  const existing = (((await ctx.session?.get(CHALLENGES_KEY)) as PendingChallenge[] | undefined) ?? []).filter(
+    (c) => c.expires > now,
+  );
+  existing.push({ ...pending, expires: now + CHALLENGE_TTL_MS });
+  ctx.session?.set(CHALLENGES_KEY, existing.slice(-MAX_PENDING));
+}
+
+/**
+ * Look up and consume a pending challenge. Each challenge can be used once.
+ * Returns null if it doesn't exist, has expired, or was issued for another purpose.
+ */
+export async function consumeChallenge(
+  ctx: Ctx,
+  challenge: string,
+  purposes: ChallengePurpose[],
+): Promise<PendingChallenge | null> {
+  const now = Date.now();
+  const all = ((await ctx.session?.get(CHALLENGES_KEY)) as PendingChallenge[] | undefined) ?? [];
+  const match = all.find((c) => c.challenge === challenge);
+  ctx.session?.set(
+    CHALLENGES_KEY,
+    all.filter((c) => c !== match && c.expires > now),
+  );
+  if (!match || match.expires <= now || !purposes.includes(match.purpose)) return null;
+  return match;
+}
+
+/** Extract the challenge from a WebAuthn response's clientDataJSON without trusting anything else. */
+export function challengeFromClientData(clientDataJSON: string): string | null {
+  try {
+    const data = JSON.parse(Buffer.from(clientDataJSON, 'base64url').toString('utf8'));
+    return typeof data.challenge === 'string' ? data.challenge : null;
+  } catch {
+    return null;
+  }
+}
+
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  provider: string | null;
+  deviceType: StoredPasskey['deviceType'];
+  backedUp: boolean;
+  transports: string[];
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export function toPublicPasskey(p: StoredPasskey): PublicPasskey {
+  return {
+    id: p.id,
+    name: p.name,
+    provider: providerNameForAaguid(p.aaguid) ?? null,
+    deviceType: p.deviceType,
+    backedUp: p.backedUp,
+    transports: p.transports,
+    createdAt: p.createdAt,
+    lastUsedAt: p.lastUsedAt,
+  };
+}
+
+export interface PublicAccount {
+  id: string;
+  username: string;
+  hasPassword: boolean;
+  createdAt: string;
+  passkeys: PublicPasskey[];
+  /** Epoch ms until which sensitive actions are allowed without reauthenticating */
+  reauthValidUntil: number;
+  rpID: string;
+}
+
+export function toPublicAccount(user: StoredUser, auth: AuthState, rpID: string): PublicAccount {
+  return {
+    id: user.id,
+    username: user.username,
+    hasPassword: user.hasPassword,
+    createdAt: user.createdAt,
+    passkeys: user.passkeys.map(toPublicPasskey),
+    reauthValidUntil: auth.authenticatedAt + REAUTH_WINDOW_MS,
+    rpID,
+  };
+}
+
+export function json(body: unknown, status = 200) {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function errorJson(code: string, message: string, status: number, extra: Record<string, unknown> = {}) {
+  return json({ error: code, message, ...extra }, status);
+}
diff --git a/src/lib/auth/store.ts b/src/lib/auth/store.ts
new file mode 100644
index 0000000..4071fac
--- /dev/null
+++ b/src/lib/auth/store.ts
@@ -0,0 +1,176 @@
+/**
+ * Minimal persistent store for user accounts and their passkeys.
+ *
+ * Password accounts are owned by the external Times API; we keep a local
+ * shadow record for them so passkeys can be attached. Passkey-only accounts
+ * live exclusively in this store.
+ *
+ * Data is written atomically to a JSON file. Set PASSKEY_DATA_DIR to point it
+ * at a persistent volume in production.
+ */
+import { randomBytes, randomUUID } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+export interface StoredPasskey {
+  /** base64url credential ID */
+  id: string;
+  /** base64url COSE public key */
+  publicKey: string;
+  counter: number;
+  transports: string[];
+  name: string;
+  aaguid: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface StoredUser {
+  /** Internal id, also used as the WebAuthn user handle (base64url, 32 random bytes) */
+  id: string;
+  username: string;
+  /** True if the account has a password at the external Times API */
+  hasPassword: boolean;
+  createdAt: string;
+  passkeys: StoredPasskey[];
+}
+
+interface DB {
+  version: 1;
+  users: StoredUser[];
+}
+
+const DATA_DIR = process.env.PASSKEY_DATA_DIR || path.join(process.cwd(), '.data');
+const DB_FILE = path.join(DATA_DIR, 'auth.json');
+
+let cache: DB | null = null;
+// Serialize all mutations so concurrent requests don't clobber each other.
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<DB> {
+  if (cache) return cache;
+  try {
+    const raw = await readFile(DB_FILE, 'utf8');
+    const parsed = JSON.parse(raw) as DB;
+    cache = { version: 1, users: Array.isArray(parsed.users) ? parsed.users : [] };
+  } catch (err: any) {
+    if (err?.code !== 'ENOENT') console.error('[auth] failed to read store, starting empty', err);
+    cache = { version: 1, users: [] };
+  }
+  return cache;
+}
+
+async function persist(db: DB) {
+  await mkdir(DATA_DIR, { recursive: true });
+  const tmp = `${DB_FILE}.${randomUUID()}.tmp`;
+  await writeFile(tmp, JSON.stringify(db, null, 2), 'utf8');
+  await rename(tmp, DB_FILE);
+}
+
+function mutate<T>(fn: (db: DB) => T | Promise<T>): Promise<T> {
+  const run = queue.then(async () => {
+    const db = await load();
+    const result = await fn(db);
+    await persist(db);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+export const normalizeUsername = (username: string) => username.trim().toLowerCase();
+
+export async function findUserById(id: string) {
+  const db = await load();
+  return db.users.find((u) => u.id === id) ?? null;
+}
+
+export async function findUserByUsername(username: string) {
+  const db = await load();
+  const n = normalizeUsername(username);
+  return db.users.find((u) => normalizeUsername(u.username) === n) ?? null;
+}
+
+export async function findUserByCredentialId(credentialId: string) {
+  const db = await load();
+  for (const user of db.users) {
+    const passkey = user.passkeys.find((p) => p.id === credentialId);
+    if (passkey) return { user, passkey };
+  }
+  return null;
+}
+
+export function newUserHandle() {
+  return randomBytes(32).toString('base64url');
+}
+
+/** Ensure a local record exists for an externally-authenticated password account. */
+export function upsertPasswordUser(username: string) {
+  return mutate((db) => {
+    const n = normalizeUsername(username);
+    let user = db.users.find((u) => normalizeUsername(u.username) === n);
+    if (!user) {
+      user = {
+        id: newUserHandle(),
+        username: username.trim(),
+        hasPassword: true,
+        createdAt: new Date().toISOString(),
+        passkeys: [],
+      };
+      db.users.push(user);
+    } else {
+      user.hasPassword = true;
+    }
+    return structuredClone(user);
+  });
+}
+
+/** Create a passkey-only account together with its first passkey. */
+export function createPasskeyUser(user: Omit<StoredUser, 'createdAt' | 'hasPassword'>) {
+  return mutate((db) => {
+    const n = normalizeUsername(user.username);
+    if (db.users.some((u) => normalizeUsername(u.username) === n || u.id === user.id)) {
+      throw new Error('USERNAME_TAKEN');
+    }
+    const record: StoredUser = { ...user, hasPassword: false, createdAt: new Date().toISOString() };
+    db.users.push(record);
+    return structuredClone(record);
+  });
+}
+
+export function addPasskey(userId: string, passkey: StoredPasskey) {
+  return mutate((db) => {
+    const user = db.users.find((u) => u.id === userId);
+    if (!user) throw new Error('USER_NOT_FOUND');
+    if (db.users.some((u) => u.passkeys.some((p) => p.id === passkey.id))) {
+      throw new Error('CREDENTIAL_EXISTS');
+    }
+    user.passkeys.push(passkey);
+    return structuredClone(passkey);
+  });
+}
+
+export function updatePasskey(
+  userId: string,
+  credentialId: string,
+  patch: Partial<Pick<StoredPasskey, 'name' | 'counter' | 'lastUsedAt' | 'backedUp' | 'deviceType'>>,
+) {
+  return mutate((db) => {
+    const passkey = db.users.find((u) => u.id === userId)?.passkeys.find((p) => p.id === credentialId);
+    if (!passkey) return null;
+    Object.assign(passkey, patch);
+    return structuredClone(passkey);
+  });
+}
+
+export function removePasskey(userId: string, credentialId: string) {
+  return mutate((db) => {
+    const user = db.users.find((u) => u.id === userId);
+    if (!user) return false;
+    const before = user.passkeys.length;
+    user.passkeys = user.passkeys.filter((p) => p.id !== credentialId);
+    return user.passkeys.length !== before;
+  });
+}
diff --git a/src/lib/auth/timesApi.ts b/src/lib/auth/timesApi.ts
