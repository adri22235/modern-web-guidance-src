@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { errorJson, getCurrentUser, json, saveChallenge } from '../../../../lib/auth/session';
+import { getRelyingParty } from '../../../../lib/auth/webauthn';
+
+/**
+ * Begin passkey authentication.
+ * - `{ purpose: 'signin' }` (default): discoverable-credential sign-in, used for
+ *   both the "Sign in with a passkey" button and form autofill (conditional UI).
+ * - `{ purpose: 'reauth' }`: confirm the signed-in user's identity before a
+ *   sensitive action. Restricted to that user's passkeys and requires user verification.
+ */
+export const POST: APIRoute = async (context) => {
+  const body = await context.request.json().catch(() => ({}));
+  const purpose = body.purpose === 'reauth' ? 'reauth' : 'signin';
+  const { rpID } = getRelyingParty(context);
+
+  if (purpose === 'reauth') {
+    const current = await getCurrentUser(context);
+    if (!current) return errorJson('UNAUTHENTICATED', 'Not signed in.', 401);
+    if (current.user.passkeys.length === 0) {
+      return errorJson('NO_PASSKEYS', 'This account has no passkeys yet.', 400);
+    }
+    const options = await generateAuthenticationOptions({
+      rpID,
+      userVerification: 'required',
+      allowCredentials: current.user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+    });
+    await saveChallenge(context, { challenge: options.challenge, purpose, userId: current.user.id });
+    return json(options);
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    userVerification: 'preferred',
+    allowCredentials: [],
+  });
+  await saveChallenge(context, { challenge: options.challenge, purpose });
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/login-verify.ts b/src/pages/api/auth/passkeys/login-verify.ts
new file mode 100644
index 0000000..256e30d
--- /dev/null
+++ b/src/pages/api/auth/passkeys/login-verify.ts
@@ -0,0 +1,92 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import type { AuthenticationResponseJSON } from '@simplewebauthn/server';
+import {
+  challengeFromClientData,
+  consumeChallenge,
+  errorJson,
+  getCurrentUser,
+  json,
+  markReauthenticated,
+  signIn,
+  toPublicAccount,
+} from '../../../../lib/auth/session';
+import { findUserByCredentialId, updatePasskey } from '../../../../lib/auth/store';
+import { getRelyingParty } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const body = await context.request.json().catch(() => ({}));
+  const response = body.response as AuthenticationResponseJSON | undefined;
+  if (!response?.id || !response.response?.clientDataJSON) {
+    return errorJson('INVALID_REQUEST', 'Missing authentication response.', 400);
+  }
+
+  const { rpID, origins } = getRelyingParty(context);
+  const challenge = challengeFromClientData(response.response.clientDataJSON);
+  const pending = challenge ? await consumeChallenge(context, challenge, ['signin', 'reauth']) : null;
+  if (!pending) {
+    return errorJson('CHALLENGE_EXPIRED', 'This request expired. Please try again.', 400);
+  }
+
+  const found = await findUserByCredentialId(response.id);
+  if (!found) {
+    // Let the client tell the passkey provider to hide this stale credential.
+    return errorJson('UNKNOWN_CREDENTIAL', 'This passkey is not registered with The DevTools Times.', 404, {
+      rpID,
+      credentialId: response.id,
+    });
+  }
+  const { user, passkey } = found;
+
+  const userHandle = response.response.userHandle;
+  if (userHandle && userHandle !== user.id) {
+    return errorJson('USER_MISMATCH', 'This passkey does not belong to this account.', 400);
+  }
+
+  if (pending.purpose === 'reauth') {
+    const current = await getCurrentUser(context);
+    if (!current || current.user.id !== user.id || pending.userId !== user.id) {
+      return errorJson('USER_MISMATCH', 'Use a passkey that belongs to the signed-in account.', 403);
+    }
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: new Uint8Array(Buffer.from(passkey.publicKey, 'base64url')),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: pending.purpose === 'reauth',
+    });
+  } catch (err: any) {
+    console.warn('[auth] authentication verification failed', err);
+    return errorJson('VERIFICATION_FAILED', err?.message || 'Passkey could not be verified.', 400);
+  }
+  if (!verification.verified) {
+    return errorJson('VERIFICATION_FAILED', 'Passkey could not be verified.', 400);
+  }
+
+  const info = verification.authenticationInfo;
+  await updatePasskey(user.id, passkey.id, {
+    counter: info.newCounter,
+    lastUsedAt: new Date().toISOString(),
+    backedUp: info.credentialBackedUp,
+    deviceType: info.credentialDeviceType,
+  });
+
+  if (pending.purpose === 'signin') {
+    await signIn(context, user.id, 'passkey');
+  } else {
+    await markReauthenticated(context, 'passkey');
+  }
+
+  const fresh = await getCurrentUser(context);
+  return json({ account: toPublicAccount(fresh!.user, fresh!.auth, rpID) });
+};
diff --git a/src/pages/api/auth/passkeys/register-options.ts b/src/pages/api/auth/passkeys/register-options.ts
new file mode 100644
index 0000000..70ba50f
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register-options.ts
@@ -0,0 +1,81 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  errorJson,
+  getCurrentUser,
+  isRecentlyAuthenticated,
+  json,
+  saveChallenge,
+} from '../../../../lib/auth/session';
+import { findUserByUsername, newUserHandle } from '../../../../lib/auth/store';
+import { getRelyingParty } from '../../../../lib/auth/webauthn';
+
+const USERNAME_RE = /^[a-zA-Z0-9._-]{3,32}$/;
+
+/**
+ * Begin passkey registration.
+ * - Signed out + `{ username }`: sign up for a new passkey-only account.
+ * - Signed in: add a passkey to the current account (requires recent authentication).
+ */
+export const POST: APIRoute = async (context) => {
+  const body = await context.request.json().catch(() => ({}));
+  const { rpID, rpName } = getRelyingParty(context);
+  const current = await getCurrentUser(context);
+
+  let userID: string;
+  let userName: string;
+  let excludeCredentials: { id: string; transports?: string[] }[] = [];
+  let purpose: 'signup' | 'register';
+
+  if (current) {
+    if (!isRecentlyAuthenticated(current.auth)) {
+      return errorJson('REAUTH_REQUIRED', 'Please confirm it’s you before adding a passkey.', 401);
+    }
+    purpose = 'register';
+    userID = current.user.id;
+    userName = current.user.username;
+    excludeCredentials = current.user.passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+  } else {
+    const username = typeof body.username === 'string' ? body.username.trim() : '';
+    if (!USERNAME_RE.test(username)) {
+      return errorJson(
+        'INVALID_USERNAME',
+        'Usernames must be 3–32 characters: letters, numbers, dots, dashes or underscores.',
+        400,
+      );
+    }
+    if (await findUserByUsername(username)) {
+      return errorJson('USERNAME_TAKEN', 'That username is already taken. Try signing in instead.', 409);
+    }
+    purpose = 'signup';
+    userID = newUserHandle();
+    userName = username;
+  }
+
+  const options = await generateRegistrationOptions({
+    rpName,
+    rpID,
+    userName,
+    userDisplayName: userName,
+    userID: new Uint8Array(Buffer.from(userID, 'base64url')),
+    attestationType: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+    // -8: Ed25519, -7: ES256, -257: RS256
+    supportedAlgorithmIDs: [-8, -7, -257],
+    extensions: { credProps: true } as any,
+  });
+
+  await saveChallenge(context, {
+    challenge: options.challenge,
+    purpose,
+    userId: userID,
+    username: purpose === 'signup' ? userName : undefined,
+  });
+
+  return json(options);
+};
diff --git a/src/pages/api/auth/passkeys/register-verify.ts b/src/pages/api/auth/passkeys/register-verify.ts
new file mode 100644
index 0000000..2663f14
--- /dev/null
+++ b/src/pages/api/auth/passkeys/register-verify.ts
@@ -0,0 +1,97 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import type { RegistrationResponseJSON } from '@simplewebauthn/server';
+import {
+  challengeFromClientData,
+  consumeChallenge,
+  errorJson,
+  getCurrentUser,
+  json,
+  signIn,
+  toPublicAccount,
+  toPublicPasskey,
+} from '../../../../lib/auth/session';
+import { addPasskey, createPasskeyUser, type StoredPasskey } from '../../../../lib/auth/store';
+import { defaultPasskeyName, getRelyingParty } from '../../../../lib/auth/webauthn';
+
+export const POST: APIRoute = async (context) => {
+  const body = await context.request.json().catch(() => ({}));
+  const response = body.response as RegistrationResponseJSON | undefined;
+  if (!response?.response?.clientDataJSON) {
+    return errorJson('INVALID_REQUEST', 'Missing registration response.', 400);
+  }
+
+  const challenge = challengeFromClientData(response.response.clientDataJSON);
+  const pending = challenge ? await consumeChallenge(context, challenge, ['signup', 'register']) : null;
+  if (!pending || !pending.userId) {
+    return errorJson('CHALLENGE_EXPIRED', 'This request expired. Please try again.', 400);
+  }
+
+  const current = await getCurrentUser(context);
+  if (pending.purpose === 'register' && current?.user.id !== pending.userId) {
+    return errorJson('UNAUTHENTICATED', 'Your session changed. Please sign in again.', 401);
+  }
+  if (pending.purpose === 'signup' && current) {
+    return errorJson('ALREADY_SIGNED_IN', 'You are already signed in.', 400);
+  }
+
+  const { rpID, origins } = getRelyingParty(context);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+  } catch (err: any) {
+    console.warn('[auth] registration verification failed', err);
+    return errorJson('VERIFICATION_FAILED', err?.message || 'Passkey could not be verified.', 400);
+  }
+  if (!verification.verified) {
+    return errorJson('VERIFICATION_FAILED', 'Passkey could not be verified.', 400);
+  }
+
+  const { credential, aaguid, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+  const now = new Date().toISOString();
+  const passkey: StoredPasskey = {
+    id: credential.id,
+    publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+    counter: credential.counter,
+    transports: credential.transports ?? response.response.transports ?? [],
+    name: defaultPasskeyName(aaguid, credentialDeviceType),
+    aaguid,
+    deviceType: credentialDeviceType,
+    backedUp: credentialBackedUp,
+    createdAt: now,
+    lastUsedAt: now,
+  };
+
+  try {
+    if (pending.purpose === 'signup') {
+      const user = await createPasskeyUser({
+        id: pending.userId,
+        username: pending.username!,
+        passkeys: [passkey],
+      });
+      await signIn(context, user.id, 'passkey');
+    } else {
+      await addPasskey(pending.userId, passkey);
+    }
+  } catch (err: any) {
+    if (err?.message === 'USERNAME_TAKEN') {
+      return errorJson('USERNAME_TAKEN', 'That username was just taken. Please pick another.', 409);
+    }
+    if (err?.message === 'CREDENTIAL_EXISTS') {
+      return errorJson('CREDENTIAL_EXISTS', 'This passkey is already registered.', 409);
+    }
+    throw err;
+  }
+
+  const fresh = await getCurrentUser(context);
+  return json({
+    passkey: toPublicPasskey(passkey),
+    account: fresh ? toPublicAccount(fresh.user, fresh.auth, rpID) : null,
+  });
+};
diff --git a/src/pages/api/auth/reauth/password.ts b/src/pages/api/auth/reauth/password.ts
