+++ b/src/pages/account.astro
@@ -0,0 +1,17 @@
+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { getCurrentUser, toPublicAccount } from '../lib/auth/session';
+import { getRelyingParty } from '../lib/auth/webauthn';
+
+const current = await getCurrentUser(Astro);
+if (!current) {
+  return Astro.redirect(`${import.meta.env.BASE_URL}signin?next=account`);
+}
+Astro.response.headers.set('Cache-Control', 'no-store');
+const account = toPublicAccount(current.user, current.auth, getRelyingParty(Astro).rpID);
+---
+
+<Layout title="Account settings | The DevTools Times">
+  <AccountSettings client:load initialAccount={account} />
+</Layout>
