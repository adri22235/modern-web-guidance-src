@@ -0,0 +1,113 @@
+/*
+ * Verified asset loader for The Daily Grind homepage.
+ *
+ * <img>, CSS background-image and @font-face don't support Subresource
+ * Integrity. To get the same guarantee for images and font files, this script
+ * downloads them with fetch(), which does support `integrity`. If the bytes
+ * don't match the expected hash, the browser rejects the response and we keep
+ * the placeholder or fallback font.
+ *
+ * Every request is CORS-mode, sends no credentials (cookies or HTTP auth) and
+ * no Referer header.
+ */
+(function () {
+  'use strict';
+
+  var FETCH_OPTS = {
+    mode: 'cors',
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+    cache: 'force-cache'
+  };
+
+  function verifiedFetch(url, integrity) {
+    var opts = Object.assign({ integrity: integrity }, FETCH_OPTS);
+    return fetch(url, opts).then(function (res) {
+      if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + url);
+      return res;
+    });
+  }
+
+  /* ---------- Fonts ---------- */
+
+  var FONTS = [
+    {
+      family: 'Playfair Display',
+      descriptors: { weight: '700', style: 'normal', display: 'swap' },
+      url: 'https://cdn.jsdelivr.net/npm/@fontsource/playfair-display@5.1.0/files/playfair-display-latin-700-normal.woff2',
+      integrity: 'sha384-2OUMztuc2Uvfq3n8w2APnig7JM4X9miM/re2XmGSZqKU6gdoOGFHDSiACwWV1wfK'
+    },
+    {
+      family: 'Lato',
+      descriptors: { weight: '400', style: 'normal', display: 'swap' },
+      url: 'https://cdn.jsdelivr.net/npm/@fontsource/lato@5.1.0/files/lato-latin-400-normal.woff2',
+      integrity: 'sha384-+chn3xqCWRPSXDBtVEFQn+0J9Gb0SYR2FO1WrXo+L/arnyr8lXLVX2p0BqZIUemc'
+    }
+  ];
+
+  function loadFonts() {
+    if (!('FontFace' in window) || !document.fonts) return;
+    FONTS.forEach(function (f) {
+      verifiedFetch(f.url, f.integrity)
+        .then(function (res) { return res.arrayBuffer(); })
+        .then(function (buf) { return new FontFace(f.family, buf, f.descriptors).load(); })
+        .then(function (face) {
+          document.fonts.add(face);
+          document.documentElement.classList.add('font-' + f.family.toLowerCase().replace(/\s+/g, '-'));
+        })
+        .catch(function (err) {
+          console.warn('[verified-assets] Font rejected, using fallback:', f.family, err);
+        });
+    });
+  }
+
+  /* ---------- Images ---------- */
+
+  // Elements marked with data-verified-src + data-integrity. <img> gets a
+  // src; anything else gets a background-image (the hero, for example).
+  function loadImages() {
+    var nodes = document.querySelectorAll('[data-verified-src][data-integrity]');
+    Array.prototype.forEach.call(nodes, function (el) {
+      var url = el.getAttribute('data-verified-src');
+      var integrity = el.getAttribute('data-integrity');
+
+      verifiedFetch(url, integrity)
+        .then(function (res) { return res.blob(); })
+        .then(function (blob) {
+          var objectUrl = URL.createObjectURL(blob);
+          if (el.tagName === 'IMG') {
+            el.addEventListener('load', function () { el.classList.add('is-loaded'); }, { once: true });
+            el.src = objectUrl;
+          } else {
+            var overlay = el.getAttribute('data-overlay');
+            el.style.backgroundImage = (overlay ? overlay + ', ' : '') + 'url("' + objectUrl + '")';
+            el.classList.add('is-loaded');
+          }
+        })
+        .catch(function (err) {
+          el.classList.add('is-unverified');
+          console.warn('[verified-assets] Image rejected, keeping placeholder:', url, err);
+        });
+    });
+  }
+
+  /* ---------- Icons (Lucide, loaded via SRI-checked <script>) ---------- */
+
+  function renderIcons() {
+    if (window.lucide && typeof window.lucide.createIcons === 'function') {
+      window.lucide.createIcons({ attrs: { 'aria-hidden': 'true' } });
+    }
+  }
+
+  function init() {
+    loadFonts();
+    loadImages();
+    renderIcons();
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', init);
+  } else {
+    init();
+  }
+})();
