       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    /* Interactive card motion */
+    .card.spring,
+    .card.bounce {
+      will-change: transform;
+      transition-property: transform, box-shadow;
+    }
+
+    /* Spring: overshoots its target scale, then settles with damped oscillation */
+    .card.spring {
+      transition-duration: 0.7s;
+      /* Fallback for browsers without linear() easing support */
+      transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
+      transition-timing-function: linear(0, 0.181, 0.401, 0.625, 0.83, 1, 1.126, 1.206,
+          1.244, 1.247, 1.223, 1.183, 1.134, 1.084, 1.038, 1, 0.972, 0.954, 0.946,
+          0.945, 0.95, 0.959, 0.97, 0.981, 0.992, 1, 1.006, 1.01, 1.012, 1.012,
+          1.011, 1.009, 1.007, 1.004, 1.002, 1, 0.999, 0.998, 0.998, 0.999, 1);
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within {
+      transform: scale(1.06);
+      box-shadow: 0 14px 28px rgba(78, 52, 46, 0.22);
+    }
+
+    /* Bounce: lifts up and rebounds off its resting point like a dropped ball */
+    .card.bounce {
+      transition-duration: 0.8s;
+      /* Fallback for browsers without linear() easing support */
+      transition-timing-function: cubic-bezier(0.68, -0.55, 0.27, 1.55);
+      transition-timing-function: linear(0, 0.019, 0.076, 0.17, 0.303, 0.473, 0.681,
+          0.926 36.4%, 1 36.4%, 0.86, 0.788, 0.753, 0.75, 0.757, 0.798, 0.877,
+          0.994 72.7%, 0.952, 0.938, 0.962, 0.988 90.9%, 0.985, 1);
+    }
+
+    .card.bounce:hover,
+    .card.bounce:focus-within {
+      transform: translateY(-12px) scale(1.03);
+      box-shadow: 0 18px 30px rgba(78, 52, 46, 0.22);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        transition: none;
+        will-change: auto;
+      }
+
+      .card.spring:hover,
+      .card.spring:focus-within,
+      .card.bounce:hover,
+      .card.bounce:focus-within {
+        transform: none;
+      }
+    }
+
