diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,170 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    // Menu data that the AI tool looks things up in.
+    // Prices are in USD; sizes are in fluid ounces.
+    const MENU_ITEMS = [
+      {
+        name: "Maple Oat Latte",
+        aliases: ["maple latte", "oat latte"],
+        category: "Seasonal",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        price: { small: 4.75, medium: 5.25, large: 5.75 },
+        sizesOz: { small: 12, medium: 16, large: 20 },
+        caffeineMg: { small: 75, medium: 150, large: 150 },
+        ingredients: ["Espresso", "Oat milk", "Vermont maple syrup"],
+        dietary: ["Dairy-free", "Vegan"],
+        allergens: ["Oats (may contain gluten)"],
+        temperature: ["Hot", "Iced"],
+        available: true,
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        aliases: ["espresso", "dark espresso"],
+        category: "Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        price: { single: 2.75, double: 3.5 },
+        sizesOz: { single: 1, double: 2 },
+        caffeineMg: { single: 75, double: 150 },
+        ingredients: ["Dark roast espresso beans"],
+        dietary: ["Dairy-free", "Vegan", "Gluten-free"],
+        allergens: [],
+        temperature: ["Hot"],
+        available: true,
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        aliases: ["cold brew coffee", "coldbrew"],
+        category: "Cold Coffee",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        price: { small: 4.25, medium: 4.75, large: 5.25 },
+        sizesOz: { small: 12, medium: 16, large: 24 },
+        caffeineMg: { small: 155, medium: 205, large: 310 },
+        ingredients: ["Coarse-ground coffee", "Filtered water"],
+        dietary: ["Dairy-free", "Vegan", "Gluten-free"],
+        allergens: [],
+        temperature: ["Iced"],
+        available: true,
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    // Lowercase, strip accents/punctuation and collapse whitespace so
+    // "Maple-Oat  LATTE!" matches "Maple Oat Latte".
+    const normalize = (value) =>
+      value
+        .normalize("NFKD")
+        .replace(/[\u0300-\u036f]/g, "")
+        .toLowerCase()
+        .replace(/[^a-z0-9]+/g, " ")
+        .trim();
+
+    function findMenuItem(query) {
+      const q = normalize(query);
+      const names = (item) => [item.name, ...item.aliases].map(normalize);
+
+      // 1. Exact match on name or alias.
+      const exact = MENU_ITEMS.find((item) => names(item).includes(q));
+      if (exact) return { item: exact };
+
+      // 2. Partial match: the query contains, or is contained in, a name/alias.
+      const partial = MENU_ITEMS.filter((item) =>
+        names(item).some((n) => n.includes(q) || q.includes(n))
+      );
+      if (partial.length === 1) return { item: partial[0] };
+      if (partial.length > 1) return { ambiguous: partial };
+
+      return {};
+    }
+
+    const toDetails = ({ aliases, url, ...details }) => ({
+      ...details,
+      url: new URL(url, location.href).href,
+    });
+
+    const lookupMenuItemTool = {
+      name: "get_menu_item_details",
+      description:
+        "Looks up full details for a single drink on The Daily Grind's menu, " +
+        "including description, prices by size, caffeine content, ingredients, " +
+        "dietary information, allergens and availability. Use when the user asks " +
+        "about a specific menu item.",
+      inputSchema: {
+        type: "object",
+        properties: {
+          itemName: {
+            type: "string",
+            description:
+              "Name of the menu item as the user referred to it, e.g. \"maple oat latte\" " +
+              "or \"cold brew\". Matching ignores case and punctuation.",
+          },
+        },
+        required: ["itemName"],
+      },
+      execute({ itemName } = {}) {
+        // The browser doesn't validate input against inputSchema, so do it here.
+        // Errors are returned as values (not thrown) so the agent can read them.
+        const availableItems = MENU_ITEMS.map((item) => item.name);
+
+        if (typeof itemName !== "string" || !itemName.trim()) {
+          return { error: "Provide the name of a menu item to look up.", availableItems };
+        }
+
+        const { item, ambiguous } = findMenuItem(itemName);
+        if (item) return toDetails(item);
+
+        if (ambiguous) {
+          return {
+            error: `"${itemName}" matches more than one menu item. Ask the user which one they mean.`,
+            matchingItems: ambiguous.map((entry) => entry.name),
+          };
+        }
+
+        return { error: `Menu item "${itemName}" was not found.`, availableItems };
+      },
+      annotations: { readOnlyHint: true },
+    };
+
+    // WebMCP has no unregisterTool(); aborting the signal passed at
+    // registration is how a tool is removed.
+    let registration = null;
+
+    async function registerMenuTools() {
+      if (!("modelContext" in document) || registration) return;
+
+      const controller = new AbortController();
+      registration = controller;
+      try {
+        await document.modelContext.registerTool(lookupMenuItemTool, {
+          signal: controller.signal,
+        });
+      } catch (err) {
+        if (registration === controller) registration = null;
+        console.warn("Failed to register WebMCP menu tool:", err);
+      }
+    }
+
+    function unregisterMenuTools() {
+      registration?.abort();
+      registration = null;
+    }
+
+    registerMenuTools();
+
+    // Clean up when the page is unloaded. `pagehide` fires reliably on
+    // navigation/close (including mobile) and, unlike `unload`, doesn't
+    // block the back/forward cache. If the page is restored from bfcache,
+    // register the tool again.
+    addEventListener("pagehide", unregisterMenuTools);
+    addEventListener("pageshow", (event) => {
+      if (event.persisted) registerMenuTools();
+    });
+  </script>
+
 </body>
 
 </html>
