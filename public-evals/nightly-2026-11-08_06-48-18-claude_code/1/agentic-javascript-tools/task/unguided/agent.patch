+  <script>
+    /**
+     * WebMCP: expose a client-side "get_menu_item_details" tool to AI assistants
+     * via navigator.modelContext (https://github.com/webmachinelearning/webmcp).
+     */
+    (() => {
+      const MENU_ITEMS = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          aliases: ['maple latte', 'oat latte', 'maple oat'],
+          category: 'Seasonal',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          sizes: [
+            { size: 'Small (12 oz)', price: 4.75 },
+            { size: 'Medium (16 oz)', price: 5.25 },
+            { size: 'Large (20 oz)', price: 5.75 }
+          ],
+          temperature: ['hot', 'iced'],
+          caffeineMg: 150,
+          calories: 210,
+          dietary: ['vegan', 'dairy-free'],
+          allergens: ['oats (may contain gluten)'],
+          available: true,
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          aliases: ['espresso', 'dark roast', 'dark espresso'],
+          category: 'Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          sizes: [
+            { size: 'Single shot', price: 2.75 },
+            { size: 'Double shot', price: 3.50 }
+          ],
+          temperature: ['hot'],
+          caffeineMg: 75,
+          calories: 5,
+          dietary: ['vegan', 'dairy-free', 'gluten-free'],
+          allergens: [],
+          available: true,
+          url: '/menu/espresso'
+        },
+        {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          aliases: ['coldbrew', 'cold brew coffee', 'iced cold brew'],
+          category: 'Cold Coffee',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          sizes: [
+            { size: 'Medium (16 oz)', price: 4.50 },
+            { size: 'Large (24 oz)', price: 5.25 }
+          ],
+          temperature: ['iced'],
+          caffeineMg: 200,
+          calories: 5,
+          dietary: ['vegan', 'dairy-free', 'gluten-free'],
+          allergens: [],
+          available: true,
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      const normalize = (str) =>
+        String(str).toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, ' ').trim();
+
+      function findMenuItem(query) {
+        const q = normalize(query);
+        if (!q) return null;
+        const names = (item) => [item.name, item.id, ...item.aliases].map(normalize);
+        // 1) exact name/id/alias match, 2) substring match, 3) all query words present
+        return (
+          MENU_ITEMS.find((item) => names(item).includes(q)) ||
+          MENU_ITEMS.find((item) => names(item).some((n) => n.includes(q) || q.includes(n))) ||
+          MENU_ITEMS.find((item) => {
+            const words = q.split(' ');
+            return names(item).some((n) => words.every((w) => n.includes(w)));
+          }) ||
+          null
+        );
+      }
+
+      const textResult = (data, isError = false) => ({
+        content: [{ type: 'text', text: JSON.stringify(data, null, 2) }],
+        ...(isError && { isError: true })
+      });
+
+      const getMenuItemTool = {
+        name: 'get_menu_item_details',
+        description:
+          'Look up details for a single item on The Daily Grind coffee menu by its name ' +
+          '(e.g. "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew"). Returns the item\'s ' +
+          'description, category, available sizes with prices (USD), hot/iced options, caffeine, ' +
+          'calories, dietary tags, allergens, availability, and a link to its menu page. ' +
+          'Matching is case-insensitive and tolerates partial names. If no item matches, ' +
+          'the response lists the available item names.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up, as the customer said it. Case-insensitive; ' +
+                'partial names are accepted (e.g. "maple latte" or "espresso").',
+              minLength: 1
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        async execute({ name } = {}) {
+          if (typeof name !== 'string' || !name.trim()) {
+            return textResult({
+              error: 'The "name" parameter is required and must be a non-empty string.',
+              availableItems: MENU_ITEMS.map((i) => i.name)
+            }, true);
+          }
+          const item = findMenuItem(name);
+          if (!item) {
+            return textResult({
+              error: `No menu item found matching "${name}".`,
+              availableItems: MENU_ITEMS.map((i) => i.name)
+            }, true);
+          }
+          const { aliases, ...details } = item;
+          return textResult({ ...details, url: new URL(item.url, location.origin).href });
+        }
+      };
+
+      let registration = null;
+
+      function registerTools() {
+        const modelContext = navigator.modelContext;
+        if (!modelContext || typeof modelContext.registerTool !== 'function' || registration) return;
+
+        const controller = new AbortController();
+        let handle;
+        try {
+          // Current spec: unregister by aborting the signal passed in options.
+          handle = modelContext.registerTool(getMenuItemTool, { signal: controller.signal });
+        } catch (err) {
+          console.warn('[WebMCP] Failed to register get_menu_item_details:', err);
+          return;
+        }
+        registration = { controller, handle, modelContext };
+      }
+
+      function unregisterTools() {
+        if (!registration) return;
+        const { controller, handle, modelContext } = registration;
+        registration = null;
+        try {
+          controller.abort();
+          // Fallbacks for earlier drafts / polyfills of the API.
+          if (handle && typeof handle.unregister === 'function') {
+            handle.unregister();
+          } else if (typeof modelContext.unregisterTool === 'function') {
+            modelContext.unregisterTool(getMenuItemTool.name);
+          }
+        } catch (err) {
+          // Tool may already be gone (e.g. aborted signal removed it); ignore.
+        }
+      }
+
+      registerTools();
+
+      // Clean up when the page is unloaded or placed in the back/forward cache,
+      // and re-register if it's restored from the bfcache.
+      window.addEventListener('pagehide', unregisterTools);
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerTools();
+      });
+    })();
+  </script>
+
 </body>
 
