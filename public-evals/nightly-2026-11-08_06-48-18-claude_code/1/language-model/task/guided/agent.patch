+
+  <script type="module">
+    const $ = (sel, root = document) => root.querySelector(sel);
+
+    const BARISTA_SYSTEM_PROMPT = `You are a friendly barista at The Daily Grind coffee shop.
+Only answer questions about these two drinks; politely decline anything else.
+- Maple Oat Latte: double shot of espresso, steamed oat milk, real Vermont maple syrup. Dairy-free, vegan. Sizes 12oz ($5.25) and 16oz ($5.95). Available hot or iced. About 150mg caffeine (12oz).
+- Cold Brew: single-origin beans steeped in cold water for 18 hours, smooth and low in acidity. Served black over ice; oat milk, whole milk or maple syrup can be added. 16oz ($4.75). About 200mg caffeine.
+Keep answers short (2-4 sentences) and in plain text.`;
+
+    const SENTIMENT_SYSTEM_PROMPT = `You analyze customer feedback for a coffee shop.
+Return a sentiment score from -1 (very negative) to 1 (very positive) and the single best-fitting category.`;
+
+    const SENTIMENT_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: { type: 'number', minimum: -1, maximum: 1 },
+        category: { type: 'string', enum: ['positive', 'neutral', 'negative', 'mixed'] },
+      },
+      required: ['score', 'category'],
+      additionalProperties: false,
+    };
+
+    const MAX_BRANCHES = 3;
+    $('#max-branches').textContent = MAX_BRANCHES;
+
+    const els = {
+      question: $('#barista-question'),
+      ask: $('#ask-the-barista'),
+      stop: $('#barista-stop'),
+      baristaStatus: $('#barista-status'),
+      answer: $('#barista-answer'),
+      feedback: $('#feedback-text'),
+      sentimentBtn: $('#sentiment-btn'),
+      sentimentStatus: $('#sentiment-status'),
+      sentimentResult: $('#sentiment-result'),
+      cloneBtn: $('#clone-btn'),
+      cloneStatus: $('#clone-status'),
+      mainUsage: $('#main-usage'),
+      branchList: $('#branch-list'),
+    };
+
+    // ---- Availability -------------------------------------------------------
+
+    const supported = 'LanguageModel' in self;
+
+    async function checkAvailability(options) {
+      if (!supported) return 'unavailable';
+      try {
+        return await LanguageModel.availability(options);
+      } catch {
+        return 'unavailable';
+      }
+    }
+
+    function showUnavailable() {
+      const msg = supported
+        ? 'The on-device AI model isn’t available on this device.'
+        : 'Your browser doesn’t support built-in AI yet. Try a recent desktop version of Chrome.';
+      for (const statusEl of [els.baristaStatus, els.sentimentStatus, els.cloneStatus]) {
+        statusEl.textContent = msg;
+      }
+      for (const btn of [els.ask, els.sentimentBtn, els.cloneBtn]) btn.disabled = true;
+    }
+
+    // ---- Session creation with download progress ----------------------------
+
+    // Base sessions hold only system instructions and are cloned for each task.
+    const baseSessions = new Map(); // key -> Promise<LanguageModel>
+
+    function createBaseSession(key, systemPrompt, statusEl) {
+      if (baseSessions.has(key)) return baseSessions.get(key);
+      const promise = (async () => {
+        const availability = await checkAvailability(SESSION_OPTIONS);
+        if (availability === 'unavailable') throw new Error('unavailable');
+
+        let progress;
+        const session = await LanguageModel.create({
+          ...SESSION_OPTIONS,
+          initialPrompts: [{ role: 'system', content: systemPrompt }],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (!progress) {
+                statusEl.replaceChildren('Downloading the AI model… ', (progress = document.createElement('progress')));
+                progress.max = 1;
+              }
+              progress.value = e.loaded;
+              // loaded reaches 1 before the model finishes loading into memory.
+              if (e.loaded === 1) statusEl.textContent = 'Preparing the AI model…';
+            });
+          },
+        });
+        statusEl.textContent = '';
+        return session;
+      })();
+      // Allow a retry if creation fails (e.g. missing user activation for download).
+      promise.catch(() => baseSessions.delete(key));
+      baseSessions.set(key, promise);
+      return promise;
+    }
+
+    const SESSION_OPTIONS = {
+      expectedInputs: [{ type: 'text', languages: ['en'] }],
+      expectedOutputs: [{ type: 'text', languages: ['en'] }],
+    };
+
+    const getBaristaBase = () => createBaseSession('barista', BARISTA_SYSTEM_PROMPT, els.baristaStatus);
+    const getSentimentBase = () => createBaseSession('sentiment', SENTIMENT_SYSTEM_PROMPT, els.sentimentStatus);
+
+    // ---- Context usage helpers ----------------------------------------------
+
+    function usageOf(session) {
+      // contextUsage/contextWindow supersede the older inputUsage/inputQuota names.
+      const used = session.contextUsage ?? session.inputUsage ?? 0;
+      const total = session.contextWindow ?? session.inputQuota ?? 0;
+      return { used, total, ratio: total ? used / total : 0 };
+    }
+
+    const formatUsage = ({ used, total, ratio }) =>
+      total ? `${used.toLocaleString()} / ${total.toLocaleString()} tokens (${Math.round(ratio * 100)}%)` : '';
+
+    function reportError(statusEl, err) {
+      if (err?.name === 'AbortError') {
+        statusEl.textContent = 'Stopped.';
+      } else if (err?.name === 'NotAllowedError') {
+        statusEl.textContent = 'Click the button again to start downloading the AI model.';
+      } else if (err?.name === 'QuotaExceededError') {
+        statusEl.textContent = 'That input is too long for the on-device model. Try something shorter.';
+      } else if (err?.message === 'unavailable') {
+        showUnavailable();
+      } else {
+        console.error(err);
+        statusEl.textContent = 'Something went wrong. Please try again.';
+      }
+    }
+
+    // ---- Ask the Barista (streaming, multi-turn) ----------------------------
+
+    // The active conversation is a clone of the barista base session.
+    let chatSession = null;
+    let chatController = null;
+
+    function updateMainUsage() {
+      els.mainUsage.textContent = chatSession ? `Main conversation: ${formatUsage(usageOf(chatSession))}` : '';
+    }
+
+    function watchOverflow(session, statusEl) {
+      session.addEventListener?.('contextoverflow', () => {
+        statusEl.textContent = 'Context window full — the oldest messages were dropped.';
+      });
+    }
+
+    async function askBarista() {
+      const question = els.question.value.trim();
+      if (!question) {
+        els.question.focus();
+        return;
+      }
+
+      els.ask.disabled = true;
+      els.stop.hidden = false;
+      els.answer.textContent = '';
+      els.baristaStatus.textContent = 'The barista is thinking…';
+      chatController = new AbortController();
+
+      try {
+        if (!chatSession) {
+          const base = await getBaristaBase();
+          chatSession = await base.clone({ signal: chatController.signal });
+          watchOverflow(chatSession, els.baristaStatus);
+        }
+        els.baristaStatus.textContent = 'The barista is thinking…';
+        const stream = chatSession.promptStreaming(question, { signal: chatController.signal });
+        let first = true;
+        for await (const chunk of stream) {
+          if (first) {
+            els.baristaStatus.textContent = '';
+            first = false;
+          }
+          // Model output is untrusted: append as text, never as HTML.
+          els.answer.append(chunk);
+        }
+        updateMainUsage();
+      } catch (err) {
+        reportError(els.baristaStatus, err);
+      } finally {
+        chatController = null;
+        els.ask.disabled = false;
+        els.stop.hidden = true;
+      }
+    }
+
+    els.ask.addEventListener('click', askBarista);
+    els.stop.addEventListener('click', () => chatController?.abort());
+    els.question.addEventListener('keydown', (e) => {
+      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) askBarista();
+    });
+
+    // ---- Customer Feedback Analyzer (structured output) ---------------------
+
+    async function analyzeSentiment() {
+      const feedback = els.feedback.value.trim();
+      if (!feedback) {
+        els.feedback.focus();
+        return;
+      }
+
+      els.sentimentBtn.disabled = true;
+      els.sentimentResult.textContent = '';
+      els.sentimentStatus.textContent = 'Analyzing feedback…';
+      let task;
+      try {
+        const base = await getSentimentBase();
+        // A fresh clone per review keeps unrelated reviews from influencing each other.
+        task = await base.clone();
+        const raw = await task.prompt(feedback, { responseConstraint: SENTIMENT_SCHEMA });
+        const result = JSON.parse(raw);
+        els.sentimentResult.textContent = JSON.stringify(result, null, 2);
+        els.sentimentStatus.textContent = '';
+      } catch (err) {
+        reportError(els.sentimentStatus, err);
+      } finally {
+        task?.destroy();
+        els.sentimentBtn.disabled = false;
+      }
+    }
+
+    els.sentimentBtn.addEventListener('click', analyzeSentiment);
+
+    // ---- Conversation Branching (clone + context tracking + cleanup) --------
+
+    const branches = []; // { session, el, controller }
+    let branchCounter = 0;
+
+    function renderBranchUsage(branch) {
+      const usage = usageOf(branch.session);
+      $('meter', branch.el).value = usage.ratio;
+      $('.usage', branch.el).textContent = formatUsage(usage);
+    }
+
+    function destroyBranch(branch) {
+      branch.controller?.abort();
+      branch.session.destroy();
+      branch.el.remove();
+      branches.splice(branches.indexOf(branch), 1);
+    }
+
+    async function cloneConversation() {
+      els.cloneBtn.disabled = true;
+      els.cloneStatus.textContent = 'Cloning conversation…';
+      try {
+        // Branch from the active conversation, or from the clean base if none exists yet.
+        const source = chatSession ?? (await getBaristaBase());
+        const session = await source.clone();
+
+        const el = $('#branch-template').content.firstElementChild.cloneNode(true);
+        const branch = { session, el, controller: null };
+        const id = ++branchCounter;
+        $('.branch-name', el).textContent = `Branch ${id}${chatSession ? '' : ' (fresh)'}`;
+        $('.branch-question', el).id = `branch-question-${id}`;
+
+        $('.branch-discard', el).addEventListener('click', () => {
+          destroyBranch(branch);
+          els.cloneStatus.textContent = `Branch ${id} discarded and its memory freed.`;
+        });
+        $('.branch-ask', el).addEventListener('click', () => askBranch(branch));
+        watchOverflow(session, els.cloneStatus);
+
+        branches.push(branch);
+        els.branchList.append(el);
+        renderBranchUsage(branch);
+        updateMainUsage();
+
+        // Clean up the oldest branches beyond the limit to free device memory.
+        let cleaned = 0;
+        while (branches.length > MAX_BRANCHES) {
+          destroyBranch(branches[0]);
+          cleaned++;
+        }
+        els.cloneStatus.textContent = `Created Branch ${id}.` +
+          (cleaned ? ` Cleaned up ${cleaned} older branch${cleaned > 1 ? 'es' : ''}.` : '');
+      } catch (err) {
+        reportError(els.cloneStatus, err);
+      } finally {
+        els.cloneBtn.disabled = false;
+      }
+    }
+
+    async function askBranch(branch) {
+      const input = $('.branch-question', branch.el);
+      const output = $('.branch-answer', branch.el);
+      const button = $('.branch-ask', branch.el);
+      const question = input.value.trim();
+      if (!question) {
+        input.focus();
+        return;
+      }
+
+      button.disabled = true;
+      output.textContent = '';
+      branch.controller = new AbortController();
+      try {
+        const stream = branch.session.promptStreaming(question, { signal: branch.controller.signal });
+        for await (const chunk of stream) output.append(chunk);
+        renderBranchUsage(branch);
+      } catch (err) {
+        if (branch.el.isConnected) reportError(els.cloneStatus, err);
+      } finally {
+        branch.controller = null;
+        button.disabled = false;
+      }
+    }
+
+    els.cloneBtn.addEventListener('click', cloneConversation);
+
+    // ---- Startup, pre-warming and cleanup -----------------------------------
+
+    const initialAvailability = await checkAvailability(SESSION_OPTIONS);
+    if (initialAvailability === 'unavailable') {
+      showUnavailable();
+    } else if (initialAvailability === 'available') {
+      // Pre-warm when the user shows intent, so the first answer has no cold start.
+      // (Downloads require a user click, so only warm when the model is already present.)
+      $('#barista').addEventListener('focusin', () => getBaristaBase().catch(() => {}), { once: true });
+      $('#barista').addEventListener('pointerenter', () => getBaristaBase().catch(() => {}), { once: true });
+      $('#feedback').addEventListener('focusin', () => getSentimentBase().catch(() => {}), { once: true });
+      $('#feedback').addEventListener('pointerenter', () => getSentimentBase().catch(() => {}), { once: true });
+    } else {
+      els.baristaStatus.textContent = 'The AI model will download the first time you ask a question.';
+    }
+
+    // Free all on-device sessions when the page is being unloaded.
+    addEventListener('pagehide', (e) => {
+      if (e.persisted) return; // keep sessions alive for back/forward cache restores
+      chatController?.abort();
+      for (const branch of [...branches]) destroyBranch(branch);
+      chatSession?.destroy();
+      chatSession = null;
+      for (const p of baseSessions.values()) p.then((s) => s.destroy(), () => {});
+      baseSessions.clear();
+    });
+  </script>
+
 </body>
 
