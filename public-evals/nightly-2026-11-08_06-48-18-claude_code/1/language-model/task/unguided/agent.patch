+          li.append(head, usageText, bar, transcript);
+          const select = () => {
+            if (branching.busy) return;
+            branching.activeId = b.id;
+            b.lastUsed = Date.now();
+            renderBranches();
+          };
+          li.addEventListener('click', select);
+          li.addEventListener('keydown', (e) => {
+            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(); }
+          });
+          return li;
+        }));
+      }
+
+      async function ensureRootBranch(signal) {
+        if (activeBranch()) return activeBranch();
+        const session = await createSession({
+          options: { initialPrompts: [{ role: 'system', content: BARISTA_SYSTEM_PROMPT }] },
+          statusEl: branching.status,
+          progressEl: branching.progress,
+          signal,
+        });
+        const branch = addBranch(session, `Branch ${branching.nextId}`);
+        renderBranches();
+        return branch;
+      }
+
+      branching.sendBtn.addEventListener('click', async () => {
+        const text = branching.input.value.trim();
+        if (!text) {
+          setStatus(branching.status, 'Type a message for the active branch.', true);
+          branching.input.focus();
+          return;
+        }
+        const controller = new AbortController();
+        branching.controller = controller;
+        setBranchBusy(true);
+        setStatus(branching.status, 'Checking on-device model…');
+
+        try {
+          const branch = await ensureRootBranch(controller.signal);
+          branch.lastUsed = Date.now();
+
+          // Warn before sending if the prompt would overflow the context window.
+          const measure = branch.session.measureContextUsage ?? branch.session.measureInputUsage;
+          if (measure) {
+            const needed = await measure.call(branch.session, text, { signal: controller.signal });
+            const remaining = windowOf(branch.session) - usageOf(branch.session);
+            if (windowOf(branch.session) && needed > remaining) {
+              setStatus(branching.status, 'This message will push older turns out of this branch’s context.');
+            }
+          }
+
+          branch.transcript.push({ role: 'user', content: text });
+          const reply = { role: 'assistant', content: '' };
+          branch.transcript.push(reply);
+          branching.input.value = '';
+          renderBranches();
+          setStatus(branching.status, `Replying in ${branch.name}…`);
+
+          const stream = branch.session.promptStreaming(text, { signal: controller.signal });
+          let lastRender = 0;
+          for await (const chunk of stream) {
+            reply.content += chunk;
+            const now = performance.now();
+            if (now - lastRender > 80) { renderBranches(); lastRender = now; }
+          }
+          renderBranches();
+          setStatus(branching.status, `${branch.name} updated.`);
+        } catch (err) {
+          if (isAbort(err)) {
+            setStatus(branching.status, 'Cancelled.');
+          } else {
+            console.error(err);
+            setStatus(branching.status, err.message || 'Something went wrong.', true);
+          }
+          renderBranches();
+        } finally {
+          if (branching.controller === controller) branching.controller = null;
+          setBranchBusy(false);
+        }
+      });
+
+      branching.cloneBtn.addEventListener('click', async () => {
+        const controller = new AbortController();
+        branching.controller = controller;
+        setBranchBusy(true);
+        setStatus(branching.status, 'Checking on-device model…');
+
+        try {
+          const source = await ensureRootBranch(controller.signal);
+          // clone() copies the full conversation context into an independent session.
+          const cloned = await source.session.clone({ signal: controller.signal });
+          source.lastUsed = Date.now();
+          const branch = addBranch(cloned, `Branch ${branching.nextId} (from ${source.name})`,
+            source.transcript.map((t) => ({ ...t })));
+          const pruned = pruneBranches();
+          renderBranches();
+          setStatus(branching.status,
+            `Cloned ${source.name} → ${branch.name}.` +
+            (pruned.length ? ` Cleaned up: ${pruned.join(', ')}.` : ''));
+        } catch (err) {
+          if (isAbort(err)) {
+            setStatus(branching.status, 'Cancelled.');
+          } else {
+            console.error(err);
+            setStatus(branching.status, err.message || 'Could not clone the session.', true);
+          }
+        } finally {
+          if (branching.controller === controller) branching.controller = null;
+          setBranchBusy(false);
+        }
+      });
+
+      branching.resetBtn.addEventListener('click', () => {
+        branching.controller?.abort();
+        [...branching.branches].forEach((b) => removeBranch(b.id));
+        renderBranches();
+        setStatus(branching.status, 'All branches destroyed.');
+      });
+
+      // ---------------------------------------------------------------------
+      // Global cleanup: abort in-flight work and free every session
+      // ---------------------------------------------------------------------
+      window.addEventListener('pagehide', () => {
+        barista.controller?.abort();
+        sentiment.controller?.abort();
+        branching.controller?.abort();
+        [...liveSessions].forEach(destroy);
+        barista.session = null;
+        sentiment.baseSession = null;
+        branching.branches = [];
+        branching.activeId = null;
+      });
+    })();
+  </script>
+
 </body>
 
