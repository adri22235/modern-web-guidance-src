+    /* Card badge: hidden by default, revealed only by a context that wants it */
+    .card-badge {
+      display: none;
+    }
+
+    /* ------------------------------------------------------------------
+       Semantic section context
+       A section declares *what it is* via a custom property; cards opt in
+       to react. Neither side names the other, so new contexts or new card
+       types can be added independently.
+       ------------------------------------------------------------------ */
+    .seasonal {
+      --surface: seasonal;
+      --season-accent: #e65100;
+      --season-accent-soft: #fff3e0;
+      --season-ink: #bf360c;
+    }
+
+    /* Fallback: selector-based context for browsers without style queries.
+       :where() keeps specificity at zero so the style query below wins. */
+    :where(.seasonal) .card {
+      position: relative;
+      background: linear-gradient(180deg, var(--season-accent-soft), white 60%);
+      border-top: 4px solid var(--season-accent);
+      box-shadow: 0 6px 16px rgba(191, 54, 12, 0.12);
+      transition: transform 0.25s, box-shadow 0.25s;
+    }
+
+    :where(.seasonal) .card:hover {
+      transform: translateY(-4px);
+      box-shadow: 0 10px 24px rgba(191, 54, 12, 0.18);
+    }
+
+    :where(.seasonal) .card h3 {
+      color: var(--season-ink);
+    }
+
+    :where(.seasonal) .card .btn {
+      background: var(--season-accent);
+    }
+
+    :where(.seasonal) .card .btn:hover {
+      background: var(--season-ink);
+    }
+
+    :where(.seasonal) .card-badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 10px;
+      border-radius: 999px;
+      background: var(--season-accent);
+      color: white;
+      font-size: 0.7rem;
+      font-weight: 600;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    /* Progressive enhancement: cards react to the inherited semantic flag */
+    @container style(--surface: seasonal) {
+      .card {
+        position: relative;
+        background: linear-gradient(180deg, var(--season-accent-soft), white 60%);
+        border-top: 4px solid var(--season-accent);
+        box-shadow: 0 6px 16px rgba(191, 54, 12, 0.12);
+        transition: transform 0.25s, box-shadow 0.25s;
+      }
+
+      .card:hover {
+        transform: translateY(-4px);
+        box-shadow: 0 10px 24px rgba(191, 54, 12, 0.18);
+      }
+
+      .card h3 {
+        color: var(--season-ink);
+      }
+
+      .card .btn {
+        background: var(--season-accent);
+      }
+
+      .card .btn:hover {
+        background: var(--season-ink);
+      }
+
+      .card-badge {
+        display: inline-block;
+        margin-bottom: 10px;
+        padding: 2px 10px;
+        border-radius: 999px;
+        background: var(--season-accent);
+        color: white;
+        font-size: 0.7rem;
+        font-weight: 600;
+        letter-spacing: 0.08em;
+        text-transform: uppercase;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card {
+        transition: none;
+      }
+
+      .card:hover {
+        transform: none;
+      }
+    }
+
