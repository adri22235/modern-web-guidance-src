+}
+
+/* ==========================================================================
+   Semantic context styling
+   --------------------------------------------------------------------------
+   Components resolve a SemanticContext (src/utils/semantics.ts) and expose it
+   as data-desk / data-tone / data-kind attributes plus --sem-* custom
+   properties. All context-dependent visual logic lives here so components
+   stay declarative.
+   ========================================================================== */
+
+[data-desk] {
+  --sem-accent: #f59e0b;
+  --sem-ink: #92400e;
+  --sem-tint: #fffbeb;
+}
+[data-desk="mixed"] {
+  --sem-accent: #111827;
+  --sem-ink: #111827;
+  --sem-tint: #f3f4f6;
+}
+
+/* ---- Kicker (category label): each desk has its own typographic voice --- */
+.sem-kicker {
+  color: var(--sem-ink);
+  font-size: 0.8125rem;
+  line-height: 1.25rem;
+  display: inline-flex;
+  align-items: center;
+  gap: 0.375rem;
+}
+.sem-kicker::before {
+  content: "";
+  display: inline-block;
+  width: 0.5rem;
+  height: 0.5rem;
+  background: var(--sem-accent);
+  flex-shrink: 0;
+}
+[data-desk="news"] .sem-kicker,
+.sem-kicker[data-desk="news"] {
+  text-transform: uppercase; font-weight: 800; letter-spacing: 0.08em;
+}
+[data-desk="politics"] .sem-kicker,
+.sem-kicker[data-desk="politics"] {
+  font-variant: small-caps; font-weight: 700; letter-spacing: 0.06em; font-size: 0.9375rem;
+}
+[data-desk="business"] .sem-kicker,
+.sem-kicker[data-desk="business"] {
+  text-transform: uppercase; font-weight: 600; letter-spacing: 0.12em; font-variant-numeric: tabular-nums;
+}
+[data-desk="science"] .sem-kicker,
+.sem-kicker[data-desk="science"] {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 500; letter-spacing: 0.02em;
+}
+[data-desk="science"] .sem-kicker::before { border-radius: 9999px; }
+[data-desk="sports"] .sem-kicker,
+.sem-kicker[data-desk="sports"] {
+  text-transform: uppercase; font-style: italic; font-weight: 900; letter-spacing: 0.04em;
+}
+[data-desk="sports"] .sem-kicker::before { transform: skewX(-18deg); width: 0.75rem; }
+[data-desk="culture"] .sem-kicker,
+.sem-kicker[data-desk="culture"] {
+  font-family: "Grenze", serif; font-style: italic; font-size: 0.9375rem; letter-spacing: 0.04em;
+}
+[data-desk="culture"] .sem-kicker::before { transform: rotate(45deg); }
+[data-desk="lifestyle"] .sem-kicker,
+.sem-kicker[data-desk="lifestyle"] {
+  font-family: "Grenze", serif; font-size: 0.9375rem; letter-spacing: 0.1em;
+}
+[data-desk="lifestyle"] .sem-kicker::before { border-radius: 9999px 9999px 9999px 0; }
+
+/* ---- Headline hover & accents --------------------------------------------- */
+.sem-headline { transition: color 150ms ease; }
+a:hover .sem-headline,
+.group:hover .sem-headline { color: var(--sem-accent); }
+
+.sem-rule { border-top: 3px solid var(--sem-accent); }
+[data-desk="sports"] .sem-rule { border-top-width: 5px; }
+[data-desk="culture"] .sem-rule,
+[data-desk="lifestyle"] .sem-rule { border-top-style: double; border-top-width: 4px; }
+
+.sem-accent-text { color: var(--sem-ink); }
+.sem-tint { background: var(--sem-tint); }
+
+/* ---- Media treatment ------------------------------------------------------ */
+.sem-media { overflow: hidden; }
+.sem-media img { transition: transform 400ms ease, filter 400ms ease; }
+.group:hover .sem-media img { transform: scale(1.03); }
+
+/* Sober: restrained — desaturated imagery, no playful motion, quiet hover. */
+[data-tone="sober"] .sem-media img { filter: grayscale(0.85) contrast(1.05); }
+[data-tone="sober"] .group:hover .sem-media img,
+[data-tone="sober"].group:hover .sem-media img { filter: grayscale(0.3); transform: none; }
+[data-tone="sober"] a:hover .sem-headline,
+[data-tone="sober"] .group:hover .sem-headline,
+[data-tone="sober"].group:hover .sem-headline { color: inherit; text-decoration: underline; text-underline-offset: 0.2em; }
+
+/* Playful: softer corners and a little lift. */
+[data-tone="playful"] .sem-media { border-radius: 1rem; }
+[data-tone="playful"].group:hover .sem-media img,
+[data-tone="playful"] .group:hover .sem-media img { transform: scale(1.04) rotate(-0.75deg); }
+
+/* ---- Section headers adapt to the dominant desk of their contents --------- */
+.sem-section-title {
+  border-bottom: 2px solid var(--sem-accent);
+}
+[data-desk="mixed"] .sem-section-title,
+.sem-section-title[data-desk="mixed"] { border-bottom-color: #111827; }
+
+/* ---- Badges --------------------------------------------------------------- */
+.sem-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.25rem;
+  font-size: 0.6875rem;
+  line-height: 1rem;
+  font-weight: 600;
+  padding: 0.125rem 0.5rem;
+  border-radius: 9999px;
+  background: var(--sem-tint);
+  color: var(--sem-ink);
+  white-space: nowrap;
+}
+.sem-badge[data-signal="fresh"] { background: var(--sem-accent); color: #fff; }
+.sem-badge[data-signal="sensitive"] { background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; }
+
+@media (prefers-reduced-motion: reduce) {
+  .sem-media img, .sem-headline { transition: none; }
+  .group:hover .sem-media img { transform: none !important; }
+}
