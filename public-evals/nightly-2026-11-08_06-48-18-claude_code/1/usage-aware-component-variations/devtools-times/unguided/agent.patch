+        <ExclamationTriangleIcon className="w-5 h-5 flex-shrink-0 mt-0.5" aria-hidden="true" />
+        <p>
+            <strong class="font-semibold">Content note:</strong> this story discusses violent crime.
+            Images are shown desaturated by default.
+        </p>
+    </aside>
+)}
diff --git a/src/components/semantic/EntryCard.astro b/src/components/semantic/EntryCard.astro
new file mode 100644
index 0000000..e61e010
--- /dev/null
+++ b/src/components/semantic/EntryCard.astro
@@ -0,0 +1,42 @@
+---
+/**
+ * Card for non-article entries (reports, multimedia). Layout and iconography
+ * adapt to the entry kind; colour adapts to the desk.
+ */
+import type { CollectionEntry } from 'astro:content';
+import { getEntryContext, semanticAttrs } from '../../utils/semantics';
+import SemanticKicker from './SemanticKicker.astro';
+import ReadingMeta from './ReadingMeta.astro';
+import { PlayIcon, DocumentTextIcon } from '@heroicons/react/24/solid';
+
+export interface Props {
+    entry: CollectionEntry<'reports'> | CollectionEntry<'multimedia'>;
+}
+
+const { entry } = Astro.props;
+const ctx = getEntryContext(entry);
+const isVideo = ctx.kind === 'multimedia';
+const published = new Date(entry.data.publishDate);
+---
+<article class="group flex gap-4 items-start p-4 border border-gray-200 hover:shadow-sm transition-shadow" {...semanticAttrs(ctx)}>
+    <div
+        class:list={[
+            'sem-tint flex-shrink-0 flex items-center justify-center sem-accent-text',
+            isVideo ? 'w-20 h-20 rounded-full' : 'w-16 h-20 rounded-sm',
+        ]}
+        aria-hidden="true"
+    >
+        {isVideo ? <PlayIcon className="w-8 h-8 ml-1" /> : <DocumentTextIcon className="w-8 h-8" />}
+    </div>
+    <div class="flex flex-col gap-1 min-w-0">
+        <SemanticKicker ctx={ctx} link={false} />
+        <h2 class="sem-headline text-xl font-brand text-gray-900">{entry.data.title}</h2>
+        <p class="text-gray-600 text-sm">{entry.data.description}</p>
+        <div class="flex items-center gap-3 text-gray-500 mt-1">
+            <ReadingMeta ctx={ctx} />
+            {!isNaN(published.valueOf()) && (
+                <time datetime={published.toISOString()} class="text-xs">{published.toLocaleDateString('en-US', { dateStyle: 'medium' })}</time>
+            )}
+        </div>
+    </div>
+</article>
diff --git a/src/components/semantic/ReadingMeta.astro b/src/components/semantic/ReadingMeta.astro
new file mode 100644
index 0000000..9cfb4f4
--- /dev/null
+++ b/src/components/semantic/ReadingMeta.astro
@@ -0,0 +1,26 @@
+---
+/**
+ * Duration/format indicator that adapts to the content kind: articles show
+ * reading time, videos show a play glyph, reports show a document glyph.
+ */
+import type { SemanticContext } from '../../utils/semantics';
+import { KIND_LABELS } from '../../utils/semantics';
+import { BookOpenIcon, PlayCircleIcon, DocumentChartBarIcon } from '@heroicons/react/24/outline';
+
+export interface Props {
+    ctx: SemanticContext;
+    minutes?: number;
+    size?: 'sm' | 'md';
+}
+
+const { ctx, minutes, size = 'sm' } = Astro.props;
+const Icon = ctx.kind === 'multimedia' ? PlayCircleIcon : ctx.kind === 'report' ? DocumentChartBarIcon : BookOpenIcon;
+const iconClass = size === 'md' ? 'w-5 h-5' : 'w-4 h-4';
+const label = minutes
+    ? `${minutes} min${ctx.kind === 'multimedia' ? ' watch' : ' read'}`
+    : KIND_LABELS[ctx.kind].noun;
+---
+<span class:list={['font-medium flex items-center gap-1', size === 'md' ? 'text-sm' : 'text-xs']}>
+    <Icon className={`${iconClass} -mt-px`} aria-hidden="true" />
+    {label}
+</span>
diff --git a/src/components/semantic/SemanticBadges.astro b/src/components/semantic/SemanticBadges.astro
new file mode 100644
index 0000000..73bac03
--- /dev/null
+++ b/src/components/semantic/SemanticBadges.astro
@@ -0,0 +1,44 @@
+---
+/**
+ * Signal badges ("New", "Long read", "Content note", …) derived from context.
+ * Badges are ordered by importance and capped so cards never get noisy.
+ */
+import type { SemanticContext, Signal } from '../../utils/semantics';
+import { SIGNAL_LABELS } from '../../utils/semantics';
+import { SparklesIcon, BookOpenIcon, ExclamationTriangleIcon, LightBulbIcon } from '@heroicons/react/16/solid';
+
+export interface Props {
+    ctx: SemanticContext;
+    /** Restrict to these signals. Defaults to all. */
+    only?: Signal[];
+    max?: number;
+    class?: string;
+}
+
+const PRIORITY: Signal[] = ['sensitive', 'fresh', 'longread', 'explainer'];
+const ICONS = {
+    fresh: SparklesIcon,
+    longread: BookOpenIcon,
+    sensitive: ExclamationTriangleIcon,
+    explainer: LightBulbIcon,
+} as const;
+
+const { ctx, only, max = 2, class: className = '' } = Astro.props;
+const signals = PRIORITY
+    .filter(s => ctx.signals.includes(s))
+    .filter(s => !only || only.includes(s))
+    .slice(0, max);
+---
+{signals.length > 0 && (
+    <ul class:list={['flex flex-wrap gap-1.5', className]} aria-label="Story labels">
+        {signals.map(signal => {
+            const Icon = ICONS[signal];
+            return (
+                <li class="sem-badge" data-signal={signal}>
+                    <Icon className="w-3 h-3" aria-hidden="true" />
+                    {SIGNAL_LABELS[signal]}
+                </li>
+            );
+        })}
+    </ul>
+)}
