+---
+/**
+ * Category label whose typography and accent adapt to the resolved desk.
+ * Renders as a link to the category page unless `link={false}`.
+ */
+import type { SemanticContext } from '../../utils/semantics';
+
+export interface Props {
+    ctx: SemanticContext;
+    link?: boolean;
+    class?: string;
+}
+
+const { ctx, link = true, class: className = '' } = Astro.props;
+const href = `${import.meta.env.BASE_URL}category/${encodeURIComponent(ctx.categorySlug)}`;
+---
+{link ? (
+    <a href={href} class:list={['sem-kicker hover:underline', className]} data-desk={ctx.desk}>{ctx.categoryLabel}</a>
+) : (
+    <span class:list={['sem-kicker', className]} data-desk={ctx.desk}>{ctx.categoryLabel}</span>
+)}
