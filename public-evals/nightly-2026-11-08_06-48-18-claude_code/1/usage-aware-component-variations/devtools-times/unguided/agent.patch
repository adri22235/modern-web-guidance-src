new file mode 100644
index 0000000..3361eb9
--- /dev/null
+++ b/src/utils/semantics.ts
@@ -0,0 +1,225 @@
+/**
+ * Semantic context resolution.
+ *
+ * Content in this app carries loosely-structured metadata (free-form category
+ * strings like "science", "Science & Tech", "News & Politics", optional tags,
+ * reading time, dates). This module normalises that metadata into a small,
+ * stable vocabulary of *semantic context* that components use to decide how
+ * to present themselves — accent colour, typographic voice, iconography,
+ * image treatment and which badges to show.
+ *
+ * Components never branch on raw category strings; they consume a
+ * `SemanticContext` and emit `data-*` attributes + CSS custom properties.
+ * The visual rules for each context live in `src/styles/global.css`.
+ */
+
+import type { CollectionEntry } from 'astro:content';
+
+/** Editorial desk — drives accent colour and typographic voice. */
+export type Desk =
+    | 'news'
+    | 'politics'
+    | 'business'
+    | 'science'
+    | 'sports'
+    | 'culture'
+    | 'lifestyle';
+
+/** Emotional register — drives how loud or restrained the presentation is. */
+export type Tone = 'neutral' | 'sober' | 'playful';
+
+/** Kind of content — drives iconography and call-to-action copy. */
+export type ContentKind = 'article' | 'report' | 'multimedia';
+
+/** Secondary signals surfaced as badges. */
+export type Signal = 'fresh' | 'longread' | 'sensitive' | 'explainer';
+
+export interface DeskTheme {
+    label: string;
+    /** Strong accent used for kickers, rules and hover states. */
+    accent: string;
+    /** Darker variant of the accent with AA contrast on white for small text. */
+    ink: string;
+    /** Very light tint for backgrounds/badges. */
+    tint: string;
+}
+
+export const DESK_THEMES: Record<Desk, DeskTheme> = {
+    news:      { label: 'News',      accent: '#dc2626', ink: '#991b1b', tint: '#fef2f2' },
+    politics:  { label: 'Politics',  accent: '#2563eb', ink: '#1e3a8a', tint: '#eff6ff' },
+    business:  { label: 'Business',  accent: '#059669', ink: '#065f46', tint: '#ecfdf5' },
+    science:   { label: 'Science',   accent: '#0891b2', ink: '#155e75', tint: '#ecfeff' },
+    sports:    { label: 'Sports',    accent: '#ea580c', ink: '#9a3412', tint: '#fff7ed' },
+    culture:   { label: 'Culture',   accent: '#9333ea', ink: '#6b21a8', tint: '#faf5ff' },
+    lifestyle: { label: 'Lifestyle', accent: '#d97706', ink: '#92400e', tint: '#fffbeb' },
+};
+
+/** Sober tone overrides the desk palette with a restrained neutral one. */
+const SOBER_THEME: Omit<DeskTheme, 'label'> = {
+    accent: '#475569',
+    ink: '#334155',
+    tint: '#f1f5f9',
+};
+
+export interface SemanticContext {
+    desk: Desk;
+    tone: Tone;
+    kind: ContentKind;
+    signals: Signal[];
+    /** Human-readable category label exactly as the content names it. */
+    categoryLabel: string;
+    /** URL slug for the category page. */
+    categorySlug: string;
+    theme: DeskTheme;
+}
+
+// ---------------------------------------------------------------------------
+// Keyword tables. Order in DESK_RULES matters: first match wins, so more
+// specific desks come before broader ones.
+// ---------------------------------------------------------------------------
+
+const DESK_RULES: Array<[Desk, RegExp]> = [
+    ['sports',    /\b(sports?|athlet\w*|olympic\w*|championships?|tennis|cycling|swimming|football|super bowl)\b/i],
+    ['politics',  /\b(politic\w*|election\w*|activism|government|policy|national)\b/i],
+    ['business',  /\b(business|econom\w*|labou?r|unions?|market\w*|manufactur\w*|jobs|housing|industry)\b/i],
+    ['science',   /\b(science|tech\w*|research|medicine|forensic\w*|geology)\b/i],
+    ['culture',   /\b(culture|arts?|media|journalism|theat(er|re)|music|dance|ballet|festivals?|film)\b/i],
+    ['lifestyle', /\b(lifestyle|pets?|food|coffee|travel|urban|cities|transit|wellness)\b/i],
+    ['news',      /\b(news|crime|world)\b/i],
+];
+
+const SENSITIVE = /\b(kill\w*|murder\w*|crim(e|es|inal\w*)|violen\w*|forensic\w*|death|victims?|trafficking)\b/i;
+const PLAYFUL   = /\b(humou?r|comedy|improv|pets?|dogs?|cats?|tyrant|scruffy|festival)\b/i;
+const EXPLAINER = /\b(how|why|what|science of|art of|inside|guide)\b/i;
+
+/** Threshold (minutes) above which an article is considered a long read. */
+export const LONGREAD_MINUTES = 6;
+/** Stories within this many days of the newest story are flagged "fresh". */
+export const FRESH_WINDOW_DAYS = 3;
+
+export function slugifyCategory(category: string): string {
+    return category.toLowerCase();
+}
+
+export function formatCategoryLabel(category: string): string {
+    return category.charAt(0).toUpperCase() + category.slice(1);
+}
+
+/** Map a free-form category (plus optional supporting text) to a desk. */
+export function resolveDesk(category: string, hints: string[] = []): Desk {
+    // The category is authoritative; hints (tags) only break ties.
+    for (const [desk, re] of DESK_RULES) {
+        if (re.test(category)) return desk;
+    }
+    const haystack = hints.join(' ');
+    for (const [desk, re] of DESK_RULES) {
+        if (re.test(haystack)) return desk;
+    }
+    return 'news';
+}
+
+export function resolveTone(text: string): Tone {
+    if (SENSITIVE.test(text)) return 'sober';
+    if (PLAYFUL.test(text)) return 'playful';
+    return 'neutral';
+}
+
+function buildContext(input: {
+    category: string;
+    kind: ContentKind;
+    text: string;
+    hints?: string[];
+    signals?: Signal[];
+}): SemanticContext {
+    const desk = resolveDesk(input.category, input.hints);
+    const tone = resolveTone(input.text);
+    const base = DESK_THEMES[desk];
+    const theme = tone === 'sober' ? { ...base, ...SOBER_THEME } : base;
+    const signals = new Set(input.signals ?? []);
+    if (tone === 'sober') signals.add('sensitive');
+
+    return {
+        desk,
+        tone,
+        kind: input.kind,
+        signals: [...signals],
+        categoryLabel: formatCategoryLabel(input.category),
+        categorySlug: slugifyCategory(input.category),
+        theme,
+    };
+}
+
+export interface ArticleContextOptions {
+    /** Date of the newest article in the current listing, for freshness. */
+    newest?: Date;
+}
+
+export function getArticleContext(
+    article: CollectionEntry<'articles'>,
+    options: ArticleContextOptions = {},
+): SemanticContext {
+    const { title, summary, category, tags = [], readingTime, date } = article.data;
+    const text = [title, summary, ...tags].join(' ');
+    const signals: Signal[] = [];
+
+    if (readingTime && readingTime >= LONGREAD_MINUTES) signals.push('longread');
+    if (EXPLAINER.test(title)) signals.push('explainer');
+    if (options.newest && date) {
+        const ageDays = (options.newest.valueOf() - date.valueOf()) / 86_400_000;
+        if (ageDays >= 0 && ageDays <= FRESH_WINDOW_DAYS) signals.push('fresh');
+    }
+
+    return buildContext({ category, kind: 'article', text, hints: tags, signals });
+}
+
+export function getEntryContext(
+    entry: CollectionEntry<'reports'> | CollectionEntry<'multimedia'>,
+): SemanticContext {
+    const { title, description, category } = entry.data;
+    const kind: ContentKind = entry.collection === 'reports' ? 'report' : 'multimedia';
+    return buildContext({ category, kind, text: `${title} ${description}` });
+}
+
+/** Dominant desk of a list of contexts — used to theme section headers. */
+export function dominantDesk(contexts: SemanticContext[]): Desk | 'mixed' {
+    if (contexts.length === 0) return 'mixed';
+    const counts = new Map<Desk, number>();
+    for (const c of contexts) counts.set(c.desk, (counts.get(c.desk) ?? 0) + 1);
+    const [desk, count] = [...counts.entries()].sort((a, b) => b[1] - a[1])[0];
+    return count > contexts.length / 2 ? desk : 'mixed';
+}
+
+/**
+ * Attributes to spread on a component's root element. Exposes the context to
+ * CSS through data attributes and the palette through custom properties.
+ */
+export function semanticAttrs(ctx: SemanticContext): Record<string, string> {
+    return {
+        'data-desk': ctx.desk,
+        'data-tone': ctx.tone,
+        'data-kind': ctx.kind,
+        style: `--sem-accent:${ctx.theme.accent};--sem-ink:${ctx.theme.ink};--sem-tint:${ctx.theme.tint};`,
+    };
+}
+
+export function deskAttrs(desk: Desk | 'mixed'): Record<string, string> {
+    if (desk === 'mixed') return { 'data-desk': 'mixed' };
+    const t = DESK_THEMES[desk];
+    return {
+        'data-desk': desk,
+        style: `--sem-accent:${t.accent};--sem-ink:${t.ink};--sem-tint:${t.tint};`,
+    };
+}
+
+export const SIGNAL_LABELS: Record<Signal, string> = {
+    fresh: 'New',
+    longread: 'Long read',
+    sensitive: 'Content note',
+    explainer: 'Explainer',
+};
+
+export const KIND_LABELS: Record<ContentKind, { noun: string; verb: string }> = {
+    article: { noun: 'Article', verb: 'Read' },
+    report: { noun: 'Report', verb: 'Read report' },
+    multimedia: { noun: 'Video', verb: 'Watch' },
+};
