+/**
+ * Section wrapper whose heading rule takes the accent of the dominant desk of
+ * its contents. Sections mixing several desks fall back to a neutral rule.
+ */
+import type { SemanticContext } from '../../utils/semantics';
+import { dominantDesk, deskAttrs } from '../../utils/semantics';
+
+export interface Props {
+    title: string;
+    contexts: SemanticContext[];
+    class?: string;
+}
+
+const { title, contexts, class: className = '' } = Astro.props;
+const attrs = deskAttrs(dominantDesk(contexts));
+---
+<section class:list={['p-4 md:p-6', className]} {...attrs}>
+    <h2 class="sem-section-title text-3xl font-bold pb-2 mb-6 lg:mb-8">
+        {title}
+    </h2>
+    <slot />
+</section>
