+}
+/* ==========================================================================
+   Semantic surfaces
+   --------------------------------------------------------------------------
+   Layout containers declare *what kind of place* they are via the inherited
+   `--surface` custom property. Components never need to know which element
+   produced the context, and surfaces never name the components that react.
+   No `container-type` is needed: style queries match inherited custom
+   properties on the nearest ancestor.
+   ========================================================================== */
+.surface-featured {
+  --surface: featured;
+}
+
+.surface-compact {
+  --surface: compact;
+}
+
+/* ==========================================================================
+   ArticleTeaser (card variant)
+   ========================================================================== */
+@layer components {
+  .teaser {
+    display: flex;
+    flex-direction: column;
+    height: 100%;
+  }
+
+  .teaser-media {
+    display: block;
+  }
+
+  .teaser-body {
+    display: flex;
+    flex-direction: column;
+    flex-grow: 1;
+    margin-top: 0.75rem;
+  }
+
+  .teaser-eyebrow {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 0.5rem;
+  }
+
+  .teaser-kicker {
+    color: var(--color-amber-800);
+    font-size: var(--text-sm);
+    letter-spacing: var(--tracking-widest);
+  }
+
+  /* Hidden by default: only revealed on featured surfaces */
+  .teaser-badge {
+    display: none;
+    padding: 0.125rem 0.5rem;
+    border-radius: var(--radius-sm);
+    background: var(--color-amber-400);
+    color: var(--color-gray-950);
+    font-size: var(--text-xs);
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: var(--tracking-wide);
+  }
+
+  .teaser-title {
+    font-family: "Grenze", serif;
+    font-weight: 500;
+    color: var(--color-gray-800);
+    font-size: var(--text-lg);
+    line-height: var(--text-lg--line-height);
+    transition: color 150ms;
+    @media (width >= 48rem) {
+      font-size: var(--text-xl);
+      line-height: var(--text-xl--line-height);
+    }
+  }
+
+  .teaser:hover .teaser-title {
+    color: var(--color-amber-600);
+  }
+
+  .teaser-summary {
+    margin-top: 0.25rem;
+    color: var(--color-gray-600);
+  }
+
+  /* Default: outlined, informational call to action */
+  .teaser-cta {
+    align-self: flex-start;
+    margin-top: 0.75rem;
+    padding: 0.25rem 0.75rem;
+    border: 1px solid currentColor;
+    border-radius: var(--radius-md);
+    background: transparent;
+    color: var(--color-gray-700);
+    font-size: var(--text-sm);
+    font-weight: 600;
+    transition: background-color 150ms, color 150ms;
+    &:hover {
+      background: var(--color-gray-100);
+    }
+  }
+
+  .teaser-meta {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 0.5rem;
+    margin-top: auto;
+    padding-top: 0.5rem;
+    border-top: 1px solid var(--color-gray-100);
+    color: var(--color-gray-500);
+    font-size: var(--text-sm);
+  }
+
+  /* Hidden by default: only revealed on compact surfaces */
+  .teaser-date {
+    display: none;
+  }
+
+  /* ------------------------------------------------------------------------
+     Fallback: selector-based contextual styles for browsers without
+     container style queries. `:where()` keeps specificity equal to the
+     style-query rules below, which win by source order where supported.
+     Remove once container style queries are Baseline Widely available.
+     ------------------------------------------------------------------------ */
+  :where(.surface-featured) .teaser-badge {
+    display: inline-block;
+  }
+  :where(.surface-featured) .teaser-kicker {
+    color: var(--color-amber-300);
+  }
+  :where(.surface-featured) .teaser-title {
+    color: var(--color-white);
+  }
+  :where(.surface-featured) .teaser:hover .teaser-title {
+    color: var(--color-amber-300);
+  }
+  :where(.surface-featured) .teaser-summary {
+    color: var(--color-gray-300);
+  }
+  :where(.surface-featured) .teaser-cta {
+    border-color: transparent;
+    background: var(--color-amber-400);
+    color: var(--color-gray-950);
+    &:hover {
+      background: var(--color-amber-300);
+    }
+  }
+  :where(.surface-featured) .teaser-meta {
+    border-color: color-mix(in srgb, var(--color-white) 15%, transparent);
+    color: var(--color-gray-400);
+  }
+
+  :where(.surface-compact) .teaser-media,
+  :where(.surface-compact) .teaser-summary,
+  :where(.surface-compact) .teaser-cta,
+  :where(.surface-compact) .teaser-reading-time {
+    display: none;
+  }
+  :where(.surface-compact) .teaser-body {
+    margin-top: 0;
+  }
+  :where(.surface-compact) .teaser-kicker {
+    font-size: var(--text-xs);
+  }
+  :where(.surface-compact) .teaser-title {
+    font-family: inherit;
+    font-size: var(--text-base);
+    line-height: var(--text-base--line-height);
+    font-weight: 700;
+    color: var(--color-gray-900);
+  }
+  :where(.surface-compact) .teaser-meta {
+    border-top: 0;
+    padding-top: 0.25rem;
+    font-size: var(--text-xs);
+  }
+  :where(.surface-compact) .teaser-date {
+    display: inline;
+  }
+
+  /* ------------------------------------------------------------------------
+     Progressive enhancement: semantic context via container style queries
+     ------------------------------------------------------------------------ */
+  @container style(--surface: featured) {
+    .teaser-badge {
+      display: inline-block;
+    }
+    .teaser-kicker {
+      color: var(--color-amber-300);
+    }
+    .teaser-title {
+      color: var(--color-white);
+    }
+    .teaser:hover .teaser-title {
+      color: var(--color-amber-300);
+    }
+    .teaser-summary {
+      color: var(--color-gray-300);
+    }
+    .teaser-cta {
+      border-color: transparent;
+      background: var(--color-amber-400);
+      color: var(--color-gray-950);
+      &:hover {
+        background: var(--color-amber-300);
+      }
+    }
+    .teaser-meta {
+      border-color: color-mix(in srgb, var(--color-white) 15%, transparent);
+      color: var(--color-gray-400);
+    }
+  }
+
+  @container style(--surface: compact) {
+    .teaser-media,
+    .teaser-summary,
+    .teaser-cta,
+    .teaser-reading-time {
+      display: none;
+    }
+    .teaser-body {
+      margin-top: 0;
+    }
+    .teaser-kicker {
+      font-size: var(--text-xs);
+    }
+    .teaser-title {
+      font-family: inherit;
+      font-size: var(--text-base);
+      line-height: var(--text-base--line-height);
+      font-weight: 700;
+      color: var(--color-gray-900);
+    }
+    .teaser-meta {
+      border-top: 0;
+      padding-top: 0.25rem;
+      font-size: var(--text-xs);
+    }
+    .teaser-date {
+      display: inline;
+    }
+  }
+}
