+  <script>
+    (() => {
+      // Invoker Commands fallback: open/close dialogs from script where `command` is unsupported.
+      const nativeCommands = 'commandForElement' in HTMLButtonElement.prototype;
+
+      // Record the trigger's geometry so the dialog expands out of the exact button that was pressed.
+      const setOrigin = (dialog, trigger) => {
+        const b = trigger.getBoundingClientRect();
+        const vw = document.documentElement.clientWidth;
+        const vh = window.innerHeight;
+        const w = Math.min(vw * 0.92, 520);
+        const h = Math.min(vh * 0.9, 640); // approximate; refined after layout below
+        dialog.style.setProperty('--from-x', `${b.left + b.width / 2 - vw / 2}px`);
+        dialog.style.setProperty('--from-y', `${b.top + b.height / 2 - vh / 2}px`);
+        dialog.style.setProperty('--from-sx', (b.width / w).toFixed(3));
+        dialog.style.setProperty('--from-sy', (b.height / h).toFixed(3));
+      };
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('button[commandfor]');
+        if (!trigger) return;
+        const dialog = document.getElementById(trigger.getAttribute('commandfor'));
+        if (!(dialog instanceof HTMLDialogElement)) return;
+        const command = trigger.getAttribute('command');
+
+        if (command === 'show-modal') {
+          setOrigin(dialog, trigger);
+          dialog._trigger = trigger;
+          if (!nativeCommands && !dialog.open) dialog.showModal();
+        } else if (command === 'close' && !nativeCommands) {
+          dialog.close();
+        }
+      });
+
+      document.querySelectorAll('.drink-dialog').forEach((dialog) => {
+        // Refine the vertical scale with the dialog's real height once it is laid out.
+        dialog.addEventListener('toggle', (e) => {
+          if (e.newState === 'open' && dialog._trigger) {
+            const b = dialog._trigger.getBoundingClientRect();
+            dialog.style.setProperty('--from-sy', (b.height / dialog.offsetHeight).toFixed(3));
+          }
+        });
+
+        // Light dismiss fallback where `closedby` is unsupported.
+        if (!('closedBy' in HTMLDialogElement.prototype)) {
+          const outside = (e) => {
+            const r = dialog.getBoundingClientRect();
+            return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+          };
+          let pressedOutside = false;
+          dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+          dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) dialog.close(); });
+        }
+      });
+
+      // Carousel prev/next buttons (swipe, trackpad, and Tab already work natively).
+      const list = document.getElementById('seasonal-list');
+      const controls = document.querySelector('.carousel-controls');
+      const [prev, next] = controls.querySelectorAll('button');
+      controls.hidden = false;
+
+      const step = () => {
+        const item = list.querySelector('li');
+        const gap = parseFloat(getComputedStyle(list).columnGap) || 0;
+        return item ? item.getBoundingClientRect().width + gap : list.clientWidth;
+      };
+      const update = () => {
+        const max = list.scrollWidth - list.clientWidth - 2;
+        prev.disabled = list.scrollLeft <= 2;
+        next.disabled = list.scrollLeft >= max;
+        controls.hidden = list.scrollWidth <= list.clientWidth + 2;
+      };
+      controls.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-dir]');
+        if (btn) list.scrollBy({ left: Number(btn.dataset.dir) * step() });
+      });
+      list.addEventListener('scroll', update, { passive: true });
+      new ResizeObserver(update).observe(list);
+      update();
+    })();
+  </script>
