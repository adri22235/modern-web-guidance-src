+        var max = cards.length - 1;
+        i = Math.max(0, Math.min(max, i));
+        track.scrollTo({ left: cards[i].offsetLeft - cards[0].offsetLeft, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
+      }
+
+      function updateControls() {
+        var maxScroll = track.scrollWidth - track.clientWidth;
+        prevBtn.disabled = track.scrollLeft <= 2;
+        nextBtn.disabled = track.scrollLeft >= maxScroll - 2;
+        var first = Math.min(cards.length, currentIndex() + 1);
+        var last = Math.min(cards.length, first + visibleCount() - 1);
+        status.textContent = (first === last ? first : first + '–' + last) + ' of ' + cards.length;
+      }
+
+      function move(dir) {
+        scrollToIndex(currentIndex() + dir * visibleCount());
+      }
+
+      prevBtn.addEventListener('click', function () { move(-1); });
+      nextBtn.addEventListener('click', function () { move(1); });
+
+      var scrollTimer;
+      track.addEventListener('scroll', function () {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(updateControls, 60);
+      }, { passive: true });
+      window.addEventListener('resize', updateControls);
+
+      // Arrow keys / Home / End when the track itself is focused.
+      track.addEventListener('keydown', function (e) {
+        if (e.target !== track) return;
+        var handled = true;
+        switch (e.key) {
+          case 'ArrowRight': scrollToIndex(currentIndex() + 1); break;
+          case 'ArrowLeft': scrollToIndex(currentIndex() - 1); break;
+          case 'Home': scrollToIndex(0); break;
+          case 'End': scrollToIndex(cards.length - 1); break;
+          default: handled = false;
+        }
+        if (handled) e.preventDefault();
+      });
+
+      // Tabbing onto a partially hidden card's button brings the card into view.
+      track.addEventListener('focusin', function (e) {
+        var card = e.target.closest('.card');
+        if (!card) return;
+        var tRect = track.getBoundingClientRect();
+        var cRect = card.getBoundingClientRect();
+        if (cRect.left < tRect.left || cRect.right > tRect.right) {
+          scrollToIndex(cards.indexOf(card));
+        }
+      });
+
+      // Mouse drag-to-swipe (touch/pen already swipe natively).
+      var drag = null;
+      var suppressClick = false;
+      track.addEventListener('pointerdown', function (e) {
+        if (e.pointerType !== 'mouse' || e.button !== 0) return;
+        drag = { x: e.clientX, left: track.scrollLeft, moved: false, id: e.pointerId };
+      });
+      track.addEventListener('pointermove', function (e) {
+        if (!drag) return;
+        var dx = e.clientX - drag.x;
+        if (!drag.moved && Math.abs(dx) > 5) {
+          drag.moved = true;
+          track.classList.add('is-dragging');
+          track.setPointerCapture(drag.id);
+        }
+        if (drag.moved) track.scrollLeft = drag.left - dx;
+      });
+      function endDrag(e) {
+        if (!drag) return;
+        if (drag.moved) {
+          suppressClick = true;
+          var dx = e.clientX - drag.x;
+          var base = Math.round(drag.left / cardStep());
+          var delta = Math.abs(dx) > cardStep() * 0.15 ? Math.max(1, Math.round(Math.abs(dx) / cardStep())) : 0;
+          track.classList.remove('is-dragging');
+          scrollToIndex(base + (dx < 0 ? delta : -delta));
+          setTimeout(function () { suppressClick = false; }, 0);
+        }
+        drag = null;
+      }
+      track.addEventListener('pointerup', endDrag);
+      track.addEventListener('pointercancel', endDrag);
+      track.addEventListener('click', function (e) {
+        if (suppressClick) { e.preventDefault(); e.stopPropagation(); }
+      }, true);
+      track.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+      updateControls();
+
+      /* ---------- Detail dialog that expands from its trigger ---------- */
+      var dialog = document.getElementById('drink-dialog');
+      var inner = dialog.querySelector('.dialog-inner');
+      var closeBtn = dialog.querySelector('.dialog-close');
+      var trigger = null;
+      var animating = false;
+      var DURATION = 420;
+      var EASE = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
+
+      function fill(card, btn) {
+        var id = btn.dataset.drink;
+        var d = DRINKS[id] || {};
+        var img = card.querySelector('img');
+        document.getElementById('dialog-img').src = img.src;
+        document.getElementById('dialog-title').textContent = card.querySelector('h3').textContent;
+        document.getElementById('dialog-price').textContent = d.price || '';
+        document.getElementById('dialog-desc').textContent = d.long || card.querySelector('p').textContent;
+        document.getElementById('dialog-roast').textContent = d.roast || '—';
+        document.getElementById('dialog-notes').textContent = d.notes || '—';
+        document.getElementById('dialog-sizes').textContent = d.sizes || '—';
+        document.getElementById('dialog-more').href = btn.dataset.href || '/menu';
+        document.getElementById('dialog-order').href = '/order-online?drink=' + encodeURIComponent(id);
+      }
+
+      // Transform that maps the dialog's box onto the trigger button's box.
+      function fromTriggerTransform() {
+        var b = trigger.getBoundingClientRect();
+        var d = dialog.getBoundingClientRect();
+        var sx = b.width / d.width;
+        var sy = b.height / d.height;
+        var tx = b.left - d.left;
+        var ty = b.top - d.top;
+        return 'translate(' + tx + 'px,' + ty + 'px) scale(' + sx + ',' + sy + ')';
+      }
+
+      function animateBackdrop(from, to) {
+        try {
+          return dialog.animate({ opacity: [from, to] }, { duration: DURATION, easing: 'ease', pseudoElement: '::backdrop', fill: 'forwards' });
+        } catch (err) { return null; }
+      }
+
+      function openDetails(btn) {
+        if (animating || dialog.open) return;
+        trigger = btn;
+        fill(btn.closest('.card'), btn);
+        dialog.showModal();
+        inner.scrollTop = 0;
+        closeBtn.focus();
+
+        if (reduceMotion.matches || !dialog.animate) return;
+
+        animating = true;
+        var radius = getComputedStyle(trigger).borderRadius;
+        var morph = dialog.animate([
+          { transformOrigin: 'top left', transform: fromTriggerTransform(), backgroundColor: getComputedStyle(trigger).backgroundColor, borderRadius: radius, boxShadow: 'none' },
+          { transformOrigin: 'top left', transform: 'none', backgroundColor: '#fff', borderRadius: '14px' }
+        ], { duration: DURATION, easing: EASE });
+        // Hide content while the box is stretched so text never looks distorted.
+        inner.animate([
+          { opacity: 0 }, { opacity: 0, offset: 0.45 }, { opacity: 1 }
+        ], { duration: DURATION, easing: 'ease-out' });
+        var bd = animateBackdrop(0, 1);
+        morph.onfinish = morph.oncancel = function () {
+          animating = false;
+          if (bd) bd.cancel();
+        };
+      }
+
+      function closeDetails() {
+        if (animating || !dialog.open) return;
+        var returnTo = trigger;
+
+        function finish() {
+          dialog.close();
+          animating = false;
+          if (returnTo && document.contains(returnTo)) returnTo.focus();
+        }
+
+        if (reduceMotion.matches || !dialog.animate || !returnTo) { finish(); return; }
+
+        animating = true;
+        var radius = getComputedStyle(returnTo).borderRadius;
+        inner.animate([{ opacity: 1 }, { opacity: 0, offset: 0.4 }, { opacity: 0 }],
+          { duration: DURATION * 0.8, easing: 'ease-in', fill: 'forwards' });
+        var morph = dialog.animate([
+          { transformOrigin: 'top left', transform: 'none', backgroundColor: '#fff', borderRadius: '14px' },
+          { transformOrigin: 'top left', transform: fromTriggerTransform(), backgroundColor: getComputedStyle(returnTo).backgroundColor, borderRadius: radius, boxShadow: 'none' }
+        ], { duration: DURATION * 0.8, easing: EASE, fill: 'forwards' });
+        animateBackdrop(1, 0);
+        morph.onfinish = function () {
+          finish();
+          dialog.getAnimations({ subtree: true }).forEach(function (a) { a.cancel(); });
+        };
+      }
+
+      track.addEventListener('click', function (e) {
+        var btn = e.target.closest('.view-details');
+        if (btn) openDetails(btn);
+      });
+
+      closeBtn.addEventListener('click', closeDetails);
+
+      // Esc: run the animated close instead of the instant native one.
+      dialog.addEventListener('cancel', function (e) {
+        e.preventDefault();
+        closeDetails();
+      });
+
+      // Safety net if the dialog is closed by any other path (e.g. browser-forced Esc).
+      dialog.addEventListener('close', function () {
+        animating = false;
+        dialog.getAnimations({ subtree: true }).forEach(function (a) { a.cancel(); });
+        if (trigger && document.activeElement !== trigger && document.contains(trigger)) trigger.focus();
+      });
+
+      // Click on the backdrop closes.
+      dialog.addEventListener('click', function (e) {
+        if (e.target !== dialog) return;
+        var r = dialog.getBoundingClientRect();
+        var inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
+        if (!inside) closeDetails();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
