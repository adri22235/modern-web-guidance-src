+  <script>
+    (function () {
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var navToken = 0;
+      var arrivedTimer = null;
+
+      /**
+       * Resolve once the window has stopped scrolling. Uses the native
+       * `scrollend` event when available, with a rAF stability check as a
+       * fallback (and to handle the case where no scroll happens at all,
+       * e.g. the target is already in place). A hard timeout guarantees
+       * resolution.
+       */
+      function waitForScrollEnd(maxWait) {
+        return new Promise(function (resolve) {
+          var done = false;
+          var lastX = window.scrollX;
+          var lastY = window.scrollY;
+          var stableFrames = 0;
+          var start = performance.now();
+
+          function finish() {
+            if (done) return;
+            done = true;
+            window.removeEventListener('scrollend', finish);
+            resolve();
+          }
+
+          if ('onscrollend' in window) {
+            window.addEventListener('scrollend', finish, { once: true });
+          }
+
+          function check(now) {
+            if (done) return;
+            if (window.scrollX === lastX && window.scrollY === lastY) {
+              stableFrames++;
+            } else {
+              stableFrames = 0;
+              lastX = window.scrollX;
+              lastY = window.scrollY;
+            }
+            // ~6 stable frames (~100ms) means scrolling has settled
+            if (stableFrames >= 6 || now - start > maxWait) {
+              finish();
+            } else {
+              requestAnimationFrame(check);
+            }
+          }
+          requestAnimationFrame(check);
+        });
+      }
+
+      function setCurrentLink(id) {
+        document.querySelectorAll('a[data-scroll-link]').forEach(function (a) {
+          if (a.getAttribute('href') === '#' + id) {
+            a.setAttribute('aria-current', 'true');
+          } else {
+            a.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function onArrive(target) {
+        // Move focus for keyboard/screen-reader users without re-scrolling
+        target.focus({ preventScroll: true });
+
+        // Restart the arrival animation even if it was already applied
+        document.querySelectorAll('.scroll-target.is-arrived').forEach(function (el) {
+          el.classList.remove('is-arrived');
+        });
+        void target.offsetWidth; // force reflow
+        target.classList.add('is-arrived');
+
+        clearTimeout(arrivedTimer);
+        arrivedTimer = setTimeout(function () {
+          target.classList.remove('is-arrived');
+        }, 2000);
+      }
+
+      function navigateTo(target, updateHistory) {
+        var token = ++navToken;
+        var id = target.id;
+
+        setCurrentLink(id);
+        if (updateHistory && location.hash !== '#' + id) {
+          history.pushState(null, '', '#' + id);
+        }
+
+        target.scrollIntoView({
+          behavior: reduceMotion.matches ? 'auto' : 'smooth',
+          block: 'start'
+        });
+
+        waitForScrollEnd(2000).then(function () {
+          // Ignore if a newer navigation started in the meantime
+          if (token !== navToken) return;
+          onArrive(target);
+        });
+      }
+
+      document.addEventListener('click', function (e) {
+        var link = e.target.closest('a[data-scroll-link]');
+        if (!link) return;
+        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+
+        var hash = link.getAttribute('href');
+        var target = hash && hash.charAt(0) === '#' && document.getElementById(hash.slice(1));
+        if (!target) return;
+
+        e.preventDefault();
+        navigateTo(target, true);
+      });
+
+      // Back/forward between hashes
+      window.addEventListener('popstate', function () {
+        var target = location.hash && document.getElementById(location.hash.slice(1));
+        if (target && target.classList.contains('scroll-target')) {
+          navigateTo(target, false);
+        }
+      });
+
+      // Deep link on initial load
+      window.addEventListener('load', function () {
+        var target = location.hash && document.getElementById(location.hash.slice(1));
+        if (target && target.classList.contains('scroll-target')) {
+          navigateTo(target, false);
+        }
+      });
+    })();
+  </script>
