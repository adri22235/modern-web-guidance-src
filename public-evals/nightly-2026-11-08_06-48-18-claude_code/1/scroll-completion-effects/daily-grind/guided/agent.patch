+  <script>
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const navLinks = [...document.querySelectorAll('nav a[href^="#"]')];
+    let currentScrollId = 0;
+
+    // Scroll an element into view and resolve once the scroll has finished.
+    // Uses the native scroll-method Promise where supported, otherwise falls
+    // back to `scrollend` with an idle timeout (covers already-in-view targets
+    // and browsers without `scrollend`).
+    function scrollIntoViewAsync(element, options, scroller = window) {
+      const result = element.scrollIntoView(options);
+      if (result instanceof Promise) return result;
+
+      return new Promise((resolve) => {
+        let timeoutId;
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    async function navigateTo(target) {
+      const scrollId = ++currentScrollId;
+      document.querySelectorAll('.is-arrived').forEach((el) => el.classList.remove('is-arrived'));
+      navLinks.forEach((link) => {
+        if (link.hash === `#${target.id}`) link.setAttribute('aria-current', 'true');
+        else link.removeAttribute('aria-current');
+      });
+
+      await scrollIntoViewAsync(target, {
+        behavior: reducedMotion.matches ? 'instant' : 'smooth',
+        block: 'start',
+      });
+
+      // A newer navigation superseded this one; skip its effects.
+      if (scrollId !== currentScrollId) return;
+
+      // Move focus without triggering a second scroll.
+      const heading = target.querySelector('h2[tabindex="-1"]') ?? target;
+      heading.focus({ preventScroll: true });
+
+      // Restart the arrival animation even if it ran on this element before.
+      void target.offsetWidth;
+      target.classList.add('is-arrived');
+    }
+
+    document.querySelectorAll('section[id]').forEach((section) => {
+      section.addEventListener('animationend', (event) => {
+        if (event.target === section) section.classList.remove('is-arrived');
+      });
+    });
+
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
+      if (!target) return;
+
+      event.preventDefault();
+      if (location.hash !== link.hash) history.pushState(null, '', link.hash);
+      navigateTo(target);
+    });
+
+    // Support back/forward between in-page sections.
+    window.addEventListener('popstate', () => {
+      const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
+      if (target) navigateTo(target);
+    });
+  </script>
+
