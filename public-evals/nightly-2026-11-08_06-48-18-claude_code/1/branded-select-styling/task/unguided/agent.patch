+  <script>
+    (function () {
+      const dropdown = document.getElementById('roast-dropdown');
+      const trigger = document.getElementById('roast-trigger');
+      const list = document.getElementById('roast-options');
+      const current = document.getElementById('roast-current');
+      const input = document.getElementById('roast-value');
+      const options = Array.from(list.querySelectorAll('[role="option"]'));
+      let activeIndex = options.findIndex(o => o.getAttribute('aria-selected') === 'true');
+
+      function setActive(i) {
+        options.forEach(o => o.classList.remove('active'));
+        activeIndex = (i + options.length) % options.length;
+        const opt = options[activeIndex];
+        opt.classList.add('active');
+        list.setAttribute('aria-activedescendant', opt.id);
+      }
+
+      function open() {
+        list.hidden = false;
+        dropdown.classList.add('open');
+        trigger.setAttribute('aria-expanded', 'true');
+        setActive(options.findIndex(o => o.getAttribute('aria-selected') === 'true'));
+        list.focus();
+      }
+
+      function close(returnFocus) {
+        list.hidden = true;
+        dropdown.classList.remove('open');
+        trigger.setAttribute('aria-expanded', 'false');
+        options.forEach(o => o.classList.remove('active'));
+        if (returnFocus) trigger.focus();
+      }
+
+      function select(i) {
+        options.forEach((o, idx) => o.setAttribute('aria-selected', idx === i ? 'true' : 'false'));
+        current.textContent = options[i].textContent.trim();
+        input.value = options[i].dataset.value;
+        dropdown.dispatchEvent(new CustomEvent('roastchange', { detail: input.value, bubbles: true }));
+        close(true);
+      }
+
+      trigger.addEventListener('click', () => (list.hidden ? open() : close(true)));
+
+      trigger.addEventListener('keydown', e => {
+        if (['ArrowDown', 'ArrowUp'].includes(e.key)) {
+          e.preventDefault();
+          open();
+        }
+      });
+
+      list.addEventListener('keydown', e => {
+        switch (e.key) {
+          case 'ArrowDown': e.preventDefault(); setActive(activeIndex + 1); break;
+          case 'ArrowUp': e.preventDefault(); setActive(activeIndex - 1); break;
+          case 'Home': e.preventDefault(); setActive(0); break;
+          case 'End': e.preventDefault(); setActive(options.length - 1); break;
+          case 'Enter':
+          case ' ': e.preventDefault(); select(activeIndex); break;
+          case 'Escape': e.preventDefault(); close(true); break;
+          case 'Tab': close(false); break;
+        }
+      });
+
+      options.forEach((opt, i) => {
+        opt.addEventListener('mousemove', () => { if (activeIndex !== i) setActive(i); });
+        opt.addEventListener('click', () => select(i));
+      });
+
+      document.addEventListener('click', e => {
+        if (!dropdown.contains(e.target) && !list.hidden) close(false);
+      });
+    })();
+  </script>
+
