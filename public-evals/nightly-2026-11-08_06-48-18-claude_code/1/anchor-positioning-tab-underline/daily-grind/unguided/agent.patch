+  <script>
+    (function () {
+      const list = document.querySelector('nav ul');
+      const indicator = list.querySelector('.nav-indicator');
+      const items = Array.from(list.querySelectorAll('a[data-nav-item]'));
+      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      // Matches the transform/width transition duration in CSS.
+      const TRANSITION_MS = 350;
+      let active = null;
+      let pendingNav = null;
+
+      function moveIndicator(link, animate) {
+        if (!link) {
+          indicator.classList.remove('visible');
+          return;
+        }
+        const listRect = list.getBoundingClientRect();
+        const linkRect = link.getBoundingClientRect();
+        // When the indicator first appears, place it without sliding in from x=0.
+        const instant = !animate || !indicator.classList.contains('visible');
+
+        indicator.classList.toggle('no-transition', instant);
+        indicator.style.width = linkRect.width + 'px';
+        indicator.style.top = (linkRect.bottom - listRect.top + 4) + 'px';
+        indicator.style.transform = 'translateX(' + (linkRect.left - listRect.left) + 'px)';
+
+        if (instant) {
+          void indicator.offsetWidth; // flush styles before re-enabling transitions
+          indicator.classList.remove('no-transition');
+        }
+        indicator.classList.add('visible');
+      }
+
+      function setActive(link, animate) {
+        if (active) {
+          active.classList.remove('active');
+          active.removeAttribute('aria-current');
+        }
+        active = link;
+        if (link) {
+          link.classList.add('active');
+          link.setAttribute('aria-current', 'page');
+        }
+        moveIndicator(link, animate);
+      }
+
+      // Initial state: highlight the item matching the current URL, if any.
+      const path = window.location.pathname.replace(/\/+$/, '');
+      const current = items.find(function (a) {
+        const p = new URL(a.href).pathname;
+        return path === p || path.startsWith(p + '/');
+      });
+      setActive(current || null, false);
+
+      items.forEach(function (link) {
+        link.addEventListener('click', function (e) {
+          // Let modified clicks (new tab/window) behave normally.
+          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
+            return;
+          }
+          if (link === active) return;
+          e.preventDefault();
+          setActive(link, true);
+          // Navigate once the slide finishes so the transition is visible.
+          clearTimeout(pendingNav);
+          pendingNav = setTimeout(function () {
+            window.location.href = link.href;
+          }, reduceMotion.matches ? 0 : TRANSITION_MS);
+        });
+      });
+
+      // Keep the indicator aligned when layout changes.
+      window.addEventListener('resize', function () {
+        moveIndicator(active, false);
+      });
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(function () { moveIndicator(active, false); });
+      }
+    })();
+  </script>
+
