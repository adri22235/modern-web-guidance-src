+  <script>
+    (() => {
+      const list = document.querySelector('nav ul');
+      // Only the main sections get the indicator (Logout is excluded)
+      const items = [...list.querySelectorAll('li')].filter(li => !li.querySelector('.logout-link'));
+      const supportsAnchor = CSS.supports('position-anchor: auto');
+
+      if (!supportsAnchor) list.classList.add('js-indicator');
+
+      function positionFallback() {
+        if (supportsAnchor) return;
+        const active = list.querySelector('li.active');
+        if (!active) return;
+        list.style.setProperty('--indicator-left', `${active.offsetLeft}px`);
+        list.style.setProperty('--indicator-width', `${active.offsetWidth}px`);
+        list.style.setProperty('--indicator-top', `${active.offsetTop + active.offsetHeight + 2}px`);
+      }
+
+      function setActive(li) {
+        items.forEach(item => {
+          const isActive = item === li;
+          item.classList.toggle('active', isActive);
+          const link = item.querySelector('a');
+          if (isActive) link.setAttribute('aria-current', 'page');
+          else link.removeAttribute('aria-current');
+        });
+        positionFallback();
+      }
+
+      // Initial state: match the current URL, defaulting to the first item
+      const current = items.find(li => location.pathname.startsWith(li.querySelector('a').getAttribute('href')));
+      setActive(current || items[0]);
+
+      items.forEach(li => {
+        li.querySelector('a').addEventListener('click', event => {
+          // Keep the page in place so the underline can transition between items
+          event.preventDefault();
+          setActive(li);
+        });
+      });
+
+      if (!supportsAnchor) {
+        new ResizeObserver(positionFallback).observe(list);
+        document.fonts?.ready.then(positionFallback);
+      }
+    })();
+  </script>
+
 </body>
 
