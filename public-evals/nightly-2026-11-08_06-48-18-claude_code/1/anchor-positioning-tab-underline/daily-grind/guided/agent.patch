     nav ul {
       display: flex;
+      align-items: center;
       list-style: none;
+      position: relative;
+    }
+
+    /* Active nav indicator: a single underline that glides between items */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav;
+      /* Physical insets driven by anchor(); position-area can't be transitioned */
+      top: calc(anchor(bottom) + 2px);
+      left: anchor(left);
+      right: anchor(right);
+      /* Border (not background) so it survives forced-colors mode */
+      border-bottom: 2px solid var(--accent);
+      pointer-events: none;
+    }
+
+    /* Hide the indicator when no item is active */
+    nav ul:not(:has(li.active))::before {
+      display: none;
+    }
+
+    nav ul li.active {
+      anchor-name: --active-nav;
+    }
+
+    nav ul li.active > a {
+      color: var(--accent);
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: top 0.3s ease, left 0.3s ease, right 0.3s ease;
+      }
+    }
+
+    @supports not (position-anchor: auto) {
+      /* JS-measured fallback so the underline still animates */
+      nav ul.js-indicator::before {
+        top: var(--indicator-top, 100%);
+        left: var(--indicator-left, 0);
+        right: auto;
+        width: var(--indicator-width, 0);
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        nav ul.js-indicator::before {
+          transition: top 0.3s ease, left 0.3s ease, width 0.3s ease;
+        }
+      }
+
+      /* No-JS fallback: static underline on the active item */
+      nav ul:not(.js-indicator)::before {
+        display: none;
+      }
+
+      nav ul:not(.js-indicator) li.active > a {
+        border-bottom: 2px solid var(--accent);
+      }
     }
 
     nav ul li {
