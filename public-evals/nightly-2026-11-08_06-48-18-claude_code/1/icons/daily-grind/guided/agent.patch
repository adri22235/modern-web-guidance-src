+      --icon-start: inherit;
+      content: image-set(linear-gradient(transparent 0 100%), var(--icon-start)) / var(--icon-style-alt, "");
+      mask: var(--icon-start) no-repeat center / contain;
+    }
+
+    :where(.icon:empty)::before {
+      --icon-start: var(--icon);
+    }
+
+    :where(.icon-end)::after {
+      --icon-end: inherit;
+      content: image-set(linear-gradient(transparent 0 100%), var(--icon-end)) / var(--icon-style-alt, "");
+      mask: var(--icon-end) no-repeat center / contain;
+    }
+
+    :where(.icon-start, .icon:empty)::before,
