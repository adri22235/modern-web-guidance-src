+      width: var(--icon-style-size, 1em);
+      height: var(--icon-style-size, 1em);
+      background-color: var(--icon-style-color, currentColor);
+      vertical-align: calc(0.5cap - var(--icon-style-size, 1em) / 2 + var(--icon-style-voffset, -0.02em));
