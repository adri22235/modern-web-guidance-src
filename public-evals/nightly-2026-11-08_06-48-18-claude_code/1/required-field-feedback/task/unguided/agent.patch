+  <script>
+    (function () {
+      var form = document.getElementById('newsletter-form');
+      var input = document.getElementById('newsletter-email');
+      var error = document.getElementById('newsletter-email-error');
+      // Only start showing errors once the user has interacted with the field
+      // (focused and left it) or tried to submit.
+      var touched = false;
+
+      function validate() {
+        var message = '';
+        if (input.validity.valueMissing) {
+          message = 'Please enter your email address.';
+        } else if (input.validity.typeMismatch) {
+          message = 'Please enter a valid email address.';
+        }
+        if (touched && message) {
+          error.textContent = message;
+          error.hidden = false;
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          error.textContent = '';
+          error.hidden = true;
+          input.removeAttribute('aria-invalid');
+        }
+        return !message;
+      }
+
+      input.addEventListener('blur', function () {
+        touched = true;
+        validate();
+      });
+
+      // Once an error is visible, clear it live as they fix the value.
+      input.addEventListener('input', function () {
+        if (touched) validate();
+      });
+
+      form.addEventListener('submit', function (e) {
+        touched = true;
+        if (!validate()) {
+          e.preventDefault();
+          input.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
