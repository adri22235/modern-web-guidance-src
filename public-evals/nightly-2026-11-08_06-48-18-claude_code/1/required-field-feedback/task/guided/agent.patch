+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state so screen
+    // readers only hear about the error once sighted users can see it.
+    (() => {
+      const form = document.getElementById('newsletter-form');
+
+      const sync = (input) => {
+        if (input.matches(':user-invalid')) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+
+      const handle = (event) => {
+        if (event.target.matches?.('input')) sync(event.target);
+      };
+
+      form.addEventListener('blur', handle, true);
+      form.addEventListener('invalid', handle, true);
+      form.addEventListener('input', (event) => {
+        if (event.target.getAttribute('aria-invalid') === 'true') sync(event.target);
+      });
+    })();
+  </script>
+
