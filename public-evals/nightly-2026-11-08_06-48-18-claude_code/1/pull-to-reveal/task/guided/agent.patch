+  <div class="scroll-start" aria-hidden="true"></div>
+
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
@@ -206,7 +284,16 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers without `scroll-initial-target` (Firefox, Safari):
+    // start the page scrolled to the nav so the search bar is out of view.
+    // Skip it when a URL fragment or restored scroll position should win.
+    if (!CSS.supports('scroll-initial-target', 'nearest') && !location.hash && window.scrollY === 0) {
+      document.querySelector('.scroll-start').scrollIntoView({ behavior: 'instant', block: 'start' });
+    }
+  </script>
