diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,67 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    html {
+      /* Proximity (not mandatory) so the long page still scrolls freely;
+         snapping only kicks in near the top, where the search bar lives. */
+      scroll-snap-type: y proximity;
+    }
+
+    /* Pull-to-reveal search bar (sits above the nav, hidden on load) */
+    .search-bar {
+      background: var(--secondary);
+      padding: 0.75rem 5%;
+      scroll-snap-align: start;
+    }
+
+    .search-bar form {
+      display: flex;
+      gap: 0.5rem;
+      max-width: 700px;
+      margin: 0 auto;
+    }
+
+    .search-bar input[type="search"] {
+      flex: 1;
+      min-width: 0;
+      padding: 0.6rem 0.9rem;
+      font: inherit;
+      color: var(--text);
+      background: white;
+      border: 1px solid #bcaaa4;
+      border-radius: 6px;
+    }
+
+    .search-bar input[type="search"]:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 1px;
+    }
+
+    .search-bar button {
+      padding: 0.6rem 1.1rem;
+      font: inherit;
+      color: white;
+      background: var(--primary);
+      border: none;
+      border-radius: 6px;
+      cursor: pointer;
+    }
+
+    .search-bar button:hover {
+      background: #3e2723;
+    }
+
+    /* Zero-height marker at the top of the nav: the initial scroll target and
+       the "hidden" snap point. Kept separate from the sticky nav because a
+       stuck element's snap position moves with scrolling. */
+    .scroll-start {
+      height: 0;
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -134,8 +193,17 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
@@ -156,8 +224,18 @@
 </head>
 
 <body>
 
