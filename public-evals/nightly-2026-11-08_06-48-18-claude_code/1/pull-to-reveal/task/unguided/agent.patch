+  <script>
+    (function () {
+      var bar = document.getElementById('search-bar');
+      var input = document.getElementById('site-search');
+      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      function barHeight() { return bar.offsetHeight; }
+
+      function scrollToY(y, smooth) {
+        window.scrollTo({ top: y, behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
+      }
+
+      // Start with the search bar tucked above the viewport (initial position = nav),
+      // unless the URL targets a specific anchor.
+      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+      if (!location.hash) scrollToY(barHeight(), false);
+
+      // Snap: when scrolling stops with the bar partially visible, either reveal it
+      // fully (if the user was heading up) or tuck it away again (if heading down).
+      var touching = false;
+      var lastY = window.scrollY;
+      var direction = 0; // -1 = up, 1 = down
+      var snapping = false;
+      var timer = null;
+
+      function snap() {
+        var h = barHeight();
+        var y = window.scrollY;
+        if (touching || y <= 0 || y >= h) return;
+        snapping = true;
+        scrollToY(direction < 0 ? 0 : h, true);
+      }
+
+      window.addEventListener('scroll', function () {
+        var y = window.scrollY;
+        if (!snapping && y !== lastY) direction = y < lastY ? -1 : 1;
+        lastY = y;
+        clearTimeout(timer);
+        // Fallback for browsers without the scrollend event.
+        timer = setTimeout(onScrollEnd, 150);
+      }, { passive: true });
+
+      function onScrollEnd() {
+        clearTimeout(timer);
+        if (snapping) { snapping = false; return; }
+        snap();
+      }
+
+      if ('onscrollend' in window) {
+        window.addEventListener('scrollend', onScrollEnd);
+      }
+
+      // Don't snap away while the user is still touching the screen mid-pull.
+      window.addEventListener('touchstart', function () { touching = true; }, { passive: true });
+      window.addEventListener('touchend', function () {
+        touching = false;
+        onScrollEnd();
+      }, { passive: true });
+
+      // Keyboard shortcut: "/" reveals and focuses the search bar.
+      document.addEventListener('keydown', function (e) {
+        if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
+        var t = e.target;
+        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
+        e.preventDefault();
+        snapping = true;
+        scrollToY(0, true);
+        input.focus({ preventScroll: true });
+      });
+
+      // Keyboard users tabbing into the field should see it fully.
+      input.addEventListener('focus', function () {
+        if (window.scrollY > 0) { snapping = true; scrollToY(0, true); }
+      });
+    })();
+  </script>
+
 </body>
 
