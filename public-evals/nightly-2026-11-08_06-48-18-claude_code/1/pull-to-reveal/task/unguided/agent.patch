+    /* Pull-to-reveal search bar */
+    html {
+      overflow-anchor: none;
+    }
+
+    body {
+      /* Guarantee enough scroll room to tuck the search bar out of view */
+      min-height: calc(100vh + var(--search-height));
+    }
