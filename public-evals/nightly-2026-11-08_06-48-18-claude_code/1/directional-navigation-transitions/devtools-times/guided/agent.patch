diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..3974dd1
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,174 @@
+---
+import type { CollectionEntry } from 'astro:content';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+<top-stories-slider class="block bg-white border-b border-gray-300">
+    <section
+        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center gap-4"
+        aria-roledescription="carousel"
+        aria-label="Top stories"
+    >
+        <button
+            type="button"
+            data-direction="previous"
+            aria-controls="top-stories-viewport"
+            class="shrink-0 rounded-full border border-gray-300 p-2 text-gray-700 hover:border-amber-400 hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 transition-colors cursor-pointer"
+        >
+            <ChevronLeftIcon className="w-5 h-5" aria-hidden="true" />
+            <span class="sr-only">Previous story</span>
+        </button>
+
+        <div
+            id="top-stories-viewport"
+            class="top-stories-viewport relative flex-1 min-w-0 overflow-hidden"
+            aria-live="polite"
+        >
+            {articles.map((article, index) => (
+                <div
+                    class="top-stories-slide"
+                    role="group"
+                    aria-roledescription="slide"
+                    aria-label={`${index + 1} of ${articles.length}`}
+                    hidden={index !== 0}
+                >
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                    </a>
+                    <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                </div>
+            ))}
+        </div>
+
+        <button
+            type="button"
+            data-direction="next"
+            aria-controls="top-stories-viewport"
+            class="shrink-0 rounded-full border border-gray-300 p-2 text-gray-700 hover:border-amber-400 hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-400 transition-colors cursor-pointer"
+        >
+            <ChevronRightIcon className="w-5 h-5" aria-hidden="true" />
+            <span class="sr-only">Next story</span>
+        </button>
+    </section>
+</top-stories-slider>
+
+<script>
+    // Element-scoped view transitions are currently limited availability; other
+    // browsers simply swap the story without animation.
+    const supportsScopedTransition =
+        typeof Element !== 'undefined' && 'startViewTransition' in Element.prototype;
+
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    class TopStoriesSlider extends HTMLElement {
+        #index = 0;
+        #viewport: HTMLElement | null = null;
+        #slides: HTMLElement[] = [];
+
+        connectedCallback() {
+            this.#viewport = this.querySelector('.top-stories-viewport');
+            this.#slides = Array.from(this.querySelectorAll<HTMLElement>('.top-stories-slide'));
+            this.#index = Math.max(0, this.#slides.findIndex((slide) => !slide.hidden));
+            this.addEventListener('click', this.#onClick);
+        }
+
+        disconnectedCallback() {
+            this.removeEventListener('click', this.#onClick);
+        }
+
+        #onClick = (event: Event) => {
+            const button = (event.target as Element).closest<HTMLButtonElement>('button[data-direction]');
+            if (!button || !this.contains(button)) return;
+            this.#go(button.dataset.direction === 'previous' ? 'previous' : 'next');
+        };
+
+        #go(direction: 'next' | 'previous') {
+            const count = this.#slides.length;
+            if (count < 2 || !this.#viewport) return;
+
+            const step = direction === 'next' ? 1 : -1;
+            const nextIndex = (this.#index + step + count) % count;
+
+            const update = () => {
+                this.#slides[this.#index].hidden = true;
+                this.#slides[nextIndex].hidden = false;
+                this.#index = nextIndex;
+            };
+
+            if (!supportsScopedTransition || reducedMotion.matches) {
+                update();
+                return;
+            }
+
+            // Scope the transition to the viewport so the rest of the page stays
+            // interactive and the viewport's overflow clips the sliding content.
+            const transition = (this.#viewport as any).startViewTransition({
+                update,
+                types: [direction],
+            });
+            // Rapid clicks skip the running transition and reject `ready`.
+            transition.ready.catch(() => {});
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
+
+<style is:global>
+    .top-stories-viewport {
+        /* Keep the slide name from leaking into page-level (ClientRouter) transitions. */
+        view-transition-scope: all;
+    }
+
+    .top-stories-slide {
+        view-transition-name: top-story-slide;
+    }
+
+    ::view-transition-group(top-story-slide) {
+        animation-duration: 0.4s;
+        animation-timing-function: ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+        .top-stories-viewport:active-view-transition-type(next)::view-transition-old(top-story-slide) {
+            animation: 0.4s ease-in-out both top-story-slide-to-left;
+        }
+        .top-stories-viewport:active-view-transition-type(next)::view-transition-new(top-story-slide) {
+            animation: 0.4s ease-in-out both top-story-slide-from-right;
+        }
+        .top-stories-viewport:active-view-transition-type(previous)::view-transition-old(top-story-slide) {
+            animation: 0.4s ease-in-out both top-story-slide-to-right;
+        }
+        .top-stories-viewport:active-view-transition-type(previous)::view-transition-new(top-story-slide) {
+            animation: 0.4s ease-in-out both top-story-slide-from-left;
+        }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .top-stories-viewport::view-transition-group(*),
+        .top-stories-viewport::view-transition-old(*),
+        .top-stories-viewport::view-transition-new(*) {
+            animation: none !important;
+        }
+    }
+
+    @keyframes top-story-slide-to-left {
+        to { transform: translateX(-100%); }
+    }
+    @keyframes top-story-slide-from-right {
+        from { transform: translateX(100%); }
+    }
+    @keyframes top-story-slide-to-right {
+        to { transform: translateX(100%); }
+    }
+    @keyframes top-story-slide-from-left {
+        from { transform: translateX(-100%); }
+    }
+</style>
