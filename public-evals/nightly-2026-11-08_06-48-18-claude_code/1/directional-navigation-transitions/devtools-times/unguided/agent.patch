+import { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/solid';
+
+export interface TopStory {
+  id: string;
+  title: string;
+  href: string;
+  date: string;
+  dateTime: string;
+}
+
+interface Props {
+  stories: TopStory[];
+}
+
+type Direction = 'next' | 'prev' | null;
+
+export default function TopStoriesSlider({ stories }: Props) {
+  const [index, setIndex] = useState(0);
+  // null on first render so the initial story doesn't animate in.
+  const [direction, setDirection] = useState<Direction>(null);
+
+  if (stories.length === 0) return null;
+
+  const count = stories.length;
+  const story = stories[index];
+
+  const go = (dir: 'next' | 'prev') => {
+    setDirection(dir);
+    setIndex(i => (dir === 'next' ? (i + 1) % count : (i - 1 + count) % count));
+  };
+
+  const animationClass =
+    direction === 'next' ? 'top-story-slide-from-right' :
+    direction === 'prev' ? 'top-story-slide-from-left' : '';
+
+  const buttonClass =
+    'inline-flex items-center justify-center w-8 h-8 rounded-full border border-gray-300 text-gray-700 ' +
+    'hover:text-amber-400 hover:border-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 ' +
+    'focus-visible:outline-amber-400 disabled:opacity-40 disabled:pointer-events-none';
+
+  return (
+    <section
+      className="flex items-center gap-4"
+      aria-roledescription="carousel"
+      aria-label="Top stories"
+    >
+      <div className="relative flex-1 min-w-0 overflow-hidden">
+        <div
+          key={story.id}
+          className={animationClass}
+          role="group"
+          aria-roledescription="slide"
+          aria-label={`${index + 1} of ${count}`}
+          aria-live="polite"
+        >
+          <a href={story.href}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{story.title}</h3>
+          </a>
+          <time className="text-xs text-gray-500" dateTime={story.dateTime}>{story.date}</time>
+        </div>
+      </div>
+
+      <div className="flex items-center gap-2 shrink-0">
+        <button
+          type="button"
+          className={buttonClass}
+          onClick={() => go('prev')}
+          disabled={count < 2}
+          aria-label="Previous story"
+        >
+          <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+        </button>
+        <span className="text-xs text-gray-500 tabular-nums w-10 text-center" aria-hidden="true">
+          {index + 1} / {count}
+        </span>
+        <button
+          type="button"
+          className={buttonClass}
+          onClick={() => go('next')}
+          disabled={count < 2}
+          aria-label="Next story"
+        >
+          <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+        </button>
+      </div>
+    </section>
+  );
+}
