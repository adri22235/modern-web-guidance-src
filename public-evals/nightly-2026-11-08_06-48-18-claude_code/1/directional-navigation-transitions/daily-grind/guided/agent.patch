+  <script>
+    (() => {
+      const viewport = document.getElementById('seasonal-viewport');
+      const slides = Array.from(viewport.children);
+      const status = document.querySelector('.carousel-status');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      const supportsScoped = 'startViewTransition' in Element.prototype;
+      let current = 0;
+      let latest = null;
+
+      function show(index) {
+        current = (index + slides.length) % slides.length;
+        slides.forEach((slide, i) => { slide.hidden = i !== current; });
+        status.textContent = `${current + 1} of ${slides.length}`;
+      }
+
+      function go(direction) {
+        const target = current + (direction === 'next' ? 1 : -1);
+        const update = () => show(target);
+
+        if (reducedMotion.matches) {
+          update();
+        } else if (supportsScoped) {
+          const t = viewport.startViewTransition({ update, types: [direction] });
+          t.ready.catch(() => {});
+        } else if (document.startViewTransition) {
+          viewport.classList.add('vt-document');
+          const t = document.startViewTransition({ update, types: [direction] });
+          latest = t;
+          t.ready.catch(() => {});
+          t.finished.finally(() => {
+            if (latest === t) viewport.classList.remove('vt-document');
+          });
+        } else {
+          update();
+        }
+      }
+
+      document.querySelectorAll('.carousel-btn').forEach((btn) => {
+        btn.addEventListener('click', () => go(btn.dataset.dir));
+      });
+    })();
+  </script>
+
