+      animation: 0.4s ease-in-out both;
+    }
+
+    html:active-view-transition-type(next)::view-transition-old(seasonal-favorite) {
+      animation-name: slide-to-left;
+    }
+
+    html:active-view-transition-type(next)::view-transition-new(seasonal-favorite) {
+      animation-name: slide-from-right;
+    }
+
+    html:active-view-transition-type(previous)::view-transition-old(seasonal-favorite) {
+      animation-name: slide-to-right;
+    }
+
+    html:active-view-transition-type(previous)::view-transition-new(seasonal-favorite) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*),
+      .carousel-viewport::view-transition-group(*),
+      .carousel-viewport::view-transition-old(*),
+      .carousel-viewport::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
