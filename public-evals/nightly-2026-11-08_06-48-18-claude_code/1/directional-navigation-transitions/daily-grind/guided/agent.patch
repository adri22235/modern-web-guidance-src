+    /* Scoped transition (element.startViewTransition): the viewport is the scope
+       and participates as "root" inside its own transition. */
+    .carousel-viewport::view-transition-group(root) {
+      animation-duration: 0.4s;
+      animation-timing-function: ease-in-out;
+    }
+
+    .carousel-viewport::view-transition-old(root),
+    .carousel-viewport::view-transition-new(root) {
+      animation: 0.4s ease-in-out both;
+    }
+
+    .carousel-viewport:active-view-transition-type(next)::view-transition-old(root) {
+      animation-name: slide-to-left;
+    }
+
+    .carousel-viewport:active-view-transition-type(next)::view-transition-new(root) {
+      animation-name: slide-from-right;
+    }
+
+    .carousel-viewport:active-view-transition-type(previous)::view-transition-old(root) {
+      animation-name: slide-to-right;
+    }
+
+    .carousel-viewport:active-view-transition-type(previous)::view-transition-new(root) {
+      animation-name: slide-from-left;
+    }
+
+    /* Fallback: document-level transition for browsers without element-scoped
