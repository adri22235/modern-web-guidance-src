+  <script>
+    (function () {
+      const carousel = document.getElementById('seasonal-carousel');
+      const slides = Array.from(carousel.querySelectorAll('.card'));
+      const status = document.getElementById('seasonal-status');
+      let current = 0;
+
+      function show(index, direction) {
+        const next = (index + slides.length) % slides.length;
+        if (next === current) return;
+        slides[current].hidden = true;
+        const slide = slides[next];
+        slide.classList.remove('slide-from-right', 'slide-from-left');
+        slide.hidden = false;
+        void slide.offsetWidth; // restart animation on rapid clicks
+        slide.classList.add(direction === 'next' ? 'slide-from-right' : 'slide-from-left');
+        current = next;
+        status.textContent = (current + 1) + ' of ' + slides.length;
+      }
+
+      slides.forEach(function (slide) {
+        slide.addEventListener('animationend', function () {
+          slide.classList.remove('slide-from-right', 'slide-from-left');
+        });
+      });
+
+      document.getElementById('seasonal-next').addEventListener('click', function () {
+        show(current + 1, 'next');
+      });
+      document.getElementById('seasonal-prev').addEventListener('click', function () {
+        show(current - 1, 'prev');
+      });
+    })();
+  </script>
+
