+
+    /* Spotlight reveal on product cards */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      /* New stacking context so the overlay sits above the card background but below the content */
+      isolation: isolate;
+      overflow: hidden;
+      /* Only the sizes transition; the position variables update instantly */
+      transition: --inner-size 0.3s ease-out, --outer-size 0.3s ease-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 70px;
+      --outer-size: 110px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
+    .product-card .spotlight {
+      position: absolute;
+      inset: 0;
+      z-index: -1;
+      pointer-events: none;
+      background: var(--spotlight-image, none) center / cover no-repeat, var(--secondary);
+      opacity: 0.45;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+          black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+          black var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+    }
