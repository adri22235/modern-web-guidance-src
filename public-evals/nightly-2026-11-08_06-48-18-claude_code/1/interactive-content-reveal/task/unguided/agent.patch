     .btn:hover {
       background: #3e2723;
     }
 
+    /* Spotlight reveal on seasonal product cards */
+    @property --mouse-x {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --mouse-y {
+      syntax: '<length-percentage>';
+      inherits: true;
+      initial-value: 50%;
+    }
+
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      overflow: hidden;
+      padding-bottom: 56px;
+      /* Only the spotlight size animates; position updates instantly. */
+      transition: --inner-size 0.4s ease, --outer-size 0.4s ease;
+    }
+
+    .product-card:hover,
+    .product-card:focus-within {
+      --inner-size: 70px;
+      --outer-size: 130px;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 1;
+      pointer-events: none;
+      user-select: none;
+      display: flex;
+      align-items: flex-end;
+      justify-content: center;
+      padding: 14px 16px;
+      border-radius: inherit;
+      background: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          rgba(255, 171, 64, 0.22), rgba(255, 171, 64, 0.08) 70%);
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: 600;
+      letter-spacing: 0.3px;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
+
     footer {
