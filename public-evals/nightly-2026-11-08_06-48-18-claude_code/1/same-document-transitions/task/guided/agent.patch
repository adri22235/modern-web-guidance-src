+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        price: '$5.75',
+        size: '12 oz / 16 oz',
+        img: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1600&q=80',
+        alt: 'A latte with leaf-shaped latte art in a ceramic cup',
+        desc: 'Our autumn signature: a double shot of house espresso, steamed oat milk, and a drizzle of pure Vermont maple syrup, finished with a dusting of cinnamon. Cozy, nutty, and just sweet enough.'
+      },
+      'dark-roast-espresso': {
+        price: '$3.50',
+        size: 'Single / Double',
+        img: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1600&q=80',
+        alt: 'A shot of espresso with rich crema in a small cup',
+        desc: 'Roasted in small batches until the beans turn glossy and dark, this espresso delivers notes of cocoa, toasted walnut, and a lingering smokiness. Pulled to order with a thick hazelnut crema.'
+      },
+      'cold-brew': {
+        price: '$4.75',
+        size: '16 oz / 24 oz',
+        img: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1600&q=80',
+        alt: 'A glass of iced cold brew coffee',
+        desc: 'Coarse-ground beans steeped in cold filtered water for a full 18 hours, then slowly filtered for a naturally sweet, low-acid brew. Served over ice, black or with a splash of cream.'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const titleEl = document.getElementById('title');
+    const heroImg = document.getElementById('hero-img');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    history.scrollRestoration = 'manual';
+
+    let currentId = null;     // item currently shown in detail view (null = list view)
+    let listScrollY = 0;      // scroll position to restore when returning to the list
+    let activeTransition = null;
+    let navToken = 0;         // guards async cleanup against overlapping navigations
+
+    const thumbFor = (id) => document.querySelector(`.thumbnail[data-id="${CSS.escape(id)}"]`);
+    const idFromHash = () => {
+      const m = location.hash.match(/^#\/item\/([\w-]+)$/);
+      return m && ITEMS[m[1]] ? m[1] : null;
+    };
+
+    function clearTransitionState() {
+      document.querySelectorAll('.thumbnail.vt-active').forEach((el) => el.classList.remove('vt-active'));
+    }
+
+    function renderDetail(id) {
+      const item = ITEMS[id];
+      const thumb = thumbFor(id);
+      titleEl.textContent = thumb.querySelector('.title').textContent;
+      heroImg.src = item.img;
+      heroImg.alt = item.alt;
+      document.getElementById('detail-price').textContent = item.price;
+      document.getElementById('detail-size').textContent = item.size;
+      document.getElementById('detail-desc').textContent = item.desc;
+      document.title = `${titleEl.textContent} | The Daily Grind`;
+    }
+
+    function showView(id) {
+      if (id) {
+        renderDetail(id);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        window.scrollTo(0, 0);
+      } else {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        window.scrollTo(0, listScrollY);
+      }
+      currentId = id;
+    }
+
+    function navigate(nextId, { animate = true } = {}) {
+      if (nextId === currentId) return;
+
+      // Finish any in-flight transition immediately before starting a new one
+      activeTransition?.skipTransition();
+      clearTransitionState();
+
+      if (nextId && !currentId) listScrollY = window.scrollY;
+
+      const token = ++navToken;
+      const focusTarget = nextId ? titleEl : listHeading;
+      // The card that morphs: the one being opened, or the one we're returning to
+      const thumb = thumbFor(nextId ?? currentId);
+
+      if (!animate || !document.startViewTransition || reducedMotion.matches || !thumb) {
+        showView(nextId);
+        focusTarget.focus({ preventScroll: true });
+        return;
+      }
+
+      // Temporarily name the clicked card + its title so they pair with #hero / #title
+      thumb.classList.add('vt-active');
+
+      const transition = document.startViewTransition(() => showView(nextId));
+      activeTransition = transition;
+
+      transition.finished.finally(() => {
+        if (token !== navToken) return; // a newer navigation owns cleanup/focus
+        clearTransitionState();
+        activeTransition = null;
+        focusTarget.focus({ preventScroll: true });
+      });
+    }
+
+    // Thumbnails are real links (#/item/<id>), so history + browser back both route through here
+    window.addEventListener('popstate', () => navigate(idFromHash()));
+    window.addEventListener('hashchange', () => navigate(idFromHash()));
+
+    document.getElementById('back-btn').addEventListener('click', () => {
+      // If we arrived from the list, pop history; otherwise (deep link) push the list route
+      if (history.state?.fromList) history.back();
+      else location.hash = '';
+    });
+
+    document.querySelector('.grid').addEventListener('click', (e) => {
+      const thumb = e.target.closest('.thumbnail');
+      if (!thumb || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
+      e.preventDefault();
+      history.pushState({ fromList: true }, '', thumb.getAttribute('href'));
+      navigate(thumb.dataset.id);
+    });
+
+    // Initial route (deep link) — no animation
+    navigate(idFromHash(), { animate: false });
+  </script>
+
 </body>
 
