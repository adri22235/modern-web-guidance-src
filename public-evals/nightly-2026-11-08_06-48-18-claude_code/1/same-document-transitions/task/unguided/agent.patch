+  <script>
+    const DRINKS = [
+      {
+        slug: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        summary: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        tagline: 'Autumn in a cup.',
+        description: 'A double shot of our house espresso, velvety steamed oat milk and a drizzle of pure Vermont maple syrup, finished with a dusting of cinnamon. Cozy, nutty and just sweet enough.',
+        price: '$5.75',
+        notes: 'Maple, toasted oat, cinnamon',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1400&q=80',
+        alt: 'Latte with leaf-shaped latte art in a ceramic cup',
+      },
+      {
+        slug: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        summary: 'Bold, smokey, and perfect for a morning boost.',
+        tagline: 'Small cup, big personality.',
+        description: 'Our darkest roast, pulled short and syrupy. Expect deep cocoa and a smoky finish with a thick, hazelnut-colored crema. Best enjoyed standing at the bar.',
+        price: '$3.25',
+        notes: 'Dark chocolate, smoke, molasses',
+        image: 'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=1400&q=80',
+        alt: 'Espresso shot with rich crema in a small cup',
+      },
+      {
+        slug: 'cold-brew',
+        name: 'Cold Brew',
+        summary: 'Steeped for 18 hours for maximum smoothness.',
+        tagline: 'Slow-steeped, never bitter.',
+        description: 'Coarse-ground single-origin beans steeped cold for 18 hours, then filtered twice for a remarkably smooth, low-acid brew. Served over ice, black or with a splash of cream.',
+        price: '$4.50',
+        notes: 'Caramel, stone fruit, cocoa',
+        image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=1400&q=80',
+        alt: 'Iced coffee in a tall glass',
+      },
+    ];
+
+    const listPage = document.getElementById('list-page');
+    const listHeading = document.getElementById('list-heading');
+    const grid = document.getElementById('favorites-grid');
+    const detailPage = document.getElementById('detail-page');
+    const heroImg = document.getElementById('hero-img');
+    const detailTitle = document.getElementById('title');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // ---- Render list ----
+    grid.innerHTML = DRINKS.map((d) => `
+      <article class="card">
+        <a class="thumbnail" href="#/drinks/${d.slug}" data-slug="${d.slug}">
+          <img src="${d.image}" alt="${d.alt}" loading="lazy">
+          <h2 class="title">${d.name}</h2>
+        </a>
+        <p>${d.summary}</p>
+      </article>`).join('');
+
+    const thumbnailFor = (slug) => grid.querySelector(`.thumbnail[data-slug="${slug}"]`);
+
+    // ---- Routing ----
+    function parseRoute() {
+      const match = location.hash.match(/^#\/drinks\/([\w-]+)$/);
+      const drink = match && DRINKS.find((d) => d.slug === match[1]);
+      return drink ? { view: 'detail', drink } : { view: 'list' };
+    }
+
+    let currentView = 'list';
+    let currentSlug = null;
+    let listScrollY = 0;
+    let activeTransition = null;
+
+    function showDetail(drink) {
+      heroImg.src = drink.image;
+      heroImg.alt = drink.alt;
+      detailTitle.textContent = drink.name;
+      document.getElementById('detail-tagline').textContent = drink.tagline;
+      document.getElementById('detail-description').textContent = drink.description;
+      document.getElementById('detail-price').textContent = drink.price;
+      document.getElementById('detail-notes').textContent = drink.notes;
+      document.title = `${drink.name} | The Daily Grind`;
+
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      window.scrollTo(0, 0);
+    }
+
+    function showList() {
+      document.title = 'The Daily Grind | Artisanal Coffee';
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      window.scrollTo(0, listScrollY);
+    }
+
+    // Temporarily give a list thumbnail the shared names so it pairs with #hero / #title.
+    function tagThumbnail(thumb) {
+      if (!thumb) return;
+      thumb.style.viewTransitionName = 'hero';
+      thumb.querySelector('.title').style.viewTransitionName = 'title';
+    }
+
+    function untagThumbnail(thumb) {
+      if (!thumb) return;
+      thumb.style.removeProperty('view-transition-name');
+      thumb.querySelector('.title').style.removeProperty('view-transition-name');
+    }
+
+    // Wait for the hero image so the "new" snapshot isn't blank (bounded so we never hang).
+    function heroImageReady() {
+      if (heroImg.complete) return Promise.resolve();
+      return Promise.race([
+        heroImg.decode().catch(() => {}),
+        new Promise((r) => setTimeout(r, 400)),
+      ]);
+    }
+
+    function navigate(route, { animate = true } = {}) {
+      if (route.view === currentView && route.drink?.slug === currentSlug) return;
+
+      const goingToDetail = route.view === 'detail';
+      // Thumbnail involved in the morph: the clicked one going forward,
+      // the one we came from going back.
+      const thumb = thumbnailFor(goingToDetail ? route.drink.slug : currentSlug);
+
+      if (goingToDetail && currentView === 'list') listScrollY = window.scrollY;
+
+      const update = async () => {
+        if (goingToDetail) {
+          untagThumbnail(thumb); // list is hidden now; only #hero / #title carry the names
+          showDetail(route.drink);
+          await heroImageReady();
+        } else {
+          showList();
+          tagThumbnail(thumb);
+        }
+        currentView = route.view;
+        currentSlug = goingToDetail ? route.drink.slug : null;
+      };
+
+      const focusHeading = () => {
+        (goingToDetail ? detailTitle : listHeading).focus({ preventScroll: true });
+      };
+
+      // Finish any in-flight transition immediately before starting another.
+      activeTransition?.skipTransition();
+
+      const canAnimate = animate && document.startViewTransition && !reducedMotion.matches;
+      if (!canAnimate) {
+        update().then(() => {
+          untagThumbnail(thumb);
+          focusHeading();
+        });
+        return;
+      }
+
+      const root = document.documentElement;
+      const directionClass = goingToDetail ? 'vt-forward' : 'vt-back';
+
+      if (goingToDetail) tagThumbnail(thumb); // old snapshot comes from the thumbnail
+      root.classList.add('vt-active', directionClass);
+
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+
+      transition.updateCallbackDone.then(focusHeading, focusHeading);
+      transition.finished.finally(() => {
+        // Clean up temporary names and classes.
+        untagThumbnail(thumb);
+        root.classList.remove('vt-active', directionClass);
+        if (activeTransition === transition) activeTransition = null;
+      });
+    }
+
+    window.addEventListener('hashchange', () => navigate(parseRoute()));
+
+    // Initial render (deep link support) without animation and without stealing focus.
+    const initial = parseRoute();
+    if (initial.view === 'detail') {
+      showDetail(initial.drink);
+      currentView = 'detail';
+      currentSlug = initial.drink.slug;
+    }
+
+    // Back link: use history when we came from the list so browser history stays tidy.
+    document.getElementById('back-link').addEventListener('click', (e) => {
+      if (history.state?.fromList) {
+        e.preventDefault();
+        history.back();
+      }
+    });
+
+    grid.addEventListener('click', (e) => {
+      const thumb = e.target.closest('.thumbnail');
+      if (!thumb || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
+      e.preventDefault();
+      history.pushState({ fromList: true }, '', thumb.getAttribute('href'));
+      navigate(parseRoute());
+    });
+  </script>
+
 </body>
 
