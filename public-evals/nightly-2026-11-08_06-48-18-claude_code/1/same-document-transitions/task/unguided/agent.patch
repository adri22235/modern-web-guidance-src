+    /* ---------- View transitions ---------- */
+    #hero {
+      view-transition-name: hero;
+    }
+
+    #title {
+      view-transition-name: title;
+    }
+
+    ::view-transition-group(hero),
+    ::view-transition-group(title) {
+      animation-duration: 0.45s;
+      animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
+    }
+
+    /* Hero: thumbnail (4:3) and hero (21:9) differ in aspect ratio.
+       Cover-fit both snapshots inside the morphing box so the image is
+       cropped rather than stretched. */
+    ::view-transition-image-pair(hero) {
+      overflow: clip;
+    }
+
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+    }
+
+    /* Title: scale snapshots by height only, keeping their intrinsic
+       aspect ratio so the text grows/shrinks uniformly instead of
+       stretching to the group's interpolated width. */
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      width: auto;
+      height: 100%;
+    }
+
+    ::view-transition-old(root),
+    ::view-transition-new(root) {
+      animation-duration: 0.3s;
+    }
+
+    /* Temporary class present only while a transition runs */
+    .vt-active .thumbnail img {
+      transition: none;
+      transform: none;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*),
+      ::view-transition-image-pair(*) {
+        animation: none !important;
+      }
+
+      .thumbnail img {
+        transition: none;
+      }
+    }
