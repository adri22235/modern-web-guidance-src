+// Daily Grind web server: serves the homepage and the rewards sign-up API.
+//
+//   POST /api/email-verification/nonce   -> { nonce }  (starts a session cookie)
+//   POST /api/email-verification/verify  { presentationToken } -> { email }
+//   POST /api/rewards/register           { name, email, favoriteDrink?, marketingOptIn? }
+//
+// Configuration:
+//   PORT           (default 11222)
+//   PUBLIC_ORIGIN  exact origin the site is served from, e.g. https://dailygrind.example
+//                  (default http://localhost:$PORT). Used as the required token audience
+//                  and for Origin-header CSRF checks; never derived from request headers.
+
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import http from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { verifyPresentation, VerificationError } from './server/evp.js';
+
+const ROOT = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT) || 11222;
+const PUBLIC_ORIGIN = new URL(process.env.PUBLIC_ORIGIN || `http://localhost:${PORT}`).origin;
+const SECURE_COOKIE = PUBLIC_ORIGIN.startsWith('https://');
+const COOKIE_NAME = SECURE_COOKIE ? '__Host-dg_sid' : 'dg_sid';
+const ACCOUNTS_FILE = process.env.ACCOUNTS_FILE || path.join(ROOT, 'data', 'accounts.json');
+
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const NONCE_TTL_MS = 10 * 60 * 1000;
+const VERIFIED_TTL_MS = 15 * 60 * 1000;
+const MAX_BODY_BYTES = 32 * 1024;
+const MAX_SESSIONS = 50_000;
+
+// ---------- sessions (in-memory) ----------
+
+/** @type {Map<string, { expires: number, nonce?: { value: string, expires: number }, verified?: { email: string, issuer: string, expires: number }, verifyAttempts: number }>} */
+const sessions = new Map();
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, s] of sessions) if (s.expires < now) sessions.delete(id);
+}, 60_000).unref();
+
+function getSession(req) {
+  const cookie = req.headers.cookie || '';
+  const match = cookie.split(/;\s*/).find((c) => c.startsWith(`${COOKIE_NAME}=`));
+  const id = match?.slice(COOKIE_NAME.length + 1);
+  const s = id && sessions.get(id);
+  if (s && s.expires > Date.now()) return { id, s };
+  return null;
+}
+
+function createSession(res) {
+  if (sessions.size >= MAX_SESSIONS) {
+    const oldest = sessions.keys().next().value;
+    sessions.delete(oldest);
+  }
+  const id = crypto.randomBytes(32).toString('base64url');
+  const s = { expires: Date.now() + SESSION_TTL_MS, verifyAttempts: 0 };
+  sessions.set(id, s);
+  res.setHeader(
+    'Set-Cookie',
+    `${COOKIE_NAME}=${id}; Path=/; HttpOnly; SameSite=Strict; Max-Age=${SESSION_TTL_MS / 1000}${SECURE_COOKIE ? '; Secure' : ''}`,
+  );
+  return { id, s };
+}
+
+// ---------- accounts (JSON file) ----------
+
+let writeQueue = Promise.resolve();
+
+async function readAccounts() {
+  try {
+    return JSON.parse(await fs.readFile(ACCOUNTS_FILE, 'utf8'));
+  } catch (err) {
+    if (err.code === 'ENOENT') return [];
+    throw err;
+  }
+}
+
+function createAccount(account) {
+  // Serialize writes so concurrent sign-ups can't clobber each other.
+  const run = writeQueue.then(async () => {
+    const accounts = await readAccounts();
+    if (accounts.some((a) => a.email.toLowerCase() === account.email.toLowerCase())) return null;
+    accounts.push(account);
+    await fs.mkdir(path.dirname(ACCOUNTS_FILE), { recursive: true });
+    const tmp = `${ACCOUNTS_FILE}.${process.pid}.tmp`;
+    await fs.writeFile(tmp, JSON.stringify(accounts, null, 2), { mode: 0o600 });
+    await fs.rename(tmp, ACCOUNTS_FILE);
+    return account;
+  });
+  writeQueue = run.catch(() => {});
+  return run;
+}
+
+// ---------- http helpers ----------
+
+const SECURITY_HEADERS = {
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'X-Frame-Options': 'DENY',
+};
+
+function sendJson(res, status, body) {
+  res.writeHead(status, { ...SECURITY_HEADERS, 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(body));
+}
+
+async function readJsonBody(req) {
+  if (!/^application\/json\b/i.test(req.headers['content-type'] || '')) {
+    throw Object.assign(new Error('Expected application/json'), { status: 415 });
+  }
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > MAX_BODY_BYTES) throw Object.assign(new Error('Request too large'), { status: 413 });
+    chunks.push(chunk);
+  }
+  try {
+    const body = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error();
+    return body;
+  } catch {
+    throw Object.assign(new Error('Invalid JSON'), { status: 400 });
+  }
+}
+
+function sameOrigin(req) {
+  return req.headers.origin === PUBLIC_ORIGIN;
+}
+
+// ---------- API handlers ----------
+
+function handleNonce(req, res) {
+  const session = getSession(req) || createSession(res);
+  const value = crypto.randomBytes(32).toString('base64url');
+  session.s.nonce = { value, expires: Date.now() + NONCE_TTL_MS };
+  session.s.expires = Date.now() + SESSION_TTL_MS;
+  sendJson(res, 200, { nonce: value });
+}
+
+async function handleVerify(req, res) {
+  const session = getSession(req);
+  if (!session) return sendJson(res, 401, { error: 'Session expired. Please reload the page.' });
+  const body = await readJsonBody(req);
+
+  const { s } = session;
+  if (++s.verifyAttempts > 10) return sendJson(res, 429, { error: 'Too many attempts. Please reload the page.' });
+
+  const nonce = s.nonce;
+  // Single use: consume the nonce before any async work so it can't be replayed in parallel.
+  delete s.nonce;
+  if (!nonce || nonce.expires < Date.now()) {
+    return sendJson(res, 400, { error: 'Verification expired. Please pick your email again.' });
+  }
+
+  try {
+    const { email, issuer } = await verifyPresentation(body.presentationToken, {
+      audience: PUBLIC_ORIGIN,
+      nonce: nonce.value,
+    });
+    s.verified = { email, issuer, expires: Date.now() + VERIFIED_TTL_MS };
+    return sendJson(res, 200, { email });
+  } catch (err) {
+    if (err instanceof VerificationError) return sendJson(res, 400, { error: err.message });
+    throw err;
+  }
+}
+
+const DRINKS = new Set(['', 'latte', 'espresso', 'cold-brew', 'cappuccino', 'tea', 'other']);
+
+async function handleRegister(req, res) {
+  const session = getSession(req);
+  if (!session) return sendJson(res, 401, { error: 'Session expired. Please reload the page.' });
+  const body = await readJsonBody(req);
+
+  const name = typeof body.name === 'string' ? body.name.trim() : '';
+  const email = typeof body.email === 'string' ? body.email.trim() : '';
+  const favoriteDrink = typeof body.favoriteDrink === 'string' ? body.favoriteDrink : '';
+  if (name.length < 1 || name.length > 100) return sendJson(res, 400, { error: 'Please enter your name.' });
+  if (!DRINKS.has(favoriteDrink)) return sendJson(res, 400, { error: 'Unknown drink selection.' });
+
+  const verified = session.s.verified;
+  if (!verified || verified.expires < Date.now() || verified.email.toLowerCase() !== email.toLowerCase()) {
+    return sendJson(res, 403, { error: 'Please verify your email address before joining.' });
+  }
+
+  const account = await createAccount({
+    id: crypto.randomUUID(),
+    name,
+    email: verified.email,
+    emailVerified: true,
+    emailVerifiedBy: verified.issuer,
+    emailVerifiedAt: new Date().toISOString(),
+    favoriteDrink: favoriteDrink || null,
+    marketingOptIn: body.marketingOptIn === true,
+    points: 50, // welcome bonus
+    createdAt: new Date().toISOString(),
+  });
+  if (!account) return sendJson(res, 409, { error: 'A rewards account already exists for this email.' });
+
+  // The verification is spent once used for an account.
+  delete session.s.verified;
+  return sendJson(res, 201, { id: account.id, name: account.name, email: account.email, points: account.points });
+}
+
+// ---------- routing ----------
+
+const API_ROUTES = {
+  '/api/email-verification/nonce': handleNonce,
+  '/api/email-verification/verify': handleVerify,
+  '/api/rewards/register': handleRegister,
+};
+
+let indexHtml;
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const { pathname } = new URL(req.url, PUBLIC_ORIGIN);
+    const api = API_ROUTES[pathname];
+    if (api) {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return sendJson(res, 405, { error: 'Method not allowed' });
+      }
+      if (!sameOrigin(req)) return sendJson(res, 403, { error: 'Cross-origin request rejected' });
+      return await api(req, res);
+    }
+    if ((req.method === 'GET' || req.method === 'HEAD') && (pathname === '/' || pathname === '/index.html')) {
+      indexHtml ??= await fs.readFile(path.join(ROOT, 'index.html'));
+      res.writeHead(200, { ...SECURITY_HEADERS, 'Content-Type': 'text/html; charset=utf-8' });
+      return res.end(req.method === 'HEAD' ? undefined : indexHtml);
+    }
+    res.writeHead(404, { ...SECURITY_HEADERS, 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not found');
+  } catch (err) {
+    if (err.status) return sendJson(res, err.status, { error: err.message });
+    console.error(err);
+    if (!res.headersSent) sendJson(res, 500, { error: 'Something went wrong. Please try again.' });
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`Daily Grind listening on :${PORT} (public origin ${PUBLIC_ORIGIN})`);
+});
