+// Email Verification Protocol (EVP) presentation verifier.
+//
+// The browser asks the user's email provider (the "issuer") for a signed
+// SD-JWT asserting the email address, binds it to our origin + nonce with a
+// Key Binding JWT, and hands it to the page. No OTP or magic-link email is
+// ever sent. This module checks that token server-side:
+//
+//   1. DNS TXT `_email-verification.<email-domain>` delegates to an issuer.
+//   2. Issuer metadata at https://<issuer>/.well-known/email-verification
+//      points at its JWKS; the SD-JWT must be signed by one of those keys.
+//   3. The KB-JWT must be signed by the key in the SD-JWT's `cnf.jwk`, carry
+//      our exact origin as `aud`, our single-use nonce, a fresh `iat`, and an
+//      `sd_hash` covering the presented SD-JWT.
+
+import crypto from 'node:crypto';
+import dns from 'node:dns/promises';
+import net from 'node:net';
+
+const ALGS = {
+  ES256: { hash: 'sha256', dsaEncoding: 'ieee-p1363', kty: 'EC', crv: 'P-256' },
+  ES384: { hash: 'sha384', dsaEncoding: 'ieee-p1363', kty: 'EC', crv: 'P-384' },
+  RS256: { hash: 'sha256', kty: 'RSA' },
+  PS256: { hash: 'sha256', kty: 'RSA', padding: crypto.constants.RSA_PKCS1_PSS_PADDING },
+  EdDSA: { hash: null, kty: 'OKP', crv: 'Ed25519' },
+  Ed25519: { hash: null, kty: 'OKP', crv: 'Ed25519' },
+};
+
+const MAX_TOKEN_LENGTH = 16 * 1024;
+const MAX_FETCH_BYTES = 64 * 1024;
+const FETCH_TIMEOUT_MS = 5000;
+const CLOCK_SKEW_S = 60;
+const MAX_ISSUANCE_AGE_S = 10 * 60;
+const MAX_KB_AGE_S = 5 * 60;
+const METADATA_TTL_MS = 10 * 60 * 1000;
+
+export class VerificationError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'VerificationError';
+  }
+}
+
+const fail = (msg) => {
+  throw new VerificationError(msg);
+};
+
+// ---------- encoding helpers ----------
+
+const B64URL = /^[A-Za-z0-9_-]*$/;
+
+function b64urlDecode(str, what) {
+  if (typeof str !== 'string' || !B64URL.test(str)) fail(`Malformed ${what}`);
+  return Buffer.from(str, 'base64url');
+}
+
+function parseJson(buf, what) {
+  try {
+    const v = JSON.parse(buf.toString('utf8'));
+    if (!v || typeof v !== 'object' || Array.isArray(v)) throw new Error();
+    return v;
+  } catch {
+    fail(`Malformed ${what}`);
+  }
+}
+
+function parseJwt(jwt, what) {
+  const parts = jwt.split('.');
+  if (parts.length !== 3 || parts.some((p) => p.length === 0)) fail(`Malformed ${what}`);
+  return {
+    header: parseJson(b64urlDecode(parts[0], what), `${what} header`),
+    payload: parseJson(b64urlDecode(parts[1], what), `${what} payload`),
+    signingInput: Buffer.from(`${parts[0]}.${parts[1]}`, 'ascii'),
+    signature: b64urlDecode(parts[2], `${what} signature`),
+  };
+}
+
+// ---------- signature verification ----------
+
+function importJwk(jwk, alg) {
+  const spec = ALGS[alg];
+  if (!spec) fail(`Unsupported algorithm: ${alg}`);
+  if (!jwk || typeof jwk !== 'object' || jwk.kty !== spec.kty) fail('Key type does not match algorithm');
+  if (spec.crv && jwk.crv !== spec.crv) fail('Key curve does not match algorithm');
+  if (jwk.d) fail('Private key material is not allowed');
+  // Pass only public members so stray fields can't influence import.
+  const pub = { kty: jwk.kty };
+  for (const k of ['crv', 'x', 'y', 'n', 'e']) if (jwk[k] !== undefined) pub[k] = jwk[k];
+  try {
+    return crypto.createPublicKey({ key: pub, format: 'jwk' });
+  } catch {
+    fail('Invalid public key');
+  }
+}
+
+function verifySignature(parsed, key, alg) {
+  const spec = ALGS[alg];
+  const opts = { key };
+  if (spec.dsaEncoding) opts.dsaEncoding = spec.dsaEncoding;
+  if (spec.padding) {
+    opts.padding = spec.padding;
+    opts.saltLength = crypto.constants.RSA_PSS_SALTLEN_DIGEST;
+  }
+  let ok = false;
+  try {
+    ok = crypto.verify(spec.hash, parsed.signingInput, opts, parsed.signature);
+  } catch {
+    ok = false;
+  }
+  if (!ok) fail('Invalid signature');
+}
+
+// ---------- issuer discovery (DNS + HTTPS) ----------
+
+const HOSTNAME = /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/;
+
+function normalizeIssuer(value) {
+  if (typeof value !== 'string') return null;
+  let host = value.trim().toLowerCase();
+  if (host.startsWith('https://')) {
+    try {
+      const u = new URL(host);
+      if (u.port || u.username || u.password || (u.pathname !== '/' && u.pathname !== '') || u.search || u.hash) {
+        return null;
+      }
+      host = u.hostname;
+    } catch {
+      return null;
+    }
+  }
+  host = host.replace(/\.$/, '');
+  if (!HOSTNAME.test(host) || net.isIP(host)) return null;
+  if (host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local') || host.endsWith('.internal')) {
+    return null;
+  }
+  return host;
+}
+
+export async function lookupIssuer(emailDomain, resolver = dns) {
+  let records;
+  try {
+    records = await resolver.resolveTxt(`_email-verification.${emailDomain}`);
+  } catch {
+    fail('Your email provider does not support instant verification');
+  }
+  const issuers = new Set();
+  for (const chunks of records) {
+    const txt = chunks.join('');
+    for (const part of txt.split(/[;\s]+/)) {
+      if (part.startsWith('iss=')) {
+        const host = normalizeIssuer(part.slice(4));
+        if (host) issuers.add(host);
+      }
+    }
+  }
+  if (issuers.size !== 1) fail('Your email provider does not support instant verification');
+  return [...issuers][0];
+}
+
+function isPublicAddress(ip) {
+  const blocked = new net.BlockList();
+  for (const [addr, prefix] of [
+    ['0.0.0.0', 8], ['10.0.0.0', 8], ['100.64.0.0', 10], ['127.0.0.0', 8], ['169.254.0.0', 16],
+    ['172.16.0.0', 12], ['192.0.0.0', 24], ['192.168.0.0', 16], ['198.18.0.0', 15], ['224.0.0.0', 3],
+  ]) blocked.addSubnet(addr, prefix, 'ipv4');
+  for (const [addr, prefix] of [['::', 127], ['fc00::', 7], ['fe80::', 10], ['ff00::', 8], ['::ffff:0:0', 96]]) {
+    blocked.addSubnet(addr, prefix, 'ipv6');
+  }
+  return !blocked.check(ip, net.isIPv6(ip) ? 'ipv6' : 'ipv4');
+}
+
+// Refuse to talk to issuers that resolve to internal addresses (SSRF guard).
+async function assertPublicHost(hostname) {
+  let addrs;
+  try {
+    addrs = await dns.lookup(hostname, { all: true, verbatim: true });
+  } catch {
+    fail('Could not reach the email provider');
+  }
+  if (addrs.length === 0 || !addrs.every((a) => isPublicAddress(a.address))) {
+    fail('Email provider address is not allowed');
+  }
+}
+
+async function fetchJson(url) {
+  await assertPublicHost(new URL(url).hostname);
+  let res;
+  try {
+    res = await fetch(url, {
+      redirect: 'error',
+      headers: { accept: 'application/json' },
+      signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
+    });
+  } catch {
+    fail('Could not reach the email provider');
+  }
+  if (!res.ok) fail('Email provider returned an error');
+  const reader = res.body.getReader();
+  const chunks = [];
+  let total = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    total += value.length;
+    if (total > MAX_FETCH_BYTES) {
+      reader.cancel().catch(() => {});
+      fail('Email provider response too large');
+    }
+    chunks.push(value);
+  }
+  return parseJson(Buffer.concat(chunks), 'provider response');
+}
+
+const metadataCache = new Map(); // issuer host -> { expires, keys }
+
+export async function getIssuerKeys(issuerHost, { fetchJsonImpl = fetchJson } = {}) {
+  const cached = metadataCache.get(issuerHost);
+  if (cached && cached.expires > Date.now()) return cached.keys;
+
+  const metadata = await fetchJsonImpl(`https://${issuerHost}/.well-known/email-verification`);
+  let jwksUrl;
+  try {
+    jwksUrl = new URL(metadata.jwks_uri);
+  } catch {
+    fail('Email provider metadata is invalid');
+  }
+  // Keys must be served by the issuer itself over HTTPS.
+  if (jwksUrl.protocol !== 'https:' || jwksUrl.hostname !== issuerHost || jwksUrl.port) {
+    fail('Email provider metadata is invalid');
+  }
+  const jwks = await fetchJsonImpl(jwksUrl.href);
+  if (!Array.isArray(jwks.keys)) fail('Email provider keys are invalid');
+  const keys = jwks.keys.filter((k) => k && typeof k === 'object');
+  metadataCache.set(issuerHost, { expires: Date.now() + METADATA_TTL_MS, keys });
+  return keys;
+}
+
+// ---------- SD-JWT disclosures ----------
+
+function applyDisclosures(payload, disclosures) {
+  if (disclosures.length === 0) return payload;
+  const sdAlg = payload._sd_alg ?? 'sha-256';
+  if (sdAlg !== 'sha-256') fail('Unsupported disclosure hash algorithm');
+  const digests = new Set(Array.isArray(payload._sd) ? payload._sd : []);
+  const out = { ...payload };
+  for (const d of disclosures) {
+    const digest = crypto.createHash('sha256').update(d, 'ascii').digest('base64url');
+    if (!digests.has(digest)) fail('Disclosure does not match the token');
+    digests.delete(digest); // each digest may be used once
+    let arr;
+    try {
+      arr = JSON.parse(b64urlDecode(d, 'disclosure').toString('utf8'));
+    } catch {
+      fail('Malformed disclosure');
+    }
+    if (!Array.isArray(arr) || arr.length !== 3 || typeof arr[1] !== 'string') fail('Malformed disclosure');
+    const name = arr[1];
+    if (name === '_sd' || name === '...' || name in payload) fail('Malformed disclosure');
+    out[name] = arr[2];
+  }
+  delete out._sd;
+  delete out._sd_alg;
+  return out;
+}
+
+// ---------- main entry point ----------
+
+const EMAIL = /^[^\s@]{1,64}@[^\s@]{1,253}$/;
+
+/**
+ * Verify an EVP presentation token.
+ * @param {string} token  SD-JWT+KB: `<issuer-jwt>~[<disclosure>~...]<kb-jwt>`
+ * @param {{ audience: string, nonce: string, now?: number, resolver?: object, fetchJsonImpl?: Function }} opts
+ * @returns {Promise<{ email: string, issuer: string }>}
+ */
+export async function verifyPresentation(token, { audience, nonce, now = Date.now(), resolver, fetchJsonImpl }) {
+  if (typeof token !== 'string' || token.length === 0 || token.length > MAX_TOKEN_LENGTH) {
+    fail('Missing or oversized token');
+  }
+  if (!audience || !nonce) fail('Verifier misconfigured');
+
+  const parts = token.split('~');
+  if (parts.length < 2) fail('Token is missing key binding');
+  const kbJwt = parts.pop();
+  const [issuerJwt, ...disclosures] = parts;
+  if (!issuerJwt || !kbJwt || disclosures.some((d) => d.length === 0)) fail('Malformed token');
+
+  const nowS = Math.floor(now / 1000);
+
+  // --- Issuer-signed SD-JWT ---
+  const sd = parseJwt(issuerJwt, 'issuer token');
+  const alg = sd.header.alg;
+  if (!ALGS[alg]) fail('Unsupported issuer algorithm');
+  if (sd.header.crit !== undefined) fail('Unsupported critical header');
+
+  const claims = applyDisclosures(sd.payload, disclosures);
+  const email = claims.email;
+  if (typeof email !== 'string' || !EMAIL.test(email)) fail('Token does not contain an email address');
+  if (claims.email_verified !== true) fail('Email provider did not confirm the address');
+
+  const emailDomain = email.slice(email.lastIndexOf('@') + 1).toLowerCase();
+  if (!HOSTNAME.test(emailDomain)) fail('Unsupported email domain');
+
+  const claimedIssuer = normalizeIssuer(claims.iss);
+  if (!claimedIssuer) fail('Invalid issuer');
+
+  if (typeof claims.iat !== 'number') fail('Issuer token missing iat');
+  if (claims.iat > nowS + CLOCK_SKEW_S) fail('Issuer token issued in the future');
+  if (claims.iat < nowS - MAX_ISSUANCE_AGE_S) fail('Issuer token has expired');
+  if (claims.exp !== undefined && (typeof claims.exp !== 'number' || claims.exp < nowS - CLOCK_SKEW_S)) {
+    fail('Issuer token has expired');
+  }
+  if (claims.nbf !== undefined && (typeof claims.nbf !== 'number' || claims.nbf > nowS + CLOCK_SKEW_S)) {
+    fail('Issuer token not yet valid');
+  }
+
+  // The email domain must delegate to exactly this issuer via DNS.
+  const delegatedIssuer = await lookupIssuer(emailDomain, resolver);
+  if (delegatedIssuer !== claimedIssuer) fail('Issuer is not authorized for this email domain');
+
+  const keys = await getIssuerKeys(delegatedIssuer, { fetchJsonImpl });
+  const kid = sd.header.kid;
+  const candidates = keys.filter(
+    (k) => (kid === undefined || k.kid === kid) && (k.alg === undefined || k.alg === alg) && (k.use === undefined || k.use === 'sig'),
+  );
+  if (candidates.length === 0) fail('Issuer signing key not found');
+  let verified = false;
+  for (const jwk of candidates) {
+    try {
+      verifySignature(sd, importJwk(jwk, alg), alg);
+      verified = true;
+      break;
+    } catch {
+      /* try next key */
+    }
+  }
+  if (!verified) fail('Invalid issuer signature');
+
+  // --- Key Binding JWT ---
+  const cnfJwk = sd.payload.cnf?.jwk;
+  if (!cnfJwk) fail('Issuer token missing cnf key');
+  const kb = parseJwt(kbJwt, 'key binding token');
+  if (kb.header.typ !== 'kb+jwt') fail('Invalid key binding token type');
+  if (!ALGS[kb.header.alg]) fail('Unsupported key binding algorithm');
+  verifySignature(kb, importJwk(cnfJwk, kb.header.alg), kb.header.alg);
+
+  if (kb.payload.aud !== audience) fail('Token was issued for a different site');
+  if (typeof kb.payload.nonce !== 'string' || !timingSafeEqualStr(kb.payload.nonce, nonce)) {
+    fail('Token nonce mismatch');
+  }
+  if (typeof kb.payload.iat !== 'number') fail('Key binding token missing iat');
+  if (kb.payload.iat > nowS + CLOCK_SKEW_S || kb.payload.iat < nowS - MAX_KB_AGE_S) {
+    fail('Key binding token has expired');
+  }
+  const presented = token.slice(0, token.length - kbJwt.length); // includes trailing '~'
+  const expectedSdHash = crypto.createHash('sha256').update(presented, 'ascii').digest('base64url');
+  if (typeof kb.payload.sd_hash !== 'string' || !timingSafeEqualStr(kb.payload.sd_hash, expectedSdHash)) {
+    fail('Key binding token does not match presented token');
+  }
+
+  return { email: email.slice(0, email.lastIndexOf('@') + 1) + emailDomain, issuer: delegatedIssuer };
+}
+
+function timingSafeEqualStr(a, b) {
+  const ab = Buffer.from(a);
+  const bb = Buffer.from(b);
+  return ab.length === bb.length && crypto.timingSafeEqual(ab, bb);
+}
+
+export function _clearCache() {
+  metadataCache.clear();
+}
diff --git a/test/evp.test.js b/test/evp.test.js
new file mode 100644
index 0000000..fbf7048
--- /dev/null
+++ b/test/evp.test.js
@@ -0,0 +1,87 @@
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { verifyPresentation, _clearCache } from '../server/evp.js';
+
+const AUD = 'https://dailygrind.example';
+const NONCE = 'n0nce-abc';
+const ISSUER = 'issuer.mail.example';
+
+const issuerKeys = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+const holderKeys = crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' });
+const issuerJwk = { ...issuerKeys.publicKey.export({ format: 'jwk' }), kid: 'k1', alg: 'ES256', use: 'sig' };
+const holderJwk = holderKeys.publicKey.export({ format: 'jwk' });
+
+const b64 = (o) => Buffer.from(JSON.stringify(o)).toString('base64url');
+function sign(header, payload, key) {
+  const input = `${b64(header)}.${b64(payload)}`;
+  const sig = crypto.sign('sha256', Buffer.from(input), { key, dsaEncoding: 'ieee-p1363' });
+  return `${input}.${sig.toString('base64url')}`;
+}
+
+const now = () => Math.floor(Date.now() / 1000);
+
+function makeToken({ sdPayload = {}, kbPayload = {}, issuerKey = issuerKeys.privateKey, holderKey = holderKeys.privateKey, disclosures = [] } = {}) {
+  const sd = sign(
+    { alg: 'ES256', kid: 'k1', typ: 'evp+sd-jwt' },
+    { iss: ISSUER, iat: now(), cnf: { jwk: holderJwk }, email: 'Jane@Mail.Example', email_verified: true, ...sdPayload },
+    issuerKey,
+  );
+  const presented = [sd, ...disclosures].join('~') + '~';
+  const sdHash = crypto.createHash('sha256').update(presented).digest('base64url');
+  const kb = sign({ alg: 'ES256', typ: 'kb+jwt' }, { aud: AUD, nonce: NONCE, iat: now(), sd_hash: sdHash, ...kbPayload }, holderKey);
+  return presented + kb;
+}
+
+const resolver = { resolveTxt: async (name) => (name === '_email-verification.mail.example' ? [[`iss=${ISSUER}`]] : Promise.reject(new Error('ENOTFOUND'))) };
+const fetchJsonImpl = async (url) => {
+  if (url === `https://${ISSUER}/.well-known/email-verification`) return { jwks_uri: `https://${ISSUER}/jwks` };
+  if (url === `https://${ISSUER}/jwks`) return { keys: [issuerJwk] };
+  throw new Error('unexpected ' + url);
+};
+const opts = { audience: AUD, nonce: NONCE, resolver, fetchJsonImpl };
+
+beforeEach(() => _clearCache());
+
+test('accepts a valid presentation', async () => {
+  const res = await verifyPresentation(makeToken(), opts);
+  assert.deepEqual(res, { email: 'Jane@mail.example', issuer: ISSUER });
+});
+
+test('accepts claims delivered as SD-JWT disclosures', async () => {
+  const disc = Buffer.from(JSON.stringify(['salt', 'email', 'sd@mail.example'])).toString('base64url');
+  const digest = crypto.createHash('sha256').update(disc).digest('base64url');
+  const token = makeToken({ sdPayload: { email: undefined, _sd: [digest] }, disclosures: [disc] });
+  assert.equal((await verifyPresentation(token, opts)).email, 'sd@mail.example');
+});
+
+const rejects = (name, tokenFn, o = opts, re) =>
+  test(`rejects: ${name}`, async () => {
+    await assert.rejects(verifyPresentation(tokenFn(), o), re ?? { name: 'VerificationError' });
+  });
+
+rejects('wrong audience', () => makeToken({ kbPayload: { aud: 'https://evil.example' } }));
+rejects('wrong nonce', () => makeToken({ kbPayload: { nonce: 'other' } }));
+rejects('stale key binding', () => makeToken({ kbPayload: { iat: now() - 3600 } }));
+rejects('stale issuance', () => makeToken({ sdPayload: { iat: now() - 3600 } }));
+rejects('bad sd_hash', () => makeToken({ kbPayload: { sd_hash: 'x' } }));
+rejects('email_verified missing', () => makeToken({ sdPayload: { email_verified: undefined } }));
+rejects('issuer not delegated by DNS', () => makeToken({ sdPayload: { iss: 'other-issuer.example' } }));
+rejects('email domain without DNS record', () => makeToken({ sdPayload: { email: 'a@nodns.example' } }));
+rejects('forged issuer signature', () => makeToken({ issuerKey: crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' }).privateKey }));
+rejects('key binding signed by wrong key', () => makeToken({ holderKey: crypto.generateKeyPairSync('ec', { namedCurve: 'P-256' }).privateKey }));
+rejects('no key binding', () => makeToken().split('~').slice(0, -1).join('~') + '~');
+rejects('alg none', () => {
+  const [sd, kb] = makeToken().split('~');
+  const [, p] = sd.split('.');
+  return `${b64({ alg: 'none' })}.${p}.x~${kb}`;
+});
+rejects('unlisted disclosure', () => makeToken({ disclosures: [Buffer.from('["s","email","x@evil.example"]').toString('base64url')] }));
+rejects('jwks on another host', makeToken, {
+  ...opts,
+  fetchJsonImpl: async (url) => (url.endsWith('/.well-known/email-verification') ? { jwks_uri: 'https://evil.example/jwks' } : { keys: [issuerJwk] }),
+});
+rejects('issuer delegated to localhost', makeToken, {
+  ...opts,
+  resolver: { resolveTxt: async () => [['iss=localhost']] },
+});
