diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..867caa9
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,249 @@
+// The Daily Grind web server: renders the homepage with a per-render EVP nonce
+// and handles rewards sign-up at POST /api/verify-email.
+//
+// Env:
+//   PORT                     (default 11222)
+//   RP_ORIGIN                public origin of this site, e.g. https://dailygrind.example
+//                            (KB-JWT `aud` is checked against it; default http://localhost:PORT)
+//   EVP_ORIGIN_TRIAL_TOKEN   Chrome Origin Trial token for the Email Verification API
+//
+// Storage (sessions, accounts) is in-memory for this demo; swap for a real
+// database / session store in production.
+
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes, randomUUID, scrypt as scryptCb } from 'node:crypto';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './lib/email-verification.mjs';
+
+const scrypt = promisify(scryptCb);
+
+const PORT = Number(process.env.PORT) || 11222;
+const RP_ORIGIN = (process.env.RP_ORIGIN || `http://localhost:${PORT}`).replace(/\/+$/, '');
+const ORIGIN_TRIAL_TOKEN = process.env.EVP_ORIGIN_TRIAL_TOKEN || '';
+const SECURE_COOKIE = RP_ORIGIN.startsWith('https://');
+const SESSION_COOKIE = SECURE_COOKIE ? '__Host-dg_sid' : 'dg_sid';
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const MAX_BODY_BYTES = 16 * 1024;
+
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+
+// ---- Server-side session store (sid -> { nonce, expires }) -------------------
+const sessions = new Map();
+
+function getOrCreateSessionId(req) {
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  if (sid && /^[\w-]{20,64}$/.test(sid)) return { sid, isNew: false };
+  return { sid: randomBytes(24).toString('base64url'), isNew: true };
+}
+
+function issueNonce(sid) {
+  const nonce = randomBytes(32).toString('base64url'); // 256 bits
+  sessions.set(sid, { nonce, expires: Date.now() + SESSION_TTL_MS });
+  return nonce;
+}
+
+/** Atomically read and delete the single-use nonce for this session. */
+function consumeNonce(sid) {
+  const entry = sid ? sessions.get(sid) : undefined;
+  if (!entry) return null;
+  sessions.delete(sid);
+  return entry.expires > Date.now() ? entry.nonce : null;
+}
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [sid, entry] of sessions) if (entry.expires <= now) sessions.delete(sid);
+}, 60_000).unref();
+
+// ---- Account store ---------------------------------------------------------
+const accounts = new Map(); // lowercase email -> account
+
+async function hashPassword(password) {
+  const salt = randomBytes(16);
+  const key = await scrypt(password.normalize('NFKC'), salt, 64);
+  return `scrypt$${salt.toString('base64url')}$${key.toString('base64url')}`;
+}
+
+async function createAccount({ name, email, password, emailVerified, verifiedBy }) {
+  const account = {
+    id: randomUUID(),
+    name,
+    email,
+    passwordHash: await hashPassword(password),
+    emailVerified,
+    verifiedBy,
+    createdAt: new Date().toISOString(),
+  };
+  accounts.set(email.toLowerCase(), account);
+  return account;
+}
+
+function sendTraditionalVerificationEmail(email) {
+  // Fallback path: integrate your transactional email provider here
+  // (OTP code or magic link).
+  console.info(`[signup] EVP unavailable for ${email}; sending OTP/magic-link verification email.`);
+}
+
+// ---- Helpers ---------------------------------------------------------------
+function parseCookies(header = '') {
+  const out = {};
+  for (const part of header.split(';')) {
+    const i = part.indexOf('=');
+    if (i > 0) out[part.slice(0, i).trim()] = decodeURIComponent(part.slice(i + 1).trim());
+  }
+  return out;
+}
+
+function sessionCookie(sid) {
+  return [
+    `${SESSION_COOKIE}=${sid}`,
+    'Path=/',
+    'HttpOnly',
+    'SameSite=Lax',
+    `Max-Age=${SESSION_TTL_MS / 1000}`,
+    SECURE_COOKIE ? 'Secure' : '',
+  ].filter(Boolean).join('; ');
+}
+
+function securityHeaders(extra = {}) {
+  return {
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'X-Frame-Options': 'DENY',
+    ...extra,
+  };
+}
+
+function readBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        reject(Object.assign(new Error('Payload too large'), { status: 413 }));
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
+    req.on('error', reject);
+  });
+}
+
+function redirect(res, location, headers = {}) {
+  res.writeHead(303, securityHeaders({ Location: location, 'Cache-Control': 'no-store', ...headers }));
+  res.end();
+}
+
+// Fixed status messages only — never reflect user input into the page.
+const STATUS_MESSAGES = {
+  verified: ['success', "Welcome to Daily Grind Rewards! Your email is verified and your account is ready — your first drink's on us."],
+  pending: ['info', "Almost there! We've sent a verification link to your inbox. Open it to activate your rewards account."],
+  invalid: ['error', 'Please enter your name, a valid email address, and a password of at least 8 characters.'],
+};
+
+function renderHome(nonce, status) {
+  const [kind, text] = STATUS_MESSAGES[status] || [];
+  const statusHtml = text
+    ? `<p class="signup-status signup-status--${kind}" role="${kind === 'error' ? 'alert' : 'status'}">${text}</p>`
+    : '';
+  return template.replace('{{EVP_NONCE}}', nonce).replace('<!--{{SIGNUP_STATUS}}-->', statusHtml);
+}
+
+// ---- Routes ----------------------------------------------------------------
+async function handleHome(req, res, url) {
+  const { sid } = getOrCreateSessionId(req);
+  const nonce = issueNonce(sid);
+  const headers = securityHeaders({
+    'Content-Type': 'text/html; charset=utf-8',
+    'Cache-Control': 'no-store', // never reuse a consumed nonce via bfcache/HTTP cache
+    'Set-Cookie': sessionCookie(sid),
+  });
+  if (ORIGIN_TRIAL_TOKEN) headers['Origin-Trial'] = ORIGIN_TRIAL_TOKEN;
+  res.writeHead(200, headers);
+  res.end(req.method === 'HEAD' ? undefined : renderHome(nonce, url.searchParams.get('signup')));
+}
+
+async function handleSignup(req, res) {
+  // CSRF defence in depth (session cookie is also SameSite=Lax).
+  const origin = req.headers.origin;
+  if (origin && origin !== RP_ORIGIN) {
+    res.writeHead(403, securityHeaders({ 'Content-Type': 'text/plain' }));
+    return res.end('Forbidden');
+  }
+
+  const form = new URLSearchParams(await readBody(req));
+  const name = String(form.get('name') || '').trim().slice(0, 200);
+  const email = String(form.get('email') || '').trim();
+  const password = String(form.get('new-password') || '');
+  const rawToken = String(form.get('token') || '').trim();
+
+  // Always consume the nonce, even for invalid submissions, so it is single-use.
+  const sid = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  const expectedNonce = consumeNonce(sid);
+
+  const emailOk = email.length <= 254 && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
+  if (!name || !emailOk || password.length < 8 || password.length > 1024) {
+    return redirect(res, '/?signup=invalid#rewards');
+  }
+
+  // Existing accounts get the same "check your inbox" response to avoid
+  // revealing which emails are registered.
+  if (accounts.has(email.toLowerCase())) {
+    sendTraditionalVerificationEmail(email);
+    return redirect(res, '/?signup=pending#rewards');
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      const { issuer } = await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail: email,
+        expectedNonce,
+        expectedAudience: RP_ORIGIN,
+      });
+      // Fast path: ownership cryptographically verified — no OTP email needed.
+      await createAccount({ name, email, password, emailVerified: true, verifiedBy: issuer });
+      return redirect(res, '/?signup=verified#rewards');
+    } catch (err) {
+      console.warn('[signup] Email verification token check failed:', err?.message || err);
+    }
+  }
+
+  // Fallback: unsupported browser, no provider session, or invalid token.
+  await createAccount({ name, email, password, emailVerified: false, verifiedBy: null });
+  sendTraditionalVerificationEmail(email);
+  return redirect(res, '/?signup=pending#rewards');
+}
+
+const server = http.createServer(async (req, res) => {
+  try {
+    const url = new URL(req.url, RP_ORIGIN);
+    if ((req.method === 'GET' || req.method === 'HEAD') && (url.pathname === '/' || url.pathname === '/index.html')) {
+      return await handleHome(req, res, url);
+    }
+    if (url.pathname === '/api/verify-email') {
+      if (req.method !== 'POST') {
+        res.writeHead(405, securityHeaders({ Allow: 'POST', 'Content-Type': 'text/plain' }));
+        return res.end('Method Not Allowed');
+      }
+      return await handleSignup(req, res);
+    }
+    res.writeHead(404, securityHeaders({ 'Content-Type': 'text/plain' }));
+    res.end('Not Found');
+  } catch (err) {
+    console.error(err);
+    if (!res.headersSent) {
+      res.writeHead(err.status || 500, securityHeaders({ 'Content-Type': 'text/plain' }));
+    }
+    res.end(err.status === 413 ? 'Payload Too Large' : 'Internal Server Error');
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on ${RP_ORIGIN} (port ${PORT})`);
+  if (!ORIGIN_TRIAL_TOKEN) console.warn('EVP_ORIGIN_TRIAL_TOKEN not set; browsers will fall back to email verification.');
+});
