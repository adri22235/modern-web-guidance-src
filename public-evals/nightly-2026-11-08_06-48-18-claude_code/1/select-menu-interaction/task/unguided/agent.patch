+  <script>
+    (function () {
+      var form = document.getElementById('order-form');
+      var select = document.getElementById('shop');
+      var field = document.getElementById('shop-field');
+      var error = document.getElementById('shop-error');
+      var touched = false;
+
+      function validate() {
+        var valid = select.checkValidity();
+        // Never surface errors until the user has interacted or tried to submit.
+        if (!touched) return valid;
+        field.classList.add('touched');
+        select.setAttribute('aria-invalid', valid ? 'false' : 'true');
+        error.textContent = valid ? '' : 'Please select a local shop.';
+        return valid;
+      }
+
+      function markTouched() {
+        touched = true;
+        validate();
+      }
+
+      select.addEventListener('change', markTouched);
+      select.addEventListener('blur', markTouched);
+
+      form.addEventListener('submit', function (event) {
+        touched = true;
+        if (!validate()) {
+          event.preventDefault();
+          select.focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
