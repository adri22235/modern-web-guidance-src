+  <script>
+    // Keep aria-invalid in sync with the visual :user-invalid state.
+    const syncAriaInvalid = (event) => {
+      const el = event.target;
+      if (!el.matches?.('input, select, textarea')) return;
+      if (el.matches(':user-invalid')) {
+        el.setAttribute('aria-invalid', 'true');
+      } else {
+        el.removeAttribute('aria-invalid');
+      }
+    };
+    document.addEventListener('blur', syncAriaInvalid, true);
+    document.addEventListener('change', syncAriaInvalid, true);
+    document.addEventListener('invalid', syncAriaInvalid, true);
+  </script>
