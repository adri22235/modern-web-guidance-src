+  <script type="module">
+    // Invoker Commands (command/commandfor) progressive enhancement
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      await import('https://unpkg.com/invokers-polyfill@latest/invoker.min.js');
+    }
+
+    const dialog = document.getElementById('feedback-dialog');
+    const moveBtn = document.getElementById('feedback-move');
+    const form = document.getElementById('feedback-form');
+    const locationLabel = document.getElementById('feedback-location');
+    const status = document.getElementById('feedback-status');
+    const docks = [document.getElementById('dock-a'), document.getElementById('dock-b')];
+
+    function nextDock() {
+      return docks.find((d) => d !== dialog.parentElement);
+    }
+
+    function updateLabels() {
+      const current = dialog.parentElement.dataset.dockName;
+      locationLabel.textContent = current;
+      moveBtn.textContent = `Move to ${nextDock().dataset.dockName}`;
+      return current;
+    }
+
+    moveBtn.addEventListener('click', () => {
+      const target = nextDock();
+
+      if ('moveBefore' in Element.prototype) {
+        // Atomic move: the modal stays open in the top layer and keeps focus.
+        target.moveBefore(dialog, null);
+      } else {
+        // Fallback: a traditional move removes the node, which closes the
+        // modal and drops focus. Re-open it and restore the focused control.
+        const wasOpen = dialog.open;
+        const focused = document.activeElement;
+        target.insertBefore(dialog, null);
+        if (wasOpen && !dialog.open) dialog.showModal();
+        if (focused && dialog.contains(focused)) focused.focus();
+      }
+
+      status.textContent = `Feedback form moved to ${updateLabels()}.`;
+    });
+
+    dialog.addEventListener('close', () => {
+      if (dialog.returnValue === 'send') {
+        status.textContent = 'Thanks! Your feedback was sent.';
+        form.reset();
+      }
+      dialog.returnValue = '';
+    });
+
+    updateLabels();
+  </script>
+
