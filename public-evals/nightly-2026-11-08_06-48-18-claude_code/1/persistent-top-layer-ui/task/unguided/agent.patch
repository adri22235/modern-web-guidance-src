+  <script>
+    (() => {
+      const dialog = document.getElementById('feedback-dialog');
+      const form = document.getElementById('feedback-form');
+      const openBtn = document.getElementById('feedback-open');
+      const moveBtn = document.getElementById('feedback-move');
+      const moveTargetLabel = document.getElementById('feedback-move-target');
+      const locationLabel = document.getElementById('feedback-location-name');
+      const announcer = document.getElementById('feedback-announcer');
+      const toast = document.getElementById('toast');
+      const docks = ['dock-page', 'dock-main', 'dock-footer'].map((id) => document.getElementById(id));
+
+      const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function';
+
+      const currentDockIndex = () => docks.indexOf(dialog.parentElement);
+      const nextDock = () => docks[(currentDockIndex() + 1) % docks.length];
+      const dockName = (dock) => dock.dataset.dockName;
+
+      function updateLabels() {
+        locationLabel.textContent = dockName(dialog.parentElement);
+        moveTargetLabel.textContent = dockName(nextDock());
+      }
+
+      /**
+       * Relocate the dialog to `target` while keeping it open, modal, and focused.
+       *
+       * Preferred path: Element.prototype.moveBefore() performs an atomic,
+       * state-preserving move — the dialog is never "removed", so it stays in the
+       * top layer, stays modal, and the focused element keeps focus.
+       *
+       * Fallback: a regular insertion removes the node first, which closes the
+       * dialog and drops focus. We snapshot the state, move, then re-open the
+       * dialog modally and restore focus, caret/selection and scroll position.
+       */
+      function moveDialog(target) {
+        if (target === dialog.parentElement) return;
+
+        if (supportsMoveBefore) {
+          target.moveBefore(dialog, null);
+          return;
+        }
+
+        const wasOpen = dialog.open;
+        const wasModal = wasOpen && dialog.matches(':modal');
+        const active = dialog.contains(document.activeElement) ? document.activeElement : null;
+        const selection = active && typeof active.selectionStart === 'number'
+          ? { start: active.selectionStart, end: active.selectionEnd, dir: active.selectionDirection }
+          : null;
+        const scrollTops = active && active.scrollTop;
+
+        target.appendChild(dialog);
+
+        // Depending on the engine, removal either fully closes the dialog or
+        // leaves `open` set but drops it from the top layer (no longer modal).
+        const lostState = !dialog.open || (wasModal && !dialog.matches(':modal'));
+        if (wasOpen && lostState) {
+          if (dialog.open) dialog.close();
+          wasModal ? dialog.showModal() : dialog.show();
+        }
+        if (active && active.isConnected) {
+          active.focus({ preventScroll: true });
+          if (selection) {
+            try { active.setSelectionRange(selection.start, selection.end, selection.dir); } catch (_) { }
+          }
+          if (scrollTops) active.scrollTop = scrollTops;
+        }
+      }
+
+      function showToast(text) {
+        toast.textContent = text;
+        toast.classList.add('visible');
+        clearTimeout(showToast.timer);
+        showToast.timer = setTimeout(() => toast.classList.remove('visible'), 2500);
+      }
+
+      openBtn.addEventListener('click', () => {
+        updateLabels();
+        dialog.showModal();
+      });
+
+      moveBtn.addEventListener('click', () => {
+        const target = nextDock();
+        moveDialog(target);
+        updateLabels();
+        // Ensure the Move button keeps focus so repeated presses keep working.
+        if (document.activeElement !== moveBtn) moveBtn.focus({ preventScroll: true });
+        announcer.textContent = `Feedback dialog moved to ${dockName(target)}.`;
+      });
+
+      // Light dismiss: clicking the backdrop (the dialog element itself) closes.
+      dialog.addEventListener('click', (e) => {
+        if (e.target === dialog) dialog.close('cancel');
+      });
+
+      dialog.addEventListener('close', () => {
+        // In the fallback path, the removal-triggered close event fires
+        // asynchronously after we've already re-opened the dialog; ignore it.
+        if (dialog.open) return;
+
+        if (dialog.returnValue === 'submit') {
+          form.reset();
+          showToast('Thanks for your feedback!');
+        }
+        dialog.returnValue = '';
+        announcer.textContent = '';
+        openBtn.focus();
+      });
+    })();
+  </script>
