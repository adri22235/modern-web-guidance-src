@@ -151,8 +151,57 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Layout density: the toggle flips --density on #target-container;
+       cards react via a container style query (no JS styling the cards). */
+    :root {
+      --style-queries-supported: check;
+    }
+
+    #target-container {
+      --density: compact;
+    }
+
+    .card {
+      --card-padding-spacious: 40px;
+      transition: padding 0.3s;
+    }
+
+    @container style(--density: spacious) {
+      .card {
+        padding: var(--card-padding-spacious);
+      }
+    }
+
+    .density-controls {
+      text-align: center;
+      margin-top: 10px;
+    }
+
+    /* Hidden unless the browser supports container style queries */
+    .density-toggle {
+      display: none;
+      font: inherit;
+      cursor: pointer;
+      border: 2px solid var(--primary);
+      background: white;
+      color: var(--primary);
+      padding: 6px 16px;
+      border-radius: 5px;
+    }
+
+    .density-toggle[aria-pressed="true"] {
+      background: var(--primary);
+      color: white;
+    }
+
+    @container style(--style-queries-supported: check) {
+      .density-toggle {
+        display: inline-block;
+      }
+    }
   </style>
 </head>
 
