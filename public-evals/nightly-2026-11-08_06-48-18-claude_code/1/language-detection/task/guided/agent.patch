+  <script>
+    (() => {
+      const form = document.getElementById('feedback-form');
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const status = document.getElementById('detect-status');
+
+      const displayNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      const percentFormat = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 1 });
+      let detectorPromise = null;
+
+      const setStatus = (text, isError = false) => {
+        status.textContent = text;
+        status.classList.toggle('error', isError);
+      };
+
+      const disableFeature = (text) => {
+        button.disabled = true;
+        setStatus(text, true);
+      };
+
+      const languageName = (code) => {
+        try {
+          return displayNames.of(code) || code;
+        } catch {
+          return code;
+        }
+      };
+
+      // Must be called from a user gesture when the model is downloadable/downloading.
+      const getDetector = () => {
+        detectorPromise ??= LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round(e.loaded * 100);
+              progress.hidden = false;
+              progress.value = pct;
+              setStatus(`Downloading language model… ${pct}%`);
+            });
+          },
+        }).catch((err) => {
+          detectorPromise = null; // allow retry
+          throw err;
+        });
+        return detectorPromise;
+      };
+
+      if (!('LanguageDetector' in self)) {
+        disableFeature('Language detection is not supported in this browser.');
+        return;
+      }
+
+      LanguageDetector.availability().then((availability) => {
+        if (availability === 'unavailable') {
+          disableFeature('Language detection is unavailable on this device.');
+        } else if (availability !== 'available') {
+          setStatus('The language model will be downloaded the first time you click Detect.');
+        }
+      }).catch(() => disableFeature('Could not check language detection availability.'));
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const text = textarea.value.trim();
+        if (!text) {
+          setStatus('Please enter a message first.', true);
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        setStatus('Detecting…');
+        try {
+          const detector = await getDetector();
+          progress.hidden = true;
+          const [top] = await detector.detect(text);
+          if (!top || top.detectedLanguage === 'und') {
+            setStatus('Could not determine the language. Try writing a longer message.');
+          } else {
+            setStatus(`Detected language: ${languageName(top.detectedLanguage)} (confidence: ${percentFormat.format(top.confidence)})`);
+          }
+        } catch (err) {
+          progress.hidden = true;
+          setStatus(`Language detection failed: ${err.message}`, true);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
