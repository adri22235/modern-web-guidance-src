+  <script>
+    (() => {
+      const textarea = document.getElementById('feedback-message');
+      const button = document.getElementById('detect-btn');
+      const progress = document.getElementById('detect-progress');
+      const status = document.getElementById('detect-status');
+
+      const displayNames = new Intl.DisplayNames([navigator.language || 'en'], { type: 'language' });
+      let detectorPromise = null;
+
+      const setStatus = (message, isError = false) => {
+        status.textContent = message;
+        status.classList.toggle('error', isError);
+      };
+
+      const languageName = (code) => {
+        try {
+          return displayNames.of(code) || code;
+        } catch {
+          return code;
+        }
+      };
+
+      const showProgress = (fraction) => {
+        const percent = Math.round(fraction * 100);
+        progress.hidden = false;
+        progress.value = percent;
+        setStatus(`Downloading language model… ${percent}%`);
+      };
+
+      const getDetector = () => {
+        if (!detectorPromise) {
+          detectorPromise = LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => showProgress(e.loaded));
+            },
+          }).catch((err) => {
+            detectorPromise = null; // allow retry on next click
+            throw err;
+          });
+        }
+        return detectorPromise;
+      };
+
+      // Check support up front so the user knows whether the feature works.
+      if (!('LanguageDetector' in self)) {
+        button.disabled = true;
+        setStatus('Language detection is not supported in this browser.', true);
+        return;
+      }
+
+      LanguageDetector.availability().then((availability) => {
+        if (availability === 'unavailable') {
+          button.disabled = true;
+          setStatus('Language detection is unavailable on this device.', true);
+        } else if (availability === 'downloadable' || availability === 'downloading') {
+          setStatus('The language model will be downloaded the first time you click Detect.');
+        }
+      }).catch(() => {
+        setStatus('Could not check language detection availability.', true);
+      });
+
+      button.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          setStatus('Please enter a message first.', true);
+          textarea.focus();
+          return;
+        }
+
+        button.disabled = true;
+        try {
+          const availability = await LanguageDetector.availability();
+          if (availability === 'unavailable') {
+            setStatus('Language detection is unavailable on this device.', true);
+            return;
+          }
+          if (availability !== 'available') {
+            showProgress(0);
+          } else {
+            setStatus('Detecting…');
+          }
+
+          const detector = await getDetector();
+          progress.hidden = true;
+          setStatus('Detecting…');
+
+          const results = await detector.detect(text);
+          const top = results.find((r) => r.detectedLanguage !== 'und') || results[0];
+
+          if (!top || top.detectedLanguage === 'und') {
+            setStatus('Sorry, we could not determine the language of your message.');
+            return;
+          }
+
+          const confidence = (top.confidence * 100).toFixed(1);
+          setStatus(`Detected language: ${languageName(top.detectedLanguage)} (${confidence}% confidence)`);
+        } catch (err) {
+          progress.hidden = true;
+          setStatus(`Language detection failed: ${err.message || err}`, true);
+        } finally {
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
+
