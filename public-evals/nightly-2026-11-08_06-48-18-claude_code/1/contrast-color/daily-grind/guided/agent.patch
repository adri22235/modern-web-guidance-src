+    /* Auto-contrast surfaces: text color follows the surface background */
+    nav,
+    .btn {
+      --surface: var(--primary);
+      color: white; /* static fallback */
+    }
+
+    footer {
+      --surface: var(--secondary);
+      color: var(--text); /* static fallback */
+    }
+
+    .btn:hover {
+      --surface: color-mix(in oklch, var(--primary), black 20%);
+    }
+
+    nav,
+    .btn,
+    footer {
+      background: var(--surface);
+    }
+
+    /* Fallback 1: relative color syntax picks black/white from surface lightness */
+    @supports (color: oklch(from red l c h)) {
+      nav,
+      .btn,
+      footer {
+        --contrast-threshold: 0.623;
+        --contrast-l: max(0, sign(var(--contrast-threshold) - l));
+        color: oklch(from var(--surface) var(--contrast-l) 0 h);
+      }
+    }
+
+    /* Preferred: native contrast-color() */
+    @supports (color: contrast-color(red)) {
+      nav,
+      .btn,
+      footer {
+        color: contrast-color(var(--surface));
+      }
+    }
+
