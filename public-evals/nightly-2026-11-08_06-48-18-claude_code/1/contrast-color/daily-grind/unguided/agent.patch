diff --git a/index.html b/index.html
index 66c9173..8412032 100644
--- a/index.html
+++ b/index.html
@@ -12,6 +12,38 @@
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+
+      /* Lightness cutoff (OKLCH, 0-1) above which a background counts as
+         "light" and gets dark text; below it gets light text. */
+      --contrast-threshold: 0.62;
+    }
+
+    /*
+     * Auto-contrast text colors.
+     * The text color is derived directly from the background variable using
+     * CSS relative color syntax, so changing --primary or --secondary (on
+     * :root or on any element, at any time) re-computes the text color with
+     * no JavaScript. The math snaps lightness to 0 (black) or 1 (white):
+     *   clamp(0, (threshold - l) * 1000, 1)
+     * The declarations are applied on each component (not cached in a :root
+     * variable) so overrides set lower in the tree are also picked up.
+     * A plain fallback color precedes each for browsers without support.
+     */
+    nav,
+    .btn {
+      color: #fff;
+      color: oklch(from var(--primary) clamp(0, (var(--contrast-threshold) - l) * 1000, 1) 0 0 / 1);
+    }
+
+    .btn:hover,
+    .btn:focus-visible {
+      color: #fff;
+      color: oklch(from var(--primary-hover) clamp(0, (var(--contrast-threshold) - l) * 1000, 1) 0 0 / 1);
+    }
+
+    footer {
+      color: var(--text);
+      color: oklch(from var(--secondary) clamp(0, (var(--contrast-threshold) - l) * 1000, 1) 0 0 / 1);
     }
 
     * {
