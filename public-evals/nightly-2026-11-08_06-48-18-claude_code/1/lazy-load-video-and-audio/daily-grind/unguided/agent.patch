+  <script>
+    (function () {
+      // ---- Hero video: respect reduced-motion and offer a pause control (WCAG 2.2.2). ----
+      var hero = document.querySelector('.hero-video');
+      var toggle = document.querySelector('.hero-toggle');
+      if (hero && toggle) {
+        var setLabel = function () {
+          var paused = hero.paused;
+          toggle.textContent = paused ? 'Play' : 'Pause';
+          toggle.setAttribute('aria-label', (paused ? 'Play' : 'Pause') + ' background video');
+        };
+        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          hero.removeAttribute('autoplay');
+          hero.pause();
+        }
+        toggle.addEventListener('click', function () {
+          if (hero.paused) { hero.play().catch(function () {}); } else { hero.pause(); }
+        });
+        hero.addEventListener('play', setLabel);
+        hero.addEventListener('pause', setLabel);
+        setLabel();
+      }
+
+      // ---- Lazy media: defer posters, sources and preloading until a player nears the viewport. ----
+      var lazyMedia = Array.prototype.slice.call(document.querySelectorAll('video.lazy-media, audio.lazy-media'));
+      if (!lazyMedia.length) return;
+
+      function hydrate(media) {
+        if (media.dataset.hydrated) return;
+        media.dataset.hydrated = 'true';
+        if (media.dataset.poster) media.setAttribute('poster', media.dataset.poster);
+        var sources = media.querySelectorAll('source[data-src]');
+        for (var i = 0; i < sources.length; i++) {
+          sources[i].setAttribute('src', sources[i].dataset.src);
+          sources[i].removeAttribute('data-src');
+        }
+        if (media.dataset.src) media.setAttribute('src', media.dataset.src);
+        media.preload = media.dataset.preload || 'metadata';
+        // Re-run source selection now that the <source> elements have URLs.
+        media.load();
+      }
+
+      // Safety net: if someone interacts with a player before it was hydrated, hydrate immediately.
+      lazyMedia.forEach(function (media) {
+        var early = function () { hydrate(media); };
+        media.addEventListener('pointerdown', early, { once: true });
+        media.addEventListener('focus', early, { once: true });
+      });
+
+      if (!('IntersectionObserver' in window)) {
+        lazyMedia.forEach(hydrate);
+        return;
+      }
+
+      var observer = new IntersectionObserver(function (entries) {
+        entries.forEach(function (entry) {
+          if (entry.isIntersecting) {
+            hydrate(entry.target);
+            observer.unobserve(entry.target);
+          }
+        });
+      }, { rootMargin: '300px 0px' });
+
+      lazyMedia.forEach(function (media) { observer.observe(media); });
+    })();
+  </script>
