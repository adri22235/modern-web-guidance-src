diff --git a/src/scripts/webmcp-tools.ts b/src/scripts/webmcp-tools.ts
new file mode 100644
index 0000000..0ca3b6b
--- /dev/null
+++ b/src/scripts/webmcp-tools.ts
@@ -0,0 +1,346 @@
+/**
+ * Imperative WebMCP tools for The DevTools Times.
+ *
+ * Site-wide tools are registered once. Article utilities are registered only
+ * while an article page is shown, and are re-registered across Astro view
+ * transitions (ClientRouter) as the user navigates.
+ *
+ * Declarative form tools (search_articles, manage_reading_list,
+ * toggle_article_bookmark) live in the React components themselves.
+ */
+import { navigate } from 'astro:transitions/client';
+import {
+  EVENTS,
+  articleUrl,
+  fetchArticles,
+  fetchReadingList,
+  isWebMCPSupported,
+  registerTool,
+  textResult,
+} from '../utils/webmcp';
+
+const DEFAULT_WPM = 230;
+
+// ---------------------------------------------------------------------------
+// Site-wide tools
+// ---------------------------------------------------------------------------
+
+function registerSiteTools() {
+  registerTool({
+    name: 'list_articles',
+    description:
+      'List the articles published on The DevTools Times, optionally filtered by category. Returns slug, title, summary, category, author, date and URL for each article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: {
+          type: 'string',
+          description: 'Optional category to filter by (case-insensitive), e.g. "Economy", "Sports", "Culture".',
+        },
+      },
+    },
+    annotations: { readOnlyHint: true },
+    execute: async ({ category }: { category?: string }) => {
+      const articles = await fetchArticles();
+      const filtered = category
+        ? articles.filter((a) => a.category?.toLowerCase() === category.trim().toLowerCase())
+        : articles;
+      const categories = [...new Set(articles.map((a) => a.category).filter(Boolean))];
+      if (filtered.length === 0) {
+        return textResult(`No articles found in category "${category}". Available categories: ${categories.join(', ')}.`);
+      }
+      return textResult({
+        count: filtered.length,
+        categories,
+        articles: filtered.map(({ image, ...a }) => ({ ...a, url: articleUrl(a.slug) })),
+      });
+    },
+  });
+
+  registerTool({
+    name: 'get_reading_list',
+    description: "Get the articles currently saved in the user's reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    annotations: { readOnlyHint: true },
+    execute: async () => {
+      const [slugs, articles] = await Promise.all([fetchReadingList(), fetchArticles()]);
+      if (slugs.length === 0) return textResult('The reading list is empty.');
+      const bySlug = new Map(articles.map((a) => [a.slug, a]));
+      return textResult({
+        count: slugs.length,
+        articles: slugs.map((slug) => {
+          const a = bySlug.get(slug);
+          return { slug, title: a?.title, summary: a?.summary, url: articleUrl(slug) };
+        }),
+      });
+    },
+  });
+
+  registerTool({
+    name: 'open_search',
+    description:
+      'Open the site search panel. This reveals the "search_articles" form tool, which can then be used to search articles.',
+    inputSchema: { type: 'object', properties: {} },
+    execute: () => {
+      window.dispatchEvent(new CustomEvent(EVENTS.openSearch));
+      return textResult('The search panel is open. Use the "search_articles" tool to run a search.');
+    },
+  });
+
+  registerTool({
+    name: 'open_reading_list',
+    description:
+      'Open the reading list panel. This reveals the "manage_reading_list" form tool, which can add or remove articles.',
+    inputSchema: { type: 'object', properties: {} },
+    execute: () => {
+      window.dispatchEvent(new CustomEvent(EVENTS.openReadingList));
+      return textResult('The reading list panel is open. Use the "manage_reading_list" tool to add or remove articles.');
+    },
+  });
+
+  registerTool({
+    name: 'open_article',
+    description: 'Navigate the browser to an article on The DevTools Times by its slug (see list_articles).',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: { type: 'string', description: 'The article slug, e.g. "housing-crisis".' },
+      },
+      required: ['slug'],
+    },
+    execute: async ({ slug }: { slug: string }) => {
+      const article = (await fetchArticles()).find((a) => a.slug === slug);
+      if (!article) return textResult(`Unknown article "${slug}". Use list_articles to find valid slugs.`, true);
+      await navigate(`${import.meta.env.BASE_URL}articles/${slug}`);
+      return textResult(`Opened "${article.title}". Article tools such as get_current_article are now available.`);
+    },
+  });
+}
+
+// ---------------------------------------------------------------------------
+// Article utilities (only on article pages)
+// ---------------------------------------------------------------------------
+
+interface ArticleContext {
+  root: HTMLElement;
+  body: HTMLElement;
+}
+
+const getArticleContext = (): ArticleContext | null => {
+  const root = document.querySelector<HTMLElement>('[data-article]');
+  const body = root?.querySelector<HTMLElement>('[data-article-body]');
+  return root && body ? { root, body } : null;
+};
+
+const normalize = (text: string | null | undefined) => (text ?? '').replace(/\s+/g, ' ').trim();
+
+const getMetadata = ({ root }: ArticleContext) => ({
+  slug: root.dataset.slug,
+  title: root.dataset.title,
+  summary: root.dataset.summary,
+  author: root.dataset.author,
+  date: root.dataset.date,
+  category: root.dataset.category,
+  tags: root.dataset.tags ? root.dataset.tags.split(',') : [],
+  url: window.location.href,
+});
+
+const getParagraphs = ({ body }: ArticleContext) =>
+  [...body.querySelectorAll<HTMLElement>('p, li, blockquote, h2, h3, h4')]
+    .map((el) => ({ el, text: normalize(el.textContent) }))
+    .filter(({ text }) => text.length > 0);
+
+const getHeadings = ({ body }: ArticleContext) =>
+  [...body.querySelectorAll<HTMLHeadingElement>('h2, h3, h4')].map((el, index) => ({
+    el,
+    index,
+    level: Number(el.tagName.slice(1)),
+    text: normalize(el.textContent),
+    id: el.id || undefined,
+  }));
+
+const countWords = (text: string) => (text.match(/\S+/g) ?? []).length;
+
+function flash(el: HTMLElement) {
+  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  const previous = el.style.backgroundColor;
+  el.style.transition = 'background-color 0.6s';
+  el.style.backgroundColor = 'rgb(252 211 77 / 0.5)';
+  setTimeout(() => {
+    el.style.backgroundColor = previous;
+  }, 1500);
+}
+
+function registerArticleTools(ctx: ArticleContext): Array<() => void> {
+  return [
+    registerTool({
+      name: 'get_current_article',
+      description:
+        'Get the article currently open in the browser: title, summary, author, date, category, tags, URL and the full body text.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          maxCharacters: {
+            type: 'integer',
+            minimum: 100,
+            description: 'Optional maximum number of body characters to return. The text is truncated beyond this.',
+          },
+        },
+      },
+      annotations: { readOnlyHint: true },
+      execute: ({ maxCharacters }: { maxCharacters?: number }) => {
+        let text = getParagraphs(ctx).map((p) => p.text).join('\n\n');
+        const truncated = typeof maxCharacters === 'number' && text.length > maxCharacters;
+        if (truncated) text = `${text.slice(0, maxCharacters)}…`;
+        return textResult({ ...getMetadata(ctx), truncated, body: text });
+      },
+    }),
+
+    registerTool({
+      name: 'get_article_outline',
+      description: 'Get the section headings of the current article, in order, with their level and index.',
+      inputSchema: { type: 'object', properties: {} },
+      annotations: { readOnlyHint: true },
+      execute: () => {
+        const headings = getHeadings(ctx).map(({ el, ...h }) => h);
+        return textResult(
+          headings.length
+            ? { title: ctx.root.dataset.title, headings }
+            : `"${ctx.root.dataset.title}" has no section headings; it is a single continuous text.`,
+        );
+      },
+    }),
+
+    registerTool({
+      name: 'estimate_reading_time',
+      description: 'Estimate how long it takes to read the current article, based on its word count.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          wordsPerMinute: {
+            type: 'integer',
+            minimum: 50,
+            maximum: 1000,
+            description: `Reading speed in words per minute. Defaults to ${DEFAULT_WPM}.`,
+          },
+        },
+      },
+      annotations: { readOnlyHint: true },
+      execute: ({ wordsPerMinute = DEFAULT_WPM }: { wordsPerMinute?: number }) => {
+        const words = countWords(ctx.body.textContent ?? '');
+        const minutes = Math.max(1, Math.round(words / wordsPerMinute));
+        return textResult({ words, wordsPerMinute, minutes, label: `${minutes} min read` });
+      },
+    }),
+
+    registerTool({
+      name: 'find_in_article',
+      description:
+        'Find passages in the current article that contain the given text (case-insensitive). Returns the matching paragraphs and optionally scrolls to and highlights the first match.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: { type: 'string', description: 'The text to look for.' },
+          highlight: {
+            type: 'boolean',
+            description: 'Scroll to and briefly highlight the first match. Defaults to false.',
+          },
+        },
+        required: ['query'],
+      },
+      execute: ({ query, highlight = false }: { query: string; highlight?: boolean }) => {
+        const needle = normalize(query).toLowerCase();
+        if (!needle) return textResult('Please provide some text to find.', true);
+        const matches = getParagraphs(ctx).filter((p) => p.text.toLowerCase().includes(needle));
+        if (matches.length === 0) return textResult(`"${query}" does not appear in this article.`);
+        if (highlight) flash(matches[0].el);
+        return textResult({ query, count: matches.length, passages: matches.map((m) => m.text) });
+      },
+    }),
+
+    registerTool({
+      name: 'scroll_to_section',
+      description:
+        'Scroll the page to a section of the current article. Identify the section by heading text (see get_article_outline), or use "top", "body" or "related" to jump to the start, the article body, or the related articles.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          section: {
+            type: 'string',
+            description: 'Heading text (partial, case-insensitive), or one of "top", "body", "related".',
+          },
+        },
+        required: ['section'],
+      },
+      execute: ({ section }: { section: string }) => {
+        const key = normalize(section).toLowerCase();
+        if (key === 'top') {
+          window.scrollTo({ top: 0, behavior: 'smooth' });
+          return textResult('Scrolled to the top of the page.');
+        }
+        if (key === 'body') {
+          flash(ctx.body);
+          return textResult('Scrolled to the article body.');
+        }
+        if (key === 'related') {
+          const related = ctx.root.nextElementSibling as HTMLElement | null;
+          if (!related) return textResult('This page has no related articles section.', true);
+          related.scrollIntoView({ behavior: 'smooth', block: 'start' });
+          return textResult('Scrolled to the related articles.');
+        }
+        const heading = getHeadings(ctx).find((h) => h.text.toLowerCase().includes(key));
+        if (!heading) return textResult(`No section matching "${section}". Use get_article_outline to list sections.`, true);
+        flash(heading.el);
+        return textResult(`Scrolled to "${heading.text}".`);
+      },
+    }),
+
+    registerTool({
+      name: 'get_article_share_link',
+      description:
+        'Get a shareable link for the current article, optionally copying it to the clipboard together with the headline.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          copyToClipboard: { type: 'boolean', description: 'Also copy the link to the clipboard. Defaults to false.' },
+        },
+      },
+      execute: async ({ copyToClipboard = false }: { copyToClipboard?: boolean }) => {
+        const url = `${window.location.origin}${window.location.pathname}`;
+        const title = ctx.root.dataset.title ?? document.title;
+        let copied = false;
+        if (copyToClipboard) {
+          try {
+            await navigator.clipboard.writeText(`${title}\n${url}`);
+            copied = true;
+          } catch {
+            copied = false;
+          }
+        }
+        return textResult({ title, url, ...(copyToClipboard ? { copied } : {}) });
+      },
+    }),
+  ];
+}
+
+// ---------------------------------------------------------------------------
+// Lifecycle
+// ---------------------------------------------------------------------------
+
+if (isWebMCPSupported()) {
+  registerSiteTools();
+
+  let unregisterArticleTools: Array<() => void> = [];
+  const teardown = () => {
+    unregisterArticleTools.forEach((unregister) => unregister());
+    unregisterArticleTools = [];
+  };
+
+  // astro:page-load fires on the initial load and after every view transition.
+  document.addEventListener('astro:page-load', () => {
+    teardown();
+    const ctx = getArticleContext();
+    if (ctx) unregisterArticleTools = registerArticleTools(ctx);
+  });
+  document.addEventListener('astro:before-swap', teardown);
+}
