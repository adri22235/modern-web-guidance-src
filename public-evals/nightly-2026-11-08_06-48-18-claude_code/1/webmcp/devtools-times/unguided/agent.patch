@@ -0,0 +1,146 @@
+/**
+ * Small helpers around the WebMCP API (navigator.modelContext) shared by the
+ * imperative tool registrations and the declarative tool forms.
+ */
+import type React from 'react';
+
+export const EVENTS = {
+  openSearch: 'devtools-times:open-search',
+  openReadingList: 'devtools-times:open-reading-list',
+  readingListChanged: 'devtools-times:reading-list-changed',
+} as const;
+
+export const isWebMCPSupported = (): boolean =>
+  typeof navigator !== 'undefined' && typeof navigator.modelContext?.registerTool === 'function';
+
+export const textResult = (data: unknown, isError = false): ModelContextToolResult => ({
+  content: [{ type: 'text', text: typeof data === 'string' ? data : JSON.stringify(data, null, 2) }],
+  ...(isError ? { isError: true } : {}),
+});
+
+/**
+ * Registers a tool and returns a function that unregisters it. Supports both the
+ * AbortSignal-based and the unregisterTool()/handle-based variants of the API.
+ */
+export function registerTool(tool: ModelContextTool): () => void {
+  const modelContext = navigator.modelContext;
+  if (!modelContext?.registerTool) return () => {};
+
+  const controller = new AbortController();
+  const wrapped: ModelContextTool = {
+    ...tool,
+    execute: async (input, client) => {
+      try {
+        return await tool.execute(input ?? {}, client);
+      } catch (error) {
+        return textResult(`Error: ${error instanceof Error ? error.message : String(error)}`, true);
+      }
+    },
+  };
+
+  let handle: unknown;
+  try {
+    handle = modelContext.registerTool(wrapped, { signal: controller.signal });
+  } catch (error) {
+    console.warn(`[WebMCP] Failed to register tool "${tool.name}":`, error);
+    return () => {};
+  }
+
+  return () => {
+    controller.abort();
+    try {
+      (handle as { unregister?: () => void } | undefined)?.unregister?.();
+    } catch {}
+    try {
+      modelContext.unregisterTool?.(tool.name);
+    } catch {}
+  };
+}
+
+/**
+ * Handles a submit of a declarative tool form. When the submit came from an
+ * agent, the result of `handler` is returned to the agent via respondWith().
+ */
+export function handleToolFormSubmit(
+  event: React.FormEvent<HTMLFormElement>,
+  handler: (formData: FormData) => unknown | Promise<unknown>,
+) {
+  event.preventDefault();
+  const nativeEvent = event.nativeEvent as AgentSubmitEvent;
+  const result = Promise.resolve()
+    .then(() => handler(new FormData(event.currentTarget)))
+    .catch((error) => textResult(`Error: ${error instanceof Error ? error.message : String(error)}`, true));
+  if (nativeEvent.agentInvoked && typeof nativeEvent.respondWith === 'function') {
+    nativeEvent.respondWith(result);
+  }
+  return result;
+}
+
+const apiUrl = (path: string) => `${import.meta.env.BASE_URL}${path}`;
+
+export interface ArticleSummary {
+  slug: string;
+  title: string;
+  summary: string;
+  category?: string;
+  author?: string;
+  date?: string;
+  image?: string;
+}
+
+let articlesPromise: Promise<ArticleSummary[]> | null = null;
+export function fetchArticles(): Promise<ArticleSummary[]> {
+  articlesPromise ??= fetch(apiUrl('api/articles.json'))
+    .then((response) => {
+      if (!response.ok) throw new Error(`Failed to load articles (${response.status})`);
+      return response.json();
+    })
+    .catch((error) => {
+      articlesPromise = null;
+      throw error;
+    });
+  return articlesPromise;
+}
+
+export async function fetchReadingList(): Promise<string[]> {
+  const response = await fetch(apiUrl('api/reading-list.json'));
+  if (!response.ok) throw new Error(`Failed to load reading list (${response.status})`);
+  const data = await response.json();
+  return data.readingList ?? [];
+}
+
+/** The API toggles membership, so only POST when the state actually needs to change. */
+export async function setReadingListMembership(slug: string, saved: boolean): Promise<string[]> {
+  const current = await fetchReadingList();
+  if (current.includes(slug) === saved) return current;
+  const response = await fetch(apiUrl('api/reading-list.json'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  if (!response.ok) throw new Error(`Failed to update reading list (${response.status})`);
+  const data = await response.json();
+  const readingList: string[] = data.readingList ?? [];
+  window.dispatchEvent(new CustomEvent(EVENTS.readingListChanged, { detail: { readingList } }));
+  return readingList;
+}
+
+export function searchArticles(articles: ArticleSummary[], query: string, limit = 10) {
+  const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
+  if (terms.length === 0) return [];
+  return articles
+    .map((article) => {
+      const title = article.title.toLowerCase();
+      const haystack = `${title} ${article.summary.toLowerCase()} ${(article.category ?? '').toLowerCase()}`;
+      if (!terms.every((term) => haystack.includes(term))) return null;
+      const score = terms.reduce((sum, term) => sum + (title.includes(term) ? 2 : 1), 0);
+      return { article, score };
+    })
+    .filter((match): match is { article: ArticleSummary; score: number } => match !== null)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, limit)
+    .map(({ article }) => ({ ...article, url: articleUrl(article.slug) }));
+}
+
+export const articleUrl = (slug: string) =>
+  new URL(`${import.meta.env.BASE_URL}articles/${slug}`, window.location.origin).href;
