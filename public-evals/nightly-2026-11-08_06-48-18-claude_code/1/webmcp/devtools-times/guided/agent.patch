diff --git a/src/components/ArticleAgentTools.tsx b/src/components/ArticleAgentTools.tsx
new file mode 100644
index 0000000..0c2f600
--- /dev/null
+++ b/src/components/ArticleAgentTools.tsx
@@ -0,0 +1,168 @@
+import { useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+/**
+ * Client-side article utilities exposed as WebMCP tools on article pages.
+ * Reads the rendered article body (`[data-article-body]`). Renders nothing.
+ */
+
+interface Props {
+  article: {
+    slug: string;
+    title: string;
+    summary: string;
+    author: string;
+    date: string;
+    category: string;
+    tags: string[];
+    readingTime?: number;
+  };
+}
+
+const TEXT_SIZES = ['small', 'medium', 'large', 'x-large'] as const;
+type TextSize = (typeof TEXT_SIZES)[number];
+const TEXT_SIZE_VALUES: Record<TextSize, string> = {
+  small: '0.875rem',
+  medium: '1rem',
+  large: '1.125rem',
+  'x-large': '1.25rem',
+};
+const TEXT_SIZE_KEY = 'article-text-size';
+const WORDS_PER_MINUTE = 230;
+
+const getBody = () => document.querySelector<HTMLElement>('[data-article-body]');
+
+/** Top-level blocks of the article body (paragraphs, headings, lists, quotes). */
+function getBlocks(): HTMLElement[] {
+  const body = getBody();
+  if (!body) return [];
+  return Array.from(body.children).filter(
+    (el): el is HTMLElement => el instanceof HTMLElement && (el.textContent ?? '').trim().length > 0,
+  );
+}
+
+const blockText = (el: HTMLElement) => (el.textContent ?? '').replace(/\s+/g, ' ').trim();
+const isHeading = (el: HTMLElement) => /^H[1-6]$/.test(el.tagName);
+
+function applyTextSize(size: TextSize) {
+  const body = getBody();
+  if (!body) return;
+  body.style.fontSize = TEXT_SIZE_VALUES[size];
+}
+
+function readSavedTextSize(): TextSize | null {
+  try {
+    const saved = localStorage.getItem(TEXT_SIZE_KEY);
+    return TEXT_SIZES.includes(saved as TextSize) ? (saved as TextSize) : null;
+  } catch {
+    return null;
+  }
+}
+
+export default function ArticleAgentTools({ article }: Props) {
+  // Restore the reader's preferred text size.
+  useEffect(() => {
+    const saved = readSavedTextSize();
+    if (saved) applyTextSize(saved);
+  }, []);
+
+  useWebMCP({
+    name: 'get-article-content',
+    description:
+      'Returns the article open on this page: its metadata, full text split into numbered blocks, section headings, word count and reading time. Use to summarize, quote or answer questions about the article.',
+    inputSchema: { type: 'object', properties: {} },
+    execute() {
+      const blocks = getBlocks();
+      if (blocks.length === 0) return { error: 'The article body is not available on this page.' };
+      const texts = blocks.map(blockText);
+      const wordCount = texts.join(' ').split(/\s+/).filter(Boolean).length;
+      return {
+        ...article,
+        url: location.href,
+        wordCount,
+        readingTimeMinutes: article.readingTime ?? Math.max(1, Math.round(wordCount / WORDS_PER_MINUTE)),
+        sections: blocks
+          .map((el, index) => ({ index, el }))
+          .filter(({ el }) => isHeading(el))
+          .map(({ index, el }) => ({ index, heading: blockText(el) })),
+        blocks: texts.map((text, index) => ({ index, text })),
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ text: string }>({
+    name: 'find-in-article',
+    description:
+      'Finds the passages in the article open on this page that contain a word or phrase. Returns the matching block numbers and their text.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        text: { type: 'string', description: 'Word or phrase to look for, matched case-insensitively.' },
+      },
+      required: ['text'],
+    },
+    execute({ text }) {
+      if (typeof text !== 'string' || !text.trim()) return { error: 'Pass a word or phrase to find.' };
+      const needle = text.trim().toLowerCase();
+      const matches = getBlocks()
+        .map((el, index) => ({ index, text: blockText(el) }))
+        .filter((block) => block.text.toLowerCase().includes(needle));
+      return { query: text, count: matches.length, matches };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ index: number }>({
+    name: 'scroll-to-article-passage',
+    description: 'Scrolls the page to a passage or section of the open article and briefly highlights it for the reader.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        index: {
+          type: 'integer',
+          minimum: 0,
+          description: 'Block number returned by get-article-content or find-in-article.',
+        },
+      },
+      required: ['index'],
+    },
+    execute({ index }) {
+      const blocks = getBlocks();
+      if (!Number.isInteger(index) || index < 0 || index >= blocks.length) {
+        return { error: `Block number must be a whole number from 0 to ${blocks.length - 1}.` };
+      }
+      const target = blocks[index];
+      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
+      target.classList.add('agent-highlight');
+      setTimeout(() => target.classList.remove('agent-highlight'), 2500);
+      return { message: `Scrolled to block ${index}.`, text: blockText(target) };
+    },
+  });
+
+  useWebMCP<{ size: TextSize }>({
+    name: 'set-article-text-size',
+    description: "Changes the article body text size to make it easier to read. The choice is remembered on this device.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        size: { type: 'string', enum: [...TEXT_SIZES], description: 'Text size for the article body.' },
+      },
+      required: ['size'],
+    },
+    execute({ size }) {
+      if (!TEXT_SIZES.includes(size)) return { error: 'Unsupported text size.', sizes: TEXT_SIZES };
+      if (!getBody()) return { error: 'The article body is not available on this page.' };
+      applyTextSize(size);
+      try {
+        localStorage.setItem(TEXT_SIZE_KEY, size);
+      } catch {
+        // Storage may be unavailable (private mode); the change still applies to this page.
+      }
+      return { message: `Article text size set to ${size}.` };
+    },
+  });
+
+  return null;
+}
