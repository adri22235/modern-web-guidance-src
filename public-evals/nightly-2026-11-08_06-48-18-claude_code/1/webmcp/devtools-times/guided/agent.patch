diff --git a/src/pages/reading-list.astro b/src/pages/reading-list.astro
new file mode 100644
index 0000000..328dc1a
--- /dev/null
+++ b/src/pages/reading-list.astro
@@ -0,0 +1,113 @@
+---
+import Layout from '../layouts/Layout.astro';
+import { getCollection } from 'astro:content';
+import { sortByNewest, toArticleSummary } from '../utils/articles';
+
+const baseUrl = import.meta.env.BASE_URL;
+const articles = sortByNewest((await getCollection('articles')).map(toArticleSummary));
+
+// Progressive enhancement: the forms below work without JavaScript via POST + redirect.
+if (Astro.request.method === 'POST') {
+  const formData = await Astro.request.formData();
+  const intent = formData.get('intent');
+  const slug = String(formData.get('slug') ?? '');
+  if (articles.some((article) => article.slug === slug)) {
+    const current: string[] = (await Astro.session?.get('readingList')) || [];
+    const next =
+      intent === 'remove'
+        ? current.filter((item) => item !== slug)
+        : current.includes(slug)
+          ? current
+          : [...current, slug];
+    await Astro.session?.set('readingList', next);
+  }
+  return Astro.redirect(`${baseUrl}reading-list`, 303);
+}
+
+const readingList: string[] = (await Astro.session?.get('readingList')) || [];
+const savedArticles = readingList
+  .map((slug) => articles.find((article) => article.slug === slug))
+  .filter((article) => article !== undefined);
+const unsavedArticles = articles.filter((article) => !readingList.includes(article.slug));
+---
+
+<Layout title="Reading List | The DevTools Times">
+  <section class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-brand text-gray-900 mb-6">Your Reading List</h1>
+
+    {savedArticles.length === 0 ? (
+      <p class="text-gray-500 py-4">Your reading list is empty.</p>
+    ) : (
+      <ul class="space-y-2 mb-8">
