diff --git a/src/components/SiteAgentTools.tsx b/src/components/SiteAgentTools.tsx
new file mode 100644
index 0000000..2d3166f
--- /dev/null
+++ b/src/components/SiteAgentTools.tsx
@@ -0,0 +1,108 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { navigate } from 'astro:transitions/client';
+import type { ArticleSummary } from '../utils/articles';
+
+/**
+ * Site-wide WebMCP tools, available on every page. Renders nothing.
+ * Search and reading-list editing are exposed declaratively by their forms
+ * (see Header.astro, reading-list.astro and scripts/agent-forms.ts).
+ */
+
+interface Props {
+  categories: string[];
+}
+
+const BASE_URL = import.meta.env.BASE_URL;
+const absoluteUrl = (path: string) => new URL(`${BASE_URL}${path}`, location.origin).href;
+
+async function fetchArticles(signal: AbortSignal): Promise<ArticleSummary[]> {
+  const response = await fetch(`${BASE_URL}api/articles.json`, { signal });
+  if (!response.ok) throw new Error(`Could not load articles (status ${response.status}).`);
+  return response.json();
+}
+
+const toListing = ({ slug, title, summary, category, author, date }: ArticleSummary) => ({
+  slug,
+  title,
+  summary,
+  category,
+  author,
+  date,
+  url: absoluteUrl(`articles/${slug}`),
+});
+
+export default function SiteAgentTools({ categories }: Props) {
+  useWebMCP<{ category?: string; limit?: number }>({
+    name: 'list-articles',
+    description:
+      'Lists published articles, newest first, optionally limited to one section. Use to browse what the paper has published rather than to search by keyword.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: { type: 'string', enum: categories, description: 'Only include articles from this section.' },
+        limit: { type: 'integer', minimum: 1, maximum: 50, default: 10, description: 'How many articles to return.' },
+      },
+    },
+    async execute({ category, limit = 10 }, { signal }) {
+      if (category !== undefined && !categories.includes(category)) {
+        return { error: `Unknown section "${category}".`, sections: categories };
+      }
+      if (!Number.isInteger(limit) || limit < 1 || limit > 50) {
+        return { error: 'Limit must be a whole number from 1 to 50.' };
+      }
+      const articles = await fetchArticles(signal);
+      const filtered = category ? articles.filter((article) => article.category === category) : articles;
+      const sorted = [...filtered].sort((a, b) => b.date.localeCompare(a.date));
+      return { total: filtered.length, articles: sorted.slice(0, limit).map(toListing) };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP({
+    name: 'get-reading-list',
+    description: "Returns the articles the reader has saved to their reading list.",
+    inputSchema: { type: 'object', properties: {} },
+    async execute(_args, { signal }) {
+      const [listResponse, articles] = await Promise.all([
+        fetch(`${BASE_URL}api/reading-list.json`, { signal }),
+        fetchArticles(signal),
+      ]);
+      if (!listResponse.ok) throw new Error(`Could not load the reading list (status ${listResponse.status}).`);
+      const { readingList } = (await listResponse.json()) as { readingList: string[] };
+      const saved = readingList
+        .map((slug) => articles.find((article) => article.slug === slug))
+        .filter((article): article is ArticleSummary => article !== undefined)
+        .map(toListing);
+      return { count: saved.length, articles: saved, manageUrl: absoluteUrl('reading-list') };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ slug: string }>({
+    name: 'open-article',
+    description: 'Opens an article in the current tab so the reader can see it.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'The article identifier returned by search-articles or list-articles, e.g. housing-crisis.',
+        },
+      },
+      required: ['slug'],
+    },
+    async execute({ slug }, { signal }) {
+      if (typeof slug !== 'string' || !slug) return { error: 'Pass the slug of an article.' };
+      const articles = await fetchArticles(signal);
+      const article = articles.find((item) => item.slug === slug);
+      if (!article) {
+        return { error: `No article found with slug "${slug}".`, availableSlugs: articles.map((item) => item.slug) };
+      }
+      signal.throwIfAborted();
+      await navigate(`${BASE_URL}articles/${slug}`);
+      return { message: `Opened "${article.title}".`, url: absoluteUrl(`articles/${slug}`) };
+    },
+  });
+
+  return null;
+}
