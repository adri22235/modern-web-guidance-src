+++ b/src/pages/search.astro
@@ -0,0 +1,50 @@
+---
+import Layout from '../layouts/Layout.astro';
+import { getCollection } from 'astro:content';
+import { searchArticles, sortByNewest, toArticleSummary } from '../utils/articles';
+
+const baseUrl = import.meta.env.BASE_URL;
+const query = (Astro.url.searchParams.get('q') ?? '').trim();
+const articles = (await getCollection('articles')).map(toArticleSummary);
+const results = query ? sortByNewest(searchArticles(articles, query)) : [];
+---
+
+<Layout title={query ? `Search: ${query} | The DevTools Times` : 'Search | The DevTools Times'}>
+  <section class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-brand text-gray-900 mb-6">Search</h1>
+
+    <form role="search" action={`${baseUrl}search`} method="get" class="flex gap-2 mb-8">
+      <label for="search-page-query" class="sr-only">Search articles</label>
+      <input
+        id="search-page-query"
+        type="search"
+        name="q"
+        value={query}
+        required
+        placeholder="Search for articles..."
+        class="flex-grow p-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent"
+      />
+      <button type="submit" class="bg-gray-800 text-white text-sm font-semibold py-2 px-4 rounded hover:bg-gray-700">
+        Search
+      </button>
+    </form>
+
+    {query && (
+      <p class="text-sm text-gray-500 mb-4" role="status">
+        {results.length} {results.length === 1 ? 'result' : 'results'} for “{query}”
+      </p>
+    )}
+
+    <ul class="space-y-2">
+      {results.map((article) => (
+        <li>
+          <a href={`${baseUrl}articles/${article.slug}`} class="block hover:bg-gray-100 p-4 rounded-md transition-colors">
+            <p class="text-xs font-semibold text-gray-500 uppercase">{article.category}</p>
+            <h2 class="font-bold text-lg text-gray-800">{article.title}</h2>
+            <p class="text-sm text-gray-600">{article.summary}</p>
+          </a>
+        </li>
+      ))}
+    </ul>
+  </section>
+</Layout>
diff --git a/src/scripts/agent-forms.ts b/src/scripts/agent-forms.ts
new file mode 100644
index 0000000..d0870db
--- /dev/null
+++ b/src/scripts/agent-forms.ts
@@ -0,0 +1,90 @@
+/**
+ * Handles submissions of declarative WebMCP forms (`<form toolname="…">`) made by
+ * an AI agent: instead of navigating, the result is returned to the agent through
+ * `SubmitEvent.respondWith()`. Normal user submissions are left untouched.
+ *
+ * The listener lives on `document`, so it survives Astro ClientRouter page swaps.
+ */
+import { navigate } from 'astro:transitions/client';
+import type { ArticleSummary } from '../utils/articles';
+
+type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+type FormToolHandler = (form: HTMLFormElement, data: FormData) => Promise<unknown>;
+
+const BASE_URL = import.meta.env.BASE_URL;
+const articleUrl = (slug: string) => new URL(`${BASE_URL}articles/${slug}`, location.origin).href;
+
+async function fetchJson<T>(input: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(input, init);
+  const body = await response.json();
+  if (!response.ok) throw new Error(body?.error ?? `Request failed with status ${response.status}`);
+  return body as T;
+}
+
+async function updateReadingList(data: FormData, action: 'add' | 'remove') {
+  const slug = String(data.get('slug') ?? '');
+  if (!slug) return { error: 'Choose an article.' };
+  try {
+    const { readingList } = await fetchJson<{ readingList: string[] }>(`${BASE_URL}api/reading-list.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ slug, action }),
+    });
+    // Re-render the reading list page so the user sees the change before the agent gets the result.
+    await navigate(location.href, { history: 'replace' });
+    return {
+      message: action === 'add' ? `Saved "${slug}" to the reading list.` : `Removed "${slug}" from the reading list.`,
+      readingList: readingList.map((item) => ({ slug: item, url: articleUrl(item) })),
+    };
+  } catch (error) {
+    return { error: error instanceof Error ? error.message : String(error) };
+  }
+}
+
+const handlers: Record<string, FormToolHandler> = {
+  'search-articles': async (_form, data) => {
+    const query = String(data.get('q') ?? '').trim();
+    if (!query) return { error: 'Enter at least one keyword to search for.' };
+    try {
+      const results = await fetchJson<ArticleSummary[]>(`${BASE_URL}api/articles.json?q=${encodeURIComponent(query)}`);
+      return {
+        query,
+        count: results.length,
+        results: results.map(({ slug, title, summary, category, author, date }) => ({
+          slug,
+          title,
+          summary,
+          category,
+          author,
+          date,
+          url: articleUrl(slug),
+        })),
+        searchPageUrl: new URL(`${BASE_URL}search?q=${encodeURIComponent(query)}`, location.origin).href,
+      };
+    } catch (error) {
+      return { error: error instanceof Error ? error.message : String(error) };
+    }
+  },
+  'add-to-reading-list': (_form, data) => updateReadingList(data, 'add'),
+  'remove-from-reading-list': (_form, data) => updateReadingList(data, 'remove'),
+};
+
+document.addEventListener(
+  'submit',
+  (event) => {
+    const submitEvent = event as AgentSubmitEvent;
+    const form = submitEvent.target;
+    if (!submitEvent.agentInvoked || !(form instanceof HTMLFormElement)) return;
+    const handler = handlers[form.getAttribute('toolname') ?? ''];
+    if (!handler || !submitEvent.respondWith) return;
+
+    // Capture phase + preventDefault keeps ClientRouter from navigating.
+    submitEvent.preventDefault();
+    submitEvent.respondWith(handler(form, new FormData(form)));
+  },
+  { capture: true },
+);
