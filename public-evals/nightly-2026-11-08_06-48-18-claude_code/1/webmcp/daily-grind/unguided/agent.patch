index 0000000..8b051c5
--- /dev/null
+++ b/assets/app.js
@@ -0,0 +1,647 @@
+// The Daily Grind — Seasonal Favorites, order panel, and WebMCP browser tools.
+//
+// The page exposes client-side tools through the WebMCP API
+// (`navigator.modelContext`) so that AI agents running in the browser can
+// discover and call them. If the API is missing, the page works as usual and
+// the same functions are still available on `window.dailyGrindTools`.
+
+// ---------------------------------------------------------------------------
+// Menu data
+// ---------------------------------------------------------------------------
+
+const SIZES = {
+  small: { label: 'Small (8oz)', priceDelta: -0.5 },
+  medium: { label: 'Medium (12oz)', priceDelta: 0 },
+  large: { label: 'Large (16oz)', priceDelta: 0.75 },
+};
+
+const MILKS = {
+  none: { label: 'No milk', price: 0 },
+  whole: { label: 'Whole milk', price: 0 },
+  skim: { label: 'Skim milk', price: 0 },
+  oat: { label: 'Oat milk', price: 0.6 },
+  almond: { label: 'Almond milk', price: 0.6 },
+  soy: { label: 'Soy milk', price: 0.5 },
+};
+
+const EXTRAS = {
+  extra_shot: { label: 'Extra espresso shot', price: 0.9 },
+  maple_drizzle: { label: 'Maple drizzle', price: 0.5 },
+  vanilla_syrup: { label: 'Vanilla syrup', price: 0.5 },
+  cinnamon: { label: 'Cinnamon dust', price: 0 },
+  sweet_cream: { label: 'Sweet cream cold foam', price: 0.8 },
+};
+
+const SEASONAL_MENU = [
+  {
+    id: 'maple-oat-latte',
+    name: 'Maple Oat Latte',
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    basePrice: 5.25,
+    temperature: 'hot',
+    caffeine: 'medium',
+    tags: ['seasonal', 'dairy-free', 'sweet'],
+    defaultMilk: 'oat',
+    allowedMilks: ['oat', 'almond', 'soy', 'whole', 'skim'],
+    detailsUrl: '/menu/seasonal',
+    image:
+      'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=70',
+  },
+  {
+    id: 'dark-roast-espresso',
+    name: 'Dark Roast Espresso',
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    basePrice: 3.25,
+    temperature: 'hot',
+    caffeine: 'high',
+    tags: ['seasonal', 'dairy-free', 'bold'],
+    defaultMilk: 'none',
+    allowedMilks: ['none'],
+    detailsUrl: '/menu/espresso',
+    image:
+      'https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?auto=format&fit=crop&w=600&q=70',
+  },
+  {
+    id: 'cold-brew',
+    name: 'Cold Brew',
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    basePrice: 4.5,
+    temperature: 'iced',
+    caffeine: 'high',
+    tags: ['seasonal', 'dairy-free', 'smooth'],
+    defaultMilk: 'none',
+    allowedMilks: ['none', 'whole', 'skim', 'oat', 'almond', 'soy'],
+    detailsUrl: '/menu/cold-brew',
+    image:
+      'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=70',
+  },
+];
+
+const money = (n) => `$${n.toFixed(2)}`;
+const round2 = (n) => Math.round(n * 100) / 100;
+
+function findDrink(idOrName) {
+  if (typeof idOrName !== 'string') return undefined;
+  const key = idOrName.trim().toLowerCase();
+  return SEASONAL_MENU.find(
+    (d) => d.id === key || d.name.toLowerCase() === key,
+  );
+}
+
+function publicDrink(d) {
+  return {
+    id: d.id,
+    name: d.name,
+    description: d.description,
+    price: d.basePrice,
+    priceBySize: Object.fromEntries(
+      Object.entries(SIZES).map(([k, s]) => [k, round2(d.basePrice + s.priceDelta)]),
+    ),
+    temperature: d.temperature,
+    caffeine: d.caffeine,
+    tags: d.tags,
+    defaultMilk: d.defaultMilk,
+    allowedMilks: d.allowedMilks,
+    detailsUrl: new URL(d.detailsUrl, location.href).href,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Rendering: menu cards
+// ---------------------------------------------------------------------------
+
+const grid = document.getElementById('seasonal-grid');
+
+function renderMenu() {
+  grid.replaceChildren(
+    ...SEASONAL_MENU.map((d) => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      card.dataset.drinkId = d.id;
+
+      const img = document.createElement('img');
+      img.src = d.image;
+      img.alt = d.name;
+      img.loading = 'lazy';
+      img.addEventListener('error', () => img.remove());
+
+      const body = document.createElement('div');
+      body.className = 'card-body';
+
+      const h3 = document.createElement('h3');
+      h3.textContent = d.name;
+
+      const p = document.createElement('p');
+      p.textContent = d.description;
+
+      const tags = document.createElement('div');
+      tags.className = 'tags';
+      for (const t of d.tags) {
+        const span = document.createElement('span');
+        span.className = 'tag';
+        span.textContent = t;
+        tags.append(span);
+      }
+
+      const price = document.createElement('div');
+      price.className = 'price';
+      price.textContent = `from ${money(d.basePrice + SIZES.small.priceDelta)}`;
+
+      const actions = document.createElement('div');
+      actions.className = 'card-actions';
+
+      const details = document.createElement('a');
+      details.href = d.detailsUrl;
+      details.className = 'btn btn-ghost';
+      details.textContent = 'View Details';
+
+      const add = document.createElement('button');
+      add.type = 'button';
+      add.className = 'btn';
+      add.textContent = 'Add to Order';
+      add.addEventListener('click', () => {
+        addToOrder({ drinkId: d.id });
+      });
+
+      actions.append(details, add);
+      body.append(h3, p, tags, price, actions);
+      card.append(img, body);
+      return card;
+    }),
+  );
+}
+
+function highlightDrink(drinkId) {
+  const card = grid.querySelector(`[data-drink-id="${CSS.escape(drinkId)}"]`);
+  if (!card) return false;
+  grid.querySelectorAll('.card.highlight').forEach((c) => c.classList.remove('highlight'));
+  card.classList.add('highlight');
+  card.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  clearTimeout(highlightDrink.timer);
+  highlightDrink.timer = setTimeout(() => card.classList.remove('highlight'), 4000);
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Order state
+// ---------------------------------------------------------------------------
+
+const STORAGE_KEY = 'daily-grind-order';
+let order = loadOrder();
+let nextLineId = order.reduce((m, l) => Math.max(m, l.lineId), 0) + 1;
+
+function loadOrder() {
+  try {
+    const raw = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
+    return Array.isArray(raw) ? raw.filter((l) => findDrink(l.drinkId)) : [];
+  } catch {
+    return [];
+  }
+}
+
+function saveOrder() {
+  try {
+    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(order));
+  } catch {
+    /* storage unavailable; keep in memory only */
+  }
+}
+
+function linePrice(line) {
+  const d = findDrink(line.drinkId);
+  const unit =
+    d.basePrice +
+    SIZES[line.size].priceDelta +
+    MILKS[line.milk].price +
+    line.extras.reduce((s, e) => s + EXTRAS[e].price, 0);
+  return { unit: round2(unit), total: round2(unit * line.quantity) };
+}
+
+function orderSummary() {
+  const items = order.map((l) => {
+    const d = findDrink(l.drinkId);
+    const p = linePrice(l);
+    return {
+      lineId: l.lineId,
+      drinkId: l.drinkId,
+      name: d.name,
+      size: l.size,
+      milk: l.milk,
+      extras: l.extras,
+      quantity: l.quantity,
+      unitPrice: p.unit,
+      lineTotal: p.total,
+    };
+  });
+  const total = round2(items.reduce((s, i) => s + i.lineTotal, 0));
+  return { items, itemCount: items.reduce((s, i) => s + i.quantity, 0), total };
+}
+
+class ToolInputError extends Error {}
+
+function addToOrder({ drinkId, size = 'medium', milk, extras = [], quantity = 1 }) {
+  const d = findDrink(drinkId);
+  if (!d) {
+    throw new ToolInputError(
+      `Unknown drink "${drinkId}". Valid ids: ${SEASONAL_MENU.map((x) => x.id).join(', ')}.`,
+    );
+  }
+  if (!SIZES[size]) {
+    throw new ToolInputError(`Invalid size "${size}". Use one of: ${Object.keys(SIZES).join(', ')}.`);
+  }
+  const chosenMilk = milk ?? d.defaultMilk;
+  if (!d.allowedMilks.includes(chosenMilk)) {
+    throw new ToolInputError(
+      `${d.name} cannot be made with "${chosenMilk}". Allowed: ${d.allowedMilks.join(', ')}.`,
+    );
+  }
+  if (!Array.isArray(extras) || extras.some((e) => !EXTRAS[e])) {
+    throw new ToolInputError(`Invalid extras. Use any of: ${Object.keys(EXTRAS).join(', ')}.`);
+  }
+  const qty = Number(quantity);
+  if (!Number.isInteger(qty) || qty < 1 || qty > 10) {
+    throw new ToolInputError('Quantity must be an integer between 1 and 10.');
+  }
+
+  const uniqueExtras = [...new Set(extras)].sort();
+  const existing = order.find(
+    (l) =>
+      l.drinkId === d.id &&
+      l.size === size &&
+      l.milk === chosenMilk &&
+      l.extras.join() === uniqueExtras.join(),
+  );
+  let line;
+  if (existing) {
+    existing.quantity = Math.min(10, existing.quantity + qty);
+    line = existing;
+  } else {
+    line = { lineId: nextLineId++, drinkId: d.id, size, milk: chosenMilk, extras: uniqueExtras, quantity: qty };
+    order.push(line);
+  }
+  commitOrder();
+  showToast(`Added ${qty} × ${d.name} (${size})`);
+  return line;
+}
+
+function removeFromOrder(lineId) {
+  const idx = order.findIndex((l) => l.lineId === Number(lineId));
+  if (idx === -1) throw new ToolInputError(`No order line with lineId ${lineId}.`);
+  const [removed] = order.splice(idx, 1);
+  commitOrder();
+  showToast(`Removed ${findDrink(removed.drinkId).name}`);
+  return removed;
+}
+
+function clearOrder() {
+  order = [];
+  commitOrder();
+}
+
+function commitOrder() {
+  saveOrder();
+  renderOrder();
+}
+
+// ---------------------------------------------------------------------------
+// Rendering: order panel, toast, confirm dialog
+// ---------------------------------------------------------------------------
+
+const panel = document.getElementById('order-panel');
+const itemsEl = document.getElementById('order-items');
+const emptyEl = document.getElementById('order-empty');
+const footerEl = document.getElementById('order-footer');
+const totalEl = document.getElementById('order-total');
+
+function describeLine(i) {
+  const parts = [SIZES[i.size].label];
+  if (i.milk !== 'none') parts.push(MILKS[i.milk].label);
+  parts.push(...i.extras.map((e) => EXTRAS[e].label));
+  return parts.join(' · ');
+}
+
+function renderOrder() {
+  const summary = orderSummary();
+  emptyEl.hidden = summary.items.length > 0;
+  footerEl.hidden = summary.items.length === 0;
+  totalEl.textContent = money(summary.total);
+  itemsEl.replaceChildren(
+    ...summary.items.map((i) => {
+      const li = document.createElement('li');
+      const info = document.createElement('div');
+      const title = document.createElement('strong');
+      title.textContent = `${i.quantity} × ${i.name}`;
+      const meta = document.createElement('div');
+      meta.className = 'meta';
+      meta.textContent = describeLine(i);
+      info.append(title, meta);
+
+      const right = document.createElement('div');
+      right.textContent = `${money(i.lineTotal)} `;
+      const rm = document.createElement('button');
+      rm.type = 'button';
+      rm.textContent = 'Remove';
+      rm.setAttribute('aria-label', `Remove ${i.name}`);
+      rm.addEventListener('click', () => removeFromOrder(i.lineId));
+      right.append(rm);
+
+      li.append(info, right);
+      return li;
+    }),
+  );
+  panel.classList.remove('pulse');
+  void panel.offsetWidth; // restart animation
+  panel.classList.add('pulse');
+}
+
+const toastEl = document.getElementById('toast');
+function showToast(msg) {
+  toastEl.textContent = msg;
+  toastEl.classList.add('show');
+  clearTimeout(showToast.timer);
+  showToast.timer = setTimeout(() => toastEl.classList.remove('show'), 2500);
+}
+
+const dialog = document.getElementById('confirm-dialog');
+const confirmItems = document.getElementById('confirm-items');
+const confirmTotal = document.getElementById('confirm-total');
+const confirmName = document.getElementById('confirm-name');
+
+/**
+ * Opens the confirmation dialog and resolves once the *user* confirms or
+ * cancels. Orders are never placed without an explicit human click.
+ */
+function requestCheckoutConfirmation(pickupName = '') {
+  const summary = orderSummary();
+  if (summary.items.length === 0) {
+    throw new ToolInputError('The order is empty. Add a drink first.');
+  }
+  if (dialog.open) {
+    throw new ToolInputError('A checkout confirmation is already awaiting the user.');
+  }
+  confirmItems.replaceChildren(
+    ...summary.items.map((i) => {
+      const li = document.createElement('li');
+      li.textContent = `${i.quantity} × ${i.name} — ${describeLine(i)} (${money(i.lineTotal)})`;
+      return li;
+    }),
+  );
+  confirmTotal.textContent = money(summary.total);
+  confirmName.value = pickupName;
+  dialog.returnValue = '';
+  dialog.showModal();
+
+  return new Promise((resolve) => {
+    dialog.addEventListener(
+      'close',
+      () => {
+        if (dialog.returnValue !== 'confirm') {
+          resolve({ status: 'cancelled', message: 'The user cancelled checkout.' });
+          return;
+        }
+        const name = confirmName.value.trim() || 'Guest';
+        const orderNumber = `DG-${Date.now().toString(36).toUpperCase().slice(-6)}`;
+        clearOrder();
+        showToast(`Order ${orderNumber} placed! We'll call "${name}" when it's ready.`);
+        resolve({ status: 'placed', orderNumber, pickupName: name, total: summary.total, items: summary.items });
+      },
+      { once: true },
+    );
+  });
+}
+
+document.getElementById('order-clear').addEventListener('click', () => {
+  clearOrder();
+  showToast('Order cleared');
+});
+document.getElementById('order-checkout').addEventListener('click', () => {
+  requestCheckoutConfirmation().catch(() => {});
+});
+
+// ---------------------------------------------------------------------------
+// WebMCP tool definitions
+// ---------------------------------------------------------------------------
+
+const ok = (data) => ({ content: [{ type: 'text', text: JSON.stringify(data, null, 2) }] });
+const fail = (msg) => ({ content: [{ type: 'text', text: msg }], isError: true });
+
+function wrap(fn) {
+  return async (input = {}, client) => {
+    try {
+      return ok(await fn(input ?? {}, client));
+    } catch (err) {
+      if (err instanceof ToolInputError) return fail(err.message);
+      console.error('[Daily Grind tools]', err);
+      return fail(`Unexpected error: ${err?.message ?? err}`);
+    }
+  };
+}
+
+const drinkIdSchema = {
+  type: 'string',
+  enum: SEASONAL_MENU.map((d) => d.id),
+  description: 'Id of a Seasonal Favorites drink (see get_seasonal_menu).',
+};
+
+const TOOLS = [
+  {
+    name: 'get_seasonal_menu',
+    description:
+      'List the drinks in The Daily Grind "Seasonal Favorites" menu with prices, tags, caffeine level, ' +
+      'temperature and allowed milk options. Optional filters narrow the results.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        tag: { type: 'string', description: 'Only drinks with this tag, e.g. "dairy-free", "sweet", "bold".' },
+        temperature: { type: 'string', enum: ['hot', 'iced'] },
+        caffeine: { type: 'string', enum: ['low', 'medium', 'high'] },
+        maxPrice: { type: 'number', description: 'Maximum medium-size price in USD.' },
+      },
+      additionalProperties: false,
+    },
+    annotations: { readOnlyHint: true },
+    execute: wrap(({ tag, temperature, caffeine, maxPrice }) => {
+      const drinks = SEASONAL_MENU.filter(
+        (d) =>
+          (!tag || d.tags.includes(String(tag).toLowerCase())) &&
+          (!temperature || d.temperature === temperature) &&
+          (!caffeine || d.caffeine === caffeine) &&
+          (maxPrice == null || d.basePrice <= Number(maxPrice)),
+      ).map(publicDrink);
+      return {
+        currency: 'USD',
+        drinks,
+        sizes: SIZES,
+        milks: MILKS,
+        extras: EXTRAS,
+      };
+    }),
+  },
+  {
+    name: 'get_drink_details',
+    description: 'Get full details for a single Seasonal Favorites drink by id or exact name.',
+    inputSchema: {
+      type: 'object',
+      properties: { drinkId: { type: 'string', description: 'Drink id (e.g. "cold-brew") or exact name.' } },
+      required: ['drinkId'],
+      additionalProperties: false,
+    },
+    annotations: { readOnlyHint: true },
+    execute: wrap(({ drinkId }) => {
+      const d = findDrink(drinkId);
+      if (!d) throw new ToolInputError(`Unknown drink "${drinkId}".`);
+      return publicDrink(d);
+    }),
+  },
+  {
+    name: 'highlight_drink',
+    description:
+      'Scroll the page to a Seasonal Favorites drink card and visually highlight it for the user.',
+    inputSchema: {
+      type: 'object',
+      properties: { drinkId: drinkIdSchema },
+      required: ['drinkId'],
+      additionalProperties: false,
+    },
+    execute: wrap(({ drinkId }) => {
+      const d = findDrink(drinkId);
+      if (!d || !highlightDrink(d.id)) throw new ToolInputError(`Unknown drink "${drinkId}".`);
+      return { highlighted: d.id };
+    }),
+  },
+  {
+    name: 'add_drink_to_order',
+    description:
+      'Add a customised Seasonal Favorites drink to the on-page order (cart). Does not place or pay ' +
+      'for the order. Identical customisations are merged by increasing quantity.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        drinkId: drinkIdSchema,
+        size: { type: 'string', enum: Object.keys(SIZES), default: 'medium' },
+        milk: {
+          type: 'string',
+          enum: Object.keys(MILKS),
+          description: "Milk choice. Must be in the drink's allowedMilks. Defaults to the drink's defaultMilk.",
+        },
+        extras: {
+          type: 'array',
+          items: { type: 'string', enum: Object.keys(EXTRAS) },
+          description: 'Optional add-ons.',
+        },
+        quantity: { type: 'integer', minimum: 1, maximum: 10, default: 1 },
+      },
+      required: ['drinkId'],
+      additionalProperties: false,
+    },
+    execute: wrap((input) => {
+      const line = addToOrder(input);
+      highlightDrink(line.drinkId);
+      return { added: line, order: orderSummary() };
+    }),
+  },
+  {
+    name: 'get_current_order',
+    description: 'Return the items currently in the on-page order, with line ids, prices and total.',
+    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+    annotations: { readOnlyHint: true },
+    execute: wrap(() => orderSummary()),
+  },
+  {
+    name: 'remove_order_item',
+    description: 'Remove a line from the on-page order by its lineId (see get_current_order).',
+    inputSchema: {
+      type: 'object',
+      properties: { lineId: { type: 'integer', description: 'lineId from get_current_order.' } },
+      required: ['lineId'],
+      additionalProperties: false,
+    },
+    execute: wrap(({ lineId }) => {
+      removeFromOrder(lineId);
+      return orderSummary();
+    }),
+  },
+  {
+    name: 'clear_order',
+    description: 'Remove every item from the on-page order.',
+    inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+    execute: wrap(() => {
+      clearOrder();
+      showToast('Order cleared');
+      return orderSummary();
+    }),
+  },
+  {
+    name: 'checkout_order',
+    description:
+      'Start checkout for the current order. Opens a confirmation dialog on the page; the order is only ' +
+      'placed if the human user clicks "Confirm Order". Resolves with status "placed" (with orderNumber) ' +
+      'or "cancelled".',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        pickupName: { type: 'string', description: 'Optional name to pre-fill for pickup.' },
+      },
+      additionalProperties: false,
+    },
+    execute: wrap(async ({ pickupName }, client) => {
+      const run = () => requestCheckoutConfirmation(pickupName ? String(pickupName) : '');
+      // Let the browser/agent know we are waiting on the user when supported.
+      if (client && typeof client.requestUserInteraction === 'function') {
+        return client.requestUserInteraction(run);
+      }
+      return run();
+    }),
+  },
+];
+
+function registerTools() {
+  const mc = navigator.modelContext;
+  if (!mc) return false;
+  try {
+    if (typeof mc.registerTool === 'function') {
+      for (const tool of TOOLS) {
+        try {
+          mc.registerTool(tool);
+        } catch (err) {
+          console.warn(`[Daily Grind tools] could not register ${tool.name}`, err);
+        }
+      }
+      return true;
+    }
+    if (typeof mc.provideContext === 'function') {
+      mc.provideContext({ tools: TOOLS });
+      return true;
+    }
+  } catch (err) {
+    console.warn('[Daily Grind tools] WebMCP registration failed', err);
+  }
+  return false;
+}
+
+// ---------------------------------------------------------------------------
+// Boot
+// ---------------------------------------------------------------------------
+
+renderMenu();
+renderOrder();
+panel.classList.remove('pulse');
+
+document.querySelector('.hero .btn')?.addEventListener('click', (e) => {
+  // Keep the real link as a fallback, but on this page jump to the menu.
+  e.preventDefault();
+  grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
+});
+
+const registered = registerTools();
+
+// Fallback / debugging surface: same tools, callable directly.
+window.dailyGrindTools = Object.freeze({
+  registeredWithWebMCP: registered,
+  list: () => TOOLS.map(({ name, description, inputSchema, annotations }) => ({ name, description, inputSchema, annotations })),
+  call: (name, input) => {
+    const tool = TOOLS.find((t) => t.name === name);
+    if (!tool) return Promise.resolve(fail(`Unknown tool "${name}".`));
+    return tool.execute(input);
+  },
+});
