index 0000000..9485e3c
--- /dev/null
+++ b/seasonal-tools.js
@@ -0,0 +1,515 @@
+// Seasonal Favorites menu, on-page order panel, and WebMCP tools that let
+// in-browser AI agents query the menu and drive the ordering UI.
+
+const MENU = [
+  {
+    id: "maple-oat-latte",
+    name: "Maple Oat Latte",
+    description: "Creamy oat milk with a hint of Vermont maple syrup.",
+    basePrice: 5.75,
+    sizes: { small: 0, medium: 0.5, large: 1 },
+    milks: ["oat", "whole", "almond", "skim"],
+    temperatures: ["hot", "iced"],
+    defaults: { size: "medium", milk: "oat", temperature: "hot" },
+    caffeinated: true,
+    tags: ["seasonal", "latte", "dairy-free by default", "sweet"],
+    detailsUrl: "/menu/seasonal",
+  },
+  {
+    id: "dark-roast-espresso",
+    name: "Dark Roast Espresso",
+    description: "Bold, smokey, and perfect for a morning boost.",
+    basePrice: 3.25,
+    sizes: { single: 0, double: 1 },
+    milks: ["none"],
+    temperatures: ["hot"],
+    defaults: { size: "double", milk: "none", temperature: "hot" },
+    caffeinated: true,
+    tags: ["espresso", "strong", "dairy-free", "unsweetened"],
+    detailsUrl: "/menu/espresso",
+  },
+  {
+    id: "cold-brew",
+    name: "Cold Brew",
+    description: "Steeped for 18 hours for maximum smoothness.",
+    basePrice: 4.5,
+    sizes: { small: 0, medium: 0.5, large: 1 },
+    milks: ["none", "oat", "whole", "almond"],
+    temperatures: ["iced"],
+    defaults: { size: "medium", milk: "none", temperature: "iced" },
+    caffeinated: true,
+    tags: ["cold", "smooth", "dairy-free by default", "unsweetened"],
+    detailsUrl: "/menu/cold-brew",
+  },
+];
+
+const ITEM_IDS = MENU.map((item) => item.id);
+const ALL_SIZES = [...new Set(MENU.flatMap((item) => Object.keys(item.sizes)))];
+const ALL_MILKS = [...new Set(MENU.flatMap((item) => item.milks))];
+const ALL_TEMPERATURES = [...new Set(MENU.flatMap((item) => item.temperatures))];
+const MAX_QUANTITY = 10;
+
+const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+const formatPrice = (amount) => currency.format(amount);
+const roundCents = (amount) => Math.round(amount * 100) / 100;
+
+const findItem = (itemId) => MENU.find((item) => item.id === itemId);
+
+function describeItem(item) {
+  return {
+    itemId: item.id,
+    name: item.name,
+    description: item.description,
+    tags: item.tags,
+    caffeinated: item.caffeinated,
+    sizes: Object.entries(item.sizes).map(([size, upcharge]) => ({
+      size,
+      price: roundCents(item.basePrice + upcharge),
+    })),
+    milkOptions: item.milks,
+    temperatureOptions: item.temperatures,
+    defaults: item.defaults,
+    detailsUrl: new URL(item.detailsUrl, location.href).href,
+  };
+}
+
+// ---------------------------------------------------------------------------
+// Order state + rendering
+// ---------------------------------------------------------------------------
+
+const order = [];
+let nextLineId = 1;
+
+const els = {
+  section: document.getElementById("order"),
+  empty: document.getElementById("order-empty"),
+  lines: document.getElementById("order-lines"),
+  total: document.getElementById("order-total"),
+  placeBtn: document.getElementById("place-order-btn"),
+  status: document.getElementById("order-status"),
+  dialog: document.getElementById("confirm-order-dialog"),
+  dialogLines: document.getElementById("confirm-order-lines"),
+  dialogTotal: document.getElementById("confirm-order-total"),
+  agentIndicator: document.getElementById("agent-indicator"),
+};
+
+const orderTotal = () => roundCents(order.reduce((sum, line) => sum + line.unitPrice * line.quantity, 0));
+
+function lineLabel(line) {
+  const extras = [line.size, line.temperature, line.milk !== "none" ? `${line.milk} milk` : null]
+    .filter(Boolean)
+    .join(", ");
+  return { title: `${line.quantity} × ${line.name}`, extras };
+}
+
+function orderSnapshot() {
+  return {
+    lines: order.map((line) => ({
+      lineId: line.lineId,
+      itemId: line.itemId,
+      name: line.name,
+      size: line.size,
+      milk: line.milk,
+      temperature: line.temperature,
+      quantity: line.quantity,
+      unitPrice: line.unitPrice,
+      lineTotal: roundCents(line.unitPrice * line.quantity),
+    })),
+    itemCount: order.reduce((sum, line) => sum + line.quantity, 0),
+    total: orderTotal(),
+    currency: "USD",
+  };
+}
+
+function renderOrder() {
+  els.section.hidden = false;
+  els.empty.hidden = order.length > 0;
+  els.lines.replaceChildren(
+    ...order.map((line) => {
+      const { title, extras } = lineLabel(line);
+      const li = document.createElement("li");
+      const text = document.createElement("div");
+      const strong = document.createElement("strong");
+      strong.textContent = title;
+      const meta = document.createElement("div");
+      meta.className = "line-meta";
+      meta.textContent = `${extras} · ${formatPrice(line.unitPrice * line.quantity)}`;
+      text.append(strong, meta);
+
+      const remove = document.createElement("button");
+      remove.type = "button";
+      remove.className = "remove-btn";
+      remove.textContent = "Remove";
+      remove.setAttribute("aria-label", `Remove ${title}`);
+      remove.addEventListener("click", () => removeLine(line.lineId));
+
+      li.append(text, remove);
+      return li;
+    }),
+  );
+  els.total.textContent = formatPrice(orderTotal());
+  els.placeBtn.disabled = order.length === 0;
+}
+
+function announce(message) {
+  els.status.textContent = message;
+}
+
+function addLine(item, { size, milk, temperature, quantity }) {
+  const existing = order.find(
+    (line) => line.itemId === item.id && line.size === size && line.milk === milk && line.temperature === temperature,
+  );
+  if (existing) {
+    existing.quantity = Math.min(MAX_QUANTITY, existing.quantity + quantity);
+  } else {
+    order.push({
+      lineId: `line-${nextLineId++}`,
+      itemId: item.id,
+      name: item.name,
+      size,
+      milk,
+      temperature,
+      quantity,
+      unitPrice: roundCents(item.basePrice + item.sizes[size]),
+    });
+  }
+  renderOrder();
+  announce(`Added ${quantity} × ${item.name} to your order.`);
+  return existing?.lineId ?? order.at(-1).lineId;
+}
+
+function removeLine(lineId) {
+  const index = order.findIndex((line) => line.lineId === lineId);
+  if (index === -1) return null;
+  const [removed] = order.splice(index, 1);
+  renderOrder();
+  announce(`Removed ${removed.name} from your order.`);
+  return removed;
+}
+
+// ---------------------------------------------------------------------------
+// UI helpers: highlighting cards and confirming orders
+// ---------------------------------------------------------------------------
+
+const prefersReducedMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
+const highlightTimers = new WeakMap();
+
+function highlightCard(itemId) {
+  const card = document.querySelector(`.card[data-item-id="${CSS.escape(itemId)}"]`);
+  if (!card) return false;
+  for (const other of document.querySelectorAll(".card.is-highlighted")) {
+    other.classList.remove("is-highlighted");
+  }
+  card.classList.add("is-highlighted");
+  card.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "center" });
+  clearTimeout(highlightTimers.get(card));
+  highlightTimers.set(
+    card,
+    setTimeout(() => card.classList.remove("is-highlighted"), 4000),
+  );
+  return true;
+}
+
+let pendingConfirmation = null;
+
+/**
+ * Opens the confirmation dialog and resolves with true (placed) or false
+ * (dismissed). The user always makes the final decision, even when an agent
+ * started the checkout. Aborting `signal` closes the dialog and rejects.
+ */
+function confirmOrder(signal) {
+  if (pendingConfirmation) return pendingConfirmation;
+
+  els.dialogLines.replaceChildren(
+    ...order.map((line) => {
+      const { title, extras } = lineLabel(line);
+      const li = document.createElement("li");
+      li.textContent = `${title} (${extras}) — ${formatPrice(line.unitPrice * line.quantity)}`;
+      return li;
+    }),
+  );
+  els.dialogTotal.textContent = formatPrice(orderTotal());
+  els.dialog.returnValue = "";
+
+  pendingConfirmation = new Promise((resolve, reject) => {
+    const onAbort = () => {
+      els.dialog.removeEventListener("close", onClose);
+      els.dialog.close();
+      els.dialog.returnValue = "";
+      reject(signal.reason);
+    };
+    const onClose = () => {
+      signal?.removeEventListener("abort", onAbort);
+      const confirmed = els.dialog.returnValue === "confirm";
+      els.dialog.returnValue = "";
+      resolve(confirmed);
+    };
+    els.dialog.addEventListener("close", onClose, { once: true });
+    signal?.addEventListener("abort", onAbort, { once: true });
+    els.dialog.showModal();
+  }).finally(() => {
+    pendingConfirmation = null;
+  });
+
+  return pendingConfirmation;
+}
+
+function finalizeOrder() {
+  const summary = orderSnapshot();
+  const confirmationCode = `DG-${Math.floor(1000 + Math.random() * 9000)}`;
+  order.length = 0;
+  renderOrder();
+  announce(`Order ${confirmationCode} placed! It will be ready for pickup in about 10 minutes.`);
+  return { confirmationCode, estimatedReadyMinutes: 10, ...summary };
+}
+
+async function checkout(signal) {
+  if (order.length === 0) return { status: "empty" };
+  const confirmed = await confirmOrder(signal);
+  if (!confirmed) {
+    announce("Order not placed. Your drinks are still in your order.");
+    return { status: "cancelled" };
+  }
+  return { status: "placed", ...finalizeOrder() };
+}
+
+// ---------------------------------------------------------------------------
+// Progressive enhancement of the static cards for human visitors
+// ---------------------------------------------------------------------------
+
+for (const card of document.querySelectorAll(".card[data-item-id]")) {
+  const item = findItem(card.dataset.itemId);
+  if (!item) continue;
+
+  const price = document.createElement("p");
+  price.className = "price";
+  price.textContent = `From ${formatPrice(item.basePrice)}`;
+  card.querySelector("p").after(price);
+
+  const addBtn = document.createElement("button");
+  addBtn.type = "button";
+  addBtn.className = "btn btn-secondary";
+  addBtn.textContent = "Add to Order";
+  addBtn.setAttribute("aria-label", `Add ${item.name} to order`);
+  addBtn.addEventListener("click", () => addLine(item, { ...item.defaults, quantity: 1 }));
+  card.querySelector(".card-actions").append(addBtn);
+}
+
+els.placeBtn.addEventListener("click", () => {
+  checkout().catch(() => {});
+});
+
+renderOrder();
+
+// ---------------------------------------------------------------------------
+// WebMCP tools
+// ---------------------------------------------------------------------------
+
+let indicatorTimer;
+function withIndicator(label, execute) {
+  return async (input, options) => {
+    clearTimeout(indicatorTimer);
+    els.agentIndicator.textContent = `Assistant: ${label}…`;
+    els.agentIndicator.hidden = false;
+    try {
+      return await execute(input ?? {}, options ?? {});
+    } finally {
+      indicatorTimer = setTimeout(() => {
+        els.agentIndicator.hidden = true;
+      }, 1500);
+    }
+  };
+}
+
+function unknownItemError(itemId) {
+  return {
+    error: `Unknown seasonal item "${itemId}".`,
+    availableItemIds: ITEM_IDS,
+  };
+}
+
+const tools = [
+  {
+    name: "get_seasonal_menu",
+    description:
+      "Lists The Daily Grind's current Seasonal Favorites with descriptions, prices per size, milk and temperature options, and tags. Use it to answer menu questions or before adding a drink to the order.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        keyword: {
+          type: "string",
+          description:
+            "Optional word to filter drinks by name, description, or tag, e.g. \"iced\", \"dairy-free\", \"maple\". Omit to list everything.",
+        },
+      },
+    },
+    execute: withIndicator("reading the seasonal menu", ({ keyword }) => {
+      const term = typeof keyword === "string" ? keyword.trim().toLowerCase() : "";
+      const matches = MENU.filter((item) => {
+        if (!term) return true;
+        const haystack = [item.name, item.description, ...item.tags, ...item.temperatures].join(" ").toLowerCase();
+        return haystack.includes(term);
+      });
+      return {
+        currency: "USD",
+        items: matches.map(describeItem),
+        ...(term && matches.length === 0
+          ? { note: `No seasonal drinks match "${keyword}".`, availableItemIds: ITEM_IDS }
+          : {}),
+      };
+    }),
+    annotations: { readOnlyHint: true },
+  },
+  {
+    name: "show_menu_item",
+    description:
+      "Scrolls the page to a Seasonal Favorites drink and visually highlights its card so the user can see it.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        itemId: { type: "string", enum: ITEM_IDS, description: "The seasonal drink to show." },
+      },
+      required: ["itemId"],
+    },
+    execute: withIndicator("showing a drink", ({ itemId }) => {
+      const item = findItem(itemId);
+      if (!item) return unknownItemError(itemId);
+      highlightCard(item.id);
+      return { shown: item.name };
+    }),
+    annotations: { readOnlyHint: false },
+  },
+  {
+    name: "add_drink_to_order",
+    description:
+      "Adds a Seasonal Favorites drink to the user's on-page order. Unspecified options use the drink's defaults. The order is only submitted when the user confirms it.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        itemId: { type: "string", enum: ITEM_IDS, description: "The seasonal drink to add." },
+        size: {
+          type: "string",
+          enum: ALL_SIZES,
+          description: "Cup size; must be one the chosen drink offers (see get_seasonal_menu).",
+        },
+        milk: {
+          type: "string",
+          enum: ALL_MILKS,
+          description: "Milk choice; must be one the chosen drink offers.",
+        },
+        temperature: {
+          type: "string",
+          enum: ALL_TEMPERATURES,
+          description: "Serve hot or iced; must be one the chosen drink offers.",
+        },
+        quantity: {
+          type: "integer",
+          minimum: 1,
+          maximum: MAX_QUANTITY,
+          default: 1,
+          description: "How many of this drink to add.",
+        },
+      },
+      required: ["itemId"],
+    },
+    execute: withIndicator("adding a drink to your order", (input) => {
+      const item = findItem(input.itemId);
+      if (!item) return unknownItemError(input.itemId);
+
+      const size = input.size ?? item.defaults.size;
+      const milk = input.milk ?? item.defaults.milk;
+      const temperature = input.temperature ?? item.defaults.temperature;
+      const quantity = input.quantity ?? 1;
+
+      const problems = [];
+      if (!(size in item.sizes)) problems.push(`size must be one of: ${Object.keys(item.sizes).join(", ")}`);
+      if (!item.milks.includes(milk)) problems.push(`milk must be one of: ${item.milks.join(", ")}`);
+      if (!item.temperatures.includes(temperature)) {
+        problems.push(`temperature must be one of: ${item.temperatures.join(", ")}`);
+      }
+      if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) {
+        problems.push(`quantity must be a whole number from 1 to ${MAX_QUANTITY}`);
+      }
+      if (problems.length) {
+        return { error: `Invalid options for ${item.name}: ${problems.join("; ")}.` };
+      }
+
+      const lineId = addLine(item, { size, milk, temperature, quantity });
+      highlightCard(item.id);
+      return { added: { lineId, name: item.name, size, milk, temperature, quantity }, order: orderSnapshot() };
+    }),
+    annotations: { readOnlyHint: false },
+  },
+  {
+    name: "get_current_order",
+    description: "Returns the drinks currently in the user's on-page order, with line totals and the order total.",
+    inputSchema: { type: "object", properties: {} },
+    execute: withIndicator("checking your order", () => orderSnapshot()),
+    annotations: { readOnlyHint: true },
+  },
+  {
+    name: "remove_drink_from_order",
+    description: "Removes one line from the user's on-page order.",
+    inputSchema: {
+      type: "object",
+      properties: {
+        lineId: { type: "string", description: "The order line to remove, as returned by get_current_order." },
+      },
+      required: ["lineId"],
+    },
+    execute: withIndicator("updating your order", ({ lineId }) => {
+      const removed = removeLine(lineId);
+      if (!removed) {
+        return {
+          error: `No order line "${lineId}".`,
+          availableLineIds: order.map((line) => line.lineId),
+        };
+      }
+      return { removed: { lineId: removed.lineId, name: removed.name }, order: orderSnapshot() };
+    }),
+    annotations: { readOnlyHint: false },
+  },
+  {
+    name: "place_order",
+    description:
+      "Opens the order confirmation dialog for the drinks in the user's order and waits for the user to confirm or dismiss it. Returns the confirmation code once placed.",
+    inputSchema: { type: "object", properties: {} },
+    execute: withIndicator("waiting for you to confirm", async (_input, { signal }) => {
+      if (order.length === 0) {
+        return { error: "The order is empty. Add drinks with add_drink_to_order first." };
+      }
+      document.getElementById("order").scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth" });
+      const result = await checkout(signal);
+      if (result.status === "cancelled") {
