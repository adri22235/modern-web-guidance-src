+];
+
+let registration;
+
+async function registerTools() {
+  if (!("modelContext" in document)) return;
+  registration?.abort();
+  registration = new AbortController();
+  const { signal } = registration;
+  const results = await Promise.allSettled(
+    tools.map((tool) => document.modelContext.registerTool(tool, { signal })),
+  );
+  results.forEach((result, i) => {
+    if (result.status === "rejected") {
+      console.warn(`WebMCP: failed to register "${tools[i].name}"`, result.reason);
+    }
+  });
+}
+
+// Unregister on page hide; re-register if the page is restored from the bfcache.
+addEventListener("pagehide", () => registration?.abort());
+addEventListener("pageshow", (event) => {
+  if (event.persisted) registerTools();
+});
+
+registerTools();
