new file mode 100644
index 0000000..229b9f4
--- /dev/null
+++ b/_headers
@@ -0,0 +1,33 @@
+# Security response headers (Netlify / Cloudflare Pages `_headers` format).
+# Port these to your server/CDN config if deploying elsewhere.
+#
+# Audit basis: the site ships no JavaScript, one same-origin stylesheet
+# (/styles.css), and same-origin images (/images/*). Every fetch therefore
+# resolves to 'self', which lets us enforce a deny-by-default CSP immediately.
+# If scripts are added later, switch script-src to
+#   'nonce-{RANDOM}' 'strict-dynamic' 'report-sample'
+# (or sha256 hashes for static files), stage the change with
+# Content-Security-Policy-Report-Only first, and add named Trusted Types policies to
+# `trusted-types`.
+#
+# HSTS staged rollout: starts at max-age=300; raise to 31536000 and add
+# `preload` once HTTPS is confirmed working on every subdomain.
+#
+# Reporting endpoint: /api/security-reports must accept application/reports+json
+# POSTs. Strip query strings / PII from reported URLs before storing them.
+
+/*
+  Reporting-Endpoints: default="/api/security-reports", csp-endpoint="/api/security-reports"
+  Content-Security-Policy: default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests; report-to csp-endpoint
+  X-Frame-Options: DENY
+  X-Content-Type-Options: nosniff
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=(), focus-without-user-activation=()
+  Cross-Origin-Opener-Policy: same-origin-allow-popups
+  Cross-Origin-Resource-Policy: same-origin
+  Strict-Transport-Security: max-age=300; includeSubDomains
+
+# Fully end the session on logout (cookies, storage, HTTP cache).
+/logout
+  Clear-Site-Data: "cookies", "storage", "cache"
+  Cache-Control: no-store
