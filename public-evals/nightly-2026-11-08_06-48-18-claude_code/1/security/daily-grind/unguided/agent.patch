diff --git a/security.js b/security.js
new file mode 100644
index 0000000..a99030b
--- /dev/null
+++ b/security.js
@@ -0,0 +1,33 @@
+/*
+ * Client-side hardening for The Daily Grind.
+ *
+ * Loaded as an external, same-origin script so the CSP can stay strict
+ * (script-src 'self', no 'unsafe-inline'). It doesn't create any Trusted
+ * Types policy or use any DOM XSS sinks, so it works under
+ * "require-trusted-types-for 'script'; trusted-types 'none'".
+ */
+(function () {
+  'use strict';
+
+  // Anti-clickjacking fallback. Browsers ignore the CSP frame-ancestors
+  // directive when it's delivered via <meta>, so if the page is served
+  // without real headers (for example, by the static dev server), hide the
+  // content and try to break out of any frame that isn't our own origin.
+  var framed;
+  try {
+    framed = window.top !== window.self &&
+      window.top.location.origin !== window.location.origin;
+  } catch (e) {
+    // Reading top.location from a cross-origin frame throws.
+    framed = true;
+  }
+
+  if (framed) {
+    document.documentElement.classList.add('framed');
+    try {
+      window.top.location.replace(window.location.href);
+    } catch (e) {
+      // A sandboxed frame may block navigation; the content stays hidden.
+    }
+  }
+})();
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..0206bde
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,156 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title {
+  text-align: center;
+}
+
+/* Applied by security.js when the page is loaded inside a foreign frame
+   (anti-clickjacking fallback for hosts that cannot send frame-ancestors). */
+html.framed body {
+  display: none !important;
+}
