@@ -0,0 +1,655 @@
+/**
+ * My Account → Passkeys
+ *
+ * Lets a signed-in customer list, rename and delete their passkeys, and keeps
+ * the browser / password manager in sync using the WebAuthn Signal API
+ * (PublicKeyCredential.signalAllAcceptedCredentials & friends) so deleted
+ * passkeys stop being offered at sign-in.
+ *
+ * Expected backend contract (same-origin, cookie session):
+ *
+ *   GET    /api/account/passkeys
+ *     200 → {
+ *       rpId: "dailygrind.example",            // WebAuthn RP ID
+ *       user: { id, name, displayName },       // id = base64url WebAuthn user handle
+ *       currentCredentialId?: string,          // passkey used for this session, if any
+ *       passkeys: [{
+ *         id: string,                          // base64url credential ID
+ *         name: string,
+ *         createdAt: string,                   // ISO 8601
+ *         lastUsedAt?: string | null,          // ISO 8601
+ *         providerName?: string,               // e.g. "Google Password Manager" (from AAGUID)
+ *         providerIcon?: string,               // data:image/... URL
+ *         backedUp?: boolean                   // synced passkey (BS flag)
+ *       }]
+ *     }
+ *   PATCH  /api/account/passkeys/:id   body { name }  → 200 { passkey }
+ *   DELETE /api/account/passkeys/:id                  → 204
+ *
+ *   401 on any endpoint redirects to /login.
+ *
+ * Append ?demo to the URL to use an in-memory mock instead of the API
+ * (the Signal API is never called in demo mode).
+ */
+
+const API_BASE = '/api/account/passkeys';
+const NAME_MAX = 64;
+const DEMO = new URLSearchParams(location.search).has('demo');
+
+const root = document.getElementById('passkeys-root');
+const greeting = document.getElementById('greeting');
+const syncNotice = document.getElementById('sync-notice');
+const toastEl = document.getElementById('toast');
+const deleteDialog = document.getElementById('delete-dialog');
+
+const state = {
+  rpId: null,
+  user: null,
+  currentCredentialId: null,
+  passkeys: [],
+  editingId: null,
+  busyIds: new Set(),
+};
+
+/* ------------------------------------------------------------------ */
+/* API                                                                 */
+/* ------------------------------------------------------------------ */
+
+class ApiError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.status = status;
+  }
+}
+
+function csrfToken() {
+  return document.querySelector('meta[name="csrf-token"]')?.content ?? null;
+}
+
+async function request(path, { method = 'GET', body } = {}) {
+  const headers = { Accept: 'application/json', 'X-Requested-With': 'fetch' };
+  if (body !== undefined) headers['Content-Type'] = 'application/json';
+  const token = csrfToken();
+  if (token && method !== 'GET') headers['X-CSRF-Token'] = token;
+
+  let res;
+  try {
+    res = await fetch(path, {
+      method,
+      headers,
+      credentials: 'same-origin',
+      body: body === undefined ? undefined : JSON.stringify(body),
+    });
+  } catch {
+    throw new ApiError('We couldn’t reach the server. Check your connection and try again.', 0);
+  }
+
+  if (res.status === 401) {
+    location.assign(`/login?next=${encodeURIComponent(location.pathname)}`);
+    throw new ApiError('Your session has expired. Please sign in again.', 401);
+  }
+
+  if (!res.ok) {
+    let message = 'Something went wrong. Please try again.';
+    try {
+      const data = await res.json();
+      if (data && typeof data.error === 'string') message = data.error;
+      else if (data && typeof data.message === 'string') message = data.message;
+    } catch { /* non-JSON error body */ }
+    throw new ApiError(message, res.status);
+  }
+
+  if (res.status === 204) return null;
+  return res.json();
+}
+
+const realApi = {
+  list: () => request(API_BASE),
+  rename: (id, name) =>
+    request(`${API_BASE}/${encodeURIComponent(id)}`, { method: 'PATCH', body: { name } }),
+  remove: (id) => request(`${API_BASE}/${encodeURIComponent(id)}`, { method: 'DELETE' }),
+};
+
+function createDemoApi() {
+  const day = 86400000;
+  const now = Date.now();
+  const db = {
+    rpId: location.hostname,
+    user: { id: 'ZGVtby11c2VyLTEyMw', name: 'alex@example.com', displayName: 'Alex' },
+    currentCredentialId: 'Y3JlZC1waG9uZQ',
+    passkeys: [
+      {
+        id: 'Y3JlZC1waG9uZQ',
+        name: 'Pixel phone',
+        createdAt: new Date(now - 120 * day).toISOString(),
+        lastUsedAt: new Date(now - 2 * 3600000).toISOString(),
+        providerName: 'Google Password Manager',
+        backedUp: true,
+      },
+      {
+        id: 'Y3JlZC1tYWNib29r',
+        name: 'Work MacBook',
+        createdAt: new Date(now - 40 * day).toISOString(),
+        lastUsedAt: new Date(now - 9 * day).toISOString(),
+        providerName: 'iCloud Keychain',
+        backedUp: true,
+      },
+      {
+        id: 'Y3JlZC15dWJpa2V5',
+        name: 'YubiKey 5C',
+        createdAt: new Date(now - 300 * day).toISOString(),
+        lastUsedAt: null,
+        providerName: 'YubiKey 5 Series',
+        backedUp: false,
+      },
+    ],
+  };
+  const delay = () => new Promise((r) => setTimeout(r, 350));
+  const clone = (v) => JSON.parse(JSON.stringify(v));
+  return {
+    async list() {
+      await delay();
+      return clone(db);
+    },
+    async rename(id, name) {
+      await delay();
+      const pk = db.passkeys.find((p) => p.id === id);
+      if (!pk) throw new ApiError('That passkey no longer exists.', 404);
+      pk.name = name;
+      return { passkey: clone(pk) };
+    },
+    async remove(id) {
+      await delay();
+      const before = db.passkeys.length;
+      db.passkeys = db.passkeys.filter((p) => p.id !== id);
+      if (db.passkeys.length === before) throw new ApiError('That passkey no longer exists.', 404);
+      return null;
+    },
+  };
+}
+
+const api = DEMO ? createDemoApi() : realApi;
+
+/* ------------------------------------------------------------------ */
+/* WebAuthn Signal API – keep the authenticator in sync                */
+/* ------------------------------------------------------------------ */
+
+const PKC = window.PublicKeyCredential;
+const signalSupport = {
+  allAccepted: !!PKC && typeof PKC.signalAllAcceptedCredentials === 'function',
+  unknown: !!PKC && typeof PKC.signalUnknownCredential === 'function',
+  userDetails: !!PKC && typeof PKC.signalCurrentUserDetails === 'function',
+};
+const canSignal = !DEMO && (signalSupport.allAccepted || signalSupport.unknown);
+
+/**
+ * Tell the authenticator the complete, authoritative list of passkeys the
+ * server still accepts for this user. Anything else for this user + RP is
+ * hidden or removed by the passkey provider.
+ *
+ * Must only be called with a list freshly fetched from the server — calling
+ * it with a stale list could hide a passkey registered in another tab.
+ */
+async function signalAccepted(snapshot) {
+  if (DEMO || !signalSupport.allAccepted || !snapshot?.rpId || !snapshot?.user?.id) return false;
+  try {
+    await PKC.signalAllAcceptedCredentials({
+      rpId: snapshot.rpId,
+      userId: snapshot.user.id,
+      allAcceptedCredentialIds: snapshot.passkeys.map((p) => p.id),
+    });
+    return true;
+  } catch (err) {
+    console.warn('[passkeys] signalAllAcceptedCredentials failed', err);
+    return false;
+  }
+}
+
+async function signalUnknown(rpId, credentialId) {
+  if (DEMO || !signalSupport.unknown || !rpId) return false;
+  try {
+    await PKC.signalUnknownCredential({ rpId, credentialId });
+    return true;
+  } catch (err) {
+    console.warn('[passkeys] signalUnknownCredential failed', err);
+    return false;
+  }
+}
+
+async function signalUserDetails(snapshot) {
+  if (DEMO || !signalSupport.userDetails || !snapshot?.rpId || !snapshot?.user?.id) return;
+  const { id, name, displayName } = snapshot.user;
+  if (!name) return;
+  try {
+    await PKC.signalCurrentUserDetails({
+      rpId: snapshot.rpId,
+      userId: id,
+      name,
+      displayName: displayName || name,
+    });
+  } catch (err) {
+    console.warn('[passkeys] signalCurrentUserDetails failed', err);
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [key, value] of Object.entries(props)) {
+    if (value === undefined || value === null || value === false) continue;
+    if (key === 'class') node.className = value;
+    else if (key === 'text') node.textContent = value;
+    else if (key === 'dataset') Object.assign(node.dataset, value);
+    else if (key.startsWith('on')) node.addEventListener(key.slice(2), value);
+    else if (value === true) node.setAttribute(key, '');
+    else node.setAttribute(key, value);
+  }
+  for (const child of children.flat()) {
+    if (child === null || child === undefined || child === false) continue;
+    node.append(child instanceof Node ? child : document.createTextNode(String(child)));
+  }
+  return node;
+}
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
+const relFmt = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function formatDate(iso) {
+  const d = iso ? new Date(iso) : null;
+  return d && !Number.isNaN(d.getTime()) ? dateFmt.format(d) : null;
+}
+
+function formatRelative(iso) {
+  const d = iso ? new Date(iso) : null;
+  if (!d || Number.isNaN(d.getTime())) return null;
+  const diffSec = Math.round((d.getTime() - Date.now()) / 1000);
+  const units = [
+    ['year', 31536000],
+    ['month', 2592000],
+    ['week', 604800],
+    ['day', 86400],
+    ['hour', 3600],
+    ['minute', 60],
+  ];
+  for (const [unit, secs] of units) {
+    if (Math.abs(diffSec) >= secs) return relFmt.format(Math.round(diffSec / secs), unit);
+  }
+  return 'just now';
+}
+
+function normalizeName(raw) {
+  return String(raw ?? '').replace(/\s+/g, ' ').trim();
+}
+
+function validateName(name, id) {
+  if (!name) return 'Please enter a name.';
+  if (name.length > NAME_MAX) return `Names can be up to ${NAME_MAX} characters.`;
+  const dupe = state.passkeys.some(
+    (p) => p.id !== id && p.name.toLocaleLowerCase() === name.toLocaleLowerCase(),
+  );
+  if (dupe) return 'You already have a passkey with that name.';
+  return null;
+}
+
+let toastTimer;
+function toast(message, kind = 'info') {
+  clearTimeout(toastTimer);
+  toastEl.textContent = message;
+  toastEl.dataset.kind = kind;
+  toastEl.hidden = false;
+  toastTimer = setTimeout(() => { toastEl.hidden = true; }, 4500);
+}
+
+function safeIcon(src) {
+  return typeof src === 'string' && /^data:image\/(png|svg\+xml|webp|jpeg);/i.test(src) ? src : null;
+}
+
+const keyIconSvg = () => {
+  const ns = 'http://www.w3.org/2000/svg';
+  const svg = document.createElementNS(ns, 'svg');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  svg.setAttribute('width', '22');
+  svg.setAttribute('height', '22');
+  svg.setAttribute('fill', 'none');
+  svg.setAttribute('stroke', 'currentColor');
+  svg.setAttribute('stroke-width', '2');
+  svg.setAttribute('stroke-linecap', 'round');
+  svg.setAttribute('stroke-linejoin', 'round');
+  svg.setAttribute('aria-hidden', 'true');
+  const path = document.createElementNS(ns, 'path');
+  path.setAttribute(
+    'd',
+    'M15.5 7.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM12.5 10.5V21m0-4h3m-3-3h2',
+  );
+  svg.append(path);
+  return svg;
+};
+
+/* ------------------------------------------------------------------ */
+/* Rendering                                                           */
+/* ------------------------------------------------------------------ */
+
+function renderLoading() {
+  root.setAttribute('aria-busy', 'true');
+  root.replaceChildren(
+    el('div', { class: 'state' }, el('div', { class: 'spinner', 'aria-hidden': 'true' }), 'Loading your passkeys…'),
+  );
+}
+
+function renderError(message) {
+  root.setAttribute('aria-busy', 'false');
+  root.replaceChildren(
+    el('div', { class: 'state', role: 'alert' },
+      el('h3', { text: 'We couldn’t load your passkeys' }),
+      el('p', { text: message }),
+      el('button', { class: 'btn', type: 'button', style: 'margin-top:15px', onclick: load }, 'Try again'),
+    ),
+  );
+}
+
+function render() {
+  root.setAttribute('aria-busy', 'false');
+  syncNotice.hidden = !canSignal || state.passkeys.length === 0;
+
+  if (state.passkeys.length === 0) {
+    root.replaceChildren(
+      el('div', { class: 'state' },
+        el('h3', { text: 'No passkeys yet' }),
+        el('p', { text: 'You haven’t saved any passkeys. The next time you sign in, you’ll be offered the option to create one.' }),
+      ),
+    );
+    return;
+  }
+
+  const sorted = [...state.passkeys].sort((a, b) => {
+    if (a.id === state.currentCredentialId) return -1;
+    if (b.id === state.currentCredentialId) return 1;
+    return new Date(b.lastUsedAt || b.createdAt) - new Date(a.lastUsedAt || a.createdAt);
+  });
+
+  const countLabel = el('p', { class: 'visually-hidden', text: `${sorted.length} passkey${sorted.length === 1 ? '' : 's'}` });
+  const list = el('ul', { class: 'passkey-list', 'aria-labelledby': 'passkeys-heading' }, sorted.map(renderPasskey));
+  root.replaceChildren(countLabel, list);
+
+  if (state.editingId) {
+    const input = root.querySelector(`input[data-rename-for="${CSS.escape(state.editingId)}"]`);
+    if (input && document.activeElement !== input) {
+      input.focus();
+      input.select();
+    }
+  }
+}
+
+function renderPasskey(pk) {
+  const busy = state.busyIds.has(pk.id);
+  const isCurrent = pk.id === state.currentCredentialId;
+  const icon = safeIcon(pk.providerIcon);
+
+  const metaParts = [];
+  if (pk.providerName) metaParts.push(pk.providerName);
+  const created = formatDate(pk.createdAt);
+  if (created) metaParts.push(`Added ${created}`);
+  const lastUsed = formatRelative(pk.lastUsedAt);
+  metaParts.push(lastUsed ? `Last used ${lastUsed}` : 'Never used');
+
+  const iconEl = el('div', { class: 'passkey-icon' },
+    icon ? el('img', { src: icon, alt: '', width: '28', height: '28' }) : keyIconSvg(),
+  );
+
+  if (state.editingId === pk.id) {
+    return el('li', { class: 'passkey', dataset: { id: pk.id } },
+      iconEl,
+      renderRenameForm(pk, busy),
+      el('div'),
+    );
+  }
+
+  return el('li', { class: 'passkey', dataset: { id: pk.id } },
+    iconEl,
+    el('div', {},
+      el('div', { class: 'passkey-name' },
+        pk.name,
+        isCurrent ? el('span', { class: 'badge badge-current', text: 'Used this session' }) : null,
+        pk.backedUp ? el('span', { class: 'badge', title: 'Synced across your devices', text: 'Synced' }) : null,
+      ),
+      el('div', { class: 'passkey-meta', text: metaParts.join(' · ') }),
+    ),
+    el('div', { class: 'passkey-actions' },
+      el('button', {
+        class: 'btn btn-secondary',
+        type: 'button',
+        disabled: busy,
+        'aria-label': `Rename ${pk.name}`,
+        onclick: () => startRename(pk.id),
+      }, 'Rename'),
+      el('button', {
+        class: 'btn btn-link-danger',
+        type: 'button',
+        disabled: busy,
+        'aria-label': `Delete ${pk.name}`,
+        onclick: () => confirmDelete(pk.id),
+      }, busy ? 'Deleting…' : 'Delete'),
+    ),
+  );
+}
+
+function renderRenameForm(pk, busy) {
+  const inputId = `rename-${pk.id}`;
+  const errorId = `${inputId}-error`;
+  const error = el('span', { class: 'field-error', id: errorId, role: 'alert' });
+
+  const input = el('input', {
+    id: inputId,
+    type: 'text',
+    value: pk.name,
+    maxlength: String(NAME_MAX),
+    autocomplete: 'off',
+    spellcheck: 'false',
+    required: true,
+    disabled: busy,
+    'aria-describedby': errorId,
+    dataset: { renameFor: pk.id },
+    onkeydown: (e) => {
+      if (e.key === 'Escape') {
+        e.preventDefault();
+        cancelRename();
+      }
+    },
+  });
+
+  return el('form', {
+    class: 'rename-form',
+    novalidate: true,
+    onsubmit: (e) => {
+      e.preventDefault();
+      saveRename(pk.id, input, error);
+    },
+  },
+    el('label', { for: inputId, class: 'visually-hidden', text: 'Passkey name' }),
+    input,
+    el('button', { class: 'btn', type: 'submit', disabled: busy }, busy ? 'Saving…' : 'Save'),
+    el('button', { class: 'btn btn-secondary', type: 'button', disabled: busy, onclick: cancelRename }, 'Cancel'),
+    error,
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Actions                                                             */
+/* ------------------------------------------------------------------ */
+
+function applySnapshot(data) {
+  state.rpId = data?.rpId ?? null;
+  state.user = data?.user ?? null;
+  state.currentCredentialId = data?.currentCredentialId ?? null;
+  state.passkeys = Array.isArray(data?.passkeys)
+    ? data.passkeys.filter((p) => p && typeof p.id === 'string').map((p) => ({ ...p, name: normalizeName(p.name) || 'Unnamed passkey' }))
+    : [];
+}
+
+async function load() {
+  renderLoading();
+  try {
+    const data = await api.list();
+    applySnapshot(data);
+    if (state.user?.displayName || state.user?.name) {
+      greeting.textContent = `Signed in as ${state.user.displayName || state.user.name}`
+        + (DEMO ? ' (demo mode — changes are not saved)' : '');
+    }
+    render();
+    // Reconcile the authenticator with the server's authoritative list, e.g.
+    // to clean up passkeys removed on another device.
+    signalAccepted(data);
+    signalUserDetails(data);
+  } catch (err) {
+    if (err.status !== 401) renderError(err.message);
+  }
+}
+
+function startRename(id) {
+  state.editingId = id;
+  render();
+}
+
+function cancelRename() {
+  const id = state.editingId;
+  state.editingId = null;
+  render();
+  root.querySelector(`li[data-id="${CSS.escape(id)}"] .btn-secondary`)?.focus();
+}
+
+async function saveRename(id, input, errorEl) {
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+  const name = normalizeName(input.value);
+  const problem = validateName(name, id);
+  if (problem) {
+    errorEl.textContent = problem;
+    input.setAttribute('aria-invalid', 'true');
+    input.focus();
+    return;
+  }
+  if (name === pk.name) {
+    cancelRename();
+    return;
+  }
+
+  state.busyIds.add(id);
+  render();
+  try {
+    const res = await api.rename(id, name);
+    pk.name = normalizeName(res?.passkey?.name) || name;
+    state.editingId = null;
+    toast(`Passkey renamed to “${pk.name}”.`);
+  } catch (err) {
+    if (err.status === 404) {
+      toast('That passkey was already removed.', 'error');
+      state.editingId = null;
+      await refreshAfterExternalChange();
+      return;
+    }
+    toast(err.message, 'error');
+  } finally {
+    state.busyIds.delete(id);
+    render();
+    if (state.editingId === id) {
+      const field = root.querySelector(`input[data-rename-for="${CSS.escape(id)}"]`);
+      if (field) field.value = name;
+    } else {
+      root.querySelector(`li[data-id="${CSS.escape(id)}"] .btn-secondary`)?.focus();
+    }
+  }
+}
+
+function confirmDelete(id) {
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+  document.getElementById('delete-dialog-name').textContent = pk.name;
+  document.getElementById('delete-dialog-last').hidden = state.passkeys.length > 1;
+  deleteDialog.returnValue = '';
+  deleteDialog.addEventListener(
+    'close',
+    () => {
+      if (deleteDialog.returnValue === 'confirm') deletePasskey(id);
+      else root.querySelector(`li[data-id="${CSS.escape(id)}"] .btn-link-danger`)?.focus();
+    },
+    { once: true },
+  );
+  deleteDialog.showModal();
+}
+
+async function deletePasskey(id) {
+  const pk = state.passkeys.find((p) => p.id === id);
+  if (!pk) return;
+  const rpId = state.rpId;
+  state.busyIds.add(id);
+  if (state.editingId === id) state.editingId = null;
+  render();
+
+  try {
+    await api.remove(id);
+  } catch (err) {
+    state.busyIds.delete(id);
+    if (err.status === 404) {
+      // Already gone server-side — still make sure the authenticator forgets it.
+      state.passkeys = state.passkeys.filter((p) => p.id !== id);
+      render();
+      await syncAfterDelete(id, rpId);
+      toast('That passkey had already been removed.');
+      return;
+    }
+    render();
+    toast(err.message, 'error');
+    return;
+  }
+
+  state.busyIds.delete(id);
+  state.passkeys = state.passkeys.filter((p) => p.id !== id);
+  render();
+  const synced = await syncAfterDelete(id, rpId);
+  toast(
+    synced || !canSignal
+      ? `“${pk.name}” was deleted.`
+      : `“${pk.name}” was deleted. You may also want to remove it from your password manager.`,
+  );
+  root.querySelector('.passkey-list .btn-secondary')?.focus();
+}
+
+/**
+ * After a deletion, re-fetch the authoritative list and signal it to the
+ * authenticator. If the re-fetch fails, fall back to signalling just the
+ * deleted credential as unknown.
+ */
+async function syncAfterDelete(deletedId, rpId) {
+  try {
+    const fresh = await api.list();
+    applySnapshot(fresh);
+    render();
+    if (!fresh.passkeys?.some((p) => p.id === deletedId) && (await signalAccepted(fresh))) return true;
+  } catch (err) {
+    console.warn('[passkeys] could not refresh list after delete', err);
+  }
+  return signalUnknown(rpId, deletedId);
+}
+
+async function refreshAfterExternalChange() {
+  try {
+    const fresh = await api.list();
+    applySnapshot(fresh);
+    render();
+    signalAccepted(fresh);
+  } catch { /* keep current view */ }
+}
+
+// Close the dialog when clicking the backdrop.
+deleteDialog.addEventListener('click', (e) => {
+  if (e.target === deleteDialog) deleteDialog.close('cancel');
+});
+
+if (DEMO) {
+  greeting.textContent = 'Demo mode — changes are not saved.';
+}
+
+load();
