+
+/* Dialogs */
+dialog {
+  border: none;
+  border-radius: 10px;
+  padding: 24px;
+  inline-size: min(440px, calc(100vw - 32px));
+  margin: auto;
+  color: var(--text);
+  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
+}
+
+dialog h2 {
+  color: var(--primary);
+  font-size: 1.25rem;
+  margin-bottom: 0.5rem;
+}
+
+dialog .field {
+  margin-top: 1rem;
+}
+
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  background: rgba(30, 20, 16, 0.55);
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 1.5rem;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
diff --git a/account/api.js b/account/api.js
new file mode 100644
index 0000000..9dfb653
--- /dev/null
+++ b/account/api.js
@@ -0,0 +1,87 @@
+// Thin client for the account/passkey endpoints.
+//
+//   GET    /api/user                       -> { name, displayName, rpId, userId }
+//   PUT    /api/user                       -> { name, displayName, rpId, userId }
+//   GET    /api/credentials                -> { rpId, userId, credentials: StoredPasskeyCredential[] }
+//   PUT    /api/credential/:id  { name }   -> StoredPasskeyCredential
+//   DELETE /api/credential/:id             -> { success: true }
+//   POST   /api/passkey/registration-options -> PublicKeyCredentialCreationOptionsJSON
+//   POST   /api/passkey/register  (credential.toJSON()) -> StoredPasskeyCredential
+//
+// All IDs (credential ids, userId) are unpadded Base64URL strings, and rpId is the
+// server's configured RP ID — the client never derives it from location.hostname.
+//
+// When the backend isn't deployed (e.g. this static preview), requests are served by
+// a localStorage-backed mock so the page remains usable.
+
+export class ApiError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.name = 'ApiError';
+    this.status = status;
+  }
+}
+
+let transportPromise;
+
+function getTransport() {
+  transportPromise ??= (async () => {
+    try {
+      const res = await fetch('/api/credentials', {
+        credentials: 'same-origin',
+        headers: { Accept: 'application/json' },
+      });
+      const isJson = res.headers.get('content-type')?.includes('application/json');
+      // 401/403 from a real backend should surface, not trigger the mock.
+      if (isJson || res.status === 401 || res.status === 403) return realRequest;
+    } catch {
+      // network error -> fall through to mock
+    }
+    const { mockRequest } = await import('./mock-server.js');
+    console.info('[passkeys] /api not available — using local mock backend.');
+    return mockRequest;
+  })();
+  return transportPromise;
+}
+
+async function realRequest(method, path, body) {
+  const res = await fetch(path, {
+    method,
+    credentials: 'same-origin',
+    headers: {
+      Accept: 'application/json',
+      ...(body !== undefined && { 'Content-Type': 'application/json' }),
+    },
+    body: body !== undefined ? JSON.stringify(body) : undefined,
+  });
+  let data = null;
+  try {
+    data = await res.json();
+  } catch {
+    // empty body
+  }
+  if (!res.ok) {
+    if (res.status === 401) {
+      location.assign(`/login?next=${encodeURIComponent(location.pathname)}`);
+    }
+    throw new ApiError(data?.error ?? `Request failed (${res.status})`, res.status);
+  }
+  return data;
+}
+
+async function request(method, path, body) {
+  const transport = await getTransport();
+  return transport(method, path, body);
+}
+
+export const getUser = () => request('GET', '/api/user');
+export const updateUser = (details) => request('PUT', '/api/user', details);
+export const listCredentials = () => request('GET', '/api/credentials');
+export const renameCredential = (id, name) =>
+  request('PUT', `/api/credential/${encodeURIComponent(id)}`, { name });
+export const deleteCredential = (id) =>
+  request('DELETE', `/api/credential/${encodeURIComponent(id)}`);
+export const getRegistrationOptions = () =>
+  request('POST', '/api/passkey/registration-options', { promotion: false });
+export const verifyRegistration = (credentialJSON) =>
+  request('POST', '/api/passkey/register', credentialJSON);
