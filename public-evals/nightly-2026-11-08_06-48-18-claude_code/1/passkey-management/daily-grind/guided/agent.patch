+
+.passkey-icon img {
+  inline-size: 28px;
+  block-size: 28px;
+}
+
+.passkey-icon svg {
+  inline-size: 24px;
+  block-size: 24px;
+}
+
+.passkey-info {
+  min-width: 0;
+}
+
+.passkey-name {
+  font-size: 1.05rem;
+  color: var(--primary);
+  overflow-wrap: anywhere;
+}
+
+.passkey-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  align-items: center;
+  font-size: 0.875rem;
+  color: var(--muted);
+}
+
+.passkey-synced {
+  font-size: 0.75rem;
+  background: #e8f5e9;
+  color: #2e7d32;
+  border-radius: 999px;
+  padding: 0 8px;
+}
+
+.passkey-dates {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 20px;
+  font-size: 0.85rem;
+  color: var(--muted);
