+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account · Passkeys | The Daily Grind</title>
+  <link rel="stylesheet" href="/account/account.css">
+  <script type="module" src="/account/passkeys.js"></script>
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="account-hero">
+    <h1>My Account</h1>
+    <p>Manage your profile and how you sign in to The Daily Grind.</p>
+  </header>
+
+  <main class="container account-layout">
+    <aside class="account-nav" aria-label="Account sections">
+      <ul>
+        <li><a href="/account/orders">Order history</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+        <li><a href="/account" aria-current="page">Sign-in &amp; security</a></li>
+      </ul>
+    </aside>
+
+    <div class="account-main">
+      <!-- Profile (username / display name) — synced to password managers via signalCurrentUserDetails -->
+      <section class="panel" aria-labelledby="profile-title">
+        <h2 id="profile-title">Profile</h2>
+        <form id="profile-form" class="profile-form">
+          <div class="field">
+            <label for="profile-name">Email / username</label>
+            <input id="profile-name" name="name" type="email" autocomplete="username" required>
+          </div>
+          <div class="field">
+            <label for="profile-display-name">Display name</label>
+            <input id="profile-display-name" name="displayName" type="text" autocomplete="name" required>
+          </div>
+          <div class="form-actions">
+            <button type="submit" class="btn">Save profile</button>
+            <p class="form-status" id="profile-status" role="status"></p>
+          </div>
+        </form>
+      </section>
+
+      <!-- Passkeys -->
+      <section class="panel" aria-labelledby="passkeys-title">
+        <div class="panel-header">
+          <div>
+            <h2 id="passkeys-title">Passkeys</h2>
+            <p class="panel-intro">Passkeys let you sign in with your fingerprint, face, screen lock or security key — no password needed.</p>
+          </div>
+          <button type="button" class="btn" id="create-passkey" hidden>Create a passkey</button>
+        </div>
+
+        <p class="notice" id="passkey-unsupported" hidden>
+          This browser doesn't support passkeys. You can still protect your account with
+          <a href="/account/two-step">two-step verification</a>.
+        </p>
+
+        <p class="form-status" id="passkey-status" role="status"></p>
+
+        <div id="passkey-list-region" aria-busy="true">
+          <p class="loading">Loading your passkeys…</p>
+        </div>
+      </section>
+    </div>
+  </main>
+
+  <!-- Rename passkey -->
+  <dialog id="rename-dialog" aria-labelledby="rename-title" closedby="any">
+    <form method="dialog" id="rename-form">
+      <h2 id="rename-title">Rename passkey</h2>
+      <p class="dialog-help">Choose a name that helps you recognise where this passkey is saved.</p>
+      <div class="field">
+        <label for="rename-input">Passkey name</label>
+        <input id="rename-input" name="passkeyName" type="text" maxlength="64" required autofocus autocomplete="off">
+      </div>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" formnovalidate class="btn btn-secondary">Cancel</button>
+        <button type="submit" value="save" class="btn">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <!-- Delete passkey confirmation -->
+  <dialog id="delete-dialog" aria-labelledby="delete-title" aria-describedby="delete-desc" closedby="any">
+    <form method="dialog">
+      <h2 id="delete-title">Delete passkey?</h2>
+      <p id="delete-desc" class="dialog-help">
+        You'll no longer be able to sign in with <strong id="delete-name"></strong>.
+        We'll also ask your password manager to remove it from this device where supported.
+      </p>
+      <div class="dialog-actions">
+        <button value="cancel" class="btn btn-secondary" autofocus>Keep passkey</button>
+        <button value="delete" class="btn btn-danger">Delete</button>
+      </div>
+    </form>
+  </dialog>
+
+  <template id="passkey-row-template">
+    <li class="passkey">
+      <span class="passkey-icon" aria-hidden="true"></span>
+      <div class="passkey-info">
+        <h3 class="passkey-name"></h3>
+        <p class="passkey-meta">
+          <span class="passkey-provider"></span>
+          <span class="passkey-synced" hidden>Synced</span>
+        </p>
+        <dl class="passkey-dates">
+          <div>
+            <dt>Created</dt>
+            <dd><time class="passkey-created"></time></dd>
+          </div>
+          <div class="passkey-last-used-wrap">
+            <dt>Last used</dt>
+            <dd class="passkey-last-used"></dd>
+          </div>
+        </dl>
+      </div>
+      <div class="passkey-actions">
+        <button type="button" class="btn btn-secondary btn-small" command="show-modal" commandfor="rename-dialog" aria-haspopup="dialog"></button>
+        <button type="button" class="btn btn-danger-outline btn-small" command="show-modal" commandfor="delete-dialog" aria-haspopup="dialog"></button>
+      </div>
+    </li>
+  </template>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
