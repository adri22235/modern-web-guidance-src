new file mode 100644
index 0000000..a32001c
--- /dev/null
+++ b/account/mock-server.js
@@ -0,0 +1,208 @@
+// Local stand-in for the account backend, persisted in localStorage.
+// It mirrors the real endpoint contracts in api.js. It does NOT verify
+// attestations — a production server must verify registrations with a vetted
+// WebAuthn library (challenge, origin, rpIdHash, UP flag, etc.).
+import { lookupProvider } from './aaguids.js';
+
+const STORAGE_KEY = 'dailygrind.mockAccount.v1';
+
+// In a real deployment this is a server constant that matches the rp.id used at
+// registration. The mock "server" runs on the same host, so it uses its own hostname.
+const RP_ID = location.hostname;
+const RP_NAME = 'The Daily Grind';
+
+const DAY = 24 * 60 * 60 * 1000;
+
+function toBase64Url(bytes) {
+  let bin = '';
+  for (const b of bytes) bin += String.fromCharCode(b);
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function fromBase64Url(str) {
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+}
+
+const randomId = (len = 16) => toBase64Url(crypto.getRandomValues(new Uint8Array(len)));
+
+function seed() {
+  const now = Date.now();
+  return {
+    user: {
+      name: 'jamie@example.com',
+      displayName: 'Jamie Rivera',
+      passkeyUserId: randomId(32),
+    },
+    credentials: [
+      {
+        id: randomId(),
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        name: 'Google Password Manager',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 120 * DAY,
+        lastUsedAt: now - 2 * DAY,
+      },
+      {
+        id: randomId(),
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        name: 'Work MacBook',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 45 * DAY,
+        lastUsedAt: now - 9 * DAY,
+      },
+      {
+        id: randomId(),
+        aaguid: 'cb69481e-8ff7-4039-93ec-0a2729a154a8',
+        name: 'YubiKey 5 Series',
+        credentialDeviceType: 'singleDevice',
+        credentialBackedUp: false,
+        transports: ['usb', 'nfc'],
+        registeredAt: now - 300 * DAY,
+      },
+    ],
+  };
+}
+
+function load() {
+  try {
+    const data = JSON.parse(localStorage.getItem(STORAGE_KEY));
+    if (data?.user && Array.isArray(data.credentials)) return data;
+  } catch {
+    // corrupt -> reseed
+  }
+  const data = seed();
+  save(data);
+  return data;
+}
+
+function save(data) {
+  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
+}
+
+class MockHttpError extends Error {
+  constructor(message, status) {
+    super(message);
+    this.name = 'ApiError';
+    this.status = status;
+  }
+}
+
+const userResponse = (user) => ({
+  name: user.name,
+  displayName: user.displayName,
+  rpId: RP_ID,
+  userId: user.passkeyUserId,
+});
+
+const clean = (s, max = 64) => (typeof s === 'string' ? s.trim().slice(0, max) : '');
+
+let pendingChallenge = null;
+
+export async function mockRequest(method, path, body) {
+  // Simulate network latency so loading states are exercised.
+  await new Promise((r) => setTimeout(r, 150));
+  const db = load();
+  const credMatch = path.match(/^\/api\/credential\/([^/]+)$/);
+
+  if (method === 'GET' && path === '/api/user') return userResponse(db.user);
+
+  if (method === 'PUT' && path === '/api/user') {
+    const name = clean(body?.name, 254);
+    const displayName = clean(body?.displayName, 64);
+    if (!name || !displayName) throw new MockHttpError('Name and display name are required.', 400);
+    db.user = { ...db.user, name, displayName };
+    save(db);
+    return userResponse(db.user);
+  }
+
+  if (method === 'GET' && path === '/api/credentials') {
+    return {
+      rpId: RP_ID,
+      userId: db.user.passkeyUserId,
+      credentials: [...db.credentials].sort((a, b) => b.registeredAt - a.registeredAt),
+    };
+  }
+
+  if (credMatch) {
+    const id = decodeURIComponent(credMatch[1]);
+    const cred = db.credentials.find((c) => c.id === id);
+    if (!cred) throw new MockHttpError('Credential not found.', 404);
+
+    if (method === 'PUT') {
+      const name = clean(body?.name);
+      if (!name) throw new MockHttpError('Please enter a name.', 400);
+      cred.name = name;
+      save(db);
+      return cred;
+    }
+    if (method === 'DELETE') {
+      db.credentials = db.credentials.filter((c) => c.id !== id);
+      save(db);
+      return { success: true };
+    }
+  }
+
+  if (method === 'POST' && path === '/api/passkey/registration-options') {
+    pendingChallenge = randomId(32);
+    return {
+      challenge: pendingChallenge,
+      rp: { id: RP_ID, name: RP_NAME },
+      user: {
+        id: db.user.passkeyUserId,
+        name: db.user.name,
+        displayName: db.user.displayName,
+      },
+      pubKeyCredParams: [
+        { type: 'public-key', alg: -7 },
+        { type: 'public-key', alg: -257 },
+      ],
+      excludeCredentials: db.credentials.map((c) => ({
+        type: 'public-key',
+        id: c.id,
+        transports: c.transports,
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        // authenticatorAttachment omitted: management flow allows security keys too.
+      },
+      timeout: 300000,
+      attestation: 'none',
+    };
+  }
+
+  if (method === 'POST' && path === '/api/passkey/register') {
+    if (!pendingChallenge || !body?.id || !body?.response?.authenticatorData) {
+      throw new MockHttpError('Registration could not be verified.', 400);
+    }
+    pendingChallenge = null;
+    // authenticatorData: rpIdHash(32) | flags(1) | signCount(4) | aaguid(16) | ...
+    const authData = fromBase64Url(body.response.authenticatorData);
+    const flags = authData[32];
+    const hex = [...authData.slice(37, 53)].map((b) => b.toString(16).padStart(2, '0')).join('');
+    const aaguid = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+    const provider = lookupProvider(aaguid);
+    const cred = {
+      id: body.id,
+      aaguid,
+      name: provider.name,
+      providerIcon: provider.icon_light,
+      credentialDeviceType: flags & 0x08 ? 'multiDevice' : 'singleDevice',
+      credentialBackedUp: Boolean(flags & 0x10),
+      transports: body.response.transports ?? [],
+      registeredAt: Date.now(),
+    };
+    db.credentials.push(cred);
+    save(db);
+    return cred;
+  }
+
+  throw new MockHttpError('Not found', 404);
+}
diff --git a/account/passkeys.js b/account/passkeys.js
new file mode 100644
index 0000000..d8cbf25
--- /dev/null
+++ b/account/passkeys.js
@@ -0,0 +1,447 @@
+import * as api from './api.js';
+import { lookupProvider } from './aaguids.js';
+
+// ---------------------------------------------------------------------------
+// Progressive-enhancement polyfills (loaded only when needed)
+// ---------------------------------------------------------------------------
+
+// Invoker Commands (command / commandfor) drive the dialogs.
+const invokersReady = (async () => {
+  if ('commandForElement' in HTMLButtonElement.prototype) return;
+  try {
+    await import('https://esm.run/invokers-polyfill');
+  } catch (err) {
+    console.warn('Invoker commands polyfill failed to load; using click fallback.', err);
+    installCommandFallback();
+  }
+})();
+
+// Minimal stand-in if the polyfill can't be fetched: dispatch `command` and open the dialog.
+function installCommandFallback() {
+  document.addEventListener('click', (event) => {
+    const button = event.target.closest?.('button[commandfor][command]');
+    if (!button) return;
+    const target = document.getElementById(button.getAttribute('commandfor'));
+    const command = button.getAttribute('command');
+    if (!target) return;
+    const evt = new Event('command', { cancelable: true });
+    Object.assign(evt, { command, source: button });
+    target.dispatchEvent(evt);
+    if (!evt.defaultPrevented && command === 'show-modal' && !target.open) target.showModal();
+  });
+}
+
+// WebAuthn JSON helpers + getClientCapabilities for browsers that lack them.
+const webauthnReady = (async () => {
+  if (!window.PublicKeyCredential) return;
+  const needsPolyfill =
+    !PublicKeyCredential.getClientCapabilities ||
+    !PublicKeyCredential.parseCreationOptionsFromJSON ||
+    !PublicKeyCredential.prototype.toJSON;
+  if (!needsPolyfill) return;
+  try {
+    await import('https://esm.run/webauthn-polyfills');
+  } catch (err) {
+    console.warn('webauthn-polyfills failed to load.', err);
+  }
+})();
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+const $ = (sel) => document.querySelector(sel);
+
+const els = {
+  listRegion: $('#passkey-list-region'),
+  rowTemplate: $('#passkey-row-template'),
+  passkeyStatus: $('#passkey-status'),
+  createBtn: $('#create-passkey'),
+  unsupported: $('#passkey-unsupported'),
+  heading: $('#passkeys-title'),
+  renameDialog: $('#rename-dialog'),
+  renameInput: $('#rename-input'),
+  deleteDialog: $('#delete-dialog'),
+  deleteName: $('#delete-name'),
+  profileForm: $('#profile-form'),
+  profileStatus: $('#profile-status'),
+};
+
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+const relFmt = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
+
+function formatRelative(epoch) {
+  const days = Math.round((epoch - Date.now()) / 86_400_000);
+  if (Math.abs(days) < 1) return relFmt.format(0, 'day');
+  if (Math.abs(days) < 30) return relFmt.format(days, 'day');
+  return dateFmt.format(epoch);
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value) {
+  return typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+function setStatus(el, message, tone = '') {
+  el.textContent = message;
+  if (tone) el.dataset.tone = tone;
+  else delete el.dataset.tone;
+}
+
+function setBusy(button, busy) {
+  if (busy) button.setAttribute('aria-disabled', 'true');
+  else button.removeAttribute('aria-disabled');
+}
+
+const isBusy = (button) => button.getAttribute('aria-disabled') === 'true';
+
+const KEY_ICON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
+  stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="15" r="4"/>
+  <path d="M10.85 12.15 19 4M18 5l2 2M15 8l2 2"/></svg>`;
+
+// ---------------------------------------------------------------------------
+// Signal API sync (passive, never fatal)
+// ---------------------------------------------------------------------------
+
+async function syncAcceptedCredentials({ rpId, userId, credentials }) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn('signalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // server-provided; never window.location.hostname
+      userId,
+      allAcceptedCredentialIds,
+    });
+  } catch (err) {
+    console.warn('signalAllAcceptedCredentials sync warning:', err);
+  }
+}
+
+async function syncCurrentUserDetails({ rpId, userId, name, displayName }) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalCurrentUserDetails) return;
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn('signalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.');
+    return;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName });
+  } catch (err) {
+    console.warn('signalCurrentUserDetails sync warning:', err);
+  }
+}
+
+async function signalUnknown(rpId, credentialId) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalUnknownCredential) return;
+  if (!rpId || !isValidBase64Url(credentialId)) return;
+  try {
+    await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId });
+  } catch (err) {
+    console.warn('signalUnknownCredential sync warning:', err);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Passkey list
+// ---------------------------------------------------------------------------
+
+/** @type {Map<string, any>} */
+let credentialsById = new Map();
+
+function renderPasskeys(credentials) {
+  credentialsById = new Map(credentials.map((c) => [c.id, c]));
+  els.listRegion.setAttribute('aria-busy', 'false');
+
+  if (credentials.length === 0) {
+    const empty = document.createElement('p');
+    empty.className = 'empty-state';
+    empty.textContent = 'No passkeys found. Create one to sign in faster next time.';
+    els.listRegion.replaceChildren(empty);
+    return;
+  }
+
+  const list = document.createElement('ul');
+  list.className = 'passkey-list';
+  list.setAttribute('aria-labelledby', 'passkeys-title');
+
+  for (const cred of credentials) {
+    const row = els.rowTemplate.content.firstElementChild.cloneNode(true);
+    const provider = lookupProvider(cred.aaguid);
+    const providerName = provider.name;
+    const displayName = cred.name || providerName;
+    row.dataset.id = cred.id;
+
+    const icon = row.querySelector('.passkey-icon');
+    const iconSrc = cred.providerIcon ?? provider.icon_light;
+    if (iconSrc) {
+      const img = document.createElement('img');
+      img.src = iconSrc;
+      img.alt = '';
+      icon.append(img);
+    } else {
+      icon.innerHTML = KEY_ICON;
+    }
+
+    row.querySelector('.passkey-name').textContent = displayName;
+    row.querySelector('.passkey-provider').textContent =
+      displayName === providerName ? (cred.credentialDeviceType === 'singleDevice' ? 'Security key / this device only' : 'Passkey') : providerName;
+    row.querySelector('.passkey-synced').hidden = !cred.credentialBackedUp;
+
+    const created = row.querySelector('.passkey-created');
+    created.dateTime = new Date(cred.registeredAt).toISOString();
+    created.textContent = dateFmt.format(cred.registeredAt);
+
+    const lastUsed = row.querySelector('.passkey-last-used');
+    if (cred.lastUsedAt) {
+      const t = document.createElement('time');
+      t.dateTime = new Date(cred.lastUsedAt).toISOString();
+      t.title = dateFmt.format(cred.lastUsedAt);
+      t.textContent = formatRelative(cred.lastUsedAt);
+      lastUsed.replaceChildren(t);
+    } else {
+      lastUsed.textContent = 'Never';
+    }
+
+    const [renameBtn, deleteBtn] = row.querySelectorAll('.passkey-actions button');
+    for (const [btn, verb] of [[renameBtn, 'Rename'], [deleteBtn, 'Delete']]) {
+      btn.dataset.id = cred.id;
+      btn.dataset.action = verb.toLowerCase();
+      btn.textContent = verb;
+      btn.setAttribute('aria-label', `${verb} ${displayName}`);
+    }
+
+    list.append(row);
+  }
+
+  els.listRegion.replaceChildren(list);
+}
+
+async function refreshPasskeys({ sync = true } = {}) {
+  const data = await api.listCredentials();
+  renderPasskeys(data.credentials);
+  if (sync) await syncAcceptedCredentials(data);
+  return data;
+}
+
+function focusRowAction(id, action) {
+  const btn = els.listRegion.querySelector(`button[data-action="${action}"][data-id="${CSS.escape(id)}"]`);
+  if (btn) btn.focus();
+  else {
+    els.heading.tabIndex = -1;
+    els.heading.focus();
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Rename dialog
+// ---------------------------------------------------------------------------
+
+let renameTargetId = null;
+
+els.renameDialog.addEventListener('command', (event) => {
+  const id = event.source?.dataset.id;
+  const cred = id && credentialsById.get(id);
+  if (!cred) {
+    event.preventDefault();
+    return;
+  }
+  renameTargetId = id;
+  els.renameDialog.returnValue = '';
+  els.renameInput.value = cred.name || lookupProvider(cred.aaguid).name;
+  queueMicrotask(() => els.renameInput.select());
+});
+
+els.renameDialog.addEventListener('close', async () => {
+  const choice = els.renameDialog.returnValue;
+  els.renameDialog.returnValue = '';
+  const id = renameTargetId;
+  renameTargetId = null;
+  if (choice !== 'save' || !id) return;
+
+  const name = els.renameInput.value.trim();
+  const previous = credentialsById.get(id)?.name;
+  if (!name || name === previous) return;
+
+  setStatus(els.passkeyStatus, 'Saving name…');
+  try {
+    // A passkey nickname is a server-side label only; no Signal API call needed.
+    await api.renameCredential(id, name);
+    await refreshPasskeys({ sync: false });
+    setStatus(els.passkeyStatus, `Passkey renamed to “${name}”.`, 'success');
+  } catch (err) {
+    setStatus(els.passkeyStatus, `Couldn't rename passkey: ${err.message}`, 'error');
+    if (err.status === 404) await refreshPasskeys();
+  }
+  focusRowAction(id, 'rename');
+});
+
+// ---------------------------------------------------------------------------
+// Delete dialog
+// ---------------------------------------------------------------------------
+
+let deleteTargetId = null;
+
+els.deleteDialog.addEventListener('command', (event) => {
+  const id = event.source?.dataset.id;
+  const cred = id && credentialsById.get(id);
+  if (!cred) {
+    event.preventDefault();
+    return;
+  }
+  deleteTargetId = id;
+  els.deleteDialog.returnValue = '';
+  els.deleteName.textContent = cred.name || lookupProvider(cred.aaguid).name;
+});
+
+els.deleteDialog.addEventListener('close', async () => {
+  const choice = els.deleteDialog.returnValue;
+  els.deleteDialog.returnValue = '';
+  const id = deleteTargetId;
+  deleteTargetId = null;
+  if (choice !== 'delete' || !id) return;
+
+  const name = credentialsById.get(id)?.name ?? 'Passkey';
+  setStatus(els.passkeyStatus, 'Deleting passkey…');
+  try {
+    await api.deleteCredential(id);
+    setStatus(els.passkeyStatus, `“${name}” was deleted.`, 'success');
+  } catch (err) {
+    if (err.status !== 404) {
+      setStatus(els.passkeyStatus, `Couldn't delete passkey: ${err.message}`, 'error');
+      focusRowAction(id, 'delete');
+      return;
+    }
+    // Already gone on the server — still resync below.
+    setStatus(els.passkeyStatus, `“${name}” was already removed.`);
+  }
+  // Re-list and tell the password manager which credentials remain valid,
+  // so the deleted passkey stops being offered at sign-in.
+  try {
+    await refreshPasskeys({ sync: true });
+  } catch (err) {
+    setStatus(els.passkeyStatus, `Passkey deleted, but the list couldn't be refreshed: ${err.message}`, 'error');
+  }
+  els.heading.tabIndex = -1;
+  els.heading.focus();
+});
+
+// ---------------------------------------------------------------------------
+// Create passkey
+// ---------------------------------------------------------------------------
+
+async function setupCreateButton() {
+  await webauthnReady;
+  let supported = false;
+  if (window.PublicKeyCredential?.getClientCapabilities) {
+    try {
+      const caps = await PublicKeyCredential.getClientCapabilities();
+      supported = Boolean(caps.passkeyPlatformAuthenticator && caps.conditionalGet);
+    } catch {
+      supported = false;
+    }
+  }
+  els.createBtn.hidden = !supported;
+  els.unsupported.hidden = supported;
+}
+
+els.createBtn.addEventListener('click', async () => {
+  if (isBusy(els.createBtn)) return;
+  setBusy(els.createBtn, true);
+  setStatus(els.passkeyStatus, '');
+  try {
+    const optionsJSON = await api.getRegistrationOptions();
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+    let credential;
+    try {
+      credential = await navigator.credentials.create({ publicKey });
+    } catch (err) {
+      const messages = {
+        InvalidStateError: 'A passkey from this provider is already registered to your account.',
+        SecurityError: 'Passkeys aren’t available on this site configuration.',
+      };
+      if (messages[err.name]) setStatus(els.passkeyStatus, messages[err.name], 'error');
+      // NotAllowedError / AbortError: user cancelled — stay quiet.
+      return;
+    }
+
+    const encoded = credential.toJSON();
+    try {
+      await api.verifyRegistration(encoded);
+    } catch (err) {
+      // Server rejected it: tell the password manager to drop the orphaned passkey.
+      await signalUnknown(publicKey.rp.id, encoded.id);
+      setStatus(els.passkeyStatus, `Couldn't save your passkey: ${err.message}`, 'error');
+      return;
+    }
+
+    await refreshPasskeys({ sync: true });
+    setStatus(els.passkeyStatus, 'Passkey created. You can now use it to sign in.', 'success');
+    focusRowAction(encoded.id, 'rename');
+  } catch (err) {
+    setStatus(els.passkeyStatus, `Couldn't start passkey creation: ${err.message}`, 'error');
+  } finally {
+    setBusy(els.createBtn, false);
+  }
+});
+
+// ---------------------------------------------------------------------------
+// Profile (name / displayName) -> signalCurrentUserDetails
+// ---------------------------------------------------------------------------
+
+els.profileForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const submit = els.profileForm.querySelector('[type="submit"]');
+  if (isBusy(submit)) return;
+  const form = new FormData(els.profileForm);
+  const name = String(form.get('name')).trim();
+  const displayName = String(form.get('displayName')).trim();
+
+  setBusy(submit, true);
+  setStatus(els.profileStatus, 'Saving…');
+  try {
+    const updated = await api.updateUser({ name, displayName });
+    setStatus(els.profileStatus, 'Profile saved.', 'success');
+    // Update the username/display name shown in the user's passkey provider.
+    await syncCurrentUserDetails(updated);
+  } catch (err) {
+    setStatus(els.profileStatus, `Couldn't save profile: ${err.message}`, 'error');
+  } finally {
+    setBusy(submit, false);
+  }
+});
+
+async function loadProfile() {
+  try {
+    const user = await api.getUser();
+    els.profileForm.elements.name.value = user.name ?? '';
+    els.profileForm.elements.displayName.value = user.displayName ?? '';
+  } catch (err) {
+    setStatus(els.profileStatus, `Couldn't load your profile: ${err.message}`, 'error');
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Init (module scripts are deferred, so the DOM is ready)
+// ---------------------------------------------------------------------------
+
+setupCreateButton();
+loadProfile();
+invokersReady.then(async () => {
+  try {
+    // Initial load: also prune passkeys the server no longer accepts from the provider.
