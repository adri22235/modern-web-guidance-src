new file mode 100644
index 0000000..dedb380
--- /dev/null
+++ b/src/pages/api/account/passkeys/[id].ts
@@ -0,0 +1,41 @@
+import type { APIRoute } from 'astro';
+import {
+  MAX_PASSKEY_NAME_LENGTH,
+  deleteCredential,
+  getSessionUser,
+  json,
+  normalizePasskeyName,
+  renameCredential,
+} from '../../../../lib/passkeys';
+
+/** Rename a passkey (server-side nickname only). */
+export const PATCH: APIRoute = async ({ params, request, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  // Requiring a JSON body forces a CORS preflight for cross-site requests.
+  if (!request.headers.get('content-type')?.includes('application/json')) {
+    return json({ error: 'Expected application/json' }, 415);
+  }
+
+  const body = await request.json().catch(() => null);
+  const name = normalizePasskeyName(body?.name);
+  if (!name) {
+    return json({ error: `Name must be 1–${MAX_PASSKEY_NAME_LENGTH} characters.` }, 400);
+  }
+
+  const updated = renameCredential(user.username, params.id ?? '', name);
+  if (!updated) return json({ error: 'Passkey not found' }, 404);
+  return json(updated);
+};
+
+/** Remove a passkey from the reader's account. */
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSessionUser(session);
+  if (!user) return json({ error: 'Not signed in' }, 401);
+
+  if (!deleteCredential(user.username, params.id ?? '')) {
+    return json({ error: 'Passkey not found' }, 404);
+  }
+  return json({ success: true });
+};
