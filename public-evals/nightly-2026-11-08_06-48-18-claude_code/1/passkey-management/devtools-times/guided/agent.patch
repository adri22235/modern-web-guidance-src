+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ session, redirect }) => {
+  session?.delete('user');
+  await session?.regenerate();
+  return redirect(`${import.meta.env.BASE_URL}`, 303);
+};
