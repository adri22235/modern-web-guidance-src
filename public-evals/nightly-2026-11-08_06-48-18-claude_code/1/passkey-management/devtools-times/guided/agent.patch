diff --git a/src/lib/aaguids.ts b/src/lib/aaguids.ts
new file mode 100644
index 0000000..e9de054
--- /dev/null
+++ b/src/lib/aaguids.ts
@@ -0,0 +1,35 @@
+/**
+ * Small local subset of the community AAGUID registry
+ * (https://github.com/passkeydeveloper/passkey-authenticator-aaguids).
+ * Used only as a UX hint to label passkeys in the management list.
+ */
+export type ProviderKind = 'password-manager' | 'platform' | 'security-key';
+
+export interface PasskeyProvider {
+  name: string;
+  kind: ProviderKind;
+}
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+const AAGUID_REGISTRY: Record<string, PasskeyProvider> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager', kind: 'password-manager' },
+  'adce0002-35bc-c60a-648b-0b25f1f05503': { name: 'Chrome on Mac', kind: 'platform' },
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': { name: 'iCloud Keychain', kind: 'password-manager' },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': { name: 'iCloud Keychain (Managed)', kind: 'password-manager' },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': { name: 'Windows Hello', kind: 'platform' },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': { name: 'Windows Hello', kind: 'platform' },
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': { name: 'Windows Hello', kind: 'platform' },
+  'bada5566-a7aa-401f-bd96-45619a55120d': { name: '1Password', kind: 'password-manager' },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': { name: 'Bitwarden', kind: 'password-manager' },
+  '531126d6-e717-415c-9320-3d9aa6981239': { name: 'Dashlane', kind: 'password-manager' },
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': { name: 'YubiKey 5 Series with NFC', kind: 'security-key' },
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': { name: 'YubiKey 5 Series', kind: 'security-key' },
+};
+
+export function lookupProvider(aaguid: string | undefined): PasskeyProvider {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: 'Unknown passkey provider', kind: 'platform' };
+  }
+  return AAGUID_REGISTRY[aaguid.toLowerCase()] ?? { name: 'Unknown passkey provider', kind: 'platform' };
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..e56228f
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,156 @@
+import { randomBytes } from 'node:crypto';
+
+/**
+ * Server-side passkey credential store.
+ *
+ * NOTE: This is an in-memory stand-in for a real database table. It is keyed
+ * by the signed-in reader's username and resets whenever the server restarts.
+ * Swap the functions below for real DB queries when persistence is needed;
+ * the API routes and UI only depend on this module's exported functions.
+ */
+
+export interface StoredPasskeyCredential {
+  /** Credential ID as an unpadded Base64URL string. */
+  id: string;
+  /** User-facing nickname. Defaults to the provider name derived from the AAGUID. */
+  name: string;
+  /** Authenticator model identifier (UX hint only — never used for security decisions). */
+  aaguid: string;
+  /** Epoch milliseconds. */
+  registeredAt: number;
+  /** Epoch milliseconds, if the passkey has been used to sign in. */
+  lastUsedAt?: number;
+}
+
+export interface SessionUser {
+  username: string;
+}
+
+interface AccountRecord {
+  /** WebAuthn user handle as an unpadded Base64URL string. */
+  passkeyUserId: string;
+  credentials: StoredPasskeyCredential[];
+}
+
+const accounts = new Map<string, AccountRecord>();
+
+const DAY = 24 * 60 * 60 * 1000;
+
+const toBase64Url = (bytes: Buffer) => bytes.toString('base64url');
+
+/**
+ * Demo credentials so the management UI has something to show until a
+ * registration flow is wired up. IDs are genuine random Base64URL values so
+ * they are accepted by the WebAuthn Signal API.
+ */
+function seedCredentials(): StoredPasskeyCredential[] {
+  const now = Date.now();
+  return [
+    {
+      id: toBase64Url(randomBytes(32)),
+      name: 'Google Password Manager',
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      registeredAt: now - 120 * DAY,
+      lastUsedAt: now - 2 * DAY,
+    },
+    {
+      id: toBase64Url(randomBytes(32)),
+      name: 'iCloud Keychain',
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      registeredAt: now - 45 * DAY,
+      lastUsedAt: now - 9 * DAY,
+    },
+    {
+      id: toBase64Url(randomBytes(32)),
+      name: 'Office YubiKey',
+      aaguid: 'fa2b99dc-9e39-4257-8f92-4a30d23c4118',
+      registeredAt: now - 300 * DAY,
+    },
+  ];
+}
+
+function getAccount(username: string): AccountRecord {
+  let account = accounts.get(username);
+  if (!account) {
+    account = {
+      passkeyUserId: toBase64Url(randomBytes(32)),
+      credentials: seedCredentials(),
+    };
+    accounts.set(username, account);
+  }
+  return account;
+}
+
+export function getPasskeyUserId(username: string): string {
+  return getAccount(username).passkeyUserId;
+}
+
+export function listCredentials(username: string): StoredPasskeyCredential[] {
+  return [...getAccount(username).credentials].sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export function renameCredential(
+  username: string,
+  credentialId: string,
+  name: string,
+): StoredPasskeyCredential | undefined {
+  const cred = getAccount(username).credentials.find((c) => c.id === credentialId);
+  if (!cred) return undefined;
+  cred.name = name;
+  return cred;
+}
+
+export function deleteCredential(username: string, credentialId: string): boolean {
+  const account = getAccount(username);
+  const before = account.credentials.length;
+  account.credentials = account.credentials.filter((c) => c.id !== credentialId);
+  return account.credentials.length !== before;
+}
+
+export const MAX_PASSKEY_NAME_LENGTH = 64;
+
+/** Trims and validates a passkey nickname. Returns `null` when invalid. */
+export function normalizePasskeyName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const name = value.replace(/\s+/g, ' ').trim();
+  if (!name || name.length > MAX_PASSKEY_NAME_LENGTH) return null;
+  return name;
+}
+
+/**
+ * The Relying Party ID passkeys are registered against. Configure it with the
+ * PASSKEY_RP_ID environment variable (e.g. a registrable parent domain); falls
+ * back to the hostname the server was reached on. The client always receives
+ * this value from the server instead of guessing it from window.location.
+ */
+export function getRpId(url: URL): string {
+  return process.env.PASSKEY_RP_ID || url.hostname;
+}
+
+export interface PasskeyListPayload {
+  rpId: string;
+  userId: string;
+  credentials: StoredPasskeyCredential[];
+}
+
+export function buildPasskeyListPayload(username: string, url: URL): PasskeyListPayload {
+  return {
+    rpId: getRpId(url),
+    userId: getPasskeyUserId(username),
+    credentials: listCredentials(username),
+  };
+}
+
+export async function getSessionUser(
+  session: { get: (key: string) => Promise<unknown> } | undefined,
+): Promise<SessionUser | null> {
+  const user = (await session?.get('user')) as SessionUser | undefined;
+  return user && typeof user.username === 'string' ? user : null;
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
