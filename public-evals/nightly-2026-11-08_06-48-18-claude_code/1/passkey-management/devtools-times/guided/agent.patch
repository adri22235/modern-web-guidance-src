diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..e7d3456
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,384 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import {
+  ComputerDesktopIcon,
+  KeyIcon,
+  PencilSquareIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+} from '@heroicons/react/24/outline';
+import { lookupProvider, type ProviderKind } from '../lib/aaguids';
+
+export interface PasskeyCredential {
+  id: string;
+  name: string;
+  aaguid: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface PasskeyListPayload {
+  rpId: string;
+  userId: string;
+  credentials: PasskeyCredential[];
+}
+
+interface Props {
+  initialData: PasskeyListPayload;
+  maxNameLength: number;
+}
+
+const API_BASE = `${import.meta.env.BASE_URL}api/account/passkeys`;
+
+// --- WebAuthn Signal API helpers -------------------------------------------
+
+type SignalCapablePublicKeyCredential = {
+  signalAllAcceptedCredentials?: (options: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+};
+
+/** Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, length % 4 !== 1. */
+function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+/**
+ * Tell the browser / password manager which passkeys the server still
+ * accepts so it can hide or remove ones that were deleted here. This is a
+ * passive progressive enhancement: failures are logged as warnings only.
+ */
+async function syncAcceptedCredentials({ rpId, userId, credentials }: PasskeyListPayload) {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) return;
+  const PKC = window.PublicKeyCredential as unknown as SignalCapablePublicKeyCredential;
+  if (typeof PKC.signalAllAcceptedCredentials !== 'function') return;
+
+  const allAcceptedCredentialIds = credentials.map((c) => c.id);
+  if (!rpId || !isValidBase64Url(userId) || !allAcceptedCredentialIds.every(isValidBase64Url)) {
+    console.warn(
+      'signalAllAcceptedCredentials skipped: server rpId and valid Base64URL user/credential IDs are required.',
+    );
+    return;
+  }
+
+  try {
+    // rpId comes from the server; never derived from window.location.hostname.
+    await PKC.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.warn('signalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+// --- Presentation helpers ---------------------------------------------------
+
+const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' });
+
+function FormattedDate({ epoch }: { epoch: number }) {
+  return (
+    <time dateTime={new Date(epoch).toISOString()} suppressHydrationWarning>
+      {dateFormatter.format(epoch)}
+    </time>
+  );
+}
+
+function ProviderIcon({ kind }: { kind: ProviderKind }) {
+  const Icon =
+    kind === 'security-key' ? KeyIcon : kind === 'password-manager' ? ShieldCheckIcon : ComputerDesktopIcon;
+  return (
+    <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-700">
+      <Icon className="h-5 w-5" aria-hidden="true" />
+    </span>
+  );
+}
+
+async function readError(response: Response, fallback: string) {
+  const data = await response.json().catch(() => null);
+  return (data && typeof data.error === 'string' && data.error) || fallback;
+}
+
+// --- Component --------------------------------------------------------------
+
+export default function PasskeyManager({ initialData, maxNameLength }: Props) {
+  const [data, setData] = useState<PasskeyListPayload>(initialData);
+  const [status, setStatus] = useState<{ type: 'success' | 'error'; message: string } | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [renameTarget, setRenameTarget] = useState<PasskeyCredential | null>(null);
+  const [renameValue, setRenameValue] = useState('');
+  const [renameError, setRenameError] = useState<string | null>(null);
+  const [deleteTarget, setDeleteTarget] = useState<PasskeyCredential | null>(null);
+
+  const renameDialogRef = useRef<HTMLDialogElement>(null);
+  const deleteDialogRef = useRef<HTMLDialogElement>(null);
+  const ids = useId();
+  const renameTitleId = `${ids}-rename-title`;
+  const renameInputId = `${ids}-rename-input`;
+  const renameErrorId = `${ids}-rename-error`;
+  const deleteTitleId = `${ids}-delete-title`;
+  const deleteDescId = `${ids}-delete-desc`;
+
+  // Sync the authenticator with the server's list as soon as the panel mounts.
+  useEffect(() => {
+    void syncAcceptedCredentials(initialData);
+  }, [initialData]);
+
+  async function refreshList(): Promise<PasskeyListPayload | null> {
+    const response = await fetch(API_BASE, { headers: { Accept: 'application/json' } });
+    if (!response.ok) return null;
+    const next = (await response.json()) as PasskeyListPayload;
+    setData(next);
+    return next;
+  }
+
+  function openRename(credential: PasskeyCredential) {
+    setRenameTarget(credential);
+    setRenameValue(credential.name);
+    setRenameError(null);
+    renameDialogRef.current?.showModal();
+  }
+
+  // Note: showModal() focuses the first focusable control — the name input
+  // for rename and the safe "Cancel" action for removal.
+  function openDelete(credential: PasskeyCredential) {
+    setDeleteTarget(credential);
+    deleteDialogRef.current?.showModal();
+  }
+
+  async function submitRename(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!renameTarget) return;
+    const name = renameValue.replace(/\s+/g, ' ').trim();
+    if (!name) {
+      setRenameError('Please enter a name.');
+      return;
+    }
+    if (name === renameTarget.name) {
+      renameDialogRef.current?.close();
+      return;
+    }
+
+    setBusy(true);
+    setRenameError(null);
+    try {
+      const response = await fetch(`${API_BASE}/${encodeURIComponent(renameTarget.id)}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify({ name }),
+      });
+      if (!response.ok) {
+        setRenameError(await readError(response, 'Could not rename this passkey.'));
+        return;
+      }
+      // Renaming is a server-side label only; no Signal API call is needed.
+      await refreshList();
+      renameDialogRef.current?.close();
+      setStatus({ type: 'success', message: `Passkey renamed to “${name}”.` });
+    } catch {
+      setRenameError('Network error. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function handleDeleteClose() {
+    const dialog = deleteDialogRef.current;
+    if (!dialog) return;
+    const choice = dialog.returnValue;
+    dialog.returnValue = '';
+    const target = deleteTarget;
+    if (choice !== 'delete' || !target) return;
+
+    setBusy(true);
+    try {
+      const response = await fetch(`${API_BASE}/${encodeURIComponent(target.id)}`, {
+        method: 'DELETE',
+        headers: { Accept: 'application/json' },
+      });
+      if (!response.ok) {
+        setStatus({ type: 'error', message: await readError(response, 'Could not remove this passkey.') });
+        return;
+      }
+      const next = await refreshList();
+      setStatus({ type: 'success', message: `“${target.name}” was removed from your account.` });
+      // Let the password manager know this credential is gone.
+      if (next) await syncAcceptedCredentials(next);
+    } catch {
+      setStatus({ type: 'error', message: 'Network error. Please try again.' });
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const { credentials } = data;
+
+  return (
+    <section aria-labelledby={`${ids}-heading`} className="rounded-lg border border-gray-200 bg-white">
+      <header className="border-b border-gray-200 px-6 py-4">
+        <h2 id={`${ids}-heading`} className="text-lg font-semibold text-gray-900">
+          Passkeys
+        </h2>
+        <p className="mt-1 text-sm text-gray-600">
+          Passkeys let you sign in with your fingerprint, face, screen lock, or a security key. Rename them
+          so they're easy to recognize, and remove any you no longer use — your browser or password manager
+          will be updated to match where supported.
+        </p>
+      </header>
+
+      <div aria-live="polite" role="status" className="px-6 empty:hidden">
+        {status && (
+          <p
+            className={`mt-4 rounded-md p-3 text-sm ${
+              status.type === 'success' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'
+            }`}
+          >
+            {status.message}
+          </p>
+        )}
+      </div>
+
+      {credentials.length === 0 ? (
+        <p className="px-6 py-8 text-center text-sm text-gray-600">No passkeys found on your account.</p>
+      ) : (
+        <ul className="divide-y divide-gray-200" aria-busy={busy}>
+          {credentials.map((credential) => {
+            const provider = lookupProvider(credential.aaguid);
+            return (
+              <li key={credential.id} className="flex flex-wrap items-center gap-4 px-6 py-4">
+                <ProviderIcon kind={provider.kind} />
+                <div className="min-w-0 flex-1">
+                  <p className="truncate font-medium text-gray-900">{credential.name}</p>
+                  {provider.name !== credential.name && (
+                    <p className="truncate text-xs text-gray-500">{provider.name}</p>
+                  )}
+                  <p className="mt-1 text-xs text-gray-600">
+                    Created <FormattedDate epoch={credential.registeredAt} />
+                    {' · '}
+                    {credential.lastUsedAt ? (
+                      <>
+                        Last used <FormattedDate epoch={credential.lastUsedAt} />
+                      </>
+                    ) : (
+                      'Never used'
+                    )}
+                  </p>
+                </div>
+                <div className="flex gap-2">
+                  <button
+                    type="button"
+                    onClick={() => openRename(credential)}
+                    disabled={busy}
+                    aria-label={`Rename ${credential.name}`}
+                    className="inline-flex items-center gap-1 rounded-md border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50"
+                  >
+                    <PencilSquareIcon className="h-4 w-4" aria-hidden="true" />
+                    Rename
+                  </button>
+                  <button
+                    type="button"
+                    onClick={() => openDelete(credential)}
+                    disabled={busy}
+                    aria-label={`Remove ${credential.name}`}
+                    className="inline-flex items-center gap-1 rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700 disabled:opacity-50"
+                  >
+                    <TrashIcon className="h-4 w-4" aria-hidden="true" />
+                    Remove
+                  </button>
+                </div>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+
+      {/* Rename dialog */}
+      <dialog
+        ref={renameDialogRef}
+        aria-labelledby={renameTitleId}
+        {...({ closedby: 'any' } as Record<string, string>) /* light dismiss where supported; Esc works everywhere */}
+        className="m-auto w-[min(28rem,calc(100%-2rem))] rounded-lg p-0 shadow-xl backdrop:bg-black/40"
+      >
+        <form onSubmit={submitRename} className="space-y-4 p-6" noValidate>
+          <h3 id={renameTitleId} className="text-lg font-semibold text-gray-900">
+            Rename passkey
+          </h3>
+          <div>
+            <label htmlFor={renameInputId} className="mb-1 block text-sm font-medium text-gray-700">
+              Passkey name
+            </label>
+            <input
+              id={renameInputId}
+              type="text"
+              value={renameValue}
+              onChange={(e) => setRenameValue(e.target.value)}
+              maxLength={maxNameLength}
+              required
+              autoComplete="off"
+              aria-invalid={renameError ? true : undefined}
+              aria-describedby={renameError ? renameErrorId : undefined}
+              className="w-full rounded-md border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+            {renameError && (
+              <p id={renameErrorId} className="mt-1 text-sm text-red-700">
+                {renameError}
+              </p>
+            )}
+          </div>
+          <div className="flex justify-end gap-2">
+            <button
+              type="button"
+              onClick={() => renameDialogRef.current?.close()}
+              className="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={busy}
+              className="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800 disabled:opacity-60"
+            >
+              {busy ? 'Saving…' : 'Save'}
+            </button>
+          </div>
+        </form>
+      </dialog>
+
+      {/* Delete confirmation dialog */}
+      <dialog
+        ref={deleteDialogRef}
+        aria-labelledby={deleteTitleId}
+        aria-describedby={deleteDescId}
+        onClose={handleDeleteClose}
+        className="m-auto w-[min(28rem,calc(100%-2rem))] rounded-lg p-0 shadow-xl backdrop:bg-black/40"
+      >
+        <form method="dialog" className="space-y-4 p-6">
+          <h3 id={deleteTitleId} className="text-lg font-semibold text-gray-900">
+            Remove “{deleteTarget?.name}”?
+          </h3>
+          <p id={deleteDescId} className="text-sm text-gray-600">
+            You won't be able to sign in to The DevTools Times with this passkey anymore. Supported browsers
+            and password managers will also be told to stop offering it.
+          </p>
+          <div className="flex justify-end gap-2">
+            <button
+              value="cancel"
+              className="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
+            >
+              Cancel
+            </button>
+            <button
+              value="delete"
+              className="rounded-md bg-red-700 px-4 py-2 text-sm font-medium text-white hover:bg-red-800"
+            >
+              Remove passkey
+            </button>
+          </div>
+        </form>
+      </dialog>
+    </section>
+  );
+}
