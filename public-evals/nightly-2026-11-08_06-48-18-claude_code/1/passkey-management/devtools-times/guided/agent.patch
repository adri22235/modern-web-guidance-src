+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,48 @@
+import type { APIRoute } from 'astro';
+import { json } from '../../../lib/passkeys';
+
+const UPSTREAM_LOGIN_URL =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Proxies the sign-in request to the upstream auth service and, on success,
+ * records the reader in the server-side session so account pages (like
+ * passkey management) can identify them.
+ */
+export const POST: APIRoute = async ({ request, session }) => {
+  let body: { username?: unknown; password?: unknown };
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request body' }, 400);
+  }
+
+  const { username, password } = body;
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim()) {
+    return json({ error: 'Username and password are required' }, 400);
+  }
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(UPSTREAM_LOGIN_URL, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return json({ error: 'Authentication service unavailable' }, 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    return json(data, upstream.status);
+  }
+
+  if (session) {
+    // Issue a fresh session ID on privilege change to prevent session fixation.
+    await session.regenerate();
+    session.set('user', { username: username.trim() });
+  }
+
+  return json({ ...data, username: username.trim() });
+};
