+import type { APIRoute } from 'astro';
+import { getSessionUser, json, jsonError } from '../../../lib/auth';
+import { getUserHandle, listPasskeys, toPublicPasskey } from '../../../lib/passkeys';
+
+/** Lists the signed-in reader's passkeys plus the identifiers the browser needs for Signal API calls. */
+export const GET: APIRoute = async (ctx) => {
+  const user = await getSessionUser(ctx);
+  if (!user) return jsonError('Not signed in', 401);
+
+  const [userHandle, passkeys] = await Promise.all([getUserHandle(user.username), listPasskeys(user.username)]);
+  return json({
+    rpId: ctx.url.hostname,
+    user: { id: userHandle, name: user.username, displayName: user.username },
+    passkeys: passkeys.map(toPublicPasskey),
+  });
+};
