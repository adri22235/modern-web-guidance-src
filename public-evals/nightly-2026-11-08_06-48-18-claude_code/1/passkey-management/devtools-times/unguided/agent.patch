+import type { APIRoute } from 'astro';
+import { getSessionUser, json, jsonError, rejectCrossSite } from '../../../lib/auth';
+import { creationOptions, getUserHandle, listPasskeys, MAX_PASSKEYS_PER_USER, newChallenge } from '../../../lib/passkeys';
+
+export const POST: APIRoute = async (ctx) => {
+  const rejected = rejectCrossSite(ctx);
+  if (rejected) return rejected;
+  const user = await getSessionUser(ctx);
+  if (!user) return jsonError('Not signed in', 401);
+
+  const [userHandle, existing] = await Promise.all([getUserHandle(user.username), listPasskeys(user.username)]);
+  if (existing.length >= MAX_PASSKEYS_PER_USER) {
+    return jsonError(`You can register up to ${MAX_PASSKEYS_PER_USER} passkeys.`, 409);
+  }
+
+  const pending = newChallenge();
+  ctx.session?.set('passkeyChallenge', pending);
+
+  return json(
+    creationOptions({
+      rpId: ctx.url.hostname,
+      username: user.username,
+      userHandle,
+      challenge: pending.challenge,
+      existing,
+    }),
+  );
+};
diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..8ea28ac
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json, jsonError, readJson, rejectCrossSite } from '../../../lib/auth';
+import {
+  addPasskey,
+  PasskeyError,
+  providerName,
+  sanitizeName,
+  toPublicPasskey,
+  verifyRegistration,
+  type PendingChallenge,
+  type RegistrationPayload,
+} from '../../../lib/passkeys';
+
+export const POST: APIRoute = async (ctx) => {
+  const rejected = rejectCrossSite(ctx);
+  if (rejected) return rejected;
+  const user = await getSessionUser(ctx);
+  if (!user) return jsonError('Not signed in', 401);
+
+  // Challenges are single-use: consume it before doing anything else.
+  const pending = (await ctx.session?.get('passkeyChallenge')) as PendingChallenge | undefined;
+  ctx.session?.delete('passkeyChallenge');
+  if (!pending || pending.expiresAt < Date.now()) {
+    return jsonError('Registration expired. Please try again.', 400);
+  }
+
+  const body = await readJson<{ credential: RegistrationPayload; name?: unknown }>(ctx.request);
+  if (!body?.credential) return jsonError('Missing credential', 400);
+
+  try {
+    const verified = verifyRegistration(body.credential, {
+      challenge: pending.challenge,
+      origin: ctx.url.origin,
+      rpId: ctx.url.hostname,
+    });
+    const now = new Date().toISOString();
+    const name = sanitizeName(body.name) ?? providerName(verified.aaguid) ?? 'Passkey';
+    const saved = await addPasskey(user.username, { ...verified, name, createdAt: now, updatedAt: now });
+    return json({ passkey: toPublicPasskey(saved) }, 201);
+  } catch (err) {
+    if (err instanceof PasskeyError) return jsonError(err.message, err.status);
+    throw err;
+  }
+};
