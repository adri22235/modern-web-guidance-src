diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..c4e3774
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,481 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilSquareIcon, TrashIcon, CloudIcon, DevicePhoneMobileIcon } from '@heroicons/react/24/outline';
+
+interface Passkey {
+  id: string;
+  name: string;
+  provider: string | null;
+  createdAt: string;
+  updatedAt: string;
+  transports: string[];
+  synced: boolean;
+}
+
+interface PasskeyState {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  passkeys: Passkey[];
+}
+
+const API = `${import.meta.env.BASE_URL}api/passkeys`;
+const MAX_NAME_LENGTH = 64;
+
+/* ------------------------------------------------------------------------ */
+/* WebAuthn helpers                                                         */
+/* ------------------------------------------------------------------------ */
+
+const b64urlToBuffer = (value: string): ArrayBuffer => {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+};
+
+const bufferToB64url = (buffer: ArrayBuffer): string => {
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+};
+
+type PKC = typeof PublicKeyCredential & {
+  parseCreationOptionsFromJSON?: (json: any) => PublicKeyCredentialCreationOptions;
+  signalAllAcceptedCredentials?: (opts: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (opts: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  signalUnknownCredential?: (opts: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+const pkc = (): PKC | undefined =>
+  typeof window !== 'undefined' && 'PublicKeyCredential' in window ? (window.PublicKeyCredential as PKC) : undefined;
+
+function decodeCreationOptions(json: any): PublicKeyCredentialCreationOptions {
+  const native = pkc()?.parseCreationOptionsFromJSON;
+  if (native) return native(json);
+  return {
+    ...json,
+    challenge: b64urlToBuffer(json.challenge),
+    user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+    excludeCredentials: (json.excludeCredentials ?? []).map((c: any) => ({ ...c, id: b64urlToBuffer(c.id) })),
+  };
+}
+
+function encodeRegistration(credential: PublicKeyCredential) {
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const publicKey = response.getPublicKey?.();
+  if (!publicKey || typeof response.getAuthenticatorData !== 'function') {
+    throw new Error('This browser does not expose the passkey public key. Please update your browser.');
+  }
+  return {
+    id: credential.id,
+    rawId: bufferToB64url(credential.rawId),
+    type: credential.type,
+    response: {
+      clientDataJSON: bufferToB64url(response.clientDataJSON),
+      authenticatorData: bufferToB64url(response.getAuthenticatorData()),
+      publicKey: bufferToB64url(publicKey),
+      publicKeyAlgorithm: response.getPublicKeyAlgorithm(),
+      transports: response.getTransports?.() ?? [],
+    },
+  };
+}
+
+/**
+ * Tells the browser / password manager which credentials are still valid for
+ * this account so removed passkeys disappear from autofill and the user's
+ * name stays current. Uses the WebAuthn Signal API where supported; it is a
+ * best-effort hint, so failures are swallowed.
+ */
+async function syncAuthenticator(state: Pick<PasskeyState, 'rpId' | 'user'>, acceptedIds: string[]) {
+  const api = pkc();
+  if (!api) return false;
+  let signalled = false;
+  try {
+    if (api.signalAllAcceptedCredentials) {
+      await api.signalAllAcceptedCredentials({
+        rpId: state.rpId,
+        userId: state.user.id,
+        allAcceptedCredentialIds: acceptedIds,
+      });
+      signalled = true;
+    }
+    if (api.signalCurrentUserDetails) {
+      await api.signalCurrentUserDetails({
+        rpId: state.rpId,
+        userId: state.user.id,
+        name: state.user.name,
+        displayName: state.user.displayName,
+      });
+      signalled = true;
+    }
+  } catch (err) {
+    console.warn('Passkey signal failed', err);
+  }
+  return signalled;
+}
+
+async function apiFetch<T>(url: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(url, {
+    credentials: 'same-origin',
+    ...init,
+    headers: { ...(init?.body ? { 'Content-Type': 'application/json' } : {}), ...init?.headers },
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    if (response.status === 401) {
+      window.location.href = `${import.meta.env.BASE_URL}signin`;
+    }
+    throw new Error(data.error || `Request failed (${response.status})`);
+  }
+  return data as T;
+}
+
+const formatDate = (iso: string) =>
+  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+/* ------------------------------------------------------------------------ */
+/* Components                                                               */
+/* ------------------------------------------------------------------------ */
+
+export default function PasskeyManager() {
+  const [state, setState] = useState<PasskeyState | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [notice, setNotice] = useState<string | null>(null);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [confirmingId, setConfirmingId] = useState<string | null>(null);
+  const [supported, setSupported] = useState(true);
+  const [signalSupported, setSignalSupported] = useState(false);
+
+  const flash = (message: string) => {
+    setError(null);
+    setNotice(message);
+  };
+  const fail = (err: unknown) => {
+    setNotice(null);
+    setError(err instanceof Error ? err.message : String(err));
+  };
+
+  const load = useCallback(async () => {
+    try {
+      const data = await apiFetch<PasskeyState>(API);
+      setState(data);
+      // Bring the authenticator up to date with the server's view of this account.
+      syncAuthenticator(data, data.passkeys.map((p) => p.id));
+    } catch (err) {
+      fail(err);
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    const api = pkc();
+    setSupported(!!api && typeof navigator.credentials?.create === 'function');
+    setSignalSupported(!!api?.signalAllAcceptedCredentials);
+    load();
+  }, [load]);
+
+  const addPasskey = async () => {
+    setBusy('add');
+    setError(null);
+    setNotice(null);
+    try {
+      const optionsJSON = await apiFetch<any>(`${API}/register-options`, { method: 'POST', body: '{}' });
+      const credential = (await navigator.credentials.create({
+        publicKey: decodeCreationOptions(optionsJSON),
+      })) as PublicKeyCredential | null;
+      if (!credential) throw new Error('No passkey was created.');
+
+      const { passkey } = await apiFetch<{ passkey: Passkey }>(`${API}/register`, {
+        method: 'POST',
+        body: JSON.stringify({ credential: encodeRegistration(credential) }),
+      });
+      setState((prev) => (prev ? { ...prev, passkeys: [...prev.passkeys, passkey] } : prev));
+      setEditingId(passkey.id);
+      flash(`Passkey "${passkey.name}" added. Give it a name you'll recognise.`);
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError' || err?.name === 'AbortError') {
+        setError('Passkey creation was cancelled.');
+      } else if (err?.name === 'InvalidStateError') {
+        setError('This device already has a passkey for your account.');
+      } else {
+        fail(err);
+      }
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const renamePasskey = async (id: string, name: string) => {
+    setBusy(id);
+    try {
+      const { passkey } = await apiFetch<{ passkey: Passkey }>(`${API}/${encodeURIComponent(id)}`, {
+        method: 'PATCH',
+        body: JSON.stringify({ name }),
+      });
+      setState((prev) =>
+        prev ? { ...prev, passkeys: prev.passkeys.map((p) => (p.id === id ? passkey : p)) } : prev,
+      );
+      setEditingId(null);
+      flash(`Renamed to "${passkey.name}".`);
+    } catch (err) {
+      fail(err);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const removePasskey = async (passkey: Passkey) => {
+    if (!state) return;
+    setBusy(passkey.id);
+    try {
+      const { remainingIds } = await apiFetch<{ remainingIds: string[] }>(
+        `${API}/${encodeURIComponent(passkey.id)}`,
+        { method: 'DELETE' },
+      );
+      setState((prev) =>
+        prev ? { ...prev, passkeys: prev.passkeys.filter((p) => remainingIds.includes(p.id)) } : prev,
+      );
+      setConfirmingId(null);
+      const synced = await syncAuthenticator(state, remainingIds);
+      flash(
+        synced
+          ? `"${passkey.name}" was removed and your browser was asked to forget it.`
+          : `"${passkey.name}" was removed. You may also want to delete it from your password manager.`,
+      );
+    } catch (err) {
+      fail(err);
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  return (
+    <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-6 border-b border-gray-200">
+        <div>
+          <h2 id="passkeys-heading" className="text-lg font-bold text-gray-900 flex items-center gap-2">
+            <KeyIcon className="w-5 h-5" aria-hidden="true" />
+            Passkeys
+          </h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Passkeys let you sign in with your fingerprint, face, screen lock or security key instead of a password.
+          </p>
+        </div>
+        <button
+          type="button"
+          onClick={addPasskey}
+          disabled={!supported || busy !== null || loading}
+          className="shrink-0 py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 disabled:cursor-not-allowed"
+        >
+          {busy === 'add' ? 'Waiting for device…' : 'Add a passkey'}
+        </button>
+      </div>
+
+      <div aria-live="polite" className="px-6">
+        {error && (
+          <div className="mt-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+        {notice && <div className="mt-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg">{notice}</div>}
+        {!supported && (
+          <div className="mt-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">
+            This browser doesn't support passkeys. You can still manage existing passkeys here.
+          </div>
+        )}
+      </div>
+
+      {loading ? (
+        <p className="p-6 text-sm text-gray-500">Loading passkeys…</p>
+      ) : state && state.passkeys.length === 0 ? (
+        <div className="p-6 text-center">
+          <KeyIcon className="w-10 h-10 mx-auto text-gray-300" aria-hidden="true" />
+          <p className="mt-2 text-sm text-gray-600">You haven't registered any passkeys yet.</p>
+        </div>
+      ) : (
+        <ul className="divide-y divide-gray-200">
+          {state?.passkeys.map((passkey) => (
+            <PasskeyRow
+              key={passkey.id}
+              passkey={passkey}
+              busy={busy === passkey.id}
+              disabled={busy !== null}
+              editing={editingId === passkey.id}
+              confirming={confirmingId === passkey.id}
+              onEdit={() => {
+                setConfirmingId(null);
+                setEditingId(passkey.id);
+              }}
+              onCancelEdit={() => setEditingId(null)}
+              onSave={(name) => renamePasskey(passkey.id, name)}
+              onAskRemove={() => {
+                setEditingId(null);
+                setConfirmingId(passkey.id);
+              }}
+              onCancelRemove={() => setConfirmingId(null)}
+              onRemove={() => removePasskey(passkey)}
+            />
+          ))}
+        </ul>
+      )}
+
+      <p className="px-6 py-4 text-xs text-gray-500 border-t border-gray-200">
+        {signalSupported
+          ? 'Changes here are shared with your browser and password manager so removed passkeys stop appearing when you sign in.'
+          : "Your browser can't be updated automatically. After removing a passkey here, also delete it from your device or password manager."}
+      </p>
+    </section>
+  );
+}
+
+interface RowProps {
+  passkey: Passkey;
+  busy: boolean;
+  disabled: boolean;
+  editing: boolean;
+  confirming: boolean;
+  onEdit: () => void;
+  onCancelEdit: () => void;
+  onSave: (name: string) => void;
+  onAskRemove: () => void;
+  onCancelRemove: () => void;
+  onRemove: () => void;
+}
+
+function PasskeyRow({
+  passkey,
+  busy,
+  disabled,
+  editing,
+  confirming,
+  onEdit,
+  onCancelEdit,
+  onSave,
+  onAskRemove,
+  onCancelRemove,
+  onRemove,
+}: RowProps) {
+  const [draft, setDraft] = useState(passkey.name);
+  const inputRef = useRef<HTMLInputElement>(null);
+  const inputId = `passkey-name-${passkey.id}`;
+
+  useEffect(() => {
+    if (editing) {
+      setDraft(passkey.name);
+      requestAnimationFrame(() => inputRef.current?.select());
+    }
+  }, [editing, passkey.name]);
+
+  const trimmed = draft.trim();
+  const canSave = trimmed.length > 0 && trimmed.length <= MAX_NAME_LENGTH && trimmed !== passkey.name;
+  const Icon = passkey.synced ? CloudIcon : DevicePhoneMobileIcon;
+
+  return (
+    <li className="p-6 flex flex-col sm:flex-row sm:items-center gap-4">
+      <div className="flex items-start gap-3 flex-1 min-w-0">
+        <div className="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
+          <Icon className="w-5 h-5 text-gray-700" aria-hidden="true" />
+        </div>
+        <div className="min-w-0 flex-1">
+          {editing ? (
+            <form
+              className="flex flex-col sm:flex-row gap-2"
+              onSubmit={(e) => {
+                e.preventDefault();
+                if (canSave) onSave(trimmed);
+              }}
+            >
+              <label htmlFor={inputId} className="sr-only">
+                Passkey name
+              </label>
+              <input
+                ref={inputRef}
+                id={inputId}
+                value={draft}
+                maxLength={MAX_NAME_LENGTH}
+                onChange={(e) => setDraft(e.target.value)}
+                onKeyDown={(e) => e.key === 'Escape' && onCancelEdit()}
+                className="flex-1 min-w-0 px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+              />
+              <div className="flex gap-2">
+                <button
+                  type="submit"
+                  disabled={!canSave || busy}
+                  className="py-1.5 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+                >
+                  {busy ? 'Saving…' : 'Save'}
+                </button>
+                <button
+                  type="button"
+                  onClick={onCancelEdit}
+                  className="py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                >
+                  Cancel
+                </button>
+              </div>
+            </form>
+          ) : (
+            <p className="font-semibold text-gray-900 truncate">{passkey.name}</p>
+          )}
+          <p className="text-xs text-gray-500 mt-1">
+            {passkey.provider && passkey.provider !== passkey.name && <>{passkey.provider} · </>}
+            {passkey.synced ? 'Synced across devices' : 'Stored on this device or key'} · Added{' '}
+            {formatDate(passkey.createdAt)}
+          </p>
+        </div>
+      </div>
+
+      {!editing && (
+        <div className="flex items-center gap-2 sm:justify-end">
+          {confirming ? (
+            <>
+              <span className="text-sm text-gray-700">Remove this passkey?</span>
+              <button
+                type="button"
+                onClick={onRemove}
+                disabled={busy}
+                className="py-1.5 px-3 rounded-md text-sm font-medium text-white bg-red-600 hover:bg-red-700 disabled:opacity-60"
+              >
+                {busy ? 'Removing…' : 'Remove'}
+              </button>
+              <button
+                type="button"
+                onClick={onCancelRemove}
+                disabled={busy}
+                className="py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+              >
+                Keep
+              </button>
+            </>
+          ) : (
+            <>
+              <button
+                type="button"
+                onClick={onEdit}
+                disabled={disabled}
+                aria-label={`Rename ${passkey.name}`}
+                className="inline-flex items-center gap-1 py-1.5 px-3 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50 disabled:opacity-60"
+              >
+                <PencilSquareIcon className="w-4 h-4" aria-hidden="true" />
+                Rename
+              </button>
+              <button
+                type="button"
+                onClick={onAskRemove}
+                disabled={disabled}
+                aria-label={`Remove ${passkey.name}`}
+                className="inline-flex items-center gap-1 py-1.5 px-3 rounded-md text-sm font-medium text-red-700 border border-red-200 hover:bg-red-50 disabled:opacity-60"
+              >
+                <TrashIcon className="w-4 h-4" aria-hidden="true" />
+                Remove
+              </button>
+            </>
+          )}
+        </div>
+      )}
+    </li>
+  );
+}
