+import type { APIRoute } from 'astro';
+import { json, rejectCrossSite } from '../../../lib/auth';
+
+export const POST: APIRoute = async (ctx) => {
+  const rejected = rejectCrossSite(ctx, { requireJson: false });
+  if (rejected) return rejected;
+  ctx.session?.destroy();
+  return json({ ok: true });
+};
