@@ -0,0 +1,46 @@
+import type { APIRoute } from 'astro';
+import { getSessionUser, json, jsonError, readJson, rejectCrossSite } from '../../../lib/auth';
+import {
+  deletePasskey,
+  MAX_NAME_LENGTH,
+  PasskeyError,
+  renamePasskey,
+  sanitizeName,
+  toPublicPasskey,
+} from '../../../lib/passkeys';
+
+/** Rename a passkey. */
+export const PATCH: APIRoute = async (ctx) => {
+  const rejected = rejectCrossSite(ctx);
+  if (rejected) return rejected;
+  const user = await getSessionUser(ctx);
+  if (!user) return jsonError('Not signed in', 401);
+
+  const body = await readJson<{ name?: unknown }>(ctx.request);
+  const name = sanitizeName(body?.name);
+  if (!name) return jsonError(`Name must be 1–${MAX_NAME_LENGTH} characters.`, 400);
+
+  try {
+    const updated = await renamePasskey(user.username, ctx.params.id ?? '', name);
+    return json({ passkey: toPublicPasskey(updated) });
+  } catch (err) {
+    if (err instanceof PasskeyError) return jsonError(err.message, err.status);
+    throw err;
+  }
+};
+
+/** Remove a passkey. Returns the remaining credential IDs so the client can signal the authenticator. */
+export const DELETE: APIRoute = async (ctx) => {
+  const rejected = rejectCrossSite(ctx, { requireJson: false });
+  if (rejected) return rejected;
+  const user = await getSessionUser(ctx);
+  if (!user) return jsonError('Not signed in', 401);
+
+  try {
+    const remaining = await deletePasskey(user.username, ctx.params.id ?? '');
+    return json({ remainingIds: remaining.map((p) => p.id) });
+  } catch (err) {
+    if (err instanceof PasskeyError) return jsonError(err.message, err.status);
+    throw err;
+  }
+};
