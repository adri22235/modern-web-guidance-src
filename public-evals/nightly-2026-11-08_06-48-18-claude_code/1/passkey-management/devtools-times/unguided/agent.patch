--- /dev/null
+++ b/src/lib/auth.ts
@@ -0,0 +1,53 @@
+import type { APIContext, AstroGlobal } from 'astro';
+
+export interface SessionUser {
+  username: string;
+}
+
+type SessionHolder = Pick<APIContext, 'session'> | Pick<AstroGlobal, 'session'>;
+
+export async function getSessionUser(ctx: SessionHolder): Promise<SessionUser | null> {
+  const user = await ctx.session?.get('user');
+  if (user && typeof user.username === 'string' && user.username.length > 0) {
+    return { username: user.username };
+  }
+  return null;
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function jsonError(message: string, status: number): Response {
+  return json({ error: message }, status);
+}
+
+/**
+ * Guards state-changing requests. Astro's built-in origin check is disabled for
+ * this site, so we require a JSON body (which cross-site forms cannot send
+ * without a CORS preflight) and a same-origin Origin header when present.
+ */
+export function rejectCrossSite(ctx: Pick<APIContext, 'request' | 'url'>, { requireJson = true } = {}): Response | null {
+  const origin = ctx.request.headers.get('origin');
+  if (origin && origin !== ctx.url.origin) {
+    return jsonError('Cross-site request rejected', 403);
+  }
+  if (requireJson) {
+    const contentType = ctx.request.headers.get('content-type') ?? '';
+    if (!contentType.toLowerCase().startsWith('application/json')) {
+      return jsonError('Expected application/json', 415);
+    }
+  }
+  return null;
+}
+
+export async function readJson<T = any>(request: Request): Promise<T | null> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..63f5a78
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,374 @@
+import { createHash, createPublicKey, randomBytes, timingSafeEqual } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+
+/* ------------------------------------------------------------------------ */
+/* Types                                                                    */
+/* ------------------------------------------------------------------------ */
+
+export interface StoredPasskey {
+  /** Credential ID, base64url */
+  id: string;
+  /** SubjectPublicKeyInfo DER, base64url */
+  publicKey: string;
+  /** COSE algorithm identifier */
+  algorithm: number;
+  transports: string[];
+  aaguid: string;
+  name: string;
+  createdAt: string;
+  updatedAt: string;
+  backupEligible: boolean;
+  backedUp: boolean;
+}
+
+interface UserRecord {
+  /** WebAuthn user handle (user.id), base64url. Stable per account. */
+  userHandle: string;
+  passkeys: StoredPasskey[];
+}
+
+interface StoreShape {
+  users: Record<string, UserRecord>;
+}
+
+/** Shape returned to the browser — never includes key material. */
+export interface PublicPasskey {
+  id: string;
+  name: string;
+  provider: string | null;
+  createdAt: string;
+  updatedAt: string;
+  transports: string[];
+  synced: boolean;
+}
+
+export const MAX_PASSKEYS_PER_USER = 20;
+export const MAX_NAME_LENGTH = 64;
+export const RP_NAME = 'The DevTools Times';
+const SUPPORTED_ALGORITHMS = [-7 /* ES256 */, -8 /* EdDSA */, -257 /* RS256 */];
+
+/* ------------------------------------------------------------------------ */
+/* base64url helpers                                                        */
+/* ------------------------------------------------------------------------ */
+
+export const toB64url = (buf: Uint8Array): string => Buffer.from(buf).toString('base64url');
+export const fromB64url = (str: string): Buffer => Buffer.from(str, 'base64url');
+const isB64url = (v: unknown): v is string => typeof v === 'string' && /^[A-Za-z0-9_-]+$/.test(v);
+
+/* ------------------------------------------------------------------------ */
+/* File-backed store                                                        */
+/* ------------------------------------------------------------------------ */
+
+const STORE_FILE = path.resolve(process.env.PASSKEY_STORE_FILE ?? path.join(process.cwd(), '.data', 'passkeys.json'));
+
+let cache: StoreShape | null = null;
+let queue: Promise<unknown> = Promise.resolve();
+
+async function load(): Promise<StoreShape> {
+  if (cache) return cache;
+  try {
+    const parsed = JSON.parse(await readFile(STORE_FILE, 'utf8'));
+    cache = parsed && typeof parsed.users === 'object' ? parsed : { users: {} };
+  } catch {
+    cache = { users: {} };
+  }
+  return cache!;
+}
+
+async function persist(store: StoreShape) {
+  await mkdir(path.dirname(STORE_FILE), { recursive: true });
+  const tmp = `${STORE_FILE}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(store, null, 2), 'utf8');
+  await rename(tmp, STORE_FILE);
+}
+
+/** Serialises read-modify-write cycles so concurrent requests don't clobber each other. */
+function withStore<T>(fn: (store: StoreShape) => T | Promise<T>, { write = false } = {}): Promise<T> {
+  const run = queue.then(async () => {
+    const store = await load();
+    const result = await fn(store);
+    if (write) await persist(store);
+    return result;
+  });
+  queue = run.catch(() => undefined);
+  return run;
+}
+
+function ensureUser(store: StoreShape, username: string): UserRecord {
+  const key = username.toLowerCase();
+  if (!Object.hasOwn(store.users, key)) {
+    store.users[key] = { userHandle: toB64url(randomBytes(32)), passkeys: [] };
+  }
+  return store.users[key];
+}
+
+export function getUserHandle(username: string): Promise<string> {
+  return withStore(async (store) => {
+    const existed = Object.hasOwn(store.users, username.toLowerCase());
+    const user = ensureUser(store, username);
+    if (!existed) await persist(store);
+    return user.userHandle;
+  });
+}
+
+export function listPasskeys(username: string): Promise<StoredPasskey[]> {
+  return withStore((store) => {
+    const key = username.toLowerCase();
+    return Object.hasOwn(store.users, key) ? [...store.users[key].passkeys] : [];
+  });
+}
+
+export function addPasskey(username: string, passkey: StoredPasskey): Promise<StoredPasskey> {
+  return withStore(
+    (store) => {
+      const user = ensureUser(store, username);
+      if (user.passkeys.length >= MAX_PASSKEYS_PER_USER) {
+        throw new PasskeyError(`You can register up to ${MAX_PASSKEYS_PER_USER} passkeys.`, 409);
+      }
+      // Credential IDs must be globally unique across accounts.
+      for (const other of Object.values(store.users)) {
+        if (other.passkeys.some((p) => p.id === passkey.id)) {
+          throw new PasskeyError('This passkey is already registered.', 409);
+        }
+      }
+      user.passkeys.push(passkey);
+      return passkey;
+    },
+    { write: true },
+  );
+}
+
+export function renamePasskey(username: string, id: string, name: string): Promise<StoredPasskey> {
+  return withStore(
+    (store) => {
+      const key = username.toLowerCase();
+      const passkey = Object.hasOwn(store.users, key) ? store.users[key].passkeys.find((p) => p.id === id) : undefined;
+      if (!passkey) throw new PasskeyError('Passkey not found.', 404);
+      passkey.name = name;
+      passkey.updatedAt = new Date().toISOString();
+      return passkey;
+    },
+    { write: true },
+  );
+}
+
+export function deletePasskey(username: string, id: string): Promise<StoredPasskey[]> {
+  return withStore(
+    (store) => {
+      const key = username.toLowerCase();
+      const user = Object.hasOwn(store.users, key) ? store.users[key] : undefined;
+      const index = user?.passkeys.findIndex((p) => p.id === id) ?? -1;
+      if (!user || index === -1) throw new PasskeyError('Passkey not found.', 404);
+      user.passkeys.splice(index, 1);
+      return [...user.passkeys];
+    },
+    { write: true },
+  );
+}
+
+export class PasskeyError extends Error {
+  constructor(message: string, public status = 400) {
+    super(message);
+  }
+}
+
+/* ------------------------------------------------------------------------ */
+/* Presentation helpers                                                     */
+/* ------------------------------------------------------------------------ */
+
+/** A handful of well-known passkey providers, keyed by AAGUID. */
+const KNOWN_PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Microsoft Edge on Mac',
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8': 'YubiKey 5 Series',
+  'ee882879-721c-4913-9775-3dfcce97072a': 'YubiKey 5 Series',
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118': 'YubiKey 5 Series with NFC',
+};
+
+export function providerName(aaguid: string): string | null {
+  return KNOWN_PROVIDERS[aaguid] ?? null;
+}
+
+export function toPublicPasskey(p: StoredPasskey): PublicPasskey {
+  return {
+    id: p.id,
+    name: p.name,
+    provider: providerName(p.aaguid),
+    createdAt: p.createdAt,
+    updatedAt: p.updatedAt,
+    transports: p.transports,
+    synced: p.backedUp,
+  };
+}
+
+export function sanitizeName(raw: unknown): string | null {
+  if (typeof raw !== 'string') return null;
+  // Collapse whitespace and strip control characters.
+  const cleaned = raw.replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim();
+  if (!cleaned || cleaned.length > MAX_NAME_LENGTH) return null;
+  return cleaned;
+}
+
+/* ------------------------------------------------------------------------ */
+/* WebAuthn registration                                                    */
+/* ------------------------------------------------------------------------ */
+
+export interface PendingChallenge {
+  challenge: string;
+  expiresAt: number;
+}
+
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+
+export function newChallenge(): PendingChallenge {
+  return { challenge: toB64url(randomBytes(32)), expiresAt: Date.now() + CHALLENGE_TTL_MS };
+}
+
+export function creationOptions(opts: {
+  rpId: string;
+  username: string;
+  userHandle: string;
+  challenge: string;
+  existing: StoredPasskey[];
+}) {
+  return {
+    rp: { id: opts.rpId, name: RP_NAME },
+    user: { id: opts.userHandle, name: opts.username, displayName: opts.username },
+    challenge: opts.challenge,
+    pubKeyCredParams: SUPPORTED_ALGORITHMS.map((alg) => ({ type: 'public-key', alg })),
+    timeout: CHALLENGE_TTL_MS,
+    attestation: 'none',
+    excludeCredentials: opts.existing.map((p) => ({ type: 'public-key', id: p.id, transports: p.transports })),
+    authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'preferred' },
+    hints: [],
+  };
+}
+
+export interface RegistrationPayload {
+  id: string;
+  rawId: string;
+  type: string;
+  response: {
+    clientDataJSON: string;
+    authenticatorData: string;
+    publicKey: string;
+    publicKeyAlgorithm: number;
+    transports?: string[];
+  };
+}
+
+const ALLOWED_TRANSPORTS = new Set(['ble', 'cable', 'hybrid', 'internal', 'nfc', 'smart-card', 'usb']);
+
+function sameBytes(a: Buffer, b: Buffer) {
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Verifies a registration response produced with `attestation: "none"`.
+ * Checks the client data (type, challenge, origin) and the authenticator data
+ * (RP ID hash, user presence, attested credential matching the reported ID).
+ */
+export function verifyRegistration(
+  body: RegistrationPayload,
+  expected: { challenge: string; origin: string; rpId: string },
+) {
+  const r = body?.response;
+  if (
+    body?.type !== 'public-key' ||
+    !isB64url(body.id) ||
+    !r ||
+    !isB64url(r.clientDataJSON) ||
+    !isB64url(r.authenticatorData) ||
+    !isB64url(r.publicKey) ||
+    typeof r.publicKeyAlgorithm !== 'number'
+  ) {
+    throw new PasskeyError('Malformed registration response.');
+  }
+
+  // --- clientDataJSON
+  let clientData: any;
+  try {
+    clientData = JSON.parse(fromB64url(r.clientDataJSON).toString('utf8'));
+  } catch {
+    throw new PasskeyError('Malformed client data.');
+  }
+  if (clientData.type !== 'webauthn.create') throw new PasskeyError('Unexpected ceremony type.');
+  if (
+    typeof clientData.challenge !== 'string' ||
+    !sameBytes(Buffer.from(clientData.challenge), Buffer.from(expected.challenge))
+  ) {
+    throw new PasskeyError('Challenge mismatch. Please try again.');
+  }
+  if (clientData.origin !== expected.origin) throw new PasskeyError('Origin mismatch.');
+  if (clientData.crossOrigin === true) throw new PasskeyError('Cross-origin registration is not allowed.');
+
+  // --- authenticatorData
+  const authData = fromB64url(r.authenticatorData);
+  if (authData.length < 37 + 18) throw new PasskeyError('Authenticator data too short.');
+  const rpIdHash = authData.subarray(0, 32);
+  if (!sameBytes(rpIdHash, createHash('sha256').update(expected.rpId).digest())) {
+    throw new PasskeyError('Relying party mismatch.');
+  }
+  const flags = authData[32];
+  const userPresent = (flags & 0x01) !== 0;
+  const backupEligible = (flags & 0x08) !== 0;
+  const backedUp = (flags & 0x10) !== 0;
+  const attestedData = (flags & 0x40) !== 0;
+  if (!userPresent) throw new PasskeyError('User presence was not confirmed.');
+  if (!attestedData) throw new PasskeyError('No credential data was returned.');
+
+  let offset = 37;
+  const aaguidHex = authData.subarray(offset, offset + 16).toString('hex');
+  offset += 16;
+  const credIdLen = authData.readUInt16BE(offset);
+  offset += 2;
+  if (credIdLen < 16 || credIdLen > 1023 || authData.length < offset + credIdLen) {
+    throw new PasskeyError('Invalid credential ID.');
+  }
+  const credentialId = authData.subarray(offset, offset + credIdLen);
+  if (!sameBytes(credentialId, fromB64url(body.id))) throw new PasskeyError('Credential ID mismatch.');
+
+  // --- public key (SPKI, as returned by AuthenticatorAttestationResponse.getPublicKey())
+  if (!SUPPORTED_ALGORITHMS.includes(r.publicKeyAlgorithm)) throw new PasskeyError('Unsupported key algorithm.');
+  try {
+    createPublicKey({ key: fromB64url(r.publicKey), format: 'der', type: 'spki' });
+  } catch {
+    throw new PasskeyError('Invalid public key.');
+  }
+
+  const aaguid = [
+    aaguidHex.slice(0, 8),
+    aaguidHex.slice(8, 12),
+    aaguidHex.slice(12, 16),
+    aaguidHex.slice(16, 20),
+    aaguidHex.slice(20),
+  ].join('-');
+
+  const transports = Array.isArray(r.transports)
+    ? r.transports.filter((t): t is string => typeof t === 'string' && ALLOWED_TRANSPORTS.has(t))
+    : [];
+
+  return {
+    id: toB64url(credentialId),
+    publicKey: r.publicKey,
+    algorithm: r.publicKeyAlgorithm,
+    transports,
+    aaguid,
+    backupEligible,
+    backedUp,
+  };
+}
