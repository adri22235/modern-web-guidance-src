--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,42 @@
+import type { APIRoute } from 'astro';
+import { json, jsonError, readJson, rejectCrossSite } from '../../../lib/auth';
+
+const LOGIN_ENDPOINT = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login';
+
+/**
+ * Proxies sign-in to the upstream auth service and, on success, records the
+ * reader in the server-side session so account pages can be protected.
+ */
+export const POST: APIRoute = async (ctx) => {
+  const rejected = rejectCrossSite(ctx);
+  if (rejected) return rejected;
+
+  const body = await readJson<{ username?: unknown; password?: unknown }>(ctx.request);
+  const username = typeof body?.username === 'string' ? body.username.trim() : '';
+  const password = typeof body?.password === 'string' ? body.password : '';
+  if (!username || !password) return jsonError('Username and password are required', 400);
+
+  let upstream: Response;
+  try {
+    upstream = await fetch(LOGIN_ENDPOINT, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+  } catch {
+    return jsonError('Sign-in service unavailable', 502);
+  }
+
+  const data = await upstream.json().catch(() => ({}));
+  if (!upstream.ok) {
+    // Pass the upstream error code through unchanged.
+    return json({ error: data?.error ?? 'Unknown error' }, upstream.status);
+  }
+
+  // Rotate the session ID on privilege change to avoid session fixation.
+  await ctx.session?.regenerate();
+  ctx.session?.set('user', { username });
+  ctx.session?.delete('passkeyChallenge');
+
+  return json({ ok: true, username });
+};
