+  <script>
+    // Builds the breadcrumb trail from the current URL path, e.g.
+    // /menu/cold-brew -> Home > Menu > Cold Brew
+    (function () {
+      var LABELS = {
+        'menu': 'Menu',
+        'seasonal': 'Maple Oat Latte',
+        'espresso': 'Dark Roast Espresso',
+        'cold-brew': 'Cold Brew',
+        'locations': 'Locations',
+        'rewards': 'Rewards',
+        'account': 'My Account',
+        'order-online': 'Order Online',
+        'about': 'Our Story',
+        'careers': 'Join the Team',
+        'contact': 'Contact Us',
+        'privacy-policy': 'Privacy'
+      };
+
+      function toLabel(segment) {
+        var key = decodeURIComponent(segment).toLowerCase();
+        if (LABELS[key]) return LABELS[key];
+        return key.replace(/[-_]+/g, ' ').replace(/\b\w/g, function (c) {
+          return c.toUpperCase();
+        });
+      }
+
+      var list = document.getElementById('breadcrumb-list');
+      if (!list) return;
+
+      // Opened directly from disk: the file path isn't the site hierarchy.
+      var segments = location.protocol === 'file:' ? [] :
+        location.pathname.split('/').filter(function (s) {
+          return s && !/^index\.html?$/i.test(s);
+        });
+
+      var crumbs = [{ label: 'Home', href: '/' }];
+      var path = '';
+      segments.forEach(function (segment) {
+        path += '/' + segment;
+        crumbs.push({ label: toLabel(segment), href: path });
+      });
+
+      list.innerHTML = '';
+      crumbs.forEach(function (crumb, i) {
+        var li = document.createElement('li');
+        var el;
+        if (i === crumbs.length - 1) {
+          el = document.createElement('span');
+          el.setAttribute('aria-current', 'page');
+        } else {
+          el = document.createElement('a');
+          el.href = crumb.href;
+        }
+        el.textContent = crumb.label;
+        li.appendChild(el);
+        list.appendChild(li);
+      });
+    })();
+  </script>
+
 </body>
 
