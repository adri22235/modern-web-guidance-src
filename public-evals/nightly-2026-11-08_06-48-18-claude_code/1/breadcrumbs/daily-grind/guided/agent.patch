+  <script>
+    // When a seasonal favorite is viewed under /menu/<item>, extend the trail with that item.
+    (() => {
+      const items = {
+        '/menu/seasonal': 'Maple Oat Latte',
+        '/menu/espresso': 'Dark Roast Espresso',
+        '/menu/cold-brew': 'Cold Brew',
+      };
+      const path = location.pathname.replace(/\/+$/, '');
+      const name = items[path];
+      if (!name) return;
+
+      const list = document.querySelector('.breadcrumb ol');
+      const parent = list.querySelector('[aria-current="page"]');
+      parent.removeAttribute('aria-current');
+      parent.href = '/#seasonal-favorites';
+
+      const li = document.createElement('li');
+      const a = document.createElement('a');
+      a.href = path;
+      a.textContent = name;
+      a.setAttribute('aria-current', 'page');
+      li.append(a);
+      list.append(li);
+    })();
+  </script>
+
