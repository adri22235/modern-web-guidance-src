+  <script type="module">
+    // Use the native Temporal API; fall back to the spec-compliant polyfill
+    // only in browsers that haven't shipped Temporal yet.
+    const Temporal = globalThis.Temporal
+      ?? (await import('https://cdn.jsdelivr.net/npm/@js-temporal/polyfill@0.5.1/+esm')).Temporal;
+
+    const TARGET_ZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const hostWarning = document.getElementById('hostWarning');
+    const grid = document.getElementById('grid');
+
+    const timeFmt = { hour: 'numeric', minute: '2-digit', hour12: true };
+    const dateFmt = { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' };
+
+    const formatTime = (zdt) => zdt.toLocaleString('en-US', timeFmt);
+    const formatDate = (zdt) => zdt.toLocaleString('en-US', dateFmt);
+    const formatWall = (pdt) => pdt.toLocaleString('en-US', { ...dateFmt, ...timeFmt });
+
+    function el(tag, className, text) {
+      const node = document.createElement(tag);
+      if (className) node.className = className;
+      if (text != null) node.textContent = text;
+      return node;
+    }
+
+    /**
+     * Resolve a wall-clock PlainDateTime in a zone, detecting DST gaps/overlaps.
+     * Temporal objects are immutable: every step below returns a new object and
+     * the input PlainDateTime is never modified.
+     */
+    function resolveInZone(plain, timeZone) {
+      const earlier = plain.toZonedDateTime(timeZone, { disambiguation: 'earlier' });
+      const later = plain.toZonedDateTime(timeZone, { disambiguation: 'later' });
+      const resolved = plain.toZonedDateTime(timeZone, { disambiguation: 'compatible' });
+
+      if (earlier.offset === later.offset) {
+        return { resolved, conflict: null };
+      }
+
+      // Offsets differ, so the wall time is either skipped (gap) or repeated (overlap).
+      const roundTrips = resolved.toPlainDateTime().equals(plain);
+      return {
+        resolved,
+        conflict: {
+          kind: roundTrips ? 'overlap' : 'gap',
+          earlier,
+          later,
+        },
+      };
+    }
+
+    function describeConflict(plain, timeZone, { kind, earlier, later }, resolved) {
+      const requested = formatWall(plain);
+      if (kind === 'gap') {
+        const shiftMinutes = Math.round(
+          resolved.toPlainDateTime().since(plain).total({ unit: 'minutes' })
+        );
+        return `<strong>Nonexistent time:</strong> ${requested} does not exist in ${timeZone} ` +
+          `because clocks spring forward for daylight saving time (offset changes from ` +
+          `${earlier.offset} to ${later.offset}). The tasting was moved forward by ` +
+          `${shiftMinutes} minutes to <strong>${formatTime(resolved)}</strong> (${resolved.offset}), ` +
+          `the first valid moment after the gap. Your original entry was left unchanged; ` +
+          `consider choosing a different start time.`;
+      }
+      return `<strong>Ambiguous time:</strong> ${requested} occurs twice in ${timeZone} because ` +
+        `clocks fall back at the end of daylight saving time &mdash; once at ${earlier.offset} and ` +
+        `again at ${later.offset}. We used the <strong>first occurrence (${earlier.offset})</strong>. ` +
+        `If you meant the second occurrence, it would be one hour later in absolute terms ` +
+        `(${formatTime(later.withTimeZone('UTC'))} UTC instead of ${formatTime(earlier.withTimeZone('UTC'))} UTC).`;
+    }
+
+    function showError(message) {
+      grid.replaceChildren(el('p', 'planner-error', message));
+      hostWarning.hidden = true;
+      hostWarning.textContent = '';
+    }
+
+    function update() {
+      const hostZone = hostTzSelect.value;
+      if (!dateInput.value || !timeInput.value) {
+        showError('Choose a date and time to see the tasting schedule.');
+        return;
+      }
+
+      let plain;
+      try {
+        plain = Temporal.PlainDate.from(dateInput.value, { overflow: 'reject' })
+          .toPlainDateTime(Temporal.PlainTime.from(timeInput.value, { overflow: 'reject' }));
+      } catch {
+        showError('That date or time is not valid. Please check your entry.');
+        return;
+      }
+
+      const { resolved: hostZdt, conflict } = resolveInZone(plain, hostZone);
+
+      if (conflict) {
+        hostWarning.innerHTML = describeConflict(plain, hostZone, conflict, hostZdt);
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.hidden = true;
+        hostWarning.textContent = '';
+      }
+
+      const hostDate = hostZdt.toPlainDate();
+      const cards = TARGET_ZONES.map(({ id, label }) => {
+        // withTimeZone returns a new ZonedDateTime for the same instant.
+        const local = hostZdt.withTimeZone(id);
+        const card = el('div', 'card tz-card');
+        card.dataset.timezone = id;
+        if (id === hostZone) card.classList.add('is-host');
+
+        const dayDiff = Temporal.PlainDate.compare(local.toPlainDate(), hostDate);
+        const dayNote = dayDiff > 0 ? ' (next day)' : dayDiff < 0 ? ' (previous day)' : '';
+
+        card.append(
+          el('h3', null, label),
+          el('div', 'tz-time', formatTime(local)),
+          el('div', 'tz-date', formatDate(local) + dayNote),
+          el('div', 'tz-offset', `${id} · UTC${local.offset === '+00:00' ? '' : local.offset}`)
+        );
+        if (id === hostZone) card.append(el('span', 'tz-badge', 'Host'));
+        return card;
+      });
+
+      grid.replaceChildren(...cards);
+    }
+
+    // Sensible defaults: the host's next full hour, in New York.
+    const initialZone = hostTzSelect.value;
+    const now = Temporal.Now.zonedDateTimeISO(initialZone)
+      .round({ smallestUnit: 'hour', roundingMode: 'ceil' });
+    dateInput.value = now.toPlainDate().toString();
+    timeInput.value = now.toPlainTime().toString({ smallestUnit: 'minute' });
+
+    [dateInput, timeInput, hostTzSelect].forEach((input) => {
+      input.addEventListener('input', update);
+      input.addEventListener('change', update);
+    });
+
+    update();
+  </script>
