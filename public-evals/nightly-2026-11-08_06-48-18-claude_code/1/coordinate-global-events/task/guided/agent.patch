+  <script type="module">
+    // Use native Temporal when available; otherwise load a polyfill.
+    if (typeof Temporal === 'undefined') {
+      const mod = await import('https://esm.sh/temporal-polyfill@0.3.0');
+      globalThis.Temporal = mod.Temporal;
+    }
+
+    const TARGETS = [
+      { zone: 'America/New_York', label: 'New York' },
+      { zone: 'Europe/London', label: 'London' },
+      { zone: 'Asia/Tokyo', label: 'Tokyo' },
+      { zone: 'UTC', label: 'UTC' },
+    ];
+
+    const dateInput = document.getElementById('dateInput');
+    const timeInput = document.getElementById('timeInput');
+    const hostTzSelect = document.getElementById('hostTzSelect');
+    const grid = document.getElementById('grid');
+    const hostWarning = document.getElementById('hostWarning');
+
+    const timeFmt = { hour: 'numeric', minute: '2-digit' };
+    const dateFmt = { weekday: 'short', month: 'short', day: 'numeric' };
+    const zoneFmt = { timeZoneName: 'short' };
+
+    // Default the date to "today" in the host's selected zone.
+    if (!dateInput.value) {
+      dateInput.value = Temporal.Now.plainDateISO(hostTzSelect.value).toString();
+    }
+
+    function zoneName(zdt) {
+      // Extract only the short zone name (e.g. "EST", "GMT+9") from Intl output.
+      const parts = new Intl.DateTimeFormat('en-US', { ...zoneFmt, timeZone: zdt.timeZoneId })
+        .formatToParts(zdt.epochMilliseconds);
+      return parts.find(p => p.type === 'timeZoneName')?.value ?? zdt.timeZoneId;
+    }
+
+    /**
+     * Resolve the wall-clock input in the host zone and detect DST conflicts.
+     * Returns { zdt, conflict } where conflict is null, or describes a gap/overlap.
+     */
+    function resolveHostTime(plainDateTime, hostZone) {
+      const resolved = plainDateTime.toZonedDateTime(hostZone, { disambiguation: 'compatible' });
+
+      try {
+        plainDateTime.toZonedDateTime(hostZone, { disambiguation: 'reject' });
+        return { zdt: resolved, conflict: null };
+      } catch (err) {
+        if (!(err instanceof RangeError)) throw err;
+      }
+
+      const earlier = plainDateTime.toZonedDateTime(hostZone, { disambiguation: 'earlier' });
+      const later = plainDateTime.toZonedDateTime(hostZone, { disambiguation: 'later' });
+      // In an overlap, both candidates keep the requested wall-clock time (with different offsets).
+      // In a gap, the requested wall-clock time does not exist, so candidates shift away from it.
+      const isOverlap = Temporal.PlainDateTime.compare(earlier.toPlainDateTime(), plainDateTime) === 0;
+
+      return {
+        zdt: resolved,
+        conflict: { type: isOverlap ? 'overlap' : 'gap', earlier, later },
+      };
+    }
+
+    function describeConflict(conflict, requested, hostZone, resolved) {
+      const req = requested.toLocaleString('en-US', timeFmt);
+      const res = resolved.toLocaleString('en-US', timeFmt);
+      const tz = hostZone;
+      if (conflict.type === 'gap') {
+        const shiftMin = Math.round(
+          conflict.later.toPlainDateTime().since(requested).total({ unit: 'minutes' })
+        );
+        return `<strong>Heads up: ${req} doesn't exist in ${tz} on this date.</strong> ` +
+          `Clocks spring forward for daylight saving time, skipping that hour. ` +
+          `We moved the tasting forward by ${shiftMin} minutes to <strong>${res} ${zoneName(resolved)}</strong> ` +
+          `(UTC offset ${resolved.offset}), which is the same moment the clock would have read ${req} ` +
+          `under the old offset.`;
+      }
+      return `<strong>Heads up: ${req} happens twice in ${tz} on this date.</strong> ` +
+        `Clocks fall back at the end of daylight saving time, so this hour repeats ` +
+        `(first at UTC offset ${conflict.earlier.offset}, then at ${conflict.later.offset}). ` +
+        `We scheduled the tasting for the <strong>first occurrence, ${res} ${zoneName(resolved)}</strong> ` +
+        `(UTC offset ${resolved.offset}). If you meant the second one, all times below would be one hour later.`;
+    }
+
+    function renderCard({ zone, label }, zdt, hostDate, isHost) {
+      const card = document.createElement('article');
+      card.className = 'tz-card' + (isHost ? ' is-host' : '');
+
+      const dayDiff = zdt.toPlainDate().since(hostDate).days;
+      const dayNote = dayDiff === 0 ? '' : ` (${dayDiff > 0 ? '+' : ''}${dayDiff} day${Math.abs(dayDiff) === 1 ? '' : 's'})`;
+
+      const h3 = document.createElement('h3');
+      h3.textContent = label;
+      const time = document.createElement('time');
+      time.className = 'tz-time';
+      time.dateTime = zdt.toInstant().toString();
+      time.textContent = zdt.toLocaleString('en-US', timeFmt);
+      const date = document.createElement('span');
+      date.className = 'tz-date';
+      date.textContent = zdt.toLocaleString('en-US', dateFmt) + dayNote;
+      const tz = document.createElement('span');
+      tz.className = 'tz-zone';
+      tz.textContent = `${zoneName(zdt)} · UTC${zdt.offset === '+00:00' ? '' : zdt.offset}`;
+
+      card.append(h3, time, date, tz);
+      if (isHost) {
+        const badge = document.createElement('span');
+        badge.className = 'tz-badge';
+        badge.textContent = 'Host';
+        card.append(badge);
+      }
+      return card;
+    }
+
+    function update() {
+      const hostZone = hostTzSelect.value;
+      let plainDateTime;
+      try {
+        plainDateTime = Temporal.PlainDate.from(dateInput.value)
+          .toPlainDateTime(Temporal.PlainTime.from(timeInput.value));
+      } catch {
+        hostWarning.hidden = true;
+        grid.innerHTML = '<p class="tz-status">Choose a date and start time to see local times.</p>';
+        return;
+      }
+
+      const { zdt: hostZdt, conflict } = resolveHostTime(plainDateTime, hostZone);
+      // hostZdt is immutable: withTimeZone() returns new objects and never alters it.
+
+      if (conflict) {
+        hostWarning.innerHTML = describeConflict(conflict, plainDateTime, hostZone, hostZdt);
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      const hostDate = hostZdt.toPlainDate();
+      grid.replaceChildren(
+        ...TARGETS.map(target =>
+          renderCard(target, hostZdt.withTimeZone(target.zone), hostDate, target.zone === hostZone)
+        )
+      );
+    }
+
+    for (const el of [dateInput, timeInput, hostTzSelect]) {
+      el.addEventListener('input', update);
+      el.addEventListener('change', update);
+    }
+    update();
+  </script>
+
 </body>
 
