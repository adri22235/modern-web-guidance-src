diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,31 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Dashboard</title>
+
+  <!-- Critical interactivity: fetch at high priority, execute as soon as it arrives -->
+  <script src="/js/app.js" async fetchpriority="high"></script>
+
+  <!-- Legacy widgets: deferred so they no longer block parsing, but still run in order after the DOM is parsed -->
+  <script src="/js/legacy-widgets.js" defer></script>
+
+  <!-- Analytics: independent and non-critical, so load it async at low priority -->
+  <script src="/js/tracker.js" async fetchpriority="low"></script>
+
+  <style>
+    body { font-family: system-ui, sans-serif; margin: 0; padding: 1rem; }
+    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem; }
+    .card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; }
+  </style>
+</head>
+<body>
+  <h1>Dashboard</h1>
+  <main class="grid">
+    <section class="card" id="stats">Stats</section>
+    <section class="card" id="activity">Activity</section>
+    <section class="card" id="widgets">Widgets</section>
+  </main>
+</body>
+</html>
