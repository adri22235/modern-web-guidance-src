index 0000000..243ebb9
--- /dev/null
+++ b/components/drink-card.js
@@ -0,0 +1,183 @@
+/**
+ * <drink-card> — reusable menu card with encapsulated (Shadow DOM) styles.
+ *
+ * Attributes (all reactive — change them at any time):
+ *   heading      Card title, e.g. "Cold Brew"
+ *   description  Short description text
+ *   href         Action link URL
+ *   link-text    Action link label (default: "View Details")
+ *   limited      Boolean; when present, shows a "Limited" badge
+ *   badge-text   Optional badge label override (default: "Limited")
+ *
+ * JS properties mirror the attributes: card.limited = true / false, etc.
+ *
+ * Theming: the card reads the page's --primary, --text and --accent custom
+ * properties (which inherit through the shadow boundary) with built-in
+ * fallbacks, so global selectors like `.card` or `h3` can't leak in.
+ */
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      contain: content;
+    }
+
+    :host([hidden]) {
+      display: none;
+    }
+
+    .card {
+      position: relative;
+      box-sizing: border-box;
+      height: 100%;
+      background: #fff;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      color: var(--text, #3e2723);
+      font: inherit;
+      line-height: 1.6;
+    }
+
+    .badge {
+      position: absolute;
+      top: 12px;
+      right: 12px;
+      background: var(--accent, #ffab40);
+      color: var(--text, #3e2723);
+      font-size: 0.7rem;
+      font-weight: 700;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      font-size: 1.17em;
+      color: var(--primary, #4e342e);
+    }
+
+    p {
+      margin: 0;
+    }
+
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: #fff;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    a:hover,
+    a:focus-visible {
+      background: #3e2723;
+    }
+
+    a:focus-visible {
+      outline: 2px solid var(--accent, #ffab40);
+      outline-offset: 2px;
+    }
+  </style>
+  <article class="card" part="card">
+    <span class="badge" part="badge" hidden></span>
+    <h3 part="heading"></h3>
+    <p part="description"></p>
+    <a part="link"></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'description', 'href', 'link-text', 'limited', 'badge-text'];
+  }
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.appendChild(template.content.cloneNode(true));
+    this._badge = root.querySelector('.badge');
+    this._heading = root.querySelector('h3');
+    this._description = root.querySelector('p');
+    this._link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    // Handle properties set before the element was upgraded.
+    for (const prop of ['heading', 'description', 'href', 'linkText', 'limited', 'badgeText']) {
+      if (Object.prototype.hasOwnProperty.call(this, prop)) {
+        const value = this[prop];
+        delete this[prop];
+        this[prop] = value;
+      }
+    }
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  _render() {
+    const heading = this.getAttribute('heading') || '';
+    this._heading.textContent = heading;
+    this._description.textContent = this.getAttribute('description') || '';
+
+    const linkText = this.getAttribute('link-text') || 'View Details';
+    this._link.textContent = linkText;
+    this._link.href = this.getAttribute('href') || '#';
+    if (heading) {
+      this._link.setAttribute('aria-label', `${linkText}: ${heading}`);
+    } else {
+      this._link.removeAttribute('aria-label');
+    }
+
+    this._badge.textContent = this.getAttribute('badge-text') || 'Limited';
+    this._badge.hidden = !this.hasAttribute('limited');
+  }
+
+  get limited() {
+    return this.hasAttribute('limited');
+  }
+
+  set limited(value) {
+    this.toggleAttribute('limited', Boolean(value));
+  }
+}
+
+const stringProps = {
+  heading: 'heading',
+  description: 'description',
+  href: 'href',
+  linkText: 'link-text',
+  badgeText: 'badge-text',
+};
+for (const [prop, attr] of Object.entries(stringProps)) {
+  Object.defineProperty(DrinkCard.prototype, prop, {
+    get() {
+      return this.getAttribute(attr) || '';
+    },
+    set(value) {
+      if (value == null) this.removeAttribute(attr);
+      else this.setAttribute(attr, String(value));
+    },
+    configurable: true,
+  });
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
+
+export { DrinkCard };
