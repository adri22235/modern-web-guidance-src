+/**
+ * <drink-card> — reusable, style-isolated product card.
+ *
+ * Usage:
+ *   <drink-card href="/menu/seasonal" limited>
+ *     <span slot="heading">Maple Oat Latte</span>
+ *     Creamy oat milk with a hint of Vermont maple syrup.
+ *     <span slot="action">View Details</span>   <!-- optional, defaults to "View Details" -->
+ *     <span slot="badge">Limited</span>          <!-- optional, defaults to "Limited" -->
+ *   </drink-card>
+ *
+ * Attributes / properties:
+ *   href     (string)  – destination of the action link.
+ *   limited  (boolean) – shows the "Limited" badge when present. Toggle at any
+ *                        time via the attribute or `card.limited = true/false`.
+ *
+ * Theming (inherited custom properties, all optional):
+ *   --drink-card-bg, --drink-card-accent, --drink-card-accent-hover,
+ *   --drink-card-action-fg, --drink-card-badge-bg, --drink-card-badge-fg
+ *
+ * Parts: card, heading, description, action, badge
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  :host {
+    --_bg: var(--drink-card-bg, #fff);
+    --_accent: var(--drink-card-accent, #4e342e);
+    --_accent-hover: var(--drink-card-accent-hover, #3e2723);
+    --_action-fg: var(--drink-card-action-fg, #fff);
+    --_badge-bg: var(--drink-card-badge-bg, #ffab40);
+    --_badge-fg: var(--drink-card-badge-fg, #3e2723);
+
+    display: block;
+    box-sizing: border-box;
+  }
+  :host([hidden]) { display: none; }
+
+  *, *::before, *::after { box-sizing: inherit; }
+
+  .card {
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    height: 100%;
+    margin: 0;
+    padding: 20px;
+    background: var(--_bg);
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+    text-align: center;
+  }
+
+  .badge {
+    display: none;
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    padding: 2px 10px;
+    border-radius: 999px;
+    background: var(--_badge-bg);
+    color: var(--_badge-fg);
+    font-size: 0.75rem;
+    font-weight: 700;
+    letter-spacing: 0.05em;
+    line-height: 1.6;
+    text-transform: uppercase;
+  }
+  :host([limited]) .badge { display: inline-block; }
+
+  h3 {
+    margin: 0 0 10px;
+    padding: 0;
+    color: var(--_accent);
+    font-size: 1.17em;
+    line-height: 1.3;
+  }
+  :host([limited]) h3 { padding-inline: 4.5rem; }
+
+  p {
+    flex-grow: 1;
+    margin: 0;
+    padding: 0;
+  }
+
+  a {
+    display: inline-block;
+    margin-top: 15px;
+    padding: 10px 20px;
+    border-radius: 5px;
+    background: var(--_accent);
+    color: var(--_action-fg);
+    font: inherit;
+    text-decoration: none;
+    transition: background 0.3s;
+  }
+  a:hover { background: var(--_accent-hover); }
+  a:focus-visible { outline: 2px solid var(--_accent); outline-offset: 3px; }
+  a:not([href]) { display: none; }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article class="card" part="card">
+    <span class="badge" part="badge"><slot name="badge">Limited</slot></span>
+    <h3 part="heading"><slot name="heading"></slot></h3>
+    <p part="description"><slot></slot></p>
+    <a part="action"><slot name="action">View Details</slot></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['href'];
+
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.adoptedStyleSheets = [sheet];
+    root.append(template.content.cloneNode(true));
+    this.#link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    this.#syncHref();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) this.#syncHref();
+  }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(v) { v ? this.setAttribute('href', v) : this.removeAttribute('href'); }
+
+  get limited() { return this.hasAttribute('limited'); }
+  set limited(on) { this.toggleAttribute('limited', !!on); }
+
+  #syncHref() {
+    const href = this.getAttribute('href');
+    if (href) this.#link.setAttribute('href', href);
+    else this.#link.removeAttribute('href');
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
+
+export { DrinkCard };
