+  <script>
+    (() => {
+      const KEY = "color-scheme";
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const systemDark = matchMedia("(prefers-color-scheme: dark)");
+
+      const readStored = () => {
+        try { return localStorage.getItem(KEY); } catch (e) { return null; }
+      };
+      const apply = (value) => { meta.content = value ?? "light dark"; };
+
+      document.getElementById("theme-toggle").addEventListener("click", () => {
+        const system = systemDark.matches ? "dark" : "light";
+        const stored = meta.content === "light" || meta.content === "dark" ? meta.content : null;
+        const rendered = stored ?? system;
+        const target = rendered === "dark" ? "light" : "dark";
+
+        // Matching the system means the user is undoing their override: go back to following the system.
+        const next = target === system ? null : target;
+        try {
+          if (next) localStorage.setItem(KEY, next);
+          else localStorage.removeItem(KEY);
+        } catch (e) { }
+        apply(next);
+      });
+
+      // Keep other open tabs in sync.
+      addEventListener("storage", (e) => {
+        if (e.key === KEY || e.key === null) apply(readStored());
+      });
+    })();
+  </script>
+
