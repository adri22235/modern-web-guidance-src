+      const board = document.getElementById('board');
+      const cols = Object.fromEntries(
+        [...board.querySelectorAll('.board-col')].map((c) => [c.dataset.stage, c])
+      );
+      const STAGES = ['queued', 'brewing', 'ready'];
+      const NAMES = ['Ava', 'Ben', 'Chloe', 'Dev', 'Elif', 'Femi', 'Gus', 'Hana', 'Ivo', 'Jules'];
+      let tickets = [];
+      let nextTicket = 101;
+      let paused = false;
+
+      function renderBoard() {
+        for (const stage of STAGES) {
+          const col = cols[stage];
+          const nodes = tickets
+            .filter((t) => t.stage === stage)
+            .map((t) => {
+              const el = document.createElement('div');
+              el.className = 'ticket' + (t.mine ? ' mine' : '');
+              el.style.viewTransitionName = `ticket-${t.no}`;
+              const strong = document.createElement('strong');
+              strong.textContent = `#${t.no}${t.mine ? ' · You' : ` · ${t.customer}`}`;
+              el.append(strong, document.createTextNode(t.label));
+              return el;
+            });
+          col.replaceChildren(col.querySelector('h3'), ...nodes);
+        }
+      }
+
+      function enqueueTicket({ label, mine = false }) {
+        transitionWithin(board, () => {
+          tickets.push({
+            no: nextTicket++,
+            label,
+            mine,
+            customer: NAMES[Math.floor(Math.random() * NAMES.length)],
+            stage: 'queued',
+            age: 0,
+          });
+          renderBoard();
+        });
+      }
+
+      function tick() {
+        if (paused || document.hidden) return;
+        transitionWithin(board, () => {
+          // Drop tickets that have been ready for a while.
+          tickets = tickets.filter((t) => !(t.stage === 'ready' && t.age > 2));
+          // Advance at most one ticket per stage so movement is readable.
+          const brewing = tickets.find((t) => t.stage === 'brewing' && t.age >= 1);
+          const queued = tickets.find((t) => t.stage === 'queued');
+          if (brewing) { brewing.stage = 'ready'; brewing.age = 0; }
+          if (queued && tickets.filter((t) => t.stage === 'brewing').length < 2) {
+            queued.stage = 'brewing'; queued.age = 0;
+          }
+          for (const t of tickets) t.age++;
+          // Keep some walk-in traffic flowing.
+          if (tickets.filter((t) => t.stage === 'queued').length < 2 && Math.random() < 0.7) {
+            const d = DRINKS[Math.floor(Math.random() * DRINKS.length)];
+            tickets.push({
+              no: nextTicket++,
+              label: `1× ${d.name}`,
+              mine: false,
+              customer: NAMES[Math.floor(Math.random() * NAMES.length)],
+              stage: 'queued',
+              age: 0,
+            });
+          }
+          renderBoard();
+        });
+      }
+
+      const pauseBtn = document.getElementById('board-pause');
+      const boardStatus = document.getElementById('board-status');
+      pauseBtn.addEventListener('click', () => {
+        paused = !paused;
+        pauseBtn.textContent = paused ? '▶' : '❚❚';
+        pauseBtn.setAttribute('aria-label', paused ? 'Resume board' : 'Pause board');
+        boardStatus.textContent = paused ? 'Paused' : 'Live';
+      });
+      if (reducedMotion.matches) pauseBtn.click();
+
+      // Seed a couple of tickets, then keep the board moving.
+      tickets.push(
+        { no: nextTicket++, label: '2× Cold Brew', mine: false, customer: 'Ava', stage: 'brewing', age: 1 },
+        { no: nextTicket++, label: '1× Maple Oat Latte', mine: false, customer: 'Dev', stage: 'queued', age: 0 },
+      );
+      renderBoard();
+      setInterval(tick, 2600);
+    })();
+  </script>
