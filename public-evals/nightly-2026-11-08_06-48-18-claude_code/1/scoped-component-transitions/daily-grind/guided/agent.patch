+  <script>
+    // Element-scoped view transitions: each component animates in its own subtree,
+    // so the rest of the page stays interactive and components can animate concurrently.
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM(); // Graceful fallback: apply the change without animation
+        return;
+      }
+      const transition = scopeEl.startViewTransition(() => updateDOM());
+      // Rapid re-triggers on the same scope skip the active transition and reject `ready`
+      transition.ready.catch(() => {});
+    }
+
+    // ---- Seasonal cards: expand / collapse details ----
+    document.querySelectorAll('.grid .card').forEach((card) => {
+      const toggle = card.querySelector('[data-action="toggle"]');
+      const details = card.querySelector('.details');
+
+      toggle.addEventListener('click', () => {
+        const expand = details.hidden;
+        runScopedTransition(card, () => {
+          details.hidden = !expand;
+          card.classList.toggle('is-expanded', expand);
+          toggle.setAttribute('aria-expanded', String(expand));
+          toggle.textContent = expand ? 'Hide Details' : 'View Details';
+        });
+      });
+
+      card.querySelector('[data-action="add"]').addEventListener('click', () => {
+        addToOrder(card.dataset.id, card.dataset.name, Number(card.dataset.price));
+      });
+    });
+
+    // ---- Order panel: add, remove, reorder ----
+    const orderEl = document.getElementById('order');
+    const listEl = document.getElementById('order-list');
+    const emptyEl = document.getElementById('order-empty');
+    const totalEl = document.getElementById('order-total');
+    const sortButtons = orderEl.querySelectorAll('[data-sort]');
+    let sortMode = 'added';
+    let addedCounter = 0;
+    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+    function refreshSummary() {
+      const items = [...listEl.children];
+      const total = items.reduce((sum, li) => sum + Number(li.dataset.price) * Number(li.dataset.qty), 0);
+      emptyEl.hidden = items.length > 0;
+      totalEl.hidden = items.length === 0;
+      totalEl.textContent = `Total: ${money.format(total)}`;
+    }
+
+    function sortedItems() {
+      const items = [...listEl.children];
+      const by = {
+        added: (a, b) => a.dataset.added - b.dataset.added,
+        name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
+        price: (a, b) => b.dataset.price - a.dataset.price,
+      }[sortMode];
+      return items.sort(by);
+    }
+
+    // Move existing nodes (never recreate) so `match-element` can track identity
+    function applySort() {
+      for (const li of sortedItems()) listEl.appendChild(li);
+    }
+
+    function createItem(id, name, price) {
+      const li = document.createElement('li');
+      Object.assign(li.dataset, { id, name, price, qty: 1, added: ++addedCounter });
+
+      const label = document.createElement('span');
+      const title = document.createElement('strong');
+      title.textContent = name;
+      const qty = document.createElement('span');
+      qty.className = 'qty';
+      label.append(title, ' ', qty);
+
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      remove.addEventListener('click', () => removeItem(li));
+
+      li.append(label, remove);
+      updateQty(li);
+      return li;
+    }
+
+    function updateQty(li) {
+      const qty = Number(li.dataset.qty);
+      li.querySelector('.qty').textContent =
+        `× ${qty} · ${money.format(Number(li.dataset.price) * qty)}`;
+    }
+
+    function addToOrder(id, name, price) {
+      runScopedTransition(orderEl, () => {
+        const existing = listEl.querySelector(`li[data-id="${id}"]`);
+        if (existing) {
+          existing.dataset.qty = Number(existing.dataset.qty) + 1;
+          updateQty(existing);
+        } else {
+          listEl.appendChild(createItem(id, name, price));
+          applySort();
+        }
+        refreshSummary();
+      });
+    }
+
+    function removeItem(li) {
+      const hadFocus = li.contains(document.activeElement);
+      const nextFocusTarget =
+        li.nextElementSibling?.querySelector('button') ??
+        li.previousElementSibling?.querySelector('button') ??
+        orderEl.querySelector('[data-sort][aria-pressed="true"]');
+
+      runScopedTransition(orderEl, () => {
+        li.remove();
+        refreshSummary();
+        if (hadFocus) nextFocusTarget?.focus();
+      });
+    }
+
+    sortButtons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        if (btn.dataset.sort === sortMode) return;
+        // Only the list order changes, so scope to the list and keep the header controls live
+        runScopedTransition(listEl, () => {
+          sortMode = btn.dataset.sort;
+          sortButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+          applySort();
+        });
+      });
+    });
+
+    refreshSummary();
+  </script>
+
 </body>
 
