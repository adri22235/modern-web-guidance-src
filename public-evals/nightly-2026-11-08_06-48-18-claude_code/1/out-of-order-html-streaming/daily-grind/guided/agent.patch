+  <script>
+    // Feature-detect native Out-of-Order HTML streaming before the body is parsed.
+    // Browsers without processing-instruction support parse <?marker>/<?start>/<?end>
+    // as comments; template-for-polyfill still understands that syntax, so the markup
+    // stays identical for every browser.
+    (() => {
+      const probe = document.createRange().createContextualFragment('<?marker name="probe">').firstChild;
+      window.__dgSupport = {
+        templateFor: !!probe && probe.nodeType === Node.PROCESSING_INSTRUCTION_NODE,
+        htmlSetters: 'streamHTML' in Element.prototype && 'streamHTMLUnsafe' in Element.prototype,
+        // Captured before any polyfill runs, so we only trust a *native* sanitizer for user content.
+        nativeSanitizer: 'Sanitizer' in window && 'setHTML' in Element.prototype,
+      };
+      const load = (url) => import(url).catch((err) => console.error('Polyfill failed to load:', url, err));
+      window.__dgPolyfills = Promise.all([
+        window.__dgSupport.templateFor ? null : load('https://esm.sh/template-for-polyfill'),
+        window.__dgSupport.htmlSetters ? null : load('https://esm.sh/html-setters-polyfill'),
+      ]);
+    })();
+  </script>
