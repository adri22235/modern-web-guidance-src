+  <script type="module">
+    const support = window.__dgSupport;
+    await window.__dgPolyfills;
+
+    const cards = document.getElementById('seasonal-cards');
+    const reviews = document.getElementById('seasonal-reviews');
+    const promo = document.getElementById('seasonal-promo');
+
+    // The declarative <template for> patch has run by the time this deferred module executes.
+    cards.setAttribute('aria-busy', 'false');
+
+    // --- Menu cards: refresh in place with fresh server HTML whenever the menu changes ---
+    // Cards never need scripts, so use the *safe* streaming setter (built-in sanitizer).
+    let cardsController;
+    async function refreshCards() {
+      cardsController?.abort(); // a newer menu version supersedes any in-flight stream
+      const controller = (cardsController = new AbortController());
+      cards.setAttribute('aria-busy', 'true');
+      try {
+        const res = await fetch('/fragments/menu/seasonal', {
+          signal: controller.signal,
+          headers: { Accept: 'text/html' },
+        });
+        if (!res.ok) throw new Error(`Menu fragment failed: ${res.status}`);
+        await res.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(cards.streamHTML(), { signal: controller.signal });
+      } catch (err) {
+        if (err.name !== 'AbortError') console.error(err); // keep the last good cards on failure
+      } finally {
+        if (cardsController === controller) cards.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    // Server pushes an event each time the menu is edited.
+    if ('EventSource' in window) {
+      const menuEvents = new EventSource('/events/menu');
+      menuEvents.addEventListener('menu-updated', refreshCards);
+    }
+
+    // --- Customer reviews: untrusted, sanitized with a strict allowlist ---
+    const REVIEW_ELEMENTS = ['article', 'p', 'blockquote', 'cite', 'strong', 'em', 'b', 'i', 'br', 'footer'];
+    const REVIEW_ATTRIBUTES = [];
+
+    async function sanitizeIntoReviews(html) {
+      if (support.nativeSanitizer) {
+        // Native setHTML() always strips XSS-unsafe content; the config narrows it further.
+        reviews.setHTML(html, { sanitizer: { elements: REVIEW_ELEMENTS, attributes: REVIEW_ATTRIBUTES } });
+      } else {
+        // Only browsers lacking a native Sanitizer download DOMPurify.
+        const { default: DOMPurify } = await import('https://esm.sh/dompurify@3');
+        reviews.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...REVIEW_ELEMENTS, '#text'],
+          ALLOWED_ATTR: REVIEW_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false,
+        });
+      }
+    }
+
+    async function loadReviews() {
+      try {
+        const res = await fetch('/fragments/reviews/seasonal', { headers: { Accept: 'text/html' } });
+        if (!res.ok) throw new Error(`Reviews failed: ${res.status}`);
+        await sanitizeIntoReviews(await res.text());
+      } catch (err) {
+        console.error(err);
+        reviews.textContent = 'Reviews are unavailable right now.';
+      } finally {
+        reviews.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    // --- CMS promo: trusted first-party HTML whose embedded widget script must execute ---
+    async function loadPromo() {
+      try {
+        const res = await fetch('/cms/promos/seasonal', { headers: { Accept: 'text/html' } });
+        if (!res.ok) throw new Error(`Promo failed: ${res.status}`);
+        // Unsafe + runScripts is deliberate and limited to our own CMS origin.
+        await res.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+      } catch (err) {
+        console.error(err);
+        promo.closest('.promo').hidden = true;
+      } finally {
+        promo.setAttribute('aria-busy', 'false');
+      }
+    }
+
+    loadReviews();
+    loadPromo();
+  </script>
+
