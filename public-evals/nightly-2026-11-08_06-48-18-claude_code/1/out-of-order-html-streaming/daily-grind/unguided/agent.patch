+  <script>
+    /*
+     * Seasonal Favorites in-place updates.
+     *
+     * Trust model:
+     *  - Coffee cards + customer reviews are rendered with the safe
+     *    Element.setHTML() (HTML Sanitizer API): scripts, event handlers and
+     *    javascript: URLs are always stripped. Reviews are user-generated and
+     *    must never go through an "unsafe" API.
+     *  - The promo block comes from our own CMS and ships its own widget
+     *    <script>; it is the ONLY content inserted through a script-executing
+     *    path, and only into #seasonal-promo, fetched from our own origin.
+     *
+     * Initial load uses out-of-order streaming: the page ships placeholder
+     * skeletons, and the real markup arrives later in the same document in
+     * <template for="target-id"> elements. Browsers with native declarative
+     * partial updates apply these themselves; elsewhere the small shim below
+     * applies them as they are parsed.
+     */
+    (() => {
+      'use strict';
+
+      // ---- Safe HTML insertion (Sanitizer API with inert fallback) --------
+      const ALLOWED_TAGS = new Set(['ARTICLE', 'DIV', 'SECTION', 'H3', 'H4', 'P', 'A', 'IMG', 'SPAN',
+        'STRONG', 'EM', 'B', 'I', 'UL', 'OL', 'LI', 'BLOCKQUOTE', 'CITE', 'FOOTER', 'FIGURE',
+        'FIGCAPTION', 'BR', 'TIME', 'SMALL']);
+      const ALLOWED_ATTRS = new Set(['class', 'href', 'src', 'alt', 'title', 'datetime', 'loading',
+        'width', 'height', 'aria-label']);
+
+      const isSafeUrl = (value, attr) => {
+        try {
+          const url = new URL(value, document.baseURI);
+          return attr === 'src' ? url.protocol === 'https:' || url.origin === location.origin
+                                : ['http:', 'https:', 'mailto:'].includes(url.protocol);
+        } catch { return false; }
+      };
+
+      function sanitizeFallback(html) {
+        // DOMParser documents are inert: no scripts run, no resources load.
+        const doc = new DOMParser().parseFromString(html, 'text/html');
+        const walk = (node) => {
+          for (const child of [...node.children]) {
+            if (!ALLOWED_TAGS.has(child.tagName)) { child.remove(); continue; }
+            for (const { name, value } of [...child.attributes]) {
+              const ok = ALLOWED_ATTRS.has(name) &&
+                ((name !== 'href' && name !== 'src') || isSafeUrl(value, name));
+              if (!ok) child.removeAttribute(name);
+            }
+            if (child.tagName === 'A') child.setAttribute('rel', 'noopener noreferrer ugc');
+            walk(child);
+          }
+        };
+        walk(doc.body);
+        const frag = document.createDocumentFragment();
+        frag.append(...doc.body.childNodes);
+        return frag;
+      }
+
+      function setSafeHTML(el, html) {
+        if (typeof el.setHTML === 'function') {
+          el.setHTML(html); // default safe sanitizer config
+        } else {
+          el.replaceChildren(sanitizeFallback(html));
+        }
+      }
+
+      // ---- Trusted CMS promo insertion (executes the embedded widget) -----
+      const PROMO_ENDPOINT = '/cms/promos/seasonal-favorites';
+
+      function setTrustedPromoHTML(el, html) {
+        // createContextualFragment marks scripts runnable, so the CMS widget
+        // script executes when inserted. Never call this with user content.
+        const frag = document.createRange().createContextualFragment(html);
+        el.replaceChildren(frag);
+      }
+
+      // ---- Shim for <template for="..."> streaming -------------------------
+      // Native support consumes the template during parsing; anything still in
+      // the DOM afterwards is applied here. Only safe targets are allowed.
+      const STREAM_TARGETS = new Set(['seasonal-cards', 'seasonal-reviews']);
+
+      function applyStreamedTemplate(tpl, final = false) {
+        // A template's content streams in incrementally; only apply it once the
+        // parser has moved past </template> (a following sibling exists).
+        if (!tpl.isConnected || (!final && !tpl.nextSibling)) return;
+        const id = tpl.getAttribute('for');
+        const target = id && STREAM_TARGETS.has(id) && document.getElementById(id);
+        if (!target) return;
+        const wrapper = document.createElement('div');
+        wrapper.append(tpl.content.cloneNode(true));
+        setSafeHTML(target, wrapper.innerHTML);
+        target.removeAttribute('aria-busy');
+        tpl.remove();
+      }
+
+      const scan = (final = false) =>
+        document.querySelectorAll('template[for]').forEach((tpl) => applyStreamedTemplate(tpl, final));
+      const streamObserver = new MutationObserver(() => queueMicrotask(scan));
+      streamObserver.observe(document.documentElement, { childList: true, subtree: true });
+      document.addEventListener('DOMContentLoaded', () => {
+        scan(true);
+        streamObserver.disconnect();
+        // Clear aria-busy if the browser applied the templates natively.
+        for (const id of STREAM_TARGETS) {
+          const el = document.getElementById(id);
+          if (el && !el.querySelector('.skeleton')) el.removeAttribute('aria-busy');
+        }
+        loadPromo();
+        listenForMenuChanges();
+      });
+
+      // ---- Live refresh when the menu changes -------------------------------
+      const FRAGMENTS = {
+        'seasonal-cards': '/fragments/seasonal-favorites/cards',
+        'seasonal-reviews': '/fragments/seasonal-favorites/reviews',
+      };
+      let inflight = null;
+
+      async function fetchHTML(url, signal) {
+        const res = await fetch(url, {
+          signal,
+          credentials: 'same-origin',
+          headers: { Accept: 'text/html' },
+          cache: 'no-store',
+        });
+        if (!res.ok) throw new Error(`${url} -> ${res.status}`);
+        return res.text();
+      }
+
+      async function loadPromo(signal) {
+        const promo = document.getElementById('seasonal-promo');
+        if (!promo) return;
+        try {
+          const html = await fetchHTML(PROMO_ENDPOINT, signal);
+          setTrustedPromoHTML(promo, html);
+        } catch (err) {
+          if (err.name !== 'AbortError') console.warn('Promo unavailable:', err);
+        }
+      }
+
+      async function refreshSeasonal() {
+        inflight?.abort();
+        const controller = new AbortController();
+        inflight = controller;
+        const { signal } = controller;
+        const status = document.getElementById('seasonal-status');
+
+        try {
+          const entries = await Promise.all(Object.entries(FRAGMENTS).map(
+            async ([id, url]) => [id, await fetchHTML(url, signal)]));
+          if (signal.aborted) return;
+
+          const apply = () => {
+            for (const [id, html] of entries) {
+              const el = document.getElementById(id);
+              if (el) setSafeHTML(el, html);
+            }
+          };
+          if (document.startViewTransition &&
+              !matchMedia('(prefers-reduced-motion: reduce)').matches) {
+            document.startViewTransition(apply);
+          } else {
+            apply();
+          }
+          if (status) status.textContent = 'Seasonal menu updated.';
+          await loadPromo(signal);
+        } catch (err) {
+          if (err.name !== 'AbortError') console.warn('Seasonal refresh failed:', err);
+        } finally {
+          if (inflight === controller) inflight = null;
+        }
+      }
+
+      function listenForMenuChanges() {
+        if (!('EventSource' in window)) return;
+        // Server pushes a `menu-changed` event whenever the menu is edited.
+        const events = new EventSource('/api/menu/events');
+        events.addEventListener('menu-changed', refreshSeasonal);
+        window.addEventListener('pagehide', () => events.close(), { once: true });
+      }
+
+      window.DailyGrind = Object.assign(window.DailyGrind || {}, { refreshSeasonal });
+    })();
+  </script>
 </head>
 
