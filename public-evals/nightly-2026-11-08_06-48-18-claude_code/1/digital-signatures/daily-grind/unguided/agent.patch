diff --git a/tests/signing-core.test.mjs b/tests/signing-core.test.mjs
new file mode 100644
index 0000000..69c1e85
--- /dev/null
+++ b/tests/signing-core.test.mjs
@@ -0,0 +1,64 @@
+// Run with: node --test tests/
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as core from '../js/signing-core.js';
+
+const receipt = () => ({
+  id: 'R-TEST1', store: 'The Daily Grind — Main St', issuedAt: '2026-11-08T08:00:00.000Z', currency: 'USD',
+  items: [{ name: 'Cold Brew', qty: 2, unitCents: 495 }], subtotalCents: 990, taxCents: 79, totalCents: 1069,
+});
+const voucher = () => ({
+  code: 'GV-ABCD-EFGH', recipient: 'Sam', from: 'Alex', message: 'Enjoy!', amountCents: 2500,
+  currency: 'USD', issuedAt: '2026-11-08T08:00:00.000Z', expiresAt: '2027-11-08T08:00:00.000Z',
+});
+const now = new Date('2026-11-09T00:00:00Z');
+
+for (const alg of Object.keys(core.ALGORITHMS)) {
+  test(`${alg}: sign/verify round trip, trust and tamper detection`, async () => {
+    const key = await core.generateKeyPair(alg);
+    const trusted = new Map([[key.kid, { alg, label: 'Shop' }]]);
+    for (const [typ, p] of [['receipt', receipt()], ['voucher', voucher()]]) {
+      const { token, envelope } = await core.signDocument(key, typ, p);
+      let r = await core.verifyDocument(token, trusted, now);
+      assert.equal(r.status, 'trusted', r.errors.join());
+      assert.deepEqual(r.warnings, []);
+      r = await core.verifyDocument(token, new Map(), now);
+      assert.equal(r.status, 'untrusted');
+
+      // tamper payload
+      const t1 = structuredClone(envelope);
+      if (typ === 'receipt') t1.payload.totalCents = 1; else t1.payload.amountCents = 50000;
+      assert.equal((await core.verifyDocument(core.encodeToken(t1), trusted, now)).status, 'invalid');
+      // type confusion
+      const t2 = structuredClone(envelope); t2.typ = typ === 'receipt' ? 'voucher' : 'receipt';
+      assert.equal((await core.verifyDocument(t2, trusted, now)).status, 'invalid');
+      // key substitution: attacker key re-signs, claims victim's kid
+      const evil = await core.generateKeyPair(alg);
+      const forged = (await core.signDocument(evil, typ, p)).envelope;
+      assert.equal((await core.verifyDocument(forged, trusted, now)).status, 'untrusted');
+      forged.kid = key.kid;
+      assert.equal((await core.verifyDocument(forged, trusted, now)).status, 'invalid');
+    }
+  });
+}
+
+test('public key export/import round trip', async () => {
+  const key = await core.generateKeyPair('ECDSA-P256');
+  const imp = await core.importPublicKey(core.exportPublicKey({ ...key, label: 'Main St' }));
+  assert.equal(imp.kid, key.kid);
+  assert.equal(imp.label, 'Main St');
+});
+
+test('expired voucher produces warning; garbage rejected', async () => {
+  const key = await core.generateKeyPair('ECDSA-P256');
+  const { token } = await core.signDocument(key, 'voucher', voucher());
+  const r = await core.verifyDocument(token, new Map(), new Date('2028-01-01T00:00:00Z'));
+  assert.ok(r.warnings.includes('Voucher has expired'));
+  assert.equal((await core.verifyDocument('DG1.@@@', new Map())).status, 'invalid');
+  assert.equal((await core.verifyDocument('hello', new Map())).status, 'invalid');
+});
+
+test('canonicalize sorts keys deterministically', () => {
+  assert.equal(core.canonicalize({ b: 1, a: [true, null, 'x'] }), '{"a":[true,null,"x"],"b":1}');
+  assert.throws(() => core.canonicalize({ a: NaN }));
+});
