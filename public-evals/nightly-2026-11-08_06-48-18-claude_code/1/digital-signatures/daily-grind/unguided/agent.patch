+  if (!key) return toast('Generate a signing key first', 'warn');
+  try {
+    const { token, envelope } = await core.signDocument(key, typ, payload);
+    showIssued(typ, token, envelope);
+    toast(`${typ === 'receipt' ? 'Receipt' : 'Voucher'} signed with ${key.alg}`, 'ok');
+  } catch (err) {
+    toast(`Could not sign: ${err.message}`, 'error');
