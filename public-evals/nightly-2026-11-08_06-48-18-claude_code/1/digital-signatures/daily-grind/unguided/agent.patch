+    toast(err.message, 'error');
+  }
+}
+
+/* ------------------------------------------------------------------ */
+/* Issue panel                                                         */
+/* ------------------------------------------------------------------ */
+
+function renderActiveSigner() {
+  const k = activeKey();
+  const box = $('#sig-active-signer');
+  box.replaceChildren(
+    k
+      ? el('span', {}, 'Signing as ', el('strong', {}, k.label), ' ', algBadge(k.alg))
+      : el('span', { class: 'sig-warn-text' }, 'Generate a signing key first.'),
