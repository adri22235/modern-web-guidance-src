+}
+
+/* ------------------------------------------------------------------ */
+/* Trusted keys                                                        */
+/* ------------------------------------------------------------------ */
+
+function renderTrusted() {
+  const list = $('#sig-trusted-list');
+  list.replaceChildren();
+  if (!state.trusted.length) {
+    list.append(el('li', { class: 'sig-empty' }, 'Your own keys are trusted automatically. Import other stores\' public keys here.'));
+    return;
+  }
+  for (const k of state.trusted) {
+    list.append(el('li', { class: 'sig-key' },
+      el('div', { class: 'sig-key-head' }, el('strong', {}, k.label || 'Unnamed signer'), algBadge(k.alg)),
+      el('code', { class: 'sig-fp' }, core.formatFingerprint(k.kid)),
+      el('div', { class: 'sig-key-actions' },
