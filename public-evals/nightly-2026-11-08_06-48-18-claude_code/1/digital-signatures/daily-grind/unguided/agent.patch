+          type: 'button',
+          class: 'btn-sm danger',
+          onclick: async () => { await store.deleteTrusted(k.kid); await reload(); },
+        }, 'Remove'),
+      ),
+    ));
+  }
+}
+
+async function addTrusted(imported, label) {
