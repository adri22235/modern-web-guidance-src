+  const r = receiptFromForm();
+  $('#sig-receipt-total').textContent = `Subtotal ${money(r.subtotalCents)} · Tax ${money(r.taxCents)} · Total ${money(r.totalCents)}`;
+}
+
+function voucherFromForm() {
+  const f = $('#sig-voucher-form');
+  const issued = new Date();
+  const months = Number(f.validity.value) || 12;
+  const expires = new Date(issued);
+  expires.setMonth(expires.getMonth() + months);
+  return {
+    code: `GV-${randomCode(3)}`,
+    recipient: f.recipient.value.trim(),
+    from: f.from.value.trim(),
+    message: f.message.value.trim(),
