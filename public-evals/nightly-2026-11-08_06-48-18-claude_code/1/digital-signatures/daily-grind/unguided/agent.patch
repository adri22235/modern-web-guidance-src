+    el('div', { class: 'sig-key-actions' },
+      el('button', { type: 'button', class: 'btn-sm', onclick: () => copyText(token) }, 'Copy token'),
+      el('button', {
+        type: 'button',
+        class: 'btn-sm',
+        onclick: () => download(`daily-grind-${typ}-${docId}.json`, JSON.stringify(envelope, null, 2)),
+      }, 'Download .json'),
+      el('button', {
+        type: 'button',
+        class: 'btn-sm',
+        onclick: () => { $('#sig-verify-input').value = token; runVerify(); $('#sig-verify').scrollIntoView({ behavior: 'smooth' }); },
+      }, 'Verify it'),
+    ),
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Rendering documents (untrusted content → textContent only)          */
+/* ------------------------------------------------------------------ */
+
+function renderDocument(typ, p) {
+  if (typ === 'receipt') {
+    return el('div', { class: 'sig-doc receipt' },
+      el('div', { class: 'sig-doc-title' }, p.store),
+      el('div', { class: 'sig-doc-meta' }, `Receipt ${p.id} · ${fmtDate(p.issuedAt)}`),
+      el('table', {},
+        el('tbody', {}, p.items.map((it) => el('tr', {},
+          el('td', {}, `${it.qty} × ${it.name}`),
+          el('td', { class: 'num' }, money(it.qty * it.unitCents)),
+        ))),
+        el('tfoot', {},
+          el('tr', {}, el('td', {}, 'Subtotal'), el('td', { class: 'num' }, money(p.subtotalCents))),
+          el('tr', {}, el('td', {}, 'Tax'), el('td', { class: 'num' }, money(p.taxCents))),
+          el('tr', { class: 'total' }, el('td', {}, 'Total'), el('td', { class: 'num' }, money(p.totalCents))),
+        ),
+      ),
+    );
+  }
+  return el('div', { class: 'sig-doc voucher' },
+    el('div', { class: 'sig-doc-title' }, 'Daily Grind Gift Voucher'),
+    el('div', { class: 'sig-voucher-amount' }, money(p.amountCents)),
+    el('div', {}, 'For ', el('strong', {}, p.recipient), p.from ? [' from ', el('strong', {}, p.from)] : null),
+    p.message ? el('blockquote', {}, p.message) : null,
+    el('div', { class: 'sig-doc-meta' }, `Code ${p.code} · valid until ${fmtDate(p.expiresAt)}`),
+  );
+}
+
+/* ------------------------------------------------------------------ */
+/* Verify panel                                                        */
+/* ------------------------------------------------------------------ */
+
+async function runVerify() {
+  const input = $('#sig-verify-input').value;
+  const out = $('#sig-verify-result');
+  out.hidden = false;
+  if (!input.trim()) {
+    out.replaceChildren(el('p', {}, 'Paste a signed token or load a .json file first.'));
+    out.dataset.status = 'invalid';
+    return;
+  }
+  out.replaceChildren(el('p', {}, 'Verifying…'));
+  const r = await core.verifyDocument(input, await trustMap());
+  out.dataset.status = r.status === 'trusted' && r.warnings.length ? 'warn' : r.status;
+
+  const headline = {
+    trusted: r.warnings.length ? '⚠ Authentic, but check the warnings below' : '✔ Authentic & unmodified',
+    untrusted: '⚠ Valid signature from an UNKNOWN signer',
+    invalid: '✖ Verification failed — do not accept',
+  }[r.status];
+
+  const parts = [el('h4', {}, headline)];
+  if (r.status === 'invalid') {
+    parts.push(el('ul', {}, r.errors.map((e) => el('li', {}, e))));
+  } else {
+    parts.push(el('dl', { class: 'sig-dl' },
+      el('dt', {}, 'Signer'), el('dd', {}, r.trusted ? r.signer.label : 'Not in your trusted keys'),
+      el('dt', {}, 'Algorithm'), el('dd', {}, `${r.signer.alg} `, algBadge(r.signer.alg)),
+      el('dt', {}, 'Fingerprint'), el('dd', {}, el('code', { class: 'sig-fp' }, r.signer.fingerprint)),
+    ));
+    if (r.status === 'untrusted') {
+      parts.push(el('p', { class: 'sig-note' },
+        'The document has not been altered since it was signed, but the signing key is not one you trust. '
+        + 'Anyone can create a key pair — only trust it after comparing the fingerprint with the store through a separate channel.'));
+      const pubInfo = { alg: r.signer.alg, kid: r.signer.kid };
+      parts.push(el('button', {
+        type: 'button',
+        class: 'btn-sm',
+        onclick: async () => {
+          const label = prompt('Name this signer (only trust it if you verified the fingerprint):', '');
+          if (label === null) return;
+          await addTrusted({ ...pubInfo, publicKey: core.b64urlToBytes(r.envelope.pub) }, label.trim());
+          runVerify();
+        },
+      }, 'Trust this signer…'));
+    }
+    if (r.warnings.length) parts.push(el('ul', { class: 'sig-warnings' }, r.warnings.map((w) => el('li', {}, w))));
+    parts.push(renderDocument(r.envelope.typ, r.envelope.payload));
+  }
+  out.replaceChildren(...parts);
+}
+
+async function onVerifyFile(e) {
+  const file = e.target.files?.[0];
+  if (!file) return;
+  if (file.size > 64 * 1024) return toast('File is too large to be a Daily Grind document', 'error');
+  $('#sig-verify-input').value = await file.text();
+  e.target.value = '';
+  runVerify();
+}
+
+/* ------------------------------------------------------------------ */
+/* Init                                                                */
+/* ------------------------------------------------------------------ */
+
+async function init() {
+  const root = $('#signing');
+  if (!root) return;
+  if (!globalThis.crypto?.subtle || !globalThis.indexedDB) {
+    root.querySelector('.sig-panels').replaceChildren(
+      el('p', { class: 'sig-warn-text' }, 'Digital signing requires a modern browser served over HTTPS (Web Crypto + IndexedDB).'),
+    );
+    return;
+  }
+
+  // Algorithm picker
+  const select = $('#sig-alg');
+  state.support = await core.detectSupport();
+  for (const [id, info] of Object.entries(core.ALGORITHMS)) {
+    select.append(el('option', { value: id, disabled: !state.support[id] }, info.label + (state.support[id] ? '' : ' — unsupported in this browser')));
+  }
+  select.value = state.support['ML-DSA-65'] ? 'ML-DSA-65' : 'ECDSA-P256';
+
+  $('#sig-keygen-form').addEventListener('submit', onGenerate);
+  $('#sig-trust-form').addEventListener('submit', onImportTrusted);
+
+  // Issue tabs
+  for (const tab of document.querySelectorAll('[data-sig-tab]')) {
+    tab.addEventListener('click', () => {
+      for (const t of document.querySelectorAll('[data-sig-tab]')) t.setAttribute('aria-selected', String(t === tab));
+      $('#sig-receipt-form').hidden = tab.dataset.sigTab !== 'receipt';
+      $('#sig-voucher-form').hidden = tab.dataset.sigTab !== 'voucher';
+    });
+  }
+  buildReceiptItems();
+  $('#sig-receipt-form').addEventListener('submit', (e) => {
+    e.preventDefault();
+    const r = receiptFromForm();
+    if (!r.items.length) return toast('Add at least one item', 'warn');
+    issue('receipt', r);
+  });
+  $('#sig-voucher-form').addEventListener('submit', (e) => {
+    e.preventDefault();
+    issue('voucher', voucherFromForm());
+  });
+
+  // Verify
+  $('#sig-verify-btn').addEventListener('click', runVerify);
+  $('#sig-verify-file').addEventListener('change', onVerifyFile);
+  $('#sig-verify-clear').addEventListener('click', () => {
+    $('#sig-verify-input').value = '';
+    $('#sig-verify-result').hidden = true;
+  });
+
+  try {
+    await reload();
+  } catch (err) {
+    toast(`Could not open key storage: ${err.message}`, 'error');
+  }
+}
+
+init();
