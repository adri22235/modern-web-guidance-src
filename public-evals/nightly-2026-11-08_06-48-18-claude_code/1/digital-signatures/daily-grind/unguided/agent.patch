+}
+
+function buildReceiptItems() {
+  const wrap = $('#sig-receipt-items');
+  for (const [i, item] of MENU.entries()) {
+    wrap.append(el('label', { class: 'sig-item-row' },
+      el('span', {}, item.name),
+      el('span', { class: 'sig-price' }, money(item.unitCents)),
+      el('input', { type: 'number', min: '0', max: '99', step: '1', value: i === 0 ? '1' : '0', name: `qty-${i}`, 'aria-label': `${item.name} quantity` }),
