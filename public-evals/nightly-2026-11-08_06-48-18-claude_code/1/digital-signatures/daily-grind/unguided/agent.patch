+/**
+ * Daily Grind — signing UI and key storage (IndexedDB).
+ *
+ * Keys never leave the browser. WebCrypto private keys (ECDSA / Ed25519) are
+ * stored as non-extractable CryptoKey objects; ML-DSA secret keys are stored
+ * as raw bytes (no WebCrypto support yet), scoped to this origin's IndexedDB.
+ *
+ * All untrusted document content is rendered with textContent only.
+ */
+import * as core from './signing-core.js';
+
+/* ------------------------------------------------------------------ */
+/* Storage                                                             */
+/* ------------------------------------------------------------------ */
+
+const DB_NAME = 'daily-grind-signing';
+const DB_VERSION = 1;
+const ACTIVE_KEY_PREF = 'dg-active-signing-kid';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, DB_VERSION);
+    req.onupgradeneeded = () => {
+      const db = req.result;
+      if (!db.objectStoreNames.contains('keys')) db.createObjectStore('keys', { keyPath: 'kid' });
+      if (!db.objectStoreNames.contains('trusted')) db.createObjectStore('trusted', { keyPath: 'kid' });
+    };
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+let dbPromise;
+const db = () => (dbPromise ??= openDb());
+
+async function tx(store, mode, fn) {
+  const d = await db();
+  return new Promise((resolve, reject) => {
+    const t = d.transaction(store, mode);
+    const req = fn(t.objectStore(store));
+    t.oncomplete = () => resolve(req?.result);
+    t.onerror = () => reject(t.error);
+    t.onabort = () => reject(t.error);
+  });
+}
+
+const store = {
+  allKeys: () => tx('keys', 'readonly', (s) => s.getAll()),
+  putKey: (k) => tx('keys', 'readwrite', (s) => s.put(k)),
+  deleteKey: (kid) => tx('keys', 'readwrite', (s) => s.delete(kid)),
+  allTrusted: () => tx('trusted', 'readonly', (s) => s.getAll()),
+  putTrusted: (k) => tx('trusted', 'readwrite', (s) => s.put(k)),
+  deleteTrusted: (kid) => tx('trusted', 'readwrite', (s) => s.delete(kid)),
+};
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+const $ = (sel, root = document) => root.querySelector(sel);
+
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (k === 'class') node.className = v;
+    else if (k === 'dataset') Object.assign(node.dataset, v);
+    else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
+    else if (v !== undefined && v !== null && v !== false) node.setAttribute(k, v === true ? '' : v);
+  }
+  for (const c of children.flat()) {
+    if (c !== null && c !== undefined && c !== false) node.append(c instanceof Node ? c : String(c));
+  }
+  return node;
+}
+
+const money = (cents) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const fmtDate = (iso) => new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+function randomCode(groups, len = 4) {
+  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no 0/O/1/I
+  const out = [];
+  for (let g = 0; g < groups; g++) {
+    const bytes = crypto.getRandomValues(new Uint8Array(len));
+    out.push(Array.from(bytes, (b) => alphabet[b % alphabet.length]).join(''));
+  }
+  return out.join('-');
+}
+
+function toast(msg, kind = 'info') {
+  const t = $('#sig-toast');
+  t.textContent = msg;
+  t.dataset.kind = kind;
+  t.hidden = false;
+  clearTimeout(toast.timer);
+  toast.timer = setTimeout(() => { t.hidden = true; }, 3500);
+}
+
+async function copyText(text) {
+  try {
+    await navigator.clipboard.writeText(text);
+    toast('Copied to clipboard', 'ok');
+  } catch {
+    toast('Copy failed — select the text and copy manually', 'warn');
+  }
+}
+
+function download(filename, text) {
+  const url = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
+  const a = el('a', { href: url, download: filename });
+  document.body.append(a);
+  a.click();
+  a.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+/* ------------------------------------------------------------------ */
+/* State                                                               */
+/* ------------------------------------------------------------------ */
+
+const MENU = [
+  { name: 'Maple Oat Latte', unitCents: 575 },
+  { name: 'Dark Roast Espresso', unitCents: 350 },
+  { name: 'Cold Brew', unitCents: 495 },
+  { name: 'Cappuccino', unitCents: 450 },
+  { name: 'Almond Croissant', unitCents: 395 },
+  { name: 'Blueberry Muffin', unitCents: 325 },
+];
+const TAX_RATE = 0.08;
+const STORE_NAME = 'The Daily Grind — Main Street';
+
+const state = {
+  keys: [],
+  trusted: [],
+  activeKid: localStorage.getItem(ACTIVE_KEY_PREF),
+  support: {},
+};
+
+async function trustMap() {
+  const m = new Map();
+  for (const k of state.keys) m.set(k.kid, { alg: k.alg, label: `${k.label} (this device)` });
+  for (const k of state.trusted) m.set(k.kid, { alg: k.alg, label: k.label });
+  return m;
+}
+
+function activeKey() {
+  return state.keys.find((k) => k.kid === state.activeKid) || null;
+}
+
+async function reload() {
+  [state.keys, state.trusted] = await Promise.all([store.allKeys(), store.allTrusted()]);
+  state.keys.sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+  if (!activeKey() && state.keys.length) setActive(state.keys[state.keys.length - 1].kid);
+  renderKeys();
+  renderTrusted();
+  renderActiveSigner();
+}
+
+function setActive(kid) {
+  state.activeKid = kid;
+  if (kid) localStorage.setItem(ACTIVE_KEY_PREF, kid);
+  else localStorage.removeItem(ACTIVE_KEY_PREF);
+}
+
+/* ------------------------------------------------------------------ */
+/* Keys panel                                                          */
+/* ------------------------------------------------------------------ */
+
+function algBadge(alg) {
+  const info = core.ALGORITHMS[alg];
+  return el('span', { class: `sig-badge ${info?.postQuantum ? 'pq' : 'classic'}` }, info?.postQuantum ? 'Quantum-resistant' : 'Classical');
+}
+
+function renderKeys() {
+  const list = $('#sig-key-list');
+  list.replaceChildren();
+  if (!state.keys.length) {
+    list.append(el('li', { class: 'sig-empty' }, 'No signing keys yet. Generate one to start issuing signed documents.'));
+    return;
+  }
+  for (const k of state.keys) {
+    const active = k.kid === state.activeKid;
+    list.append(el('li', { class: `sig-key ${active ? 'active' : ''}` },
+      el('div', { class: 'sig-key-head' },
+        el('strong', {}, k.label),
+        algBadge(k.alg),
+        active ? el('span', { class: 'sig-badge active' }, 'Active') : null,
+      ),
+      el('div', { class: 'sig-key-meta' }, `${k.alg} · created ${fmtDate(k.createdAt)}`),
+      el('code', { class: 'sig-fp', title: 'Key fingerprint' }, core.formatFingerprint(k.kid)),
+      el('div', { class: 'sig-key-actions' },
+        active ? null : el('button', { type: 'button', class: 'btn-sm', onclick: () => { setActive(k.kid); reload(); } }, 'Use for signing'),
+        el('button', { type: 'button', class: 'btn-sm', onclick: () => copyText(core.exportPublicKey(k)) }, 'Copy public key'),
+        el('button', {
+          type: 'button',
+          class: 'btn-sm danger',
+          onclick: async () => {
+            if (!confirm(`Delete signing key "${k.label}"? Documents it signed will no longer be trusted on this device.`)) return;
+            await store.deleteKey(k.kid);
+            if (active) setActive(null);
+            await reload();
+            toast('Key deleted');
+          },
+        }, 'Delete'),
+      ),
+    ));
+  }
+}
+
+async function onGenerate(e) {
+  e.preventDefault();
+  const form = e.currentTarget;
+  const alg = form.alg.value;
+  const label = form.label.value.trim() || `${alg} key`;
+  const btn = form.querySelector('button[type=submit]');
+  btn.disabled = true;
+  btn.textContent = 'Generating…';
+  try {
+    const kp = await core.generateKeyPair(alg);
+    await store.putKey({
+      kid: kp.kid,
+      alg,
+      label: label.slice(0, 60),
+      createdAt: new Date().toISOString(),
+      publicKey: kp.publicKey,
+      privateKey: kp.privateKey,
+    });
+    setActive(kp.kid);
+    form.label.value = '';
+    await reload();
