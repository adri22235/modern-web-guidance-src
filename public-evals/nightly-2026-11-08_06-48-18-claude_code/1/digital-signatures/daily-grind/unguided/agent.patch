index 0000000..e614110
--- /dev/null
+++ b/js/signing-core.js
@@ -0,0 +1,438 @@
+/**
+ * Daily Grind — signed document core.
+ *
+ * Pure crypto + envelope logic (no DOM, no storage) so it can be unit tested
+ * in Node as well as used in the browser.
+ *
+ * Supported signature algorithms:
+ *   - ECDSA-P256  (WebCrypto, classical, widely supported)
+ *   - Ed25519     (WebCrypto, classical, modern browsers)
+ *   - ML-DSA-65   (FIPS 204, post-quantum, via vendored @noble/post-quantum)
+ *
+ * Token format:  "DG1." + base64url(UTF-8 JSON envelope)
+ * Envelope:      { v, typ, alg, kid, pub, payload, sig }
+ * Signed bytes:  UTF-8( DOMAIN + "\n" + canonicalJSON({ v, typ, alg, kid, payload }) )
+ *
+ * The algorithm, key id and document type are all covered by the signature,
+ * preventing algorithm-substitution and receipt/voucher type-confusion attacks.
+ */
+
+export const TOKEN_PREFIX = 'DG1.';
+export const PUBKEY_PREFIX = 'DGPK1.';
+export const DOMAIN = 'daily-grind/signed-document/v1';
+export const ENVELOPE_VERSION = 1;
+export const DOC_TYPES = Object.freeze(['receipt', 'voucher']);
+const MAX_TOKEN_LENGTH = 64 * 1024;
+
+const subtle = globalThis.crypto.subtle;
+const enc = new TextEncoder();
+const dec = new TextDecoder('utf-8', { fatal: true });
+
+/* ------------------------------------------------------------------ */
+/* Encoding helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+export function bytesToB64url(bytes) {
+  let bin = '';
+  const chunk = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunk) {
+    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function b64urlToBytes(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new Error('Invalid base64url data');
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((str.length + 3) % 4);
+  const bin = atob(b64);
+  const out = new Uint8Array(bin.length);
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+  return out;
+}
+
+/**
+ * Deterministic JSON serialisation: object keys sorted lexicographically,
+ * no whitespace. Only plain JSON values are allowed.
+ */
+export function canonicalize(value) {
+  if (value === null || typeof value === 'boolean' || typeof value === 'string') {
+    return JSON.stringify(value);
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) throw new Error('Non-finite numbers cannot be signed');
+    return JSON.stringify(value);
+  }
+  if (Array.isArray(value)) {
+    return '[' + value.map(canonicalize).join(',') + ']';
+  }
+  if (typeof value === 'object') {
+    const proto = Object.getPrototypeOf(value);
+    if (proto !== Object.prototype && proto !== null) {
+      throw new Error('Only plain objects can be signed');
+    }
+    const keys = Object.keys(value).sort();
+    return '{' + keys.map((k) => {
+      if (value[k] === undefined) throw new Error(`Field "${k}" is undefined`);
+      return JSON.stringify(k) + ':' + canonicalize(value[k]);
+    }).join(',') + '}';
+  }
+  throw new Error(`Unsupported value type: ${typeof value}`);
+}
+
+/* ------------------------------------------------------------------ */
+/* Algorithms                                                          */
+/* ------------------------------------------------------------------ */
+
+let mlDsaModule = null;
+async function loadMlDsa() {
+  if (!mlDsaModule) {
+    mlDsaModule = import(new URL('../vendor/noble-ml-dsa-0.7.1.mjs', import.meta.url).href)
+      .then((m) => m.ml_dsa65)
+      .catch((err) => { mlDsaModule = null; throw err; });
+  }
+  return mlDsaModule;
+}
+
+const ML_DSA_CONTEXT = enc.encode(DOMAIN);
+
+const ALGS = {
+  'ECDSA-P256': {
+    label: 'ECDSA P-256 (classical)',
+    postQuantum: false,
+    async generate() {
+      const kp = await subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, false, ['sign', 'verify']);
+      const pub = new Uint8Array(await subtle.exportKey('spki', kp.publicKey));
+      return { publicKey: pub, privateKey: kp.privateKey };
+    },
+    async sign(privateKey, msg) {
+      return new Uint8Array(await subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, privateKey, msg));
+    },
+    async verify(pub, sig, msg) {
+      const key = await subtle.importKey('spki', pub, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+      return subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, sig, msg);
+    },
+    sigLength: 64,
+  },
+  Ed25519: {
+    label: 'Ed25519 (classical)',
+    postQuantum: false,
+    async generate() {
+      const kp = await subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']);
+      const pub = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+      return { publicKey: pub, privateKey: kp.privateKey };
+    },
+    async sign(privateKey, msg) {
+      return new Uint8Array(await subtle.sign({ name: 'Ed25519' }, privateKey, msg));
+    },
+    async verify(pub, sig, msg) {
+      if (pub.length !== 32) return false;
+      const key = await subtle.importKey('raw', pub, { name: 'Ed25519' }, false, ['verify']);
+      return subtle.verify({ name: 'Ed25519' }, key, sig, msg);
+    },
+    sigLength: 64,
+  },
+  'ML-DSA-65': {
+    label: 'ML-DSA-65 (post-quantum, FIPS 204)',
+    postQuantum: true,
+    async generate() {
+      const ml = await loadMlDsa();
+      const seed = globalThis.crypto.getRandomValues(new Uint8Array(32));
+      const { publicKey, secretKey } = ml.keygen(seed);
+      seed.fill(0);
+      return { publicKey, privateKey: secretKey };
+    },
+    async sign(secretKey, msg) {
+      const ml = await loadMlDsa();
+      return ml.sign(msg, secretKey, { context: ML_DSA_CONTEXT });
+    },
+    async verify(pub, sig, msg) {
+      const ml = await loadMlDsa();
+      if (pub.length !== ml.lengths.publicKey) return false;
+      return ml.verify(sig, msg, pub, { context: ML_DSA_CONTEXT });
+    },
+    sigLength: 3309,
+  },
+};
+
+export const ALGORITHMS = Object.freeze(
+  Object.fromEntries(Object.entries(ALGS).map(([id, a]) => [id, Object.freeze({ id, label: a.label, postQuantum: a.postQuantum })])),
+);
+
+function getAlg(alg) {
+  if (!Object.prototype.hasOwnProperty.call(ALGS, alg)) throw new Error(`Unsupported algorithm: ${alg}`);
+  return ALGS[alg];
+}
+
+/** Detect which algorithms work in the current runtime. */
+export async function detectSupport() {
+  const result = {};
+  for (const id of Object.keys(ALGS)) {
+    try {
+      if (id === 'ML-DSA-65') await loadMlDsa();
+      else if (id === 'Ed25519') await subtle.generateKey({ name: 'Ed25519' }, false, ['sign']);
+      result[id] = true;
+    } catch {
+      result[id] = false;
+    }
+  }
+  return result;
+}
+
+/* ------------------------------------------------------------------ */
+/* Keys                                                                */
+/* ------------------------------------------------------------------ */
+
+/** Key id: base64url of first 16 bytes of SHA-256(alg || 0x00 || publicKey). */
+export async function keyId(alg, publicKey) {
+  const algBytes = enc.encode(alg);
+  const data = new Uint8Array(algBytes.length + 1 + publicKey.length);
+  data.set(algBytes, 0);
+  data.set(publicKey, algBytes.length + 1);
+  const digest = new Uint8Array(await subtle.digest('SHA-256', data));
+  return bytesToB64url(digest.subarray(0, 16));
+}
+
+/** Human-friendly fingerprint for out-of-band comparison, e.g. "A1B2-C3D4-...". */
+export function formatFingerprint(kid) {
+  const hex = Array.from(b64urlToBytes(kid), (b) => b.toString(16).padStart(2, '0')).join('').toUpperCase();
+  return hex.match(/.{1,4}/g).join('-');
+}
+
+/**
+ * Generate a signing key pair. WebCrypto private keys are non-extractable.
+ * Returns { alg, kid, publicKey: Uint8Array, privateKey: CryptoKey|Uint8Array }.
+ */
+export async function generateKeyPair(alg) {
+  const { publicKey, privateKey } = await getAlg(alg).generate();
+  return { alg, kid: await keyId(alg, publicKey), publicKey, privateKey };
+}
+
+export function exportPublicKey({ alg, publicKey, label }) {
+  const body = { v: 1, alg, pub: bytesToB64url(publicKey) };
+  if (label) body.label = String(label).slice(0, 80);
+  return PUBKEY_PREFIX + bytesToB64url(enc.encode(canonicalize(body)));
+}
+
+export async function importPublicKey(str) {
+  str = String(str).trim();
+  if (!str.startsWith(PUBKEY_PREFIX) || str.length > MAX_TOKEN_LENGTH) throw new Error('Not a Daily Grind public key');
+  let body;
+  try {
+    body = JSON.parse(dec.decode(b64urlToBytes(str.slice(PUBKEY_PREFIX.length))));
+  } catch {
+    throw new Error('Public key is malformed');
+  }
+  if (!body || body.v !== 1 || typeof body.pub !== 'string') throw new Error('Public key is malformed');
+  getAlg(body.alg);
+  const publicKey = b64urlToBytes(body.pub);
+  return {
+    alg: body.alg,
+    publicKey,
+    kid: await keyId(body.alg, publicKey),
+    label: typeof body.label === 'string' ? body.label.slice(0, 80) : '',
+  };
+}
+
+/* ------------------------------------------------------------------ */
+/* Payload validation                                                  */
+/* ------------------------------------------------------------------ */
+
+const isInt = (n, min = 0, max = 1e9) => Number.isSafeInteger(n) && n >= min && n <= max;
+const isStr = (s, max = 200, min = 0) => typeof s === 'string' && s.length >= min && s.length <= max;
+const isIsoDate = (s) => typeof s === 'string' && s.length <= 40 && !Number.isNaN(Date.parse(s));
+
+/** Returns a list of structural problems with the payload (empty = OK). */
+export function validatePayload(typ, p) {
+  const errs = [];
+  if (!p || typeof p !== 'object' || Array.isArray(p)) return ['Payload must be an object'];
+  if (!isIsoDate(p.issuedAt)) errs.push('issuedAt must be an ISO date');
+  if (p.currency !== 'USD') errs.push('currency must be USD');
+  if (typ === 'receipt') {
+    if (!isStr(p.id, 40, 1)) errs.push('Receipt id missing');
+    if (!isStr(p.store, 100, 1)) errs.push('Store missing');
+    if (!Array.isArray(p.items) || p.items.length === 0 || p.items.length > 50) {
+      errs.push('Receipt must contain 1–50 items');
+    } else {
+      p.items.forEach((it, i) => {
+        if (!it || !isStr(it.name, 100, 1) || !isInt(it.qty, 1, 99) || !isInt(it.unitCents, 0, 100000)) {
+          errs.push(`Item #${i + 1} is malformed`);
+        }
+      });
+    }
+    for (const f of ['subtotalCents', 'taxCents', 'totalCents']) {
+      if (!isInt(p[f], 0, 1e8)) errs.push(`${f} must be a non-negative integer`);
+    }
+  } else if (typ === 'voucher') {
+    if (!isStr(p.code, 40, 1)) errs.push('Voucher code missing');
+    if (!isStr(p.recipient, 100, 1)) errs.push('Recipient missing');
+    if (!isStr(p.from, 100)) errs.push('From is malformed');
+    if (!isStr(p.message, 500)) errs.push('Message is malformed');
+    if (!isInt(p.amountCents, 100, 50000)) errs.push('Voucher amount must be between $1 and $500');
+    if (!isIsoDate(p.expiresAt)) errs.push('expiresAt must be an ISO date');
+  } else {
+    errs.push(`Unknown document type: ${typ}`);
+  }
+  return errs;
+}
+
+/** Business-rule checks run after the signature is verified. */
+export function businessChecks(typ, p, now = new Date()) {
+  const warnings = [];
+  if (typ === 'receipt') {
+    const sum = p.items.reduce((acc, it) => acc + it.qty * it.unitCents, 0);
+    if (sum !== p.subtotalCents) warnings.push('Line items do not add up to the subtotal');
+    if (p.subtotalCents + p.taxCents !== p.totalCents) warnings.push('Subtotal plus tax does not equal total');
+  } else if (typ === 'voucher') {
+    if (Date.parse(p.expiresAt) < now.getTime()) warnings.push('Voucher has expired');
+    if (Date.parse(p.expiresAt) <= Date.parse(p.issuedAt)) warnings.push('Voucher expires before it was issued');
+  }
+  if (Date.parse(p.issuedAt) > now.getTime() + 5 * 60 * 1000) warnings.push('Issue date is in the future');
+  return warnings;
+}
+
+/* ------------------------------------------------------------------ */
+/* Sign / verify                                                       */
+/* ------------------------------------------------------------------ */
+
+function signingInput({ typ, alg, kid, payload }) {
+  return enc.encode(DOMAIN + '\n' + canonicalize({ v: ENVELOPE_VERSION, typ, alg, kid, payload }));
+}
+
+/**
+ * Sign a document. `key` is { alg, kid, publicKey, privateKey }.
+ * Returns { envelope, token }.
+ */
+export async function signDocument(key, typ, payload) {
+  if (!DOC_TYPES.includes(typ)) throw new Error(`Unknown document type: ${typ}`);
+  const errs = validatePayload(typ, payload);
+  if (errs.length) throw new Error(errs.join('; '));
+  // Normalise payload through canonical JSON so what we sign is exactly what we emit.
+  const normalized = JSON.parse(canonicalize(payload));
+  const header = { typ, alg: key.alg, kid: key.kid, payload: normalized };
+  const sig = await getAlg(key.alg).sign(key.privateKey, signingInput(header));
+  const envelope = {
+    v: ENVELOPE_VERSION,
+    ...header,
+    pub: bytesToB64url(key.publicKey),
+    sig: bytesToB64url(sig),
+  };
+  return { envelope, token: encodeToken(envelope) };
+}
+
+export function encodeToken(envelope) {
+  return TOKEN_PREFIX + bytesToB64url(enc.encode(canonicalize(envelope)));
+}
+
+/** Accepts either a "DG1." token or the raw JSON envelope. */
+export function decodeToken(input) {
+  const str = String(input).trim();
+  if (str.length > MAX_TOKEN_LENGTH) throw new Error('Token is too large');
+  let json;
+  if (str.startsWith(TOKEN_PREFIX)) {
+    try {
+      json = dec.decode(b64urlToBytes(str.slice(TOKEN_PREFIX.length).replace(/\s+/g, '')));
+    } catch {
+      throw new Error('Token is not valid base64url / UTF-8');
+    }
+  } else if (str.startsWith('{')) {
+    json = str;
+  } else {
+    throw new Error(`Expected a token starting with "${TOKEN_PREFIX}" or a JSON envelope`);
+  }
+  let env;
+  try {
+    env = JSON.parse(json);
+  } catch {
+    throw new Error('Token does not contain valid JSON');
+  }
+  if (!env || typeof env !== 'object' || Array.isArray(env)) throw new Error('Envelope must be an object');
+  return env;
+}
+
+/**
+ * Verify an envelope or token.
+ *
+ * @param {object|string} input  envelope or token
+ * @param {Map<string, {alg:string, label?:string}>} trustedKeys  kid -> info
+ * @returns {Promise<{
+ *   status: 'trusted'|'untrusted'|'invalid',
+ *   signatureValid: boolean, trusted: boolean,
+ *   errors: string[], warnings: string[],
+ *   envelope?: object, signer?: object
+ * }>}
+ */
+export async function verifyDocument(input, trustedKeys = new Map(), now = new Date()) {
+  const result = { status: 'invalid', signatureValid: false, trusted: false, errors: [], warnings: [] };
+  let env;
+  try {
+    env = typeof input === 'string' ? decodeToken(input) : input;
+  } catch (e) {
+    result.errors.push(e.message);
+    return result;
+  }
+  result.envelope = env;
+
+  if (env.v !== ENVELOPE_VERSION) result.errors.push('Unsupported envelope version');
+  if (!DOC_TYPES.includes(env.typ)) result.errors.push('Unknown document type');
+  if (!Object.prototype.hasOwnProperty.call(ALGS, env.alg)) result.errors.push('Unsupported signature algorithm');
+  if (typeof env.kid !== 'string' || typeof env.pub !== 'string' || typeof env.sig !== 'string') {
+    result.errors.push('Envelope is missing kid, pub or sig');
+  }
+  if (result.errors.length) return result;
+
+  const payloadErrors = validatePayload(env.typ, env.payload);
+  if (payloadErrors.length) {
+    result.errors.push(...payloadErrors);
+    return result;
+  }
+
+  let pub;
+  let sig;
+  try {
+    pub = b64urlToBytes(env.pub);
+    sig = b64urlToBytes(env.sig);
+  } catch {
+    result.errors.push('Public key or signature is not valid base64url');
+    return result;
+  }
+
+  const expectedKid = await keyId(env.alg, pub);
+  if (expectedKid !== env.kid) {
+    result.errors.push('Key id does not match the embedded public key');
+    return result;
+  }
+
+  const alg = getAlg(env.alg);
+  if (sig.length !== alg.sigLength) {
+    result.errors.push('Signature has the wrong length');
+    return result;
+  }
+
+  let ok = false;
+  try {
+    ok = await alg.verify(pub, sig, signingInput(env));
+  } catch (e) {
+    result.errors.push(`Verification error: ${e.message}`);
+    return result;
+  }
+  if (!ok) {
+    result.errors.push('Signature does not match — the document was altered or signed by a different key');
+    return result;
+  }
+
+  result.signatureValid = true;
+  const trustedInfo = trustedKeys.get(env.kid);
+  result.trusted = Boolean(trustedInfo && trustedInfo.alg === env.alg);
+  result.signer = {
+    kid: env.kid,
+    alg: env.alg,
+    fingerprint: formatFingerprint(env.kid),
+    label: result.trusted ? trustedInfo.label || '' : '',
+    postQuantum: ALGS[env.alg].postQuantum,
+  };
+  result.warnings = businessChecks(env.typ, env.payload, now);
+  result.status = result.trusted ? 'trusted' : 'untrusted';
+  return result;
+}
