--- /dev/null
+++ b/signing.js
@@ -0,0 +1,602 @@
+// The Daily Grind — digital signing & verification for receipts and gift vouchers.
+//
+// Uses WebCrypto asymmetric signatures:
+//   1. ML-DSA-65 (post-quantum, FIPS 204) when the browser supports it
+//   2. Ed25519 as the classical fallback
+//   3. ECDSA P-256 / SHA-256 for browsers without Ed25519
+//
+// Every signature is bound to a document type via a domain-separation context
+// ("daily-grind/receipt/v1" or "daily-grind/voucher/v1") so a receipt signature
+// can never be replayed as a gift voucher (and vice versa).
+
+const enc = new TextEncoder();
+const dec = new TextDecoder();
+
+const ENVELOPE_VERSION = 1;
+const CONTEXTS = {
+  receipt: enc.encode('daily-grind/receipt/v1'),
+  voucher: enc.encode('daily-grind/voucher/v1'),
+};
+const ECDSA_PARAMS = { name: 'ECDSA', namedCurve: 'P-256' };
+const ECDSA_SIGN = { name: 'ECDSA', hash: 'SHA-256' };
+const ML_DSA_KEY_SIZES = { 'ML-DSA-44': 1312, 'ML-DSA-65': 1952, 'ML-DSA-87': 2592 };
+const SUPPORTED_SUITES = ['ML-DSA-65', 'ML-DSA-44', 'ML-DSA-87', 'Ed25519', 'ECDSA-P256'];
+
+const MENU = {
+  'maple-oat-latte': { name: 'Maple Oat Latte', price: 5.75 },
+  'dark-roast-espresso': { name: 'Dark Roast Espresso', price: 3.5 },
+  'cold-brew': { name: 'Cold Brew', price: 4.25 },
+  'butter-croissant': { name: 'Butter Croissant', price: 3.95 },
+};
+
+// ---------------------------------------------------------------------------
+// Encoding helpers (native base64 where available, with a small fallback)
+// ---------------------------------------------------------------------------
+
+function toBase64Url(bytes) {
+  if (typeof bytes.toBase64 === 'function') {
+    return bytes.toBase64({ alphabet: 'base64url', omitPadding: true });
+  }
+  let bin = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) {
+    bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
+  }
+  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function fromBase64Url(str) {
+  if (typeof str !== 'string' || !/^[A-Za-z0-9_-]*$/.test(str)) {
+    throw new TypeError('Malformed base64url data');
+  }
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(str, { alphabet: 'base64url' });
+  }
+  const b64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  const bin = atob(b64 + '='.repeat((4 - (b64.length % 4)) % 4));
+  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
+}
+
+function toHex(bytes) {
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+// Classical algorithms ignore `context`, so frame it into the signed bytes
+// (1-byte length prefix + context + payload) for equivalent domain separation.
+function frameWithContext(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+// ---------------------------------------------------------------------------
+// Suite detection & key management
+// ---------------------------------------------------------------------------
+
+function supportsPostQuantumSignatures() {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', 'ML-DSA-65') &&
+    SubtleCrypto.supports('verify', 'ML-DSA-65')
+  );
+}
+
+async function generateKeyPair() {
+  if (supportsPostQuantumSignatures()) {
+    const keyPair = await crypto.subtle.generateKey('ML-DSA-65', false, ['sign', 'verify']);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return { suite: 'ML-DSA-65', keyPair, publicKeyBytes };
+  }
+  try {
+    const keyPair = await crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']);
+    const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+    return { suite: 'Ed25519', keyPair, publicKeyBytes };
+  } catch {
+    const keyPair = await crypto.subtle.generateKey(ECDSA_PARAMS, false, ['sign', 'verify']);
+    const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+    return { suite: 'ECDSA-P256', keyPair, publicKeyBytes };
+  }
+}
+
+async function fingerprint(suite, publicKeyBytes) {
+  // Bind the algorithm into the fingerprint so the same bytes can't be
+  // reinterpreted under a different suite.
+  const data = new Uint8Array([...enc.encode(suite), 0, ...publicKeyBytes]);
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', data));
+  return toHex(digest.subarray(0, 16)).match(/.{4}/g).join(':');
+}
+
+// Non-extractable CryptoKeys are structured-cloneable, so IndexedDB can
+// persist the signing key without ever exposing the private key bytes.
+const DB_NAME = 'daily-grind-signing';
+const STORE = 'keys';
+
+function openDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(DB_NAME, 1);
+    req.onupgradeneeded = () => req.result.createObjectStore(STORE);
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+async function dbOp(mode, fn) {
+  const db = await openDb();
+  try {
+    return await new Promise((resolve, reject) => {
+      const tx = db.transaction(STORE, mode);
+      const req = fn(tx.objectStore(STORE));
+      tx.oncomplete = () => resolve(req?.result);
+      tx.onerror = () => reject(tx.error);
+      tx.onabort = () => reject(tx.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+const dbGet = (key) => dbOp('readonly', (s) => s.get(key));
+const dbPut = (key, value) => dbOp('readwrite', (s) => s.put(value, key));
+
+async function loadOrCreateIssuer({ rotate = false } = {}) {
+  let issuer = null;
+  if (!rotate) {
+    try {
+      issuer = await dbGet('issuer');
+    } catch {
+      issuer = null;
+    }
+  }
+  if (!issuer) {
+    issuer = await generateKeyPair();
+    issuer.createdAt = new Date().toISOString();
+    try {
+      await dbPut('issuer', issuer);
+    } catch {
+      // Private browsing / storage disabled: keep the key for this session only.
+    }
+  }
+  issuer.fingerprint = await fingerprint(issuer.suite, issuer.publicKeyBytes);
+  await trustKey(issuer.suite, issuer.publicKeyBytes, issuer.fingerprint);
+  return issuer;
+}
+
+// In-memory mirror so trust still works when IndexedDB is unavailable.
+const sessionTrusted = {};
+
+async function getTrustedKeys() {
+  let stored = {};
+  try {
+    stored = (await dbGet('trusted')) ?? {};
+  } catch {
+    /* storage unavailable */
+  }
+  return { ...stored, ...sessionTrusted };
+}
+
+async function trustKey(suite, publicKeyBytes, fp) {
+  const trusted = await getTrustedKeys();
+  if (!trusted[fp]) {
+    sessionTrusted[fp] = trusted[fp] = { suite, publicKey: toBase64Url(publicKeyBytes), addedAt: new Date().toISOString() };
+    try {
+      await dbPut('trusted', trusted);
+    } catch {
+      /* ignore */
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Sign & verify
+// ---------------------------------------------------------------------------
+
+async function signBytes(suite, privateKey, payloadBytes, contextBytes) {
+  let sig;
+  if (suite.startsWith('ML-DSA')) {
+    sig = await crypto.subtle.sign({ name: suite, context: contextBytes }, privateKey, payloadBytes);
+  } else if (suite === 'Ed25519') {
+    sig = await crypto.subtle.sign('Ed25519', privateKey, frameWithContext(payloadBytes, contextBytes));
+  } else {
+    sig = await crypto.subtle.sign(ECDSA_SIGN, privateKey, frameWithContext(payloadBytes, contextBytes));
+  }
+  return new Uint8Array(sig);
+}
+
+async function importPublicKey(suite, bytes) {
+  if (suite.startsWith('ML-DSA')) {
+    if (bytes.byteLength !== ML_DSA_KEY_SIZES[suite]) throw new Error('Public key has wrong length');
+    return crypto.subtle.importKey('raw-public', bytes, suite, true, ['verify']);
+  }
+  if (suite === 'Ed25519') {
+    return crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+  }
+  return crypto.subtle.importKey('raw', bytes, ECDSA_PARAMS, true, ['verify']);
+}
+
+async function verifyBytes(suite, publicKey, signatureBytes, payloadBytes, contextBytes) {
+  if (suite.startsWith('ML-DSA')) {
+    return crypto.subtle.verify({ name: suite, context: contextBytes }, publicKey, signatureBytes, payloadBytes);
+  }
+  const framed = frameWithContext(payloadBytes, contextBytes);
+  if (suite === 'Ed25519') {
+    return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+  }
+  return crypto.subtle.verify(ECDSA_SIGN, publicKey, signatureBytes, framed);
+}
+
+/**
+ * Sign a document. The payload is serialized once and the exact signed bytes
+ * are carried (base64url) in the envelope, so no JSON canonicalization is needed.
+ */
+async function signDocument(issuer, type, document) {
+  const payloadBytes = enc.encode(JSON.stringify({ type, ...document }));
+  const signature = await signBytes(issuer.suite, issuer.keyPair.privateKey, payloadBytes, CONTEXTS[type]);
+  return {
+    v: ENVELOPE_VERSION,
+    type,
+    alg: issuer.suite,
+    publicKey: toBase64Url(issuer.publicKeyBytes),
+    payload: toBase64Url(payloadBytes),
+    signature: toBase64Url(signature),
+  };
+}
+
+/**
+ * Verify an envelope. Returns { status, ... } where status is one of:
+ *   'valid'     – signature valid, signer trusted, document checks pass
+ *   'untrusted' – signature is mathematically valid but signer is unknown
+ *   'expired'   – valid voucher past its expiry date
+ *   'invalid'   – tampered, malformed, or wrong document type
+ */
+async function verifyDocument(envelopeText) {
+  let env;
+  try {
+    env = JSON.parse(envelopeText);
+  } catch {
+    return { status: 'invalid', reason: 'This is not a valid signed document (could not parse JSON).' };
+  }
+  if (!env || typeof env !== 'object' || env.v !== ENVELOPE_VERSION) {
+    return { status: 'invalid', reason: 'Unsupported or missing envelope version.' };
+  }
+  if (!Object.hasOwn(CONTEXTS, env.type)) {
+    return { status: 'invalid', reason: 'Unknown document type.' };
+  }
+  if (!SUPPORTED_SUITES.includes(env.alg)) {
+    return { status: 'invalid', reason: `Unsupported signature algorithm "${String(env.alg)}".` };
+  }
+
+  let publicKeyBytes, payloadBytes, signatureBytes, publicKey;
+  try {
+    publicKeyBytes = fromBase64Url(env.publicKey);
+    payloadBytes = fromBase64Url(env.payload);
+    signatureBytes = fromBase64Url(env.signature);
+  } catch {
+    return { status: 'invalid', reason: 'Envelope fields are not valid base64url.' };
+  }
+  try {
+    publicKey = await importPublicKey(env.alg, publicKeyBytes);
+  } catch (err) {
+    const unsupported = err?.name === 'NotSupportedError';
+    return {
+      status: 'invalid',
+      reason: unsupported
+        ? `This browser cannot verify ${env.alg} signatures.`
+        : 'The embedded public key is malformed.',
+    };
+  }
+
+  let ok = false;
+  try {
+    ok = await verifyBytes(env.alg, publicKey, signatureBytes, payloadBytes, CONTEXTS[env.type]);
+  } catch {
+    ok = false;
+  }
+  if (!ok) {
+    return {
+      status: 'invalid',
+      alg: env.alg,
+      reason: 'Signature check failed — the document was altered or was not signed for this document type.',
+    };
+  }
+
+  let doc;
+  try {
+    doc = JSON.parse(dec.decode(payloadBytes));
+  } catch {
+    return { status: 'invalid', reason: 'Signed payload is not valid JSON.' };
+  }
+  if (doc?.type !== env.type) {
+    return { status: 'invalid', reason: 'Signed document type does not match envelope type.' };
+  }
+
+  const fp = await fingerprint(env.alg, publicKeyBytes);
+  const trusted = await getTrustedKeys();
+  const result = { alg: env.alg, fingerprint: fp, doc, type: env.type };
+
+  if (!trusted[fp]) {
+    return {
+      ...result,
+      status: 'untrusted',
+      reason: 'The signature is intact, but it was made by a key that is not a trusted Daily Grind issuing key.',
+    };
+  }
+  if (env.type === 'voucher' && doc.expiresAt && Date.parse(doc.expiresAt) < Date.now()) {
+    return { ...result, status: 'expired', reason: 'Authentic voucher, but it has expired.' };
+  }
+  return { ...result, status: 'valid' };
+}
+
+// ---------------------------------------------------------------------------
+// UI
+// ---------------------------------------------------------------------------
+
+const $ = (sel) => document.querySelector(sel);
+const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+const dateFmt = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+
+function randomId(prefix, bytes = 6) {
+  return `${prefix}-${toHex(crypto.getRandomValues(new Uint8Array(bytes))).toUpperCase()}`;
+}
+
+function el(tag, props = {}, ...children) {
+  const node = document.createElement(tag);
+  Object.assign(node, props);
+  for (const child of children) {
+    if (child != null) node.append(child);
+  }
+  return node;
+}
+
+function dl(rows) {
+  const list = el('dl', { className: 'doc-fields' });
+  for (const [k, v] of rows) {
+    if (v == null || v === '') continue;
+    list.append(el('dt', { textContent: k }), el('dd', { textContent: String(v) }));
+  }
+  return list;
+}
+
+function renderDocSummary(type, doc) {
+  if (type === 'receipt') {
+    const table = el('table', { className: 'receipt-items' });
+    table.append(
+      el('thead', {}, el('tr', {}, el('th', { textContent: 'Item' }), el('th', { textContent: 'Qty' }), el('th', { textContent: 'Price' }))),
+    );
+    const tbody = el('tbody');
+    for (const item of doc.items ?? []) {
+      tbody.append(
+        el('tr', {},
+          el('td', { textContent: item.name }),
+          el('td', { textContent: String(item.qty) }),
+          el('td', { textContent: money.format((item.unitPriceCents * item.qty) / 100) }),
+        ),
+      );
+    }
+    table.append(tbody);
+    return el('div', {},
+      dl([
+        ['Receipt #', doc.id],
+        ['Customer', doc.customer],
+        ['Issued', doc.issuedAt && dateFmt.format(new Date(doc.issuedAt))],
+        ['Total', money.format((doc.totalCents ?? 0) / 100)],
+      ]),
+      table,
+    );
+  }
+  return dl([
+    ['Voucher code', doc.code],
+    ['Value', money.format((doc.amountCents ?? 0) / 100)],
+    ['To', doc.recipient],
+    ['From', doc.from],
+    ['Message', doc.message],
+    ['Issued', doc.issuedAt && dateFmt.format(new Date(doc.issuedAt))],
+    ['Expires', doc.expiresAt && dateFmt.format(new Date(doc.expiresAt))],
+  ]);
+}
+
+function suiteLabel(suite) {
+  return suite.startsWith('ML-DSA') ? `${suite} (post-quantum)` : suite === 'Ed25519' ? 'Ed25519 (classical)' : 'ECDSA P-256 (classical)';
+}
+
+function showSigned(outputEl, envelope, doc) {
+  const text = JSON.stringify(envelope, null, 2);
+  const textarea = el('textarea', {
+    className: 'envelope', readOnly: true, rows: 6, value: text, spellcheck: false,
+    ariaLabel: `Signed ${envelope.type} data`,
+  });
+  const copyBtn = el('button', { type: 'button', className: 'btn btn-small', textContent: 'Copy' });
+  copyBtn.addEventListener('click', async () => {
+    try {
+      await navigator.clipboard.writeText(text);
+      copyBtn.textContent = 'Copied!';
+    } catch {
+      textarea.select();
+      copyBtn.textContent = 'Press Ctrl+C';
+    }
+    setTimeout(() => (copyBtn.textContent = 'Copy'), 2000);
+  });
+  const blobUrl = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
+  const download = el('a', {
+    className: 'btn btn-small btn-ghost', href: blobUrl,
+    download: `daily-grind-${envelope.type}-${doc.id ?? doc.code}.json`, textContent: 'Download',
+  });
+  const useBtn = el('button', { type: 'button', className: 'btn btn-small btn-ghost', textContent: 'Send to verifier' });
+  useBtn.addEventListener('click', () => {
+    const input = $('#verify-input');
+    input.value = text;
+    input.focus();
+    input.scrollIntoView({ behavior: 'smooth', block: 'center' });
+  });
+
+  outputEl.replaceChildren(
+    el('p', { className: 'status status-valid' },
+      el('span', { ariaHidden: 'true', textContent: '✔ ' }),
+      `Signed with ${suiteLabel(envelope.alg)} · ${(fromBase64Url(envelope.signature).length).toLocaleString()}-byte signature`),
+    renderDocSummary(envelope.type, doc),
+    textarea,
+    el('div', { className: 'actions' }, copyBtn, download, useBtn),
+  );
+}
+
+function showError(outputEl, message) {
+  outputEl.replaceChildren(
+    el('p', { className: 'status status-invalid' }, el('span', { ariaHidden: 'true', textContent: '✖ ' }), message),
+  );
+}
+
+function showVerification(outputEl, result) {
+  const headings = {
+    valid: ['status-valid', '✔', `Authentic ${result.type === 'voucher' ? 'gift voucher' : 'receipt'} — signed by The Daily Grind and unmodified.`],
+    expired: ['status-warn', '⚠', result.reason],
+    untrusted: ['status-warn', '⚠', result.reason],
+    invalid: ['status-invalid', '✖', result.reason],
+  };
+  const [cls, icon, message] = headings[result.status];
+  const nodes = [el('p', { className: `status ${cls}` }, el('span', { ariaHidden: 'true', textContent: `${icon} ` }), message)];
+  if (result.alg && result.fingerprint) {
+    nodes.push(dl([['Algorithm', suiteLabel(result.alg)], ['Signer fingerprint', result.fingerprint]]));
+  }
+  if (result.doc && result.status !== 'invalid') {
+    nodes.push(renderDocSummary(result.type, result.doc));
+  }
+  outputEl.replaceChildren(...nodes);
+}
+
+async function init() {
+  const root = $('#signing');
+  if (!root) return;
+
+  const keyStatus = $('#key-status');
+  const formsToLock = root.querySelectorAll('button[type="submit"]');
+
+  if (!globalThis.isSecureContext || !crypto?.subtle) {
+    keyStatus.textContent = 'Digital signatures need a secure (HTTPS) connection. Signing is unavailable.';
+    formsToLock.forEach((b) => (b.disabled = true));
+    return;
+  }
+
+  let issuer;
+  const renderKey = () => {
+    keyStatus.replaceChildren(
+      el('strong', { textContent: suiteLabel(issuer.suite) }),
+      ' issuing key · fingerprint ',
+      el('code', { textContent: issuer.fingerprint }),
+    );
+  };
+
+  try {
+    issuer = await loadOrCreateIssuer();
+    renderKey();
+  } catch (err) {
+    keyStatus.textContent = `Could not create a signing key: ${err?.message ?? err}`;
+    formsToLock.forEach((b) => (b.disabled = true));
+    return;
+  }
+
+  $('#rotate-key').addEventListener('click', async () => {
+    if (!confirm('Generate a new issuing key? Documents signed with the old key will stay verifiable on this device.')) return;
+    issuer = await loadOrCreateIssuer({ rotate: true });
+    renderKey();
+  });
+
+  // Receipt
+  const receiptForm = $('#receipt-form');
+  const receiptOut = $('#receipt-output');
+  receiptForm.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const data = new FormData(receiptForm);
+    const items = Object.entries(MENU)
+      .map(([sku, { name, price }]) => ({
+        sku, name, qty: Math.max(0, Math.min(20, parseInt(data.get(sku), 10) || 0)),
+        unitPriceCents: Math.round(price * 100),
+      }))
+      .filter((i) => i.qty > 0);
+    if (!items.length) {
+      showError(receiptOut, 'Add at least one item to the order.');
+      return;
+    }
+    const doc = {
+      id: randomId('R'),
+      issuedAt: new Date().toISOString(),
+      store: 'The Daily Grind',
+      customer: String(data.get('customer') ?? '').trim().slice(0, 80) || undefined,
+      items,
+      totalCents: items.reduce((sum, i) => sum + i.unitPriceCents * i.qty, 0),
+      currency: 'USD',
+    };
+    try {
+      const envelope = await signDocument(issuer, 'receipt', doc);
+      showSigned(receiptOut, envelope, doc);
+    } catch (err) {
+      showError(receiptOut, `Signing failed: ${err?.message ?? err}`);
+    }
+  });
+
+  // Voucher
+  const voucherForm = $('#voucher-form');
+  const voucherOut = $('#voucher-output');
+  voucherForm.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    if (!voucherForm.reportValidity()) return;
+    const data = new FormData(voucherForm);
+    const amount = Number(data.get('amount'));
+    const months = Number(data.get('validity'));
+    const issued = new Date();
+    const expires = new Date(issued);
+    expires.setMonth(expires.getMonth() + months);
+    const doc = {
+      code: randomId('GV', 8),
+      issuedAt: issued.toISOString(),
+      expiresAt: expires.toISOString(),
+      amountCents: Math.round(amount * 100),
+      currency: 'USD',
+      recipient: String(data.get('recipient')).trim().slice(0, 80),
+      from: String(data.get('from') ?? '').trim().slice(0, 80) || undefined,
+      message: String(data.get('message') ?? '').trim().slice(0, 200) || undefined,
+    };
+    try {
+      const envelope = await signDocument(issuer, 'voucher', doc);
+      showSigned(voucherOut, envelope, doc);
+    } catch (err) {
+      showError(voucherOut, `Signing failed: ${err?.message ?? err}`);
+    }
+  });
+
+  // Verify
+  const verifyForm = $('#verify-form');
+  const verifyInput = $('#verify-input');
+  const verifyOut = $('#verify-output');
+  $('#verify-file').addEventListener('change', async (e) => {
+    const file = e.target.files?.[0];
+    if (!file) return;
+    if (file.size > 64 * 1024) {
+      showError(verifyOut, 'File is too large to be a Daily Grind receipt or voucher.');
+      return;
+    }
+    verifyInput.value = await file.text();
+    verifyInput.removeAttribute('aria-invalid');
+  });
+  verifyForm.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const text = verifyInput.value.trim();
+    if (!text) {
+      verifyInput.setAttribute('aria-invalid', 'true');
+      showError(verifyOut, 'Paste a signed receipt or voucher, or choose a file.');
+      return;
+    }
+    const result = await verifyDocument(text);
+    if (result.status === 'invalid') verifyInput.setAttribute('aria-invalid', 'true');
+    else verifyInput.removeAttribute('aria-invalid');
+    showVerification(verifyOut, result);
+  });
+}
+
+if (typeof document !== 'undefined') init();
+
+export { signDocument, verifyDocument, loadOrCreateIssuer, supportsPostQuantumSignatures };
