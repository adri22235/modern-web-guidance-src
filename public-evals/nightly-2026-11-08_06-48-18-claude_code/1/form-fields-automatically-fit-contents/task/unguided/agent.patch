+  <script>
+    // Fallback for browsers without CSS `field-sizing: content` support.
+    (function () {
+      if (CSS.supports('field-sizing', 'content')) return;
+
+      var mirror = document.createElement('span');
+      mirror.setAttribute('aria-hidden', 'true');
+      mirror.style.cssText = 'position:absolute;visibility:hidden;top:-9999px;left:-9999px;white-space:pre;';
+      document.body.appendChild(mirror);
+
+      function textWidth(el, text) {
+        var cs = getComputedStyle(el);
+        mirror.style.font = cs.font;
+        mirror.style.letterSpacing = cs.letterSpacing;
+        mirror.textContent = text || ' ';
+        return mirror.getBoundingClientRect().width;
+      }
+
+      function chrome(el) {
+        var cs = getComputedStyle(el);
+        return parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight) +
+          parseFloat(cs.borderLeftWidth) + parseFloat(cs.borderRightWidth);
+      }
+
+      function size(el) {
+        if (el.tagName === 'SELECT') {
+          var opt = el.options[el.selectedIndex];
+          // Extra room for the native dropdown arrow.
+          el.style.width = Math.ceil(textWidth(el, opt ? opt.text : '') + chrome(el) + 28) + 'px';
+        } else if (el.tagName === 'TEXTAREA') {
+          var lines = (el.value || el.placeholder).split('\n');
+          var widest = 0;
+          lines.forEach(function (l) { widest = Math.max(widest, textWidth(el, l)); });
+          el.style.width = Math.ceil(widest + chrome(el) + 2) + 'px';
+          el.style.height = 'auto';
+          var cs = getComputedStyle(el);
+          el.style.height = (el.scrollHeight + parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth)) + 'px';
+        } else {
+          el.style.width = Math.ceil(textWidth(el, el.value || el.placeholder) + chrome(el) + 2) + 'px';
+        }
+      }
+
+      var fields = document.querySelectorAll('.autosize');
+      fields.forEach(function (el) {
+        el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () { size(el); });
+        size(el);
+      });
+      window.addEventListener('resize', function () { fields.forEach(size); });
+    })();
+  </script>
