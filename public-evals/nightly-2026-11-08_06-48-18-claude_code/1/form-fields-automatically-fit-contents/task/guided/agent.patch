     .btn:hover {
       background: #3e2723;
     }
 
+    /* Feedback Form */
+    .feedback {
+      margin-top: 60px;
+      background: white;
+      padding: 30px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .feedback h2 {
+      color: var(--primary);
+      margin-bottom: 0.25rem;
+    }
+
+    .feedback .intro {
+      margin-bottom: 1.5rem;
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+      /* Don't stretch controls: let field-sizing determine their width */
+      align-items: flex-start;
+      gap: 0.25rem;
+      margin-block-end: 1.25rem;
+    }
+
+    .field label {
+      font-weight: 600;
+    }
+
+    .hint {
+      font-size: 0.85rem;
+      color: #5d4037;
+    }
+
+    .feedback input,
+    .feedback textarea,
+    .feedback select {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      color: var(--text);
+      background: white;
+      padding: 0.5rem 0.75rem;
+      min-height: 48px;
+      border: 1px solid #757575;
+      border-radius: 5px;
+      /* Size each control to its content (progressive enhancement) */
+      field-sizing: content;
+    }
+
+    .feedback input {
+      width: auto;
+      /* Keep empty input clickable, cap growth */
+      min-inline-size: 15ch;
+      max-inline-size: min(50ch, 100%);
+    }
+
+    .feedback textarea {
+      height: auto;
+      /* Stable width; grows vertically as text wraps */
+      width: min(60ch, 100%);
+      min-block-size: 3lh;
+      max-block-size: 12lh;
+      resize: vertical;
+    }
+
+    .feedback select {
+      max-inline-size: min(50ch, 100%);
+    }
+
+    .feedback input:focus-visible,
+    .feedback textarea:focus-visible,
+    .feedback select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .feedback button {
+      font: inherit;
+      border: none;
+      cursor: pointer;
+      margin-top: 0;
+      min-height: 48px;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
