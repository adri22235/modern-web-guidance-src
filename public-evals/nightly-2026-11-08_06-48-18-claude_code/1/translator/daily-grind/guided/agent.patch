+  <script type="module">
+    const SOURCE_LANG = 'en';
+    const form = document.getElementById('translate-form');
+    const select = document.getElementById('translate-lang');
+    const button = document.getElementById('translate-btn');
+    const progress = document.getElementById('translate-progress');
+    const status = document.getElementById('translate-status');
+    const targets = [...document.querySelectorAll('[data-translate]')];
+
+    // Keep the original English text so we can restore it and always
+    // translate from the source (avoids compounding translation errors).
+    const originals = new Map(targets.map((el) => [el, el.textContent.trim()]));
+    // Cache translated strings and translator instances per target language.
+    const cache = new Map();
+    const translators = new Map();
+
+    const setStatus = (msg) => { status.textContent = msg; };
+    const langName = (code) => select.querySelector(`option[value="${code}"]`)?.textContent ?? code;
+
+    if (!('Translator' in self)) {
+      select.disabled = true;
+      button.disabled = true;
+      setStatus('On-device translation is not supported in this browser. Try a recent desktop version of Chrome or Edge.');
+    }
+
+    function applyTexts(lang, texts) {
+      targets.forEach((el, i) => {
+        el.textContent = texts[i];
+        if (lang === SOURCE_LANG) el.removeAttribute('lang');
+        else el.setAttribute('lang', lang);
+        el.dir = lang === 'ar' ? 'rtl' : '';
+      });
+    }
+
+    async function getTranslator(targetLanguage) {
+      if (translators.has(targetLanguage)) return translators.get(targetLanguage);
+
+      const options = { sourceLanguage: SOURCE_LANG, targetLanguage };
+      const availability = await Translator.availability(options);
+      if (availability === 'unavailable') return null;
+
+      if (availability !== 'available') {
+        progress.value = 0;
+        progress.hidden = false;
+        setStatus(`Downloading ${langName(targetLanguage)} language pack…`);
+      }
+
+      try {
+        // Must run within the user gesture (form submit) when a download is needed.
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              progress.value = e.loaded;
+              setStatus(`Downloading ${langName(targetLanguage)} language pack… ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        translators.set(targetLanguage, translator);
+        return translator;
+      } finally {
+        progress.hidden = true;
+      }
+    }
+
+    async function translatePage(lang) {
+      if (lang === SOURCE_LANG) {
+        applyTexts(lang, targets.map((el) => originals.get(el)));
+        setStatus('Showing the original English text.');
+        return;
+      }
+
+      if (cache.has(lang)) {
+        applyTexts(lang, cache.get(lang));
+        setStatus(`Translated to ${langName(lang)} on your device.`);
+        return;
+      }
+
+      const translator = await getTranslator(lang);
+      if (!translator) {
+        setStatus(`${langName(lang)} isn't available for on-device translation on this device.`);
+        return;
+      }
+
+      setStatus(`Translating to ${langName(lang)}…`);
+      targets.forEach((el) => el.setAttribute('data-translating', ''));
+      try {
+        const texts = await Promise.all(
+          targets.map((el) => translator.translate(originals.get(el)))
+        );
+        cache.set(lang, texts);
+        applyTexts(lang, texts);
+        setStatus(`Translated to ${langName(lang)} on your device.`);
+      } finally {
+        targets.forEach((el) => el.removeAttribute('data-translating'));
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!('Translator' in self)) return;
+      const lang = select.value;
+      button.disabled = true;
+      select.disabled = true;
+      try {
+        await translatePage(lang);
+      } catch (err) {
+        console.error(err);
+        setStatus(err?.name === 'NotAllowedError'
+          ? 'Please press Translate again to allow the language pack download.'
+          : 'Sorry, something went wrong while translating. Please try again.');
+      } finally {
+        button.disabled = false;
+        select.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
