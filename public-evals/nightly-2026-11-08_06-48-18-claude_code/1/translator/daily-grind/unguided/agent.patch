+  <script>
+    // On-device translation using the browser's built-in Translator API
+    // (https://developer.chrome.com/docs/ai/translator-api). Text never leaves the device.
+    (() => {
+      const SOURCE = 'en';
+      const STORAGE_KEY = 'dailyGrindLang';
+      const select = document.getElementById('lang-select');
+      const status = document.getElementById('lang-status');
+      const nodes = [...document.querySelectorAll('[data-translate]')];
+      const originals = new Map(nodes.map(el => [el, el.textContent.replace(/\s+/g, ' ').trim()]));
+      const translators = new Map();
+      let requestId = 0;
+
+      const setStatus = (msg) => {
+        status.textContent = msg || '';
+        status.hidden = !msg;
+      };
+
+      const supported = 'Translator' in self;
+
+      if (!supported) {
+        select.disabled = true;
+        select.title = 'On-device translation is not supported in this browser';
+        setStatus('On-device translation isn\u2019t available in this browser. Try a recent version of Chrome or Edge on desktop.');
+        return;
+      }
+
+      const restoreOriginal = () => {
+        for (const [el, text] of originals) {
+          el.textContent = text;
+          el.removeAttribute('lang');
+        }
+        document.documentElement.lang = SOURCE;
+      };
+
+      async function getTranslator(target) {
+        if (translators.has(target)) return translators.get(target);
+        const promise = Translator.create({
+          sourceLanguage: SOURCE,
+          targetLanguage: target,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              setStatus(`Downloading language pack\u2026 ${Math.round(e.loaded * 100)}%`);
+            });
+          },
+        });
+        translators.set(target, promise);
+        try {
+          return await promise;
+        } catch (err) {
+          translators.delete(target);
+          throw err;
+        }
+      }
+
+      async function applyLanguage(target, { userInitiated }) {
+        const id = ++requestId;
+        if (target === SOURCE) {
+          restoreOriginal();
+          setStatus('');
+          localStorage.setItem(STORAGE_KEY, SOURCE);
+          return;
+        }
+
+        const label = select.querySelector(`option[value="${target}"]`)?.textContent || target;
+        try {
+          if (!translators.has(target)) {
+            const availability = await Translator.availability({ sourceLanguage: SOURCE, targetLanguage: target });
+            if (availability === 'unavailable') {
+              throw new Error(`Translation to ${label} isn\u2019t supported on this device.`);
+            }
+            // Downloading a model needs a user gesture; don't auto-download on page load.
+            if (availability !== 'available' && !userInitiated) return;
+          }
+
+          select.disabled = true;
+          setStatus(`Preparing ${label} translation\u2026`);
+          nodes.forEach(el => el.setAttribute('data-translating', ''));
+
+          const translator = await getTranslator(target);
+          const results = await Promise.all(
+            nodes.map(el => translator.translate(originals.get(el)))
+          );
+          if (id !== requestId) return; // a newer selection superseded this one
+
+          nodes.forEach((el, i) => {
+            el.textContent = results[i];
+            el.setAttribute('lang', target);
+          });
+          document.documentElement.lang = target;
+          localStorage.setItem(STORAGE_KEY, target);
+          setStatus('');
+        } catch (err) {
+          if (id !== requestId) return;
+          console.error(err);
+          restoreOriginal();
+          select.value = SOURCE;
+          setStatus(err instanceof Error && err.message.includes('supported')
+            ? err.message
+            : `Sorry, we couldn\u2019t translate to ${label}. Showing English instead.`);
+        } finally {
+          nodes.forEach(el => el.removeAttribute('data-translating'));
+          if (id === requestId) select.disabled = false;
+        }
+      }
+
+      select.addEventListener('change', () => applyLanguage(select.value, { userInitiated: true }));
+
+      // Restore previous choice if the language model is already on the device.
+      const saved = localStorage.getItem(STORAGE_KEY);
+      if (saved && saved !== SOURCE && select.querySelector(`option[value="${saved}"]`)) {
+        select.value = saved;
+        applyLanguage(saved, { userInitiated: false }).then(() => {
+          if (document.documentElement.lang !== saved) select.value = SOURCE;
+        });
+      }
+    })();
+  </script>
+
 </body>
 
