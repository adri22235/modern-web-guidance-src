diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..ea9533f
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,268 @@
+import React, { useEffect, useId, useRef, useState, useSyncExternalStore } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  getServerSnapshot,
+  getSnapshot,
+  initTranslation,
+  languageName,
+  setLanguages,
+  showOriginal,
+  subscribe,
+  translatePage,
+  type TranslationState,
+} from '../lib/translation';
+
+interface Props {
+  /**
+   * "header": compact icon button with a popover, available on every page.
+   * "inline": full-width bar shown above an article body.
+   */
+  variant?: 'header' | 'inline';
+}
+
+function useTranslation(): TranslationState {
+  const state = useSyncExternalStore(subscribe, getSnapshot, getServerSnapshot);
+  useEffect(() => initTranslation(), []);
+  return state;
+}
+
+const isBusy = (s: TranslationState) =>
+  s.status === 'preparing' || s.status === 'downloading' || s.status === 'translating';
+
+function statusText(s: TranslationState): string | null {
+  switch (s.status) {
+    case 'preparing':
+      return 'Preparing on-device translation…';
+    case 'downloading':
+      return `Downloading language pack… ${Math.round(s.progress * 100)}%`;
+    case 'translating':
+      return `Translating… ${s.done}/${s.total}`;
+    case 'translated': {
+      const from = s.detectedLanguages.filter((l) => l !== s.targetLanguage).map(languageName).join(', ');
+      return s.message ?? `Translated${from ? ` from ${from}` : ''} to ${languageName(s.targetLanguage)} on your device.`;
+    }
+    default:
+      return s.message;
+  }
+}
+
+function LanguageSelect({
+  id,
+  label,
+  value,
+  onChange,
+  disabled,
+  includeAuto,
+  localized,
+}: {
+  id: string;
+  label: string;
+  value: string;
+  onChange: (value: string) => void;
+  disabled?: boolean;
+  includeAuto?: boolean;
+  /** Language names depend on the reader's locale, so only use them after hydration. */
+  localized: boolean;
+}) {
+  const name = (code: string) => (localized ? languageName(code) : code);
+  const options = [...LANGUAGES].sort((a, b) => name(a).localeCompare(name(b)));
+  return (
+    <div className="flex flex-col gap-1 min-w-0">
+      <label htmlFor={id} className="text-[11px] font-semibold uppercase tracking-wider text-gray-500">
+        {label}
+      </label>
+      <select
+        id={id}
+        value={value}
+        disabled={disabled}
+        onChange={(e) => onChange(e.target.value)}
+        className="border border-gray-300 rounded px-2 py-1.5 text-sm bg-white text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-60"
+      >
+        {includeAuto && <option value="auto">Detect language</option>}
+        {options.map((code) => (
+          <option key={code} value={code}>
+            {name(code)}
+          </option>
+        ))}
+      </select>
+    </div>
+  );
+}
+
+function Controls({ state, compact }: { state: TranslationState; compact: boolean }) {
+  const id = useId();
+  const busy = isBusy(state);
+  const translated = state.status === 'translated';
+  const text = statusText(state);
+
+  if (state.support === 'unsupported') {
+    return (
+      <p className="text-sm text-gray-600">
+        On-device translation needs a browser with the built-in Translator API (Chrome 138 or later on desktop).
+      </p>
+    );
+  }
+
+  const progress =
+    state.status === 'downloading'
+      ? state.progress
+      : state.status === 'translating' && state.total > 0
+        ? state.done / state.total
+        : null;
+
+  return (
+    <div className="flex flex-col gap-3">
+      <div className={compact ? 'grid grid-cols-2 gap-2' : 'flex flex-wrap items-end gap-3'}>
+        <LanguageSelect
+          id={`${id}-from`}
+          label="From"
+          includeAuto
+          localized={state.support !== 'unknown'}
+          value={state.sourceLanguage}
+          disabled={busy || state.support === 'unknown'}
+          onChange={(sourceLanguage) => setLanguages({ sourceLanguage })}
+        />
+        <LanguageSelect
+          id={`${id}-to`}
+          label="To"
+          localized={state.support !== 'unknown'}
+          value={state.targetLanguage}
+          disabled={busy || state.support === 'unknown'}
+          onChange={(targetLanguage) => {
+            setLanguages({ targetLanguage });
+            // Switching language while translated re-translates straight away.
+            if (translated) void translatePage({ userInitiated: true });
+          }}
+        />
+        <div className={compact ? 'col-span-2 flex gap-2' : 'flex gap-2'}>
+          {busy ? (
+            <button
+              type="button"
+              onClick={showOriginal}
+              className="flex-1 border border-gray-300 text-gray-700 text-sm font-semibold py-1.5 px-3 rounded hover:bg-gray-100"
+            >
+              Cancel
+            </button>
+          ) : (
+            <>
+              <button
+                type="button"
+                disabled={state.support !== 'supported'}
+                onClick={() => void translatePage({ userInitiated: true })}
+                className="flex-1 bg-gray-800 text-white text-sm font-semibold py-1.5 px-3 rounded hover:bg-gray-700 disabled:opacity-50 whitespace-nowrap"
+              >
+                {translated ? 'Translate again' : 'Translate'}
+              </button>
+              {translated && (
+                <button
+                  type="button"
+                  onClick={showOriginal}
+                  className="flex-1 border border-gray-300 text-gray-700 text-sm font-semibold py-1.5 px-3 rounded hover:bg-gray-100 whitespace-nowrap"
+                >
+                  Show original
+                </button>
+              )}
+            </>
+          )}
+        </div>
+      </div>
+
+      {progress !== null && (
+        <div
+          className="h-1 w-full bg-gray-200 rounded overflow-hidden"
+          role="progressbar"
+          aria-valuemin={0}
+          aria-valuemax={100}
+          aria-valuenow={Math.round(progress * 100)}
+        >
+          <div className="h-full bg-amber-400 transition-[width]" style={{ width: `${progress * 100}%` }} />
+        </div>
+      )}
+
+      <p
+        aria-live="polite"
+        className={`text-xs min-h-4 ${state.status === 'error' ? 'text-red-700' : 'text-gray-500'}`}
+      >
+        {text}
+      </p>
+    </div>
+  );
+}
+
+function HeaderControl({ state }: { state: TranslationState }) {
+  const [open, setOpen] = useState(false);
+  const ref = useRef<HTMLDivElement>(null);
+  const panelId = useId();
+
+  useEffect(() => {
+    if (!open) return;
+    const onPointerDown = (e: PointerEvent) => {
+      if (!ref.current?.contains(e.target as Node)) setOpen(false);
+    };
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') setOpen(false);
+    };
+    document.addEventListener('pointerdown', onPointerDown);
+    document.addEventListener('keydown', onKeyDown);
+    return () => {
+      document.removeEventListener('pointerdown', onPointerDown);
+      document.removeEventListener('keydown', onKeyDown);
+    };
+  }, [open]);
+
+  const active = state.status === 'translated' || isBusy(state);
+
+  return (
+    <div ref={ref} className="relative" translate="no">
+      <button
+        type="button"
+        aria-label="Translate articles"
+        aria-expanded={open}
+        aria-controls={panelId}
+        title="Translate articles on your device"
+        onClick={() => setOpen((o) => !o)}
+        className={`relative w-6 h-6 flex items-center justify-center hover:text-amber-400 ${active ? 'text-amber-500' : 'text-gray-700'}`}
+      >
+        <LanguageIcon className="w-6 h-6" />
+        {active && <span className="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-amber-400" />}
+      </button>
+      {open && (
+        <div
+          id={panelId}
+          role="dialog"
+          aria-label="Translate articles"
+          className="absolute left-0 top-full mt-2 z-50 w-72 bg-white border border-gray-200 rounded-md shadow-lg p-4"
+        >
+          <h2 className="text-sm font-bold text-gray-900">Translate articles</h2>
+          <p className="text-xs text-gray-500 mt-0.5 mb-3">
+            Headlines, teasers and stories are translated privately in your browser.
+          </p>
+          <Controls state={state} compact />
+        </div>
+      )}
+    </div>
+  );
+}
+
+function InlineControl({ state }: { state: TranslationState }) {
+  return (
+    <section
+      translate="no"
+      aria-label="Translate this article"
+      className="w-full bg-gray-50 border border-gray-200 rounded-md p-4"
+    >
+      <div className="flex items-center gap-2 mb-3">
+        <LanguageIcon className="w-5 h-5 text-amber-600" />
+        <h2 className="text-sm font-bold text-gray-900">Read this article in another language</h2>
+        <span className="ml-auto text-[11px] text-gray-500">On-device · private</span>
+      </div>
+      <Controls state={state} compact={false} />
+    </section>
+  );
+}
+
+export default function TranslateControl({ variant = 'header' }: Props) {
+  const state = useTranslation();
+  return variant === 'inline' ? <InlineControl state={state} /> : <HeaderControl state={state} />;
+}
diff --git a/src/lib/translation.ts b/src/lib/translation.ts
new file mode 100644
index 0000000..2c8f2c3
--- /dev/null
+++ b/src/lib/translation.ts
@@ -0,0 +1,490 @@
+/**
+ * On-device article translation powered by Chrome's built-in AI
+ * Translator and Language Detector APIs.
+ *
+ * Everything runs locally in the browser: no article text is sent to a server.
+ * Elements opted in with the `data-translatable` attribute (headlines, teasers,
+ * summaries, captions and article bodies) are translated text node by text
+ * node, so markup, links and event listeners stay intact and the original
+ * text can be restored at any time.
+ *
+ * The state lives at module level so every <TranslateControl> on a page (the
+ * header control and the in-article bar) shares a single source of truth.
+ */
+
+// ---------------------------------------------------------------------------
+// Minimal typings for the built-in AI APIs (not yet in lib.dom.d.ts)
+// ---------------------------------------------------------------------------
+
+type AIAvailability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface AIDownloadProgressEvent extends Event {
+  loaded: number;
+}
+
+interface AICreateMonitor extends EventTarget {
+  addEventListener(
+    type: 'downloadprogress',
+    listener: (event: AIDownloadProgressEvent) => void,
+  ): void;
+}
+
+interface AICreateOptions {
+  signal?: AbortSignal;
+  monitor?: (monitor: AICreateMonitor) => void;
+}
+
+interface TranslatorInstance {
+  readonly sourceLanguage: string;
+  readonly targetLanguage: string;
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface TranslatorStatic {
+  availability(options: { sourceLanguage: string; targetLanguage: string }): Promise<AIAvailability>;
+  create(
+    options: { sourceLanguage: string; targetLanguage: string } & AICreateOptions,
+  ): Promise<TranslatorInstance>;
+}
+
+interface LanguageDetectionResult {
+  detectedLanguage: string;
+  confidence: number;
+}
+
+interface LanguageDetectorInstance {
+  detect(input: string, options?: { signal?: AbortSignal }): Promise<LanguageDetectionResult[]>;
+  destroy(): void;
+}
+
+interface LanguageDetectorStatic {
+  availability(options?: { expectedInputLanguages?: string[] }): Promise<AIAvailability>;
+  create(options?: AICreateOptions): Promise<LanguageDetectorInstance>;
+}
+
+declare global {
+  // eslint-disable-next-line no-var
+  var Translator: TranslatorStatic | undefined;
+  // eslint-disable-next-line no-var
+  var LanguageDetector: LanguageDetectorStatic | undefined;
+}
+
+// ---------------------------------------------------------------------------
+// Languages
+// ---------------------------------------------------------------------------
+
+/** BCP 47 codes offered in the UI (the set Chrome's Translator supports). */
+export const LANGUAGES = [
+  'ar', 'bg', 'bn', 'cs', 'da', 'de', 'el', 'en', 'es', 'fi', 'fr', 'hi', 'hr',
+  'hu', 'id', 'it', 'iw', 'ja', 'kn', 'ko', 'lt', 'mr', 'nl', 'no', 'pl', 'pt',
+  'ro', 'ru', 'sk', 'sl', 'sv', 'ta', 'te', 'th', 'tr', 'uk', 'vi', 'zh', 'zh-Hant',
+] as const;
+
+const displayNameCache = new Map<string, string>();
+
+/** Human-readable language name in the reader's UI language, e.g. "German". */
+export function languageName(code: string): string {
+  const cached = displayNameCache.get(code);
+  if (cached) return cached;
+  let name = code;
+  try {
+    const locale = typeof navigator !== 'undefined' ? navigator.language : 'en';
+    // "iw" is the legacy code for Hebrew that Chrome uses.
+    const lookup = code === 'iw' ? 'he' : code;
+    name = new Intl.DisplayNames([locale, 'en'], { type: 'language' }).of(lookup) ?? code;
+  } catch {
+    /* keep the code */
+  }
+  displayNameCache.set(code, name);
+  return name;
+}
+
+// ---------------------------------------------------------------------------
+// Store
+// ---------------------------------------------------------------------------
+
+export type Support = 'unknown' | 'supported' | 'unsupported';
+export type Status = 'idle' | 'preparing' | 'downloading' | 'translating' | 'translated' | 'error';
+
+export interface TranslationState {
+  support: Support;
+  status: Status;
+  /** "auto" uses the Language Detector API, falling back to the page `lang`. */
+  sourceLanguage: string;
+  targetLanguage: string;
+  /** Model download progress, 0–1, while status === 'downloading'. */
+  progress: number;
+  /** Text segments done / total while translating. */
+  done: number;
+  total: number;
+  /** Languages the page content was detected/declared in. */
+  detectedLanguages: string[];
+  message: string | null;
+}
+
+const STORAGE_KEY = 'devtools-times:translation';
+
+interface StoredPreference {
+  sourceLanguage: string;
+  targetLanguage: string;
+  /** Whether translation was switched on, so it can follow the reader across pages. */
+  active: boolean;
+}
+
+function defaultTarget(): string {
+  if (typeof navigator === 'undefined') return 'es';
+  const primary = navigator.language?.split('-')[0];
+  if (primary && primary !== 'en' && (LANGUAGES as readonly string[]).includes(primary)) return primary;
+  return 'es';
+}
+
+const SERVER_STATE: TranslationState = {
+  support: 'unknown',
+  status: 'idle',
+  sourceLanguage: 'auto',
+  targetLanguage: 'es',
+  progress: 0,
+  done: 0,
+  total: 0,
+  detectedLanguages: [],
+  message: null,
+};
+
+let state: TranslationState = SERVER_STATE;
+let active = false;
+const listeners = new Set<() => void>();
+
+function setState(patch: Partial<TranslationState>) {
+  state = { ...state, ...patch };
+  listeners.forEach((listener) => listener());
+}
+
+export function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export const getSnapshot = () => state;
+export const getServerSnapshot = () => SERVER_STATE;
+
+function readPreference(): StoredPreference | null {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    return raw ? (JSON.parse(raw) as StoredPreference) : null;
+  } catch {
+    return null;
+  }
+}
+
+function writePreference() {
+  try {
+    const pref: StoredPreference = {
+      sourceLanguage: state.sourceLanguage,
+      targetLanguage: state.targetLanguage,
+      active,
+    };
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(pref));
+  } catch {
+    /* storage may be unavailable (private mode, etc.) */
+  }
+}
+
+export function setLanguages(patch: { sourceLanguage?: string; targetLanguage?: string }) {
+  setState(patch);
+  writePreference();
+}
+
+// ---------------------------------------------------------------------------
+// DOM bookkeeping
+// ---------------------------------------------------------------------------
+
+const SKIP_SELECTOR = 'script, style, noscript, code, pre, kbd, samp, [translate="no"], [data-no-translate]';
+
+/** Original text of every text node we have touched. */
+const originalText = new Map<Text, string>();
+/** Original `lang` attribute (or null) of every element we re-labelled. */
+const originalLang = new Map<HTMLElement, string | null>();
+
+function translatableRoots(): HTMLElement[] {
+  const all = Array.from(document.querySelectorAll<HTMLElement>('[data-translatable]'));
+  // Ignore roots nested inside other roots so nothing is translated twice.
+  return all.filter((el) => !el.parentElement?.closest('[data-translatable]'));
+}
+
+function textNodesOf(root: HTMLElement): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
+      if (node.parentElement?.closest(SKIP_SELECTOR)) return NodeFilter.FILTER_REJECT;
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function declaredLanguage(el: HTMLElement): string {
+  const lang = el.closest<HTMLElement>('[lang]')?.lang || document.documentElement.lang || 'en';
+  return normalize(lang);
+}
+
+/** Map arbitrary BCP 47 tags onto the codes the Translator understands. */
+function normalize(tag: string): string {
+  const lower = tag.toLowerCase();
+  if (lower === 'he' || lower.startsWith('he-')) return 'iw';
+  if (lower === 'zh-hant' || lower === 'zh-tw' || lower === 'zh-hk' || lower.startsWith('zh-hant-')) return 'zh-Hant';
+  if (lower === 'nb' || lower === 'nn') return 'no';
+  return lower.split('-')[0];
+}
+
+function restoreDom() {
+  originalText.forEach((text, node) => {
+    if (node.isConnected) node.nodeValue = text;
+  });
+  originalText.clear();
+  originalLang.forEach((lang, el) => {
+    if (!el.isConnected) return;
+    if (lang === null) el.removeAttribute('lang');
+    else el.setAttribute('lang', lang);
+  });
+  originalLang.clear();
+}
+
+// ---------------------------------------------------------------------------
+// Model management
+// ---------------------------------------------------------------------------
+
+const translators = new Map<string, Promise<TranslatorInstance>>();
+let detectorPromise: Promise<LanguageDetectorInstance | null> | null = null;
+
+function trackDownload(monitor: AICreateMonitor) {
+  monitor.addEventListener('downloadprogress', (event) => {
+    if (event.loaded < 1) setState({ status: 'downloading', progress: event.loaded });
+    else setState({ status: 'preparing', progress: 1 });
+  });
+}
+
+async function getDetector(allowDownload: boolean): Promise<LanguageDetectorInstance | null> {
+  if (!globalThis.LanguageDetector) return null;
+  if (!detectorPromise) {
+    const availability = await globalThis.LanguageDetector.availability().catch(() => 'unavailable' as const);
+    if (availability === 'unavailable') return null;
+    if (availability !== 'available' && !allowDownload) return null;
+    detectorPromise = globalThis.LanguageDetector.create({ monitor: trackDownload }).catch(() => {
+      detectorPromise = null;
+      return null;
+    });
+  }
+  return detectorPromise;
+}
+
+class PairUnavailableError extends Error {}
+class NeedsUserActivationError extends Error {}
+
+async function getTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  allowDownload: boolean,
+): Promise<TranslatorInstance> {
+  const key = `${sourceLanguage}→${targetLanguage}`;
+  const cached = translators.get(key);
+  if (cached) return cached;
+
+  const api = globalThis.Translator!;
+  const availability = await api.availability({ sourceLanguage, targetLanguage });
+  if (availability === 'unavailable') {
+    throw new PairUnavailableError(
+      `${languageName(sourceLanguage)} → ${languageName(targetLanguage)} isn't supported on this device.`,
+    );
+  }
+  if (availability !== 'available' && !allowDownload) throw new NeedsUserActivationError();
+
+  const promise = api.create({ sourceLanguage, targetLanguage, monitor: trackDownload });
+  translators.set(key, promise);
+  promise.catch(() => translators.delete(key));
+  return promise;
+}
+
+// ---------------------------------------------------------------------------
+// Translation
+// ---------------------------------------------------------------------------
+
+let controller: AbortController | null = null;
+
+const WHITESPACE = /^(\s*)([\s\S]*?)(\s*)$/;
+
+/**
+ * Translate every `[data-translatable]` element on the page.
+ *
+ * @param userInitiated  true when triggered by a click. Model downloads need
+ *   transient user activation, so automatic runs (page navigation, reload)
+ *   only proceed with models that are already on the device.
+ */
+export async function translatePage({ userInitiated }: { userInitiated: boolean }): Promise<void> {
+  if (state.support !== 'supported') return;
+
+  controller?.abort();
+  const ctrl = new AbortController();
+  controller = ctrl;
+  const { signal } = ctrl;
+
+  // Always translate from the original text, never from a previous translation.
+  restoreDom();
+  setState({ status: 'preparing', progress: 0, done: 0, total: 0, message: null, detectedLanguages: [] });
+
+  const target = state.targetLanguage;
+
+  try {
+    const roots = translatableRoots();
+    if (roots.length === 0) {
+      setState({ status: 'idle', message: 'Nothing to translate on this page.' });
+      return;
+    }
+
+    // 1. Figure out the source language of every root.
+    const detector = state.sourceLanguage === 'auto' ? await getDetector(userInitiated) : null;
+    const groups = new Map<string, { root: HTMLElement; nodes: Text[] }[]>();
+    for (const root of roots) {
+      const nodes = textNodesOf(root);
+      if (nodes.length === 0) continue;
+      let source = state.sourceLanguage;
+      if (source === 'auto') {
+        source = declaredLanguage(root);
+        if (detector) {
+          const [best] = await detector.detect(root.textContent ?? '', { signal });
+          if (best && best.detectedLanguage !== 'und' && best.confidence >= 0.5) {
+            source = normalize(best.detectedLanguage);
+          }
+        }
+      }
+      if (signal.aborted) return;
+      const group = groups.get(source) ?? [];
+      group.push({ root, nodes });
+      groups.set(source, group);
+    }
+
+    const detectedLanguages = [...groups.keys()];
+    setState({ detectedLanguages });
+
+    // 2. Prepare one translator per language pair (may download models).
+    const jobs: { translator: TranslatorInstance; root: HTMLElement; nodes: Text[] }[] = [];
+    const problems: string[] = [];
+    let needsClick = false;
+    for (const [source, items] of groups) {
+      if (source === target) continue; // already in the requested language
+      try {
+        const translator = await getTranslator(source, target, userInitiated);
+        for (const item of items) jobs.push({ translator, ...item });
+      } catch (error) {
+        if (error instanceof NeedsUserActivationError) needsClick = true;
+        else problems.push(error instanceof Error ? error.message : String(error));
+      }
+      if (signal.aborted) return;
+    }
+
+    if (jobs.length === 0) {
+      if (needsClick) {
+        setState({ status: 'idle', message: `Click “Translate” to download the ${languageName(target)} language pack.` });
+      } else if (problems.length) {
+        setState({ status: 'error', message: problems.join(' ') });
+      } else {
+        setState({ status: 'idle', message: `This page is already in ${languageName(target)}.` });
+      }
+      return;
+    }
+
+    // 3. Translate text nodes, in document order so the reader sees
+    //    the top of the page update first.
+    const total = jobs.reduce((sum, job) => sum + job.nodes.length, 0);
+    let done = 0;
+    setState({ status: 'translating', done, total });
+
+    for (const { translator, root, nodes } of jobs) {
+      if (!originalLang.has(root)) originalLang.set(root, root.getAttribute('lang'));
+      for (const node of nodes) {
+        if (signal.aborted) return;
+        const original = node.nodeValue ?? '';
+        const [, lead, core, trail] = WHITESPACE.exec(original)!;
+        try {
+          const translated = await translator.translate(core, { signal });
+          if (signal.aborted) return;
+          if (node.isConnected) {
+            if (!originalText.has(node)) originalText.set(node, original);
+            node.nodeValue = `${lead}${translated}${trail}`;
+          }
+        } catch (error) {
+          if (signal.aborted) return;
+          // e.g. QuotaExceededError for very long segments: keep the original.
+          console.warn('[translation] Skipped a text segment:', error);
+        }
+        done += 1;
+        setState({ done });
+      }
+      root.setAttribute('lang', target === 'iw' ? 'he' : target);
+    }
+
+    active = true;
+    writePreference();
+    setState({
+      status: 'translated',
+      message: problems.length ? problems.join(' ') : null,
+    });
+  } catch (error) {
+    if (signal.aborted) return;
+    console.error('[translation] Failed:', error);
+    setState({
+      status: 'error',
+      message: error instanceof Error ? error.message : 'Translation failed.',
+    });
+  } finally {
+    if (controller === ctrl) controller = null;
+  }
+}
+
+/** Put the original text back and stop following the reader across pages. */
+export function showOriginal() {
+  controller?.abort();
+  controller = null;
+  restoreDom();
+  active = false;
+  writePreference();
+  setState({ status: 'idle', progress: 0, done: 0, total: 0, message: null });
+}
+
+// ---------------------------------------------------------------------------
+// Initialisation (client only, runs once per document)
+// ---------------------------------------------------------------------------
+
+let initialised = false;
+
+export function initTranslation() {
+  if (initialised || typeof window === 'undefined') return;
+  initialised = true;
+
+  const supported = typeof globalThis.Translator !== 'undefined';
+  const pref = readPreference();
+  setState({
+    support: supported ? 'supported' : 'unsupported',
+    sourceLanguage: pref?.sourceLanguage ?? 'auto',
+    targetLanguage: pref?.targetLanguage ?? defaultTarget(),
+  });
+  if (!supported) return;
+
+  active = pref?.active ?? false;
+  if (active) void translatePage({ userInitiated: false });
+
+  // Astro's <ClientRouter /> swaps the page without a reload: forget the old
+  // nodes and keep translating new pages if the reader switched it on.
+  document.addEventListener('astro:before-swap', () => {
+    controller?.abort();
+    controller = null;
+    originalText.clear();
+    originalLang.clear();
+  });
+  document.addEventListener('astro:page-load', () => {
+    if (active) void translatePage({ userInitiated: false });
+    else setState({ status: 'idle', message: null, done: 0, total: 0 });
+  });
+}
