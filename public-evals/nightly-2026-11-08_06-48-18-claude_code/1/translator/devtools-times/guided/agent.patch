diff --git a/src/utils/translation.ts b/src/utils/translation.ts
new file mode 100644
index 0000000..b098956
--- /dev/null
+++ b/src/utils/translation.ts
@@ -0,0 +1,334 @@
+/**
+ * On-device translation helpers built on the browser's built-in Translator API
+ * (Chrome 138+ / Edge 148+ desktop). Nothing in here sends article text to a
+ * server: translation happens locally once the language pack is on the device.
+ *
+ * Content opts in to translation with the `data-translatable` attribute. The
+ * element's (or nearest ancestor's) `lang` attribute declares its source
+ * language. We translate individual text nodes so links, emphasis and other
+ * markup inside the article body stay intact, and we remember each node's
+ * original text so the reader can switch languages or restore the original.
+ */
+
+export type TranslatorAvailability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+
+interface TranslatorOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+interface DownloadMonitor extends EventTarget {}
+
+interface TranslatorInstance {
+  translate(input: string, options?: { signal?: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+interface TranslatorStatic {
+  availability(options: TranslatorOptions): Promise<TranslatorAvailability>;
+  create(
+    options: TranslatorOptions & {
+      monitor?: (m: DownloadMonitor) => void;
+      signal?: AbortSignal;
+    },
+  ): Promise<TranslatorInstance>;
+}
+
+export const TRANSLATABLE_SELECTOR = '[data-translatable]';
+export const STORAGE_KEY = 'devtools-times:translation-language';
+
+/** Languages supported by Chrome's Translator implementation. */
+export const LANGUAGES: ReadonlyArray<{ code: string; name: string }> = [
+  { code: 'ar', name: 'العربية (Arabic)' },
+  { code: 'bg', name: 'Български (Bulgarian)' },
+  { code: 'bn', name: 'বাংলা (Bengali)' },
+  { code: 'cs', name: 'Čeština (Czech)' },
+  { code: 'da', name: 'Dansk (Danish)' },
+  { code: 'de', name: 'Deutsch (German)' },
+  { code: 'el', name: 'Ελληνικά (Greek)' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Español (Spanish)' },
+  { code: 'fi', name: 'Suomi (Finnish)' },
+  { code: 'fr', name: 'Français (French)' },
+  { code: 'he', name: 'עברית (Hebrew)' },
+  { code: 'hi', name: 'हिन्दी (Hindi)' },
+  { code: 'hr', name: 'Hrvatski (Croatian)' },
+  { code: 'hu', name: 'Magyar (Hungarian)' },
+  { code: 'id', name: 'Bahasa Indonesia (Indonesian)' },
+  { code: 'it', name: 'Italiano (Italian)' },
+  { code: 'ja', name: '日本語 (Japanese)' },
+  { code: 'kn', name: 'ಕನ್ನಡ (Kannada)' },
+  { code: 'ko', name: '한국어 (Korean)' },
+  { code: 'lt', name: 'Lietuvių (Lithuanian)' },
+  { code: 'mr', name: 'मराठी (Marathi)' },
+  { code: 'nl', name: 'Nederlands (Dutch)' },
+  { code: 'no', name: 'Norsk (Norwegian)' },
+  { code: 'pl', name: 'Polski (Polish)' },
+  { code: 'pt', name: 'Português (Portuguese)' },
+  { code: 'ro', name: 'Română (Romanian)' },
+  { code: 'ru', name: 'Русский (Russian)' },
+  { code: 'sk', name: 'Slovenčina (Slovak)' },
+  { code: 'sl', name: 'Slovenščina (Slovenian)' },
+  { code: 'sv', name: 'Svenska (Swedish)' },
+  { code: 'ta', name: 'தமிழ் (Tamil)' },
+  { code: 'te', name: 'తెలుగు (Telugu)' },
+  { code: 'th', name: 'ไทย (Thai)' },
+  { code: 'tr', name: 'Türkçe (Turkish)' },
+  { code: 'uk', name: 'Українська (Ukrainian)' },
+  { code: 'vi', name: 'Tiếng Việt (Vietnamese)' },
+  { code: 'zh', name: '中文 简体 (Chinese, Simplified)' },
+  { code: 'zh-Hant', name: '中文 繁體 (Chinese, Traditional)' },
+];
+
+const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+function getTranslatorApi(): TranslatorStatic | null {
+  if (typeof self === 'undefined' || !('Translator' in self)) return null;
+  return (self as unknown as { Translator: TranslatorStatic }).Translator;
+}
+
+export function isTranslationSupported(): boolean {
+  return getTranslatorApi() !== null;
+}
+
+/** Normalises e.g. "en-US" to "en" while keeping script subtags like "zh-Hant". */
+function normaliseLanguage(lang: string | null | undefined): string {
+  if (!lang) return 'en';
+  const [primary, second] = lang.split('-');
+  if (primary.toLowerCase() === 'zh' && second?.toLowerCase() === 'hant') return 'zh-Hant';
+  return primary.toLowerCase();
+}
+
+// ---------------------------------------------------------------------------
+// Translator instances (cached per language pair for the lifetime of the tab,
+// so client-side navigations don't re-create them).
+// ---------------------------------------------------------------------------
+
+const translators = new Map<string, Promise<TranslatorInstance>>();
+const pairKey = (o: TranslatorOptions) => `${o.sourceLanguage}→${o.targetLanguage}`;
+
+export async function getAvailability(
+  sourceLanguage: string,
+  targetLanguage: string,
+): Promise<TranslatorAvailability> {
+  const api = getTranslatorApi();
+  if (!api) return 'unavailable';
+  try {
+    // The same options object shape is passed to availability() and create().
+    return await api.availability({ sourceLanguage, targetLanguage });
+  } catch {
+    return 'unavailable';
+  }
+}
+
+/**
+ * Creates (or reuses) a translator. When the model is 'downloadable' or
+ * 'downloading', this must be called from within a user gesture.
+ */
+function getTranslator(
+  options: TranslatorOptions,
+  onDownloadProgress?: (fraction: number) => void,
+): Promise<TranslatorInstance> {
+  const key = pairKey(options);
+  let pending = translators.get(key);
+  if (!pending) {
+    const api = getTranslatorApi();
+    if (!api) return Promise.reject(new Error('Translator API not supported'));
+    pending = api.create({
+      ...options,
+      monitor(m) {
+        m.addEventListener('downloadprogress', (e) => {
+          onDownloadProgress?.((e as ProgressEvent).loaded);
+        });
+      },
+    });
+    // Don't cache failures (e.g. NotAllowedError without a user gesture).
+    pending.catch(() => translators.delete(key));
+    translators.set(key, pending);
+  }
+  return pending;
+}
+
+// ---------------------------------------------------------------------------
+// DOM translation
+// ---------------------------------------------------------------------------
+
+interface Region {
+  element: HTMLElement;
+  /** Original language of the region (from its `lang` attribute). */
+  sourceLanguage: string;
+  /** Original `dir` attribute, if any. */
+  originalDir: string | null;
+  originalLang: string | null;
+}
+
+const regions = new WeakMap<HTMLElement, Region>();
+const originalText = new WeakMap<Text, string>();
+/** Text we wrote into a node, so we can detect if something else changed it since. */
+const writtenText = new WeakMap<Text, string>();
+
+function getRegion(element: HTMLElement): Region {
+  let region = regions.get(element);
+  if (!region) {
+    const declared = element.closest<HTMLElement>('[lang]')?.getAttribute('lang');
+    region = {
+      element,
+      sourceLanguage: normaliseLanguage(declared ?? document.documentElement.lang),
+      originalDir: element.getAttribute('dir'),
+      originalLang: element.getAttribute('lang'),
+    };
+    regions.set(element, region);
+  }
+  return region;
+}
+
+function collectTextNodes(root: HTMLElement): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      if (parent.closest('script, style, code, pre, [translate="no"], [data-no-translate]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      return node.nodeValue && node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+    },
+  });
+  while (walker.nextNode()) nodes.push(walker.currentNode as Text);
+  return nodes;
+}
+
+function getOriginal(node: Text): string {
+  const current = node.nodeValue ?? '';
+  const stored = originalText.get(node);
+  // If someone else (e.g. a re-render) replaced the text, treat it as new original.
+  if (stored === undefined || writtenText.get(node) !== current) {
+    originalText.set(node, current);
+    writtenText.delete(node);
+    return current;
+  }
+  return stored;
+}
+
+function writeText(node: Text, value: string) {
+  node.nodeValue = value;
+  writtenText.set(node, value);
+}
+
+function setRegionLanguage(region: Region, lang: string | null) {
+  const { element } = region;
+  if (lang === null) {
+    region.originalLang === null ? element.removeAttribute('lang') : element.setAttribute('lang', region.originalLang);
+    region.originalDir === null ? element.removeAttribute('dir') : element.setAttribute('dir', region.originalDir);
+    delete element.dataset.translatedTo;
+    return;
+  }
+  element.setAttribute('lang', lang);
+  element.setAttribute('dir', RTL_LANGUAGES.has(lang) ? 'rtl' : 'ltr');
+  element.dataset.translatedTo = lang;
+}
+
+export function getTranslatableRegions(): Region[] {
+  return Array.from(document.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTOR), getRegion);
+}
+
+/** Restores every translatable region on the page to its original text. */
+export function restoreOriginal() {
+  // Don't skip regions without `data-translated-to`: an aborted run may have
+  // translated part of a region before finishing it.
+  for (const region of getTranslatableRegions()) {
+    for (const node of collectTextNodes(region.element)) {
+      const original = originalText.get(node);
+      if (original !== undefined && writtenText.get(node) === node.nodeValue) {
+        node.nodeValue = original;
+        writtenText.delete(node);
+      }
+    }
+    setRegionLanguage(region, null);
+  }
+}
+
+/** Source languages present on the current page that differ from the target. */
+export function getSourceLanguages(targetLanguage: string): string[] {
+  const set = new Set<string>();
+  for (const region of getTranslatableRegions()) {
+    if (region.sourceLanguage !== targetLanguage) set.add(region.sourceLanguage);
+  }
+  return [...set];
+}
+
+export interface TranslateProgress {
+  phase: 'downloading' | 'translating';
+  /** 0..1 */
+  fraction: number;
+}
+
+/**
+ * Translates all translatable regions on the page into `targetLanguage`.
+ * Must be invoked from a user gesture if any language pack still needs to be
+ * downloaded. Always translates from the stored original text, so switching
+ * between target languages never compounds translation errors.
+ */
+export async function translatePage(
+  targetLanguage: string,
+  { signal, onProgress }: { signal?: AbortSignal; onProgress?: (p: TranslateProgress) => void } = {},
+): Promise<void> {
+  const allRegions = getTranslatableRegions();
+  const sourceLanguages = getSourceLanguages(targetLanguage);
+
+  // Kick off create() for every pair immediately, while we still hold the
+  // transient user activation from the click.
+  const translatorsByPair = new Map<string, Promise<TranslatorInstance>>();
+  for (const sourceLanguage of sourceLanguages) {
+    translatorsByPair.set(
+      sourceLanguage,
+      getTranslator({ sourceLanguage, targetLanguage }, (fraction) =>
+        onProgress?.({ phase: 'downloading', fraction }),
+      ),
+    );
+  }
+
+  // Regions already in the target language just get restored.
+  const work: Array<{ region: Region; nodes: Text[] }> = [];
+  for (const region of allRegions) {
+    const nodes = collectTextNodes(region.element);
+    if (region.sourceLanguage === targetLanguage) {
+      for (const node of nodes) {
+        const original = originalText.get(node);
+        if (original !== undefined && writtenText.get(node) === node.nodeValue) writeText(node, original);
+      }
+      setRegionLanguage(region, null);
+    } else {
+      work.push({ region, nodes });
+    }
+  }
+
+  const total = work.reduce((n, w) => n + w.nodes.length, 0);
+  let done = 0;
+  // Cache identical strings per pair (teaser titles repeat across the page).
+  const memo = new Map<string, Promise<string>>();
+
+  // Work through regions in document order so the top of the page updates first.
+  for (const { region, nodes } of work) {
+    signal?.throwIfAborted();
+    const translator = await translatorsByPair.get(region.sourceLanguage)!;
+    for (const node of nodes) {
+      signal?.throwIfAborted();
+      const original = getOriginal(node);
+      // Preserve surrounding whitespace that text nodes rely on for spacing.
+      const [, leading, core, trailing] = original.match(/^(\s*)([\s\S]*?)(\s*)$/)!;
+      const key = `${region.sourceLanguage}|${core}`;
+      let pending = memo.get(key);
+      if (!pending) {
+        pending = translator.translate(core, { signal });
+        memo.set(key, pending);
+      }
+      const translated = await pending;
+      signal?.throwIfAborted();
+      writeText(node, leading + translated + trailing);
+      done++;
+      onProgress?.({ phase: 'translating', fraction: total ? done / total : 1 });
+    }
+    setRegionLanguage(region, targetLanguage);
+  }
+}
