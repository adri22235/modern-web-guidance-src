diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..85ce754
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,291 @@
+import React, { useCallback, useEffect, useId, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  LANGUAGES,
+  STORAGE_KEY,
+  getAvailability,
+  getSourceLanguages,
+  getTranslatableRegions,
+  isTranslationSupported,
+  restoreOriginal,
+  translatePage,
+  type TranslateProgress,
+  type TranslatorAvailability,
+} from '../utils/translation';
+
+type Status =
+  | { kind: 'idle' }
+  | { kind: 'unsupported' }
+  | { kind: 'nothing' }
+  | { kind: 'checking' }
+  | { kind: 'ready'; availability: TranslatorAvailability }
+  | { kind: 'working'; progress: TranslateProgress | null }
+  | { kind: 'translated'; language: string }
+  | { kind: 'error'; message: string };
+
+const ORIGINAL = '';
+
+function languageName(code: string) {
+  return LANGUAGES.find((l) => l.code === code)?.name ?? code;
+}
+
+/** Combined availability across every source language present on the page. */
+async function pageAvailability(target: string): Promise<TranslatorAvailability> {
+  const sources = getSourceLanguages(target);
+  if (sources.length === 0) return 'available';
+  const results = await Promise.all(sources.map((s) => getAvailability(s, target)));
+  if (results.includes('unavailable')) return 'unavailable';
+  if (results.includes('downloadable')) return 'downloadable';
+  if (results.includes('downloading')) return 'downloading';
+  return 'available';
+}
+
+function readStoredLanguage(): string {
+  try {
+    return localStorage.getItem(STORAGE_KEY) ?? ORIGINAL;
+  } catch {
+    return ORIGINAL;
+  }
+}
+
+function storeLanguage(lang: string) {
+  try {
+    if (lang) localStorage.setItem(STORAGE_KEY, lang);
+    else localStorage.removeItem(STORAGE_KEY);
+  } catch {
+    /* storage may be disabled; preference just won't persist */
+  }
+}
+
+export default function TranslateControl() {
+  const id = useId();
+  const popoverId = `${id}-translate`;
+  const selectId = `${id}-language`;
+  const statusId = `${id}-status`;
+
+  const buttonRef = useRef<HTMLButtonElement>(null);
+  const popoverRef = useRef<HTMLDivElement>(null);
+  const abortRef = useRef<AbortController | null>(null);
+
+  const [target, setTarget] = useState<string>(ORIGINAL);
+  const [status, setStatus] = useState<Status>({ kind: 'idle' });
+  const [activeLanguage, setActiveLanguage] = useState<string>(ORIGINAL);
+
+  const runTranslation = useCallback(async (lang: string) => {
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+
+    if (lang === ORIGINAL) {
+      restoreOriginal();
+      setActiveLanguage(ORIGINAL);
+      storeLanguage(ORIGINAL);
+      setStatus({ kind: 'idle' });
+      return;
+    }
+
+    setStatus({ kind: 'working', progress: null });
+    try {
+      // translatePage() calls Translator.create() synchronously first, so a
+      // click handler invoking this keeps its user activation for downloads.
+      await translatePage(lang, {
+        signal: controller.signal,
+        onProgress: (progress) => {
+          if (!controller.signal.aborted) setStatus({ kind: 'working', progress });
+        },
+      });
+      setActiveLanguage(lang);
+      storeLanguage(lang);
+      setStatus({ kind: 'translated', language: lang });
+    } catch (error) {
+      if (controller.signal.aborted) return;
+      restoreOriginal();
+      setActiveLanguage(ORIGINAL);
+      const name = (error as DOMException)?.name;
+      setStatus({
+        kind: 'error',
+        message:
+          name === 'NotAllowedError'
+            ? 'Press “Translate” to download the language pack.'
+            : name === 'NotSupportedError'
+              ? `Translating into ${languageName(lang)} isn’t supported on this device.`
+              : 'Translation failed. Please try again.',
+      });
+    }
+  }, []);
+
+  // On mount (and after each client-side navigation, which remounts the
+  // header), re-apply the reader's saved language if it can run without a
+  // download. Downloads need a click, so otherwise we just preselect it.
+  useEffect(() => {
+    if (!isTranslationSupported()) {
+      setStatus({ kind: 'unsupported' });
+      return;
+    }
+    if (getTranslatableRegions().length === 0) {
+      setStatus({ kind: 'nothing' });
+      return;
+    }
+    const stored = readStoredLanguage();
+    if (!stored) return;
+    setTarget(stored);
+    let cancelled = false;
+    pageAvailability(stored).then((availability) => {
+      if (cancelled) return;
+      if (availability === 'available') runTranslation(stored);
+      else setStatus({ kind: 'ready', availability });
+    });
+    return () => {
+      cancelled = true;
+      abortRef.current?.abort();
+    };
+  }, [runTranslation]);
+
+  // Show whether the chosen pair is ready on-device or needs a download.
+  const onTargetChange = async (lang: string) => {
+    setTarget(lang);
+    if (lang === ORIGINAL || status.kind === 'unsupported') return;
+    setStatus({ kind: 'checking' });
+    const availability = await pageAvailability(lang);
+    setStatus((s) => (s.kind === 'checking' ? { kind: 'ready', availability } : s));
+  };
+
+  // Position the popover below the button (top layer elements ignore the
+  // header's layout, so we place it manually).
+  useEffect(() => {
+    const popover = popoverRef.current;
+    if (!popover) return;
+    const onToggle = (event: Event) => {
+      if ((event as ToggleEvent).newState !== 'open' || !buttonRef.current) return;
+      const rect = buttonRef.current.getBoundingClientRect();
+      popover.style.top = `${rect.bottom + 8}px`;
+      popover.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - popover.offsetWidth - 8))}px`;
+    };
+    popover.addEventListener('beforetoggle', onToggle);
+    popover.addEventListener('toggle', onToggle);
+    return () => {
+      popover.removeEventListener('beforetoggle', onToggle);
+      popover.removeEventListener('toggle', onToggle);
+    };
+  }, []);
+
+  const unsupported = status.kind === 'unsupported';
+  const nothing = status.kind === 'nothing';
+  const working = status.kind === 'working';
+  const unavailablePair = status.kind === 'ready' && status.availability === 'unavailable';
+
+  let message: React.ReactNode = 'Translations run privately on your device. Nothing is sent to a server.';
+  if (unsupported) {
+    message = 'On-device translation isn’t supported in this browser. Try a recent desktop version of Chrome or Edge.';
+  } else if (nothing) {
+    message = 'There’s nothing to translate on this page.';
+  } else if (status.kind === 'checking') {
+    message = 'Checking language availability…';
+  } else if (status.kind === 'ready') {
+    message = {
+      available: 'Ready. This language is already on your device.',
+      downloadable: 'This language needs a one-time download before it can be used.',
+      downloading: 'This language is downloading…',
+      unavailable: 'This language isn’t available on your device.',
+    }[status.availability];
+  } else if (status.kind === 'working') {
+    const p = status.progress;
+    message =
+      p?.phase === 'downloading'
+        ? `Downloading language pack… ${Math.round(p.fraction * 100)}%`
+        : `Translating… ${Math.round((p?.fraction ?? 0) * 100)}%`;
+  } else if (status.kind === 'translated') {
+    message = `Translated into ${languageName(status.language)} on your device. Machine translations may contain errors.`;
+  } else if (status.kind === 'error') {
+    message = status.message;
+  }
+
+  const isActive = activeLanguage !== ORIGINAL;
+
+  return (
+    <>
+      <button
+        ref={buttonRef}
+        type="button"
+        popoverTarget={popoverId}
+        aria-label={isActive ? `Translate (showing ${languageName(activeLanguage)})` : 'Translate articles'}
+        title="Translate articles"
+        className={`relative w-6 h-6 flex items-center justify-center hover:text-amber-400 ${isActive ? 'text-amber-500' : 'text-gray-700'}`}
+      >
+        <LanguageIcon className="w-6 h-6" aria-hidden="true" />
+        {working && (
+          <span className="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" aria-hidden="true" />
+        )}
+      </button>
+
+      <div
+        ref={popoverRef}
+        id={popoverId}
+        popover="auto"
+        className="fixed m-0 w-72 max-w-[calc(100vw-1rem)] rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-800 shadow-lg"
+      >
+        <form
+          onSubmit={(e) => {
+            e.preventDefault();
+            runTranslation(target);
+          }}
+        >
+          <h2 className="font-semibold text-base mb-3">Translate articles</h2>
+          <label htmlFor={selectId} className="block text-xs font-semibold text-gray-600 mb-1">
+            Translate to
+          </label>
+          <select
+            id={selectId}
+            value={target}
+            disabled={unsupported || nothing}
+            aria-describedby={statusId}
+            onChange={(e) => onTargetChange(e.target.value)}
+            className="w-full rounded border border-gray-300 bg-white px-2 py-1.5 disabled:bg-gray-100 disabled:text-gray-400"
+          >
+            <option value={ORIGINAL}>Original language</option>
+            {LANGUAGES.map((l) => (
+              <option key={l.code} value={l.code} lang={l.code}>
+                {l.name}
+              </option>
+            ))}
+          </select>
+
+          {working && (
+            <progress
+              className="mt-3 w-full h-1.5 accent-amber-400"
+              max={1}
+              value={status.progress?.fraction ?? undefined}
+              aria-label="Translation progress"
+            />
+          )}
+
+          <p id={statusId} role="status" className="mt-3 text-xs text-gray-600">
+            {message}
+          </p>
+
+          <div className="mt-4 flex gap-2">
+            <button
+              type="submit"
+              disabled={unsupported || nothing || working || unavailablePair || target === activeLanguage}
+              className="flex-1 rounded bg-gray-800 px-3 py-2 text-xs font-semibold text-white hover:bg-gray-700 disabled:cursor-not-allowed disabled:bg-gray-300"
+            >
+              {target === ORIGINAL ? 'Show original' : 'Translate'}
+            </button>
+            {(isActive || working) && (
+              <button
+                type="button"
+                onClick={() => {
+                  setTarget(ORIGINAL);
+                  runTranslation(ORIGINAL);
+                }}
+                className="rounded border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-100"
+              >
+                {working ? 'Cancel' : 'Show original'}
+              </button>
+            )}
+          </div>
+        </form>
+      </div>
+    </>
+  );
+}
