+  <!-- Announces busy state to assistive technology -->
+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
+
+  <script>
+    (function () {
+      var status = document.getElementById('loading-status');
+      var buttons = document.querySelectorAll('.btn[data-loading-label]');
+      var busy = false;
+
+      function setLoading(btn) {
+        busy = true;
+        var labelEl = btn.querySelector('.btn-label');
+        var message = btn.getAttribute('data-loading-label') || 'Loading…';
+
+        btn.dataset.originalLabel = labelEl.textContent;
+        if (btn.hasAttribute('aria-label')) {
+          btn.dataset.originalAria = btn.getAttribute('aria-label');
+        }
+        btn.classList.add('is-loading');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('aria-label', message);
+        labelEl.textContent = btn.closest('.card') ? 'Loading…' : 'Starting…';
+
+        var card = btn.closest('.card');
+        if (card) {
+          card.classList.add('is-loading');
+          card.closest('.grid').setAttribute('aria-busy', 'true');
+        }
+        status.textContent = message;
+      }
+
+      function resetAll() {
+        busy = false;
+        status.textContent = '';
+        Array.prototype.forEach.call(buttons, function (btn) {
+          if (!btn.classList.contains('is-loading')) return;
+          btn.classList.remove('is-loading');
+          btn.removeAttribute('aria-busy');
+          btn.removeAttribute('aria-disabled');
+          if (btn.dataset.originalAria) {
+            btn.setAttribute('aria-label', btn.dataset.originalAria);
+          } else {
+            btn.removeAttribute('aria-label');
+          }
+          btn.querySelector('.btn-label').textContent = btn.dataset.originalLabel;
+          var card = btn.closest('.card');
+          if (card) card.classList.remove('is-loading');
+        });
+        Array.prototype.forEach.call(document.querySelectorAll('.grid[aria-busy]'), function (g) {
+          g.setAttribute('aria-busy', 'false');
+        });
+      }
+
+      Array.prototype.forEach.call(buttons, function (btn) {
+        btn.addEventListener('click', function (event) {
+          // Let the browser handle new-tab/window and download intents normally.
+          if (event.defaultPrevented || event.button !== 0 ||
+              event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+            return;
+          }
+          event.preventDefault();
+          if (busy) return; // ignore repeat clicks while a request is in flight
+
+          setLoading(btn);
+          var href = btn.href;
+          // Wait for the spinner and status message to render before navigating.
+          requestAnimationFrame(function () {
+            requestAnimationFrame(function () {
+              window.location.assign(href);
+            });
+          });
+        });
+      });
+
+      // Restore buttons when returning via back/forward cache.
+      window.addEventListener('pageshow', function (event) {
+        if (event.persisted) resetAll();
+      });
+    })();
+  </script>
+
