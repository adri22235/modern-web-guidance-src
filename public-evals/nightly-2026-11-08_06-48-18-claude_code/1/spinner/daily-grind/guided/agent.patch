+  <!-- Polite live region so screen reader users hear the busy state -->
+  <div id="loading-status" class="visually-hidden" role="status" aria-live="polite"></div>
+
+  <script>
+    (() => {
+      const status = document.getElementById('loading-status');
+      const buttons = document.querySelectorAll('a.btn[data-loading-label]');
+
+      function setBusy(link) {
+        const label = link.dataset.loadingLabel;
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+
+        const spinner = document.createElement('progress');
+        spinner.className = 'loading-spinner';
+        spinner.setAttribute('aria-label', label);
+        link.prepend(spinner);
+
+        status.textContent = label;
+      }
+
+      function reset() {
+        document.querySelectorAll('a.btn[aria-busy="true"]').forEach((link) => {
+          link.removeAttribute('aria-busy');
+          link.removeAttribute('aria-disabled');
+          link.querySelector('progress.loading-spinner')?.remove();
+        });
+        status.textContent = '';
+      }
+
+      buttons.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          // Let new-tab / modified clicks behave normally without a spinner
+          if (event.defaultPrevented || event.button !== 0 ||
+              event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+            return;
+          }
+          // Ignore repeat clicks while already loading
+          if (link.getAttribute('aria-busy') === 'true') {
+            event.preventDefault();
+            return;
+          }
+          setBusy(link);
+        });
+      });
+
+      // Clear stale spinners when the page is restored from the back/forward cache
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) reset();
+      });
+    })();
+  </script>
+
