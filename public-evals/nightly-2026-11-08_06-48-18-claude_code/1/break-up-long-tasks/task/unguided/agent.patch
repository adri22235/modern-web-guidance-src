+        const seed = parseInt($('sim-seed').value, 10) || 0;
+        runSimulation(total, $('sim-target').value, seed);
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        if (currentRun) currentRun.cancelled = true;
+      });
+
+      $('sim-target').addEventListener('change', (e) => {
+        if (!currentRun) renderBars(null, TARGETS[e.target.value]);
+      });
+
+      renderBars(null, TARGETS.balanced);
+    })();
+  </script>
+
