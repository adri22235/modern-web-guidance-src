+        { name: 'Medium', d: [0, 0, 0.5, 0, 0.5, 0] },
+        { name: 'Med-Dark', d: [-1.0, 1.0, 0.5, 1.0, 0, -1.0] },
+        { name: 'Dark', d: [-2.0, 1.5, -0.5, 2.5, -0.5, -2.0] }
+      ];
+
+      // Brew methods: target extraction time (s), temperature (°C), body bias.
+      const BREWS = [
+        { name: 'Pour-over', time: 210, temp: 94, body: -0.5 },
+        { name: 'Espresso', time: 28, temp: 93, body: 1.5 },
+        { name: 'French Press', time: 240, temp: 95, body: 1.0 },
+        { name: 'Cold Brew', time: 64800, temp: 20, body: 0.5 },
+        { name: 'AeroPress', time: 120, temp: 88, body: 0.3 }
+      ];
+
+      const TARGETS = {
+        balanced: [6, 6, 6.5, 4.5, 7, 5.5],
+        bright: [8.5, 4.5, 6.5, 3, 8.5, 8.5],
+        bold: [3, 8.5, 6, 6.5, 6.5, 3],
+        sweet: [4.5, 6.5, 8.5, 3.5, 7, 5]
+      };
+
+      // Deterministic PRNG so a seed always reproduces the same batch.
+      function mulberry32(seed) {
+        let a = seed >>> 0;
+        return () => {
+          a = (a + 0x6D2B79F5) >>> 0;
+          let t = a;
+          t = Math.imul(t ^ (t >>> 15), t | 1);
+          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      const clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);
+
+      function makeBlend(rand) {
+        const n = 2 + Math.floor(rand() * 3); // 2–4 components
+        const picks = [];
+        const used = new Set();
+        let total = 0;
+        while (picks.length < n) {
+          const i = Math.floor(rand() * ORIGINS.length);
+          if (used.has(i)) continue;
+          used.add(i);
+          const w = 0.2 + rand();
+          picks.push({ i, w });
