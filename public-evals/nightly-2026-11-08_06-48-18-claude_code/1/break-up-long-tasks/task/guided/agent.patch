+  <script>
+    (() => {
+      const ORIGINS = [
+        { name: 'Ethiopia Yirgacheffe', acidity: 8.5, body: 4.5, sweetness: 7.0, bitterness: 3.0, aroma: 9.0 },
+        { name: 'Colombia Huila', acidity: 6.5, body: 6.0, sweetness: 7.5, bitterness: 4.0, aroma: 7.0 },
+        { name: 'Sumatra Mandheling', acidity: 3.0, body: 9.0, sweetness: 5.0, bitterness: 6.5, aroma: 6.5 },
+        { name: 'Kenya AA', acidity: 9.0, body: 6.0, sweetness: 6.5, bitterness: 4.0, aroma: 8.0 },
+        { name: 'Brazil Santos', acidity: 4.0, body: 7.0, sweetness: 8.0, bitterness: 5.0, aroma: 6.0 },
+        { name: 'Guatemala Antigua', acidity: 6.0, body: 7.0, sweetness: 6.5, bitterness: 5.0, aroma: 7.5 },
+        { name: 'Costa Rica Tarrazú', acidity: 7.5, body: 5.5, sweetness: 7.0, bitterness: 3.5, aroma: 7.0 },
+        { name: 'Vietnam Robusta', acidity: 2.5, body: 8.5, sweetness: 3.5, bitterness: 8.5, aroma: 5.0 }
+      ];
+      const ROASTS = ['Light', 'Medium', 'Medium-Dark', 'Dark'];
+      const TRAITS = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+      const METHODS = {
+        espresso: { acidity: 0.9, body: 1.3, sweetness: 1.0, bitterness: 1.2, aroma: 1.1, steps: 30 },
+        pourover: { acidity: 1.15, body: 0.85, sweetness: 1.05, bitterness: 0.9, aroma: 1.15, steps: 60 },
+        frenchpress: { acidity: 0.9, body: 1.25, sweetness: 1.0, bitterness: 1.05, aroma: 0.95, steps: 80 },
+        coldbrew: { acidity: 0.6, body: 1.1, sweetness: 1.2, bitterness: 0.7, aroma: 0.85, steps: 120 }
+      };
+
+      // Small deterministic PRNG so the same batch yields the same results.
+      function mulberry32(seed) {
+        return () => {
+          seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
+          let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+      }
+
+      function createBlend(rand, id) {
+        const count = 2 + Math.floor(rand() * 3); // 2–4 origins
+        const picks = [];
+        let total = 0;
+        while (picks.length < count) {
+          const origin = ORIGINS[Math.floor(rand() * ORIGINS.length)];
+          if (picks.some(p => p.origin === origin)) continue;
+          const weight = 0.1 + rand();
+          total += weight;
+          picks.push({ origin, weight });
+        }
+        picks.forEach(p => { p.weight /= total; });
+        return { id, components: picks, roast: Math.floor(rand() * ROASTS.length) };
+      }
+
+      // Simulate extraction over time for one blend — intentionally CPU-heavy.
+      function simulateBlend(blend, method) {
+        const profile = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+        for (const { origin, weight } of blend.components) {
+          for (const t of TRAITS) profile[t] += origin[t] * weight;
+        }
+        const roast = blend.roast / (ROASTS.length - 1); // 0..1
+        profile.acidity *= 1.2 - roast * 0.6;
+        profile.bitterness *= 0.8 + roast * 0.7;
+        profile.body *= 0.9 + roast * 0.3;
+        profile.sweetness *= 1 + Math.sin(roast * Math.PI) * 0.2; // caramelisation peaks mid-roast
+
+        // Iterative extraction model: solubles dissolve along a decaying curve.
+        let extracted = 0;
+        for (let step = 1; step <= method.steps; step++) {
+          const rate = Math.exp(-step / (method.steps * 0.35));
+          extracted += rate * (1 - extracted) * 0.08;
+          for (const t of TRAITS) {
+            profile[t] += Math.sin(step * 0.13 + profile[t]) * 0.0005 * rate;
+          }
+        }
+        for (const t of TRAITS) {
+          profile[t] = Math.min(10, Math.max(0, profile[t] * method[t] * (0.75 + extracted * 0.4)));
+        }
+
+        // Balance score: reward sweetness/aroma, penalise harshness and imbalance.
+        const mean = TRAITS.reduce((s, t) => s + profile[t], 0) / TRAITS.length;
+        const variance = TRAITS.reduce((s, t) => s + (profile[t] - mean) ** 2, 0) / TRAITS.length;
+        const score = profile.sweetness * 1.2 + profile.aroma + profile.body * 0.6 +
+          profile.acidity * 0.5 - profile.bitterness * 0.7 - Math.sqrt(variance) * 0.8;
+        return { profile, score };
+      }
+
+      // Yield to the main thread, using scheduler.yield() when available.
+      function yieldToMain() {
+        if (globalThis.scheduler?.yield) return scheduler.yield();
+        return new Promise(resolve => setTimeout(resolve, 0));
+      }
+
+      async function runSimulation(size, methodKey, { signal, onProgress }) {
+        const method = METHODS[methodKey];
+        const rand = mulberry32(size ^ methodKey.length * 2654435761);
+        const totals = { acidity: 0, body: 0, sweetness: 0, bitterness: 0, aroma: 0 };
+        const top = [];
+        let deadline = performance.now() + 50; // stay under the 50ms long-task threshold
+
+        for (let i = 0; i < size; i++) {
+          const blend = createBlend(rand, i + 1);
+          const result = simulateBlend(blend, method);
+          for (const t of TRAITS) totals[t] += result.profile[t];
+
+          if (top.length < 5 || result.score > top[top.length - 1].score) {
+            top.push({ blend, ...result });
+            top.sort((a, b) => b.score - a.score);
+            if (top.length > 5) top.pop();
+          }
+
+          if (performance.now() >= deadline) {
+            onProgress(i + 1, size);
+            await yieldToMain();
+            signal.throwIfAborted();
+            deadline = performance.now() + 50;
+          }
+        }
+        onProgress(size, size);
+        const averages = Object.fromEntries(TRAITS.map(t => [t, totals[t] / size]));
+        return { averages, top };
+      }
+
+      const form = document.getElementById('sim-form');
+      const runBtn = document.getElementById('sim-run');
+      const cancelBtn = document.getElementById('sim-cancel');
+      const progressEl = document.getElementById('sim-progress');
+      const statusEl = document.getElementById('sim-status');
+      const resultsEl = document.getElementById('sim-results');
+      const profileEl = document.getElementById('sim-profile');
+      const topEl = document.getElementById('sim-top');
+      const fmt = new Intl.NumberFormat();
+      let controller = null;
+
+      function setRunning(running) {
+        runBtn.disabled = running;
+        cancelBtn.disabled = !running;
+        form.querySelectorAll('select').forEach(s => { s.disabled = running; });
+      }
+
+      function renderResults({ averages, top }) {
+        profileEl.replaceChildren(...TRAITS.map(t => {
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = t[0].toUpperCase() + t.slice(1);
+          const bar = document.createElement('span');
+          bar.className = 'bar';
+          const fill = document.createElement('span');
+          fill.style.width = `${averages[t] * 10}%`;
+          bar.append(fill);
+          const val = document.createElement('span');
+          val.className = 'val';
+          val.textContent = averages[t].toFixed(1);
+          li.append(label, bar, val);
+          return li;
+        }));
+
+        topEl.replaceChildren(...top.map(({ blend, score, profile }) => {
+          const li = document.createElement('li');
+          const strong = document.createElement('strong');
+          strong.textContent = `Blend #${blend.id} — ${ROASTS[blend.roast]} roast (score ${score.toFixed(2)})`;
+          const mix = document.createElement('small');
+          mix.textContent = blend.components
+            .map(c => `${Math.round(c.weight * 100)}% ${c.origin.name}`).join(', ');
+          const notes = document.createElement('small');
+          notes.textContent = TRAITS.map(t => `${t} ${profile[t].toFixed(1)}`).join(' · ');
+          li.append(strong, mix, notes);
+          return li;
+        }));
+        resultsEl.hidden = false;
+      }
+
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const size = Number(document.getElementById('sim-batch').value);
+        const method = document.getElementById('sim-method').value;
+        controller = new AbortController();
+        setRunning(true);
+        progressEl.value = 0;
+        statusEl.textContent = `Simulating ${fmt.format(size)} blends…`;
+        const start = performance.now();
+
+        try {
+          const results = await runSimulation(size, method, {
+            signal: controller.signal,
+            onProgress(done, total) {
+              progressEl.value = (done / total) * 100;
+              statusEl.textContent = `Simulated ${fmt.format(done)} of ${fmt.format(total)} blends…`;
+            }
+          });
+          const secs = ((performance.now() - start) / 1000).toFixed(2);
+          statusEl.textContent = `Done! Simulated ${fmt.format(size)} blends in ${secs}s.`;
+          renderResults(results);
+        } catch (err) {
+          if (err.name !== 'AbortError') throw err;
+          statusEl.textContent = 'Simulation cancelled.';
+        } finally {
+          controller = null;
+          setRunning(false);
+        }
+      });
+
+      cancelBtn.addEventListener('click', () => controller?.abort());
+    })();
+  </script>
 </body>
 
