       --text: #3e2723;
       --light: #fafafa;
     }
 
+    /* ------------------------------------------------------------------
+       Reusable CSS custom functions (@function, CSS Functions & Mixins).
+       Call sites pass literal arguments only, so browsers without
+       @function support drop those declarations at parse time and keep
+       the plain fallbacks declared just before them.
+       ------------------------------------------------------------------ */
+
+    /* Three-stop linear gradient; the middle stop defaults to a blend. */
+    @function --gradient(--angle <angle>: 135deg,
+      --from <color>: #fafafa,
+      --to <color>: #d7ccc8,
+      --via <color>: color-mix(in oklab, var(--from), var(--to))) {
+      result: linear-gradient(var(--angle), var(--from), var(--via), var(--to));
+    }
+
+    /* Responsive equal-width columns: one column on narrow screens,
+       --count equal columns once the viewport passes the breakpoint. */
+    @function --columns(--count <integer>: 2) {
+      result: minmax(0, 1fr);
+
+      @media (min-width: 700px) {
+        result: repeat(var(--count), minmax(0, 1fr));
+      }
+    }
+
