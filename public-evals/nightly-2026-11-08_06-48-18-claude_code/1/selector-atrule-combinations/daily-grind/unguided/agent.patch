+    /* ===== Theme selection =====
+       The page follows the OS preference by default (color-scheme: light dark).
+       A root attribute or class forces a scheme. Only `color-scheme` changes
+       here; every themed color below is written once with light-dark(), so
+       there are no duplicated per-theme rule blocks. */
+    :root {
+      color-scheme: light dark;
+    }
+
+    :root[data-theme="light"],
+    :root[data-color-scheme="light"],
+    :root.light,
+    :root.theme-light {
+      color-scheme: light;
+    }
+
+    :root[data-theme="dark"],
+    :root[data-color-scheme="dark"],
+    :root.dark,
+    :root.theme-dark {
+      color-scheme: dark;
+    }
+
+    /* ===== Theme tokens (light value, dark value) ===== */
+    :root {
+      --page-bg: light-dark(var(--light), #1a1412);
+      --page-text: light-dark(var(--text), #ede0d9);
+      --heading: light-dark(var(--text), #f5ebe6);
+
+      --nav-bg: light-dark(var(--primary), #120d0b);
+      --nav-text: light-dark(#ffffff, #efe4de);
+      --nav-link-hover: light-dark(var(--accent), #ffc370);
+      --nav-border: light-dark(transparent, #3a2d28);
+      --nav-shadow: light-dark(0 2px 6px rgba(0, 0, 0, 0.15), 0 2px 10px rgba(0, 0, 0, 0.6));
+
+      --hero-overlay: light-dark(rgba(0, 0, 0, 0.45), rgba(10, 6, 4, 0.72));
+      --hero-text: light-dark(#ffffff, #f5ebe6);
+      --hero-subtext: light-dark(rgba(255, 255, 255, 0.92), #d7ccc8);
+
+      --card-bg: light-dark(#ffffff, #2a201d);
+      --card-text: light-dark(var(--text), #d7ccc8);
+      --card-title: light-dark(var(--primary), #ffcc80);
+      --card-border: light-dark(transparent, #3e302b);
+      --card-shadow: light-dark(0 2px 5px rgba(0, 0, 0, 0.1), 0 4px 14px rgba(0, 0, 0, 0.5));
+
+      --btn-bg: light-dark(var(--primary), var(--accent));
+      --btn-text: light-dark(#ffffff, #2a1a12);
+      --btn-hover-bg: light-dark(#3e2723, #ffc370);
+    }
