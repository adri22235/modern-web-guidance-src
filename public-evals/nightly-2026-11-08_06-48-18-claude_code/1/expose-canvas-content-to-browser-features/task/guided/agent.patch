+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const stage = canvas.parentElement;
+      const form = document.getElementById('order-form');
+      const nameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('milk');
+      const syrupSelect = document.getElementById('syrup');
+      const summary = document.getElementById('order-summary');
+
+      const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function';
+
+      // Fallback: canvas children aren't rendered without HTML-in-Canvas, so
+      // move the form next to the canvas and overlay it at the same position.
+      if (!supportsHtmlInCanvas) {
+        stage.append(form);
+        form.classList.add('is-overlay');
+      }
+
+      const MILKS = {
+        none: { label: 'no milk', coffee: '#3b2216', foam: null },
+        whole: { label: 'whole milk', coffee: '#8a5a3b', foam: '#f6ede1' },
+        oat: { label: 'oat milk', coffee: '#9b6b47', foam: '#efe2c8' },
+        almond: { label: 'almond milk', coffee: '#94603f', foam: '#f1e4d3' },
+        skim: { label: 'skim milk', coffee: '#7d5137', foam: '#fbf8f3' },
+      };
+      const SYRUPS = {
+        none: { label: 'no syrup', color: null },
+        vanilla: { label: 'vanilla syrup', color: '#f3dc9b' },
+        caramel: { label: 'caramel syrup', color: '#c8771f' },
+        hazelnut: { label: 'hazelnut syrup', color: '#8d5a2b' },
+        maple: { label: 'maple syrup', color: '#b5541c' },
+      };
+
+      // Layout in CSS pixels; shared by drawing and the fallback overlay.
+      const layout = { width: 0, height: 0, formX: 0, formY: 0, cupX: 0, cupY: 0, cupSize: 0 };
+
+      function updateLayout() {
+        const width = canvas.clientWidth;
+        if (!width) return;
+        const pad = 24;
+        const wide = width >= 640;
+        const formWidth = wide ? 320 : width - pad * 2;
+        if (form.style.width !== `${formWidth}px`) form.style.width = `${formWidth}px`;
+        const formHeight = form.offsetHeight;
+
+        let height;
+        if (wide) {
+          height = Math.max(400, formHeight + pad * 2);
+          layout.formX = width - formWidth - pad * 2;
+          layout.formY = (height - formHeight) / 2;
+          layout.cupX = layout.formX / 2;
+          layout.cupY = height / 2;
+          layout.cupSize = Math.min(layout.formX - pad * 2, height - pad * 2, 320);
+        } else {
+          const cupArea = 300;
+          height = cupArea + formHeight + pad;
+          layout.formX = pad;
+          layout.formY = cupArea;
+          layout.cupX = width / 2;
+          layout.cupY = cupArea / 2 + 6;
+          layout.cupSize = Math.min(width - pad * 2, cupArea - pad * 2);
+        }
+        layout.width = width;
+        layout.height = height;
+        if (canvas.style.height !== `${height}px`) canvas.style.height = `${height}px`;
+
+        if (!supportsHtmlInCanvas) {
+          form.style.translate = `${layout.formX}px ${layout.formY}px`;
+        }
+      }
+
+      function getState() {
+        return {
+          name: nameInput.value.trim(),
+          milk: MILKS[milkSelect.value] ?? MILKS.none,
+          syrup: SYRUPS[syrupSelect.value] ?? SYRUPS.none,
+        };
+      }
+
+      function updateSummary() {
+        const { name, milk, syrup } = getState();
+        const text = `${name ? `${name}'s` : 'Your'} latte with ${milk.label} and ${syrup.label}.`;
+        if (summary.value !== text) summary.value = text;
+      }
+
+      function roundRectPath(x, y, w, h, r) {
+        ctx.beginPath();
+        ctx.roundRect(x, y, w, h, r);
+      }
+
+      function drawCup({ name, milk, syrup }) {
+        const { cupX: cx, cupY: cy, cupSize: s } = layout;
+        if (s <= 0) return;
+        const topW = s * 0.62;
+        const botW = s * 0.46;
+        const cupH = s * 0.68;
+        const top = cy - cupH / 2 + s * 0.06;
+        const bottom = top + cupH;
+
+        // Saucer shadow
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.15)';
+        ctx.beginPath();
+        ctx.ellipse(cx, bottom + s * 0.03, s * 0.42, s * 0.06, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
+        ctx.lineWidth = s * 0.05;
+        ctx.beginPath();
+        ctx.ellipse(cx + (topW + botW) / 4 + s * 0.02, top + cupH * 0.45, s * 0.1, s * 0.15, 0, -Math.PI / 2, Math.PI / 2);
+        ctx.stroke();
+
+        // Glass outline path
+        const glass = new Path2D();
+        glass.moveTo(cx - topW / 2, top);
+        glass.lineTo(cx + topW / 2, top);
+        glass.lineTo(cx + botW / 2, bottom - s * 0.04);
+        glass.quadraticCurveTo(cx + botW / 2, bottom, cx + botW / 2 - s * 0.04, bottom);
+        glass.lineTo(cx - botW / 2 + s * 0.04, bottom);
+        glass.quadraticCurveTo(cx - botW / 2, bottom, cx - botW / 2, bottom - s * 0.04);
+        glass.closePath();
+
+        // Liquid layers, clipped to the glass
+        ctx.save();
+        ctx.clip(glass);
+        const fillTop = top + cupH * 0.1;
+        const liquidH = bottom - fillTop;
+        const syrupH = syrup.color ? liquidH * 0.16 : 0;
+        const foamH = milk.foam ? liquidH * 0.2 : liquidH * 0.05;
+
+        const coffeeGrad = ctx.createLinearGradient(0, fillTop, 0, bottom);
+        coffeeGrad.addColorStop(0, milk.coffee);
+        coffeeGrad.addColorStop(1, '#2b170e');
+        ctx.fillStyle = coffeeGrad;
+        ctx.fillRect(cx - s, fillTop, s * 2, liquidH);
+
+        if (syrup.color) {
+          ctx.fillStyle = syrup.color;
+          ctx.beginPath();
+          ctx.moveTo(cx - s, bottom - syrupH);
+          for (let i = 0; i <= 8; i++) {
+            const x = cx - topW / 2 + (topW / 8) * i;
+            ctx.lineTo(x, bottom - syrupH + Math.sin(i * 1.3) * s * 0.012);
+          }
+          ctx.lineTo(cx + s, bottom - syrupH);
+          ctx.lineTo(cx + s, bottom);
+          ctx.lineTo(cx - s, bottom);
+          ctx.fill();
+        }
+
+        ctx.fillStyle = milk.foam ?? '#c8a27a';
+        ctx.fillRect(cx - s, fillTop, s * 2, foamH);
+
+        // Syrup drizzle on top of the foam
+        if (syrup.color) {
+          ctx.strokeStyle = syrup.color;
+          ctx.lineWidth = s * 0.012;
+          ctx.lineCap = 'round';
+          ctx.beginPath();
+          for (let i = 0; i < 5; i++) {
+            const y = fillTop + foamH * (0.2 + i * 0.15);
+            ctx.moveTo(cx - topW * 0.4, y);
+            ctx.bezierCurveTo(cx - topW * 0.1, y - s * 0.02, cx + topW * 0.1, y + s * 0.02, cx + topW * 0.4, y);
+          }
+          ctx.stroke();
+        }
+
+        // Glass highlight
+        const shine = ctx.createLinearGradient(cx - topW / 2, 0, cx + topW / 2, 0);
+        shine.addColorStop(0, 'rgba(255, 255, 255, 0.35)');
+        shine.addColorStop(0.18, 'rgba(255, 255, 255, 0.05)');
+        shine.addColorStop(0.8, 'rgba(255, 255, 255, 0)');
+        shine.addColorStop(1, 'rgba(255, 255, 255, 0.2)');
+        ctx.fillStyle = shine;
+        ctx.fillRect(cx - s, top, s * 2, cupH);
+        ctx.restore();
+
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.lineWidth = Math.max(2, s * 0.012);
+        ctx.stroke(glass);
+
+        // Name tag on the glass
+        const label = name || 'Your name';
+        const fontSize = Math.round(s * 0.065);
+        ctx.font = `600 ${fontSize}px 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif`;
+        let text = label;
+        const maxTextW = botW * 0.95;
+        while (text.length > 1 && ctx.measureText(text).width > maxTextW) text = text.slice(0, -1);
+        if (text !== label) text = `${text.slice(0, -1)}…`;
+        const tagW = Math.min(maxTextW, ctx.measureText(text).width) + s * 0.08;
+        const tagH = fontSize * 1.7;
+        const tagY = top + cupH * 0.52;
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.92)';
+        roundRectPath(cx - tagW / 2, tagY, tagW, tagH, tagH / 2);
+        ctx.fill();
+        ctx.fillStyle = name ? '#4e342e' : '#a1887f';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(text, cx, tagY + tagH / 2);
+
+        // Steam
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.55)';
+        ctx.lineWidth = s * 0.018;
+        ctx.lineCap = 'round';
+        for (let i = -1; i <= 1; i++) {
+          const x = cx + i * s * 0.12;
+          ctx.beginPath();
+          ctx.moveTo(x, top - s * 0.04);
+          ctx.bezierCurveTo(x - s * 0.05, top - s * 0.1, x + s * 0.05, top - s * 0.14, x, top - s * 0.2);
+          ctx.stroke();
+        }
+      }
+
+      function draw() {
+        if (!layout.width || !canvas.width) return;
+        // Draw in CSS pixels; the backing store is sized in device pixels.
+        const scale = canvas.width / layout.width;
+        ctx.setTransform(scale, 0, 0, scale, 0, 0);
+        ctx.clearRect(0, 0, layout.width, layout.height);
+
+        const bg = ctx.createLinearGradient(0, 0, layout.width, layout.height);
+        bg.addColorStop(0, '#6d4c41');
+        bg.addColorStop(1, '#3e2723');
+        ctx.fillStyle = bg;
+        ctx.fillRect(0, 0, layout.width, layout.height);
+
+        drawCup(getState());
+
+        if (supportsHtmlInCanvas) {
+          // Draws the live form and syncs its hit-testing/a11y geometry to
+          // these coordinates, so the controls stay aligned with their pixels.
+          ctx.drawElementImage(form, layout.formX, layout.formY, form.offsetWidth, form.offsetHeight);
+        }
+      }
+
+      function requestDraw() {
+        if (supportsHtmlInCanvas) canvas.requestPaint();
+        else draw();
+      }
+
+      if (supportsHtmlInCanvas) canvas.onpaint = draw;
+
+      // Match the canvas backing store to device pixels for crisp HiDPI output.
+      const canvasObserver = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        const w = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * devicePixelRatio);
+        const h = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * devicePixelRatio);
+        if (canvas.width !== w) canvas.width = w;
+        if (canvas.height !== h) canvas.height = h;
+        updateLayout();
+        requestDraw();
+      });
+      const supportsDevicePixelContentBox = typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      canvasObserver.observe(canvas, supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {});
+
+      // Re-layout when the form's own size changes (e.g. summary text wraps).
+      new ResizeObserver(() => {
+        updateLayout();
+        requestDraw();
+      }).observe(form);
+
+      form.addEventListener('input', () => {
+        updateSummary();
+        requestDraw();
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const { name } = getState();
+        summary.value = `Added! ${name ? `${name}, your` : 'Your'} cup is on its way to your cart.`;
+        requestDraw();
+      });
+
+      updateSummary();
+      updateLayout();
+      requestDraw();
+    })();
+  </script>
+
