diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -300,7 +300,75 @@
     regenBtn.addEventListener('click', renderCards);
 
 
   </script>
+
+  <!--
+    Core Web Vitals monitoring.
+    Metrics are queued as they change and only sent when the page becomes hidden
+    (tab closed, navigated away, app switched, etc.), which is when web-vitals
+    finalizes CLS/INP/LCP. We deliberately avoid `unload`/`beforeunload`: they are
+    unreliable (especially on mobile) and make the page ineligible for bfcache.
+  -->
+  <script type="module">
+    import { onCLS, onINP, onLCP, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@5?module';
+
+    const ANALYTICS_ENDPOINT = '/path/to/analytics/endpoint';
+
+    // Latest report per metric (keyed by name) waiting to be sent.
+    const queue = new Map();
+
+    function addToQueue(metric) {
+      queue.set(metric.name, {
+        name: metric.name,
+        value: metric.value,
+        delta: metric.delta,
+        rating: metric.rating,
+        id: metric.id, // stable per metric per page load (new id after bfcache restore)
+        navigationType: metric.navigationType,
+      });
+    }
+
+    function flushQueue() {
+      if (queue.size === 0) return;
+
+      const body = JSON.stringify({
+        page: location.href,
+        timestamp: Date.now(),
+        metrics: [...queue.values()],
+      });
+      queue.clear();
+
+      // sendBeacon survives page teardown; fall back to keepalive fetch.
+      const queued = navigator.sendBeacon &&
+        navigator.sendBeacon(ANALYTICS_ENDPOINT, new Blob([body], { type: 'application/json' }));
+      if (!queued) {
+        fetch(ANALYTICS_ENDPOINT, {
+          method: 'POST',
+          body,
+          headers: { 'Content-Type': 'application/json' },
+          keepalive: true,
+        }).catch(() => {});
+      }
+    }
+
+    // Register metric observers first so web-vitals' own "hidden" handlers
+    // (which report the final CLS/INP/LCP values) run before our flush.
+    onCLS(addToQueue);
+    onINP(addToQueue);
+    onLCP(addToQueue);
+    onFCP(addToQueue);
+    onTTFB(addToQueue);
+
+    // `visibilitychange` -> hidden is the last event reliably fired on all
+    // platforms when the user leaves the page. `pagehide` is a bfcache-safe
+    // fallback for older Safari versions. If the user comes back and metrics
+    // change (e.g. more layout shifts), they're re-queued and sent on the next
+    // hide; the backend can dedupe/aggregate using `id` + `delta`.
+    addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'hidden') flushQueue();
+    });
+    addEventListener('pagehide', flushQueue);
+  </script>
 </body>
 
 </html>
