+        y = Math.min(Math.max(EDGE, y), maxY);
+        pos = { x: x, y: y };
+        panel.style.left = x + 'px';
+        panel.style.top = y + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      }
+
+      function clampToViewport() {
+        if (pos) applyPos(pos.x, pos.y);
+      }
+
+      function resetPos() {
+        pos = null;
+        panel.style.left = panel.style.top = panel.style.right = panel.style.bottom = '';
+        try { localStorage.removeItem(POS_KEY); } catch (e) { /* ignore */ }
+      }
+
+      function currentXY() {
+        var r = panel.getBoundingClientRect();
+        return { x: r.left, y: r.top };
+      }
+
+      var drag = null;
+
+      handle.addEventListener('pointerdown', function (e) {
+        if (e.button !== 0) return;
+        // Let the header's action buttons (minimize) work normally; the grip is part of the handle.
+        if (e.target.closest('button') && e.target.closest('button') !== grip) return;
+        var start = currentXY();
+        drag = { id: e.pointerId, dx: e.clientX - start.x, dy: e.clientY - start.y };
+        handle.setPointerCapture(e.pointerId);
+        panel.classList.add('qo-dragging');
+        e.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', function (e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        applyPos(e.clientX - drag.dx, e.clientY - drag.dy);
+      });
+
+      function endDrag(e) {
+        if (!drag || e.pointerId !== drag.id) return;
+        drag = null;
+        panel.classList.remove('qo-dragging');
+        if (handle.hasPointerCapture(e.pointerId)) handle.releasePointerCapture(e.pointerId);
+        if (pos) save(POS_KEY, pos);
+      }
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+      handle.addEventListener('lostpointercapture', endDrag);
+
+      handle.addEventListener('dblclick', function (e) {
+        if (e.target.closest('button') && e.target.closest('button') !== grip) return;
+        resetPos();
+      });
+
+      // Keyboard repositioning via the grip button.
+      grip.addEventListener('keydown', function (e) {
+        var step = e.shiftKey ? 50 : 10;
+        var moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
+        if (e.key === 'Home') {
+          e.preventDefault();
+          resetPos();
+          return;
+        }
+        var m = moves[e.key];
+        if (!m) return;
+        e.preventDefault();
+        var cur = pos || currentXY();
+        applyPos(cur.x + m[0], cur.y + m[1]);
+        save(POS_KEY, pos);
+      });
+
+      window.addEventListener('resize', clampToViewport);
+
+      /* ---------- Init ---------- */
+      updateBuilder();
+      renderCart();
+      setCollapsed(load(COLLAPSE_KEY, false) === true);
+      var savedPos = load(POS_KEY, null);
+      if (savedPos && isFinite(savedPos.x) && isFinite(savedPos.y)) applyPos(Number(savedPos.x), Number(savedPos.y));
+    })();
+  </script>
+
 </body>
 
