+          aria-label="Move quick order panel (use arrow keys)" title="Drag to move, or focus and use arrow keys">&#8942;&#8942;</button>
+        <h2 id="qo-title">Quick Order</h2>
+        <span class="qo-badge" id="qo-count" hidden>0</span>
+        <button type="button" class="qo-icon-btn" id="qo-toggle" hidden aria-expanded="true"
+          aria-controls="qo-body" aria-label="Minimize quick order panel">&minus;</button>
+      </div>
+
+      <div class="qo-body" id="qo-body">
+        <div>
+          <label for="qo-drink">Drink</label>
+          <select id="qo-drink" name="drink">
+            <option value="Maple Oat Latte" data-price="5.25">Maple Oat Latte — $5.25</option>
+            <option value="Dark Roast Espresso" data-price="3.50">Dark Roast Espresso — $3.50</option>
+            <option value="Cold Brew" data-price="4.75">Cold Brew — $4.75</option>
+            <option value="Cappuccino" data-price="4.50">Cappuccino — $4.50</option>
+            <option value="Chai Tea Latte" data-price="4.95">Chai Tea Latte — $4.95</option>
+          </select>
+        </div>
+
+        <fieldset>
+          <legend>Size</legend>
+          <div class="qo-sizes">
+            <label><input type="radio" name="size" value="Small" data-extra="0">Small</label>
+            <label><input type="radio" name="size" value="Medium" data-extra="0.50" checked>Medium</label>
+            <label><input type="radio" name="size" value="Large" data-extra="1.00">Large</label>
+          </div>
+        </fieldset>
+
+        <div class="qo-row">
+          <label for="qo-qty">Quantity</label>
+          <div class="qo-stepper">
+            <button type="button" id="qo-dec" aria-label="Decrease quantity" hidden>&minus;</button>
+            <input type="number" id="qo-qty" name="qty" value="1" min="1" max="10" inputmode="numeric">
+            <button type="button" id="qo-inc" aria-label="Increase quantity" hidden>+</button>
+          </div>
+        </div>
+
+        <label class="qo-check"><input type="checkbox" id="qo-shot" name="extra_shot" value="yes">
+          Extra espresso shot (+$0.75)</label>
+
+        <button type="submit" class="qo-primary" id="qo-add">Order Now</button>
+
+        <div class="qo-cart" id="qo-cart" hidden>
+          <strong>Your Cart</strong>
+          <ul id="qo-items"></ul>
+          <p class="qo-empty" id="qo-empty">Your cart is empty.</p>
+          <div class="qo-row">
+            <span>Total</span>
+            <span class="qo-total" id="qo-total">$0.00</span>
+          </div>
+          <button type="button" class="qo-primary secondary" id="qo-checkout" disabled
+            style="margin-top: 8px;">Checkout</button>
+        </div>
+        <p class="qo-status" id="qo-status" role="status"></p>
+      </div>
+    </form>
