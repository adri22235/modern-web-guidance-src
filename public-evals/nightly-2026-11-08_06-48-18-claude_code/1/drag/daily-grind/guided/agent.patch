+
+  <script>
+    (() => {
+      const panel = document.getElementById('quick-order');
+      const handle = document.getElementById('qo-handle');
+      const grip = document.getElementById('qo-grip');
+      const toggle = document.getElementById('qo-toggle');
+      const form = document.getElementById('qo-form');
+      const drink = document.getElementById('qo-drink');
+      const qty = document.getElementById('qo-qty');
+      const shot = document.getElementById('qo-shot');
+      const addBtn = document.getElementById('qo-add');
+      const cartEl = document.getElementById('qo-cart');
+      const itemsEl = document.getElementById('qo-items');
+      const emptyEl = document.getElementById('qo-empty');
+      const totalEl = document.getElementById('qo-total');
+      const countEl = document.getElementById('qo-count');
+      const checkout = document.getElementById('qo-checkout');
+      const status = document.getElementById('qo-status');
+      const POS_KEY = 'dailyGrind.quickOrder.pos';
+      const CART_KEY = 'dailyGrind.quickOrder.cart';
+      const STEP = 15;
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      // ----- Progressive enhancement: reveal JS-only controls -----
+      panel.classList.add('is-draggable');
+      [grip, toggle, countEl, cartEl, document.getElementById('qo-dec'), document.getElementById('qo-inc')]
+        .forEach((el) => el.hidden = false);
+      addBtn.textContent = 'Add to Cart';
+
+      // ----- Dragging -----
+      let offsetX = 0, offsetY = 0, startX = 0, startY = 0, moved = false;
+      let hasCustomPos = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        const x = Math.max(0, Math.min(left, maxLeft));
+        const y = Math.max(0, Math.min(top, maxTop));
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.style.left = `${x}px`;
+        panel.style.top = `${y}px`;
+        hasCustomPos = true;
+        return { x, y };
+      }
+
+      function savePos() {
+        const rect = panel.getBoundingClientRect();
+        try { localStorage.setItem(POS_KEY, JSON.stringify({ x: rect.left, y: rect.top })); } catch {}
+      }
+
+      function reclamp() {
+        if (!hasCustomPos) return;
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0) return;
+        const interactive = event.target.closest('button, input, select, textarea, a');
+        if (interactive && interactive !== grip) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        moved = false;
+        handle.setPointerCapture(event.pointerId);
+        event.preventDefault();
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!moved && Math.hypot(event.clientX - startX, event.clientY - startY) < 4) return;
+        moved = true;
+        handle.classList.add('dragging');
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+        if (moved) savePos();
+      });
+
+      grip.addEventListener('keydown', (event) => {
+        const deltas = { ArrowLeft: [-STEP, 0], ArrowRight: [STEP, 0], ArrowUp: [0, -STEP], ArrowDown: [0, STEP] };
+        const d = deltas[event.key];
+        if (!d) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + d[0], rect.top + d[1]);
+        savePos();
+      });
+
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+
+      try {
+        const saved = JSON.parse(localStorage.getItem(POS_KEY));
+        if (saved && Number.isFinite(saved.x) && Number.isFinite(saved.y)) moveTo(saved.x, saved.y);
+      } catch {}
+
+      // ----- Collapse / expand -----
+      toggle.addEventListener('click', () => {
+        const collapsed = panel.classList.toggle('collapsed');
+        toggle.setAttribute('aria-expanded', String(!collapsed));
+        toggle.setAttribute('aria-label', `${collapsed ? 'Expand' : 'Minimize'} quick order panel`);
+        toggle.innerHTML = collapsed ? '&#43;' : '&minus;';
+      });
+
+      // ----- Quantity stepper -----
+      const clampQty = (n) => Math.max(1, Math.min(10, Number.isFinite(n) ? Math.round(n) : 1));
+      document.getElementById('qo-dec').addEventListener('click', () => { qty.value = clampQty(+qty.value - 1); });
+      document.getElementById('qo-inc').addEventListener('click', () => { qty.value = clampQty(+qty.value + 1); });
+      qty.addEventListener('change', () => { qty.value = clampQty(+qty.value); });
+
+      // ----- Cart -----
+      let cart = [];
+      try { cart = JSON.parse(localStorage.getItem(CART_KEY)) || []; } catch { cart = []; }
+
+      function renderCart() {
+        itemsEl.replaceChildren(...cart.map((item, i) => {
+          const li = document.createElement('li');
+          const name = document.createElement('span');
+          name.textContent = `${item.qty}× ${item.size} ${item.drink}${item.shot ? ' + shot' : ''}`;
+          const price = document.createElement('span');
+          price.textContent = money.format(item.unit * item.qty);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'qo-remove';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', `Remove ${name.textContent}`);
+          remove.addEventListener('click', () => {
+            cart.splice(i, 1);
+            update(`Removed ${item.drink}.`);
+          });
+          li.append(name, price, remove);
+          return li;
+        }));
+        const count = cart.reduce((n, item) => n + item.qty, 0);
+        const total = cart.reduce((sum, item) => sum + item.unit * item.qty, 0);
+        emptyEl.hidden = cart.length > 0;
+        totalEl.textContent = money.format(total);
+        countEl.textContent = count;
+        countEl.setAttribute('aria-label', `${count} items in cart`);
+        checkout.disabled = cart.length === 0;
+      }
+
+      function update(message) {
+        try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch {}
+        renderCart();
+        status.textContent = message || '';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const option = drink.selectedOptions[0];
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const item = {
+          drink: option.value,
+          size: sizeInput.value,
+          shot: shot.checked,
+          qty: clampQty(+qty.value),
+          unit: +option.dataset.price + +sizeInput.dataset.extra + (shot.checked ? 0.75 : 0),
+        };
+        const existing = cart.find((c) => c.drink === item.drink && c.size === item.size && c.shot === item.shot);
+        if (existing) existing.qty = Math.min(99, existing.qty + item.qty);
+        else cart.push(item);
+        qty.value = 1;
+        shot.checked = false;
+        update(`Added ${item.qty}× ${item.size} ${item.drink}.`);
+      });
+
+      checkout.addEventListener('click', () => {
+        const params = new URLSearchParams({ cart: JSON.stringify(cart) });
+        window.location.href = `/order-online?${params}`;
+      });
+
+      renderCart();
+    })();
+  </script>
+
