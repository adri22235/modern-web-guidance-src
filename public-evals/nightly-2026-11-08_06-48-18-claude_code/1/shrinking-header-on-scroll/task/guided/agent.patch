+  <script>
+    // Fallback for browsers without CSS scroll-driven animations:
+    // scrub the same CSS keyframes from a passive scroll listener.
+    (function () {
+      var supportsSDA = window.CSS && CSS.supports &&
+        CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+      if (supportsSDA) return;
+
+      var root = document.documentElement;
+      var nav = document.querySelector('nav');
+      var logo = nav.querySelector('.logo');
+      var distance = parseFloat(getComputedStyle(root).getPropertyValue('--nav-shrink-distance')) || 120;
+      var ticking = false;
+
+      root.classList.add('js-scroll-fallback');
+
+      function update() {
+        ticking = false;
+        var scrollY = window.pageYOffset || root.scrollTop || 0;
+        var progress = Math.min(1, Math.max(0, scrollY / distance));
+        // A negative delay seeks the paused 1s animation to `progress`
+        var delay = (-progress) + 's';
+        nav.style.animationDelay = delay;
+        logo.style.animationDelay = delay;
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          window.requestAnimationFrame(update);
+        }
+      }
+
+      var passive = false;
+      try {
+        window.addEventListener('test', null, Object.defineProperty({}, 'passive', {
+          get: function () { passive = { passive: true }; }
+        }));
+      } catch (e) { }
+
+      window.addEventListener('scroll', onScroll, passive);
+      window.addEventListener('resize', onScroll, passive);
+      update();
+    })();
+  </script>
