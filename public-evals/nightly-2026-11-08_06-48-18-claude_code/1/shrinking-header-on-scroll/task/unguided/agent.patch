+  <!-- Fallback for browsers without CSS scroll-driven animations:
+       interpolate the same values from window scroll position (ES3-safe). -->
+  <script>
+    (function () {
+      var supportsTimeline = window.CSS && CSS.supports &&
+        CSS.supports('animation-timeline', 'scroll()');
+      if (supportsTimeline) return;
+
+      var nav = document.getElementsByTagName('nav')[0];
+      var logo = nav && nav.querySelector('.logo');
+      if (!nav || !logo) return;
+
+      var rem = parseFloat(window.getComputedStyle(document.documentElement).fontSize) || 16;
+      var DISTANCE = 200;                       // px, matches --shrink-distance
+      var NAV_MAX = 4.5 * rem, NAV_MIN = 3 * rem;
+      var LOGO_MAX = 1.5 * rem, LOGO_MIN = 1.1 * rem;
+      var ticking = false, last = -1;
+
+      var raf = window.requestAnimationFrame ||
+        window.webkitRequestAnimationFrame ||
+        function (cb) { return window.setTimeout(cb, 16); };
+
+      function lerp(a, b, t) { return a + (b - a) * t; }
+
+      function update() {
+        ticking = false;
+        var y = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var t = Math.min(Math.max(y / DISTANCE, 0), 1);
+        if (t === last) return;
+        last = t;
+
+        nav.style.height = lerp(NAV_MAX, NAV_MIN, t) + 'px';
+        nav.style.boxShadow = '0 ' + (2 * t) + 'px ' + (10 * t) + 'px rgba(0,0,0,' + (0.3 * t) + ')';
+        nav.style.backgroundColor = 'rgba(' +
+          Math.round(lerp(78, 62, t)) + ',' +
+          Math.round(lerp(52, 39, t)) + ',' +
+          Math.round(lerp(46, 35, t)) + ',' +
+          lerp(1, 0.96, t) + ')';
+        logo.style.fontSize = lerp(LOGO_MAX, LOGO_MIN, t) + 'px';
+        logo.style.letterSpacing = lerp(1, 0.5, t) + 'px';
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          ticking = true;
+          raf(update);
+        }
+      }
+
+      if (window.addEventListener) {
+        window.addEventListener('scroll', onScroll, false);
+        window.addEventListener('resize', onScroll, false);
+      } else if (window.attachEvent) {
+        window.attachEvent('onscroll', onScroll);
+        window.attachEvent('onresize', onScroll);
+      }
+      update();
+    })();
+  </script>
