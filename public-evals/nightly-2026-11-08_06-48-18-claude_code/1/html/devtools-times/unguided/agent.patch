@@ -1,7 +1,73 @@
 @import "tailwindcss";
+@plugin "@tailwindcss/typography";
 
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* ---------- Native <dialog> overlays ---------- */
+dialog.modal-dialog {
+  margin: 15vh auto auto;
+  padding: 0;
+  border: 0;
+  max-width: min(42rem, calc(100vw - 2rem));
+  width: 100%;
+  max-height: 80vh;
+  overflow: visible;
+  background: white;
+  box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
+}
+
+dialog.modal-dialog::backdrop {
+  background: rgb(255 255 255 / 0.3);
+  backdrop-filter: blur(4px);
+}
+
+/* ---------- Mega menu popover anchored to the section nav ---------- */
+.section-nav {
+  anchor-name: --section-nav;
+}
+
+.flyout-menu[popover] {
+  margin: 0;
+  padding: 0;
+  border: 0;
+  border-bottom: 1px solid var(--color-gray-300);
+  background: white;
+  box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
+  width: min(72rem, 100vw);
+  inset: auto;
+  top: 0;
+  left: 50%;
+  translate: -50% 0;
+}
+
+@supports (anchor-name: --a) {
+  .flyout-menu[popover] {
+    position-anchor: --section-nav;
+    top: anchor(bottom);
+    left: anchor(left);
+    width: anchor-size(width);
+    translate: none;
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  dialog.modal-dialog[open] {
+    animation: dialog-in 150ms ease-out;
+  }
+}
+
+@keyframes dialog-in {
+  from {
+    opacity: 0;
+    transform: translateY(-0.5rem);
+  }
+}
+
+/* Prevent the page behind a modal dialog from scrolling */
+html:has(dialog.modal-dialog:modal) {
+  overflow: hidden;
+}
