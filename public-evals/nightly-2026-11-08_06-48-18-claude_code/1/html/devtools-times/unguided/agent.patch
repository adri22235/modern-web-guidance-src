diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..ebd9a5c
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,73 @@
+import React, { useEffect, useRef } from 'react';
+
+interface Props {
+  open: boolean;
+  onClose: () => void;
+  /** id of the element that labels the dialog (usually its heading). */
+  labelledBy: string;
+  /** Element to focus once the dialog has opened. Defaults to the first focusable element. */
+  initialFocusRef?: React.RefObject<HTMLElement | null>;
+  children: React.ReactNode;
+}
+
+/**
+ * Thin wrapper around the native modal `<dialog>`: the browser provides the
+ * top layer, `::backdrop`, inert background, focus containment and Esc handling.
+ * The element stays mounted so focus can be returned to the invoker on close.
+ */
+export default function ModalDialog({ open, onClose, labelledBy, initialFocusRef, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const returnFocusRef = useRef<HTMLElement | null>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      returnFocusRef.current = document.activeElement as HTMLElement | null;
+      dialog.showModal();
+      initialFocusRef?.current?.focus();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open, initialFocusRef]);
+
+  const handleClose = () => {
+    // Browsers restore focus natively; this covers engines that don't.
+    const target = returnFocusRef.current;
+    if (target?.isConnected && (document.activeElement === document.body || !document.activeElement)) {
+      target.focus();
+    }
+    returnFocusRef.current = null;
+    onClose();
+  };
+
+  // Clicks on the ::backdrop are dispatched to the <dialog> itself.
+  const handleClick = (event: React.MouseEvent<HTMLDialogElement>) => {
+    if (event.target === event.currentTarget) dialogRef.current?.close();
+  };
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby={labelledBy}
+      onClose={handleClose}
+      onClick={handleClick}
+      className="modal-dialog"
+      {...{ closedby: 'any' }}
+    >
+      <div className="relative flex flex-col max-h-[80vh]">
+        <button
+          type="button"
+          onClick={() => dialogRef.current?.close()}
+          aria-label="Close"
+          className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform z-10 focus-visible:outline-2 focus-visible:outline-amber-500"
+        >
+          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+        {children}
+      </div>
+    </dialog>
+  );
+}
