+    /* Seasonal Favorites carousel */
+    .carousel {
+      --item-width: min(280px, 75vw);
+      display: flex;
+      gap: 2rem;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      -webkit-overflow-scrolling: touch;
+      /* Vertical room for the 1.15 scale + shadow; inline padding lets the
+         first and last items reach the center snap point. */
+      padding: 2.5rem calc(50% - var(--item-width) / 2);
+      margin-top: 10px;
+    }
+
+    .carousel:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .carousel-item {
+      flex: 0 0 var(--item-width);
+      scroll-snap-align: center;
+      /* Enables the native scroll-state(snapped) query where supported */
+      container-type: scroll-state;
+    }
+
+    .carousel .card {
+      height: 100%;
+      transition: transform 0.3s ease, background-color 0.3s ease,
+        box-shadow 0.3s ease, color 0.3s ease;
+    }
+
+    .carousel .card h3,
+    .carousel .card p {
+      transition: color 0.3s ease;
+    }
+
+    /* Snapped/centered card. The .is-snapped class is applied by JS as a
+       fallback for browsers without CSS scroll-state queries. */
+    .carousel-item.is-snapped .card {
+      transform: scale(1.15);
+      background-color: #007bff;
+      color: white;
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
+    }
+
+    .carousel-item.is-snapped .card h3 {
+      color: white;
+    }
+
+    @container scroll-state(snapped: x) {
+      .card {
+        transform: scale(1.15);
+        background-color: #007bff;
+        color: white;
+        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
+      }
+
+      .card h3 {
+        color: white;
+      }
+    }
+
+    /* Reduced motion: no scaling, no color change, no transitions. The
+       snapped card keeps only a static shadow as a non-motion indicator. */
+    @media (prefers-reduced-motion: reduce) {
+      .carousel {
+        scroll-behavior: auto;
+      }
+
+      .carousel .card,
+      .carousel .card h3,
+      .carousel .card p {
+        transition: none;
+      }
+
+      .carousel-item.is-snapped .card {
+        transform: none;
+        background-color: #e0e0e0;
+        color: inherit;
+      }
+
+      .carousel-item.is-snapped .card h3 {
+        color: var(--primary);
+      }
+
+      @container scroll-state(snapped: x) {
+        .card {
+          transform: none;
+          background-color: #e0e0e0;
+          color: inherit;
+        }
+
+        .card h3 {
+          color: var(--primary);
+        }
+      }
+    }
