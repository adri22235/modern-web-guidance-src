+  <script>
+    // Fallback for browsers without CSS scroll-state(snapped) queries:
+    // mark the item closest to the carousel's center as snapped.
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+      var items = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-item'));
+      var ticking = false;
+
+      function update() {
+        ticking = false;
+        var rect = carousel.getBoundingClientRect();
+        var center = rect.left + rect.width / 2;
+        var closest = null;
+        var best = Infinity;
+        items.forEach(function (item) {
+          var r = item.getBoundingClientRect();
+          var dist = Math.abs(r.left + r.width / 2 - center);
+          if (dist < best) { best = dist; closest = item; }
+        });
+        items.forEach(function (item) {
+          item.classList.toggle('is-snapped', item === closest);
+        });
+      }
+
+      function schedule() {
+        if (!ticking) { ticking = true; requestAnimationFrame(update); }
+      }
+
+      if ('onscrollsnapchange' in window) {
+        carousel.addEventListener('scrollsnapchange', function (e) {
+          items.forEach(function (item) {
+            item.classList.toggle('is-snapped', item === e.snapTargetInline);
+          });
+        });
+      } else {
+        carousel.addEventListener('scroll', schedule, { passive: true });
+      }
+      window.addEventListener('resize', schedule);
+
+      // Start with the middle item centered.
+      var start = items[Math.floor(items.length / 2)];
+      if (start) {
+        var cRect = carousel.getBoundingClientRect();
+        var sRect = start.getBoundingClientRect();
+        carousel.scrollTo({
+          left: carousel.scrollLeft + (sRect.left + sRect.width / 2) - (cRect.left + cRect.width / 2),
+          behavior: 'instant'
+        });
+      }
+      update();
+    })();
+  </script>
+
