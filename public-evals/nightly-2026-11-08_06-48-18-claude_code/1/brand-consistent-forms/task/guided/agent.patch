+  <script>
+    (() => {
+      const form = document.getElementById('subscription-form');
+      const nameInput = document.getElementById('sub-name');
+      const emailInput = document.getElementById('sub-email');
+      const roast = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('setup-progress-text');
+      const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+      let roastReviewed = false;
+
+      const updateRoast = () => {
+        const label = roastNames[roast.valueAsNumber - 1];
+        roastOutput.value = label;
+        roast.setAttribute('aria-valuetext', label);
+        // Drives the filled track in the no-accent-color fallback
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', `${pct}%`);
+      };
+
+      const updateProgress = () => {
+        const steps = [
+          nameInput.value.trim() !== '',
+          emailInput.value !== '' && emailInput.validity.valid,
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastReviewed,
+        ];
+        const done = steps.filter(Boolean).length;
+        const message = done === steps.length
+          ? 'All steps complete. Ready to subscribe!'
+          : `${done} of ${steps.length} steps complete`;
+        progress.value = done;
+        progress.textContent = message;
+        // Only touch the live region when the status actually changes
+        if (progressText.textContent !== message) progressText.textContent = message;
+      };
+
+      const markRoastReviewed = () => {
+        roastReviewed = true;
+        updateProgress();
+      };
+
+      roast.addEventListener('input', () => {
+        updateRoast();
+        markRoastReviewed();
+      });
+      roast.addEventListener('blur', markRoastReviewed);
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
 </body>
 
