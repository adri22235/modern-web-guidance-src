+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const name = document.getElementById('sub-name');
+      const email = document.getElementById('sub-email');
+      const roast = document.getElementById('sub-roast');
+      const roastOut = document.getElementById('roast-output');
+      const progress = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const progressStatus = document.getElementById('progress-status');
+      const status = document.getElementById('form-status');
+      const roastNames = ['Light', 'Medium-Light', 'Medium', 'Medium-Dark', 'Dark'];
+      let roastChosen = false;
+
+      function updateRoast() {
+        const label = roastNames[roast.value - 1];
+        roastOut.textContent = label;
+        roast.setAttribute('aria-valuetext', label);
+        const pct = ((roast.value - roast.min) / (roast.max - roast.min)) * 100;
+        roast.style.setProperty('--fill', pct + '%');
+      }
+
+      function updateProgress() {
+        const steps = [
+          name.value.trim() !== '',
+          email.value.trim() !== '' && email.checkValidity(),
+          form.querySelector('input[name="frequency"]:checked') !== null,
+          roastChosen
+        ];
+        const done = steps.filter(Boolean).length;
+        const pct = Math.round((done / steps.length) * 100);
+        progress.value = pct;
+        progress.textContent = pct + '%';
+        progressText.textContent = pct + '% complete';
+        const msg = done + ' of ' + steps.length + ' steps complete';
+        if (progressStatus.textContent !== msg) progressStatus.textContent = msg;
+        return done === steps.length;
+      }
+
+      roast.addEventListener('input', function () {
+        roastChosen = true;
+        updateRoast();
+        updateProgress();
+      });
+      form.addEventListener('input', updateProgress);
+      form.addEventListener('change', updateProgress);
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        roastChosen = true; // submitting accepts the current roast setting
+        if (updateProgress()) {
+          status.textContent = 'Thanks, ' + name.value.trim() + '! Your subscription is set up.';
+        } else {
+          status.textContent = 'Please complete your name, a valid email, and a delivery frequency.';
+          const firstInvalid = [name, email].find(function (el) { return !el.value.trim() || !el.checkValidity(); })
+            || form.querySelector('input[name="frequency"]');
+          firstInvalid.focus();
+        }
+      });
+
+      updateRoast();
+      updateProgress();
+    })();
+  </script>
+
 </body>
 
