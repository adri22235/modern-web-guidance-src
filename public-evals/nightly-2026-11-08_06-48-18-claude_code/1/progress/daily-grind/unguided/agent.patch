+    /* Progress Bars */
+    .progress-section {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 24px;
+      margin-bottom: 40px;
+      display: grid;
+      gap: 24px;
+    }
+
+    .progress-section h2 {
+      color: var(--primary);
+      font-size: 1.25rem;
+    }
+
+    .progress-item {
+      display: grid;
+      gap: 8px;
+    }
+
+    .progress-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 12px;
+      flex-wrap: wrap;
+    }
+
+    .progress-label {
+      font-weight: 600;
+      color: var(--text);
+    }
+
+    .progress-value {
+      font-size: 0.9rem;
+      font-variant-numeric: tabular-nums;
+      color: var(--primary);
+    }
+
+    .progress-track {
+      position: relative;
+      height: 14px;
+      background: var(--secondary);
+      border-radius: 999px;
+      overflow: hidden;
+    }
+
+    .progress-fill {
+      height: 100%;
+      width: var(--progress, 0%);
+      background: linear-gradient(90deg, var(--primary), #8d6e63 60%, var(--accent));
+      border-radius: inherit;
+      transition: width 0.6s ease;
+    }
+
+    .progress-track.is-indeterminate .progress-fill {
+      position: absolute;
+      left: 0;
+      width: 35%;
+      background: linear-gradient(90deg, transparent, var(--accent), var(--primary), transparent);
+      animation: progress-indeterminate 1.4s ease-in-out infinite;
+    }
+
+    @keyframes progress-indeterminate {
+      0% { transform: translateX(-100%); }
+      100% { transform: translateX(300%); }
+    }
+
+    .progress-hint {
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-fill {
+        transition: none;
+      }
+
+      .progress-track.is-indeterminate .progress-fill {
+        animation: progress-pulse 2s ease-in-out infinite;
+        width: 100%;
+        transform: none;
+        background: var(--accent);
+      }
+
+      @keyframes progress-pulse {
+        0%, 100% { opacity: 0.35; }
+        50% { opacity: 0.8; }
+      }
+    }
+
