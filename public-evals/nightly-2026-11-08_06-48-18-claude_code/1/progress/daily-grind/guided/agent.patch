+  <script>
+    // Simulated order tracking: indeterminate while confirming, then determinate as it is prepared.
+    (() => {
+      const bar = document.getElementById('order-progress');
+      const step = document.getElementById('order-step');
+      const percent = document.getElementById('order-percent');
+      const status = document.getElementById('order-status');
+      const steps = [
+        { value: 25, label: 'Order received' },
+        { value: 60, label: 'Brewing your drink' },
+        { value: 85, label: 'Adding the finishing touches' },
+        { value: 100, label: 'Ready for pickup!' },
+      ];
+      let i = 0;
+      const advance = () => {
+        const { value, label } = steps[i];
+        bar.value = value;
+        step.textContent = label;
+        percent.textContent = `${value}%`;
+        if (value === 100) status.textContent = 'Your order is ready for pickup.';
+        if (++i < steps.length) setTimeout(advance, 2500);
+      };
+      setTimeout(advance, 3000);
+    })();
+  </script>
+
