+    /* Product carousel */
+    .carousel-section {
+      margin: 60px 0 20px;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .carousel-hint {
+      text-align: center;
+      font-size: 0.9rem;
+      color: #6d4c41;
+      padding: 0 20px;
+    }
+
+    .scroller {
+      --card-width: min(280px, 75vw);
+      list-style: none;
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      overscroll-behavior-x: contain;
+      scroll-snap-type: x mandatory;
+      /* Lets the first and last cards reach the center of the viewport */
+      padding: 40px calc(50% - var(--card-width) / 2);
+      scroll-padding-inline: calc(50% - var(--card-width) / 2);
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .product-card {
+      flex: 0 0 var(--card-width);
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      background: white;
+      border-radius: 12px;
+      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
+      overflow: hidden;
+      text-align: center;
+    }
+
+    .product-card img {
+      display: block;
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      background: var(--secondary);
+    }
+
+    .product-card .card-body {
+      flex: 1;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 16px 20px 20px;
+    }
+
+    .product-card h3 {
+      color: var(--primary);
+      margin-bottom: 6px;
+    }
+
+    .product-card p {
+      flex: 1;
+      font-size: 0.95rem;
+    }
+
+    .product-card .price {
+      flex: 0;
+      font-weight: bold;
+      color: var(--text);
+      margin-top: 10px;
+    }
+
+    .product-card .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @keyframes card-focus-scale {
+      0% {
+        scale: 0.75;
+        opacity: 0.6;
+      }
+
+      50% {
+        scale: 1.08;
+        opacity: 1;
+      }
+
+      100% {
+        scale: 0.75;
+        opacity: 0.6;
+      }
+    }
+
+    /* Scroll-driven scale effect: CSS only, motion opt-in, progressive enhancement */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        .scroller > .product-card {
+          animation: card-focus-scale auto linear both;
+          animation-timeline: view(inline);
+        }
+      }
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      margin: -1px;
+      padding: 0;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
