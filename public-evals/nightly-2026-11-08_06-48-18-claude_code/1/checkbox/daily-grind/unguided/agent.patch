+    /* Drink customization checkboxes */
+    .card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .card .btn {
+      align-self: center;
+      margin-top: auto;
+    }
+
+    .customize {
+      border: 0;
+      margin: 18px 0 20px;
+      padding: 14px 0 0;
+      border-top: 1px dashed var(--secondary);
+      text-align: left;
+      min-width: 0;
+    }
+
+    .customize legend {
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 1.5px;
+      text-transform: uppercase;
+      color: #8d6e63;
+      padding: 0 8px 0 0;
+      margin-bottom: 10px;
+    }
+
+    .option-list {
+      list-style: none;
+      display: grid;
+      gap: 8px;
+    }
+
+    .option {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border: 1.5px solid var(--secondary);
+      border-radius: 10px;
+      background: #fffaf6;
+      cursor: pointer;
+      user-select: none;
+      transition: border-color 0.25s, background-color 0.25s, box-shadow 0.25s, transform 0.15s;
+    }
+
+    .option:hover {
+      border-color: #bcaaa4;
+      background: #fff5ec;
+    }
+
+    .option:active {
+      transform: scale(0.985);
+    }
+
+    /* The native checkbox stays in the DOM, focusable and announced by
+       assistive tech. It is stretched over the whole label (transparent)
+       so clicks, taps, keyboard and form submission all use native behavior. */
+    .option input[type="checkbox"] {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+      margin: 0;
+      opacity: 0;
+      cursor: pointer;
+      z-index: 1;
+    }
+
+    .option-icon {
+      flex: 0 0 auto;
+      display: grid;
+      place-items: center;
+      width: 34px;
+      height: 34px;
+      border-radius: 50%;
+      background: var(--secondary);
+      color: var(--primary);
+      transition: background-color 0.3s, color 0.3s, transform 0.4s cubic-bezier(.34, 1.56, .64, 1);
+    }
+
+    .option-icon svg {
+      width: 18px;
+      height: 18px;
+    }
+
+    .option-text {
+      flex: 1 1 auto;
+      display: flex;
+      flex-direction: column;
+      line-height: 1.25;
+      font-size: 0.92rem;
+      font-weight: 600;
+      color: var(--text);
+    }
+
+    .option-text small {
+      font-weight: 400;
+      font-size: 0.78rem;
+      color: #8d6e63;
+    }
+
+    .option-box {
+      flex: 0 0 auto;
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: 22px;
+      height: 22px;
+      border: 2px solid #a1887f;
+      border-radius: 6px;
+      background: white;
+      transition: background-color 0.25s, border-color 0.25s;
+    }
+
+    .option-box svg {
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: white;
+      stroke-width: 3;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 20;
+      stroke-dashoffset: 20;
+      transition: stroke-dashoffset 0.15s ease-in;
+    }
+
+    /* Checked state */
+    .option:has(input:checked) {
+      border-color: var(--accent);
+      background: #fff3e0;
+      box-shadow: 0 2px 8px rgba(255, 171, 64, 0.25);
+    }
+
+    .option input:checked ~ .option-icon {
+      background: var(--primary);
+      color: var(--accent);
+      transform: rotate(-12deg) scale(1.08);
+    }
+
+    .option input:checked ~ .option-box {
+      background: var(--primary);
+      border-color: var(--primary);
+      animation: box-pop 0.35s cubic-bezier(.34, 1.56, .64, 1);
+    }
+
+    .option input:checked ~ .option-box svg {
+      stroke-dashoffset: 0;
+      transition: stroke-dashoffset 0.3s ease-out 0.08s;
+    }
+
+    @keyframes box-pop {
+      0% { transform: scale(0.7); }
+      60% { transform: scale(1.18); }
+      100% { transform: scale(1); }
+    }
+
+    /* Keyboard focus ring, driven by the native input's focus */
+    .option:has(input:focus-visible) {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Fallback for browsers without :has() */
+    .option input:focus-visible ~ .option-box {
+      box-shadow: 0 0 0 3px var(--accent);
+    }
+
+    .option input:disabled,
+    .option:has(input:disabled) {
+      cursor: not-allowed;
+      opacity: 0.55;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .option,
+      .option-icon,
+      .option-box,
+      .option-box svg {
+        transition: none;
+        animation: none !important;
+      }
+
+      .option input:checked ~ .option-icon {
+        transform: none;
+      }
+    }
+
+    /* Windows High Contrast / forced colors: make state visible with system colors */
+    @media (forced-colors: active) {
+      .option-box {
+        border-color: CanvasText;
+      }
+
+      .option input:checked ~ .option-box {
+        background: Highlight;
+        border-color: Highlight;
+      }
+
+      .option-box svg {
+        stroke: HighlightText;
+      }
+
+      .option:has(input:focus-visible) {
+        outline-color: Highlight;
+      }
+    }
+
