+      gap: 0.65rem;
+      min-block-size: 44px;
+      padding: 0.25rem 0.5rem;
+      margin-inline: -0.5rem;
+      border-radius: 6px;
+      cursor: pointer;
+      transition: background-color 0.2s ease;
+
+      &:hover {
+        background-color: var(--crema);
+      }
+
+      &:has(:checked) {
+        background-color: var(--crema);
+        font-weight: 600;
+      }
+
+      &:has(:disabled) {
+        cursor: not-allowed;
+      }
+    }
+
+    .option-icon {
+      inline-size: 1.25rem;
