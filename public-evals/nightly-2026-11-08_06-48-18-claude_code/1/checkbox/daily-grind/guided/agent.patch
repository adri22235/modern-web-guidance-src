+      transition: color 0.2s ease, rotate 0.3s ease;
+    }
+
+    .option:has(:checked) .option-icon {
+      color: var(--primary);
+    }
+
+    .option-price {
+      margin-inline-start: auto;
+      font-size: 0.8rem;
+      color: #6d4c41;
+      font-variant-numeric: tabular-nums;
+    }
+
+    .grind-check {
+      --checkbox-size: 1.3em;
+      --checkbox-icon-size: 0.75em;
+
+      appearance: none;
+      display: inline-grid;
+      place-content: center;
+      flex-shrink: 0;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      margin: 0;
+      border: 2px solid #795548;
+      border-radius: 6px 6px 8px 8px; /* subtle cup-like profile */
+      background-color: white;
+      color: var(--accent);
+      cursor: pointer;
+      font: inherit;
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--checkbox-icon, var(--icon-check)) no-repeat center / contain;
+        scale: 0;
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:is(:checked, :indeterminate) {
+        background-color: var(--primary);
+        border-color: var(--primary);
+      }
+
+      &:checked {
+        --checkbox-icon: var(--icon-check);
+      }
+
+      &:indeterminate {
+        --checkbox-icon: var(--icon-dash);
+      }
+
+      &:is(:checked, :indeterminate)::before {
+        scale: 1;
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--primary);
+        outline-offset: 2px;
+      }
+
+      &:disabled {
+        cursor: not-allowed;
+        opacity: 0.5;
+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 0.2s ease, border-color 0.2s ease;
+
+        &::before {
+          transition: scale 150ms ease-in;
+        }
+
+        &:checked {
+          animation: grind-pour 350ms ease-out;
+        }
+
+        &:is(:checked, :indeterminate)::before {
+          transition: scale 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .option:has(:checked) .option-icon {
+        rotate: -12deg;
+      }
+    }
+
+    @keyframes grind-pour {
+      0% {
+        box-shadow: 0 0 0 0 rgba(255, 171, 64, 0.7);
+        scale: 0.85;
+      }
+
+      60% {
+        scale: 1.1;
+      }
+
+      100% {
+        box-shadow: 0 0 0 8px rgba(255, 171, 64, 0);
+        scale: 1;
+      }
+    }
+
+    .customize .btn {
+      align-self: center;
+      margin-top: auto;
+      border: 0;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      gap: 10px;
+      flex-wrap: wrap;
+    }
+
+    .btn-outline {
+      background: transparent;
+      color: var(--primary);
+      box-shadow: inset 0 0 0 2px var(--primary);
+    }
+
+    .btn-outline:hover {
+      background: var(--secondary);
+    }
+
+    .btn:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
