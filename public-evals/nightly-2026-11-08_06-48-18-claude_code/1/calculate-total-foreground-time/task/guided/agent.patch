+  <script>
+    // Foreground-time tracking: measures how long the page was actually visible,
+    // excluding time spent in a background tab or minimized window.
+    (() => {
+      const supportsVisibilityEntries =
+        'VisibilityStateEntry' in window &&
+        performance.getEntriesByType('visibility-state').length > 0;
+
+      // Fallback for browsers without VisibilityStateEntry (Firefox, Safari):
+      // accumulate visible time manually via visibilitychange. This script is
+      // inline and runs during initial parse, so treating time 0 as the start
+      // of the first visible period is a close approximation.
+      let fallbackAccumulated = 0;
+      let fallbackVisibleSince = document.visibilityState === 'visible' ? 0 : null;
+
+      if (!supportsVisibilityEntries) {
+        document.addEventListener('visibilitychange', () => {
+          const now = performance.now();
+          if (document.visibilityState === 'hidden') {
+            if (fallbackVisibleSince !== null) {
+              fallbackAccumulated += now - fallbackVisibleSince;
+              fallbackVisibleSince = null;
+            }
+          } else if (fallbackVisibleSince === null) {
+            fallbackVisibleSince = now;
+          }
+        });
+      }
+
+      /**
+       * Calculates the total time the page has been in the foreground (visible).
+       * Safe to call at any time, e.g. on `visibilitychange` → hidden to report it.
+       *
+       * @returns {number} Total foreground time in milliseconds.
+       */
+      function getTotalForegroundTime() {
+        const now = performance.now();
+
+        if (!supportsVisibilityEntries) {
+          return fallbackAccumulated +
+            (fallbackVisibleSince !== null ? now - fallbackVisibleSince : 0);
+        }
+
+        // The browser records every visibility change on the performance
+        // timeline with a precise timestamp, regardless of when this runs.
+        const entries = performance.getEntriesByType('visibility-state');
+        let total = 0;
+
+        for (let i = 0; i < entries.length; i++) {
+          if (entries[i].name !== 'visible') continue;
+          const start = entries[i].startTime;
+          const end = i + 1 < entries.length ? entries[i + 1].startTime : now;
+          total += end - start;
+        }
+
+        return total;
+      }
+
+      window.getTotalForegroundTime = getTotalForegroundTime;
+    })();
+  </script>
+
