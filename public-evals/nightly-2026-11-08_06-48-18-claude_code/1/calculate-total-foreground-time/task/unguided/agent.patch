+  <script>
+    /**
+     * Foreground time tracking.
+     *
+     * Counts only the time the page is actually visible to the user
+     * (document.visibilityState === 'visible'). Time spent in a background
+     * tab, a minimized window, or a locked screen is excluded.
+     * Uses performance.now() so wall-clock changes don't skew the result.
+     */
+    (function () {
+      // Set to a URL to report the total when the user leaves the page
+      // (sent with navigator.sendBeacon). Leave null to disable reporting.
+      var REPORT_ENDPOINT = null;
+
+      var accumulatedMs = 0;
+      var visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+      function onVisibilityChange() {
+        var now = performance.now();
+        if (document.visibilityState === 'visible') {
+          if (visibleSince === null) visibleSince = now;
+        } else if (visibleSince !== null) {
+          accumulatedMs += now - visibleSince;
+          visibleSince = null;
+        }
+      }
+
+      /**
+       * Returns the total time (in milliseconds) the page has been in the
+       * foreground so far, including the current visible stretch, if any.
+       */
+      function getForegroundTime() {
+        var current = visibleSince !== null ? performance.now() - visibleSince : 0;
+        return Math.round(accumulatedMs + current);
+      }
+
+      function report() {
+        if (!REPORT_ENDPOINT || !navigator.sendBeacon) return;
+        navigator.sendBeacon(REPORT_ENDPOINT, JSON.stringify({
+          page: location.pathname,
+          foregroundMs: getForegroundTime()
+        }));
+      }
+
+      document.addEventListener('visibilitychange', onVisibilityChange);
+
+      // pagehide fires reliably on navigation, tab close, and bfcache entry.
+      window.addEventListener('pagehide', report);
+
+      // Restored from the back/forward cache: start a fresh session.
+      window.addEventListener('pageshow', function (e) {
+        if (e.persisted) {
+          accumulatedMs = 0;
+          visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+        }
+      });
+
+      window.getForegroundTime = getForegroundTime;
+    })();
+  </script>
+
 </body>
 
