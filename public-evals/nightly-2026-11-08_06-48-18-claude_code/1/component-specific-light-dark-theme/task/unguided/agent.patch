+  <script>
+    (function () {
+      var root = document.documentElement;
+      var btn = document.getElementById('theme-toggle');
+      var mq = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function current() {
+        return root.getAttribute('data-theme') || (mq.matches ? 'dark' : 'light');
+      }
+
+      function render() {
+        var next = current() === 'dark' ? 'light' : 'dark';
+        btn.textContent = next === 'dark' ? '\u263E Dark' : '\u2600 Light';
+        btn.setAttribute('aria-label', 'Switch to ' + next + ' theme');
+      }
+
+      btn.addEventListener('click', function () {
+        var next = current() === 'dark' ? 'light' : 'dark';
+        // Picking the theme the OS already prefers clears the override so the
+        // page keeps responding to future OS changes.
+        if ((next === 'dark') === mq.matches) {
+          root.removeAttribute('data-theme');
+          try { localStorage.removeItem('theme'); } catch (e) {}
+        } else {
+          root.setAttribute('data-theme', next);
+          try { localStorage.setItem('theme', next); } catch (e) {}
+        }
+        render();
+      });
+
+      mq.addEventListener('change', render);
+      render();
+    })();
+  </script>
+
