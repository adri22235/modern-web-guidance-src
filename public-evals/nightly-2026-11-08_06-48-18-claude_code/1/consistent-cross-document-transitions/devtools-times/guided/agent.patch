-    <ClientRouter />
+    <!--
+      Cross-document view transitions: hold the first render of the new page
+      until the masthead and lead story have been parsed (but not the footer),
+      so the transition never animates to a blank or half-built page.
+      Stylesheets above (global CSS + brand font) are render-blocking already.
+    -->
+    {expectIds.map((id) => (
+      <link rel="expect" href={`#${id}`} blocking="render" />
+    ))}
+
+    <!--
+      Initial layout script: render-blocking so the pagereveal listener is
+      registered before the first frame. The masthead only gets a
+      view-transition-name while a transition runs, so it doesn't create a
+      permanent stacking context that would trap header flyouts/overlays.
+    -->
+    <script is:inline blocking="render">
+      (() => {
+        const NAME = "masthead";
+        const masthead = () => document.getElementById(NAME);
+        const clear = () => {
+          const el = masthead();
+          if (el) el.style.viewTransitionName = "";
+        };
+        // Outgoing page: name the masthead right before the snapshot.
+        window.addEventListener("pageswap", (e) => {
+          const el = masthead();
+          if (e.viewTransition && el) el.style.viewTransitionName = NAME;
+        });
+        // Restored from bfcache: drop the stale name.
+        window.addEventListener("pageshow", (e) => {
+          if (e.persisted) clear();
+        });
+        // Incoming page: name the masthead for the transition, then clean up.
+        window.addEventListener("pagereveal", async (e) => {
+          const vt = e.viewTransition;
+          const el = masthead();
+          if (!vt || !el) return;
+          el.style.viewTransitionName = NAME;
+          try {
+            await vt.finished;
+          } finally {
+            clear();
+          }
+        });
+      })();
+    </script>
   </head>
