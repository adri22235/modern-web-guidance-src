+}
+/* Cross-document view transitions (MPA page navigations) */
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+/* Masthead stays anchored; only the page content below it transitions. */
+::view-transition-group(masthead) {
+  animation-duration: 0.25s;
+}
+
+::view-transition-old(root) {
+  animation: 0.18s ease-in both page-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 0.3s ease-out 0.06s both page-fade-in;
+}
+
+@keyframes page-fade-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes page-fade-in {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+}
