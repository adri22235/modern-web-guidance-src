+/* ---------- Cross-document page transitions ---------- */
+@view-transition {
+  navigation: auto;
+}
+
+/* Keep the masthead pinned while the page content cross-fades / slides. */
+#masthead {
+  view-transition-name: masthead;
+}
+
+::view-transition-group(masthead) {
+  animation-duration: 0s;
+}
+
+::view-transition-old(root) {
+  animation: 180ms ease-in both vt-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 320ms cubic-bezier(0.2, 0.7, 0.2, 1) 60ms both vt-fade-in;
+}
+
+@keyframes vt-fade-out {
+  to { opacity: 0; }
+}
+
+@keyframes vt-fade-in {
+  from { opacity: 0; transform: translateY(12px); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
