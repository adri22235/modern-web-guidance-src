+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+
+  <!-- Header/layout styles: render-blocking, so they are applied before the
+       incoming page is revealed by the view transition. -->
+  <link rel="stylesheet" href="/assets/site.css">
+
+  <!-- Initial theme + transition hooks: synchronous so they run before first
+       render (and before the new-page snapshot). -->
+  <script src="/assets/head.js"></script>
+
+  <!-- Hold the first render (and the transition's new snapshot) until the
+       above-the-fold content has been parsed. The footer is after this point,
+       so the transition does not wait on it. -->
+  <link rel="expect" href="#menu-coffee" blocking="render">
+
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+  <style>.hero { --hero-image: url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80'); }</style>
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" onclick="dgToggleTheme()" aria-label="Toggle dark mode">&#9680;</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--short">
+    <h1>Our Menu</h1>
+    <p>Small-batch roasts, handcrafted drinks, and fresh-baked bites.</p>
+  </header>
+
+  <main class="container">
+    <section id="menu-coffee">
+      <h2 class="section-title">Coffee &amp; Espresso</h2>
+      <div class="grid">
+      <div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <p class="price">$5.75</p>
+      </div>
+      <div class="card">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <p class="price">$3.25</p>
+      </div>
+      <div class="card">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <p class="price">$4.50</p>
+      </div>
+      <div class="card">
+        <h3>House Drip</h3>
+        <p>Our rotating single-origin, brewed fresh every 30 minutes.</p>
+        <p class="price">$2.95</p>
+      </div>
+      </div>
+    </section>
