+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- Header/layout styles: render-blocking, so they are applied before the
+       incoming page is revealed by the view transition. -->
+  <link rel="stylesheet" href="/assets/site.css">
+
+  <!-- Initial theme + transition hooks: synchronous so they run before first
+       render (and before the new-page snapshot). -->
+  <script src="/assets/head.js"></script>
+
+  <!-- Hold the first render (and the transition's new snapshot) until the
+       above-the-fold content has been parsed. The footer is after this point,
+       so the transition does not wait on it. -->
+  <link rel="expect" href="#locations-list" blocking="render">
+
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+  <style>.hero { --hero-image: url('https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80'); }</style>
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+      <li><button type="button" class="theme-toggle" onclick="dgToggleTheme()" aria-label="Toggle dark mode">&#9680;</button></li>
+    </ul>
+  </nav>
+
+  <header class="hero hero--short">
+    <h1>Find a Café</h1>
+    <p>Pull up a chair at one of our neighborhood shops.</p>
+  </header>
+
+  <main class="container">
+    <section id="locations-list">
+      <h2 class="section-title">Our Cafés</h2>
+      <div class="grid">
+      <div class="card">
+        <h3>Downtown</h3>
+        <p>214 Main Street<br>Mon&ndash;Fri 6am&ndash;7pm &middot; Sat&ndash;Sun 7am&ndash;6pm</p>
+      </div>
+      <div class="card">
+        <h3>Riverside</h3>
+        <p>88 Water Lane<br>Daily 6:30am&ndash;5pm</p>
+      </div>
+      <div class="card">
+        <h3>University District</h3>
+        <p>1520 College Ave<br>Daily 6am&ndash;10pm</p>
+      </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
