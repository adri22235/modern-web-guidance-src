diff --git a/assets/head.js b/assets/head.js
new file mode 100644
index 0000000..3a63cb0
--- /dev/null
+++ b/assets/head.js
@@ -0,0 +1,58 @@
+// Loaded synchronously in <head> so it runs before first paint — and therefore
+// before the incoming page's view-transition snapshot is taken.
+(function () {
+  var root = document.documentElement;
+
+  // Initial theme: saved preference, else OS preference. Applying it here
+  // avoids a light→dark flash inside the transition.
+  var theme;
+  try { theme = localStorage.getItem('dg-theme'); } catch (e) {}
+  if (theme !== 'light' && theme !== 'dark') {
+    theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+  }
+  root.dataset.theme = theme;
+
+  window.dgToggleTheme = function () {
+    var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
+    root.dataset.theme = next;
+    try { localStorage.setItem('dg-theme', next); } catch (e) {}
+  };
+
+  // Mark the current nav link. Runs on `pagereveal` (fires right before the
+  // first render, after the render-blocking content has been parsed) with a
+  // DOMContentLoaded fallback for browsers without it.
+  function markCurrentNav() {
+    var path = location.pathname.replace(/\/index\.html$/, '/').replace(/\/+$/, '') || '/';
+    document.querySelectorAll('nav a[href]').forEach(function (a) {
+      var href = a.getAttribute('href').replace(/\/+$/, '') || '/';
+      if (href === path) a.setAttribute('aria-current', 'page');
+    });
+  }
+  window.addEventListener('pagereveal', markCurrentNav);
+  document.addEventListener('DOMContentLoaded', markCurrentNav);
+
+  // Direction-aware transitions: back/forward traversal to an earlier entry
+  // slides the content the other way.
+  function directionFor(activation) {
+    if (!activation || !activation.from || !activation.entry) return 'forward';
+    if (activation.navigationType === 'traverse' &&
+        activation.entry.index < activation.from.index) return 'backward';
+    return 'forward';
+  }
+
+  // Skip the transition for links that aren't content pages (e.g. logout).
+  window.addEventListener('pageswap', function (e) {
+    if (!e.viewTransition) return;
+    var dest = e.activation && e.activation.entry && e.activation.entry.url;
+    if (dest && /\/logout(\/|$)/.test(new URL(dest).pathname)) {
+      e.viewTransition.skipTransition();
+      return;
+    }
+    e.viewTransition.types.add(directionFor(e.activation));
+  });
+
+  window.addEventListener('pagereveal', function (e) {
+    if (!e.viewTransition || !window.navigation) return;
+    e.viewTransition.types.add(directionFor(navigation.activation));
+  });
+})();
diff --git a/assets/site.css b/assets/site.css
new file mode 100644
index 0000000..67d5708
--- /dev/null
+++ b/assets/site.css
@@ -0,0 +1,273 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --surface: #ffffff;
+  --heading: var(--primary);
+  color-scheme: light;
+}
+
+:root[data-theme="dark"] {
+  --primary: #2b1d19;
+  --secondary: #3a2c27;
+  --text: #efe6e2;
+  --light: #1b1412;
+  --surface: #2a201c;
+  --heading: #ffcc80;
+  color-scheme: dark;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  align-items: center;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover,
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+.theme-toggle {
+  background: none;
+  border: 1px solid rgba(255, 255, 255, 0.4);
+  color: white;
+  border-radius: 4px;
+  padding: 4px 8px;
+  cursor: pointer;
+  font: inherit;
+  font-size: 0.85rem;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    var(--hero-image) center / cover no-repeat, #3e2723;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero--short {
+  height: 40vh;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: var(--surface);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--heading);
+}
+
+.price {
+  font-weight: bold;
+  color: var(--heading);
+  margin-top: 8px;
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* ---------- Cross-document page transitions ---------- */
+
+/* Opt both the outgoing and incoming same-origin documents in. */
+@view-transition {
+  navigation: auto;
+}
+
+/* The nav is identical on every page: give it its own group so it stays put
+   while the page content underneath animates. */
+nav {
+  view-transition-name: site-nav;
+}
+
+.hero {
+  view-transition-name: hero;
+}
+
+main {
+  view-transition-name: page-content;
+}
+
+::view-transition-group(site-nav) {
+  animation: none;
+}
+
+::view-transition-old(hero),
+::view-transition-new(hero) {
+  animation-duration: 0.4s;
+  height: 100%;
+  object-fit: cover;
+}
+
+@keyframes vt-fade-out {
+  to { opacity: 0; }
+}
+
+@keyframes vt-fade-in {
+  from { opacity: 0; }
+}
+
+@keyframes vt-slide-out-left {
+  to { transform: translateX(-40px); }
+}
+
+@keyframes vt-slide-in-right {
+  from { transform: translateX(40px); }
+}
+
+@keyframes vt-slide-out-right {
+  to { transform: translateX(40px); }
+}
+
+@keyframes vt-slide-in-left {
+  from { transform: translateX(-40px); }
+}
+
+::view-transition-old(page-content) {
+  animation: 0.2s ease-in both vt-fade-out, 0.35s ease-in both vt-slide-out-left;
+}
+
+::view-transition-new(page-content) {
+  animation: 0.3s ease-out 0.1s both vt-fade-in, 0.35s ease-out both vt-slide-in-right;
+}
+
+/* Back/forward navigation slides the other way (type set in assets/head.js). */
+html:active-view-transition-type(backward)::view-transition-old(page-content) {
+  animation-name: vt-fade-out, vt-slide-out-right;
+}
+
+html:active-view-transition-type(backward)::view-transition-new(page-content) {
+  animation-name: vt-fade-in, vt-slide-in-left;
+}
+
+/* Root (footer etc.) just crossfades quickly. */
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation-duration: 0.25s;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
