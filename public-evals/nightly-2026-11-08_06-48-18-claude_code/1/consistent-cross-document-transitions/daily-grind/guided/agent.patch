+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <span class="price">$3.25</span>
+        </div>
+        <div class="card" id="cold-brew">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <span class="price">$4.50</span>
+        </div>
+        <div class="card" id="cappuccino">
+          <h3>Classic Cappuccino</h3>
+          <p>Equal parts espresso, steamed milk, and velvety foam.</p>
+          <span class="price">$4.75</span>
+        </div>
+        <div class="card" id="pour-over">
+          <h3>Single-Origin Pour Over</h3>
+          <p>Rotating beans, brewed by hand one cup at a time.</p>
+          <span class="price">$5.00</span>
+        </div>
+        <div class="card" id="chai-latte">
+          <h3>Spiced Chai Latte</h3>
+          <p>House-made chai concentrate with steamed milk.</p>
+          <span class="price">$5.25</span>
+        </div>
+      </div>
+    </section>
+
+    <section aria-labelledby="bakery-heading" class="menu-section">
+      <h2 id="bakery-heading" class="section-title">Bakery</h2>
+      <div class="grid">
+        <div class="card" id="croissant">
+          <h3>Butter Croissant</h3>
+          <p>Flaky, golden, and baked fresh every morning.</p>
+          <span class="price">$3.50</span>
+        </div>
+        <div class="card" id="muffin">
+          <h3>Blueberry Muffin</h3>
+          <p>Bursting with wild blueberries and a crumb top.</p>
+          <span class="price">$3.25</span>
