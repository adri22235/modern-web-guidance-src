+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="description" content="Find a Daily Grind coffee shop near you.">
+  <title>Locations | The Daily Grind</title>
+
+  <!-- Header and page styling: render-blocking because it is a <link rel=stylesheet> in <head> -->
+  <link rel="stylesheet" href="/css/styles.css">
+
+  <!-- Theme script must run before the first paint / view transition snapshot -->
+  <script async blocking="render" src="/js/theme.js"></script>
+
+  <!-- Hero background is above the fold: fetch it early so the incoming snapshot isn't empty -->
+  <link rel="preload" as="image" href="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=1350&q=80" fetchpriority="high">
+
+  <!-- Hold the first render (and the view transition) until above-the-fold content is parsed.
+       The footer is deliberately NOT blocked on. -->
+  <link rel="expect" href="#location-list" blocking="render">
+</head>
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <div class="nav-right">
+      <ul>
+        <li><a href="/menu/">Menu</a></li>
+        <li><a href="/locations/" aria-current="page">Locations</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+        <li><a href="/account">My Account</a></li>
+        <li><a href="/logout" class="logout-link">Logout</a></li>
+      </ul>
+      <button type="button" class="theme-toggle" aria-pressed="false">Dark mode</button>
+    </div>
+  </nav>
+
+  <header class="hero hero--short hero--locations" id="hero">
+    <h1>Find Your Grind</h1>
+    <p>Neighborhood cafés with fresh roasts and friendly faces.</p>
+  </header>
+
+  <main class="container">
+    <section id="location-list" aria-labelledby="locations-heading">
+      <h2 id="locations-heading" class="section-title">Our Cafés</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Downtown</h3>
+          <address>120 Main Street<br>Springfield</address>
+          <p>Mon–Fri 6am–7pm · Sat–Sun 7am–6pm</p>
+        </div>
+        <div class="card">
+          <h3>Riverside</h3>
+          <address>48 River Road<br>Springfield</address>
+          <p>Daily 6:30am–8pm</p>
+        </div>
+        <div class="card">
+          <h3>University District</h3>
+          <address>901 College Ave<br>Springfield</address>
+          <p>Mon–Fri 6am–10pm · Sat–Sun 8am–8pm</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
