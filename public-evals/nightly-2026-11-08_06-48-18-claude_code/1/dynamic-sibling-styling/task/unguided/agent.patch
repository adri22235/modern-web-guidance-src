+
+  <script>
+    // Fallback for browsers without CSS sibling-index()/sibling-count():
+    // sets --i/--n on each item and re-syncs whenever items are added/removed.
+    (() => {
+      if (CSS.supports('z-index', 'sibling-index()')) return;
+      const selector = '.spectrum-card, .fan-card, .circle-orb';
+      const sync = () => {
+        document.querySelectorAll(selector).forEach((el) => {
+          const siblings = [...el.parentElement.children];
+          el.style.setProperty('--i', siblings.indexOf(el) + 1);
+          el.style.setProperty('--n', siblings.length);
+        });
+      };
+      sync();
+      new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
+    })();
+  </script>
