+    /* ===== Dynamic sibling-aware layouts =====
+       --i = 1-based position among siblings, --n = number of siblings.
+       Native: sibling-index()/sibling-count(). Older browsers: a tiny script
+       at the end of <body> fills the same variables and keeps them in sync. */
+    .spectrum-card,
+    .fan-card,
+    .circle-orb {
+      --i: 1;
+      --n: 1;
+    }
+
+    @supports (z-index: sibling-index()) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
