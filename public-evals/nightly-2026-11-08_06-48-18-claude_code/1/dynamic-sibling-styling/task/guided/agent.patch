+  <script>
+    /* Fallback for browsers without sibling-index()/sibling-count():
+       inject 1-based --sibling-index / --sibling-count, and keep them in sync
+       when items are added or removed. */
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const SELECTOR = '.spectrum-card, .fan-card, .circle-orb';
+      const update = () => {
+        document.querySelectorAll(SELECTOR).forEach((item) => {
+          const siblings = [...item.parentElement.children];
+          item.style.setProperty('--sibling-index', siblings.indexOf(item) + 1);
+          item.style.setProperty('--sibling-count', siblings.length);
+        });
+      };
+      update();
+      new MutationObserver(update).observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
+
