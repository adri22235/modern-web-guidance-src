+    /* ---------- Dynamic sibling-based styling ----------
+       --index / --count come from the JS fallback (inline custom properties)
+       and are overridden by native sibling-index()/sibling-count() when supported. */
+    .spectrum-card,
+    .fan-card,
+    .circle-orb {
+      --index: var(--sibling-index, 1);
+      --count: var(--sibling-count, 1);
+    }
+
+    @supports (top: calc(sibling-index() * 1px)) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
+        --index: sibling-index();
+        --count: sibling-count();
+      }
+    }
+
+    /* Spectrum: hues spread evenly across the wheel, light tones keep text readable */
+    .spectrum-card {
+      --hue: calc(360 / var(--count) * (var(--index) - 1) + 20);
+      background: oklch(92% 0.07 var(--hue));
+      border-top: 6px solid oklch(62% 0.14 var(--hue));
+    }
+
+    .section-title {
+      text-align: center;
+      margin-top: 60px;
+    }
+
+    .section-lead {
+      text-align: center;
+      color: #6d4c41;
+    }
+
+    /* Fan: every card shares one grid cell and rotates around a pivot below it */
+    .fan-container {
+      --fan-step: 12deg;
+      display: grid;
+      place-items: end center;
+      min-height: 340px;
+      padding-block: 30px;
+    }
+
+    .fan-card {
+      --center: calc((var(--count) + 1) / 2);
+      --offset: calc(var(--index) - var(--center));
+      grid-area: 1 / 1;
+      width: 160px;
+      aspect-ratio: 5 / 7;
+      padding: 16px;
+      border-radius: 12px;
+      color: white;
+      background: linear-gradient(160deg,
+          oklch(48% 0.09 calc(40 + var(--offset) * 8)),
+          oklch(30% 0.05 calc(40 + var(--offset) * 8)));
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      transform-origin: 50% 160%;
+      transform: rotate(calc(var(--fan-step) * var(--offset)));
+      transition: transform 0.3s ease, translate 0.3s ease;
+    }
+
+    .fan-card:hover,
+    .fan-card:focus-visible {
+      translate: 0 -20px;
+      z-index: 1;
+    }
+
+    .fan-card .tier {
+      font-size: 0.75rem;
+      letter-spacing: 2px;
+      text-transform: uppercase;
+      color: var(--accent);
+    }
+
+    .fan-card .stamps {
+      font-size: 1.4rem;
+      letter-spacing: 2px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .fan-card {
+        transition: none;
+      }
+    }
+
+    /* Circle: orbs share one grid cell and are pushed out along cos/sin of their angle */
+    .circle-container {
+      --radius: 150px;
+      --orb-size: 96px;
+      display: grid;
+      place-items: center;
+      width: calc(var(--radius) * 2 + var(--orb-size));
+      aspect-ratio: 1;
+      margin: 30px auto;
+      border-radius: 50%;
+      background: radial-gradient(circle, var(--secondary) 0 30%, transparent 31%);
+    }
+
+    .circle-orb {
+      /* Start at 12 o'clock and go clockwise */
+      --angle: calc(360deg / var(--count) * (var(--index) - 1) - 90deg);
+      grid-area: 1 / 1;
+      width: var(--orb-size);
+      aspect-ratio: 1;
+      border-radius: 50%;
+      display: grid;
+      place-content: center;
+      text-align: center;
+      font-size: 0.8rem;
+      font-weight: bold;
+      line-height: 1.2;
+      color: var(--text);
+      background: oklch(85% 0.09 calc(360 / var(--count) * (var(--index) - 1) + 30));
+      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
+      transform: translate(calc(cos(var(--angle)) * var(--radius)),
+          calc(sin(var(--angle)) * var(--radius)));
+    }
+
+    .circle-orb span {
+      display: block;
+      font-size: 1.4rem;
+    }
+
+    @media (max-width: 480px) {
+      .circle-container {
+        --radius: 110px;
+        --orb-size: 80px;
+      }
+    }
