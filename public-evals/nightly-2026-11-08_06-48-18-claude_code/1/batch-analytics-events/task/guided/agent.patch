diff --git a/analytics.js b/analytics.js
new file mode 100644
--- a/analytics.js
+++ b/analytics.js
@@ -0,0 +1,178 @@
+/**
+ * Daily Grind client-side analytics.
+ *
+ * Records page views and click interactions, then debounces/batches every
+ * event that occurs within BATCH_WINDOW into a single deferred background
+ * request via fetchLater(). Each new event aborts the pending request and
+ * reschedules one containing the full queue, so rapid interactions coalesce
+ * into one beacon. The browser still delivers the latest batch if the user
+ * leaves before the window expires.
+ */
+(() => {
+  'use strict';
+
+  // Collection endpoint (assumed; point this at your analytics backend).
+  const ANALYTICS_ENDPOINT = '/api/analytics';
+
+  // All events within this window are sent together in one request.
+  const BATCH_WINDOW = 10 * 1000;
+
+  // Cap the batch so the payload stays well under the ~64KB fetchLater() /
+  // keepalive quota. Once reached, the pending batch is left to send and a
+  // new batch starts.
+  const MAX_QUEUE_SIZE = 100;
+
+  // ---------------------------------------------------------------------------
+  // fetchLater() polyfill (Chromium 135+ only ships it natively). Sends on the
+  // activateAfter timeout or when the page becomes hidden — the most reliable
+  // widely-available end-of-session signal.
+  // ---------------------------------------------------------------------------
+  globalThis.fetchLater ??= function fetchLater(url, init = {}) {
+    let timeoutHandle;
+    let activated = false;
+
+    function sendNow() {
+      if (!(init.signal && init.signal.aborted)) {
+        if (
+          'keepalive' in Request.prototype ||
+          init.method !== 'POST' ||
+          init.headers
+        ) {
+          // Strip activateAfter so it isn't passed through to fetch().
+          const { activateAfter, ...fetchInit } = init;
+          fetch(url, { ...fetchInit, keepalive: true }).catch(() => {});
+          activated = true;
+        } else {
+          activated = navigator.sendBeacon(url, init.body);
+        }
+      }
+      destroy();
+    }
+
+    function destroy() {
+      document.removeEventListener('visibilitychange', sendNow);
+      clearTimeout(timeoutHandle);
+    }
+
+    if (document.visibilityState === 'hidden') {
+      // Let remaining synchronous code run first.
+      queueMicrotask(sendNow);
+    } else {
+      document.addEventListener('visibilitychange', sendNow);
+      if (typeof init.activateAfter === 'number' && init.activateAfter >= 0) {
+        timeoutHandle = setTimeout(sendNow, init.activateAfter);
+      }
+    }
+
+    if (init.signal) {
+      init.signal.addEventListener('abort', destroy);
+    }
+
+    return {
+      get activated() {
+        return activated;
+      },
+    };
+  };
+
+  // ---------------------------------------------------------------------------
+  // Batching queue
+  // ---------------------------------------------------------------------------
+  const sessionId =
+    globalThis.crypto?.randomUUID?.() ??
+    `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
+
+  const eventQueue = [];
+  let fetchLaterResult = null;
+  let fetchLaterController = null;
+
+  function trackEvent(type, data = {}) {
+    // Start a fresh batch if the previous beacon already went out, or if the
+    // current one is full (in which case it is NOT aborted and still sends).
+    if (fetchLaterResult?.activated || eventQueue.length >= MAX_QUEUE_SIZE) {
+      fetchLaterController = null;
+      fetchLaterResult = null;
+      eventQueue.length = 0;
+    }
+
+    eventQueue.push({
+      type,
+      ts: Date.now(),
+      path: location.pathname,
+      ...data,
+    });
+
+    // Debounce: cancel the pending request and reschedule with the full queue.
+    fetchLaterController?.abort();
+    fetchLaterController = new AbortController();
+
+    try {
+      fetchLaterResult = fetchLater(ANALYTICS_ENDPOINT, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ sessionId, events: eventQueue }),
+        signal: fetchLaterController.signal,
+        activateAfter: BATCH_WINDOW,
+      });
+    } catch {
+      // Quota exceeded or unsupported — drop silently; analytics must never
+      // break the page.
+      fetchLaterResult = null;
+    }
+  }
+
+  // ---------------------------------------------------------------------------
+  // Event serialization (deliberately minimal — no free-form input values)
+  // ---------------------------------------------------------------------------
+  const INTERACTIVE = 'a, button, [role="button"], input[type="submit"], summary';
+
+  function describeElement(el) {
+    const desc = { tag: el.tagName.toLowerCase() };
+    if (el.id) desc.id = el.id;
+    if (el.classList.length) desc.classes = [...el.classList].slice(0, 5).join(' ');
+    if (el.dataset.track) desc.label = el.dataset.track;
+    if (el instanceof HTMLAnchorElement && el.href) desc.href = el.getAttribute('href');
+    const text = el.textContent?.replace(/\s+/g, ' ').trim();
+    if (text) desc.text = text.slice(0, 80);
+    const section = el.closest('nav, header, main, footer, section');
+    if (section) desc.region = section.tagName.toLowerCase();
+    return desc;
+  }
+
+  // ---------------------------------------------------------------------------
+  // Listeners
+  // ---------------------------------------------------------------------------
+  function trackPageView(extra = {}) {
+    trackEvent('page_view', {
+      title: document.title,
+      referrer: document.referrer || undefined,
+      viewport: `${innerWidth}x${innerHeight}`,
+      ...extra,
+    });
+  }
+
+  // Initial view (script is deferred, so the DOM is ready here).
+  trackPageView();
+
+  // Count back/forward-cache restores as new views.
+  addEventListener('pageshow', (event) => {
+    if (event.persisted) trackPageView({ bfcache: true });
+  });
+
+  // Capture phase so clicks are recorded even if a handler stops propagation.
+  document.addEventListener(
+    'click',
+    (event) => {
+      const target = event.target instanceof Element ? event.target : null;
+      if (!target) return;
+      const interactive = target.closest(INTERACTIVE);
+      trackEvent('click', {
+        element: describeElement(interactive ?? target),
+        interactive: Boolean(interactive),
+        x: Math.round(event.clientX),
+        y: Math.round(event.clientY),
+      });
+    },
+    { capture: true, passive: true },
+  );
+})();
