diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -151,8 +151,90 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Featured promo badge (Seasonal Favorites)
+       Spin, slide and hover-scale each drive a separate individual transform
+       property (rotate / translate / scale), so the two keyframe animations and
+       the hover transition compose instead of overriding one another's
+       `transform`. Hovering only transitions `scale`, so the animations are never
+       restarted, replaced or paused. */
+    .promo-badge-track {
+      display: flex;
+      justify-content: center;
+      margin: 20px 0 10px;
+      /* room for the 1.25x hover scale so the badge is never clipped */
+      padding: 20px 0;
+      overflow: hidden;
+    }
+
+    .target {
+      /* Stable stacking context in every state (not just on hover): the
+         element is always positioned with an explicit z-index and isolated,
+         so hover never creates/destroys a stacking context and nothing
+         re-layers or flickers. */
+      position: relative;
+      z-index: 1;
+      isolation: isolate;
+
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      width: 110px;
+      height: 110px;
+      border-radius: 50%;
+      background: radial-gradient(circle at 30% 30%, #ffc570, var(--accent) 60%, #f57c00);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.3);
+      text-align: center;
+      font-weight: bold;
+      line-height: 1.15;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      cursor: pointer;
+      user-select: none;
+
+      rotate: 0deg;
+      translate: 0 0;
+      scale: 1;
+
+      animation:
+        promo-spin 6s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+      transition: scale 0.35s ease;
+    }
+
+    .target .promo-badge-small {
+      font-size: 0.65rem;
+    }
+
+    .target .promo-badge-big {
+      font-size: 1.05rem;
+    }
+
+    /* Only `scale` changes on hover — `animation` is untouched, so the
+       spin and slide keep running uninterrupted. */
+    .target:hover,
+    .target:focus-visible {
+      scale: 1.25;
+    }
+
+    .target:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to   { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -80px 0; }
+      to   { translate: 80px 0; }
+    }
   </style>
 </head>
 
