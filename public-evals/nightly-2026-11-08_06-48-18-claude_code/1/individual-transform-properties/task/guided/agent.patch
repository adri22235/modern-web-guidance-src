@@ -151,8 +151,67 @@
       color: var(--text);
       text-decoration: none;
       font-size: 0.85rem;
     }
+    /* Featured promo badge (Seasonal Favorites) */
+    .promo-badge-row {
+      display: flex;
+      justify-content: center;
+      margin-top: 20px;
+      padding-inline: 48px; /* room for the slide so it never overflows */
+    }
+
+    .target {
+      display: grid;
+      place-items: center;
+      width: 96px;
+      aspect-ratio: 1;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--primary);
+      border: 3px dashed var(--primary);
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+      font-size: 0.8rem;
+      font-weight: bold;
+      line-height: 1.2;
+      text-align: center;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      text-decoration: none;
+      cursor: pointer;
+
+      /* Identity values for every transform the badge ever uses, so its
+         stacking context and containing block exist from the start and
+         never flip on hover / animation start (no will-change needed). */
+      translate: 0px 0px;
+      rotate: 0deg;
+      scale: 1;
+
+      @media (prefers-reduced-motion: no-preference) {
+        /* Each animation drives its own individual transform property,
+           so neither overwrites the other or the hover scale. */
+        animation:
+          badge-spin 6s linear infinite,
+          badge-slide 3s ease-in-out infinite alternate;
+        /* Only scale transitions; translate/rotate stay animation-driven. */
+        transition: scale 0.3s ease;
+      }
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      scale: 1.2;
+    }
+
+    @keyframes badge-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes badge-slide {
+      from { translate: -40px 0px; }
+      to { translate: 40px 0px; }
+    }
   </style>
 </head>
 
