+    /* Roast Picker (customizable select with rich options) */
+    .roast-picker {
+      margin-top: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.4rem;
+    }
+
+    .roast-picker label {
+      font-size: 0.85rem;
+      text-transform: uppercase;
+      letter-spacing: 1.5px;
+      color: var(--secondary);
+    }
+
+    .roast-select {
+      min-width: 300px;
+      padding: 10px 14px;
+      font: inherit;
+      color: var(--text);
+      background: rgba(255, 255, 255, 0.95);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    @supports (appearance: base-select) {
+
+      .roast-select,
+      .roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .roast-select {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+        text-align: left;
+      }
+
+      .roast-select::picker-icon {
+        color: var(--primary);
+        transition: rotate 0.2s;
+      }
+
+      .roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      .roast-select::picker(select) {
+        margin-top: 6px;
+        padding: 6px;
+        border: none;
+        border-radius: 10px;
+        background: white;
+        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+      }
+
+      .roast-select .sep {
+        display: none;
+      }
+
+      .roast-select option {
+        display: flex;
+        align-items: center;
+        gap: 12px;
+        padding: 10px 12px;
+        border-radius: 6px;
+        color: var(--text);
+        text-align: left;
+        cursor: pointer;
+      }
+
+      .roast-select option::checkmark {
+        order: 1;
+        margin-left: auto;
+        color: var(--accent);
+      }
+
+      .roast-select option:hover,
+      .roast-select option:focus-visible {
+        background: var(--secondary);
+        outline: none;
+      }
+
+      .roast-select option:checked {
+        background: #efebe9;
+      }
+
+      .roast-icon {
+        flex-shrink: 0;
+        width: 32px;
+        height: 32px;
+        color: var(--primary);
+      }
+
+      .roast-text {
+        display: flex;
+        flex-direction: column;
+        line-height: 1.25;
+      }
+
+      .roast-title {
+        font-weight: 600;
+      }
+
+      .roast-desc {
+        font-size: 0.8rem;
+        color: #6d4c41;
+      }
+
+      /* Keep the closed button compact: show icon + title only */
+      .roast-select selectedcontent {
+        display: flex;
+        align-items: center;
+        gap: 10px;
+      }
+
+      .roast-select selectedcontent .roast-desc {
+        display: none;
+      }
+    }
+
+    .hero .roast-picker+.btn {
+      margin-top: 1rem;
+    }
+
