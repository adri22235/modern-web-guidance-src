+  <script>
+    (function () {
+      'use strict';
+
+      var DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup, poured over a double shot of our house espresso.',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'A latte with leaf-shaped foam art in a ceramic cup',
+          meta: ['Seasonal', 'Hot or iced', '190 cal (12 oz, oat)'],
+          basePrice: 5.25,
+          defaultMilk: 'oat',
+          milk: true
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold and smokey with notes of dark chocolate and toasted walnut. Perfect for a morning boost.',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'A shot of espresso with rich crema in a small cup',
+          meta: ['Double shot', 'Hot', '5 cal'],
+          basePrice: 3.25,
+          defaultMilk: 'none',
+          milk: true
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness, with low acidity and a naturally sweet finish.',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'A tall glass of iced coffee',
+          meta: ['Served over ice', 'High caffeine', '10 cal (black)'],
+          basePrice: 4.5,
+          defaultMilk: 'none',
+          milk: true
+        }
+      };
+
+      var SIZES = [
+        { value: 'small', label: 'Small (8 oz)', delta: -0.5 },
+        { value: 'medium', label: 'Medium (12 oz)', delta: 0 },
+        { value: 'large', label: 'Large (16 oz)', delta: 0.75 }
+      ];
+
+      var MILKS = [
+        { value: 'none', label: 'No milk', delta: 0 },
+        { value: 'whole', label: 'Whole milk', delta: 0 },
+        { value: 'oat', label: 'Oat milk', delta: 0.6 },
+        { value: 'almond', label: 'Almond milk', delta: 0.6 }
+      ];
+
+      var dialog = document.getElementById('drink-dialog');
+      if (!dialog || typeof dialog.showModal !== 'function') {
+        return; // Very old browsers: buttons remain inert rather than half-working.
+      }
+
+      var titleEl = document.getElementById('drink-dialog-title');
+      var descEl = document.getElementById('drink-dialog-desc');
+      var metaEl = document.getElementById('drink-dialog-meta');
+      var imageEl = document.getElementById('drink-dialog-image');
+      var form = document.getElementById('drink-order-form');
+      var pickerRow = document.getElementById('drink-picker-row');
+      var picker = document.getElementById('drink-picker');
+      var sizeGroup = document.getElementById('size-options');
+      var milkSelect = document.getElementById('milk-select');
+      var qtyInput = document.getElementById('quantity-input');
+      var totalEl = document.getElementById('drink-total');
+      var statusEl = document.getElementById('order-status');
+
+      var currentDrink = null;
+      var opener = null;
+      var statusTimer = null;
+
+      // Build static option lists once.
+      Object.keys(DRINKS).forEach(function (key) {
+        var opt = document.createElement('option');
+        opt.value = key;
+        opt.textContent = DRINKS[key].name;
+        picker.appendChild(opt);
+      });
+
+      SIZES.forEach(function (size) {
+        var label = document.createElement('label');
+        var input = document.createElement('input');
+        input.type = 'radio';
+        input.name = 'size';
+        input.value = size.value;
+        label.appendChild(input);
+        label.appendChild(document.createTextNode(' ' + size.label));
+        sizeGroup.appendChild(label);
+      });
+
+      MILKS.forEach(function (milk) {
+        var opt = document.createElement('option');
+        opt.value = milk.value;
+        opt.textContent = milk.label + (milk.delta ? ' (+$' + milk.delta.toFixed(2) + ')' : '');
+        milkSelect.appendChild(opt);
+      });
+
+      function formatPrice(n) {
+        return '$' + n.toFixed(2);
+      }
+
+      function findBy(list, value) {
+        for (var i = 0; i < list.length; i++) {
+          if (list[i].value === value) return list[i];
+        }
+        return list[0];
+      }
+
+      function getQuantity() {
+        var q = parseInt(qtyInput.value, 10);
+        if (isNaN(q) || q < 1) q = 1;
+        if (q > 10) q = 10;
+        return q;
+      }
+
+      function updateTotal() {
+        if (!currentDrink) return;
+        var drink = DRINKS[currentDrink];
+        var sizeInput = form.querySelector('input[name="size"]:checked');
+        var size = findBy(SIZES, sizeInput ? sizeInput.value : 'medium');
+        var milk = findBy(MILKS, milkSelect.value);
+        var unit = drink.basePrice + size.delta + milk.delta;
+        totalEl.textContent = formatPrice(unit * getQuantity());
+      }
+
+      function renderDrink(key) {
+        var drink = DRINKS[key];
+        currentDrink = key;
+        titleEl.textContent = drink.name;
+        descEl.textContent = drink.description;
+        imageEl.src = drink.image;
+        imageEl.alt = drink.imageAlt;
+
+        metaEl.innerHTML = '';
+        [formatPrice(drink.basePrice) + ' (medium)'].concat(drink.meta).forEach(function (item) {
+          var li = document.createElement('li');
+          li.textContent = item;
+          metaEl.appendChild(li);
+        });
+
+        picker.value = key;
+        milkSelect.value = drink.defaultMilk;
+        updateTotal();
+      }
+
+      function resetForm() {
+        form.reset();
+        var medium = form.querySelector('input[name="size"][value="medium"]');
+        if (medium) medium.checked = true;
+      }
+
+      function openDialog(key, trigger) {
+        // Hero "Order Now" has no specific drink: show a drink picker instead.
+        var chooseDrink = !key || !DRINKS[key];
+        opener = trigger || document.activeElement;
+
+        resetForm();
+        pickerRow.hidden = !chooseDrink;
+        renderDrink(chooseDrink ? Object.keys(DRINKS)[0] : key);
+        if (chooseDrink) titleEl.textContent = 'Start your order';
+
+        document.body.classList.add('modal-open');
+        dialog.showModal();
+
+        // Put focus somewhere meaningful: the drink picker when choosing, otherwise
+        // the dialog heading so screen readers start at the top of the content.
+        if (chooseDrink) {
+          picker.focus();
+        } else {
+          titleEl.focus();
+        }
+      }
+
+      function closeDialog(returnValue) {
+        if (dialog.open) dialog.close(returnValue || '');
+      }
+
+      // Opening triggers.
+      document.querySelectorAll('[data-open-drink]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          openDialog(btn.getAttribute('data-open-drink'), btn);
+        });
+      });
+
+      // Close buttons (X and Cancel).
+      dialog.querySelectorAll('[data-close-dialog]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          closeDialog('cancel');
+        });
+      });
+
+      // Escape key (desktop) and the system back gesture/button (Android, via the
+      // dialog's built-in cancel handling) fire "cancel"; let it close natively.
+
+      // Light dismiss: clicking/tapping the backdrop closes the dialog. Only count it
+      // when both press and release happen on the backdrop, so a text selection or
+      // drag that ends outside the panel doesn't discard the user's choices.
+      var pressStartedOnBackdrop = false;
+      dialog.addEventListener('pointerdown', function (e) {
+        pressStartedOnBackdrop = e.target === dialog;
+      });
+      dialog.addEventListener('click', function (e) {
+        if (e.target === dialog && pressStartedOnBackdrop) {
+          closeDialog('cancel');
+        }
+        pressStartedOnBackdrop = false;
+      });
+
+      // Cleanup and focus restoration however the dialog was dismissed.
+      dialog.addEventListener('close', function () {
+        document.body.classList.remove('modal-open');
+        var target = opener;
+        opener = null;
+        if (target && typeof target.focus === 'function' && document.contains(target)) {
+          target.focus();
+        }
+      });
+
+      // Live price updates.
+      picker.addEventListener('change', function () {
+        var keepSize = form.querySelector('input[name="size"]:checked');
+        var sizeValue = keepSize ? keepSize.value : 'medium';
+        renderDrink(picker.value);
+        var size = form.querySelector('input[name="size"][value="' + sizeValue + '"]');
+        if (size) size.checked = true;
+        titleEl.textContent = 'Start your order';
+        updateTotal();
+      });
+      form.addEventListener('change', updateTotal);
+      qtyInput.addEventListener('input', updateTotal);
+
+      function announce(message) {
+        clearTimeout(statusTimer);
+        statusEl.textContent = message;
+        statusTimer = setTimeout(function () {
+          statusEl.textContent = '';
+        }, 5000);
+      }
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        var qty = getQuantity();
+        qtyInput.value = qty;
+        var sizeInput = form.querySelector('input[name="size"]:checked');
+        var size = findBy(SIZES, sizeInput ? sizeInput.value : 'medium');
+        var fulfillment = form.querySelector('input[name="fulfillment"]:checked');
+        var drink = DRINKS[currentDrink];
+        var message = 'Added ' + qty + ' × ' + size.label.split(' ')[0] + ' ' + drink.name +
+          ' to your order (' + (fulfillment && fulfillment.value === 'delivery' ? 'delivery' : 'pickup') +
+          ', ' + totalEl.textContent + ').';
+        closeDialog('added');
+        announce(message);
+      });
+    })();
+  </script>
+
 </body>
 
