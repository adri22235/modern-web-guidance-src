+  <script type="module">
+    // Invoker Commands (command/commandfor) are Baseline "newly available";
+    // load the polyfill only where native support is missing.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    // closedby="any" light dismiss is not yet supported everywhere (e.g. Safari).
+    // Esc / back gesture already work natively; this only adds click-outside closing.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      // Test pointer position rather than event.target: the <dialog> is also the target
+      // for clicks on its own padding, which must not close it.
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        // Require press and release outside so a text-selection drag ending on the backdrop doesn't dismiss
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dialog)) dialog.close();
+        });
+      }
+    }
