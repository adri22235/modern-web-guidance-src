+      const toISO = (d) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+      const today = new Date();
+      date.min = toISO(today);
+      date.max = toISO(new Date(today.getTime() + 7 * 864e5));
+      date.value = date.min;
+
+      const paidMilk = ['oat', 'almond', 'soy'];
+
+      function update() {
+        const opt = drink.selectedOptions[0];
+        const size = form.querySelector('input[name="size"]:checked');
+        const extras = form.querySelectorAll('input[name="extras"]:checked').length;
+        const shotCount = Math.min(4, Math.max(1, parseInt(shots.value, 10) || 1));
+
+        let price = parseFloat(opt.dataset.price) + parseFloat(size.dataset.add);
+        if (paidMilk.includes(milk.value)) price += 0.6;
+        price += Math.max(0, shotCount - 2) * 0.75;
+        price += extras * 0.5;
+        total.value = '$' + price.toFixed(2);
+
+        const base = parseFloat(opt.dataset.caffeine) * parseFloat(size.dataset.mult);
+        const mg = Math.round(base + (shotCount - 2) * 65);
+        meter.value = Math.max(0, mg);
+        caffeineText.textContent = '~' + Math.max(0, mg) + ' mg';
+
+        sweetnessOut.value = sweetness.value + '%';
+        sweetness.style.setProperty('--fill', sweetness.value + '%');
+      }
+
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      form.addEventListener('reset', () => {
+        status.textContent = '';
+        requestAnimationFrame(() => { date.value = date.min; update(); });
+      });
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!form.reportValidity()) return;
+        status.textContent = drink.selectedOptions[0].text.split(' — ')[0] + ' added — ' + total.value;
+      });
+
+      update();
+    })();
+  </script>
+
 </body>
 
