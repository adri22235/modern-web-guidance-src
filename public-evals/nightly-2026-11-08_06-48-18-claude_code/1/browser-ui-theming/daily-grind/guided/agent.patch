+  <script>
+    (() => {
+      const range = document.getElementById('sweetness');
+      const out = document.getElementById('sweetness-out');
+      const sync = () => {
+        out.value = `${range.value}%`;
+        range.style.setProperty('--progress', `${range.value}%`);
+      };
+      range.addEventListener('input', sync);
+      document.getElementById('order-form').addEventListener('reset', () => requestAnimationFrame(sync));
+
+      // Pickup can't be in the past
+      const date = document.getElementById('pickup-date');
+      const now = new Date();
+      const today = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
+      date.min = today;
+      date.defaultValue = today;
+    })();
+  </script>
