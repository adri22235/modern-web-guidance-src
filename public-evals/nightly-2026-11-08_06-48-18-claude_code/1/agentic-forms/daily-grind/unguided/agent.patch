+  <script>
+    (() => {
+      const form = document.getElementById('quick-order-form');
+      const summary = document.getElementById('qo-summary');
+      const totalEl = document.getElementById('qo-total');
+      const status = document.getElementById('qo-status');
+      const SHOT_PRICE = 0.8;
+      const money = (n) => `$${n.toFixed(2)}`;
+
+      const selectedText = (select) => select.options[select.selectedIndex]?.text.split(' — ')[0].replace(/\s*\(\+\$[\d.]+\)/, '') ?? '';
+      const priceOf = (el) => parseFloat(el?.dataset.price || '0');
+
+      function readOrder() {
+        const drinkSel = form.elements.drink;
+        const milkSel = form.elements.milk;
+        const flavorSel = form.elements.flavor;
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const isColdBrew = drinkSel.value === 'cold-brew';
+        const temperature = isColdBrew ? 'iced' : (form.elements.temperature.value || 'hot');
+        const shots = Math.min(4, Math.max(0, parseInt(form.elements.extra_shots.value, 10) || 0));
+
+        const total =
+          priceOf(drinkSel.selectedOptions[0]) +
+          priceOf(sizeInput) +
+          priceOf(milkSel.selectedOptions[0]) +
+          priceOf(flavorSel.selectedOptions[0]) +
+          shots * SHOT_PRICE;
+
+        return {
+          drink: drinkSel.value,
+          drinkLabel: selectedText(drinkSel),
+          size: sizeInput?.value || '',
+          temperature,
+          milk: milkSel.value,
+          milkLabel: selectedText(milkSel),
+          extraShots: shots,
+          flavor: flavorSel.value,
+          flavorLabel: selectedText(flavorSel),
+          location: form.elements.location.value,
+          locationLabel: form.elements.location.selectedOptions[0]?.text || '',
+          pickupTime: form.elements.pickup_time.value,
+          pickupLabel: form.elements.pickup_time.selectedOptions[0]?.text || '',
+          customerName: form.elements.customer_name.value.trim(),
+          notes: form.elements.notes.value.trim(),
+          total: Math.max(0, Math.round(total * 100) / 100),
+        };
+      }
+
+      function render() {
+        const o = readOrder();
+        const rows = [
+          ['Drink', `${o.temperature === 'iced' ? 'Iced ' : ''}${o.drinkLabel}`],
+          ['Size', o.size ? o.size[0].toUpperCase() + o.size.slice(1) : '—'],
+          ['Milk', o.milkLabel],
+          ['Extra shots', String(o.extraShots)],
+          ['Flavor', o.flavorLabel],
+          ['Pickup', o.locationLabel.split(' — ')[0]],
+          ['When', o.pickupLabel],
+          ['Name', o.customerName || '—'],
+        ];
+        summary.replaceChildren(...rows.flatMap(([k, v]) => {
+          const dt = document.createElement('dt');
+          const dd = document.createElement('dd');
+          dt.textContent = k;
+          dd.textContent = v;
+          return [dt, dd];
+        }));
+        totalEl.textContent = money(o.total);
+
+        // Cold brew is always served iced.
+        const isColdBrew = o.drink === 'cold-brew';
+        form.querySelectorAll('input[name="temperature"]').forEach((r) => {
+          if (isColdBrew) r.checked = r.value === 'iced';
+          r.disabled = isColdBrew && r.value === 'hot';
+        });
+        return o;
+      }
+
+      function validate() {
+        const errors = [];
+        const name = form.elements.customer_name;
+        if (!name.value.trim()) errors.push('Please enter a name for the order.');
+        if (!form.querySelector('input[name="size"]:checked')) errors.push('Please choose a size.');
+        const shots = form.elements.extra_shots;
+        if (shots.value !== '' && (!/^\d+$/.test(shots.value) || +shots.value > 4)) {
+          errors.push('Extra espresso shots must be a whole number from 0 to 4.');
+        }
+        return errors;
+      }
+
+      function setStatus(kind, text) {
+        status.className = `order-status ${kind}`;
+        status.textContent = text;
+      }
+
+      function estimatePickup(value) {
+        const minutes = value === 'asap' ? 5 : parseInt(value, 10) || 5;
+        const t = new Date(Date.now() + minutes * 60000);
+        return t.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+      }
+
+      form.addEventListener('input', render);
+      form.addEventListener('change', render);
+      form.addEventListener('reset', () => {
+        // Wait for the browser to restore default values before re-rendering.
+        setTimeout(() => { status.textContent = ''; status.className = 'order-status'; render(); });
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const errors = validate();
+
+        if (errors.length) {
+          const message = errors.join(' ');
+          setStatus('error', message);
+          // Report validation failures back to an invoking AI agent (WebMCP).
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve({ success: false, error: message }));
+          } else {
+            const firstInvalid = !form.elements.customer_name.value.trim()
+              ? form.elements.customer_name
+              : form.elements.extra_shots;
+            firstInvalid.focus();
+          }
+          return;
+        }
+
+        const order = render();
+        const orderNumber = `DG-${Date.now().toString(36).slice(-5).toUpperCase()}`;
+        const readyAt = estimatePickup(order.pickupTime);
+        const description = `${order.size} ${order.temperature} ${order.drinkLabel}` +
+          (order.milk !== 'none' ? ` with ${order.milkLabel.toLowerCase()}` : '') +
+          (order.extraShots ? `, +${order.extraShots} shot${order.extraShots > 1 ? 's' : ''}` : '') +
+          (order.flavor !== 'none' ? `, ${order.flavorLabel.toLowerCase()} syrup` : '');
+
+        setStatus('success',
+          `Thanks, ${order.customerName}! Order ${orderNumber} (${description}) is confirmed. ` +
+          `Total ${money(order.total)} — ready around ${readyAt} at ${order.locationLabel}.`);
+
+        const result = {
+          success: true,
+          orderNumber,
+          customerName: order.customerName,
+          item: {
+            drink: order.drink,
+            size: order.size,
+            temperature: order.temperature,
+            milk: order.milk,
+            extraShots: order.extraShots,
+            flavor: order.flavor,
+            notes: order.notes,
+          },
+          total: money(order.total),
+          pickupLocation: order.locationLabel,
+          estimatedReadyTime: readyAt,
+        };
+
+        // When submitted by an AI agent via the declarative WebMCP tool,
+        // return a structured result instead of navigating.
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+
+      render();
+    })();
+  </script>
+
 </body>
 
