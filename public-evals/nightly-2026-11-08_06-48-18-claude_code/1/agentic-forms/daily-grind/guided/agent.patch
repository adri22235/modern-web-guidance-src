+  <script>
+    (() => {
+      const form = document.getElementById('quick-order-form');
+      const status = document.getElementById('order-status');
+      const submitBtn = form.querySelector('button[type="submit"]');
+
+      const PRICES = {
+        'maple-oat-latte': 5.75, 'dark-roast-espresso': 3.25, 'cold-brew': 4.5,
+        'cappuccino': 4.75, 'flat-white': 4.95, 'americano': 3.75, 'chai-latte': 5.25,
+      };
+
+      const labelText = (control) =>
+        (control.labels?.[0]?.firstChild?.textContent ?? control.name).trim();
+
+      const optionText = (select) => select.selectedOptions[0]?.textContent.split(' — ')[0];
+
+      // Clear custom error state as soon as the user edits a field.
+      form.addEventListener('input', (e) => {
+        e.target.removeAttribute?.('aria-invalid');
+      });
+
+      // Validate only after the user leaves an edited field.
+      form.addEventListener('focusout', (e) => {
+        const el = e.target;
+        if (el.willValidate && el.value !== '' && !el.checkValidity()) {
+          el.setAttribute('aria-invalid', 'true');
+        }
+      });
+
+      const showStatus = (message, isError = false) => {
+        status.classList.toggle('error', isError);
+        status.textContent = message;
+      };
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const invalid = [...form.elements].filter((el) => el.willValidate && !el.checkValidity());
+        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
+
+        if (invalid.length > 0) {
+          const message = 'Please fix: ' +
+            invalid.map((el) => `${labelText(el)} (${el.validationMessage})`).join(', ');
+          showStatus(message, true);
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(message));
+          } else {
+            invalid[0].focus();
+          }
+          return;
+        }
+
+        const data = new FormData(form);
+        const qty = Number(data.get('quantity'));
+        let unit = PRICES[data.get('drink')] ?? 0;
+        if (data.get('size') === 'large') unit += 0.75;
+        if (data.get('extra_shot')) unit += 0.9;
+        const total = (unit * qty).toFixed(2);
+
+        submitBtn.disabled = true;
+
+        // Demo: simulate sending the order. Replace with a real POST to form.action.
+        const result = new Promise((resolve) => setTimeout(resolve, 600)).then(() => {
+          const orderId = 'DG-' + Math.random().toString(36).slice(2, 8).toUpperCase();
+          const summary =
+            `Order ${orderId} confirmed: ${qty} × ${data.get('size')} ${optionText(form.elements.drink)}` +
+            ` (${data.get('milk')} milk${data.get('extra_shot') ? ', extra shot' : ''}${data.get('decaf') ? ', decaf' : ''})` +
+            ` for ${data.get('customer_name')}, ready at ${data.get('pickup_time')}` +
+            ` at ${optionText(form.elements.location)}. Total: $${total}.`;
+          showStatus(summary);
+          form.reset();
+          return summary;
+        }).finally(() => {
+          submitBtn.disabled = false;
+        });
+
+        if (event.agentInvoked) {
+          event.respondWith(result);
+        }
+      });
+    })();
+  </script>
+
