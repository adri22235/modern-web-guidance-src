diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..b372c0b
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,82 @@
+import { useEffect, useRef } from 'react';
+
+/**
+ * Minimal typings for the WebMCP API (`navigator.modelContext`), which lets a
+ * page expose client-side functionality as tools that AI agents can call.
+ * See https://github.com/webmachinelearning/webmcp
+ */
+export interface ModelContextToolResult {
+  content: Array<{ type: 'text'; text: string }>;
+  isError?: boolean;
+}
+
+export interface ModelContextTool<TInput = any> {
+  name: string;
+  description: string;
+  inputSchema?: Record<string, unknown>;
+  annotations?: { readOnlyHint?: boolean };
+  execute: (input: TInput, client?: unknown) => Promise<ModelContextToolResult> | ModelContextToolResult;
+}
+
+export interface ModelContext {
+  registerTool: (tool: ModelContextTool, options?: { signal?: AbortSignal }) => unknown;
+  unregisterTool?: (name: string) => void;
+}
+
+declare global {
+  interface Navigator {
+    modelContext?: ModelContext;
+  }
+}
+
+export const textResult = (text: string, isError = false): ModelContextToolResult => ({
+  content: [{ type: 'text', text }],
+  ...(isError ? { isError: true } : {}),
+});
+
+/**
+ * Registers a WebMCP tool for as long as the calling component is mounted.
+ * The latest `execute` callback is always used, so it may close over fresh
+ * component state without causing re-registration. No-op in browsers that
+ * don't support WebMCP.
+ */
+export function useWebMCPTool<TInput>(tool: ModelContextTool<TInput>) {
+  const executeRef = useRef(tool.execute);
+  executeRef.current = tool.execute;
+
+  const { name, description } = tool;
+  const schemaKey = JSON.stringify(tool.inputSchema ?? null);
+  const annotationsKey = JSON.stringify(tool.annotations ?? null);
+
+  useEffect(() => {
+    const modelContext = typeof navigator !== 'undefined' ? navigator.modelContext : undefined;
+    if (!modelContext?.registerTool) return;
+
+    const controller = new AbortController();
+    try {
+      modelContext.registerTool(
+        {
+          name,
+          description,
+          inputSchema: JSON.parse(schemaKey) ?? undefined,
+          annotations: JSON.parse(annotationsKey) ?? undefined,
+          execute: (input, client) => executeRef.current(input as TInput, client),
+        },
+        { signal: controller.signal },
+      );
+    } catch (err) {
+      console.warn(`[WebMCP] Failed to register tool "${name}":`, err);
+      return;
+    }
+
+    return () => {
+      controller.abort();
+      // Older implementations unregister by name rather than via AbortSignal.
+      try {
+        modelContext.unregisterTool?.(name);
+      } catch {
+        /* already unregistered */
+      }
+    };
+  }, [name, description, schemaKey, annotationsKey]);
+}
