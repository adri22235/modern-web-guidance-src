+}
+/* WebMCP: highlight forms while an AI agent is filling them in, and the submit
+   button while the browser waits for the user to review and confirm. */
+form:tool-form-active {
+  outline: 2px dashed var(--color-blue-500);
+  outline-offset: 4px;
+  background-color: color-mix(in oklab, var(--color-blue-500) 5%, transparent);
+}
+
+button:tool-submit-active {
+  outline: 2px dashed var(--color-red-500);
+  outline-offset: 2px;
+  animation: tool-submit-pulse 2s infinite;
+}
+
+@keyframes tool-submit-pulse {
+  50% { outline-color: transparent; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  button:tool-submit-active { animation: none; }
+}
diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..6bfdd21
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,13 @@
+import type { FormEvent } from 'react';
+
+/**
+ * Sends the outcome of an agent-invoked form submission back to the agent.
+ * Must be called synchronously inside the submit handler. No-op for regular
+ * user submissions and in browsers without WebMCP support.
+ */
+export function respondToAgent(event: FormEvent<HTMLFormElement>, result: Promise<unknown>): void {
+  const native = event.nativeEvent as SubmitEvent;
+  if (native.agentInvoked && typeof native.respondWith === 'function') {
+    native.respondWith(result);
+  }
+}
