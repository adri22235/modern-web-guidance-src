diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -134,8 +134,86 @@
     .btn:hover {
       background: #3e2723;
     }
 
+    /* Contact Form */
+    .contact {
+      max-width: 600px;
+    }
+
+    .contact h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .contact form {
+      display: flex;
+      flex-direction: column;
+      gap: 1rem;
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+      gap: 0.25rem;
+      padding: 12px;
+      background: white;
+      border: 2px solid transparent;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      transition: border-color 0.2s;
+    }
+
+    /* Red border on the whole wrapper once the user has interacted with an invalid field */
+    .field:has(:user-invalid) {
+      border-color: #c62828;
+    }
+
+    .field label {
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .field input,
+    .field textarea {
+      font: inherit;
+      font-size: max(1rem, 1em);
+      padding: 0.6rem 0.75rem;
+      min-height: 48px;
+      border: 1px solid #767676;
+      border-radius: 5px;
+      color: var(--text);
+    }
+
+    .field textarea {
+      resize: vertical;
+    }
+
+    .field input:focus-visible,
+    .field textarea:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .error-msg {
+      display: none;
+      color: #c62828;
+      font-size: 0.875rem;
+    }
+
+    .field:has(:user-invalid) .error-msg {
+      display: block;
+    }
+
+    .contact button {
+      align-self: flex-start;
+      font: inherit;
+      border: none;
+      cursor: pointer;
+      min-height: 48px;
+      margin-top: 0;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
