+  <dialog id="details-modal" class="modal" aria-labelledby="details-modal-title">
+    <div class="modal-content">
+      <button type="button" class="modal-close" aria-label="Close">&times;</button>
+      <h2 id="details-modal-title"></h2>
+      <p id="details-modal-body"></p>
+      <a id="details-modal-link" href="#" class="btn">See Full Menu Item</a>
+    </div>
+  </dialog>
+
+  <script>
+    (function () {
+      const modal = document.getElementById('details-modal');
+      if (!modal || typeof modal.showModal !== 'function') return; // fall back to normal links
+      const root = document.documentElement;
+      const title = document.getElementById('details-modal-title');
+      const body = document.getElementById('details-modal-body');
+      const link = document.getElementById('details-modal-link');
+
+      function lockScroll() {
+        const scrollbarWidth = window.innerWidth - root.clientWidth;
+        root.style.setProperty('--scrollbar-width', scrollbarWidth + 'px');
+        root.classList.add('scroll-locked');
+      }
+
+      function unlockScroll() {
+        root.classList.remove('scroll-locked');
+        root.style.removeProperty('--scrollbar-width');
+      }
+
+      document.querySelectorAll('[data-modal-details]').forEach(function (trigger) {
+        trigger.addEventListener('click', function (e) {
+          e.preventDefault();
+          const card = trigger.closest('.card');
+          title.textContent = card ? card.querySelector('h3').textContent : '';
+          body.textContent = trigger.dataset.modalDetails;
+          link.href = trigger.getAttribute('href');
+          lockScroll();
+          modal.showModal();
+        });
+      });
+
+      // 'close' fires for the close button, Escape key, and backdrop clicks.
+      modal.addEventListener('close', unlockScroll);
+
+      modal.querySelector('.modal-close').addEventListener('click', function () {
+        modal.close();
+      });
+
+      // Close when clicking the backdrop (outside the dialog box).
+      modal.addEventListener('click', function (e) {
+        if (e.target === modal) modal.close();
+      });
+    })();
+  </script>
+
 </body>
 
