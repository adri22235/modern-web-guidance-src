@@ -135,6 +135,21 @@
       background: #3e2723;
     }
 
+    /* Modal dialogs: keep the page underneath from scrolling.
+       Don't lock scroll via overflow/position on html/body — that shifts layout
+       and breaks the sticky nav. */
+    dialog:modal {
+      /* Stop scroll gestures inside the dialog chaining to the page */
+      overscroll-behavior: contain;
+    }
+
+    dialog::backdrop {
+      /* ::backdrop isn't a scroll container by default, so it would ignore
+         overscroll-behavior; overflow: hidden makes it one. */
+      overflow: hidden;
+      overscroll-behavior: contain;
+    }
+
