+      render: document.getElementById('debug-render'),
+      viewport: document.getElementById('debug-viewport'),
+    };
+    const debugState = { total: 0, eager: 0, deferred: 0, render: '-' };
 
+    function updateDebugPanel() {
+      if (debugPanel.hidden) return; // don't touch the DOM while hidden
+      debugFields.total.textContent = debugState.total;
+      debugFields.eager.textContent = debugState.eager;
+      debugFields.deferred.textContent = debugState.deferred;
+      debugFields.render.textContent = debugState.render;
+      debugFields.viewport.textContent = `${window.innerWidth}x${window.innerHeight}`;
+    }
 
-    function createCard(index) {
