   <script>
     const feed = document.getElementById('feed');
     const regenBtn = document.getElementById('regenerate');
     const timerSpan = document.getElementById('timer');
     const detectedSpan = document.getElementById('detected');
     const cardCount = 500;
+    // Rough rendered card height (incl. margin), used to decide which cards
+    // are visible on first paint. Everything past that is deferred.
+    const estimatedCardHeight = 420;
 
+    const debugPanel = document.getElementById('debug-panel');
+    const debugBtn = document.getElementById('toggle-debug');
+    const debugFields = {
+      total: document.getElementById('debug-total'),
+      eager: document.getElementById('debug-eager'),
