       margin: 2rem auto;
       text-align: center;
       color: #64748b;
     }
+
+    /* Cards outside the initial viewport: the browser skips their style,
+       layout and paint until they approach the viewport while scrolling. */
+    .off-screen-card {
+      content-visibility: auto;
+      contain-intrinsic-size: auto 420px;
+    }
+
+    /* Debug panel: isolated so showing/hiding it never re-lays out the cards. */
+    .debug-panel {
+      max-width: 800px;
+      margin: 0 auto 2rem;
+      padding: 1rem 1.5rem;
+      box-sizing: border-box;
+      background: #0f172a;
+      color: #e2e8f0;
+      font-family: monospace;
+      font-size: 0.85rem;
+      border-radius: 0.75rem;
+      contain: layout style paint;
+    }
+
+    .debug-panel[hidden] {
+      display: none;
+    }
+
+    .debug-panel dl {
+      display: grid;
+      grid-template-columns: max-content 1fr;
+      gap: 0.25rem 1rem;
+      margin: 0;
+    }
+
+    .debug-panel dd {
+      margin: 0;
+    }
   </style>
 </head>
 
 <body>
