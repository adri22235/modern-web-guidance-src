     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const mailingList = document.getElementById('mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-error');
+    const mailingListStatus = document.getElementById('mailing-list-status');
+    let touched = false;
+    let submitted = false;
+
+    function validateEmail() {
+      const showError = (touched || submitted) && !email.validity.valid;
+      emailError.hidden = !showError;
+      emailError.textContent = showError
+        ? (email.validity.valueMissing ? 'Please enter your email address.' : 'Please enter a valid email address.')
+        : '';
+      if (showError) {
+        email.setAttribute('aria-invalid', 'true');
+        email.setAttribute('aria-describedby', 'mailing-list-error');
+      } else {
+        email.removeAttribute('aria-invalid');
+        email.removeAttribute('aria-describedby');
+      }
+      return email.validity.valid;
+    }
+
+    email.addEventListener('blur', () => {
+      touched = true;
+      validateEmail();
+    });
+
+    email.addEventListener('input', () => {
+      mailingListStatus.textContent = '';
+      validateEmail();
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      submitted = true;
+      mailingListStatus.textContent = '';
+      if (!validateEmail()) {
+        email.focus();
+        return;
+      }
+      // Connect a mailing list service here before accepting subscriptions.
+      mailingListStatus.textContent = 'Sign-ups are currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
 </html>
