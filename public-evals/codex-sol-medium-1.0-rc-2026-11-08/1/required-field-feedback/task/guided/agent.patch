+  <script>
+    const mailingList = document.querySelector('.mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const signupStatus = mailingList.querySelector('[role="status"]');
+
+    const syncEmailError = () => {
+      if (email.matches(':user-invalid')) {
+        email.setAttribute('aria-invalid', 'true');
+      } else {
+        email.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Wait until the browser has updated its interaction-aware validation state.
+    email.addEventListener('blur', () => requestAnimationFrame(syncEmailError));
+    email.addEventListener('invalid', () => requestAnimationFrame(syncEmailError));
+    email.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      requestAnimationFrame(syncEmailError);
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncEmailError();
+      // This static page has no mailing-list provider connected yet.
+      signupStatus.textContent = 'Online signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
