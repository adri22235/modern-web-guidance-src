+  <script>
+    const carousel = document.querySelector('#seasonal-drinks');
+    const cards = [...carousel.querySelectorAll('.card')];
+    const previous = document.querySelector('#previous-drink');
+    const next = document.querySelector('#next-drink');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function updateControls() {
+      previous.disabled = carousel.scrollLeft <= 1;
+      next.disabled = carousel.scrollLeft >= carousel.scrollWidth - carousel.clientWidth - 1;
+    }
+
+    function scrollToCard(index) {
+      const card = cards[Math.max(0, Math.min(index, cards.length - 1))];
+      carousel.scrollTo({
+        left: card.offsetLeft - cards[0].offsetLeft,
+        behavior: reducedMotion.matches ? 'instant' : 'smooth'
+      });
+    }
+
+    function moveCard(direction) {
+      const position = carousel.scrollLeft;
+      const offsets = cards.map(card => card.offsetLeft - cards[0].offsetLeft);
+      const index = direction > 0
+        ? offsets.findIndex(offset => offset > position + 2)
+        : offsets.findLastIndex(offset => offset < position - 2);
+      scrollToCard(index < 0 ? (direction > 0 ? cards.length - 1 : 0) : index);
+    }
+
+    previous.addEventListener('click', () => moveCard(-1));
+    next.addEventListener('click', () => moveCard(1));
+    carousel.addEventListener('scroll', updateControls, { passive: true });
+    window.addEventListener('resize', updateControls);
+    carousel.addEventListener('keydown', event => {
+      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+      event.preventDefault();
+      if (event.key === 'Home') scrollToCard(0);
+      else if (event.key === 'End') scrollToCard(cards.length - 1);
+      else moveCard(event.key === 'ArrowRight' ? 1 : -1);
+    });
+    updateControls();
+
+    const drinks = {
+      maple: {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        notes: 'A mellow, maple-sweet cup with a creamy finish. A cozy pick for a crisp seasonal morning.',
+        href: '/menu/seasonal'
+      },
+      espresso: {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        notes: 'Deep roast character and an intense finish make this a favorite for those who enjoy a bold cup.',
+        href: '/menu/espresso'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        notes: 'Slow steeping brings out a smooth, rounded coffee flavor. A refreshing way to enjoy your daily coffee.',
+        href: '/menu/cold-brew'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+    let openingAnimation;
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        const origin = button.getBoundingClientRect();
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        document.querySelector('#drink-menu-link').href = drink.href;
+        dialog.showModal();
+        if (!reducedMotion.matches) {
+          const destination = dialog.getBoundingClientRect();
+          // Start at this specific button's bounds, then expand to the dialog.
+          openingAnimation = dialog.animate([
+            {
+              transform: `translate(${origin.left - destination.left}px, ${origin.top - destination.top}px) scale(${origin.width / destination.width}, ${origin.height / destination.height})`,
+              opacity: 0.25
+            },
+            { transform: 'translate(0, 0) scale(1)', opacity: 1 }
+          ], { duration: 360, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' });
+        }
+      });
+    });
+    dialog.addEventListener('close', () => openingAnimation?.cancel());
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) openingAnimation?.cancel();
+    });
+
+    // Keep outside-click dismissal on browsers without closedby support.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = event => {
+        const bounds = dialog.getBoundingClientRect();
+        return event.clientX < bounds.left || event.clientX > bounds.right ||
+          event.clientY < bounds.top || event.clientY > bounds.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', event => { pressedOutside = outside(event); });
+      dialog.addEventListener('pointerup', event => {
+        if (pressedOutside && outside(event)) dialog.close();
+        pressedOutside = false;
+      });
+    }
+  </script>
