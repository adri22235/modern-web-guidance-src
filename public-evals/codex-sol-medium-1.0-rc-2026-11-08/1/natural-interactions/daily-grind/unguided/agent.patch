+  <script>
+    const track = document.getElementById('drink-track');
+    const previous = document.getElementById('previous-drink');
+    const next = document.getElementById('next-drink');
+
+    function updateControls() {
+      previous.disabled = track.scrollLeft <= 1;
+      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
+    }
+
+    function moveDrink(direction) {
+      const cards = Array.from(track.children);
+      const start = cards[0].offsetLeft;
+      const positions = cards.map(card => card.offsetLeft - start);
+      const target = direction > 0
+        ? positions.find(position => position > track.scrollLeft + 2)
+        : positions.reverse().find(position => position < track.scrollLeft - 2);
+      track.scrollTo({ left: target ?? (direction > 0 ? track.scrollWidth : 0) });
+    }
+
+    previous.addEventListener('click', () => moveDrink(-1));
+    next.addEventListener('click', () => moveDrink(1));
+    track.addEventListener('scroll', updateControls, { passive: true });
+    window.addEventListener('resize', updateControls);
+    track.addEventListener('keydown', event => {
+      if (event.target !== track || event.altKey || event.ctrlKey || event.metaKey) return;
+      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+        event.preventDefault();
+        moveDrink(event.key === 'ArrowRight' ? 1 : -1);
+      } else if (event.key === 'Home' || event.key === 'End') {
+        event.preventDefault();
+        track.scrollTo({ left: event.key === 'Home' ? 0 : track.scrollWidth });
+      }
+    });
+
+    document.querySelectorAll('.detail-toggle').forEach(button => {
+      button.addEventListener('click', () => {
+        const expanded = button.getAttribute('aria-expanded') !== 'true';
+        const panel = document.getElementById(button.getAttribute('aria-controls'));
+        const name = panel.getAttribute('aria-labelledby');
+        button.setAttribute('aria-expanded', String(expanded));
+        button.setAttribute('aria-label', `${expanded ? 'Hide' : 'View'} details for ${document.getElementById(name).textContent}`);
+        button.innerHTML = `${expanded ? 'Hide' : 'View'} Details <span aria-hidden="true">${expanded ? '\u2212' : '+'}</span>`;
+        panel.inert = !expanded;
+        panel.setAttribute('aria-hidden', String(!expanded));
+        panel.classList.toggle('is-open', expanded);
+      });
+    });
+    updateControls();
+  </script>
