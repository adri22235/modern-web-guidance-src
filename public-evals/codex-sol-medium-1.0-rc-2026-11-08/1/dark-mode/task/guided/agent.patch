+  <script>
+    const themeSelect = document.getElementById('theme-select');
+    const colorScheme = document.querySelector('meta[name="color-scheme"]');
+
+    function applyTheme(theme) {
+      const preference = theme === 'light' || theme === 'dark' ? theme : 'system';
+      colorScheme.content = preference === 'system' ? 'light dark' : preference;
+      themeSelect.value = preference;
+    }
+
+    applyTheme(colorScheme.content);
+
+    themeSelect.addEventListener('change', () => {
+      applyTheme(themeSelect.value);
+      try {
+        if (themeSelect.value === 'system') {
+          localStorage.removeItem('coffee-theme');
+        } else {
+          localStorage.setItem('coffee-theme', themeSelect.value);
+        }
+      } catch { /* The selected theme still applies when storage is blocked. */ }
+    });
+
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'coffee-theme' || event.key === null) {
+        applyTheme(event.newValue);
+      }
+    });
+  </script>
 </body>
 
