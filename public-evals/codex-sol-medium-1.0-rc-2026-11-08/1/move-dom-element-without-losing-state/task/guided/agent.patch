+  <script>
+    const hero = document.getElementById('hero');
+    const videoHome = document.getElementById('video-home');
+    const player = document.getElementById('coffee-player');
+    const theaterToggle = document.getElementById('theater-toggle');
+    const videoStatus = document.getElementById('video-status');
+
+    if (typeof hero.moveBefore === 'function') {
+      theaterToggle.disabled = false;
+      videoStatus.textContent = 'Move the video to the hero with theater mode. Your playback will continue.';
+
+      theaterToggle.addEventListener('click', () => {
+        const enteringTheater = theaterToggle.getAttribute('aria-pressed') !== 'true';
+        const destination = enteringTheater ? hero : videoHome;
+
+        // Atomic reparenting keeps the existing iframe and its browsing context alive.
+        // Never substitute appendChild/insertBefore: they would reload the video.
+        destination.moveBefore(player, null);
+        hero.classList.toggle('is-theater', enteringTheater);
+        theaterToggle.setAttribute('aria-pressed', String(enteringTheater));
+        theaterToggle.textContent = enteringTheater ? 'Exit theater mode' : 'Enter theater mode';
+        videoStatus.textContent = enteringTheater
+          ? 'Theater mode on. The video is now in the hero section.'
+          : 'Theater mode off. The video is back in its original section.';
+        theaterToggle.focus({ preventScroll: true });
+        (enteringTheater ? hero : document.getElementById('video-section'))
+          .scrollIntoView({ behavior: 'instant', block: 'start' });
+      });
+    } else {
+      // Preserve uninterrupted playback when state-preserving moves are unavailable.
+      videoStatus.textContent = 'Theater mode is unavailable in this browser. You can still watch the video here or use its fullscreen control.';
+    }
+  </script>
