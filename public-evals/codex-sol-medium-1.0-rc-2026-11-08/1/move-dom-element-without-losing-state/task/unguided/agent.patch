+  <script>
+    const hero = document.querySelector('.hero');
+    const videoHome = document.getElementById('video-home');
+    const player = document.getElementById('roasting-player');
+    const theaterToggle = document.getElementById('theater-toggle');
+    const videoStatus = document.getElementById('video-status');
+
+    // Ordinary appendChild/insertBefore would reload the iframe, even if the
+    // same node is reused. moveBefore preserves its browsing context and playback.
+    if (typeof hero.moveBefore === 'function') {
+      theaterToggle.disabled = false;
+      theaterToggle.addEventListener('click', () => {
+        const entering = theaterToggle.getAttribute('aria-pressed') !== 'true';
+        const destination = entering ? hero : videoHome;
+        destination.moveBefore(player, null);
+        hero.classList.toggle('is-theater', entering);
+        theaterToggle.setAttribute('aria-pressed', String(entering));
+        theaterToggle.textContent = entering ? 'Exit theater mode' : 'Enter theater mode';
+        videoStatus.textContent = entering ? 'Theater mode on' : 'Theater mode off';
+        theaterToggle.focus({ preventScroll: true });
+        (entering ? hero : videoHome).scrollIntoView({ block: 'start' });
+      });
+    } else {
+      videoStatus.textContent = 'Theater mode requires a browser with state-preserving moves.';
+      theaterToggle.setAttribute('aria-describedby', 'video-status');
+    }
+  </script>
