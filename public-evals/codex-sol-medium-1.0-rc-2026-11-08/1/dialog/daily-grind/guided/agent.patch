+  <script>
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup. Espresso with steamed oat milk, served hot.',
+        sizes: ['Small (8 oz)', 'Medium (12 oz)', 'Large (16 oz)'],
+        milk: 'oat'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Our dark roast espresso is served hot; choose your shot count below.',
+        sizes: ['Single shot', 'Double shot', 'Triple shot'],
+        milk: 'none'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness. Served over ice, with your choice of milk.',
+        sizes: ['Small (12 oz)', 'Medium (16 oz)', 'Large (20 oz)'],
+        milk: 'none'
+      }
+    };
+
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('order-form');
+    const drinkChoice = document.getElementById('drink-choice');
+    const sizeChoice = document.getElementById('drink-size');
+    const milkChoice = document.getElementById('drink-milk');
+    const quantity = document.getElementById('drink-quantity');
+    const summary = document.getElementById('order-summary');
+    const discard = document.getElementById('discard-changes');
+    let dirty = false;
+
+    function updateSummary() {
+      const count = quantity.validity.valid ? quantity.value : 'Choose a quantity (1–20)';
+      summary.textContent = `${count} × ${drinks[drinkChoice.value].name} · ${sizeChoice.value} · ${milkChoice.selectedOptions[0].textContent}`;
+    }
+
+    function showDrinkDetails() {
+      const drink = drinks[drinkChoice.value];
+      document.getElementById('drink-title').textContent = drink.name;
+      document.getElementById('drink-description').textContent = drink.description;
+      sizeChoice.replaceChildren(...drink.sizes.map(size => new Option(size, size)));
+      milkChoice.value = drink.milk;
+      updateSummary();
+    }
+
+    function setDirty(value) {
+      dirty = value;
+      dialog.toggleAttribute('data-dirty', value);
+      // Disable native dismissal while dirty; cancel below also guards browsers
+      // that do not yet support closedby.
+      dialog.setAttribute('closedby', value ? 'none' : 'closerequest');
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        if (dialog.open) return;
+        form.reset();
+        setDirty(false);
+        drinkChoice.value = button.dataset.drink;
+        showDrinkDetails();
+        dialog.showModal();
+      });
+    });
+
+    // Latch dirty after any edit, even if the user later restores the default.
+    function orderChanged(event) {
+      if (event.target === drinkChoice && event.type === 'change') showDrinkDetails();
+      setDirty(true);
+      updateSummary();
+    }
+    form.addEventListener('input', orderChanged);
+    form.addEventListener('change', orderChanged);
+    form.addEventListener('submit', event => event.preventDefault());
+
+    document.getElementById('close-drink-dialog').addEventListener('click', () => {
+      if (dirty) {
+        discard.focus();
+        return;
+      }
+      dialog.close();
+    });
+
+    dialog.addEventListener('cancel', event => {
+      if (dirty) {
+        event.preventDefault();
+        discard.focus();
+      }
+    });
+
+    // Older browsers can force-close after repeated Escape presses despite a
+    // canceled close request. Suppress that default only while edits are locked.
+    if (!('closedBy' in dialog)) {
+      dialog.addEventListener('keydown', event => {
+        if (dirty && event.key === 'Escape') {
+          event.preventDefault();
+          discard.focus();
+        }
+      });
+    }
+
+    discard.addEventListener('click', () => {
+      if (!dirty) return;
+      form.reset();
+      setDirty(false);
+      dialog.close('discard');
+    });
+
+    dialog.addEventListener('close', () => {
+      dialog.returnValue = '';
+    });
+  </script>
+
 </body>
 
