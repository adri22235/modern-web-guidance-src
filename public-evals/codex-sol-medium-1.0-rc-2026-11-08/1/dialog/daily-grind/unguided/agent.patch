+  <script>
+    const drinks = {
+      maple: {
+        description: 'Maple Oat Latte — espresso with creamy oat milk and a hint of Vermont maple syrup.',
+        sizes: ['Small (8 oz)', 'Medium (12 oz)', 'Large (16 oz)'],
+        milk: 'oat'
+      },
+      espresso: {
+        description: 'Dark Roast Espresso — bold, smoky espresso with a rich finish, served hot.',
+        sizes: ['Single shot', 'Double shot'],
+        milk: 'none'
+      },
+      'cold-brew': {
+        description: 'Cold Brew — steeped for 18 hours for maximum smoothness and served over ice.',
+        sizes: ['Small (12 oz)', 'Medium (16 oz)', 'Large (20 oz)'],
+        milk: 'none'
+      }
+    };
+    const dialog = document.getElementById('order-dialog');
+    const form = document.getElementById('order-form');
+    const drink = document.getElementById('drink');
+    const size = document.getElementById('size');
+    const milk = document.getElementById('milk');
+    const confirmation = document.getElementById('discard-confirmation');
+    const summary = document.getElementById('order-summary');
+    const keepEditing = document.getElementById('keep-editing');
+    let hasChanges = false;
+    let opener;
+
+    function updateDrink() {
+      const details = drinks[drink.value];
+      document.getElementById('drink-description').textContent = details.description;
+      size.replaceChildren(...details.sizes.map(label => new Option(label, label)));
+      milk.value = details.milk;
+    }
+
+    function requestDismissal() {
+      if (hasChanges) {
+        confirmation.hidden = false;
+        keepEditing.focus();
+        return;
+      }
+      dialog.close();
+    }
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        opener = button;
+        form.reset();
+        drink.value = button.dataset.drink;
+        updateDrink();
+        hasChanges = false;
+        confirmation.hidden = true;
+        summary.textContent = '';
+        dialog.showModal();
+      });
+    });
+
+    // Latch changes until explicitly discarded, even if a value is changed back.
+    function markChanged() {
+      hasChanges = true;
+      summary.textContent = '';
+    }
+    form.addEventListener('input', markChanged);
+    form.addEventListener('change', markChanged);
+    drink.addEventListener('change', updateDrink);
+    document.getElementById('close-dialog').addEventListener('click', requestDismissal);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      requestDismissal();
+    });
+    // Only a pointer gesture that starts and ends outside the dialog dismisses it.
+    let pointerStartedOutside = false;
+    function isOutside(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+    dialog.addEventListener('pointerdown', event => {
+      pointerStartedOutside = event.target === dialog && isOutside(event);
+    });
+    dialog.addEventListener('click', event => {
+      if (pointerStartedOutside && event.target === dialog && isOutside(event)) requestDismissal();
+      pointerStartedOutside = false;
+    });
+    keepEditing.addEventListener('click', () => {
+      confirmation.hidden = true;
+      document.getElementById('close-dialog').focus();
+    });
+    document.getElementById('discard-changes').addEventListener('click', () => {
+      hasChanges = false;
+      form.reset();
+      dialog.close();
+    });
+    dialog.addEventListener('close', () => {
+      confirmation.hidden = true;
+      opener?.focus();
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const quantity = document.getElementById('quantity').value;
+      const milkLabel = milk.options[milk.selectedIndex].text;
+      const notes = document.getElementById('notes').value.trim();
+      summary.textContent = `${quantity} × ${drink.options[drink.selectedIndex].text}, ${size.value}, ${milkLabel.toLowerCase()}.${notes ? ` Instructions: ${notes}` : ''} This is a preview; no order has been placed.`;
+    });
+  </script>
+
