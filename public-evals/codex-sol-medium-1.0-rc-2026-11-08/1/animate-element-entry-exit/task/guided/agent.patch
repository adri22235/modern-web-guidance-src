+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const promos = [
+      ['A Perfect Pair', 'Pair any large coffee with a pastry and save $2.'],
+      ['Bring a Friend', 'Buy one cold brew and get a second half price.'],
+      ['Make It a Coffee Morning', 'Take 15% off a bag of our locally roasted beans.']
+    ];
+    let promoCount = 0;
+    let removing = false;
+
+    function updateControls() {
+      removeBtn.disabled = removing || !domContainer.querySelector('.card:not([hidden]):not([data-closing])');
+      const featuredVisible = toggleCard.isConnected && !toggleCard.hidden && !toggleCard.hasAttribute('data-closing');
+      toggleBtn.setAttribute('aria-expanded', String(featuredVisible));
+      toggleBtn.textContent = featuredVisible ? 'Hide Featured Promo' : 'Show Featured Promo';
+    }
+
+    async function hideCard(card) {
+      // Keep display intact during exit, including browsers without display transitions.
+      card.setAttribute('data-closing', '');
+      const animations = card.getAnimations();
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      card.hidden = true;
+      card.removeAttribute('data-closing');
+    }
+
+    addBtn.addEventListener('click', () => {
+      const [title, description] = promos[promoCount % promos.length];
+      promoCount += 1;
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+      const text = document.createElement('p');
+      text.textContent = description;
+      card.append(heading, text);
+      domContainer.append(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      if (removing) return;
+      const cards = domContainer.querySelectorAll('.card:not([hidden]):not([data-closing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+      removing = true;
+      if (card === toggleCard) toggleBtn.disabled = true;
+      updateControls();
+      await hideCard(card);
+      card.remove();
+      removing = false;
+      if (card === toggleCard) toggleBtn.disabled = false;
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (toggleBtn.disabled) return;
+      toggleBtn.disabled = true;
+      if (!toggleCard.isConnected || toggleCard.hidden) {
+        if (!toggleCard.isConnected) domContainer.prepend(toggleCard);
+        toggleCard.hidden = false;
+      } else {
+        await hideCard(toggleCard);
+      }
+      toggleBtn.disabled = false;
+      updateControls();
+    });
+
+    updateControls();
+  </script>
+
 </body>
 
