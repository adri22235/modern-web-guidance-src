@@ -206,7 +268,91 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const offers = [
+      ['A Perfect Pair', 'Save $2 when you pair a latte with a freshly baked pastry.'],
+      ['Bring Your Favorite Cup', 'Bring a reusable cup and enjoy 50¢ off your drink.'],
+      ['Coffee for Two', 'Buy a cold brew and get a second one half price.']
+    ];
+    let promoCount = 0;
+    let featuredVisible = true;
+    let featuredAnimation;
+
+    function animateCard(card, entering, start) {
+      return card.animate([
+        start || { opacity: entering ? 0 : 1, transform: entering ? 'scale(0.92)' : 'scale(1)' },
+        { opacity: entering ? 1 : 0, transform: entering ? 'scale(1)' : 'scale(0.92)' }
+      ], {
+        duration: reducedMotion.matches ? 0 : 260,
+        easing: 'ease-in-out',
+        fill: 'both'
+      });
+    }
+
+    function updateRemoveButton() {
+      // The featured offer is managed independently by its toggle.
+      removeBtn.disabled = !domContainer.querySelector('.card:not(#toggleCard):not([data-removing])');
+    }
+
+    addBtn.addEventListener('click', () => {
+      const [title, description] = offers[promoCount++ % offers.length];
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+      const copy = document.createElement('p');
+      copy.textContent = description;
+      card.append(heading, copy);
+      domContainer.append(card);
+      const animation = animateCard(card, true);
+      animation.finished.then(() => animation.cancel());
+      updateRemoveButton();
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(#toggleCard):not([data-removing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+      card.dataset.removing = 'true';
+      card.getAnimations().forEach(animation => animation.finish());
+      animateCard(card, false).finished.then(() => card.remove());
+      updateRemoveButton();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      featuredVisible = !featuredVisible;
+      const style = getComputedStyle(toggleCard);
+      const start = featuredAnimation
+        ? { opacity: style.opacity, transform: style.transform }
+        : undefined;
+      if (featuredAnimation) featuredAnimation.cancel();
+      toggleCard.hidden = false;
+      toggleBtn.setAttribute('aria-expanded', String(featuredVisible));
+      toggleBtn.textContent = featuredVisible ? 'Hide Featured Promo' : 'Show Featured Promo';
+      const animation = animateCard(toggleCard, featuredVisible, start);
+      featuredAnimation = animation;
+      animation.finished.then(() => {
+        toggleCard.hidden = !featuredVisible;
+        animation.cancel();
+        featuredAnimation = undefined;
+      }).catch(() => {}); // A new toggle cancels the previous transition.
+    });
+
+    const initialAnimation = animateCard(toggleCard, true);
+    featuredAnimation = initialAnimation;
+    initialAnimation.finished.then(() => {
+      initialAnimation.cancel();
+      featuredAnimation = undefined;
+    }).catch(() => {});
+  </script>
+
 </body>
 
