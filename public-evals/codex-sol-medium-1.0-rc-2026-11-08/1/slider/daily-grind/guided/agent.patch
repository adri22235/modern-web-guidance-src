+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthValue = document.getElementById('brew-strength-value');
+    const strengthLabels = document.querySelectorAll('.brew-strength-labels span');
+    const strengths = ['Mild', 'Medium', 'Bold', 'Extra Bold'];
+
+    function updateBrewStrength() {
+      const selected = Number(strengthSlider.value);
+      strengthValue.textContent = strengths[selected];
+      strengthSlider.setAttribute('aria-valuetext', strengths[selected]);
+      strengthSlider.style.setProperty('--attr-min', strengthSlider.min);
+      strengthSlider.style.setProperty('--attr-max', strengthSlider.max);
+      strengthSlider.style.setProperty('--control-value', strengthSlider.value);
+      strengthLabels.forEach((label, index) => {
+        label.dataset.selected = String(index === selected);
+      });
+    }
+
+    strengthSlider.addEventListener('input', updateBrewStrength);
+    updateBrewStrength();
+  </script>
