diff --git a/lib/app.mjs b/lib/app.mjs
new file mode 100644
index 0000000..db5e029
--- /dev/null
+++ b/lib/app.mjs
@@ -0,0 +1,85 @@
+import { randomBytes, scrypt as scryptCallback } from 'node:crypto';
+import { promisify } from 'node:util';
+import { verifyEmailVerificationToken } from './verify-email.mjs';
+
+const scrypt = promisify(scryptCallback);
+const escapeHtml = (text) => String(text).replace(/[&<>"']/g, (char) => ({
+  '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
+})[char]);
+const emailPattern = /^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$/;
+
+export function createApp({ template, store, origin, originTrialToken, verify = verifyEmailVerificationToken }) {
+  const publicOrigin = new URL(origin).origin;
+  if (publicOrigin !== origin || (new URL(origin).protocol !== 'https:' &&
+    !['localhost', '127.0.0.1'].includes(new URL(origin).hostname))) {
+    throw new Error('APP_ORIGIN must be an HTTPS origin (or HTTP localhost for development)');
+  }
+  const secure = origin.startsWith('https:');
+  const cookieName = secure ? '__Host-dg-signup' : 'dg-signup';
+  return async function handleRequest(request) {
+    const path = new URL(request.url).pathname;
+    if (path !== '/' && path !== '/api/verify-email') return new Response('Not found', { status: 404 });
+    const headers = new Headers({
+      'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff',
+      'Referrer-Policy': 'same-origin',
+      'Content-Security-Policy': "default-src 'none'; style-src 'unsafe-inline'; img-src https://images.unsplash.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'",
+    });
+    const cookie = request.headers.get('cookie')?.split(';').map((part) => part.trim())
+      .find((part) => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    const session = /^[A-Za-z0-9_-]{43}$/.test(cookie || '') ? cookie : randomBytes(32).toString('base64url');
+
+    function render(status, message = '', code) {
+      if (request.headers.get('accept')?.includes('application/json') && request.method === 'POST') {
+        headers.set('Content-Type', 'application/json');
+        return new Response(JSON.stringify({ ok: status === 201, code, message }), { status, headers });
+      }
+      const challenge = store.issue(session);
+      headers.set('Set-Cookie', `${cookieName}=${session}; HttpOnly; SameSite=Lax; Path=/; Max-Age=3600${secure ? '; Secure' : ''}`);
+      headers.set('Content-Type', 'text/html; charset=utf-8');
+      if (originTrialToken) headers.set('Origin-Trial', originTrialToken);
+      const html = template.replace('{{VERIFICATION_NONCE}}', challenge.nonce)
+        .replace('{{CSRF_TOKEN}}', challenge.csrf).replace('{{SIGNUP_STATUS}}', escapeHtml(message));
+      return new Response(html, { status, headers });
+    }
+
+    if (request.method === 'GET' && path === '/') return render(200);
+    if (request.method !== 'POST' || path !== '/api/verify-email') {
+      headers.set('Allow', path === '/' ? 'GET' : 'POST');
+      return new Response('Method not allowed', { status: 405, headers });
+    }
+    // Do not derive the relying-party origin from a user-controlled Host header.
+    if (request.headers.get('origin') !== publicOrigin || request.headers.get('sec-fetch-site') === 'cross-site') {
+      return render(403, 'Please open the homepage and try again.', 'invalid_origin');
+    }
+    if (!request.headers.get('content-type')?.startsWith('application/x-www-form-urlencoded')) {
+      return render(415, 'Please use the rewards form on the homepage.', 'invalid_content_type');
+    }
+    const body = await request.text();
+    if (Buffer.byteLength(body) > 32768) return render(413, 'The registration request is too large.', 'too_large');
+    const form = new URLSearchParams(body);
+    const nonce = store.consume(session, form.get('csrf') || '');
+    if (!nonce) return render(409, 'This registration form has expired or was already used. Please try again below.', 'expired_form');
+    const name = (form.get('name') || '').trim();
+    const email = (form.get('email') || '').trim();
+    const password = form.get('password') || '';
+    if (!name || name.length > 100 || email.length > 254 || !emailPattern.test(email) || password.length < 12 || password.length > 128) {
+      return render(400, 'Enter your name, a valid email address, and a password of 12–128 characters.', 'invalid_fields');
+    }
+    const rawToken = form.get('token') || '';
+    if (!rawToken) {
+      return render(422, 'Your browser could not confirm this email. Try a supported browser with your email provider signed in, or try again later. No verification email was sent and no account was created.', 'verification_unavailable');
+    }
+    try {
+      await verify({ rawToken, submittedEmail: email, expectedNonce: nonce, expectedAudience: publicOrigin });
+    } catch {
+      // Never log email addresses, passwords, or raw verification tokens.
+      return render(422, 'We could not confirm your email. Please try again below. No verification email was sent and no account was created.', 'verification_failed');
+    }
+    const salt = randomBytes(16).toString('base64url');
+    const hash = await scrypt(password, salt, 64, { N: 16384, r: 8, p: 1 });
+    const created = store.createAccount({ name, email, passwordHash: `scrypt:16384:8:1:${salt}:${hash.toString('base64url')}` });
+    return created
+      ? render(201, 'Welcome to Daily Grind Rewards! Your email is confirmed and your account is ready.', 'account_created')
+      : render(409, 'Your email is confirmed, but a rewards account already exists for this address.', 'account_exists');
+  };
+}
diff --git a/lib/store.mjs b/lib/store.mjs
new file mode 100644
index 0000000..6d79535
--- /dev/null
+++ b/lib/store.mjs
@@ -0,0 +1,45 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, randomUUID } from 'node:crypto';
+
+export function createStore(filename) {
+  const db = new DatabaseSync(filename);
+  db.exec(`
+    PRAGMA journal_mode = WAL;
+    CREATE TABLE IF NOT EXISTS signup_challenges (
+      csrf TEXT PRIMARY KEY, session TEXT NOT NULL, nonce TEXT NOT NULL, expires INTEGER NOT NULL
+    );
+    CREATE TABLE IF NOT EXISTS rewards_accounts (
+      id TEXT PRIMARY KEY, email TEXT NOT NULL, email_key TEXT NOT NULL UNIQUE,
+      name TEXT NOT NULL, password_hash TEXT NOT NULL, verified_at TEXT NOT NULL
+    );
+  `);
+  return {
+    issue(session) {
+      const now = Date.now();
+      db.prepare('DELETE FROM signup_challenges WHERE expires <= ?').run(now);
+      // Bound outstanding challenges without a background timer.
+      if (db.prepare('SELECT count(*) AS n FROM signup_challenges').get().n >= 10000) {
+        throw new Error('Too many pending registrations');
+      }
+      const csrf = randomBytes(32).toString('base64url');
+      const nonce = randomBytes(32).toString('base64url');
+      db.prepare('INSERT INTO signup_challenges VALUES (?, ?, ?, ?)')
+        .run(csrf, session, nonce, now + 10 * 60 * 1000);
+      return { csrf, nonce };
+    },
+    consume(session, csrf) {
+      // One atomic statement prevents concurrent submissions from reusing a nonce.
+      const challenge = db.prepare('DELETE FROM signup_challenges WHERE session = ? AND csrf = ? RETURNING nonce, expires')
+        .get(session, csrf);
+      return challenge && challenge.expires > Date.now() ? challenge.nonce : undefined;
+    },
+    createAccount({ name, email, passwordHash }) {
+      const result = db.prepare(`INSERT INTO rewards_accounts VALUES (?, ?, ?, ?, ?, ?)
+        ON CONFLICT(email_key) DO NOTHING`).run(
+        randomUUID(), email, email.toLowerCase(), name, passwordHash, new Date().toISOString(),
+      );
+      return result.changes === 1;
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/lib/verify-email.mjs b/lib/verify-email.mjs
new file mode 100644
index 0000000..e112d13
--- /dev/null
+++ b/lib/verify-email.mjs
@@ -0,0 +1,134 @@
+import { createHash } from 'node:crypto';
+import { lookup, resolveTxt } from 'node:dns/promises';
+import { BlockList, isIP } from 'node:net';
+import { request } from 'node:https';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify } from 'jose';
+
+const algorithms = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => alg === 'Ed25519' ? 'EdDSA' : alg;
+const hasher = (data, alg) => {
+  if (alg !== 'sha-256') throw new Error('Unsupported digest');
+  return createHash('sha256').update(data).digest();
+};
+const blocked = new BlockList();
+for (const [ip, bits] of [
+  ['0.0.0.0', 8], ['10.0.0.0', 8], ['100.64.0.0', 10], ['127.0.0.0', 8],
+  ['169.254.0.0', 16], ['172.16.0.0', 12], ['192.0.0.0', 24], ['192.0.2.0', 24],
+  ['192.168.0.0', 16], ['198.18.0.0', 15], ['198.51.100.0', 24], ['203.0.113.0', 24], ['224.0.0.0', 3],
+]) blocked.addSubnet(ip, bits, 'ipv4');
+const globalV6 = new BlockList();
+globalV6.addSubnet('2000::', 3, 'ipv6');
+blocked.addSubnet('2001::', 23, 'ipv6');
+blocked.addSubnet('2001:db8::', 32, 'ipv6');
+blocked.addSubnet('2002::', 16, 'ipv6');
+
+function httpsUrl(value) {
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.port || url.hash || isIP(url.hostname.replace(/^\[|\]$/g, ''))) {
+    throw new Error('Invalid public HTTPS URL');
+  }
+  return url;
+}
+
+// Fetch only public addresses, pin DNS resolution to the connection, reject redirects,
+// and bound response size/time. Discovery URLs are controlled by an untrusted issuer.
+export async function fetchPublicJson(value) {
+  const url = httpsUrl(value);
+  const addresses = await lookup(url.hostname, { all: true });
+  if (!addresses.length || addresses.some(({ address, family }) =>
+    blocked.check(address, family === 6 ? 'ipv6' : 'ipv4') ||
+    (family === 6 && !globalV6.check(address, 'ipv6')))) throw new Error('Non-public issuer address');
+  const address = addresses[0];
+  return new Promise((resolve, reject) => {
+    const req = request(url, {
+      lookup: (_host, options, done) => options.all
+        ? done(null, [address]) : done(null, address.address, address.family),
+      headers: { Accept: 'application/json' },
+    }, (res) => {
+      if (res.statusCode !== 200) {
+        res.resume();
+        req.destroy(new Error('Issuer request failed'));
+        return;
+      }
+      let size = 0;
+      const chunks = [];
+      res.on('data', (chunk) => {
+        size += chunk.length;
+        if (size > 65536) req.destroy(new Error('Issuer response too large'));
+        else chunks.push(chunk);
+      });
+      res.on('error', reject);
+      res.on('end', () => {
+        try { resolve(JSON.parse(Buffer.concat(chunks).toString('utf8'))); }
+        catch (error) { reject(error); }
+      });
+    });
+    const timer = setTimeout(() => req.destroy(new Error('Issuer request timed out')), 5000);
+    req.on('close', () => clearTimeout(timer));
+    req.on('error', reject);
+    req.end();
+  });
+}
+
+export async function verifyEmailVerificationToken({
+  rawToken, submittedEmail, expectedNonce, expectedAudience,
+}, { txtLookup = resolveTxt, getJson = fetchPublicJson } = {}) {
+  if (!expectedNonce || !rawToken || rawToken.length > 24000) throw new Error('Missing verification');
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const payload = decoded.jwt.payload;
+  const iss = payload.iss;
+  if (!decoded.kbJwt || typeof iss !== 'string' || payload.email_verified !== true ||
+    typeof payload.email !== 'string' || payload.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Invalid email claims');
+  }
+  const issuerUrl = httpsUrl(iss);
+  if (issuerUrl.origin !== iss) throw new Error('Issuer must be an origin');
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1);
+  const records = await txtLookup(`_email-verification.${domain}`);
+  if (!records.some((parts) => `https://${parts.join('').replace(/^iss=/, '').trim()}` === iss && parts.join('').startsWith('iss='))) {
+    throw new Error('Issuer is not delegated by email domain');
+  }
+  const metadata = await getJson(`${iss}/.well-known/email-verification`);
+  if (metadata.issuer !== iss) throw new Error('Issuer metadata mismatch');
+  httpsUrl(metadata.jwks_uri);
+  const jwks = createLocalJWKSet(await getJson(metadata.jwks_uri));
+  const evtOptions = {
+    // Current issuers use evt+jwt; accept ev+sd-jwt for earlier trial implementations.
+    typ: decoded.jwt.header.typ,
+    issuer: iss, algorithms, maxTokenAge: '5m', clockTolerance: 60,
+  };
+  if (!['evt+jwt', 'ev+sd-jwt'].includes(evtOptions.typ)) throw new Error('Unexpected EVT type');
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const token = `${data}.${sig}`;
+      try { await jwtVerify(token, jwks, evtOptions); }
+      catch (error) {
+        if (error.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw error;
+        let matched = false;
+        for await (const key of error) {
+          try { await jwtVerify(token, key, evtOptions); matched = true; break; }
+          catch { /* Try the next matching issuer key when kid is omitted. */ }
+        }
+        if (!matched) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const jwk = payload.cnf?.jwk;
+      const alg = decoded.kbJwt.header.alg;
+      if (!jwk || jwk.d || !algorithms.includes(jwk.alg) || !algorithms.includes(alg) ||
+        normalizeAlg(jwk.alg) !== normalizeAlg(alg)) throw new Error('Invalid holder key');
+      await jwtVerify(`${data}.${sig}`, await importJWK(jwk, alg), {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [alg],
+        maxTokenAge: '5m', clockTolerance: 60,
+      });
+      return true;
+    },
+  });
+  await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'], keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience, keyBindingMaxAgeSeconds: 300, skewSeconds: 60,
+  });
+}
