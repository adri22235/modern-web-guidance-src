@@ -0,0 +1,60 @@
+import { createServer } from 'node:http';
+import { readFile, mkdir } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+import { createApp } from './lib/app.mjs';
+import { createStore } from './lib/store.mjs';
+
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+if (process.env.NODE_ENV === 'production' && (!process.env.APP_ORIGIN || !origin.startsWith('https://'))) {
+  throw new Error('Production requires an explicit HTTPS APP_ORIGIN');
+}
+const databasePath = resolve(process.env.DATABASE_PATH || 'data/rewards.sqlite');
+await mkdir(dirname(databasePath), { recursive: true, mode: 0o700 });
+const store = createStore(databasePath);
+const handle = createApp({
+  template: await readFile(new URL('./index.html', import.meta.url), 'utf8'), store, origin,
+  originTrialToken: process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN,
+});
+
+// Small process-local rate limit; use an edge rate limiter for multi-instance hosting.
+const attempts = new Map();
+const server = createServer(async (req, res) => {
+  try {
+    const now = Date.now();
+    for (const [key, value] of attempts) if (value.expires <= now) attempts.delete(key);
+    const key = req.socket.remoteAddress;
+    const bucket = attempts.get(key) || { count: 0, expires: now + 60000 };
+    bucket.count++;
+    attempts.set(key, bucket);
+    if (bucket.count > 30 || attempts.size > 10000) {
+      res.writeHead(429, { 'Retry-After': '60', 'Cache-Control': 'no-store' });
+      res.end('Too many requests. Please try again in a minute.');
+      return;
+    }
+    const chunks = [];
+    let size = 0;
+    for await (const chunk of req) {
+      size += chunk.length;
+      if (size > 32768) {
+        res.writeHead(413, { 'Cache-Control': 'no-store' });
+        res.end('Request too large');
+        return;
+      }
+      chunks.push(chunk);
+    }
+    const request = new Request(new URL(req.url, origin), {
+      method: req.method, headers: req.headers,
+      body: ['GET', 'HEAD'].includes(req.method) ? undefined : Buffer.concat(chunks),
+    });
+    const response = await handle(request);
+    res.writeHead(response.status, Object.fromEntries(response.headers));
+    res.end(Buffer.from(await response.arrayBuffer()));
+  } catch {
+    res.writeHead(500, { 'Content-Type': 'text/plain', 'Cache-Control': 'no-store' });
+    res.end('Registration is temporarily unavailable. Please try again later.');
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(port, () => console.log(`Daily Grind listening on port ${port}`));
diff --git a/test/rewards.test.mjs b/test/rewards.test.mjs
new file mode 100644
index 0000000..a43d4ef
--- /dev/null
+++ b/test/rewards.test.mjs
@@ -0,0 +1,154 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { exportJWK, generateKeyPair, SignJWT } from 'jose';
+import { createApp } from '../lib/app.mjs';
+import { createStore } from '../lib/store.mjs';
+import { verifyEmailVerificationToken } from '../lib/verify-email.mjs';
+
+const origin = 'https://dailygrind.example';
+const issuer = 'https://accounts.example';
+const issuerKeys = await generateKeyPair('ES256');
+const wrongKeys = await generateKeyPair('ES256');
+const attackerKeys = await generateKeyPair('ES256');
+const holderKeys = await generateKeyPair('ES256');
+const issuerJwk = { ...await exportJWK(issuerKeys.publicKey), alg: 'ES256' };
+const holderJwk = { ...await exportJWK(holderKeys.publicKey), alg: 'ES256' };
+const nonce = 'a-server-generated-test-nonce';
+const dependencies = {
+  txtLookup: async () => [['iss=accounts.', 'example']],
+  getJson: async (url) => url.endsWith('email-verification')
+    ? { issuer, jwks_uri: `${issuer}/keys` }
+    // Multiple keys and no kid deliberately exercise provider compatibility.
+    : { keys: [{ ...await exportJWK(wrongKeys.publicKey), alg: 'ES256' }, issuerJwk] },
+};
+
+async function presentation({ email = 'Coffee@example.com', verified = true, aud = origin,
+  boundNonce = nonce, age = 0, invalidHash = false, wrongIssuerKey = false, wrongHolderKey = false,
+  type = 'evt+jwt' } = {}) {
+  const iat = Math.floor(Date.now() / 1000) - age;
+  const evt = await new SignJWT({ iss: issuer, iat, email, email_verified: verified, cnf: { jwk: holderJwk } })
+    .setProtectedHeader({ alg: 'ES256', typ: type }).sign(wrongIssuerKey ? attackerKeys.privateKey : issuerKeys.privateKey);
+  const sd_hash = invalidHash ? 'bad-hash' : createHash('sha256').update(`${evt}~`).digest('base64url');
+  const kb = await new SignJWT({ aud, nonce: boundNonce, iat, sd_hash })
+    .setProtectedHeader({ alg: 'ES256', typ: 'kb+jwt' }).sign(wrongHolderKey ? wrongKeys.privateKey : holderKeys.privateKey);
+  return `${evt}~${kb}`;
+}
+
+const verify = (rawToken, overrides = {}) => verifyEmailVerificationToken({
+  rawToken, submittedEmail: 'coffee@example.com', expectedNonce: nonce, expectedAudience: origin,
+}, { ...dependencies, ...overrides });
+
+test('verifies real signatures, case-insensitive email, and missing kid with multiple keys', async () => {
+  await verify(await presentation());
+});
+for (const [description, options] of [
+  ['wrong email', { email: 'other@example.com' }], ['unverified claim', { verified: false }],
+  ['wrong audience', { aud: 'https://attacker.example' }], ['wrong nonce', { boundNonce: 'wrong' }],
+  ['expired presentation', { age: 500 }], ['future presentation', { age: -500 }],
+  ['wrong SD hash', { invalidHash: true }], ['forged issuer signature', { wrongIssuerKey: true }],
+  ['forged browser signature', { wrongHolderKey: true }], ['incorrect token type', { type: 'JWT' }],
+]) {
+  test(`rejects ${description}`, async () => { await assert.rejects(verify(await presentation(options))); });
+}
+test('rejects an undelegated issuer before making any HTTPS request', async () => {
+  await assert.rejects(verify(await presentation(), {
+    txtLookup: async () => [['iss=evil.example']],
+    getJson: async () => assert.fail('Must not fetch an undelegated issuer'),
+  }));
+});
+test('rejects issuer metadata mismatch', async () => {
+  await assert.rejects(verify(await presentation(), {
+    getJson: async () => ({ issuer: 'https://evil.example', jwks_uri: `${issuer}/keys` }),
+  }));
+});
+test('rejects missing key binding and malformed tokens', async () => {
+  const rawToken = await presentation();
+  await assert.rejects(verify(`${rawToken.split('~')[0]}~`));
+  await assert.rejects(verify('not-a-token'));
+});
+
+const template = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+async function setup(t, verifier = verifyEmailVerificationToken) {
+  const store = createStore(':memory:');
+  t.after(() => store.close());
+  const handle = createApp({ template, store, origin, verify: verifier, originTrialToken: 'configured-trial-token' });
+  const page = await handle(new Request(`${origin}/`));
+  const html = await page.text();
+  const csrf = html.match(/name="csrf" value="([^"]+)"/)[1];
+  const renderedNonce = html.match(/nonce="([^"]+)"/)[1];
+  const cookie = page.headers.get('set-cookie').split(';')[0];
+  function post(fields = {}, extraHeaders = {}) {
+    return handle(new Request(`${origin}/api/verify-email`, {
+      method: 'POST',
+      headers: { origin, cookie, accept: 'application/json', 'content-type': 'application/x-www-form-urlencoded', ...extraHeaders },
+      body: new URLSearchParams({ name: 'Alex Coffee', email: 'coffee@example.com', password: 'a strong coffee password', csrf, token: '', ...fields }),
+    }));
+  }
+  return { store, handle, page, html, csrf, renderedNonce, cookie, post };
+}
+test('renders same-form token, fresh server nonce, CSRF, secure cookie, and trial header', async (t) => {
+  const { page, html, renderedNonce, handle } = await setup(t);
+  assert.equal(page.headers.get('cache-control'), 'no-store');
+  assert.match(page.headers.get('set-cookie'), /HttpOnly; SameSite=Lax; Path=\/; Max-Age=3600; Secure/);
+  assert.equal(page.headers.get('origin-trial'), 'configured-trial-token');
+  assert.match(html, /autocomplete="email-verification-token"/);
+  assert.doesNotMatch(html, /\{\{/);
+  const fresh = await handle(new Request(`${origin}/`));
+  assert.ok(!(await fresh.text()).includes(renderedNonce));
+});
+test('no-token submission remains unverified, sends no email, and consumes nonce', async (t) => {
+  const { post } = await setup(t, async () => assert.fail('No token to verify'));
+  const response = await post();
+  assert.equal(response.status, 422);
+  assert.equal((await response.json()).code, 'verification_unavailable');
+  assert.equal((await post()).status, 409);
+});
+test('verified signup creates a persistent account with a salted password hash', async (t) => {
+  let saved;
+  const { post, store, renderedNonce } = await setup(t, async (args) => {
+    await verifyEmailVerificationToken(args, dependencies);
+  });
+  const create = store.createAccount;
+  store.createAccount = (account) => { saved = account; return create(account); };
+  const token = await presentation({ boundNonce: renderedNonce });
+  const response = await post({ token });
+  assert.equal(response.status, 201);
+  assert.equal((await response.json()).code, 'account_created');
+  assert.match(saved.passwordHash, /^scrypt:16384:8:1:/);
+  assert.ok(!saved.passwordHash.includes('a strong coffee password'));
+  assert.equal(create(saved), false);
+  assert.equal((await post({ token })).status, 409);
+});
+test('invalid token cannot create an account', async (t) => {
+  const { post, store } = await setup(t);
+  store.createAccount = () => assert.fail('Must not create an unverified account');
+  assert.equal((await post({ token: 'forged' })).status, 422);
+});
+test('rejects cross-origin requests and wrong CSRF tokens', async (t) => {
+  const { post } = await setup(t);
+  assert.equal((await post({}, { origin: 'https://evil.example' })).status, 403);
+  assert.equal((await post({ csrf: 'wrong' })).status, 409);
+});
+test('validates fields on server even if browser constraints are bypassed', async (t) => {
+  const { post } = await setup(t);
+  assert.equal((await post({ password: 'short', token: 'forged' })).status, 400);
+});
+test('native HTML POST shows feedback and a fresh retry challenge without JavaScript', async (t) => {
+  const { post, renderedNonce } = await setup(t);
+  const response = await post({}, { accept: 'text/html' });
+  assert.equal(response.status, 422);
+  const html = await response.text();
+  assert.match(html, /No verification email was sent/);
+  assert.ok(!html.includes(renderedNonce));
+});
+test('a challenge cannot be consumed by another session or consumed twice', () => {
+  const store = createStore(':memory:');
+  try {
+    const challenge = store.issue('session-a');
+    assert.equal(store.consume('session-b', challenge.csrf), undefined);
+    assert.equal(store.consume('session-a', challenge.csrf), challenge.nonce);
+    assert.equal(store.consume('session-a', challenge.csrf), undefined);
+  } finally { store.close(); }
+});
