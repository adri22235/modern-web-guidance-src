diff --git a/rewards.js b/rewards.js
new file mode 100644
index 0000000..6872be2
--- /dev/null
+++ b/rewards.js
@@ -0,0 +1,147 @@
+const form = document.querySelector('#rewards-form');
+const fields = document.querySelector('#signup-fields');
+const nextButton = document.querySelector('#signup-continue');
+const message = document.querySelector('#signup-message');
+const verification = document.querySelector('#verification-step');
+const editButton = document.querySelector('#edit-details');
+let registration;
+let working = false;
+let googleScript;
+let generation = 0;
+
+function showMessage(text) {
+  message.textContent = text;
+  message.hidden = !text;
+}
+
+function loadGoogle() {
+  if (window.google?.accounts?.id) return Promise.resolve();
+  if (googleScript) return googleScript;
+  googleScript = new Promise((resolve, reject) => {
+    const script = document.createElement('script');
+    const timer = setTimeout(() => {
+      script.remove();
+      googleScript = undefined;
+      reject(new Error('Google took too long to respond. Please try again.'));
+    }, 15000);
+    script.src = 'https://accounts.google.com/gsi/client';
+    script.async = true;
+    script.onload = () => { clearTimeout(timer); resolve(); };
+    script.onerror = () => {
+      clearTimeout(timer);
+      script.remove();
+      googleScript = undefined;
+      reject(new Error('Google could not load. Check your connection or content blocker and try again.'));
+    };
+    document.head.append(script);
+  });
+  return googleScript;
+}
+
+async function post(path, body) {
+  const response = await fetch(path, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    credentials: 'same-origin',
+    body: JSON.stringify(body),
+    signal: AbortSignal.timeout(20000),
+  });
+  let result;
+  try { result = await response.json(); }
+  catch { throw new Error('Email verification is unavailable. Please try again later.'); }
+  if (!response.ok) throw new Error(result.error || 'Registration failed. Please try again.');
+  return result;
+}
+
+function resetDetails() {
+  generation++;
+  registration = undefined;
+  fields.disabled = false;
+  nextButton.hidden = false;
+  nextButton.disabled = false;
+  verification.hidden = true;
+  document.querySelector('#signup-note').hidden = false;
+  document.querySelector('#verify-progress').classList.remove('active');
+  document.querySelector('#google-button').replaceChildren();
+  showMessage('');
+}
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (working || !form.reportValidity()) return;
+  if (!document.querySelector('#rewards-name').value.trim()) {
+    showMessage('Please enter your name.');
+    document.querySelector('#rewards-name').focus();
+    return;
+  }
+  working = true;
+  nextButton.disabled = true;
+  fields.disabled = true;
+  showMessage('Preparing secure email verification…');
+  try {
+    registration = {
+      name: document.querySelector('#rewards-name').value.trim(),
+      email: document.querySelector('#rewards-email').value.trim().toLowerCase(),
+      termsAccepted: document.querySelector('#rewards-terms-check').checked,
+      marketingConsent: document.querySelector('#rewards-marketing').checked,
+    };
+    const challenge = await post('/api/rewards/challenge', {});
+    await loadGoogle();
+    const attempt = ++generation;
+    window.google.accounts.id.initialize({
+      client_id: challenge.clientId,
+      nonce: challenge.nonce,
+      auto_select: false,
+      callback: (response) => completeRegistration(response, attempt),
+    });
+    verification.hidden = false;
+    nextButton.hidden = true;
+    document.querySelector('#signup-note').hidden = true;
+    document.querySelector('#verify-progress').classList.add('active');
+    window.google.accounts.id.renderButton(document.querySelector('#google-button'), {
+      type: 'standard', theme: 'outline', size: 'large', text: 'signup_with', shape: 'rectangular',
+    });
+    showMessage('');
+    document.querySelector('#google-button [tabindex]')?.focus();
+  } catch (error) {
+    resetDetails();
+    showMessage(error.name === 'TimeoutError' || error instanceof TypeError ? 'Could not connect. Check your connection and try again.' : error.message);
+  } finally {
+    working = false;
+    nextButton.disabled = false;
+  }
+});
+
+async function completeRegistration(response, attempt) {
+  if (working || !registration || attempt !== generation) return;
+  working = true;
+  editButton.disabled = true;
+  document.querySelector('#google-button').hidden = true;
+  showMessage('Verifying your email and creating your account…');
+  try {
+    const { account } = await post('/api/rewards/register', { ...registration, credential: response.credential });
+    document.querySelector('#success-name').textContent = account.name;
+    document.querySelector('#success-email').textContent = account.email;
+    document.querySelector('#signup-content').hidden = true;
+    const success = document.querySelector('#signup-success');
+    success.hidden = false;
+    success.focus();
+    registration = undefined;
+  } catch (error) {
+    resetDetails();
+    showMessage(error.name === 'TimeoutError' || error instanceof TypeError ? 'Could not confirm registration. Try again; if your account was created, we will let you know.' : error.message);
+  } finally {
+    working = false;
+    editButton.disabled = false;
+    document.querySelector('#google-button').hidden = false;
+  }
+}
+
+editButton.addEventListener('click', () => {
+  if (working) return;
+  resetDetails();
+  document.querySelector('#rewards-email').focus();
+});
+document.querySelector('#terms-link').addEventListener('click', () => {
+  document.querySelector('#rewards-terms').open = true;
+});
diff --git a/scripts/build.js b/scripts/build.js
new file mode 100644
