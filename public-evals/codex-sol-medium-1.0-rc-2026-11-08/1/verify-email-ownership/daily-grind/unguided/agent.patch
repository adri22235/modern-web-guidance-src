@@ -0,0 +1,122 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+import { openStore } from './store.js';
+import { RegistrationError, validateRegistration, verifyGoogleEmail } from './verification.js';
+
+const clientId = process.env.GOOGLE_CLIENT_ID || '';
+const origin = new URL(process.env.APP_ORIGIN || 'http://localhost:11222').origin;
+if (process.env.NODE_ENV === 'production' && !origin.startsWith('https://')) {
+  throw new Error('APP_ORIGIN must use HTTPS in production.');
+}
+const secureCookie = origin.startsWith('https://') ? '; Secure' : '';
+const root = fileURLToPath(new URL('../', import.meta.url));
+const store = openStore(resolve(process.env.DATA_DIR || resolve(root, 'data')));
+const challenges = new Map();
+const rateLimits = new Map();
+const ttl = 10 * 60 * 1000;
+
+function reply(res, status, data, headers = {}) {
+  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store', ...headers });
+  res.end(JSON.stringify(data));
+}
+
+async function readBody(req) {
+  if (!req.headers['content-type']?.startsWith('application/json')) {
+    throw new RegistrationError('Send a JSON registration request.', 415);
+  }
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += chunk.length;
+    if (size > 16384) throw new RegistrationError('Registration request is too large.', 413);
+    chunks.push(chunk);
+  }
+  try { return JSON.parse(Buffer.concat(chunks).toString('utf8')); }
+  catch { throw new RegistrationError('Invalid registration request.'); }
+}
+
+function cookie(req) {
+  return req.headers.cookie?.split(';').map(v => v.trim()).find(v => v.startsWith('dg_registration='))?.slice(16);
+}
+
+const server = createServer(async (req, res) => {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  const pathname = new URL(req.url, origin).pathname;
+  try {
+    if (pathname.startsWith('/api/')) {
+      if (req.method !== 'POST') return reply(res, 405, { error: 'Use POST.' }, { Allow: 'POST' });
+      if (req.headers.origin !== origin) throw new RegistrationError('Please register from the Daily Grind website.', 403);
+      const now = Date.now();
+      const ip = req.socket.remoteAddress;
+      // Deliberately ignore client-supplied forwarding headers.
+      const bucket = rateLimits.get(ip) || { expires: now + ttl, count: 0 };
+      if (bucket.expires < now) { bucket.count = 0; bucket.expires = now + ttl; }
+      bucket.count++;
+      rateLimits.set(ip, bucket);
+      if (bucket.count > 30) return reply(res, 429, { error: 'Too many attempts. Please try again in 10 minutes.' }, { 'Retry-After': '600' });
+      if (!clientId || clientId.startsWith('your-client-id')) {
+        throw new RegistrationError('Email verification is temporarily unavailable. Please try again later.', 503);
+      }
+      if (pathname === '/api/rewards/challenge') {
+        await readBody(req);
+        if (challenges.size >= 10000) throw new RegistrationError('Please try again shortly.', 503);
+        const previous = cookie(req);
+        if (previous) challenges.delete(previous);
+        const session = randomBytes(32).toString('base64url');
+        const nonce = randomBytes(32).toString('base64url');
+        challenges.set(session, { nonce, expires: now + ttl, inProgress: false });
+        return reply(res, 200, { clientId, nonce }, {
+          'Set-Cookie': `dg_registration=${session}; HttpOnly; SameSite=Strict; Path=/api/rewards; Max-Age=600${secureCookie}`,
+        });
+      }
+      if (pathname === '/api/rewards/register') {
+        const input = validateRegistration(await readBody(req));
+        const session = cookie(req);
+        const challenge = challenges.get(session);
+        if (!challenge || challenge.expires < Date.now() || challenge.inProgress) {
+          throw new RegistrationError('This verification has expired. Please start again.', 401);
+        }
+        challenge.inProgress = true;
+        try {
+          const identity = await verifyGoogleEmail(input.credential, { clientId, nonce: challenge.nonce, email: input.email });
+          if (challenge.expires < Date.now() || challenges.get(session) !== challenge) {
+            throw new RegistrationError('This verification has expired. Please start again.', 401);
+          }
+          const account = store.create({ ...input, ...identity });
+          challenges.delete(session);
+          return reply(res, 201, { account }, {
+            'Set-Cookie': `dg_registration=; HttpOnly; SameSite=Strict; Path=/api/rewards; Max-Age=0${secureCookie}`,
+          });
+        } finally { challenge.inProgress = false; }
+      }
+      return reply(res, 404, { error: 'Endpoint not found.' });
+    }
+    if (!['GET', 'HEAD'].includes(req.method)) return reply(res, 405, { error: 'Method not allowed.' }, { Allow: 'GET, HEAD' });
+    const files = { '/': ['index.html', 'text/html'], '/index.html': ['index.html', 'text/html'], '/rewards.js': ['rewards.js', 'text/javascript'] };
+    const file = files[pathname];
+    if (!file) return reply(res, 404, { error: 'Page not found.' });
+    const contents = await readFile(resolve(root, file[0]));
+    res.writeHead(200, { 'Content-Type': `${file[1]}; charset=utf-8`, 'Cache-Control': 'no-cache' });
+    res.end(req.method === 'HEAD' ? undefined : contents);
+  } catch (error) {
+    if (!(error instanceof RegistrationError)) console.error('Registration service failure:', error.name);
+    reply(res, error instanceof RegistrationError ? error.status : 500, {
+      error: error instanceof RegistrationError ? error.message : 'Something went wrong. Please try again later.',
+    });
+  }
+});
+
+const cleanup = setInterval(() => {
+  const now = Date.now();
+  for (const [key, value] of challenges) if (value.expires < now) challenges.delete(key);
+  for (const [key, value] of rateLimits) if (value.expires < now) rateLimits.delete(key);
+}, 60000);
+cleanup.unref();
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222));
diff --git a/server/store.js b/server/store.js
new file mode 100644
index 0000000..0bb91f6
--- /dev/null
+++ b/server/store.js
@@ -0,0 +1,34 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { RegistrationError } from './verification.js';
+
+export function openStore(directory) {
+  mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const db = new DatabaseSync(join(directory, 'rewards.sqlite'));
+  db.exec(`PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS rewards_accounts (
+      id TEXT PRIMARY KEY,
+      google_subject TEXT NOT NULL UNIQUE,
+      email TEXT NOT NULL UNIQUE,
+      name TEXT NOT NULL,
+      email_verified_at TEXT NOT NULL,
+      terms_version TEXT NOT NULL,
+      terms_accepted_at TEXT NOT NULL,
+      marketing_consent INTEGER NOT NULL,
+      created_at TEXT NOT NULL
+    );`);
+  const insert = db.prepare(`INSERT INTO rewards_accounts VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+    ON CONFLICT DO NOTHING`);
+  return {
+    create({ subject, email, name, marketingConsent }) {
+      const id = randomUUID();
+      const now = new Date().toISOString();
+      const result = insert.run(id, subject, email, name, now, '2026-11-08', now, marketingConsent ? 1 : 0, now);
+      if (result.changes !== 1) throw new RegistrationError('An account already exists. Visit the café for help with your rewards.', 409);
+      return { id, name, email, emailVerified: true };
+    },
+    close() { db.close(); },
+  };
+}
diff --git a/server/verification.js b/server/verification.js
new file mode 100644
index 0000000..6c687d3
--- /dev/null
+++ b/server/verification.js
@@ -0,0 +1,64 @@
+import { createRemoteJWKSet, jwtVerify } from 'jose';
+
+const googleKeys = createRemoteJWKSet(new URL('https://www.googleapis.com/oauth2/v3/certs'));
+
+export class RegistrationError extends Error {
+  constructor(message, status = 400) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export function validateRegistration(body) {
+  if (!body || typeof body !== 'object' || Array.isArray(body)) {
+    throw new RegistrationError('Please complete the registration form.');
+  }
+  const { name, email, credential, termsAccepted, marketingConsent } = body;
+  if (typeof name !== 'string' || !name.trim() || name.trim().length > 80) {
+    throw new RegistrationError('Enter a name of up to 80 characters.');
+  }
+  if (typeof email !== 'string' || email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
+    throw new RegistrationError('Enter a valid email address.');
+  }
+  if (termsAccepted !== true) throw new RegistrationError('Please agree to the rewards terms.');
+  if (typeof credential !== 'string' || credential.length > 12000 || !credential) {
+    throw new RegistrationError('Verify your email with Google to continue.');
+  }
+  if (marketingConsent !== undefined && typeof marketingConsent !== 'boolean') {
+    throw new RegistrationError('Invalid email preferences.');
+  }
+  return { name: name.trim(), email: email.trim().toLowerCase(), credential, marketingConsent: marketingConsent === true };
+}
+
+export async function verifyGoogleEmail(credential, { clientId, nonce, email, keys = googleKeys }) {
+  let payload;
+  try {
+    ({ payload } = await jwtVerify(credential, keys, {
+      algorithms: ['RS256'],
+      issuer: ['https://accounts.google.com', 'accounts.google.com'],
+      audience: clientId,
+      requiredClaims: ['exp', 'iat', 'sub', 'email', 'email_verified', 'nonce'],
+      maxTokenAge: '10 minutes',
+    }));
+  } catch {
+    throw new RegistrationError('Google verification could not be confirmed. Please try again.', 401);
+  }
+  if (!nonce || payload.nonce !== nonce || typeof payload.sub !== 'string' || !payload.sub) {
+    throw new RegistrationError('This verification has expired. Please start again.', 401);
+  }
+  if (payload.azp !== undefined && payload.azp !== clientId) {
+    throw new RegistrationError('Google verification could not be confirmed.', 401);
+  }
+  if (payload.email_verified !== true || typeof payload.email !== 'string') {
+    throw new RegistrationError('Google has not verified this email address.', 401);
+  }
+  const verifiedEmail = payload.email.toLowerCase();
+  // A third-party address on a personal Google account is not proof of current ownership.
+  if (!verifiedEmail.endsWith('@gmail.com') && !(typeof payload.hd === 'string' && payload.hd.length > 0)) {
+    throw new RegistrationError('Use a Gmail or Google Workspace email so Google can confirm ownership.', 401);
+  }
+  if (verifiedEmail !== email) {
+    throw new RegistrationError('Choose the Google account that matches the email you entered.', 401);
+  }
+  return { subject: payload.sub, email: verifiedEmail };
+}
diff --git a/tests/registration.test.js b/tests/registration.test.js
new file mode 100644
index 0000000..a34fabb
--- /dev/null
+++ b/tests/registration.test.js
@@ -0,0 +1,81 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeyPair, SignJWT } from 'jose';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { validateRegistration, verifyGoogleEmail } from '../server/verification.js';
+import { openStore } from '../server/store.js';
+
+const { publicKey, privateKey } = await generateKeyPair('RS256');
+const clientId = 'test.apps.googleusercontent.com';
+const email = 'alex@gmail.com';
+const nonce = 'unpredictable-test-nonce';
+const options = { clientId, email, nonce, keys: publicKey };
+async function token(claims = {}, settings = {}) {
+  return new SignJWT({ email, email_verified: true, nonce, ...claims })
+    .setProtectedHeader({ alg: 'RS256' })
+    .setIssuer(settings.issuer || 'https://accounts.google.com')
+    .setAudience(settings.audience || clientId)
+    .setSubject('google-subject-123')
+    .setIssuedAt(settings.issuedAt || Math.floor(Date.now() / 1000))
+    .setExpirationTime(settings.expires || '5m')
+    .sign(privateKey);
+}
+
+test('accepts a signed, verified Gmail identity with the correct audience and nonce', async () => {
+  assert.deepEqual(await verifyGoogleEmail(await token(), options), { subject: 'google-subject-123', email });
+});
+test('accepts verified Workspace identity with signed hosted-domain claim', async () => {
+  const credential = await token({ email: 'alex@example.org', hd: 'example.org' });
+  assert.equal((await verifyGoogleEmail(credential, { ...options, email: 'alex@example.org' })).email, 'alex@example.org');
+});
+for (const [name, claims, settings] of [
+  ['unverified email', { email_verified: false }, {}],
+  ['string instead of verified boolean', { email_verified: 'true' }, {}],
+  ['wrong nonce', { nonce: 'different-browser' }, {}],
+  ['missing nonce', { nonce: undefined }, {}],
+  ['mismatched form email', { email: 'other@gmail.com' }, {}],
+  ['third-party email without Google authority', { email: 'alex@example.org' }, {}],
+  ['wrong authorized party', { azp: 'other-client' }, {}],
+  ['wrong audience', {}, { audience: 'attacker-client' }],
+  ['wrong issuer', {}, { issuer: 'https://attacker.example' }],
+  ['expired token', {}, { expires: Math.floor(Date.now() / 1000) - 60 }],
+  ['old token', {}, { issuedAt: Math.floor(Date.now() / 1000) - 1200 }],
+]) {
+  test(`rejects ${name}`, async () => {
+    await assert.rejects(verifyGoogleEmail(await token(claims, settings), options));
+  });
+}
+test('rejects forged signature and unsigned claims', async () => {
+  const { privateKey: attacker } = await generateKeyPair('RS256');
+  const forged = await new SignJWT({ email, email_verified: true, nonce })
+    .setProtectedHeader({ alg: 'RS256' }).setSubject('attacker').setIssuer('https://accounts.google.com')
+    .setAudience(clientId).setIssuedAt().setExpirationTime('5m').sign(attacker);
+  await assert.rejects(verifyGoogleEmail(forged, options));
+  await assert.rejects(verifyGoogleEmail('not-a-signed-token', options));
+});
+test('normalizes registration details and requires explicit consent', () => {
+  const body = { name: ' Alex ', email: ' ALEX@gmail.com ', termsAccepted: true, credential: 'token' };
+  assert.deepEqual(validateRegistration(body), { name: 'Alex', email, credential: 'token', marketingConsent: false });
+  for (const invalid of [null, [], { ...body, name: ' ' }, { ...body, email: 'bad-address' },
+    { ...body, termsAccepted: 'true' }, { ...body, credential: '' }, { ...body, marketingConsent: 'true' }]) {
+    assert.throws(() => validateRegistration(invalid));
+  }
+});
+test('persists verified accounts and prevents duplicate email or identity', () => {
+  const directory = mkdtempSync(join(tmpdir(), 'daily-grind-test-'));
+  let store = openStore(directory);
+  try {
+    const input = { subject: 'subject-one', email, name: 'Alex', marketingConsent: false };
+    assert.equal(store.create(input).emailVerified, true);
+    assert.throws(() => store.create({ ...input, subject: 'subject-two' }), { status: 409 });
+    assert.throws(() => store.create({ ...input, email: 'other@gmail.com' }), { status: 409 });
+    store.close();
+    store = openStore(directory);
+    assert.throws(() => store.create(input), { status: 409 });
+  } finally {
+    store.close();
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
