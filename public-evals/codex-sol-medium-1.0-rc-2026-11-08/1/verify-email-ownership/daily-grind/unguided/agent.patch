+++ b/scripts/build.js
@@ -0,0 +1,16 @@
+import { spawnSync } from 'node:child_process';
+import { cp, mkdir, rm } from 'node:fs/promises';
+
+// Static checks and isolated module tests only; never imports or starts the HTTP server.
+for (const file of ['server/index.js', 'server/verification.js', 'server/store.js', 'rewards.js']) {
+  const result = spawnSync(process.execPath, ['--check', file], { stdio: 'inherit' });
+  if (result.status !== 0) process.exit(result.status || 1);
+}
+const tests = spawnSync(process.execPath, ['--test', 'tests/registration.test.js'], { stdio: 'inherit' });
+if (tests.status !== 0) process.exit(tests.status || 1);
+await rm('dist', { recursive: true, force: true });
+await mkdir('dist', { recursive: true });
+for (const path of ['index.html', 'rewards.js', 'server', 'package.json', 'package-lock.json', '.env.example']) {
+  await cp(path, `dist/${path}`, { recursive: true });
+}
+console.log('Build complete. Server and homepage packaged in dist/. No server was started.');
