+  <script>
+    const cardElement = document.getElementById('export_element');
+    const messageInput = document.getElementById('gift-text');
+    const messageElement = document.getElementById('gift-message');
+    const colorInput = document.getElementById('gift-color');
+    const canvas = document.getElementById('gift-canvas');
+    const exportButton = document.getElementById('export-gift');
+    const status = document.getElementById('gift-status');
+
+    // Render the card's actual HTML boxes and wrapped text at export resolution.
+    // All artwork is local CSS, so exports need no external images or services.
+    function renderCard() {
+      const bounds = cardElement.getBoundingClientRect();
+      if (!bounds.width) return;
+      canvas.width = 1500;
+      canvas.height = Math.round(1500 * bounds.height / bounds.width);
+      const context = canvas.getContext('2d');
+      if (!context) throw new Error('Canvas is unavailable.');
+      context.scale(canvas.width / bounds.width, canvas.height / bounds.height);
+
+      function paint(element) {
+        const style = getComputedStyle(element);
+        const box = element.getBoundingClientRect();
+        const x = box.left - bounds.left;
+        const y = box.top - bounds.top;
+        if (style.backgroundColor !== 'rgba(0, 0, 0, 0)') {
+          const radius = (value) => value.endsWith('%')
+            ? { x: box.width * parseFloat(value) / 100, y: box.height * parseFloat(value) / 100 }
+            : parseFloat(value) || 0;
+          context.fillStyle = style.backgroundColor;
+          context.beginPath();
+          context.roundRect(x, y, box.width, box.height, [
+            style.borderTopLeftRadius, style.borderTopRightRadius,
+            style.borderBottomRightRadius, style.borderBottomLeftRadius
+          ].map(radius));
+          context.fill();
+        }
+        for (const child of element.childNodes) {
+          if (child.nodeType === Node.ELEMENT_NODE) {
+            paint(child);
+          } else if (child.nodeType === Node.TEXT_NODE && child.textContent.trim()) {
+            context.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
+            context.fillStyle = style.color;
+            context.textBaseline = 'top';
+            // Character ranges preserve the browser's wrapping and letter spacing.
+            const range = document.createRange();
+            let offset = 0;
+            for (const character of child.textContent) {
+              range.setStart(child, offset);
+              offset += character.length;
+              range.setEnd(child, offset);
+              const rect = range.getBoundingClientRect();
+              if (character.trim()) {
+                context.fillText(character, rect.left - bounds.left,
+                  rect.top - bounds.top + (rect.height - parseFloat(style.fontSize)) / 2);
+              }
+            }
+          }
+        }
+      }
+      paint(cardElement);
+      exportButton.disabled = false;
+    }
+
+    function updateCard() {
+      messageElement.textContent = messageInput.value;
+      cardElement.style.backgroundColor = colorInput.value;
+      document.querySelector('.coffee-handle-hole').style.backgroundColor = colorInput.value;
+      document.getElementById('color-value').textContent = colorInput.value.toUpperCase();
+      const rgb = colorInput.value.match(/[a-f\d]{2}/gi).map(value => parseInt(value, 16));
+      const luminance = rgb.reduce((sum, value, index) => {
+        const channel = value / 255;
+        return sum + (channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4) * [0.2126, 0.7152, 0.0722][index];
+      }, 0);
+      cardElement.style.color = luminance < 0.3 ? '#fff8ef' : '#3e2723';
+      status.textContent = '';
+      try { renderCard(); } catch (error) {
+        exportButton.disabled = true;
+        status.textContent = 'Your browser could not render the card image.';
+      }
+    }
+
+    messageInput.addEventListener('input', updateCard);
+    colorInput.addEventListener('input', updateCard);
+    new ResizeObserver(updateCard).observe(cardElement);
+    document.fonts.ready.then(updateCard);
+    exportButton.addEventListener('click', () => {
+      try {
+        renderCard();
+        exportButton.disabled = true;
+        canvas.toBlob(blob => {
+          exportButton.disabled = false;
+          if (!blob) {
+            status.textContent = 'Could not create the image. Please try again.';
+            return;
+          }
+          const url = URL.createObjectURL(blob);
+          const link = document.createElement('a');
+          link.href = url;
+          link.download = 'daily-grind-coffee-gift.png';
+          document.body.appendChild(link);
+          link.click();
+          link.remove();
+          setTimeout(() => URL.revokeObjectURL(url), 60000);
+          status.textContent = 'Your card is ready. Download started.';
+        }, 'image/png');
+      } catch (error) {
+        exportButton.disabled = false;
+        status.textContent = 'Could not export the card. Please try again.';
+      }
+    });
+  </script>
