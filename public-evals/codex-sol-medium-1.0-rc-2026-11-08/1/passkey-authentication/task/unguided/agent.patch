+  <script>
+    (() => {
+      const form = document.querySelector('#sign-in-form');
+      const username = document.querySelector('[data-testid="username-field"]');
+      const button = document.querySelector('[data-testid="auth-button"]');
+      const status = document.querySelector('[data-testid="auth-status"]');
+      let activeRequest = null;
+      let authenticated = false;
+      let conditionalAvailable = false;
+
+      function decode(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+        return Uint8Array.from(atob(padded), character => character.charCodeAt(0));
+      }
+
+      function encode(value) {
+        return btoa(Array.from(new Uint8Array(value), byte => String.fromCharCode(byte)).join(''))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function requestOptions(json) {
+        const options = json.publicKey || json;
+        if (typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(options);
+        }
+        return {
+          ...options,
+          challenge: decode(options.challenge),
+          ...(options.allowCredentials && {
+            allowCredentials: options.allowCredentials.map(credential => ({
+              ...credential,
+              id: decode(credential.id)
+            }))
+          })
+        };
+      }
+
+      function serialize(credential) {
+        if (typeof credential.toJSON === 'function') return credential.toJSON();
+        return {
+          id: credential.id,
+          rawId: encode(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encode(credential.response.clientDataJSON),
+            authenticatorData: encode(credential.response.authenticatorData),
+            signature: encode(credential.response.signature),
+            userHandle: credential.response.userHandle == null ? null : encode(credential.response.userHandle)
+          },
+          clientExtensionResults: credential.getClientExtensionResults()
+        };
+      }
+
+      async function authenticate(conditional) {
+        if (authenticated || (conditional && activeRequest)) return;
+        // A modal request must replace the pending autofill ceremony.
+        if (activeRequest) activeRequest.abort();
+        const controller = new AbortController();
+        activeRequest = controller;
+        if (!conditional) {
+          button.disabled = true;
+          status.textContent = 'Follow your device’s prompt to sign in.';
+        }
+        try {
+          const optionsResponse = await fetch('/api/login/options', {
+            credentials: 'same-origin',
+            cache: 'no-store',
+            signal: controller.signal
+          });
+          if (!optionsResponse.ok) throw new Error('Unable to load passkey sign-in options. Please try again.');
+          const publicKey = requestOptions(await optionsResponse.json());
+          // Require device verification for the explicit sign-in prompt.
+          if (!conditional) publicKey.userVerification = 'required';
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: conditional ? 'conditional' : 'required',
+            signal: controller.signal
+          });
+          if (controller.signal.aborted) return;
+          if (!credential) throw new Error('No passkey was selected. Please try again.');
+          button.disabled = true;
+          status.textContent = 'Verifying your passkey…';
+          const verificationResponse = await fetch('/api/login/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(serialize(credential)),
+            signal: controller.signal
+          });
+          if (!verificationResponse.ok) throw new Error('Passkey verification failed. Please try again.');
+          const result = await verificationResponse.json();
+          if (result.verified !== true && result.success !== true) {
+            throw new Error('Passkey verification failed. Please try again.');
+          }
+          if (controller.signal.aborted) return;
+          authenticated = true;
+          username.disabled = true;
+          status.textContent = 'Signed in successfully.';
+        } catch (error) {
+          if (controller.signal.aborted) return;
+          if (error.name === 'NotAllowedError') {
+            if (!conditional) status.textContent = 'Sign-in was canceled or timed out. Please try again.';
+          } else {
+            status.textContent = error.message || 'Unable to sign in. Please try again.';
+          }
+        } finally {
+          if (activeRequest === controller) {
+            activeRequest = null;
+            button.disabled = authenticated;
+          }
+        }
+      }
+
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        button.disabled = true;
+        status.textContent = 'Passkey sign-in is unavailable in this browser. Use a supported browser over HTTPS.';
+        return;
+      }
+
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        if (!button.disabled) void authenticate(false);
+      });
+      username.addEventListener('focus', () => {
+        if (conditionalAvailable) void authenticate(true);
+      });
+
+      // Start before focus so the browser can offer discoverable passkeys as autofill.
+      if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+        PublicKeyCredential.isConditionalMediationAvailable()
+          .then(available => {
+            conditionalAvailable = available;
+            if (available) void authenticate(true);
+          })
+          .catch(() => { /* Explicit passkey sign-in remains available. */ });
+      }
+    })();
+  </script>
 </body>
 
