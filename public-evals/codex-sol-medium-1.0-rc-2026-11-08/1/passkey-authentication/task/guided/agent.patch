+  <script type="module">
+    // Pinned, same-origin polyfills for browsers without WebAuthn JSON/capability helpers.
+    import './vendor/webauthn-polyfills-0.1.7/index.js';
+
+    const form = document.querySelector('#signin-form');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    let activeRequest;
+    let authenticated = false;
+
+    async function requestOptions(signal) {
+      const response = await fetch('/api/login/options', {
+        credentials: 'same-origin',
+        cache: 'no-store',
+        signal,
+      });
+      if (!response.ok) throw new Error('Could not load sign-in options. Please try again.');
+      const options = await response.json();
+      return PublicKeyCredential.parseRequestOptionsFromJSON(options.publicKey ?? options);
+    }
+
+    async function verifyCredential(credential, publicKey, signal) {
+      const encoded = credential.toJSON();
+      const response = await fetch('/api/login/verify', {
+        method: 'POST',
+        credentials: 'same-origin',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encoded),
+        signal,
+      });
+
+      if (!response.ok) {
+        // Only an explicit unknown-credential response warrants removing a stale suggestion.
+        if (response.status === 404 && !authenticated && publicKey.rpId &&
+            PublicKeyCredential.signalUnknownCredential) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId,
+              credentialId: encoded.id,
+            });
+          } catch {
+            // Password-manager synchronization must not hide the verification error.
+          }
+        }
+        throw new Error('Could not verify your passkey. Please try again.');
+      }
+
+      const result = response.status === 204 ? {} : await response.json();
+      if (result.verified === false || result.success === false || result.authenticated === false) {
+        throw new Error('Could not verify your passkey. Please try again.');
+      }
+      signal.throwIfAborted();
+      authenticated = true;
+      authStatus.textContent = 'Signed in successfully.';
+      authButton.disabled = true;
+    }
+
+    async function authenticate(conditional = false) {
+      if (authenticated) return;
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+      const { signal } = controller;
+
+      if (!conditional) {
+        authButton.disabled = true;
+        authStatus.textContent = 'Follow your device’s instructions to sign in.';
+      }
+
+      try {
+        if (conditional) {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (!capabilities.conditionalGet) return;
+        }
+        signal.throwIfAborted();
+        const publicKey = await requestOptions(signal);
+        signal.throwIfAborted();
+        const credential = await navigator.credentials.get({
+          publicKey: { ...publicKey, userVerification: 'required' },
+          ...(conditional ? { mediation: 'conditional' } : {}),
+          signal,
+        });
+        signal.throwIfAborted();
+        if (!credential) throw new Error('No passkey was selected. Please try again.');
+        authButton.disabled = true;
+        authStatus.textContent = 'Verifying your passkey…';
+        await verifyCredential(credential, publicKey, signal);
+      } catch (error) {
+        if (signal.aborted || error.name === 'AbortError') return;
+        if (error.name === 'NotAllowedError') {
+          if (!conditional) authStatus.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+        } else {
+          authStatus.textContent = error instanceof TypeError
+            ? 'Could not complete sign-in. Check your connection and try again.'
+            : error.message || 'Could not sign in. Please try again.';
+        }
+      } finally {
+        // An aborted autofill request must not reset a newer button request.
+        if (activeRequest === controller && !authenticated) {
+          authButton.disabled = false;
+          if (!conditional) void authenticate(true);
+        }
+      }
+    }
+
+    const passkeysAvailable = window.isSecureContext &&
+      typeof PublicKeyCredential !== 'undefined' && navigator.credentials?.get;
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (passkeysAvailable && !authButton.disabled) void authenticate();
+    });
+
+    if (passkeysAvailable) {
+      // Start silently so focusing the username field can offer registered passkeys.
+      void authenticate(true);
+    } else {
+      authButton.disabled = true;
+      authStatus.textContent = 'Passkeys require a supported browser and HTTPS (or localhost).';
+    }
+  </script>
