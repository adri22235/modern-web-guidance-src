@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+compiler="${EMXX:-em++}"
+if ! command -v "$compiler" >/dev/null 2>&1; then
+  echo 'Emscripten is required. Activate emsdk or set EMXX to the em++ path.' >&2
+  exit 1
+fi
+mkdir -p public/wasm
+"$compiler" native/smallpt.cpp -o public/wasm/smallpt.js \
+  -O3 -flto -Wall -Werror --no-entry \
+  -sSTRICT -sEXPORT_ES6 -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH -sSTACK_SIZE=1MB -sFILESYSTEM=0 \
+  -sEXPORTED_FUNCTIONS=_initialize,_pixel_buffer,_render_rows,_finish_pass,_sphere_color \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -sINCOMING_MODULE_JS_API=instantiateWasm
diff --git a/scripts/check-worker.mjs b/scripts/check-worker.mjs
new file mode 100644
index 0000000..20d23f1
--- /dev/null
+++ b/scripts/check-worker.mjs
@@ -0,0 +1,24 @@
+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+// Exercise the browser worker module without starting a server or browser.
+const bytes = await readFile(new URL('../public/wasm/smallpt.wasm', import.meta.url));
+const originalFetch = globalThis.fetch;
+globalThis.fetch = async (url) => {
+  assert(String(url).endsWith('/wasm/smallpt.wasm'));
+  return new Response(bytes, { headers: { 'Content-Type': 'application/wasm' } });
+};
+globalThis.self = globalThis;
+const messages = [];
+globalThis.postMessage = (message) => messages.push(message);
+await import('../public/wasm/render-worker.js');
+await globalThis.onmessage({ data: { width: 32, samples: 16, seed: 123456, randomized: true } });
+assert(!messages.some((m) => m.type === 'error'));
+assert.equal(messages[0].type, 'palette');
+assert.equal(messages[0].colors.length, 2);
+const frame = messages.findLast((m) => m.type === 'frame');
+assert.equal(frame.percent, 100);
+assert.equal(frame.samples, 16);
+assert.equal(frame.pixels.byteLength, 32 * 24 * 4);
+assert.equal(messages.at(-1).type, 'done');
+globalThis.fetch = originalFetch;
+console.log('Worker checks passed: streamed Wasm load, palette, pixel messages, progress, and completion.');
diff --git a/scripts/render-preview.mjs b/scripts/render-preview.mjs
new file mode 100644
index 0000000..1171fa8
--- /dev/null
+++ b/scripts/render-preview.mjs
@@ -0,0 +1,39 @@
+import { readFile, mkdir } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+import sharp from 'sharp';
+import createSmallpt from '../public/wasm/smallpt.js';
+const binary = await readFile(new URL('../public/wasm/smallpt.wasm', import.meta.url));
+assert(WebAssembly.validate(binary), 'Valid WebAssembly binary');
+const wasm = await createSmallpt({
+  instantiateWasm(imports, receiveInstance) {
+    const instance = new WebAssembly.Instance(new WebAssembly.Module(binary), imports);
+    receiveInstance(instance);
+    return instance.exports;
+  },
+});
+function smallRender(seed, random) {
+  wasm._initialize(32, 24, seed, random);
+  for (let i=0;i<4;i++) { wasm._render_rows(0,24); wasm._finish_pass(); }
+  return Buffer.from(wasm.HEAPU8.slice(wasm._pixel_buffer(),wasm._pixel_buffer()+32*24*4));
+}
+const original = smallRender(2008,0);
+assert(original.some((value,index)=>index%4!==3 && value>0), 'Nonblack rendered image');
+assert(original.every((value,index)=>index%4!==3 || value===255), 'Opaque RGBA output');
+assert.deepEqual(original,smallRender(2008,0),'Deterministic original render');
+const random = smallRender(123456,1);
+assert.notDeepEqual(original,random,'Randomized scene changes actual pixels');
+assert.notEqual(wasm._sphere_color(6,0),.999,'Mirror tint changes');
+assert.notEqual(wasm._sphere_color(7,0),.999,'Glass tint changes');
+assert.deepEqual(original,smallRender(2008,0),'Reset restores original scene');
+console.log('Wasm checks passed: rendering, RGBA output, determinism, random colors, and reset.');
+if (process.argv.includes('--check-only')) process.exit(0);
+const width=640,height=480,samples=256;
+wasm._initialize(width,height,2008,0);
+for (let pass=0;pass<samples/4;pass++) {
+  wasm._render_rows(0,height); wasm._finish_pass();
+  if ((pass+1)%16===0) console.log(`Preview: ${(pass+1)*4}/${samples} spp`);
+}
+const pixels=wasm.HEAPU8.slice(wasm._pixel_buffer(),wasm._pixel_buffer()+width*height*4);
+await mkdir(new URL('../public/renders/',import.meta.url),{recursive:true});
+await sharp(pixels,{raw:{width,height,channels:4}}).png().toFile(new URL('../public/renders/cornell.png',import.meta.url).pathname);
+console.log('Saved actual Wasm output to public/renders/cornell.png');
