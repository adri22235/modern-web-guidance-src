diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..f26f46d
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,36 @@
+import createSmallpt from './smallpt.js';
+self.onmessage = async ({ data }) => {
+  try {
+    const { width, samples, seed, randomized } = data;
+    const height = width * 3 / 4;
+    const wasm = await createSmallpt();
+    wasm._initialize(width, height, seed, randomized ? 1 : 0);
+    // Palette values are read from the same C++ scene used for rendering.
+    const colors = [6, 7].map((id) => {
+      const rgb = [0, 1, 2].map((channel) => Math.round(wasm._sphere_color(id, channel) * 255));
+      return `rgb(${rgb.join(',')})`;
+    });
+    self.postMessage({ type: 'palette', colors });
+    const passes = samples / 4;
+    let lastUpdate = 0;
+    for (let pass = 0; pass < passes; pass++) {
+      for (let row = 0; row < height; row += 8) {
+        wasm._render_rows(row, Math.min(8, height - row));
+        const now = performance.now();
+        const complete = pass === passes - 1 && row + 8 >= height;
+        if (now - lastUpdate > 160 || complete) {
+          // Refresh the heap view after C++ calls in case Wasm memory grew.
+          const pixels = wasm.HEAPU8.slice(wasm._pixel_buffer(), wasm._pixel_buffer() + width * height * 4);
+          self.postMessage({ type: 'frame', pixels: pixels.buffer, width, height,
+            samples: (pass + 1) * 4,
+            percent: 100 * (pass * height + Math.min(row + 8, height)) / (passes * height) }, [pixels.buffer]);
+          lastUpdate = now;
+        }
+      }
+      wasm._finish_pass();
+    }
+    self.postMessage({ type: 'done' });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: String(error) });
+  }
+};
