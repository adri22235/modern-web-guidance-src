+const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = get<HTMLCanvasElement>('render');
+const context = canvas.getContext('2d');
+const preview = get<HTMLImageElement>('preview');
+const status = get('render-status');
+const progress = get<HTMLProgressElement>('progress');
+const resolution = get<HTMLSelectElement>('resolution');
+const samples = get<HTMLSelectElement>('samples');
+const elapsed = get('elapsed');
+const dot = get('status-dot');
+const base = import.meta.env.BASE_URL;
+let worker: Worker | undefined;
+let randomized = false;
+let seed = 2008;
+let started = 0;
+let timer: ReturnType<typeof setInterval> | undefined;
+let hasPixels = false;
+let ready = false;
+const formatTime = (ms: number) => {
+  const sec = ms / 1000;
+  return `${String(Math.floor(sec / 60)).padStart(2, '0')}:${(sec % 60).toFixed(1).padStart(4, '0')}`;
+};
+function fail(message: string) {
+  clearInterval(timer);
+  status.textContent = message;
+  dot.classList.remove('busy');
+  worker?.terminate();
+  ready = false;
+}
+function render() {
+  worker?.terminate();
+  clearInterval(timer);
+  ready = false;
+  started = performance.now();
+  progress.value = 0;
+  dot.classList.add('busy');
+  status.textContent = 'Preparing light paths…';
+  timer = setInterval(() => {
+    elapsed.replaceChildren(document.createTextNode(`${formatTime(performance.now() - started)} `));
+    const label = document.createElement('span');
+    label.className = 'muted'; label.textContent = 'elapsed'; elapsed.append(label);
+  }, 100);
+  try {
+    if (!context || !window.WebAssembly || !window.Worker) throw new Error('unsupported');
+    worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+    worker.onerror = () => fail('Renderer could not load. Click Randomize to retry.');
+    worker.onmessage = ({ data }) => {
+      if (data.type === 'error') return fail('Rendering failed. Try a lower resolution.');
+      if (data.type === 'palette') {
+        for (const [id, color] of [['mirror-swatch', data.colors[0]], ['glass-swatch', data.colors[1]]] as const) {
+          get(id).style.background = `radial-gradient(circle at 30% 25%, #ffffffbb, ${color} 47%, #1e281d)`;
+        }
+        return;
+      }
+      if (data.type === 'frame') {
+        canvas.width = data.width; canvas.height = data.height;
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+        canvas.classList.add('visible'); preview.hidden = true; hasPixels = true;
+        progress.value = data.percent;
+        status.textContent = `Tracing light · ${data.samples} / ${samples.value} samples`;
+      }
+      if (data.type === 'done') {
+        clearInterval(timer); ready = true;
+        dot.classList.remove('busy'); progress.value = 100;
+        status.textContent = `Render complete · ${samples.value} samples per pixel`;
+      }
+    };
+    worker.postMessage({ width: Number(resolution.value), samples: Number(samples.value), seed, randomized });
+  } catch {
+    fail('This browser cannot run the WebAssembly renderer.');
+  }
+}
+get('randomize').addEventListener('click', () => {
+  randomized = true;
+  seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  render();
+});
+get('reset').addEventListener('click', () => {
+  randomized = false; seed = 2008;
+  get('mirror-swatch').style.background = ''; get('glass-swatch').style.background = '';
+  render();
+});
+resolution.addEventListener('change', render);
+samples.addEventListener('change', render);
+get('download').addEventListener('click', () => {
+  if (!hasPixels) {
+    const link = document.createElement('a'); link.href = preview.src; link.download = 'smallpt-cornell.png'; link.click(); return;
+  }
