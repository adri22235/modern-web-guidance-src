+#!/usr/bin/env bash
+set -euo pipefail
+# Emscripten 4.0.19; activate emsdk first, or set EMXX to em++.
+"${EMXX:-em++}" vendor/smallpt/browser.cpp -O3 -Wno-c++11-narrowing --no-entry \
+  -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=worker,node \
+  -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=5242880 \
+  -s EXPORTED_FUNCTIONS='["_initialize","_set_color","_render_pass"]' \
+  -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -o public/wasm/smallpt.js
