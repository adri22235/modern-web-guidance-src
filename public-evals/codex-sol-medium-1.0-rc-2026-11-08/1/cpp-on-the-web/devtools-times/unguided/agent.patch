+// Browser adaptation of Kevin Beason's smallpt (MIT). Core integrator unchanged.
+#define main smallpt_original_main
+#include "original.cpp"
+#undef main
+#include <vector>
+#include <cstdint>
+
+static int width, height, passes;
+static unsigned int sceneSeed;
+static std::vector<Vec> accumulation;
+static std::vector<unsigned char> pixels;
+extern "C" {
+void initialize(int w, int h, unsigned int seed) {
+  width=w; height=h; passes=0; sceneSeed=seed;
+  accumulation.assign(w*h, Vec()); pixels.assign(w*h*4, 0);
+}
+void set_color(int id, double r, double g, double b) {
+  if (id>=0 && id<8) spheres[id].c=Vec(r,g,b);
+}
+unsigned char* render_pass() {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int y=0;y<height;y++) {
+    unsigned short Xi[3]={(unsigned short)sceneSeed,(unsigned short)(passes+1),(unsigned short)(y*y*y+sceneSeed)};
+    for (int x=0;x<width;x++) {
+      Vec result;
+      for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+        double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        result=result+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*.25;
+      }
+      int i=(height-y-1)*width+x;
+      accumulation[i]=accumulation[i]+result;
+      Vec c=accumulation[i]*(1.0/(passes+1));
+      pixels[i*4]=toInt(c.x); pixels[i*4+1]=toInt(c.y); pixels[i*4+2]=toInt(c.z); pixels[i*4+3]=255;
+    }
+  }
+  passes++;
+  return pixels.data();
+}
+}
+#ifdef SMALLPT_NATIVE
+int main() {
+ initialize(640,480,42);
+ for(int i=0;i<64;i++) render_pass();
+ FILE* f=fopen("public/render-preview.ppm","wb");
+ fprintf(f,"P6\n%d %d\n255\n",width,height);
+ for(int i=0;i<width*height;i++) fwrite(pixels.data()+i*4,1,3,f);
+ fclose(f);
+}
+#endif
