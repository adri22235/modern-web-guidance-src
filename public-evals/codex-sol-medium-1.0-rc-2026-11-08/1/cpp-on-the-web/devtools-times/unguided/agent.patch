+const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = $<HTMLCanvasElement>('render');
+const context = canvas.getContext('2d')!;
+const pause = $<HTMLButtonElement>('pause');
+const resolution = $<HTMLSelectElement>('resolution');
+const base = document.querySelector<HTMLElement>('.app')!.dataset.base!;
+let worker: Worker;
+let requestId = 0;
+let target = 64, current = 0, started = 0, paused = false, completed = false, timer: ReturnType<typeof setInterval>;
+let colors = [[.75,.25,.25],[.25,.25,.75],[.999,.999,.999],[.999,.999,.999]];
+const status = (text: string) => { $('status').textContent = text; };
+function render() {
+  if (!worker) return;
+  current=0; paused=false; completed=false;
+  started=performance.now();
+  $('current-samples').textContent='0'; $('target-samples').textContent=String(target);
+  $('progress').style.width='0%';
+  pause.disabled=false; pause.innerHTML='Ⅱ <span>Pause render</span>';
+  status('Tracing light…');
+  clearInterval(timer);
+  timer=setInterval(()=>{if(!paused && !completed) $('elapsed').textContent=((performance.now()-started)/1000).toFixed(1)+' s';},100);
+  const width=Number(resolution.value);
+  worker.postMessage({type:'render', requestId:++requestId, width, height:width*3/4, samples:target, seed:crypto.getRandomValues(new Uint32Array(1))[0], colors});
+}
+try {
+  worker=new Worker(`${base}wasm/render-worker.js`,{type:'module'});
+  worker.onmessage=({data})=>{
+    if(data.type==='error') {fail(data.message);return;}
+    if(data.type!=='frame' || data.requestId!==requestId) return;
+    canvas.width=data.width; canvas.height=data.height;
+    context.putImageData(new ImageData(new Uint8ClampedArray(data.buffer),data.width,data.height),0,0);
+    canvas.style.opacity='1';
+    current=data.samples;
+    $('current-samples').textContent=String(current);
+    $('progress').style.width=`${Math.min(current/target*100,100)}%`;
+    if(data.done) {
+      completed=true; clearInterval(timer);
+      $('elapsed').textContent=((performance.now()-started)/1000).toFixed(1)+' s';
+      status('Render complete'); pause.innerHTML='↻ <span>Render again</span>';
+    }
+  };
+  worker.onerror=()=>fail('Could not load WebAssembly renderer.');
+  render();
+} catch(error) {fail(String(error));}
+function fail(message: string) {clearInterval(timer);status('Renderer unavailable — try reloading');pause.disabled=true;console.error(message);}
+$('randomize').addEventListener('click',()=>{
+  // Colors are surface reflectance; keep them below 1 for Russian roulette.
+  colors=colors.map(()=>{
+    const hue=Math.random()*Math.PI*2;
+    return [0,2*Math.PI/3,4*Math.PI/3].map(offset=>.24+.61*(Math.cos(hue+offset)+1)/2);
+  });
+  document.querySelectorAll<HTMLElement>('#palette div > span').forEach((swatch,i)=>{
+    swatch.style.setProperty('--color',`rgb(${colors[i].map(v=>Math.round(v*255)).join(',')})`);
+  });
+  render();
+});
+resolution.addEventListener('change',render);
+document.querySelectorAll<HTMLButtonElement>('[data-samples]').forEach(button=>button.addEventListener('click',()=>{
+  target=Number(button.dataset.samples);
+  document.querySelectorAll('[data-samples]').forEach(item=>{item.classList.toggle('selected',item===button);item.setAttribute('aria-pressed',String(item===button));});
+  render();
+}));
+let pausedAt=0;
+pause.addEventListener('click',()=>{
+  if(completed){render();return;}
+  paused=!paused;
+  worker.postMessage({type:paused?'pause':'resume'});
+  if(paused){pausedAt=performance.now();status('Render paused');pause.innerHTML='▷ <span>Resume render</span>';}
+  else{started+=performance.now()-pausedAt;status('Tracing light…');pause.innerHTML='Ⅱ <span>Pause render</span>';}
+});
+$('download').addEventListener('click',async()=>{
+  const output=document.createElement('canvas');
+  output.width=current?canvas.width:640;output.height=current?canvas.height:480;
+  const image=$<HTMLImageElement>('preview');
+  if(!current) {try {await image.decode();}catch{return;}}
+  output.getContext('2d')!.drawImage(current?canvas:image,0,0,output.width,output.height);
+  output.toBlob(blob=>{
+    if(!blob)return;
+    const url=URL.createObjectURL(blob),link=document.createElement('a');
+    link.href=url;link.download=`smallpt-${Date.now()}.png`;link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
+  });
+});
