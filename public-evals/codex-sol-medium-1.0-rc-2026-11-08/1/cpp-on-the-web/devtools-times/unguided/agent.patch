diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..6543469
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,27 @@
+import createSmallpt from './smallpt.js';
+let renderer, active = false, run = 0, samples = 0, settings;
+const ready = createSmallpt();
+self.onmessage = async ({data}) => {
+  if(data.type === 'pause') {active=false; ++run; return;}
+  if(data.type === 'resume') { if(!active && settings && samples<settings.samples) {active=true; step(++run);} return; }
+  if(data.type !== 'render') return;
+  const token=++run;
+  active=false;
+  try {
+    renderer=await ready;
+    if(token!==run) return;
+    settings=data; samples=0;
+    renderer._initialize(data.width,data.height,data.seed);
+    data.colors.forEach((c,i)=>renderer._set_color([0,1,6,7][i],...c));
+    active=true; step(token);
+  } catch(error) { self.postMessage({type:'error',message:String(error)}); }
+};
+function step(token) {
+  if(!active || token!==run) return;
+  try {
+    const pointer=renderer._render_pass(); samples+=4;
+    const buffer=renderer.HEAPU8.slice(pointer,pointer+settings.width*settings.height*4).buffer;
+    self.postMessage({type:'frame',requestId:settings.requestId,buffer,samples,width:settings.width,height:settings.height,done:samples>=settings.samples},[buffer]);
+    if(samples<settings.samples) setTimeout(()=>step(token),0); else active=false;
+  } catch(error) {active=false;self.postMessage({type:'error',message:String(error)});}
+}
