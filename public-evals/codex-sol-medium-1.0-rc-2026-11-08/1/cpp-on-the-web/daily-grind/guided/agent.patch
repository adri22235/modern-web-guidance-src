+const $ = (id) => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+const originalColors = { 0: [.75, .25, .25], 1: [.25, .25, .75], 6: [.999, .999, .999], 7: [.999, .999, .999] };
+let colors = structuredClone(originalColors);
+let worker;
+let started = 0;
+let clock;
+let renderId = 0;
+let currentSamples = 0;
+let hasFrame = false;
+let randomCount = 0;
+
+function updatePalette() {
+  $('palette').replaceChildren(...Object.entries(colors).map(([id, rgb]) => {
+    const swatch = document.createElement('div');
+    swatch.className = 'swatch';
+    swatch.style.background = `rgb(${rgb.map(c => Math.round(c * 255)).join(' ')})`;
+    swatch.title = `${({ 0: 'Left wall', 1: 'Right wall', 6: 'Mirror sphere', 7: 'Glass sphere' })[id]}: ${rgb.map(c => Math.round(c * 255)).join(', ')}`;
+    return swatch;
+  }));
+}
+function elapsed() { return ((performance.now() - started) / 1000).toFixed(1); }
+function stopClock() { clearInterval(clock); }
+function fail(message) {
+  stopClock();
+  worker?.terminate();
+  $('status').textContent = message;
+  $('status-dot').className = 'status-dot error';
+  $('rerender').firstElementChild.textContent = '↻';
+}
+function render() {
+  worker?.terminate();
+  stopClock();
+  const thisRender = ++renderId;
+  const width = Number($('resolution').value);
+  const height = width * .75;
+  const samples = Number($('quality').value);
+  currentSamples = 0;
+  started = performance.now();
+  $('progress').style.width = '0%';
+  $('status-dot').className = 'status-dot busy';
+  $('status').textContent = 'Tracing light paths…';
+  $('elapsed').textContent = '0.0 s';
+  clock = setInterval(() => { $('elapsed').textContent = `${elapsed()} s`; }, 100);
+  try {
+    worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = () => {
+      if (thisRender === renderId) fail('Renderer unavailable. Try Render scene to retry.');
+    };
+    worker.onmessage = ({ data }) => {
+      if (thisRender !== renderId) return;
+      if (data.error) { fail(`Render failed: ${data.error}`); return; }
+      if (canvas.width !== width || canvas.height !== height) { canvas.width = width; canvas.height = height; }
+      context.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+      hasFrame = true;
+      currentSamples = data.samples;
+      $('canvas-resolution').textContent = `${width} × ${height}`;
+      $('download').disabled = false;
+      $('progress').style.width = `${data.samples / samples * 100}%`;
+      $('status').textContent = data.done ? `Render complete · ${data.samples} samples per pixel` : `Rendering · ${data.samples} / ${samples} samples per pixel`;
+      if (data.done) {
+        stopClock();
+        $('elapsed').textContent = `${elapsed()} s`;
+        $('status-dot').className = 'status-dot';
+        worker.terminate();
+      }
+    };
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+    worker.postMessage({ width, height, samples, colors, seed });
+  } catch (error) { fail(`Renderer unavailable: ${error.message}`); }
+}
+function hueColor(hue, saturation, lightness) {
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  return [0, 8, 4].map(n => {
+    const k = (n + hue / 30) % 12;
+    return lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+  });
+}
+$('randomize').addEventListener('click', () => {
+  const random = crypto.getRandomValues(new Uint32Array(4));
+  colors = {
+    0: hueColor(random[0] % 360, .55, .47),
+    1: hueColor(random[1] % 360, .55, .47),
+    6: hueColor(random[2] % 360, .45, .73),
+    7: hueColor(random[3] % 360, .35, .8),
+  };
+  randomCount++;
+  updatePalette();
+  render();
+});
+$('reset').addEventListener('click', () => { colors = structuredClone(originalColors); randomCount = 0; updatePalette(); render(); });
+$('rerender').addEventListener('click', render);
+$('resolution').addEventListener('change', render);
+$('quality').addEventListener('change', render);
+$('download').addEventListener('click', () => {
+  if (!hasFrame) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const link = document.createElement('a');
+    const url = URL.createObjectURL(blob);
+    link.href = url;
+    link.download = `smallpt-${randomCount ? `palette-${randomCount}` : 'original'}-${canvas.width}x${canvas.height}-${currentSamples}spp.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+let sourceLoaded = false;
+async function selectTab(source) {
+  for (const [id, selected] of [['render', !source], ['source', source]]) {
+    $(`${id}-tab`).setAttribute('aria-selected', String(selected));
+    $(`${id}-tab`).tabIndex = selected ? 0 : -1;
+    $(`${id}-tab`).classList.toggle('active', selected);
+    $(`${id}-panel`).hidden = !selected;
+  }
+  if (source && !sourceLoaded) {
+    try {
+      const response = await fetch(new URL('./vendor/smallpt.cpp', import.meta.url));
+      if (!response.ok) throw new Error('Could not load source.');
+      $('source-code').textContent = await response.text();
+      sourceLoaded = true;
+    } catch { $('source-code').textContent = 'Source could not be loaded. Use the Original project link to read the renderer.'; }
+  }
+}
+for (const id of ['render', 'source']) {
+  $(`${id}-tab`).addEventListener('click', () => selectTab(id === 'source'));
+  $(`${id}-tab`).addEventListener('keydown', event => {
+    if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+      event.preventDefault();
+      const next = event.key === 'Home' ? 'render' : event.key === 'End' ? 'source' : id === 'render' ? 'source' : 'render';
+      selectTab(next === 'source');
+      $(`${next}-tab`).focus();
+    }
+  });
+}
+window.addEventListener('pagehide', () => { worker?.terminate(); stopClock(); });
+updatePalette();
+// Original author's reference render is visible only while Wasm initializes.
+const reference = new Image();
+reference.onload = () => { if (!hasFrame) context.drawImage(reference, 0, 0, canvas.width, canvas.height); };
+reference.src = new URL('./assets/reference.png', import.meta.url).href;
+render();
