+import { spawnSync } from 'node:child_process';
+import { mkdirSync, copyFileSync, cpSync, rmSync } from 'node:fs';
+const compiler = process.env.EMXX || 'em++';
+mkdirSync('assets', { recursive: true });
+const result = spawnSync(compiler, ['src/smallpt.cpp', '-o', 'assets/smallpt.js', '-O3', '-flto', '-Wall', '-Werror', '-sSTRICT', '-sEXPORT_ES6', '-sENVIRONMENT=worker', '-sINCOMING_MODULE_JS_API=wasmBinary', '-sALLOW_MEMORY_GROWTH', '-sSTACK_SIZE=1MB', '-sFILESYSTEM=0', '-sEXPORTED_FUNCTIONS=_initialize,_set_color,_get_pixels,_render_rows,_finish_pass', '-sEXPORTED_RUNTIME_METHODS=HEAPU8', '--no-entry'], { stdio: 'inherit' });
+if (result.error) { console.error('Emscripten is required to rebuild. Activate emsdk or set EMXX to em++. Precompiled files are included.'); process.exit(1); }
+if (result.status !== 0) process.exit(result.status);
+rmSync('dist', { recursive: true, force: true });
+mkdirSync('dist');
+for (const file of ['index.html', 'style.css', 'app.js', 'worker.js']) copyFileSync(file, `dist/${file}`);
+for (const directory of ['assets', 'vendor', 'src']) cpSync(directory, `dist/${directory}`, { recursive: true });
