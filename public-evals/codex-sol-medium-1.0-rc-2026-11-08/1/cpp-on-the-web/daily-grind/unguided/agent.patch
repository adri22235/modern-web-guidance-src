+const $ = (id) => document.getElementById(id);
+const canvas = $('render');
+const context = canvas.getContext('2d');
+let worker, samples = 32, colors = [[.999,.999,.999],[.999,.999,.999]], scene = 1, hasImage = false;
+const toHex = (color) => '#' + color.map(v => Math.round(v * 255).toString(16).padStart(2, '0')).join('').toUpperCase();
+function updateColors() {
+  for (const [i, name] of ['mirror', 'glass'].entries()) {
+    const hex = toHex(colors[i]);
+    $(name + '-hex').textContent = hex;
+    $(name + '-swatch').style.background = `radial-gradient(circle at 30% 25%, #ffffff 0%, ${hex} 38%, color-mix(in srgb, ${hex}, #26322b 45%) 76%, ${hex} 100%)`;
+  }
+}
+function setSamples(value) {
+  samples = value;
+  document.querySelectorAll('[data-samples]').forEach(button => {
+    const selected = +button.dataset.samples === value;
+    button.classList.toggle('selected', selected);
+    button.setAttribute('aria-pressed', selected);
+  });
+  $('quality-label').textContent = ({ 16: 'Quick', 32: 'Balanced', 64: 'Refined', 128: 'High quality' })[value];
+}
+function render() {
+  worker?.terminate();
+  const width = +$('resolution').value, height = width * 3 / 4;
+  const targetSamples = samples;
+  canvas.width = width; canvas.height = height;
+  canvas.classList.remove('visible');
+  $('preview').hidden = false;
+  hasImage = false;
+  $('download').disabled = true;
+  $('progress').style.width = '0%';
+  $('dimensions').textContent = `${width} × ${height}`;
+  $('live-samples').textContent = '0';
+  $('elapsed').textContent = '0.0s';
+  $('canvas-status').textContent = 'Tracing light';
+  $('render-status').textContent = 'Starting renderer…';
+  $('render-dot').style.background = '#87a45b';
+  $('scene-name').textContent = `Cornell box / Scene ${String(scene).padStart(3, '0')}`;
+  try {
+    worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.error) return fail(data.error);
+      context.putImageData(new ImageData(data.pixels, data.width, data.height), 0, 0);
+      canvas.classList.add('visible');
+      $('preview').hidden = true;
+      hasImage = true;
+      $('download').disabled = false;
+      const percent = Math.min(100, Math.round(data.completed / targetSamples * 100));
+      $('progress').style.width = percent + '%';
+      $('render-status').textContent = data.done ? 'Render complete' : `Rendering · ${percent}%`;
+      $('live-samples').textContent = Math.floor(data.completed);
+      $('elapsed').textContent = (data.elapsed / 1000).toFixed(1) + 's';
+      $('canvas-status').textContent = data.done ? 'Light, resolved' : 'Tracing light';
+      if (data.done) worker.terminate();
+    };
+    worker.onerror = () => fail('Unable to start the renderer. Please try rendering again.');
+    worker.postMessage({ width, height, samples: targetSamples, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors });
+  } catch(error) { fail(error.message); }
+}
+function fail(message) {
+  worker?.terminate();
+  $('render-status').textContent = 'Render failed — try again';
+  $('canvas-status').textContent = 'Renderer unavailable';
+  $('render-dot').style.background = '#b96b57';
+  $('render-status').title = message;
+  console.error(message);
+}
+// Bright, bounded tints keep reflective paths stable and color changes visible.
+function randomColor() {
+  const random = crypto.getRandomValues(new Uint32Array(3));
+  const color = Array.from(random, value => .38 + (value / 4294967295) * .57);
+  color[random[0] % 3] = .97;
+  return color;
+}
+$('randomize').addEventListener('click', () => {
+  colors = [randomColor(), randomColor()];
+  scene++; updateColors(); render();
+});
+$('rerender').addEventListener('click', render);
+$('reset').addEventListener('click', () => {
+  colors = [[.999,.999,.999],[.999,.999,.999]]; scene = 1;
+  setSamples(32); $('resolution').value = '480'; updateColors(); render();
+});
+document.querySelectorAll('[data-samples]').forEach(button => button.addEventListener('click', () => setSamples(+button.dataset.samples)));
+$('download').addEventListener('click', () => {
+  if (!hasImage) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob), link = document.createElement('a');
+    link.download = `smallpt-scene-${scene}.png`; link.href = url; link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+render();
