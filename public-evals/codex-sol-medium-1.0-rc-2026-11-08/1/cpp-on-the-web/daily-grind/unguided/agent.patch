diff --git a/scripts/test-wasm.mjs b/scripts/test-wasm.mjs
new file mode 100644
index 0000000..a876118
--- /dev/null
+++ b/scripts/test-wasm.mjs
@@ -0,0 +1,27 @@
+import { readFileSync } from 'node:fs';
+import assert from 'node:assert/strict';
+const bytes = readFileSync('assets/smallpt.wasm');
+assert(WebAssembly.validate(bytes), 'valid Wasm binary');
+const {instance} = await WebAssembly.instantiate(bytes, {env:{sin:Math.sin,cos:Math.cos,pow:Math.pow}});
+const api=instance.exports;
+api.__wasm_call_ctors();
+const w=64,h=48;
+function render(colors, seed=123) {
+  assert.equal(api.initialize(w,h,seed,...colors),1);
+  for(let pass=0;pass<2;pass++) {
+    for(let y=0;y<h;y++) api.render_row(y);
+    api.finish_pass();
+  }
+  return new Uint8Array(api.memory.buffer,api.framebuffer(),w*h*4).slice();
+}
+const white=[.999,.999,.999,.999,.999,.999];
+const original=render(white);
+assert(original.some((x,i)=>i%4!==3 && x>0), 'non-black output');
+assert(original.every((x,i)=>i%4!==3 || x===255), 'opaque RGBA buffer');
+assert.deepEqual(render(white),original,'seeded output is reproducible');
+const changed=render([.97,.4,.5,.4,.8,.97]);
+const difference=changed.reduce((n,v,i)=>n+(v!==original[i]),0);
+assert(difference>100,'sphere colors change rendered pixels');
+assert.equal(api.initialize(641,480,1,...white),0,'rejects out-of-bounds dimensions');
+assert.equal(api.initialize(0,48,1,...white),0,'rejects empty dimensions');
+console.log(`Wasm checks passed: ${w}×${h} RGBA, deterministic seed, ${difference} changed channels with colored spheres, safe dimension bounds.`);
diff --git a/src/browser.cpp b/src/browser.cpp
new file mode 100644
index 0000000..5c35a6f
--- /dev/null
+++ b/src/browser.cpp
@@ -0,0 +1,40 @@
+// Browser adapter for Kevin Beason's smallpt. Original algorithm in vendor/smallpt.cpp.
+constexpr int MAX_W=640, MAX_H=480;
+static Vec accumulation[MAX_W*MAX_H*4];
+static unsigned char pixels[MAX_W*MAX_H*4];
+static int width=480, height=360, passes=0;
+static unsigned int seed=1;
+extern "C" {
+int initialize(int w, int h, unsigned int s, double ar, double ag, double ab, double br, double bg, double bb) {
+  if(w<1 || h<1 || w>MAX_W || h>MAX_H) return 0;
+  width=w; height=h; seed=s; passes=0;
+  spheres[6].c=Vec(ar,ag,ab); spheres[7].c=Vec(br,bg,bb);
+  for(int i=0;i<width*height*4;i++) accumulation[i]=Vec();
+  for(int i=0;i<width*height;i++) { pixels[i*4]=pixels[i*4+1]=pixels[i*4+2]=0; pixels[i*4+3]=255; }
+  return 1;
+}
+// One row, four camera rays per pixel. JS yields between batches of rows.
+void render_row(int y) {
+  if(y<0 || y>=height) return;
+  Ray cam(Vec(50,52,295.6),Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  unsigned int rs=seed ^ ((y+1)*747796405u) ^ ((passes+1)*2891336453u);
+  unsigned short Xi[3]={(unsigned short)rs,(unsigned short)(rs>>16),(unsigned short)(rs*31u+17u)};
+  for(int x=0;x<width;x++) {
+    int i=(height-y-1)*width+x;
+    Vec c;
+    for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+      double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+      double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+      Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+      int j=i*4+sy*2+sx;
+      accumulation[j]=accumulation[j]+radiance(Ray(cam.o+d*140,d.norm()),0,Xi);
+      Vec r=accumulation[j]*(1./(passes+1));
+      c=c+Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+    }
+    pixels[i*4]=toInt(c.x); pixels[i*4+1]=toInt(c.y); pixels[i*4+2]=toInt(c.z);
+  }
+}
+void finish_pass() { passes++; }
+unsigned char* framebuffer() { return pixels; }
+}
