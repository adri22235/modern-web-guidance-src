+// All ray tracing runs in the compiled C++ module, away from the UI thread.
+self.onmessage = async ({ data: { width, height, samples, seed, colors } }) => {
+  try {
+    const response = await fetch(new URL('./smallpt.wasm', import.meta.url));
+    if (!response.ok) throw new Error(`Renderer download failed (${response.status})`);
+    const { instance } = await WebAssembly.instantiate(await response.arrayBuffer(), { env: { sin: Math.sin, cos: Math.cos, pow: Math.pow } });
+    const api = instance.exports;
+    api.__wasm_call_ctors();
+    if (!api.initialize(width, height, seed, ...colors.flat())) throw new Error('Unsupported image dimensions');
+    const start = performance.now();
+    let lastUpdate = 0;
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row++) {
+        api.render_row(row);
+        const now = performance.now();
+        if (now - lastUpdate > 120 || row === height - 1) {
+          const pixels = new Uint8ClampedArray(api.memory.buffer, api.framebuffer(), width * height * 4).slice();
+          const completed = (pass + (row + 1) / height) * 4;
+          self.postMessage({ pixels, width, height, completed, elapsed: now - start, done: pass === samples / 4 - 1 && row === height - 1 }, [pixels.buffer]);
+          lastUpdate = now;
+        }
+      }
+      api.finish_pass();
+    }
+  } catch (error) { self.postMessage({ error: error.message }); }
+};
