+// Optional: generate an authentic path-traced placeholder using the shipped Wasm.
+import {readFileSync,writeFileSync} from 'node:fs';
+import {deflateSync} from 'node:zlib';
+const {instance}=await WebAssembly.instantiate(readFileSync('assets/smallpt.wasm'),{env:{sin:Math.sin,cos:Math.cos,pow:Math.pow}});
+const a=instance.exports;a.__wasm_call_ctors();
+const w=640,h=480,spp=128;
+a.initialize(w,h,42,.999,.999,.999,.999,.999,.999);
+for(let p=0;p<spp/4;p++){for(let y=0;y<h;y++)a.render_row(y);a.finish_pass();if(p%8===0)console.log(`${p*4}/${spp} spp`);}
+const pixels=new Uint8Array(a.memory.buffer,a.framebuffer(),w*h*4), raw=Buffer.alloc((w*4+1)*h);
+for(let y=0;y<h;y++)raw.set(pixels.subarray(y*w*4,(y+1)*w*4),y*(w*4+1)+1);
+function crc32(b){let c=0xffffffff;for(const v of b){c^=v;for(let i=0;i<8;i++)c=(c>>>1)^((c&1)?0xedb88320:0);}return (c^0xffffffff)>>>0;}
+function chunk(name,data){const type=Buffer.from(name),out=Buffer.alloc(data.length+12);out.writeUInt32BE(data.length);type.copy(out,4);data.copy(out,8);out.writeUInt32BE(crc32(Buffer.concat([type,data])),data.length+8);return out;}
+const header=Buffer.alloc(13);header.writeUInt32BE(w);header.writeUInt32BE(h,4);header[8]=8;header[9]=6;
+writeFileSync('assets/preview.png',Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]),chunk('IHDR',header),chunk('IDAT',deflateSync(raw)),chunk('IEND',Buffer.alloc(0))]));
