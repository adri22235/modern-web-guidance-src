--- /dev/null
+++ b/scripts/build-wasm.mjs
@@ -0,0 +1,28 @@
+import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+// No Emscripten runtime or libc needed: only transcendental math is imported.
+const original=readFileSync('src/vendor/smallpt.cpp','utf8');
+const core=original.slice(original.indexOf('struct Vec'),original.indexOf('int main('));
+const shim=`#define M_PI 3.14159265358979323846
+extern "C" double sin(double);
+extern "C" double cos(double);
+extern "C" double pow(double,double);
+inline double sqrt(double x){return __builtin_sqrt(x);}
+inline double fabs(double x){return __builtin_fabs(x);}
+// POSIX erand48's original 48-bit LCG, with independent state per row.
+inline double erand48(unsigned short* x){
+ unsigned long long s=((unsigned long long)x[2]<<32)|((unsigned long long)x[1]<<16)|x[0];
+ s=(s*0x5DEECE66DULL+11)&0xFFFFFFFFFFFFULL;
+ x[0]=s; x[1]=s>>16; x[2]=s>>32;
+ return (double)s/281474976710656.;
+}
+`;
+mkdirSync('build',{recursive:true}); mkdirSync('assets',{recursive:true});
+writeFileSync('build/smallpt.cpp',shim+core+readFileSync('src/browser.cpp','utf8'));
+const localLinker='/tmp/smallpt-toolchain/usr/lib/llvm-19/bin/wasm-ld';
+const compile=spawnSync(process.env.CXX || 'clang++-19',['--target=wasm32','-O3','-nostdlib','-fno-exceptions','-fno-rtti','-fno-builtin','-Wno-dangling-else','-c','build/smallpt.cpp','-o','build/smallpt.o'],{stdio:'inherit'});
+if(compile.status!==0) { console.error('Install Clang or set CXX.'); process.exit(1); }
+const linker=process.env.WASM_LD || (existsSync(localLinker)?localLinker:'wasm-ld');
+const result=spawnSync(linker,['--no-entry','--allow-undefined','--export=__wasm_call_ctors','--export=initialize','--export=render_row','--export=finish_pass','--export=framebuffer','--initial-memory=67108864','-z','stack-size=1048576','build/smallpt.o','-o','assets/smallpt.wasm'],{stdio:'inherit'});
+if(result.error) console.error('Install lld or set WASM_LD.',result.error.message);
+process.exit(result.status ?? 1);
