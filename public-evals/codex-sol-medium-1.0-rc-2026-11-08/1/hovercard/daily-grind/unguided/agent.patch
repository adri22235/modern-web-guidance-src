+  <script>
+    (() => {
+      let activePreview = null;
+
+      document.querySelectorAll('[data-drink-preview]').forEach((trigger) => {
+        const panel = document.getElementById(trigger.dataset.drinkPreview);
+        let closeTimer;
+        let pointerInside = false;
+
+        const position = () => {
+          const anchor = trigger.getBoundingClientRect();
+          const gap = 8;
+          const margin = 12;
+          const width = panel.offsetWidth;
+          const height = panel.offsetHeight;
+          const left = Math.max(margin, Math.min(
+            anchor.left + (anchor.width - width) / 2,
+            window.innerWidth - width - margin
+          ));
+          const below = anchor.bottom + gap;
+          const top = below + height <= window.innerHeight - margin
+            ? below
+            : Math.max(margin, anchor.top - height - gap);
+          panel.style.left = `${left}px`;
+          panel.style.top = `${top}px`;
+        };
+
+        const close = () => {
+          clearTimeout(closeTimer);
+          panel.hidden = true;
+          trigger.setAttribute('aria-expanded', 'false');
+          if (activePreview?.panel === panel) activePreview = null;
+        };
+
+        const open = () => {
+          clearTimeout(closeTimer);
+          if (activePreview?.panel !== panel) activePreview?.close();
+          panel.hidden = false;
+          trigger.setAttribute('aria-expanded', 'true');
+          activePreview = { panel, trigger, close, position };
+          position();
+        };
+
+        const scheduleClose = () => {
+          clearTimeout(closeTimer);
+          closeTimer = setTimeout(() => {
+            if (!pointerInside && !trigger.contains(document.activeElement)
+              && !panel.contains(document.activeElement)) close();
+          }, 180);
+        };
+
+        [trigger, panel].forEach((element) => {
+          element.addEventListener('pointerenter', (event) => {
+            if (event.pointerType === 'touch') return;
+            pointerInside = true;
+            open();
+          });
+          element.addEventListener('pointerleave', () => {
+            pointerInside = false;
+            scheduleClose();
+          });
+          element.addEventListener('focusin', open);
+          element.addEventListener('focusout', scheduleClose);
+        });
+
+        panel.querySelector('.preview-close').addEventListener('click', () => {
+          trigger.focus({ preventScroll: true });
+          close();
+        });
+      });
+
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && activePreview) {
+          const { panel, trigger, close } = activePreview;
+          if (panel.contains(document.activeElement)) trigger.focus({ preventScroll: true });
+          close();
+          event.preventDefault();
+        }
+      });
+
+      document.addEventListener('pointerdown', (event) => {
+        if (activePreview && !activePreview.panel.contains(event.target)
+          && !activePreview.trigger.contains(event.target)) activePreview.close();
+      });
+
+      window.addEventListener('resize', () => activePreview?.position());
+      window.addEventListener('scroll', () => activePreview?.position(), true);
+    })();
+  </script>
