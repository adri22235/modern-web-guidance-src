index 66c9173..07432cc 100644
--- a/index.html
+++ b/index.html
@@ -135,6 +135,127 @@
       background: #3e2723;
     }
 
+    /* Link previews use the top layer so surrounding cards cannot clip them. */
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .drink-preview-link {
+      --interest-delay-start: 0.25s;
+      --interest-delay-end: 0.3s;
+      interest-delay-start: var(--interest-delay-start);
+      interest-delay-end: var(--interest-delay-end);
+    }
+
+    .drink-preview-link:focus-visible,
+    .drink-preview summary:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    .drink-preview {
+      /* Also hide previews in browsers that do not recognize popover. */
+      display: none;
+      width: min(340px, calc(100vw - 32px));
+      max-height: calc(100dvh - 32px);
+      overflow-y: auto;
+      padding: 22px;
+      border: 1px solid var(--secondary);
+      border-top: 4px solid var(--accent);
+      border-radius: 12px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 12px 36px rgb(62 39 35 / 22%);
+      text-align: left;
+      font-size: 0.95rem;
+    }
+
+    .drink-preview:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .drink-preview .preview-label {
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    .drink-preview h3 {
+      margin: 4px 0 8px;
+      font-size: 1.3rem;
+    }
+
+    .drink-preview dl {
+      display: grid;
+      grid-template-columns: auto 1fr;
+      gap: 6px 16px;
+      margin-top: 16px;
+      padding-top: 14px;
+      border-top: 1px solid var(--secondary);
+    }
+
+    .drink-preview dt {
+      font-weight: 600;
+    }
+
+    .drink-preview dd {
+      margin: 0;
+    }
+
+    .drink-preview details {
+      margin-top: 16px;
+    }
+
+    .drink-preview summary {
+      cursor: pointer;
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .drink-preview details p {
+      margin-top: 8px;
+    }
+
+    /* Keep the default centered popover in browsers without anchors. */
+    @supports (position-area: block-end) {
+      [interestfor="maple-preview"] { anchor-name: --maple-link; }
+      [interestfor="espresso-preview"] { anchor-name: --espresso-link; }
+      [interestfor="cold-brew-preview"] { anchor-name: --cold-brew-link; }
+      #maple-preview { position-anchor: --maple-link; }
+      #espresso-preview { position-anchor: --espresso-link; }
+      #cold-brew-preview { position-anchor: --cold-brew-link; }
+
+      .drink-preview {
+        inset: auto;
+        margin: 8px 0;
+        position-area: block-end span-inline-end;
+        position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .drink-preview {
+        transition: opacity 0.15s, display 0.15s, overlay 0.15s;
+        transition-behavior: allow-discrete;
+      }
+
+      @starting-style {
+        .drink-preview:is(:popover-open, .\:popover-open) {
+          opacity: 0;
+        }
+      }
+    }
+
