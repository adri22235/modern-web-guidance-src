+  <script type="module">
+    const nav = document.querySelector('nav');
+    const links = [...nav.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.hash));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+
+    function setCurrent(current) {
+      links.forEach(link => {
+        link.classList.toggle('target-current', !nativeTracking && link === current);
+        if (link === current) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    let frame;
+    function syncNativeCurrent() {
+      cancelAnimationFrame(frame);
+      frame = requestAnimationFrame(() => {
+        setCurrent(links.find(link => link.matches(':target-current')));
+      });
+    }
+
+    let observer;
+    function updateNavigation() {
+      const height = nav.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${height}px`);
+      if (nativeTracking) {
+        syncNativeCurrent();
+        return;
+      }
+
+      observer?.disconnect();
+      const visible = new Set();
+      const bottomInset = Math.min(innerHeight * 0.45, Math.max(0, innerHeight - height - 1));
+      // Track the reading area below the sticky header, in document order.
+      observer = new IntersectionObserver(entries => {
+        entries.forEach(entry => {
+          if (entry.isIntersecting) visible.add(entry.target);
+          else visible.delete(entry.target);
+        });
+        const current = sections.filter(section => visible.has(section)).at(-1);
+        if (current) setCurrent(links[sections.indexOf(current)]);
+        else if (sections[0].getBoundingClientRect().top > innerHeight * 0.55) {
+          setCurrent(undefined);
+        }
+      }, { rootMargin: `-${height}px 0px -${bottomInset}px 0px`, threshold: 0 });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    if (nativeTracking) {
+      document.addEventListener('scroll', syncNativeCurrent, { passive: true });
+      document.addEventListener('scrollend', syncNativeCurrent);
+    }
+    new ResizeObserver(updateNavigation).observe(nav);
+    window.addEventListener('resize', updateNavigation);
+    window.addEventListener('pageshow', updateNavigation);
+    updateNavigation();
+  </script>
+
