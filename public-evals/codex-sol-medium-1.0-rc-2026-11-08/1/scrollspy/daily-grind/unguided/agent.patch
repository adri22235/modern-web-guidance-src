+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = sectionLinks.map(link => document.querySelector(link.hash));
+    let framePending = false;
+
+    function updateActiveSection() {
+      const navigationBottom = navigation.getBoundingClientRect().bottom;
+      const visibleSections = sections.filter(section => {
+        const bounds = section.getBoundingClientRect();
+        return bounds.bottom > navigationBottom && bounds.top < window.innerHeight;
+      });
+      // Prefer the section at the top of the reading area. At the page bottom,
+      // select the final visible section even if it cannot reach that position.
+      const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
+      const activeSection = atBottom
+        ? visibleSections[visibleSections.length - 1]
+        : visibleSections.find(section => section.getBoundingClientRect().top <= navigationBottom + 32)
+          || visibleSections[0];
+
+      sectionLinks.forEach((link, index) => {
+        if (sections[index] === activeSection) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+      framePending = false;
+    }
+
+    function scheduleUpdate() {
+      if (!framePending) {
+        framePending = true;
+        requestAnimationFrame(updateActiveSection);
+      }
+    }
+
+    function updateNavigationHeight() {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.offsetHeight}px`);
+      scheduleUpdate();
+    }
+
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', updateNavigationHeight);
+    window.addEventListener('hashchange', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    new ResizeObserver(updateNavigationHeight).observe(navigation);
+    updateNavigationHeight();
+  </script>
+
