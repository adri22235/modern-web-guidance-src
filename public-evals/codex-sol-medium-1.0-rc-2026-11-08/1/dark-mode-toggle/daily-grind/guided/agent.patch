+  <script>
+    (() => {
+      const scheme = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('theme-toggle');
+      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
+      const isDark = () => scheme.content === 'dark' ||
+        (scheme.content === 'light dark' && systemTheme.matches);
+      const updateToggle = () => {
+        toggle.setAttribute('aria-pressed', String(isDark()));
+      };
+
+      toggle.addEventListener('click', () => {
+        const theme = isDark() ? 'light' : 'dark';
+        scheme.content = theme;
+        updateToggle();
+        try {
+          localStorage.setItem('daily-grind-theme', theme);
+        } catch {
+          // Manual switching still works without persistent storage.
+        }
+      });
+
+      systemTheme.addEventListener('change', updateToggle);
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'daily-grind-theme' || event.key === null) {
+          scheme.content = event.newValue === 'light' || event.newValue === 'dark'
+            ? event.newValue : 'light dark';
+          updateToggle();
+        }
+      });
+
+      updateToggle();
+      toggle.hidden = false;
+    })();
+  </script>
+
