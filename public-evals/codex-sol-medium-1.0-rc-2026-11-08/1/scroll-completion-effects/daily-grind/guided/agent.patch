+  <script>
+    const navigation = document.querySelector('nav');
+    let currentScrollId = 0;
+    let cancelPendingScroll = () => {};
+
+    async function scrollToSection(target) {
+      const scrollId = ++currentScrollId;
+      cancelPendingScroll();
+      document.querySelectorAll('.section-arrived').forEach((section) => {
+        section.classList.remove('section-arrived');
+      });
+
+      const top = Math.max(0, Math.min(
+        target.getBoundingClientRect().top + window.scrollY - navigation.offsetHeight - 20,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+
+      // Listen before scrolling, including for browsers without scroll promises.
+      let finish;
+      let idleTimer;
+      const settled = new Promise((resolve) => {
+        finish = () => {
+          clearTimeout(idleTimer);
+          document.removeEventListener('scrollend', finish);
+          document.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(idleTimer);
+          idleTimer = setTimeout(finish, 150);
+        };
+        document.addEventListener('scrollend', finish);
+        document.addEventListener('scroll', onScroll, { passive: true });
+        // Also settle when already at the destination and no events fire.
+        onScroll();
+      });
+      cancelPendingScroll = finish;
+
+      try {
+        // Window.scrollTo avoids the root-scroller scrollIntoView promise bug.
+        const result = window.scrollTo({
+          top,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+        if (result && typeof result.then === 'function') {
+          await result;
+        } else {
+          await settled;
+        }
+      } finally {
+        finish();
+      }
+
+      // A newer link or an interrupted scroll must not focus an old destination.
+      if (scrollId !== currentScrollId || Math.abs(window.scrollY - top) > 2) return;
+
+      target.focus({ preventScroll: true });
+      target.classList.add('section-arrived');
+    }
+
+    navigation.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+      if (!link || event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+      const id = link.dataset.scrollTarget || link.getAttribute('href').slice(1);
+      const target = document.getElementById(id.replace(/^#/, ''));
+      if (!target) return;
+
+      event.preventDefault();
+      if (window.location.hash !== `#${target.id}`) {
+        history.pushState(null, '', `#${target.id}`);
+      }
+      void scrollToSection(target);
+    });
+  </script>
