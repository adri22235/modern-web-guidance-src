+  <script>
+    const navigation = document.querySelector('nav');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let cancelPendingScroll = () => {};
+
+    function updateNavOffset() {
+      document.documentElement.style.setProperty('--nav-offset', `${navigation.offsetHeight + 20}px`);
+    }
+    updateNavOffset();
+    new ResizeObserver(updateNavOffset).observe(navigation);
+
+    navigation.addEventListener('click', (event) => {
+      const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+      if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+      const id = (link.dataset.scrollTarget || link.hash).replace(/^#/, '');
+      const target = document.getElementById(id);
+      if (!target) return;
+
+      event.preventDefault();
+      cancelPendingScroll();
+      document.querySelectorAll('.section-arrived').forEach(section => section.classList.remove('section-arrived'));
+      updateNavOffset();
+
+      const offset = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
+      const destination = Math.max(0, Math.min(
+        window.scrollY + target.getBoundingClientRect().top - offset,
+        document.documentElement.scrollHeight - window.innerHeight
+      ));
+      let frame;
+      let lastPosition = window.scrollY;
+      let settledFrames = 0;
+      let finished = false;
+
+      function cleanup() {
+        finished = true;
+        cancelAnimationFrame(frame);
+        document.removeEventListener('scrollend', onScrollEnd);
+        window.removeEventListener('wheel', interrupt);
+        window.removeEventListener('touchstart', interrupt);
+        window.removeEventListener('pointerdown', interrupt);
+        window.removeEventListener('keydown', onKeyDown);
+      }
+
+      function arrive() {
+        if (finished) return;
+        cleanup();
+        target.focus({ preventScroll: true });
+        target.classList.remove('section-arrived');
+        void target.offsetWidth;
+        target.classList.add('section-arrived');
+        navigation.querySelectorAll('a').forEach(item => item.removeAttribute('aria-current'));
+        link.setAttribute('aria-current', 'location');
+      }
+
+      function atDestination() {
+        return Math.abs(window.scrollY - destination) <= 1;
+      }
+
+      function onScrollEnd(event) {
+        if (event.target === document && atDestination()) arrive();
+      }
+
+      // Also supports browsers without scrollend and links already at their destination.
+      function checkPosition() {
+        if (finished) return;
+        const position = window.scrollY;
+        settledFrames = Math.abs(position - lastPosition) < 0.1 ? settledFrames + 1 : 0;
+        lastPosition = position;
+        if (settledFrames >= 6) {
+          if (atDestination()) arrive();
+          else cleanup();
+          return;
+        }
+        frame = requestAnimationFrame(checkPosition);
+      }
+
+      function interrupt() {
+        cleanup();
+        window.scrollTo({ top: window.scrollY, behavior: 'instant' });
+      }
+
+      function onKeyDown(event) {
+        if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' ', 'Tab', 'Escape'].includes(event.key)) interrupt();
+      }
+
+      cancelPendingScroll = interrupt;
+      document.addEventListener('scrollend', onScrollEnd);
+      window.addEventListener('wheel', interrupt, { passive: true });
+      window.addEventListener('touchstart', interrupt, { passive: true });
+      window.addEventListener('pointerdown', interrupt, { passive: true });
+      window.addEventListener('keydown', onKeyDown);
+      if (location.hash !== `#${id}`) history.pushState(null, '', `#${id}`);
+      window.scrollTo({ top: destination, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      frame = requestAnimationFrame(checkPosition);
+    });
+  </script>
