+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = Array.from(scroller.querySelectorAll('.bean'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollEndTimer;
+
+    function updateVisibleBean() {
+      // Read geometry only at rest, before writing the status text.
+      const viewport = scroller.getBoundingClientRect();
+      let visibleIndex = 0;
+      let greatestVisibleWidth = -1;
+
+      beans.forEach((bean, index) => {
+        const bounds = bean.getBoundingClientRect();
+        const visibleWidth = Math.max(0,
+          Math.min(bounds.right, viewport.right) - Math.max(bounds.left, viewport.left));
+        if (visibleWidth > greatestVisibleWidth) {
+          greatestVisibleWidth = visibleWidth;
+          visibleIndex = index;
+        }
+      });
+
+      scrolling = false;
+      const name = beans[visibleIndex].querySelector('h3').textContent;
+      status.textContent = `Viewing: ${name} (${visibleIndex + 1} of ${beans.length})`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+
+      // Older browsers estimate completion; native scrollend waits for gestures and snapping.
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollEndTimer);
+        scrollEndTimer = setTimeout(updateVisibleBean, 150);
+      }
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', updateVisibleBean);
+    window.addEventListener('pageshow', updateVisibleBean);
+  </script>
+
