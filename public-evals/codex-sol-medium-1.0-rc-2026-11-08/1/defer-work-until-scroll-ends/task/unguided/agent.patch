+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const beans = Array.from(scroller.querySelectorAll('.bean'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollTimer;
+
+    function showVisibleBean() {
+      const viewport = scroller.getBoundingClientRect();
+      const center = viewport.left + viewport.width / 2;
+      let closestIndex = 0;
+      let closestDistance = Infinity;
+
+      beans.forEach((bean, index) => {
+        const bounds = bean.getBoundingClientRect();
+        const distance = Math.abs(bounds.left + bounds.width / 2 - center);
+        if (distance < closestDistance) {
+          closestIndex = index;
+          closestDistance = distance;
+        }
+      });
+
+      scrolling = false;
+      status.textContent = `Viewing: ${beans[closestIndex].dataset.bean} (${closestIndex + 1} of ${beans.length})`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      // Keep movement cheap: update once, and measure cards only after settling.
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(showVisibleBean, 150);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) {
+      scroller.addEventListener('scrollend', showVisibleBean);
+    }
+
+    // Account for a scroll position restored by the browser on navigation.
+    window.addEventListener('pageshow', showVisibleBean);
+  </script>
+
