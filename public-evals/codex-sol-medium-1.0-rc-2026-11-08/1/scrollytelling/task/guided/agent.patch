+<script>
+    (() => {
+      const steps = [...document.querySelectorAll('#tracked > section')];
+      const frames = [...document.querySelectorAll('#animated > section')];
+      const controls = [...document.querySelectorAll('[data-step]')];
+      const animated = document.querySelector('#animated');
+      const motion = matchMedia('(prefers-reduced-motion: reduce)');
+      const nativeTimeline = CSS.supports('animation-timeline: view()') && CSS.supports('animation-range: 0% 100%') && CSS.supports('timeline-scope: --seed');
+      let queued = false;
+      function update() {
+        queued = false;
+        const centers = steps.map(step => {
+          const rect = step.getBoundingClientRect();
+          return rect.top + rect.height / 2;
+        });
+        const closest = centers.reduce((best, center, i) => Math.abs(center - innerHeight / 2) < Math.abs(centers[best] - innerHeight / 2) ? i : best, 0);
+        controls.forEach((control, i) => {
+          if (i === closest) control.setAttribute('aria-current', 'step');
+          else control.removeAttribute('aria-current');
+        });
+        animated.classList.toggle('is-enhanced', !nativeTimeline && !motion.matches);
+        frames.forEach((frame, i) => {
+          frame.classList.toggle('is-active', i === closest);
+          if (!nativeTimeline && !motion.matches) {
+            const distance = Math.abs(centers[i] - innerHeight / 2);
+            const opacity = Math.max(0, Math.min(1, 1.5 - distance / (innerHeight * .4)));
+            frame.style.opacity = opacity;
+            frame.style.transform = `translateY(${Math.max(-28, Math.min(28, (centers[i] - innerHeight / 2) * .06))}px)`;
+          } else {
+            frame.style.removeProperty('opacity');
+            frame.style.removeProperty('transform');
+          }
+        });
+      }
+      function schedule() { if (!queued) { queued = true; requestAnimationFrame(update); } }
+      controls.forEach((control, i) => control.addEventListener('click', () => steps[i].scrollIntoView({ behavior: motion.matches ? 'instant' : 'smooth', block: 'center' })));
+      addEventListener('scroll', schedule, { passive: true });
+      addEventListener('resize', schedule);
+      motion.addEventListener('change', schedule);
+      update();
+    })();
+  </script>
