+  <script>
+    (() => {
+      const steps = [...document.querySelectorAll('#tracked > section')];
+      const visuals = steps.map(step => document.getElementById(step.dataset.visual));
+      const markers = [...document.querySelectorAll('.story-progress > span')];
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const mobile = window.matchMedia('(max-width: 640px)');
+      const visualColumn = document.querySelector('.story-visual-column');
+      const clamp = value => Math.max(0, Math.min(1, value));
+      let pending = false;
+
+      function updateStory() {
+        pending = false;
+        // On phones, track the readable area below the sticky visual panel.
+        const viewportHeight = window.innerHeight;
+        const visualBottom = visualColumn.getBoundingClientRect().bottom;
+        const focus = mobile.matches
+          ? Math.min(viewportHeight * 0.85, (Math.max(0, visualBottom) + viewportHeight) / 2)
+          : viewportHeight * 0.55;
+        const bounds = steps.map(step => step.getBoundingClientRect());
+        let active = 0;
+        const progress = bounds.map((rect, index) => {
+          if (rect.top <= focus) active = index;
+          return clamp((focus - rect.top) / rect.height);
+        });
+
+        visuals.forEach((visual, index) => {
+          // Crossfade in the first quarter of each matching text section.
+          const entering = reducedMotion.matches ? 1 : clamp(progress[active] * 4);
+          const visibility = index === active
+            ? (active === 0 ? 1 : entering)
+            : (index === active - 1 ? 1 : 0);
+          visual.style.setProperty('--visibility', visibility);
+          visual.style.setProperty('--progress', progress[index]);
+          visual.setAttribute('aria-hidden', String(index !== active));
+          markers[index].style.setProperty('--progress', progress[index]);
+        });
+      }
+
+      function scheduleUpdate() {
+        if (pending) return;
+        pending = true;
+        window.requestAnimationFrame(updateStory);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      reducedMotion.addEventListener('change', scheduleUpdate);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleUpdate).observe(document.getElementById('tracked'));
+      }
+      updateStory();
+    })();
+  </script>
