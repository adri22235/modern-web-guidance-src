+  <script type="module">
+    const players = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"]');
+
+    function loadMedia(player) {
+      if (!player.hasAttribute('data-preload')) return;
+      if (player.dataset.poster) {
+        player.poster = player.dataset.poster;
+        delete player.dataset.poster;
+      }
+      player.preload = player.dataset.preload;
+      delete player.dataset.preload;
+      for (const source of player.querySelectorAll('source[data-src]')) {
+        source.src = source.dataset.src;
+        delete source.dataset.src;
+      }
+      player.load();
+    }
+
+    // Native lazy loading defers posters and metadata as well as media data.
+    // Unsupported browsers receive no fetchable URLs until within 200px of view.
+    const observer = 'IntersectionObserver' in window
+      ? new IntersectionObserver((entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          loadMedia(entry.target);
+          observer.unobserve(entry.target);
+        }
+      }, { rootMargin: '200px 0px' })
+      : null;
+
+    for (const player of players) {
+      if ('loading' in player) {
+        loadMedia(player);
+      } else if (observer) {
+        observer.observe(player);
+      } else {
+        // Preserve bandwidth and let the user opt in on older browsers.
+        const button = player.closest('section').querySelector('.media-load');
+        button.hidden = false;
+        button.addEventListener('click', () => {
+          loadMedia(player);
+          button.hidden = true;
+          player.focus();
+        }, { once: true });
+      }
+    }
+  </script>
+
