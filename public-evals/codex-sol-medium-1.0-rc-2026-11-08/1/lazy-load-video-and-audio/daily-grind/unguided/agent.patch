diff --git a/media.js b/media.js
new file mode 100644
index 0000000..4889ccb
--- /dev/null
+++ b/media.js
@@ -0,0 +1,53 @@
+// Keep both posters and media sources inert until their own player is nearby.
+(() => {
+  const players = [...document.querySelectorAll('[data-lazy-media]')];
+  const pending = new Set(players);
+  const margin = 200;
+
+  function activate(player) {
+    if (!pending.delete(player)) return;
+    if (player.dataset.poster) {
+      player.poster = player.dataset.poster;
+      delete player.dataset.poster;
+    }
+    for (const source of player.querySelectorAll('source[data-src]')) {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    }
+    player.preload = 'metadata';
+    player.load();
+  }
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver(entries => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: `${margin}px`, threshold: 0 });
+    players.forEach(player => observer.observe(player));
+  } else {
+    // Older browsers still defer downloads instead of loading every player.
+    let scheduled = false;
+    const events = ['scroll', 'resize', 'orientationchange'];
+    function check() {
+      scheduled = false;
+      for (const player of pending) {
+        const rect = player.getBoundingClientRect();
+        if (rect.bottom >= -margin && rect.top <= window.innerHeight + margin &&
+            rect.right >= -margin && rect.left <= window.innerWidth + margin) {
+          activate(player);
+        }
+      }
+      if (!pending.size) events.forEach(event => window.removeEventListener(event, schedule));
+    }
+    function schedule() {
+      if (scheduled) return;
+      scheduled = true;
+      window.requestAnimationFrame(check);
+    }
+    events.forEach(event => window.addEventListener(event, schedule, { passive: true }));
+    check();
+  }
+})();
diff --git a/media.test.cjs b/media.test.cjs
new file mode 100644
index 0000000..017034c
--- /dev/null
+++ b/media.test.cjs
@@ -0,0 +1,84 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const vm = require('node:vm');
+const script = fs.readFileSync(`${__dirname}/media.js`, 'utf8');
+
+function player(top, poster = true) {
+  const source = { dataset: { src: 'clip.mp4' } };
+  return {
+    dataset: poster ? { poster: 'poster.jpg' } : {},
+    preload: 'none', source, loads: 0, top,
+    querySelectorAll: () => [source],
+    load() { this.loads++; },
+    getBoundingClientRect() {
+      return { top: this.top, bottom: this.top + 300, left: 0, right: 500 };
+    },
+  };
+}
+
+test('HTML exposes no fetchable media or poster URLs before activation', () => {
+  const html = fs.readFileSync(`${__dirname}/index.html`, 'utf8');
+  const media = html.match(/<(?:video|audio)\b[^>]*>/g);
+  assert.equal(media.length, 3);
+  for (const tag of media) {
+    assert.match(tag, /preload="none"/);
+    assert.match(tag, /data-lazy-media/);
+    assert.doesNotMatch(tag, /\s(?:src|poster|autoplay)=/);
+  }
+  const sources = html.match(/<source\b[^>]*>/g);
+  assert.equal(sources.length, 3);
+  sources.forEach(tag => {
+    assert.match(tag, /data-src=/);
+    assert.doesNotMatch(tag, /\ssrc=/);
+  });
+  assert.doesNotMatch(html, /url\s*\(|rel=["']preload/);
+});
+
+test('observer loads each nearby player once, leaving distant media and posters inert', () => {
+  const players = [player(0), player(1800), player(2500, false)];
+  let notify, options;
+  const observed = new Set();
+  class Observer {
+    constructor(callback, config) { notify = callback; options = config; }
+    observe(target) { observed.add(target); }
+    unobserve(target) { observed.delete(target); }
+  }
+  vm.runInNewContext(script, {
+    document: { querySelectorAll: () => players },
+    window: { IntersectionObserver: Observer }, IntersectionObserver: Observer,
+  });
+  assert.equal(options.rootMargin, '200px');
+  players.forEach(p => assert.equal(p.source.src, undefined));
+  notify([{ target: players[0], isIntersecting: true }, { target: players[1], isIntersecting: false }]);
+  assert.equal(players[0].poster, 'poster.jpg');
+  assert.equal(players[0].source.src, 'clip.mp4');
+  assert.equal(players[0].preload, 'metadata');
+  assert.equal(observed.has(players[0]), false);
+  assert.equal(players[1].poster, undefined);
+  assert.equal(players[1].source.src, undefined);
+  assert.equal(players[2].source.src, undefined);
+  notify([{ target: players[0], isIntersecting: true }, { target: players[2], isIntersecting: true }]);
+  assert.equal(players[0].loads, 1);
+  assert.equal(players[2].loads, 1);
+});
+
+test('fallback also defers offscreen assets and cleans up listeners after scrolling', () => {
+  const players = [player(0), player(1500)];
+  const listeners = new Map();
+  const window = {
+    innerHeight: 800, innerWidth: 1200,
+    addEventListener: (event, callback) => listeners.set(event, callback),
+    removeEventListener: event => listeners.delete(event),
+    requestAnimationFrame: callback => callback(),
+  };
+  vm.runInNewContext(script, { document: { querySelectorAll: () => players }, window });
+  assert.equal(players[0].loads, 1);
+  assert.equal(players[1].loads, 0);
+  assert.equal(players[1].poster, undefined);
+  assert.equal(players[1].source.src, undefined);
+  players[1].top = 950;
+  listeners.get('scroll')();
+  assert.equal(players[1].loads, 1);
+  assert.equal(listeners.size, 0);
+});
