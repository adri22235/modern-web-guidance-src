diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,80 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // WebMCP moved from navigator to document; support both implementations.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const toolName = 'get_menu_item';
+      let registrationController;
+
+      const result = (value, isError = false) => ({
+        content: [{ type: 'text', text: JSON.stringify(value) }],
+        ...(isError ? { isError: true } : {}),
+      });
+
+      const tool = {
+        name: toolName,
+        description: 'Look up a Daily Grind menu item by name and return its name, description, and details URL from the current menu. Supports Maple Oat Latte, Dark Roast Espresso, and Cold Brew. Matching ignores capitalization and surrounding whitespace.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              minLength: 1,
+              description: 'The menu item name to look up, such as "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew".',
+            },
+          },
+          required: ['itemName'],
+          additionalProperties: false,
+        },
+        annotations: { readOnlyHint: true },
+        execute: async (input) => {
+          if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+            return result({ error: 'Provide a non-empty itemName string.' }, true);
+          }
+
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href,
+          }));
+          const name = input.itemName.trim().toLowerCase();
+          const item = items.find((item) => item.name.toLowerCase() === name);
+
+          return item ? result(item) : result({
+            error: 'Menu item not found.',
+            availableItems: items.map((item) => item.name),
+          }, true);
+        },
+      };
+
+      function registerTool() {
+        if (registrationController) return;
+        const controller = new AbortController();
+        modelContext.registerTool(tool, { signal: controller.signal });
+        registrationController = controller;
+      }
+
+      function cleanupTool() {
+        if (!registrationController) return;
+        registrationController.abort();
+        registrationController = undefined;
+        // Earlier implementations use explicit unregistration instead of a signal.
+        if (typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(toolName);
+        }
+      }
+
+      registerTool();
+      window.addEventListener('pagehide', cleanupTool);
+      window.addEventListener('pageshow', registerTool);
+    })();
+  </script>
+
 </body>
 
 </html>
