diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,78 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      if (typeof document.modelContext?.registerTool !== 'function') return;
+
+      const menuItems = Array.from(document.querySelectorAll('main .card'), (card) => ({
+        name: card.querySelector('h3').textContent.trim(),
+        description: card.querySelector('p').textContent.trim(),
+        detailsUrl: card.querySelector('a').href,
+      }));
+      let registrationController;
+
+      async function registerMenuTool() {
+        if (registrationController && !registrationController.signal.aborted) return;
+
+        const controller = new AbortController();
+        registrationController = controller;
+
+        try {
+          await document.modelContext.registerTool({
+            name: 'get_menu_item',
+            description: 'Look up a menu item and return its description and details link. Use when a customer asks about a drink on the menu.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                name: {
+                  type: 'string',
+                  description: 'The menu item name as shown on the menu. Matching ignores capitalization and surrounding whitespace.',
+                  examples: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'],
+                  minLength: 1,
+                },
+              },
+              required: ['name'],
+              additionalProperties: false,
+            },
+            execute(input) {
+              if (!input || typeof input !== 'object' || Array.isArray(input)
+                || typeof input.name !== 'string' || !input.name.trim()
+                || Object.keys(input).some((key) => key !== 'name')) {
+                return { error: 'Provide a non-empty menu item name as the only input property.' };
+              }
+
+              const name = input.name.trim().toLowerCase();
+              const item = menuItems.find((entry) => entry.name.toLowerCase() === name);
+
+              if (!item) {
+                return {
+                  error: `Menu item "${input.name.trim()}" not found.`,
+                  availableItems: menuItems.map((entry) => entry.name),
+                };
+              }
+
+              return { ...item };
+            },
+            annotations: { readOnlyHint: true },
+          }, { signal: controller.signal });
+        } catch (error) {
+          if (!controller.signal.aborted) {
+            controller.abort();
+            console.warn('Could not register the menu lookup tool.', error);
+          }
+        }
+      }
+
+      window.addEventListener('pagehide', () => registrationController?.abort());
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerMenuTool();
+      });
+      registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
