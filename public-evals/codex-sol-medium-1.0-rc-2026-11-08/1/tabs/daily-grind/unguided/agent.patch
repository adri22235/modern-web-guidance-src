+  <script>
+    (() => {
+      const menu = document.getElementById('coffee-menu');
+      const tablist = menu.querySelector('[role="tablist"]');
+      const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
+      const panels = Array.from(menu.querySelectorAll('[role="tabpanel"]'));
+      const scrollButtons = Array.from(menu.querySelectorAll('.menu-scroll'));
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const behavior = () => reducedMotion.matches ? 'instant' : 'smooth';
+
+      function updateScrollButtons() {
+        const maxScroll = tablist.scrollWidth - tablist.clientWidth;
+        scrollButtons.forEach(button => {
+          button.hidden = maxScroll <= 1;
+          button.disabled = Number(button.dataset.direction) < 0
+            ? tablist.scrollLeft <= 1
+            : tablist.scrollLeft >= maxScroll - 1;
+        });
+      }
+
+      function revealTab(tab) {
+        const viewport = tablist.getBoundingClientRect();
+        const bounds = tab.getBoundingClientRect();
+        const inset = 4;
+        if (bounds.left < viewport.left + inset) {
+          tablist.scrollBy({ left: bounds.left - viewport.left - inset, behavior: behavior() });
+        } else if (bounds.right > viewport.right - inset) {
+          tablist.scrollBy({ left: bounds.right - viewport.right + inset, behavior: behavior() });
+        }
+      }
+
+      function activateTab(tab, moveFocus = false) {
+        tabs.forEach(item => {
+          const selected = item === tab;
+          item.setAttribute('aria-selected', String(selected));
+          item.tabIndex = selected ? 0 : -1;
+        });
+        panels.forEach(panel => {
+          panel.hidden = panel.id !== tab.getAttribute('aria-controls');
+        });
+        if (moveFocus) tab.focus({ preventScroll: true });
+        revealTab(tab);
+      }
+
+      tabs.forEach(tab => {
+        tab.addEventListener('click', () => activateTab(tab));
+        tab.addEventListener('focus', () => revealTab(tab));
+        tab.addEventListener('keydown', event => {
+          const index = tabs.indexOf(tab);
+          let next;
+          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+          else if (event.key === 'Home') next = 0;
+          else if (event.key === 'End') next = tabs.length - 1;
+          else return;
+          event.preventDefault();
+          activateTab(tabs[next], true);
+        });
+      });
+
+      scrollButtons.forEach(button => {
+        button.addEventListener('click', () => {
+          tablist.scrollBy({
+            left: Number(button.dataset.direction) * tablist.clientWidth * 0.75,
+            behavior: behavior()
+          });
+        });
+      });
+
+      tablist.addEventListener('scroll', updateScrollButtons, { passive: true });
+      new ResizeObserver(updateScrollButtons).observe(tablist);
+      updateScrollButtons();
+    })();
+  </script>
