+  <script>
+    (() => {
+      const menu = document.getElementById('coffee-menu');
+      const tablist = menu.querySelector('[role="tablist"]');
+      const tabs = [...tablist.querySelectorAll('[role="tab"]')];
+      const panels = [...menu.querySelectorAll('[role="tabpanel"]')];
+      const scrollButtons = [...menu.querySelectorAll('.tab-scroll')];
+      const nativeFocusgroup = 'focusGroup' in HTMLElement.prototype;
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const behavior = () => reducedMotion.matches ? 'instant' : 'smooth';
+
+      // Scroll only this container: selecting a category must not move the page.
+      function revealTab(tab, scrollBehavior = behavior()) {
+        const viewport = tablist.getBoundingClientRect();
+        const bounds = tab.getBoundingClientRect();
+        const inset = 24;
+        const offset = bounds.left < viewport.left + inset
+          ? bounds.left - viewport.left - inset
+          : bounds.right > viewport.right - inset
+            ? bounds.right - viewport.right + inset : 0;
+        if (offset) tablist.scrollBy({ left: offset, behavior: scrollBehavior });
+      }
+
+      function selectTab(selected) {
+        tabs.forEach((tab, index) => {
+          const active = tab === selected;
+          tab.setAttribute('aria-selected', String(active));
+          tab.toggleAttribute('focusgroupstart', active);
+          tab.tabIndex = active ? 0 : -1;
+          if (active) panels[index].removeAttribute('hidden');
+          else panels[index].setAttribute('hidden', 'until-found');
+        });
+        revealTab(selected);
+      }
+
+      tabs.forEach(tab => {
+        tab.addEventListener('click', () => selectTab(tab));
+        tab.addEventListener('focus', () => selectTab(tab));
+      });
+
+      // Small roving-focus fallback for browsers without native focusgroup.
+      if (!nativeFocusgroup) {
+        tablist.addEventListener('keydown', event => {
+          const index = tabs.indexOf(document.activeElement);
+          if (index < 0 || event.altKey || event.ctrlKey || event.metaKey) return;
+          let next;
+          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+          else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
+          else if (event.key === 'Home') next = 0;
+          else if (event.key === 'End') next = tabs.length - 1;
+          else return;
+          event.preventDefault();
+          // revealTab immediately makes this focus target visible horizontally.
+          tabs[next].focus({ preventScroll: true });
+        });
+      }
+
+      panels.forEach((panel, index) => {
+        panel.addEventListener('beforematch', () => selectTab(tabs[index]));
+      });
+
+      function updateOverflow() {
+        const max = tablist.scrollWidth - tablist.clientWidth;
+        const overflow = max > 1;
+        scrollButtons.forEach(button => { button.hidden = !overflow; });
+        const atStart = tablist.scrollLeft <= 1;
+        const atEnd = tablist.scrollLeft >= max - 1;
+        scrollButtons[0].disabled = atStart;
+        scrollButtons[1].disabled = atEnd;
+        tablist.classList.toggle('more-start', overflow && !atStart);
+        tablist.classList.toggle('more-end', overflow && !atEnd);
+      }
+
+      scrollButtons.forEach(button => {
+        button.addEventListener('click', () => {
+          tablist.scrollBy({
+            left: Number(button.dataset.direction) * tablist.clientWidth * .75,
+            behavior: behavior()
+          });
+        });
+      });
+      tablist.addEventListener('scroll', updateOverflow, { passive: true });
+      const resizeObserver = new ResizeObserver(() => {
+        updateOverflow();
+        revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'), 'instant');
+      });
+      resizeObserver.observe(tablist);
+      tabs.forEach(tab => resizeObserver.observe(tab));
+      updateOverflow();
+    })();
+  </script>
+
