+  <script>
+    const menu = document.querySelector('#coffee-menu');
+    const tablist = menu.querySelector('.menu-tabs');
+    const tabs = [...tablist.querySelectorAll('.menu-tab')];
+    const panels = [...menu.querySelectorAll('[role="tabpanel"]')];
+    const scrollButtons = [...menu.querySelectorAll('.menu-scroll')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const scrollBehavior = () => reducedMotion.matches ? 'instant' : 'smooth';
+
+    function selectTab(selected) {
+      for (const tab of tabs) {
+        const active = tab === selected;
+        tab.setAttribute('aria-selected', String(active));
+        tab.toggleAttribute('focusgroupstart', active);
+      }
+      for (const panel of panels) {
+        if (panel.getAttribute('aria-labelledby') === selected.id) {
+          panel.removeAttribute('hidden');
+        } else {
+          panel.setAttribute('hidden', 'until-found');
+        }
+      }
+      // Scroll only the tab strip; keep the page at the user's reading position.
+      selected.scrollIntoView({
+        behavior: scrollBehavior(), block: 'nearest', inline: 'nearest', container: 'nearest'
+      });
+    }
+
+    tablist.addEventListener('click', event => {
+      const tab = event.target.closest('.menu-tab');
+      if (tab) selectTab(tab);
+    });
+
+    // Native focusgroup manages arrow keys and the single Tab stop.
+    tablist.addEventListener('focusin', event => {
+      if (tabs.includes(event.target)) selectTab(event.target);
+    });
+
+    panels.forEach(panel => {
+      panel.addEventListener('beforematch', () => {
+        selectTab(tabs.find(tab => tab.id === panel.getAttribute('aria-labelledby')));
+      });
+    });
+
+    function updateScrollButtons() {
+      const overflows = tablist.scrollWidth > tablist.clientWidth + 1;
+      const atStart = tablist.scrollLeft <= 1;
+      const atEnd = tablist.scrollLeft + tablist.clientWidth >= tablist.scrollWidth - 1;
+      for (const button of scrollButtons) {
+        button.hidden = !overflows;
+        const atEdge = button.dataset.direction === '-1' ? atStart : atEnd;
+        // Keep focus on the button when scrolling reaches an edge.
+        button.setAttribute('aria-disabled', String(atEdge));
+      }
+    }
+
+    scrollButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        if (button.getAttribute('aria-disabled') === 'true') return;
+        tablist.scrollBy({
+          left: Number(button.dataset.direction) * tablist.clientWidth * 0.75,
+          behavior: scrollBehavior()
+        });
+      });
+    });
+    tablist.addEventListener('scroll', updateScrollButtons, { passive: true });
+    new ResizeObserver(() => {
+      updateScrollButtons();
+      const selected = tabs.find(tab => tab.getAttribute('aria-selected') === 'true');
+      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+    }).observe(tablist);
+    updateScrollButtons();
+  </script>
+
