+<script>
+  (() => {
+    const section = document.querySelector('.seasonal');
+    const grid = section.querySelector('.seasonal-grid');
+    const restore = section.querySelector('.restore-button');
+    const empty = section.querySelector('.seasonal-empty');
+    const status = section.querySelector('[role="status"]');
+    const originals = [...grid.children].map(card => card.cloneNode(true));
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const moves = new Map();
+    const panels = new Map();
+    const exits = new Map();
+    const cards = () => [...grid.querySelectorAll('.seasonal-card:not(.removing-card)')];
+    const animate = (element, frames, options) => {
+      if (reducedMotion.matches || !element.animate) return null;
+      return element.animate(frames, { duration: 320, easing: 'cubic-bezier(.2,.8,.2,1)', ...options });
+    };
+    const settle = (animation, callback) => {
+      if (animation) animation.finished.then(callback, () => {});
+      else callback();
+    };
+    const updateControls = () => {
+      const current = cards();
+      current.forEach((card, index) => {
+        card.querySelector('[data-action="earlier"]').disabled = index === 0;
+        card.querySelector('[data-action="later"]').disabled = index === current.length - 1;
+      });
+      empty.hidden = current.length > 0;
+      restore.hidden = current.length === originals.length;
+    };
+    // Measure each card's current visual position before interrupting its animation.
+    // FLIP animates only the changed cards; no document transition or overlay is used.
+    const changeLayout = (change) => {
+      const before = new Map(cards().map(card => [card, card.getBoundingClientRect()]));
+      moves.forEach(animation => animation.cancel());
+      moves.clear();
+      change();
+      updateControls();
+      cards().forEach(card => {
+        const from = before.get(card);
+        if (!from) return;
+        const to = card.getBoundingClientRect();
+        const x = from.left - to.left;
+        const y = from.top - to.top;
+        if (Math.abs(x) < .5 && Math.abs(y) < .5) return;
+        const animation = animate(card, [
+          { transform: `translate(${x}px, ${y}px)` },
+          { transform: 'translate(0, 0)' }
+        ]);
+        if (animation) {
+          moves.set(card, animation);
+          settle(animation, () => { if (moves.get(card) === animation) moves.delete(card); });
+        }
+      });
+    };
+    section.addEventListener('click', event => {
+      const button = event.target.closest('button[data-action]');
+      if (!button || button.disabled) return;
+      const card = button.closest('.seasonal-card');
+      if (!card || card.classList.contains('removing-card')) return;
+      const name = card.querySelector('h3').textContent;
+      const action = button.dataset.action;
+      if (action === 'customize') {
+        const panel = card.querySelector('.customizations');
+        const opening = button.getAttribute('aria-expanded') !== 'true';
+        const fromHeight = panel.getBoundingClientRect().height;
+        panels.get(panel)?.cancel();
+        panel.hidden = false;
+        panel.inert = !opening;
+        button.setAttribute('aria-expanded', String(opening));
+        const animation = animate(panel, [
+          { height: `${fromHeight}px`, opacity: fromHeight ? 1 : 0 },
+          { height: `${opening ? panel.scrollHeight : 0}px`, opacity: opening ? 1 : 0 }
+        ]);
+        panels.set(panel, animation);
+        settle(animation, () => {
+          if (panels.get(panel) !== animation) return;
+          panel.hidden = !opening;
+          panels.delete(panel);
+        });
+        return;
+      }
+      const current = cards();
+      const index = current.indexOf(card);
+      if (action === 'remove') {
+        const nextFocus = current[index + 1] || current[index - 1];
+        // Keep the departing card inside the component, outside grid flow.
+        const bounds = card.getBoundingClientRect();
+        const gridBounds = grid.getBoundingClientRect();
+        panels.get(card.querySelector('.customizations'))?.cancel();
+        panels.delete(card.querySelector('.customizations'));
+        changeLayout(() => {
+          card.classList.add('removing-card');
+          Object.assign(card.style, {
+            left: `${bounds.left - gridBounds.left}px`, top: `${bounds.top - gridBounds.top}px`,
+            width: `${bounds.width}px`, height: `${bounds.height}px`
+          });
+          card.inert = true;
+          card.setAttribute('aria-hidden', 'true');
+        });
+        const animation = animate(card, [
+          { opacity: 1, transform: 'scale(1)' },
+          { opacity: 0, transform: 'scale(.94) translateY(12px)' }
+        ], { duration: 220 });
+        if (animation) exits.set(card, animation);
+        settle(animation, () => { card.remove(); exits.delete(card); });
+        (nextFocus?.querySelector('[data-action="remove"]') || restore).focus({ preventScroll: true });
+        status.textContent = `${name} removed.`;
+      } else {
+        const neighbor = current[index + (action === 'earlier' ? -1 : 1)];
+        if (!neighbor) return;
+        changeLayout(() => {
+          if (action === 'earlier') grid.insertBefore(card, neighbor);
+          else grid.insertBefore(neighbor, card);
+        });
+        // A move can disable the pressed boundary control; keep keyboard focus nearby.
+        if (button.disabled) card.querySelector(`[data-action="${action === 'earlier' ? 'later' : 'earlier'}"]`).focus({ preventScroll: true });
+        status.textContent = `${name} moved to position ${cards().indexOf(card) + 1} of ${cards().length}.`;
+      }
+    });
+    restore.addEventListener('click', () => {
+      exits.forEach((animation, card) => { animation.cancel(); card.remove(); });
+      exits.clear();
+      changeLayout(() => {
+        const present = new Set(cards().map(card => card.dataset.drink));
+        originals.forEach(original => {
+          if (!present.has(original.dataset.drink)) grid.append(original.cloneNode(true));
+        });
+      });
+      cards()[0].querySelector('[data-action="remove"]').focus({ preventScroll: true });
+      status.textContent = 'Removed drinks restored.';
+    });
+    // Finish active effects immediately if the visitor enables reduced motion.
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) {
+        [...moves.values(), ...panels.values(), ...exits.values()].forEach(animation => animation?.finish());
+      }
+    });
+    updateControls();
+  })();
+</script>
