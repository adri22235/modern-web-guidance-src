+    /* The list moves wrappers; each card owns its independent inner transition. */
+    .favorites [hidden] { display: none !important; }
+    .favorites-grid { align-items: start; }
+    .favorite-wrapper { view-transition-name: match-element; view-transition-class: favorite; }
+    .favorite-card { view-transition-scope: all; overflow: clip; }
+    .favorite-card [data-part] { view-transition-name: match-element; }
+    .favorites-heading { text-align: center; }
+    .favorites-tools { display: flex; justify-content: center; margin: 12px 0; }
+    .favorites-help { text-align: center; font-size: 0.9rem; }
+    .card-controls { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 18px; }
+    .favorites button, .favorites select {
+      font: inherit;
+      color: var(--primary);
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 5px;
+      padding: 6px 10px;
+    }
+    .favorites button { cursor: pointer; }
+    .favorites button:hover { background: #f4eeeb; }
+    .favorites button:disabled { opacity: 0.45; cursor: default; }
+    .favorites :focus-visible { outline: 3px solid #a65c00; outline-offset: 3px; }
+    .customization { border: 0; border-top: 1px solid var(--secondary); margin-top: 18px; padding-top: 12px; text-align: left; }
+    .customization legend { padding: 0 6px; font-weight: 600; }
+    .customization label { display: block; margin-top: 10px; }
+    .customization select { display: block; width: 100%; margin-top: 4px; }
+    .customization input { accent-color: var(--primary); }
+    .favorites-status { text-align: center; min-height: 1.6em; margin-top: 12px; font-size: 0.9rem; }
+    .favorites-empty { text-align: center; grid-column: 1 / -1; padding: 30px; }
+
+    .favorites-grid::view-transition,
+    .favorite-card::view-transition { pointer-events: none; }
+
+    .favorites-grid::view-transition-group(*),
+    .favorite-card::view-transition-group(*) {
+      animation-duration: 280ms;
+      animation-timing-function: ease-in-out;
+    }
+    .favorites-grid::view-transition-old(.favorite):only-child {
+      animation: favorite-exit 220ms ease-in both;
+    }
+    .favorites-grid::view-transition-new(.favorite):only-child {
+      animation: favorite-enter 280ms ease-out both;
+    }
+    @keyframes favorite-exit { to { opacity: 0; transform: translateY(12px) scale(0.97); } }
+    @keyframes favorite-enter { from { opacity: 0; transform: translateY(12px) scale(0.97); } }
+
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) { animation: none !important; }
+    }
