+  <script>
+    const favorites = document.querySelector('.favorites');
+    const grid = favorites.querySelector('#favorites-grid');
+    const restore = favorites.querySelector('#restore-favorites');
+    const empty = favorites.querySelector('#favorites-empty');
+    const status = favorites.querySelector('#favorites-status');
+    const originalCards = [...grid.querySelectorAll('.favorite-wrapper')];
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Never use a document transition: it would capture the navigation and serialize cards.
+    function transitionWithin(scope, update) {
+      if (reducedMotion.matches || typeof scope.startViewTransition !== 'function') {
+        update();
+        return;
+      }
+      const transition = scope.startViewTransition(update);
+      // Rapid actions on one scope can skip its previous transition.
+      transition.ready.catch(() => {});
+    }
+
+    function cards() {
+      return [...grid.querySelectorAll('.favorite-wrapper')];
+    }
+
+    function refreshControls() {
+      const visible = cards();
+      visible.forEach((wrapper, index) => {
+        wrapper.querySelector('[data-action="earlier"]').disabled = index === 0;
+        wrapper.querySelector('[data-action="later"]').disabled = index === visible.length - 1;
+      });
+      empty.hidden = visible.length > 0;
+      restore.disabled = visible.length === originalCards.length;
+    }
+
+    favorites.querySelectorAll('[data-enhancement]').forEach(el => { el.hidden = false; });
+    refreshControls();
+
+    grid.addEventListener('click', event => {
+      const button = event.target.closest('button[data-action]');
+      if (!button) return;
+      const wrapper = button.closest('.favorite-wrapper');
+      const card = wrapper.querySelector('.favorite-card');
+      const title = card.querySelector('h3').textContent;
+      const action = button.dataset.action;
+
+      if (action === 'customize') {
+        transitionWithin(card, () => {
+          const options = card.querySelector('.customization');
+          options.hidden = !options.hidden;
+          button.setAttribute('aria-expanded', String(!options.hidden));
+          button.textContent = options.hidden ? 'Customize' : 'Done';
+        });
+        return;
+      }
+
+      transitionWithin(grid, () => {
+        // Compute from the live DOM, including earlier queued rapid actions.
+        const visible = cards();
+        const index = visible.indexOf(wrapper);
+        if (index === -1) return;
+        const hadFocus = wrapper.contains(document.activeElement);
+        if (action === 'remove') {
+          const neighbor = visible[index + 1] || visible[index - 1];
+          wrapper.remove();
+          refreshControls();
+          if (hadFocus) (neighbor?.querySelector('[data-action="remove"]') || restore).focus({ preventScroll: true });
+          status.textContent = `${title} removed. Restore all drinks to bring it back.`;
+        } else {
+          const neighbor = visible[index + (action === 'earlier' ? -1 : 1)];
+          if (!neighbor) return;
+          // Move the existing wrapper to retain customization values and transition identity.
+          grid.insertBefore(wrapper, action === 'earlier' ? neighbor : neighbor.nextSibling);
+          refreshControls();
+          if (hadFocus) {
+            const focusTarget = button.disabled
+              ? card.querySelector(`[data-action="${action === 'earlier' ? 'later' : 'earlier'}"]`)
+              : button;
+            focusTarget.focus({ preventScroll: true });
+          }
+          status.textContent = `${title} moved to position ${cards().indexOf(wrapper) + 1} of ${visible.length}.`;
+        }
+      });
+    });
+
+    grid.addEventListener('change', event => {
+      if (!event.target.matches('[data-milk], [data-shot]')) return;
+      const card = event.target.closest('.favorite-card');
+      transitionWithin(card, () => {
+        card.querySelector('[data-summary]').textContent =
+          `${card.querySelector('[data-milk]').value} · ${card.querySelector('[data-shot]').checked ? 'Extra shot' : 'No extra shot'}`;
+      });
+    });
+
+    restore.addEventListener('click', () => {
+      transitionWithin(grid, () => {
+        const hadFocus = document.activeElement === restore;
+        originalCards.forEach(wrapper => grid.insertBefore(wrapper, empty));
+        refreshControls();
+        if (hadFocus) originalCards[0].querySelector('[data-action="remove"]').focus({ preventScroll: true });
+        status.textContent = 'All drinks restored in their original order. Your customizations are kept.';
+      });
+    });
+  </script>
+
