+  <script>
+    const drinkCards = [...document.querySelectorAll('.card[data-drink]')];
+    const status = document.querySelector('.drink-status');
+
+    function setActionsOpen(card, open) {
+      if (open) {
+        drinkCards.forEach(other => {
+          if (other !== card) setActionsOpen(other, false);
+        });
+      }
+      const toggle = card.querySelector('.actions-toggle');
+      const actions = card.querySelector('.drink-actions');
+      if (!open && actions.contains(document.activeElement)) toggle.focus();
+      card.classList.toggle('is-open', open);
+      actions.inert = !open;
+      toggle.setAttribute('aria-expanded', String(open));
+      toggle.setAttribute('aria-label', `${open ? 'Hide' : 'Show'} actions for ${card.dataset.drink}`);
+      toggle.textContent = open ? 'Close' : 'Actions';
+    }
+
+    drinkCards.forEach(card => {
+      const content = card.querySelector('.drink-content');
+      let gesture = null;
+      let suppressClickUntil = 0;
+
+      card.querySelector('.actions-toggle').addEventListener('click', () => {
+        setActionsOpen(card, !card.classList.contains('is-open'));
+      });
+
+      content.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button, a')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, horizontal: false };
+      });
+
+      content.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.horizontal) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 10) return;
+          if (Math.abs(dy) >= Math.abs(dx)) {
+            gesture = null;
+            return;
+          }
+          gesture.horizontal = true;
+          content.setPointerCapture(event.pointerId);
+        }
+      });
+
+      content.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        if (gesture.horizontal) {
+          // A swipe only reveals or dismisses controls; actions require a separate click.
+          suppressClickUntil = Date.now() + 500;
+          if (Math.abs(dx) >= 40) setActionsOpen(card, dx < 0);
+        }
+        gesture = null;
+      });
+
+      const cancelGesture = () => { gesture = null; };
+      content.addEventListener('pointercancel', cancelGesture);
+      content.addEventListener('lostpointercapture', cancelGesture);
+      card.addEventListener('click', event => {
+        if (Date.now() < suppressClickUntil) {
+          event.preventDefault();
+          event.stopImmediatePropagation();
+        }
+      }, true);
+
+      card.addEventListener('keydown', event => {
+        if (event.key === 'Escape') setActionsOpen(card, false);
+      });
+
+      card.querySelector('.favorite-toggle').addEventListener('click', event => {
+        const button = event.currentTarget;
+        const saved = button.getAttribute('aria-pressed') !== 'true';
+        button.setAttribute('aria-pressed', String(saved));
+        button.textContent = saved ? 'Unsave Favorite' : 'Save Favorite';
+        button.setAttribute('aria-label', `${saved ? 'Remove' : 'Save'} ${card.dataset.drink} ${saved ? 'from' : 'to'} favorites`);
+        status.textContent = `${card.dataset.drink} ${saved ? 'saved to' : 'removed from'} favorites for this visit.`;
+      });
+    });
+  </script>
