+  <script>
+    for (const card of document.querySelectorAll('.drink-card')) {
+      const content = card.querySelector('.drink-content');
+      const toggle = card.querySelector('.drink-toggle');
+      const close = card.querySelector('.drink-close');
+
+      const setOpen = (open) => {
+        card.scrollTo({ left: open ? card.scrollWidth - card.clientWidth : 0 });
+      };
+
+      toggle.addEventListener('click', () => {
+        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
+      });
+
+      const closeActions = () => {
+        toggle.focus({ preventScroll: true });
+        setOpen(false);
+      };
+
+      close.addEventListener('click', closeActions);
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeActions();
+        }
+      });
+
+      card.addEventListener('scroll', () => {
+        const halfway = (card.scrollWidth - card.clientWidth) / 2;
+        toggle.setAttribute('aria-expanded', String(card.scrollLeft > halfway));
+      }, { passive: true });
+
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          setOpen(false);
+        }
+      });
+    }
+  </script>
