+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Locations | The Daily Grind</title>
+  <link rel="stylesheet" href="/styles.css" blocking="render">
+  <!-- Keep readiness scoped to the header and opening content, never the footer. -->
+  <link rel="expect" href="#site-navigation" blocking="render">
+  <link rel="expect" href="#hero" blocking="render">
+  <link rel="expect" href="#locations-content" blocking="render">
+</head>
+<body>
+  <nav id="site-navigation" aria-label="Main navigation">
+    <a class="logo" href="/" aria-label="The Daily Grind home">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations" aria-current="page">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header id="hero" class="page-hero">
+    <h1>Locations</h1>
+    <p>Your neighborhood coffee break starts here.</p>
+  </header>
+
+  <main class="container">
+    <section id="locations-content" aria-labelledby="locations-title">
+      <h2 id="locations-title" class="section-title">Find The Daily Grind</h2>
+      <div class="grid">
+        <article class="card">
+          <h3>Visit Us</h3>
+          <p>Enjoy ethically sourced, locally roasted coffee and our seasonal favorites.</p>
+          <p>Location details and opening hours will be listed here when available.</p>
+          <a href="/menu" class="btn">Explore the Menu</a>
+        </article>
+      </div>
+    </section>
+    <a href="/" class="btn">Back to Home</a>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+</body>
+</html>
