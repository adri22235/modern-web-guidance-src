diff --git a/transitions.css b/transitions.css
new file mode 100644
index 0000000..17772c1
--- /dev/null
+++ b/transitions.css
@@ -0,0 +1,32 @@
+/* Load in the head of every same-origin page participating in transitions. */
+@view-transition {
+  navigation: auto;
+}
+
+/* Keep the shared header stable while the page content crossfades. */
+#site-header {
+  view-transition-name: site-header;
+}
+
+::view-transition-group(*) {
+  animation-duration: 240ms;
+  animation-timing-function: ease-in-out;
+}
+
+::view-transition-old(root),
+::view-transition-new(root) {
+  animation-duration: 240ms;
+  animation-timing-function: ease-in-out;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none;
+  }
+}
