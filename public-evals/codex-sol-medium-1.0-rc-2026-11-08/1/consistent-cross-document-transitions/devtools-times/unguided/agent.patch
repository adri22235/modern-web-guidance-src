diff --git a/src/scripts/page-transitions.ts b/src/scripts/page-transitions.ts
new file mode 100644
index 0000000..0075d56
--- /dev/null
+++ b/src/scripts/page-transitions.ts
@@ -0,0 +1,71 @@
+import type {
+  TransitionBeforePreparationEvent,
+  TransitionBeforeSwapEvent,
+} from "astro:transitions/client";
+
+const preparedPages = new WeakSet<Document>();
+const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
+
+async function decodeImage(source: HTMLImageElement): Promise<void> {
+  // Detached documents do not reliably load images. Use a live Image to warm
+  // the same resource cache, including responsive candidates and CORS mode.
+  const image = new Image();
+  if (source.hasAttribute("crossorigin")) image.crossOrigin = source.crossOrigin;
+  image.referrerPolicy = source.referrerPolicy;
+  image.sizes = source.sizes;
+  image.srcset = source.srcset;
+  image.src = source.src;
+  await image.decode();
+}
+
+document.addEventListener("astro:before-preparation", (event) => {
+  const navigation = event as TransitionBeforePreparationEvent;
+  const load = navigation.loader;
+
+  navigation.loader = async () => {
+    // Astro first fetches the HTML and preloads the incoming stylesheets.
+    // Keep the existing page visible while preparing the rest of the snapshot.
+    await load();
+    if (navigation.signal.aborted || reducedMotion.matches) return;
+
+    const incoming = navigation.newDocument;
+    // History/anchor navigation can reveal images anywhere on the page.
+    const selector = navigation.navigationType === "traverse" || navigation.to.hash
+      ? "img"
+      : 'img:not([loading="lazy"])';
+    const images = [...incoming.querySelectorAll<HTMLImageElement>(selector)];
+
+    let timeout: ReturnType<typeof setTimeout> | undefined;
+    let abort: (() => void) | undefined;
+    try {
+      await Promise.race([
+        Promise.all([
+          ...images.map(decodeImage),
+          document.fonts.load('500 1em "Grenze"').then((fonts) => {
+            if (!fonts.length) throw new Error("Headline font unavailable");
+          }),
+          document.fonts.ready,
+        ]),
+        new Promise<never>((_, reject) => {
+          timeout = setTimeout(() => reject(new Error("Asset preparation timed out")), 2500);
+          abort = () => reject(new Error("Navigation superseded"));
+          navigation.signal.addEventListener("abort", abort, { once: true });
+        }),
+      ]);
+      if (!navigation.signal.aborted) preparedPages.add(incoming);
+    } catch {
+      // Failed/slow assets must never trap navigation or animate partial content.
+      // The swap below still works, using normal progressive page rendering.
+    } finally {
+      clearTimeout(timeout);
+      if (abort) navigation.signal.removeEventListener("abort", abort);
+    }
+  };
+});
+
+document.addEventListener("astro:before-swap", (event) => {
+  const navigation = event as TransitionBeforeSwapEvent;
+  if (reducedMotion.matches || !preparedPages.has(navigation.newDocument)) {
+    navigation.viewTransition.skipTransition();
+  }
+});
diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..af5a2cc 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,21 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+html {
+  scrollbar-gutter: stable;
+}
+
+/* Fade content without interpolating between differently sized page layouts. */
+::view-transition-group(page-content) {
+  animation: none;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation: none !important;
+  }
+}
