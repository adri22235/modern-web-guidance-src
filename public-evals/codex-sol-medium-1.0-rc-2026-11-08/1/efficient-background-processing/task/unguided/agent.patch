+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const beans = Array.from({ length: 32 }, (_, index) => ({
+        phase: index * 2.4,
+        radius: 0.3 + Math.random() * 0.65,
+        size: 7 + Math.random() * 5
+      }));
+      let frameId = null;
+      let temperatureInterval = null;
+      let inViewport = false;
+      let renderingSkipped = false;
+      let lastFrameTime = null;
+      let elapsed = 0;
+      let temperatureTick = 0;
+
+      function draw(now) {
+        if (lastFrameTime !== null) elapsed += Math.min(now - lastFrameTime, 50);
+        lastFrameTime = now;
+        const width = canvas.width;
+        const height = canvas.height;
+        context.clearRect(0, 0, width, height);
+        context.strokeStyle = '#705047';
+        context.lineWidth = 2;
+        context.beginPath();
+        context.ellipse(width / 2, height / 2, width * 0.45, height * 0.43, 0, 0, Math.PI * 2);
+        context.stroke();
+
+        beans.forEach((bean) => {
+          const angle = elapsed * 0.0007 + bean.phase;
+          const x = width / 2 + Math.cos(angle) * width * 0.4 * bean.radius;
+          const y = height / 2 + Math.sin(angle) * height * 0.35 * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(angle * 2);
+          context.fillStyle = '#b57543';
+          context.beginPath();
+          context.ellipse(0, 0, bean.size, bean.size * 0.65, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#4e2d1c';
+          context.beginPath();
+          context.moveTo(-bean.size * 0.65, 0);
+          context.bezierCurveTo(-2, -4, 2, 4, bean.size * 0.65, 0);
+          context.stroke();
+          context.restore();
+        });
+        frameId = requestAnimationFrame(draw);
+      }
+
+      function syncActivity() {
+        const active = inViewport && !renderingSkipped && !document.hidden;
+        if (active) {
+          if (context && frameId === null) frameId = requestAnimationFrame(draw);
+          if (temperatureInterval === null) {
+            temperatureInterval = setInterval(() => {
+              temperatureTick += 1;
+              temperature.textContent = Math.round(195 + Math.sin(temperatureTick / 5) * 12);
+            }, 1000);
+          }
+        } else {
+          if (frameId !== null) cancelAnimationFrame(frameId);
+          if (temperatureInterval !== null) clearInterval(temperatureInterval);
+          frameId = null;
+          temperatureInterval = null;
+          lastFrameTime = null;
+        }
+      }
+
+      // Native rendering-state notifications also cover content-visibility skipping.
+      // Viewport observation remains active when this event is unavailable.
+      widget.addEventListener('contentvisibilityautostatechange', (event) => {
+        renderingSkipped = event.skipped;
+        syncActivity();
+      });
+
+      function checkViewport() {
+        const bounds = widget.getBoundingClientRect();
+        inViewport = bounds.bottom > 0 && bounds.top < window.innerHeight &&
+          bounds.right > 0 && bounds.left < window.innerWidth;
+        syncActivity();
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          inViewport = entries[0].isIntersecting && entries[0].intersectionRatio > 0;
+          syncActivity();
+        });
+        observer.observe(widget);
+      } else {
+        // No repeating polling timer: older browsers check only on viewport changes.
+        document.addEventListener('scroll', checkViewport, { passive: true, capture: true });
+        window.addEventListener('resize', checkViewport, { passive: true });
+        checkViewport();
+      }
+
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) checkViewport();
+        else syncActivity();
+      });
+      window.addEventListener('pagehide', () => {
+        inViewport = false;
+        syncActivity();
+      });
+      window.addEventListener('pageshow', checkViewport);
+    })();
+  </script>
