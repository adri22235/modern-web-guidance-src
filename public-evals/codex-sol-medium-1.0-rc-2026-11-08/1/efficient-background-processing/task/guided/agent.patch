+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperatureValue = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const beans = Array.from({ length: 36 }, () => ({
+        phase: Math.random() * Math.PI * 2,
+        radius: 0.3 + Math.random() * 0.6,
+        speed: 0.6 + Math.random() * 0.6,
+        size: 9 + Math.random() * 5
+      }));
+      let frameId = null;
+      let intervalId = null;
+      let running = false;
+      let inView = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let lastFrameTime = null;
+      let elapsed = 0;
+      let temperature = 185;
+
+      function draw(time) {
+        if (!running) return;
+        if (lastFrameTime !== null) elapsed += Math.min(time - lastFrameTime, 50) / 1000;
+        lastFrameTime = time;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach((bean) => {
+          const angle = bean.phase + elapsed * bean.speed;
+          const x = canvas.width / 2 + Math.cos(angle) * canvas.width * 0.43 * bean.radius;
+          const y = canvas.height / 2 + Math.sin(angle) * canvas.height * 0.36 * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(angle);
+          context.scale(1, 0.65);
+          context.beginPath();
+          context.arc(0, 0, bean.size, 0, Math.PI * 2);
+          context.fillStyle = '#a96d42';
+          context.fill();
+          context.beginPath();
+          context.moveTo(0, -bean.size * 0.8);
+          context.bezierCurveTo(-6, -3, 6, 3, 0, bean.size * 0.8);
+          context.strokeStyle = '#4e342e';
+          context.lineWidth = 2;
+          context.stroke();
+          context.restore();
+        });
+        frameId = requestAnimationFrame(draw);
+      }
+
+      function stop() {
+        running = false;
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = null;
+        intervalId = null;
+        lastFrameTime = null;
+      }
+
+      function syncActivity() {
+        if (!inView || renderingSkipped || document.hidden || !pageActive) {
+          stop();
+          return;
+        }
+        if (running) return;
+        running = true;
+        if (context) frameId = requestAnimationFrame(draw);
+        intervalId = setInterval(() => {
+          temperature = Math.max(180, Math.min(220, temperature + (Math.random() - 0.35) * 2));
+          temperatureValue.textContent = temperature.toFixed(1);
+        }, 1000);
+      }
+
+      // Listen on the element itself: this rendering-state event may not bubble.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      function checkViewport() {
+        const rect = widget.getBoundingClientRect();
+        inView = rect.bottom > 0 && rect.top < window.innerHeight &&
+          rect.right > 0 && rect.left < window.innerWidth;
+        syncActivity();
+      }
+
+      // Also track the actual viewport: native rendering can begin before visibility.
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          inView = entries[0].isIntersecting && entries[0].intersectionRatio > 0;
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Last-resort fallback requires no polling or continuously running loop.
+        document.addEventListener('scroll', checkViewport, { passive: true, capture: true });
+        window.addEventListener('resize', checkViewport, { passive: true });
+      }
+
+      document.addEventListener('visibilitychange', () => {
+        if (document.hidden) stop();
+        else checkViewport();
+      });
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        stop();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        checkViewport();
+      });
+      checkViewport();
+    })();
+  </script>
+
