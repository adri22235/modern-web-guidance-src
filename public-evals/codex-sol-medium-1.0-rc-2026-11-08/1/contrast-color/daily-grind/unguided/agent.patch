+  <script>
+    // Fallback for browsers without CSS contrast-color(). Choose the higher
+    // WCAG contrast ratio, which is at least 4.58:1 for opaque backgrounds.
+    if (!CSS.supports('color', 'contrast-color(red)')) {
+      const root = document.documentElement;
+      const canvas = document.createElement('canvas');
+      canvas.width = canvas.height = 1;
+      const context = canvas.getContext('2d', { willReadFrequently: true });
+
+      function contrastingText(background) {
+        context.clearRect(0, 0, 1, 1);
+        context.fillStyle = background;
+        context.fillRect(0, 0, 1, 1);
+        const channels = context.getImageData(0, 0, 1, 1).data;
+        const linear = Array.from(channels).slice(0, 3).map(channel => {
+          const value = channel / 255;
+          return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
+        });
+        const luminance = linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722;
+        return (luminance + 0.05) / 0.05 >= 1.05 / (luminance + 0.05) ? '#000' : '#fff';
+      }
+
+      function updateContrast() {
+        for (const [selector, property] of [['nav', '--on-primary'], ['footer', '--on-secondary']]) {
+          const background = getComputedStyle(document.querySelector(selector)).backgroundColor;
+          const foreground = contrastingText(background);
+          // Avoid triggering another mutation when the chosen color is unchanged.
+          if (root.style.getPropertyValue(property) !== foreground) {
+            root.style.setProperty(property, foreground);
+          }
+        }
+      }
+
+      updateContrast();
+      new MutationObserver(updateContrast).observe(root, {
+        subtree: true,
+        attributes: true,
+        attributeFilter: ['style', 'class', 'href', 'media', 'disabled'],
+        childList: true,
+        characterData: true
+      });
+      document.addEventListener('load', updateContrast, true);
+      window.addEventListener('resize', updateContrast);
+      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateContrast);
+    }
+  </script>
+
