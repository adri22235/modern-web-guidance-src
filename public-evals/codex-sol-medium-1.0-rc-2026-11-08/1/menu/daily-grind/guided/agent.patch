+
+      function buildMenu(mount, label, entries, className = '') {
+        const id = `coffee-menu-${++sequence}`;
+        const trigger = document.createElement('button');
+        trigger.type = 'button'; trigger.id = `${id}-trigger`;
+        trigger.className = `menu-trigger ${className}`;
