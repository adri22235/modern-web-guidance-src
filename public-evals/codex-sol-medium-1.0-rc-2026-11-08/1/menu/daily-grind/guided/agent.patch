+            items[next]?.focus();
+          }
+        });
+        return menu;
+      }
+
+      buildMenu(document.getElementById('drink-menu-mount'), 'Menu', [
+        branch('Drink categories', [
+          branch('Hot drinks', [link('Espresso & americanos', '/menu/espresso'), link('Lattes & cappuccinos', '/menu/lattes'), link('Tea & hot chocolate', '/menu/tea')]),
+          branch('Cold drinks', [link('Cold brew', '/menu/cold-brew'), link('Iced coffee & lattes', '/menu/iced-coffee')]),
+          link('Seasonal favorites', '#seasonal-title')
+        ]), null, link('Browse the full menu', '/menu'), link('Order online', '/order-online')
+      ], 'nav-menu-trigger');
+
+      const drinks = [
+        { id: 'maple', name: 'Maple Oat Latte', path: 'seasonal', size: 'Medium', milk: 'Oat milk', extra: false },
+        { id: 'espresso', name: 'Dark Roast Espresso', path: 'espresso', size: 'Small', milk: 'No milk', extra: false },
+        { id: 'cold', name: 'Cold Brew', path: 'cold-brew', size: 'Medium', milk: 'No milk', extra: false }
