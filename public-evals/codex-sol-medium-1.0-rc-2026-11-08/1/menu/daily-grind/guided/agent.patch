+        const height = menu.offsetHeight;
+        let left = nested ? rect.right + 5 : rect.left;
+        let top = nested ? rect.top : rect.bottom + 8;
+        if (left + width > innerWidth - 12) left = nested ? rect.left - width - 5 : rect.right - width;
+        if (nested && left < 12) { left = rect.left + 16; top = rect.bottom + 4; }
+        if (top + height > innerHeight - 12) {
+          top = nested ? Math.max(12, innerHeight - height - 12) : Math.max(12, rect.top - height - 8);
+        }
+        left = Math.max(12, Math.min(left, innerWidth - width - 12));
