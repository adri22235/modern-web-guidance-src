+        trigger.append(document.createTextNode(label));
+        const chevron = document.createElement('span');
+        chevron.className = 'hint chevron'; chevron.setAttribute('aria-hidden', 'true');
+        chevron.textContent = mount.closest('.action-menu') ? '›' : '▾'; trigger.append(chevron);
+        const menu = document.createElement('div');
+        menu.id = id; menu.className = 'action-menu'; menu.setAttribute('popover', 'auto'); menu.dataset.trigger = trigger.id;
