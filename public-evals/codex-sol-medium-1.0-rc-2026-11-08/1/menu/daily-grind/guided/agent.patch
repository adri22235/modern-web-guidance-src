+            branch('Milk', choose('milk', ['No milk', 'Whole milk', 'Oat milk', 'Almond milk'])),
+            null, { label: 'Extra espresso shot', kind: 'checkbox', checked: () => drink.extra,
+              action: () => { drink.extra = !drink.extra; update(); status.textContent = `${drink.name}: extra shot ${drink.extra ? 'on' : 'off'}.`; } }
