+  <div class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
+  <script>
+    const drinks = [
+      { name: 'Maple Oat Latte', size: 'Regular', milk: 'Oat milk', decaf: false, extraShot: false },
+      { name: 'Dark Roast Espresso', size: 'Regular', milk: 'No milk', decaf: false, extraShot: false },
+      { name: 'Cold Brew', size: 'Regular', milk: 'No milk', decaf: false, extraShot: false }
+    ];
+    const openMenus = [];
+    let rootTrigger;
+    let menuId = 0;
+    let toastTimer;
+    let orderCount = 0;
+    const toast = document.querySelector('.toast');
+    const customizeButtons = [...document.querySelectorAll('.customize-button')];
+    const summary = d => `${d.size} · ${d.milk}${d.decaf ? ' · Decaf' : ''}${d.extraShot ? ' · Extra shot' : ''}`;
+    function updateSummary(i) {
+      document.getElementById(`summary-${i}`).textContent = summary(drinks[i]);
+    }
+    drinks.forEach((_, i) => updateSummary(i));
+
+    function closeFrom(level) {
+      while (openMenus.length > level) {
+        const { panel, trigger } = openMenus.pop();
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.removeAttribute('aria-controls');
+        panel.remove();
+      }
+    }
+    function dismiss(restoreFocus = false) {
+      closeFrom(0);
+      if (restoreFocus) rootTrigger?.focus();
+    }
+    function items(panel) { return [...panel.querySelectorAll('.menu-item')]; }
+    function position(panel, trigger, nested) {
+      const rect = trigger.getBoundingClientRect();
+      const width = panel.offsetWidth;
+      const height = panel.offsetHeight;
+      let left = nested ? rect.right + 5 : rect.left;
+      if (left + width > innerWidth - 8) left = nested ? rect.left - width - 5 : innerWidth - width - 8;
+      let top = nested ? rect.top : rect.bottom + 8;
+      if (!nested && top + height > innerHeight - 8 && rect.top > height + 8) top = rect.top - height - 8;
+      panel.style.left = `${Math.max(8, left)}px`;
+      panel.style.top = `${Math.max(8, Math.min(top, innerHeight - height - 8))}px`;
+    }
+    function openMenu(trigger, entries, label, level = 0, focusLast = false) {
+      closeFrom(level);
+      if (level === 0) rootTrigger = trigger;
+      const panel = document.createElement('div');
+      panel.className = 'action-menu';
+      panel.id = `action-menu-${++menuId}`;
+      panel.setAttribute('role', 'menu');
+      panel.setAttribute('aria-label', label);
+      const heading = document.createElement('div');
+      heading.className = 'menu-heading';
+      heading.textContent = label;
+      heading.setAttribute('role', 'presentation');
+      panel.append(heading);
+      entries.forEach(entry => {
+        if (entry.separator) {
+          const line = document.createElement('div');
+          line.className = 'menu-separator';
+          line.setAttribute('role', 'separator');
+          panel.append(line);
+          return;
+        }
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.className = `menu-item${entry.primary ? ' menu-primary' : ''}`;
+        button.tabIndex = -1;
+        button.setAttribute('role', entry.role || 'menuitem');
+        if (entry.role) button.setAttribute('aria-checked', String(entry.checked()));
+        if (entry.children) {
+          button.setAttribute('aria-haspopup', 'menu');
+          button.setAttribute('aria-expanded', 'false');
+        }
+        const mark = document.createElement('span');
+        mark.className = 'menu-mark';
+        mark.setAttribute('aria-hidden', 'true');
+        mark.textContent = entry.role && entry.checked() ? (entry.role === 'menuitemradio' ? '●' : '✓') : '';
+        const name = document.createElement('span');
+        name.textContent = entry.label;
+        const trailing = document.createElement('span');
+        trailing.className = 'menu-trailing';
+        trailing.setAttribute('aria-hidden', 'true');
+        trailing.textContent = entry.children ? '›' : (entry.hint || '');
+        button.append(mark, name, trailing);
+        const expand = () => openMenu(button, entry.children(), entry.label, level + 1);
+        button.addEventListener('click', () => {
+          if (entry.children) { expand(); return; }
+          closeFrom(level + 1);
+          entry.action();
+          if (entry.role) {
+            entries.forEach((option, index) => {
+              if (!option.role) return;
+              const sibling = panel.children[index + 1];
+              sibling.setAttribute('aria-checked', String(option.checked()));
+              sibling.querySelector('.menu-mark').textContent = option.checked() ? (option.role === 'menuitemradio' ? '●' : '✓') : '';
+            });
+          } else if (!entry.keepOpen) dismiss(true);
+        });
+        button.addEventListener('keydown', event => {
+          if (event.key === 'ArrowRight' && entry.children) { event.preventDefault(); expand(); }
+        });
+        button.addEventListener('focus', () => {
+          if (openMenus[level + 1]?.trigger !== button) closeFrom(level + 1);
+        });
+        panel.append(button);
+      });
+      panel.addEventListener('keydown', event => {
+        const list = items(panel);
+        const current = list.indexOf(document.activeElement);
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? list.length - 1 : (current + (event.key === 'ArrowDown' ? 1 : -1) + list.length) % list.length;
+          list[next].focus();
+        } else if (event.key === 'Escape' || (event.key === 'ArrowLeft' && level > 0)) {
+          event.preventDefault();
+          event.stopPropagation();
+          closeFrom(level);
+          trigger.focus();
+        } else if (event.key === 'Tab') {
+          // Put focus back in the document's natural tab order before closing.
+          rootTrigger.focus();
+          dismiss();
+        } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && event.key !== ' ') {
+          const ordered = [...list.slice(current + 1), ...list.slice(0, current + 1)];
+          ordered.find(item => item.children[1].textContent.toLowerCase().startsWith(event.key.toLowerCase()))?.focus();
+        }
+      });
+      document.body.append(panel);
+      trigger.setAttribute('aria-expanded', 'true');
+      trigger.setAttribute('aria-controls', panel.id);
+      openMenus.push({ panel, trigger });
+      position(panel, trigger, level > 0);
+      const list = items(panel);
+      list[focusLast ? list.length - 1 : 0]?.focus();
+    }
+    function customization(i) {
+      const drink = drinks[i];
+      const choices = (key, values) => values.map(value => ({
+        label: value, role: 'menuitemradio', checked: () => drink[key] === value,
+        action: () => { drink[key] = value; updateSummary(i); }
+      }));
+      const toggle = (key, label) => ({ label, role: 'menuitemcheckbox', checked: () => drink[key], action: () => { drink[key] = !drink[key]; updateSummary(i); } });
+      return [
+        { label: 'Size', children: () => choices('size', ['Small', 'Regular', 'Large']) },
+        { label: 'Milk', children: () => choices('milk', ['No milk', 'Whole milk', 'Oat milk', 'Almond milk']) },
+        { label: 'Extras', children: () => [toggle('decaf', 'Decaf'), toggle('extraShot', 'Extra espresso shot')] },
+        { separator: true },
+        { label: 'Add to order', primary: true, hint: '+', action: () => {
+          orderCount++;
+          toast.textContent = `${drink.name} added to your order. ${summary(drink)}. Items in order: ${orderCount}.`;
+          clearTimeout(toastTimer);
+          toastTimer = setTimeout(() => { toast.textContent = ''; }, 6500);
+        } }
+      ];
+    }
+    function bindTrigger(button, getEntries, label) {
+      button.addEventListener('click', () => {
+        if (button.getAttribute('aria-expanded') === 'true') dismiss();
+        else openMenu(button, getEntries(), label);
+      });
+      button.addEventListener('keydown', event => {
+        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+          event.preventDefault();
+          openMenu(button, getEntries(), label, 0, event.key === 'ArrowUp');
+        }
+      });
+    }
+    customizeButtons.forEach((button, i) => bindTrigger(button, () => customization(i), drinks[i].name));
+    const drinkEntry = i => ({ label: drinks[i].name, keepOpen: true, action: () => {
+      dismiss();
+      document.getElementById(`drink-${i}`).scrollIntoView({ block: 'center' });
+      openMenu(customizeButtons[i], customization(i), drinks[i].name);
+    } });
+    bindTrigger(document.getElementById('browse-menu'), () => [
+      { label: 'Drink categories', children: () => [
+        { label: 'Coffee', children: () => [
+          { label: 'Espresso', children: () => [drinkEntry(1)] },
+          { label: 'Iced coffee', children: () => [drinkEntry(2)] }
+        ] },
+        { label: 'Seasonal drinks', children: () => [drinkEntry(0)] }
+      ] },
+      { separator: true },
+      { label: 'Explore seasonal favorites', action: () => document.getElementById('seasonal').scrollIntoView() }
+    ], 'Our menu');
+    document.addEventListener('pointerdown', event => {
+      if (!event.target.closest('.action-menu, [aria-haspopup="menu"]')) dismiss();
+    });
+    document.addEventListener('focusin', event => {
+      if (openMenus.length && !event.target.closest('.action-menu, [aria-haspopup="menu"]')) dismiss();
+    });
+    window.addEventListener('resize', () => dismiss());
+    window.addEventListener('scroll', () => {
+      openMenus.forEach(({ panel, trigger }, level) => position(panel, trigger, level > 0));
+    }, { passive: true });
+  </script>
 </body>
 
