+    /* Loyalty Rewards */
+    .rewards {
+      margin-top: 40px;
+      padding: 30px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 30px;
+    }
+
+    .rewards-copy {
+      max-width: 540px;
+    }
+
+    .rewards-eyebrow {
+      color: var(--primary);
+      font-size: 0.8rem;
+      font-weight: bold;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+      margin-bottom: 5px;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .reward-ring {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex: 0 0 200px;
+      width: 200px;
+      height: 200px;
+    }
+
+    .reward-ring progress {
+      --thickness: 14px;
+      appearance: none;
+      display: block;
+      width: 100%;
+      height: 100%;
+      border-radius: 50%;
+      border: var(--thickness) solid transparent;
+      background: conic-gradient(var(--accent) var(--progress), var(--secondary) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+    }
+
+    .reward-ring progress::-webkit-progress-bar,
+    .reward-ring progress::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    .reward-ring progress::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    @supports not (background-clip: border-area) {
+      .reward-ring progress {
+        border: 0;
+        mask-image: radial-gradient(circle closest-side,
+          transparent calc(100% - var(--thickness) - 0.5px),
+          black calc(100% - var(--thickness)));
+      }
+    }
+
+    .reward-ring-content {
+      position: absolute;
+      text-align: center;
+      color: var(--primary);
+    }
+
+    .reward-ring-content strong {
+      display: block;
+      font-size: 2.5rem;
+      line-height: 1.2;
+    }
+
+    .reward-ring-content span {
+      display: block;
+      font-size: 0.85rem;
+    }
+
+    .reward-ring-content .reward-remaining {
+      font-weight: bold;
+      margin-top: 8px;
+    }
+
+    @media (max-width: 600px) {
+      .rewards {
+        flex-direction: column;
+        padding: 24px 20px;
+        text-align: center;
+      }
+    }
+
