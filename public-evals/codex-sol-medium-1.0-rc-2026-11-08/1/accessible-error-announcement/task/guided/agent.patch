+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterError = document.getElementById('newsletter-email-error');
+    const newsletterAnnouncement = document.getElementById('newsletter-error-announcement');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    function syncNewsletterError() {
+      // Use the same condition as CSS, never the pristine field's raw validity.
+      const showError = newsletterEmail.matches(':user-invalid');
+      if (showError) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+        newsletterEmail.setAttribute('aria-describedby', 'newsletter-email-hint newsletter-email-error');
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+        newsletterEmail.setAttribute('aria-describedby', 'newsletter-email-hint');
+      }
+
+      // Keep the live region mounted and only mutate text on a state change.
+      const announcement = showError ? newsletterError.textContent : '';
+      if (newsletterAnnouncement.textContent !== announcement) {
+        newsletterAnnouncement.textContent = announcement;
+      }
+    }
+
+    for (const eventName of ['focus', 'blur', 'input', 'change', 'invalid']) {
+      newsletterEmail.addEventListener(eventName, () => {
+        syncNewsletterError();
+        // Native interaction flags can update after the event's default action.
+        requestAnimationFrame(syncNewsletterError);
+      });
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('reset', () => {
+      newsletterEmail.removeAttribute('aria-invalid');
+      newsletterEmail.setAttribute('aria-describedby', 'newsletter-email-hint');
+      newsletterAnnouncement.textContent = '';
+      newsletterStatus.textContent = '';
+      requestAnimationFrame(syncNewsletterError);
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      syncNewsletterError();
+      // This static site does not yet have a newsletter subscription endpoint.
+      newsletterStatus.textContent = 'Newsletter signup is currently unavailable. Please try again later.';
+    });
+  </script>
+
 </body>
 
