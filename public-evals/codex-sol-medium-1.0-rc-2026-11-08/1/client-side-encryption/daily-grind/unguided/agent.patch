+import { createRecipient, sealNote, openNote, modes } from './crypto.js';
+
+const $ = (selector) => document.querySelector(selector);
+const noteInput = $('#note');
+const status = $('#status');
+let db;
+let notes = [];
+let busy = false;
+const revealed = new Map();
+
+function report(message, error = false) {
+  status.textContent = message;
+  status.classList.toggle('error', error);
+}
+
+function connect() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-private-notes', 1);
+    request.onupgradeneeded = () => {
+      request.result.createObjectStore('notes', { keyPath: 'id' });
+      request.result.createObjectStore('keys', { keyPath: 'keyId' });
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Close other Daily Grind tabs and try again.'));
+  });
+}
+
+function allNotes() {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction('notes', 'readonly');
+    const request = transaction.objectStore('notes').getAll();
+    transaction.oncomplete = () => resolve(request.result.sort((a, b) => b.createdAt.localeCompare(a.createdAt)));
+    transaction.onerror = () => reject(transaction.error);
+  });
+}
+
+function getKey(keyId) {
+  return new Promise((resolve, reject) => {
+    const request = db.transaction('keys', 'readonly').objectStore('keys').get(keyId);
+    request.onsuccess = () => request.result ? resolve(request.result) : reject(new Error('The recovery key is missing from this browser.'));
+    request.onerror = () => reject(request.error);
+  });
+}
+
+function persist(envelope, recipient) {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction(['notes', 'keys'], 'readwrite');
+    transaction.objectStore('keys').put(recipient);
+    transaction.objectStore('notes').put(envelope);
+    transaction.oncomplete = resolve;
+    transaction.onerror = () => reject(transaction.error);
+    transaction.onabort = () => reject(transaction.error || new Error('Saving was interrupted.'));
+  });
+}
+
+function removeNote(envelope) {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction(['notes', 'keys'], 'readwrite');
+    transaction.objectStore('notes').delete(envelope.id);
+    transaction.objectStore('keys').delete(envelope.keyId);
+    transaction.oncomplete = resolve;
+    transaction.onerror = () => reject(transaction.error);
+    transaction.onabort = () => reject(transaction.error || new Error('Removing the note was interrupted.'));
+  });
+}
+
+function switchTab(saved) {
+  $('#compose-tab').classList.toggle('active', !saved);
+  $('#saved-tab').classList.toggle('active', saved);
+  $('#compose-tab').setAttribute('aria-selected', String(!saved));
+  $('#saved-tab').setAttribute('aria-selected', String(saved));
+  $('#compose-tab').tabIndex = saved ? -1 : 0;
+  $('#saved-tab').tabIndex = saved ? 0 : -1;
+  $('#compose-panel').hidden = saved;
+  $('#saved-panel').hidden = !saved;
+  if (!saved) hideRevealed();
+}
+$('#compose-tab').addEventListener('click', () => switchTab(false));
+$('#saved-tab').addEventListener('click', () => switchTab(true));
+$('.tabs').addEventListener('keydown', (event) => {
+  if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+  event.preventDefault();
+  const saved = event.key === 'End' || (event.key !== 'Home' && $('#saved-panel').hidden);
+  switchTab(saved);
+  $(saved ? '#saved-tab' : '#compose-tab').focus();
+});
+
+noteInput.addEventListener('input', () => {
+  $('#char-count').textContent = `${noteInput.value.length.toLocaleString()} / 1,000`;
+  noteInput.setCustomValidity('');
+  report('');
+});
+document.querySelectorAll('[data-snippet]').forEach((button) => {
+  button.addEventListener('click', () => {
+    if (busy) return;
+    const addition = `${noteInput.value && !/\s$/.test(noteInput.value) ? ' ' : ''}${button.dataset.snippet}`;
+    if (noteInput.value.length + addition.length > 1000) {
+      report('This suggestion would exceed the 1,000 character limit.', true);
+      return;
+    }
+    noteInput.value += addition;
+    noteInput.dispatchEvent(new Event('input'));
+    noteInput.focus();
+  });
+});
+document.querySelectorAll('[name=protection]').forEach((input) => {
+  input.addEventListener('change', () => {
+    document.querySelectorAll('.protection-card').forEach((card) => card.classList.toggle('selected', card.querySelector('input').checked));
+  });
+});
+
+$('#compose-panel').addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (busy || !db) return;
+  if (!noteInput.value.trim()) {
+    noteInput.setCustomValidity('Please add your delivery instructions.');
+    noteInput.reportValidity();
+    return;
+  }
+  busy = true;
+  const button = $('#save-button');
+  button.disabled = true;
+  noteInput.readOnly = true;
+  button.setAttribute('aria-busy', 'true');
+  report('Establishing a shared secret and encrypting your note…');
+  let recipient;
+  try {
+    recipient = await createRecipient($('[name=protection]:checked').value);
+    const envelope = await sealNote(noteInput.value, recipient);
+    await persist(envelope, recipient);
+    noteInput.value = '';
+    $('#char-count').textContent = '0 / 1,000';
+    notes = await allNotes();
+    renderNotes();
+    report('Your note was encrypted and saved on this device.');
+    switchTab(true);
+    $('#saved-tab').focus();
+  } catch (error) {
+    report(`Your note could not be saved. ${error.name === 'QuotaExceededError' ? 'This browser’s storage is full.' : 'Check that browser storage is enabled and try again.'}`, true);
+  } finally {
+    recipient?.secretKey.fill(0);
+    button.disabled = false;
+    noteInput.readOnly = false;
+    button.removeAttribute('aria-busy');
+    busy = false;
+  }
+});
+
+function make(tag, className, text) {
+  const element = document.createElement(tag);
+  if (className) element.className = className;
+  if (text !== undefined) element.textContent = text;
+  return element;
+}
+
+function hideRevealed() {
+  revealed.forEach(({ timer, content, button, ciphertext }) => {
+    clearTimeout(timer);
+    content.textContent = ciphertext;
+    content.classList.remove('revealed');
+    button.textContent = 'Reveal note';
+    button.setAttribute('aria-pressed', 'false');
+  });
+  revealed.clear();
+}
+
+document.addEventListener('visibilitychange', () => { if (document.hidden) hideRevealed(); });
+
+function renderNotes() {
+  hideRevealed();
+  $('#note-count').textContent = notes.length;
+  const list = $('#saved-list');
+  list.replaceChildren();
+  if (!notes.length) {
+    const empty = make('div', 'empty-state');
+    empty.append(make('p', '', 'A little space for your delivery details.'), make('p', '', 'Create your first note and it will appear here, encrypted.'));
+    list.append(empty);
+    return;
+  }
+  notes.forEach((envelope) => {
+    const card = make('article', 'saved-note');
+    const title = make('div', 'saved-note-header', `${modes[envelope.mode]?.name || 'Protected'} delivery note`);
+    const date = make('small', '', `${new Date(envelope.createdAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' })} · Saved on this device`);
+    const ciphertext = `${envelope.ciphertext.slice(0, 140)}${envelope.ciphertext.length > 140 ? '…' : ''}`;
+    const content = make('div', 'sealed-content', ciphertext);
+    const actions = make('div', 'note-actions');
+    const reveal = make('button', '', 'Reveal note');
+    reveal.type = 'button';
+    reveal.setAttribute('aria-pressed', 'false');
+    const feedback = make('small', 'note-feedback');
+    feedback.setAttribute('role', 'status');
+    reveal.addEventListener('click', async () => {
+      if (revealed.has(envelope.id)) { hideRevealed(); return; }
+      reveal.disabled = true;
+      let recipient;
+      try {
+        recipient = await getKey(envelope.keyId);
+        const plaintext = await openNote(envelope, recipient);
+        // Do not reveal after switching tabs or putting the page in the background.
+        if (document.hidden || $('#saved-panel').hidden || !content.isConnected) return;
+        hideRevealed();
+        content.textContent = plaintext;
+        content.classList.add('revealed');
+        reveal.textContent = 'Hide note';
+        reveal.setAttribute('aria-pressed', 'true');
+        revealed.set(envelope.id, { content, button: reveal, ciphertext, timer: setTimeout(hideRevealed, 30000) });
+        feedback.textContent = 'Authenticated and decrypted. Hides automatically in 30 seconds.';
+      } catch {
+        feedback.textContent = 'Unable to authenticate this note. Its data may have changed or the recovery key is unavailable.';
+      } finally {
+        recipient?.secretKey.fill(0);
+        reveal.disabled = false;
+      }
+    });
+    const download = make('button', '', 'Download encrypted');
+    download.type = 'button';
+    download.addEventListener('click', () => {
+      const blob = new Blob([JSON.stringify(envelope, null, 2)], { type: 'application/json' });
+      const url = URL.createObjectURL(blob);
+      const anchor = make('a');
+      anchor.href = url;
+      anchor.download = `daily-grind-note-${envelope.id}.json`;
+      document.body.append(anchor);
+      anchor.click();
+      anchor.remove();
+      setTimeout(() => URL.revokeObjectURL(url), 1000);
+      feedback.textContent = 'Encrypted envelope downloaded. Its recovery key remains in this browser.';
+    });
+    const remove = make('button', 'delete-note', 'Delete');
+    remove.type = 'button';
+    remove.addEventListener('click', async () => {
+      remove.disabled = true;
+      try {
+        await removeNote(envelope);
+        notes = await allNotes();
+        renderNotes();
+      } catch {
+        feedback.textContent = 'This note could not be deleted. Please try again.';
+        remove.disabled = false;
+      }
+    });
+    actions.append(reveal, download, remove);
+    card.append(title, date, content, actions, feedback);
+    list.append(card);
+  });
+}
+
+const dialog = $('#protection-dialog');
+$('#learn-button').addEventListener('click', () => dialog.showModal());
+$('#privacy-button').addEventListener('click', () => dialog.showModal());
+$('#close-dialog').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', (event) => { if (event.target === dialog) {
+  const rect = dialog.getBoundingClientRect();
+  if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
+} });
+
+async function initialize() {
+  $('#save-button').disabled = true;
+  try {
+    if (!window.isSecureContext || !crypto.subtle || !window.indexedDB) throw new Error('Unsupported browser context');
+    db = await connect();
+    db.onversionchange = () => { db.close(); db = null; $('#save-button').disabled = true; report('Storage changed in another tab. Reload this page to continue.', true); };
+    notes = await allNotes();
+    renderNotes();
+    $('#save-button').disabled = false;
+  } catch {
+    report('Private notes need a secure HTTPS connection (or localhost) and browser storage. Saving is unavailable in this browser context.', true);
+    $('#saved-list').textContent = 'Browser storage is unavailable. Your saved notes could not be loaded.';
+  }
+}
+initialize();
