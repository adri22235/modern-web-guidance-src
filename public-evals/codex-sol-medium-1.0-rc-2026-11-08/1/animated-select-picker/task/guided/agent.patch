+    .store-selector {
+      width: min(100%, 320px);
+      margin-top: 1.5rem;
+      text-align: left;
+    }
+
+    .store-selector label {
+      display: block;
+      margin-bottom: 0.4rem;
+      font-size: 0.9rem;
+      font-weight: 600;
+    }
+
+    .store-select {
+      width: 100%;
+      min-height: 48px;
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      color: var(--text);
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    /* Enhance the native picker where customizable selects are supported. */
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: transform 240ms ease;
+      }
+
+      .store-select:open::picker-icon {
+        transform: rotate(180deg);
+      }
+
+      .store-select::picker(select) {
+        width: anchor-size(width);
+        margin-top: 0.5rem;
+        padding: 0.35rem;
+        border: 1px solid var(--secondary);
+        border-radius: 8px;
+        background: var(--light);
+        color: var(--text);
+        box-shadow: 0 12px 28px rgb(0 0 0 / 20%);
+        opacity: 0;
+        transition: opacity 240ms ease, display 240ms, overlay 240ms;
+        transition-behavior: allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+        }
+      }
+
+      .store-select option {
+        padding: 0.65rem 0.75rem;
+        border-radius: 4px;
+      }
+
+      .store-select option:checked {
+        background: var(--secondary);
+        color: var(--text);
+        font-weight: 700;
+      }
+
+      .store-select option:not(:disabled):hover,
+      .store-select option:focus-visible {
+        background: var(--primary);
+        color: white;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
