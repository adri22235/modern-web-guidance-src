+  <script>
+    document.querySelectorAll('.product-card').forEach((card) => {
+      const updatePointer = (event) => {
+        const bounds = card.getBoundingClientRect();
+        card.style.setProperty('--mouse-x', `${event.clientX - bounds.left}px`);
+        card.style.setProperty('--mouse-y', `${event.clientY - bounds.top}px`);
+      };
+
+      card.classList.add('spotlight-ready');
+      card.addEventListener('pointerenter', (event) => {
+        if (event.pointerType === 'touch') return;
+        updatePointer(event);
+        card.classList.add('spotlight-active');
+      });
+      card.addEventListener('pointermove', updatePointer);
+      const hideSpotlight = () => card.classList.remove('spotlight-active');
+      card.addEventListener('pointerleave', hideSpotlight);
+      card.addEventListener('pointercancel', hideSpotlight);
+    });
+  </script>
+
