       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    @property --inner-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: '<length>';
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      isolation: isolate;
+      padding-bottom: 110px;
+      transition: --inner-size 250ms ease, --outer-size 250ms ease;
+    }
+
+    .product-spotlight {
+      position: absolute;
+      inset: 0;
+      display: flex;
+      align-items: flex-end;
+      padding: 20px;
+      border-radius: inherit;
+      pointer-events: none;
+    }
+
+    .product-spotlight p {
+      width: 100%;
+      padding-top: 12px;
+      border-top: 1px solid var(--secondary);
+      font-size: 0.9rem;
+    }
+
+    /* Mask only the extra details; the original content stays untouched.
+       Without scripting or on touch devices, the details remain visible. */
+    @media (hover: hover) and (pointer: fine) {
+      .product-card.spotlight-ready .product-spotlight {
+        -webkit-mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+        mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          #000 var(--inner-size), transparent var(--outer-size));
+      }
+
+      .product-card.spotlight-active {
+        --inner-size: 100px;
+        --outer-size: 180px;
+      }
+
+      .product-card.spotlight-ready:focus-within .product-spotlight {
+        -webkit-mask-image: none;
+        mask-image: none;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition: none;
+      }
+    }
+
