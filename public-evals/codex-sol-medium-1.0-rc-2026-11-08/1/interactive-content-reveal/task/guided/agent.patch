+  <script>
+    document.querySelectorAll('.product-card').forEach((card) => {
+      const spotlight = document.createElement('div');
+      spotlight.className = 'product-spotlight';
+      spotlight.setAttribute('aria-hidden', 'true');
+      spotlight.append(card.querySelector('.product-notes').cloneNode(true));
+      card.append(spotlight);
+
+      const updateSpotlight = (event) => {
+        if (event.pointerType === 'touch') return;
+
+        // Read current bounds so scrolling and layout changes cannot offset the circle.
+        const rect = card.getBoundingClientRect();
+        card.style.setProperty('--mouse-x', `${event.clientX - rect.left}px`);
+        card.style.setProperty('--mouse-y', `${event.clientY - rect.top}px`);
+        card.setAttribute('data-spotlight', '');
+      };
+
+      const hideSpotlight = () => card.removeAttribute('data-spotlight');
+      card.addEventListener('pointerenter', updateSpotlight);
+      card.addEventListener('pointermove', updateSpotlight);
+      card.addEventListener('pointerleave', hideSpotlight);
+      card.addEventListener('pointercancel', hideSpotlight);
+      window.addEventListener('blur', hideSpotlight);
+    });
+  </script>
+
 </body>
 
