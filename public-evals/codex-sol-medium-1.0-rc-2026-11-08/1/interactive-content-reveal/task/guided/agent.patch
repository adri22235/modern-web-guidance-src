+    /* The mask belongs only to a decorative copy, never the readable card. */
+    .product-spotlight {
+      display: none;
+      position: absolute;
+      inset: 0;
+      border-radius: inherit;
+      pointer-events: none;
+      -webkit-mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), #000 var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), #000 var(--inner-size, 0px), transparent var(--outer-size, 0px));
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+      box-shadow: inset 0 0 0 2px var(--accent);
+      transition: --inner-size 220ms ease-out, --outer-size 220ms ease-out;
+    }
+
+    .product-spotlight .product-notes {
+      position: absolute;
+      bottom: 20px;
+      left: 20px;
+      right: 20px;
+      margin: 0;
+      padding-top: 0;
+      color: var(--primary);
+      background: #fff0d9;
+      border-radius: 4px;
+    }
+
+    @supports (mask-image: radial-gradient(circle, #000, transparent)) or (-webkit-mask-image: radial-gradient(circle, #000, transparent)) {
+      @media (any-hover: hover) and (any-pointer: fine) {
+        .product-spotlight {
+          display: block;
+        }
+
+        .product-card[data-spotlight] {
