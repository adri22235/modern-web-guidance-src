+  <aside class="quick-order" data-draggable aria-labelledby="quick-order-title">
+    <div class="order-handle" data-drag-handle tabindex="0" role="button"
+      aria-label="Move quick order panel. Drag or use arrow keys; hold Shift for larger steps.">
+      <span class="order-grip" aria-hidden="true">⠿</span>
+      <div>
+        <h2 id="quick-order-title">Your daily pick-me-up</h2>
+        <p>QUICK ORDER · DRAG TO MOVE</p>
+      </div>
+    </div>
+    <form class="order-body" id="quick-order-form">
+      <p class="order-intro">A little coffee, a better day.</p>
+      <label class="order-label" for="order-coffee">Choose your coffee</label>
+      <select id="order-coffee" name="coffee">
+        <option value="maple">Maple Oat Latte · $5.50</option>
+        <option value="espresso">Dark Roast Espresso · $3.50</option>
+        <option value="cold-brew">Cold Brew · $4.50</option>
+      </select>
+      <fieldset>
+        <legend>Size</legend>
+        <div class="order-sizes">
+          <label class="order-size"><input type="radio" name="size" value="0" checked><span>Regular</span></label>
+          <label class="order-size"><input type="radio" name="size" value="100"><span>Large +$1</span></label>
+        </div>
+      </fieldset>
+      <div class="order-quantity">
+        <span class="order-label" id="quantity-label">Quantity</span>
+        <div class="order-stepper" role="group" aria-labelledby="quantity-label">
+          <button type="button" id="order-minus" aria-label="Decrease quantity" disabled>−</button>
+          <output id="order-quantity" aria-live="polite">1</output>
+          <button type="button" id="order-plus" aria-label="Increase quantity">+</button>
+        </div>
+      </div>
+      <button class="order-add" type="submit">Add to cart · <span id="order-price">$5.50</span></button>
+      <div class="order-cart">
+        <div class="order-cart-row">
+          <strong id="cart-summary">Your cart is empty</strong>
+          <button class="order-clear" id="order-clear" type="button" hidden>Clear</button>
+        </div>
+        <p class="order-status" id="order-status" role="status">Build your coffee cart here.</p>
+      </div>
+    </form>
+  </aside>
+
+  <script>
+    (() => {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel.querySelector('[data-drag-handle]');
+      let drag = null;
+      const place = (x, y) => {
+        const maxX = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxY = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.left = `${Math.min(maxX, Math.max(0, x))}px`;
+        panel.style.top = `${Math.min(maxY, Math.max(0, y))}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      };
+      handle.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0) return;
+        const rect = panel.getBoundingClientRect();
+        drag = { id: event.pointerId, x: event.clientX - rect.left, y: event.clientY - rect.top };
+        handle.setPointerCapture(event.pointerId);
+        panel.classList.add('is-dragging');
+      });
+      handle.addEventListener('pointermove', (event) => {
+        if (!drag || drag.id !== event.pointerId) return;
+        place(event.clientX - drag.x, event.clientY - drag.y);
+      });
+      const finishDrag = () => {
+        drag = null;
+        panel.classList.remove('is-dragging');
+      };
+      handle.addEventListener('pointerup', finishDrag);
+      handle.addEventListener('pointercancel', finishDrag);
+      handle.addEventListener('lostpointercapture', finishDrag);
+      handle.addEventListener('keydown', (event) => {
+        const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+        const direction = directions[event.key];
+        if (!direction) return;
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        const step = event.shiftKey ? 40 : 10;
+        place(rect.left + direction[0] * step, rect.top + direction[1] * step);
+      });
+      window.addEventListener('resize', () => {
+        const rect = panel.getBoundingClientRect();
+        place(rect.left, rect.top);
+      });
+
+      const form = document.getElementById('quick-order-form');
+      const coffee = document.getElementById('order-coffee');
+      const minus = document.getElementById('order-minus');
+      const plus = document.getElementById('order-plus');
+      const clear = document.getElementById('order-clear');
+      const status = document.getElementById('order-status');
+      const prices = { maple: 550, espresso: 350, 'cold-brew': 450 };
+      const money = (cents) => `$${(cents / 100).toFixed(2)}`;
+      let quantity = 1;
+      let cartCount = 0;
+      let cartTotal = 0;
+      const total = () => (prices[coffee.value] + Number(form.elements.size.value)) * quantity;
+      const update = () => {
+        document.getElementById('order-quantity').value = quantity;
+        document.getElementById('order-price').textContent = money(total());
+        minus.disabled = quantity === 1;
+        plus.disabled = quantity === 10;
+      };
+      minus.addEventListener('click', () => { quantity = Math.max(1, quantity - 1); update(); });
+      plus.addEventListener('click', () => { quantity = Math.min(10, quantity + 1); update(); });
+      form.addEventListener('change', update);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        cartCount += quantity;
+        cartTotal += total();
+        document.getElementById('cart-summary').textContent = `${cartCount} ${cartCount === 1 ? 'coffee' : 'coffees'} · ${money(cartTotal)}`;
+        const name = coffee.selectedOptions[0].textContent.split(' · ')[0];
+        const size = form.elements.size.value === '0' ? 'regular' : 'large';
+        status.textContent = `Added ${quantity} ${size} ${name}. Cart saved for this visit; no order placed.`;
+        clear.hidden = false;
+      });
+      clear.addEventListener('click', () => {
+        cartCount = 0;
+        cartTotal = 0;
+        document.getElementById('cart-summary').textContent = 'Your cart is empty';
+        status.textContent = 'Cart cleared. Ready for a fresh start.';
+        clear.hidden = true;
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
