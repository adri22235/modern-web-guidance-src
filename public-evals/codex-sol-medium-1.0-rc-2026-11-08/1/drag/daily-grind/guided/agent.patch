+  <aside class="coffee-cart" data-draggable aria-labelledby="cart-title">
+    <header class="cart-header" data-drag-handle>
+      <span class="cart-grip" aria-hidden="true">⠿</span>
+      <div>
+        <h2 id="cart-title">Your coffee, your way</h2>
+        <p class="cart-drag-hint" id="cart-drag-hint">Drag to move · or use arrow keys</p>
+      </div>
+      <button class="cart-toggle" type="button" aria-label="Minimize coffee cart" aria-expanded="true" aria-controls="cart-body" hidden>−</button>
+    </header>
+    <form class="cart-body" id="cart-body" action="/order-online" method="get">
+      <p class="cart-intro">A little pick-me-up, just a few clicks away.</p>
+      <label for="cart-drink">Choose your coffee</label>
+      <select id="cart-drink" name="coffee">
+        <option value="maple-oat-latte" data-price="550">Maple Oat Latte — $5.50</option>
+        <option value="dark-roast-espresso" data-price="350">Dark Roast Espresso — $3.50</option>
+        <option value="cold-brew" data-price="450">Cold Brew — $4.50</option>
+      </select>
+      <div class="cart-options">
+        <div>
+          <label for="cart-size">Size</label>
+          <select id="cart-size" name="size">
+            <option value="regular" data-price="0">Regular</option>
+            <option value="large" data-price="100">Large (+$1)</option>
+          </select>
+        </div>
+        <div>
+          <label for="cart-quantity">Quantity</label>
+          <div class="cart-quantity">
+            <button type="button" data-step="-1" aria-label="Decrease quantity" hidden>−</button>
+            <input id="cart-quantity" name="quantity" type="number" min="1" max="20" value="1" required>
+            <button type="button" data-step="1" aria-label="Increase quantity" hidden>+</button>
+          </div>
+        </div>
+      </div>
+      <div class="cart-summary" hidden>
+        <span>Subtotal</span>
+        <strong id="cart-total" role="status" aria-atomic="true">$5.50</strong>
+      </div>
+      <button class="cart-checkout" type="submit">Continue to order <span aria-hidden="true">→</span></button>
+      <p class="cart-note">Review your order before checkout.</p>
+    </form>
+  </aside>
+
+  <script>
+    (() => {
+      const cart = document.querySelector('[data-draggable]');
+      const handle = cart.querySelector('[data-drag-handle]');
+      const toggle = cart.querySelector('.cart-toggle');
+      const form = cart.querySelector('form');
+      const drink = form.elements.coffee;
+      const size = form.elements.size;
+      const quantity = form.elements.quantity;
+      const steps = [...cart.querySelectorAll('[data-step]')];
+      const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      function updateTotal() {
+        const count = quantity.valueAsNumber;
+        const valid = quantity.validity.valid && Number.isFinite(count);
+        const price = Number(drink.selectedOptions[0].dataset.price) + Number(size.selectedOptions[0].dataset.price);
+        cart.querySelector('#cart-total').textContent = valid ? currency.format(price * count / 100) : '—';
+        steps[0].disabled = valid && count <= 1;
+        steps[1].disabled = valid && count >= 20;
+      }
+
+      steps.forEach(button => {
+        button.hidden = false;
+        button.addEventListener('click', () => {
+          const current = Number.isFinite(quantity.valueAsNumber) ? quantity.valueAsNumber : 1;
+          quantity.value = Math.max(1, Math.min(20, Math.round(current) + Number(button.dataset.step)));
+          updateTotal();
+        });
+      });
+      form.addEventListener('input', updateTotal);
+      form.addEventListener('change', updateTotal);
+      cart.querySelector('.cart-summary').hidden = false;
+      updateTotal();
+
+      // Both pointer and keyboard movement use viewport-relative coordinates.
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - cart.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - cart.offsetHeight);
+        cart.style.right = 'auto';
+        cart.style.bottom = 'auto';
+        cart.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        cart.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      function keepInView() {
+        const rect = cart.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      let drag = null;
+      handle.addEventListener('pointerdown', event => {
+        if (event.button !== 0 || !event.isPrimary || drag || event.target.closest('button, input, select, a')) return;
+        const rect = cart.getBoundingClientRect();
+        drag = { id: event.pointerId, x: event.clientX - rect.left, y: event.clientY - rect.top };
+        handle.setPointerCapture(event.pointerId);
+        handle.classList.add('is-dragging');
+        handle.focus({ preventScroll: true });
+      });
+      handle.addEventListener('pointermove', event => {
+        if (!drag || drag.id !== event.pointerId) return;
+        moveTo(event.clientX - drag.x, event.clientY - drag.y);
+      });
+      function stopDrag(event) {
+        if (!drag || drag.id !== event.pointerId) return;
+        drag = null;
+        handle.classList.remove('is-dragging');
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+      }
+      handle.addEventListener('pointerup', stopDrag);
+      handle.addEventListener('pointercancel', stopDrag);
+      handle.addEventListener('lostpointercapture', stopDrag);
+      handle.addEventListener('keydown', event => {
+        if (event.target !== handle) return;
+        const directions = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+        const direction = directions[event.key];
+        if (!direction) return;
+        event.preventDefault();
+        const rect = cart.getBoundingClientRect();
+        const step = event.shiftKey ? 40 : 15;
+        moveTo(rect.left + direction[0] * step, rect.top + direction[1] * step);
+      });
+
+      toggle.hidden = false;
+      toggle.addEventListener('click', () => {
+        form.hidden = !form.hidden;
+        toggle.setAttribute('aria-expanded', String(!form.hidden));
+        toggle.setAttribute('aria-label', form.hidden ? 'Expand coffee cart' : 'Minimize coffee cart');
+        toggle.textContent = form.hidden ? '+' : '−';
+        keepInView();
+      });
+
+      handle.tabIndex = 0;
+      handle.setAttribute('role', 'group');
+      handle.setAttribute('aria-labelledby', 'cart-title');
+      handle.setAttribute('aria-describedby', 'cart-drag-hint');
+      cart.classList.add('is-ready');
+      window.addEventListener('resize', keepInView);
+      new ResizeObserver(keepInView).observe(cart);
+    })();
+  </script>
+
 </body>
 
