+  <script>
+    // Older browsers need measured widths and scrollHeight in place of field-sizing.
+    if (!CSS.supports('field-sizing', 'content')) {
+      const fields = document.querySelectorAll('.content-sized');
+      const context = document.createElement('canvas').getContext('2d');
+
+      function fitField(field) {
+        const style = getComputedStyle(field);
+        context.font = style.font;
+        const content = field instanceof HTMLSelectElement
+          ? field.selectedOptions[0].textContent
+          : field.value || field.placeholder || ' ';
+        const textWidth = Math.max(...content.split('\n').map(line =>
+          context.measureText(line || ' ').width));
+        const chromeWidth = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+          + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+        // Leave room for the native select arrow or the text caret.
+        field.style.width = Math.ceil(textWidth + chromeWidth
+          + (field instanceof HTMLSelectElement ? 28 : 2)) + 'px';
+
+        if (field instanceof HTMLTextAreaElement) {
+          field.style.height = 'auto';
+          field.style.height = field.scrollHeight + parseFloat(style.borderTopWidth)
+            + parseFloat(style.borderBottomWidth) + 'px';
+        }
+      }
+
+      function fitAllFields() {
+        fields.forEach(fitField);
+      }
+
+      fields.forEach(field => {
+        field.addEventListener('input', () => fitField(field));
+        field.addEventListener('change', () => fitField(field));
+      });
+      window.addEventListener('resize', fitAllFields);
+      document.fonts.ready.then(fitAllFields);
+      fitAllFields();
+    }
+
+    // This local form has no submission endpoint.
+    document.querySelector('.feedback-form').addEventListener('submit', event => {
+      event.preventDefault();
+    });
+  </script>
