+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const hero = document.getElementById('hero');
+    const title = document.getElementById('title');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const tastingNotes = {
+      maple: 'Espresso, steamed oat milk, and Vermont maple syrup. A cozy, gently sweet seasonal favorite.',
+      espresso: 'A rich dark roast with a full body, toasted notes, and a lingering finish. Served freshly pulled.',
+      'cold-brew': 'Slow-steeped for 18 hours and served over ice. Smooth, refreshing, and rich in flavor.'
+    };
+    let selectedCard = null;
+    let navigating = false;
+    let listScroll = 0;
+
+    async function changeView(showDetail) {
+      if (navigating) return;
+      navigating = true;
+      const update = async () => {
+        if (showDetail) {
+          // Capture the decoded photo in the new snapshot, including on a cold cache.
+          await hero.decode().catch(() => {});
+        }
+        listPage.hidden = showDetail;
+        detailPage.hidden = !showDetail;
+        if (showDetail) {
+          detailPage.scrollIntoView({ block: 'start', behavior: 'instant' });
+        } else {
+          window.scrollTo({ top: listScroll, behavior: 'instant' });
+        }
+      };
+      try {
+        if (document.startViewTransition && !reducedMotion.matches) {
+          const transition = document.startViewTransition(update);
+          // A skipped snapshot must still finish navigation and focus routing.
+          await transition.finished;
+        } else {
+          await update();
+        }
+      } catch {
+        await update();
+      } finally {
+        const heading = document.getElementById(showDetail ? 'title' : 'list-heading');
+        heading.focus({ preventScroll: true });
+        if (!showDetail) selectedCard?.classList.remove('selected');
+        navigating = false;
+      }
+    }
+
+    document.querySelectorAll('.thumbnail').forEach(card => {
+      card.addEventListener('click', event => {
+        event.preventDefault();
+        if (navigating) return;
+        selectedCard = card;
+        card.classList.add('selected');
+        listScroll = window.scrollY;
+        const image = card.querySelector('img');
+        hero.src = image.currentSrc || image.src;
+        hero.alt = image.alt;
+        title.textContent = card.querySelector('.title').textContent;
+        document.getElementById('description').textContent = card.closest('.card').querySelector('p').textContent;
+        document.getElementById('tasting-notes').textContent = tastingNotes[card.dataset.favorite];
+        changeView(true);
+      });
+    });
+
+    document.getElementById('back-button').addEventListener('click', () => changeView(false));
+  </script>
 </body>
 
