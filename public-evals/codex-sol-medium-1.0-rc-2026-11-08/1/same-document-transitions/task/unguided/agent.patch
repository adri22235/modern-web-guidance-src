+  <script>
+    const listPage = document.querySelector('#list-page');
+    const detailPage = document.querySelector('#detail-page');
+    const hero = document.querySelector('#hero');
+    const title = document.querySelector('#title');
+    const description = document.querySelector('#detail-description');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const details = {
+      maple: 'Our seasonal latte pairs freshly pulled espresso with creamy oat milk and a touch of Vermont maple syrup. A cozy, gently sweet favorite for cooler days.',
+      espresso: 'A deeply roasted espresso with a bold, smoky character and a rich finish. Enjoy it slowly on its own or make it the start of your morning ritual.',
+      'cold-brew': 'Patiently steeped for 18 hours, our cold brew is smooth and full of flavor. Served over ice for a refreshing sip any time of day.'
+    };
+    let selectedCard;
+    let listScroll = 0;
+    let changingView = false;
+
+    async function changeView(update, focusTarget) {
+      changingView = true;
+      try {
+        if (document.startViewTransition && !reducedMotion.matches) {
+          const transition = document.startViewTransition(update);
+          // Focus as soon as the new DOM is available, without moving the viewport.
+          await transition.updateCallbackDone;
+          focusTarget.focus({ preventScroll: true });
+          // A skipped animation still leaves the new view usable.
+          await transition.finished.catch(() => {});
+        } else {
+          update();
+          focusTarget.focus({ preventScroll: true });
+        }
+      } finally {
+        // Only the selected card participates, and only for this navigation.
+        selectedCard?.querySelector('img').style.removeProperty('view-transition-name');
+        selectedCard?.querySelector('.title').style.removeProperty('view-transition-name');
+        changingView = false;
+      }
+    }
+
+    listPage.addEventListener('click', (event) => {
+      const card = event.target.closest('.thumbnail');
+      if (!card || changingView) return;
+      selectedCard = card;
+      listScroll = window.scrollY;
+      const image = card.querySelector('img');
+      const cardTitle = card.querySelector('.title');
+      image.style.viewTransitionName = 'coffee-image';
+      cardTitle.style.viewTransitionName = 'coffee-title';
+      // Reuse the already loaded thumbnail asset for an immediate transition.
+      hero.src = image.src;
+      hero.alt = image.alt;
+      title.textContent = cardTitle.textContent;
+      description.textContent = details[card.dataset.coffee];
+      changeView(() => {
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        const top = document.querySelector('main').getBoundingClientRect().top + window.scrollY;
+        window.scrollTo({ top: Math.max(0, top - document.querySelector('nav').offsetHeight - 20), behavior: 'instant' });
+      }, title);
+    });
+
+    document.querySelector('#back-button').addEventListener('click', () => {
+      if (changingView || !selectedCard) return;
+      selectedCard.querySelector('img').style.viewTransitionName = 'coffee-image';
+      selectedCard.querySelector('.title').style.viewTransitionName = 'coffee-title';
+      changeView(() => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        window.scrollTo({ top: listScroll, behavior: 'instant' });
+      }, selectedCard.querySelector('.card-trigger'));
+    });
+  </script>
