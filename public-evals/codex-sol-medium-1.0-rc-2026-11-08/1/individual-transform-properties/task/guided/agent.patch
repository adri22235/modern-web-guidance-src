@@ -106,8 +106,69 @@
       gap: 20px;
       margin-top: 20px;
     }
 
+    .seasonal-promo {
+      display: flex;
+      justify-content: center;
+      padding: 28px 24px;
+    }
+
+    .target {
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      width: 112px;
+      height: 112px;
+      border: 2px solid var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      text-align: center;
+      text-decoration: none;
+      font-size: 0.85rem;
+      line-height: 1.3;
+      box-shadow: 0 4px 10px rgba(62, 39, 35, 0.15);
+      /* Identity transforms establish a stable stacking context before hover. */
+      translate: 0;
+      rotate: 0deg;
+      scale: 1;
+    }
+
+    .target strong {
+      font-size: 1rem;
+    }
+
+    .target:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 5px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .target {
+        /* Each effect owns a separate property, so hover cannot reset motion. */
+        animation: promo-spin 12s linear infinite,
+          promo-slide 3s ease-in-out infinite alternate;
+        transition: scale 250ms ease;
+      }
+
+      .target:hover,
+      .target:focus-visible {
+        scale: 1.12;
+      }
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -20px 0; }
+      to { translate: 20px 0; }
+    }
+
