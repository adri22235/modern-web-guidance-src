+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences-form');
+      const reminder = document.getElementById('pickup-reminder-time');
+      const anniversary = document.getElementById('coffee-anniversary-date');
+      const status = document.getElementById('preferences-status');
+
+      // These are plain wall-clock/calendar values, not instants. Preserve the
+      // input strings end to end; never use Date, UTC, or time zone conversions.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminderTime === 'string' &&
+              /^(?:[01]\d|2[0-3]):[0-5]\d$/.test(saved.pickupReminderTime)) {
+            reminder.value = saved.pickupReminderTime;
+          }
+          if (typeof saved.coffeeAnniversaryDate === 'string' &&
+              /^\d{4,}-\d{2}-\d{2}$/.test(saved.coffeeAnniversaryDate)) {
+            // Native date inputs also reject invalid calendar dates.
+            anniversary.value = saved.coffeeAnniversaryDate;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can choose them again and try saving.';
+      }
+
+      document.getElementById('save-preferences').disabled = false;
+
+      form.addEventListener('input', () => {
+        status.textContent = 'You have unsaved changes.';
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminderTime: reminder.value,
+            coffeeAnniversaryDate: anniversary.value,
+          }));
+          status.textContent = 'Preferences saved on this device.';
+        } catch {
+          status.textContent = 'Preferences could not be saved. Allow site storage and try again.';
+        }
+      });
+    })();
+  </script>
+
 </body>
 
