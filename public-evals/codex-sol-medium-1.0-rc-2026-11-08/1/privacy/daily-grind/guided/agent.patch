+    <section aria-labelledby="collection">
+      <h2 id="collection">What this website collects</h2>
+      <p>These static pages do not ask for personal information and run no client-side JavaScript. We use no analytics, advertising trackers, fingerprinting, cookies, or browser storage.</p>
+    </section>
+    <section aria-labelledby="resources">
+      <h2 id="resources">Images and other services</h2>
+      <p>Images and styles are served by this website. Your browser does not contact an image provider, font service, social network, or analytics service to display these pages.</p>
+    </section>
+    <section aria-labelledby="delivery">
+      <h2 id="delivery">Delivering the website</h2>
+      <p>The hosting provider receives network information, including your IP address and the page requested, to deliver the website. It may keep access and security logs. This site's code does not control those logs or their retention; that depends on the hosting provider's configuration.</p>
+      <p>Avoid putting personal details or secrets in website URLs. These pages do not send referrer information when you follow a link.</p>
+    </section>
+    <section aria-labelledby="scope">
+      <h2 id="scope">Accounts, orders, and your information</h2>
+      <p>This notice covers the static pages in this website. Account, rewards, and ordering services are not implemented here. If those services become available, they will need to explain what data they require, why, how long they keep it, and how you can access, correct, or delete it before collecting information.</p>
+    </section>
+  </main>
+  <footer>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+</body>
+</html>
diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..398fb90
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { siteFiles } from './site-files.mjs';
+
+// A deliberately narrow source guard for this script-free static site, not a
+// general HTML sanitizer. The enforced CSP is the browser security boundary.
+export function auditText(file, source) {
+  if (file.endsWith('.html')) {
+    assert(!/<\s*(?:script|style|iframe|object|embed|base|form|input|textarea|select)\b/i.test(source), `${file}: active content or collection UI needs privacy review`);
+    assert(!/\s(?:on[\w-]+|style|ping|srcdoc|srcset)\s*=/i.test(source), `${file}: inline behavior, styles, or alternate resource loading needs review`);
+    for (const match of source.matchAll(/\b(?:href|src|action|poster|data)\s*=\s*(["'])(.*?)\1/gi)) {
+      assert(/^\/(?!\/)[a-z0-9/_\-.]*$/i.test(match[2]) || /^#[a-z0-9_-]+$/i.test(match[2]), `${file}: only plain local URLs are approved`);
+    }
+    assert(source.includes('<meta name="referrer" content="no-referrer">'), `${file}: missing referrer fallback`);
+    assert(source.includes('<link rel="stylesheet" href="/assets/styles.css">'), `${file}: missing local stylesheet`);
+  }
+  if (file.endsWith('.css')) {
+    assert(!/@import|\\/i.test(source), `${file}: CSS imports and escapes need review`);
+    for (const match of source.matchAll(/url\(\s*(['"]?)(.*?)\1\s*\)/gi)) {
+      assert.equal(match[2], './coffee.jpg', `${file}: unapproved CSS resource`);
+    }
+  }
+}
+
+export async function auditSite() {
+  const headers = await readFile('_headers', 'utf8');
+  const header = name => headers.match(new RegExp(`^  ${name}: (.+)$`, 'mi'))?.[1];
+  assert(headers.startsWith('/*\n'), 'Security headers must cover every route');
+  const csp = header('Content-Security-Policy');
+  assert(csp, 'Missing enforced CSP');
+  const directives = new Map(csp.split(';').map(value => {
+    const [name, ...tokens] = value.trim().split(/\s+/);
+    return [name, tokens.join(' ')];
+  }));
+  for (const name of ['default-src', 'script-src', 'font-src', 'connect-src', 'frame-src', 'worker-src', 'object-src', 'base-uri', 'form-action', 'frame-ancestors', 'trusted-types']) {
+    assert.equal(directives.get(name), "'none'", `${name} must be blocked`);
+  }
+  for (const name of ['style-src', 'img-src']) assert.equal(directives.get(name), "'self'");
+  assert.equal(directives.get('require-trusted-types-for'), "'script'");
+  assert.equal(header('Referrer-Policy'), 'no-referrer');
+  assert.equal(header('X-Frame-Options'), 'DENY');
+  assert.equal(header('X-Content-Type-Options'), 'nosniff');
+  assert.equal(header('X-DNS-Prefetch-Control'), 'off');
+  assert.equal(header('Cross-Origin-Resource-Policy'), 'same-origin');
+  assert.equal(header('Cross-Origin-Opener-Policy'), 'same-origin-allow-popups');
+  assert.equal(header('Strict-Transport-Security'), 'max-age=300');
+  for (const name of ['camera', 'microphone', 'geolocation', 'payment', 'usb']) {
+    assert(header('Permissions-Policy')?.split(', ').includes(`${name}=()`), `Disable ${name}`);
+  }
+  assert(!/Reporting-Endpoints|report-uri|report-to|Set-Cookie/i.test(headers), 'New reporting or cookies require a data-handling review');
+  const metaPolicy = csp.replace("; frame-ancestors 'none'", '');
+  for (const file of siteFiles) {
+    if (file.endsWith('.html') || file.endsWith('.css')) {
+      const source = await readFile(file, 'utf8');
+      auditText(file, source);
+      if (file.endsWith('.html')) {
+        assert(source.includes(`<meta http-equiv="Content-Security-Policy" content="${metaPolicy}">`), `${file}: meta CSP differs from HTTP policy`);
+      }
+    }
+  }
+  const image = await readFile('assets/coffee.jpg');
+  assert.equal(image.subarray(0, 3).toString('hex'), 'ffd8ff', 'Hero image must be a local JPEG');
+  console.log('Privacy audit passed: local-only resources, no client scripts or collection UI, matching CSP, and defensive response headers.');
+}
+
+await auditSite();
