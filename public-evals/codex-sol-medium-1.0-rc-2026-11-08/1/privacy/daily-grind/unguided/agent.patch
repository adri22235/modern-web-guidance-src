+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <meta name="referrer" content="no-referrer">
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; base-uri 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; form-action 'none'">
+  <title>Privacy | The Daily Grind</title>
+  <link rel="stylesheet" href="/assets/styles.css">
+</head>
+<body>
+  <nav aria-label="Main navigation"><a class="logo" href="/">THE DAILY GRIND</a></nav>
+  <main class="container privacy-notice">
+    <h1>Privacy at The Daily Grind</h1>
+    <p>This notice covers this static website. It was updated on November 8, 2026.</p>
+    <h2>Browse without signing up</h2>
+    <p>This website does not ask for personal information or use analytics, advertising trackers, cookies, browser storage, or fingerprinting. There are no client-side scripts or embedded third-party services. The fonts, styles, and coffee image are served from this website.</p>
+    <h2>Information needed to deliver a page</h2>
+    <p>Your browser sends network information, such as your IP address and request headers, to the hosting provider to retrieve a page. The provider may keep access and security logs under its own configuration. This website does not add visitor identifiers or send page activity to analytics providers.</p>
+    <h2>Keep sensitive information out of links</h2>
+    <p>Do not put personal details, passwords, or payment information in page addresses or query strings. This site has no forms for submitting that information. Account, rewards, and ordering services require their own privacy and security controls before they can collect information.</p>
+    <h2>Links and referrals</h2>
+    <p>This website tells browsers not to send the referring page address when following links or loading resources. If you visit another service, its privacy notice applies.</p>
+    <a class="btn" href="/">Back to home</a>
+  </main>
+  <footer><p>&copy; 2026 The Daily Grind Coffee Co.</p></footer>
+</body>
+</html>
diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..2d115a1
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import { readFile, readdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const root = new URL('../', import.meta.url);
+const read = (path) => readFile(new URL(path, root), 'utf8');
+const headers = await read('_headers');
+const header = (name) => {
+  const line = headers.split('\n').find((line) => line.trim().toLowerCase().startsWith(`${name.toLowerCase()}:`));
+  assert.ok(line, `Missing response header: ${name}`);
+  return line.trim().slice(name.length + 1).trim();
+};
+const csp = header('Content-Security-Policy');
+for (const directive of ["default-src 'none'", "script-src 'none'", "connect-src 'none'", "form-action 'none'", "base-uri 'none'", "object-src 'none'", "frame-ancestors 'none'", "style-src 'self'", "img-src 'self'"]) {
+  assert.ok(csp.split(';').map((part) => part.trim()).includes(directive), `Missing CSP restriction: ${directive}`);
+}
+assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|https?:|\*/);
+assert.equal(header('Referrer-Policy'), 'no-referrer');
+assert.equal(header('X-Content-Type-Options'), 'nosniff');
+assert.equal(header('X-Frame-Options'), 'DENY');
+assert.equal(header('Cache-Control'), 'no-store');
+assert.equal(header('Cross-Origin-Opener-Policy'), 'same-origin');
+assert.equal(header('Cross-Origin-Resource-Policy'), 'same-origin');
+assert.match(header('Strict-Transport-Security'), /max-age=31536000/);
+for (const feature of ['camera', 'microphone', 'geolocation', 'payment', 'browsing-topics']) {
+  assert.ok(header('Permissions-Policy').includes(`${feature}=()`), `Unrestricted browser capability: ${feature}`);
+}
+
+async function auditDirectory(directory = '') {
+  for (const entry of await readdir(new URL(directory || '.', root), { withFileTypes: true })) {
+    const path = directory + entry.name;
+    if (['.git', 'node_modules', 'dist', 'scripts'].includes(entry.name)) continue;
+    if (entry.isDirectory()) { await auditDirectory(`${path}/`); continue; }
+    assert.ok(!/\.(?:m?js|cjs|tsx?|jsx)$/i.test(path), `Client script requires a privacy review: ${path}`);
+    if (!/\.(html|css)$/i.test(path)) continue;
+    const source = await read(path);
+    assert.doesNotMatch(source, /https?:\/\/|\/\/[a-z0-9]/i, `External resource requires review: ${path}`);
+    if (path.endsWith('.html')) {
+      assert.doesNotMatch(source, /<(?:script|iframe|object|embed|form|input|textarea)\b/i, `Active content or collection requires review: ${path}`);
+      assert.doesNotMatch(source, /\s(?:on[a-z]+|style)\s*=/i, `Inline code violates CSP: ${path}`);
+      assert.doesNotMatch(source, /(?:javascript|data):/i, `Unexpected inline resource: ${path}`);
+      assert.match(source, /<meta name="referrer" content="no-referrer">/);
+      const fallback = source.match(/<meta http-equiv="Content-Security-Policy" content="([^"]+)">/)?.[1];
+      assert.equal(fallback, csp.replace("; frame-ancestors 'none'; upgrade-insecure-requests", ''), `CSP fallback differs: ${path}`);
+      for (const [, asset] of source.matchAll(/(?:src|href)="(\/assets\/[^"?#]+)"/g)) {
+        await readFile(new URL(asset.slice(1), root));
+      }
+    }
+    for (const [, asset] of source.matchAll(/url\(['"]?(\/assets\/[^)'"?#]+)['"]?\)/g)) {
+      await readFile(new URL(asset.slice(1), root));
+    }
+  }
+}
+await auditDirectory();
+await read('privacy-policy.html');
+assert.match(await read('index.html'), /href="\/privacy-policy\.html"/);
+const pkg = JSON.parse(await read('package.json'));
+assert.equal(Object.keys(pkg.dependencies ?? {}).length, 0, 'New production dependencies need a privacy audit');
+console.log(`Privacy checks passed for ${fileURLToPath(root)} (static checks; deployed headers still require host configuration).`);
diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..6c788b6
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,10 @@
+import './audit-privacy.mjs';
+import { cp, mkdir, rm } from 'node:fs/promises';
+const root = new URL('../', import.meta.url);
+const output = new URL('dist/', root);
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+for (const path of ['index.html', 'privacy-policy.html', 'assets', '_headers']) {
+  await cp(new URL(path, root), new URL(path, output), { recursive: true });
+}
+console.log('Built static website in dist/');
