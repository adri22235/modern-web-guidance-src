@@ -0,0 +1,11 @@
+export default function AccountPrivacyNotice({ purpose }: { purpose: string }) {
+  return (
+    <p id="account-privacy" className="mb-6 text-sm text-gray-700">
+      We ask only for a username and password to {purpose}. When you submit,
+      these are sent over HTTPS to our external account service at{' '}
+      <span className="break-all">us-central1-web-devrel-apps.cloudfunctions.net</span>.
+      This form does not save your credentials in browser storage or send them to analytics.
+      {' '}<a href={`${import.meta.env.BASE_URL}legal/privacy`} className="underline">Read our privacy notice</a>.
+    </p>
+  );
+}
