@@ -0,0 +1,122 @@
+import { beforeEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { Window } from 'happy-dom';
+
+// DOM-only checks: no browser, HTTP listener, or server entrypoint is used.
+const window = new Window();
+for (const name of ['document', 'HTMLElement', 'HTMLAnchorElement', 'customElements', 'AbortController']) {
+  globalThis[name] = window[name];
+}
+globalThis.window = window;
+let desktop = false;
+let mediaQueries = [];
+window.matchMedia = () => {
+  const query = new window.EventTarget();
+  Object.defineProperty(query, 'matches', { get: () => desktop });
+  mediaQueries.push(query);
+  return query;
+};
+await import('../components/daily-grind.js');
+
+beforeEach(() => {
+  document.body.replaceChildren();
+  desktop = false;
+  mediaQueries = [];
+});
+
+function navigation() {
+  const nav = document.createElement('grind-navigation');
+  nav.innerHTML = '<span slot="brand">Coffee</span><a href="/menu">Menu</a>';
+  document.body.append(nav);
+  return {
+    nav,
+    button: nav.shadowRoot.querySelector('button'),
+    links: nav.shadowRoot.querySelector('#links'),
+    link: nav.querySelector('a'),
+  };
+}
+
+test('cards clone independent shadow trees and preserve semantic, slotted content', () => {
+  document.body.innerHTML = `
+    <coffee-card><h3 slot="heading">Maple</h3><p>Oat milk</p><a slot="action" href="/maple">Details</a></coffee-card>
+    <coffee-card><h3 slot="heading">Espresso</h3></coffee-card>`;
+  const [first, second] = document.querySelectorAll('coffee-card');
+  assert.ok(first.shadowRoot.querySelector('article'));
+  assert.notEqual(first.shadowRoot.querySelector('article'), second.shadowRoot.querySelector('article'));
+  assert.equal(first.shadowRoot.querySelector('slot[name="heading"]').assignedElements()[0].textContent, 'Maple');
+  assert.equal(first.querySelector('a').getAttribute('href'), '/maple');
+  assert.equal(first.hasAttribute('tabindex'), false);
+});
+
+test('mobile disclosure keeps its ARIA relationship local and supports Escape', () => {
+  const { nav, button, links, link } = navigation();
+  assert.equal(button.getAttribute('aria-controls'), links.id);
+  assert.equal(button.getAttribute('aria-expanded'), 'false');
+  assert.equal(links.hidden, true);
+  assert.equal(window.getComputedStyle(links).display, 'none');
+  button.click();
+  assert.equal(button.getAttribute('aria-expanded'), 'true');
+  assert.equal(links.hidden, false);
+  link.focus();
+  link.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true, composed: true }));
+  assert.equal(links.hidden, true);
+  assert.equal(nav.shadowRoot.activeElement, button);
+  desktop = true;
+  mediaQueries[0].dispatchEvent(new window.Event('change'));
+  assert.equal(document.activeElement, link);
+});
+
+test('navigation closes after activating a link and instances do not share state', () => {
+  const first = navigation();
+  const second = navigation();
+  first.button.click();
+  assert.equal(first.links.hidden, false);
+  assert.equal(second.links.hidden, true);
+  first.link.addEventListener('click', event => event.preventDefault());
+  first.link.click();
+  assert.equal(first.links.hidden, true);
+});
+
+test('desktop links remain exposed and resize moves focus out of collapsed content', () => {
+  desktop = true;
+  const { nav, button, links, link } = navigation();
+  assert.equal(button.hidden, true);
+  assert.equal(links.hidden, false);
+  link.focus();
+  desktop = false;
+  mediaQueries[0].dispatchEvent(new window.Event('change'));
+  assert.equal(button.hidden, false);
+  assert.equal(links.hidden, true);
+  assert.equal(nav.shadowRoot.activeElement, button);
+});
+
+test('disconnecting cleans up listeners and reconnecting does not duplicate toggles', () => {
+  const { nav, button, links } = navigation();
+  nav.remove();
+  button.click();
+  assert.equal(links.hidden, true);
+  document.body.append(nav);
+  button.click();
+  assert.equal(links.hidden, false);
+  button.click();
+  assert.equal(links.hidden, true);
+});
+
+test('homepage keeps its headings, destinations and content available without scripts', async () => {
+  const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+  const fallback = new Window();
+  fallback.document.write(html);
+  const page = fallback.document;
+  assert.equal(page.querySelectorAll('coffee-card').length, 3);
+  assert.equal(page.querySelector('h1').textContent, 'Wake Up Your Senses');
+  assert.equal(page.querySelector('coffee-hero a').getAttribute('href'), '/order-online');
+  assert.equal(page.querySelectorAll('grind-navigation a').length, 5);
+  assert.equal(page.querySelector('a.skip-link').hash, '#main-content');
+  for (const card of page.querySelectorAll('coffee-card')) {
+    assert.ok(card.querySelector('h3'));
+    assert.ok(card.querySelector('p'));
+    assert.match(card.querySelector('a').getAttribute('aria-label'), /^View details about /);
+  }
+  await fallback.happyDOM.close();
+});
