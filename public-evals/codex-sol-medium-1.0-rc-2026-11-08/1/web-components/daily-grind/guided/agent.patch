+// Templates are parsed once; each instance receives its own DOM nodes.
+function template(markup, styles) {
+  const result = document.createElement('template');
+  result.innerHTML = `<style>
+    :host { display: block; }
+    *, *::before, *::after { box-sizing: border-box; }
+    ${styles}
+  </style>${markup}`;
+  return result;
+}
+
+const actionStyles = `
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+  }
+  ::slotted(a:hover) { background: #3e2723; }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+`;
+
+const cardTemplate = template(`
+  <article part="card">
+    <slot name="heading"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </article>
+`, `
+  :host { height: 100%; }
+  article {
+    height: 100%;
+    background: var(--card-background, white);
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+    text-align: center;
+  }
+  ::slotted([slot="heading"]) {
+    margin: 0 0 10px;
+    color: var(--primary, #4e342e);
+  }
+  ::slotted(p) { margin: 0; }
+  ${actionStyles}
+`);
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(cardTemplate.content.cloneNode(true));
+  }
+}
+
+const heroTemplate = template(`
+  <div part="hero">
+    <slot name="heading"></slot>
+    <slot></slot>
+    <slot name="action"></slot>
+  </div>
+`, `
+  [part="hero"] {
+    min-height: 60vh;
+    background: linear-gradient(rgb(0 0 0 / 50%), rgb(0 0 0 / 50%)),
+      var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+    background-size: cover;
+    background-position: center;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 40px 20px;
+    background-color: var(--primary, #4e342e);
+  }
+  ::slotted([slot="heading"]) {
+    font-size: clamp(2rem, 6vw, 3rem);
+    line-height: 1.2;
+    margin: 0 0 1rem;
+  }
+  ::slotted(p) { margin: 0; }
+  ${actionStyles}
+`);
+
+export class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true })
+      .append(heroTemplate.content.cloneNode(true));
+  }
+}
+
+const navigationTemplate = template(`
+  <nav aria-label="Main navigation" part="navigation">
+    <slot name="brand"></slot>
+    <button type="button" aria-expanded="false" aria-controls="links" part="toggle">Menu</button>
+    <div id="links"><slot></slot></div>
+  </nav>
+`, `
+  :host {
+    position: sticky;
+    top: 0;
+    z-index: 1000;
+    background: var(--primary, #4e342e);
+    color: white;
+  }
+  nav {
+    padding: 1rem 5%;
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: 1rem;
+  }
+  ::slotted([slot="brand"]) {
+    font-size: 1.5rem;
+    font-weight: bold;
+    letter-spacing: 1px;
+  }
+  #links {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 20px;
+    align-items: center;
+  }
+  ::slotted(a) {
+    color: white;
+    text-decoration: none;
+    font-size: 0.9rem;
+    padding-block: 8px;
+  }
+  ::slotted(a:hover) { color: var(--accent, #ffab40); }
+  ::slotted(a:focus-visible) {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+  ::slotted(.logout-link) {
+    border: 1px solid var(--accent, #ffab40);
+    padding: 5px 12px;
+    border-radius: 4px;
+  }
+  button {
+    font: inherit;
+    color: inherit;
+    background: transparent;
+    border: 1px solid var(--accent, #ffab40);
+    border-radius: 4px;
+    padding: 8px 12px;
+    min-height: 44px;
+    cursor: pointer;
+  }
+  button:focus-visible {
+    outline: 3px solid var(--accent, #ffab40);
+    outline-offset: 4px;
+  }
+  button[hidden], #links[hidden] { display: none; }
+  @media (max-width: 43.999rem) {
+    #links { flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 12px; }
+  }
+`);
+
+export class GrindNavigation extends HTMLElement {
+  #controller;
+  #media;
+  #button;
+  #links;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(navigationTemplate.content.cloneNode(true));
+    this.#button = root.querySelector('button');
+    this.#links = root.querySelector('#links');
+  }
+
+  connectedCallback() {
+    this.#controller?.abort();
+    this.#controller = new AbortController();
+    const { signal } = this.#controller;
+    this.#media = window.matchMedia('(min-width: 44rem)');
+    this.#media.addEventListener('change', this.#syncLayout, { signal });
+    this.#button.addEventListener('click', () => {
+      this.#setExpanded(this.#button.getAttribute('aria-expanded') !== 'true');
+    }, { signal });
+    this.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !this.#media.matches && !this.#links.hidden) {
+        this.#setExpanded(false);
+        this.#button.focus();
+        event.preventDefault();
+      }
+    }, { signal });
+    this.addEventListener('click', (event) => {
+      if (!this.#media.matches && event.composedPath().some(node => node instanceof HTMLAnchorElement)) {
+        this.#setExpanded(false);
+      }
+    }, { signal });
+    this.#syncLayout();
+  }
+
+  disconnectedCallback() {
+    this.#controller?.abort();
+  }
+
+  #syncLayout = () => {
+    // Do not leave focus inside content that is about to be hidden on resize.
+    const hadLinkFocus = this.contains(document.activeElement);
+    const hadToggleFocus = this.shadowRoot.activeElement === this.#button;
+    this.#button.hidden = this.#media.matches;
+    this.#setExpanded(this.#media.matches);
+    if (!this.#media.matches && hadLinkFocus) this.#button.focus();
+    if (this.#media.matches && hadToggleFocus) this.querySelector('a[href]')?.focus();
+  };
+
+  #setExpanded(expanded) {
+    this.#button.setAttribute('aria-expanded', String(expanded));
+    this.#links.hidden = !expanded;
+  }
+}
+
+for (const [name, component] of [
+  ['coffee-card', CoffeeCard],
+  ['coffee-hero', CoffeeHero],
+  ['grind-navigation', GrindNavigation],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
