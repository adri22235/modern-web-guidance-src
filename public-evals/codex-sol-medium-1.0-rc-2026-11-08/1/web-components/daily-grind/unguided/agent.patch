+# Daily Grind components
+
+Load `components/daily-grind.js` once with a module script. These native custom
+elements need no dependencies or build step. Each instance has an open shadow
+root containing its styling and structure. Content uses light DOM slots so links
+and headings remain available if JavaScript fails to load.
+
+## Cards and hero
+
+`coffee-card` and `coffee-hero` accept three named slots: `title`, `description`,
+and `action`. Use an `h3` for a card title, an `h1` for the homepage hero, a `p`
+for the description, and an `a` for the action. Give repeated action links an
+accessible name that identifies their destination.
+
+```html
+<coffee-card>
+  <h3 slot="title">Cold Brew</h3>
+  <p slot="description">Steeped for 18 hours for maximum smoothness.</p>
+  <a slot="action" href="/menu/cold-brew"
+     aria-label="View details for Cold Brew">View Details</a>
+</coffee-card>
+```
+
+The hero accepts the same content slots. Override its stock background through
+the `--hero-image` CSS property (a CSS `url(...)` value).
+
+## Navigation
+
+`daily-navigation` accepts a home link in the `brand` slot and navigation links
+in its default slot. A link with the `logout-link` class receives an outlined
+style. At widths up to 700px, the component shows a native menu button with
+`aria-expanded` and `aria-controls`. Escape closes the menu and returns focus to
+the button; following a navigation link closes it. Moving between desktop and
+mobile resets the menu. Event listeners are removed when an instance disconnects
+and restored when it reconnects.
+
+## Styling and accessibility
+
+Components inherit typography and support the existing `--primary` and
+`--accent` theme properties. Page layout stays in `index.html`; internal styles
+stay in the shadow roots. Slotted content is intentionally owned by the page,
+so page styles can still affect it. Keep the document heading hierarchy, use
+native links for destinations, and supply visible text for every action. Focus
+indicators and reduced-motion support are included.
+
+To check JavaScript syntax without running a server:
+
+```sh
+node --check components/daily-grind.js
+```
diff --git a/components/daily-grind.js b/components/daily-grind.js
new file mode 100644
index 0000000..e199cfa
--- /dev/null
+++ b/components/daily-grind.js
@@ -0,0 +1,176 @@
+const actionStyles = `
+  ::slotted(a) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background .3s;
+  }
+  ::slotted(a:hover) { background: #3e2723; }
+  ::slotted(a:focus-visible) { outline: 3px solid #a95700; outline-offset: 4px; }
+  @media (prefers-reduced-motion: reduce) { ::slotted(a) { transition: none; } }
+`;
+
+// Content stays in light DOM so it remains available before JavaScript loads.
+// Each instance owns its styles and uses ordinary, keyboard-accessible links.
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        :host { display: block; }
+        article {
+          box-sizing: border-box;
+          height: 100%;
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgb(0 0 0 / .1);
+          text-align: center;
+        }
+        ::slotted(h3) { margin: 0 0 10px; color: var(--primary, #4e342e); }
+        ::slotted(p) { margin: 0; }
+        ${actionStyles}
+      </style>
+      <article>
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </article>
+    `;
+  }
+}
+
+class CoffeeHero extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        :host { display: block; }
+        header {
+          box-sizing: border-box;
+          min-height: 60vh;
+          background: linear-gradient(rgb(0 0 0 / .5), rgb(0 0 0 / .5)),
+            var(--hero-image, url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80'));
+          background-size: cover;
+          background-position: center;
+          display: flex;
+          flex-direction: column;
+          justify-content: center;
+          align-items: center;
+          color: white;
+          text-align: center;
+          padding: 32px 20px;
+        }
+        ::slotted(h1) { font-size: clamp(2rem, 6vw, 3rem); margin: 0 0 1rem; }
+        ::slotted(p) { margin: 0; }
+        ${actionStyles}
+        ::slotted(a:focus-visible) { outline-color: white; }
+      </style>
+      <header>
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+        <slot name="action"></slot>
+      </header>
+    `;
+  }
+}
+
+class DailyNavigation extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        :host { display: block; position: sticky; top: 0; z-index: 1000; }
+        nav {
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 1rem 5%;
+          display: flex;
+          flex-wrap: wrap;
+          justify-content: space-between;
+          align-items: center;
+          gap: 16px;
+        }
+        .brand { font-size: 1.5rem; font-weight: bold; letter-spacing: 1px; }
+        .links { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; }
+        ::slotted(a) { color: white; text-decoration: none; font-size: .9rem; }
+        ::slotted(a:hover) { color: var(--accent, #ffab40); }
+        ::slotted(a[slot="brand"]) { font-size: inherit; }
+        ::slotted(.logout-link) { border: 1px solid var(--accent, #ffab40); padding: 5px 12px; border-radius: 4px; }
+        button {
+          display: none;
+          font: inherit;
+          color: white;
+          background: transparent;
+          border: 1px solid var(--accent, #ffab40);
+          border-radius: 4px;
+          padding: 8px 12px;
+          cursor: pointer;
+        }
+        button:focus-visible, ::slotted(a:focus-visible) {
+          outline: 3px solid var(--accent, #ffab40);
+          outline-offset: 4px;
+        }
+        @media (max-width: 700px) {
+          button { display: block; }
+          .links { width: 100%; flex-direction: column; align-items: stretch; gap: 8px; }
+          .links[hidden] { display: none; }
+          ::slotted(a) { padding: 8px 0; }
+        }
+      </style>
+      <nav aria-label="Primary">
+        <div class="brand"><slot name="brand"></slot></div>
+        <button type="button" aria-expanded="false" aria-controls="navigation-links">Menu</button>
+        <div class="links" id="navigation-links"><slot></slot></div>
+      </nav>
+    `;
+    this.button = this.shadowRoot.querySelector('button');
+    this.links = this.shadowRoot.querySelector('.links');
+    this.mobile = window.matchMedia('(max-width: 700px)');
+    this.onToggle = () => this.setExpanded(this.button.getAttribute('aria-expanded') !== 'true');
+    this.onResize = () => this.setExpanded(false);
+    this.onKeydown = (event) => {
+      if (event.key === 'Escape' && this.mobile.matches && !this.links.hidden) {
+        this.setExpanded(false);
+        this.button.focus();
+      }
+    };
+    this.onNavigate = (event) => {
+      if (event.composedPath().some((node) => node instanceof HTMLAnchorElement && node.slot !== 'brand')) {
+        this.setExpanded(false);
+      }
+    };
+  }
+
+  connectedCallback() {
+    this.button.addEventListener('click', this.onToggle);
+    this.addEventListener('keydown', this.onKeydown);
+    this.addEventListener('click', this.onNavigate);
+    this.mobile.addEventListener('change', this.onResize);
+    this.setExpanded(false);
+  }
+
+  disconnectedCallback() {
+    this.button.removeEventListener('click', this.onToggle);
+    this.removeEventListener('keydown', this.onKeydown);
+    this.removeEventListener('click', this.onNavigate);
+    this.mobile.removeEventListener('change', this.onResize);
+  }
+
+  setExpanded(expanded) {
+    this.button.setAttribute('aria-expanded', String(expanded));
+    this.links.hidden = this.mobile.matches && !expanded;
+  }
+}
+
+for (const [name, component] of [
+  ['coffee-card', CoffeeCard],
+  ['coffee-hero', CoffeeHero],
+  ['daily-navigation', DailyNavigation],
+]) {
+  if (!customElements.get(name)) customElements.define(name, component);
+}
