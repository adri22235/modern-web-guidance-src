+  <script>
+    const seasonalPreference = document.getElementById('seasonal-preference');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+    const preferenceState = document.getElementById('preference-state');
+    const preferenceNote = document.getElementById('preference-note');
+    const preferenceKey = 'daily-grind:show-seasonal-favorites';
+
+    function applyPreference() {
+      seasonalFavorites.hidden = !seasonalPreference.checked;
+      preferenceState.textContent = seasonalPreference.checked ? 'On' : 'Off';
+    }
+
+    try {
+      seasonalPreference.checked = localStorage.getItem(preferenceKey) !== 'false';
+    } catch {
+      preferenceNote.textContent = 'Applies for this visit. Browser storage is unavailable.';
+    }
+    applyPreference();
+
+    seasonalPreference.addEventListener('change', () => {
+      applyPreference();
+      try {
+        localStorage.setItem(preferenceKey, String(seasonalPreference.checked));
+        preferenceNote.textContent = 'Saved in this browser.';
+      } catch {
+        preferenceNote.textContent = 'Applies for this visit. Browser storage is unavailable.';
+      }
+    });
+  </script>
+
