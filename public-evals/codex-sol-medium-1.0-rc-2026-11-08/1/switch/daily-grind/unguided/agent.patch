+  <script>
+    const darkModeToggle = document.getElementById('dark-mode');
+    const darkModeState = document.getElementById('dark-mode-state');
+
+    function applyDarkMode(enabled) {
+      document.documentElement.dataset.darkMode = String(enabled);
+      darkModeToggle.checked = enabled;
+      darkModeState.textContent = enabled ? 'On' : 'Off';
+    }
+
+    applyDarkMode(document.documentElement.dataset.darkMode === 'true');
+
+    darkModeToggle.addEventListener('change', () => {
+      applyDarkMode(darkModeToggle.checked);
+      try {
+        localStorage.setItem('daily-grind-dark-mode', String(darkModeToggle.checked));
+      } catch {
+        // The preference still works for this visit when storage is unavailable.
+      }
+    });
+  </script>
