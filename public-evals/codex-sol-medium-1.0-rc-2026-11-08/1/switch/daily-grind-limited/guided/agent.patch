+  <script>
+    const seasonalPreference = document.getElementById('seasonal-preference');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+    const seasonalPreferenceState = document.getElementById('seasonal-preference-state');
+    const preferenceKey = 'daily-grind:show-seasonal-favorites';
+
+    function applySeasonalPreference() {
+      seasonalFavorites.hidden = !seasonalPreference.checked;
+      seasonalPreferenceState.textContent = seasonalPreference.checked ? 'On' : 'Off';
+    }
+
+    try {
+      const savedPreference = localStorage.getItem(preferenceKey);
+      if (savedPreference !== null) {
+        seasonalPreference.checked = savedPreference !== 'false';
+      }
+    } catch {
+      // Keep the default when browser storage is unavailable.
+    }
+    applySeasonalPreference();
+
+    seasonalPreference.addEventListener('change', () => {
+      applySeasonalPreference();
+      try {
+        localStorage.setItem(preferenceKey, String(seasonalPreference.checked));
+      } catch {
+        // The preference still works for this visit without storage access.
+      }
+    });
+  </script>
+
 </body>
 
