diff --git a/foreground-time.js b/foreground-time.js
new file mode 100644
--- a/foreground-time.js
+++ b/foreground-time.js
@@ -0,0 +1,40 @@
+(() => {
+  // Start early in <head> for browsers without visibility performance entries.
+  // This fallback can only measure visibility from script initialization onward.
+  let total = 0;
+  let visibleSince = document.visibilityState === 'visible' ? performance.now() : null;
+
+  document.addEventListener('visibilitychange', () => {
+    const now = performance.now();
+    if (document.visibilityState === 'visible') {
+      if (visibleSince === null) visibleSince = now;
+    } else if (visibleSince !== null) {
+      total += now - visibleSince;
+      visibleSince = null;
+    }
+  });
+
+  /**
+   * Total visible time for this document in milliseconds, including the current
+   * visible interval. Repeated calls do not reset or double-count elapsed time.
+   * Visibility measures foreground presence, not attention or user activity.
+   * Uses history from navigation when available; otherwise from initialization.
+   */
+  window.getTotalForegroundTime = function getTotalForegroundTime() {
+    const entries = performance.getEntriesByType('visibility-state');
+    const now = performance.now();
+
+    if (entries.length === 0) {
+      return total + (visibleSince === null ? 0 : now - visibleSince);
+    }
+
+    let foregroundTime = 0;
+    for (let i = 0; i < entries.length; i++) {
+      if (entries[i].name === 'visible') {
+        const end = i + 1 < entries.length ? entries[i + 1].startTime : now;
+        foregroundTime += end - entries[i].startTime;
+      }
+    }
+    return foregroundTime;
+  };
+})();
