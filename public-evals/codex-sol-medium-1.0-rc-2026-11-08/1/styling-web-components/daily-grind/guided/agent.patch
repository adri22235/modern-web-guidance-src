+  <!--
+    drink-card API: title, description and action slots; body, content and actions
+    parts. Public --drink-card-* tokens may be set on a host or any ancestor.
+    Site tokens (--primary, --text, --accent, --secondary, --surface, --light)
+    and typography inherit through the shadow boundary. No ancestor selectors needed.
+  -->
+  <template id="drink-card-template">
+    <style>
+      @layer reset, base, variants, layout;
+
+      @layer reset {
+        :host, article, div, footer {
+          box-sizing: border-box;
+        }
+
+        article, footer {
+          margin: 0;
+          padding: 0;
+        }
+      }
+
+      @layer base {
+        :host {
+          /* Leave public tokens unset so ancestor overrides can inherit. */
+          --_surface: var(--drink-card-surface, var(--surface, #fff));
+          --_text: var(--drink-card-text, var(--text, #3e2723));
+          --_primary: var(--drink-card-primary, var(--primary, #4e342e));
+          --_accent: var(--drink-card-accent, var(--accent, #ffab40));
+          display: block;
+          min-inline-size: 0;
+          container: drink-card / inline-size;
+          padding: var(--drink-card-padding, 20px);
+          border: 1px solid transparent;
+          border-radius: var(--drink-card-radius, 8px);
+          background: var(--_surface);
+          color: var(--_text);
+          box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+          font: inherit;
+          text-align: center;
+        }
+
+        .card {
+          display: grid;
+          gap: 15px;
+          overflow-wrap: anywhere;
+        }
+
+        .content {
+          display: grid;
+          gap: 10px;
+          min-inline-size: 0;
+        }
+
+        slot {
+          display: block;
+        }
+
+        ::slotted(*) {
+          box-sizing: border-box;
+          margin: 0;
+        }
+
+        ::slotted([slot="title"]) {
+          color: var(--_primary);
+        }
+
+        ::slotted(a[slot="action"]) {
+          display: inline-block;
+          padding: 10px 20px;
+          border-radius: 5px;
+          background: var(--_primary);
+          color: var(--light, #fafafa);
+          font: inherit;
+          text-decoration: none;
+        }
+
+        ::slotted(a[slot="action"]:hover) {
+          background: var(--_text);
+          text-decoration: underline;
+        }
+
+        ::slotted(a[slot="action"]:focus-visible) {
+          outline: 3px solid var(--_accent);
+          outline-offset: 3px;
+        }
+      }
+
+      @layer variants {
+        :host([variant="featured"]) {
+          border-block-start: 4px solid var(--_accent);
+        }
+
+        :host([variant="compact"]) {
+          padding: var(--drink-card-padding, 15px);
+          box-shadow: none;
+          border-color: var(--secondary, #d7ccc8);
+        }
+      }
+
+      @layer layout {
+        /* Query the host's width, changing descendants rather than the host. */
+        @container drink-card (max-width: 18rem) {
+          ::slotted(a[slot="action"]) {
+            inline-size: 100%;
+          }
+        }
+
+        @container drink-card (min-width: 30rem) {
+          .card {
+            grid-template-columns: minmax(0, 1fr) auto;
+            align-items: center;
+            gap: 24px;
+            text-align: start;
+          }
+        }
+      }
+    </style>
+    <article class="card" part="body">
+      <div class="content" part="content">
+        <slot name="title"></slot>
+        <slot name="description"></slot>
+      </div>
+      <footer part="actions">
+        <slot name="action"></slot>
+      </footer>
+    </article>
+  </template>
+  <script type="module">
+    const drinkCardTemplate = document.getElementById('drink-card-template');
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+        root.append(drinkCardTemplate.content.cloneNode(true));
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
