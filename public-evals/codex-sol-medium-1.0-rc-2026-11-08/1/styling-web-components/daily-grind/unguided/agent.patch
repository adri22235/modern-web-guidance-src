+  <template id="drink-card-template">
+    <style>
+      /* Later tiers win: reset < base < variants < responsive. */
+      @layer reset, base, variants, responsive;
+
+      @layer reset {
+        :host, *, *::before, *::after {
+          box-sizing: border-box;
+        }
+
+        ::slotted(*) {
+          margin: 0;
+        }
+      }
+
+      @layer base {
+        :host {
+          display: block;
+          min-width: 0;
+          container: drink-card / inline-size;
+          font: inherit;
+          color: var(--text, #3e2723);
+          background: var(--drink-card-background, white);
+          border: 1px solid transparent;
+          border-radius: var(--drink-card-radius, 8px);
+          box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+          --card-padding: 20px;
+          --card-gap: 15px;
+        }
+
+        .surface {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: var(--card-gap);
+          height: 100%;
+          padding: var(--card-padding);
+          border-radius: inherit;
+          text-align: center;
+        }
+
+        .content {
+          min-width: 0;
+          overflow-wrap: anywhere;
+        }
+
+        .heading {
+          margin-bottom: 10px;
+          color: var(--primary, #4e342e);
+        }
+
+        .actions {
+          margin-top: auto;
+        }
+
+        ::slotted([slot="title"]) {
+          font-size: 1.2rem;
+          line-height: 1.4;
+        }
+
+        ::slotted([slot="action"]) {
+          max-width: 100%;
+          overflow-wrap: anywhere;
+        }
+      }
+
+      @layer variants {
+        /* Host selectors style the component's own outer box. */
+        :host([variant="featured"]) {
+          border-color: var(--secondary, #d7ccc8);
+          box-shadow: 0 4px 12px rgb(78 52 46 / 0.15);
+        }
+
+        :host([variant="compact"]) {
+          --card-padding: 16px;
+          --card-gap: 12px;
+          background: var(--secondary, #d7ccc8);
+          box-shadow: none;
+        }
+      }
+
+      @layer responsive {
+        /* Query the host's width; only its descendants change layout. */
+        @container drink-card (max-width: 18rem) {
+          .surface {
+            padding: 14px;
+            gap: 12px;
+          }
+
+          .actions {
+            width: 100%;
+          }
+
+          ::slotted([slot="action"]) {
+            display: block;
+          }
+        }
+
+        @container drink-card (min-width: 28rem) {
+          .surface {
+            flex-direction: row;
+            justify-content: space-between;
+            text-align: left;
+            gap: 24px;
+          }
+
+          .content {
+            flex: 1;
+          }
+
+          .actions {
+            flex-shrink: 0;
+            margin-top: 0;
+          }
+        }
+      }
+    </style>
+    <article class="surface" part="surface">
+      <div class="content" part="content">
+        <div class="heading" part="heading"><slot name="title"></slot></div>
+        <slot name="description"></slot>
+        <slot></slot>
+      </div>
+      <div class="actions" part="actions"><slot name="action"></slot></div>
+    </article>
+  </template>
+  <script type="module">
+    const drinkCardTemplate = document.getElementById('drink-card-template');
+
+    class DrinkCard extends HTMLElement {
