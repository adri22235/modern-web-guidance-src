+  <dialog id="logout-dialog" class="overlay" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" class="close-button" id="close-dialog-btn" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your Daily Grind account?</p>
+    <form method="dialog" class="dialog-actions">
+      <button class="btn btn-secondary" value="cancel" autofocus>Stay signed in</button>
+      <button class="btn" value="confirm">Log out</button>
+    </form>
+  </dialog>
+
+  <aside id="info-notice" class="overlay notice" popover="manual" aria-label="Coffee information">
+    <strong>A little extra coffee knowledge</strong>
+    <p>Our cold brew is steeped for 18 hours for a smooth, refreshing cup.</p>
+    <button type="button" class="close-button" id="close-notice-btn" aria-label="Dismiss information" popovertarget="info-notice" popovertargetaction="hide">&times;</button>
+  </aside>
+  <div id="notice-status" class="visually-hidden" role="status" aria-atomic="true"></div>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const dialog = document.getElementById('logout-dialog');
+    const notice = document.getElementById('info-notice');
+    const noticeButton = document.getElementById('foobar');
+    const noticeStatus = document.getElementById('notice-status');
+    const supportsPopover = Object.hasOwn(HTMLElement.prototype, 'popover');
+
+    if (!supportsPopover) notice.hidden = true;
+
+    // Keep overlays open until their exit animations settle, including browsers
+    // that cannot transition display or retain the native top layer on exit.
+    async function dismiss(element, close) {
+      if (element.hasAttribute('data-closing')) return;
+      element.setAttribute('data-closing', '');
+      getComputedStyle(element).opacity;
+      const animations = element.getAnimations({ subtree: true });
+      await Promise.race([
+        Promise.allSettled(animations.map((animation) => animation.finished)),
+        new Promise((resolve) => setTimeout(resolve, 1000)),
+      ]);
+      close();
+      element.removeAttribute('data-closing');
+    }
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (!dialog.open) dialog.showModal();
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', () => {
+      dismiss(dialog, () => dialog.close());
+    });
+
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      dismiss(dialog, () => dialog.close());
+    });
+
+    dialog.querySelector('form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const confirmed = event.submitter?.value === 'confirm';
+      dismiss(dialog, () => {
+        dialog.close();
+        if (confirmed) window.location.assign(logoutLink.href);
+      });
+    });
+
+    noticeButton.addEventListener('click', () => {
+      if (notice.hasAttribute('data-closing')) return;
+      if (supportsPopover) {
+        notice.showPopover();
+      } else {
+        notice.hidden = false;
+        notice.setAttribute('data-fallback-open', '');
+      }
+      noticeStatus.textContent = notice.querySelector('p').textContent;
+    });
+
+    document.getElementById('close-notice-btn').addEventListener('click', (event) => {
+      // Delay the native popovertarget action so the exit transition can finish.
+      event.preventDefault();
+      const restoreFocus = notice.contains(document.activeElement);
+      dismiss(notice, () => {
+        if (supportsPopover) {
+          notice.hidePopover();
+        } else {
+          notice.hidden = true;
+          notice.removeAttribute('data-fallback-open');
+        }
+        noticeStatus.textContent = '';
+        if (restoreFocus) noticeButton.focus();
+      });
+    });
+  </script>
+
