+  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" class="close-button" id="close-dialog-btn" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Ready to log out?</h2>
+    <p id="logout-description">You’ll need to sign in again to access your account and rewards.</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout-btn" autofocus>Stay signed in</button>
+      <a href="/logout" class="btn">Yes, log out</a>
+    </div>
+  </dialog>
+
+  <aside class="floating-notice" id="info-notice" aria-label="Coffee tip" hidden>
+    <button type="button" class="close-button" id="dismiss-notice-btn" aria-label="Dismiss coffee tip">&times;</button>
+    <strong>A little tip for your daily grind</strong>
+    <p>Keep your beans in an airtight container to enjoy a fresher cup every morning.</p>
+  </aside>
+  <div id="notice-announcement" role="status" aria-atomic="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);"></div>
+
+  <script>
+    const dialog = document.getElementById('logout-dialog');
+    const openDialogButton = document.getElementById('open-dialog-btn');
+    const notice = document.getElementById('info-notice');
+    const noticeButton = document.getElementById('foobar');
+    const announcement = document.getElementById('notice-announcement');
+    const animations = new WeakMap();
+    let dialogClosing = false;
+
+    async function animateVisibility(element, visible) {
+      // Preserve the current frame when a dismissal is interrupted by reopening.
+      const current = getComputedStyle(element);
+      const from = element.hidden || (element === dialog && !animations.has(element))
+        ? { opacity: 0, transform: 'translateY(16px)' }
+        : { opacity: current.opacity, transform: current.transform };
+      animations.get(element)?.cancel();
+      element.hidden = false;
+      const animation = element.animate([
+        from,
+        { opacity: visible ? 1 : 0, transform: visible ? 'translateY(0)' : 'translateY(16px)' }
+      ], {
+        duration: matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 220,
+        easing: visible ? 'ease-out' : 'ease-in',
+        fill: 'both'
+      });
+      animations.set(element, animation);
+      try {
+        await animation.finished;
+        return animations.get(element) === animation;
+      } catch {
+        return false;
+      }
+    }
+
+    openDialogButton.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (dialog.open) return;
+      dialog.classList.remove('is-closing');
+      animations.get(dialog)?.cancel();
+      animations.delete(dialog);
+      dialog.showModal();
+      animateVisibility(dialog, true);
+    });
+
+    async function closeDialog() {
+      if (!dialog.open || dialogClosing) return;
+      dialogClosing = true;
+      dialog.classList.add('is-closing');
+      await animateVisibility(dialog, false);
+      dialog.close();
+      dialogClosing = false;
+      openDialogButton.focus();
+    }
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeDialog);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeDialog);
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      closeDialog();
+    });
+
+    noticeButton.addEventListener('click', () => {
+      animateVisibility(notice, true);
+      announcement.textContent = notice.querySelector('p').textContent;
+    });
+
+    document.getElementById('dismiss-notice-btn').addEventListener('click', async () => {
+      if (await animateVisibility(notice, false)) {
+        notice.hidden = true;
+        announcement.textContent = '';
+        if (notice.contains(document.activeElement)) noticeButton.focus();
+      }
+    });
+  </script>
+
