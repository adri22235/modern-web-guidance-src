+  <script>
+    const copyStatus = document.getElementById('copy-status');
+
+    document.querySelectorAll('[data-copy-target]').forEach((button) => {
+      button.addEventListener('click', async () => {
+        const target = document.getElementById(button.dataset.copyTarget);
+        const drinkName = button.closest('.card').querySelector('h3').textContent.trim();
+        button.disabled = true;
+        copyStatus.textContent = '';
+
+        try {
+          await navigator.clipboard.writeText(target.textContent.trim());
+          copyStatus.textContent = `${drinkName} description copied!`;
+        } catch (error) {
+          copyStatus.textContent = `Could not copy ${drinkName} description. Please select and copy the description manually.`;
+        } finally {
+          button.disabled = false;
+        }
+      });
+    });
+  </script>
