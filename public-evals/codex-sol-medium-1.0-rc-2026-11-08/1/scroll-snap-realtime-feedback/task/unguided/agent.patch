+  <script>
+    (() => {
+      const gallery = document.getElementById('gallery');
+      const slides = [...gallery.querySelectorAll('.gallery-item')];
+      const indicators = [...document.querySelectorAll('.gallery-indicator')];
+      const status = document.getElementById('gallery-status');
+      const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+      let activeIndex = 0;
+      let pendingIndex = null;
+      let settleTimer;
+
+      function setPending(index) {
+        pendingIndex = index;
+        indicators.forEach((button, i) => button.classList.toggle('pending', i === index));
+      }
+
+      function nearestIndex() {
+        const bounds = gallery.getBoundingClientRect();
+        const center = bounds.left + gallery.clientWidth / 2;
+        let nearest = 0;
+        let distance = Infinity;
+        slides.forEach((slide, index) => {
+          const rect = slide.getBoundingClientRect();
+          const delta = Math.abs(rect.left + rect.width / 2 - center);
+          if (delta < distance) {
+            distance = delta;
+            nearest = index;
+          }
+        });
+        return nearest;
+      }
+
+      function settle(index = nearestIndex()) {
+        clearTimeout(settleTimer);
+        activeIndex = index;
+        setPending(null);
+        indicators.forEach((button, i) => {
+          button.classList.toggle('active', i === index);
+          if (i === index) button.setAttribute('aria-current', 'true');
+          else button.removeAttribute('aria-current');
+        });
+        status.textContent = `Photo ${index + 1} of ${slides.length}: ${slides[index].querySelector('h3').textContent}`;
+      }
+
+      function goTo(index) {
+        setPending(index);
+        const bounds = gallery.getBoundingClientRect();
+        const target = slides[index].getBoundingClientRect();
+        gallery.scrollTo({
+          left: gallery.scrollLeft + target.left - bounds.left,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+        // Also settle when selecting the current slide produces no scroll event.
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(() => settle(), 200);
+      }
+
+      indicators.forEach((button, index) => {
+        button.addEventListener('click', () => goTo(index));
+      });
+
+      gallery.addEventListener('keydown', (event) => {
+        const current = pendingIndex ?? activeIndex;
+        let next;
+        if (event.key === 'ArrowRight') next = Math.min(current + 1, slides.length - 1);
+        else if (event.key === 'ArrowLeft') next = Math.max(current - 1, 0);
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = slides.length - 1;
+        else return;
+        event.preventDefault();
+        goTo(next);
+      });
+
+      // Native snap events preview the browser's intended target, then commit it.
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const index = slides.indexOf(event.snapTargetInline);
+        if (index !== -1) setPending(index);
+      });
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const index = slides.indexOf(event.snapTargetInline);
+        if (index !== -1) settle(index);
+      });
+
+      gallery.addEventListener('scroll', () => {
+        if (!supportsSnapChanging) setPending(nearestIndex());
+        // Debounce provides settle detection in browsers without scrollend.
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(() => settle(), 200);
+      }, { passive: true });
+      if ('onscrollend' in gallery) {
+        gallery.addEventListener('scrollend', () => settle());
+      }
+    })();
+  </script>
+
