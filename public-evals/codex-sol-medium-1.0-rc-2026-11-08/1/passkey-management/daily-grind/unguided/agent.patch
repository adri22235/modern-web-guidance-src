@@ -0,0 +1,94 @@
+// The API is opt-in: a static preview must never touch real authenticators.
+export const STORAGE_KEY = 'daily-grind.passkeys.preview.v1';
+const demoKeys = [
+  { id: 'demo-laptop', name: 'MacBook Air', device: 'laptop', provider: 'iCloud Keychain', createdAt: '2026-10-12', lastUsedAt: '2026-11-08', current: true },
+  { id: 'demo-phone', name: 'iPhone 15', device: 'phone', provider: 'iCloud Keychain', createdAt: '2026-10-12', lastUsedAt: '2026-11-07' },
+  { id: 'demo-security-key', name: 'YubiKey 5 NFC', device: 'usb', provider: 'Security key', createdAt: '2026-09-24', lastUsedAt: '2026-10-29' },
+];
+export function validateName(value) {
+  const name = String(value ?? '').trim();
+  if (!name || name.length > 60) throw new Error('Enter a name between 1 and 60 characters.');
+  return name;
+}
+export function validateSnapshot(value, live = false) {
+  if (!value || !Array.isArray(value.passkeys)) throw new Error('Unable to read your passkeys. Please try again.');
+  const ids = new Set();
+  for (const key of value.passkeys) {
+    if (!key || typeof key.id !== 'string' || !key.id || ids.has(key.id) || typeof key.name !== 'string') throw new Error('Invalid passkey data. Please try again.');
+    validateName(key.name);
+    if (live && (typeof key.credentialId !== 'string' || !/^[A-Za-z0-9_-]+$/.test(key.credentialId))) throw new Error('Invalid credential data. Please try again.');
+    ids.add(key.id);
+  }
+  if (live && (typeof value.rpId !== 'string' || !value.rpId || typeof value.userId !== 'string' || !/^[A-Za-z0-9_-]+$/.test(value.userId) || typeof value.csrfToken !== 'string' || !value.csrfToken)) throw new Error('Incomplete account data. Please try again.');
+  return value;
+}
+export function createDemoStore(storage) {
+  let snapshot;
+  try {
+    const saved = storage.getItem(STORAGE_KEY);
+    snapshot = saved === null ? { passkeys: structuredClone(demoKeys) } : validateSnapshot(JSON.parse(saved));
+  } catch { snapshot = { passkeys: structuredClone(demoKeys) }; }
+  return {
+    demo: true,
+    async list() { return structuredClone(snapshot); },
+    async mutate(id, name) {
+      const keys = structuredClone(snapshot.passkeys);
+      const index = keys.findIndex(key => key.id === id);
+      if (index < 0) throw new Error('This passkey no longer exists. Refresh the page.');
+      if (name === undefined) keys.splice(index, 1);
+      else keys[index].name = validateName(name);
+      const next = { passkeys: keys };
+      try { storage.setItem(STORAGE_KEY, JSON.stringify(next)); }
+      catch { throw new Error('Your browser could not save the change. Allow site storage and try again.'); }
+      snapshot = next;
+      return structuredClone(snapshot);
+    },
+  };
+}
+export function createApiStore(base, fetcher = globalThis.fetch, origin = globalThis.location.origin) {
+  const endpoint = new URL(base, origin);
+  if (endpoint.origin !== origin || endpoint.search || endpoint.hash) throw new Error('Passkey API must use a same-origin URL.');
+  let csrfToken;
+  async function request(path = '', options = {}) {
+    const response = await fetcher(endpoint.href.replace(/\/$/, '') + path, {
+      ...options, credentials: 'same-origin', cache: 'no-store',
+      headers: { Accept: 'application/json', ...(options.method ? { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken } : {}) },
+    });
+    if (response.status === 401) {
+      const error = new Error('Your session has expired. Please sign in again to manage passkeys.');
+      error.authenticationRequired = true;
+      throw error;
+    }
+    if (response.status === 409) throw new Error('Your account changed. Refresh your passkeys and try again.');
+    if (!response.ok) throw new Error('We couldn’t save or load your passkeys. Please try again.');
+    const snapshot = validateSnapshot(await response.json(), true);
+    csrfToken = snapshot.csrfToken;
+    return snapshot;
+  }
+  return {
+    demo: false,
+    list: () => request(),
+    mutate: (id, name) => {
+      if (!csrfToken) throw new Error('Reload your account before making changes.');
+      return request('/' + encodeURIComponent(id), { method: name === undefined ? 'DELETE' : 'PATCH', ...(name === undefined ? {} : { body: JSON.stringify({ name: validateName(name) }) }) });
+    },
+  };
+}
+// Only call with a complete, authenticated server snapshot, never a filtered list.
+// W3C: https://www.w3.org/TR/webauthn/#sctn-signalAllAcceptedCredentials
+export async function synchronize(snapshot, { demo, removed, credentialApi = globalThis.PublicKeyCredential, secure = globalThis.isSecureContext } = {}) {
+  if (demo) return 'preview';
+  if (!secure || !credentialApi) return 'unsupported';
+  try {
+    if (typeof credentialApi.signalAllAcceptedCredentials === 'function') {
+      validateSnapshot(snapshot, true);
+      await credentialApi.signalAllAcceptedCredentials({ rpId: snapshot.rpId, userId: snapshot.userId, allAcceptedCredentialIds: snapshot.passkeys.map(key => key.credentialId) });
+      return 'signaled';
+    }
+    if (removed && typeof credentialApi.signalUnknownCredential === 'function') {
+      await credentialApi.signalUnknownCredential({ rpId: snapshot.rpId, credentialId: removed.credentialId });
+      return 'signaled';
+    }
+    return 'unsupported';
+  } catch { return 'failed'; }
+}
