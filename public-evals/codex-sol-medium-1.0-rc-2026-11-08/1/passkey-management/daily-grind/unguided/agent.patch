diff --git a/tests/passkeys.test.mjs b/tests/passkeys.test.mjs
new file mode 100644
index 0000000..0232f34
--- /dev/null
+++ b/tests/passkeys.test.mjs
@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createDemoStore, createApiStore, synchronize, validateName, STORAGE_KEY } from '../passkeys.mjs';
+
+function memoryStorage() {
+  const values = new Map();
+  return { getItem: key => values.get(key) ?? null, setItem: (key, value) => values.set(key, value) };
+}
+const liveSnapshot = () => ({ rpId: 'coffee.example', userId: 'dXNlcg', csrfToken: 'csrf-token', passkeys: [{ id: 'record/1', credentialId: 'a2V5', name: 'Laptop' }] });
+
+test('demo rename persists and preserves identity and other records', async () => {
+  const storage = memoryStorage();
+  const store = createDemoStore(storage);
+  const before = await store.list();
+  const key = before.passkeys[0];
+  await store.mutate(key.id, '  Home laptop  ');
+  const after = await createDemoStore(storage).list();
+  assert.equal(after.passkeys[0].name, 'Home laptop');
+  assert.equal(after.passkeys[0].id, key.id);
+  assert.deepEqual(after.passkeys.slice(1), before.passkeys.slice(1));
+});
+test('deleting every key persists an empty account instead of reseeding it', async () => {
+  const storage = memoryStorage();
+  const store = createDemoStore(storage);
+  for (const key of (await store.list()).passkeys) await store.mutate(key.id);
+  assert.deepEqual((await createDemoStore(storage).list()).passkeys, []);
+});
+test('failed storage writes do not change visible demo state', async () => {
+  const store = createDemoStore({ getItem: () => null, setItem: () => { throw new Error('quota'); } });
+  const before = await store.list();
+  await assert.rejects(store.mutate(before.passkeys[0].id), /could not save/);
+  assert.deepEqual(await store.list(), before);
+});
+test('invalid local data recovers safely', async () => {
+  for (const raw of ['not json', '{}', '{"passkeys":[null]}']) {
+    const storage = memoryStorage();
+    storage.setItem(STORAGE_KEY, raw);
+    assert.equal((await createDemoStore(storage).list()).passkeys.length, 3);
+  }
+});
+test('blank and overlong names are rejected', () => {
+  assert.throws(() => validateName('   '));
+  assert.throws(() => validateName('a'.repeat(61)));
+  assert.equal(validateName(' Kitchen laptop '), 'Kitchen laptop');
+});
+test('demo never signals even if authenticator APIs are available', async () => {
+  const credentialApi = { signalAllAcceptedCredentials() { assert.fail('Real authenticator touched by preview'); } };
+  assert.equal(await synchronize(liveSnapshot(), { demo: true, credentialApi, secure: true }), 'preview');
+});
+test('authenticated complete-list synchronization also sends an empty list', async () => {
+  const calls = [];
+  const credentialApi = { async signalAllAcceptedCredentials(value) { calls.push(value); } };
+  const snapshot = liveSnapshot();
+  assert.equal(await synchronize(snapshot, { credentialApi, secure: true }), 'signaled');
+  snapshot.passkeys = [];
+  await synchronize(snapshot, { credentialApi, secure: true });
+  assert.deepEqual(calls, [
+    { rpId: 'coffee.example', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5'] },
+    { rpId: 'coffee.example', userId: 'dXNlcg', allAcceptedCredentialIds: [] },
+  ]);
+});
+test('unknown-credential fallback only signals a confirmed removed key', async () => {
+  const calls = [];
+  const credentialApi = { async signalUnknownCredential(value) { calls.push(value); } };
+  const snapshot = liveSnapshot();
+  assert.equal(await synchronize(snapshot, { credentialApi, secure: true }), 'unsupported');
+  await synchronize(snapshot, { removed: snapshot.passkeys[0], credentialApi, secure: true });
+  assert.deepEqual(calls, [{ rpId: 'coffee.example', credentialId: 'a2V5' }]);
+});
+test('unsupported, insecure and failed signals have distinct outcomes', async () => {
+  const credentialApi = { async signalAllAcceptedCredentials() { throw new Error('Browser refused'); } };
+  assert.equal(await synchronize(liveSnapshot(), { credentialApi, secure: true }), 'failed');
+  assert.equal(await synchronize(liveSnapshot(), { credentialApi, secure: false }), 'unsupported');
+  assert.equal(await synchronize(liveSnapshot(), { credentialApi: {}, secure: true }), 'unsupported');
+});
+test('malformed live data never gets sent to authenticator', async () => {
+  const credentialApi = { signalAllAcceptedCredentials() { assert.fail('Invalid snapshot sent'); } };
+  assert.equal(await synchronize({ passkeys: [] }, { credentialApi, secure: true }), 'failed');
+});
+test('live requests use session cookies, CSRF token, encoded IDs, and server snapshots', async () => {
+  const calls = [];
+  const snapshot = liveSnapshot();
+  const store = createApiStore('/api/account/passkeys', async (url, options) => {
+    calls.push({ url, options });
+    return { ok: true, status: 200, json: async () => structuredClone(snapshot) };
+  }, 'https://coffee.example');
+  await store.list();
+  await store.mutate('record/1', 'Work laptop');
+  await store.mutate('record/1');
+  assert.equal(calls[1].url, 'https://coffee.example/api/account/passkeys/record%2F1');
+  assert.equal(calls[1].options.method, 'PATCH');
+  assert.equal(calls[1].options.headers['X-CSRF-Token'], 'csrf-token');
+  assert.deepEqual(JSON.parse(calls[1].options.body), { name: 'Work laptop' });
+  assert.equal(calls[2].options.method, 'DELETE');
+  assert.equal(calls[2].options.credentials, 'same-origin');
+  assert.equal(calls[2].options.cache, 'no-store');
+});
+test('expired sessions are identified, and live errors never become demo data', async () => {
+  const store = createApiStore('/api/account/passkeys', async () => ({ ok: false, status: 401 }), 'https://coffee.example');
+  await assert.rejects(store.list(), error => error.authenticationRequired === true);
+  assert.equal(store.demo, false);
+});
+test('cross-origin APIs are refused and failed server mutations do not signal', async () => {
+  assert.throws(() => createApiStore('https://other.example/api', () => {}, 'https://coffee.example'), /same-origin/);
+  let count = 0;
+  const store = createApiStore('/api/account/passkeys', async () => {
+    count++;
+    return count === 1 ? { ok: true, json: async () => liveSnapshot() } : { ok: false, status: 500 };
+  }, 'https://coffee.example');
+  await store.list();
+  await assert.rejects(store.mutate('record/1'), /couldn’t save/);
+});
