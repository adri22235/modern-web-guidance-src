new file mode 100644
index 0000000..5b04f2b
--- /dev/null
+++ b/account.js
@@ -0,0 +1,194 @@
+import { createDemoStore, createApiStore, synchronize, validateName } from './passkeys.mjs';
+
+const $ = selector => document.querySelector(selector);
+const list = $('#passkey-list');
+const dialog = $('#key-dialog');
+const form = $('#key-form');
+const nameInput = $('#key-name');
+const status = $('#status');
+const confirmButton = $('#confirm-dialog');
+const cancelButton = $('#cancel-dialog');
+let store, snapshot, selected, operation, busy = false, returnFocus, pendingSync;
+
+function icon(name, className = '') {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('aria-hidden', 'true');
+  if (className) svg.setAttribute('class', className);
+  const use = document.createElementNS(svg.namespaceURI, 'use');
+  use.setAttribute('href', '#' + name);
+  svg.append(use);
+  return svg;
+}
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function notify(message, error = false, retry) {
+  status.replaceChildren(document.createTextNode(message));
+  status.classList.toggle('error', error);
+  status.hidden = false;
+  if (retry) {
+    const button = element('button', 'retry-button', 'Try again');
+    button.type = 'button';
+    button.addEventListener('click', retry);
+    status.append(document.createTextNode(' '), button);
+  }
+}
+function dateLabel(value) {
+  if (!value) return 'Not used yet';
+  const date = new Date(value);
+  return Number.isNaN(date.valueOf()) ? 'Date unavailable' : new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(date);
+}
+function render() {
+  list.replaceChildren();
+  list.setAttribute('aria-busy', 'false');
+  $('#key-count').textContent = snapshot.passkeys.length;
+  if (!snapshot.passkeys.length) {
+    const empty = element('div', 'empty-state');
+    empty.append(icon('key'), element('h4', '', 'No passkeys connected'), element('p', '', 'Your registered passkeys will appear here once you add one during sign-in.'));
+    list.append(empty);
+    return;
+  }
+  for (const key of snapshot.passkeys) {
+    const row = element('div', 'passkey-row');
+    const device = element('div', 'device-icon');
+    device.append(icon(['phone', 'laptop', 'usb'].includes(key.device) ? key.device : 'key'));
+    const details = element('div', 'key-details');
+    const title = element('div', 'key-name-line');
+    title.append(element('span', 'key-name', key.name));
+    if (key.current) title.append(element('span', 'device-badge', 'Used for this sign-in'));
+    const metadata = element('div', 'key-meta');
+    metadata.append(element('span', '', key.provider || 'Passkey'), element('span', '', '·'), element('span', '', key.lastUsedAt ? 'Last used ' + dateLabel(key.lastUsedAt) : 'Not used yet'));
+    details.append(title, metadata);
+    if (key.createdAt) details.title = 'Added ' + dateLabel(key.createdAt);
+    const actions = element('div', 'row-actions');
+    const rename = element('button', 'rename-button');
+    rename.type = 'button';
+    rename.setAttribute('aria-label', 'Rename ' + key.name);
+    rename.append(icon('edit'), document.createTextNode('Rename'));
+    rename.addEventListener('click', () => openDialog(key, 'rename', rename));
+    const remove = element('button', 'delete-button');
+    remove.type = 'button';
+    remove.setAttribute('aria-label', 'Remove ' + key.name);
+    remove.title = 'Remove passkey';
+    remove.append(icon('trash'));
+    remove.addEventListener('click', () => openDialog(key, 'delete', remove));
+    actions.append(rename, remove);
+    row.append(device, details, actions);
+    list.append(row);
+  }
+}
+function openDialog(key, action, trigger) {
+  selected = key;
+  operation = action;
+  returnFocus = trigger;
+  const deleting = action === 'delete';
+  $('#dialog-title').textContent = deleting ? 'Remove this passkey?' : 'Make it easy to recognize.';
+  $('#dialog-description').textContent = deleting ? `“${key.name}” will no longer be able to sign in to your account. This can’t be undone.` : 'Give this passkey a familiar name. Only its label in your Daily Grind account will change.';
+  $('#name-field').hidden = deleting;
+  nameInput.disabled = deleting;
+  nameInput.value = key.name;
+  nameInput.setCustomValidity('');
+  $('#last-key-warning').hidden = !deleting || snapshot.passkeys.length !== 1;
+  $('#dialog-error').hidden = true;
+  confirmButton.classList.toggle('danger', deleting);
+  confirmButton.textContent = deleting ? 'Remove passkey' : 'Save name';
+  dialog.showModal();
+  if (deleting) cancelButton.focus();
+  else { nameInput.focus(); nameInput.select(); }
+}
+function setBusy(value) {
+  busy = value;
+  confirmButton.disabled = value;
+  cancelButton.disabled = value;
+  nameInput.readOnly = value;
+  form.setAttribute('aria-busy', String(value));
+}
+cancelButton.addEventListener('click', () => dialog.close());
+dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+dialog.addEventListener('close', () => {
+  if (returnFocus?.isConnected) returnFocus.focus();
+  else { $('#security-title').tabIndex = -1; $('#security-title').focus({ preventScroll: true }); }
+});
+nameInput.addEventListener('input', () => nameInput.setCustomValidity(''));
+async function reportSync(removed) {
+  pendingSync = removed;
+  const result = await synchronize(snapshot, { demo: store.demo, removed });
+  if (result === 'preview') { pendingSync = undefined; return; }
+  if (result === 'signaled') {
+    pendingSync = undefined;
+    if (removed) notify('Passkey removed. Your browser has been asked to update your authenticator.');
+  } else if (removed || result === 'failed') {
+    const message = 'Your account is up to date. ' + (result === 'unsupported' ? 'This browser can’t update your authenticator automatically. Remove the old entry in your device’s password manager.' : 'We couldn’t notify your authenticator. You can retry or remove the old entry in your device’s password manager.');
+    notify(message, false, result === 'failed' ? retrySync : undefined);
+  }
+}
+async function retrySync() {
+  const removed = pendingSync;
+  // Refresh the full authenticated list before retrying; never send a stale snapshot.
+  try { snapshot = await store.list(); render(); await reportSync(removed); }
+  catch (error) { handleError(error); }
+}
+function handleError(error) {
+  if (error.authenticationRequired) {
+    snapshot = undefined;
+    list.replaceChildren();
+    $('#key-count').textContent = '—';
+    const link = element('a', 'button', 'Sign in again');
+    link.href = '/login?returnTo=%2Faccount';
+    list.append(link);
+    list.setAttribute('aria-busy', 'false');
+    notify(error.message, true);
+    if (dialog.open) dialog.close();
+  } else notify(error.message || 'Something went wrong. Please try again.', true, load);
+}
+form.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  const deleting = operation === 'delete';
+  let name;
+  try { if (!deleting) name = validateName(nameInput.value); }
+  catch (error) { nameInput.setCustomValidity(error.message); nameInput.reportValidity(); return; }
+  if (!deleting && name === selected.name) { dialog.close(); return; }
+  setBusy(true);
+  confirmButton.textContent = deleting ? 'Removing…' : 'Saving…';
+  const removed = deleting ? selected : undefined;
+  try {
+    snapshot = await store.mutate(selected.id, name);
+    render();
+    dialog.close();
+    notify(deleting ? (store.demo ? 'Passkey removed from this preview account.' : 'Passkey removed from your account.') : `Passkey renamed to “${name}”.`);
+    if (deleting) await reportSync(removed);
+  } catch (error) {
+    if (error.authenticationRequired) handleError(error);
+    else {
+      $('#dialog-error').textContent = error.message || 'We couldn’t save your change. Please try again.';
+      $('#dialog-error').hidden = false;
+    }
+  } finally {
+    setBusy(false);
+    confirmButton.textContent = deleting ? 'Remove passkey' : 'Save name';
+  }
+});
+async function load() {
+  status.hidden = true;
+  list.setAttribute('aria-busy', 'true');
+  try {
+    snapshot = await store.list();
+    render();
+    await reportSync();
+  } catch (error) { list.setAttribute('aria-busy', 'false'); handleError(error); }
+}
+try {
+  const endpoint = document.querySelector('meta[name="passkey-api"]')?.content;
+  // No silent demo fallback if a real account API is configured but unavailable.
+  store = endpoint ? createApiStore(endpoint) : createDemoStore({
+    getItem: key => localStorage.getItem(key),
+    setItem: (key, value) => localStorage.setItem(key, value),
+  });
+  $('#preview-badge').hidden = !store.demo;
+  $('#preview-note').hidden = !store.demo;
+  await load();
+} catch (error) { handleError(error); }
