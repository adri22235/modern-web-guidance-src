index 0000000..490bf24
--- /dev/null
+++ b/account.mjs
@@ -0,0 +1,223 @@
+import {
+  createPasskeyApi,
+  providerFor,
+  syncAcceptedCredentials,
+  validateName,
+} from "./passkey-api.mjs";
+
+const $ = (id) => document.getElementById(id);
+const preview = document.body.dataset.accountMode === "preview";
+let storage;
+try {
+  storage = window.localStorage;
+} catch {
+  /* Memory-only preview if browser storage is disabled. */
+}
+const api = createPasskeyApi({ preview, storage });
+let snapshot;
+let selectedId;
+let busy = false;
+const dateFormatter = new Intl.DateTimeFormat(undefined, {
+  month: "short",
+  day: "numeric",
+  year: "numeric",
+});
+
+function element(tag, className, text) {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+function icon(name) {
+  const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
+  svg.setAttribute("aria-hidden", "true");
+  const use = document.createElementNS("http://www.w3.org/2000/svg", "use");
+  use.setAttribute("href", `#icon-${name}`);
+  svg.append(use);
+  return svg;
+}
+function dateNode(label, epoch) {
+  const span = element("span", "", label);
+  const time = element("time", "", dateFormatter.format(epoch));
+  time.dateTime = new Date(epoch).toISOString();
+  span.append(time);
+  return span;
+}
+function render() {
+  const rows = snapshot.credentials.map((key) => {
+    const provider = providerFor(key.aaguid);
+    const row = element("li", "passkey-row");
+    const providerIcon = element("span", `provider-icon ${provider.style}`);
+    providerIcon.append(icon(provider.icon));
+    const details = element("div", "key-details");
+    const title = element("div", "key-title");
+    title.append(element("h4", "", key.name || provider.name));
+    const dates = element("p", "key-dates");
+    dates.append(
+      dateNode("Added ", key.registeredAt),
+      element("span", "dot", "·"),
+    );
+    if (key.lastUsedAt != null)
+      dates.append(dateNode("Last used ", key.lastUsedAt));
+    else dates.append(element("span", "", "Not used yet"));
+    details.append(title, element("p", "provider-label", provider.name), dates);
+    const actions = element("div", "key-actions");
+    for (const action of ["rename", "delete"]) {
+      const label = action === "rename" ? "Rename" : "Delete";
+      const button = element("button", `${action}-button`);
+      button.type = "button";
+      button.dataset.action = action;
+      button.dataset.id = key.id;
+      button.setAttribute(
+        "aria-label",
+        `${label} ${key.name || provider.name}`,
+      );
+      button.append(
+        icon(action === "rename" ? "edit" : "trash"),
+        element("span", "", label),
+      );
+      actions.append(button);
+    }
+    row.append(providerIcon, details, actions);
+    return row;
+  });
+  $("passkey-list").replaceChildren(...rows);
+  $("passkey-list").setAttribute("aria-busy", "false");
+  $("load-state").hidden = true;
+  $("key-count").hidden = false;
+  $("key-count").textContent = snapshot.credentials.length;
+  $("empty-state").hidden = snapshot.credentials.length !== 0;
+}
+async function synchronize() {
+  const result = await syncAcceptedCredentials(
+    snapshot,
+    window.PublicKeyCredential,
+    preview,
+  );
+  $("sync-status").textContent = {
+    preview:
+      "Preview mode — your actual device and password manager are unchanged.",
+    synced:
+      "Your current passkey list has been shared with your browser’s password manager.",
+    unsupported:
+      "Your browser can’t sync passkey changes. Remove deleted keys from your password manager manually.",
+    failed:
+      "Your account is up to date. Password manager sync is unavailable; remove deleted keys there manually.",
+  }[result];
+}
+function notify(message) {
+  $("notice").textContent = message;
+  $("notice").hidden = false;
+}
+async function load() {
+  $("load-state").hidden = false;
+  $("load-state").textContent = "Loading your passkeys…";
+  $("passkey-list").setAttribute("aria-busy", "true");
+  try {
+    snapshot = await api.list();
+    render();
+    await synchronize();
+  } catch (error) {
+    $("load-state").textContent =
+      error.message || "We couldn’t load your passkeys. Please try again.";
+    const retry = element("button", "button secondary", "Try again");
+    retry.type = "button";
+    retry.addEventListener("click", load);
+    $("load-state").append(retry);
+    $("passkey-list").setAttribute("aria-busy", "false");
+  }
+}
+$("passkey-list").addEventListener("click", (event) => {
+  const button = event.target.closest("button[data-action]");
+  if (!button || busy) return;
+  const key = snapshot.credentials.find((key) => key.id === button.dataset.id);
+  if (!key) return;
+  selectedId = key.id;
+  $("notice").hidden = true;
+  if (button.dataset.action === "rename") {
+    $("passkey-name").value = key.name;
+    $("rename-error").textContent = "";
+    $("rename-dialog").showModal();
+    $("passkey-name").select();
+  } else {
+    $("delete-name").textContent = key.name || providerFor(key.aaguid).name;
+    $("last-key-warning").hidden = snapshot.credentials.length !== 1;
+    $("delete-error").textContent = "";
+    $("delete-dialog").showModal();
+  }
+});
+for (const dialog of document.querySelectorAll("dialog")) {
+  dialog
+    .querySelector("[data-close]")
+    .addEventListener("click", () => dialog.close());
+}
+function setBusy(form, value) {
+  busy = value;
+  for (const control of form.elements) control.disabled = value;
+  form.setAttribute("aria-busy", String(value));
+}
+$("rename-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+  if (busy) return;
+  const form = event.currentTarget;
+  const id = selectedId;
+  try {
+    const name = validateName($("passkey-name").value);
+    setBusy(form, true);
+    snapshot = await api.rename(id, name);
+    // Close before replacing the invoking button, so native focus restoration works.
+    $("rename-dialog").close();
+    render();
+    document
+      .querySelector(`button[data-action="rename"][data-id="${id}"]`)
+      ?.focus();
+    notify("Passkey name updated. A little easier to recognize.");
+  } catch (error) {
+    const message =
+      error.message || "We couldn’t rename this passkey. Please try again.";
+    $("rename-error").textContent = message;
+    if (!$("rename-dialog").open) notify(message);
+  } finally {
+    setBusy(form, false);
+  }
+});
+$("delete-form").addEventListener("submit", async (event) => {
+  event.preventDefault();
+  if (busy) return;
+  const form = event.currentTarget;
+  try {
+    setBusy(form, true);
+    // The response is an authoritative, complete remaining credential list.
+    snapshot = await api.remove(selectedId);
+    $("delete-dialog").close();
+    render();
+    const next = $("passkey-list").querySelector("button");
+    if (next) next.focus();
+    else {
+      $("passkeys-title").tabIndex = -1;
+      $("passkeys-title").focus();
+    }
+    notify(
+      preview
+        ? "Passkey removed from this preview account."
+        : "Passkey deleted. It can no longer be used to sign in.",
+    );
+    await synchronize();
+  } catch (error) {
+    const message =
+      error.message || "We couldn’t delete this passkey. Please try again.";
+    $("delete-error").textContent = message;
+    if (!$("delete-dialog").open) notify(message);
+  } finally {
+    setBusy(form, false);
+  }
+});
+if (preview) {
+  $("preview-note").hidden = false;
+  $("account-kind").textContent = "Preview account";
+  if (!storage)
+    $("preview-note").textContent =
+      "Preview account · Browser storage is unavailable; changes last until you reload. No real passkeys are affected.";
+}
+await load();
