+++ b/passkey-api.mjs
@@ -0,0 +1,201 @@
+// AAGUID names sourced from passkeydeveloper/passkey-authenticator-aaguids.
+// Provider metadata is a display hint only; it never grants access.
+const providers = {
+  "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4": {
+    name: "Google Password Manager",
+    icon: "phone",
+    style: "google",
+  },
+  "bada5566-a7aa-401f-bd96-45619a55120d": {
+    name: "1Password",
+    icon: "key",
+    style: "password",
+  },
+  "08987058-cadc-4b81-b6e1-30de50dcbe96": {
+    name: "Windows Hello",
+    icon: "laptop",
+    style: "",
+  },
+  "9ddd1817-af5a-4672-a2b9-3e3dd95000a9": {
+    name: "Windows Hello",
+    icon: "laptop",
+    style: "",
+  },
+  "6028b017-b1d4-4c02-b4b3-afcdafc96bb2": {
+    name: "Windows Hello",
+    icon: "laptop",
+    style: "",
+  },
+};
+export function providerFor(aaguid) {
+  const id = typeof aaguid === "string" ? aaguid.toLowerCase() : "";
+  return (
+    (Object.hasOwn(providers, id) ? providers[id] : null) ?? {
+      name: "Unknown passkey provider",
+      icon: "key",
+      style: "",
+    }
+  );
+}
+export function isBase64Url(value) {
+  return (
+    typeof value === "string" &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+export function validateName(value) {
+  const name = value.trim();
+  if (!name || name.length > 60)
+    throw new Error("Enter a passkey name between 1 and 60 characters.");
+  return name;
+}
+export function validateSnapshot(data) {
+  if (
+    !data ||
+    !Array.isArray(data.credentials) ||
+    typeof data.rpId !== "string" ||
+    !data.rpId ||
+    !isBase64Url(data.userId)
+  ) {
+    throw new Error("Your passkeys could not be loaded. Please try again.");
+  }
+  const ids = new Set();
+  for (const key of data.credentials) {
+    if (
+      !key ||
+      !isBase64Url(key.id) ||
+      ids.has(key.id) ||
+      typeof key.name !== "string" ||
+      !Number.isFinite(key.registeredAt) ||
+      !Number.isFinite(new Date(key.registeredAt).getTime()) ||
+      (key.lastUsedAt != null &&
+        (!Number.isFinite(key.lastUsedAt) ||
+          !Number.isFinite(new Date(key.lastUsedAt).getTime())))
+    ) {
+      throw new Error("Your passkey list was incomplete. Please try again.");
+    }
+    ids.add(key.id);
+  }
+  return data;
+}
+export async function syncAcceptedCredentials(
+  snapshot,
+  publicKeyCredential = globalThis.PublicKeyCredential,
+  preview = false,
+) {
+  if (preview) return "preview";
+  if (typeof publicKeyCredential?.signalAllAcceptedCredentials !== "function")
+    return "unsupported";
+  try {
+    validateSnapshot(snapshot);
+    await publicKeyCredential.signalAllAcceptedCredentials({
+      rpId: snapshot.rpId,
+      userId: snapshot.userId,
+      allAcceptedCredentialIds: snapshot.credentials.map((key) => key.id),
+    });
+    return "synced";
+  } catch (error) {
+    console.warn("Passkey provider synchronization was unavailable:", error);
+    return "failed";
+  }
+}
+const previewSeed = {
+  // Preview data is NEVER passed to the WebAuthn Signal API.
+  rpId: "dailygrind.example",
+  userId: "ZGFpbHktZ3JpbmQtcHJldmlldy11c2Vy",
+  credentials: [
+    {
+      id: "cHJldmlldy1sYXB0b3A",
+      name: "My personal laptop",
+      aaguid: "08987058-cadc-4b81-b6e1-30de50dcbe96",
+      registeredAt: Date.UTC(2026, 8, 12),
+      lastUsedAt: Date.UTC(2026, 10, 8),
+    },
+    {
+      id: "cHJldmlldy1waG9uZQ",
+      name: "My phone",
+      aaguid: "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4",
+      registeredAt: Date.UTC(2026, 8, 12),
+      lastUsedAt: Date.UTC(2026, 10, 6),
+    },
+    {
+      id: "cHJldmlldy1iYWNrdXA",
+      name: "My backup passkey",
+      aaguid: "bada5566-a7aa-401f-bd96-45619a55120d",
+      registeredAt: Date.UTC(2026, 9, 3),
+      lastUsedAt: null,
+    },
+  ],
+};
+export function createPasskeyApi({
+  preview = false,
+  storage,
+  fetcher = globalThis.fetch,
+} = {}) {
+  const storageKey = "daily-grind:preview-passkeys:v1";
+  let memory = structuredClone(previewSeed);
+  if (preview) {
+    try {
+      const saved = storage?.getItem(storageKey);
+      if (saved) memory = validateSnapshot(JSON.parse(saved));
+    } catch {
+      /* Stale or unavailable local storage must not break the preview. */
+    }
+  }
+  async function request(path = "", options = {}) {
+    const response = await fetcher(`/api/account/passkeys${path}`, {
+      ...options,
+      credentials: "same-origin",
+      cache: "no-store",
+      headers: {
+        Accept: "application/json",
+        ...(options.body ? { "Content-Type": "application/json" } : {}),
+      },
+    });
+    if (response.status === 401 || response.status === 403)
+      throw new Error(
+        "Your session has expired. Sign in again to manage your passkeys.",
+      );
+    if (response.status === 404)
+      throw new Error(
+        "This passkey is no longer available. Refresh the page to see your current passkeys.",
+      );
+    if (!response.ok)
+      throw new Error("We couldn’t save that change. Please try again.");
+    if (!response.headers.get("content-type")?.includes("application/json"))
+      throw new Error(
+        "The account service is unavailable. Please try again later.",
+      );
+    return validateSnapshot(await response.json());
+  }
+  async function mutate(id, name) {
+    if (!isBase64Url(id))
+      throw new Error("Invalid passkey. Refresh the page and try again.");
+    if (!preview)
+      return request(
+        `/${encodeURIComponent(id)}`,
+        name === undefined
+          ? { method: "DELETE" }
+          : { method: "PUT", body: JSON.stringify({ name }) },
+      );
+    const updated = structuredClone(memory);
+    const key = updated.credentials.find((key) => key.id === id);
+    if (!key)
+      throw new Error("This passkey is no longer available. Refresh the page.");
+    if (name === undefined)
+      updated.credentials = updated.credentials.filter((key) => key.id !== id);
+    else key.name = name;
+    // Save before changing the UI: storage failures must not look like success.
+    if (storage) storage.setItem(storageKey, JSON.stringify(updated));
+    memory = updated;
+    return structuredClone(memory);
+  }
+  return {
+    list: () =>
+      preview ? Promise.resolve(structuredClone(memory)) : request(),
+    rename: (id, name) => mutate(id, validateName(name)),
+    remove: (id) => mutate(id),
+  };
+}
