diff --git a/tests/passkey-api.test.mjs b/tests/passkey-api.test.mjs
new file mode 100644
index 0000000..902b3ae
--- /dev/null
+++ b/tests/passkey-api.test.mjs
@@ -0,0 +1,169 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  createPasskeyApi,
+  isBase64Url,
+  syncAcceptedCredentials,
+  validateSnapshot,
+} from "../passkey-api.mjs";
+
+function memoryStorage() {
+  const values = new Map();
+  return {
+    getItem: (key) => values.get(key),
+    setItem: (key, value) => values.set(key, value),
+  };
+}
+
+test("preview names and deletion persist without reaching authentication APIs", async () => {
+  const storage = memoryStorage();
+  const api = createPasskeyApi({
+    preview: true,
+    storage,
+    fetcher: () => assert.fail("preview made a network request"),
+  });
+  const original = await api.list();
+  const id = original.credentials[0].id;
+  assert.equal(isBase64Url(original.userId), true);
+  assert.ok(original.credentials.every((key) => isBase64Url(key.id)));
+  await api.rename(id, "  Work laptop  ");
+  const reloaded = createPasskeyApi({ preview: true, storage });
+  assert.equal((await reloaded.list()).credentials[0].name, "Work laptop");
+  const remaining = await reloaded.remove(id);
+  assert.equal(remaining.credentials.length, original.credentials.length - 1);
+  assert.equal(
+    remaining.credentials.some((key) => key.id === id),
+    false,
+  );
+  assert.throws(() => api.rename(id, "   "));
+  assert.throws(() => api.rename(id, "x".repeat(61)));
+  const nextLoad = createPasskeyApi({ preview: true, storage });
+  assert.equal(
+    (await nextLoad.list()).credentials.length,
+    remaining.credentials.length,
+  );
+});
+
+test("failed storage writes leave the account unchanged", async () => {
+  const api = createPasskeyApi({
+    preview: true,
+    storage: {
+      getItem: () => null,
+      setItem: () => {
+        throw new Error("Storage is full");
+      },
+    },
+  });
+  const original = await api.list();
+  await assert.rejects(
+    api.remove(original.credentials[0].id),
+    /Storage is full/,
+  );
+  assert.deepEqual(await api.list(), original);
+});
+
+test("sync uses authoritative server RP and IDs, including an empty remaining list", async () => {
+  const calls = [];
+  const credential = {
+    signalAllAcceptedCredentials: async (value) => calls.push(value),
+  };
+  const snapshot = {
+    rpId: "parent.example",
+    userId: "dXNlcg",
+    credentials: [],
+  };
+  assert.equal(await syncAcceptedCredentials(snapshot, credential), "synced");
+  assert.deepEqual(calls, [
+    { rpId: "parent.example", userId: "dXNlcg", allAcceptedCredentialIds: [] },
+  ]);
+  assert.equal(
+    await syncAcceptedCredentials(snapshot, credential, true),
+    "preview",
+  );
+  assert.equal(calls.length, 1);
+  assert.equal(await syncAcceptedCredentials(snapshot, {}), "unsupported");
+});
+
+test("malformed identifiers never reach a browser authenticator and sync errors are non-fatal", async (t) => {
+  t.mock.method(console, "warn", () => {});
+  const snapshot = {
+    rpId: "parent.example",
+    userId: "not=padded",
+    credentials: [],
+  };
+  assert.equal(
+    await syncAcceptedCredentials(snapshot, {
+      signalAllAcceptedCredentials: () => assert.fail("malformed ID was sent"),
+    }),
+    "failed",
+  );
+  assert.equal(
+    await syncAcceptedCredentials(
+      { ...snapshot, userId: "dXNlcg" },
+      {
+        signalAllAcceptedCredentials: async () => {
+          throw new Error("Browser rejected sync");
+        },
+      },
+    ),
+    "failed",
+  );
+  for (const id of ["", "a", "a=b", "key:1", "abcde"])
+    assert.equal(isBase64Url(id), false);
+});
+
+test("connected mode sends authenticated mutations and returns server snapshots", async () => {
+  const snapshot = await createPasskeyApi({ preview: true }).list();
+  const requests = [];
+  const api = createPasskeyApi({
+    fetcher: async (path, options) => {
+      requests.push({ path, options });
+      return new Response(JSON.stringify(snapshot), {
+        headers: { "Content-Type": "application/json" },
+      });
+    },
+  });
+  await api.list();
+  await api.rename(snapshot.credentials[0].id, "New name");
+  await api.remove(snapshot.credentials[0].id);
+  assert.equal(requests[0].path, "/api/account/passkeys");
+  assert.equal(requests[1].options.method, "PUT");
+  assert.deepEqual(JSON.parse(requests[1].options.body), { name: "New name" });
+  assert.equal(requests[2].options.method, "DELETE");
+  assert.ok(
+    requests.every(
+      ({ options }) =>
+        options.credentials === "same-origin" && options.cache === "no-store",
+    ),
+  );
+});
+
+test("unauthenticated and HTML fallback responses never become preview accounts", async () => {
+  const unauthorized = createPasskeyApi({
+    fetcher: async () => new Response("", { status: 401 }),
+  });
+  await assert.rejects(unauthorized.list(), /session has expired/);
+  const htmlFallback = createPasskeyApi({
+    fetcher: async () =>
+      new Response("<html></html>", {
+        headers: { "Content-Type": "text/html" },
+      }),
+  });
+  await assert.rejects(htmlFallback.list(), /account service is unavailable/);
+});
+
+test("incomplete or duplicate lists are rejected before destructive synchronization", async () => {
+  const snapshot = await createPasskeyApi({ preview: true }).list();
+  assert.throws(() =>
+    validateSnapshot({
+      ...snapshot,
+      credentials: [...snapshot.credentials, snapshot.credentials[0]],
+    }),
+  );
+  assert.throws(() =>
+    validateSnapshot({
+      ...snapshot,
+      credentials: [{ ...snapshot.credentials[0], registeredAt: "yesterday" }],
+    }),
+  );
+});
