 });
diff --git a/src/pages/account.astro b/src/pages/account.astro
new file mode 100644
index 0000000..bc51ba0
--- /dev/null
+++ b/src/pages/account.astro
@@ -0,0 +1,24 @@
+---
+import Layout from '../layouts/Layout.astro';
+import PasskeySettings from '../components/PasskeySettings';
+import { getAccount } from '../lib/account-server';
+const account = await getAccount(Astro.session);
+Astro.response.headers.set('Cache-Control', 'no-store');
+---
+<Layout title="Account settings | The DevTools Times">
+  <div class="max-w-3xl mx-auto px-4 py-12 sm:px-6">
+    <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Your account</p>
+    <h1 class="font-brand text-4xl mt-2 mb-3">Account settings</h1>
+    {account ? <>
+      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
+        <p class="text-sm text-gray-600">Signed in as <span class="font-semibold text-gray-900">{account.username}</span></p>
+        <form method="post" action={`${import.meta.env.BASE_URL}api/account/logout`}><button class="text-sm underline">Sign out</button></form>
+      </div>
+      <PasskeySettings client:load />
+    </> : <div class="mt-8 border border-gray-200 rounded-lg p-6">
+      <h2 class="text-xl font-bold">Sign in to manage your account</h2>
+      <p class="text-gray-600 mt-2 mb-5">View, rename, and remove the passkeys registered to your account.</p>
+      <a href={`${import.meta.env.BASE_URL}signin`} class="inline-block rounded bg-gray-900 text-white px-4 py-2 text-sm font-semibold">Sign in</a>
+    </div>}
+  </div>
+</Layout>
