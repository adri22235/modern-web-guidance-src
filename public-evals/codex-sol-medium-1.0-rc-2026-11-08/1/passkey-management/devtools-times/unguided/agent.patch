new file mode 100644
index 0000000..bbc82f9
--- /dev/null
+++ b/src/lib/account.ts
@@ -0,0 +1,56 @@
+import type { APIContext } from 'astro';
+
+export interface AccountSession { token: string; username: string }
+export interface Passkey { id: string; displayName: string; createdAt?: string; lastUsedAt?: string }
+export interface PasskeyAccount {
+  rpId: string;
+  user: { id: string; name: string; displayName: string };
+  passkeys: Passkey[];
+}
+
+export const authApi = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+// The app disables Astro's origin check globally; account mutations still require it.
+export function sameOrigin(request: Request) {
+  return request.headers.get('Origin') === new URL(request.url).origin;
+}
+
+export async function passkeyRequest(context: APIContext, method: string, id?: string) {
+  const account = await context.session?.get('account') as AccountSession | undefined;
+  if (!account) return json({ error: 'Please sign in to manage your passkeys.' }, 401);
+  if (method !== 'GET' && !sameOrigin(context.request)) return json({ error: 'Invalid request origin.' }, 403);
+  const base = process.env.PASSKEY_API_URL;
+  if (!base) return json({ error: 'Passkey management is not available yet. Please try again later.' }, 503);
+
+  let body: string | undefined;
+  if (method === 'PATCH') {
+    let input;
+    try { input = await context.request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+    if (typeof input.displayName !== 'string' || !input.displayName.trim() || input.displayName.trim().length > 64) {
+      return json({ error: 'Enter a display name between 1 and 64 characters.' }, 400);
+    }
+    body = JSON.stringify({ displayName: input.displayName.trim() });
+  }
+  try {
+    const response = await fetch(`${base.replace(/\/$/, '')}/passkeys${id ? `/${encodeURIComponent(id)}` : ''}`, {
+      method, headers: { Authorization: `Bearer ${account.token}`, 'Content-Type': 'application/json' },
+      body, signal: AbortSignal.timeout(15000), redirect: 'error',
+    });
+    if (response.status === 401) {
+      await context.session?.delete('account');
+      return json({ error: 'Your session has expired. Please sign in again.' }, 401);
+    }
+    if (!response.ok) return json({ error: response.status === 404 ? 'This passkey is no longer available. Refresh the list.' : 'Unable to update your passkeys. Please try again.' }, response.status >= 500 ? 502 : response.status);
+    // Every response must contain the complete, authoritative remaining list.
+    const data = await response.json() as PasskeyAccount;
+    if (!data.rpId || !data.user?.id || typeof data.user.name !== 'string' || typeof data.user.displayName !== 'string' || !Array.isArray(data.passkeys) || data.passkeys.some(key => !key.id || typeof key.displayName !== 'string')) {
+      return json({ error: 'The passkey service returned an invalid response. Refresh before making further changes.' }, 502);
+    }
+    return json(data);
+  } catch {
+    return json({ error: 'Unable to reach the passkey service. Refresh to check the latest state before trying again.' }, 502);
+  }
+}
diff --git a/src/lib/passkey-sync.ts b/src/lib/passkey-sync.ts
new file mode 100644
index 0000000..6b0e73e
--- /dev/null
+++ b/src/lib/passkey-sync.ts
@@ -0,0 +1,21 @@
+import type { PasskeyAccount } from './account';
+
+type Signals = {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+};
+
+export async function syncPasskeys(account: PasskeyAccount): Promise<string | null> {
+  if (typeof PublicKeyCredential === 'undefined') return 'Your browser does not support passkey sync. You can manage saved keys in your device settings.';
+  const api = PublicKeyCredential as typeof PublicKeyCredential & Signals;
+  if (!api.signalAllAcceptedCredentials) return 'Your browser does not support passkey sync. You may need to remove old keys in your device settings.';
+  try {
+    await api.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.user.id,
+      allAcceptedCredentialIds: account.passkeys.map(key => key.id),
+    });
+    return null;
+  } catch {
+    return 'Your account is up to date, but we could not sync with your authenticator. Try syncing again or manage saved keys in your device settings.';
+  }
+}
