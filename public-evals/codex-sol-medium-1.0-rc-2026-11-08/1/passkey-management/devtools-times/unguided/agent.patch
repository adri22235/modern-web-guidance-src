+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,23 @@
+import type { APIRoute } from 'astro';
+import { authApi, json, sameOrigin } from '../../../lib/account';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!sameOrigin(request)) return json({ error: 'Invalid request origin.' }, 403);
+  if (!session) return json({ error: 'Sign-in is temporarily unavailable.' }, 503);
+  let input;
+  try { input = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (typeof input.username !== 'string' || typeof input.password !== 'string' || !input.username || !input.password) return json({ error: 'Enter your username and password.' }, 400);
+  try {
+    const response = await fetch(`${authApi}/login`, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: input.username, password: input.password }),
+      signal: AbortSignal.timeout(15000),
+    });
+    const data = await response.json();
+    if (!response.ok) return json({ error: 'Invalid username or password.' }, 401);
+    if (typeof data.token !== 'string' || !data.token) return json({ error: 'The sign-in service did not return a session token.' }, 502);
+    await session.regenerate();
+    await session.set('account', { token: data.token, username: input.username });
+    return json({ success: true });
+  } catch { return json({ error: 'Unable to sign in. Please try again later.' }, 502); }
+};
