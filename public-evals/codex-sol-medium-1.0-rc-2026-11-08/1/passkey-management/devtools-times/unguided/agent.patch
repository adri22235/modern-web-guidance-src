+        </div>}
+        {syncWarning && <div role="status" className="mt-5 rounded-md bg-amber-50 p-4 text-sm leading-6 text-amber-900">{syncWarning}<button disabled={busy || loading} onClick={() => void load()} className="ml-2 font-semibold underline disabled:opacity-50">Retry sync</button></div>}
+      </>}
+    </div>
+    <div className="flex gap-3 rounded-b-lg border-t border-gray-200 bg-gray-50 px-6 py-5 text-xs leading-5 text-gray-600 sm:px-8"><ShieldCheckIcon className="h-5 w-5 shrink-0 text-gray-500" /><p>Your private keys stay on your devices. Display names help you identify keys here; your browser manages the names shown in its passkey picker.</p></div>
+  </section>;
+}
