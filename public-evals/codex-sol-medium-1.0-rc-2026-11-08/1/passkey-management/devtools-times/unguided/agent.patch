+              </form> : <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center"><div className="flex min-w-0 gap-3"><KeyIcon className="mt-0.5 h-5 w-5 shrink-0 text-gray-500" /><div className="min-w-0"><p className="break-words text-sm font-semibold">{key.displayName || 'Unnamed passkey'}</p><p className="mt-1 text-xs leading-5 text-gray-500">Added {dateLabel(key.createdAt)}<br />Last used {dateLabel(key.lastUsedAt)}</p></div></div><div className="flex shrink-0 gap-2"><button className={button} aria-label={`Rename ${key.displayName || 'passkey'}`} disabled={busy || !!removing} onClick={() => { setEditing(key.id); setName(key.displayName); setNotice(''); }}><PencilSquareIcon className="h-4 w-4" />Rename</button><button className={`${button} text-red-700`} aria-label={`Remove ${key.displayName || 'passkey'}`} disabled={busy || !!removing} onClick={event => { removeTrigger.current = event.currentTarget; setRemoving(key); setNotice(''); }}><TrashIcon className="h-4 w-4" />Remove</button></div></div>}
+            </li>)}
