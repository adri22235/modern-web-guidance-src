--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,82 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { syncPasskeys } from '../src/lib/passkey-sync.ts';
+import { passkeyRequest } from '../src/lib/account.ts';
+import type { APIContext } from 'astro';
+
+const snapshot = {
+  rpId: 'example.test', user: { id: 'dXNlcg', name: 'reader', displayName: 'Reader' },
+  passkeys: [{ id: 'a2V5', displayName: 'Laptop' }, { id: 'a2V5Mg', displayName: 'Phone' }],
+};
+
+test('authenticator sync sends the full list, including an empty final list', async () => {
+  const original = globalThis.PublicKeyCredential;
+  const calls: unknown[] = [];
+  try {
+    globalThis.PublicKeyCredential = class {
+      static async signalAllAcceptedCredentials(options: unknown) { calls.push(options); }
+    } as unknown as typeof PublicKeyCredential;
+    assert.equal(await syncPasskeys(snapshot), null);
+    assert.equal(await syncPasskeys({ ...snapshot, passkeys: [] }), null);
+    assert.deepEqual(calls, [
+      { rpId: 'example.test', userId: 'dXNlcg', allAcceptedCredentialIds: ['a2V5', 'a2V5Mg'] },
+      { rpId: 'example.test', userId: 'dXNlcg', allAcceptedCredentialIds: [] },
+    ]);
+  } finally { globalThis.PublicKeyCredential = original; }
+});
+
+test('unsupported and rejected signals return a warning without failing account updates', async () => {
+  const original = globalThis.PublicKeyCredential;
+  try {
+    Reflect.deleteProperty(globalThis, 'PublicKeyCredential');
+    assert.match((await syncPasskeys(snapshot))!, /does not support/);
+    globalThis.PublicKeyCredential = class {} as typeof PublicKeyCredential;
+    assert.match((await syncPasskeys(snapshot))!, /does not support/);
+    globalThis.PublicKeyCredential = class {
+      static async signalAllAcceptedCredentials() { throw new Error('unsupported authenticator'); }
+    } as unknown as typeof PublicKeyCredential;
+    assert.match((await syncPasskeys(snapshot))!, /account is up to date/);
+  } finally { globalThis.PublicKeyCredential = original; }
+});
+
+test('account proxy requires authentication, origin, valid labels, and authoritative responses', async () => {
+  const originalFetch = globalThis.fetch;
+  const originalUrl = process.env.PASSKEY_API_URL;
+  let authenticated = false;
+  let deleted = false;
+  const context = (method = 'GET', body?: object, origin = 'https://example.test') => ({
+    request: new Request('https://example.test/api/account/passkeys/a2V5', {
+      method, headers: { Origin: origin, 'Content-Type': 'application/json' }, body: body && JSON.stringify(body),
+    }),
+    session: { get: async () => authenticated ? { token: 'secret', username: 'reader' } : undefined, delete: async () => { deleted = true; } },
+  }) as unknown as APIContext;
+  try {
+    process.env.PASSKEY_API_URL = 'https://auth.example.test/api';
+    globalThis.fetch = async () => { throw new Error('unexpected upstream call'); };
+    assert.equal((await passkeyRequest(context(), 'GET')).status, 401);
+    authenticated = true;
+    assert.equal((await passkeyRequest(context('DELETE', undefined, 'https://other.test'), 'DELETE', 'a2V5')).status, 403);
+    assert.equal((await passkeyRequest(context('PATCH', { displayName: ' ' }), 'PATCH', 'a2V5')).status, 400);
+    globalThis.fetch = async (url, options) => {
+      assert.equal(url, 'https://auth.example.test/api/passkeys/a2V5');
+      assert.equal((options!.headers as Record<string, string>).Authorization, 'Bearer secret');
+      assert.deepEqual(JSON.parse(options!.body as string), { displayName: 'Work laptop' });
+      return Response.json(snapshot);
+    };
+    const response = await passkeyRequest(context('PATCH', { displayName: '  Work laptop  ' }), 'PATCH', 'a2V5');
+    assert.equal(response.status, 200);
+    assert.equal(response.headers.get('Cache-Control'), 'no-store');
+    assert.deepEqual(await response.json(), snapshot);
+    globalThis.fetch = async () => Response.json({ passkeys: [] });
+    assert.equal((await passkeyRequest(context(), 'GET')).status, 502);
+    globalThis.fetch = async () => new Response(null, { status: 401 });
+    assert.equal((await passkeyRequest(context(), 'GET')).status, 401);
+    assert.equal(deleted, true);
+    delete process.env.PASSKEY_API_URL;
+    assert.equal((await passkeyRequest(context(), 'GET')).status, 503);
+  } finally {
+    globalThis.fetch = originalFetch;
+    if (originalUrl === undefined) delete process.env.PASSKEY_API_URL;
+    else process.env.PASSKEY_API_URL = originalUrl;
+  }
+});
