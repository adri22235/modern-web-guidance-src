+        </> : <button className={button} onClick={() => void load()}>Try again</button>}
+        {removing && <div role="group" aria-labelledby="remove-title" className="mt-5 rounded-md border border-red-200 bg-red-50 p-5" onKeyDown={event => { if (event.key === 'Escape' && !busy) closeRemoval(); }}>
