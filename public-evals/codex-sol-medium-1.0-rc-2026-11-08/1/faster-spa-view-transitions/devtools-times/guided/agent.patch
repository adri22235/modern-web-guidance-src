diff --git a/src/components/SectionViews.astro b/src/components/SectionViews.astro
new file mode 100644
index 0000000..e984bdc
--- /dev/null
+++ b/src/components/SectionViews.astro
@@ -0,0 +1,178 @@
+---
+import ArticleTeaser from '../components/ArticleTeaser.astro';
+import TopStoryTeaserGrid from '../components/TopStoryTeaserGrid.astro';
+import Ad from '../components/AdSlotBanner';
+import { getCollection } from 'astro:content';
+import SimpleTeaserGrid from '../components/SimpleTeaserGrid.astro';
+import type { RenderResult } from 'astro:content';
+
+const articles = await getCollection('articles');
+articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
+
+// Slicing articles for different sections
+const topArticle = articles[0];
+const topStories = articles.slice(1, 4);
+const topNewsArticles = articles.slice(4, 8);      // 4 articles for the new grid
+const worldNewsArticles = articles.slice(8, 11);    // 3 articles for the old grid
+const politicsArticles = articles.slice(11, 15);   // 4 articles for the new grid
+
+// Add a fake What's new in DevTools post in there, demonstrating a CORS issue for the image
+politicsArticles[2] = {
+    id: 'public-transit-overhaul',
+    data: {
+      title: 'What\'s new in DevTools',
+      summary: 'Learn about what is new in Chrome DevTools 144: from request conditions to performance debugging, we got you covered.',
+      author: 'Chrome DevTools Team',
+      date: new Date('2025-09-16T00:00:00.000Z'),
+      category: 'Web Development',
+      image: 'https://cinemai-1026410574114.us-central1.run.app/cinemai/_next/image?url=%2Fcinemai%2F_next%2Fstatic%2Fmedia%2Fthumbnail-wndt-139-141.45ba64a6.jpg&w=3840&q=75',
+      image_caption: '',
+      readingTime: 3
+    },
+    body: '',
+    collection: 'articles',
+    slug: 'public-transit-overhaul',
+    render: async () => '' as unknown as RenderResult,
+  };
+
+export interface Props {
+    activeView: 'top-news' | 'world' | 'politics' | 'multimedia' | 'reports';
+}
+const { activeView } = Astro.props;
+const multimedia = await getCollection('multimedia');
+const reports = await getCollection('reports');
+const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
+const views = [
+    { id: 'top-news', label: 'Top News', href: base },
+    { id: 'world', label: 'World', href: `${base}world` },
+    { id: 'politics', label: 'Politics', href: `${base}politics` },
+    { id: 'multimedia', label: 'Multimedia', href: `${base}multimedia` },
+    { id: 'reports', label: 'Reports', href: `${base}reports` },
+];
+---
+
+<section-views data-active-view={activeView}>
+    <nav aria-label="Main sections" class="border-b border-gray-300 px-4 md:px-6">
+        <ul class="flex gap-6 overflow-x-auto py-3 text-sm font-semibold">
+            {views.map(view => (
+                <li>
+                    <a href={view.href} data-section-link={view.id}
+                        aria-current={activeView === view.id ? 'page' : undefined}
+                        class="section-link whitespace-nowrap hover:text-amber-700">
+                        {view.label}
+                    </a>
+                </li>
+            ))}
+        </ul>
+    </nav>
+    <div class="section-view-stack">
+        {views.map(view => (
+            <section id={`view-${view.id}`} data-section-view={view.id}
+                data-view-url={view.href}
+                data-view-title={view.id === 'top-news' ? 'The DevTools Times' : `${view.label} | The DevTools Times`}
+                class:list={['section-view', { inactive: activeView !== view.id }]}
+                aria-label={view.label} aria-hidden={activeView !== view.id ? 'true' : undefined}
+                inert={activeView !== view.id} tabindex="-1">
+                {view.id === 'top-news' && (<>
+
+                    <!-- Top Stories Bar -->
+                    <div class="bg-white border-b border-gray-300">
+                        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
+                                {topStories.map(article => (
+                                    <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
+                                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                                            <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                                        </a>
+                                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                                    </div>
+                                ))}
+                            </div>
+                        </div>
+                    </div>
+
+                    <!-- Main Content Area -->
+                    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
+                        <ArticleTeaser article={topArticle} large={true} />
+                    </div>
+
+                    <div class="divide-y divide-gray-200 max-w-6xl mx-auto">
+                        <section class="p-4 md:p-6 text-center">
+                            <Ad client:visible />
+                        </section>
+
+                        <!-- "Top News" section with the new grid variant -->
+                        <TopStoryTeaserGrid title="Top News" articles={topNewsArticles} />
+
+                    </div>
+
+                </>)}
+                {view.id === 'world' && <SimpleTeaserGrid title="World" articles={worldNewsArticles} />}
+                {view.id === 'politics' && <TopStoryTeaserGrid title="Politics" articles={politicsArticles} />}
+                {view.id === 'multimedia' && (
+                    <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+                        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Multimedia</h1>
+                        <p class="mb-4">Watch our latest multimedia content.</p>
+                        <ul class="space-y-4">
+                            {multimedia.map(item => (
+                                <li>
+                                    <a href={`${base}multimedia/${item.id}`} class="font-bold hover:underline">{item.data.title}</a>
+                                    <p>{item.data.description}</p>
+                                </li>
+                            ))}
+                        </ul>
+                    </div>
+                )}
+                {view.id === 'reports' && (
+                    <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+                        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 pb-2 border-b-2">Reports</h1>
+                        <p class="mb-4">Read our latest reports.</p>
+                        <ul class="space-y-4">
+                            {reports.map(report => (
+                                <li>
+                                    <a href={`${base}reports/${report.id}`} class="font-bold hover:underline">{report.data.title}</a>
+                                    <p>{report.data.description}</p>
+                                </li>
+                            ))}
+                        </ul>
+                    </div>
+                )}
+            </section>
+        ))}
+    </div>
+</section-views>
+
+<script>
+    import '../scripts/section-views';
+</script>
+
+<style>
+    section-views {
+        display: block;
+    }
+
+    .section-link[aria-current='page'] {
+        color: #92400e;
+        text-decoration: underline;
+        text-underline-offset: 0.4em;
+    }
+
+    .section-view-stack {
+        position: relative;
+    }
+
+    .section-view.inactive {
+        content-visibility: hidden;
+        position: absolute;
+        inset: 0 0 auto;
+        height: 0;
+        overflow: hidden;
+        contain-intrinsic-size: 0 0;
+    }
+
+    @supports not (content-visibility: hidden) {
+        .section-view.inactive {
+            display: none;
+        }
+    }
+</style>
