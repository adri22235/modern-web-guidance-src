diff --git a/src/scripts/section-views.ts b/src/scripts/section-views.ts
new file mode 100644
index 0000000..16a7c2b
--- /dev/null
+++ b/src/scripts/section-views.ts
@@ -0,0 +1,77 @@
+// The five section panels are a bounded cache: never detach or rebuild them.
+class SectionViews extends HTMLElement {
+    connectedCallback() {
+        const controller = new AbortController();
+        const { signal } = controller;
+        const panels = Array.from(this.querySelectorAll<HTMLElement>('[data-section-view]'));
+        const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
+        const scrollPositions = new Map<string, number>();
+        let active = this.dataset.activeView!;
+        const previousRestoration = history.scrollRestoration;
+        history.scrollRestoration = 'manual';
+
+        const findPanel = (url: URL) => panels.find(panel => {
+            const panelUrl = new URL(panel.dataset.viewUrl!, location.href);
+            return url.origin === panelUrl.origin &&
+                url.pathname.replace(/\/$/, '') === panelUrl.pathname.replace(/\/$/, '') &&
+                !url.search && !url.hash;
+        });
+
+        const activate = (panel: HTMLElement) => {
+            const id = panel.dataset.sectionView!;
+            if (id === active) return;
+            scrollPositions.set(active, window.scrollY);
+
+            for (const candidate of panels) {
+                const inactive = candidate !== panel;
+                candidate.classList.toggle('inactive', inactive);
+                candidate.inert = inactive;
+                if (inactive) candidate.setAttribute('aria-hidden', 'true');
+                else candidate.removeAttribute('aria-hidden');
+            }
+            for (const link of links) {
+                if (link.dataset.sectionLink === id) link.setAttribute('aria-current', 'page');
+                else link.removeAttribute('aria-current');
+            }
+            active = id;
+            this.dataset.activeView = id;
+            document.title = panel.dataset.viewTitle!;
+            panel.focus({ preventScroll: true });
+            window.scrollTo({ top: scrollPositions.get(id) ?? 0, behavior: 'instant' });
+        };
+
+        document.addEventListener('click', event => {
+            if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+                event.ctrlKey || event.shiftKey || event.altKey) return;
+            const anchor = event.target instanceof Element ? event.target.closest('a') : null;
+            if (!anchor || anchor.hasAttribute('download') ||
+                (anchor.target && anchor.target !== '_self') ||
+                anchor.relList.contains('external')) return;
+            const url = new URL(anchor.href);
+            const panel = findPanel(url);
+            if (!panel) return;
+            event.preventDefault();
+            if (panel.dataset.sectionView === active) return;
+            history.pushState({ sectionView: panel.dataset.sectionView }, '', url);
+            activate(panel);
+        }, { signal });
+
+        window.addEventListener('popstate', () => {
+            const panel = findPanel(new URL(location.href));
+            if (panel) activate(panel);
+        }, { signal });
+
+        this.cleanup = () => {
+            controller.abort();
+            history.scrollRestoration = previousRestoration;
+        };
+    }
+
+    private cleanup?: () => void;
+
+    disconnectedCallback() {
+        this.cleanup?.();
+    }
+}
+
+if (!customElements.get('section-views')) customElements.define('section-views', SectionViews);
diff --git a/tests/section-views.test.mjs b/tests/section-views.test.mjs
new file mode 100644
index 0000000..00a5c29
--- /dev/null
+++ b/tests/section-views.test.mjs
@@ -0,0 +1,133 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+test('section navigation retains panel state and restores history without rebuilding DOM', async () => {
+    const base = 'https://example.test/devtools-times/';
+    const ids = ['top-news', 'world', 'politics', 'multimedia', 'reports'];
+    const panels = ids.map(id => ({
+        dataset: {
+            sectionView: id,
+            viewUrl: id === 'top-news' ? base : base + id,
+            viewTitle: id,
+        },
+        classes: new Set(id === 'top-news' ? [] : ['inactive']),
+        attributes: new Map(),
+        inert: id !== 'top-news',
+        focus(options) { this.focusOptions = options; },
+        setAttribute(key, value) { this.attributes.set(key, value); },
+        removeAttribute(key) { this.attributes.delete(key); },
+        // A stand-in for a mounted form, media player, or hydrated island.
+        childState: { value: '', playhead: 0 },
+    }));
+    for (const panel of panels) {
+        panel.classList = {
+            toggle(name, enabled) {
+                if (enabled) panel.classes.add(name);
+                else panel.classes.delete(name);
+            },
+        };
+    }
+    const links = ids.map(id => ({
+        dataset: { sectionLink: id },
+        attributes: new Map(),
+        setAttribute(key, value) { this.attributes.set(key, value); },
+        removeAttribute(key) { this.attributes.delete(key); },
+    }));
+    class MockHTMLElement {
+        dataset = { activeView: 'top-news' };
+        querySelectorAll(selector) {
+            return selector === '[data-section-view]' ? panels : links;
+        }
+    }
+    class MockAnchor {
+        constructor(href) { this.href = href; }
+        target = '';
+        relList = { contains: () => false };
+        hasAttribute() { return false; }
+        closest() { return this; }
+    }
+    const registry = new Map();
+    const entries = [base];
+    let entryIndex = 0;
+    Object.assign(globalThis, {
+        HTMLElement: MockHTMLElement,
+        Element: MockAnchor,
+        customElements: { get: id => registry.get(id), define: (id, type) => registry.set(id, type) },
+        location: new URL(base),
+        document: Object.assign(new EventTarget(), { title: 'top-news' }),
+        window: Object.assign(new EventTarget(), {
+            scrollY: 0,
+            scrollTo({ top }) { this.scrollY = top; },
+        }),
+        history: {
+            scrollRestoration: 'auto',
+            pushState(_state, _unused, url) {
+                entries.splice(++entryIndex);
+                entries.push(url.href);
+                globalThis.location = new URL(url);
+            },
+        },
+    });
+    const click = (href, options = {}) => {
+        const anchor = new MockAnchor(href);
+        const event = new Event('click', { cancelable: true });
+        Object.defineProperty(event, 'target', { value: anchor });
+        Object.assign(event, { button: 0, ...options });
+        document.dispatchEvent(event);
+        return event;
+    };
+    const back = () => {
+        globalThis.location = new URL(entries[--entryIndex]);
+        window.dispatchEvent(new Event('popstate'));
+    };
+
+    await import('../src/scripts/section-views.ts');
+    const views = new (registry.get('section-views'))();
+    views.connectedCallback();
+    assert.equal(history.scrollRestoration, 'manual');
+
+    panels[0].childState.value = 'saved input';
+    window.scrollY = 420;
+    assert.equal(click(base + 'world').defaultPrevented, true);
+    assert.equal(location.pathname, '/devtools-times/world');
+    assert.equal(document.title, 'world');
+    assert.equal(panels[0].inert, true);
+    assert.equal(panels[0].attributes.get('aria-hidden'), 'true');
+    assert.equal(panels[1].inert, false);
+    assert.equal(panels[1].classes.has('inactive'), false);
+    assert.deepEqual(panels[1].focusOptions, { preventScroll: true });
+    assert.equal(links[1].attributes.get('aria-current'), 'page');
+    assert.equal(window.scrollY, 0);
+
+    panels[1].childState.playhead = 23;
+    window.scrollY = 190;
+    click(base + 'reports');
+    back();
+    assert.equal(views.dataset.activeView, 'world');
+    assert.equal(window.scrollY, 190);
+    assert.equal(panels[1].childState.playhead, 23);
+    back();
+    assert.equal(views.dataset.activeView, 'top-news');
+    assert.equal(window.scrollY, 420);
+    assert.equal(panels[0].childState.value, 'saved input');
+    assert.strictEqual(views.querySelectorAll('[data-section-view]')[0], panels[0]);
+
+    const count = entries.length;
+    click(base);
+    assert.equal(entries.length, count, 'same-view clicks do not add history entries');
+    for (const id of ids.slice(1)) {
+        click(base + id);
