diff --git a/src/scripts/section-views.ts b/src/scripts/section-views.ts
new file mode 100644
index 0000000..3d210f2
--- /dev/null
+++ b/src/scripts/section-views.ts
@@ -0,0 +1,76 @@
+// Astro owns navigation, history, titles, script execution, and error fallback.
+// Only the section content is retained: hidden panels stay mounted in the
+// transition:persist host, including their hydrated islands and DOM state.
+const hostSelector = '[data-section-views]';
+const panelSelector = '[data-section-view]';
+const documents = new Map<string, Document>();
+
+const keyFor = (url: URL) => url.pathname.replace(/\/$/, '') + url.search;
+
+function remember(key: string, source: Document) {
+  const shell = source.cloneNode(true) as Document;
+  // Cache the navigation shell, never duplicate the retained section DOM.
+  shell.querySelector(hostSelector)?.replaceChildren();
+  // The initial document may already have hydrated its non-persistent islands.
+  // Copies in the navigation shell must be allowed to hydrate again.
+  shell.querySelectorAll('astro-island').forEach(island => island.setAttribute('ssr', ''));
+  documents.set(key, shell);
+}
+
+document.addEventListener('astro:page-load', () => {
+  if (!document.querySelector(hostSelector)) {
+    // Leaving sections releases their DOM and any session-dependent snapshots.
+    documents.clear();
+    return;
+  }
+  const key = keyFor(new URL(location.href));
+  if (!documents.has(key)) remember(key, document);
+});
+
+document.addEventListener('astro:before-preparation', event => {
+  const host = document.querySelector(hostSelector);
+  const cached = documents.get(keyFor(event.to));
+  const retained = host && Array.from(host.children).some(
+    panel => panel.getAttribute('data-section-view') === keyFor(event.to),
+  );
+  if (event.to.origin !== location.origin || event.formData || !cached || !retained) return;
+
+  // A visited view needs neither a network request nor HTML parsing. Astro gets
+  // a fresh shell because its normal swap consumes/mutates the incoming document.
+  event.loader = async () => {
+    event.newDocument = cached.cloneNode(true) as Document;
+  };
+});
+
+document.addEventListener('astro:before-swap', event => {
+  const incomingHost = event.newDocument.querySelector<HTMLElement>(hostSelector);
+  if (!incomingHost) return;
+
+  const key = keyFor(event.to);
+  if (!documents.has(key)) remember(key, event.newDocument);
+
+  const host = document.querySelector<HTMLElement>(hostSelector);
+  if (!host) return; // Entering a section from an article or another page.
+
+  const retained = Array.from(host.querySelectorAll<HTMLElement>(panelSelector))
+    .find(panel => panel.dataset.sectionView === key);
+  const incoming = incomingHost.querySelector<HTMLElement>(panelSelector);
+  const next = retained ?? incoming;
+  if (!next) return;
+
+  const swap = event.swap;
+  event.swap = () => {
+    // Let Astro install new content and its scripts/media normally, outside the
+    // persistent placeholder. Then move it into the retained host in this same
+    // synchronous swap, before any after-swap/unmount handlers can run.
+    if (!retained && incoming) incomingHost.after(incoming);
+    swap();
+    if (!retained) host.append(next);
+    for (const panel of host.querySelectorAll<HTMLElement>(panelSelector)) {
+      const inactive = panel !== next;
+      panel.hidden = inactive;
+      panel.inert = inactive;
+    }
+    next.focus({ preventScroll: true });
+  };
+});
diff --git a/tests/section-views.test.mjs b/tests/section-views.test.mjs
new file mode 100644
index 0000000..c415a15
--- /dev/null
+++ b/tests/section-views.test.mjs
@@ -0,0 +1,160 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { stripTypeScriptTypes } from 'node:module';
+import test from 'node:test';
+import vm from 'node:vm';
+import { Window } from 'happy-dom';
+
+const source = stripTypeScriptTypes(readFileSync(new URL('../src/scripts/section-views.ts', import.meta.url), 'utf8'));
+const base = 'https://example.com/devtools-times/';
+const hostSelector = '[data-section-views]';
+
+function setup(initial = base) {
+  const window = new Window({ url: initial });
+  const { document } = window;
+  function page(url, section = true) {
+    const parsed = new URL(url);
+    const key = parsed.pathname.replace(/\/$/, '') + parsed.search;
+    return new window.DOMParser().parseFromString(`<!doctype html><html><head><title>${key}</title></head><body>
+      <astro-island props="{}"><button>Header</button></astro-island>
+      <main>${section ? `<div data-section-views data-astro-transition-persist="section-views">
+        <div data-section-view="${key}" tabindex="-1"><input value="initial"><button>Count</button></div>
+      </div>` : '<h1>Article</h1>'}</main></body></html>`, 'text/html');
+  }
+  const first = page(initial);
+  document.head.replaceWith(first.head);
+  document.body.replaceWith(first.body);
+  vm.runInNewContext(source, { document, location: window.location, URL });
+
+  function emit(type, properties = {}) {
+    const event = Object.assign(new window.Event(type), properties);
+    document.dispatchEvent(event);
+    return event;
+  }
+  emit('astro:page-load');
+  let loads = 0;
+  async function prepare(path, { section = true, formData, origin = base } = {}) {
+    const to = new URL(path, origin);
+    const event = emit('astro:before-preparation', {
+      to, from: new URL(window.location.href), formData,
+      loader: async () => { loads++; event.newDocument = page(to, section); },
+    });
+    await event.loader();
+    return event;
+  }
+  function commit(preparation) {
+    const event = emit('astro:before-swap', {
+      to: preparation.to, newDocument: preparation.newDocument,
+      // Model Astro's documented transition:persist swap contract. Keep the
+      // actual host and its custom elements connected until after-swap fires.
+      swap() {
+        const host = document.querySelector(hostSelector);
+        const placeholder = preparation.newDocument.querySelector(hostSelector);
+        if (host && placeholder) document.documentElement.append(host);
+        document.head.replaceWith(preparation.newDocument.head);
+        document.body.replaceWith(preparation.newDocument.body);
+        if (host && placeholder) placeholder.replaceWith(host);
+      },
+    });
+    event.swap();
+    window.happyDOM.setURL(preparation.to.href);
+    emit('astro:after-swap');
+    emit('astro:page-load');
+  }
+  return { window, document, prepare, commit, get loads() { return loads; } };
+}
+
+test('returning to a view reuses its exact DOM, input state, and listeners without loading it', async () => {
+  const app = setup();
+  const home = app.document.querySelector('[data-section-view]');
+  const input = home.querySelector('input');
+  input.value = 'Keep this edit';
+  let clicks = 0;
+  home.querySelector('button').addEventListener('click', () => clicks++);
+  input.focus();
+
+  app.commit(await app.prepare('reports'));
+  const reports = app.document.querySelector('[data-section-view]:not([hidden])');
+  assert.equal(home.isConnected, true);
+  assert.equal(home.hidden, true);
+  assert.equal(home.inert, true);
+  assert.equal(app.document.activeElement, reports);
+  reports.querySelector('input').value = 'Report filter';
+
+  const back = await app.prepare(base);
+  assert.equal(app.loads, 1);
+  assert.equal(back.newDocument.querySelector('[data-section-view]'), null);
+  assert.equal(back.newDocument.querySelector('astro-island').hasAttribute('ssr'), true);
+  app.commit(back);
+  assert.equal(app.document.querySelector('[data-section-view]:not([hidden])'), home);
+  assert.equal(home.querySelector('input'), input);
+  assert.equal(input.value, 'Keep this edit');
+  home.querySelector('button').click();
+  assert.equal(clicks, 1);
+  assert.equal(home.inert, false);
+  assert.equal(reports.hidden, true);
+
+  app.commit(await app.prepare('reports#latest'));
+  assert.equal(app.loads, 1);
+  assert.equal(reports.querySelector('input').value, 'Report filter');
+  assert.equal(app.document.querySelectorAll('[data-section-view]').length, 2);
+});
+
+test('query strings have distinct views and canceled preparations do not hide the active view', async () => {
+  const app = setup();
+  const home = app.document.querySelector('[data-section-view]');
+  await app.prepare('reports'); // Navigation superseded before a swap.
+  assert.equal(home.hidden, false);
+  assert.equal(app.document.querySelectorAll('[data-section-view]').length, 1);
+
+  app.commit(await app.prepare('reports?sort=latest'));
+  app.commit(await app.prepare('reports?sort=oldest'));
+  app.commit(await app.prepare('reports?sort=latest#results'));
+  assert.equal(app.loads, 3);
+  assert.equal(app.document.querySelectorAll('[data-section-view]').length, 3);
+});
+
+test('all main sections retain mounted elements when entered through a direct category URL', async () => {
+  const app = setup(`${base}category/politics`);
+  const panels = new Map();
+  let unmounts = 0;
+  // Astro islands defer unmounting until after-swap and only unmount when the
+  // island is no longer connected. Exercise that lifecycle without a browser.
+  app.window.customElements.define('stateful-content', class extends app.window.HTMLElement {
+    disconnectedCallback() {
+      app.document.addEventListener('astro:after-swap', () => {
+        if (!this.isConnected) unmounts++;
+      }, { once: true });
+    }
+  });
+
+  for (const section of ['category/politics', '', 'world', 'multimedia', 'reports']) {
+    if (section !== 'category/politics') app.commit(await app.prepare(section || base));
+    const panel = app.document.querySelector('[data-section-view]:not([hidden])');
+    panel.append(app.document.createElement('stateful-content'));
+    panels.set(section, panel);
+  }
+  for (const [section, panel] of panels) {
+    app.commit(await app.prepare(section || base));
+    assert.equal(app.document.querySelector('[data-section-view]:not([hidden])'), panel);
+    assert.equal(panel.querySelector('stateful-content').isConnected, true);
+  }
+  assert.equal(app.loads, 4);
+  assert.equal(app.document.querySelectorAll('[data-section-view]').length, 5);
+  assert.equal(unmounts, 0);
+});
+
+test('forms and other origins use the regular loader; leaving sections releases the cache', async () => {
+  const app = setup();
+  app.commit(await app.prepare('reports'));
+  await app.prepare(base, { formData: new app.window.FormData() });
+  await app.prepare('https://other.example/devtools-times/');
+  assert.equal(app.loads, 3);
+
+  app.commit(await app.prepare('articles/example', { section: false }));
+  assert.equal(app.document.querySelector(hostSelector), null);
+  app.commit(await app.prepare(base));
+  app.commit(await app.prepare('reports'));
+  assert.equal(app.loads, 6);
+  assert.equal(app.document.querySelectorAll('[data-section-view]').length, 2);
+});
