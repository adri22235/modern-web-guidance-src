diff --git a/tests/navigation.test.cjs b/tests/navigation.test.cjs
new file mode 100644
index 0000000..b8ac560
--- /dev/null
+++ b/tests/navigation.test.cjs
@@ -0,0 +1,90 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+// A small DOM adapter exercises the router without a browser or server.
+function setup(hash = '#/') {
+  const clones = {};
+  const node = (extra = {}) => ({
+    hidden: false, value: '', listeners: {},
+    addEventListener(type, callback) { this.listeners[type] = callback; },
+    focus() {}, ...extra,
+  });
+  function makeView(name) {
+    const controls = {
+      '.view-heading': node(),
+      '#menu-category': node({ value: 'all', options: ['all', 'seasonal', 'espresso', 'cold-brew'].map(value => ({ value })) }),
+      '#location-search': node(), '#location-empty': node(),
+      '#account-form': node(), '#account-status': node(),
+      '#account-name': node(), details: node({ open: false }),
+    };
+    const cards = ['seasonal', 'espresso', 'cold-brew'].map(category => node({ dataset: { category } }));
+    const locations = [node({ dataset: { location: 'The Daily Grind' } })];
+    return node({ name, querySelector: selector => controls[selector],
+      querySelectorAll: selector => selector === '[data-category]' ? cards : locations });
+  }
+  const home = makeView('home');
+  const children = [home];
+  const host = { querySelector: () => home, append: view => children.push(view) };
+  const links = ['/', '/menu', '/locations', '/rewards', '/account'].map(path => ({
+    attrs: { href: `#${path}` }, getAttribute(key) { return this.attrs[key]; },
+    setAttribute(key, value) { this.attrs[key] = value; }, removeAttribute(key) { delete this.attrs[key]; },
+  }));
+  const document = {
+    querySelector: selector => selector === '#views' ? host : {
+      content: { firstElementChild: { cloneNode() {
+        const name = selector.replace('#view-', '');
+        clones[name] = (clones[name] || 0) + 1;
+        return makeView(name);
+      } } },
+    },
+    querySelectorAll: () => links,
+  };
+  const location = { hash };
+  const listeners = {};
+  const window = { scrollY: 0, addEventListener: (type, callback) => { listeners[type] = callback; },
+    scrollTo: (x, y) => { window.scrollY = y; } };
+  runInNewContext(readFileSync(require.resolve('../app.js'), 'utf8'), {
+    document, location, window, history: { scrollRestoration: 'auto' }, URLSearchParams,
+    requestAnimationFrame: callback => { callback(); return 1; }, cancelAnimationFrame() {},
+  });
+  return { children, clones, links, document, window,
+    go(hash) { location.hash = hash; listeners.hashchange(); return children.find(view => !view.hidden); } };
+}
+
+test('mounts views lazily and reuses nodes, controls, listeners, and scroll state', () => {
+  const app = setup();
+  assert.equal(app.children.length, 1);
+  const account = app.go('#/account');
+  account.querySelector('#account-name').value = 'Alex';
+  const submit = account.querySelector('#account-form').listeners.submit;
+  submit({ preventDefault() {} });
+  app.window.scrollY = 240;
+  const rewards = app.go('#/rewards');
+  rewards.querySelector('details').open = true;
+  app.go('#/locations');
+  assert.equal(app.go('#/account'), account);
+  assert.equal(account.querySelector('#account-name').value, 'Alex');
+  assert.equal(account.querySelector('#account-form').listeners.submit, submit);
+  assert.equal(account.querySelector('#account-status').textContent, 'Preferences kept for this visit.');
+  assert.equal(app.window.scrollY, 240);
+  assert.equal(app.go('#/rewards').querySelector('details').open, true);
+  assert.equal(app.children.filter(view => !view.hidden).length, 1);
+  assert.deepEqual(app.clones, { account: 1, rewards: 1, locations: 1 });
+});
+
+test('supports deep links, retained filters, active links, and unknown routes', () => {
+  const app = setup('#/menu?category=espresso');
+  const menu = app.children.find(view => view.name === 'menu');
+  assert.equal(menu.querySelector('#menu-category').value, 'espresso');
+  assert.equal(menu.querySelectorAll('[data-category]').filter(card => !card.hidden).length, 1);
+  app.go('#/locations');
+  assert.equal(app.go('#/menu'), menu);
+  assert.equal(menu.querySelector('#menu-category').value, 'espresso');
+  assert.equal(app.links[1].attrs['aria-current'], 'page');
+  assert.equal(app.document.title, 'The Daily Grind | Menu');
+  assert.equal(app.go('#/missing').name, 'home');
+  assert.equal(app.links[1].attrs['aria-current'], undefined);
+  assert.equal(app.clones.menu, 1);
+});
