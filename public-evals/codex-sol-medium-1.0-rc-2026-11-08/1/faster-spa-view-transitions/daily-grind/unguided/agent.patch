+(() => {
+  const host = document.querySelector('#views');
+  // Keep the actual nodes mounted: inputs, details, and event listeners survive navigation.
+  const views = new Map([['home', host.querySelector('[data-view="home"]')]]);
+  const scrollPositions = new Map();
+  const names = { home: 'Home', menu: 'Menu', locations: 'Locations', rewards: 'Rewards', account: 'My Account' };
+  let activeView;
+  let pendingScroll;
+
+  function filterMenu(view) {
+    const category = view.querySelector('#menu-category').value;
+    view.querySelectorAll('[data-category]').forEach(card => {
+      card.hidden = category !== 'all' && card.dataset.category !== category;
+    });
+  }
+
+  function mount(name) {
+    if (views.has(name)) return views.get(name);
+    const view = document.querySelector(`#view-${name}`).content.firstElementChild.cloneNode(true);
+    view.hidden = true;
+    host.append(view);
+    views.set(name, view);
+
+    if (name === 'menu') {
+      view.querySelector('#menu-category').addEventListener('change', () => filterMenu(view));
+    } else if (name === 'locations') {
+      view.querySelector('#location-search').addEventListener('input', event => {
+        const query = event.target.value.trim().toLowerCase();
+        const cards = [...view.querySelectorAll('[data-location]')];
+        cards.forEach(card => { card.hidden = !card.dataset.location.toLowerCase().includes(query); });
+        view.querySelector('#location-empty').hidden = cards.some(card => !card.hidden);
+      });
+    } else if (name === 'account') {
+      view.querySelector('#account-form').addEventListener('submit', event => {
+        event.preventDefault();
+        view.querySelector('#account-status').textContent = 'Preferences kept for this visit.';
+      });
+    }
+    return view;
+  }
+
+  function navigate() {
+    const [path, query = ''] = location.hash.slice(1).split('?');
+    const requested = (path || '/').replace(/^\//, '').replace(/\/$/, '') || 'home';
+    const name = Object.hasOwn(names, requested) ? requested : 'home';
+    const switching = activeView !== name;
+    cancelAnimationFrame(pendingScroll);
+    if (activeView && switching) scrollPositions.set(activeView, window.scrollY);
+    const view = mount(name);
+    if (switching) {
+      views.forEach((node, key) => { node.hidden = key !== name; });
+      activeView = name;
+    }
+
+    if (name === 'menu') {
+      const category = new URLSearchParams(query).get('category');
+      const select = view.querySelector('#menu-category');
+      if (category && [...select.options].some(option => option.value === category)) {
+        select.value = category;
+        filterMenu(view);
+      }
+    }
+
+    document.querySelectorAll('nav a').forEach(link => {
+      if (link.getAttribute('href') === (name === 'home' ? '#/' : `#/${name}`)) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    });
+    document.title = `The Daily Grind | ${names[name]}`;
+    if (switching) {
+      view.querySelector('.view-heading').focus({ preventScroll: true });
+      pendingScroll = requestAnimationFrame(() => window.scrollTo(0, scrollPositions.get(name) || 0));
+    }
+  }
+
+  // Hash routes work on static hosts and support reloads, deep links, and Back/Forward.
+  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', navigate);
+  navigate();
+})();
