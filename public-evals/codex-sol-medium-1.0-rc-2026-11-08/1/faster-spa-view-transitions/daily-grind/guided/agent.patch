index 0000000..d5f9449
--- /dev/null
+++ b/app.js
@@ -0,0 +1,59 @@
+// This bounded set of views stays mounted for the entire visit. Switching views
+// never replaces nodes, so form values, disclosures, and listeners survive.
+const views = new Map(
+  ['home', 'menu', 'locations', 'rewards', 'account'].map((name) => [
+    name, document.getElementById(`view-${name}`),
+  ]),
+);
+const navigationLinks = document.querySelectorAll('nav a[href^="#/"]');
+const scrollPositions = new Map();
+let currentView;
+
+if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
+
+function showView({ initial = false } = {}) {
+  const route = location.hash.slice(2) || 'home';
+  const name = location.hash.startsWith('#/') && views.has(route) ? route : 'home';
+  if (name === currentView) return;
+
+  if (currentView) scrollPositions.set(currentView, window.scrollY);
+  const nextView = views.get(name);
+  nextView.classList.remove('inactive');
+  nextView.removeAttribute('aria-hidden');
+  nextView.removeAttribute('inert');
+
+  // Move focus before making the outgoing view inaccessible.
+  if (!initial) nextView.querySelector('h1').focus();
+  for (const [viewName, view] of views) {
+    if (viewName === name) continue;
+    view.classList.add('inactive');
+    view.setAttribute('inert', '');
+    view.setAttribute('aria-hidden', 'true');
+  }
+
+  for (const link of navigationLinks) {
+    const active = link.hash === (name === 'home' ? '#/' : `#/${name}`);
+    if (active) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  }
+
+  currentView = name;
+  document.title = name === 'home'
+    ? 'The Daily Grind | Artisanal Coffee'
+    : `${nextView.querySelector('h1').textContent} | The Daily Grind`;
+  if (!initial) window.scrollTo({ top: scrollPositions.get(name) || 0, behavior: 'instant' });
+}
+
+window.addEventListener('hashchange', () => showView());
+showView({ initial: true });
+
+document.getElementById('menu-category').addEventListener('change', (event) => {
+  for (const item of document.querySelectorAll('#menu-items [data-category]')) {
+    item.hidden = event.target.value !== 'all' && item.dataset.category !== event.target.value;
+  }
+});
+
+document.getElementById('preferences-form').addEventListener('submit', (event) => {
+  event.preventDefault();
+  document.getElementById('preferences-status').textContent = 'Preferences saved for this visit.';
+});
