+  <script>
+    const tablist = document.querySelector('.wholesale-tabs');
+    const tabs = [...tablist.querySelectorAll('.wholesale-tab')];
+    const panels = [...document.querySelectorAll('.business-panel')];
+    const couponButton = document.getElementById('reveal-coupon');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function selectTab(index) {
+      tabs.forEach((tab, tabIndex) => {
+        const selected = tabIndex === index;
+        tab.setAttribute('aria-selected', String(selected));
+        tab.tabIndex = selected ? 0 : -1;
+        if (selected) {
+          panels[tabIndex].removeAttribute('hidden');
+          panels[tabIndex].tabIndex = 0;
+        } else {
+          panels[tabIndex].setAttribute('hidden', 'until-found');
+          panels[tabIndex].removeAttribute('tabindex');
+        }
+      });
+    }
+
+    function revealCoupon() {
+      couponPanel.removeAttribute('hidden');
+      couponButton.setAttribute('aria-expanded', 'true');
+      couponButton.textContent = 'Coupon Revealed';
+    }
+
+    if ('onbeforematch' in HTMLElement.prototype) {
+      tabs.forEach((tab, index) => {
+        tab.addEventListener('click', () => selectTab(index));
+        tab.addEventListener('focus', () => selectTab(index));
+        tab.addEventListener('keydown', (event) => {
+          let nextIndex;
+          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
+          else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
+          else if (event.key === 'Home') nextIndex = 0;
+          else if (event.key === 'End') nextIndex = tabs.length - 1;
+          else return;
+          event.preventDefault();
+          tabs[nextIndex].focus();
+        });
+        panels[index].addEventListener('beforematch', () => selectTab(index));
+      });
+      couponButton.addEventListener('click', revealCoupon);
+      couponPanel.addEventListener('beforematch', revealCoupon);
+    } else {
+      // Native find-in-page cannot be polyfilled: expose content in reading order.
+      tablist.removeAttribute('role');
+      tablist.removeAttribute('aria-label');
+      panels.forEach((panel, index) => {
+        panel.removeAttribute('hidden');
+        panel.setAttribute('role', 'region');
+        panel.tabIndex = 0;
+        const link = document.createElement('a');
+        link.id = tabs[index].id;
+        link.className = 'wholesale-tab';
+        link.href = '#' + panel.id;
+        link.textContent = tabs[index].textContent;
+        tabs[index].replaceWith(link);
+      });
+      revealCoupon();
+      couponButton.disabled = true;
+    }
+  </script>
+
