+  <script>
+    const contactForm = document.querySelector('.contact-form');
+    const fields = [...contactForm.querySelectorAll('input, textarea')];
+    const touchedFields = new Set();
+    const formStatus = contactForm.querySelector('.form-status');
+
+    // Enable custom feedback only when JavaScript is available.
+    contactForm.noValidate = true;
+
+    function validateField(field) {
+      field.setCustomValidity('');
+      let error = '';
+      if (!field.value.trim()) {
+        error = field.name === 'message' ? 'Please enter a message.' : `Please enter your ${field.name}.`;
+      } else if (field.validity.typeMismatch) {
+        error = 'Please enter a valid email address, such as name@example.com.';
+      }
+      field.setCustomValidity(error);
+      field.closest('.field').classList.toggle('is-invalid', Boolean(error));
+      field.setAttribute('aria-invalid', String(Boolean(error)));
+      const feedback = document.getElementById(field.getAttribute('aria-describedby'));
+      feedback.textContent = error;
+      feedback.hidden = !error;
+      return !error;
+    }
+
+    fields.forEach((field) => {
+      field.addEventListener('blur', () => {
+        touchedFields.add(field);
+        validateField(field);
+      });
+      field.addEventListener('input', () => {
+        formStatus.textContent = '';
+        if (touchedFields.has(field)) validateField(field);
+      });
+    });
+
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      formStatus.textContent = '';
+      fields.forEach((field) => {
+        touchedFields.add(field);
+        validateField(field);
+      });
+      const firstInvalid = fields.find((field) => !field.validity.valid);
+      if (firstInvalid) {
+        firstInvalid.focus();
+        return;
+      }
+      formStatus.textContent = 'Online sending is currently unavailable. Your message has not been sent.';
+    });
+  </script>
+
 </body>
 
