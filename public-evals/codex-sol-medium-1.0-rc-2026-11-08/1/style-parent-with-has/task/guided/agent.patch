+  <script>
+    const contactForm = document.getElementById('contact-form');
+    const contactStatus = document.getElementById('contact-status');
+
+    const syncContactField = (field) => {
+      // Native interaction state keeps both visual and spoken errors quiet initially.
+      if (field.matches(':user-invalid')) {
+        field.setAttribute('aria-invalid', 'true');
+      } else {
+        field.removeAttribute('aria-invalid');
+      }
+    };
+
+    contactForm.querySelectorAll('input, textarea').forEach((field) => {
+      const validateContent = () => {
+        // Required text must contain more than spaces, including in the textarea.
+        field.setCustomValidity(field.value && !field.value.trim()
+          ? 'Please enter more than spaces.' : '');
+      };
+
+      field.addEventListener('blur', () => {
+        validateContent();
+        requestAnimationFrame(() => syncContactField(field));
+      });
+      field.addEventListener('input', () => {
+        validateContent();
+        contactStatus.textContent = '';
+        syncContactField(field);
+      });
+      // Invalid events also cover fields that were skipped before submission.
+      field.addEventListener('invalid', () => {
+        requestAnimationFrame(() => syncContactField(field));
+      });
+    });
+
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      contactStatus.textContent = 'Your details are valid. Message delivery is not connected yet; your message has not been sent.';
+    });
+  </script>
+
 </body>
 
