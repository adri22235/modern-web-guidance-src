--- /dev/null
+++ b/src/components/Popover.tsx
@@ -0,0 +1,32 @@
+import { useId, useRef, useState, type ReactNode } from 'react';
+
+export default function Popover({ label, children, active = false }: {
+  label: ReactNode; children: ReactNode; active?: boolean;
+}) {
+  const id = useId();
+  const trigger = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  return (
+    <div className="h-full flex items-center">
+      <button ref={trigger} type="button" popoverTarget={id} aria-expanded={open} aria-controls={id}
+        className={`flex items-center gap-1 whitespace-nowrap hover:underline ${active ? 'text-amber-700' : ''}`}>
+        {label}<span aria-hidden="true">⌄</span>
+      </button>
+      <div id={id} popover="auto" className="nav-popover bg-white border border-gray-300 shadow-lg p-6"
+        onBeforeToggle={event => {
+          if (event.newState !== 'open') return;
+          const rect = trigger.current!.getBoundingClientRect();
+          event.currentTarget.style.setProperty('--popover-top', `${rect.bottom + 8}px`);
+        }}
+        onToggle={event => {
+          setOpen(event.newState === 'open');
+          if (event.newState === 'closed' && event.currentTarget.contains(document.activeElement)) trigger.current?.focus();
+        }}
+        onClick={event => {
+          if ((event.target as HTMLElement).closest('a')) event.currentTarget.hidePopover();
+        }}>
+        {children}
+      </div>
+    </div>
+  );
+}
