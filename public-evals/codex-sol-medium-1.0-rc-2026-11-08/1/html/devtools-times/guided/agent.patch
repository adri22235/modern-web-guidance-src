+import { useId, useMemo, useState } from 'react';
+import ModalDialog from './ModalDialog';
+import type { ArticleSummary } from '../types/article';
+
+export default function SearchFlyout({ id, articles, onClose }: {
+  id: string; articles: ArticleSummary[]; onClose: () => void;
+}) {
+  const [searchTerm, setSearchTerm] = useState('');
+  const inputId = useId();
+  const query = searchTerm.trim().toLowerCase();
+  const results = useMemo(() => query ? articles.filter(article =>
+    `${article.title} ${article.summary}`.toLowerCase().includes(query)) : [], [articles, query]);
+
+  return <ModalDialog id={id} title="Search articles" onClose={onClose}>
+    <search className="block p-4">
+      <label htmlFor={inputId} className="block text-sm font-semibold mb-2">Search by title or topic</label>
+      <input id={inputId} type="search" name="q" autoFocus value={searchTerm}
+        onChange={event => setSearchTerm(event.target.value)} placeholder="Search for articles…"
+        className="w-full p-2 border border-gray-300 rounded-md" />
+      <p role="status" className="text-sm text-gray-600 mt-2">{query ? `${results.length} results found.` : 'Enter a title or topic to search.'}</p>
+    </search>
+    <div className="p-4">
+      {!query && <section aria-label="Featured articles">
+        <h3 className="font-semibold mb-3">Featured</h3>
+        <ul className="grid grid-cols-1 sm:grid-cols-3 gap-4">
+          {articles.slice(0, 3).map(article => <li key={article.slug}>
+            <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block p-2 hover:bg-gray-100">
+              {article.image && <img src={article.image} srcSet={article.srcSet}
+                sizes="(min-width: 704px) 187px, (min-width: 640px) calc((100vw - 144px) / 3), calc(100vw - 80px)"
+                width={480} height={270} loading="lazy" decoding="async" alt="" className="w-full h-20 object-cover mb-2" />}
+              <h4 className="font-bold text-sm">{article.title}</h4>
+            </a>
+          </li>)}
+        </ul>
+      </section>}
+      {query && <ul className="space-y-2">{results.map(article => <li key={article.slug}>
+        <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md">
+          <h3 className="font-bold text-lg">{article.title}</h3>
+          <p className="text-sm text-gray-600">{article.summary}</p>
+        </a>
+      </li>)}</ul>}
+    </div>
+  </ModalDialog>;
 }
