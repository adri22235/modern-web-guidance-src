+export default function SearchFlyout({ onClose }: { onClose: () => void }) {
+  const [searchTerm, setSearchTerm] = useState('');
+  const [articles, setArticles] = useState<Article[]>([]);
+  const [status, setStatus] = useState('Loading articles…');
+
+  useEffect(() => {
+    const controller = new AbortController();
+    fetch(`${import.meta.env.BASE_URL}api/articles.json`, { signal: controller.signal })
+      .then(response => {
+        if (!response.ok) throw new Error('Unable to load articles');
+        return response.json();
+      })
+      .then(data => { setArticles(data); setStatus(''); })
+      .catch(error => { if (error.name !== 'AbortError') setStatus('Articles could not be loaded. Please reopen search to try again.'); });
+    return () => controller.abort();
+  }, []);
+
+  const query = searchTerm.trim().toLowerCase();
+  const results = useMemo(() => articles.filter(article => `${article.title} ${article.summary}`.toLowerCase().includes(query)), [articles, query]);
+
+  return (
+    <Modal id="search-dialog" title="Search articles" onClose={onClose}>
+      <form role="search" onSubmit={event => event.preventDefault()} className="p-4">
+        <label htmlFor="article-search" className="block font-semibold mb-2">Search</label>
+        <input id="article-search" name="q" type="search" autoComplete="off" autoFocus placeholder="Search for articles…" className="w-full p-2 border border-gray-300 rounded-md" value={searchTerm} onChange={event => setSearchTerm(event.target.value)} aria-controls="search-results" />
+      </form>
+      <div className="p-4">
+        <p role="status" className="text-gray-600 mb-3">{status || (query ? `${results.length} results for “${searchTerm.trim()}”` : 'Featured articles')}</p>
+        <ul id="search-results" className="space-y-2">
+          {(query ? results : articles.slice(0, 3)).map(article => (
+            <li key={article.slug}>
+              <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md">
+                <h3 className="font-bold text-lg text-gray-800">{article.title}</h3>
+                <p className="text-sm text-gray-600">{article.summary}</p>
+              </a>
+            </li>
+          ))}
+        </ul>
+      </div>
+    </Modal>
+  );
 }
