diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..113c961
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({ id, title, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const closeRef = useRef(onClose);
+  closeRef.current = onClose;
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    const opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (opener?.isConnected) opener.focus();
+    };
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      id={id}
+      aria-labelledby={`${id}-title`}
+      className="modal bg-white shadow-xl w-full max-w-2xl"
+      onClose={() => closeRef.current()}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <header className="flex items-center justify-between gap-4 p-4 border-b border-gray-200">
+        <h2 id={`${id}-title`} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <button type="button" onClick={() => dialogRef.current?.close()} aria-label={`Close ${title.toLowerCase()}`} className="p-2 text-gray-600 hover:text-amber-700">
+          <span aria-hidden="true">✕</span>
+        </button>
+      </header>
+      {children}
+    </dialog>
+  );
+}
diff --git a/src/components/NativePopover.tsx b/src/components/NativePopover.tsx
new file mode 100644
index 0000000..14fbd50
--- /dev/null
+++ b/src/components/NativePopover.tsx
@@ -0,0 +1,39 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  label: string;
+  children: ReactNode;
+  compact?: boolean;
+}
+
+export default function NativePopover({ id, label, children, compact = false }: Props) {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const panel = ref.current!;
+    const position = () => {
+      if (!panel.matches(':popover-open')) return;
+      const trigger = Array.from(document.querySelectorAll<HTMLButtonElement>('[popovertarget]')).find(button => button.getAttribute('popovertarget') === id);
+      if (!trigger) return;
+      const bounds = trigger.getBoundingClientRect();
+      panel.style.top = `${Math.max(8, Math.min(bounds.bottom, window.innerHeight - panel.offsetHeight - 8))}px`;
+      panel.style.left = `${Math.max(8, Math.min(bounds.left, window.innerWidth - panel.offsetWidth - 8))}px`;
+    };
+    panel.addEventListener('toggle', position);
+    window.addEventListener('resize', position);
+    window.addEventListener('scroll', position, true);
+    return () => {
+      panel.removeEventListener('toggle', position);
+      window.removeEventListener('resize', position);
+      window.removeEventListener('scroll', position, true);
+    };
+  }, [id]);
+
+  return (
+    <div ref={ref} id={id} popover="auto" role="group" aria-label={label}
+      className={`navigation-popover bg-white border border-gray-300 shadow-lg ${compact ? 'navigation-popover-compact' : ''}`}>
+      {children}
+    </div>
+  );
+}
