+    /* Keep spacing inside the inner wrapper so collapsed panels take no space. */
+    .collapsible {
+      display: grid;
+      grid-template-rows: 1fr;
+      overflow: hidden;
+      visibility: visible;
+      transition: grid-template-rows 0.35s ease, visibility 0s;
+    }
+
+    .collapsible.is-collapsed {
+      grid-template-rows: 0fr;
+      visibility: hidden;
+      transition-delay: 0s, 0.35s;
+    }
+
+    .collapsible-inner {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    @supports (interpolate-size: allow-keywords) {
+      .collapsible {
+        display: block;
+        interpolate-size: allow-keywords;
+        block-size: auto;
+        transition-property: block-size, visibility;
+      }
+
+      .collapsible.is-collapsed {
+        block-size: 0;
+      }
