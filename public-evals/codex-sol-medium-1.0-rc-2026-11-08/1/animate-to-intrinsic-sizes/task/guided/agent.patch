+  <script>
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+
+    faqTrigger.addEventListener('click', () => {
+      const expanded = faqTrigger.getAttribute('aria-expanded') !== 'true';
+      faqTrigger.setAttribute('aria-expanded', String(expanded));
+      faqContent.setAttribute('aria-hidden', String(!expanded));
+      faqContent.inert = !expanded;
+      faqContent.classList.toggle('is-collapsed', !expanded);
+    });
+
+    alertDismiss.addEventListener('click', () => {
+      if (promoAlert.contains(document.activeElement)) {
+        document.querySelector('nav a').focus({ preventScroll: true });
+      }
+      promoAlert.inert = true;
+      promoAlert.setAttribute('aria-hidden', 'true');
+      promoAlert.classList.add('is-collapsed');
+    });
+  </script>
