+  <script>
+    const animations = new WeakMap();
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function setExpanded(element, expanded) {
+      // Capture the visible height before cancelling an interrupted transition.
+      const startHeight = element.getBoundingClientRect().height;
+      animations.get(element)?.cancel();
+      element.hidden = false;
+      element.inert = !expanded;
+      element.style.height = 'auto';
+      const endHeight = expanded ? element.scrollHeight : 0;
+
+      const finish = () => {
+        element.hidden = !expanded;
+        element.style.height = '';
+        animations.delete(element);
+      };
+
+      if (reducedMotion.matches || !element.animate) {
+        finish();
+        return;
+      }
+
+      const animation = element.animate(
+        [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
+        { duration: 300, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'both' }
+      );
+      animations.set(element, animation);
+      animation.onfinish = () => {
+        finish();
+        // Restore natural sizing so wrapped or updated content stays responsive.
+        animation.cancel();
+      };
+    }
+
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+    faqTrigger.addEventListener('click', () => {
+      const expanded = faqTrigger.getAttribute('aria-expanded') !== 'true';
+      faqTrigger.setAttribute('aria-expanded', String(expanded));
+      setExpanded(faqContent, expanded);
+    });
+
+    document.getElementById('alert-dismiss').addEventListener('click', () => {
+      // Keep keyboard focus on the page when its dismiss button disappears.
+      document.querySelector('nav a').focus({ preventScroll: true });
+      setExpanded(document.getElementById('promo-alert'), false);
+    });
+  </script>
