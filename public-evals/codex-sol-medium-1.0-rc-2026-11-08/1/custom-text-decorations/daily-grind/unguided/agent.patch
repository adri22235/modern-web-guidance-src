       background-color: var(--light);
     }
 
+    /* Native decorations retain ink skipping; a separate, hidden-from-AT
+       copy lets the line reveal without clipping or moving the readable text. */
+    .text-line {
+      --line-color: var(--accent);
+      --line-offset: 0.22em;
+      --line-thickness: 2px;
+      --line-inset-start: 0.06em;
+      --line-inset-end: 0.06em;
+      position: relative;
+      display: inline-block;
+    }
+
+    .text-line__ink {
+      position: absolute;
+      inset: 0;
+      color: transparent;
+      pointer-events: none;
+      user-select: none;
+      text-decoration-line: underline;
+      text-decoration-color: var(--line-color);
+      text-decoration-thickness: var(--line-thickness);
+      text-underline-offset: var(--line-offset);
+      text-decoration-skip-ink: auto;
+      /* Negative block insets leave room for the offset underline. */
+      clip-path: inset(-0.5em 100% -0.5em var(--line-inset-start));
+      transition: clip-path 450ms cubic-bezier(0.22, 1, 0.36, 1);
+    }
+
+    a:hover .text-line__ink,
+    a:focus-visible .text-line__ink {
+      clip-path: inset(-0.5em var(--line-inset-end) -0.5em var(--line-inset-start));
+    }
+
+    a:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 5px;
+    }
+
+    .seasonal-heading {
+      text-align: center;
+    }
+
+    .seasonal-heading .text-line {
+      --line-offset: 0.3em;
+      --line-thickness: 3px;
+      --line-inset-start: 0.65em;
+      --line-inset-end: 0.65em;
+    }
+
+    .card .text-line {
+      --line-color: var(--secondary);
+      --line-offset: 0.18em;
+      --line-inset-start: 0.25em;
+      --line-inset-end: 0.25em;
+    }
+
+    .seasonal-heading .text-line__ink,
+    .card .text-line__ink {
+      animation: reveal-line 850ms cubic-bezier(0.22, 1, 0.36, 1) both;
+    }
+
+    .card:nth-child(1) .text-line__ink { animation-delay: 150ms; }
+    .card:nth-child(2) .text-line__ink { animation-delay: 300ms; }
+    .card:nth-child(3) .text-line__ink { animation-delay: 450ms; }
+
+    .footer-links .text-line {
+      --line-color: var(--primary);
+      --line-offset: 0.25em;
+      --line-thickness: 1px;
+      --line-inset-start: 0.12em;
+      --line-inset-end: 0.12em;
+    }
+
+    @keyframes reveal-line {
+      from { clip-path: inset(-0.5em 100% -0.5em var(--line-inset-start)); }
+      to { clip-path: inset(-0.5em var(--line-inset-end) -0.5em var(--line-inset-start)); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .text-line__ink {
+        transition: none;
+      }
+
+      .seasonal-heading .text-line__ink,
+      .card .text-line__ink {
+        animation: none;
+        clip-path: inset(-0.5em var(--line-inset-end) -0.5em var(--line-inset-start));
+      }
+    }
+
