diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..ca84448
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,124 @@
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'aria-label'];
+
+  #internals = this.attachInternals();
+  #value = '';
+  #disabled = false;
+  #showError = false;
+  #inputs;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; gap: 8px; width: fit-content; }
+        label { position: relative; display: grid; place-items: center; width: 53px; height: 55px; border: 1px solid #ded4c9; border-radius: 9px; background: #fffdfa; color: #c8beb2; cursor: pointer; transition: background .15s, border-color .15s; }
+        svg { width: 29px; height: 29px; fill: none; stroke: currentColor; stroke-width: 1.5; pointer-events: none; }
+        label.selected { color: #a36b29; border-color: #d8b47c; background: #fbf1df; }
+        label.selected svg { fill: #dca552; stroke: #a36b29; }
+        label:hover { border-color: #a36b29; background: #fbf1df; }
+        label:has(input:focus-visible) { outline: 3px solid #4e342e; outline-offset: 3px; }
+        input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
+        .description { margin: 10px 0 0; color: #807166; font: inherit; font-size: 13px; }
+        .error { color: #a33228; margin: 6px 0 0; font-size: 13px; }
+        [hidden] { display: none; }
+        :host(:disabled) label { opacity: .45; cursor: not-allowed; }
+        @media (max-width: 380px) { label { width: 44px; height: 49px; } .stars { gap: 6px; } }
+      </style>
+      <div class="stars" role="radiogroup" aria-label="Coffee rating" aria-describedby="description error">
+        ${[1, 2, 3, 4, 5].map(value => `
+          <label>
+            <input type="radio" name="stars" value="${value}" aria-label="${value} ${value === 1 ? 'star' : 'stars'}">
+            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m16 3 3.9 8 8.8 1.3-6.4 6.2 1.5 8.8L16 23.1l-7.8 4.2 1.5-8.8-6.4-6.2 8.8-1.3Z"/></svg>
+          </label>`).join('')}
+      </div>
+      <p class="description" id="description" aria-live="polite">Choose your stars, from 1 to 5.</p>
+      <p class="error" id="error" hidden>Please select a coffee rating.</p>`;
+    this.#inputs = [...root.querySelectorAll('input')];
+    root.addEventListener('change', event => {
+      if (!(event.target instanceof HTMLInputElement) || this.#disabled) return;
+      this.value = event.target.value;
+      this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'value') this.value = newValue;
+    else this.#render();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    const normalized = String(value ?? '');
+    this.#value = /^[1-5]$/.test(normalized) ? normalized : '';
+    this.#render();
+  }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get type() { return 'star-rating'; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  focus(options) { (this.#inputs.find(input => input.checked) ?? this.#inputs[0]).focus(options); }
+
+  formDisabledCallback(disabled) {
+    this.#disabled = disabled;
+    this.#render();
+  }
+
+  formResetCallback() {
+    this.#showError = false;
+    this.value = this.getAttribute('value');
+  }
+
+  formStateRestoreCallback(state, mode) {
+    this.#showError = false;
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #render() {
+    if (!this.#inputs) return;
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    const missing = this.required && !this.#value;
+    this.#internals.setValidity(
+      missing ? { valueMissing: true } : {},
+      missing ? 'Please select a coffee rating.' : '',
+      this.#inputs[0]
+    );
+    this.#inputs.forEach(input => {
+      input.checked = input.value === this.#value;
+      input.disabled = this.#disabled;
+      input.parentElement.classList.toggle('selected', Number(input.value) <= Number(this.#value));
+    });
+    const group = this.shadowRoot.querySelector('.stars');
+    group.setAttribute('aria-label', this.getAttribute('aria-label') || 'Coffee rating');
+    group.setAttribute('aria-required', String(this.required));
+    group.setAttribute('aria-disabled', String(this.#disabled));
+    group.setAttribute('aria-invalid', String(this.#showError && missing && !this.#disabled));
+    this.shadowRoot.querySelector('#error').hidden = !(this.#showError && missing && !this.#disabled);
+    const descriptions = ['Choose your stars, from 1 to 5.', 'Not my cup', 'Could be better', 'A good cup', 'Loved it', 'Made my day'];
+    this.shadowRoot.querySelector('#description').textContent = descriptions[Number(this.#value)];
+  }
+}
+
+customElements.define('star-rating', StarRating);
