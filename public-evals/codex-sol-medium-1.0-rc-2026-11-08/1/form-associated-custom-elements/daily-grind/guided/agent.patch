diff --git a/star-rating.js b/star-rating.js
new file mode 100644
index 0000000..59b381e
--- /dev/null
+++ b/star-rating.js
@@ -0,0 +1,152 @@
+// The host owns the submitted value; shadow radios supply native keyboard behavior.
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required'];
+
+  #internals;
+  #radios;
+  #status;
+  #error;
+  #value = '';
+  #dirty = false;
+  #disabled = false;
+  #showError = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.#internals.role = 'group';
+    const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    shadow.innerHTML = `
+      <style>
+        :host { display: block; }
+        .stars { display: flex; flex-wrap: wrap; gap: 4px; }
+        label { position: relative; display: grid; place-items: center; width: 48px; height: 48px; cursor: pointer; border-radius: 6px; }
+        input { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
+        svg { width: 34px; height: 34px; fill: white; stroke: #886b4b; stroke-width: 1.5; }
+        label[data-filled] svg { fill: #ffab40; stroke: #85531c; }
+        label:has(input:focus-visible) { outline: 3px solid #9b4c08; outline-offset: 1px; }
+        label:hover { background: #e5d8cc; }
+        :host(:disabled) { opacity: .55; }
+        :host(:disabled) label { cursor: default; background: transparent; }
+        .status { font-size: .85rem; margin-top: 6px; }
+        .error { color: #9b2520; font-size: .85rem; margin-top: 6px; }
+        [hidden] { display: none; }
+        @media (forced-colors: active) {
+          svg { stroke: CanvasText; fill: Canvas; }
+          label[data-filled] svg { fill: Highlight; stroke: CanvasText; }
+          label:has(input:checked) { outline: 2px solid Highlight; }
+        }
+      </style>
+      <div class="stars">
+        ${['Not my cup', 'Could be better', 'Pretty good', 'Really good', 'Loved it'].map((text, i) => `
+          <label>
+            <input type="radio" name="stars" value="${i + 1}" aria-label="${i + 1} ${i ? 'stars' : 'star'} — ${text}">
+            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01Z"/></svg>
+          </label>`).join('')}
+      </div>
+      <p class="status" aria-live="polite"></p>
+      <p class="error" id="rating-error" aria-live="polite" hidden>Please choose a rating from 1 to 5 stars.</p>
+    `;
+    this.#radios = [...shadow.querySelectorAll('input')];
+    this.#status = shadow.querySelector('.status');
+    this.#error = shadow.querySelector('.error');
+    // Suppress shadow events and emit exactly one input/change pair from the host.
+    shadow.addEventListener('input', event => event.stopPropagation());
+    shadow.addEventListener('change', event => {
+      event.stopPropagation();
+      if (this.#disabled) return;
+      this.value = event.target.value;
+      this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+    });
+    this.addEventListener('invalid', () => {
+      this.#showError = true;
+      this.#render();
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#dirty) this.#value = this.#normalize(this.getAttribute('value'));
+    this.#sync();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value' && !this.#dirty) this.#value = this.#normalize(newValue);
+    this.#sync();
+  }
+
+  get value() { return this.#value; }
+  set value(value) {
+    this.#dirty = true;
+    this.#value = this.#normalize(value);
+    this.#sync();
+  }
+  get defaultValue() { return this.getAttribute('value') ?? ''; }
+  set defaultValue(value) { this.setAttribute('value', String(value)); }
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', value); }
+  get required() { return this.hasAttribute('required'); }
+  set required(value) { this.toggleAttribute('required', Boolean(value)); }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+  get form() { return this.#internals.form; }
+  get labels() { return this.#internals.labels; }
+  get validity() { return this.#internals.validity; }
+  get validationMessage() { return this.#internals.validationMessage; }
+  get willValidate() { return this.#internals.willValidate; }
+  checkValidity() { return this.#internals.checkValidity(); }
+  reportValidity() { return this.#internals.reportValidity(); }
+  focus(options) { (this.#radios.find(radio => radio.checked) ?? this.#radios[0]).focus(options); }
+
+  formResetCallback() {
+    this.#dirty = false;
+    this.#showError = false;
+    this.#value = this.#normalize(this.defaultValue);
+    this.#sync();
+  }
+
+  formDisabledCallback(disabled) {
+    // Includes ancestor fieldsets. Never reflect this onto the host attribute:
+    // doing so would keep the control disabled after its fieldset is enabled.
+    this.#disabled = disabled;
+    this.#sync();
+  }
+
+  formStateRestoreCallback(state) {
+    this.#showError = false;
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #normalize(value) { return /^[1-5]$/.test(String(value)) ? String(value) : ''; }
+
+  #sync() {
+    this.#internals.setFormValue(this.#value || null, this.#value);
+    this.#internals.ariaRequired = String(this.required);
+    this.#internals.ariaDisabled = String(this.#disabled);
+    if (this.required && !this.#value) {
+      this.#internals.setValidity({ valueMissing: true }, 'Please choose a rating from 1 to 5 stars.', this.#radios[0]);
+    } else {
+      this.#internals.setValidity({});
+      this.#showError = false;
+    }
+    this.#render();
+  }
+
+  #render() {
+    const invalid = this.#showError && !this.#disabled && !this.#internals.validity.valid;
+    this.#internals.ariaInvalid = String(invalid);
+    for (const radio of this.#radios) {
+      radio.checked = radio.value === this.#value;
+      radio.disabled = this.#disabled;
+      radio.parentElement.toggleAttribute('data-filled', Number(radio.value) <= Number(this.#value));
+      if (invalid) radio.setAttribute('aria-describedby', 'rating-error');
+      else radio.removeAttribute('aria-describedby');
+    }
+    this.#status.textContent = this.#value ? `${this.#value} of 5 — ${this.#radios[Number(this.#value) - 1].getAttribute('aria-label').split(' — ')[1]}` : 'No rating selected';
+    this.#error.hidden = !invalid;
+  }
+}
+
+customElements.define('star-rating', StarRating);
