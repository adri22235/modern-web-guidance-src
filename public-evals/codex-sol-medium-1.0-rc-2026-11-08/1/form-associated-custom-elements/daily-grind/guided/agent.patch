diff --git a/feedback.js b/feedback.js
new file mode 100644
index 0000000..cd201e5
--- /dev/null
+++ b/feedback.js
@@ -0,0 +1,16 @@
+const form = document.querySelector('#coffee-feedback');
+const status = document.querySelector('#feedback-status');
+
+form.addEventListener('submit', event => {
+  // Native constraint validation runs before this event, including star-rating.
+  event.preventDefault();
+  const data = new FormData(form);
+  const coffee = form.elements.namedItem('coffee').selectedOptions[0].textContent;
+  const rating = data.get('rating');
+  status.textContent = rating
+    ? `Your feedback preview: ${coffee}, ${rating} of 5 stars. Your feedback hasn’t been sent or stored.`
+    : 'Your feedback preview has no rating. Your feedback hasn’t been sent or stored.';
+});
+
+form.addEventListener('reset', () => { status.textContent = ''; });
+form.addEventListener('input', () => { status.textContent = ''; });
