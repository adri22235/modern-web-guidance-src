diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -119,8 +119,70 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .card.spring,
+    .card.bounce {
+      transition: transform 180ms ease-out, box-shadow 180ms ease-out;
+    }
+
+    .card.spring {
+      --card-animation: spring;
+      --card-target: scale(1.035);
+    }
+
+    .card.bounce {
+      --card-animation: bounce;
+      --card-target: translateY(-6px);
+    }
+
+    .card.spring:focus-within,
+    .card.bounce:focus-within {
+      transform: var(--card-target);
+      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
+      animation: var(--card-animation) 650ms both;
+    }
+
+    @media (hover: hover) and (pointer: fine) {
+      .card.spring:hover,
+      .card.bounce:hover {
+        transform: var(--card-target);
+        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
+        animation: var(--card-animation) 650ms both;
+      }
+    }
+
+    @keyframes spring {
+      0% { transform: scale(1); }
+      38% { transform: scale(1.065); }
+      62% { transform: scale(1.022); }
+      80% { transform: scale(1.041); }
+      100% { transform: scale(1.035); }
+    }
+
+    @keyframes bounce {
+      0% { transform: translateY(0); }
+      35% { transform: translateY(-12px); }
+      55% { transform: translateY(-2px); }
+      75% { transform: translateY(-9px); }
+      100% { transform: translateY(-6px); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        animation: none;
+        transform: none;
+        transition: none;
+      }
+
+      .card.spring:is(:hover, :focus-within),
+      .card.bounce:is(:hover, :focus-within) {
+        animation: none;
+        transform: none;
+      }
+    }
+
