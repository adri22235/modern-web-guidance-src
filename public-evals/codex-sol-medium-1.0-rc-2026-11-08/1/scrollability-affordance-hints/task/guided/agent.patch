+  <script>
+    // Scroll-state queries handle the hints natively where supported.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const scroller = document.querySelector('.reviews-scroller');
+      const list = scroller.querySelector('.reviews-list');
+      const updateHints = () => {
+        scroller.classList.toggle('more-start', scroller.scrollTop > 0);
+        // Allow for fractional scroll offsets at the bottom edge.
+        scroller.classList.toggle('more-end',
+          scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop > 1);
+      };
+
+      scroller.addEventListener('scroll', updateHints, { passive: true });
+      const resizeObserver = new ResizeObserver(updateHints);
+      resizeObserver.observe(scroller);
+      resizeObserver.observe(list);
+      updateHints();
+    }
+  </script>
+
