+import React, { useEffect, useRef, useState } from "react";
+import {
+  ArrowLeftIcon,
+  ArrowRightStartOnRectangleIcon,
+  ComputerDesktopIcon,
+  EllipsisHorizontalIcon,
+  PlusIcon,
+  XMarkIcon,
+  UserCircleIcon,
+  ChevronRightIcon,
+  InformationCircleIcon,
+  PencilSquareIcon,
+  TrashIcon,
+} from "@heroicons/react/24/outline";
+import {
+  FingerPrintIcon,
+  ShieldCheckIcon,
+  LockClosedIcon,
+  KeyIcon,
+  Notice,
+  PasswordField,
+  usePasskeySupport,
+} from "./AuthUI";
+import {
+  request,
+  registerPasskey,
+  authenticatePasskey,
+  errorMessage,
+  AuthError,
+  type Account,
+  type Passkey,
+} from "../lib/auth";
+type Action = { kind: "add" } | { kind: "rename" | "remove"; passkey: Passkey };
+function date(value?: string) {
+  if (!value) return "Not used yet";
+  const parsed = new Date(value);
+  return Number.isNaN(parsed.getTime())
+    ? "Date unavailable"
+    : parsed.toLocaleDateString("en-US", {
+        month: "short",
+        day: "numeric",
+        year: "numeric",
+      });
+}
+export default function AccountSettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [fetching, setFetching] = useState(true);
+  const [signedOut, setSignedOut] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [action, setAction] = useState<Action | null>(null);
+  const [verified, setVerified] = useState(false);
+  const [password, setPassword] = useState("");
+  const [name, setName] = useState("");
+  const [modalError, setModalError] = useState<string | null>(null);
+  const [reauthMethod, setReauthMethod] = useState<"passkey" | "password">(
+    "passkey",
+  );
+  const dialog = useRef<HTMLDialogElement>(null);
+  const supported = usePasskeySupport();
+  async function load() {
+    setFetching(true);
+    setError(null);
+    try {
+      const data = await request<Account>("/account", undefined, "GET");
+      if (
+        typeof data.username !== "string" ||
+        typeof data.hasPassword !== "boolean" ||
+        !Array.isArray(data.passkeys) ||
+        !data.passkeys.every(
+          (key) =>
+            typeof key.id === "string" &&
+            typeof key.name === "string" &&
+            typeof key.createdAt === "string",
+        )
+      )
+        throw new Error(
+          "We couldn’t load your account details. Please try again.",
+        );
+      setAccount(data);
+      setSignedOut(false);
+    } catch (err) {
+      if (err instanceof AuthError && err.status === 401) {
+        setAccount(null);
+        setSignedOut(true);
+      } else setError(errorMessage(err));
+    } finally {
+      setFetching(false);
+    }
+  }
+  useEffect(() => {
+    void load();
+  }, []);
+  useEffect(() => {
+    if (action && !dialog.current?.open) dialog.current?.showModal();
+  }, [action]);
+  function open(next: Action) {
+    setAction(next);
+    setVerified(false);
+    setPassword("");
+    setName(next.kind === "rename" ? next.passkey.name : "");
+    setModalError(null);
+    setSuccess(null);
+    setReauthMethod(
+      account?.passkeys.length && supported ? "passkey" : "password",
+    );
+  }
+  function close() {
+    if (busy) return;
+    dialog.current?.close();
+    setAction(null);
+    setPassword("");
+  }
+  async function verify(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setModalError(null);
+    try {
+      if (reauthMethod === "passkey")
+        await authenticatePasskey(account?.username, true);
+      else await request("/reauthenticate", { password });
+      setPassword("");
+      setVerified(true);
+    } catch (err) {
+      setModalError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function complete(e: React.FormEvent) {
+    e.preventDefault();
+    if (!action || !account) return;
+    setBusy(true);
+    setModalError(null);
+    try {
+      if (action.kind === "add")
+        await registerPasskey(account.username, name.trim());
+      else
+        await request(
+          `/passkeys/${encodeURIComponent(action.passkey.id)}`,
+          action.kind === "rename" ? { name: name.trim() } : undefined,
+          action.kind === "rename" ? "PATCH" : "DELETE",
+        );
+      const message =
+        action.kind === "add"
+          ? "Your passkey is ready. Use it the next time you sign in."
+          : action.kind === "rename"
+            ? "Passkey renamed."
+            : "Passkey removed from your account.";
+      dialog.current?.close();
+      setAction(null);
+      setSuccess(message);
+      await load();
+    } catch (err) {
+      if (
+        err instanceof AuthError &&
+        (err.status === 401 || err.status === 403)
+      )
+        setVerified(false);
+      setModalError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function signOut() {
+    setBusy(true);
+    setError(null);
+    try {
+      await request("/logout");
+      window.location.assign(`${import.meta.env.BASE_URL}signin`);
+    } catch (err) {
+      setError(errorMessage(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <div className="settings-layout" data-skip-tracking="true">
+      <aside className="settings-sidebar">
+        <a className="back-to-news" href={import.meta.env.BASE_URL}>
+          <ArrowLeftIcon />
+          Back to the news
+        </a>
+        <p className="card-eyebrow">YOUR ACCOUNT</p>
+        <nav aria-label="Account navigation">
+          <a href="#overview">
+            <UserCircleIcon />
+            Account overview
+          </a>
+          <a href="#security" className="active" aria-current="page">
+            <ShieldCheckIcon />
+            Sign-in & security
+            <ChevronRightIcon />
+          </a>
+        </nav>
+        <div className="sidebar-note">
+          <LockClosedIcon />
+          <strong>A little peace of mind.</strong>
+          <p>
+            You’re in control of how you sign in and keep your account safe.
+          </p>
+        </div>
+        {account && (
+          <button className="signout" disabled={busy} onClick={signOut}>
+            <ArrowRightStartOnRectangleIcon />
+            Sign out
+          </button>
+        )}
+      </aside>
+      <section className="settings-content" id="security">
+        <div className="settings-breadcrumb">
+          Account <ChevronRightIcon /> Sign-in & security
+        </div>
+        <div className="settings-heading">
+          <div>
+            <h1>Sign-in & security</h1>
+            <p>A safer sign-in. A smoother start to your day.</p>
+          </div>
+          <span className="private-badge">
+            <LockClosedIcon />
+            ONLY YOU
+          </span>
+        </div>
+        <Notice error={error} success={success} />
+        {fetching && (
+          <p className="loading-account" role="status">
+            Loading your account…
+          </p>
+        )}
+        {signedOut && (
+          <div className="signin-prompt">
+            <UserCircleIcon />
+            <div>
+              <strong>Let’s make this personal.</strong>
+              <p>Sign in to see and manage your account security.</p>
+            </div>
+            <a href={`${import.meta.env.BASE_URL}signin`}>
+              Sign in
+              <ChevronRightIcon />
+            </a>
+          </div>
+        )}
+        {error && !account && !fetching && (
+          <button className="text-button" onClick={load}>
+            Try loading your account again <ChevronRightIcon />
+          </button>
+        )}
+        <div className="account-overview" id="overview">
+          <div className="account-avatar">
+            <UserCircleIcon />
+          </div>
+          <div>
+            <span className="card-eyebrow">YOUR DEVTOOLS TIMES ACCOUNT</span>
+            <strong>
+              {account?.username || "Your personal reading space"}
+            </strong>
+          </div>
+          {account && (
+            <span className="account-status">
+              <span /> Signed in
+            </span>
+          )}
+        </div>
+        <section className="security-card">
+          <div className="security-card-heading">
+            <div className="section-icon">
+              <FingerPrintIcon />
+            </div>
+            <div>
+              <h2>
+                Passkeys <span className="recommended">RECOMMENDED</span>
+              </h2>
+              <p>Your easiest, most secure way in.</p>
+            </div>
+          </div>
+          <p className="section-description">
+            Skip the password. Sign in with your fingerprint, face, or device
+            PIN.
+            <br className="desktop-break" /> Your passkeys stay safely in your
+            password manager.
+          </p>
+          <div className="passkey-list">
+            {account?.passkeys.map((passkey) => (
+              <div className="passkey-row" key={passkey.id}>
+                <div className="device-icon">
+                  {passkey.deviceType === "security-key" ? (
+                    <KeyIcon />
+                  ) : (
+                    <ComputerDesktopIcon />
+                  )}
+                </div>
+                <div className="passkey-details">
+                  <strong>{passkey.name}</strong>
+                  <p>
+                    Added {date(passkey.createdAt)} <span>·</span>{" "}
+                    {passkey.lastUsedAt
+                      ? `Last used ${date(passkey.lastUsedAt)}`
+                      : "Not used yet"}
+                  </p>
+                </div>
+                <details className="passkey-menu">
+                  <summary aria-label={`Manage ${passkey.name}`}>
+                    <EllipsisHorizontalIcon />
+                  </summary>
+                  <div>
+                    <button
+                      onClick={(e) => {
+                        e.currentTarget
+                          .closest("details")
+                          ?.removeAttribute("open");
+                        open({ kind: "rename", passkey });
+                      }}
+                    >
+                      <PencilSquareIcon />
+                      Rename
+                    </button>
+                    <button
+                      className="danger-text"
+                      onClick={(e) => {
+                        e.currentTarget
+                          .closest("details")
+                          ?.removeAttribute("open");
+                        open({ kind: "remove", passkey });
+                      }}
+                    >
+                      <TrashIcon />
+                      Remove
+                    </button>
+                  </div>
+                </details>
+              </div>
+            ))}
+            {!account?.passkeys.length && (
+              <div className="passkey-empty">
+                <div className="empty-key">
+                  <KeyIcon />
+                </div>
+                <strong>Your next sign-in could be simpler.</strong>
+                <p>
+                  Add your first passkey and leave one less password on your
+                  mind.
+                </p>
+              </div>
+            )}
+          </div>
+          <div className="security-card-footer">
+            <button
+              className="auth-button primary compact"
+              onClick={() => open({ kind: "add" })}
+              disabled={!account || supported !== true || busy}
+            >
+              <PlusIcon />
+              Add a passkey
+            </button>
+            <span>
+              <ShieldCheckIcon />
+              Built for your privacy
+            </span>
+          </div>
+          {supported === false && (
+            <p className="support-note">
+              To add a passkey, use a supported browser on a secure connection.
+            </p>
+          )}
+        </section>
+        <div className="security-tip">
+          <InformationCircleIcon />
+          <div>
+            <strong>One passkey can go a long way.</strong>
+            <p>
+              Passkeys saved in iCloud Keychain, Google Password Manager, or
+              another password manager can sync across your devices. You can
+              also use a nearby phone or security key.
+            </p>
+            <details>
+              <summary>
+                How do passkeys work? <ChevronRightIcon />
+              </summary>
+              <p>
+                Your device keeps a private key and shares only a public key
+                with us. When you sign in, your device verifies it’s you. Your
+                fingerprint, face, and PIN are never shared with The DevTools
+                Times.
+              </p>
+            </details>
+          </div>
+        </div>
+        <section className="security-card password-card">
+          <div className="section-icon">
+            <LockClosedIcon />
+          </div>
+          <div>
+            <h2>Password</h2>
+            <p>
+              {account
+                ? account.hasPassword
+                  ? "You can also sign in with your password."
+                  : "You use passkeys to sign in. No password to remember."
+                : "Your alternative way to sign in."}
+            </p>
+          </div>
+          <span className="muted-tag">
+            {account
+              ? account.hasPassword
+                ? "Enabled"
+                : "Not set"
+              : "Account protected"}
+          </span>
+        </section>
+        <div className="settings-bottom">
+          <ShieldCheckIcon />
+          Security that stays behind the scenes. So you can stay in the know.
+        </div>
+      </section>
+      <dialog
+        ref={dialog}
+        className="auth-dialog"
+        aria-labelledby="dialog-title"
+        onCancel={(e) => {
+          e.preventDefault();
+          close();
+        }}
+      >
+        <button
+          className="dialog-close"
+          aria-label="Close"
+          onClick={close}
+          disabled={busy}
+        >
+          <XMarkIcon />
+        </button>
+        <div className="modal-icon">
+          {verified ? <FingerPrintIcon /> : <ShieldCheckIcon />}
+        </div>
+        <div className="card-eyebrow">
+          {verified ? "YOUR PASSKEYS" : "AN EXTRA LAYER OF CARE"}
+        </div>
+        <h2 id="dialog-title">
+          {!verified
+            ? "Let’s make sure it’s you."
+            : action?.kind === "remove"
+              ? "Remove this passkey?"
+              : action?.kind === "rename"
+                ? "Give it a familiar name."
+                : "A simpler sign-in starts here."}
+        </h2>
+        <p className="card-subtitle">
+          {!verified
+            ? "Confirm your identity before making changes to your sign-in methods."
+            : action?.kind === "remove"
+              ? `You won’t be able to sign in with “${action.passkey.name}” after it’s removed.`
+              : "Choose a name that helps you recognize this passkey."}
+        </p>
+        <Notice error={modalError} />
+        {!verified ? (
+          <form onSubmit={verify}>
+            {supported === false && !account?.hasPassword && (
+              <p className="support-note">
+                Use a browser that supports passkeys to confirm your identity
+                and make changes.
+              </p>
+            )}
+            {reauthMethod === "password" && account?.hasPassword && (
+              <PasswordField
+                value={password}
+                onChange={setPassword}
+                disabled={busy}
+              />
+            )}
+            <button
+              className="auth-button primary"
+              disabled={
+                busy ||
+                (reauthMethod === "passkey" && !supported) ||
+                (reauthMethod === "password" && !account?.hasPassword)
+              }
+            >
+              {reauthMethod === "passkey" ? (
+                <FingerPrintIcon />
+              ) : (
+                <LockClosedIcon />
+              )}
+              {busy
+                ? "Confirming your identity…"
+                : reauthMethod === "passkey"
+                  ? "Confirm with a passkey"
+                  : "Confirm with password"}
+            </button>
+            {account?.hasPassword && !!account.passkeys.length && (
+              <button
+                className="modal-alternative"
+                type="button"
+                disabled={busy}
+                onClick={() => {
+                  setReauthMethod(
+                    reauthMethod === "password" ? "passkey" : "password",
+                  );
+                  setModalError(null);
+                }}
+              >
+                Use{" "}
+                {reauthMethod === "password" ? "a passkey" : "your password"}{" "}
+                instead
+              </button>
+            )}
+          </form>
+        ) : (
+          <form onSubmit={complete}>
+            {action?.kind === "remove" && (
+              <p className="card-subtitle">
+                The saved copy may remain in your password manager. You can
+                delete it there separately.
+              </p>
+            )}
+            {action?.kind !== "remove" && (
+              <div className="auth-field">
+                <label htmlFor="passkey-name">Passkey name</label>
+                <input
+                  id="passkey-name"
+                  value={name}
+                  onChange={(e) => setName(e.target.value)}
+                  required
+                  maxLength={64}
+                  pattern=".*\S.*"
+                  placeholder="e.g. Personal MacBook"
+                  disabled={busy}
+                  autoFocus
+                />
+              </div>
+            )}
+            {action?.kind === "remove" &&
+              !account?.hasPassword &&
+              (account?.passkeys.length || 0) <= 1 && (
+                <div className="auth-notice error">
+                  This is your only sign-in method. Add another passkey before
+                  removing it.
+                </div>
+              )}
+            <button
+              className={`auth-button ${action?.kind === "remove" ? "danger" : "primary"}`}
+              disabled={
+                busy ||
+                (action?.kind === "remove" &&
+                  !account?.hasPassword &&
+                  (account?.passkeys.length || 0) <= 1)
+              }
+            >
+              {busy
+                ? "Working…"
+                : action?.kind === "remove"
+                  ? "Remove passkey"
+                  : action?.kind === "rename"
+                    ? "Save name"
+                    : "Create passkey"}
+              {action?.kind === "add" && (
+                <ArrowLeftIcon className="rotate-180" />
+              )}
+            </button>
+          </form>
+        )}
+        <p className="modal-footnote">
+          <LockClosedIcon />
+          Your biometric information never leaves your device.
+        </p>
+      </dialog>
+    </div>
+  );
+}
