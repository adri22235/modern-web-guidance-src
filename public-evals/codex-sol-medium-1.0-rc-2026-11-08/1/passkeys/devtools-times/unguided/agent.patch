@@ -0,0 +1,178 @@
+import React, { useEffect, useState } from "react";
+import {
+  FingerPrintIcon,
+  ArrowRightIcon,
+  ShieldCheckIcon,
+  CheckIcon,
+  LockClosedIcon,
+  EyeIcon,
+  EyeSlashIcon,
+  ArrowUpRightIcon,
+  KeyIcon,
+} from "@heroicons/react/24/outline";
+import { supportsPasskeys } from "../lib/auth";
+export {
+  FingerPrintIcon,
+  ArrowRightIcon,
+  ShieldCheckIcon,
+  CheckIcon,
+  LockClosedIcon,
+  KeyIcon,
+};
+export function usePasskeySupport() {
+  const [supported, setSupported] = useState<boolean | null>(null);
+  useEffect(() => setSupported(supportsPasskeys()), []);
+  return supported;
+}
+export function Notice({
+  error,
+  success,
+}: {
+  error?: string | null;
+  success?: string | null;
+}) {
+  return (
+    <div aria-live="polite" aria-atomic="true">
+      {error && (
+        <div className="auth-notice error" role="alert">
+          {error}
+        </div>
+      )}
+      {success && (
+        <div className="auth-notice success" role="status">
+          <CheckIcon />
+          {success}
+        </div>
+      )}
+    </div>
+  );
+}
+export function PasswordField({
+  value,
+  onChange,
+  signup = false,
+  disabled = false,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  signup?: boolean;
+  disabled?: boolean;
+}) {
+  const [show, setShow] = useState(false);
+  return (
+    <div className="auth-field">
+      <label htmlFor="password">Password</label>
+      <div className="password-input">
+        <input
+          id="password"
+          data-skip-tracking="true"
+          name="password"
+          type={show ? "text" : "password"}
+          autoComplete={signup ? "new-password" : "current-password"}
+          value={value}
+          onChange={(e) => onChange(e.target.value)}
+          required
+          minLength={signup ? 8 : undefined}
+          pattern={signup ? "(?=.*[0-9]).{8,}" : undefined}
+          disabled={disabled}
+          placeholder={
