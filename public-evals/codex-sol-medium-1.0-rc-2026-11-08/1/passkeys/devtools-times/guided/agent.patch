+  await authRequest('account');
+  assert.equal(calls[1].headers.get('Authorization'), 'Bearer active-session');
+});
+
+test('a new cookie session cannot retain an old account bearer token', async () => {
+  saveSession({ token: 'old-account-token' });
+  saveSession({});
+  routes.push({ body: {} });
+  await authRequest('account');
+  assert.equal(calls[0].headers.get('Authorization'), null);
+});
