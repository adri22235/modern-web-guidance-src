@@ -0,0 +1,100 @@
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { authMessage, authRequest, saveSession, type AuthSession } from '../utils/auth';
+import { authenticatePasskey, passkeyCapabilities, registerPasskey } from '../utils/passkeys';
+import './auth.css';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [method, setMethod] = useState<'passkey' | 'password'>('passkey');
+  const [capabilities, setCapabilities] = useState({ supported: false, create: false, conditional: false });
+  const [checked, setChecked] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [success, setSuccess] = useState('');
+  const [signedIn, setSignedIn] = useState(false);
+  const [created, setCreated] = useState(false);
+  const [autofillVersion, setAutofillVersion] = useState(0);
+  const operation = useRef<AbortController | null>(null);
+  const base = import.meta.env.BASE_URL;
+
+  useEffect(() => {
+    let active = true;
+    passkeyCapabilities().then(value => { if (active) { setCapabilities(value); setChecked(true); if (!value.create) setMethod('password'); } })
+      .catch(() => { if (active) { setChecked(true); setMethod('password'); } });
+    return () => { active = false; operation.current?.abort(); };
+  }, []);
+
+  useEffect(() => {
+    if (signup || signedIn || busy || !capabilities.conditional) return;
+    const controller = new AbortController();
+    operation.current = controller;
+    authenticatePasskey(controller.signal, true).then(session => {
+      if (controller.signal.aborted) return;
+      saveSession(session);
+      setSignedIn(true);
+      setSuccess('You’re signed in with your passkey.');
+      setError('');
+    }).catch(error => {
+      if (!controller.signal.aborted && !(error instanceof DOMException && ['NotAllowedError', 'AbortError'].includes(error.name))) setError(authMessage(error));
+    });
+    return () => controller.abort();
+  }, [signup, signedIn, busy, capabilities.conditional, autofillVersion]);
+
+  async function submit(event?: FormEvent, usePasskey = false, promotion = false) {
+    event?.preventDefault();
+    operation.current?.abort();
+    const controller = new AbortController();
+    operation.current = controller;
+    setBusy(true); setError(''); setSuccess('');
+    try {
+      if (usePasskey) {
+        const session = signup || promotion
+          ? await registerPasskey({ username: signup ? username.trim() : undefined, promotion: true, signal: controller.signal })
+          : await authenticatePasskey(controller.signal);
+        if (controller.signal.aborted) return;
+        saveSession(session);
+        setSignedIn(true);
+        setCreated(signup || promotion);
+        setSuccess(promotion ? 'Your passkey is ready for your next sign-in.' : signup ? 'Your account and passkey are ready.' : 'You’re signed in with your passkey.');
+      } else {
+        const session = await authRequest<AuthSession>(signup ? 'register' : 'login', { username: username.trim(), password }, 'POST', undefined, controller.signal);
+        if (controller.signal.aborted) return;
+        if (!signup) { saveSession(session); setSignedIn(true); }
+        setPassword('');
+        setSuccess(signup ? 'Your account is ready. Sign in to continue or add a passkey in account settings.' : 'You’re signed in.');
+      }
+    } catch (error) { if (!controller.signal.aborted) setError(authMessage(error)); }
+    finally { if (!controller.signal.aborted) { setBusy(false); setAutofillVersion(value => value + 1); } }
+  }
+
+  return <section className="auth-card" aria-labelledby="auth-title">
+    <p className="auth-eyebrow">The DevTools Times</p>
+    <h1 id="auth-title">{signedIn ? 'Welcome to the Times.' : signup ? 'Make yourself at home.' : 'Welcome back.'}</h1>
+    <p className="auth-intro">{signedIn ? 'Independent stories. A fresh perspective. Your daily read awaits.' : signup ? 'Create an account and keep the stories that matter close.' : 'Sign in to your account to pick up where you left off.'}</p>
+    {error && <p className="auth-error" role="alert">{error}</p>}
+    {success && <p className="auth-success" role="status">{success}</p>}
+    {signedIn ? <div className="auth-stack">
+      {!created && capabilities.create && <div className="auth-panel"><h2>A simpler way to sign in</h2><p>Create a passkey and use your fingerprint, face, or device PIN next time. Your biometric data stays on your device.</p><button className="auth-primary" disabled={busy} onClick={() => submit(undefined, true, true)}>{busy ? 'Creating passkey…' : 'Create a passkey'}</button></div>}
+      <a className="auth-primary auth-button" href={base}>Continue reading</a>
+      <a className="auth-link" href={`${base}account`}>Manage account & passkeys →</a>
+    </div> : <>
+      {signup && capabilities.create && <div className="auth-methods" role="group" aria-label="Account creation method">
+        <button type="button" aria-pressed={method === 'passkey'} onClick={() => setMethod('passkey')} disabled={busy}>Use a passkey</button>
+        <button type="button" aria-pressed={method === 'password'} onClick={() => setMethod('password')} disabled={busy}>Use a password</button>
+      </div>}
+      {!signup && <><button className="auth-primary" type="button" disabled={!checked || !capabilities.supported || busy} onClick={() => submit(undefined, true)}>{busy ? 'Signing in…' : 'Sign in with a passkey'}</button><p className="auth-hint">Use your fingerprint, face, device PIN, or security key.</p><div className="auth-divider">or use your password</div></>}
+      {checked && !(signup ? capabilities.create : capabilities.supported) && <p className="auth-hint">Passkeys aren’t available in this browser or connection. You can still use your password.</p>}
+      <form onSubmit={event => submit(event, signup && method === 'passkey')} className="auth-stack">
+        <fieldset disabled={busy} className="auth-stack">
+          <div><label htmlFor="username">Username</label><input id="username" name="username" autoComplete={signup ? 'username' : 'username webauthn'} autoCapitalize="none" spellCheck={false} value={username} onChange={event => setUsername(event.target.value)} required pattern=".*\S.*" /></div>
+          {(!signup || method === 'password') && <div><label htmlFor="password">Password</label><input id="password" name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} value={password} onChange={event => setPassword(event.target.value)} required minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} aria-describedby={signup ? 'password-help' : undefined} />{signup && <p className="auth-hint" id="password-help">At least 8 characters, including a number.</p>}</div>}
+          {signup && method === 'passkey' && <div className="auth-panel"><h2>Your device is your key.</h2><p>Sign in with your fingerprint, face, or device PIN. No password to remember. Your passkey is saved by your password manager.</p></div>}
+          <button className={signup ? 'auth-primary' : 'auth-secondary'} type="submit" data-skip-tracking="true" disabled={signup && !checked}>{busy ? (signup ? 'Creating account…' : 'Signing in…') : signup ? (method === 'passkey' ? 'Create account with a passkey' : 'Create account') : 'Sign in with password'}</button>
+        </fieldset>
+      </form>
+      <p className="auth-footer">{signup ? 'Already have an account?' : 'New to the Times?'} <a href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'}</a></p>
