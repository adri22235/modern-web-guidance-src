diff --git a/src/components/ReauthenticationDialog.tsx b/src/components/ReauthenticationDialog.tsx
new file mode 100644
index 0000000..8b47843
--- /dev/null
+++ b/src/components/ReauthenticationDialog.tsx
@@ -0,0 +1,63 @@
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { createPortal } from 'react-dom';
+import { authMessage, authRequest, AuthError } from '../utils/auth';
+import { reauthenticatePasskey } from '../utils/passkeys';
+
+export default function ReauthenticationDialog({ action, description, canUsePasskey, hasPassword, onCancel, onVerified }: {
+  action: string; description: string; canUsePasskey: boolean; hasPassword: boolean;
+  onCancel: () => void; onVerified: (token: string, signal: AbortSignal) => Promise<void>;
+}) {
+  const [dialog, setDialog] = useState<HTMLDialogElement | null>(null);
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const controller = useRef<AbortController | null>(null);
+  const cancel = useRef(onCancel);
+  cancel.current = onCancel;
+  // The platform owns the dialog shell and focus lifecycle; React owns its content.
+  useEffect(() => {
+    const shell = document.createElement('dialog');
+    shell.className = 'reauth-dialog';
+    shell.setAttribute('aria-labelledby', 'reauth-title');
+    shell.setAttribute('aria-describedby', 'reauth-description');
+    const close = () => { controller.current?.abort(); cancel.current(); };
+    shell.addEventListener('close', close);
+    document.body.append(shell);
+    setDialog(shell);
+    return () => { controller.current?.abort(); shell.removeEventListener('close', close); shell.close(); shell.remove(); };
+  }, []);
+  useEffect(() => { if (dialog && !dialog.open) dialog.showModal(); }, [dialog]);
+
+  async function verify(usePassword = false, event?: FormEvent) {
+    event?.preventDefault();
+    controller.current?.abort();
+    const current = new AbortController();
+    controller.current = current;
+    setBusy(true); setError('');
+    try {
+      const token = usePassword
+        ? (await authRequest<{ reauthToken: string }>('reauthenticate/password', { password, action }, 'POST', undefined, current.signal)).reauthToken
+        : await reauthenticatePasskey(action, current.signal);
+      if (!token) throw new AuthError('Identity verification failed. Please try again.');
+      if (current.signal.aborted) return;
+      setPassword('');
+      await onVerified(token, current.signal);
+    } catch (error) { if (!current.signal.aborted) setError(authMessage(error)); }
+    finally { if (!current.signal.aborted) setBusy(false); }
+  }
+
+  return dialog ? createPortal(<>
+    <h2 id="reauth-title">Confirm it’s you</h2>
+    <p id="reauth-description" className="auth-intro">{description} Verify your identity to continue.</p>
+    {error && <p className="auth-error" role="alert">{error}</p>}
+    <div className="auth-stack" aria-busy={busy}>
+      {canUsePasskey && <button className="auth-primary" disabled={busy} onClick={() => verify()}>{busy ? 'Verifying…' : 'Verify with a passkey'}</button>}
+      {hasPassword && <form className="auth-stack" onSubmit={event => verify(true, event)}>
+        <div><label htmlFor="reauth-password">{canUsePasskey ? 'Or use your password' : 'Your password'}</label><input id="reauth-password" name="password" type="password" autoComplete="current-password" required value={password} disabled={busy} onChange={event => setPassword(event.target.value)} /></div>
+        <button className="auth-secondary" disabled={busy}>Confirm with password</button>
+      </form>}
+      {!canUsePasskey && !hasPassword && <p className="auth-error">Use a browser that supports passkeys to verify your identity.</p>}
+      <button type="button" className="auth-secondary" autoFocus onClick={() => dialog.close()}>Cancel</button>
+    </div>
+  </>, dialog) : null;
+}
