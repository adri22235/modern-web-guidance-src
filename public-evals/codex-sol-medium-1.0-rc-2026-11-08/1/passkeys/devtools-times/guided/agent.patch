+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { authenticatePasskey, passkeyCapabilities, reauthenticatePasskey, registerPasskey, syncPasskeys } from '../src/utils/passkeys.ts';
+import { authRequest, saveSession } from '../src/utils/auth.ts';
+
+const credential = { id: 'Y3JlZGVudGlhbA', toJSON: () => ({ id: 'Y3JlZGVudGlhbA', response: { signature: 'c2lnbmF0dXJl' } }) };
+const signals = [];
+const calls = [];
+let prompts;
+let routes;
+class Credential {
+  static getClientCapabilities = async () => ({ conditionalGet: true, passkeyPlatformAuthenticator: true });
+  static parseRequestOptionsFromJSON = value => value;
+  static parseCreationOptionsFromJSON = value => value;
+  static signalUnknownCredential = async value => { signals.push(value); };
+  static signalAllAcceptedCredentials = async value => { signals.push(value); };
+  toJSON() { return {}; }
+}
+const requestOptions = { challenge: 'Y2hhbGxlbmdl', rpId: 'example.com', userVerification: 'required', allowCredentials: [{ id: credential.id, type: 'public-key' }] };
+
+beforeEach(() => {
+  calls.length = 0; signals.length = 0; prompts = 0; routes = [];
+  const storage = new Map();
+  globalThis.sessionStorage = { getItem: key => storage.get(key), setItem: (key, value) => storage.set(key, value), removeItem: key => storage.delete(key) };
+  globalThis.PublicKeyCredential = Credential;
+  globalThis.window = { isSecureContext: true, PublicKeyCredential: Credential };
+  Object.defineProperty(globalThis, 'navigator', { configurable: true, value: { userAgent: '', credentials: {
+    get: async options => { prompts++; calls.push(options); return credential; },
+    create: async options => { prompts++; calls.push(options); return credential; },
+  } } });
+  globalThis.fetch = async (url, options) => {
+    calls.push({ url, ...options });
+    const next = routes.shift();
+    assert.ok(next, `Unexpected request: ${url}`);
+    return new Response(JSON.stringify(next.body ?? {}), { status: next.status ?? 200 });
+  };
+});
+
+test('insecure contexts keep password fallback available', async () => {
+  window.isSecureContext = false;
+  assert.deepEqual(await passkeyCapabilities(), { supported: false, create: false, conditional: false });
+  assert.equal(calls.length, 0);
+});
+
+test('reauthentication rejects an unconstrained account picker', async () => {
+  routes.push({ body: { ...requestOptions, allowCredentials: [] } });
+  await assert.rejects(reauthenticatePasskey('delete:key', new AbortController().signal), /password/);
+  assert.equal(prompts, 0);
+});
+
+test('reauthentication requires user verification and a server proof', async () => {
+  routes.push({ body: { ...requestOptions, userVerification: 'preferred' } });
+  await assert.rejects(reauthenticatePasskey('profile', new AbortController().signal));
+  assert.equal(prompts, 0);
+  routes.push({ body: requestOptions }, { body: {} });
+  await assert.rejects(reauthenticatePasskey('profile', new AbortController().signal), /verification failed/);
+});
+
+test('reauthentication returns proof only after server verification', async () => {
+  routes.push({ body: requestOptions }, { body: { reauthToken: 'server-proof' } });
+  assert.equal(await reauthenticatePasskey('delete:key', new AbortController().signal), 'server-proof');
+  assert.deepEqual(calls[1].publicKey.allowCredentials, requestOptions.allowCredentials);
+  assert.equal(JSON.parse(calls[2].body).action, 'delete:key');
+});
+
+test('authentication signals unknown only on an explicit 404 and uses the server RP', async () => {
+  routes.push({ body: requestOptions }, { status: 500 });
+  await assert.rejects(authenticatePasskey(new AbortController().signal));
+  assert.deepEqual(signals, []);
+  routes.push({ body: requestOptions }, { status: 404 });
+  await assert.rejects(authenticatePasskey(new AbortController().signal));
+  assert.deepEqual(signals, [{ rpId: 'example.com', credentialId: credential.id }]);
+});
+
+test('registration does not signal user cancellation, but cleans up a verification failure', async () => {
+  const options = { rp: { id: 'example.com' } };
+  routes.push({ body: options });
+  navigator.credentials.create = async () => { throw new DOMException('Canceled', 'NotAllowedError'); };
+  await assert.rejects(registerPasskey());
+  assert.deepEqual(signals, []);
+  navigator.credentials.create = async () => credential;
+  routes.push({ body: options }, { status: 400 });
+  await assert.rejects(registerPasskey());
+  assert.deepEqual(signals, [{ rpId: 'example.com', credentialId: credential.id }]);
+});
+
+test('aborted options requests never open a browser prompt', async () => {
+  const controller = new AbortController();
+  globalThis.fetch = async () => {
+    controller.abort();
+    return new Response(JSON.stringify(requestOptions));
+  };
+  await assert.rejects(authenticatePasskey(controller.signal), { name: 'AbortError' });
+  assert.equal(prompts, 0);
+});
+
+test('management signals validate base64url IDs and tolerate unsupported methods', async () => {
+  await syncPasskeys({ rpId: 'example.com', userId: 'invalid=', credentials: [{ id: credential.id }] });
+  assert.equal(signals.length, 0);
+  const account = { rpId: 'example.com', userId: 'dXNlcg', credentials: [{ id: credential.id }] };
+  await syncPasskeys(account);
+  assert.deepEqual(signals[0], { rpId: 'example.com', userId: 'dXNlcg', allAcceptedCredentialIds: [credential.id] });
+  const signal = Credential.signalAllAcceptedCredentials;
+  Credential.signalAllAcceptedCredentials = undefined;
+  await syncPasskeys(account);
+  Credential.signalAllAcceptedCredentials = signal;
+});
+
+test('authenticated changes forward the session and scoped reauthentication proof', async () => {
+  saveSession({ token: 'session-token' });
+  routes.push({ body: {} });
+  await authRequest('passkeys/key', undefined, 'DELETE', 'reauth-proof');
+  assert.equal(calls[0].headers.get('Authorization'), 'Bearer session-token');
+  assert.equal(calls[0].headers.get('X-Reauthentication-Token'), 'reauth-proof');
+  assert.equal(calls[0].credentials, 'include');
+});
+
+test('a wrong reauthentication password does not discard the active session', async () => {
+  saveSession({ token: 'active-session' });
+  routes.push({ status: 401 }, { body: {} });
