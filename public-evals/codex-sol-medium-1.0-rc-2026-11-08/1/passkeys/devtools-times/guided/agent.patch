diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..0b43bb2
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,112 @@
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { authMessage, authRequest, AuthError, type Account } from '../utils/auth';
+import { passkeyCapabilities, registerPasskey, syncPasskeys, syncProfile } from '../utils/passkeys';
+import ReauthenticationDialog from './ReauthenticationDialog';
+import './auth.css';
+
+type Action = { kind: 'create' } | { kind: 'delete'; id: string; name: string } | { kind: 'rename'; id: string; name: string } | { kind: 'profile'; username: string; displayName: string };
+function date(value?: number) { return value && Number.isFinite(value) ? new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Not used yet'; }
+
+export default function AccountSettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [success, setSuccess] = useState('');
+  const [unauthorized, setUnauthorized] = useState(false);
+  const [capabilities, setCapabilities] = useState({ supported: false, create: false, conditional: false });
+  const [pending, setPending] = useState<Action | null>(null);
+  const [editing, setEditing] = useState('');
+  const [nickname, setNickname] = useState('');
+  const [username, setUsername] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const loadController = useRef<AbortController | null>(null);
+  const base = import.meta.env.BASE_URL;
+
+  async function load(signal?: AbortSignal) {
+    setLoading(true); setError('');
+    try {
+      const data = await authRequest<Account>('account', undefined, 'GET', undefined, signal);
+      if (signal?.aborted) return;
+      setAccount(data); setUsername(data.username); setDisplayName(data.displayName);
+      setUnauthorized(false);
+      await syncPasskeys(data);
+    } catch (error) {
+      if (signal?.aborted) return;
+      setUnauthorized(error instanceof AuthError && error.status === 401);
+      setError(authMessage(error));
+    } finally { if (!signal?.aborted) setLoading(false); }
+  }
+  useEffect(() => {
+    const controller = new AbortController();
+    loadController.current = controller;
+    load(controller.signal);
+    passkeyCapabilities().then(value => { if (!controller.signal.aborted) setCapabilities(value); }).catch(() => {});
+    return () => controller.abort();
+  }, []);
+
+  function requestAction(action: Action) { setError(''); setSuccess(''); setPending(action); }
+  const actionId = pending ? pending.kind + ('id' in pending ? `:${pending.id}` : '') : '';
+  const description = pending?.kind === 'delete' ? `Remove “${pending.name}” from your account? You won’t be able to sign in with it again.`
+    : pending?.kind === 'rename' ? 'Save a new name for this passkey.'
+    : pending?.kind === 'profile' ? 'Update your account details.' : 'Add a new passkey to your account.';
+
+  async function performAction(token: string, signal: AbortSignal) {
+    if (!pending || !account) return;
+    if (pending.kind === 'create') await registerPasskey({ reauthToken: token, signal });
+    if (pending.kind === 'delete') await authRequest(`passkeys/${encodeURIComponent(pending.id)}`, undefined, 'DELETE', token, signal);
+    if (pending.kind === 'rename') await authRequest(`passkeys/${encodeURIComponent(pending.id)}`, { name: pending.name }, 'PUT', token, signal);
+    if (pending.kind === 'profile') {
+      const updated = await authRequest<Account>('account', { username: pending.username, displayName: pending.displayName }, 'PUT', token, signal);
+      await syncProfile(updated);
+    }
+    if (signal.aborted) return;
+    // Remove a deleted key from the visible list even if the subsequent refresh fails.
+    if (pending.kind === 'delete') {
+      const updated = { ...account, credentials: account.credentials.filter(item => item.id !== pending.id) };
+      setAccount(updated);
+      await syncPasskeys(updated);
+    }
+    setPending(null); setEditing('');
+    setSuccess(pending.kind === 'create' ? 'Passkey created. You can use it the next time you sign in.' : pending.kind === 'delete' ? 'Passkey removed. You may also remove its saved entry from your password manager.' : 'Changes saved.');
+    // Refresh independently: closing the reauthentication dialog aborts its own controller.
+    await load(loadController.current?.signal);
+  }
+
+  return <section className="account-card" aria-labelledby="account-title">
+    <p className="auth-eyebrow">Your account</p>
+    <h1 id="account-title">Account settings</h1>
+    <p className="auth-intro">Your details, your security, your way into the Times.</p>
+    {error && <p className="auth-error" role="alert">{error}</p>}
+    {success && <p className="auth-success" role="status">{success}</p>}
+    {loading && <p role="status">Loading your account…</p>}
+    {unauthorized ? <a className="auth-primary auth-button" href={`${base}signin`}>Sign in to manage your account</a> : !loading && !account ? <button className="auth-secondary" onClick={() => load(loadController.current?.signal)}>Try again</button> : null}
+    {account && <>
+      <section className="account-section" aria-labelledby="profile-title">
+        <h2 id="profile-title">Account details</h2>
+        <form className="auth-stack" onSubmit={(event: FormEvent) => { event.preventDefault(); requestAction({ kind: 'profile', username: username.trim(), displayName: displayName.trim() }); }}>
+          <div><label htmlFor="account-username">Username</label><input id="account-username" name="username" autoComplete="username" autoCapitalize="none" spellCheck={false} required pattern=".*\S.*" maxLength={100} value={username} onChange={event => setUsername(event.target.value)} /></div>
+          <div><label htmlFor="display-name">Display name</label><input id="display-name" name="displayName" autoComplete="nickname" required pattern=".*\S.*" maxLength={100} value={displayName} onChange={event => setDisplayName(event.target.value)} /></div>
+          <button className="auth-secondary" disabled={loading || !!pending || (username.trim() === account.username && displayName.trim() === account.displayName)}>Save account details</button>
+        </form>
+      </section>
+      <section className="account-section" aria-labelledby="passkeys-title">
+        <h2 id="passkeys-title">Passkeys</h2>
+        <p className="auth-intro">Sign in with your fingerprint, face, device PIN, or a security key. Your biometric data is never shared with us.</p>
+        {capabilities.create ? <button className="auth-primary" disabled={loading || !!pending} onClick={() => requestAction({ kind: 'create' })}>Create a passkey</button> : <p className="auth-hint">Creating passkeys isn’t available in this browser or connection. You can still manage your existing passkeys.</p>}
+        <ul className="passkey-list" aria-label="Your saved passkeys">
+          {account.credentials.map(key => <li className="passkey-row" key={key.id}>
+            <div className="passkey-heading"><span className="passkey-icon" aria-hidden="true">{key.providerIcon && /^data:image\/(png|jpeg|webp);base64,/.test(key.providerIcon) ? <img src={key.providerIcon} width="24" height="24" alt="" /> : <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6"><circle cx="8" cy="9" r="5" /><path d="m12 13 8 8m-4-4 3-3m-6 0 3-3" /></svg>}</span><div><h3>{key.name || key.providerName || 'Passkey'}</h3><p className="auth-hint">{key.providerName || 'Unknown passkey provider'}</p></div></div>
+            <p className="auth-hint">Created {date(key.registeredAt)} · Last used: {date(key.lastUsedAt)}</p>
+            {editing === key.id ? <form className="auth-stack" onSubmit={event => { event.preventDefault(); requestAction({ kind: 'rename', id: key.id, name: nickname.trim() }); }}>
+              <div><label htmlFor="passkey-name">Passkey name</label><input id="passkey-name" maxLength={80} required pattern=".*\S.*" autoFocus value={nickname} onChange={event => setNickname(event.target.value)} /></div>
+              <div className="passkey-actions"><button className="auth-secondary" disabled={!!pending}>Save name</button><button className="auth-secondary" type="button" onClick={() => setEditing('')}>Cancel</button></div>
+            </form> : <div className="passkey-actions"><button className="auth-secondary" disabled={loading || !!pending} aria-label={`Rename ${key.name || 'passkey'}`} onClick={() => { setNickname(key.name); setEditing(key.id); }}>Rename</button><button className="auth-danger" disabled={loading || !!pending || (!account.hasPassword && account.credentials.length === 1)} aria-describedby={!account.hasPassword && account.credentials.length === 1 ? 'last-passkey-help' : undefined} aria-label={`Remove ${key.name || 'passkey'}`} onClick={() => requestAction({ kind: 'delete', id: key.id, name: key.name })}>Remove</button></div>}
+          </li>)}
+        </ul>
+        {!account.credentials.length && <div className="auth-panel"><h3>No passkeys yet</h3><p>Add a passkey for a faster, more secure sign-in. You can keep using your password.</p></div>}
+        {!account.hasPassword && account.credentials.length === 1 && <p className="auth-hint" id="last-passkey-help">This is your only sign-in method. Create another passkey before removing this one.</p>}
+      </section>
+    </>}
+    {pending && account && <ReauthenticationDialog action={actionId} description={description} canUsePasskey={capabilities.supported && account.credentials.length > 0} hasPassword={account.hasPassword} onCancel={() => setPending(null)} onVerified={performAction} />}
+  </section>;
+}
