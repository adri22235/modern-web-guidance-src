diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..4cfcaa7
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,62 @@
+const API = import.meta.env?.PUBLIC_AUTH_API_URL || 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+const TOKEN_KEY = 'devtools-times-session';
+
+export class AuthError extends Error {
+  constructor(message: string, public status = 0) { super(message); }
+}
+
+export interface AuthSession { token?: string; username?: string }
+export interface PasskeyRecord {
+  id: string;
+  name: string;
+  providerName?: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+export interface Account {
+  username: string;
+  displayName: string;
+  hasPassword: boolean;
+  rpId: string;
+  userId: string;
+  credentials: PasskeyRecord[];
+}
+
+export async function authRequest<T>(path: string, body?: unknown, method = body === undefined ? 'GET' : 'POST', reauthToken?: string, signal?: AbortSignal): Promise<T> {
+  const headers = new Headers({ Accept: 'application/json' });
+  if (body !== undefined) headers.set('Content-Type', 'application/json');
+  const token = sessionStorage.getItem(TOKEN_KEY);
+  if (token) headers.set('Authorization', `Bearer ${token}`);
+  if (reauthToken) headers.set('X-Reauthentication-Token', reauthToken);
+  const response = await fetch(`${API.replace(/\/$/, '')}/${path}`, {
+    method, headers, credentials: 'include', signal,
+    ...(body !== undefined ? { body: JSON.stringify(body) } : {}),
+  });
+  if (!response.ok) {
+    if (response.status === 401 && path !== 'reauthenticate/password') sessionStorage.removeItem(TOKEN_KEY);
+    const message = response.status === 401 ? (path === 'login' ? 'That username or password wasn’t recognized. Please try again.' : path === 'reauthenticate/password' ? 'That password wasn’t recognized. Please try again.' : 'Please sign in again to continue.')
+      : response.status === 409 ? 'That username or passkey is already registered.'
+      : response.status === 429 ? 'Too many attempts. Please wait and try again.'
+      : 'We couldn’t complete your request. Please try again.';
+    throw new AuthError(message, response.status);
+  }
+  if (response.status === 204) return undefined as T;
+  return response.json();
+}
+
+export function saveSession(session: AuthSession) {
+  // Cookie-based sessions are preferred. Support the existing API's token response too.
+  if (session.token) sessionStorage.setItem(TOKEN_KEY, session.token);
+  else sessionStorage.removeItem(TOKEN_KEY);
+}
+
+export function authMessage(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (['NotAllowedError', 'AbortError'].includes(error.name)) return 'The passkey request was canceled or timed out. Try again, or use your password.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or provider.';
+    if (error.name === 'SecurityError') return 'Passkeys aren’t available for this site. Use a secure connection or sign in with your password.';
+  }
+  if (error instanceof AuthError) return error.message;
+  return 'We couldn’t connect. Please try again.';
+}
diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..c425f3a
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,79 @@
+import { authRequest, AuthError, type Account, type AuthSession } from './auth';
+
+// Signals are a progressive enhancement and must never change the outcome of an action.
+type SignalAPI = typeof PublicKeyCredential & {
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+export async function passkeyCapabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials) return { supported: false, create: false, conditional: false };
+  await import('webauthn-polyfills');
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return { supported: true, create: Boolean(capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet), conditional: Boolean(capabilities.conditionalGet) };
+  } catch { return { supported: true, create: false, conditional: false }; }
+}
+
+function validId(id: string) { return typeof id === 'string' && id.length > 0 && id.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(id); }
+async function passiveSignal(callback: () => Promise<void> | undefined) {
+  try { await callback(); } catch (error) { console.warn('Passkey manager synchronization unavailable.', error); }
+}
+async function signalUnknown(rpId: string, credentialId: string) {
+  if (!rpId || !validId(credentialId)) return;
+  await passiveSignal(() => (PublicKeyCredential as SignalAPI).signalUnknownCredential?.({ rpId, credentialId }));
+}
+export async function syncPasskeys(account: Account) {
+  if (!window.PublicKeyCredential || !account.rpId || !validId(account.userId) || !account.credentials.every(item => validId(item.id))) return;
+  await passiveSignal(() => (PublicKeyCredential as SignalAPI).signalAllAcceptedCredentials?.({ rpId: account.rpId, userId: account.userId, allAcceptedCredentialIds: account.credentials.map(item => item.id) }));
+}
+export async function syncProfile(account: Account) {
+  if (!window.PublicKeyCredential || !account.rpId || !validId(account.userId)) return;
+  await passiveSignal(() => (PublicKeyCredential as SignalAPI).signalCurrentUserDetails?.({ rpId: account.rpId, userId: account.userId, name: account.username, displayName: account.displayName }));
+}
+
+export async function registerPasskey({ username, promotion = false, reauthToken, signal }: { username?: string; promotion?: boolean; reauthToken?: string; signal?: AbortSignal } = {}) {
+  await import('webauthn-polyfills');
+  const options = await authRequest<PublicKeyCredentialCreationOptionsJSON>('passkeys/register/options', { username, promotion }, 'POST', reauthToken, signal);
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  signal?.throwIfAborted();
+  const credential = await navigator.credentials.create({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('Canceled', 'NotAllowedError');
+  const encoded = credential.toJSON();
+  try {
+    return await authRequest<AuthSession>('passkeys/register/verify', { credential: encoded, username }, 'POST', reauthToken, signal);
+  } catch (error) {
+    await signalUnknown(publicKey.rp.id!, credential.id);
+    throw error;
+  }
+}
+
+export async function authenticatePasskey(signal: AbortSignal, conditional = false) {
+  await import('webauthn-polyfills');
+  const options = await authRequest<PublicKeyCredentialRequestOptionsJSON>('passkeys/authenticate/options', {}, 'POST', undefined, signal);
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  signal.throwIfAborted();
+  const credential = await navigator.credentials.get({ publicKey, signal, ...(conditional ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('Canceled', 'NotAllowedError');
+  try {
+    return await authRequest<AuthSession>('passkeys/authenticate/verify', { credential: credential.toJSON() }, 'POST', undefined, signal);
+  } catch (error) {
+    // Only explicit unknown-credential responses can invalidate a saved sign-in credential.
+    if (error instanceof AuthError && error.status === 404) await signalUnknown(publicKey.rpId!, credential.id);
+    throw error;
+  }
+}
+
+export async function reauthenticatePasskey(action: string, signal: AbortSignal) {
+  await import('webauthn-polyfills');
+  const options = await authRequest<PublicKeyCredentialRequestOptionsJSON>('passkeys/reauthenticate/options', { action }, 'POST', undefined, signal);
+  // Never open an unconstrained account picker for a signed-in user's sensitive action.
+  if (!options.allowCredentials?.length || options.userVerification !== 'required') throw new AuthError('Identity verification is unavailable. Please use your password.');
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options);
+  signal.throwIfAborted();
+  const credential = await navigator.credentials.get({ publicKey, signal }) as PublicKeyCredential | null;
+  if (!credential) throw new DOMException('Canceled', 'NotAllowedError');
+  const result = await authRequest<{ reauthToken: string }>('passkeys/reauthenticate/verify', { credential: credential.toJSON(), action }, 'POST', undefined, signal);
+  if (!result.reauthToken) throw new AuthError('Identity verification failed. Please try again.');
+  return result.reauthToken;
+}
