diff --git a/account.js b/account.js
new file mode 100644
index 0000000..219c202
--- /dev/null
+++ b/account.js
@@ -0,0 +1,193 @@
+import 'webauthn-polyfills';
+import providers from './providers.json';
+const $ = id => document.getElementById(id);
+const PK = window.PublicKeyCredential;
+let account = null, busy = false, controller, supported = false, registrationSupported = false, modalAction;
+const validID = v => typeof v === 'string' && v.length > 0 && v.length % 4 !== 1 && /^[A-Za-z0-9_-]+$/.test(v);
+function status(message, error=false) { $('account-status').textContent=message; $('account-status').dataset.error=String(error); }
+async function api(path, method='GET', body) {
+  let response;
+  try { response=await fetch(path,{ method, credentials:'same-origin', headers:method==='GET'?{}:{'Content-Type':'application/json'}, ...(method==='GET'?{}:{body:JSON.stringify(body || {})}) }); }
+  catch { throw new Error('Could not reach your account. Check your connection and try again.'); }
+  let result;
+  try { result=await response.json(); } catch { throw new Error('Account services are unavailable. Please try again later.'); }
+  if(!response.ok) {
+    if(response.status===401) { account=null; render(); }
+    throw Object.assign(new Error(result.error || 'Unable to complete this request.'),{status:response.status});
+  }
+  return result;
+}
+async function signal(method, params) {
+  if(!PK?.[method] || !params.rpId) return;
+  const ids=[params.userId,params.credentialId,...(params.allAcceptedCredentialIds || [])].filter(v=>v!==undefined);
+  if(!ids.every(validID)) { console.warn('Passkey synchronization skipped: invalid server ID.'); return; }
+  try { await PK[method](params); } catch(err) { console.warn('Passkey synchronization unavailable:',err.message); }
+}
+function syncAccepted() { return signal('signalAllAcceptedCredentials',{rpId:account.rpId,userId:account.userId,allAcceptedCredentialIds:account.credentials.map(c=>c.id)}); }
+function abort() { controller?.abort(); controller=undefined; }
+function message(err) {
+  return ({NotAllowedError:'The passkey request was cancelled or timed out. You can try again.',AbortError:'The passkey request was cancelled.',InvalidStateError:'A passkey already exists in this password manager. Try a different device or provider.',SecurityError:'Passkeys require a secure connection and a matching site domain.'})[err.name] || err.message || 'Something went wrong. Please try again.';
+}
+function setBusy(value) {
+  busy=value;
+  $('my-account').setAttribute('aria-busy',String(value));
+  document.querySelectorAll('#my-account button, #logout, #dialog-confirm').forEach(button=>{
+    button.disabled=value || (button.hasAttribute('data-passkey') && !supported);
+  });
+  document.querySelectorAll('#register-form [data-passkey], #add-passkey').forEach(button=>button.disabled=value || !registrationSupported);
+  // Removing the final credential would lock this passwordless account out.
+  document.querySelectorAll('[data-last-passkey]').forEach(button=>button.disabled=true);
+}
+async function run(action) {
+  if(busy) return;
+  abort(); setBusy(true);
+  try { await action(); }
+  catch(err) {
+    status(message(err),true);
+    if($('passkey-dialog').open) $('dialog-status').textContent=message(err);
+  } finally { setBusy(false); if(!account?.user && !$('signin-form').hidden) startAutofill(); }
+}
+function date(value) { return value ? new Intl.DateTimeFormat(undefined,{dateStyle:'medium'}).format(new Date(value)) : 'Not used yet'; }
+function element(tag,text,className) { const el=document.createElement(tag); if(text!==undefined) el.textContent=text; if(className) el.className=className; return el; }
+function render() {
+  const user=account?.user;
+  $('account-loading').hidden=true; $('account-guest').hidden=!!user; $('account-member').hidden=!user; $('logout').hidden=!user;
+  if(!user) return;
+  $('member-greeting').textContent=`Welcome back, ${user.displayName}.`;
+  $('profile-name').value=user.displayName; $('profile-email').value=user.name;
+  $('passkey-count').textContent=account.credentials.length;
+  const list=$('passkey-list'); list.replaceChildren();
+  if(!account.credentials.length) list.append(element('li','No passkeys found. Add one to secure your account.','account-note'));
+  for(const credential of account.credentials) {
+    const provider=credential.aaguid!=='00000000-0000-0000-0000-000000000000' ? providers[credential.aaguid] : null;
+    const row=element('li',undefined,'passkey-row');
+    const detail=element('div',undefined,'passkey-detail');
+    if(provider?.icon_light?.startsWith('data:image/')) { const icon=element('img',undefined,'provider-icon'); icon.src=provider.icon_light; icon.alt=''; detail.append(icon); }
+    else {const icon=element('span','⚿','provider-icon');icon.setAttribute('aria-hidden','true');detail.append(icon);}
+    const info=element('div'); info.append(element('strong',credential.name),element('p',provider?.name || 'Unknown passkey provider'),element('p',`Added ${date(credential.registeredAt)} · Last used: ${date(credential.lastUsedAt)}`),element('p',credential.credentialBackedUp?'Backed up by your passkey provider':'Keep a backup passkey on another device'));
+    detail.append(info);
+    const actions=element('div',undefined,'passkey-actions');
+    const rename=element('button','Rename','text-button'); rename.type='button'; rename.setAttribute('aria-label',`Rename ${credential.name}`); rename.addEventListener('click',()=>openDialog('rename',credential));
+    const remove=element('button','Remove','text-button remove'); remove.type='button'; remove.setAttribute('aria-label',`Remove ${credential.name}`); remove.addEventListener('click',()=>openDialog('remove',credential));
+    if(account.credentials.length===1) {remove.disabled=true;remove.dataset.lastPasskey='';remove.title='Add another passkey before removing your last one.';}
+    actions.append(rename,remove);row.append(detail,actions);list.append(row);
+  }
+  setBusy(busy);
+}
+async function authenticated(result) { abort(); account=result;render();await syncAccepted(); }
+async function authenticate({reauth=false,conditional=false}={}) {
+  const prefix=reauth?'/api/reauth':'/api/auth';
+  const options=await api(`${prefix}/options`,'POST');
+  if(conditional && (busy || account?.user || $('signin-form').hidden)) return;
+  const publicKey=PK.parseRequestOptionsFromJSON(options);
+  controller=new AbortController();
+  const credential=await navigator.credentials.get({publicKey,signal:controller.signal,...(conditional?{mediation:'conditional'}:{})});
+  if(!credential) throw new Error('No passkey selected. Please try again.');
+  const encoded=credential.toJSON();
+  let result;
+  try { result=await api(`${prefix}/verify`,'POST',encoded); }
+  catch(err) {
+    if(err.status===404 && !reauth && !account?.user) await signal('signalUnknownCredential',{rpId:publicKey.rpId,credentialId:encoded.id});
+    throw err;
+  }
+  if(!reauth) await authenticated(result);
+  return result;
+}
+async function startAutofill() {
+  if(!supported || busy || account?.user || $('signin-form').hidden) return;
+  try {
+    const caps=await PK.getClientCapabilities();
+    if(!caps.conditionalGet || busy || account?.user) return;
+    abort();
+    await authenticate({conditional:true});
+    status('You’re signed in. Welcome back!');
+  } catch(err) {
+    if(!['AbortError','NotAllowedError'].includes(err.name) && !busy) status(message(err),true);
+  }
+}
+async function register(body={}) {
+  if(account?.user) {status('Verify your identity to add a passkey.');await authenticate({reauth:true});}
+  const options=await api('/api/register/options','POST',body);
+  const publicKey=PK.parseCreationOptionsFromJSON(options);
+  controller=new AbortController();
+  const credential=await navigator.credentials.create({publicKey,signal:controller.signal});
+  if(!credential) throw new Error('No passkey created. Please try again.');
+  const encoded=credential.toJSON();
+  let result;
+  try {result=await api('/api/register/verify','POST',encoded);}
+  catch(err) {
+    // A lost network response may hide a successful commit; reconcile first.
+    try {
+      const current=await api('/api/account');
+      if(current.user && current.credentials.some(c=>c.id===encoded.id)) result=current;
+      else await signal('signalUnknownCredential',{rpId:publicKey.rp.id,credentialId:encoded.id});
+    } catch { /* Do not discard a potentially committed passkey while offline. */ }
+    if(!result) throw err;
+  }
+  await authenticated(result);status('Your passkey is saved. You’re ready for your next daily grind.');
+  $('register-form').reset();
+}
+function switchForm(registering) {
+  if(busy) return;
+  abort(); $('signin-form').hidden=registering; $('register-form').hidden=!registering;
+  $('show-signin').setAttribute('aria-pressed',String(!registering)); $('show-register').setAttribute('aria-pressed',String(registering));
+  status('');
+  if(!registering) startAutofill();
+}
+function openDialog(type,credential) {
+  modalAction={type,credential};
+  $('passkey-dialog-title').textContent=type==='rename'?'Rename passkey':'Remove passkey?';
+  $('passkey-dialog-description').textContent=type==='rename'?'Choose a name you’ll recognize. This only changes the label in your Daily Grind account.':`Remove “${credential.name}” from your account? You’ll verify your identity first. It may also need to be removed from your password manager.`;
+  $('passkey-name-field').hidden=type!=='rename'; $('passkey-name').required=type==='rename';$('passkey-name').value=credential.name;
+  $('dialog-confirm').textContent=type==='rename'?'Save name':'Verify & remove'; $('dialog-status').textContent='';
+  $('passkey-dialog').showModal();
+}
+$('show-signin').addEventListener('click',()=>switchForm(false));
+$('show-register').addEventListener('click',()=>switchForm(true));
+$('register-instead').addEventListener('click',()=>switchForm(true));
+$('signin-form').addEventListener('submit',event=>{event.preventDefault();run(async()=>{status('Choose your passkey to sign in…');await authenticate();status('You’re signed in. Welcome back!');});});
+$('register-form').addEventListener('submit',event=>{event.preventDefault();const body=Object.fromEntries(new FormData(event.currentTarget));run(()=>register(body));});
+$('add-passkey').addEventListener('click',()=>run(()=>register()));
+$('verify-identity').addEventListener('click',()=>run(async()=>{status('Verify with a passkey for this account…');await authenticate({reauth:true});status('Identity verified. You can make sensitive changes for the next five minutes.');}));
+$('profile-form').addEventListener('submit',event=>{
+  event.preventDefault();const body=Object.fromEntries(new FormData(event.currentTarget));
+  run(async()=>{
+    status('Verify your identity to save your profile…');await authenticate({reauth:true});
+    account=await api('/api/profile','PUT',body);render();
+    await signal('signalCurrentUserDetails',{rpId:account.rpId,userId:account.userId,name:account.user.name,displayName:account.user.displayName});
+    status('Your profile has been updated.');
+  });
+});
+$('logout').addEventListener('click',()=>run(async()=>{await api('/api/logout','POST');account=null;render();status('You’re signed out. See you for your next cup.');}));
+$('dialog-cancel').addEventListener('click',()=>$('passkey-dialog').close());
+$('passkey-dialog').addEventListener('close',()=>{abort();modalAction=null;});
+$('passkey-dialog-form').addEventListener('submit',event=>{
+  event.preventDefault();const action=modalAction; const name=$('passkey-name').value.trim();
+  if(action.type==='rename'&&!name) {$('dialog-status').textContent='Enter a passkey name.';return;}
+  run(async()=>{
+    if(action.type==='remove') { $('dialog-status').textContent='Verify with a passkey for this account…';await authenticate({reauth:true}); if(modalAction!==action) throw new DOMException('Cancelled','AbortError'); }
+    account=await api(`/api/credentials/${encodeURIComponent(action.credential.id)}`,action.type==='rename'?'PUT':'DELETE',action.type==='rename'?{name}:{});
+    render();if(action.type==='remove') await syncAccepted();
+    $('passkey-dialog').close();status(action.type==='rename'?'Passkey renamed.':'Passkey removed. Remove its saved copy from your password manager if it still appears there.');
+  });
+});
+async function initialize() {
+  setBusy(true);
+  try {
+    if(window.isSecureContext && PK && navigator.credentials) {
+      const caps=await PK.getClientCapabilities();
+      supported=true;
+      // The capabilities polyfill cannot infer hybrid transport support.
+      registrationSupported=!!(caps.passkeyPlatformAuthenticator ?? caps.userVerifyingPlatformAuthenticator) && !!caps.conditionalGet;
+    }
+  } catch { supported=false; }
+  $('passkey-unavailable').hidden=registrationSupported;
+  try {
+    account=await api('/api/account');render();
+    if(account.user) {await syncAccepted();status('Your account, all in one place.');}
+    else status(supported?'Sign in or create an account to get started.':'Passkeys aren’t supported in this browser or connection.');
+  } catch(err) { render();status(message(err),true); }
+  finally {setBusy(false);startAutofill();}
+  if(location.pathname==='/account') $('my-account').scrollIntoView();
+}
+initialize();
