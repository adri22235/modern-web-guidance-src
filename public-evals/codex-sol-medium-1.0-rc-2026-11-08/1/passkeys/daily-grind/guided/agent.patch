--- /dev/null
+++ b/server/app.js
@@ -0,0 +1,160 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, createHash } from 'node:crypto';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+
+const token = () => randomBytes(32).toString('base64url');
+const hash = value => createHash('sha256').update(value).digest('hex');
+const fail = (status, message) => { throw Object.assign(new Error(message), { status }); };
+export function createApp({ database = 'data/accounts.sqlite', origin = 'http://localhost:11222', rpID = new URL(origin).hostname } = {}) {
+  const url = new URL(origin);
+  if (url.origin !== origin) throw new Error('APP_ORIGIN must be an exact origin without a path or trailing slash.');
+  if (url.protocol !== 'https:' && !['localhost', '127.0.0.1'].includes(url.hostname)) throw new Error('APP_ORIGIN must use HTTPS.');
+  const db = new DatabaseSync(database);
+  db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+    CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, name TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS credentials (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), record TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, record TEXT NOT NULL, expires INTEGER NOT NULL);`);
+  const getUser = id => db.prepare('SELECT * FROM users WHERE id=?').get(id);
+  const list = id => db.prepare('SELECT record FROM credentials WHERE userId=?').all(id).map(row => JSON.parse(row.record));
+  const putCredential = (userId, c) => db.prepare('INSERT OR REPLACE INTO credentials VALUES (?,?,?)').run(c.id, userId, JSON.stringify(c));
+  const profile = user => ({ user, rpId: rpID, userId: user.id, credentials: list(user.id).map(({ publicKey, counter, ...safe }) => safe) });
+  const clean = (value, max=80) => typeof value === 'string' && value.trim().length > 0 && value.trim().length <= max ? value.trim() : fail(400, 'Please complete all fields with a valid value.');
+  const details = body => {
+    const name = clean(body.name, 254).toLowerCase();
+    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(name)) fail(400, 'Enter a valid email address.');
+    return { name, displayName: clean(body.displayName) };
+  };
+  const limits = new Map();
+  return { close: () => db.close(), async handle(req, clientIP='local') {
+    let session, sessionID, cookie;
+    const headers = { 'Content-Type': 'application/json', 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff' };
+    const respond = (body, status=200) => {
+      if (session && sessionID) {
+        const expires = Date.now()+8*60*60*1000;
+        if (cookie) db.prepare('INSERT INTO sessions VALUES (?,?,?)').run(hash(sessionID), JSON.stringify(session), expires);
+        else db.prepare('UPDATE sessions SET record=?, expires=? WHERE id=?').run(JSON.stringify(session), expires, hash(sessionID));
+      }
+      if (cookie) headers['Set-Cookie'] = cookie;
+      return new Response(JSON.stringify(body), { status, headers });
+    };
+    const rotate = () => {
+      if (sessionID) db.prepare('DELETE FROM sessions WHERE id=?').run(hash(sessionID));
+      sessionID = token();
+      cookie = `dg_session=${sessionID}; HttpOnly; SameSite=Strict; Path=/; Max-Age=28800${url.protocol === 'https:' ? '; Secure' : ''}`;
+    };
+    try {
+      const path = new URL(req.url).pathname;
+      if (req.method !== 'GET') {
+        if (req.headers.get('origin') !== origin) fail(403, 'Request origin was rejected.');
+        if (!req.headers.get('content-type')?.startsWith('application/json')) fail(415, 'JSON is required.');
+        const now = Date.now();
+        for (const [key, value] of limits) if (value.until < now) limits.delete(key);
+        const rate = limits.get(clientIP) || { count: 0, until: now+60000 };
+        limits.set(clientIP, rate);
+        if (++rate.count > 60) fail(429, 'Too many attempts. Please wait a minute.');
+      }
+      db.prepare('DELETE FROM sessions WHERE expires < ?').run(Date.now());
+      sessionID = req.headers.get('cookie')?.match(/(?:^|;\s*)dg_session=([A-Za-z0-9_-]{43})(?:;|$)/)?.[1];
+      const stored = sessionID && db.prepare('SELECT record FROM sessions WHERE id=?').get(hash(sessionID));
+      session = stored ? JSON.parse(stored.record) : {};
+      if (!stored) rotate();
+      const user = session.userId && getUser(session.userId);
+      const signedIn = () => user || fail(401, 'Please sign in to your account.');
+      const requireRecent = () => { signedIn(); if (!session.verifiedAt || Date.now()-session.verifiedAt > 5*60000) fail(403, 'Verify your identity to continue.'); };
+      let body = {};
+      if (req.method !== 'GET') {
+        const raw = await req.text();
+        if (raw.length > 65536) fail(413, 'Request is too large.');
+        try { body = JSON.parse(raw); } catch { fail(400, 'Invalid JSON.'); }
+        if (!body || typeof body !== 'object' || Array.isArray(body)) fail(400, 'Invalid request.');
+      }
+      if (path === '/api/account' && req.method === 'GET') return respond(user ? profile(user) : { user: null });
+      if (path === '/api/logout' && req.method === 'POST') { session = {}; rotate(); return respond({ success: true }); }
+      if (path === '/api/register/options' && req.method === 'POST') {
+        let account;
+        if (user) { requireRecent(); account = user; }
+        else {
+          account = { id: token(), ...details(body) };
+          if (db.prepare('SELECT id FROM users WHERE name=?').get(account.name)) fail(409, 'An account with this email already exists. Sign in with your passkey.');
+        }
+        const options = await generateRegistrationOptions({ rpName: 'The Daily Grind', rpID, userID: Buffer.from(account.id, 'base64url'), userName: account.name, userDisplayName: account.displayName, attestationType: 'none', supportedAlgorithmIDs: [-7, -257], excludeCredentials: user ? list(user.id).map(c => ({ id:c.id, transports:c.transports })) : [], authenticatorSelection: { residentKey:'required', requireResidentKey:true, userVerification:'preferred' } });
+        session.ceremony = { type:'register', challenge:options.challenge, account, existing:!!user, expires:Date.now()+300000, uv:false };
+        return respond(options);
+      }
+      if (['/api/auth/options','/api/reauth/options'].includes(path) && req.method === 'POST') {
+        const reauth = path.includes('/reauth/');
+        if (reauth) { signedIn(); if (!list(user.id).length) fail(409, 'No passkeys are available for this account.'); }
+        const options = await generateAuthenticationOptions({ rpID, userVerification:reauth ? 'required' : 'preferred', allowCredentials:reauth ? list(user.id).map(c=>({id:c.id, transports:c.transports})) : [] });
+        session.ceremony = { type:reauth?'reauth':'auth', challenge:options.challenge, userId:reauth?user.id:null, expires:Date.now()+300000, uv:reauth };
+        return respond(options);
+      }
+      if (['/api/register/verify','/api/auth/verify','/api/reauth/verify'].includes(path) && req.method === 'POST') {
+        const kind = path.split('/')[2];
+        const pending = session.ceremony;
+        delete session.ceremony;
+        // Consume before asynchronous verification, including failed attempts.
+        const consumed = db.prepare('UPDATE sessions SET record=? WHERE id=? AND record=?').run(JSON.stringify(session), hash(sessionID), stored?.record || '');
+        if (!consumed.changes) fail(400, 'This request was already used or replaced. Please try again.');
+        if (!pending || pending.type !== kind || pending.expires < Date.now()) fail(400, 'This request expired. Please try again.');
+        if (kind === 'register') {
+          if (pending.existing && (!user || user.id !== pending.account.id)) fail(403, 'Account changed. Sign in again.');
+          const result = await verifyRegistrationResponse({ response:body, expectedChallenge:pending.challenge, expectedOrigin:origin, expectedRPID:rpID, requireUserVerification:pending.uv });
+          if (!result.verified || !result.registrationInfo) fail(400, 'Passkey registration could not be verified.');
+          const { credential, credentialDeviceType, credentialBackedUp, aaguid } = result.registrationInfo;
+          if (!db.prepare('SELECT id FROM sessions WHERE id=?').get(hash(sessionID))) fail(401, 'Your session ended. Please sign in again.');
+          if (db.prepare('SELECT id FROM credentials WHERE id=?').get(credential.id)) fail(409, 'This passkey is already registered.');
+          db.exec('BEGIN IMMEDIATE');
+          try {
+            if (!pending.existing) db.prepare('INSERT INTO users VALUES (?,?,?)').run(pending.account.id, pending.account.name, pending.account.displayName);
+            putCredential(pending.account.id, { id:credential.id, publicKey:Buffer.from(credential.publicKey).toString('base64url'), counter:credential.counter, transports:credential.transports || [], credentialType:'public-key', credentialDeviceType, credentialBackedUp, aaguid, name:'My passkey', registeredAt:Date.now(), lastUsedAt:null });
+            db.exec('COMMIT');
+          } catch (err) { db.exec('ROLLBACK'); if (err.code?.startsWith('ERR_SQLITE')) fail(409, 'Account registration conflicted. Please sign in or try again.'); throw err; }
+          session = { userId:pending.account.id }; rotate();
+          return respond(profile(getUser(session.userId)));
+        }
+        const row = db.prepare('SELECT * FROM credentials WHERE id=?').get(body.id || '');
+        if (!row) fail(404, 'This passkey is no longer registered. Try another passkey.');
+        if (kind === 'reauth' && (!user || row.userId !== user.id || pending.userId !== user.id)) fail(403, 'Use a passkey for the signed-in account.');
+        if (body.response?.userHandle && body.response.userHandle !== row.userId) fail(403, 'Passkey account did not match.');
+        const credential = JSON.parse(row.record);
+        const result = await verifyAuthenticationResponse({ response:body, expectedChallenge:pending.challenge, expectedOrigin:origin, expectedRPID:rpID, requireUserVerification:pending.uv, credential:{ id:credential.id, publicKey:Buffer.from(credential.publicKey,'base64url'), counter:credential.counter, transports:credential.transports } });
+        if (!result.verified) fail(400, 'Passkey authentication could not be verified.');
+        credential.counter = result.authenticationInfo.newCounter;
+        credential.lastUsedAt = Date.now();
+        credential.credentialBackedUp = result.authenticationInfo.credentialBackedUp;
+        credential.credentialDeviceType = result.authenticationInfo.credentialDeviceType;
+        if (!db.prepare('SELECT id FROM sessions WHERE id=?').get(hash(sessionID))) fail(401, 'Your session ended. Please sign in again.');
+        const saved = db.prepare('UPDATE credentials SET record=? WHERE id=? AND record=?').run(JSON.stringify(credential), row.id, row.record);
+        if (!saved.changes) fail(409, 'This passkey changed during sign-in. Please try again.');
+        session = { userId:row.userId, ...(kind==='reauth' ? { verifiedAt:Date.now() } : {}) }; rotate();
+        return respond(profile(getUser(row.userId)));
+      }
+      if (path === '/api/profile' && req.method === 'PUT') {
+        requireRecent();
+        const updated = details(body);
+        if (db.prepare('SELECT id FROM users WHERE name=? AND id<>?').get(updated.name,user.id)) fail(409, 'This email is already in use.');
+        db.prepare('UPDATE users SET name=?,displayName=? WHERE id=?').run(updated.name,updated.displayName,user.id);
+        delete session.verifiedAt;
+        return respond(profile(getUser(user.id)));
+      }
+      if (path.startsWith('/api/credentials/') && ['PUT','DELETE'].includes(req.method)) {
+        signedIn();
+        const id = path.slice('/api/credentials/'.length);
+        const credential = list(user.id).find(c=>c.id===id);
+        if (!credential) fail(404, 'Passkey not found.');
+        if (req.method === 'PUT') { credential.name = clean(body.name); putCredential(user.id,credential); }
+        else {
+          requireRecent();
+          if (list(user.id).length <= 1) fail(409, 'Add another passkey before removing your last one.');
+          db.prepare('DELETE FROM credentials WHERE id=? AND userId=?').run(id,user.id);
+          delete session.verifiedAt;
+        }
+        return respond(profile(user));
+      }
+      fail(404, 'Not found.');
+    } catch (err) {
+      if (!err.status) console.warn('Account request failed:', err.message);
+      return respond({ error:err.status ? err.message : 'Unable to verify this request. Please try again.' }, err.status || 400);
+    }
+  }};
+}
diff --git a/server/start.js b/server/start.js
new file mode 100644
index 0000000..e45d700
--- /dev/null
+++ b/server/start.js
@@ -0,0 +1,27 @@
+import { createServer } from 'node:http';
+import { mkdir, readFile } from 'node:fs/promises';
+import { createApp } from './app.js';
+const port = Number(process.env.PORT || 11222);
+const origin = process.env.APP_ORIGIN || `http://localhost:${port}`;
+if (process.env.NODE_ENV === 'production' && !process.env.APP_ORIGIN) throw new Error('Set APP_ORIGIN to your HTTPS website URL.');
+await mkdir('data', { recursive:true });
+const app = createApp({ origin, rpID:process.env.RP_ID || new URL(origin).hostname, database:process.env.DATABASE_PATH || 'data/accounts.sqlite' });
+const files = new Map([['/', ['index.html','text/html']], ['/account',['index.html','text/html']], ['/account.js',['public/account.js','text/javascript']], ['/account.css',['account.css','text/css']]]);
+createServer(async (req,res) => {
+  try {
+    const path = new URL(req.url,origin).pathname;
+    res.setHeader('X-Content-Type-Options','nosniff');
+    res.setHeader('Referrer-Policy','same-origin');
+    if (path.startsWith('/api/')) {
+      const chunks=[]; let size=0;
+      for await (const chunk of req) { size+=chunk.length; if(size>65536) { res.writeHead(413);res.end();return; } chunks.push(chunk); }
+      const request = new Request(new URL(req.url,origin), { method:req.method, headers:req.headers, ...(!['GET','HEAD'].includes(req.method) ? { body:Buffer.concat(chunks) } : {}) });
+      const response = await app.handle(request, req.socket.remoteAddress);
+      res.writeHead(response.status,Object.fromEntries(response.headers));res.end(await response.text()); return;
+    }
+    const file=files.get(path);
+    if (!file || !['GET','HEAD'].includes(req.method)) {res.writeHead(404);res.end('Not found');return;}
+    const content=await readFile(file[0]);
+    res.writeHead(200,{'Content-Type':`${file[1]}; charset=utf-8`});res.end(req.method==='HEAD'?undefined:content);
+  } catch {res.writeHead(500);res.end('Unable to complete request. Run npm run build before starting the application.');}
+}).listen(port,()=>console.log(`Daily Grind listening on port ${port}`));
