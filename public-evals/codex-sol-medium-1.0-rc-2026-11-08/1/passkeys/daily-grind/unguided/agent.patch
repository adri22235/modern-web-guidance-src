+async function verifyAuthenticatorData(buffer) {
+  const data = new Uint8Array(buffer);
+  if (data.length < 37) throw new Error('Incomplete passkey response.');
+  const rpHash = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(location.hostname)));
