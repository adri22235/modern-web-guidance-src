+async function verifyClientData(response, challenge, type) {
+  const data = JSON.parse(new TextDecoder().decode(response.clientDataJSON));
+  if (data.type !== type || data.challenge !== toBase64(challenge) || data.origin !== location.origin || data.crossOrigin) throw new Error('The passkey response could not be verified. Please open the site directly and try again.');
