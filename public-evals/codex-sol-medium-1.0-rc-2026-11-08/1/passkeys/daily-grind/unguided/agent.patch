+// Authenticators use ASN.1 DER ECDSA signatures; Web Crypto expects 32-byte r and s.
+function rawSignature(signature) {
+  const bytes = new Uint8Array(signature);
+  if (bytes[0] !== 0x30 || bytes[2] !== 0x02) throw new Error('Invalid passkey signature.');
+  const rLength = bytes[3];
+  const sStart = 4 + rLength;
+  if (bytes[sStart] !== 0x02) throw new Error('Invalid passkey signature.');
+  const sLength = bytes[sStart + 1];
+  const r = bytes.slice(4, sStart);
+  const s = bytes.slice(sStart + 2, sStart + 2 + sLength);
