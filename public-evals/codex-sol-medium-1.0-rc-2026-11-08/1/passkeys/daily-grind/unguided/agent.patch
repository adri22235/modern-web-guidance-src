+    openModal(`${icon('cup', 'modal-icon')}<p class="eyebrow orange">FIND YOUR NEXT USUAL</p><h2 id="modal-title">${title}</h2><p>${description}</p><p>Ask your barista about availability and allergens. Online ordering is not available in this demo.</p><div class="modal-buttons"><button class="button primary" data-close>Sounds like my usual ${icon('heart')}</button></div>`);
+  }
+});
+$('#modal').addEventListener('click', event => {
+  if (busy) return;
+  const rect = $('#modal').getBoundingClientRect();
+  if (event.target === $('#modal') && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) $('#modal').close();
+});
+$('#modal').addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+document.querySelector('.auth-tabs').addEventListener('keydown', event => {
+  if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key) || busy) return;
+  event.preventDefault();
+  const mode = event.key === 'Home' ? 'signin' : event.key === 'End' ? 'register' : authMode === 'signin' ? 'register' : 'signin';
+  setAuthMode(mode);
+  $(`#${mode}-tab`).focus();
+});
+// Do not retain an authenticated UI when another tab changes this browser's records.
+window.addEventListener('storage', event => {
+  if (event.key !== storageKey && event.key !== null) return;
+  currentId = null;
+  storageRevision += 1;
+  operationAbort?.abort();
+  try { const next = JSON.parse(localStorage.getItem(storageKey) || '[]'); if (!Array.isArray(next)) throw new Error(); accounts = next; }
+  catch { accounts = []; }
+  $('#modal').close(); renderView('welcome'); toast('Account data changed in another tab. Sign in again to continue.');
+});
+setAuthMode('signin');
+renderView('welcome');
+if (!storageAvailable) toast('Local account storage is unavailable. Please enable site storage in your browser.', true);
