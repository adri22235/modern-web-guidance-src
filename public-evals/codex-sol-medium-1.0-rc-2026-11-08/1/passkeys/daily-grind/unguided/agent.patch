+  [r, s].forEach((part, index) => {
+    const trimmed = part.length > 32 && part[0] === 0 ? part.slice(1) : part;
+    if (trimmed.length > 32 || !trimmed.length) throw new Error('Invalid passkey signature.');
+    result.set(trimmed, index * 32 + 32 - trimmed.length);
+  });
+  return result;
