diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,77 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+      container-type: scroll-state;
+      scroll-behavior: smooth;
+    }
+
+    .scroll-sentinel {
+      height: 1px;
+      margin-bottom: -1px;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: sticky;
+      bottom: 20px;
+      z-index: 1001;
+      display: block;
+      width: fit-content;
+      margin: 20px 20px 20px auto;
+      padding: 10px 18px;
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      text-decoration: none;
+      box-shadow: 0 2px 8px rgb(0 0 0 / 20%);
+      visibility: hidden;
+      opacity: 0;
+      translate: 0 20px;
+      transition: visibility 0.3s, opacity 0.3s ease, translate 0.3s ease;
+    }
+
+    .back-to-top:hover {
+      background: var(--text);
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @container scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .scroller.scrolled .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .back-to-top {
+        transition: none;
+        translate: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -155,10 +224,12 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller">
+  <div id="page-top" class="scroll-sentinel" tabindex="-1"></div>
 
-  <nav>
+  <nav aria-label="Main navigation">
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
       <li><a href="/locations">Locations</a></li>
@@ -206,7 +277,22 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <a class="back-to-top" href="#page-top">↑ Back to top</a>
+  </div>
+
+  <script>
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const scroller = document.querySelector('.scroller');
+      const sentinel = scroller.querySelector('.scroll-sentinel');
+      const observer = new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller, threshold: 1 });
+
+      observer.observe(sentinel);
+    }
+  </script>
+
 </body>
 
 </html>
