diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,63 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      position: relative;
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+    }
+
+    .scroll-marker {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 1px;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: fixed;
+      right: 24px;
+      bottom: 24px;
+      z-index: 1001;
+      padding: 12px 18px;
+      border: 1px solid var(--secondary);
+      border-radius: 999px;
+      background: var(--primary);
+      color: white;
+      font: inherit;
+      cursor: pointer;
+      box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+      transform: translateY(16px);
+      transition: opacity 200ms ease, transform 200ms ease, visibility 200ms;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      visibility: visible;
+      pointer-events: auto;
+      transform: translateY(0);
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+        transform: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -155,10 +210,12 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller">
+  <span class="scroll-marker" aria-hidden="true"></span>
 
-  <nav>
+  <nav id="page-top" tabindex="-1">
     <div class="logo">THE DAILY GRIND</div>
     <ul>
       <li><a href="/menu">Menu</a></li>
       <li><a href="/locations">Locations</a></li>
@@ -206,7 +263,42 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" aria-label="Back to top" aria-hidden="true" inert>
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+    const topMarker = scroller.querySelector('.scroll-marker');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    // Only runs when the marker crosses the reveal boundary, not on every scroll.
+    const topObserver = new IntersectionObserver(([entry]) => {
+      const visible = !entry.isIntersecting;
+      backToTop.inert = !visible;
+      backToTop.setAttribute('aria-hidden', String(!visible));
+      backToTop.classList.toggle('is-visible', visible);
+    }, {
+      root: scroller,
+      rootMargin: '120px 0px 0px 0px',
+      threshold: 0,
+    });
+
+    topObserver.observe(topMarker);
+
+    backToTop.addEventListener('click', () => {
+      // Give keyboard users a stable focus target before the button hides.
+      document.getElementById('page-top').focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: reducedMotion.matches ? 'instant' : 'smooth',
+      });
+    });
+  </script>
+
 </body>
 
 </html>
