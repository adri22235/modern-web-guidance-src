+  <script>
+    const toolbar = document.getElementById('favorites-actions');
+    const buttons = Array.from(toolbar.querySelectorAll('button'));
+    const cards = document.getElementById('favorites-cards');
+    const filters = document.getElementById('favorites-filters');
+    const temperature = document.getElementById('favorites-temperature');
+    const status = document.getElementById('favorites-status');
+
+    // A single tab stop with arrow-key navigation keeps the toolbar easy to use.
+    toolbar.addEventListener('focusin', (event) => {
+      if (!buttons.includes(event.target)) return;
+      buttons.forEach((button) => button.tabIndex = button === event.target ? 0 : -1);
+    });
+    toolbar.addEventListener('keydown', (event) => {
+      const index = buttons.indexOf(document.activeElement);
+      if (index < 0) return;
+      let next;
+      if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
+      if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = buttons.length - 1;
+      if (next === undefined) return;
+      event.preventDefault();
+      buttons[next].focus();
+    });
+
+    toolbar.querySelectorAll('[data-view]').forEach((button) => {
+      button.addEventListener('click', () => {
+        cards.classList.toggle('list-view', button.dataset.view === 'list');
+        toolbar.querySelectorAll('[data-view]').forEach((view) => {
+          view.setAttribute('aria-pressed', String(view === button));
+        });
+      });
+    });
+
+    document.getElementById('favorites-details-toggle').addEventListener('click', (event) => {
+      const hidden = cards.classList.toggle('details-hidden');
+      event.currentTarget.setAttribute('aria-pressed', String(!hidden));
+    });
+
+    function applyFilter() {
+      let count = 0;
+      cards.querySelectorAll('.card').forEach((card) => {
+        card.hidden = !filters.hidden && temperature.value !== 'all' && card.dataset.temperature !== temperature.value;
+        if (!card.hidden) count++;
+      });
+      status.textContent = `${count} featured drinks shown.`;
+    }
+
+    document.getElementById('favorites-filters-toggle').addEventListener('click', (event) => {
+      filters.hidden = !filters.hidden;
+      event.currentTarget.setAttribute('aria-pressed', String(!filters.hidden));
+      event.currentTarget.setAttribute('aria-expanded', String(!filters.hidden));
+      applyFilter();
+    });
+    temperature.addEventListener('change', applyFilter);
+
+    document.getElementById('favorites-copy').addEventListener('click', async () => {
+      const drinks = Array.from(cards.querySelectorAll('.card'))
+        .map((card) => `${card.querySelector('h3').textContent} — ${card.querySelector('p').textContent}`)
+        .join('\n');
+      try {
+        await navigator.clipboard.writeText(`Seasonal Favorites\n${drinks}`);
+        status.textContent = 'Featured drinks list copied.';
+      } catch {
+        status.textContent = 'Unable to copy the list. Please allow clipboard access and try again.';
+      }
+    });
+  </script>
