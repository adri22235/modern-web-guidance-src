+  <script>
+    const favoritesToolbar = document.getElementById('favorites-actions');
+    const drinks = document.getElementById('featured-drinks');
+    const cards = [...drinks.querySelectorAll('.card')];
+    const viewButtons = [...favoritesToolbar.querySelectorAll('[data-view]')];
+    const detailsButton = document.getElementById('favorites-details');
+    const filterButton = document.getElementById('favorites-filter-toggle');
+    const filters = document.getElementById('favorites-filters');
+    const drinkType = document.getElementById('favorites-drink-type');
+    const copyStatus = document.getElementById('favorites-status');
+
+    viewButtons.forEach(button => button.addEventListener('click', () => {
+      drinks.dataset.view = button.dataset.view;
+      viewButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+    }));
+
+    detailsButton.addEventListener('click', () => {
+      const showDetails = detailsButton.getAttribute('aria-pressed') !== 'true';
+      detailsButton.setAttribute('aria-pressed', String(showDetails));
+      cards.forEach(card => { card.querySelector('p').hidden = !showDetails; });
+    });
+
+    function filterDrinks() {
+      cards.forEach(card => {
+        card.hidden = !filters.hidden && drinkType.value !== 'all' && card.dataset.type !== drinkType.value;
+      });
+    }
+
+    filterButton.addEventListener('click', () => {
+      filters.hidden = !filters.hidden;
+      filterButton.setAttribute('aria-pressed', String(!filters.hidden));
+      filterButton.setAttribute('aria-expanded', String(!filters.hidden));
+      filterDrinks();
+    });
+    drinkType.addEventListener('change', filterDrinks);
+
+    let statusTimer;
+    let lastCopyMessage = '';
+    async function copyDrinks() {
+      // Copy every featured drink, even when descriptions or filtered cards are hidden.
+      const text = cards.map(card => `${card.querySelector('h3').textContent}: ${card.querySelector('p').textContent}`).join('\n');
+      let message;
+      try {
+        await navigator.clipboard.writeText(text);
+        message = 'Featured drinks list copied.';
+      } catch {
+        message = 'Copy failed. Please select and copy the drink list manually.';
+      }
+      clearTimeout(statusTimer);
+      if (message === lastCopyMessage) message += '\u00A0';
+      lastCopyMessage = message;
+      copyStatus.textContent = message;
+      statusTimer = setTimeout(() => { copyStatus.textContent = ''; }, 5000);
+    }
+
+    if ('CommandEvent' in window) {
+      drinks.addEventListener('command', event => {
+        if (event.command === '--copy') copyDrinks();
+      });
+    } else {
+      favoritesToolbar.querySelector('[command="--copy"]').addEventListener('click', copyDrinks);
+    }
+
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      const buttons = [...favoritesToolbar.querySelectorAll('button')];
+      buttons.forEach((button, index) => { button.tabIndex = index === 0 ? 0 : -1; });
+      favoritesToolbar.addEventListener('focusin', event => {
+        if (buttons.includes(event.target)) {
+          buttons.forEach(button => { button.tabIndex = button === event.target ? 0 : -1; });
+        }
+      });
+      favoritesToolbar.addEventListener('keydown', event => {
+        const current = buttons.indexOf(document.activeElement);
+        if (current < 0) return;
+        const rtl = getComputedStyle(favoritesToolbar).direction === 'rtl';
+        let next;
+        if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = buttons.length - 1;
+        else if (event.key === 'ArrowRight') next = current + (rtl ? -1 : 1);
+        else if (event.key === 'ArrowLeft') next = current + (rtl ? 1 : -1);
+        else return;
+        event.preventDefault();
+        buttons[(next + buttons.length) % buttons.length].focus();
+      });
+    }
+
+    if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+      favoritesToolbar.querySelectorAll('button[title]').forEach((button, index) => {
+        const hint = document.createElement('div');
+        hint.id = `favorites-hint-${index}`;
+        hint.className = 'favorites-hint';
+        hint.textContent = button.title;
+        hint.setAttribute('popover', 'hint');
+        document.body.append(hint);
+        button.setAttribute('interestfor', hint.id);
+        button.removeAttribute('title');
+      });
+    }
+  </script>
