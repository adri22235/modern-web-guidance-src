+  <script type="module">
+    const installButton = document.querySelector('#install-app');
+    const installStatus = document.querySelector('#install-status');
+    const supportsWebInstall = typeof navigator.install === 'function';
+    const standalone = window.matchMedia('(display-mode: standalone)');
+    let deferredInstallPrompt;
+    let installed = standalone.matches || navigator.standalone === true;
+
+    function updateInstallButton() {
+      installButton.hidden = installed || !window.isSecureContext ||
+        !(supportsWebInstall || deferredInstallPrompt);
+    }
+
+    window.addEventListener('beforeinstallprompt', (event) => {
+      event.preventDefault();
+      deferredInstallPrompt = event;
+      updateInstallButton();
+    });
+
+    window.addEventListener('appinstalled', () => {
+      installed = true;
+      deferredInstallPrompt = undefined;
+      installStatus.textContent = 'The Daily Grind is installed.';
+      updateInstallButton();
+    });
+
+    standalone.addEventListener('change', (event) => {
+      installed = event.matches || navigator.standalone === true;
+      updateInstallButton();
+    });
+
+    installButton.addEventListener('click', async () => {
+      if (installButton.getAttribute('aria-disabled') === 'true') return;
+      installButton.setAttribute('aria-disabled', 'true');
+      installStatus.textContent = '';
+
+      try {
+        if (supportsWebInstall) {
+          // Keep this call in the click handler to preserve user activation.
+          await navigator.install();
+          installed = true;
+          deferredInstallPrompt = undefined;
+          installStatus.textContent = 'The Daily Grind was installed or opened.';
+        } else if (deferredInstallPrompt) {
+          // Each captured prompt can only be used once.
+          const promptEvent = deferredInstallPrompt;
+          deferredInstallPrompt = undefined;
+          await promptEvent.prompt();
+          const { outcome } = await promptEvent.userChoice;
+          if (!installed) {
+            installStatus.textContent = outcome === 'accepted'
+              ? 'Installation approved.'
+              : 'Installation canceled.';
+          }
+          if (outcome === 'accepted') {
+            installed = true;
+            deferredInstallPrompt = undefined;
+          }
+        }
+      } catch (error) {
+        installStatus.textContent = error.name === 'AbortError'
+          ? 'Installation was canceled or could not complete.'
+          : 'Installation could not start. Please try again later.';
+        if (error.name !== 'AbortError') console.error('App installation failed:', error);
+      } finally {
+        installButton.removeAttribute('aria-disabled');
+        updateInstallButton();
+      }
+    });
+
+    updateInstallButton();
+  </script>
+
