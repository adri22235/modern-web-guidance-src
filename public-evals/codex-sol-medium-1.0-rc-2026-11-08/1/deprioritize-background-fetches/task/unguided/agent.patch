diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Load data</title>
+  </head>
+  <body>
+    <button type="button" id="load">Load data</button>
+    <pre id="result" role="status" style="white-space: pre-wrap"></pre>
+    <script>
+      const button = document.getElementById('load');
+      const result = document.getElementById('result');
+
+      button.addEventListener('click', () => {
+        button.disabled = true;
+        result.textContent = 'Loading…';
+
+        fetch('/api/data', { priority: 'high' })
+          .then(response => {
+            if (!response.ok) throw new Error('Could not load data.');
+            return response.text();
+          })
+          .then(data => { result.textContent = data; })
+          .catch(() => { result.textContent = 'Could not load data. Try again.'; })
+          .finally(() => { button.disabled = false; });
+
+        fetch('/api/analytics', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ click: 1 }),
+          priority: 'low',
+          keepalive: true
+        }).catch(() => {});
+      });
+    </script>
+  </body>
+</html>
