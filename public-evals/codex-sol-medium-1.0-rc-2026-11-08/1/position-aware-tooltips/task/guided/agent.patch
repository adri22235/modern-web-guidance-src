+  <script>
+    const anchor = document.getElementById('anchor');
+    const tooltip = document.getElementById('latte-tooltip');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativePositioning = nativePopover &&
+      CSS.supports('container-type: anchored') && CSS.supports('position-area: block-start');
+    let open = false;
+
+    // Older browsers use the same viewport-aware placement and arrow geometry.
+    function positionTooltip() {
+      if (!open || nativePositioning) return;
+      const rect = anchor.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const viewportLeft = viewport?.offsetLeft ?? 0;
+      const viewportTop = viewport?.offsetTop ?? 0;
+      const viewportWidth = viewport?.width ?? window.innerWidth;
+      const viewportHeight = viewport?.height ?? window.innerHeight;
+      const edge = 12;
+      tooltip.style.maxWidth = `${Math.max(0, viewportWidth - edge * 2)}px`;
+      const width = tooltip.offsetWidth;
+      const height = tooltip.offsetHeight;
+      const above = rect.top - viewportTop;
+      const below = viewportTop + viewportHeight - rect.bottom;
+      const side = above >= height + edge || above > below ? 'top' : 'bottom';
+      let left = rect.left - 12;
+      if (left + width > viewportLeft + viewportWidth - edge) {
+        left = rect.right + 12 - width;
+      }
+      left = Math.max(viewportLeft + edge,
+        Math.min(left, viewportLeft + viewportWidth - width - edge));
+      const top = side === 'top' ? rect.top - height : rect.bottom;
+      tooltip.style.left = `${left}px`;
+      tooltip.style.top = `${top}px`;
+      tooltip.style.setProperty('--arrow-x',
+        `${Math.max(12, Math.min(width - 12, rect.left + rect.width / 2 - left))}px`);
+      tooltip.dataset.side = side;
+    }
+
+    function closeTooltip() {
+      if (nativePopover) tooltip.hidePopover();
+      else {
+        tooltip.hidden = true;
+        open = false;
+        anchor.setAttribute('aria-expanded', 'false');
+      }
+    }
+
+    if (nativePopover) {
+      tooltip.addEventListener('toggle', (event) => {
+        open = event.newState === 'open';
+        positionTooltip();
+      });
+    } else {
+      tooltip.hidden = true;
+      anchor.setAttribute('aria-expanded', 'false');
+      anchor.addEventListener('click', () => {
+        open = !open;
+        tooltip.hidden = !open;
+        anchor.setAttribute('aria-expanded', String(open));
+        positionTooltip();
+      });
+      document.addEventListener('click', (event) => {
+        if (!anchor.contains(event.target) && !tooltip.contains(event.target)) closeTooltip();
+      });
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') closeTooltip();
+      });
+    }
+
+    document.addEventListener('focusin', (event) => {
+      if (open && !anchor.contains(event.target) && !tooltip.contains(event.target)) closeTooltip();
+    });
+    window.addEventListener('resize', positionTooltip);
+    document.addEventListener('scroll', positionTooltip, { capture: true, passive: true });
+    window.visualViewport?.addEventListener('resize', positionTooltip);
+    window.visualViewport?.addEventListener('scroll', positionTooltip);
+  </script>
