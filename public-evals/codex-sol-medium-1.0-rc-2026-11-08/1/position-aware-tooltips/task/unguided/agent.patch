+  <div id="maple-tooltip" class="info-tooltip" role="tooltip" hidden>
+    <div class="tooltip-content">A cozy blend of espresso, creamy oat milk, and Vermont maple syrup. Enjoy it hot or iced.</div>
+    <span class="tooltip-arrow" aria-hidden="true"></span>
+  </div>
+
+  <script>
+    const anchor = document.getElementById('anchor');
+    const tooltip = document.getElementById('maple-tooltip');
+    const arrow = tooltip.querySelector('.tooltip-arrow');
+    let hideTimer;
+    let pinned = false;
+
+    function positionTooltip() {
+      if (tooltip.hidden) return;
+      const rect = anchor.getBoundingClientRect();
+      const width = document.documentElement.clientWidth;
+      const height = document.documentElement.clientHeight;
+      const padding = 12;
+      const gap = 12;
+      const { width: tw, height: th } = tooltip.getBoundingClientRect();
+      const centerX = rect.left + rect.width / 2;
+      const centerY = rect.top + rect.height / 2;
+      const candidates = [
+        { side: 'top', x: centerX - tw / 2, y: rect.top - th - gap },
+        { side: 'bottom', x: centerX - tw / 2, y: rect.bottom + gap },
+        { side: 'right', x: rect.right + gap, y: centerY - th / 2 },
+        { side: 'left', x: rect.left - tw - gap, y: centerY - th / 2 }
+      ];
+      // Shift along each side first, then flip to the side with least overflow.
+      const clamp = (value, min, max) => Math.max(min, Math.min(value, max));
+      for (const candidate of candidates) {
+        if (candidate.side === 'top' || candidate.side === 'bottom') {
+          candidate.x = clamp(candidate.x, padding, width - tw - padding);
+        } else {
+          candidate.y = clamp(candidate.y, padding, height - th - padding);
+        }
+        candidate.overflow = Math.max(0, padding - candidate.x)
+          + Math.max(0, candidate.x + tw + padding - width)
+          + Math.max(0, padding - candidate.y)
+          + Math.max(0, candidate.y + th + padding - height);
+      }
+      const best = candidates.reduce((a, b) => b.overflow < a.overflow ? b : a);
+      const x = clamp(best.x, padding, width - tw - padding);
+      const y = clamp(best.y, padding, height - th - padding);
+      tooltip.style.left = `${x}px`;
+      tooltip.style.top = `${y}px`;
+      tooltip.dataset.placement = best.side;
+      // Reset the previous axis whenever the tooltip changes orientation.
+      arrow.style.left = '';
+      arrow.style.top = '';
+      if (best.side === 'top' || best.side === 'bottom') {
+        arrow.style.left = `${clamp(centerX - x, 14, tw - 14) - 5}px`;
+      } else {
+        arrow.style.top = `${clamp(centerY - y, 14, th - 14) - 5}px`;
+      }
+    }
+
+    function showTooltip() {
+      clearTimeout(hideTimer);
+      tooltip.hidden = false;
+      positionTooltip();
+    }
+
+    function hideTooltip() {
+      clearTimeout(hideTimer);
+      tooltip.hidden = true;
+      pinned = false;
+    }
+
+    function scheduleHide() {
+      clearTimeout(hideTimer);
+      hideTimer = setTimeout(() => {
+        if (!pinned && document.activeElement !== anchor
+            && !anchor.matches(':hover') && !tooltip.matches(':hover')) hideTooltip();
+      }, 150);
+    }
+
+    anchor.addEventListener('mouseenter', showTooltip);
+    anchor.addEventListener('mouseleave', scheduleHide);
+    anchor.addEventListener('focus', showTooltip);
+    anchor.addEventListener('blur', () => { pinned = false; scheduleHide(); });
+    anchor.addEventListener('click', () => {
+      if (pinned) hideTooltip();
+      else { pinned = true; showTooltip(); }
+    });
+    tooltip.addEventListener('mouseenter', showTooltip);
+    tooltip.addEventListener('mouseleave', scheduleHide);
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') hideTooltip();
+    });
+    document.addEventListener('pointerdown', (event) => {
+      if (!anchor.contains(event.target) && !tooltip.contains(event.target)) hideTooltip();
+    });
+    window.addEventListener('resize', positionTooltip);
+    window.addEventListener('scroll', positionTooltip, true);
+    new ResizeObserver(positionTooltip).observe(tooltip);
+  </script>
+
