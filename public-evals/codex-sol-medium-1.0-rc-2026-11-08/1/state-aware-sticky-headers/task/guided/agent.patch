+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyHeaders = [...document.querySelectorAll('.sticky-container')];
+    const needsStuckFallback = !CSS.supports('container-type: scroll-state');
+    let navigationHeight = navigation.getBoundingClientRect().height;
+    let pendingFrame = false;
+
+    // The document viewport is the scroll root; there is no nested scroller.
+    function updateStuckHeaders() {
+      pendingFrame = false;
+      if (!needsStuckFallback) return;
+
+      const states = stickyHeaders.map(container => {
+        const section = container.parentElement.getBoundingClientRect();
+        return section.top < navigationHeight &&
+          section.bottom > navigationHeight + container.getBoundingClientRect().height;
+      });
+      stickyHeaders.forEach((container, index) => {
+        container.classList.toggle('is-stuck', states[index]);
+      });
+    }
+
+    function scheduleStuckUpdate() {
+      if (pendingFrame) return;
+      pendingFrame = true;
+      requestAnimationFrame(updateStuckHeaders);
+    }
+
+    // Keep section headers below navigation even when it wraps or fonts resize.
+    new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      scheduleStuckUpdate();
+    }).observe(navigation);
+
+    if (needsStuckFallback) {
+      document.addEventListener('scroll', scheduleStuckUpdate, { passive: true });
+      window.addEventListener('resize', scheduleStuckUpdate);
+      window.addEventListener('pageshow', scheduleStuckUpdate);
+      updateStuckHeaders();
+    }
+  </script>
+
