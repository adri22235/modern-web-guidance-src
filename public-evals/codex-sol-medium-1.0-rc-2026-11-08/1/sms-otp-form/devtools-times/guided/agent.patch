+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { handleSignup } from '../src/server/signup.ts';
+
+const origin = 'https://news.example';
+const env = {
+  TWILIO_ACCOUNT_SID: 'ACtest', TWILIO_AUTH_TOKEN: 'test-token',
+  TWILIO_VERIFY_SERVICE_SID: 'VAtest', TWILIO_VERIFY_TEMPLATE_SID: 'HJtest',
+  SIGNUP_COOKIE_SECRET: '[REDACTED]', SIGNUP_ORIGIN: origin,
+};
+const account = { username: 'reader', password: 'password1', phone: '+1 (202) 555-0123' };
+function request(body: object, cookie = '', requestOrigin = origin) {
+  return new Request(`${origin}/devtools-times/api/signup`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json', origin: requestOrigin, cookie },
+    body: JSON.stringify(body),
+  });
+}
+const json = (body: object, status = 200) => new Response(JSON.stringify(body), { status });
+const cookieOf = (response: Response) => response.headers.get('set-cookie')!.split(';')[0];
+const noFetch: typeof fetch = async () => { throw new Error('Unexpected network call'); };
+async function start() {
+  return handleSignup(request({ ...account, action: 'send' }), env, async (_url, options) => {
+    const sent = new URLSearchParams(String(options?.body));
+    assert.equal(sent.get('To'), '+12025550123');
+    assert.equal(sent.get('Channel'), 'sms');
+    assert.equal(sent.get('TemplateSid'), 'HJtest');
+    return json({ status: 'pending' });
+  });
+}
+
+test('send normalizes phone, creates a signed protected cookie and enforces resend delay', async () => {
+  const sent = await start();
+  assert.equal(sent.status, 200);
+  assert.deepEqual(await sent.json(), { phone: '+12025550123', retryAfter: 30 });
+  assert.match(sent.headers.get('set-cookie')!, /HttpOnly; SameSite=Strict; Secure/);
+  assert.equal(sent.headers.get('cache-control'), 'no-store');
+  const repeated = await handleSignup(request({ ...account, action: 'send' }, cookieOf(sent)), env, noFetch);
+  assert.equal(repeated.status, 429);
+});
+
+test('registration checks the SMS code before sending account data upstream, preserving leading zeros', async () => {
+  const sent = await start();
+  const calls: string[] = [];
+  const registered = await handleSignup(request({ ...account, action: 'register', code: '012345' }, cookieOf(sent)), env, async (url, options) => {
+    calls.push(String(url));
+    if (String(url).endsWith('/VerificationCheck')) {
+      assert.equal(new URLSearchParams(String(options?.body)).get('Code'), '012345');
+      return json({ status: 'approved' });
+    }
+    assert.deepEqual(JSON.parse(String(options?.body)), { ...account, phone: '+12025550123' });
+    return json({ success: true });
+  });
+  assert.equal(registered.status, 201);
+  assert.equal(calls.length, 2);
+  assert.match(registered.headers.get('set-cookie')!, /Max-Age=0/);
+});
+
+test('incorrect and expired codes never reach registration', async () => {
+  const sent = await start();
+  for (const [status, body] of [[200, { status: 'pending' }], [404, {}], [429, {}]] as const) {
+    let calls = 0;
+    const result = await handleSignup(request({ ...account, action: 'register', code: '000000' }, cookieOf(sent)), env, async (url) => {
+      assert.match(String(url), /VerificationCheck$/);
+      calls++;
+      return json(body, status);
+    });
+    assert.equal(calls, 1);
+    assert.ok(result.status >= 400);
+  }
+});
+
+test('missing, tampered, expired and mismatched challenges cannot register', async () => {
+  const sent = await start();
+  const cookie = cookieOf(sent);
+  const expiredPayload = Buffer.from(JSON.stringify({ phone: '+12025550123', username: 'reader', expires: 0, verified: true })).toString('base64url');
+  const signature = createHmac('sha256', env.SIGNUP_COOKIE_SECRET).update(expiredPayload).digest('base64url');
+  for (const challenge of ['', `${cookie}x`, `signup_phone=${expiredPayload}.${signature}`]) {
+    assert.equal((await handleSignup(request({ ...account, action: 'register', code: '012345' }, challenge), env, noFetch)).status, 400);
+  }
+  for (const change of [{ phone: '+442079460123' }, { username: 'other' }]) {
+    assert.equal((await handleSignup(request({ ...account, ...change, action: 'register', code: '012345' }, cookie), env, noFetch)).status, 400);
+  }
+});
+
+test('verified registration retries do not attempt to reuse a consumed SMS code', async () => {
+  const sent = await start();
+  let calls = 0;
+  const failed = await handleSignup(request({ ...account, action: 'register', code: '012345' }, cookieOf(sent)), env, async () => {
+    calls++;
+    return calls === 1 ? json({ status: 'approved' }) : json({}, 503);
+  });
+  assert.equal(failed.status, 502);
+  const retried = await handleSignup(request({ ...account, action: 'register', code: '012345' }, cookieOf(failed)), env, async (url) => {
+    assert.match(String(url), /\/api\/register$/);
+    return json({ success: true });
+  });
+  assert.equal(retried.status, 201);
+});
+
+test('invalid input, foreign origins, provider failures and missing configuration fail safely', async () => {
+  assert.equal((await handleSignup(request({ ...account, action: 'send' }), {}, noFetch)).status, 503);
+  assert.equal((await handleSignup(request({ ...account, action: 'send' }, '', 'https://other.example'), env, noFetch)).status, 403);
+  for (const change of [{ phone: '2025550123' }, { password: 'short1' }, { username: ' ' }, { action: 'approve' }]) {
+    assert.equal((await handleSignup(request({ ...account, action: 'send', ...change }), env, noFetch)).status, 400);
+  }
+  const malformed = request({});
+  assert.equal((await handleSignup(new Request(malformed, { body: '{' }), env, noFetch)).status, 400);
+  assert.equal((await handleSignup(request({ ...account, action: 'send' }), env, async () => json({}, 429))).status, 429);
+  assert.equal((await handleSignup(request({ ...account, action: 'send' }), env, async () => { throw Error('secret details'); })).status, 502);
+});
