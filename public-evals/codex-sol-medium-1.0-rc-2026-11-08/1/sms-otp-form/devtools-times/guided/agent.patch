index 0000000..63e4af7
--- /dev/null
+++ b/src/server/signup.ts
@@ -0,0 +1,102 @@
+import { createHmac, timingSafeEqual } from 'node:crypto';
+
+type Environment = Record<string, string | undefined>;
+type Challenge = { phone: string; username: string; expires: number; resendAt: number; verified: boolean };
+const cookieName = 'signup_phone';
+const registrationUrl = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register';
+
+function sign(value: string, secret: string) {
+  return createHmac('sha256', secret).update(value).digest('base64url');
+}
+
+function readChallenge(request: Request, secret: string): Challenge | null {
+  try {
+    const token = request.headers.get('cookie')?.split(/;\s*/).find((cookie) => cookie.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
+    if (!token) return null;
+    const [payload, signature] = token.split('.');
+    const expected = Buffer.from(sign(payload, secret));
+    const supplied = Buffer.from(signature || '');
+    if (expected.length !== supplied.length || !timingSafeEqual(expected, supplied)) return null;
+    const challenge = JSON.parse(Buffer.from(payload, 'base64url').toString()) as Challenge;
+    return challenge.expires > Date.now() ? challenge : null;
+  } catch { return null; }
+}
+
+export async function handleSignup(request: Request, env: Environment = process.env, fetcher: typeof fetch = fetch): Promise<Response> {
+  const headers = new Headers({ 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+  const reply = (status: number, body: object) => new Response(JSON.stringify(body), { status, headers });
+  const { TWILIO_ACCOUNT_SID: account, TWILIO_AUTH_TOKEN: token, TWILIO_VERIFY_SERVICE_SID: service,
+    TWILIO_VERIFY_TEMPLATE_SID: template, SIGNUP_COOKIE_SECRET: secret, SIGNUP_ORIGIN: origin } = env;
+  if (!account || !token || !service || !template || !secret || secret.length < 32 || !origin) {
+    return reply(503, { error: 'Phone verification is temporarily unavailable. Please try again later.' });
+  }
+  // Astro's global origin check is disabled in this app; protect this mutation explicitly.
+  if (request.headers.get('origin') !== origin || new URL(request.url).origin !== origin) return reply(403, { error: 'Please sign up from this website.' });
+  if (!request.headers.get('content-type')?.startsWith('application/json')) return reply(415, { error: 'Please use the sign-up form.' });
+  const cookiePath = new URL(request.url).pathname;
+  const cookieOptions = `Path=${cookiePath}; HttpOnly; SameSite=Strict${origin.startsWith('https://') ? '; Secure' : ''}`;
+  function save(challenge: Challenge) {
+    const payload = Buffer.from(JSON.stringify(challenge)).toString('base64url');
+    headers.set('Set-Cookie', `${cookieName}=${payload}.${sign(payload, secret!)}; Max-Age=600; ${cookieOptions}`);
+  }
+  try {
+    const text = await request.text();
+    if (text.length > 8192) return reply(413, { error: 'The submitted form is too large.' });
+    let body;
+    try { body = JSON.parse(text); } catch { return reply(400, { error: 'Invalid sign-up request.' }); }
+    if (!body || typeof body !== 'object') return reply(400, { error: 'Invalid sign-up request.' });
+    const { action, username, password, code } = body;
+    const phone = typeof body.phone === 'string' ? body.phone.replace(/[\s()-]/g, '') : '';
+    if (!/^\+[1-9][0-9]{7,14}$/.test(phone)) return reply(400, { error: 'Enter a valid phone number with a + and country code.' });
+    if (typeof username !== 'string' || !username.trim() || username.length > 100 || typeof password !== 'string' || password.length < 8 || password.length > 256 || !/[0-9]/.test(password)) {
+      return reply(400, { error: 'Enter a username and a password of at least 8 characters including a number.' });
+    }
+    if (action !== 'send' && action !== 'register') return reply(400, { error: 'Invalid sign-up action.' });
+    const challenge = readChallenge(request, secret);
+    async function verifyApi(resource: string, values: Record<string, string>) {
+      return fetcher(`https://verify.twilio.com/v2/Services/${encodeURIComponent(service!)}/${resource}`, {
+        method: 'POST',
+        headers: { Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`, 'Content-Type': 'application/x-www-form-urlencoded' },
+        body: new URLSearchParams(values), signal: AbortSignal.timeout(15000),
+      });
+    }
+    if (action === 'send') {
+      if (challenge && challenge.resendAt > Date.now()) {
+        const retryAfter = Math.ceil((challenge.resendAt - Date.now()) / 1000);
+        headers.set('Retry-After', String(retryAfter));
+        return reply(429, { error: 'Please wait before requesting another code.', retryAfter });
+      }
+      const sent = await verifyApi('Verifications', { To: phone, Channel: 'sms', TemplateSid: template });
+      if (!sent.ok) {
+        if (sent.status === 429) return reply(429, { error: 'Too many code requests. Please wait before trying again.', retryAfter: 60 });
+        return reply(502, { error: 'We could not send a code. Check your phone number and try again.' });
+      }
+      const data = await sent.json();
+      if (data.status !== 'pending') return reply(502, { error: 'We could not start phone verification. Please try again.' });
+      save({ phone, username, expires: Date.now() + 600000, resendAt: Date.now() + 30000, verified: false });
+      return reply(200, { phone, retryAfter: 30 });
+    }
+    if (!challenge || challenge.phone !== phone || challenge.username !== username) return reply(400, { error: 'Your verification session expired or changed. Request a new code.' });
+    if (!challenge.verified) {
+      if (typeof code !== 'string' || !/^[0-9]{6}$/.test(code)) return reply(400, { error: 'Enter the 6-digit verification code.' });
+      const checked = await verifyApi('VerificationCheck', { To: phone, Code: code });
+      if (checked.status === 429) return reply(429, { error: 'Too many verification attempts. Wait and request a new code.' });
+      if (checked.status === 404) return reply(400, { error: 'This code has expired. Request a new code.' });
+      if (!checked.ok) return reply(502, { error: 'Unable to check your code right now. Please try again.' });
+      const result = await checked.json();
+      if (result.status !== 'approved') return reply(400, { error: 'That code is incorrect or expired. Check it or request a new code.' });
+      // Preserve verified possession for retries when the registration service fails.
+      challenge.verified = true;
+      save(challenge);
+    }
+    const registered = await fetcher(registrationUrl, {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password, phone }), signal: AbortSignal.timeout(15000),
+    });
+    if (!registered.ok) return reply(registered.status === 409 ? 409 : 502, { error: registered.status === 409 ? 'This username is unavailable. Change your account details and try again.' : 'Account creation failed. Your phone is verified; please try submitting again.' });
+    headers.set('Set-Cookie', `${cookieName}=; Max-Age=0; ${cookieOptions}`);
+    return reply(201, { success: true });
+  } catch {
+    return reply(502, { error: 'Unable to connect to the verification or registration service. Please try again.' });
+  }
+}
