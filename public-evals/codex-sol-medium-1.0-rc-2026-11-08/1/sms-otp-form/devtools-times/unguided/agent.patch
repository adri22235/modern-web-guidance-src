+++ b/tests/signup.test.ts
@@ -0,0 +1,113 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { handleSignup } from '../src/server/signup.ts';
+import { normalizePhone, isValidPhone } from '../src/utils/phone.ts';
+
+const originalFetch = globalThis.fetch;
+const originalEnv = { ...process.env };
+afterEach(() => { globalThis.fetch = originalFetch; process.env = { ...originalEnv }; });
+const credentials = () => Object.assign(process.env, {
+  TWILIO_ACCOUNT_SID: 'ACtest', TWILIO_AUTH_TOKEN: 'secret', TWILIO_VERIFY_SERVICE_SID: 'VAtest',
+});
+const details = { action: 'register', username: 'reader', password: 'password1', phoneNumber: '+12025550123', code: '012345' };
+const request = (body: unknown, origin = 'https://example.com') => new Request('https://example.com/devtools-times/api/signup', {
+  method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+});
+
+test('normalizes formatted international numbers and rejects local or invalid numbers', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), '+12025550123');
+  assert.equal(isValidPhone('+12025550123'), true);
+  for (const phone of ['2025550123', '+0123456789', '+1', '+1234567890123456', '+1202abc0123']) assert.equal(isValidPhone(phone), false);
+});
+
+test('rejects cross-origin requests before contacting providers', async () => {
+  globalThis.fetch = async () => { throw new Error('must not fetch'); };
+  assert.equal((await handleSignup(request(details, 'https://other.example'))).status, 403);
+});
+
+test('rejects malformed input and credentials before contacting providers', async () => {
+  globalThis.fetch = async () => { throw new Error('must not fetch'); };
+  for (const body of [null, {}, { ...details, code: '12345' }, { ...details, password: 'short1' }, { ...details, phoneNumber: '2025550123' }, { ...details, username: ' ' }]) {
+    assert.equal((await handleSignup(request(body))).status, 400);
+  }
+});
+
+test('missing SMS configuration fails closed', async () => {
+  delete process.env.TWILIO_AUTH_TOKEN;
+  assert.equal((await handleSignup(request({ ...details, action: 'send' }))).status, 503);
+});
+
+test('sends normalized phone over SMS without passing credentials to the provider', async () => {
+  credentials();
+  globalThis.fetch = async (url, options) => {
+    assert.match(String(url), /\/Verifications$/);
+    const body = options?.body as URLSearchParams;
+    assert.equal(body.get('To'), '+12025550123');
+    assert.equal(body.get('Channel'), 'sms');
+    assert.equal(body.has('password'), false);
+    return Response.json({ status: 'pending' });
+  };
+  const response = await handleSignup(request({ action: 'send', phoneNumber: '+1 (202) 555-0123' }));
+  assert.equal(response.status, 200);
+  assert.deepEqual(await response.json(), { sent: true });
+});
+
+test('incorrect code never triggers registration', async () => {
+  credentials();
+  let calls = 0;
+  globalThis.fetch = async () => { calls++; return Response.json({ status: 'pending' }); };
+  assert.equal((await handleSignup(request(details))).status, 400);
+  assert.equal(calls, 1);
+});
+
+test('expired codes and provider rate limits have actionable errors', async () => {
+  credentials();
+  for (const status of [404, 429]) {
+    globalThis.fetch = async () => Response.json({}, { status });
+    const response = await handleSignup(request(details));
+    assert.equal(response.status, status === 404 ? 400 : 429);
+    assert.match((await response.json()).error, status === 404 ? /expired/ : /Too many attempts/);
+  }
+});
+
+test('only an approved code permits registration and preserves leading zeroes', async () => {
+  credentials();
+  let calls = 0;
+  globalThis.fetch = async (url, options) => {
+    calls++;
+    if (calls === 1) {
+      assert.match(String(url), /\/VerificationCheck$/);
+      assert.equal((options?.body as URLSearchParams).get('Code'), '012345');
+      assert.equal((options?.body as URLSearchParams).get('To'), details.phoneNumber);
+      return Response.json({ status: 'approved' });
+    }
+    assert.match(String(url), /\/api\/register$/);
+    const body = JSON.parse(String(options?.body));
+    assert.equal(body.phoneNumber, details.phoneNumber);
+    assert.equal(body.password, details.password);
+    assert.equal('code' in body, false);
+    return Response.json({ success: true });
+  };
+  const response = await handleSignup(request(details));
+  assert.equal(response.status, 200);
+  assert.equal(response.headers.get('cache-control'), 'no-store');
+  assert.deepEqual(await response.json(), { registered: true });
+  assert.equal(calls, 2);
+});
+
+test('upstream registration failure requires a fresh code instead of reusing a consumed code', async () => {
+  credentials();
+  let calls = 0;
+  globalThis.fetch = async () => ++calls === 1 ? Response.json({ status: 'approved' }) : Response.json({}, { status: 409 });
+  const response = await handleSignup(request(details));
+  assert.equal(response.status, 400);
+  assert.equal((await response.json()).needsNewCode, true);
+});
+
+test('provider network failures never register a user', async () => {
+  credentials();
+  let calls = 0;
+  globalThis.fetch = async () => { calls++; throw new Error('offline'); };
+  assert.equal((await handleSignup(request(details))).status, 502);
+  assert.equal(calls, 1);
+});
