new file mode 100644
index 0000000..9819d8f
--- /dev/null
+++ b/src/server/signup.ts
@@ -0,0 +1,75 @@
+import { normalizePhone, isValidPhone } from '../utils/phone.ts';
+
+export class SignupError extends Error {
+  status: number;
+  constructor(message: string, status = 400) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export async function verifySms(phone: string, code?: string) {
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) {
+    throw new SignupError('SMS verification is temporarily unavailable. Please try again later.', 503);
+  }
+  const response = await fetch(`https://verify.twilio.com/v2/Services/${encodeURIComponent(service)}/${code ? 'VerificationCheck' : 'Verifications'}`, {
+    method: 'POST',
+    headers: {
+      Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`,
+      'Content-Type': 'application/x-www-form-urlencoded',
+    },
+    body: new URLSearchParams(code ? { To: phone, Code: code } : { To: phone, Channel: 'sms' }),
+    signal: AbortSignal.timeout(15000),
+  });
+  if (response.status === 429) throw new SignupError('Too many attempts. Please wait a few minutes before trying again.', 429);
+  if (response.status === 404 && code) throw new SignupError('This code has expired. Please request a new code.');
+  if (!response.ok) throw new SignupError(code ? 'Unable to verify this code. Please try again or request a new one.' : 'Unable to send a text to this number. Check the number and try again.', 400);
+  const data = await response.json();
+  if (code && data.status !== 'approved') throw new SignupError('The code is incorrect or expired. Please try again or request a new code.');
+  if (!code && data.status !== 'pending') throw new SignupError('Unable to send a verification code. Please try again.', 502);
+}
+
+export async function handleSignup(request: Request): Promise<Response> {
+  const json = (body: object, status = 200) => Response.json(body, { status, headers: { 'Cache-Control': 'no-store' } });
+  try {
+    // This endpoint sends paid SMS messages; accept same-origin JSON requests only.
+    if (request.headers.get('origin') !== new URL(request.url).origin || !request.headers.get('content-type')?.startsWith('application/json')) {
+      return json({ error: 'Invalid request.' }, 403);
+    }
+    const body = await request.json();
+    if (!body || typeof body !== 'object') throw new SignupError('Invalid request.');
+    const { action, username, password, code } = body;
+    const phoneNumber = typeof body.phoneNumber === 'string' ? normalizePhone(body.phoneNumber) : '';
+    if (!isValidPhone(phoneNumber)) throw new SignupError('Enter a valid phone number with a country code, such as +1 202 555 0123.');
+    if (action === 'send') {
+      await verifySms(phoneNumber);
+      return json({ sent: true });
+    }
+    if (action !== 'register') throw new SignupError('Invalid request.');
+    if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || password.length < 8 || !/\d/.test(password)) {
+      throw new SignupError('Enter a username and a password with at least 8 characters and a number.');
+    }
+    if (typeof code !== 'string' || !/^\d{6}$/.test(code)) throw new SignupError('Enter the six-digit code from your text message.');
+    await verifySms(phoneNumber, code);
+    // Registration is only attempted after the SMS provider approves the code.
+    try {
+      const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: username.trim(), password, phoneNumber }),
+        signal: AbortSignal.timeout(15000),
+      });
+      if (!response.ok) return json({ error: 'Registration failed. Your username may already be taken. Request a new code before trying again.', needsNewCode: true }, 400);
+    } catch {
+      return json({ error: 'Registration could not be confirmed. Try signing in, or request a new code before trying again.', needsNewCode: true }, 502);
+    }
+    return json({ registered: true });
+  } catch (error) {
+    if (error instanceof SignupError) return json({ error: error.message }, error.status);
+    if (error instanceof SyntaxError) return json({ error: 'Invalid request.' }, 400);
+    return json({ error: 'Unable to reach the verification service. Please try again.' }, 502);
+  }
+}
