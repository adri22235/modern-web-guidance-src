--- /dev/null
+++ b/verification.js
@@ -0,0 +1,219 @@
+'use strict';
+
+const panel = document.querySelector('#sign-in');
+const demo = panel.dataset.demo === 'true';
+const phoneForm = document.querySelector('#phone-form');
+const codeForm = document.querySelector('#code-form');
+const phone = document.querySelector('#phone');
+const code = document.querySelector('#code');
+const status = document.querySelector('#form-status');
+const resend = document.querySelector('#resend');
+const completion = document.querySelector('#completion');
+let otpController;
+let cooldownTimer;
+let otpTimeout;
+let receivedCode;
+let challengeId;
+let verifiedPhone;
+let busy = false;
+let generation = 0;
+
+// Production contract (same-origin HTTPS, secure session cookie, CSRF/origin checks):
+// POST /api/auth/sms/request {phone, intent} => {challengeId}
+// POST /api/auth/sms/verify {challengeId, code, intent} => {verified: true}
+// The server must enforce code expiry, single use, attempt/resend limits and the
+// selected destination. Never trust browser validation or this explicit demo.
+// SMS: "Your Daily Grind code is 123456.\n\n@<actual-hostname> #123456"
+// The origin-bound line must be last, without a scheme, port, path or signature.
+async function post(url, payload) {
+  const response = await fetch(url, {
+    method: 'POST', credentials: 'same-origin',
+    headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
+    body: JSON.stringify(payload)
+  });
+  if (!response.ok) throw new Error('Request failed');
+  return response.json();
+}
+function announce(message = '', error = false) {
+  status.textContent = message;
+  status.classList.toggle('error', error);
+}
+function stopListening() {
+  clearTimeout(otpTimeout);
+  otpController?.abort();
+  otpController = undefined;
+  receivedCode = undefined;
+}
+async function listenForCode() {
+  stopListening();
+  if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+  const controller = new AbortController();
+  otpController = controller;
+  otpTimeout = setTimeout(() => controller.abort(), 120000);
+  try {
+    const credential = await navigator.credentials.get({otp: {transport: ['sms']}, signal: controller.signal});
+    if (!controller.signal.aborted && credential) {
+      receivedCode = credential.code;
+      applyReceivedCode();
+    }
+  } catch {
+    // Denied, timed out or unsupported: keyboard autofill and manual entry remain available.
+  } finally {
+    if (otpController === controller) {
+      clearTimeout(otpTimeout);
+      otpController = undefined;
+    }
+  }
+}
+function applyReceivedCode() {
+  if (!receivedCode || codeForm.hidden || busy) return;
+  code.value = receivedCode;
+  receivedCode = undefined;
+  code.dispatchEvent(new Event('input', {bubbles: true}));
+  codeForm.requestSubmit();
+}
+function setBusy(value) {
+  busy = value;
+  phoneForm.querySelector('[type=submit]').disabled = value;
+  codeForm.querySelector('[type=submit]').disabled = value;
+  resend.disabled = value || Boolean(cooldownTimer);
+  document.querySelector('#change-phone').disabled = value;
+  panel.querySelector('.intent-switch').disabled = value;
+  phoneForm.setAttribute('aria-busy', String(value));
+  codeForm.setAttribute('aria-busy', String(value));
+}
+function cooldown() {
+  clearInterval(cooldownTimer);
+  let remaining = 30;
+  const countdown = document.querySelector('#resend-countdown');
+  resend.disabled = true;
+  countdown.textContent = ` · ${remaining}s`;
+  cooldownTimer = setInterval(() => {
+    remaining -= 1;
+    countdown.textContent = remaining > 0 ? ` · ${remaining}s` : '';
+    if (remaining <= 0) {
+      clearInterval(cooldownTimer);
+      cooldownTimer = undefined;
+      resend.disabled = busy;
+    }
+  }, 1000);
+}
+function intent() { return panel.querySelector('[name=intent]:checked').value; }
+function reset() {
+  generation += 1;
+  stopListening();
+  clearInterval(cooldownTimer);
+  cooldownTimer = undefined;
+  document.querySelector('#resend-countdown').textContent = '';
+  challengeId = undefined;
+  codeForm.reset();
+  code.removeAttribute('aria-invalid');
+  codeForm.hidden = true;
+  completion.hidden = true;
+  phoneForm.hidden = false;
+  document.querySelector('#step-number').textContent = '01';
+  document.querySelector('#step-caption').textContent = "LET'S GET YOU STARTED";
+  document.querySelector('#step-count').textContent = '1 / 2';
+  setBusy(false);
+  announce();
+}
+async function requestCode(isResend = false) {
+  if (busy) return;
+  const currentGeneration = generation;
+  setBusy(true);
+  stopListening();
+  announce(demo ? 'Preparing your preview…' : 'Requesting your code…');
+  // Start receiving before the request to avoid missing an immediately arriving SMS.
+  if (!demo) listenForCode();
+  try {
+    const result = demo ? {challengeId: 'preview'} : await post(phoneForm.action, {phone: verifiedPhone, intent: intent()});
+    if (currentGeneration !== generation) return;
+    if (!result.challengeId) throw new Error('Missing challenge');
+    challengeId = result.challengeId;
+    phoneForm.hidden = true;
+    codeForm.hidden = false;
+    code.value = '';
+    code.removeAttribute('aria-invalid');
+    document.querySelector('#phone-display').textContent = `+1 ••• ••• ${verifiedPhone.slice(-4)}`;
+    document.querySelector('#step-number').textContent = '02';
+    document.querySelector('#step-caption').textContent = 'ONE SMALL STEP TO YOUR NEXT CUP';
+    document.querySelector('#step-count').textContent = '2 / 2';
+    announce(demo ? 'Preview ready. Enter 123456 to try verification.' : isResend ? 'A new code is on its way. Use the most recent code.' : 'Your code is on its way.');
+    cooldown();
+    code.focus();
+  } catch {
+    stopListening();
+    announce('We couldn’t send your code. Please try again in a moment.', true);
+  } finally {
+    if (currentGeneration === generation) {
+      setBusy(false);
+      applyReceivedCode();
+    }
+  }
+}
+phoneForm.addEventListener('submit', event => {
+  event.preventDefault();
+  const digits = phone.value.replace(/\D/g, '');
+  const national = digits.length === 11 && digits.startsWith('1') ? digits.slice(1) : digits;
+  if (national.length !== 10) {
+    phone.setCustomValidity('Enter a 10-digit US mobile number, including the area code.');
+    phone.reportValidity();
+    return;
+  }
+  verifiedPhone = `+1${national}`;
+  requestCode();
+});
+codeForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  stopListening();
+  setBusy(true);
+  announce('Checking your code…');
+  try {
+    const result = demo ? {verified: code.value === '123456'} : await post(codeForm.action, {challengeId, code: code.value, intent: intent()});
+    if (!result.verified) {
+      code.setAttribute('aria-invalid', 'true');
+      announce('That code didn’t match. Check the six digits and try again, or request a new code.', true);
+      code.focus();
+      return;
+    }
+    clearInterval(cooldownTimer);
+    cooldownTimer = undefined;
+    codeForm.hidden = true;
+    completion.hidden = false;
+    document.querySelector('#completion-title').textContent = demo ? 'Looking good. Coffee next?' : 'You’re all set.';
+    document.querySelector('#completion-text').textContent = demo ? `You’ve completed the ${intent() === 'order' ? 'online order' : 'Rewards sign-in'} preview. Live sign-in and texting will be available when the SMS service is connected.` : 'Your number has been verified. Taking you to your next cup…';
+    document.querySelector('#completion-title').focus();
+    announce();
+    if (!demo) window.location.assign(intent() === 'order' ? '/order-online' : '/rewards');
+  } catch {
+    announce('We couldn’t verify your code. Check your connection and try again.', true);
+  } finally {
+    setBusy(false);
+  }
+});
+for (const input of [phone, code]) {
+  input.addEventListener('invalid', () => {
+    input.setAttribute('aria-invalid', 'true');
+    announce(input === code ? 'Enter the complete 6-digit code.' : 'Enter a valid US mobile number, including the area code.', true);
+  });
+  input.addEventListener('input', () => {
+    input.setCustomValidity('');
+    input.removeAttribute('aria-invalid');
+    announce();
+  });
+}
+resend.addEventListener('click', () => { if (!cooldownTimer) requestCode(true); });
+document.querySelector('#change-phone').addEventListener('click', () => { reset(); phone.focus(); });
+document.querySelector('#restart').addEventListener('click', () => { reset(); phone.focus(); });
+panel.querySelectorAll('[name=intent]').forEach(radio => radio.addEventListener('change', reset));
+document.querySelectorAll('[data-intent]').forEach(link => link.addEventListener('click', event => {
+  event.preventDefault();
+  if (busy) return;
+  panel.querySelector(`[value="${link.dataset.intent}"]`).checked = true;
+  reset();
+  panel.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'center'});
+  phone.focus({preventScroll: true});
+}));
+document.querySelector('#demo-note').hidden = !demo;
+window.addEventListener('pagehide', () => { generation += 1; stopListening(); clearInterval(cooldownTimer); });
