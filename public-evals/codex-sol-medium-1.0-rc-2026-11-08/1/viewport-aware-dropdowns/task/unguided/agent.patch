+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const items = [...panel.querySelectorAll('[role="menuitem"]')];
+    let pendingFrame;
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+      const viewport = window.visualViewport;
+      const leftEdge = viewport ? viewport.offsetLeft : 0;
+      const topEdge = viewport ? viewport.offsetTop : 0;
+      const width = viewport ? viewport.width : document.documentElement.clientWidth;
+      const height = viewport ? viewport.height : document.documentElement.clientHeight;
+      const rightEdge = leftEdge + width;
+      const bottomEdge = topEdge + height;
+      const padding = 8;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, width - padding * 2)}px`;
+      panel.style.maxHeight = `${Math.max(0, height - padding * 2)}px`;
+      const naturalHeight = panel.getBoundingClientRect().height;
+      const below = Math.max(0, bottomEdge - padding - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge - padding);
+      const flipUp = naturalHeight > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+
+      const size = panel.getBoundingClientRect();
+      let left = anchor.left;
+      if (left + size.width > rightEdge - padding) left = anchor.right - size.width;
+      left = Math.max(leftEdge + padding, Math.min(left, rightEdge - padding - size.width));
+      const top = flipUp ? anchor.top - size.height : anchor.bottom;
+      panel.style.left = `${left}px`;
+      panel.style.top = `${Math.max(topEdge + padding, Math.min(top, bottomEdge - padding - size.height))}px`;
+    }
+
+    function schedulePosition() {
+      cancelAnimationFrame(pendingFrame);
+      pendingFrame = requestAnimationFrame(positionPanel);
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      const open = event.newState === 'open';
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) schedulePosition();
+    });
+
+    panel.addEventListener('toggle', () => {
+      if (panel.matches(':popover-open')) {
+        positionPanel();
+        items[0].focus({ preventScroll: true });
+      }
+    });
+
+    trigger.addEventListener('keydown', (event) => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        panel.showPopover();
+        positionPanel();
+        // Run after the toggle event's initial focus handling.
+        requestAnimationFrame(() => {
+          items[event.key === 'ArrowUp' ? items.length - 1 : 0].focus();
+        });
+      }
+    });
+
+    panel.addEventListener('keydown', (event) => {
+      const index = items.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowDown') next = (index + 1) % items.length;
+      if (event.key === 'ArrowUp') next = (index - 1 + items.length) % items.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = items.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        items[next].focus();
+      }
+      if (event.key === 'Tab') {
+        panel.hidePopover();
+        trigger.focus();
+      }
+    });
+
+    panel.addEventListener('click', (event) => {
+      const item = event.target.closest('[data-href]');
+      if (!item) return;
+      panel.hidePopover();
+      window.location.assign(item.dataset.href);
+    });
+
+    window.addEventListener('resize', schedulePosition);
+    window.addEventListener('scroll', schedulePosition, true);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const resizeObserver = new ResizeObserver(schedulePosition);
+    resizeObserver.observe(trigger);
+    resizeObserver.observe(panel);
+    resizeObserver.observe(document.querySelector('nav'));
+  </script>
