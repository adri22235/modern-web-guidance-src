+  <div id="action-panel" popover="auto" role="group" aria-label="Options">
+    <button type="button" data-href="/menu/seasonal">Seasonal offers</button>
+    <button type="button" data-href="/account">Account settings</button>
+    <button type="button" data-href="/contact">Support</button>
+  </div>
+
+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const nativePopover = 'popover' in HTMLElement.prototype;
+    const nativeAnchors = nativePopover && CSS.supports('anchor-name: --options-trigger') &&
+      CSS.supports('position-area: block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks: flip-block');
+    let open = false;
+
+    function positionPanel() {
+      if (!open || nativeAnchors) return;
+      const rect = trigger.getBoundingClientRect();
+      const viewport = window.visualViewport;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+      const topEdge = (viewport?.offsetTop ?? 0) + 8;
+      const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+      const bottomEdge = topEdge + (viewport?.height ?? window.innerHeight) - 16;
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+      panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+      const size = panel.getBoundingClientRect();
+      const below = Math.max(0, bottomEdge - rect.bottom);
+      const above = Math.max(0, rect.top - topEdge);
+      const flipUp = size.height > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+      const height = panel.getBoundingClientRect().height;
+      const left = rect.left + size.width > rightEdge ? rect.right - size.width : rect.left;
+      panel.style.left = `${Math.max(leftEdge, Math.min(left, rightEdge - size.width))}px`;
+      panel.style.top = `${Math.max(topEdge, Math.min(flipUp ? rect.top - height : rect.bottom, bottomEdge - height))}px`;
+    }
+
+    function closePanel() {
+      if (nativePopover) panel.hidePopover();
+      else {
+        open = false;
+        panel.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+      }
+    }
+
+    if (!nativeAnchors) panel.dataset.manualPosition = '';
+
+    if (nativePopover) {
+      panel.addEventListener('beforetoggle', (event) => {
+        open = event.newState === 'open';
+        trigger.setAttribute('aria-expanded', String(open));
+        if (open) requestAnimationFrame(positionPanel);
+      });
+    } else {
+      // A body-level fixed overlay avoids ancestor clipping in older browsers.
+      panel.dataset.legacyPopover = '';
+      panel.hidden = true;
+      trigger.addEventListener('click', () => {
+        open = !open;
+        panel.hidden = !open;
+        trigger.setAttribute('aria-expanded', String(open));
+        positionPanel();
+      });
+      document.addEventListener('click', (event) => {
+        if (open && !panel.contains(event.target) && !trigger.contains(event.target)) closePanel();
+      });
+      document.addEventListener('keydown', (event) => {
+        if (open && event.key === 'Escape') {
+          closePanel();
+          trigger.focus();
+        }
+      });
+    }
+
+    if (!nativeAnchors) {
+      window.addEventListener('resize', positionPanel);
+      document.addEventListener('scroll', positionPanel, true);
+      window.visualViewport?.addEventListener('resize', positionPanel);
+      window.visualViewport?.addEventListener('scroll', positionPanel);
+      new ResizeObserver(positionPanel).observe(trigger);
+    }
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      closePanel();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
