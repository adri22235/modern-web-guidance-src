+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('register-status');
+      let registering = false;
+
+      function decodeBase64url(value) {
+        if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+$/.test(value) || value.length % 4 === 1) {
+          throw new Error('Invalid passkey options. Please try again.');
+        }
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        return Uint8Array.from(atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '=')), c => c.charCodeAt(0));
+      }
+
+      function encodeBuffers(value) {
+        if (value instanceof ArrayBuffer || ArrayBuffer.isView(value)) {
+          const bytes = value instanceof ArrayBuffer
+            ? new Uint8Array(value)
+            : new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
+          let binary = '';
+          for (const byte of bytes) binary += String.fromCharCode(byte);
+          return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+        }
+        if (Array.isArray(value)) return value.map(encodeBuffers);
+        if (value && typeof value === 'object') {
+          return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, encodeBuffers(entry)]));
+        }
+        return value;
+      }
+
+      function parseOptions(options) {
+        if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        }
+        const publicKey = {
+          ...options,
+          challenge: decodeBase64url(options.challenge),
+          user: { ...options.user, id: decodeBase64url(options.user.id) },
+        };
+        if (options.excludeCredentials) {
+          publicKey.excludeCredentials = options.excludeCredentials.map(credential => ({
+            ...credential, id: decodeBase64url(credential.id),
+          }));
+        }
+        if (options.extensions) {
+          publicKey.extensions = { ...options.extensions };
+          if (options.extensions.credBlob) {
+            publicKey.extensions.credBlob = decodeBase64url(options.extensions.credBlob);
+          }
+          if (options.extensions.prf?.eval) {
+            const evaluation = options.extensions.prf.eval;
+            publicKey.extensions.prf = {
+              ...options.extensions.prf,
+              eval: {
+                first: decodeBase64url(evaluation.first),
+                ...(evaluation.second !== undefined ? { second: decodeBase64url(evaluation.second) } : {}),
+              },
+            };
+          }
+        }
+        return publicKey;
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') return credential.toJSON();
+        return {
+          id: credential.id,
+          rawId: encodeBuffers(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          response: {
+            clientDataJSON: encodeBuffers(credential.response.clientDataJSON),
+            attestationObject: encodeBuffers(credential.response.attestationObject),
+            transports: credential.response.getTransports?.() ?? [],
+          },
+          clientExtensionResults: encodeBuffers(credential.getClientExtensionResults()),
+        };
+      }
+
+      async function postJSON(url, body) {
+        const response = await fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          redirect: 'error',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body),
+        });
+        if (!response.ok) throw new Error('Passkey registration failed. Please try again.');
+        return response.json();
+      }
+
+      button.addEventListener('click', async () => {
+        if (registering) return;
+        registering = true;
+        button.disabled = true;
+        status.textContent = 'Preparing your passkey…';
+        try {
+          if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.create) {
+            throw new Error('Passkeys require a supported browser and a secure connection.');
+          }
+          const options = await postJSON('/api/register/options', { promotion: true });
+          const publicKey = parseOptions(options.publicKey ?? options);
+          status.textContent = 'Follow your device’s instructions to create a passkey.';
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential || credential.type !== 'public-key') {
+            throw new Error('No passkey was created. Please try again.');
+          }
+          status.textContent = 'Verifying your passkey…';
+          const result = await postJSON('/api/register/verify', serializeCredential(credential));
+          if (result.verified !== true) {
+            throw new Error('Your passkey could not be verified. Please try again.');
+          }
+          status.textContent = 'Passkey created successfully.';
+        } catch (error) {
+          if (error.name === 'NotAllowedError' || error.name === 'AbortError') {
+            status.textContent = 'Passkey creation was canceled or timed out. Please try again.';
+          } else if (error.name === 'InvalidStateError') {
+            status.textContent = 'A passkey for this account already exists on this device.';
+          } else {
+            status.textContent = 'Passkey registration failed. Please try again using a supported browser and a secure connection.';
+          }
+        } finally {
+          registering = false;
+          button.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
