+  <script type="module">
+    // Pinned, same-origin JSON compatibility helpers; native methods take precedence.
+    import './vendor/webauthn-polyfills-0.1.7/json_serialization.js';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const registerStatus = document.querySelector('#register-status');
+    let registrationInProgress = false;
+    let registrationComplete = false;
+    let passkeysSupported = false;
+
+    async function checkPasskeySupport() {
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential ||
+            !navigator.credentials?.create ||
+            typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+          return;
+        }
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        passkeysSupported = Boolean(
+          capabilities.conditionalGet && capabilities.passkeyPlatformAuthenticator
+        );
+      } catch {
+        passkeysSupported = false;
+      } finally {
+        registerButton.disabled = !passkeysSupported;
+        registerStatus.textContent = passkeysSupported
+          ? 'Create a passkey for your account on this device.'
+          : 'Passkey creation is unavailable in this browser or on this connection. You can continue using your usual sign-in method.';
+      }
+    }
+
+    async function postJSON(url, body) {
+      const response = await fetch(url, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        credentials: 'same-origin',
+        mode: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        body: JSON.stringify(body),
+      });
+      if (!response.ok) {
+        throw new Error('The passkey request failed. Please try again.');
+      }
+      return response;
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (!passkeysSupported || registrationInProgress || registrationComplete) return;
+      registrationInProgress = true;
+      registerButton.disabled = true;
+      registerButton.setAttribute('aria-busy', 'true');
+      registerStatus.textContent = 'Follow your device’s instructions to create a passkey…';
+
+      try {
+        const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(
+          await optionsResponse.json()
+        );
+        // The RP ID must come from the server, including for parent/related origins.
+        if (!publicKey.rp?.id) {
+          throw new Error('Passkey setup is unavailable. Please contact support.');
+        }
+
+        const credential = await navigator.credentials.create({ publicKey });
+        if (!credential) {
+          registerStatus.textContent = 'Passkey creation was cancelled. You can try again.';
+          return;
+        }
+        const encodedResponse = credential.toJSON();
+        registerStatus.textContent = 'Verifying your passkey…';
+
+        // Only verification failures should signal an orphaned credential.
+        try {
+          await postJSON('/api/register/verify', encodedResponse);
+        } catch (verificationError) {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rp.id,
+                credentialId: encodedResponse.id,
+              });
+            } catch {
+              // Synchronization is best effort; preserve the verification error.
+            }
+          }
+          throw verificationError;
+        }
+
+        registrationComplete = true;
+        registerButton.textContent = 'Passkey created';
+        registerStatus.textContent = 'Your passkey is ready to use the next time you sign in.';
+      } catch (error) {
+        const messages = {
+          InvalidStateError: 'A passkey already exists for this account on this device.',
+          NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+          AbortError: 'Passkey creation was interrupted. You can try again.',
+          SecurityError: 'Passkey setup requires a secure connection and a valid site configuration.',
+        };
+        registerStatus.textContent = messages[error.name]
+          || 'We could not register your passkey. Please try again.';
+      } finally {
+        registrationInProgress = false;
+        registerButton.disabled = !passkeysSupported || registrationComplete;
+        registerButton.removeAttribute('aria-busy');
+      }
+    });
+
+    checkPasskeySupport();
+  </script>
