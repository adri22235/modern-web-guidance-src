+class FavoriteToggle extends HTMLElement {
+  static observedAttributes = ['favorite', 'drink-name'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.innerHTML = `
+      <style>
+        :host { display: block; margin-top: 15px; }
+        button {
+          display: inline-flex;
+          align-items: center;
+          gap: 8px;
+          min-height: 44px;
+          padding: 8px 16px;
+          border: 1px solid var(--secondary, #d7ccc8);
+          border-radius: 999px;
+          background: white;
+          color: var(--primary, #4e342e);
+          font: inherit;
+          cursor: pointer;
+        }
+        button:hover { background: #f5efeb; }
+        button[aria-pressed="true"] {
+          background: #fff0db;
+          border-color: var(--primary, #4e342e);
+        }
+        button:focus-visible {
+          outline: 3px solid var(--primary, #4e342e);
+          outline-offset: 3px;
+        }
+        .heart { font-size: 1.3em; line-height: 1; }
+      </style>
+      <button type="button" aria-pressed="false">
+        <span class="heart" aria-hidden="true">♡</span>
+        <span class="label">Favorite</span>
+      </button>
+    `;
+    this.button = root.querySelector('button');
+    this.button.addEventListener('click', () => {
+      this.toggleAttribute('favorite');
+      if (this.storageKey) {
+        try {
+          localStorage.setItem(this.storageKey, String(this.hasAttribute('favorite')));
+        } catch {
+          // The toggle still works when browser storage is unavailable.
+        }
+      }
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          drinkId: this.getAttribute('drink-id'),
+          favorite: this.hasAttribute('favorite'),
+        },
+      }));
+    });
+  }
+
+  get storageKey() {
+    const drinkId = this.getAttribute('drink-id');
+    return drinkId ? `daily-grind:favorite:${drinkId}` : null;
+  }
+
+  connectedCallback() {
+    if (this.storageKey) {
+      try {
+        const saved = localStorage.getItem(this.storageKey);
+        if (saved !== null) this.toggleAttribute('favorite', saved === 'true');
+      } catch {
+        // Browser storage is optional.
+      }
+    }
+    this.render();
+  }
+
+  attributeChangedCallback() {
+    this.render();
+  }
+
+  render() {
+    const favorite = this.hasAttribute('favorite');
+    const name = this.getAttribute('drink-name') || 'drink';
+    this.button.setAttribute('aria-pressed', String(favorite));
+    this.button.setAttribute('aria-label', `Favorite ${name}`);
+    this.button.querySelector('.heart').textContent = favorite ? '♥' : '♡';
+    this.button.querySelector('.label').textContent = favorite ? 'Favorited' : 'Favorite';
+  }
+}
+
+customElements.define('favorite-toggle', FavoriteToggle);
