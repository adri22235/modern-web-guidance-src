diff --git a/equipment-network.mjs b/equipment-network.mjs
new file mode 100644
index 0000000..859fc0b
--- /dev/null
+++ b/equipment-network.mjs
@@ -0,0 +1,44 @@
+// No discovery or background requests: callers invoke this only after Connect.
+export function validateEndpoint(value, space) {
+  let url;
+  try { url = new URL(value); } catch { throw new Error('Enter a complete http:// or https:// status URL.'); }
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const octets = host.split('.').map(Number);
+  const ipv4 = /^\d+\.\d+\.\d+\.\d+$/.test(host) && octets.every(n => n >= 0 && n <= 255);
+  const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (ipv4 && octets[0] === 127);
+  const privateHost = (ipv4 && (octets[0] === 10 ||
+    (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+    (octets[0] === 192 && octets[1] === 168) || (octets[0] === 169 && octets[1] === 254))) ||
+    host.endsWith('.local') || /^\[f[cd][0-9a-f]{2}:/.test(host) || /^\[fe[89ab][0-9a-f]:/.test(host);
+  if (space === 'loopback' ? !loopback : !privateHost) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address such as http://127.0.0.1:45678/health on this computer.'
+      : 'Use a private LAN address such as http://192.168.1.100/api/status or a .local hostname.');
+  }
+  return url.href;
+}
+
+export async function checkEndpoint(url, space, signal) {
+  const response = await fetch(url, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: space,
+    credentials: 'omit',
+    cache: 'no-store',
+    redirect: 'error',
+    referrerPolicy: 'no-referrer',
+    signal,
+  });
+  if (!response.ok) throw new Error(`Equipment returned HTTP ${response.status}. Check the status URL and equipment settings.`);
+  let data;
+  try { data = await response.json(); } catch { throw new Error('The endpoint did not return JSON. Use the equipment’s status or health URL.'); }
+  if (!data || typeof data !== 'object' || Array.isArray(data)) {
+    throw new Error('Expected a JSON status object. Check the equipment’s status or health URL.');
+  }
+  if (data.ok === false || data.healthy === false || ['error', 'offline', 'unhealthy'].includes(data.status)) {
+    throw new Error('The equipment reports that it is not ready. Check the brewer or desktop helper, then retry.');
+  }
+}
diff --git a/equipment.mjs b/equipment.mjs
new file mode 100644
index 0000000..7749b8e
--- /dev/null
+++ b/equipment.mjs
@@ -0,0 +1,110 @@
+import { validateEndpoint, checkEndpoint } from './equipment-network.mjs';
+
+for (const form of document.querySelectorAll('.connection-card')) {
+  const space = form.dataset.space;
+  const permissionName = space === 'local' ? 'local-network' : 'loopback-network';
+  const permissionLabel = space === 'local' ? 'Local network' : 'Loopback network';
+  const input = form.elements.endpoint;
+  const connect = form.querySelector('.connect-button');
+  const disconnect = form.querySelector('.disconnect-button');
+  const badge = form.querySelector('.connection-badge');
+  const message = form.querySelector('.connection-message');
+  const initialMessage = message.textContent;
+  const initialButton = connect.textContent;
+  let permission;
+  let activeRequest;
+
+  function render(state, text) {
+    form.dataset.state = state;
+    badge.textContent = { idle: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection issue' }[state];
+    message.textContent = text;
+    form.setAttribute('aria-busy', String(state === 'connecting'));
+    connect.disabled = state === 'connecting';
+    connect.textContent = state === 'connecting' ? 'Connecting…' : state === 'connected' ? 'Check connection' : initialButton;
+    disconnect.hidden = !['connecting', 'connected'].includes(state);
+    disconnect.textContent = state === 'connecting' ? 'Cancel' : 'Disconnect';
+  }
+
+  function reset() {
+    activeRequest?.abort();
+    activeRequest = undefined;
+    render('idle', initialMessage);
+  }
+
+  async function queryPermission() {
+    if (permission) return permission.state;
+    try {
+      permission = await navigator.permissions.query({ name: permissionName });
+      permission.addEventListener('change', () => {
+        if (permission.state === 'denied') {
+          activeRequest?.abort();
+          activeRequest = undefined;
+          render('error', `${permissionLabel} access is blocked. Allow it in your browser’s site settings, then connect again.`);
+        } else if (form.dataset.state !== 'connecting') reset();
+      });
+      return permission.state;
+    } catch {
+      // Unsupported permission names still permit a user-initiated attempt.
+      return 'prompt';
+    }
+  }
+
+  input.addEventListener('input', () => {
+    input.setCustomValidity('');
+    input.removeAttribute('aria-invalid');
+    reset();
+  });
+  input.addEventListener('invalid', () => input.setAttribute('aria-invalid', 'true'));
+  disconnect.addEventListener('click', reset);
+  form.addEventListener('submit', async event => {
+    event.preventDefault();
+    if (activeRequest) return;
+    let endpoint;
+    try { endpoint = validateEndpoint(input.value.trim(), space); }
+    catch (error) {
+      input.setCustomValidity(error.message);
+      input.setAttribute('aria-invalid', 'true');
+      render('error', error.message);
+      input.reportValidity();
+      input.focus();
+      return;
+    }
+    if (!window.isSecureContext) {
+      render('error', 'Open this page over HTTPS to connect to local equipment.');
+      return;
+    }
+    const controller = new AbortController();
+    activeRequest = controller;
+    let timedOut = false;
+    let timeout;
+    render('connecting', `Allow ${permissionLabel.toLowerCase()} access if your browser asks.`);
+    try {
+      const state = await queryPermission();
+      if (activeRequest !== controller) return;
+      if (state === 'denied') {
+        throw new Error(`${permissionLabel} access is blocked. Allow it in your browser’s site settings, then connect again.`);
+      }
+      timeout = setTimeout(() => { timedOut = true; controller.abort(); }, 20000);
+      await checkEndpoint(endpoint, space, controller.signal);
+      if (activeRequest !== controller) return;
+      render('connected', `Status check succeeded at ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}. Check again to refresh.`);
+    } catch (error) {
+      if (activeRequest !== controller) return;
+      const advice = space === 'local' ? 'Check the brewer’s power and Wi-Fi connection.' : 'Open the desktop helper on this computer and check its port.';
+      render('error', timedOut ? `Connection timed out. ${advice} Then try again.`
+        : error instanceof TypeError ? `Could not reach the endpoint. ${advice} Check browser site permissions and the equipment’s CORS settings. If blocked, try a current Chrome or Edge browser.`
+        : error.message);
+    } finally {
+      clearTimeout(timeout);
+      if (activeRequest === controller) activeRequest = undefined;
+    }
+  });
+  connect.disabled = false;
+  // Permission inspection never sends a request to equipment or prompts the user.
+  queryPermission().then(state => {
+    if (state === 'denied' && form.dataset.state === 'idle') {
+      render('error', `${permissionLabel} access is blocked. Allow it in your browser’s site settings, then connect again.`);
+    }
+  });
+  window.addEventListener('pagehide', reset);
+}
