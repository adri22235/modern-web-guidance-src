diff --git a/tests/equipment.test.cjs b/tests/equipment.test.cjs
new file mode 100644
index 0000000..f956a92
--- /dev/null
+++ b/tests/equipment.test.cjs
@@ -0,0 +1,136 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+const source = readFileSync(require('node:path').join(__dirname, '../equipment.js'), 'utf8');
+
+function setup(fetch, secure = true) {
+  function panel(device, value) {
+    const handlers = {};
+    const input = { value, focus() {} };
+    const nodes = Object.fromEntries(['[type="submit"]', '[data-disconnect]', '.connection-status', '.connection-message']
+      .map(key => [key, { dataset: {}, addEventListener(type, fn) { handlers[type] = fn; } }]));
+    return { dataset: { device }, elements: { endpoint: input }, nodes,
+      querySelector: key => nodes[key], setAttribute() {},
+      addEventListener(type, fn) { handlers[type] = fn; },
+      submit: () => handlers.submit({ preventDefault() {} }),
+      disconnect: () => handlers.click(),
+      state: () => nodes['.connection-status'].dataset.state,
+      message: () => nodes['.connection-message'].textContent,
+    };
+  }
+  const brewer = panel('brewer', 'http://192.168.1.100/api/status');
+  const helper = panel('helper', 'http://127.0.0.1:8000/api/status');
+  const timers = new Set();
+  runInNewContext(source, {
+    document: { querySelectorAll: () => [brewer, helper] }, window: { isSecureContext: secure },
+    fetch, URL, AbortController, TypeError, Date,
+    setTimeout(fn) { timers.add(fn); return fn; }, clearTimeout(fn) { timers.delete(fn); },
+  });
+  return { brewer, helper, timers };
+}
+
+test('both devices connect directly with readable CORS responses and no credentials', async () => {
+  const calls = [];
+  const { brewer, helper, timers } = setup(async (url, options) => {
+    calls.push({ url, options });
+    return { ok: true, json: async () => ({ status: 'ready', name: 'Counter brewer' }) };
+  });
+  assert.equal(calls.length, 0, 'no automatic local network requests');
+  await Promise.all([brewer.submit(), helper.submit()]);
+  assert.equal(brewer.state(), 'connected');
+  assert.equal(helper.state(), 'connected');
+  assert.match(brewer.message(), /Counter brewer: ready/);
+  assert.equal(calls[0].url, 'http://192.168.1.100/api/status');
+  assert.equal(calls[1].url, 'http://127.0.0.1:8000/api/status');
+  for (const { options } of calls) {
+    assert.equal(options.mode, 'cors');
+    assert.equal(options.credentials, 'omit');
+    assert.equal(options.redirect, 'error');
+  }
+  await brewer.submit();
+  assert.equal(calls.length, 3, 'check again makes a fresh request');
+  brewer.disconnect();
+  assert.equal(brewer.state(), 'disconnected');
+  assert.equal(helper.state(), 'connected');
+  assert.equal(timers.size, 0);
+});
+
+test('rejects public addresses, misleading loopback hosts, and credentialed URLs', async () => {
+  let calls = 0;
+  const { brewer, helper } = setup(() => { calls++; });
+  for (const value of ['http://example.com/status', 'http://127.0.0.1/status', 'http://user:pass@192.168.1.1/status', 'ftp://192.168.1.1/status']) {
+    brewer.elements.endpoint.value = value;
+    await brewer.submit();
+    assert.equal(brewer.state(), 'error');
+  }
+  for (const value of ['http://127.evil.example/status', 'http://192.168.1.1/status', 'https://example.com/status']) {
+    helper.elements.endpoint.value = value;
+    await helper.submit();
+    assert.equal(helper.state(), 'error');
+  }
+  assert.equal(calls, 0);
+});
+
+test('supports private ranges and loopback alternatives', async () => {
+  const { brewer, helper } = setup(async () => ({ ok: true, json: async () => ({ status: 'idle' }) }));
+  for (const value of ['http://10.0.0.2/status', 'https://172.16.0.2:8443/status', 'http://172.31.255.254/status']) {
+    brewer.elements.endpoint.value = value;
+    await brewer.submit();
+    assert.equal(brewer.state(), 'connected');
+  }
+  for (const value of ['http://localhost:8000/status', 'http://[::1]:8000/status']) {
+    helper.elements.endpoint.value = value;
+    await helper.submit();
+    assert.equal(helper.state(), 'connected');
+  }
+});
+
+test('HTTP, malformed responses, and network failures never claim connection', async () => {
+  for (const response of [
+    { ok: false, status: 404 },
+    { ok: true, json: async () => { throw new SyntaxError(); } },
+    { ok: true, json: async () => ({ unrelated: true }) },
+    { ok: true, json: async () => ({ status: ' ' }) },
+  ]) {
+    const { brewer } = setup(async () => response);
+    await brewer.submit();
+    assert.equal(brewer.state(), 'error');
+    assert.equal(brewer.elements.endpoint.disabled, false);
+  }
+  const { helper } = setup(async () => { throw new TypeError('Failed to fetch'); });
+  await helper.submit();
+  assert.match(helper.message(), /CORS/);
+  assert.equal(helper.state(), 'error');
+});
+
+test('cancelled responses cannot overwrite a new connection', async () => {
+  const pending = [];
+  const { brewer } = setup((url, options) => new Promise(resolve => pending.push({ resolve, options })));
+  const first = brewer.submit();
+  await brewer.submit();
+  assert.equal(pending.length, 1, 'duplicate submissions are ignored');
+  brewer.disconnect();
+  assert.equal(pending[0].options.signal.aborted, true);
+  const second = brewer.submit();
+  pending[1].resolve({ ok: true, json: async () => ({ status: 'new' }) });
+  await second;
+  pending[0].resolve({ ok: true, json: async () => ({ status: 'stale' }) });
+  await first;
+  assert.match(brewer.message(), /new/);
+  assert.doesNotMatch(brewer.message(), /stale/);
+});
+
+test('timeouts and insecure pages show actionable errors', async () => {
+  const { brewer, timers } = setup((url, options) => new Promise((resolve, reject) => {
+    options.signal.addEventListener('abort', () => reject(new Error('Aborted')));
+  }));
+  const pending = brewer.submit();
+  for (const timeout of timers) timeout();
+  await pending;
+  assert.equal(brewer.state(), 'error');
+  assert.match(brewer.message(), /20 seconds/);
+  const insecure = setup(() => assert.fail('must not fetch'), false);
+  await insecure.helper.submit();
+  assert.match(insecure.helper.message(), /HTTPS or localhost/);
+});
