@@ -0,0 +1,101 @@
+/* Status checks stay in the visitor's browser: never proxy LAN/loopback requests. */
+(() => {
+  'use strict';
+
+  function validateEndpoint(value, device) {
+    let url;
+    try { url = new URL(value); } catch { throw new Error('Enter a complete HTTP or HTTPS status URL.'); }
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+      throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+    }
+    const host = url.hostname;
+    const parts = host.split('.').map(Number);
+    const ipv4 = parts.length === 4 && parts.every(part => Number.isInteger(part) && part >= 0 && part <= 255);
+    const loopback = ['localhost', '[::1]'].includes(host) || (ipv4 && parts[0] === 127);
+    const privateIP = ipv4 && (parts[0] === 10 || (parts[0] === 192 && parts[1] === 168) ||
+      (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31));
+    if (device === 'helper' ? !loopback : !privateIP) {
+      throw new Error(device === 'helper'
+        ? 'Use a loopback address: 127.0.0.1, localhost, or [::1].'
+        : 'Use the brewer’s private IPv4 address (192.168.x.x, 10.x.x.x, or 172.16–31.x.x).');
+    }
+    return url;
+  }
+
+  document.querySelectorAll('[data-device]').forEach(form => {
+    const device = form.dataset.device;
+    const input = form.elements.endpoint;
+    const connect = form.querySelector('[type="submit"]');
+    const disconnect = form.querySelector('[data-disconnect]');
+    const badge = form.querySelector('.connection-status');
+    const message = form.querySelector('.connection-message');
+    let active = null;
+
+    function render(state, detail) {
+      badge.dataset.state = state;
+      badge.textContent = { disconnected: 'Not connected', connecting: 'Connecting…', connected: 'Connected', error: 'Connection failed' }[state];
+      message.textContent = detail;
+      input.disabled = state === 'connecting' || state === 'connected';
+      connect.disabled = state === 'connecting';
+      connect.textContent = state === 'connected' ? 'Check again' : `Connect ${device}`;
+      disconnect.disabled = !['connecting', 'connected'].includes(state);
+      disconnect.textContent = state === 'connecting' ? 'Cancel' : 'Disconnect';
+      form.setAttribute('aria-busy', String(state === 'connecting'));
+    }
+
+    disconnect.addEventListener('click', () => {
+      const previous = active;
+      active = null;
+      previous?.abort();
+      render('disconnected', 'Disconnected. Connect again whenever you’re ready.');
+      input.focus();
+    });
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (active) return;
+      let endpoint;
+      try {
+        endpoint = validateEndpoint(input.value.trim(), device);
+      } catch (error) {
+        render('error', error.message);
+        input.focus();
+        return;
+      }
+      if (!window.isSecureContext) {
+        render('error', 'Open this page over HTTPS or localhost before connecting to local equipment.');
+        return;
+      }
+      const controller = new AbortController();
+      active = controller;
+      let timedOut = false;
+      render('connecting', 'Checking equipment. Allow network access if your browser asks.');
+      const timeout = setTimeout(() => { timedOut = true; controller.abort(); }, 20000);
+      try {
+        const response = await fetch(endpoint.href, {
+          method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+          redirect: 'error', signal: controller.signal,
+        });
+        if (!response.ok) throw new Error(`Equipment returned HTTP ${response.status}. Check the status URL and device configuration.`);
+        let data;
+        try { data = await response.json(); } catch { throw new Error('The endpoint did not return JSON. Check the status URL.'); }
+        if (!data || Array.isArray(data) || typeof data.status !== 'string' || !data.status.trim()) {
+          throw new Error('Expected a JSON object with a nonempty status string. Check the endpoint’s API format.');
+        }
+        if (active !== controller) return;
+        const name = typeof data.name === 'string' && data.name.trim() ? data.name.slice(0, 80) : (device === 'brewer' ? 'Brewer' : 'Desktop helper');
+        render('connected', `${name}: ${data.status.slice(0, 120)}. Last checked ${new Date().toLocaleTimeString()}.`);
+      } catch (error) {
+        if (active !== controller) return;
+        render('error', timedOut
+          ? 'No response within 20 seconds. Check the device, network, and browser permissions, then try again.'
+          : error instanceof TypeError
+            ? 'Could not reach equipment. Check the address, Wi-Fi or running helper, browser network permissions, CORS, and HTTPS support. See troubleshooting below.'
+            : error.message);
+      } finally {
+        clearTimeout(timeout);
+        if (active === controller) active = null;
+      }
+    });
+  });
+})();
