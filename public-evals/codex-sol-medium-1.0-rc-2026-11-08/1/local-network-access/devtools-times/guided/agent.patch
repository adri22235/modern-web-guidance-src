diff --git a/tests/diagnostics.test.mjs b/tests/diagnostics.test.mjs
new file mode 100644
index 0000000..2152dd2
--- /dev/null
+++ b/tests/diagnostics.test.mjs
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { diagnosticEndpoint, diagnosticRequestOptions } from '../src/lib/diagnostics.ts';
+
+test('LAN endpoints stay in private IPv4 and mDNS address spaces', () => {
+  for (const host of ['192.168.1.100', '10.0.0.1', '172.16.0.1', '172.31.255.254', '169.254.1.1', 'bench.local']) {
+    assert.equal(diagnosticEndpoint(`http://${host}:8080/api/status`, 'local').hostname, host);
+  }
+  for (const host of ['127.0.0.1', 'localhost', '[::1]', '172.15.0.1', '172.32.0.1', '192.169.1.1', '8.8.8.8', 'example.com']) {
+    assert.throws(() => diagnosticEndpoint(`http://${host}/status`, 'local'));
+  }
+});
+
+test('CLI endpoints stay on the reader’s own machine', () => {
+  for (const host of ['127.0.0.1', '127.1.2.3', 'localhost', 'cli.localhost', '[::1]']) {
+    assert.equal(diagnosticEndpoint(`http://${host}:45678/health`, 'loopback').hostname, host);
+  }
+  for (const host of ['192.168.1.100', 'bench.local', 'example.com']) {
+    assert.throws(() => diagnosticEndpoint(`http://${host}/health`, 'loopback'));
+  }
+});
+
+test('rejects unsupported schemes, credentials, fragments and malformed URLs', () => {
+  for (const value of ['not a URL', 'ftp://127.0.0.1/health', 'http://user:secret@127.0.0.1/health', 'http://127.0.0.1/health#part']) {
+    assert.throws(() => diagnosticEndpoint(value, 'loopback'));
+  }
+});
+
+test('requests declare distinct address spaces and omit credentials and redirects', () => {
+  const signal = new AbortController().signal;
+  for (const space of ['local', 'loopback']) {
+    assert.deepEqual(diagnosticRequestOptions(space, signal), {
+      method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+      redirect: 'error', referrerPolicy: 'no-referrer', targetAddressSpace: space, signal,
+    });
+  }
+});
