+++ b/src/components/DiagnosticsWidget.tsx
@@ -0,0 +1,150 @@
+import { useEffect, useId, useRef, useState, type FormEvent } from 'react';
+import { diagnosticEndpoint, diagnosticRequestOptions, type AddressSpace } from '../lib/diagnostics';
+
+function ConnectionPanel({ space }: { space: AddressSpace }) {
+  const isDevice = space === 'local';
+  const title = isDevice ? 'Hardware test device' : 'Companion CLI';
+  const permissionName = isDevice ? 'local-network' : 'loopback-network';
+  const id = useId();
+  const [endpoint, setEndpoint] = useState(isDevice ? 'http://192.168.1.100:8080/api/status' : 'http://127.0.0.1:45678/health');
+  const [permission, setPermission] = useState<PermissionState | 'unknown'>('unknown');
+  const [ready, setReady] = useState(false);
+  const [secure, setSecure] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [invalid, setInvalid] = useState(false);
+  const [message, setMessage] = useState('Not connected.');
+  const [result, setResult] = useState('');
+  const controller = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    let disposed = false;
+    let status: PermissionStatus | undefined;
+    const update = () => { if (!disposed && status) setPermission(status.state); };
+    setSecure(window.isSecureContext);
+    setReady(true);
+    async function observePermission() {
+      try {
+        status = await navigator.permissions.query({ name: permissionName as PermissionName });
+        if (disposed) return;
+        update();
+        status.addEventListener('change', update);
+      } catch {
+        // Unsupported granular permissions still allow a user-initiated attempt.
+      }
+    }
+    void observePermission();
+    return () => {
+      disposed = true;
+      status?.removeEventListener('change', update);
+      const activeRequest = controller.current;
+      controller.current = null;
+      activeRequest?.abort();
+    };
+  }, [permissionName]);
+
+  async function connect(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (busy) return;
+    const input = event.currentTarget.elements.namedItem('endpoint') as HTMLInputElement;
+    let url: URL;
+    try {
+      url = diagnosticEndpoint(endpoint, space);
+    } catch (error) {
+      setInvalid(true);
+      setMessage(error instanceof Error ? error.message : 'Enter a valid endpoint URL.');
+      setResult('');
+      input.focus();
+      return;
+    }
+    if (!window.isSecureContext || permission === 'denied') return;
+    const requestController = new AbortController();
+    controller.current = requestController;
+    setBusy(true);
+    setInvalid(false);
+    setResult('');
+    setMessage('Connecting… Allow the browser permission prompt if shown.');
+    const timeout = window.setTimeout(() => requestController.abort('timeout'), 10000);
+    try {
+      const start = performance.now();
+      const response = await fetch(url, diagnosticRequestOptions(space, requestController.signal));
+      if (!response.ok) throw new Error(`Endpoint returned HTTP ${response.status}. Check the URL and service logs.`);
+      // Limit the preview without buffering an unbounded device response.
+      const reader = response.body?.getReader();
+      const decoder = new TextDecoder();
+      let preview = '';
+      if (reader) {
+        try {
+          while (preview.length <= 4096) {
+            const { done, value } = await reader.read();
+            if (done) break;
+            preview += decoder.decode(value, { stream: true });
+          }
+          preview += decoder.decode();
+        } finally {
+          await reader.cancel();
+        }
+      }
+      if (controller.current !== requestController) return;
+      setResult(preview.length > 4096 ? `${preview.slice(0, 4096)}\n…preview truncated` : preview || '(Empty response body)');
+      setMessage(`Connected · HTTP ${response.status} · ${Math.round(performance.now() - start)} ms. Status checked at ${new Date().toLocaleTimeString()}.`);
+    } catch (error) {
+      if (controller.current !== requestController) return;
+      setMessage(requestController.signal.aborted
+        ? 'Connection timed out after 10 seconds. Check the endpoint and try again.'
+        : error instanceof TypeError
+          ? `Could not connect. ${isDevice ? 'Check device power and the same Wi-Fi network.' : 'Start the companion CLI and check its port.'} Check browser site permissions, endpoint CORS, and browser support for local connections.`
+          : error instanceof Error ? error.message : 'Connection failed. Check the endpoint and try again.');
+    } finally {
+      window.clearTimeout(timeout);
+      if (controller.current === requestController) {
+        controller.current = null;
+        setBusy(false);
+      }
+    }
+  }
+
+  return (
+    <form onSubmit={connect} aria-labelledby={`${id}-title`} className="rounded border border-gray-300 bg-white p-5">
+      <div className="mb-3 flex flex-wrap items-center justify-between gap-2">
+        <h3 id={`${id}-title`} className="font-semibold text-gray-900">{title}</h3>
+        <span className="rounded bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">{isDevice ? 'Private Wi-Fi LAN' : 'This machine'}</span>
+      </div>
+      <p id={`${id}-help`} className="mb-4 text-sm text-gray-600">
+        {isDevice ? 'Read diagnostics from a test device on your Wi-Fi network.' : 'Read diagnostics from the companion service running on your computer.'}
+        {' '}Connect requests {isDevice ? 'Local network' : 'Loopback network'} access if needed.
+      </p>
+      <label htmlFor={`${id}-url`} className="mb-1 block text-sm font-medium">Status endpoint (required)</label>
+      <input id={`${id}-url`} name="endpoint" type="url" required value={endpoint}
+        onChange={event => { setEndpoint(event.target.value); setInvalid(false); setResult(''); setMessage('Not connected.'); }}
+        disabled={busy} autoComplete="off" autoCapitalize="none" autoCorrect="off" spellCheck={false}
+        aria-invalid={invalid} aria-describedby={`${id}-help ${id}-status`}
+        className="min-h-12 w-full rounded border border-gray-500 px-3 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 disabled:bg-gray-100" />
+      <p className="mt-2 text-xs text-gray-600">Permission: {permission === 'unknown' ? 'browser will check on connect' : permission === 'prompt' ? 'ask on connect' : permission}</p>
+      {!secure && <p className="mt-3 text-sm text-red-800">Open this page over HTTPS to connect to local endpoints.</p>}
+      {permission === 'denied' && <p className="mt-3 text-sm text-red-800">Access is blocked. Open browser site settings, allow {isDevice ? 'Local network' : 'Loopback network'} access, then try again. Reload if needed.</p>}
+      <button type="submit" disabled={!ready || !secure || busy || permission === 'denied'}
+        className="mt-4 min-h-12 rounded bg-gray-900 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700 disabled:cursor-not-allowed disabled:opacity-60">
+        {busy ? 'Connecting…' : isDevice ? 'Connect to device' : 'Connect to CLI'}
+      </button>
+      <p id={`${id}-status`} role="status" aria-atomic="true" className="mt-3 text-sm text-gray-700">{message}</p>
+      {result && <details className="mt-3 text-sm"><summary className="cursor-pointer py-2 font-medium">Response preview</summary><pre className="max-h-52 overflow-auto whitespace-pre-wrap break-all rounded bg-gray-100 p-3 text-xs">{result}</pre></details>}
+    </form>
+  );
+}
+
+export default function DiagnosticsWidget() {
+  return (
+    <section aria-labelledby="diagnostics-title" className="mx-4 my-6 border-y-2 border-gray-900 bg-gray-50 px-4 py-6 sm:mx-6 sm:px-6">
+      <p className="mb-1 text-xs font-semibold uppercase tracking-widest text-gray-600">Developer tools</p>
+      <h2 id="diagnostics-title" className="font-brand text-3xl text-gray-900">Developer diagnostics</h2>
+      <p className="mt-2 max-w-3xl text-sm text-gray-700">Connect your test bench to The DevTools Times. Each button makes a status request directly from your browser to the endpoint you choose.</p>
+      <div className="mt-5 grid gap-4 lg:grid-cols-2"><ConnectionPanel space="local" /><ConnectionPanel space="loopback" /></div>
+      <details className="mt-4 text-sm text-gray-700">
+        <summary className="cursor-pointer py-2 font-semibold">Connection requirements & troubleshooting</summary>
+        <p className="mt-2">Use HTTPS for this page and a browser supporting local network connections. If your browser blocks an HTTP endpoint, try a trusted HTTPS endpoint or a current Chromium browser. The device must be on your network; the CLI must be running on this computer.</p>
+        <p className="mt-2">The endpoint must accept GET and return a successful HTTP status. Configure its CORS response header Access-Control-Allow-Origin to allow this page’s origin. Browser permission and CORS are both required. Requests omit credentials and stop after 10 seconds. A successful check is a snapshot; click Connect again to refresh.</p>
+      </details>
+      <noscript><p className="mt-3">Enable JavaScript to connect to your device or CLI.</p></noscript>
+    </section>
+  );
+}
