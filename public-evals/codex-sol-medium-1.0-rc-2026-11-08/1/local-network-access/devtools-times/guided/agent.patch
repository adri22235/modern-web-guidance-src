@@ -0,0 +1,29 @@
+export type AddressSpace = 'local' | 'loopback';
+
+export function diagnosticEndpoint(value: string, space: AddressSpace): URL {
+  const url = new URL(value);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase();
+  const octets = host.split('.').map(Number);
+  const ipv4 = octets.length === 4 && octets.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+  const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || (ipv4 && octets[0] === 127);
+  const local = (ipv4 && (octets[0] === 10 ||
+    (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31) ||
+    (octets[0] === 192 && octets[1] === 168) ||
+    (octets[0] === 169 && octets[1] === 254))) || host.endsWith('.local');
+  if (space === 'loopback' ? !loopback : !local) {
+    throw new Error(space === 'loopback'
+      ? 'Use a loopback address such as http://127.0.0.1:45678/health or localhost.'
+      : 'Use a private IPv4 address such as http://192.168.1.100:8080/api/status or a .local hostname.');
+  }
+  return url;
+}
+
+export function diagnosticRequestOptions(space: AddressSpace, signal: AbortSignal): RequestInit & { targetAddressSpace: AddressSpace } {
+  return {
+    method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+    redirect: 'error', referrerPolicy: 'no-referrer', targetAddressSpace: space, signal,
+  };
+}
