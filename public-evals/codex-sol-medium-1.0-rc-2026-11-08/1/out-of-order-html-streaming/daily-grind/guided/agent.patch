+  <!-- The server may flush the page shell above before these cards are ready.
+       Keep this template in the SAME response; template-for patches are single-use.
+       Subsequent menu changes update the stable #seasonal-cards element via JS. -->
+  <template for="seasonal-cards" id="initial-seasonal-cards">
+    <article class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </article>
+    <article class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </article>
+    <article class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </article>
+  </template>
+
+  <script type="module">
+    const cards = document.getElementById('seasonal-cards');
+    const status = document.getElementById('menu-status');
+    const initialCards = document.getElementById('initial-seasonal-cards');
+
+    // Small same-document fallback for browsers without declarative partial updates.
+    // Native patching has already removed the skeletons when supported.
+    if (cards.querySelector('.skeleton')) {
+      cards.replaceChildren(initialCards.content.cloneNode(true));
+    }
+    initialCards?.remove();
+    status.textContent = '';
+
+    // Backend contract (not provided by this static app):
+    // GET /api/menu/seasonal -> text/html containing card fragments, not a full page.
+    // GET /api/menu/events -> text/event-stream; emit event: menu-changed on publish.
+    // GET /api/reviews -> text/html containing customer-submitted reviews.
+    // GET /api/cms/seasonal-promo -> text/html authored ONLY by trusted CMS editors;
+    // it may contain its widget's scripts. Never mix customer HTML into this response.
+    // All HTML endpoints must return correct status codes and Content-Type: text/html.
+    async function fetchHTML(path, signal) {
+      const response = await fetch(path, {
+        headers: { Accept: 'text/html' },
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        signal
+      });
+      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error('HTML fragment unavailable');
+      }
+      return response;
+    }
+
+    let purifier;
+    async function setSafeHTML(target, html) {
+      if ('setHTML' in Element.prototype) {
+        target.setHTML(html);
+      } else {
+        // Load a sanitizer only on browsers missing the native safe setter.
+        purifier ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.3.0/dist/purify.es.mjs');
+        const { default: DOMPurify } = await purifier;
+        target.replaceChildren(DOMPurify.sanitize(html, { RETURN_DOM_FRAGMENT: true }));
+      }
+    }
+
+    let menuController;
+    async function refreshMenu() {
+      menuController?.abort();
+      const controller = menuController = new AbortController();
+      cards.setAttribute('aria-busy', 'true');
+      status.textContent = 'Updating seasonal favorites…';
+      try {
+        const response = await fetchHTML('/api/menu/seasonal', controller.signal);
+        // Stage the new cards to preserve the current menu on network/parse failure.
+        const updated = document.createElement('div');
+        await setSafeHTML(updated, await response.text());
+        if (controller.signal.aborted) return;
+        cards.replaceChildren(...updated.childNodes);
+        status.textContent = 'Seasonal favorites updated.';
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          status.textContent = 'Unable to refresh the menu. Please try again later.';
+        }
+      } finally {
+        if (menuController === controller) cards.removeAttribute('aria-busy');
+      }
+    }
+
+    // Local menu editors can also dispatch this event after a successful save.
+    window.addEventListener('menu-changed', refreshMenu);
+    if ('EventSource' in window) {
+      let menuEvents;
+      function connectMenuEvents() {
+        menuEvents = new EventSource('/api/menu/events');
+        menuEvents.addEventListener('menu-changed', refreshMenu);
+      }
+      connectMenuEvents();
+      window.addEventListener('pagehide', () => menuEvents.close());
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) {
+          connectMenuEvents();
+          void refreshMenu();
+        }
+      });
+    }
+
+    async function loadReviews() {
+      const target = document.getElementById('customer-reviews');
+      try {
+        const response = await fetchHTML('/api/reviews');
+        // Customer HTML always uses the XSS-safe API; scripts never opt in here.
+        const updated = document.createElement('div');
+        await setSafeHTML(updated, await response.text());
+        target.replaceChildren(...updated.childNodes);
+      } catch {
+        // Preserve the readable empty state if the endpoint or sanitizer is unavailable.
+      }
+    }
+
+    async function loadPromo() {
+      const target = document.getElementById('cms-promo');
+      try {
+        const response = await fetchHTML('/api/cms/seasonal-promo');
+        // This fixed first-party endpoint is an explicit code-execution trust boundary.
+        // Only trusted CMS HTML gets runScripts; never use this path for reviews.
+        if ('streamHTMLUnsafe' in Element.prototype && response.body) {
+          await response.body.pipeThrough(new TextDecoderStream())
+            .pipeTo(target.streamHTMLUnsafe({ runScripts: true }));
+        } else {
+          // Buffer trusted CMS markup on browsers without the streaming setter.
+          const range = document.createRange();
+          range.selectNodeContents(target);
+          const fragment = range.createContextualFragment(await response.text());
+          target.replaceChildren(fragment);
+        }
+      } catch {
+        // The rewards link remains useful when the CMS is unavailable.
+      }
+    }
+
+    void loadReviews();
+    void loadPromo();
+  </script>
+
