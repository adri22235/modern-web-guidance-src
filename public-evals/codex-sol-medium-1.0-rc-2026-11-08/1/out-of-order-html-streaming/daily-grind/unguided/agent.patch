+  <!-- The server can flush the shell above, then emit this template when the
+       cards are ready, before closing the same HTML response. Keep it in body
+       so the target range is within its patching scope. -->
+  <template id="initial-seasonal-cards" for="seasonal-cards">
+    <article class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </article>
+    <article class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smoky, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </article>
+    <article class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </article>
+  </template>
+
+  <script type="module">
+    const cards = document.getElementById('seasonal-cards');
+    const refreshButton = document.getElementById('refresh-menu');
+    const menuStatus = document.getElementById('menu-status');
+    const reviews = document.getElementById('customer-reviews');
+    const promo = document.getElementById('cms-promo');
+
+    // Older parsers leave the in-document template inert. Clone only this
+    // author-controlled markup; fetched HTML never goes through this fallback.
+    if (!('htmlFor' in HTMLTemplateElement.prototype)) {
+      const initialCards = document.getElementById('initial-seasonal-cards');
+      cards.replaceChildren(initialCards.content.cloneNode(true));
+      initialCards.remove();
+    }
+
+    /* Server contract (all endpoints are same-origin):
+       GET /api/menu/seasonal.html: text/html containing card children only.
+       GET /api/reviews.html: text/html containing customer-submitted reviews.
+       GET /cms/seasonal-promo.html: trusted first-party HTML + widget script.
+         This CMS route must never include unsanitized customer submissions.
+       GET /api/menu/events: text/event-stream; emit `event: menu-changed`
+         followed by `data: {}` and a blank line after every published change.
+       These routes must be supplied by the deployment's server/CMS. */
+    async function fetchHTML(url, signal) {
+      const response = await fetch(url, {
+        headers: { Accept: 'text/html' },
+        credentials: 'same-origin',
+        cache: 'no-store',
+        redirect: 'error',
+        signal
+      });
+      if (!response.ok ||
+          response.headers.get('Content-Type')?.split(';')[0].trim().toLowerCase() !== 'text/html') {
+        throw new Error('HTML response unavailable');
+      }
+      return response;
+    }
+
+    let menuRequest;
+    async function refreshMenu() {
+      menuRequest?.abort();
+      const request = new AbortController();
+      menuRequest = request;
+      cards.setAttribute('aria-busy', 'true');
+      refreshButton.disabled = true;
+      menuStatus.textContent = 'Refreshing our seasonal favorites…';
+      try {
+        const response = await fetchHTML('/api/menu/seasonal.html', request.signal);
+        const html = await response.text();
+        if (request.signal.aborted) return;
+        // Replace only the cards, retaining the section, heading, and controls.
+        // Safe parsing also prevents menu HTML from executing scripts.
+        cards.setHTML(html);
+        menuStatus.textContent = 'The seasonal menu is up to date.';
+      } catch (error) {
+        if (error.name !== 'AbortError') {
+          menuStatus.textContent = 'We couldn’t refresh the menu. Please try again; the last menu is still shown.';
+        }
+      } finally {
+        if (menuRequest === request) {
+          cards.removeAttribute('aria-busy');
+          refreshButton.disabled = false;
+        }
+      }
+    }
+
+    if (typeof cards.setHTML === 'function') {
+      refreshButton.hidden = false;
+      refreshButton.addEventListener('click', refreshMenu);
+      if ('EventSource' in window) {
+        const menuEvents = new EventSource('/api/menu/events');
+        menuEvents.addEventListener('menu-changed', refreshMenu);
+        // A reconnect may follow missed changes, so fetch the current snapshot.
+        menuEvents.addEventListener('open', refreshMenu);
+      } else {
+        menuStatus.textContent = 'Use Refresh menu to see the latest favorites.';
+      }
+    } else {
+      menuStatus.textContent = 'Visit the full menu for the latest seasonal favorites.';
+    }
+
+    async function loadReviews() {
+      if (typeof reviews.setHTML !== 'function') {
+        reviews.textContent = 'Customer reviews are unavailable in this browser.';
+        return;
+      }
+      try {
+        const response = await fetchHTML('/api/reviews.html');
+        // Customer content always uses the safe sanitizer, including removal
+        // of scripts, event handlers, and unsafe URL attributes.
+        reviews.setHTML(await response.text());
+      } catch {
+        reviews.textContent = 'Customer reviews are temporarily unavailable.';
+      }
+    }
+
+    async function loadPromo() {
+      // Require the new streaming API rather than an older unsafe setter that
+      // might silently ignore runScripts. Only the trusted CMS uses this sink.
+      if (typeof promo.streamHTMLUnsafe !== 'function') return;
+      try {
+        const response = await fetchHTML('/cms/seasonal-promo.html');
+        if (!response.body) throw new Error('Missing promo stream');
+        await response.body.pipeThrough(new TextDecoderStream())
+          .pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+      } catch {
+        promo.textContent = 'Check back for our latest coffee offers.';
+      }
+    }
+
+    void loadReviews();
+    void loadPromo();
+  </script>
+
