diff --git a/drink-card.js b/drink-card.js
new file mode 100644
index 0000000..a419203
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,45 @@
+// Module scripts run after parsing, so the declarative shadow roots already exist.
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['favorite'];
+
+  #button;
+
+  get favorite() {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback() {
+    // Preserve the server's DOM and avoid duplicate listeners after reconnection.
+    if (this.#button) return;
+    const button = this.shadowRoot?.querySelector('button');
+    if (!button) return;
+
+    this.#button = button;
+    this.#syncFavorite();
+    button.addEventListener('click', () => {
+      this.favorite = !this.favorite;
+      this.dispatchEvent(new CustomEvent('favorite-change', {
+        bubbles: true,
+        composed: true,
+        detail: { favorite: this.favorite },
+      }));
+    });
+    button.disabled = false;
+  }
+
+  attributeChangedCallback() {
+    this.#syncFavorite();
+  }
+
+  #syncFavorite() {
+    this.#button?.setAttribute('aria-pressed', String(this.favorite));
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
