diff --git a/tests/drink-card.test.cjs b/tests/drink-card.test.cjs
new file mode 100644
index 0000000..0f5ca0c
--- /dev/null
+++ b/tests/drink-card.test.cjs
@@ -0,0 +1,87 @@
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { test } = require('node:test');
+const { runInNewContext } = require('node:vm');
+
+const source = readFileSync(new URL('../drink-card.js', `file://${__filename}`), 'utf8');
+
+function setup() {
+  const registry = new Map();
+  class Button extends EventTarget {
+    disabled = true;
+    attributes = new Map([['aria-pressed', 'false']]);
+    getAttribute(name) { return this.attributes.get(name); }
+    setAttribute(name, value) { this.attributes.set(name, value); }
+    click() { this.dispatchEvent(new Event('click')); }
+  }
+  class HTMLElement {
+    button = new Button();
+    querySelector(selector) {
+      assert.equal(selector, '.favorite-toggle');
+      return this.button;
+    }
+  }
+  const context = {
+    HTMLElement,
+    customElements: {
+      get: (name) => registry.get(name),
+      define: (name, element) => registry.set(name, element),
+    },
+  };
+  runInNewContext(source, context);
+  return registry.get('drink-card');
+}
+
+test('upgrade retains the existing button and toggles accessible state independently', () => {
+  const DrinkCard = setup();
+  const first = new DrinkCard();
+  const second = new DrinkCard();
+  const originalButton = first.button;
+  first.connectedCallback();
+  second.connectedCallback();
+  assert.equal(first.button, originalButton);
+  assert.equal(originalButton.disabled, false);
+  originalButton.click();
+  assert.equal(originalButton.getAttribute('aria-pressed'), 'true');
+  assert.equal(second.button.getAttribute('aria-pressed'), 'false');
+  originalButton.click();
+  assert.equal(originalButton.getAttribute('aria-pressed'), 'false');
+});
+
+test('reconnection keeps favorite state and attaches a single listener', () => {
+  const DrinkCard = setup();
+  const card = new DrinkCard();
+  card.connectedCallback();
+  card.connectedCallback();
+  card.button.click();
+  assert.equal(card.button.getAttribute('aria-pressed'), 'true');
+  card.disconnectedCallback();
+  card.button.click();
+  assert.equal(card.button.getAttribute('aria-pressed'), 'true');
+  card.connectedCallback();
+  card.button.click();
+  assert.equal(card.button.getAttribute('aria-pressed'), 'false');
+});
+
+test('an incomplete card does not prevent other cards from upgrading', () => {
+  const DrinkCard = setup();
+  const card = new DrinkCard();
+  card.button = null;
+  assert.doesNotThrow(() => card.connectedCallback());
+  assert.doesNotThrow(() => card.disconnectedCallback());
+});
+
+test('initial response includes styled card content and working details links without JS', () => {
+  const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+  const cards = [...html.matchAll(/<drink-card class="card">([\s\S]*?)<\/drink-card>/g)];
+  assert.equal(cards.length, 3);
+  assert.ok(html.indexOf('<style>') < html.indexOf('<drink-card'));
+  assert.match(html, /\.card\s*\{\s*display: block;/);
+  assert.match(html, /<script type="module" src="\/drink-card.js"><\/script>/);
+  for (const [, card] of cards) {
+    assert.match(card, /<h3>.+<\/h3>/);
+    assert.match(card, /<p>.+<\/p>/);
+    assert.match(card, /<a href="\/menu\/[^\"]+" class="btn">View Details<\/a>/);
+    assert.match(card, /<button type="button"[^>]+aria-label="Favorite [^"]+" aria-pressed="false" disabled>Favorite<\/button>/);
+  }
+});
