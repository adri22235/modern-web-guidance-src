index 0000000..40dfb7b
--- /dev/null
+++ b/drink-card.js
@@ -0,0 +1,28 @@
+// The initial HTML and head styles render each card before this module loads.
+// Upgrade the existing light DOM in place; never rebuild the card's contents.
+class DrinkCard extends HTMLElement {
+  #button;
+
+  #toggleFavorite = () => {
+    const pressed = this.#button.getAttribute('aria-pressed') === 'true';
+    this.#button.setAttribute('aria-pressed', String(!pressed));
+  };
+
+  connectedCallback() {
+    const button = this.querySelector('.favorite-toggle');
+    if (!button || this.#button === button) return;
+
+    this.#button = button;
+    button.addEventListener('click', this.#toggleFavorite);
+    button.disabled = false;
+  }
+
+  disconnectedCallback() {
+    this.#button?.removeEventListener('click', this.#toggleFavorite);
+    this.#button = undefined;
+  }
+}
+
+if (!customElements.get('drink-card')) {
+  customElements.define('drink-card', DrinkCard);
+}
