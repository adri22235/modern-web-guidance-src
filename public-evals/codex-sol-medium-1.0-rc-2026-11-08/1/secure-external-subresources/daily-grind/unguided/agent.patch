+  <script>
+    // Pin exact bytes, including image format. Recompute hashes whenever URLs change.
+    // Fonts and images use Fetch SRI because ordinary CSS URLs and img attributes
+    // do not enforce integrity across supported browsers. Never retry unchecked.
+    const verifiedAssets = {
+      "font": {
+        "url": "https://cdn.jsdelivr.net/npm/@fontsource/lora@5.2.6/files/lora-latin-600-normal.woff2",
+        "integrity": "sha384-jcoBhRDSEf1s7E8BSKhvHtvEgR35dLJFGJcgv39PYAlkYKp7DCVHV3LS3wDijTWS"
+      },
+      "hero": {
+        "url": "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?fm=jpg&fit=crop&w=1350&q=80",
+        "integrity": "sha384-YUet8nBDHQZZytDjKEaBDYSEY+6j+mSlWjiARMNti2PWhjnHa74ouBxvRVcUN10H"
+      },
+      "latte": {
+        "url": "https://images.unsplash.com/photo-1541167760496-1628856ab772?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-dtnD0xter30KbjXWTaSibu9xBLshJa+/TONLhfwUNjEj71lGWoO0aIqXZvRiC7iU"
+      },
+      "espresso": {
+        "url": "https://images.unsplash.com/photo-1510707577719-ae7c14805e3a?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-Yl309C3L1ztIQVEAWthyto6bmQ0NCfR6Fh0FKlo8X3ivrTz/hzKSRVHh4ZXfJ2SX"
+      },
+      "coldbrew": {
+        "url": "https://images.unsplash.com/photo-1461023058943-07fcbe16d735?fm=jpg&fit=crop&w=600&h=400&q=80",
+        "integrity": "sha384-x2K/bA51pQugUJAdiAyKc3oWHrr4/9gsaNZcD9LJa6aOD7gBgsdD6mqy1z7Ziqsu"
+      }
+    };
+
+    async function fetchVerifiedAsset(name) {
+      const asset = verifiedAssets[name];
+      const response = await fetch(asset.url, {
+        integrity: asset.integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error(`Resource request failed: ${name}`);
+      return response;
+    }
+
+    async function loadVerifiedFont() {
+      const response = await fetchVerifiedAsset('font');
+      const font = new FontFace('Lora', await response.arrayBuffer(), {
+        weight: '600',
+        style: 'normal',
+        display: 'swap'
+      });
+      document.fonts.add(await font.load());
+    }
+
+    async function loadVerifiedImage(name, element) {
+      const response = await fetchVerifiedAsset(name);
+      const objectURL = URL.createObjectURL(await response.blob());
+      if (name === 'hero') {
+        // Keep this URL alive while the CSS background uses it.
+        element.style.setProperty('--hero-image', `url("${objectURL}")`);
+        window.addEventListener('pagehide', (event) => {
+          if (!event.persisted) URL.revokeObjectURL(objectURL);
+        }, { once: true });
+      } else {
+        element.onload = () => {
+          element.hidden = false;
+          URL.revokeObjectURL(objectURL);
+        };
+        element.onerror = () => URL.revokeObjectURL(objectURL);
+        element.src = objectURL;
+      }
+    }
+
+    // Each resource fails independently; the page retains its text and fallbacks.
+    const reportAssetFailure = (error) => console.warn('Verified asset unavailable:', error);
+    loadVerifiedFont().catch(reportAssetFailure);
+    loadVerifiedImage('hero', document.querySelector('.hero')).catch(reportAssetFailure);
+    document.querySelectorAll('[data-verified-image]').forEach((image) => {
+      loadVerifiedImage(image.dataset.verifiedImage, image).catch(reportAssetFailure);
+    });
+    document.addEventListener('DOMContentLoaded', () => {
+      if (window.feather) window.feather.replace({ 'aria-hidden': 'true' });
+    });
+  </script>
+
 </body>
 
