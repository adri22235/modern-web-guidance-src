+          document.querySelector('.hero').style.setProperty('--hero-image', `url("${objectURL}")`);
+        }
+      } catch (error) {
+        // Retain the solid hero background and readable card text on failure.
+        console.warn(`Verified image unavailable: ${name}`, error);
+      }
+    }
