+    async function fetchVerified(asset) {
+      const response = await fetch(asset.url, {
+        integrity: asset.integrity,
+        mode: 'cors',
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer',
+      });
+      if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+      return response;
+    }
+
+    // Images do not support an HTML integrity attribute. Consume only blobs
+    // from SRI-checked fetches; never retry using an unverified remote URL.
+    async function loadVerifiedImage(name, image) {
+      try {
+        const response = await fetchVerified(verifiedAssets[name]);
+        const objectURL = URL.createObjectURL(await response.blob());
+        if (image) {
+          image.addEventListener('load', () => URL.revokeObjectURL(objectURL), { once: true });
+          image.addEventListener('error', () => {
+            image.hidden = true;
+            URL.revokeObjectURL(objectURL);
+          }, { once: true });
+          image.src = objectURL;
