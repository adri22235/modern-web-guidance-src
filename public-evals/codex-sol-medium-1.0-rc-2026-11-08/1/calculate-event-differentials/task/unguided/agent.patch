+  <script>
+    (() => {
+      // Assumed promotion start; months in the numeric Date constructor are zero-based.
+      // Numeric components interpret both boundaries in the visitor's local time zone.
+      const promotionStart = new Date(2026, 0, 1, 0, 0, 0);
+      const promotionEnd = new Date(2026, 2, 1, 0, 0, 0);
+      const hourInMilliseconds = 60 * 60 * 1000;
+      const countdown = document.getElementById('maple-countdown');
+      const elapsed = document.getElementById('maple-elapsed');
+
+      function formatDuration(milliseconds) {
+        const totalHours = Math.floor(Math.max(0, milliseconds) / hourInMilliseconds);
+        const days = Math.floor(totalHours / 24);
+        const hours = totalHours % 24;
+        return `${days} ${days === 1 ? 'day' : 'days'} and ${hours} ${hours === 1 ? 'hour' : 'hours'}`;
+      }
+
+      function updatePromotionTimer() {
+        const now = Date.now();
+        const remaining = promotionEnd.getTime() - now;
+        countdown.textContent = remaining <= 0
+          ? 'Offer ended · 0 days and 0 hours left'
+          : `${formatDuration(remaining)} left`;
+        elapsed.textContent = now < promotionStart.getTime()
+          ? 'Promotion has not started · 0 days and 0 hours elapsed'
+          : `${formatDuration(now - promotionStart.getTime())} elapsed since promotion start`;
+      }
+
+      updatePromotionTimer();
+      // Refresh while open, including after returning to a suspended tab.
+      window.setInterval(updatePromotionTimer, 60 * 1000);
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotionTimer();
+      });
+    })();
+  </script>
