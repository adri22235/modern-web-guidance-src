+  <button id="open-feedback" type="button" class="btn feedback-launcher" aria-haspopup="dialog"
+    aria-controls="feedback-dialog">Share feedback</button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('open-feedback');
+    const feedbackHosts = Array.from(document.querySelectorAll('[data-feedback-host]'));
+    const feedbackLocation = document.getElementById('feedback-location');
+    let restoreInvoker = false;
+
+    feedbackLauncher.addEventListener('click', () => feedbackDialog.showModal());
+
+    document.getElementById('move-feedback').addEventListener('click', () => {
+      const currentIndex = feedbackHosts.indexOf(feedbackDialog.parentElement);
+      const destination = feedbackHosts[(currentIndex + 1) % feedbackHosts.length];
+
+      if (typeof destination.moveBefore === 'function') {
+        // An atomic move keeps the same dialog in the top layer, with focus intact.
+        destination.moveBefore(feedbackDialog, null);
+      } else {
+        const wasModal = feedbackDialog.matches(':modal');
+        const focusedControl = document.activeElement;
+        const selection = focusedControl instanceof HTMLTextAreaElement
+          ? [focusedControl.selectionStart, focusedControl.selectionEnd, focusedControl.selectionDirection]
+          : null;
+        destination.appendChild(feedbackDialog);
+        if (wasModal) {
+          // A traditional move drops top-layer membership but can leave `open` set.
+          feedbackDialog.removeAttribute('open');
+          feedbackDialog.showModal();
+          restoreInvoker = true;
+          if (feedbackDialog.contains(focusedControl)) {
+            focusedControl.focus();
+            if (selection) focusedControl.setSelectionRange(...selection);
+          }
+        }
+      }
+
+      feedbackLocation.textContent = `Current section: ${destination.dataset.feedbackHost}`;
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      feedbackDialog.returnValue = '';
+      // Reopening in the fallback changes the browser's remembered invoker.
+      if (restoreInvoker) {
+        feedbackLauncher.focus();
+        restoreInvoker = false;
+      }
+    });
+  </script>
+
