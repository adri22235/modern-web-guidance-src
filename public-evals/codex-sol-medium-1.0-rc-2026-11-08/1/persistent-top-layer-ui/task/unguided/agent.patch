+  <button type="button" class="btn feedback-launcher" id="open-feedback" aria-haspopup="dialog">Share feedback <span aria-hidden="true">↗</span></button>
+
+  <script>
+    const dialog = document.querySelector('#feedback-dialog');
+    const launcher = document.querySelector('#open-feedback');
+    const message = document.querySelector('#feedback-message');
+    const status = document.querySelector('#feedback-status');
+    const sections = [...document.querySelectorAll('[data-feedback-section]')];
+
+    launcher.addEventListener('click', () => dialog.showModal());
+    document.querySelectorAll('.close-feedback, .cancel-feedback').forEach(button => {
+      button.addEventListener('click', () => dialog.close());
+    });
+    dialog.addEventListener('close', () => launcher.focus());
+
+    document.querySelector('#move-feedback').addEventListener('click', () => {
+      const destination = sections[(sections.indexOf(dialog.parentElement) + 1) % sections.length];
+      const focused = document.activeElement;
+      const selection = [message.selectionStart, message.selectionEnd, message.selectionDirection];
+      const scrollTop = dialog.scrollTop;
+      if (typeof destination.moveBefore === 'function') {
+        // Atomic moves retain top-layer membership, modality, and focus.
+        destination.moveBefore(dialog, null);
+      } else {
+        // Older browsers lose top-layer membership when a dialog is reparented.
+        // Reopen synchronously, before the browser paints the next frame.
+        destination.appendChild(dialog);
+        dialog.removeAttribute('open');
+        dialog.showModal();
+      }
+      document.querySelector('#feedback-location').textContent = destination.dataset.feedbackSection;
+      if (focused && dialog.contains(focused)) focused.focus({ preventScroll: true });
+      message.setSelectionRange(...selection);
+      dialog.scrollTop = scrollTop;
+    });
+
+    document.querySelector('#feedback-form').addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem('daily-grind-feedback', message.value);
+        status.textContent = 'Thank you! Your feedback has been saved in this browser.';
+      } catch {
+        status.textContent = 'Your browser could not save feedback. Your draft is still here.';
+      }
+    });
+    message.addEventListener('input', () => { status.textContent = ''; });
+    try { message.value = localStorage.getItem('daily-grind-feedback') || ''; } catch {}
+  </script>
 </body>
 
