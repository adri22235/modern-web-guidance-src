+  <script>
+    const subscriptionForm = document.getElementById('subscription-form');
+    const roastInput = document.getElementById('roast-level');
+    const emailInput = document.getElementById('coffee-emails');
+    const roastOutput = document.getElementById('roast-value');
+    const setupProgress = document.getElementById('setup-progress');
+    const setupCount = document.getElementById('setup-count');
+    const subscriptionStatus = document.getElementById('subscription-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const frequencyNames = { weekly: 'every week', fortnightly: 'every 2 weeks', monthly: 'every month' };
+    const storageKey = 'daily-grind-coffee-preferences';
+    let saved = false;
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roastInput.value) - 1];
+      roastOutput.value = `${roastName} · ${roastInput.value} of 5`;
+      roastInput.setAttribute('aria-valuetext', `${roastName}, ${roastInput.value} of 5`);
+      roastInput.style.setProperty('--fill', `${(Number(roastInput.value) - 1) / 4 * 100}%`);
+      const steps = 1 + Number(Boolean(subscriptionForm.elements.frequency.value)) + Number(saved);
+      const percent = Math.round(steps / 3 * 100);
+      setupProgress.value = steps;
+      setupProgress.textContent = `${percent}%`;
+      setupCount.textContent = `${steps} of 3 steps complete · ${percent}%`;
+    }
+
+    // Storage can be unavailable or contain outdated data; the form still works.
+    try {
+      const preferences = JSON.parse(localStorage.getItem(storageKey));
+      if (preferences && Object.hasOwn(frequencyNames, preferences.frequency) &&
+          Number.isInteger(preferences.roast) && preferences.roast >= 1 && preferences.roast <= 5 &&
+          typeof preferences.emails === 'boolean') {
+        subscriptionForm.elements.frequency.value = preferences.frequency;
+        roastInput.value = String(preferences.roast);
+        emailInput.checked = preferences.emails;
+        saved = true;
+        subscriptionStatus.textContent = 'Your saved coffee preferences are ready. You can update them anytime.';
+      }
+    } catch { /* Leave the default preferences available. */ }
+
+    subscriptionForm.addEventListener('input', () => {
+      saved = false;
+      subscriptionStatus.textContent = '';
+      updateSetup();
+    });
+
+    subscriptionForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const preferences = {
+        frequency: subscriptionForm.elements.frequency.value,
+        roast: Number(roastInput.value),
+        emails: emailInput.checked
+      };
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        saved = true;
+        subscriptionStatus.textContent = `Setup saved on this device: ${roastNames[preferences.roast - 1]} roast, delivered ${frequencyNames[preferences.frequency]}. Email preference: ${preferences.emails ? 'yes' : 'no'}.`;
+      } catch {
+        saved = false;
+        subscriptionStatus.textContent = 'Your browser could not save these preferences. Allow site storage and try again.';
+      }
+      updateSetup();
+    });
+
+    updateSetup();
+  </script>
+
 </body>
 
