+  <script>
+    const form = document.getElementById('subscription-form');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('subscription-progress');
+    const progressText = document.getElementById('progress-text');
+    const status = document.getElementById('subscription-status');
+    const emailOptIn = document.getElementById('email-opt-in');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+    const storageKey = 'daily-grind-subscription-setup';
+
+    function updateSetup() {
+      const name = roastNames[Number(roast.value) - 1];
+      roastValue.value = name;
+      roast.setAttribute('aria-valuetext', name);
+      roast.style.setProperty('--roast-fill', `${(Number(roast.value) - 1) * 25}%`);
+      const completed = form.querySelector('input[name="frequency"]:checked') ? 2 : 1;
+      progress.value = completed;
+      progress.textContent = `${completed * 50}%`;
+      progressText.textContent = `${completed} of 2 preferences · ${completed * 50}%`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        const frequency = Array.from(form.elements.frequency).find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        emailOptIn.checked = saved.emailOptIn === true;
+      }
+    } catch {
+      // The form remains usable when device storage is unavailable.
+    }
+
+    form.addEventListener('input', () => {
+      updateSetup();
+      status.textContent = '';
+    });
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const preferences = {
+        frequency: form.elements.frequency.value,
+        roast: Number(roast.value),
+        emailOptIn: emailOptIn.checked
+      };
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        status.textContent = 'Your subscription preferences are saved on this device.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow device storage and try again.';
+      }
+    });
+
+    updateSetup();
+  </script>
