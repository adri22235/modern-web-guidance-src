+  <script>
+    (() => {
+      const hasPopover = 'popover' in HTMLElement.prototype;
+      const hasAnchors = window.CSS && CSS.supports('anchor-name: --item') &&
+        CSS.supports('position-area: block-start') && CSS.supports('position-try-fallbacks: flip-block');
+      const items = Array.from(document.querySelectorAll('.card .btn[aria-describedby]')).map(trigger => ({
+        trigger,
+        tooltip: document.getElementById(trigger.getAttribute('aria-describedby')),
+        hovered: false,
+        tooltipHovered: false,
+        focused: false,
+        dismissed: false,
+        timer: null
+      }));
+      let active = null;
+
+      function position(item) {
+        if (hasAnchors && hasPopover) return;
+        const rect = item.trigger.getBoundingClientRect();
+        const popup = item.tooltip.getBoundingClientRect();
+        const edge = 12;
+        const gap = 8;
+        const width = document.documentElement.clientWidth;
+        const height = document.documentElement.clientHeight;
+        const above = rect.top - gap - popup.height;
+        const below = rect.bottom + gap;
+        const top = above >= edge ? above : below;
+        item.tooltip.style.left = `${Math.max(edge, Math.min(rect.left + (rect.width - popup.width) / 2, width - popup.width - edge))}px`;
+        item.tooltip.style.top = `${Math.max(edge, Math.min(top, height - popup.height - edge))}px`;
+        item.tooltip.style.margin = '0';
+      }
+
+      function close(item) {
+        clearTimeout(item.timer);
+        if (active !== item) return;
+        active = null;
+        if (hasPopover) item.tooltip.hidePopover();
+        else item.tooltip.classList.remove('is-open');
+        item.tooltipHovered = false;
+      }
+
+      function show(item) {
+        clearTimeout(item.timer);
+        if (item.dismissed) return;
+        if (active && active !== item) close(active);
+        if (active !== item) {
+          active = item;
+          if (hasPopover) item.tooltip.showPopover();
+          else item.tooltip.classList.add('is-open');
+        }
+        position(item);
+      }
+
+      function leave(item) {
+        clearTimeout(item.timer);
+        if (!item.hovered && !item.focused && !item.tooltipHovered) {
+          item.dismissed = false;
+          // Let the pointer cross the gap between the button and its tooltip.
+          item.timer = setTimeout(() => close(item), 150);
+        }
+      }
+
+      items.forEach(item => {
+        // Older browsers ignore popover; use the same controller and fixed positioning.
+        if (!hasPopover) item.tooltip.removeAttribute('popover');
+        item.trigger.addEventListener('mouseenter', () => { item.hovered = true; show(item); });
+        item.trigger.addEventListener('mouseleave', () => { item.hovered = false; leave(item); });
+        item.trigger.addEventListener('focus', () => { item.focused = true; show(item); });
+        item.trigger.addEventListener('blur', () => { item.focused = false; leave(item); });
+        item.tooltip.addEventListener('mouseenter', () => { item.tooltipHovered = true; show(item); });
+        item.tooltip.addEventListener('mouseleave', () => { item.tooltipHovered = false; leave(item); });
+        item.tooltip.addEventListener('beforetoggle', event => {
+          if (event.newState === 'closed' && active === item) {
+            active = null;
+            item.dismissed = item.hovered || item.focused;
+          }
+        });
+      });
+
+      document.addEventListener('keydown', event => {
+        if (event.key === 'Escape' && active) {
+          active.dismissed = true;
+          close(active);
+        }
+      });
+      document.addEventListener('pointerdown', event => {
+        if (active && !active.trigger.contains(event.target) && !active.tooltip.contains(event.target)) {
+          active.dismissed = true;
+          close(active);
+        }
+      });
+      window.addEventListener('resize', () => { if (active) position(active); });
+      document.addEventListener('scroll', () => { if (active) position(active); }, true);
+    })();
+  </script>
