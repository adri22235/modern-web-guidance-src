+  <script>
+    document.querySelectorAll('.tooltip-trigger').forEach(function (trigger) {
+      function resetDismissal() {
+        if (!trigger.matches(':hover') && !trigger.contains(document.activeElement)) {
+          trigger.removeAttribute('data-tooltip-dismissed');
+        }
+      }
+
+      trigger.addEventListener('mouseleave', resetDismissal);
+      trigger.addEventListener('focusout', function () {
+        // Wait for focus to move before deciding whether the interaction ended.
+        setTimeout(resetDismissal, 0);
+      });
+    });
+
+    document.addEventListener('keydown', function (event) {
+      if (event.key === 'Escape') {
+        document.querySelectorAll('.tooltip-trigger').forEach(function (trigger) {
+          if (trigger.matches(':hover') || trigger.contains(document.activeElement)) {
+            trigger.setAttribute('data-tooltip-dismissed', '');
+          }
+        });
+      }
+    });
+  </script>
