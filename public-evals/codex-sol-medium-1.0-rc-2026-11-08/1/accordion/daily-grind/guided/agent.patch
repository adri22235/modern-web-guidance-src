+  <script>
+    const coffeeFaq = document.getElementById('coffee-faq');
+    const faqItems = [...coffeeFaq.querySelectorAll('.faq-item')];
+
+    function setFaqOpen(item, open) {
+      item.classList.toggle('is-open', open);
+      item.querySelector('.faq-trigger').setAttribute('aria-expanded', String(open));
+      item.querySelector('.faq-panel').inert = !open;
+    }
+
+    faqItems.forEach((item) => {
+      setFaqOpen(item, false);
+      item.querySelector('.faq-trigger').addEventListener('click', () => {
+        const shouldOpen = !item.classList.contains('is-open');
+        faqItems.forEach((other) => setFaqOpen(other, other === item && shouldOpen));
+      });
+    });
+    coffeeFaq.classList.add('is-enhanced');
+  </script>
