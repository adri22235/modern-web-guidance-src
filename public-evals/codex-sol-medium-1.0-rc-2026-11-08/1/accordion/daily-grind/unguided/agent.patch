+    /* Coffee FAQ */
+    #coffee-faq {
+      margin-top: 48px;
+    }
+
+    #coffee-faq h2 {
+      color: var(--primary);
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .faq-item {
+      margin-top: 12px;
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      overflow: hidden;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
+    }
+
+    .faq-question {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      width: 100%;
+      padding: 20px;
+      border: 0;
+      background: white;
+      color: var(--primary);
+      font: inherit;
+      font-weight: 600;
+      text-align: left;
+      cursor: pointer;
+      transition: background-color 0.3s;
+    }
+
+    .faq-question:hover,
+    .faq-question[aria-expanded="true"] {
+      background: var(--secondary);
+    }
+
+    .faq-question:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: -4px;
+    }
+
+    .faq-icon {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      flex-shrink: 0;
+      width: 28px;
+      height: 28px;
+      border-radius: 50%;
+      background: var(--accent);
+      font-size: 1.25rem;
+      transition: transform 0.3s;
+    }
+
+    .faq-question[aria-expanded="true"] .faq-icon {
+      transform: rotate(45deg);
+    }
+
+    .faq-panel {
+      display: grid;
+      grid-template-rows: 0fr;
+      visibility: hidden;
+      transition: grid-template-rows 0.3s ease, visibility 0.3s;
+    }
+
+    .faq-panel.is-open {
+      grid-template-rows: 1fr;
+      visibility: visible;
+    }
+
+    .faq-panel-inner {
+      min-height: 0;
+      overflow: hidden;
+    }
+
+    .faq-panel p {
+      padding: 20px;
+    }
+
+    .faq-panel a {
+      color: var(--primary);
+      text-underline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .faq-question,
+      .faq-icon,
+      .faq-panel {
+        transition: none;
+      }
+    }
+
