+    /* Order and rewards progress */
+    .progress-section {
+      margin-bottom: 40px;
+      padding: 24px;
+      background: #fff8ef;
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+    }
+
+    .progress-section > p {
+      margin-top: 4px;
+    }
+
+    .progress-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+      gap: 24px;
+      margin-top: 24px;
+    }
+
+    .progress-heading {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 4px 12px;
+      margin-bottom: 10px;
+      font-weight: 600;
+    }
+
+    .progress-heading span {
+      font-size: 0.85rem;
+    }
+
+    .progress-help {
+      margin-top: 8px;
+      font-size: 0.9rem;
+    }
+
+    .process-progress {
+      --progress-fill: var(--primary);
+      --progress-animation: none;
+      --progress-duration: 2s;
+      --progress-segment-size: 30%;
+      appearance: none;
+      border: 0 solid;
+      display: block;
+      inline-size: 100%;
+      block-size: 12px;
+      overflow: clip;
+      border-radius: 999px;
+      background: var(--secondary);
+      container-type: inline-size;
+    }
+
+    .process-progress::-webkit-progress-bar {
+      background: transparent;
+    }
+
+    .process-progress::-webkit-progress-value {
+      background: var(--progress-fill);
+      border-radius: 999px;
+      animation: var(--progress-animation);
+    }
+
+    .process-progress::-moz-progress-bar {
+      background: var(--progress-fill);
+      border-radius: 999px;
+      animation: var(--progress-animation);
+    }
+
+    .process-progress:indeterminate {
+      --progress-fill: #9a4b00;
+      --progress-animation: progress-sweep var(--progress-duration) infinite linear;
+    }
+
+    .process-progress:indeterminate:dir(rtl) {
+      --progress-animation: progress-sweep var(--progress-duration) infinite linear reverse;
+    }
+
+    @keyframes progress-sweep {
+      from, to {
+        inline-size: var(--progress-segment-size);
+        margin-right: auto;
+      }
+      from { translate: -100%; }
+      to { translate: 100cqi; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .process-progress {
+        --progress-duration: 10s;
+      }
+    }
+
     .grid {
