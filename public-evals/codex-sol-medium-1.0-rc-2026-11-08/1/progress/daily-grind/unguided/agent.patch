+    /* Order and rewards progress */
+    .progress-panel {
+      background: #fff;
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+      padding: clamp(20px, 4vw, 32px);
+      margin-bottom: 40px;
+      box-shadow: 0 4px 16px rgba(78, 52, 46, 0.05);
+    }
+
+    .progress-panel h2 {
+      font-size: 1.35rem;
+      margin-bottom: 4px;
+    }
+
+    .progress-intro,
+    .progress-help {
+      color: #725b53;
+      font-size: 0.9rem;
+    }
+
+    .progress-item {
+      margin-top: 24px;
+    }
+
+    .progress-labels {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      flex-wrap: wrap;
+      gap: 4px 16px;
+      margin-bottom: 8px;
+      font-size: 0.95rem;
+    }
+
+    .progress-value {
+      color: #725b53;
+      font-size: 0.85rem;
+    }
+
+    .progress-track {
+      height: 10px;
+      overflow: hidden;
+      border-radius: 999px;
+      background: #eee6e2;
+    }
+
+    .progress-fill {
+      display: block;
+      height: 100%;
+      border-radius: inherit;
+      background: var(--primary);
+    }
+
+    .progress-fill--rewards {
+      width: 60%;
+    }
+
+    .progress-track--indeterminate .progress-fill {
+      width: 35%;
+      background: #aa641c;
+      animation: brewing 1.8s ease-in-out infinite;
+    }
+
+    .progress-help {
+      margin-top: 8px;
+    }
+
+    @keyframes brewing {
+      0% { transform: translateX(-100%); }
+      100% { transform: translateX(286%); }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .progress-track--indeterminate .progress-fill {
+        animation: none;
+        margin-left: 32.5%;
+      }
+    }
+
     .grid {
