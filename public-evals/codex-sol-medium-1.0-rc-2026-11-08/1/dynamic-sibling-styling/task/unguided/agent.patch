+  <script>
+    // Keep the CSS fallback live, including collections inserted after load.
+    // Collections contain only their items so native sibling counts agree.
+    const collectionSelector = '.grid, .fan-container, .circle-container';
+    function updateCollections() {
+      document.querySelectorAll(collectionSelector).forEach(collection => {
+        const items = [...collection.children];
+        items.forEach((item, index) => {
+          item.style.setProperty('--fallback-index', index);
+          item.style.setProperty('--fallback-count', items.length);
+        });
+      });
+    }
+    updateCollections();
+    new MutationObserver(updateCollections).observe(document.querySelector('main'), {
+      childList: true,
+      subtree: true
+    });
+  </script>
+
