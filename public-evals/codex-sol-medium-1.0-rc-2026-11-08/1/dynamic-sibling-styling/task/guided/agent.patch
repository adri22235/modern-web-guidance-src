+  <script>
+    // Older browsers use the same CSS math with live, 1-based sibling values.
+    // Native browsers update automatically and never need this observer.
+    if (!CSS.supports('top: calc(sibling-index() * sibling-count() * 1px)')) {
+      const syncSiblings = () => {
+        document.querySelectorAll('.grid, .fan-container, .circle-container').forEach(group => {
+          const items = Array.from(group.children);
+          items.forEach((item, index) => {
+            item.style.setProperty('--sibling-index', index + 1);
+            item.style.setProperty('--sibling-count', items.length);
+          });
+        });
+      };
+      syncSiblings();
+      new MutationObserver(syncSiblings).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true
+      });
+    }
+  </script>
+
