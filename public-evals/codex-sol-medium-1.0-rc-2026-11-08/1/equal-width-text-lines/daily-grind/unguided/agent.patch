+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = heroHeading.querySelectorAll('.hero-heading-line span');
+
+    function fitHeadingLines() {
+      const width = heroHeading.getBoundingClientRect().width;
+      if (!width) return;
+
+      // Measure natural text widths, then change font size without altering spacing.
+      headingLines.forEach(line => { line.style.fontSize = '100px'; });
+      const sizes = Array.from(headingLines, line =>
+        100 * width / line.getBoundingClientRect().width
+      );
+      headingLines.forEach((line, index) => {
+        line.style.fontSize = `${sizes[index]}px`;
+      });
+    }
+
+    fitHeadingLines();
+    document.fonts.ready.then(fitHeadingLines);
+
+    let previousWidth = heroHeading.getBoundingClientRect().width;
+    new ResizeObserver(([entry]) => {
+      if (entry.contentRect.width !== previousWidth) {
+        previousWidth = entry.contentRect.width;
+        fitHeadingLines();
+      }
+    }).observe(heroHeading);
+  </script>
