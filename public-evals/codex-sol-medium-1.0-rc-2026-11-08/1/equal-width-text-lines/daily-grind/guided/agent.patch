+  <script>
+    // Fit the actual type in browsers without native per-line text fitting.
+    if (!CSS.supports('text-fit', 'grow per-line-all 1000%')) {
+      const heading = document.querySelector('.hero h1');
+      const lines = [...heading.children];
+      const fit = () => {
+        for (const line of lines) line.style.removeProperty('--text-fit-scale');
+        const width = heading.getBoundingClientRect().width;
+        const scales = lines.map(line => width / line.getBoundingClientRect().width);
+        lines.forEach((line, index) => {
+          line.style.setProperty('--text-fit-scale', scales[index]);
+        });
+      };
+
+      let previousWidth;
+      new ResizeObserver(([entry]) => {
+        if (entry.contentRect.width !== previousWidth) {
+          previousWidth = entry.contentRect.width;
+          fit();
+        }
+      }).observe(heading);
+      fit();
+      document.fonts.ready.then(fit);
+      document.fonts.addEventListener('loadingdone', fit);
+    }
+  </script>
