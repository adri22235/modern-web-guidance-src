+    #mixed-fonts-container code { font-family:'IBM Plex Mono',Consolas,monospace; font-size:1em; background:#edf2e8; color:#517149; padding:.08em .22em; border-radius:4px; letter-spacing:-.055em; }
+    .font-key { display:flex; gap:18px; font-size:.6rem; color:#92988d; margin-top:27px; }
+    .font-key span { display:flex; align-items:center; gap:6px; }
+    .key-square { width:6px; height:6px; background:#9eaa93; border-radius:1px; }
