+    @media (min-width:1500px) { main { padding-left:70px; padding-right:70px; } .intro { padding-top:60px; } .sample-area { min-height:270px; } }
+    @media (max-width:1100px) { .app { grid-template-columns:185px minmax(0,1fr); } aside { padding-inline:14px; } main { padding-inline:28px; } .specimens { grid-template-columns:1fr; } .sample-area { min-height:0; } .intro { align-items:flex-start; } }
+    @media (max-width:650px) { .app { display:block; } aside { padding:16px 20px; border-right:0; border-bottom:1px solid var(--line); } .brand { padding:0; } .nav-label,.sidebar-bottom { display:none; } nav { display:flex; margin-top:18px; gap:3px; flex-wrap:wrap; } nav a { padding:7px 10px; font-size:.7rem; } main { padding-inline:20px; } .intro { padding-top:30px; flex-direction:column; } .status { display:none; } .code-columns { grid-template-columns:1fr; } .code-columns pre + pre { border-left:0; border-top:1px solid var(--line); } footer { flex-direction:column; } .section-heading span { font-size:.6rem; } }
+  </style>
+</head>
+<body>
+<div class="app">
+  <aside aria-label="Main navigation">
+    <a class="brand" href="#" aria-label="Fontform home"><span class="brand-icon" aria-hidden="true">ff</span>fontform<span style="font-size:.7rem;color:#97a08d;align-self:flex-start">®</span></a>
+    <div class="nav-label">THE WORKSPACE</div>
+    <nav>
+      <a href="#playground" class="active"><span class="nav-icon" aria-hidden="true">Aa</span> Font playground</a>
+      <a href="#theme"><span class="nav-icon" aria-hidden="true">◐</span> Independent theme</a>
+      <a href="#implementation"><span class="nav-icon" aria-hidden="true">⌘</span> Implementation</a>
+    </nav>
+    <div class="sidebar-bottom"><div class="sidebar-note">Small details.<br>Better typography.</div><div class="version"><span class="dot"></span> FONTFORM / V.1.0</div></div>
+  </aside>
+  <main>
+    <header class="topbar"><div class="crumb">Workspace <span>/</span> <strong>Font playground</strong></div><span class="status"><span class="dot"></span> Built with modern CSS</span></header>
+    <section class="intro" id="playground">
+      <div><div class="eyebrow">THE TYPE EXPERIMENT / 001</div><h1>Different fonts.<br><span>Same visual rhythm.</span></h1><p>A little harmony for your type. Explore how font-size-adjust brings<br class="desktop-break"> mixed fonts into balance, automatically.</p></div>
+      <button class="outline-button" id="reset" type="button"><span aria-hidden="true">↺</span> Reset playground</button>
+    </section>
+    <div class="section-heading"><h2>Your type, in balance</h2><span>Two approaches. One consistent feel.</span></div>
+    <div class="specimens">
+      <section class="card" aria-labelledby="mixed-heading">
+        <div class="card-head"><div class="card-title"><span class="number">01</span><h2 id="mixed-heading">Mixed fonts</h2></div><span class="badge" id="auto-badge">Auto normalized</span></div>
+        <div class="sample-area"><div class="sample-label">THE EVERYDAY MIX</div><div id="mixed-fonts-container">Good design is in the details.<br>Even when you mix <code>inline code</code><br>with everyday words, everything<br>should feel like it belongs.</div><div class="font-key"><span><i class="key-square"></i> DM Sans · Regular</span><span><i class="key-square code"></i> IBM Plex Mono</span></div></div>
+        <div class="card-controls"><div class="control-row"><label for="normalize"><input id="normalize" class="switch" type="checkbox" checked> Normalize font height</label><span class="control-value" id="auto-value">from-font</span></div><div><div class="control-row"><label for="font-size">Font size</label></div><div class="range-control"><input id="font-size" type="range" min="16" max="32" value="23.2" step="0.1"><output id="size-output" for="font-size">23.2 px</output></div></div></div>
+      </section>
+      <section class="card theme-card" id="theme" aria-labelledby="theme-heading">
+        <div class="card-head"><div class="card-title"><span class="number">02</span><h2 id="theme-heading">Independent theme</h2></div><span class="badge">Fixed ratio</span></div>
+        <div class="sample-area"><div class="sample-label">A DIFFERENT PERSONALITY</div><div id="independent-theme-container">A new theme.<br>The same <em>harmony.</em><br>Distinct in character,<br>consistent in proportion.</div><div class="theme-caption">A fixed x-height. An independent point of view.</div></div>
+        <div class="card-controls"><div class="control-row"><label for="theme-font">Font family</label><select id="theme-font"><option value="Georgia">Georgia</option><option value="Times New Roman">Times New Roman</option><option value="Verdana">Verdana</option></select></div><div class="control-row" style="padding-block:7px"><span>Target x-height ratio</span><span class="metric-value">0.50 <span style="color:#809676">/ locked</span></span></div></div>
+      </section>
+    </div>
+    <div class="info"><span class="info-icon" aria-hidden="true">i</span><span><b>It's all about the x-height.</b> Fonts can share a size without looking the same size. <code>font-size-adjust</code> balances their perceived height so your typography feels consistent.</span></div>
+    <section id="implementation" aria-labelledby="implementation-heading">
+      <div class="section-heading"><h2 id="implementation-heading">A few lines. A noticeable difference.</h2><span>Native CSS. No dependencies.</span></div>
+      <div class="code-panel"><div class="code-top"><span class="file-name">◧ &nbsp; typography.css</span><button type="button" class="copy" id="copy"><span aria-hidden="true">▢</span><span id="copy-label" aria-live="polite">Copy CSS</span></button></div><div class="code-columns"><pre><code><span class="selector">#mixed-fonts-container</span> {
+  <span class="property">font-size-adjust:</span> <span class="value" id="code-auto">from-font</span>;
+}
+<span style="color:#a5ad9c">/* Automatically match font proportions */</span></code></pre><pre><code><span class="selector">#independent-theme-container</span> {
+  <span class="property">font-size-adjust:</span> <span class="value">0.5</span>;
+}
+<span style="color:#a5ad9c">/* Keep this theme's proportions consistent */</span></code></pre></div></div>
+    </section>
+    <footer><span>Made for the details that make a difference.</span><span>LESS FRICTION. MORE FONT HARMONY.</span></footer>
+  </main>
+</div>
+<script>
+  const mixed = document.querySelector('#mixed-fonts-container');
+  const normalize = document.querySelector('#normalize');
+  const size = document.querySelector('#font-size');
+  const family = document.querySelector('#theme-font');
+  function updateNormalization() {
+    const value = normalize.checked ? 'from-font' : 'none';
+    mixed.style.fontSizeAdjust = value;
+    document.querySelector('#auto-value').textContent = value;
+    document.querySelector('#code-auto').textContent = value;
+    document.querySelector('#auto-badge').textContent = normalize.checked ? 'Auto normalized' : 'Natural sizing';
+  }
+  normalize.addEventListener('change', updateNormalization);
+  size.addEventListener('input', () => {
+    mixed.style.fontSize = `${Number(size.value) / 16}rem`;
+    document.querySelector('#size-output').textContent = `${Number(size.value)} px`;
+  });
+  family.addEventListener('change', () => {
+    document.querySelector('#independent-theme-container').style.fontFamily = `"${family.value}", ${family.value === 'Verdana' ? 'sans-serif' : 'serif'}`;
+  });
+  document.querySelector('#reset').addEventListener('click', () => {
+    normalize.checked = true;
+    size.value = '23.2';
+    family.value = 'Georgia';
+    mixed.style.removeProperty('font-size');
+    document.querySelector('#independent-theme-container').style.removeProperty('font-family');
+    document.querySelector('#size-output').textContent = '23.2 px';
+    updateNormalization();
+  });
+  document.querySelector('#copy').addEventListener('click', async () => {
+    const label = document.querySelector('#copy-label');
+    const css = `#mixed-fonts-container {\n  font-size-adjust: ${normalize.checked ? 'from-font' : 'none'};\n}\n\n#independent-theme-container {\n  font-size-adjust: 0.5;\n}`;
+    try { await navigator.clipboard.writeText(css); label.textContent = 'Copied!'; }
+    catch { label.textContent = 'Select CSS to copy'; }
+    setTimeout(() => { label.textContent = 'Copy CSS'; }, 2200);
+  });
+  document.querySelectorAll('nav a').forEach(link => link.addEventListener('click', () => {
+    document.querySelectorAll('nav a').forEach(item => item.classList.toggle('active', item === link));
+  }));
+</script>
+</body>
+</html>
