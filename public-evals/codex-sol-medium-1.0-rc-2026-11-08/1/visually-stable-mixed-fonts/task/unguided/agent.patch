+        <div class="code-panel"><div class="code-heading"><span class="code-title">THE LITTLE LINE THAT CHANGES EVERYTHING</span><button class="copy" id="copy-css" aria-label="Copy CSS">▢ &nbsp; Copy CSS</button></div><pre><span class="selector">#mixed-fonts-container</span> {
+  <span class="property">font-size-adjust</span>: <span class="value" id="css-value">from-font</span>;
+}</pre></div>
+      </section>
+      <div class="lower-grid">
+        <section class="theme-card" id="theme"><div class="card-title"><h2>A theme of its own.</h2><span class="small-tag">Independent</span></div><p class="theme-description">A separate space, with its own typographic proportions.</p><div id="independent-theme-container"><p>A different voice. The same <code>balance</code>.</p></div><div class="theme-rule"><span>font-size-adjust: <strong>0.5</strong>;</span><span class="lock">♧ &nbsp; Fixed x-height ratio</span></div></section>
+        <section class="explanation" id="how-it-works"><div class="eyebrow">Behind the balance</div><h2>Good type plays well together.</h2><p><code>font-size-adjust</code> aligns fonts by their x-height, keeping text visually consistent. Use <code>from-font</code> to find the balance automatically, or a number to make it your own.</p><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener">Meet font-size-adjust <span>↗</span></a></section>
+      </div>
+      <footer><span>A small exploration of modern CSS. Built for better reading.</span><span class="footer-right"><i class="dot" id="support-dot"></i><span id="support-text">Checking browser support</span></span></footer>
+    </main>
+  </div>
+  <script>
+    const sample = document.getElementById('mixed-fonts-container');
+    const normalize = document.getElementById('normalize');
+    const textFont = document.getElementById('text-font');
+    const codeFont = document.getElementById('code-font');
+    const size = document.getElementById('font-size');
+    function currentCSS() {
+      return `#mixed-fonts-container {\n  font-family: ${textFont.value};\n  font-size: ${size.value}px;\n  font-size-adjust: ${normalize.checked ? 'from-font' : 'none'};\n}\n\n#mixed-fonts-container code {\n  font-family: ${codeFont.value};\n  font-size: 1em;\n}\n\n#independent-theme-container {\n  font-size-adjust: 0.5;\n}`;
+    }
+    function update() {
+      sample.style.fontFamily = textFont.value;
+      sample.style.fontSize = `${size.value}px`;
+      sample.style.fontSizeAdjust = normalize.checked ? 'from-font' : 'none';
+      sample.querySelectorAll('code').forEach(code => code.style.fontFamily = codeFont.value);
+      document.getElementById('size-value').textContent = `${size.value} px`;
+      document.getElementById('regular-legend').textContent = `${textFont.selectedOptions[0].text} · Regular`;
+      document.getElementById('code-legend').textContent = `${codeFont.selectedOptions[0].text} · Regular`;
+      document.getElementById('css-value').textContent = normalize.checked ? 'from-font' : 'none';
+      document.getElementById('adjust-badge').textContent = normalize.checked ? '↔  auto-adjusted' : '↔  original metrics';
+      document.getElementById('full-css').textContent = currentCSS();
+    }
+    [normalize, textFont, codeFont, size].forEach(control => control.addEventListener('input', update));
+    const tabs = [...document.querySelectorAll('[role="tab"]')];
+    function selectTab(tab) {
+      tabs.forEach(item => {
+        const active = item === tab;
+        item.classList.toggle('active', active);
+        item.setAttribute('aria-selected', active);
+        item.tabIndex = active ? 0 : -1;
+        document.getElementById(item.getAttribute('aria-controls')).hidden = !active;
+      });
+    }
+    tabs.forEach(tab => {
+      tab.addEventListener('click', () => selectTab(tab));
+      tab.addEventListener('keydown', event => {
+        if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          const next = event.key === 'Home' ? tabs[0] : event.key === 'End' ? tabs[1] : tabs.find(item => item !== tab);
+          selectTab(next); next.focus();
+        }
+      });
+    });
+    let copyTimer;
+    document.getElementById('copy-css').addEventListener('click', async event => {
+      const button = event.currentTarget;
+      try {
+        await navigator.clipboard.writeText(currentCSS());
+        button.textContent = '✓ Copied';
+      } catch {
+        selectTab(document.getElementById('css-tab'));
+        const selection = window.getSelection();
+        const range = document.createRange();
+        range.selectNodeContents(document.getElementById('full-css'));
+        selection.removeAllRanges(); selection.addRange(range);
+        button.textContent = 'Press Ctrl/Cmd+C';
+      }
+      clearTimeout(copyTimer);
+      copyTimer = setTimeout(() => button.textContent = '▢  Copy CSS', 2500);
+    });
+    const supported = CSS.supports('font-size-adjust', 'from-font');
+    document.getElementById('support-text').textContent = supported ? 'Supported in your browser' : 'Font adjustment unavailable in this browser';
+    if (!supported) document.getElementById('support-dot').style.background = '#bd8753';
+    update();
+  </script>
+</body>
