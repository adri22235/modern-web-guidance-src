+        <div class="toolbar"><div class="tabs" role="tablist" aria-label="Playground view"><button class="tab active" id="preview-tab" role="tab" aria-selected="true" aria-controls="preview-view">Preview</button><button class="tab" id="css-tab" role="tab" aria-selected="false" aria-controls="css-view" tabindex="-1">CSS</button></div><label class="toggle-label"><input type="checkbox" class="switch" id="normalize" checked> Normalize fonts</label></div>
+        <div class="preview-area">
+          <div class="preview-heading"><span class="mono-label">#mixed-fonts-container</span><span class="auto-badge" id="adjust-badge">↔ &nbsp; auto-adjusted</span></div>
