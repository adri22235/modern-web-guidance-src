@@ -0,0 +1,204 @@
+/* Later layers take priority; keep all author styles inside a layer. */
+@layer reset, tokens, base, layout, components;
+
+@layer reset {
+  /* Reset only the elements used by this page, with no specificity cost. */
+  :where(body, nav, header, main, section, footer, div, ul, li, h1, h2, h3, p, a) {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    --color-coffee: #4e342e;
+    --color-espresso: #3e2723;
+    --color-latte: #d7ccc8;
+    --color-amber: #ffab40;
+    --color-white: #fff;
+    --color-off-white: #fafafa;
+
+    --color-brand: var(--color-coffee);
+    --color-text: var(--color-espresso);
+    --color-surface: var(--color-off-white);
+    --color-card: var(--color-white);
+    --color-on-brand: var(--color-white);
+    --color-accent: var(--color-amber);
+    --color-footer: var(--color-latte);
+    --color-action-hover: var(--color-espresso);
+
+    --font-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --line-height-body: 1.6;
+
+    --space-xs: 0.3125rem;
+    --space-sm: 0.625rem;
+    --space-md: 1rem;
+    --space-lg: 1.25rem;
+    --space-xl: 2.5rem;
+    --space-action-offset: 0.9375rem;
+    --space-logout-inline: 0.75rem;
+
+    --radius-sm: 0.25rem;
+    --radius-action: 0.3125rem;
+    --radius-card: 0.5rem;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --duration-feedback: 0.3s;
+    --content-max: 68.75rem;
+    --card-min: 15.625rem;
+    --hero-min-block-size: 60vh;
+    --nav-gutter: 5%;
+    --layer-sticky: 10;
+    --hero-overlay: rgb(0 0 0 / 50%);
+    --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-surface);
+  }
+
+  :where(nav a, .btn, .footer-links a) {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-xl);
+    margin-inline: auto;
+    padding-inline: var(--space-lg);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
+    gap: var(--space-lg);
+    margin-block-start: var(--space-lg);
+  }
+
+  :where(.hero, .section-title, .card, footer) {
+    text-align: center;
+  }
+}
+
+@layer components {
+  /* Navigation: gap handles spacing in either writing direction. */
+  nav {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-sticky);
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-md) var(--space-lg);
+    padding-block: var(--space-md);
+    padding-inline: var(--nav-gutter);
+    color: var(--color-on-brand);
+    background: var(--color-brand);
+  }
+
+  .logo {
+    font-size: var(--font-size-logo);
+    font-weight: bold;
+    letter-spacing: 1px;
+  }
+
+  nav :where(ul) {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: var(--space-sm) var(--space-lg);
+    list-style: none;
+  }
+
+  nav :where(a) {
+    font-size: var(--font-size-nav);
+    transition: color var(--duration-feedback);
+  }
+
+  nav :where(a:is(:hover, :focus-visible)) {
+    color: var(--color-accent);
+  }
+
+  .logout-link {
+    border: 1px solid var(--color-accent);
+    padding-block: var(--space-xs);
+    padding-inline: var(--space-logout-inline);
+    border-radius: var(--radius-sm);
+  }
+
+  /* Minimum height lets the banner grow if its content needs more room. */
+  .hero {
+    min-block-size: var(--hero-min-block-size);
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    padding-inline: var(--space-lg);
+    color: var(--color-on-brand);
+    background-image: linear-gradient(var(--hero-overlay), var(--hero-overlay)), var(--hero-image);
+    background-size: cover;
+    background-position: center;
+  }
+
+  .hero :where(h1) {
+    font-size: var(--font-size-hero);
+    margin-block-end: var(--space-md);
+  }
+
+  .card {
+    padding-block: var(--space-lg);
+    padding-inline: var(--space-lg);
+    background: var(--color-card);
+    border-radius: var(--radius-card);
+    box-shadow: var(--shadow-card);
+  }
+
+  .card :where(h3) {
+    margin-block-end: var(--space-sm);
+    color: var(--color-brand);
+  }
+
+  .btn {
+    display: inline-block;
+    margin-block-start: var(--space-action-offset);
+    padding-block: var(--space-sm);
+    padding-inline: var(--space-lg);
+    border-radius: var(--radius-action);
+    color: var(--color-on-brand);
+    background: var(--color-brand);
+    transition: background-color var(--duration-feedback);
+  }
+
+  .btn:where(:hover, :focus-visible) {
+    background: var(--color-action-hover);
+  }
+
+  footer {
+    margin-block-start: var(--space-xl);
+    padding-block: var(--space-xl);
+    padding-inline: var(--space-lg);
+    background: var(--color-footer);
+  }
+
+  .footer-links {
+    margin-block-end: var(--space-lg);
+  }
+
+  .footer-links :where(a) {
+    margin-inline: var(--space-sm);
+    font-size: var(--font-size-small);
+  }
+}
