@@ -0,0 +1,81 @@
+import { readFile, writeFile, mkdir, cp, rm } from 'node:fs/promises';
+import { deflateSync } from 'node:zlib';
+import { getDomain } from 'tldts';
+
+export function validateConfig(config) {
+  const origins = [config.oldOrigin, config.newOrigin].map(value => {
+    const url = new URL(value);
+    if (url.protocol !== 'https:' || url.origin !== value) throw new Error('Use bare HTTPS origins without trailing slashes');
+    return url;
+  });
+  const domains = origins.map(url => getDomain(url.hostname, { allowPrivateDomains: true }));
+  if (!domains[0] || domains[0] !== domains[1] || origins[0].origin === origins[1].origin) {
+    throw new Error('Migration requires distinct origins on the same registrable domain');
+  }
+  for (const [id, origin] of [[config.oldId, config.oldOrigin], [config.newId, config.newOrigin]]) {
+    const url = new URL(id, origin);
+    if (typeof id !== 'string' || !id.startsWith('/') || url.origin !== origin || url.hash) throw new Error('App IDs must be same-origin absolute paths without fragments');
+  }
+  if (!Array.isArray(config.settingsKeys) || !config.settingsKeys.length || config.settingsKeys.length > 100 ||
+      config.settingsKeys.some(key => typeof key !== 'string' || !key.length || key.startsWith('daily-grind:migration:')) ||
+      new Set(config.settingsKeys).size !== config.settingsKeys.length) throw new Error('Configure a unique allowlist of settings keys');
+  return config;
+}
+
+// Small local app icon; no remote assets are needed for installation.
+function icon(size) {
+  function chunk(type, data) {
+    const payload = Buffer.concat([Buffer.from(type), data]);
+    let crc = 0xffffffff;
+    for (const byte of payload) {
+      crc ^= byte;
+      for (let i = 0; i < 8; i++) crc = (crc >>> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
+    }
+    const length = Buffer.alloc(4); length.writeUInt32BE(data.length);
+    const checksum = Buffer.alloc(4); checksum.writeUInt32BE((crc ^ 0xffffffff) >>> 0);
+    return Buffer.concat([length, payload, checksum]);
+  }
+  const pixels = Buffer.alloc(size * (1 + size * 3));
+  for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {
+    const px = x / size, py = y / size;
+    const cup = px > .25 && px < .64 && py > .35 && py < .7;
+    const handle = ((px - .65) ** 2 + (py - .49) ** 2 < .11 ** 2) &&
+      ((px - .65) ** 2 + (py - .49) ** 2 > .065 ** 2);
+    const saucer = px > .2 && px < .78 && py > .74 && py < .78;
+    pixels.set(cup || handle || saucer ? [255, 243, 224] : [78, 52, 46], y * (1 + size * 3) + 1 + x * 3);
+  }
+  const header = Buffer.alloc(13);
+  header.writeUInt32BE(size, 0); header.writeUInt32BE(size, 4); header[8] = 8; header[9] = 2;
+  return Buffer.concat([Buffer.from([137,80,78,71,13,10,26,10]), chunk('IHDR', header), chunk('IDAT', deflateSync(pixels)), chunk('IEND', Buffer.alloc(0))]);
+}
+
+export async function build() {
+  const config = validateConfig(JSON.parse(await readFile('migration.config.json', 'utf8')));
+  await rm('dist', { recursive: true, force: true });
+  const oldId = new URL(config.oldId, config.oldOrigin).href;
+  const newId = new URL(config.newId, config.newOrigin).href;
+  for (const side of ['old', 'new']) {
+    const dir = `dist/${side}`;
+    await mkdir(`${dir}/.well-known`, { recursive: true });
+    await cp('index.html', `${dir}/index.html`);
+    await cp('migration', `${dir}/migration`, { recursive: true });
+    await writeFile(`${dir}/migration.config.json`, JSON.stringify(config, null, 2));
+    const manifest = {
+      name: 'The Daily Grind', short_name: 'Daily Grind',
+      id: side === 'old' ? config.oldId : config.newId,
+      start_url: '/', scope: '/', display: 'standalone',
+      background_color: '#fafafa', theme_color: '#4e342e',
+      icons: [192, 512].map(size => ({ src: `/icon-${size}.png`, sizes: `${size}x${size}`, type: 'image/png' })),
+      ...(side === 'old' ? { migrate_to: { id: newId, install_url: config.newOrigin + '/' } } :
+        { migrate_from: [{ id: oldId, install_url: config.oldOrigin + '/', behavior: 'suggest' }] })
+    };
+    await writeFile(`${dir}/manifest.webmanifest`, JSON.stringify(manifest, null, 2));
+    for (const size of [192, 512]) await writeFile(`${dir}/icon-${size}.png`, icon(size));
+    // These headers must also be configured in the deployment platform if it does not read _headers.
+    await writeFile(`${dir}/_headers`, `/migration/bridge.html\n  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors ${config.newOrigin}\n  Cache-Control: no-store\n/migration.config.json\n  Cache-Control: no-store\n/manifest.webmanifest\n  Cache-Control: no-cache\n/.well-known/web-app-origin-association\n  Content-Type: application/json\n  Cache-Control: no-cache\n`);
+    if (side === 'old') await writeFile(`${dir}/.well-known/web-app-origin-association`, JSON.stringify({ [newId]: { allow_migration: true } }, null, 2));
+  }
+  console.log('Built dist/old and dist/new. Deploy each directory to its configured HTTPS origin.');
+}
+
+if (process.argv[1] && import.meta.url === new URL(process.argv[1], 'file:').href) await build();
diff --git a/test/migration.test.js b/test/migration.test.js
