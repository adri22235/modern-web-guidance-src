index 0000000..042d305
--- /dev/null
+++ b/test/migration.test.js
@@ -0,0 +1,95 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { build, validateConfig } from '../scripts/build.mjs';
+import { sameOrigin, trustedMessage, readSettings, importSettings, MAX_VALUE_LENGTH } from '../migration/shared.js';
+
+const config = JSON.parse(await readFile('migration.config.json', 'utf8'));
+function storage(initial = {}) {
+  const values = new Map(Object.entries(initial));
+  return { getItem: key => values.get(key) ?? null, setItem: (key, value) => values.set(key, value), values };
+}
+
+test('configuration requires HTTPS and PSL-aware same-site origins', () => {
+  assert.equal(validateConfig(config), config);
+  for (const newOrigin of ['http://order.dailygrind.example', 'https://different.example', config.oldOrigin]) {
+    assert.throws(() => validateConfig({ ...config, newOrigin }));
+  }
+  assert.throws(() => validateConfig({ ...config, oldOrigin: 'https://one.github.io', newOrigin: 'https://two.github.io' }));
+  assert.throws(() => validateConfig({ ...config, oldOrigin: 'https://one.co.uk', newOrigin: 'https://two.co.uk' }));
+  assert.throws(() => validateConfig({ ...config, oldId: '//attacker.example/' }));
+  assert.throws(() => validateConfig({ ...config, settingsKeys: ['settings', 'settings'] }));
+});
+
+test('message boundaries require exact origin and exact sending window', () => {
+  const peer = {};
+  assert.ok(sameOrigin(config.oldOrigin + ':443/', config.oldOrigin));
+  assert.ok(trustedMessage({ source: peer, origin: config.oldOrigin }, peer, config.oldOrigin));
+  for (const origin of ['null', 'invalid', 'http://app.dailygrind.example', 'https://app.dailygrind.example.attacker.com', config.newOrigin]) {
+    assert.equal(trustedMessage({ source: peer, origin }, peer, config.oldOrigin), false);
+  }
+  assert.equal(trustedMessage({ source: {}, origin: config.oldOrigin }, peer, config.oldOrigin), false);
+  assert.equal(trustedMessage({ source: null, origin: config.oldOrigin }, null, config.oldOrigin), false);
+});
+
+test('Origin API path rejects malformed input and uses structured equality', () => {
+  globalThis.Origin = { from(value) { const url = new URL(value); return { isSameOrigin: other => url.origin === other.origin, origin: url.origin }; } };
+  try {
+    assert.ok(sameOrigin(config.oldOrigin, config.oldOrigin));
+    assert.equal(sameOrigin('null', config.oldOrigin), false);
+    assert.equal(sameOrigin(config.newOrigin, config.oldOrigin), false);
+  } finally { delete globalThis.Origin; }
+});
+
+test('copy only allowlisted settings without overwriting current values or deleting source', () => {
+  const source = storage({ settings: '{"theme":"dark"}', token: 'secret', empty: '' });
+  const entries = readSettings(source, ['settings', 'empty', 'missing']);
+  assert.deepEqual(entries, [['settings', '{"theme":"dark"}'], ['empty', '']]);
+  const destination = storage({ settings: '{"theme":"light"}' });
+  importSettings(destination, ['settings', 'empty'], entries);
+  assert.equal(destination.getItem('settings'), '{"theme":"light"}');
+  assert.equal(destination.getItem('empty'), '');
+  assert.equal(destination.getItem('token'), null);
+  assert.equal(source.getItem('settings'), '{"theme":"dark"}');
+});
+
+test('malformed or oversized payloads are rejected before writing', () => {
+  const destination = storage();
+  for (const entries of [null, [['token', 'secret']], [['settings', {}]], [['settings', 'x'.repeat(MAX_VALUE_LENGTH + 1)]], [['settings', 'ok'], ['empty']], [['settings', 'a'], ['settings', 'b']]]) {
+    assert.throws(() => importSettings(destination, ['settings', 'empty'], entries));
+    assert.equal(destination.values.size, 0);
+  }
+  assert.throws(() => readSettings(storage({ settings: 'x'.repeat(MAX_VALUE_LENGTH + 1) }), ['settings']));
+});
+
+test('a failed storage write can be retried without clobbering earlier settings', () => {
+  const destination = storage();
+  const set = destination.setItem;
+  destination.setItem = (key, value) => { if (key === 'second') throw new Error('quota'); set(key, value); };
+  const entries = [['first', 'a'], ['second', 'b']];
+  assert.throws(() => importSettings(destination, ['first', 'second'], entries));
+  destination.setItem = set;
+  importSettings(destination, ['first', 'second'], entries);
+  assert.equal(destination.getItem('first'), 'a');
+  assert.equal(destination.getItem('second'), 'b');
+});
+
+test('built manifests and authorization agree on exact app identities', async () => {
+  await build();
+  const json = async path => JSON.parse(await readFile(path, 'utf8'));
+  const old = await json('dist/old/manifest.webmanifest');
+  const next = await json('dist/new/manifest.webmanifest');
+  const association = await json('dist/old/.well-known/web-app-origin-association');
+  assert.equal(old.migrate_to.id, new URL(next.id, config.newOrigin).href);
+  assert.equal(next.migrate_from[0].id, new URL(old.id, config.oldOrigin).href);
+  assert.equal(next.migrate_from[0].behavior, 'suggest');
+  assert.equal(association[old.migrate_to.id].allow_migration, true);
+  for (const side of ['old', 'new']) {
+    assert.match(await readFile(`dist/${side}/index.html`, 'utf8'), /rel="manifest"/);
+    for (const size of [192, 512]) {
+      const png = await readFile(`dist/${side}/icon-${size}.png`);
+      assert.equal(png.readUInt32BE(16), size);
+      assert.equal(png.readUInt32BE(20), size);
+    }
+  }
+});
