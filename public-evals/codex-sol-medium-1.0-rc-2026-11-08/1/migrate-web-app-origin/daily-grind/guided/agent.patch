+import { loadConfig, sameOrigin, trustedMessage, importSettings, REQUEST, RESPONSE } from './shared.js';
+
+function notice(message) {
+  const element = document.createElement('aside');
+  element.className = 'migration-notice';
+  element.setAttribute('aria-label', 'App update');
+  element.setAttribute('role', 'status');
+  element.textContent = message;
+  document.body.prepend(element);
+  return element;
+}
+
+async function start() {
+  const config = await loadConfig();
+  if (sameOrigin(location.origin, config.oldOrigin)) {
+    const banner = notice('The Daily Grind has a new home. Open it to transfer your saved preferences. ');
+    const link = document.createElement('a');
+    link.href = config.newOrigin + '/';
+    link.textContent = 'Continue to the new app';
+    banner.append(link, document.createElement('br'),
+      'If an app update is offered, accept it to keep your shortcuts. Otherwise, install the new app from your browser menu; keep the old app until your preferences have transferred.');
+    return;
+  }
+  if (!sameOrigin(location.origin, config.newOrigin)) return;
+
+  const marker = `daily-grind:migration:v1:${config.oldOrigin}:${config.oldId}`;
+  try { if (localStorage.getItem(marker) === 'complete') return; } catch { /* Show recoverable failure below. */ }
+  const banner = notice('Transferring your Daily Grind preferences…');
+  const frame = document.createElement('iframe');
+  frame.hidden = true;
+  frame.title = 'Transfer saved preferences from the previous app';
+  frame.referrerPolicy = 'no-referrer';
+  const nonce = crypto.randomUUID();
+  let finished = false;
+  const finish = error => {
+    if (finished) return;
+    finished = true;
+    clearTimeout(timer);
+    window.removeEventListener('message', receive);
+    frame.remove();
+    if (error) {
+      banner.textContent = 'Your preferences could not be transferred. Keep the old app and allow site storage for both addresses, then retry. ';
+      const retry = document.createElement('button');
+      retry.type = 'button';
+      retry.textContent = 'Retry transfer';
+      retry.addEventListener('click', () => { banner.remove(); start().catch(console.error); }, { once: true });
+      banner.append(retry);
+    } else {
+      banner.textContent = 'Your saved preferences are ready. If your browser offers an app update, accept it to keep your shortcuts. Otherwise, install this app from your browser menu.';
+      window.dispatchEvent(new CustomEvent('daily-grind:settings-migrated'));
+    }
+  };
+  function receive(event) {
+    if (!trustedMessage(event, frame.contentWindow, config.oldOrigin)) return;
+    if (event.data?.type === 'daily-grind:bridge-ready:v1') {
+      frame.contentWindow.postMessage({ type: REQUEST, nonce }, config.oldOrigin);
+      return;
+    }
+    if (event.data?.type !== RESPONSE || event.data.nonce !== nonce) return;
+    try {
+      if (event.data.error) throw new Error('Source storage unavailable');
+      importSettings(localStorage, config.settingsKeys, event.data.entries);
+      localStorage.setItem(marker, 'complete');
+      finish(false);
+    } catch { finish(true); }
+  }
+  const timer = setTimeout(() => finish(true), 10000);
+  window.addEventListener('message', receive);
+  frame.src = config.oldOrigin + '/migration/bridge.html';
+  document.body.append(frame);
+}
+
+start().catch(error => {
+  console.error('App migration unavailable', error);
+});
diff --git a/migration/shared.js b/migration/shared.js
new file mode 100644
index 0000000..cd91313
--- /dev/null
+++ b/migration/shared.js
@@ -0,0 +1,52 @@
+export const REQUEST = 'daily-grind:settings-request:v1';
+export const RESPONSE = 'daily-grind:settings-response:v1';
+export const MAX_VALUE_LENGTH = 64 * 1024;
+
+// Exact origin boundaries, never same-site privileges for messages.
+export function sameOrigin(candidate, trusted) {
+  try {
+    if ('Origin' in globalThis) {
+      return Origin.from(candidate).isSameOrigin(Origin.from(trusted));
+    }
+    const url = new URL(candidate);
+    return url.origin !== 'null' && url.origin === new URL(trusted).origin;
+  } catch {
+    return false;
+  }
+}
+
+export async function loadConfig() {
+  const response = await fetch('/migration.config.json', { cache: 'no-store' });
+  if (!response.ok) throw new Error('Migration configuration unavailable');
+  return response.json();
+}
+
+export function trustedMessage(event, peerWindow, trustedOrigin) {
+  return peerWindow != null && event.source === peerWindow && sameOrigin(event.origin, trustedOrigin);
+}
+
+export function readSettings(storage, keys) {
+  return keys.flatMap(key => {
+    const value = storage.getItem(key);
+    if (value === null) return [];
+    if (value.length > MAX_VALUE_LENGTH) throw new Error('Setting too large');
+    return [[key, value]];
+  });
+}
+
+export function importSettings(storage, keys, entries) {
+  if (!Array.isArray(entries) || entries.length > keys.length) throw new Error('Invalid settings');
+  const seen = new Set();
+  for (const entry of entries) {
+    if (!Array.isArray(entry) || entry.length !== 2) throw new Error('Invalid setting');
+    const [key, value] = entry;
+    if (!keys.includes(key) || seen.has(key) || typeof value !== 'string' || value.length > MAX_VALUE_LENGTH) {
+      throw new Error('Invalid setting');
+    }
+    seen.add(key);
+  }
+  // Retrying after an interrupted write is safe; newer destination values win.
+  for (const [key, value] of entries) {
+    if (storage.getItem(key) === null) storage.setItem(key, value);
+  }
+}
