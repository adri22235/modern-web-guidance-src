+import { loadConfig, sameOrigin, trustedMessage, readSettings, REQUEST, RESPONSE } from './shared.js';
+
+const config = await loadConfig();
+if (sameOrigin(location.origin, config.oldOrigin) && parent !== window) {
+  window.addEventListener('message', event => {
+    if (!trustedMessage(event, parent, config.newOrigin)) return;
+    if (event.data?.type !== REQUEST || typeof event.data.nonce !== 'string' || event.data.nonce.length !== 36) return;
+    const reply = { type: RESPONSE, nonce: event.data.nonce };
+    try {
+      reply.entries = readSettings(localStorage, config.settingsKeys);
+    } catch {
+      reply.error = true;
+    }
+    parent.postMessage(reply, config.newOrigin);
+  });
+  parent.postMessage({ type: 'daily-grind:bridge-ready:v1' }, config.newOrigin);
+}
