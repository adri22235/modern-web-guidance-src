diff --git a/migration/transfer.js b/migration/transfer.js
new file mode 100644
index 0000000..2fce7d1
--- /dev/null
+++ b/migration/transfer.js
@@ -0,0 +1,79 @@
+/* Only explicitly configured preferences cross origins; never cookies or IndexedDB. */
+(async () => {
+  const response = await fetch('/migration/config.json', { cache: 'no-store' });
+  if (!response.ok) return;
+  const config = await response.json();
+  const marker = 'daily-grind:migration-complete';
+  if (location.origin === config.oldOrigin) {
+    if (parent !== window && location.pathname === '/migration/source.html') {
+      addEventListener('message', event => {
+        if (event.origin !== config.newOrigin || event.source !== parent ||
+            event.data?.type !== 'daily-grind:request-settings' || typeof event.data.nonce !== 'string') return;
+        try {
+          const values = config.storageKeys.map(key => [key, localStorage.getItem(key)]);
+          parent.postMessage({ type: 'daily-grind:settings', nonce: event.data.nonce, values }, config.newOrigin);
+        } catch {
+          parent.postMessage({ type: 'daily-grind:settings-error', nonce: event.data.nonce }, config.newOrigin);
+        }
+      });
+      parent.postMessage({ type: 'daily-grind:ready' }, config.newOrigin);
+    } else if (parent === window) {
+      const notice = document.createElement('aside');
+      notice.setAttribute('aria-label', 'App address update');
+      notice.style.cssText = 'padding:12px 5%;background:#fff3e0;color:#3e2723;text-align:center';
+      notice.append('The Daily Grind has a new address. ');
+      const link = document.createElement('a');
+      link.href = new URL(config.newInstallPath, config.newOrigin).href;
+      link.textContent = 'Continue to our new site';
+      notice.append(link);
+      document.body.prepend(notice);
+    }
+    return;
+  }
+  if (location.origin !== config.newOrigin || parent !== window || localStorage.getItem(marker) === config.oldOrigin) return;
+  const frame = document.createElement('iframe');
+  frame.hidden = true;
+  frame.title = 'Transfer your Daily Grind preferences';
+  frame.referrerPolicy = 'no-referrer';
+  frame.src = new URL('/migration/source.html', config.oldOrigin).href;
+  const nonce = crypto.randomUUID();
+  let timer;
+  function cleanup() {
+    clearTimeout(timer);
+    removeEventListener('message', receive);
+    frame.remove();
+  }
+  function receive(event) {
+    if (event.origin !== config.oldOrigin || event.source !== frame.contentWindow) return;
+    if (event.data?.type === 'daily-grind:ready') {
+      frame.contentWindow.postMessage({ type: 'daily-grind:request-settings', nonce }, config.oldOrigin);
+      return;
+    }
+    if (event.data?.nonce !== nonce) return;
+    if (event.data.type === 'daily-grind:settings-error') { cleanup(); return; }
+    if (event.data.type !== 'daily-grind:settings' || !Array.isArray(event.data.values)) return;
+    const values = event.data.values;
+    if (values.length !== config.storageKeys.length || new Set(values.map(pair => pair?.[0])).size !== values.length ||
+        values.some(pair => !Array.isArray(pair) || pair.length !== 2 || !config.storageKeys.includes(pair[0]) ||
+          (pair[1] !== null && typeof pair[1] !== 'string'))) return;
+    const written = [];
+    try {
+      for (const [key, value] of values) {
+        // Preferences already chosen at the new origin take precedence.
+        if (value !== null && localStorage.getItem(key) === null) {
+          localStorage.setItem(key, value);
+          written.push(key);
+        }
+      }
+      localStorage.setItem(marker, config.oldOrigin);
+      dispatchEvent(new CustomEvent('daily-grind:settings-migrated'));
+    } catch {
+      // Leave the old origin untouched and allow a retry on the next visit.
+      for (const key of written) localStorage.removeItem(key);
+    }
+    cleanup();
+  }
+  addEventListener('message', receive);
+  timer = setTimeout(cleanup, 15000);
+  document.body.append(frame);
+})().catch(error => console.warn('Daily Grind settings transfer unavailable:', error));
