diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..8ae969d
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,65 @@
+import { readFile, mkdir, writeFile, rm, copyFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve, join } from 'node:path';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const config = JSON.parse(await readFile(resolve(root, process.env.MIGRATION_CONFIG || 'migration/config.json'), 'utf8'));
+for (const key of ['oldOrigin', 'newOrigin']) {
+  const url = new URL(config[key]);
+  if (url.protocol !== 'https:' || url.origin !== config[key]) throw new Error(`${key} must be an HTTPS origin without a trailing slash`);
+  if (url.hostname.endsWith('.example')) throw new Error('Set real origins in MIGRATION_CONFIG before building');
+}
+if (config.oldOrigin === config.newOrigin) throw new Error('Migration requires different origins');
+for (const key of ['oldId', 'newId', 'oldInstallPath', 'newInstallPath']) {
+  if (typeof config[key] !== 'string' || !config[key].startsWith('/') || config[key].startsWith('//') ||
+      new URL(config[key], config[key.startsWith('old') ? 'oldOrigin' : 'newOrigin']).origin !== config[key.startsWith('old') ? 'oldOrigin' : 'newOrigin']) {
+    throw new Error(`${key} must be an origin-relative path`);
+  }
+}
+if (!Array.isArray(config.storageKeys) || config.storageKeys.some(key => typeof key !== 'string' || !key || key === 'daily-grind:migration-complete')) {
+  throw new Error('storageKeys must be an explicit list of configuration keys');
+}
+// The browser validates same-site status using its Public Suffix List. Do not
+// approximate that security check by comparing the last two hostname labels.
+const html = await readFile(join(root, 'index.html'), 'utf8');
+const baseManifest = {
+  name: 'The Daily Grind', short_name: 'Daily Grind', start_url: '/', scope: '/',
+  display: 'standalone', background_color: '#fafafa', theme_color: '#4e342e',
+  icons: [{ src: '/migration/icon.svg', sizes: 'any', type: 'image/svg+xml', purpose: 'any' }],
+  shortcuts: [
+    { name: 'Order coffee', url: '/order-online' },
+    { name: 'My account', url: '/account' },
+  ],
+};
+const manifests = {
+  old: { ...baseManifest, id: config.oldId, start_url: config.oldInstallPath,
+    migrate_to: [{ id: new URL(config.newId, config.newOrigin).href, install_url: new URL(config.newInstallPath, config.newOrigin).href }] },
+  new: { ...baseManifest, id: config.newId, start_url: config.newInstallPath,
+    migrate_from: [{ id: new URL(config.oldId, config.oldOrigin).href, install_url: new URL(config.oldInstallPath, config.oldOrigin).href }] },
+};
+const output = join(root, 'dist');
+await rm(output, { recursive: true, force: true });
+for (const side of ['old', 'new']) {
+  const dir = join(output, side);
+  await mkdir(join(dir, 'migration'), { recursive: true });
+  await writeFile(join(dir, 'index.html'), html);
+  for (const path of [config[`${side}InstallPath`]]) {
+    const pathname = new URL(path, config[`${side}Origin`]).pathname;
+    if (pathname !== '/') {
+      const target = join(dir, pathname.endsWith('/') ? `${pathname}index.html` : pathname);
+      if (target === dir || !target.startsWith(dir + '/')) throw new Error('Invalid install path');
+      await mkdir(resolve(target, '..'), { recursive: true });
+      await writeFile(target, html);
+    }
+  }
+  await writeFile(join(dir, 'manifest.webmanifest'), JSON.stringify(manifests[side], null, 2) + '\n');
+  await writeFile(join(dir, 'migration/config.json'), JSON.stringify(config) + '\n');
+  for (const file of ['transfer.js', 'source.html', 'icon.svg']) {
+    await copyFile(join(root, 'migration', file), join(dir, 'migration', file));
+  }
+}
+await mkdir(join(output, 'old/.well-known'), { recursive: true });
+await writeFile(join(output, 'old/.well-known/web-app-origin-association'), JSON.stringify({
+  [config.newOrigin]: { allow_migration: true },
+}, null, 2) + '\n');
+console.log('Built dist/old and dist/new. Deploy each directory to its configured origin.');
diff --git a/test/migration.test.mjs b/test/migration.test.mjs
new file mode 100644
index 0000000..a581f30
--- /dev/null
+++ b/test/migration.test.mjs
@@ -0,0 +1,125 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, readFile, writeFile, mkdir, copyFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { execFileSync } from 'node:child_process';
+import vm from 'node:vm';
+
+const root = new URL('../', import.meta.url);
+const config = {
+  oldOrigin: 'https://coffee.example.com', newOrigin: 'https://app.example.com',
+  oldId: '/?installed=true', newId: '/', oldInstallPath: '/', newInstallPath: '/',
+  storageKeys: ['settings', 'preferences'],
+};
+
+test('build produces reciprocal identities, authorization and both install pages', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'daily-grind-'));
+  try {
+    await mkdir(join(dir, 'scripts'));
+    await mkdir(join(dir, 'migration'));
+    for (const file of ['scripts/build.mjs', 'index.html', 'migration/transfer.js', 'migration/source.html', 'migration/icon.svg']) {
+      await copyFile(new URL(file, root), join(dir, file));
+    }
+    const configPath = join(dir, 'config.json');
+    await writeFile(configPath, JSON.stringify(config));
+    const build = () => execFileSync(process.execPath, [join(dir, 'scripts/build.mjs')], {
+      env: { ...process.env, MIGRATION_CONFIG: configPath }, stdio: 'pipe',
+    });
+    build();
+    const json = async path => JSON.parse(await readFile(join(dir, path), 'utf8'));
+    const old = await json('dist/old/manifest.webmanifest');
+    const next = await json('dist/new/manifest.webmanifest');
+    assert.equal(old.id, config.oldId);
+    assert.equal(old.migrate_to[0].id, config.newOrigin + '/');
+    assert.equal(next.migrate_from[0].id, config.oldOrigin + config.oldId);
+    assert.equal(next.migrate_from[0].install_url, config.oldOrigin + '/');
+    assert.deepEqual(await json('dist/old/.well-known/web-app-origin-association'), {
+      [config.newOrigin]: { allow_migration: true },
+    });
+    for (const side of ['old', 'new']) {
+      assert.match(await readFile(join(dir, `dist/${side}/index.html`), 'utf8'), /rel="manifest"/);
+      assert.match(await readFile(join(dir, `dist/${side}/migration/source.html`), 'utf8'), /transfer.js/);
+    }
+    for (const invalid of [
+      { oldOrigin: 'http://coffee.example.com' },
+      { newOrigin: config.oldOrigin },
+      { oldOrigin: 'https://dailygrind.example' },
+      { newId: '//attacker.example.com/' },
+      { storageKeys: ['daily-grind:migration-complete'] },
+    ]) {
+      await writeFile(configPath, JSON.stringify({ ...config, ...invalid }));
+      assert.throws(build);
+    }
+  } finally { await rm(dir, { recursive: true, force: true }); }
+});
+
+const script = await readFile(new URL('migration/transfer.js', root), 'utf8');
+async function browser({ source = false, entries = [], deniedKey } = {}) {
+  const storage = new Map(entries);
+  const handlers = new Map();
+  const messages = [];
+  const events = [];
+  const peer = { postMessage: (...args) => messages.push(args) };
+  const frame = { contentWindow: peer, remove() { this.removed = true; } };
+  const window = {};
+  const context = {
+    fetch: async () => ({ ok: true, json: async () => config }),
+    location: { origin: source ? config.oldOrigin : config.newOrigin, pathname: source ? '/migration/source.html' : '/' },
+    window, parent: source ? peer : window,
+    localStorage: {
+      getItem: key => storage.get(key) ?? null,
+      setItem: (key, value) => { if (key === deniedKey) throw new Error('quota'); storage.set(key, value); },
+      removeItem: key => storage.delete(key),
+    },
+    document: { createElement: () => frame, body: { append() {} } },
+    crypto: { randomUUID: () => 'test-nonce' }, URL, console,
+    addEventListener: (name, fn) => handlers.set(name, fn),
+    removeEventListener: name => handlers.delete(name),
+    setTimeout: () => 1, clearTimeout() {},
+    CustomEvent: class { constructor(type) { this.type = type; } },
+    dispatchEvent: event => events.push(event.type),
+  };
+  await vm.runInNewContext(script, context);
+  const send = (data, origin = source ? config.newOrigin : config.oldOrigin, eventSource = peer) =>
+    handlers.get('message')?.({ data, origin, source: eventSource });
+  return { storage, messages, events, peer, send, frame };
+}
+
+test('source only exports allowlisted settings to the authorized parent', async () => {
+  const app = await browser({ source: true, entries: [['settings', '{"theme":"dark"}'], ['token', 'secret']] });
+  const request = { type: 'daily-grind:request-settings', nonce: 'abc' };
+  app.send(request, 'https://attacker.example.com');
+  app.send(request, config.newOrigin, {});
+  assert.equal(app.messages.length, 1); // ready only
+  app.send(request);
+  assert.equal(app.messages.length, 2);
+  assert.deepEqual(JSON.parse(JSON.stringify(app.messages[1])), [{
+    type: 'daily-grind:settings', nonce: 'abc', values: [['settings', '{"theme":"dark"}'], ['preferences', null]],
+  }, config.newOrigin]);
+});
+
+test('destination authenticates replies and preserves destination choices', async () => {
+  const app = await browser({ entries: [['settings', 'new-choice']] });
+  const reply = { type: 'daily-grind:settings', nonce: 'test-nonce', values: [['settings', 'old-choice'], ['preferences', 'old-preferences']] };
+  app.send(reply, 'https://attacker.example.com');
+  app.send(reply, config.oldOrigin, {});
+  app.send({ ...reply, nonce: 'incorrect' });
+  app.send({ ...reply, values: [['token', 'secret'], ['preferences', null]] });
+  assert.equal(app.storage.size, 1);
+  app.send({ type: 'daily-grind:ready' });
+  assert.equal(app.messages[0][1], config.oldOrigin);
+  app.send(reply);
+  assert.equal(app.storage.get('settings'), 'new-choice');
+  assert.equal(app.storage.get('preferences'), 'old-preferences');
+  assert.equal(app.storage.get('daily-grind:migration-complete'), config.oldOrigin);
+  assert.deepEqual(app.events, ['daily-grind:settings-migrated']);
+  assert.equal(app.frame.removed, true);
+});
+
+test('failed writes roll back partial imports without marking completion', async () => {
+  const app = await browser({ deniedKey: 'preferences' });
+  app.send({ type: 'daily-grind:settings', nonce: 'test-nonce', values: [['settings', 'old-settings'], ['preferences', 'old-preferences']] });
+  assert.equal(app.storage.size, 0);
+  assert.equal(app.events.length, 0);
+});
