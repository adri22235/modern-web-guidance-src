+      align-items: start;
+      gap: 36px;
+      margin-block-start: 24px;
+    }
+
+    .nested-curve-parent {
+      --card-radius: 32px;
+      --card-padding: 16px;
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      background: var(--secondary);
+      overflow: hidden;
+    }
+
+    /* Match the inner curve even without content-box clip-margin support. */
+    .nested-curve-content {
+      overflow: hidden;
+      border-radius: calc(var(--card-radius) - var(--card-padding));
+    }
+
+    .showcase-photo {
+      display: block;
+      inline-size: 100%;
+      block-size: 200px;
+      object-fit: cover;
+    }
+
+    .nested-curve-footer {
+      padding: 24px;
+      background: white;
+    }
+
+    .showcase-eyebrow {
+      display: block;
+      margin-block-end: 8px;
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      text-transform: uppercase;
+    }
+
+    .showcase h3 {
+      font-size: 1.5rem;
+      margin-block-end: 8px;
+    }
+
+    .safety-zone-parent {
+      min-inline-size: 0;
+      padding: 28px 28px 0;
+      border-radius: 32px 32px 12px 12px;
+      color: white;
+      background: var(--primary);
+      /* Preserve the glow in browsers without overflow-clip-margin. */
+      overflow: visible;
+    }
+
+    .promo-copy {
+      overflow: hidden;
+      border-radius: 4px;
+    }
+
+    .promo-ribbon {
+      inline-size: max-content;
+      margin-block: 24px 12px;
+      color: var(--secondary);
+      font-size: 2.5rem;
+      font-weight: 800;
+      letter-spacing: 0.04em;
+      white-space: nowrap;
+    }
+
+    .promo-button {
+      display: block;
+      margin-block-start: 24px;
+      text-align: center;
+      border-radius: 8px;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 700;
+      box-shadow: 0 0 16px 3px rgb(255 171 64 / 60%);
+    }
+
+    .promo-button:hover {
+      background: #ffc36e;
+    }
+
+    .promo-button:focus-visible {
+      outline: 3px solid white;
+      outline-offset: 4px;
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+
+      .nested-curve-content {
+        overflow: visible;
+        border-radius: 0;
+      }
+    }
+
+    @supports (overflow: clip) and (overflow-clip-margin: 32px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 32px;
+      }
+    }
+
