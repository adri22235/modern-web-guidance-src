+    /* Showcase: clip at the card's inner curve, inside its padding. */
+    .showcase {
+      display: grid;
+      grid-template-columns: 1.15fr 1fr;
+      gap: 32px;
+      margin-bottom: 48px;
+      align-items: stretch;
+    }
+
+    .nested-curve-parent {
+      --card-radius: 32px;
+      --card-padding: 16px;
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      background: var(--secondary);
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-content {
+      height: 100%;
+      /* Also supplies inner clipping in browsers without overflow-clip-margin. */
+      border-radius: calc(var(--card-radius) - var(--card-padding));
+      overflow: hidden;
+      background: #fff;
+    }
+
+    .showcase-photo {
+      height: 180px;
+      background: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&q=80') center 55% / cover;
+    }
+
+    .showcase-copy {
+      padding: 24px;
+    }
+
+    .showcase-eyebrow {
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.14em;
+      text-transform: uppercase;
+      margin-bottom: 8px;
+    }
+
+    .showcase h2 {
+      font-size: 1.7rem;
+      line-height: 1.25;
+      margin-bottom: 12px;
+    }
+
+    .safety-zone-parent {
+      position: relative;
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      min-width: 0;
+      padding: 40px 32px 24px;
+      border-radius: 32px;
+      background: var(--primary);
+      color: white;
+      /* Reserve an external paint area for the button's glow. */
+      overflow: clip;
+      overflow-clip-margin: 32px;
+    }
+
+    .promo-copy {
+      width: 100%;
+      margin-bottom: 24px;
+      overflow: hidden;
+    }
+
+    .promo-copy p:last-child {
+      color: var(--secondary);
+    }
+
+    .promo-banner {
+      margin-top: 24px;
+      white-space: nowrap;
+      font-size: 2.6rem;
+      line-height: 1.4;
+      font-weight: 800;
+      letter-spacing: 0.06em;
+      color: rgba(255, 255, 255, 0.12);
+    }
+
+    .safety-zone-parent .btn {
+      position: relative;
+      margin-top: auto;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 700;
+      box-shadow: 0 0 24px 8px rgba(255, 171, 64, 0.45);
+    }
+
+    .safety-zone-parent .btn:hover {
+      background: #ffc36e;
+    }
+
+    .safety-zone-parent .btn:focus-visible {
+      outline: 2px solid white;
+      outline-offset: 5px;
+    }
+
+    @media (max-width: 700px) {
+      .showcase {
+        grid-template-columns: 1fr;
+      }
+
+      .safety-zone-parent {
+        padding: 32px 24px 24px;
+      }
+    }
