+  <script>
+    (() => {
+      const coffees = [
+        { id: 'house', name: 'Daily House Blend', roast: 'Medium roast · Brazil & Colombia', notes: 'Chocolate, caramel, a smooth finish' },
+        { id: 'ethiopia', name: 'Ethiopian Sunrise', roast: 'Light roast · Ethiopia', notes: 'Blueberry, bergamot, a floral lift' },
+        { id: 'midnight', name: 'Midnight Espresso', roast: 'Dark roast · Latin America', notes: 'Dark chocolate, toasted nuts, bold body' },
+        { id: 'colombia', name: 'Colombian Highlands', roast: 'Medium roast · Colombia', notes: 'Red apple, toffee, balanced sweetness' },
+        { id: 'guatemala', name: 'Guatemala Antigua', roast: 'Medium-dark roast · Guatemala', notes: 'Cocoa, orange zest, a hint of spice' },
+        { id: 'decaf', name: 'Slow Sunday Decaf', roast: 'Medium roast · Colombia', notes: 'Brown sugar, almond, easy sipping' },
+      ];
+      const selected = new Set(['house', 'ethiopia', 'midnight']);
+      const form = document.querySelector('#bean-form');
+      const choice = document.querySelector('#bean-choice');
+      const addButton = document.querySelector('#bean-add');
+      const list = document.querySelector('#bean-list');
+      const count = document.querySelector('#bean-count');
+      const status = document.querySelector('#bean-status');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+      function makeCard(coffee) {
+        const card = document.createElement('li');
+        card.className = 'bean-card';
+        card.dataset.id = coffee.id;
+        card.style.viewTransitionName = `bean-${coffee.id}`;
+        // All content comes from the fixed coffee catalog above.
+        card.innerHTML = `<span class="bean-symbol" aria-hidden="true"></span>
+          <h3>${coffee.name}</h3><p class="bean-roast">${coffee.roast}</p>
+          <p class="bean-notes">${coffee.notes}</p>
+          <button class="bean-remove" type="button" aria-label="Remove ${coffee.name}">×</button>`;
+        return card;
+      }
+
+      function updateControls() {
+        const previousChoice = choice.value;
+        const available = coffees.filter(coffee => !selected.has(coffee.id));
+        choice.replaceChildren(...available.map(coffee => new Option(coffee.name, coffee.id)));
+        if (available.some(coffee => coffee.id === previousChoice)) choice.value = previousChoice;
+        if (!available.length) choice.add(new Option('All coffees are in your selection', ''));
+        choice.disabled = addButton.disabled = !available.length;
+        count.textContent = `${selected.size} ${selected.size === 1 ? 'coffee' : 'coffees'} selected`;
+        if (!selected.size) {
+          const empty = document.createElement('li');
+          empty.className = 'bean-empty';
+          empty.textContent = 'A fresh start. Choose a coffee above to build your lineup.';
+          list.replaceChildren(empty);
+        }
+      }
+
+      function transition(update) {
+        if (typeof list.startViewTransition !== 'function' || reducedMotion.matches) {
+          update();
+          return;
+        }
+        const animation = list.startViewTransition(update);
+        // Rapid changes may skip an earlier animation; its DOM update still runs.
+        animation.ready.catch(() => {});
+      }
+
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const coffee = coffees.find(item => item.id === choice.value);
+        if (!coffee) return;
+        transition(() => {
+          if (selected.has(coffee.id)) return;
+          const hadFocus = form.contains(document.activeElement);
+          selected.add(coffee.id);
+          list.querySelector('.bean-empty')?.remove();
+          const card = makeCard(coffee);
+          list.append(card);
+          updateControls();
+          if (addButton.disabled && hadFocus) card.querySelector('button').focus({ preventScroll: true });
+          status.textContent = `${coffee.name} added. ${count.textContent}.`;
+        });
+      });
+
+      list.addEventListener('click', event => {
+        const button = event.target.closest('.bean-remove');
+        if (!button) return;
+        const card = button.closest('.bean-card');
+        transition(() => {
+          if (!selected.has(card.dataset.id)) return;
+          const hadFocus = card.contains(document.activeElement);
+          const next = card.nextElementSibling?.querySelector('button')
+            ?? card.previousElementSibling?.querySelector('button');
+          const coffee = coffees.find(item => item.id === card.dataset.id);
+          selected.delete(coffee.id);
+          card.remove();
+          updateControls();
+          if (hadFocus) (next ?? choice).focus({ preventScroll: true });
+          status.textContent = `${coffee.name} removed. ${count.textContent}.`;
+        });
+      });
+
+      coffees.filter(coffee => selected.has(coffee.id)).forEach(coffee => list.append(makeCard(coffee)));
+      updateControls();
+      document.querySelector('#bean-picker').hidden = false;
+    })();
+  </script>
+
 </body>
 
