+      }
+
+      @media (prefers-reduced-motion: no-preference) {
+        .drink-option input {
+          transition: background-color 180ms ease;
+        }
+
+        .drink-option input::before {
+          transition: transform 180ms ease, opacity 180ms ease;
+        }
+      }
+    }
+
+    @media (forced-colors: active) {
+      .drink-option input,
+      .drink-option input:checked,
+      .drink-option input:indeterminate {
+        appearance: auto;
+        background: revert;
+        border: revert;
+      }
+
+      .drink-option input::before {
+        content: none;
+      }
+
