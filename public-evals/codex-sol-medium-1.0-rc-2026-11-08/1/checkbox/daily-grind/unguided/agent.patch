+    .card {
+      display: flex;
+      flex-direction: column;
+    }
+
+    .customizations {
+      min-width: 0;
+      margin: 24px 0 4px;
+      padding: 0;
+      border: 0;
+      text-align: left;
+    }
+
+    .customizations legend {
+      margin-bottom: 10px;
+      color: var(--primary);
+      font-size: 0.75rem;
+      font-weight: 700;
+      letter-spacing: 0.08em;
+      text-transform: uppercase;
+    }
+
+    .custom-option {
+      position: relative;
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      min-height: 48px;
+      margin-bottom: 8px;
+      padding: 10px 12px;
+      cursor: pointer;
+      font-size: 0.9rem;
+    }
+
+    /* Keep the real input focusable and available to assistive technology. */
+    .custom-option input {
+      position: absolute;
+      left: 12px;
+      top: 50%;
+      width: 22px;
+      height: 22px;
+      margin: -11px 0 0;
+      opacity: 0;
+    }
+
+    .option-surface {
+      position: absolute;
+      inset: 0;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: #faf7f4;
+      pointer-events: none;
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .option-check,
+    .option-icon,
+    .option-text {
+      position: relative;
+      pointer-events: none;
+    }
+
+    .option-check {
+      display: grid;
+      place-items: center;
+      flex: 0 0 22px;
+      height: 22px;
+      border: 2px solid #80665c;
+      border-radius: 6px;
+      background: white;
+      color: var(--primary);
+      transition: background-color 180ms ease, border-color 180ms ease;
+    }
+
+    .option-check svg {
+      width: 16px;
+      height: 16px;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 22;
+      stroke-dashoffset: 22;
+      transform: scale(0.7);
+      transition: stroke-dashoffset 200ms ease, transform 200ms ease;
+    }
+
+    .option-icon {
+      flex: 0 0 20px;
+      width: 20px;
+      height: 20px;
+      fill: none;
+      stroke: currentColor;
+      stroke-width: 1.6;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      color: #80604d;
+    }
+
+    .custom-option:hover .option-surface {
+      border-color: #80665c;
+    }
+
+    .custom-option input:checked ~ .option-surface {
+      background: #fff1dd;
+      border-color: #a66b21;
+    }
+
+    .custom-option input:checked ~ .option-check {
+      background: var(--accent);
+      border-color: var(--primary);
+    }
+
+    .custom-option input:checked ~ .option-check svg {
+      stroke-dashoffset: 0;
+      transform: scale(1);
+    }
+
+    .custom-option input:focus-visible ~ .option-surface {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+    }
+
+    .card > .btn {
+      margin-top: auto;
+      align-self: center;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .custom-option * {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      .custom-option input {
+        opacity: 1;
+        z-index: 1;
+        accent-color: auto;
+      }
+
+      .option-check {
+        visibility: hidden;
+      }
+
+      .custom-option input:checked ~ .option-surface {
+        border-color: Highlight;
+      }
+
+      .custom-option input:focus-visible ~ .option-surface {
+        outline-color: Highlight;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
