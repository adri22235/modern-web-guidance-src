@@ -0,0 +1,17 @@
+<!DOCTYPE html>
+<html lang="en">
+<head><meta charset="UTF-8"><title>Daily coffee tip widget</title></head>
+<body>
+  <script>
+    // The referrer supplies only the receiver address, never a trust decision.
+    // With no usable referrer, fail closed instead of posting to a wildcard.
+    try {
+      const receiver = new URL(document.referrer);
+      if (receiver.protocol === 'https:' || receiver.protocol === 'http:') {
+        parent.postMessage({ type: 'init' }, receiver.origin);
+        parent.postMessage({ type: 'coffee-tip', message: 'For the freshest flavor, grind your beans just before brewing.' }, receiver.origin);
+      }
+    } catch {}
+  </script>
+</body>
+</html>
diff --git a/daily-grind.mjs b/daily-grind.mjs
new file mode 100644
index 0000000..45a0737
--- /dev/null
+++ b/daily-grind.mjs
@@ -0,0 +1,46 @@
+import { classifyLink, createWidgetValidator, isTrustedOrderingMessage, sameSiteUrl } from './origin-validation.mjs';
+
+const status = document.querySelector('#ordering-status');
+const widget = document.querySelector('#coffee-widget');
+const acceptWidget = createWidgetValidator(widget.contentWindow);
+
+window.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || typeof data !== 'object' || Array.isArray(data)) return;
+
+  if (isTrustedOrderingMessage(event)) {
+    if (data.type === 'order-status' && typeof data.message === 'string' && data.message.length <= 300) {
+      status.textContent = data.message;
+    } else if (data.type === 'redirect' && typeof data.url === 'string') {
+      const target = sameSiteUrl(data.url, window.location.href);
+      if (target) window.location.assign(target.href);
+    }
+    return;
+  }
+
+  if (acceptWidget(event) && data.type === 'coffee-tip' &&
+      typeof data.message === 'string' && data.message.length <= 300) {
+    document.querySelector('#coffee-tip').textContent = data.message;
+  }
+});
+
+function validateLink(link) {
+  const kind = classifyLink(link, window.location.href);
+  if (kind === 'blocked') return false;
+  if (kind === 'external') {
+    link.relList.add('external', 'noopener', 'noreferrer');
+  }
+  return true;
+}
+
+document.querySelectorAll('a[href]').forEach(validateLink);
+// Revalidate at activation as well, including dynamically inserted links.
+for (const type of ['click', 'auxclick']) {
+  document.addEventListener(type, (event) => {
+    const link = event.target.closest?.('a[href]');
+    if (link && !validateLink(link)) event.preventDefault();
+  }, true);
+}
+
+// Install the receiver before allowing the sandbox to initialize.
+widget.src = './coffee-widget.html';
