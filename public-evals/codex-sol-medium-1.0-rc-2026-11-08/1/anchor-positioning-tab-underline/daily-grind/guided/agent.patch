   </footer>
 
+  <script>
+    const navList = document.querySelector('nav ul');
+    const navLinks = [...navList.querySelectorAll('a:not(.logout-link)')];
+    let activeLink = navLinks.find(link => link.pathname === window.location.pathname)
+      || navLinks[0];
+
+    function positionIndicator() {
+      const listBounds = navList.getBoundingClientRect();
+      const linkBounds = activeLink.getBoundingClientRect();
+      navList.style.setProperty('--indicator-left', `${linkBounds.left - listBounds.left}px`);
+      navList.style.setProperty('--indicator-top', `${linkBounds.bottom - listBounds.top + 4}px`);
+      navList.style.setProperty('--indicator-width', `${linkBounds.width}px`);
+    }
+
+    function selectLink(link) {
+      navLinks.forEach(item => item.removeAttribute('aria-current'));
+      activeLink = link;
+      activeLink.setAttribute('aria-current', 'page');
+      positionIndicator();
+    }
+
+    navLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        // Keep selection on this page so the indicator can slide between items.
+        event.preventDefault();
+        selectLink(link);
+      });
+    });
+
+    selectLink(activeLink);
+    requestAnimationFrame(() => {
+      requestAnimationFrame(() => navList.classList.add('indicator-ready'));
+    });
+    new ResizeObserver(positionIndicator).observe(navList);
+    document.fonts.ready.then(positionIndicator);
+  </script>
+
 </body>
 
