+  <script>
+    const breadcrumbLabels = {
+      '/menu': 'Menu',
+      '/menu/seasonal': 'Maple Oat Latte',
+      '/menu/espresso': 'Dark Roast Espresso',
+      '/menu/cold-brew': 'Cold Brew',
+      '/locations': 'Locations',
+      '/rewards': 'Rewards',
+      '/account': 'My Account',
+      '/logout': 'Logout',
+      '/order-online': 'Order Online',
+      '/about': 'Our Story',
+      '/careers': 'Join the Team',
+      '/contact': 'Contact Us',
+      '/privacy-policy': 'Privacy'
+    };
+    const pathSegments = window.location.pathname.split('/').filter(Boolean);
+    if (pathSegments[pathSegments.length - 1] === 'index.html') {
+      pathSegments.pop();
+    }
+    const crumbs = [{ label: 'Home', href: '/' }];
+    pathSegments.forEach((segment, index) => {
+      const href = '/' + pathSegments.slice(0, index + 1).join('/');
+      const label = breadcrumbLabels[href] || segment.replace(/[-_]/g, ' ')
+        .replace(/\b\w/g, letter => letter.toUpperCase());
+      crumbs.push({ label, href });
+    });
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    breadcrumbList.replaceChildren();
+    crumbs.forEach((crumb, index) => {
+      const item = document.createElement('li');
+      if (index > 0) {
+        const separator = document.createElement('span');
+        separator.className = 'separator';
+        separator.setAttribute('aria-hidden', 'true');
+        separator.textContent = '›';
+        item.append(separator);
+      }
+      const isCurrentPage = index === crumbs.length - 1;
+      const label = document.createElement(isCurrentPage ? 'span' : 'a');
+      label.textContent = crumb.label;
+      if (isCurrentPage) {
+        label.setAttribute('aria-current', 'page');
+      } else {
+        label.href = crumb.href;
+      }
+      item.append(label);
+      breadcrumbList.append(item);
+    });
+  </script>
 </body>
 
