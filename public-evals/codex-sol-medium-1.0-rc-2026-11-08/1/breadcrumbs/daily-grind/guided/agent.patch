+  <script>
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    const pageLabels = {
+      '/menu': 'Menu',
+      '/menu/seasonal': 'Maple Oat Latte',
+      '/menu/espresso': 'Dark Roast Espresso',
+      '/menu/cold-brew': 'Cold Brew',
+      '/locations': 'Locations',
+      '/rewards': 'Rewards',
+      '/account': 'My Account',
+      '/logout': 'Logout',
+      '/order-online': 'Order Online',
+      '/about': 'Our Story',
+      '/careers': 'Join the Team',
+      '/contact': 'Contact Us',
+      '/privacy-policy': 'Privacy'
+    };
+    const path = window.location.pathname.replace(/\/+$/, '') || '/';
+    const segments = path === '/' || path === '/index.html'
+      ? []
+      : path.split('/').filter(Boolean);
+
+    if (segments.length) {
+      breadcrumbList.querySelector('a').removeAttribute('aria-current');
+    }
+
+    let parentPath = '';
+    segments.forEach((segment, index) => {
+      parentPath += '/' + segment;
+      const item = document.createElement('li');
+      const link = document.createElement('a');
+      link.href = parentPath;
+      // Use known page names, with readable labels for other nested paths.
+      let label = segment;
+      try {
+        label = decodeURIComponent(segment);
+      } catch {
+        // Keep the original segment if the URL contains malformed encoding.
+      }
+      link.textContent = pageLabels[parentPath] || label.replace(/[-_]/g, ' ');
+      if (index === segments.length - 1) {
+        link.setAttribute('aria-current', 'page');
+      }
+      item.append(link);
+      breadcrumbList.append(item);
+    });
+  </script>
 </body>
 
