index 0000000..9b435ad
--- /dev/null
+++ b/performance-monitor.js
@@ -0,0 +1,134 @@
+(() => {
+  'use strict';
+
+  const prefix = 'daily-grind';
+  const samples = [];
+  const pending = new Set();
+  let sequence = 0;
+
+  // Event Timing measures input through the next paint, including input delay.
+  // Browsers omit short events (minimum threshold: 16ms); those use our fallback.
+  function collectEntries(entries) {
+    for (const entry of entries) {
+      if (entry.name !== 'click') continue;
+      for (const timing of pending) {
+        if (timing.kind === 'click' && Math.abs(entry.startTime - timing.start) < 1) {
+          timing.eventTiming = entry;
+        }
+      }
+    }
+  }
+
+  let observer;
+  try {
+    if (window.PerformanceObserver?.supportedEntryTypes.includes('event')) {
+      observer = new PerformanceObserver(list => collectEntries(list.getEntries()));
+      observer.observe({ type: 'event', durationThreshold: 16 });
+    }
+  } catch {
+    observer = undefined;
+  }
+
+  function cancel(timing) {
+    cancelAnimationFrame(timing.frame);
+    pending.delete(timing);
+  }
+
+  function begin(kind, label, start = performance.now()) {
+    const timing = { kind, label, start, id: ++sequence };
+    if (document.visibilityState === 'visible') pending.add(timing);
+    return timing;
+  }
+
+  function finish(timing) {
+    if (!pending.has(timing) || timing.finishing) return;
+    timing.finishing = true;
+    // rAF callbacks run BEFORE paint. Waiting for the following frame gives the
+    // committed update a rendering opportunity; this is an estimate, not proof
+    // that every animation, image, or future asynchronous update has finished.
+    timing.frame = requestAnimationFrame(() => {
+      timing.frame = requestAnimationFrame(() => {
+        if (!pending.has(timing) || document.visibilityState !== 'visible') {
+          cancel(timing);
+          return;
+        }
+        if (observer) collectEntries(observer.takeRecords());
+        const entry = timing.eventTiming;
+        const end = entry ? entry.startTime + entry.duration : performance.now();
+        const sample = Object.freeze({
+          id: timing.id,
+          kind: timing.kind,
+          label: timing.label,
+          startTime: timing.start,
+          duration: Math.max(0, end - timing.start),
+          method: entry ? 'event-timing' : 'animation-frame-estimate',
+        });
+        pending.delete(timing);
+        samples.push(sample);
+        if (samples.length > 100) samples.shift();
+
+        const name = `${prefix}:${timing.kind}:${timing.label}`;
+        try {
+          performance.measure(name, { start: timing.start, end, detail: sample });
+          // The rolling sample buffer and event are the durable local output.
+          performance.clearMeasures(name);
+        } catch {
+          // Older User Timing implementations may not support numeric bounds.
+        }
+        window.dispatchEvent(new CustomEvent(`${prefix}:performance`, { detail: sample }));
+      });
+    });
+  }
+
+  document.addEventListener('click', event => {
+    const element = event.target instanceof Element
+      ? event.target.closest('[data-performance]') : null;
+    if (!element) return;
+    // Some older browsers use epoch-based event timestamps.
+    const start = event.timeStamp > performance.now() + 60000
+      ? event.timeStamp - performance.timeOrigin : event.timeStamp;
+    finish(begin('click', element.dataset.performance, Math.max(0, start)));
+  }, { capture: true, passive: true });
+
+  // History changes cover synchronous client-side routers without intercepting
+  // links or altering their default navigation behavior.
+  for (const method of ['pushState', 'replaceState']) {
+    const original = history[method];
+    history[method] = function (...args) {
+      const timing = begin('view-switch', method);
+      try {
+        const result = original.apply(this, args);
+        finish(timing);
+        return result;
+      } catch (error) {
+        cancel(timing);
+        throw error;
+      }
+    };
+  }
+
+  for (const event of ['popstate', 'hashchange']) {
+    window.addEventListener(event, () => finish(begin('view-switch', event)));
+  }
+
+  // Async routers should call beginViewSwitch before loading and invoke the
+  // returned function only after the new view has committed its DOM updates.
+  window.dailyGrindPerformance = Object.freeze({
+    getSamples: () => samples.slice(),
+    beginViewSwitch(label) {
+      const timing = begin('view-switch', String(label));
+      return () => finish(timing);
+    },
+  });
+
+  // Hidden pages cannot supply reliable paint timings. Drop unfinished samples
+  // rather than reporting background-tab or full-document navigation delays.
+  document.addEventListener('visibilitychange', () => {
+    if (document.visibilityState !== 'visible') {
+      for (const timing of pending) cancel(timing);
+    }
+  });
+  window.addEventListener('pagehide', () => {
+    for (const timing of pending) cancel(timing);
+  });
+})();
diff --git a/performance-monitor.test.cjs b/performance-monitor.test.cjs
new file mode 100644
index 0000000..06d8ac5
--- /dev/null
+++ b/performance-monitor.test.cjs
@@ -0,0 +1,134 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+function setup(nativeTiming = false) {
+  let now = 100;
+  let nextFrame = 0;
+  let records = [];
+  const frames = new Map();
+  const document = new EventTarget();
+  document.visibilityState = 'visible';
+  const window = new EventTarget();
+  class Element {
+    constructor(label) { this.dataset = { performance: label }; }
+    closest() { return this; }
+  }
+  class CustomEvent extends Event {
+    constructor(name, options) { super(name); this.detail = options.detail; }
+  }
+  class PerformanceObserver {
+    static supportedEntryTypes = nativeTiming ? ['event'] : [];
+    observe() {}
+    takeRecords() { const result = records; records = []; return result; }
+  }
+  const measures = [];
+  const history = {
+    pushState(value) { if (value === 'error') throw new Error('history failed'); return 'ok'; },
+    replaceState() {},
+  };
+  window.PerformanceObserver = PerformanceObserver;
+  const context = {
+    window, document, history, Element, CustomEvent, PerformanceObserver,
+    performance: {
+      now: () => now, timeOrigin: 1700000000000,
+      measure: (name, options) => measures.push({ name, ...options }),
+      clearMeasures() {},
+    },
+    requestAnimationFrame(callback) { frames.set(++nextFrame, callback); return nextFrame; },
+    cancelAnimationFrame(id) { frames.delete(id); },
+  };
+  vm.runInNewContext(readFileSync(`${__dirname}/performance-monitor.js`, 'utf8'), context);
+  return {
+    window, document, history, measures,
+    api: window.dailyGrindPerformance,
+    records(entries) { records = entries; },
+    frame(time) {
+      now = time;
+      const callbacks = [...frames.values()];
+      frames.clear();
+      callbacks.forEach(callback => callback(time));
+    },
+    click(label) {
+      const event = new Event('click');
+      Object.defineProperties(event, {
+        target: { value: new Element(label) }, timeStamp: { value: now },
+      });
+      document.dispatchEvent(event);
+      assert.equal(event.defaultPrevented, false);
+    },
+  };
+}
+
+test('delegated clicks wait across paint frames and publish bounded local samples', () => {
+  const app = setup();
+  const events = [];
+  app.window.addEventListener('daily-grind:performance', event => events.push(event.detail));
+  app.click('order-now');
+  assert.equal(app.api.getSamples().length, 0);
+  app.frame(116);
+  assert.equal(app.api.getSamples().length, 0);
+  app.frame(132);
+  assert.equal(events[0].duration, 32);
+  assert.equal(events[0].method, 'animation-frame-estimate');
+  assert.equal(app.measures[0].name, 'daily-grind:click:order-now');
+  for (let i = 0; i < 105; i++) {
+    app.click('seasonal-cold-brew');
+    app.frame(148 + i * 32);
+    app.frame(164 + i * 32);
+  }
+  assert.equal(app.api.getSamples().length, 100);
+  const copy = app.api.getSamples();
+  copy.pop();
+  assert.equal(app.api.getSamples().length, 100);
+});
+
+test('native click timing replaces the frame estimate when available', () => {
+  const app = setup(true);
+  app.click('nav-menu');
+  app.records([{ name: 'click', startTime: 100, duration: 24 }]);
+  app.frame(116);
+  app.frame(132);
+  const [sample] = app.api.getSamples();
+  assert.equal(sample.duration, 24);
+  assert.equal(sample.method, 'event-timing');
+});
+
+test('async view timing waits for explicit commit and completion is idempotent', () => {
+  const app = setup();
+  const committed = app.api.beginViewSwitch('menu');
+  app.frame(200);
+  assert.equal(app.api.getSamples().length, 0);
+  committed();
+  committed();
+  app.frame(216);
+  app.frame(232);
+  assert.equal(app.api.getSamples().length, 1);
+  assert.equal(app.api.getSamples()[0].duration, 132);
+});
+
+test('history behavior is preserved and hidden or unloading pages drop pending samples', () => {
+  const app = setup();
+  assert.equal(app.history.pushState({}, '', '/menu'), 'ok');
+  assert.throws(() => app.history.pushState('error'), /history failed/);
+  app.frame(116);
+  app.frame(132);
+  assert.equal(app.api.getSamples().length, 1);
+  app.click('nav-menu');
+  app.document.visibilityState = 'hidden';
+  app.document.dispatchEvent(new Event('visibilitychange'));
+  app.frame(148);
+  app.frame(164);
+  assert.equal(app.api.getSamples().length, 1);
+  app.document.visibilityState = 'visible';
+  app.window.dispatchEvent(new Event('popstate'));
+  app.frame(180);
+  app.frame(196);
+  assert.equal(app.api.getSamples()[1].label, 'popstate');
+  app.click('order-now');
+  app.window.dispatchEvent(new Event('pagehide'));
+  app.frame(212);
+  app.frame(228);
+  assert.equal(app.api.getSamples().length, 2);
+});
