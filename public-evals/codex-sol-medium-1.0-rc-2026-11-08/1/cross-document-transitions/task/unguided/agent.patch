+  <script>
+    const favoritePages = [
+      [
+        ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', '/menu/seasonal'],
+        ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', '/menu/espresso'],
+        ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', '/menu/cold-brew'],
+      ],
+      [
+        ['Pumpkin Spice Latte', 'Warming spices and pumpkin paired with velvety steamed milk.', '/menu/seasonal'],
+        ['Honey Cinnamon Cappuccino', 'Rich espresso with honey, cinnamon, and a cloud of foam.', '/menu/espresso'],
+        ['Vanilla Cream Cold Brew', 'Slow-steeped coffee finished with smooth vanilla cream.', '/menu/cold-brew'],
+      ],
+      [
+        ['Toasted Hazelnut Latte', 'Nutty hazelnut and espresso with silky steamed milk.', '/menu/seasonal'],
+        ['Spiced Mocha', 'Dark chocolate and espresso with a warming touch of spice.', '/menu/espresso'],
+        ['Maple Cold Brew', 'Our slow-steeped cold brew with a mellow maple finish.', '/menu/cold-brew'],
+      ],
+    ];
+
+    function pageNumber(url) {
+      const page = Number(new URL(url).searchParams.get('page') || 1);
+      return Number.isInteger(page) ? Math.max(1, Math.min(favoritePages.length, page)) : 1;
+    }
+
+    function setTransitionDirection(transition, from, to) {
+      if (!transition) return;
+      if (!from || !to || matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        transition.skipTransition();
+        return;
+      }
+      const source = new URL(from);
+      const destination = new URL(to);
+      const difference = pageNumber(destination) - pageNumber(source);
+      if (source.origin !== destination.origin || source.pathname !== destination.pathname || !difference || !transition.types) {
+        transition.skipTransition();
+        return;
+      }
+      transition.types.add(difference > 0 ? 'forwards' : 'backwards');
+    }
+
+    addEventListener('pageswap', (event) => {
+      setTransitionDirection(event.viewTransition, location.href, event.activation?.entry?.url);
+    });
+
+    addEventListener('pagereveal', (event) => {
+      setTransitionDirection(event.viewTransition, window.navigation?.activation?.from?.url, location.href);
+    });
+
+    addEventListener('DOMContentLoaded', () => {
+      const page = pageNumber(location.href);
+      document.querySelectorAll('.grid .card').forEach((card, index) => {
+        const [name, description, href] = favoritePages[page - 1][index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').href = href;
+      });
+      document.getElementById('page-number').textContent = `Page ${page} of ${favoritePages.length}`;
+      for (const [id, target] of [['previous', page - 1], ['next', page + 1]]) {
+        const link = document.getElementById(id);
+        const disabled = target < 1 || target > favoritePages.length;
+        const url = new URL(location.href);
+        url.searchParams.set('page', Math.max(1, Math.min(favoritePages.length, target)));
+        link.href = url.href;
+        if (disabled) {
+          link.setAttribute('aria-disabled', 'true');
+          link.addEventListener('click', (event) => event.preventDefault());
+        }
+      }
+    });
+  </script>
