+      document.querySelectorAll('main .card').forEach((card, index) => {
+        const [name, description, href] = favorites[index];
+        card.querySelector('h3').textContent = name;
+        card.querySelector('p').textContent = description;
+        card.querySelector('a').setAttribute('href', href);
+      });
+    }
+    document.getElementById('page-status').textContent = `Page ${currentPage} of ${favoritesPages.length}`;
+    for (const [id, offset] of [['previous', -1], ['next', 1]]) {
+      const link = document.getElementById(id);
+      const page = currentPage + offset;
+      if (page >= 1 && page <= favoritesPages.length) {
+        const destination = new URL(location.href);
+        destination.searchParams.set('page', page);
+        link.href = destination.href;
+        link.removeAttribute('aria-disabled');
+      } else {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+      }
+    }
