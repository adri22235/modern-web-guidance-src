+  <script>
+    // Query-string destinations load this same document, sharing the opt-in CSS.
+    const favoritesPages = [
+      null, // The first page is already present in the HTML.
+      [
+        ['Cinnamon Honey Latte', 'Warm cinnamon and golden honey in a velvety latte.', '/menu/seasonal'],
+        ['Vanilla Cappuccino', 'Rich espresso topped with vanilla-scented milk foam.', '/menu/espresso'],
+        ['Maple Cold Brew', 'Slow-steeped cold brew with a touch of maple sweetness.', '/menu/cold-brew']
+      ],
+      [
+        ['Spiced Mocha', 'Dark chocolate and warming spices meet freshly pulled espresso.', '/menu/seasonal'],
+        ['Caramel Macchiato', 'Espresso and steamed milk finished with caramel.', '/menu/espresso'],
+        ['Oat Milk Cold Brew', 'Our smooth cold brew with a creamy oat milk finish.', '/menu/cold-brew']
+      ]
+    ];
+
+    function favoritesPage(url) {
+      const page = Number(new URL(url).searchParams.get('page') || 1);
+      return Number.isInteger(page) && page >= 1 && page <= favoritesPages.length ? page : 1;
+    }
+
+    function setTransitionDirection(transition, from, to) {
+      if (!transition || !from || !to) return;
+      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        transition.skipTransition();
+        return;
+      }
+      const source = new URL(from);
+      const destination = new URL(to);
+      if (source.origin !== destination.origin || source.pathname !== destination.pathname) return;
+      const difference = favoritesPage(destination) - favoritesPage(source);
+      if (difference && transition.types) {
+        transition.types.add(difference > 0 ? 'next' : 'previous');
+      }
+    }
+
+    // Register early so incoming documents and history traversals get a direction.
+    window.addEventListener('pageswap', (event) => {
+      setTransitionDirection(event.viewTransition, location.href, event.activation?.entry?.url);
+    });
+    window.addEventListener('pagereveal', (event) => {
+      setTransitionDirection(event.viewTransition, window.navigation?.activation?.from?.url, location.href);
+    });
+  </script>
 </head>
 
