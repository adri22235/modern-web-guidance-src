+/**
+ * A self-contained coffee card. String properties reflect their attributes;
+ * price is an optional, finite, nonnegative number in USD; featured uses HTML
+ * boolean semantics (presence is true, even featured="false").
+ * Listen for the bubbling, cancelable coffee-select event to intercept details.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'featured'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).innerHTML = `
+      <style>
+        :host {
+          display: block;
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+        * { box-sizing: border-box; margin: 0; padding: 0; }
+        [hidden] { display: none !important; }
+        h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+        .featured { color: var(--primary, #4e342e); font-weight: bold; }
+        .price { margin-top: 10px; font-weight: bold; }
+        a {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          transition: background 0.3s;
+        }
+        a:hover { background: #3e2723; }
+        a:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+      </style>
+      <article>
+        <p class="featured" hidden>Featured</p>
+        <h3></h3>
+        <p class="description"></p>
+        <p class="price" hidden></p>
+        <a>View Details</a>
+      </article>
+    `;
+    this._onClick = (event) => {
+      const accepted = this.dispatchEvent(new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        cancelable: true,
+        detail: {
+          name: this.name,
+          description: this.description,
+          href: this.href,
+          price: this.price,
+          featured: this.featured,
+        },
+      }));
+      if (!accepted) event.preventDefault();
+    };
+  }
+
+  connectedCallback() {
+    // Preserve values assigned before the element definition was registered.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.prototype.hasOwnProperty.call(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this._render();
+    this.shadowRoot.querySelector('a').addEventListener('click', this._onClick);
+  }
+
+  disconnectedCallback() {
+    this.shadowRoot.querySelector('a').removeEventListener('click', this._onClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this._render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this._reflectString('name', value); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this._reflectString('description', value); }
+
+  get href() { return this.getAttribute('href') ?? '/menu'; }
+  set href(value) { this._reflectString('href', value); }
+
+  get price() {
+    const raw = this.getAttribute('price');
+    if (raw === null || raw.trim() === '') return null;
+    const value = Number(raw);
+    return Number.isFinite(value) && value >= 0 ? value : null;
+  }
+
+  set price(value) {
+    if (value === null || value === undefined || String(value).trim() === '') {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    if (Number.isFinite(number) && number >= 0) {
+      this.setAttribute('price', String(number));
+    } else {
+      this.removeAttribute('price');
+    }
+  }
+
+  get featured() { return this.hasAttribute('featured'); }
+  set featured(value) { this.toggleAttribute('featured', Boolean(value)); }
+
+  _reflectString(attribute, value) {
+    if (value === null || value === undefined) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  _render() {
+    // Update existing nodes to preserve focus and listeners; never parse input as HTML.
+    this.shadowRoot.querySelector('h3').textContent = this.name;
+    this.shadowRoot.querySelector('.description').textContent = this.description;
+    this.shadowRoot.querySelector('a').setAttribute('href', this.href);
+    this.shadowRoot.querySelector('.featured').hidden = !this.featured;
+    const price = this.price;
+    const priceNode = this.shadowRoot.querySelector('.price');
+    priceNode.hidden = price === null;
+    priceNode.textContent = price === null ? '' : new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(price);
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
diff --git a/coffee-card.test.js b/coffee-card.test.js
new file mode 100644
index 0000000..7a27669
--- /dev/null
+++ b/coffee-card.test.js
@@ -0,0 +1,140 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { parseHTML } from 'linkedom';
+
+const { window } = parseHTML('<!doctype html><html><body></body></html>');
+for (const key of ['document', 'HTMLElement', 'customElements', 'CustomEvent']) {
+  globalThis[key] = window[key];
+}
+const { CoffeeCard } = await import('./coffee-card.js');
+
+test('registers an autonomous custom element and renders the original menu', async () => {
+  assert.equal(customElements.get('coffee-card'), CoffeeCard);
+  const html = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+  const container = document.createElement('div');
+  container.innerHTML = html.match(/<main\b[^>]*>([\s\S]*?)<\/main>/)[1];
+  document.body.append(container);
+  const cards = [...container.querySelectorAll('coffee-card')];
+  assert.deepEqual(cards.map((card) => card.name), [
+    'Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew',
+  ]);
+  for (const card of cards) {
+    assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+    assert.equal(card.shadowRoot.querySelector('a').getAttribute('href'), card.href);
+    assert.equal(card.shadowRoot.querySelector('.price').hidden, true);
+  }
+  container.remove();
+});
+
+test('reflects strings in both directions and inserts text safely', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  for (const attribute of ['name', 'description', 'href']) {
+    card[attribute] = 'property value';
+    assert.equal(card.getAttribute(attribute), 'property value');
+    card.setAttribute(attribute, 'attribute value');
+    assert.equal(card[attribute], 'attribute value');
+    card[attribute] = null;
+    assert.equal(card.hasAttribute(attribute), false);
+  }
+  assert.equal(card.href, '/menu');
+  card.name = '<img src=x onerror=alert(1)>';
+  assert.equal(card.shadowRoot.querySelector('h3').textContent, card.name);
+  assert.equal(card.shadowRoot.querySelector('img'), null);
+  card.description = 'New description';
+  assert.equal(card.shadowRoot.querySelector('.description').textContent, card.description);
+  card.remove();
+});
+
+test('reflects finite nonnegative prices and handles missing or invalid numbers', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  const priceNode = card.shadowRoot.querySelector('.price');
+  card.price = 4.5;
+  assert.equal(card.getAttribute('price'), '4.5');
+  assert.equal(priceNode.textContent, '$4.50');
+  assert.equal(priceNode.hidden, false);
+  card.setAttribute('price', '0');
+  assert.equal(card.price, 0);
+  assert.equal(priceNode.textContent, '$0.00');
+  for (const invalid of ['', ' ', 'invalid', '-1', 'Infinity', 'NaN']) {
+    card.setAttribute('price', invalid);
+    assert.equal(card.price, null);
+    assert.equal(priceNode.hidden, true);
+    card.price = invalid;
+    assert.equal(card.hasAttribute('price'), false);
+  }
+  for (const absent of [null, undefined]) {
+    card.price = 5;
+    card.price = absent;
+    assert.equal(card.price, null);
+    assert.equal(card.hasAttribute('price'), false);
+  }
+  card.remove();
+});
+
+test('reflects booleans using HTML presence semantics', () => {
+  const card = document.createElement('coffee-card');
+  document.body.append(card);
+  const badge = card.shadowRoot.querySelector('.featured');
+  assert.equal(card.featured, false);
+  card.featured = true;
+  assert.equal(card.getAttribute('featured'), '');
+  assert.equal(badge.hidden, false);
+  card.featured = false;
+  assert.equal(card.hasAttribute('featured'), false);
+  assert.equal(badge.hidden, true);
+  card.setAttribute('featured', 'false');
+  assert.equal(card.featured, true);
+  assert.equal(badge.hidden, false);
+  card.removeAttribute('featured');
+  assert.equal(card.featured, false);
+  assert.equal(badge.hidden, true);
+  card.remove();
+});
+
+test('cleans up on disconnect and reconnects without duplicating listeners or nodes', () => {
+  const card = document.createElement('coffee-card');
+  card.name = 'Espresso';
+  card.price = 3;
+  document.body.append(card);
+  const link = card.shadowRoot.querySelector('a');
+  let selections = 0;
+  const onSelect = (event) => {
+    selections++;
+    assert.equal(event.detail.name, card.name);
+    assert.equal(event.detail.price, 3);
+    event.preventDefault();
+  };
+  document.body.addEventListener('coffee-select', onSelect);
+  const click = () => link.dispatchEvent(new window.Event('click', { cancelable: true }));
+  assert.equal(click(), false);
+  assert.equal(selections, 1);
+  card.remove();
+  assert.equal(click(), true);
+  assert.equal(selections, 1);
+  card.name = 'Updated espresso';
+  for (let i = 0; i < 3; i++) {
+    document.body.append(card);
+    assert.equal(card.shadowRoot.querySelector('a'), link);
+    assert.equal(click(), false);
+    card.remove();
+  }
+  assert.equal(selections, 4);
+  document.body.removeEventListener('coffee-select', onSelect);
+});
+
+test('preserves properties assigned before custom element registration', () => {
+  const early = document.createElement('upgraded-coffee-card');
+  early.name = 'Early latte';
+  early.price = 6;
+  early.featured = true;
+  document.body.append(early);
+  customElements.define('upgraded-coffee-card', class extends CoffeeCard {});
+  assert.equal(early.getAttribute('name'), 'Early latte');
+  assert.equal(early.getAttribute('price'), '6');
+  assert.equal(early.hasAttribute('featured'), true);
+  assert.equal(Object.hasOwn(early, 'name'), false);
+  early.remove();
+});
