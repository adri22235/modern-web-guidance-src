diff --git a/coffee-card.js b/coffee-card.js
new file mode 100644
index 0000000..ff91fc3
--- /dev/null
+++ b/coffee-card.js
@@ -0,0 +1,129 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host { display: block; }
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+    a {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+    a:hover { background: #3e2723; }
+    a[aria-disabled="true"] { opacity: 0.6; cursor: not-allowed; }
+    [hidden] { display: none; }
+  </style>
+  <h3></h3>
+  <p class="description"></p>
+  <p class="price" hidden></p>
+  <a>View Details</a>
+`;
+
+/**
+ * Attributes reflect to name, description, href (strings), price (a nonnegative
+ * finite number, default 0), and disabled (presence boolean). Omit price to hide
+ * it. Setting a string or price to null removes the attribute.
+ * coffee-select bubbles and is cancelable; preventDefault() stops navigation.
+ */
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'disabled'];
+  #listeners;
+  #heading;
+  #description;
+  #price;
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#heading = root.querySelector('h3');
+    this.#description = root.querySelector('.description');
+    this.#price = root.querySelector('.price');
+    this.#link = root.querySelector('a');
+  }
+
+  connectedCallback() {
+    // Replay properties assigned before customElements.define() upgraded us.
+    for (const property of CoffeeCard.observedAttributes) {
+      if (Object.hasOwn(this, property)) {
+        const value = this[property];
+        delete this[property];
+        this[property] = value;
+      }
+    }
+    this.#listeners?.abort();
+    this.#listeners = new AbortController();
+    this.#link.addEventListener('click', (event) => {
+      if (this.disabled || !this.dispatchEvent(new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        cancelable: true,
+        detail: { name: this.name, price: this.price, href: this.href },
+      }))) event.preventDefault();
+    }, { signal: this.#listeners.signal });
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#listeners?.abort();
+    this.#listeners = undefined;
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#render();
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.#setString('name', value); }
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.#setString('description', value); }
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.#setString('href', value); }
+  get price() {
+    const value = Number(this.getAttribute('price'));
+    return Number.isFinite(value) && value >= 0 ? value : 0;
+  }
+  set price(value) {
+    if (value == null) {
+      this.removeAttribute('price');
+      return;
+    }
+    const number = Number(value);
+    this.setAttribute('price', String(Number.isFinite(number) && number >= 0 ? number : 0));
+  }
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  #setString(attribute, value) {
+    if (value == null) this.removeAttribute(attribute);
+    else this.setAttribute(attribute, String(value));
+  }
+
+  #render() {
+    this.#heading.textContent = this.name;
+    this.#description.textContent = this.description;
+    this.#price.hidden = !this.hasAttribute('price');
+    this.#price.textContent = new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(this.price);
+    // Accept relative and HTTP(S) links, but never executable URL schemes.
+    let href;
+    try {
+      const url = new URL(this.href, this.baseURI);
+      if (this.href && ['http:', 'https:'].includes(url.protocol)) href = url.href;
+    } catch { /* An invalid URL leaves the link inert. */ }
+    if (href && !this.disabled) this.#link.setAttribute('href', href);
+    else this.#link.removeAttribute('href');
+    this.#link.setAttribute('aria-disabled', String(this.disabled));
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
