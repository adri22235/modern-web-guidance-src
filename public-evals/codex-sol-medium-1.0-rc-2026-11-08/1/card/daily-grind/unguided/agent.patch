+  <script>
+    const drinks = {
+      'maple-oat-latte': 'Maple Oat Latte',
+      'dark-roast-espresso': 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+    const sizes = ['small', 'medium', 'large'];
+    const storageKey = 'daily-grind-order';
+    let order = [];
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (Array.isArray(saved)) {
+        order = saved.filter(item => item && Object.hasOwn(drinks, item.drink) &&
+          sizes.includes(item.size) && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+      }
+    } catch { /* Ordering remains available when browser storage is unavailable. */ }
+
+    const status = document.querySelector('.order-status');
+    function renderOrder() {
+      const list = document.getElementById('order-items');
+      list.replaceChildren();
+      let count = 0;
+      for (const item of order) {
+        const row = document.createElement('li');
+        row.textContent = `${item.quantity} × ${drinks[item.drink]} (${item.size})`;
+        list.append(row);
+        count += item.quantity;
+      }
+      document.getElementById('order-count').textContent = `(${count})`;
+      document.getElementById('empty-order').hidden = count > 0;
+      list.hidden = count === 0;
+      document.getElementById('clear-order').hidden = count === 0;
+    }
+
+    function saveOrder() {
+      try { localStorage.setItem(storageKey, JSON.stringify(order)); } catch {}
+      renderOrder();
+    }
+
+    document.querySelectorAll('.drink-form').forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        if (!Object.hasOwn(drinks, drink) || !sizes.includes(size)) return;
+        const existing = order.find(item => item.drink === drink && item.size === size);
+        if (existing) existing.quantity += 1;
+        else order.push({ drink, size, quantity: 1 });
+        saveOrder();
+        const total = order.reduce((sum, item) => sum + item.quantity, 0);
+        status.textContent = `Added ${size} ${drinks[drink]}. Your order has ${total} ${total === 1 ? 'drink' : 'drinks'}.`;
+      });
+    });
+
+    document.getElementById('clear-order').addEventListener('click', () => {
+      order = [];
+      saveOrder();
+      status.textContent = 'Your order has been cleared.';
+      document.querySelector('.add-to-order').focus();
+    });
+    renderOrder();
+  </script>
 </body>
 
