\ No newline at end of file
+}
+
+/* Sections publish semantic context; teaser components consume it independently. */
+[data-surface="default"] {
+  --surface: default;
+  --teaser-badge-display: none;
+  --teaser-action-background: transparent;
+  --teaser-action-color: var(--color-amber-800);
+}
+
+[data-surface="featured"] {
+  --surface: featured;
+  /* Inherited values preserve the presentation without style-query support. */
+  --teaser-badge-display: inline-flex;
+  --teaser-action-background: var(--color-amber-800);
+  --teaser-action-color: white;
+}
+
+.teaser-badge {
+  display: var(--teaser-badge-display, none);
+  align-items: center;
+  border-radius: 999px;
+  background: var(--color-amber-100);
+  color: var(--color-amber-900);
+  padding-block: 0.25rem;
+  padding-inline: 0.625rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+}
+
+.teaser-action {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-block-size: 2.75rem;
+  border: 1px solid var(--color-amber-800);
+  border-radius: 0.375rem;
+  padding-block: 0.5rem;
+  padding-inline: 1rem;
+  background: var(--teaser-action-background, transparent);
+  color: var(--teaser-action-color, var(--color-amber-800));
+  font-size: 0.875rem;
+  font-weight: 600;
+}
+
+.teaser-action:hover {
+  text-decoration: underline;
+  text-underline-offset: 0.2em;
+}
+
+.teaser-action:focus-visible {
+  outline: 2px solid var(--color-amber-800);
+  outline-offset: 3px;
+}
+
+@container style(--surface: featured) {
+  .teaser-badge {
+    display: inline-flex;
+  }
+
+  .teaser-action {
+    background: var(--color-amber-800);
+    color: white;
+  }
+}
