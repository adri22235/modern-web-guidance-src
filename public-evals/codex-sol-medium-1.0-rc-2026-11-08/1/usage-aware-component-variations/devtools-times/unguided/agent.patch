+    articleId: string;
+    title: string;
+}
+
+const { articleId, title } = Astro.props;
+---
+
+<div class="flex flex-wrap items-center gap-3 mt-4">
+    <span class="teaser-badge rounded-full bg-amber-200 px-3 py-1 text-xs font-semibold text-amber-950">Featured</span>
