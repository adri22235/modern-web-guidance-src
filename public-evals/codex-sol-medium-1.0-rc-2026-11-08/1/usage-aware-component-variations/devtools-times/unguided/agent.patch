diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..7dbd378 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1,7 +1,47 @@
 @import "tailwindcss";
 
+/* Inherited section context keeps cards and actions in sync, including nested sections. */
+[data-presentation="default"] {
+  --teaser-badge-display: none;
+  --teaser-surface: transparent;
+  --teaser-action-background: transparent;
+  --teaser-action-color: var(--color-amber-900);
+  --teaser-action-hover-background: var(--color-amber-100);
+}
+
+[data-presentation="featured"] {
+  --teaser-badge-display: inline-flex;
+  --teaser-surface: var(--color-amber-50);
+  --teaser-action-background: var(--color-amber-800);
+  --teaser-action-color: white;
+  --teaser-action-hover-background: var(--color-amber-900);
+}
+
+.article-teaser {
+  background-color: var(--teaser-surface, transparent);
+}
+
+.teaser-badge {
+  display: var(--teaser-badge-display, none);
+}
+
+.teaser-action {
+  background-color: var(--teaser-action-background, transparent);
+  border-color: var(--color-amber-800);
+  color: var(--teaser-action-color, var(--color-amber-900));
+}
+
+.teaser-action:hover {
+  background-color: var(--teaser-action-hover-background, var(--color-amber-100));
+}
+
+.teaser-action:focus-visible {
+  outline: 2px solid var(--color-amber-800);
+  outline-offset: 3px;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
