+        href={`${import.meta.env.BASE_URL}articles/${articleId}`}
+        aria-label={`Read article: ${title}`}
+        class="teaser-action inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-semibold transition-colors"
+    >
+        Read article <span aria-hidden="true" class="ml-2">&rarr;</span>
+    </a>
+</div>
