@@ -0,0 +1,239 @@
+import { loadKeys, signDocument, verifyDocument, exportPublicKey, importPublicKey, fingerprint } from './receipt-crypto.mjs';
+
+const $ = id => document.getElementById(id);
+const coffees = {
+  maple: { name: 'Maple Oat Latte', price: 550 },
+  espresso: { name: 'Dark Roast Espresso', price: 350 },
+  coldbrew: { name: 'Cold Brew', price: 450 }
+};
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+let activeTab = 'receipt';
+let keys;
+let trustedKey;
+let signedDocument;
+let busy = false;
+
+function status(message = '', error = false) {
+  $('app-status').textContent = message;
+  $('app-status').classList.toggle('error', error);
+}
+
+function clearVerification() {
+  $('verification-result').textContent = '';
+  $('verification-result').classList.remove('error');
+}
+
+function updatePreview() {
+  signedDocument = undefined;
+  $('document-actions').hidden = true;
+  const voucher = activeTab === 'voucher';
+  const coffee = coffees[$('coffee').value];
+  const quantity = Number($('quantity').value);
+  const amount = voucher ? Number($('amount').value) : coffee.price * (Number.isInteger(quantity) && quantity >= 1 && quantity <= 20 ? quantity : 0);
+  $('preview-type').textContent = voucher ? 'A LITTLE GIFT OF GOOD COFFEE' : 'COFFEE RECEIPT';
+  $('preview-recipient').textContent = $('recipient').value.trim() || 'Your name here';
+  $('preview-item').textContent = voucher ? 'A Daily Grind coffee gift' : `${coffee.name} × ${quantity || '—'}`;
+  $('preview-price').textContent = money(amount);
+  $('preview-total').textContent = money(amount);
+  $('total-label').textContent = voucher ? 'Gift value' : 'Total';
+  $('preview-note').textContent = $('note').value.trim();
+  $('preview-note').hidden = !$('note').value.trim();
+  $('preview-id').textContent = 'A little moment, made official.';
+  $('preview-date').textContent = '';
+  $('signature-state').classList.remove('signed');
+  $('signature-state').querySelector('strong').textContent = 'Ready for your signature';
+  $('signature-state').querySelector('div > span').textContent = 'Authenticity starts with a little click.';
+}
+
+function selectTab(tab) {
+  activeTab = tab;
+  document.querySelectorAll('[role="tab"]').forEach(button => {
+    const selected = button.dataset.tab === tab;
+    button.classList.toggle('active', selected);
+    button.setAttribute('aria-selected', String(selected));
+    button.tabIndex = selected ? 0 : -1;
+  });
+  const verifying = tab === 'verify';
+  $('create-panel').hidden = verifying;
+  $('verify-panel').hidden = !verifying;
+  status();
+  if (verifying) return;
+  const voucher = tab === 'voucher';
+  $('create-panel').setAttribute('aria-labelledby', `${tab}-tab`);
+  $('form-title').textContent = voucher ? 'Give a little daily happiness.' : 'Your coffee, on the record.';
+  $('form-intro').textContent = voucher ? 'A thoughtful coffee gift, signed with a little love.' : 'Create a signed record of your daily pick-me-up.';
+  $('recipient-label').textContent = voucher ? 'Recipient name' : 'Customer name';
+  $('receipt-fields').hidden = voucher;
+  $('quantity').disabled = voucher;
+  $('voucher-fields').hidden = !voucher;
+  $('sign-button').innerHTML = `<span aria-hidden="true">✧</span> Sign & create ${voucher ? 'voucher' : 'receipt'} <span>→</span>`;
+  updatePreview();
+}
+
+document.querySelectorAll('[role="tab"]').forEach((button, index, tabs) => {
+  button.addEventListener('click', () => selectTab(button.dataset.tab));
+  button.addEventListener('keydown', event => {
+    let next;
+    if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
+    if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
+    if (event.key === 'Home') next = 0;
+    if (event.key === 'End') next = tabs.length - 1;
+    if (next === undefined) return;
+    event.preventDefault();
+    tabs[next].focus();
+    selectTab(tabs[next].dataset.tab);
+  });
+});
+
+$('document-form').addEventListener('input', () => { updatePreview(); status(); });
+$('document-form').addEventListener('change', updatePreview);
+$('document-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!keys || busy) return;
+  const recipient = $('recipient').value.trim();
+  if (!recipient) { status('Please enter a customer or recipient name.', true); $('recipient').focus(); return; }
+  busy = true;
+  const form = $('document-form');
+  const controls = [...form.querySelectorAll('input, select, button')];
+  const disabledStates = controls.map(control => control.disabled);
+  controls.forEach(control => { control.disabled = true; });
+  try {
+    const voucher = activeTab === 'voucher';
+    const coffee = coffees[$('coffee').value];
+    const quantity = Number($('quantity').value);
+    const payload = {
+      type: voucher ? 'voucher' : 'receipt',
+      issuer: 'The Daily Grind',
+      id: `${voucher ? 'GIFT' : 'DG'}-${crypto.randomUUID()}`,
+      issuedAt: new Date().toISOString(),
+      recipient,
+      currency: 'USD',
+      amountCents: voucher ? Number($('amount').value) : coffee.price * quantity,
+      message: $('note').value.trim(),
+      ...(voucher ? {} : { item: coffee.name, quantity })
+    };
+    const created = await signDocument(payload, keys);
+    // Switching tabs during the asynchronous crypto operation discards the old preview.
+    if (activeTab !== payload.type) { status('Document signed. Return to the document type and sign again to download.'); return; }
+    signedDocument = created;
+    $('preview-id').textContent = payload.id;
+    $('preview-date').textContent = new Date(payload.issuedAt).toLocaleString();
+    $('signature-state').classList.add('signed');
+    $('signature-state').querySelector('strong').textContent = 'Digitally signed in this browser';
+    $('signature-state').querySelector('div > span').textContent = 'ECDSA P-256 · Integrity protected';
+    $('document-actions').hidden = false;
+    status(`${voucher ? 'Gift voucher' : 'Coffee receipt'} signed. Download the JSON to keep its verifiable signature.`);
+  } catch (error) {
+    status(`Could not sign the document. ${error.message}`, true);
+  } finally {
+    busy = false;
+    controls.forEach((control, i) => { control.disabled = disabledStates[i]; });
+    $('quantity').disabled = activeTab === 'voucher';
+  }
+});
+
+function downloadJSON(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = filename;
+  document.body.append(anchor);
+  anchor.click();
+  anchor.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+$('download-document').addEventListener('click', () => {
+  if (signedDocument) downloadJSON(signedDocument, `${signedDocument.payload.id}.json`);
+});
+$('export-key').addEventListener('click', async () => {
+  try {
+    downloadJSON(await exportPublicKey(keys.publicKey), 'daily-grind-public-key.json');
+    status('Public key exported. Share this key through a trusted channel so others can check your signatures.');
+  } catch (error) { status(`Could not export the public key. ${error.message}`, true); }
+});
+
+async function runVerification() {
+  if (!trustedKey) return;
+  const input = $('signed-json').value;
+  const verifyingKey = trustedKey;
+  $('verify-button').disabled = true;
+  clearVerification();
+  try {
+    if (input.length > 131072) throw new Error('Choose a document smaller than 128 KB.');
+    let document;
+    try { document = JSON.parse(input); } catch { throw new Error('Paste valid signed JSON or upload a signed document.'); }
+    const payload = await verifyDocument(document, verifyingKey);
+    if (input !== $('signed-json').value || verifyingKey !== trustedKey) return;
+    $('verification-result').textContent = `✓ Signature verified\n${payload.type === 'voucher' ? 'Gift voucher' : 'Coffee receipt'} · ${money(payload.amountCents)}\nFor ${payload.recipient}\nIssued ${new Date(payload.issuedAt).toLocaleString()}\n\nContents are intact and match your trusted key. This does not confirm payment, redemption status, or shop authorization.`;
+  } catch (error) {
+    if (input !== $('signed-json').value || verifyingKey !== trustedKey) return;
+    $('verification-result').classList.add('error');
+    $('verification-result').textContent = `Verification failed\n${error.message}`;
+  } finally { $('verify-button').disabled = !trustedKey; }
+}
+$('verify-button').addEventListener('click', runVerification);
+$('signed-json').addEventListener('input', clearVerification);
+$('verify-created').addEventListener('click', async () => {
+  if (!signedDocument) return;
+  $('signed-json').value = JSON.stringify(signedDocument, null, 2);
+  selectTab('verify');
+  await useOwnKey();
+  await runVerification();
+});
+
+async function readJSONFile(file) {
+  if (!file) return;
+  if (file.size > 131072) throw new Error('Choose a JSON file smaller than 128 KB.');
+  try { return JSON.parse(await file.text()); } catch { throw new Error('This file does not contain valid JSON.'); }
+}
+$('document-file').addEventListener('change', async event => {
+  clearVerification();
+  try {
+    const value = await readJSONFile(event.target.files[0]);
+    if (value !== undefined) { $('signed-json').value = JSON.stringify(value, null, 2); status('Document loaded. Select Verify signature to check it.'); }
+  } catch (error) { status(error.message, true); }
+  event.target.value = '';
+});
+
+async function showTrustedKey() {
+  $('trusted-fingerprint').textContent = await fingerprint(trustedKey);
+  $('verify-button').disabled = false;
+}
+async function useOwnKey() {
+  if (!keys) return;
+  trustedKey = keys.publicKey;
+  $('trusted-source').textContent = 'Using this browser’s signing key. To verify another issuer, import their public key from a source you trust.';
+  $('reset-key').hidden = true;
+  clearVerification();
+  await showTrustedKey();
+}
+$('reset-key').addEventListener('click', useOwnKey);
+$('public-key-file').addEventListener('change', async event => {
+  clearVerification();
+  try {
+    const value = await readJSONFile(event.target.files[0]);
+    if (value === undefined) return;
+    const imported = await importPublicKey(value);
+    trustedKey = imported;
+    $('trusted-source').textContent = 'Using your imported public key for this session. Confirm its fingerprint with the issuer through a trusted channel.';
+    $('reset-key').hidden = !keys;
+    await showTrustedKey();
+    status('Public key imported. Check its fingerprint with the issuer before relying on verification.');
+  } catch (error) { status(`Public key could not be imported. ${error.message}`, true); }
+  event.target.value = '';
+});
+
+async function initialize() {
+  try {
+    if (!globalThis.isSecureContext || !crypto.subtle) throw new Error('Digital signatures need HTTPS or localhost and a browser with Web Crypto support.');
+    keys = await loadKeys();
+    await useOwnKey();
+    $('sign-button').disabled = false;
+    $('export-key').disabled = false;
+  } catch (error) {
+    $('trusted-fingerprint').textContent = 'Local signing key unavailable. You can import a trusted public key to verify documents if Web Crypto is available.';
+    status(error.message, true);
+  }
+}
+initialize();
