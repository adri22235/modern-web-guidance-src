+++ b/tests/receipt-crypto.test.mjs
@@ -0,0 +1,59 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKeys, signDocument, verifyDocument, exportPublicKey, importPublicKey, fingerprint } from '../receipt-crypto.mjs';
+
+const receipt = {
+  type: 'receipt', issuer: 'The Daily Grind', currency: 'USD', id: 'DG-test',
+  issuedAt: '2026-11-08T12:00:00.000Z', recipient: 'Alex Morgan', amountCents: 550,
+  item: 'Maple Oat Latte', quantity: 1, message: 'Enjoy your morning!'
+};
+const { item, quantity, ...giftFields } = receipt;
+const voucher = { ...giftFields, type: 'voucher', id: 'GIFT-test', amountCents: 2500 };
+
+for (const payload of [receipt, voucher]) {
+  test(`${payload.type}: exported document verifies with independently imported public key`, async () => {
+    const keys = await generateKeys();
+    assert.equal(keys.privateKey.extractable, false);
+    await assert.rejects(crypto.subtle.exportKey('pkcs8', keys.privateKey));
+    const publicKey = await importPublicKey(JSON.parse(JSON.stringify(await exportPublicKey(keys.publicKey))));
+    const signed = JSON.parse(JSON.stringify(await signDocument(payload, keys)));
+    assert.deepEqual(await verifyDocument(signed, publicKey), payload);
+    assert.equal(await fingerprint(publicKey), signed.keyId);
+    const reordered = { ...signed, payload: Object.fromEntries(Object.entries(payload).reverse()) };
+    assert.deepEqual(await verifyDocument(reordered, publicKey), payload);
+  });
+}
+
+test('changes to amount, recipient, message, date, or type invalidate the signature', async () => {
+  const keys = await generateKeys();
+  const signed = await signDocument(receipt, keys);
+  for (const change of [{ amountCents: 1 }, { recipient: 'Mallory' }, { message: 'Changed' }, { issuedAt: '2026-11-09T12:00:00Z' }, { type: 'voucher' }]) {
+    await assert.rejects(verifyDocument({ ...signed, payload: { ...receipt, ...change } }, keys.publicKey), /Signature invalid/);
+  }
+});
+
+test('rejects a forged document even if it advertises the trusted fingerprint', async () => {
+  const trusted = await generateKeys();
+  const attacker = await generateKeys();
+  const forged = await signDocument(receipt, attacker);
+  await assert.rejects(verifyDocument(forged, trusted.publicKey), /Unknown issuer/);
+  forged.keyId = await fingerprint(trusted.publicKey);
+  await assert.rejects(verifyDocument(forged, trusted.publicKey), /Signature invalid/);
+});
+
+test('rejects malformed envelopes, unsupported algorithms, extra keys, and invalid payloads', async () => {
+  const keys = await generateKeys();
+  const signed = await signDocument(receipt, keys);
+  for (const invalid of [null, {}, { ...signed, algorithm: 'none' }, { ...signed, publicKey: 'untrusted' }, { ...signed, signature: 2 }, { ...signed, payload: { ...receipt, amountCents: -1 } }]) {
+    await assert.rejects(verifyDocument(invalid, keys.publicKey));
+  }
+  await assert.rejects(signDocument({ ...receipt, quantity: 0 }, keys));
+  await assert.rejects(importPublicKey({ format: 'other', key: 'bad' }));
+});
+
+test('corrupt signature cannot pass verification', async () => {
+  const keys = await generateKeys();
+  const signed = await signDocument(receipt, keys);
+  signed.signature = 'AAAA';
+  await assert.rejects(verifyDocument(signed, keys.publicKey), /Signature invalid/);
+});
