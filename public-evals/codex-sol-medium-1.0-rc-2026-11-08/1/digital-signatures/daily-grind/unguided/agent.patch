diff --git a/receipt-crypto.mjs b/receipt-crypto.mjs
new file mode 100644
index 0000000..7e70358
--- /dev/null
+++ b/receipt-crypto.mjs
@@ -0,0 +1,80 @@
+const encoder = new TextEncoder();
+const algorithm = { name: 'ECDSA', hash: 'SHA-256' };
+export const KEY_ALGORITHM = { name: 'ECDSA', namedCurve: 'P-256' };
+
+export function canonicalize(value) {
+  if (value === null || typeof value !== 'object') return JSON.stringify(value);
+  if (Array.isArray(value)) return '[' + value.map(canonicalize).join(',') + ']';
+  return '{' + Object.keys(value).sort().map(key => JSON.stringify(key) + ':' + canonicalize(value[key])).join(',') + '}';
+}
+
+const bytes = value => encoder.encode(canonicalize(value));
+export const toBase64 = buffer => btoa(String.fromCharCode(...new Uint8Array(buffer)));
+export const fromBase64 = value => Uint8Array.from(atob(value), character => character.charCodeAt(0));
+
+export async function generateKeys() {
+  return crypto.subtle.generateKey(KEY_ALGORITHM, false, ['sign', 'verify']);
+}
+
+export async function exportPublicKey(key) {
+  return { format: 'daily-grind-public-key-v1', algorithm: 'ECDSA-P256-SHA256', key: toBase64(await crypto.subtle.exportKey('spki', key)) };
+}
+
+export async function importPublicKey(document) {
+  if (document?.format !== 'daily-grind-public-key-v1' || document.algorithm !== 'ECDSA-P256-SHA256' || typeof document.key !== 'string') throw new Error('Choose a Daily Grind ECDSA public key file.');
+  return crypto.subtle.importKey('spki', fromBase64(document.key), KEY_ALGORITHM, true, ['verify']);
+}
+
+export async function fingerprint(key) {
+  return Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', await crypto.subtle.exportKey('spki', key))), n => n.toString(16).padStart(2, '0')).join('');
+}
+
+export async function signDocument(payload, keys) {
+  validatePayload(payload);
+  const document = { format: 'daily-grind-signed-document-v1', algorithm: 'ECDSA-P256-SHA256', keyId: await fingerprint(keys.publicKey), payload };
+  return { ...document, signature: toBase64(await crypto.subtle.sign(algorithm, keys.privateKey, bytes(document))) };
+}
+
+export function validatePayload(payload) {
+  if (!payload || !['receipt', 'voucher'].includes(payload.type) || payload.issuer !== 'The Daily Grind' || payload.currency !== 'USD' || typeof payload.id !== 'string' || !payload.id || !Number.isFinite(Date.parse(payload.issuedAt)) || !Number.isSafeInteger(payload.amountCents) || payload.amountCents <= 0 || typeof payload.recipient !== 'string' || !payload.recipient.trim()) throw new Error('The document contains invalid receipt or voucher details.');
+  if (payload.type === 'receipt' && (typeof payload.item !== 'string' || !Number.isInteger(payload.quantity) || payload.quantity < 1 || payload.quantity > 20)) throw new Error('The receipt contains invalid order details.');
+  if (payload.type === 'voucher' && typeof payload.message !== 'string') throw new Error('The voucher contains an invalid message.');
+}
+
+export async function verifyDocument(document, trustedPublicKey) {
+  if (!document || document.format !== 'daily-grind-signed-document-v1' || document.algorithm !== 'ECDSA-P256-SHA256' || typeof document.signature !== 'string' || Object.keys(document).sort().join(',') !== 'algorithm,format,keyId,payload,signature') throw new Error('This is not a supported signed Daily Grind document.');
+  validatePayload(document.payload);
+  if (document.keyId !== await fingerprint(trustedPublicKey)) throw new Error('Unknown issuer. The document does not match your trusted public key.');
+  const { signature, ...signedData } = document;
+  const valid = await crypto.subtle.verify(algorithm, trustedPublicKey, fromBase64(signature), bytes(signedData));
+  if (!valid) throw new Error('Signature invalid. The document was changed or the signature is incorrect.');
+  return document.payload;
+}
+
+export async function loadKeys() {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-signing', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('keys');
+    request.onerror = () => reject(new Error('Browser key storage is unavailable. Enable site storage and try again.'));
+    request.onsuccess = () => {
+      const db = request.result;
+      const transaction = db.transaction('keys', 'readonly');
+      const read = transaction.objectStore('keys').get('issuer');
+      read.onerror = () => { db.close(); reject(new Error('Unable to read the signing key.')); };
+      read.onsuccess = async () => {
+        if (read.result) { db.close(); resolve(read.result); return; }
+        try {
+          const generated = await generateKeys();
+          const write = db.transaction('keys', 'readwrite');
+          const store = write.objectStore('keys');
+          // Recheck in the write transaction to coordinate simultaneous tabs.
+          const existing = store.get('issuer');
+          let selected;
+          existing.onsuccess = () => { selected = existing.result || generated; if (!existing.result) store.put(selected, 'issuer'); };
+          write.oncomplete = () => { db.close(); resolve(selected); };
+          write.onabort = write.onerror = () => { db.close(); reject(new Error('Unable to save the signing key. Enable site storage and try again.')); };
+        } catch (error) { db.close(); reject(error); }
+      };
+    };
+  });
+}
