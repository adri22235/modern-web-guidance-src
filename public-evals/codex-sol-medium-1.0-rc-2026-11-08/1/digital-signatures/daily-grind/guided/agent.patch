diff --git a/signatures.mjs b/signatures.mjs
new file mode 100644
index 0000000..d96de9e
--- /dev/null
+++ b/signatures.mjs
@@ -0,0 +1,105 @@
+const encoder = new TextEncoder();
+const DOMAIN = encoder.encode('daily-grind/sample-documents/v1');
+const SUITES = {
+  'ML-DSA-65': { generate: 'ML-DSA-65', format: 'raw-public', operation: { name: 'ML-DSA-65', context: DOMAIN } },
+  Ed25519: { generate: 'Ed25519', format: 'raw', operation: 'Ed25519' },
+  'ECDSA-P256-SHA256': { generate: { name: 'ECDSA', namedCurve: 'P-256' }, format: 'raw', operation: { name: 'ECDSA', hash: 'SHA-256' } },
+};
+const own = (object, key) => Object.hasOwn(object, key);
+function suiteFor(algorithm) {
+  if (!own(SUITES, algorithm)) throw new Error('Unsupported signature algorithm.');
+  return SUITES[algorithm];
+}
+function exactKeys(value, keys) {
+  if (!value || typeof value !== 'object' || Array.isArray(value) ||
+      Object.keys(value).sort().join(',') !== [...keys].sort().join(',')) {
+    throw new Error('Invalid document or key format.');
+  }
+}
+export function canonical(value) {
+  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`;
+  if (value && typeof value === 'object') {
+    return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`;
+  }
+  return JSON.stringify(value);
+}
+function encode64(bytes) {
+  return btoa(Array.from(new Uint8Array(bytes), byte => String.fromCharCode(byte)).join(''));
+}
+function decode64(value) {
+  if (typeof value !== 'string' || !value || value.length > 20000 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) {
+    throw new Error('Invalid base64 key or signature.');
+  }
+  return Uint8Array.from(atob(value), character => character.charCodeAt(0));
+}
+async function fingerprint(bytes) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+  return Array.from(digest, byte => byte.toString(16).padStart(2, '0')).join('');
+}
+function signingBytes(unsigned) {
+  const payload = encoder.encode(canonical(unsigned));
+  if (unsigned.algorithm === 'ML-DSA-65') return payload;
+  // Classical algorithms ignore a context dictionary: explicitly frame the domain.
+  const framed = new Uint8Array(1 + DOMAIN.length + payload.length);
+  framed[0] = DOMAIN.length;
+  framed.set(DOMAIN, 1);
+  framed.set(payload, DOMAIN.length + 1);
+  return framed;
+}
+export function validatePayload(payload) {
+  const common = ['kind', 'id', 'issuedAt', 'issuer', 'sample', 'currency', 'amountCents'];
+  if (!payload || !['receipt', 'voucher'].includes(payload.kind)) throw new Error('Expected a coffee receipt or gift voucher.');
+  exactKeys(payload, [...common, ...(payload.kind === 'receipt' ? ['item', 'quantity', 'unitCents'] : ['recipient'])]);
+  if (payload.issuer !== 'The Daily Grind' || payload.sample !== true || payload.currency !== 'USD' ||
+      typeof payload.id !== 'string' || !/^[0-9a-f-]{36}$/i.test(payload.id) ||
+      typeof payload.issuedAt !== 'string' || !Number.isFinite(Date.parse(payload.issuedAt)) ||
+      !Number.isSafeInteger(payload.amountCents) || payload.amountCents <= 0) throw new Error('Invalid document details.');
+  if (payload.kind === 'receipt') {
+    if (typeof payload.item !== 'string' || !payload.item.trim() || payload.item.length > 100 ||
+        !Number.isInteger(payload.quantity) || payload.quantity < 1 || payload.quantity > 20 ||
+        !Number.isSafeInteger(payload.unitCents) || payload.unitCents <= 0 ||
+        payload.amountCents !== payload.unitCents * payload.quantity) throw new Error('Invalid receipt amount or quantity.');
+  } else if (typeof payload.recipient !== 'string' || !payload.recipient.trim() || payload.recipient.length > 100 ||
+      payload.amountCents < 500 || payload.amountCents > 50000) throw new Error('Invalid voucher recipient or value.');
+}
+export async function createSigner() {
+  if (!globalThis.crypto?.subtle) throw new Error('Browser cryptography requires HTTPS or localhost.');
+  const algorithms = ['Ed25519', 'ECDSA-P256-SHA256'];
+  if (globalThis.SubtleCrypto?.supports?.('sign', 'ML-DSA-65') &&
+      globalThis.SubtleCrypto.supports('verify', 'ML-DSA-65')) algorithms.unshift('ML-DSA-65');
+  for (const algorithm of algorithms) {
+    const suite = suiteFor(algorithm);
+    try {
+      const keyPair = await crypto.subtle.generateKey(suite.generate, false, ['sign', 'verify']);
+      const raw = await crypto.subtle.exportKey(suite.format, keyPair.publicKey);
+      const publicKey = { version: 1, algorithm, publicKey: encode64(raw), keyId: await fingerprint(raw) };
+      return { algorithm, privateKey: keyPair.privateKey, publicKey };
+    } catch (error) {
+      if (error.name !== 'NotSupportedError') throw error;
+    }
+  }
+  throw new Error('This browser does not support the required signature algorithms.');
+}
+export async function signDocument(signer, payload) {
+  validatePayload(payload);
+  const unsigned = { version: 1, algorithm: signer.algorithm, keyId: signer.publicKey.keyId, payload };
+  const signature = await crypto.subtle.sign(suiteFor(signer.algorithm).operation, signer.privateKey, signingBytes(unsigned));
+  return { ...unsigned, signature: encode64(signature) };
+}
+export async function verifyDocument(document, trustedKey) {
+  exactKeys(document, ['version', 'algorithm', 'keyId', 'payload', 'signature']);
+  exactKeys(trustedKey, ['version', 'algorithm', 'keyId', 'publicKey']);
+  if (document.version !== 1 || trustedKey.version !== 1) throw new Error('Unsupported document or key version.');
+  const suite = suiteFor(document.algorithm);
+  validatePayload(document.payload);
+  const raw = decode64(trustedKey.publicKey);
+  const keyId = await fingerprint(raw);
+  if (keyId !== trustedKey.keyId || document.keyId !== keyId || document.algorithm !== trustedKey.algorithm) {
+    throw new Error('Signer does not match the trusted public key. Obtain the correct key independently.');
+  }
+  const publicKey = await crypto.subtle.importKey(suite.format, raw, suite.generate, false, ['verify']);
+  const { signature, ...unsigned } = document;
+  const valid = await crypto.subtle.verify(suite.operation, publicKey, decode64(signature), signingBytes(unsigned));
+  if (!valid) throw new Error('Signature is invalid. The document was changed or signed with a different key.');
+  return { payload: document.payload, keyId, algorithm: document.algorithm };
+}
diff --git a/signing-ui.mjs b/signing-ui.mjs
new file mode 100644
index 0000000..c992106
--- /dev/null
+++ b/signing-ui.mjs
@@ -0,0 +1,129 @@
+import { createSigner, signDocument, verifyDocument } from './signatures.mjs';
+
+const $ = id => document.getElementById(id);
+const money = cents => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(cents / 100);
+const coffees = {
+  maple: { item: 'Maple Oat Latte', unitCents: 550 },
+  espresso: { item: 'Dark Roast Espresso', unitCents: 350 },
+  coldbrew: { item: 'Cold Brew', unitCents: 450 },
+};
+let signer;
+let signedDocument;
+function status(id, message, state = '') {
+  $(id).textContent = message;
+  $(id).dataset.state = state;
+}
+function download(value, filename) {
+  const url = URL.createObjectURL(new Blob([JSON.stringify(value, null, 2)], { type: 'application/json' }));
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = filename;
+  anchor.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+function parseJSON(value, limit) {
+  if (value.length > limit) throw new Error('This file is too large. Choose a Daily Grind JSON document.');
+  try { return JSON.parse(value); } catch { throw new Error('Enter valid JSON or upload a JSON file.'); }
+}
+function clearVerification() {
+  status('verify-status', 'Document or key changed. Verify again to check its signature.');
+  $('verify-json').removeAttribute('aria-invalid');
+  $('trusted-key').removeAttribute('aria-invalid');
+}
+for (const id of ['verify-json', 'trusted-key']) $(id).addEventListener('input', clearVerification);
+for (const [fileId, textId, limit] of [['document-file', 'verify-json', 100000], ['key-file', 'trusted-key', 20000]]) {
+  $(fileId).addEventListener('change', async event => {
+    const file = event.target.files[0];
+    if (!file) return;
+    clearVerification();
+    try {
+      if (file.size > limit) throw new Error('This file is too large. Choose a Daily Grind JSON file.');
+      const value = await file.text();
+      parseJSON(value, limit);
+      $(textId).value = value;
+      status('verify-status', 'File loaded. Verify its signature against your trusted key.');
+    } catch (error) { status('verify-status', error.message, 'error'); }
+    event.target.value = '';
+  });
+}
+$('sign-form').addEventListener('change', () => {
+  const isVoucher = new FormData($('sign-form')).get('kind') === 'voucher';
+  $('receipt-fields').hidden = isVoucher;
+  $('voucher-fields').hidden = !isVoucher;
+  for (const input of $('receipt-fields').querySelectorAll('input, select')) input.disabled = isVoucher;
+  for (const input of $('voucher-fields').querySelectorAll('input')) input.disabled = !isVoucher;
+});
+$('sign-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  $('sign-button').disabled = true;
+  $('signed-output').hidden = false;
+  try {
+    const data = new FormData(event.currentTarget);
+    const kind = data.get('kind');
+    const payload = {
+      kind, id: crypto.randomUUID(), issuedAt: new Date().toISOString(),
+      issuer: 'The Daily Grind', sample: true, currency: 'USD',
+    };
+    if (kind === 'receipt') {
+      const coffee = coffees[data.get('coffee')];
+      Object.assign(payload, coffee, { quantity: Number(data.get('quantity')), amountCents: coffee.unitCents * Number(data.get('quantity')) });
+    } else {
+      Object.assign(payload, { recipient: data.get('recipient').trim(), amountCents: Math.round(Number(data.get('amount')) * 100) });
+    }
+    signedDocument = await signDocument(signer, payload);
+    $('signed-json').value = JSON.stringify(signedDocument, null, 2);
+    status('sign-status', `Signed sample ${kind} · ${money(payload.amountCents)} · ${signer.algorithm}. Save your document and public key before leaving this page.`, 'success');
+    $('download-document').disabled = false;
+    $('use-document').disabled = false;
+  } catch (error) {
+    signedDocument = undefined;
+    $('signed-json').value = '';
+    $('download-document').disabled = true;
+    $('use-document').disabled = true;
+    status('sign-status', error.message, 'error');
+  } finally { $('sign-button').disabled = false; }
+});
+$('download-document').addEventListener('click', () => {
+  if (signedDocument) download(signedDocument, `daily-grind-${signedDocument.payload.kind}-${signedDocument.payload.id}.json`);
+});
+$('download-key').addEventListener('click', () => download(signer.publicKey, 'daily-grind-session-public-key.json'));
+$('use-document').addEventListener('click', () => {
+  $('verify-json').value = JSON.stringify(signedDocument, null, 2);
+  clearVerification();
+  $('verify-json').focus();
+});
+$('verify-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const documentText = $('verify-json').value;
+  const keyText = $('trusted-key').value;
+  $('verify-button').disabled = true;
+  status('verify-status', 'Checking signature…');
+  try {
+    const result = await verifyDocument(parseJSON(documentText, 100000), parseJSON(keyText, 20000));
+    if (documentText !== $('verify-json').value || keyText !== $('trusted-key').value) return clearVerification();
+    const { payload } = result;
+    const details = payload.kind === 'receipt' ? `${payload.quantity} × ${payload.item}` : `For ${payload.recipient}`;
+    status('verify-status', `Valid signature against the trusted key · Sample ${payload.kind} · ${details} · ${money(payload.amountCents)} · Issued ${new Date(payload.issuedAt).toLocaleString()} · ${result.algorithm} · SHA-256 key fingerprint: ${result.keyId}. This does not establish payment or redeemability.`, 'success');
+  } catch (error) {
+    if (documentText !== $('verify-json').value || keyText !== $('trusted-key').value) return clearVerification();
+    status('verify-status', `Verification failed: ${error.name === 'NotSupportedError' ? 'This browser cannot verify this algorithm. Use a compatible browser.' : error.message}`, 'error');
+  } finally { $('verify-button').disabled = false; }
+});
+async function initialize() {
+  if (!globalThis.isSecureContext || !globalThis.crypto?.subtle) {
+    status('key-status', 'Signing and verification require a secure HTTPS connection and Web Crypto support.', 'error');
+    return;
+  }
+  $('verify-button').disabled = false;
+  try {
+    signer = await createSigner();
+    // Only a key created locally is prefilled; uploaded documents never supply trust.
+    if (!$('trusted-key').value) $('trusted-key').value = JSON.stringify(signer.publicKey, null, 2);
+    $('fingerprint').textContent = `SHA-256 fingerprint: ${signer.publicKey.keyId}`;
+    const label = signer.algorithm === 'ML-DSA-65' ? 'Quantum-resistant' : 'Classical';
+    status('key-status', `${label} signing ready · ${signer.algorithm}. Session key expires when you leave or reload this page.`, 'success');
+    $('sign-button').disabled = false;
+    $('download-key').disabled = false;
+  } catch (error) { status('key-status', `Signing unavailable: ${error.message} You can still verify using a trusted public key.`, 'error'); }
+}
+initialize();
diff --git a/tests/signatures.test.mjs b/tests/signatures.test.mjs
new file mode 100644
index 0000000..45f7a4f
--- /dev/null
+++ b/tests/signatures.test.mjs
@@ -0,0 +1,106 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createSigner, signDocument, verifyDocument } from '../signatures.mjs';
+
+const receipt = () => ({
+  kind: 'receipt', id: crypto.randomUUID(), issuedAt: new Date().toISOString(),
+  issuer: 'The Daily Grind', sample: true, currency: 'USD',
+  item: 'Maple Oat Latte', quantity: 2, unitCents: 550, amountCents: 1100,
+});
+const voucher = () => ({
+  kind: 'voucher', id: crypto.randomUUID(), issuedAt: new Date().toISOString(),
+  issuer: 'The Daily Grind', sample: true, currency: 'USD', recipient: 'Alex', amountCents: 2500,
+});
+
+test('session keys are non-extractable and sign both document kinds', async () => {
+  const signer = await createSigner();
+  assert.equal(signer.privateKey.extractable, false);
+  await assert.rejects(crypto.subtle.exportKey('pkcs8', signer.privateKey));
+  for (const payload of [receipt(), voucher()]) {
+    const document = await signDocument(signer, payload);
+    const result = await verifyDocument(JSON.parse(JSON.stringify(document)), signer.publicKey);
+    assert.deepEqual(result.payload, payload);
+    assert.equal(result.keyId.length, 64);
+  }
+});
+
+test('rejects tampering with signed fields, signatures, and envelope metadata', async () => {
+  const signer = await createSigner();
+  const original = await signDocument(signer, voucher());
+  const mutations = [
+    d => { d.payload.amountCents = 5000; },
+    d => { d.payload.recipient = 'Someone else'; },
+    d => { d.payload.issuedAt = '2025-01-01T00:00:00.000Z'; },
+    d => { d.payload.id = crypto.randomUUID(); },
+    d => { d.payload.sample = false; },
+    d => { d.payload = receipt(); },
+    d => { d.signature = (d.signature[0] === 'A' ? 'B' : 'A') + d.signature.slice(1); },
+    d => { d.algorithm = 'ECDSA-P256-SHA256'; },
+    d => { d.algorithm = '__proto__'; },
+    d => { d.version = 2; },
+    d => { d.publicKey = signer.publicKey; },
+  ];
+  for (const mutate of mutations) {
+    const edited = structuredClone(original);
+    mutate(edited);
+    await assert.rejects(verifyDocument(edited, signer.publicKey));
+  }
+});
+
+test('rejects another signer even when its key is supplied inside a document', async () => {
+  const trusted = await createSigner();
+  const attacker = await createSigner();
+  const document = await signDocument(attacker, receipt());
+  await assert.rejects(verifyDocument(document, trusted.publicKey), /trusted public key/);
+  document.keyId = trusted.publicKey.keyId;
+  await assert.rejects(verifyDocument(document, trusted.publicKey), /Signature is invalid/);
+});
+
+test('rejects malformed input and inconsistent receipt totals', async () => {
+  const signer = await createSigner();
+  const document = await signDocument(signer, receipt());
+  for (const invalid of [null, [], {}, { ...document, signature: 'not-base64' }, { ...document, signature: '' }]) {
+    await assert.rejects(verifyDocument(invalid, signer.publicKey));
+  }
+  await assert.rejects(signDocument(signer, { ...receipt(), amountCents: 1 }));
+  await assert.rejects(signDocument(signer, { ...voucher(), recipient: '   ' }));
+  await assert.rejects(signDocument(signer, { ...voucher(), amountCents: 50001 }));
+  await assert.rejects(verifyDocument(document, { ...signer.publicKey, keyId: 'forged' }));
+});
+
+test('JSON object field order does not affect verification', async () => {
+  const signer = await createSigner();
+  const document = await signDocument(signer, receipt());
+  document.payload = Object.fromEntries(Object.entries(document.payload).reverse());
+  await verifyDocument(document, signer.publicKey);
+});
+
+test('classical fallback works without SubtleCrypto.supports and falls back from Ed25519 to P-256', async () => {
+  const originalCrypto = Object.getOwnPropertyDescriptor(globalThis, 'crypto');
+  const originalSubtle = Object.getOwnPropertyDescriptor(globalThis, 'SubtleCrypto');
+  const realCrypto = globalThis.crypto;
+  try {
+    Object.defineProperty(globalThis, 'SubtleCrypto', { configurable: true, value: undefined });
+    const edSigner = await createSigner();
+    assert.equal(edSigner.algorithm, 'Ed25519');
+    await verifyDocument(await signDocument(edSigner, receipt()), edSigner.publicKey);
+    const subtle = new Proxy(realCrypto.subtle, {
+      get(target, property) {
+        if (property === 'generateKey') return async (algorithm, ...args) => {
+          if (algorithm === 'Ed25519') throw new DOMException('Not supported', 'NotSupportedError');
+          return target.generateKey(algorithm, ...args);
+        };
+        const value = Reflect.get(target, property, target);
+        return typeof value === 'function' ? value.bind(target) : value;
+      },
+    });
+    Object.defineProperty(globalThis, 'crypto', { configurable: true, value: { subtle, randomUUID: realCrypto.randomUUID.bind(realCrypto) } });
+    const signer = await createSigner();
+    assert.equal(signer.algorithm, 'ECDSA-P256-SHA256');
+    await verifyDocument(await signDocument(signer, voucher()), signer.publicKey);
+  } finally {
+    Object.defineProperty(globalThis, 'crypto', originalCrypto);
+    if (originalSubtle) Object.defineProperty(globalThis, 'SubtleCrypto', originalSubtle);
+    else delete globalThis.SubtleCrypto;
+  }
+});
