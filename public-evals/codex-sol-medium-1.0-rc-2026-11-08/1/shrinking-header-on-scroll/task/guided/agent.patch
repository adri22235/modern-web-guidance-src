+  <script>
+    (function () {
+      var supportQuery = '(animation-timeline: scroll()) and (animation-range: 0% 100%)';
+      if (window.CSS && window.CSS.supports && window.CSS.supports(supportQuery)) return;
+
+      // Older browsers use the same linear 120px range as the native timeline.
+      var nav = document.querySelector('nav');
+      var motion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var framePending = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function updateNavigation() {
+        framePending = false;
+        if (motion.matches) {
+          nav.style.removeProperty('height');
+          return;
+        }
+        var scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.max(0, Math.min(1, scrollTop / 120));
+        // Both responsive sizes shrink by 1.25rem; no layout reads are needed.
+        nav.style.height = 'calc(var(--nav-height) - ' + (1.25 * progress) + 'rem)';
+      }
+
+      function scheduleUpdate() {
+        if (framePending) return;
+        framePending = true;
+        requestFrame(updateNavigation);
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (motion.addEventListener) {
+        motion.addEventListener('change', scheduleUpdate);
+      } else {
+        motion.addListener(scheduleUpdate);
+      }
+      updateNavigation();
+    }());
+  </script>
