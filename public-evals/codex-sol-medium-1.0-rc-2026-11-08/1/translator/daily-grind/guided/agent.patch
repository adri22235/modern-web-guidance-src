diff --git a/translation.js b/translation.js
new file mode 100644
index 0000000..ea1d244
--- /dev/null
+++ b/translation.js
@@ -0,0 +1,110 @@
+(() => {
+  const language = document.getElementById('language');
+  const button = document.getElementById('translate');
+  const status = document.getElementById('translation-status');
+  const paragraphs = [...document.querySelectorAll('[data-translate]')];
+  // Always translate the originals so language switches never compound errors.
+  const originals = paragraphs.map((paragraph) => paragraph.textContent);
+  const translations = new Map([['en', originals]]);
+  let currentLanguage = 'en';
+  let selectionVersion = 0;
+  let readyOptions = null;
+  let busy = false;
+
+  if (!('Translator' in window) || !window.isSecureContext) {
+    status.textContent = 'On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome, on a secure connection. The original English text is available below.';
+    return;
+  }
+
+  language.disabled = false;
+  status.textContent = 'Choose a language, then select Translate. Select English to restore the original text.';
+
+  function display(targetLanguage, text) {
+    paragraphs.forEach((paragraph, index) => {
+      paragraph.textContent = text[index];
+      paragraph.lang = targetLanguage;
+    });
+    currentLanguage = targetLanguage;
+  }
+
+  language.addEventListener('change', async () => {
+    const version = ++selectionVersion;
+    const targetLanguage = language.value;
+    readyOptions = null;
+    button.disabled = true;
+
+    if (translations.has(targetLanguage)) {
+      display(targetLanguage, translations.get(targetLanguage));
+      status.textContent = targetLanguage === 'en'
+        ? 'Original English text restored.'
+        : 'Saved translation displayed. Translation stays on this device.';
+      return;
+    }
+
+    status.textContent = 'Checking on-device language support…';
+    const options = { sourceLanguage: 'en', targetLanguage };
+    try {
+      const availability = await window.Translator.availability(options);
+      if (version !== selectionVersion) return;
+      if (!['available', 'downloadable', 'downloading'].includes(availability)) {
+        status.textContent = 'This language is unavailable on your device. Choose another language or English to restore the original text.';
+        return;
+      }
+      readyOptions = options;
+      button.disabled = false;
+      status.textContent = availability === 'available'
+        ? 'Ready to translate on your device. Select Translate.'
+        : 'Select Translate to download the language pack. An internet connection may be needed for the download.';
+    } catch {
+      if (version !== selectionVersion) return;
+      status.textContent = 'Could not check language support. Choose another language or select this language again to retry.';
+    }
+  });
+
+  button.addEventListener('click', async () => {
+    if (busy || !readyOptions || readyOptions.targetLanguage !== language.value) return;
+    const options = readyOptions;
+    const targetLanguage = options.targetLanguage;
+    busy = true;
+    language.disabled = true;
+    button.disabled = true;
+    status.textContent = 'Preparing on-device translation…';
+    let translator;
+
+    try {
+      // Invoke create directly from the click, before any await, to retain
+      // the user activation required for downloading a language pack.
+      translator = await window.Translator.create({
+        ...options,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            status.textContent = `Downloading language pack: ${Math.round(event.loaded * 100)}%. Keep this page open.`;
+          });
+        },
+      });
+      const results = [];
+      for (const original of originals) {
+        status.textContent = `Translating on your device: ${results.length + 1} of ${originals.length}…`;
+        const result = await translator.translate(original);
+        if (typeof result !== 'string' || !result.trim()) {
+          throw new Error('Empty translation');
+        }
+        results.push(result);
+      }
+      // Commit only after every paragraph succeeds, avoiding mixed languages.
+      translations.set(targetLanguage, results);
+      display(targetLanguage, results);
+      status.textContent = 'Coffee descriptions and story translated on your device. Select English to restore the originals.';
+    } catch {
+      status.textContent = 'Translation could not finish. Your displayed text has been kept. Check your connection and select Translate to retry, or choose English.';
+    } finally {
+      try {
+        translator?.destroy();
+      } finally {
+        busy = false;
+        language.disabled = false;
+        button.disabled = currentLanguage === targetLanguage;
+      }
+    }
+  });
+})();
