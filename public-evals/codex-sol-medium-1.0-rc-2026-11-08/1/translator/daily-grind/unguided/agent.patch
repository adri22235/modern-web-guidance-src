+(() => {
+  'use strict';
+
+  // Bundled copy keeps translation local and available without a model download.
+  const translations = {
+    en: {},
+    es: {
+      menuEyebrow: 'Para tu ritual de cada día',
+      menuHeading: 'Favoritos de temporada',
+      latteName: 'Latte de avena y arce',
+      latteDescription: 'Cremosa leche de avena con un toque de sirope de arce de Vermont.',
+      espressoName: 'Espresso de tueste oscuro',
+      espressoDescription: 'Intenso, con notas ahumadas e ideal para empezar la mañana con energía.',
+      coldBrewName: 'Café de extracción en frío',
+      coldBrewDescription: 'Infusionado durante 18 horas para lograr la máxima suavidad.',
+      details: 'Ver detalles',
+      storyEyebrow: 'Nuestra historia',
+      storyHeading: 'Buen café. Mejor compañía.',
+      storyFirst: 'En The Daily Grind, creemos que un gran día empieza con una taza preparada con esmero. En cada café combinamos granos de origen ético con un tueste local.',
+      storySecond: 'Ya sea para disfrutar de tu ritual matutino o ponerte al día con un amigo, aquí hay un lugar para ti. Ven por el café. Quédate por la compañía.'
+    },
+    fr: {
+      menuEyebrow: 'Pour votre rituel quotidien',
+      menuHeading: 'Les favoris de saison',
+      latteName: 'Latte à l’avoine et à l’érable',
+      latteDescription: 'Du lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.',
+      espressoName: 'Espresso à torréfaction foncée',
+      espressoDescription: 'Intense et fumé, idéal pour faire le plein d’énergie le matin.',
+      coldBrewName: 'Café infusé à froid',
+      coldBrewDescription: 'Infusé pendant 18 heures pour une douceur incomparable.',
+      details: 'Voir les détails',
+      storyEyebrow: 'Notre histoire',
+      storyHeading: 'Un bon café. Une belle compagnie.',
+      storyFirst: 'Chez The Daily Grind, nous pensons qu’une belle journée commence par une tasse préparée avec soin. Chaque café associe des grains issus d’un approvisionnement éthique à une torréfaction locale.',
+      storySecond: 'Que vous savouriez votre rituel du matin ou retrouviez un ami, vous avez votre place ici. Venez pour le café. Restez pour la compagnie.'
+    },
+    de: {
+      menuEyebrow: 'Für dein tägliches Ritual',
+      menuHeading: 'Unsere Saisonfavoriten',
+      latteName: 'Haferlatte mit Ahornsirup',
+      latteDescription: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      espressoName: 'Dunkel gerösteter Espresso',
+      espressoDescription: 'Kräftig, rauchig und perfekt für einen schwungvollen Start in den Morgen.',
+      coldBrewName: 'Kalt gebrühter Kaffee',
+      coldBrewDescription: '18 Stunden lang gezogen für einen besonders milden Geschmack.',
+      details: 'Details ansehen',
+      storyEyebrow: 'Unsere Geschichte',
+      storyHeading: 'Guter Kaffee. Beste Gesellschaft.',
+      storyFirst: 'Bei The Daily Grind glauben wir, dass ein guter Tag mit einer sorgfältig zubereiteten Tasse Kaffee beginnt. In jeder Tasse verbinden wir ethisch bezogene Bohnen mit lokaler Röstkunst.',
+      storySecond: 'Ob du dein Morgenritual genießt oder dich mit Freunden triffst – hier ist ein Platz für dich. Komm wegen des Kaffees. Bleib wegen der Gesellschaft.'
+    },
+    ja: {
+      menuEyebrow: '毎日のひとときに',
+      menuHeading: '季節のおすすめ',
+      latteName: 'メープルオーツラテ',
+      latteDescription: 'クリーミーなオーツミルクに、バーモント州産メープルシロップをほんのり加えました。',
+      espressoName: '深煎りエスプレッソ',
+      espressoDescription: '力強くスモーキーな味わい。朝の目覚めにぴったりの一杯です。',
+      coldBrewName: '水出しコーヒー',
+      coldBrewDescription: '18時間かけてじっくり抽出した、なめらかな口あたり。',
+      details: '詳しく見る',
+      storyEyebrow: '私たちのストーリー',
+      storyHeading: 'おいしいコーヒーと、心地よい時間。',
+      storyFirst: 'The Daily Grindは、丁寧に淹れた一杯が素敵な一日の始まりになると信じています。倫理的に調達したコーヒー豆と地元での焙煎を、一杯一杯に込めています。',
+      storySecond: 'いつもの朝のひとときにも、友人との語らいにも。ここにはあなたの居場所があります。コーヒーをきっかけに、心地よい時間をお過ごしください。'
+    }
+  };
+
+  const storageKey = 'daily-grind-language';
+  const selector = document.getElementById('language-select');
+  const status = document.getElementById('language-status');
+  const elements = document.querySelectorAll('[data-i18n]');
+  const regions = document.querySelectorAll('[data-language-region]');
+
+  // The original HTML is the English source and the no-JavaScript fallback.
+  elements.forEach((element) => {
+    translations.en[element.dataset.i18n] = element.textContent;
+  });
+
+  function applyLanguage(language, announce = false) {
+    const selected = Object.hasOwn(translations, language) ? language : 'en';
+    elements.forEach((element) => {
+      const key = element.dataset.i18n;
+      element.textContent = translations[selected][key] ?? translations.en[key];
+    });
+    // The navigation and other page chrome remain English.
+    regions.forEach((region) => { region.lang = selected; });
+    selector.value = selected;
+    if (announce) {
+      status.textContent = `Menu and story language: ${selector.selectedOptions[0].textContent}.`;
+    }
+  }
+
+  let savedLanguage = 'en';
+  try {
+    savedLanguage = localStorage.getItem(storageKey) || 'en';
+  } catch {
+    // Translation still works if storage is unavailable or blocked.
+  }
+  applyLanguage(savedLanguage);
+  selector.addEventListener('change', () => {
+    applyLanguage(selector.value, true);
+    try {
+      localStorage.setItem(storageKey, selector.value);
+    } catch {
+      // A preference can be used for this visit without being persisted.
+    }
+  });
+  document.getElementById('language-panel').hidden = false;
+})();
