diff --git a/src/scripts/translation.ts b/src/scripts/translation.ts
new file mode 100644
index 0000000..132bebd
--- /dev/null
+++ b/src/scripts/translation.ts
@@ -0,0 +1,179 @@
+type Availability = 'unavailable' | 'downloadable' | 'downloading' | 'available';
+type LanguagePair = { sourceLanguage: string; targetLanguage: string };
+type LocalTranslator = {
+  translate(text: string): Promise<string>;
+  destroy(): void;
+};
+type TranslatorAPI = {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor: (monitor: EventTarget) => void;
+  }): Promise<LocalTranslator>;
+};
+
+export function initializeTranslation(): (() => void) | undefined {
+  const control = document.querySelector<HTMLElement>('[data-translation-control]');
+  if (!control) return;
+  const select = control.querySelector<HTMLSelectElement>('select')!;
+  const translateButton = control.querySelector<HTMLButtonElement>('[data-translate-button]')!;
+  const restoreButton = control.querySelector<HTMLButtonElement>('[data-restore-button]')!;
+  const status = control.querySelector<HTMLElement>('[role="status"]')!;
+  const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-translate]'));
+  const originalAttributes = roots.map(root => ({ root, lang: root.getAttribute('lang'), dir: root.getAttribute('dir') }));
+  const originals = new Map<Text, string>();
+  for (const root of roots) {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+      acceptNode(node) {
+        return node.textContent?.trim() && !node.parentElement?.closest('script, style, code, pre, [translate="no"], [data-translation-control]')
+          ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+      },
+    });
+    while (walker.nextNode()) {
+      const node = walker.currentNode as Text;
+      originals.set(node, node.data);
+    }
+  }
+
+  let disposed = false;
+  let checking = 0;
+  let operation = 0;
+  let busy = false;
+  let appliedLanguage: string | undefined;
+  let pair: LanguagePair | undefined;
+  let controller: AbortController | undefined;
+  const say = (message: string) => { status.textContent = message; };
+
+  async function checkAvailability() {
+    const check = ++checking;
+    pair = undefined;
+    translateButton.disabled = true;
+    if (!originals.size) {
+      select.disabled = true;
+      say('Open a news article or a news listing to translate its content.');
+      return;
+    }
+    if (!api) {
+      select.disabled = true;
+      say('On-device translation is unavailable in this browser. Try a supported desktop browser, such as Chrome. The original English text is available.');
+      return;
+    }
+    say('Checking this language on your device…');
+    const options = { sourceLanguage: 'en', targetLanguage: select.value };
+    try {
+      const availability = await api.availability(options);
+      if (disposed || check !== checking) return;
+      if (availability === 'unavailable') {
+        say('This language is unavailable on your device. Choose another language.');
+        return;
+      }
+      pair = options;
+      translateButton.disabled = busy;
+      say(availability === 'available'
+        ? 'Ready. Translation happens on your device; article text stays in your browser.'
+        : 'A language pack is needed. Select Translate to download it; article text stays on your device.');
+    } catch {
+      if (!disposed && check === checking) say('Could not check translation support. Choose a language to try again.');
+    }
+  }
+
+  async function translate() {
+    if (!api || !pair || busy) return;
+    const options = pair;
+    const currentOperation = ++operation;
+    const targetLabel = select.selectedOptions[0].textContent;
+    controller = new AbortController();
+    busy = true;
+    select.disabled = true;
+    translateButton.disabled = true;
+    restoreButton.disabled = false;
+    control!.setAttribute('aria-busy', 'true');
+    say('Preparing on-device translation…');
+    let translator: LocalTranslator | undefined;
+    try {
+      // Availability was checked before this click so create retains user activation.
+      translator = await api.create({
+        ...options,
+        signal: controller.signal,
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', event => {
+            if (disposed || currentOperation !== operation) return;
+            const loaded = (event as Event & { loaded: number }).loaded;
+            say(`Downloading language pack… ${Math.round(loaded * 100)}%`);
+          });
+        },
+      });
+      if (disposed || currentOperation !== operation) return;
+      const results = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      let completed = 0;
+      for (const [node, original] of originals) {
+        if (disposed || currentOperation !== operation) return;
+        const text = original.trim();
+        let result = cache.get(text);
+        if (result === undefined) {
+          result = await translator.translate(text);
+          if (disposed || currentOperation !== operation) return;
+          cache.set(text, result);
+        }
+        results.set(node, original.replace(text, () => result!));
+        completed++;
+        say(`Translating articles & teasers… ${Math.round(completed / originals.size * 100)}%`);
+      }
+      if (disposed || currentOperation !== operation) return;
+      // Commit only a complete translation, preserving all elements and links.
+      results.forEach((text, node) => { node.data = text; });
+      roots.forEach(root => {
+        root.lang = options.targetLanguage;
+        root.dir = options.targetLanguage === 'ar' ? 'rtl' : 'ltr';
+      });
+      appliedLanguage = options.targetLanguage;
+      say(`Translated to ${targetLabel}. Machine translation may contain errors. Select Show original for English.`);
+    } catch {
+      if (!disposed && currentOperation === operation) {
+        say('Translation could not finish. Check your connection for language-pack downloads, or try another language. Your current text has been kept.');
+      }
+    } finally {
+      translator?.destroy();
+      if (!disposed && currentOperation === operation) {
+        busy = false;
+        select.disabled = false;
+        translateButton.disabled = !pair;
+        restoreButton.disabled = !appliedLanguage;
+        control!.removeAttribute('aria-busy');
+      }
+    }
+  }
+
+  function restore() {
+    operation++;
+    controller?.abort();
+    originals.forEach((text, node) => { node.data = text; });
+    for (const { root, lang, dir } of originalAttributes) {
+      if (lang === null) root.removeAttribute('lang'); else root.setAttribute('lang', lang);
+      if (dir === null) root.removeAttribute('dir'); else root.setAttribute('dir', dir);
+    }
+    appliedLanguage = undefined;
+    busy = false;
+    select.disabled = !api;
+    translateButton.disabled = !pair;
+    restoreButton.disabled = true;
+    control!.removeAttribute('aria-busy');
+    say('Showing the original English articles & teasers.');
+  }
+
+  select.addEventListener('change', checkAvailability);
+  translateButton.addEventListener('click', translate);
+  restoreButton.addEventListener('click', restore);
+  void checkAvailability();
+  return () => {
+    disposed = true;
+    checking++;
+    operation++;
+    controller?.abort();
+    select.removeEventListener('change', checkAvailability);
+    translateButton.removeEventListener('click', translate);
+    restoreButton.removeEventListener('click', restore);
+  };
+}
