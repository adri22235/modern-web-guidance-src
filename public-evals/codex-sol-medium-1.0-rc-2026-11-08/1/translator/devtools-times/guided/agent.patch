diff --git a/src/components/TranslationControl.astro b/src/components/TranslationControl.astro
new file mode 100644
index 0000000..9239e25
--- /dev/null
+++ b/src/components/TranslationControl.astro
@@ -0,0 +1,40 @@
+<section data-translation-control aria-label="Article translation" class="border-b border-gray-300 bg-stone-50 px-4 py-4 md:px-6">
+  <div class="flex flex-wrap items-center gap-3">
+    <div class="mr-auto">
+      <h2 class="text-sm font-semibold text-gray-900">Read in your language</h2>
+      <p class="text-xs text-gray-600 mt-1">On-device translation · Articles &amp; teasers</p>
+    </div>
+    <label for="translation-language" class="text-sm text-gray-700">Translate to</label>
+    <select id="translation-language" class="rounded border border-gray-400 bg-white px-3 py-2 text-sm" aria-describedby="translation-status">
+      <option value="ar">العربية — Arabic</option>
+      <option value="zh">中文 — Chinese</option>
+      <option value="nl">Nederlands — Dutch</option>
+      <option value="fr">Français — French</option>
+      <option value="de">Deutsch — German</option>
+      <option value="hi">हिन्दी — Hindi</option>
+      <option value="it">Italiano — Italian</option>
+      <option value="ja">日本語 — Japanese</option>
+      <option value="ko">한국어 — Korean</option>
+      <option value="pt">Português — Portuguese</option>
+      <option value="es" selected>Español — Spanish</option>
+      <option value="uk">Українська — Ukrainian</option>
+    </select>
+    <button data-translate-button type="button" disabled class="rounded bg-gray-800 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed">Translate</button>
+    <button data-restore-button type="button" disabled class="rounded border border-gray-400 bg-white px-3 py-2 text-sm text-gray-800 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">Show original</button>
+  </div>
+  <p id="translation-status" role="status" aria-live="polite" aria-atomic="true" class="mt-2 text-xs text-gray-600">Checking on-device translation support…</p>
+  <noscript><p class="mt-2 text-xs text-gray-600">Enable JavaScript to use on-device translation.</p></noscript>
+</section>
+
+<script>
+  import { initializeTranslation } from '../scripts/translation';
+  let cleanup: (() => void) | undefined;
+  document.addEventListener('astro:page-load', () => {
+    cleanup?.();
+    cleanup = initializeTranslation();
+  });
+  document.addEventListener('astro:before-swap', () => {
+    cleanup?.();
+    cleanup = undefined;
+  });
+</script>
