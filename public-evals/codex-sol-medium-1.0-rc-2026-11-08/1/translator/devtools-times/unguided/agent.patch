diff --git a/src/scripts/article-translation.ts b/src/scripts/article-translation.ts
new file mode 100644
index 0000000..eaabd72
--- /dev/null
+++ b/src/scripts/article-translation.ts
@@ -0,0 +1,145 @@
+type TranslatorSession = {
+  translate(text: string, options: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+};
+
+type TranslatorAPI = {
+  create(options: {
+    sourceLanguage: string;
+    targetLanguage: string;
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }): void;
+  }): Promise<TranslatorSession>;
+};
+
+class ArticleTranslation extends HTMLElement {
+  private originals = new Map<Text, string>();
+  private regions: HTMLElement[] = [];
+  private controller?: AbortController;
+  private activeLanguage = 'en';
+  private busy = false;
+  private api?: TranslatorAPI;
+
+  connectedCallback() {
+    if (!document.querySelector('main [data-translatable]')) { this.hidden = true; return; }
+    this.api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+    this.querySelector('[data-translate]')!.addEventListener('click', this.translate);
+    this.querySelector('[data-restore]')!.addEventListener('click', this.restore);
+    this.querySelector('select')!.addEventListener('change', this.selectionChanged);
+    this.button.disabled = !this.api;
+    this.status(this.api
+      ? 'English original. A language pack may download on first use. Article text stays on this device.'
+      : 'On-device translation is unavailable in this browser. Try a desktop browser with the Translator API, such as Chrome.');
+  }
+
+  disconnectedCallback() {
+    this.controller?.abort();
+    this.querySelector('[data-translate]')!.removeEventListener('click', this.translate);
+    this.querySelector('[data-restore]')!.removeEventListener('click', this.restore);
+    this.querySelector('select')!.removeEventListener('change', this.selectionChanged);
+  }
+
+  private get button() { return this.querySelector<HTMLButtonElement>('[data-translate]')!; }
+  private get select() { return this.querySelector<HTMLSelectElement>('select')!; }
+  private status(message: string) { this.querySelector('[data-status]')!.textContent = message; }
+
+  private selectionChanged = () => {
+    this.button.disabled = !this.api || this.busy || this.select.value === this.activeLanguage;
+  };
+
+  private restore = () => {
+    this.controller?.abort();
+    for (const [node, text] of this.originals) node.textContent = text;
+    for (const region of this.regions) { region.lang = 'en'; region.removeAttribute('dir'); }
+    this.activeLanguage = 'en';
+    this.setBusy(false);
+    this.querySelector<HTMLButtonElement>('[data-restore]')!.hidden = true;
+    this.status('Showing the English original.');
+  };
+
+  private setBusy(busy: boolean) {
+    this.busy = busy;
+    this.select.disabled = busy;
+    this.button.textContent = busy ? 'Translating…' : 'Translate';
+    this.setAttribute('aria-busy', String(busy));
+    this.selectionChanged();
+  }
+
+  private captureOriginals() {
+    if (this.originals.size) return;
+    this.regions = Array.from(document.querySelectorAll<HTMLElement>('main [data-translatable]'));
+    for (const region of this.regions) {
+      const walker = document.createTreeWalker(region, NodeFilter.SHOW_TEXT, {
+        acceptNode(node) {
+          return node.textContent?.trim() && !node.parentElement?.closest('script, style, pre, code, svg, [translate="no"]')
+            ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
+        },
+      });
+      while (walker.nextNode()) {
+        const node = walker.currentNode as Text;
+        this.originals.set(node, node.data);
+      }
+    }
+  }
+
+  private translate = async () => {
+    if (!this.api || this.busy) return;
+    const language = this.select.value;
+    if (language === 'en') { this.restore(); return; }
+    this.captureOriginals();
+    if (!this.originals.size) { this.status('There are no articles to translate on this page.'); return; }
+    const controller = new AbortController();
+    this.controller = controller;
+    this.setBusy(true);
+    const restoreButton = this.querySelector<HTMLButtonElement>('[data-restore]')!;
+    restoreButton.hidden = false;
+    restoreButton.textContent = 'Cancel / show original';
+    this.status('Preparing on-device translation. A language pack may need to download…');
+    let translator: TranslatorSession | undefined;
+    try {
+      // Create directly from the click so model downloads retain user activation.
+      translator = await this.api.create({
+        sourceLanguage: 'en', targetLanguage: language, signal: controller.signal,
+        monitor: monitor => monitor.addEventListener('downloadprogress', event => {
+          if (!controller.signal.aborted) this.status(`Downloading language pack… ${Math.round(event.loaded * 100)}%`);
+        }),
+      });
+      const translated = new Map<Text, string>();
+      const cache = new Map<string, string>();
+      for (const [node, original] of this.originals) {
+        controller.signal.throwIfAborted();
+        const text = original.trim();
+        let result = cache.get(text);
+        if (result === undefined) {
+          result = await translator.translate(text, { signal: controller.signal });
+          controller.signal.throwIfAborted();
+          cache.set(text, result);
+        }
+        translated.set(node, original.replace(text, () => result!));
+        this.status(`Translating article text… ${Math.round(translated.size / this.originals.size * 100)}%`);
+      }
+      controller.signal.throwIfAborted();
+      // Commit together so a failed or canceled job never leaves mixed languages.
+      for (const [node, text] of translated) node.textContent = text;
+      for (const region of this.regions) { region.lang = language; region.dir = language === 'ar' ? 'rtl' : 'ltr'; }
+      this.activeLanguage = language;
+      this.status(`Translated to ${this.select.selectedOptions[0].textContent} on this device. Machine translations may contain errors.`);
+    } catch (error) {
+      if (!controller.signal.aborted) {
+        const unsupported = error instanceof DOMException && error.name === 'NotSupportedError';
+        this.status(unsupported
+          ? 'This language pair is not supported on your device. Choose another language.'
+          : 'Translation could not finish. Check your connection for language-pack downloads and try again. Your article text is unchanged.');
+      }
+    } finally {
+      translator?.destroy();
+      if (this.controller === controller) {
+        this.setBusy(false);
+        restoreButton.textContent = 'Show original';
+        restoreButton.hidden = this.activeLanguage === 'en';
+      }
+    }
+  };
+}
+
+if (!customElements.get('article-translation')) customElements.define('article-translation', ArticleTranslation);
diff --git a/tests/article-translation.test.mjs b/tests/article-translation.test.mjs
new file mode 100644
index 0000000..28f5752
--- /dev/null
+++ b/tests/article-translation.test.mjs
@@ -0,0 +1,121 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+// Minimal DOM fixture: exercises the control without a browser or server.
+class Element extends EventTarget {
+  hidden = false;
+  disabled = false;
+  textContent = '';
+  attributes = new Map();
+  setAttribute(name, value) { this.attributes.set(name, value); }
+  removeAttribute(name) { this.attributes.delete(name); }
+}
+globalThis.HTMLElement = Element;
+globalThis.NodeFilter = { SHOW_TEXT: 4, FILTER_ACCEPT: 1, FILTER_REJECT: 2 };
+let Control;
+globalThis.customElements = { get: () => Control, define: (_, ctor) => { Control = ctor; } };
+await import('../src/scripts/article-translation.ts');
+
+function setup(api) {
+  const nodes = ['  Original headline  ', 'Article body', 'const code = 1;'].map((data, index) => ({
+    data,
+    get textContent() { return this.data; },
+    set textContent(value) { this.data = value; },
+    parentElement: { closest: () => index === 2 ? {} : null },
+  }));
+  const region = new Element();
+  region.lang = 'en';
+  globalThis.document = {
+    querySelector: () => region,
+    querySelectorAll: () => [region],
+    createTreeWalker: (_, __, filter) => {
+      const accepted = nodes.filter(node => filter.acceptNode(node) === NodeFilter.FILTER_ACCEPT);
+      let index = -1;
+      return { nextNode() { return accepted[++index]; }, get currentNode() { return accepted[index]; } };
+    },
+  };
+  globalThis.window = { Translator: api };
+  const control = new Control();
+  const elements = Object.fromEntries(['[data-translate]', '[data-restore]', '[data-status]', 'select'].map(key => [key, new Element()]));
+  elements.select.value = 'es';
+  elements.select.selectedOptions = [{ textContent: 'Español' }];
+  control.querySelector = selector => elements[selector];
+  control.connectedCallback();
+  return { control, elements, nodes, region };
+}
+
+test('unsupported browsers explain the limitation and disable translation', () => {
+  const { elements } = setup(undefined);
+  assert.equal(elements['[data-translate]'].disabled, true);
+  assert.match(elements['[data-status]'].textContent, /unavailable in this browser/);
+});
+
+test('translation preserves whitespace, skips code, switches from originals and restores English', async () => {
+  const inputs = [];
+  let destroyed = 0;
+  const api = { create: async ({ targetLanguage }) => ({
+    translate: async text => { inputs.push(text); return `${targetLanguage}: ${text}`; },
+    destroy: () => { destroyed++; },
+  }) };
+  const { control, elements, nodes, region } = setup(api);
+  await control.translate();
+  assert.equal(nodes[0].data, '  es: Original headline  ');
+  assert.equal(nodes[2].data, 'const code = 1;');
+  assert.equal(region.lang, 'es');
+  elements.select.value = 'ar';
+  await control.translate();
+  assert.equal(nodes[0].data, '  ar: Original headline  ');
+  assert.equal(region.dir, 'rtl');
+  assert.deepEqual(inputs, ['Original headline', 'Article body', 'Original headline', 'Article body']);
+  control.restore();
+  assert.equal(nodes[0].data, '  Original headline  ');
+  assert.equal(region.lang, 'en');
+  assert.equal(elements['[data-restore]'].hidden, true);
+  assert.equal(destroyed, 2);
+});
+
+test('a failure midway leaves all article text unchanged and permits retry', async () => {
+  let count = 0;
+  const { control, elements, nodes } = setup({ create: async () => ({
+    translate: async () => { if (++count === 2) throw new Error('failed'); return 'Translated'; },
+    destroy() {},
+  }) });
+  await control.translate();
+  assert.equal(nodes[0].data, '  Original headline  ');
+  assert.equal(nodes[1].data, 'Article body');
+  assert.equal(elements['[data-translate]'].disabled, false);
+  assert.match(elements['[data-status]'].textContent, /could not finish/);
+});
+
+test('canceling ignores late translation results and keeps the original status', async () => {
+  let release;
+  const { control, elements, nodes } = setup({ create: async () => ({
+    translate: () => new Promise(resolve => { release = resolve; }), destroy() {},
+  }) });
+  const pending = control.translate();
+  await Promise.resolve();
+  control.restore();
+  release('Late result');
+  await pending;
+  assert.equal(nodes[0].data, '  Original headline  ');
+  assert.equal(elements['[data-status]'].textContent, 'Showing the English original.');
+});
+
+test('unsupported language pairs have an actionable error', async () => {
+  const { control, elements } = setup({ create: async () => { throw new DOMException('Unsupported', 'NotSupportedError'); } });
+  await control.translate();
+  assert.match(elements['[data-status]'].textContent, /Choose another language/);
+  assert.equal(elements['[data-translate]'].disabled, false);
+});
+
+test('navigation aborts pending model creation', async () => {
+  let signal;
+  const { control } = setup({ create: options => {
+    signal = options.signal;
+    return new Promise((_, reject) => signal.addEventListener('abort', () => reject(signal.reason)));
+  } });
+  const pending = control.translate();
+  control.disconnectedCallback();
+  await pending;
+  assert.equal(signal.aborted, true);
+});
