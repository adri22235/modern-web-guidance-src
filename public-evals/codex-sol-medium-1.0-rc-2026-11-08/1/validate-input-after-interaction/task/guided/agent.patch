+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.getElementById('newsletter-email');
+    const status = document.getElementById('newsletter-status');
+
+    email.addEventListener('blur', () => {
+      email.setAttribute('aria-invalid', String(email.matches(':user-invalid')));
+    });
+
+    // Keep the field neutral whenever the user resumes editing.
+    email.addEventListener('focus', () => email.removeAttribute('aria-invalid'));
+    email.addEventListener('input', () => {
+      email.removeAttribute('aria-invalid');
+      status.textContent = '';
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a newsletter provider here before accepting subscriptions.
+      status.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
