+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = picker.querySelector('.roast-trigger');
+    const listbox = picker.querySelector('[role="listbox"]');
+    const options = [...listbox.querySelectorAll('[role="option"]')];
+    let selected = 0;
+
+    function closePicker(restoreFocus = false) {
+      listbox.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker(index = selected) {
+      listbox.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function chooseRoast(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      document.getElementById('roast-value').innerHTML = options[index].querySelector('.roast-content').innerHTML;
+      document.getElementById('order-button').href = `/order-online?roast=${options[index].dataset.roast}`;
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => listbox.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        openPicker(event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : selected);
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => chooseRoast(index));
+      option.addEventListener('keydown', event => {
+        let next;
+        if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+        if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+        if (event.key === 'Home') next = 0;
+        if (event.key === 'End') next = options.length - 1;
+        if (next !== undefined) {
+          event.preventDefault();
+          options[next].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          chooseRoast(index);
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          closePicker(true);
+        } else if (event.key.length === 1) {
+          const match = options.findIndex((item, offset) => {
+            const candidate = options[(index + offset + 1) % options.length];
+            return candidate.querySelector('.roast-title').textContent.toLowerCase().startsWith(event.key.toLowerCase());
+          });
+          if (match !== -1) {
+            event.preventDefault();
+            options[(index + match + 1) % options.length].focus();
+          }
+        }
+      });
+    });
+
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+  </script>
