+  <script>
+    const cards = Array.from(document.querySelectorAll('#seasonal-cards .card'));
+    const status = document.getElementById('seasonal-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentIndex = 0;
+    let transitioning = false;
+
+    async function showSeasonalCard(step) {
+      if (transitioning) return;
+
+      const nextIndex = (currentIndex + step + cards.length) % cards.length;
+      const update = () => {
+        cards[currentIndex].hidden = true;
+        cards[nextIndex].hidden = false;
+        currentIndex = nextIndex;
+        status.textContent = `${currentIndex + 1} of ${cards.length} — ${cards[currentIndex].querySelector('h3').textContent}`;
+      };
+
+      if (!document.startViewTransition ||
+          !CSS.supports('selector(:active-view-transition-type(forward))') ||
+          reducedMotion.matches) {
+        update();
+        return;
+      }
+
+      transitioning = true;
+      try {
+        const transition = document.startViewTransition({
+          update,
+          types: [step > 0 ? 'forward' : 'backward']
+        });
+        await transition.finished;
+      } finally {
+        transitioning = false;
+      }
+    }
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSeasonalCard(-1));
+    document.getElementById('seasonal-next').addEventListener('click', () => showSeasonalCard(1));
+    document.querySelector('.seasonal-controls').hidden = false;
+  </script>
