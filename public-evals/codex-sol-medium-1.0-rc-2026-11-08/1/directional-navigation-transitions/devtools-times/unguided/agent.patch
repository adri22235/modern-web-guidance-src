@@ -0,0 +1,51 @@
+.top-stories-control {
+    border: 1px solid #d1d5db;
+    padding: 0.4rem 0.75rem;
+    color: #111827;
+    font-size: 0.875rem;
+    font-weight: 600;
+    cursor: pointer;
+}
+
+.top-stories-control:hover:not(:disabled) {
+    background: #fef3c7;
+}
+
+.top-stories-control:focus-visible {
+    outline: 2px solid #d97706;
+    outline-offset: 2px;
+}
+
+.top-stories-control:disabled {
+    opacity: 0.5;
+    cursor: default;
+}
+
+.top-stories-slide {
+    min-height: 4rem;
+    padding: 0.25rem;
+}
+
+.top-stories-slide[data-direction='next'] {
+    animation: top-story-from-right 300ms ease-out both;
+}
+
+.top-stories-slide[data-direction='previous'] {
+    animation: top-story-from-left 300ms ease-out both;
+}
+
+@keyframes top-story-from-right {
+    from { transform: translateX(100%); }
+    to { transform: translateX(0); }
+}
+
+@keyframes top-story-from-left {
+    from { transform: translateX(-100%); }
+    to { transform: translateX(0); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .top-stories-slide[data-direction] {
+        animation: none;
+    }
+}
diff --git a/src/components/TopStoriesCarousel.tsx b/src/components/TopStoriesCarousel.tsx
new file mode 100644
index 0000000..9203014
--- /dev/null
+++ b/src/components/TopStoriesCarousel.tsx
@@ -0,0 +1,69 @@
+import { useState } from 'react';
+import './TopStoriesCarousel.css';
+
+interface Story {
+    title: string;
+    href: string;
+    date: string;
+    dateTime: string;
+}
+
+export default function TopStoriesCarousel({ stories }: { stories: Story[] }) {
+    const [slide, setSlide] = useState({ index: 0, direction: 'next', revision: 0 });
+
+    if (stories.length === 0) return null;
+
+    const story = stories[slide.index];
+    const changeStory = (direction: 'next' | 'previous') => {
+        setSlide(current => ({
+            index: (current.index + (direction === 'next' ? 1 : -1) + stories.length) % stories.length,
+            direction,
+            revision: current.revision + 1,
+        }));
+    };
+
+    return (
+        <section aria-label="Top Stories" aria-roledescription="carousel" className="bg-white border-b border-gray-300">
+            <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+                <div className="flex flex-wrap items-center justify-between gap-3 mb-3">
+                    <h2 className="text-sm font-bold uppercase tracking-widest text-gray-900">Top Stories</h2>
+                    <div className="flex items-center gap-2">
+                        <button
+                            type="button"
+                            onClick={() => changeStory('previous')}
+                            aria-controls="top-stories-slide"
+                            disabled={stories.length < 2}
+                            className="top-stories-control"
+                        >
+                            <span aria-hidden="true">← </span>Previous
+                        </button>
+                        <button
+                            type="button"
+                            onClick={() => changeStory('next')}
+                            aria-controls="top-stories-slide"
+                            disabled={stories.length < 2}
+                            className="top-stories-control"
+                        >
+                            Next<span aria-hidden="true"> →</span>
+                        </button>
+                    </div>
+                </div>
+                <div id="top-stories-slide" className="overflow-hidden" aria-live="polite" aria-atomic="true">
+                    <article
+                        key={slide.revision}
+                        className="top-stories-slide"
+                        data-direction={slide.revision > 0 ? slide.direction : undefined}
+                        aria-roledescription="slide"
+                        aria-label={`${slide.index + 1} of ${stories.length}`}
+                    >
+                        <a href={story.href} className="font-bold text-gray-900 hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-amber-600">
+                            <h3>{story.title}</h3>
+                        </a>
+                        <time dateTime={story.dateTime} className="text-xs text-gray-500">{story.date}</time>
+                        <span className="ml-3 text-xs text-gray-500" aria-hidden="true">{slide.index + 1} / {stories.length}</span>
+                    </article>
+                </div>
+            </div>
+        </section>
+    );
+}
