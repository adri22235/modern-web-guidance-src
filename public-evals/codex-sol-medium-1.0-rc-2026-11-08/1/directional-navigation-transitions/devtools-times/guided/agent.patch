diff --git a/src/components/TopStoriesCarousel.astro b/src/components/TopStoriesCarousel.astro
new file mode 100644
index 0000000..3f3ca1b
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,132 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-carousel role="region" aria-roledescription="carousel" aria-label="Top Stories" class="block">
+    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
+        <h2 class="text-sm font-bold uppercase tracking-wider">Top Stories</h2>
+        <div data-controls hidden class="flex items-center gap-3 text-sm">
+            <button type="button" data-direction="backward" aria-controls="top-story-content" class="cursor-pointer rounded border border-gray-300 px-3 py-1.5 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">← Previous</button>
+            <span data-position class="text-gray-500 tabular-nums">1 / {articles.length}</span>
+            <button type="button" data-direction="forward" aria-controls="top-story-content" class="cursor-pointer rounded border border-gray-300 px-3 py-1.5 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500">Next →</button>
+        </div>
+    </div>
+    <div class="overflow-hidden">
+        <div id="top-story-content" class="story-content">
+            {articles.map((article, index) => (
+                <article data-story hidden={index !== 0} inert={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                    <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                        <h3 class="font-bold text-gray-900 hover:text-amber-400">{article.data.title}</h3>
+                    </a>
+                    <time datetime={article.data.date.toISOString()} class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</time>
+                </article>
+            ))}
+        </div>
+    </div>
+    <p data-announcement class="sr-only" aria-live="polite" aria-atomic="true"></p>
+</top-stories-carousel>
+
+<script>
+    class TopStoriesCarousel extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const content = this.querySelector<HTMLElement>('.story-content')!;
+            const position = this.querySelector<HTMLElement>('[data-position]')!;
+            const announcement = this.querySelector<HTMLElement>('[data-announcement]')!;
+            const controls = this.querySelector<HTMLElement>('[data-controls]')!;
+            if (stories.length < 2) return;
+            controls.hidden = false;
+
+            let current = 0;
+            let changing = false;
+
+            this.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) => {
+                button.addEventListener('click', async () => {
+                    if (changing) return;
+                    changing = true;
+                    const direction = button.dataset.direction!;
+                    const next = (current + (direction === 'forward' ? 1 : -1) + stories.length) % stories.length;
+                    const update = () => {
+                        stories[current].hidden = true;
+                        stories[current].inert = true;
+                        stories[next].hidden = false;
+                        stories[next].inert = false;
+                        current = next;
+                        position.textContent = `${current + 1} / ${stories.length}`;
+                    };
+
+                    try {
+                        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
+                        if (!reducedMotion && document.startViewTransition && CSS.supports('selector(:active-view-transition-type(story-forward))')) {
+                            const transition = document.startViewTransition({
+                                update,
+                                types: [`story-${direction}`],
+                            });
+                            await transition.finished;
+                        } else {
+                            update();
+                            // Keep directional motion in browsers without typed view transitions.
+                            if (!reducedMotion) {
+                                await content.animate([
+                                    { transform: `translateX(${direction === 'forward' ? '100%' : '-100%'})` },
+                                    { transform: 'translateX(0)' },
+                                ], { duration: 280, easing: 'ease-in-out' }).finished;
+                            }
+                        }
+                    } finally {
+                        announcement.textContent = `Story ${current + 1} of ${stories.length}: ${stories[current].querySelector('h3')!.textContent}`;
+                        changing = false;
+                    }
+                });
+            });
+        }
+    }
+
+    if (!customElements.get('top-stories-carousel')) {
+        customElements.define('top-stories-carousel', TopStoriesCarousel);
+    }
+</script>
+
+<style>
+    [hidden] { display: none !important; }
+    .story-content { view-transition-name: top-story-content; }
+</style>
+
+<style is:global>
+    @keyframes story-to-left { to { transform: translateX(-100%); } }
+    @keyframes story-from-right { from { transform: translateX(100%); } }
+    @keyframes story-to-right { to { transform: translateX(100%); } }
+    @keyframes story-from-left { from { transform: translateX(-100%); } }
+
+    @media (prefers-reduced-motion: no-preference) {
+        html:active-view-transition-type(story-forward, story-backward)::view-transition-group(top-story-content) {
+            animation-duration: 280ms;
+            animation-timing-function: ease-in-out;
+            overflow: clip;
+        }
+        html:active-view-transition-type(story-forward, story-backward)::view-transition-old(root),
+        html:active-view-transition-type(story-forward, story-backward)::view-transition-new(root) {
+            animation: none;
+        }
+        html:active-view-transition-type(story-forward, story-backward)::view-transition-old(top-story-content),
+        html:active-view-transition-type(story-forward, story-backward)::view-transition-new(top-story-content) {
+            animation-duration: 280ms;
+            animation-timing-function: ease-in-out;
+            animation-fill-mode: both;
+            mix-blend-mode: normal;
+        }
+        html:active-view-transition-type(story-forward)::view-transition-old(top-story-content) { animation-name: story-to-left; }
+        html:active-view-transition-type(story-forward)::view-transition-new(top-story-content) { animation-name: story-from-right; }
+        html:active-view-transition-type(story-backward)::view-transition-old(top-story-content) { animation-name: story-to-right; }
+        html:active-view-transition-type(story-backward)::view-transition-new(top-story-content) { animation-name: story-from-left; }
+    }
+</style>
