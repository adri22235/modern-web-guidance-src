+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = [...panel.querySelectorAll('.drink-section h3')];
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let settleTimer;
+
+    function updateActiveLink() {
+      const snapTop = panel.getBoundingClientRect().top + panel.clientTop
+        + parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      const activeHeading = headings.reduce((closest, heading) =>
+        Math.abs(heading.getBoundingClientRect().top - snapTop)
+          < Math.abs(closest.getBoundingClientRect().top - snapTop) ? heading : closest
+      );
+      links.forEach(link => {
+        const active = link.hash === `#${activeHeading.id}`;
+        link.classList.toggle('active', active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function scrollToHeading(heading, behavior) {
+      const top = panel.scrollTop + heading.getBoundingClientRect().top
+        - panel.getBoundingClientRect().top - panel.clientTop
+        - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      panel.scrollTo({ top, behavior });
+      // Also handles links to a heading that is already in position.
+      clearTimeout(settleTimer);
+      settleTimer = setTimeout(updateActiveLink, 180);
+    }
+
+    links.forEach(link => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = headings.find(item => `#${item.id}` === link.hash);
+        history.pushState(null, '', link.hash);
+        heading.focus({ preventScroll: true });
+        scrollToHeading(heading, reducedMotion.matches ? 'instant' : 'smooth');
+      });
+    });
+
+    panel.addEventListener('scroll', () => {
+      clearTimeout(settleTimer);
+      settleTimer = setTimeout(updateActiveLink, 180);
+    }, { passive: true });
+    panel.addEventListener('scrollend', () => {
+      clearTimeout(settleTimer);
+      updateActiveLink();
+    });
+
+    function followHash(behavior) {
+      const heading = headings.find(item => `#${item.id}` === location.hash);
+      if (heading) scrollToHeading(heading, behavior);
+    }
+
+    window.addEventListener('hashchange', () => {
+      followHash(reducedMotion.matches ? 'instant' : 'smooth');
+    });
+    requestAnimationFrame(() => {
+      followHash('instant');
+      updateActiveLink();
+    });
+  </script>
