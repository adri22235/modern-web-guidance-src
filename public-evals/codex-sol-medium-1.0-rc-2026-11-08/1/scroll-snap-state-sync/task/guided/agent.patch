+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const links = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = links.map(link => document.getElementById(link.hash.slice(1)));
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function setActive(header) {
+      links.forEach(link => {
+        if (link.hash === `#${header.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function syncSettledSection() {
+      const top = panel.getBoundingClientRect().top + parseFloat(getComputedStyle(panel).scrollPaddingTop);
+      const nearest = headers.reduce((closest, header) =>
+        Math.abs(header.getBoundingClientRect().top - top) <
+        Math.abs(closest.getBoundingClientRect().top - top) ? header : closest
+      );
+      setActive(nearest);
+    }
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (headers.includes(event.snapTargetBlock)) setActive(event.snapTargetBlock);
+      });
+    } else {
+      // Observe visibility, but commit the active state only after scrolling settles.
+      let settleTimer;
+      const scheduleSync = () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(syncSettledSection, 160);
+      };
+      const observer = new IntersectionObserver(scheduleSync, { root: panel });
+      headers.forEach(header => observer.observe(header));
+      panel.addEventListener('scroll', scheduleSync, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        clearTimeout(settleTimer);
+        syncSettledSection();
+      });
+    }
+
+    links.forEach((link, index) => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const header = headers[index];
+        const top = panel.scrollTop + header.getBoundingClientRect().top -
+          panel.getBoundingClientRect().top - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+        header.focus({ preventScroll: true });
+        panel.scrollTo({ top, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+      });
+    });
+
+    syncSettledSection();
+  </script>
