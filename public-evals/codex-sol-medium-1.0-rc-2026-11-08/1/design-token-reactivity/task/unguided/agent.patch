+  <script>
+    if (window.CSS && typeof CSS.registerProperty === 'function' &&
+        CSS.supports('padding', 'var(--card-density)')) {
+      const toggle = document.getElementById('toggle-spacious');
+      const container = document.getElementById('target-container');
+
+      toggle.addEventListener('click', () => {
+        const spacious = toggle.getAttribute('aria-pressed') !== 'true';
+        container.style.setProperty('--card-density', spacious ? '32px' : '20px');
+        toggle.setAttribute('aria-pressed', String(spacious));
+      });
+
+      toggle.hidden = false;
+    }
