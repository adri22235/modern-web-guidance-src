+  <script>
+    if (globalThis.CSS?.supports('padding', '--card-padding()')) {
+      const toggle = document.getElementById('toggle-spacious');
+      const container = document.getElementById('target-container');
+
+      toggle.addEventListener('click', () => {
+        const spacious = toggle.getAttribute('aria-pressed') !== 'true';
+        container.style.setProperty('--card-density', spacious ? '2' : '1');
