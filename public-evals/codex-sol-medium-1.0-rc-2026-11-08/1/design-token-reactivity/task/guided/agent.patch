       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    #target-container {
+      --card-density: 1;
+    }
+
+    /* Resolve the inherited density on each card, entirely in CSS. */
+    @function --card-padding() returns <length> {
+      result: calc(20px * var(--card-density, 1));
+    }
+
+    @supports (padding: --card-padding()) {
+      #target-container .card {
+        padding: --card-padding();
+      }
+    }
+
+    .density-controls {
+      text-align: center;
+    }
+
+    #toggle-spacious {
+      font: inherit;
+      border: 0;
+      cursor: pointer;
+    }
+
+    #toggle-spacious[hidden] {
+      display: none;
+    }
+
+    #toggle-spacious[aria-pressed="true"] {
+      background: var(--text);
+      box-shadow: inset 0 0 0 2px var(--accent);
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
