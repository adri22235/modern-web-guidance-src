@@ -0,0 +1,97 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      font-size: 1rem;
+      line-height: 1.6;
+      color: #3e2723;
+    }
+
+    article {
+      box-sizing: border-box;
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    h3 {
+      margin: 0 0 10px;
+      color: #4e342e;
+    }
+
+    p {
+      margin: 0;
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      font-size: 0.8rem;
+      font-weight: bold;
+    }
+
+    .badge[hidden] {
+      display: none;
+    }
+
+    a {
+      display: inline-block;
+      background: #4e342e;
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    a:hover {
+      background: #3e2723;
+    }
+
+    a:focus-visible {
+      outline: 2px solid #4e342e;
+      outline-offset: 3px;
+    }
+  </style>
+  <article>
+    <div class="badge" hidden><slot name="badge"></slot></div>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <a><slot name="action">View Details</slot></a>
+  </article>
+`;
+
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['href'];
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+
+    const badgeSlot = root.querySelector('slot[name="badge"]');
+    badgeSlot.addEventListener('slotchange', () => {
+      root.querySelector('.badge').hidden = badgeSlot.assignedElements().length === 0;
+    });
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    const link = this.shadowRoot.querySelector('a');
+    if (newValue === null) {
+      link.removeAttribute('href');
+    } else {
+      link.setAttribute('href', newValue);
+    }
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
