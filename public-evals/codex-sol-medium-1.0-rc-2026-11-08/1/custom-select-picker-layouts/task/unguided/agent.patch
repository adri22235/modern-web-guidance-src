+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const choices = [...picker.querySelectorAll('input[name="roast"]')];
+
+    function setPickerOpen(open, restoreFocus = false) {
+      menu.hidden = !open;
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) choices.find(choice => choice.checked).focus();
+      else if (restoreFocus) trigger.focus();
+    }
+
+    trigger.addEventListener('click', () => setPickerOpen(menu.hidden));
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        setPickerOpen(true);
+      }
+    });
+
+    choices.forEach(choice => {
+      choice.addEventListener('change', () => {
+        document.getElementById('roast-value').textContent =
+          choice.value[0].toUpperCase() + choice.value.slice(1) + ' roast';
+        document.getElementById('roast-note').textContent = choice.dataset.note;
+        document.getElementById('order-now').href = '/order-online?roast=' + choice.value;
+      });
+      choice.addEventListener('click', event => {
+        if (event.detail > 0) setPickerOpen(false, true);
+      });
+      choice.addEventListener('keydown', event => {
+        if (event.key === 'Enter') {
+          event.preventDefault();
+          setPickerOpen(false, true);
+        }
+      });
+    });
+
+    picker.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !menu.hidden) {
+        event.preventDefault();
+        setPickerOpen(false, true);
+      }
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) setPickerOpen(false);
+    });
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) setPickerOpen(false);
+    });
+  </script>
