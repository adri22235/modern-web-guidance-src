@@ -0,0 +1,107 @@
+const fs = require('node:fs');
+const path = require('node:path');
+
+const policy = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  'img-src https://images.unsplash.com',
+  "connect-src 'none'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-ancestors 'none'",
+  "form-action 'self'",
+  "require-trusted-types-for 'script'",
+  "trusted-types 'none'",
+].join('; ');
+
+const assets = new Map([
+  ['/styles.css', ['public/styles.css', 'text/css; charset=utf-8']],
+  ['/logout.js', ['public/logout.js', 'text/javascript; charset=utf-8']],
+]);
+// Retain the original site's navigation aliases without exposing arbitrary files.
+const pages = new Set(['/', '/index.html', '/menu', '/locations', '/rewards',
+  '/account', '/order-online', '/menu/seasonal', '/menu/espresso',
+  '/menu/cold-brew', '/about', '/careers', '/contact', '/privacy-policy']);
+
+function documentPage(title, content, script = '') {
+  return `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${title} | The Daily Grind</title><link rel="stylesheet" href="/styles.css">${script}</head><body><main class="container"><h1>${title}</h1>${content}</main></body></html>`;
+}
+
+function createHandler({ reportOnly = false, publicOrigin } = {}) {
+  if (publicOrigin && (new URL(publicOrigin).origin !== publicOrigin ||
+      !['http:', 'https:'].includes(new URL(publicOrigin).protocol))) {
+    throw new Error('PUBLIC_ORIGIN must be an HTTP(S) origin without a trailing slash');
+  }
+  return function handleRequest(req, res) {
+    res.setHeader(reportOnly ? 'Content-Security-Policy-Report-Only' : 'Content-Security-Policy', policy);
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('X-Frame-Options', 'DENY');
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=()');
+    res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+    res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+    res.setHeader('Cache-Control', 'no-store');
+    // TLS can terminate at a proxy; do not trust client-supplied forwarding headers.
+    if (req.socket?.encrypted) res.setHeader('Strict-Transport-Security', 'max-age=31536000');
+
+    const send = (status, body, type = 'text/html; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    let pathname;
+    try {
+      if (!req.url.startsWith('/') || req.url.startsWith('//')) throw new Error('Invalid target');
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return send(400, 'Bad request', 'text/plain; charset=utf-8');
+    }
+
+    if (pathname === '/logout' || pathname === '/logout/') {
+      if (req.method === 'GET' || req.method === 'HEAD') {
+        return send(200, documentPage('Sign out', '<p>Sign out of The Daily Grind on this browser?</p><form action="/logout" method="post"><button class="btn" type="submit">Logout</button></form><p><a href="/">Return home</a></p>'));
+      }
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'GET, HEAD, POST');
+        return send(405, 'Method not allowed', 'text/plain; charset=utf-8');
+      }
+      // Native same-origin form submissions send Origin. Reject opaque/missing origins
+      // and cross-site requests, including sibling subdomains, before changing state.
+      let sameOrigin = false;
+      try {
+        const origin = new URL(req.headers.origin);
+        sameOrigin = ['http:', 'https:'].includes(origin.protocol) &&
+          origin.origin === req.headers.origin &&
+          origin.origin === (publicOrigin || `${req.socket?.encrypted ? 'https' : 'http'}://${req.headers.host}`);
+      } catch { /* Missing or malformed Origin is forbidden. */ }
+      if (!sameOrigin || (req.headers['sec-fetch-site'] && req.headers['sec-fetch-site'] !== 'same-origin')) {
+        return send(403, 'Forbidden', 'text/plain; charset=utf-8');
+      }
+      // There is no session store in this site. Expire root cookies, including
+      // HttpOnly credentials, and clear browser data on supporting HTTPS clients.
+      const names = new Set(['session', 'sid']);
+      for (const cookie of (req.headers.cookie || '').split(';')) {
+        const name = cookie.trim().split('=')[0];
+        if (/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(name)) names.add(name);
+      }
+      res.setHeader('Set-Cookie', [...names].map(name =>
+        `${name}=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; SameSite=Lax${req.socket?.encrypted || req.headers.origin.startsWith('https:') || name.startsWith('__Secure-') || name.startsWith('__Host-') ? '; Secure' : ''}`));
+      res.setHeader('Clear-Site-Data', '"cache", "cookies", "storage"');
+      return send(200, documentPage('Logged out', '<p>You have been signed out on this browser.</p><p><a href="/">Return home</a></p>', '<script src="/logout.js" defer></script>'));
+    }
+
+    if (req.method !== 'GET' && req.method !== 'HEAD') {
+      res.setHeader('Allow', 'GET, HEAD');
+      return send(405, 'Method not allowed', 'text/plain; charset=utf-8');
+    }
+    const asset = assets.get(pathname) || (pages.has(pathname) ? ['index.html', 'text/html; charset=utf-8'] : null);
+    if (!asset) return send(404, 'Not found', 'text/plain; charset=utf-8');
+    fs.readFile(path.join(__dirname, asset[0]), (error, data) => {
+      if (error) return send(500, 'Server error', 'text/plain; charset=utf-8');
+      send(200, data, asset[1]);
+    });
+  };
+}
+
+module.exports = { createHandler, policy };
