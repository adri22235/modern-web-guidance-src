diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..02e82b8
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,108 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const { createHandler } = require('../app');
+
+// Exercise the request handler directly: no listening sockets or server entrypoint.
+function request(url = '/', { method = 'GET', headers = {}, encrypted = false, reportOnly = false, publicOrigin } = {}) {
+  return new Promise(resolve => {
+    const responseHeaders = {};
+    const res = {
+      setHeader(name, value) { responseHeaders[name.toLowerCase()] = value; },
+      writeHead(status, headers) {
+        this.status = status;
+        for (const [name, value] of Object.entries(headers)) this.setHeader(name, value);
+      },
+      end(body) { resolve({ status: this.status, headers: responseHeaders, body: body?.toString() || '' }); },
+    };
+    createHandler({ reportOnly, publicOrigin })({ url, method, headers: { host: 'coffee.example', ...headers }, socket: { encrypted } }, res);
+  });
+}
+
+test('pages and assets have restrictive security headers and correct MIME types', async () => {
+  for (const [url, type] of [['/', 'text/html'], ['/styles.css', 'text/css'], ['/logout.js', 'text/javascript']]) {
+    const res = await request(url);
+    assert.equal(res.status, 200);
+    assert.ok(res.headers['content-type'].startsWith(type));
+    const csp = res.headers['content-security-policy'];
+    for (const directive of ["default-src 'none'", "base-uri 'none'", "frame-ancestors 'none'", "form-action 'self'", "require-trusted-types-for 'script'", "trusted-types 'none'"]) assert.ok(csp.includes(directive));
+    assert.ok(!csp.includes('unsafe-inline'));
+    assert.ok(!csp.includes('unsafe-eval'));
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['cache-control'], 'no-store');
+    assert.equal(res.headers['referrer-policy'], 'no-referrer');
+  }
+});
+
+test('report-only rollout and TLS headers', async () => {
+  const res = await request('/', { reportOnly: true, encrypted: true });
+  assert.ok(res.headers['content-security-policy-report-only']);
+  assert.equal(res.headers['content-security-policy'], undefined);
+  assert.equal(res.headers['strict-transport-security'], 'max-age=31536000');
+  assert.equal((await request('/')).headers['strict-transport-security'], undefined);
+});
+
+test('GET, HEAD, and speculative navigation cannot log a visitor out', async () => {
+  for (const method of ['GET', 'HEAD']) {
+    const res = await request('/logout', { method, headers: { purpose: 'prefetch', cookie: 'session=secret' } });
+    assert.equal(res.status, 200);
+    assert.equal(res.headers['set-cookie'], undefined);
+    assert.equal(res.headers['clear-site-data'], undefined);
+    if (method === 'HEAD') assert.equal(res.body, '');
+    else assert.match(res.body, /method="post"/);
+  }
+});
+
+test('same-origin POST expires cookies and clears browser data', async () => {
+  const res = await request('/logout/', { method: 'POST', encrypted: true, headers: {
+    origin: 'https://coffee.example', 'sec-fetch-site': 'same-origin',
+    cookie: 'session=secret; __Host-auth=secret; preferences=dark; invalid name=x',
+  } });
+  assert.equal(res.status, 200);
+  assert.match(res.body, /Logged out/);
+  assert.match(res.body, /src="\/logout.js" defer/);
+  assert.equal(res.headers['clear-site-data'], '"cache", "cookies", "storage"');
+  for (const cookie of res.headers['set-cookie']) {
+    assert.match(cookie, /Max-Age=0/);
+    assert.match(cookie, /HttpOnly; SameSite=Lax; Secure/);
+    assert.ok(!cookie.includes('secret'));
+    assert.ok(!cookie.startsWith('invalid name'));
+  }
+  assert.ok(res.headers['set-cookie'].some(cookie => cookie.startsWith('__Host-auth=;')));
+});
+
+test('cross-origin, opaque and missing origins cannot trigger logout', async () => {
+  for (const headers of [{}, { origin: 'null' }, { origin: 'https://evil.example' },
+    { origin: 'https://sub.coffee.example' }, { origin: 'https://coffee.example', 'sec-fetch-site': 'cross-site' }]) {
+    const res = await request('/logout', { method: 'POST', headers });
+    assert.equal(res.status, 403);
+    assert.equal(res.headers['set-cookie'], undefined);
+    assert.equal(res.headers['clear-site-data'], undefined);
+  }
+});
+
+test('unknown files, malformed targets and unsupported methods fail safely', async () => {
+  for (const url of ['/server.js', '/app.js', '/package.json', '/.git/config', '/../../etc/passwd', '/missing']) {
+    assert.equal((await request(url)).status, 404);
+  }
+  assert.equal((await request('//evil.example/logout')).status, 400);
+  assert.equal((await request('/', { method: 'POST' })).status, 405);
+  assert.equal((await request('/logout', { method: 'DELETE' })).headers.allow, 'GET, HEAD, POST');
+  assert.equal((await request('/', { method: 'HEAD' })).body, '');
+});
+
+test('markup and client code remain compatible with the enforced policy', () => {
+  const html = fs.readFileSync('index.html', 'utf8');
+  const script = fs.readFileSync('public/logout.js', 'utf8');
+  assert.doesNotMatch(html, /<style\b|\sstyle\s*=|\son\w+\s*=|javascript:|<base\b/i);
+  assert.match(html, /<form action="\/logout" method="post"/);
+  assert.doesNotMatch(html, /<a[^>]+href="\/logout"/);
+  assert.doesNotMatch(script, /innerHTML|outerHTML|document\.write\s*\(|\beval\s*\(|new Function\s*\(/);
+});
+
+test('proxy deployments pin the public origin and reject scheme mismatches', async () => {
+  const headers = { origin: 'https://coffee.example' };
+  assert.equal((await request('/logout', { method: 'POST', headers })).status, 403);
+  assert.equal((await request('/logout', { method: 'POST', headers, publicOrigin: 'https://coffee.example' })).status, 200);
+  assert.throws(() => createHandler({ publicOrigin: 'https://coffee.example/' }));
+});
