diff --git a/public/logout.js b/public/logout.js
new file mode 100644
index 0000000..2bc1698
--- /dev/null
+++ b/public/logout.js
@@ -0,0 +1,15 @@
+'use strict';
+
+// Fallback for storage APIs when Clear-Site-Data is unavailable. No HTML sinks,
+// eval, dynamic scripts, or permissive Trusted Types policy are needed.
+for (const name of ['localStorage', 'sessionStorage']) {
+  try {
+    window[name].clear();
+  } catch {
+    // Storage may be disabled by browser privacy settings.
+  }
+}
+// Clear cached account views when restoring the logout confirmation from history.
+window.addEventListener('pageshow', (event) => {
+  if (event.persisted) window.location.replace('/');
+});
