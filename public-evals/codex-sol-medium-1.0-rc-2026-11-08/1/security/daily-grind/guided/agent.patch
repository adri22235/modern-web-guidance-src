diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..8c2cde2
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,90 @@
+'use strict';
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { Readable } = require('node:stream');
+const { readFileSync } = require('node:fs');
+const { handleRequest } = require('../request-handler');
+
+// No sockets, server entrypoint imports, or browser sessions.
+async function request(url, { method = 'GET', headers = {}, body = '' } = {}) {
+  const req = Readable.from(body ? [Buffer.from(body)] : []);
+  Object.assign(req, { url, method, headers });
+  const logs = [];
+  const res = {
+    headers: {}, headersSent: false,
+    setHeader(key, value) { this.headers[key.toLowerCase()] = value; },
+    writeHead(status, headers) {
+      this.status = status;
+      for (const [key, value] of Object.entries(headers)) this.setHeader(key, value);
+      this.headersSent = true;
+    },
+    end(body) { this.body = body === undefined ? '' : body.toString(); },
+  };
+  await handleRequest(req, res, { log: event => logs.push(event) });
+  return { ...res, logs };
+}
+test('published pages and CSS remain usable under the enforced policy', async () => {
+  const html = readFileSync('index.html', 'utf8');
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle=|\son\w+=|javascript:/i);
+  assert.match(html, /href="\/styles.css"/);
+  for (const url of ['/', ...[...html.matchAll(/href="(\/[^"#]*)"/g)].map(match => match[1])]) {
+    const res = await request(url);
+    assert.equal(res.status, 200, url);
+    assert.match(res.headers['content-security-policy'], /require-trusted-types-for 'script'/);
+    assert.match(res.headers['content-security-policy'], /default-src 'none'/);
+    assert.equal(res.headers['x-content-type-options'], 'nosniff');
+    assert.equal(res.headers['x-frame-options'], 'DENY');
+    assert.equal(res.headers['reporting-endpoints'], 'default="/security-reports"');
+    assert.equal(res.headers['cache-control'], 'no-store');
+  }
+  assert.match((await request('/styles.css')).headers['content-type'], /^text\/css/);
+});
+test('logout clears site state and expires cookies without reflecting values', async () => {
+  for (const method of ['GET', 'POST']) {
+    for (const url of ['/logout', '/logout/?next=https://evil.example']) {
+      const res = await request(url, { method, headers: { cookie: 'session=SECRET; __Host-session=TOKEN; preferences=value' } });
+      assert.equal(res.status, 200);
+      assert.equal(res.headers['clear-site-data'], '"cookies", "storage", "cache"');
+      assert.ok(res.headers['set-cookie'].some(cookie => cookie.startsWith('preferences=;')));
+      assert.ok(res.headers['set-cookie'].every(cookie => cookie.includes('Max-Age=0')));
+      assert.ok(res.headers['set-cookie'].find(cookie => cookie.startsWith('__Host-session=')).includes('; Secure'));
+      assert.doesNotMatch(JSON.stringify(res), /SECRET|TOKEN|evil\.example/);
+    }
+  }
+  const head = await request('/logout', { method: 'HEAD' });
+  assert.equal(head.body, '');
+  assert.equal(head.headers['clear-site-data'], undefined);
+  assert.equal(head.headers['set-cookie'], undefined);
+});
+test('fetch metadata isolates resources while preserving incoming page links', async () => {
+  const headers = { 'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document' };
+  assert.equal((await request('/', { headers })).status, 200);
+  assert.equal((await request('/logout', { headers })).status, 403);
+  assert.equal((await request('/styles.css', { headers: { 'sec-fetch-site': 'cross-site' } })).status, 403);
+  assert.equal((await request('/logout', { headers: { 'sec-fetch-site': 'same-origin' } })).status, 200);
+});
+test('unknown paths, invalid URLs, methods, and HEAD are handled without disclosure', async () => {
+  for (const path of ['/server.js', '/request-handler.js', '/package.json', '/.git/config', '/%2e%2e/package.json']) {
+    assert.equal((await request(path)).status, 404);
+  }
+  assert.equal((await request('/%zz')).status, 400);
+  assert.equal((await request('/', { method: 'POST' })).status, 405);
+  assert.equal((await request('/logout', { method: 'DELETE' })).status, 405);
+  assert.equal((await request('/', { method: 'HEAD' })).body, '');
+});
+test('report collection accepts both formats and logs only safe aggregate counts', async () => {
+  const bodies = [
+    { 'csp-report': { 'effective-directive': 'script-src', 'document-uri': 'https://example.test/?token=SECRET', 'script-sample': 'SECRET' } },
+    [{ type: 'csp-violation', body: { effectiveDirective: 'script-src', sourceFile: 'SECRET' } }],
+  ];
+  for (const body of bodies) {
+    const res = await request('/security-reports', { method: 'POST', headers: { 'content-type': 'application/reports+json' }, body: JSON.stringify(body) });
+    assert.equal(res.status, 204);
+    assert.deepEqual(res.logs, [{ event: 'browser-policy-reports', counts: { 'script-src': 1 } }]);
+  }
+  const post = body => request('/security-reports', { method: 'POST', headers: { 'content-type': 'application/csp-report' }, body });
+  assert.equal((await post('not json')).status, 400);
+  assert.equal((await post('x'.repeat(16385))).status, 413);
+  assert.equal((await request('/security-reports', { method: 'POST' })).status, 415);
+  assert.equal((await request('/security-reports')).status, 405);
