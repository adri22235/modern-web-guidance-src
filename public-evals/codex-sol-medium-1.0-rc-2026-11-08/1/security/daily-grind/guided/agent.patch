@@ -0,0 +1,130 @@
+'use strict';
+const { readFileSync } = require('node:fs');
+const { join } = require('node:path');
+
+// Explicit publication list: URL paths never become filesystem paths.
+const home = readFileSync(join(__dirname, 'index.html'));
+const stylesheet = readFileSync(join(__dirname, 'styles.css'));
+const pages = new Set([
+  '/', '/menu', '/locations', '/rewards', '/account', '/order-online',
+  '/menu/seasonal', '/menu/espresso', '/menu/cold-brew', '/about',
+  '/careers', '/contact', '/privacy-policy',
+]);
+const policy = [
+  "default-src 'none'", "script-src 'none' 'report-sample'",
+  "script-src-attr 'none'", "style-src 'self'", "style-src-attr 'none'",
+  'img-src https://images.unsplash.com', "connect-src 'none'",
+  "object-src 'none'", "base-uri 'none'", "frame-ancestors 'none'",
+  "form-action 'self'", "require-trusted-types-for 'script'",
+  "trusted-types 'none'", 'report-to default', 'report-uri /security-reports',
+].join('; ');
+const directives = new Set([
+  'default-src', 'script-src', 'script-src-elem', 'script-src-attr',
+  'style-src', 'style-src-elem', 'style-src-attr', 'img-src', 'connect-src',
+  'object-src', 'base-uri', 'frame-ancestors', 'form-action',
+  'require-trusted-types-for', 'trusted-types',
+]);
+function send(req, res, status, type, body) {
+  res.writeHead(status, { 'Content-Type': `${type}; charset=utf-8` });
+  res.end(req.method === 'HEAD' ? undefined : body);
+}
+async function receiveReports(req, res, log) {
+  const type = (req.headers['content-type'] || '').split(';')[0].trim();
+  if (!['application/reports+json', 'application/csp-report', 'application/json'].includes(type)) {
+    req.resume();
+    return send(req, res, 415, 'text/plain', 'Unsupported report format');
+  }
+  let size = 0;
+  const chunks = [];
+  // Keep the socket alive when stopping early so the 413 can reach the client.
+  for await (const chunk of req.iterator({ destroyOnReturn: false })) {
+    size += Buffer.byteLength(chunk);
+    if (size > 16384) {
+      req.resume();
+      return send(req, res, 413, 'text/plain', 'Report too large');
+    }
+    chunks.push(Buffer.from(chunk));
+  }
+  let reports;
+  try {
+    const data = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+    reports = Array.isArray(data) ? data : [{ type: 'csp-violation', body: data?.['csp-report'] }];
+  } catch {
+    return send(req, res, 400, 'text/plain', 'Invalid report');
+  }
+  // Untrusted reports: log only fixed-vocabulary counts, never URLs, samples,
+  // referrers, raw bodies, cookie values, or user-agent strings.
+  const counts = {};
+  for (const report of reports.slice(0, 50)) {
+    if (report?.type !== 'csp-violation') continue;
+    const directive = report.body?.effectiveDirective || report.body?.['effective-directive'];
+    const key = directives.has(directive) ? directive : 'other';
+    counts[key] = (counts[key] || 0) + 1;
+  }
+  if (Object.keys(counts).length) log({ event: 'browser-policy-reports', counts });
+  send(req, res, 204, 'text/plain', '');
+}
+async function handleRequest(req, res, { log = console.info } = {}) {
+  res.setHeader('Content-Security-Policy', policy);
+  // Relative reporting URL avoids trusting a client-controlled Host header.
+  res.setHeader('Reporting-Endpoints', 'default="/security-reports"');
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'no-referrer');
+  res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), focus-without-user-activation=()');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+  // Initial short HSTS rollout; production TLS terminates at the reverse proxy.
+  res.setHeader('Strict-Transport-Security', 'max-age=300');
+  try {
+    let pathname;
+    try {
+      pathname = decodeURIComponent(new URL(req.url, 'http://localhost').pathname);
+    } catch {
+      return send(req, res, 400, 'text/plain', 'Bad request');
+    }
+    const logout = pathname === '/logout' || pathname === '/logout/';
+    const site = req.headers['sec-fetch-site'];
+    const untrusted = site && !['same-origin', 'none'].includes(site);
+    const navigation = ['GET', 'HEAD'].includes(req.method)
+      && req.headers['sec-fetch-mode'] === 'navigate'
+      && req.headers['sec-fetch-dest'] === 'document';
+    if (untrusted && (!navigation || logout)) {
+      return send(req, res, 403, 'text/plain', 'Forbidden');
+    }
+    if (pathname === '/security-reports') {
+      if (req.method !== 'POST') {
+        res.setHeader('Allow', 'POST');
+        return send(req, res, 405, 'text/plain', 'Method not allowed');
+      }
+      return await receiveReports(req, res, log);
+    }
+    if (!['GET', 'HEAD'].includes(req.method) && !(logout && req.method === 'POST')) {
+      res.setHeader('Allow', logout ? 'GET, HEAD, POST' : 'GET, HEAD');
+      return send(req, res, 405, 'text/plain', 'Method not allowed');
+    }
+    if (logout) {
+      if (req.method !== 'HEAD') {
+        res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+        // Root-cookie fallback for browsers without Clear-Site-Data support.
+        const names = new Set(['__Host-session', 'session']);
+        for (const cookie of (req.headers.cookie || '').split(';')) {
+          const name = cookie.split('=')[0].trim();
+          if (/^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(name)) names.add(name);
+        }
+        res.setHeader('Set-Cookie', [...names].map(name =>
+          `${name}=; Path=/; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; SameSite=Lax${name.startsWith('__Host-') || name.startsWith('__Secure-') ? '; Secure' : ''}`));
+      }
+      return send(req, res, 200, 'text/html', '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Signed out | The Daily Grind</title><link rel="stylesheet" href="/styles.css"></head><body><main class="container"><h1>You are signed out</h1><p>Your browser has been asked to clear this site’s saved data.</p><a href="/">Return to The Daily Grind</a></main></body></html>');
+    }
+    if (pathname === '/styles.css') return send(req, res, 200, 'text/css', stylesheet);
+    if (pages.has(pathname.replace(/\/$/, '') || '/')) return send(req, res, 200, 'text/html', home);
+    return send(req, res, 404, 'text/plain', 'Not found');
+  } catch {
+    if (!res.headersSent) send(req, res, 500, 'text/plain', 'Server error');
+    else res.end();
+  }
+}
+module.exports = { handleRequest };
