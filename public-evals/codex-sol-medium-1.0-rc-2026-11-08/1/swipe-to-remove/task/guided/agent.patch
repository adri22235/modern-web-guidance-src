+  <script>
+    (() => {
+      const list = document.querySelector('.SwipeableList');
+      const handles = new WeakMap();
+      const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+      // Restore the centered snap point on width changes in Firefox/Safari.
+      const widths = new WeakMap();
+      const resizeObserver = needsScrollWorkaround ? new ResizeObserver(entries => {
+        for (const { target, contentRect } of entries) {
+          if (widths.get(target) !== contentRect.width) {
+            widths.set(target, contentRect.width);
+            target.scrollLeft = target.clientWidth;
+          }
+        }
+      }) : null;
+
+      async function removeItem(item, direction = 'right') {
+        if (item.classList.contains('is-removing')) return;
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        const rect = content.getBoundingClientRect();
+        const offset = rect.x - track.getBoundingClientRect().x;
+        const distance = direction === 'left' ? rect.width - offset : -(rect.width + offset);
+        const name = item.querySelector('h3').textContent;
+
+        handles.get(item)?.observer.disconnect();
+        viewportObserver.unobserve(item);
+        resizeObserver?.unobserve(track);
+        item.classList.add('is-removing', 'is-activating');
+
+        // Move focus before making a row inert, without disturbing touch users.
+        if (item.contains(document.activeElement)) {
+          const rows = [...list.children].filter(row => !row.classList.contains('is-removing'));
+          const next = rows.find(row => item.compareDocumentPosition(row) & Node.DOCUMENT_POSITION_FOLLOWING)
+            ?? rows.at(-1);
+          (next?.querySelector('.cart-remove') ?? document.getElementById('cart-heading')).focus({ preventScroll: true });
+        }
+        item.inert = true;
+
+        const remaining = list.querySelectorAll('.SwipeableList-item:not(.is-removing)').length;
+        document.getElementById('cart-count').textContent = `${remaining} ${remaining === 1 ? 'item' : 'items'}`;
+        document.getElementById('cart-empty').hidden = remaining !== 0;
+        document.getElementById('cart-status').textContent = `${name} removed from your cart.`;
+
+        const options = { duration: reducedMotion.matches ? 0 : 300, easing: 'ease', fill: 'forwards' };
+        const collapse = item.animate([{ height: `${item.getBoundingClientRect().height}px` }, { height: '0px' }], options);
+        const slide = content.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${distance}px)` }], options);
+        await Promise.allSettled([collapse.finished, slide.finished]);
+
+        // Safari can transfer an ongoing swipe's momentum to the next row.
+        // Leave an inert, collapsed row in place until that momentum settles.
+        if ('GestureEvent' in globalThis) {
+          setTimeout(() => item.remove(), 5000);
+        } else {
+          item.remove();
+        }
+      }
+
+      function setupItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        item.classList.add('is-initialized');
+        track.tabIndex = 0;
+        // Center before observing, so initialization cannot trigger deletion.
+        if (needsScrollWorkaround) {
+          track.scrollLeft = track.clientWidth;
+          resizeObserver.observe(track);
+        }
+        const observer = new IntersectionObserver(entries => {
+          if (item.classList.contains('is-removing')) return;
+          const entry = entries.at(-1);
+          if (!entry.rootBounds || !entry.boundingClientRect.width) return;
+          const direction = entry.boundingClientRect.x > entry.rootBounds.x ? 'left' : 'right';
+          item.classList.toggle('is-activating', entry.intersectionRatio < 0.8);
+          // Commit once more than 80% of the row has been swiped away.
+          if (entry.intersectionRatio < 0.2) removeItem(item, direction);
+        }, { root: track, threshold: [0.2, 0.8] });
+        const handle = { observer, content };
+        handles.set(item, handle);
+        return handle;
+      }
+
+      const viewportObserver = new IntersectionObserver(entries => {
+        for (const { target: item, isIntersecting } of entries) {
+          if (item.classList.contains('is-removing')) continue;
+          if (isIntersecting) {
+            const handle = handles.get(item) ?? setupItem(item);
+            handle.observer.observe(handle.content);
+          } else {
+            handles.get(item)?.observer.disconnect();
+          }
+        }
+      });
+
+      for (const item of list.children) viewportObserver.observe(item);
+      list.addEventListener('click', event => {
+        const button = event.target.closest('.cart-remove');
+        if (button) removeItem(button.closest('.SwipeableList-item'));
+      });
+    })();
+  </script>
+
