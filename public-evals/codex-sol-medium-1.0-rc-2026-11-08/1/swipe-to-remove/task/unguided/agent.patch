+  <script>
+    (() => {
+      const list = document.querySelector('.SwipeableList');
+      const status = document.querySelector('#cart-status');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+
+      function updateCart() {
+        const items = [...list.querySelectorAll('.SwipeableList-item:not(.is-removing)')];
+        document.querySelector('#cart-count').textContent = `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
+        document.querySelector('#cart-total').textContent = money.format(
+          items.reduce((sum, item) => sum + Number(item.dataset.price), 0) / 100
+        );
+        document.querySelector('.cart-empty').hidden = items.length > 0;
+      }
+
+      function removeItem(item, direction = -1) {
+        if (item.classList.contains('is-removing')) return;
+        const content = item.querySelector('.SwipeableList-content');
+        const name = item.querySelector('h3').textContent;
+        const hadFocus = item.contains(document.activeElement);
+        item.style.height = `${item.getBoundingClientRect().height}px`;
+        item.classList.remove('is-dragging', 'is-ready');
+        item.classList.add('is-removing');
+        item.inert = true;
+        if (hadFocus) {
+          const remaining = [...list.children].filter(row => !row.classList.contains('is-removing'));
+          (remaining[0]?.querySelector('button') || document.querySelector('#cart-title')).focus();
+        }
+        content.style.transform = `translateX(${direction * item.offsetWidth}px)`;
+        updateCart();
+        status.textContent = `${name} removed from your cart.`;
+        // Paint the action color before collapsing the row, then remove its DOM node.
+        window.setTimeout(() => {
+          item.style.height = '0px';
+          item.style.marginBottom = '0px';
+          item.style.opacity = '0';
+          window.setTimeout(() => item.remove(), reducedMotion.matches ? 0 : 300);
+        }, reducedMotion.matches ? 0 : 180);
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(item => {
+        const content = item.querySelector('.SwipeableList-content');
+        let gesture = null;
+        const threshold = () => Math.min(110, content.offsetWidth * 0.3);
+
+        function reset() {
+          gesture = null;
+          item.classList.remove('is-dragging', 'is-ready');
+          content.style.transform = '';
+        }
+
+        content.addEventListener('pointerdown', event => {
+          if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+          gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, offset: 0, dragging: false };
+        });
+
+        content.addEventListener('pointermove', event => {
+          if (!gesture || gesture.id !== event.pointerId) return;
+          const dx = event.clientX - gesture.x;
+          const dy = event.clientY - gesture.y;
+          if (!gesture.dragging) {
+            if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 8) { reset(); return; }
+            if (Math.abs(dx) < 8) return;
+            gesture.dragging = true;
+            content.setPointerCapture(event.pointerId);
+            item.classList.add('is-dragging');
+          }
+          gesture.offset = dx;
+          content.style.transform = `translateX(${dx}px)`;
+          item.classList.toggle('is-ready', Math.abs(dx) >= threshold());
+        });
+
+        content.addEventListener('pointerup', event => {
+          if (!gesture || gesture.id !== event.pointerId) return;
+          const { offset, dragging } = gesture;
+          gesture = null;
+          if (content.hasPointerCapture(event.pointerId)) content.releasePointerCapture(event.pointerId);
+          if (dragging && Math.abs(offset) >= threshold()) removeItem(item, Math.sign(offset));
+          else reset();
+        });
+
+        content.addEventListener('pointercancel', reset);
+        content.addEventListener('lostpointercapture', () => { if (gesture) reset(); });
+        content.addEventListener('pointerleave', () => { if (gesture && !gesture.dragging) reset(); });
+        item.querySelector('.cart-remove').addEventListener('click', () => removeItem(item));
+        item.classList.add('is-initialized');
+      });
+    })();
+  </script>
