+  <script>
+    (function () {
+      const progress = document.getElementById('scroll-progress');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const nativeProgress = window.CSS && CSS.supports('animation-timeline', 'scroll(root block)');
+      let frame = null;
+
+      function updateProgress() {
+        frame = null;
+        if (nativeProgress && !reducedMotion.matches) {
+          progress.style.removeProperty('transform');
+          return;
+        }
+
+        const root = document.documentElement;
+        const scrollable = root.scrollHeight - root.clientHeight;
+        const position = window.pageYOffset || root.scrollTop;
+        const fraction = scrollable > 0 ? Math.min(1, Math.max(0, position / scrollable)) : 0;
+        progress.style.transform = 'scaleX(' + fraction + ')';
+      }
+
+      function scheduleUpdate() {
+        if (!(nativeProgress && !reducedMotion.matches) && frame === null) {
+          frame = window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', updateProgress);
+      } else {
+        reducedMotion.addListener(updateProgress);
+      }
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleUpdate).observe(document.body);
+      }
+      updateProgress();
+    }());
+  </script>
 </body>
 
