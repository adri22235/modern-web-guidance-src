@@ -206,7 +233,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      if (window.CSS && CSS.supports('animation-timeline: scroll(root block)')) {
+        return;
+      }
+
+      var indicator = document.querySelector('.scroll-progress');
+      var scheduled = false;
+
+      function updateProgress() {
+        var root = document.scrollingElement || document.documentElement;
+        var scrollableHeight = root.scrollHeight - root.clientHeight;
+        var progress = scrollableHeight > 0 ? root.scrollTop / scrollableHeight : 0;
+        indicator.style.transform = 'scaleX(' + Math.min(1, Math.max(0, progress)) + ')';
+        scheduled = false;
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          window.requestAnimationFrame(updateProgress);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(scheduleUpdate).observe(document.body);
+      }
+
+      updateProgress();
+    }());
+  </script>
 </body>
 
 </html>
