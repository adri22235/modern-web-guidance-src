+  <dialog class="drawer" id="navigation-drawer" popover="manual" aria-labelledby="drawer-title">
+    <div class="drawer-scroller">
+      <div class="drawer-sheet">
+        <div class="drawer-heading">
+          <h2 id="drawer-title">The Daily Grind</h2>
+          <button type="button" class="drawer-close" id="drawer-close" autofocus>Close</button>
+        </div>
+        <nav aria-label="Main navigation">
+          <ul>
+            <li><a href="/menu">Menu</a></li>
+            <li><a href="/locations">Locations</a></li>
+            <li><a href="/rewards">Rewards</a></li>
+            <li><a href="/account">My Account</a></li>
+            <li><a href="/logout" class="logout-link">Logout</a></li>
+          </ul>
+        </nav>
+      </div>
+    </div>
+  </dialog>
+
+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const closeButton = document.getElementById('drawer-close');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let state = 'closed';
+
+    function finishClosing() {
+      if (state === 'closed') return;
+      state = 'closed';
+      drawer.hidePopover();
+      drawer.removeAttribute('aria-modal');
+      page.inert = false;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus({ preventScroll: true });
+    }
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      drawer.showPopover();
+      page.inert = true;
+      drawer.setAttribute('aria-modal', 'true');
+      openButton.setAttribute('aria-expanded', 'true');
+      closeButton.focus({ preventScroll: true });
+      // Reset every opening, including browsers without scroll-initial-target.
+      scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+      // Let the closed position paint before starting the entrance scroll.
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state === 'opening') scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (state === 'closed') return;
+      state = 'closing';
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        finishClosing();
+      } else {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    // All dismissal paths, including native swipes, finish when the sheet leaves view.
+    new IntersectionObserver(entries => {
+      const entry = entries.at(-1);
+      if (state === 'closed') return;
+      if (entry.intersectionRatio >= 0.999) state = 'open';
+      if (entry.intersectionRatio <= 0.001 && state !== 'opening') finishClosing();
+    }, { root: scroller, threshold: [0, 0.001, 0.999, 1] }).observe(sheet);
+
+    if (!CSS.supports('animation-timeline: scroll()')) {
+      scroller.addEventListener('scroll', () => {
+        const opacity = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / sheet.offsetWidth));
+        drawer.style.setProperty('--drawer-backdrop', opacity);
+      }, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target)) closeDrawer();
+      else if (event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (state === 'closed') return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeDrawer();
+      }
+      // A manual popover needs focus containment in addition to the inert page.
+      if (event.key === 'Tab') {
+        const controls = [...sheet.querySelectorAll('button, a[href]')];
+        const first = controls[0];
+        const last = controls.at(-1);
+        if (event.shiftKey && document.activeElement === first) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus();
+        }
+      }
+    });
+  </script>
