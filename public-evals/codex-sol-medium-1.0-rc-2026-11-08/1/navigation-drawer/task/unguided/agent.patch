+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('#nav-drawer');
+    const closeButton = drawer.querySelector('.close-menu');
+    let previousOverflow = '';
+    let gesture = null;
+    let suppressClick = false;
+
+    function resetSwipe() {
+      gesture = null;
+      drawer.style.transform = '';
+      drawer.style.transition = '';
+    }
+
+    menuButton.addEventListener('click', () => {
+      suppressClick = false;
+      previousOverflow = document.body.style.overflow;
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      document.body.style.overflow = 'hidden';
+    });
+
+    closeButton.addEventListener('click', () => drawer.close());
+    drawer.addEventListener('close', () => {
+      resetSwipe();
+      drawer.style.animation = '';
+      menuButton.setAttribute('aria-expanded', 'false');
+      document.body.style.overflow = previousOverflow;
+      menuButton.focus();
+    });
+
+    function isOutside(event) {
+      const bounds = drawer.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+
+    drawer.addEventListener('pointerdown', (event) => {
+      if (!event.isPrimary || event.button !== 0) return;
+      suppressClick = false;
+      gesture = {
+        id: event.pointerId,
+        x: event.clientX,
+        y: event.clientY,
+        outside: isOutside(event),
+        dragging: false,
+        distance: 0
+      };
+    });
+
+    drawer.addEventListener('pointermove', (event) => {
+      if (!gesture || gesture.id !== event.pointerId || gesture.outside) return;
+      const dx = event.clientX - gesture.x;
+      const dy = event.clientY - gesture.y;
+      if (!gesture.dragging) {
+        if (Math.abs(dy) > 10 && Math.abs(dy) > Math.abs(dx)) {
+          gesture = null;
+          return;
+        }
+        if (dx < 10 || dx <= Math.abs(dy)) return;
+        gesture.dragging = true;
+        drawer.setPointerCapture(event.pointerId);
+        drawer.style.animation = 'none';
+        drawer.style.transition = 'none';
+      }
+      gesture.distance = Math.max(0, dx);
+      drawer.style.transform = `translateX(${gesture.distance}px)`;
+    });
+
+    drawer.addEventListener('pointerup', (event) => {
+      if (!gesture || gesture.id !== event.pointerId) return;
+      const { outside, dragging, distance } = gesture;
+      suppressClick = dragging;
+      const shouldClose = (outside && isOutside(event)) ||
+        (dragging && distance > Math.min(80, drawer.offsetWidth * 0.25));
+      if (drawer.hasPointerCapture(event.pointerId)) drawer.releasePointerCapture(event.pointerId);
+      resetSwipe();
+      if (shouldClose) drawer.close();
+    });
+
+    drawer.addEventListener('pointercancel', resetSwipe);
+    drawer.addEventListener('click', (event) => {
+      if (suppressClick) {
+        event.preventDefault();
+        event.stopPropagation();
+        suppressClick = false;
+      } else if (event.target.closest('a')) {
+        drawer.close();
+      }
+    }, true);
+  </script>
