+        <button id="summarize-journal" class="btn" type="button" aria-controls="journal-summary" aria-describedby="journal-status">Summarize</button>
+        <p id="journal-status" class="journal-status" role="status" aria-live="polite">Get a few key points using your browser’s built-in AI. First use may require a model download.</p>
+        <div id="journal-summary" class="journal-summary" role="region" aria-labelledby="summary-title" hidden>
+          <h3 id="summary-title">The story in a few sips</h3>
+          <ul id="journal-summary-points"></ul>
+        </div>
+        <noscript><p>Enable JavaScript to summarize the journal with your browser’s built-in AI.</p></noscript>
+      </div>
+    </section>
