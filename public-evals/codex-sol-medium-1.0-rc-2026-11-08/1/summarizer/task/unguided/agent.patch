+  <script>
+    const summarizeButton = document.getElementById('summarize-journal');
+    const journalStatus = document.getElementById('journal-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('journal-summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!('Summarizer' in window)) {
+        journalStatus.textContent = 'Built-in AI summarization isn’t available in this browser. Try a supported desktop browser with built-in AI enabled.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.hidden = true;
+      summaryPanel.setAttribute('aria-busy', 'true');
+      journalStatus.textContent = 'Preparing your browser’s AI… First use may take a little longer.';
+      let summarizer;
+
+      try {
+        // Create directly in the click handler to retain user activation for model downloads.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              journalStatus.textContent = `Downloading your browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+            });
+          }
+        });
+
+        journalStatus.textContent = 'Reading the journal and finding the key points…';
+        const text = document.getElementById('journal-story').innerText;
+        const summary = await summarizer.summarize(text);
+        const points = [];
+        for (const line of summary.split(/\r?\n/)) {
+          const trimmed = line.trim();
+          if (!trimmed) continue;
+          const bullet = /^(?:[-*•–] |\d+[.)]\s+)/.test(trimmed);
+          const point = trimmed.replace(/^(?:[-*•–]\s+|\d+[.)]\s+)/, '').trim();
+          if (bullet || points.length === 0) points.push(point);
+          else points[points.length - 1] += ` ${point}`;
+        }
+        if (!points.length) throw new Error('Empty summary');
+
+        // Treat generated text as text, never as HTML.
+        summaryPoints.replaceChildren(...points.map((point) => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        journalStatus.textContent = 'Summary ready. Generated by AI on your device; read the full journal for the details.';
+      } catch (error) {
+        journalStatus.textContent = error.name === 'NotSupportedError'
+          ? 'Built-in AI summarization isn’t available on this device or for this browser configuration. You can still read the full journal above.'
+          : 'We couldn’t create a summary. Check your connection if the AI model needs to download, then try again.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summaryPanel.setAttribute('aria-busy', 'false');
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+      }
+    });
+  </script>
+
