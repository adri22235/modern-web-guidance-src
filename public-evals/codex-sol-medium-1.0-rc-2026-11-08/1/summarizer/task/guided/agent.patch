+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            const progress = Math.round(event.loaded * 100);
+            status.textContent = `Downloading the on-device AI model: ${progress}%. The first use may take a few minutes.`;
+          });
+        },
+      };
+
+      async function checkAvailability() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = 'On-device summaries are not supported in this browser. Try a compatible desktop browser over HTTPS; the full journal is available above.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'On-device AI is not available on this device. You can still read the full journal above.';
+            return;
+          }
+
+          button.disabled = false;
+          status.textContent = availability === 'available'
+            ? 'Get a few key points with AI running on your device.'
+            : 'The first summary needs a browser AI model download, which may take a few minutes. Summarizing stays on your device.';
+        } catch {
+          status.textContent = 'Your browser could not check on-device AI availability. Reload the page to try again.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing on-device AI…';
+        let summarizer;
+
+        try {
+          // Call create directly from the click so model downloads retain user activation.
+          summarizer = await window.Summarizer.create(options);
+          status.textContent = 'Reading the journal and preparing your key points…';
+          const text = document.getElementById('journal-copy').innerText;
+          const result = await summarizer.summarize(text);
+          const bullets = result.split(/\r?\n/)
+            .map((line) => line.replace(/^\s*(?:[-*•]\s*|\d+[.)]\s+)/, '').trim())
+            .filter(Boolean);
+          if (!bullets.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...bullets.map((text) => {
+            const item = document.createElement('li');
+            item.textContent = text;
+            return item;
+          }));
+          summary.hidden = false;
+          status.textContent = 'Summary ready below. Generated by on-device AI; see the journal for the full story.';
+        } catch {
+          status.textContent = 'We could not create a summary. Please try again. Your browser may need to finish downloading its AI model.';
+        } finally {
+          summarizer?.destroy();
+          summary.removeAttribute('aria-busy');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
