+  <script>
+    const shop = document.getElementById('local-shop');
+
+    // Read after the browser updates its interaction and validation state.
+    const syncShopValidity = () => {
+      requestAnimationFrame(() => {
+        if (shop.matches(':user-invalid')) {
+          shop.setAttribute('aria-invalid', 'true');
+        } else {
+          shop.removeAttribute('aria-invalid');
+        }
+      });
+    };
+
+    for (const event of ['input', 'change', 'blur', 'invalid']) {
+      shop.addEventListener(event, syncShopValidity);
+    }
+    shop.form.addEventListener('reset', syncShopValidity);
+  </script>
