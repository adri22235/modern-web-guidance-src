+  <script>
+    const orderForm = document.querySelector('.order-form');
+    const localShop = document.getElementById('local-shop');
+    const shopError = document.getElementById('local-shop-error');
+    let shopTouched = false;
+    let orderSubmitted = false;
+
+    // Keep native required validation available when JavaScript is disabled.
+    orderForm.noValidate = true;
+
+    function updateShopValidation() {
+      const showError = (shopTouched || orderSubmitted) && !localShop.validity.valid;
+      shopError.hidden = !showError;
+      if (showError) {
+        localShop.setAttribute('aria-invalid', 'true');
+        localShop.setAttribute('aria-describedby', 'local-shop-error');
+      } else {
+        localShop.removeAttribute('aria-invalid');
+        localShop.removeAttribute('aria-describedby');
+      }
+    }
+
+    function touchShop() {
+      shopTouched = true;
+      updateShopValidation();
+    }
+
+    localShop.addEventListener('blur', touchShop);
+    localShop.addEventListener('change', touchShop);
+    orderForm.addEventListener('submit', (event) => {
+      orderSubmitted = true;
+      updateShopValidation();
+      if (!localShop.validity.valid) {
+        event.preventDefault();
+        localShop.focus();
+      }
+    });
+  </script>
+
 </body>
 
