+  <script>
+    (() => {
+      const types = {
+        checkout: { label: 'Checkout', priority: 'urgent', rank: 0, duration: 350 },
+        menu: { label: 'Menu update', priority: 'standard', rank: 1, duration: 800 },
+        telemetry: { label: 'Telemetry logging', priority: 'background', rank: 2, duration: 1400 }
+      };
+      const queue = [];
+      const history = [];
+      const taskList = document.getElementById('task-list');
+      const activityList = document.getElementById('activity-list');
+      const status = document.getElementById('queue-status');
+      let nextId = 1;
+      let completed = 0;
+      let scheduled = false;
+
+      function render() {
+        document.getElementById('queue-count').textContent = `${queue.length} task${queue.length === 1 ? '' : 's'}`;
+        document.getElementById('completed-count').textContent = `${completed} completed`;
+        if (!queue.length) {
+          taskList.innerHTML = '<li class="empty-state">All clear. Add a task to get started.</li>';
+          status.textContent = completed ? 'All tasks completed' : 'Ready for tasks';
+          return;
+        }
+        status.textContent = 'Queue running';
+        taskList.replaceChildren(...queue.map((task, index) => {
+          if (!task.element) {
+            task.element = document.createElement('li');
+            task.element.className = 'task-row';
+            task.element.innerHTML = `<div class="task-heading"><strong>${task.label} #${task.id}</strong><span class="priority priority-${task.priority}">${task.priority}</span></div><p class="task-state"></p><progress max="100" value="0" aria-label="${task.label} #${task.id} progress"></progress>`;
+          }
+          const percent = Math.min(100, Math.floor(task.work / task.duration * 100));
+          task.element.querySelector('.task-state').textContent = `${index === 0 ? 'Running' : task.work ? 'Paused for higher priority' : 'Waiting'} · ${percent}%`;
+          task.element.querySelector('progress').value = percent;
+          return task.element;
+        }));
+      }
+
+      // Each slice is bounded to 5ms. Re-select the highest priority task after
+      // yielding to the browser, so new urgent work can preempt a long task.
+      function runSlice() {
+        const task = queue[0];
+        if (!task) { scheduled = false; return; }
+        const start = performance.now();
+        let checksum = task.checksum;
+        do {
+          for (let i = 0; i < 500; i++) checksum = (Math.imul(checksum, 1664525) + 1013904223) | 0;
+        } while (performance.now() - start < 5);
+        task.checksum = checksum;
+        task.work += performance.now() - start;
+        if (task.work >= task.duration) {
+          queue.shift();
+          completed++;
+          const entry = document.createElement('li');
+          const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+          entry.innerHTML = `<strong>${task.label} #${task.id}</strong> completed<span class="activity-time">${time} · ${task.priority} priority</span>`;
+          history.unshift(entry);
+          history.splice(8);
+          activityList.replaceChildren(...history);
+        }
+        render();
+        if (queue.length) setTimeout(runSlice, 0);
+        else scheduled = false;
+      }
+
+      function enqueue(keys) {
+        if (queue.length + keys.length > 40) {
+          status.textContent = 'Queue full — try again shortly';
+          return;
+        }
+        for (const key of keys) {
+          queue.push({ ...types[key], id: nextId++, work: 0, checksum: 1 });
+        }
+        // FIFO within each priority, including partially completed tasks.
+        queue.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        render();
+        if (!scheduled) {
+          scheduled = true;
+          setTimeout(runSlice, 0);
+        }
+      }
+
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        // Submit out of order to demonstrate priority scheduling.
+        enqueue(['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout']);
+      });
+    })();
+  </script>
+
 </body>
 
