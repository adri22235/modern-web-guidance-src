+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Preparing identity verification…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential ||
+            !navigator.credentials?.get ||
+            typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function' ||
+            typeof PublicKeyCredential.prototype.toJSON !== 'function') {
+          throw new Error('Passkey verification requires HTTPS and an up-to-date browser.');
+        }
+
+        // The server identifies the user from the session and issues a fresh,
+        // session-bound challenge restricted to that user's registered keys.
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Accept': 'application/json' },
+        });
+        if (!optionsResponse.ok) {
+          throw new Error('Unable to start identity verification. Please try again.');
+        }
+        const optionsJSON = await optionsResponse.json();
+        if (!Array.isArray(optionsJSON.allowCredentials) ||
+            optionsJSON.allowCredentials.length === 0) {
+          throw new Error('No registered passkeys are available for this account.');
+        }
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+        publicKey.userVerification = 'required';
+        reauthStatus.textContent = 'Confirm with your registered passkey or security key…';
+        // Only request a public-key assertion; saved passwords cannot satisfy it.
+        const credential = await navigator.credentials.get({ publicKey });
+        if (!credential || credential.type !== 'public-key') {
+          throw new Error('Identity verification did not complete. Please try again.');
+        }
+
+        const assertion = credential.toJSON();
+        reauthStatus.textContent = 'Checking identity verification…';
+        const verifyResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(assertion),
+        });
+        if (!verifyResponse.ok) {
+          if (verifyResponse.status === 404 && publicKey.rpId &&
+              typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            // Synchronization is optional and must never hide a verification failure.
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId,
+                credentialId: assertion.id,
+              });
+            } catch { /* The verification failure still takes precedence. */ }
+          }
+          throw new Error('Identity verification was rejected. Please try again.');
+        }
+        // Authorization for the sensitive change remains enforced by the server.
+        reauthStatus.textContent = 'Identity confirmed. You can continue with your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Verification was cancelled or timed out. Please try again.'
+          : error instanceof Error ? error.message : 'Identity verification failed. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    });
+  </script>
