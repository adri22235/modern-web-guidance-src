+  <script>
+    const signupForm = document.getElementById('signup-form');
+    const password = document.getElementById('signup-password');
+    const confirmation = document.getElementById('signup-confirm-password');
+
+    function validatePasswords() {
+      confirmation.setCustomValidity(
+        confirmation.value !== password.value ? 'Passwords must match.' : ''
+      );
+    }
+
+    signupForm.addEventListener('input', () => {
+      validatePasswords();
+      document.getElementById('signup-status').textContent = '';
+    });
+
+    signupForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      validatePasswords();
+      if (!signupForm.reportValidity()) return;
+      document.getElementById('signup-status').textContent =
+        'Your form is valid. Account registration is not available yet, so no account has been created and no details have been sent.';
+      password.value = '';
+      confirmation.value = '';
+    });
+  </script>
