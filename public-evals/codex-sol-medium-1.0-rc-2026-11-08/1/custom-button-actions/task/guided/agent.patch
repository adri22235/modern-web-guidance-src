+  <script>
+    const target = document.getElementById('action-target');
+    const toggleClasses = {
+      '--spin': 'is-spun',
+      '--grow': 'is-grown',
+      '--round': 'is-rounded',
+    };
+    const buttons = document.querySelectorAll('button[commandfor="action-target"]');
+
+    function handleAction(command) {
+      if (command === '--reset') {
+        target.classList.remove(...Object.values(toggleClasses));
+      } else if (Object.hasOwn(toggleClasses, command)) {
+        target.classList.toggle(toggleClasses[command]);
+      }
+
+      buttons.forEach((button) => {
+        const className = toggleClasses[button.getAttribute('command')];
+        if (className) {
+          button.setAttribute('aria-pressed', String(target.classList.contains(className)));
+        }
+      });
+    }
+
+    target.addEventListener('command', (event) => handleAction(event.command));
+
+    // Older browsers use clicks; native invokers must not toggle a second time.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      buttons.forEach((button) => {
+        button.addEventListener('click', () => handleAction(button.getAttribute('command')));
+      });
+    }
+  </script>
