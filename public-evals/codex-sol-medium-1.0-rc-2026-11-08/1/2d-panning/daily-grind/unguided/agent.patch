+  <script>
+    (() => {
+      const map = document.getElementById('locations-map');
+      let drag = null;
+      let suppressClick = false;
+
+      const recenter = () => {
+        map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+        map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+      };
+
+      map.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0 || drag) return;
+        suppressClick = false;
+        drag = {
+          id: event.pointerId,
+          x: event.clientX,
+          y: event.clientY,
+          distance: 0,
+          captured: false
+        };
+        map.focus({ preventScroll: true });
+      });
+
+      map.addEventListener('pointermove', (event) => {
+        if (!drag || event.pointerId !== drag.id) return;
+        const dx = event.clientX - drag.x;
+        const dy = event.clientY - drag.y;
+        drag.distance += Math.hypot(dx, dy);
+        if (!drag.captured && drag.distance > 4) {
+          map.setPointerCapture(event.pointerId);
+          drag.captured = true;
+          suppressClick = true;
+          map.classList.add('is-dragging');
+        }
+        // Apply both deltas each time: no dominant-axis detection or locking.
+        map.scrollLeft -= dx;
+        map.scrollTop -= dy;
+        drag.x = event.clientX;
+        drag.y = event.clientY;
+      });
+
+      const endDrag = (event) => {
+        if (!drag || event.pointerId !== drag.id) return;
+        drag = null;
+        map.classList.remove('is-dragging');
+        if (map.hasPointerCapture(event.pointerId)) {
+          map.releasePointerCapture(event.pointerId);
+        }
+      };
+
+      window.addEventListener('pointerup', endDrag);
+      window.addEventListener('pointercancel', endDrag);
+      map.addEventListener('lostpointercapture', endDrag);
+      map.addEventListener('dragstart', (event) => event.preventDefault());
+      map.addEventListener('click', (event) => {
+        if (suppressClick && event.detail !== 0) {
+          event.preventDefault();
+          event.stopPropagation();
+        }
+        suppressClick = false;
+      }, true);
+
+      document.getElementById('map-reset').addEventListener('click', recenter);
+      recenter();
+    })();
+  </script>
