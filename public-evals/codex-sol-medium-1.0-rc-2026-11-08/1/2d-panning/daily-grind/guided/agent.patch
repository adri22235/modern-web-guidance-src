+  <script>
+    const map = document.getElementById('cafe-map');
+    const nativeFreePan = CSS.supports('scroll-axis-lock', 'none');
+
+    function recenterMap() {
+      map.scrollLeft = (map.scrollWidth - map.clientWidth) / 2;
+      map.scrollTop = (map.scrollHeight - map.clientHeight) / 2;
+    }
+
+    document.getElementById('map-reset').addEventListener('click', recenterMap);
+    document.querySelectorAll('[data-pan]').forEach((button) => {
+      button.addEventListener('click', () => {
+        const deltas = { left: [-180, 0], right: [180, 0], up: [0, -180], down: [0, 180] };
+        const [x, y] = deltas[button.dataset.pan];
+        map.scrollLeft += x;
+        map.scrollTop += y;
+      });
+    });
+
+    if (!nativeFreePan) {
+      map.classList.add('has-pan-fallback');
+      map.addEventListener('wheel', (event) => {
+        if (event.ctrlKey || event.metaKey) return; // Keep browser zoom available.
+        event.preventDefault();
+        const unitX = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientWidth : 1;
+        const unitY = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? map.clientHeight : 1;
+        if (event.shiftKey && event.deltaX === 0) {
+          map.scrollLeft += event.deltaY * unitX;
+        } else {
+          map.scrollLeft += event.deltaX * unitX;
+          map.scrollTop += event.deltaY * unitY;
+        }
+      }, { passive: false });
+    }
+
+    // Mouse dragging works everywhere; native touch scrolling stays in charge
+    // where supported. The fallback consumes both raw deltas on every move.
+    let pointer = null;
+    map.addEventListener('pointerdown', (event) => {
+      if (nativeFreePan && event.pointerType !== 'mouse') return;
+      if (!event.isPrimary || event.button !== 0 || pointer) return;
+      const rect = map.getBoundingClientRect();
+      const x = event.clientX - rect.left - map.clientLeft;
+      const y = event.clientY - rect.top - map.clientTop;
+      if (x < 0 || y < 0 || x >= map.clientWidth || y >= map.clientHeight) return;
+      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
+      map.setPointerCapture(event.pointerId);
+      map.classList.add('is-panning');
+      map.focus({ preventScroll: true });
+      if (event.pointerType === 'mouse') event.preventDefault();
+    });
+
+    map.addEventListener('pointermove', (event) => {
+      if (!pointer || pointer.id !== event.pointerId) return;
+      map.scrollLeft -= event.clientX - pointer.x;
+      map.scrollTop -= event.clientY - pointer.y;
+      pointer.x = event.clientX;
+      pointer.y = event.clientY;
+    });
+
+    function endPan(event) {
+      if (!pointer || pointer.id !== event.pointerId) return;
+      pointer = null;
+      map.classList.remove('is-panning');
+      if (map.hasPointerCapture(event.pointerId)) map.releasePointerCapture(event.pointerId);
+    }
+
+    map.addEventListener('pointerup', endPan);
+    map.addEventListener('pointercancel', endPan);
+    map.addEventListener('lostpointercapture', endPan);
+    recenterMap();
+  </script>
+
