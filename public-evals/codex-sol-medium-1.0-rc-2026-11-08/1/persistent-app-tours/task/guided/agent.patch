+  <script>
+    const feature = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTour = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    let tourOpen = true;
+    let trackingFrame;
+
+    // Manual popovers remain open on outside clicks and Escape.
+    tourStep.hidden = false;
+    if (supportsPopover) tourStep.showPopover();
+
+    // Keep the overlay tethered even in browsers without CSS anchors.
+    if (!CSS.supports('top: anchor(bottom)')) {
+      const trackFeature = () => {
+        const target = feature.getBoundingClientRect();
+        const width = tourStep.offsetWidth;
+        tourStep.style.top = `${target.bottom + 12}px`;
+        tourStep.style.left = `${Math.max(16, Math.min(target.left + target.width / 2 - width / 2, document.documentElement.clientWidth - width - 16))}px`;
+        trackingFrame = requestAnimationFrame(trackFeature);
+      };
+      trackFeature();
+    }
+
+    closeTour.focus({ preventScroll: true });
+    closeTour.addEventListener('click', () => {
+      tourOpen = false;
+      if (supportsPopover) tourStep.hidePopover();
+      tourStep.hidden = true;
+      cancelAnimationFrame(trackingFrame);
+      feature.removeAttribute('aria-details');
+      feature.focus({ preventScroll: true });
+    });
+
+    const preventTourNavigation = (event) => {
+      if (tourOpen) event.preventDefault();
+    };
+    feature.addEventListener('click', preventTourNavigation);
+    feature.addEventListener('auxclick', preventTourNavigation);
+  </script>
+
