diff --git a/src/utils/agentForms.ts b/src/utils/agentForms.ts
new file mode 100644
index 0000000..544b178
--- /dev/null
+++ b/src/utils/agentForms.ts
@@ -0,0 +1,11 @@
+/** Declarative WebMCP is optional; ordinary submissions use the same handler. */
+type AgentSubmitEvent = Event & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<unknown>) => void;
+};
+
+export function respondToAgent(event: AgentSubmitEvent, result: Promise<unknown>) {
+  if (event.agentInvoked && typeof event.respondWith === 'function') {
+    event.respondWith(result);
+  }
+}
