new file mode 100644
index 0000000..d238901
--- /dev/null
+++ b/src/types/webmcp.ts
@@ -0,0 +1,14 @@
+import 'react';
+
+// Experimental declarative WebMCP additions, pending upstream DOM/React types.
+declare module 'react' {
+  interface FormHTMLAttributes<T> {
+    toolname?: string;
+    tooldescription?: string;
+  }
+}
+
+export type AgentSubmitEvent = SubmitEvent & {
+  agentInvoked?: boolean;
+  respondWith?: (result: Promise<string>) => void;
+};
