+(() => {
+  const form = document.getElementById('coffee-finder-form');
+  const status = document.getElementById('finder-status');
+  const results = document.getElementById('finder-results');
+  const coffees = [
+    {
+      name: 'Maple Oat Latte',
+      description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+      flavor: 'sweet',
+      temperature: 'hot',
+      url: '/menu/seasonal',
+    },
+    {
+      name: 'Dark Roast Espresso',
+      description: 'Bold, smokey, and perfect for a morning boost.',
+      flavor: 'bold',
+      temperature: 'hot',
+      url: '/menu/espresso',
+    },
+    {
+      name: 'Cold Brew',
+      description: 'Steeped for 18 hours for maximum smoothness.',
+      flavor: 'smooth',
+      temperature: 'iced',
+      url: '/menu/cold-brew',
+    },
+  ];
+
+  function findCoffee() {
+    const data = new FormData(form);
+    const flavor = data.get('flavor');
+    const temperature = data.get('temperature');
+    if (!form.checkValidity()
+      || !['any', 'sweet', 'bold', 'smooth'].includes(flavor)
+      || !['any', 'hot', 'iced'].includes(temperature)) {
+      const message = 'Please choose a flavor and a serving temperature from the available options.';
+      results.replaceChildren();
+      status.textContent = message;
+      form.reportValidity();
+      return { error: message };
+    }
+
+    const matches = coffees.filter(coffee =>
+      (flavor === 'any' || coffee.flavor === flavor)
+      && (temperature === 'any' || coffee.temperature === temperature));
+
+    const cards = matches.map(coffee => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = coffee.name;
+      const description = document.createElement('p');
+      description.textContent = coffee.description;
+      const temperatureLabel = document.createElement('p');
+      temperatureLabel.textContent = coffee.temperature === 'hot' ? 'Served hot' : 'Served iced';
+      const link = document.createElement('a');
+      link.className = 'btn';
+      link.href = coffee.url;
+      link.textContent = `Explore ${coffee.name}`;
+      card.append(heading, description, temperatureLabel, link);
+      return card;
+    });
+    results.replaceChildren(...cards);
+    const message = matches.length
+      ? `${matches.length} coffee${matches.length === 1 ? '' : 's'} found for you.`
+      : 'No coffees match this combination. Try another flavor or choose “Either works” for temperature.';
+    status.textContent = message;
+    return { message, matches };
+  }
+
+  form.addEventListener('submit', event => {
+    event.preventDefault();
+    const result = findCoffee();
+    // Supporting browsers deliver the same result to the invoking agent.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(JSON.stringify(result)));
+    }
+  });
+
+  // Restore GET submissions when scripting becomes available after navigation.
+  const params = new URLSearchParams(window.location.search);
+  if (params.has('flavor') || params.has('temperature')) {
+    for (const name of ['flavor', 'temperature']) {
+      const value = params.get(name);
+      for (const control of form.elements.namedItem(name)) {
+        if (control.value === value) control.checked = true;
+      }
+    }
+    findCoffee();
+  }
+})();
