@@ -0,0 +1,74 @@
+(() => {
+  const form = document.getElementById('coffee-finder-form');
+  const result = document.getElementById('coffee-result');
+
+  function recommendCoffee(temperature, style) {
+    if (!['hot', 'iced'].includes(temperature) || !['black', 'creamy'].includes(style)) {
+      return { error: 'Choose a temperature and coffee style to find your match.' };
+    }
+
+    if (style === 'creamy') {
+      return {
+        name: temperature === 'iced' ? 'Iced Maple Oat Latte' : 'Maple Oat Latte',
+        description: `Creamy oat milk and Vermont maple syrup, served ${temperature === 'iced' ? 'over ice' : 'hot'}.`,
+        menuUrl: '/menu/seasonal',
+        temperature,
+        style,
+      };
+    }
+
+    return temperature === 'iced'
+      ? {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for a smooth, refreshing coffee. Served over ice without milk.',
+        menuUrl: '/menu/cold-brew',
+        temperature,
+        style,
+      }
+      : {
+        name: 'Dark Roast Espresso',
+        description: 'A bold, smoky espresso, served hot without milk for a rich coffee kick.',
+        menuUrl: '/menu/espresso',
+        temperature,
+        style,
+      };
+  }
+
+  function showResult(recommendation) {
+    result.replaceChildren();
+    result.classList.add('finder-result');
+
+    if (recommendation.error) {
+      result.textContent = recommendation.error;
+      return;
+    }
+
+    const heading = document.createElement('h3');
+    heading.textContent = `Your match: ${recommendation.name}`;
+    const description = document.createElement('p');
+    description.textContent = recommendation.description;
+    const link = document.createElement('a');
+    link.className = 'btn';
+    link.href = recommendation.menuUrl;
+    link.textContent = 'View Details';
+    result.append(heading, description, link);
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const values = new FormData(form);
+    const recommendation = recommendCoffee(values.get('temperature'), values.get('style'));
+    showResult(recommendation);
+
+    // The same submit path serves people and declarative WebMCP callers.
+    // Browsers without WebMCP continue to use the ordinary HTML form.
+    if (event.agentInvoked && typeof event.respondWith === 'function') {
+      event.respondWith(Promise.resolve(recommendation));
+    }
+  });
+
+  form.addEventListener('change', () => {
+    result.replaceChildren();
+    result.classList.remove('finder-result');
+  });
+})();
