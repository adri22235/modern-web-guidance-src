+  <script>
+    // Ignore trailing slashes and the static home filename when matching routes.
+    const normalizePath = (path) => path.replace(/\/index\.html$/, '/').replace(/\/+$/, '') || '/';
+    const currentPath = normalizePath(window.location.pathname);
+    const navigationLinks = [...document.querySelectorAll('nav a[href]')];
+    const currentLink = navigationLinks
+      .filter((link) => {
+        const path = normalizePath(new URL(link.href).pathname);
+        return path === currentPath || (path !== '/' && currentPath.startsWith(`${path}/`));
+      })
+      .sort((a, b) => new URL(b.href).pathname.length - new URL(a.href).pathname.length)[0];
+
+    if (currentLink) {
+      const exactMatch = normalizePath(new URL(currentLink.href).pathname) === currentPath;
+      currentLink.setAttribute('aria-current', exactMatch ? 'page' : 'location');
+    }
+  </script>
