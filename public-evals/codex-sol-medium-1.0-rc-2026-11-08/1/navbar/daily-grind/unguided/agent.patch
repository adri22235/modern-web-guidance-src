+  <script>
+    // Match whole path segments so section pages also highlight their navigation link.
+    const normalizePath = (path) => path.replace(/\/index\.html$/, '/').replace(/\/+$/, '') || '/';
+    const currentPath = normalizePath(window.location.pathname);
+    const navigationLinks = [...document.querySelectorAll('nav a')];
+    const activeLink = navigationLinks
+      .filter((link) => {
+        const path = normalizePath(new URL(link.href).pathname);
+        return currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`));
+      })
+      .sort((a, b) => b.pathname.length - a.pathname.length)[0];
+
+    navigationLinks.forEach((link) => {
+      if (link === activeLink) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    });
+  </script>
