+  <script>
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const roast = document.querySelector('.roast-track');
+    const roastToggle = document.querySelector('.roast-toggle');
+    let roastPaused = false;
+
+    // Some event sources expose the animation directly. Native CSS events instead
+    // identify it by name/property, so resolve that exact animation on the target.
+    function recordAnimationState(event) {
+      const animation = event.animation ?? event.target.getAnimations?.().find(candidate =>
+        event.animationName ? candidate.animationName === event.animationName :
+        candidate.transitionProperty === event.propertyName);
+      const terminalState = event.type.endsWith('cancel') ? 'idle' :
+        event.type.endsWith('end') ? 'finished' : 'running';
+      document.body.dataset.lastAnimationState = animation?.playState ?? terminalState;
+    }
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, recordAnimationState);
+    }
+
+    function updateRoast() {
+      roast.classList.toggle('is-paused', roastPaused);
+      roastToggle.disabled = reducedMotion.matches;
+      roastToggle.textContent = reducedMotion.matches ? 'Motion off' : roastPaused ? 'Resume' : 'Pause';
+      roastToggle.setAttribute('aria-pressed', String(roastPaused || reducedMotion.matches));
+      roastToggle.setAttribute('aria-label', reducedMotion.matches ? 'Daily roast motion disabled by your preference' :
+        roastPaused ? 'Resume daily roast animation' : 'Pause daily roast animation');
+      const animation = roast.getAnimations()[0];
+      document.body.dataset.lastAnimationState = animation?.playState ?? 'idle';
+    }
+    roastToggle.addEventListener('click', () => { roastPaused = !roastPaused; updateRoast(); });
+
+    const drinks = {
+      maple: { title: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup. Rich espresso brings warmth and balance to this cozy seasonal favorite.', notes: 'Tasting notes: maple sweetness · toasted oats · mellow espresso' },
+      espresso: { title: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost. A concentrated espresso with deep roasted flavor and a rich, lingering finish.', notes: 'Tasting notes: dark cocoa · toasted caramel · smoky finish' },
+      'cold-brew': { title: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness. Slowly extracted coffee served over ice for a refreshing, full-bodied sip.', notes: 'Tasting notes: smooth cocoa · gentle sweetness · clean finish' }
+    };
+    const dialog = document.querySelector('#drink-details');
+    let closing = false;
+    let closeTimer;
+    let trigger;
+    function finishClose() {
+      if (!closing) return;
+      clearTimeout(closeTimer);
+      dialog.close();
+      dialog.classList.remove('is-closing');
+      closing = false;
+    }
+    function closeDetails() {
+      if (!dialog.open || closing) return;
+      closing = true;
+      if (reducedMotion.matches) { finishClose(); return; }
+      dialog.classList.add('is-closing');
+      // Fallback also releases the modal if an animation is interrupted.
+      closeTimer = setTimeout(finishClose, 300);
+    }
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        trigger = button;
+        document.querySelector('#drink-title').textContent = drink.title;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        dialog.showModal();
+      });
+    });
+    dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => { event.preventDefault(); closeDetails(); });
+    dialog.addEventListener('click', event => {
+      const bounds = dialog.getBoundingClientRect();
+      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom)) closeDetails();
+    });
+    dialog.addEventListener('animationend', event => {
+      if (event.target === dialog && event.animationName === 'dialog-out') finishClose();
+    });
+    dialog.addEventListener('close', () => { trigger?.focus({ preventScroll: true }); });
+    reducedMotion.addEventListener('change', () => {
+      updateRoast();
+      if (closing && reducedMotion.matches) finishClose();
+    });
+    updateRoast();
+  </script>
