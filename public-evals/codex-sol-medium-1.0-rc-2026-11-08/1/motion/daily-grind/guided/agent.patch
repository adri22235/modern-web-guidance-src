+  <script>
+    // Newer browsers expose the exact animation on the originating event.
+    // Older browsers still report useful lifecycle state without guessing an object by name.
+    function recordAnimationState(event) {
+      const animation = event.animation;
+      const fallbackStates = {
+        animationstart: 'running', animationiteration: 'running',
+        animationend: 'finished', animationcancel: 'idle',
+        transitionrun: 'running', transitionstart: 'running',
+        transitionend: 'finished', transitioncancel: 'idle'
+      };
+      document.body.dataset.lastAnimationState = animation
+        ? animation.playState
+        : fallbackStates[event.type];
+    }
+
+    for (const type of ['animationstart', 'animationiteration', 'animationend', 'animationcancel',
+      'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel']) {
+      document.addEventListener(type, recordAnimationState);
+    }
+
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const banner = document.querySelector('.roast-banner');
+    const roastTrack = document.querySelector('.roast-track');
+    const pauseButton = document.querySelector('.roast-toggle');
+    let userPaused = false;
+
+    function syncBanner() {
+      const paused = userPaused || motionPreference.matches;
+      banner.dataset.paused = String(paused);
+      pauseButton.setAttribute('aria-pressed', String(paused));
+      pauseButton.disabled = motionPreference.matches;
+      pauseButton.textContent = motionPreference.matches ? 'Motion off' : userPaused ? 'Resume' : 'Pause';
+      pauseButton.title = motionPreference.matches ? 'Animation is off to respect your reduced-motion preference' : '';
+      // CSS play-state changes do not dispatch animation lifecycle events.
+      const animation = roastTrack.getAnimations()[0];
+      document.body.dataset.lastAnimationState = animation?.playState || (paused ? 'paused' : 'idle');
+    }
+    pauseButton.addEventListener('click', () => {
+      userPaused = !userPaused;
+      syncBanner();
+    });
+    motionPreference.addEventListener('change', syncBanner);
+    syncBanner();
+
+    const drinks = {
+      maple: {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk meets espresso and a hint of Vermont maple syrup. A cozy, gently sweet companion for slow mornings.',
+        notes: 'Tasting notes: maple sweetness, toasted oats, and rich espresso. Made with oat milk.',
+        url: '/menu/seasonal'
+      },
+      espresso: {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smoky, and perfect for a morning boost. Our dark roast brings a full-bodied espresso experience to every sip.',
+        notes: 'Tasting notes: deep roast, smoky richness, and a lingering finish.',
+        url: '/menu/espresso'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness. Served cold for an easygoing, refreshing coffee ritual.',
+        notes: 'Brew method: slow-steeped for 18 hours. Smooth, refreshing, and served over ice.',
+        url: '/menu/cold-brew'
+      }
+    };
+    const dialog = document.querySelector('#drink-details');
+
+    document.querySelectorAll('[data-drink]').forEach(button => {
+      button.addEventListener('click', () => {
+        const drink = drinks[button.dataset.drink];
+        document.querySelector('#drink-title').textContent = drink.name;
+        document.querySelector('#drink-description').textContent = drink.description;
+        document.querySelector('#drink-notes').textContent = drink.notes;
+        document.querySelector('#drink-menu-link').href = drink.url;
+        dialog.showModal();
+      });
+    });
+
+    async function closeDetails() {
+      if (!dialog.open || dialog.hasAttribute('data-closing')) return;
+      // Keep the modal in the top layer through its exit, including browsers
+      // that parse allow-discrete but cannot transition display or overlay.
+      dialog.setAttribute('data-closing', '');
+      const animations = dialog.getAnimations({ subtree: true });
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      dialog.close();
+      dialog.removeAttribute('data-closing');
+    }
+    dialog.querySelector('.dialog-close').addEventListener('click', closeDetails);
+    dialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeDetails();
+    });
+    // Only dismiss when both press and release are outside the panel.
+    function outsideDialog(event) {
+      const bounds = dialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    }
+    let pressedOutside = false;
+    dialog.addEventListener('pointerdown', event => { pressedOutside = outsideDialog(event); });
+    dialog.addEventListener('pointerup', event => {
+      if (pressedOutside && outsideDialog(event)) closeDetails();
+      pressedOutside = false;
+    });
+    dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+  </script>
