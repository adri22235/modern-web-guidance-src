+  <script>
+    (() => {
+      const section = document.querySelector('.coffee-story');
+      // Progressive enhancement: unsupported browsers keep the static design.
+      if (!('IntersectionObserver' in window) || !window.matchMedia) return;
+
+      const layers = [...section.querySelectorAll('[data-speed]')];
+      const toggle = section.querySelector('.motion-toggle');
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let visible = false;
+      let paused = false;
+      let listening = false;
+      let frame = 0;
+
+      function render() {
+        frame = 0;
+        // One layout read per frame; only compositor-friendly transforms change.
+        const bounds = section.getBoundingClientRect();
+        const distance = window.innerHeight / 2 - (bounds.top + bounds.height / 2);
+        for (const layer of layers) {
+          const offset = Math.max(-72, Math.min(72, distance * Number(layer.dataset.speed)));
+          layer.style.setProperty('--offset', `${offset.toFixed(2)}px`);
+        }
+      }
+
+      function schedule() {
+        if (!frame) frame = requestAnimationFrame(render);
+      }
+
+      function sync() {
+        const active = visible && !paused && !reducedMotion.matches && !document.hidden;
+        toggle.hidden = reducedMotion.matches;
+        section.classList.toggle('is-moving', active);
+        if (active && !listening) {
+          window.addEventListener('scroll', schedule, { passive: true });
+          window.addEventListener('resize', schedule, { passive: true });
+          listening = true;
+          schedule();
+        } else if (!active) {
+          window.removeEventListener('scroll', schedule);
+          window.removeEventListener('resize', schedule);
+          listening = false;
+          cancelAnimationFrame(frame);
+          frame = 0;
+          if (reducedMotion.matches) {
+            for (const layer of layers) layer.style.removeProperty('--offset');
+          }
+        }
+      }
+
+      const observer = new IntersectionObserver(([entry]) => {
+        visible = entry.isIntersecting;
+        sync();
+      });
+      observer.observe(section);
+      toggle.addEventListener('click', () => {
+        paused = !paused;
+        toggle.setAttribute('aria-pressed', String(paused));
+        toggle.textContent = paused ? 'Resume scroll effect' : 'Pause scroll effect';
+        sync();
+      });
+      reducedMotion.addEventListener('change', sync);
+      document.addEventListener('visibilitychange', sync);
+      sync();
+    })();
+  </script>
