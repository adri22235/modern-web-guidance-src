+    /* Decorative depth; content remains stationary and readable. */
+    .coffee-parallax {
+      position: relative;
+      isolation: isolate;
+      overflow: clip;
+      display: grid;
+      place-items: center;
+      min-height: 480px;
+      padding: 80px 24px;
+      background: #241812;
+      color: white;
+      text-align: center;
+    }
+
+    .coffee-parallax__photo {
+      position: absolute;
+      z-index: -3;
+      inset: -40px 0;
+      width: 100%;
+      height: calc(100% + 80px);
+      object-fit: cover;
+      opacity: 0.35;
+      --travel: 36px;
+    }
+
+    .coffee-parallax__rings {
+      position: absolute;
+      z-index: -2;
+      top: calc(50% - 180px);
+      left: -160px;
+      width: 360px;
+      height: 360px;
+      border: 1px solid rgb(255 171 64 / 45%);
+      border-radius: 50%;
+      box-shadow: 0 0 0 45px rgb(255 171 64 / 8%),
+        0 0 0 90px rgb(255 171 64 / 5%);
+      --travel: 64px;
+    }
+
+    .coffee-parallax__beans {
+      position: absolute;
+      z-index: -1;
+      inset: 0;
+      pointer-events: none;
+      --travel: 96px;
+    }
+
+    .coffee-parallax__bean {
+      position: absolute;
+      width: 52px;
+      height: 76px;
+      border-radius: 50%;
+      background: linear-gradient(110deg, #a87b53 0%, #5b3524 47%,
+        #2c1b14 48%, #2c1b14 53%, #805337 54%, #42271b 100%);
+      box-shadow: 6px 12px 18px rgb(0 0 0 / 25%);
+      transform: rotate(-30deg);
+    }
+
+    .coffee-parallax__bean:nth-child(1) { top: 18%; right: 10%; }
+    .coffee-parallax__bean:nth-child(2) {
+      bottom: 16%; right: 17%;
+      transform: rotate(35deg) scale(0.7);
+    }
+    .coffee-parallax__bean:nth-child(3) {
+      bottom: 12%; left: 10%;
+      transform: rotate(-65deg) scale(0.85);
+    }
+
+    .coffee-parallax__content {
+      max-width: 560px;
+      padding: 28px;
+      border-radius: 8px;
+      background: rgb(36 24 18 / 88%);
+    }
+
+    .coffee-parallax__eyebrow {
+      color: #ffcb85;
+      font-size: 0.8rem;
+      font-weight: 700;
+      letter-spacing: 0.18em;
+      text-transform: uppercase;
+    }
+
+    .coffee-parallax h2 {
+      margin: 12px 0;
+      font-size: clamp(1.8rem, 4vw, 2.8rem);
+      line-height: 1.2;
+    }
+
+    /* Progressive enhancement: unsupported browsers keep the static scene.
+       Check range support too; partial timeline support is insufficient. */
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .coffee-parallax {
+          view-timeline: --coffee-scene block;
+        }
+
+        .coffee-parallax__layer {
+          animation: coffee-depth linear both;
+          animation-timeline: --coffee-scene;
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
+    @keyframes coffee-depth {
+      from { transform: translateY(calc(0px - var(--travel))); }
+      to { transform: translateY(var(--travel)); }
+    }
+
+    @media (max-width: 600px) {
+      .coffee-parallax { min-height: 420px; padding: 64px 20px; }
+      .coffee-parallax__photo { --travel: 18px; }
+      .coffee-parallax__rings { --travel: 32px; }
+      .coffee-parallax__beans { --travel: 48px; }
+      .coffee-parallax__content { padding: 24px 18px; }
+    }
+
