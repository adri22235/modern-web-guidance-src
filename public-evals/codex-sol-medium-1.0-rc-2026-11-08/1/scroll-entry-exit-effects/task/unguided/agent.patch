diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,36 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Keep cards full size unless scroll animations and motion are supported. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) and (animation-range: cover) {
+        @keyframes card-reveal {
+          entry 0%, exit 100% {
+            transform: scale(0.5);
+          }
+
+          entry 100%, exit 0% {
+            transform: scale(1);
+          }
+        }
+
+        .grid .card {
+          animation: card-reveal 1ms linear both;
+          /* Set after the shorthand, which resets the timeline. */
+          animation-timeline: view(block);
+          animation-range: cover;
+        }
+
+        /* Keep keyboard-focused content at a readable, usable size. */
+        .grid .card:focus-within {
+          animation: none;
+          transform: none;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
