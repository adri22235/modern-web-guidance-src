diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,38 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Keep cards full size unless motion is welcome and supported. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports ((animation-timeline: view()) and (animation-range: entry)) {
+        @keyframes card-grow {
+          from { transform: scale(0.5); }
+          to { transform: scale(1); }
+        }
+
+        @keyframes card-shrink {
+          from { transform: scale(1); }
+          to { transform: scale(0.5); }
+        }
+
+        .grid > .card {
+          animation:
+            card-grow auto linear backwards,
+            card-shrink auto linear forwards;
+          /* Set these after the shorthand, which resets timelines. */
+          animation-timeline: view();
+          animation-range: entry, exit;
+        }
+
+        /* Keep focused links and their card at full size for keyboard users. */
+        .grid > .card:focus-within {
+          animation: none;
+          transform: none;
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
