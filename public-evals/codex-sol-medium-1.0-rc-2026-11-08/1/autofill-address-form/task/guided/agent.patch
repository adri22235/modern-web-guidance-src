+  <script>
+    const shippingForm = document.getElementById('shipping-address-form');
+    const deliveryReview = document.getElementById('delivery-review');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      const address = ['name', 'street-address', 'city', 'region', 'postal-code', 'country']
+        .map((field) => details.get(field).trim())
+        .filter(Boolean);
+      const contact = ['email', 'phone']
+        .map((field) => details.get(field).trim())
+        .filter(Boolean);
+
+      deliveryReview.textContent = ['Please review your delivery details:', ...address, ...contact,
+        'No details have been saved and no order has been placed.'].join('\n');
+    });
+
+    shippingForm.addEventListener('input', () => {
+      deliveryReview.textContent = '';
+    });
+    shippingForm.addEventListener('change', () => {
+      deliveryReview.textContent = '';
+    });
+  </script>
+
