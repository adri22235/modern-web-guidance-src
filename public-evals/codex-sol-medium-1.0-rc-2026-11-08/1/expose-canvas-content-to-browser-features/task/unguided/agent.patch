+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const context = canvas.getContext('2d');
+      const form = stage.querySelector('form');
+      const name = document.getElementById('cup-name');
+      const milk = document.getElementById('cup-milk');
+      const syrup = document.getElementById('cup-syrup');
+      const summary = document.getElementById('cup-summary');
+      const milkColors = { oat: '#c49a70', whole: '#d7b797', almond: '#bb8c61', soy: '#c9a782', none: '#593426' };
+      const syrupColors = { vanilla: '#f5dfb0', maple: '#a7632e', caramel: '#c78332', hazelnut: '#835131' };
+
+      function draw() {
+        if (!context) return;
+        const { width, height } = stage.getBoundingClientRect();
+        if (!width || !height) return;
+        const dpr = window.devicePixelRatio || 1;
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        // All artwork uses the same proportional coordinates as the HTML overlay.
+        context.setTransform(canvas.width / 600, 0, 0, canvas.height / 600, 0, 0);
+        context.clearRect(0, 0, 600, 600);
+
+        context.fillStyle = '#e6d7c5';
+        context.beginPath();
+        context.ellipse(300, 550, 237, 25, 0, 0, Math.PI * 2);
+        context.fill();
+
+        // Ceramic handle, behind the body.
+        context.strokeStyle = '#d9c3ac';
+        context.lineWidth = 30;
+        context.beginPath();
+        context.ellipse(461, 320, 72, 92, 0, 0, Math.PI * 2);
+        context.stroke();
+        context.strokeStyle = '#fff8ed';
+        context.lineWidth = 19;
+        context.stroke();
+
+        const ceramic = context.createLinearGradient(98, 0, 464, 0);
+        ceramic.addColorStop(0, '#e9d5bd');
+        ceramic.addColorStop(0.22, '#fff8eb');
+        ceramic.addColorStop(0.75, '#fff3df');
+        ceramic.addColorStop(1, '#dec5a7');
+        context.fillStyle = ceramic;
+        context.beginPath();
+        context.moveTo(98, 143);
+        context.lineTo(124, 489);
+        context.quadraticCurveTo(128, 547, 280, 547);
+        context.quadraticCurveTo(432, 547, 436, 489);
+        context.lineTo(464, 143);
+        context.closePath();
+        context.fill();
+        context.strokeStyle = '#d8bea0';
+        context.lineWidth = 2;
+        context.stroke();
+
+        context.fillStyle = '#fff8eb';
+        context.beginPath();
+        context.ellipse(281, 143, 183, 52, 0, 0, Math.PI * 2);
+        context.fill();
+        context.fillStyle = milkColors[milk.value];
+        context.beginPath();
+        context.ellipse(281, 143, 165, 38, 0, 0, Math.PI * 2);
+        context.fill();
+
+        if (syrup.value !== 'none') {
+          context.save();
+          context.clip();
+          context.strokeStyle = syrupColors[syrup.value];
+          context.lineWidth = 5;
+          context.lineCap = 'round';
+          context.beginPath();
+          for (let i = 0; i < 4; i++) {
+            const x = 210 + i * 36;
+            context.moveTo(x, 117);
+            context.bezierCurveTo(x - 35, 137, x + 35, 149, x, 169);
+          }
+          context.stroke();
+          context.restore();
+        }
+      }
+
+      function update() {
+        const owner = name.value.trim();
+        const drink = milk.value === 'none' ? 'black coffee' : `${milk.value} latte`;
+        summary.textContent = `${owner ? `${owner}’s` : 'Your'} ${drink} · ${syrup.value === 'none' ? 'unsweetened' : syrup.value}`;
+        draw();
+      }
+
+      form.addEventListener('submit', event => event.preventDefault());
+      form.addEventListener('input', update);
+      form.addEventListener('change', update);
+      new ResizeObserver(draw).observe(stage);
+      // Re-arm the query when moving between displays with different pixel ratios.
+      function watchPixelRatio() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        query.addEventListener('change', () => {
+          draw();
+          watchPixelRatio();
+        }, { once: true });
+      }
+      watchPixelRatio();
+      update();
+    })();
+  </script>
