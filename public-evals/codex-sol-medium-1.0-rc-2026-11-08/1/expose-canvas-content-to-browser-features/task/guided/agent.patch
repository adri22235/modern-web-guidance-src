+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = canvas.parentElement;
+      const controls = document.getElementById('cup-controls');
+      const cupName = document.getElementById('cup-name');
+      const milk = document.getElementById('cup-milk');
+      const syrup = document.getElementById('cup-syrup');
+      const summary = document.getElementById('cup-summary');
+      const ctx = canvas.getContext('2d');
+      const nativeCanvas = ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+
+      if (nativeCanvas) {
+        // One live DOM subtree supplies both the pixels and native hit testing.
+        canvas.removeAttribute('aria-hidden');
+        canvas.append(controls);
+        stage.classList.add('native-canvas');
+      }
+
+      const milkColors = {
+        oat: '#bc9470', whole: '#d7b797', almond: '#c4a17d',
+        soy: '#cfad88', none: '#533026'
+      };
+      const syrupColors = {
+        maple: '#a96024', vanilla: '#e7ce9e', caramel: '#c77d2f',
+        hazelnut: '#885332'
+      };
+
+      function draw() {
+        if (!ctx) return;
+        const width = canvas.clientWidth;
+        const height = canvas.clientHeight;
+        if (!width || !height) return;
+        // Draw in CSS pixels; the backing store independently tracks device pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        ctx.clearRect(0, 0, width, height);
+
+        ctx.fillStyle = '#dfd0c1';
+        ctx.beginPath();
+        ctx.ellipse(width * 0.48, 598, width * 0.43, 14, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Handle, cup body, and the coffee surface share the control layout's coordinates.
+        ctx.strokeStyle = '#b49b85';
+        ctx.lineWidth = 13;
+        ctx.beginPath();
+        ctx.ellipse(width * 0.85, 264, width * 0.12, 88, 0, 0, Math.PI * 2);
+        ctx.stroke();
+        const ceramic = ctx.createLinearGradient(0, 0, width, 0);
+        ceramic.addColorStop(0, '#e9d6be');
+        ceramic.addColorStop(0.45, '#fff8ed');
+        ceramic.addColorStop(1, '#dfc7aa');
+        ctx.fillStyle = ceramic;
+        ctx.strokeStyle = '#b49b85';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(width * 0.04, 122);
+        ctx.lineTo(width * 0.10, 556);
+        ctx.quadraticCurveTo(width * 0.47, 614, width * 0.84, 556);
+        ctx.lineTo(width * 0.90, 122);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        ctx.fillStyle = milkColors[milk.value];
+        ctx.lineWidth = 8;
+        ctx.strokeStyle = '#fff8ed';
+        ctx.beginPath();
+        ctx.ellipse(width * 0.47, 122, width * 0.43, 25, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.stroke();
+
+        if (syrup.value !== 'none') {
+          ctx.strokeStyle = syrupColors[syrup.value];
+          ctx.lineWidth = 3;
+          ctx.beginPath();
+          ctx.ellipse(width * 0.47, 122, width * 0.22, 11, 0, 0, Math.PI * 1.8);
+          ctx.stroke();
+        }
+
+        ctx.strokeStyle = '#b49b85';
+        ctx.lineWidth = 2;
+        ctx.lineCap = 'round';
+        for (const x of [0.36, 0.47, 0.58]) {
+          ctx.beginPath();
+          ctx.moveTo(width * x, 77);
+          ctx.bezierCurveTo(width * x - 16, 60, width * x + 16, 49, width * x, 32);
+          ctx.stroke();
+        }
+
+        if (nativeCanvas) ctx.drawElementImage(controls, width * 0.14, 166);
+      }
+
+      function requestDraw() {
+        if (nativeCanvas) canvas.requestPaint();
+        else draw();
+      }
+
+      function updateOrder() {
+        const name = cupName.value.trim();
+        summary.textContent = `${name ? name + "'s" : 'Your'} latte · ${milk.selectedOptions[0].text} · ${syrup.selectedOptions[0].text}`;
+        requestDraw();
+      }
+
+      if (nativeCanvas) canvas.onpaint = draw;
+      controls.addEventListener('input', updateOrder);
+      controls.addEventListener('change', updateOrder);
+      controls.addEventListener('focusin', requestDraw);
+      controls.addEventListener('focusout', requestDraw);
+      controls.addEventListener('submit', event => event.preventDefault());
+      // Reset fires before the browser restores the default control values.
+      controls.addEventListener('reset', () => requestAnimationFrame(updateOrder));
+
+      function resize(entry) {
+        const width = canvas.clientWidth;
+        const height = canvas.clientHeight;
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        canvas.width = Math.max(1, pixels?.inlineSize ?? Math.round(width * window.devicePixelRatio));
+        canvas.height = Math.max(1, pixels?.blockSize ?? Math.round(height * window.devicePixelRatio));
+        if (nativeCanvas) controls.style.width = `${width * 0.66}px`;
+        requestDraw();
+      }
+
+      if ('ResizeObserver' in window) {
+        const observer = new ResizeObserver(entries => resize(entries[0]));
+        const supportsDevicePixels = 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, supportsDevicePixels ? { box: 'device-pixel-content-box' } : {});
+      }
+      window.addEventListener('resize', () => resize());
+
+      // Also resize when zoom or a change of display alters DPR without changing CSS size.
+      function watchResolution() {
+        const query = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
+        query.addEventListener('change', () => {
+          resize();
+          watchResolution();
+        }, { once: true });
+      }
+      watchResolution();
+      resize();
+    })();
+  </script>
+
