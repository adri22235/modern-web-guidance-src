diff --git a/src/lib/browser-tools.ts b/src/lib/browser-tools.ts
new file mode 100644
index 0000000..f581603
--- /dev/null
+++ b/src/lib/browser-tools.ts
@@ -0,0 +1,146 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export async function requestJson(path: string, init?: RequestInit) {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/${path}`, init);
+  if (!response.ok) {
+    throw new Error(`Request failed: ${response.status} ${response.statusText}`);
+  }
+  return response.json();
+}
+
+export const getArticles = (): Promise<Article[]> => requestJson('articles.json');
+export const getReadingList = (): Promise<{ readingList: string[] }> => requestJson('reading-list.json');
+export async function toggleReadingList(slug: string) {
+  const data: { readingList: string[] } = await requestJson('reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }),
+  });
+  window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: data.readingList }));
+  return data;
+}
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+// Read native form values: agent-filled inputs need not fire React's onChange.
+export function respondToAgent(event: Event, result: Promise<unknown>) {
+  const submission = event as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<unknown>) => void;
+  };
+  if (submission.agentInvoked && submission.respondWith) submission.respondWith(result);
+}
+
+interface BrowserTool {
+  name: string;
+  description: string;
+  inputSchema: object;
+  annotations?: { readOnlyHint: boolean };
+  execute: (input: Record<string, unknown>) => Promise<unknown>;
+}
+interface ModelContext {
+  registerTool: (tool: BrowserTool) => void | Promise<void>;
+}
+
+export async function registerBrowserTools() {
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context?.registerTool) return;
+
+  const stringInput = (name: string, description: string) => ({
+    type: 'object', properties: { [name]: { type: 'string', minLength: 1, description } },
+    required: [name], additionalProperties: false,
+  });
+  const requiredString = (input: Record<string, unknown>, name: string) => {
+    const value = input[name];
+    if (typeof value !== 'string' || !value.trim()) throw new Error(`${name} is required`);
+    return value.trim();
+  };
+  const emptyInput = { type: 'object', properties: {}, additionalProperties: false };
+  const tools: BrowserTool[] = [
+    {
+      name: 'search_articles',
+      description: 'Search The DevTools Times article titles and summaries. Opens search and returns matching articles.',
+      inputSchema: stringInput('query', 'Words to find in article titles or summaries'),
+      annotations: { readOnlyHint: true },
+      execute: async input => {
+        const query = requiredString(input, 'query');
+        const articles = await getArticles();
+        window.dispatchEvent(new CustomEvent('open-article-search', { detail: { query, articles } }));
+        return { articles: searchArticles(articles, query) };
+      },
+    },
+    {
+      name: 'get_reading_list',
+      description: 'Get the current session reading list and open its form.',
+      inputSchema: emptyInput,
+      annotations: { readOnlyHint: true },
+      execute: async () => {
+        const [articles, data] = await Promise.all([getArticles(), getReadingList()]);
+        window.dispatchEvent(new CustomEvent('open-reading-list'));
+        return { articles: articles.filter(article => data.readingList.includes(article.slug)) };
+      },
+    },
+    {
+      name: 'toggle_reading_list',
+      description: 'Toggle an article in the session reading list: removes it if saved, otherwise adds it. Returns saved slugs.',
+      inputSchema: stringInput('slug', 'Article slug from search results'),
+      annotations: { readOnlyHint: false },
+      execute: async input => {
+        const slug = requiredString(input, 'slug');
+        if (!(await getArticles()).some(article => article.slug === slug)) throw new Error('Unknown article slug');
+        return toggleReadingList(slug);
+      },
+    },
+    {
+      name: 'get_current_article',
+      description: 'Read the title and visible body of the article on the current page. Fails on pages without an article.',
+      inputSchema: emptyInput,
+      annotations: { readOnlyHint: true },
+      execute: async () => {
+        const article = document.querySelector('main article');
+        const body = article?.querySelector<HTMLElement>('.prose');
+        if (!body) throw new Error('The current page is not an article');
+        return { title: article?.querySelector('h1')?.textContent?.trim(), text: body.innerText, url: location.href };
+      },
+    },
+    ...[
+      ['get_coffee_brew', 'coffee-brew', 'Request the coffee article brewing stats. The demo endpoint may return a server error.'],
+      ['get_plant_stats', 'plant-stats', 'Request the plant article stats. The demo endpoint may reject oversized cookie headers.'],
+      ['get_tide_levels', 'tide-levels', 'Request the coastal article tide levels. The demo endpoint may redirect to an unavailable endpoint.'],
+    ].map(([name, path, description]): BrowserTool => ({
+      name, description, inputSchema: emptyInput, annotations: { readOnlyHint: true },
+      execute: async () => requestJson(path),
+    })),
+    {
+      name: 'get_article_popularity',
+      description: 'Request popularity stats for an article ID.',
+      inputSchema: stringInput('id', 'Article ID or slug'),
+      annotations: { readOnlyHint: true },
+      execute: async input => requestJson(`article-popularity?id=${encodeURIComponent(requiredString(input, 'id'))}`),
+    },
+  ];
+  for (const tool of tools) {
+    try {
+      await context.registerTool({
+        ...tool,
+        execute: async input => {
+          try { return await tool.execute(input); }
+          catch (error) { return { isError: true, error: error instanceof Error ? error.message : String(error) }; }
+        },
+      });
+    } catch (error) {
+      console.warn(`Unable to register browser tool ${tool.name}`, error);
+    }
+  }
+}
