+  }
+}
diff --git a/tests/browser-tools.test.mjs b/tests/browser-tools.test.mjs
new file mode 100644
index 0000000..b55beca
--- /dev/null
+++ b/tests/browser-tools.test.mjs
@@ -0,0 +1,100 @@
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+
+// Load only the client module; no Astro server entrypoint or live server.
+const source = (await readFile(new URL('../src/lib/browser-tools.ts', import.meta.url), 'utf8'))
+  .replaceAll('import.meta.env.BASE_URL', JSON.stringify('/devtools-times/'));
+const api = await import(`data:text/javascript;base64,${Buffer.from(stripTypeScriptTypes(source)).toString('base64')}`);
+const articles = [{ slug: 'coffee', title: 'Coffee Alchemy', summary: 'Roast science' }];
+let registered;
+let requests;
+beforeEach(() => {
+  registered = new Map();
+  requests = [];
+  globalThis.document = { modelContext: { registerTool(tool) { registered.set(tool.name, tool); } }, querySelector: () => null };
+  globalThis.window = new EventTarget();
+  globalThis.fetch = async (url, init) => {
+    requests.push({ url, init });
+    return Response.json(url.endsWith('articles.json') ? articles : { readingList: ['coffee'] });
+  };
+});
+
+test('unsupported browsers skip registration', async () => {
+  globalThis.document = {};
+  await api.registerBrowserTools();
+  assert.equal(registered.size, 0);
+});
+
+test('registers all utilities with schemas and callable implementations', async () => {
+  await api.registerBrowserTools();
+  assert.deepEqual([...registered.keys()], [
+    'search_articles', 'get_reading_list', 'toggle_reading_list', 'get_current_article',
+    'get_coffee_brew', 'get_plant_stats', 'get_tide_levels', 'get_article_popularity',
+  ]);
+  for (const tool of registered.values()) {
+    assert.equal(tool.inputSchema.type, 'object');
+    assert.ok(tool.description);
+  }
+});
+
+test('search is case-insensitive, trims input, and opens the flyout', async () => {
+  await api.registerBrowserTools();
+  let opened;
+  window.addEventListener('open-article-search', event => { opened = event.detail; });
+  const result = await registered.get('search_articles').execute({ query: ' SCIENCE ' });
+  assert.deepEqual(result.articles, articles);
+  assert.equal(opened.query, 'SCIENCE');
+  assert.equal(requests[0].url, '/devtools-times/api/articles.json');
+  assert.deepEqual(api.searchArticles(articles, '  '), []);
+  assert.deepEqual(api.searchArticles(articles, 'missing'), []);
+});
+
+test('reading list uses session endpoint and broadcasts updates to bookmarks', async () => {
+  await api.registerBrowserTools();
+  const list = await registered.get('get_reading_list').execute({});
+  assert.deepEqual(list.articles, articles);
+  let updated;
+  window.addEventListener('reading-list-updated', event => { updated = event.detail; });
+  await registered.get('toggle_reading_list').execute({ slug: 'coffee' });
+  assert.deepEqual(updated, ['coffee']);
+  const post = requests.find(request => request.init?.method === 'POST');
+  assert.equal(post.url, '/devtools-times/api/reading-list.json');
+  assert.deepEqual(JSON.parse(post.init.body), { slug: 'coffee' });
+});
+
+test('rejects invalid inputs and unknown slugs without mutating the list', async () => {
+  await api.registerBrowserTools();
+  assert.equal((await registered.get('search_articles').execute({ query: '' })).isError, true);
+  assert.equal((await registered.get('toggle_reading_list').execute({ slug: 'unknown' })).isError, true);
+  assert.ok(requests.every(request => !request.init?.method));
+});
+
+test('reports article widget HTTP failures and encodes popularity IDs', async () => {
+  await api.registerBrowserTools();
+  await registered.get('get_article_popularity').execute({ id: 'coffee & tea' });
+  assert.equal(requests[0].url, '/devtools-times/api/article-popularity?id=coffee%20%26%20tea');
+  globalThis.fetch = async () => new Response(null, { status: 500, statusText: 'Internal Server Error' });
+  const result = await registered.get('get_coffee_brew').execute({});
+  assert.equal(result.isError, true);
+  assert.match(result.error, /500/);
+});
+
+test('current article reads the current DOM on every call', async () => {
+  await api.registerBrowserTools();
+  const tool = registered.get('get_current_article');
+  assert.equal((await tool.execute({})).isError, true);
+  globalThis.location = { href: 'https://example.test/devtools-times/articles/coffee' };
+  document.querySelector = () => ({ querySelector: selector => selector === 'h1' ? { textContent: ' Coffee ' } : { innerText: 'Article text' } });
+  assert.deepEqual(await tool.execute({}), { title: 'Coffee', text: 'Article text', url: location.href });
+  document.querySelector = () => null;
+  assert.equal((await tool.execute({})).isError, true);
+});
+
+test('declarative submissions return a result only for agent invocations', async () => {
+  let result;
+  api.respondToAgent({ agentInvoked: true, respondWith: value => { result = value; } }, Promise.resolve({ articles }));
+  assert.deepEqual(await result, { articles });
+  api.respondToAgent({}, Promise.resolve({}));
+});
