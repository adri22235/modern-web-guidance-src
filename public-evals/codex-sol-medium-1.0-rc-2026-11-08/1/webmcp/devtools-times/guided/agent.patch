diff --git a/src/components/BrowserTools.tsx b/src/components/BrowserTools.tsx
new file mode 100644
index 0000000..0789a2d
--- /dev/null
+++ b/src/components/BrowserTools.tsx
@@ -0,0 +1,74 @@
+import { useWebMCP } from 'use-webmcp-tool';
+import { flushSync } from 'react-dom';
+import { articleUrl, getReadingList, searchArticles, toggleBookmark, toolResult, type Article } from '../lib/browser-tools';
+
+const utilities = [
+  { slug: 'silent-architects', name: 'get-plant-stats', endpoint: 'plant-stats', description: 'Fetch plant statistics for The Silent Architects of Earth and report request failures.' },
+  { slug: 'coastal-pulse', name: 'get-tide-levels', endpoint: 'tide-levels', description: 'Fetch coastal tide levels and report redirects or request failures.' },
+  { slug: 'coffee-alchemy', name: 'get-coffee-brew', endpoint: 'coffee-brew', description: 'Fetch coffee brewing statistics and report request failures.' },
+  { slug: 'super-bowl-lx', name: 'get-article-popularity', endpoint: 'article-popularity', description: 'Fetch article popularity and trending statistics.' },
+];
+
+function ArticleUtility({ utility }: { utility: typeof utilities[number] }) {
+  useWebMCP<{ id?: string }>({
+    name: utility.name,
+    description: utility.description,
+    inputSchema: utility.endpoint === 'article-popularity' ? {
+      type: 'object', properties: { id: { type: 'string', minLength: 1, description: 'Article identifier whose popularity to retrieve.' } }, required: ['id'],
+    } : { type: 'object', properties: {} },
+    execute: (input, { signal }) => toolResult(async () => {
+      const url = new URL(`${import.meta.env.BASE_URL}api/${utility.endpoint}`, location.origin);
+      if (utility.endpoint === 'article-popularity') {
+        if (typeof input.id !== 'string' || !input.id.trim()) return { error: 'Provide a non-empty article id.' };
+        url.searchParams.set('id', input.id);
+      }
+      const response = await fetch(url, { signal });
+      const text = await response.text();
+      let data: unknown = text;
+      try { data = JSON.parse(text); } catch { /* Redirect targets may return HTML. */ }
+      return {
+        ...(response.ok ? {} : { error: `Request failed (${response.status}).` }),
+        status: response.status, redirected: response.redirected, url: response.url, data,
+      };
+    }, signal),
+    annotations: { readOnlyHint: true },
+  });
+  return null;
+}
+
+export default function BrowserTools({ articles, slug }: { articles: Article[]; slug?: string }) {
+  useWebMCP<{ query: string }>({
+    name: 'search-articles',
+    description: 'Find DevTools Times articles by title or summary and display the search results.',
+    inputSchema: { type: 'object', properties: { query: { type: 'string', minLength: 1, description: 'Words to find in article titles or summaries.' } }, required: ['query'] },
+    execute({ query }) {
+      if (typeof query !== 'string' || !query.trim()) return { error: 'Provide a non-empty search query.' };
+      const results = searchArticles(articles, query);
+      flushSync(() => window.dispatchEvent(new CustomEvent('search-articles', { detail: query })));
+      return { articles: results, count: results.length };
+    },
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP({
+    name: 'get-reading-list',
+    description: 'Retrieve articles saved in the current session reading list.',
+    inputSchema: { type: 'object', properties: {} },
+    execute: (_, { signal }) => toolResult(async () => {
+      const slugs = await getReadingList(signal);
+      return { articles: articles.filter(article => slugs.includes(article.slug)).map(article => ({ ...article, url: articleUrl(article.slug) })) };
+    }, signal),
+    annotations: { readOnlyHint: true },
+  });
+  useWebMCP<{ slug: string }>({
+    name: 'toggle-article-bookmark',
+    description: 'Toggle whether an article is saved in the current session reading list. Returns its resulting saved state.',
+    inputSchema: { type: 'object', properties: { slug: { type: 'string', enum: articles.map(article => article.slug), description: 'Article identifier returned by article search.' } }, required: ['slug'] },
+    execute: (input, { signal }) => toolResult(async () => {
+      if (!articles.some(article => article.slug === input.slug)) return { error: 'Unknown article slug. Use search-articles to find an article.' };
+      const readingList = await toggleBookmark(input.slug, signal);
+      return { readingList, saved: readingList.includes(input.slug) };
+    }, signal),
+    annotations: { readOnlyHint: false },
+  });
+  return <>{utilities.filter(utility => utility.slug === slug).map(utility => <ArticleUtility key={utility.name} utility={utility} />)}</>;
+}
