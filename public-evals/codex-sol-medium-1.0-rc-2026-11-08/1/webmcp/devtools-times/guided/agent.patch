diff --git a/src/lib/browser-tools.ts b/src/lib/browser-tools.ts
new file mode 100644
index 0000000..fca4475
--- /dev/null
+++ b/src/lib/browser-tools.ts
@@ -0,0 +1,66 @@
+import type { FormEvent } from 'react';
+import { flushSync } from 'react-dom';
+
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const articleUrl = (slug: string) => `${import.meta.env.BASE_URL}articles/${encodeURIComponent(slug)}`;
+
+export function searchArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ).map(article => ({ ...article, url: articleUrl(article.slug) })) : [];
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, { signal });
+  if (!response.ok) throw new Error(`Reading list request failed (${response.status}).`);
+  const data = await response.json();
+  if (!Array.isArray(data.readingList) || !data.readingList.every((slug: unknown) => typeof slug === 'string')) {
+    throw new Error('The reading list response was invalid.');
+  }
+  return data.readingList;
+}
+
+export async function toggleBookmark(slug: string, signal?: AbortSignal): Promise<string[]> {
+  const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug }), signal,
+  });
+  if (!response.ok) throw new Error(`Bookmark request failed (${response.status}).`);
+  const { readingList } = await response.json();
+  if (!Array.isArray(readingList) || !readingList.every((item: unknown) => typeof item === 'string')) {
+    throw new Error('The bookmark response was invalid.');
+  }
+  signal?.throwIfAborted();
+  flushSync(() => window.dispatchEvent(new CustomEvent('reading-list-changed', { detail: readingList })));
+  return readingList;
+}
+
+// React wraps the native SubmitEvent, where WebMCP provides its response channel.
+export function respondToAgent(event: FormEvent<HTMLFormElement>, result: Promise<unknown>) {
+  const native = event.nativeEvent as SubmitEvent & {
+    agentInvoked?: boolean;
+    respondWith?: (response: Promise<string>) => void;
+  };
+  if (native.agentInvoked && native.respondWith) {
+    native.respondWith(result.then(value => JSON.stringify(value), error => JSON.stringify({
+      error: error instanceof Error ? error.message : String(error),
+    })));
+  }
+}
+
+export async function toolResult(run: () => unknown | Promise<unknown>, signal: AbortSignal) {
+  try {
+    signal.throwIfAborted();
+    return await run();
+  } catch (error) {
+    if (signal.aborted) throw error;
+    return { error: error instanceof Error ? error.message : String(error) };
+  }
+}
