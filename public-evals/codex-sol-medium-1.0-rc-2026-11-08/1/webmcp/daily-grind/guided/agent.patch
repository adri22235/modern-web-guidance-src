+  <script>
+    (() => {
+      const menu = new Map([
+        ['maple-oat-latte', 'Maple Oat Latte'],
+        ['dark-roast-espresso', 'Dark Roast Espresso'],
+        ['cold-brew', 'Cold Brew'],
+      ]);
+      const order = new Map();
+      const itemsList = document.getElementById('order-items');
+      const clearButton = document.getElementById('clear-order');
+      const status = document.getElementById('order-status');
+
+      function getOrder() {
+        const items = Array.from(order, ([coffee, quantity]) => ({
+          coffee, name: menu.get(coffee), quantity,
+        }));
+        return {
+          status: 'draft',
+          items,
+          totalQuantity: items.reduce((total, item) => total + item.quantity, 0),
+        };
+      }
+
+      function renderOrder(message) {
+        const snapshot = getOrder();
+        itemsList.replaceChildren();
+        for (const item of snapshot.items) {
+          const row = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${item.name} × ${item.quantity}`;
+          const removeButton = document.createElement('button');
+          removeButton.type = 'button';
+          removeButton.className = 'remove-item';
+          removeButton.textContent = 'Remove';
+          removeButton.setAttribute('aria-label', `Remove ${item.name} from order`);
+          removeButton.addEventListener('click', () => {
+            removeCoffee({ coffee: item.coffee });
+            const focusTarget = clearButton.disabled
+              ? document.querySelector('.order-form button') : clearButton;
+            focusTarget.focus();
+          });
+          row.append(label, removeButton);
+          itemsList.append(row);
+        }
+        document.getElementById('empty-order').hidden = snapshot.items.length > 0;
+        document.getElementById('order-total').textContent = `Total drinks: ${snapshot.totalQuantity}`;
+        clearButton.disabled = snapshot.items.length === 0;
+        status.textContent = message;
+        return { success: true, message, order: snapshot };
+      }
+
+      function invalid(message) {
+        status.textContent = message;
+        return { success: false, error: message, order: getOrder() };
+      }
+
+      // Both the forms and agent tools call these same validated actions.
+      function addCoffee(coffee, input = {}) {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some(key => key !== 'quantity')) {
+          return invalid('Provide an object containing only an optional quantity.');
+        }
+        const { quantity = 1 } = input;
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          return invalid('Choose a whole-number quantity from 1 to 10.');
+        }
+        const nextQuantity = (order.get(coffee) || 0) + quantity;
+        if (nextQuantity > 99) {
+          return invalid(`Your order can contain up to 99 ${menu.get(coffee)} drinks.`);
+        }
+        order.set(coffee, nextQuantity);
+        return renderOrder(`Added ${quantity} × ${menu.get(coffee)} to your order.`);
+      }
+
+      function removeCoffee(input) {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some(key => key !== 'coffee') || !menu.has(input.coffee)) {
+          return invalid('Choose a valid coffee to remove.');
+        }
+        if (!order.has(input.coffee)) {
+          return invalid(`${menu.get(input.coffee)} is not in your order.`);
+        }
+        order.delete(input.coffee);
+        return renderOrder(`Removed ${menu.get(input.coffee)} from your order.`);
+      }
+
+      function clearOrder() {
+        order.clear();
+        return renderOrder('Your order has been cleared.');
+      }
+
+      document.querySelectorAll('.order-form').forEach(form => {
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          if (!form.reportValidity()) return;
+          addCoffee(form.dataset.coffee, { quantity: form.elements.quantity.valueAsNumber });
+        });
+        form.querySelector('button').disabled = false;
+      });
+      clearButton.addEventListener('click', clearOrder);
+
+      const emptySchema = { type: 'object', properties: {}, additionalProperties: false };
+      const tools = [
+        ...Array.from(menu, ([coffee, name]) => ({
+          name: `order_${coffee.replaceAll('-', '_')}`,
+          description: `Add ${name} to the coffee order draft shown on this page. Use when the user wants this drink.`,
+          inputSchema: {
+            type: 'object',
+            properties: {
+              quantity: {
+                type: 'integer', minimum: 1, maximum: 10, default: 1,
+                description: 'Number of drinks to add to the current draft.',
+              },
+            },
+            additionalProperties: false,
+          },
+          execute: input => addCoffee(coffee, input),
+          annotations: { readOnlyHint: false, consequentialHint: false },
+        })),
+        {
+          name: 'get_coffee_order',
+          description: 'Read the current coffee order draft and total drink count.',
+          inputSchema: emptySchema,
+          execute: getOrder,
+          annotations: { readOnlyHint: true },
+        },
+        {
+          name: 'remove_coffee_from_order',
+          description: 'Remove all drinks of the selected coffee from the order draft.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              coffee: {
+                type: 'string', enum: Array.from(menu.keys()),
+                description: 'The coffee to remove from the draft.',
+              },
+            },
+            required: ['coffee'], additionalProperties: false,
+          },
+          execute: removeCoffee,
+          annotations: { readOnlyHint: false, consequentialHint: false },
+        },
+        {
+          name: 'clear_coffee_order',
+          description: 'Remove every drink from the coffee order draft shown on this page.',
+          inputSchema: emptySchema,
+          execute: clearOrder,
+          annotations: { readOnlyHint: false, consequentialHint: false },
+        },
+      ];
+
+      let registrationController;
+      async function registerTools() {
+        // Ordering works normally in browsers without WebMCP support.
+        if (!document.modelContext?.registerTool || registrationController) return;
+        registrationController = new AbortController();
+        const { signal } = registrationController;
+        for (const tool of tools) {
+          if (signal.aborted) return;
+          try {
+            await document.modelContext.registerTool(tool, { signal });
+          } catch (error) {
+            if (!signal.aborted) console.warn(`Could not register ${tool.name}`, error);
+          }
+        }
+      }
+      window.addEventListener('pagehide', () => {
+        registrationController?.abort();
+        registrationController = undefined;
+      });
+      window.addEventListener('pageshow', registerTools);
+      registerTools();
+    })();
+  </script>
 </body>
 
