+  <script>
+    (() => {
+      const coffees = new Map([
+        ['maple_oat_latte', { name: 'Maple Oat Latte', priceCents: 550 }],
+        ['dark_roast_espresso', { name: 'Dark Roast Espresso', priceCents: 300 }],
+        ['cold_brew', { name: 'Cold Brew', priceCents: 450 }]
+      ]);
+      const order = new Map();
+      const money = cents => new Intl.NumberFormat('en-US', {
+        style: 'currency', currency: 'USD'
+      }).format(cents / 100);
+      const status = document.getElementById('order-status');
+      const clearButton = document.getElementById('clear-order');
+
+      function getOrder() {
+        const items = Array.from(order, ([coffee, quantity]) => ({
+          coffee,
+          name: coffees.get(coffee).name,
+          quantity,
+          unitPriceCents: coffees.get(coffee).priceCents,
+          lineTotalCents: coffees.get(coffee).priceCents * quantity
+        }));
+        return {
+          items,
+          subtotalCents: items.reduce((sum, item) => sum + item.lineTotalCents, 0),
+          currency: 'USD',
+          submitted: false
+        };
+      }
+
+      function renderOrder(message) {
+        const snapshot = getOrder();
+        const list = document.getElementById('order-items');
+        list.replaceChildren();
+        for (const item of snapshot.items) {
+          const row = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = `${item.quantity} × ${item.name} — ${money(item.lineTotalCents)}`;
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.className = 'remove-item';
+          remove.textContent = 'Remove';
+          remove.setAttribute('aria-label', `Remove ${item.name} from order`);
+          remove.addEventListener('click', () => {
+            order.delete(item.coffee);
+            renderOrder(`Removed ${item.name}.`);
+            clearButton.focus();
+            if (clearButton.disabled) {
+              document.querySelector('.order-form button').focus();
+            }
+          });
+          row.append(label, remove);
+          list.append(row);
+        }
+        document.getElementById('empty-order').hidden = snapshot.items.length > 0;
+        document.getElementById('order-total').textContent = money(snapshot.subtotalCents);
+        clearButton.disabled = snapshot.items.length === 0;
+        status.textContent = message;
+        return snapshot;
+      }
+
+      // Both the forms and agent tools use this validated ordering action.
+      function orderCoffee(coffee, input = {}) {
+        if (!input || typeof input !== 'object' || Array.isArray(input) ||
+            Object.keys(input).some(key => key !== 'quantity')) {
+          throw new Error('Expected an object containing only an optional quantity.');
+        }
+        const { quantity = 1 } = input;
+        if (!coffees.has(coffee)) throw new Error('Unknown coffee.');
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          throw new Error('Quantity must be a whole number from 1 to 10.');
+        }
+        const nextQuantity = (order.get(coffee) || 0) + quantity;
+        if (nextQuantity > 10) throw new Error('You can order at most 10 of each coffee.');
+        order.set(coffee, nextQuantity);
+        return renderOrder(`Added ${quantity} × ${coffees.get(coffee).name} to your order.`);
+      }
+
+      function clearOrder() {
+        order.clear();
+        return renderOrder('Your order has been cleared.');
+      }
+
+      document.querySelectorAll('.order-form').forEach(form => {
+        form.addEventListener('submit', event => {
+          event.preventDefault();
+          if (!form.reportValidity()) return;
+          try {
+            orderCoffee(form.dataset.coffee, { quantity: Number(form.elements.quantity.value) });
+          } catch (error) {
+            status.textContent = error.message;
+          }
+        });
+        form.querySelector('button').disabled = false;
+      });
+      clearButton.addEventListener('click', () => {
+        clearOrder();
+        document.querySelector('.order-form button').focus();
+      });
+
+      // Use the current WebMCP API, with support for earlier browser previews.
+      // Feature detection keeps manual ordering available without WebMCP.
+      const modelContext = document.modelContext || navigator.modelContext;
+      if (typeof modelContext?.registerTool === 'function') {
+        const toolResult = action => async (input, context) => {
+          context?.signal?.throwIfAborted();
+          try {
+            return { content: [{ type: 'text', text: JSON.stringify(action(input)) }] };
+          } catch (error) {
+            return { isError: true, content: [{ type: 'text', text: error.message }] };
+          }
+        };
+        const tools = Array.from(coffees, ([coffee, details]) => ({
+          name: `order_${coffee}`,
+          description: `Add ${details.name} (${money(details.priceCents)} each) to the on-page sample order. Adds to existing quantity, maximum 10 per coffee. Does not submit an order or take payment. Returns the full order and subtotal in cents.`,
+          inputSchema: {
+            type: 'object',
+            properties: {
+              quantity: {
+                type: 'integer', minimum: 1, maximum: 10, default: 1,
+                description: 'Number of coffees to add; defaults to 1.'
+              }
+            },
+            additionalProperties: false
+          },
+          annotations: { readOnlyHint: false },
+          execute: toolResult(input => orderCoffee(coffee, input))
+        }));
+        tools.push({
+          name: 'get_coffee_order',
+          description: 'Read the current on-page sample coffee order, quantities, USD prices and subtotal in cents. No order has been submitted.',
+          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+          annotations: { readOnlyHint: true },
+          execute: toolResult(getOrder)
+        }, {
+          name: 'clear_coffee_order',
+          description: 'Remove all coffees from the on-page sample order and return the empty order. No payment or café submission is involved.',
+          inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+          annotations: { readOnlyHint: false },
+          execute: toolResult(clearOrder)
+        });
+        for (const tool of tools) {
+          try {
+            Promise.resolve(modelContext.registerTool(tool)).catch(error => {
+              console.warn(`Could not register ${tool.name}:`, error);
+            });
+          } catch (error) {
+            console.warn(`Could not register ${tool.name}:`, error);
+          }
+        }
+      }
+    })();
+  </script>
 </body>
 
