+  <script>
+    document.querySelectorAll('.carousel').forEach((carousel) => {
+      const items = [...carousel.querySelectorAll('.carousel-item')];
+      let scrollTimer;
+
+      const highlightSnappedItem = () => {
+        const bounds = carousel.getBoundingClientRect();
+        const center = bounds.left + carousel.clientWidth / 2;
+        let snappedItem;
+        let closestDistance = Infinity;
+
+        items.forEach((item) => {
+          const itemBounds = item.getBoundingClientRect();
+          const distance = Math.abs(itemBounds.left + itemBounds.width / 2 - center);
+          if (distance < closestDistance) {
+            closestDistance = distance;
+            snappedItem = item;
+          }
+        });
+
+        items.forEach((item) => {
+          item.classList.toggle('is-snapped', item === snappedItem);
+        });
+      };
+
+      carousel.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(highlightSnappedItem, 150);
+      }, { passive: true });
+      carousel.addEventListener('scrollend', () => {
+        clearTimeout(scrollTimer);
+        highlightSnappedItem();
+      });
+      new ResizeObserver(highlightSnappedItem).observe(carousel);
+      highlightSnappedItem();
+    });
+  </script>
