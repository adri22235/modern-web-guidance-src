+  <script>
+    // Native scroll-state queries handle the highlight where supported.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const carousel = document.querySelector('.carousel');
+      const items = [...carousel.querySelectorAll('.carousel-item')];
+      let settleTimer;
+
+      function highlightSnappedItem() {
+        clearTimeout(settleTimer);
+        const bounds = carousel.getBoundingClientRect();
+        const center = bounds.left + carousel.clientWidth / 2;
+        const nearest = items.reduce((closest, item) => {
+          const distance = Math.abs(item.getBoundingClientRect().left + item.offsetWidth / 2 - center);
+          return distance < closest.distance ? { item, distance } : closest;
+        }, { item: null, distance: Infinity }).item;
+
+        items.forEach(item => item.classList.toggle('is-snapped', item === nearest));
+      }
+
+      carousel.addEventListener('scrollend', highlightSnappedItem);
+      carousel.addEventListener('scroll', () => {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(highlightSnappedItem, 150);
+      }, { passive: true });
+      new ResizeObserver(highlightSnappedItem).observe(carousel);
+      highlightSnappedItem();
+    }
+  </script>
