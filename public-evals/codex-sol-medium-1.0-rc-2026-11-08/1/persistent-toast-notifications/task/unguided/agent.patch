+  <div class="toast-stack" aria-live="polite" aria-relevant="additions" aria-label="Notifications"></div>
+
+  <script>
+    (() => {
+      const stack = document.querySelector('.toast-stack');
+      const active = new Map();
+      const lifetime = 6000;
+
+      function showToast(trigger) {
+        // Bound the stack so repeated clicks cannot cover the page.
+        const limit = Math.max(1, Math.min(3, Math.floor((window.innerHeight - 40) / 150)));
+        while (stack.children.length >= limit) {
+          const oldest = stack.firstElementChild;
+          active.get(oldest)?.();
+        }
+
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.dataset.type = trigger.dataset.toastType || 'info';
+        const copy = document.createElement('div');
+        copy.className = 'toast-copy';
+        const title = document.createElement('strong');
+        title.textContent = trigger.dataset.toastTitle || 'Coffee update';
+        const message = document.createElement('p');
+        message.textContent = trigger.dataset.toastMessage || 'Something good is brewing.';
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', 'Dismiss notification');
+        close.textContent = '×';
+        copy.append(title, message);
+        toast.append(copy, close);
+
+        let timer;
+        let fallback;
+        let remaining = lifetime;
+        let started;
+        let leaving = false;
+        function remove() {
+          clearTimeout(timer);
+          clearTimeout(fallback);
+          document.removeEventListener('visibilitychange', visibilityChange);
+          if (toast.contains(document.activeElement) && trigger.isConnected) trigger.focus();
+          active.delete(toast);
+          toast.remove();
+        }
+        function dismiss() {
+          if (leaving) return;
+          leaving = true;
+          clearTimeout(timer);
+          toast.classList.add('is-leaving');
+          toast.addEventListener('animationend', remove, { once: true });
+          fallback = setTimeout(remove, 250);
+        }
+        function pause() {
+          if (!timer) return;
+          clearTimeout(timer);
+          timer = null;
+          remaining = Math.max(0, remaining - (Date.now() - started));
+        }
+        function resume() {
+          if (leaving || timer || document.hidden || toast.matches(':hover') || toast.contains(document.activeElement)) return;
+          started = Date.now();
+          timer = setTimeout(dismiss, remaining);
+        }
+        function visibilityChange() {
+          if (document.hidden) pause();
+          else resume();
+        }
+        active.set(toast, remove);
+        close.addEventListener('click', dismiss);
+        toast.addEventListener('pointerenter', pause);
+        toast.addEventListener('pointerleave', resume);
+        toast.addEventListener('focusin', pause);
+        toast.addEventListener('focusout', () => queueMicrotask(resume));
+        toast.addEventListener('keydown', event => {
+          if (event.key === 'Escape') dismiss();
+        });
+        document.addEventListener('visibilitychange', visibilityChange);
+        stack.append(toast);
+        resume();
+      }
+
+      document.addEventListener('click', event => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger || trigger.disabled || trigger.getAttribute('aria-disabled') === 'true') return;
+        if (trigger.tagName === 'A') event.preventDefault();
+        showToast(trigger);
+      });
+    })();
+  </script>
