+  <script>
+    (() => {
+      const stack = document.getElementById('toast-stack');
+      const announcer = document.getElementById('toast-announcer');
+      const supportsPopover = 'popover' in HTMLElement.prototype;
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const notifications = new Map();
+      let announcementTimer;
+
+      function animate(toast, exiting = false) {
+        if (reducedMotion.matches || !toast.animate) return Promise.resolve();
+        const frames = [
+          { opacity: 0, transform: 'translateY(12px)' },
+          { opacity: 1, transform: 'translateY(0)' }
+        ];
+        return toast.animate(exiting ? frames.reverse() : frames, {
+          duration: exiting ? 160 : 240,
+          easing: 'ease-out',
+          fill: 'forwards'
+        }).finished.catch(() => {});
+      }
+
+      function pause(toast) {
+        const state = notifications.get(toast);
+        if (!state || !state.timer) return;
+        clearTimeout(state.timer);
+        state.timer = null;
+        state.remaining -= performance.now() - state.started;
+      }
+
+      function resume(toast) {
+        const state = notifications.get(toast);
+        if (!state || state.closing || state.timer || toast.matches(':hover') || toast.contains(document.activeElement)) return;
+        state.started = performance.now();
+        state.timer = setTimeout(() => dismiss(toast), Math.max(0, state.remaining));
+      }
+
+      async function dismiss(toast, immediate = false) {
+        const state = notifications.get(toast);
+        if (!state || state.closing) return;
+        state.closing = true;
+        clearTimeout(state.timer);
+        if (toast.contains(document.activeElement)) {
+          const next = [...notifications.keys()].find(item => item !== toast && !notifications.get(item).closing);
+          (next?.querySelector('button') || state.trigger).focus({ preventScroll: true });
+        }
+        if (!immediate) await animate(toast, true);
+        toast.remove();
+        notifications.delete(toast);
+        if (!notifications.size) {
+          if (supportsPopover) stack.hidePopover();
+          stack.hidden = true;
+        }
+      }
+
+      document.addEventListener('click', event => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (!trigger || trigger.matches(':disabled, [aria-disabled="true"]')) return;
+        // A toast trigger is an action; links using this class do not navigate.
+        event.preventDefault();
+        const title = trigger.dataset.toastTitle || 'The Daily Grind';
+        const message = trigger.dataset.toastMessage || 'Thanks for stopping by. Your next great cup is waiting.';
+
+        // Bound the stack so repeated clicks cannot cover the page.
+        const active = [...notifications.keys()].filter(toast => !notifications.get(toast).closing);
+        if (active.length >= 3) {
+          const oldest = active.find(toast => !toast.contains(document.activeElement));
+          if (oldest) dismiss(oldest, true);
+        }
+
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        const content = document.createElement('div');
+        content.className = 'toast-content';
+        const heading = document.createElement('strong');
+        heading.className = 'toast-title';
+        heading.textContent = title;
+        const body = document.createElement('p');
+        body.textContent = message;
+        content.append(heading, body);
+        const close = document.createElement('button');
+        close.type = 'button';
+        close.className = 'toast-close';
+        close.setAttribute('aria-label', `Dismiss notification: ${title}`);
+        close.textContent = '×';
+        close.addEventListener('click', () => dismiss(toast));
+        toast.append(content, close);
+        notifications.set(toast, { remaining: 6000, timer: null, started: 0, trigger, closing: false });
+        toast.addEventListener('pointerenter', () => pause(toast));
+        toast.addEventListener('pointerleave', () => resume(toast));
+        toast.addEventListener('focusin', () => pause(toast));
+        toast.addEventListener('focusout', () => queueMicrotask(() => resume(toast)));
+        stack.append(toast);
+        stack.hidden = false;
+        if (supportsPopover && !stack.matches(':popover-open')) stack.showPopover();
+        animate(toast);
+        resume(toast);
+
+        // Re-announce repeated messages without moving keyboard focus.
+        clearTimeout(announcementTimer);
+        announcer.textContent = '';
+        announcementTimer = setTimeout(() => {
+          announcer.textContent = `${title}. ${message}`;
+        }, 100);
+      });
+    })();
+  </script>
+
