+export const contentSecurityPolicy = [
+  "default-src 'none'",
+  "script-src 'self'",
+  "script-src-attr 'none'",
+  "style-src 'self'",
+  "img-src 'self' https://images.unsplash.com",
+  "connect-src 'self'",
+  "form-action 'self'",
+  "base-uri 'none'",
+  "object-src 'none'",
+  "frame-src 'none'",
+  "frame-ancestors 'none'",
+  "worker-src 'none'",
+].join('; ');
+
+export const securityHeaders = {
+  'Content-Security-Policy': contentSecurityPolicy,
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'no-referrer',
+  'X-Frame-Options': 'DENY',
+  'Cache-Control': 'no-store',
+};
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..6dbf194
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,96 @@
+import { createServer } from 'node:http';
+import { readFile, mkdir, appendFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+import { securityHeaders } from './security.mjs';
+
+const root = fileURLToPath(new URL('.', import.meta.url));
+const dataDirectory = resolve(process.env.DATA_DIR || resolve(root, 'data'));
+// Explicit routes keep server source and customer records out of the public files.
+const assets = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+
+function readBody(request) {
+  return new Promise((accept, reject) => {
+    const chunks = [];
+    let size = 0;
+    request.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > 4096) {
+        reject(Object.assign(new Error('Body too large'), { status: 413 }));
+      } else {
+        chunks.push(chunk);
+      }
+    });
+    request.on('end', () => accept(Buffer.concat(chunks).toString('utf8')));
+    request.on('error', reject);
+    request.on('aborted', () => reject(new Error('Request aborted')));
+  });
+}
+
+const server = createServer(async (request, response) => {
+  for (const [name, value] of Object.entries(securityHeaders)) response.setHeader(name, value);
+  const wantsJson = request.headers.accept?.includes('application/json');
+  function reply(code, message, ok = false) {
+    response.statusCode = code;
+    if (wantsJson) {
+      response.setHeader('Content-Type', 'application/json; charset=utf-8');
+      response.end(JSON.stringify({ ok, message }));
+    } else {
+      response.setHeader('Content-Type', 'text/html; charset=utf-8');
+      // Messages are fixed strings, never reflected customer input.
+      response.end(`<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Daily Grind signup</title><link rel="stylesheet" href="/styles.css"><main class="container"><h1>Newsletter signup</h1><p>${message}</p><a href="/">Back to Daily Grind</a></main></html>`);
+    }
+  }
+  try {
+    const pathname = new URL(request.url, 'http://localhost').pathname;
+    if (pathname === '/api/newsletter') {
+      if (request.method !== 'POST') {
+        response.setHeader('Allow', 'POST');
+        return reply(405, 'Please submit the signup form from our homepage.');
+      }
+      if (request.headers['sec-fetch-site'] === 'cross-site') {
+        return reply(403, 'Please submit the signup form from our homepage.');
+      }
+      const type = request.headers['content-type']?.split(';')[0].trim();
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return reply(415, 'Please submit the signup form from our homepage.');
+      }
+      const body = await readBody(request);
+      let email;
+      try {
+        email = type === 'application/json' ? JSON.parse(body)?.email : new URLSearchParams(body).get('email');
+      } catch {
+        return reply(400, 'Please enter a valid email address and try again.');
+      }
+      if (typeof email !== 'string') return reply(400, 'Please enter a valid email address and try again.');
+      email = email.trim();
+      if (email.length > 254 || !/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email)) {
+        return reply(400, 'Please enter a valid email address and try again.');
+      }
+      await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+      await appendFile(resolve(dataDirectory, 'newsletter.jsonl'),
+        JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      return reply(201, 'You’re on the list! Thanks for joining The Daily Grind.', true);
+    }
+    const asset = assets.get(pathname);
+    if (!asset) return reply(404, 'This page could not be found.');
+    if (!['GET', 'HEAD'].includes(request.method)) {
+      response.setHeader('Allow', 'GET, HEAD');
+      return reply(405, 'This request could not be completed.');
+    }
+    const contents = await readFile(resolve(root, asset[0]));
+    response.setHeader('Content-Type', asset[1]);
+    response.end(request.method === 'HEAD' ? undefined : contents);
+  } catch (error) {
+    reply(error.status === 413 ? 413 : 500,
+      'We couldn’t complete your request. Please try again in a moment.');
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+server.listen(Number(process.env.PORT || 11222), process.env.HOST || '0.0.0.0');
