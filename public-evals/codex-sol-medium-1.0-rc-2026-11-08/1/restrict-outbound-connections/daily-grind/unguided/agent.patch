+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { securityHeaders } from '../security.mjs';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+for (const file of ['server.mjs', 'security.mjs', 'newsletter.js', 'scripts/build.mjs']) {
+  const result = spawnSync(process.execPath, ['--check', file], { cwd: root, encoding: 'utf8' });
+  assert.equal(result.status, 0, result.stderr);
+}
+const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+const css = await readFile(new URL('../styles.css', import.meta.url), 'utf8');
+assert(!/<style\b|\sstyle\s*=|\son\w+\s*=/i.test(html), 'Inline styles or event handlers would violate CSP');
+assert(!/<script\b(?![^>]*\bsrc=)/i.test(html), 'Inline scripts would violate CSP');
+assert.match(html, /<script src="\/newsletter.js" defer><\/script>/);
+assert.match(html, /<link rel="stylesheet" href="\/styles.css">/);
+assert.match(html, /action="\/api\/newsletter" method="post"/);
+assert.match(html, /id="request-status"[^>]*role="status"/);
+for (const url of (html + css).match(/https?:\/\/[^\s'"<>)]+/g) || []) {
+  assert.equal(new URL(url).origin, 'https://images.unsplash.com', 'Unexpected external resource');
+}
+const policy = new Map(securityHeaders['Content-Security-Policy'].split('; ').map((directive) => {
+  const [name, ...sources] = directive.split(' ');
+  return [name, sources.join(' ')];
+}));
+for (const [name, sources] of Object.entries({
+  'default-src': "'none'", 'connect-src': "'self'", 'form-action': "'self'",
+  'script-src': "'self'", 'style-src': "'self'", 'base-uri': "'none'",
+  'object-src': "'none'", 'frame-src': "'none'", 'frame-ancestors': "'none'",
+  'img-src': "'self' https://images.unsplash.com",
+})) assert.equal(policy.get(name), sources, `Unexpected ${name} policy`);
+console.log('Build checks passed: JavaScript syntax, local assets, form markup, and CSP allowlist. No server was started.');
