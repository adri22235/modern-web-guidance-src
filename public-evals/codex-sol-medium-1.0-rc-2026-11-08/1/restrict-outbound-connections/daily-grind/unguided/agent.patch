diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..cfb36b2
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,39 @@
+const form = document.querySelector('#newsletter-form');
+const status = document.querySelector('#request-status');
+const button = form.querySelector('button');
+
+document.addEventListener('securitypolicyviolation', (event) => {
+  if (event.disposition === 'enforce') {
+    status.textContent = 'A request was blocked for your security. Please try again or contact us if the problem continues.';
+  }
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (button.disabled || !form.reportValidity()) return;
+  button.disabled = true;
+  status.textContent = 'Signing you up…';
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 10000);
+  try {
+    const response = await fetch('/api/newsletter', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      credentials: 'same-origin',
+      mode: 'same-origin',
+      redirect: 'error',
+      signal: controller.signal,
+      body: JSON.stringify({ email: form.elements.email.value.trim() }),
+    });
+    if (!response.ok) throw new Error('Signup failed');
+    const result = await response.json();
+    if (result.ok !== true) throw new Error('Invalid response');
+    status.textContent = 'You’re on the list! Thanks for joining The Daily Grind.';
+    form.reset();
+  } catch {
+    status.textContent = 'We couldn’t complete your signup. Please check your connection and try again.';
+  } finally {
+    clearTimeout(timeout);
+    button.disabled = false;
+  }
+});
