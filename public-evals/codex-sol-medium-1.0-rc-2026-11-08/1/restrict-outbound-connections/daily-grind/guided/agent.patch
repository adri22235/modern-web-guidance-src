+import { randomBytes } from 'node:crypto';
+import { appendFile, mkdir, readFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const files = new Map(await Promise.all([
+  ['/', 'index.html', 'text/html; charset=utf-8'],
+  ['/styles.css', 'styles.css', 'text/css; charset=utf-8'],
+  ['/newsletter.js', 'newsletter.js', 'text/javascript; charset=utf-8'],
+].map(async ([path, file, type]) => [path, { body: await readFile(new URL(file, import.meta.url), 'utf8'), type }])));
+
+export function securityHeaders(nonce) {
+  return {
+    'Connection-Allowlist': '(response-origin "https://images.unsplash.com"); report-to=security',
+    'Reporting-Endpoints': 'security="/api/security-reports"',
+    'Content-Security-Policy': [
+      "default-src 'self'",
+      `script-src 'nonce-${nonce}' 'report-sample'`,
+      "script-src-attr 'none'",
+      "style-src 'self'",
+      "connect-src 'self'",
+      "img-src 'self' https://images.unsplash.com",
+      "form-action 'self'",
+      "worker-src 'none'",
+      "frame-src 'none'",
+      "object-src 'none'",
+      "base-uri 'none'",
+      "frame-ancestors 'none'",
+      "require-trusted-types-for 'script'",
+      'report-to security',
+    ].join('; '),
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'X-DNS-Prefetch-Control': 'off',
+    'Referrer-Policy': 'no-referrer',
+    'Cache-Control': 'no-store',
+  };
+}
+
+async function readBody(req, limit) {
+  let size = 0;
+  const chunks = [];
+  for await (const chunk of req) {
+    size += Buffer.byteLength(chunk);
+    if (size > limit) throw Object.assign(new Error('Too large'), { status: 413 });
+    chunks.push(Buffer.from(chunk));
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+export function createHandler({ saveEmail = async (email) => {
+  const directory = resolve(process.env.DATA_DIR || fileURLToPath(new URL('./data', import.meta.url)));
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await appendFile(resolve(directory, 'newsletter.jsonl'), JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+} } = {}) {
+  return async (req, res) => {
+    const nonce = randomBytes(18).toString('base64');
+    for (const [name, value] of Object.entries(securityHeaders(nonce))) res.setHeader(name, value);
+    const reply = (code, message) => {
+      const json = req.headers.accept?.includes('application/json');
+      res.writeHead(code, { 'Content-Type': json ? 'application/json; charset=utf-8' : 'text/plain; charset=utf-8' });
+      res.end(json ? JSON.stringify({ message }) : message);
+    };
+    try {
+      const path = new URL(req.url, 'http://localhost').pathname;
+      if (req.method === 'GET' || req.method === 'HEAD') {
+        const asset = files.get(path === '/index.html' ? '/' : path);
+        if (!asset) return reply(404, 'Page not found.');
+        res.writeHead(200, { 'Content-Type': asset.type });
+        return res.end(req.method === 'HEAD' ? undefined : asset.body.replace('{{SCRIPT_NONCE}}', nonce));
+      }
+      if (req.method !== 'POST' || !['/api/newsletter', '/api/security-reports'].includes(path)) {
+        return reply(405, 'Request method not allowed.');
+      }
+      // Reject cross-origin form submissions as well as cross-site fetches.
+      const origin = req.headers.origin;
+      const expectedOrigin = process.env.PUBLIC_ORIGIN;
+      if (req.headers['sec-fetch-site'] === 'cross-site' || (origin && (
+        expectedOrigin ? origin !== new URL(expectedOrigin).origin : new URL(origin).host !== req.headers.host
+      ))) return reply(403, 'Please submit the form from the Daily Grind website.');
+
+      if (path === '/api/security-reports') {
+        await readBody(req, 65536);
+        // Record receipt without logging URLs, query strings, or customer data.
+        console.info('Security policy report received');
+        res.writeHead(204);
+        return res.end();
+      }
+      const type = req.headers['content-type']?.split(';')[0];
+      if (!['application/json', 'application/x-www-form-urlencoded'].includes(type)) {
+        return reply(415, 'Please submit an email address using the signup form.');
+      }
+      const body = await readBody(req, 4096);
+      let data;
+      try {
+        data = type === 'application/json' ? JSON.parse(body) : Object.fromEntries(new URLSearchParams(body));
+      } catch {
+        return reply(400, 'Please enter a valid email address.');
+      }
+      const email = typeof data?.email === 'string' ? data.email.trim() : '';
+      if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+        return reply(400, 'Please enter a valid email address.');
+      }
+      await saveEmail(email);
+      return reply(201, 'Thanks! You’re signed up for Daily Grind news.');
+    } catch (error) {
+      return reply(error.status || 503, 'We couldn’t send your signup. Please try again.');
+    }
+  };
+}
+
+export const handleRequest = createHandler();
diff --git a/app.test.mjs b/app.test.mjs
new file mode 100644
index 0000000..7894f7c
--- /dev/null
+++ b/app.test.mjs
@@ -0,0 +1,111 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Readable } from 'node:stream';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+import { createHandler } from './app.mjs';
+
+async function request(handler, { url = '/', method = 'GET', body = '', headers = {} } = {}) {
+  const req = Readable.from([Buffer.from(body)]);
+  Object.assign(req, { url, method, headers: { host: 'dailygrind.test', ...headers } });
+  const res = {
+    headers: {},
+    setHeader(name, value) { this.headers[name] = value; },
+    writeHead(status, headers = {}) { this.status = status; Object.assign(this.headers, headers); },
+    end(body = '') { this.body = body; },
+  };
+  await handler(req, res);
+  return res;
+}
+
+const signup = (body, extra = {}) => ({
+  url: '/api/newsletter', method: 'POST', body,
+  headers: { 'content-type': 'application/json', accept: 'application/json', ...extra },
+});
+
+test('HTML has enforcing policies and a fresh matching script nonce', async () => {
+  const handler = createHandler();
+  const first = await request(handler);
+  const second = await request(handler);
+  assert.equal(first.status, 200);
+  assert.equal(first.headers['Connection-Allowlist'], '(response-origin "https://images.unsplash.com"); report-to=security');
+  assert.equal(first.headers['Reporting-Endpoints'], 'security="/api/security-reports"');
+  const nonce = first.body.match(/nonce="([^"]+)"/)[1];
+  assert.ok(first.headers['Content-Security-Policy'].includes(`script-src 'nonce-${nonce}'`));
+  assert.notEqual(first.body, second.body);
+  for (const directive of ["connect-src 'self'", "img-src 'self' https://images.unsplash.com", "form-action 'self'", "worker-src 'none'"]) {
+    assert.ok(first.headers['Content-Security-Policy'].includes(directive));
+  }
+  assert.ok(!first.body.includes('<style>'));
+  assert.ok(!first.body.includes('style='));
+  assert.equal((await request(handler, { url: '/data/newsletter.jsonl' })).status, 404);
+  assert.equal((await request(handler, { url: '/newsletter.js' })).status, 200);
+});
+
+test('valid signup is saved before returning success; native form fallback works', async () => {
+  const saved = [];
+  const handler = createHandler({ saveEmail: async (email) => saved.push(email) });
+  assert.equal((await request(handler, signup('{"email":" coffee@example.com "}'))).status, 201);
+  assert.deepEqual(saved, ['coffee@example.com']);
+  const fallback = await request(handler, {
+    url: '/api/newsletter', method: 'POST', body: 'email=brew%40example.com',
+    headers: { 'content-type': 'application/x-www-form-urlencoded' },
+  });
+  assert.equal(fallback.status, 201);
+  assert.match(fallback.body, /Thanks!/);
+});
+
+test('invalid, malformed, oversized and cross-origin signups never save data', async () => {
+  const handler = createHandler({ saveEmail: async () => assert.fail('Unexpected save') });
+  for (const body of ['{"email":"invalid"}', '{', 'null', '{}']) {
+    assert.equal((await request(handler, signup(body))).status, 400);
+  }
+  assert.equal((await request(handler, signup('x'.repeat(4097)))).status, 413);
+  assert.equal((await request(handler, signup('{"email":"a@example.com"}', { origin: 'https://attacker.test' }))).status, 403);
+});
+
+test('storage failure returns an actionable failure instead of false success', async () => {
+  const handler = createHandler({ saveEmail: async () => { throw new Error('Storage unavailable'); } });
+  const result = await request(handler, signup('{"email":"a@example.com"}'));
+  assert.equal(result.status, 503);
+  assert.match(JSON.parse(result.body).message, /try again/i);
+});
+
+test('client handles blocked/network, HTTP and timeout failures and permits retry', async () => {
+  const script = await readFile(new URL('./newsletter.js', import.meta.url), 'utf8');
+  for (const failure of ['blocked', 'http', 'timeout']) {
+    let submit;
+    let timer;
+    const button = { disabled: false };
+    const status = { textContent: '' };
+    const form = {
+      elements: { email: { value: 'coffee@example.com' } },
+      querySelector: () => button,
+      addEventListener: (_, callback) => { submit = callback; },
+      reset: () => assert.fail('Email must survive failure'),
+    };
+    runInNewContext(script, {
+      document: { querySelector: (selector) => selector === '#newsletter-form' ? form : status },
+      AbortController,
+      setTimeout: (callback) => { timer = callback; return 1; },
+      clearTimeout: () => {},
+      fetch: async (url, options) => {
+        assert.equal(url, '/api/newsletter');
+        assert.equal(options.redirect, 'error');
+        if (failure === 'http') return { ok: false };
+        if (failure === 'timeout') {
+          return new Promise((_, reject) => {
+            options.signal.addEventListener('abort', () => reject(new Error('Timeout')));
+          });
+        }
+        throw new TypeError('Network access revoked');
+      },
+    });
+    const pending = submit({ preventDefault() {} });
+    if (failure === 'timeout') timer();
+    await pending;
+    assert.equal(button.disabled, false);
+    assert.match(status.textContent, /try again/i);
+    assert.equal(form.elements.email.value, 'coffee@example.com');
+  }
+});
