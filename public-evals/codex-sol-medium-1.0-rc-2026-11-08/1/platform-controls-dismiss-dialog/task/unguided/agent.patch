+  <script>
+    const dialog = document.getElementById('coffee-dialog');
+    const dialogTitle = document.getElementById('coffee-dialog-title');
+    const dialogDescription = document.getElementById('coffee-dialog-description');
+    const detailsButtons = [...document.querySelectorAll('[data-coffee]')];
+    const historyKey = 'dailyGrindCoffeeDialog';
+    const sessionId = crypto.randomUUID();
+    let returningToPage = false;
+
+    function currentCoffee() {
+      const entry = history.state?.[historyKey];
+      return entry?.sessionId === sessionId
+        ? detailsButtons.find(button => button.dataset.coffee === entry.coffee)
+        : undefined;
+    }
+
+    function showDetails(button) {
+      const card = button.closest('.card');
+      dialogTitle.textContent = card.querySelector('h3').textContent;
+      dialogDescription.textContent = card.querySelector('p').textContent;
+      if (!dialog.open) dialog.showModal();
+    }
+
+    detailsButtons.forEach(button => {
+      button.addEventListener('click', () => {
+        if (returningToPage || dialog.open) return;
+        history.pushState({
+          ...history.state,
+          [historyKey]: { sessionId, coffee: button.dataset.coffee }
+        }, '');
+        showDetails(button);
+      });
+    });
+
+    // Escape and the Close button use native dialog dismissal. Remove the
+    // matching history entry too, so the next Back action navigates normally.
+    dialog.addEventListener('close', () => {
+      if (!dialog.open && currentCoffee() && !returningToPage) {
+        returningToPage = true;
+        history.back();
+      }
+    });
+
+    // Browser Back (including mobile back gestures) dismisses the modal;
+    // Forward restores the selected coffee's details.
+    window.addEventListener('popstate', () => {
+      returningToPage = false;
+      const button = currentCoffee();
+      if (button) {
+        button.focus();
+        showDetails(button);
+      } else if (dialog.open) {
+        dialog.close();
+      }
+    });
+  </script>
+
