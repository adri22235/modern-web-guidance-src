+          // Right face (x = +hw)
+          hw, -hh, hd,    1, 0, 0,   0, 1,
+          hw, -hh, -hd,   1, 0, 0,   1, 1,
+          hw, hh, -hd,    1, 0, 0,   1, 0,
+          hw, -hh, hd,    1, 0, 0,   0, 1,
+          hw, hh, -hd,    1, 0, 0,   1, 0,
+          hw, hh, hd,     1, 0, 0,   0, 0,
+
+          // Left face (x = -hw)
+          -hw, -hh, -hd, -1, 0, 0,   0, 1,
+          -hw, -hh, hd,  -1, 0, 0,   1, 1,
+          -hw, hh, hd,   -1, 0, 0,   1, 0,
+          -hw, -hh, -hd, -1, 0, 0,   0, 1,
+          -hw, hh, hd,   -1, 0, 0,   1, 0,
+          -hw, hh, -hd,  -1, 0, 0,   0, 0,
+
+          // Top face (y = +hh)
+          -hw, hh, hd,    0, 1, 0,   0, 1,
+          hw, hh, hd,     0, 1, 0,   1, 1,
+          hw, hh, -hd,    0, 1, 0,   1, 0,
+          -hw, hh, hd,    0, 1, 0,   0, 1,
+          hw, hh, -hd,    0, 1, 0,   1, 0,
+          -hw, hh, -hd,   0, 1, 0,   0, 0,
+
+          // Bottom face (y = -hh)
+          -hw, -hh, -hd,  0, -1, 0,  0, 1,
+          hw, -hh, -hd,   0, -1, 0,  1, 1,
+          hw, -hh, hd,    0, -1, 0,  1, 0,
+          -hw, -hh, -hd,  0, -1, 0,  0, 1,
+          hw, -hh, hd,    0, -1, 0,  1, 0,
+          -hw, -hh, hd,   0, -1, 0,  0, 0,
+        ]);
+
+        // Front face unit quad (-0.5 to 0.5) in model space as required by computeCanvasTransform
+        const frontQuadVertices = new Float32Array([
+          -0.5, -0.5, 0.0,  0, 0, 1,  0, 1,
+           0.5, -0.5, 0.0,  0, 0, 1,  1, 1,
+           0.5,  0.5, 0.0,  0, 0, 1,  1, 0,
+          -0.5, -0.5, 0.0,  0, 0, 1,  0, 1,
+           0.5,  0.5, 0.0,  0, 0, 1,  1, 0,
+          -0.5,  0.5, 0.0,  0, 0, 1,  0, 0,
+        ]);
+
+        function createVAO(vertexData) {
+          const vao = gl.createVertexArray();
+          gl.bindVertexArray(vao);
+          const vbo = gl.createBuffer();
+          gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
+          gl.bufferData(gl.ARRAY_BUFFER, vertexData, gl.STATIC_DRAW);
+          const stride = 8 * 4;
+          gl.enableVertexAttribArray(0);
+          gl.vertexAttribPointer(0, 3, gl.FLOAT, false, stride, 0);
+          gl.enableVertexAttribArray(1);
+          gl.vertexAttribPointer(1, 3, gl.FLOAT, false, stride, 3 * 4);
+          gl.enableVertexAttribArray(2);
+          gl.vertexAttribPointer(2, 2, gl.FLOAT, false, stride, 6 * 4);
+          gl.bindVertexArray(null);
+          return vao;
+        }
+
+        texture = gl.createTexture();
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+
+        glResources = {
+          program,
+          sidesVAO: createVAO(boxSidesVertices),
+          frontVAO: createVAO(frontQuadVertices),
+          boxW,
+          boxH,
+          boxD,
+          uMVP: gl.getUniformLocation(program, 'uMVP'),
+          uModel: gl.getUniformLocation(program, 'uModel'),
+          uUseTexture: gl.getUniformLocation(program, 'uUseTexture'),
+          uTexture: gl.getUniformLocation(program, 'uTexture'),
+          uBaseColor: gl.getUniformLocation(program, 'uBaseColor'),
+          uTrimColor: gl.getUniformLocation(program, 'uTrimColor'),
+        };
+      }
+
+      // Setup Fallback Mode if HTML-in-Canvas is not supported
+      if (hasHtmlInCanvas) {
+        renderModeStatus.textContent = '3D Mode: Native HTML-in-Canvas Projection';
+      } else {
+        stage.classList.add('fallback-mode');
+        const fallbackOverlay = document.createElement('div');
+        fallbackOverlay.className = 'fallback-overlay';
+        fallbackOverlay.appendChild(uiElement);
+        stage.appendChild(fallbackOverlay);
+        renderModeStatus.textContent = '3D Mode: WebGL Box + Interactive CSS 3D Fallback';
+      }
+
+      // Rotation state & pointer drag interaction
+      let isAutoSpinning = true;
+      let isDragging = false;
+      let dragStartX = 0;
+      let dragStartY = 0;
+      let rotY = -0.28;
+      let rotX = 0.12;
+      let lastTime = performance.now();
+
+      canvas.addEventListener('pointerdown', (e) => {
+        isDragging = true;
+        dragStartX = e.clientX;
+        dragStartY = e.clientY;
+        canvas.setPointerCapture(e.pointerId);
+      });
+
+      canvas.addEventListener('pointermove', (e) => {
+        if (!isDragging) return;
+        const dx = e.clientX - dragStartX;
+        const dy = e.clientY - dragStartY;
+        dragStartX = e.clientX;
+        dragStartY = e.clientY;
+        rotY = Math.max(-0.85, Math.min(0.85, rotY + dx * 0.007));
+        rotX = Math.max(-0.45, Math.min(0.45, rotX + dy * 0.007));
+      });
+
+      canvas.addEventListener('pointerup', () => {
+        isDragging = false;
+      });
+      canvas.addEventListener('pointercancel', () => {
+        isDragging = false;
+      });
+
+      // Pause automatic rotation while a user focuses inside a form field for comfortable typing,
+      // or let the gentle oscillation continue if auto-spinning is enabled.
+      let isEditingInput = false;
+      recipientInput.addEventListener('focus', () => {
+        isEditingInput = true;
+      });
+      recipientInput.addEventListener('blur', () => {
+        isEditingInput = false;
+      });
+
+      function computeSceneMatrices() {
+        const aspect = (canvas.clientWidth || 720) / (canvas.clientHeight || 580);
+        const proj = mat4Perspective((42 * Math.PI) / 180, aspect, 0.1, 20.0);
+        const view = mat4Translate(0, 0, -4.15);
+        const viewProj = mat4Multiply(proj, view);
+
+        const boxModel = mat4Multiply(mat4RotateX(rotX), mat4RotateY(rotY));
+        const { boxW = 1.65, boxH = 2.15, boxD = 0.85 } = glResources || {};
+
+        // Front quad spans -0.5..0.5 in local space; scale to boxW x boxH and translate to front face z = +boxD/2
+        const frontLocal = mat4Multiply(
+          mat4Translate(0, 0, boxD / 2 + 0.002),
+          mat4Scale(boxW, boxH, 1)
+        );
+        const frontModel = mat4Multiply(boxModel, frontLocal);
+
+        return {
+          boxModel,
+          boxMVP: mat4Multiply(viewProj, boxModel),
+          frontModel,
+          htmlElementMVP: mat4Multiply(viewProj, frontModel),
+        };
+      }
+
+      function drawWebGLBox(matrices) {
+        if (!gl || !glResources) return;
+        const { program, sidesVAO, frontVAO, uMVP, uModel, uUseTexture, uTexture, uBaseColor, uTrimColor } = glResources;
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+        gl.enable(gl.DEPTH_TEST);
+
+        gl.useProgram(program);
+
+        // Draw 5 shaded sides of the 3D coffee box
+        gl.bindVertexArray(sidesVAO);
+        gl.uniformMatrix4fv(uMVP, false, matrices.boxMVP);
+        gl.uniformMatrix4fv(uModel, false, matrices.boxModel);
+        gl.uniform1i(uUseTexture, 0);
+        gl.uniform3fv(uBaseColor, activePalette.side);
+        gl.uniform3fv(uTrimColor, activePalette.trim);
+        gl.drawArrays(gl.TRIANGLES, 0, 30);
+
+        // Draw the front face of the coffee box
+        gl.bindVertexArray(frontVAO);
+        gl.uniformMatrix4fv(uMVP, false, matrices.htmlElementMVP);
+        gl.uniformMatrix4fv(uModel, false, matrices.frontModel);
+
+        if (hasHtmlInCanvas && textureState.width > 0 && textureState.height > 0) {
+          gl.activeTexture(gl.TEXTURE0);
+          gl.bindTexture(gl.TEXTURE_2D, texture);
+          gl.uniform1i(uTexture, 0);
+          gl.uniform1i(uUseTexture, 1);
+        } else {
+          gl.uniform1i(uUseTexture, 0);
+          gl.uniform3fv(uBaseColor, activePalette.top);
+          gl.uniform3fv(uTrimColor, activePalette.trim);
+        }
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+        gl.bindVertexArray(null);
+      }
+
+      // 4 & 5. Render HTML content to a texture inside canvas.onpaint and sync geometry
+      canvas.onpaint = (event) => {
+        if (
+          gl &&
+          hasHtmlInCanvas &&
+          (needsTextureUpload || !event || (event.changedElements && event.changedElements.length > 0))
+        ) {
+          try {
+            if (uploadElementWebGL(gl, canvas, texture, uiElement, textureState)) {
+              needsTextureUpload = false;
+            }
+          } catch (err) {
+            console.error('texElementSubImage2D copy failed:', err);
+          }
+        }
+
+        const matrices = computeSceneMatrices();
+        drawWebGLBox(matrices);
+
+        if (hasHtmlInCanvas && typeof canvas.updateElementGeometry === 'function') {
+          canvas.updateElementGeometry(uiElement, {
+            canvasTransform: computeCanvasTransform(canvas, uiElement, matrices.htmlElementMVP),
+          });
+        }
+      };
+
+      // Animation loop
+      function render(now) {
+        const dt = Math.min((now - lastTime) / 1000, 0.1);
+        lastTime = now;
+
+        if (isAutoSpinning && !isDragging && !isEditingInput) {
+          // Smooth 3D rotation keeping the front form interactive and facing the viewer
+          const t = now * 0.0011;
+          rotY = Math.sin(t) * 0.42;
+          rotX = Math.cos(t * 0.7) * 0.14;
+        }
+
+        if (hasHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          // Request to update the canvas
+          canvas.requestPaint();
+        } else {
+          // Fallback rendering: draw WebGL 3D coffee box & sync CSS 3D transform on the overlay form
+          const matrices = computeSceneMatrices();
+          drawWebGLBox(matrices);
+          const degY = (rotY * 180) / Math.PI;
+          const degX = (-rotX * 180) / Math.PI;
+          uiElement.style.transform = `rotateX(${degX.toFixed(2)}deg) rotateY(${degY.toFixed(2)}deg) translateZ(26px)`;
+        }
+
+        requestAnimationFrame(render);
+      }
+      requestAnimationFrame(render);
+
+      // Form interactivity & validation following modern web form guidelines
+      let nameEdited = false;
+
+      function validateRecipientName() {
+        const value = recipientInput.value.trim();
+        if (!value) {
+          recipientInput.setCustomValidity('Please enter a name for your coffee box label.');
+          recipientInput.setAttribute('aria-invalid', 'true');
+          nameError.textContent = 'Please enter a name for your coffee box label.';
+          return false;
+        }
+        if (value.length < 2) {
+          recipientInput.setCustomValidity('Box label name must be at least 2 characters.');
+          recipientInput.setAttribute('aria-invalid', 'true');
+          nameError.textContent = 'Box label name must be at least 2 characters.';
+          return false;
+        }
+        recipientInput.setCustomValidity('');
+        recipientInput.removeAttribute('aria-invalid');
+        nameError.textContent = '';
+        return true;
+      }
+
+      // Clear existing errors on input (do not trigger new errors on every keystroke)
+      recipientInput.addEventListener('input', () => {
+        nameEdited = true;
+        if (recipientInput.getAttribute('aria-invalid') === 'true') {
+          validateRecipientName();
+        } else {
+          recipientInput.setCustomValidity('');
+        }
+        submitBtn.disabled = false;
+        orderStatus.textContent = '';
+        needsTextureUpload = true;
+      });
+
+      // Validate on blur if edited
+      recipientInput.addEventListener('blur', () => {
+        if (nameEdited) {
+          validateRecipientName();
+          needsTextureUpload = true;
+        }
+      });
+
+      // Roast profile radio selection updates 3D box colors
+      form.addEventListener('change', (e) => {
+        if (e.target && e.target.name === 'roast_profile') {
+          activePalette = ROAST_PALETTES[e.target.value] || ROAST_PALETTES.medium;
+        }
+        submitBtn.disabled = false;
+        needsTextureUpload = true;
+      });
+
+      // Form submission handler
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        nameEdited = true;
+        if (!validateRecipientName()) {
+          recipientInput.focus();
+          needsTextureUpload = true;
+          return;
+        }
+
+        const formData = new FormData(form);
+        const recipient = formData.get('recipient_name');
+        const roast = formData.get('roast_profile');
+        const grind = formData.get('whole_bean') ? 'Whole Bean' : 'Fresh Ground';
+
+        // Disable submit button after valid submission to prevent double-posts
+        submitBtn.disabled = true;
+        orderStatus.textContent = `Added ${roast} roast (${grind}) box for "${recipient}" to your order!`;
+        needsTextureUpload = true;
+      });
+
+      // Spin & View controls
+      toggleSpinBtn.addEventListener('click', () => {
+        isAutoSpinning = !isAutoSpinning;
+        toggleSpinBtn.setAttribute('aria-pressed', String(isAutoSpinning));
+        toggleSpinBtn.textContent = isAutoSpinning ? 'Pause Spin' : 'Resume Spin';
+        needsTextureUpload = true;
+      });
+
+      resetAngleBtn.addEventListener('click', () => {
+        isAutoSpinning = false;
+        rotX = 0.08;
+        rotY = 0;
+        toggleSpinBtn.setAttribute('aria-pressed', 'false');
+        toggleSpinBtn.textContent = 'Resume Spin';
+        needsTextureUpload = true;
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
