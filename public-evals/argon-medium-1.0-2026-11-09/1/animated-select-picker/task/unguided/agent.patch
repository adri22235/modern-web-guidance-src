+    /* Store Select Dropdown (Customizable Select) */
+    .store-picker {
+      margin-top: 1.25rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .store-picker label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+      color: var(--secondary);
+    }
+
+    select,
+    ::picker(select) {
+      appearance: base-select;
+    }
+
+    select {
+      min-width: 280px;
+      padding: 0.65rem 1rem;
+      font-size: 1rem;
+      font-family: inherit;
+      color: var(--light);
+      background-color: rgba(62, 39, 35, 0.85);
+      border: 1px solid var(--accent);
+      border-radius: 6px;
+      cursor: pointer;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.75rem;
+      backdrop-filter: blur(6px);
+      transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
+    }
+
+    select:hover,
+    select:focus-visible {
+      background-color: rgba(78, 52, 46, 0.95);
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.3);
+      outline: none;
+    }
+
+    select::picker-icon {
+      color: var(--accent);
+      transition: rotate 0.3s ease;
+    }
+
+    select:open::picker-icon {
+      rotate: 180deg;
+    }
+
+    ::picker(select) {
+      margin-top: 0.4rem;
+      padding: 0.35rem;
+      background-color: #ffffff;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
+      opacity: 0;
+      transition: opacity 0.3s ease, display 0.3s ease allow-discrete, overlay 0.3s ease allow-discrete;
+      transition-behavior: allow-discrete;
+    }
+
+    select:open::picker(select),
+    ::picker(select):popover-open {
+      opacity: 1;
+    }
+
+    @starting-style {
+      select:open::picker(select),
+      ::picker(select):popover-open {
+        opacity: 0;
+      }
+    }
+
+    select option {
+      padding: 0.55rem 0.75rem;
+      border-radius: 5px;
+      cursor: pointer;
+      transition: background-color 0.2s ease, color 0.2s ease;
+    }
+
+    select option:hover,
+    select option:focus {
+      background-color: var(--secondary);
+      color: var(--primary);
+    }
+
+    select option:checked {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+    }
+
+    select option::checkmark {
+      color: var(--accent);
+    }
+
