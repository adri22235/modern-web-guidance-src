+  <script>
+    const toggleBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    if (toggleBtn && targetContainer) {
+      toggleBtn.addEventListener('click', () => {
+        const current = getComputedStyle(targetContainer).getPropertyValue('--card-density').trim();
+        const next = current === 'spacious' ? 'compact' : 'spacious';
+        targetContainer.style.setProperty('--card-density', next);
+        const isSpacious = next === 'spacious';
+        toggleBtn.setAttribute('aria-pressed', String(isSpacious));
+        toggleBtn.textContent = isSpacious ? 'Compact View' : 'Spacious View';
+      });
+    }
+  </script>
