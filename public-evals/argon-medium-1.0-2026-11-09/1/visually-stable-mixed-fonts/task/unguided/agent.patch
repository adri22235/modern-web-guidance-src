diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,71 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Modern CSS Typography: Optical Font Normalization</title>
+  <link rel="stylesheet" href="styles.css" />
+  <style>
+    /* Automatic optical height normalization across mixed font families */
+    #mixed-fonts-container {
+      font-family: Georgia, "Times New Roman", Times, serif;
+      font-size: 1.125rem;
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Consolas, "Liberation Mono", Menlo, monospace;
+    }
+
+    /* Independent theme container with explicit numeric metric override */
+    #independent-theme-container {
+      font-family: Verdana, Geneva, Tahoma, sans-serif;
+      font-size: 1.125rem;
+      font-size-adjust: 0.52;
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Consolas, "Liberation Mono", Menlo, monospace;
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Optical Font Size Normalization</h1>
+      <p>Harmonizing visual x-height across mixed typography and independent themes with modern CSS.</p>
+    </header>
+
+    <section id="mixed-fonts-container">
+      <h2>Mixed Font Families (Automatic Normalization)</h2>
+      <p>
+        When prose written in a serif typeface embeds inline code snippets such as
+        <code>const aspectValue = getFontMetrics(primaryFont);</code> or
+        <code>font-size-adjust: from-font</code>, differing x-heights between font
+        families can make inline code appear disproportionately large or small.
+      </p>
+      <p>
+        Applying automatic normalization on this container ensures that regular body text
+        and inline tokens like <code>Array.prototype.map()</code>,
+        <code>document.querySelector('#mixed-fonts-container')</code>, and
+        <code>window.getComputedStyle(element)</code> share a unified optical height.
+      </p>
+    </section>
+
+    <section id="independent-theme-container">
+      <h2>Independent Theme Container (Numeric Metric Override)</h2>
+      <p>
+        This standalone themed block locks down its visual proportions using an explicit
+        numeric metric override (<code>font-size-adjust: 0.52</code>), ensuring consistent
+        x-height rendering regardless of which fallback font is active.
+      </p>
+      <p>
+        Even when mixing theme typography with inline technical references like
+        <code>themeConfig.lockProportions(0.52)</code> and
+        <code>@supports (font-size-adjust: 0.52)</code>, the visual rhythm and vertical
+        density remain strictly controlled.
+      </p>
+    </section>
+  </main>
+</body>
+</html>
