diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,176 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Visually Stable Mixed Fonts &amp; Independent Theme Proportions</title>
+  <style>
+    :root {
+      color-scheme: light dark;
+      --bg-surface: #f8fafc;
+      --bg-card: #ffffff;
+      --bg-theme-card: #fdfaf6;
+      --bg-code: #e2e8f0;
+      --text-primary: #0f172a;
+      --text-secondary: #475569;
+      --border-subtle: #cbd5e1;
+      --accent-color: #2563eb;
+    }
+
+    @media (prefers-color-scheme: dark) {
+      :root {
+        --bg-surface: #0f172a;
+        --bg-card: #1e293b;
+        --bg-theme-card: #1c1917;
+        --bg-code: #334155;
+        --text-primary: #f8fafc;
+        --text-secondary: #cbd5e1;
+        --border-subtle: #334155;
+        --accent-color: #60a5fa;
+      }
+    }
+
+    *,
+    *::before,
+    *::after {
+      box-sizing: border-box;
+    }
+
+    body {
+      margin: 0;
+      padding: 2rem 1.25rem;
+      background-color: var(--bg-surface);
+      color: var(--text-primary);
+      font-family: system-ui, -apple-system, sans-serif;
+      font-size: 1rem;
+      line-height: 1.5;
+      text-align: start;
+      overflow-wrap: break-word;
+    }
+
+    main {
+      max-width: 65ch;
+      margin-inline: auto;
+      display: grid;
+      gap: 2rem;
+    }
+
+    header h1 {
+      font-size: clamp(1.5rem, 1.1rem + 2vw, 2.25rem);
+      line-height: 1.25;
+      margin-block: 0 0.5rem;
+      text-wrap: balance;
+    }
+
+    header p {
+      margin-block: 0;
+      color: var(--text-secondary);
+      max-width: 60ch;
+      text-wrap: pretty;
+    }
+
+    .card {
+      background-color: var(--bg-card);
+      border: 0.0625rem solid var(--border-subtle);
+      border-radius: 0.75rem;
+      padding: 1.5rem;
+    }
+
+    .card h2 {
+      font-size: clamp(1.2rem, 1rem + 1vw, 1.5rem);
+      line-height: 1.3;
+      margin-block: 0 0.75rem;
+      text-wrap: balance;
+    }
+
+    .card p {
+      margin-block: 0 1rem;
+      max-width: 60ch;
+      text-wrap: pretty;
+    }
+
+    .card p:last-child {
+      margin-block-end: 0;
+    }
+
+    /* Mixed fonts container: automatically normalizes x-height across nested fonts */
+    #mixed-fonts-container {
+      font-family: Verdana, Geneva, Tahoma, sans-serif;
+      font-size: 1rem;
+      line-height: 1.6;
+      font-size-adjust: from-font;
+    }
+
+    #mixed-fonts-container code {
+      font-family: "Courier New", Courier, Consolas, monospace;
+      background-color: var(--bg-code);
+      padding: 0.125em 0.375em;
+      border-radius: 0.25rem;
+    }
+
+    /* Independent theme container: locks down visual proportions with a specific numeric aspect-ratio override */
+    #independent-theme-container {
+      background-color: var(--bg-theme-card);
+      font-family: "Times New Roman", Times, Georgia, serif;
+      font-size: 1rem;
+      line-height: 1.6;
+      font-size-adjust: 0.51;
+    }
+
+    #independent-theme-container code {
+      font-family: "Courier New", Courier, Consolas, monospace;
+      background-color: var(--bg-code);
+      padding: 0.125em 0.375em;
+      border-radius: 0.25rem;
+    }
+
+    /* Fallback for browsers that do not support font-size-adjust */
+    @supports not (font-size-adjust: from-font) {
+      #mixed-fonts-container {
+        font-size: 1rem;
+        line-height: 1.65;
+      }
+
+      #mixed-fonts-container code {
+        font-size: 1.12em;
+        line-height: 1.5;
+      }
+
+      #independent-theme-container {
+        font-size: 1.14rem;
+        line-height: 1.65;
+      }
+    }
+  </style>
+</head>
+<body>
+  <main>
+    <header>
+      <h1>Optical Font Normalization with Modern CSS</h1>
+      <p>
+        Keeping lowercase letter heights (x-heights) visually consistent across mixed typefaces and independent themes prevents jarring size discrepancies and improves reading flow.
+      </p>
+    </header>
+
+    <section id="mixed-fonts-container" class="card" aria-labelledby="mixed-fonts-heading">
+      <h2 id="mixed-fonts-heading">Mixed Font Families (Automatic Normalization)</h2>
+      <p>
+        When embedding inline code snippets such as <code>font-size-adjust: from-font</code> or calling <code>window.getComputedStyle(element)</code> inside regular prose, the monospace typeface often has a smaller x-height than the surrounding body font.
+      </p>
+      <p>
+        By declaring <code>font-size-adjust: from-font</code> on <code>#mixed-fonts-container</code>, the browser automatically extracts the primary font's x-height ratio and scales nested <code>&lt;code&gt;</code> elements to match its optical height seamlessly.
+      </p>
+    </section>
+
+    <section id="independent-theme-container" class="card" aria-labelledby="independent-theme-heading">
+      <h2 id="independent-theme-heading">Independent Theme Container (Numeric Metric Override)</h2>
+      <p>
+        This editorial callout uses an independent serif typeface family (<code>Times New Roman</code> / <code>Times</code>) that is not inheriting its primary font from a parent prose block.
+      </p>
+      <p>
+        Applying a specific numeric metric override with <code>font-size-adjust: 0.51</code> locks the container's x-height aspect ratio (x-height divided by font-size) so its visual proportions remain consistent with the primary UI typography.
+      </p>
+    </section>
+  </main>
+</body>
+</html>
