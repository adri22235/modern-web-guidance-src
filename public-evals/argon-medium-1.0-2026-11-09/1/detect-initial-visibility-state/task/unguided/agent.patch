+  <script>
+    (function checkInitialBackgroundLoad() {
+      const visibilityEntries =
+        typeof performance !== 'undefined' &&
+        typeof performance.getEntriesByType === 'function'
+          ? performance.getEntriesByType('visibility-state')
+          : [];
+
+      const initialEntry = visibilityEntries[0];
+      const note =
+        'Older fallback checks (such as document.visibilityState or document.hidden) only inspect current state and are unreliable for async or deferred scripts if the tab visibility changed after initial page load.';
+
+      if (initialEntry) {
+        const backgrounded = initialEntry.name === 'hidden';
+        const timestamp = initialEntry.startTime;
+
+        console.log({
+          backgrounded,
+          timestamp,
+          note
+        });
+      } else {
+        const backgrounded =
+          document.visibilityState === 'hidden' || Boolean(document.hidden);
+        const timestamp =
+          typeof performance !== 'undefined' && typeof performance.now === 'function'
+            ? performance.now()
+            : Date.now();
+
+        console.log({
+          backgrounded,
+          timestamp,
+          note
+        });
+      }
+    })();
+  </script>
