+  <script>
+    /**
+     * Accurately determines visibility state history using the Performance API
+     * (VisibilityStateEntry), which records visibility changes on the browser's
+     * performance timeline regardless of when the script executes.
+     */
+    function getVisibilityInfo() {
+      const entries = performance.getEntriesByType('visibility-state');
+
+      if (entries.length > 0) {
+        const firstEntry = entries[0];
+        const initiallyBackgrounded = firstEntry.name === 'hidden';
+
+        let timeBackgrounded = null;
+        for (const entry of entries) {
+          if (entry.name === 'hidden') {
+            timeBackgrounded = entry.startTime;
+            break;
+          }
+        }
+
+        return {
+          initiallyBackgrounded,
+          backgrounded: initiallyBackgrounded,
+          timeBackgrounded,
+          timestamp: timeBackgrounded ?? firstEntry.startTime,
+          note: 'Measured via VisibilityStateEntry on the performance timeline (immune to async script load race conditions).'
+        };
+      }
+
+      return null;
+    }
+
+    /**
+     * Fallback implementation using document.visibilityState and visibilitychange.
+     * Prone to race conditions if the script loads asynchronously.
+     */
+    function getFallbackVisibilityInfo() {
+      let initiallyBackgrounded = document.visibilityState === 'hidden';
+      let timeBackgrounded = initiallyBackgrounded ? 0 : null;
+      const fallbackNote =
+        'Fallback check using document.visibilityState is unreliable for async scripts: if the tab opened in the background and was foregrounded before this script executed, document.visibilityState synchronously reads as "visible", missing the initial hidden state, and performance.now() lacks the internal browser timestamp precision of VisibilityStateEntry.startTime.';
+
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden' && timeBackgrounded === null) {
+          timeBackgrounded = performance.now();
+        }
+      });
+
+      return {
+        get initiallyBackgrounded() {
+          return initiallyBackgrounded;
+        },
+        get backgrounded() {
+          return initiallyBackgrounded;
+        },
+        get timeBackgrounded() {
+          return timeBackgrounded;
+        },
+        get timestamp() {
+          return timeBackgrounded ?? performance.now();
+        },
+        note: fallbackNote
+      };
+    }
+
+    let visibilityReport;
+    if ('VisibilityStateEntry' in window) {
+      visibilityReport = getVisibilityInfo() ?? getFallbackVisibilityInfo();
+    } else {
+      visibilityReport = getFallbackVisibilityInfo();
+    }
+
+    console.log({
+      initiallyBackgrounded: visibilityReport.initiallyBackgrounded,
+      backgrounded: visibilityReport.backgrounded,
+      timeBackgrounded: visibilityReport.timeBackgrounded,
+      timestamp: visibilityReport.timestamp,
+      note: visibilityReport.note
+    });
+  </script>
+
 </body>
 
