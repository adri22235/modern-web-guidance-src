+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const defaultConfig = {
+        defaultDrink: 'Maple Oat Latte',
+        pickupLocation: 'downtown',
+        preserveShortcuts: true,
+        shortcuts: ['/order-online', '/menu', '/rewards', '/account']
+      };
+
+      function loadConfig() {
+        try {
+          const params = new URLSearchParams(window.location.search);
+          const migrated = params.get('migrated_config');
+          if (migrated) {
+            const parsed = JSON.parse(atob(migrated));
+            localStorage.setItem(STORAGE_KEY, JSON.stringify(parsed));
+            return parsed;
+          }
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) return Object.assign({}, defaultConfig, JSON.parse(raw));
+        } catch (err) {
+          console.warn('Failed to parse user config:', err);
+        }
+        localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultConfig));
+        return defaultConfig;
+      }
+
+      function updateTransferLink(config) {
+        const link = document.getElementById('transfer-origin-link');
+        if (!link) return;
+        try {
+          const encoded = btoa(JSON.stringify(config));
+          link.href = 'https://app.dailygrind.example.com/?migrated_config=' + encodeURIComponent(encoded);
+        } catch (_) {}
+      }
+
+      const config = loadConfig();
+      const drinkEl = document.getElementById('pref-drink');
+      const locEl = document.getElementById('pref-location');
+      const shortcutsEl = document.getElementById('pref-shortcuts');
+      const statusEl = document.getElementById('migration-status');
+      const saveBtn = document.getElementById('save-config-btn');
+
+      if (drinkEl) drinkEl.value = config.defaultDrink;
+      if (locEl) locEl.value = config.pickupLocation;
+      if (shortcutsEl) shortcutsEl.checked = Boolean(config.preserveShortcuts);
+      updateTransferLink(config);
+
+      if (saveBtn) {
+        saveBtn.addEventListener('click', function () {
+          const updated = {
+            defaultDrink: drinkEl ? drinkEl.value : defaultConfig.defaultDrink,
+            pickupLocation: locEl ? locEl.value : defaultConfig.pickupLocation,
+            preserveShortcuts: shortcutsEl ? shortcutsEl.checked : true,
+            shortcuts: defaultConfig.shortcuts,
+            updatedAt: new Date().toISOString()
+          };
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
+          updateTransferLink(updated);
+          if (statusEl) statusEl.textContent = 'Configuration saved and ready for origin migration.';
+        });
+      }
+
+      window.addEventListener('message', function (event) {
+        if (event.data && event.data.type === 'MIGRATE_USER_CONFIG' && event.data.config) {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(event.data.config));
+          updateTransferLink(event.data.config);
+        }
+      });
+
+      if ('serviceWorker' in navigator) {
+        window.addEventListener('load', function () {
+          navigator.serviceWorker.register('/sw.js').catch(function () {});
+        });
+      }
+    })();
+  </script>
