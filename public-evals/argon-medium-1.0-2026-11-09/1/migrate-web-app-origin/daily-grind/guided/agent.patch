+  <script type="module">
+    const OLD_APP_ORIGIN_URL = 'https://old-app.dailygrind.com';
+    const NEW_APP_ORIGIN_URL = 'https://new-app.dailygrind.com';
+    const NEW_APP_INSTALL_URL = 'https://new-app.dailygrind.com/index.html';
+    const REGISTRABLE_DOMAIN = 'dailygrind.com';
+    const CONFIG_STORAGE_KEY = 'dailyGrindUserConfig';
+    const ALLOWED_ROASTS = new Set(['medium', 'dark', 'light']);
+    const ALLOWED_MILKS = new Set(['oat', 'whole', 'almond', 'black']);
+    const ALLOWED_STORES = new Set(['downtown', 'riverside', 'uptown']);
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    function checkSameOriginWithFallback(candidate, trustedOriginUrl) {
+      try {
+        if ('Origin' in globalThis) {
+          return extractOrigin(candidate).isSameOrigin(Origin.from(trustedOriginUrl));
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(trustedOriginUrl);
+        return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedUrl.origin;
+      } catch {
+        return false;
+      }
+    }
+
+    function checkSameSiteWithFallback(candidate, trustedOriginUrl = NEW_APP_ORIGIN_URL) {
+      try {
+        if ('Origin' in globalThis) {
+          return extractOrigin(candidate).isSameSite(Origin.from(trustedOriginUrl));
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(trustedOriginUrl);
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.protocol === trustedUrl.protocol &&
+          (candidateUrl.hostname === REGISTRABLE_DOMAIN ||
+            candidateUrl.hostname.endsWith(`.${REGISTRABLE_DOMAIN}`))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    function isTrustedMigrationOrigin(candidate) {
+      return (
+        checkSameOriginWithFallback(candidate, OLD_APP_ORIGIN_URL) ||
+        checkSameOriginWithFallback(candidate, NEW_APP_ORIGIN_URL)
+      );
+    }
+
+    function sanitizeUserConfig(raw) {
+      if (!raw || typeof raw !== 'object') return null;
+      const roast = ALLOWED_ROASTS.has(raw.roast) ? raw.roast : 'medium';
+      const milk = ALLOWED_MILKS.has(raw.milk) ? raw.milk : 'oat';
+      const store = ALLOWED_STORES.has(raw.store) ? raw.store : 'downtown';
+      const updatedAt = typeof raw.updatedAt === 'number' ? raw.updatedAt : Date.now();
+      return { roast, milk, store, updatedAt };
+    }
+
+    function loadLocalConfig() {
+      try {
+        const stored = localStorage.getItem(CONFIG_STORAGE_KEY);
+        if (!stored) return { roast: 'medium', milk: 'oat', store: 'downtown', updatedAt: 0 };
+        return sanitizeUserConfig(JSON.parse(stored)) ?? { roast: 'medium', milk: 'oat', store: 'downtown', updatedAt: 0 };
+      } catch {
+        return { roast: 'medium', milk: 'oat', store: 'downtown', updatedAt: 0 };
+      }
+    }
+
+    function saveLocalConfig(config) {
+      const clean = sanitizeUserConfig(config);
+      if (!clean) return null;
+      try {
+        localStorage.setItem(CONFIG_STORAGE_KEY, JSON.stringify(clean));
+      } catch {
+        // Ignore storage quota errors
+      }
+      return clean;
+    }
+
+    function renderConfigToForm(config) {
+      const roastSelect = document.getElementById('roast-pref');
+      const milkSelect = document.getElementById('milk-pref');
+      const storeSelect = document.getElementById('store-pref');
+      if (roastSelect && ALLOWED_ROASTS.has(config.roast)) roastSelect.value = config.roast;
+      if (milkSelect && ALLOWED_MILKS.has(config.milk)) milkSelect.value = config.milk;
+      if (storeSelect && ALLOWED_STORES.has(config.store)) storeSelect.value = config.store;
+    }
+
+    function setStatusMessage(message) {
+      const statusEl = document.getElementById('config-status');
+      if (statusEl) {
+        statusEl.textContent = message;
+      }
+    }
+
+    // Server-side synchronization for preserving user configuration across origins
+    async function syncConfigWithServer(config) {
+      try {
+        const response = await fetch('/api/user-config', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'include',
+          body: JSON.stringify(config),
+        });
+        if (response.ok) {
+          const remoteConfig = sanitizeUserConfig(await response.json());
+          if (remoteConfig && remoteConfig.updatedAt >= config.updatedAt) {
+            saveLocalConfig(remoteConfig);
+            renderConfigToForm(remoteConfig);
+          }
+          return true;
+        }
+      } catch {
+        // Server sync endpoint is optional in static environments; fall back to cross-origin messaging
+      }
+      return false;
+    }
+
+    // Cross-origin messaging handler to transfer user configuration between old and new origins
+    window.addEventListener('message', (event) => {
+      if (!isTrustedMigrationOrigin(event) || !checkSameSiteWithFallback(event)) return;
+
+      const payload = event.data;
+      if (!payload || typeof payload !== 'object') return;
+
+      if (payload.type === 'DAILY_GRIND_REQUEST_CONFIG') {
+        const currentConfig = loadLocalConfig();
+        const targetOrigin = checkSameOriginWithFallback(event, OLD_APP_ORIGIN_URL)
+          ? OLD_APP_ORIGIN_URL
+          : NEW_APP_ORIGIN_URL;
+        event.source?.postMessage(
+          { type: 'DAILY_GRIND_SYNC_CONFIG', config: currentConfig },
+          targetOrigin
+        );
+      } else if (payload.type === 'DAILY_GRIND_SYNC_CONFIG') {
+        const incomingConfig = sanitizeUserConfig(payload.config);
+        const localConfig = loadLocalConfig();
+        if (incomingConfig && incomingConfig.updatedAt >= localConfig.updatedAt) {
+          saveLocalConfig(incomingConfig);
+          renderConfigToForm(incomingConfig);
+          setStatusMessage('Configuration migrated from previous app origin.');
+        }
+      }
+    });
+
+    // Import configuration from URL hash fragment if navigated via manual migration fallback banner
+    function importConfigFromMigrationHash() {
+      if (!window.location.hash.startsWith('#migrate-config=')) return;
+      try {
+        const encoded = window.location.hash.slice('#migrate-config='.length);
+        const decoded = JSON.parse(decodeURIComponent(encoded));
+        const migrated = sanitizeUserConfig(decoded);
+        if (migrated) {
+          saveLocalConfig(migrated);
+          renderConfigToForm(migrated);
+          setStatusMessage('Preferences restored on the new app origin.');
+          history.replaceState(null, '', window.location.pathname + window.location.search);
+        }
+      } catch {
+        // Ignore malformed hash
+      }
+    }
+
+    function updateMigrationLinkWithConfig(config) {
+      const migrationLink = document.getElementById('migration-link');
+      if (!migrationLink) return;
+      if (checkSameSiteWithFallback(NEW_APP_INSTALL_URL, OLD_APP_ORIGIN_URL)) {
+        const url = new URL(NEW_APP_INSTALL_URL);
+        url.hash = `migrate-config=${encodeURIComponent(JSON.stringify(config))}`;
+        migrationLink.href = url.toString();
+      }
+    }
+
+    // Initialize configuration UI and migration controls
+    const initialConfig = loadLocalConfig();
+    renderConfigToForm(initialConfig);
+    importConfigFromMigrationHash();
+    updateMigrationLinkWithConfig(loadLocalConfig());
+
+    // If opened from the old origin window, request configuration handover via postMessage
+    if (window.opener && checkSameSiteWithFallback( NEW_APP_ORIGIN_URL, OLD_APP_ORIGIN_URL )) {
+      window.opener.postMessage({ type: 'DAILY_GRIND_REQUEST_CONFIG' }, OLD_APP_ORIGIN_URL);
+    }
+
+    const configForm = document.getElementById('user-config-form');
+    configForm?.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const formData = new FormData(configForm);
+      const updated = saveLocalConfig({
+        roast: formData.get('roast'),
+        milk: formData.get('milk'),
+        store: formData.get('store'),
+        updatedAt: Date.now(),
+      });
+      if (updated) {
+        updateMigrationLinkWithConfig(updated);
+        await syncConfigWithServer(updated);
+        setStatusMessage('Configuration saved locally and queued for origin migration.');
+      }
+    });
+
+    const syncBtn = document.getElementById('sync-config-btn');
+    syncBtn?.addEventListener('click', async () => {
+      const current = loadLocalConfig();
+      updateMigrationLinkWithConfig(current);
+      await syncConfigWithServer(current);
+      setStatusMessage('Preferences prepared for transfer to https://new-app.dailygrind.com.');
+    });
+
+    const dismissBtn = document.getElementById('dismiss-migration-btn');
+    const banner = document.getElementById('migration-banner');
+    if (checkSameOriginWithFallback(globalThis, NEW_APP_ORIGIN_URL)) {
+      banner?.setAttribute('hidden', '');
+    }
+    dismissBtn?.addEventListener('click', () => {
+      banner?.setAttribute('hidden', '');
+    });
+  </script>
 </body>
 
