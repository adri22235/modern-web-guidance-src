+
+  <script>
+    (function () {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel ? panel.querySelector('[data-drag-handle]') : null;
+
+      if (panel && handle) {
+        let isDragging = false;
+        let startX = 0;
+        let startY = 0;
+        let initialLeft = 0;
+        let initialTop = 0;
+
+        function ensureExplicitPosition() {
+          const rect = panel.getBoundingClientRect();
+          panel.style.left = rect.left + 'px';
+          panel.style.top = rect.top + 'px';
+          panel.style.right = 'auto';
+          panel.style.bottom = 'auto';
+          panel.style.transform = 'none';
+        }
+
+        ensureExplicitPosition();
+
+        function beginDrag(clientX, clientY, target, button) {
+          if (typeof button === 'number' && button !== 0) return;
+          if (!handle.contains(target)) return;
+          if (target.closest('button, input, select, textarea, a')) return;
+
+          if (!isDragging) {
+            const rect = panel.getBoundingClientRect();
+            initialLeft = rect.left;
+            initialTop = rect.top;
+            startX = clientX;
+            startY = clientY;
+            isDragging = true;
+            panel.classList.add('is-dragging');
+            panel.setAttribute('data-dragging', 'true');
+          }
+        }
+
+        function updateDrag(clientX, clientY) {
+          if (!isDragging) return;
+          const dx = clientX - startX;
+          const dy = clientY - startY;
+          const nextLeft = initialLeft + dx;
+          const nextTop = initialTop + dy;
+
+          panel.style.left = nextLeft + 'px';
+          panel.style.top = nextTop + 'px';
+          panel.style.right = 'auto';
+          panel.style.bottom = 'auto';
+        }
+
+        function endDrag() {
+          if (!isDragging) return;
+          isDragging = false;
+          panel.classList.remove('is-dragging');
+          panel.removeAttribute('data-dragging');
+        }
+
+        handle.addEventListener('mousedown', function (e) {
+          beginDrag(e.clientX, e.clientY, e.target, e.button);
+          if (isDragging) {
+            e.preventDefault();
+          }
+        });
+
+        handle.addEventListener('pointerdown', function (e) {
+          beginDrag(e.clientX, e.clientY, e.target, e.button);
+        });
+
+        handle.addEventListener('touchstart', function (e) {
+          if (e.touches && e.touches.length > 0) {
+            beginDrag(e.touches[0].clientX, e.touches[0].clientY, e.target, 0);
+          }
+        }, { passive: true });
+
+        window.addEventListener('mousemove', function (e) {
+          updateDrag(e.clientX, e.clientY);
+        });
+
+        window.addEventListener('pointermove', function (e) {
+          updateDrag(e.clientX, e.clientY);
+        });
+
+        window.addEventListener('touchmove', function (e) {
+          if (isDragging && e.touches && e.touches.length > 0) {
+            updateDrag(e.touches[0].clientX, e.touches[0].clientY);
+          }
+        }, { passive: true });
+
+        window.addEventListener('mouseup', endDrag);
+        window.addEventListener('pointerup', endDrag);
+        window.addEventListener('pointercancel', endDrag);
+        window.addEventListener('touchend', endDrag);
+      }
+
+      // Interactive Quick-Order Cart Logic
+      const drinkSelect = document.getElementById('quick-drink-select');
+      const milkSelect = document.getElementById('quick-milk-select');
+      const sizeBtns = Array.from(document.querySelectorAll('.size-btn'));
+      const addBtn = document.getElementById('quick-add-btn');
+      const cartList = document.getElementById('cart-items-list');
+      const cartTotalEl = document.getElementById('cart-total');
+      const cartCountEl = document.getElementById('cart-count');
+      const checkoutBtn = document.getElementById('quick-checkout-btn');
+      const statusEl = document.getElementById('quick-order-status');
+
+      let selectedSize = 'Medium';
+      let selectedUpcharge = 0.5;
+
+      const cart = [
+        {
+          id: 'Maple Oat Latte|Medium|Oat Milk',
+          name: 'Maple Oat Latte',
+          size: 'Medium',
+          milk: 'Oat Milk',
+          unitPrice: 6.0,
+          qty: 1
+        }
+      ];
+
+      sizeBtns.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          sizeBtns.forEach(function (b) {
+            b.classList.remove('active');
+          });
+          btn.classList.add('active');
+          selectedSize = btn.getAttribute('data-size') || 'Medium';
+          selectedUpcharge = parseFloat(btn.getAttribute('data-upcharge') || '0');
+        });
+      });
+
+      function renderCart() {
+        cartList.innerHTML = '';
+        let total = 0;
+        let totalItems = 0;
+
+        if (cart.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-item';
+          emptyLi.textContent = 'Your coffee cart is empty.';
+          cartList.appendChild(emptyLi);
+        } else {
+          cart.forEach(function (item, idx) {
+            total += item.unitPrice * item.qty;
+            totalItems += item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+
+            const info = document.createElement('div');
+            info.className = 'cart-item-info';
+
+            const nameSpan = document.createElement('span');
+            nameSpan.className = 'cart-item-name';
+            nameSpan.textContent = item.name + ' ($' + (item.unitPrice * item.qty).toFixed(2) + ')';
+
+            const metaSpan = document.createElement('span');
+            metaSpan.className = 'cart-item-meta';
+            metaSpan.textContent = item.size + ' • ' + item.milk;
+
+            info.appendChild(nameSpan);
+            info.appendChild(metaSpan);
+
+            const controls = document.createElement('div');
+            controls.className = 'qty-controls';
+
+            const decBtn = document.createElement('button');
+            decBtn.type = 'button';
+            decBtn.className = 'qty-btn';
+            decBtn.setAttribute('aria-label', 'Decrease quantity of ' + item.name);
+            decBtn.textContent = '-';
+            decBtn.addEventListener('click', function () {
+              if (item.qty > 1) {
+                item.qty -= 1;
+              } else {
+                cart.splice(idx, 1);
+              }
+              statusEl.textContent = '';
+              renderCart();
+            });
+
+            const qtySpan = document.createElement('span');
+            qtySpan.className = 'item-qty';
+            qtySpan.textContent = String(item.qty);
+
+            const incBtn = document.createElement('button');
+            incBtn.type = 'button';
+            incBtn.className = 'qty-btn';
+            incBtn.setAttribute('aria-label', 'Increase quantity of ' + item.name);
+            incBtn.textContent = '+';
+            incBtn.addEventListener('click', function () {
+              item.qty += 1;
+              statusEl.textContent = '';
+              renderCart();
+            });
+
+            controls.appendChild(decBtn);
+            controls.appendChild(qtySpan);
+            controls.appendChild(incBtn);
+
+            li.appendChild(info);
+            li.appendChild(controls);
+            cartList.appendChild(li);
+          });
+        }
+
+        cartTotalEl.textContent = '$' + total.toFixed(2);
+        cartCountEl.textContent = String(totalItems);
+      }
+
+      if (addBtn) {
+        addBtn.addEventListener('click', function () {
+          const selectedOpt = drinkSelect.options[drinkSelect.selectedIndex];
+          const name = drinkSelect.value;
+          const basePrice = parseFloat(selectedOpt.getAttribute('data-price') || '4.50');
+          const milk = milkSelect.value;
+          const unitPrice = basePrice + selectedUpcharge;
+          const key = name + '|' + selectedSize + '|' + milk;
+
+          const existing = cart.find(function (c) {
+            return c.id === key;
+          });
+          if (existing) {
+            existing.qty += 1;
+          } else {
+            cart.push({
+              id: key,
+              name: name,
+              size: selectedSize,
+              milk: milk,
+              unitPrice: unitPrice,
+              qty: 1
+            });
+          }
+          statusEl.textContent = 'Added ' + selectedSize + ' ' + name + '!';
+          renderCart();
+        });
+      }
+
+      if (checkoutBtn) {
+        checkoutBtn.addEventListener('click', function () {
+          if (cart.length === 0) {
+            statusEl.textContent = 'Add a drink before ordering!';
+            return;
+          }
+          const count = cart.reduce(function (sum, item) {
+            return sum + item.qty;
+          }, 0);
+          statusEl.textContent = 'Order placed for ' + count + ' item(s)! Ready in ~5 mins.';
+        });
+      }
+
+      renderCart();
+    })();
+  </script>
+
 </body>
 
