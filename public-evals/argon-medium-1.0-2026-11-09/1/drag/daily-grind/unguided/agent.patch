+        <select id="quick-milk-select" name="milk">
+          <option value="Oat Milk">Oat Milk</option>
+          <option value="Whole Milk">Whole Milk</option>
+          <option value="Almond Milk">Almond Milk</option>
+          <option value="No Milk (Black)">No Milk (Black)</option>
+        </select>
+      </div>
+
+      <button type="button" id="quick-add-btn" class="add-item-btn">
+        + Add to Coffee Cart
+      </button>
+
+      <ul id="cart-items-list" class="cart-items" aria-label="Cart Items"></ul>
+
+      <div class="cart-footer">
+        <div class="cart-summary-row">
+          <span>Total</span>
+          <span id="cart-total">$6.00</span>
+        </div>
