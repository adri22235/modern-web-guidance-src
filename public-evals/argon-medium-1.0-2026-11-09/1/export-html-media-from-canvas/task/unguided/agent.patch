+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const messageInput = document.getElementById('card-message-input');
+      const nameInput = document.getElementById('card-name-input');
+      const bgColorInput = document.getElementById('card-bg-color');
+      const exportBtn = document.getElementById('export-card-btn');
+      const messageDisplay = document.getElementById('card-message-display');
+      const nameDisplay = document.getElementById('card-name-display');
+      const swatches = document.querySelectorAll('.color-swatch');
+
+      function drawRoundedRect(context, x, y, width, height, radius) {
+        context.beginPath();
+        context.moveTo(x + radius, y);
+        context.lineTo(x + width - radius, y);
+        context.quadraticCurveTo(x + width, y, x + width, y + radius);
+        context.lineTo(x + width, y + height - radius);
+        context.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
+        context.lineTo(x + radius, y + height);
+        context.quadraticCurveTo(x, y + height, x, y + height - radius);
+        context.lineTo(x, y + radius);
+        context.quadraticCurveTo(x, y, x + radius, y);
+        context.closePath();
+      }
+
+      function wrapCanvasText(context, text, x, y, maxWidth, lineHeight) {
+        const words = String(text || '').split(/\s+/);
+        let line = '';
+        let currentY = y;
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line ? line + ' ' + words[i] : words[i];
+          const metrics = context.measureText(testLine);
+          if (metrics.width > maxWidth && i > 0) {
+            context.fillText(line, x, currentY);
+            line = words[i];
+            currentY += lineHeight;
+          } else {
+            line = testLine;
+          }
+        }
+        if (line) {
+          context.fillText(line, x, currentY);
+        }
+      }
+
+      function drawCardFallback(targetCtx, width, height) {
+        const bgColor = exportElement.style.backgroundColor || bgColorInput.value || '#4e342e';
+        const messageText = (messageDisplay && messageDisplay.isConnected)
+          ? messageDisplay.textContent
+          : (messageInput.value || exportElement.textContent || '');
+        const nameText = (nameDisplay && nameDisplay.isConnected)
+          ? nameDisplay.textContent
+          : (nameInput.value || '');
+
+        targetCtx.clearRect(0, 0, width, height);
+
+        // Card background
+        targetCtx.save();
+        drawRoundedRect(targetCtx, 0, 0, width, height, 16);
+        targetCtx.fillStyle = bgColor;
+        targetCtx.fill();
+
+        // Card border
+        targetCtx.lineWidth = 4;
+        targetCtx.strokeStyle = 'rgba(255, 171, 64, 0.45)';
+        targetCtx.stroke();
+
+        // Decorative background circle
+        targetCtx.beginPath();
+        targetCtx.arc(width - 50, height - 40, 110, 0, Math.PI * 2);
+        targetCtx.fillStyle = 'rgba(255, 255, 255, 0.05)';
+        targetCtx.fill();
+
+        // Header brand text
+        targetCtx.fillStyle = '#ffab40';
+        targetCtx.font = 'bold 18px "Segoe UI", Tahoma, sans-serif';
+        targetCtx.textBaseline = 'middle';
+        targetCtx.fillText('\u2615 THE DAILY GRIND', 32, 46);
+
+        // Gift badge
+        const badgeX = width - 130;
+        const badgeY = 28;
+        drawRoundedRect(targetCtx, badgeX, badgeY, 98, 32, 16);
+        targetCtx.fillStyle = 'rgba(255, 171, 64, 0.2)';
+        targetCtx.fill();
+        targetCtx.lineWidth = 1.5;
+        targetCtx.strokeStyle = '#ffab40';
+        targetCtx.stroke();
+        targetCtx.fillStyle = '#ffab40';
+        targetCtx.font = 'bold 14px "Segoe UI", Tahoma, sans-serif';
+        targetCtx.fillText('$25 GIFT', badgeX + 18, badgeY + 16);
+
+        // Header divider
+        targetCtx.beginPath();
+        targetCtx.moveTo(32, 74);
+        targetCtx.lineTo(width - 32, 74);
+        targetCtx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        targetCtx.lineWidth = 1;
+        targetCtx.stroke();
+
+        // Main custom message
+        targetCtx.fillStyle = '#ffffff';
+        targetCtx.font = '600 24px "Segoe UI", Tahoma, sans-serif';
+        targetCtx.textBaseline = 'top';
+        wrapCanvasText(targetCtx, messageText, 32, 118, width - 64, 34);
+
+        // Footer divider
+        targetCtx.beginPath();
+        targetCtx.moveTo(32, height - 68);
+        targetCtx.lineTo(width - 32, height - 68);
+        targetCtx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        targetCtx.lineWidth = 1;
+        targetCtx.stroke();
+
+        // Footer recipient/sender name
+        targetCtx.fillStyle = '#ffecb3';
+        targetCtx.font = '600 17px "Segoe UI", Tahoma, sans-serif';
+        targetCtx.textBaseline = 'alphabetic';
+        targetCtx.fillText(nameText, 32, height - 34);
+
+        // Footer tag
+        targetCtx.fillStyle = 'rgba(255, 255, 255, 0.85)';
+        targetCtx.font = '12px "Segoe UI", Tahoma, sans-serif';
+        targetCtx.textAlign = 'right';
+        targetCtx.fillText('ARTISANAL COFFEE CARD', width - 32, height - 34);
+
+        targetCtx.restore();
+      }
+
+      function renderCanvas() {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        let renderedViaElementAPI = false;
+
+        try {
+          if (typeof ctx.drawElementImage === 'function') {
+            ctx.drawElementImage(exportElement, 0, 0);
+            renderedViaElementAPI = true;
+          } else if (typeof ctx.drawElement === 'function') {
+            ctx.drawElement(exportElement, 0, 0);
+            renderedViaElementAPI = true;
+          } else if (typeof ctx.drawPlacedElement === 'function') {
+            ctx.drawPlacedElement(exportElement, 0, 0);
+            renderedViaElementAPI = true;
+          }
+        } catch (err) {
+          renderedViaElementAPI = false;
+        }
+
+        if (!renderedViaElementAPI) {
+          drawCardFallback(ctx, canvas.width, canvas.height);
+        }
+      }
+
+      function scheduleRepaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          try {
+            canvas.requestPaint();
+          } catch (e) {
+            // Ignore if not supported in current state
+          }
+        }
+        renderCanvas();
+      }
+
+      canvas.onpaint = function () {
+        renderCanvas();
+      };
+      canvas.addEventListener('paint', renderCanvas);
+
+      messageInput.addEventListener('input', function () {
+        if (messageDisplay && messageDisplay.textContent !== messageInput.value) {
+          messageDisplay.textContent = messageInput.value;
+        }
+        scheduleRepaint();
+      });
+
+      nameInput.addEventListener('input', function () {
+        if (nameDisplay && nameDisplay.textContent !== nameInput.value) {
+          nameDisplay.textContent = nameInput.value;
+        }
+        scheduleRepaint();
+      });
+
+      if (messageDisplay) {
+        messageDisplay.addEventListener('input', function () {
+          messageInput.value = messageDisplay.textContent;
+          scheduleRepaint();
+        });
+      }
+
+      if (nameDisplay) {
+        nameDisplay.addEventListener('input', function () {
+          nameInput.value = nameDisplay.textContent;
+          scheduleRepaint();
+        });
+      }
+
+      function updateBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        bgColorInput.value = color;
+        swatches.forEach(function (swatch) {
+          if (swatch.getAttribute('data-color').toLowerCase() === color.toLowerCase()) {
+            swatch.classList.add('active');
+          } else {
+            swatch.classList.remove('active');
+          }
+        });
+        scheduleRepaint();
+      }
+
+      bgColorInput.addEventListener('input', function (e) {
+        updateBackgroundColor(e.target.value);
+      });
+
+      bgColorInput.addEventListener('change', function (e) {
+        updateBackgroundColor(e.target.value);
+      });
+
+      swatches.forEach(function (swatch) {
+        swatch.addEventListener('click', function () {
+          const color = swatch.getAttribute('data-color');
+          if (color) {
+            updateBackgroundColor(color);
+          }
+        });
+      });
+
+      const observer = new MutationObserver(function () {
+        scheduleRepaint();
+      });
+      observer.observe(exportElement, {
+        childList: true,
+        characterData: true,
+        subtree: true,
+        attributes: true,
+        attributeFilter: ['style', 'class']
+      });
+
+      exportBtn.addEventListener('click', function () {
+        renderCanvas();
+        let dataUrl;
+        try {
+          dataUrl = canvas.toDataURL('image/png');
+        } catch (err) {
+          const fallbackCanvas = document.createElement('canvas');
+          fallbackCanvas.width = canvas.width;
+          fallbackCanvas.height = canvas.height;
+          drawCardFallback(fallbackCanvas.getContext('2d'), fallbackCanvas.width, fallbackCanvas.height);
+          dataUrl = fallbackCanvas.toDataURL('image/png');
+        }
+
+        const downloadLink = document.createElement('a');
+        downloadLink.href = dataUrl;
+        downloadLink.download = 'daily-grind-gift-card.png';
+        document.body.appendChild(downloadLink);
+        downloadLink.click();
+        document.body.removeChild(downloadLink);
+      });
+
+      // Initial render
+      scheduleRepaint();
+      window.addEventListener('load', scheduleRepaint);
+    })();
+  </script>
 </body>
 
