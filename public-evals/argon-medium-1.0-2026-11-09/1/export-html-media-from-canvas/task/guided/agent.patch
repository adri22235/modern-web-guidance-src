+        fallbackObserver.observe(canvas);
+        renderFallbackCard();
+      }
+
+      // Sync recipient name between form control and inline card element
+      designerRecipient.addEventListener('input', () => {
+        cardRecipient.value = designerRecipient.value;
+        requestCardRepaint();
+      });
+
+      cardRecipient.addEventListener('input', () => {
+        designerRecipient.value = cardRecipient.value;
+        requestCardRepaint();
+      });
+
+      // Sync custom message between form control and inline card element
+      designerMessage.addEventListener('input', () => {
+        cardMessage.value = designerMessage.value;
+        requestCardRepaint();
+      });
+
+      cardMessage.addEventListener('input', () => {
+        designerMessage.value = cardMessage.value;
+        requestCardRepaint();
+      });
+
+      // Sync background color controls
+      bgColorInput.addEventListener('input', () => {
+        applyBackgroundColor(bgColorInput.value);
+      });
+
+      themeRadios.forEach((radio) => {
+        radio.addEventListener('change', () => {
+          if (radio.checked) {
+            applyBackgroundColor(radio.value);
+          }
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
