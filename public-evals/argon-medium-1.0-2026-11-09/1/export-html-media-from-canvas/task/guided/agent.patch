+        exportElement.style.setProperty('--card-fg', fgColor);
+        exportElement.style.backgroundColor = colorValue;
+        exportElement.style.color = fgColor;
+        bgColorInput.value = colorValue;
+        bgColorHex.textContent = colorValue.toLowerCase();
+
+        themeRadios.forEach((radio) => {
+          radio.checked = radio.value.toLowerCase() === colorValue.toLowerCase();
