+  <script>
+    (() => {
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const exportBtn = document.getElementById('export-card-btn');
+      const form = document.getElementById('gift-card-form');
+      const designerRecipient = document.getElementById('designer-recipient');
+      const designerMessage = document.getElementById('designer-message');
+      const cardRecipient = document.getElementById('card-recipient-input');
+      const cardMessage = document.getElementById('card-message-input');
+      const bgColorInput = document.getElementById('bg-color-input');
+      const bgColorHex = document.getElementById('bg-color-hex');
+      const themeRadios = document.querySelectorAll('input[name="theme_preset"]');
+      const canvasStatus = document.getElementById('canvas-status');
+
+      function getContrastingTextColor(hexColor) {
+        const cleanHex = hexColor.replace('#', '');
+        if (cleanHex.length !== 6) return '#ffffff';
+        const r = parseInt(cleanHex.slice(0, 2), 16) / 255;
+        const g = parseInt(cleanHex.slice(2, 4), 16) / 255;
+        const b = parseInt(cleanHex.slice(4, 6), 16) / 255;
+        const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
+        return luminance > 0.6 ? '#3e2723' : '#ffffff';
+      }
+
+      function renderFallbackCard() {
+        const dpr = window.devicePixelRatio || 1;
+        const width = canvas.clientWidth || 440;
+        const height = canvas.clientHeight || 270;
+        if (canvas.width !== Math.round(width * dpr) || canvas.height !== Math.round(height * dpr)) {
+          canvas.width = Math.round(width * dpr);
+          canvas.height = Math.round(height * dpr);
+        }
+
+        const bgColor = bgColorInput.value || '#4e342e';
+        const fgColor = getContrastingTextColor(bgColor);
+
+        ctx.save();
+        ctx.scale(dpr, dpr);
+        ctx.clearRect(0, 0, width, height);
+
+        // Card background
+        ctx.fillStyle = bgColor;
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(0, 0, width, height, 14);
+        } else {
+          ctx.rect(0, 0, width, height);
+        }
+        ctx.fill();
+
+        // Card border
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.55)';
+        ctx.lineWidth = 2;
+        ctx.stroke();
+
+        // Brand title
+        ctx.fillStyle = fgColor;
+        ctx.font = 'bold 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('THE DAILY GRIND', 24, 38);
+
+        // Gift card badge
+        ctx.fillStyle = '#ffab40';
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(width - 138, 20, 114, 26, 13);
+        } else {
+          ctx.rect(width - 138, 20, 114, 26);
+        }
+        ctx.fill();
+        ctx.fillStyle = '#3e2723';
+        ctx.font = 'bold 12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('$25 GIFT CARD', width - 126, 37);
+
+        // Recipient label & value
+        ctx.fillStyle = fgColor;
+        ctx.font = '600 11px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('TO', 24, 82);
+        ctx.font = 'bold 18px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(cardRecipient.value || 'Coffee Lover', 24, 106);
+
+        // Message label & wrapped value
+        ctx.font = '600 11px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('MESSAGE', 24, 142);
+        ctx.font = '14px "Segoe UI", Tahoma, sans-serif';
+        const words = (cardMessage.value || '').split(/\s+/);
+        let line = '';
+        let y = 166;
+        const maxWidth = width - 48;
+        for (const word of words) {
+          const testLine = line ? `${line} ${word}` : word;
+          if (ctx.measureText(testLine).width > maxWidth && line) {
+            ctx.fillText(line, 24, y);
+            line = word;
+            y += 20;
+          } else {
+            line = testLine;
+          }
+        }
+        if (line) {
+          ctx.fillText(line, 24, y);
+        }
+
+        // Footer divider & text
+        ctx.strokeStyle = fgColor === '#ffffff' ? 'rgba(255, 255, 255, 0.25)' : 'rgba(62, 39, 35, 0.25)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(24, height - 42);
+        ctx.lineTo(width - 24, height - 42);
+        ctx.stroke();
+
+        ctx.font = '12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('Artisanal Coffee • Good at All Locations', 24, height - 20);
+        ctx.fillText('#TDG-2026', width - 90, height - 20);
+
+        ctx.restore();
+      }
+
+      function requestCardRepaint() {
+        if ('content' in HTMLCanvasElement.prototype && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
