+  <script>
+    (function () {
+      const form = document.getElementById('contact-form');
+      if (!form) return;
+
+      const fields = form.querySelectorAll('input, textarea');
+      const statusEl = document.getElementById('form-status');
+
+      function validateField(field) {
+        if (field.required && field.value.length > 0 && field.value.trim() === '') {
+          field.setCustomValidity('This field cannot be blank.');
+        } else {
+          field.setCustomValidity('');
+        }
+
+        const wrapper = field.closest('.field-wrapper');
+        const isInvalid = !field.checkValidity();
+
+        if (field.dataset.interacted === 'true') {
+          field.classList.toggle('is-invalid', isInvalid);
+          field.setAttribute('aria-invalid', String(isInvalid));
+          if (wrapper) {
+            wrapper.classList.toggle('error', isInvalid);
+            wrapper.classList.toggle('invalid', isInvalid);
+          }
+        }
+        return !isInvalid;
+      }
+
+      fields.forEach((field) => {
+        field.addEventListener('blur', () => {
+          field.dataset.interacted = 'true';
+          validateField(field);
+        });
+
+        field.addEventListener('input', () => {
+          field.dataset.interacted = 'true';
+          validateField(field);
+          if (statusEl && !statusEl.hidden) {
+            statusEl.hidden = true;
+          }
+        });
+
+        field.addEventListener('invalid', () => {
+          field.dataset.interacted = 'true';
+          validateField(field);
+        });
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        let allValid = true;
+
+        fields.forEach((field) => {
+          field.dataset.interacted = 'true';
+          if (!validateField(field)) {
+            allValid = false;
+          }
+        });
+
+        if (allValid) {
+          form.reset();
+          fields.forEach((field) => {
+            delete field.dataset.interacted;
+            field.classList.remove('is-invalid');
+            field.removeAttribute('aria-invalid');
+            const wrapper = field.closest('.field-wrapper');
+            if (wrapper) {
+              wrapper.classList.remove('error', 'invalid');
+            }
+          });
+          if (statusEl) {
+            statusEl.hidden = false;
+          }
+        }
+      });
+    })();
+  </script>
