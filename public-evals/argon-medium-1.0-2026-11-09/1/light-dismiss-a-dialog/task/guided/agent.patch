+  <script type="module">
+    const dialog = document.getElementById('logout-dialog');
+    const trigger = document.querySelector('.test-dialog-trigger');
+
+    // Fallback for browsers without Invoker Commands support
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+      trigger.addEventListener('click', () => {
+        if (!dialog.open) dialog.showModal();
+      });
+    }
+
+    // Fallback for browsers without closedby support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e) => {
+        const rect = dialog.getBoundingClientRect();
+        return (
+          e.clientX < rect.left ||
+          e.clientX > rect.right ||
+          e.clientY < rect.top ||
+          e.clientY > rect.bottom
+        );
+      };
+
+      let pressedOutside = true;
+      dialog.addEventListener('pointerdown', (e) => {
+        pressedOutside = outside(e);
+      });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && outside(e)) dialog.close();
+      });
+      dialog.addEventListener('click', (event) => {
+        const wasPressedOutside = pressedOutside;
+        pressedOutside = true;
+        if (event.target !== dialog || !wasPressedOutside) return;
+
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+
+        if (isDialogContent) return;
+        dialog.close();
+      });
+    }
+
+    dialog.addEventListener('close', () => {
+      const choice = dialog.returnValue;
+      dialog.returnValue = '';
+      if (choice === 'confirm') {
+        window.location.href = '/logout';
+      }
+    });
+  </script>
+
