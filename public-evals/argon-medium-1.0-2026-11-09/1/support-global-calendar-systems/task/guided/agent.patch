+  <script type="module">
+    const CALENDAR_CONFIGS = [
+      {
+        elementId: 'islamic-date',
+        calendarId: 'islamic',
+        fallbackCalendarIds: ['islamic-umalqura', 'islamic-civil', 'islamic-tbla']
+      },
+      {
+        elementId: 'hebrew-date',
+        calendarId: 'hebrew',
+        fallbackCalendarIds: []
+      },
+      {
+        elementId: 'japanese-date',
+        calendarId: 'japanese',
+        fallbackCalendarIds: []
+      }
+    ];
+
+    // 1. Helper to check calendar support via Intl.supportedValuesOf
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    // 2. Convert an ISO PlainDate to a target calendar with fallback support
+    function convertPlainDateToCalendar(isoDate, calendarId, fallbackCalendarIds = []) {
+      const candidates = [calendarId, ...fallbackCalendarIds];
+      for (const candidateId of candidates) {
+        if (isCalendarSupported(candidateId)) {
+          try {
+            return isoDate.withCalendar(candidateId);
+          } catch {
+            // Try next candidate if engine rejects this calendar identifier
+          }
+        }
+      }
+
+      const targetDate = isCalendarSupported(calendarId)
+        ? isoDate.withCalendar(calendarId)
+        : isoDate;
+
+      const resolvedId = targetDate.calendarId ?? targetDate.calendar?.id;
+      if (resolvedId !== calendarId) {
+        console.warn(`Calendar ${calendarId} not supported; falling back to ISO 8601`);
+      }
+      return targetDate;
+    }
+
+    // 3. Render a single calendar card using Temporal.PlainDate
+    function updateCalendarCard(config, selectedIsoDate, todayIsoDate) {
+      const cardEl = document.getElementById(config.elementId);
+      if (!cardEl) return;
+
+      const targetDate = convertPlainDateToCalendar(
+        selectedIsoDate,
+        config.calendarId,
+        config.fallbackCalendarIds
+      );
+      const activeCalendarId = targetDate.calendarId ?? targetDate.calendar?.id ?? config.calendarId;
+
+      const todayInCalendar = convertPlainDateToCalendar(
+        todayIsoDate,
+        activeCalendarId,
+        config.fallbackCalendarIds
+      );
+
+      // Compare dates within the same calendar using Temporal.PlainDate.compare()
+      const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+      const relative = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+      // Format for display using toLocaleString (including era names)
+      const localizedDisplay = targetDate.toLocaleString(`en-u-ca-${activeCalendarId}`, {
+        day: 'numeric',
+        month: 'long',
+        year: 'numeric',
+        era: 'long'
+      });
+
+      const calendarIdEl = cardEl.querySelector('[data-field="calendar-id"]');
+      const timelineEl = cardEl.querySelector('[data-field="timeline"]');
+      const localizedDateEl = cardEl.querySelector('[data-field="localized-date"]');
+      const yearEl = cardEl.querySelector('[data-field="year"]');
+      const monthEl = cardEl.querySelector('[data-field="month"]');
+      const monthCodeEl = cardEl.querySelector('[data-field="month-code"]');
+      const monthsInYearEl = cardEl.querySelector('[data-field="months-in-year"]');
+      const breakdownListEl = cardEl.querySelector('[data-field="months-breakdown"]');
+
+      if (calendarIdEl) calendarIdEl.textContent = activeCalendarId;
+      if (timelineEl) {
+        timelineEl.textContent = relative;
+        timelineEl.setAttribute('data-status', relative);
+      }
+      if (localizedDateEl) localizedDateEl.textContent = localizedDisplay;
+      if (yearEl) yearEl.textContent = String(targetDate.year);
+      if (monthEl) monthEl.textContent = String(targetDate.month);
+      if (monthCodeEl) monthCodeEl.textContent = targetDate.monthCode;
+      if (monthsInYearEl) monthsInYearEl.textContent = String(targetDate.monthsInYear);
+
+      if (breakdownListEl) {
+        breakdownListEl.replaceChildren();
+        // Safely iterate through months in the current calendar year via monthsInYear
+        for (let m = 1; m <= targetDate.monthsInYear; m++) {
+          const monthDate = targetDate.with({ month: m });
+          const li = document.createElement('li');
+          li.className = 'month-chip';
+          if (monthDate.monthCode === targetDate.monthCode) {
+            li.classList.add('is-active-month');
+          }
+
+          const codeSpan = document.createElement('span');
+          codeSpan.className = 'month-chip-code';
+          codeSpan.textContent = monthDate.monthCode;
+
+          const daysSpan = document.createElement('span');
+          daysSpan.className = 'month-chip-days';
+          daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+          li.append(codeSpan, daysSpan);
+          breakdownListEl.appendChild(li);
+        }
+      }
+    }
+
+    function initializeApp() {
+      const formEl = document.getElementById('calendar-converter-form');
+      const dateInput = document.getElementById('calendar-date-picker');
+      const todayBtn = document.getElementById('calendar-today-btn');
+      if (!dateInput) return;
+
+      const initialToday = Temporal.Now.plainDateISO();
+      if (!dateInput.value) {
+        dateInput.value = initialToday.toString();
+      }
+
+      function renderAllCalendars() {
+        const todayIso = Temporal.Now.plainDateISO();
+        let selectedIso = todayIso;
+        if (dateInput.value) {
+          try {
+            selectedIso = Temporal.PlainDate.from(dateInput.value);
+          } catch {
+            selectedIso = todayIso;
+          }
+        }
+
+        for (const config of CALENDAR_CONFIGS) {
+          updateCalendarCard(config, selectedIso, todayIso);
+        }
+      }
+
+      if (formEl) {
+        formEl.addEventListener('submit', (e) => {
+          e.preventDefault();
+          renderAllCalendars();
+        });
+      }
+
+      dateInput.addEventListener('input', renderAllCalendars);
+      dateInput.addEventListener('change', renderAllCalendars);
+
+      if (todayBtn) {
+        todayBtn.addEventListener('click', () => {
+          const todayIso = Temporal.Now.plainDateISO();
+          dateInput.value = todayIso.toString();
+          renderAllCalendars();
+        });
+      }
+
+      renderAllCalendars();
+    }
+
+    // Check if Temporal is supported natively; dynamically load temporal-polyfill if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
