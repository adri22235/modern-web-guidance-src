+  <script>
+    (function () {
+      const dateInput = document.getElementById('date-picker');
+      const globalStatusEl = document.getElementById('date-relative-status');
+
+      const calendars = [
+        { id: 'islamic-civil', fallbackIds: ['islamic', 'islamic-umalqura'], title: 'Islamic Calendar', elementId: 'islamic-date' },
+        { id: 'hebrew', fallbackIds: [], title: 'Hebrew Calendar', elementId: 'hebrew-date' },
+        { id: 'japanese', fallbackIds: [], title: 'Japanese Calendar', elementId: 'japanese-date' }
+      ];
+
+      function getTodayPlainDate() {
+        return Temporal.Now.plainDateISO();
+      }
+
+      function convertWithCalendar(plainDate, calConfig) {
+        const candidates = [calConfig.id, ...calConfig.fallbackIds];
+        for (const calId of candidates) {
+          try {
+            return plainDate.withCalendar(calId);
+          } catch (_) {
+            // Try next candidate
+          }
+        }
+        throw new Error('Unsupported calendar: ' + calConfig.id);
+      }
+
+      function formatLocalizedDate(convertedDate, calId) {
+        const longStr = convertedDate.toLocaleString('en-US', {
+          calendar: calId,
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+          ...(calId === 'japanese' ? { era: 'long' } : {})
+        });
+        const asciiNorm = longStr.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
+        if (asciiNorm !== longStr) {
+          return `${longStr} (${asciiNorm})`;
+        }
+        return longStr;
+      }
+
+      function renderCalendars(isoDateString) {
+        if (!isoDateString) return;
+        let selectedDate;
+        try {
+          selectedDate = Temporal.PlainDate.from(isoDateString);
+        } catch (_) {
+          return;
+        }
+
+        const today = getTodayPlainDate();
+        const comparison = Temporal.PlainDate.compare(selectedDate, today);
+        const relativeStatus = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+        if (globalStatusEl) {
+          globalStatusEl.textContent = relativeStatus;
+        }
+
+        for (const calConfig of calendars) {
+          const cardEl = document.getElementById(calConfig.elementId);
+          if (!cardEl) continue;
+
+          const converted = convertWithCalendar(selectedDate, calConfig);
+          const actualCalId = converted.calendarId || calConfig.id;
+          const localizedDate = formatLocalizedDate(converted, actualCalId);
+          const year = converted.year;
+          const month = converted.month;
+          const monthCode = converted.monthCode;
+          const monthsInYear = converted.monthsInYear;
+
+          const monthItems = [];
+          for (let m = 1; m <= monthsInYear; m++) {
+            const mDate = converted.with({ month: m, day: 1 });
+            const isCurrent = mDate.monthCode === monthCode;
+            monthItems.push(
+              `<li class="${isCurrent ? 'current-month' : ''}">` +
+              `<span class="month-code">${mDate.monthCode}</span>` +
+              `<span class="month-days">${mDate.daysInMonth} days</span>` +
+              `</li>`
+            );
+          }
+
+          cardEl.innerHTML = `
+            <h3>${calConfig.title}</h3>
+            <div class="localized-date">${localizedDate}</div>
+            <ul class="calendar-meta">
+              <li><strong>Status:</strong> <span class="relative-status">${relativeStatus}</span></li>
+              <li><strong>Year:</strong> <span class="converted-year">${year}</span></li>
+              <li><strong>Month:</strong> <span class="numeric-month">${month}</span></li>
+              <li><strong>Month Code:</strong> <span class="month-code-value">${monthCode}</span></li>
+              <li style="grid-column: 1 / -1;"><strong>Total Months in Year:</strong> <span class="total-months">${monthsInYear}</span></li>
+            </ul>
+            <div class="months-breakdown">
+              <h4>Months in Year (${year})</h4>
+              <ul class="months-grid">
+                ${monthItems.join('')}
+              </ul>
+            </div>
+          `;
+        }
+      }
+
+      const initialDate = getTodayPlainDate().toString();
+      dateInput.value = initialDate;
+      renderCalendars(initialDate);
+
+      dateInput.addEventListener('input', (e) => renderCalendars(e.target.value));
+      dateInput.addEventListener('change', (e) => renderCalendars(e.target.value));
+    })();
+  </script>
+
 </body>
 
