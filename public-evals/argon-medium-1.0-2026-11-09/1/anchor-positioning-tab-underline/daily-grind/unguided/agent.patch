+  <script>
+    const navList = document.querySelector('nav ul');
+    const navItems = document.querySelectorAll('nav a.nav-item');
+    const indicator = document.querySelector('.nav-indicator');
+
+    function updateIndicator(activeItem, animate = true) {
+      if (!activeItem || !indicator || !navList) return;
+      if (!animate) {
+        indicator.style.transition = 'none';
+      }
+      const listRect = navList.getBoundingClientRect();
+      const itemRect = activeItem.getBoundingClientRect();
+      indicator.style.left = `${itemRect.left - listRect.left}px`;
+      indicator.style.width = `${itemRect.width}px`;
+      if (!animate) {
+        indicator.offsetHeight;
+        indicator.style.transition = '';
+      }
+    }
+
+    function setActiveNavItem(targetLink, animate = true) {
+      navItems.forEach((item) => {
+        const isSelected = item === targetLink;
+        item.classList.toggle('active', isSelected);
+        if (isSelected) {
+          item.setAttribute('aria-current', 'page');
+        } else {
+          item.removeAttribute('aria-current');
+        }
+      });
+      updateIndicator(targetLink, animate);
+    }
+
+    navItems.forEach((item) => {
+      item.addEventListener('click', (event) => {
+        event.preventDefault();
+        setActiveNavItem(item, true);
+      });
+
+      if (item.parentElement && item.parentElement.tagName === 'LI') {
+        item.parentElement.addEventListener('click', (event) => {
+          if (event.target === item.parentElement) {
+            event.preventDefault();
+            setActiveNavItem(item, true);
+          }
+        });
+      }
+    });
+
+    const initialActive = document.querySelector('nav a.nav-item.active') || navItems[0];
+    updateIndicator(initialActive, false);
+
+    window.addEventListener('load', () => {
+      const currentActive = document.querySelector('nav a.nav-item.active') || navItems[0];
+      updateIndicator(currentActive, false);
+    });
+
+    window.addEventListener('resize', () => {
+      const currentActive = document.querySelector('nav a.nav-item.active') || navItems[0];
+      updateIndicator(currentActive, false);
+    });
+  </script>
+
