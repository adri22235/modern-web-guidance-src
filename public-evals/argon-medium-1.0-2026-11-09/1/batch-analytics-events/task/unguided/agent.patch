+  <script>
+    (function () {
+      const ANALYTICS_ENDPOINT = '/api/analytics';
+      const DEBOUNCE_MS = 500;
+      const MAX_BATCH_SIZE = 25;
+
+      const eventQueue = [];
+      let debounceTimer = null;
+
+      function getSessionId() {
+        const storageKey = 'dg_analytics_session_id';
+        try {
+          let sessionId = sessionStorage.getItem(storageKey);
+          if (!sessionId) {
+            sessionId = 'sess_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 9);
+            sessionStorage.setItem(storageKey, sessionId);
+          }
+          return sessionId;
+        } catch (_) {
+          return 'sess_' + Date.now().toString(36);
+        }
+      }
+
+      const sessionId = getSessionId();
+
+      function sendBatch(events, useBeacon) {
+        if (!events || events.length === 0) return;
+
+        const payload = JSON.stringify({
+          sessionId: sessionId,
+          sentAt: new Date().toISOString(),
+          events: events
+        });
+
+        if (useBeacon && typeof navigator.sendBeacon === 'function') {
+          const blob = new Blob([payload], { type: 'application/json' });
+          if (navigator.sendBeacon(ANALYTICS_ENDPOINT, blob)) {
+            return;
+          }
+        }
+
+        if (typeof fetch === 'function') {
+          fetch(ANALYTICS_ENDPOINT, {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: payload,
+            keepalive: true
+          }).catch(function () {
+            // Silently ignore network errors for background telemetry
+          });
+        }
+      }
+
+      function flush(useBeacon) {
+        if (debounceTimer !== null) {
+          clearTimeout(debounceTimer);
+          debounceTimer = null;
+        }
+        if (eventQueue.length === 0) return;
+
+        const batch = eventQueue.splice(0, eventQueue.length);
+        sendBatch(batch, Boolean(useBeacon));
+      }
+
+      function scheduleFlush() {
+        if (eventQueue.length >= MAX_BATCH_SIZE) {
+          flush(false);
+          return;
+        }
+        if (debounceTimer !== null) {
+          clearTimeout(debounceTimer);
+        }
+        debounceTimer = setTimeout(function () {
+          debounceTimer = null;
+          flush(false);
+        }, DEBOUNCE_MS);
+      }
+
+      function enqueueEvent(type, metadata) {
+        eventQueue.push({
+          type: type,
+          timestamp: new Date().toISOString(),
+          path: window.location.pathname,
+          metadata: metadata || {}
+        });
+        scheduleFlush();
+      }
+
+      function trackPageView() {
+        enqueueEvent('pageview', {
+          url: window.location.href,
+          title: document.title,
+          referrer: document.referrer || null,
+          viewport: {
+            width: window.innerWidth,
+            height: window.innerHeight
+          }
+        });
+      }
+
+      function trackClick(event) {
+        const target = event.target instanceof Element ? event.target : null;
+        if (!target) return;
+
+        const interactiveEl = target.closest('a, button, [role="button"], .btn, .card') || target;
+        const anchorEl = target.closest('a');
+
+        enqueueEvent('click', {
+          tag: interactiveEl.tagName.toLowerCase(),
+          text: (interactiveEl.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 100),
+          href: anchorEl ? anchorEl.getAttribute('href') : null,
+          className: interactiveEl.className || null,
+          id: interactiveEl.id || null,
+          coordinates: {
+            x: event.clientX,
+            y: event.clientY
+          }
+        });
+      }
+
+      // Record initial page view
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', trackPageView, { once: true });
+      } else {
+        trackPageView();
+      }
+
+      // Record user click interactions
+      document.addEventListener('click', trackClick, { capture: true, passive: true });
+
+      // Flush remaining queued events when the page is hidden or unloaded
+      document.addEventListener('visibilitychange', function () {
+        if (document.visibilityState === 'hidden') {
+          flush(true);
+        }
+      });
+      window.addEventListener('pagehide', function () {
+        flush(true);
+      });
+
+      // Expose API for programmatic tracking and inspection
+      window.DailyGrindAnalytics = {
+        track: enqueueEvent,
+        trackPageView: trackPageView,
+        flush: flush,
+        getQueue: function () {
+          return eventQueue.slice();
+        }
+      };
+    })();
+  </script>
 </body>
 
 </html>
