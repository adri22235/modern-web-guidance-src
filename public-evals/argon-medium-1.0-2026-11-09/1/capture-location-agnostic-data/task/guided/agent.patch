+  <script type="module">
+    const STORAGE_KEY_TIME = 'dailyGrind.pickupReminderTime';
+    const STORAGE_KEY_DATE = 'dailyGrind.coffeeAnniversaryDate';
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeError = document.getElementById('pickup-reminder-error');
+      const dateError = document.getElementById('coffee-anniversary-error');
+      const summaryTime = document.getElementById('summary-pickup-time');
+      const summaryDate = document.getElementById('summary-anniversary-date');
+      const summaryMonthDay = document.getElementById('summary-annual-monthday');
+      const summaryDateTime = document.getElementById('summary-anniversary-datetime');
+
+      const savedTimeStr = localStorage.getItem(STORAGE_KEY_TIME);
+      const savedDateStr = localStorage.getItem(STORAGE_KEY_DATE);
+      if (savedTimeStr) {
+        timeInput.value = savedTimeStr;
+      }
+      if (savedDateStr) {
+        dateInput.value = savedDateStr;
+      }
+
+      function clearFieldError(inputEl, errorEl) {
+        inputEl.setCustomValidity('');
+        inputEl.removeAttribute('aria-invalid');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+      }
+
+      function validateTimeField() {
+        const raw = timeInput.value.trim();
+        if (!raw) {
+          const msg = 'Please select a daily pickup reminder time (HH:MM).';
+          timeInput.setCustomValidity(msg);
+          timeInput.setAttribute('aria-invalid', 'true');
+          timeError.textContent = msg;
+          timeError.hidden = false;
+          return null;
+        }
+        try {
+          const plainTime = Temporal.PlainTime.from(raw);
+          clearFieldError(timeInput, timeError);
+          return plainTime;
+        } catch {
+          const msg = 'Please enter a valid wall-clock time in HH:MM format.';
+          timeInput.setCustomValidity(msg);
+          timeInput.setAttribute('aria-invalid', 'true');
+          timeError.textContent = msg;
+          timeError.hidden = false;
+          return null;
+        }
+      }
+
+      function validateDateField() {
+        const raw = dateInput.value.trim();
+        if (!raw) {
+          const msg = 'Please select your coffee anniversary calendar date (YYYY-MM-DD).';
+          dateInput.setCustomValidity(msg);
+          dateInput.setAttribute('aria-invalid', 'true');
+          dateError.textContent = msg;
+          dateError.hidden = false;
+          return null;
+        }
+        try {
+          const plainDate = Temporal.PlainDate.from(raw);
+          clearFieldError(dateInput, dateError);
+          return plainDate;
+        } catch {
+          const msg = 'Please enter a valid calendar date in YYYY-MM-DD format.';
+          dateInput.setCustomValidity(msg);
+          dateInput.setAttribute('aria-invalid', 'true');
+          dateError.textContent = msg;
+          dateError.hidden = false;
+          return null;
+        }
+      }
+
+      function renderSchedule(reminderTime, anniversaryDate) {
+        // Read calendar and wall-clock fields directly from Temporal Plain types
+        const { year, month, day } = anniversaryDate;
+        const { hour, minute } = reminderTime;
+
+        // Model the recurring annual coffee anniversary as Temporal.PlainMonthDay with explicit calendar
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = annualAnniversary.equals(today.toPlainMonthDay());
+
+        // Convert PlainMonthDay to a PlainDate with a specific year before performing date arithmetic
+        let nextOccurrenceDate = annualAnniversary.toPlainDate({ year: today.year });
+        if (Temporal.PlainDate.compare(nextOccurrenceDate, today) < 0) {
+          nextOccurrenceDate = nextOccurrenceDate.add({ years: 1 }, { overflow: 'constrain' });
+        }
+
+        // Combine PlainDate and PlainTime into a location-agnostic PlainDateTime without string interpolation
+        const anniversaryPickup = nextOccurrenceDate.toPlainDateTime(reminderTime);
+
+        const paddedHour = String(hour).padStart(2, '0');
+        const paddedMinute = String(minute).padStart(2, '0');
+        const paddedMonth = String(month).padStart(2, '0');
+        const paddedDay = String(day).padStart(2, '0');
+
+        summaryTime.textContent = `${reminderTime.toLocaleString([], { hour: '2-digit', minute: '2-digit' })} (${paddedHour}:${paddedMinute} local wall-clock time)`;
+        summaryDate.textContent = `${anniversaryDate.toLocaleString([], { year: 'numeric', month: 'long', day: 'numeric' })} (${year}-${paddedMonth}-${paddedDay})`;
+        summaryMonthDay.textContent = isAnniversaryToday
+          ? `${annualAnniversary.toLocaleString([], { month: 'long', day: 'numeric' })} (${annualAnniversary.toString()} — Happy Coffee Anniversary today!)`
+          : `${annualAnniversary.toLocaleString([], { month: 'long', day: 'numeric' })} (${annualAnniversary.toString()})`;
+        summaryDateTime.textContent = `${anniversaryPickup.toLocaleString([], { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })} (${anniversaryPickup.toString()})`;
+      }
+
+      timeInput.addEventListener('input', () => clearFieldError(timeInput, timeError));
+      dateInput.addEventListener('input', () => clearFieldError(dateInput, dateError));
+
+      timeInput.addEventListener('blur', () => {
+        if (timeInput.value !== '') {
+          validateTimeField();
+        }
+      });
+
+      dateInput.addEventListener('blur', () => {
+        if (dateInput.value !== '') {
+          validateDateField();
+        }
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const reminderTime = validateTimeField();
+        const anniversaryDate = validateDateField();
+
+        if (!reminderTime) {
+          timeInput.focus();
+          return;
+        }
+        if (!anniversaryDate) {
+          dateInput.focus();
+          return;
+        }
+
+        const timeIso = reminderTime.toString({ smallestUnit: 'minute' });
+        const dateIso = anniversaryDate.toString();
+
+        localStorage.setItem(STORAGE_KEY_TIME, timeIso);
+        localStorage.setItem(STORAGE_KEY_DATE, dateIso);
+
+        renderSchedule(reminderTime, anniversaryDate);
+      });
+
+      const initialTime = validateTimeField();
+      const initialDate = validateDateField();
+      if (initialTime && initialDate) {
+        renderSchedule(initialTime, initialDate);
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
