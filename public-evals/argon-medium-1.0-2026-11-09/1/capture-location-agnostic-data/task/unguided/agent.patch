+  <script>
+    (function () {
+      'use strict';
+
+      var STORAGE_KEY_TIME = 'dailyGrind_pickupReminderTime';
+      var STORAGE_KEY_DATE = 'dailyGrind_coffeeAnniversaryDate';
+
+      var DEFAULT_TIME = '08:00';
+      var DEFAULT_DATE = '2023-09-15';
+
+      var MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      /**
+       * Parses a wall-clock time string ("HH:MM" or "HH:MM:SS") without using Date or time zones.
+       * Guarantees the exact hours and minutes selected by the user regardless of time zone shifts.
+       */
+      function parsePlainTime(timeStr) {
+        if (typeof timeStr !== 'string') return null;
+        var match = /^(\d{2}):(\d{2})(?::(\d{2}))?$/.exec(timeStr.trim());
+        if (!match) return null;
+        var hour = parseInt(match[1], 10);
+        var minute = parseInt(match[2], 10);
+        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return null;
+        var canonical = String(hour).padStart(2, '0') + ':' + String(minute).padStart(2, '0');
+        return {
+          hour: hour,
+          minute: minute,
+          iso: canonical
+        };
+      }
+
+      /**
+       * Formats a wall-clock PlainTime object or "HH:MM" string in human-readable form
+       * purely from its numeric components (no Date object or UTC/local offset conversion).
+       */
+      function formatPlainTime(timeStr) {
+        var parsed = parsePlainTime(timeStr);
+        if (!parsed) return '';
+        var period = parsed.hour >= 12 ? 'PM' : 'AM';
+        var hour12 = parsed.hour % 12;
+        if (hour12 === 0) hour12 = 12;
+        var minutePadded = String(parsed.minute).padStart(2, '0');
+        return hour12 + ':' + minutePadded + ' ' + period + ' (' + parsed.iso + ')';
+      }
+
+      /**
+       * Parses an ISO calendar date string ("YYYY-MM-DD") directly into year, month, day integers.
+       * Avoids `new Date("YYYY-MM-DD")`, which parses as UTC midnight and shifts the date backward
+       * in negative UTC offset time zones when formatted in local time.
+       */
+      function parsePlainDate(dateStr) {
+        if (typeof dateStr !== 'string') return null;
+        var match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr.trim());
+        if (!match) return null;
+        var year = parseInt(match[1], 10);
+        var month = parseInt(match[2], 10);
+        var day = parseInt(match[3], 10);
+        if (month < 1 || month > 12 || day < 1 || day > 31) return null;
+
+        var daysInMonths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+        var isLeapYear = (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
+        if (isLeapYear) daysInMonths[1] = 29;
+        if (day > daysInMonths[month - 1]) return null;
+
+        var canonical =
+          String(year).padStart(4, '0') + '-' +
+          String(month).padStart(2, '0') + '-' +
+          String(day).padStart(2, '0');
+
+        return {
+          year: year,
+          month: month,
+          day: day,
+          iso: canonical
+        };
+      }
+
+      /**
+       * Formats a calendar PlainDate string ("YYYY-MM-DD") into a readable date string
+       * purely from its calendar fields so traveling across time zones never shifts the day.
+       */
+      function formatPlainDate(dateStr) {
+        var parsed = parsePlainDate(dateStr);
+        if (!parsed) return '';
+        var monthName = MONTH_NAMES[parsed.month - 1];
+        return monthName + ' ' + parsed.day + ', ' + parsed.year + ' (' + parsed.iso + ')';
+      }
+
+      function safeGetStorage(key) {
+        try {
+          return window.localStorage.getItem(key);
+        } catch (err) {
+          return null;
+        }
+      }
+
+      function safeSetStorage(key, value) {
+        try {
+          window.localStorage.setItem(key, value);
+        } catch (err) {
+          // Ignore storage quota/security errors in restricted environments
+        }
+      }
+
+      var timeInput = document.getElementById('pickup-reminder-time');
+      var dateInput = document.getElementById('coffee-anniversary-date');
