+        }
+      });
+
+      dateInput.addEventListener('change', function () {
+        if (applyDateSelection(dateInput.value, true)) {
+          statusEl.textContent = 'Coffee anniversary date saved as ' + formatPlainDate(dateInput.value) + '.';
+        }
+      });
+
