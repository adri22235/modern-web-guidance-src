+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          name: 'Colombian Huila Supremo',
+          origin: 'Colombia • High Altitude',
+          roast: 'Medium Roast',
+          price: '$18.00 / 12oz',
+          notes: 'Rich butterscotch caramel, toasted hazelnut, and balanced sweet orange acidity.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        }
+      ];
+
+      const beanGrid = document.getElementById('bean-grid');
+      const beanGridWrapper = document.getElementById('bean-grid-wrapper');
+      const leavingLayer = document.getElementById('bean-leaving-layer');
+      const addBeanBtn = document.getElementById('add-bean-btn');
+      const shuffleBeansBtn = document.getElementById('shuffle-beans-btn');
+      const varietySelect = document.getElementById('bean-variety-select');
+      const customNameInput = document.getElementById('bean-name-input');
+      const beanCountEl = document.getElementById('bean-count');
+      const emptyStateEl = document.getElementById('bean-empty-state');
+
+      let nextBeanId = 7;
+      let catalogCursor = 0;
+      const DURATION_MS = 450;
+      const EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';
+      const TRANSITION_STR = `transform ${DURATION_MS}ms ${EASING}, opacity 400ms ease, box-shadow 250ms ease, border-color 250ms ease`;
+
+      function getActiveCards() {
+        return Array.from(beanGrid.querySelectorAll('.bean-card'));
+      }
+
+      function updateStatus() {
+        const count = getActiveCards().length;
+        if (beanCountEl) {
+          beanCountEl.textContent = String(count);
+        }
+        if (emptyStateEl) {
+          emptyStateEl.classList.toggle('is-visible', count === 0);
+        }
+      }
+
+      /**
+       * Capture current visual bounding boxes of all active cards (including any mid-flight transforms).
+       */
+      function capturePositions(cards) {
+        const rects = new Map();
+        for (const card of cards) {
+          rects.set(card, card.getBoundingClientRect());
+        }
+        return rects;
+      }
+
+      /**
+       * Execute a simultaneous group transition across all cards in #bean-grid
+       * using the View Transitions API (with FLIP fallback) while keeping
+       * the entire page and all controls interactive during the animation.
+       */
+      function performGroupTransition(mutateDomCallback) {
+        if (typeof document.startViewTransition === 'function') {
+          document.startViewTransition(() => {
+            mutateDomCallback({ useViewTransition: true });
+            updateStatus();
+          });
+          return;
+        }
+
+        const beforeCards = getActiveCards();
+        const firstRects = capturePositions(beforeCards);
+        const wrapperRect = beanGridWrapper.getBoundingClientRect();
+
+        // Execute the DOM mutation (add, remove, or reorder)
+        const result = mutateDomCallback({ useViewTransition: false, firstRects, wrapperRect }) || {};
+        const addedCard = result.addedCard || null;
+        const leavingGhost = result.leavingGhost || null;
+
+        updateStatus();
+
+        const afterCards = getActiveCards();
+
+        // Step 1 (Last): Disable transitions and clear transforms temporarily to measure true target layout rects
+        for (const card of afterCards) {
+          card.style.transition = 'none';
+          card.style.transform = 'none';
+        }
+
+        // Flush layout so getBoundingClientRect reflects final grid positions
+        void beanGrid.offsetHeight;
+
+        const lastRects = new Map();
+        for (const card of afterCards) {
+          lastRects.set(card, card.getBoundingClientRect());
+        }
+
+        // Step 2 (Invert): Position existing cards at their delta offsets and new cards at their entry state
+        for (const card of afterCards) {
+          const first = firstRects.get(card);
+          const last = lastRects.get(card);
+
+          if (first && last) {
+            const dx = (first.left + first.width / 2) - (last.left + last.width / 2);
+            const dy = (first.top + first.height / 2) - (last.top + last.height / 2);
+            if (Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5) {
+              card.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0)`;
+              card.classList.add('is-moving');
+            } else {
+              card.style.transform = 'translate3d(0px, 0px, 0)';
+            }
+          } else if (card === addedCard) {
+            card.style.opacity = '0';
+            card.style.transform = 'translate3d(0px, -14px, 0) scale(0.84)';
+            card.classList.add('is-entering');
+          }
+        }
+
+        // Commit inverted styles to browser layout before playing transitions
+        void beanGrid.offsetHeight;
+
+        // Step 3 (Play): Simultaneously animate all cards to their new positions
+        for (const card of afterCards) {
+          const animToken = (card._animToken || 0) + 1;
+          card._animToken = animToken;
+
+          card.style.transition = TRANSITION_STR;
+          card.style.transform = 'translate3d(0px, 0px, 0) scale(1)';
+          card.style.opacity = '1';
+
+          setTimeout(() => {
+            if (card._animToken === animToken) {
+              card.style.transition = '';
+              card.style.transform = '';
+              card.style.opacity = '';
+              card.classList.remove('is-moving', 'is-entering');
+            }
+          }, DURATION_MS + 30);
+        }
+
+        // Animate outgoing ghost simultaneously without blocking pointer events
+        if (leavingGhost) {
+          void leavingGhost.offsetHeight;
+          leavingGhost.style.transition = `transform 380ms ${EASING}, opacity 350ms ease`;
+          leavingGhost.style.opacity = '0';
+          leavingGhost.style.transform = 'scale(0.82)';
+          setTimeout(() => {
+            leavingGhost.remove();
+          }, 400);
+        }
+      }
+
+      function createBeanCardElement(beanData, idStr) {
+        const article = document.createElement('article');
+        article.className = 'card bean-card bean-item';
+        article.setAttribute('data-bean-id', idStr);
+        article.setAttribute('role', 'listitem');
+        article.style.viewTransitionName = idStr;
+
+        const mediaDiv = document.createElement('div');
+        mediaDiv.className = 'bean-card-media';
+
+        const img = document.createElement('img');
+        img.src = beanData.image;
+        img.alt = `${beanData.name} coffee beans`;
+
+        const roastBadge = document.createElement('span');
+        roastBadge.className = 'bean-roast-badge';
+        roastBadge.textContent = beanData.roast;
+
+        const priceTag = document.createElement('span');
+        priceTag.className = 'bean-price-tag';
+        priceTag.textContent = beanData.price;
+
+        mediaDiv.appendChild(img);
+        mediaDiv.appendChild(roastBadge);
+        mediaDiv.appendChild(priceTag);
+
+        const bodyDiv = document.createElement('div');
+        bodyDiv.className = 'bean-card-body';
+
+        const originDiv = document.createElement('div');
+        originDiv.className = 'bean-origin';
+        originDiv.textContent = beanData.origin;
+
+        const titleEl = document.createElement('h3');
+        titleEl.textContent = beanData.name;
+
+        const notesEl = document.createElement('p');
+        notesEl.className = 'bean-notes';
+        notesEl.textContent = beanData.notes;
+
+        const actionsDiv = document.createElement('div');
+        actionsDiv.className = 'bean-card-actions';
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'remove-bean-btn';
+        removeBtn.setAttribute('data-action', 'remove');
+        removeBtn.setAttribute('aria-label', `Remove ${beanData.name}`);
+        removeBtn.textContent = 'Remove';
+
+        actionsDiv.appendChild(removeBtn);
+        bodyDiv.appendChild(originDiv);
+        bodyDiv.appendChild(titleEl);
+        bodyDiv.appendChild(notesEl);
+        bodyDiv.appendChild(actionsDiv);
+
+        article.appendChild(mediaDiv);
+        article.appendChild(bodyDiv);
+
+        return article;
+      }
+
+      function resolveNextBeanData() {
+        const customName = customNameInput ? customNameInput.value.trim() : '';
+        const selectedVariety = varietySelect ? varietySelect.value : 'auto';
+
+        let template = beanCatalog[catalogCursor % beanCatalog.length];
+        if (selectedVariety && selectedVariety !== 'auto') {
+          const found = beanCatalog.find((b) => b.name === selectedVariety);
+          if (found) {
+            template = found;
+          }
+        }
+        catalogCursor += 1;
+
+        if (customName) {
+          if (customNameInput) customNameInput.value = '';
+          return {
+            ...template,
+            name: customName
+          };
+        }
+
+        return { ...template };
+      }
+
+      function handleAddBean() {
+        const beanData = resolveNextBeanData();
+        const idStr = `bean-${nextBeanId++}`;
+        const newCard = createBeanCardElement(beanData, idStr);
+
+        performGroupTransition(() => {
+          // Insert at the beginning of the grid so all existing items shift and animate simultaneously
+          beanGrid.prepend(newCard);
+          return { addedCard: newCard };
+        });
+      }
+
+      function handleRemoveBeanCard(cardEl) {
+        if (!cardEl || !beanGrid.contains(cardEl)) return;
+
+        performGroupTransition(({ useViewTransition, firstRects, wrapperRect }) => {
+          if (useViewTransition) {
+            cardEl.remove();
+            return {};
+          }
+
+          const rect = firstRects.get(cardEl) || cardEl.getBoundingClientRect();
+
+          // Create a non-interactive visual ghost at the card's current position so it smoothly exits
+          // while remaining cards immediately reflow and animate simultaneously
+          const ghost = cardEl.cloneNode(true);
+          ghost.className = 'bean-card-ghost';
+          ghost.removeAttribute('id');
+          ghost.removeAttribute('data-bean-id');
+          ghost.style.viewTransitionName = 'none';
+          ghost.style.position = 'absolute';
+          ghost.style.left = `${(rect.left - wrapperRect.left).toFixed(2)}px`;
+          ghost.style.top = `${(rect.top - wrapperRect.top).toFixed(2)}px`;
+          ghost.style.width = `${rect.width.toFixed(2)}px`;
+          ghost.style.height = `${rect.height.toFixed(2)}px`;
+          ghost.style.margin = '0';
+          ghost.style.pointerEvents = 'none';
+          ghost.style.transition = 'none';
+          ghost.style.opacity = '1';
+          ghost.style.transform = 'scale(1)';
+          leavingLayer.appendChild(ghost);
+
+          cardEl.remove();
+
+          return { leavingGhost: ghost };
+        });
+      }
+
+      function handleShuffleBeans() {
+        const cards = getActiveCards();
+        if (cards.length < 2) return;
+
+        performGroupTransition(() => {
+          const shuffled = [...cards];
+          for (let i = shuffled.length - 1; i > 0; i--) {
+            const j = Math.floor(Math.random() * (i + 1));
+            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
+          }
+          // Ensure order actually changes
+          if (shuffled.every((card, idx) => card === cards[idx])) {
+            shuffled.push(shuffled.shift());
+          }
+          for (const card of shuffled) {
+            beanGrid.appendChild(card);
+          }
+        });
+      }
+
+      if (addBeanBtn) {
+        addBeanBtn.addEventListener('click', handleAddBean);
+      }
+
+      if (customNameInput) {
+        customNameInput.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter') {
+            e.preventDefault();
+            handleAddBean();
+          }
+        });
+      }
+
+      if (shuffleBeansBtn) {
+        shuffleBeansBtn.addEventListener('click', handleShuffleBeans);
+      }
+
+      if (beanGrid) {
+        beanGrid.addEventListener('click', (e) => {
+          const removeBtn = e.target.closest('.remove-bean-btn, [data-action="remove"]');
+          if (removeBtn) {
+            const card = removeBtn.closest('.bean-card');
+            if (card) {
+              handleRemoveBeanCard(card);
+            }
+            return;
+          }
+
+          // Allow clicking a card body to toggle its highlighted selection state at any time
+          const card = e.target.closest('.bean-card');
+          if (card) {
+            card.classList.toggle('is-selected');
+          }
+        });
+      }
+    })();
+  </script>
+
 </body>
 
