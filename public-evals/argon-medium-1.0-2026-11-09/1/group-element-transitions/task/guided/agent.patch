+          notes: 'Honeycrisp apple, wildflower honey, and clean citrus zest.',
+          price: '$19.00',
+          image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80'
+        },
+        'ethiopian-yirgacheffe': {
+          name: 'Ethiopian Yirgacheffe',
+          origin: 'Ethiopia',
+          roast: 'Light Roast',
+          notes: 'Jasmine blossom, bergamot citrus, and bright peach finish.',
+          price: '$19.50',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+        },
+        'colombian-supremo': {
+          name: 'Colombian Supremo',
+          origin: 'Colombia',
+          roast: 'Medium Roast',
+          notes: 'Toasted caramel, roasted hazelnut, and balanced cocoa body.',
+          price: '$17.00',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        },
+        'sumatra-mandheling': {
+          name: 'Sumatra Mandheling',
+          origin: 'Indonesia',
+          roast: 'Dark Roast',
+          notes: 'Full-bodied dark chocolate, cedar spice, and velvety finish.',
+          price: '$18.50',
+          image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
+        },
+        'espresso-reserve': {
+          name: 'Daily Grind Espresso Reserve',
+          origin: 'House Blend',
+          roast: 'Dark Roast',
+          notes: 'Rich molasses, toasted almond, and syrupy golden crema.',
+          price: '$18.00',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        }
+      };
+
+      const listEl = document.getElementById('bean-selection-list');
+      const selectEl = document.getElementById('bean-variety-select');
+      const addBtn = document.getElementById('add-bean-btn');
+      const shuffleBtn = document.getElementById('shuffle-beans-btn');
+      const countEl = document.getElementById('bean-count');
+      const emptyStateEl = document.getElementById('bean-empty-state');
+
+      let nextItemCounter = 5;
+
+      function runWithViewTransition(updateDOM) {
+        if (document.startViewTransition) {
+          const transition = document.startViewTransition(() => {
+            updateDOM();
+          });
+          transition.ready?.catch(() => {});
+        } else {
+          // Fallback: Perform the DOM update immediately without animation
+          updateDOM();
+        }
+      }
+
+      function updateStatusUI() {
+        const count = listEl.children.length;
+        countEl.textContent = `${count} ${count === 1 ? 'bean' : 'beans'} selected`;
+        emptyStateEl.hidden = count > 0;
+      }
+
+      function createBeanElement(beanKey, itemId) {
+        const bean = BEAN_CATALOG[beanKey] || BEAN_CATALOG['guatemala-antigua'];
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.dataset.itemId = itemId;
+        // Mandatory: Each element must have a unique view-transition-name
+        li.style.viewTransitionName = `bean-${itemId}`;
+
+        const img = document.createElement('img');
+        img.className = 'bean-item-image';
+        img.src = bean.image;
+        img.alt = `${bean.name} roasted coffee beans`;
+        img.width = 600;
+        img.height = 300;
+        img.loading = 'lazy';
+
+        const body = document.createElement('div');
+        body.className = 'bean-item-body';
+
+        const meta = document.createElement('div');
+        meta.className = 'bean-meta';
+        const originSpan = document.createElement('span');
+        originSpan.textContent = bean.origin;
+        const roastSpan = document.createElement('span');
+        roastSpan.className = 'bean-roast-tag';
+        roastSpan.textContent = bean.roast;
+        meta.append(originSpan, roastSpan);
+
+        const title = document.createElement('h3');
+        title.textContent = bean.name;
+
+        const notes = document.createElement('p');
+        notes.className = 'bean-notes';
+        notes.textContent = bean.notes;
+
+        const footer = document.createElement('div');
+        footer.className = 'bean-item-footer';
+        const priceSpan = document.createElement('span');
+        priceSpan.className = 'bean-price';
+        priceSpan.textContent = bean.price;
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'btn-remove';
+        removeBtn.setAttribute('aria-label', `Remove ${bean.name}`);
+        removeBtn.textContent = 'Remove';
+
+        footer.append(priceSpan, removeBtn);
+        body.append(meta, title, notes, footer);
+        li.append(img, body);
+
+        return li;
+      }
+
+      // Add a coffee bean to the beginning of the grid so all existing items animate to new positions
+      addBtn.addEventListener('click', () => {
+        const selectedKey = selectEl.value;
+        const itemId = `item-${nextItemCounter++}`;
+        const newBeanEl = createBeanElement(selectedKey, itemId);
+
+        // Advance selector to next variety for convenient consecutive adds
+        const nextIndex = (selectEl.selectedIndex + 1) % selectEl.options.length;
+        selectEl.selectedIndex = nextIndex;
+
+        runWithViewTransition(() => {
+          listEl.prepend(newBeanEl);
+          updateStatusUI();
+        });
+      });
+
+      // Remove a coffee bean when its Remove button is clicked
+      listEl.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.btn-remove');
+        if (!removeBtn) return;
+
+        const itemEl = removeBtn.closest('.bean-item');
+        if (!itemEl) return;
+
+        const hadFocus = itemEl.contains(document.activeElement);
+        const nextFocusTarget =
+          itemEl.nextElementSibling?.querySelector('.btn-remove') ??
+          itemEl.previousElementSibling?.querySelector('.btn-remove') ??
+          addBtn;
+
+        runWithViewTransition(() => {
+          itemEl.remove();
+          updateStatusUI();
+          if (hadFocus) {
+            nextFocusTarget?.focus();
+          }
+        });
+      });
+
+      // Shuffle existing coffee beans to rearrange them simultaneously
+      shuffleBtn.addEventListener('click', () => {
+        const items = Array.from(listEl.children);
+        if (items.length < 2) return;
+
+        for (let i = items.length - 1; i > 0; i--) {
+          const j = Math.floor(Math.random() * (i + 1));
+          [items[i], items[j]] = [items[j], items[i]];
+        }
+
+        runWithViewTransition(() => {
+          for (const item of items) {
+            listEl.appendChild(item);
+          }
+        });
+      });
+    })();
+  </script>
