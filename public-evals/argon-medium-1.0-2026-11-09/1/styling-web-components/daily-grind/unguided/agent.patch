+  <template id="drink-card-template">
+    <style>
+      /* Structured priority tiers inside the Shadow DOM */
+      @layer reset, base, layout, variants, overrides;
+
+      @layer reset {
+        *,
+        *::before,
+        *::after {
+          box-sizing: border-box;
+          margin: 0;
+          padding: 0;
+        }
+      }
+
+      @layer base {
+        :host {
+          /* Inherit site coffee theme tokens across the Shadow DOM boundary */
+          --_primary: var(--primary, #4e342e);
+          --_secondary: var(--secondary, #d7ccc8);
+          --_accent: var(--accent, #ffab40);
+          --_text: var(--text, #3e2723);
+          --_light: var(--light, #fafafa);
+          --_card-bg: var(--surface, #ffffff);
+          --_card-color: var(--_text);
+          --_card-border: rgba(78, 52, 46, 0.12);
+          --_title-color: var(--_primary);
+          --_badge-bg: var(--_secondary);
+          --_badge-color: var(--_primary);
+          --_cta-bg: var(--_primary);
+          --_cta-color: #ffffff;
+
+          display: block;
+          container-type: inline-size;
+          container-name: drink-card;
+          font-family: inherit;
+          color: var(--_card-color);
+          background: var(--_card-bg);
+          border: 1px solid var(--_card-border);
+          border-radius: var(--radius, 8px);
+          box-shadow: var(--shadow-sm, 0 2px 5px rgba(0, 0, 0, 0.1));
+          transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
+          overflow: hidden;
+        }
+
+        :host(:hover) {
+          transform: translateY(-3px);
+          box-shadow: var(--shadow-md, 0 8px 20px rgba(62, 39, 35, 0.14));
+        }
+
+        .card-surface {
+          height: 100%;
+          padding: clamp(1rem, 4cqi, 1.5rem);
+        }
+
+        .badge {
+          display: inline-block;
+          font-size: 0.72rem;
+          padding: 0.2rem 0.65rem;
+          border-radius: 999px;
+          background: var(--_badge-bg);
+          color: var(--_badge-color);
+        }
+
+        .price {
+          font-weight: 700;
+          font-size: 1.05rem;
+          color: var(--_title-color);
+        }
+
+        /* Default styling for projected (slotted) light DOM content */
+        ::slotted([slot="title"]),
+        ::slotted(h3) {
+          color: var(--_title-color);
+          font-size: clamp(1.15rem, 4cqi, 1.4rem);
+          margin-bottom: 0.4rem;
+          line-height: 1.3;
+        }
+
+        ::slotted(p) {
+          color: inherit;
+          margin-bottom: 0.5rem;
+        }
+
+        ::slotted([slot="notes"]) {
+          display: block;
+          font-size: 0.82rem;
+          color: inherit;
+          opacity: 0.8;
+        }
+
+        .cta {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          background: var(--_cta-bg);
+          color: var(--_cta-color);
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          font-size: 0.9rem;
+          transition: background 0.3s ease, transform 0.2s ease;
+          white-space: nowrap;
+        }
+
+        .cta:hover {
+          background: var(--_text);
+        }
+      }
+
+      @layer layout {
+        /* Default compact card layout (stacked, centered) */
+        .card-surface {
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+          gap: 0.85rem;
+          text-align: center;
+        }
+
+        .card-header {
+          display: flex;
+          justify-content: center;
+          align-items: center;
+          gap: 0.5rem;
+          flex-wrap: wrap;
+        }
+
+        .card-body {
+          display: flex;
+          flex-direction: column;
+          gap: 0.35rem;
+          flex: 1;
+        }
+
+        .card-footer {
+          display: flex;
+          flex-direction: column;
+          align-items: center;
+          gap: 0.6rem;
+          margin-top: 0.25rem;
+        }
+
+        /* Medium card container dimensions: align header and footer horizontally */
+        @container drink-card (min-width: 320px) {
+          .card-surface {
+            text-align: left;
+          }
+
+          .card-header {
+            justify-content: space-between;
+          }
+
+          .card-footer {
+            flex-direction: row;
+            justify-content: space-between;
+            align-items: center;
+            border-top: 1px solid rgba(128, 128, 128, 0.16);
+            padding-top: 0.75rem;
+          }
+        }
+
+        /* Wide card container dimensions: switch to multi-column split layout */
+        @container drink-card (min-width: 500px) {
+          .card-surface {
+            display: grid;
+            grid-template-columns: 1fr auto;
+            grid-template-areas:
+              "header header"
+              "body footer";
+            align-items: center;
+            column-gap: 1.5rem;
+            row-gap: 0.75rem;
+            text-align: left;
+          }
+
+          .card-header {
+            grid-area: header;
+            justify-content: space-between;
+          }
+
+          .card-body {
+            grid-area: body;
+          }
+
+          .card-footer {
+            grid-area: footer;
+            flex-direction: column;
+            align-items: flex-end;
+            justify-content: center;
+            border-top: none;
+            border-left: 1px solid rgba(128, 128, 128, 0.2);
+            padding-top: 0;
+            padding-left: 1.25rem;
+            margin-top: 0;
+          }
+        }
+      }
+
+      @layer variants {
+        /* Host outer styling & theme adjustments per card variant */
+        :host([variant="featured"]) {
+          --_card-bg: linear-gradient(135deg, #ffffff 0%, #fff8ef 100%);
+          --_card-border: var(--_accent);
+          --_badge-bg: var(--_accent);
+          --_badge-color: var(--_text);
+          border-width: 2px;
+        }
+
+        :host([variant="dark"]) {
+          --_card-bg: var(--_primary);
+          --_card-color: var(--_light);
+          --_title-color: #ffffff;
+          --_card-border: var(--_text);
+          --_cta-bg: var(--_accent);
+          --_cta-color: var(--_text);
+        }
+
+        :host([variant="dark"]) .cta:hover {
+          background: #ff9100;
+        }
+
+        :host([variant="chilled"]) {
+          --_card-bg: linear-gradient(180deg, #ffffff 0%, #f5f0ee 100%);
+          --_card-border: var(--_secondary);
+          --_badge-bg: var(--_primary);
+          --_badge-color: var(--_light);
+          border-top: 4px solid var(--_primary);
+        }
+      }
+
+      @layer overrides {
+        :host([hidden]) {
+          display: none !important;
+        }
+
+        .badge:empty,
+        .price:empty {
+          display: none;
+        }
+      }
+    </style>
+
+    <article class="card-surface" part="card surface">
+      <header class="card-header" part="header">
+        <span class="badge" part="badge"></span>
+        <span class="price" part="price"></span>
+      </header>
+
+      <div class="card-body" part="body">
+        <slot name="title">
+          <h3 part="fallback-title">Artisanal Drink</h3>
+        </slot>
+        <slot></slot>
+        <slot name="notes"></slot>
+      </div>
+
+      <footer class="card-footer" part="footer">
+        <slot name="action">
+          <a class="cta" part="cta button" href="/menu">View Details</a>
+        </slot>
+      </footer>
+    </article>
+  </template>
+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['variant', 'badge', 'price', 'href', 'cta-label'];
+      }
+
+      constructor() {
+        super();
+        const shadow = this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        shadow.appendChild(template.content.cloneNode(true));
+
+        this._badgeEl = shadow.querySelector('[part="badge"]');
+        this._priceEl = shadow.querySelector('[part="price"]');
+        this._ctaEl = shadow.querySelector('[part~="cta"]');
+      }
+
+      connectedCallback() {
+        this._syncAttributes();
+      }
+
+      attributeChangedCallback() {
+        this._syncAttributes();
+      }
+
+      _syncAttributes() {
+        if (this._badgeEl) {
+          this._badgeEl.textContent = this.getAttribute('badge') || '';
+        }
+        if (this._priceEl) {
+          this._priceEl.textContent = this.getAttribute('price') || '';
+        }
+        if (this._ctaEl) {
+          this._ctaEl.setAttribute('href', this.getAttribute('href') || '/menu');
+          this._ctaEl.textContent = this.getAttribute('cta-label') || 'View Details';
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
