+
+      /**
+       * Determine DST status for a given epoch timestamp and timezone.
+       */
+      function getDstInfo(epochMs, year, timeZone) {
+        const currentParts = getZonedParts(epochMs, timeZone);
+        const janParts = getZonedParts(Date.UTC(year, 0, 15, 12, 0, 0), timeZone);
+        const julParts = getZonedParts(Date.UTC(year, 6, 15, 12, 0, 0), timeZone);
+
+        const observesDst = janParts.offsetMs !== julParts.offsetMs;
+        const maxOffset = Math.max(janParts.offsetMs, julParts.offsetMs);
+        const isDstActive = observesDst && currentParts.offsetMs === maxOffset;
+
+        let tzAbbrev = '';
+        try {
+          const nameParts = new Intl.DateTimeFormat('en-US', {
+            timeZone,
+            timeZoneName: 'short'
+          }).formatToParts(new Date(epochMs));
+          const tzNamePart = nameParts.find(p => p.type === 'timeZoneName');
+          if (tzNamePart) tzAbbrev = tzNamePart.value;
+        } catch (_) {
+          tzAbbrev = '';
+        }
+
+        return {
+          observesDst,
+          isDstActive,
+          offsetMs: currentParts.offsetMs,
+          tzAbbrev
+        };
+      }
+
+      /**
+       * Resolve a wall-clock date ("YYYY-MM-DD") and time ("HH:MM") in hostTz to a UTC epoch timestamp.
+       * Rejects non-existent wall-clock times skipped during DST spring-forward transitions.
+       */
+      function resolveHostWallTime(dateStr, timeStr, hostTz) {
+        const cleanDate = (dateStr || '').trim();
+        const cleanTime = (timeStr || '').trim();
+
+        const dateMatch = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(cleanDate);
+        const timeMatch = /^(\d{1,2}):(\d{2})(?::(\d{2}))?$/.exec(cleanTime);
+
+        if (!dateMatch || !timeMatch) {
+          return {
+            valid: false,
+            isDstGap: false,
+            message: 'Invalid input: Please enter a valid date (YYYY-MM-DD) and time (HH:MM).'
+          };
+        }
+
+        const year = Number(dateMatch[1]);
+        const month = Number(dateMatch[2]);
+        const day = Number(dateMatch[3]);
+        const hour = Number(timeMatch[1]);
+        const minute = Number(timeMatch[2]);
+
+        // Verify valid calendar date
+        const calendarCheck = new Date(Date.UTC(year, month - 1, day));
+        if (
+          calendarCheck.getUTCFullYear() !== year ||
+          calendarCheck.getUTCMonth() + 1 !== month ||
+          calendarCheck.getUTCDate() !== day ||
+          hour < 0 || hour > 23 ||
+          minute < 0 || minute > 59
+        ) {
+          return {
+            valid: false,
+            isDstGap: false,
+            message: 'Invalid calendar date or time value.'
+          };
+        }
+
+        // Verify valid IANA timezone
+        try {
+          new Intl.DateTimeFormat('en-US', { timeZone: hostTz });
+        } catch (_) {
+          return {
+            valid: false,
+            isDstGap: false,
+            message: `Invalid timezone "${hostTz}". Please select a valid IANA timezone.`
+          };
+        }
+
+        const guessUtc = Date.UTC(year, month - 1, day, hour, minute, 0, 0);
+        const sampleHours = [-36, -18, -6, -3, -1, 0, 1, 3, 6, 18, 36];
+        const testedOffsets = new Set();
+        const matchingInstants = [];
+
+        for (let i = 0; i < sampleHours.length; i++) {
+          const sampleTs = guessUtc + sampleHours[i] * 3600000;
+          const { offsetMs } = getZonedParts(sampleTs, hostTz);
+          if (!testedOffsets.has(offsetMs)) {
+            testedOffsets.add(offsetMs);
+            const candidateTs = guessUtc - offsetMs;
+            const actual = getZonedParts(candidateTs, hostTz);
+            if (
+              actual.year === year &&
+              actual.month === month &&
+              actual.day === day &&
+              actual.hour === hour &&
+              actual.minute === minute
+            ) {
+              matchingInstants.push({
+                epochMs: candidateTs,
+                parts: actual
+              });
+            }
+          }
+        }
+
+        if (matchingInstants.length === 0) {
+          // Determine the before/after offsets around the gap for a clear explanation
+          const beforeParts = getZonedParts(guessUtc - 6 * 3600000, hostTz);
+          const afterParts = getZonedParts(guessUtc + 6 * 3600000, hostTz);
+          const beforeOffset = formatUtcOffset(beforeParts.offsetMs).shortOffset;
+          const afterOffset = formatUtcOffset(afterParts.offsetMs).shortOffset;
+
+          return {
+            valid: false,
+            isDstGap: true,
+            message: `Invalid local time: ${cleanTime} on ${cleanDate} does not exist in ${hostTz}. Clocks spring forward during a Daylight Saving Time (DST) transition (${beforeOffset} to ${afterOffset}), skipping this time.`
+          };
+        }
+
+        matchingInstants.sort((a, b) => a.epochMs - b.epochMs);
+
+        return {
+          valid: true,
+          epochMs: matchingInstants[0].epochMs,
+          hostParts: matchingInstants[0].parts,
+          isAmbiguousOverlap: matchingInstants.length > 1
+        };
+      }
+
+      /**
+       * Format an epoch timestamp in a target timezone for card rendering.
+       */
+      function formatTargetTime(epochMs, hostParts, targetTz) {
+        const parts = getZonedParts(epochMs, targetTz);
+        const dstInfo = getDstInfo(epochMs, parts.year, targetTz);
+        const offsets = formatUtcOffset(parts.offsetMs);
+
+        const hour24 = `${String(parts.hour).padStart(2, '0')}:${String(parts.minute).padStart(2, '0')}`;
+        const period = parts.hour >= 12 ? 'PM' : 'AM';
+        const hour12Num = parts.hour % 12 === 0 ? 12 : parts.hour % 12;
+        const hour12 = `${hour12Num}:${String(parts.minute).padStart(2, '0')} ${period}`;
+
+        const isoDate = `${parts.year}-${String(parts.month).padStart(2, '0')}-${String(parts.day).padStart(2, '0')}`;
+
+        const readableDate = new Intl.DateTimeFormat('en-US', {
+          timeZone: targetTz,
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        }).format(new Date(epochMs));
+
+        // Calculate calendar day difference relative to host date
+        const hostDayUtc = Date.UTC(hostParts.year, hostParts.month - 1, hostParts.day);
+        const targetDayUtc = Date.UTC(parts.year, parts.month - 1, parts.day);
+        const dayDiff = Math.round((targetDayUtc - hostDayUtc) / 86400000);
+
+        let dayDiffLabel = 'Same day';
+        if (dayDiff === 1) dayDiffLabel = '+1 day (Next day)';
+        else if (dayDiff === -1) dayDiffLabel = '-1 day (Previous day)';
+        else if (dayDiff > 1) dayDiffLabel = `+${dayDiff} days`;
+        else if (dayDiff < -1) dayDiffLabel = `${dayDiff} days`;
+
+        let sessionNote = 'Daytime Cupping Window';
+        if (parts.hour >= 6 && parts.hour < 12) sessionNote = 'Morning Pour Window';
+        else if (parts.hour >= 12 && parts.hour < 17) sessionNote = 'Afternoon Cupping Window';
+        else if (parts.hour >= 17 && parts.hour < 22) sessionNote = 'Evening Espresso Window';
+        else sessionNote = 'Late Night / Early Roast';
+
+        return {
+          hour24,
+          hour12,
+          isoDate,
+          readableDate,
+          dayDiff,
+          dayDiffLabel,
+          sessionNote,
+          dstInfo,
+          offsets
+        };
+      }
+
+      /**
+       * Render the coordinator cards or DST transition error.
+       */
+      function renderCoordinator() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value || 'America/New_York';
+
+        const resolution = resolveHostWallTime(dateVal, timeVal, hostTz);
+
+        if (!resolution.valid) {
+          timeInput.classList.add('invalid-input');
+          timeInput.setCustomValidity(resolution.message);
+
+          errorBanner.classList.add('visible');
+          errorBanner.innerHTML = `
+            <strong>Daylight Saving Transition / Schedule Validation Error</strong>
+            <span>${resolution.message}</span>
+          `;
+
+          hostSummary.textContent = `Schedule Rejected: ${resolution.message}`;
+          utcInstantDisplay.textContent = 'Invalid local time (skipped during DST transition)';
+
+          grid.innerHTML = `
+            <div class="error-state" role="alert">
+              <h3>Invalid Event Time Selected</h3>
+              <p>${resolution.message}</p>
+              <p style="margin-top: 8px; font-size: 0.9rem;">Please adjust the event time outside the Daylight Saving Time transition gap to coordinate global tasting times.</p>
+            </div>
+          `;
+          return;
+        }
+
+        // Valid time
+        timeInput.classList.remove('invalid-input');
+        timeInput.setCustomValidity('');
+        errorBanner.classList.remove('visible');
+        errorBanner.innerHTML = '';
+
+        const { epochMs, hostParts, isAmbiguousOverlap } = resolution;
+        const hostFormatted = formatTargetTime(epochMs, hostParts, hostTz);
+        const utcIso = new Date(epochMs).toISOString().replace('.000Z', ' UTC');
+
+        const hostDstStatus = hostFormatted.dstInfo.observesDst
+          ? (hostFormatted.dstInfo.isDstActive ? 'DST Active' : 'Standard Time')
+          : 'No DST Observed';
+
+        const overlapNote = isAmbiguousOverlap
+          ? ' (Note: Ambiguous fall-back hour — using first occurrence)'
+          : '';
+
+        hostSummary.innerHTML = `
+          <span><strong>Host Event:</strong> ${hostFormatted.readableDate} (${hostFormatted.isoDate}) at <strong>${hostFormatted.hour24}</strong> (${hostFormatted.hour12}) in <strong>${hostTz}</strong>${overlapNote}</span>
+          <span><strong>Offset:</strong> ${hostFormatted.offsets.shortOffset} &bull; ${hostDstStatus}</span>
+        `;
+
+        utcInstantDisplay.textContent = `Reference Instant: ${utcIso}`;
+
+        // Ensure the selected host timezone is represented if not already in TARGET_HUBS
+        const hubsToRender = TARGET_HUBS.slice();
+        const hasHostInHubs = hubsToRender.some(h => h.timeZone === hostTz);
+        if (!hasHostInHubs) {
+          const cityName = hostTz.split('/').pop().replace(/_/g, ' ');
+          hubsToRender.unshift({
+            city: cityName,
+            country: 'Host Hub',
+            timeZone: hostTz,
+            roastNote: 'Selected Host Tasting Location'
+          });
+        }
+
+        const cardsHtml = hubsToRender.map(hub => {
+          const info = formatTargetTime(epochMs, hostParts, hub.timeZone);
+          const isHost = hub.timeZone === hostTz;
+
+          let dstBadgeHtml = '';
+          if (info.dstInfo.observesDst) {
+            if (info.dstInfo.isDstActive) {
+              dstBadgeHtml = `<span class="badge badge-dst" title="Daylight Saving Time is currently active">DST Active</span>`;
+            } else {
+              dstBadgeHtml = `<span class="badge badge-std" title="Standard Time is currently active">Standard Time</span>`;
+            }
+          } else {
+            dstBadgeHtml = `<span class="badge badge-std" title="This timezone does not observe Daylight Saving Time">No DST</span>`;
+          }
+
+          const hostBadgeHtml = isHost
+            ? `<span class="badge badge-host">Host Zone</span>`
+            : '';
+
+          return `
+            <article class="card${isHost ? ' is-host' : ''}" data-timezone="${hub.timeZone}" data-city="${hub.city}">
+              <div>
+                <div class="card-top">
+                  <div>
+                    <h3>${hub.city}</h3>
+                    <div class="card-tz-id">${hub.timeZone} &bull; ${hub.country}</div>
+                  </div>
+                  <div class="badge-group">
+                    ${hostBadgeHtml}
+                    ${dstBadgeHtml}
+                  </div>
+                </div>
+
+                <div class="card-time-block">
+                  <div class="card-time-24">${info.hour24}</div>
+                  <div class="card-time-12">${info.hour12} ${info.dstInfo.tzAbbrev ? '(' + info.dstInfo.tzAbbrev + ')' : ''}</div>
+                </div>
+
+                <div class="card-date">${info.readableDate}</div>
+                <div class="card-date-iso">${info.isoDate} &bull; ${hub.roastNote}</div>
+              </div>
+
+              <div class="card-meta">
+                <span>${info.offsets.shortOffset} (${info.offsets.isoOffset})</span>
+                <span class="day-diff">${info.dayDiffLabel}</span>
+              </div>
+            </article>
+          `;
+        }).join('');
+
+        grid.innerHTML = cardsHtml;
+      }
+
+      dateInput.addEventListener('input', renderCoordinator);
+      dateInput.addEventListener('change', renderCoordinator);
+      timeInput.addEventListener('input', renderCoordinator);
+      timeInput.addEventListener('change', renderCoordinator);
+      hostTzSelect.addEventListener('input', renderCoordinator);
+      hostTzSelect.addEventListener('change', renderCoordinator);
+
+      document.querySelectorAll('.preset-btn').forEach(btn => {
+        btn.addEventListener('click', () => {
+          dateInput.value = btn.getAttribute('data-date');
+          timeInput.value = btn.getAttribute('data-time');
+          hostTzSelect.value = btn.getAttribute('data-tz');
+          renderCoordinator();
+        });
+      });
+
+      renderCoordinator();
+    })();
+  </script>
 </body>
 
 </html>
