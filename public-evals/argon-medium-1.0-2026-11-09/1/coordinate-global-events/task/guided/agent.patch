+  <script type="module">
+    const TASTING_DESTINATIONS = [
+      {
+        city: 'Tokyo Roastery',
+        timeZone: 'Asia/Tokyo',
+        roastNote: 'Featured Pour: Matcha-Infused Geisha & Clean Hand-Drip'
+      },
+      {
+        city: 'New York Cupping Room',
+        timeZone: 'America/New_York',
+        roastNote: 'Featured Pour: Brooklyn Reserve Medium Roast'
+      },
+      {
+        city: 'London Espresso Bar',
+        timeZone: 'Europe/London',
+        roastNote: 'Featured Pour: Flat White Flight & Kenyan AA'
+      },
+      {
+        city: 'Seattle Reserve Lab',
+        timeZone: 'America/Los_Angeles',
+        roastNote: 'Featured Pour: Pacific Northwest Cascara Cold Brew'
+      },
+      {
+        city: 'Bogotá Origin Hub',
+        timeZone: 'America/Bogota',
+        roastNote: 'Featured Pour: High-Altitude Huila Washed Bourbon'
+      },
+      {
+        city: 'Addis Ababa Heritage Lounge',
+        timeZone: 'Africa/Addis_Ababa',
+        roastNote: 'Featured Pour: Heirloom Yirgacheffe Sun-Dried Natural'
+      },
+      {
+        city: 'Sydney Harbour Roasters',
+        timeZone: 'Australia/Sydney',
+        roastNote: 'Featured Pour: Sparkling Espresso Tonic & Single Origin'
+      }
+    ];
+
+    function initializeApp() {
+      const form = document.getElementById('tastingForm');
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const grid = document.getElementById('grid');
+      const statusBanner = document.getElementById('statusBanner');
+      const statusTitle = document.getElementById('statusTitle');
+      const statusMessage = document.getElementById('statusMessage');
+      const dstSpringBtn = document.getElementById('dstSpringBtn');
+      const dstFallBtn = document.getElementById('dstFallBtn');
+
+      function updateCoordinator() {
+        const date = dateInput.value.trim();
+        const time = timeInput.value.trim();
+        const timeZone = hostTzSelect.value;
+
+        if (!date || !time || !timeZone) {
+          statusBanner.classList.add('has-conflict');
+          statusTitle.textContent = 'Missing Schedule Input';
+          statusMessage.textContent = 'Please provide a valid date, time, and host time zone.';
+          return;
+        }
+
+        const inputStr = `${date}T${time}[${timeZone}]`;
+
+        // 1. Detect DST transition conflicts (skipped or repeated wall-clock times) using disambiguation: 'reject'
+        let hasConflict = false;
+        try {
+          Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+        } catch (e) {
+          if (e instanceof RangeError) {
+            hasConflict = true;
+          } else {
+            throw e;
+          }
+        }
+
+        // 2. Resolve the host time safely using disambiguation: 'compatible'
+        let hostTime;
+        try {
+          hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+        } catch (e) {
+          statusBanner.classList.add('has-conflict');
+          statusTitle.textContent = 'Invalid Date or Time Format';
+          statusMessage.textContent = 'Please enter a valid calendar date and wall-clock time.';
+          timeInput.setAttribute('aria-invalid', 'true');
+          grid.replaceChildren();
+          return;
+        }
+
+        const resolvedTimeFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit',
+          timeZoneName: 'short'
+        });
+
+        if (hasConflict) {
+          timeInput.setAttribute('aria-invalid', 'true');
+          statusBanner.classList.add('has-conflict');
+          statusTitle.textContent = 'DST Transition Conflict Detected (Rejected Strict Time)';
+          statusMessage.textContent = `The requested wall-clock time (${time}) falls in a Daylight Saving Time transition gap or overlap in ${timeZone}. Strict disambiguation ('reject') flagged this conflict; compatible disambiguation resolved it to ${resolvedTimeFormatted} (${hostTime.offset}).`;
+        } else {
+          timeInput.removeAttribute('aria-invalid');
+          statusBanner.classList.remove('has-conflict');
+          statusTitle.textContent = 'Schedule Synchronized (No DST Conflict)';
+          statusMessage.textContent = `Host session set for ${hostTime.toLocaleString('en-US', {
+            weekday: 'short',
+            month: 'short',
+            day: 'numeric',
+            year: 'numeric',
+            hour: 'numeric',
+            minute: '2-digit',
+            timeZoneName: 'short'
+          })} (${hostTime.offset}).`;
+        }
+
+        // 3. Convert across target time zones using .withTimeZone() and render cards in #grid
+        const fragment = document.createDocumentFragment();
+
+        for (const destination of TASTING_DESTINATIONS) {
+          const convertedZdt = hostTime.withTimeZone(destination.timeZone);
+          const isHost = destination.timeZone === timeZone;
+
+          const formattedTime = convertedZdt.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit'
+          });
+
+          const formattedDate = convertedZdt.toLocaleString('en-US', {
+            weekday: 'short',
+            month: 'short',
+            day: 'numeric',
+            year: 'numeric',
+            timeZoneName: 'short'
+          });
+
+          const card = document.createElement('article');
+          card.className = isHost ? 'card host-card' : 'card';
+          card.dataset.timezone = destination.timeZone;
+
+          const header = document.createElement('div');
+          header.className = 'card-header';
+
+          const title = document.createElement('h3');
+          title.textContent = destination.city;
+
+          const badge = document.createElement('span');
+          badge.className = 'tz-badge';
+          badge.textContent = `${ isHost ? 'HOST • ' : '' }UTC${convertedZdt.offset}`;
+
+          header.append(title, badge);
+
+          const timeEl = document.createElement('p');
+          timeEl.className = 'local-time';
+          timeEl.textContent = formattedTime;
+
+          const dateEl = document.createElement('p');
+          dateEl.className = 'local-date';
+          dateEl.textContent = `${formattedDate} (${destination.timeZone})`;
+
+          const noteEl = document.createElement('p');
+          noteEl.className = 'tasting-note';
+          noteEl.textContent = destination.roastNote;
+
+          card.append(header, timeEl, dateEl, noteEl);
+          fragment.append(card);
+        }
+
+        grid.replaceChildren(fragment);
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        updateCoordinator();
+      });
+
+      dateInput.addEventListener('change', updateCoordinator);
+      timeInput.addEventListener('change', updateCoordinator);
+      hostTzSelect.addEventListener('change', updateCoordinator);
+      dateInput.addEventListener('input', () => {
+        timeInput.removeAttribute('aria-invalid');
+        updateCoordinator();
+      });
+      timeInput.addEventListener('input', () => {
+        timeInput.removeAttribute('aria-invalid');
+        updateCoordinator();
+      });
+
+      dstSpringBtn.addEventListener('click', () => {
+        dateInput.value = '2025-03-09';
+        timeInput.value = '02:30';
+        hostTzSelect.value = 'America/New_York';
+        updateCoordinator();
+      });
+
+      dstFallBtn.addEventListener('click', () => {
+        dateInput.value = '2025-11-02';
+        timeInput.value = '01:30';
+        hostTzSelect.value = 'America/New_York';
+        updateCoordinator();
+      });
+
+      updateCoordinator();
+    }
+
+    // Check if Temporal is supported natively; load polyfill conditionally if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
 </html>
