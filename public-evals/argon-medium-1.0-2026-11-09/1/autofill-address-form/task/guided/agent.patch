+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingSubmit = document.getElementById('shipping-submit');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    if (shippingForm) {
+      const fields = shippingForm.querySelectorAll('input, textarea');
+
+      fields.forEach((field) => {
+        field.addEventListener('blur', () => {
+          if (field.value !== '' && !field.checkValidity()) {
+            field.setAttribute('aria-invalid', 'true');
+          }
+        });
+
+        field.addEventListener('input', () => {
+          if (field.checkValidity()) {
+            field.removeAttribute('aria-invalid');
+          }
+        });
+      });
+
+      shippingForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!shippingForm.checkValidity()) {
+          const firstInvalid = shippingForm.querySelector(':invalid');
+          if (firstInvalid) {
+            firstInvalid.setAttribute('aria-invalid', 'true');
+            firstInvalid.focus();
+          }
+          return;
+        }
+        shippingSubmit.disabled = true;
+        shippingStatus.textContent = 'Shipping address saved. Proceeding to payment...';
+      });
+    }
+  </script>
