+  <script type="module">
+    const seasonalPanel = document.getElementById('seasonal-panel');
+    const tocLinks = document.querySelectorAll('.toc-sidebar a');
+    const headers = seasonalPanel.querySelectorAll('.drink-section h3');
+
+    const setActiveDrink = (id) => {
+      if (!id) return;
+      tocLinks.forEach((link) => {
+        const isActive = link.getAttribute('href') === `#${id}`;
+        link.classList.toggle('active', isActive);
+        link.classList.toggle('target-current', isActive);
+        if (isActive) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    };
+
+    // Listen for native scrollsnapchange when a drink section header settles into view
+    seasonalPanel.addEventListener('scrollsnapchange', (event) => {
+      const snappedHeader = event.snapTargetBlock;
+      if (snappedHeader) {
+        const targetId = snappedHeader.id || snappedHeader.querySelector('[id]')?.id;
+        if (targetId) {
+          setActiveDrink(targetId);
+        }
+      }
+    });
+
+    // Fallback for browsers without scrollsnapchange support
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const observer = new IntersectionObserver(
+        () => {
+          const panelTop = seasonalPanel.getBoundingClientRect().top;
+          const topEntry = [...headers].reduce((currentTop, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom < panelTop) return currentTop;
+            if (!currentTop) return header;
+            return bottom < currentTop.getBoundingClientRect().bottom
+              ? header
+              : currentTop;
+          }, undefined);
+          if (topEntry) {
+            setActiveDrink(topEntry.id);
+          }
+        },
+        { root: seasonalPanel, threshold: 0.9 }
+      );
+
+      headers.forEach((header) => observer.observe(header));
+    }
+
+    // Sync aria-current when native CSS scroll-target-group is supported
+    if (CSS.supports('scroll-target-group: auto')) {
+      const syncAriaCurrent = () => {
+        const currentLink = document.querySelector('.toc-sidebar a:target-current');
+        if (currentLink) {
+          const id = currentLink.getAttribute('href')?.slice(1);
+          if (id) setActiveDrink(id);
+        }
+      };
+      seasonalPanel.addEventListener('scrollend', syncAriaCurrent);
+    }
+
+    // Smoothly scroll to the target drink section when a TOC link is clicked
+    let currentScrollId = 0;
+
+    function scrollIntoViewAsync(element, options, scroller) {
+      const result = element.scrollIntoView(options);
+      if (result instanceof Promise) {
+        return result;
+      }
+      return new Promise((resolve) => {
+        let timeoutId;
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+        const onScroll = () => {
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', async (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetHeader = document.getElementById(targetId);
+        if (!targetHeader) return;
+
+        event.preventDefault();
+        const scrollId = ++currentScrollId;
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+        await scrollIntoViewAsync(
+          targetHeader,
+          { behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' },
+          seasonalPanel
+        );
+
+        if (scrollId !== currentScrollId) return;
+        setActiveDrink(targetId);
+        targetHeader.focus({ preventScroll: true });
+      });
+    });
+  </script>
+
