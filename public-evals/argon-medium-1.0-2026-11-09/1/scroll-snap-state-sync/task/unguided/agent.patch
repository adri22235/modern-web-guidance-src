+  <script>
+    (function () {
+      const sidebar = document.querySelector('.toc-sidebar');
+      const panel = document.querySelector('.seasonal-panel');
+      if (!sidebar || !panel) return;
+
+      const tocLinks = Array.from(sidebar.querySelectorAll('a[href^="#"]'));
+      const sections = Array.from(panel.querySelectorAll('.drink-section'));
+      if (!tocLinks.length || !sections.length) return;
+
+      let activeSectionId = sections[0].id;
+      let clickTargetLock = null;
+      let settleTimer = null;
+
+      function setActiveSection(sectionId) {
+        if (!sectionId) return;
+        activeSectionId = sectionId;
+
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + sectionId;
+          link.classList.toggle('active', isMatch);
+          if (link.parentElement && link.parentElement.tagName === 'LI') {
+            link.parentElement.classList.toggle('active', isMatch);
+          }
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+            link.setAttribute('data-active', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+            link.removeAttribute('data-active');
+          }
+        });
+
+        sections.forEach((section) => {
+          const isMatch = section.id === sectionId;
+          section.classList.toggle('active', isMatch);
+          if (isMatch) {
+            section.setAttribute('data-active', 'true');
+          } else {
+            section.removeAttribute('data-active');
+          }
+        });
+      }
+
+      function getClosestSectionId() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestId = sections[0].id;
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const header = section.querySelector('header') || section;
+          const headerRect = header.getBoundingClientRect();
+          const distance = Math.abs(headerRect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestId = section.id;
+          }
+        });
+
+        return closestId;
+      }
+
+      function syncFromScroll() {
+        if (clickTargetLock) {
+          const elapsed = Date.now() - clickTargetLock.timestamp;
+          const distToTarget = Math.abs(panel.scrollTop - clickTargetLock.targetTop);
+          if (distToTarget <= 6 || elapsed > 600) {
+            clickTargetLock = null;
+          } else {
+            return;
+          }
+        }
+        const closestId = getClosestSectionId();
+        if (closestId !== activeSectionId) {
+          setActiveSection(closestId);
+        }
+      }
+
+      // IntersectionObserver rooted at .seasonal-panel to detect when a section settles into view
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (clickTargetLock) return;
+            let bestEntry = null;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            });
+            if (bestEntry && bestEntry.target && bestEntry.target.id) {
+              setActiveSection(bestEntry.target.id);
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.5, 0.65, 0.8, 0.95]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      // Clear click lock immediately if user manually interacts with the scroll container
+      ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((evtName) => {
+        panel.addEventListener(
+          evtName,
+          () => {
+            clickTargetLock = null;
+          },
+          { passive: true }
+        );
+      });
+
+      panel.addEventListener(
+        'scroll',
+        () => {
+          if (settleTimer) clearTimeout(settleTimer);
+          settleTimer = setTimeout(() => {
+            clickTargetLock = null;
+            setActiveSection(getClosestSectionId());
+          }, 80);
+          syncFromScroll();
+        },
+        { passive: true }
+      );
+
+      panel.addEventListener(
+        'scrollend',
+        () => {
+          if (settleTimer) clearTimeout(settleTimer);
+          clickTargetLock = null;
+          setActiveSection(getClosestSectionId());
+        },
+        { passive: true }
+      );
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection || !panel.contains(targetSection)) return;
+
+          event.preventDefault();
+
+          const targetHeader = targetSection.querySelector('header') || targetSection;
+          const panelRect = panel.getBoundingClientRect();
+          const headerRect = targetHeader.getBoundingClientRect();
+          const targetTop = panel.scrollTop + (headerRect.top - panelRect.top);
+
+          setActiveSection(targetId);
+          clickTargetLock = {
+            id: targetId,
+            targetTop: targetTop,
+            timestamp: Date.now()
+          };
+
+          panel.scrollTo({
+            top: targetTop,
+            behavior: 'smooth'
+          });
+
+          if (history.replaceState) {
+            history.replaceState(null, '', href);
+          }
+        });
+      });
+
+      // Initialize active state on load
+      setActiveSection(getClosestSectionId());
+    })();
+  </script>
+
 </body>
 
