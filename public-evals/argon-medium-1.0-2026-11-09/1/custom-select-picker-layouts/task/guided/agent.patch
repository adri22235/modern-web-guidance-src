+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      if (!CSS.supports("appearance", "base-select")) {
+        return;
+      }
+
+      const roastSelect = document.getElementById("roast-picker");
+      if (!roastSelect) return;
+
+      roastSelect.addEventListener("keydown", (event) => {
+        if (!roastSelect.matches(":open")) return;
+        const { key } = event;
+        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(key)) return;
+
+        const options = Array.from(roastSelect.querySelectorAll("option"));
+        const activeOption = document.activeElement?.closest("option");
+        if (!activeOption || !options.includes(activeOption)) return;
+
+        const currentRect = activeOption.getBoundingClientRect();
+        const cx = currentRect.left + currentRect.width / 2;
+        const cy = currentRect.top + currentRect.height / 2;
+
+        let bestCandidate = null;
+        let bestDistance = Infinity;
+
+        for (const opt of options) {
+          if (opt === activeOption) continue;
+          const rect = opt.getBoundingClientRect();
+          const ox = rect.left + rect.width / 2;
+          const oy = rect.top + rect.height / 2;
+          const dx = ox - cx;
+          const dy = oy - cy;
+
+          const isMatch =
+            (key === "ArrowRight" && dx > 4 && Math.abs(dy) <= currentRect.height) ||
+            (key === "ArrowLeft" && dx < -4 && Math.abs(dy) <= currentRect.height) ||
+            (key === "ArrowDown" && dy > 4 && Math.abs(dx) <= currentRect.width) ||
+            (key === "ArrowUp" && dy < -4 && Math.abs(dx) <= currentRect.width);
+
+          if (isMatch) {
+            const distance = Math.hypot(dx, dy);
+            if (distance < bestDistance) {
+              bestDistance = distance;
+              bestCandidate = opt;
+            }
+          }
+        }
+
+        if (bestCandidate) {
+          event.preventDefault();
+          bestCandidate.focus();
+        }
+      });
+    });
+  </script>
