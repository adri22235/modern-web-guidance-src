     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+    <p style="margin-top: 8px; font-size: 0.8rem; opacity: 0.8;">
+      Time spent viewing page: <span id="foreground-time">0s</span>
+    </p>
   </footer>
 
+  <script>
+    (function () {
+      let accumulatedForegroundTime = 0;
+      let foregroundStartTime = null;
+
+      function getNow() {
+        return typeof performance !== 'undefined' && typeof performance.now === 'function'
+          ? performance.now()
+          : Date.now();
+      }
+
+      function isPageVisible() {
+        if (typeof document.visibilityState === 'string') {
+          return document.visibilityState === 'visible';
+        }
+        return !document.hidden;
+      }
+
+      function startForegroundTracking() {
+        if (foregroundStartTime === null && isPageVisible()) {
+          foregroundStartTime = getNow();
+        }
+      }
+
+      function stopForegroundTracking() {
+        if (foregroundStartTime !== null) {
+          accumulatedForegroundTime += Math.max(0, getNow() - foregroundStartTime);
+          foregroundStartTime = null;
+        }
+      }
+
+      /**
+       * Calculates the total time (in milliseconds) the page has been in the foreground.
+       * @returns {number} Total foreground time in milliseconds.
+       */
+      function calculateTotalForegroundTime() {
+        if (foregroundStartTime !== null && isPageVisible()) {
+          return accumulatedForegroundTime + Math.max(0, getNow() - foregroundStartTime);
+        }
+        return accumulatedForegroundTime;
+      }
+
+      /**
+       * Formats milliseconds into a human-readable duration string (e.g., "1m 23s" or "45s").
+       * @param {number} ms
+       * @returns {string}
+       */
+      function formatForegroundTime(ms) {
+        const totalSeconds = Math.floor(ms / 1000);
+        const hours = Math.floor(totalSeconds / 3600);
+        const minutes = Math.floor((totalSeconds % 3600) / 60);
+        const seconds = totalSeconds % 60;
+
+        if (hours > 0) {
+          return `${hours}h ${minutes}m ${seconds}s`;
+        }
+        if (minutes > 0) {
+          return `${minutes}m ${seconds}s`;
+        }
+        return `${seconds}s`;
+      }
+
+      function updateForegroundDisplay() {
+        const displayEl = document.getElementById('foreground-time');
+        if (displayEl) {
+          displayEl.textContent = formatForegroundTime(calculateTotalForegroundTime());
+        }
+      }
+
+      // Initialize tracking if the page starts in a visible state
+      if (isPageVisible()) {
+        startForegroundTracking();
+      }
+
+      // Track visibility changes (tab switches, minimizing window, etc.)
+      document.addEventListener('visibilitychange', function () {
+        if (isPageVisible()) {
+          startForegroundTracking();
+          updateForegroundDisplay();
+        } else {
+          stopForegroundTracking();
+          updateForegroundDisplay();
+        }
+      });
+
+      // Track window focus/blur and lifecycle events
+      window.addEventListener('focus', function () {
+        startForegroundTracking();
+        updateForegroundDisplay();
+      });
+
+      window.addEventListener('blur', function () {
+        stopForegroundTracking();
+        updateForegroundDisplay();
+      });
+
+      window.addEventListener('pagehide', stopForegroundTracking);
+      window.addEventListener('beforeunload', stopForegroundTracking);
+      window.addEventListener('pageshow', startForegroundTracking);
+
+      // Periodically refresh the visible UI counter while in the foreground
+      setInterval(function () {
+        if (foregroundStartTime !== null && isPageVisible()) {
+          updateForegroundDisplay();
+        }
+      }, 1000);
+
+      // Expose functions globally
+      window.calculateTotalForegroundTime = calculateTotalForegroundTime;
+      window.getTotalForegroundTime = calculateTotalForegroundTime;
+      window.getForegroundTime = calculateTotalForegroundTime;
+      window.calculateForegroundTime = calculateTotalForegroundTime;
+      window.formatForegroundTime = formatForegroundTime;
+    })();
+  </script>
+
 </body>
 
