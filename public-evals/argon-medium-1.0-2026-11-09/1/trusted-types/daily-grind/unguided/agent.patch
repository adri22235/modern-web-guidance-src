+  <script>
+    (() => {
+      const escapeHTML = (str) =>
+        String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+
+      const sanitizeHTML = (html) =>
+        String(html)
+          .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
+          .replace(/<\/?(?:script|iframe|object|embed|svg|math|style|link|meta|base|form)\b[^>]*>/gi, '')
+          .replace(/\s+on[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
+          .replace(
+            /\b(href|src|action|formaction|xlink:href)\s*=\s*(?:"\s*(?:javascript|data|vbscript):[^"]*"|'\s*(?:javascript|data|vbscript):[^']*'|(?:\s*(?:javascript|data|vbscript):[^\s>]+))/gi,
+            '$1="#"'
+          );
+
+      const policy =
+        window.trustedTypes && window.trustedTypes.createPolicy
+          ? window.trustedTypes.createPolicy('seasonal-favorites', {
+              createHTML: (input) => sanitizeHTML(input)
+            })
+          : {
+              createHTML: (input) => sanitizeHTML(input)
+            };
+
+      const seasonalFavorites = [
+        {
+          title: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          href: '/menu/seasonal',
+          cta: 'View Details'
+        },
+        {
+          title: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          href: '/menu/espresso',
+          cta: 'View Details'
+        },
+        {
+          title: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          href: '/menu/cold-brew',
+          cta: 'View Details'
+        }
+      ];
+
+      const cardHTMLStrings = seasonalFavorites.map(
+        (item) => `
+        <div class="card">
+          <h3>${escapeHTML(item.title)}</h3>
+          <p>${escapeHTML(item.description)}</p>
+          <a href="${escapeHTML(item.href)}" class="btn">${escapeHTML(item.cta)}</a>
+        </div>`
+      );
+
+      const grid = document.querySelector('.grid');
+      if (grid) {
+        grid.innerHTML = policy.createHTML(cardHTMLStrings.join(''));
+      }
+    })();
+  </script>
+
 </body>
 
