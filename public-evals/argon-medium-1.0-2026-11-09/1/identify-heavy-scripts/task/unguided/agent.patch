+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_script_perf_history';
+      const MAX_RECORDS = 100;
+      const FRAME_DELAY_THRESHOLD_MS = 50;
+      const SCRIPT_DURATION_THRESHOLD_MS = 5;
+
+      function loadPastOccurrences() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (!raw) return [];
+          const parsed = JSON.parse(raw);
+          return Array.isArray(parsed) ? parsed : [];
+        } catch (e) {
+          return [];
+        }
+      }
+
+      function saveOccurrences(records) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(records.slice(0, MAX_RECORDS)));
+        } catch (e) {
+          // Ignore storage quota or privacy mode errors
+        }
+      }
+
+      const state = {
+        occurrences: loadPastOccurrences(),
+        seenEntryKeys: new Set(),
+        observers: []
+      };
+
+      function createOccurrenceKey(entryType, startTime, duration, scriptIndex) {
+        return `${entryType}:${Math.round(startTime * 100)}:${Math.round(duration * 100)}:${scriptIndex || 0}`;
+      }
+
+      function recordOccurrence(occurrence) {
+        state.occurrences.unshift(occurrence);
+        if (state.occurrences.length > MAX_RECORDS) {
+          state.occurrences.length = MAX_RECORDS;
+        }
+        saveOccurrences(state.occurrences);
+        updateUI();
+        window.dispatchEvent(new CustomEvent('slow-script-detected', { detail: occurrence }));
+      }
+
+      function processLongAnimationFrameEntry(entry) {
+        const frameDuration = entry.duration || 0;
+        if (frameDuration < FRAME_DELAY_THRESHOLD_MS) return;
+
+        const scripts = Array.isArray(entry.scripts) ? entry.scripts : [];
+        const renderDelay = entry.renderStart > 0
+          ? Math.max(0, entry.renderStart - entry.startTime)
+          : frameDuration;
+        const styleAndLayoutDuration = (entry.renderStart > 0 && entry.styleAndLayoutStart > 0)
+          ? Math.max(0, (entry.startTime + entry.duration) - entry.styleAndLayoutStart)
+          : 0;
+
+        if (scripts.length > 0) {
+          scripts.forEach(function (script, index) {
+            const scriptDuration = script.duration || 0;
+            if (scriptDuration < SCRIPT_DURATION_THRESHOLD_MS && scripts.length > 1) {
+              return;
+            }
+            const key = createOccurrenceKey('long-animation-frame', entry.startTime, frameDuration, index);
+            if (state.seenEntryKeys.has(key)) return;
+            state.seenEntryKeys.add(key);
+
+            recordOccurrence({
+              id: key,
+              timestamp: new Date(performance.timeOrigin + entry.startTime).toISOString(),
+              entryType: 'long-animation-frame',
+              frameStartTime: Math.round(entry.startTime * 100) / 100,
+              frameDuration: Math.round(frameDuration * 100) / 100,
+              blockingDuration: Math.round((entry.blockingDuration || 0) * 100) / 100,
+              renderDelay: Math.round(renderDelay * 100) / 100,
+              styleAndLayoutDuration: Math.round(styleAndLayoutDuration * 100) / 100,
+              firstUIEventTimestamp: entry.firstUIEventTimestamp || 0,
+              script: {
+                invoker: script.invoker || 'anonymous',
+                invokerType: script.invokerType || 'unknown',
+                sourceURL: script.sourceURL || window.location.href,
+                sourceFunctionName: script.sourceFunctionName || '(anonymous)',
+                sourceCharPosition: typeof script.sourceCharPosition === 'number' ? script.sourceCharPosition : -1,
+                executionStart: Math.round((script.executionStart || entry.startTime) * 100) / 100,
+                duration: Math.round(scriptDuration * 100) / 100,
+                forcedStyleAndLayoutDuration: Math.round((script.forcedStyleAndLayoutDuration || 0) * 100) / 100,
+                pauseDuration: Math.round((script.pauseDuration || 0) * 100) / 100,
+                windowAttribution: script.windowAttribution || 'self'
+              }
+            });
+          });
+        } else {
+          const key = createOccurrenceKey('long-animation-frame', entry.startTime, frameDuration, -1);
+          if (state.seenEntryKeys.has(key)) return;
+          state.seenEntryKeys.add(key);
+
+          recordOccurrence({
+            id: key,
+            timestamp: new Date(performance.timeOrigin + entry.startTime).toISOString(),
+            entryType: 'long-animation-frame',
+            frameStartTime: Math.round(entry.startTime * 100) / 100,
+            frameDuration: Math.round(frameDuration * 100) / 100,
+            blockingDuration: Math.round((entry.blockingDuration || 0) * 100) / 100,
+            renderDelay: Math.round(renderDelay * 100) / 100,
+            styleAndLayoutDuration: Math.round(styleAndLayoutDuration * 100) / 100,
+            firstUIEventTimestamp: entry.firstUIEventTimestamp || 0,
+            script: {
+              invoker: entry.name || 'frame-task',
+              invokerType: 'frame',
+              sourceURL: window.location.href,
+              sourceFunctionName: '(unattributed)',
+              sourceCharPosition: -1,
+              executionStart: Math.round(entry.startTime * 100) / 100,
+              duration: Math.round(frameDuration * 100) / 100,
+              forcedStyleAndLayoutDuration: 0,
+              pauseDuration: 0,
+              windowAttribution: 'self'
+            }
+          });
+        }
+      }
+
+      function processLongTaskEntry(entry) {
+        const duration = entry.duration || 0;
+        if (duration < FRAME_DELAY_THRESHOLD_MS) return;
+
+        const key = createOccurrenceKey('longtask', entry.startTime, duration, 0);
+        if (state.seenEntryKeys.has(key)) return;
+        state.seenEntryKeys.add(key);
+
+        const attribution = Array.isArray(entry.attribution) && entry.attribution[0] ? entry.attribution[0] : {};
+        recordOccurrence({
+          id: key,
+          timestamp: new Date(performance.timeOrigin + entry.startTime).toISOString(),
+          entryType: 'longtask',
+          frameStartTime: Math.round(entry.startTime * 100) / 100,
+          frameDuration: Math.round(duration * 100) / 100,
+          blockingDuration: Math.round(Math.max(0, duration - 50) * 100) / 100,
+          renderDelay: Math.round(duration * 100) / 100,
+          styleAndLayoutDuration: 0,
+          firstUIEventTimestamp: 0,
+          script: {
+            invoker: attribution.containerName || attribution.name || entry.name || 'longtask',
+            invokerType: attribution.containerType || 'script',
+            sourceURL: attribution.containerSrc || window.location.href,
+            sourceFunctionName: attribution.name || '(longtask)',
+            sourceCharPosition: -1,
+            executionStart: Math.round(entry.startTime * 100) / 100,
+            duration: Math.round(duration * 100) / 100,
+            forcedStyleAndLayoutDuration: 0,
+            pauseDuration: 0,
+            windowAttribution: entry.name || 'self'
+          }
+        });
+      }
+
+      function initPerformanceMonitoring() {
+        if (typeof PerformanceObserver === 'undefined') return;
+
+        const supportedTypes = Array.isArray(PerformanceObserver.supportedEntryTypes)
+          ? PerformanceObserver.supportedEntryTypes
+          : [];
+
+        // Observe Long Animation Frames (LoAF) with buffered: true to capture past occurrences
+        if (supportedTypes.includes('long-animation-frame')) {
+          try {
+            const loafObserver = new PerformanceObserver(function (list) {
+              list.getEntries().forEach(processLongAnimationFrameEntry);
+            });
+            loafObserver.observe({ type: 'long-animation-frame', buffered: true });
+            state.observers.push(loafObserver);
+          } catch (e) {
+            // Fallback if observe fails
+          }
+        } else {
+          // Try observing long-animation-frame even if supportedEntryTypes is incomplete, fallback to longtask
+          try {
+            const loafObserver = new PerformanceObserver(function (list) {
+              list.getEntries().forEach(processLongAnimationFrameEntry);
+            });
+            loafObserver.observe({ type: 'long-animation-frame', buffered: true });
+            state.observers.push(loafObserver);
+          } catch (e) {
+            // Ignore if unsupported
+          }
+        }
+
+        // Also observe longtask with buffered: true if long-animation-frame is unavailable
+        if (!supportedTypes.includes('long-animation-frame') && supportedTypes.includes('longtask')) {
+          try {
+            const longTaskObserver = new PerformanceObserver(function (list) {
+              list.getEntries().forEach(processLongTaskEntry);
+            });
+            longTaskObserver.observe({ type: 'longtask', buffered: true });
+            state.observers.push(longTaskObserver);
+          } catch (e) {
+            // Ignore if unsupported
+          }
+        }
+
+        // Also inspect any already-buffered entries via performance.getEntriesByType
+        if (typeof performance !== 'undefined' && typeof performance.getEntriesByType === 'function') {
+          try {
+            const bufferedLoaf = performance.getEntriesByType('long-animation-frame') || [];
+            bufferedLoaf.forEach(processLongAnimationFrameEntry);
+          } catch (e) {}
+        }
+      }
+
+      function formatSource(script) {
+        if (!script) return 'unknown';
+        const fn = script.sourceFunctionName && script.sourceFunctionName !== '(anonymous)'
+          ? `${script.sourceFunctionName}()`
+          : script.invoker || 'anonymous';
+        const url = script.sourceURL ? script.sourceURL.split('/').pop() || script.sourceURL : 'inline';
+        const pos = typeof script.sourceCharPosition === 'number' && script.sourceCharPosition >= 0
+          ? `:${script.sourceCharPosition}`
+          : '';
+        return `${fn} (${url}${pos})`;
+      }
+
+      function updateUI() {
+        const totalEl = document.getElementById('perf-total-count');
+        const maxDurationEl = document.getElementById('perf-max-duration');
+        const totalBlockingEl = document.getElementById('perf-total-blocking');
+        const tbody = document.getElementById('perf-occurrences-body');
+
+        if (!tbody) return;
+
+        const records = state.occurrences;
+        const totalCount = records.length;
+        const maxFrameDuration = records.reduce(function (max, r) {
+          return Math.max(max, r.frameDuration || 0);
+        }, 0);
+        const totalBlocking = records.reduce(function (sum, r) {
+          return sum + (r.blockingDuration || 0);
+        }, 0);
+
+        if (totalEl) totalEl.textContent = String(totalCount);
+        if (maxDurationEl) maxDurationEl.textContent = `${Math.round(maxFrameDuration)} ms`;
+        if (totalBlockingEl) totalBlockingEl.textContent = `${Math.round(totalBlocking)} ms`;
+
+        tbody.innerHTML = '';
+        if (records.length === 0) {
