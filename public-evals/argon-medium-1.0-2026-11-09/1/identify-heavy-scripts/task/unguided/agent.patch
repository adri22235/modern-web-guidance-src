+          td.textContent = 'No slow scripts or frame delays (>50ms) recorded yet.';
+          tr.appendChild(td);
+          tbody.appendChild(tr);
+          return;
+        }
+
+        records.forEach(function (item) {
+          const tr = document.createElement('tr');
+
+          const timeTd = document.createElement('td');
+          const date = item.timestamp ? new Date(item.timestamp) : null;
+          timeTd.textContent = date && !isNaN(date.getTime())
+            ? date.toLocaleTimeString()
+            : `${item.frameStartTime} ms`;
+
+          const invokerTd = document.createElement('td');
+          invokerTd.textContent = item.script
+            ? `${item.script.invoker} (${item.script.invokerType})`
+            : 'unknown';
+
+          const sourceTd = document.createElement('td');
+          sourceTd.textContent = formatSource(item.script);
+
+          const scriptDurTd = document.createElement('td');
+          scriptDurTd.textContent = `${item.script ? item.script.duration : item.frameDuration} ms`;
+
+          const frameDurTd = document.createElement('td');
+          frameDurTd.textContent = `${item.frameDuration} ms`;
+
+          const blockingTd = document.createElement('td');
+          blockingTd.textContent = `${item.blockingDuration || 0} ms`;
+
+          tr.appendChild(timeTd);
+          tr.appendChild(invokerTd);
+          tr.appendChild(sourceTd);
+          tr.appendChild(scriptDurTd);
+          tr.appendChild(frameDurTd);
+          tr.appendChild(blockingTd);
+          tbody.appendChild(tr);
+        });
+      }
+
+      function simulateSlowScript(durationMs) {
+        const targetMs = typeof durationMs === 'number' && durationMs > 0 ? durationMs : 85;
+        const startPerf = performance.now();
+        while (performance.now() - startPerf < targetMs) {
+          // Busy wait to simulate slow synchronous script causing frame delay
+        }
+        const actualDuration = performance.now() - startPerf;
+
+        // If browser does not emit a LoAF/longtask entry within 150ms (e.g. unsupported environment), record directly
+        setTimeout(function () {
+          const recentlyRecorded = state.occurrences.some(function (r) {
+            return Math.abs(r.frameStartTime - startPerf) < 100;
+          });
+          if (!recentlyRecorded) {
+            const key = createOccurrenceKey('manual-probe', startPerf, actualDuration, 0);
+            if (!state.seenEntryKeys.has(key)) {
+              state.seenEntryKeys.add(key);
+              recordOccurrence({
+                id: key,
+                timestamp: new Date(performance.timeOrigin + startPerf).toISOString(),
+                entryType: 'long-animation-frame',
+                frameStartTime: Math.round(startPerf * 100) / 100,
+                frameDuration: Math.round(actualDuration * 100) / 100,
+                blockingDuration: Math.round(Math.max(0, actualDuration - 50) * 100) / 100,
+                renderDelay: Math.round(actualDuration * 100) / 100,
+                styleAndLayoutDuration: 0,
+                firstUIEventTimestamp: 0,
+                script: {
+                  invoker: 'BUTTON#simulate-slow-script.onclick',
+                  invokerType: 'event-listener',
+                  sourceURL: window.location.href,
+                  sourceFunctionName: 'simulateSlowScript',
+                  sourceCharPosition: 0,
+                  executionStart: Math.round(startPerf * 100) / 100,
+                  duration: Math.round(actualDuration * 100) / 100,
+                  forcedStyleAndLayoutDuration: 0,
+                  pauseDuration: 0,
+                  windowAttribution: 'self'
+                }
+              });
+            }
+          }
+        }, 150);
+      }
+
+      function clearHistory() {
+        state.occurrences = [];
+        state.seenEntryKeys.clear();
+        saveOccurrences([]);
+        updateUI();
+      }
+
+      window.scriptPerformanceMonitor = {
+        getOccurrences: function () {
+          return state.occurrences.slice();
+        },
+        recordOccurrence: recordOccurrence,
+        simulateSlowScript: simulateSlowScript,
+        clearHistory: clearHistory
+      };
+
+      initPerformanceMonitoring();
+
+      window.addEventListener('DOMContentLoaded', function () {
+        updateUI();
+
+        const simBtn = document.getElementById('simulate-slow-script');
+        if (simBtn) {
+          simBtn.addEventListener('click', function () {
+            simulateSlowScript(85);
+          });
+        }
+
+        const clearBtn = document.getElementById('clear-perf-history');
+        if (clearBtn) {
+          clearBtn.addEventListener('click', clearHistory);
+        }
+      });
+    })();
+  </script>
