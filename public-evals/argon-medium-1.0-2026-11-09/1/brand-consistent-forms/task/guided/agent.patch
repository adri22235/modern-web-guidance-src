+  <script>
+    (() => {
+      const form = document.getElementById('coffee-subscription-form');
+      const roastSlider = document.getElementById('roast-preference');
+      const roastOutput = document.getElementById('roast-preference-output');
+      const progressEl = document.getElementById('subscription-progress');
+      const progressLabel = document.getElementById('subscription-progress-label');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMsg = document.getElementById('subscription-status');
+
+      const roastNames = {
+        1: 'Light Roast (1/5)',
+        2: 'Light-Medium (2/5)',
+        3: 'Medium Roast (3/5)',
+        4: 'Medium-Dark (4/5)',
+        5: 'Dark Espresso (5/5)'
+      };
+
+      let roastTouched = false;
+
+      function updateSliderProgress(slider) {
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 100;
+        const val = Number(slider.value);
+        const pct = ((val - min) / (max - min)) * 100;
+        slider.style.setProperty('--progress', `${pct}%`);
+      }
+
+      function updateSetupProgress(submitted = false) {
+        if (submitted) {
+          progressEl.value = 100;
+          progressEl.textContent = '100%';
+          progressLabel.textContent = '100%';
+          return;
+        }
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        let completion = 25; // Base roast preference ready
+        if (selectedFreq) completion += 25;
+        if (emailCheckbox.checked) completion += 25;
+        if (roastTouched) completion += 25;
+
+        progressEl.value = completion;
+        progressEl.textContent = `${completion}%`;
+        progressLabel.textContent = `${completion}%`;
+      }
+
+      roastSlider.addEventListener('input', (e) => {
+        roastTouched = true;
+        const val = Number(e.target.value);
+        roastOutput.textContent = roastNames[val] || `Level ${val}/5`;
+        if (!CSS.supports('accent-color', '#4e342e')) {
+          updateSliderProgress(e.target);
+        } else {
+          updateSliderProgress(e.target);
+        }
+        updateSetupProgress();
+      });
+
+      form.addEventListener('change', () => {
+        updateSetupProgress();
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        roastTouched = true;
+        updateSetupProgress(true);
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        const freqLabel = selectedFreq ? selectedFreq.nextElementSibling.textContent : 'Every 2 Weeks';
+        const roastLabel = roastNames[Number(roastSlider.value)];
+        statusMsg.hidden = false;
+        statusMsg.textContent = `✓ Subscription setup complete: ${roastLabel}, delivered ${freqLabel.toLowerCase()}.`;
+      });
+    })();
+  </script>
 </body>
 
