+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      const progress = document.getElementById('subscription-progress');
+      const progressBadge = document.getElementById('progress-label-value');
+      const roastInput = document.getElementById('roast-preference');
+      const roastOutput = document.getElementById('roast-output');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMessage = document.getElementById('subscription-status');
+
+      const roastNames = {
+        1: '1 - Light Roast',
+        2: '2 - Medium-Light Roast',
+        3: '3 - Medium Roast',
+        4: '4 - Medium-Dark Roast',
+        5: '5 - Dark Roast'
+      };
+
+      function updateFormState() {
+        const selectedFrequency = form.querySelector('input[name="delivery-frequency"]:checked');
+        const hasRoast = roastInput && roastInput.value !== '';
+        const hasEmails = emailCheckbox && emailCheckbox.checked;
+
+        if (roastInput && roastOutput) {
+          roastOutput.textContent = roastNames[roastInput.value] || roastInput.value;
+        }
+
+        let completedSteps = 0;
+        const totalSteps = 3;
+        if (selectedFrequency) completedSteps += 1;
+        if (hasRoast) completedSteps += 1;
+        if (hasEmails) completedSteps += 1;
+
+        const percent = Math.round((completedSteps / totalSteps) * 100);
+        if (progress) {
+          progress.value = percent;
+          progress.textContent = percent + '%';
+        }
+        if (progressBadge) {
+          progressBadge.textContent = percent + '% Complete';
+        }
+      }
+
+      if (form) {
+        form.addEventListener('input', updateFormState);
+        form.addEventListener('change', updateFormState);
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          if (progress) {
+            progress.value = 100;
+            progress.textContent = '100%';
+          }
+          if (progressBadge) {
+            progressBadge.textContent = '100% Complete';
+          }
+          if (statusMessage) {
+            statusMessage.textContent = 'Your personalized coffee subscription preferences have been saved!';
+          }
+        });
+        updateFormState();
+      }
+    })();
+  </script>
