+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const ctx = canvas.getContext('2d');
+      const uiElement = document.getElementById('cup-customizer-ui');
+      const form = document.getElementById('coffee-customizer-form');
+      const nameInput = document.getElementById('cup-name-input');
+      const milkSelect = document.getElementById('cup-milk-select');
+      const syrupSelect = document.getElementById('cup-syrup-select');
+      const liveNameDisplay = document.getElementById('live-name-display');
+      const liveMilkDisplay = document.getElementById('live-milk-display');
+      const liveSyrupDisplay = document.getElementById('live-syrup-display');
+
+      const milkTints = {
+        'Oat Milk': '#d7b899',
+        'Whole Milk': '#e6ccb2',
+        'Almond Milk': '#d2b48c',
+        'Coconut Milk': '#ede0d4',
+        'Soy Milk': '#ddb892',
+        'Skim Milk': '#c9ada7'
+      };
+
+      const syrupTints = {
+        'Vermont Maple': '#b5651d',
+        'Vanilla': '#f3d59b',
+        'Caramel': '#d97724',
+        'Hazelnut': '#8d5524',
+        'Cinnamon Dolce': '#a44a3f',
+        'No Syrup': 'transparent'
+      };
+
+      function getScaleFactor() {
+        const cssWidth = canvas.clientWidth || 520;
+        return canvas.width > 0 && cssWidth > 0 ? canvas.width / cssWidth : (window.devicePixelRatio || 1);
+      }
+
+      function drawCoffeeCup(context) {
+        const scale = getScaleFactor();
+        const width = (canvas.width || 520) / scale;
+        const height = (canvas.height || 620) / scale;
+        const cx = width / 2;
+
+        const milkColor = milkTints[milkSelect.value] || '#d7b899';
+        const syrupColor = syrupTints[syrupSelect.value] || '#b5651d';
+
+        context.save();
+        context.scale(scale, scale);
+
+        // Soft background glow
+        const bgGrad = context.createRadialGradient(cx, height * 0.5, 30, cx, height * 0.5, width * 0.5);
+        bgGrad.addColorStop(0, '#fffdf9');
+        bgGrad.addColorStop(1, '#f5ebe6');
+        context.fillStyle = bgGrad;
+        context.fillRect(0, 0, width, height);
+
+        // Steam wisps above lid
+        context.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        context.lineWidth = 3;
+        context.lineCap = 'round';
+        [-40, 0, 40].forEach((offset, idx) => {
+          context.beginPath();
+          const startX = cx + offset;
+          context.moveTo(startX, 66);
+          context.bezierCurveTo(startX - 12, 48, startX + 14, 34, startX - 4 + idx * 3, 18);
+          context.stroke();
+        });
+
+        // Saucer shadow at base
+        context.fillStyle = 'rgba(62, 39, 35, 0.14)';
+        context.beginPath();
+        context.ellipse(cx, 582, 130, 18, 0, 0, Math.PI * 2);
+        context.fill();
+
+        // Coffee cup body (tapered artisanal cup)
+        const topHalfW = 166;
+        const botHalfW = 124;
+        const cupTopY = 122;
+        const cupBotY = 574;
+
+        context.beginPath();
+        context.moveTo(cx - topHalfW, cupTopY);
+        context.lineTo(cx + topHalfW, cupTopY);
+        context.lineTo(cx + botHalfW, cupBotY);
+        context.quadraticCurveTo(cx, cupBotY + 14, cx - botHalfW, cupBotY);
+        context.closePath();
+
+        const cupGrad = context.createLinearGradient(cx - topHalfW, cupTopY, cx + topHalfW, cupTopY);
+        cupGrad.addColorStop(0, '#f7f1eb');
+        cupGrad.addColorStop(0.5, '#ffffff');
+        cupGrad.addColorStop(1, '#e6dcd5');
+        context.fillStyle = cupGrad;
+        context.fill();
+        context.lineWidth = 3;
+        context.strokeStyle = '#5d4037';
+        context.stroke();
+
+        // Crema / milk band near top of cup
+        context.beginPath();
+        context.moveTo(cx - topHalfW + 4, cupTopY + 14);
+        context.lineTo(cx + topHalfW - 4, cupTopY + 14);
+        context.lineTo(cx + topHalfW - 9, cupTopY + 52);
+        context.lineTo(cx - topHalfW + 9, cupTopY + 52);
+        context.closePath();
+        context.fillStyle = milkColor;
+        context.fill();
+
+        // Syrup drizzle wave inside the crema band
+        if (syrupSelect.value !== 'No Syrup' && syrupColor !== 'transparent') {
+          context.beginPath();
+          context.moveTo(cx - topHalfW + 22, cupTopY + 33);
+          for (let x = -topHalfW + 22; x <= topHalfW - 22; x += 28) {
+            context.quadraticCurveTo(cx + x + 7, cupTopY + 23, cx + x + 14, cupTopY + 33);
+            context.quadraticCurveTo(cx + x + 21, cupTopY + 43, cx + x + 28, cupTopY + 33);
+          }
+          context.strokeStyle = syrupColor;
+          context.lineWidth = 4;
+          context.stroke();
+        }
+
+        // Kraft cardboard coffee sleeve backing behind the interactive HTML UI
+        const sleeveTopY = 178;
+        const sleeveBotY = 516;
+        const sleeveTopHalfW = 156;
+        const sleeveBotHalfW = 132;
+
+        context.beginPath();
+        context.moveTo(cx - sleeveTopHalfW, sleeveTopY);
+        context.lineTo(cx + sleeveTopHalfW, sleeveTopY);
+        context.lineTo(cx + sleeveBotHalfW, sleeveBotY);
+        context.lineTo(cx - sleeveBotHalfW, sleeveBotY);
+        context.closePath();
+
+        const sleeveGrad = context.createLinearGradient(cx - sleeveTopHalfW, sleeveTopY, cx + sleeveTopHalfW, sleeveTopY);
+        sleeveGrad.addColorStop(0, '#c8a986');
+        sleeveGrad.addColorStop(0.5, '#dfc3a3');
+        sleeveGrad.addColorStop(1, '#b89772');
+        context.fillStyle = sleeveGrad;
+        context.fill();
+        context.lineWidth = 2.5;
+        context.strokeStyle = '#6d4c41';
+        context.stroke();
+
+        // Coffee lid
+        context.fillStyle = '#4e342e';
+        context.beginPath();
+        context.roundRect(cx - topHalfW - 12, 96, (topHalfW + 12) * 2, 28, 8);
+        context.fill();
+        context.strokeStyle = '#3e2723';
+        context.lineWidth = 2;
+        context.stroke();
+
+        context.fillStyle = '#5d4037';
+        context.beginPath();
+        context.roundRect(cx - topHalfW + 10, 76, (topHalfW - 10) * 2, 22, [10, 10, 2, 2]);
+        context.fill();
+        context.stroke();
+
+        // Bottom brand stamp on cup
+        context.fillStyle = '#4e342e';
+        context.font = 'bold 12px "Segoe UI", Tahoma, sans-serif';
+        context.textAlign = 'center';
+        context.fillText('THE DAILY GRIND • FRESHLY BREWED', cx, 548);
+
+        context.restore();
+      }
+
+      function syncLiveText() {
+        const trimmedName = nameInput.value.trim() || 'Guest';
+        liveNameDisplay.textContent = trimmedName;
+        liveMilkDisplay.textContent = milkSelect.value;
+        liveSyrupDisplay.textContent = syrupSelect.value;
+      }
+
+      canvas.onpaint = () => {
+        ctx.reset();
+        drawCoffeeCup(ctx);
+
+        const scale = getScaleFactor();
+        const uiWidth = uiElement.offsetWidth || 264;
+        const cssWidth = (canvas.width || 520) / scale;
+        const drawX = Math.round(((cssWidth - uiWidth) / 2) * scale);
+        const drawY = Math.round(192 * scale);
+
+        if (typeof ctx.drawElementImage === 'function') {
+          // Draw the drawable HTML element onto the cup sleeve; in 2D context,
+          // drawElementImage automatically syncs the DOM element geometry for hit testing.
+          ctx.drawElementImage(uiElement, drawX, drawY);
+        }
+      };
+
+      function requestCupPaint() {
+        syncLiveText();
+        if ('content' in HTMLCanvasElement.prototype && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else if (typeof canvas.onpaint === 'function') {
+          canvas.onpaint();
+        }
+      }
+
+      // Check browser support for HTML-in-Canvas API
+      if ('content' in HTMLCanvasElement.prototype) {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      } else {
+        // Fallback strategy when HTML-in-Canvas is not supported
+        canvas.classList.add('canvas-fallback');
+        canvas.onpaint();
+      }
+
+      // Scale canvas grid to match device pixels to prevent blurriness on high-DPI displays
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        requestCupPaint();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      nameInput.addEventListener('input', requestCupPaint);
+      milkSelect.addEventListener('change', requestCupPaint);
+      syrupSelect.addEventListener('change', requestCupPaint);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        requestCupPaint();
+      });
+    })();
+  </script>
+
 </body>
 
