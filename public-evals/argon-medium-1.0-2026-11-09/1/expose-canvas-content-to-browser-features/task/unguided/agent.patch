+  <script>
+    (function () {
+      const canvas = document.getElementById('canvas');
+      if (!canvas) return;
+      const ctx = canvas.getContext('2d');
+      const cupCustomizer = document.getElementById('cup-customizer');
+      const cupNameInput = document.getElementById('cup-name');
+      const milkSelect = document.getElementById('milk-select');
+      const syrupSelect = document.getElementById('syrup-select');
+      const displayName = document.getElementById('display-name');
+      const displayMilk = document.getElementById('display-milk');
+      const displaySyrup = document.getElementById('display-syrup');
+
+      const milkColors = {
+        'Oat Milk': '#e6d3b3',
+        'Whole Milk': '#f5ebd6',
+        'Almond Milk': '#dec6a4',
+        'Coconut Milk': '#f8f4ec',
+        'Soy Milk': '#ead9b7'
+      };
+
+      const syrupColors = {
+        'Vermont Maple': '#b85d19',
+        'Vanilla Bean': '#dfb15b',
+        'Salted Caramel': '#c87628',
+        'Hazelnut': '#7b4a29',
+        'Dark Mocha': '#3e2723',
+        'No Syrup': 'transparent'
+      };
+
+      function syncLiveText() {
+        const nameVal = cupNameInput.value.trim() || 'Guest';
+        displayName.textContent = nameVal;
+        displayMilk.textContent = milkSelect.value;
+        displaySyrup.textContent = syrupSelect.value;
+      }
+
+      function drawCoffeeCup(width, height) {
+        const cx = width / 2;
+        const milkColor = milkColors[milkSelect.value] || '#e6d3b3';
+        const syrupColor = syrupColors[syrupSelect.value] || '#b85d19';
+
+        // Subtle cafe backdrop & wooden counter
+        const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
+        bgGrad.addColorStop(0, '#fffdf9');
+        bgGrad.addColorStop(0.82, '#f7efe6');
+        bgGrad.addColorStop(0.82, '#d7ccc8');
+        bgGrad.addColorStop(1, '#bcaaa4');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, width, height);
+
+        // Counter edge line
+        ctx.strokeStyle = '#a1887f';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(0, height * 0.82);
+        ctx.lineTo(width, height * 0.82);
+        ctx.stroke();
+
+        // Steam wisps
+        ctx.save();
+        ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        [-35, 0, 35].forEach((offset, idx) => {
+          ctx.beginPath();
+          ctx.moveTo(cx + offset, 68);
+          ctx.bezierCurveTo(
+            cx + offset - 14,
+            48 - idx * 3,
+            cx + offset + 14,
+            32 - idx * 3,
+            cx + offset - 4,
+            16
+          );
+          ctx.stroke();
+        });
+        ctx.restore();
+
+        // Drop shadow under cup base
+        ctx.save();
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.18)';
+        ctx.beginPath();
+        ctx.ellipse(cx, 466, 108, 16, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.restore();
+
+        // Cup dimensions
+        const topY = 112;
+        const bottomY = 460;
+        const topHalfW = 148;
+        const bottomHalfW = 98;
+
+        // Main cup body (tapered)
+        ctx.save();
+        const cupGrad = ctx.createLinearGradient(cx - topHalfW, topY, cx + topHalfW, topY);
+        cupGrad.addColorStop(0, '#efe5dc');
+        cupGrad.addColorStop(0.35, '#ffffff');
+        cupGrad.addColorStop(1, '#d7ccc8');
+        ctx.fillStyle = cupGrad;
+        ctx.strokeStyle = '#5d4037';
+        ctx.lineWidth = 3;
+
+        ctx.beginPath();
+        ctx.moveTo(cx - topHalfW, topY);
+        ctx.lineTo(cx + topHalfW, topY);
+        ctx.lineTo(cx + bottomHalfW, bottomY);
+        ctx.quadraticCurveTo(cx, bottomY + 14, cx - bottomHalfW, bottomY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Liquid / milk & espresso crema preview band near top of cup
+        ctx.clip();
+        ctx.fillStyle = '#4e342e';
+        ctx.fillRect(cx - topHalfW, topY, topHalfW * 2, 46);
+
+        // Milk layer swirl
+        ctx.fillStyle = milkColor;
+        ctx.beginPath();
+        ctx.moveTo(cx - topHalfW, topY + 14);
+        ctx.bezierCurveTo(cx - 60, topY + 28, cx + 60, topY + 6, cx + topHalfW, topY + 18);
+        ctx.lineTo(cx + topHalfW, topY + 46);
+        ctx.lineTo(cx - topHalfW, topY + 46);
+        ctx.closePath();
+        ctx.fill();
+
+        // Syrup drizzle ribbon
+        if (syrupColor !== 'transparent') {
+          ctx.strokeStyle = syrupColor;
+          ctx.lineWidth = 5;
+          ctx.lineCap = 'round';
+          ctx.beginPath();
+          ctx.moveTo(cx - topHalfW + 18, topY + 26);
+          ctx.bezierCurveTo(cx - 50, topY + 12, cx + 50, topY + 40, cx + topHalfW - 18, topY + 24);
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Corrugated kraft coffee sleeve in the middle of the cup
+        const sleeveTopY = 158;
+        const sleeveBottomY = 418;
+        const tTop = (sleeveTopY - topY) / (bottomY - topY);
+        const tBottom = (sleeveBottomY - topY) / (bottomY - topY);
+        const sleeveTopHalfW = topHalfW - (topHalfW - bottomHalfW) * tTop + 3;
+        const sleeveBottomHalfW = topHalfW - (topHalfW - bottomHalfW) * tBottom + 3;
+
+        ctx.save();
+        const sleeveGrad = ctx.createLinearGradient(cx - sleeveTopHalfW, sleeveTopY, cx + sleeveTopHalfW, sleeveTopY);
+        sleeveGrad.addColorStop(0, '#b9936c');
+        sleeveGrad.addColorStop(0.5, '#d2b48c');
+        sleeveGrad.addColorStop(1, '#a37c54');
+        ctx.fillStyle = sleeveGrad;
+        ctx.strokeStyle = '#5d4037';
+        ctx.lineWidth = 2.5;
+
+        ctx.beginPath();
+        ctx.moveTo(cx - sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(cx + sleeveTopHalfW, sleeveTopY);
+        ctx.lineTo(cx + sleeveBottomHalfW, sleeveBottomY);
+        ctx.quadraticCurveTo(cx, sleeveBottomY + 10, cx - sleeveBottomHalfW, sleeveBottomY);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+        ctx.restore();
+
+        // Travel coffee cup lid
+        ctx.save();
+        ctx.fillStyle = '#4e342e';
+        ctx.strokeStyle = '#3e2723';
+        ctx.lineWidth = 2.5;
+
+        // Upper lid dome
+        ctx.beginPath();
+        ctx.moveTo(cx - topHalfW + 10, topY - 12);
+        ctx.lineTo(cx - topHalfW + 24, topY - 34);
+        ctx.lineTo(cx + topHalfW - 24, topY - 34);
+        ctx.lineTo(cx + topHalfW - 10, topY - 12);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // Lower lid rim
+        ctx.fillStyle = '#5d4037';
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(cx - topHalfW - 12, topY - 14, (topHalfW + 12) * 2, 18, 6);
+        } else {
+          ctx.rect(cx - topHalfW - 12, topY - 14, (topHalfW + 12) * 2, 18);
+        }
+        ctx.fill();
+        ctx.stroke();
+        ctx.restore();
+      }
+
+      function paint() {
+        const dpr = window.devicePixelRatio || 1;
+        const cssWidth = canvas.clientWidth || 680;
+        const cssHeight = canvas.clientHeight || 520;
+        const scaleX = canvas.width ? canvas.width / cssWidth : dpr;
+        const scaleY = canvas.height ? canvas.height / cssHeight : dpr;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.setTransform(1, 0, 0, 1, 0, 0);
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        ctx.scale(scaleX, scaleY);
+
+        drawCoffeeCup(cssWidth, cssHeight);
+
+        const labelWidth = cupCustomizer.offsetWidth || 236;
+        const labelX = Math.round((cssWidth - labelWidth) / 2);
+        const labelY = 172;
+
+        if (typeof ctx.drawElementImage === 'function') {
+          const transform =
+            ctx.drawElementImage(cupCustomizer, labelX, labelY) ??
+            (typeof canvas.getElementTransform === 'function'
+              ? canvas.getElementTransform(
+                  cupCustomizer,
+                  ctx.getTransform().translate(labelX, labelY)
+                )
+              : null);
+          if (transform) {
+            cupCustomizer.style.transform = transform.toString();
+          }
+        } else {
+          cupCustomizer.style.transform = `translate(${labelX}px, ${labelY}px)`;
+        }
+      }
+
+      canvas.onpaint = paint;
+
+      const resizeObserver = new ResizeObserver((entries) => {
+        for (const entry of entries) {
+          const dpc = entry.devicePixelContentBoxSize && entry.devicePixelContentBoxSize[0];
+          if (dpc) {
+            canvas.width = dpc.inlineSize;
+            canvas.height = dpc.blockSize;
+          } else {
+            const dpr = window.devicePixelRatio || 1;
+            const w = entry.contentRect.width || canvas.clientWidth || 680;
+            const h = entry.contentRect.height || canvas.clientHeight || 520;
+            canvas.width = Math.round(w * dpr);
+            canvas.height = Math.round(h * dpr);
+          }
+        }
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+        paint();
+      });
+
+      try {
+        resizeObserver.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch (e) {
+        resizeObserver.observe(canvas);
+      }
+
+      function handleControlUpdate() {
+        syncLiveText();
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+        paint();
+      }
+
+      cupNameInput.addEventListener('input', handleControlUpdate);
+      milkSelect.addEventListener('change', handleControlUpdate);
+      syrupSelect.addEventListener('change', handleControlUpdate);
+
+      syncLiveText();
+      paint();
+    })();
+  </script>
 </body>
 
