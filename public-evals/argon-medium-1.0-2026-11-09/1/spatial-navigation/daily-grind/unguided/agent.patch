+        const cards = getCards();
+        if (cards.length === 0) return null;
+
+        const { items, rows } = getCardMetrics(cards);
+        const current = items.find((item) => item.card === currentCard);
+        if (!current) return cards[0];
+
+        if (key === 'Home') {
+          preferredX = null;
+          return cards[0];
+        }
+
+        if (key === 'End') {
+          preferredX = null;
+          return cards[cards.length - 1];
+        }
+
+        if (key === 'ArrowRight') {
+          preferredX = null;
+          const minH = Math.max(1, current.height * 0.25);
+          const candidates = items.filter((item) => {
+            if (item.card === currentCard) return false;
+            const overlapY =
+              Math.min(current.bottom, item.bottom) - Math.max(current.top, item.top);
+            return item.cx > current.cx + 4 && overlapY >= minH;
+          });
+
+          if (candidates.length === 0) return null;
+
+          candidates.sort((a, b) => {
+            const gapA = Math.max(0, a.left - current.right);
+            const gapB = Math.max(0, b.left - current.right);
+            if (Math.abs(gapA - gapB) > 2) return gapA - gapB;
+            const dxA = a.cx - current.cx;
+            const dxB = b.cx - current.cx;
+            if (Math.abs(dxA - dxB) > 2) return dxA - dxB;
+            return Math.abs(a.cy - current.cy) - Math.abs(b.cy - current.cy);
+          });
+
+          return candidates[0].card;
+        }
+
+        if (key === 'ArrowLeft') {
+          preferredX = null;
+          const minH = Math.max(1, current.height * 0.25);
+          const candidates = items.filter((item) => {
+            if (item.card === currentCard) return false;
+            const overlapY =
+              Math.min(current.bottom, item.bottom) - Math.max(current.top, item.top);
+            return item.cx < current.cx - 4 && overlapY >= minH;
+          });
+
+          if (candidates.length === 0) return null;
+
+          candidates.sort((a, b) => {
+            const gapA = Math.max(0, current.left - a.right);
+            const gapB = Math.max(0, current.left - b.right);
+            if (Math.abs(gapA - gapB) > 2) return gapA - gapB;
+            const dxA = current.cx - a.cx;
+            const dxB = current.cx - b.cx;
+            if (Math.abs(dxA - dxB) > 2) return dxA - dxB;
+            return Math.abs(a.cy - current.cy) - Math.abs(b.cy - current.cy);
+          });
+
+          return candidates[0].card;
+        }
+
+        if (key === 'ArrowDown' || key === 'ArrowUp') {
+          const minCardWidth = Math.min(...items.map((item) => item.width || 1));
+          if (preferredX === null) {
+            if (current.width > minCardWidth * 1.4) {
+              preferredX = current.left + minCardWidth / 2;
+            } else {
+              preferredX = current.cx;
+            }
+          }
+          const anchorX = preferredX;
+
+          // Identify candidate rows in the desired vertical direction
+          const targetRowIndex =
+            key === 'ArrowDown' ? current.rowIndex + 1 : current.rowIndex - 1;
+
+          let rowCandidates = [];
+          if (targetRowIndex >= 0 && targetRowIndex < rows.length) {
+            rowCandidates = rows[targetRowIndex];
+          } else {
+            // Fallback for staggered layouts where rowIndex may not capture all vertical neighbors
+            const verticalCandidates = items.filter((item) => {
+              if (item.card === currentCard) return false;
+              return key === 'ArrowDown'
+                ? item.top >= current.bottom - current.height * 0.25
+                : item.bottom <= current.top + current.height * 0.25;
+            });
+
+            if (verticalCandidates.length === 0) return null;
+
+            if (key === 'ArrowDown') {
+              const minTop = Math.min(...verticalCandidates.map((c) => c.top));
+              const band = Math.min(...verticalCandidates.map((c) => c.height || 1)) * 0.5;
+              rowCandidates = verticalCandidates.filter((c) => c.top <= minTop + band);
+            } else {
+              const maxBottom = Math.max(...verticalCandidates.map((c) => c.bottom));
+              const band = Math.min(...verticalCandidates.map((c) => c.height || 1)) * 0.5;
+              rowCandidates = verticalCandidates.filter((c) => c.bottom >= maxBottom - band);
+            }
+          }
+
+          if (!rowCandidates || rowCandidates.length === 0) return null;
+
+          // Score candidates in the target row by horizontal alignment with anchorX
+          const containing = rowCandidates.filter(
+            (c) => anchorX >= c.left - 4 && anchorX <= c.right + 4
+          );
+
+          if (containing.length > 0) {
+            containing.sort((a, b) => Math.abs(a.cx - anchorX) - Math.abs(b.cx - anchorX));
+            return containing[0].card;
+          }
+
+          const sortedByHorizontalProximity = [...rowCandidates].sort((a, b) => {
+            const distA =
+              anchorX < a.left ? a.left - anchorX : anchorX > a.right ? anchorX - a.right : 0;
+            const distB =
+              anchorX < b.left ? b.left - anchorX : anchorX > b.right ? anchorX - b.right : 0;
+            if (Math.abs(distA - distB) > 2) return distA - distB;
+            return Math.abs(a.cx - anchorX) - Math.abs(b.cx - anchorX);
+          });
+
+          return sortedByHorizontalProximity[0].card;
+        }
+
+        return null;
+      }
+
+      // Handle keyboard navigation inside the card grid
+      grid.addEventListener('keydown', (event) => {
+        const currentCard = event.target.closest('.card');
+        if (!currentCard || !grid.contains(currentCard)) return;
+
+        const navKeys = ['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'];
+        if (navKeys.includes(event.key)) {
+          event.preventDefault();
+          updateGridAriaAttributes();
+          const targetCard = findSpatialTarget(currentCard, event.key);
+          if (targetCard && targetCard !== currentCard) {
+            setActiveCard(targetCard, { focus: true, announce: true });
+          }
+          return;
+        }
+
+        // Activate card primary link on Enter or Space when focused on the card itself
+        if ((event.key === 'Enter' || event.key === ' ') && event.target === currentCard) {
+          const primaryLink = currentCard.querySelector('a.btn, a, button');
+          if (primaryLink) {
+            event.preventDefault();
+            primaryLink.click();
+          }
+        }
+      });
+
+      // Keep roving tabindex in sync when clicking or focusing a card directly
+      grid.addEventListener('focusin', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          setActiveCard(card, { focus: false, announce: false });
+        }
+      });
+
+      grid.addEventListener('mousedown', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          preferredX = null;
+        }
+      });
+
+      // Layout switcher logic
+      function setLayoutMode(mode) {
+        if (!mode) return;
+        preferredX = null;
+        grid.dataset.layout = mode;
+        grid.classList.remove('layout-grid', 'layout-compact', 'layout-list', 'layout-featured', 'layout-horizontal');
+        grid.classList.add(`layout-${mode}`);
+
+        layoutButtons.forEach((btn) => {
+          const isMatch = btn.dataset.layoutMode === mode;
+          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+        });
+
+        updateGridAriaAttributes();
+
+        if (statusRegion) {
+          const rowCount = grid.getAttribute('aria-rowcount') || '1';
+          const colCount = grid.getAttribute('aria-colcount') || '1';
+          statusRegion.textContent = `Layout changed to ${mode} view (${rowCount} rows, ${colCount} columns)`;
+        }
+      }
+
+      layoutButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          setLayoutMode(button.dataset.layoutMode);
+        });
+      });
+
+      // Observe attribute/class mutations on `.grid` in case external scripts change the layout mode
+      const observer = new MutationObserver(() => {
+        preferredX = null;
+        updateGridAriaAttributes();
+      });
+      observer.observe(grid, {
+        attributes: true,
+        attributeFilter: ['data-layout', 'class', 'style']
+      });
+
+      window.addEventListener('resize', () => {
+        preferredX = null;
+        updateGridAriaAttributes();
+      });
+
+      // Initialize on load
+      updateGridAriaAttributes();
+    })();
+  </script>
 </body>
 
