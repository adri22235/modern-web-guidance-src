+  <script>
+    (() => {
+      const DIRECTION_KEYS = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);
+      const NATIVE_ARROW_CONSUMER_SELECTOR = ':read-write, select, input[type="range"], [role="slider"]';
+      const FOCUSABLE_CANDIDATE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled):not([type="hidden"])',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[tabindex]:not([disabled])',
+        '[contenteditable]:not([contenteditable="false"])'
+      ].join(', ');
+
+      const EDGE_TOLERANCE = 2;
+      const FALLBACK_PERPENDICULAR_WEIGHT = 2.5;
+
+      function getVisibleCandidates(container) {
+        const all = Array.from(container.querySelectorAll(FOCUSABLE_CANDIDATE_SELECTOR));
+        return all.filter((el) => {
+          if (!(el instanceof HTMLElement)) return false;
+          if (typeof el.checkVisibility === 'function' && !el.checkVisibility()) {
+            return false;
+          }
+          return true;
+        });
+      }
+
+      function syncRovingTabindex(candidates, activeElement) {
+        if (candidates.length === 0) return;
+        const target = activeElement && candidates.includes(activeElement)
+          ? activeElement
+          : candidates.find((el) => el.getAttribute('tabindex') === '0') || candidates[0];
+
+        for (const candidate of candidates) {
+          candidate.setAttribute('tabindex', candidate === target ? '0' : '-1');
+        }
+      }
+
+      function findDirectionalCandidate(current, candidates, key) {
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = (currentRect.left + currentRect.right) / 2;
+        const currentCenterY = (currentRect.top + currentRect.bottom) / 2;
+
+        const aligned = [];
+        const fallback = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+
+          const rect = candidate.getBoundingClientRect();
+          if (rect.width === 0 && rect.height === 0) continue;
+
+          const centerX = (rect.left + rect.right) / 2;
+          const centerY = (rect.top + rect.bottom) / 2;
+
+          let inDirection = false;
+          let gap = 0;
+          let overlapsPerpendicular = false;
+          let perpendicularCenterOffset = 0;
+
+          if (key === 'ArrowRight') {
+            inDirection = rect.left >= currentRect.right - EDGE_TOLERANCE;
+            gap = Math.max(0, rect.left - currentRect.right);
+            overlapsPerpendicular =
+              Math.min(currentRect.bottom, rect.bottom) - Math.max(currentRect.top, rect.top) > 0;
+            perpendicularCenterOffset = Math.abs(centerY - currentCenterY);
+          } else if (key === 'ArrowLeft') {
+            inDirection = rect.right <= currentRect.left + EDGE_TOLERANCE;
+            gap = Math.max(0, currentRect.left - rect.right);
+            overlapsPerpendicular =
+              Math.min(currentRect.bottom, rect.bottom) - Math.max(currentRect.top, rect.top) > 0;
+            perpendicularCenterOffset = Math.abs(centerY - currentCenterY);
+          } else if (key === 'ArrowDown') {
+            inDirection = rect.top >= currentRect.bottom - EDGE_TOLERANCE;
+            gap = Math.max(0, rect.top - currentRect.bottom);
+            overlapsPerpendicular =
+              Math.min(currentRect.right, rect.right) - Math.max(currentRect.left, rect.left) > 0;
+            perpendicularCenterOffset = Math.abs(centerX - currentCenterX);
+          } else if (key === 'ArrowUp') {
+            inDirection = rect.bottom <= currentRect.top + EDGE_TOLERANCE;
+            gap = Math.max(0, currentRect.top - rect.bottom);
+            overlapsPerpendicular =
+              Math.min(currentRect.right, rect.right) - Math.max(currentRect.left, rect.left) > 0;
+            perpendicularCenterOffset = Math.abs(centerX - currentCenterX);
+          }
+
+          if (!inDirection) continue;
+
+          const entry = {
+            element: candidate,
+            gap,
+            perpendicularCenterOffset,
+            fallbackScore: gap + FALLBACK_PERPENDICULAR_WEIGHT * perpendicularCenterOffset
+          };
+
+          if (overlapsPerpendicular) {
+            aligned.push(entry);
+          } else {
+            fallback.push(entry);
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > 0.5) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCenterOffset - b.perpendicularCenterOffset;
+          });
+          return aligned[0].element;
+        }
+
+        if (fallback.length > 0) {
+          fallback.sort((a, b) => {
+            if (Math.abs(a.fallbackScore - b.fallbackScore) > 0.5) {
+              return a.fallbackScore - b.fallbackScore;
+            }
+            if (Math.abs(a.gap - b.gap) > 0.5) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCenterOffset - b.perpendicularCenterOffset;
+          });
+          return fallback[0].element;
+        }
+
+        return null;
+      }
+
+      function initSpatialGrid(container) {
+        if (!container) return;
+
+        syncRovingTabindex(getVisibleCandidates(container));
+
+        container.addEventListener('focusin', (e) => {
+          const rawTarget = e.composedPath()[0];
+          const target = rawTarget instanceof HTMLElement ? rawTarget : null;
+          if (!target) return;
+          const candidates = getVisibleCandidates(container);
+          if (candidates.includes(target)) {
+            syncRovingTabindex(candidates, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          if (!DIRECTION_KEYS.has(e.key)) return;
+          if (e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+          const rawTarget = e.composedPath()[0];
+          const target = rawTarget instanceof Element ? rawTarget : null;
+          if (!target) return;
+          if (target.matches(NATIVE_ARROW_CONSUMER_SELECTOR)) return;
+
+          const candidates = getVisibleCandidates(container);
+          const focused = document.activeElement;
+          if (!(focused instanceof HTMLElement) || !candidates.includes(focused)) {
+            return;
+          }
+
+          const nextCandidate = findDirectionalCandidate(focused, candidates, e.key);
+          if (!nextCandidate) {
+            // Do not call preventDefault() so native boundary scrolling works
+            return;
+          }
+
+          e.preventDefault();
+          syncRovingTabindex(candidates, nextCandidate);
+          nextCandidate.focus();
+          nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+      }
+
+      const grid = document.getElementById('seasonal-grid');
+      initSpatialGrid(grid);
+
+      const layoutButtons = document.querySelectorAll('.layout-btn[data-layout-mode]');
+      for (const btn of layoutButtons) {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          if (!mode || !grid) return;
+          grid.setAttribute('data-layout', mode);
+          for (const other of layoutButtons) {
+            other.setAttribute('aria-pressed', other === btn ? 'true' : 'false');
+          }
+          syncRovingTabindex(getVisibleCandidates(grid));
+        });
+      }
+    })();
+  </script>
 </body>
 
