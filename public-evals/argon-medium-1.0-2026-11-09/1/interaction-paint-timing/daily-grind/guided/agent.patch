+  <script type="module">
+    const interactionTargetsById = new Map();
+    let lastClickedCategory = null;
+
+    const metricsStore = {
+      interactionPaints: [],
+      softNavigations: [],
+      hardLcp: null,
+      cls: 0,
+      events: [],
+    };
+    window.__dailyGrindPerfMetrics = metricsStore;
+
+    function classifyInteractionElement(element) {
+      if (!(element instanceof Element)) return null;
+      if (element.closest('nav')) {
+        const link = element.closest('a, .logo');
+        return {
+          category: 'navigation-bar',
+          label: `Navigation Bar (${link ? link.textContent.trim() : 'nav'})`,
+        };
+      }
+      if (element.closest('.hero .btn')) {
+        return {
+          category: 'order-now',
+          label: '"Order Now" Button',
+        };
+      }
+      const card = element.closest('.card');
+      if (card) {
+        const title = card.querySelector('h3')?.textContent?.trim() || 'Card';
+        return {
+          category: 'seasonal-favorites',
+          label: `Seasonal Favorites (${title})`,
+        };
+      }
+      return null;
+    }
+
+    function appendPerfLog(message, detail) {
+      const logList = document.getElementById('perf-log-list');
+      if (logList) {
+        const item = document.createElement('li');
+        item.textContent = `[${new Date().toLocaleTimeString()}] ${message}`;
+        logList.prepend(item);
+      }
+      console.info(`[DailyGrind Perf] ${message}`, detail ?? '');
+    }
+
+    function updateCategoryStat(category, durationMs) {
+      const formatted = `${durationMs.toFixed(1)} ms`;
+      if (category === 'navigation-bar') {
+        const el = document.getElementById('metric-nav');
+        if (el) el.textContent = formatted;
+      } else if (category === 'order-now') {
+        const el = document.getElementById('metric-order-now');
+        if (el) el.textContent = formatted;
+      } else if (category === 'seasonal-favorites') {
+        const el = document.getElementById('metric-seasonal-card');
+        if (el) el.textContent = formatted;
+      }
+    }
+
+    /**
+     * Observes contentful paints caused by user interactions and invokes a callback
+     * whenever an interaction produces a larger contentful paint.
+     *
+     * @param {(entry: PerformanceEntry) => void} onInteractionPaint
+     */
+    export function observeInteractionPaints(onInteractionPaint) {
+      // Feature-detect support before calling observe() so unsupported browsers
+      // do not throw or log console warnings.
+      if (
+        typeof PerformanceObserver === 'undefined' ||
+        !PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint')
+      ) {
+        return null;
+      }
+
+      const observer = new PerformanceObserver((list) => {
+        for (const entry of list.getEntries()) {
+          // entry.duration is already calculated as (entry.presentationTime - entry.startTime),
+          // giving the total time from the user interaction to this contentful paint.
+          onInteractionPaint(entry);
+        }
+      });
+
+      // MANDATORY: Pass buffered: true to capture interaction paints that occurred
+      // before this observer was registered.
+      observer.observe({ type: 'interaction-contentful-paint', buffered: true });
+      return observer;
+    }
+
+    /**
+     * Tracks FCP and LCP for each client-side soft navigation and reports finalized
+     * route metrics when the user navigates to a new route or hides the page.
+     *
+     * @param {(report: {
+     *   url: string,
+     *   navigationId: number,
+     *   interactionId: number,
+     *   fcpDuration: number,
+     *   lcpDuration: number | null,
+     *   lcpElement: Element | null,
+     *   lcpSize: number | null
+     * }) => void} onSoftNavReport
+     */
+    export function trackSoftNavigationLCP(onSoftNavReport) {
+      const supported =
+        typeof PerformanceObserver !== 'undefined' &&
+        PerformanceObserver.supportedEntryTypes?.includes('soft-navigation') &&
+        PerformanceObserver.supportedEntryTypes?.includes('interaction-contentful-paint');
+
+      if (!supported) {
+        return null;
+      }
+
+      let activeSoftNav = null;
+      let activeLcpEntry = null;
+
+      function finalizeCurrentSoftNav() {
+        if (!activeSoftNav) return;
+
+        onSoftNavReport({
+          // activeSoftNav.name holds the destination URL of the soft navigation.
+          url: activeSoftNav.name,
+          navigationId: activeSoftNav.navigationId,
+          interactionId: activeSoftNav.interactionId,
+          // activeSoftNav.duration is (activeSoftNav.presentationTime - activeSoftNav.startTime),
+          // which represents First Contentful Paint (FCP) relative to interaction start.
+          fcpDuration: activeSoftNav.duration,
+          // activeLcpEntry.duration is (activeLcpEntry.presentationTime - activeSoftNav.startTime),
+          // representing the soft navigation's LCP duration relative to interaction start.
+          lcpDuration: activeLcpEntry ? activeLcpEntry.duration : null,
+          lcpElement: activeLcpEntry?.largestContentfulPaint?.element ?? null,
+          lcpSize: activeLcpEntry?.largestContentfulPaint?.size ?? null,
+        });
+
+        activeSoftNav = null;
+        activeLcpEntry = null;
+      }
+
+      const softNavObserver = new PerformanceObserver((list) => {
+        for (const softNavEntry of list.getEntries()) {
+          // Finalize the previous route's metrics before resetting state for the new route.
+          finalizeCurrentSoftNav();
+
+          activeSoftNav = softNavEntry;
+          // MANDATORY: Seed the LCP candidate with getLargestInteractionContentfulPaint()
+          // to capture any attributed contentful paints that occurred before the URL updated.
+          activeLcpEntry = softNavEntry.getLargestInteractionContentfulPaint();
+
+          const softNavEl = document.getElementById('metric-soft-nav');
+          if (softNavEl) {
+            const fcp = activeSoftNav.duration.toFixed(1);
+            const lcp = activeLcpEntry ? activeLcpEntry.duration.toFixed(1) : fcp;
+            softNavEl.textContent = `${fcp} / ${lcp} ms`;
+          }
+        }
+      });
+
+      const icpObserver = new PerformanceObserver((list) => {
+        for (const icpEntry of list.getEntries()) {
+          // MANDATORY: Match by interactionId (not navigationId) so only paints caused
+          // by the soft navigation's initiating interaction update the route's LCP.
+          if (activeSoftNav && icpEntry.interactionId === activeSoftNav.interactionId) {
+            activeLcpEntry = icpEntry;
+            const softNavEl = document.getElementById('metric-soft-nav');
+            if (softNavEl) {
+              const fcp = activeSoftNav.duration.toFixed(1);
+              const lcp = activeLcpEntry.duration.toFixed(1);
+              softNavEl.textContent = `${fcp} / ${lcp} ms`;
+            }
+          }
+        }
+      });
+
+      softNavObserver.observe({ type: 'soft-navigation', buffered: true });
+      icpObserver.observe({ type: 'interaction-contentful-paint', buffered: true });
+
+      // Finalize the active route's LCP when the page is backgrounded or unloaded.
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden') {
+          finalizeCurrentSoftNav();
+        }
+      });
+
+      return { softNavObserver, icpObserver, finalizeCurrentSoftNav };
+    }
+
+    /**
+     * Keep standard hard-navigation observers ('largest-contentful-paint', 'event',
+     * and 'layout-shift') active across all browsers as fallback and baseline telemetry.
+     */
+    function observeStandardPerformanceEntries() {
+      if (typeof PerformanceObserver === 'undefined') return;
+
+      const supportedTypes = PerformanceObserver.supportedEntryTypes ?? [];
+
+      if (supportedTypes.includes('largest-contentful-paint')) {
+        const lcpObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            metricsStore.hardLcp = entry.startTime;
+          }
+        });
+        lcpObserver.observe({ type: 'largest-contentful-paint', buffered: true });
+      }
+
+      if (supportedTypes.includes('layout-shift')) {
+        const clsObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (!entry.hadRecentInput) {
+              metricsStore.cls += entry.value;
+            }
+          }
+        });
+        clsObserver.observe({ type: 'layout-shift', buffered: true });
+      }
+
+      if (supportedTypes.includes('event')) {
+        const eventObserver = new PerformanceObserver((list) => {
+          for (const entry of list.getEntries()) {
+            if (!entry.interactionId) continue;
+
+            const classified = classifyInteractionElement(entry.target);
+            if (classified) {
+              interactionTargetsById.set(entry.interactionId, classified);
+              metricsStore.events.push({
+                interactionId: entry.interactionId,
+                name: entry.name,
+                duration: entry.duration,
+                category: classified.category,
+                label: classified.label,
+              });
+
+              // In browsers without interaction-contentful-paint support, provide graceful
+              // fallback telemetry using PerformanceEventTiming next-paint duration.
+              if (!supportedTypes.includes('interaction-contentful-paint')) {
+                updateCategoryStat(classified.category, entry.duration);
+                appendPerfLog(
+                  `[Event Paint Fallback] ${classified.label}: ${entry.duration.toFixed(1)} ms (interactionId=${entry.interactionId})`,
+                  entry
+                );
+              }
+            }
+          }
+        });
+        eventObserver.observe({ type: 'event', buffered: true, durationThreshold: 16 });
+      }
+    }
+
+    // Initialize interaction contentful paint and soft navigation observers
+    const icpObs = observeInteractionPaints((entry) => {
+      const targetInfo =
+        interactionTargetsById.get(entry.interactionId) ||
+        lastClickedCategory || {
+          category: 'interaction',
+          label: 'Page Interaction',
+        };
+
+      const paintDuration = entry.duration ?? entry.presentationTime - entry.startTime;
+      const lcpDetails = entry.largestContentfulPaint;
+
+      const record = {
+        interactionId: entry.interactionId,
+        category: targetInfo.category,
+        label: targetInfo.label,
+        startTime: entry.startTime,
+        paintTime: entry.paintTime,
+        presentationTime: entry.presentationTime,
+        duration: paintDuration,
+        element: lcpDetails?.element ?? null,
+        size: lcpDetails?.size ?? null,
+      };
+
+      metricsStore.interactionPaints.push(record);
+      updateCategoryStat(targetInfo.category, paintDuration);
+      appendPerfLog(
+        `[Interaction Paint] ${targetInfo.label}: ${paintDuration.toFixed(1)} ms (interactionId=${entry.interactionId}, size=${lcpDetails?.size ?? 0})`,
+        record
+      );
+    });
+
+    const softNavTracker = trackSoftNavigationLCP((report) => {
+      metricsStore.softNavigations.push(report);
+      const softNavEl = document.getElementById('metric-soft-nav');
+      if (softNavEl) {
+        const fcp = report.fcpDuration.toFixed(1);
+        const lcp = report.lcpDuration !== null ? report.lcpDuration.toFixed(1) : 'n/a';
+        softNavEl.textContent = `${fcp} / ${lcp} ms`;
+      }
+      appendPerfLog(
+        `[Soft Navigation Finalized] ${report.url} — FCP: ${report.fcpDuration.toFixed(1)} ms, LCP: ${
+          report.lcpDuration !== null ? `${report.lcpDuration.toFixed(1)} ms` : 'n/a'
+        } (interactionId=${report.interactionId})`,
+        report
+      );
+    });
+
+    observeStandardPerformanceEntries();
+
+    const badge = document.getElementById('perf-support-badge');
+    if (badge) {
+      badge.textContent =
+        icpObs && softNavTracker
+          ? 'ICP & Soft-Nav Observers Active'
+          : 'Standard PerformanceObserver Active (Graceful Fallback)';
+    }
+
+    // Client-side view switch handler for Navigation Bar, "Order Now", and "Seasonal Favorites" cards
+    const routeViews = {
+      '/menu': {
+        title: 'Full Artisanal Menu',
+        description:
+          'Explore single-origin pour-overs, signature espresso drinks, organic teas, and freshly baked pastries roasted daily.',
+      },
+      '/locations': {
+        title: 'Our Coffeehouse Locations',
+        description:
+          'Visit our flagship roastery downtown, the neighborhood cafe on Oak Street, or our riverside espresso bar.',
+      },
+      '/rewards': {
+        title: 'Daily Grind Rewards',
+        description:
+          'Earn 2 beans for every dollar spent. Redeem for complimentary drinks, seasonal tasting flights, and whole-bean bags.',
+      },
+      '/account': {
+        title: 'My Account & Subscriptions',
+        description:
+          'Manage your recurring coffee bean deliveries, saved favorite drinks, and payment preferences.',
+      },
+      '/logout': {
+        title: 'Signed Out',
+        description:
+          'You have signed out of your Daily Grind Rewards session. See you tomorrow morning!',
+      },
+      '/order-online': {
+        title: 'Order Online for Express Pickup',
+        description:
+          'Select your local Daily Grind bar, customize your roast and milk options, and skip the morning line.',
+      },
+      '/menu/seasonal': {
+        title: 'Maple Oat Latte — Seasonal Spotlight',
+        description:
+          'Crafted with double-shot house espresso, velvety steamed oat milk, Grade-A Vermont maple syrup, and a dusting of cinnamon.',
+      },
+      '/menu/espresso': {
+        title: 'Dark Roast Espresso — Roaster Notes',
+        description:
+          '100% Arabica beans from Colombia and Sumatra roasted to a rich dark profile with notes of dark chocolate and toasted walnut.',
+      },
+      '/menu/cold-brew': {
+        title: '18-Hour Signature Cold Brew',
+        description:
+          'Coarse-ground Ethiopian beans steeped in cold filtered water for 18 hours for a naturally sweet, low-acid finish.',
+      },
+    };
+
+    function renderClientSideView(path, fallbackTitle, fallbackDescription) {
+      const panel = document.getElementById('active-view-panel');
+      const titleEl = document.getElementById('active-view-title');
+      const descEl = document.getElementById('active-view-description');
+      if (!panel || !titleEl || !descEl) return;
+
+      const viewData = routeViews[path] || {
+        title: fallbackTitle,
+        description: fallbackDescription,
+      };
+
+      panel.hidden = false;
+      titleEl.textContent = viewData.title;
+      descEl.textContent = viewData.description;
+
+      if (path && window.location.pathname !== path) {
+        history.pushState({ path }, viewData.title, path);
+      }
+    }
+
+    document.addEventListener('click', (event) => {
+      const target = event.target instanceof Element ? event.target : null;
+      if (!target) return;
+
+      const classified = classifyInteractionElement(target);
+      if (!classified) return;
+
+      lastClickedCategory = classified;
+
+      const link = target.closest('a');
+      const card = target.closest('.card');
+
+      if (link) {
+        event.preventDefault();
+        const url = new URL(link.href, window.location.origin);
+        renderClientSideView(
+          url.pathname,
+          link.textContent.trim(),
+          `Loaded ${link.textContent.trim()} view.`
+        );
+      } else if (card) {
+        const cardLink = card.querySelector('a');
+        const path = cardLink
+          ? new URL(cardLink.href, window.location.origin).pathname
+          : '/menu/seasonal';
+        const title = card.querySelector('h3')?.textContent?.trim() || 'Seasonal Favorite';
+        const desc = card.querySelector('p')?.textContent?.trim() || '';
+        renderClientSideView(path, title, desc);
+      }
+    });
+  </script>
