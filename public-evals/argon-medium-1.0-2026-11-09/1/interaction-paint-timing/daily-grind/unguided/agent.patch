+
+      let interactionCounter = 0;
+
+      /**
+       * Waits until the browser has finished painting the visual DOM updates
+       * triggered in the current frame using double requestAnimationFrame.
+       */
+      function afterNextPaint(callback) {
+        requestAnimationFrame(function () {
+          requestAnimationFrame(function () {
+            callback(performance.now());
+          });
+        });
+      }
+
+      function formatMs(ms) {
+        return ms.toFixed(2) + ' ms';
+      }
+
+      function updateDashboardUI(record) {
+        const statusEl = document.getElementById('perf-last-status');
+        if (statusEl) {
+          statusEl.textContent =
+            'Last: ' + record.category + ' (' + record.label + ') painted in ' + formatMs(record.paintDurationMs);
+        }
+
+        const catEl = document.getElementById('perf-stat-' + record.category);
+        if (catEl) {
+          catEl.textContent = formatMs(record.paintDurationMs);
+        }
+
+        const avgEl = document.getElementById('perf-stat-average');
+        if (avgEl && metricsStore.length > 0) {
+          const total = metricsStore.reduce(function (sum, item) {
+            return sum + item.paintDurationMs;
+          }, 0);
+          avgEl.textContent = formatMs(total / metricsStore.length);
+        }
+
+        const logList = document.getElementById('perf-log-list');
+        if (logList) {
+          const li = document.createElement('li');
+          li.className = 'perf-log-item';
+          li.setAttribute('data-perf-category', record.category);
+          li.setAttribute('data-perf-duration', String(record.paintDurationMs));
+          li.innerHTML =
+            '<span>[' +
+            record.category +
+            '] ' +
+            record.label +
+            '</span><span class="perf-duration">' +
+            formatMs(record.paintDurationMs) +
+            '</span>';
+          logList.insertBefore(li, logList.firstChild);
+        }
+      }
+
+      function recordMetric(category, label, startTime, paintEndTime, extra) {
+        const duration = Math.max(0, paintEndTime - startTime);
+        const id = ++interactionCounter;
+        const startMark = 'dg-' + category + '-' + id + '-start';
+        const endMark = 'dg-' + category + '-' + id + '-paint-end';
+        const measureName = 'dg-paint:' + category + ':' + label;
+
+        try {
+          performance.mark(startMark, { startTime: startTime });
+          performance.mark(endMark, { startTime: paintEndTime });
+          performance.measure(measureName, startMark, endMark);
+        } catch (err) {
+          // Fallback for environments with basic mark/measure signatures
+          try {
+            performance.mark(startMark);
+            performance.mark(endMark);
+            performance.measure(measureName, startMark, endMark);
+          } catch (_) {}
+        }
+
+        const record = Object.assign(
+          {
+            id: id,
+            category: category,
+            label: label,
+            startTime: startTime,
+            paintEndTime: paintEndTime,
+            paintDurationMs: Number(duration.toFixed(3)),
+            timestamp: new Date().toISOString()
+          },
+          extra || {}
+        );
+
+        metricsStore.push(record);
+        categoryLatest[category] = record;
+
+        updateDashboardUI(record);
+
+        console.info(
+          '[PerfMonitor] ' + category + ' | ' + label + ' finished painting in ' + formatMs(duration),
+          record
+        );
+
+        window.dispatchEvent(
+          new CustomEvent('perf:metric-recorded', {
+            detail: record
+          })
+        );
+
+        return record;
+      }
