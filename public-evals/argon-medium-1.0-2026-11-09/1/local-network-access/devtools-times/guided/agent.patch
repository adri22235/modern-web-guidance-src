+                        const val = e.target.value;
+                        setCliState((prev) => ({
+                          ...prev,
+                          url: val,
+                          validationError: prev.validationError ? null : prev.validationError,
+                        }));
+                      }}
+                      onBlur={() => {
+                        if (cliState.touched || cliState.url !== 'http://127.0.0.1:45678/health') {
+                          setCliState((prev) => ({
+                            ...prev,
+                            touched: true,
+                            validationError: validateEndpointUrl(prev.url, 'loopback'),
+                          }));
+                        }
+                      }}
+                      className="w-full px-3 py-2 text-base sm:text-sm font-mono border border-gray-400 rounded focus:outline-2 focus:outline-offset-2 focus:outline-amber-500"
+                    />
+                    <span id="cli-endpoint-help" className="text-xs text-gray-600">
+                      Example: <code>http://127.0.0.1:45678/health</code> or <code>http://localhost:45678/health</code>
+                    </span>
+                    {cliState.validationError && (
+                      <p role="alert" className="text-xs font-semibold text-red-700">
+                        ✕ {cliState.validationError}
+                      </p>
+                    )}
+                  </div>
+
+                  <div className="flex flex-wrap items-center gap-2 pt-1">
+                    <button
+                      type="submit"
+                      disabled={cliState.connectionStatus === 'connecting'}
+                      className="bg-gray-900 hover:bg-gray-800 disabled:bg-gray-400 text-white text-xs font-semibold px-3.5 py-2 rounded transition cursor-pointer"
+                    >
+                      {cliState.connectionStatus === 'connecting'
+                        ? 'Connecting to Local CLI...'
+                        : 'Connect to Local CLI'}
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => toggleWebSocket('loopback')}
+                      className="bg-white hover:bg-gray-100 text-gray-800 border border-gray-300 text-xs font-semibold px-3 py-2 rounded transition cursor-pointer"
+                    >
+                      {cliState.wsStatus === 'open'
+                        ? 'Stop CLI WS Stream'
+                        : 'Stream CLI Logs (WS)'}
+                    </button>
+                  </div>
+                </form>
+              </div>
+
+              <div
+                id="cli-endpoint-status"
+                role="status"
+                aria-live="polite"
+                className="mt-3 pt-3 border-t border-gray-200 text-xs"
+              >
+                {cliState.connectionStatus === 'idle' && (
+                  <p className="text-gray-600">
+                    Status: Ready to connect (declares <code>targetAddressSpace: &apos;loopback&apos;</code>).
+                  </p>
+                )}
+                {cliState.connectionStatus === 'connecting' && (
+                  <p className="text-amber-800 font-medium">
+                    ⟳ Contacting local companion CLI on 127.0.0.1...
+                  </p>
+                )}
+                {cliState.connectionStatus === 'connected' && (
+                  <div className="text-emerald-900 bg-emerald-50 border border-emerald-200 rounded p-2">
+                    <p className="font-semibold">✓ Connected to Local Companion CLI</p>
+                    <pre className="mt-1 font-mono text-[11px] overflow-x-auto">
+                      {JSON.stringify(cliState.payload, null, 2)}
+                    </pre>
+                  </div>
+                )}
+                {cliState.connectionStatus === 'error' && (
+                  <div className="text-red-900 bg-red-50 border border-red-200 rounded p-2">
+                    <p className="font-semibold">✕ Connection Failed</p>
+                    <p className="mt-0.5">{cliState.errorMessage}</p>
+                  </div>
+                )}
+                {cliState.wsLastMessage && (
+                  <p className="mt-1.5 font-mono text-[11px] text-gray-700">
+                    [WebSocket] {cliState.wsLastMessage}
+                  </p>
+                )}
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
