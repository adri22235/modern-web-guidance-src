+      </span>
+    );
+  };
+
+  return (
+    <section
+      aria-label="Developer Diagnostics Connection Widget"
+      className="bg-slate-50 border-b border-gray-300 text-gray-900"
+    >
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <div className="flex items-center gap-2.5">
+            <span
+              aria-hidden="true"
+              className="inline-flex items-center justify-center w-6 h-6 rounded bg-gray-900 text-amber-400 font-mono text-xs font-bold"
+            >
+              LNA
+            </span>
+            <div>
+              <h2 className="text-sm font-bold tracking-tight text-gray-900">
+                Developer Diagnostics Bridge
+              </h2>
+              <p className="text-xs text-gray-600">
+                Connect your browser directly to a private Wi-Fi LAN hardware test device and your local companion CLI via Local Network Access.
+              </p>
+            </div>
+          </div>
+
+          <button
+            type="button"
+            aria-expanded={isExpanded}
+            aria-controls="diagnostics-widget-panel"
+            onClick={() => setIsExpanded((prev) => !prev)}
+            className="text-xs font-semibold text-gray-800 bg-white hover:bg-gray-100 border border-gray-300 rounded px-3 py-1.5 transition"
+          >
+            {isExpanded ? 'Hide Diagnostics' : 'Open Diagnostics'}
+          </button>
+        </div>
+
+        <div id="diagnostics-widget-panel" hidden={!isExpanded} className="mt-4">
+          {!isSecure && (
+            <div
+              role="alert"
+              className="mb-4 p-3 rounded border border-amber-400 bg-amber-50 text-xs text-amber-950"
+            >
+              <strong>Secure Context Required:</strong> Local Network Access permissions (
+              <code>local-network</code> and <code>loopback-network</code>) require an{' '}
+              <code>https://</code> origin. Requests initiated from an insecure{' '}
+              <code>http://</code> top-level context will be denied by the browser.
+            </div>
+          )}
+
+          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
+            {/* Card 1: Hardware Test Device on Private Wi-Fi LAN */}
+            <div className="bg-white border border-gray-300 rounded-md p-4 shadow-xs flex flex-col justify-between">
+              <div>
+                <div className="flex items-start justify-between gap-2 mb-2">
