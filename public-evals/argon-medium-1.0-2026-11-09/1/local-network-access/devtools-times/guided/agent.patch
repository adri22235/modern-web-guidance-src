+import React, { useState, useEffect, useRef, useCallback } from 'react';
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+/**
+ * Cross-browser permission check for granular Local Network Access permissions.
+ * Never queries the legacy 'local-network-access' alias, which crashes older Chrome renderers.
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void
+): Promise<{ state: PermissionState; cleanup?: () => void }> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return { state: 'prompt' };
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    const handleChange = () => {
+      onChange?.(status.state);
+    };
+    status.addEventListener('change', handleChange);
+    return {
+      state: status.state,
+      cleanup: () => status.removeEventListener('change', handleChange),
+    };
+  } catch {
+    // Unrecognized permission name in browsers without LNA support; fall back to 'prompt'
+    // so requests still run on an explicit user gesture.
+    return { state: 'prompt' };
+  }
+}
+
+/**
+ * Connects to a hardware test device on the user's private Wi-Fi LAN (RFC 1918 / .local).
+ * Explicitly declares targetAddressSpace: 'local' for Mixed Content exemption and DNS verification.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status'
+): Promise<Record<string, unknown>> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Hardware device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion CLI daemon running on the user's loopback interface (127.0.0.1 / localhost).
+ * Explicitly declares targetAddressSpace: 'loopback' for Mixed Content exemption and DNS verification.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health'
+): Promise<Record<string, unknown>> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion CLI responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Opens a WebSocket connection to a local or loopback endpoint for live telemetry.
+ * Passes only the subprotocol array as the second argument (never a targetAddressSpace options object).
+ */
+export function openLocalWebSocket(wsUrl: string): WebSocket {
+  return new WebSocket(wsUrl, ['v1.telemetry']);
+}
+
+interface EndpointState {
+  url: string;
+  touched: boolean;
+  validationError: string | null;
+  permissionState: PermissionState;
+  connectionStatus: 'idle' | 'connecting' | 'connected' | 'error';
+  payload: Record<string, unknown> | null;
+  errorMessage: string | null;
+  wsStatus: 'closed' | 'connecting' | 'open' | 'error';
+  wsLastMessage: string | null;
+}
+
+function validateEndpointUrl(value: string, space: TargetAddressSpace): string | null {
+  const trimmed = value.trim();
+  if (!trimmed) {
+    return 'Please enter an endpoint URL.';
+  }
+  try {
+    const parsed = new URL(trimmed);
+    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+      return 'URL must start with http:// or https://.';
+    }
+    if (space === 'loopback') {
+      const host = parsed.hostname.toLowerCase();
+      const isLoopback =
+        host === '127.0.0.1' ||
+        host === 'localhost' ||
+        host === '[::1]' ||
+        host === '::1' ||
+        host.startsWith('127.');
+      if (!isLoopback) {
+        return 'Loopback CLI URL must target 127.0.0.1, [::1], or localhost.';
+      }
+    }
+    return null;
+  } catch {
+    return 'Please enter a valid URL (e.g., http://192.168.1.100:8080/api/status).';
+  }
+}
+
+function deriveWebSocketUrl(httpUrl: string): string {
+  try {
+    const parsed = new URL(httpUrl);
+    parsed.protocol = parsed.protocol === 'https:' ? 'wss:' : 'ws:';
+    parsed.pathname = '/stream';
+    parsed.search = '';
+    return parsed.toString();
+  } catch {
+    return 'ws://192.168.1.100:8080/stream';
+  }
+}
+
+export default function DiagnosticsWidget() {
+  const [isExpanded, setIsExpanded] = useState(true);
+  const [isSecure, setIsSecure] = useState(true);
+
+  const [lanState, setLanState] = useState<EndpointState>({
+    url: 'http://192.168.1.100:8080/api/status',
+    touched: false,
+    validationError: null,
+    permissionState: 'prompt',
+    connectionStatus: 'idle',
+    payload: null,
+    errorMessage: null,
+    wsStatus: 'closed',
+    wsLastMessage: null,
+  });
+
+  const [cliState, setCliState] = useState<EndpointState>({
+    url: 'http://127.0.0.1:45678/health',
+    touched: false,
+    validationError: null,
+    permissionState: 'prompt',
+    connectionStatus: 'idle',
+    payload: null,
+    errorMessage: null,
+    wsStatus: 'closed',
+    wsLastMessage: null,
+  });
+
+  const lanInputRef = useRef<HTMLInputElement>(null);
+  const cliInputRef = useRef<HTMLInputElement>(null);
+  const lanWsRef = useRef<WebSocket | null>(null);
+  const cliWsRef = useRef<WebSocket | null>(null);
+
+  const connectLanDevice = useCallback(async (targetUrl: string) => {
+    setLanState((prev) => ({
+      ...prev,
+      connectionStatus: 'connecting',
+      errorMessage: null,
+    }));
+    try {
+      const data = await fetchLocalDeviceStatus(targetUrl);
+      setLanState((prev) => ({
+        ...prev,
+        connectionStatus: 'connected',
+        payload: data,
+        errorMessage: null,
+      }));
+    } catch (err) {
+      const msg =
+        err instanceof Error
+          ? err.message
+          : 'Network error while connecting to LAN hardware device.';
+      setLanState((prev) => ({
+        ...prev,
+        connectionStatus: 'error',
+        errorMessage: `${msg} Ensure the hardware test device is powered on, connected to the same Wi-Fi LAN, returns CORS headers (Access-Control-Allow-Origin), and is allowed under Local network permissions.`,
+      }));
+    }
+  }, []);
+
+  const connectLoopbackCli = useCallback(async (targetUrl: string) => {
+    setCliState((prev) => ({
+      ...prev,
+      connectionStatus: 'connecting',
+      errorMessage: null,
+    }));
+    try {
+      const data = await fetchLoopbackDaemon(targetUrl);
+      setCliState((prev) => ({
+        ...prev,
+        connectionStatus: 'connected',
+        payload: data,
+        errorMessage: null,
+      }));
+    } catch (err) {
+      const msg =
+        err instanceof Error
+          ? err.message
+          : 'Network error while connecting to local companion CLI.';
+      setCliState((prev) => ({
+        ...prev,
+        connectionStatus: 'error',
+        errorMessage: `${msg} Ensure the companion CLI is running on 127.0.0.1, includes Access-Control-Allow-Origin headers, and is allowed under Loopback network permissions.`,
+      }));
+    }
+  }, []);
+
+  useEffect(() => {
+    if (typeof window !== 'undefined') {
+      setIsSecure(window.isSecureContext);
+    }
+
+    let cleanupLan: (() => void) | undefined;
+    let cleanupCli: (() => void) | undefined;
+
+    // 1. Pre-check 'local-network' permission; auto-connect ONLY if already 'granted'
+    queryLnaPermissionSafe('local-network', (newState) => {
+      setLanState((prev) => ({ ...prev, permissionState: newState }));
+    }).then(({ state, cleanup }) => {
+      cleanupLan = cleanup;
+      setLanState((prev) => ({ ...prev, permissionState: state }));
+      if (state === 'granted') {
+        connectLanDevice('http://192.168.1.100:8080/api/status');
+      }
+    });
+
+    // 2. Pre-check 'loopback-network' permission; auto-connect ONLY if already 'granted'
+    queryLnaPermissionSafe('loopback-network', (newState) => {
+      setCliState((prev) => ({ ...prev, permissionState: newState }));
+    }).then(({ state, cleanup }) => {
+      cleanupCli = cleanup;
+      setCliState((prev) => ({ ...prev, permissionState: state }));
+      if (state === 'granted') {
+        connectLoopbackCli('http://127.0.0.1:45678/health');
+      }
+    });
+
+    return () => {
+      cleanupLan?.();
+      cleanupCli?.();
+      lanWsRef.current?.close();
+      cliWsRef.current?.close();
+    };
+  }, [connectLanDevice, connectLoopbackCli]);
+
+  const handleLanSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const error = validateEndpointUrl(lanState.url, 'local');
+    if (error) {
+      setLanState((prev) => ({ ...prev, touched: true, validationError: error }));
