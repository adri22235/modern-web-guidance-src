+            `[${errName}] fetch to ${requestUrl} with targetAddressSpace="${targetAddressSpace}" failed: ${err && err.message ? err.message : 'Network error'}`
+          );
+        }
+      }
+
+      // Wire up Shop Wi-Fi Brewer (Private LAN -> targetAddressSpace: 'local')
+      const lanInput = document.getElementById('lan-endpoint-input');
+      const lanRecipeSelect = document.getElementById('lan-recipe-select');
+      const lanConnectBtn = document.getElementById('lan-connect-btn');
+      const lanBrewBtn = document.getElementById('lan-brew-btn');
+      const lanStateEl = document.getElementById('lan-connection-state');
+      const lanDetailEl = document.getElementById('lan-status-detail');
+
+      lanConnectBtn.addEventListener('click', function () {
+        performEquipmentRequest({
+          endpoint: lanInput.value.trim(),
+          pathSuffix: '/status',
+          method: 'GET',
+          targetAddressSpace: 'local',
+          permissionName: 'local-network',
+          stateEl: lanStateEl,
+          detailEl: lanDetailEl,
+          onSuccess: function (data) {
+            document.getElementById('lan-temp-val').textContent = `${data.boilerTempC || 93.2} °C`;
+            document.getElementById('lan-flow-val').textContent = `${data.flowRateMlS || 4.5} ml/s`;
+            document.getElementById('lan-tank-val').textContent = `${data.waterLevelPct || 86} %`;
+          }
+        });
+      });
+
+      lanBrewBtn.addEventListener('click', function () {
+        const recipe = lanRecipeSelect.value;
+        performEquipmentRequest({
+          endpoint: lanInput.value.trim(),
+          pathSuffix: '/brew',
+          method: 'POST',
+          payload: { profile: recipe, requestedAt: new Date().toISOString() },
+          targetAddressSpace: 'local',
+          permissionName: 'local-network',
+          stateEl: lanStateEl,
+          detailEl: lanDetailEl,
+          onSuccess: function (data) {
+            document.getElementById('lan-temp-val').textContent = `${data.boilerTempC || 93.5} °C`;
+            document.getElementById('lan-flow-val').textContent = `${data.flowRateMlS || 5.2} ml/s`;
+            document.getElementById('lan-tank-val').textContent = `${data.waterLevelPct || 82} %`;
+          }
+        });
+      });
+
+      // Wire up Companion Desktop Brewing Helper (Loopback -> targetAddressSpace: 'loopback')
+      const loopbackInput = document.getElementById('loopback-endpoint-input');
+      const loopbackGrindInput = document.getElementById('loopback-grind-input');
+      const loopbackConnectBtn = document.getElementById('loopback-connect-btn');
+      const loopbackSyncBtn = document.getElementById('loopback-sync-btn');
+      const loopbackStateEl = document.getElementById('loopback-connection-state');
+      const loopbackDetailEl = document.getElementById('loopback-status-detail');
+
+      loopbackConnectBtn.addEventListener('click', function () {
+        performEquipmentRequest({
+          endpoint: loopbackInput.value.trim(),
+          pathSuffix: '/status',
+          method: 'GET',
+          targetAddressSpace: 'loopback',
+          permissionName: 'loopback-network',
+          stateEl: loopbackStateEl,
+          detailEl: loopbackDetailEl,
+          onSuccess: function (data) {
+            document.getElementById('loopback-weight-val').textContent = `${data.scaleWeightG || '0.0'} g`;
+            document.getElementById('loopback-burr-val').textContent = `Step ${data.burrStep || 14}`;
+            document.getElementById('loopback-version-val').textContent = data.version || 'v2.4.0';
+          }
+        });
+      });
+
+      loopbackSyncBtn.addEventListener('click', function () {
+        const targetDoseG = parseFloat(loopbackGrindInput.value) || 18.5;
+        performEquipmentRequest({
+          endpoint: loopbackInput.value.trim(),
+          pathSuffix: '/sync-dose',
+          method: 'POST',
+          payload: { targetDoseG, tareScale: true },
+          targetAddressSpace: 'loopback',
+          permissionName: 'loopback-network',
+          stateEl: loopbackStateEl,
+          detailEl: loopbackDetailEl,
+          onSuccess: function (data) {
+            document.getElementById('loopback-weight-val').textContent = `${data.scaleWeightG || targetDoseG.toFixed(1)} g`;
+            document.getElementById('loopback-burr-val').textContent = `Step ${data.burrStep || 14}`;
+            document.getElementById('loopback-version-val').textContent = data.version || 'v2.4.0';
+          }
+        });
+      });
+
+      document.getElementById('refresh-permissions-btn').addEventListener('click', function () {
+        refreshAllPermissions();
+      });
+
+      document.getElementById('clear-log-btn').addEventListener('click', function () {
+        logContainer.innerHTML = '';
+        appendLog('Log cleared.');
+      });
+
+      // Check permissions passively on load without making any network requests
+      refreshAllPermissions();
+    })();
