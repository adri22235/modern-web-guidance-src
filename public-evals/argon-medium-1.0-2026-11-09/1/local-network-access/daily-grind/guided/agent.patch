+    const loopbackRemediation = document.querySelector('[data-remediation="loopback-network"]');
+    let loopbackSocket = null;
+
+    const validateLoopbackField = setupFieldValidation(
+      loopbackInput,
+      loopbackError,
+      'Enter a valid loopback URL on 127.0.0.1, [::1], or localhost (e.g., http://127.0.0.1:45678/health).'
+    );
+
+    async function connectToLoopbackHelper(url) {
+      loopbackConnectBtn.disabled = true;
+      loopbackStateEl.textContent = `Connecting to ${url}…`;
+      try {
+        const data = await fetchLoopbackDaemon(url);
+        loopbackStateEl.textContent = 'Connected to Desktop Helper';
+        loopbackVersionEl.textContent = data.version ?? 'v2.4.0 (USB Scale Active)';
+        loopbackWeightEl.textContent = data.weight ?? '18.0 g';
+        loopbackFlowEl.textContent = data.flowRate ?? '0.0 g/s';
+        loopbackRemediation.hidden = true;
+      } catch (err) {
+        loopbackStateEl.textContent = `Connection failed (${err instanceof Error ? err.message : 'Network error'})`;
+        loopbackRemediation.hidden = false;
+      } finally {
+        loopbackConnectBtn.disabled = false;
+      }
+    }
+
+    loopbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!validateLoopbackField()) {
+        loopbackInput.focus();
+        return;
+      }
+      await connectToLoopbackHelper(loopbackInput.value.trim());
+    });
+
+    loopbackWsBtn.addEventListener('click', () => {
+      if (!validateLoopbackField()) {
+        loopbackInput.focus();
+        return;
+      }
+      if (loopbackSocket) {
+        loopbackSocket.close();
+        loopbackSocket = null;
+      }
+      const wsUrl = toWebSocketStreamUrl(loopbackInput.value.trim());
+      loopbackStateEl.textContent = `Opening scale stream (${wsUrl})…`;
+      try {
+        loopbackSocket = openTelemetryWebSocket(wsUrl);
+        loopbackSocket.addEventListener('open', () => {
+          loopbackStateEl.textContent = `Streaming scale readout from ${wsUrl}`;
+          loopbackRemediation.hidden = true;
+        });
+        loopbackSocket.addEventListener('message', (msgEvent) => {
+          try {
+            const payload = JSON.parse(msgEvent.data);
+            if (payload.version) loopbackVersionEl.textContent = payload.version;
+            if (payload.weight) loopbackWeightEl.textContent = payload.weight;
+            if (payload.flowRate) loopbackFlowEl.textContent = payload.flowRate;
+          } catch {
+            loopbackWeightEl.textContent = String(msgEvent.data);
+          }
+        });
+        loopbackSocket.addEventListener('error', () => {
+          loopbackStateEl.textContent = `Scale stream failed (${wsUrl})`;
+          loopbackRemediation.hidden = false;
+        });
+      } catch (err) {
+        loopbackStateEl.textContent = `WebSocket error: ${err instanceof Error ? err.message : 'Unable to connect'}`;
+        loopbackRemediation.hidden = false;
+      }
+    });
+
+    // Pre-check granular permissions on page load; auto-connect ONLY if already 'granted'.
+    async function initEquipmentConnections() {
+      const [localPerm, loopbackPerm] = await Promise.all([
+        queryLnaPermissionSafe('local-network'),
+        queryLnaPermissionSafe('loopback-network'),
+      ]);
+
+      if (localPerm === 'granted') {
+        connectToLanBrewer(lanInput.value.trim());
+      }
+      if (loopbackPerm === 'granted') {
+        connectToLoopbackHelper(loopbackInput.value.trim());
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
 </body>
 
