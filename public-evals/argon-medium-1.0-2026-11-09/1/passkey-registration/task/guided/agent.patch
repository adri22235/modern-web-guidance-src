+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const statusMessage = document.getElementById('passkey-status');
+
+    function setStatus(message) {
+      if (statusMessage) {
+        statusMessage.textContent = message;
+      }
+    }
+
+    async function optionsFetch(payload) {
+      const response = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(payload),
+      });
+      if (!response.ok) {
+        throw new Error(`Failed to fetch registration options: ${response.status}`);
+      }
+      return response.json();
+    }
+
+    async function registerVerifyFetch(encodedResponse) {
+      return fetch('/api/register/verify', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(encodedResponse),
+      });
+    }
+
+    async function checkPasskeyCapabilities() {
+      if (
+        typeof PublicKeyCredential === 'undefined' ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        if (registerButton) {
+          registerButton.disabled = true;
+        }
+        return false;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (
+          !capabilities ||
+          !capabilities.passkeyPlatformAuthenticator ||
+          !capabilities.conditionalGet
+        ) {
+          if (registerButton) {
+            registerButton.disabled = true;
+          }
+          return false;
+        }
+        if (registerButton) {
+          registerButton.disabled = false;
+        }
+        return true;
+      } catch (err) {
+        console.error('Failed to check WebAuthn client capabilities:', err);
+        if (registerButton) {
+          registerButton.disabled = true;
+        }
+        return false;
+      }
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      const hasCapabilities = await checkPasskeyCapabilities();
+      if (!hasCapabilities) {
+        return;
+      }
+
+      let creationOptionsJSON;
+      let publicKey;
+      try {
+        creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+        publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      } catch (err) {
+        console.error('Failed to load or parse passkey creation options:', err);
+        setStatus('Unable to start passkey registration.');
+        return;
+      }
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          setStatus('A passkey already exists for this account.');
+          alert('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          setStatus('Configuration RP ID or Secure Context error.');
+          alert('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+          setStatus('Passkey registration was cancelled.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+          setStatus('Passkey registration was aborted.');
+        }
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      const encodedResponse = credential.toJSON();
+      try {
+        const response = await registerVerifyFetch(encodedResponse);
+        if (!response.ok) {
+          setStatus('Passkey verification failed.');
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id,
+              credentialId: encodedResponse.id,
+            });
+          }
+          return;
+        }
+        setStatus('Passkey created successfully.');
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        setStatus('Network error during passkey verification.');
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        }
+      }
+    }
+
+    checkPasskeyCapabilities();
+
+    if (registerButton) {
+      registerButton.addEventListener('click', () => {
+        registerPasskey(true);
+      });
+    }
+  </script>
 </body>
 
