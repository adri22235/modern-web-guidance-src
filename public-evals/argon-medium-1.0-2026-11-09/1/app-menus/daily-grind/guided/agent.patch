+        if (target !== submenu || (left ? clientX < lastX : clientX > lastX)) return stop();
+        lastX = clientX;
+        clearTimeout(timer);
+        timer = setTimeout(stop, 300);
+      };
+      timer = setTimeout(stop, 300);
+      submenu.addEventListener('pointermove', extend);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // Trigger setup (both top-level menubar triggers and submenu triggers).
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      const isRoot = rootTriggers.includes(trigger);
+      let hoverPreviewTimer;
+
+      // Prevent pointerdown from moving focus prior to toggle.
+      trigger.addEventListener('pointerdown', event => {
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener('click', event => {
+        const fromPointer = pointerTrigger === trigger || event.detail > 0;
+        if (!hasInvokerCommands) {
+          event.preventDefault();
+          if (isOpen(menu)) {
+            closeAndRestore(menu, { fromPointer });
+          } else {
+            if (!fromPointer) enterOnOpen.add(menu);
+            menu.showPopover({ source: trigger });
+          }
+        } else if (!fromPointer && !isOpen(menu)) {
+          enterOnOpen.add(menu);
+        }
+        pointerTrigger = null;
+      });
+
+      // Preview on focus (both top-level menubar triggers and submenu triggers).
+      trigger.addEventListener('focus', event => {
+        if (
+          windowBlurred ||
+          suppressPreviewOnFocus.has(trigger) ||
+          (event.relatedTarget && menu.contains(event.relatedTarget))
+        ) {
+          return;
+        }
+        if (!isOpen(menu)) {
+          if (!isRoot && pointerTrigger === null && canHover.matches && event.relatedTarget && menu.parentElement?.contains(event.relatedTarget)) {
+            // Submenu trigger focused via pointer movement: short delay prevents flashing when crossing items.
+            clearTimeout(hoverPreviewTimer);
+            hoverPreviewTimer = setTimeout(() => {
+              if (document.activeElement === trigger && !isOpen(menu)) {
+                menu.showPopover({ source: trigger });
+              }
+            }, 90);
+          } else {
+            menu.showPopover({ source: trigger });
+          }
+        }
+      });
+
+      trigger.addEventListener('blur', event => {
+        clearTimeout(hoverPreviewTimer);
+        if (isOpen(menu) && (!event.relatedTarget || !menu.contains(event.relatedTarget))) {
+          menu.hidePopover();
+        }
+      });
+
+      if (isRoot) {
+        // Hover switches open menus on the menubar; when nothing is open, hover does nothing.
+        trigger.addEventListener('pointerenter', () => {
+          const anyRootOpen = rootTriggers.some(t => isOpen(menuFor(t)));
+          if (!anyRootOpen || isOpen(menu)) return;
+          rootTriggers.forEach(t => {
+            const m = menuFor(t);
+            if (t !== trigger && isOpen(m)) m.hidePopover();
+          });
+          trigger.focus({ preventScroll: true, focusVisible: false });
+        });
+
+        trigger.addEventListener('keydown', event => {
+          if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+            event.preventDefault();
+            moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+          } else if (event.key === 'ArrowDown') {
+            event.preventDefault();
+            if (isOpen(menu)) {
+              enabledItems(menu)[0]?.focus({ preventScroll: true });
+            } else {
+              enterOnOpen.add(menu);
+              trigger.click();
+            }
+          } else if (event.key === 'Home' || event.key === 'End') {
+            event.preventDefault();
+            if (!isOpen(menu)) {
+              menu.showPopover({ source: trigger });
+            }
+            const items = enabledItems(menu);
+            const target = event.key === 'Home' ? items[0] : items[items.length - 1];
+            target?.focus({ preventScroll: true });
+          } else if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            closeAndRestore(menu);
+          } else if (event.key === 'Tab') {
+            rootTriggers.map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+          }
+        });
+      } else {
+        // Submenu trigger safe-triangle bridge on pointerleave.
+        trigger.addEventListener('pointerleave', event => {
+          startBridge(menu, event);
+        });
+      }
+    });
+
+    // Sync aria-expanded and focus management in each menu's toggle listener.
+    menus.forEach(menu => {
+      const trigger = triggerFor(menu);
+      menu.addEventListener('toggle', event => {
+        const open = event.newState ? event.newState === 'open' : isOpen(menu);
+        trigger?.setAttribute('aria-expanded', String(open));
+        if (open) {
+          positionMenuFallback(menu, trigger);
+          if (enterOnOpen.has(menu)) {
+            enterOnOpen.delete(menu);
+            enabledItems(menu)[0]?.focus({ preventScroll: true });
+          } else if (pointerTrigger === trigger) {
+            focusWithoutPreview(trigger, { preventScroll: true, focusVisible: false });
+          }
+        }
+        if (pointerTrigger === trigger) {
+          pointerTrigger = null;
+        }
+      });
+
+      // Keyboard handling inside an open menu or submenu.
+      menu.addEventListener('keydown', event => {
+        if (event.key === ' ' || event.key === 'Enter') {
+          lastActivationKey = event.key;
+        }
+
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu);
+        } else if (event.key === 'ArrowLeft') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (rootTriggers.includes(trigger)) {
+            moveToRootTrigger(trigger, -1);
+          } else {
+            closeAndRestore(menu);
+          }
+        } else if (event.key === 'ArrowRight') {
+          event.preventDefault();
+          event.stopPropagation();
+          const active = document.activeElement;
+          if (active && active.hasAttribute('commandfor')) {
+            const subMenu = menuFor(active);
+            if (!isOpen(subMenu)) {
+              subMenu.showPopover({ source: active });
+            }
+            enabledItems(subMenu)[0]?.focus({ preventScroll: true });
+          } else {
+            const rootMenu = rootMenuFor(menu);
+            const rootTrigger = triggerFor(rootMenu);
+            if (rootTrigger) {
+              moveToRootTrigger(rootTrigger, 1);
+            }
+          }
+        } else if (event.key === 'Home' || event.key === 'End') {
+          const items = enabledItems(menu);
+          if (items.includes(document.activeElement)) {
+            event.preventDefault();
+            event.stopPropagation();
+            const target = event.key === 'Home' ? items[0] : items[items.length - 1];
+            target?.focus({ preventScroll: true });
+          }
+        } else if (event.key === 'Tab') {
+          const rootMenu = rootMenuFor(menu);
+          const rootTrigger = triggerFor(rootMenu);
+          if (rootTrigger) {
+            focusWithoutPreview(rootTrigger, { preventScroll: true });
+          }
+          rootTriggers.map(menuFor).filter(isOpen).forEach(m => m.hidePopover());
+        }
+      });
+
+      // Pointer hover follows focus on items inside the menu.
+      menu.addEventListener('pointermove', event => {
+        const item = event.target.closest('button');
+        if (!item || item.closest('[focusgroup]') !== menu.querySelector('[focusgroup~="menu"]')) return;
+        const hit = document.elementFromPoint(event.clientX, event.clientY);
+        if (!hit || !item.contains(hit)) return;
+        if (document.activeElement !== item) {
+          item.focus({ preventScroll: true, focusVisible: false });
+        }
+      });
+
+      // Command and checkable item activation.
+      menu.addEventListener('click', event => {
+        const item = event.target.closest('button:not([commandfor])');
+        if (!item || item.closest('[focusgroup]') !== menu.querySelector('[focusgroup~="menu"]')) return;
+        if (item.disabled || item.getAttribute('aria-disabled') === 'true') return;
+
+        const fromPointer = event.detail > 0;
+        const keyUsed = fromPointer ? null : lastActivationKey;
+        lastActivationKey = null;
+
+        const role = item.getAttribute('role');
+        const rootMenu = rootMenuFor(menu);
+        const label = (item.dataset.action || item.textContent || '').trim();
+
+        if (role === 'menuitemcheckbox') {
+          const checked = item.getAttribute('aria-checked') !== 'true';
+          item.setAttribute('aria-checked', String(checked));
+          announce(`${label} ${checked ? 'checked' : 'unchecked'}`);
+          // Space on a checkbox toggles and stays open (APG); Enter or pointer closes after a brief confirm.
+          if (keyUsed === ' ') return;
+          setTimeout(() => {
+            if (rootMenu) closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+        } else if (role === 'menuitemradio') {
+          const group = item.closest('[role="group"]');
+          if (group) {
+            group.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+              radio.setAttribute('aria-checked', String(radio === item));
+            });
+          }
+          announce(`${label} selected`);
+          setTimeout(() => {
+            if (rootMenu) closeAndRestore(rootMenu, { fromPointer });
+          }, 300);
+        } else {
+          announce(`${label} activated`);
+          if (rootMenu) closeAndRestore(rootMenu, { fromPointer });
+        }
+      });
+    });
+
+    // Close every open menu when focus moves outside the menubar system.
+    document.addEventListener('focusin', event => {
+      if (!menubar.contains(event.target)) {
+        rootTriggers.map(menuFor).filter(isOpen).forEach(menu => menu.hidePopover());
+      }
+    });
+  </script>
+
 </body>
 
