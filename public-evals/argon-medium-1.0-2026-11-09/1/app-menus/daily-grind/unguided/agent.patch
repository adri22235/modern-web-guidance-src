+  <script>
+    (function () {
+      const menubar = document.querySelector('[role="menubar"]');
+      if (!menubar) return;
+
+      const topItems = Array.from(menubar.querySelectorAll(':scope > .menubar-item'));
+      const triggers = topItems.map((item) => item.querySelector(':scope > [role="menuitem"]'));
+
+      function getSubmenuItems(index) {
+        const submenu = topItems[index].querySelector(':scope > [role="menu"]');
+        return submenu ? Array.from(submenu.querySelectorAll('[role="menuitem"]')) : [];
+      }
+
+      function isAnyMenuOpen() {
+        return triggers.some((t) => t.getAttribute('aria-expanded') === 'true');
+      }
+
+      function setRovingTabindex(activeTrigger) {
+        triggers.forEach((trigger) => {
+          trigger.setAttribute('tabindex', trigger === activeTrigger ? '0' : '-1');
+        });
+      }
+
+      function closeAllMenus() {
+        topItems.forEach((item, idx) => {
+          item.classList.remove('open');
+          triggers[idx].setAttribute('aria-expanded', 'false');
+        });
+      }
+
+      function openMenu(index, focusSubitem = null) {
+        closeAllMenus();
+        const item = topItems[index];
+        const trigger = triggers[index];
+        if (!item || !trigger) return;
+
+        item.classList.add('open');
+        trigger.setAttribute('aria-expanded', 'true');
+        setRovingTabindex(trigger);
+
+        const subitems = getSubmenuItems(index);
+        if (focusSubitem === 'first' && subitems.length > 0) {
+          subitems[0].focus();
+        } else if (focusSubitem === 'last' && subitems.length > 0) {
+          subitems[subitems.length - 1].focus();
+        }
+      }
+
+      function focusTopItem(index, openSubmenu = false, subFocus = null) {
+        const count = triggers.length;
+        const nextIndex = (index + count) % count;
+        const trigger = triggers[nextIndex];
+        setRovingTabindex(trigger);
+
+        if (openSubmenu) {
+          openMenu(nextIndex, subFocus);
+          if (!subFocus) {
+            trigger.focus();
+          }
+        } else {
+          closeAllMenus();
+          trigger.focus();
+        }
+      }
+
+      triggers.forEach((trigger, index) => {
+        trigger.addEventListener('click', (event) => {
+          event.preventDefault();
+          const expanded = trigger.getAttribute('aria-expanded') === 'true';
+          if (expanded) {
+            closeAllMenus();
+            trigger.focus();
+          } else {
+            openMenu(index);
+            trigger.focus();
+          }
+        });
+
+        trigger.addEventListener('mouseenter', () => {
+          if (isAnyMenuOpen() && trigger.getAttribute('aria-expanded') !== 'true') {
+            openMenu(index);
+            trigger.focus();
+          }
+        });
+
+        trigger.addEventListener('keydown', (event) => {
+          const expanded = trigger.getAttribute('aria-expanded') === 'true';
+
+          switch (event.key) {
+            case 'ArrowRight':
+              event.preventDefault();
+              focusTopItem(index + 1, expanded, expanded ? 'first' : null);
+              break;
+            case 'ArrowLeft':
+              event.preventDefault();
+              focusTopItem(index - 1, expanded, expanded ? 'first' : null);
+              break;
+            case 'ArrowDown':
+            case 'Enter':
+            case ' ':
+              event.preventDefault();
+              openMenu(index, 'first');
+              break;
+            case 'ArrowUp':
+              event.preventDefault();
+              openMenu(index, 'last');
+              break;
+            case 'Home':
+              event.preventDefault();
+              focusTopItem(0, expanded);
+              break;
+            case 'End':
+              event.preventDefault();
+              focusTopItem(triggers.length - 1, expanded);
+              break;
+            case 'Escape':
+              if (expanded) {
+                event.preventDefault();
+                closeAllMenus();
+                trigger.focus();
+              }
+              break;
+          }
+        });
+
+        const subitems = getSubmenuItems(index);
+        subitems.forEach((subitem, subIndex) => {
+          subitem.addEventListener('keydown', (event) => {
+            switch (event.key) {
+              case 'ArrowDown':
+                event.preventDefault();
+                subitems[(subIndex + 1) % subitems.length].focus();
+                break;
+              case 'ArrowUp':
+                event.preventDefault();
+                subitems[(subIndex - 1 + subitems.length) % subitems.length].focus();
+                break;
+              case 'ArrowRight':
+                event.preventDefault();
+                focusTopItem(index + 1, true, 'first');
+                break;
+              case 'ArrowLeft':
+                event.preventDefault();
+                focusTopItem(index - 1, true, 'first');
+                break;
+              case 'Home':
+                event.preventDefault();
+                subitems[0].focus();
+                break;
+              case 'End':
+                event.preventDefault();
+                subitems[subitems.length - 1].focus();
+                break;
+              case 'Escape':
+                event.preventDefault();
+                closeAllMenus();
+                trigger.focus();
+                break;
+              case 'Tab':
+                closeAllMenus();
+                break;
+              default:
+                if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+                  const char = event.key.toLowerCase();
+                  const ordered = subitems.slice(subIndex + 1).concat(subitems.slice(0, subIndex + 1));
+                  const match = ordered.find((item) => item.textContent.trim().toLowerCase().startsWith(char));
+                  if (match) {
+                    event.preventDefault();
+                    match.focus();
+                  }
+                }
+                break;
+            }
+          });
+        });
+      });
+
+      document.addEventListener('click', (event) => {
+        if (!menubar.contains(event.target)) {
+          closeAllMenus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
