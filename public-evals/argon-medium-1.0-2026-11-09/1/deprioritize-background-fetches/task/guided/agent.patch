diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,30 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Fetch Priority Demo</title>
+</head>
+<body>
+  <button id="fetch-btn" type="button">Load Data</button>
+
+  <script type="module">
+    const button = document.getElementById('fetch-btn');
+
+    button.addEventListener('click', async () => {
+      // Use default high priority for mission-critical data
+      const dataRequest = fetch('/api/data');
+
+      // Deprioritize background analytics to prevent network contention
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low'
+      });
+
+      await dataRequest;
+    });
+  </script>
+</body>
+</html>
