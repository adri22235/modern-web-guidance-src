+  <script>
+    (function () {
+      const roastingWidget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      const stageBadgeEl = document.getElementById('roast-stage-badge');
+
+      if (!roastingWidget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let rafId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+      let isSkippedByContentVisibility = false;
+
+      // Temperature simulation state
+      let currentTemp = 385.0;
+      let tempDirection = 1;
+      const MIN_TEMP = 370.0;
+      const MAX_TEMP = 445.0;
+      const TEMP_INTERVAL_MS = 200;
+
+      // Roasting coffee beans state
+      const BEAN_COUNT = 28;
+      const beans = [];
+      let drumAngle = 0;
+      let tickCount = 0;
+
+      for (let i = 0; i < BEAN_COUNT; i++) {
+        beans.push({
+          x: 80 + ((i * 31) % (canvas.width - 160)),
+          y: 60 + ((i * 47) % (canvas.height - 110)),
+          vx: (i % 2 === 0 ? 1 : -1) * (1.2 + (i % 5) * 0.35),
+          vy: -1.5 - (i % 4) * 0.45,
+          radiusX: 12 + (i % 4) * 1.5,
+          radiusY: 8 + (i % 3) * 1.2,
+          angle: (i * 0.45) % (Math.PI * 2),
+          angularVelocity: (i % 2 === 0 ? 1 : -1) * (0.03 + (i % 4) * 0.012),
+          shadeOffset: (i % 7) * 3
+        });
+      }
+
+      function getRoastStage(temp) {
+        if (temp < 395) return 'Drying & Yellowing';
+        if (temp < 415) return 'Maillard Phase';
+        if (temp < 430) return 'First Crack';
+        return 'Development Roast';
+      }
+
+      function updateTemperature() {
+        const step = 1.3 + ((tickCount % 3) * 0.2);
+        currentTemp += tempDirection * step;
+        tickCount++;
+
+        if (currentTemp >= MAX_TEMP) {
+          currentTemp = MAX_TEMP;
+          tempDirection = -1;
+        } else if (currentTemp <= MIN_TEMP) {
+          currentTemp = MIN_TEMP;
+          tempDirection = 1;
+        }
+
+        tempValueEl.textContent = currentTemp.toFixed(1) + '°F';
+        if (stageBadgeEl) {
+          stageBadgeEl.textContent = getRoastStage(currentTemp);
+        }
+      }
+
+      function getBeanColor(temp, offset) {
+        const progress = Math.max(0, Math.min(1, (temp - MIN_TEMP) / (MAX_TEMP - MIN_TEMP)));
+        const r = Math.round(145 - progress * 75 + offset);
+        const g = Math.round(92 - progress * 55 + offset * 0.6);
+        const b = Math.round(52 - progress * 34 + offset * 0.3);
+        return 'rgb(' + r + ', ' + g + ', ' + b + ')';
+      }
+
+      function drawFrame() {
+        if (!ctx) return;
+        const w = canvas.width;
+        const h = canvas.height;
+
+        ctx.clearRect(0, 0, w, h);
+
+        // Background heat glow
+        const heatRatio = (currentTemp - MIN_TEMP) / (MAX_TEMP - MIN_TEMP);
+        const glowGrad = ctx.createRadialGradient(w * 0.5, h * 0.95, 10, w * 0.5, h * 0.6, w * 0.55);
+        glowGrad.addColorStop(0, 'rgba(255, 120, 30, ' + (0.22 + heatRatio * 0.2) + ')');
+        glowGrad.addColorStop(0.6, 'rgba(78, 52, 46, 0.25)');
+        glowGrad.addColorStop(1, 'rgba(25, 14, 10, 0.95)');
+        ctx.fillStyle = glowGrad;
+        ctx.fillRect(0, 0, w, h);
+
+        // Rotating drum fins in background
+        drumAngle += 0.018;
+        ctx.save();
+        ctx.translate(w * 0.5, h * 0.52);
+        ctx.strokeStyle = 'rgba(255, 171, 64, 0.12)';
+        ctx.lineWidth = 2;
+        for (let i = 0; i < 8; i++) {
+          const a = drumAngle + (i * Math.PI) / 4;
+          ctx.beginPath();
+          ctx.moveTo(Math.cos(a) * 40, Math.sin(a) * 40);
+          ctx.lineTo(Math.cos(a) * (h * 0.45), Math.sin(a) * (h * 0.45));
+          ctx.stroke();
+        }
+        ctx.restore();
+
+        // Update and draw each roasting coffee bean
+        const gravity = 0.14;
+        const floorY = h - 24;
+        const ceilingY = 24;
+        const leftWall = 28;
+        const rightWall = w - 28;
+
+        for (let i = 0; i < beans.length; i++) {
+          const bean = beans[i];
+          bean.vy += gravity;
+          bean.x += bean.vx;
+          bean.y += bean.vy;
+          bean.angle += bean.angularVelocity;
+
+          if (bean.y > floorY) {
+            bean.y = floorY;
+            bean.vy = -(3.2 + ((i + tickCount) % 5) * 0.65);
+            bean.vx += Math.sin(drumAngle + i) * 0.35;
+          } else if (bean.y < ceilingY) {
+            bean.y = ceilingY;
+            bean.vy = Math.abs(bean.vy) * 0.7;
+          }
+
+          if (bean.x < leftWall) {
+            bean.x = leftWall;
+            bean.vx = Math.abs(bean.vx);
+          } else if (bean.x > rightWall) {
+            bean.x = rightWall;
+            bean.vx = -Math.abs(bean.vx);
+          }
+
+          // Clamp horizontal speed
+          if (bean.vx > 3.2) bean.vx = 3.2;
+          if (bean.vx < -3.2) bean.vx = -3.2;
+
+          ctx.save();
+          ctx.translate(bean.x, bean.y);
+          ctx.rotate(bean.angle);
+
+          // Bean body
+          ctx.fillStyle = getBeanColor(currentTemp, bean.shadeOffset);
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bean.radiusX, bean.radiusY, 0, 0, Math.PI * 2);
+          ctx.fill();
+
+          ctx.strokeStyle = 'rgba(30, 15, 8, 0.7)';
+          ctx.lineWidth = 1.2;
+          ctx.stroke();
+
+          // Bean center crack / crease
+          ctx.strokeStyle = 'rgba(28, 14, 7, 0.85)';
+          ctx.lineWidth = 1.5;
+          ctx.beginPath();
+          ctx.moveTo(-bean.radiusX * 0.75, 0);
+          ctx.quadraticCurveTo(0, bean.radiusY * 0.3, bean.radiusX * 0.75, 0);
+          ctx.stroke();
+
+          ctx.restore();
+        }
+      }
+
+      function animateLoop() {
+        if (!isRunning) {
+          rafId = null;
+          return;
+        }
+        drawFrame();
+        rafId = window.requestAnimationFrame(animateLoop);
+      }
+
+      function pauseSimulation() {
+        isRunning = false;
+        if (rafId !== null) {
+          window.cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (tempIntervalId !== null) {
+          window.clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+        roastingWidget.dataset.simState = 'paused';
+      }
+
+      function resumeSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        roastingWidget.dataset.simState = 'running';
+        if (rafId === null) {
+          rafId = window.requestAnimationFrame(animateLoop);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = window.setInterval(updateTemperature, TEMP_INTERVAL_MS);
+        }
+      }
+
+      function isElementInViewport(el) {
+        const rect = el.getBoundingClientRect();
+        const vh = window.innerHeight || document.documentElement.clientHeight;
+        const vw = window.innerWidth || document.documentElement.clientWidth;
+        return rect.bottom > 0 && rect.top < vh && rect.right > 0 && rect.left < vw;
+      }
+
+      // Draw initial static frame before visibility state is determined
+      drawFrame();
+
+      const supportsContentVisibilityAutoState =
+        'oncontentvisibilityautostatechange' in roastingWidget ||
+        'oncontentvisibilityautostatechange' in window ||
+        'ContentVisibilityAutoStateChangeEvent' in window;
+
+      // 1. Primary native rendering state change listener (contentvisibilityautostatechange)
+      if (supportsContentVisibilityAutoState) {
+        roastingWidget.addEventListener('contentvisibilityautostatechange', function (event) {
+          const skipped =
+            typeof event.skipped === 'boolean'
+              ? event.skipped
+              : Boolean(event.detail && event.detail.skipped);
+
+          if (skipped) {
+            isSkippedByContentVisibility = true;
+            pauseSimulation();
+          } else {
+            isSkippedByContentVisibility = false;
+            if (!event.isTrusted || isElementInViewport(roastingWidget)) {
+              resumeSimulation();
+            }
+          }
+        });
+      }
+
+      // 2. Fallback (and viewport boundary observer) using IntersectionObserver for older browsers
+      // or when scrolling outside the visible viewport inside pre-render margins
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          function (entries) {
+            for (let i = 0; i < entries.length; i++) {
+              const entry = entries[i];
+              if (entry.isIntersecting && !isSkippedByContentVisibility) {
+                resumeSimulation();
+              } else {
+                pauseSimulation();
+              }
+            }
+          },
+          { threshold: 0 }
+        );
+        observer.observe(roastingWidget);
+      } else if (!supportsContentVisibilityAutoState) {
+        // Legacy scroll/resize fallback for very old browsers without IntersectionObserver
+        function checkViewportVisibility() {
+          if (isElementInViewport(roastingWidget)) {
+            resumeSimulation();
+          } else {
+            pauseSimulation();
+          }
+        }
+        window.addEventListener('scroll', checkViewportVisibility, { passive: true });
+        window.addEventListener('resize', checkViewportVisibility, { passive: true });
+      }
+
+      // Initialize simulation state based on current viewport position
+      if (isElementInViewport(roastingWidget)) {
+        resumeSimulation();
+      } else {
+        pauseSimulation();
+      }
+    })();
+  </script>
+
 </body>
 
