+  <script>
+    (function () {
+      const roastingWidget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      if (!roastingWidget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let currentTemp = 385.0;
+      let tempDirection = 1;
+
+      const beans = Array.from({ length: 32 }, (_, i) => ({
+        x: 60 + ((i * 19) % (canvas.width - 120)),
+        y: 40 + ((i * 37) % (canvas.height - 80)),
+        vx: (Math.sin(i * 1.7) || 0.5) * 1.8,
+        vy: (Math.cos(i * 2.3) || -0.5) * 1.8,
+        angle: (i * 0.6) % (Math.PI * 2),
+        spin: ((i % 2 === 0 ? 1 : -1) * (0.02 + (i % 5) * 0.008)),
+        rx: 10 + (i % 4),
+        ry: 7 + (i % 3),
+        shade: i % 3
+      }));
+
+      const beanColors = ['#6d4c41', '#4e342e', '#3e2723'];
+
+      function renderFrame() {
+        ctx.fillStyle = '#2b1b17';
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        // Subtle heat glow at bottom of drum
+        const gradient = ctx.createLinearGradient(0, canvas.height - 60, 0, canvas.height);
+        gradient.addColorStop(0, 'rgba(255, 171, 64, 0)');
+        gradient.addColorStop(1, 'rgba(255, 109, 0, 0.25)');
+        ctx.fillStyle = gradient;
+        ctx.fillRect(0, canvas.height - 60, canvas.width, 60);
+
+        for (let i = 0; i < beans.length; i++) {
+          const b = beans[i];
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.spin;
+
+          if (b.x < b.rx + 12 || b.x > canvas.width - b.rx - 12) b.vx *= -1;
+          if (b.y < b.ry + 12 || b.y > canvas.height - b.ry - 12) b.vy *= -1;
+
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.rx, b.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = beanColors[b.shade];
+          ctx.fill();
+          ctx.strokeStyle = '#241410';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          // Coffee bean center crease
+          ctx.beginPath();
+          ctx.moveTo(-b.rx * 0.7, 0);
+          ctx.quadraticCurveTo(0, b.ry * 0.3, b.rx * 0.7, 0);
+          ctx.strokeStyle = '#1b0f0c';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        animationFrameId = requestAnimationFrame(renderFrame);
+      }
+
+      function updateTemperature() {
+        currentTemp += tempDirection * (0.4 + Math.random() * 0.8);
+        if (currentTemp >= 435.0) {
+          currentTemp = 435.0;
+          tempDirection = -1;
+        } else if (currentTemp <= 375.0) {
+          currentTemp = 375.0;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°F`;
+      }
+
+      function startSimulation() {
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(renderFrame);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 1000);
+        }
+      }
+
+      function stopSimulation() {
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Attach listener directly to the element with content-visibility: auto
+      roastingWidget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          stopSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      // Fallback using IntersectionObserver for older browsers lacking content-visibility support
+      const isSupported = 'contentVisibility' in document.documentElement.style;
+
+      if (!isSupported) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(roastingWidget);
+      }
+    })();
+  </script>
+
 </body>
 
