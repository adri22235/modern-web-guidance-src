+  <script>
+    (function () {
+      const anchor = document.getElementById('anchor');
+      const tooltip = document.getElementById('tooltip');
+      const arrow = document.getElementById('tooltip-arrow');
+      if (!anchor || !tooltip) return;
+
+      let openedViaHoverOrFocus = false;
+
+      function syncTooltipOrientation() {
+        if (!tooltip.matches(':popover-open')) return;
+        const anchorRect = anchor.getBoundingClientRect();
+        const tooltipRect = tooltip.getBoundingClientRect();
+
+        let placement = 'top';
+        let arrowDirection = 'down';
+
+        if (tooltipRect.top >= anchorRect.bottom - 2) {
+          placement = 'bottom';
+          arrowDirection = 'up';
+        } else if (tooltipRect.bottom <= anchorRect.top + 2) {
+          placement = 'top';
+          arrowDirection = 'down';
+        } else if (tooltipRect.right <= anchorRect.left + 2) {
+          placement = 'left';
+          arrowDirection = 'right';
+        } else if (tooltipRect.left >= anchorRect.right - 2) {
+          placement = 'right';
+          arrowDirection = 'left';
+        }
+
+        tooltip.dataset.placement = placement;
+        tooltip.dataset.side = placement;
+        tooltip.dataset.orientation = placement;
+        tooltip.dataset.flipped = String(placement !== 'top');
+
+        if (arrow) {
+          arrow.dataset.direction = arrowDirection;
+          arrow.dataset.orientation = arrowDirection;
+        }
+      }
+
+      anchor.addEventListener('mouseenter', () => {
+        if (!tooltip.matches(':popover-open')) {
+          openedViaHoverOrFocus = true;
+          try {
+            tooltip.showPopover();
+          } catch (_) {}
+        }
+        syncTooltipOrientation();
+      });
+
+      anchor.addEventListener('focus', () => {
+        if (!tooltip.matches(':popover-open')) {
+          openedViaHoverOrFocus = true;
+          try {
+            tooltip.showPopover();
+          } catch (_) {}
+        }
+        syncTooltipOrientation();
+      });
+
+      anchor.addEventListener('click', (e) => {
+        if (openedViaHoverOrFocus) {
+          e.preventDefault();
+          openedViaHoverOrFocus = false;
+          if (!tooltip.matches(':popover-open')) {
+            try {
+              tooltip.showPopover();
+            } catch (_) {}
+          }
+        }
+        requestAnimationFrame(syncTooltipOrientation);
+      });
+
+      tooltip.addEventListener('toggle', (e) => {
+        if (e.newState === 'open') {
+          anchor.setAttribute('aria-expanded', 'true');
+          syncTooltipOrientation();
+          requestAnimationFrame(syncTooltipOrientation);
+        } else {
+          anchor.setAttribute('aria-expanded', 'false');
+          openedViaHoverOrFocus = false;
+        }
+      });
+
+      window.addEventListener('scroll', syncTooltipOrientation, { passive: true });
+      window.addEventListener('resize', syncTooltipOrientation, { passive: true });
+    })();
+  </script>
