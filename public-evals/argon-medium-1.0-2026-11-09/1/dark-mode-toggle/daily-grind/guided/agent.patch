+  <script>
+    (() => {
+      const colorSchemeMeta = document.querySelector('meta[name="color-scheme"]');
+      const themeToggle = document.getElementById('theme-toggle');
+      const darkMediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function getStoredScheme() {
+        try {
+          const value = localStorage.getItem('color-scheme');
+          return value === 'light' || value === 'dark' ? value : null;
+        } catch {
+          return null;
+        }
+      }
+
+      function getSystemScheme() {
+        return darkMediaQuery.matches ? 'dark' : 'light';
+      }
+
+      function getRenderedScheme() {
+        const metaContent = colorSchemeMeta.content.trim();
+        if (metaContent === 'light' || metaContent === 'dark') {
+          return metaContent;
+        }
+        return getStoredScheme() ?? getSystemScheme();
+      }
+
+      themeToggle.addEventListener('click', () => {
+        const currentScheme = getRenderedScheme();
+        const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';
+        const systemScheme = getSystemScheme();
+
+        if (targetScheme !== systemScheme) {
+          colorSchemeMeta.content = targetScheme;
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+        } else {
+          colorSchemeMeta.content = 'light dark';
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+        }
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          const stored = event.newValue === 'light' || event.newValue === 'dark' ? event.newValue : null;
+          colorSchemeMeta.content = stored ?? 'light dark';
+        }
+      });
+    })();
+  </script>
+
