+        account: 'access My Account',
+        order: 'start your Order',
+        favorite: `save ${returnFocusEl?.dataset?.itemName || 'this item'}`,
+        signin: 'access your account',
+      };
+      const intentLabel = actionLabels[returnAction] || 'continue';
+      const statusText =
+        message ||
+        `No saved passkey or password was used on this device. Sign in below to ${intentLabel} without leaving this page.`;
+
+      dialogStatusEl.removeAttribute('data-error');
+      dialogStatusEl.textContent = statusText;
+
+      if (!signinDialog.open) {
+        if (typeof signinDialog.showModal === 'function') {
+          signinDialog.showModal();
+        } else {
+          signinDialog.setAttribute('open', '');
+        }
+      }
+
+      emailInput.focus();
+    }
+
+    // Attach click listeners to all quick sign-in triggers (requires transient user activation)
+    const quickSignInTriggers = document.querySelectorAll('[data-quick-signin]');
+
+    quickSignInTriggers.forEach((triggerEl) => {
+      triggerEl.addEventListener('click', async (event) => {
+        event.preventDefault();
+        if (isAuthenticating) return;
+
+        const returnAction = triggerEl.dataset.quickSignin;
+
+        // If already signed in, complete the action in place immediately
+        if (document.body.dataset.signedIn === 'true') {
+          if (returnAction === 'favorite') {
+            const nextPressed = triggerEl.getAttribute('aria-pressed') !== 'true';
+            triggerEl.setAttribute('aria-pressed', String(nextPressed));
+            triggerEl.textContent = nextPressed ? 'Saved' : 'Save';
+            const itemName = triggerEl.dataset.itemName || 'item';
+            authStatusEl.textContent = nextPressed
+              ? `Saved ${itemName} to your favorites.`
+              : `Removed ${itemName} from your favorites.`;
+            return;
+          }
+
+          const message = performIntendedAction({
+            returnAction,
+            returnFocusEl: triggerEl,
+            user: { name: userGreetingEl.textContent.replace(/^Hi,\s*/, '') || 'Member' },
+          });
+          authStatusEl.textContent = message;
+          return;
+        }
+
+        isAuthenticating = true;
+        try {
+          const user = await authenticateWithImmediateUi();
+          completeInPlaceSignIn(user, { returnAction, returnFocusEl: triggerEl });
+        } catch (err) {
+          if (err.name === 'NotAllowedError') {
+            showFallbackSignInUi({ returnAction, returnFocusEl: triggerEl });
+            return;
+          }
+          if (err.code === 'UNKNOWN_CREDENTIAL') {
+            showFallbackSignInUi({
+              returnAction,
+              returnFocusEl: triggerEl,
+              message: 'That passkey is no longer recognized. Please sign in with another method.',
+            });
+            return;
+          }
+          console.error('Authentication error:', err);
+          showFallbackSignInUi({
+            returnAction,
+            returnFocusEl: triggerEl,
+            message: 'Quick sign-in could not be completed. Please sign in below to continue.',
+          });
+        } finally {
+          isAuthenticating = false;
+        }
+      });
+    });
+
+    // Show/hide password toggle inside fallback form
+    togglePasswordBtn.addEventListener('click', () => {
+      const isShowing = togglePasswordBtn.getAttribute('aria-pressed') === 'true';
+      const nextShowing = !isShowing;
+      togglePasswordBtn.setAttribute('aria-pressed', String(nextShowing));
+      togglePasswordBtn.textContent = nextShowing ? 'Hide password' : 'Show password';
+      passwordInput.type = nextShowing ? 'text' : 'password';
+    });
+
+    function validateField(input, errorEl, emptyMessage, invalidMessage) {
+      input.setCustomValidity('');
+      if (input.validity.valueMissing) {
+        input.setCustomValidity(emptyMessage);
+      } else if (!input.validity.valid && invalidMessage) {
+        input.setCustomValidity(invalidMessage);
+      }
+
+      if (!input.validity.valid) {
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = input.validationMessage;
+        errorEl.hidden = false;
+        return false;
+      }
+
+      input.removeAttribute('aria-invalid');
+      errorEl.textContent = '';
+      errorEl.hidden = true;
+      return true;
+    }
+
+    emailInput.addEventListener('blur', () => {
+      if (emailInput.value.length > 0) {
+        validateField(
+          emailInput,
+          emailErrorEl,
+          'Please enter your email address.',
+          'Please enter a valid email address.'
+        );
+      }
+    });
+
+    emailInput.addEventListener('input', () => {
+      emailInput.setCustomValidity('');
+      emailInput.removeAttribute('aria-invalid');
+      emailErrorEl.textContent = '';
+      emailErrorEl.hidden = true;
+    });
+
+    passwordInput.addEventListener('blur', () => {
+      if (passwordInput.value.length > 0) {
+        validateField(passwordInput, passwordErrorEl, 'Please enter your password.');
+      }
+    });
+
+    passwordInput.addEventListener('input', () => {
+      passwordInput.setCustomValidity('');
+      passwordInput.removeAttribute('aria-invalid');
+      passwordErrorEl.textContent = '';
+      passwordErrorEl.hidden = true;
+    });
+
+    fallbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      const emailValid = validateField(
+        emailInput,
+        emailErrorEl,
+        'Please enter your email address.',
+        'Please enter a valid email address.'
+      );
+      const passwordValid = validateField(
+        passwordInput,
+        passwordErrorEl,
+        'Please enter your password.'
+      );
+
+      if (!emailValid) {
+        emailInput.focus();
+        return;
+      }
+      if (!passwordValid) {
+        passwordInput.focus();
+        return;
+      }
+
+      submitBtn.disabled = true;
+      try {
+        const verifyResponse = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: emailInput.value.trim(),
+            password: passwordInput.value,
+          }),
+        });
+
+        if (!verifyResponse.ok) {
+          throw new Error('Invalid email or password.');
+        }
+
+        const user = await verifyResponse.json();
+        fallbackForm.reset();
+        completeInPlaceSignIn(user, pendingAuthContext);
+      } catch (err) {
+        dialogStatusEl.dataset.error = 'true';
+        dialogStatusEl.textContent = err.message || 'Sign-in failed. Please check your credentials and try again.';
+        emailInput.focus();
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+
+    cancelBtn.addEventListener('click', () => {
+      const returnFocusEl = pendingAuthContext?.returnFocusEl;
+      signinDialog.close();
+      restoreFocusAfterSignIn(returnFocusEl);
+      authStatusEl.textContent = 'Sign-in canceled. You can continue browsing The Daily Grind.';
+      pendingAuthContext = null;
+    });
+
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      document.body.dataset.signedIn = 'false';
+      userBadgeItem.hidden = true;
+      userGreetingEl.textContent = '';
+      signinNavItem.hidden = false;
+      memberPanel.hidden = true;
+      document.querySelectorAll('.favorite-btn').forEach((btn) => {
+        btn.setAttribute('aria-pressed', 'false');
+        btn.textContent = 'Save';
+      });
+      signinLink.focus();
+      authStatusEl.textContent = 'You have been signed out.';
+    });
+  </script>
 </body>
 
 </html>
