+}
+
+section.section-featured .teaser-badge,
+section.featured-section .teaser-badge,
+section.featured .teaser-badge,
+.section-featured .teaser-badge,
+.featured-section .teaser-badge,
+section[data-context="featured"] .teaser-badge,
+section[data-section-context="featured"] .teaser-badge,
+section[data-featured="true"] .teaser-badge,
+section.section-featured .promo-badge,
+section.featured-section .promo-badge,
