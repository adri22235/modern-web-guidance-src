+}
+
+/* Parent section semantic context definitions */
+section,
+.section-default,
+.standard-section,
+section[data-context="default"],
+section[data-section-context="default"],
+section[data-featured="false"] {
+  container-name: section;
+  --featured: false;
+  --context: default;
+  --section-context: default;
+  --variant: default;
+}
+
+section.section-featured,
+section.featured-section,
+section.featured,
+.section-featured,
+.featured-section,
+section[data-context="featured"],
+section[data-section-context="featured"],
+section[data-featured="true"] {
+  container-name: section;
+  --featured: true;
+  --context: featured;
+  --section-context: featured;
+  --variant: featured;
+}
+
+/* Default (subtle) presentation for article teaser cards */
+.teaser-card {
+  background-color: #ffffff;
+  border: 1px solid #e5e7eb;
+  border-radius: 0.5rem;
+  box-shadow: none;
+  padding: 1rem;
+  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
+}
+
+/* Promotional badge: hidden by default in standard sections */
+.teaser-badge,
+.promo-badge {
+  display: none;
+  align-items: center;
+  gap: 0.25rem;
+  width: fit-content;
+  padding: 0.125rem 0.625rem;
+  font-size: 0.75rem;
+  font-weight: 700;
+  line-height: 1.25rem;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  border-radius: 9999px;
+  background-color: #f59e0b;
+  color: #111827;
+}
+
+/* Action buttons: subtle outlined styling by default in standard sections */
+.teaser-action-btn,
+.action-button,
+.teaser-card button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.375rem;
+  padding: 0.375rem 0.75rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  line-height: 1.25rem;
+  border-radius: 0.375rem;
+  background-color: transparent;
+  color: #374151;
+  border: 1px solid #9ca3af;
+  cursor: pointer;
+  text-decoration: none;
+  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
+}
+
+.teaser-action-btn:hover,
+.action-button:hover,
+.teaser-card button:hover {
+  background-color: #f3f4f6;
+  border-color: #6b7280;
+  color: #111827;
+}
+
+/* Featured presentation via CSS Container Style Queries */
+@container style(--featured: true) {
+  .teaser-card {
+    background-color: #fffbeb;
+    border: 2px solid #f59e0b;
+    box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.15), 0 4px 6px -4px rgba(0, 0, 0, 0.08);
+  }
+
+  .teaser-badge,
+  .promo-badge {
+    display: inline-flex;
+  }
+
+  .teaser-action-btn,
+  .action-button,
+  .teaser-card button {
+    background-color: #d97706;
+    color: #ffffff;
+    border: 1px solid #d97706;
+  }
+
+  .teaser-action-btn:hover,
+  .action-button:hover,
+  .teaser-card button:hover {
+    background-color: #b45309;
+    border-color: #b45309;
+    color: #ffffff;
+  }
+}
+
+@container style(--context: featured) {
+  .teaser-card {
+    background-color: #fffbeb;
+    border: 2px solid #f59e0b;
+    box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.15), 0 4px 6px -4px rgba(0, 0, 0, 0.08);
