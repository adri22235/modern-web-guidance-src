+    background-color: #d97706;
+    color: #ffffff;
+    border: 1px solid #d97706;
+  }
+
+  .teaser-action-btn:hover,
+  .action-button:hover,
+  .teaser-card button:hover {
+    background-color: #b45309;
+    border-color: #b45309;
+    color: #ffffff;
+  }
+}
+
+/* Semantic parent section context selectors */
+section.section-featured .teaser-card,
+section.featured-section .teaser-card,
+section.featured .teaser-card,
+.section-featured .teaser-card,
+.featured-section .teaser-card,
