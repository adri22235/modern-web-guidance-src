diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..85cbcb0 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -1,7 +1,101 @@
 @import "tailwindcss";
 
+:root {
+  --brand-accent: #d97706;
+  --brand-accent-subtle: #fef3c7;
+  --brand-accent-text: #92400e;
+  --surface-default-bg: #ffffff;
+  --surface-default-border: #e5e7eb;
+  --surface-featured-bg: #fffbeb;
+  --surface-featured-border: #fde68a;
+  --space-2xs: 0.125rem;
+  --space-xs: 0.25rem;
+  --space-sm: 0.5rem;
+  --space-md: 0.75rem;
+  --radius-sm: 0.25rem;
+  --radius-md: 0.375rem;
+  --radius-full: 9999px;
+  --font-size-xs: 0.75rem;
+  --tracking-wide: 0.05em;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/* 1. Set the semantic context on featured layout containers */
+.featured {
+  --surface: featured;
+}
+
+/* 2. Default styles — subtle presentation that works everywhere */
+.teaser-card {
+  background: var(--surface-default-bg);
+  border: 1px solid var(--surface-default-border);
+  border-radius: var(--radius-md);
+}
+
+.button {
+  background: transparent;
+  border: 1px solid currentColor;
+  color: inherit;
+  padding-block: var(--space-xs);
+  padding-inline: var(--space-md);
+  border-radius: var(--radius-sm);
+  font-size: var(--font-size-xs);
+  font-weight: 600;
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-xs);
+  cursor: pointer;
+}
+
+.badge {
+  display: none;
+  background: var(--brand-accent-subtle);
+  color: var(--brand-accent-text);
+  padding-block: var(--space-2xs);
+  padding-inline: var(--space-sm);
+  border-radius: var(--radius-full);
+  font-size: var(--font-size-xs);
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-wide);
+  width: fit-content;
+}
+
+/* Selector-based contextual styles — broad browser support fallback */
+:where(.featured) .teaser-card {
+  background: var(--surface-featured-bg);
+  border-color: var(--surface-featured-border);
+}
+
+:where(.featured) .button {
+  background: var(--brand-accent);
+  color: white;
+  border: none;
+}
+
+:where(.featured) .badge {
+  display: block;
+}
+
+/* Progressive enhancement: style queries override when supported */
+@container style(--surface: featured) {
+  .teaser-card {
+    background: var(--surface-featured-bg);
+    border-color: var(--surface-featured-border);
+  }
+
+  .button {
+    background: var(--brand-accent);
+    color: white;
+    border: none;
+  }
+
+  .badge {
+    display: block;
+  }
 }
