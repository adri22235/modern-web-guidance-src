+    /* Customer Feedback Section */
+    .feedback-section {
+      margin-top: 50px;
+    }
+
+    .feedback-section h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .feedback-log {
+      --scrollbar-thumb: #ffab40;
+      --scrollbar-track: #4e342e;
+
+      max-height: 320px;
+      overflow-y: auto;
+      scrollbar-width: thin;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 20px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+    }
+
+    /* Legacy fallback for WebKit/Blink browsers */
+    @supports not (scrollbar-color: auto) {
+      .feedback-log::-webkit-scrollbar {
+        /* Must define base size in WebKit for custom colors to be visual */
+        width: 8px;
+        height: 8px;
+      }
+
+      .feedback-log::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+      }
+
+      .feedback-log::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
+    .feedback-item {
+      background: var(--light);
+      border-left: 4px solid var(--accent);
+      padding: 15px 18px;
+      border-radius: 4px;
+    }
+
+    .feedback-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 6px;
+      flex-wrap: wrap;
+      gap: 8px;
+    }
+
+    .feedback-author {
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .feedback-meta {
+      font-size: 0.85rem;
+      color: #6d4c41;
+    }
+
+    .feedback-rating {
+      color: var(--accent);
+      letter-spacing: 1px;
+      margin-right: 6px;
+    }
+
+    .feedback-quote {
+      font-style: italic;
+      color: var(--text);
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
