+      opacity: 0;
+
+      /* MANDATORY: transition display and overlay for top-layer elements */
+      transition-property: opacity, transform, margin-bottom, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      /* Separate after transition so a shorthand doesn't reset it or fail in older browsers */
+      transition-behavior: allow-discrete;
+
+      /* Stack offset using sibling-index() so items lower in the stack remain visible */
