+  <script type="module">
+    // MANDATORY: Feature detect 'popover' on HTMLElement.prototype before loading polyfill.
+    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+    }
+
+    const AUTO_DISMISS_MS = 3000;
+    const toastTimers = new WeakMap();
+    const toastContainer = document.querySelector('.toast-container');
+
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    function isToastOpen(toast) {
+      try {
+        return toast.matches(':popover-open') || toast.classList.contains(':popover-open');
+      } catch {
+        return toast.classList.contains(':popover-open');
+      }
+    }
+
+    function syncClosedToastOrder(excludeToast = null) {
+      if (!toastContainer) return;
+      const toasts = Array.from(toastContainer.querySelectorAll('.toast'));
+      for (const toast of toasts) {
+        if (toast !== excludeToast && !isToastOpen(toast)) {
+          toastContainer.appendChild(toast);
+        }
+      }
+    }
+
+    function clearDismissTimer(toast) {
+      const timerId = toastTimers.get(toast);
+      if (timerId) {
+        clearTimeout(timerId);
+        toastTimers.delete(toast);
+      }
+    }
+
+    async function closeTopLayer(element) {
+      clearDismissTimer(element);
+      if (!isToastOpen(element)) return;
+
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+
+      if (typeof element.hidePopover === 'function' && isToastOpen(element)) {
+        element.hidePopover();
+      }
+    }
+
+    function scheduleAutoDismiss(toast) {
+      clearDismissTimer(toast);
+      const timerId = setTimeout(() => {
+        closeTopLayer(toast);
+      }, AUTO_DISMISS_MS);
+      toastTimers.set(toast, timerId);
+    }
+
+    document.querySelectorAll('.toast').forEach((toast) => {
+      toast.addEventListener('toggle', (event) => {
+        if (event.newState === 'open') {
+          toast.removeAttribute('data-closing');
+          syncClosedToastOrder(toast);
+          scheduleAutoDismiss(toast);
+        } else {
+          clearDismissTimer(toast);
+          syncClosedToastOrder();
+        }
+      });
+
+      toast.addEventListener('mouseenter', () => clearDismissTimer(toast));
+      toast.addEventListener('mouseleave', () => {
+        if (isToastOpen(toast)) scheduleAutoDismiss(toast);
+      });
+
+      const closeBtn = toast.querySelector('.toast-close');
+      if (closeBtn) {
+        closeBtn.addEventListener('click', (event) => {
+          if (!supportsTopLayerExit()) {
+            event.preventDefault();
+            closeTopLayer(toast);
+          }
+        });
+      }
+    });
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', () => {
+        const targetId = trigger.getAttribute('popovertarget') || trigger.dataset.toastTarget;
+        const targetToast = targetId ? document.getElementById(targetId) : null;
+        if (!targetToast) return;
+
+        syncClosedToastOrder(targetToast);
+        if (isToastOpen(targetToast)) {
+          scheduleAutoDismiss(targetToast);
+        } else if (typeof targetToast.showPopover === 'function') {
+          try {
+            targetToast.showPopover();
+          } catch {
+            // Native popovertarget click may have already opened it
+          }
+          scheduleAutoDismiss(targetToast);
+        }
+      });
+    });
+  </script>
+
