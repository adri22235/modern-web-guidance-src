+  <script type="module">
+    const supportsDSD = Object.hasOwn(HTMLTemplateElement.prototype, 'shadowRootMode');
+
+    const fallbackTemplate = document.createElement('template');
+    fallbackTemplate.innerHTML = `
+      <style>
+        :host {
+          --_card-bg: var(--card-bg, white);
+          --_card-fg: var(--card-fg, var(--text, #3e2723));
+          --_card-primary: var(--card-primary, var(--primary, #4e342e));
+          --_card-accent: var(--card-accent, var(--accent, #ffab40));
+          display: block;
+          container-type: inline-size;
+        }
+        .card {
+          background: var(--_card-bg);
+          color: var(--_card-fg);
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          border: 2px solid transparent;
+          transition: border-color 0.2s, box-shadow 0.2s;
+        }
+        :host(:state(favorited)) .card,
+        :host([favorited]) .card {
+          border-color: var(--_card-accent);
+        }
+        .card-header {
+          display: flex;
+          align-items: center;
+          justify-content: space-between;
+          gap: 8px;
+          margin-bottom: 10px;
+        }
+        ::slotted([slot="title"]) {
+          margin: 0;
+          color: var(--_card-primary);
+          font-size: 1.17rem;
+          text-align: left;
+        }
+        ::slotted(p) {
+          margin: 0;
+        }
+        button {
+          font: inherit;
+          color: inherit;
+          cursor: pointer;
+        }
+        .favorite-btn {
+          background: transparent;
+          border: 1px solid #d7ccc8;
+          border-radius: 999px;
+          padding: 4px 10px;
+          font-size: 0.85rem;
+          display: inline-flex;
+          align-items: center;
+          gap: 4px;
+          transition: background 0.2s, border-color 0.2s, color 0.2s;
+        }
+        .favorite-btn:hover {
+          border-color: var(--_card-accent);
+        }
+        :host(:state(favorited)) .favorite-btn,
+        :host([favorited]) .favorite-btn {
+          background: var(--_card-accent);
+          border-color: var(--_card-accent);
+          color: #3e2723;
+          font-weight: 600;
+        }
+        .details {
+          margin-top: 12px;
+          padding-top: 12px;
+          border-top: 1px solid #efebe9;
+          font-size: 0.9rem;
+          text-align: left;
+        }
+        .actions {
+          display: flex;
+          flex-wrap: wrap;
+          align-items: center;
+          justify-content: center;
+          gap: 10px;
+          margin-top: 15px;
+        }
+        .btn {
+          display: inline-block;
+          background: var(--_card-primary);
+          color: white;
+          padding: 10px 20px;
+          border: none;
+          border-radius: 5px;
+          transition: background 0.3s;
+        }
+        .btn:hover {
+          background: #3e2723;
+        }
+        ::slotted([slot="actions"]) {
+          color: var(--_card-primary);
+          font-size: 0.9rem;
+          font-weight: 600;
+        }
+      </style>
+      <article class="card" part="card">
+        <div class="card-header">
+          <slot name="title"></slot>
+          <button type="button" id="favorite-toggle" class="favorite-btn" part="favorite-button" aria-pressed="false" aria-label="Favorite drink">
+            <span aria-hidden="true">&#9825;</span>
+            <span class="favorite-label">Favorite</span>
+          </button>
+        </div>
+        <div class="body">
+          <slot></slot>
+        </div>
+        <div id="details-panel" class="details" part="details" hidden>
+          <slot name="details"></slot>
+        </div>
+        <div class="actions">
+          <button type="button" id="details-toggle" class="btn" part="details-toggle" aria-expanded="false" aria-controls="details-panel">
+            View Details
+          </button>
+          <slot name="actions"></slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['open', 'favorited'];
+      #internals;
+
+      constructor() {
+        super();
+        this.#internals = typeof this.attachInternals === 'function' ? this.attachInternals() : null;
+
+        // Reuse the server-rendered Declarative Shadow DOM root if present;
+        // only attach one imperatively if absent (e.g., client-constructed or no DSD parser support).
+        if (!this.shadowRoot) {
+          const declarativeTemplate = !supportsDSD
+            ? this.querySelector('template[shadowrootmode]')
+            : null;
+          this.attachShadow({ mode: 'open' });
+          if (declarativeTemplate) {
+            this.shadowRoot.append(declarativeTemplate.content.cloneNode(true));
+            declarativeTemplate.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: bind listeners once to the existing shadow DOM nodes without re-rendering.
+        this.shadowRoot.getElementById('details-toggle')
+          ?.addEventListener('click', () => {
+            this.open = !this.open;
+            this.dispatchEvent(new CustomEvent('details-toggle', {
+              bubbles: true,
+              composed: true,
+              detail: { open: this.open }
+            }));
+          });
+
+        this.shadowRoot.getElementById('favorite-toggle')
+          ?.addEventListener('click', () => {
+            this.favorited = !this.favorited;
+            this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+          });
+      }
+
+      connectedCallback() {
+        this.#syncOpenState();
+        this.#syncFavoritedState();
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(value) {
+        this.toggleAttribute('open', Boolean(value));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(value) {
+        this.toggleAttribute('favorited', Boolean(value));
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'open') {
+          this.#syncOpenState();
+        } else if (name === 'favorited') {
+          this.#syncFavoritedState();
+        }
+      }
+
+      #syncOpenState() {
+        const isOpen = this.open;
+        this.#internals?.states[isOpen ? 'add' : 'delete']('expanded');
+        const btn = this.shadowRoot?.getElementById('details-toggle');
+        const panel = this.shadowRoot?.getElementById('details-panel');
+        if (btn) {
+          btn.setAttribute('aria-expanded', String(isOpen));
+          btn.textContent = isOpen ? 'Hide Details' : 'View Details';
+        }
+        if (panel) {
+          panel.hidden = !isOpen;
+        }
+      }
+
+      #syncFavoritedState() {
+        const isFavorited = this.favorited;
+        this.#internals?.states[isFavorited ? 'add' : 'delete']('favorited');
+        const btn = this.shadowRoot?.getElementById('favorite-toggle');
+        if (btn) {
+          btn.setAttribute('aria-pressed', String(isFavorited));
+          const icon = btn.querySelector('[aria-hidden="true"]');
+          const label = btn.querySelector('.favorite-label');
+          if (icon) icon.textContent = isFavorited ? '\u2665' : '\u2661';
+          if (label) label.textContent = isFavorited ? 'Favorited' : 'Favorite';
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
