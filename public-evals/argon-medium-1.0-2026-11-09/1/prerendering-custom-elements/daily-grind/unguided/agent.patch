+  <script type="module">
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['expanded', 'favorited'];
+      }
+
+      constructor() {
+        super();
+        this._hydrated = false;
+        this._onDetailsClick = () => this.toggleDetails();
+        this._onFavoriteClick = () => this.toggleFavorite();
+      }
+
+      connectedCallback() {
+        // Hydrate existing Declarative Shadow DOM in place without re-rendering.
+        // Only create a shadow root if this element was constructed dynamically without DSD.
+        if (!this.shadowRoot) {
+          const existingTemplate = document.querySelector('drink-card')?.shadowRoot;
+          const root = this.attachShadow({ mode: 'open' });
+          if (existingTemplate) {
+            root.appendChild(existingTemplate.cloneNode(true));
+          }
+        }
+
+        if (!this._hydrated) {
+          this._detailsBtn = this.shadowRoot.querySelector('[data-action="toggle-details"]');
+          this._favoriteBtn = this.shadowRoot.querySelector('[data-action="toggle-favorite"]');
+          this._detailsPanel = this.shadowRoot.querySelector('.details-panel');
+          this._favIcon = this.shadowRoot.querySelector('.fav-icon');
+          this._favLabel = this.shadowRoot.querySelector('.fav-label');
+
+          this._detailsBtn?.addEventListener('click', this._onDetailsClick);
+          this._favoriteBtn?.addEventListener('click', this._onFavoriteClick);
+          this._hydrated = true;
+          this.setAttribute('data-hydrated', 'true');
+        }
+
+        this._syncState();
+      }
+
+      disconnectedCallback() {
+        this._detailsBtn?.removeEventListener('click', this._onDetailsClick);
+        this._favoriteBtn?.removeEventListener('click', this._onFavoriteClick);
+        this._hydrated = false;
+      }
+
+      attributeChangedCallback() {
+        if (this.shadowRoot) {
+          this._syncState();
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(value) {
+        this.toggleAttribute('expanded', Boolean(value));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(value) {
+        this.toggleAttribute('favorited', Boolean(value));
+      }
+
+      toggleDetails() {
+        this.expanded = !this.expanded;
+        this.dispatchEvent(
+          new CustomEvent('drink-details-toggle', {
+            detail: { name: this.getAttribute('name'), expanded: this.expanded },
+            bubbles: true,
+            composed: true,
+          })
+        );
+      }
+
+      toggleFavorite() {
+        this.favorited = !this.favorited;
+        this.dispatchEvent(
+          new CustomEvent('drink-favorite-toggle', {
+            detail: { name: this.getAttribute('name'), favorited: this.favorited },
+            bubbles: true,
+            composed: true,
+          })
+        );
+      }
+
+      _syncState() {
+        const isExpanded = this.expanded;
+        if (this._detailsPanel && this._detailsPanel.hidden !== !isExpanded) {
+          this._detailsPanel.hidden = !isExpanded;
+        }
+        if (this._detailsBtn) {
+          const expectedExpanded = String(isExpanded);
+          if (this._detailsBtn.getAttribute('aria-expanded') !== expectedExpanded) {
+            this._detailsBtn.setAttribute('aria-expanded', expectedExpanded);
+          }
+          const expectedText = isExpanded ? 'Hide Details' : 'View Details';
+          if (this._detailsBtn.textContent !== expectedText) {
+            this._detailsBtn.textContent = expectedText;
+          }
+        }
+
+        const isFavorited = this.favorited;
+        if (this._favoriteBtn) {
+          const expectedPressed = String(isFavorited);
+          if (this._favoriteBtn.getAttribute('aria-pressed') !== expectedPressed) {
+            this._favoriteBtn.setAttribute('aria-pressed', expectedPressed);
+          }
+        }
+        if (this._favIcon) {
+          const expectedIcon = isFavorited ? '\u2665' : '\u2661';
+          if (this._favIcon.textContent !== expectedIcon) {
+            this._favIcon.textContent = expectedIcon;
+          }
+        }
+        if (this._favLabel) {
+          const expectedLabel = isFavorited ? 'Favorited' : 'Favorite';
+          if (this._favLabel.textContent !== expectedLabel) {
+            this._favLabel.textContent = expectedLabel;
+          }
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
