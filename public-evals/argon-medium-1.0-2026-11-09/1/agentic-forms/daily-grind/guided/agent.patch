+  <script>
+    (() => {
+      const COFFEE_MENU = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          roast: 'medium',
+          temperatures: ['hot', 'iced'],
+          milks: ['oat', 'whole', 'almond', 'soy', 'coconut'],
+          decafAvailable: true,
+          price: '$5.75',
+          notes: 'Creamy barista oat milk with real Vermont maple syrup, toasted pecan, and smooth espresso.',
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          roast: 'dark',
+          temperatures: ['hot', 'iced'],
+          milks: ['none', 'whole', 'oat', 'almond', 'soy'],
+          decafAvailable: true,
+          price: '$3.50',
+          notes: 'Bold, smoky darkchocolate and caramelized sugar notes for a rich morning boost.',
+          url: '/menu/espresso'
+        },
+        {
+          id: '18-hour-cold-brew',
+          name: '18-Hour Steeped Cold Brew',
+          roast: 'medium',
+          temperatures: ['iced'],
+          milks: ['none', 'oat', 'whole', 'almond', 'coconut', 'soy'],
+          decafAvailable: false,
+          price: '$4.75',
+          notes: 'Slow-steeped for 18 hours for velvety smoothness with cocoa and sweet molasses notes.',
+          url: '/menu/cold-brew'
+        },
+        {
+          id: 'ethiopian-yirgacheffe-pour-over',
+          name: 'Ethiopian Yirgacheffe Pour-Over',
+          roast: 'light',
+          temperatures: ['hot'],
+          milks: ['none'],
+          decafAvailable: false,
+          price: '$4.95',
+          notes: 'Bright single-origin floral jasmine, bergamot citrus, and honeyed stone fruit finish.',
+          url: '/menu/pour-over'
+        },
+        {
+          id: 'honey-almond-cortado',
+          name: 'Honey Almond Cortado',
+          roast: 'medium',
+          temperatures: ['hot'],
+          milks: ['almond', 'oat', 'whole'],
+          decafAvailable: true,
+          price: '$4.85',
+          notes: 'Equal parts rich espresso and steamed roasted almond milk kissed with wildflower honey and vanilla.',
+          url: '/menu/espresso'
+        },
+        {
+          id: 'toasted-coconut-mocha',
+          name: 'Toasted Coconut Mocha',
+          roast: 'dark',
+          temperatures: ['hot', 'iced'],
+          milks: ['coconut', 'oat', 'whole', 'soy', 'almond'],
+          decafAvailable: true,
+          price: '$5.95',
+          notes: 'Bittersweet dark cocoa blended with toasted coconut milk and bold espresso.',
+          url: '/menu/seasonal'
+        }
+      ];
+
+      const VALID_ROASTS = new Set(['any', 'light', 'medium', 'dark']);
+      const VALID_TEMPS = new Set(['either', 'hot', 'iced']);
+      const VALID_MILKS = new Set(['any', 'none', 'oat', 'whole', 'almond', 'soy', 'coconut']);
+      const FLAVOR_PATTERN = /^[\p{L}\p{N}\s,\-']*$/u;
+
+      const form = document.getElementById('coffee-finder-form');
+      const flavorInput = document.getElementById('flavor-query');
+      const flavorError = document.getElementById('flavor-error');
+      const resetButton = document.getElementById('find-coffee-reset');
+      const resultsGrid = document.getElementById('finder-results-grid');
+      const resultsSummary = document.getElementById('finder-results-summary');
+      const agentStatus = document.getElementById('agent-tool-status');
+
+      function setFlavorFieldError(message) {
+        if (message) {
+          flavorInput.setCustomValidity(message);
+          flavorInput.setAttribute('aria-invalid', 'true');
+          flavorError.textContent = message;
+          flavorError.hidden = false;
+        } else {
+          flavorInput.setCustomValidity('');
+          flavorInput.removeAttribute('aria-invalid');
+          flavorError.textContent = '';
+          flavorError.hidden = true;
+        }
+      }
+
+      function validateForm(formData) {
+        const errors = [];
+        const rawQuery = (formData.get('flavorQuery') || '').toString().trim();
+        const roast = (formData.get('roast') || 'any').toString();
+        const temperature = (formData.get('temperature') || 'either').toString();
+        const milk = (formData.get('milk') || 'any').toString();
+
+        if (rawQuery.length > 60) {
+          const msg = 'Please keep flavor keywords under 60 characters.';
+          setFlavorFieldError(msg);
+          errors.push({ field: 'flavorQuery', message: msg, control: flavorInput });
+        } else if (!FLAVOR_PATTERN.test(rawQuery)) {
+          const msg = 'Use only letters, numbers, spaces, commas, or hyphens in flavor keywords.';
+          setFlavorFieldError(msg);
+          errors.push({ field: 'flavorQuery', message: msg, control: flavorInput });
+        } else {
+          setFlavorFieldError('');
+        }
+
+        if (!VALID_ROASTS.has(roast)) {
+          errors.push({ field: 'roast', message: 'Invalid roast selection.' });
+        }
+        if (!VALID_TEMPS.has(temperature)) {
+          errors.push({ field: 'temperature', message: 'Invalid serving temperature selection.' });
+        }
+        if (!VALID_MILKS.has(milk)) {
+          errors.push({ field: 'milk', message: 'Invalid milk preference selection.' });
+        }
+
+        return errors;
+      }
+
+      flavorInput.addEventListener('input', () => {
+        if (flavorInput.getAttribute('aria-invalid') === 'true' || flavorInput.validity.customError) {
+          setFlavorFieldError('');
+        }
+      });
+
+      flavorInput.addEventListener('blur', () => {
+        const value = flavorInput.value.trim();
+        if (!value) {
+          setFlavorFieldError('');
+          return;
+        }
+        if (value.length > 60) {
+          setFlavorFieldError('Please keep flavor keywords under 60 characters.');
+        } else if (!FLAVOR_PATTERN.test(value)) {
+          setFlavorFieldError('Use only letters, numbers, spaces, commas, or hyphens in flavor keywords.');
+        } else {
+          setFlavorFieldError('');
+        }
+      });
+
+      function renderMatches(items, criteriaSummary) {
+        resultsGrid.replaceChildren();
+        resultsSummary.textContent = criteriaSummary;
+
+        for (const item of items) {
+          const card = document.createElement('div');
+          card.className = 'card';
+
+          const title = document.createElement('h3');
+          title.textContent = `${item.name} (${item.price})`;
+
+          const desc = document.createElement('p');
+          desc.textContent = item.notes;
+
+          const meta = document.createElement('div');
+          const roastBadge = document.createElement('span');
+          roastBadge.className = 'badge';
+          roastBadge.textContent = `${item.roast.charAt(0).toUpperCase() + item.roast.slice(1)} roast`;
+          meta.appendChild(roastBadge);
+
+          const tempBadge = document.createElement('span');
+          tempBadge.className = 'badge';
+          tempBadge.textContent = item.temperatures.join(' / ');
+          meta.appendChild(tempBadge);
+
+          if (item.decafAvailable) {
+            const decafBadge = document.createElement('span');
+            decafBadge.className = 'badge';
+            decafBadge.textContent = 'Decaf option';
+            meta.appendChild(decafBadge);
+          }
+
+          const link = document.createElement('a');
+          link.href = item.url;
+          link.className = 'btn';
+          link.textContent = 'View Details';
+
+          card.append(title, desc, meta, link);
+          resultsGrid.appendChild(card);
+        }
+      }
+
+      function performCoffeeSearch(formData) {
+        const rawQuery = (formData.get('flavorQuery') || '').toString().trim().toLowerCase();
+        const keywords = rawQuery
+          ? rawQuery.split(/[\s,]+/).filter(Boolean)
+          : [];
+        const roast = (formData.get('roast') || 'any').toString();
+        const temperature = (formData.get('temperature') || 'either').toString();
+        const milk = (formData.get('milk') || 'any').toString();
+        const decafOnly = formData.get('decafOnly') === 'true';
+
+        const matches = COFFEE_MENU.filter((coffee) => {
+          if (roast !== 'any' && coffee.roast !== roast) return false;
+          if (temperature !== 'either' && !coffee.temperatures.includes(temperature)) return false;
+          if (milk !== 'any' && !coffee.milks.includes(milk)) return false;
+          if (decafOnly && !coffee.decafAvailable) return false;
+          if (keywords.length > 0) {
+            const searchable = `${coffee.name} ${coffee.notes} ${coffee.roast}`.toLowerCase();
+            return keywords.every((kw) => searchable.includes(kw));
+          }
+          return true;
+        });
+
+        const summaryText = matches.length > 0
+          ? `Found ${matches.length} matching coffee${matches.length === 1 ? '' : 's'}: ${matches.map((m) => `${m.name} (${m.price})`).join(', ')}.`
+          : 'No exact coffee matches found for those filters. Try broadening your roast, milk, or flavor criteria.';
+
+        renderMatches(matches, summaryText);
+        return Promise.resolve(summaryText);
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const formData = new FormData(form);
+        const formValidationErrors = validateForm(formData);
+
+        if (formValidationErrors.length > 0) {
+          const firstWithControl = formValidationErrors.find((err) => err.control);
+          if (firstWithControl && !event.agentInvoked) {
+            firstWithControl.control.focus();
+          }
+
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            const errorString =
+              'Validation failed: ' +
+              formValidationErrors
+                .map((err) => `${err.field} (${err.message})`)
+                .join(', ');
+            event.respondWith(Promise.resolve(errorString));
+          }
+          return;
+        }
+
+        const resultPromise = performCoffeeSearch(formData);
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(resultPromise);
+        }
+      });
+
+      resetButton.addEventListener('click', () => {
+        form.reset();
+        setFlavorFieldError('');
+        renderMatches(COFFEE_MENU, `Showing all ${COFFEE_MENU.length} artisanal coffees available today.`);
+      });
+
+      // WebMCP lifecycle event listeners with backward-compatible target detection
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor('toolactivated', ({ toolName }) => {
+        if (toolName === 'find-coffee') {
+          agentStatus.textContent = 'AI assistant is searching the coffee menu for you...';
+        }
+      });
+
+      targetFor('toolcancel', ({ toolName }) => {
+        if (toolName === 'find-coffee') {
+          agentStatus.textContent = 'AI assistant cancelled the coffee search.';
+        }
+      });
+
+      // Render initial catalog
+      renderMatches(COFFEE_MENU, `Showing all ${COFFEE_MENU.length} artisanal coffees available today.`);
+    })();
+  </script>
