+  <script>
+    (function () {
+      const BASE_PRICES = {
+        'Maple Oat Latte': 5.5,
+        'Dark Roast Espresso': 3.75,
+        'Cold Brew': 4.75,
+        'Caramel Macchiato': 5.25,
+        'Vanilla Cortado': 4.5,
+        'Single-Origin Pour Over': 5.0
+      };
+
+      const SIZE_UPCHARGE = {
+        'Small': -0.5,
+        'Medium': 0,
+        'Large': 0.75
+      };
+
+      const PROFILE_RECOMMENDATIONS = {
+        'Balanced & Smooth': { drink: 'Cold Brew', temperature: 'Iced', milk: 'Oat Milk' },
+        'Bold & Smokey': { drink: 'Dark Roast Espresso', temperature: 'Hot', milk: 'None' },
+        'Sweet & Creamy': { drink: 'Maple Oat Latte', temperature: 'Hot', milk: 'Oat Milk' },
+        'Bright & Fruity': { drink: 'Single-Origin Pour Over', temperature: 'Hot', milk: 'None' }
+      };
+
+      const form = document.getElementById('quick-order-form');
+      const drinkSelect = document.getElementById('drink');
+      const sizeSelect = document.getElementById('size');
+      const tempSelect = document.getElementById('temperature');
+      const milkSelect = document.getElementById('milk');
+      const profileSelect = document.getElementById('roastProfile');
+      const quantityInput = document.getElementById('quantity');
+      const pricePreview = document.getElementById('price-preview');
+      const recommendBtn = document.getElementById('recommend-btn');
+      const resultBox = document.getElementById('order-result');
+
+      function calculateTotal(drink, size, quantity) {
+        const base = BASE_PRICES[drink] ?? 5.0;
+        const sizeDelta = SIZE_UPCHARGE[size] ?? 0;
+        const qty = Math.max(1, parseInt(quantity, 10) || 1);
+        return ((base + sizeDelta) * qty).toFixed(2);
+      }
+
+      function updatePricePreview() {
+        const total = calculateTotal(drinkSelect.value, sizeSelect.value, quantityInput.value);
+        pricePreview.textContent = `Estimated Total: $${total}`;
+      }
+
+      [drinkSelect, sizeSelect, quantityInput].forEach((el) => {
+        el.addEventListener('change', updatePricePreview);
+        el.addEventListener('input', updatePricePreview);
+      });
+
+      recommendBtn.addEventListener('click', () => {
+        const rec = PROFILE_RECOMMENDATIONS[profileSelect.value];
+        if (rec) {
+          drinkSelect.value = rec.drink;
+          tempSelect.value = rec.temperature;
+          milkSelect.value = rec.milk;
+          updatePricePreview();
+          resultBox.classList.add('visible');
+          resultBox.innerHTML = `
+            <h3>Barista Match: ${rec.drink}</h3>
+            <p>Based on your <strong>${profileSelect.value}</strong> preference, we matched you with a ${rec.temperature.toLowerCase()} <strong>${rec.drink}</strong> (${rec.milk === 'None' ? 'black' : 'with ' + rec.milk}). Add your pickup name and click <em>Place Quick Order</em>!</p>
+          `;
+        }
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const formData = new FormData(form);
+        const orderData = {
+          orderId: 'DG-' + Math.floor(100000 + Math.random() * 900000),
+          drink: formData.get('drink') || 'Maple Oat Latte',
+          size: formData.get('size') || 'Medium',
+          temperature: formData.get('temperature') || 'Hot',
+          milk: formData.get('milk') || 'Oat Milk',
+          roastProfile: formData.get('roastProfile') || 'Balanced & Smooth',
+          quantity: Math.max(1, parseInt(formData.get('quantity'), 10) || 1),
+          customerName: (formData.get('customerName') || 'Guest').toString().trim() || 'Guest',
+          notes: (formData.get('notes') || '').toString().trim()
+        };
+
+        const totalPrice = calculateTotal(orderData.drink, orderData.size, orderData.quantity);
+        const confirmation = {
+          status: 'confirmed',
+          orderId: orderData.orderId,
+          summary: `${orderData.quantity}x ${orderData.size} ${orderData.temperature} ${orderData.drink} (${orderData.milk === 'None' ? 'Black' : orderData.milk})`,
+          roastProfile: orderData.roastProfile,
+          customerName: orderData.customerName,
+          notes: orderData.notes || 'None',
+          totalPrice: `$${totalPrice}`,
+          estimatedPickupMinutes: 5,
+          agentInvoked: Boolean(event.agentInvoked)
+        };
+
+        resultBox.classList.add('visible');
+        resultBox.innerHTML = `
+          <h3>Order Confirmed (${confirmation.orderId})</h3>
+          <p><strong>Pickup For:</strong> ${confirmation.customerName}</p>
+          <p><strong>Order:</strong> ${confirmation.summary} &mdash; <em>${confirmation.roastProfile}</em></p>
+          ${orderData.notes ? `<p><strong>Notes:</strong> ${confirmation.notes}</p>` : ''}
+          <p><strong>Total:</strong> ${confirmation.totalPrice} &bull; Ready for pickup in ~${confirmation.estimatedPickupMinutes} mins.</p>
+        `;
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(confirmation));
+        }
+      });
+
+      updatePricePreview();
+    })();
+  </script>
 </body>
 
 </html>
