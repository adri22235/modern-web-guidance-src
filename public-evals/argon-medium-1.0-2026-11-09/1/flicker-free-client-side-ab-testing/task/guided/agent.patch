diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,501 @@
+<!DOCTYPE html>
+<html lang="en" data-variant="control">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>PulseFlow | Workflow Automation for Modern Engineering Teams</title>
+
+  <!-- Preconnect to the third-party experiment CDN for early DNS/TLS handshake -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+
+  <!--
+    Load the A/B testing SDK in <head> with both `async` and `blocking="render"`:
+    - `async`: Prevents blocking the HTML parser so the DOM builds in parallel.
+    - `blocking="render"`: Holds first paint until the experiment script fetches
+      and executes, preventing the original content from flashing before the
+      active variant is applied.
+  -->
+  <script
+    id="experiment-sdk"
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // Feature-detect native support for `blocking="render"` and apply a lightweight
+    // anti-flicker fallback only in browsers where `HTMLScriptElement.prototype.blocking`
+    // is unsupported (e.g., Firefox).
+    function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    }
+
+    window.onExperimentReady = onExperimentReady;
+
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+
+      const fallbackTimer = setTimeout(onExperimentReady, 4000);
+      const sdkScript = document.getElementById('experiment-sdk');
+
+      if (sdkScript) {
+        const settle = () => {
+          clearTimeout(fallbackTimer);
+          onExperimentReady();
+        };
+        sdkScript.addEventListener('load', settle, { once: true });
+        sdkScript.addEventListener('error', settle, { once: true });
+      }
+    }
+  </script>
+
+  <style>
+    @layer reset, base, theme, components, utilities;
+
+    /* Anti-flicker fallback rule used only when blocking="render" is unsupported */
+    .ab-loading {
+      opacity: 0 !important;
+    }
+
+    @layer reset {
+      html, body, header, nav, main, section, article, aside, footer,
+      div, h1, h2, h3, p, ul, li, figure, figcaption, dialog, form, button {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      ul {
+        list-style: none;
+      }
+
+      img {
+        display: block;
+        max-inline-size: 100%;
+        block-size: auto;
+      }
+
+      button {
+        font: inherit;
+        color: inherit;
+      }
+    }
+
+    @layer theme {
+      :root {
+        color-scheme: light dark;
+
+        /* Design tokens */
+        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+        --color-bg: #0b0f19;
+        --color-surface: #131b2e;
+        --color-surface-elevated: #1c2742;
+        --color-text: #f8fafc;
+        --color-text-muted: #94a3b8;
+        --color-border: #26334d;
+
+        /* Variant-customizable accent tokens (Default / Control Variant A) */
+        --color-accent: #4f46e5;
+        --color-accent-hover: #4338ca;
+        --color-accent-contrast: #ffffff;
+        --color-badge-bg: rgba(79, 70, 229, 0.16);
+        --color-badge-text: #a5b4fc;
+
+        --radius-md: 0.625rem;
+        --radius-lg: 1rem;
+        --radius-pill: 9999px;
+        --container-max: 74rem;
+      }
+
+      /* Variant B overrides keyed to the root data-variant attribute */
+      :root[data-variant="b"] {
+        --color-accent: #059669;
+        --color-accent-hover: #047857;
+        --color-badge-bg: rgba(16, 185, 129, 0.16);
+        --color-badge-text: #6ee7b7;
+      }
+    }
+
+    @layer base {
+      body {
+        font-family: var(--font-sans);
+        background-color: var(--color-bg);
+        color: var(--color-text);
+        line-height: 1.6;
+        min-block-size: 100dvh;
+        display: flex;
+        flex-direction: column;
+      }
+
+      a {
+        color: inherit;
+        text-decoration: none;
+      }
+
+      a:focus-visible,
+      button:focus-visible {
+        outline: 2px solid var(--color-badge-text);
+        outline-offset: 3px;
+      }
+    }
+
+    @layer components {
+      .container {
+        inline-size: min(100% - 2.5rem, var(--container-max));
+        margin-inline: auto;
+      }
+
+      .site-header {
+        border-block-end: 1px solid var(--color-border);
+        padding-block: 1rem;
+      }
+
+      .header-inner {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 1.5rem;
+        flex-wrap: wrap;
+      }
+
+      .brand {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.625rem;
+        font-weight: 700;
+        font-size: 1.125rem;
+        letter-spacing: -0.02em;
+      }
+
+      .brand-mark {
+        inline-size: 2rem;
+        block-size: 2rem;
+        border-radius: var(--radius-md);
+        background: var(--color-accent);
+        display: grid;
+        place-items: center;
+      }
+
+      .nav-list {
+        display: flex;
+        align-items: center;
+        gap: 1.75rem;
+        color: var(--color-text-muted);
+        font-size: 0.9375rem;
+      }
+
+      .nav-list a:hover {
+        color: var(--color-text);
+      }
+
+      .hero {
+        padding-block: clamp(3.5rem, 8vw, 6.5rem);
+      }
+
+      .hero-grid {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
+        align-items: center;
+        gap: clamp(2rem, 5vw, 4rem);
+      }
+
+      .hero-badge {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding-block: 0.35rem;
+        padding-inline: 0.85rem;
+        border-radius: var(--radius-pill);
+        background-color: var(--color-badge-bg);
+        color: var(--color-badge-text);
+        font-size: 0.875rem;
+        font-weight: 600;
+        margin-block-end: 1.25rem;
+      }
+
+      .hero-title {
+        font-size: clamp(2.25rem, 4.5vw, 3.75rem);
+        line-height: 1.1;
+        letter-spacing: -0.03em;
+        font-weight: 800;
+        margin-block-end: 1.25rem;
+      }
+
+      .hero-subtitle {
+        font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
+        color: var(--color-text-muted);
+        max-inline-size: 56ch;
+        margin-block-end: 2rem;
+      }
+
+      .hero-actions {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: 1rem;
+      }
+
+      .cta-button {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        gap: 0.625rem;
+        padding-block: 0.875rem;
+        padding-inline: 1.625rem;
+        border-radius: var(--radius-md);
+        border: 1px solid transparent;
+        background-color: var(--color-accent);
+        color: var(--color-accent-contrast);
+        font-weight: 600;
+        font-size: 1rem;
+        cursor: pointer;
+        transition: background-color 0.2s ease, transform 0.15s ease;
+      }
+
+      .cta-button:hover:not(:disabled) {
+        background-color: var(--color-accent-hover);
+        transform: translateY(-1px);
+      }
+
+      .cta-button:disabled {
+        opacity: 0.6;
+        cursor: not-allowed;
+      }
+
+      .secondary-link {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding-block: 0.875rem;
+        padding-inline: 1.25rem;
+        border-radius: var(--radius-md);
+        border: 1px solid var(--color-border);
+        background-color: var(--color-surface);
+        color: var(--color-text);
+        font-weight: 500;
+      }
+
+      .secondary-link:hover {
+        background-color: var(--color-surface-elevated);
+      }
+
+      /* Variant-specific copy visibility controlled via CSS to minimize DOM churn */
+      .variant-b-only {
+        display: none;
+      }
+
+      :root[data-variant="b"] .variant-control-only {
+        display: none;
+      }
+
+      :root[data-variant="b"] .variant-b-only {
+        display: inline;
+      }
+
+      .hero-media {
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-border);
+        border-radius: var(--radius-lg);
+        padding: 0.75rem;
+        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
+      }
+
+      .hero-image {
+        border-radius: calc(var(--radius-lg) - 0.25rem);
+        inline-size: 100%;
+        aspect-ratio: 4 / 3;
+        object-fit: cover;
+      }
+
+      .features {
+        padding-block: 3.5rem;
+        border-block-start: 1px solid var(--color-border);
+      }
+
+      .section-heading {
+        font-size: 1.5rem;
+        margin-block-end: 1.75rem;
+      }
+
+      .feature-grid {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
+        gap: 1.5rem;
+      }
+
+      .feature-card {
+        background-color: var(--color-surface);
+        border: 1px solid var(--color-border);
+        border-radius: var(--radius-md);
+        padding: 1.5rem;
+      }
+
+      .feature-card h3 {
+        font-size: 1.125rem;
+        margin-block-end: 0.5rem;
+      }
+
+      .feature-card p {
+        color: var(--color-text-muted);
+        font-size: 0.9375rem;
+      }
+
+      .cta-dialog {
+        margin: auto;
+        max-inline-size: 28rem;
+        inline-size: calc(100% - 2rem);
+        background-color: var(--color-surface);
+        color: var(--color-text);
+        border: 1px solid var(--color-border);
+        border-radius: var(--radius-lg);
+        padding: 1.75rem;
+      }
+
+      .cta-dialog::backdrop {
+        background: rgba(5, 8, 17, 0.75);
+      }
+
+      .cta-dialog h2 {
+        font-size: 1.35rem;
+        margin-block-end: 0.5rem;
+      }
+
+      .cta-dialog p {
+        color: var(--color-text-muted);
+        margin-block-end: 1.25rem;
+      }
+
+      .dialog-actions {
+        display: flex;
+        justify-content: flex-end;
+        gap: 0.75rem;
+      }
+
+      .site-footer {
+        margin-block-start: auto;
+        border-block-start: 1px solid var(--color-border);
+        padding-block: 1.5rem;
+        color: var(--color-text-muted);
+        font-size: 0.875rem;
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <div class="container header-inner">
+      <a href="#top" class="brand">
+        <span class="brand-mark" aria-hidden="true">
+          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
+            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round"></path>
+          </svg>
+        </span>
+        <span>PulseFlow</span>
+      </a>
+      <nav aria-label="Primary navigation">
+        <ul class="nav-list">
+          <li><a href="#features">Features</a></li>
+          <li><a href="#metrics">Benchmarks</a></li>
+          <li><a href="#security">Security</a></li>
+        </ul>
+      </nav>
+    </div>
+  </header>
+
+  <main id="top">
+    <section class="hero" aria-labelledby="hero-heading">
+      <div class="container hero-grid">
+        <div class="hero-content" data-experiment-target="hero">
+          <p class="hero-badge" id="experiment-badge">
+            <span class="variant-control-only">Release 4.2 · Zero-Config CI/CD Pipelines</span>
+            <span class="variant-b-only">New · Cut Build Times by 68% Instantly</span>
+          </p>
+          <h1 class="hero-title" id="hero-heading">
+            <span class="variant-control-only">Ship production code faster with automated release pipelines.</span>
+            <span class="variant-b-only">Deploy every commit in seconds without waiting on slow builds.</span>
+          </h1>
+          <p class="hero-subtitle" id="hero-description">
+            <span class="variant-control-only">Connect your repository, parallelize test suites automatically, and preview every pull request in an isolated cloud environment.</span>
+            <span class="variant-b-only">Eliminate CI bottlenecks with distributed caching and instant ephemeral preview environments built for high-velocity teams.</span>
+          </p>
+          <div class="hero-actions">
+            <button type="button" class="cta-button" id="hero-cta-button" data-experiment-id="hero-cta">
+              <span class="variant-control-only">Start Free Trial</span>
+              <span class="variant-b-only">Launch Instant Workspace</span>
+              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
+                <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
+              </svg>
+            </button>
+            <a href="#features" class="secondary-link">Explore Architecture</a>
+          </div>
+        </div>
+
+        <figure class="hero-media">
+          <img
+            class="hero-image"
+            src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+            srcset="
+              https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&q=80 600w,
+              https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80 1200w
+            "
+            sizes="(max-width: 768px) 100vw, 50vw"
+            alt="Real-time deployment telemetry and pipeline latency dashboard"
+            width="1200"
+            height="900"
+            fetchpriority="high"
+            loading="eager"
+          >
+        </figure>
+      </div>
+    </section>
+
+    <section class="features" id="features" aria-labelledby="features-heading">
+      <div class="container">
+        <h2 class="section-heading" id="features-heading">Built for predictable delivery</h2>
+        <ul class="feature-grid">
