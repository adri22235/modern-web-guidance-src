+  <!-- Preconnect to the experiment CDN to minimize DNS, TCP, and TLS latency -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="dns-prefetch" href="https://cdn.example.com">
+
+  <!-- Scoped Anti-Flicker CSS: hides experiment-targeted hero content while preserving layout geometry (0 CLS) -->
+  <style id="anti-flicker-style">
+    html.anti-flicker .hero,
+    html.async-hide .hero,
+    html.anti-flicker [data-experiment],
+    html.async-hide [data-experiment],
+    html.anti-flicker #hero-title,
+    html.anti-flicker #hero-subtitle,
+    html.anti-flicker #cta-button {
+      opacity: 0 !important;
+      visibility: hidden !important;
+      pointer-events: none !important;
+    }
+  </style>
+
+  <!-- Anti-Flicker Controller & Resilient Fallback -->
+  <script>
+    (function () {
+      var docEl = document.documentElement;
+      docEl.classList.add('anti-flicker', 'async-hide');
+
+      var revealed = false;
+      var fallbackTimer = null;
+
+      function revealExperimentContent() {
+        if (revealed) return;
+        revealed = true;
+        if (fallbackTimer) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        docEl.classList.remove('anti-flicker', 'async-hide');
+        docEl.setAttribute('data-experiment-ready', 'true');
+      }
+
+      // If the async A/B script loads after DOMContentLoaded and registers a DOMContentLoaded
+      // listener to mutate the DOM, execute that listener immediately before revealing content.
+      var origDocAddEventListener = document.addEventListener.bind(document);
+      document.addEventListener = function (type, listener, options) {
+        if (
+          type === 'DOMContentLoaded' &&
+          document.readyState !== 'loading' &&
+          typeof listener === 'function'
+        ) {
+          try {
+            listener.call(document, new Event('DOMContentLoaded'));
+          } catch (err) {
+            setTimeout(function () { throw err; }, 0);
+          }
+          return;
+        }
+        return origDocAddEventListener(type, listener, options);
+      };
+
+      // Bounded timeout ensures the hero content never stays permanently blank if the CDN stalls
+      fallbackTimer = setTimeout(revealExperimentContent, 800);
+
+      // Expose reveal hooks for the <script> lifecycle events and standard experiment SDK conventions
+      window.__revealExperiment = revealExperimentContent;
+      window.onExperimentReady = revealExperimentContent;
+      window.dataLayer = window.dataLayer || [];
+      window.dataLayer.hide = { end: revealExperimentContent };
+    })();
+  </script>
+
+  <!-- Load A/B testing SDK asynchronously and reveal content immediately upon execution or error -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    onload="window.__revealExperiment()"
+    onerror="window.__revealExperiment()"
+  ></script>
