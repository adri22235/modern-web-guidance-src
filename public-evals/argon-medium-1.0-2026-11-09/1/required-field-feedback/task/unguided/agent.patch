+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-list-email');
+      const errorMessage = document.getElementById('mailing-list-error');
+      const successMessage = document.getElementById('mailing-list-success');
+
+      let interacted = false;
+      let hadValue = false;
+
+      function isValidEmail(value) {
+        const trimmed = value.trim();
+        if (!trimmed) return false;
+        return emailInput.validity.valid && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed);
+      }
+
+      function showError(message) {
+        emailInput.classList.add('error', 'is-invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMessage.textContent = message;
+        errorMessage.hidden = false;
+        errorMessage.classList.add('visible');
+        successMessage.hidden = true;
+        successMessage.classList.remove('visible');
+      }
+
+      function clearError() {
+        emailInput.classList.remove('error', 'is-invalid');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorMessage.textContent = '';
+        errorMessage.hidden = true;
+        errorMessage.classList.remove('visible');
+      }
+
+      function validateField() {
+        const value = emailInput.value.trim();
+        if (!value) {
+          showError('Email address is required. Please enter your email.');
+          return false;
+        }
+        if (!isValidEmail(value)) {
+          showError('Please enter a valid email address.');
+          return false;
+        }
+        clearError();
+        return true;
+      }
+
+      emailInput.addEventListener('blur', function () {
+        interacted = true;
+        validateField();
+      });
+
+      emailInput.addEventListener('input', function () {
+        successMessage.hidden = true;
+        successMessage.classList.remove('visible');
+
+        if (emailInput.value.length > 0) {
+          hadValue = true;
+        } else if (hadValue) {
+          interacted = true;
+        }
+
+        if (interacted) {
+          validateField();
+        }
+      });
+
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        interacted = true;
+        validateField();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        interacted = true;
+
+        if (!validateField()) {
+          emailInput.focus();
+          return;
+        }
+
+        clearError();
+        interacted = false;
+        hadValue = false;
+        emailInput.value = '';
+        successMessage.textContent = 'Thank you for subscribing to our mailing list!';
+        successMessage.hidden = false;
+        successMessage.classList.add('visible');
+      });
+    })();
+  </script>
+
 </body>
 
