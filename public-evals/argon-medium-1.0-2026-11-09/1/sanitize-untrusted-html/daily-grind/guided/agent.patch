+  <script type="module">
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('dompurify').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    export async function safeSetHTML(el, html) {
+      const elements = [
+        'p', 'b', 'i', 'strong', 'em', 'u', 'ul', 'ol', 'li', 'blockquote', 'code', 'br', 'span'
+      ];
+      const attributes = ['class'];
+
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: { elements, attributes } });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...elements, '#text'],
+          ALLOWED_ATTR: attributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    window.safeSetHTML = safeSetHTML;
+
+    const initialReviews = [
+      {
+        author: 'Maya Lin',
+        drink: 'Maple Oat Latte',
+        html: '<p>The <strong>Maple Oat Latte</strong> has the perfect balance of <em>real Vermont maple</em> and velvety steamed oat milk!</p>'
+      },
+      {
+        author: 'Carlos Rivera',
+        drink: 'Dark Roast Espresso',
+        html: '<p>Rich crema and <b>bold smokey notes</b>:</p><ul><li>Zero bitterness</li><li>Great morning kick</li></ul>'
+      },
+      {
+        author: 'Hannah Abbott',
+        drink: 'Cold Brew',
+        html: '<blockquote>Silkiest cold brew in town!</blockquote><p>You can really taste the <i>18-hour steep</i>.</p>'
+      }
+    ];
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const reviewerNameInput = document.getElementById('reviewer-name');
+    const reviewerNameError = document.getElementById('reviewer-name-error');
+    const reviewHtmlInput = document.getElementById('review-html');
+    const reviewHtmlError = document.getElementById('review-html-error');
+    const reviewStatus = document.getElementById('review-form-status');
+
+    async function renderReviewItem({ author, drink, html }, prepend = false) {
+      const article = document.createElement('article');
+      article.className = 'review-item';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = author;
+
+      const drinkBadge = document.createElement('span');
+      drinkBadge.className = 'review-drink-badge';
+      drinkBadge.textContent = drink;
+
+      header.append(authorSpan, drinkBadge);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, html);
+
+      article.append(header, body);
+
+      if (prepend && reviewsList.firstChild) {
+        reviewsList.prepend(article);
+      } else {
+        reviewsList.append(article);
+      }
+    }
+
+    for (const review of initialReviews) {
+      await renderReviewItem(review);
+    }
+
+    function validateField(input, errorEl, message) {
+      if (!input.value.trim()) {
+        input.setCustomValidity(message);
+        input.setAttribute('aria-invalid', 'true');
+        errorEl.textContent = `! ${message}`;
+        errorEl.hidden = false;
+        return false;
+      }
+      input.setCustomValidity('');
+      input.removeAttribute('aria-invalid');
+      errorEl.textContent = '';
+      errorEl.hidden = true;
+      return true;
+    }
+
+    const editedFields = new WeakSet();
+
+    reviewerNameInput.addEventListener('input', () => {
+      editedFields.add(reviewerNameInput);
+      if (reviewerNameInput.value.trim()) {
+        reviewerNameInput.setCustomValidity('');
+        reviewerNameInput.removeAttribute('aria-invalid');
+        reviewerNameError.textContent = '';
+        reviewerNameError.hidden = true;
+      }
+    });
+
+    reviewerNameInput.addEventListener('blur', () => {
+      if (editedFields.has(reviewerNameInput)) {
+        validateField(reviewerNameInput, reviewerNameError, 'Please enter your name.');
+      }
+    });
+
+    reviewHtmlInput.addEventListener('input', () => {
+      editedFields.add(reviewHtmlInput);
+      if (reviewHtmlInput.value.trim()) {
+        reviewHtmlInput.setCustomValidity('');
+        reviewHtmlInput.removeAttribute('aria-invalid');
+        reviewHtmlError.textContent = '';
+        reviewHtmlError.hidden = true;
+      }
+    });
+
+    reviewHtmlInput.addEventListener('blur', () => {
+      if (editedFields.has(reviewHtmlInput)) {
+        validateField(reviewHtmlInput, reviewHtmlError, 'Please enter your review feedback.');
+      }
+    });
+
+    document.querySelectorAll('.select-drink-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const drinkName = btn.dataset.drink;
+        const radio = reviewForm.querySelector(`input[name="drink"][value="${drinkName}"]`);
+        if (radio) {
+          radio.checked = true;
+        }
+        reviewHtmlInput.focus();
+      });
+    });
+
+    reviewForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      reviewStatus.textContent = '';
+
+      const isNameValid = validateField(reviewerNameInput, reviewerNameError, 'Please enter your name.');
+      const isHtmlValid = validateField(reviewHtmlInput, reviewHtmlError, 'Please enter your review feedback.');
+
+      if (!isNameValid) {
+        reviewerNameInput.focus();
+        return;
+      }
+      if (!isHtmlValid) {
+        reviewHtmlInput.focus();
+        return;
+      }
+
+      const formData = new FormData(reviewForm);
+      const author = String(formData.get('reviewer_name') ?? '').trim();
+      const drink = String(formData.get('drink') ?? 'Maple Oat Latte');
+      const html = String(formData.get('review_html') ?? '');
+
+      await renderReviewItem({ author, drink, html }, true);
+
+      reviewForm.reset();
+      editedFields.delete(reviewerNameInput);
+      editedFields.delete(reviewHtmlInput);
+      reviewStatus.textContent = `Thank you, ${author}! Your sanitized review for ${drink} has been posted.`;
+    });
+  </script>
+
 </body>
 
