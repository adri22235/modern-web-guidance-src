+  <script>
+    (function () {
+      const ALLOWED_TAGS = new Set([
+        'P', 'DIV', 'SPAN', 'BR', 'HR',
+        'B', 'I', 'U', 'S', 'STRONG', 'EM', 'MARK', 'SMALL', 'DEL', 'INS', 'SUB', 'SUP',
+        'CODE', 'PRE', 'BLOCKQUOTE', 'Q', 'CITE', 'ABBR',
+        'UL', 'OL', 'LI', 'DL', 'DT', 'DD',
+        'H1', 'H2', 'H3', 'H4', 'H5', 'H6',
+        'A', 'IMG', 'TABLE', 'THEAD', 'TBODY', 'TFOOT', 'TR', 'TH', 'TD', 'CAPTION'
+      ]);
+
+      const DROP_WITH_CONTENT_TAGS = new Set([
+        'SCRIPT', 'IFRAME', 'OBJECT', 'EMBED', 'STYLE', 'LINK', 'META', 'BASE',
+        'NOSCRIPT', 'TEMPLATE', 'APPLET', 'FRAME', 'FRAMESET', 'SVG', 'MATH',
+        'FORM', 'INPUT', 'BUTTON', 'TEXTAREA', 'SELECT', 'OPTION'
+      ]);
+
+      const ALLOWED_ATTRS = new Set([
+        'href', 'src', 'alt', 'title', 'class', 'dir', 'lang', 'colspan', 'rowspan'
+      ]);
+
+      function isSafeUrl(urlValue) {
+        const normalized = String(urlValue || '').replace(/[\u0000-\u0020]+/g, '').toLowerCase();
+        if (!normalized) return true;
+        if (
+          normalized.startsWith('javascript:') ||
+          normalized.startsWith('vbscript:') ||
+          normalized.startsWith('data:')
+        ) {
+          return false;
+        }
+        return true;
+      }
+
+      function sanitizeNode(node, targetDoc) {
+        if (node.nodeType === Node.TEXT_NODE) {
+          return targetDoc.createTextNode(node.nodeValue || '');
+        }
+        if (node.nodeType !== Node.ELEMENT_NODE) {
+          return null;
+        }
+
+        const tagName = node.tagName.toUpperCase();
+        if (DROP_WITH_CONTENT_TAGS.has(tagName)) {
+          return null;
+        }
+
+        if (!ALLOWED_TAGS.has(tagName)) {
+          const fragment = targetDoc.createDocumentFragment();
+          for (const child of Array.from(node.childNodes)) {
+            const cleanChild = sanitizeNode(child, targetDoc);
+            if (cleanChild) fragment.appendChild(cleanChild);
+          }
+          return fragment;
+        }
+
+        const cleanEl = targetDoc.createElement(tagName.toLowerCase());
+        for (const attr of Array.from(node.attributes)) {
+          const attrName = attr.name.toLowerCase();
+          if (attrName.startsWith('on')) continue;
+          if (!ALLOWED_ATTRS.has(attrName)) continue;
+          if ((attrName === 'href' || attrName === 'src') && !isSafeUrl(attr.value)) {
+            continue;
+          }
+          cleanEl.setAttribute(attrName, attr.value);
+        }
+
+        if (tagName === 'A' && cleanEl.hasAttribute('href')) {
+          cleanEl.setAttribute('rel', 'noopener noreferrer');
+        }
+
+        for (const child of Array.from(node.childNodes)) {
+          const cleanChild = sanitizeNode(child, targetDoc);
+          if (cleanChild) cleanEl.appendChild(cleanChild);
+        }
+
+        return cleanEl;
+      }
+
+      function parseAndSanitizeHTML(untrustedHtml) {
+        const parser = new DOMParser();
+        const parsedDoc = parser.parseFromString(String(untrustedHtml ?? ''), 'text/html');
+        const fragment = document.createDocumentFragment();
+        for (const child of Array.from(parsedDoc.body.childNodes)) {
+          const cleanChild = sanitizeNode(child, document);
+          if (cleanChild) fragment.appendChild(cleanChild);
+        }
+        return fragment;
+      }
+
+      if (typeof Element !== 'undefined' && typeof Element.prototype.setHTML !== 'function') {
+        Element.prototype.setHTML = function (html) {
+          const cleanFragment = parseAndSanitizeHTML(html);
+          this.replaceChildren(cleanFragment);
+        };
+      }
+
+      const initialReviews = [
+        {
+          author: 'Maya Lin',
+          drink: 'Maple Oat Latte',
+          rating: 5,
+          feedback: '<p>The <strong>Maple Oat Latte</strong> has the perfect balance of <em>real Vermont maple</em> and velvety microfoam. Easily my favorite autumn drink!</p>'
+        },
+        {
+          author: 'Jordan Vance',
+          drink: 'Dark Roast Espresso',
+          rating: 5,
+          feedback: '<p>Rich crema and <b>bold dark chocolate notes</b> without any bitterness.</p><blockquote>Best double shot in town for early mornings.</blockquote>'
+        },
+        {
+          author: 'Elena Rostova',
+          drink: 'Cold Brew',
+          rating: 5,
+          feedback: '<p>Incredibly smooth 18-hour steep! Here is why I order the <code>Cold Brew</code> daily:</p><ul><li>Zero acidity</li><li>Naturally sweet cocoa finish</li></ul>'
+        }
+      ];
+
+      const reviews = [...initialReviews];
+      let currentFilter = 'all';
+
+      const reviewsListEl = document.getElementById('reviews-list');
+      const reviewForm = document.getElementById('review-form');
+      const authorInput = document.getElementById('reviewer-name');
+      const drinkSelect = document.getElementById('review-drink');
+      const ratingSelect = document.getElementById('review-rating');
+      const feedbackInput = document.getElementById('review-feedback');
+      const filterTabs = document.querySelectorAll('.filter-tab');
+      const writeReviewBtns = document.querySelectorAll('.write-review-btn');
+      const toolbarBtns = document.querySelectorAll('.toolbar-btn');
+
+      function renderReviewCard(review) {
+        const item = document.createElement('article');
+        item.className = 'review-item';
+        item.setAttribute('data-drink', review.drink);
+
+        const meta = document.createElement('div');
+        meta.className = 'review-meta';
+
+        const leftMeta = document.createElement('div');
+        const authorSpan = document.createElement('span');
+        authorSpan.className = 'review-author';
+        authorSpan.textContent = review.author || 'Coffee Lover';
+
+        const badgeSpan = document.createElement('span');
+        badgeSpan.className = 'review-drink-badge';
+        badgeSpan.style.marginLeft = '8px';
+        badgeSpan.textContent = review.drink;
+
+        leftMeta.appendChild(authorSpan);
+        leftMeta.appendChild(badgeSpan);
+
+        const starsSpan = document.createElement('span');
+        starsSpan.className = 'review-stars';
+        const ratingNum = Math.min(5, Math.max(1, Number(review.rating) || 5));
+        starsSpan.textContent = '★'.repeat(ratingNum) + '☆'.repeat(5 - ratingNum);
+        starsSpan.setAttribute('aria-label', ratingNum + ' out of 5 stars');
+
+        meta.appendChild(leftMeta);
+        meta.appendChild(starsSpan);
+
+        const contentDiv = document.createElement('div');
+        contentDiv.className = 'review-content';
+        contentDiv.setHTML(review.feedback);
+
+        item.appendChild(meta);
+        item.appendChild(contentDiv);
+        return item;
+      }
+
+      function renderReviews() {
+        reviewsListEl.replaceChildren();
+        const filtered = currentFilter === 'all'
+          ? reviews
+          : reviews.filter(function (r) { return r.drink === currentFilter; });
+
+        filtered.forEach(function (review) {
+          reviewsListEl.appendChild(renderReviewCard(review));
+        });
+      }
+
+      reviewForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const rawFeedback = feedbackInput.value.trim();
+        if (!rawFeedback) return;
+
+        const newReview = {
+          author: authorInput.value.trim() || 'Coffee Lover',
+          drink: drinkSelect.value || 'Maple Oat Latte',
+          rating: Number(ratingSelect.value) || 5,
+          feedback: rawFeedback
+        };
+
+        reviews.unshift(newReview);
+        if (currentFilter !== 'all' && currentFilter !== newReview.drink) {
+          currentFilter = 'all';
+          filterTabs.forEach(function (tab) {
+            tab.classList.toggle('active', tab.getAttribute('data-filter') === 'all');
+          });
+        }
+
+        renderReviews();
+        feedbackInput.value = '';
+        authorInput.value = '';
+      });
+
+      filterTabs.forEach(function (tab) {
+        tab.addEventListener('click', function () {
+          currentFilter = tab.getAttribute('data-filter') || 'all';
+          filterTabs.forEach(function (t) {
+            t.classList.toggle('active', t === tab);
+          });
+          renderReviews();
+        });
+      });
+
+      writeReviewBtns.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const drink = btn.getAttribute('data-drink');
+          if (drink) {
+            drinkSelect.value = drink;
+          }
+          feedbackInput.focus();
+          reviewForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        });
+      });
+
+      toolbarBtns.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const tag = btn.getAttribute('data-tag');
+          if (!tag) return;
+          const start = feedbackInput.selectionStart || 0;
+          const end = feedbackInput.selectionEnd || 0;
+          const value = feedbackInput.value;
+          const selected = value.slice(start, end) || 'text';
+          const replacement = '<' + tag + '>' + selected + '</' + tag + '>';
+          feedbackInput.value = value.slice(0, start) + replacement + value.slice(end);
+          feedbackInput.focus();
+          feedbackInput.setSelectionRange(start + tag.length + 2, start + tag.length + 2 + selected.length);
+        });
+      });
+
+      renderReviews();
+    })();
+  </script>
