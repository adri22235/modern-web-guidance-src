+  <script>
+    const toggleClassCommand = (className, fallbackSelector) => (target, source) => {
+      const isActive = target.classList.toggle(className);
+      const button = source ?? document.querySelector(fallbackSelector);
+      button?.setAttribute('aria-pressed', String(isActive));
+    };
+
+    const commandRegistry = {
+      '--spin': toggleClassCommand('is-spun', 'button[commandfor="action-target"][command="--spin"]'),
+      '--grow': toggleClassCommand('is-grown', 'button[commandfor="action-target"][command="--grow"]'),
+      '--round': toggleClassCommand('is-rounded', 'button[commandfor="action-target"][command="--round"]'),
+      '--make-round': toggleClassCommand('is-rounded', 'button[commandfor="action-target"][command="--round"]'),
+      '--reset': (target) => {
+        target.classList.remove('is-spun', 'is-grown', 'is-rounded');
+        document.querySelectorAll(`button[commandfor="${target.id}"]:not([command="--reset"])`).forEach((btn) => {
+          btn.setAttribute('aria-pressed', 'false');
+        });
+      },
+    };
+
+    if (!globalThis.CommandEvent) {
+      globalThis.CommandEvent = class CommandEvent extends Event {
+        constructor(type, { source, command, ...options } = {}) {
+          super(type, options);
+          this.source = source;
+          this.command = command;
+        }
+      };
+
+      document.addEventListener('click', (event) => {
+        const button = event.composedPath().find((el) => el.matches?.('button[commandfor]'));
+        if (!button) return;
+
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        const command = button.getAttribute('command');
+
+        if (target && command) {
+          target.dispatchEvent(new CommandEvent('command', {
+            command,
+            source: button,
+          }));
+        }
+      });
+    }
+
+    document.getElementById('action-target').addEventListener('command', (event) => {
+      const action = commandRegistry[event.command];
+      if (action) {
+        action(event.target, event.source);
+      }
+    });
+  </script>
+
