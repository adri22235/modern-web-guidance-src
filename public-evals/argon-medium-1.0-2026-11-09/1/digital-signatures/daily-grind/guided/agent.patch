+    const formVoucherEl = document.getElementById('form-voucher');
+    const signerContextBadgeEl = document.getElementById('signer-context-badge');
+
+    const receiptItemSelect = document.getElementById('receipt-item');
+    const receiptTotalInput = document.getElementById('receipt-total');
+
+    const verifyAlgorithmLabelEl = document.getElementById('verify-algorithm-label');
+    const verifyStatusBannerEl = document.getElementById('verify-status-banner');
+    const verifyStatusTextEl = document.getElementById('verify-status-text');
+    const metaKeyFormatEl = document.getElementById('meta-key-format');
+    const metaPubkeyPreviewEl = document.getElementById('meta-pubkey-preview');
+    const metaDerivedKeyStatusEl = document.getElementById('meta-derived-key-status');
+    const verifyContextSelectEl = document.getElementById('verify-context-select');
+    const verifyPayloadInputEl = document.getElementById('verify-payload-input');
+    const verifySignatureInputEl = document.getElementById('verify-signature-input');
+
+    function updateKeyStatusUI(signatureByteLength = null) {
+      if (!activeKeyState) return;
+      const { suite, isPostQuantum, keyFormat, publicKeyBytes, derivedViaGetPublicKey } = activeKeyState;
+      suiteBadgeEl.textContent = isPostQuantum
+        ? `${suite} (Post-Quantum FIPS 204)`
+        : `${suite} (Classical Fallback)`;
+      suiteBadgeEl.classList.toggle('pq', isPostQuantum);
+      keyFormatEl.textContent = keyFormat;
+      pubkeySizeEl.textContent = `${publicKeyBytes.byteLength} bytes`;
+      if (signatureByteLength !== null) {
+        sigSizeEl.textContent = `${signatureByteLength} bytes`;
+      }
+      verifyAlgorithmLabelEl.textContent = `${suite} • ${keyFormat}`;
+      metaKeyFormatEl.textContent = keyFormat;
+      const pubB64 = bytesToBase64(publicKeyBytes);
+      metaPubkeyPreviewEl.textContent =
+        pubB64.length > 28 ? `${pubB64.slice(0, 16)}…${pubB64.slice(-10)}` : pubB64;
+      metaDerivedKeyStatusEl.textContent = derivedViaGetPublicKey
+        ? 'getPublicKey() + importKey(["verify"])'
+        : 'exportKey() + importKey(["verify"])';
+    }
+
+    async function issueAndSignArtifact(kind, payloadObject) {
+      if (!activeKeyState) {
+        activeKeyState = await generateSigningKeyPair(levelSelectEl.value);
+      }
+      const contextString = DOMAIN_CONTEXTS[kind];
+      const contextBytes = textEncoder.encode(contextString);
+      const canonicalJson = JSON.stringify(payloadObject, null, 2);
+      const payloadBytes = textEncoder.encode(canonicalJson);
+
+      const signatureBytes = await signPayload(
+        activeKeyState.keyPair.privateKey,
+        payloadBytes,
+        contextBytes,
+      );
+      const signatureBase64 = bytesToBase64(signatureBytes);
+
+      lastSignedSnapshot = {
+        kind,
+        contextString,
+        canonicalJson,
+        signatureBase64,
+        publicKeyBytes: activeKeyState.publicKeyBytes,
+      };
+
+      verifyContextSelectEl.value = contextString;
+      verifyPayloadInputEl.value = canonicalJson;
+      verifySignatureInputEl.value = signatureBase64;
+      updateKeyStatusUI(signatureBytes.byteLength);
+
+      await runVerification();
+    }
+
+    async function runVerification() {
+      if (!activeKeyState) return;
+      try {
+        const payloadText = verifyPayloadInputEl.value;
+        const payloadBytes = textEncoder.encode(payloadText);
+        const signatureBytes = base64ToBytes(verifySignatureInputEl.value);
+        const selectedContext = verifyContextSelectEl.value;
+        const contextBytes = textEncoder.encode(selectedContext);
+
+        const isValid = await verifyPayload(
+          activeKeyState.publicKeyBytes,
+          signatureBytes,
+          payloadBytes,
+          contextBytes,
+        );
+
+        if (isValid) {
+          verifyStatusBannerEl.className = 'verify-banner valid';
+          verifyStatusTextEl.textContent =
+            `Authentic & Intact — Verified with ${activeKeyState.suite} under context "${selectedContext}"`;
+        } else {
+          verifyStatusBannerEl.className = 'verify-banner invalid';
+          verifyStatusTextEl.textContent =
+            `Verification Failed — Signature, payload integrity, or domain context ("${selectedContext}") mismatch!`;
+        }
+      } catch (err) {
+        verifyStatusBannerEl.className = 'verify-banner invalid';
+        verifyStatusTextEl.textContent = `Verification Error: ${err.message || 'Malformed signature or key'}`;
+      }
+    }
+
+    function buildReceiptPayloadFromForm() {
+      return {
+        type: 'COFFEE_ORDER_RECEIPT',
+        issuer: 'The Daily Grind Coffee Co.',
+        orderId: document.getElementById('receipt-order-id').value.trim(),
+        customer: document.getElementById('receipt-customer').value.trim(),
+        item: document.getElementById('receipt-item').value,
+        totalPaid: document.getElementById('receipt-total').value.trim(),
+        roastery: document.getElementById('receipt-location').value.trim(),
+        issuedAt: '2026-11-09T21:30:00Z',
+      };
+    }
+
+    function buildVoucherPayloadFromForm() {
+      return {
+        type: 'GIFT_VOUCHER',
+        issuer: 'The Daily Grind Coffee Co.',
+        voucherCode: document.getElementById('voucher-code').value.trim(),
+        recipient: document.getElementById('voucher-recipient').value.trim(),
+        creditValue: document.getElementById('voucher-amount').value,
+        expiresOn: document.getElementById('voucher-expiry').value,
+        note: document.getElementById('voucher-note').value.trim(),
+      };
+    }
+
+    function switchTab(targetKind) {
+      const isReceipt = targetKind === 'receipt';
+      tabReceiptBtn.setAttribute('aria-selected', String(isReceipt));
+      tabVoucherBtn.setAttribute('aria-selected', String(!isReceipt));
+      formReceiptEl.hidden = !isReceipt;
+      formVoucherEl.hidden = isReceipt;
+      signerContextBadgeEl.textContent = DOMAIN_CONTEXTS[targetKind];
+    }
+
+    tabReceiptBtn.addEventListener('click', () => switchTab('receipt'));
+    tabVoucherBtn.addEventListener('click', () => switchTab('voucher'));
+
+    receiptItemSelect.addEventListener('change', () => {
+      const opt = receiptItemSelect.selectedOptions[0];
+      if (opt?.dataset.price) {
+        receiptTotalInput.value = `$${opt.dataset.price}`;
+      }
+    });
+
+    formReceiptEl.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      await issueAndSignArtifact('receipt', buildReceiptPayloadFromForm());
+    });
+
+    formVoucherEl.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      await issueAndSignArtifact('voucher', buildVoucherPayloadFromForm());
+    });
+
+    regenerateKeyBtn.addEventListener('click', async () => {
+      activeKeyState = await generateSigningKeyPair(levelSelectEl.value);
+      const isVoucherActive = tabVoucherBtn.getAttribute('aria-selected') === 'true';
+      if (isVoucherActive) {
+        await issueAndSignArtifact('voucher', buildVoucherPayloadFromForm());
+      } else {
+        await issueAndSignArtifact('receipt', buildReceiptPayloadFromForm());
+      }
+    });
+
+    levelSelectEl.addEventListener('change', async () => {
+      activeKeyState = await generateSigningKeyPair(levelSelectEl.value);
+      const isVoucherActive = tabVoucherBtn.getAttribute('aria-selected') === 'true';
+      if (isVoucherActive) {
+        await issueAndSignArtifact('voucher', buildVoucherPayloadFromForm());
+      } else {
+        await issueAndSignArtifact('receipt', buildReceiptPayloadFromForm());
+      }
+    });
+
+    document.getElementById('verify-now-btn').addEventListener('click', runVerification);
+    verifyContextSelectEl.addEventListener('change', runVerification);
+    verifyPayloadInputEl.addEventListener('input', runVerification);
+    verifySignatureInputEl.addEventListener('input', runVerification);
+
+    document.getElementById('tamper-payload-btn').addEventListener('click', async () => {
+      try {
+        const parsed = JSON.parse(verifyPayloadInputEl.value);
+        if (parsed.totalPaid) {
+          parsed.totalPaid = '$0.01';
+        } else if (parsed.creditValue) {
+          parsed.creditValue = '$999.00';
+        } else {
+          parsed.tampered = true;
+        }
+        verifyPayloadInputEl.value = JSON.stringify(parsed, null, 2);
+      } catch {
+        verifyPayloadInputEl.value += '\n// tampered';
+      }
+      await runVerification();
+    });
+
+    document.getElementById('replay-context-btn').addEventListener('click', async () => {
+      verifyContextSelectEl.value =
+        verifyContextSelectEl.value === DOMAIN_CONTEXTS.receipt
+          ? DOMAIN_CONTEXTS.voucher
+          : DOMAIN_CONTEXTS.receipt;
+      await runVerification();
+    });
+
+    document.getElementById('restore-artifact-btn').addEventListener('click', async () => {
+      if (!lastSignedSnapshot) return;
+      verifyContextSelectEl.value = lastSignedSnapshot.contextString;
+      verifyPayloadInputEl.value = lastSignedSnapshot.canonicalJson;
+      verifySignatureInputEl.value = lastSignedSnapshot.signatureBase64;
+      await runVerification();
+    });
+
+    document.querySelectorAll('.quick-receipt-btn').forEach((btn) => {
+      btn.addEventListener('click', async () => {
+        switchTab('receipt');
+        const item = btn.dataset.item;
+        const price = btn.dataset.price;
+        for (const opt of receiptItemSelect.options) {
+          if (opt.value.startsWith(item)) {
+            receiptItemSelect.value = opt.value;
+            break;
+          }
+        }
+        receiptTotalInput.value = `$${price}`;
+        document.getElementById('receipt-order-id').value =
+          `ORD-2026-${Math.floor(1000 + Math.random() * 9000)}`;
+        await issueAndSignArtifact('receipt', buildReceiptPayloadFromForm());
+        document.getElementById('authenticity').scrollIntoView({ behavior: 'smooth' });
+      });
+    });
+
+    // Initialize default key pair & sign initial coffee order receipt on load
+    (async () => {
+      activeKeyState = await generateSigningKeyPair('ML-DSA-65');
+      await issueAndSignArtifact('receipt', buildReceiptPayloadFromForm());
+    })();
+  </script>
+
 </body>
 
 </html>
