+          const ecdsaPubKey = await crypto.subtle.importKey(
+            'spki',
+            ecdsaSpkiBytes.buffer,
+            { name: 'ECDSA', namedCurve: 'P-256' },
+            false,
+            ['verify']
+          );
+          const ecdsaOk = await crypto.subtle.verify(
+            { name: 'ECDSA', hash: { name: 'SHA-256' } },
+            ecdsaPubKey,
+            ecdsaSigBytes.buffer,
+            messageBytes
+          );
+          const mldsaOk = window.DailyGrindPQC.ml_dsa44.verify(
+            mldsaSigBytes,
+            messageBytes,
+            mldsaPubBytes
