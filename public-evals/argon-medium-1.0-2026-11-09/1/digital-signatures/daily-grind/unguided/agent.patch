+        if (algorithmId === 'ML-DSA-44' || algorithmId === 'ML-DSA-65') {
+          const dsa = algorithmId === 'ML-DSA-65'
+            ? window.DailyGrindPQC.ml_dsa65
+            : window.DailyGrindPQC.ml_dsa44;
+          return dsa.verify(sigBytes, messageBytes, pubBytes);
+        }
