+        if (algorithmId === 'ECDSA-P256') {
+          const pubKey = await crypto.subtle.importKey(
+            'spki',
+            pubBytes.buffer,
+            { name: 'ECDSA', namedCurve: 'P-256' },
+            false,
+            ['verify']
+          );
+          return crypto.subtle.verify(
+            { name: 'ECDSA', hash: { name: 'SHA-256' } },
+            pubKey,
+            sigBytes.buffer,
+            messageBytes
+          );
+        }
+
+        if (algorithmId === 'Ed25519') {
+          const pubKey = await crypto.subtle.importKey(
+            'spki',
+            pubBytes.buffer,
+            { name: 'Ed25519' },
+            false,
+            ['verify']
+          );
+          return crypto.subtle.verify(
+            { name: 'Ed25519' },
+            pubKey,
+            sigBytes.buffer,
+            messageBytes
+          );
+        }
