+        return {
+          schema: 'DAILY_GRIND_CRYPTO_ENVELOPE_V1',
+          documentType, // 'COFFEE_ORDER_RECEIPT' | 'GIFT_VOUCHER'
+          payload: payloadObject,
+          security: {
+            algorithm: keyRecord.algorithm,
+            quantumResistant: keyRecord.algorithm.includes('ML-DSA') || keyRecord.algorithm.includes('HYBRID'),
+            keyId: keyRecord.kid,
+            publicKeyFingerprint: keyRecord.fingerprint,
+            publicKeyBase64: keyRecord.publicKeyBase64,
+            payloadHashAlgorithm: 'SHA-256',
+            payloadDigestHex: payloadSha256,
+            signatureBase64,
+            signedAt: new Date().toISOString()
+          }
+        };
+      }
