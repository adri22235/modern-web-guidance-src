+        return {
+          valid: overallValid,
+          elapsedMs,
+          algorithm: algo,
+          documentType: docType,
+          title: overallValid
+            ? `AUTHENTIC & INTACT — ${docType === 'GIFT_VOUCHER' ? 'GIFT VOUCHER' : 'ORDER RECEIPT'} VERIFIED`
