+        let pubKeyFingerprint = 'invalid';
+        try {
+          pubKeyFingerprint = await sha256Hex(base64ToBytes(resolvedPubKeyBase64));
+          steps.push({
+            title: '3. Asymmetric Public Key Resolution',
+            status: 'PASS',
+            detail: `Algorithm: ${algo} | Source: ${keySource} | PK SHA-256: ${pubKeyFingerprint.slice(0, 20)}...`
+          });
+        } catch (err) {
+          steps.push({
+            title: '3. Asymmetric Public Key Resolution',
+            status: 'FAIL',
+            detail: 'Invalid Base64 Public Key: ' + err.message
+          });
+          return {
+            valid: false,
+            elapsedMs: (performance.now() - t0).toFixed(2),
+            title: 'VERIFICATION FAILED — INVALID PUBLIC KEY',
+            subtitle: 'Could not decode the public key for verification.',
