+        if (algo === 'ECDSA-P256') {
+          const sigBuf = await crypto.subtle.sign(
+            { name: 'ECDSA', hash: { name: 'SHA-256' } },
+            keyRecord.cryptoKeyPair.privateKey,
+            messageBytes
+          );
+          return bytesToBase64(new Uint8Array(sigBuf));
+        }
