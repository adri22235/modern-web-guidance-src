+        if (algorithmId === 'HYBRID-ECDSA-MLDSA44') {
+          const pubObj = JSON.parse(new TextDecoder().decode(pubBytes));
+          const sigObj = JSON.parse(new TextDecoder().decode(sigBytes));
+          const ecdsaSpkiBytes = base64ToBytes(pubObj.ecdsaSpki);
+          const mldsaPubBytes = base64ToBytes(pubObj.mldsa44Pub);
+          const ecdsaSigBytes = base64ToBytes(sigObj.ecdsaSig);
+          const mldsaSigBytes = base64ToBytes(sigObj.mldsa44Sig);
