+      async function verifySignedEnvelope(envelopeInput, customPublicKeyBase64 = '') {
+        const t0 = performance.now();
+        const steps = [];
+        let parsed;
+
+        try {
+          parsed = typeof envelopeInput === 'string' ? JSON.parse(envelopeInput) : envelopeInput;
+        } catch (err) {
+          return {
+            valid: false,
+            elapsedMs: (performance.now() - t0).toFixed(2),
+            title: 'VERIFICATION FAILED — MALFORMED JSON ENVELOPE',
+            subtitle: 'The input could not be parsed as a valid JSON cryptographic envelope.',
+            steps: [{
+              title: '1. Envelope Schema & Syntax Check',
+              status: 'FAIL',
+              detail: 'JSON Parse Error: ' + err.message
+            }]
+          };
+        }
+
+        if (!parsed || typeof parsed !== 'object' || !parsed.payload || !parsed.security) {
+          return {
+            valid: false,
+            elapsedMs: (performance.now() - t0).toFixed(2),
+            title: 'VERIFICATION FAILED — MISSING PAYLOAD OR SECURITY BLOCK',
+            subtitle: 'Envelope must contain both "payload" and "security" objects.',
+            steps: [{
+              title: '1. Envelope Structure Validation',
+              status: 'FAIL',
+              detail: 'Missing required fields: payload or security'
+            }]
+          };
+        }
+
+        const docType = parsed.documentType || 'UNKNOWN';
+        steps.push({
+          title: '1. Envelope Structure & Document Type',
+          status: 'PASS',
+          detail: `Schema: ${parsed.schema || 'V1'} | Type: ${docType}`
+        });
+
+        // Step 2: Canonical Payload SHA-256 Digest Check
+        const canonicalPayload = canonicalizeJSON(parsed.payload);
+        const payloadBytes = textEncoder.encode(canonicalPayload);
+        const computedDigest = await sha256Hex(payloadBytes);
+        const claimedDigest = parsed.security.payloadDigestHex || '';
+        const digestMatches = computedDigest === claimedDigest;
+
+        steps.push({
+          title: '2. Canonical Payload SHA-256 Integrity Check',
+          status: digestMatches ? 'PASS' : 'FAIL',
+          detail: digestMatches
+            ? `Computed SHA-256 matches claimed digest (${computedDigest.slice(0, 24)}...)`
+            : `TAMPER DETECTED! Claimed: ${claimedDigest.slice(0, 20)}... vs Computed: ${computedDigest.slice(0, 20)}...`
+        });
+
+        // Step 3: Resolve Asymmetric Public Key
+        const algo = parsed.security.algorithm || 'ML-DSA-44';
+        const kid = parsed.security.keyId || 'unknown';
+        let resolvedPubKeyBase64 = (customPublicKeyBase64 || '').trim();
+        let keySource = 'Custom Override Public Key';
+
+        if (!resolvedPubKeyBase64) {
+          if (trustedKeyring.has(kid)) {
+            resolvedPubKeyBase64 = trustedKeyring.get(kid).publicKeyBase64;
+            keySource = `Store Trusted Keyring (${kid})`;
+          } else if (parsed.security.publicKeyBase64) {
+            resolvedPubKeyBase64 = parsed.security.publicKeyBase64;
+            keySource = `Envelope Embedded Public Key (${kid})`;
+          } else if (activeKeyRecord) {
+            resolvedPubKeyBase64 = activeKeyRecord.publicKeyBase64;
+            keySource = `Active Store Key (${activeKeyRecord.kid})`;
