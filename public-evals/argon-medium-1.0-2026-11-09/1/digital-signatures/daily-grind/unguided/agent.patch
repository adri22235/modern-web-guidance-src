+      async function createSignedEnvelope(documentType, payloadObject, keyRecord = activeKeyRecord) {
+        const canonicalPayload = canonicalizeJSON(payloadObject);
+        const payloadBytes = textEncoder.encode(canonicalPayload);
+        const payloadSha256 = await sha256Hex(payloadBytes);
+        const signatureBase64 = await signCanonicalBytes(payloadBytes, keyRecord);
