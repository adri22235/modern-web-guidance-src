+            { name: 'ECDSA', hash: { name: 'SHA-256' } },
+            keyRecord.ecdsaPrivateKey,
+            messageBytes
+          );
+          const mldsaSigBytes = window.DailyGrindPQC.ml_dsa44.sign(
+            messageBytes,
+            keyRecord.mldsaSecretKey
+          );
+          const combined = {
+            ecdsaSig: bytesToBase64(new Uint8Array(ecdsaSigBuf)),
+            mldsa44Sig: bytesToBase64(mldsaSigBytes)
