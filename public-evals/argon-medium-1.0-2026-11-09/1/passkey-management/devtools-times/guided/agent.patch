diff --git a/src/utils/passkeyStore.ts b/src/utils/passkeyStore.ts
new file mode 100644
index 0000000..e272098
--- /dev/null
+++ b/src/utils/passkeyStore.ts
@@ -0,0 +1,219 @@
+import aaguidsData from '../data/aaguids.json';
+
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The DevTools Times';
+
+export interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+const aaguids: Record<string, AaguidEntry> = aaguidsData as Record<string, AaguidEntry>;
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID (Base64URL-encoded)
+  credentialPublicKey: string; // Base64URL-encoded public key used to verify assertion signatures
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number; // Optional epoch timestamp of last sign-in
+  registeredAt: number; // Registration epoch timestamp
+  counter: number;
+}
+
+export interface UserProfile {
+  id: string;
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // Username / email
+  displayName: string; // Reader display name
+  subscriptionTier: string;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export function resolveAaguidProvider(
+  aaguid: string,
+  fallbackDeviceName?: string
+): { name: string; providerIcon?: string; iconLight?: string; iconDark?: string } {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: fallbackDeviceName || 'Unknown passkey provider',
+      providerIcon: undefined,
+      iconLight: undefined,
+      iconDark: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || fallbackDeviceName || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+    iconLight: provider?.icon_light,
+    iconDark: provider?.icon_dark,
+  };
+}
+
+// Encode seed IDs as genuine unpadded Base64URL strings
+const DEFAULT_PASSKEY_USER_ID = Buffer.from('reader-alex-morgan-01').toString('base64url');
+const CRED_ID_1 = Buffer.from('cred-google-pm-0001').toString('base64url');
+const CRED_ID_2 = Buffer.from('cred-icloud-key-002').toString('base64url');
+const CRED_ID_3 = Buffer.from('cred-1password-0003').toString('base64url');
+
+const DEFAULT_PUBLIC_KEY_1 = Buffer.from('mock-cose-public-key-google-pm-01').toString('base64url');
+const DEFAULT_PUBLIC_KEY_2 = Buffer.from('mock-cose-public-key-icloud-kc-02').toString('base64url');
+const DEFAULT_PUBLIC_KEY_3 = Buffer.from('mock-cose-public-key-1password-03').toString('base64url');
+
+const gpmMeta = resolveAaguidProvider('ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4');
+const icloudMeta = resolveAaguidProvider('fbfc3007-154e-4ecc-8c0b-6e020557d7bd');
+const onePasswordMeta = resolveAaguidProvider('bada5566-a7aa-401f-bd96-45619a55120d');
+
+interface StoreState {
+  user: UserProfile;
+  credentials: StoredPasskeyCredential[];
+  challenges: Record<string, string>;
+}
+
+// Attach to globalThis so state persists across hot reloads and route handlers
+const globalStoreKey = '__DEVTOOLS_TIMES_PASSKEY_STORE__';
+
+function createInitialState(): StoreState {
+  return {
+    user: {
+      id: DEFAULT_PASSKEY_USER_ID,
+      passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+      name: 'alex.morgan@devtoolstimes.com',
+      displayName: 'Alex Morgan',
+      subscriptionTier: 'All-Access Digital & Print Edition',
+    },
+    credentials: [
+      {
+        id: CRED_ID_1,
+        passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+        credentialPublicKey: DEFAULT_PUBLIC_KEY_1,
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        providerIcon: gpmMeta.providerIcon,
+        name: gpmMeta.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: 1758009600000, // Sep 16, 2025
+        lastUsedAt: 1762689600000, // Nov 9, 2025
+        counter: 14,
+      },
+      {
+        id: CRED_ID_2,
+        passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+        credentialPublicKey: DEFAULT_PUBLIC_KEY_2,
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        providerIcon: icloudMeta.providerIcon,
+        name: 'MacBook Pro (iCloud Keychain)',
+        transports: ['internal', 'hybrid'],
+        registeredAt: 1752566400000, // Jul 15, 2025
+        lastUsedAt: 1761912000000, // Oct 31, 2025
+        counter: 8,
+      },
+      {
+        id: CRED_ID_3,
+        passkeyUserId: DEFAULT_PASSKEY_USER_ID,
+        credentialPublicKey: DEFAULT_PUBLIC_KEY_3,
+        credentialType: 'public-key',
+        credentialDeviceType: 'multiDevice',
+        credentialBackedUp: true,
+        aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+        providerIcon: onePasswordMeta.providerIcon,
+        name: onePasswordMeta.name,
+        transports: ['internal', 'hybrid'],
+        registeredAt: 1748764800000, // Jun 1, 2025
+        lastUsedAt: 1759219200000, // Sep 30, 2025
+        counter: 3,
+      },
+    ],
+    challenges: {},
+  };
+}
+
+function getStore(): StoreState {
+  const g = globalThis as unknown as Record<string, StoreState | undefined>;
+  if (!g[globalStoreKey]) {
+    g[globalStoreKey] = createInitialState();
+  }
+  return g[globalStoreKey]!;
+}
+
+export const db = {
+  getUser(): UserProfile {
+    return { ...getStore().user };
+  },
+
+  updateUser(
+    userId: string,
+    updates: { name?: string; displayName?: string }
+  ): UserProfile {
+    const store = getStore();
+    if (updates.name !== undefined && updates.name.trim().length > 0) {
+      store.user.name = updates.name.trim();
+    }
+    if (updates.displayName !== undefined && updates.displayName.trim().length > 0) {
+      store.user.displayName = updates.displayName.trim();
+    }
+    return { ...store.user };
+  },
+
+  findCredentialsByUserId(passkeyUserId: string): StoredPasskeyCredential[] {
+    const store = getStore();
+    return store.credentials
+      .filter((cred) => cred.passkeyUserId === passkeyUserId)
+      .map((cred) => ({ ...cred }));
+  },
+
+  findCredentialById(id: string): StoredPasskeyCredential | undefined {
+    const store = getStore();
+    const found = store.credentials.find((cred) => cred.id === id);
+    return found ? { ...found } : undefined;
+  },
+
+  saveCredential(cred: StoredPasskeyCredential): StoredPasskeyCredential {
+    const store = getStore();
+    const idx = store.credentials.findIndex((c) => c.id === cred.id);
+    if (idx >= 0) {
+      store.credentials[idx] = { ...cred };
+    } else {
+      store.credentials.unshift({ ...cred });
+    }
+    return { ...cred };
+  },
+
+  deleteCredential(id: string): boolean {
+    const store = getStore();
+    const initialLength = store.credentials.length;
+    store.credentials = store.credentials.filter((cred) => cred.id !== id);
+    return store.credentials.length < initialLength;
+  },
+
+  setChallenge(passkeyUserId: string, challenge: string): void {
+    const store = getStore();
+    store.challenges[passkeyUserId] = challenge;
+  },
+
+  getChallenge(passkeyUserId: string): string | undefined {
+    const store = getStore();
+    return store.challenges[passkeyUserId];
+  },
+};
