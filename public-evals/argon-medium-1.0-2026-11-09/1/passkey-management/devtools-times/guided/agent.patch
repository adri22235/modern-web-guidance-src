+                              value={editingNameValue}
+                              onChange={(e) =>
+                                setEditingNameValue(e.target.value)
+                              }
+                              onKeyDown={(e) => {
+                                if (e.key === 'Enter') {
+                                  e.preventDefault();
+                                  handleConfirmCredentialRename(cred.id);
+                                } else if (e.key === 'Escape') {
