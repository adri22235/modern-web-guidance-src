+import React, { useState, useEffect, useCallback } from 'react';
+import 'webauthn-polyfills';
+import aaguidsData from '../data/aaguids.json';
+import type {
+  StoredPasskeyCredential,
+  UserProfile,
+  AaguidEntry,
+} from '../utils/passkeyStore';
+
+const aaguids: Record<string, AaguidEntry> = aaguidsData as Record<string, AaguidEntry>;
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+function getProviderDetails(cred: StoredPasskeyCredential): {
+  providerName: string;
+  providerIcon?: string;
+} {
+  if (!cred.aaguid || cred.aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      providerName: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const entry = aaguids[cred.aaguid];
+  return {
+    providerName: entry?.name || 'Unknown passkey provider',
+    providerIcon: entry?.icon_light || cred.providerIcon,
+  };
+}
+
+function formatEpochDate(epochMs?: number): string {
+  if (!epochMs) return 'Never';
+  return new Date(epochMs).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+async function isPasskeySupported(): Promise<boolean> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !PublicKeyCredential.getClientCapabilities
+  ) {
+    return false;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(capabilities.passkeyPlatformAuthenticator);
+  } catch {
+    return false;
+  }
+}
+
+async function syncAcceptedCredentials(
+  rpId: string,
+  userId: string,
+  currentCredentialsList: StoredPasskeyCredential[]
+): Promise<boolean> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !PublicKeyCredential.signalAllAcceptedCredentials
+  ) {
+    return false;
+  }
+
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (
+    !rpId ||
+    !isValidBase64Url(userId) ||
+    !credentialIds.every(isValidBase64Url)
+  ) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return false;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds,
+    });
+    return true;
+  } catch (e) {
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+    return false;
+  }
+}
+
+interface AccountSettingsProps {
+  initialUser?: UserProfile;
+  initialCredentials?: StoredPasskeyCredential[];
+  initialRpId?: string;
+}
+
+export default function AccountSettings({
+  initialUser,
+  initialCredentials = [],
+  initialRpId = 'localhost',
+}: AccountSettingsProps) {
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  const [rpId, setRpId] = useState<string>(initialRpId);
+  const [userId, setUserId] = useState<string>(
+    initialUser?.passkeyUserId || ''
+  );
+  const [user, setUser] = useState<UserProfile>(
+    initialUser || {
+      id: '',
+      passkeyUserId: '',
+      name: 'alex.morgan@devtoolstimes.com',
+      displayName: 'Alex Morgan',
+      subscriptionTier: 'All-Access Digital & Print Edition',
+    }
+  );
+  const [credentials, setCredentials] =
+    useState<StoredPasskeyCredential[]>(initialCredentials);
+  const [loading, setLoading] = useState<boolean>(
+    initialCredentials.length === 0
+  );
+
+  // User account profile form state
+  const [accountName, setAccountName] = useState<string>(user.name);
+  const [accountDisplayName, setAccountDisplayName] = useState<string>(
+    user.displayName
+  );
+  const [savingProfile, setSavingProfile] = useState<boolean>(false);
+
+  // Credential rename state
+  const [editingCredentialId, setEditingCredentialId] = useState<string | null>(
+    null
+  );
+  const [editingNameValue, setEditingNameValue] = useState<string>('');
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [deletingId, setDeletingId] = useState<string | null>(null);
+
+  // Passkey creation & feature support state
+  const [passkeySupported, setPasskeySupported] = useState<boolean>(true);
+  const [creatingPasskey, setCreatingPasskey] = useState<boolean>(false);
+
+  // Feedback banner
+  const [statusMessage, setStatusMessage] = useState<{
+    type: 'success' | 'error' | 'info';
+    text: string;
+  } | null>(null);
+
+  const loadManagementPanel = useCallback(async () => {
+    try {
+      const response = await fetch(`${baseUrl}api/credentials`);
+      if (!response.ok) return;
+      const data = await response.json();
+      if (data.rpId) setRpId(data.rpId);
+      if (data.userId) setUserId(data.userId);
+      if (data.user) {
+        setUser(data.user);
+        setAccountName(data.user.name);
+        setAccountDisplayName(data.user.displayName);
+      }
+      const creds: StoredPasskeyCredential[] = Array.isArray(data.credentials)
+        ? data.credentials
+        : [];
+      setCredentials(creds);
+      setLoading(false);
+
+      // Sync accepted credentials on initial load using server-provided rpId and userId
+      await syncAcceptedCredentials(data.rpId, data.userId, creds);
+    } catch (err) {
+      console.warn('Failed to load passkey credentials:', err);
+      setLoading(false);
+    }
+  }, [baseUrl]);
+
+  useEffect(() => {
+    loadManagementPanel();
+    isPasskeySupported().then((supported) => {
+      setPasskeySupported(supported);
+    });
+  }, [loadManagementPanel]);
+
+  const handleStartRename = (cred: StoredPasskeyCredential) => {
+    setEditingCredentialId(cred.id);
+    setEditingNameValue(cred.name);
+    setStatusMessage(null);
+  };
+
+  const handleCancelRename = () => {
+    setEditingCredentialId(null);
+    setEditingNameValue('');
+  };
+
+  // Renaming a passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+  const handleConfirmCredentialRename = async (credentialId: string) => {
+    const trimmed = editingNameValue.trim();
+    if (!trimmed) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Please enter a non-empty display name for the passkey.',
+      });
+      return;
+    }
+
+    setRenamingId(credentialId);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(
+        `${baseUrl}api/credential/${encodeURIComponent(credentialId)}`,
+        {
+          method: 'PUT',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ name: trimmed }),
+        }
+      );
+
+      if (response.ok) {
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        if (updatedResponse.ok) {
+          const { credentials: updatedCredentials } =
+            await updatedResponse.json();
+          setCredentials(updatedCredentials);
+        }
+        setEditingCredentialId(null);
+        setEditingNameValue('');
+        setStatusMessage({
+          type: 'success',
+          text: `Passkey display name updated to "${trimmed}".`,
+        });
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setStatusMessage({
+          type: 'error',
+          text: errData.error || 'Could not update passkey name.',
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while updating passkey display name.',
+      });
+    } finally {
+      setRenamingId(null);
+    }
+  };
+
+  // Deleting a passkey removes it on the server and synchronizes remaining credentials via signalAllAcceptedCredentials
+  const handleDeleteCredential = async (cred: StoredPasskeyCredential) => {
+    setDeletingId(cred.id);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(
+        `${baseUrl}api/credential/${encodeURIComponent(cred.id)}`,
+        {
+          method: 'DELETE',
+        }
+      );
+
+      if (response.ok) {
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        if (updatedResponse.ok) {
+          const {
+            rpId: serverRpId,
+            userId: serverUserId,
+            credentials: updatedCredentials,
+          } = await updatedResponse.json();
+          setRpId(serverRpId);
+          setUserId(serverUserId);
+          setCredentials(updatedCredentials);
+
+          // Sync remaining accepted credentials with the browser authenticator
+          await syncAcceptedCredentials(
+            serverRpId,
+            serverUserId,
+            updatedCredentials
+          );
+        }
+        setStatusMessage({
+          type: 'info',
+          text: `Removed passkey "${cred.name}" and synchronized your browser authenticator.`,
+        });
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setStatusMessage({
+          type: 'error',
+          text: errData.error || 'Failed to delete passkey.',
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while removing passkey.',
+      });
+    } finally {
+      setDeletingId(null);
+    }
+  };
+
+  // Updating user's account username or displayName triggers signalCurrentUserDetails
+  const handleUserProfileUpdate = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const updatedName = accountName.trim();
+    const updatedDisplayName = accountDisplayName.trim();
+    if (!updatedName || !updatedDisplayName) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Both username and display name are required.',
+      });
+      return;
+    }
+
+    setSavingProfile(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${baseUrl}api/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          name: updatedName,
+          displayName: updatedDisplayName,
+        }),
+      });
+
+      if (response.ok) {
+        const data = await response.json();
+        setUser((prev) => ({
+          ...prev,
+          name: data.name || updatedName,
+          displayName: data.displayName || updatedDisplayName,
+        }));
+        if (data.rpId) setRpId(data.rpId);
+        if (data.userId) setUserId(data.userId);
+
+        if (
+          typeof window !== 'undefined' &&
+          window.PublicKeyCredential &&
+          PublicKeyCredential.signalCurrentUserDetails
+        ) {
+          if (!data.rpId || !isValidBase64Url(data.userId)) {
+            console.warn(
+              'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+            );
+          } else {
+            try {
+              await PublicKeyCredential.signalCurrentUserDetails({
+                rpId: data.rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+                userId: data.userId, // Base64URL-encoded user ID from the server
+                name: updatedName,
+                displayName: updatedDisplayName,
+              });
+            } catch (syncErr) {
+              console.warn('SignalCurrentUserDetails sync warning:', syncErr);
+            }
+          }
+        }
+
+        setStatusMessage({
+          type: 'success',
+          text: 'Account display name and username updated and synchronized with your passkey authenticator.',
+        });
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setStatusMessage({
+          type: 'error',
+          text: errData.error || 'Failed to update reader profile.',
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while updating reader profile.',
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  // Registering a new passkey from the management panel (omits authenticatorAttachment so security keys work too)
+  const handleCreatePasskey = async () => {
+    setStatusMessage(null);
+    setCreatingPasskey(true);
+
+    try {
+      const supported = await isPasskeySupported();
+      if (!supported) {
+        setPasskeySupported(false);
+        return;
+      }
+
+      const optionsRes = await fetch(`${baseUrl}api/passkey/register-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ promotion: false }),
+      });
+
+      if (!optionsRes.ok) {
+        setStatusMessage({
+          type: 'error',
+          text: 'Unable to start passkey registration.',
+        });
+        return;
+      }
+
+      const creationOptionsJSON = await optionsRes.json();
+      const publicKey =
+        PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      let credential: PublicKeyCredential | null = null;
+      try {
+        credential = (await navigator.credentials.create({
+          publicKey,
+        })) as PublicKeyCredential | null;
+      } catch (err: any) {
+        if (err?.name === 'InvalidStateError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'A passkey already exists on this authenticator for your account.',
+          });
+        } else if (err?.name === 'SecurityError') {
+          setStatusMessage({
+            type: 'error',
+            text: 'Configuration RP ID or Secure Context error.',
+          });
+        } else if (err?.name === 'NotAllowedError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'Passkey registration was cancelled.',
+          });
+        } else if (err?.name === 'AbortError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'The passkey registration operation was aborted.',
+          });
+        }
+        return;
+      }
+
+      if (!credential) return;
+
+      const serverRpId =
+        (publicKey.rp && publicKey.rp.id) || creationOptionsJSON?.rp?.id || rpId;
+      const encodedResponse = credential.toJSON();
+
+      try {
+        const verifyRes = await fetch(`${baseUrl}api/passkey/register-verify`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!verifyRes.ok) {
+          if (
+            window.PublicKeyCredential &&
+            PublicKeyCredential.signalUnknownCredential &&
+            serverRpId &&
+            isValidBase64Url(encodedResponse.id)
+          ) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: serverRpId,
+                credentialId: encodedResponse.id,
+              });
+            } catch (sigErr) {
+              console.warn('SignalUnknownCredential sync warning:', sigErr);
+            }
+          }
+          const errData = await verifyRes.json().catch(() => ({}));
+          setStatusMessage({
+            type: 'error',
+            text: errData.error || 'Server verification of the passkey failed.',
+          });
+          return;
+        }
+
+        const verifyData = await verifyRes.json();
+        if (Array.isArray(verifyData.credentials)) {
+          setCredentials(verifyData.credentials);
+          await syncAcceptedCredentials(
+            verifyData.rpId || serverRpId,
+            verifyData.userId || userId,
+            verifyData.credentials
+          );
+        } else {
+          await loadManagementPanel();
+        }
+
+        setStatusMessage({
+          type: 'success',
+          text: 'New passkey registered and synced with your account.',
+        });
+      } catch (serverErr) {
+        console.warn('Server verification network failure:', serverErr);
+        if (
+          window.PublicKeyCredential &&
+          PublicKeyCredential.signalUnknownCredential &&
+          serverRpId &&
+          isValidBase64Url(encodedResponse.id)
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: serverRpId,
+              credentialId: encodedResponse.id,
+            });
+          } catch (sigErr) {
+            console.warn('SignalUnknownCredential sync warning:', sigErr);
+          }
+        }
+        setStatusMessage({
+          type: 'error',
+          text: 'Network error while verifying new passkey.',
+        });
+      }
+    } finally {
+      setCreatingPasskey(false);
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Page Header */}
+      <div className="border-b border-gray-300 pb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-gray-500">
+            Reader Account Settings
+          </p>
+          <h1 className="text-3xl font-bold text-gray-900 mt-1">
+            Account &amp; Security
+          </h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as{' '}
+            <span className="font-semibold text-gray-900">
+              {user.displayName}
+            </span>{' '}
+            ({user.name}) &middot;{' '}
+            <span className="text-amber-700 font-medium">
+              {user.subscriptionTier}
+            </span>
+          </p>
+        </div>
+        <div className="flex items-center gap-2 text-xs text-gray-600 bg-gray-50 border border-gray-200 px-3 py-2 rounded-md">
+          <span className="inline-block w-2 h-2 rounded-full bg-green-600"></span>
+          <span>Authenticator Sync Active ({rpId})</span>
+        </div>
+      </div>
+
+      {/* Status Alert */}
+      {statusMessage && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`p-4 rounded-lg border text-sm flex items-start justify-between gap-3 ${
+            statusMessage.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-amber-50 border-amber-200 text-amber-900'
+          }`}
+        >
+          <span>{statusMessage.text}</span>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="text-xs font-semibold underline hover:opacity-80"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Passkey Management Section */}
+      <section
+        aria-labelledby="passkey-management-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-xs overflow-hidden"
+      >
+        <div className="p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+          <div>
+            <h2
+              id="passkey-management-heading"
+              className="text-xl font-bold text-gray-900"
+            >
+              Registered Passkeys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1">
+              View your registered passkeys, update their display names, or
+              remove keys you no longer use. Changes automatically stay in sync
+              with your browser authenticator and password manager.
+            </p>
+          </div>
+
+          <div>
+            <button
+              id="create-passkey"
+              type="button"
+              hidden={!passkeySupported}
+              disabled={creatingPasskey || !passkeySupported}
+              onClick={handleCreatePasskey}
+              className="inline-flex items-center gap-2 px-4 py-2.5 bg-gray-900 text-white text-sm font-semibold rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 cursor-pointer whitespace-nowrap"
+            >
+              <svg
+                className="w-4 h-4 text-amber-400"
+                fill="none"
+                stroke="currentColor"
+                viewBox="0 0 24 24"
+                aria-hidden="true"
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                />
+              </svg>
+              {creatingPasskey ? 'Registering...' : 'Create passkey'}
+            </button>
+            {!passkeySupported && (
+              <p className="text-xs text-gray-600 bg-gray-100 px-3 py-2 rounded">
+                Passkeys are not supported on this device. Please configure
+                standard multi-factor authentication (MFA) instead.
+              </p>
+            )}
+          </div>
+        </div>
+
+        {/* Passkey List */}
+        <div className="divide-y divide-gray-200">
+          {loading ? (
+            <div className="p-8 text-center text-sm text-gray-500">
+              Loading registered passkeys...
+            </div>
+          ) : credentials.length === 0 ? (
+            <div
+              data-testid="empty-passkeys-state"
+              className="p-10 text-center space-y-2"
+            >
+              <p className="text-base font-semibold text-gray-800">
+                No passkeys found
+              </p>
+              <p className="text-sm text-gray-600 max-w-md mx-auto">
+                You don&apos;t have any active passkeys registered to your
+                DevTools Times account. Create a passkey for faster,
+                phishing-resistant sign-in.
+              </p>
+            </div>
+          ) : (
+            <ul
+              aria-label="Registered passkeys"
+              className="divide-y divide-gray-200"
+            >
+              {credentials.map((cred) => {
+                const { providerName, providerIcon } = getProviderDetails(cred);
+                const isEditing = editingCredentialId === cred.id;
+                const isDeleting = deletingId === cred.id;
+                const isRenaming = renamingId === cred.id;
+
+                return (
+                  <li
+                    key={cred.id}
+                    data-credential-id={cred.id}
+                    className="p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 hover:bg-gray-50/60 transition-colors"
+                  >
+                    <div className="flex items-start gap-4 min-w-0 flex-1">
+                      {/* Provider Icon */}
+                      <div className="w-11 h-11 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0 overflow-hidden">
