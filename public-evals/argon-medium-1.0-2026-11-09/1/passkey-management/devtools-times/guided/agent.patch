@@ -0,0 +1,49 @@
+import type { APIRoute } from 'astro';
+import { db, RP_ID } from '../../utils/passkeyStore';
+
+export const GET: APIRoute = async () => {
+  const user = db.getUser();
+  return new Response(
+    JSON.stringify({
+      ...user,
+      rpId: RP_ID,
+      userId: user.passkeyUserId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const PUT: APIRoute = async ({ request }) => {
+  const user = db.getUser();
+  const body = await request.json().catch(() => ({}));
+  const name = typeof body.name === 'string' ? body.name.trim() : user.name;
+  const displayName =
+    typeof body.displayName === 'string' ? body.displayName.trim() : user.displayName;
+
+  if (!name || !displayName) {
+    return new Response(
+      JSON.stringify({ error: 'Both username and display name are required.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  const updatedUser = db.updateUser(user.id, { name, displayName });
+
+  return new Response(
+    JSON.stringify({
+      ...updatedUser,
+      rpId: RP_ID,
+      userId: updatedUser.passkeyUserId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
