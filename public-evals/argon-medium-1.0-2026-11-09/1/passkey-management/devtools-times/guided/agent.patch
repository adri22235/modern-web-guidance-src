@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import type { AuthenticatorTransportFuture } from '@simplewebauthn/server';
+import { db, RP_ID, RP_NAME } from '../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request }) => {
+  const user = db.getUser();
+  const existingCredentials = db.findCredentialsByUserId(user.passkeyUserId);
+
+  const body = await request.json().catch(() => ({}));
+  const isPromotionFlow = Boolean(body?.promotion);
+
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID: RP_ID,
+    userID: Buffer.from(user.passkeyUserId, 'base64url'),
+    userName: user.name,
+    userDisplayName: user.displayName,
+    supportedAlgorithmIDs: [-7, -257],
+    excludeCredentials: existingCredentials.map((cred) => ({
+      id: cred.id,
+      transports: cred.transports as AuthenticatorTransportFuture[],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'preferred',
+      ...(isPromotionFlow ? { authenticatorAttachment: 'platform' } : {}),
+    },
+  });
+
+  db.setChallenge(user.passkeyUserId, options.challenge);
+
+  return new Response(JSON.stringify(options), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/passkey/register-verify.ts b/src/pages/api/passkey/register-verify.ts
new file mode 100644
index 0000000..676c025
--- /dev/null
+++ b/src/pages/api/passkey/register-verify.ts
@@ -0,0 +1,115 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  db,
+  RP_ID,
+  resolveAaguidProvider,
+  type StoredPasskeyCredential,
+} from '../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request }) => {
+  const user = db.getUser();
+  const expectedChallenge = db.getChallenge(user.passkeyUserId);
+
+  if (!expectedChallenge) {
+    return new Response(
+      JSON.stringify({ error: 'Registration challenge expired or not found.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  const body = await request.json().catch(() => null);
+  if (!body) {
+    return new Response(JSON.stringify({ error: 'Invalid registration payload.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  try {
+    const originHeader = request.headers.get('origin') || `http://${RP_ID}`;
+    const verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin: originHeader,
+      expectedRPID: RP_ID,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey registration verification failed.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const { registrationInfo } = verification;
+    const {
+      aaguid,
+      credential,
+      credentialDeviceType,
+      credentialBackedUp,
+    } = registrationInfo;
+
+    const now = Date.now();
+    let credentialName = 'Unknown passkey provider';
+    let providerIcon: string | undefined = undefined;
+
+    if (aaguid === '00000000-0000-0000-0000-000000000000') {
+      credentialName = 'Unknown passkey provider';
+      providerIcon = undefined;
+    } else {
+      const providerMeta = resolveAaguidProvider(aaguid);
+      credentialName = providerMeta.name;
+      providerIcon = providerMeta.providerIcon;
+    }
+
+    const newCred: StoredPasskeyCredential = {
+      id: credential.id,
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon,
+      name: credentialName,
+      transports: credential.transports || ['internal'],
+      registeredAt: now,
+      counter: credential.counter,
+    };
+
+    const saved = db.saveCredential(newCred);
+    const credentials = db.findCredentialsByUserId(user.passkeyUserId);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credential: saved,
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+        credentials,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({
+        error: err?.message || 'Verification failed.',
+      }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
diff --git a/src/pages/api/user.ts b/src/pages/api/user.ts
