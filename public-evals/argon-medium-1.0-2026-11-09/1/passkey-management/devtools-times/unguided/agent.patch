+                        : 'Signal Dispatched'}
+                    </span>
+                    <span className="text-gray-400">{entry.timestamp}</span>
+                  </div>
+                </div>
+                <p className="text-gray-700 mb-1.5">{entry.summary}</p>
+                <pre className="bg-gray-50 border border-gray-100 rounded p-2 text-[11px] font-mono text-gray-600 overflow-x-auto">
+                  {JSON.stringify(entry.payload, null, 2)}
+                </pre>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+    </div>
+  );
+}
