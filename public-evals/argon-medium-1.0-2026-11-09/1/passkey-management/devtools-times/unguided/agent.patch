+                    {entry.method}()
+                  </code>
+                  <div className="flex items-center space-x-2">
+                    <span
+                      className={`px-2 py-0.5 rounded font-semibold uppercase tracking-wider text-[10px] ${
+                        entry.status === 'synced'
+                          ? 'bg-green-100 text-green-800'
