--- /dev/null
+++ b/src/pages/api/passkeys.ts
@@ -0,0 +1,239 @@
+import type { APIRoute } from 'astro';
+import {
+  bytesToBase64Url,
+  createInitialAccountState,
+  getAccountState,
+  setAccountState,
+  type RegisteredPasskey,
+} from '../../utils/passkeyStore';
+
+function jsonResponse(payload: unknown, status = 200) {
+  return new Response(JSON.stringify(payload), {
+    status,
+    headers: {
+      'Content-Type': 'application/json',
+    },
+  });
+}
+
+function generateBase64UrlCredentialId(): string {
+  const bytes = new Uint8Array(32);
+  if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+    crypto.getRandomValues(bytes);
+  } else {
+    for (let i = 0; i < bytes.length; i++) {
+      bytes[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  return bytesToBase64Url(bytes);
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const state = await getAccountState(session);
+  return jsonResponse({
+    user: state.user,
+    passkeys: state.passkeys,
+    allAcceptedCredentialIds: state.passkeys.map((pk) => pk.credentialId),
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const state = await getAccountState(session);
+  const action = body.action || 'register';
+
+  if (action === 'reset') {
+    const fresh = createInitialAccountState();
+    await setAccountState(session, fresh);
+    return jsonResponse({
+      user: fresh.user,
+      passkeys: fresh.passkeys,
+      allAcceptedCredentialIds: fresh.passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  if (action === 'remove' || action === 'delete') {
+    const targetId = body.credentialId || body.id;
+    if (!targetId) {
+      return jsonResponse({ error: 'credentialId or id is required' }, 400);
+    }
+    const targetKey = state.passkeys.find(
+      (pk) => pk.credentialId === targetId || pk.id === targetId
+    );
+    const removedCredentialId = targetKey ? targetKey.credentialId : targetId;
+    const updatedPasskeys = state.passkeys.filter(
+      (pk) => pk.credentialId !== targetId && pk.id !== targetId
+    );
+    const nextState = {
+      ...state,
+      passkeys: updatedPasskeys,
+    };
+    await setAccountState(session, nextState);
+    return jsonResponse({
+      user: nextState.user,
+      passkeys: nextState.passkeys,
+      removedCredentialId,
+      allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  if (action === 'rename' || action === 'update-passkey') {
+    const targetId = body.credentialId || body.id;
+    const displayName = (body.displayName ?? body.name ?? '').trim();
+    if (!targetId || !displayName) {
+      return jsonResponse({ error: 'credentialId and displayName are required' }, 400);
+    }
+    const updatedPasskeys = state.passkeys.map((pk) =>
+      pk.credentialId === targetId || pk.id === targetId
+        ? { ...pk, displayName }
+        : pk
+    );
+    const nextState = {
+      ...state,
+      passkeys: updatedPasskeys,
+    };
+    await setAccountState(session, nextState);
+    return jsonResponse({
+      user: nextState.user,
+      passkeys: nextState.passkeys,
+      allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  if (action === 'update-user') {
+    const displayName = (body.displayName ?? state.user.displayName).trim();
+    const username = (body.username ?? body.name ?? state.user.username).trim();
+    if (!displayName) {
+      return jsonResponse({ error: 'displayName cannot be empty' }, 400);
+    }
+    const nextState = {
+      ...state,
+      user: {
+        ...state.user,
+        displayName,
+        username: username || state.user.username,
+      },
+    };
+    await setAccountState(session, nextState);
+    return jsonResponse({
+      user: nextState.user,
+      passkeys: nextState.passkeys,
+      allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  // Default: register / add a new passkey
+  const nowIso = new Date().toISOString();
+  const newPasskey: RegisteredPasskey = {
+    id: `pk-${Date.now()}`,
+    credentialId: body.credentialId || generateBase64UrlCredentialId(),
+    displayName: (body.displayName || 'This Browser Authenticator').trim(),
+    authenticatorName: body.authenticatorName || 'Platform Passkey Provider',
+    deviceType: body.deviceType === 'singleDevice' ? 'singleDevice' : 'multiDevice',
+    backedUp: body.backedUp ?? true,
+    transports: Array.isArray(body.transports) && body.transports.length > 0
+      ? body.transports
+      : ['internal', 'hybrid'],
+    createdAt: nowIso,
+    lastUsedAt: nowIso,
+  };
+
+  const nextState = {
+    ...state,
+    passkeys: [newPasskey, ...state.passkeys],
+  };
+  await setAccountState(session, nextState);
+
+  return jsonResponse({
+    user: nextState.user,
+    passkeys: nextState.passkeys,
+    createdPasskey: newPasskey,
+    allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+  });
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const state = await getAccountState(session);
+
+  const targetId = body.credentialId || body.id;
+  if (targetId) {
+    const displayName = (body.displayName ?? body.name ?? '').trim();
+    if (!displayName) {
+      return jsonResponse({ error: 'displayName cannot be empty' }, 400);
+    }
+    const updatedPasskeys = state.passkeys.map((pk) =>
+      pk.credentialId === targetId || pk.id === targetId
+        ? { ...pk, displayName }
+        : pk
+    );
+    const nextState = {
+      ...state,
+      passkeys: updatedPasskeys,
+    };
+    await setAccountState(session, nextState);
+    return jsonResponse({
+      user: nextState.user,
+      passkeys: nextState.passkeys,
+      allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+    });
+  }
+
+  // Otherwise update the signed-in reader's user details
+  const displayName = (body.displayName ?? state.user.displayName).trim();
+  const username = (body.username ?? body.name ?? state.user.username).trim();
+  if (!displayName) {
+    return jsonResponse({ error: 'displayName cannot be empty' }, 400);
+  }
+  const nextState = {
+    ...state,
+    user: {
+      ...state.user,
+      displayName,
+      username: username || state.user.username,
+    },
+  };
+  await setAccountState(session, nextState);
+  return jsonResponse({
+    user: nextState.user,
+    passkeys: nextState.passkeys,
+    allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+  });
+};
+
+export const PUT: APIRoute = PATCH;
+
+export const DELETE: APIRoute = async ({ request, url, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const targetId =
+    body.credentialId ||
+    body.id ||
+    url.searchParams.get('credentialId') ||
+    url.searchParams.get('id');
+
+  if (!targetId) {
+    return jsonResponse({ error: 'credentialId or id is required' }, 400);
+  }
+
+  const state = await getAccountState(session);
+  const targetKey = state.passkeys.find(
+    (pk) => pk.credentialId === targetId || pk.id === targetId
+  );
+  const removedCredentialId = targetKey ? targetKey.credentialId : targetId;
+  const updatedPasskeys = state.passkeys.filter(
+    (pk) => pk.credentialId !== targetId && pk.id !== targetId
+  );
+
+  const nextState = {
+    ...state,
+    passkeys: updatedPasskeys,
+  };
+  await setAccountState(session, nextState);
+
+  return jsonResponse({
+    user: nextState.user,
+    passkeys: nextState.passkeys,
+    removedCredentialId,
+    allAcceptedCredentialIds: nextState.passkeys.map((pk) => pk.credentialId),
+  });
+};
