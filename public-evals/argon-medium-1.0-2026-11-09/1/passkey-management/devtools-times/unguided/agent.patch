+        });
+      }
+    } catch {
+      setPasskeys(DEFAULT_PASSKEYS);
+    }
+  };
+
+  const formatDate = (isoString: string) => {
+    try {
+      return new Date(isoString).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
+      });
+    } catch {
+      return isoString;
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
+      {/* Page Title & Reader Status Header */}
+      <div className="border-b-2 border-gray-900 pb-6 mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">
+            Subscriber Account Settings
+          </p>
+          <h1 className="text-3xl sm:text-4xl font-bold text-gray-900">
+            Account &amp; Passkey Management
+          </h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Manage your reader identity, registered passkeys, and browser authenticator synchronization.
+          </p>
+        </div>
+
+        <div className="bg-gray-50 border border-gray-200 rounded-md px-4 py-3 text-xs">
+          <div className="flex items-center space-x-2">
+            <span className="inline-block w-2.5 h-2.5 rounded-full bg-green-600"></span>
+            <span className="font-semibold text-gray-900">Signed in as {user.displayName}</span>
+          </div>
+          <p className="text-gray-600 mt-0.5">{user.username}</p>
+          <p className="text-gray-500 mt-0.5">{user.subscriptionTier}</p>
+        </div>
+      </div>
+
+      {/* Feedback Alert Banner */}
+      {statusMessage && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`mb-6 p-4 rounded-md border text-sm flex items-start justify-between ${
+            statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : statusMessage.type === 'info'
+              ? 'bg-blue-50 border-blue-200 text-blue-800'
+              : 'bg-green-50 border-green-200 text-green-800'
+          }`}
+        >
+          <span>{statusMessage.text}</span>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="ml-4 text-xs font-semibold underline hover:opacity-80"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Section 1: Reader Identity & Authenticator Display Name */}
+      <section
+        aria-labelledby="reader-profile-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-xs p-6 mb-8"
+      >
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 mb-5 border-b border-gray-200">
+          <div>
+            <h2
+              id="reader-profile-heading"
