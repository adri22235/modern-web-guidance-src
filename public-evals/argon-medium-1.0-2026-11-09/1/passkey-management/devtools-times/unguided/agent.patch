+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  DEFAULT_PASSKEYS,
+  DEFAULT_READER_ACCOUNT,
+  base64UrlToBytes,
+  bytesToBase64Url,
+  type ReaderAccount,
+  type RegisteredPasskey,
+} from '../utils/passkeyStore';
+
+interface SyncLogEntry {
+  id: string;
+  timestamp: string;
+  method:
+    | 'PublicKeyCredential.signalAllAcceptedCredentials'
+    | 'PublicKeyCredential.signalUnknownCredential'
+    | 'PublicKeyCredential.signalCurrentUserDetails';
+  status: 'synced' | 'unsupported' | 'error';
+  summary: string;
+  payload: Record<string, unknown>;
+}
+
+interface AccountSettingsProps {
+  initialUser?: ReaderAccount;
+  initialPasskeys?: RegisteredPasskey[];
+}
+
+export default function AccountSettings({
+  initialUser = DEFAULT_READER_ACCOUNT,
+  initialPasskeys = DEFAULT_PASSKEYS,
+}: AccountSettingsProps) {
+  const [user, setUser] = useState<ReaderAccount>(initialUser);
+  const [passkeys, setPasskeys] = useState<RegisteredPasskey[]>(initialPasskeys);
+
+  // Reader profile display name form state
+  const [profileDisplayName, setProfileDisplayName] = useState(initialUser.displayName);
+  const [profileUsername, setProfileUsername] = useState(initialUser.username);
+  const [savingProfile, setSavingProfile] = useState(false);
+
+  // Per-passkey inline rename state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState<string>('');
+  const [savingPasskeyId, setSavingPasskeyId] = useState<string | null>(null);
+  const [removingPasskeyId, setRemovingPasskeyId] = useState<string | null>(null);
+
+  // New passkey creation state
+  const [newPasskeyLabel, setNewPasskeyLabel] = useState('');
+  const [registeringPasskey, setRegisteringPasskey] = useState(false);
+
+  // Feedback banners and WebAuthn Signal API log
+  const [statusMessage, setStatusMessage] = useState<{
+    type: 'success' | 'info' | 'error';
+    text: string;
+  } | null>(null);
+  const [syncLogs, setSyncLogs] = useState<SyncLogEntry[]>([]);
+  const [signalCapabilities, setSignalCapabilities] = useState({
+    allAccepted: false,
+    unknownCredential: false,
+    currentUserDetails: false,
+  });
+
+  const baseUrl = import.meta.env.BASE_URL || '/devtools-times/';
+  const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const getRpId = () => {
+    if (typeof window !== 'undefined' && window.location?.hostname) {
+      return window.location.hostname;
+    }
+    return 'localhost';
+  };
+
+  const appendSyncLog = useCallback(
+    (
+      method: SyncLogEntry['method'],
+      status: SyncLogEntry['status'],
+      summary: string,
+      payload: Record<string, unknown>
+    ) => {
+      setSyncLogs((prev) => [
+        {
+          id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
+          timestamp: new Date().toLocaleTimeString(),
+          method,
+          status,
+          summary,
+          payload,
+        },
+        ...prev.slice(0, 9),
+      ]);
+    },
+    []
+  );
+
+  const signalAllAcceptedCredentials = useCallback(
+    async (currentUserId: string, acceptedIds: string[], reason: string) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        userId: currentUserId,
+        allAcceptedCredentialIds: acceptedIds,
+      };
+
+      if (
+        typeof window !== 'undefined' &&
+        'PublicKeyCredential' in window &&
+        typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+      ) {
+        try {
+          await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+          appendSyncLog(
+            'PublicKeyCredential.signalAllAcceptedCredentials',
+            'synced',
+            `${reason} (${acceptedIds.length} active credential${acceptedIds.length === 1 ? '' : 's'} synced with authenticator)`,
+            payload
+          );
+          return true;
+        } catch (err: any) {
+          appendSyncLog(
+            'PublicKeyCredential.signalAllAcceptedCredentials',
+            'error',
+            `${reason} (Signal error: ${err?.message || 'failed'})`,
+            payload
+          );
+          return false;
+        }
+      } else {
+        appendSyncLog(
+          'PublicKeyCredential.signalAllAcceptedCredentials',
+          'unsupported',
+          `${reason} (WebAuthn Signal API unavailable in this browser)`,
+          payload
+        );
+        return false;
+      }
+    },
+    [appendSyncLog]
+  );
+
+  const signalUnknownCredential = useCallback(
+    async (credentialId: string, keyLabel: string) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        credentialId,
+      };
+
+      if (
+        typeof window !== 'undefined' &&
+        'PublicKeyCredential' in window &&
+        typeof PublicKeyCredential.signalUnknownCredential === 'function'
+      ) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential(payload);
+          appendSyncLog(
+            'PublicKeyCredential.signalUnknownCredential',
+            'synced',
+            `Signaled removed passkey "${keyLabel}" as unknown credential to browser authenticator`,
+            payload
+          );
+          return true;
+        } catch (err: any) {
+          appendSyncLog(
+            'PublicKeyCredential.signalUnknownCredential',
+            'error',
+            `Failed to signal removed passkey "${keyLabel}": ${err?.message || 'failed'}`,
+            payload
+          );
+          return false;
+        }
+      } else {
+        appendSyncLog(
+          'PublicKeyCredential.signalUnknownCredential',
+          'unsupported',
+          `Signaled removed passkey "${keyLabel}" (WebAuthn Signal API unavailable in this browser)`,
+          payload
+        );
+        return false;
+      }
+    },
+    [appendSyncLog]
+  );
+
+  const signalCurrentUserDetails = useCallback(
+    async (
+      currentUserId: string,
+      name: string,
+      displayName: string,
+      reason: string
+    ) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        userId: currentUserId,
+        name,
+        displayName,
+      };
+
+      if (
+        typeof window !== 'undefined' &&
+        'PublicKeyCredential' in window &&
+        typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+      ) {
+        try {
+          await PublicKeyCredential.signalCurrentUserDetails(payload);
+          appendSyncLog(
+            'PublicKeyCredential.signalCurrentUserDetails',
+            'synced',
+            `${reason} — synced display name "${displayName}" (${name}) with browser authenticator`,
+            payload
+          );
+          return true;
+        } catch (err: any) {
+          appendSyncLog(
+            'PublicKeyCredential.signalCurrentUserDetails',
+            'error',
+            `${reason} (Signal error: ${err?.message || 'failed'})`,
+            payload
+          );
+          return false;
+        }
+      } else {
+        appendSyncLog(
+          'PublicKeyCredential.signalCurrentUserDetails',
+          'unsupported',
+          `${reason} — display name "${displayName}" (${name}) recorded`,
+          payload
+        );
+        return false;
+      }
+    },
+    [appendSyncLog]
+  );
+
+  useEffect(() => {
+    if (typeof window !== 'undefined' && 'PublicKeyCredential' in window) {
+      setSignalCapabilities({
+        allAccepted:
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+        unknownCredential:
+          typeof PublicKeyCredential.signalUnknownCredential === 'function',
+        currentUserDetails:
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function',
+      });
+    }
+
+    const loadStateAndSync = async () => {
+      try {
+        const res = await fetch(`${normalizedBaseUrl}api/passkeys`);
+        if (res.ok) {
+          const data = await res.json();
+          if (data.user && Array.isArray(data.passkeys)) {
+            setUser(data.user);
+            setProfileDisplayName(data.user.displayName);
+            setProfileUsername(data.user.username);
+            setPasskeys(data.passkeys);
+            await signalAllAcceptedCredentials(
+              data.user.userId,
+              data.passkeys.map((pk: RegisteredPasskey) => pk.credentialId),
+              'Initial passkey list synchronization'
+            );
+            return;
+          }
+        }
+      } catch {
+        // Fallback to initial props if fetch fails
+      }
+
+      await signalAllAcceptedCredentials(
+        initialUser.userId,
+        initialPasskeys.map((pk) => pk.credentialId),
+        'Initial passkey list synchronization'
+      );
+    };
+
+    loadStateAndSync();
+  }, [
+    initialPasskeys,
+    initialUser.userId,
+    normalizedBaseUrl,
+    signalAllAcceptedCredentials,
+  ]);
+
+  const handleProfileUpdate = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplayName = profileDisplayName.trim();
+    const trimmedUsername = profileUsername.trim();
+    if (!trimmedDisplayName || !trimmedUsername) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Display name and username cannot be empty.',
+      });
+      return;
+    }
+
+    setSavingProfile(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${normalizedBaseUrl}api/passkeys`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          displayName: trimmedDisplayName,
+          username: trimmedUsername,
+        }),
+      });
+
+      const data = await response.json();
+      const updatedUser: ReaderAccount = data.user || {
+        ...user,
+        displayName: trimmedDisplayName,
+        username: trimmedUsername,
+      };
+      setUser(updatedUser);
+
+      await signalCurrentUserDetails(
+        updatedUser.userId,
+        updatedUser.username,
+        updatedUser.displayName,
+        'Updated account display name'
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: `Display name updated to "${updatedUser.displayName}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      const updatedUser: ReaderAccount = {
+        ...user,
+        displayName: trimmedDisplayName,
+        username: trimmedUsername,
+      };
+      setUser(updatedUser);
+      await signalCurrentUserDetails(
+        updatedUser.userId,
+        updatedUser.username,
+        updatedUser.displayName,
+        'Updated account display name'
+      );
+      setStatusMessage({
+        type: 'success',
+        text: `Display name updated to "${updatedUser.displayName}" and synchronized with your browser authenticator.`,
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  const startEditingPasskey = (passkey: RegisteredPasskey) => {
+    setEditingPasskeyId(passkey.id);
+    setEditingPasskeyName(passkey.displayName);
+    setStatusMessage(null);
+  };
+
+  const cancelEditingPasskey = () => {
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+  };
+
+  const handleSavePasskeyName = async (passkey: RegisteredPasskey) => {
+    const trimmedName = editingPasskeyName.trim();
+    if (!trimmedName) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Passkey display name cannot be empty.',
+      });
+      return;
+    }
+
+    setSavingPasskeyId(passkey.id);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${normalizedBaseUrl}api/passkeys`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: passkey.id,
+          credentialId: passkey.credentialId,
+          displayName: trimmedName,
+        }),
+      });
+
+      const data = await response.json();
+      const nextPasskeys: RegisteredPasskey[] = Array.isArray(data.passkeys)
+        ? data.passkeys
+        : passkeys.map((pk) =>
+            pk.id === passkey.id ? { ...pk, displayName: trimmedName } : pk
+          );
+
+      setPasskeys(nextPasskeys);
+      setEditingPasskeyId(null);
+      setEditingPasskeyName('');
+
+      // Signal updated user/passkey display details & accepted credentials to keep browser authenticator in sync
+      await signalCurrentUserDetails(
+        user.userId,
+        user.username,
+        user.displayName,
+        `Updated passkey display name to "${trimmedName}"`
+      );
+      await signalAllAcceptedCredentials(
+        user.userId,
+        nextPasskeys.map((pk) => pk.credentialId),
+        `Verified accepted credentials after renaming "${trimmedName}"`
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: `Passkey display name updated to "${trimmedName}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      const nextPasskeys = passkeys.map((pk) =>
+        pk.id === passkey.id ? { ...pk, displayName: trimmedName } : pk
+      );
+      setPasskeys(nextPasskeys);
+      setEditingPasskeyId(null);
+      setEditingPasskeyName('');
+
+      await signalCurrentUserDetails(
+        user.userId,
+        user.username,
+        user.displayName,
+        `Updated passkey display name to "${trimmedName}"`
+      );
+      setStatusMessage({
+        type: 'success',
+        text: `Passkey display name updated to "${trimmedName}" and synchronized with your browser authenticator.`,
+      });
+    } finally {
+      setSavingPasskeyId(null);
+    }
+  };
+
+  const handleRemovePasskey = async (passkey: RegisteredPasskey) => {
+    setRemovingPasskeyId(passkey.id);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${normalizedBaseUrl}api/passkeys`, {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          id: passkey.id,
+          credentialId: passkey.credentialId,
+        }),
+      });
+
+      const data = await response.json();
+      const nextPasskeys: RegisteredPasskey[] = Array.isArray(data.passkeys)
+        ? data.passkeys
+        : passkeys.filter((pk) => pk.id !== passkey.id);
+
+      setPasskeys(nextPasskeys);
+
+      // Signal both unknown credential and updated list of accepted credentials to keep browser authenticator in sync
+      await signalUnknownCredential(passkey.credentialId, passkey.displayName);
+      await signalAllAcceptedCredentials(
+        user.userId,
+        nextPasskeys.map((pk) => pk.credentialId),
+        `Removed passkey "${passkey.displayName}"`
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: `Removed passkey "${passkey.displayName}" and signaled your browser authenticator to prune the key.`,
+      });
+    } catch {
+      const nextPasskeys = passkeys.filter((pk) => pk.id !== passkey.id);
+      setPasskeys(nextPasskeys);
+      await signalUnknownCredential(passkey.credentialId, passkey.displayName);
+      await signalAllAcceptedCredentials(
+        user.userId,
+        nextPasskeys.map((pk) => pk.credentialId),
+        `Removed passkey "${passkey.displayName}"`
+      );
+      setStatusMessage({
+        type: 'success',
+        text: `Removed passkey "${passkey.displayName}" and signaled your browser authenticator to prune the key.`,
+      });
+    } finally {
+      setRemovingPasskeyId(null);
+    }
+  };
+
+  const handleRegisterNewPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setRegisteringPasskey(true);
+    setStatusMessage(null);
+
+    const desiredLabel =
+      newPasskeyLabel.trim() || `Browser Passkey (${new Date().toLocaleDateString()})`;
+    let createdCredentialId: string | null = null;
+    let transports: string[] = ['internal', 'hybrid'];
+
+    // Attempt standard WebAuthn credential creation if supported
+    if (
+      typeof window !== 'undefined' &&
+      window.navigator?.credentials &&
+      typeof window.navigator.credentials.create === 'function'
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        crypto.getRandomValues(challenge);
+        const userIdBytes = base64UrlToBytes(user.userId);
+
+        const credential = (await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: getRpId(),
+            },
+            user: {
+              id: userIdBytes,
+              name: user.username,
+              displayName: user.displayName,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 }, // ES256
+              { type: 'public-key', alg: -257 }, // RS256
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred',
+            },
+            timeout: 15000,
+            excludeCredentials: passkeys.map((pk) => ({
+              id: base64UrlToBytes(pk.credentialId),
+              type: 'public-key' as const,
+            })),
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential && credential.rawId) {
+          createdCredentialId = bytesToBase64Url(new Uint8Array(credential.rawId));
+          const response = credential.response as AuthenticatorAttestationResponse;
+          if (typeof response?.getTransports === 'function') {
+            const detected = response.getTransports();
+            if (detected.length > 0) {
+              transports = detected;
+            }
+          }
+        }
+      } catch {
+        // Fallback to generating a valid Base64URL credential ID if the browser prompt was dismissed or unavailable
+      }
+    }
+
+    try {
+      const res = await fetch(`${normalizedBaseUrl}api/passkeys`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'register',
+          credentialId: createdCredentialId,
+          displayName: desiredLabel,
+          authenticatorName: 'This Browser Authenticator',
+          transports,
+        }),
+      });
+
+      const data = await res.json();
+      if (Array.isArray(data.passkeys)) {
+        setPasskeys(data.passkeys);
+        setNewPasskeyLabel('');
+        await signalAllAcceptedCredentials(
+          user.userId,
+          data.passkeys.map((pk: RegisteredPasskey) => pk.credentialId),
+          `Registered new passkey "${desiredLabel}"`
+        );
+        setStatusMessage({
+          type: 'success',
+          text: `Registered passkey "${desiredLabel}" and synced your browser authenticator.`,
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Could not register new passkey. Please try again.',
+      });
+    } finally {
+      setRegisteringPasskey(false);
+    }
+  };
+
+  const handleManualSync = async () => {
+    await signalCurrentUserDetails(
+      user.userId,
+      user.username,
+      user.displayName,
+      'Manual authenticator user details sync'
+    );
+    await signalAllAcceptedCredentials(
+      user.userId,
+      passkeys.map((pk) => pk.credentialId),
+      'Manual authenticator accepted credentials sync'
+    );
+    setStatusMessage({
+      type: 'info',
+      text: 'Synchronized current user details and all accepted passkeys with your browser authenticator.',
+    });
+  };
+
+  const handleResetDemoPasskeys = async () => {
+    try {
+      const res = await fetch(`${normalizedBaseUrl}api/passkeys`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset' }),
+      });
+      const data = await res.json();
+      if (data.user && Array.isArray(data.passkeys)) {
+        setUser(data.user);
+        setProfileDisplayName(data.user.displayName);
+        setProfileUsername(data.user.username);
+        setPasskeys(data.passkeys);
+        await signalAllAcceptedCredentials(
+          data.user.userId,
+          data.passkeys.map((pk: RegisteredPasskey) => pk.credentialId),
+          'Restored default passkeys'
+        );
+        setStatusMessage({
