+export interface ReaderAccount {
+  userId: string; // Base64URL-encoded user handle
+  username: string; // User's login name / email (WebAuthn `name`)
+  displayName: string; // User's friendly display name (WebAuthn `displayName`)
+  subscriptionTier: string;
+  memberSince: string;
+}
+
+export interface RegisteredPasskey {
+  id: string;
+  credentialId: string; // Base64URL-encoded credential ID
+  displayName: string; // User-editable friendly name for the passkey
+  authenticatorName: string; // Provider/authenticator description
+  deviceType: 'multiDevice' | 'singleDevice';
+  backedUp: boolean;
+  transports: string[];
+  createdAt: string;
+  lastUsedAt: string;
+}
+
+export interface AccountPasskeyState {
+  user: ReaderAccount;
+  passkeys: RegisteredPasskey[];
+}
+
+export const DEFAULT_READER_ACCOUNT: ReaderAccount = {
+  // Base64URL encoding of "user-alex-rivera" (16 bytes -> 22 base64url chars, no padding)
+  userId: 'dXNlci1hbGV4LXJpdmVyYQ',
+  username: 'alex.rivera@devtoolstimes.dev',
+  displayName: 'Alex Rivera',
+  subscriptionTier: 'Digital All-Access Subscriber',
+  memberSince: 'March 2024',
+};
+
+export const DEFAULT_PASSKEYS: RegisteredPasskey[] = [
+  {
+    id: 'pk-1',
+    // Base64URL encoding of "cred-macbook-pro-touchid-0000001" (32 bytes -> 43 base64url chars)
+    credentialId: 'Y3JlZC1tYWNib29rLXByby10b3VjaGlkLTAwMDAwMDE',
+    displayName: 'MacBook Pro (Chrome Profile)',
+    authenticatorName: 'Google Password Manager',
+    deviceType: 'multiDevice',
+    backedUp: true,
+    transports: ['internal', 'hybrid'],
+    createdAt: '2026-06-14T10:20:00Z',
+    lastUsedAt: '2026-11-09T21:15:00Z',
+  },
+  {
+    id: 'pk-2',
+    // Base64URL encoding of "cred-iphone-16-icloud-keychain02" (32 bytes -> 43 base64url chars)
+    credentialId: 'Y3JlZC1pcGhvbmUtMTYtaWNsb3VkLWtleWNoYWluMDI',
+    displayName: 'iPhone 16 Pro',
+    authenticatorName: 'iCloud Keychain',
+    deviceType: 'multiDevice',
+    backedUp: true,
+    transports: ['internal', 'hybrid'],
+    createdAt: '2026-08-03T16:42:00Z',
+    lastUsedAt: '2026-11-07T08:30:00Z',
+  },
+  {
+    id: 'pk-3',
+    // Base64URL encoding of "cred-yubikey-5c-nfc-hardware-003" (32 bytes -> 43 base64url chars)
+    credentialId: 'Y3JlZC15dWJpa2V5LTVjLW5mYy1oYXJkd2FyZS0wMDM',
+    displayName: 'YubiKey 5C NFC Backup',
+    authenticatorName: 'Yubico Security Key',
+    deviceType: 'singleDevice',
+    backedUp: false,
+    transports: ['usb', 'nfc'],
+    createdAt: '2026-04-19T14:05:00Z',
+    lastUsedAt: '2026-09-12T19:00:00Z',
+  },
+];
+
+let fallbackState: AccountPasskeyState = {
+  user: { ...DEFAULT_READER_ACCOUNT },
+  passkeys: DEFAULT_PASSKEYS.map((pk) => ({ ...pk })),
+};
+
+export function createInitialAccountState(): AccountPasskeyState {
+  return {
+    user: { ...DEFAULT_READER_ACCOUNT },
+    passkeys: DEFAULT_PASSKEYS.map((pk) => ({ ...pk })),
+  };
+}
+
+export async function getAccountState(session?: any): Promise<AccountPasskeyState> {
+  if (session) {
+    try {
+      const existing = await session.get('accountPasskeyState');
+      if (existing && existing.user && Array.isArray(existing.passkeys)) {
+        fallbackState = existing;
+        return existing;
+      }
+      await session.set('accountPasskeyState', fallbackState);
+    } catch {
+      // Fallback to in-memory state if session access fails
+    }
+  }
+  return fallbackState;
+}
+
+export async function setAccountState(
+  session: any,
+  newState: AccountPasskeyState
+): Promise<AccountPasskeyState> {
+  fallbackState = newState;
+  if (session) {
+    try {
+      await session.set('accountPasskeyState', newState);
+    } catch {
+      // Ignore session write errors and rely on fallbackState
+    }
+  }
+  return fallbackState;
+}
+
+export function bytesToBase64Url(bytes: Uint8Array): string {
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  const base64 =
+    typeof btoa === 'function'
+      ? btoa(binary)
+      : Buffer.from(bytes).toString('base64');
+  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
+}
+
+export function base64UrlToBytes(base64url: string): Uint8Array {
+  const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+  const padLen = (4 - (base64.length % 4)) % 4;
+  const padded = base64 + '='.repeat(padLen);
+  if (typeof atob === 'function') {
+    const binary = atob(padded);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+  }
+  return new Uint8Array(Buffer.from(padded, 'base64'));
+}
