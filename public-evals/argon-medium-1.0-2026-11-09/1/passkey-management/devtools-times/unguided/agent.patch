+              }`}
+            >
+              signalCurrentUserDetails
+            </span>
+          </div>
+        </div>
+
+        {syncLogs.length === 0 ? (
+          <p className="text-xs text-gray-500">
+            No authenticator signals dispatched yet in this session.
+          </p>
+        ) : (
+          <ul className="space-y-2.5 text-xs" data-testid="authenticator-sync-log">
+            {syncLogs.map((entry) => (
+              <li
+                key={entry.id}
