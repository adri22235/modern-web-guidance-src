+import crypto from 'node:crypto';
+import aaguids from './aaguids.json' with { type: 'json' };
+
+// Predefined server RP ID constant (must match registration rp.id)
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The Daily Grind Coffee Co.';
+
+export function createPasskeyRoutes(router, db, checkUserAuthenticated) {
+  router.get('/api/credentials', checkUserAuthenticated, async (req, res) => {
+    const credentials = await db.findCredentialsByUserId(req.user.id);
+    return res.json({
+      rpId: RP_ID,
+      userId: req.user.passkeyUserId, // Valid unpadded Base64URL string
+      credentials,
+    });
+  });
+
+  router.put('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const { name } = req.body;
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user.passkeyUserId) {
+      return res.status(404).json({ error: 'Credential not found.' });
+    }
+    cred.name = name;
+    await db.saveCredential(cred);
+    return res.json(cred);
+  });
+
+  router.delete('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user.passkeyUserId) {
+      return res.status(404).json({ error: 'Credential not found.' });
+    }
+    await db.deleteCredential(id);
+    return res.json({ success: true });
+  });
+
+  router.put('/api/user', checkUserAuthenticated, async (req, res) => {
+    const { name, displayName } = req.body;
+    const updatedUser = await db.updateUser(req.user.id, { name, displayName });
+    return res.json({
+      ...updatedUser,
+      rpId: RP_ID,
+      userId: updatedUser.passkeyUserId,
+    });
+  });
+
+  router.post('/api/register/options', checkUserAuthenticated, async (req, res) => {
+    const isPromotionFlow = Boolean(req.body?.promotion);
+    const userExistingCredentials = await db.findCredentialsByUserId(req.user.id);
+    const serverGeneratedBase64UrlChallenge = crypto.randomBytes(32).toString('base64url');
+    req.session.challenge = serverGeneratedBase64UrlChallenge;
+
+    const options = {
+      challenge: serverGeneratedBase64UrlChallenge,
+      rp: { id: RP_ID, name: RP_NAME },
+      user: {
+        id: req.user.passkeyUserId,
+        name: req.user.name,
+        displayName: req.user.displayName,
+      },
+      pubKeyCredParams: [
+        { type: 'public-key', alg: -7 },
+        { type: 'public-key', alg: -257 },
+      ],
+      excludeCredentials: userExistingCredentials.map((cred) => ({
+        type: 'public-key',
+        id: cred.id,
+        transports: cred.transports,
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        ...(isPromotionFlow && { authenticatorAttachment: 'platform' }),
+      },
+    };
+
+    return res.json(options);
+  });
+
+  router.post('/api/register/verify', checkUserAuthenticated, async (req, res) => {
+    const registrationInfo = await db.verifyRegistration(req.body, {
+      expectedChallenge: req.session.challenge,
+      expectedRPID: RP_ID,
+      requireUserVerification: false,
+    });
+
+    const { aaguid } = registrationInfo;
+    let name = 'Unknown passkey provider';
+    let providerIcon;
+    if (aaguid !== '00000000-0000-0000-0000-000000000000') {
+      const provider = aaguids[aaguid];
+      name = provider?.name || 'Unknown passkey provider';
+      providerIcon = provider?.icon_light;
+    }
+
+    const credential = {
+      id: registrationInfo.credentialID,
+      passkeyUserId: req.user.passkeyUserId,
+      credentialPublicKey: registrationInfo.credentialPublicKey,
+      credentialType: 'public-key',
+      credentialDeviceType: registrationInfo.credentialDeviceType,
+      credentialBackedUp: registrationInfo.credentialBackedUp,
+      aaguid,
+      providerIcon,
+      name,
+      transports: req.body.response?.transports || ['internal', 'hybrid'],
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+      counter: registrationInfo.counter || 0,
+    };
+
+    await db.saveCredential(credential);
+    return res.json({ verified: true, credential });
+  });
+}
