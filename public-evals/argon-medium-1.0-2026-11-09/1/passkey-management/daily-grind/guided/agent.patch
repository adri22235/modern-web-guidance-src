+  if (pathname.startsWith('/api/credential/') && method === 'DELETE') {
+    const id = decodeURIComponent(pathname.slice('/api/credential/'.length));
+    const credentials = loadCredentialsFromStore();
+    const index = credentials.findIndex((c) => c.id === id);
+    if (index === -1) {
+      return jsonResponse({ error: 'Credential not found.' }, 404);
+    }
+    credentials.splice(index, 1);
+    saveCredentialsToStore(credentials);
+    return jsonResponse({ success: true });
+  }
+
+  if (pathname === '/api/user' && method === 'PUT') {
+    const user = loadUserFromStore();
+    const updatedUser = {
+      ...user,
+      name: typeof body.name === 'string' && body.name.trim() ? body.name.trim() : user.name,
+      displayName:
+        typeof body.displayName === 'string' && body.displayName.trim()
+          ? body.displayName.trim()
+          : user.displayName,
+    };
