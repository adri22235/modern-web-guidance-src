+        ...(isPromotionFlow && { authenticatorAttachment: 'platform' }),
+      },
+    };
+    return jsonResponse(options);
+  }
+
+  if (pathname === '/api/register/verify' && method === 'POST') {
+    const user = loadUserFromStore();
+    const credentials = loadCredentialsFromStore();
+    const aaguid = body.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+    const meta = lookupAaguidMetadata(aaguid);
+    const now = Date.now();
+    const newCredential = {
+      id: body.id || generateBase64UrlChallenge(24),
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey:
+        body.response?.attestationObject ||
+        'pQECAyYgASFYIJV8dXNlci1wdWJsaWMta2V5LW5ldyJYIG5ldy1jcmVkLXB1YmxpYy1rZXk',
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
+      aaguid: meta.aaguid,
+      providerIcon: meta.providerIcon,
+      name: meta.name,
+      transports: body.response?.transports || ['internal', 'hybrid'],
+      registeredAt: now,
+      lastUsedAt: now,
+      counter: 0,
+    };
+    credentials.unshift(newCredential);
+    saveCredentialsToStore(credentials);
+    return jsonResponse({ verified: true, credential: newCredential });
+  }
+
+  return null;
+}
+
+// Install local API handler on window.fetch so static hosting handles /api/* without 404 console errors
+if (typeof window !== 'undefined' && typeof window.fetch === 'function') {
