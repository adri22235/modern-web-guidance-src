+import aaguids from './aaguids.json' with { type: 'json' };
+
+// Predefined server RP ID constant (must match registration rp.id; never derived from window.location.hostname)
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The Daily Grind Coffee Co.';
+
+const STORAGE_KEY_CREDENTIALS = 'daily_grind_passkey_credentials_v1';
+const STORAGE_KEY_USER = 'daily_grind_user_profile_v1';
+
+const DEFAULT_USER = {
+  id: 'user-daily-grind-01',
+  // Valid unpadded Base64URL string (Buffer.from('user-daily-grind-01').toString('base64url'))
+  passkeyUserId: 'dXNlci1kYWlseS1ncmluZC0wMQ',
+  name: 'alex.rivera@dailygrind.coffee',
+  displayName: 'Alex Rivera',
+};
+
+export function lookupAaguidMetadata(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      aaguid: '00000000-0000-0000-0000-000000000000',
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+      iconDark: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    aaguid,
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+    iconDark: provider?.icon_dark,
+  };
+}
+
+function createInitialCredentials() {
+  const googleMeta = lookupAaguidMetadata('ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4');
+  const icloudMeta = lookupAaguidMetadata('fbfc3007-154e-4ecc-8c0b-6e020557d7bd');
+  const yubikeyMeta = lookupAaguidMetadata('2fc0579f-8113-47ea-b116-bb5a8db9202a');
+
+  return [
+    {
+      // Valid unpadded Base64URL string (Buffer.from('cred-google-passkey-01').toString('base64url'))
+      id: 'Y3JlZC1nb29nbGUtcGFzc2tleS0wMQ',
+      passkeyUserId: DEFAULT_USER.passkeyUserId,
+      credentialPublicKey: 'pQECAyYgASFYIJV8dXNlci1wdWJsaWMta2V5LTAxIlggY3JlZC1wdWJsaWMta2V5LTAx',
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
+      aaguid: googleMeta.aaguid,
+      providerIcon: googleMeta.providerIcon,
+      name: googleMeta.name,
+      transports: ['internal', 'hybrid'],
+      registeredAt: 1758463200000,
+      lastUsedAt: 1762689600000,
+      counter: 14,
+    },
+    {
+      // Valid unpadded Base64URL string (Buffer.from('cred-icloud-passkey-02').toString('base64url'))
+      id: 'Y3JlZC1pY2xvdWQtcGFzc2tleS0wMg',
+      passkeyUserId: DEFAULT_USER.passkeyUserId,
+      credentialPublicKey: 'pQECAyYgASFYIJV8dXNlci1wdWJsaWMta2V5LTAyIlggY3JlZC1wdWJsaWMta2V5LTAy',
+      credentialType: 'public-key',
+      credentialDeviceType: 'multiDevice',
+      credentialBackedUp: true,
