+      setStatusBanner('A passkey already exists on this authenticator for your account.', 'info');
+    } else if (err.name === 'SecurityError') {
+      setStatusBanner('Configuration RP ID or Secure Context error.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      setStatusBanner('Passkey registration was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      setStatusBanner('Passkey creation operation was aborted.', 'info');
+    }
+    return;
+  }
+
+  if (!credential) return;
+
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (PublicKeyCredential.signalUnknownCredential) {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        } catch (e) {
+          console.warn('SignalUnknownCredential sync warning:', e);
+        }
+      }
+      setStatusBanner('Server could not verify the new passkey.', 'error');
+      return;
+    }
+
+    setStatusBanner('New passkey registered to your account.', 'success');
+    await loadManagementPanel();
+  } catch (serverErr) {
+    console.warn('Server verification network failure:', serverErr);
+    if (PublicKeyCredential.signalUnknownCredential) {
+      try {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rp.id,
+          credentialId: encodedResponse.id,
+        });
+      } catch (e) {
+        console.warn('SignalUnknownCredential sync warning:', e);
+      }
+    }
+    setStatusBanner('Network error while verifying passkey registration.', 'error');
+  }
+}
+
+function attachEventListeners() {
+  const createButton = document.getElementById('create-passkey');
+  if (createButton) {
+    createButton.addEventListener('click', () => {
+      registerPasskey(false);
+    });
+  }
+
+  const userProfileForm = document.getElementById('user-profile-form');
+  if (userProfileForm) {
+    userProfileForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const userNameInput = document.getElementById('user-name-input');
+      const userDisplayNameInput = document.getElementById('user-display-name-input');
+      const updatedName = userNameInput ? userNameInput.value.trim() : '';
+      const updatedDisplayName = userDisplayNameInput ? userDisplayNameInput.value.trim() : '';
+      if (!updatedName || !updatedDisplayName) return;
+      await performUserRename(updatedName, updatedDisplayName);
+    });
+  }
+}
+
+function init() {
+  attachEventListeners();
+  loadManagementPanel();
+}
+
+if (document.readyState === 'loading') {
+  window.addEventListener('DOMContentLoaded', init);
+} else {
+  init();
+}
