+
+  async function handleRenamePasskey(passkeyId, newName) {
+    const target = state.passkeys.find((pk) => pk.id === passkeyId);
+    if (!target) return;
+
+    const oldName = target.name;
+    target.name = newName;
+    editingPasskeyId = null;
+    saveState();
+    renderPasskeysList();
+
+    await syncBrowserAuthenticator({
+      reason: `Renamed passkey "${oldName}" to "${newName}"`
+    });
+
+    showNotification(`Passkey renamed to "${newName}".`, 'success');
+  }
+
+  async function handleDeletePasskey(passkeyId) {
+    const index = state.passkeys.findIndex((pk) => pk.id === passkeyId);
+    if (index === -1) return;
+
+    const [removed] = state.passkeys.splice(index, 1);
+    lastDeletedPasskey = { item: removed, index };
+    if (editingPasskeyId === passkeyId) {
+      editingPasskeyId = null;
+    }
+
+    saveState();
+    renderPasskeysList();
+
+    await syncBrowserAuthenticator({
+      deletedCredentialId: removed.credentialId,
+      reason: `Deleted passkey "${removed.name}"`
+    });
+
+    showNotification(
+      `Deleted passkey "${removed.name}" and notified your browser authenticator.`,
+      'warning',
+      async () => {
+        if (!lastDeletedPasskey) return;
+        const restoreIdx = Math.min(lastDeletedPasskey.index, state.passkeys.length);
+        state.passkeys.splice(restoreIdx, 0, lastDeletedPasskey.item);
+        const restoredName = lastDeletedPasskey.item.name;
+        lastDeletedPasskey = null;
+        saveState();
+        renderPasskeysList();
+        await syncBrowserAuthenticator({
+          reason: `Restored passkey "${restoredName}"`
+        });
+        showNotification(
+          `Restored passkey "${restoredName}" and re-synced your browser authenticator.`,
+          'success'
+        );
+      }
+    );
+  }
+
+  async function handleRegisterPasskey(customLabel) {
+    const label = (customLabel || '').trim() || `Passkey (${navigator.platform || 'This Device'})`;
+    let newCredentialId = null;
+    let authenticatorName = 'Platform Authenticator';
+    let backedUp = true;
+
+    if (
+      window.PublicKeyCredential &&
+      navigator.credentials &&
+      typeof navigator.credentials.create === 'function'
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        window.crypto.getRandomValues(challenge);
+        const userIdBytes = fromBase64Url(state.user.userId);
+
+        const credential = await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The Daily Grind Coffee Co.',
+              id: getRpId()
+            },
+            user: {
+              id: userIdBytes,
+              name: state.user.email,
+              displayName: state.user.displayName
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 },
+              { type: 'public-key', alg: -257 }
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred'
+            },
+            timeout: 15000,
+            excludeCredentials: state.passkeys.map((pk) => ({
+              type: 'public-key',
+              id: fromBase64Url(pk.credentialId)
+            }))
+          }
+        });
+
+        if (credential && credential.rawId) {
+          newCredentialId = toBase64Url(credential.rawId);
+        }
+      } catch (err) {
+        // Fallback when user cancels or headless environment has no virtual authenticator attached
+        console.info('Falling back to simulated credential registration:', err.message);
+      }
+    }
+
+    if (!newCredentialId) {
+      const randomBytes = new Uint8Array(20);
+      window.crypto.getRandomValues(randomBytes);
+      newCredentialId = toBase64Url(randomBytes);
+    }
+
+    const todayStr = new Date().toLocaleDateString('en-US', {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric'
+    });
+
+    const newPasskey = {
+      id: `pk-${Date.now()}`,
+      credentialId: newCredentialId,
+      name: label,
+      authenticator: authenticatorName,
+      transports: ['internal'],
+      backedUp,
+      createdAt: todayStr,
+      lastUsedAt: `${todayStr} (Just now)`,
+      deviceType: 'laptop'
+    };
+
+    state.passkeys.unshift(newPasskey);
+    saveState();
+    renderPasskeysList();
+
+    await syncBrowserAuthenticator({
+      reason: `Registered new passkey "${label}"`
+    });
+
+    showNotification(
+      `Passkey "${label}" registered and synced with your browser authenticator.`,
+      'success'
+    );
+  }
+
+  function bindGlobalControls() {
