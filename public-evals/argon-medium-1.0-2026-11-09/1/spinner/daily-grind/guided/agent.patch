+  <script>
+    const orderNowBtn = document.getElementById('order-now-btn');
+    const seasonalSection = document.getElementById('seasonal-favorites');
+    const seasonalLoader = document.getElementById('seasonal-details-loader');
+    const seasonalLoadingText = document.getElementById('seasonal-loading-text');
+
+    function startOrder(btn) {
+      if (btn.getAttribute('aria-disabled') === 'true') {
+        return;
+      }
+      btn.setAttribute('aria-busy', 'true');
+      btn.setAttribute('aria-disabled', 'true');
+      const spinner = btn.querySelector('progress.loading-spinner');
+      if (spinner) {
+        spinner.hidden = false;
+      }
+    }
+
+    function loadDrinkDetails(btn) {
+      if (btn.getAttribute('aria-disabled') === 'true') {
+        return;
+      }
+      btn.setAttribute('aria-busy', 'true');
+      btn.setAttribute('aria-disabled', 'true');
+      const spinner = btn.querySelector('progress.loading-spinner');
+      if (spinner) {
+        spinner.hidden = false;
+      }
+      const card = btn.closest('.card');
+      if (card) {
+        card.setAttribute('aria-busy', 'true');
+      }
+      if (seasonalSection) {
+        seasonalSection.setAttribute('aria-busy', 'true');
+      }
+      if (seasonalLoader) {
+        const drinkName = btn.dataset.drink;
+        if (seasonalLoadingText && drinkName) {
+          seasonalLoadingText.textContent = `Loading ${drinkName} details...`;
+        }
+        seasonalLoader.hidden = false;
+      }
+    }
+
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        startOrder(orderNowBtn);
+      });
+    }
+
+    if (seasonalSection) {
+      const detailButtons = seasonalSection.querySelectorAll('.card .btn');
+      detailButtons.forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          loadDrinkDetails(btn);
+        });
+      });
+    }
+  </script>
