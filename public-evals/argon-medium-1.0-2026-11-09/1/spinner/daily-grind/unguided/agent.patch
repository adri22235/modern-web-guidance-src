+  <script>
+    (function () {
+      const orderBtn = document.getElementById('order-now-btn');
+      const hero = document.querySelector('.hero');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const seasonalStatus = document.getElementById('seasonal-status');
+
+      function activateLoadingState(btn, statusMessage) {
+        btn.classList.add('loading', 'is-loading');
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+
+        const spinner = btn.querySelector('.spinner');
+        if (spinner) {
+          spinner.classList.add('active');
+          spinner.setAttribute('aria-label', statusMessage);
+        }
+
+        const statusText = btn.querySelector('.status-text');
+        if (statusText) {
+          statusText.textContent = statusMessage;
+        }
+      }
+
+      if (orderBtn) {
+        orderBtn.addEventListener('click', function (e) {
+          e.preventDefault();
+          if (orderBtn.getAttribute('aria-busy') === 'true') return;
+          activateLoadingState(orderBtn, 'Starting order...');
+          if (hero) {
+            hero.setAttribute('aria-busy', 'true');
+          }
+        });
+      }
+
+      if (seasonalSection) {
+        const detailBtns = seasonalSection.querySelectorAll('.card .btn');
+        detailBtns.forEach(function (btn) {
+          btn.addEventListener('click', function (e) {
+            e.preventDefault();
+            if (btn.getAttribute('aria-busy') === 'true') return;
+
+            const card = btn.closest('.card');
+            const drinkTitle = card && card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : 'drink';
+            const message = 'Loading ' + drinkTitle + ' details...';
+
+            activateLoadingState(btn, message);
+
+            if (card) {
+              card.classList.add('loading', 'is-loading');
+              card.setAttribute('aria-busy', 'true');
+            }
+
+            seasonalSection.classList.add('loading', 'is-loading');
+            seasonalSection.setAttribute('aria-busy', 'true');
+
+            if (seasonalStatus) {
+              seasonalStatus.textContent = message;
+            }
+          });
+        });
+      }
+    })();
+  </script>
