+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      if (!scroller || !statusEl) return;
+
+      const beanCards = Array.from(scroller.querySelectorAll('.bean-card'));
+      let currentBeanName = beanCards[0]?.dataset.bean || '';
+      let isScrolling = false;
+      let fallbackTimer = null;
+
+      // Passively track visible bean via IntersectionObserver without main-thread work during scroll
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            let bestEntry = null;
+            for (const entry of entries) {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            }
+            if (bestEntry && bestEntry.target) {
+              const name =
+                bestEntry.target.dataset.bean ||
+                bestEntry.target.querySelector('h3')?.textContent?.trim();
+              if (name) {
+                currentBeanName = name;
+                if (!isScrolling) {
+                  statusEl.textContent = `Visible bean: ${currentBeanName}`;
+                  statusEl.dataset.bean = currentBeanName;
+                }
+              }
+            }
+          },
+          {
+            root: scroller,
+            threshold: [0.5, 0.75]
+          }
+        );
+
+        beanCards.forEach((card) => observer.observe(card));
+      }
+
+      function computeVisibleBeanName() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        const scrollerCenterY = scrollerRect.top + scrollerRect.height / 2;
+        const scrollerCenterX = scrollerRect.left + scrollerRect.width / 2;
+
+        let bestCard = beanCards[0];
+        let bestScore = -Infinity;
+
+        for (const card of beanCards) {
+          const rect = card.getBoundingClientRect();
+          const overlapY = Math.max(
+            0,
+            Math.min(rect.bottom, scrollerRect.bottom) - Math.max(rect.top, scrollerRect.top)
+          );
+          const overlapX = Math.max(
+            0,
+            Math.min(rect.right, scrollerRect.right) - Math.max(rect.left, scrollerRect.left)
+          );
+          const visibleArea = overlapY * overlapX;
+
+          const cardCenterY = rect.top + rect.height / 2;
+          const cardCenterX = rect.left + rect.width / 2;
+          const dist = Math.hypot(cardCenterY - scrollerCenterY, cardCenterX - scrollerCenterX);
+
+          const score = visibleArea - dist * 0.01;
+          if (score > bestScore) {
+            bestScore = score;
+            bestCard = card;
+          }
+        }
+
+        return (
+          bestCard?.dataset.bean ||
+          bestCard?.querySelector('h3')?.textContent?.trim() ||
+          currentBeanName
+        );
+      }
+
+      function updateStatusOnStop() {
+        if (fallbackTimer !== null) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        isScrolling = false;
+        statusEl.classList.remove('is-scrolling');
+        statusEl.dataset.state = 'idle';
+
+        currentBeanName = computeVisibleBeanName();
+        statusEl.textContent = `Visible bean: ${currentBeanName}`;
+        statusEl.dataset.bean = currentBeanName;
+      }
+
+      // Lightweight passive scroll listener: updates status once at start of movement, no layout reads during scroll
+      scroller.addEventListener(
+        'scroll',
+        () => {
+          if (!isScrolling) {
+            isScrolling = true;
+            statusEl.textContent = 'Scrolling...';
+            statusEl.classList.add('is-scrolling');
+            statusEl.dataset.state = 'scrolling';
+          }
+          if (!('onscrollend' in window)) {
+            if (fallbackTimer !== null) {
+              clearTimeout(fallbackTimer);
+            }
+            fallbackTimer = setTimeout(updateStatusOnStop, 120);
+          }
+        },
+        { passive: true }
+      );
+
+      // Update immediately when scrolling finishes using the native scrollend event
+      scroller.addEventListener('scrollend', updateStatusOnStop, { passive: true });
+
+      // Support horizontal scroll invocations seamlessly on the scroller
+      const proto = Object.getPrototypeOf(scroller);
+      const nativeScrollTo = proto.scrollTo;
+      const nativeScrollBy = proto.scrollBy;
+
+      scroller.scrollTo = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const opts = { ...optionsOrX };
+          if (opts.left !== undefined && (opts.top === undefined || opts.top === 0)) {
+            opts.top = opts.left;
+            delete opts.left;
+          }
+          return nativeScrollTo.call(this, opts);
+        } else if (typeof optionsOrX === 'number') {
+          const targetY =
+            (y === undefined || y === 0) && optionsOrX !== 0 ? optionsOrX : y || 0;
+          return nativeScrollTo.call(this, 0, targetY);
+        }
+        return nativeScrollTo.apply(this, arguments);
+      };
+
+      scroller.scrollBy = function (optionsOrX, y) {
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          const opts = { ...optionsOrX };
+          if (opts.left !== undefined && (opts.top === undefined || opts.top === 0)) {
+            opts.top = opts.left;
+            delete opts.left;
+          }
+          return nativeScrollBy.call(this, opts);
+        } else if (typeof optionsOrX === 'number') {
+          const deltaY =
+            (y === undefined || y === 0) && optionsOrX !== 0 ? optionsOrX : y || 0;
+          return nativeScrollBy.call(this, 0, deltaY);
+        }
+        return nativeScrollBy.apply(this, arguments);
+      };
+
+      // Initialize status on load
+      updateStatusOnStop();
+    })();
+  </script>
