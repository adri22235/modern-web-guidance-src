+  <script>
+    function findMostVisibleSection(container) {
+      const containerRect = container.getBoundingClientRect();
+      const cards = container.querySelectorAll('.bean-card');
+      let bestCard = cards[0] || null;
+      let maxVisibleArea = -1;
+
+      cards.forEach((card) => {
+        const rect = card.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, containerRect.top);
+        const visibleBottom = Math.min(rect.bottom, containerRect.bottom);
+        const visibleLeft = Math.max(rect.left, containerRect.left);
+        const visibleRight = Math.min(rect.right, containerRect.right);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+        const visibleWidth = Math.max(0, visibleRight - visibleLeft);
+        const visibleArea = visibleHeight * visibleWidth;
+
+        if (visibleArea > maxVisibleArea) {
+          maxVisibleArea = visibleArea;
+          bestCard = card;
+        }
+      });
+
+      return bestCard;
+    }
+
+    function updateVisibleBeanStatus(scroller, statusEl) {
+      const currentVisibleBean = findMostVisibleSection(scroller);
+      statusEl.classList.remove('is-scrolling');
+      if (currentVisibleBean) {
+        const beanName =
+          currentVisibleBean.dataset.bean ||
+          currentVisibleBean.querySelector('h3')?.textContent ||
+          'Unknown Bean';
+        statusEl.textContent = `Visible Bean: ${beanName}`;
+      }
+    }
+
+    function initializeDemo() {
+      const scroller = document.querySelector('#scroller');
+      const statusEl = document.querySelector('#status');
+      if (!scroller || !statusEl) return;
+
+      let isScrolling = false;
+
+      // 1. Lightweight informative feedback during active scroll (no layout queries)
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.classList.add('is-scrolling');
+          statusEl.textContent = 'Scrolling coffee beans...';
+        }
+      }, { passive: true });
+
+      // 2. Defer layout calculation and DOM identification until scrolling rests
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        updateVisibleBeanStatus(scroller, statusEl);
+      });
+
+      updateVisibleBeanStatus(scroller, statusEl);
+    }
+
+    if ('onscrollend' in window) {
+      initializeDemo();
+    } else {
+      initializeDemo();
+      const scroller = document.querySelector('#scroller');
+      if (scroller) {
+        scroller.addEventListener('scroll', () => {
+          clearTimeout(window.scrollendtimer);
+          window.scrollendtimer = setTimeout(() => {
+            scroller.dispatchEvent(new CustomEvent('scrollend'));
+          }, 100);
+        }, { passive: true });
+      }
+    }
+  </script>
+
