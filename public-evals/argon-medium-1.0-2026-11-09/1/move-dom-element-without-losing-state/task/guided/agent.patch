+  <script>
+    const theaterToggleBtn = document.getElementById('theater-toggle');
+    const heroSection = document.getElementById('hero-section');
+    const videoPlayerContainer = document.getElementById('video-player-container');
+    const roastingVideo = document.getElementById('roasting-video');
+    const theaterStatus = document.getElementById('theater-status');
+
+    function moveElementWithState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterToggleBtn.addEventListener('click', () => {
+      const isInHero = heroSection.contains(roastingVideo);
+
+      if (isInHero) {
+        moveElementWithState(videoPlayerContainer, roastingVideo);
+        heroSection.classList.remove('theater-active');
+        theaterToggleBtn.setAttribute('aria-pressed', 'false');
+        theaterToggleBtn.textContent = 'Enter Theater Mode';
+        theaterStatus.textContent = 'Exited theater mode. Video returned to player section.';
+      } else {
+        moveElementWithState(heroSection, roastingVideo);
+        heroSection.classList.add('theater-active');
+        theaterToggleBtn.setAttribute('aria-pressed', 'true');
+        theaterToggleBtn.textContent = 'Exit Theater Mode';
+        theaterStatus.textContent = 'Entered theater mode. Video moved to hero section.';
+      }
+    });
+  </script>
+
