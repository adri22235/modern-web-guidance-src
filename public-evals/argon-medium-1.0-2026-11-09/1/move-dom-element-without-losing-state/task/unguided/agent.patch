+  <script>
+    (function () {
+      const heroSection = document.querySelector('.hero');
+      const videoContainer = document.getElementById('video-player-container');
+      const videoElement = document.getElementById('coffee-roasting-video');
+      const toggleBtn = document.getElementById('theater-mode-toggle');
+
+      if (!heroSection || !videoContainer || !videoElement || !toggleBtn) return;
+
+      function movePreservingState(targetParent, node, referenceNode = null) {
+        if (typeof targetParent.moveBefore === 'function') {
+          targetParent.moveBefore(node, referenceNode);
+        } else {
+          targetParent.insertBefore(node, referenceNode);
+        }
+      }
+
+      toggleBtn.addEventListener('click', () => {
+        const isInTheater = heroSection.contains(videoElement);
+
+        if (!isInTheater) {
+          movePreservingState(heroSection, videoElement, null);
+          heroSection.classList.add('theater-mode');
+          videoContainer.classList.add('is-empty');
+          toggleBtn.setAttribute('aria-pressed', 'true');
+          toggleBtn.textContent = 'Exit Theater Mode';
+        } else {
+          movePreservingState(videoContainer, videoElement, videoContainer.firstElementChild);
+          heroSection.classList.remove('theater-mode');
+          videoContainer.classList.remove('is-empty');
+          toggleBtn.setAttribute('aria-pressed', 'false');
+          toggleBtn.textContent = 'Theater Mode';
+        }
+      });
+    })();
+  </script>
+
