+  <script>
+    (function () {
+      const viewport = document.getElementById('cafe-map-viewport');
+      const surface = document.getElementById('cafe-map-surface');
+      const coordsDisplay = document.getElementById('map-coordinates');
+      const chips = document.querySelectorAll('.map-chip');
+      const markers = document.querySelectorAll('.map-marker');
+      const selectedName = document.getElementById('selected-cafe-name');
+      const selectedMeta = document.getElementById('selected-cafe-meta');
+      const selectedLink = document.getElementById('selected-cafe-link');
+
+      if (!viewport || !surface) return;
+
+      let panX = 650;
+      let panY = 520;
+      let isDragging = false;
+      let activeTouches = 0;
+      let lastX = 0;
+      let lastY = 0;
+      let totalMoved = 0;
+
+      function getBounds() {
+        const maxX = Math.max(0, (surface.offsetWidth || 2400) - (viewport.clientWidth || 800));
+        const maxY = Math.max(0, (surface.offsetHeight || 1800) - (viewport.clientHeight || 540));
+        return { maxX, maxY };
+      }
+
+      function updateReadout() {
+        const rx = Math.round(viewport.scrollLeft);
+        const ry = Math.round(viewport.scrollTop);
+        surface.setAttribute('data-pan-x', String(rx));
+        surface.setAttribute('data-pan-y', String(ry));
+        if (coordsDisplay) {
+          coordsDisplay.textContent = 'Pan: X ' + rx + ', Y ' + ry;
+        }
+      }
+
+      function setPanPosition(nextX, nextY) {
+        const { maxX, maxY } = getBounds();
+        panX = Math.max(0, Math.min(maxX, nextX));
+        panY = Math.max(0, Math.min(maxY, nextY));
+        viewport.scrollLeft = panX;
+        viewport.scrollTop = panY;
+        updateReadout();
+      }
+
+      function applyPanDelta(dx, dy) {
+        setPanPosition(panX - dx, panY - dy);
+      }
+
+      // Initialize centered on Downtown Flagship so 2D panning has room in every direction
+      setPanPosition(650, 520);
+
+      function startGesture(clientX, clientY) {
+        if (!isDragging) {
+          panX = viewport.scrollLeft;
+          panY = viewport.scrollTop;
+          totalMoved = 0;
+        }
+        isDragging = true;
+        lastX = clientX;
+        lastY = clientY;
+        viewport.classList.add('is-dragging');
+      }
+
+      function moveGesture(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - lastX;
+        const dy = clientY - lastY;
+        if (dx === 0 && dy === 0) return;
+        lastX = clientX;
+        lastY = clientY;
+        totalMoved += Math.hypot(dx, dy);
+        applyPanDelta(dx, dy);
+      }
+
+      function endGesture() {
+        isDragging = false;
+        viewport.classList.remove('is-dragging');
+      }
+
+      function onPointerDown(e) {
+        if (e.button !== undefined && e.button !== 0 && e.pointerType === 'mouse') return;
+        startGesture(e.clientX, e.clientY);
+      }
+
+      function onPointerMove(e) {
+        if (!isDragging) return;
+        moveGesture(e.clientX, e.clientY);
+      }
+
+      function onPointerUp() {
+        if (activeTouches === 0) {
+          endGesture();
+        }
+      }
+
+      function onMouseDown(e) {
+        if (e.button !== undefined && e.button !== 0) return;
+        if (e.cancelable) e.preventDefault();
+        startGesture(e.clientX, e.clientY);
+      }
+
+      function onMouseMove(e) {
+        if (!isDragging) return;
+        moveGesture(e.clientX, e.clientY);
+      }
+
+      function onMouseUp() {
+        if (activeTouches === 0) {
+          endGesture();
+        }
+      }
+
+      function onTouchStart(e) {
+        if (!e.touches || e.touches.length === 0) return;
+        activeTouches = e.touches.length;
+        const t = e.touches[0];
+        startGesture(t.clientX, t.clientY);
+      }
+
+      function onTouchMove(e) {
+        if (!isDragging || !e.touches || e.touches.length === 0) return;
+        if (e.cancelable) e.preventDefault();
+        const t = e.touches[0];
+        moveGesture(t.clientX, t.clientY);
+      }
+
+      function onTouchEnd(e) {
+        activeTouches = e.touches ? e.touches.length : 0;
+        if (activeTouches > 0) {
+          lastX = e.touches[0].clientX;
+          lastY = e.touches[0].clientY;
+        } else {
+          endGesture();
+        }
+      }
+
+      [surface, viewport].forEach(function (el) {
+        el.addEventListener('pointerdown', onPointerDown);
+        el.addEventListener('mousedown', onMouseDown);
+        el.addEventListener('touchstart', onTouchStart, { passive: true });
+        el.addEventListener('dragstart', function (e) {
+          e.preventDefault();
+        });
+      });
+
+      [surface, viewport, window].forEach(function (el) {
+        el.addEventListener('pointermove', onPointerMove);
+        el.addEventListener('mousemove', onMouseMove);
+        el.addEventListener('touchmove', onTouchMove, { passive: false });
+        el.addEventListener('pointerup', onPointerUp);
+        el.addEventListener('mouseup', onMouseUp);
+        el.addEventListener('touchend', onTouchEnd);
+        el.addEventListener('touchcancel', onTouchEnd);
+      });
+
+      window.addEventListener('pointercancel', function () {
+        if (activeTouches === 0) {
+          endGesture();
+        }
+      });
+
+      viewport.addEventListener('wheel', function (e) {
+        if (e.cancelable) e.preventDefault();
+        panX = viewport.scrollLeft;
+        panY = viewport.scrollTop;
+        applyPanDelta(-e.deltaX, -e.deltaY);
+      }, { passive: false });
+
+      viewport.addEventListener('scroll', function () {
+        if (!isDragging) {
+          panX = viewport.scrollLeft;
+          panY = viewport.scrollTop;
+        }
+        updateReadout();
+      });
+
+      const pressedKeys = new Set();
+      viewport.addEventListener('keydown', function (e) {
+        const step = 40;
+        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
+          e.preventDefault();
+          pressedKeys.add(e.key);
+          let dx = 0;
+          let dy = 0;
+          if (pressedKeys.has('ArrowLeft')) dx += step;
+          if (pressedKeys.has('ArrowRight')) dx -= step;
+          if (pressedKeys.has('ArrowUp')) dy += step;
+          if (pressedKeys.has('ArrowDown')) dy -= step;
+          panX = viewport.scrollLeft;
+          panY = viewport.scrollTop;
+          applyPanDelta(dx, dy);
+        }
+      });
+
+      viewport.addEventListener('keyup', function (e) {
+        pressedKeys.delete(e.key);
+      });
+
+      function selectCafeById(cafeId, centerOnMap) {
+        const marker = document.querySelector('.map-marker[data-cafe-id="' + cafeId + '"]');
+        if (!marker) return;
+
+        markers.forEach(function (m) {
+          m.classList.toggle('selected', m === marker);
+        });
+        chips.forEach(function (c) {
+          c.classList.toggle('active', c.getAttribute('data-target-id') === cafeId);
+        });
+
+        const name = marker.getAttribute('data-name');
+        const address = marker.getAttribute('data-address');
+        const hours = marker.getAttribute('data-hours');
+        const specialty = marker.getAttribute('data-specialty');
+
+        if (selectedName) selectedName.textContent = name;
+        if (selectedMeta) {
+          selectedMeta.textContent = address + ' • ' + hours + ' • Featured: ' + specialty;
+        }
+        if (selectedLink) {
+          selectedLink.setAttribute('href', '/locations/' + cafeId);
+        }
+
+        if (centerOnMap) {
+          const targetX = Number(marker.getAttribute('data-x')) - (viewport.clientWidth || 800) / 2;
+          const targetY = Number(marker.getAttribute('data-y')) - (viewport.clientHeight || 540) / 2;
+          setPanPosition(targetX, targetY);
+        }
+      }
+
+      markers.forEach(function (marker) {
+        marker.addEventListener('click', function () {
+          if (totalMoved > 6) return;
+          const cafeId = marker.getAttribute('data-cafe-id');
+          selectCafeById(cafeId, false);
+        });
+      });
+
+      chips.forEach(function (chip) {
+        chip.addEventListener('click', function () {
+          const cafeId = chip.getAttribute('data-target-id');
+          selectCafeById(cafeId, true);
+        });
+      });
+    })();
+  </script>
 </body>
 
