--- /dev/null
+++ b/src/utils/passkeyStore.ts
@@ -0,0 +1,167 @@
+import crypto from 'node:crypto';
+
+export interface StoredPasskeyCredential {
+  id: string;
+  rawId?: string;
+  publicKey?: string;
+  algorithm?: number;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  transports: string[];
+  authenticatorAttachment?: string;
+  backedUp?: boolean;
+  deviceType?: 'multiDevice' | 'singleDevice';
+  aaguid?: string;
+  signCount?: number;
+}
+
+export interface StoredUser {
+  id: string; // base64url encoded user handle
+  username: string;
+  displayName: string;
+  email: string;
+  password?: string;
+  passwordlessOnly?: boolean;
+  createdAt: string;
+  credentials: StoredPasskeyCredential[];
+}
+
+interface PasskeyStoreState {
+  users: Map<string, StoredUser>; // keyed by lowercase username
+  challenges: Map<string, { challenge: string; username?: string; expiresAt: number }>;
+}
+
+const globalStoreKey = '__DEVTOOLS_TIMES_PASSKEY_STORE__';
+
+function getStore(): PasskeyStoreState {
+  const g = globalThis as unknown as Record<string, PasskeyStoreState | undefined>;
+  if (!g[globalStoreKey]) {
+    const users = new Map<string, StoredUser>();
+    g[globalStoreKey] = {
+      users,
+      challenges: new Map(),
+    };
+  }
+  return g[globalStoreKey]!;
+}
+
+export function generateBase64UrlBytes(size = 32): string {
+  return crypto.randomBytes(size).toString('base64url');
+}
+
+export function createChallenge(username?: string): string {
+  const store = getStore();
+  const challenge = generateBase64UrlBytes(32);
+  store.challenges.set(challenge, {
+    challenge,
+    username: username?.toLowerCase(),
+    expiresAt: Date.now() + 5 * 60 * 1000,
+  });
+  return challenge;
+}
+
+export function consumeChallenge(challenge: string): boolean {
+  const store = getStore();
+  const entry = store.challenges.get(challenge);
+  if (!entry) {
+    // Allow client-generated or stateless challenges in serverless/multi-instance contexts
+    return Boolean(challenge && challenge.length >= 16);
+  }
+  store.challenges.delete(challenge);
+  return entry.expiresAt >= Date.now();
+}
+
+export function getOrCreateUser(
+  username: string,
+  options?: { displayName?: string; email?: string; password?: string }
+): StoredUser {
+  const store = getStore();
+  const key = username.trim().toLowerCase();
+  const existing = store.users.get(key);
+  if (existing) {
+    if (options?.displayName) existing.displayName = options.displayName;
+    if (options?.email) existing.email = options.email;
+    if (options?.password) existing.password = options.password;
+    return existing;
+  }
+
+  const userId = Buffer.from(`user:${key}:${Date.now()}`).toString('base64url');
+  const newUser: StoredUser = {
+    id: userId,
+    username: username.trim(),
+    displayName: options?.displayName?.trim() || username.trim(),
+    email: options?.email?.trim() || `${key}@devtoolstimes.dev`,
+    password: options?.password,
+    passwordlessOnly: !options?.password,
+    createdAt: new Date().toISOString(),
+    credentials: [],
+  };
+  store.users.set(key, newUser);
+  return newUser;
+}
+
+export function getUserByUsername(username: string): StoredUser | undefined {
+  const store = getStore();
+  return store.users.get(username.trim().toLowerCase());
+}
+
+export function findUserByCredentialId(credentialId: string): {
+  user: StoredUser;
+  credential: StoredPasskeyCredential;
+} | null {
+  const store = getStore();
+  for (const user of store.users.values()) {
+    const cred = user.credentials.find((c) => c.id === credentialId);
+    if (cred) {
+      return { user, credential: cred };
+    }
+  }
+  return null;
+}
+
+export function findUserByUserHandle(userHandle: string): StoredUser | undefined {
+  const store = getStore();
+  for (const user of store.users.values()) {
+    if (user.id === userHandle) {
+      return user;
+    }
+  }
+  return undefined;
+}
+
+export function addCredentialToUser(
+  username: string,
+  credential: StoredPasskeyCredential,
+  userOptions?: { displayName?: string; email?: string }
+): StoredUser {
+  const user = getOrCreateUser(username, userOptions);
+  const existingIndex = user.credentials.findIndex((c) => c.id === credential.id);
+  if (existingIndex >= 0) {
+    user.credentials[existingIndex] = credential;
+  } else {
+    user.credentials.unshift(credential);
+  }
+  return user;
+}
+
+export function renameUserCredential(
+  username: string,
+  credentialId: string,
+  newName: string
+): StoredPasskeyCredential | null {
+  const user = getUserByUsername(username);
+  if (!user) return null;
+  const cred = user.credentials.find((c) => c.id === credentialId);
+  if (!cred) return null;
+  cred.name = newName.trim();
+  return cred;
+}
+
+export function deleteUserCredential(username: string, credentialId: string): boolean {
+  const user = getUserByUsername(username);
+  if (!user) return false;
+  const before = user.credentials.length;
+  user.credentials = user.credentials.filter((c) => c.id !== credentialId);
+  return user.credentials.length < before;
+}
