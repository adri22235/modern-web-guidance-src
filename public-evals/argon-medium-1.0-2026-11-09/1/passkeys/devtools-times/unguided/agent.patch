@@ -0,0 +1,116 @@
+import type { APIRoute } from 'astro';
+import {
+  deleteUserCredential,
+  getOrCreateUser,
+  getUserByUsername,
+  renameUserCredential,
+} from '../../../utils/passkeyStore';
+
+export const GET: APIRoute = async ({ url, session }) => {
+  const sessionUser = await session?.get('currentUser');
+  const username = url.searchParams.get('username') || sessionUser?.username;
+  if (!username) {
+    return new Response(JSON.stringify({ user: null, credentials: [] }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = getUserByUsername(username);
+  return new Response(
+    JSON.stringify({
+      user: user
+        ? {
+            id: user.id,
+            username: user.username,
+            displayName: user.displayName,
+            email: user.email,
+            passwordlessOnly: user.passwordlessOnly,
+          }
+        : null,
+      credentials: user?.credentials || [],
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username, credentialId, name, displayName, email, passwordlessOnly } = body;
+
+    if (!username) {
+      return new Response(JSON.stringify({ error: 'Username is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = getOrCreateUser(username, { displayName, email });
+    if (typeof passwordlessOnly === 'boolean') {
+      user.passwordlessOnly = passwordlessOnly;
+    }
+
+    if (credentialId && typeof name === 'string') {
+      const updated = renameUserCredential(username, credentialId, name);
+      return new Response(
+        JSON.stringify({
+          updated: Boolean(updated),
+          credential: updated,
+          credentials: user.credentials,
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    return new Response(
+      JSON.stringify({
+        updated: true,
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+          email: user.email,
+          passwordlessOnly: user.passwordlessOnly,
+          credentials: user.credentials,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Failed to update passkey or user settings' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
+
+export const DELETE: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { username, credentialId } = body;
+
+    if (!username || !credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'Username and credentialId are required' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const deleted = deleteUserCredential(username, credentialId);
+    const user = getUserByUsername(username);
+
+    return new Response(
+      JSON.stringify({
+        deleted,
+        credentials: user?.credentials || [],
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Failed to delete passkey' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
