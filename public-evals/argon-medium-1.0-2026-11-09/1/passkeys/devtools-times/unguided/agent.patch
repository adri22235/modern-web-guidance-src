--- /dev/null
+++ b/src/components/ReauthModal.tsx
@@ -0,0 +1,208 @@
+import React, { useState, useEffect } from 'react';
+import {
+  reauthenticateWithPasskey,
+  verifyPasswordReauth,
+  type AuthSession,
+} from '../utils/passkeys';
+
+interface ReauthModalProps {
+  isOpen: boolean;
+  username: string;
+  actionDescription: string;
+  hasPasskeys: boolean;
+  onSuccess: (session: AuthSession) => void;
+  onClose: () => void;
+}
+
+export default function ReauthModal({
+  isOpen,
+  username,
+  actionDescription,
+  hasPasskeys,
+  onSuccess,
+  onClose,
+}: ReauthModalProps) {
+  const [mode, setMode] = useState<'passkey' | 'password'>(hasPasskeys ? 'passkey' : 'password');
+  const [password, setPassword] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (isOpen) {
+      setMode(hasPasskeys ? 'passkey' : 'password');
+      setPassword('');
+      setError(null);
+      setLoading(false);
+    }
+  }, [isOpen, hasPasskeys]);
+
+  useEffect(() => {
+    if (!isOpen) return;
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') onClose();
+    };
+    window.addEventListener('keydown', handleKeyDown);
+    return () => window.removeEventListener('keydown', handleKeyDown);
+  }, [isOpen, onClose]);
+
+  if (!isOpen) return null;
+
+  const handlePasskeyReauth = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      const { session } = await reauthenticateWithPasskey(username);
+      onSuccess(session);
+    } catch (err: any) {
+      setError(err?.message || 'Passkey verification failed. Please try again.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      const session = verifyPasswordReauth(username, password);
+      onSuccess(session);
+    } catch (err: any) {
+      setError(err?.message || 'Password verification failed.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/50 backdrop-blur-xs z-[99999] flex items-center justify-center p-4"
+      onClick={onClose}
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="reauth-modal-title"
+    >
+      <div
+        className="bg-white border border-gray-200 rounded-xl shadow-2xl max-w-md w-full p-6 relative"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <button
+          type="button"
+          onClick={onClose}
+          aria-label="Close verification modal"
+          className="absolute top-4 right-4 text-gray-400 hover:text-gray-700 p-1 rounded-full hover:bg-gray-100"
+        >
+          <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+
+        <div className="flex items-center space-x-3 mb-4">
+          <div className="w-10 h-10 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center shrink-0">
+            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                strokeWidth={2}
+                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
+              />
+            </svg>
+          </div>
+          <div>
+            <h3 id="reauth-modal-title" className="text-lg font-bold text-gray-900">
+              Verify your identity
+            </h3>
+            <p className="text-xs text-gray-500">
+              Step-up reauthentication for <span className="font-semibold text-gray-700">{username}</span>
+            </p>
+          </div>
+        </div>
+
+        <div className="mb-4 p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700">
+          For your security, please reauthenticate to continue with:{' '}
+          <span className="font-semibold text-gray-900">{actionDescription}</span>
+        </div>
+
+        {error && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        {mode === 'passkey' ? (
+          <div className="space-y-4">
+            <button
+              type="button"
+              onClick={handlePasskeyReauth}
+              disabled={loading}
+              className={`w-full flex items-center justify-center space-x-2 py-2.5 px-4 rounded-md shadow-xs text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 cursor-pointer ${
+                loading ? 'opacity-75 cursor-not-allowed' : ''
+              }`}
+            >
+              <svg className="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                />
+              </svg>
+              <span>{loading ? 'Waiting for passkey verification...' : 'Verify with a passkey'}</span>
+            </button>
+
+            <div className="text-center pt-1">
+              <button
+                type="button"
+                onClick={() => {
+                  setError(null);
+                  setMode('password');
+                }}
+                className="text-xs font-medium text-gray-600 hover:text-gray-900 underline cursor-pointer"
+              >
+                Use password instead
+              </button>
+            </div>
+          </div>
+        ) : (
+          <form onSubmit={handlePasswordReauth} className="space-y-4">
+            <div>
+              <label htmlFor="reauth-password" className="block text-xs font-semibold uppercase text-gray-600 mb-1">
+                Confirm Password
+              </label>
+              <input
+                id="reauth-password"
+                type="password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                placeholder="Enter your account password"
+                className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+
+            <div className="flex items-center space-x-2">
+              <button
+                type="submit"
+                disabled={loading}
+                className="flex-1 py-2.5 px-4 rounded-md text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 cursor-pointer"
+              >
+                {loading ? 'Verifying...' : 'Confirm Password'}
+              </button>
+              <button
+                type="button"
+                onClick={() => {
+                  setError(null);
+                  setMode('passkey');
+                }}
+                className="py-2.5 px-3 rounded-md text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 cursor-pointer"
+              >
+                Use Passkey
+              </button>
+            </div>
+          </form>
+        )}
+      </div>
+    </div>
+  );
+}
