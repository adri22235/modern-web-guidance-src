@@ -0,0 +1,95 @@
+import type { APIRoute } from 'astro';
+import {
+  addCredentialToUser,
+  consumeChallenge,
+  type StoredPasskeyCredential,
+} from '../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const {
+      username,
+      displayName,
+      email,
+      passkeyName,
+      credential,
+      metadata,
+    } = body;
+
+    if (!username || !credential?.id) {
+      return new Response(
+        JSON.stringify({ error: 'Username and WebAuthn credential are required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Parse clientDataJSON if present to verify type & challenge
+    if (credential.response?.clientDataJSON) {
+      try {
+        const clientDataStr = Buffer.from(credential.response.clientDataJSON, 'base64url').toString('utf8');
+        const clientData = JSON.parse(clientDataStr);
+        if (clientData.type && clientData.type !== 'webauthn.create') {
+          return new Response(
+            JSON.stringify({ error: 'Invalid WebAuthn clientData type.' }),
+            { status: 400, headers: { 'Content-Type': 'application/json' } }
+          );
+        }
+        if (clientData.challenge) {
+          consumeChallenge(clientData.challenge);
+        }
+      } catch {
+        // Non-fatal if clientDataJSON encoding differs
+      }
+    }
+
+    const now = new Date().toISOString();
+    const storedCred: StoredPasskeyCredential = {
+      id: credential.id,
+      rawId: credential.rawId || credential.id,
+      publicKey: credential.response?.publicKey || undefined,
+      algorithm: credential.response?.publicKeyAlgorithm ?? -7,
+      name: (passkeyName || metadata?.name || 'Passkey').trim(),
+      createdAt: now,
+      lastUsedAt: now,
+      transports: credential.response?.transports || metadata?.transports || ['internal', 'hybrid'],
+      authenticatorAttachment: credential.authenticatorAttachment || metadata?.authenticatorAttachment || 'platform',
+      backedUp: metadata?.backedUp ?? true,
+      deviceType: metadata?.deviceType || 'multiDevice',
+      aaguid: metadata?.aaguid || '00000000-0000-0000-0000-000000000000',
+      signCount: metadata?.signCount ?? 0,
+    };
+
+    const user = addCredentialToUser(username, storedCred, { displayName, email });
+
+    await session?.set('currentUser', {
+      id: user.id,
+      username: user.username,
+      displayName: user.displayName,
+      email: user.email,
+      authMethod: 'passkey',
+      lastAuthenticatedAt: now,
+      lastReauthenticatedAt: now,
+    });
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credential: storedCred,
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+          email: user.email,
+          credentials: user.credentials,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Passkey registration verification failed' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
