index 0000000..8cfeb34
--- /dev/null
+++ b/src/pages/api/passkeys/auth-options.ts
@@ -0,0 +1,66 @@
+import type { APIRoute } from 'astro';
+import {
+  createChallenge,
+  getUserByUsername,
+  type StoredPasskeyCredential,
+} from '../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const username = body.username?.trim();
+    const isReauth = Boolean(body.reauthenticate);
+    const clientAllowCredentials: StoredPasskeyCredential[] = Array.isArray(body.allowCredentials)
+      ? body.allowCredentials
+      : [];
+
+    const challenge = createChallenge(username);
+    await session?.set('passkeyChallenge', challenge);
+
+    const rpId = body.rpId || url.hostname || 'localhost';
+
+    const allowMap = new Map<string, string[]>();
+    if (username) {
+      const user = getUserByUsername(username);
+      if (user) {
+        for (const cred of user.credentials) {
+          allowMap.set(cred.id, cred.transports || ['internal', 'hybrid']);
+        }
+      }
+    }
+    for (const cred of clientAllowCredentials) {
+      if (cred?.id && !allowMap.has(cred.id)) {
+        allowMap.set(cred.id, cred.transports || ['internal', 'hybrid']);
+      }
+    }
+
+    // For general discoverable sign-in (and conditional UI), allowCredentials should be empty
+    // unless explicitly scoped (e.g., step-up reauthentication or user-scoped prompt).
+    const shouldScopeCredentials = isReauth || Boolean(body.scopeToUser && allowMap.size > 0);
+    const allowCredentials = shouldScopeCredentials
+      ? Array.from(allowMap.entries()).map(([id, transports]) => ({
+          id,
+          type: 'public-key' as const,
+          transports,
+        }))
+      : [];
+
+    const options = {
+      challenge,
+      rpId,
+      timeout: 60000,
+      userVerification: isReauth ? 'required' : 'preferred',
+      allowCredentials,
+    };
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Failed to generate authentication options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/auth-verify.ts b/src/pages/api/passkeys/auth-verify.ts
new file mode 100644
index 0000000..a245146
--- /dev/null
+++ b/src/pages/api/passkeys/auth-verify.ts
@@ -0,0 +1,130 @@
+import type { APIRoute } from 'astro';
+import {
+  addCredentialToUser,
+  consumeChallenge,
+  findUserByCredentialId,
+  findUserByUserHandle,
+  getOrCreateUser,
+} from '../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { credential, username, knownUser } = body;
+
+    if (!credential?.id) {
+      return new Response(
+        JSON.stringify({ error: 'WebAuthn assertion credential is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (credential.response?.clientDataJSON) {
+      try {
+        const clientDataStr = Buffer.from(credential.response.clientDataJSON, 'base64url').toString('utf8');
+        const clientData = JSON.parse(clientDataStr);
+        if (clientData.type && clientData.type !== 'webauthn.get') {
+          return new Response(
+            JSON.stringify({ error: 'Invalid WebAuthn clientData type.' }),
+            { status: 400, headers: { 'Content-Type': 'application/json' } }
+          );
+        }
+        if (clientData.challenge) {
+          consumeChallenge(clientData.challenge);
+        }
+      } catch {
+        // Ignore malformed clientDataJSON in custom/mocked environments
+      }
+    }
+
+    const now = new Date().toISOString();
+    let match = findUserByCredentialId(credential.id);
+
+    // Try matching by userHandle from authenticator assertion
+    if (!match && credential.response?.userHandle) {
+      const userByHandle = findUserByUserHandle(credential.response.userHandle);
+      if (userByHandle) {
+        const existingCred = userByHandle.credentials.find((c) => c.id === credential.id);
+        if (existingCred) {
+          match = { user: userByHandle, credential: existingCred };
+        }
+      }
+    }
+
+    // Also decode userHandle if it embeds `user:<username>:`
+    let decodedUsernameFromHandle: string | undefined;
+    if (!match && credential.response?.userHandle) {
+      try {
+        const decoded = Buffer.from(credential.response.userHandle, 'base64url').toString('utf8');
+        if (decoded.startsWith('user:')) {
+          const parts = decoded.split(':');
+          if (parts[1]) decodedUsernameFromHandle = parts[1];
+        } else if (/^[\w.@+-]+$/.test(decoded)) {
+          decodedUsernameFromHandle = decoded;
+        }
+      } catch {
+        // ignore
+      }
+    }
+
+    if (!match) {
+      const resolvedUsername =
+        username ||
+        knownUser?.username ||
+        decodedUsernameFromHandle ||
+        'passkey-user';
+
+      const syncedCred = knownUser?.credential || {
+        id: credential.id,
+        rawId: credential.rawId || credential.id,
+        name: 'Passkey',
+        createdAt: now,
+        lastUsedAt: now,
+        transports: ['internal', 'hybrid'],
+        authenticatorAttachment: credential.authenticatorAttachment || 'platform',
+        backedUp: true,
+        deviceType: 'multiDevice' as const,
+      };
+      syncedCred.lastUsedAt = now;
+
+      const user = addCredentialToUser(resolvedUsername, syncedCred, {
+        displayName: knownUser?.displayName || resolvedUsername,
+        email: knownUser?.email,
+      });
+      match = { user, credential: syncedCred };
+    } else {
+      match.credential.lastUsedAt = now;
+    }
+
+    await session?.set('currentUser', {
+      id: match.user.id,
+      username: match.user.username,
+      displayName: match.user.displayName,
+      email: match.user.email,
+      authMethod: 'passkey',
+      lastAuthenticatedAt: now,
+      lastReauthenticatedAt: now,
+    });
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        reauthenticatedAt: now,
+        credential: match.credential,
+        user: {
+          id: match.user.id,
+          username: match.user.username,
+          displayName: match.user.displayName,
+          email: match.user.email,
+          credentials: match.user.credentials,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Passkey authentication verification failed' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
