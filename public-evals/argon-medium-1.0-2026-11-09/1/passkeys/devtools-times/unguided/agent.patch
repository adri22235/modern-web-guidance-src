+import type { APIRoute } from 'astro';
+import {
+  createChallenge,
+  getOrCreateUser,
+  type StoredPasskeyCredential,
+} from '../../../utils/passkeyStore';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const username = (body.username || 'reader').trim();
+    const displayName = (body.displayName || username).trim();
+    const email = (body.email || `${username.toLowerCase()}@devtoolstimes.dev`).trim();
+    const clientCredentials: StoredPasskeyCredential[] = Array.isArray(body.existingCredentials)
+      ? body.existingCredentials
+      : [];
+
+    const user = getOrCreateUser(username, { displayName, email });
+    const challenge = createChallenge(username);
+
+    await session?.set('passkeyChallenge', challenge);
+    await session?.set('passkeyPendingUsername', user.username);
+
+    // Combine server-known and client-known credentials for excludeCredentials
+    const mergedIds = new Map<string, string[]>();
+    for (const cred of user.credentials) {
+      mergedIds.set(cred.id, cred.transports || ['internal', 'hybrid']);
+    }
+    for (const cred of clientCredentials) {
+      if (cred?.id && !mergedIds.has(cred.id)) {
+        mergedIds.set(cred.id, cred.transports || ['internal', 'hybrid']);
+      }
+    }
+
+    const excludeCredentials = Array.from(mergedIds.entries()).map(([id, transports]) => ({
+      id,
+      type: 'public-key' as const,
+      transports,
+    }));
+
+    const rpId = body.rpId || url.hostname || 'localhost';
+
+    const options = {
+      challenge,
+      rp: {
+        name: 'The DevTools Times',
+        id: rpId,
+      },
+      user: {
+        id: user.id,
+        name: user.username,
+        displayName: user.displayName,
+      },
+      pubKeyCredParams: [
+        { type: 'public-key', alg: -7 },   // ES256
+        { type: 'public-key', alg: -257 }, // RS256
+        { type: 'public-key', alg: -8 },   // EdDSA
+      ],
+      timeout: 60000,
+      attestation: 'none',
+      excludeCredentials,
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'required',
+      },
+    };
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Failed to generate registration options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
