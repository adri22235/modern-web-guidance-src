+
+export function bufferToBase64url(buffer: ArrayBuffer | Uint8Array): string {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
+}
+
+export function base64urlToBuffer(base64url: string): Uint8Array {
+  const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+  const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const rawData = atob(base64);
+  const outputArray = new Uint8Array(rawData.length);
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray;
+}
+
+export function stringToBase64url(input: string): string {
+  const encoder = new TextEncoder();
+  return bufferToBase64url(encoder.encode(input));
+}
+
+export function generateRandomBase64url(length = 32): string {
+  const bytes = new Uint8Array(length);
+  if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+    crypto.getRandomValues(bytes);
+  } else {
+    for (let i = 0; i < length; i++) {
+      bytes[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  return bufferToBase64url(bytes);
+}
+
+export function detectDefaultPasskeyName(aaguid?: string): string {
+  if (aaguid && KNOWN_AAGUIDS[aaguid] && aaguid !== '00000000-0000-0000-0000-000000000000') {
+    return KNOWN_AAGUIDS[aaguid];
+  }
+  if (typeof navigator === 'undefined') return 'This Device Passkey';
+  const ua = navigator.userAgent || '';
+  const platform = (navigator as any).userAgentData?.platform || navigator.platform || '';
+
+  let browser = 'Browser';
+  if (ua.includes('Edg/')) browser = 'Edge';
+  else if (ua.includes('Chrome/')) browser = 'Chrome';
+  else if (ua.includes('Firefox/')) browser = 'Firefox';
+  else if (ua.includes('Safari/')) browser = 'Safari';
+
+  let os = 'Device';
+  if (/Mac/i.test(platform) || /Macintosh/i.test(ua)) os = 'macOS';
+  else if (/Win/i.test(platform) || /Windows/i.test(ua)) os = 'Windows';
+  else if (/Android/i.test(ua)) os = 'Android';
+  else if (/iPhone|iPad|iPod/i.test(ua)) os = 'iOS';
+  else if (/Linux/i.test(platform) || /Linux/i.test(ua)) os = 'Linux';
+
+  return `${browser} on ${os}`;
+}
+
+export function parseAuthenticatorData(authDataBuffer?: ArrayBuffer | Uint8Array | null): {
+  userPresent: boolean;
+  userVerified: boolean;
+  backupEligible: boolean;
+  backedUp: boolean;
+  signCount: number;
+  aaguid: string;
+  providerName?: string;
+} {
+  const defaults = {
+    userPresent: true,
+    userVerified: true,
+    backupEligible: true,
+    backedUp: true,
+    signCount: 0,
+    aaguid: '00000000-0000-0000-0000-000000000000',
+    providerName: undefined as string | undefined,
+  };
+
+  if (!authDataBuffer) return defaults;
+  const bytes = authDataBuffer instanceof Uint8Array ? authDataBuffer : new Uint8Array(authDataBuffer);
+  if (bytes.byteLength < 37) return defaults;
+
+  const flags = bytes[32];
+  const userPresent = Boolean(flags & 0x01);
+  const userVerified = Boolean(flags & 0x04);
+  const backupEligible = Boolean(flags & 0x08);
+  const backedUp = Boolean(flags & 0x10);
+  const attestedCredDataIncluded = Boolean(flags & 0x40);
+
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const signCount = view.getUint32(33, false);
+
+  let aaguid = defaults.aaguid;
+  if (attestedCredDataIncluded && bytes.byteLength >= 53) {
+    const aaguidBytes = bytes.slice(37, 53);
+    const hex = Array.from(aaguidBytes)
+      .map((b) => b.toString(16).padStart(2, '0'))
+      .join('');
+    aaguid = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
+  }
+
+  return {
+    userPresent,
+    userVerified,
+    backupEligible,
+    backedUp: backupEligible ? backedUp || true : false,
+    signCount,
+    aaguid,
+    providerName: KNOWN_AAGUIDS[aaguid],
+  };
+}
+
+export async function checkPasskeyCapabilities(): Promise<PasskeyCapabilities> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') {
+    return {
+      webauthnSupported: false,
+      platformAuthenticatorAvailable: false,
+      conditionalMediationAvailable: false,
+      signalApiSupported: false,
+    };
+  }
+
+  const PKC = window.PublicKeyCredential as any;
+  let platformAuthenticatorAvailable = false;
+  let conditionalMediationAvailable = false;
+  let rawCapabilities: Record<string, boolean> | undefined;
+
+  try {
+    if (typeof PKC.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      platformAuthenticatorAvailable = await PKC.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    platformAuthenticatorAvailable = false;
+  }
+
+  try {
+    if (typeof PKC.isConditionalMediationAvailable === 'function') {
+      conditionalMediationAvailable = await PKC.isConditionalMediationAvailable();
+    }
+  } catch {
+    conditionalMediationAvailable = false;
+  }
+
+  try {
+    if (typeof PKC.getClientCapabilities === 'function') {
+      rawCapabilities = await PKC.getClientCapabilities();
+    }
+  } catch {
+    // ignore if unsupported
+  }
+
+  const signalApiSupported =
+    typeof PKC.signalAllAcceptedCredentials === 'function' ||
+    typeof PKC.signalCurrentUserDetails === 'function' ||
+    typeof PKC.signalUnknownCredential === 'function';
+
+  return {
+    webauthnSupported: true,
+    platformAuthenticatorAvailable,
+    conditionalMediationAvailable,
+    signalApiSupported,
+    passkeyPlatformAuthenticator: rawCapabilities?.passkeyPlatformAuthenticator,
+    rawCapabilities,
+  };
+}
+
+export function getStoredAccounts(): Record<string, UserAccount> {
+  if (typeof window === 'undefined') return {};
+  try {
+    const raw = window.localStorage.getItem(ACCOUNTS_STORAGE_KEY);
+    if (!raw) return {};
+    return JSON.parse(raw);
+  } catch {
+    return {};
+  }
+}
+
+export function saveStoredAccounts(accounts: Record<string, UserAccount>): void {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.setItem(ACCOUNTS_STORAGE_KEY, JSON.stringify(accounts));
+  } catch {
+    // ignore storage errors
+  }
+}
+
+export function getStoredAccount(username: string): UserAccount | undefined {
+  const accounts = getStoredAccounts();
+  return accounts[username.trim().toLowerCase()];
+}
+
+export function upsertStoredAccount(
+  username: string,
+  updates: Partial<UserAccount> & { credentialToAdd?: PasskeyCredential }
+): UserAccount {
+  const accounts = getStoredAccounts();
+  const key = username.trim().toLowerCase();
+  const existing = accounts[key];
+  const now = new Date().toISOString();
+
+  const updated: UserAccount = existing
+    ? {
+        ...existing,
+        ...updates,
+        username: existing.username,
+        credentials: updates.credentials ?? existing.credentials ?? [],
+      }
+    : {
+        id: updates.id || stringToBase64url(`user:${key}:${Date.now()}`),
+        username: username.trim(),
+        displayName: updates.displayName || username.trim(),
+        email: updates.email || `${key}@devtoolstimes.dev`,
+        password: updates.password,
+        passwordlessOnly: updates.passwordlessOnly ?? !updates.password,
+        createdAt: now,
+        credentials: updates.credentials || [],
+      };
+
+  if (updates.credentialToAdd) {
+    const cred = updates.credentialToAdd;
+    const idx = updated.credentials.findIndex((c) => c.id === cred.id);
+    if (idx >= 0) {
+      updated.credentials[idx] = cred;
+    } else {
+      updated.credentials = [cred, ...updated.credentials];
+    }
+  }
+
+  accounts[key] = updated;
+  saveStoredAccounts(accounts);
+  return updated;
+}
+
+export function findAccountByCredentialId(credentialId: string): {
+  account: UserAccount;
+  credential: PasskeyCredential;
+} | null {
+  const accounts = getStoredAccounts();
+  for (const account of Object.values(accounts)) {
+    const cred = account.credentials.find((c) => c.id === credentialId);
+    if (cred) {
+      return { account, credential: cred };
+    }
+  }
+  return null;
+}
+
+export function getCurrentSession(): AuthSession | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = window.localStorage.getItem(SESSION_STORAGE_KEY);
+    if (!raw) return null;
+    return JSON.parse(raw);
+  } catch {
+    return null;
+  }
+}
+
+export function setCurrentSession(session: AuthSession | null): void {
+  if (typeof window === 'undefined') return;
+  try {
+    if (session) {
+      window.localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(session));
+    } else {
+      window.localStorage.removeItem(SESSION_STORAGE_KEY);
+    }
+    window.dispatchEvent(new CustomEvent(AUTH_CHANGE_EVENT, { detail: session }));
+  } catch {
+    // ignore
+  }
+}
+
+export function signOutUser(): void {
+  setCurrentSession(null);
+}
+
+export function isRecentlyReauthenticated(session: AuthSession | null, ttlMs = REAUTH_TTL_MS): boolean {
+  if (!session?.lastReauthenticatedAt) return false;
+  const elapsed = Date.now() - new Date(session.lastReauthenticatedAt).getTime();
+  return elapsed >= 0 && elapsed < ttlMs;
+}
+
+export async function signalAcceptedCredentials(user: UserAccount): Promise<void> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') return;
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC.signalAllAcceptedCredentials === 'function') {
+    try {
+      await PKC.signalAllAcceptedCredentials({
+        rpId: window.location.hostname,
+        userId: user.id,
+        allAcceptedCredentialIds: user.credentials.map((c) => c.id),
+      });
+    } catch {
+      // ignore if browser rejects signal call
+    }
+  }
+}
+
+export async function signalUserDetails(user: UserAccount): Promise<void> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') return;
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC.signalCurrentUserDetails === 'function') {
+    try {
+      await PKC.signalCurrentUserDetails({
+        rpId: window.location.hostname,
+        userId: user.id,
+        name: user.username,
+        displayName: user.displayName,
+      });
+    } catch {
+      // ignore
+    }
+  }
+}
+
+export async function signalUnknownPasskey(credentialId: string): Promise<void> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') return;
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC.signalUnknownCredential === 'function') {
+    try {
+      await PKC.signalUnknownCredential({
+        rpId: window.location.hostname,
+        credentialId,
+      });
+    } catch {
+      // ignore
+    }
+  }
+}
+
+function getApiBaseUrl(): string {
+  const base = import.meta.env.BASE_URL || '/';
+  return base.endsWith('/') ? base : `${base}/`;
+}
+
+export async function registerPasskey(params: {
+  username: string;
+  displayName?: string;
+  email?: string;
+  passkeyName?: string;
+  authenticatorAttachment?: AuthenticatorAttachment;
+}): Promise<{ account: UserAccount; credential: PasskeyCredential; session: AuthSession }> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !navigator.credentials) {
+    throw new Error('Passkeys (WebAuthn) are not supported in this browser environment.');
+  }
+
+  const cleanUsername = params.username.trim();
+  if (!cleanUsername) {
+    throw new Error('Please enter a username before creating a passkey.');
+  }
+
+  const existingAccount = getStoredAccount(cleanUsername);
+  const displayName = (params.displayName || existingAccount?.displayName || cleanUsername).trim();
+  const email = (params.email || existingAccount?.email || `${cleanUsername.toLowerCase()}@devtoolstimes.dev`).trim();
+  const existingCredentials = existingAccount?.credentials || [];
+  const rpId = window.location.hostname || 'localhost';
+
+  // 1. Fetch creation options from server API (with fallback)
+  let serverOptions: any;
+  try {
+    const res = await fetch(`${getApiBaseUrl()}api/passkeys/register-options`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: cleanUsername,
+        displayName,
+        email,
+        rpId,
+        existingCredentials,
+      }),
+    });
+    if (res.ok) {
+      serverOptions = await res.json();
+    }
+  } catch {
+    // Fallback to locally generated options if offline
+  }
+
+  const challengeB64 = serverOptions?.challenge || generateRandomBase64url(32);
+  const userIdB64 =
+    existingAccount?.id ||
+    serverOptions?.user?.id ||
+    stringToBase64url(`user:${cleanUsername.toLowerCase()}:${Date.now()}`);
+
+  const excludeCredentials: PublicKeyCredentialDescriptor[] = (
+    serverOptions?.excludeCredentials ||
+    existingCredentials.map((c) => ({
+      id: c.id,
+      type: 'public-key',
+      transports: c.transports,
+    }))
+  ).map((cred: any) => ({
+    id: base64urlToBuffer(cred.id),
+    type: 'public-key' as const,
+    transports: cred.transports as AuthenticatorTransport[] | undefined,
+  }));
+
+  const authenticatorSelection: AuthenticatorSelectionCriteria = {
+    residentKey: 'required',
+    requireResidentKey: true,
+    userVerification: 'required',
+    ...(params.authenticatorAttachment
+      ? { authenticatorAttachment: params.authenticatorAttachment }
+      : {}),
+  };
+
+  const publicKey: PublicKeyCredentialCreationOptions = {
+    challenge: base64urlToBuffer(challengeB64),
+    rp: {
+      name: 'The DevTools Times',
+      id: rpId,
+    },
+    user: {
+      id: base64urlToBuffer(userIdB64),
+      name: cleanUsername,
+      displayName,
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },   // ES256
+      { type: 'public-key', alg: -257 }, // RS256
+      { type: 'public-key', alg: -8 },   // EdDSA
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials,
+    authenticatorSelection,
+  };
+
+  // 2. Invoke WebAuthn navigator.credentials.create()
+  let cred: PublicKeyCredential | null = null;
+  try {
+    cred = (await navigator.credentials.create({ publicKey })) as PublicKeyCredential | null;
+  } catch (err: any) {
+    if (err?.name === 'InvalidStateError') {
+      throw new Error('A passkey is already registered on this device or authenticator for this account.');
+    }
+    if (err?.name === 'NotAllowedError') {
+      throw new Error('Passkey registration was cancelled or timed out.');
+    }
+    throw new Error(err?.message || 'Failed to create passkey with your authenticator.');
+  }
+
+  if (!cred) {
+    throw new Error('Passkey creation did not return a valid credential.');
+  }
+
+  const attestationResponse = cred.response as AuthenticatorAttestationResponse & {
+    getTransports?: () => string[];
+    getPublicKey?: () => ArrayBuffer | null;
+    getPublicKeyAlgorithm?: () => number;
+    getAuthenticatorData?: () => ArrayBuffer;
+  };
+
+  const rawIdB64 = bufferToBase64url(cred.rawId);
+  const credentialId = cred.id || rawIdB64;
+  const transports =
+    typeof attestationResponse.getTransports === 'function'
+      ? attestationResponse.getTransports()
+      : ['internal', 'hybrid'];
+  const pubKeyBuf =
+    typeof attestationResponse.getPublicKey === 'function'
+      ? attestationResponse.getPublicKey()
+      : null;
+  const publicKeyB64 = pubKeyBuf ? bufferToBase64url(pubKeyBuf) : undefined;
+  const algorithm =
+    typeof attestationResponse.getPublicKeyAlgorithm === 'function'
+      ? attestationResponse.getPublicKeyAlgorithm()
+      : -7;
+  const authDataBuf =
+    typeof attestationResponse.getAuthenticatorData === 'function'
+      ? attestationResponse.getAuthenticatorData()
+      : null;
+
+  const parsedAuthData = parseAuthenticatorData(authDataBuf);
+  const defaultName = params.passkeyName?.trim() || detectDefaultPasskeyName(parsedAuthData.aaguid);
+  const now = new Date().toISOString();
+
+  const serializedCredential = {
+    id: credentialId,
+    rawId: rawIdB64,
+    type: cred.type,
+    authenticatorAttachment: (cred as any).authenticatorAttachment || 'platform',
+    response: {
+      clientDataJSON: bufferToBase64url(attestationResponse.clientDataJSON),
+      attestationObject: bufferToBase64url(attestationResponse.attestationObject),
+      transports,
+      publicKey: publicKeyB64,
+      publicKeyAlgorithm: algorithm,
+    },
+  };
+
+  let verifiedCred: PasskeyCredential = {
+    id: credentialId,
+    rawId: rawIdB64,
+    publicKey: publicKeyB64,
+    algorithm,
+    name: defaultName,
+    createdAt: now,
+    lastUsedAt: now,
+    transports,
+    authenticatorAttachment: (cred as any).authenticatorAttachment || 'platform',
+    backedUp: parsedAuthData.backedUp,
+    deviceType: parsedAuthData.backupEligible ? 'multiDevice' : 'singleDevice',
+    aaguid: parsedAuthData.aaguid,
+    providerName: parsedAuthData.providerName,
+    signCount: parsedAuthData.signCount,
+  };
+
+  // 3. Verify & persist on server
+  try {
+    const verifyRes = await fetch(`${getApiBaseUrl()}api/passkeys/register-verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: cleanUsername,
+        displayName,
+        email,
+        passkeyName: defaultName,
+        credential: serializedCredential,
+        metadata: {
+          name: defaultName,
+          transports,
+          authenticatorAttachment: verifiedCred.authenticatorAttachment,
+          backedUp: verifiedCred.backedUp,
+          deviceType: verifiedCred.deviceType,
+          aaguid: verifiedCred.aaguid,
+          signCount: verifiedCred.signCount,
+        },
+      }),
+    });
+    if (verifyRes.ok) {
+      const verifyData = await verifyRes.json();
+      if (verifyData.credential) {
+        verifiedCred = {
+          ...verifiedCred,
+          ...verifyData.credential,
+          providerName: verifiedCred.providerName,
+        };
+      }
+    }
+  } catch {
+    // Keep client-verified credential if server endpoint is unreachable
+  }
+
+  const account = upsertStoredAccount(cleanUsername, {
+    id: userIdB64,
+    displayName,
+    email,
+    credentialToAdd: verifiedCred,
+  });
+
+  const session: AuthSession = {
+    userId: account.id,
+    username: account.username,
+    displayName: account.displayName,
+    email: account.email,
+    authMethod: 'passkey',
+    credentialId: verifiedCred.id,
+    authenticatedAt: now,
+    lastReauthenticatedAt: now,
+  };
+
+  setCurrentSession(session);
+  await signalAcceptedCredentials(account);
+
+  return { account, credential: verifiedCred, session };
+}
+
+export async function authenticateWithPasskey(params?: {
+  username?: string;
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+  reauthenticate?: boolean;
+  allowCredentials?: PasskeyCredential[];
+}): Promise<{ account: UserAccount; credential: PasskeyCredential; session: AuthSession }> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !navigator.credentials) {
+    throw new Error('Passkeys (WebAuthn) are not supported in this browser environment.');
+  }
+
+  const cleanUsername = params?.username?.trim();
+  const isReauth = Boolean(params?.reauthenticate);
+  const rpId = window.location.hostname || 'localhost';
+
+  const existingAccount = cleanUsername ? getStoredAccount(cleanUsername) : undefined;
+  const allowCredsList = params?.allowCredentials || existingAccount?.credentials || [];
+
+  let serverOptions: any;
+  try {
+    const res = await fetch(`${getApiBaseUrl()}api/passkeys/auth-options`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: cleanUsername,
+        rpId,
+        reauthenticate: isReauth,
+        allowCredentials: allowCredsList,
+      }),
+      signal: params?.signal,
+    });
+    if (res.ok) {
+      serverOptions = await res.json();
+    }
+  } catch (err: any) {
+    if (err?.name === 'AbortError') throw err;
+  }
+
+  const challengeB64 = serverOptions?.challenge || generateRandomBase64url(32);
+
+  // Scope allowCredentials during step-up reauthentication; leave empty for discoverable login / conditional UI
+  const allowCredentials: PublicKeyCredentialDescriptor[] = isReauth
+    ? allowCredsList.map((c) => ({
+        id: base64urlToBuffer(c.id),
+        type: 'public-key' as const,
+        transports: (c.transports || ['internal', 'hybrid']) as AuthenticatorTransport[],
+      }))
+    : [];
+
+  const publicKey: PublicKeyCredentialRequestOptions = {
+    challenge: base64urlToBuffer(challengeB64),
+    rpId,
+    timeout: 60000,
+    userVerification: isReauth ? 'required' : 'preferred',
+    ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+  };
+
+  let assertion: PublicKeyCredential | null = null;
+  try {
+    assertion = (await navigator.credentials.get({
+      publicKey,
+      mediation: params?.mediation,
+      signal: params?.signal,
+    })) as PublicKeyCredential | null;
+  } catch (err: any) {
+    if (err?.name === 'AbortError') {
+      throw err;
+    }
+    if (err?.name === 'NotAllowedError') {
+      throw new Error('Passkey verification was cancelled or not allowed.');
+    }
+    throw new Error(err?.message || 'Passkey authentication failed.');
+  }
+
+  if (!assertion) {
+    throw new Error('No passkey credential was selected.');
+  }
+
+  const assertionResponse = assertion.response as AuthenticatorAssertionResponse;
+  const rawIdB64 = bufferToBase64url(assertion.rawId);
+  const credentialId = assertion.id || rawIdB64;
+  const userHandleB64 = assertionResponse.userHandle
+    ? bufferToBase64url(assertionResponse.userHandle)
+    : undefined;
+
+  const localMatch = findAccountByCredentialId(credentialId);
+
+  const serializedAssertion = {
+    id: credentialId,
+    rawId: rawIdB64,
+    type: assertion.type,
+    authenticatorAttachment: (assertion as any).authenticatorAttachment || 'platform',
+    response: {
+      clientDataJSON: bufferToBase64url(assertionResponse.clientDataJSON),
+      authenticatorData: bufferToBase64url(assertionResponse.authenticatorData),
+      signature: bufferToBase64url(assertionResponse.signature),
+      userHandle: userHandleB64,
+    },
+  };
+
+  let serverVerifyData: any = null;
+  try {
+    const verifyRes = await fetch(`${getApiBaseUrl()}api/passkeys/auth-verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: cleanUsername || localMatch?.account.username,
+        credential: serializedAssertion,
+        knownUser: localMatch
+          ? {
+              username: localMatch.account.username,
+              displayName: localMatch.account.displayName,
+              email: localMatch.account.email,
+              credential: localMatch.credential,
+            }
+          : undefined,
+      }),
+    });
+    if (verifyRes.ok) {
+      serverVerifyData = await verifyRes.json();
+    }
+  } catch {
+    // Fallback to local verification
+  }
+
+  const now = new Date().toISOString();
+  const parsedAuthData = parseAuthenticatorData(assertionResponse.authenticatorData);
+
+  // Decode username from userHandle if needed
+  let handleUsername: string | undefined;
+  if (userHandleB64) {
+    try {
+      const bytes = base64urlToBuffer(userHandleB64);
+      const decoded = new TextDecoder().decode(bytes);
+      if (decoded.startsWith('user:')) {
+        const parts = decoded.split(':');
+        if (parts[1]) handleUsername = parts[1];
+      } else if (/^[\w.@+-]+$/.test(decoded)) {
+        handleUsername = decoded;
+      }
+    } catch {
+      // ignore
+    }
+  }
+
+  const resolvedUsername =
+    localMatch?.account.username ||
+    serverVerifyData?.user?.username ||
+    cleanUsername ||
+    handleUsername ||
+    'devtools-reader';
+
+  const matchedCredential: PasskeyCredential = localMatch?.credential
+    ? {
+        ...localMatch.credential,
+        lastUsedAt: now,
+        signCount: parsedAuthData.signCount || localMatch.credential.signCount,
+      }
+    : serverVerifyData?.credential || {
+        id: credentialId,
+        rawId: rawIdB64,
+        name: detectDefaultPasskeyName(parsedAuthData.aaguid),
+        createdAt: now,
+        lastUsedAt: now,
+        transports: ['internal', 'hybrid'],
+        authenticatorAttachment: (assertion as any).authenticatorAttachment || 'platform',
+        backedUp: parsedAuthData.backedUp,
+        deviceType: parsedAuthData.backupEligible ? 'multiDevice' : 'singleDevice',
+        aaguid: parsedAuthData.aaguid,
+        signCount: parsedAuthData.signCount,
+      };
+
+  const account = upsertStoredAccount(resolvedUsername, {
+    id: localMatch?.account.id || serverVerifyData?.user?.id || userHandleB64,
+    displayName: localMatch?.account.displayName || serverVerifyData?.user?.displayName || resolvedUsername,
+    email: localMatch?.account.email || serverVerifyData?.user?.email,
+    credentialToAdd: matchedCredential,
+  });
+
+  const session: AuthSession = {
+    userId: account.id,
+    username: account.username,
+    displayName: account.displayName,
+    email: account.email,
+    authMethod: 'passkey',
+    credentialId: matchedCredential.id,
+    authenticatedAt: getCurrentSession()?.authenticatedAt || now,
+    lastReauthenticatedAt: now,
+  };
+
+  setCurrentSession(session);
+
+  return { account, credential: matchedCredential, session };
+}
+
+export async function reauthenticateWithPasskey(
+  username?: string
+): Promise<{ account: UserAccount; credential: PasskeyCredential; session: AuthSession }> {
+  const currentSession = getCurrentSession();
+  const targetUsername = username || currentSession?.username;
+  const account = targetUsername ? getStoredAccount(targetUsername) : undefined;
+
+  return authenticateWithPasskey({
+    username: targetUsername,
+    reauthenticate: true,
+    allowCredentials: account?.credentials,
+  });
+}
+
+export function verifyPasswordReauth(username: string, passwordInput: string): AuthSession {
+  const account = getStoredAccount(username);
+  if (account?.password && account.password !== passwordInput) {
+    throw new Error('Incorrect password. Please try again or verify with a passkey.');
+  }
+  if (!passwordInput || passwordInput.length < 1) {
+    throw new Error('Please enter your password to verify your identity.');
+  }
+
+  const now = new Date().toISOString();
+  const updatedAccount = upsertStoredAccount(username, {});
+  const currentSession = getCurrentSession();
+
+  const session: AuthSession = {
+    userId: updatedAccount.id,
+    username: updatedAccount.username,
+    displayName: updatedAccount.displayName,
+    email: updatedAccount.email,
+    authMethod: currentSession?.authMethod || 'password',
+    credentialId: currentSession?.credentialId,
+    authenticatedAt: currentSession?.authenticatedAt || now,
+    lastReauthenticatedAt: now,
+  };
+
+  setCurrentSession(session);
+  return session;
+}
+
+export async function renamePasskey(
+  username: string,
+  credentialId: string,
+  newName: string
+): Promise<UserAccount> {
+  const cleanName = newName.trim();
+  if (!cleanName) {
+    throw new Error('Passkey name cannot be empty.');
+  }
+
+  const account = getStoredAccount(username);
+  if (!account) {
+    throw new Error('Account not found.');
+  }
+
+  const updatedCredentials = account.credentials.map((cred) =>
+    cred.id === credentialId ? { ...cred, name: cleanName } : cred
+  );
+
+  const updatedAccount = upsertStoredAccount(username, {
+    credentials: updatedCredentials,
+  });
+
+  try {
+    await fetch(`${getApiBaseUrl()}api/passkeys/credentials`, {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username,
+        credentialId,
+        name: cleanName,
+      }),
+    });
+  } catch {
+    // ignore offline error
+  }
+
+  return updatedAccount;
+}
+
+export async function deletePasskey(username: string, credentialId: string): Promise<UserAccount> {
+  const account = getStoredAccount(username);
+  if (!account) {
+    throw new Error('Account not found.');
+  }
+
+  const updatedCredentials = account.credentials.filter((cred) => cred.id !== credentialId);
+  const updatedAccount = upsertStoredAccount(username, {
+    credentials: updatedCredentials,
+  });
+
+  try {
+    await fetch(`${getApiBaseUrl()}api/passkeys/credentials`, {
+      method: 'DELETE',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username,
+        credentialId,
+      }),
+    });
+  } catch {
+    // ignore offline error
+  }
+
+  await signalAcceptedCredentials(updatedAccount);
+  return updatedAccount;
+}
+
+export async function updateUserProfile(
+  username: string,
+  updates: { displayName?: string; email?: string; passwordlessOnly?: boolean; password?: string }
+): Promise<UserAccount> {
+  const updatedAccount = upsertStoredAccount(username, updates);
+
+  const currentSession = getCurrentSession();
+  if (currentSession && currentSession.username.toLowerCase() === username.toLowerCase()) {
+    setCurrentSession({
+      ...currentSession,
+      displayName: updatedAccount.displayName,
+      email: updatedAccount.email,
+    });
+  }
+
+  try {
+    await fetch(`${getApiBaseUrl()}api/passkeys/credentials`, {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username,
+        displayName: updatedAccount.displayName,
+        email: updatedAccount.email,
+        passwordlessOnly: updatedAccount.passwordlessOnly,
+      }),
+    });
+  } catch {
+    // ignore
+  }
+
+  await signalUserDetails(updatedAccount);
+  return updatedAccount;
+}
