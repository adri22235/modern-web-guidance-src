@@ -0,0 +1,41 @@
+import type { APIRoute } from 'astro';
+import { db, getActiveSessionUser, RP_ID } from '../../utils/auth-db';
+
+export const GET: APIRoute = async ({ session }) => {
+  const user = await getActiveSessionUser(session);
+  const isSignedIn = Boolean(await session?.get('userId'));
+
+  return new Response(
+    JSON.stringify({
+      id: user.id,
+      passkeyUserId: user.passkeyUserId,
+      userId: user.passkeyUserId,
+      name: user.name,
+      displayName: user.displayName,
+      rpId: RP_ID,
+      signedIn: isSignedIn,
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  const user = await getActiveSessionUser(session);
+  const body = await request.json();
+  const { name, displayName } = body;
+
+  const updatedUser =
+    db.updateUser(user.passkeyUserId, { name, displayName }) || user;
+
+  return new Response(
+    JSON.stringify({
+      id: updatedUser.id,
+      passkeyUserId: updatedUser.passkeyUserId,
+      userId: updatedUser.passkeyUserId,
+      name: updatedUser.name,
+      displayName: updatedUser.displayName,
+      rpId: RP_ID,
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
