+import type { APIRoute } from 'astro';
+import { db, getActiveSessionUser, RP_ID } from '../../../utils/auth-db';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = await getActiveSessionUser(session);
+  const cred = db.findCredentialById(id);
+
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const body = await request.json();
+  const newName = typeof body?.name === 'string' ? body.name.trim() : '';
+  if (!newName) {
+    return new Response(
+      JSON.stringify({ error: 'A valid passkey name is required.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  cred.name = newName;
+  db.saveCredential(cred);
+
+  return new Response(JSON.stringify(cred), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = await getActiveSessionUser(session);
+  const cred = db.findCredentialById(id);
+
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  db.deleteCredential(id);
+
+  return new Response(
+    JSON.stringify({
+      success: true,
+      rpId: RP_ID,
+      userId: user.passkeyUserId,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
