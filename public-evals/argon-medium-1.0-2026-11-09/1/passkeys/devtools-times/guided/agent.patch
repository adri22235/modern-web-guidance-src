index 0000000..1a50799
--- /dev/null
+++ b/src/pages/api/passkeys/login/verify.ts
@@ -0,0 +1,95 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { db, EXPECTED_ORIGINS, RP_ID } from '../../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const responsePayload = await request.json();
+    const credentialId = responsePayload?.id;
+
+    if (!credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'Missing credential ID.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const storedCredential = db.findCredentialById(credentialId);
+    if (!storedCredential) {
+      // Explicit HTTP 404 when credential ID is not found in the database so client triggers Signal API
+      return new Response(
+        JSON.stringify({ error: 'Passkey credential not found.' }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const expectedChallenge = await session?.get('challenge');
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Authentication challenge expired or missing.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const expectedUserVerification =
+      (await session?.get('expectedUserVerification')) || 'preferred';
+    const requireUserVerification = expectedUserVerification === 'required';
+
+    const requestOrigin = request.headers.get('origin');
+    const allowedOrigins = requestOrigin
+      ? Array.from(new Set([...EXPECTED_ORIGINS, requestOrigin]))
+      : EXPECTED_ORIGINS;
+
+    const verification = await verifyAuthenticationResponse({
+      response: responsePayload,
+      expectedChallenge,
+      expectedOrigin: allowedOrigins,
+      expectedRPID: RP_ID,
+      credential: {
+        id: storedCredential.id,
+        publicKey: new Uint8Array(
+          Buffer.from(storedCredential.credentialPublicKey, 'base64url')
+        ),
+        counter: storedCredential.counter,
+        transports: storedCredential.transports as any,
+      },
+      requireUserVerification,
+    });
+
+    if (!verification.verified) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey authentication verification failed.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    storedCredential.counter = verification.authenticationInfo.newCounter;
+    storedCredential.lastUsedAt = Date.now();
+    db.saveCredential(storedCredential);
+
+    const user =
+      db.findUserById(storedCredential.passkeyUserId) || db.getDefaultUser();
+    await session?.set('userId', user.passkeyUserId);
+    await session?.set('challenge', undefined);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+        user: {
+          id: user.id,
+          passkeyUserId: user.passkeyUserId,
+          name: user.name,
+          displayName: user.displayName,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to verify passkey assertion.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/register/options.ts b/src/pages/api/passkeys/register/options.ts
new file mode 100644
index 0000000..d0888f9
--- /dev/null
+++ b/src/pages/api/passkeys/register/options.ts
@@ -0,0 +1,83 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  db,
+  getActiveSessionUser,
+  RP_ID,
+  RP_NAME,
+} from '../../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let body: {
+      promotion?: boolean;
+      conditional?: boolean;
+      username?: string;
+      displayName?: string;
+    } = {};
+    try {
+      body = await request.json();
+    } catch {
+      body = {};
+    }
+
+    let user = await getActiveSessionUser(session);
+
+    // If registering during sign-up with a provided username, create or select that user
+    if (body.username && body.username.trim()) {
+      const existing = db.findUserByName(body.username);
+      if (existing) {
+        user = existing;
+      } else {
+        user = db.createUser({
+          name: body.username,
+          displayName: body.displayName || body.username.split('@')[0],
+        });
+      }
+      await session?.set('userId', user.passkeyUserId);
+    }
+
+    const isPromotionFlow = Boolean(body.promotion || body.conditional);
+    const isConditional = Boolean(body.conditional);
+    const userExistingCredentials = db.findCredentialsByUserId(user.passkeyUserId);
+
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID: RP_ID,
+      userID: new Uint8Array(Buffer.from(user.passkeyUserId, 'base64url')),
+      userName: user.name,
+      userDisplayName: user.displayName,
+      excludeCredentials: userExistingCredentials.map((cred) => ({
+        id: cred.id,
+        transports: cred.transports as any,
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        ...(isPromotionFlow && { authenticatorAttachment: 'platform' }),
+      },
+    });
+
+    // Ensure rp.id and user.id are explicitly set to the predefined RP_ID and Base64URL userId
+    options.rp = {
+      id: RP_ID,
+      name: RP_NAME,
+    };
+    options.user.id = user.passkeyUserId;
+
+    await session?.set('challenge', options.challenge);
+    await session?.set('expectedUserVerification', 'preferred');
+    await session?.set('registrationConditional', isConditional);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to generate registration options.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/register/verify.ts b/src/pages/api/passkeys/register/verify.ts
new file mode 100644
index 0000000..f4400dd
--- /dev/null
+++ b/src/pages/api/passkeys/register/verify.ts
@@ -0,0 +1,94 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  db,
+  EXPECTED_ORIGINS,
+  getActiveSessionUser,
+  resolveProviderFromAaguid,
+  RP_ID,
+  type StoredPasskeyCredential,
+} from '../../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const responsePayload = body?.credential ?? body;
+    const isConditional =
+      Boolean(body?.conditional) || Boolean(await session?.get('registrationConditional'));
+
+    const expectedChallenge = await session?.get('challenge');
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Registration challenge expired or missing.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const requestOrigin = request.headers.get('origin');
+    const allowedOrigins = requestOrigin
+      ? Array.from(new Set([...EXPECTED_ORIGINS, requestOrigin]))
+      : EXPECTED_ORIGINS;
+
+    const verification = await verifyRegistrationResponse({
+      response: responsePayload,
+      expectedChallenge,
+      expectedOrigin: allowedOrigins,
+      expectedRPID: RP_ID,
+      // Relax User Presence (UP) ONLY when verifying credentials produced by a conditional-create trigger
+      requireUserPresence: !isConditional,
+      // Creation options specified userVerification: 'preferred', so requireUserVerification MUST be false
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey registration verification failed.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = await getActiveSessionUser(session);
+    const {
+      aaguid,
+      credential,
+      credentialDeviceType,
+      credentialBackedUp,
+    } = verification.registrationInfo;
+
+    const providerMeta = resolveProviderFromAaguid(aaguid);
+
+    const newCredential: StoredPasskeyCredential = {
+      id: credential.id,
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon: providerMeta.providerIcon,
+      name: providerMeta.name,
+      transports: (credential.transports as string[]) || ['internal', 'hybrid'],
+      registeredAt: Date.now(),
+      counter: credential.counter,
+    };
+
+    db.saveCredential(newCredential);
+    await session?.set('challenge', undefined);
+    await session?.set('registrationConditional', false);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credential: newCredential,
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to verify passkey registration.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/reauth/options.ts b/src/pages/api/reauth/options.ts
new file mode 100644
index 0000000..5c63260
--- /dev/null
+++ b/src/pages/api/reauth/options.ts
@@ -0,0 +1,40 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { db, getActiveSessionUser, RP_ID } from '../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ session }) => {
+  try {
+    const user = await getActiveSessionUser(session);
+    const userPasskeys = db.findCredentialsByUserId(user.passkeyUserId);
+
+    const options = await generateAuthenticationOptions({
+      rpID: RP_ID,
+      userVerification: 'preferred',
+      // Constrain allowCredentials strictly to the signed-in user's pre-registered credentials
+      allowCredentials: userPasskeys.map((cred) => ({
+        id: cred.id,
+        transports: cred.transports as any,
+      })),
+    });
+
+    options.rpId = RP_ID;
+    options.allowCredentials = userPasskeys.map((cred) => ({
+      type: 'public-key' as const,
+      id: cred.id,
+      transports: cred.transports as any,
+    }));
+
+    await session?.set('reauthChallenge', options.challenge);
+    await session?.set('expectedUserVerification', 'preferred');
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to generate reauthentication options.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/reauth/verify.ts b/src/pages/api/reauth/verify.ts
new file mode 100644
index 0000000..2d7a338
--- /dev/null
+++ b/src/pages/api/reauth/verify.ts
@@ -0,0 +1,107 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  db,
+  EXPECTED_ORIGINS,
+  getActiveSessionUser,
+  RP_ID,
+} from '../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const responsePayload = await request.json();
+    const credentialId = responsePayload?.id;
+
+    if (!credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'Missing credential ID.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = await getActiveSessionUser(session);
+    const storedCredential = db.findCredentialById(credentialId);
+
+    if (!storedCredential) {
+      // Explicit HTTP 404 when credential is not found so client triggers signalUnknownCredential
+      return new Response(
+        JSON.stringify({ error: 'Passkey credential not found.' }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Verify Account Ownership: reject immediately if the credential belongs to a different user
+    if (storedCredential.passkeyUserId !== user.passkeyUserId) {
+      return new Response(
+        JSON.stringify({
+          error: 'Credential does not belong to the active signed-in user.',
+        }),
+        { status: 403, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const expectedChallenge = await session?.get('reauthChallenge');
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({
+          error: 'Reauthentication challenge expired or missing.',
+        }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const expectedUserVerification =
+      (await session?.get('expectedUserVerification')) || 'preferred';
+    const requireUserVerification = expectedUserVerification === 'required';
+
+    const requestOrigin = request.headers.get('origin');
+    const allowedOrigins = requestOrigin
+      ? Array.from(new Set([...EXPECTED_ORIGINS, requestOrigin]))
+      : EXPECTED_ORIGINS;
+
+    const verification = await verifyAuthenticationResponse({
+      response: responsePayload,
+      expectedChallenge,
+      expectedOrigin: allowedOrigins,
+      expectedRPID: RP_ID,
+      credential: {
+        id: storedCredential.id,
+        publicKey: new Uint8Array(
+          Buffer.from(storedCredential.credentialPublicKey, 'base64url')
+        ),
+        counter: storedCredential.counter,
+        transports: storedCredential.transports as any,
+      },
+      requireUserVerification,
+    });
+
+    if (!verification.verified) {
+      return new Response(
+        JSON.stringify({ error: 'Reauthentication verification failed.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    storedCredential.counter = verification.authenticationInfo.newCounter;
+    storedCredential.lastUsedAt = Date.now();
+    db.saveCredential(storedCredential);
+
+    const reauthenticatedAt = Date.now();
+    await session?.set('reauthChallenge', undefined);
+    await session?.set('reauthenticatedAt', reauthenticatedAt);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        reauthenticatedAt,
+        rpId: RP_ID,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to verify reauthentication assertion.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/register.ts b/src/pages/api/register.ts
new file mode 100644
index 0000000..65838bd
--- /dev/null
+++ b/src/pages/api/register.ts
@@ -0,0 +1,72 @@
+import type { APIRoute } from 'astro';
+import { db, RP_ID } from '../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { username, displayName, password } = body;
+
+    if (!username || typeof username !== 'string' || !username.trim()) {
+      return new Response(
+        JSON.stringify({ error: 'Username is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (password !== undefined && password !== '') {
+      if (password.length < 8 || !/\d/.test(password)) {
+        return new Response(
+          JSON.stringify({
+            error: 'Password must be at least 8 characters and contain a number.',
+          }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+    }
+
+    const existing = db.findUserByName(username);
+    if (existing) {
+      await session?.set('userId', existing.passkeyUserId);
+      return new Response(
+        JSON.stringify({
+          user: {
+            id: existing.id,
+            passkeyUserId: existing.passkeyUserId,
+            name: existing.name,
+            displayName: existing.displayName,
+          },
+          rpId: RP_ID,
+          userId: existing.passkeyUserId,
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = db.createUser({
+      name: username,
+      displayName: displayName || username.split('@')[0],
+      password,
+    });
+
+    await session?.set('userId', user.passkeyUserId);
+
+    return new Response(
+      JSON.stringify({
+        user: {
+          id: user.id,
+          passkeyUserId: user.passkeyUserId,
+          name: user.name,
+          displayName: user.displayName,
+        },
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to register user.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
