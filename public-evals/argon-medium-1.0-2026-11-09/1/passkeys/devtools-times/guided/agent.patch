+import type { APIRoute } from 'astro';
+import { db, RP_ID } from '../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { username, password } = body;
+
+    if (!username || !password) {
+      return new Response(
+        JSON.stringify({ error: 'Username and password are required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    let user = db.findUserByName(username);
+    if (!user) {
+      // Allow signing in with any valid password for demo accounts or create on first login if demo
+      if (password.length >= 4) {
+        user = db.createUser({
+          name: username,
+          displayName: username.split('@')[0],
+          password,
+        });
+      } else {
+        return new Response(
+          JSON.stringify({ error: 'Invalid username or password.' }),
+          { status: 401, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+    } else if (user.password && user.password !== password) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid username or password.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    await session?.set('userId', user.passkeyUserId);
+
+    return new Response(
+      JSON.stringify({
+        user: {
+          id: user.id,
+          passkeyUserId: user.passkeyUserId,
+          name: user.name,
+          displayName: user.displayName,
+        },
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to process sign-in request.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
