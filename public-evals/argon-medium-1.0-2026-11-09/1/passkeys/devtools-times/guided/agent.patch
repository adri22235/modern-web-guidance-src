diff --git a/src/utils/auth-db.ts b/src/utils/auth-db.ts
new file mode 100644
index 0000000..0940474
--- /dev/null
+++ b/src/utils/auth-db.ts
@@ -0,0 +1,239 @@
+import crypto from 'node:crypto';
+import aaguidsData from './aaguids.json';
+
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The DevTools Times';
+export const EXPECTED_ORIGINS = [
+  'http://localhost:11224',
+  'http://localhost:4321',
+  'http://localhost:3000',
+  'https://astro-news-pytrpecapa-uc.a.run.app',
+  'https://astro-news-1026410574114.us-central1.run.app',
+];
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID (valid unpadded Base64URL string)
+  credentialPublicKey: string; // Base64URL-encoded public key used to verify assertion signatures
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice'; // Helps distinguish device-bound vs cloud-synced passkeys
+  credentialBackedUp: boolean; // Boolean backup state reported by the authenticator
+  aaguid: string; // Authenticator Attestation GUID
+  providerIcon?: string; // Provider icon derived from the AAGUID registry (dark or light theme URLs)
+  name: string; // Provider name derived from AAGUID registry or custom nickname
+  transports: string[]; // Array of transport names (e.g. 'internal', 'hybrid') necessary for exclusion options
+  lastUsedAt?: number; // Optional epoch timestamp of last sign-in
+  registeredAt: number; // Registration epoch timestamp
+  counter: number; // Authenticator sign-in signature counter used to prevent replay attacks
+}
+
+export interface UserAccount {
+  id: string; // Same as passkeyUserId (unpadded Base64URL string)
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // Username / email
+  displayName: string; // Display name
+  password?: string;
+}
+
+type AaguidRegistry = Record<
+  string,
+  {
+    name: string;
+    icon_light?: string;
+    icon_dark?: string;
+  }
+>;
+
+const aaguids = aaguidsData as AaguidRegistry;
+
+/**
+ * Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+ */
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+/**
+ * Lookup passkey provider metadata from AAGUID registry (UX hint only).
+ * Skips registry lookup when AAGUID is all zeros ('00000000-0000-0000-0000-000000000000').
+ */
+export function resolveProviderFromAaguid(aaguid: string): {
+  name: string;
+  providerIcon?: string;
+} {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
+
+interface AuthStore {
+  users: Map<string, UserAccount>;
+  credentials: Map<string, StoredPasskeyCredential>;
+  defaultUserId: string;
+}
+
+const globalForAuth = globalThis as unknown as { __devtoolsTimesAuthStore?: AuthStore };
+
+function createInitialStore(): AuthStore {
+  const users = new Map<string, UserAccount>();
+  const credentials = new Map<string, StoredPasskeyCredential>();
+
+  // Genuine unpadded Base64URL IDs for seed data
+  const defaultUserId = Buffer.from('devtools-user-1').toString('base64url'); // 'ZGV2dG9vbHMtdXNlci0x'
+  const seedUser: UserAccount = {
+    id: defaultUserId,
+    passkeyUserId: defaultUserId,
+    name: 'alex.rivera@devtoolstimes.com',
+    displayName: 'Alex Rivera',
+    password: 'Password123',
+  };
+  users.set(defaultUserId, seedUser);
+
+  const cred1Id = Buffer.from('devtools-cred-gpm-01').toString('base64url');
+  const gpmProvider = resolveProviderFromAaguid('ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4');
+  credentials.set(cred1Id, {
+    id: cred1Id,
+    passkeyUserId: defaultUserId,
+    credentialPublicKey: Buffer.from('mock-public-key-gpm-01').toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    providerIcon: gpmProvider.providerIcon,
+    name: gpmProvider.name,
+    transports: ['internal', 'hybrid'],
+    registeredAt: Date.now() - 1000 * 60 * 60 * 24 * 14,
+    lastUsedAt: Date.now() - 1000 * 60 * 60 * 3,
+    counter: 4,
+  });
+
+  const cred2Id = Buffer.from('devtools-cred-icloud-02').toString('base64url');
+  const icloudProvider = resolveProviderFromAaguid('fbfc3007-154e-4ecc-8c0b-6e020557d7bd');
+  credentials.set(cred2Id, {
+    id: cred2Id,
+    passkeyUserId: defaultUserId,
+    credentialPublicKey: Buffer.from('mock-public-key-icloud-02').toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+    providerIcon: icloudProvider.providerIcon,
+    name: icloudProvider.name,
+    transports: ['internal', 'hybrid'],
+    registeredAt: Date.now() - 1000 * 60 * 60 * 24 * 30,
+    lastUsedAt: Date.now() - 1000 * 60 * 60 * 24 * 5,
+    counter: 2,
+  });
+
+  return { users, credentials, defaultUserId };
+}
+
+function getStore(): AuthStore {
+  if (!globalForAuth.__devtoolsTimesAuthStore) {
+    globalForAuth.__devtoolsTimesAuthStore = createInitialStore();
+  }
+  return globalForAuth.__devtoolsTimesAuthStore;
+}
+
+export const db = {
+  getDefaultUser(): UserAccount {
+    const store = getStore();
+    return store.users.get(store.defaultUserId)!;
+  },
+
+  findUserById(userId: string): UserAccount | undefined {
+    return getStore().users.get(userId);
+  },
+
+  findUserByName(name: string): UserAccount | undefined {
+    const normalized = name.trim().toLowerCase();
+    for (const user of getStore().users.values()) {
+      if (user.name.toLowerCase() === normalized) {
+        return user;
+      }
+    }
+    return undefined;
+  },
+
+  createUser(params: { name: string; displayName?: string; password?: string }): UserAccount {
+    const store = getStore();
+    const passkeyUserId = crypto.randomBytes(16).toString('base64url');
+    const cleanName = params.name.trim();
+    const user: UserAccount = {
+      id: passkeyUserId,
+      passkeyUserId,
+      name: cleanName,
+      displayName: (params.displayName || cleanName).trim(),
+      password: params.password,
+    };
+    store.users.set(passkeyUserId, user);
+    return user;
+  },
+
+  updateUser(
+    userId: string,
+    updates: { name?: string; displayName?: string; password?: string }
+  ): UserAccount | undefined {
+    const store = getStore();
+    const existing = store.users.get(userId);
+    if (!existing) return undefined;
+    if (typeof updates.name === 'string' && updates.name.trim()) {
+      existing.name = updates.name.trim();
+    }
+    if (typeof updates.displayName === 'string' && updates.displayName.trim()) {
+      existing.displayName = updates.displayName.trim();
+    }
+    if (typeof updates.password === 'string' && updates.password) {
+      existing.password = updates.password;
+    }
+    store.users.set(userId, existing);
+    return existing;
+  },
+
+  findCredentialsByUserId(userId: string): StoredPasskeyCredential[] {
+    const results: StoredPasskeyCredential[] = [];
+    for (const cred of getStore().credentials.values()) {
+      if (cred.passkeyUserId === userId) {
+        results.push(cred);
+      }
+    }
+    return results.sort((a, b) => b.registeredAt - a.registeredAt);
+  },
+
+  findCredentialById(credentialId: string): StoredPasskeyCredential | undefined {
+    return getStore().credentials.get(credentialId);
+  },
+
+  saveCredential(cred: StoredPasskeyCredential): StoredPasskeyCredential {
+    getStore().credentials.set(cred.id, cred);
+    return cred;
+  },
+
+  deleteCredential(credentialId: string): boolean {
+    return getStore().credentials.delete(credentialId);
+  },
+};
+
+export async function getActiveSessionUser(session: any): Promise<UserAccount> {
+  if (session) {
+    const userId = await session.get('userId');
+    if (userId) {
+      const found = db.findUserById(userId);
+      if (found) return found;
+    }
+  }
+  return db.getDefaultUser();
+}
diff --git a/src/utils/passkey-client.ts b/src/utils/passkey-client.ts
new file mode 100644
index 0000000..5d03203
--- /dev/null
+++ b/src/utils/passkey-client.ts
@@ -0,0 +1,381 @@
+import 'webauthn-polyfills';
+import aaguidsData from './aaguids.json';
+import type { StoredPasskeyCredential } from './auth-db';
+
+type AaguidRegistry = Record<
+  string,
+  {
+    name: string;
+    icon_light?: string;
+    icon_dark?: string;
+  }
+>;
+
+const aaguids = aaguidsData as AaguidRegistry;
+
+export function getApiUrl(path: string): string {
+  const base = import.meta.env.BASE_URL || '/';
+  const normalizedBase = base.endsWith('/') ? base : `${base}/`;
+  const normalizedPath = path.startsWith('/') ? path.slice(1) : path;
+  return `${normalizedBase}${normalizedPath}`;
+}
+
+/**
+ * Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+ */
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+export function getProviderDisplayInfo(cred: {
+  aaguid?: string;
+  name?: string;
+  providerIcon?: string;
+}): {
+  displayName: string;
+  providerName: string;
+  iconUrl?: string;
+} {
+  const aaguid = cred.aaguid || '00000000-0000-0000-0000-000000000000';
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      displayName: cred.name || 'Unknown passkey provider',
+      providerName: 'Unknown passkey provider',
+      iconUrl: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  const providerName = provider?.name || 'Unknown passkey provider';
+  return {
+    displayName: cred.name || providerName,
+    providerName,
+    iconUrl: cred.providerIcon || provider?.icon_light,
+  };
+}
+
+export interface PasskeyClientCapabilities {
+  conditionalGet: boolean;
+  conditionalCreate: boolean;
+  passkeyPlatformAuthenticator: boolean;
+  immediateGet: boolean;
+}
+
+export async function getPasskeyCapabilities(): Promise<PasskeyClientCapabilities> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    typeof (PublicKeyCredential as any).getClientCapabilities !== 'function'
+  ) {
+    return {
+      conditionalGet: false,
+      conditionalCreate: false,
+      passkeyPlatformAuthenticator: false,
+      immediateGet: false,
+    };
+  }
+
+  try {
+    const capabilities = await (PublicKeyCredential as any).getClientCapabilities();
+    return {
+      conditionalGet: Boolean(capabilities?.conditionalGet),
+      conditionalCreate: Boolean(capabilities?.conditionalCreate),
+      passkeyPlatformAuthenticator: Boolean(capabilities?.passkeyPlatformAuthenticator),
+      immediateGet: Boolean(capabilities?.immediateGet),
+    };
+  } catch {
+    return {
+      conditionalGet: false,
+      conditionalCreate: false,
+      passkeyPlatformAuthenticator: false,
+      immediateGet: false,
+    };
+  }
+}
+
+export async function signalUnknownCredentialSafe(
+  rpId: string | undefined,
+  credentialId: string | undefined
+): Promise<void> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    typeof (PublicKeyCredential as any).signalUnknownCredential !== 'function'
+  ) {
+    return;
+  }
+  if (!rpId || !isValidBase64Url(credentialId)) {
+    return;
+  }
+  try {
+    await (PublicKeyCredential as any).signalUnknownCredential({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      credentialId, // Base64URL-encoded credential ID string
+    });
+  } catch (e) {
+    console.warn('signalUnknownCredential sync warning:', e);
+  }
+}
+
+export async function syncAcceptedCredentials(
+  rpId: string | undefined,
+  userId: string | undefined,
+  currentCredentialsList: StoredPasskeyCredential[]
+): Promise<void> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    typeof (PublicKeyCredential as any).signalAllAcceptedCredentials !== 'function'
+  ) {
+    return;
+  }
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+  if (
+    !rpId ||
+    !isValidBase64Url(userId) ||
+    !credentialIds.every(isValidBase64Url)
+  ) {
+    console.warn(
+      'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+    );
+    return;
+  }
+
+  try {
+    await (PublicKeyCredential as any).signalAllAcceptedCredentials({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+    console.warn('SignalAllAcceptedCredentials sync warning:', e);
+  }
+}
+
+export async function syncCurrentUserDetails(
+  rpId: string | undefined,
+  userId: string | undefined,
+  updatedName: string,
+  updatedDisplayName: string
+): Promise<void> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    typeof (PublicKeyCredential as any).signalCurrentUserDetails !== 'function'
+  ) {
+    return;
+  }
+  if (!rpId || !isValidBase64Url(userId)) {
+    console.warn(
+      'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+    );
+    return;
+  }
+
+  try {
+    await (PublicKeyCredential as any).signalCurrentUserDetails({
+      rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+      userId, // Base64URL-encoded user ID from the server
+      name: updatedName,
+      displayName: updatedDisplayName,
+    });
+  } catch (e) {
+    console.warn('SignalCurrentUserDetails sync warning:', e);
+  }
+}
+
+export interface RegisterPasskeyResult {
+  success: boolean;
+  cancelled?: boolean;
+  error?: string;
+  credential?: StoredPasskeyCredential;
+}
+
+export async function registerPasskey(options?: {
+  promotion?: boolean;
+  username?: string;
+  displayName?: string;
+}): Promise<RegisterPasskeyResult> {
+  const capabilities = await getPasskeyCapabilities();
+  if (
+    !capabilities.passkeyPlatformAuthenticator ||
+    !capabilities.conditionalGet
+  ) {
+    return {
+      success: false,
+      error: 'Passkeys are not supported on this device or browser.',
+    };
+  }
+
+  const optionsRes = await fetch(getApiUrl('api/passkeys/register/options'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      promotion: Boolean(options?.promotion),
+      username: options?.username,
+      displayName: options?.displayName,
+    }),
+  });
+
+  if (!optionsRes.ok) {
+    return {
+      success: false,
+      error: 'Failed to retrieve passkey creation options from server.',
+    };
+  }
+
+  const creationOptionsJSON = await optionsRes.json();
+  const publicKey = (PublicKeyCredential as any).parseCreationOptionsFromJSON(
+    creationOptionsJSON
+  );
+
+  let credential: any;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err: any) {
+    if (err?.name === 'InvalidStateError') {
+      return {
+        success: false,
+        error: 'A passkey already exists for this account on your authenticator.',
+      };
+    } else if (err?.name === 'SecurityError') {
+      return {
+        success: false,
+        error: 'Configuration RP ID or Secure Context error.',
+      };
+    } else if (err?.name === 'NotAllowedError') {
+      return {
+        success: false,
+        cancelled: true,
+      };
+    } else if (err?.name === 'AbortError') {
+      return {
+        success: false,
+        cancelled: true,
+      };
+    }
+    return {
+      success: false,
+      error: 'Passkey creation could not be completed.',
+    };
+  }
+
+  if (!credential) {
+    return {
+      success: false,
+      cancelled: true,
+    };
+  }
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const verifyRes = await fetch(getApiUrl('api/passkeys/register/verify'), {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(encodedResponse),
+    });
+
+    if (!verifyRes.ok) {
+      await signalUnknownCredentialSafe(publicKey.rp?.id, encodedResponse.id);
+      const errData = await verifyRes.json().catch(() => ({}));
+      return {
+        success: false,
+        error: errData.error || 'Server failed to verify the new passkey.',
+      };
+    }
+
+    const data = await verifyRes.json();
+    return {
+      success: true,
+      credential: data.credential,
+    };
+  } catch (serverErr) {
+    await signalUnknownCredentialSafe(publicKey.rp?.id, encodedResponse.id);
+    return {
+      success: false,
+      error: 'Network error while verifying passkey registration.',
+    };
+  }
+}
+
+/**
+ * Automatic silent passkey registration (Conditional Create) immediately after a successful password login.
+ */
+export async function triggerConditionalCreate(
+  loginAbortController: AbortController
+): Promise<StoredPasskeyCredential | null> {
+  const capabilities = await getPasskeyCapabilities();
+  if (capabilities.conditionalCreate !== true) {
+    return null;
+  }
+
+  // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+  loginAbortController.abort();
+
+  // 2. Fetch creation options signaling the backend that this is a conditional request
+  const optionsRes = await fetch(getApiUrl('api/passkeys/register/options'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ conditional: true, promotion: true }),
+  });
+
+  if (!optionsRes.ok) {
+    return null;
+  }
+
+  const creationOptionsJSON = await optionsRes.json();
+  const publicKey = (PublicKeyCredential as any).parseCreationOptionsFromJSON(
+    creationOptionsJSON
+  );
+
+  let credential: any;
+  try {
+    // 3. Invoke silent credentials creation prompt
+    credential = await navigator.credentials.create({
+      publicKey,
+      mediation: 'conditional' as CredentialMediationRequirement,
+    });
+  } catch (e: any) {
+    // 4. Silently swallow common WebAuthn browser exceptions
+    if (
+      ['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e?.name)
+    ) {
+      return null;
+    }
+    return null;
+  }
+
+  if (!credential) {
+    return null;
+  }
+
+  // 5. Server verification step using dedicated Try/Catch block
+  const encodedResponse = credential.toJSON();
+  try {
+    const verifyRes = await fetch(getApiUrl('api/passkeys/register/verify'), {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        credential: encodedResponse,
+        conditional: true,
+      }),
+    });
+
+    if (!verifyRes.ok) {
+      await signalUnknownCredentialSafe(publicKey.rp?.id, encodedResponse.id);
+      return null;
+    }
+
+    const data = await verifyRes.json();
+    return data.credential || null;
+  } catch {
+    await signalUnknownCredentialSafe(publicKey.rp?.id, encodedResponse.id);
+    return null;
+  }
+}
