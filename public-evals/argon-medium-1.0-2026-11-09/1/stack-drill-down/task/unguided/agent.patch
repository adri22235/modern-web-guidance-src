+        document.getElementById('detail-stat-calories').textContent = item.calories;
+        document.getElementById('detail-stat-caffeine').textContent = item.caffeine;
+        document.getElementById('detail-stat-roast').textContent = item.roast;
+
+        const heroBanner = document.getElementById('detail-hero-banner');
+        if (heroBanner) {
+          heroBanner.style.backgroundImage = `url('${item.image}')`;
+        }
+
+        // Tags
+        const tagsContainer = document.getElementById('detail-tags');
+        tagsContainer.innerHTML = item.tags
+          .map(tag => `<span class="flavor-tag">${tag}</span>`)
+          .join('');
+
+        // Ingredients
+        const ingredientsList = document.getElementById('detail-ingredients');
+        ingredientsList.innerHTML = item.ingredients
+          .map(ing => `<li>${ing}</li>`)
+          .join('');
+
+        // Origin link
+        const originBtn = document.getElementById('drilldown-origin-btn');
+        if (originBtn) {
+          originBtn.setAttribute('href', item.originPath);
+          originBtn.dataset.itemId = item.id;
+        }
+
+        // Reset customization state for newly selected drink
+        currentSizeOffset = 0;
+        currentShotsOffset = 0;
+        document.querySelectorAll('.size-btn').forEach(btn => {
+          btn.classList.toggle('active', btn.dataset.priceOffset === '0');
+        });
+        const shotsSelect = document.getElementById('custom-shots');
+        if (shotsSelect) shotsSelect.value = '0';
+        updateLivePrice(item.basePrice);
+
+        // Populate related items
+        const relatedGrid = document.getElementById('related-items-grid');
+        if (relatedGrid) {
+          relatedGrid.innerHTML = Object.values(ITEMS)
+            .filter(other => other.id !== item.id)
+            .map(other => `
+              <a href="${other.path}" class="related-card" data-drilldown-link="${other.id}">
+                <div>
+                  <strong style="color: var(--primary); display: block;">${other.title}</strong>
+                  <span style="font-size: 0.85rem; color: var(--text-muted);">${other.subtitle}</span>
+                </div>
+                <span style="font-weight: 700; color: var(--primary); white-space: nowrap; margin-left: 12px;">
+                  $${other.basePrice.toFixed(2)} &rarr;
+                </span>
+              </a>
+            `)
+            .join('');
+        }
+
+        // Populate Sub-detail screen as well
+        document.getElementById('subdetail-crumb-item').textContent = item.title;
+        document.getElementById('subdetail-route-pill').textContent = item.originPath;
+        document.getElementById('subdetail-title').textContent = 'Origin & Nutrition: ' + item.title;
+        document.getElementById('subdetail-origin-story').textContent = item.originStory;
+        document.getElementById('subdetail-sourcing-list').innerHTML = item.sourcingFacts
+          .map(fact => `<li>${fact}</li>`)
+          .join('');
+
+        screenDetail.dataset.activeItem = item.id;
+      }
+
+      // Apply stack state to DOM screens & update document title
+      function renderStack(stack, options = {}) {
+        currentStack = stack;
+        const depth = stack.length - 1;
+        const top = stack[depth];
+
+        navStackEl.dataset.stackDepth = String(depth);
+        navStackEl.dataset.activeScreen = top.screen;
+        navStackEl.dataset.activeItem = top.itemId || '';
+
+        if (top.itemId) {
+          populateDetailScreen(top.itemId);
+        }
+
+        // Reset inline transforms from any swipe gesture
+        [screenHome, screenDetail, screenSubdetail].forEach(el => {
+          el.style.transform = '';
+          el.style.filter = '';
+        });
+
+        if (depth === 0) {
+          screenHome.dataset.stackState = 'active';
+          screenHome.setAttribute('aria-hidden', 'false');
+
+          screenDetail.dataset.stackState = 'offscreen-right';
+          screenDetail.setAttribute('aria-hidden', 'true');
+
+          screenSubdetail.dataset.stackState = 'offscreen-right';
+          screenSubdetail.setAttribute('aria-hidden', 'true');
+
+          swipeEdgeHint.hidden = true;
+          document.title = 'The Daily Grind | Artisanal Coffee';
+        } else if (depth === 1) {
+          screenHome.dataset.stackState = 'under';
+          screenHome.setAttribute('aria-hidden', 'true');
+
+          screenDetail.dataset.stackState = 'active';
+          screenDetail.setAttribute('aria-hidden', 'false');
+          if (!options.preserveScroll) screenDetail.scrollTop = 0;
+
+          screenSubdetail.dataset.stackState = 'offscreen-right';
+          screenSubdetail.setAttribute('aria-hidden', 'true');
+
+          swipeEdgeHint.hidden = false;
+          const item = ITEMS[top.itemId] || ITEMS['seasonal'];
+          document.title = `${item.title} | The Daily Grind`;
+        } else if (depth >= 2) {
+          screenHome.dataset.stackState = 'deep-under';
+          screenHome.setAttribute('aria-hidden', 'true');
+
+          screenDetail.dataset.stackState = 'under';
+          screenDetail.setAttribute('aria-hidden', 'true');
+
+          screenSubdetail.dataset.stackState = 'active';
+          screenSubdetail.setAttribute('aria-hidden', 'false');
+          if (!options.preserveScroll) screenSubdetail.scrollTop = 0;
+
+          swipeEdgeHint.hidden = false;
+          const item = ITEMS[top.itemId] || ITEMS['seasonal'];
+          document.title = `Origin & Nutrition - ${item.title} | The Daily Grind`;
+        }
+      }
+
+      // Push a detail view onto the navigation stack and sync with browser history
+      function navigateToItem(itemId, subdetail = false) {
+        const resolvedId = resolveItemId(itemId) || 'seasonal';
+        const newStack = subdetail
+          ? [{ screen: 'home' }, { screen: 'detail', itemId: resolvedId }, { screen: 'subdetail', itemId: resolvedId }]
+          : [{ screen: 'home' }, { screen: 'detail', itemId: resolvedId }];
+
+        const targetUrl = getUrlForStack(newStack);
+        renderStack(newStack);
+
+        try {
+          window.history.pushState({ stack: newStack }, document.title, targetUrl);
+        } catch (err) {
+          window.location.hash = targetUrl;
+        }
+      }
+
+      // Pop the top screen from the navigation stack and sync with browser history
+      function navigateBack() {
+        if (currentStack.length <= 1) return;
+
+        const poppedStack = currentStack.slice(0, currentStack.length - 1);
+        const targetUrl = getUrlForStack(poppedStack);
+
+        renderStack(poppedStack, { preserveScroll: true });
+
+        // Sync browser history cleanly
+        try {
+          window.history.pushState({ stack: poppedStack }, document.title, targetUrl);
+        } catch (err) {
+          window.location.hash = targetUrl;
+        }
+      }
+
+      // Navigate directly back to Root (Home)
+      function navigateToRoot() {
+        if (currentStack.length <= 1) return;
+        const rootStack = [{ screen: 'home' }];
+        const targetUrl = getUrlForStack(rootStack);
+        renderStack(rootStack, { preserveScroll: true });
+        try {
+          window.history.pushState({ stack: rootStack }, document.title, targetUrl);
+        } catch (err) {
+          window.location.hash = '/';
+        }
+      }
+
+      // Listen for Browser Back / Forward buttons (popstate & hashchange)
+      window.addEventListener('popstate', function (event) {
+        if (event.state && Array.isArray(event.state.stack) && event.state.stack.length > 0) {
+          renderStack(event.state.stack, { preserveScroll: true });
+        } else {
+          const parsed = parseLocationToStack(window.location);
+          renderStack(parsed, { preserveScroll: true });
+        }
+      });
+
+      window.addEventListener('hashchange', function () {
+        const parsed = parseLocationToStack(window.location);
+        renderStack(parsed, { preserveScroll: true });
+      });
+
+      // Delegate Clicks for Cards, Drill-down Links, Back Buttons, and Breadcrumbs
+      document.addEventListener('click', function (event) {
+        // 1. Back action buttons
+        const backTrigger = event.target.closest('[data-action="back"], #swipe-edge-hint');
+        if (backTrigger) {
+          event.preventDefault();
+          navigateBack();
+          return;
+        }
+
+        // 2. Root / Home breadcrumb or logo links
+        const rootTrigger = event.target.closest('[data-nav-root]');
+        if (rootTrigger) {
+          event.preventDefault();
+          navigateToRoot();
+          return;
+        }
+
+        // 3. Level 2 Sub-detail drilldown link
+        const subdetailTrigger = event.target.closest('[data-action="drilldown-subdetail"]');
+        if (subdetailTrigger) {
+          event.preventDefault();
+          const activeItemId = screenDetail.dataset.activeItem || 'seasonal';
+          navigateToItem(activeItemId, true);
+          return;
+        }
+
+        // 4. Explicit drilldown button/link (e.g. "View Details" on Seasonal Favorites)
+        const drilldownLink = event.target.closest('[data-drilldown-link]');
+        if (drilldownLink) {
+          event.preventDefault();
+          const itemId = drilldownLink.getAttribute('data-drilldown-link');
+          navigateToItem(itemId, false);
+          return;
+        }
+
+        // 5. Clicking anywhere on a Seasonal Favorites card
+        const card = event.target.closest('.card[data-item-id]');
+        if (card) {
+          event.preventDefault();
+          const itemId = card.getAttribute('data-item-id');
+          navigateToItem(itemId, false);
+          return;
+        }
+
+        // 6. Scroll to Seasonal Favorites from Hero / Menu nav
+        const scrollSeasonal = event.target.closest('[data-scroll-seasonal]');
+        if (scrollSeasonal) {
+          event.preventDefault();
+          if (currentStack.length > 1) {
+            navigateToRoot();
+          }
+          const targetSection = document.getElementById('seasonal-favorites');
+          if (targetSection) {
+            targetSection.scrollIntoView({ behavior: 'smooth' });
+          }
+          return;
+        }
+
+        // 7. Cup size buttons inside Detail screen
+        const sizeBtn = event.target.closest('.size-btn');
+        if (sizeBtn) {
+          document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
+          sizeBtn.classList.add('active');
+          currentSizeOffset = parseFloat(sizeBtn.dataset.priceOffset || '0');
+          const activeItem = ITEMS[screenDetail.dataset.activeItem || 'seasonal'];
+          updateLivePrice(activeItem.basePrice);
+          return;
+        }
+      });
+
+      // Keyboard accessibility: Enter/Space on card, Escape to pop stack
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && currentStack.length > 1) {
+          event.preventDefault();
+          navigateBack();
+          return;
+        }
+        if ((event.key === 'Enter' || event.key === ' ') && event.target.matches('.card[data-item-id]')) {
+          event.preventDefault();
+          navigateToItem(event.target.getAttribute('data-item-id'), false);
+        }
+      });
+
+      // Customization selects
+      const shotsSelect = document.getElementById('custom-shots');
+      if (shotsSelect) {
+        shotsSelect.addEventListener('change', function () {
+          currentShotsOffset = parseFloat(this.value || '0');
+          const activeItem = ITEMS[screenDetail.dataset.activeItem || 'seasonal'];
+          updateLivePrice(activeItem.basePrice);
+        });
+      }
+
+      const addToOrderBtn = document.getElementById('add-to-order-btn');
+      if (addToOrderBtn) {
+        addToOrderBtn.addEventListener('click', function () {
+          const activeItem = ITEMS[screenDetail.dataset.activeItem || 'seasonal'];
+          const priceText = document.getElementById('detail-live-price').textContent;
+          showToast(`Added ${activeItem.title} (${priceText}) to your order!`);
+        });
+      }
+
+      // Interactive Swipe-Back Gesture Handler (supports Touch, Pointer, and Mouse drag)
+      let gestureState = null;
+
+      function getActiveScreenElements() {
+        const depth = currentStack.length - 1;
+        if (depth === 1) {
+          return { activeEl: screenDetail, underEl: screenHome };
+        }
+        if (depth >= 2) {
+          return { activeEl: screenSubdetail, underEl: screenDetail };
+        }
+        return null;
+      }
+
+      function startSwipeGesture(clientX, clientY, target) {
+        if (currentStack.length <= 1) return;
+        if (target && target.closest('select, input, textarea')) return;
+        gestureState = {
+          startX: clientX,
+          startY: clientY,
+          currentX: clientX,
+          currentY: clientY,
+          startTime: Date.now(),
+          isHorizontalSwipe: false,
+          aborted: false
+        };
+      }
+
+      function moveSwipeGesture(clientX, clientY) {
+        if (!gestureState || gestureState.aborted || currentStack.length <= 1) return;
+
+        const deltaX = clientX - gestureState.startX;
+        const deltaY = clientY - gestureState.startY;
+        gestureState.currentX = clientX;
+        gestureState.currentY = clientY;
+
+        if (!gestureState.isHorizontalSwipe) {
+          // Determine gesture axis
+          if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 18) {
+            gestureState.aborted = true;
+            return;
+          }
+          if (deltaX > 10 && Math.abs(deltaX) > Math.abs(deltaY)) {
+            gestureState.isHorizontalSwipe = true;
+            navStackEl.classList.add('is-dragging');
+          }
+        }
+
+        if (gestureState.isHorizontalSwipe) {
+          const clampedX = Math.max(0, deltaX);
+          const viewportWidth = window.innerWidth || 375;
+          const progress = Math.min(1, clampedX / viewportWidth);
+          const screens = getActiveScreenElements();
+          if (screens) {
+            screens.activeEl.style.transform = `translate3d(${clampedX}px, 0, 0)`;
+            const underOffset = -26 * (1 - progress);
+            const underScale = 0.985 + 0.015 * progress;
+            const underBrightness = 0.72 + 0.28 * progress;
+            screens.underEl.style.transform = `translate3d(${underOffset}%, 0, 0) scale(${underScale})`;
+            screens.underEl.style.filter = `brightness(${underBrightness})`;
+          }
+        }
+      }
+
+      function endSwipeGesture(clientX) {
+        if (!gestureState) return;
+        const state = gestureState;
+        gestureState = null;
+
+        const finalX = typeof clientX === 'number' ? clientX : state.currentX;
+        const deltaX = finalX - state.startX;
+        const deltaY = Math.abs(state.currentY - state.startY);
+        const elapsed = Math.max(1, Date.now() - state.startTime);
+        const velocity = deltaX / elapsed; // px per ms
+
+        navStackEl.classList.remove('is-dragging');
+
+        // Trigger back navigation if swiped right past 50px or fast flick
+        const isRightSwipe = deltaX >= 50 && deltaX > deltaY;
+        const isFastFlick = deltaX >= 25 && velocity > 0.35 && deltaX > deltaY;
+
+        if (!state.aborted && (isRightSwipe || isFastFlick)) {
+          navigateBack();
+        } else {
+          // Snap back smoothly to current stack state
+          renderStack(currentStack, { preserveScroll: true });
+        }
+      }
+
+      // Touch Events
+      navStackEl.addEventListener('touchstart', function (e) {
+        if (e.touches.length !== 1) return;
+        startSwipeGesture(e.touches[0].clientX, e.touches[0].clientY, e.target);
+      }, { passive: true });
+
+      navStackEl.addEventListener('touchmove', function (e) {
+        if (!gestureState || e.touches.length !== 1) return;
+        moveSwipeGesture(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      navStackEl.addEventListener('touchend', function (e) {
+        const touch = e.changedTouches && e.changedTouches[0];
+        endSwipeGesture(touch ? touch.clientX : undefined);
+      });
+
+      navStackEl.addEventListener('touchcancel', function () {
+        gestureState = null;
+        navStackEl.classList.remove('is-dragging');
+        renderStack(currentStack, { preserveScroll: true });
+      });
+
+      // Pointer / Mouse Drag Events (for desktop swipe & pointer automation)
+      navStackEl.addEventListener('mousedown', function (e) {
+        if (e.button !== 0) return;
+        startSwipeGesture(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!gestureState) return;
+        moveSwipeGesture(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', function (e) {
+        if (!gestureState) return;
+        endSwipeGesture(e.clientX);
+      });
+
+      // Initialize from current URL (supports deep links on initial page load)
+      function initFromUrl() {
+        const initialStack = parseLocationToStack(window.location);
+
+        if (initialStack.length > 1) {
+          // Seed history with root first so native browser Back button pops to Home
+          try {
+            const deepUrl = window.location.pathname + window.location.search + window.location.hash;
+            window.history.replaceState({ stack: [{ screen: 'home' }] }, 'The Daily Grind | Artisanal Coffee', '/');
+            renderStack(initialStack);
+            window.history.pushState({ stack: initialStack }, document.title, deepUrl);
+          } catch (err) {
+            renderStack(initialStack);
+          }
+        } else {
+          renderStack(initialStack);
+          try {
+            window.history.replaceState({ stack: initialStack }, document.title, window.location.pathname + window.location.search + window.location.hash);
+          } catch (err) {
+            // Ignore history security errors on file://
+          }
+        }
+      }
+
+      // Expose navigation API for programmatic inspection/testing if needed
+      window.DailyGrindNav = {
+        getStack: () => currentStack.slice(),
+        navigateToItem,
+        navigateBack,
+        navigateToRoot
+      };
+
+      initFromUrl();
+    })();
+  </script>
 </body>
 
