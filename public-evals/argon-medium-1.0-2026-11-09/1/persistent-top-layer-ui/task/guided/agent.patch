+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill');
+    }
+
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const moveModalBtn = document.getElementById('move-modal-btn');
+    const locationStatus = document.getElementById('modal-location-status');
+
+    const sections = [
+      document.getElementById('hero-section'),
+      document.getElementById('main-section'),
+      document.getElementById('footer-section'),
+    ].filter(Boolean);
+
+    function updateLocationStatus() {
+      const parent = feedbackDialog.parentElement;
+      if (!parent) return;
+      const name = parent.dataset.sectionName || parent.tagName.toLowerCase();
+      locationStatus.textContent = `DOM Parent: ${name} (#${parent.id})`;
+    }
+
+    moveModalBtn.addEventListener('click', () => {
+      const currentIndex = sections.indexOf(feedbackDialog.parentElement);
+      const nextIndex = (currentIndex + 1) % sections.length;
+      const targetParent = sections[nextIndex];
+
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen =
+          feedbackDialog.hasAttribute('open') ||
+          feedbackDialog.matches(':popover-open');
+        targetParent.insertBefore(feedbackDialog, null);
+
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+      }
+
+      updateLocationStatus();
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      const action = feedbackDialog.returnValue;
+      feedbackDialog.returnValue = '';
+      if (action === 'submit') {
+        document.getElementById('feedback-form')?.reset();
+      }
+    });
+  </script>
