+  <script>
+    (function () {
+      const modal = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-modal-btn');
+      const closeBtn = document.getElementById('close-modal-btn');
+      const triggerBtn = document.getElementById('feedback-trigger-btn');
+      const feedbackForm = document.getElementById('feedback-form');
+      const feedbackStatus = document.getElementById('feedback-status');
+      const currentSectionPill = document.getElementById('modal-current-section');
+      const sections = Array.from(document.querySelectorAll('main .page-section'));
+
+      function updateSectionIndicators() {
+        const hostSection = modal.closest('.page-section');
+        sections.forEach((section) => {
+          const isHost = section === hostSection;
+          section.classList.toggle('has-modal', isHost);
+          const badge = section.querySelector('[data-role="section-indicator"]');
+          if (badge) {
+            badge.textContent = isHost ? 'Modal Host: Active' : 'Modal Host: Inactive';
+          }
+        });
+
+        if (hostSection && currentSectionPill) {
+          const name = hostSection.getAttribute('data-section-name') || hostSection.id;
+          currentSectionPill.textContent = name;
+          currentSectionPill.setAttribute('data-current-section', hostSection.id);
+          modal.setAttribute('data-current-section', hostSection.id);
+        }
+      }
+
+      function openFeedbackModal() {
+        if (triggerBtn && triggerBtn.parentElement !== modal) {
+          modal.appendChild(triggerBtn);
+        }
+        if (!modal.open) {
+          modal.showModal();
+        }
+        updateSectionIndicators();
+      }
+
+      function closeFeedbackModal() {
+        if (modal.open) {
+          modal.close();
+        }
+      }
+
+      function relocateModal() {
+        if (sections.length < 2) return;
+        const currentSection = modal.closest('.page-section');
+        const currentIndex = sections.indexOf(currentSection);
+        const nextIndex = (currentIndex + 1) % sections.length;
+        const targetSection = sections[nextIndex];
+
+        const activeEl = document.activeElement;
+        const wasOpen = modal.open;
+        const wasModal = wasOpen && modal.matches(':modal');
+
+        if (typeof targetSection.moveBefore === 'function') {
+          targetSection.moveBefore(modal, null);
+        } else {
+          targetSection.appendChild(modal);
+          if (wasModal && !modal.matches(':modal')) {
+            if (modal.open) {
+              modal.close();
+            }
+            modal.showModal();
+          } else if (wasOpen && !modal.open) {
+            modal.show();
+          }
+          if (activeEl && modal.contains(activeEl) && typeof activeEl.focus === 'function') {
+            activeEl.focus();
+          }
+        }
+
+        updateSectionIndicators();
+      }
+
+      moveBtn.addEventListener('click', relocateModal);
+
+      closeBtn.addEventListener('click', closeFeedbackModal);
+
+      modal.addEventListener('close', () => {
+        if (triggerBtn && triggerBtn.parentElement !== document.body) {
+          document.body.appendChild(triggerBtn);
+        }
+      });
+
+      triggerBtn.addEventListener('click', () => {
+        openFeedbackModal();
+      });
+
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        feedbackStatus.textContent = 'Thank you! Your feedback has been recorded.';
+      });
+
+      // Open modal overlay on initial load so it is active and ready to relocate
+      openFeedbackModal();
+    })();
+  </script>
