+      margin-block-start: 60px;
+      text-align: center;
+    }
+
+    .fan-container {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 15px;
+      padding: 50px 20px;
+      flex-wrap: wrap;
+    }
+
+    .fan-card {
+      --index: var(--sibling-index);
+      --count: var(--sibling-count);
+      --center: calc((var(--count) + 1) / 2);
+      background: var(--primary);
+      color: white;
+      inline-size: 160px;
+      block-size: 220px;
+      padding: 20px;
+      border-radius: 12px;
+      box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      transform-origin: bottom center;
+      transform: rotate(calc(10deg * (var(--index) - var(--center))));
+    }
+
+    .fan-card h3 {
+      color: var(--accent);
+      font-size: 1.1rem;
+    }
+
+    /* Circular Coffee Origin Badges */
+    .circle-container {
+      position: relative;
+      display: grid;
+      place-items: center;
+      inline-size: 420px;
+      block-size: 420px;
+      max-inline-size: 100%;
+      margin: 30px auto;
+    }
+
+    .circle-orb {
+      --index: var(--sibling-index);
+      --count: var(--sibling-count);
+      --angle: calc(360deg / var(--count) * var(--index));
+      --radius: 150px;
+
+      position: absolute;
+      place-self: center;
+
+      inline-size: 96px;
+      block-size: 96px;
+      border-radius: 50%;
+      background: var(--secondary);
+      color: var(--text);
+      border: 2px solid var(--primary);
+      display: grid;
+      place-items: center;
+      font-weight: bold;
+      font-size: 0.9rem;
+      padding: 8px;
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+
+      transform: translate(
+        calc(cos(var(--angle)) * var(--radius)),
+        calc(sin(var(--angle)) * var(--radius))
+      );
+    }
+
+    @supports (top: calc(sibling-index() * 1px)) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
+        --index: sibling-index();
+        --count: sibling-count();
+      }
+    }
+
