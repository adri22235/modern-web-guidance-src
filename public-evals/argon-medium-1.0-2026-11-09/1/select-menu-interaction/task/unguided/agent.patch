+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const shopGroup = document.getElementById('local-shop-group');
+      const errorEl = document.getElementById('local-shop-error');
+      const confirmationEl = document.getElementById('order-confirmation');
+
+      let hasInteracted = false;
+      const ERROR_MESSAGE = 'Please select a local shop to place your order.';
+
+      function validateShopSelect() {
+        if (!hasInteracted) {
+          return true;
+        }
+
+        const isValid = shopSelect.value.trim() !== '' && shopSelect.checkValidity();
+
+        if (!isValid) {
+          shopSelect.classList.add('is-invalid');
+          shopSelect.classList.remove('is-valid');
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopGroup.classList.add('has-error');
+          errorEl.textContent = ERROR_MESSAGE;
+          errorEl.hidden = false;
+          errorEl.classList.add('visible');
+        } else {
+          shopSelect.classList.remove('is-invalid');
+          shopSelect.classList.add('is-valid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopGroup.classList.remove('has-error');
+          errorEl.textContent = '';
+          errorEl.hidden = true;
+          errorEl.classList.remove('visible');
+        }
+
+        return isValid;
+      }
+
+      shopSelect.addEventListener('change', function () {
+        hasInteracted = true;
+        confirmationEl.hidden = true;
+        confirmationEl.classList.remove('visible');
+        validateShopSelect();
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        hasInteracted = true;
+        validateShopSelect();
+      });
+
+      shopSelect.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        validateShopSelect();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+
+        const isValid = validateShopSelect();
+        if (!isValid) {
+          confirmationEl.hidden = true;
+          confirmationEl.classList.remove('visible');
+          shopSelect.focus();
+          return;
+        }
+
+        const selectedShopText = shopSelect.options[shopSelect.selectedIndex].text;
+        confirmationEl.textContent =
+          'Shop selected! Starting your pickup order for ' + selectedShopText + '.';
+        confirmationEl.hidden = false;
+        confirmationEl.classList.add('visible');
+      });
+    })();
+  </script>
+
