+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const menuBtn = document.getElementById('menu-btn');
+      const drawer = document.getElementById('nav-drawer');
+      const overlay = document.getElementById('drawer-overlay');
+
+      let isOpen = false;
+      let isDragging = false;
+      let startX = 0;
+      let startY = 0;
+      let currentX = 0;
+      let currentY = 0;
+      let startedOutside = false;
+      let lastStartEvent = null;
+
+      function openDrawer() {
+        isOpen = true;
+        isDragging = false;
+        drawer.style.transform = '';
+        [drawer, overlay, menuBtn, nav].forEach((el) => {
+          if (el) {
+            el.classList.add('open', 'is-open', 'active');
+          }
+        });
+        menuBtn.setAttribute('aria-expanded', 'true');
+        drawer.setAttribute('aria-hidden', 'false');
+        overlay.setAttribute('aria-hidden', 'false');
+      }
+
+      function closeDrawer() {
+        isOpen = false;
+        isDragging = false;
+        drawer.style.transform = '';
+        [drawer, overlay, menuBtn, nav].forEach((el) => {
+          if (el) {
+            el.classList.remove('open', 'is-open', 'active');
+          }
+        });
+        menuBtn.setAttribute('aria-expanded', 'false');
+        drawer.setAttribute('aria-hidden', 'true');
+        overlay.setAttribute('aria-hidden', 'true');
+      }
+
+      function toggleDrawer() {
+        if (isOpen) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      }
+
+      menuBtn.addEventListener('click', function (e) {
+        e.stopPropagation();
+        toggleDrawer();
+      });
+
+      overlay.addEventListener('click', function () {
+        if (isOpen) {
+          closeDrawer();
+        }
+      });
+
+      document.addEventListener('click', function (e) {
+        if (!isOpen) return;
+        const target = e.target;
+        if (target && (drawer.contains(target) || menuBtn.contains(target))) {
+          return;
+        }
+        closeDrawer();
+      });
+
+      function handleKey(e) {
+        if (!isOpen) return;
+        if (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27 || e.which === 27) {
+          closeDrawer();
+        }
+      }
+
+      document.addEventListener('keydown', handleKey);
+      window.addEventListener('keydown', handleKey);
+
+      function getPoint(e) {
+        const touch = (e.touches && e.touches[0]) || (e.changedTouches && e.changedTouches[0]);
+        if (touch) {
+          const x = touch.clientX ?? touch.pageX ?? touch.screenX ?? 0;
+          const y = touch.clientY ?? touch.pageY ?? touch.screenY ?? 0;
+          return { x, y };
+        }
+        if (
+          typeof e.clientX === 'number' ||
+          typeof e.pageX === 'number' ||
+          typeof e.screenX === 'number'
+        ) {
+          const x = e.clientX ?? e.pageX ?? e.screenX ?? 0;
+          const y = e.clientY ?? e.pageY ?? e.screenY ?? 0;
+          return { x, y };
+        }
+        return null;
+      }
+
+      function onGestureStart(e) {
+        if (!isOpen || lastStartEvent === e) return;
+        lastStartEvent = e;
+        const target = e.target;
+        if (target && menuBtn.contains(target)) {
+          return;
+        }
+        const pt = getPoint(e);
+        startX = pt ? pt.x : 0;
+        startY = pt ? pt.y : 0;
+        currentX = startX;
+        currentY = startY;
+        isDragging = true;
+        startedOutside = Boolean(target && !drawer.contains(target) && !menuBtn.contains(target));
+      }
+
+      function onGestureMove(e) {
+        if (!isOpen || !isDragging) return;
+        const pt = getPoint(e);
+        if (!pt) return;
+        currentX = pt.x;
+        currentY = pt.y;
+        const deltaX = currentX - startX;
+        const deltaY = currentY - startY;
+        if (deltaX > 0 && Math.abs(deltaX) > Math.abs(deltaY)) {
+          drawer.style.transform = 'translateX(' + deltaX + 'px)';
+        }
+      }
+
+      function onGestureEnd(e) {
+        if (!isOpen || !isDragging) return;
+        const pt = getPoint(e);
+        if (pt && !(pt.x === 0 && pt.y === 0 && startX !== 0 && startY !== 0)) {
+          currentX = pt.x;
+          currentY = pt.y;
+        }
+        const deltaX = currentX - startX;
+        const deltaY = currentY - startY;
+        isDragging = false;
+        drawer.style.transform = '';
+
+        if (Math.abs(deltaX) >= 30 && Math.abs(deltaX) >= Math.abs(deltaY)) {
+          closeDrawer();
+        } else if (startedOutside) {
+          closeDrawer();
+        }
+      }
+
+      [drawer, overlay, nav, document].forEach(function (targetEl) {
+        if (!targetEl) return;
+        targetEl.addEventListener('touchstart', onGestureStart, { passive: true });
+        targetEl.addEventListener('touchmove', onGestureMove, { passive: true });
+        targetEl.addEventListener('touchend', onGestureEnd, { passive: true });
+        targetEl.addEventListener('pointerdown', onGestureStart);
+        targetEl.addEventListener('pointermove', onGestureMove);
+        targetEl.addEventListener('pointerup', onGestureEnd);
+        targetEl.addEventListener('mousedown', onGestureStart);
+        targetEl.addEventListener('mousemove', onGestureMove);
+        targetEl.addEventListener('mouseup', onGestureEnd);
+      });
+    })();
+  </script>
 </body>
 
 </html>
