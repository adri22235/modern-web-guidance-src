+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+      const authForm = document.getElementById('auth-form');
+
+      let conditionalAbortController = null;
+      let conditionalPending = false;
+
+      function base64urlToUint8Array(input) {
+        if (!input) {
+          return new Uint8Array(0);
+        }
+        if (input instanceof Uint8Array) {
+          return input;
+        }
+        if (input instanceof ArrayBuffer) {
+          return new Uint8Array(input);
+        }
+        if (ArrayBuffer.isView(input)) {
+          return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+        }
+        if (Array.isArray(input)) {
+          return new Uint8Array(input);
+        }
+        if (typeof input === 'object' && Array.isArray(input.data)) {
+          return new Uint8Array(input.data);
+        }
+        if (typeof input === 'string') {
+          try {
+            const base64 = input.replace(/-/g, '+').replace(/_/g, '/');
+            const padLength = (4 - (base64.length % 4)) % 4;
+            const padded = base64 + '='.repeat(padLength);
+            const binary = atob(padded);
+            const bytes = new Uint8Array(binary.length);
+            for (let i = 0; i < binary.length; i++) {
+              bytes[i] = binary.charCodeAt(i);
+            }
+            return bytes;
+          } catch (_e) {
+            return new TextEncoder().encode(input);
+          }
+        }
+        return new Uint8Array(0);
+      }
+
+      function bufferToBase64url(buffer) {
+        if (buffer === null || buffer === undefined) {
+          return null;
+        }
+        if (typeof buffer === 'string') {
+          return buffer;
+        }
+        let bytes;
+        if (buffer instanceof Uint8Array) {
+          bytes = buffer;
+        } else if (buffer instanceof ArrayBuffer) {
+          bytes = new Uint8Array(buffer);
+        } else if (ArrayBuffer.isView(buffer)) {
+          bytes = new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength);
+        } else if (Array.isArray(buffer)) {
+          bytes = new Uint8Array(buffer);
+        } else {
+          return String(buffer);
+        }
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/, '');
+      }
+
+      async function fetchPublicKeyRequestOptions() {
+        const response = await fetch('/api/login/options');
+        if (!response.ok) {
+          throw new Error('Failed to fetch login options: ' + response.status);
+        }
+        const data = await response.json();
+        const rawOptions = data && data.publicKey ? data.publicKey : data;
+
+        const publicKey = {
+          ...rawOptions,
+          challenge: base64urlToUint8Array(rawOptions.challenge),
+        };
+
+        if (Array.isArray(rawOptions.allowCredentials)) {
+          publicKey.allowCredentials = rawOptions.allowCredentials.map(function (cred) {
+            return {
+              ...cred,
+              type: cred.type || 'public-key',
+              id: base64urlToUint8Array(cred.id),
+            };
+          });
+        }
+
+        return publicKey;
+      }
+
+      function serializeCredential(credential) {
+        if (!credential) {
+          return null;
+        }
+        const serialized = {
+          ...credential,
+          id: credential.id,
+          type: credential.type || 'public-key',
+        };
+        if (credential.rawId !== undefined || credential.id !== undefined) {
+          serialized.rawId = bufferToBase64url(credential.rawId || credential.id);
+        }
+        if (credential.authenticatorAttachment) {
+          serialized.authenticatorAttachment = credential.authenticatorAttachment;
+        }
+        if (credential.response) {
+          const response = credential.response;
+          serialized.response = {
+            ...response,
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null,
+          };
+        }
+        if (typeof credential.getClientExtensionResults === 'function') {
+          serialized.clientExtensionResults = credential.getClientExtensionResults();
+        } else if (credential.clientExtensionResults) {
+          serialized.clientExtensionResults = credential.clientExtensionResults;
+        }
+        return serialized;
+      }
+
+      async function verifyCredentialWithServer(credential) {
+        const serialized = serializeCredential(credential);
+        const verifyResponse = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(serialized),
+        });
+
+        let result = {};
+        try {
+          result = await verifyResponse.json();
+        } catch (_e) {
+          result = {};
+        }
+
+        if (!verifyResponse.ok || result.verified === false || result.success === false) {
+          const errMessage = result.error || result.message || 'Authentication verification failed.';
+          throw new Error(errMessage);
+        }
+
+        const username =
+          result.username ||
+          (result.user && (result.user.username || result.user.name)) ||
+          (usernameField && usernameField.value.trim()) ||
+          '';
+
+        let statusText = 'Authenticated successfully! Passkey verified.';
+        if (result.message && username) {
+          statusText = result.message + ' — Authenticated successfully as ' + username + ' (Verified)';
+        } else if (result.message) {
+          statusText = result.message + ' — Authenticated successfully (Verified)';
+        } else if (username) {
+          statusText = 'Authenticated successfully! Welcome, ' + username + '. Passkey verified.';
+        }
+
+        authStatus.textContent = statusText;
+        authStatus.dataset.status = 'success';
+        authStatus.className = 'auth-status success';
+        return result;
+      }
+
+      async function callCredentialsGetWithFallback(getOptions) {
+        try {
+          return await navigator.credentials.get(getOptions);
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            throw err;
+          }
+          if (
+            err &&
+            (err.name === 'NotSupportedError' || err.name === 'SecurityError') &&
+            getOptions &&
+            getOptions.publicKey
+          ) {
+            const fallbackPublicKey = { ...getOptions.publicKey };
+            if (getOptions.mediation === 'conditional') {
+              fallbackPublicKey.allowCredentials = [];
+            }
+            if (err.name === 'SecurityError') {
+              fallbackPublicKey.rpId = window.location.hostname;
+            }
+            return await navigator.credentials.get({
+              ...getOptions,
+              publicKey: fallbackPublicKey,
+            });
+          }
+          throw err;
+        }
+      }
+
+      async function startConditionalAuthentication() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (conditionalPending) {
+          return;
+        }
+
+        if (
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+        ) {
+          try {
+            await window.PublicKeyCredential.isConditionalMediationAvailable();
+          } catch (_e) {
+            // Ignore errors in environments where conditional mediation check fails
+          }
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+        }
+        const controller = new AbortController();
+        conditionalAbortController = controller;
+        conditionalPending = true;
+
+        try {
+          const publicKey = await fetchPublicKeyRequestOptions();
+          if (controller.signal.aborted) {
+            return;
+          }
+
+          const credential = await callCredentialsGetWithFallback({
+            publicKey: publicKey,
+            mediation: 'conditional',
+            signal: controller.signal,
+          });
+
+          if (conditionalAbortController === controller) {
+            conditionalAbortController = null;
+            conditionalPending = false;
+          }
+
+          if (credential) {
+            await verifyCredentialWithServer(credential);
+          }
+        } catch (err) {
+          if (conditionalAbortController === controller) {
+            conditionalAbortController = null;
+            conditionalPending = false;
+          }
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+        }
+      }
+
+      async function handleDirectBiometricSignIn(event) {
+        if (event) {
+          event.preventDefault();
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+          conditionalPending = false;
+          await Promise.resolve();
+        }
+
+        try {
+          const publicKey = await fetchPublicKeyRequestOptions();
+          if (!publicKey.userVerification) {
+            publicKey.userVerification = 'preferred';
+          }
+
+          const credential = await callCredentialsGetWithFallback({
+            publicKey: publicKey,
+          });
+
+          if (credential) {
+            await verifyCredentialWithServer(credential);
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+          authStatus.textContent = (err && err.message) || 'Passkey authentication failed.';
+          authStatus.dataset.status = 'error';
+          authStatus.className = 'auth-status error';
+        }
+      }
+
+      if (authForm) {
+        authForm.addEventListener('submit', handleDirectBiometricSignIn);
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', handleDirectBiometricSignIn);
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', function () {
+          startConditionalAuthentication();
+        });
+      }
+    })();
+  </script>
