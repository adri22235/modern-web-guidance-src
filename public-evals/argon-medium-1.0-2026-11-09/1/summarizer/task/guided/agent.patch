+  <script>
+    (() => {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const summaryBox = document.getElementById('journal-summary-box');
+      const summaryStatus = document.getElementById('journal-summary-status');
+      const summaryList = document.getElementById('journal-summary-list');
+      const journalArticle = document.getElementById('journal-article');
+
+      const summarizerOptions = {
+        sharedContext: 'An artisanal coffee roaster journal article about direct-trade bean sourcing, high-altitude harvesting, and specialty coffee processing.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'medium',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      function showUnavailableMessage(message) {
+        summarizeBtn.disabled = true;
+        summarizeBtn.textContent = 'Summarize Unavailable';
+        summaryBox.hidden = false;
+        summaryList.innerHTML = '';
+        summaryStatus.textContent = message;
+      }
+
+      function renderBullets(summaryText) {
+        summaryList.innerHTML = '';
+        const lines = summaryText
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^[\s•*\-–—]+|\d+\.\s*/g, '').trim())
+          .filter(Boolean);
+
+        for (const item of lines) {
+          const li = document.createElement('li');
+          li.textContent = item;
+          summaryList.appendChild(li);
+        }
+      }
+
+      async function checkSupport() {
+        if (!('Summarizer' in self)) {
+          showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+          return;
+        }
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            showUnavailableMessage('Local summarization is currently unavailable on this device.');
+          }
+        } catch {
+          showUnavailableMessage('Local summarization is currently unavailable in this browser.');
+        }
+      }
+
+      summarizeBtn.addEventListener('click', async () => {
+        if (!('Summarizer' in self)) {
+          showUnavailableMessage('Local summarization is currently unsupported in this browser.');
+          return;
+        }
+
+        summarizeBtn.disabled = true;
+        summaryBox.hidden = false;
+        summaryList.innerHTML = '';
+        summaryStatus.textContent = 'Checking on-device AI availability...';
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            showUnavailableMessage('Local summarization is currently unavailable on this device.');
+            return;
+          }
+
+          if (
+            (availability === 'downloadable' || availability === 'downloading') &&
+            navigator.userActivation &&
+            !navigator.userActivation.isActive
+          ) {
+            summaryStatus.textContent = 'Please click the Summarize button again to start downloading the on-device AI model.';
+            summarizeBtn.disabled = false;
+            return;
+          }
+
+          summaryStatus.textContent =
+            availability === 'available'
+              ? 'Generating bullet-point summary...'
+              : 'Preparing on-device AI model...';
+
+          const summarizer = await Summarizer.create({
+            ...summarizerOptions,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = e.total ? Math.round((e.loaded / e.total) * 100) : Math.round((e.loaded || 0) * 100);
+                console.log(`Downloaded ${percent}%`);
+                summaryStatus.textContent = `Downloading on-device AI model (${percent}%)...`;
+              });
+            },
+          });
+
+          summaryStatus.textContent = 'Summarizing article...';
+          const longText = journalArticle.innerText.trim();
+          const summary = await summarizer.summarize(longText, {
+            context: 'Summarize the coffee bean sourcing process into concise bullet points for coffee shop visitors.',
+          });
+
+          summaryStatus.textContent = '';
+          renderBullets(summary);
+          summarizeBtn.textContent = 'Summarize Again';
+          summarizeBtn.disabled = false;
+
+          if (typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        } catch (err) {
+          summaryStatus.textContent = `Unable to generate summary: ${err && err.message ? err.message : 'An unexpected error occurred.'}`;
+          summarizeBtn.disabled = false;
+        }
+      });
+
+      checkSupport();
+    })();
+  </script>
+
 </body>
 
