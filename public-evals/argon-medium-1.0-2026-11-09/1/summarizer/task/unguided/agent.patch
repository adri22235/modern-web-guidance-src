+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const journalArticle = document.getElementById('journal-article');
+      const summaryContainer = document.getElementById('journal-summary');
+      const summaryList = document.getElementById('summary-list');
+      const summaryStatus = document.getElementById('summary-status');
+
+      function showStatus(message, isError = false) {
+        summaryStatus.textContent = message;
+        summaryStatus.classList.toggle('error', isError);
+        summaryStatus.hidden = !message;
+      }
+
+      function renderBullets(rawSummary) {
+        summaryList.innerHTML = '';
+
+        const lines = rawSummary
+          .split(/\r?\n/)
+          .map((line) => line.trim())
+          .filter((line) => line.length > 0);
+
+        const bulletItems = [];
+        for (const line of lines) {
+          // Strip common markdown/plain-text list prefixes (*, -, •, 1., etc.)
+          const cleaned = line
+            .replace(/^(\*|-|•|\d+[.)])\s+/, '')
+            .replace(/\*\*(.*?)\*\*/g, '$1')
+            .trim();
+          if (cleaned) {
+            bulletItems.push(cleaned);
+          }
+        }
+
+        const itemsToRender = bulletItems.length > 0 ? bulletItems : [rawSummary.trim()];
+
+        for (const itemText of itemsToRender) {
+          const li = document.createElement('li');
+          li.textContent = itemText;
+          summaryList.appendChild(li);
+        }
+
+        summaryContainer.hidden = false;
+      }
+
+      async function summarizeWithNativeAI(text) {
+        const sharedContext =
+          "An article from The Daily Grind coffee roaster's journal explaining their ethical bean sourcing, harvesting, processing, and quality control process.";
+
+        // Standard Chrome Built-in AI Summarizer API (window.Summarizer)
+        if ('Summarizer' in self && typeof self.Summarizer?.create === 'function') {
+          if (typeof self.Summarizer.availability === 'function') {
+            const availability = await self.Summarizer.availability();
+            if (availability === 'unavailable' || availability === 'no') {
+              throw new Error('The browser native AI Summarizer model is unavailable on this device.');
+            }
+          }
+
+          const summarizer = await self.Summarizer.create({
+            sharedContext,
+            type: 'key-points',
+            format: 'markdown',
+            length: 'short',
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (typeof e.loaded === 'number') {
+                  const percent = e.total
+                    ? Math.round((e.loaded / e.total) * 100)
+                    : Math.round(e.loaded * 100);
+                  showStatus(`Downloading browser AI model (${percent}%)...`);
+                }
+              });
+            }
+          });
+
+          try {
+            showStatus('Generating bullet-point summary with browser AI...');
+            return await summarizer.summarize(text, {
+              context: 'Summarize the coffee bean sourcing process into a few concise bullet points.'
+            });
+          } finally {
+            if (typeof summarizer.destroy === 'function') {
+              summarizer.destroy();
+            }
+          }
+        }
+
+        // Fallback to earlier Chrome origin-trial namespace (self.ai.summarizer)
+        if (self.ai && self.ai.summarizer && typeof self.ai.summarizer.create === 'function') {
+          if (typeof self.ai.summarizer.capabilities === 'function') {
+            const capabilities = await self.ai.summarizer.capabilities();
+            if (capabilities && capabilities.available === 'no') {
+              throw new Error('The browser native AI Summarizer model is unavailable on this device.');
+            }
+          }
+
+          const summarizer = await self.ai.summarizer.create({
+            sharedContext,
+            type: 'key-points',
+            format: 'markdown',
+            length: 'short'
+          });
+
+          try {
+            showStatus('Generating bullet-point summary with browser AI...');
+            return await summarizer.summarize(text);
+          } finally {
+            if (typeof summarizer.destroy === 'function') {
+              summarizer.destroy();
+            }
+          }
+        }
+
+        throw new Error(
+          'Your browser does not support the native AI Summarizer API (window.Summarizer).'
+        );
+      }
+
+      summarizeBtn.addEventListener('click', async () => {
+        const articleText = journalArticle.innerText.trim();
+        if (!articleText) return;
+
+        summarizeBtn.disabled = true;
+        const originalBtnHTML = summarizeBtn.innerHTML;
+        summarizeBtn.textContent = 'Summarizing...';
+        showStatus('Checking browser AI availability...');
+
+        try {
+          const result = await summarizeWithNativeAI(articleText);
+          if (!result || !result.trim()) {
+            throw new Error('The browser AI returned an empty summary.');
+          }
+          renderBullets(result);
+          showStatus('');
+        } catch (err) {
+          showStatus(
+            err && err.message
+              ? err.message
+              : 'Unable to summarize text using the browser native AI.',
+            true
+          );
+        } finally {
+          summarizeBtn.disabled = false;
+          summarizeBtn.innerHTML = originalBtnHTML;
+        }
+      });
+    })();
+  </script>
