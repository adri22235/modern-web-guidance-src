+    <section id="roasters-journal" class="journal-section" aria-labelledby="journal-heading">
+      <div class="journal-header">
+        <div>
+          <div class="journal-eyebrow">Behind the Beans</div>
+          <h2 id="journal-heading">Roaster's Journal</h2>
