   </footer>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoOffers = [
+      {
+        badge: 'Limited Time',
+        title: 'Buy One, Share One',
+        description: 'Order any seasonal signature latte and get a second cup on the house.',
+        cta: 'Redeem Now'
+      },
+      {
+        badge: 'Member Exclusive',
+        title: 'Double Bean Points',
+        description: 'Earn 2x loyalty points on whole-bean coffee bags all weekend long.',
+        cta: 'Activate Bonus'
+      },
+      {
+        badge: 'Bundle Saver',
+        title: 'Pastry & Pour-Over',
+        description: 'Pair a fresh-baked croissant with any single-origin pour-over for $7.',
+        cta: 'View Bundle'
+      },
+      {
+        badge: 'Afternoon Pick-Me-Up',
+        title: 'Half-Price Cold Brew',
+        description: 'Cool down between 2 PM and 5 PM with 50% off any size Cold Brew.',
+        cta: 'Grab Deal'
+      }
+    ];
+
+    let promoCount = 0;
+
+    addBtn.addEventListener('click', () => {
+      const offer = promoOffers[promoCount % promoOffers.length];
+      promoCount += 1;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <span class="promo-badge">${offer.badge}</span>
+        <h3>${offer.title}</h3>
+        <p>${offer.description}</p>
+        <a href="/rewards" class="btn">${offer.cta}</a>
+      `;
+
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      if (!cards.length) return;
+
+      const lastCard = cards[cards.length - 1];
+      lastCard.classList.add('removing');
+
+      let removed = false;
+      const finalizeRemoval = () => {
+        if (removed) return;
+        removed = true;
+        lastCard.remove();
+      };
+
+      const onTransitionEnd = (event) => {
+        if (event.target !== lastCard) return;
+        lastCard.removeEventListener('transitionend', onTransitionEnd);
+        finalizeRemoval();
+      };
+
+      lastCard.addEventListener('transitionend', onTransitionEnd);
+      setTimeout(finalizeRemoval, 370);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      if (!domContainer.contains(toggleCard)) {
+        toggleCard.classList.remove('hidden', 'removing');
+        domContainer.prepend(toggleCard);
+      } else {
+        toggleCard.classList.toggle('hidden');
+      }
+    });
+  </script>
+
 </body>
 
