+  <script>
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000)),
+        ]);
+      }
+
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    async function removeElement(el) {
+      await hideElement(el);
+      el.remove();
+    }
+
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoOffers = [
+      {
+        badge: 'Limited Time',
+        title: 'Double Bean Rewards',
+        description: 'Earn 2x loyalty points on all whole-bean bags purchased online or in-store.',
+        linkText: 'Shop Beans',
+        href: '/rewards'
+      },
+      {
+        badge: 'Afternoon Pick-Me-Up',
+        title: 'Half-Price Cold Brew',
+        description: 'Enjoy 50% off our 18-hour steeped cold brew every weekday from 2 PM to 4 PM.',
+        linkText: 'Order Cold Brew',
+        href: '/menu/cold-brew'
+      },
+      {
+        badge: 'Roaster Special',
+        title: 'Single-Origin Tasting Flight',
+        description: 'Sample three seasonal micro-lot roasts for the price of a single cup.',
+        linkText: 'Explore Roasts',
+        href: '/menu'
+      },
+      {
+        badge: 'Subscriber Perk',
+        title: 'Free Oat Milk Upgrade',
+        description: 'Complimentary artisanal oat or almond milk upgrade on any specialty latte.',
+        linkText: 'View Menu',
+        href: '/menu/seasonal'
+      }
+    ];
+
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const offer = promoOffers[promoIndex % promoOffers.length];
+      promoIndex += 1;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+
+      const badge = document.createElement('span');
+      badge.className = 'promo-badge';
+      badge.textContent = offer.badge;
+
+      const title = document.createElement('h3');
+      title.textContent = offer.title;
+
+      const description = document.createElement('p');
+      description.textContent = offer.description;
+
+      const link = document.createElement('a');
+      link.href = offer.href;
+      link.className = 'btn';
+      link.textContent = offer.linkText;
+
+      card.append(badge, title, description, link);
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-closing]):not([data-removing])');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.setAttribute('data-removing', '');
+      await removeElement(lastCard);
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      const isHidden = toggleCard.hidden || toggleCard.hasAttribute('data-closing');
+      if (isHidden) {
+        showElement(toggleCard);
+        toggleBtn.setAttribute('aria-expanded', 'true');
+      } else {
+        toggleBtn.setAttribute('aria-expanded', 'false');
+        await hideElement(toggleCard);
+      }
+    });
+  </script>
