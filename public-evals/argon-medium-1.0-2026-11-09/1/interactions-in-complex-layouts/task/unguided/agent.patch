+  <script>
+    (function () {
+      const columnState = {
+        queued: [
+          {
+            id: 'ord-101',
+            orderNumber: '#101',
+            customer: 'Elena R.',
+            drink: 'Maple Oat Latte',
+            size: 'Medium',
+            notes: 'Oat milk, extra foam',
+            status: 'queued'
+          },
+          {
+            id: 'ord-102',
+            orderNumber: '#102',
+            customer: 'Marcus T.',
+            drink: 'Dark Roast Espresso',
+            size: 'Small',
+            notes: 'Double shot',
+            status: 'queued'
+          },
+          {
+            id: 'ord-103',
+            orderNumber: '#103',
+            customer: 'Priya K.',
+            drink: 'Matcha Latte',
+            size: 'Large',
+            notes: 'Iced, light sweetener',
+            status: 'queued'
+          }
+        ],
+        brewing: [
+          {
+            id: 'ord-099',
+            orderNumber: '#099',
+            customer: 'Devon S.',
+            drink: 'Cold Brew',
+            size: 'Large',
+            notes: 'Splash of almond milk',
+            status: 'brewing'
+          },
+          {
+            id: 'ord-100',
+            orderNumber: '#100',
+            customer: 'Hannah W.',
+            drink: 'Cappuccino',
+            size: 'Medium',
+            notes: 'Extra hot, cinnamon dusting',
+            status: 'brewing'
+          }
+        ],
+        ready: [
+          {
+            id: 'ord-098',
+            orderNumber: '#098',
+            customer: 'Liam B.',
+            drink: 'Caramel Macchiato',
+            size: 'Medium',
+            notes: 'Extra caramel drizzle',
+            status: 'ready'
+          }
+        ]
+      };
+
+      let nextOrderNum = 104;
+      let activeDrag = null;
+
+      function createCardElement(order) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.draggable = true;
+        card.id = order.id;
+        card.dataset.orderId = order.id;
+        card.dataset.status = order.status;
+
+        const topRow = document.createElement('div');
+        topRow.className = 'order-top';
+
+        const idBadge = document.createElement('span');
+        idBadge.className = 'order-id';
+        idBadge.textContent = order.orderNumber;
+
+        const sizeBadge = document.createElement('span');
+        sizeBadge.className = 'order-size';
+        sizeBadge.textContent = order.size;
+
+        topRow.appendChild(idBadge);
+        topRow.appendChild(sizeBadge);
+
+        const title = document.createElement('h3');
+        title.textContent = order.drink;
+
+        const customer = document.createElement('div');
+        customer.className = 'order-customer';
+        customer.textContent = 'For: ' + order.customer;
+
+        card.appendChild(topRow);
+        card.appendChild(title);
+        card.appendChild(customer);
+
+        if (order.notes) {
+          const notes = document.createElement('div');
+          notes.className = 'order-notes';
+          notes.textContent = order.notes;
+          card.appendChild(notes);
+        }
+
+        card.addEventListener('dragstart', function (e) {
+          activeDrag = {
+            orderId: order.id,
+            sourceStatus: order.status
+          };
+          card.classList.add('dragging');
+          if (e.dataTransfer) {
+            e.dataTransfer.effectAllowed = 'move';
+            e.dataTransfer.setData('text/plain', order.id);
+          }
+        });
+
+        card.addEventListener('dragend', function () {
+          card.classList.remove('dragging');
+          activeDrag = null;
+          document.querySelectorAll('.board-column.drag-over').forEach(function (col) {
+            col.classList.remove('drag-over');
+          });
+        });
+
+        return card;
+      }
+
+      // Isolated column renderer: updates only the specified column's DOM
+      function renderColumn(status) {
+        const columnEl = document.querySelector('.board-column[data-status="' + status + '"]');
+        if (!columnEl) return;
+
+        const cardsContainer = columnEl.querySelector('.column-cards');
+        const countBadge = columnEl.querySelector('.column-count');
+        const orders = columnState[status] || [];
+
+        if (countBadge) {
+          countBadge.textContent = String(orders.length);
+        }
+
+        if (cardsContainer) {
+          const fragment = document.createDocumentFragment();
+          for (let i = 0; i < orders.length; i++) {
+            fragment.appendChild(createCardElement(orders[i]));
+          }
+          cardsContainer.replaceChildren(fragment);
+        }
+      }
+
+      function moveOrder(orderId, targetStatus) {
+        if (!orderId || !columnState[targetStatus]) return;
+
+        let sourceStatus = null;
+        let orderIndex = -1;
+
+        const statuses = Object.keys(columnState);
+        for (let i = 0; i < statuses.length; i++) {
+          const st = statuses[i];
+          const idx = columnState[st].findIndex(function (o) {
+            return o.id === orderId;
+          });
+          if (idx !== -1) {
+            sourceStatus = st;
+            orderIndex = idx;
+            break;
+          }
+        }
+
+        if (!sourceStatus || orderIndex === -1 || sourceStatus === targetStatus) {
+          return;
+        }
+
+        const movedOrder = columnState[sourceStatus].splice(orderIndex, 1)[0];
+        movedOrder.status = targetStatus;
+        columnState[targetStatus].push(movedOrder);
+
+        // Re-render only the affected source and target columns in isolation
+        renderColumn(sourceStatus);
+        renderColumn(targetStatus);
+      }
+
+      function setupColumnDragAndDrop() {
+        const columns = document.querySelectorAll('.board-column');
+        columns.forEach(function (column) {
+          const status = column.dataset.status;
+
+          column.addEventListener('dragover', function (e) {
+            e.preventDefault();
+            if (e.dataTransfer) {
+              e.dataTransfer.dropEffect = 'move';
+            }
+            if (!column.classList.contains('drag-over')) {
+              column.classList.add('drag-over');
+            }
+          });
+
+          column.addEventListener('dragleave', function (e) {
+            if (!column.contains(e.relatedTarget)) {
+              column.classList.remove('drag-over');
+            }
+          });
+
+          column.addEventListener('drop', function (e) {
+            e.preventDefault();
+            column.classList.remove('drag-over');
+
+            let orderId = activeDrag ? activeDrag.orderId : null;
+            if (!orderId && e.dataTransfer) {
+              orderId = e.dataTransfer.getData('text/plain');
+            }
+
+            if (orderId && status) {
+              moveOrder(orderId, status);
+            }
+          });
+        });
+      }
+
+      function setupAddOrderForm() {
+        const form = document.getElementById('add-order-form');
+        if (!form) return;
+
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          const customerInput = document.getElementById('customer-input');
+          const drinkInput = document.getElementById('drink-input');
+          const sizeInput = document.getElementById('size-input');
+          const notesInput = document.getElementById('notes-input');
+
+          const customer = customerInput.value.trim();
+          if (!customer) return;
+
+          const newOrder = {
+            id: 'ord-' + nextOrderNum,
+            orderNumber: '#' + nextOrderNum,
+            customer: customer,
+            drink: drinkInput.value,
+            size: sizeInput.value,
+            notes: notesInput.value.trim() || 'Standard preparation',
+            status: 'queued'
+          };
+          nextOrderNum++;
+
+          columnState.queued.push(newOrder);
+          // Isolated render: only the 'queued' column is updated
+          renderColumn('queued');
+
+          customerInput.value = '';
+          notesInput.value = '';
+        });
+      }
+
+      // Initial isolated render per column
+      renderColumn('queued');
+      renderColumn('brewing');
+      renderColumn('ready');
+      setupColumnDragAndDrop();
+      setupAddOrderForm();
+    })();
+  </script>
 </body>
 
 </html>
