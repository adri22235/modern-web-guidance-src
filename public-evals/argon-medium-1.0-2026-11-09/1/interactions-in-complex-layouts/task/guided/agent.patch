+      queued: 'Queued',
+      brewing: 'Brewing',
+      ready: 'Ready'
+    };
+
+    const STAGE_ORDER = ['queued', 'brewing', 'ready'];
+
+    let activeDraggedCard = null;
+    let nextOrderNumber = 104;
+
+    const board = document.querySelector('.kanban-board');
+    const columns = Array.from(document.querySelectorAll('.board-column'));
+    const liveRegion = document.getElementById('board-live-region');
+    const newOrderForm = document.getElementById('new-order-form');
+
+    function moveElementPreservingState(targetParent, nodeToMove, referenceNode = null) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, referenceNode);
+      } else {
+        targetParent.insertBefore(nodeToMove, referenceNode);
+      }
+    }
+
+    function updateColumnCounts() {
+      for (const col of columns) {
+        const status = col.dataset.column;
+        const count = col.querySelectorAll('.card').length;
+        const badge = col.querySelector(`[data-count-for="${status}"]`);
+        if (badge) {
+          badge.textContent = String(count);
+        }
+      }
+    }
+
+    function renderCardActions(card, status) {
+      const actionsContainer = card.querySelector('.card-actions');
+      const drinkTitle = card.querySelector('h3')?.textContent?.trim() || 'Order';
+      if (!actionsContainer) return;
+
+      actionsContainer.replaceChildren();
+
+      const idx = STAGE_ORDER.indexOf(status);
+      if (idx > 0) {
+        const prevStage = STAGE_ORDER[idx - 1];
+        const prevBtn = document.createElement('button');
+        prevBtn.type = 'button';
+        prevBtn.className = 'card-btn';
+        prevBtn.dataset.moveTarget = prevStage;
+        prevBtn.setAttribute('aria-label', `Move ${drinkTitle} back to ${STAGE_LABELS[prevStage]}`);
+        prevBtn.textContent = `\u2190 ${prevStage === 'queued' ? 'Queue' : 'Brew'}`;
+        actionsContainer.appendChild(prevBtn);
+      }
+
+      if (idx < STAGE_ORDER.length - 1) {
+        const nextStage = STAGE_ORDER[idx + 1];
+        const nextBtn = document.createElement('button');
+        nextBtn.type = 'button';
+        nextBtn.className = 'card-btn';
+        nextBtn.dataset.moveTarget = nextStage;
+        nextBtn.setAttribute('aria-label', `Move ${drinkTitle} to ${STAGE_LABELS[nextStage]}`);
+        nextBtn.textContent = `${nextStage === 'brewing' ? 'Brew' : 'Ready'} \u2192`;
+        actionsContainer.appendChild(nextBtn);
+      }
+    }
+
+    function updateCardStatusMetadata(card, newStatus) {
+      card.dataset.status = newStatus;
+      const orderId = card.dataset.orderId || card.id.replace(/^order-/, '');
+      const badge = card.querySelector('.order-badge');
+      if (badge) {
+        badge.textContent = `#${orderId} \u00b7 ${STAGE_LABELS[newStatus] || newStatus}`;
+      }
+      renderCardActions(card, newStatus);
+    }
+
+    function getDropReferenceCard(column, clientY, draggedCard) {
+      if (typeof clientY !== 'number' || Number.isNaN(clientY) || clientY <= 0) {
+        return null;
+      }
+      const candidateCards = Array.from(column.querySelectorAll('.card')).filter(
+        (c) => c !== draggedCard
+      );
+      for (const candidate of candidateCards) {
+        const box = candidate.getBoundingClientRect();
+        const midpoint = box.top + box.height / 2;
+        if (clientY < midpoint) {
+          return candidate;
+        }
+      }
+      return null;
+    }
+
+    function moveCardToColumn(card, targetColumn, referenceCard = null) {
+      if (!card || !targetColumn) return;
+
+      const validReference =
+        referenceCard && referenceCard.parentElement === targetColumn && referenceCard !== card
+          ? referenceCard
+          : null;
+
+      moveElementPreservingState(targetColumn, card, validReference);
+
+      const newStatus = targetColumn.dataset.column || 'queued';
+      updateCardStatusMetadata(card, newStatus);
+      updateColumnCounts();
+
+      const drinkTitle = card.querySelector('h3')?.textContent?.trim() || card.id;
+      if (liveRegion) {
+        liveRegion.textContent = `Moved ${drinkTitle} to ${STAGE_LABELS[newStatus] || newStatus}.`;
+      }
+    }
+
+    // Expose helper for programmatic moves
+    window.moveItemToColumn = function moveItemToColumn(itemId, columnId) {
+      const item = document.getElementById(itemId);
+      const column =
+        document.getElementById(columnId) ||
+        document.querySelector(`.board-column[data-column="${columnId}"]`);
+      if (item && column) {
+        moveCardToColumn(item, column, null);
+      }
+    };
+
+    board.addEventListener('dragstart', (event) => {
+      const card = event.target.closest('.card');
+      if (!card) return;
+
+      activeDraggedCard = card;
+      card.classList.add('dragging');
+
+      if (event.dataTransfer) {
+        event.dataTransfer.effectAllowed = 'move';
+        event.dataTransfer.setData('text/plain', card.id);
+      }
+    });
+
+    board.addEventListener('dragend', (event) => {
+      const card = event.target.closest('.card');
+      if (card) {
+        card.classList.remove('dragging');
+      }
+      for (const col of columns) {
+        col.classList.remove('drag-over');
+      }
+      activeDraggedCard = null;
+    });
+
+    for (const column of columns) {
+      column.addEventListener('dragenter', (event) => {
+        event.preventDefault();
+        column.classList.add('drag-over');
+      });
+
+      column.addEventListener('dragover', (event) => {
+        event.preventDefault();
+        if (event.dataTransfer) {
+          event.dataTransfer.dropEffect = 'move';
+        }
+        column.classList.add('drag-over');
+      });
+
+      column.addEventListener('dragleave', (event) => {
+        if (!column.contains(event.relatedTarget)) {
+          column.classList.remove('drag-over');
+        }
+      });
+
+      column.addEventListener('drop', (event) => {
+        event.preventDefault();
+        column.classList.remove('drag-over');
+
+        const transferredId = event.dataTransfer?.getData('text/plain');
+        const card =
+          (transferredId && document.getElementById(transferredId)) ||
+          activeDraggedCard ||
+          document.querySelector('.card.dragging');
+
+        if (!card) return;
+
+        const referenceCard = getDropReferenceCard(column, event.clientY, card);
+        moveCardToColumn(card, column, referenceCard);
+        card.classList.remove('dragging');
+        activeDraggedCard = null;
+      });
+    }
+
+    // Button click actions & keyboard shortcuts for accessible column transitions
+    board.addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-move-target]');
+      if (!button) return;
+
+      const card = button.closest('.card');
+      const targetStage = button.dataset.moveTarget;
+      const targetColumn = document.querySelector(`.board-column[data-column="${targetStage}"]`);
+      if (card && targetColumn) {
+        moveCardToColumn(card, targetColumn, null);
+        card.focus();
+      }
+    });
+
+    board.addEventListener('keydown', (event) => {
+      if (event.target.closest('button, input, select, textarea')) return;
+      const card = event.target.closest('.card');
+      if (!card) return;
+
+      const currentColumn = card.closest('.board-column');
+      if (!currentColumn) return;
+
+      const currentIdx = STAGE_ORDER.indexOf(currentColumn.dataset.column);
+      if (currentIdx === -1) return;
+
+      let nextIdx = -1;
+      if (event.key === 'ArrowRight') {
+        nextIdx = Math.min(STAGE_ORDER.length - 1, currentIdx + 1);
+      } else if (event.key === 'ArrowLeft') {
+        nextIdx = Math.max(0, currentIdx - 1);
+      }
+
+      if (nextIdx !== -1 && nextIdx !== currentIdx) {
+        event.preventDefault();
+        const targetColumn = document.querySelector(
+          `.board-column[data-column="${STAGE_ORDER[nextIdx]}"]`
+        );
+        if (targetColumn) {
+          moveCardToColumn(card, targetColumn, null);
+          card.focus();
+        }
+      }
+    });
+
+    newOrderForm?.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const drinkInput = document.getElementById('drink-name');
+      const customerInput = document.getElementById('customer-name');
+      const notesInput = document.getElementById('drink-notes');
+
+      const drink = drinkInput.value.trim();
+      const customer = customerInput.value.trim();
+      const notes = notesInput.value.trim() || '12oz Hot \u00b7 Standard preparation';
+      if (!drink || !customer) return;
+
+      const orderId = String(nextOrderNumber++);
+      const article = document.createElement('article');
+      article.className = 'card';
+      article.id = `order-${orderId}`;
+      article.draggable = true;
+      article.tabIndex = 0;
+      article.dataset.orderId = orderId;
+      article.dataset.status = 'queued';
+
+      const header = document.createElement('header');
+      const h3 = document.createElement('h3');
+      h3.textContent = drink;
+      const badge = document.createElement('span');
+      badge.className = 'order-badge';
+      badge.textContent = `#${orderId} \u00b7 Queued`;
+      header.append(h3, badge);
+
+      const p = document.createElement('p');
+      p.textContent = notes;
+
+      const footer = document.createElement('footer');
+      const meta = document.createElement('span');
+      meta.className = 'order-meta';
+      meta.textContent = `For ${customer} \u00b7 Just now`;
+      const actions = document.createElement('div');
+      actions.className = 'card-actions';
+      footer.append(meta, actions);
+
+      article.append(header, p, footer);
+      renderCardActions(article, 'queued');
+
+      const queuedColumn = document.querySelector('.board-column[data-column="queued"]');
+      if (queuedColumn) {
+        queuedColumn.appendChild(article);
+        updateColumnCounts();
+        if (liveRegion) {
+          liveRegion.textContent = `Added order #${orderId} ${drink} for ${customer} to Queued.`;
+        }
+      }
+
+      newOrderForm.reset();
+    });
+  </script>
+
 </body>
 
