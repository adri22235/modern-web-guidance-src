+  <script>
+    (function () {
+      const wholesaleTabs = Array.from(document.querySelectorAll('.wholesale-tab'));
+
+      function syncTabStates(activeTab) {
+        wholesaleTabs.forEach((tab) => {
+          const panel = tab.querySelector('.wholesale-tab-content');
+          if (activeTab && tab === activeTab) {
+            if (!tab.open) {
+              tab.open = true;
+            }
+            if (panel) {
+              panel.removeAttribute('hidden');
+            }
+            tab.classList.add('active');
+            tab.setAttribute('aria-expanded', 'true');
+            tab.setAttribute('aria-selected', 'true');
+          } else if (activeTab && tab !== activeTab) {
+            if (tab.open) {
+              tab.open = false;
+            }
+            if (panel) {
+              panel.setAttribute('hidden', 'until-found');
+            }
+            tab.classList.remove('active');
+            tab.setAttribute('aria-expanded', 'false');
+            tab.setAttribute('aria-selected', 'false');
+          } else {
+            if (tab.open) {
+              if (panel) {
+                panel.removeAttribute('hidden');
+              }
+              tab.classList.add('active');
+              tab.setAttribute('aria-expanded', 'true');
+              tab.setAttribute('aria-selected', 'true');
+            } else {
+              if (panel) {
+                panel.setAttribute('hidden', 'until-found');
+              }
+              tab.classList.remove('active');
+              tab.setAttribute('aria-expanded', 'false');
+              tab.setAttribute('aria-selected', 'false');
+            }
+          }
+        });
+      }
+
+      wholesaleTabs.forEach((tab) => {
+        const panel = tab.querySelector('.wholesale-tab-content');
+
+        tab.addEventListener('click', (event) => {
+          const clickedSummary = event.target.closest('summary');
+          if (!clickedSummary) {
+            if (!tab.open) {
+              syncTabStates(tab);
+            }
+            return;
+          }
+          if (!tab.open) {
+            if (panel) {
+              panel.removeAttribute('hidden');
+            }
+            wholesaleTabs.forEach((other) => {
+              if (other !== tab) {
+                const otherPanel = other.querySelector('.wholesale-tab-content');
+                if (otherPanel) {
+                  otherPanel.setAttribute('hidden', 'until-found');
+                }
+              }
+            });
+          }
+        });
+
+        tab.addEventListener('toggle', () => {
+          if (tab.open) {
+            syncTabStates(tab);
+          } else {
+            syncTabStates(null);
+          }
+        });
+
+        tab.addEventListener('beforematch', () => {
+          syncTabStates(tab);
+        });
+
+        if (panel) {
+          panel.addEventListener('beforematch', () => {
+            syncTabStates(tab);
+          });
+        }
+      });
+
+      const revealCouponBtn = document.getElementById('reveal-coupon-btn');
+      const couponPanel = document.getElementById('coupon-panel');
+
+      function revealCoupon() {
+        if (couponPanel) {
+          couponPanel.removeAttribute('hidden');
+        }
+        if (revealCouponBtn) {
+          revealCouponBtn.setAttribute('aria-expanded', 'true');
+        }
+      }
+
+      if (revealCouponBtn) {
+        revealCouponBtn.addEventListener('click', revealCoupon);
+      }
+
+      if (couponPanel) {
+        couponPanel.addEventListener('beforematch', revealCoupon);
+      }
+    })();
+  </script>
+
