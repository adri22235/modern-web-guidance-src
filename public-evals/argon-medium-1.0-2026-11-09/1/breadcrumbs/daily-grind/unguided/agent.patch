+  <script>
+    (function () {
+      const items = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          href: '/menu/seasonal',
+          price: '$5.50',
+          description: 'Creamy oat milk steamed to perfection and blended with our signature espresso and pure Vermont maple syrup, finished with a light dusting of cinnamon.'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          href: '/menu/espresso',
+          price: '$3.75',
+          description: 'Bold, smokey, and full-bodied single-origin espresso roasted dark for a rich crema and intense morning boost.'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          href: '/menu/cold-brew',
+          price: '$4.75',
+          description: 'Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for maximum smoothness and naturally sweet chocolate notes.'
+        }
+      };
+
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const seasonalGrid = document.getElementById('seasonal-grid');
+      const detailView = document.getElementById('item-detail-view');
+      const detailTitle = document.getElementById('detail-title');
+      const detailPrice = document.getElementById('detail-price');
+      const detailDescription = document.getElementById('detail-description');
+      const backBtn = document.getElementById('back-to-seasonal');
+
+      function renderBreadcrumbs(trail) {
+        breadcrumbList.innerHTML = '';
+        trail.forEach((crumb, idx) => {
+          const li = document.createElement('li');
+          const isLast = idx === trail.length - 1;
+          li.className = isLast ? 'breadcrumb-item active' : 'breadcrumb-item';
+          if (isLast) {
+            li.setAttribute('aria-current', 'page');
+            li.textContent = crumb.label;
+          } else {
+            const a = document.createElement('a');
+            a.href = crumb.href;
+            a.dataset.level = crumb.level;
+            a.textContent = crumb.label;
+            li.appendChild(a);
+          }
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      function showLevel(level, itemKey) {
+        document.querySelectorAll('.card[data-item]').forEach((card) => {
+          card.style.outline = card.dataset.item === itemKey ? '2px solid var(--accent)' : 'none';
+        });
+
+        if (level === 'item' && items[itemKey]) {
+          const item = items[itemKey];
+          detailTitle.textContent = item.name;
+          detailPrice.textContent = item.price;
+          detailDescription.textContent = item.description;
+          detailView.classList.add('active');
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' },
+            { label: 'Seasonal Favorites', href: '/menu#seasonal', level: 'seasonal' },
+            { label: item.name, href: item.href, level: 'item' }
+          ]);
+        } else if (level === 'home') {
+          detailView.classList.remove('active');
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' }
+          ]);
+        } else if (level === 'menu') {
+          detailView.classList.remove('active');
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' }
+          ]);
+        } else {
+          detailView.classList.remove('active');
+          renderBreadcrumbs([
+            { label: 'Home', href: '/', level: 'home' },
+            { label: 'Menu', href: '/menu', level: 'menu' },
+            { label: 'Seasonal Favorites', href: '/menu#seasonal', level: 'seasonal' }
+          ]);
+        }
+      }
+
+      document.querySelectorAll('[data-item-link]').forEach((link) => {
+        link.addEventListener('click', (e) => {
+          e.preventDefault();
+          showLevel('item', link.getAttribute('data-item-link'));
+        });
+      });
+
+      breadcrumbList.addEventListener('click', (e) => {
+        const link = e.target.closest('a[data-level]');
+        if (!link) return;
+        e.preventDefault();
+        showLevel(link.dataset.level);
+      });
+
+      if (backBtn) {
+        backBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          showLevel('seasonal');
+        });
+      }
+    })();
+  </script>
 </body>
 
