+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        href: '/menu/seasonal',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        notes: '12 oz / 16 oz • Double-shot espresso, steamed oat milk, pure Grade A maple syrup'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        href: '/menu/espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        notes: 'Single / Double • Small-batch roasted single-origin beans with dark chocolate notes'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        href: '/menu/cold-brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        notes: '16 oz / 20 oz • Slow-steeped filtered water extraction served over ice'
+      }
+    };
+
+    const BASE_TRAIL = [
+      { label: 'Home', href: '/' },
+      { label: 'Menu', href: '/menu' },
+      { label: 'Seasonal Favorites', href: '/menu/seasonal-favorites' }
+    ];
+
+    const breadcrumbList = document.getElementById('breadcrumb-list');
+    const favoritesGrid = document.getElementById('favorites-grid');
+    const itemDetail = document.getElementById('item-detail');
+    const detailTitle = document.getElementById('detail-title');
+    const detailDescription = document.getElementById('detail-description');
+    const detailNotes = document.getElementById('detail-notes');
+    const sectionHeading = document.getElementById('section-heading');
+
+    function renderBreadcrumbs(trail) {
+      breadcrumbList.replaceChildren();
+      trail.forEach((step, index) => {
+        const li = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = step.href;
+        link.textContent = step.label;
+        if (index === trail.length - 1) {
+          link.setAttribute('aria-current', 'page');
+        }
+        li.appendChild(link);
+        breadcrumbList.appendChild(li);
+      });
+    }
+
+    function showParentLevel(targetHref) {
+      itemDetail.hidden = true;
+      favoritesGrid.hidden = false;
+      if (targetHref === '/') {
+        sectionHeading.textContent = 'Seasonal Favorites';
+        document.title = 'Home | The Daily Grind';
+        renderBreadcrumbs(BASE_TRAIL.slice(0, 1));
+      } else if (targetHref === '/menu') {
+        sectionHeading.textContent = 'Menu — Seasonal Favorites';
+        document.title = 'Menu | The Daily Grind';
+        renderBreadcrumbs(BASE_TRAIL.slice(0, 2));
+      } else {
+        sectionHeading.textContent = 'Seasonal Favorites';
+        document.title = 'Seasonal Favorites | The Daily Grind';
+        renderBreadcrumbs(BASE_TRAIL);
+      }
+    }
+
+    function showItemDetail(itemKey) {
+      const item = ITEMS[itemKey];
+      if (!item) return;
+      favoritesGrid.hidden = true;
+      itemDetail.hidden = false;
+      detailTitle.textContent = item.name;
+      detailDescription.textContent = item.description;
+      detailNotes.textContent = item.notes;
+      document.title = `${item.name} | The Daily Grind`;
+      renderBreadcrumbs([...BASE_TRAIL, { label: item.name, href: item.href }]);
+    }
+
+    favoritesGrid.addEventListener('click', (event) => {
+      const trigger = event.target.closest('a[data-item]');
+      if (!trigger) return;
+      event.preventDefault();
+      showItemDetail(trigger.dataset.item);
+      detailTitle.focus();
+    });
+
+    document.getElementById('back-to-seasonal').addEventListener('click', (event) => {
+      event.preventDefault();
+      showParentLevel('/menu/seasonal-favorites');
+      sectionHeading.focus();
+    });
+
+    breadcrumbList.addEventListener('click', (event) => {
+      const link = event.target.closest('a');
+      if (!link) return;
+      event.preventDefault();
+      if (link.getAttribute('aria-current') === 'page') return;
+      showParentLevel(link.getAttribute('href'));
+      sectionHeading.focus();
+    });
+  </script>
+
 </body>
 
