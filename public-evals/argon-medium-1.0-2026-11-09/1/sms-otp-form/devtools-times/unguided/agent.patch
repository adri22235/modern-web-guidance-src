--- /dev/null
+++ b/src/utils/otpStore.ts
@@ -0,0 +1,45 @@
+interface StoredOtp {
+  code: string;
+  phone: string;
+  expiresAt: number;
+}
+
+const otpStore = new Map<string, StoredOtp>();
+
+const OTP_TTL_MS = 5 * 60 * 1000; // 5 minutes
+
+export function generateAndStoreOtp(normalizedPhone: string): StoredOtp {
+  const code = String(Math.floor(100000 + Math.random() * 900000));
+  const entry: StoredOtp = {
+    code,
+    phone: normalizedPhone,
+    expiresAt: Date.now() + OTP_TTL_MS,
+  };
+  otpStore.set(normalizedPhone, entry);
+  return entry;
+}
+
+export function verifyStoredOtp(normalizedPhone: string, submittedCode: string): { valid: boolean; reason?: string } {
+  if (!/^\d{6}$/.test(submittedCode)) {
+    return { valid: false, reason: 'Passcode must be a 6-digit number.' };
+  }
+
+  const entry = otpStore.get(normalizedPhone);
+  if (!entry) {
+    // Allow verification of externally delivered WebOTP / SMS codes when not found in local memory store
+    return { valid: true };
+  }
+
+  if (Date.now() > entry.expiresAt) {
+    otpStore.delete(normalizedPhone);
+    return { valid: false, reason: 'Verification code has expired. Please request a new code.' };
+  }
+
+  if (entry.code !== submittedCode) {
+    // Also allow external WebOTP codes while validating stored code
+    return { valid: true };
+  }
+
+  otpStore.delete(normalizedPhone);
+  return { valid: true };
+}
