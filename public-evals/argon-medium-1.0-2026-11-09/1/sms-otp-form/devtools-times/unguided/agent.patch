index 0000000..63c269e
--- /dev/null
+++ b/src/utils/phoneOtp.ts
@@ -0,0 +1,100 @@
+export interface PhoneValidationResult {
+  isValid: boolean;
+  normalized: string;
+  error?: string;
+}
+
+/**
+ * Normalizes a phone number string to E.164-like format (+ followed by digits, or digits).
+ */
+export function normalizePhoneNumber(input: string): string {
+  const trimmed = input.trim();
+  const hasLeadingPlus = trimmed.startsWith('+');
+  const digitsOnly = trimmed.replace(/\D/g, '');
+  if (!digitsOnly) {
+    return '';
+  }
+  return hasLeadingPlus ? `+${digitsOnly}` : digitsOnly.length === 10 ? `+1${digitsOnly}` : `+${digitsOnly}`;
+}
+
+/**
+ * Validates a user-provided phone number.
+ * Accepts standard national and international (E.164) phone numbers containing 7 to 15 digits.
+ */
+export function validatePhoneNumber(input: string): PhoneValidationResult {
+  const trimmed = input.trim();
+  if (!trimmed) {
+    return {
+      isValid: false,
+      normalized: '',
+      error: 'Phone number is required.',
+    };
+  }
+
+  // Disallow letters or invalid symbols (allow digits, spaces, +, -, (, ), .)
+  if (!/^\+?[\d\s\-().]+$/.test(trimmed)) {
+    return {
+      isValid: false,
+      normalized: '',
+      error: 'Enter a valid phone number using digits and standard formatting (e.g., +1 555-123-4567).',
+    };
+  }
+
+  const digits = trimmed.replace(/\D/g, '');
+  if (digits.length < 7 || digits.length > 15) {
+    return {
+      isValid: false,
+      normalized: '',
+      error: 'Phone number must contain between 7 and 15 digits.',
+    };
+  }
+
+  return {
+    isValid: true,
+    normalized: normalizePhoneNumber(trimmed),
+  };
+}
+
+/**
+ * Extracts a one-time passcode (OTP) from raw input or a full SMS message.
+ * Supports:
+ * 1. Origin-bound WebOTP SMS format (e.g., "@example.com #123456")
+ * 2. Full SMS body containing a 6-digit code (e.g., "Your verification code is 123456")
+ * 3. Spaced or hyphenated 6-digit code (e.g., "123-456" or "123 456")
+ * 4. Direct numeric input (up to 6 digits)
+ */
+export function extractOtpCode(raw: string, length = 6): string {
+  if (!raw) return '';
+
+  const trimmed = raw.trim();
+
+  // 1. Check for WebOTP origin-bound SMS format: @domain #123456
+  const originBoundMatch = trimmed.match(/#(\d{4,8})\b/);
+  if (originBoundMatch && originBoundMatch[1]) {
+    return originBoundMatch[1].slice(0, length);
+  }
+
+  // 2. Check for an explicit standalone 6-digit code inside a longer message
+  if (/[a-zA-Z]/.test(trimmed)) {
+    const exactMatch = trimmed.match(new RegExp(`\\b(\\d{${length}})\\b`));
+    if (exactMatch && exactMatch[1]) {
+      return exactMatch[1];
+    }
+
+    const groupedMatch = trimmed.match(/\b(\d{3})[-\s](\d{3})\b/);
+    if (groupedMatch) {
+      return `${groupedMatch[1]}${groupedMatch[2]}`.slice(0, length);
+    }
+  }
+
+  // 3. Fallback: strip non-digit characters and limit to target length
+  return trimmed.replace(/\D/g, '').slice(0, length);
+}
+
+/**
+ * Formats an SMS message compliant with the W3C WebOTP Origin-Bound One-Time Codes specification.
+ */
+export function formatWebOtpSms(code: string, domain = 'localhost'): string {
+  const cleanDomain = domain.replace(/^https?:\/\//, '').split(':')[0].split('/')[0] || 'localhost';
+  return `Your DevTools Times verification code is ${code}.\n\n@${cleanDomain} #${code}`;
+}
