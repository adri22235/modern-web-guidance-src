@@ -0,0 +1,51 @@
+import type { APIRoute } from 'astro';
+import { validatePhoneNumber, formatWebOtpSms } from '../../utils/phoneOtp';
+import { generateAndStoreOtp } from '../../utils/otpStore';
+
+export const POST: APIRoute = async ({ request, url }) => {
+  try {
+    const body = await request.json();
+    const rawPhone = String(body.phone || body.phoneNumber || '');
+    const validation = validatePhoneNumber(rawPhone);
+
+    if (!validation.isValid) {
+      return new Response(
+        JSON.stringify({
+          error: validation.error || 'Invalid phone number.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const entry = generateAndStoreOtp(validation.normalized);
+    const domain = url.hostname || 'localhost';
+    const smsMessage = formatWebOtpSms(entry.code, domain);
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        phone: validation.normalized,
+        message: `Verification code sent via SMS to ${validation.normalized}.`,
+        smsMessage,
+        expiresIn: 300,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Unable to process SMS verification request.',
+      }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
