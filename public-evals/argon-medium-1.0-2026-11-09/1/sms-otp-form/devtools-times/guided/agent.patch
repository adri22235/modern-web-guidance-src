diff --git a/src/utils/smsOtp.ts b/src/utils/smsOtp.ts
new file mode 100644
index 0000000..0f70a4a
--- /dev/null
+++ b/src/utils/smsOtp.ts
@@ -0,0 +1,98 @@
+export interface OtpRecord {
+  phone: string;
+  code: string;
+  expiresAt: number;
+  smsMessage: string;
+}
+
+const OTP_TTL_MS = 5 * 60 * 1000; // 5 minutes
+const otpMemoryStore = new Map<string, OtpRecord>();
+
+/**
+ * Extracts only the bare host domain (hostname) without scheme, port, or path,
+ * as required by the origin-bound SMS specification (`@<domain> #<otp>`).
+ */
+export function extractHostDomain(originOrHost: string): string {
+  const trimmed = originOrHost.trim();
+  if (!trimmed) {
+    return 'localhost';
+  }
+  try {
+    if (trimmed.includes('://')) {
+      return new URL(trimmed).hostname;
+    }
+    return new URL(`https://${trimmed}`).hostname;
+  } catch {
+    return trimmed
+      .replace(/^https?:\/\//i, '')
+      .split('/')[0]
+      .split(':')[0]
+      .replace(/\s+/g, '');
+  }
+}
+
+/**
+ * Formats an origin-bound SMS message for WebOTP API and `autocomplete="one-time-code"`.
+ *
+ * Rules enforced:
+ * 1. Human-readable sentence containing the code comes first.
+ * 2. `@<domain> #<otp>` is placed on the very last line with no trailing text.
+ * 3. Only the host domain is used (no scheme, port, or path).
+ * 4. Single space between `@<domain>` and `#<otp>` (and optional `@<iframeDomain>`).
+ */
+export function formatOriginBoundSms(
+  domainOrUrl: string,
+  code: string,
+  iframeDomain?: string
+): string {
+  const hostDomain = extractHostDomain(domainOrUrl);
+  const cleanCode = code.replace(/\s+/g, '');
+  const lastLine = iframeDomain
+    ? `@${hostDomain} #${cleanCode} @${extractHostDomain(iframeDomain)}`
+    : `@${hostDomain} #${cleanCode}`;
+
+  return `Your verification code is ${cleanCode}.\n\n${lastLine}`;
+}
+
+/**
+ * Generates a cryptographically random 6-digit numeric OTP code (preserving leading zeros).
+ */
+export function generateSixDigitOtp(): string {
+  const array = new Uint32Array(1);
+  crypto.getRandomValues(array);
+  const code = (array[0] % 1000000).toString().padStart(6, '0');
+  return code;
+}
+
+export function normalizePhoneNumber(phone: string): string {
+  return phone.replace(/[^\d+]/g, '').trim();
+}
+
+export function saveOtpRecord(phone: string, record: OtpRecord): void {
+  const key = normalizePhoneNumber(phone);
+  otpMemoryStore.set(key, record);
+}
+
+export function getOtpRecord(phone: string): OtpRecord | undefined {
+  const key = normalizePhoneNumber(phone);
+  return otpMemoryStore.get(key);
+}
+
+export function deleteOtpRecord(phone: string): void {
+  const key = normalizePhoneNumber(phone);
+  otpMemoryStore.delete(key);
+}
+
+export function createOtpForPhone(phone: string, domainOrUrl: string): OtpRecord {
+  const normalizedPhone = normalizePhoneNumber(phone);
+  const code = generateSixDigitOtp();
+  const smsMessage = formatOriginBoundSms(domainOrUrl, code);
+  const record: OtpRecord = {
+    phone: normalizedPhone,
+    code,
+    expiresAt: Date.now() + OTP_TTL_MS,
+    smsMessage,
+  };
+  saveOtpRecord(normalizedPhone, record);
+  return record;
+}
