+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,60 @@
+import type { APIRoute } from 'astro';
+import { createOtpForPhone, normalizePhoneNumber } from '../../utils/smsOtp';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    let phone = '';
+    const contentType = request.headers.get('content-type') || '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = typeof body.phone === 'string' ? body.phone : '';
+    } else {
+      const formData = await request.formData();
+      const rawPhone = formData.get('phone');
+      phone = typeof rawPhone === 'string' ? rawPhone : '';
+    }
+
+    const normalizedPhone = normalizePhoneNumber(phone);
+    if (!normalizedPhone || normalizedPhone.replace(/\D/g, '').length < 7) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter a valid phone number (at least 7 digits).',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const hostHeader = request.headers.get('x-forwarded-host') || request.headers.get('host') || url.hostname;
+    const record = createOtpForPhone(normalizedPhone, hostHeader);
+
+    if (session) {
+      await session.set('pendingSmsOtp', record);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        phone: normalizedPhone,
+        smsMessage: record.smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Unable to send verification SMS. Please try again.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
diff --git a/src/pages/api/verify-otp.ts b/src/pages/api/verify-otp.ts
new file mode 100644
index 0000000..b0f34b3
--- /dev/null
+++ b/src/pages/api/verify-otp.ts
@@ -0,0 +1,116 @@
+import type { APIRoute } from 'astro';
+import {
+  deleteOtpRecord,
+  getOtpRecord,
+  normalizePhoneNumber,
+  type OtpRecord,
+} from '../../utils/smsOtp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let phone = '';
+    let otp = '';
+    const contentType = request.headers.get('content-type') || '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = typeof body.phone === 'string' ? body.phone : '';
+      otp = typeof body.otp === 'string' ? body.otp.trim() : '';
+    } else {
+      const formData = await request.formData();
+      const rawPhone = formData.get('phone');
+      const rawOtp = formData.get('otp');
+      phone = typeof rawPhone === 'string' ? rawPhone : '';
+      otp = typeof rawOtp === 'string' ? rawOtp.trim() : '';
+    }
+
+    if (!/^\d{6}$/.test(otp)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Please enter the 6-digit numeric verification code sent to your phone.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const normalizedPhone = normalizePhoneNumber(phone);
+    const sessionRecord = (await session?.get('pendingSmsOtp')) as OtpRecord | undefined;
+    const memoryRecord = normalizedPhone ? getOtpRecord(normalizedPhone) : undefined;
+    const record =
+      sessionRecord && (!normalizedPhone || sessionRecord.phone === normalizedPhone)
+        ? sessionRecord
+        : memoryRecord;
+
+    if (!record) {
+      return new Response(
+        JSON.stringify({
+          error: 'No active verification code found. Please request a new code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (Date.now() > record.expiresAt) {
+      deleteOtpRecord(record.phone);
+      if (session) {
+        await session.set('pendingSmsOtp', undefined);
+      }
+      return new Response(
+        JSON.stringify({
+          error: 'Your verification code has expired. Please request a new code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (record.code !== otp) {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid verification code. Please check the 6-digit code in your SMS and try again.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Consume OTP after successful verification
+    deleteOtpRecord(record.phone);
+    if (session) {
+      await session.set('pendingSmsOtp', undefined);
+      await session.set('verifiedPhone', record.phone);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        phone: record.phone,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'Unable to verify code at this time. Please try again.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
