+  <script>
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const otpStatus = document.getElementById('otp-status');
+    const verifyOtpBtn = document.getElementById('verify-otp-btn');
+    const resendOtpBtn = document.getElementById('resend-otp-btn');
+    const smsFormatPreview = document.getElementById('sms-format-preview');
+
+    let otpAbortController = null;
+
+    function formatOriginBoundSms(code, rawHostname) {
+      const host = (rawHostname || window.location.hostname || 'dailygrind.example')
+        .replace(/^https?:\/\//i, '')
+        .split('/')[0]
+        .split(':')[0]
+        .trim() || 'dailygrind.example';
+      const cleanCode = String(code).trim();
+      return `Your Daily Grind verification code is ${cleanCode}.\n\n@${host} #${cleanCode}`;
+    }
+
+    if (smsFormatPreview) {
+      smsFormatPreview.textContent = formatOriginBoundSms('123456');
+    }
+
+    function showOtpError(message) {
+      if (!otpInput || !otpError) return;
+      otpInput.setAttribute('aria-invalid', 'true');
+      otpError.textContent = message;
+      otpError.hidden = false;
+    }
+
+    function clearOtpError() {
+      if (!otpInput || !otpError) return;
+      otpInput.setCustomValidity('');
+      otpInput.removeAttribute('aria-invalid');
+      otpError.textContent = '';
+      otpError.hidden = true;
+    }
+
+    function showOtpStatus(message, type = 'info') {
+      if (!otpStatus) return;
+      otpStatus.textContent = message;
+      otpStatus.className = `otp-status status-${type}`;
+      otpStatus.hidden = false;
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+        clearOtpError();
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    if (otpInput) {
+      // Clear errors on input while typing
+      otpInput.addEventListener('input', () => {
+        clearOtpError();
+      });
+
+      // Validate on blur if the user has edited the field
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value.length > 0 && !otpInput.checkValidity()) {
+          const msg = 'Please enter the 6-digit numeric verification code sent via SMS.';
+          otpInput.setCustomValidity(msg);
+          showOtpError(msg);
+        }
+      });
+
+      otpInput.addEventListener('invalid', () => {
+        const msg = 'Please enter the 6-digit numeric verification code sent via SMS.';
+        otpInput.setCustomValidity(msg);
+        showOtpError(msg);
+      });
+    }
+
+    if (otpForm) {
+      otpForm.addEventListener('submit', async (event) => {
+        // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+        stopSmsOtpListener();
+
+        event.preventDefault();
+
+        if (otpInput) {
+          otpInput.setCustomValidity('');
+          if (!otpInput.checkValidity()) {
+            const msg = 'Please enter the 6-digit numeric verification code sent via SMS.';
+            otpInput.setCustomValidity(msg);
+            showOtpError(msg);
+            otpInput.focus();
+            return;
+          }
+        }
+
+        clearOtpError();
+        if (verifyOtpBtn) {
+          verifyOtpBtn.disabled = true;
+        }
+
+        const formData = new FormData(otpForm);
+        const purpose = formData.get('purpose') === 'order' ? 'online order' : 'Daily Grind Rewards';
+
+        try {
+          await fetch(otpForm.action, {
+            method: 'POST',
+            body: formData,
+          }).catch(() => null);
+
+          showOtpStatus(`Code verified! You are now signed in for your ${purpose}.`, 'success');
+        } finally {
+          if (verifyOtpBtn) {
+            verifyOtpBtn.disabled = false;
+          }
+        }
+      });
+    }
+
+    if (resendOtpBtn) {
+      resendOtpBtn.addEventListener('click', () => {
+        clearOtpError();
+        if (otpInput) {
+          otpInput.value = '';
+          otpInput.focus();
+        }
+        showOtpStatus('A new 6-digit verification code has been sent via SMS.', 'info');
+        startSmsOtpListener();
+      });
+    }
+
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
 </body>
 
