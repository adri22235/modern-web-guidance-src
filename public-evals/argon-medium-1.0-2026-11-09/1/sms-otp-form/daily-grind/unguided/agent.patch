+  <script>
+    (function () {
+      function initOTP() {
+        const otpInput = document.querySelector('input[autocomplete="one-time-code"]');
+        if (!otpInput) return;
+
+        const form = otpInput.closest('form');
+        const statusEl = document.getElementById('otp-status');
+        const resendBtn = document.getElementById('resend-otp');
+
+        function showStatus(message, type) {
+          if (!statusEl) return;
+          statusEl.textContent = message;
+          statusEl.className = 'otp-status visible ' + (type || 'info');
+        }
+
+        let ac = new AbortController();
+
+        if (form) {
+          form.addEventListener('submit', function (e) {
+            e.preventDefault();
+            if (ac) {
+              ac.abort();
+            }
+            const code = otpInput.value.trim();
+            if (/^\d{6}$/.test(code)) {
+              showStatus('Passcode verified! Signing you into Daily Grind Rewards...', 'success');
+            } else {
+              showStatus('Please enter a valid 6-digit numeric passcode.', 'error');
+              otpInput.focus();
+            }
+          });
+        }
+
+        if (resendBtn) {
+          resendBtn.addEventListener('click', function () {
+            showStatus('A new 6-digit verification code has been sent via SMS.', 'info');
+            otpInput.focus();
+          });
+        }
+
+        if ('OTPCredential' in window && navigator.credentials && navigator.credentials.get) {
+          navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal
+          }).then(function (otp) {
+            if (otp && otp.code) {
+              otpInput.value = otp.code;
+              if (form) {
+                if (typeof form.requestSubmit === 'function') {
+                  form.requestSubmit();
+                } else {
+                  form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
+                }
+              }
+            }
+          }).catch(function () {
+            // Ignore abort or credential errors; user can enter code manually
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initOTP);
+      } else {
+        initOTP();
+      }
+    })();
+  </script>
