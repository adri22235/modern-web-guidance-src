+++ b/styles.css
@@ -0,0 +1,249 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --card-bg: #ffffff;
+}
+
+:root[data-theme="dark"] {
+  --primary: #3e2723;
+  --secondary: #4e342e;
+  --accent: #ffd180;
+  --text: #f5f5f5;
+  --light: #1e1411;
+  --card-bg: #2d1e1a;
+}
+
+@view-transition {
+  navigation: auto;
+}
+
+@keyframes vt-fade-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+
+@keyframes vt-fade-out {
+  from {
+    opacity: 1;
+  }
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes vt-slide-up-in {
+  from {
+    opacity: 0;
+    transform: translateY(18px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes vt-slide-up-out {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(-18px);
+  }
+}
+
+::view-transition-old(root) {
+  animation: 220ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 280ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
+}
+
+::view-transition-old(main-content) {
+  animation: 200ms cubic-bezier(0.4, 0, 1, 1) both vt-slide-up-out;
+}
+
+::view-transition-new(main-content) {
+  animation: 320ms cubic-bezier(0, 0, 0.2, 1) 40ms both vt-slide-up-in;
+}
+
+::view-transition-old(hero-banner),
+::view-transition-new(hero-banner) {
+  animation-duration: 300ms;
+  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation-duration: 0.01ms !important;
+  }
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav,
+.site-header {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  view-transition-name: site-header;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+  view-transition-name: site-logo;
+}
+
+.logo a {
+  color: inherit;
+  text-decoration: none;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  align-items: center;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover,
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+  view-transition-name: hero-banner;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+  view-transition-name: hero-title;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+  view-transition-name: main-content;
+}
+
+#seasonal-favorites {
+  view-transition-name: seasonal-favorites;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: var(--card-bg);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
diff --git a/theme.js b/theme.js
new file mode 100644
index 0000000..9a39981
--- /dev/null
+++ b/theme.js
@@ -0,0 +1,41 @@
+(function () {
+  try {
+    var storedTheme = localStorage.getItem('daily-grind-theme');
+    var theme = storedTheme || 'light';
+    document.documentElement.setAttribute('data-theme', theme);
+    document.documentElement.setAttribute('data-layout-ready', 'true');
+  } catch (e) {
+    document.documentElement.setAttribute('data-theme', 'light');
+    document.documentElement.setAttribute('data-layout-ready', 'true');
+  }
+
+  window.addEventListener('pageswap', function (event) {
+    if (event.viewTransition) {
+      var targetUrl = event.activation && event.activation.entry && event.activation.entry.url;
+      if (targetUrl) {
+        try {
+          var url = new URL(targetUrl);
+          if (event.viewTransition.types) {
+            event.viewTransition.types.add('navigate');
+            if (url.pathname === '/' || url.pathname === '/index.html') {
+              event.viewTransition.types.add('to-home');
+            } else {
+              event.viewTransition.types.add('to-' + url.pathname.replace(/^\/+|\/+$/g, '').replace(/\//g, '-'));
+            }
+          }
+        } catch (err) {
+          // Ignore URL parse errors
+        }
+      }
+    }
+  });
+
+  window.addEventListener('pagereveal', function (event) {
+    if (event.viewTransition) {
+      var fromEntry = navigation && navigation.activation && navigation.activation.from;
+      if (fromEntry && fromEntry.url && event.viewTransition.types) {
+        event.viewTransition.types.add('navigate');
+      }
+    }
+  });
+})();
