+    <script is:inline blocking="render">
+      (() => {
+        const getRouteInfo = (urlString) => {
+          if (!urlString) return { type: 'other', depth: 1 };
+          const url = new URL(urlString, window.location.origin);
+          const path = url.pathname.replace(/\/+$/, '');
+          const articleMatch = path.match(/\/articles\/([^/]+)$/);
+          if (articleMatch) {
+            return { type: 'article', slug: decodeURIComponent(articleMatch[1]), depth: 2 };
+          }
+          const categoryMatch = path.match(/\/category\/([^/]+)$/);
+          if (categoryMatch) {
+            return { type: 'category', category: decodeURIComponent(categoryMatch[1]).toLowerCase(), depth: 1 };
+          }
+          if (path === '' || path.endsWith('/devtools-times')) {
+            return { type: 'home', depth: 0 };
+          }
+          return { type: 'other', depth: 1 };
+        };
+
+        const applyTransitionNames = (fromInfo, toInfo, currentInfo) => {
+          const cleanup = [];
+          const setName = (el, name) => {
+            if (!el) return;
+            el.style.viewTransitionName = name;
+            cleanup.push(el);
+          };
+
+          const articleSlug =
+            fromInfo.type === 'article' ? fromInfo.slug :
+            toInfo.type === 'article' ? toInfo.slug : null;
+
+          if (articleSlug) {
+            if (currentInfo.type === 'article') {
+              setName(document.querySelector('#article-title'), 'article-title');
+              setName(document.querySelector('#article-image'), 'article-image');
+            } else {
+              const card = document.querySelector(`[data-article-slug="${CSS.escape(articleSlug)}"]`);
+              if (card) {
+                setName(card.querySelector('[data-vt-title]'), 'article-title');
+                setName(card.querySelector('[data-vt-image]'), 'article-image');
+              }
+            }
+          }
+
+          return () => {
+            for (const el of cleanup) {
+              el.style.viewTransitionName = '';
+            }
+          };
+        };
+
+        const setDirectionType = (viewTransition, fromInfo, toInfo) => {
+          if (!viewTransition?.types) return;
+          if (toInfo.depth > fromInfo.depth) {
+            viewTransition.types.add('forward');
+          } else if (toInfo.depth < fromInfo.depth) {
+            viewTransition.types.add('back');
+          }
+        };
+
+        window.addEventListener('pageswap', async (event) => {
+          if (!event.viewTransition) return;
+          const fromUrl = event.activation?.from?.url || window.location.href;
+          const toUrl = event.activation?.entry?.url;
+          if (!toUrl) return;
+
+          const fromInfo = getRouteInfo(fromUrl);
+          const toInfo = getRouteInfo(toUrl);
+          setDirectionType(event.viewTransition, fromInfo, toInfo);
+          const resetNames = applyTransitionNames(fromInfo, toInfo, fromInfo);
+
+          try {
+            await event.viewTransition.ready;
+          } catch (error) {
+            if (error.name !== 'InvalidStateError') {
+              throw error;
+            }
+          } finally {
+            await event.viewTransition.finished;
+            resetNames();
+          }
+        });
+
+        window.addEventListener('pagereveal', async (event) => {
+          if (!event.viewTransition) return;
+          const activation = window.navigation?.activation;
+          const fromUrl = activation?.from?.url;
+          const toUrl = activation?.entry?.url || window.location.href;
+          if (!fromUrl) return;
+
+          const fromInfo = getRouteInfo(fromUrl);
+          const toInfo = getRouteInfo(toUrl);
+          setDirectionType(event.viewTransition, fromInfo, toInfo);
+          const resetNames = applyTransitionNames(fromInfo, toInfo, toInfo);
+
+          try {
+            await event.viewTransition.ready;
+          } catch (error) {
+            if (error.name !== 'InvalidStateError') {
+              throw error;
+            }
+          } finally {
+            await event.viewTransition.finished;
+            resetNames();
+          }
+        });
+      })();
+    </script>
