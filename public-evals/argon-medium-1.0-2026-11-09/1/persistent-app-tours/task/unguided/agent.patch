+  <script>
+    (function () {
+      const featureLink = document.getElementById('feature');
+      const tourStep = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('tour-close-btn');
+
+      function isTourOpen() {
+        if (!tourStep || tourStep.hasAttribute('hidden')) return false;
+        if (typeof tourStep.matches === 'function') {
+          try {
+            if (typeof tourStep.showPopover === 'function') {
+              return tourStep.matches(':popover-open');
+            }
+          } catch (e) {}
+        }
+        return getComputedStyle(tourStep).display !== 'none';
+      }
+
+      if (tourStep && typeof tourStep.showPopover === 'function') {
+        try {
+          tourStep.showPopover();
+        } catch (e) {}
+      } else if (tourStep) {
+        tourStep.style.display = 'block';
+      }
+
+      if (closeBtn && tourStep) {
+        closeBtn.addEventListener('click', () => {
+          if (typeof tourStep.hidePopover === 'function') {
+            try {
+              if (tourStep.matches(':popover-open')) {
+                tourStep.hidePopover();
+              }
+            } catch (e) {}
+          } else {
+            tourStep.setAttribute('hidden', '');
+            tourStep.style.display = 'none';
+          }
+        });
+      }
+
+      if (featureLink) {
+        featureLink.addEventListener('click', (event) => {
+          if (isTourOpen()) {
+            event.preventDefault();
+          }
+        });
+      }
+
+      // Fallback positioning for browsers without CSS Anchor Positioning support
+      const supportsAnchor =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('anchor-name', '--rewards-feature') &&
+        CSS.supports('top', 'anchor(bottom)');
+
+      if (!supportsAnchor && featureLink && tourStep) {
+        function updatePosition() {
+          if (!isTourOpen()) return;
+          const rect = featureLink.getBoundingClientRect();
+          tourStep.style.top = `${rect.bottom + 12}px`;
+          tourStep.style.left = `${rect.left + rect.width / 2}px`;
+        }
+        updatePosition();
+        window.addEventListener('resize', updatePosition, { passive: true });
+        window.addEventListener('scroll', updatePosition, { passive: true });
+        if (typeof ResizeObserver !== 'undefined') {
+          const ro = new ResizeObserver(updatePosition);
+          ro.observe(document.body);
+          ro.observe(featureLink);
+        }
+      }
+    })();
+  </script>
+
