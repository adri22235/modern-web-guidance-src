diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,89 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        category: "Seasonal Favorites",
+        price: "$5.50",
+        calories: 220,
+        ingredients: ["Espresso", "Steamed oat milk", "Vermont maple syrup"],
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        category: "Seasonal Favorites",
+        price: "$3.25",
+        calories: 15,
+        ingredients: ["Dark roast Arabica beans", "Filtered water"],
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        category: "Seasonal Favorites",
+        price: "$4.75",
+        calories: 5,
+        ingredients: ["Coarse-ground coffee beans", "Cold filtered water"],
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+
+      window.addEventListener("pagehide", () => controller.abort());
+      window.addEventListener("unload", () => controller.abort());
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Looks up details for a coffee shop menu item. Use when the user asks about a drink's description, ingredients, nutrition, price, or page link.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              name: {
+                type: "string",
+                description: "Name of the menu item to look up.",
+              },
+            },
+            required: ["name"],
+          },
+          execute(input) {
+            const rawName = input?.name ?? input?.itemName;
+            if (typeof rawName !== "string" || !rawName.trim()) {
+              return {
+                error: "Provide a non-empty menu item name.",
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            const normalizedQuery = rawName.trim().toLowerCase();
+            const item = menuItems.find(
+              (entry) => entry.name.toLowerCase() === normalizedQuery
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${rawName}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            return item;
+          },
+          annotations: { readOnlyHint: true },
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
+
 </body>
 
 </html>
