diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,187 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const TOOL_NAME = 'get_menu_item_details';
+      const controller = new AbortController();
+
+      const menuCatalog = [
+        {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          category: 'Seasonal Favorites',
+          price: '$5.50',
+          calories: 210,
+          dietary: ['Vegan', 'Dairy-Free'],
+          ingredients: ['Espresso', 'Oat milk', 'Vermont maple syrup'],
+          url: '/menu/seasonal'
+        },
+        {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          category: 'Espresso',
+          price: '$3.25',
+          calories: 5,
+          dietary: ['Vegan', 'Dairy-Free', 'Gluten-Free', 'Sugar-Free'],
+          ingredients: ['Dark roast Arabica espresso beans', 'Filtered water'],
+          url: '/menu/espresso'
+        },
+        {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          category: 'Cold Brew',
+          price: '$4.75',
+          calories: 10,
+          dietary: ['Vegan', 'Dairy-Free', 'Gluten-Free', 'Sugar-Free'],
+          ingredients: ['Coarse-ground artisanal coffee blend', 'Cold filtered water'],
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      function getMenuItems() {
+        const itemsByName = new Map(
+          menuCatalog.map((item) => [item.name.toLowerCase(), { ...item }])
+        );
+
+        const cards = document.querySelectorAll('.card');
+        cards.forEach((card) => {
+          const titleEl = card.querySelector('h3');
+          const descEl = card.querySelector('p');
+          const linkEl = card.querySelector('a');
+          if (!titleEl) return;
+
+          const name = titleEl.textContent.trim();
+          const key = name.toLowerCase();
+          const description = descEl ? descEl.textContent.trim() : '';
+          const url = linkEl ? linkEl.getAttribute('href') : '';
+
+          if (itemsByName.has(key)) {
+            const existing = itemsByName.get(key);
+            if (description) existing.description = description;
+            if (url) existing.url = url;
+          } else {
+            itemsByName.set(key, {
+              name,
+              description,
+              url
+            });
+          }
+        });
+
+        return Array.from(itemsByName.values());
+      }
+
+      function findMenuItemByName(query) {
+        if (!query || typeof query !== 'string') return null;
+        const normalizedQuery = query.trim().toLowerCase();
+        if (!normalizedQuery) return null;
+
+        const items = getMenuItems();
+        return (
+          items.find((item) => item.name.toLowerCase() === normalizedQuery) ||
+          items.find(
+            (item) =>
+              item.name.toLowerCase().includes(normalizedQuery) ||
+              normalizedQuery.includes(item.name.toLowerCase())
+          ) ||
+          null
+        );
+      }
+
+      const menuLookupTool = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item at The Daily Grind (such as the Maple Oat Latte, Dark Roast Espresso, or Cold Brew) by its name.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up (e.g., "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew").'
+            }
+          },
+          required: ['name']
+        },
+        execute: async (input) => {
+          const itemName =
+            typeof input === 'string'
+              ? input
+              : input?.name ?? input?.itemName ?? input?.item_name ?? input?.item ?? input?.query ?? '';
+
+          const item = findMenuItemByName(String(itemName));
+
+          if (!item) {
+            const availableItems = getMenuItems().map((entry) => entry.name);
+            return {
+              found: false,
+              error: `Menu item "${itemName}" was not found.`,
+              availableItems,
+              content: [
+                {
+                  type: 'text',
+                  text: `Menu item "${itemName}" was not found. Available menu items: ${availableItems.join(', ')}.`
+                }
+              ]
+            };
+          }
+
+          return {
+            found: true,
+            ...item,
+            item,
+            content: [
+              {
+                type: 'text',
+                text: `${item.name}: ${item.description} (Price: ${item.price || 'N/A'}, Category: ${item.category || 'Menu'}, Details URL: ${item.url || 'N/A'})`
+              }
+            ]
+          };
+        }
+      };
+
+      let registrationHandle = null;
+
+      function registerMenuTool() {
+        if (
+          typeof navigator !== 'undefined' &&
+          navigator.modelContext &&
+          typeof navigator.modelContext.registerTool === 'function'
+        ) {
+          registrationHandle = navigator.modelContext.registerTool(menuLookupTool, {
+            signal: controller.signal
+          });
+        }
+      }
+
+      function cleanupMenuTool() {
+        controller.abort();
+        if (registrationHandle && typeof registrationHandle.unregister === 'function') {
+          try {
+            registrationHandle.unregister();
+          } catch (_) {}
+        }
+        if (
+          typeof navigator !== 'undefined' &&
+          navigator.modelContext &&
+          typeof navigator.modelContext.unregisterTool === 'function'
+        ) {
+          try {
+            navigator.modelContext.unregisterTool(TOOL_NAME);
+          } catch (_) {}
+        }
+      }
+
+      registerMenuTool();
+
+      window.addEventListener('pagehide', cleanupMenuTool);
+      window.addEventListener('beforeunload', cleanupMenuTool);
+      window.addEventListener('unload', cleanupMenuTool);
+    })();
+  </script>
+
 </body>
 
 </html>
