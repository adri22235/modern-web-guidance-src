+  <script>
+    (function () {
+      const form = document.getElementById('payment-form');
+      const submitBtn = document.getElementById('payment-submit-btn');
+      const statusEl = document.getElementById('payment-status');
+
+      const customMessages = {
+        'cc-number': 'Please enter a valid 13 to 19 digit card number (spaces allowed).',
+        'cc-name': 'Please enter the full name as it appears on your card.',
+        'cc-exp': 'Please enter a valid expiry date in MM/YY format (e.g., 08/28).',
+        'cc-csc': 'Please enter the 3 or 4 digit security code from your card.'
+      };
+
+      const inputs = Array.from(form.querySelectorAll('input'));
+      const touched = new Set();
+
+      function showFieldError(input) {
+        const errorEl = document.getElementById(input.id + '-error');
+        if (!input.validity.valid) {
+          const msg = customMessages[input.id] || input.validationMessage;
+          input.setCustomValidity(msg);
+          input.setAttribute('aria-invalid', 'true');
+          if (errorEl) errorEl.textContent = msg;
+          return false;
+        }
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+        if (errorEl) errorEl.textContent = '';
+        return true;
+      }
+
+      inputs.forEach((input) => {
+        input.addEventListener('input', () => {
+          touched.add(input.id);
+          input.setCustomValidity('');
+          if (input.validity.valid) {
+            input.removeAttribute('aria-invalid');
+            const errorEl = document.getElementById(input.id + '-error');
+            if (errorEl) errorEl.textContent = '';
+          }
+        });
+
+        input.addEventListener('blur', () => {
+          if (touched.has(input.id) && input.value.trim() !== '') {
+            input.setCustomValidity('');
+            showFieldError(input);
+          }
+        });
+
+        input.addEventListener('invalid', () => {
+          if (!input.validity.customError) {
+            input.setCustomValidity(customMessages[input.id] || 'Please enter a valid value.');
+          }
+          input.setAttribute('aria-invalid', 'true');
+          const errorEl = document.getElementById(input.id + '-error');
+          if (errorEl) errorEl.textContent = input.validationMessage;
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        statusEl.textContent = '';
+
+        let firstInvalid = null;
+        inputs.forEach((input) => {
+          input.setCustomValidity('');
+          const isValid = showFieldError(input);
+          if (!isValid && !firstInvalid) {
+            firstInvalid = input;
+          }
+        });
+
+        if (firstInvalid) {
+          firstInvalid.focus();
+          return;
+        }
+
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Processing Payment...';
+        statusEl.textContent = 'Payment submitted successfully. Thank you for your order!';
+      });
+    })();
+  </script>
