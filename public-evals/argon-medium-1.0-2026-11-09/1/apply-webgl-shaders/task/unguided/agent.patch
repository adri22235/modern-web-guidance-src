+      gl.enable(gl.BLEND);
+      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+
+      function renderFrame() {
+        const now = getNowSeconds();
+
+        // Spawn gentle ambient ripples across the target elements so effect stays lively
+        if (now - lastAmbientRipple > 1.35) {
+          const heroRect = hero.getBoundingClientRect();
+          if (heroRect.width > 0 && heroRect.height > 0) {
+            const target = targetElements[rippleCursor % targetElements.length];
+            const r = target.getBoundingClientRect();
+            const jitterX = (Math.sin(now * 3.7) * 0.35) * (r.width / heroRect.width);
+            const jitterY = (Math.cos(now * 2.9) * 0.25) * (r.height / heroRect.height);
+            const cx = ((r.left - heroRect.left) + r.width * 0.5) / heroRect.width + jitterX;
+            const cy = ((r.top - heroRect.top) + r.height * 0.5) / heroRect.height + jitterY;
+            addRipple(cx, cy, 0.78);
+          }
+          lastAmbientRipple = now;
+        }
+
+        mouseState.x += (mouseState.targetX - mouseState.x) * 0.12;
+        mouseState.y += (mouseState.targetY - mouseState.y) * 0.12;
+        mouseState.strength += (mouseState.targetStrength - mouseState.strength) * 0.08;
+
+        gl.clearColor(0.0, 0.0, 0.0, 0.0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+
+        gl.useProgram(program);
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.uniform1i(uTexture, 0);
+        gl.uniform1f(uTime, now);
+        gl.uniform2f(uResolution, canvas.width, canvas.height);
+        gl.uniform2f(uMouse, mouseState.x, mouseState.y);
+        gl.uniform1f(uMouseStrength, mouseState.strength);
+        gl.uniform4fv(uRipples, ripples);
+
+        gl.drawArrays(gl.TRIANGLES, 0, vertexCount);
+
+        requestAnimationFrame(renderFrame);
+      }
+
+      requestAnimationFrame(renderFrame);
+    })();
+  </script>
