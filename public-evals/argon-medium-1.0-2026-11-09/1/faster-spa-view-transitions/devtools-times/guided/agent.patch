+    <script>
+        function switchToView(viewId: string, moveFocus = true) {
+            const activeView = document.getElementById(viewId);
+            if (!activeView) return;
+
+            // Hide all views while preserving their rendered DOM state in memory
+            document.querySelectorAll('.spa-view').forEach((view) => {
+                view.classList.add('inactive');
+                view.setAttribute('aria-hidden', 'true');
+                view.setAttribute('inert', 'inert');
+            });
+
+            // Show the target view
+            activeView.classList.remove('inactive');
+            activeView.setAttribute('aria-hidden', 'false');
+            activeView.removeAttribute('inert');
+
+            // Update navigation tabs state
+            document.querySelectorAll('[data-view-target]').forEach((btn) => {
+                const isSelected = btn.getAttribute('data-view-target') === viewId;
+                btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+                btn.classList.toggle('bg-gray-900', isSelected);
+                btn.classList.toggle('text-white', isSelected);
+                btn.classList.toggle('text-gray-700', !isSelected);
+                btn.classList.toggle('hover:bg-gray-100', !isSelected);
+            });
+
+            // MANDATORY: Move focus to the new view to ensure a logical tab-order
+            if (moveFocus) {
+                activeView.focus();
+            }
+        }
+
+        function initSpaNavigation() {
+            (window as any).switchToView = switchToView;
+
+            document.querySelectorAll('[data-view-target]').forEach((btn) => {
+                btn.addEventListener('click', (event) => {
+                    event.preventDefault();
+                    const targetView = btn.getAttribute('data-view-target');
+                    if (targetView) {
+                        history.replaceState(null, '', `#${targetView}`);
+                        switchToView(targetView, true);
+                    }
+                });
+            });
+
+            // Handle initial hash if present
+            const initialHash = window.location.hash.replace(/^#/, '');
+            if (initialHash && document.getElementById(initialHash)?.classList.contains('spa-view')) {
+                switchToView(initialHash, false);
+            }
+        }
+
+        initSpaNavigation();
+        document.addEventListener('astro:page-load', initSpaNavigation);
+    </script>
 </Layout>
