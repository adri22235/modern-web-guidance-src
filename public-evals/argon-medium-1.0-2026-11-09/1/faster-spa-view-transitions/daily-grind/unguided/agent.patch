+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const nameInput = section.querySelector('#account-name');
+          const milkSelect = section.querySelector('#account-milk');
+          feedback.textContent = 'Preferences saved for ' + (nameInput.value || 'Member') + ' (' + milkSelect.value + ')!';
+        });
+
+        section.addEventListener('click', (e) => {
+          const reloadBtn = e.target.closest('.wallet-reload-btn');
+          if (reloadBtn) {
+            const amount = parseFloat(reloadBtn.dataset.amount || '0');
+            walletBalance += amount;
+            walletBalanceEl.textContent = '$' + walletBalance.toFixed(2);
+            reloadBtn.classList.add('active');
+            return;
+          }
+
+          const reorderBtn = e.target.closest('.reorder-btn');
+          if (reorderBtn) {
+            const items = parseInt(reorderBtn.dataset.items || '1', 10);
+            const total = parseFloat(reorderBtn.dataset.total || '0');
+            cartState.count += items;
+            cartState.total += total;
+            syncCartDisplay();
+            reorderBtn.textContent = 'Added to Bag ✓';
+          }
+        });
+      }
+
+      const VIEW_INITIALIZERS = {
+        menu: initMenuView,
+        locations: initLocationsView,
+        rewards: initRewardsView,
+        account: initAccountView
+      };
+
+      function getOrCreateView(viewName) {
+        if (viewCache.has(viewName)) {
+          return viewCache.get(viewName);
+        }
+
+        const template = document.getElementById('tmpl-view-' + viewName);
+        if (!template) {
+          return homeView;
+        }
+
+        const fragment = template.content.cloneNode(true);
+        const section = fragment.querySelector('.spa-view');
+        spaContainer.appendChild(section);
+
+        if (VIEW_INITIALIZERS[viewName]) {
+          VIEW_INITIALIZERS[viewName](section);
+        }
+
+        viewCache.set(viewName, section);
+        return section;
+      }
+
+      function resolveViewFromPath(pathOrUrl) {
+        if (!pathOrUrl) return 'home';
+        const clean = String(pathOrUrl)
+          .replace(/^https?:\/\/[^/]+/i, '')
+          .replace(/^[#?/]+/, '')
+          .split(/[/?#]/)[0]
+          .toLowerCase();
+
+        if (!clean || clean === 'index.html' || clean === 'home') {
+          return 'home';
+        }
+        if (clean === 'order-online') {
+          return 'menu';
+        }
+        if (VALID_VIEWS.has(clean)) {
+          return clean;
+        }
+        return null;
+      }
+
+      function updateNavState(activeView) {
+        const navLinks = document.querySelectorAll('nav ul a[data-nav]');
+        navLinks.forEach((link) => {
+          const isMatch = link.dataset.nav === activeView;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function switchView(targetViewName, options = {}) {
+        const normalizedView = VALID_VIEWS.has(targetViewName) ? targetViewName : 'home';
+        const targetEl = getOrCreateView(normalizedView);
+
+        // Toggle hero visibility without removing it from the DOM
+        const isHome = normalizedView === 'home';
+        homeHero.hidden = !isHome;
+        homeHero.classList.toggle('offscreen', !isHome);
+        homeHero.setAttribute('aria-hidden', isHome ? 'false' : 'true');
+
+        // Keep all previously visited views mounted in the DOM and preserve their state
+        viewCache.forEach((viewEl, viewName) => {
+          const isActive = viewName === normalizedView;
+          viewEl.hidden = !isActive;
+          viewEl.classList.toggle('active', isActive);
+          viewEl.classList.toggle('view-active', isActive);
+          viewEl.classList.toggle('offscreen', !isActive);
+          viewEl.classList.toggle('view-hidden', !isActive);
+          viewEl.dataset.state = isActive ? 'active' : 'offscreen';
+          viewEl.setAttribute('aria-hidden', isActive ? 'false' : 'true');
+        });
+
+        currentView = normalizedView;
+        visitCounts.set(normalizedView, (visitCounts.get(normalizedView) || 0) + 1);
+        updateNavState(normalizedView);
+        document.title = VIEW_TITLES[normalizedView] || VIEW_TITLES.home;
+
+        // Optional category pre-selection when navigating from seasonal cards
+        if (options.category && normalizedView === 'menu') {
+          const chip = targetEl.querySelector('.chip-btn[data-category="' + options.category + '"]');
+          if (chip) {
+            chip.click();
+          }
+        }
+
+        if (options.pushHistory !== false) {
+          const targetPath = normalizedView === 'home' ? '/' : '/' + normalizedView;
+          try {
+            if (window.location.pathname !== targetPath) {
+              window.history.pushState({ view: normalizedView }, '', targetPath);
+            }
+          } catch (_) {
+            window.location.hash = normalizedView;
+          }
+        }
+
+        return targetEl;
+      }
+
+      // Intercept clicks on SPA navigation links
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('a[data-nav], nav a');
+        if (!link) return;
+        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
+
+        const explicitNav = link.dataset.nav;
+        if (explicitNav === 'logout') {
+          e.preventDefault();
+          switchView('account');
+          return;
+        }
+
+        const viewName = explicitNav || resolveViewFromPath(link.getAttribute('href'));
+        if (!viewName || !VALID_VIEWS.has(viewName)) return;
+
+        e.preventDefault();
+        switchView(viewName, {
+          pushHistory: true,
+          category: link.dataset.category || null
+        });
+      });
+
+      window.addEventListener('popstate', (e) => {
+        const stateView = e.state && e.state.view;
+        const resolved = stateView || resolveViewFromPath(window.location.pathname) || resolveViewFromPath(window.location.hash) || 'home';
+        switchView(resolved, { pushHistory: false });
+      });
+
+      window.addEventListener('hashchange', () => {
+        const resolved = resolveViewFromPath(window.location.hash);
+        if (resolved) {
+          switchView(resolved, { pushHistory: false });
+        }
+      });
+
+      // Handle initial route on load
+      const initialView =
+        resolveViewFromPath(window.location.pathname) ||
+        resolveViewFromPath(window.location.hash) ||
+        'home';
+
+      if (initialView !== 'home') {
+        switchView(initialView, { pushHistory: false });
+      } else {
+        updateNavState('home');
+      }
+
+      window.__dailyGrindSPA = {
+        viewCache,
+        visitCounts,
+        switchView,
+        getCurrentView: () => currentView
+      };
+    })();
+  </script>
+
 </body>
 
