+  <script>
+    function setActionTabIndexes(reveal, isRevealed) {
+      for (const control of reveal.querySelectorAll('.SwipeReveal-panel button, .SwipeReveal-panel a')) {
+        control.setAttribute('tabindex', isRevealed ? '0' : '-1');
+      }
+    }
+
+    // Step 3: Reveal controls when trigger button is activated
+    for (const trigger of document.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]')) {
+      trigger.addEventListener('click', () => {
+        const reveal = trigger.closest('.SwipeReveal');
+        if (!reveal) return;
+
+        const label = (trigger.getAttribute('aria-label') || '').toLowerCase();
+        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+        if (isExpanded) {
+          if (label.includes('leading')) {
+            let leadingScrollPanelWidth = reveal.querySelector('.SwipeReveal-panel').offsetWidth;
+            reveal.scrollTo({
+              left: leadingScrollPanelWidth,
+              behavior: 'smooth',
+            });
+          } else if (label.includes('trailing')) {
+            let leadingScrollPanelWidth = reveal.querySelector('.SwipeReveal-panel').offsetWidth;
+            reveal.scrollTo({
+              left: leadingScrollPanelWidth,
+              behavior: 'smooth',
+            });
+          } else {
+            reveal.scrollTo({
+              left: 0,
+              behavior: 'smooth',
+            });
+          }
+
+          for (const actionButton of reveal.querySelectorAll('[aria-label$="actions"]')) {
+            actionButton.setAttribute('aria-expanded', 'false');
+          }
+          setActionTabIndexes(reveal, false);
+          return;
+        }
+
+        const panels = Array.from(reveal.querySelectorAll('.SwipeReveal-panel'));
+        if (panels.length === 0) return;
+
+        let targetScrollLeft = reveal.scrollWidth;
+
+        if (label.includes('leading')) {
+          targetScrollLeft = 0;
+        } else if (label.includes('trailing')) {
+          targetScrollLeft = reveal.scrollWidth;
+        } else if (panels.length === 1) {
+          targetScrollLeft = reveal.scrollWidth;
+        } else {
+          const content = reveal.querySelector('.SwipeReveal-content');
+          const firstTrigger = content.querySelector('[aria-label$="actions"]');
+          targetScrollLeft = trigger === firstTrigger ? 0 : reveal.scrollWidth;
+        }
+
+        reveal.scrollTo({
+          left: targetScrollLeft,
+          behavior: 'smooth',
+        });
+
+        for (const actionButton of reveal.querySelectorAll('[aria-label$="actions"]')) {
+          actionButton.setAttribute('aria-expanded', actionButton === trigger ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, true);
+      });
+    }
+
+    // Close the revealed panel when keyboard focus moves back into the content pane
+    for (const content of document.querySelectorAll('.SwipeReveal-content')) {
+      content.addEventListener('focusin', (event) => {
+        if (event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+    }
+
+    // Fallback for scroll-initial-target when a leading panel precedes .SwipeReveal-content
+    if (!CSS.supports('scroll-initial-target', 'nearest')) {
+      const syncInitialTarget = () => {
+        for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+          const content = reveal.querySelector('.SwipeReveal-content');
+          if (content && content.previousElementSibling) {
+            reveal.scrollTo({ left: content.offsetLeft, behavior: 'instant' });
+          }
+        }
+      };
+      if (document.readyState === 'complete') {
+        syncInitialTarget();
+      } else {
+        window.addEventListener('load', syncInitialTarget, { once: true });
+      }
+    }
+
+    // Real-time scroll snap feedback & accessibility state synchronization
+    for (const container of document.querySelectorAll('.SwipeReveal')) {
+      const items = Array.from(container.children).filter(
+        (el) => el.classList.contains('SwipeReveal-content') || el.classList.contains('SwipeReveal-panel')
+      );
+      const triggers = Array.from(container.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]'));
+
+      const findClosestItemIndex = () => {
+        const maxScrollLeft = container.scrollWidth - container.clientWidth;
+        if (maxScrollLeft <= 0) return 0;
+        const contentIndex = items.findIndex((item) => item.classList.contains('SwipeReveal-content'));
+        const content = items[contentIndex] || items[0];
+        const restScrollLeft = content.offsetLeft;
+        return Math.abs(container.scrollLeft - restScrollLeft) > maxScrollLeft / 2
+          ? items.findIndex((item) => item.classList.contains('SwipeReveal-panel'))
+          : (contentIndex !== -1 ? contentIndex : 0);
+      };
+
+      const applySettledState = (activeIndex) => {
+        const activeItem = items[activeIndex];
+        if (!activeItem) return;
+        const isPanelActive = activeItem.classList.contains('SwipeReveal-panel');
+
+        items.forEach((item, idx) => {
+          item.classList.remove('pending', 'active');
+          if (idx === activeIndex) {
+            item.classList.add('active');
+          }
+        });
+
+        triggers.forEach((trigger) => {
+          trigger.classList.remove('pending');
+          trigger.classList.toggle('active', isPanelActive);
+          trigger.setAttribute('aria-expanded', isPanelActive ? 'true' : 'false');
+        });
+
+        setActionTabIndexes(container, isPanelActive);
+      };
+
+      const applyPendingState = (pendingIndex) => {
+        const pendingItem = items[pendingIndex];
+        if (!pendingItem) return;
+        const isPanelPending = pendingItem.classList.contains('SwipeReveal-panel');
+
+        items.forEach((item, idx) => {
+          item.classList.toggle('pending', idx === pendingIndex);
+        });
+        triggers.forEach((trigger) => {
+          trigger.classList.toggle('pending', isPanelPending);
+        });
+      };
+
+      const initActiveItem = () => {
+        const closestIndex = findClosestItemIndex();
+        applySettledState(closestIndex);
+      };
+
+      if (document.readyState === 'complete') {
+        initActiveItem();
+      } else {
+        window.addEventListener('load', initActiveItem, { once: true });
+      }
+
+      if ('onscrollsnapchanging' in Element.prototype) {
+        container.addEventListener('scrollsnapchanging', (event) => {
+          const pendingTarget = event.snapTargetInline;
+          const index = items.indexOf(pendingTarget);
+          if (index === -1) return;
+          applyPendingState(index);
+        });
+
+        container.addEventListener('scrollsnapchange', (event) => {
+          const snappedTarget = event.snapTargetInline;
+          const index = items.indexOf(snappedTarget);
+          if (index === -1) return;
+          applySettledState(index);
+        });
+      } else {
+        let scrollTimeout;
+        let rafId = null;
+
+        const promotePendingToActive = () => {
+          const closestIndex = findClosestItemIndex();
+          applySettledState(closestIndex);
+        };
+
+        container.addEventListener('scroll', () => {
+          if (rafId) return;
+          rafId = requestAnimationFrame(() => {
+            rafId = null;
+            const closestIndex = findClosestItemIndex();
+            applyPendingState(closestIndex);
+          });
+
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(promotePendingToActive, 100);
+        }, { passive: true });
+
+        container.addEventListener('scrollend', () => {
+          clearTimeout(scrollTimeout);
+          promotePendingToActive();
+        });
+      }
+    }
+
+    // Handle explicit clicks on revealed contextual action buttons
+    for (const button of document.querySelectorAll('.SwipeReveal-panel .swipe-action')) {
+      button.addEventListener('click', () => {
+        if (button.classList.contains('action-favorite')) {
+          const pressed = button.getAttribute('aria-pressed') === 'true';
+          button.setAttribute('aria-pressed', pressed ? 'false' : 'true');
+          button.textContent = pressed ? 'Favorite' : 'Favorited';
+        } else if (button.classList.contains('action-order')) {
+          button.textContent = 'Added!';
+          setTimeout(() => {
+            button.textContent = 'Quick Order';
+          }, 1500);
+        } else if (button.classList.contains('action-customize')) {
+          const cardLink = button.closest('.SwipeReveal')?.querySelector('.SwipeReveal-content a.btn');
+          if (cardLink) {
+            window.location.href = cardLink.getAttribute('href') + '?customize=true';
+          }
+        }
+      });
+    }
+  </script>
