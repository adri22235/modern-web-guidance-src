+  <script>
+    (function () {
+      const ACTION_WIDTH = 192;
+      const SWIPE_THRESHOLD = 40;
+      const cards = document.querySelectorAll('.grid .card');
+      const feedbackEl = document.getElementById('action-feedback');
+
+      function getCoords(e) {
+        if (e.touches && e.touches.length > 0) {
+          return { x: e.touches[0].clientX, y: e.touches[0].clientY };
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          return { x: e.changedTouches[0].clientX, y: e.changedTouches[0].clientY };
+        }
+        if (typeof e.clientX === 'number') {
+          return { x: e.clientX, y: e.clientY };
+        }
+        return null;
+      }
+
+      cards.forEach((card) => {
+        const content = card.querySelector('.card-content');
+        const actions = card.querySelector('.card-actions');
+        const actionButtons = card.querySelectorAll('.action-btn');
+        const drinkName = card.dataset.drink || card.querySelector('h3').textContent.trim();
+
+        let isDragging = false;
+        let startX = 0;
+        let startY = 0;
+        let currentOffset = 0;
+        let openDirection = 0; // 0: closed, -1: opened via left-swipe, 1: opened via right-swipe
+        let lastDeltaX = 0;
+        let didSwipe = false;
+
+        function setRevealedState(direction) {
+          openDirection = direction;
+          currentOffset = direction * ACTION_WIDTH;
+          content.style.transform = currentOffset ? `translateX(${currentOffset}px)` : 'translateX(0px)';
+
+          const isRevealed = direction !== 0;
+          card.classList.toggle('is-revealed', isRevealed);
+          card.classList.toggle('revealed-left', direction === 1);
+          card.dataset.revealed = isRevealed ? 'true' : 'false';
+          actions.setAttribute('aria-hidden', isRevealed ? 'false' : 'true');
+          actionButtons.forEach((btn) => {
+            btn.setAttribute('tabindex', isRevealed ? '0' : '-1');
+          });
+        }
+
+        function onDragStart(e) {
+          if (e.target && e.target.closest('.card-actions')) {
+            return;
+          }
+          if (e.type === 'mousedown' && e.button !== 0) {
+            return;
+          }
+          const coords = getCoords(e);
+          if (!coords) return;
+
+          if (isDragging) return;
+          isDragging = true;
+          didSwipe = false;
+          startX = coords.x;
+          startY = coords.y;
+          lastDeltaX = 0;
+          card.classList.add('is-dragging');
+        }
+
+        function onDragMove(e) {
+          if (!isDragging) return;
+          const coords = getCoords(e);
+          if (!coords) return;
+
+          const dx = coords.x - startX;
+          const dy = coords.y - startY;
+
+          if (Math.abs(dx) < 5 && Math.abs(dy) > Math.abs(dx)) {
+            return;
+          }
+
+          if (Math.abs(dx) > 5) {
+            didSwipe = true;
+          }
+
+          lastDeltaX = dx;
+          let nextOffset = openDirection * ACTION_WIDTH + dx;
+
+          if (openDirection === 0) {
+            card.classList.toggle('revealed-left', nextOffset > 0);
+            nextOffset = Math.max(-ACTION_WIDTH, Math.min(ACTION_WIDTH, nextOffset));
+          } else if (openDirection === -1) {
+            nextOffset = Math.max(-ACTION_WIDTH, Math.min(0, nextOffset));
+          } else if (openDirection === 1) {
+            nextOffset = Math.max(0, Math.min(ACTION_WIDTH, nextOffset));
+          }
+
+          content.style.transform = `translateX(${nextOffset}px)`;
+        }
+
+        function onDragEnd(e) {
+          if (!isDragging) return;
+          const coords = getCoords(e);
+          if (coords) {
+            const endDx = coords.x - startX;
+            if (Math.abs(endDx) > Math.abs(lastDeltaX)) {
+              lastDeltaX = endDx;
+              if (Math.abs(endDx) > 5) {
+                didSwipe = true;
+              }
+            }
+          }
+
+          isDragging = false;
+          card.classList.remove('is-dragging');
+
+          if (openDirection === 0) {
+            if (lastDeltaX <= -SWIPE_THRESHOLD) {
+              setRevealedState(-1);
+            } else if (lastDeltaX >= SWIPE_THRESHOLD) {
+              setRevealedState(1);
+            } else {
+              setRevealedState(0);
+            }
+          } else if (openDirection === -1) {
+            if (lastDeltaX >= SWIPE_THRESHOLD) {
+              setRevealedState(0);
+            } else {
+              setRevealedState(-1);
+            }
+          } else if (openDirection === 1) {
+            if (lastDeltaX <= -SWIPE_THRESHOLD) {
+              setRevealedState(0);
+            } else {
+              setRevealedState(1);
+            }
+          }
+        }
+
+        card.addEventListener('touchstart', onDragStart, { passive: true });
+        card.addEventListener('touchmove', onDragMove, { passive: true });
+        card.addEventListener('touchend', onDragEnd);
+        card.addEventListener('touchcancel', onDragEnd);
+
+        card.addEventListener('pointerdown', onDragStart);
+        window.addEventListener('pointermove', onDragMove);
+        window.addEventListener('pointerup', onDragEnd);
+        window.addEventListener('pointercancel', onDragEnd);
+
+        card.addEventListener('mousedown', onDragStart);
+        window.addEventListener('mousemove', onDragMove);
+        window.addEventListener('mouseup', onDragEnd);
+
+        content.addEventListener('click', (e) => {
+          if (didSwipe) {
+            e.preventDefault();
+            e.stopPropagation();
+            didSwipe = false;
+          }
+        }, true);
+
+        actionButtons.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const action = btn.dataset.action;
+            let message = '';
+            if (action === 'order') {
+              message = `Added ${drinkName} to your order.`;
+            } else if (action === 'customize') {
+              message = `Customizing ${drinkName} options.`;
+            } else if (action === 'favorite') {
+              const isFav = btn.classList.toggle('is-favorited');
+              btn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+              const icon = btn.querySelector('.action-icon');
+              if (icon) icon.textContent = isFav ? '♥' : '♡';
+              message = isFav
+                ? `Saved ${drinkName} to your favorites.`
+                : `Removed ${drinkName} from your favorites.`;
+            }
+            if (feedbackEl && message) {
+              feedbackEl.textContent = message;
+              feedbackEl.classList.add('is-visible');
+            }
+          });
+        });
+      });
+    })();
+  </script>
 </body>
 
 </html>
