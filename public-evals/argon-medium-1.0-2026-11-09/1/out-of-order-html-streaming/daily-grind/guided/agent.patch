+  <script type="module">
+    // 1. Polyfill strategy for browsers lacking native <template for> or HTML streaming/setter APIs
+    async function ensureHTMLStreamingPolyfills() {
+      if (!('for' in HTMLTemplateElement.prototype)) {
+        try {
+          await import('template-for-polyfill');
+        } catch {
+          // Minimal fallback if bare specifier isn't mapped in a static environment
+          document.querySelectorAll('template[for]').forEach((tpl) => {
+            const targetName = tpl.getAttribute('for');
+            const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_COMMENT);
+            let startComment = null;
+            let current;
+            while ((current = walker.nextNode())) {
+              const text = current.nodeValue.trim();
+              if (text === `?marker name="${targetName}"` || text === `?marker name="${targetName}"?`) {
+                current.replaceWith(tpl.content.cloneNode(true));
+                tpl.remove();
+                return;
+              }
+              if (text === `?start name="${targetName}"` || text === `?start name="${targetName}"?`) {
+                startComment = current;
+              } else if (startComment && (text === '?end' || text === '?end?')) {
+                const range = document.createRange();
+                range.setStartBefore(startComment);
+                range.setEndAfter(current);
+                range.deleteContents();
+                range.insertNode(tpl.content.cloneNode(true));
+                tpl.remove();
+                return;
+              }
+            }
+          });
+        }
+      }
+
+      if (!('streamHTML' in Element.prototype)) {
+        try {
+          await import('html-setters-polyfill');
+        } catch {
+          // Graceful fallback handled in helper methods below
+        }
+      }
+    }
+
+    // 2. Sanitizer API with feature-detected DOMPurify fallback for untrusted customer reviews
+    let domPurifyPromise;
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('dompurify').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    const REVIEW_ALLOWED_ELEMENTS = ['div', 'p', 'b', 'i', 'strong', 'em', 'span', 'blockquote', 'cite'];
+    const REVIEW_ALLOWED_ATTRIBUTES = ['class'];
+
+    export async function safeSetReviewHTML(el, untrustedHTML) {
+      const elements = REVIEW_ALLOWED_ELEMENTS;
+      const attributes = REVIEW_ALLOWED_ATTRIBUTES;
+
+      if ('setHTML' in Element.prototype) {
+        const sanitizer =
+          typeof Sanitizer !== 'undefined'
+            ? new Sanitizer({ elements, attributes })
+            : { elements, attributes };
+        el.setHTML(untrustedHTML, { sanitizer });
+      } else {
+        try {
+          const DOMPurify = await loadDOMPurify();
+          el.innerHTML = DOMPurify.sanitize(untrustedHTML, {
+            ALLOWED_TAGS: [...elements, '#text'],
+            ALLOWED_ATTR: attributes,
+            ALLOW_ARIA_ATTR: false,
+            ALLOW_DATA_ATTR: false,
+            KEEP_CONTENT: false,
+          });
+        } catch {
+          el.textContent = untrustedHTML;
+        }
+      }
+    }
+
+    // 3. Refresh seasonal coffee cards in place from the server when the menu changes
+    const seasonalGrid = document.getElementById('seasonal-cards-grid');
+    const seasonSelect = document.getElementById('menu-season-select');
+    const refreshBtn = document.getElementById('refresh-menu-btn');
+
+    export async function refreshSeasonalCards(season = seasonSelect.value) {
+      if (!seasonalGrid) return;
+
+      // Preserve focus if an interactive element inside the grid was focused before patching
+      const hadFocusWithin = seasonalGrid.contains(document.activeElement);
+      seasonalGrid.setAttribute('aria-busy', 'true');
+
+      try {
+        const response = await fetch(`/api/menu/seasonal?season=${encodeURIComponent(season)}`, {
+          headers: { Accept: 'text/html' },
+        });
+
+        if (!response.ok) {
+          throw new Error(`Menu fetch failed with status ${response.status}`);
+        }
+
+        if ('streamHTML' in seasonalGrid) {
+          if (typeof response.textStream === 'function') {
+            await response.textStream().pipeTo(seasonalGrid.streamHTML());
+          } else if (response.body) {
+            await response.body
+              .pipeThrough(new TextDecoderStream())
+              .pipeTo(seasonalGrid.streamHTML());
+          }
+        } else if ('setHTML' in seasonalGrid) {
+          const html = await response.text();
+          seasonalGrid.setHTML(html);
+        } else {
+          const html = await response.text();
+          const doc = 'parseHTML' in Document ? Document.parseHTML(html) : new DOMParser().parseFromString(html, 'text/html');
+          seasonalGrid.replaceChildren(...doc.body.childNodes);
+        }
+      } catch (err) {
+        console.warn('Unable to stream live seasonal menu from server:', err);
+      } finally {
+        seasonalGrid.removeAttribute('aria-busy');
+        if (hadFocusWithin) {
+          const firstAction = seasonalGrid.querySelector('a, button');
+          firstAction?.focus();
+        }
+      }
+    }
+
+    // 4. Update the first-party CMS promo block (trusted HTML with embedded widget <script>)
+    const cmsPromoContainer = document.getElementById('cms-promo-container');
+
+    export async function updateCMSPromoBlock(cmsHTMLOrResponse) {
+      if (!cmsPromoContainer) return;
+
+      // Streaming Response from our trusted CMS endpoint
+      if (cmsHTMLOrResponse instanceof Response) {
+        if ('streamHTMLUnsafe' in cmsPromoContainer) {
+          if (typeof cmsHTMLOrResponse.textStream === 'function') {
+            await cmsHTMLOrResponse
+              .textStream()
+              .pipeTo(cmsPromoContainer.streamHTMLUnsafe({ runScripts: true }));
+          } else if (cmsHTMLOrResponse.body) {
+            await cmsHTMLOrResponse.body
+              .pipeThrough(new TextDecoderStream())
+              .pipeTo(cmsPromoContainer.streamHTMLUnsafe({ runScripts: true }));
+          }
+          return;
+        }
+        cmsHTMLOrResponse = await cmsHTMLOrResponse.text();
+      }
+
+      // Static HTML string from our trusted CMS with embedded widget script execution enabled
+      if (typeof cmsHTMLOrResponse === 'string') {
+        if ('setHTMLUnsafe' in cmsPromoContainer) {
+          cmsPromoContainer.setHTMLUnsafe(cmsHTMLOrResponse, { runScripts: true });
+        } else {
+          const range = document.createRange();
+          range.selectNodeContents(cmsPromoContainer);
+          cmsPromoContainer.replaceChildren(range.createContextualFragment(cmsHTMLOrResponse));
+        }
+      }
+    }
+
+    // 5. Render untrusted customer-submitted reviews safely via setHTML() + custom Sanitizer
+    const reviewsList = document.getElementById('customer-reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const reviewInput = document.getElementById('review-input');
+
+    export async function appendCustomerReview(untrustedReviewHTML, author = 'Verified Customer') {
+      if (!reviewsList) return;
+
+      const reviewWrapper = document.createElement('div');
+      reviewWrapper.className = 'review-item';
+
+      const authorPrefix = document.createElement('strong');
+      authorPrefix.textContent = `${author}: `;
+
+      const reviewBody = document.createElement('div');
+      await safeSetReviewHTML(reviewBody, untrustedReviewHTML);
+      reviewBody.prepend(authorPrefix);
+
+      reviewsList.append(reviewWrapper);
+      reviewWrapper.append(reviewBody);
+    }
+
+    reviewForm?.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const rawReview = reviewInput.value.trim();
+      if (!rawReview) return;
+
+      await appendCustomerReview(rawReview);
+      reviewForm.reset();
+    });
+
+    seasonSelect?.addEventListener('change', () => {
+      refreshSeasonalCards(seasonSelect.value);
+    });
+
+    refreshBtn?.addEventListener('click', () => {
+      refreshSeasonalCards(seasonSelect.value);
+    });
+
+    // Listen for server/app-dispatched menu change events to refresh cards automatically
+    window.addEventListener('menu-change', (event) => {
+      const nextSeason = event.detail?.season ?? seasonSelect?.value;
+      refreshSeasonalCards(nextSeason);
+    });
+
+    await ensureHTMLStreamingPolyfills();
+  </script>
+
 </body>
 
