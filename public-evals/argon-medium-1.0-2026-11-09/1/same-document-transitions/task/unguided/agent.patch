+  <script>
+    const listPage = document.getElementById('list-page');
+    const listHeading = document.getElementById('list-heading');
+    const detailPage = document.getElementById('detail-page');
+    const heroImg = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const detailDescription = document.getElementById('detail-description');
+    const backButton = document.getElementById('back-button');
+    const thumbnails = Array.from(document.querySelectorAll('#list-page .thumbnail'));
+
+    let activeThumbnail = thumbnails[0] || null;
+
+    function setActiveThumbnail(card) {
+      thumbnails.forEach((thumb) => {
+        thumb.classList.toggle('active', thumb === card);
+      });
+      activeThumbnail = card;
+    }
+
+    function runViewTransition(updateDom) {
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      if (typeof document.startViewTransition === 'function' && !prefersReducedMotion) {
+        return document.startViewTransition(() => {
+          updateDom();
+        });
+      }
+      updateDom();
+      return null;
+    }
+
+    function showDetail(card) {
+      setActiveThumbnail(card);
+      const img = card.querySelector('img');
+      const cardTitle = card.querySelector('.title');
+      const titleText = cardTitle ? cardTitle.textContent.trim() : '';
+      const imgSrc = img ? img.getAttribute('src') : '';
+      const imgAlt = img ? img.getAttribute('alt') : titleText;
+      const description = card.dataset.description || '';
+
+      runViewTransition(() => {
+        if (imgSrc) {
+          heroImg.setAttribute('src', imgSrc);
+        }
+        heroImg.setAttribute('alt', imgAlt);
+        detailTitle.textContent = titleText;
+        if (detailDescription) {
+          detailDescription.textContent = description;
+        }
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        detailTitle.focus();
+      });
+    }
+
+    function showList() {
+      runViewTransition(() => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        listHeading.focus();
+      });
+    }
+
+    thumbnails.forEach((card) => {
+      card.addEventListener('pointerdown', () => {
+        setActiveThumbnail(card);
+      });
+
+      card.addEventListener('click', () => {
+        showDetail(card);
+      });
+
+      card.addEventListener('keydown', (event) => {
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          showDetail(card);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', () => {
+      showList();
+    });
+
+    detailPage.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        showList();
+      }
+    });
+  </script>
+
