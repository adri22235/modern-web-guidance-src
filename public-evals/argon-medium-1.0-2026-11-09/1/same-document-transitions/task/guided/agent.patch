+  <script>
+    const defaultPageTitle = document.title;
+    const heroImage = document.getElementById("hero");
+    const detailTitle = document.getElementById("title");
+    const detailDescription = document.getElementById("detail-description");
+    const listHeading = document.getElementById("list-heading");
+    const backButton = document.getElementById("back-button");
+
+    function updateDetailContent(card) {
+      const cardTitle = card.querySelector(".title")?.textContent ?? "";
+      const imageSrc = card.dataset.image || card.querySelector("img")?.src || "";
+      const imageAlt = card.dataset.alt || card.querySelector("img")?.alt || cardTitle;
+      const descriptionText = card.dataset.description || card.querySelector("p")?.textContent || "";
+
+      heroImage.src = imageSrc;
+      heroImage.alt = imageAlt;
+      detailTitle.textContent = cardTitle;
+      detailDescription.textContent = descriptionText;
+      document.title = `${cardTitle} | The Daily Grind`;
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+      document.querySelectorAll(".selected").forEach((element) => {
+        element.classList.remove("selected");
+      });
+      card.classList.add("selected");
+      updateDetailContent(card);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add("detail");
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add("detail");
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      if (!document.startViewTransition) {
+        document.body.classList.remove("detail");
+        document.title = defaultPageTitle;
+        document.querySelectorAll(".selected").forEach((element) => {
+          element.classList.remove("selected");
+        });
+        listHeading?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove("detail");
+        document.title = defaultPageTitle;
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll(".selected").forEach((element) => {
+          element.classList.remove("selected");
+        });
+      });
+    }
+
+    document.querySelectorAll("#list-page .thumbnail").forEach((thumbnail) => {
+      thumbnail.addEventListener("click", goFromListToDetail);
+    });
+
+    backButton.addEventListener("click", goFromDetailToList);
+  </script>
 </body>
 
