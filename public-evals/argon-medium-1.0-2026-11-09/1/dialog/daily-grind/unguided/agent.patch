+  <script>
+    (function () {
+      const DRINKS = {
+        'Maple Oat Latte': {
+          title: 'Maple Oat Latte',
+          meta: '210 cal \u2022 150mg caffeine \u2022 Seasonal Favorite',
+          description: 'Creamy steamed oat milk infused with pure Vermont grade-A maple syrup and our signature double-shot espresso, topped with a light dusting of cinnamon.',
+          basePrice: 5.50,
+          defaultMilk: 'Oat Milk',
+          defaultTemp: 'Hot',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=400&q=80'
+        },
+        'Dark Roast Espresso': {
+          title: 'Dark Roast Espresso',
+          meta: '15 cal \u2022 185mg caffeine \u2022 Single-Origin Blend',
+          description: 'Bold, smokey, and perfect for a morning boost. Slow-roasted Colombian and Sumatran beans pulled to a rich, velvety golden crema with dark cocoa notes.',
+          basePrice: 3.75,
+          defaultMilk: 'No Milk',
+          defaultTemp: 'Hot',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=400&q=80'
+        },
+        'Cold Brew': {
+          title: 'Cold Brew',
+          meta: '10 cal \u2022 200mg caffeine \u2022 18-Hour Slow Steep',
+          description: 'Steeped for 18 hours in cold filtered water for maximum smoothness, ultra-low acidity, and a naturally sweet dark chocolate finish served over artisan ice.',
+          basePrice: 4.75,
+          defaultMilk: 'No Milk',
+          defaultTemp: 'Iced',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=400&q=80'
+        }
+      };
+
+      const modal = document.getElementById('drink-order-modal');
+      const form = document.getElementById('drink-order-form');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const discardBanner = document.getElementById('discard-confirm-banner');
+      const discardBannerMessage = document.getElementById('discard-banner-message');
+      const discardBtn = document.getElementById('discard-changes-btn');
+      const drinkSelect = document.getElementById('order-drink-select');
+      const milkSelect = document.getElementById('order-milk-select');
+      const quantityInput = document.getElementById('order-quantity');
+      const notesInput = document.getElementById('order-notes');
+      const titleEl = document.getElementById('modal-drink-title');
+      const metaEl = document.getElementById('modal-drink-meta');
+      const descEl = document.getElementById('modal-drink-description');
+      const basePriceEl = document.getElementById('modal-drink-base-price');
+      const imageEl = document.getElementById('modal-drink-image');
+      const totalEl = document.getElementById('modal-order-total');
+      const toastEl = document.getElementById('order-toast');
+
+      let hasChanges = false;
+      let toastTimeout = null;
+
+      function updateDrinkDisplay(drinkName) {
+        const drink = DRINKS[drinkName] || DRINKS['Maple Oat Latte'];
+        titleEl.textContent = drink.title;
+        metaEl.textContent = drink.meta;
+        descEl.textContent = drink.description;
+        basePriceEl.textContent = 'Base: $' + drink.basePrice.toFixed(2);
+        imageEl.src = drink.image;
+        imageEl.alt = drink.title;
+      }
+
+      function updateOrderTotal() {
+        const drinkName = drinkSelect.value;
+        const drink = DRINKS[drinkName] || DRINKS['Maple Oat Latte'];
+        let unitPrice = drink.basePrice;
+
+        const checkedSize = form.querySelector('input[name="size"]:checked');
+        if (checkedSize) {
+          unitPrice += parseFloat(checkedSize.getAttribute('data-price-delta') || '0');
+        }
+
+        const checkedAddons = form.querySelectorAll('input[type="checkbox"]:checked');
+        checkedAddons.forEach(function (box) {
+          unitPrice += parseFloat(box.getAttribute('data-price-delta') || '0');
+        });
+
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        const total = unitPrice * qty;
+        totalEl.textContent = 'Total: $' + total.toFixed(2);
+      }
+
+      function setDirtyState(isDirty, emphasizeWarning) {
+        hasChanges = isDirty;
+        if (hasChanges) {
+          discardBanner.hidden = false;
+          if (emphasizeWarning) {
+            discardBanner.classList.add('attention');
+            discardBannerMessage.textContent = 'Please confirm discarding your changes before closing.';
+            discardBtn.focus();
+          } else {
+            discardBanner.classList.remove('attention');
+            discardBannerMessage.textContent = 'You have unsaved changes to your order options.';
+          }
+        } else {
+          discardBanner.hidden = true;
+          discardBanner.classList.remove('attention');
+        }
+      }
+
+      function openOrderModal(drinkName) {
+        const selectedDrinkName = DRINKS[drinkName] ? drinkName : 'Maple Oat Latte';
+        const drink = DRINKS[selectedDrinkName];
+
+        form.reset();
+        drinkSelect.value = selectedDrinkName;
+        milkSelect.value = drink.defaultMilk;
+
+        const tempRadio = form.querySelector('input[name="temperature"][value="' + drink.defaultTemp + '"]');
+        if (tempRadio) {
+          tempRadio.checked = true;
+        }
+        const mediumRadio = form.querySelector('input[name="size"][value="Medium"]');
+        if (mediumRadio) {
+          mediumRadio.checked = true;
+        }
+        quantityInput.value = '1';
+        notesInput.value = '';
+
+        updateDrinkDisplay(selectedDrinkName);
+        updateOrderTotal();
+        setDirtyState(false, false);
+
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+      }
+
+      function forceCloseModal() {
+        setDirtyState(false, false);
+        if (typeof modal.close === 'function' && modal.open) {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+      }
+
+      function attemptDismissModal(event) {
+        if (hasChanges) {
+          if (event) {
+            event.preventDefault();
+            event.stopPropagation();
+          }
+          setDirtyState(true, true);
+          return false;
+        }
+        forceCloseModal();
+        return true;
+      }
+
+      // Open modal from hero and card buttons
+      document.querySelectorAll('.js-open-order-modal').forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          event.preventDefault();
+          const drinkName = btn.getAttribute('data-drink') || 'Maple Oat Latte';
+          openOrderModal(drinkName);
+        });
+      });
+
+      // Track any user changes to order options
+      form.addEventListener('change', function (event) {
+        if (event.target === drinkSelect) {
+          updateDrinkDisplay(drinkSelect.value);
+        }
+        updateOrderTotal();
+        setDirtyState(true, false);
+      });
+
+      form.addEventListener('input', function () {
+        updateOrderTotal();
+        setDirtyState(true, false);
+      });
+
+      // Close button inside modal
+      closeBtn.addEventListener('click', function (event) {
+        attemptDismissModal(event);
+      });
+
+      // Prevent native Escape dismissal on <dialog> when order options have changed
+      modal.addEventListener('cancel', function (event) {
+        if (hasChanges) {
+          event.preventDefault();
+          setDirtyState(true, true);
+        }
+      });
+
+      // Also intercept Escape keydown directly for cross-environment consistency
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && modal.open) {
+          if (hasChanges) {
+            event.preventDefault();
+            event.stopPropagation();
+            setDirtyState(true, true);
+          } else {
+            event.preventDefault();
+            forceCloseModal();
+          }
+        }
+      });
+
+      // Backdrop click handling
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          attemptDismissModal(event);
+        }
+      });
+
+      // Discard changes confirmation button inside the dialog
+      discardBtn.addEventListener('click', function () {
+        forceCloseModal();
+      });
+
+      // Order submission
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const drinkName = drinkSelect.value;
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const size = sizeInput ? sizeInput.value : 'Medium';
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+
+        forceCloseModal();
+
+        toastEl.textContent = 'Added ' + qty + '\u00d7 ' + size + ' ' + drinkName + ' to your order!';
+        toastEl.hidden = false;
+        if (toastTimeout) {
+          clearTimeout(toastTimeout);
+        }
+        toastTimeout = setTimeout(function () {
+          toastEl.hidden = true;
+        }, 4000);
+      });
+    })();
+  </script>
+
 </body>
 
