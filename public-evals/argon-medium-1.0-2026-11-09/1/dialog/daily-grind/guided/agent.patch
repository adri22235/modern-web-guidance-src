+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        price: '$5.50',
+        description: 'Creamy steamed oat milk blended with rich espresso and a hint of pure Vermont maple syrup.',
+        milk: 'oat',
+        sweetness: 'standard'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        price: '$3.75',
+        description: 'Bold, smokey, and full-bodied double shot pulled from our signature dark-roasted beans—perfect for a morning boost.',
+        milk: 'none',
+        sweetness: 'unsweetened'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        price: '$4.75',
+        description: 'Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for maximum smoothness and cocoa notes.',
+        milk: 'none',
+        sweetness: 'unsweetened'
+      }
+    };
+
+    const dialog = document.getElementById('order-dialog');
+    const form = document.getElementById('order-form');
+    const titleEl = document.getElementById('order-dialog-title');
+    const priceEl = document.getElementById('order-dialog-price');
+    const descEl = document.getElementById('order-dialog-description');
+    const drinkSelect = document.getElementById('drink-select');
+    const sizeSelect = document.getElementById('size-select');
+    const milkSelect = document.getElementById('milk-select');
+    const sweetnessSelect = document.getElementById('sweetness-select');
+    const quantityInput = document.getElementById('quantity-input');
+    const discardWarning = document.getElementById('discard-warning');
+    const discardBtn = document.getElementById('discard-btn');
+    const cancelBtn = document.getElementById('cancel-btn');
+
+    let isDirty = false;
+
+    function updateDrinkDisplay(drinkId) {
+      const drink = DRINKS[drinkId] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      priceEl.textContent = drink.price;
+      descEl.textContent = drink.description;
+    }
+
+    function setDirtyState(dirty) {
+      isDirty = dirty;
+      dialog.setAttribute('closedby', dirty ? 'none' : 'any');
+      if (!dirty) {
+        discardWarning.classList.remove('is-visible');
+        discardBtn.hidden = true;
+      }
+    }
+
+    function selectDrinkAndReset(drinkId) {
+      const key = DRINKS[drinkId] ? drinkId : 'maple-oat-latte';
+      const drink = DRINKS[key];
+      drinkSelect.value = key;
+      sizeSelect.value = 'medium';
+      milkSelect.value = drink.milk;
+      sweetnessSelect.value = drink.sweetness;
+      quantityInput.value = '1';
+      updateDrinkDisplay(key);
+      setDirtyState(false);
+    }
+
+    function promptDiscardConfirmation() {
+      discardWarning.classList.add('is-visible');
+      discardBtn.hidden = false;
+      discardBtn.focus();
+    }
+
+    for (const trigger of document.querySelectorAll('[commandfor="order-dialog"][command="show-modal"]')) {
+      trigger.addEventListener('click', () => {
+        selectDrinkAndReset(trigger.dataset.drink);
+        if (!('commandForElement' in HTMLButtonElement.prototype) && !dialog.open) {
+          dialog.showModal();
+        }
+      });
+    }
+
+    form.addEventListener('change', (event) => {
+      if (event.target === drinkSelect) {
+        updateDrinkDisplay(drinkSelect.value);
+      }
+      setDirtyState(true);
+    });
+
+    form.addEventListener('input', () => {
+      setDirtyState(true);
+    });
+
+    dialog.addEventListener('cancel', (event) => {
+      if (isDirty) {
+        event.preventDefault();
+        promptDiscardConfirmation();
+      }
+    });
+
+    dialog.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && isDirty) {
+        event.preventDefault();
+        promptDiscardConfirmation();
+      }
+    });
+
+    cancelBtn.addEventListener('click', () => {
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        if ('requestClose' in dialog) {
+          dialog.requestClose();
+        } else {
+          const cancelEvent = new Event('cancel', { cancelable: true });
+          if (dialog.dispatchEvent(cancelEvent)) {
+            dialog.close();
+          }
+        }
+      }
+    });
+
+    const isOutsideDialog = (e, dlg) => {
+      const r = dlg.getBoundingClientRect();
+      return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+    };
+
+    let pressedOutside = false;
+    dialog.addEventListener('pointerdown', (e) => {
+      pressedOutside = isOutsideDialog(e, dialog);
+    });
+    dialog.addEventListener('pointerup', (e) => {
+      if (pressedOutside && isOutsideDialog(e, dialog)) {
+        if (isDirty) {
+          promptDiscardConfirmation();
+        } else if (!('closedBy' in HTMLDialogElement.prototype) && dialog.getAttribute('closedby') === 'any') {
+          dialog.close();
+        }
+      }
+    });
+
+    dialog.addEventListener('close', () => {
+      const chosenAction = dialog.returnValue;
+      dialog.returnValue = '';
+      if (chosenAction === 'order' || chosenAction === 'discard' || chosenAction === '') {
+        setDirtyState(false);
+      }
+    });
+  </script>
 </body>
 
