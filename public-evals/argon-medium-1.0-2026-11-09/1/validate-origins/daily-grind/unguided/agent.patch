+       * @returns {boolean}
+       */
+      function isWidgetInitMessage(data) {
+        if (typeof data === 'string') {
+          const normalized = data.trim().toLowerCase();
+          return (
+            normalized === 'init' ||
+            normalized === 'widget_init' ||
+            normalized === 'widget-init' ||
+            normalized === 'initialize' ||
+            normalized === 'register'
+          );
+        }
+        if (data && typeof data === 'object') {
+          const msgType = String(data.type || data.action || data.event || '')
+            .trim()
+            .toLowerCase();
+          return (
+            msgType === 'init' ||
+            msgType === 'widget_init' ||
+            msgType === 'widget-init' ||
+            msgType === 'initialize' ||
+            msgType === 'register' ||
+            msgType === 'handshake' ||
+            data.init === true
+          );
+        }
+        return false;
+      }
+
+      /**
+       * Formats message payloads into safe plain text for UI display via textContent.
+       *
+       * @param {unknown} data
+       * @returns {string}
+       */
+      function formatPayloadText(data) {
+        if (typeof data === 'string') {
+          return data;
+        }
+        if (!data || typeof data !== 'object') {
+          return String(data ?? '');
+        }
+        if (typeof data.message === 'string' && data.message.trim()) {
+          return data.message.trim();
+        }
+        if (data.item && data.custom) {
+          return 'Selected ' + String(data.item) + ' (' + String(data.custom) + ')';
+        }
+        if (data.orderId && data.status) {
+          return 'Order #' + String(data.orderId) + ': ' + String(data.status);
+        }
+        if (data.status && data.item) {
+          return String(data.item) + ' - ' + String(data.status);
+        }
+        if (data.status) {
+          return 'Status: ' + String(data.status);
+        }
+        if (data.item) {
+          return 'Item: ' + String(data.item);
+        }
+        try {
+          return JSON.stringify(data);
+        } catch (_err) {
+          return '[Message Object]';
+        }
+      }
+
+      /**
+       * Updates DOM status banners for trusted ordering origin messages using textContent.
+       */
+      function updateOrderingUI(accepted, detailText, origin) {
+        const banner = document.getElementById('order-status-banner');
+        const msgEl = document.getElementById('order-status-message');
+        const badge = document.getElementById('order-origin-badge');
+        const rejectedBanner = document.getElementById('order-rejected-banner');
+        const rejectedMsgEl = document.getElementById('order-rejected-message');
+
+        if (accepted) {
+          if (banner) {
+            banner.className = 'status-banner accepted';
+            banner.dataset.status = 'accepted';
+            banner.dataset.lastOrigin = origin;
+          }
+          if (msgEl) {
+            msgEl.textContent = detailText;
+          }
+          if (badge) {
+            badge.className = 'badge verified';
+            badge.textContent = 'Verified: ' + origin;
+          }
+        } else {
+          if (rejectedBanner) {
+            rejectedBanner.style.display = 'block';
+            rejectedBanner.dataset.lastRejectedOrigin = String(origin || '');
+          }
+          if (rejectedMsgEl) {
+            rejectedMsgEl.textContent = detailText;
+          }
+          if (badge && (!banner || banner.dataset.status !== 'accepted')) {
+            badge.className = 'badge blocked';
+            badge.textContent = 'Rejected Untrusted Origin';
+          }
+        }
+      }
+
+      /**
+       * Updates DOM status banners for the sandboxed widget using textContent.
+       */
+      function updateWidgetUI(accepted, detailText, isPinned) {
+        const banner = document.getElementById('widget-status-banner');
+        const msgEl = document.getElementById('widget-status-message');
+        const badge = document.getElementById('widget-pin-badge');
+        const rejectedBanner = document.getElementById('widget-rejected-banner');
+        const rejectedMsgEl = document.getElementById('widget-rejected-message');
+
+        if (accepted) {
+          if (banner) {
+            banner.className = 'status-banner accepted';
+            banner.dataset.pinned = isPinned ? 'true' : 'false';
+            banner.dataset.status = 'accepted';
+          }
+          if (msgEl) {
+            msgEl.textContent = detailText;
+          }
+          if (badge) {
+            badge.className = 'badge verified';
+            badge.textContent = isPinned ? 'Sender Identity Pinned' : 'Verified';
+          }
+        } else {
+          if (rejectedBanner) {
+            rejectedBanner.style.display = 'block';
+            rejectedBanner.dataset.status = 'rejected';
+          }
+          if (rejectedMsgEl) {
+            rejectedMsgEl.textContent = detailText;
+          }
+        }
+      }
+
+      /**
+       * Handles messages from sandboxed iframes (event.origin === "null") by pinning
+       * the sender identity (event.source) on initialization and verifying all subsequent
+       * messages against the pinned WindowProxy reference.
+       *
+       * @param {MessageEvent} event
+       */
+      function handleSandboxedWidgetMessage(event) {
+        if (!event || event.origin !== 'null') {
+          return {
+            accepted: false,
+            category: 'sandbox-widget',
+            reason: 'not-opaque-origin'
+          };
+        }
+
+        // Sandboxed iframe messages must provide a valid WindowProxy / MessagePort source distinct from parent window
+        if (!event.source || event.source === window) {
+          const reasonText = 'Rejected null-origin message without a valid sandboxed iframe source.';
+          updateWidgetUI(false, reasonText, pinnedWidgetSource !== null);
+          return {
+            accepted: false,
+            category: 'sandbox-widget',
+            reason: 'missing-or-invalid-source'
+          };
+        }
+
+        const data = event.data;
+
+        // Initialization handshake: pin sender identity if not yet pinned
+        if (isWidgetInitMessage(data)) {
+          const isExistingPinClosed = Boolean(
+            pinnedWidgetSource && typeof pinnedWidgetSource === 'object' && pinnedWidgetSource.closed === true
+          );
+
+          if (pinnedWidgetSource === null || isExistingPinClosed) {
+            pinnedWidgetSource = event.source;
+            const initText = 'Initialized and pinned sandboxed widget sender identity.';
+            updateWidgetUI(true, initText, true);
+            return {
+              accepted: true,
+              category: 'sandbox-widget',
+              type: 'init',
+              reason: 'sender-identity-pinned',
+              data: data
+            };
+          }
+
+          if (event.source === pinnedWidgetSource) {
+            const reAckText = 'Pinned sandboxed widget confirmed initialization.';
+            updateWidgetUI(true, reAckText, true);
+            return {
+              accepted: true,
+              category: 'sandbox-widget',
+              type: 'init-ack',
+              reason: 'already-pinned-same-sender',
+              data: data
+            };
+          }
+
+          const conflictText = 'Rejected initialization attempt from unpinned sandboxed iframe.';
+          updateWidgetUI(false, conflictText, true);
+          return {
+            accepted: false,
+            category: 'sandbox-widget',
+            reason: 'sender-already-pinned-to-another-widget'
+          };
+        }
+
+        // Subsequent messages: require an active pin and strict identity match on event.source
+        if (pinnedWidgetSource === null) {
+          const uninitText = 'Rejected sandboxed widget message received before initialization.';
+          updateWidgetUI(false, uninitText, false);
+          return {
+            accepted: false,
+            category: 'sandbox-widget',
+            reason: 'widget-not-initialized'
+          };
+        }
+
+        if (event.source !== pinnedWidgetSource) {
+          const mismatchText = 'Rejected message from another sandboxed iframe (event.source mismatch).';
+          updateWidgetUI(false, mismatchText, true);
+          return {
+            accepted: false,
+            category: 'sandbox-widget',
+            reason: 'untrusted-sandboxed-sender'
+          };
+        }
+
+        const formatted = formatPayloadText(data);
+        updateWidgetUI(true, 'Accepted from pinned widget: ' + formatted, true);
+        return {
+          accepted: true,
+          category: 'sandbox-widget',
+          type: 'message',
+          reason: 'verified-pinned-sender',
+          data: data
+        };
+      }
+
+      /**
+       * Primary cross-window message handler verifying:
+       * 1. Messages from the trusted ordering origin (https://order.dailygrind.com).
+       * 2. Messages from the pinned sandboxed iframe widget (event.origin === "null" + pinned event.source).
+       * 3. Rejects all other origins and unpinned sandboxed iframes.
+       *
+       * @param {MessageEvent} event
+       */
+      function handleIncomingMessage(event) {
+        if (!event || typeof event.origin !== 'string') {
+          return { accepted: false, reason: 'invalid-event' };
+        }
+
+        // Route 1: Sandboxed iframe messages (opaque origin "null")
+        if (event.origin === 'null') {
+          const widgetResult = handleSandboxedWidgetMessage(event);
+          messageHistory.push({
+            origin: event.origin,
+            accepted: widgetResult.accepted,
+            category: widgetResult.category,
+            reason: widgetResult.reason
+          });
+          return widgetResult;
+        }
+
+        // Route 2: Cross-window messages from the trusted ordering origin
+        if (isTrustedOrderingOrigin(event.origin)) {
+          const data = event.data;
+          if (data === null || data === undefined || (typeof data !== 'object' && typeof data !== 'string')) {
+            const invalidPayloadMsg = 'Rejected malformed payload from trusted ordering origin.';
+            updateOrderingUI(false, invalidPayloadMsg, event.origin);
+            const invalidResult = {
+              accepted: false,
+              category: 'ordering',
+              reason: 'invalid-payload'
+            };
+            messageHistory.push({
+              origin: event.origin,
+              accepted: false,
+              category: 'ordering',
+              reason: invalidResult.reason
+            });
+            return invalidResult;
+          }
+
+          const summary = formatPayloadText(data);
+          updateOrderingUI(true, summary, event.origin);
+          const acceptedResult = {
+            accepted: true,
+            category: 'ordering',
+            reason: 'verified-trusted-ordering-origin',
+            origin: event.origin,
+            data: data
+          };
+          messageHistory.push({
+            origin: event.origin,
+            accepted: true,
+            category: 'ordering',
+            reason: acceptedResult.reason
+          });
+          return acceptedResult;
+        }
+
+        // Route 3: Reject all untrusted origins
+        const rejectedMsg = 'Rejected message from untrusted origin: ' + event.origin;
+        updateOrderingUI(false, rejectedMsg, event.origin);
+        const rejectedResult = {
+          accepted: false,
+          category: 'untrusted-origin',
+          reason: 'untrusted-origin',
+          origin: event.origin
+        };
+        messageHistory.push({
+          origin: event.origin,
+          accepted: false,
+          category: 'untrusted-origin',
+          reason: rejectedResult.reason
+        });
+        return rejectedResult;
+      }
+
+      /**
+       * Updates the redirect validation status banner in the DOM.
+       */
+      function updateRedirectUI(validationResult, rawInput) {
+        const banner = document.getElementById('redirect-status-banner');
+        const msgEl = document.getElementById('redirect-status-message');
+        const logoutLink = document.getElementById('logout-link');
+
+        if (banner) {
+          banner.className = validationResult.valid ? 'status-banner accepted' : 'status-banner rejected';
+          banner.dataset.valid = validationResult.valid ? 'true' : 'false';
+          banner.dataset.resolvedUrl = validationResult.url;
+          banner.dataset.reason = validationResult.reason;
+        }
+
+        if (msgEl) {
+          if (validationResult.valid) {
+            msgEl.textContent = 'Accepted same-site redirect: ' + validationResult.url;
+          } else {
+            msgEl.textContent =
+              'Blocked unsafe/cross-site redirect (' +
+              String(rawInput || '') +
+              ' -> reason: ' +
+              validationResult.reason +
+              '). Falling back to ' +
+              validationResult.url;
+          }
+        }
+
+        if (logoutLink) {
+          logoutLink.dataset.redirect = validationResult.url;
+          logoutLink.dataset.redirectValid = validationResult.valid ? 'true' : 'false';
+        }
+      }
+
+      /**
+       * Inspects page query parameters (redirect, returnTo, return_to, returnUrl, next, continue, url)
+       * and validates any requested redirect destination on load.
+       */
+      function processInitialRedirectParams() {
+        try {
+          const params = new URLSearchParams(window.location.search);
+          const paramKeys = ['redirect', 'returnTo', 'return_to', 'returnUrl', 'next', 'continue', 'url'];
+          for (let i = 0; i < paramKeys.length; i++) {
+            const key = paramKeys[i];
+            if (params.has(key)) {
+              const rawTarget = params.get(key) || '';
+              const inputEl = document.getElementById('redirect-url-input');
+              if (inputEl) {
+                inputEl.value = rawTarget;
+              }
+              const result = validateSameSiteRedirect(rawTarget, DEFAULT_SAFE_REDIRECT_PATH);
+              updateRedirectUI(result, rawTarget);
+              return result;
+            }
+          }
+        } catch (_err) {
+          // Ignore URLSearchParams errors
+        }
+        return null;
+      }
+
+      /**
+       * Resets the pinned sandboxed widget source (useful for re-initialization tests).
+       */
+      function resetWidgetPin() {
+        pinnedWidgetSource = null;
+        const banner = document.getElementById('widget-status-banner');
+        const badge = document.getElementById('widget-pin-badge');
+        const msgEl = document.getElementById('widget-status-message');
+        if (banner) {
+          banner.className = 'status-banner';
+          banner.dataset.pinned = 'false';
+        }
+        if (badge) {
+          badge.className = 'badge';
+          badge.textContent = 'Pinning Pending';
+        }
+        if (msgEl) {
+          msgEl.textContent = 'Waiting for widget initialization...';
+        }
+      }
+
+      function getPinnedWidgetSource() {
+        return pinnedWidgetSource;
+      }
+
+      function getMessageHistory() {
+        return messageHistory.slice();
+      }
+
+      // Attach cross-window message listener immediately so widget initialization is captured
+      window.addEventListener('message', handleIncomingMessage);
+
+      // Initialize link validation, redirect parameter validation, and UI controls
+      function initPageSecurity() {
+        validateAndHardenLinks(document);
+        processInitialRedirectParams();
+
+        const validateBtn = document.getElementById('validate-redirect-btn');
+        const redirectInput = document.getElementById('redirect-url-input');
+        if (validateBtn && redirectInput) {
+          validateBtn.addEventListener('click', function () {
+            const rawValue = redirectInput.value;
+            const result = validateSameSiteRedirect(rawValue, DEFAULT_SAFE_REDIRECT_PATH);
+            updateRedirectUI(result, rawValue);
+          });
+        }
+
+        // Delegated click listener to validate redirect links and dynamic external links
+        document.addEventListener('click', function (event) {
+          const anchor = event.target && typeof event.target.closest === 'function'
+            ? event.target.closest('a')
+            : null;
+          if (!anchor) {
+            return;
+          }
+
+          const rawHref = anchor.getAttribute('href') || '';
+          const linkCheck = classifyAndValidateLink(rawHref);
+          if (!linkCheck.valid) {
+            event.preventDefault();
+            anchor.dataset.linkType = 'blocked';
+            anchor.dataset.linkValid = 'false';
+            return;
+          }
+
+          if (linkCheck.isExternal) {
+            if (anchor.relList && typeof anchor.relList.add === 'function') {
+              anchor.relList.add('noopener', 'noreferrer');
+            } else {
+              anchor.setAttribute('rel', 'noopener noreferrer');
+            }
+            anchor.setAttribute('target', '_blank');
+            anchor.setAttribute('referrerpolicy', 'no-referrer');
+          }
+
+          if (anchor.classList.contains('logout-link') || anchor.hasAttribute('data-redirect')) {
+            const candidateRedirect = anchor.getAttribute('data-redirect') || rawHref;
+            const redirectResult = validateSameSiteRedirect(candidateRedirect, DEFAULT_SAFE_REDIRECT_PATH);
+            updateRedirectUI(redirectResult, candidateRedirect);
+            if (!redirectResult.valid) {
+              event.preventDefault();
+            }
+          }
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPageSecurity);
+      } else {
+        initPageSecurity();
+      }
+
+      // Expose security validation API on window for programmatic callers and tests
+      const securityApi = {
+        SITE_DOMAIN: SITE_DOMAIN,
+        TRUSTED_ORDERING_ORIGIN: TRUSTED_ORDERING_ORIGIN,
+        DEFAULT_SAFE_REDIRECT_PATH: DEFAULT_SAFE_REDIRECT_PATH,
+        isTrustedOrderingOrigin: isTrustedOrderingOrigin,
+        isSameSiteHostname: isSameSiteHostname,
+        isSameSiteUrl: isSameSiteUrl,
+        validateSameSiteRedirect: validateSameSiteRedirect,
+        getSafeRedirectUrl: getSafeRedirectUrl,
+        classifyAndValidateLink: classifyAndValidateLink,
+        validateAndHardenLinks: validateAndHardenLinks,
+        isWidgetInitMessage: isWidgetInitMessage,
+        handleSandboxedWidgetMessage: handleSandboxedWidgetMessage,
+        handleIncomingMessage: handleIncomingMessage,
+        getPinnedWidgetSource: getPinnedWidgetSource,
+        resetWidgetPin: resetWidgetPin,
+        getMessageHistory: getMessageHistory
+      };
+
+      window.DailyGrindSecurity = securityApi;
+      window.SITE_DOMAIN = SITE_DOMAIN;
+      window.TRUSTED_ORDERING_ORIGIN = TRUSTED_ORDERING_ORIGIN;
+      window.isTrustedOrderingOrigin = isTrustedOrderingOrigin;
+      window.isSameSiteHostname = isSameSiteHostname;
+      window.isSameSiteUrl = isSameSiteUrl;
+      window.validateSameSiteRedirect = validateSameSiteRedirect;
+      window.getSafeRedirectUrl = getSafeRedirectUrl;
+      window.classifyAndValidateLink = classifyAndValidateLink;
+      window.validateAndHardenLinks = validateAndHardenLinks;
+      window.handleSandboxedWidgetMessage = handleSandboxedWidgetMessage;
+      window.handleIncomingMessage = handleIncomingMessage;
+      window.getPinnedWidgetSource = getPinnedWidgetSource;
+      window.resetWidgetPin = resetWidgetPin;
+    })();
+  </script>
+
 </body>
 
