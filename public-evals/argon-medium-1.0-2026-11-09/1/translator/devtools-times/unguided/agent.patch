diff --git a/src/components/ArticleTranslator.tsx b/src/components/ArticleTranslator.tsx
new file mode 100644
index 0000000..d50cdde
--- /dev/null
+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,360 @@
+import React, { useEffect, useState } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  subscribeTranslationState,
+  getTranslationState,
+  updateTranslationPreferences,
+  swapTranslationLanguages,
+  translatePageContent,
+  restorePageContent,
+  cancelActiveTranslation,
+  getLanguageName,
+  getLanguageShortName,
+  type TranslationState,
+  type ModelAvailability,
+} from '../utils/translator';
+
+interface ArticleTranslatorProps {
+  articleId: string;
+}
+
+const QUICK_LANGUAGES = [
+  { code: 'es', label: 'Español' },
+  { code: 'fr', label: 'Français' },
+  { code: 'de', label: 'Deutsch' },
+  { code: 'ja', label: '日本語' },
+  { code: 'pt', label: 'Português' },
+  { code: 'zh', label: '简体中文' },
+];
+
+function getStatusConfig(availability: ModelAvailability, downloadProgress: number | null) {
+  switch (availability) {
+    case 'available':
+      return {
+        text: 'Ready on-device',
+        dot: 'bg-emerald-500',
+        pill: 'bg-emerald-50 text-emerald-800 border-emerald-200',
+      };
+    case 'downloadable':
+      return {
+        text: 'Language pack downloadable',
+        dot: 'bg-amber-500',
+        pill: 'bg-amber-50 text-amber-800 border-amber-200',
+      };
+    case 'downloading':
+      return {
+        text:
+          downloadProgress !== null
+            ? `Downloading model (${downloadProgress}%)`
+            : 'Downloading model...',
+        dot: 'bg-blue-500 animate-pulse',
+        pill: 'bg-blue-50 text-blue-800 border-blue-200',
+      };
+    case 'same-language':
+      return {
+        text: 'Source & target match',
+        dot: 'bg-gray-400',
+        pill: 'bg-gray-100 text-gray-600 border-gray-200',
+      };
+    case 'unavailable':
+      return {
+        text: 'Language pair unavailable',
+        dot: 'bg-red-500',
+        pill: 'bg-red-50 text-red-700 border-red-200',
+      };
+    case 'unsupported':
+      return {
+        text: 'Browser Translator API unavailable',
+        dot: 'bg-gray-400',
+        pill: 'bg-gray-100 text-gray-600 border-gray-200',
+      };
+    default:
+      return {
+        text: 'Checking model...',
+        dot: 'bg-gray-400 animate-pulse',
+        pill: 'bg-gray-50 text-gray-600 border-gray-200',
+      };
+  }
+}
+
+export default function ArticleTranslator({ articleId }: ArticleTranslatorProps) {
+  const [state, setState] = useState<TranslationState>(getTranslationState());
+  const [includeRelatedTeasers, setIncludeRelatedTeasers] = useState(true);
+  const [articleLang, setArticleLang] = useState<string>('en');
+
+  useEffect(() => {
+    const unsubscribe = subscribeTranslationState((next) => {
+      setState(next);
+    });
+
+    const syncArticleLang = () => {
+      if (typeof document === 'undefined') return;
+      const articleEl = document.querySelector<HTMLElement>(
+        `[data-translatable-article="${articleId}"], [data-translatable-article]`
+      );
+      setArticleLang(articleEl?.dataset.currentLang || 'en');
+    };
+
+    syncArticleLang();
+    window.addEventListener('devtools-times:translation-updated', syncArticleLang);
+    return () => {
+      unsubscribe();
+      window.removeEventListener('devtools-times:translation-updated', syncArticleLang);
+    };
+  }, [articleId]);
+
+  const isArticleTranslated = articleLang !== 'en' || Boolean(state.activeLanguage);
+  const status = getStatusConfig(state.availability, state.downloadProgress);
+  const progressPct =
+    state.totalCount > 0 ? Math.round((state.translatedCount / state.totalCount) * 100) : 0;
+
+  const handleTranslate = async (overrideTargetLang?: string) => {
+    const targetLanguage = overrideTargetLang || state.targetLanguage;
+    await translatePageContent({
+      sourceLanguage: state.sourceLanguage,
+      targetLanguage,
+      scope: includeRelatedTeasers ? 'all' : 'article',
+    });
+  };
+
+  return (
+    <section
+      aria-label="On-device article translation"
+      data-testid="article-translation-control"
+      className="my-5 rounded-lg border border-gray-200 bg-gray-50/90 p-4 shadow-xs"
+    >
+      {/* Top Row: Label, Active Translation Status, and Model Availability */}
+      <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
+        <div className="flex items-center gap-2">
+          <span className="inline-flex items-center justify-center w-7 h-7 rounded-md bg-amber-100 text-amber-800">
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              className="w-4 h-4"
+              fill="none"
+              viewBox="0 0 24 24"
+              stroke="currentColor"
+              strokeWidth={2}
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+          </span>
+          <div>
+            <h2 className="text-sm font-bold text-gray-900 leading-none">
+              On-Device Article Translation
+            </h2>
+            <p className="text-xs text-gray-500 mt-0.5">
+              Translate this article and teasers directly in your browser using built-in AI
+            </p>
+          </div>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2">
+          {isArticleTranslated && (
+            <span
+              data-testid="article-translated-badge"
+              className="inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300"
+            >
+              Viewing in {getLanguageName(state.activeLanguage || articleLang)}
+            </span>
+          )}
+          <span
+            data-testid="article-availability-badge"
+            className={`inline-flex items-center text-xs font-medium px-2.5 py-0.5 rounded-full border ${status.pill}`}
+          >
+            <span className={`w-1.5 h-1.5 rounded-full mr-1.5 ${status.dot}`} />
+            {status.text}
+          </span>
+        </div>
+      </div>
+
+      {/* Controls Row: Source -> Swap -> Target + Action Buttons */}
+      <div className="flex flex-wrap items-center gap-2">
+        <div className="flex items-center gap-1.5 flex-wrap sm:flex-nowrap">
+          <label htmlFor="article-source-lang" className="text-xs font-medium text-gray-600">
+            From
+          </label>
+          <select
+            id="article-source-lang"
+            aria-label="Translate article from language"
+            data-testid="article-source-language"
+            value={state.sourceLanguage}
+            disabled={state.isTranslating}
+            onChange={(e) => updateTranslationPreferences({ sourceLanguage: e.target.value })}
+            className="text-xs sm:text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+          >
+            <option value="auto">
+              Auto-detect
+              {state.detectedSourceLanguage
+                ? ` (${getLanguageShortName(state.detectedSourceLanguage)})`
+                : ''}
+            </option>
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={`art-src-${lang.code}`} value={lang.code}>
+                {lang.name} ({lang.nativeName})
+              </option>
+            ))}
+          </select>
+
+          <button
+            type="button"
+            onClick={() => swapTranslationLanguages()}
+            disabled={state.isTranslating}
+            aria-label="Swap article translation languages"
+            data-testid="article-swap-languages"
+            title="Swap source and target languages"
+            className="p-1.5 rounded-md border border-gray-300 bg-white text-gray-700 hover:text-amber-600 hover:border-amber-400 transition-colors disabled:opacity-40 cursor-pointer"
+          >
+            <svg
+              xmlns="http://www.w3.org/2000/svg"
+              className="w-4 h-4"
+              fill="none"
+              viewBox="0 0 24 24"
+              stroke="currentColor"
+              strokeWidth={2}
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+              />
+            </svg>
+          </button>
+
+          <label htmlFor="article-target-lang" className="text-xs font-medium text-gray-600">
+            To
+          </label>
+          <select
+            id="article-target-lang"
+            aria-label="Translate article to language"
+            data-testid="article-target-language"
+            value={state.targetLanguage}
+            disabled={state.isTranslating}
+            onChange={(e) => updateTranslationPreferences({ targetLanguage: e.target.value })}
+            className="text-xs sm:text-sm border border-gray-300 rounded-md px-2.5 py-1.5 bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={`art-tgt-${lang.code}`} value={lang.code}>
+                {lang.name} ({lang.nativeName})
+              </option>
+            ))}
+          </select>
+        </div>
+
+        {/* Action Buttons */}
+        <div className="flex items-center gap-2 ml-auto">
+          {state.isTranslating ? (
+            <button
+              type="button"
+              onClick={() => cancelActiveTranslation()}
+              data-testid="article-cancel-button"
+              className="inline-flex items-center text-xs sm:text-sm font-semibold px-3.5 py-1.5 rounded-md bg-amber-600 text-white hover:bg-amber-700 transition-colors cursor-pointer"
+            >
+              <span className="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin mr-2" />
+              Cancel
+            </button>
+          ) : (
+            <button
+              type="button"
+              onClick={() => handleTranslate()}
+              disabled={state.availability === 'same-language'}
+              data-testid="article-translate-button"
+              className="inline-flex items-center text-xs sm:text-sm font-semibold px-3.5 py-1.5 rounded-md bg-gray-900 text-white hover:bg-amber-600 transition-colors disabled:opacity-40 cursor-pointer"
+            >
+              {isArticleTranslated ? 'Re-translate' : 'Translate Article'}
+            </button>
+          )}
+
+          {isArticleTranslated && (
+            <button
+              type="button"
+              onClick={() => restorePageContent()}
+              data-testid="article-restore-button"
+              className="inline-flex items-center text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-md border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Quick Target Language Chips & Include Teasers Checkbox */}
+      <div className="mt-3 pt-2.5 border-t border-gray-200/80 flex flex-wrap items-center justify-between gap-2">
+        <div className="flex flex-wrap items-center gap-1.5">
+          <span className="text-[11px] font-medium text-gray-500 mr-1">Quick translate:</span>
+          {QUICK_LANGUAGES.map((q) => {
+            const isSelected = state.targetLanguage === q.code && isArticleTranslated;
+            return (
+              <button
+                key={q.code}
+                type="button"
+                disabled={state.isTranslating}
+                onClick={() => handleTranslate(q.code)}
+                data-testid={`quick-translate-${q.code}`}
+                className={`text-xs px-2 py-0.5 rounded border transition-colors cursor-pointer ${
+                  isSelected
+                    ? 'bg-amber-500 text-white border-amber-500 font-semibold'
+                    : 'bg-white text-gray-700 border-gray-200 hover:border-amber-400 hover:text-amber-700'
+                } disabled:opacity-40`}
+              >
+                {q.label}
+              </button>
+            );
+          })}
+        </div>
+
+        <label className="inline-flex items-center text-xs text-gray-600 cursor-pointer select-none">
+          <input
+            type="checkbox"
+            checked={includeRelatedTeasers}
+            onChange={(e) => setIncludeRelatedTeasers(e.target.checked)}
+            className="rounded border-gray-300 text-amber-600 focus:ring-amber-500 mr-1.5"
+          />
+          Also translate related teasers
+        </label>
+      </div>
+
+      {/* Progress Bar */}
+      {state.isTranslating && (
+        <div className="mt-3" data-testid="article-translation-progress">
+          <div className="flex justify-between text-xs text-gray-600 mb-1">
+            <span>
+              {state.downloadProgress !== null
+                ? `Downloading on-device language model (${state.downloadProgress}%)...`
+                : `Translating article segments on-device...`}
+            </span>
+            <span className="font-semibold">
+              {state.downloadProgress !== null
+                ? `${state.downloadProgress}%`
+                : `${state.translatedCount} / ${state.totalCount} (${progressPct}%)`}
+            </span>
+          </div>
+          <div className="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
+            <div
+              className="h-full bg-amber-500 transition-all duration-200"
+              style={{
+                width: `${
+                  state.downloadProgress !== null ? state.downloadProgress : progressPct
+                }%`,
+              }}
+            />
+          </div>
+        </div>
+      )}
+
+      {/* Error Message */}
+      {state.error && (
+        <div
+          role="alert"
+          data-testid="article-translation-error"
+          className="mt-3 text-xs text-red-800 bg-red-50 border border-red-200 rounded-md px-3 py-2"
+        >
+          {state.error}
+        </div>
+      )}
+    </section>
+  );
+}
