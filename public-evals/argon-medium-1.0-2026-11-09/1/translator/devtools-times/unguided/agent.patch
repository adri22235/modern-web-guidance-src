+        create: (options: TranslatorCreateOptions) => Promise<BuiltInTranslator>;
+      };
+      languageDetector?: {
+        availability?: () => Promise<BuiltInAIAvailability>;
+        capabilities?: () => Promise<{ available: BuiltInAIAvailability }>;
+        create: (options?: {
+          signal?: AbortSignal;
+          monitor?: (monitor: AICreateMonitor) => void;
+        }) => Promise<BuiltInLanguageDetector>;
+      };
+    };
+    translation?: {
+      canTranslate?: (options: TranslatorCreateCoreOptions) => Promise<BuiltInAIAvailability>;
+      createTranslator?: (options: TranslatorCreateOptions) => Promise<BuiltInTranslator>;
+      canDetect?: () => Promise<BuiltInAIAvailability>;
+      createDetector?: () => Promise<BuiltInLanguageDetector>;
+    };
   }
 }
 
