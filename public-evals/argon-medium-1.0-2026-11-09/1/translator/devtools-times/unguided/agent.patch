+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,281 @@
+import React, { useEffect, useState } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  subscribeTranslationState,
+  getTranslationState,
+  updateTranslationPreferences,
+  swapTranslationLanguages,
+  translatePageContent,
+  restorePageContent,
+  cancelActiveTranslation,
+  refreshAvailability,
+  handlePageNavigation,
+  getLanguageShortName,
+  type TranslationState,
+  type ModelAvailability,
+} from '../utils/translator';
+
+function getAvailabilityBadge(availability: ModelAvailability, downloadProgress: number | null) {
+  switch (availability) {
+    case 'available':
+      return {
+        label: 'Ready on-device',
+        dotClass: 'bg-emerald-500',
+        badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200',
+      };
+    case 'downloadable':
+      return {
+        label: 'Model downloadable',
+        dotClass: 'bg-amber-500',
+        badgeClass: 'bg-amber-50 text-amber-800 border-amber-200',
+      };
+    case 'downloading':
+      return {
+        label:
+          downloadProgress !== null ? `Downloading ${downloadProgress}%` : 'Downloading model...',
+        dotClass: 'bg-blue-500 animate-pulse',
+        badgeClass: 'bg-blue-50 text-blue-800 border-blue-200',
+      };
+    case 'same-language':
+      return {
+        label: 'Same language',
+        dotClass: 'bg-gray-400',
+        badgeClass: 'bg-gray-100 text-gray-600 border-gray-200',
+      };
+    case 'unavailable':
+      return {
+        label: 'Pair unavailable',
+        dotClass: 'bg-red-500',
+        badgeClass: 'bg-red-50 text-red-700 border-red-200',
+      };
+    case 'unsupported':
+      return {
+        label: 'Translator API unavailable',
+        dotClass: 'bg-gray-400',
+        badgeClass: 'bg-gray-100 text-gray-600 border-gray-200',
+      };
+    default:
+      return {
+        label: 'Checking model...',
+        dotClass: 'bg-gray-400 animate-pulse',
+        badgeClass: 'bg-gray-50 text-gray-600 border-gray-200',
+      };
+  }
+}
+
+export default function TranslationControl() {
+  const [state, setState] = useState<TranslationState>(getTranslationState());
+  const [hasAnyTranslatedDom, setHasAnyTranslatedDom] = useState(false);
+
+  useEffect(() => {
+    const unsubscribe = subscribeTranslationState((next) => {
+      setState(next);
+    });
+    refreshAvailability();
+
+    const checkDomTranslated = () => {
+      if (typeof document === 'undefined') return;
+      const translatedNodes = document.querySelectorAll(
+        '[data-current-lang]:not([data-current-lang="en"])'
+      );
+      setHasAnyTranslatedDom(translatedNodes.length > 0);
+    };
+
+    const onPageLoad = () => {
+      handlePageNavigation();
+      checkDomTranslated();
+    };
+
+    window.addEventListener('devtools-times:translation-updated', checkDomTranslated);
+    document.addEventListener('astro:page-load', onPageLoad);
+
+    return () => {
+      unsubscribe();
+      window.removeEventListener('devtools-times:translation-updated', checkDomTranslated);
+      document.removeEventListener('astro:page-load', onPageLoad);
+    };
+  }, []);
+
+  const badge = getAvailabilityBadge(state.availability, state.downloadProgress);
+  const isTranslated = Boolean(state.activeLanguage) || hasAnyTranslatedDom;
+  const progressPercent =
+    state.totalCount > 0 ? Math.round((state.translatedCount / state.totalCount) * 100) : 0;
+
+  return (
+    <div
+      className="flex flex-col"
+      data-testid="header-translation-control"
+      aria-label="On-device article and teaser translation control"
+    >
+      <div className="flex flex-wrap items-center gap-1.5 sm:gap-2">
+        {/* Icon + Label */}
+        <span className="inline-flex items-center text-xs font-semibold text-gray-700 mr-0.5">
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="w-4 h-4 mr-1 text-amber-600 flex-shrink-0"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <span className="hidden md:inline">Translate:</span>
+        </span>
+
+        {/* Source Language Selector */}
+        <select
+          aria-label="Source language"
+          data-testid="header-source-language"
+          value={state.sourceLanguage}
+          disabled={state.isTranslating}
+          onChange={(e) => updateTranslationPreferences({ sourceLanguage: e.target.value })}
+          className="text-xs border border-gray-300 rounded px-2 py-1 bg-white text-gray-800 focus:outline-none focus:ring-1 focus:ring-amber-500 focus:border-amber-500 disabled:opacity-50"
+        >
+          <option value="auto">
+            Auto-detect
+            {state.detectedSourceLanguage
+              ? ` (${getLanguageShortName(state.detectedSourceLanguage)})`
+              : ''}
+          </option>
+          {SUPPORTED_LANGUAGES.map((lang) => (
+            <option key={`src-${lang.code}`} value={lang.code}>
+              {lang.name} ({lang.code.toUpperCase()})
+            </option>
+          ))}
+        </select>
+
+        {/* Swap Languages Button */}
+        <button
+          type="button"
+          onClick={() => swapTranslationLanguages()}
+          disabled={state.isTranslating}
+          aria-label="Swap languages"
+          data-testid="header-swap-languages"
+          title="Swap source and target languages"
+          className="p-1 text-gray-600 hover:text-amber-600 hover:bg-gray-100 rounded border border-gray-200 transition-colors disabled:opacity-40"
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="w-3.5 h-3.5"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+            />
+          </svg>
+        </button>
+
+        {/* Target Language Selector */}
+        <select
+          aria-label="Target language"
+          data-testid="header-target-language"
+          value={state.targetLanguage}
+          disabled={state.isTranslating}
+          onChange={(e) => updateTranslationPreferences({ targetLanguage: e.target.value })}
+          className="text-xs border border-gray-300 rounded px-2 py-1 bg-white text-gray-800 focus:outline-none focus:ring-1 focus:ring-amber-500 focus:border-amber-500 disabled:opacity-50"
+        >
+          {SUPPORTED_LANGUAGES.map((lang) => (
+            <option key={`tgt-${lang.code}`} value={lang.code}>
+              {lang.name} ({lang.nativeName})
+            </option>
+          ))}
+        </select>
+
+        {/* Availability Status Indicator */}
+        <span
+          data-testid="header-availability-badge"
+          className={`hidden lg:inline-flex items-center text-[11px] font-medium px-2 py-0.5 rounded-full border ${badge.badgeClass}`}
+          title={`On-device model status: ${badge.label}`}
+        >
+          <span className={`w-1.5 h-1.5 rounded-full mr-1.5 ${badge.dotClass}`} />
+          {badge.label}
+        </span>
+
+        {/* Translate Action / Cancel Button */}
+        {state.isTranslating ? (
+          <button
+            type="button"
+            onClick={() => cancelActiveTranslation()}
+            data-testid="header-cancel-translation"
+            className="inline-flex items-center text-xs font-semibold py-1 px-2.5 rounded bg-amber-600 text-white hover:bg-amber-700 transition-colors cursor-pointer"
+          >
+            <span className="w-3 h-3 border-2 border-white border-t-transparent rounded-full animate-spin mr-1.5" />
+            <span>
+              {state.downloadProgress !== null
+                ? `Model ${state.downloadProgress}%`
+                : `${state.translatedCount}/${state.totalCount}`}
+            </span>
+            <span className="ml-1.5 underline text-[10px]">Stop</span>
+          </button>
+        ) : (
+          <button
+            type="button"
+            onClick={() => translatePageContent({ scope: 'all' })}
+            disabled={state.availability === 'same-language'}
+            data-testid="header-translate-button"
+            className="inline-flex items-center text-xs font-semibold py-1 px-2.5 rounded bg-gray-900 text-white hover:bg-amber-600 transition-colors disabled:opacity-40 cursor-pointer"
+          >
+            Translate
+          </button>
+        )}
+
+        {/* Restore Original Button */}
+        {isTranslated && (
+          <button
+            type="button"
+            onClick={() => restorePageContent()}
+            data-testid="header-restore-button"
+            className="inline-flex items-center text-xs font-semibold py-1 px-2 rounded border border-gray-300 bg-gray-50 text-gray-700 hover:bg-gray-200 transition-colors cursor-pointer"
+            title="Restore original language across the page"
+          >
+            Show Original
+          </button>
+        )}
+      </div>
+
+      {/* Progress or Error Strip */}
+      {(state.isTranslating || state.error) && (
+        <div className="mt-1.5 text-xs">
+          {state.isTranslating && (
+            <div className="flex items-center gap-2">
+              <div className="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden">
+                <div
+                  className="bg-amber-500 h-full transition-all duration-200"
+                  style={{
+                    width: `${
+                      state.downloadProgress !== null ? state.downloadProgress : progressPercent
+                    }%`,
+                  }}
+                />
+              </div>
+              <span className="text-[11px] text-gray-600 whitespace-nowrap">
+                {state.downloadProgress !== null
+                  ? `Downloading pack (${state.downloadProgress}%)`
+                  : `Translating ${state.translatedCount}/${state.totalCount}`}
+              </span>
+            </div>
+          )}
+          {state.error && (
+            <div
+              role="alert"
+              data-testid="header-translation-error"
+              className="text-[11px] text-red-700 bg-red-50 border border-red-200 rounded px-2 py-1 flex items-center justify-between gap-2"
+            >
+              <span>{state.error}</span>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
