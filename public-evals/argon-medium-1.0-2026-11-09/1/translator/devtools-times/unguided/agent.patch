diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..e76e51a
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,785 @@
+import type { BuiltInTranslator, AICreateMonitor } from '../../global';
+
+export interface LanguageOption {
+  code: string;
+  name: string;
+  nativeName: string;
+  dir?: 'ltr' | 'rtl';
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', name: 'English', nativeName: 'English' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español' },
+  { code: 'fr', name: 'French', nativeName: 'Français' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano' },
+  { code: 'zh', name: 'Chinese (Simplified)', nativeName: '简体中文' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)', nativeName: '繁體中文' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية', dir: 'rtl' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands' },
+  { code: 'tr', name: 'Turkish', nativeName: 'Türkçe' },
+  { code: 'pl', name: 'Polish', nativeName: 'Polski' },
+  { code: 'vi', name: 'Vietnamese', nativeName: 'Tiếng Việt' },
+  { code: 'id', name: 'Indonesian', nativeName: 'Bahasa Indonesia' },
+  { code: 'th', name: 'Thai', nativeName: 'ไทย' },
+  { code: 'uk', name: 'Ukrainian', nativeName: 'Українська' },
+  { code: 'sv', name: 'Swedish', nativeName: 'Svenska' },
+];
+
+export type ModelAvailability =
+  | 'available'
+  | 'downloadable'
+  | 'downloading'
+  | 'unavailable'
+  | 'unsupported'
+  | 'same-language'
+  | 'checking';
+
+export interface TranslationState {
+  sourceLanguage: string; // 'auto' or BCP-47 code
+  targetLanguage: string; // BCP-47 code
+  detectedSourceLanguage: string | null;
+  activeLanguage: string | null; // Current language the page is translated into, or null if original
+  availability: ModelAvailability;
+  isTranslating: boolean;
+  downloadProgress: number | null; // 0..100 when downloading model
+  translatedCount: number;
+  totalCount: number;
+  autoTranslateOnNavigate: boolean;
+  error: string | null;
+}
+
+const STORAGE_KEY = 'devtools-times-translation-prefs';
+
+const originalContentMap = new WeakMap<HTMLElement, { html: string; text: string }>();
+const translatorCache = new Map<string, BuiltInTranslator>();
+
+let activeAbortController: AbortController | null = null;
+const listeners = new Set<(state: TranslationState) => void>();
+
+function getInitialPreferences(): {
+  sourceLanguage: string;
+  targetLanguage: string;
+  autoTranslateOnNavigate: boolean;
+} {
+  if (typeof window === 'undefined') {
+    return { sourceLanguage: 'en', targetLanguage: 'es', autoTranslateOnNavigate: false };
+  }
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      return {
+        sourceLanguage: parsed.sourceLanguage || 'en',
+        targetLanguage: parsed.targetLanguage || 'es',
+        autoTranslateOnNavigate: Boolean(parsed.autoTranslateOnNavigate),
+      };
+    }
+  } catch {
+    // ignore storage errors
+  }
+
+  // Pick browser preferred language if it's non-English and supported
+  const navLang = typeof navigator !== 'undefined' ? navigator.language?.split('-')[0] : '';
+  const matched = SUPPORTED_LANGUAGES.find((l) => l.code === navLang && l.code !== 'en');
+
+  return {
+    sourceLanguage: 'en',
+    targetLanguage: matched ? matched.code : 'es',
+    autoTranslateOnNavigate: false,
+  };
+}
+
+const initialPrefs = getInitialPreferences();
+
+let state: TranslationState = {
+  sourceLanguage: initialPrefs.sourceLanguage,
+  targetLanguage: initialPrefs.targetLanguage,
+  detectedSourceLanguage: null,
+  activeLanguage: null,
+  availability: 'checking',
+  isTranslating: false,
+  downloadProgress: null,
+  translatedCount: 0,
+  totalCount: 0,
+  autoTranslateOnNavigate: initialPrefs.autoTranslateOnNavigate,
+  error: null,
+};
+
+function savePreferences() {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.setItem(
+      STORAGE_KEY,
+      JSON.stringify({
+        sourceLanguage: state.sourceLanguage,
+        targetLanguage: state.targetLanguage,
+        autoTranslateOnNavigate: state.autoTranslateOnNavigate,
+      })
+    );
+  } catch {
+    // ignore storage errors
+  }
+}
+
+function setState(partial: Partial<TranslationState>) {
+  state = { ...state, ...partial };
+  for (const listener of listeners) {
+    listener(state);
+  }
+}
+
+export function getTranslationState(): TranslationState {
+  return state;
+}
+
+export function subscribeTranslationState(listener: (state: TranslationState) => void): () => void {
+  listeners.add(listener);
+  listener(state);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function getLanguageName(code: string): string {
+  if (code === 'auto') return 'Auto-detect';
+  const found = SUPPORTED_LANGUAGES.find(
+    (l) => l.code.toLowerCase() === code.toLowerCase()
+  );
+  return found ? `${found.name} (${found.nativeName})` : code.toUpperCase();
+}
+
+export function getLanguageShortName(code: string): string {
+  if (code === 'auto') return 'Auto';
+  const found = SUPPORTED_LANGUAGES.find(
+    (l) => l.code.toLowerCase() === code.toLowerCase()
+  );
+  return found ? found.name : code.toUpperCase();
+}
+
+export function isRtlLanguage(code: string): boolean {
+  const found = SUPPORTED_LANGUAGES.find(
+    (l) => l.code.toLowerCase() === code.toLowerCase()
+  );
+  return found?.dir === 'rtl' || code === 'ar' || code === 'he' || code === 'fa' || code === 'ur';
+}
+
+export function isOnDeviceTranslatorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    'Translator' in window ||
+      window.ai?.translator ||
+      window.translation?.createTranslator
+  );
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    'LanguageDetector' in window ||
+      window.ai?.languageDetector ||
+      window.translation?.createDetector
+  );
+}
+
+function normalizeAvailability(raw: string | undefined | null): ModelAvailability {
+  switch (raw) {
+    case 'available':
+    case 'readily':
+      return 'available';
+    case 'downloadable':
+    case 'after-download':
+      return 'downloadable';
+    case 'downloading':
+      return 'downloading';
+    case 'unavailable':
+    case 'no':
+      return 'unavailable';
+    default:
+      return 'unavailable';
+  }
+}
+
+export async function checkLanguagePairAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<ModelAvailability> {
+  if (typeof window === 'undefined') return 'checking';
+  if (!isOnDeviceTranslatorSupported()) return 'unsupported';
+
+  const resolvedSource =
+    sourceLanguage === 'auto'
+      ? state.detectedSourceLanguage || state.activeLanguage || 'en'
+      : sourceLanguage;
+
+  if (resolvedSource.toLowerCase() === targetLanguage.toLowerCase()) {
+    return 'same-language';
+  }
+
+  try {
+    if ('Translator' in window && window.Translator?.availability) {
+      const res = await window.Translator.availability({
+        sourceLanguage: resolvedSource,
+        targetLanguage,
+      });
+      return normalizeAvailability(res);
+    }
+
+    if (window.ai?.translator) {
+      if (typeof window.ai.translator.availability === 'function') {
+        const res = await window.ai.translator.availability({
+          sourceLanguage: resolvedSource,
+          targetLanguage,
+        });
+        return normalizeAvailability(res);
+      }
+      if (typeof window.ai.translator.capabilities === 'function') {
+        const caps = await window.ai.translator.capabilities();
+        const res = caps.languagePairAvailable(resolvedSource, targetLanguage);
+        return normalizeAvailability(res);
+      }
+    }
+
+    if (window.translation?.canTranslate) {
+      const res = await window.translation.canTranslate({
+        sourceLanguage: resolvedSource,
+        targetLanguage,
+      });
+      return normalizeAvailability(res);
+    }
+  } catch (err) {
+    console.warn('Error checking Translator availability:', err);
+    return 'unavailable';
+  }
+
+  return 'unsupported';
+}
+
+export async function refreshAvailability() {
+  setState({ availability: 'checking' });
+  const availability = await checkLanguagePairAvailability(
+    state.sourceLanguage,
+    state.targetLanguage
+  );
+  setState({ availability });
+  return availability;
+}
+
+export async function updateTranslationPreferences(prefs: {
+  sourceLanguage?: string;
+  targetLanguage?: string;
+  autoTranslateOnNavigate?: boolean;
+}) {
+  const nextSource = prefs.sourceLanguage ?? state.sourceLanguage;
+  const nextTarget = prefs.targetLanguage ?? state.targetLanguage;
+  const nextAuto = prefs.autoTranslateOnNavigate ?? state.autoTranslateOnNavigate;
+
+  setState({
+    sourceLanguage: nextSource,
+    targetLanguage: nextTarget,
+    autoTranslateOnNavigate: nextAuto,
+    error: null,
+  });
+  savePreferences();
+  await refreshAvailability();
+}
+
+export async function swapTranslationLanguages() {
+  const currentSource =
+    state.sourceLanguage === 'auto'
+      ? state.detectedSourceLanguage || state.activeLanguage || 'en'
+      : state.sourceLanguage;
+  const currentTarget = state.targetLanguage;
+
+  // If the page is currently translated into currentTarget, swapping sets source = currentTarget
+  const nextSource = currentTarget;
+  const nextTarget = currentSource === currentTarget ? 'en' : currentSource;
+
+  await updateTranslationPreferences({
+    sourceLanguage: nextSource,
+    targetLanguage: nextTarget,
+  });
+}
+
+export async function detectTextLanguage(
+  sampleText: string,
+  fallbackLang = 'en'
+): Promise<string> {
+  const trimmed = sampleText.trim();
+  if (!trimmed || typeof window === 'undefined') return fallbackLang;
+
+  try {
+    let detector = null;
+    if ('LanguageDetector' in window && window.LanguageDetector?.create) {
+      detector = await window.LanguageDetector.create();
+    } else if (window.ai?.languageDetector?.create) {
+      detector = await window.ai.languageDetector.create();
+    } else if (window.translation?.createDetector) {
+      detector = await window.translation.createDetector();
+    }
+
+    if (detector) {
+      const results = await detector.detect(trimmed.slice(0, 800));
+      detector.destroy?.();
+      if (Array.isArray(results) && results.length > 0) {
+        const best = results.find(
+          (r) => r.detectedLanguage && r.detectedLanguage !== 'und' && (r.confidence ?? 1) > 0.15
+        );
+        if (best?.detectedLanguage) {
+          const matched = SUPPORTED_LANGUAGES.find(
+            (l) =>
+              l.code.toLowerCase() === best.detectedLanguage.toLowerCase() ||
+              l.code.toLowerCase() === best.detectedLanguage.split('-')[0].toLowerCase()
+          );
+          return matched ? matched.code : best.detectedLanguage;
+        }
+      }
+    }
+  } catch (err) {
+    console.warn('LanguageDetector fallback used:', err);
+  }
+
+  return fallbackLang;
+}
+
+export async function getOrCreateTranslator(options: {
+  sourceLanguage: string;
+  targetLanguage: string;
+  onDownloadProgress?: (percent: number) => void;
+  signal?: AbortSignal;
+}): Promise<BuiltInTranslator> {
+  const { sourceLanguage, targetLanguage, onDownloadProgress, signal } = options;
+  const cacheKey = `${sourceLanguage.toLowerCase()}->${targetLanguage.toLowerCase()}`;
+
+  const cached = translatorCache.get(cacheKey);
+  if (cached) {
+    return cached;
+  }
+
+  const monitor = (m: AICreateMonitor) => {
+    const handler = (e: ProgressEvent & { loaded: number; total?: number }) => {
+      if (!onDownloadProgress) return;
+      let pct = 0;
+      if (typeof e.loaded === 'number') {
+        if (typeof e.total === 'number' && e.total > 1) {
+          pct = Math.round((e.loaded / e.total) * 100);
+        } else if (e.loaded <= 1) {
+          pct = Math.round(e.loaded * 100);
+        } else {
+          pct = Math.min(100, Math.round(e.loaded));
+        }
+      }
+      onDownloadProgress(Math.max(0, Math.min(100, pct)));
+    };
+    m.addEventListener('downloadprogress', handler);
+  };
+
+  let translator: BuiltInTranslator | null = null;
+
+  if ('Translator' in window && window.Translator?.create) {
+    translator = await window.Translator.create({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor,
+    });
+  } else if (window.ai?.translator?.create) {
+    translator = await window.ai.translator.create({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor,
+    });
+  } else if (window.translation?.createTranslator) {
+    translator = await window.translation.createTranslator({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor,
+    });
+  }
+
+  if (!translator) {
+    throw new Error(
+      'On-device Translator API is not available in this browser. Please use Chrome with Built-in AI Translator enabled.'
+    );
+  }
+
+  translatorCache.set(cacheKey, translator);
+  return translator;
+}
+
+function ensureOriginalSaved(el: HTMLElement): { html: string; text: string } {
+  let saved = originalContentMap.get(el);
+  if (!saved) {
+    saved = {
+      html: el.innerHTML,
+      text: el.textContent || '',
+    };
+    originalContentMap.set(el, saved);
+    if (!el.dataset.originalText) {
+      el.dataset.originalText = saved.text;
+    }
+  }
+  return saved;
+}
+
+export function collectTranslatableLeafElements(container: ParentNode): HTMLElement[] {
+  const results: HTMLElement[] = [];
+  const seen = new Set<HTMLElement>();
+
+  const addElement = (el: HTMLElement) => {
+    if (seen.has(el)) return;
+    const text = (el.textContent || '').trim();
+    if (!text) return;
+    seen.add(el);
+    results.push(el);
+  };
+
+  // Direct parts inside the container
+  const partElements = container.querySelectorAll<HTMLElement>(
+    '[data-translate-part="category"], [data-translate-part="title"], [data-translate-part="summary"], [data-translate-part="caption"], [data-translate-part="section-title"]'
+  );
+  partElements.forEach(addElement);
+
+  // Body paragraphs / headings / list items inside [data-translate-part="body"]
+  const bodyContainers = container.querySelectorAll<HTMLElement>('[data-translate-part="body"]');
+  bodyContainers.forEach((bodyEl) => {
+    const blocks = bodyEl.querySelectorAll<HTMLElement>(
+      'p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption'
+    );
+    blocks.forEach((block) => {
+      if (block.closest('script, style, pre, code')) return;
+      // Avoid translating a parent block if it contains child blocks that will be translated
+      if (block.querySelector('p, h1, h2, h3, h4, h5, h6, li')) return;
+      addElement(block);
+    });
+  });
+
+  return results;
+}
+
+export async function translateSingleElement(
+  el: HTMLElement,
+  translator: BuiltInTranslator,
+  sourceLanguage: string,
+  targetLanguage: string,
+  signal?: AbortSignal
+): Promise<void> {
+  const original = ensureOriginalSaved(el);
+  const currentLang = (el.dataset.currentLang || 'en').toLowerCase();
+  const normalizedSource = sourceLanguage.toLowerCase();
+
+  // If translating from English ('en'), always use the pristine original English text.
+  // If translating from the currently active translated language (e.g. 'es' -> 'fr'), use current textContent.
+  const inputText =
+    normalizedSource === 'en'
+      ? original.text.trim()
+      : currentLang === normalizedSource
+      ? (el.textContent || original.text).trim()
+      : original.text.trim();
+
+  if (!inputText) return;
+
+  el.classList.add('opacity-60', 'transition-opacity', 'duration-150');
+  try {
+    const translated = await translator.translate(inputText, signal ? { signal } : undefined);
+    if (signal?.aborted) return;
+    if (translated && translated.trim()) {
+      el.textContent = translated;
+      el.dataset.currentLang = targetLanguage;
+      el.setAttribute('lang', targetLanguage);
+      el.setAttribute('dir', isRtlLanguage(targetLanguage) ? 'rtl' : 'ltr');
+    }
+  } finally {
+    el.classList.remove('opacity-60');
+  }
+}
+
+export function restoreContainer(container: ParentNode) {
+  const elements = collectTranslatableLeafElements(container);
+  elements.forEach((el) => {
+    const saved = originalContentMap.get(el);
+    if (saved) {
+      el.innerHTML = saved.html;
+    } else if (el.dataset.originalText) {
+      el.textContent = el.dataset.originalText;
+    }
+    el.dataset.currentLang = 'en';
+    el.removeAttribute('lang');
+    el.removeAttribute('dir');
+  });
+
+  if (container instanceof HTMLElement) {
+    container.dataset.currentLang = 'en';
+    container.removeAttribute('lang');
+    container.removeAttribute('dir');
+  }
+
+  const subContainers = container.querySelectorAll<HTMLElement>(
+    '[data-translatable-article], [data-translatable-teaser]'
+  );
+  subContainers.forEach((sub) => {
+    sub.dataset.currentLang = 'en';
+    sub.removeAttribute('lang');
+    sub.removeAttribute('dir');
+  });
+
+  if (typeof window !== 'undefined') {
+    window.dispatchEvent(new CustomEvent('devtools-times:translation-updated'));
+  }
+}
+
+export async function translateContainer(
+  container: HTMLElement,
+  options?: {
+    sourceLanguage?: string;
+    targetLanguage?: string;
+    onDownloadProgress?: (pct: number) => void;
+    onProgress?: (completed: number, total: number) => void;
+    signal?: AbortSignal;
+  }
+): Promise<void> {
+  const requestedSource = options?.sourceLanguage ?? state.sourceLanguage;
+  const targetLanguage = options?.targetLanguage ?? state.targetLanguage;
+
+  const elements = collectTranslatableLeafElements(container);
+  if (elements.length === 0) return;
+
+  // Ensure originals are saved before any language detection or mutation
+  elements.forEach(ensureOriginalSaved);
+
+  let resolvedSource = requestedSource;
+  if (requestedSource === 'auto') {
+    const sampleText = elements
+      .slice(0, 3)
+      .map((el) => el.textContent || '')
+      .join(' ');
+    const currentContainerLang = container.dataset.currentLang || 'en';
+    resolvedSource = await detectTextLanguage(sampleText, currentContainerLang);
+    setState({ detectedSourceLanguage: resolvedSource });
+  }
+
+  if (resolvedSource.toLowerCase() === targetLanguage.toLowerCase()) {
+    if (targetLanguage.toLowerCase() === 'en') {
+      restoreContainer(container);
+    }
+    return;
+  }
+
+  const translator = await getOrCreateTranslator({
+    sourceLanguage: resolvedSource,
+    targetLanguage,
+    onDownloadProgress: options?.onDownloadProgress,
+    signal: options?.signal,
+  });
+
+  let completed = 0;
+  const total = elements.length;
+  options?.onProgress?.(0, total);
+
+  for (const el of elements) {
+    if (options?.signal?.aborted) break;
+    await translateSingleElement(el, translator, resolvedSource, targetLanguage, options?.signal);
+    completed += 1;
+    options?.onProgress?.(completed, total);
+  }
+
+  if (!options?.signal?.aborted) {
+    container.dataset.currentLang = targetLanguage;
+    container.setAttribute('lang', targetLanguage);
+    container.setAttribute('dir', isRtlLanguage(targetLanguage) ? 'rtl' : 'ltr');
+    if (typeof window !== 'undefined') {
+      window.dispatchEvent(new CustomEvent('devtools-times:translation-updated'));
+    }
+  }
+}
+
+export function cancelActiveTranslation() {
+  if (activeAbortController) {
+    activeAbortController.abort();
+    activeAbortController = null;
+  }
+  setState({
+    isTranslating: false,
+    downloadProgress: null,
+  });
+}
+
+export async function translatePageContent(options?: {
+  sourceLanguage?: string;
+  targetLanguage?: string;
+  scope?: 'all' | 'article';
+}): Promise<void> {
+  if (typeof document === 'undefined') return;
+
+  cancelActiveTranslation();
+  const controller = new AbortController();
+  activeAbortController = controller;
+
+  const requestedSource = options?.sourceLanguage ?? state.sourceLanguage;
+  const targetLanguage = options?.targetLanguage ?? state.targetLanguage;
+  const scope = options?.scope ?? 'all';
+
+  if (options?.sourceLanguage || options?.targetLanguage) {
+    setState({
+      sourceLanguage: requestedSource,
+      targetLanguage,
+    });
+    savePreferences();
+  }
+
+  const rootTarget: ParentNode =
+    scope === 'article'
+      ? document.querySelector<HTMLElement>('[data-translatable-article]') || document
+      : document;
+
+  const elements = collectTranslatableLeafElements(rootTarget);
+  if (elements.length === 0) {
+    setState({ error: 'No translatable article or teaser content found on this page.' });
+    return;
+  }
+
+  elements.forEach(ensureOriginalSaved);
+
+  setState({
+    isTranslating: true,
+    downloadProgress: null,
+    translatedCount: 0,
+    totalCount: elements.length,
+    error: null,
+  });
+
+  try {
+    let resolvedSource = requestedSource;
+    if (requestedSource === 'auto') {
+      const sample = elements
+        .slice(0, 4)
+        .map((e) => e.textContent || '')
+        .join(' ');
+      const fallback = state.activeLanguage || 'en';
+      resolvedSource = await detectTextLanguage(sample, fallback);
+      setState({ detectedSourceLanguage: resolvedSource });
+    }
+
+    if (resolvedSource.toLowerCase() === targetLanguage.toLowerCase()) {
+      if (targetLanguage.toLowerCase() === 'en') {
+        restorePageContent();
+        return;
+      }
+      setState({
+        isTranslating: false,
+        error: 'Source and target languages are identical. Select a different target language.',
+      });
+      return;
+    }
+
+    const translator = await getOrCreateTranslator({
+      sourceLanguage: resolvedSource,
+      targetLanguage,
+      onDownloadProgress: (pct) => {
+        setState({
+          availability: pct < 100 ? 'downloading' : 'available',
+          downloadProgress: pct,
+        });
+      },
+      signal: controller.signal,
+    });
+
+    setState({
+      availability: 'available',
+      downloadProgress: null,
+    });
+
+    let completed = 0;
+    for (const el of elements) {
+      if (controller.signal.aborted) break;
+      await translateSingleElement(
+        el,
+        translator,
+        resolvedSource,
+        targetLanguage,
+        controller.signal
+      );
+      completed += 1;
+      setState({ translatedCount: completed });
+    }
+
+    if (!controller.signal.aborted) {
+      const containers = rootTarget.querySelectorAll<HTMLElement>(
+        '[data-translatable-article], [data-translatable-teaser]'
+      );
+      containers.forEach((c) => {
+        c.dataset.currentLang = targetLanguage;
+        c.setAttribute('lang', targetLanguage);
+        c.setAttribute('dir', isRtlLanguage(targetLanguage) ? 'rtl' : 'ltr');
+      });
+      if (rootTarget instanceof HTMLElement && rootTarget.hasAttribute('data-translatable-article')) {
+        rootTarget.dataset.currentLang = targetLanguage;
+        rootTarget.setAttribute('lang', targetLanguage);
+        rootTarget.setAttribute('dir', isRtlLanguage(targetLanguage) ? 'rtl' : 'ltr');
+      }
+
+      setState({
+        activeLanguage: targetLanguage,
+        isTranslating: false,
+        downloadProgress: null,
+      });
+
+      window.dispatchEvent(new CustomEvent('devtools-times:translation-updated'));
+    }
+  } catch (err: any) {
+    if (controller.signal.aborted) {
+      return;
+    }
+    const message =
+      err instanceof Error
+        ? err.message
+        : 'Failed to translate content using the on-device Translator API.';
+    setState({
+      isTranslating: false,
+      downloadProgress: null,
+      error: message,
+    });
+  } finally {
+    if (activeAbortController === controller) {
+      activeAbortController = null;
+    }
+  }
+}
+
+export function restorePageContent() {
+  if (typeof document === 'undefined') return;
+  cancelActiveTranslation();
+  restoreContainer(document);
+  setState({
+    activeLanguage: null,
+    isTranslating: false,
+    downloadProgress: null,
+    translatedCount: 0,
+    totalCount: 0,
+    error: null,
+  });
+}
+
+export function handlePageNavigation() {
+  cancelActiveTranslation();
+  setState({
+    activeLanguage: null,
+    isTranslating: false,
+    downloadProgress: null,
+    translatedCount: 0,
+    totalCount: 0,
+    error: null,
+  });
+  refreshAvailability();
+  if (state.autoTranslateOnNavigate) {
+    translatePageContent({ scope: 'all' });
+  }
+}
+
