+        availability?: (options: TranslatorCreateCoreOptions) => Promise<BuiltInAIAvailability>;
+        capabilities?: () => Promise<{
+          available: BuiltInAIAvailability;
+          languagePairAvailable: (sourceLanguage: string, targetLanguage: string) => BuiltInAIAvailability;
