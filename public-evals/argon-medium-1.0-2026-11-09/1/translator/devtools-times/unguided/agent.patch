diff --git a/src/components/TeaserTranslateButton.tsx b/src/components/TeaserTranslateButton.tsx
new file mode 100644
index 0000000..93802a5
--- /dev/null
+++ b/src/components/TeaserTranslateButton.tsx
@@ -0,0 +1,278 @@
+import React, { useEffect, useRef, useState } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  subscribeTranslationState,
+  getTranslationState,
+  translateContainer,
+  restoreContainer,
+} from '../utils/translator';
+
+interface Props {
+  articleId: string;
+}
+
+export default function TeaserTranslateButton({ articleId }: Props) {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const [globalState, setGlobalState] = useState(getTranslationState());
+  const [sourceLang, setSourceLang] = useState(globalState.sourceLanguage);
+  const [targetLang, setTargetLang] = useState(globalState.targetLanguage);
+  const [currentLang, setCurrentLang] = useState<string>('en');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [downloadPct, setDownloadPct] = useState<number | null>(null);
+  const [isOpen, setIsOpen] = useState(false);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+
+  useEffect(() => {
+    const unsub = subscribeTranslationState((next) => {
+      setGlobalState(next);
+      setSourceLang(next.sourceLanguage);
+      setTargetLang(next.targetLanguage);
+    });
+
+    const syncTeaserLang = () => {
+      const container =
+        rootRef.current?.closest<HTMLElement>('[data-translatable-teaser]') ||
+        document.querySelector<HTMLElement>(`[data-translatable-teaser="${articleId}"]`);
+      if (container) {
+        setCurrentLang(container.dataset.currentLang || 'en');
+      }
+    };
+
+    syncTeaserLang();
+    window.addEventListener('devtools-times:translation-updated', syncTeaserLang);
+
+    const handleOutsideClick = (e: MouseEvent) => {
+      if (rootRef.current && !rootRef.current.contains(e.target as Node)) {
+        setIsOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleOutsideClick);
+
+    return () => {
+      unsub();
+      window.removeEventListener('devtools-times:translation-updated', syncTeaserLang);
+      document.removeEventListener('mousedown', handleOutsideClick);
+    };
+  }, [articleId]);
+
+  const getTeaserElement = (): HTMLElement | null => {
+    return (
+      rootRef.current?.closest<HTMLElement>('[data-translatable-teaser]') ||
+      document.querySelector<HTMLElement>(`[data-translatable-teaser="${articleId}"]`)
+    );
+  };
+
+  const handleTranslateTeaser = async (overrideTarget?: string, overrideSource?: string) => {
+    const container = getTeaserElement();
+    if (!container) return;
+
+    const finalSource = overrideSource ?? sourceLang;
+    const finalTarget = overrideTarget ?? targetLang;
+
+    setIsTranslating(true);
+    setDownloadPct(null);
+    setErrorMsg(null);
+
+    try {
+      await translateContainer(container, {
+        sourceLanguage: finalSource,
+        targetLanguage: finalTarget,
+        onDownloadProgress: (pct) => setDownloadPct(pct),
+      });
+      setCurrentLang(container.dataset.currentLang || finalTarget);
+      setIsOpen(false);
+    } catch (err: any) {
+      setErrorMsg(
+        err instanceof Error ? err.message : 'On-device translation unavailable in this browser.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadPct(null);
+    }
+  };
+
+  const handleRestoreTeaser = () => {
+    const container = getTeaserElement();
+    if (!container) return;
+    restoreContainer(container);
+    setCurrentLang('en');
+    setErrorMsg(null);
+    setIsOpen(false);
+  };
+
+  const handleSwapLocal = () => {
+    const resolvedSrc = sourceLang === 'auto' ? currentLang || 'en' : sourceLang;
+    const nextSrc = targetLang;
+    const nextTgt = resolvedSrc === targetLang ? 'en' : resolvedSrc;
+    setSourceLang(nextSrc);
+    setTargetLang(nextTgt);
+  };
+
+  const isTranslated = currentLang !== 'en';
+
+  return (
+    <div ref={rootRef} className="relative inline-flex items-center gap-1">
+      {/* Primary One-Click Teaser Translate Button */}
+      <div className="inline-flex items-center rounded border border-gray-200 bg-gray-50 text-xs text-gray-600 overflow-hidden">
+        <button
+          type="button"
+          onClick={() => handleTranslateTeaser()}
+          disabled={isTranslating}
+          data-testid={`teaser-translate-btn-${articleId}`}
+          title={`Translate teaser to ${targetLang.toUpperCase()}`}
+          className="inline-flex items-center gap-1 px-2 py-0.5 hover:bg-amber-50 hover:text-amber-700 transition-colors disabled:opacity-50 cursor-pointer"
+        >
+          {isTranslating ? (
+            <>
+              <span className="w-3 h-3 border-2 border-amber-500 border-t-transparent rounded-full animate-spin" />
+              <span>{downloadPct !== null ? `${downloadPct}%` : '...'}</span>
+            </>
+          ) : (
+            <>
+              <svg
+                xmlns="http://www.w3.org/2000/svg"
+                className="w-3.5 h-3.5 text-amber-600"
+                fill="none"
+                viewBox="0 0 24 24"
+                stroke="currentColor"
+                strokeWidth={2}
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+                />
+              </svg>
+              <span className="font-medium">
+                {isTranslated
+                  ? `${currentLang.toUpperCase()} → ${targetLang.toUpperCase()}`
+                  : targetLang.toUpperCase()}
+              </span>
+            </>
+          )}
+        </button>
+
+        {/* Popover Toggle */}
+        <button
+          type="button"
+          onClick={() => setIsOpen((v) => !v)}
+          aria-label="Choose teaser translation languages"
+          data-testid={`teaser-translate-options-${articleId}`}
+          className="px-1 py-0.5 border-l border-gray-200 hover:bg-gray-200 text-gray-500 cursor-pointer"
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="w-3 h-3"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+          >
+            <path strokeLinecap="round" strokeLinejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
+          </svg>
+        </button>
+      </div>
+
+      {/* Inline Restore Button when Translated */}
+      {isTranslated && (
+        <button
+          type="button"
+          onClick={handleRestoreTeaser}
+          data-testid={`teaser-restore-btn-${articleId}`}
+          title="Restore original teaser language"
+          className="text-[11px] font-medium px-1.5 py-0.5 rounded border border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100 transition-colors cursor-pointer"
+        >
+          Original
+        </button>
+      )}
+
+      {/* Language Picker Popover */}
+      {isOpen && (
+        <div
+          className="absolute bottom-full right-0 mb-1.5 w-60 rounded-lg border border-gray-200 bg-white p-3 shadow-lg z-30 text-left"
+          onClick={(e) => e.stopPropagation()}
+        >
+          <div className="text-xs font-semibold text-gray-800 mb-2 flex items-center justify-between">
+            <span>Translate Teaser</span>
+            {isTranslated && (
+              <span className="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800">
+                Active: {currentLang.toUpperCase()}
+              </span>
+            )}
+          </div>
+
+          <div className="space-y-2 text-xs">
+            <div>
+              <label className="block text-[11px] text-gray-500 mb-0.5">From</label>
+              <select
+                aria-label="Teaser source language"
+                value={sourceLang}
+                onChange={(e) => setSourceLang(e.target.value)}
+                className="w-full border border-gray-300 rounded px-2 py-1 bg-white text-gray-800 text-xs"
+              >
+                <option value="auto">Auto-detect</option>
+                {SUPPORTED_LANGUAGES.map((l) => (
+                  <option key={`t-src-${l.code}`} value={l.code}>
+                    {l.name} ({l.code.toUpperCase()})
+                  </option>
+                ))}
+              </select>
+            </div>
+
+            <div className="flex justify-center">
+              <button
+                type="button"
+                onClick={handleSwapLocal}
+                className="text-[11px] text-gray-600 hover:text-amber-600 inline-flex items-center gap-1 px-2 py-0.5 rounded border border-gray-200 cursor-pointer"
+              >
+                ⇄ Swap
+              </button>
+            </div>
+
+            <div>
+              <label className="block text-[11px] text-gray-500 mb-0.5">To</label>
+              <select
+                aria-label="Teaser target language"
+                value={targetLang}
+                onChange={(e) => setTargetLang(e.target.value)}
+                className="w-full border border-gray-300 rounded px-2 py-1 bg-white text-gray-800 text-xs"
+              >
+                {SUPPORTED_LANGUAGES.map((l) => (
+                  <option key={`t-tgt-${l.code}`} value={l.code}>
+                    {l.name} ({l.nativeName})
+                  </option>
+                ))}
+              </select>
+            </div>
+
+            {errorMsg && (
+              <p className="text-[11px] text-red-600 bg-red-50 border border-red-200 rounded p-1.5">
+                {errorMsg}
+              </p>
+            )}
+
+            <div className="flex items-center gap-1.5 pt-1">
+              <button
+                type="button"
+                disabled={isTranslating}
+                onClick={() => handleTranslateTeaser()}
+                className="flex-1 bg-gray-900 text-white font-semibold py-1 px-2 rounded hover:bg-amber-600 transition-colors cursor-pointer disabled:opacity-50"
+              >
+                {isTranslating ? 'Translating...' : 'Translate'}
+              </button>
+              {isTranslated && (
+                <button
+                  type="button"
+                  onClick={handleRestoreTeaser}
+                  className="border border-gray-300 text-gray-700 font-medium py-1 px-2 rounded hover:bg-gray-100 cursor-pointer"
+                >
+                  Original
+                </button>
+              )}
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
