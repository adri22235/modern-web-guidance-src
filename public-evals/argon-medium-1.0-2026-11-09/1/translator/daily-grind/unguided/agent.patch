+
+        // 1. Apply instant on-device dictionary translations synchronously so UI updates with zero latency
+        i18nElements.forEach((el) => {
+          const key = el.getAttribute('data-i18n');
+          if (key && langPack[key]) {
+            el.textContent = langPack[key];
+          }
+        });
+
+        if (statusEl) {
+          statusEl.textContent = currentLang === 'en'
+            ? langPack['translator.statusDefault']
+            : langPack['translator.statusTranslated'];
+        }
+
+        try {
+          localStorage.setItem('daily_grind_lang', currentLang);
+        } catch (_e) {
+          // Ignore storage errors in restricted environments
+        }
+
+        // 2. If Browser Built-in On-Device Translator API is available, translate menu descriptions & story text
+        if (currentLang !== 'en') {
+          const requestedLang = currentLang;
+          const translator = await getBrowserOnDeviceTranslator('en', requestedLang);
+          if (translator && typeof translator.translate === 'function' && currentLang === requestedLang) {
+            const targetNodes = document.querySelectorAll('.menu-description, .story-text');
+            for (const node of targetNodes) {
+              const key = node.getAttribute('data-i18n');
+              const sourceText = (key && TRANSLATIONS.en[key]) || node.textContent;
+              try {
+                const apiTranslated = await translator.translate(sourceText);
+                if (
+                  currentLang === requestedLang &&
+                  apiTranslated &&
+                  typeof apiTranslated === 'string' &&
+                  apiTranslated.trim().length > 0
+                ) {
+                  node.textContent = apiTranslated;
+                }
+              } catch (_err) {
+                // Keep dictionary translation on error
+              }
+            }
+          }
+        }
+      }
+
+      if (selectEl) {
+        selectEl.addEventListener('change', (e) => {
+          applyLanguage(e.target.value);
+        });
+      }
+
+      pillButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const targetLang = btn.getAttribute('data-lang');
+          if (targetLang) {
+            applyLanguage(targetLang);
+          }
+        });
+      });
+
+      // Restore saved preference if present
+      let initialLang = 'en';
+      try {
+        const saved = localStorage.getItem('daily_grind_lang');
