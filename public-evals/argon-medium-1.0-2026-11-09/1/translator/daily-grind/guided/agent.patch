+  <script>
+    (() => {
+      const languageSelect = document.getElementById('language-select');
+      const translateBtn = document.getElementById('translate-btn');
+      const statusBadge = document.getElementById('translation-status');
+      const progressBar = document.getElementById('translation-progress');
+      const mainContainer = document.getElementById('translatable-main');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      const RTL_LANGUAGES = new Set(['ar', 'he']);
+      let currentLanguage = 'en';
+      const translatorCache = new Map();
+
+      // Snapshot original English text for reliable multi-language switching and reset
+      for (const el of translatableElements) {
+        el.dataset.originalText = el.textContent.trim();
+      }
+
+      function setStatus(message, isError = false) {
+        statusBadge.textContent = message;
+        statusBadge.classList.toggle('status-error', isError);
+      }
+
+      function setDirectionAndLang(langCode) {
+        mainContainer.setAttribute('lang', langCode);
+        mainContainer.setAttribute('dir', RTL_LANGUAGES.has(langCode) ? 'rtl' : 'ltr');
+      }
+
+      function restoreOriginalEnglish() {
+        for (const el of translatableElements) {
+          el.textContent = el.dataset.originalText;
+        }
+        currentLanguage = 'en';
+        setDirectionAndLang('en');
+        progressBar.hidden = true;
+        translateBtn.textContent = 'Translate';
+        setStatus('Showing original (English)');
+      }
+
+      // Feature detection using the global Translator interface
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus('Client-side translation is currently unsupported in this browser.', true);
+        return;
+      }
+
+      async function createTranslatorWithProgress(options) {
+        const cacheKey = `${options.sourceLanguage}->${options.targetLanguage}`;
+        if (translatorCache.has(cacheKey)) {
+          return translatorCache.get(cacheKey);
+        }
+
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              progressBar.hidden = false;
+              progressBar.value = percent;
+              setStatus(`Downloading language pack: ${percent}%`);
+            });
+          },
+        });
+
+        progressBar.hidden = true;
+        translatorCache.set(cacheKey, translator);
+        return translator;
+      }
+
+      async function translateElementText(translator, element, sourceText) {
+        const shouldStream =
+          element.dataset.streaming === 'true' &&
+          typeof translator.translateStreaming === 'function';
+
+        if (shouldStream) {
+          const stream = translator.translateStreaming(sourceText);
+          let output = '';
+          element.textContent = '';
+          for await (const chunk of stream) {
+            output += chunk;
+            element.textContent = output;
+          }
+          return output;
+        }
+
+        const translated = await translator.translate(sourceText);
+        element.textContent = translated;
+        return translated;
+      }
+
+      async function runTranslation(targetLanguage) {
+        if (targetLanguage === 'en') {
+          restoreOriginalEnglish();
+          return;
+        }
+
+        // Identical language pair options passed to both availability() and create()
+        const options = {
+          sourceLanguage: 'en',
+          targetLanguage,
+        };
+
+        try {
+          translateBtn.disabled = true;
+          languageSelect.disabled = true;
+          setStatus('Checking on-device model availability...');
+
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            setStatus('Translation model is unavailable on this device for the selected language.', true);
+            return;
+          }
+
+          if (availability === 'downloadable' || availability === 'downloading') {
+            progressBar.hidden = false;
+            progressBar.value = 0;
+            setStatus('Downloading on-device language model...');
+          } else if (availability === 'available') {
+            setStatus('Translating on device...');
+          }
+
+          const translator = await createTranslatorWithProgress(options);
+
+          setStatus('Translating menu & story on device...');
+          for (const el of translatableElements) {
+            const sourceText = el.dataset.originalText;
+            if (sourceText) {
+              await translateElementText(translator, el, sourceText);
+            }
+          }
+
+          currentLanguage = targetLanguage;
+          setDirectionAndLang(targetLanguage);
+          translateBtn.textContent = 'Translate';
+          const selectedLabel = languageSelect.options[languageSelect.selectedIndex]?.text || targetLanguage;
+          setStatus(`Translated on-device to ${selectedLabel}`);
+        } catch (err) {
+          progressBar.hidden = true;
+          if (err && err.name === 'NotAllowedError') {
+            translateBtn.textContent = 'Download & Translate';
+            setStatus('Click "Download & Translate" to authorize language model download.');
+          } else {
+            console.warn('On-device translation failed:', err);
+            setStatus('Unable to complete on-device translation on this device.', true);
+          }
+        } finally {
+          translateBtn.disabled = false;
+          languageSelect.disabled = false;
+        }
+      }
+
+      // User gesture handlers: both clicking the button and changing the selector can trigger translation
+      translateBtn.addEventListener('click', () => {
+        runTranslation(languageSelect.value);
+      });
+
+      languageSelect.addEventListener('change', () => {
+        runTranslation(languageSelect.value);
+      });
+    })();
+  </script>
 </body>
 
