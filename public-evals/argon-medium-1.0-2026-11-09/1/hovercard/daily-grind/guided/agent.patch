+  <script type="module">
+    const ownedExpandedTriggers = new WeakSet();
+
+    function normalizeText(str) {
+      return (str || "").replace(/\s+/g, " ").trim();
+    }
+
+    function getTextWithAlt(el) {
+      if (!el) return "";
+      let result = "";
+      for (const node of el.childNodes) {
+        if (node.nodeType === Node.TEXT_NODE) {
+          result += node.textContent;
+        } else if (node.nodeType === Node.ELEMENT_NODE) {
+          if (node.tagName === "IMG") {
+            result += " " + (node.getAttribute("alt") || "") + " ";
+          } else {
+            result += " " + getTextWithAlt(node) + " ";
+          }
+        }
+      }
+      return normalizeText(result);
+    }
+
+    function getAccessibleName(el) {
+      const labelledBy = el.getAttribute("aria-labelledby");
+      if (labelledBy) {
+        const text = normalizeText(
+          labelledBy
+            .trim()
+            .split(/\s+/)
+            .map((id) => getTextWithAlt(document.getElementById(id)))
+            .join(" ")
+        );
+        if (text) return text;
+      }
+      const ariaLabel = normalizeText(el.getAttribute("aria-label"));
+      if (ariaLabel) return ariaLabel;
+      const content = getTextWithAlt(el);
+      if (content) return content;
+      return normalizeText(el.getAttribute("title"));
+    }
+
+    function isPopoverOpen(popover) {
+      try {
+        return popover.matches(":is(:popover-open, .\\:popover-open)");
+      } catch {
+        return popover.classList.contains(":popover-open");
+      }
+    }
+
+    export function wireInterestHints(root = document) {
+      for (const trigger of root.querySelectorAll("[interestfor]")) {
+        const id = trigger.getAttribute("interestfor");
+        const hint = id ? document.getElementById(id) : null;
+        if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+        const hintText = getTextWithAlt(hint);
+        const triggerName = getAccessibleName(trigger);
+        if (hintText && hintText === triggerName) continue;
+
+        if (!hint.hasAttribute("role")) {
+          hint.setAttribute("role", "tooltip");
+        }
+
+        if (!triggerName) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", id);
+          }
+        } else {
+          const opensOnActivation =
+            trigger.getAttribute("popovertarget") === id ||
+            trigger.getAttribute("commandfor") === id;
+
+          if (opensOnActivation) {
+            if (!trigger.hasAttribute("aria-expanded")) {
+              trigger.setAttribute("aria-expanded", String(isPopoverOpen(hint)));
+              ownedExpandedTriggers.add(trigger);
+            }
+          } else if (!trigger.hasAttribute("aria-describedby")) {
+            trigger.setAttribute("aria-describedby", id);
+          }
+        }
+      }
+    }
+
+    window.wireInterestHints = wireInterestHints;
+    wireInterestHints();
+
+    if ("interestForElement" in HTMLButtonElement.prototype) {
+      document.addEventListener(
+        "toggle",
+        (event) => {
+          const popover = event.target;
+          if (
+            !(popover instanceof HTMLElement) ||
+            !popover.id ||
+            popover.getAttribute("popover") !== "hint"
+          ) {
+            return;
+          }
+          const openState = event.newState
+            ? event.newState === "open"
+            : isPopoverOpen(popover);
+          for (const trigger of document.querySelectorAll(
+            `[interestfor="${CSS.escape(popover.id)}"]`
+          )) {
+            if (ownedExpandedTriggers.has(trigger)) {
+              trigger.setAttribute("aria-expanded", String(openState));
+            }
+          }
+        },
+        true
+      );
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+  </script>
