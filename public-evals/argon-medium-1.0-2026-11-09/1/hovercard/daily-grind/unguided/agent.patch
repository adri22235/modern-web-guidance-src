+  <script>
+    document.querySelectorAll('.hovercard-trigger-wrapper').forEach((wrapper) => {
+      const trigger = wrapper.querySelector('.hovercard-trigger');
+      const card = wrapper.querySelector('.hovercard');
+      let hideTimeout = null;
+
+      const openCard = () => {
+        if (hideTimeout) {
+          clearTimeout(hideTimeout);
+          hideTimeout = null;
+        }
+        card.classList.add('is-open');
+        trigger.setAttribute('aria-expanded', 'true');
+      };
+
+      const closeCard = () => {
+        hideTimeout = setTimeout(() => {
+          card.classList.remove('is-open');
+          trigger.setAttribute('aria-expanded', 'false');
+        }, 120);
+      };
+
+      wrapper.addEventListener('mouseenter', openCard);
+      wrapper.addEventListener('mouseleave', closeCard);
+      wrapper.addEventListener('focusin', openCard);
+      wrapper.addEventListener('focusout', (e) => {
+        if (!wrapper.contains(e.relatedTarget)) {
+          closeCard();
+        }
+      });
+
+      card.querySelectorAll('.hovercard-size-btn').forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          e.stopPropagation();
+          card.querySelectorAll('.hovercard-size-btn').forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+
+          const priceEl = card.querySelector('[data-price]');
+          const calEl = card.querySelector('[data-calories]');
+          const cafEl = card.querySelector('[data-caffeine]');
+          if (priceEl && btn.dataset.priceVal) priceEl.textContent = btn.dataset.priceVal;
+          if (calEl && btn.dataset.calVal) calEl.textContent = btn.dataset.calVal;
+          if (cafEl && btn.dataset.cafVal) cafEl.textContent = btn.dataset.cafVal;
+        });
+      });
+    });
+
+    document.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape') {
+        document.querySelectorAll('.hovercard.is-open').forEach((card) => {
+          card.classList.remove('is-open');
+        });
+        document.querySelectorAll('.hovercard-trigger[aria-expanded="true"]').forEach((trigger) => {
+          trigger.setAttribute('aria-expanded', 'false');
+        });
+      }
+    });
+  </script>
 </body>
 
