+    /* Hovercard Component */
+    .card {
+      position: relative;
+    }
+
+    .hovercard-trigger-wrapper {
+      position: relative;
+      display: inline-block;
+      margin-top: 15px;
+    }
+
+    .hovercard-trigger-wrapper .btn {
+      margin-top: 0;
+    }
+
+    .hovercard {
+      position: absolute;
+      bottom: calc(100% + 12px);
+      left: 50%;
+      transform: translateX(-50%) translateY(8px);
+      width: 310px;
+      background: #ffffff;
+      border-radius: 12px;
+      box-shadow: 0 12px 32px rgba(62, 39, 35, 0.22), 0 2px 6px rgba(0, 0, 0, 0.08);
+      border: 1px solid rgba(78, 52, 46, 0.12);
+      text-align: left;
+      z-index: 900;
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
+    }
+
+    /* Invisible hover bridge so moving the cursor from link to hovercard stays open */
+    .hovercard::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 0;
+      width: 100%;
+      height: 16px;
+    }
+
+    /* Arrow indicator */
+    .hovercard::before {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border-width: 8px;
+      border-style: solid;
+      border-color: #ffffff transparent transparent transparent;
+      filter: drop-shadow(0 2px 2px rgba(62, 39, 35, 0.1));
+      z-index: 2;
+    }
+
+    .hovercard-trigger-wrapper:hover .hovercard,
+    .hovercard-trigger-wrapper:focus-within .hovercard,
+    .hovercard.is-open {
+      opacity: 1;
+      visibility: visible;
+      pointer-events: auto;
+      transform: translateX(-50%) translateY(0);
+    }
+
