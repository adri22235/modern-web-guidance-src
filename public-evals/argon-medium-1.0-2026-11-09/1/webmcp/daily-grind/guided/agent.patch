+      const DRINK_IDS = Object.keys(DRINK_CATALOG);
+      const CUP_SIZES = ['small', 'medium', 'large'];
+      const SIZE_UPCHARGE = {
+        small: -0.5,
+        medium: 0,
+        large: 0.75
+      };
+
+      const orderItems = [];
+      const orderStatusEl = document.getElementById('order-status');
+      const orderListEl = document.getElementById('order-list');
+      const orderTotalEl = document.getElementById('order-total');
+      const clearOrderBtn = document.getElementById('clear-order-btn');
+
+      function calculateItemTotal({ basePrice, size, extraShot, quantity }) {
+        const sizeDelta = SIZE_UPCHARGE[size] ?? 0;
+        const shotDelta = extraShot ? 1.0 : 0;
+        const unitPrice = Math.max(0, basePrice + sizeDelta + shotDelta);
+        return Number((unitPrice * quantity).toFixed(2));
+      }
+
+      function renderOrderSummary(statusMessage) {
+        if (statusMessage) {
+          orderStatusEl.textContent = statusMessage;
+        }
+        orderListEl.replaceChildren();
+
+        let grandTotal = 0;
+        for (const item of orderItems) {
+          grandTotal += item.totalPrice;
+          const li = document.createElement('li');
+          const detailsSpan = document.createElement('span');
+          const modifiers = [
+            item.size,
+            item.temperature || (item.iceLevel ? `${item.iceLevel} ice` : ''),
+            item.extraShot ? 'extra shot' : '',
+            item.notes ? `note: "${item.notes}"` : ''
+          ].filter(Boolean).join(', ');
+          detailsSpan.textContent = `${item.quantity}x ${item.drinkName} (${modifiers})`;
+
+          const priceSpan = document.createElement('span');
+          priceSpan.textContent = `$${item.totalPrice.toFixed(2)}`;
+
+          li.append(detailsSpan, priceSpan);
+          orderListEl.append(li);
+        }
+
+        orderTotalEl.textContent = `Total: $${grandTotal.toFixed(2)}`;
+      }
+
+      clearOrderBtn.addEventListener('click', () => {
+        orderItems.length = 0;
+        renderOrderSummary('Your order tray has been cleared.');
+      });
+
+      function validateQuantityInput(input) {
+        const errorSpan = document.getElementById(`${input.id}-error`);
+        const rawValue = input.value.trim();
+        const num = Number(rawValue);
+
+        if (!rawValue || !Number.isInteger(num) || num < 1 || num > 10) {
+          const message = 'Please enter a whole quantity between 1 and 10.';
+          input.setCustomValidity(message);
+          input.setAttribute('aria-invalid', 'true');
+          if (errorSpan) {
+            errorSpan.textContent = message;
+          }
+          return { valid: false, field: input.name, message, element: input };
+        }
+
+        input.setCustomValidity('');
+        input.removeAttribute('aria-invalid');
+        if (errorSpan) {
+          errorSpan.textContent = '';
+        }
+        return { valid: true };
+      }
+
+      function validateOrderForm(form) {
+        const errors = [];
+        const quantityInput = form.querySelector('input[name="quantity"]');
+        if (quantityInput) {
+          const qtyResult = validateQuantityInput(quantityInput);
+          if (!qtyResult.valid) {
+            errors.push(qtyResult);
+          }
+        }
+
+        const sizeChecked = form.querySelector('input[name="size"]:checked');
+        if (!sizeChecked) {
+          errors.push({
+            valid: false,
+            field: 'size',
+            message: 'Please choose a cup size.',
+            element: form.querySelector('input[name="size"]')
+          });
+        }
+
+        return errors;
+      }
+
+      function recordOrderFromData({
+        drinkId,
+        drinkName,
+        basePrice,
+        size = 'medium',
+        temperature = '',
+        iceLevel = '',
+        extraShot = false,
+        quantity = 1,
+        notes = ''
+      }) {
+        const cleanNotes = String(notes || '').trim().slice(0, 120);
+        const totalPrice = calculateItemTotal({ basePrice, size, extraShot, quantity });
+        const orderEntry = {
+          orderId: `ORD-${Date.now()}-${orderItems.length + 1}`,
+          drinkId,
+          drinkName,
+          size,
+          temperature,
+          iceLevel,
+          extraShot: Boolean(extraShot),
+          quantity,
+          notes: cleanNotes,
+          totalPrice
+        };
+        orderItems.push(orderEntry);
+        const confirmationText = `Added ${quantity}x ${size} ${drinkName} ($${totalPrice.toFixed(2)}) to your order.`;
+        renderOrderSummary(confirmationText);
+        return {
+          status: 'confirmed',
+          message: confirmationText,
+          order: orderEntry,
+          orderCount: orderItems.length
+        };
+      }
+
+      // Attach blur/input validation and WebMCP-aware submit handlers to each card form
+      document.querySelectorAll('.order-form').forEach((form) => {
+        const quantityInput = form.querySelector('input[name="quantity"]');
+        if (quantityInput) {
+          let edited = false;
+          quantityInput.addEventListener('input', () => {
+            edited = true;
+            quantityInput.setCustomValidity('');
+            quantityInput.removeAttribute('aria-invalid');
+            const errorSpan = document.getElementById(`${quantityInput.id}-error`);
+            if (errorSpan) {
+              errorSpan.textContent = '';
+            }
+          });
+
+          quantityInput.addEventListener('blur', () => {
+            if (edited) {
+              validateQuantityInput(quantityInput);
+            }
+          });
+        }
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+
+          const formValidationErrors = validateOrderForm(form);
+          if (formValidationErrors.length > 0) {
+            const firstInvalid = formValidationErrors[0].element;
+            if (firstInvalid && typeof firstInvalid.focus === 'function') {
+              firstInvalid.focus();
+            }
+            if (event.agentInvoked) {
+              const errorString =
+                'Validation failed: ' +
+                formValidationErrors
+                  .map((err) => `${err.field} (${err.message})`)
+                  .join(', ');
+              event.respondWith(Promise.resolve(errorString));
+            }
+            return;
+          }
+
+          const submitBtn = form.querySelector('button[type="submit"]');
+          if (submitBtn) {
+            submitBtn.disabled = true;
+          }
+
+          const formData = new FormData(form);
+          const card = form.closest('.card');
+          const drinkId = card?.dataset.drinkId || '';
+          const drinkName = form.dataset.drinkName || 'Seasonal Coffee';
+          const basePrice = Number(form.dataset.basePrice || 4.5);
+
+          const result = recordOrderFromData({
+            drinkId,
+            drinkName,
+            basePrice,
+            size: String(formData.get('size') || 'medium'),
+            temperature: String(formData.get('temperature') || ''),
+            iceLevel: String(formData.get('iceLevel') || ''),
+            extraShot: formData.get('extraShot') === 'true',
+            quantity: Number(formData.get('quantity') || 1),
+            notes: String(formData.get('notes') || '')
+          });
+
+          if (submitBtn) {
+            submitBtn.disabled = false;
+          }
+
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(result));
+          }
+        });
+      });
+
+      // WebMCP Lifecycle Events (supporting both Chrome 156+ document.modelContext and older window targets)
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor('toolactivated', ({ toolName }) => {
+        renderOrderSummary(`AI assistant is preparing tool "${toolName}"...`);
+      });
+
+      targetFor('toolcancel', ({ toolName }) => {
+        renderOrderSummary(`AI assistant cancelled tool "${toolName}".`);
+      });
+
+      // WebMCP Imperative API Registration with feature detection and AbortController cleanup
+      if ('modelContext' in document && document.modelContext) {
+        const toolRegistrationController = new AbortController();
+        window.addEventListener('pagehide', () => toolRegistrationController.abort(), { once: true });
+
+        async function registerCoffeeTools() {
+          await document.modelContext.registerTool({
+            name: 'submit_seasonal_coffee_order',
+            description: 'Places a customized order for a Seasonal Favorites coffee beverage and updates the on-page order tray. Use when the user wants to order one of the featured seasonal coffees.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                drink: {
+                  type: 'string',
+                  enum: DRINK_IDS,
+                  description: 'Identifier of the seasonal coffee beverage to order.'
+                },
+                size: {
+                  type: 'string',
+                  enum: CUP_SIZES,
+                  default: 'medium',
+                  description: 'Cup volume for the beverage.'
+                },
+                quantity: {
+                  type: 'integer',
+                  minimum: 1,
+                  maximum: 10,
+                  default: 1,
+                  description: 'Number of cups to prepare.'
+                },
+                extraShot: {
+                  type: 'boolean',
+                  default: false,
+                  description: 'Whether to add an extra espresso shot.'
+                },
+                notes: {
+                  type: 'string',
+                  default: '',
+                  description: 'Preparation instructions for the barista, such as extra hot or light ice.'
+                }
+              },
+              required: ['drink']
+            },
+            execute(input = {}) {
+              const {
+                drink,
+                size = 'medium',
+                quantity = 1,
+                extraShot = false,
+                notes = ''
+              } = input;
+
+              const catalogEntry = typeof drink === 'string' ? DRINK_CATALOG[drink] : undefined;
+              if (!catalogEntry) {
+                return {
+                  error: `Seasonal drink "${String(drink)}" was not found.`,
+                  availableDrinks: DRINK_IDS
+                };
+              }
+
+              if (!CUP_SIZES.includes(size)) {
+                return {
+                  error: `Unsupported cup size "${String(size)}".`,
+                  supportedSizes: CUP_SIZES
+                };
+              }
+
+              const parsedQty = Number(quantity);
+              if (!Number.isInteger(parsedQty) || parsedQty < 1 || parsedQty > 10) {
+                return {
+                  error: 'Quantity must be a whole number between 1 and 10.'
+                };
+              }
+
+              // Synchronize corresponding card form UI state before returning
+              const form = document.getElementById(catalogEntry.formId);
+              if (form) {
+                const sizeRadio = form.querySelector(`input[name="size"][value="${size}"]`);
+                if (sizeRadio) {
+                  sizeRadio.checked = true;
+                }
+                const extraShotCheckbox = form.querySelector('input[name="extraShot"]');
+                if (extraShotCheckbox) {
+                  extraShotCheckbox.checked = Boolean(extraShot);
+                }
+                const qtyInput = form.querySelector('input[name="quantity"]');
+                if (qtyInput) {
+                  qtyInput.value = String(parsedQty);
+                }
+                const notesInput = form.querySelector('input[name="notes"]');
+                if (notesInput) {
+                  notesInput.value = String(notes || '').slice(0, 120);
+                }
+              }
+
+              return recordOrderFromData({
+                drinkId: catalogEntry.id,
+                drinkName: catalogEntry.name,
+                basePrice: catalogEntry.basePrice,
+                size,
+                extraShot: Boolean(extraShot),
+                quantity: parsedQty,
+                notes: String(notes || '')
+              });
+            },
+            annotations: {
+              readOnlyHint: false,
+              consequentialHint: true,
+              untrustedContentHint: false
+            }
+          }, { signal: toolRegistrationController.signal });
+
+          await document.modelContext.registerTool({
+            name: 'get_seasonal_coffee_orders',
+            description: 'Retrieves the list of seasonal coffee items currently in the user order tray along with the running total. Use when the user asks to review their current coffee order.',
+            inputSchema: {
+              type: 'object',
+              properties: {}
+            },
+            execute() {
+              const total = Number(
+                orderItems.reduce((sum, item) => sum + item.totalPrice, 0).toFixed(2)
+              );
+              return {
+                items: orderItems.map((item) => ({ ...item })),
+                itemCount: orderItems.length,
+                totalPrice: total
+              };
+            },
+            annotations: {
+              readOnlyHint: true
+            }
+          }, { signal: toolRegistrationController.signal });
+        }
+
+        registerCoffeeTools();
+      }
+    })();
+  </script>
 </body>
 
 </html>
