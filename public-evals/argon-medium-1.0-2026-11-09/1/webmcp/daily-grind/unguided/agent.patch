+  <script>
+    (function () {
+      const MENU_ITEMS = {
+        'maple-oat-latte': {
+          key: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          toolName: 'order_maple_oat_latte',
+          basePrice: 5.50,
+          defaultMilk: 'Oat Milk',
+          formId: 'form-maple-oat-latte',
+          feedbackId: 'feedback-maple-oat-latte'
+        },
+        'dark-roast-espresso': {
+          key: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          toolName: 'order_dark_roast_espresso',
+          basePrice: 3.75,
+          defaultMilk: 'None',
+          formId: 'form-dark-roast-espresso',
+          feedbackId: 'feedback-dark-roast-espresso'
+        },
+        'cold-brew': {
+          key: 'cold-brew',
+          name: 'Cold Brew',
+          toolName: 'order_cold_brew',
+          basePrice: 4.75,
+          defaultMilk: 'None',
+          formId: 'form-cold-brew',
+          feedbackId: 'feedback-cold-brew'
+        }
+      };
+
+      const SIZE_MODIFIERS = {
+        Small: -0.50,
+        Medium: 0.00,
+        Large: 0.75
+      };
+
+      const orders = [];
+
+      function normalizeSize(size) {
+        if (!size) return 'Medium';
+        const s = String(size).trim().toLowerCase();
+        if (s.startsWith('s') || s.includes('single')) return 'Small';
+        if (s.startsWith('l') || s.includes('triple')) return 'Large';
+        return 'Medium';
+      }
+
+      function normalizeQuantity(qty) {
+        const parsed = parseInt(qty, 10);
+        if (Number.isNaN(parsed) || parsed < 1) return 1;
+        return Math.min(parsed, 20);
+      }
+
+      function calculateUnitPrice(basePrice, size) {
+        const modifier = SIZE_MODIFIERS[size] ?? 0;
+        return Number((basePrice + modifier).toFixed(2));
+      }
+
+      function syncFormFields(itemConfig, orderParams) {
+        const form = document.getElementById(itemConfig.formId);
+        if (!form) return;
+
+        const sizeEl = form.elements.namedItem('size');
+        const qtyEl = form.elements.namedItem('quantity');
+        const milkEl = form.elements.namedItem('milk');
+        const notesEl = form.elements.namedItem('notes');
+
+        if (sizeEl && orderParams.size) {
+          sizeEl.value = orderParams.size;
+        }
+        if (qtyEl && orderParams.quantity) {
+          qtyEl.value = String(orderParams.quantity);
+        }
+        if (milkEl && orderParams.milk) {
+          const matchingOption = Array.from(milkEl.options).find(
+            (opt) => opt.value.toLowerCase() === String(orderParams.milk).trim().toLowerCase()
+          );
+          if (matchingOption) {
+            milkEl.value = matchingOption.value;
+          }
+        }
+        if (notesEl && typeof orderParams.notes === 'string') {
+          notesEl.value = orderParams.notes;
+        }
+      }
+
+      function renderOrderSummary(latestMessage) {
+        const countEl = document.getElementById('order-count');
+        const statusEl = document.getElementById('order-status');
+        const listEl = document.getElementById('order-list');
+        const totalEl = document.getElementById('order-total');
+        const clearBtn = document.getElementById('clear-order-btn');
+
+        const totalItems = orders.reduce((sum, item) => sum + item.quantity, 0);
+        const totalPrice = orders.reduce((sum, item) => sum + item.lineTotal, 0);
+
+        countEl.textContent = String(totalItems);
+        totalEl.textContent = `Total: $${totalPrice.toFixed(2)}`;
+
+        if (latestMessage) {
+          statusEl.textContent = latestMessage;
+        } else if (orders.length === 0) {
+          statusEl.textContent = 'Select any Seasonal Favorite above to start your order.';
+        }
+
+        clearBtn.style.display = orders.length > 0 ? 'inline-block' : 'none';
+
+        listEl.innerHTML = '';
+        orders.forEach((order) => {
+          const li = document.createElement('li');
+          const detailsParts = [order.size];
+          if (order.milk && order.milk !== 'None') {
+            detailsParts.push(order.milk);
+          }
+          if (order.notes) {
+            detailsParts.push(`"${order.notes}"`);
+          }
+          const leftSpan = document.createElement('span');
+          leftSpan.textContent = `${order.quantity}x ${order.item} (${detailsParts.join(', ')})`;
+
+          const rightSpan = document.createElement('strong');
+          rightSpan.textContent = `$${order.lineTotal.toFixed(2)}`;
+
+          li.appendChild(leftSpan);
+          li.appendChild(rightSpan);
+          listEl.appendChild(li);
+        });
+      }
+
+      function placeOrder(itemKey, rawParams = {}, syncDom = true) {
+        const itemConfig = MENU_ITEMS[itemKey];
+        if (!itemConfig) {
+          const errorMsg = `Unknown coffee item: ${itemKey}`;
+          return {
+            status: 'error',
+            message: errorMsg,
+            content: [{ type: 'text', text: errorMsg }]
+          };
+        }
+
+        const size = normalizeSize(rawParams.size);
+        const quantity = normalizeQuantity(rawParams.quantity);
+        const milk = rawParams.milk ? String(rawParams.milk).trim() : itemConfig.defaultMilk;
+        const notes = rawParams.notes ? String(rawParams.notes).trim() : '';
+
+        if (syncDom) {
+          syncFormFields(itemConfig, { size, quantity, milk, notes });
+        }
+
+        const unitPrice = calculateUnitPrice(itemConfig.basePrice, size);
+        const lineTotal = Number((unitPrice * quantity).toFixed(2));
+
+        const orderRecord = {
+          orderId: `ORD-${Date.now()}-${orders.length + 1}`,
+          itemKey: itemConfig.key,
+          item: itemConfig.name,
+          size,
+          quantity,
+          milk,
+          notes,
+          unitPrice,
+          lineTotal
+        };
+
+        orders.push(orderRecord);
+
+        const confirmationMessage = `Added ${quantity}x ${size} ${itemConfig.name}${milk && milk !== 'None' ? ` (${milk})` : ''}${notes ? ` [${notes}]` : ''} — $${lineTotal.toFixed(2)}`;
+
+        const feedbackEl = document.getElementById(itemConfig.feedbackId);
+        if (feedbackEl) {
+          feedbackEl.textContent = `✓ ${confirmationMessage}`;
+          feedbackEl.classList.add('visible');
+        }
+
+        renderOrderSummary(confirmationMessage);
+
+        const totalOrderValue = Number(orders.reduce((sum, item) => sum + item.lineTotal, 0).toFixed(2));
+        const totalItemCount = orders.reduce((sum, item) => sum + item.quantity, 0);
+
+        return {
+          status: 'success',
+          message: confirmationMessage,
+          order: orderRecord,
+          cart: {
+            totalItems: totalItemCount,
+            totalPrice: totalOrderValue,
+            items: orders.slice()
+          },
+          content: [
+            {
+              type: 'text',
+              text: `${confirmationMessage}. Cart total: $${totalOrderValue.toFixed(2)} (${totalItemCount} item${totalItemCount === 1 ? '' : 's'}).`
+            }
+          ]
+        };
+      }
+
+      // Wire up interactive form submissions & Declarative WebMCP SubmitEvent handling
+      Object.values(MENU_ITEMS).forEach((itemConfig) => {
+        const form = document.getElementById(itemConfig.formId);
+        if (!form) return;
+
+        const sizeSelect = form.elements.namedItem('size');
+        const priceBadge = document.querySelector(`[data-price-display="${itemConfig.key}"]`);
+        if (sizeSelect && priceBadge) {
+          sizeSelect.addEventListener('change', () => {
+            const updatedPrice = calculateUnitPrice(itemConfig.basePrice, normalizeSize(sizeSelect.value));
+            priceBadge.textContent = `$${updatedPrice.toFixed(2)}`;
+          });
+        }
+
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const formData = new FormData(form);
+          const result = placeOrder(
+            itemConfig.key,
+            {
+              size: formData.get('size'),
+              quantity: formData.get('quantity'),
+              milk: formData.get('milk'),
+              notes: formData.get('notes')
+            },
+            false
+          );
+
+          if (typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve(result));
+          }
+        });
+      });
+
+      const clearBtn = document.getElementById('clear-order-btn');
+      if (clearBtn) {
+        clearBtn.addEventListener('click', () => {
+          orders.length = 0;
+          Object.values(MENU_ITEMS).forEach((cfg) => {
+            const feedbackEl = document.getElementById(cfg.feedbackId);
+            if (feedbackEl) {
+              feedbackEl.textContent = '';
+              feedbackEl.classList.remove('visible');
+            }
+          });
+          renderOrderSummary();
+        });
+      }
+
+      // Expose Imperative WebMCP tools for browser AI agents (navigator.modelContext / document.modelContext)
+      function resolveItemKey(drinkInput) {
+        const normalized = String(drinkInput || '').trim().toLowerCase();
+        if (normalized.includes('maple') || normalized.includes('latte')) return 'maple-oat-latte';
+        if (normalized.includes('espresso') || normalized.includes('dark')) return 'dark-roast-espresso';
+        if (normalized.includes('cold') || normalized.includes('brew')) return 'cold-brew';
+        return MENU_ITEMS[normalized] ? normalized : null;
+      }
+
+      const itemToolDefinitions = [
+        {
+          name: 'order_maple_oat_latte',
+          description: 'Order a Maple Oat Latte (creamy oat milk with Vermont maple syrup) with customizable size, milk, quantity, and special instructions.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size: Small ($5.00), Medium ($5.50), or Large ($6.25).'
+              },
+              quantity: {
+                type: 'integer',
+                minimum: 1,
+                maximum: 20,
+                description: 'Number of Maple Oat Lattes to order (default: 1).'
+              },
+              milk: {
+                type: 'string',
+                enum: ['Oat Milk', 'Whole Milk', 'Almond Milk', 'Skim Milk'],
+                description: 'Milk preference (default: Oat Milk).'
+              },
+              notes: {
+                type: 'string',
+                description: 'Optional special instructions (e.g., iced, extra maple syrup).'
+              }
+            }
+          },
+          execute: async (params = {}) => placeOrder('maple-oat-latte', params, true)
+        },
+        {
+          name: 'order_dark_roast_espresso',
+          description: 'Order a Dark Roast Espresso (bold, smokey espresso) with customizable size/shots, milk splash, quantity, and special instructions.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Serving size: Small/Single ($3.25), Medium/Double ($3.75), or Large/Triple ($4.50).'
+              },
+              quantity: {
+                type: 'integer',
+                minimum: 1,
+                maximum: 20,
+                description: 'Number of Dark Roast Espressos to order (default: 1).'
+              },
+              milk: {
+                type: 'string',
+                enum: ['None', 'Oat Milk', 'Whole Milk', 'Almond Milk'],
+                description: 'Optional splash of milk (default: None).'
+              },
+              notes: {
+                type: 'string',
+                description: 'Optional special instructions (e.g., ristretto pull, raw sugar).'
+              }
+            }
+          },
+          execute: async (params = {}) => placeOrder('dark-roast-espresso', params, true)
+        },
+        {
+          name: 'order_cold_brew',
+          description: 'Order an 18-hour steeped Cold Brew coffee with customizable size, milk/creamer, quantity, and special instructions.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size: Small ($4.25), Medium ($4.75), or Large ($5.50).'
+              },
+              quantity: {
+                type: 'integer',
+                minimum: 1,
+                maximum: 20,
+                description: 'Number of Cold Brew coffees to order (default: 1).'
+              },
+              milk: {
+                type: 'string',
+                enum: ['None', 'Oat Milk', 'Whole Milk', 'Almond Milk', 'Sweet Cream'],
+                description: 'Optional milk or creamer (default: None).'
+              },
+              notes: {
+                type: 'string',
+                description: 'Optional special instructions (e.g., light ice, vanilla syrup).'
+              }
+            }
+          },
+          execute: async (params = {}) => placeOrder('cold-brew', params, true)
+        },
+        {
+          name: 'order_seasonal_coffee',
+          description: 'Order any Seasonal Favorite coffee (Maple Oat Latte, Dark Roast Espresso, or Cold Brew) with size, milk, quantity, and special instructions.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              item: {
+                type: 'string',
+                enum: ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'],
+                description: 'Which Seasonal Favorite coffee to order.'
+              },
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size (Small, Medium, or Large).'
+              },
+              quantity: {
+                type: 'integer',
+                minimum: 1,
+                maximum: 20,
+                description: 'Number of drinks to order (default: 1).'
+              },
+              milk: {
+                type: 'string',
+                description: 'Milk or creamer option (e.g., Oat Milk, Whole Milk, Almond Milk, Sweet Cream, None).'
+              },
+              notes: {
+                type: 'string',
+                description: 'Optional special instructions.'
+              }
+            },
+            required: ['item']
+          },
+          execute: async (params = {}) => {
+            const key = resolveItemKey(params.item || params.drink || params.coffee);
+            if (!key) {
+              const msg = 'Please specify a valid Seasonal Favorite: Maple Oat Latte, Dark Roast Espresso, or Cold Brew.';
+              return { status: 'error', message: msg, content: [{ type: 'text', text: msg }] };
+            }
+            return placeOrder(key, params, true);
+          }
+        },
+        {
+          name: 'get_coffee_order_summary',
+          description: 'Retrieve the current coffee order summary, cart items, and total price.',
+          inputSchema: {
+            type: 'object',
+            properties: {}
+          },
+          execute: async () => {
+            const totalItems = orders.reduce((sum, item) => sum + item.quantity, 0);
+            const totalPrice = Number(orders.reduce((sum, item) => sum + item.lineTotal, 0).toFixed(2));
+            const summaryText = orders.length === 0
+              ? 'Your order is currently empty.'
+              : `Order has ${totalItems} item(s) totaling $${totalPrice.toFixed(2)}.`;
+            return {
+              status: 'success',
+              totalItems,
+              totalPrice,
+              items: orders.slice(),
+              content: [{ type: 'text', text: summaryText }]
+            };
+          }
+        }
+      ];
+
+      async function registerWebMcpTools() {
+        const contexts = [
+          typeof navigator !== 'undefined' ? navigator.modelContext : null,
+          typeof document !== 'undefined' ? document.modelContext : null
+        ].filter(Boolean);
+
+        const uniqueContexts = Array.from(new Set(contexts));
+        for (const ctx of uniqueContexts) {
+          if (typeof ctx.registerTool === 'function') {
+            for (const toolDef of itemToolDefinitions) {
+              try {
+                await ctx.registerTool(toolDef);
+              } catch (_err) {
+                // Ignore if already registered by Declarative WebMCP <form toolname="...">
+              }
+            }
+          }
+        }
+      }
+
+      registerWebMcpTools();
+    })();
+  </script>
 </body>
 
 </html>
