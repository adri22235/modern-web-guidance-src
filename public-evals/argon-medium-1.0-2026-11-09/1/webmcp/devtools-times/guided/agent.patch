diff --git a/src/components/ArticleUtilities.tsx b/src/components/ArticleUtilities.tsx
new file mode 100644
index 0000000..611d919
--- /dev/null
+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,180 @@
+import React, { useState } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  category: string;
+  publishedDate: string;
+  readingTime?: number;
+}
+
+const SHARE_CHANNELS = ['copy_link', 'email', 'x', 'facebook'] as const;
+type ShareChannel = (typeof SHARE_CHANNELS)[number];
+
+const CURRENT_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {},
+} as const;
+
+const ARTICLE_POPULARITY_SCHEMA = {
+  type: 'object',
+  properties: {
+    id: {
+      type: 'string',
+      description:
+        'URL slug of the article to inspect popularity metrics for. Defaults to the current article when omitted.',
+    },
+  },
+} as const;
+
+const SHARE_ARTICLE_SCHEMA = {
+  type: 'object',
+  properties: {
+    channel: {
+      type: 'string',
+      enum: SHARE_CHANNELS,
+      default: 'copy_link',
+      description: 'Destination platform or method used to share the article.',
+    },
+  },
+} as const;
+
+export default function ArticleUtilities({
+  slug,
+  title,
+  summary,
+  author,
+  category,
+  publishedDate,
+  readingTime,
+}: Props) {
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [popularity, setPopularity] = useState<{ views: number; trending: boolean } | null>(null);
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article',
+    description:
+      'Retrieves metadata, estimated reading time, and full body text of the article currently displayed on the page. Use when the user asks about the current article.',
+    inputSchema: CURRENT_ARTICLE_SCHEMA,
+    execute() {
+      const proseElement =
+        typeof document !== 'undefined' ? document.querySelector('article .prose') : null;
+      const content = proseElement?.textContent?.trim() ?? '';
+      const url = typeof window !== 'undefined' ? window.location.href : '';
+
+      return {
+        slug,
+        title,
+        summary,
+        author,
+        category,
+        publishedDate,
+        readingTime: readingTime ?? null,
+        content,
+        url,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ id?: string }, unknown>({
+    name: 'get_article_popularity',
+    description:
+      'Fetches view count and trending status for an article. Use when the user asks how popular an article is or whether it is trending.',
+    inputSchema: ARTICLE_POPULARITY_SCHEMA,
+    async execute({ id = slug } = {}, { signal }) {
+      const targetId = typeof id === 'string' && id.trim().length > 0 ? id.trim() : slug;
+      if (!targetId) {
+        return { error: 'Pass a valid article identifier to check popularity.' };
+      }
+
+      const previousPopularity = popularity;
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(targetId)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          return { error: `Request failed with status ${response.status}` };
+        }
+        const data = await response.json();
+        if (targetId === slug && typeof data.views === 'number') {
+          setPopularity({ views: data.views, trending: Boolean(data.trending) });
+        }
+        return data;
+      } catch (err) {
+        setPopularity(previousPopularity);
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  useWebMCP<{ channel?: ShareChannel }, unknown>({
+    name: 'share_article',
+    description:
+      'Prepares a shareable link for the current article or copies its URL to the clipboard. Use when the user wants to share the article.',
+    inputSchema: SHARE_ARTICLE_SCHEMA,
+    async execute({ channel = 'copy_link' } = {}) {
+      if (typeof channel !== 'string' || !SHARE_CHANNELS.includes(channel as ShareChannel)) {
+        return {
+          error: 'Pass a supported sharing channel.',
+          channels: SHARE_CHANNELS,
+        };
+      }
+
+      const articleUrl =
+        typeof window !== 'undefined'
+          ? window.location.href
+          : `${import.meta.env.BASE_URL}articles/${slug}`;
+
+      let shareUrl = articleUrl;
+      if (channel === 'email') {
+        shareUrl = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${summary}\n\n${articleUrl}`)}`;
+      } else if (channel === 'x') {
+        shareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(articleUrl)}`;
+      } else if (channel === 'facebook') {
+        shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`;
+      } else if (channel === 'copy_link' && typeof navigator !== 'undefined' && navigator.clipboard) {
+        try {
+          await navigator.clipboard.writeText(articleUrl);
+        } catch {
+          // Clipboard access may require active user gesture
+        }
+      }
+
+      setStatusMessage(
+        channel === 'copy_link' ? 'Link copied!' : `Share link ready for ${channel}`
+      );
+
+      return {
+        slug,
+        title,
+        channel,
+        shareUrl,
+      };
+    },
+    annotations: { readOnlyHint: true },
+  });
+
+  return (
+    <div className="flex items-center gap-3 text-xs text-gray-500">
+      {popularity && (
+        <span data-testid="article-popularity">
+          {popularity.views.toLocaleString()} views{popularity.trending ? ' • Trending' : ''}
+        </span>
+      )}
+      {statusMessage && (
+        <span role="status" className="text-amber-700 font-medium">
+          {statusMessage}
+        </span>
+      )}
+    </div>
+  );
+}
