+  <script>
+    (function () {
+      function toUint8Array(input) {
+        if (input instanceof Uint8Array) {
+          return input;
+        }
+        if (input instanceof ArrayBuffer) {
+          return new Uint8Array(input);
+        }
+        if (ArrayBuffer.isView(input)) {
+          return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+        }
+        if (Array.isArray(input)) {
+          return new Uint8Array(input);
+        }
+        if (typeof input === 'string') {
+          const base64 = input.replace(/-/g, '+').replace(/_/g, '/');
+          const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+          try {
+            const binary = atob(padded);
+            const bytes = new Uint8Array(binary.length);
+            for (let i = 0; i < binary.length; i++) {
+              bytes[i] = binary.charCodeAt(i);
+            }
+            return bytes;
+          } catch {
+            return new TextEncoder().encode(input);
+          }
+        }
+        return new Uint8Array(0);
+      }
+
+      function bufferToBase64url(buffer) {
+        if (typeof buffer === 'string') {
+          return buffer;
+        }
+        if (!buffer) {
+          return null;
+        }
+        const bytes =
+          buffer instanceof Uint8Array
+            ? buffer
+            : ArrayBuffer.isView(buffer)
+              ? new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength)
+              : buffer instanceof ArrayBuffer
+                ? new Uint8Array(buffer)
+                : Array.isArray(buffer)
+                  ? new Uint8Array(buffer)
+                  : new Uint8Array(0);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeAssertion(credential) {
+        const resp = (credential && credential.response) || {};
+        const payload = {
+          ...(credential || {}),
+          id: (credential && credential.id) || bufferToBase64url(credential && credential.rawId),
+          rawId: bufferToBase64url((credential && credential.rawId) || (credential && credential.id)),
+          type: (credential && credential.type) || 'public-key',
+          clientExtensionResults:
+            credential && typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : (credential && credential.clientExtensionResults) || {},
+          response: {
+            ...resp,
+            clientDataJSON: bufferToBase64url(resp.clientDataJSON),
+            authenticatorData: bufferToBase64url(resp.authenticatorData),
+            signature: bufferToBase64url(resp.signature),
+            userHandle: resp.userHandle != null ? bufferToBase64url(resp.userHandle) : null,
+          },
+        };
+        if (credential && credential.authenticatorAttachment) {
+          payload.authenticatorAttachment = credential.authenticatorAttachment;
+        }
+        return payload;
+      }
+
+      const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+      const reauthStatus = document.getElementById('reauth-status');
+
+      if (reauthButton) {
+        reauthButton.addEventListener('click', async () => {
+          if (reauthStatus) {
+            reauthStatus.textContent = 'Starting identity verification...';
+          }
+          try {
+            const optionsResponse = await fetch('/api/reauth/options', {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json',
+              },
+              credentials: 'same-origin',
+            });
+
+            if (!optionsResponse.ok) {
+              throw new Error('Failed to fetch re-authentication options');
+            }
+
+            const optionsData = await optionsResponse.json();
+            const rawOptions =
+              optionsData && optionsData.publicKey ? optionsData.publicKey : optionsData || {};
+
+            const allowCredentials = Array.isArray(rawOptions.allowCredentials)
+              ? rawOptions.allowCredentials.map((cred) => ({
+                  ...cred,
+                  type: cred.type || 'public-key',
+                  id: toUint8Array(cred.id),
+                }))
+              : [];
+
+            const publicKey = {
+              ...rawOptions,
+              challenge: toUint8Array(rawOptions.challenge),
+              allowCredentials,
+              userVerification: rawOptions.userVerification || 'required',
+            };
+
+            const credential = await navigator.credentials.get({ publicKey });
+            if (!credential) {
+              throw new Error('No credential returned from verification ceremony');
+            }
+
+            const verificationPayload = serializeAssertion(credential);
+
+            const verifyResponse = await fetch('/api/reauth/verify', {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json',
+              },
+              credentials: 'same-origin',
+              body: JSON.stringify(verificationPayload),
+            });
+
+            if (!verifyResponse.ok) {
+              throw new Error('Identity verification failed');
+            }
+
+            if (reauthStatus) {
+              reauthStatus.textContent = 'Identity verified. Sensitive account changes unlocked.';
+            }
+          } catch (error) {
+            if (reauthStatus) {
+              reauthStatus.textContent =
+                error && error.message ? error.message : 'Verification could not be completed.';
+            }
+          }
+        });
+      }
+    })();
+  </script>
