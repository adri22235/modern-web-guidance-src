+  // Calculate SHA-256 hash over the EVT + trailing tilde ("<evtJwt>~")
+  const evtWithTilde = `${ parts.slice(0, -1).join('~') }~`;
+  const calculatedHash = createHash('sha256')
+    .update(evtWithTilde)
+    .digest('base64url');
+
+  if (calculatedHash !== kbJwtDecodedPayload.sd_hash) {
+    throw new Error('Invalid "sd_hash": KB-JWT hash does not match EVT.');
+  }
+
+  // Verify the KB-JWT signature using the ephemeral public key from evtJwtDecodedPayload.cnf.jwk
+  const holderPublicKey = await importJWK(
+    evtJwtDecodedPayload.cnf.jwk,
+    kbHeader.alg || evtJwtDecodedPayload.cnf.jwk.alg
+  );
+
+  await jwtVerify(kbJwt, holderPublicKey, {
+    typ: 'kb+jwt',
+    audience: expectedAudience || undefined,
+  });
+
+  // =========================================================================
+  // Step 4: Validate DNS Delegation Record (_email-verification.<email-domain>)
+  // =========================================================================
+  const emailParts = expectedEmail.trim().toLowerCase().split('@');
+  if (emailParts.length !== 2 || !emailParts[1]) {
+    throw new Error('Invalid email address domain.');
+  }
+  const emailDomain = emailParts[1];
+  const dnsRecordName = `_email-verification.${emailDomain}`;
+
+  let txtRecords;
+  try {
+    txtRecords = await resolveDnsTxt(dnsRecordName);
+  } catch (err) {
+    throw new Error(
+      `DNS lookup failed for ${dnsRecordName}: ${err.message}`
+    );
+  }
+
+  const normalizedEvtIssuer = normalizeIssuerUrl(evtJwtDecodedPayload.iss);
+  const authorizedIssuers = txtRecords
+    .map((chunks) => (Array.isArray(chunks) ? chunks.join('') : String(chunks)).trim())
+    .filter((entry) => entry.startsWith('iss='))
+    .map((entry) => normalizeIssuerUrl(entry.slice('iss='.length)));
+
+  if (!authorizedIssuers.includes(normalizedEvtIssuer)) {
+    throw new Error(
+      `DNS TXT record for ${dnsRecordName} does not authorize issuer "${evtJwtDecodedPayload.iss}".`
+    );
+  }
+
+  // =========================================================================
+  // Step 5: Discover the Issuer & Verify the EVT Signature
+  // =========================================================================
+  const wellKnownUrl = new URL(
+    '/.well-known/email-verification',
+    normalizedEvtIssuer
+  ).toString();
+
+  const metadataResponse = await fetchImpl(wellKnownUrl, {
+    headers: { Accept: 'application/json' },
+  });
+  if (!metadataResponse.ok) {
+    throw new Error(
+      `Failed to fetch issuer metadata from ${wellKnownUrl} (HTTP ${metadataResponse.status}).`
+    );
+  }
+
+  const issuerMetadata = await metadataResponse.json();
+  if (!issuerMetadata.jwks_uri) {
+    throw new Error('Issuer metadata is missing required "jwks_uri" property.');
+  }
+
+  if (
+    issuerMetadata.issuer &&
+    normalizeIssuerUrl(issuerMetadata.issuer) !== normalizedEvtIssuer
+  ) {
+    throw new Error(
+      `Issuer metadata "issuer" (${issuerMetadata.issuer}) does not match EVT "iss" (${evtJwtDecodedPayload.iss}).`
+    );
+  }
+
+  if (
+    Array.isArray(issuerMetadata.signing_alg_values_supported) &&
+    evtHeader.alg &&
+    !issuerMetadata.signing_alg_values_supported.includes(evtHeader.alg)
+  ) {
+    throw new Error(
+      `EVT signing algorithm "${evtHeader.alg}" is not listed in issuer signing_alg_values_supported.`
+    );
+  }
+
+  // Verify the EVT signature against the issuer's JWKS.
+  // Support both kid-matched JWKS via createRemoteJWKSet and iterating JWKs if kid is omitted.
+  const jwksUrl = new URL(issuerMetadata.jwks_uri, normalizedEvtIssuer);
+  if (evtHeader.kid && fetchImpl === fetch) {
+    const JWKS = createRemoteJWKSet(jwksUrl);
+    await jwtVerify(evtJwt, JWKS, {
+      issuer: evtJwtDecodedPayload.iss,
+    });
+  } else {
+    const jwksResponse = await fetchImpl(jwksUrl.toString(), {
+      headers: { Accept: 'application/json' },
+    });
+    if (!jwksResponse.ok) {
+      throw new Error(
+        `Failed to fetch issuer JWKS from ${jwksUrl} (HTTP ${jwksResponse.status}).`
+      );
+    }
+    const jwks = await jwksResponse.json();
+    if (!jwks || !Array.isArray(jwks.keys) || jwks.keys.length === 0) {
+      throw new Error('Issuer JWKS contains no keys.');
+    }
+
+    const candidateKeys = evtHeader.kid
+      ? jwks.keys.filter((k) => k.kid === evtHeader.kid)
+      : jwks.keys;
+
+    if (candidateKeys.length === 0) {
+      throw new Error(`No matching key found in issuer JWKS for kid "${evtHeader.kid}".`);
+    }
+
+    let verified = false;
+    let lastVerifyError = null;
+    for (const jwk of candidateKeys) {
+      try {
+        const key = await importJWK(jwk, evtHeader.alg || jwk.alg);
+        await jwtVerify(evtJwt, key, {
+          issuer: evtJwtDecodedPayload.iss,
+        });
+        verified = true;
+        break;
+      } catch (err) {
+        lastVerifyError = err;
+      }
+    }
+
+    if (!verified) {
+      throw new Error(
+        `EVT signature verification failed: ${lastVerifyError ? lastVerifyError.message : 'invalid signature'}`
+      );
+    }
+  }
+
+  return {
+    verified: true,
+    email: evtJwtDecodedPayload.email,
+    issuer: evtJwtDecodedPayload.iss,
+    evtJwtDecodedPayload,
+    kbJwtDecodedPayload,
+  };
+}
+
+/**
+ * Helper to determine the expected origin for the current request.
+ */
+function getExpectedOrigin(req) {
+  if (req.headers.origin) {
+    return req.headers.origin;
+  }
+  const proto = req.headers['x-forwarded-proto'] || req.protocol || 'http';
+  const host = req.headers['x-forwarded-host'] || req.get('host') || 'localhost:11222';
+  return `${proto}://${host}`;
+}
+
+/**
+ * Serve the homepage with a fresh server-generated nonce injected into the
+ * <input type="hidden" autocomplete="email-verification-token" nonce="..."> element.
+ */
+async function serveHomepage(req, res) {
+  try {
+    const { nonce } = createSessionNonce(req, res);
+    const htmlPath = path.join(__dirname, 'index.html');
+    let html = await readFile(htmlPath, 'utf-8');
+
+    // Inject the fresh server-generated nonce into the email-verification-token input
+    html = html.replace(
+      /(<input[^>]*autocomplete=["']email-verification-token["'][^>]*nonce=["'])[^"']*(['"][^>]*>)/i,
+      `$1${nonce}$2`
+    );
+    html = html.replace(
+      /(<input[^>]*nonce=["'])[^"']*(['"][^>]*autocomplete=["']email-verification-token["'][^>]*>)/i,
+      `$1${nonce}$2`
+    );
+
+    res.setHeader('Content-Type', 'text/html; charset=utf-8');
+    res.send(html);
+  } catch (err) {
+    res.status(500).send(`Error loading homepage: ${err.message}`);
+  }
+}
+
+app.get('/', serveHomepage);
+app.get('/index.html', serveHomepage);
+
+/**
+ * Endpoint to issue a fresh session-bound nonce for the Email Verification API form.
+ */
+app.get('/api/nonce', (req, res) => {
+  const { nonce } = createSessionNonce(req, res);
+  res.json({ nonce });
+});
+
+/**
+ * Shared handler for verifying an Email Verification Token and/or registering a rewards account.
+ */
+async function handleRewardsVerificationAndSignup(req, res) {
+  const {
+    name = '',
+    email = '',
+    favoriteDrink = '',
+    birthday = '',
+    evt,
+    token,
+    emailVerificationToken,
+    presentationToken,
+  } = req.body || {};
+
+  const submittedEmail = String(email).trim();
+  if (!submittedEmail || !submittedEmail.includes('@')) {
+    return res.status(400).json({
+      ok: false,
+      verified: false,
+      error: 'Please provide a valid email address.',
+    });
+  }
+
+  const rawToken =
+    evt || token || emailVerificationToken || presentationToken || '';
+
+  const expectedAudience = getExpectedOrigin(req);
+
+  // If the browser supplied an Email Verification Token (EVP), cryptographically verify it
+  if (rawToken) {
+    try {
+      const verification = await validateEmailVerificationToken({
+        token: rawToken,
+        expectedEmail: submittedEmail,
+        expectedAudience,
+        verifyNonce: (tokenNonce) => consumeSessionNonce(req, tokenNonce),
+      });
+
+      const account = {
+        id: randomUUID(),
+        name: String(name).trim() || 'Coffee Lover',
+        email: verification.email,
+        favoriteDrink: String(favoriteDrink).trim() || 'Maple Oat Latte',
+        birthday: String(birthday).trim() || null,
+        email_verified: true,
+        verificationMethod: 'email-verification-protocol',
+        issuer: verification.issuer,
+        points: 100, // Welcome bonus points for verified rewards signup
+        createdAt: new Date().toISOString(),
+      };
+
+      rewardsAccounts.set(account.email.toLowerCase(), account);
+
+      // Issue a fresh nonce in case the page needs another form submission
+      const { nonce: nextNonce } = createSessionNonce(req, res);
+
+      return res.status(200).json({
+        ok: true,
+        verified: true,
+        email_verified: true,
+        message:
+          'Your email was instantly verified by your browser! Welcome to Daily Grind Rewards.',
+        account,
+        nextNonce,
+      });
+    } catch (err) {
+      const { nonce: nextNonce } = createSessionNonce(req, res);
+      return res.status(400).json({
+        ok: false,
+        verified: false,
+        email_verified: false,
+        error: err.message,
+        nextNonce,
+      });
+    }
+  }
+
+  // Progressive enhancement fallback when browser does not provide an EVP token
+  const account = {
+    id: randomUUID(),
+    name: String(name).trim() || 'Coffee Lover',
+    email: submittedEmail,
+    favoriteDrink: String(favoriteDrink).trim() || 'Maple Oat Latte',
+    birthday: String(birthday).trim() || null,
+    email_verified: false,
+    verificationMethod: 'unverified-fallback',
+    issuer: null,
+    points: 50,
+    createdAt: new Date().toISOString(),
+  };
+
+  rewardsAccounts.set(account.email.toLowerCase(), account);
+  const { nonce: nextNonce } = createSessionNonce(req, res);
+
+  return res.status(200).json({
+    ok: true,
+    verified: false,
+    email_verified: false,
+    message:
+      'Account created! Your browser did not attach an Email Verification Token, so your email is currently unverified.',
+    account,
+    nextNonce,
+  });
+}
+
+// Support multiple standard endpoint paths for verification and signup
+app.post('/api/rewards/signup', handleRewardsVerificationAndSignup);
+app.post('/api/verify-email', handleRewardsVerificationAndSignup);
+app.post('/verify-email', handleRewardsVerificationAndSignup);
+app.post('/signup', handleRewardsVerificationAndSignup);
+
+// Serve static assets if any
+app.use(express.static(__dirname, { index: false }));
+
+const PORT = process.env.PORT || 11222;
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  app.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
+
+export default app;
