+  try {
+    evtHeader = decodeProtectedHeader(evtJwt);
+    evtJwtDecodedPayload = decodeJwt(evtJwt);
+    kbHeader = decodeProtectedHeader(kbJwt);
+    kbJwtDecodedPayload = decodeJwt(kbJwt);
+  } catch (err) {
+    throw new Error(`Failed to decode EVT or KB-JWT: ${err.message}`);
+  }
