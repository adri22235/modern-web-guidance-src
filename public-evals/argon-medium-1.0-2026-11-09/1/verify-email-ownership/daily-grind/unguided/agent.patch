+} from 'jose';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const app = express();
+app.use(express.json());
+app.use(express.urlencoded({ extended: true }));
+
+// In-memory stores for session nonces and registered rewards members
+const sessionNonces = new Map();
+const rewardsAccounts = new Map();
+
+const NONCE_TTL_MS = 10 * 60 * 1000; // 10 minutes
+const MAX_TOKEN_AGE_SECONDS = 5 * 60; // 5 minutes
+
+/**
+ * Generates a cryptographically strong random nonce (at least 128 bits of entropy).
+ */
+export function generateNonce() {
+  return randomBytes(24).toString('base64url');
+}
+
+/**
+ * Parses cookies from the Cookie request header.
+ */
+function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const pair of cookieHeader.split(';')) {
+    const idx = pair.indexOf('=');
+    if (idx > -1) {
+      const key = pair.slice(0, idx).trim();
+      const val = pair.slice(idx + 1).trim();
+      cookies[key] = decodeURIComponent(val);
+    }
+  }
+  return cookies;
+}
+
+/**
+ * Gets or creates a session ID and binds a fresh one-time nonce to the session.
+ */
+function createSessionNonce(req, res) {
+  const cookies = parseCookies(req.headers.cookie);
+  let sessionId = cookies.dg_session_id;
+  if (!sessionId) {
+    sessionId = randomUUID();
+    res.setHeader(
+      'Set-Cookie',
+      `dg_session_id=${sessionId}; Path=/; HttpOnly; SameSite=Lax`
+    );
+  }
+
+  const nonce = generateNonce();
+  sessionNonces.set(sessionId, {
+    nonce,
+    createdAt: Date.now(),
+  });
+
+  // Also index by nonce value directly to support stateless/form fallback lookup
+  sessionNonces.set(`nonce:${nonce}`, {
+    nonce,
+    sessionId,
+    createdAt: Date.now(),
+  });
+
+  // Prevent caching so back/forward navigation never reuses a consumed nonce
+  res.setHeader('Cache-Control', 'no-store');
+  return { sessionId, nonce };
+}
+
+/**
+ * Consumes and validates a one-time session nonce to prevent replay attacks.
+ */
+function consumeSessionNonce(req, tokenNonce) {
+  if (!tokenNonce || typeof tokenNonce !== 'string') {
+    return false;
+  }
+
+  const cookies = parseCookies(req.headers.cookie);
+  const sessionId = cookies.dg_session_id;
+  const now = Date.now();
+
+  if (sessionId && sessionNonces.has(sessionId)) {
+    const record = sessionNonces.get(sessionId);
+    // Delete immediately upon verification attempt (single-use nonce)
+    sessionNonces.delete(sessionId);
+    sessionNonces.delete(`nonce:${record.nonce}`);
+    if (now - record.createdAt <= NONCE_TTL_MS && record.nonce === tokenNonce) {
+      return true;
+    }
+    return false;
+  }
+
+  const directKey = `nonce:${tokenNonce}`;
+  if (sessionNonces.has(directKey)) {
+    const record = sessionNonces.get(directKey);
+    sessionNonces.delete(directKey);
+    if (record.sessionId) {
+      sessionNonces.delete(record.sessionId);
+    }
+    if (now - record.createdAt <= NONCE_TTL_MS) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+/**
+ * Normalizes an issuer identifier into an https:// origin URL.
+ */
+function normalizeIssuerUrl(iss) {
+  const trimmed = iss.trim();
+  if (trimmed.startsWith('https://') || trimmed.startsWith('http://')) {
+    return trimmed.replace(/\/+$/, '');
+  }
+  return `https://${trimmed.replace(/\/+$/, '')}`;
