+          'Account registration received! If your browser did not verify your email automatically, check your inbox for a confirmation link.';
+        statusBox.classList.add('status-success');
+        statusBox.hidden = false;
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
 </html>
