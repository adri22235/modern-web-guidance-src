+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const messageInput = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const resultEl = document.getElementById('detection-result');
+
+    feedbackForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+    });
+
+    messageInput.addEventListener('input', () => {
+      if (messageInput.getAttribute('aria-invalid') === 'true' && messageInput.value.trim()) {
+        messageInput.removeAttribute('aria-invalid');
+      }
+    });
+
+    let detectorInstance = null;
+
+    async function setupLanguageDetection() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        resultEl.textContent = 'Client-side language detection is currently unsupported in this browser.';
+        return;
+      }
+
+      const availability = await LanguageDetector.availability();
+
+      if (availability !== 'unavailable') {
+        detectBtn.addEventListener('click', async () => {
+          const someUserText = messageInput.value.trim();
+          if (!someUserText) {
+            messageInput.setAttribute('aria-invalid', 'true');
+            resultEl.textContent = 'Please enter a message before detecting its language.';
+            messageInput.focus();
+            return;
+          }
+
+          messageInput.removeAttribute('aria-invalid');
+          detectBtn.disabled = true;
+          resultEl.textContent = 'Detecting language...';
+
+          try {
+            if (!detectorInstance) {
+              detectorInstance = await LanguageDetector.create({
+                monitor(m) {
+                  m.addEventListener('downloadprogress', (e) => {
+                    console.log(`Downloaded ${e.loaded * 100}%`);
+                    const pct = Math.round((e.loaded || 0) * 100);
+                    resultEl.textContent = `Downloading language model (${pct}%)...`;
+                  });
+                },
+              });
+            }
+
+            const results = await detectorInstance.detect(someUserText);
+            for (const result of results) {
+              console.log(result.detectedLanguage, result.confidence);
+            }
+
+            if (results && results.length > 0) {
+              const topResult = results[0];
+              const langCode = topResult.detectedLanguage;
+              const confidencePct = (topResult.confidence * 100).toFixed(1);
+              let langName = langCode;
+              try {
+                const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+                langName = displayNames.of(langCode) || langCode;
+              } catch {
+                // Keep raw language tag if DisplayNames cannot format it
+              }
+              messageInput.setAttribute('lang', langCode);
+              resultEl.textContent = `Detected language: ${langName} (${langCode}) — ${confidencePct}% confidence`;
+            } else {
+              resultEl.textContent = 'Could not detect the language of the message.';
+            }
+          } catch (error) {
+            console.error('Language detection failed:', error);
+            resultEl.textContent = 'Unable to detect language at this time.';
+          } finally {
+            detectBtn.disabled = false;
+          }
+        });
+      } else {
+        detectBtn.disabled = true;
+        resultEl.textContent = 'Client-side language detection is currently unavailable on this device.';
+      }
+    }
+
+    setupLanguageDetection();
+  </script>
+
