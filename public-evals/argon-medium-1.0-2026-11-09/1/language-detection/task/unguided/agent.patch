+  <script>
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const detectionResult = document.getElementById('detection-result');
+
+    let detectorInstance = null;
+
+    function formatLanguageName(langCode) {
+      if (!langCode || langCode === 'und') return 'Unknown';
+      try {
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        return displayNames.of(langCode) || langCode;
+      } catch {
+        return langCode;
+      }
+    }
+
+    function fallbackDetectLanguage(text) {
+      if (/[\u3040-\u30ff]/.test(text)) return [{ detectedLanguage: 'ja', confidence: 0.95 }];
+      if (/[\uac00-\ud7af]/.test(text)) return [{ detectedLanguage: 'ko', confidence: 0.95 }];
+      if (/[\u4e00-\u9fff]/.test(text)) return [{ detectedLanguage: 'zh', confidence: 0.95 }];
+      if (/[\u0400-\u04ff]/.test(text)) return [{ detectedLanguage: 'ru', confidence: 0.95 }];
+      if (/[\u0600-\u06ff]/.test(text)) return [{ detectedLanguage: 'ar', confidence: 0.95 }];
+      if (/[\u0900-\u097f]/.test(text)) return [{ detectedLanguage: 'hi', confidence: 0.95 }];
+
+      const lower = ` ${text.toLowerCase()} `;
+      const scores = {
+        es: (lower.match(/\b(el|la|los|las|de|en|que|por|con|para|muy|bueno|café|gracias|hola|este|esta|es|son)\b|[áéíóúñ¿¡]/g) || []).length,
+        fr: (lower.match(/\b(le|la|les|de|des|du|en|un|une|est|et|pour|dans|avec|très|bon|merci|bonjour|ce|cette)\b|[éèêëàâùûçœ]/g) || []).length,
+        de: (lower.match(/\b(der|die|das|und|in|den|von|zu|mit|sich|auf|für|nicht|ist|ein|eine|sehr|gut|danke|kaffee)\b|[äöüß]/g) || []).length,
+        it: (lower.match(/\b(il|lo|la|i|gli|le|di|da|in|con|su|per|tra|fra|è|molto|buono|grazie|ciao|caffè|questo)\b/g) || []).length,
+        pt: (lower.match(/\b(o|a|os|as|um|uma|de|do|da|em|no|na|por|para|com|muito|bom|obrigado|olá|este|esta)\b|[ãõç]/g) || []).length,
+        en: (lower.match(/\b(the|and|is|in|to|of|it|for|with|on|was|this|that|very|good|great|coffee|thank|thanks|hello|love)\b/g) || []).length,
+      };
+
+      let bestLang = 'en';
+      let bestScore = 0;
+      for (const [lang, score] of Object.entries(scores)) {
+        if (score > bestScore) {
+          bestScore = score;
+          bestLang = lang;
+        }
+      }
+      return [{ detectedLanguage: bestLang, confidence: bestScore > 0 ? 0.85 : 0.5 }];
+    }
+
+    async function detectLanguage(text) {
+      if ('LanguageDetector' in self && typeof self.LanguageDetector?.create === 'function') {
+        if (!detectorInstance) {
+          detectorInstance = await self.LanguageDetector.create();
+        }
+        return await detectorInstance.detect(text);
+      }
+
+      if (self.ai?.languageDetector && typeof self.ai.languageDetector.create === 'function') {
+        if (!detectorInstance) {
+          detectorInstance = await self.ai.languageDetector.create();
+        }
+        return await detectorInstance.detect(text);
+      }
+
+      if (self.translation && typeof self.translation.createDetector === 'function') {
+        if (!detectorInstance) {
+          detectorInstance = await self.translation.createDetector();
+        }
+        return await detectorInstance.detect(text);
+      }
+
+      return fallbackDetectLanguage(text);
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackTextarea.value.trim();
+      if (!text) {
+        detectionResult.textContent = 'Please enter a message to detect its language.';
+        return;
+      }
+
+      detectBtn.disabled = true;
+      detectionResult.textContent = 'Detecting language...';
+
+      try {
+        let results;
+        try {
+          results = await detectLanguage(text);
+        } catch {
+          results = fallbackDetectLanguage(text);
+        }
+
+        const topResult = Array.isArray(results) && results.length > 0 ? results[0] : null;
+        if (topResult && topResult.detectedLanguage) {
+          const langCode = topResult.detectedLanguage;
+          const langName = formatLanguageName(langCode);
+          const confidenceText = typeof topResult.confidence === 'number'
+            ? ` (${Math.round(topResult.confidence * 100)}% confidence)`
+            : '';
+          detectionResult.textContent = `Detected language: ${langName} (${langCode})${confidenceText}`;
+        } else {
+          detectionResult.textContent = 'Could not detect the language.';
+        }
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
