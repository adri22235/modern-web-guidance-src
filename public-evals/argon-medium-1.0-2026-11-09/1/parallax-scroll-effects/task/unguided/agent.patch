+  <script>
+    (function () {
+      const section = document.getElementById('craft-parallax');
+      if (!section) return;
+
+      const layers = Array.from(section.querySelectorAll('[data-parallax-speed]')).map(function (el) {
+        return {
+          el: el,
+          speed: parseFloat(el.getAttribute('data-parallax-speed')) || 0
+        };
+      });
+
+      const toggleBtn = document.getElementById('parallax-motion-toggle');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      let userPaused = false;
+      let isIntersecting = true;
+      let rafId = null;
+
+      function isMotionDisabled() {
+        return reducedMotionQuery.matches || userPaused;
+      }
+
+      function resetTransforms() {
+        for (let i = 0; i < layers.length; i++) {
+          layers[i].el.style.transform = 'translate3d(0, 0, 0)';
+        }
+      }
+
+      function updateToggleUI() {
+        if (!toggleBtn) return;
+        const disabled = isMotionDisabled();
+        toggleBtn.setAttribute('aria-pressed', String(disabled));
+        toggleBtn.textContent = disabled ? 'Enable parallax motion' : 'Pause parallax motion';
+      }
+
+      function renderParallax() {
+        rafId = null;
+        if (isMotionDisabled() || !isIntersecting) {
+          return;
+        }
+
+        const rect = section.getBoundingClientRect();
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        // Signed distance from the center of the section to the center of the viewport
+        const sectionCenter = rect.top + rect.height * 0.5;
+        const viewportCenter = viewportHeight * 0.5;
+        const deltaFromCenter = viewportCenter - sectionCenter;
+
+        for (let i = 0; i < layers.length; i++) {
+          const item = layers[i];
+          const offsetY = Math.max(-140, Math.min(140, deltaFromCenter * item.speed));
+          item.el.style.transform = 'translate3d(0, ' + offsetY.toFixed(2) + 'px, 0)';
+        }
+      }
+
+      function requestTick() {
+        if (rafId === null && !isMotionDisabled() && isIntersecting) {
+          rafId = window.requestAnimationFrame(renderParallax);
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          function (entries) {
+            for (let i = 0; i < entries.length; i++) {
+              if (entries[i].target === section) {
+                isIntersecting = entries[i].isIntersecting;
+                if (isIntersecting) {
+                  requestTick();
+                }
+              }
+            }
+          },
+          { rootMargin: '100px 0px 100px 0px' }
+        );
+        observer.observe(section);
+      }
+
+      window.addEventListener('scroll', requestTick, { passive: true });
+      window.addEventListener('resize', requestTick, { passive: true });
+
+      function handleMotionPreferenceChange() {
+        if (isMotionDisabled()) {
+          if (rafId !== null) {
+            window.cancelAnimationFrame(rafId);
+            rafId = null;
+          }
+          resetTransforms();
+        } else {
+          requestTick();
+        }
+        updateToggleUI();
+      }
+
+      if (typeof reducedMotionQuery.addEventListener === 'function') {
+        reducedMotionQuery.addEventListener('change', handleMotionPreferenceChange);
+      } else if (typeof reducedMotionQuery.addListener === 'function') {
+        reducedMotionQuery.addListener(handleMotionPreferenceChange);
+      }
+
+      if (toggleBtn) {
+        toggleBtn.addEventListener('click', function () {
+          userPaused = !userPaused;
+          handleMotionPreferenceChange();
+        });
+      }
+
+      handleMotionPreferenceChange();
+    })();
+  </script>
