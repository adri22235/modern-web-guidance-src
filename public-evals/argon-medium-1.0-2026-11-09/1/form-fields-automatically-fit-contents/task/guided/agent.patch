+
+    /* Applies horizontal auto-sizing to inputs */
+    input {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 50ch;
+    }
+
+    /* Applies vertical auto-sizing to textareas while keeping horizontal width stable */
+    .growable-textarea {
+      width: 100%;
+    }
+
+    textarea {
+      field-sizing: content;
+      height: auto;
+      width: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    /* Applies horizontal auto-sizing to select dropdowns to fit the active option */
+    select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: 50ch;
+    }
+
+    /* Fallback for browsers that do not support field-sizing: content */
+    @supports not (field-sizing: content) {
+      .growable-textarea {
+        display: grid;
+      }
+
+      .growable-textarea::after,
+      .growable-textarea > textarea {
+        grid-area: 1 / 1 / 2 / 2;
+        font: inherit;
+        padding: 0.65rem 0.75rem;
+        border: 1px solid #767676;
+      }
+
+      .growable-textarea::after {
+        content: attr(data-replicated-value) " ";
+        white-space: pre-wrap;
+        visibility: hidden;
+      }
+
+      .growable-textarea > textarea {
+        resize: none;
+        overflow: hidden;
+      }
+    }
+
