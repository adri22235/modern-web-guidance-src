+  <script>
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      transition.ready.catch(() => {});
+    }
+
+    function reorderChildren(containerEl, orderedIds) {
+      const existing = new Map(
+        Array.from(containerEl.children, (child) => [child.dataset.id, child]),
+      );
+
+      runScopedTransition(containerEl, () => {
+        for (const id of orderedIds) {
+          const child = existing.get(id);
+          if (child) containerEl.appendChild(child);
+        }
+      });
+    }
+
+    function moveSibling(scopeEl, itemEl, direction) {
+      const sibling =
+        direction < 0 ? itemEl.previousElementSibling : itemEl.nextElementSibling;
+      if (!sibling) return;
+
+      runScopedTransition(scopeEl, () => {
+        if (direction < 0) {
+          scopeEl.insertBefore(itemEl, sibling);
+        } else {
+          scopeEl.insertBefore(sibling, itemEl);
+        }
+      });
+    }
+
+    function removeItem(cardEl, itemEl) {
+      const hadFocus = itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl.nextElementSibling?.querySelector('button') ??
+        itemEl.previousElementSibling?.querySelector('button') ??
+        cardEl.querySelector('button');
+
+      runScopedTransition(cardEl, () => {
+        itemEl.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    function removeCard(gridEl, wrapperEl, sectionEl) {
+      const hadFocus = wrapperEl.contains(document.activeElement);
+      const nextFocusTarget =
+        wrapperEl.nextElementSibling?.querySelector('button') ??
+        wrapperEl.previousElementSibling?.querySelector('button') ??
+        sectionEl.querySelector('button');
+
+      runScopedTransition(gridEl, () => {
+        wrapperEl.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    function shuffleIds(containerEl) {
+      const ids = Array.from(containerEl.children, (el) => el.dataset.id);
+      if (ids.length < 2) return ids;
+      const copy = [...ids];
+      for (let i = copy.length - 1; i > 0; i--) {
+        const j = Math.floor(Math.random() * (i + 1));
+        [copy[i], copy[j]] = [copy[j], copy[i]];
+      }
+      if (copy.every((id, idx) => id === ids[idx])) {
+        copy.push(copy.shift());
+      }
+      return copy;
+    }
+
+    const sectionEl = document.getElementById('seasonal-favorites');
+    const gridEl = document.getElementById('seasonal-grid');
+
+    document.getElementById('shuffle-cards-btn')?.addEventListener('click', () => {
+      reorderChildren(gridEl, shuffleIds(gridEl));
+    });
+
+    document.getElementById('reverse-cards-btn')?.addEventListener('click', () => {
+      const reversed = Array.from(gridEl.children, (el) => el.dataset.id).reverse();
+      reorderChildren(gridEl, reversed);
+    });
+
+    gridEl?.addEventListener('click', (event) => {
+      const btn = event.target.closest('button[data-action]');
+      if (!btn) return;
+
+      const action = btn.dataset.action;
+      const wrapperEl = btn.closest('.card-wrapper');
+      const cardEl = btn.closest('.card');
+      const listEl = cardEl?.querySelector('.custom-list');
+      const itemEl = btn.closest('li');
+
+      switch (action) {
+        case 'move-card-prev':
+          if (wrapperEl) moveSibling(gridEl, wrapperEl, -1);
+          break;
+        case 'move-card-next':
+          if (wrapperEl) moveSibling(gridEl, wrapperEl, 1);
+          break;
+        case 'remove-card':
+          if (wrapperEl) removeCard(gridEl, wrapperEl, sectionEl);
+          break;
+        case 'shuffle-items':
+          if (listEl) reorderChildren(listEl, shuffleIds(listEl));
+          break;
+        case 'move-item-up':
+          if (listEl && itemEl) moveSibling(listEl, itemEl, -1);
+          break;
+        case 'move-item-down':
+          if (listEl && itemEl) moveSibling(listEl, itemEl, 1);
+          break;
+        case 'remove-item':
+          if (cardEl && itemEl) removeItem(cardEl, itemEl);
+          break;
+      }
+    });
+  </script>
 </body>
 
 </html>
