+          pricePill.textContent = computeCardPrice(cardId, size, activeItems.length);
+        }
+
+        // Update empty state & quick-add chips inside this card
+        if (itemsList) {
+          const existingEmpty = itemsList.querySelector('.custom-empty-note');
+          if (activeItems.length === 0 && !existingEmpty) {
+            const emptyLi = document.createElement('li');
+            emptyLi.className = 'custom-empty-note';
+            emptyLi.textContent = 'Standard pour — add customizations below.';
+            itemsList.appendChild(emptyLi);
+          } else if (activeItems.length > 0 && existingEmpty) {
+            existingEmpty.remove();
+          }
+        }
+
+        const activeIds = new Set(activeItems.map((li) => li.dataset.itemId));
+        const meta = ALL_CATALOG.get(cardId);
+        const quickRow = cardEl.querySelector('.quick-add-row');
+        if (quickRow && meta) {
+          quickRow.innerHTML = '';
+          meta.catalog.forEach((entry) => {
+            if (!activeIds.has(entry.id)) {
+              const btn = document.createElement('button');
+              btn.type = 'button';
+              btn.className = 'quick-add-chip';
+              btn.dataset.action = 'add-item';
+              btn.dataset.itemId = entry.id;
+              btn.dataset.itemLabel = entry.label;
+              btn.textContent = `+ ${entry.label}`;
+              quickRow.appendChild(btn);
+            }
+          });
+        }
+      }
+
+      function createCustomItemElement(cardId, item) {
+        const li = document.createElement('li');
+        li.className = 'custom-item vt-subitem';
+        li.dataset.itemId = item.id;
+        li.style.viewTransitionName = `item-${cardId}-${item.id}`;
+        li.innerHTML = `
+          <span class="custom-item-label"><span class="custom-item-dot"></span>${item.label}</span>
+          <span class="custom-item-actions">
+            <button type="button" class="item-btn" data-action="move-item-up" title="Move item up" aria-label="Move ${item.label} up">↑</button>
+            <button type="button" class="item-btn" data-action="move-item-down" title="Move item down" aria-label="Move ${item.label} down">↓</button>
+            <button type="button" class="item-btn remove-item-btn" data-action="remove-item" title="Remove item" aria-label="Remove ${item.label}">✕</button>
+          </span>
+        `;
+        return li;
+      }
+
+      function createCardElement(cardData, index) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.dataset.cardId = cardData.id;
+        card.draggable = true;
+        card.style.viewTransitionName = `card-${cardData.id}`;
+
+        const itemsHtml = cardData.items
+          .map(
+            (item) => `
+              <li class="custom-item vt-subitem" data-item-id="${item.id}" style="view-transition-name: item-${cardData.id}-${item.id};">
+                <span class="custom-item-label"><span class="custom-item-dot"></span>${item.label}</span>
+                <span class="custom-item-actions">
+                  <button type="button" class="item-btn" data-action="move-item-up" title="Move item up" aria-label="Move ${item.label} up">↑</button>
+                  <button type="button" class="item-btn" data-action="move-item-down" title="Move item down" aria-label="Move ${item.label} down">↓</button>
+                  <button type="button" class="item-btn remove-item-btn" data-action="remove-item" title="Remove item" aria-label="Remove ${item.label}">✕</button>
+                </span>
+              </li>
+            `
+          )
+          .join('');
+
+        card.innerHTML = `
+          <div class="card-topbar">
+            <div class="card-badge-group">
+              <span class="card-order-badge">#${index + 1}</span>
+              <span class="card-tag">${cardData.tag}</span>
+            </div>
+            <div class="card-controls">
+              <button type="button" class="card-ctrl-btn move-left-btn" data-action="move-card-left" title="Move card left" aria-label="Move ${cardData.title} left">←</button>
+              <button type="button" class="card-ctrl-btn move-right-btn" data-action="move-card-right" title="Move card right" aria-label="Move ${cardData.title} right">→</button>
+              <button type="button" class="card-ctrl-btn remove-card-btn" data-action="remove-card" title="Remove card" aria-label="Remove ${cardData.title}">✕</button>
+            </div>
+          </div>
+
+          <div class="card-media">
+            <img src="${cardData.image}" alt="${cardData.title}" loading="lazy">
+            <span class="card-temp-pill vt-subitem" style="view-transition-name: temp-${cardData.id};">${cardData.temp} • ${cardData.size}</span>
+            <span class="card-price-pill vt-subitem" style="view-transition-name: price-${cardData.id};">$${cardData.basePrice.toFixed(2)}</span>
+          </div>
+
+          <h3>${cardData.title}</h3>
+          <p class="card-desc">${cardData.description}</p>
+
+          <div class="card-customizer">
+            <div class="customizer-options-row">
+              <div class="option-pill-group" role="group" aria-label="Temperature">
+                <button type="button" class="option-pill ${cardData.temp === 'Hot' ? 'active' : ''}" data-action="set-temp" data-temp="Hot">Hot</button>
+                <button type="button" class="option-pill ${cardData.temp === 'Iced' ? 'active' : ''}" data-action="set-temp" data-temp="Iced">Iced</button>
+              </div>
+              <div class="option-pill-group" role="group" aria-label="Size">
+                <button type="button" class="option-pill ${cardData.size === '12oz' ? 'active' : ''}" data-action="set-size" data-size="12oz">12oz</button>
+                <button type="button" class="option-pill ${cardData.size === '16oz' ? 'active' : ''}" data-action="set-size" data-size="16oz">16oz</button>
+                <button type="button" class="option-pill ${cardData.size === '20oz' ? 'active' : ''}" data-action="set-size" data-size="20oz">20oz</button>
+              </div>
+            </div>
+
+            <div class="customizer-header">
+              <span class="customizer-title">Cup Customizations</span>
+              <div class="customizer-header-actions">
+                <button type="button" class="mini-link-btn" data-action="shuffle-items">Reorder</button>
+                <button type="button" class="mini-link-btn" data-action="reset-items">Reset</button>
+              </div>
+            </div>
+
+            <ul class="custom-items-list">${itemsHtml}</ul>
+            <div class="quick-add-row"></div>
+          </div>
+
+          <div class="card-footer">
+            <a href="${cardData.link}" class="btn">View Details</a>
+          </div>
+        `;
+
+        syncCardMetadata(card);
+        return card;
+      }
+
+      function syncGridBadgesAndStatus() {
+        const cards = Array.from(gridEl.querySelectorAll('.card'));
+        cards.forEach((card, idx) => {
+          const badge = card.querySelector('.card-order-badge');
+          if (badge) {
+            badge.textContent = `#${idx + 1}`;
+          }
+        });
+
+        const emptyBanner = gridEl.querySelector('.empty-grid-banner');
+        if (cards.length === 0 && !emptyBanner) {
+          const banner = document.createElement('div');
+          banner.className = 'empty-grid-banner';
+          banner.innerHTML = `
+            <p style="margin-bottom: 12px; font-weight: 600;">All seasonal drink cards have been removed.</p>
+            <button type="button" class="toolbar-btn accent-btn" data-action="reset-cards">↺ Restore Seasonal Favorites</button>
+          `;
+          gridEl.appendChild(banner);
+        } else if (cards.length > 0 && emptyBanner) {
+          emptyBanner.remove();
+        }
+
+        if (statusEl) {
+          statusEl.textContent = `${cards.length} ${cards.length === 1 ? 'drink' : 'drinks'} active`;
+        }
+
+        if (addCardBtn) {
+          const activeIds = new Set(cards.map((c) => c.dataset.cardId));
+          const hasAvailable = Array.from(ALL_CATALOG.keys()).some((id) => !activeIds.has(id));
+          addCardBtn.disabled = !hasAvailable;
+        }
+      }
+
+      // Section-level Toolbar & Empty Banner Click Handler (Scoped to #seasonal-grid)
+      document.getElementById('seasonal-favorites').addEventListener('click', (event) => {
+        const actionBtn = event.target.closest('[data-action]');
+        if (!actionBtn) return;
+
+        const action = actionBtn.dataset.action;
+
+        // 1. Grid-scoped actions (Reorder, Remove, Add, Shuffle, Reverse, Reset Drink Cards)
+        if (
+          action === 'move-card-left' ||
+          action === 'move-card-right' ||
+          action === 'remove-card' ||
+          action === 'shuffle-cards' ||
+          action === 'reverse-cards' ||
+          action === 'add-card' ||
+          action === 'reset-cards'
+        ) {
+          const cardEl = actionBtn.closest('.card');
+
+          runScopedViewTransition(gridEl, true, () => {
+            const cards = Array.from(gridEl.querySelectorAll('.card'));
+
+            if (action === 'move-card-left' && cardEl && cards.length > 1) {
+              const idx = cards.indexOf(cardEl);
+              if (idx > 0) {
+                gridEl.insertBefore(cardEl, cards[idx - 1]);
+              } else {
+                gridEl.appendChild(cardEl);
+              }
+            } else if (action === 'move-card-right' && cardEl && cards.length > 1) {
+              const idx = cards.indexOf(cardEl);
+              if (idx < cards.length - 1) {
+                gridEl.insertBefore(cards[idx + 1], cardEl);
+              } else {
+                gridEl.insertBefore(cardEl, cards[0]);
+              }
+            } else if (action === 'remove-card' && cardEl) {
+              cardEl.remove();
+            } else if (action === 'shuffle-cards' && cards.length > 1) {
+              const shuffled = [...cards];
+              for (let i = shuffled.length - 1; i > 0; i--) {
+                const j = Math.floor(Math.random() * (i + 1));
+                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
+              }
+              // Guarantee visual order change on every click
+              if (shuffled.every((el, idx) => el === cards[idx])) {
+                shuffled.push(shuffled.shift());
+              }
+              shuffled.forEach((el) => gridEl.appendChild(el));
+            } else if (action === 'reverse-cards' && cards.length > 1) {
+              cards.reverse().forEach((el) => gridEl.appendChild(el));
+            } else if (action === 'add-card') {
+              const activeIds = new Set(cards.map((c) => c.dataset.cardId));
+              const nextEntry = Array.from(ALL_CATALOG.values()).find((c) => !activeIds.has(c.id));
+              if (nextEntry) {
+                const newCard = createCardElement(JSON.parse(JSON.stringify(nextEntry)), cards.length);
+                gridEl.appendChild(newCard);
+              }
+            } else if (action === 'reset-cards') {
+              gridEl.innerHTML = '';
+              DEFAULT_CARDS.forEach((c, idx) => {
+                const copy = JSON.parse(JSON.stringify(c));
+                gridEl.appendChild(createCardElement(copy, idx));
+              });
+            }
+
+            syncGridBadgesAndStatus();
+          });
+
+          return;
+        }
+
+        // 2. Card-scoped actions (Independent transitions on individual .card elements so multiple cards can animate concurrently)
+        if (
+          action === 'move-item-up' ||
+          action === 'move-item-down' ||
+          action === 'remove-item' ||
+          action === 'add-item' ||
+          action === 'shuffle-items' ||
+          action === 'reset-items' ||
+          action === 'set-temp' ||
+          action === 'set-size'
+        ) {
+          const cardEl = actionBtn.closest('.card');
+          if (!cardEl) return;
+
+          const cardId = cardEl.dataset.cardId;
+          const itemsList = cardEl.querySelector('.custom-items-list');
+          const itemEl = actionBtn.closest('.custom-item');
+
+          runScopedViewTransition(cardEl, false, () => {
+            if (action === 'move-item-up' && itemEl && itemsList) {
+              const items = Array.from(itemsList.querySelectorAll('.custom-item'));
+              const idx = items.indexOf(itemEl);
+              if (idx > 0) {
+                itemsList.insertBefore(itemEl, items[idx - 1]);
+              } else if (items.length > 1) {
+                itemsList.appendChild(itemEl);
+              }
+            } else if (action === 'move-item-down' && itemEl && itemsList) {
+              const items = Array.from(itemsList.querySelectorAll('.custom-item'));
+              const idx = items.indexOf(itemEl);
+              if (idx < items.length - 1) {
+                itemsList.insertBefore(items[idx + 1], itemEl);
+              } else if (items.length > 1) {
+                itemsList.insertBefore(itemEl, items[0]);
+              }
+            } else if (action === 'remove-item' && itemEl) {
+              itemEl.remove();
+            } else if (action === 'add-item' && itemsList) {
+              const newItemId = actionBtn.dataset.itemId;
+              const newItemLabel = actionBtn.dataset.itemLabel;
+              if (newItemId && newItemLabel && !itemsList.querySelector(`[data-item-id="${newItemId}"]`)) {
+                itemsList.appendChild(createCustomItemElement(cardId, { id: newItemId, label: newItemLabel }));
+              }
+            } else if (action === 'shuffle-items' && itemsList) {
+              const items = Array.from(itemsList.querySelectorAll('.custom-item'));
+              if (items.length > 1) {
+                items.push(items.shift());
+                items.forEach((el) => itemsList.appendChild(el));
+              }
+            } else if (action === 'reset-items' && itemsList) {
+              const meta = ALL_CATALOG.get(cardId);
+              if (meta) {
+                itemsList.innerHTML = '';
+                meta.items.forEach((item) => {
+                  itemsList.appendChild(createCustomItemElement(cardId, item));
+                });
+              }
+            } else if (action === 'set-temp') {
+              cardEl.querySelectorAll('.option-pill[data-action="set-temp"]').forEach((btn) => {
+                btn.classList.toggle('active', btn === actionBtn);
+              });
+            } else if (action === 'set-size') {
+              cardEl.querySelectorAll('.option-pill[data-action="set-size"]').forEach((btn) => {
+                btn.classList.toggle('active', btn === actionBtn);
+              });
+            }
+
+            syncCardMetadata(cardEl);
+          });
+        }
+      });
+
+      // Drag-and-Drop Reordering for Drink Cards (Scoped to #seasonal-grid)
+      let draggedCard = null;
+
+      gridEl.addEventListener('dragstart', (event) => {
+        const card = event.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        if (event.dataTransfer) {
+          event.dataTransfer.effectAllowed = 'move';
+          event.dataTransfer.setData('text/plain', card.dataset.cardId || '');
+        }
+      });
+
+      gridEl.addEventListener('dragover', (event) => {
+        const overCard = event.target.closest('.card');
+        if (!overCard || !draggedCard || overCard === draggedCard) return;
+        event.preventDefault();
+        overCard.classList.add('drag-over');
+      });
+
+      gridEl.addEventListener('dragleave', (event) => {
+        const overCard = event.target.closest('.card');
+        if (overCard) {
+          overCard.classList.remove('drag-over');
+        }
+      });
+
+      gridEl.addEventListener('drop', (event) => {
+        const targetCard = event.target.closest('.card');
+        gridEl.querySelectorAll('.card.drag-over').forEach((c) => c.classList.remove('drag-over'));
+        if (!targetCard || !draggedCard || targetCard === draggedCard) return;
+        event.preventDefault();
+
+        const movingCard = draggedCard;
+        draggedCard = null;
+
+        runScopedViewTransition(gridEl, true, () => {
+          const cards = Array.from(gridEl.querySelectorAll('.card'));
+          const fromIdx = cards.indexOf(movingCard);
+          const toIdx = cards.indexOf(targetCard);
+          if (fromIdx < 0 || toIdx < 0) return;
+
+          if (fromIdx < toIdx) {
+            gridEl.insertBefore(movingCard, targetCard.nextSibling);
+          } else {
+            gridEl.insertBefore(movingCard, targetCard);
+          }
+          syncGridBadgesAndStatus();
+        });
+      });
+
+      gridEl.addEventListener('dragend', () => {
+        draggedCard = null;
+        gridEl.querySelectorAll('.card.drag-over').forEach((c) => c.classList.remove('drag-over'));
+      });
+
+      syncGridBadgesAndStatus();
+    })();
+  </script>
 </body>
 
 </html>
