+    function processDistributedOrderEvents(rawEvents = DISTRIBUTED_COFFEE_ORDER_EVENTS) {
+      // 1. Parse each nanosecond UTC timestamp into a Temporal.Instant
+      const parsedEvents = rawEvents.map((event, ingestionIndex) => {
+        const instant = Temporal.Instant.from(event.timestamp);
+        return {
+          ...event,
+          ingestionOrder: ingestionIndex + 1,
+          instant,
+          epochNanoseconds: instant.epochNanoseconds
+        };
+      });
+
+      // 2. Sort chronologically using Temporal.Instant.compare (preserving full nanosecond precision)
+      const sortedEvents = [...parsedEvents].sort((a, b) =>
+        Temporal.Instant.compare(a.instant, b.instant)
+      );
+
+      // 3. Measure intervals between consecutive events
+      let minIntervalNs = null;
+      let subMsIntervalsCount = 0;
+
+      const timeline = sortedEvents.map((event, sortedIndex) => {
+        if (sortedIndex === 0) {
+          return {
+            ...event,
+            chronologicalRank: 1,
+            intervalNs: 0n,
+            intervalMicroseconds: 0,
+            intervalMilliseconds: 0,
+            isoDuration: 'PT0S',
+            formattedInterval: formatNanosecondInterval(0n),
+            isSubMillisecond: false
+          };
+        }
