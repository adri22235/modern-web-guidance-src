+    /**
+     * Format a nanosecond duration (BigInt) into a precise human-readable string
+     * without losing sub-millisecond (microsecond / nanosecond) fidelity.
+     */
+    function formatNanosecondInterval(deltaNs) {
+      const ns = BigInt(deltaNs);
+      if (ns === 0n) {
+        return '0 ns (Initial Event)';
+      }
+      const wholeSeconds = ns / 1_000_000_000n;
+      const ms = (ns % 1_000_000_000n) / 1_000_000n;
+      const us = (ns % 1_000_000n) / 1_000n;
+      const remNs = ns % 1_000n;
+
+      const parts = [];
+      if (wholeSeconds > 0n) parts.push(`${wholeSeconds} s`);
+      if (ms > 0n) parts.push(`${ms} ms`);
+      if (us > 0n) parts.push(`${us} µs`);
+      if (remNs > 0n || parts.length === 0) parts.push(`${remNs} ns`);
+
+      return `+${parts.join(' ')} (${ns.toLocaleString('en-US')} ns)`;
+    }
