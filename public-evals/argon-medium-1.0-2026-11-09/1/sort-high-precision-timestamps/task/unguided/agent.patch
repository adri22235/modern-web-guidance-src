+        const previousEvent = sortedEvents[sortedIndex - 1];
+        const duration = event.instant.since(previousEvent.instant);
+        const intervalNs = event.epochNanoseconds - previousEvent.epochNanoseconds;
+        const intervalMicroseconds = duration.total({ unit: 'microsecond' });
+        const intervalMilliseconds = duration.total({ unit: 'millisecond' });
+        const isSubMillisecond = intervalNs < 1_000_000n;
+
+        if (isSubMillisecond) {
+          subMsIntervalsCount += 1;
+        }
+        if (minIntervalNs === null || intervalNs < minIntervalNs) {
+          minIntervalNs = intervalNs;
+        }
+
+        return {
+          ...event,
+          chronologicalRank: sortedIndex + 1,
+          intervalNs,
+          intervalMicroseconds,
+          intervalMilliseconds,
+          isoDuration: duration.toString(),
+          formattedInterval: formatNanosecondInterval(intervalNs),
+          isSubMillisecond
