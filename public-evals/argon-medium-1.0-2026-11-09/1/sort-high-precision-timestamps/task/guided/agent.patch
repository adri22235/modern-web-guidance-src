+  <script>
+    // Out-of-order batch of coffee order events from distributed backend services
+    // recorded with nanosecond-precision ISO 8601 UTC timestamps.
+    const rawOrderEvents = [
+      {
+        orderId: 'ORD-4821',
+        serviceId: 'barista-queue-02',
+        eventType: 'espresso.shot.queued',
+        summary: 'Queued double Dark Roast Espresso shot for extraction',
+        ts: '2026-11-10T08:15:30.120894310Z'
+      },
+      {
+        orderId: 'ORD-4821',
+        serviceId: 'pos-gateway-us-east',
+        eventType: 'order.received',
+        summary: 'Received mobile order: 1x Maple Oat Latte, 1x Dark Roast Espresso',
+        ts: '2026-11-10T08:15:30.120045100Z'
+      },
+      {
+        orderId: 'ORD-4821',
+        serviceId: 'inventory-roaster-01',
+        eventType: 'beans.reserved',
+        summary: 'Allocated 36g espresso blend & 240ml oat milk from local hopper',
+        ts: '2026-11-10T08:15:30.120412789Z'
+      },
+      {
+        orderId: 'ORD-4821',
+        serviceId: 'payment-ledger-03',
+        eventType: 'payment.authorized',
+        summary: 'Authorized $11.50 contactless wallet transaction',
+        ts: '2026-11-10T08:15:30.120412340Z'
+      },
+      {
+        orderId: 'ORD-4821',
+        serviceId: 'loyalty-rewards-01',
+        eventType: 'rewards.points.accrued',
+        summary: 'Credited +25 Daily Grind Bean points to customer account',
+        ts: '2026-11-10T08:15:30.121502900Z'
+      },
+      {
+        orderId: 'ORD-4821',
+        serviceId: 'order-validator-01',
+        eventType: 'order.validated',
+        summary: 'Verified store operating hours and custom syrup modifiers',
+        ts: '2026-11-10T08:15:30.120180655Z'
+      }
+    ];
+
+    function parseAndSequenceOrderEvents(rawBatch) {
+      // 1. Parse recorded nanosecond timestamps as Temporal.Instant
+      const parsedEvents = rawBatch.map((evt) => ({
+        ...evt,
+        timestamp: Temporal.Instant.from(evt.ts)
+      }));
+
+      // 2. Sort chronologically using Temporal.Instant.compare to preserve sub-millisecond ordering
+      return [...parsedEvents].sort((a, b) =>
+        Temporal.Instant.compare(a.timestamp, b.timestamp)
+      );
+    }
+
+    function measureEventIntervals(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            prevEventType: null,
+            isSimultaneous: false,
+            gap: null,
+            formattedGap: '0ns (initial event)'
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+        // 3. Calculate exact Temporal.Duration interval since the previous event
+        const gap = curr.timestamp.since(prev.timestamp);
+        // 4. Format duration for users with toLocaleString() (Intl.DurationFormat)
+        const formattedGap = isSimultaneous
+          ? '0ns'
+          : gap.toLocaleString('en-US', { style: 'narrow' });
+
+        return {
+          ...curr,
+          prevEventType: prev.eventType,
+          isSimultaneous,
+          gap,
+          formattedGap
+        };
+      });
+    }
+
+    function renderOrderEvents() {
+      const timelineEl = document.getElementById('order-event-timeline');
+      const statusEl = document.getElementById('telemetry-status');
+
+      const sortedEvents = parseAndSequenceOrderEvents(rawOrderEvents);
+      const analyzedEvents = measureEventIntervals(sortedEvents);
+
+      const firstInstant = analyzedEvents[0].timestamp;
+      const lastInstant = analyzedEvents[analyzedEvents.length - 1].timestamp;
+      const totalSpan = lastInstant.since(firstInstant);
+
+      statusEl.textContent =
+        `Sorted ${analyzedEvents.length} distributed events for ${analyzedEvents[0].orderId} in chronological nanosecond order. ` +
+        `Total trace span: ${totalSpan.toLocaleString('en-US', { style: 'narrow' })}.`;
+
+      timelineEl.replaceChildren();
+
+      analyzedEvents.forEach((evt, index) => {
+        const li = document.createElement('li');
+        li.className = 'event-item';
+
+        const infoDiv = document.createElement('div');
+
+        const metaDiv = document.createElement('div');
+        metaDiv.className = 'event-meta';
+
+        const badgeSpan = document.createElement('span');
+        badgeSpan.className = 'service-badge';
+        badgeSpan.textContent = evt.serviceId;
+
+        const typeSpan = document.createElement('span');
+        typeSpan.className = 'event-type';
+        typeSpan.textContent = `${index + 1}. ${evt.eventType}`;
+
+        metaDiv.append(badgeSpan, typeSpan);
+
+        const detailsP = document.createElement('p');
+        detailsP.className = 'event-details';
+        detailsP.textContent = `${evt.summary} (${evt.orderId})`;
+
+        infoDiv.append(metaDiv, detailsP);
+
+        const timeEl = document.createElement('time');
+        timeEl.className = 'event-timestamp';
+        const isoString = evt.timestamp.toString();
+        timeEl.setAttribute('datetime', isoString);
+        timeEl.textContent = isoString;
+
+        li.append(infoDiv, timeEl);
+
+        if (index > 0 && evt.gap) {
+          const intervalDiv = document.createElement('div');
+          intervalDiv.className = 'interval-badge';
+
+          const labelSpan = document.createElement('span');
+          labelSpan.textContent = `Interval from ${evt.prevEventType} → ${evt.eventType}:`;
+
+          const durationTime = document.createElement('time');
+          durationTime.className = 'interval-value';
+          durationTime.setAttribute('datetime', evt.gap.toString());
+          durationTime.textContent = `+${evt.formattedGap}`;
+
+          intervalDiv.append(labelSpan, durationTime);
+          li.append(intervalDiv);
+        }
+
+        timelineEl.append(li);
+      });
+    }
+
+    function initializeApp() {
+      const loadBtn = document.getElementById('load-order-events-btn');
+      if (loadBtn) {
+        loadBtn.addEventListener('click', renderOrderEvents);
+      }
+    }
+
+    // Check if Temporal is supported natively; dynamically load temporal-polyfill if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
