+  <script>
+    (function () {
+      function getPageIndex(urlStr) {
+        if (!urlStr) return 0;
+        try {
+          const pathname = new URL(urlStr, location.origin).pathname;
+          if (pathname.endsWith('page2.html')) return 1;
+          if (pathname.endsWith('page3.html')) return 2;
+          return 0;
+        } catch (e) {
+          return 0;
+        }
+      }
+
+      function resolveDirection(fromUrl, toUrl) {
+        const stored = sessionStorage.getItem('transitionDirection');
+        if (stored === 'previous' || stored === 'next') {
+          return stored;
+        }
+        const fromIdx = getPageIndex(fromUrl);
+        const toIdx = getPageIndex(toUrl);
+        if (fromIdx !== toIdx) {
+          return (toIdx - fromIdx + 3) % 3 === 1 ? 'next' : 'previous';
+        }
+        return 'next';
+      }
+
+      function applyDirection(viewTransition, direction) {
+        document.documentElement.dataset.direction = direction;
+        document.documentElement.classList.remove('previous', 'next', 'backwards', 'forwards');
+        document.documentElement.classList.add(direction, direction === 'next' ? 'forwards' : 'backwards');
+        if (viewTransition && viewTransition.types) {
+          viewTransition.types.clear();
+          viewTransition.types.add(direction);
+          viewTransition.types.add(direction === 'next' ? 'forwards' : 'backwards');
+        }
+      }
+
+      const initialDir = sessionStorage.getItem('transitionDirection');
+      if (initialDir && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        applyDirection(null, initialDir);
+      }
+
+      document.addEventListener('click', function (e) {
+        const prevLink = e.target.closest('#previous');
+        const nextLink = e.target.closest('#next');
+        if (prevLink) {
+          sessionStorage.setItem('transitionDirection', 'previous');
+          applyDirection(null, 'previous');
+        } else if (nextLink) {
+          sessionStorage.setItem('transitionDirection', 'next');
+          applyDirection(null, 'next');
+        }
+      });
+
+      window.addEventListener('pageswap', function (e) {
+        if (!e.viewTransition) return;
+        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          e.viewTransition.skipTransition();
+          return;
+        }
+        const fromUrl = (e.activation && e.activation.from && e.activation.from.url) || location.href;
+        const toUrl = (e.activation && e.activation.entry && e.activation.entry.url) || '';
+        const direction = resolveDirection(fromUrl, toUrl);
+        sessionStorage.setItem('transitionDirection', direction);
+        applyDirection(e.viewTransition, direction);
+      });
+
+      window.addEventListener('pagereveal', function (e) {
+        if (!e.viewTransition) return;
+        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+          e.viewTransition.skipTransition();
+          document.documentElement.removeAttribute('data-direction');
+          return;
+        }
+        const activation = window.navigation && window.navigation.activation;
+        const fromUrl = (activation && activation.from && activation.from.url) || document.referrer;
+        const toUrl = (activation && activation.entry && activation.entry.url) || location.href;
+        const direction = resolveDirection(fromUrl, toUrl);
+        applyDirection(e.viewTransition, direction);
+        e.viewTransition.finished.finally(function () {
+          sessionStorage.removeItem('transitionDirection');
+        });
+      });
+    })();
+  </script>
