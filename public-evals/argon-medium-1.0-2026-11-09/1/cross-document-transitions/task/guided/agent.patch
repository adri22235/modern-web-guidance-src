+    /* Pagination */
+    .pagination {
+      display: flex;
+      justify-content: center;
+      gap: 20px;
+      margin-top: 30px;
+    }
+
+    /* Cross-Document Directional View Transitions */
+    @media (prefers-reduced-motion: no-preference) {
+      @view-transition {
+        navigation: auto;
+      }
+    }
+
+    @keyframes slide-to-left {
+      to {
+        transform: translateX(-100%);
+      }
+    }
+
+    @keyframes slide-from-right {
+      from {
+        transform: translateX(100%);
+      }
+    }
+
+    @keyframes slide-to-right {
+      to {
+        transform: translateX(100%);
+      }
+    }
+
+    @keyframes slide-from-left {
+      from {
+        transform: translateX(-100%);
+      }
+    }
+
+    ::view-transition-group(root) {
+      animation: 0.4s ease-in-out both;
+    }
+
+    html:active-view-transition-type(next)::view-transition-old(root),
+    html:active-view-transition-type(forward)::view-transition-old(root) {
+      animation-name: slide-to-left;
+    }
+
+    html:active-view-transition-type(next)::view-transition-new(root),
+    html:active-view-transition-type(forward)::view-transition-new(root) {
+      animation-name: slide-from-right;
+    }
+
+    html:active-view-transition-type(previous)::view-transition-old(root),
+    html:active-view-transition-type(backward)::view-transition-old(root) {
+      animation-name: slide-to-right;
+    }
+
+    html:active-view-transition-type(previous)::view-transition-new(root),
+    html:active-view-transition-type(backward)::view-transition-new(root) {
+      animation-name: slide-from-left;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      @view-transition {
+        navigation: none;
+      }
+
+      ::view-transition-group(root) {
+        animation: none !important;
+      }
+    }
+
