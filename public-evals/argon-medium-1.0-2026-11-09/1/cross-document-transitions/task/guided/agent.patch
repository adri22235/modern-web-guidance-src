     }
   </style>
+  <link rel="expect" href="#next" blocking="render">
+  <script blocking="render">
+    function getTransitionType(fromEntry, toEntry) {
+      if (fromEntry?.url && toEntry?.url) {
+        const fromUrl = new URL(fromEntry.url);
+        const toUrl = new URL(toEntry.url);
+        const fromPage = fromUrl.searchParams.has('page')
+          ? Number(fromUrl.searchParams.get('page'))
+          : 1.5;
+        const toPage = toUrl.searchParams.has('page')
+          ? Number(toUrl.searchParams.get('page'))
+          : 1.5;
+        if (toPage < fromPage) {
+          return 'previous';
+        }
+        if (toPage > fromPage) {
+          return 'next';
+        }
+      }
+      return sessionStorage.getItem('transitionType') || 'next';
+    }
+
+    if ('onpagereveal' in window) {
+      window.addEventListener('pagereveal', (e) => {
+        if (!e.viewTransition) return;
+
+        let transitionType;
+        if (window.navigation?.activation) {
+          transitionType = getTransitionType(
+            window.navigation.activation.from,
+            window.navigation.activation.entry
+          );
+        } else {
+          transitionType = sessionStorage.getItem('transitionType') || 'next';
+        }
+
+        e.viewTransition.types.add(transitionType);
+        e.viewTransition.types.add(
+          transitionType === 'previous' ? 'backward' : 'forward'
+        );
+      });
+    }
+  </script>
 </head>
 
