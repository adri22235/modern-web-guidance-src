+  <script>
+    (function () {
+      const carousel = document.getElementById('seasonal-carousel');
+      const cards = Array.from(carousel.querySelectorAll('.card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      let currentIndex = 0;
+
+      function showCard(newIndex, direction) {
+        currentIndex = (newIndex + cards.length) % cards.length;
+        cards.forEach((card, index) => {
+          card.classList.remove('active', 'slide-in-right', 'slide-in-left');
+          card.setAttribute('aria-hidden', index === currentIndex ? 'false' : 'true');
+        });
+
+        const activeCard = cards[currentIndex];
+        activeCard.classList.add('active');
+        carousel.setAttribute('data-direction', direction);
+
+        // Force reflow so the directional slide animation replays cleanly
+        void activeCard.offsetWidth;
+        if (direction === 'next') {
+          activeCard.classList.add('slide-in-right');
+        } else if (direction === 'prev') {
+          activeCard.classList.add('slide-in-left');
+        }
+      }
+
+      nextBtn.addEventListener('click', function () {
+        showCard(currentIndex + 1, 'next');
+      });
+
+      prevBtn.addEventListener('click', function () {
+        showCard(currentIndex - 1, 'prev');
+      });
+    })();
+  </script>
+
