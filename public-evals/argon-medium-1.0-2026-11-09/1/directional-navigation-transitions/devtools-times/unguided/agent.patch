+import React, { useState } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+interface Story {
+  id: string;
+  data: {
+    title: string;
+    date: Date | string;
+    category?: string;
+    summary?: string;
+  };
+}
+
+interface TopStoriesCarouselProps {
+  stories: Story[];
+}
+
+export default function TopStoriesCarousel({ stories }: TopStoriesCarouselProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [animKey, setAnimKey] = useState(0);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const handlePrev = () => {
+    setDirection('prev');
+    setCurrentIndex((prevIndex) => (prevIndex - 1 + stories.length) % stories.length);
+    setAnimKey((prev) => prev + 1);
+  };
+
+  const handleNext = () => {
+    setDirection('next');
+    setCurrentIndex((prevIndex) => (prevIndex + 1) % stories.length);
+    setAnimKey((prev) => prev + 1);
+  };
+
+  const currentStory = stories[currentIndex];
+  const formattedDate = new Date(currentStory.data.date).toLocaleDateString();
+
+  const animationClass =
+    direction === 'next'
+      ? 'animate-slide-in-right'
+      : direction === 'prev'
+        ? 'animate-slide-in-left'
+        : '';
+
+  return (
+    <div
+      className="flex items-center justify-between gap-4"
+      role="region"
+      aria-roledescription="carousel"
+      aria-label="Top Stories"
+    >
+      <button
+        type="button"
+        onClick={handlePrev}
+        aria-label="Previous story"
+        className="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+      >
+        <ChevronLeftIcon className="w-4 h-4" />
+        <span>Previous</span>
+      </button>
+
+      <div className="flex-1 overflow-hidden relative py-1">
+        <div
+          key={`${currentStory.id}-${animKey}`}
+          data-direction={direction ?? 'none'}
+          className={`flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-4 px-2 ${animationClass}`}
+          aria-live="polite"
+        >
+          <div className="flex items-baseline gap-2 min-w-0">
+            <span className="text-[11px] font-bold uppercase tracking-wider text-amber-700 shrink-0">
+              Top Story {currentIndex + 1}/{stories.length}
+            </span>
+            <a
+              href={`${import.meta.env.BASE_URL}articles/${currentStory.id}`}
+              className="truncate"
+            >
+              <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer truncate">
+                {currentStory.data.title}
+              </h3>
+            </a>
+          </div>
+          <span className="text-xs text-gray-500 shrink-0">{formattedDate}</span>
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={handleNext}
+        aria-label="Next story"
+        className="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+      >
+        <span>Next</span>
+        <ChevronRightIcon className="w-4 h-4" />
+      </button>
+    </div>
+  );
+}
