+    <script>
+        /**
+         * Navigates to a new story slide with a directional view transition.
+         * @param {() => void} updateDOM - Callback to update the DOM state.
+         * @param {'forward' | 'backward'} direction - Either 'forward' or 'backward'.
+         */
+        function navigate(updateDOM: () => void, direction: 'forward' | 'backward') {
+            // Feature detect for browsers that do not support View Transitions
+            if (!document.startViewTransition) {
+                updateDOM();
+                return;
+            }
+
+            // Start transition with the specific navigation type
+            document.startViewTransition({
+                update: updateDOM,
+                types: [direction], // Matches the CSS :active-view-transition-type() selectors
+            } as any);
+        }
+
+        function initTopStoriesCarousel() {
+            const carousel = document.querySelector<HTMLElement>('[data-top-stories-carousel]');
+            if (!carousel || carousel.dataset.initialized === 'true') return;
+            carousel.dataset.initialized = 'true';
+
+            const items = Array.from(carousel.querySelectorAll<HTMLElement>('.top-story-item'));
+            const prevButton = carousel.querySelector<HTMLButtonElement>('#prev-story');
+            const nextButton = carousel.querySelector<HTMLButtonElement>('#next-story');
+
+            if (items.length === 0 || !prevButton || !nextButton) return;
+
+            let currentIndex = 0;
+
+            const showStory = (nextIndex: number) => {
+                items.forEach((item, index) => {
+                    item.classList.toggle('hidden', index !== nextIndex);
+                });
+                currentIndex = nextIndex;
+            };
+
+            nextButton.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % items.length;
+                navigate(() => showStory(nextIndex), 'forward');
+            });
+
+            prevButton.addEventListener('click', () => {
+                const prevIndex = (currentIndex - 1 + items.length) % items.length;
+                navigate(() => showStory(prevIndex), 'backward');
+            });
+        }
+
+        initTopStoriesCarousel();
+        document.addEventListener('astro:page-load', initTopStoriesCarousel);
