diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,124 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Minimal Video Landing Page</title>
+
+  <!-- Elevate priority for the video poster image acting as the LCP candidate -->
+  <link rel="preload" href="poster.jpg" as="image" fetchpriority="high">
+
+  <!-- Preload critical header font (fonts default to high priority, so omit fetchpriority="high") -->
+  <link rel="preload" href="brand-font.woff2" as="font" type="font/woff2" crossorigin>
+
+  <!-- Preload secondary UI font at low priority to avoid network contention with LCP -->
+  <link rel="preload" href="secondary-font.woff2" as="font" type="font/woff2" fetchpriority="low" crossorigin>
+
+  <!-- Inline critical CSS to optimize the Critical Rendering Path -->
+  <style>
+    @font-face {
+      font-family: 'Brand Font';
+      src: url('brand-font.woff2') format('woff2');
+      font-display: swap;
+    }
+
+    @font-face {
+      font-family: 'Secondary Font';
+      src: url('secondary-font.woff2') format('woff2');
+      font-display: swap;
+    }
+
+    *, *::before, *::after {
+      box-sizing: border-box;
+    }
+
+    body {
+      margin: 0;
+      font-family: 'Secondary Font', system-ui, sans-serif;
+      background-color: #0f172a;
+      color: #f8fafc;
+      display: grid;
+      min-height: 100vh;
+      grid-template-rows: auto 1fr auto;
+    }
+
+    header {
+      padding: 1.5rem 2rem;
+      text-align: center;
+    }
+
+    h1 {
+      margin: 0;
+      font-family: 'Brand Font', system-ui, sans-serif;
+      font-size: clamp(1.75rem, 4vw, 2.75rem);
+      letter-spacing: -0.02em;
+    }
+
+    main {
+      display: grid;
+      place-items: center;
+      padding: 1rem 2rem 2rem;
+    }
+
+    .video-stage {
+      width: min(100%, 960px);
+    }
+
+    video {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 16 / 9;
+      border-radius: 0.75rem;
+      background-color: #1e293b;
+      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.4);
+    }
+
+    .secondary-ui {
+      margin-top: 1rem;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      gap: 1rem;
+      font-size: 0.9375rem;
+      color: #cbd5e1;
+    }
+
+    footer {
+      padding: 1rem 2rem;
+      text-align: center;
+      font-size: 0.875rem;
+      color: #94a3b8;
+    }
+  </style>
+</head>
+<body>
+  <header>
+    <h1>Next-Gen Cinema Stream</h1>
+  </header>
+
+  <main>
+    <div class="video-stage">
+      <video
+        controls
+        width="1280"
+        height="720"
+        poster="poster.jpg"
+        preload="none"
+      >
+        <source src="feature.webm" type="video/webm">
+        <source src="feature.mp4" type="video/mp4">
+        <track src="captions.vtt" kind="captions" srclang="en" label="English">
+      </video>
+      <div class="secondary-ui">
+        <span>4K HDR10+ Master</span>
+        <span>02:14 Runtime</span>
+      </div>
+    </div>
+  </main>
+
+  <footer>
+    <p>&copy; 2026 Cinema Stream</p>
+  </footer>
+</body>
+</html>
