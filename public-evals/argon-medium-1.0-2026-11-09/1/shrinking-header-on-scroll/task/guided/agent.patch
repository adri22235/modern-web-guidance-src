     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (
+      typeof CSS === 'undefined' ||
+      typeof CSS.supports !== 'function' ||
+      !CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')
+    ) {
+      const nav = document.querySelector('nav');
+      const logo = document.querySelector('.logo');
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const initialHeight = 100;
+      const finalHeight = 50;
+      const scrollDistance = 50;
+
+      const updateNavOnScroll = () => {
+        if (prefersReducedMotion.matches) {
+          nav.style.height = '';
+          nav.style.boxShadow = '';
+          if (logo) logo.style.transform = '';
+          document.documentElement.style.scrollPaddingTop = '';
+          return;
+        }
+
+        const scrollY = Math.max(0, window.scrollY);
+        const scrollPercent = Math.min(1, scrollY / scrollDistance);
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow =
+          scrollPercent > 0 ? `0 4px 12px rgba(0, 0, 0, ${0.25 * scrollPercent})` : 'none';
+        document.documentElement.style.scrollPaddingTop = `${newHeight}px`;
+
+        if (logo) {
+          const scale = 1 - 0.15 * scrollPercent;
+          logo.style.transform = `scale(${scale})`;
+        }
+      };
+
+      window.addEventListener('scroll', updateNavOnScroll, { passive: true });
+      updateNavOnScroll();
+    }
+  </script>
+
 </body>
 
