+          // t = A * s + e
+          const tVec = [];
+          for (let i = 0; i < K; i++) {
+            let acc = new Int16Array(N);
+            for (let j = 0; j < K; j++) {
+              acc = polyAdd(acc, polyMul(A[i][j], sVec[j]));
+            }
