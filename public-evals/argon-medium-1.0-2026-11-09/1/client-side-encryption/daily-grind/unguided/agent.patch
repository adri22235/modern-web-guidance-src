+        function decodePolyToMsg(poly) {
+          const msg = new Uint8Array(32);
+          for (let i = 0; i < 32; i++) {
+            let byte = 0;
+            for (let bit = 0; bit < 8; bit++) {
+              const c = compressCoeff(poly[8 * i + bit], 1);
+              byte |= (c & 1) << bit;
+            }
+            msg[i] = byte;
+          }
+          return msg;
+        }
