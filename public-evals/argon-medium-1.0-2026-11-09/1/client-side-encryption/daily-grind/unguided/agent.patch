+        // Compress & Decompress coefficients per FIPS 203
+        function compressCoeff(x, d) {
+          const mask = (1 << d) - 1;
+          return Math.round(((1 << d) * modQ(x)) / Q) & mask;
+        }
+
+        function decompressCoeff(y, d) {
+          return Math.round((Q * y) / (1 << d)) % Q;
+        }
+
+        function encodeMsgToPoly(msg32) {
+          const poly = new Int16Array(N);
+          for (let i = 0; i < 32; i++) {
+            for (let bit = 0; bit < 8; bit++) {
+              const b = (msg32[i] >>> bit) & 1;
+              poly[8 * i + bit] = b ? Math.round(Q / 2) : 0;
+            }
+          }
+          return poly;
+        }
