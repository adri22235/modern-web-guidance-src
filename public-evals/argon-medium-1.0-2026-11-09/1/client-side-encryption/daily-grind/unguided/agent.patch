+          const ctHash = await sha256Bytes(ciphertext);
+          const sharedSecret = await sha256Bytes(concatBytes(textEncoder.encode('MLKEM768-SS'), m, pkHash, ctHash));
+          return { ciphertext, sharedSecret };
+        }
