+      const decryptionBoxEl = document.getElementById('decryption-result-box');
+      const decryptionTitleEl = document.getElementById('decryption-result-title');
+      const decryptionTextEl = document.getElementById('decryption-result-text');
+      const savedNotesCountEl = document.getElementById('saved-notes-count');
+      const savedNotesContainerEl = document.getElementById('saved-notes-container');
+
+      const MODE_LABELS = {
+        HYBRID_P256_MLKEM768: 'Hybrid PQ KEM: ML-KEM-768 + ECDH P-256',
+        PQC_MLKEM768: 'Post-Quantum KEM: ML-KEM-768 (FIPS 203)',
+        CLASSICAL_ECDH_P256: 'Classical Key Agreement: ECDH P-256',
+        CLASSICAL_RSA_OAEP: 'Classical Encapsulation: RSA-OAEP-2048'
+      };
+
+      function updateTelemetryUI(envelope) {
+        activeKemBadgeEl.textContent = MODE_LABELS[envelope.kemMode] || envelope.kemMode;
+        telemetrySuiteEl.textContent = envelope.kemMode;
+        telemetryPkFpEl.textContent = CryptoNotesEngine.courierKeys.keyId;
+        telemetrySsFpEl.textContent = envelope.metadata.sharedSecretFingerprint;
+        telemetryIvEl.textContent = envelope.aead.ivHex;
+        telemetryTagEl.textContent = envelope.aead.authTagHex;
+        telemetryKemCtEl.textContent = envelope._telemetry.capsulePreview;
+
+        const wireEnvelope = Object.assign({}, envelope);
+        delete wireEnvelope._telemetry;
+        payloadOutputEl.textContent = JSON.stringify(wireEnvelope, null, 2);
+      }
+
+      function setStatusBanner(isSuccess, message) {
+        statusBannerEl.className = 'status-banner ' + (isSuccess ? 'verified' : 'error');
+        statusTextEl.textContent = message;
+      }
+
+      function renderSavedNotes() {
+        savedNotesCountEl.textContent = String(CryptoNotesEngine.savedEnvelopes.length);
+        savedNotesContainerEl.innerHTML = '';
+        CryptoNotesEngine.savedEnvelopes.forEach((env, idx) => {
+          const item = document.createElement('div');
+          item.className = 'saved-note-item';
+          item.innerHTML = `
+            <div class="saved-note-meta">
+              <strong>#${idx + 1} · ${env.metadata.orderId}</strong> (${env.metadata.dropoffType})<br/>
+              <span>Suite: <code>${env.kemMode}</code> · Tag: <code>${env.aead.authTagHex.slice(0, 16)}…</code></span>
+            </div>
+          `;
+          const inspectBtn = document.createElement('button');
+          inspectBtn.type = 'button';
+          inspectBtn.className = 'chip-btn';
+          inspectBtn.textContent = 'Inspect & Decrypt';
+          inspectBtn.addEventListener('click', async () => {
+            CryptoNotesEngine.currentEnvelope = JSON.parse(JSON.stringify(env));
+            updateTelemetryUI(CryptoNotesEngine.currentEnvelope);
+            await handleDecryptVerify();
+          });
+          item.appendChild(inspectBtn);
+          savedNotesContainerEl.appendChild(item);
+        });
+      }
+
+      async function handleEncryptSubmit(event) {
+        if (event) event.preventDefault();
+        const plaintext = noteInputEl.value.trim();
+        if (!plaintext) {
+          setStatusBanner(false, 'Please enter a delivery note to encrypt.');
+          return;
+        }
+
+        const mode = kemSelectEl.value;
+        const orderId = orderRefEl.value.trim() || 'DG-ORDER';
+        const dropoffType = dropoffTypeEl.value;
+        const aad = aadInputEl.value.trim();
+
+        const envelope = await CryptoNotesEngine.encryptDeliveryNote({
+          mode,
+          orderId,
+          dropoffType,
+          aad,
+          plaintext
+        });
+
+        CryptoNotesEngine.savedEnvelopes.unshift(JSON.parse(JSON.stringify(envelope)));
+        if (CryptoNotesEngine.savedEnvelopes.length > 5) {
+          CryptoNotesEngine.savedEnvelopes.pop();
+        }
+
+        updateTelemetryUI(envelope);
+        renderSavedNotes();
+        await handleDecryptVerify();
+        setStatusBanner(
+          true,
+          `Shared secret encapsulated (${mode}) & note encrypted with AES-256-GCM.`
+        );
+      }
+
+      async function handleDecryptVerify() {
+        const env = CryptoNotesEngine.currentEnvelope;
+        if (!env) return;
+        try {
+          const result = await CryptoNotesEngine.decryptDeliveryNote(env);
+          decryptionBoxEl.className = 'decrypted-preview';
+          decryptionTitleEl.textContent =
+            'AUTHENTICATED & VERIFIED — Decapsulated Shared Secret #' + result.sharedSecretFingerprint;
+          decryptionTextEl.textContent = result.plaintext;
+          setStatusBanner(
+            true,
+            'AEAD verification succeeded: 128-bit GCM authentication tag and AAD verified.'
+          );
+        } catch (err) {
+          decryptionBoxEl.className = 'decrypted-preview tampered';
+          decryptionTitleEl.textContent =
+            'INTEGRITY CHECK FAILED — AEAD Authentication Tag / KEM Rejection';
+          decryptionTextEl.textContent =
+            'Decryption rejected: Ciphertext, authentication tag, or Additional Authenticated Data (AAD) was tampered with.';
+          setStatusBanner(
+            false,
+            'Tamper detected! AES-256-GCM authenticated encryption rejected the modified payload.'
+          );
+        }
+      }
+
+      async function handleTamperSimulation() {
+        if (!CryptoNotesEngine.currentEnvelope) return;
+        // Clone the current envelope and flip bits in the authenticated ciphertext
+        const tampered = JSON.parse(JSON.stringify(CryptoNotesEngine.currentEnvelope));
+        const ctBytes = base64ToBytes(tampered.aead.ciphertextWithTag);
+        ctBytes[0] ^= 0xff; // Flip first byte of ciphertext
+        tampered.aead.ciphertextWithTag = bytesToBase64(ctBytes);
+
+        CryptoNotesEngine.currentEnvelope = tampered;
+        updateTelemetryUI(tampered);
+        await handleDecryptVerify();
+      }
+
+      // Preset template buttons
+      document.querySelectorAll('.chip-btn[data-preset]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          noteInputEl.value = btn.getAttribute('data-preset');
+          handleEncryptSubmit();
+        });
+      });
+
+      // Keep AAD synced when order ID or drop-off location changes
+      function syncDefaultAad() {
+        const orderId = orderRefEl.value.trim() || 'DG-ORDER';
+        const dropoff = dropoffTypeEl.value;
+        aadInputEl.value = `order:${orderId}|dropoff:${dropoff}|courier:route-7`;
+      }
+
+      orderRefEl.addEventListener('input', syncDefaultAad);
+      dropoffTypeEl.addEventListener('change', syncDefaultAad);
+      kemSelectEl.addEventListener('change', () => handleEncryptSubmit());
+
+      formEl.addEventListener('submit', handleEncryptSubmit);
+
+      rotateKeysBtn.addEventListener('click', async () => {
+        await CryptoNotesEngine.generateCourierKeyBundle();
+        CryptoNotesEngine.savedEnvelopes = [];
+        await handleEncryptSubmit();
+        setStatusBanner(
+          true,
+          'Rotated courier keypair (ECDH P-256 + ML-KEM-768) and re-encapsulated delivery note.'
+        );
+      });
+
+      decryptVerifyBtn.addEventListener('click', handleDecryptVerify);
+      tamperTestBtn.addEventListener('click', handleTamperSimulation);
+
+      copyEnvelopeBtn.addEventListener('click', async () => {
+        if (!payloadOutputEl.textContent) return;
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(payloadOutputEl.textContent);
+          }
+          const origText = copyEnvelopeBtn.textContent;
+          copyEnvelopeBtn.textContent = 'Copied!';
+          setTimeout(() => {
+            copyEnvelopeBtn.textContent = origText;
+          }, 1500);
+        } catch (_) {
+          // Ignore clipboard errors in headless environments
+        }
+      });
+
+      // Initialize keys & encrypt initial delivery note on page load
+      (async function init() {
+        await CryptoNotesEngine.generateCourierKeyBundle();
+        await handleEncryptSubmit();
+      })();
+    })();
+  </script>
 </body>
 
 </html>
