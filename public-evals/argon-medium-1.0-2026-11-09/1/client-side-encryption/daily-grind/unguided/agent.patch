+        async function decapsulate(ciphertext, secretKey) {
+          const mPrime = await indcpaDecrypt(secretKey.sVecBytes, ciphertext);
+          const rCoinsPrime = await sha256Bytes(
+            concatBytes(textEncoder.encode('MLKEM768-COINS'), mPrime, secretKey.pkHash)
+          );
+          const ctPrime = await indcpaEncrypt(secretKey.publicKey, mPrime, rCoinsPrime);
+          const ctHash = await sha256Bytes(ciphertext);
