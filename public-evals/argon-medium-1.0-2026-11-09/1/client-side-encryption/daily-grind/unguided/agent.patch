+      // =========================================================================
+      // 3. Key Derivation (HKDF-SHA256) & Authenticated Encryption (AES-256-GCM)
+      // =========================================================================
+      async function deriveAesGcmKeyWithHkdf(ikmBytes, saltBytes, infoString) {
+        const baseKey = await window.crypto.subtle.importKey(
+          'raw',
+          ikmBytes,
+          { name: 'HKDF' },
+          false,
+          ['deriveKey', 'deriveBits']
+        );
+
+        const infoBytes = textEncoder.encode(infoString);
+        const derivedBits = await window.crypto.subtle.deriveBits(
+          {
+            name: 'HKDF',
+            hash: 'SHA-256',
+            salt: saltBytes,
+            info: infoBytes
+          },
+          baseKey,
+          256
+        );
+
+        const aesKey = await window.crypto.subtle.importKey(
+          'raw',
+          derivedBits,
+          { name: 'AES-GCM', length: 256 },
+          false,
+          ['encrypt', 'decrypt']
+        );
+
+        return {
+          aesKey,
+          derivedKeyBytes: new Uint8Array(derivedBits)
+        };
+      }
+
+      async function aeadEncryptNote(aesKey, plaintextStr, aadStr) {
+        const iv = randomBytes(12); // 96-bit NIST-recommended AES-GCM nonce
+        const plaintextBytes = textEncoder.encode(plaintextStr);
+        const aadBytes = textEncoder.encode(aadStr || '');
+
+        const encryptedBuffer = await window.crypto.subtle.encrypt(
+          {
+            name: 'AES-GCM',
+            iv: iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesKey,
+          plaintextBytes
+        );
+
+        const encryptedBytes = new Uint8Array(encryptedBuffer);
+        // WebCrypto AES-GCM appends the 16-byte (128-bit) authentication tag at the end
+        const ciphertextBody = encryptedBytes.slice(0, encryptedBytes.length - 16);
+        const authTag = encryptedBytes.slice(encryptedBytes.length - 16);
+
+        return {
+          iv,
+          ciphertextWithTag: encryptedBytes,
+          ciphertextBody,
+          authTag
+        };
+      }
+
+      async function aeadDecryptNote(aesKey, ivBytes, ciphertextWithTagBytes, aadStr) {
+        const aadBytes = textEncoder.encode(aadStr || '');
+        const decryptedBuffer = await window.crypto.subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv: ivBytes,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesKey,
+          ciphertextWithTagBytes
+        );
+        return textDecoder.decode(decryptedBuffer);
+      }
