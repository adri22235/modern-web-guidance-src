+        function serializePolyVec(vec, bitsPerCoeff) {
+          const bytes = new Uint8Array(K * N * 2);
+          let ptr = 0;
+          for (let k = 0; k < K; k++) {
+            for (let i = 0; i < N; i++) {
+              const val = bitsPerCoeff < 12 ? compressCoeff(vec[k][i], bitsPerCoeff) : modQ(vec[k][i]);
