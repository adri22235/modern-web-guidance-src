+++ b/delivery-crypto.js
@@ -0,0 +1,424 @@
+// Client-side envelope encryption for sensitive delivery notes using WebCrypto
+// Supports hybrid post-quantum KEM ('MLKEM768-X25519'), standalone FIPS 203 ('ML-KEM-768', 'ML-KEM-1024'),
+// AEAD ('ChaCha20-Poly1305' and 'AES-GCM'), and classical key agreement fallback ('X25519' + 'HKDF' + 'AES-GCM').
+
+export const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+const DB_NAME = 'daily-grind-delivery-crypto';
+const STORE_NAME = 'recipient-keys';
+const DEFAULT_KEY_ID = 'recipient-kem-key';
+
+export function bytesToBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(base64) {
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(base64);
+  }
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Checks whether the current browser supports post-quantum KEM encapsulation
+ * and ChaCha20-Poly1305 AEAD via the static SubtleCrypto.supports() method.
+ */
+export function supportsPostQuantumEnvelope(
+  kemAlgorithm = 'MLKEM768-X25519',
+  aeadAlgorithm = 'ChaCha20-Poly1305',
+) {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('encapsulateKey', kemAlgorithm, aeadAlgorithm)
+  );
+}
+
+/**
+ * Persists or retrieves a non-extractable recipient CryptoKeyPair in IndexedDB
+ * using structured cloning without exporting private key bytes.
+ */
+function openKeyDatabase() {
+  return new Promise((resolve, reject) => {
+    if (typeof indexedDB === 'undefined') {
+      reject(new Error('IndexedDB is unavailable in this environment.'));
+      return;
+    }
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () => {
+      const db = request.result;
+      if (!db.objectStoreNames.contains(STORE_NAME)) {
+        db.createObjectStore(STORE_NAME);
+      }
+    };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+export async function saveRecipientKeyPairToIndexedDB(
+  recipientKeyPair,
+  keyId = DEFAULT_KEY_ID,
+) {
+  const db = await openKeyDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    const objectStore = tx.objectStore(STORE_NAME);
+    objectStore.put(recipientKeyPair, keyId);
+    tx.oncomplete = () => {
+      db.close();
+      resolve();
+    };
+    tx.onerror = () => {
+      db.close();
+      reject(tx.error);
+    };
+  });
+}
+
+export async function loadRecipientKeyPairFromIndexedDB(keyId = DEFAULT_KEY_ID) {
+  const db = await openKeyDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readonly');
+    const objectStore = tx.objectStore(STORE_NAME);
+    const req = objectStore.get(keyId);
+    req.onsuccess = () => {
+      db.close();
+      resolve(req.result || null);
+    };
+    req.onerror = () => {
+      db.close();
+      reject(req.error);
+    };
+  });
+}
+
+/**
+ * Generates a recipient key pair using 'MLKEM768-X25519' (or requested KEM algorithm)
+ * when supported, or falls back to 'X25519' key agreement + 'HKDF' + 'AES-GCM'.
+ */
+export async function generateRecipientKeys(preferredKem = 'MLKEM768-X25519') {
+  if (supportsPostQuantumEnvelope(preferredKem, 'ChaCha20-Poly1305')) {
+    const keyPair = await crypto.subtle.generateKey(
+      preferredKem,
+      false,
+      ['encapsulateKey', 'decapsulateKey'],
+    );
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return {
+      suite: `${preferredKem}+ChaCha20-Poly1305`,
+      kemAlgorithm: preferredKem,
+      aeadAlgorithm: 'ChaCha20-Poly1305',
+      keyPair,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  return {
+    suite: 'X25519+HKDF+AES-GCM',
+    kemAlgorithm: 'X25519',
+    aeadAlgorithm: 'AES-GCM',
+    keyPair,
+    publicKeyBytes,
+  };
+}
+
+/**
+ * Loads an existing non-extractable recipient key pair from IndexedDB or generates
+ * and persists a fresh one.
+ */
+export async function loadOrCreateRecipientKeys(
+  preferredKem = 'MLKEM768-X25519',
+  forceRotate = false,
+) {
+  const storageKey = `${DEFAULT_KEY_ID}:${preferredKem}`;
+  if (!forceRotate) {
+    try {
+      const storedKeyPair = await loadRecipientKeyPairFromIndexedDB(storageKey);
+      if (storedKeyPair?.publicKey && storedKeyPair?.privateKey) {
+        const algName = storedKeyPair.publicKey.algorithm.name;
+        const isKem = algName !== 'X25519';
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey(
+            isKem ? 'raw-public' : 'raw',
+            storedKeyPair.publicKey,
+          ),
+        );
+        return {
+          suite: isKem ? `${algName}+ChaCha20-Poly1305` : 'X25519+HKDF+AES-GCM',
+          kemAlgorithm: algName,
+          aeadAlgorithm: isKem ? 'ChaCha20-Poly1305' : 'AES-GCM',
+          keyPair: storedKeyPair,
+          publicKeyBytes,
+          persisted: true,
+        };
+      }
+    } catch {
+      // Proceed to generate a new key pair if IndexedDB read fails
+    }
+  }
+
+  const generated = await generateRecipientKeys(preferredKem);
+  try {
+    await saveRecipientKeyPairToIndexedDB(generated.keyPair, storageKey);
+    return { ...generated, persisted: true };
+  } catch {
+    return { ...generated, persisted: false };
+  }
+}
+
+async function deriveFallbackAesKey(
+  privateKey,
+  peerPublicKey,
+  infoBytes = new Uint8Array(0),
+) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256,
+  );
+  const hkdfKey = await crypto.subtle.importKey(
+    'raw',
+    sharedSecret,
+    'HKDF',
+    false,
+    ['deriveKey'],
+  );
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt'],
+  );
+}
+
+/**
+ * Encapsulates a one-time shared AEAD key and returns { sharedKey, capsuleBytes }.
+ * Uses KEM encapsulateKey() with 'raw-public' when supported, or falls back to
+ * ephemeral-static 'X25519' + 'HKDF' + 'AES-GCM'.
+ */
+export async function encapsulateEnvelopeKey(
+  recipientPublicKeyOrBytes,
+  infoBytes = new Uint8Array(0),
+) {
+  const pubKey =
+    recipientPublicKeyOrBytes instanceof CryptoKey
+      ? recipientPublicKeyOrBytes
+      : await (() => {
+          const bytes =
+            recipientPublicKeyOrBytes instanceof Uint8Array
+              ? recipientPublicKeyOrBytes
+              : new Uint8Array(recipientPublicKeyOrBytes);
+          const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+          return kemName
+            ? crypto.subtle.importKey(
+                'raw-public',
+                bytes,
+                kemName,
+                true,
+                ['encapsulateKey'],
+              )
+            : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+        })();
+
+  if (pubKey.algorithm.name !== 'X25519') {
+    const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+      pubKey.algorithm.name,
+      pubKey,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+    return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+  const capsuleBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', ephemeral.publicKey),
+  );
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return { sharedKey, capsuleBytes };
+}
+
+/**
+ * Decapsulates a ciphertext capsule using the recipient's private key to recover the AEAD CryptoKey.
+ */
+export async function decapsulateEnvelopeKey(
+  recipientPrivateKey,
+  capsuleBytes,
+  infoBytes = new Uint8Array(0),
+) {
+  if (recipientPrivateKey.algorithm.name !== 'X25519') {
+    return crypto.subtle.decapsulateKey(
+      recipientPrivateKey.algorithm.name,
+      recipientPrivateKey,
+      capsuleBytes,
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt'],
+    );
+  }
+
+  const ephemeralPubKey = await crypto.subtle.importKey(
+    'raw',
+    capsuleBytes,
+    'X25519',
+    true,
+    [],
+  );
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * Always generates a fresh 12-byte (96-bit) IV per encryption operation.
+ * @param {CryptoKey} key
+ * @param {string} plaintext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function encryptMessage(
+  key,
+  plaintext,
+  additionalData = new Uint8Array(0),
+) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = new TextEncoder().encode(plaintext);
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded,
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload. Throws OperationError if tampered.
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ */
+export async function decryptMessage(
+  key,
+  iv,
+  ciphertext,
+  additionalData = new Uint8Array(0),
+) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext,
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+/**
+ * Performs a full per-message envelope encryption for a customer delivery note.
+ */
+export async function encryptDeliveryNoteEnvelope({
+  recipientPublicKeyBytes,
+  notePlaintext,
+  associatedMetadata = '',
+  protocolInfo = 'daily-grind-delivery-note-v1',
+}) {
+  const infoBytes = new TextEncoder().encode(protocolInfo);
+  const additionalData = new TextEncoder().encode(associatedMetadata);
+  const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+    recipientPublicKeyBytes,
+    infoBytes,
+  );
+  const { iv, ciphertext } = await encryptMessage(
+    sharedKey,
+    notePlaintext,
+    additionalData,
+  );
+
+  const kemName = KEM_PUBLIC_KEY_ALGORITHMS[recipientPublicKeyBytes.byteLength] || 'X25519';
+  const suite =
+    kemName !== 'X25519'
+      ? `${kemName}+${sharedKey.algorithm.name}`
+      : `X25519+HKDF+${sharedKey.algorithm.name}`;
+
+  return {
+    suite,
+    kemAlgorithm: kemName,
+    aeadAlgorithm: sharedKey.algorithm.name,
+    capsuleBytes,
+    iv,
+    ciphertext,
+    additionalData,
+    associatedMetadata,
+    protocolInfo,
+    serialized: {
+      suite,
+      associatedMetadata,
+      protocolInfo,
+      capsule: bytesToBase64(capsuleBytes),
+      iv: bytesToBase64(iv),
+      ciphertext: bytesToBase64(ciphertext),
+    },
+  };
+}
+
+/**
+ * Performs a full envelope decapsulation and authenticated decryption for a delivery note.
+ */
+export async function decryptDeliveryNoteEnvelope({
+  recipientPrivateKey,
+  capsuleBytes,
+  iv,
+  ciphertext,
+  associatedMetadata = '',
+  protocolInfo = 'daily-grind-delivery-note-v1',
+}) {
+  const infoBytes = new TextEncoder().encode(protocolInfo);
+  const additionalData = new TextEncoder().encode(associatedMetadata);
+  const sharedKey = await decapsulateEnvelopeKey(
+    recipientPrivateKey,
+    capsuleBytes,
+    infoBytes,
+  );
+  return decryptMessage(sharedKey, iv, ciphertext, additionalData);
+}
