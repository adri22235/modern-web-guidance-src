+  <script>
+    (function () {
+      const SWIPE_THRESHOLD = 60;
+      const ACTION_COLOR = '#e53935';
+      const DEFAULT_TRACK_COLOR = '#d7ccc8';
+
+      function getClientX(e) {
+        if (e.touches && e.touches.length > 0) return e.touches[0].clientX;
+        if (e.changedTouches && e.changedTouches.length > 0) return e.changedTouches[0].clientX;
+        if (typeof e.clientX === 'number') return e.clientX;
+        if (e.detail && typeof e.detail.clientX === 'number') return e.detail.clientX;
+        return null;
+      }
+
+      function updateCartSummary() {
+        const remainingItems = document.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        const countEl = document.getElementById('cart-count');
+        const totalEl = document.getElementById('cart-total');
+        const emptyEl = document.getElementById('cart-empty');
+        const summaryEl = document.getElementById('cart-summary');
+
+        let total = 0;
+        remainingItems.forEach((item) => {
+          total += parseFloat(item.getAttribute('data-price') || '0');
+        });
+
+        if (countEl) countEl.textContent = String(remainingItems.length);
+        if (totalEl) totalEl.textContent = '$' + total.toFixed(2);
+
+        if (remainingItems.length === 0) {
+          if (emptyEl) emptyEl.style.display = 'block';
+          if (summaryEl) summaryEl.style.display = 'none';
+        }
+      }
+
+      function initSwipeableItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        item.classList.add('is-initialized');
+
+        let isDragging = false;
+        let isRemoving = false;
+        let hasMoved = false;
+        let startX = 0;
+        let currentX = 0;
+
+        function setActionState(active) {
+          if (active) {
+            item.classList.add('is-past-threshold');
+            track.classList.add('is-active');
+            track.style.backgroundColor = ACTION_COLOR;
+            item.style.backgroundColor = ACTION_COLOR;
+          } else {
+            item.classList.remove('is-past-threshold');
+            track.classList.remove('is-active');
+            track.style.backgroundColor = DEFAULT_TRACK_COLOR;
+            item.style.backgroundColor = DEFAULT_TRACK_COLOR;
+          }
+        }
+
+        function collapseAndRemove(direction) {
+          if (isRemoving) return;
+          isRemoving = true;
+          item.classList.add('is-removing');
+          setActionState(true);
+
+          const slideOutX = (direction >= 0 ? 1 : -1) * (item.offsetWidth || 400);
+          content.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
+          content.style.transform = `translateX(${slideOutX}px)`;
+          content.style.opacity = '0';
+
+          const currentHeight = item.getBoundingClientRect().height || item.offsetHeight;
+          item.style.height = `${currentHeight}px`;
+          // Force reflow so the browser registers the starting height before collapsing to 0
+          void item.offsetHeight;
+
+          item.style.transition = 'height 0.3s ease, margin 0.3s ease, padding 0.3s ease, opacity 0.3s ease';
+          item.style.height = '0px';
+          item.style.marginTop = '0px';
+          item.style.marginBottom = '0px';
+          item.style.paddingTop = '0px';
+          item.style.paddingBottom = '0px';
+          item.style.borderWidth = '0px';
+
+          updateCartSummary();
+
+          let removed = false;
+          function finalizeRemoval() {
+            if (removed) return;
+            removed = true;
+            window.removeEventListener('mousemove', onMove, true);
+            window.removeEventListener('touchmove', onMove, true);
+            window.removeEventListener('pointermove', onMove, true);
+            window.removeEventListener('mouseup', onEnd, true);
+            window.removeEventListener('touchend', onEnd, true);
+            window.removeEventListener('pointerup', onEnd, true);
+            window.removeEventListener('touchcancel', onEnd, true);
+            window.removeEventListener('pointercancel', onEnd, true);
+            if (item.parentNode) {
+              item.remove();
+            }
+          }
+
+          item.addEventListener('transitionend', (ev) => {
+            if (ev.propertyName === 'height') {
+              finalizeRemoval();
+            }
+          });
+          setTimeout(finalizeRemoval, 320);
+        }
+
+        function onStart(e) {
+          if (isRemoving || isDragging) return;
+          if (e.type === 'mousedown' && typeof e.button === 'number' && e.button !== 0) return;
+
+          const x = getClientX(e);
+          if (x === null) return;
+
+          isDragging = true;
+          hasMoved = false;
+          startX = x;
+          currentX = x;
+          item.classList.add('is-dragging');
+          content.style.transition = 'none';
+        }
+
+        function onMove(e) {
+          if (!isDragging || isRemoving) return;
+          const x = getClientX(e);
+          if (x === null) return;
+
+          hasMoved = true;
+          currentX = x;
+          const deltaX = currentX - startX;
+
+          content.style.transform = `translateX(${deltaX}px)`;
+
+          const threshold = Math.min(SWIPE_THRESHOLD, (item.offsetWidth || 300) * 0.25);
+          if (Math.abs(deltaX) >= threshold) {
+            setActionState(true);
+          } else {
+            setActionState(false);
+          }
+        }
+
+        function onEnd(e) {
+          if (!isDragging || isRemoving) return;
+          isDragging = false;
+          item.classList.remove('is-dragging');
+
+          if (!hasMoved) {
+            const endX = getClientX(e);
+            if (endX !== null && !(endX === 0 && startX !== 0)) {
+              currentX = endX;
+            }
+          }
+
+          const deltaX = currentX - startX;
+          const threshold = Math.min(SWIPE_THRESHOLD, (item.offsetWidth || 300) * 0.25);
+
+          if (Math.abs(deltaX) >= threshold) {
+            collapseAndRemove(deltaX);
+          } else {
+            setActionState(false);
+            content.style.transition = 'transform 0.25s ease, opacity 0.25s ease';
+            content.style.transform = 'translateX(0px)';
+          }
+        }
+
+        item.addEventListener('mousedown', onStart);
+        item.addEventListener('touchstart', onStart, { passive: true });
+        item.addEventListener('pointerdown', onStart);
+
+        window.addEventListener('mousemove', onMove, true);
+        window.addEventListener('touchmove', onMove, true);
+        window.addEventListener('pointermove', onMove, true);
+
+        window.addEventListener('mouseup', onEnd, true);
+        window.addEventListener('touchend', onEnd, true);
+        window.addEventListener('pointerup', onEnd, true);
+        window.addEventListener('touchcancel', onEnd, true);
+        window.addEventListener('pointercancel', onEnd, true);
+      }
+
+      function initSwipeableLists() {
+        const items = document.querySelectorAll('.SwipeableList .SwipeableList-item');
+        items.forEach(initSwipeableItem);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSwipeableLists);
+      } else {
+        initSwipeableLists();
+      }
+    })();
+  </script>
