+      border-radius: 6px;
+      color: var(--light);
+      cursor: pointer;
+      transition: background-color 0.15s;
+    }
+
+    select.roast-select option + option {
+      margin-top: 4px;
+    }
+
+    select.roast-select option:hover {
+      background-color: rgba(215, 204, 200, 0.16);
+    }
+
+    select.roast-select option::checkmark {
+      display: none;
