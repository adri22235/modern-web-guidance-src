+  <script>
+    const BARISTA_SYSTEM_PROMPT =
+      'You are a friendly, knowledgeable barista at The Daily Grind coffee shop. ' +
+      'Answer customer questions specifically about our Maple Oat Latte (made with creamy oat milk, rich espresso, and genuine Vermont maple syrup) ' +
+      'and our Cold Brew (ethically sourced coffee steeped for 18 hours for maximum smoothness and low acidity).';
+
+    const FEEDBACK_RESPONSE_SCHEMA = {
+      type: 'object',
+      properties: {
+        score: {
+          type: 'number',
+          description: 'Sentiment score between 1 (very negative) and 10 (very positive)'
+        },
+        category: {
+          type: 'string',
+          enum: ['positive', 'neutral', 'negative'],
+          description: 'Overall sentiment category of the customer feedback'
+        }
+      },
+      required: ['score', 'category'],
+      additionalProperties: false
+    };
+
+    // Active session management & resource cleanup tracking
+    let primarySession = null;
+    let activeBranchSession = null;
+    const managedSessions = new Set();
+    let activeAbortController = null;
+
+    const askButton = document.getElementById('ask-the-barista');
+    const questionInput = document.getElementById('barista-question');
+    const baristaAnswer = document.getElementById('barista-answer');
+
+    const sentimentButton = document.getElementById('sentiment-btn');
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentOutput = document.getElementById('sentiment-output');
+
+    const cloneButton = document.getElementById('clone-btn');
+    const cleanupButton = document.getElementById('cleanup-sessions-btn');
+    const contextTokensEl = document.getElementById('context-tokens');
+    const branchStatusEl = document.getElementById('branch-status');
+
+    const progressContainer = document.getElementById('model-progress');
+    const progressLabel = document.getElementById('model-progress-label');
+    const progressBar = document.getElementById('model-progress-bar');
+
+    function createDownloadMonitor(m) {
+      m.addEventListener('downloadprogress', (event) => {
+        progressContainer.hidden = false;
+        const fraction = typeof event.loaded === 'number' ? event.loaded : 0;
+        const percent = Math.round(fraction * 100);
+        progressBar.value = percent;
+        progressLabel.textContent = `Downloading built-in AI model: ${percent}%`;
+        if (percent >= 100) {
+          progressLabel.textContent = 'Model ready!';
+        }
+      });
+    }
+
+    function updateContextUsageDisplay(session) {
+      if (!session) {
+        contextTokensEl.textContent = '0 / 0 tokens';
+        return;
+      }
+      const usage = session.inputUsage ?? 0;
+      const quota = session.inputQuota ?? 0;
+      contextTokensEl.textContent = `${usage} / ${quota} tokens (${managedSessions.size} active)`;
+    }
+
+    function destroySession(session) {
+      if (!session) return;
+      try {
+        if (typeof session.destroy === 'function') {
+          session.destroy();
+        }
+      } catch (err) {
+        console.warn('Error destroying session:', err);
+      } finally {
+        managedSessions.delete(session);
+      }
+    }
+
+    function cleanupUnneededSessions(keepSession = null) {
+      for (const session of Array.from(managedSessions)) {
+        if (session !== keepSession) {
+          destroySession(session);
+        }
+      }
+      if (primarySession !== keepSession) {
+        primarySession = null;
+      }
+      if (activeBranchSession !== keepSession) {
+        activeBranchSession = null;
+      }
+      updateContextUsageDisplay(keepSession);
+    }
+
+    async function checkModelAvailability() {
+      if (typeof LanguageModel === 'undefined') {
+        throw new Error('Built-in AI LanguageModel API is not supported in this browser.');
+      }
+      const availability = await LanguageModel.availability();
+      if (availability === 'unavailable') {
+        throw new Error('Built-in AI model is currently unavailable on this device.');
+      }
+      return availability;
+    }
+
+    async function getOrCreateBaristaSession(signal) {
+      const currentSession = activeBranchSession || primarySession;
+      if (currentSession) {
+        return currentSession;
+      }
+
+      const availability = await checkModelAvailability();
+      if (availability === 'downloadable' || availability === 'downloading') {
+        progressContainer.hidden = false;
+      }
+
+      const session = await LanguageModel.create({
+        initialPrompts: [
+          {
+            role: 'system',
+            content: BARISTA_SYSTEM_PROMPT
+          }
+        ],
+        signal,
+        monitor: createDownloadMonitor
+      });
+
+      if (typeof session.addEventListener === 'function') {
+        session.addEventListener('quotaoverflow', () => {
+          branchStatusEl.textContent = 'Context quota reached. Cloning or resetting session recommended.';
+        });
+      }
+
+      primarySession = session;
+      managedSessions.add(session);
+      updateContextUsageDisplay(session);
+      return session;
+    }
+
+    // 1. Ask the Barista (Streaming Response)
+    askButton.addEventListener('click', async () => {
+      const question = questionInput.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+      baristaAnswer.textContent = '';
+
+      if (activeAbortController) {
+        activeAbortController.abort();
+      }
+      activeAbortController = new AbortController();
+      const { signal } = activeAbortController;
+
+      try {
+        await checkModelAvailability();
+        const session = await getOrCreateBaristaSession(signal);
+
+        const stream = session.promptStreaming(question, { signal });
+        for await (const chunk of stream) {
+          baristaAnswer.textContent += chunk;
+        }
+
+        updateContextUsageDisplay(session);
+      } catch (error) {
+        if (error.name !== 'AbortError') {
+          baristaAnswer.textContent = `Unable to get barista response: ${error.message}`;
+        }
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON output with responseConstraint)
+    sentimentButton.addEventListener('click', async () => {
+      const feedbackText = feedbackInput.value.trim();
+      if (!feedbackText) {
+        sentimentOutput.textContent = JSON.stringify({ score: 5, category: 'neutral' }, null, 2);
+        return;
+      }
+
+      let analyzerSession = null;
+      const controller = new AbortController();
+
+      try {
+        await checkModelAvailability();
+
+        analyzerSession = await LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content:
+                'You are a customer feedback sentiment analyzer for The Daily Grind coffee shop. ' +
+                'Respond strictly with a JSON object containing a numeric "score" (1-10) and a "category" ("positive", "neutral", or "negative").'
+            }
+          ],
+          signal: controller.signal,
+          monitor: createDownloadMonitor
+        });
+        managedSessions.add(analyzerSession);
+
+        const rawResult = await analyzerSession.prompt(
+          `Analyze the sentiment of this customer feedback: "${feedbackText}"`,
+          {
+            responseConstraint: FEEDBACK_RESPONSE_SCHEMA,
+            signal: controller.signal
+          }
+        );
+
+        const parsed = JSON.parse(rawResult);
+        sentimentOutput.textContent = JSON.stringify(
+          {
+            score: parsed.score,
+            category: parsed.category
+          },
+          null,
+          2
+        );
+      } catch (error) {
+        sentimentOutput.textContent = JSON.stringify(
+          {
+            error: error.message,
+            score: 0,
+            category: 'neutral'
+          },
+          null,
+          2
+        );
+      } finally {
+        // Clean up temporary one-off analyzer session immediately to free resources
+        destroySession(analyzerSession);
+        updateContextUsageDisplay(activeBranchSession || primarySession);
+      }
+    });
+
+    // 3. Conversation Branching (Session cloning, context tracking, and cleanup of unneeded sessions)
+    cloneButton.addEventListener('click', async () => {
+      const controller = new AbortController();
+      try {
+        await checkModelAvailability();
+        const sourceSession = await getOrCreateBaristaSession(controller.signal);
+
+        // Clone the active session to branch the conversation state
+        const clonedSession = await sourceSession.clone({
+          signal: controller.signal
+        });
+        managedSessions.add(clonedSession);
+
+        // Destroy any previously branched session that is no longer needed
+        if (activeBranchSession && activeBranchSession !== sourceSession) {
+          destroySession(activeBranchSession);
+        }
+        // Destroy old primary session if replacing it with the new branch to keep resources lean
+        if (primarySession && primarySession !== clonedSession) {
+          destroySession(primarySession);
+        }
+
+        activeBranchSession = clonedSession;
+        primarySession = clonedSession;
+
+        const usage = clonedSession.inputUsage ?? 0;
+        const quota = clonedSession.inputQuota ?? 0;
+        updateContextUsageDisplay(clonedSession);
+        branchStatusEl.textContent =
+          `Cloned active session successfully. Context usage: ${usage} / ${quota} tokens. Unneeded sessions cleaned up.`;
+      } catch (error) {
+        branchStatusEl.textContent = `Session clone failed: ${error.message}`;
+      }
+    });
+
+    cleanupButton.addEventListener('click', () => {
+      if (activeAbortController) {
+        activeAbortController.abort();
+        activeAbortController = null;
+      }
+      cleanupUnneededSessions(null);
+      branchStatusEl.textContent = 'All unneeded AI sessions have been destroyed and resources released.';
+    });
+
+    // Ensure all sessions are destroyed when unloading the page
+    window.addEventListener('pagehide', () => {
+      if (activeAbortController) {
+        activeAbortController.abort();
+      }
+      cleanupUnneededSessions(null);
+    });
+  </script>
 </body>
 
