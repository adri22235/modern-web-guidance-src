+  <script>
+    (() => {
+      const BARISTA_SYSTEM_PROMPT =
+        'You are a knowledgeable barista at The Daily Grind coffee shop. ' +
+        'Answer customer questions accurately and warmly about our Maple Oat Latte ' +
+        '(made with creamy oat milk and a hint of authentic Vermont maple syrup) and ' +
+        'our Cold Brew (steeped for 18 hours for maximum smoothness and low acidity).';
+
+      const progressEl = document.getElementById('model-download-progress');
+      const downloadStatusEl = document.getElementById('download-status');
+      const questionInput = document.getElementById('barista-question');
+      const askBtn = document.getElementById('ask-the-barista');
+      const stopBtn = document.getElementById('stop-barista-btn');
+      const baristaAnswerEl = document.getElementById('barista-answer');
+
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const sentimentOutputEl = document.getElementById('sentiment-output');
+
+      const branchPromptInput = document.getElementById('branch-prompt');
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupBtn = document.getElementById('cleanup-sessions-btn');
+      const contextUsageEl = document.getElementById('context-usage-display');
+      const branchOutputEl = document.getElementById('branch-output');
+
+      let baseSession = null;
+      let baseSessionPromise = null;
+      let activeAbortController = null;
+      const responseCache = new Map();
+
+      function updateContextUsage(session) {
+        if (!session) {
+          contextUsageEl.textContent = 'Context usage: 0 / 0 tokens (No active session)';
+          return;
+        }
+        const used = typeof session.contextUsage === 'number' ? session.contextUsage : 0;
+        const total = typeof session.contextWindow === 'number' ? session.contextWindow : 0;
+        contextUsageEl.textContent = `Context usage: ${used} / ${total} tokens`;
+      }
+
+      async function checkModelAvailability() {
+        if (!('LanguageModel' in self)) {
+          downloadStatusEl.textContent = 'Built-in Prompt API is not supported in this browser.';
+          return 'unavailable';
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          if (availability === 'unavailable') {
+            downloadStatusEl.textContent = 'Built-in AI model is unavailable on this device.';
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            downloadStatusEl.textContent = `Model status: ${availability} (will download on interaction).`;
+          } else if (availability === 'available') {
+            downloadStatusEl.textContent = 'Model available on-device.';
+            progressEl.value = 1;
+          }
+          return availability;
+        } catch (err) {
+          downloadStatusEl.textContent = 'Unable to check model availability.';
+          return 'unavailable';
+        }
+      }
+
+      function createBaseSession() {
+        return LanguageModel.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: BARISTA_SYSTEM_PROMPT,
+            },
+          ],
+          expectedInputs: [{ type: 'text' }],
+          expectedOutputs: [{ type: 'text' }],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const ratio = typeof e.loaded === 'number' ? e.loaded : 0;
+              progressEl.value = ratio;
+              downloadStatusEl.textContent = `Downloading model: ${Math.round(ratio * 100)}%`;
+            });
+          },
+        });
+      }
+
+      async function getOrCreateBaseSession() {
+        if (baseSession) {
+          return baseSession;
+        }
+        if (baseSessionPromise) {
+          return baseSessionPromise;
+        }
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          throw new Error('The built-in AI model is unavailable on this browser or device.');
+        }
+
+        baseSessionPromise = (async () => {
+          try {
+            const session = await createBaseSession();
+            baseSession = session;
+            progressEl.value = 1;
+            downloadStatusEl.textContent = 'Model downloaded and session ready.';
+            updateContextUsage(baseSession);
+            return session;
+          } finally {
+            baseSessionPromise = null;
+          }
+        })();
+
+        return baseSessionPromise;
+      }
+
+      // Pre-warm the base session when the user focuses or interacts with the AI workspace,
+      // only if the model is already 'available' (downloads require a user gesture).
+      async function prewarmIfAvailable() {
+        if (baseSession || baseSessionPromise || !('LanguageModel' in self)) {
+          return;
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          if (availability === 'available') {
+            await getOrCreateBaseSession();
+          }
+        } catch {
+          // Ignore background pre-warm errors until explicit user action.
+        }
+      }
+
+      questionInput.addEventListener('focus', prewarmIfAvailable, { once: true });
+      feedbackInput.addEventListener('focus', prewarmIfAvailable, { once: true });
+
+      // 1. Ask the Barista (Streaming response into #barista-answer)
+      askBtn.addEventListener('click', async () => {
+        const rawQuestion = questionInput.value.trim();
+        if (!rawQuestion) {
+          baristaAnswerEl.textContent = 'Please enter a question about the Maple Oat Latte or Cold Brew.';
+          return;
+        }
+
+        const cacheKey = rawQuestion.toLowerCase();
+        if (responseCache.has(cacheKey)) {
+          baristaAnswerEl.textContent = responseCache.get(cacheKey);
+          return;
+        }
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          baristaAnswerEl.textContent =
+            'Fallback notice: On-device AI is unavailable. Our Maple Oat Latte pairs espresso with steamed oat milk and Vermont maple syrup, while our Cold Brew is steeped for 18 hours for a smooth finish.';
+          return;
+        }
+
+        let taskSession = null;
+        activeAbortController = new AbortController();
+        askBtn.disabled = true;
+        stopBtn.hidden = false;
+        baristaAnswerEl.textContent = '';
+        baristaAnswerEl.setAttribute('aria-busy', 'true');
+
+        try {
+          const baseline = await getOrCreateBaseSession();
+          taskSession = await baseline.clone();
+
+          const stream = taskSession.promptStreaming(rawQuestion, {
+            signal: activeAbortController.signal,
+          });
+
+          let completeResult = '';
+          for await (const chunk of stream) {
+            completeResult += chunk;
+            // Always use append/textContent, never innerHTML, because model output is untrusted.
+            baristaAnswerEl.append(chunk);
+          }
+
+          if (completeResult) {
+            responseCache.set(cacheKey, completeResult);
+          }
+          updateContextUsage(taskSession);
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            baristaAnswerEl.append(' [Generation stopped]');
+          } else {
+            baristaAnswerEl.textContent =
+              'Unable to generate a barista response right now. Please try again.';
+          }
+        } finally {
+          baristaAnswerEl.setAttribute('aria-busy', 'false');
+          if (document.activeElement === stopBtn) {
+            askBtn.focus();
+          }
+          stopBtn.hidden = true;
+          askBtn.disabled = false;
+          activeAbortController = null;
+          if (taskSession) {
+            taskSession.destroy();
+          }
+        }
+      });
+
+      stopBtn.addEventListener('click', () => {
+        if (activeAbortController) {
+          activeAbortController.abort();
+        }
+      });
+
+      // 2. Customer Feedback Analyzer (Structured JSON output with score & category)
+      const feedbackSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: {
+            type: 'string',
+            enum: ['Maple Oat Latte', 'Cold Brew', 'Dark Roast Espresso', 'Service', 'General'],
+          },
+        },
+        required: ['score', 'category'],
+      };
+
+      sentimentBtn.addEventListener('click', async () => {
+        const feedbackText = feedbackInput.value.trim();
+        if (!feedbackText) {
+          sentimentOutputEl.textContent = 'Please enter customer feedback to analyze.';
+          return;
+        }
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          const fallbackData = { score: 5, category: 'Maple Oat Latte' };
+          sentimentOutputEl.textContent = JSON.stringify(fallbackData, null, 2);
+          return;
+        }
+
+        let feedbackSession = null;
+        sentimentBtn.disabled = true;
+        sentimentOutputEl.setAttribute('aria-busy', 'true');
+        sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+        try {
+          const baseline = await getOrCreateBaseSession();
+          feedbackSession = await baseline.clone();
+
+          const rawResult = await feedbackSession.prompt(
+            `Analyze the sentiment score (1 to 5) and product category of this customer feedback: "${feedbackText}"`,
+            { responseConstraint: feedbackSchema }
+          );
+
+          const parsed = JSON.parse(rawResult);
+          sentimentOutputEl.textContent = JSON.stringify(
+            {
+              score: parsed.score,
+              category: parsed.category,
+            },
+            null,
+            2
+          );
+          updateContextUsage(feedbackSession);
+        } catch (err) {
+          sentimentOutputEl.textContent =
+            'Could not parse structured sentiment result. Please try again.';
+        } finally {
+          sentimentOutputEl.setAttribute('aria-busy', 'false');
+          sentimentBtn.disabled = false;
+          if (feedbackSession) {
+            feedbackSession.destroy();
+          }
+        }
+      });
+
+      // 3. Conversation Branching & Context Usage Tracking with Session Cleanup
+      cloneBtn.addEventListener('click', async () => {
+        const branchPrompt = branchPromptInput.value.trim();
+        if (!branchPrompt) {
+          branchOutputEl.textContent = 'Please enter a prompt for the cloned conversation branch.';
+          return;
+        }
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          branchOutputEl.textContent =
+            'Fallback notice: Built-in AI is unavailable on this browser, so session cloning cannot run.';
+          return;
+        }
+
+        let branchA = null;
+        let branchB = null;
+        cloneBtn.disabled = true;
+        branchOutputEl.setAttribute('aria-busy', 'true');
+        branchOutputEl.textContent = 'Cloning baseline session and running parallel branches...';
+
+        try {
+          const baseline = await getOrCreateBaseSession();
+          branchA = await baseline.clone();
+          branchB = await baseline.clone();
+
+          const [responseA, responseB] = await Promise.all([
+            branchA.prompt(`${branchPrompt} (Focus on Maple Oat Latte)`),
+            branchB.prompt(`${branchPrompt} (Focus on Cold Brew)`),
+          ]);
+
+          updateContextUsage(branchA);
+
+          branchOutputEl.textContent =
+            `[Branch A - Maple Oat Latte Focus]\n${responseA}\n\n` +
+            `[Branch B - Cold Brew Focus]\n${responseB}`;
+        } catch (err) {
+          branchOutputEl.textContent = 'Failed to clone session or run branched prompts.';
+        } finally {
+          branchOutputEl.setAttribute('aria-busy', 'false');
+          cloneBtn.disabled = false;
+          // Immediately destroy cloned sessions once their branched tasks complete to free memory.
+          if (branchA) {
+            branchA.destroy();
+          }
+          if (branchB) {
+            branchB.destroy();
+          }
+        }
+      });
+
+      function destroyAllSessions() {
+        if (baseSession) {
+          baseSession.destroy();
+          baseSession = null;
+        }
+        updateContextUsage(null);
+        downloadStatusEl.textContent = 'Active AI sessions destroyed and memory freed.';
+      }
+
+      cleanupBtn.addEventListener('click', () => {
+        destroyAllSessions();
+      });
+
+      window.addEventListener('pagehide', () => {
+        if (baseSession) {
+          baseSession.destroy();
+          baseSession = null;
+        }
+      });
+    })();
+  </script>
