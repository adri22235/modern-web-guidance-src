+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const signinForm = document.getElementById('signin-form');
+    const passwordInput = document.getElementById('password');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const signinStatus = document.getElementById('signin-status');
+
+    let loginAbortController = new AbortController();
+
+    if (togglePasswordBtn && passwordInput) {
+      togglePasswordBtn.addEventListener('click', () => {
+        const isShowing = passwordInput.type === 'text';
+        passwordInput.type = isShowing ? 'password' : 'text';
+        togglePasswordBtn.setAttribute('aria-pressed', String(!isShowing));
+        togglePasswordBtn.setAttribute('aria-label', isShowing ? 'Show password' : 'Hide password');
+        togglePasswordBtn.textContent = isShowing ? 'Show' : 'Hide';
+      });
+    }
+
+    async function triggerConditionalCreate(abortController) {
+      if (
+        typeof window.PublicKeyCredential === 'undefined' ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        return;
+      }
+
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch {
+        return;
+      }
+
+      if (!capabilities || capabilities.conditionalCreate !== true) {
+        return; // Platform does not support conditional creation
+      }
+
+      // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+      if (abortController) {
+        abortController.abort();
+      }
+
+      // 2. Fetch creation options signaling the backend that this is a conditional request (server options must include rp.id)
+      let creationOptionsJSON;
+      try {
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ conditional: true }),
+        });
+        if (!optionsResponse.ok) {
+          return;
+        }
+        creationOptionsJSON = await optionsResponse.json();
+      } catch {
+        return;
+      }
+
+      const rawOptions = creationOptionsJSON?.publicKey ?? creationOptionsJSON;
+      let publicKey;
+      try {
+        publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions);
+      } catch {
+        publicKey = rawOptions;
+      }
+      if (publicKey && !publicKey.rp && rawOptions?.rp) {
+        publicKey.rp = rawOptions.rp;
+      }
+
+      let credential;
+      try {
+        // 3. Invoke silent credentials creation prompt
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional', // Silent background creation mediation
+        });
+      } catch (e) {
+        // 4. Silently swallow common WebAuthn browser exceptions
+        if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e?.name)) {
+          return;
+        }
+        console.error('Unexpected conditional create error:', e);
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // 5. Server verification step using dedicated Try/Catch block
+      const encodedResponse = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+      try {
+        const response = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(encodedResponse),
+        });
+        if (!response.ok) {
+          // If the server verification fails, clean up using Signal API
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rp.id,
+              credentialId: encodedResponse.id,
+            });
+          }
+        }
+      } catch (serverErr) {
+        console.error('Verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id,
+            credentialId: encodedResponse.id,
+          });
+        }
+      }
+    }
+
+    if (signinForm) {
+      signinForm.addEventListener('submit', async (event) => {
+        event.preventDefault();
+
+        if (signinStatus) {
+          signinStatus.textContent = 'Signed in successfully.';
+          signinStatus.hidden = false;
+        }
+
+        await triggerConditionalCreate(loginAbortController);
+      });
+    }
+  </script>
+
