+
+        this._starsGroup = this._shadow.querySelector('.stars-group');
+        this._readout = this._shadow.querySelector('.rating-readout');
+
+        this._starsGroup.addEventListener('mouseleave', () => {
+          if (this._isDisabled) return;
+          this._hoveredValue = 0;
+          this._updateStarsUI();
+        });
+
+        this._starsGroup.addEventListener('keydown', (e) => this._handleKeyDown(e));
+      }
+
+      _buildStars() {
+        if (!this._starsGroup) return;
+        const max = this.max;
+        this._starsGroup.innerHTML = '';
+        this._starButtons = [];
+
+        for (let i = 1; i <= max; i++) {
