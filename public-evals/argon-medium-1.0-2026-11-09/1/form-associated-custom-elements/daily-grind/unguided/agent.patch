+        this._renderTemplate();
+      }
+
+      connectedCallback() {
+        if (!this._hasCapturedDefault) {
+          this._defaultValue = this._normalizeValue(this.getAttribute('value'));
+          this._value = this._defaultValue;
+          this._hasCapturedDefault = true;
+        }
+
+        if (!this.hasAttribute('role')) {
+          this._internals.role = 'radiogroup';
+        }
+
+        this._isDisabled = this.hasAttribute('disabled') || this.matches(':disabled');
+        this._buildStars();
+        this._syncState();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+
+        switch (name) {
+          case 'value': {
+            const normalized = this._normalizeValue(newValue);
+            if (!this._hasCapturedDefault) {
+              this._defaultValue = normalized;
+            }
+            this._value = normalized;
+            this._syncState();
+            break;
+          }
+          case 'max': {
+            this._buildStars();
+            if (this._value && Number(this._value) > this.max) {
+              this._value = String(this.max);
+            }
+            this._syncState();
+            break;
+          }
+          case 'required': {
+            this._syncState();
+            break;
+          }
+          case 'disabled': {
+            this._isDisabled = this.hasAttribute('disabled') || this.matches(':disabled');
+            this._syncState();
+            break;
+          }
+          case 'name': {
