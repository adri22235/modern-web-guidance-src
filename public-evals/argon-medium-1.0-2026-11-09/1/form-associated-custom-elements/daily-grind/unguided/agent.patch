+        this._hoveredValue = 0;
+        this._syncState();
+      }
+
+      formResetCallback() {
+        this._customValidityMessage = '';
+        this._hoveredValue = 0;
+        this._value = this._normalizeValue(this._defaultValue);
+        this._syncState();
+      }
+
+      formStateRestoreCallback(state, mode) {
+        this._customValidityMessage = '';
+        this._value = this._normalizeValue(state);
+        this._syncState();
+      }
+
+      /* Standard Form Control Properties & Methods */
+
+      get form() {
+        return this._internals.form;
+      }
+
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', String(val));
+        }
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get defaultValue() {
+        return this._defaultValue;
+      }
+
+      set defaultValue(val) {
+        this._defaultValue = this._normalizeValue(val);
+      }
+
+      get value() {
+        return this._value;
+      }
+
+      set value(val) {
+        this._value = this._normalizeValue(val);
+        this._syncState();
+      }
+
+      get max() {
+        const parsed = parseInt(this.getAttribute('max') || '5', 10);
+        return Number.isFinite(parsed) && parsed > 0 ? parsed : 5;
+      }
+
+      set max(val) {
+        this.setAttribute('max', String(val));
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        this.toggleAttribute('required', Boolean(val));
+      }
+
+      get disabled() {
