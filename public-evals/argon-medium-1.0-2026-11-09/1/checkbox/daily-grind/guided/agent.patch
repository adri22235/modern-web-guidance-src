+    /* Drink Customizations & Custom Checkboxes */
+    .customizations {
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      padding: 12px 16px;
+      margin-top: 16px;
+      text-align: start;
+      display: flex;
+      flex-direction: column;
+      align-items: stretch;
+      background-color: var(--light);
+    }
+
+    .customizations-legend {
+      padding: 0 6px;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: var(--primary);
+      letter-spacing: 0.03em;
+      text-transform: uppercase;
+    }
+
+    .checkbox-label {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.65rem;
+      min-block-size: 48px;
+      cursor: pointer;
+      color: var(--text);
+      font-size: 0.95rem;
+      padding: 4px 6px;
+      border-radius: 4px;
+      user-select: none;
+    }
+
+    .checkbox-label:hover .checkbox-custom:not(:disabled):not(:checked):not(:indeterminate) {
+      border-color: var(--text);
+      background-color: rgba(215, 204, 200, 0.3);
+    }
+
+    .checkbox-custom {
+      --checkbox-size: 1.25em;
+      --checkbox-icon-size: 0.7em;
+
+      appearance: none;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      color: var(--primary);
+      background-color: white;
+      display: inline-grid;
+      place-content: center;
+      inline-size: var(--checkbox-size);
+      aspect-ratio: 1;
+      flex-shrink: 0;
+      margin: 0;
+      border: 2px solid currentColor;
+      border-radius: 4px;
+      cursor: pointer;
+
+      @media (prefers-reduced-motion: no-preference) {
+        transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
+      }
+
+      &::before {
+        content: "";
+        inline-size: var(--checkbox-icon-size);
+        aspect-ratio: 1;
+        background-color: currentColor;
+        mask: var(--checkbox-icon) no-repeat center / contain;
+        scale: 0;
+
+        @media (prefers-reduced-motion: no-preference) {
+          transition: scale 150ms ease;
+        }
+
+        @media (forced-colors: active) {
+          background-color: CanvasText;
+        }
+      }
+
+      &:checked {
+        --checkbox-icon: var(--icon-check);
+        background-color: var(--primary);
+        border-color: var(--primary);
+        color: var(--light);
+      }
+
+      &:indeterminate {
+        --checkbox-icon: var(--icon-dash);
+        background-color: var(--primary);
+        border-color: var(--primary);
+        color: var(--light);
+      }
+
+      &:is(:checked, :indeterminate)::before {
+        scale: 1;
+      }
+
+      &:focus-visible {
+        outline: 2px solid var(--primary);
+        outline-offset: 2px;
+      }
+
+      &:disabled {
+        cursor: not-allowed;
+        opacity: 0.5;
+      }
+    }
+
+    .checkbox-label:has(.checkbox-custom:disabled) {
+      cursor: not-allowed;
+      opacity: 0.65;
+    }
+
+    .checkbox-price {
+      margin-inline-start: auto;
+      font-size: 0.85rem;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
     .btn {
