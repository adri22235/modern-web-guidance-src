+          orderUrl: '/order-online?item=maple-oat-latte'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          badge: 'House Signature',
+          price: '$3.50',
+          meta: '15 kcal · Double Shot (2 oz)',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Rich dark roast espresso shot with golden crema',
+          description: 'Small-batch roasted to a deep mahogany finish, our Dark Roast Espresso pulls with a rich hazelnut crema and intense full-bodied depth. Sourced from high-altitude estates in Sumatra and Colombia.',
+          notes: 'Dark Chocolate, Roasted Walnut, Smokey Caramel',
+          ingredients: '100% Arabica Whole Bean Coffee, Filtered Water',
+          orderUrl: '/order-online?item=dark-roast-espresso'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          badge: 'Barista Favorite',
+          price: '$4.75',
+          meta: '10 kcal · 16 oz',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Iced glass of smooth 18-hour steeped cold brew coffee',
+          description: 'Coarsely ground single-origin Ethiopian beans steeped in cold filtered water for 18 hours. Naturally sweet and ultra-smooth with low acidity, served over crystal-clear artisan ice.',
+          notes: 'Cocoa Nibs, Sweet Molasses, Crisp Finish',
+          ingredients: 'Single-Origin Cold-Steeped Coffee, Filtered Water, Ice',
+          orderUrl: '/order-online?item=cold-brew'
+        }
+      };
+
+      const dialog = document.getElementById('coffee-modal');
+      const closeIconBtn = document.getElementById('modal-close-icon');
+      const modalTitle = document.getElementById('modal-title');
+      const modalBadge = document.getElementById('modal-badge');
+      const modalPrice = document.getElementById('modal-price');
+      const modalMeta = document.getElementById('modal-meta');
+      const modalImage = document.getElementById('modal-image');
+      const modalDescription = document.getElementById('modal-description');
+      const modalNotes = document.getElementById('modal-notes');
+      const modalIngredients = document.getElementById('modal-ingredients');
+      const modalOrderLink = document.getElementById('modal-order-link');
+      const detailButtons = document.querySelectorAll('.card-details-btn');
+
+      let activeTrigger = null;
+      let closeWatcher = null;
+      let pushedHistoryState = false;
+      let closingFromPlatformSignal = false;
+
+      function populateDialog(coffeeKey) {
+        const data = COFFEE_DETAILS[coffeeKey];
+        if (!data) return;
+        modalTitle.textContent = data.title;
+        modalBadge.textContent = data.badge;
+        modalPrice.textContent = data.price;
+        modalMeta.textContent = data.meta;
+        modalImage.src = data.image;
+        modalImage.alt = data.imageAlt;
+        modalDescription.textContent = data.description;
+        modalNotes.textContent = data.notes;
+        modalIngredients.textContent = data.ingredients;
+        modalOrderLink.href = data.orderUrl;
+      }
+
+      function setupDismissHandlers() {
+        if ('CloseWatcher' in window) {
+          try {
+            closeWatcher?.destroy();
+            closeWatcher = new window.CloseWatcher();
+            closeWatcher.onclose = () => {
+              closingFromPlatformSignal = true;
+              closeWatcher = null;
+              if (dialog.open) {
+                dialog.close();
+              }
+            };
+          } catch (_) {
+            closeWatcher = null;
+          }
+        } else {
+          history.pushState({ coffeeModalOpen: true }, '', window.location.href);
+          pushedHistoryState = true;
+        }
+      }
+
+      function openCoffeeModal(coffeeKey, triggerEl) {
+        activeTrigger = triggerEl;
+        populateDialog(coffeeKey);
+
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+          setupDismissHandlers();
+        }
+      }
+
+      detailButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          openCoffeeModal(button.dataset.coffee, button);
+        });
+      });
+
+      closeIconBtn.addEventListener('click', () => {
+        if (dialog.open) {
+          dialog.close();
+        }
+      });
+
+      dialog.addEventListener('click', (event) => {
+        if (event.target === dialog) {
+          dialog.close();
+        }
+      });
+
+      window.addEventListener('popstate', () => {
+        if (dialog.open) {
+          closingFromPlatformSignal = true;
+          pushedHistoryState = false;
+          dialog.close();
+        }
+      });
+
+      dialog.addEventListener('close', () => {
+        if (closeWatcher) {
+          closeWatcher.destroy();
+          closeWatcher = null;
+        }
+        if (pushedHistoryState && !closingFromPlatformSignal) {
+          pushedHistoryState = false;
+          if (history.state && history.state.coffeeModalOpen) {
+            history.back();
+          }
+        }
+        closingFromPlatformSignal = false;
+        if (activeTrigger && typeof activeTrigger.focus === 'function') {
+          activeTrigger.focus();
+        }
+      });
+    })();
+  </script>
+
