+  <script>
+    (function () {
+      const COFFEE_DETAILS = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          badge: 'Seasonal Limited',
+          price: '$5.75',
+          meta: '210 kcal · 12 oz',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'A warm cup of Maple Oat Latte with latte art',
+          description: 'Our signature double-shot espresso blended with velvety steamed barista-grade oat milk and pure Grade A dark amber Vermont maple syrup, finished with a light dusting of cinnamon nutmeg.',
+          notes: 'Warm Maple, Toasted Oat, Sweet Cinnamon',
