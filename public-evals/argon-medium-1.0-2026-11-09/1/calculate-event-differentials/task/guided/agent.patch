+  <script type="module">
+    function updateMapleOatLatteCountdown() {
+      const remainingEl = document.getElementById('maple-time-remaining');
+      const elapsedEl = document.getElementById('maple-time-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      // 1. Obtain the current time in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // 2. Combine separate date and time strings with Temporal methods
+      const startDateStr = '2026-01-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr).toPlainDateTime(startTimeStr).toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr).toPlainDateTime(endTimeStr).toZonedDateTime(tz);
+
+      // 3. Calculate differentials balanced to days and hours
+      const timeElapsed = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      // 4. Check expiration via .sign and format for humans with .toLocaleString() (Intl.DurationFormat)
+      // and for machines with .toString() (ISO 8601 duration)
+      const isExpired = timeRemaining.sign < 0;
+
+      elapsedEl.setAttribute('datetime', timeElapsed.toString());
+      elapsedEl.textContent = timeElapsed.toLocaleString(undefined, { style: 'long' });
+
+      remainingEl.setAttribute('datetime', timeRemaining.toString());
+      if (isExpired) {
+        remainingEl.classList.add('promo-expired');
+        remainingEl.textContent = `Offer ended (${timeRemaining.abs().toLocaleString(undefined, { style: 'long' })} ago)`;
+      } else {
+        remainingEl.classList.remove('promo-expired');
+        remainingEl.textContent = timeRemaining.toLocaleString(undefined, { style: 'long' });
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      if (document.readyState === 'loading') {
+        window.addEventListener('DOMContentLoaded', updateMapleOatLatteCountdown, { once: true });
+      } else {
+        updateMapleOatLatteCountdown();
+      }
+    })();
+  </script>
