+  <script>
+    // Ensure a fallback for environments where native Temporal is not yet enabled
+    if (typeof globalThis.Temporal === 'undefined') {
+      const createZoned = (epochMs, timeZone) => ({
+        epochMilliseconds: epochMs,
+        timeZoneId: timeZone,
+        until(other) {
+          const diffMs = other.epochMilliseconds - epochMs;
+          const sign = diffMs < 0 ? -1 : diffMs > 0 ? 1 : 0;
+          const totalHours = Math.trunc(diffMs / (1000 * 60 * 60));
+          const days = Math.trunc(totalHours / 24);
+          const hours = totalHours % 24;
+          return { days, hours, sign };
+        },
+        since(other) {
+          const diffMs = epochMs - other.epochMilliseconds;
+          const sign = diffMs < 0 ? -1 : diffMs > 0 ? 1 : 0;
+          const totalHours = Math.trunc(diffMs / (1000 * 60 * 60));
+          const days = Math.trunc(totalHours / 24);
+          const hours = totalHours % 24;
+          return { days, hours, sign };
+        }
+      });
+
+      globalThis.Temporal = {
+        Now: {
+          timeZoneId() {
+            return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
+          },
+          zonedDateTimeISO(tz) {
+            const timeZone = tz || this.timeZoneId();
+            return createZoned(Date.now(), timeZone);
+          }
+        },
+        ZonedDateTime: {
+          from(item) {
+            const timeZone = item.timeZone || Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
+            const date = new Date(
+              item.year,
+              (item.month || 1) - 1,
+              item.day || 1,
+              item.hour || 0,
+              item.minute || 0,
+              item.second || 0
+            );
+            return createZoned(date.getTime(), timeZone);
+          }
+        }
+      };
+    }
+
+    function updateMapleOatLatteCountdown() {
+      const remainingEl = document.getElementById('countdown-remaining');
+      const elapsedEl = document.getElementById('countdown-elapsed');
+      const timezoneEl = document.getElementById('countdown-timezone');
+
+      if (!remainingEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      // Promotion starts February 1, 2026 at midnight in the user's local time zone
+      const promoStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      // Offer ends March 1, 2026 at midnight in the user's local time zone
+      const promoEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const remainingDuration = now.until(promoEnd, { largestUnit: 'day' });
+      const elapsedDuration = now.since(promoStart, { largestUnit: 'day' });
+
+      if (remainingDuration.days < 0 || remainingDuration.hours < 0 || remainingDuration.sign < 0) {
+        remainingEl.textContent = `Offer ends in: 0 days, 0 hours (Ended ${Math.abs(remainingDuration.days)} days, ${Math.abs(remainingDuration.hours)} hours ago)`;
+      } else {
+        remainingEl.textContent = `Offer ends in: ${remainingDuration.days} days, ${remainingDuration.hours} hours left`;
+      }
+
+      const elapsedDays = Math.max(0, elapsedDuration.days);
+      const elapsedHours = Math.max(0, elapsedDuration.hours);
+      elapsedEl.textContent = `Time elapsed since promo start: ${elapsedDays} days, ${elapsedHours} hours`;
+
+      if (timezoneEl) {
+        timezoneEl.textContent = `Local time zone: ${userTimeZone}`;
+      }
+    }
+
+    window.addEventListener('DOMContentLoaded', updateMapleOatLatteCountdown);
+    window.addEventListener('load', updateMapleOatLatteCountdown);
+    updateMapleOatLatteCountdown();
+  </script>
 </body>
 
