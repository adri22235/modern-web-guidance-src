+  <script nonce="{{CSP_NONCE}}">
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    }
+
+    const htmlPolicy = window.trustedTypes.createPolicy('app-html', {
+      createHTML(input) {
+        return String(input)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      },
+    });
+
+    function setSafeText(element, text) {
+      if (element) {
+        element.textContent = String(text ?? '');
+      }
+    }
+
+    function setSafeHTML(element, untrustedHTML) {
+      if (!element) return;
+      if ('setHTML' in Element.prototype) {
+        element.setHTML(String(untrustedHTML ?? ''));
+      } else {
+        element.innerHTML = htmlPolicy.createHTML(untrustedHTML);
+      }
+    }
+
+    window.addEventListener('message', (event) => {
+      if (event.origin !== window.location.origin) return;
+      const data = event.data;
+      if (data && data.action === 'status-update' && typeof data.message === 'string') {
+        const statusBanner = document.getElementById('status-banner');
+        setSafeText(statusBanner, data.message);
+      }
+    });
+  </script>
