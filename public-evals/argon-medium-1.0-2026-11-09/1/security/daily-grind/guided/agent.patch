+  const site = Array.isArray(siteHeader) ? siteHeader[0] : siteHeader;
+  const mode = Array.isArray(modeHeader) ? modeHeader[0] : modeHeader;
+  const dest = Array.isArray(destHeader) ? destHeader[0] : destHeader;
