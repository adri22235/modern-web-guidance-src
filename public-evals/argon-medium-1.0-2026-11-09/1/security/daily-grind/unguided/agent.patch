+(function () {
+  'use strict';
+
+  /**
+   * 1. Trusted Types Policy (DOM XSS Prevention)
+   * Provides a default sanitization policy for DOM XSS sinks when supported by the browser.
+   */
+  function initTrustedTypes() {
+    if (typeof window !== 'undefined' && window.trustedTypes && window.trustedTypes.createPolicy) {
+      try {
+        if (!window.trustedTypes.defaultPolicy) {
+          window.trustedTypes.createPolicy('default', {
+            createHTML: function (input) {
+              return String(input)
+                .replace(/&/g, '&amp;')
+                .replace(/</g, '&lt;')
+                .replace(/>/g, '&gt;')
+                .replace(/"/g, '&quot;')
+                .replace(/'/g, '&#39;');
+            },
+            createScriptURL: function (input) {
+              var url = new URL(input, window.location.origin);
+              if (url.origin === window.location.origin) {
+                return url.href;
+              }
+              throw new TypeError('Blocked cross-origin script URL: ' + input);
+            },
+            createScript: function () {
+              throw new TypeError('Dynamic script evaluation is blocked by security policy.');
+            }
+          });
+        }
+      } catch (_err) {
+        // Default policy may already exist
+      }
+    }
+  }
+
+  /**
+   * 2. Security Policy Violation Monitoring & Telemetry
+   * Captures CSP violations on the client and reports them to /csp-report to ensure
+   * safe policy deployment without breaking legitimate page functionality.
+   */
+  function initCspReporting() {
+    if (typeof document === 'undefined') return;
+
+    document.addEventListener('securitypolicyviolation', function (event) {
+      var payload = JSON.stringify({
+        'csp-report': {
+          'document-uri': event.documentURI,
+          'referrer': event.referrer,
+          'violated-directive': event.violatedDirective,
+          'effective-directive': event.effectiveDirective,
+          'original-policy': event.originalPolicy,
+          'disposition': event.disposition,
+          'blocked-uri': event.blockedURI,
+          'line-number': event.lineNumber,
+          'column-number': event.columnNumber,
+          'source-file': event.sourceFile,
+          'status-code': event.statusCode,
+          'sample': event.sample || ''
+        }
+      });
+
+      try {
+        if (navigator.sendBeacon) {
+          var blob = new Blob([payload], { type: 'application/csp-report' });
+          navigator.sendBeacon('/csp-report', blob);
+        } else if (window.fetch) {
+          window.fetch('/csp-report', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/csp-report' },
+            body: payload,
+            keepalive: true,
+            credentials: 'same-origin'
+          }).catch(function () {});
+        }
+      } catch (_err) {
+        // Ignore reporting transport errors
+      }
+    });
+  }
+
+  /**
+   * 3. Clickjacking / Frame-Busting Defense-in-Depth
+   * Complements CSP frame-ancestors 'none' and X-Frame-Options: DENY.
+   */
+  function enforceFrameBusting() {
+    if (typeof window === 'undefined') return;
+    try {
+      if (window.top !== window.self) {
+        window.top.location = window.self.location.href;
+      }
+    } catch (_err) {
+      // Cross-origin framing detected; conceal document body
+      if (document.documentElement) {
+        document.documentElement.style.display = 'none';
+      }
+    }
+  }
+
+  /**
+   * 4. Markup & Link Sanitization (Preventing javascript:/data: URIs, Reverse Tabnabbing, & Accidental Prefetching)
+   */
+  function auditAnchorElement(anchor) {
+    if (!anchor || anchor.tagName !== 'A') return;
+
+    var rawHref = anchor.getAttribute('href') || '';
+    var trimmed = rawHref.trim().toLowerCase();
+
+    // Neutralize dangerous URI schemes
+    if (
+      trimmed.indexOf('javascript:') === 0 ||
+      trimmed.indexOf('data:') === 0 ||
+      trimmed.indexOf('vbscript:') === 0
+    ) {
+      anchor.setAttribute('href', '#');
+      anchor.removeAttribute('target');
+      return;
+    }
+
+    // Protect external links against reverse tabnabbing
+    try {
+      var parsed = new URL(rawHref, window.location.origin);
+      if (parsed.origin !== window.location.origin) {
+        var existingRel = (anchor.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+        if (existingRel.indexOf('noopener') === -1) existingRel.push('noopener');
+        if (existingRel.indexOf('noreferrer') === -1) existingRel.push('noreferrer');
+        anchor.setAttribute('rel', existingRel.join(' '));
+      }
+
+      // Harden logout link against speculative prefetching/crawling
+      if (parsed.pathname === '/logout' || parsed.pathname === '/logout/' || anchor.classList.contains('logout-link')) {
+        var logoutRel = (anchor.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
+        ['nofollow', 'noopener', 'noreferrer'].forEach(function (token) {
+          if (logoutRel.indexOf(token) === -1) logoutRel.push(token);
+        });
+        anchor.setAttribute('rel', logoutRel.join(' '));
+        anchor.setAttribute('data-no-prefetch', 'true');
+      }
+    } catch (_err) {
+      anchor.setAttribute('href', '#');
+    }
+  }
+
+  function auditDocumentLinks() {
+    var anchors = document.querySelectorAll('a[href]');
+    for (var i = 0; i < anchors.length; i++) {
+      auditAnchorElement(anchors[i]);
+    }
+
+    if (typeof MutationObserver !== 'undefined' && document.body) {
+      var observer = new MutationObserver(function (mutations) {
+        for (var m = 0; m < mutations.length; m++) {
+          var added = mutations[m].addedNodes;
+          for (var n = 0; n < added.length; n++) {
+            var node = added[n];
+            if (node.nodeType === 1) {
+              if (node.tagName === 'A') {
+                auditAnchorElement(node);
+              } else if (node.querySelectorAll) {
+                var nested = node.querySelectorAll('a[href]');
+                for (var k = 0; k < nested.length; k++) {
+                  auditAnchorElement(nested[k]);
+                }
+              }
+            }
+          }
+        }
+      });
+      observer.observe(document.body, { childList: true, subtree: true });
+    }
+  }
+
+  /**
+   * 5. Client-Side Session & Storage Cleanup on Logout
+   */
+  function clearClientSessionData() {
+    try {
+      if (window.localStorage) window.localStorage.clear();
+    } catch (_err) {}
+    try {
+      if (window.sessionStorage) window.sessionStorage.clear();
+    } catch (_err) {}
+    try {
+      if (document.cookie) {
+        var cookies = document.cookie.split(';');
+        for (var i = 0; i < cookies.length; i++) {
+          var eqPos = cookies[i].indexOf('=');
+          var name = (eqPos > -1 ? cookies[i].slice(0, eqPos) : cookies[i]).trim();
+          if (name) {
+            document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; Max-Age=0; path=/; SameSite=Strict';
+          }
+        }
+      }
+    } catch (_err) {}
+  }
+
+  function initSafeLogout() {
+    if (window.location.pathname === '/logout' || window.location.pathname === '/logout/') {
+      clearClientSessionData();
+    }
+
+    var logoutLinks = document.querySelectorAll('a.logout-link, a[href="/logout"]');
+    for (var i = 0; i < logoutLinks.length; i++) {
+      logoutLinks[i].addEventListener('click', function () {
+        clearClientSessionData();
+      });
+    }
+  }
+
+  initTrustedTypes();
+  initCspReporting();
+  enforceFrameBusting();
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', function () {
+      auditDocumentLinks();
+      initSafeLogout();
+    });
+  } else {
+    auditDocumentLinks();
+    initSafeLogout();
+  }
+})();
