+
+/* Prevent underlying page scroll when a modal dialog is open */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+/* Support both native :popover-open and @oddbird/popover-polyfill class */
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
+
+/* Visually signify inactivity for inert sections */
+[inert],
+[inert] * {
+  opacity: 0.5;
+  cursor: default;
+  user-select: none;
+}
+
+/* Accessible focus-visible indicator */
+:focus-visible {
+  outline: 3px solid #d97706;
+  outline-offset: 2px;
