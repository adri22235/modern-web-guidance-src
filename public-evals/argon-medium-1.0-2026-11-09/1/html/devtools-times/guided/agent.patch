+    <script>
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        import('invokers-polyfill');
+      }
+      if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+        import('@oddbird/popover-polyfill');
+      }
+
+      const initClosedByFallback = () => {
+        if (!('closedBy' in HTMLDialogElement.prototype)) {
+          const outside = (e: PointerEvent, dialog: HTMLDialogElement) => {
+            const r = dialog.getBoundingClientRect();
+            return (
+              e.clientX < r.left ||
+              e.clientX > r.right ||
+              e.clientY < r.top ||
+              e.clientY > r.bottom
+            );
+          };
+          for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[closedby="any"]')) {
+            if (dialog.dataset.closedbyBound === 'true') continue;
+            dialog.dataset.closedbyBound = 'true';
+            let pressedOutside = false;
+            dialog.addEventListener('pointerdown', (e) => {
+              pressedOutside = outside(e, dialog);
+            });
+            dialog.addEventListener('pointerup', (e) => {
+              if (pressedOutside && outside(e, dialog)) dialog.close();
+            });
+          }
+        }
+      };
+
+      initClosedByFallback();
+      document.addEventListener('astro:page-load', initClosedByFallback);
+    </script>
   </body>
 </html>
