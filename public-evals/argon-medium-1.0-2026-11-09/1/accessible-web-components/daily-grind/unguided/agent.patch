+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static get observedAttributes() {
+        return ['drink', 'aria-pressed', 'favorited'];
+      }
+
+      constructor() {
+        super();
+        this._isSyncing = false;
+        this._onClick = this._onClick.bind(this);
+        this._onKeyDown = this._onKeyDown.bind(this);
+      }
+
+      connectedCallback() {
+        if (!this.hasAttribute('role')) {
+          this.setAttribute('role', 'button');
+        }
+        if (!this.hasAttribute('tabindex')) {
+          this.setAttribute('tabindex', '0');
+        }
+
+        const initialFav =
+          this.getAttribute('aria-pressed') === 'true' ||
+          this.hasAttribute('favorited');
+
+        this._syncState(initialFav);
+        this._updateLabel();
+        this._render();
+
+        this.addEventListener('click', this._onClick);
+        this.addEventListener('keydown', this._onKeyDown);
+      }
+
+      disconnectedCallback() {
+        this.removeEventListener('click', this._onClick);
+        this.removeEventListener('keydown', this._onKeyDown);
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || this._isSyncing) return;
+
+        if (name === 'drink') {
+          this._updateLabel();
+        } else if (name === 'aria-pressed') {
+          this._syncState(newValue === 'true');
+          this._render();
+        } else if (name === 'favorited') {
+          this._syncState(newValue !== null && newValue !== 'false');
+          this._render();
+        }
+      }
+
+      get drink() {
+        if (this.hasAttribute('drink')) {
+          return this.getAttribute('drink');
+        }
+        const cardHeading = this.closest('.card')?.querySelector('h3');
+        return cardHeading ? cardHeading.textContent.trim() : '';
+      }
+
+      set drink(value) {
+        this.setAttribute('drink', value);
+      }
+
+      get favorited() {
+        return this.getAttribute('aria-pressed') === 'true';
+      }
+
+      set favorited(value) {
+        this._syncState(Boolean(value));
+        this._render();
+      }
+
+      get pressed() {
+        return this.favorited;
+      }
+
+      set pressed(value) {
+        this.favorited = value;
+      }
+
+      get checked() {
+        return this.favorited;
+      }
+
+      set checked(value) {
+        this.favorited = value;
+      }
+
+      toggle() {
+        if (
+          this.hasAttribute('disabled') ||
+          this.getAttribute('aria-disabled') === 'true'
+        ) {
+          return;
+        }
+        const nextState = !this.favorited;
+        this.favorited = nextState;
+        this.dispatchEvent(
+          new CustomEvent('change', {
+            detail: { favorited: nextState, drink: this.drink },
+            bubbles: true
+          })
+        );
+      }
+
+      _syncState(isFav) {
+        this._isSyncing = true;
+        this.setAttribute('aria-pressed', String(isFav));
+        this.toggleAttribute('favorited', isFav);
+        this.setAttribute('data-favorited', String(isFav));
+        this._isSyncing = false;
+      }
+
+      _updateLabel() {
+        const drinkName = this.drink;
+        this.setAttribute(
+          'aria-label',
+          drinkName ? `Favorite ${drinkName}` : 'Favorite'
+        );
+      }
+
+      _onClick(event) {
+        event.preventDefault();
+        this.toggle();
+      }
+
+      _onKeyDown(event) {
+        if (
+          event.key === ' ' ||
+          event.key === 'Spacebar' ||
+          event.code === 'Space' ||
+          event.key === 'Enter'
+        ) {
+          event.preventDefault();
+          this.toggle();
+        }
+      }
+
+      _render() {
+        const isFav = this.favorited;
+        const fill = isFav ? 'currentColor' : 'none';
+        this.innerHTML = `
+          <span class="fav-icon" aria-hidden="true">
+            <svg viewBox="0 0 24 24" width="18" height="18" fill="${fill}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
+              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
+            </svg>
+          </span>
+          <span class="fav-label">Favorite</span>
+        `;
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
