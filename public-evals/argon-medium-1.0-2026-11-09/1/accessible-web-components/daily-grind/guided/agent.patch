+  <script type="module">
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <span class="icon" part="icon" aria-hidden="true">
+        <svg viewBox="0 0 24 24" width="16" height="16">
+          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
+        </svg>
+      </span>
+      <span class="label" part="label"><slot>Favorite</slot></span>
+      <span class="track" part="track" aria-hidden="true">
+        <span class="thumb" part="thumb"></span>
+      </span>
+    `;
+
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      @layer base, state;
+
+      @layer base {
+        :host {
+          --_accent: var(--favorite-accent, #4e342e);
+          --_bg: var(--favorite-bg, #fafafa);
+          --_active-bg: var(--favorite-active-bg, #fff3e0);
+          --_border: var(--favorite-border, #d7ccc8);
+          --_track-bg: var(--favorite-track-bg, #d7ccc8);
+          display: inline-flex;
+          align-items: center;
+          gap: 8px;
+          padding: 6px 12px;
+          border-radius: 999px;
+          border: 1px solid var(--_border);
+          background: var(--_bg);
+          color: inherit;
+          font-size: 0.85rem;
+          font-weight: 600;
+          cursor: pointer;
+          user-select: none;
+          transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
+        }
+
+        :host(:focus-visible) {
+          outline: 3px solid var(--accent, #ffab40);
+          outline-offset: 3px;
+        }
+
+        .icon {
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          color: var(--_accent);
+        }
+
+        .icon svg {
+          fill: none;
+          stroke: currentColor;
+          stroke-width: 2;
+          transition: fill 0.2s ease, transform 0.2s ease;
+        }
+
+        .track {
+          position: relative;
+          display: inline-flex;
+          align-items: center;
+          width: 32px;
+          height: 18px;
+          padding: 2px;
+          border-radius: 999px;
+          background: var(--_track-bg);
+          transition: background-color 0.2s ease;
+          box-sizing: border-box;
+        }
+
+        .thumb {
+          width: 14px;
+          height: 14px;
+          border-radius: 50%;
+          background: #ffffff;
+          box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+          transition: transform 0.2s ease;
+        }
+      }
+
+      @layer state {
+        :host([disabled]) {
+          opacity: 0.5;
+          pointer-events: none;
+          cursor: default;
+        }
+
+        :host(:state(favorited)) {
+          background: var(--_active-bg);
+          border-color: var(--_accent);
+          color: var(--_accent);
+        }
+
+        :host(:state(favorited)) .icon svg {
+          fill: currentColor;
+          transform: scale(1.1);
+        }
+
+        :host(:state(favorited)) .track {
+          background: var(--_accent);
+        }
+
+        :host(:state(favorited)) .thumb {
+          transform: translateX(14px);
+        }
+      }
+    `);
+
+    class FavoriteToggle extends HTMLElement {
+      static observedAttributes = ['favorited', 'disabled', 'label'];
+
+      #internals;
+      #favorited = false;
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        this.#internals = this.attachInternals();
+        if ('role' in this.#internals) {
+          this.#internals.role = 'switch';
+          this.#internals.ariaChecked = 'false';
+        }
+
+        this.addEventListener('click', () => {
+          if (!this.disabled) this.toggle();
+        });
+        this.addEventListener('keydown', (e) => {
+          if (this.disabled) return;
+          if (e.key === ' ' || e.key === 'Enter') {
+            e.preventDefault();
+            this.toggle();
+          }
+        });
+      }
+
+      connectedCallback() {
+        if (!('role' in this.#internals) && !this.hasAttribute('role')) {
+          this.setAttribute('role', 'switch');
+        }
+        if (!this.hasAttribute('tabindex')) {
+          this.tabIndex = this.disabled ? -1 : 0;
+        }
+        this.#favorited = this.hasAttribute('favorited');
+        this.#syncAccessibilityAndState();
+      }
+
+      connectedMoveCallback() {}
+
+      disconnectedCallback() {}
+
+      get favorited() {
+        return this.#favorited;
+      }
+
+      set favorited(on) {
+        const next = Boolean(on);
+        if (this.#favorited === next && this.hasAttribute('favorited') === next) return;
+        this.#favorited = next;
+        this.toggleAttribute('favorited', next);
+        this.#syncAccessibilityAndState();
+      }
+
+      get checked() {
+        return this.favorited;
+      }
+
+      set checked(on) {
+        this.favorited = on;
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(on) {
+        this.toggleAttribute('disabled', Boolean(on));
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+
+      set label(v) {
+        v ? this.setAttribute('label', v) : this.removeAttribute('label');
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'favorited') {
+          this.#favorited = newVal !== null;
+        }
+        this.#syncAccessibilityAndState();
+      }
+
+      toggle() {
+        if (this.disabled) return;
+        this.favorited = !this.#favorited;
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+      }
+
+      #syncAccessibilityAndState() {
+        const checkedStr = String(this.#favorited);
+        const disabledStr = String(this.disabled);
+
+        if (this.#internals.states) {
+          if (this.#favorited) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+
+        if ('ariaChecked' in this.#internals) {
+          this.#internals.ariaChecked = checkedStr;
+          this.#internals.ariaDisabled = disabledStr;
+          this.#internals.ariaLabel = this.label || null;
+        } else if (this.isConnected) {
+          this.setAttribute('aria-checked', checkedStr);
+          this.setAttribute('aria-disabled', disabledStr);
+          if (this.label) {
+            this.setAttribute('aria-label', this.label);
+          }
+        }
+
+        if (this.isConnected) {
+          if (this.disabled && this.tabIndex >= 0) {
+            this.tabIndex = -1;
+          } else if (!this.disabled && !this.hasAttribute('tabindex')) {
+            this.tabIndex = 0;
+          }
+        }
+      }
+    }
+
+    if (!customElements.get('favorite-toggle')) {
+      customElements.define('favorite-toggle', FavoriteToggle);
+    }
+  </script>
