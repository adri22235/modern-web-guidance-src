+  <script>
+    const alertElement = document.querySelector('#promo-alert');
+    const alertDismissBtn = document.querySelector('#alert-dismiss');
+
+    function dismissAlert() {
+      if (!alertElement) return;
+      alertElement.classList.add('is-dismissed');
+      const transitions = alertElement.getAnimations().filter((animation) => animation instanceof CSSTransition);
+      Promise.allSettled(transitions.map((transition) => transition.finished)).then(() => {
+        if (alertElement.classList.contains('is-dismissed')) {
+          alertElement.hidden = true;
+        }
+      });
+    }
+
+    alertDismissBtn?.addEventListener('click', dismissAlert);
+
+    const triggerBtn = document.querySelector('#faq-trigger');
+    const faqContent = document.querySelector('#faq-content');
+
+    triggerBtn?.addEventListener('click', () => {
+      const isExpanded = triggerBtn.getAttribute('aria-expanded') === 'true';
+      const nextState = !isExpanded;
+      triggerBtn.setAttribute('aria-expanded', String(nextState));
+      faqContent?.classList.toggle('is-expanded', nextState);
+    });
+  </script>
+
