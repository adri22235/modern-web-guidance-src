+  <script>
+    const progress = document.getElementById("loyalty-progress");
+    const countEl = document.getElementById("loyalty-count");
+    const sublabelEl = document.getElementById("loyalty-sublabel");
+    const statusTextEl = document.getElementById("loyalty-status-text");
+    const addVisitBtn = document.getElementById("add-visit-btn");
+
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      progress.style.setProperty("--value", progress.getAttribute("value"));
+      const observer = new MutationObserver(() => {
+        progress.style.setProperty("--value", progress.getAttribute("value"));
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ["value"],
+      });
+    }
+
+    addVisitBtn.addEventListener("click", () => {
+      const current = Number(progress.getAttribute("value")) || 0;
+      const next = current >= 100 ? 10 : Math.min(100, current + 10);
+      progress.setAttribute("value", String(next));
+      countEl.textContent = `${next} / 100`;
+
+      if (next >= 100) {
+        sublabelEl.textContent = "Free drink ready!";
+        statusTextEl.textContent = "Congratulations! You've reached 100 beans and unlocked a free handcrafted drink of your choice.";
+        addVisitBtn.textContent = "Redeem & Start New Card";
+      } else {
+        const drinksRemaining = Math.ceil((100 - next) / 10);
+        sublabelEl.textContent = `${drinksRemaining} ${drinksRemaining === 1 ? "drink" : "drinks"} away!`;
+        statusTextEl.textContent = `You're ${next}% of the way to a complimentary handcrafted drink of any size. Keep sipping to reach 100 beans!`;
+        addVisitBtn.textContent = "Log a Coffee (+10 Beans)";
+      }
+    });
+  </script>
