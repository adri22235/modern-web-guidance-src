+  <script type="module">
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'cta',
+        'price',
+        'featured',
+        'disabled',
+      ];
+
+      #internals;
+      #abortController = null;
+      #initialized = false;
+      #els = null;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(v) {
+        v ? this.setAttribute('name', v) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(v) {
+        v ? this.setAttribute('description', v) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', v) : this.removeAttribute('href');
+      }
+
+      get cta() {
+        return this.getAttribute('cta') ?? '';
+      }
+      set cta(v) {
+        v ? this.setAttribute('cta', v) : this.removeAttribute('cta');
+      }
+
+      // Numeric attribute: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(v) {
+        this.setAttribute('price', String(v));
+      }
+
+      // Boolean attributes: present = true, absent = false. Never set to "false"
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      connectedCallback() {
+        // Idempotent setup: connectedCallback can run more than once when moved
+        this.classList.add('card');
+        this.#ensureStructure();
+        this.#attachListeners();
+        this.render();
+      }
+
+      connectedMoveCallback() {
+        // Preserves existing listeners and runtime state across Node.moveBefore() relocations
+      }
+
+      disconnectedCallback() {
+        // Tear down active listeners without treating teardown as permanent
+        this.#abortController?.abort();
+        this.#abortController = null;
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.isConnected) {
+          this.render();
+        }
+      }
+
+      #attachListeners() {
+        this.#abortController?.abort();
+        this.#abortController = new AbortController();
+        const { signal } = this.#abortController;
+
+        this.addEventListener(
+          'click',
+          (event) => {
+            if (this.disabled) {
+              event.preventDefault();
+              return;
+            }
+            if (event.target.closest('a')) return;
+            if (this.#internals.states.has('selected')) {
+              this.#internals.states.delete('selected');
+            } else {
+              this.#internals.states.add('selected');
+            }
+          },
+          { signal }
+        );
+      }
+
+      #ensureStructure() {
+        if (this.#initialized) return;
+
+        // Sync initial attributes from existing light DOM children if present on upgrade
+        const existingTitle = this.querySelector('h3');
+        const existingDesc = this.querySelector('p');
+        const existingLink = this.querySelector('a.btn');
+
+        if (!this.hasAttribute('name') && existingTitle?.textContent) {
+          this.name = existingTitle.textContent.trim();
+        }
+        if (!this.hasAttribute('description') && existingDesc?.textContent) {
+          this.description = existingDesc.textContent.trim();
+        }
+        if (!this.hasAttribute('href') && existingLink) {
+          const rawHref = existingLink.getAttribute('href');
+          if (rawHref) this.href = rawHref;
+        }
+        if (!this.hasAttribute('cta') && existingLink?.textContent) {
+          this.cta = existingLink.textContent.trim();
+        }
+
+        const badge = this.querySelector('.coffee-badge') ?? document.createElement('span');
+        badge.className = 'coffee-badge';
+
+        const title = existingTitle ?? document.createElement('h3');
+        const desc = existingDesc ?? document.createElement('p');
+
+        const meta = this.querySelector('.coffee-meta') ?? document.createElement('div');
+        meta.className = 'coffee-meta';
+
+        const link = existingLink ?? document.createElement('a');
+        link.className = 'btn';
+
+        this.replaceChildren(badge, title, desc, meta, link);
+        this.#els = { badge, title, desc, meta, link };
+        this.#initialized = true;
+      }
+
+      render() {
+        this.#ensureStructure();
+        const { badge, title, desc, meta, link } = this.#els;
+
+        badge.hidden = !this.featured;
+        badge.textContent = this.featured ? 'Featured' : '';
+
+        title.textContent = this.name;
+        desc.textContent = this.description;
+
+        const currentPrice = this.price;
+        meta.hidden = currentPrice <= 0;
+        meta.textContent = currentPrice > 0 ? `$${currentPrice.toFixed(2)}` : '';
+
+        link.setAttribute('href', this.href || '#');
+        link.textContent = this.cta || (this.disabled ? 'Sold Out' : 'View Details');
+
+        if (this.disabled) {
+          link.setAttribute('aria-disabled', 'true');
+          link.setAttribute('tabindex', '-1');
+        } else {
+          link.removeAttribute('aria-disabled');
+          link.removeAttribute('tabindex');
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
