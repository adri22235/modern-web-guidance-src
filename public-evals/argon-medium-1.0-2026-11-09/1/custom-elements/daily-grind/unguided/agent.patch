+    /**
+     * Autonomous custom element representing an artisanal coffee product card.
+     * Supports full lifecycle hooks and two-way attribute/property reflection
+     * for string, numeric, and boolean attributes.
+     */
+    class CoffeeCard extends HTMLElement {
+      static STRING_ATTRIBUTES = [
+        'name',
+        'title',
+        'description',
+        'href',
+        'image',
+        'roast',
+        'cta-text'
+      ];
+
+      static NUMERIC_ATTRIBUTES = [
+        'price',
+        'rating',
+        'calories',
+        'intensity'
+      ];
+
+      static BOOLEAN_ATTRIBUTES = [
+        'featured',
+        'seasonal',
+        'iced',
+        'sold-out',
+        'disabled'
+      ];
+
+      static get observedAttributes() {
+        return [
+          ...CoffeeCard.STRING_ATTRIBUTES,
+          ...CoffeeCard.NUMERIC_ATTRIBUTES,
+          ...CoffeeCard.BOOLEAN_ATTRIBUTES
+        ];
+      }
+
+      static get reflectedProperties() {
+        return [
+          'name',
+          'title',
+          'description',
+          'href',
+          'image',
+          'roast',
+          'ctaText',
+          'price',
+          'rating',
+          'calories',
+          'intensity',
+          'featured',
+          'seasonal',
+          'iced',
+          'soldOut',
+          'disabled'
+        ];
+      }
+
+      constructor() {
+        super();
+        this._isConnected = false;
+        this._onCtaClick = this._handleCtaClick.bind(this);
+
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        shadowRoot.appendChild(coffeeCardTemplate.content.cloneNode(true));
+
+        this._els = {
+          media: shadowRoot.querySelector('.media'),
+          image: shadowRoot.querySelector('.card-image'),
+          badgeFeatured: shadowRoot.querySelector('.badge-featured'),
+          badgeSeasonal: shadowRoot.querySelector('.badge-seasonal'),
+          badgeIced: shadowRoot.querySelector('.badge-iced'),
+          badgeSoldOut: shadowRoot.querySelector('.badge-sold-out'),
+          metaRow: shadowRoot.querySelector('.meta-row'),
+          roastPill: shadowRoot.querySelector('.roast-pill'),
+          priceTag: shadowRoot.querySelector('.price-tag'),
+          title: shadowRoot.querySelector('.card-title'),
+          description: shadowRoot.querySelector('.description'),
+          statsRow: shadowRoot.querySelector('.stats-row'),
+          statRating: shadowRoot.querySelector('.stat-rating'),
+          ratingValue: shadowRoot.querySelector('.rating-value'),
+          statIntensity: shadowRoot.querySelector('.stat-intensity'),
+          intensityDots: shadowRoot.querySelector('.intensity-dots'),
+          statCalories: shadowRoot.querySelector('.stat-calories'),
+          cta: shadowRoot.querySelector('.btn')
+        };
+      }
+
+      /* =====================================================================
+       * Lifecycle Callbacks
+       * ===================================================================== */
+
+      connectedCallback() {
+        this._isConnected = true;
+
+        // Upgrade any properties set on the element instance before definition
+        for (const prop of CoffeeCard.reflectedProperties) {
