+              roast: this.roast,
+              price: this.price,
+              rating: this.rating,
+              calories: this.calories,
+              intensity: this.intensity,
+              featured: this.featured,
+              seasonal: this.seasonal,
+              iced: this.iced,
+              soldOut: this.soldOut
+            }
+          })
+        );
+      }
+
+      _render() {
