+        const hasRating = this.hasAttribute('rating') && this.rating > 0;
+        const hasIntensity = this.hasAttribute('intensity') && this.intensity > 0;
+        const hasCalories = this.hasAttribute('calories') && this.calories >= 0 && this.getAttribute('calories').trim() !== '';
+
+        this._els.statRating.hidden = !hasRating;
+        if (hasRating) {
