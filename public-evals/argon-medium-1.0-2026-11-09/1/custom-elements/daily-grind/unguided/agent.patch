+        }
+
+        this._els.statIntensity.hidden = !hasIntensity;
+        if (hasIntensity) {
+          const level = this.intensity;
+          this._els.intensityDots.innerHTML = Array.from({ length: 5 }, (_, idx) =>
+            `<span class="dot${idx < level ? ' filled' : ''}"></span>`
+          ).join('');
+          this._els.statIntensity.setAttribute('aria-label', `Intensity ${level} out of 5`);
+        }
+
+        this._els.statCalories.hidden = !hasCalories;
+        if (hasCalories) {
+          this._els.statCalories.textContent = `${this.calories} cal`;
+        }
+
+        this._els.statsRow.hidden = !hasRating && !hasIntensity && !hasCalories;
+
+        // CTA button
+        const isUnavailable = this.soldOut || this.disabled;
+        const targetHref = this.href.trim() || '#';
+        this._els.cta.setAttribute('href', isUnavailable ? '#' : targetHref);
+        this._els.cta.textContent = this.soldOut ? 'Sold Out' : this.ctaText;
+        if (isUnavailable) {
+          this._els.cta.setAttribute('aria-disabled', 'true');
+          this._els.cta.setAttribute('tabindex', '-1');
+        } else {
+          this._els.cta.removeAttribute('aria-disabled');
+          this._els.cta.removeAttribute('tabindex');
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+    window.CoffeeCard = CoffeeCard;
+  </script>
 </body>
 
