+      }
+
+      set featured(value) {
+        this._reflectBooleanAttribute('featured', value);
+      }
+
+      get seasonal() {
+        return this.hasAttribute('seasonal');
+      }
+
+      set seasonal(value) {
+        this._reflectBooleanAttribute('seasonal', value);
+      }
+
+      get iced() {
+        return this.hasAttribute('iced');
+      }
+
+      set iced(value) {
+        this._reflectBooleanAttribute('iced', value);
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+
+      set soldOut(value) {
+        this._reflectBooleanAttribute('sold-out', value);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(value) {
+        this._reflectBooleanAttribute('disabled', value);
+      }
+
+      /* =====================================================================
+       * Reflection Helpers & Internal Rendering
+       * ===================================================================== */
+
+      _upgradeProperty(prop) {
+        if (Object.prototype.hasOwnProperty.call(this, prop)) {
+          const value = this[prop];
+          delete this[prop];
+          this[prop] = value;
+        }
+      }
+
+      _reflectStringAttribute(attrName, value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute(attrName);
+        } else {
+          const strValue = String(value);
+          if (this.getAttribute(attrName) !== strValue) {
+            this.setAttribute(attrName, strValue);
+          }
+        }
+      }
+
+      _readNumericAttribute(attrName, fallback = 0, options = {}) {
+        const raw = this.getAttribute(attrName);
+        if (raw === null || raw.trim() === '') {
+          return fallback;
+        }
+        const parsed = options.integer ? parseInt(raw, 10) : Number(raw);
+        if (!Number.isFinite(parsed)) {
+          return fallback;
+        }
+        let result = parsed;
+        if (typeof options.min === 'number') {
+          result = Math.max(options.min, result);
+        }
+        if (typeof options.max === 'number') {
+          result = Math.min(options.max, result);
+        }
+        return result;
+      }
+
+      _reflectNumericAttribute(attrName, value, options = {}) {
+        if (value === null || value === undefined || value === '') {
+          this.removeAttribute(attrName);
+          return;
+        }
+        const parsed = options.integer ? parseInt(value, 10) : Number(value);
+        if (!Number.isFinite(parsed)) {
+          this.removeAttribute(attrName);
+          return;
+        }
+        let normalized = parsed;
+        if (typeof options.min === 'number') {
+          normalized = Math.max(options.min, normalized);
+        }
+        if (typeof options.max === 'number') {
+          normalized = Math.min(options.max, normalized);
+        }
+        const strValue = String(normalized);
+        if (this.getAttribute(attrName) !== strValue) {
+          this.setAttribute(attrName, strValue);
+        }
+      }
+
+      _reflectBooleanAttribute(attrName, value) {
+        const isTruthy = Boolean(value);
+        if (isTruthy) {
+          if (!this.hasAttribute(attrName)) {
+            this.setAttribute(attrName, '');
+          }
+        } else if (this.hasAttribute(attrName)) {
+          this.removeAttribute(attrName);
+        }
+      }
+
+      _handleCtaClick(event) {
