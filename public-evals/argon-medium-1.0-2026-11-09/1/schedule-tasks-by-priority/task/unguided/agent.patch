+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      const PRIORITY_LABELS = {
+        'user-blocking': 'Urgent (user-blocking)',
+        'user-visible': 'Standard (user-visible)',
+        'background': 'Background (background)'
+      };
+
+      const BADGE_CLASSES = {
+        'user-blocking': 'ops-badge-urgent',
+        'user-visible': 'ops-badge-standard',
+        'background': 'ops-badge-background'
+      };
+
+      const hasNativeScheduler =
+        typeof globalThis.scheduler === 'object' &&
+        typeof globalThis.scheduler.postTask === 'function';
+      const hasNativeYield =
+        typeof globalThis.scheduler === 'object' &&
+        typeof globalThis.scheduler.yield === 'function';
+
+      const statusBadgeEl = document.getElementById('scheduler-api-status');
+      if (statusBadgeEl) {
+        statusBadgeEl.textContent = hasNativeScheduler
+          ? 'API: scheduler.postTask' + (hasNativeYield ? ' + scheduler.yield' : '')
+          : 'API: Priority Queue Fallback';
+      }
+
+      // Fallback priority queue if scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackFlushing = false;
+
+      function flushFallbackQueue() {
+        if (fallbackFlushing || fallbackQueue.length === 0) return;
+        fallbackFlushing = true;
+        setTimeout(async () => {
+          while (fallbackQueue.length > 0) {
+            fallbackQueue.sort((a, b) => {
+              const weightDiff = PRIORITY_WEIGHTS[a.priority] - PRIORITY_WEIGHTS[b.priority];
+              return weightDiff !== 0 ? weightDiff : a.seq - b.seq;
+            });
+            const next = fallbackQueue.shift();
+            try {
+              const res = await next.callback();
+              next.resolve(res);
+            } catch (err) {
+              next.reject(err);
+            }
+          }
+          fallbackFlushing = false;
+        }, 0);
+      }
+
+      let fallbackSeq = 0;
+      function schedulePrioritizedTask(callback, options = {}) {
+        const priority = options.priority || 'user-visible';
+        if (hasNativeScheduler) {
+          let signal = options.signal;
+          if (!signal && typeof globalThis.TaskController === 'function') {
+            const controller = new globalThis.TaskController({ priority });
+            signal = controller.signal;
+          }
+          return globalThis.scheduler.postTask(callback, {
+            priority,
+            signal,
+            delay: options.delay || 0
+          });
+        }
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            seq: ++fallbackSeq,
+            resolve,
+            reject
+          });
+          flushFallbackQueue();
+        });
+      }
+
+      function yieldToMain(priority) {
+        if (hasNativeYield) {
+          return globalThis.scheduler.yield();
+        }
+        if (hasNativeScheduler) {
+          return globalThis.scheduler.postTask(() => {}, { priority: priority || 'user-visible' });
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      // UI Elements
+      const queueListEl = document.getElementById('ops-queue-list');
+      const logListEl = document.getElementById('ops-log-list');
+      const statQueuedEl = document.getElementById('stat-queued-count');
+      const statActiveEl = document.getElementById('stat-active-task');
+      const statCompletedEl = document.getElementById('stat-completed-count');
+      const statExecOrderEl = document.getElementById('stat-execution-order');
+      const logCountEl = document.getElementById('ops-log-count');
+      const heartbeatEl = document.getElementById('ui-heartbeat-counter');
+      const pingBtnEl = document.getElementById('btn-ui-ping');
+      const pingCountEl = document.getElementById('ui-ping-count');
+
+      let taskIdCounter = 0;
+      let queuedCount = 0;
+      let completedCount = 0;
+      let logEventCount = 0;
+      let heartbeatTicks = 0;
+      let pingCount = 0;
+      const executionOrder = [];
+
+      // Keep a live heartbeat ticking to verify main-thread responsiveness
+      setInterval(() => {
+        heartbeatTicks += 1;
+        if (heartbeatEl) {
+          heartbeatEl.textContent = String(heartbeatTicks);
+        }
+      }, 100);
+
+      if (pingBtnEl) {
+        pingBtnEl.addEventListener('click', () => {
+          pingCount += 1;
+          if (pingCountEl) pingCountEl.textContent = String(pingCount);
+          appendLog('UI interaction handled immediately on main thread (Click #' + pingCount + ')');
+        });
+      }
+
+      function updateStats(activeLabel) {
+        if (statQueuedEl) statQueuedEl.textContent = String(queuedCount);
+        if (statCompletedEl) statCompletedEl.textContent = String(completedCount);
+        if (statActiveEl && activeLabel !== undefined) {
+          statActiveEl.textContent = activeLabel;
+        }
+        if (statExecOrderEl) {
+          statExecOrderEl.textContent =
+            executionOrder.length > 0 ? executionOrder.slice(-5).join(' → ') : 'None';
+        }
+      }
+
+      function appendLog(message, priority) {
+        const emptyEl = document.getElementById('ops-log-empty');
+        if (emptyEl) emptyEl.remove();
+
+        logEventCount += 1;
+        if (logCountEl) logCountEl.textContent = logEventCount + (logEventCount === 1 ? ' event' : ' events');
+
+        const li = document.createElement('li');
+        li.className = 'ops-log-entry';
+        if (priority) {
+          li.dataset.priority = priority;
+        }
+        const timestamp = new Date().toISOString().slice(11, 23);
+        li.textContent = '[' + timestamp + '] ' + message;
+        logListEl.prepend(li);
+      }
+
+      function createTaskElement(task) {
+        const emptyEl = document.getElementById('ops-queue-empty');
+        if (emptyEl) emptyEl.remove();
+
+        const li = document.createElement('li');
+        li.className = 'ops-task-item';
+        li.id = 'ops-task-' + task.id;
+        li.dataset.priority = task.priority;
+        li.dataset.status = 'queued';
+
+        const badgeClass = BADGE_CLASSES[task.priority] || 'ops-badge-standard';
+        const priorityLabel = PRIORITY_LABELS[task.priority] || task.priority;
+
+        li.innerHTML =
+          '<div class="ops-task-top">' +
+            '<span class="ops-task-title">#' + task.id + ' ' + task.name + '</span>' +
+            '<span class="ops-badge ' + badgeClass + '">' + priorityLabel + '</span>' +
+          '</div>' +
+          '<div class="ops-progress-track">' +
+            '<div class="ops-progress-bar" id="ops-progress-' + task.id + '"></div>' +
+          '</div>' +
+          '<div class="ops-task-meta">' +
+            '<span id="ops-status-' + task.id + '">Status: Queued</span>' +
+            '<span id="ops-chunks-' + task.id + '">0 / ' + task.chunks + ' chunks</span>' +
+          '</div>';
+
+        queueListEl.prepend(li);
+        return li;
+      }
+
+      // Simulate a chunk of CPU work without blocking the main thread for more than a few ms before yielding
+      function performChunkWork(durationMs) {
+        const start = performance.now();
+        let acc = 0;
+        while (performance.now() - start < durationMs) {
+          acc += Math.sqrt(start + acc);
+        }
+        return acc;
+      }
+
+      function enqueueOperation({ name, shortCode, priority, chunks = 4, chunkMs = 6 }) {
+        const task = {
+          id: ++taskIdCounter,
+          name,
+          shortCode: shortCode || name,
+          priority,
+          chunks,
+          chunkMs
+        };
+
+        queuedCount += 1;
+        updateStats();
+
+        const taskEl = createTaskElement(task);
+        const progressEl = document.getElementById('ops-progress-' + task.id);
+        const statusEl = document.getElementById('ops-status-' + task.id);
+        const chunksEl = document.getElementById('ops-chunks-' + task.id);
+
+        appendLog('Queued #' + task.id + ' "' + task.name + '" [' + task.priority + ']', task.priority);
+
+        return schedulePrioritizedTask(async () => {
+          const startedAt = performance.now();
+          queuedCount = Math.max(0, queuedCount - 1);
+          executionOrder.push('#' + task.id + ' (' + task.shortCode + ')');
+          taskEl.dataset.status = 'running';
+          if (statusEl) statusEl.textContent = 'Status: Running';
+          updateStats('#' + task.id + ' ' + task.shortCode);
+
+          appendLog('Started #' + task.id + ' "' + task.name + '" [' + task.priority + ']', task.priority);
+
+          for (let i = 1; i <= task.chunks; i++) {
+            performChunkWork(task.chunkMs);
+            const pct = Math.round((i / task.chunks) * 100);
+            if (progressEl) progressEl.style.width = pct + '%';
+            if (chunksEl) chunksEl.textContent = i + ' / ' + task.chunks + ' chunks';
+
+            if (i < task.chunks) {
+              if (statusEl) statusEl.textContent = 'Status: Yielding to main thread...';
+              await yieldToMain(task.priority);
+              if (statusEl) statusEl.textContent = 'Status: Running';
+            }
+          }
+
+          const elapsed = Math.round(performance.now() - startedAt);
+          taskEl.dataset.status = 'completed';
+          if (statusEl) statusEl.textContent = 'Status: Completed (' + elapsed + 'ms)';
+          completedCount += 1;
+          updateStats(queuedCount === 0 ? 'Idle' : undefined);
+
+          appendLog(
+            'Completed #' + task.id + ' "' + task.name + '" [' + task.priority + '] in ' + elapsed + 'ms',
+            task.priority
+          );
+          return task.id;
+        }, { priority: task.priority });
+      }
+
+      // Wire up buttons
+      const btnUrgent = document.getElementById('btn-urgent-checkout');
+      const btnMenu = document.getElementById('btn-menu-update');
+      const btnTelemetry = document.getElementById('btn-telemetry-log');
+      const btnBatch = document.getElementById('btn-batch-mixed');
+      const btnClear = document.getElementById('btn-clear-queue');
+
+      if (btnUrgent) {
+        btnUrgent.addEventListener('click', () => {
+          enqueueOperation({
+            name: 'Urgent Checkout Task (Order Payment & Barista Ticket)',
+            shortCode: 'Checkout',
+            priority: 'user-blocking',
+            chunks: 3,
+            chunkMs: 5
+          });
+        });
+      }
+
+      if (btnMenu) {
+        btnMenu.addEventListener('click', () => {
+          enqueueOperation({
+            name: 'Standard Menu Update (Seasonal Drink Pricing & Stock)',
+            shortCode: 'Menu',
+            priority: 'user-visible',
+            chunks: 4,
+            chunkMs: 6
+          });
+        });
+      }
+
+      if (btnTelemetry) {
+        btnTelemetry.addEventListener('click', () => {
+          enqueueOperation({
+            name: 'Background Telemetry Logging (Roaster & POS Analytics)',
+            shortCode: 'Telemetry',
+            priority: 'background',
+            chunks: 5,
+            chunkMs: 6
+          });
+        });
+      }
+
+      if (btnBatch) {
+        btnBatch.addEventListener('click', () => {
+          appendLog('--- Queuing mixed batch (submitted: Background → Standard → Urgent) ---');
+          // Submit in reverse priority order to demonstrate that scheduler.postTask
+          // executes user-blocking first, then user-visible, then background.
+          enqueueOperation({
+            name: 'Background Telemetry Logging (Batch Analytics Sync)',
+            shortCode: 'Telemetry',
+            priority: 'background',
+            chunks: 5,
+            chunkMs: 5
+          });
+          enqueueOperation({
+            name: 'Standard Menu Update (Batch Inventory Refresh)',
+            shortCode: 'Menu',
+            priority: 'user-visible',
+            chunks: 4,
+            chunkMs: 5
+          });
+          enqueueOperation({
+            name: 'Urgent Checkout Task (Batch Express Espresso Order)',
+            shortCode: 'Checkout',
+            priority: 'user-blocking',
+            chunks: 3,
+            chunkMs: 5
+          });
+        });
+      }
+
+      if (btnClear) {
+        btnClear.addEventListener('click', () => {
+          queuedCount = 0;
+          completedCount = 0;
+          logEventCount = 0;
+          executionOrder.length = 0;
+          if (queueListEl) {
+            queueListEl.innerHTML =
+              '<li class="ops-empty" id="ops-queue-empty">No operations queued yet. Use the buttons above to schedule tasks.</li>';
+          }
+          if (logListEl) {
+            logListEl.innerHTML =
+              '<li class="ops-empty" id="ops-log-empty">Task events will appear here in execution order.</li>';
+          }
+          if (logCountEl) {
+            logCountEl.textContent = '0 events';
+          }
+          updateStats('Idle');
+        });
+      }
+    })();
+  </script>
