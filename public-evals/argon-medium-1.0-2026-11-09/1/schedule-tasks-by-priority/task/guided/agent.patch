+  <script>
+    (function () {
+      const queuedCountEl = document.getElementById('ops-queued-count');
+      const completedCountEl = document.getElementById('ops-completed-count');
+      const yieldCountEl = document.getElementById('ops-yield-count');
+      const logContainerEl = document.getElementById('ops-queue-log');
+      const emptyLogEl = document.getElementById('ops-log-empty');
+
+      let queuedCount = 0;
+      let completedCount = 0;
+      let totalYields = 0;
+      let taskSequence = 0;
+
+      function updateMetrics() {
+        queuedCountEl.textContent = String(queuedCount);
+        completedCountEl.textContent = String(completedCount);
+        yieldCountEl.textContent = String(totalYields);
+      }
+
+      function appendLogEntry(taskId, label, priority, statusText) {
+        if (emptyLogEl && emptyLogEl.parentNode === logContainerEl) {
+          logContainerEl.removeChild(emptyLogEl);
+        }
+
+        const item = document.createElement('div');
+        item.className = 'ops-log-item';
+        item.id = `ops-task-${taskId}`;
+
+        const badge = document.createElement('span');
+        badge.className = `priority-badge priority-${priority}`;
+        badge.textContent = priority;
+
+        const details = document.createElement('span');
+        details.style.flex = '1';
+        details.textContent = `#${taskId} ${label}`;
+
+        const status = document.createElement('span');
+        status.className = 'ops-task-status';
+        status.textContent = statusText;
+
+        item.append(badge, details, status);
+        logContainerEl.appendChild(item);
+        logContainerEl.scrollTop = logContainerEl.scrollHeight;
+        return status;
+      }
+
+      // Break up long synchronous work using a 50ms deadline and scheduler.yield() with setTimeout fallback
+      async function processLargeArrayWithFallback(items) {
+        let deadline = performance.now() + 50;
+
+        for (const item of items) {
+          processItem(item);
+
+          if (performance.now() >= deadline) {
+            if ('scheduler' in window && 'yield' in window.scheduler) {
+              await scheduler.yield();
+            } else {
+              await new Promise(resolve => setTimeout(resolve, 0));
+            }
+            totalYields++;
+            updateMetrics();
+            deadline = performance.now() + 50;
+          }
+        }
+      }
+
+      function createWorkloadItems(itemCount) {
+        const items = new Array(itemCount);
+        for (let i = 0; i < itemCount; i++) {
+          items[i] = i + 1;
+        }
+        return items;
+      }
+
+      function processItem(item) {
+        // Simulate nontrivial CPU work per operation step
+        let acc = item;
+        for (let i = 0; i < 600; i++) {
+          acc = (acc * 31 + i) % 1000003;
+        }
+        return acc;
+      }
+
+      async function executeOperation(label, priority, itemCount) {
+        const taskId = ++taskSequence;
+        const startTime = performance.now();
+        const statusEl = appendLogEntry(taskId, label, priority, 'Running...');
+
+        const items = createWorkloadItems(itemCount);
+        await processLargeArrayWithFallback(items);
+
+        const elapsedMs = Math.max(1, Math.round(performance.now() - startTime));
+        queuedCount = Math.max(0, queuedCount - 1);
+        completedCount++;
+        updateMetrics();
+        statusEl.textContent = `Completed (${elapsedMs}ms)`;
+      }
+
+      function scheduleUrgentCheckoutTask() {
+        queuedCount++;
+        updateMetrics();
+        scheduler.postTask(() => {
+          return executeOperation('Urgent Checkout Validation & Payment Capture', 'user-blocking', 4500);
+        }, { priority: 'user-blocking' });
+      }
+
+      function scheduleStandardMenuUpdate() {
+        queuedCount++;
+        updateMetrics();
+        scheduler.postTask(() => {
+          return executeOperation('Standard Seasonal Menu & Inventory Sync', 'user-visible', 6000);
+        }, { priority: 'user-visible' });
+      }
+
+      function scheduleBackgroundTelemetry() {
+        queuedCount++;
+        updateMetrics();
+        scheduler.postTask(() => {
+          return executeOperation('Background Telemetry & Barista Metrics Logging', 'background', 8000);
+        }, { priority: 'background' });
+      }
+
+      function scheduleMixedTaskBatch() {
+        // Queue in reverse urgency order (background -> user-visible -> user-blocking)
+        // to demonstrate that scheduler.postTask runs higher-priority tasks first.
+        scheduleBackgroundTelemetry();
+        scheduleStandardMenuUpdate();
+        scheduleUrgentCheckoutTask();
+        scheduleBackgroundTelemetry();
+        scheduleStandardMenuUpdate();
+        scheduleUrgentCheckoutTask();
+      }
+
+      function runScheduledTasks() {
+        const urgentBtn = document.getElementById('btn-urgent-checkout');
+        if (urgentBtn && !urgentBtn.dataset.bound) {
+          urgentBtn.dataset.bound = 'true';
+          urgentBtn.addEventListener('click', scheduleUrgentCheckoutTask);
+          document.getElementById('btn-menu-update').addEventListener('click', scheduleStandardMenuUpdate);
+          document.getElementById('btn-telemetry-log').addEventListener('click', scheduleBackgroundTelemetry);
+          document.getElementById('btn-batch-tasks').addEventListener('click', scheduleMixedTaskBatch);
+
+          document.getElementById('btn-clear-log').addEventListener('click', () => {
+            logContainerEl.innerHTML = '';
+            logContainerEl.appendChild(emptyLogEl);
+          });
+        }
+      }
+
+      // Feature detect the Prioritized Task Scheduling API and conditionally load the polyfill
+      if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => {
+          runScheduledTasks();
+        };
+        document.head.appendChild(script);
+
+        // Provide an immediate priority-ordered fallback in case the CDN is unreachable
+        window.scheduler = window.scheduler || {};
+        const fallbackQueue = [];
+        let fallbackFlushScheduled = false;
+        const priorityWeights = { 'user-blocking': 0, 'user-visible': 1, 'background': 2 };
+
+        window.scheduler.postTask = function (callback, options) {
+          const priority = (options && options.priority) || 'user-visible';
+          return new Promise((resolve, reject) => {
+            fallbackQueue.push({
+              callback,
+              weight: priorityWeights[priority] ?? 1,
+              resolve,
+              reject
+            });
+            fallbackQueue.sort((a, b) => a.weight - b.weight);
+            if (!fallbackFlushScheduled) {
+              fallbackFlushScheduled = true;
+              setTimeout(() => {
+                fallbackFlushScheduled = false;
+                while (fallbackQueue.length > 0) {
+                  const next = fallbackQueue.shift();
+                  Promise.resolve().then(next.callback).then(next.resolve, next.reject);
+                }
+              }, 0);
+            }
+          });
+        };
+      }
+
+      runScheduledTasks();
+    })();
+  </script>
