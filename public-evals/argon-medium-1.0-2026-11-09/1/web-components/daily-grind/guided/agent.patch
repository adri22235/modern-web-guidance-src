+
+    <div class="empty-state" id="empty-state" hidden>
+      <p>No drinks match the selected filter. Try selecting "All Drinks" to see the full menu.</p>
+    </div>
+
+    <aside class="order-tray" id="order-tray" part="order-tray" aria-label="Current order summary" hidden>
+      <div class="order-summary-text">
+        <output class="order-summary-title" id="order-total-output" aria-live="polite">Order Bag: 0 items ($0.00)</output>
+        <span class="order-items-list" id="order-items-list"></span>
+      </div>
+      <div class="order-tray-actions">
+        <button type="button" class="clear-btn" id="clear-order-btn">Clear Bag</button>
+        <a href="/order-online" class="checkout-link" part="checkout-link">Proceed to Order</a>
+      </div>
+    </aside>
+  </section>
+`;
+
+export class CoffeeCatalog extends HTMLElement {
+  static observedAttributes = ['heading', 'filter'];
+
+  #internals = null;
+  #activeFilter = 'all';
+  #activeSort = 'featured';
+  #initialOrder = [];
+  #orderItems = new Map();
+
+  constructor() {
+    super();
+    if ('attachInternals' in this) {
+      this.#internals = this.attachInternals();
+    }
+
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(template.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+
+    const slot = this.shadowRoot.querySelector('slot');
+    slot?.addEventListener('slotchange', () => {
+      const cards = this.#getCards();
+      for (const card of cards) {
+        if (!this.#initialOrder.includes(card)) {
+          this.#initialOrder.push(card);
+        }
+      }
+      this.#applyFilterAndSort();
+    });
+
+    this.shadowRoot.querySelector('.filter-group')?.addEventListener('click', (e) => {
+      const btn = e.target.closest('button[data-filter]');
+      if (!btn) return;
+      this.filter = btn.getAttribute('data-filter') || 'all';
+    });
+
+    this.shadowRoot.querySelector('#sort-select')?.addEventListener('change', (e) => {
+      this.#activeSort = e.target.value;
+      this.#applySort();
+      this.#applyFilterAndSort();
+    });
+
+    this.shadowRoot.querySelector('#clear-order-btn')?.addEventListener('click', () => {
+      this.clearOrder();
+    });
+
+    this.addEventListener('coffee-favorite', () => {
+      this.#applyFilterAndSort();
+    });
+
+    this.addEventListener('coffee-order-add', (e) => {
+      const detail = e.detail;
+      if (!detail?.name) return;
+      this.addOrderItem({
+        name: detail.name,
+        price: Number(detail.price) || 4.5,
+      });
+    });
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('heading')) {
+      this.#updateHeading(this.getAttribute('heading'));
+    }
+    if (this.hasAttribute('filter')) {
+      this.#activeFilter = this.getAttribute('filter') || 'all';
+    }
+    this.#applyFilterAndSort();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'heading') {
+      this.#updateHeading(newVal);
+    } else if (name === 'filter') {
+      this.#activeFilter = newVal || 'all';
+      this.#applyFilterAndSort();
+    }
+  }
+
+  get filter() {
+    return this.#activeFilter;
+  }
+
+  set filter(val) {
+    const next = val || 'all';
+    this.#activeFilter = next;
+    this.setAttribute('filter', next);
+    this.#applyFilterAndSort();
+  }
+
+  addOrderItem({ name, price, note = '' }) {
+    const key = note ? `${name} (${note})` : name;
+    const existing = this.#orderItems.get(key) ?? { name: key, price, quantity: 0 };
+    existing.quantity += 1;
+    this.#orderItems.set(key, existing);
+    this.#renderOrderTray();
+  }
+
+  clearOrder() {
+    this.#orderItems.clear();
+    for (const card of this.#getCards()) {
+      card.resetOrderCount?.();
+    }
+    this.#renderOrderTray();
+  }
+
+  #updateHeading(text) {
+    const headingEl = this.shadowRoot.querySelector('#catalog-heading');
+    if (headingEl && text) {
+      headingEl.textContent = text;
+    }
+  }
+
+  #getCards() {
+    const slot = this.shadowRoot.querySelector('slot');
+    if (!slot) return [];
+    return slot
+      .assignedElements({ flatten: true })
+      .filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+  }
+
+  #applySort() {
+    const cards = this.#getCards();
+    if (cards.length <= 1) return;
+
+    const sorted = [...cards].sort((a, b) => {
+      if (this.#activeSort === 'price-asc') {
+        return a.price - b.price;
+      }
+      if (this.#activeSort === 'price-desc') {
+        return b.price - a.price;
+      }
+      return this.#initialOrder.indexOf(a) - this.#initialOrder.indexOf(b);
+    });
+
+    for (const card of sorted) {
+      if ('moveBefore' in this && card.parentNode === this) {
+        this.moveBefore(card, null);
+      } else if (card.parentNode === this) {
+        this.append(card);
+      }
+    }
+  }
+
+  #applyFilterAndSort() {
+    const cards = this.#getCards();
+    let visibleCount = 0;
+    let favoriteCount = 0;
+
+    for (const btn of this.shadowRoot.querySelectorAll('.filter-btn')) {
+      const isMatch = btn.getAttribute('data-filter') === this.#activeFilter;
+      btn.setAttribute('aria-pressed', String(isMatch));
+    }
+
+    for (const card of cards) {
+      if (card.favorited) {
+        favoriteCount += 1;
+      }
+      const category = (card.getAttribute('category') || '').toLowerCase();
+      const isSeasonal = card.hasAttribute('seasonal') || category === 'seasonal';
+
+      let matches = true;
+      if (this.#activeFilter === 'seasonal') {
+        matches = isSeasonal;
+      } else if (this.#activeFilter === 'espresso') {
+        matches = category === 'espresso';
+      } else if (this.#activeFilter === 'cold-brew') {
+        matches = category === 'cold-brew';
+      } else if (this.#activeFilter === 'favorites') {
+        matches = card.favorited;
+      }
+
+      card.hidden = !matches;
+      if (matches) {
+        visibleCount += 1;
+      }
+    }
+
+    const filterStatus = this.shadowRoot.querySelector('#filter-status');
+    const favStatus = this.shadowRoot.querySelector('#favorite-status');
+    const emptyState = this.shadowRoot.querySelector('#empty-state');
+
+    if (filterStatus) {
+      filterStatus.textContent = `Showing ${visibleCount} of ${cards.length} drinks`;
+    }
+    if (favStatus) {
+      favStatus.textContent =
+        favoriteCount === 1 ? '1 favorite saved' : `${favoriteCount} favorites saved`;
+    }
+    if (emptyState) {
+      emptyState.hidden = visibleCount > 0 || cards.length === 0;
+    }
+  }
+
+  #renderOrderTray() {
+    const tray = this.shadowRoot.querySelector('#order-tray');
+    const totalOutput = this.shadowRoot.querySelector('#order-total-output');
+    const itemsList = this.shadowRoot.querySelector('#order-items-list');
+
+    let totalQty = 0;
+    let totalCost = 0;
+    const summaries = [];
+
+    for (const item of this.#orderItems.values()) {
+      totalQty += item.quantity;
+      totalCost += item.price * item.quantity;
+      summaries.push(`${item.quantity}x ${item.name}`);
+    }
+
+    const hasItems = totalQty > 0;
+    if (tray) {
+      tray.hidden = !hasItems;
+    }
+    if (totalOutput) {
+      totalOutput.textContent = `Order Bag: ${totalQty} ${totalQty === 1 ? 'item' : 'items'} ($${totalCost.toFixed(2)})`;
+    }
+    if (itemsList) {
+      itemsList.textContent = summaries.join(' · ');
+    }
+
+    if (this.#internals?.states) {
+      if (hasItems) {
+        this.#internals.states.add('has-order');
+      } else {
+        this.#internals.states.delete('has-order');
+      }
+    }
+
+    this.dispatchEvent(
+      new CustomEvent('coffee-order-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          totalQuantity: totalQty,
+          totalPrice: totalCost,
+          items: Array.from(this.#orderItems.values()),
+        },
+      }),
+    );
+  }
+}
+
+if (!customElements.get('coffee-catalog')) {
+  customElements.define('coffee-catalog', CoffeeCatalog);
+}
