+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base, state;
+
+  @layer base {
+    :host {
+      display: block;
+      container-type: inline-size;
+      --_card-bg: var(--card-bg, #ffffff);
+      --_card-fg: var(--card-fg, var(--text, #3e2723));
+      --_card-primary: var(--card-primary, var(--primary, #4e342e));
+      --_card-accent: var(--card-accent, var(--accent, #ffab40));
+      --_card-muted: var(--card-muted, #6d4c41);
+      --_card-border: var(--card-border, rgba(78, 52, 46, 0.14));
+      --_card-radius: var(--card-radius, 10px);
+    }
+
+    :host([hidden]) {
+      display: none !important;
+    }
+
+    .card {
+      background: var(--_card-bg);
+      color: var(--_card-fg);
+      border: 2px solid var(--_card-border);
+      border-radius: var(--_card-radius);
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
+      overflow: clip;
+      display: grid;
+      grid-template-rows: auto auto 1fr auto;
+      height: 100%;
+      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+      text-align: left;
+    }
+
+    .card:has(a.card-link) {
+      position: relative;
+    }
+
+    .card a.card-link::after {
+      content: "";
+      position: absolute;
+      inset: 0;
+      border-radius: inherit;
+    }
+
+    .card:has(a.card-link) :is(a:not(.card-link), button, input, select) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .card a.card-link:focus-visible {
+      outline: none;
+    }
+
+    .card:has(a.card-link:focus-visible) {
+      outline: 3px solid var(--_card-accent);
+      outline-offset: 2px;
+    }
+
+    .card:has(a.card-link:hover) {
+      transform: translateY(-2px);
+      box-shadow: 0 8px 20px rgba(62, 39, 35, 0.15);
+    }
+
+    .card > img {
+      width: 100%;
+      aspect-ratio: 16 / 10;
+      object-fit: cover;
+      display: block;
+      background: #efebe9;
+    }
+
+    header {
+      padding: 1.15rem 1.25rem 0.5rem;
+      display: flex;
+      flex-wrap: wrap;
+      align-items: baseline;
+      justify-content: space-between;
+      gap: 0.5rem;
+    }
+
+    .meta-row {
+      width: 100%;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 0.5rem;
+      margin-bottom: 0.2rem;
+    }
+
+    .badge {
+      display: inline-flex;
+      align-items: center;
+      font-size: 0.75rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 0.04em;
+      padding: 0.15rem 0.55rem;
+      border-radius: 999px;
+      background: #efebe9;
+      color: var(--_card-primary);
+    }
