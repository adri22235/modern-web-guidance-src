diff --git a/components/brew-customizer.js b/components/brew-customizer.js
new file mode 100644
index 0000000..38279b4
--- /dev/null
+++ b/components/brew-customizer.js
@@ -0,0 +1,325 @@
+import './brew-selector.js';
+import './decaf-switch.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base, state;
+
+  @layer base {
+    :host {
+      display: block;
+      container-type: inline-size;
+      --_cust-bg: var(--customizer-bg, #ffffff);
+      --_cust-fg: var(--customizer-fg, var(--text, #3e2723));
+      --_cust-primary: var(--customizer-primary, var(--primary, #4e342e));
+      --_cust-accent: var(--customizer-accent, var(--accent, #ffab40));
+    }
+
+    .panel {
+      background: var(--_cust-bg);
+      color: var(--_cust-fg);
+      border-radius: 12px;
+      padding: 1.75rem;
+      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
+      border: 1px solid rgba(78, 52, 46, 0.12);
+    }
+
+    header {
+      margin-bottom: 1.25rem;
+    }
+
+    h2 {
+      margin: 0 0 0.35rem;
+      color: var(--_cust-primary);
+      font-size: 1.65rem;
+    }
+
+    header p {
+      margin: 0;
+      color: #5d4037;
+      font-size: 0.95rem;
+    }
+
+    form {
+      display: grid;
+      gap: 1.25rem;
+    }
+
+    .form-row {
+      display: grid;
+      gap: 1rem;
+    }
+
+    @container (min-width: 36rem) {
+      .form-row {
+        grid-template-columns: 1fr 1fr;
+        align-items: end;
+      }
+    }
+
+    .field {
+      display: flex;
+      flex-direction: column;
+      gap: 0.4rem;
+    }
+
+    label,
+    .group-label {
+      font-weight: 600;
+      font-size: 0.92rem;
+      color: var(--_cust-primary);
+    }
+
+    select,
+    button {
+      font: inherit;
+      color: inherit;
+    }
+
+    select {
+      padding: 0.6rem 0.8rem;
+      border-radius: 6px;
+      border: 1px solid rgba(78, 52, 46, 0.3);
+      background: #fafafa;
+    }
+
+    select:focus-visible,
+    button:focus-visible {
+      outline: 2px solid var(--_cust-accent);
+      outline-offset: 2px;
+    }
+
+    .footer-bar {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      padding-top: 0.75rem;
+      border-top: 1px solid rgba(78, 52, 46, 0.1);
+    }
+
+    .status-output {
+      font-size: 0.92rem;
+      font-weight: 600;
+      color: var(--_cust-primary);
+    }
+
+    .btn-group {
+      display: flex;
+      align-items: center;
+      gap: 0.65rem;
+    }
+
+    .reset-btn {
+      padding: 0.55rem 1rem;
+      border-radius: 6px;
+      border: 1px solid rgba(78, 52, 46, 0.3);
+      background: transparent;
+      color: var(--_cust-primary);
+      font-weight: 600;
+      cursor: pointer;
+    }
+
+    .reset-btn:hover {
+      background: #efebe9;
+    }
+
+    .submit-btn {
+      padding: 0.6rem 1.25rem;
+      border-radius: 6px;
+      border: none;
+      background: var(--_cust-primary);
+      color: #ffffff;
+      font-weight: 600;
+      cursor: pointer;
+      transition: background-color 0.2s ease;
+    }
+
+    .submit-btn:hover {
+      background: #3e2723;
+    }
+  }
+
+  @layer state {
+    :host(:state(submitted)) .status-output {
+      color: #2e7d32;
+    }
+  }
+`);
+
+const BASE_DRINKS = {
+  'Maple Oat Latte': 5.25,
+  'Dark Roast Espresso': 3.75,
+  'Cold Brew': 4.5,
+  'Honey Cinnamon Cortado': 4.75,
+};
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <section class="panel" part="panel" aria-labelledby="customizer-title">
+    <header>
+      <h2 id="customizer-title" part="heading">Craft Your Custom Cup</h2>
+      <p>Personalize your base roast, milk preparation, and caffeine preference for pickup.</p>
+    </header>
+
+    <form id="customizer-form" part="form">
+      <div class="form-row">
+        <div class="field">
+          <label for="base-drink-select">Base Beverage</label>
+          <select id="base-drink-select" name="drink" required>
+            <option value="Maple Oat Latte">Maple Oat Latte ($5.25)</option>
+            <option value="Dark Roast Espresso">Dark Roast Espresso ($3.75)</option>
+            <option value="Cold Brew">Cold Brew ($4.50)</option>
+            <option value="Honey Cinnamon Cortado">Honey Cinnamon Cortado ($4.75)</option>
+          </select>
+        </div>
+
+        <div class="field">
+          <span class="group-label" id="caffeine-label">Caffeine Preference</span>
+          <decaf-switch
+            id="decaf-toggle"
+            aria-labelledby="caffeine-label"
+            exportparts="track: switch-track, thumb: switch-thumb"
+          >Swiss Water Decaf Roast</decaf-switch>
+        </div>
+      </div>
+
+      <div class="field">
+        <span class="group-label" id="milk-group-label">Milk &amp; Preparation Choice</span>
+        <brew-selector
+          id="milk-selector"
+          name="milk"
+          value="oat"
+          required
+          exportparts="choice: brew-choice"
+        ></brew-selector>
+      </div>
+
+      <div class="footer-bar">
+        <output class="status-output" id="customizer-output" aria-live="polite">
+          Estimated Cup Total: $5.75
+        </output>
+        <div class="btn-group">
+          <button type="reset" class="reset-btn" part="reset-button">Reset</button>
+          <button type="submit" class="submit-btn" part="submit-button">Add Custom Cup to Order</button>
+        </div>
+      </div>
+    </form>
+  </section>
+`;
+
+export class BrewCustomizer extends HTMLElement {
+  #internals = null;
+
+  constructor() {
+    super();
+    if ('attachInternals' in this) {
+      this.#internals = this.attachInternals();
+    }
+
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(template.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+
+    const form = this.shadowRoot.querySelector('#customizer-form');
+    const milkSelector = this.shadowRoot.querySelector('#milk-selector');
+    const milkLabel = this.shadowRoot.querySelector('#milk-group-label');
+    const decafToggle = this.shadowRoot.querySelector('#decaf-toggle');
+
+    if (milkSelector && milkLabel) {
+      milkSelector.setLabelElement?.(milkLabel);
+    }
+
+    form?.addEventListener('input', () => {
+      this.#setCustomState('submitted', false);
+      this.#updateEstimate();
+    });
+
+    form?.addEventListener('change', () => {
+      this.#setCustomState('submitted', false);
+      this.#updateEstimate();
+    });
+
+    form?.addEventListener('reset', () => {
+      if (decafToggle) {
+        decafToggle.checked = false;
+      }
+      queueMicrotask(() => {
+        this.#setCustomState('submitted', false);
+        this.#updateEstimate();
+      });
+    });
+
+    form?.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const { drink, milkLabelText, isDecaf, totalPrice } = this.#getCurrentSelection();
+      const notes = [milkLabelText, isDecaf ? 'Decaf' : 'Regular'].filter(Boolean).join(', ');
+
+      this.#setCustomState('submitted', true);
+      const output = this.shadowRoot.querySelector('#customizer-output');
+      if (output) {
+        output.textContent = `Added ${drink} (${notes}) — $${totalPrice.toFixed(2)} to your order!`;
+      }
+
+      this.dispatchEvent(
+        new CustomEvent('coffee-order-add', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: drink,
+            price: totalPrice,
+            note: notes,
+          },
+        }),
+      );
+    });
+  }
+
+  connectedCallback() {
+    this.#updateEstimate();
+  }
+
+  #getCurrentSelection() {
+    const drinkSelect = this.shadowRoot.querySelector('#base-drink-select');
+    const milkSelector = this.shadowRoot.querySelector('#milk-selector');
+    const decafToggle = this.shadowRoot.querySelector('#decaf-toggle');
+
+    const drink = drinkSelect?.value || 'Maple Oat Latte';
+    const basePrice = BASE_DRINKS[drink] ?? 4.5;
+    const selectedOpt = milkSelector?.selectedOption;
+    const upcharge = selectedOpt?.upcharge ?? 0;
+    const milkLabelText = selectedOpt?.label ?? 'Vermont Oat Milk';
+    const isDecaf = Boolean(decafToggle?.checked);
+
+    return {
+      drink,
+      milkLabelText,
+      isDecaf,
+      totalPrice: basePrice + upcharge,
+    };
+  }
+
+  #updateEstimate() {
+    const output = this.shadowRoot.querySelector('#customizer-output');
+    if (!output) return;
+    const { drink, milkLabelText, isDecaf, totalPrice } = this.#getCurrentSelection();
+    const prepText = isDecaf ? `${milkLabelText}, Decaf` : milkLabelText;
+    output.textContent = `${drink} (${prepText}) — Estimated Total: $${totalPrice.toFixed(2)}`;
+  }
+
+  #setCustomState(name, active) {
+    if (!this.#internals?.states) return;
+    if (active) {
+      this.#internals.states.add(name);
+    } else {
+      this.#internals.states.delete(name);
+    }
+  }
+}
+
+if (!customElements.get('brew-customizer')) {
+  customElements.define('brew-customizer', BrewCustomizer);
+}
diff --git a/components/brew-selector.js b/components/brew-selector.js
new file mode 100644
index 0000000..b18d06c
--- /dev/null
+++ b/components/brew-selector.js
@@ -0,0 +1,303 @@
+const supportsFACE =
+  'attachInternals' in HTMLElement.prototype &&
+  typeof ElementInternals !== 'undefined' &&
+  'setFormValue' in ElementInternals.prototype;
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base, state;
+
+  @layer base {
+    :host {
+      display: block;
+      container-type: inline-size;
+      --_selector-bg: var(--selector-bg, #ffffff);
+      --_selector-fg: var(--selector-fg, var(--text, #3e2723));
+      --_selector-primary: var(--selector-primary, var(--primary, #4e342e));
+      --_selector-accent: var(--selector-accent, var(--accent, #ffab40));
+    }
+
+    .choices {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
+      gap: 0.75rem;
+    }
+
+    .card {
+      display: flex;
+      align-items: flex-start;
+      gap: 0.6rem;
+      padding: 0.75rem 0.9rem;
+      border-radius: 8px;
+      background: var(--_selector-bg);
+      color: var(--_selector-fg);
+      border: 2px solid transparent;
+      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
+      cursor: pointer;
+      transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    .card:hover {
+      background: #fffdf9;
+    }
+
+    .card:has(> :checked) {
+      border-color: var(--_selector-accent);
+      background: #fff8e1;
+      box-shadow: 0 2px 8px rgba(255, 171, 64, 0.25);
+    }
+
+    .card:has(> :focus-visible) {
+      outline: 2px solid var(--_selector-primary);
+      outline-offset: 2px;
+    }
+
+    input[type="radio"] {
+      font: inherit;
+      color: inherit;
+      accent-color: var(--_selector-primary);
+      margin-top: 0.2rem;
+      flex-shrink: 0;
+    }
+
+    .option-details {
+      display: flex;
+      flex-direction: column;
+      gap: 0.1rem;
+    }
+
+    .option-title {
+      font-size: 0.92rem;
+      color: var(--_selector-primary);
+    }
+
+    .option-note {
+      font-size: 0.78rem;
+      color: #6d4c41;
+    }
+  }
+
+  @layer state {
+    :host(:disabled),
+    :host([disabled]) {
+      opacity: 0.55;
+      pointer-events: none;
+    }
+  }
+`);
+
+const DEFAULT_OPTIONS = [
+  { value: 'oat', label: 'Vermont Oat Milk', note: 'Creamy & plant-based (+$0.50)', upcharge: 0.5 },
+  { value: 'whole', label: 'Organic Whole Dairy', note: 'Rich microfoam (+$0.00)', upcharge: 0 },
+  { value: 'almond', label: 'Roasted Almond', note: 'Light nutty finish (+$0.50)', upcharge: 0.5 },
+  { value: 'black', label: 'Pure Black / None', note: 'Single-origin clarity (+$0.00)', upcharge: 0 },
+];
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <div class="choices" part="choices" role="radiogroup"></div>
+`;
+
+export class BrewSelector extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'options'];
+
+  #internals = null;
+  #value = '';
+  #defaultValue = '';
+  #fallbackInput = null;
+  #options = DEFAULT_OPTIONS;
+
+  constructor() {
+    super();
+    if ('attachInternals' in this) {
+      this.#internals = this.attachInternals();
+      if ('role' in this.#internals) {
+        this.#internals.role = 'group';
+      } else {
+        this.setAttribute('role', 'group');
+      }
+    } else {
+      this.setAttribute('role', 'group');
+    }
+
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open', delegatesFocus: true });
+      this.shadowRoot.append(template.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+
+    this.shadowRoot.querySelector('.choices')?.addEventListener('change', (e) => {
+      const target = e.target;
+      if (target instanceof HTMLInputElement && target.type === 'radio') {
+        this.value = target.value;
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+      }
+    });
+  }
+
+  connectedCallback() {
+    if (!this.#defaultValue && this.hasAttribute('value')) {
+      this.#defaultValue = this.getAttribute('value') ?? '';
+    }
+    if (!this.#value && this.#defaultValue) {
+      this.#value = this.#defaultValue;
+    }
+    this.#parseOptionsAttribute();
+    this.#renderChoices();
+    this.#syncFormValue();
+    this.#validate();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'options') {
+      this.#parseOptionsAttribute();
+      this.#renderChoices();
+    } else if (name === 'value' && newVal !== this.#value) {
+      this.value = newVal ?? '';
+    } else if (name === 'required') {
+      this.#validate();
+    }
+  }
+
+  get value() {
+    return this.#value;
+  }
+
+  set value(v) {
+    const next = String(v ?? '');
+    this.#value = next;
+    this.#syncRadioSelection();
+    this.#syncFormValue();
+    this.#validate();
+    if (this.#internals?.states) {
+      if (this.#value) {
+        this.#internals.states.add('selected');
+      } else {
+        this.#internals.states.delete('selected');
+      }
+    }
+  }
+
+  get selectedOption() {
+    return this.#options.find((opt) => opt.value === this.#value) ?? null;
+  }
+
+  setLabelElement(labelEl) {
+    const groupEl = this.shadowRoot?.querySelector('.choices');
+    if (!groupEl || !(labelEl instanceof HTMLElement)) return;
+    if ('ariaLabelledByElements' in groupEl) {
+      groupEl.ariaLabelledByElements = [labelEl];
+    } else {
+      groupEl.setAttribute('aria-label', labelEl.textContent?.trim() || 'Brew options');
+    }
+  }
+
+  formResetCallback() {
+    this.value = this.#defaultValue;
+  }
+
+  formDisabledCallback(disabled) {
+    // Disable internal controls so they leave the tab order and ignore clicks.
+    // Do NOT toggle `disabled` on `this` host, or a `<fieldset disabled>` toggle will
+    // leave the host permanently stuck with its own `disabled` attribute.
+    for (const input of this.shadowRoot.querySelectorAll('input[type="radio"]')) {
+      input.disabled = disabled;
+    }
+  }
+
+  formStateRestoreCallback(state) {
+    if (typeof state === 'string') {
+      this.value = state;
+    }
+  }
+
+  #parseOptionsAttribute() {
+    const raw = this.getAttribute('options');
+    if (!raw) {
+      this.#options = DEFAULT_OPTIONS;
+      return;
+    }
+    try {
+      const parsed = JSON.parse(raw);
+      if (Array.isArray(parsed) && parsed.length > 0) {
+        this.#options = parsed;
+      }
+    } catch {
+      this.#options = DEFAULT_OPTIONS;
+    }
+  }
+
+  #renderChoices() {
+    const container = this.shadowRoot.querySelector('.choices');
+    if (!container) return;
+    container.replaceChildren();
+
+    for (const opt of this.#options) {
+      const label = document.createElement('label');
+      label.className = 'card';
+      label.setAttribute('part', 'choice');
+
+      const radio = document.createElement('input');
+      radio.type = 'radio';
+      radio.name = 'brew-choice';
+      radio.value = opt.value;
+      radio.checked = opt.value === this.#value;
+
+      const details = document.createElement('span');
+      details.className = 'option-details';
+
+      const title = document.createElement('span');
+      title.className = 'option-title';
+      title.textContent = opt.label;
+
+      const note = document.createElement('span');
+      note.className = 'option-note';
+      note.textContent = opt.note ?? '';
+
+      details.append(title, note);
+      label.append(radio, details);
+      container.append(label);
+    }
+  }
+
+  #syncRadioSelection() {
+    for (const radio of this.shadowRoot.querySelectorAll('input[type="radio"]')) {
+      radio.checked = radio.value === this.#value;
+    }
+  }
+
+  #syncFormValue() {
+    if (supportsFACE && this.#internals) {
+      this.#internals.setFormValue(this.#value);
+    } else {
+      if (!this.#fallbackInput) {
+        this.#fallbackInput = document.createElement('input');
+        this.#fallbackInput.type = 'hidden';
+        this.#fallbackInput.name = this.getAttribute('name') || 'milk';
+        this.append(this.#fallbackInput);
+      }
+      this.#fallbackInput.value = this.#value;
+    }
+  }
+
+  #validate() {
+    if (!supportsFACE || !this.#internals) return;
+    if (this.hasAttribute('required') && !this.#value) {
+      const firstInput = this.shadowRoot.querySelector('input[type="radio"]');
+      this.#internals.setValidity(
+        { valueMissing: true },
+        'Please select a preparation option.',
+        firstInput ?? undefined,
+      );
+    } else {
+      this.#internals.setValidity({});
+    }
+  }
+}
+
+if (!customElements.get('brew-selector')) {
+  customElements.define('brew-selector', BrewSelector);
+}
diff --git a/components/coffee-card.js b/components/coffee-card.js
