+document.addEventListener('coffee-order-add', (e) => {
+  const catalog = document.querySelector('coffee-catalog');
+  if (!catalog) return;
+  // If the event originated outside <coffee-catalog> (e.g. from <brew-customizer>), forward it.
+  if (!catalog.contains(e.target)) {
+    const detail = e.detail;
+    if (detail?.name) {
+      catalog.addOrderItem({
+        name: detail.name,
+        price: Number(detail.price) || 4.5,
+        note: detail.note || '',
+      });
+    }
+  }
+});
+
+document.addEventListener('coffee-order-change', (e) => {
+  const navOrderBadge = document.getElementById('nav-order-count');
+  if (!navOrderBadge) return;
+  const qty = e.detail?.totalQuantity ?? 0;
+  navOrderBadge.textContent = qty > 0 ? `Order (${qty})` : 'Order Online';
+});
