+
+export class CoffeeCatalog extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'subtitle', 'active-category'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._activeFilter = 'all';
+    this._searchQuery = '';
+
+    this._headingEl = this.shadowRoot.getElementById('catalog-heading');
+    this._subtitleEl = this.shadowRoot.getElementById('catalog-subtitle');
+    this._filterBtns = Array.from(this.shadowRoot.querySelectorAll('.filter-btn'));
+    this._searchInput = this.shadowRoot.getElementById('coffee-search');
+    this._resultsCount = this.shadowRoot.getElementById('results-count');
+    this._emptyState = this.shadowRoot.getElementById('empty-state');
+    this._resetBtn = this.shadowRoot.getElementById('reset-btn');
+    this._slot = this.shadowRoot.querySelector('slot');
+
+    this._onFilterClick = this._onFilterClick.bind(this);
+    this._onSearchInput = this._onSearchInput.bind(this);
+    this._onReset = this._onReset.bind(this);
+    this._onSlotChange = this._onSlotChange.bind(this);
+    this._onFavoriteChanged = this._onFavoriteChanged.bind(this);
+  }
+
+  connectedCallback() {
+    this._filterBtns.forEach((btn) => btn.addEventListener('click', this._onFilterClick));
+    this._searchInput.addEventListener('input', this._onSearchInput);
+    this._resetBtn.addEventListener('click', this._onReset);
+    this._slot.addEventListener('slotchange', this._onSlotChange);
+    this.addEventListener('coffee-favorite', this._onFavoriteChanged);
+    this._syncHeader();
+    this._applyFilters();
+  }
+
+  disconnectedCallback() {
+    this._filterBtns.forEach((btn) => btn.removeEventListener('click', this._onFilterClick));
+    this._searchInput.removeEventListener('input', this._onSearchInput);
+    this._resetBtn.removeEventListener('click', this._onReset);
+    this._slot.removeEventListener('slotchange', this._onSlotChange);
+    this.removeEventListener('coffee-favorite', this._onFavoriteChanged);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal && this.isConnected) {
+      if (name === 'active-category' && newVal) {
+        this._setFilter(newVal);
+      } else {
+        this._syncHeader();
+      }
+    }
+  }
+
+  _syncHeader() {
+    if (this.hasAttribute('heading')) {
+      this._headingEl.textContent = this.getAttribute('heading');
+    }
+    if (this.hasAttribute('subtitle')) {
+      this._subtitleEl.textContent = this.getAttribute('subtitle');
+    }
+  }
+
+  _onSlotChange() {
+    const cards = this._getCards();
+    cards.forEach((card) => {
+      if (!card.hasAttribute('role')) {
+        card.setAttribute('role', 'listitem');
+      }
+    });
+    this._applyFilters();
+  }
+
+  _onFavoriteChanged() {
+    if (this._activeFilter === 'favorites') {
+      this._applyFilters();
+    }
+  }
+
+  _getCards() {
+    return this._slot
+      .assignedElements({ flatten: true })
+      .filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+  }
+
+  _onFilterClick(event) {
+    const filter = event.currentTarget.dataset.filter;
+    this._setFilter(filter);
+  }
+
+  _setFilter(filter) {
+    this._activeFilter = filter;
+    this._filterBtns.forEach((btn) => {
+      const isSelected = btn.dataset.filter === filter;
+      btn.setAttribute('aria-pressed', String(isSelected));
+    });
+    this._applyFilters();
+  }
+
+  _onSearchInput(event) {
+    this._searchQuery = event.target.value.trim().toLowerCase();
+    this._applyFilters();
+  }
+
+  _onReset() {
+    this._searchInput.value = '';
+    this._searchQuery = '';
+    this._setFilter('all');
+    this._searchInput.focus();
+  }
+
+  _applyFilters() {
+    const cards = this._getCards();
+    let visibleCount = 0;
+
+    cards.forEach((card) => {
+      const category = (card.getAttribute('category') || '').toLowerCase();
+      const name = (card.getAttribute('name') || '').toLowerCase();
+      const desc = (card.getAttribute('description') || card.textContent || '').toLowerCase();
+      const notes = (card.getAttribute('notes') || '').toLowerCase();
+      const isFavorited = card.hasAttribute('favorited');
+
+      const matchesCategory =
+        this._activeFilter === 'all' ||
+        (this._activeFilter === 'favorites' ? isFavorited : category === this._activeFilter);
+
+      const matchesSearch =
+        !this._searchQuery ||
+        name.includes(this._searchQuery) ||
+        desc.includes(this._searchQuery) ||
+        notes.includes(this._searchQuery);
+
+      const isVisible = matchesCategory && matchesSearch;
+      card.hidden = !isVisible;
+      if (isVisible) {
+        visibleCount++;
+      }
+    });
+
+    this._emptyState.hidden = visibleCount > 0 || cards.length === 0;
+    this._resultsCount.textContent = `Showing ${visibleCount} of ${cards.length} handcrafted drinks`;
+  }
+}
+
+if (!customElements.get('coffee-catalog')) {
+  customElements.define('coffee-catalog', CoffeeCatalog);
+}
