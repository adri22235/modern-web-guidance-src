+
+export class CoffeeDetailModal extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._backdrop = this.shadowRoot.getElementById('backdrop');
+    this._closeBtn = this.shadowRoot.getElementById('close-btn');
+    this._img = this.shadowRoot.getElementById('modal-img');
+    this._title = this.shadowRoot.getElementById('modal-title');
+    this._price = this.shadowRoot.getElementById('modal-price');
+    this._desc = this.shadowRoot.getElementById('modal-desc');
+    this._form = this.shadowRoot.getElementById('customize-form');
+    this._milkSelect = this.shadowRoot.getElementById('milk-select');
+    this._sizeBtns = Array.from(this.shadowRoot.querySelectorAll('.size-btn'));
+
+    this._currentItem = null;
+    this._selectedSize = 'Medium (12oz)';
+    this._sizeDelta = 0;
+    this._previousFocus = null;
+
+    this._onClose = this.close.bind(this);
+    this._onBackdropClick = this._onBackdropClick.bind(this);
+    this._onKeyDown = this._onKeyDown.bind(this);
+    this._onSizeClick = this._onSizeClick.bind(this);
+    this._onSubmit = this._onSubmit.bind(this);
+  }
+
+  connectedCallback() {
+    this._closeBtn.addEventListener('click', this._onClose);
+    this._backdrop.addEventListener('click', this._onBackdropClick);
+    this._sizeBtns.forEach((btn) => btn.addEventListener('click', this._onSizeClick));
+    this._form.addEventListener('submit', this._onSubmit);
+  }
+
+  disconnectedCallback() {
+    this._closeBtn.removeEventListener('click', this._onClose);
+    this._backdrop.removeEventListener('click', this._onBackdropClick);
+    this._sizeBtns.forEach((btn) => btn.removeEventListener('click', this._onSizeClick));
+    this._form.removeEventListener('submit', this._onSubmit);
+    document.removeEventListener('keydown', this._onKeyDown);
+  }
+
+  open(item) {
+    this._currentItem = item;
+    this._previousFocus = document.activeElement;
+    this._selectedSize = 'Medium (12oz)';
+    this._sizeDelta = 0;
+
+    this._sizeBtns.forEach((btn) => {
+      btn.setAttribute('aria-checked', String(btn.dataset.size === this._selectedSize));
+    });
+
+    this._img.src =
+      item.image ||
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80';
+    this._img.alt = item.name || 'Coffee detail preview';
+    this._title.textContent = item.name;
+    this._desc.textContent = item.description;
+    this._updatePriceDisplay();
+
+    this._backdrop.hidden = false;
+    document.addEventListener('keydown', this._onKeyDown);
+    this._closeBtn.focus();
+  }
+
+  close() {
+    this._backdrop.hidden = true;
+    document.removeEventListener('keydown', this._onKeyDown);
+    if (this._previousFocus && typeof this._previousFocus.focus === 'function') {
+      this._previousFocus.focus();
+    }
+  }
+
+  _updatePriceDisplay() {
+    if (!this._currentItem) return;
+    const base = this._currentItem.price || 4.5;
+    const finalPrice = Math.max(0, base + this._sizeDelta);
+    this._price.textContent = `$${finalPrice.toFixed(2)}`;
+  }
+
+  _onSizeClick(event) {
+    const btn = event.currentTarget;
+    this._selectedSize = btn.dataset.size;
+    this._sizeDelta = parseFloat(btn.dataset.delta || '0');
+    this._sizeBtns.forEach((b) => {
+      b.setAttribute('aria-checked', String(b === btn));
+    });
+    this._updatePriceDisplay();
+  }
+
+  _onBackdropClick(event) {
+    if (event.target === this._backdrop) {
+      this.close();
+    }
+  }
+
+  _onKeyDown(event) {
+    if (event.key === 'Escape') {
+      this.close();
+    }
+  }
+
+  _onSubmit(event) {
+    event.preventDefault();
+    if (!this._currentItem) return;
+    const base = this._currentItem.price || 4.5;
+    const customizedItem = {
+      ...this._currentItem,
+      size: this._selectedSize,
+      milk: this._milkSelect.value,
+      price: Math.max(0, base + this._sizeDelta)
+    };
+    this.dispatchEvent(
+      new CustomEvent('coffee-add', {
+        bubbles: true,
+        composed: true,
+        detail: customizedItem
+      })
+    );
+    this.close();
+  }
+}
