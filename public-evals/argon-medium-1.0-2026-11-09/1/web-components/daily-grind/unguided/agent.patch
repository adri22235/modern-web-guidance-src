+export class DgNavbar extends HTMLElement {
+  static get observedAttributes() {
+    return ['brand'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._items = [];
+    this._brandEl = this.shadowRoot.getElementById('brand-logo');
+    this._menuToggle = this.shadowRoot.getElementById('menu-toggle');
+    this._navLinks = this.shadowRoot.getElementById('nav-links');
+    this._cartBtn = this.shadowRoot.getElementById('cart-btn');
+    this._cartCount = this.shadowRoot.getElementById('cart-count');
+    this._cartPopover = this.shadowRoot.getElementById('cart-popover');
+    this._cartList = this.shadowRoot.getElementById('cart-list');
+    this._cartTotal = this.shadowRoot.getElementById('cart-total');
+    this._clearBtn = this.shadowRoot.getElementById('clear-btn');
+
+    this._onToggleMenu = this._onToggleMenu.bind(this);
+    this._onToggleCart = this._onToggleCart.bind(this);
+    this._onClearCart = this._onClearCart.bind(this);
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('brand')) {
+      this._brandEl.textContent = this.getAttribute('brand');
+    }
+    this._menuToggle.addEventListener('click', this._onToggleMenu);
+    this._cartBtn.addEventListener('click', this._onToggleCart);
+    this._clearBtn.addEventListener('click', this._onClearCart);
+  }
+
+  disconnectedCallback() {
+    this._menuToggle.removeEventListener('click', this._onToggleMenu);
+    this._cartBtn.removeEventListener('click', this._onToggleCart);
+    this._clearBtn.removeEventListener('click', this._onClearCart);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (name === 'brand' && oldVal !== newVal && newVal) {
+      this._brandEl.textContent = newVal;
+    }
+  }
+
+  addItem(item) {
+    this._items.push({
+      name: item.name || 'Coffee',
+      price: typeof item.price === 'number' && !isNaN(item.price) ? item.price : 4.5,
+      size: item.size || 'Medium (12oz)',
+      milk: item.milk || ''
+    });
+    this._renderCart();
+  }
+
+  _onToggleMenu() {
+    const isOpen = this._navLinks.dataset.open === 'true';
+    this._navLinks.dataset.open = String(!isOpen);
+    this._menuToggle.setAttribute('aria-expanded', String(!isOpen));
+  }
+
+  _onToggleCart() {
+    const isHidden = this._cartPopover.hidden;
+    this._cartPopover.hidden = !isHidden;
+    this._cartBtn.setAttribute('aria-expanded', String(isHidden));
+  }
+
+  _onClearCart() {
+    this._items = [];
+    this._renderCart();
+  }
+
+  _renderCart() {
+    this._cartCount.textContent = `(${this._items.length})`;
+
+    if (this._items.length === 0) {
+      this._cartList.innerHTML = `<p style="margin: 0; font-size: 0.85rem;">Your bag is currently empty.</p>`;
+      this._cartTotal.textContent = 'Total: $0.00';
+      return;
+    }
+
+    this._cartList.innerHTML = '';
+    let sum = 0;
