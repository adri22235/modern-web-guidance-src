+const BREW_METHODS = {
+  pourover: {
+    title: 'Pour-Over (V60 / Chemex)',
+    ratio: 16,
+    grind: 'Medium-Fine (sea salt texture)',
+    temp: '200°F – 205°F (93°C – 96°C)',
+    time: '3:00 – 3:30 mins',
+    tip: 'Bloom with twice the coffee weight in water for 35 seconds before pouring in slow concentric circles.'
+  },
+  frenchpress: {
+    title: 'French Press Immersion',
+    ratio: 15,
+    grind: 'Coarse (cracked peppercorn texture)',
+    temp: '200°F (93°C)',
+    time: '4:00 mins steep',
+    tip: 'Break the top crust at 4 minutes with a wooden spoon, skim the foam, then press gently.'
+  },
+  coldbrew: {
+    title: 'Artisanal Cold Brew Concentrate',
+    ratio: 8,
+    grind: 'Extra Coarse',
+    temp: 'Filtered cold water',
+    time: '18 hours steep',
+    tip: 'Dilute concentrate 1:1 with water or oat milk over ice for the signature Daily Grind smoothness.'
+  }
+};
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      margin-top: 48px;
+      --brew-primary: var(--primary, #4e342e);
+      --brew-secondary: var(--secondary, #d7ccc8);
+      --brew-accent: var(--accent, #ffab40);
+      --brew-text: var(--text, #3e2723);
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    }
+
+    section {
+      background: #ffffff;
+      border-radius: 10px;
+      padding: 28px;
+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
+    }
+
+    .header {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    h2 {
+      color: var(--brew-primary);
+      margin: 0 0 6px;
+      font-size: 1.75rem;
+    }
+
+    .subtitle {
+      color: #5d4037;
+      margin: 0;
+      font-size: 0.95rem;
+    }
+
+    .tablist {
+      display: flex;
+      justify-content: center;
+      gap: 10px;
+      flex-wrap: wrap;
+      margin-bottom: 24px;
+      border-bottom: 1px solid var(--brew-secondary);
+      padding-bottom: 14px;
+    }
+
+    .tab {
+      background: #f5f0ee;
+      color: var(--brew-text);
+      border: 2px solid transparent;
+      padding: 9px 18px;
+      border-radius: 6px;
+      font-weight: 600;
+      font-size: 0.9rem;
+      cursor: pointer;
+      font-family: inherit;
+      transition: background 0.2s, color 0.2s;
+    }
+
+    .tab[aria-selected="true"] {
+      background: var(--brew-primary);
+      color: #ffffff;
+    }
+
+    .tab:focus-visible,
+    input:focus-visible {
+      outline: 3px solid var(--brew-accent);
+      outline-offset: 2px;
+    }
+
+    .panel-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+      gap: 24px;
+      align-items: center;
+    }
+
+    .specs {
+      display: grid;
+      gap: 10px;
+    }
+
+    .spec-item {
+      background: #fafafa;
+      padding: 10px 14px;
+      border-left: 4px solid var(--brew-primary);
+      border-radius: 4px;
+      font-size: 0.9rem;
+    }
+
+    .calculator {
+      background: #f5f0ee;
+      padding: 20px;
+      border-radius: 8px;
+    }
+
+    .calculator h3 {
+      margin: 0 0 12px;
+      color: var(--brew-primary);
+      font-size: 1.15rem;
+    }
+
+    .slider-row {
+      display: flex;
+      flex-direction: column;
+      gap: 6px;
+      margin-bottom: 16px;
+    }
+
+    label {
+      font-weight: 600;
+      font-size: 0.9rem;
+    }
+
+    input[type="range"] {
+      width: 100%;
+      accent-color: var(--brew-primary);
+    }
+
+    .results {
+      display: flex;
+      justify-content: space-around;
+      background: #ffffff;
+      padding: 14px;
+      border-radius: 6px;
+      text-align: center;
+    }
+
+    .metric-val {
+      display: block;
+      font-size: 1.35rem;
+      font-weight: 700;
+      color: var(--brew-primary);
+    }
+
+    .metric-label {
+      font-size: 0.8rem;
+      color: #5d4037;
+    }
+  </style>
+
+  <section aria-labelledby="brew-heading">
+    <div class="header">
+      <h2 id="brew-heading">Interactive Home Brew Guide</h2>
+      <p class="subtitle">Dial in the ideal coffee-to-water ratio for our freshly roasted whole beans.</p>
+    </div>
+
+    <div class="tablist" role="tablist" aria-label="Brewing Methods">
+      <button id="tab-pourover" class="tab" role="tab" type="button" aria-selected="true" aria-controls="brew-panel" data-method="pourover" tabindex="0">Pour-Over</button>
+      <button id="tab-frenchpress" class="tab" role="tab" type="button" aria-selected="false" aria-controls="brew-panel" data-method="frenchpress" tabindex="-1">French Press</button>
+      <button id="tab-coldbrew" class="tab" role="tab" type="button" aria-selected="false" aria-controls="brew-panel" data-method="coldbrew" tabindex="-1">Cold Brew</button>
+    </div>
+
+    <div id="brew-panel" class="panel-grid" role="tabpanel" aria-labelledby="tab-pourover">
+      <div class="specs">
+        <div class="spec-item"><strong>Method:</strong> <span id="spec-title"></span></div>
+        <div class="spec-item"><strong>Grind Size:</strong> <span id="spec-grind"></span></div>
+        <div class="spec-item"><strong>Water Temp:</strong> <span id="spec-temp"></span></div>
+        <div class="spec-item"><strong>Brew Time:</strong> <span id="spec-time"></span></div>
+        <div class="spec-item"><strong>Barista Tip:</strong> <span id="spec-tip"></span></div>
+      </div>
+
+      <div class="calculator">
+        <h3>Brew Ratio Calculator</h3>
+        <div class="slider-row">
+          <label for="cups-range">Number of Cups (8oz each): <span id="cups-val">2</span></label>
+          <input id="cups-range" type="range" min="1" max="8" value="2" step="1" />
+        </div>
+        <div class="results" aria-live="polite">
+          <div>
+            <span id="coffee-grams" class="metric-val">30g</span>
+            <span class="metric-label">Whole Beans</span>
+          </div>
+          <div>
+            <span id="water-ml" class="metric-val">480ml</span>
+            <span class="metric-label">Water Volume</span>
+          </div>
+          <div>
+            <span id="ratio-display" class="metric-val">1:16</span>
+            <span class="metric-label">Ratio</span>
+          </div>
+        </div>
+      </div>
+    </div>
+  </section>
+`;
+
+export class DgBrewGuide extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._activeMethod = 'pourover';
+    this._cups = 2;
+
+    this._tabs = Array.from(this.shadowRoot.querySelectorAll('.tab'));
+    this._panel = this.shadowRoot.getElementById('brew-panel');
+    this._specTitle = this.shadowRoot.getElementById('spec-title');
+    this._specGrind = this.shadowRoot.getElementById('spec-grind');
+    this._specTemp = this.shadowRoot.getElementById('spec-temp');
+    this._specTime = this.shadowRoot.getElementById('spec-time');
+    this._specTip = this.shadowRoot.getElementById('spec-tip');
+
+    this._cupsRange = this.shadowRoot.getElementById('cups-range');
+    this._cupsVal = this.shadowRoot.getElementById('cups-val');
+    this._coffeeGrams = this.shadowRoot.getElementById('coffee-grams');
+    this._waterMl = this.shadowRoot.getElementById('water-ml');
+    this._ratioDisplay = this.shadowRoot.getElementById('ratio-display');
+
+    this._onTabClick = this._onTabClick.bind(this);
+    this._onTabKeyDown = this._onTabKeyDown.bind(this);
+    this._onRangeInput = this._onRangeInput.bind(this);
+  }
+
+  connectedCallback() {
+    this._tabs.forEach((tab) => {
+      tab.addEventListener('click', this._onTabClick);
+      tab.addEventListener('keydown', this._onTabKeyDown);
+    });
+    this._cupsRange.addEventListener('input', this._onRangeInput);
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._tabs.forEach((tab) => {
+      tab.removeEventListener('click', this._onTabClick);
+      tab.removeEventListener('keydown', this._onTabKeyDown);
+    });
+    this._cupsRange.removeEventListener('input', this._onRangeInput);
+  }
+
+  _onTabClick(event) {
+    this._selectMethod(event.currentTarget.dataset.method);
+  }
+
+  _onTabKeyDown(event) {
+    const currentIndex = this._tabs.indexOf(event.currentTarget);
+    let nextIndex = -1;
+    if (event.key === 'ArrowRight') {
+      nextIndex = (currentIndex + 1) % this._tabs.length;
+    } else if (event.key === 'ArrowLeft') {
+      nextIndex = (currentIndex - 1 + this._tabs.length) % this._tabs.length;
+    }
+    if (nextIndex !== -1) {
+      event.preventDefault();
+      const nextTab = this._tabs[nextIndex];
+      nextTab.focus();
+      this._selectMethod(nextTab.dataset.method);
+    }
+  }
+
+  _selectMethod(method) {
+    if (!BREW_METHODS[method]) return;
+    this._activeMethod = method;
+    this._tabs.forEach((tab) => {
+      const selected = tab.dataset.method === method;
+      tab.setAttribute('aria-selected', String(selected));
+      tab.tabIndex = selected ? 0 : -1;
+      if (selected) {
+        this._panel.setAttribute('aria-labelledby', tab.id);
+      }
+    });
+    this._render();
+  }
+
+  _onRangeInput(event) {
+    this._cups = parseInt(event.target.value, 10) || 1;
+    this._render();
+  }
+
+  _render() {
+    const info = BREW_METHODS[this._activeMethod];
+    this._specTitle.textContent = info.title;
+    this._specGrind.textContent = info.grind;
+    this._specTemp.textContent = info.temp;
+    this._specTime.textContent = info.time;
+    this._specTip.textContent = info.tip;
+
+    this._cupsVal.textContent = String(this._cups);
+    const waterMl = this._cups * 240;
+    const coffeeGrams = Math.round(waterMl / info.ratio);
+
+    this._waterMl.textContent = `${waterMl}ml`;
+    this._coffeeGrams.textContent = `${coffeeGrams}g`;
+    this._ratioDisplay.textContent = `1:${info.ratio}`;
+  }
+}
+
+if (!customElements.get('dg-brew-guide')) {
+  customElements.define('dg-brew-guide', DgBrewGuide);
+}
