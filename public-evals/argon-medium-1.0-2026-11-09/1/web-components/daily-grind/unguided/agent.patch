+        id="favorite-btn"
+        class="favorite-btn"
+        type="button"
+        aria-pressed="false"
+        aria-label="Save to favorites"
+        title="Save to favorites"
+      >
+        <span aria-hidden="true">&#9825;</span>
+      </button>
+    </div>
+
+    <div class="content" part="content">
+      <div class="header-row">
+        <h3 id="card-title"><slot name="title"></slot></h3>
+        <span id="card-price" class="price"></span>
+      </div>
+
+      <p id="card-desc" class="description">
+        <slot></slot>
+      </p>
+
+      <div id="card-meta" class="meta" aria-label="Coffee characteristics"></div>
+
+      <div class="actions" part="actions">
+        <a id="details-link" class="btn btn-secondary" href="#">View Details</a>
+        <button id="add-btn" class="btn" type="button">Quick Add</button>
+      </div>
+    </div>
+  </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'name',
+      'description',
+      'price',
+      'category',
+      'roast',
+      'notes',
+      'image',
+      'href',
+      'badge',
+      'favorited'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    this._article = this.shadowRoot.querySelector('article.card');
+    this._img = this.shadowRoot.getElementById('card-image');
+    this._badge = this.shadowRoot.getElementById('card-badge');
+    this._favBtn = this.shadowRoot.getElementById('favorite-btn');
+    this._titleEl = this.shadowRoot.getElementById('card-title');
+    this._priceEl = this.shadowRoot.getElementById('card-price');
+    this._descEl = this.shadowRoot.getElementById('card-desc');
+    this._metaEl = this.shadowRoot.getElementById('card-meta');
+    this._detailsLink = this.shadowRoot.getElementById('details-link');
+    this._addBtn = this.shadowRoot.getElementById('add-btn');
+
+    this._onFavoriteClick = this._onFavoriteClick.bind(this);
+    this._onDetailsClick = this._onDetailsClick.bind(this);
+    this._onAddClick = this._onAddClick.bind(this);
+  }
+
+  connectedCallback() {
+    this._article.setAttribute('aria-labelledby', 'card-title');
+    this._favBtn.addEventListener('click', this._onFavoriteClick);
+    this._detailsLink.addEventListener('click', this._onDetailsClick);
+    this._addBtn.addEventListener('click', this._onAddClick);
+    this._render();
+  }
+
+  disconnectedCallback() {
+    this._favBtn.removeEventListener('click', this._onFavoriteClick);
+    this._detailsLink.removeEventListener('click', this._onDetailsClick);
+    this._addBtn.removeEventListener('click', this._onAddClick);
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) {
+      this._render();
+    }
+  }
+
+  get itemData() {
+    return {
+      name: this.getAttribute('name') || '',
+      description: this.getAttribute('description') || this.textContent.trim(),
+      price: parseFloat(this.getAttribute('price') || '0'),
+      category: this.getAttribute('category') || 'seasonal',
+      roast: this.getAttribute('roast') || '',
+      notes: this.getAttribute('notes') || '',
+      image: this.getAttribute('image') || '',
+      href: this.getAttribute('href') || '#',
+      badge: this.getAttribute('badge') || '',
+      favorited: this.hasAttribute('favorited')
+    };
+  }
+
+  _onFavoriteClick() {
+    const isFav = this.hasAttribute('favorited');
+    if (isFav) {
+      this.removeAttribute('favorited');
+    } else {
+      this.setAttribute('favorited', '');
+    }
+    this.dispatchEvent(
+      new CustomEvent('coffee-favorite', {
+        bubbles: true,
+        composed: true,
+        detail: this.itemData
+      })
+    );
+  }
+
+  _onDetailsClick(event) {
+    event.preventDefault();
+    this.dispatchEvent(
+      new CustomEvent('coffee-select', {
+        bubbles: true,
+        composed: true,
+        detail: this.itemData
+      })
+    );
+  }
+
+  _onAddClick() {
+    this.dispatchEvent(
+      new CustomEvent('coffee-add', {
+        bubbles: true,
+        composed: true,
+        detail: this.itemData
+      })
+    );
+  }
+
+  _render() {
+    const {
+      name,
+      description,
+      price,
+      roast,
+      notes,
+      image,
+      href,
+      badge,
+      favorited
+    } = this.itemData;
+
+    if (name) {
+      this._titleEl.textContent = name;
+    }
+
+    if (this.hasAttribute('description')) {
+      this._descEl.textContent = description;
+    }
+
+    this._priceEl.textContent = price > 0 ? `$${price.toFixed(2)}` : '';
+
+    const fallbackImage =
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80';
+    this._img.src = image || fallbackImage;
+    this._img.alt = name ? `${name} coffee drink` : 'Artisanal coffee drink';
+
+    if (badge) {
+      this._badge.textContent = badge;
+      this._badge.hidden = false;
+    } else {
+      this._badge.hidden = true;
+    }
+
+    this._favBtn.setAttribute('aria-pressed', String(favorited));
+    this._favBtn.setAttribute(
+      'aria-label',
+      favorited ? `Remove ${name} from favorites` : `Save ${name} to favorites`
+    );
+    this._favBtn.innerHTML = `<span aria-hidden="true">${favorited ? '&#9829;' : '&#9825;'}</span>`;
+
+    this._metaEl.innerHTML = '';
+    if (roast) {
+      const roastSpan = document.createElement('span');
+      roastSpan.className = 'meta-tag';
+      roastSpan.textContent = `Roast: ${roast}`;
+      this._metaEl.appendChild(roastSpan);
+    }
+    if (notes) {
+      const notesSpan = document.createElement('span');
+      notesSpan.className = 'meta-tag';
+      notesSpan.textContent = notes;
+      this._metaEl.appendChild(notesSpan);
+    }
+
+    this._detailsLink.href = href;
+    if (name) {
