diff --git a/components/index.js b/components/index.js
new file mode 100644
index 0000000..70fbb04
--- /dev/null
+++ b/components/index.js
@@ -0,0 +1,54 @@
+import './nav-bar.js';
+import './hero-banner.js';
+import './coffee-card.js';
+import './coffee-catalog.js';
+import './coffee-detail-modal.js';
+import './brew-guide.js';
+import './site-footer.js';
+
+function initDailyGrindApp() {
+  const modal = document.querySelector('coffee-detail-modal');
+  const navbar = document.querySelector('dg-navbar');
+  const liveToast = document.getElementById('app-toast');
+
+  let toastTimer = null;
+  const announce = (message) => {
+    if (!liveToast) return;
+    liveToast.textContent = message;
+    liveToast.dataset.visible = 'true';
+    clearTimeout(toastTimer);
+    toastTimer = setTimeout(() => {
+      liveToast.dataset.visible = 'false';
+    }, 3200);
+  };
+
+  document.addEventListener('coffee-select', (event) => {
+    if (modal && typeof modal.open === 'function') {
+      modal.open(event.detail);
+    }
+  });
+
+  document.addEventListener('coffee-add', (event) => {
+    const item = event.detail;
+    if (navbar && typeof navbar.addItem === 'function') {
+      navbar.addItem(item);
+    }
+    const sizeLabel = item.size ? ` (${item.size})` : '';
+    announce(`Added ${item.name}${sizeLabel} to your Order Bag.`);
+  });
+
+  document.addEventListener('coffee-favorite', (event) => {
+    const item = event.detail;
+    announce(
+      item.favorited
+        ? `Saved ${item.name} to your favorites.`
+        : `Removed ${item.name} from your favorites.`
+    );
+  });
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', initDailyGrindApp);
+} else {
+  initDailyGrindApp();
+}
