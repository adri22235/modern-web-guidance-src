+  <script>
+    (function () {
+      const STORAGE_KEY = 'dailyGrindPreference';
+      const toggleInput = document.getElementById('preference-toggle');
+      const statusBadge = document.getElementById('preference-status');
+      const espressoCard = document.getElementById('espresso-card');
+
+      function applyPreference(isOn) {
+        const enabled = Boolean(isOn);
+        toggleInput.checked = enabled;
+        toggleInput.setAttribute('aria-checked', String(enabled));
+        statusBadge.textContent = enabled ? 'On' : 'Off';
+        statusBadge.setAttribute('data-state', enabled ? 'on' : 'off');
+        document.body.classList.toggle('preference-on', enabled);
+        document.documentElement.setAttribute('data-preference', enabled ? 'on' : 'off');
+        if (espressoCard) {
+          espressoCard.classList.toggle('featured-roast', enabled);
+        }
+        try {
+          localStorage.setItem(STORAGE_KEY, enabled ? 'on' : 'off');
+        } catch (err) {
+          // Ignore storage errors in restricted environments
+        }
+      }
+
+      let initialEnabled = false;
+      try {
+        initialEnabled = localStorage.getItem(STORAGE_KEY) === 'on';
+      } catch (err) {
+        initialEnabled = false;
+      }
+
+      applyPreference(initialEnabled);
+
+      toggleInput.addEventListener('change', function (event) {
+        applyPreference(event.target.checked);
+      });
+
+      toggleInput.addEventListener('keydown', function (event) {
+        if (event.key === 'Enter') {
+          event.preventDefault();
+          applyPreference(!toggleInput.checked);
+        }
+      });
+    })();
+  </script>
+
