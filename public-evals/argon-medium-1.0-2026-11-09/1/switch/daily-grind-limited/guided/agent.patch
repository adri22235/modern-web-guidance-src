+  <script>
+    const notificationSwitch = document.getElementById('order-notifications');
+    const preferenceStatus = document.getElementById('preference-status');
+
+    if (notificationSwitch && preferenceStatus) {
+      const savedPref = localStorage.getItem('dailyGrindOrderNotifications');
+      if (savedPref !== null) {
+        notificationSwitch.checked = savedPref === 'true';
+      }
+
+      notificationSwitch.addEventListener('change', (event) => {
+        const isEnabled = event.target.checked;
+        localStorage.setItem('dailyGrindOrderNotifications', String(isEnabled));
+        preferenceStatus.textContent = isEnabled
+          ? 'Order notifications enabled.'
+          : 'Order notifications disabled.';
+      });
+    }
+  </script>
