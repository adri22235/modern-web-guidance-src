+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const notificationsToggle = document.getElementById('notifications');
+    const notificationsStatus = document.getElementById('notifications-status');
+    const STORAGE_KEY = 'daily-grind-order-notifications';
+
+    function updatePreferenceStatus(isEnabled) {
+      notificationsStatus.textContent = isEnabled
+        ? 'Order pickup notifications are enabled.'
+        : 'Order pickup notifications are currently off.';
+    }
+
+    const savedPreference = localStorage.getItem(STORAGE_KEY);
+    if (savedPreference !== null) {
+      notificationsToggle.checked = savedPreference === 'true';
+      updatePreferenceStatus(notificationsToggle.checked);
+    }
+
+    notificationsToggle.addEventListener('change', (event) => {
+      const isEnabled = event.currentTarget.checked;
+      localStorage.setItem(STORAGE_KEY, String(isEnabled));
+      updatePreferenceStatus(isEnabled);
+    });
+  </script>
+
