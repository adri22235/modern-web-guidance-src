+      'Set-Cookie-HostSession': '__Host-session_id=xyz123; Secure; HttpOnly; SameSite=Lax; Path=/',
+      'Set-Cookie-CHIPS': 'theme_pref=dark; SameSite=None; Secure; Path=/; Partitioned; HttpOnly',
+      'Strict-Transport-Security': 'max-age=31536000; includeSubDomains; preload',
+      'X-Content-Type-Options': 'nosniff',
