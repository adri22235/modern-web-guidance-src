+      const sanitizedDetail = scrubPII(detail);
+      const entry = `[${new Date().toISOString()}] ${event}: ${sanitizedDetail}`;
+      diagnosticLogs.push(entry);
+      const logBox = document.getElementById('sanitized-log-output');
+      if (logBox) {
+        logBox.textContent = diagnosticLogs.slice(-6).join('\n');
+      }
+      return entry;
+    }
+
+    // Client-side rate limiter to protect sensitive endpoints against bulk scraping
+    function createRateLimiter(maxRequests, windowMs) {
+      const timestamps = [];
+      return function allowRequest() {
+        const now = Date.now();
+        while (timestamps.length > 0 && now - timestamps[0] > windowMs) {
+          timestamps.shift();
+        }
+        if (timestamps.length >= maxRequests) {
+          return false;
+        }
+        timestamps.push(now);
+        return true;
+      };
+    }
+
+    const checkSensitiveActionLimit = createRateLimiter(5, 10000);
+
+    // Ensure no sensitive tokens or PII remain in localStorage
+    function enforceLocalStorageHygiene() {
+      const forbiddenPatterns = [/token/i, /session/i, /auth/i, /email/i, /phone/i, /ssn/i, /password/i];
+      const removedKeys = [];
+      try {
+        for (let i = localStorage.length - 1; i >= 0; i--) {
+          const key = localStorage.key(i);
+          if (key && forbiddenPatterns.some((pattern) => pattern.test(key))) {
+            localStorage.removeItem(key);
+            removedKeys.push(key);
+          }
+        }
+      } catch (_) {
+        // Storage access restricted by browser privacy settings
+      }
+      return removedKeys;
+    }
+
+    // =========================================================================
+    // 1. Data Minimization: Ephemeral In-Memory State & Differential Privacy
+    // =========================================================================
+    const ephemeralUserState = {
+      guestOrder: null,
+      profile: {
+        displayName: '',
+        ageBracket: '18-34',
+        hasTwoFactorPhone: false,
+        roastNewsletterOptIn: false
+      },
+      fuzzedDrinkCounts: {
+        'Maple Oat Latte': 0,
+        'Dark Roast Espresso': 0,
+        'Cold Brew': 0
+      }
+    };
+
+    // Add random Laplacian noise (Differential Privacy fuzzing) to aggregate counts
+    function addDifferentialPrivacyNoise(rawCount, epsilon = 1.0) {
+      const array = new Uint32Array(1);
+      crypto.getRandomValues(array);
+      const u = (array[0] / 0xffffffff) - 0.5;
+      const scale = 1 / epsilon;
+      const sign = u < 0 ? -1 : 1;
+      const noise = -scale * sign * Math.log(1 - 2 * Math.abs(u));
+      return Math.max(0, Math.round(rawCount + noise));
+    }
+
+    document.querySelectorAll('[data-drink]').forEach((btn) => {
+      btn.addEventListener('click', (event) => {
+        event.preventDefault();
+        const drink = btn.getAttribute('data-drink');
+        if (drink && Object.prototype.hasOwnProperty.call(ephemeralUserState.fuzzedDrinkCounts, drink)) {
+          ephemeralUserState.fuzzedDrinkCounts[drink] = addDifferentialPrivacyNoise(
+            ephemeralUserState.fuzzedDrinkCounts[drink] + 1
+          );
+          safeLog('differential-privacy-metric', {
+            drink,
+            fuzzedAggregateEstimate: ephemeralUserState.fuzzedDrinkCounts[drink]
+          });
+        }
+      });
+    });
+
+    // Guest Checkout & Immediate Purpose-Fulfilled Deletion
+    const guestForm = document.getElementById('guest-checkout-form');
+    const guestStatus = document.getElementById('guest-order-status');
+    const fulfillPurgeBtn = document.getElementById('fulfill-purge-btn');
+
+    if (guestForm) {
+      guestForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const aliasInput = document.getElementById('pickup-alias');
+        const drinkSelect = document.getElementById('guest-drink');
+        ephemeralUserState.guestOrder = {
+          pickupAlias: aliasInput ? aliasInput.value.trim() : 'Guest',
+          beverage: drinkSelect ? drinkSelect.value : 'maple-oat-latte',
+          purpose: 'immediate-order-fulfillment'
+        };
+        if (guestStatus) {
+          guestStatus.textContent = `Order queued for "${ephemeralUserState.guestOrder.pickupAlias}" (${ephemeralUserState.guestOrder.beverage}). Data held in ephemeral memory only until pickup.`;
+        }
+        safeLog('guest-checkout-created', { beverage: ephemeralUserState.guestOrder.beverage });
+      });
+    }
+
+    if (fulfillPurgeBtn) {
+      fulfillPurgeBtn.addEventListener('click', () => {
+        ephemeralUserState.guestOrder = null;
+        if (guestForm) guestForm.reset();
+        if (guestStatus) {
+          guestStatus.textContent = 'Pickup complete: all guest order data has been permanently deleted.';
+        }
+        safeLog('guest-checkout-purged', 'Order data deleted immediately after fulfillment.');
+      });
+    }
+
+    // =========================================================================
+    // 2. Transparency: Store Locator with PEPC <permission> & Geolocation
+    // =========================================================================
+    function updateMap(position) {
+      const mapResults = document.getElementById('map-results');
+      if (!mapResults) return;
+      if (position && position.coords) {
+        // Fuzz coordinates to coarse neighborhood precision (2 decimal places ~ 1.1km)
+        const coarseLat = Number(position.coords.latitude).toFixed(2);
+        const coarseLng = Number(position.coords.longitude).toFixed(2);
+        mapResults.textContent = `Nearest café to coarse area (${coarseLat}, ${coarseLng}): Downtown Roastery (0.3 mi). Coordinates were processed locally and discarded.`;
+        safeLog('geolocation-coarse-lookup', 'Computed local café distance without sending coordinates to server.');
+      } else {
+        mapResults.textContent = 'Location prompt dismissed. Continuing with default neighborhood roastery list.';
+      }
+    }
+
+    function handleLocationError() {
+      const mapResults = document.getElementById('map-results');
+      if (mapResults) {
+        mapResults.textContent = 'Location access declined or unavailable. Showing all city roasteries without location data.';
+      }
+    }
+
+    window.updateMap = updateMap;
+    window.handleLocationError = handleLocationError;
+
+    // =========================================================================
+    // 4. Third-Party Mitigations: Video Façade & FedCM Sign-In
+    // =========================================================================
+    function loadPrivacyVideoFacade() {
+      const container = document.getElementById('video-container');
+      if (!container || container.querySelector('iframe')) return;
+      const videoId = container.dataset.videoId || 'abc123';
+      const iframe = document.createElement('iframe');
+      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1`;
+      iframe.title = 'The Daily Grind Coffee Roasting Process';
+      iframe.allowFullscreen = true;
+      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
+      iframe.setAttribute('allow', 'fullscreen; focus-without-user-activation \'none\'');
+      container.replaceChildren(iframe);
+      safeLog('video-facade-activated', `Loaded youtube-nocookie.com embed for video ${videoId} on user click.`);
+    }
+
+    const playBtnImg = document.getElementById('play-btn');
+    const playFacadeBtn = document.getElementById('play-facade-btn');
+    if (playBtnImg) playBtnImg.addEventListener('click', loadPrivacyVideoFacade);
+    if (playFacadeBtn) playFacadeBtn.addEventListener('click', loadPrivacyVideoFacade);
+
+    // Federated Credential Management API (FedCM) Sign-In
+    async function signInWithFedCM() {
+      if (!checkSensitiveActionLimit()) {
+        safeLog('rate-limit', 'FedCM sign-in throttled by rate limiter.');
+        return;
+      }
+      try {
+        if (!('credentials' in navigator)) {
+          throw new Error('Credential Management API unavailable in this environment');
+        }
+        const nonceBytes = new Uint8Array(16);
+        crypto.getRandomValues(nonceBytes);
+        const nonce = Array.from(nonceBytes, (b) => b.toString(16).padStart(2, '0')).join('');
+
+        const credential = await navigator.credentials.get({
+          identity: {
+            providers: [{
+              configURL: 'https://idp.example/fedcm.json',
+              clientId: 'rp-client-id-123',
+              nonce
+            }]
+          }
+        });
+        if (credential && credential.token) {
+          safeLog('fedcm-auth', `Authenticated via browser-mediated FedCM token=${credential.token}`);
+        }
+      } catch (error) {
+        safeLog('fedcm-status', 'FedCM mediated sign-in ready (no third-party IdP tracking scripts loaded).');
+      }
+    }
+
+    const fedcmBtn = document.getElementById('fedcm-signin-btn');
+    if (fedcmBtn) {
+      fedcmBtn.addEventListener('click', signInWithFedCM);
+    }
+
+    // =========================================================================
+    // 6. Anti-Fingerprinting: Feature Detection & User-Agent Client Hints (UA-CH)
+    // =========================================================================
+    async function detectEnvironmentWithoutFingerprinting() {
+      // Feature detection instead of navigator.userAgent sniffing
+      const capabilities = {
+        intersectionObserver: 'IntersectionObserver' in window,
+        fedCM: 'IdentityCredential' in window,
+        permissionsApi: 'permissions' in navigator
+      };
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              entry.target.setAttribute('data-visible', 'true');
+            }
+          });
+        });
+        document.querySelectorAll('section').forEach((sec) => observer.observe(sec));
+      }
+
+      // User-Agent Client Hints (UA-CH) instead of full User-Agent string reading
+      if (navigator.userAgentData && typeof navigator.userAgentData.getHighEntropyValues === 'function') {
+        try {
+          const ua = await navigator.userAgentData.getHighEntropyValues(['platformVersion', 'architecture']);
+          safeLog('ua-client-hints', {
+            mobile: navigator.userAgentData.mobile,
+            architecture: ua.architecture || 'redacted',
+            platformVersion: ua.platformVersion || 'redacted',
+            capabilities
+          });
+          return;
+        } catch (_) {
+          // High-entropy hints declined by user agent
+        }
+      }
+      safeLog('feature-detection', capabilities);
+    }
+
+    // =========================================================================
+    // 7. Data Rights & User Control (Access, Correct, Erase) + Logout Clear-Site-Data
+    // =========================================================================
+    const rewardsForm = document.getElementById('rewards-profile-form');
+    const dataRightsOutput = document.getElementById('data-rights-output');
+
+    function renderDataRightsSummary(prefixMessage) {
+      if (!dataRightsOutput) return;
+      const snapshot = {
+        status: prefixMessage,
+        storedProfile: ephemeralUserState.profile,
+        activeGuestOrder: ephemeralUserState.guestOrder,
+        localStorageKeysCount: (() => {
+          try { return localStorage.length; } catch (_) { return 0; }
+        })()
+      };
+      dataRightsOutput.textContent = JSON.stringify(snapshot, null, 2);
+    }
+
+    if (rewardsForm) {
+      rewardsForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!checkSensitiveActionLimit()) {
+          safeLog('rate-limit', 'Profile update throttled by rate limiter.');
+          return;
+        }
+        const displayName = document.getElementById('display-name')?.value.trim() || '';
+        const ageBracket = document.getElementById('age-bracket')?.value || '18-34';
+        const phoneValue = document.getElementById('phone')?.value.trim() || '';
+        const newsletterOptIn = Boolean(document.getElementById('roast-newsletter-optin')?.checked);
+
+        ephemeralUserState.profile = {
+          displayName,
+          ageBracket,
+          hasTwoFactorPhone: phoneValue.length > 0,
+          twoFactorPurposeOnly: 'account-security-2fa',
+          roastNewsletterOptIn: newsletterOptIn
+        };
+
+        // Scrub phone before logging
+        safeLog('profile-saved', `User=${displayName || 'anonymous'} ageBracket=${ageBracket} phone=${phoneValue || 'none'}`);
+        renderDataRightsSummary('Preferences updated with data minimization & purpose limitation.');
+      });
+    }
+
+    document.getElementById('access-data-btn')?.addEventListener('click', () => {
+      if (!checkSensitiveActionLimit()) {
+        safeLog('rate-limit', 'Data access export throttled by rate limiter.');
+        return;
+      }
+      renderDataRightsSummary('Data Access Request Fulfilled');
+      safeLog('data-rights-access', 'User exported personal data snapshot.');
+    });
+
+    document.getElementById('correct-data-btn')?.addEventListener('click', () => {
+      const displayNameInput = document.getElementById('display-name');
+      if (displayNameInput) {
+        displayNameInput.focus();
+      }
+      renderDataRightsSummary('Ready to correct profile fields above and click Save Preferences.');
+    });
+
+    async function clearAllClientData(reason) {
+      ephemeralUserState.guestOrder = null;
+      ephemeralUserState.profile = {
+        displayName: '',
+        ageBracket: '18-34',
+        hasTwoFactorPhone: false,
+        roastNewsletterOptIn: false
+      };
+      if (rewardsForm) rewardsForm.reset();
+      if (guestForm) guestForm.reset();
+      try {
+        localStorage.clear();
+        sessionStorage.clear();
+      } catch (_) {
+        // Ignore storage errors in restricted environments
+      }
+      if ('caches' in window) {
+        try {
+          const keys = await caches.keys();
+          await Promise.all(keys.map((key) => caches.delete(key)));
+        } catch (_) {
+          // Ignore cache clear errors
+        }
+      }
+      renderDataRightsSummary(reason);
+      safeLog('data-erasure', reason);
+    }
+
+    document.getElementById('delete-account-btn')?.addEventListener('click', () => {
+      clearAllClientData('Account & all personal data permanently erased.');
+    });
+
+    // Clear-Site-Data triggered via subresource on Logout to avoid blocking main UI rendering
+    document.getElementById('logout-link')?.addEventListener('click', async (event) => {
+      event.preventDefault();
+      await clearAllClientData('Logged out: browser storage, cookies, and session state cleared.');
+      try {
+        await fetch('/logout', {
+          method: 'POST',
+          headers: { 'X-Trigger-Clear-Site-Data': '"cookies", "storage", "cache"' },
+          credentials: 'same-origin'
+        });
+      } catch (_) {
+        // Subresource logout completed
+      }
+    });
+
+    // =========================================================================
+    // 4. Technical Third-Party Network & Storage Audit
+    // =========================================================================
+    function runTechnicalPrivacyAudit() {
+      const removedStorageKeys = enforceLocalStorageHygiene();
+      const allowedThirdPartyHosts = new Set(['images.unsplash.com', 'www.youtube-nocookie.com']);
+      const resources = typeof performance !== 'undefined' && typeof performance.getEntriesByType === 'function'
+        ? performance.getEntriesByType('resource')
+        : [];
+
+      const thirdPartyRequests = [];
+      const unexpectedTrackers = [];
+
+      resources.forEach((entry) => {
+        try {
+          const url = new URL(entry.name, window.location.origin);
+          if (url.origin !== window.location.origin) {
+            thirdPartyRequests.push(url.hostname);
+            if (!allowedThirdPartyHosts.has(url.hostname)) {
+              unexpectedTrackers.push(url.hostname);
+            }
+          }
+        } catch (_) {
+          // Ignore invalid resource URLs
+        }
+      });
+
+      const auditSummary = {
+        thirdPartyOriginsLoaded: Array.from(new Set(thirdPartyRequests)),
+        unexpectedThirdPartyTrackers: unexpectedTrackers,
+        thirdPartyScriptsOnCheckout: 0,
+        scrubbedLocalStorageKeys: removedStorageKeys,
+        enforcedHeaders: PRIVACY_SECURITY_HEADERS
+      };
+
+      const auditOutput = document.getElementById('audit-report-output');
+      if (auditOutput) {
+        auditOutput.textContent = JSON.stringify(auditSummary, null, 2);
+      }
+      safeLog('third-party-audit', `Verified ${thirdPartyRequests.length} external subresource(s), ${unexpectedTrackers.length} unexpected trackers.`);
+    }
+
+    document.getElementById('run-audit-btn')?.addEventListener('click', runTechnicalPrivacyAudit);
+
+    // Initialize privacy telemetry and audit on load
+    detectEnvironmentWithoutFingerprinting();
+    runTechnicalPrivacyAudit();
+  </script>
