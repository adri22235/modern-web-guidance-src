+        if (gpcBadge) {
+          if (signals.strictSignalActive) {
+            const activeLabels = [];
+            if (signals.gpc) activeLabels.push('GPC');
+            if (signals.dnt) activeLabels.push('DNT');
+            gpcBadge.textContent = activeLabels.join(' + ') + ' Signal Honored (Strict Lock)';
+            gpcBadge.className = 'badge badge-active';
+          } else {
+            gpcBadge.textContent = 'GPC / DNT: Not Set (Strict Opt-In Active)';
+            gpcBadge.className = 'badge';
+          }
+        }
+
+        const urlBadge = document.getElementById('badge-url-sanitizer');
+        if (urlBadge) {
+          if (auditState.strippedUrlParams.length > 0) {
+            urlBadge.textContent = 'Scrubbed ' + auditState.strippedUrlParams.length + ' URL Tracker(s)';
+          } else {
+            urlBadge.textContent = 'URL Clean (0 Trackers)';
+          }
+        }
+
+        const tpBadge = document.getElementById('badge-third-party');
+        if (tpBadge) {
+          tpBadge.textContent = 'Third-Party Trackers: 0 Active (' + auditState.blockedThirdPartyNodes.length + ' Blocked)';
+        }
+      }
+
+      function renderAuditReport() {
+        const report = ThirdPartyAuditor.runFullAudit();
+        renderStatusBar();
+
+        const listEl = document.getElementById('audit-report-list');
+        if (!listEl) return;
+        while (listEl.firstChild) listEl.removeChild(listEl.firstChild);
+
+        const items = [
+          {
+            label: 'Content-Security-Policy (CSP)',
+            value: report.headers.cspPresent ? 'Enforced (object-src none, base-uri self, form-action self)' : 'Missing',
+            ok: report.headers.cspPresent
+          },
+          {
+            label: 'Referrer-Policy',
+            value: report.headers.referrerPolicy,
+            ok: report.headers.referrerPolicy === 'no-referrer'
+          },
+          {
+            label: 'Permissions-Policy',
+            value: report.headers.permissionsPolicyPresent ? 'Locked (Geolocation, Camera, Mic, Topics API Disabled)' : 'Missing',
+            ok: report.headers.permissionsPolicyPresent
+          },
+          {
+            label: 'X-Content-Type-Options',
+            value: report.headers.nosniffPresent ? 'nosniff' : 'Missing',
+            ok: report.headers.nosniffPresent
+          },
+          {
+            label: 'Third-Party Origin Audit',
+            value: report.auditedResources.length + ' origin(s) audited, ' + report.blockedThirdPartyNodes.length + ' unauthorized blocked',
+            ok: true
+          },
+          {
+            label: 'Storage Minimization & Hygiene',
+            value: '0 localStorage keys, ' + report.purgedStorageKeys.length + ' unauthorized/expired key(s) purged',
+            ok: true
+          }
+        ];
+
+        items.forEach(function (item) {
+          const li = document.createElement('li');
+          const nameSpan = document.createElement('strong');
+          nameSpan.textContent = item.label;
+
+          const valSpan = document.createElement('span');
+          valSpan.className = 'badge ' + (item.ok ? 'badge-active' : 'badge-accent');
+          valSpan.textContent = item.value;
+
+          li.appendChild(nameSpan);
+          li.appendChild(valSpan);
+          listEl.appendChild(li);
+        });
+
+        const logBox = document.getElementById('audit-log-output');
+        if (logBox) {
+          logBox.textContent = JSON.stringify(report, null, 2);
+        }
+      }
+
+      function loadAndApplyPreferences() {
+        const signals = detectPrivacySignals();
+        const storedRecord = SecureStorage.getEphemeral('dg_privacy_prefs');
+        const prefs = storedRecord && storedRecord.value ? storedRecord.value : {
+          functional: false,
+          externalMedia: true,
+          diagnostics: false
+        };
+
+        // If GPC or DNT signal is present, force diagnostics off
+        if (signals.strictSignalActive) {
+          prefs.diagnostics = false;
+        }
+
+        const funcCheckbox = document.getElementById('pref-functional');
+        const mediaCheckbox = document.getElementById('pref-external-media');
+        const diagCheckbox = document.getElementById('pref-diagnostics');
+
+        if (funcCheckbox) funcCheckbox.checked = Boolean(prefs.functional);
+        if (mediaCheckbox) mediaCheckbox.checked = prefs.externalMedia !== false;
+        if (diagCheckbox) {
+          diagCheckbox.checked = Boolean(prefs.diagnostics);
+          if (signals.strictSignalActive) {
+            diagCheckbox.disabled = true;
+            diagCheckbox.title = 'Locked off because Global Privacy Control (GPC) or Do Not Track (DNT) is enabled in your browser.';
+          }
+        }
+
+        // Apply external media toggle to hero section
+        const heroEl = document.getElementById('hero-banner');
+        if (heroEl) {
+          if (prefs.externalMedia === false) {
+            heroEl.classList.add('external-media-blocked');
+          } else {
+            heroEl.classList.remove('external-media-blocked');
+          }
+        }
+
+        // Restore favorite drink only if user explicitly opted in
+        if (prefs.functional) {
+          const favRecord = SecureStorage.getEphemeral('dg_favorite_drink');
+          const drinkSelect = document.getElementById('drink-selection');
+          const rememberCheck = document.getElementById('remember-drink-optin');
+          if (favRecord && favRecord.value && drinkSelect) {
+            drinkSelect.value = favRecord.value;
+            if (rememberCheck) rememberCheck.checked = true;
+          }
+        }
+      }
+
+      function renderRoasteryList(filterText) {
+        const listEl = document.getElementById('store-list');
+        if (!listEl) return;
+        while (listEl.firstChild) listEl.removeChild(listEl.firstChild);
+
+        const q = (filterText || '').trim().toLowerCase();
+        const matches = LOCAL_ROASTERIES.filter(function (store) {
+          if (!q) return true;
+          return (
+            store.name.toLowerCase().includes(q) ||
+            store.neighborhood.toLowerCase().includes(q) ||
+            store.zip.includes(q)
+          );
+        });
+
+        if (matches.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.textContent = 'No roasteries match that filter. Try "Downtown" or "981".';
+          listEl.appendChild(emptyLi);
+          return;
+        }
+
+        matches.forEach(function (store) {
+          const li = document.createElement('li');
+          const title = document.createElement('strong');
+          title.textContent = store.name + ' (' + store.neighborhood + ' - ' + store.zip + ')';
+          const hours = document.createElement('div');
+          hours.className = 'field-hint';
+          hours.textContent = 'Hours: ' + store.hours + ' • Looked up locally with 0 network calls';
+          li.appendChild(title);
+          li.appendChild(hours);
+          listEl.appendChild(li);
+        });
+      }
+
+      function handleSecureLogout(event) {
+        if (event) event.preventDefault();
+
+        // 1. Wipe all client-side storage, cookies, and caches
+        SecureStorage.purgeAllClientData();
+
+        // 2. Reset all forms & sensitive inputs in DOM memory
+        const forms = document.querySelectorAll('form');
+        forms.forEach(function (f) { f.reset(); });
+
+        // 3. Re-apply default strict privacy state
+        loadAndApplyPreferences();
+        renderAuditReport();
+
+        // 4. Attempt asynchronous POST to /logout with no-store cache policy
+        if (typeof window.fetch === 'function') {
+          window.fetch('/logout', {
+            method: 'POST',
+            credentials: 'same-origin',
+            cache: 'no-store',
+            referrerPolicy: 'no-referrer',
+            headers: {
+              'X-Requested-With': 'XMLHttpRequest',
+              'Clear-Site-Data-Request': 'storage, cookies, cache'
+            }
+          }).catch(function () {
+            // Static host fallback: client-side state is already completely purged
+          });
+        }
+
+        showBanner(
+          'session-alert',
+          'Session terminated securely via POST. All ephemeral sessionStorage, localStorage, cookies, and form states have been wiped.',
+          'success'
+        );
+
+        const inspectorBox = document.getElementById('storage-inspector-output');
+        if (inspectorBox) {
+          inspectorBox.textContent = JSON.stringify(SecureStorage.inspectSnapshot(), null, 2);
+        }
+      }
+
+      function initEventListeners() {
+        // Jump to Privacy Center
+        const jumpBtn = document.getElementById('jump-to-privacy-btn');
+        if (jumpBtn) {
+          jumpBtn.addEventListener('click', function () {
+            const target = document.getElementById('privacy-center');
+            if (target && typeof target.scrollIntoView === 'function') {
+              target.scrollIntoView({ behavior: 'smooth' });
+            }
+          });
+        }
+
+        // Secure Logout Form & Button
+        const logoutForm = document.getElementById('logout-form');
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', handleSecureLogout);
+        }
+
+        // Seasonal Card Quick-Select Buttons
+        const drinkButtons = document.querySelectorAll('[data-drink]');
+        drinkButtons.forEach(function (btn) {
+          btn.addEventListener('click', function (e) {
+            e.preventDefault();
+            const drinkName = btn.getAttribute('data-drink');
+            const selectEl = document.getElementById('drink-selection');
+            if (selectEl && drinkName) {
+              selectEl.value = drinkName;
+              const orderSection = document.getElementById('express-order');
+              if (orderSection && typeof orderSection.scrollIntoView === 'function') {
+                orderSection.scrollIntoView({ behavior: 'smooth' });
+              }
+            }
+          });
+        });
+
+        // Data-Minimized Express Order Form
+        const orderForm = document.getElementById('minimized-order-form');
+        if (orderForm) {
+          orderForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            const aliasInput = document.getElementById('pickup-alias');
+            const drinkInput = document.getElementById('drink-selection');
+            const rememberInput = document.getElementById('remember-drink-optin');
+
+            const sanitizedAlias = sanitizeAlias(aliasInput ? aliasInput.value : '');
+            const selectedDrink = redactPII(drinkInput ? drinkInput.value : 'Maple Oat Latte');
+
+            if (!sanitizedAlias || sanitizedAlias.length < 2) {
+              showBanner('order-feedback', 'Please enter a valid 2–20 character pickup alias (no emails or phone numbers).', 'warn');
+              return;
+            }
+
+            // Store only data-minimized ephemeral order ticket with 30-min TTL
+            const ticketCode = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+            SecureStorage.setEphemeral('dg_ephemeral_order', {
+              ticketCode: ticketCode,
+              pickupAlias: sanitizedAlias,
+              drink: selectedDrink
+            }, PRIVACY_CONFIG.TTL.ORDER_MS);
+
+            // Only store favorite drink if user opted in
+            if (rememberInput && rememberInput.checked) {
+              SecureStorage.setEphemeral('dg_favorite_drink', selectedDrink, PRIVACY_CONFIG.TTL.FAVORITE_MS);
+              SecureStorage.setEphemeral('dg_privacy_prefs', {
+                functional: true,
+                externalMedia: document.getElementById('pref-external-media').checked,
+                diagnostics: document.getElementById('pref-diagnostics').checked
+              }, PRIVACY_CONFIG.TTL.PREFS_MS);
+              loadAndApplyPreferences();
+            }
+
+            // Clear text input immediately from DOM after queuing
+            if (aliasInput) aliasInput.value = '';
+
+            showBanner(
+              'order-feedback',
+              'Order queued (' + ticketCode + ') for "' + sanitizedAlias + '" (' + selectedDrink + '). Stored ephemerally for 30 minutes only.',
+              'success'
+            );
+            renderAuditReport();
+          });
+        }
+
+        // Explicit Opt-In Rewards Form
+        const rewardsForm = document.getElementById('rewards-optin-form');
+        if (rewardsForm) {
+          rewardsForm.addEventListener('submit', function (e) {
+            e.preventDefault();
+            const emailInput = document.getElementById('rewards-email');
+            const voucherConsent = document.getElementById('consent-voucher-emails');
+            const seasonalConsent = document.getElementById('consent-seasonal-news');
+
+            const rawEmail = emailInput ? emailInput.value.trim() : '';
+            const isValidEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(rawEmail);
+
+            if (!isValidEmail) {
+              showBanner('rewards-feedback', 'Please provide a valid email address.', 'warn');
+              return;
+            }
+
+            if (!voucherConsent || !voucherConsent.checked) {
+              showBanner('rewards-feedback', 'Explicit opt-in consent is required before we can enroll your email.', 'warn');
+              return;
+            }
+
+            // Mask the email before storing any client-side confirmation receipt (Data Minimization)
+            const masked = maskEmail(rawEmail);
+            SecureStorage.setEphemeral('dg_rewards_receipt', {
+              maskedEmail: masked,
+              voucherConsent: true,
+              seasonalReleasesConsent: Boolean(seasonalConsent && seasonalConsent.checked),
+              consentedAt: new Date().toISOString()
+            }, PRIVACY_CONFIG.TTL.ORDER_MS);
+
+            // Wipe raw PII from form input immediately
+            rewardsForm.reset();
+
+            showBanner(
+              'rewards-feedback',
+              'Enrolled ' + masked + ' with explicit opt-in consent. Raw email was cleared from form memory.',
+              'success'
+            );
+            renderAuditReport();
+          });
+        }
+
+        // Local Roastery Filter (0 network calls, 0 geolocation)
+        const storeQueryInput = document.getElementById('store-query');
+        if (storeQueryInput) {
+          storeQueryInput.addEventListener('input', function () {
+            renderRoasteryList(storeQueryInput.value);
+          });
+        }
+
+        // Privacy Center Buttons
+        const savePrefsBtn = document.getElementById('save-prefs-btn');
+        if (savePrefsBtn) {
+          savePrefsBtn.addEventListener('click', function () {
+            const signals = detectPrivacySignals();
+            const functional = Boolean(document.getElementById('pref-functional').checked);
+            const externalMedia = Boolean(document.getElementById('pref-external-media').checked);
+            const diagnostics = signals.strictSignalActive
+              ? false
+              : Boolean(document.getElementById('pref-diagnostics').checked);
+
+            SecureStorage.setEphemeral('dg_privacy_prefs', {
+              functional: functional,
+              externalMedia: externalMedia,
+              diagnostics: diagnostics
+            }, PRIVACY_CONFIG.TTL.PREFS_MS);
+
+            if (!functional) {
+              try { window.sessionStorage.removeItem('dg_favorite_drink'); } catch (_) {}
+            }
+
+            loadAndApplyPreferences();
+            renderAuditReport();
+
+            const inspectorBox = document.getElementById('storage-inspector-output');
+            if (inspectorBox) {
+              inspectorBox.textContent = 'Preferences saved with 24h TTL.\n' + JSON.stringify(SecureStorage.inspectSnapshot(), null, 2);
+            }
+          });
+        }
+
+        const inspectBtn = document.getElementById('inspect-storage-btn');
+        if (inspectBtn) {
+          inspectBtn.addEventListener('click', function () {
+            const inspectorBox = document.getElementById('storage-inspector-output');
+            if (inspectorBox) {
+              inspectorBox.textContent = JSON.stringify(SecureStorage.inspectSnapshot(), null, 2);
+            }
+          });
+        }
+
+        const exportBtn = document.getElementById('export-data-btn');
+        if (exportBtn) {
+          exportBtn.addEventListener('click', function () {
+            const payload = {
+              exportedAt: new Date().toISOString(),
+              service: 'The Daily Grind Coffee Co.',
+              dataMinimizationPolicy: 'Zero persistent PII stored. Ephemeral session records only.',
+              storageSnapshot: SecureStorage.inspectSnapshot(),
+              securityAudit: ThirdPartyAuditor.runFullAudit()
+            };
+            const jsonStr = JSON.stringify(payload, null, 2);
+            const inspectorBox = document.getElementById('storage-inspector-output');
+            if (inspectorBox) {
+              inspectorBox.textContent = '--- PORTABLE DATA EXPORT (JSON) ---\n' + jsonStr;
+            }
+            try {
+              const blob = new Blob([jsonStr], { type: 'application/json' });
+              const blobUrl = URL.createObjectURL(blob);
+              const a = document.createElement('a');
+              a.href = blobUrl;
+              a.download = 'daily-grind-privacy-export.json';
+              document.body.appendChild(a);
+              a.click();
+              document.body.removeChild(a);
+              setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 1000);
+            } catch (_) {}
+          });
+        }
+
+        const purgeBtn = document.getElementById('purge-data-btn');
+        if (purgeBtn) {
+          purgeBtn.addEventListener('click', function () {
+            SecureStorage.purgeAllClientData();
+            loadAndApplyPreferences();
+            renderAuditReport();
+            const inspectorBox = document.getElementById('storage-inspector-output');
+            if (inspectorBox) {
+              inspectorBox.textContent = 'All client storage (sessionStorage, localStorage, cookies, caches) has been purged.\n' +
+                JSON.stringify(SecureStorage.inspectSnapshot(), null, 2);
+            }
+          });
+        }
+
+        const runAuditBtn = document.getElementById('run-audit-btn');
+        if (runAuditBtn) {
+          runAuditBtn.addEventListener('click', function () {
+            renderAuditReport();
+          });
+        }
+
+        const simulateTrackerBtn = document.getElementById('simulate-tracker-test-btn');
+        if (simulateTrackerBtn) {
+          simulateTrackerBtn.addEventListener('click', function () {
+            // Simulate an unauthorized third-party tracking pixel & cookie to demonstrate automated blocking
+            try {
+              window.localStorage.setItem('_ga_simulated_tracker', 'GA1.2.123456789');
+            } catch (_) {}
+            const fakePixel = document.createElement('img');
+            fakePixel.setAttribute('src', 'https://tracker.unapproved-adnetwork.example/pixel.gif');
+            document.body.appendChild(fakePixel);
+
+            // Audit & sweep immediately catches and neutralizes both
+            ThirdPartyAuditor.hardenElementAttributes(document);
+            if (fakePixel.parentNode) fakePixel.parentNode.removeChild(fakePixel);
+            renderAuditReport();
+          });
+        }
+
+        // Automatically sweep expired items on visibility change / pagehide
+        window.addEventListener('pagehide', function () {
+          SecureStorage.sweepAndEnforceHygiene();
+        });
+      }
+
+      /**
+       * ============================================================================
+       * 8. BOOTSTRAP PRIVACY BY DESIGN ON LOAD
+       * ============================================================================
+       */
+      function initPrivacyByDesign() {
+        sanitizeUrlParameters();
+        SecureStorage.sweepAndEnforceHygiene();
+        ThirdPartyAuditor.hardenElementAttributes(document);
+        ThirdPartyAuditor.startMutationGuard();
+        loadAndApplyPreferences();
+        renderRoasteryList('');
+        renderAuditReport();
+        initEventListeners();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPrivacyByDesign);
+      } else {
+        initPrivacyByDesign();
+      }
+    })();
+  </script>
