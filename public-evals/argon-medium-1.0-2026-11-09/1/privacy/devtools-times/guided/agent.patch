diff --git a/src/pages/api/logout.ts b/src/pages/api/logout.ts
new file mode 100644
index 0000000..b8376de
--- /dev/null
+++ b/src/pages/api/logout.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ session }) => {
+  if (session) {
+    await session.set('readingList', []);
+    if (typeof session.destroy === 'function') {
+      session.destroy();
+    }
+  }
+
+  return new Response(
+    JSON.stringify({ message: 'Signed out and cleared local site data.' }),
+    {
+      status: 200,
+      headers: {
+        'Content-Type': 'application/json',
+        'Clear-Site-Data': '"cookies", "storage", "cache"',
+        'Cache-Control': 'no-store, max-age=0',
+      },
+    }
+  );
+};
