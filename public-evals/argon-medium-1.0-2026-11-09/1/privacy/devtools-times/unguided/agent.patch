diff --git a/src/components/PrivacyPreferences.tsx b/src/components/PrivacyPreferences.tsx
new file mode 100644
index 0000000..a1e70ba
--- /dev/null
+++ b/src/components/PrivacyPreferences.tsx
@@ -0,0 +1,268 @@
+import React, { useState, useEffect } from 'react';
+
+export interface PrivacyPrefs {
+  analytics: boolean;
+  ads: boolean;
+  decided: boolean;
+}
+
+const STORAGE_KEY = 'dtt_privacy_preferences';
+const ANALYTICS_SCRIPT_ID = 'dtt-third-party-analytics';
+const ANALYTICS_SCRIPT_SRC =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+const DEFAULT_PREFS: PrivacyPrefs = {
+  analytics: false,
+  ads: false,
+  decided: false,
+};
+
+function isPrivacySignalEnabled(): boolean {
+  if (typeof navigator === 'undefined') return false;
+  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
+  return (
+    nav.globalPrivacyControl === true ||
+    navigator.doNotTrack === '1' ||
+    (window as Window & { doNotTrack?: string }).doNotTrack === '1'
+  );
+}
+
+function isSensitiveAuthPage(): boolean {
+  if (typeof window === 'undefined') return false;
+  const path = window.location.pathname.toLowerCase();
+  return path.endsWith('/signin') || path.endsWith('/ signin/') || path.includes('/signin') || path.includes('/signup');
+}
+
+export function getStoredPrivacyPrefs(): PrivacyPrefs {
+  if (typeof window === 'undefined') return DEFAULT_PREFS;
+  if (isPrivacySignalEnabled()) {
+    return { analytics: false, ads: false, decided: true };
+  }
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY);
+    if (!raw) return DEFAULT_PREFS;
+    const parsed = JSON.parse(raw);
+    return {
+      analytics: Boolean(parsed.analytics),
+      ads: Boolean(parsed.ads),
+      decided: Boolean(parsed.decided),
+    };
+  } catch {
+    return DEFAULT_PREFS;
+  }
+}
+
+export default function PrivacyPreferences({ privacyPolicyUrl }: { privacyPolicyUrl: string }) {
+  const [prefs, setPrefs] = useState<PrivacyPrefs>(DEFAULT_PREFS);
+  const [showBanner, setShowBanner] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [gpcActive, setGpcActive] = useState(false);
+
+  useEffect(() => {
+    const signalActive = isPrivacySignalEnabled();
+    setGpcActive(signalActive);
+
+    const stored = getStoredPrivacyPrefs();
+    setPrefs(stored);
+    setShowBanner(!stored.decided && !signalActive);
+
+    const handleOpenPreferences = (e: Event) => {
+      e.preventDefault();
+      setShowModal(true);
+    };
+
+    window.addEventListener('dtt:open-privacy-preferences', handleOpenPreferences);
+    const manageLinks = document.querySelectorAll('[data-manage-privacy]');
+    manageLinks.forEach((link) => link.addEventListener('click', handleOpenPreferences));
+
+    return () => {
+      window.removeEventListener('dtt:open-privacy-preferences', handleOpenPreferences);
+      manageLinks.forEach((link) => link.removeEventListener('click', handleOpenPreferences));
+    };
+  }, []);
+
+  useEffect(() => {
+    const existingScript = document.getElementById(ANALYTICS_SCRIPT_ID);
+
+    if (prefs.analytics && !gpcActive && !isSensitiveAuthPage()) {
+      if (!existingScript) {
+        const script = document.createElement('script');
+        script.id = ANALYTICS_SCRIPT_ID;
+        script.src = ANALYTICS_SCRIPT_SRC;
+        script.async = true;
+        script.defer = true;
+        script.crossOrigin = 'anonymous';
+        script.referrerPolicy = 'no-referrer';
+        document.head.appendChild(script);
+      }
+    } else if (existingScript) {
+      existingScript.remove();
+    }
+
+    window.dispatchEvent(
+      new CustomEvent('dtt:privacy-updated', {
+        detail: {
+          analytics: prefs.analytics && !gpcActive && !isSensitiveAuthPage(),
+          ads: prefs.ads && !gpcActive,
+        },
+      })
+    );
+  }, [prefs, gpcActive]);
+
+  const savePreferences = (nextPrefs: PrivacyPrefs) => {
+    const sanitized: PrivacyPrefs = gpcActive
+      ? { analytics: false, ads: false, decided: true }
+      : { ...nextPrefs, decided: true };
+
+    setPrefs(sanitized);
+    setShowBanner(false);
+    setShowModal(false);
+
+    try {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(sanitized));
+    } catch {
+      // Ignore storage errors in restricted environments
+    }
+  };
+
+  const handleRejectAll = () => {
+    savePreferences({ analytics: false, ads: false, decided: true });
+  };
+
+  const handleSaveSelection = (e: React.FormEvent) => {
+    e.preventDefault();
+    savePreferences(prefs);
+  };
+
+  return (
+    <>
+      {showBanner && !showModal && (
+        <aside
+          aria-label="Privacy and data preferences"
+          className="fixed bottom-0 inset-x-0 z-50 bg-white border-t border-gray-300 shadow-lg p-4 md:px-6"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
+            <div className="text-xs text-gray-700 space-y-1 max-w-3xl">
+              <p className="font-semibold text-gray-900">Your Privacy Choices (Privacy by Default)</p>
+              <p>
+                We practice data minimization. Non-essential third-party analytics and advertising scripts are{' '}
+                <strong>disabled by default</strong> and never run on authentication pages. Read our{' '}
+                <a
+                  href={privacyPolicyUrl}
+                  data-skip-tracking="true"
+                  className="underline font-medium text-gray-900 hover:text-gray-700"
+                >
+                  Privacy Policy
+                </a>{' '}
+                to learn how we protect your data.
+              </p>
+            </div>
+            <div className="flex flex-wrap items-center gap-2 shrink-0">
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={handleRejectAll}
+                className="px-3 py-1.5 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+              >
+                Keep Optional Tracking Off
+              </button>
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={() => setShowModal(true)}
+                className="px-3 py-1.5 text-xs font-semibold text-gray-800 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200"
+              >
+                Customize Preferences
+              </button>
+            </div>
+          </div>
+        </aside>
+      )}
+
+      {showModal && (
+        <div
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="privacy-modal-title"
+          className="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4"
+        >
+          <div className="bg-white rounded-lg shadow-xl max-w-lg w-full p-6 border border-gray-200">
+            <h2 id="privacy-modal-title" className="text-lg font-bold text-gray-900 mb-2">
+              Privacy &amp; Third-Party Script Preferences
+            </h2>
+            <p className="text-xs text-gray-600 mb-4">
+              By default, all optional third-party scripts are turned off. You can review and control what runs below.
+              {gpcActive && (
+                <span className="block mt-1 text-green-800 font-medium">
+                  Global Privacy Control / Do Not Track signal detected: optional tracking is automatically disabled.
+                </span>
+              )}
+            </p>
+
+            <form onSubmit={handleSaveSelection} className="space-y-4 text-sm">
+              <div className="p-3 bg-gray-50 rounded border border-gray-200">
+                <div className="flex items-center justify-between">
+                  <span className="font-semibold text-gray-900">Strictly Necessary (Always Active)</span>
+                  <span className="text-xs text-gray-500 font-medium">Required</span>
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Used only when you explicitly bookmark articles to your Reading List or sign in. No tracking cookies are set during passive browsing.
+                </p>
+              </div>
+
+              <label className="flex items-start gap-3 p-3 rounded border border-gray-200 cursor-pointer">
+                <input
+                  type="checkbox"
+                  checked={prefs.analytics && !gpcActive}
+                  disabled={gpcActive}
+                  onChange={(e) => setPrefs({ ...prefs, analytics: e.target.checked })}
+                  className="mt-1"
+                />
+                <div>
+                  <span className="font-semibold text-gray-900 block">Third-Party Interaction Analytics (Opt-In)</span>
+                  <span className="text-xs text-gray-600 block mt-0.5">
+                    Loads an external analytics script with strict referrer suppression to measure navigation clicks. Never loaded on Sign-In or Sign-Up pages.
+                  </span>
+                </div>
+              </label>
+
+              <label className="flex items-start gap-3 p-3 rounded border border-gray-200 cursor-pointer">
+                <input
+                  type="checkbox"
+                  checked={prefs.ads && !gpcActive}
+                  disabled={gpcActive}
+                  onChange={(e) => setPrefs({ ...prefs, ads: e.target.checked })}
+                  className="mt-1"
+                />
+                <div>
+                  <span className="font-semibold text-gray-900 block">Third-Party Contextual Ad Slots (Opt-In)</span>
+                  <span className="text-xs text-gray-600 block mt-0.5">
+                    Allows display of external ad slot frames when enabled. Disabled by default to prevent third-party network requests.
+                  </span>
+                </div>
+              </label>
+
+              <div className="flex justify-end gap-2 pt-2">
+                <button
+                  type="button"
+                  data-skip-tracking="true"
+                  onClick={handleRejectAll}
+                  className="px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-100 rounded hover:bg-gray-200"
+                >
+                  Reject All Optional
+                </button>
+                <button
+                  type="submit"
+                  data-skip-tracking="true"
+                  className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+                >
+                  Save Preferences
+                </button>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
