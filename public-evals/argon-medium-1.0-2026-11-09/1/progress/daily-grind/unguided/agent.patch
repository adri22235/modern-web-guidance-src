+  <script>
+    function setProgressMode(mode) {
+      const btnDet = document.getElementById('btn-determinate');
+      const btnIndet = document.getElementById('btn-indeterminate');
+      const bar = document.getElementById('reward-progress-bar');
+      const fill = document.getElementById('reward-progress-fill');
+      const nativeProg = document.getElementById('reward-native-progress');
+      const badge = document.getElementById('reward-progress-badge');
+      const detail = document.getElementById('reward-progress-detail');
+      const slider = document.getElementById('reward-slider');
+      const val = slider ? slider.value : 75;
+
+      if (mode === 'indeterminate') {
+        btnDet.classList.remove('active');
+        btnIndet.classList.add('active');
+        bar.classList.remove('determinate');
+        bar.classList.add('indeterminate');
+        bar.removeAttribute('aria-valuenow');
+        bar.setAttribute('aria-busy', 'true');
+        bar.setAttribute('aria-valuetext', 'Syncing reward points in progress');
+        fill.classList.add('indeterminate');
+        nativeProg.removeAttribute('value');
+        badge.textContent = 'Syncing...';
+        badge.classList.add('indeterminate-badge');
+        detail.textContent = 'Calculating bonus Roast Stars from your recent order...';
+      } else {
+        btnIndet.classList.remove('active');
+        btnDet.classList.add('active');
+        bar.classList.remove('indeterminate');
+        bar.classList.add('determinate');
+        bar.setAttribute('aria-busy', 'false');
+        fill.classList.remove('indeterminate');
+        badge.classList.remove('indeterminate-badge');
+        updateDeterminateValue(val);
+      }
+    }
+
+    function updateDeterminateValue(value) {
+      const pct = Math.max(0, Math.min(100, Number(value)));
+      const bar = document.getElementById('reward-progress-bar');
+      const fill = document.getElementById('reward-progress-fill');
+      const nativeProg = document.getElementById('reward-native-progress');
+      const badge = document.getElementById('reward-progress-badge');
+      const detail = document.getElementById('reward-progress-detail');
+      const btnDet = document.getElementById('btn-determinate');
+      const btnIndet = document.getElementById('btn-indeterminate');
+
+      btnIndet.classList.remove('active');
+      btnDet.classList.add('active');
+      btnDet.textContent = `Determinate (${pct}%)`;
+
+      bar.classList.remove('indeterminate');
+      bar.classList.add('determinate');
+      bar.setAttribute('aria-valuenow', String(pct));
+      bar.setAttribute('aria-busy', 'false');
+      bar.setAttribute('aria-valuetext', `${pct}% complete (${pct} of 100 Roast Stars)`);
+
+      fill.classList.remove('indeterminate');
+      fill.style.width = `${pct}%`;
+
+      nativeProg.setAttribute('value', String(pct));
+      nativeProg.textContent = `${pct}%`;
+
+      badge.classList.remove('indeterminate-badge');
+      badge.textContent = `${pct}% Complete`;
+
+      const remaining = 100 - pct;
+      detail.textContent = remaining > 0
+        ? `${pct} / 100 Roast Stars earned — ${remaining} more for your next reward!`
+        : '100 / 100 Roast Stars earned — Your free handcrafted drink is ready to redeem!';
+    }
+  </script>
