+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const select = document.getElementById('theme-select');
+      const systemOption = document.getElementById('theme-option-system');
+      const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      function updateSystemOptionLabel() {
+        if (systemOption) {
+          const currentSystem = darkQuery.matches ? 'dark' : 'light';
+          systemOption.textContent = `System (Currently ${currentSystem})`;
+        }
+      }
+
+      function syncFromStorage() {
+        let stored = null;
+        try {
+          stored = localStorage.getItem('color-scheme');
+        } catch {}
+        const isOverride = stored === 'light' || stored === 'dark';
+        if (meta) {
+          meta.content = isOverride ? stored : 'light dark';
+        }
+        if (select) {
+          select.value = isOverride ? stored : 'system';
+        }
+      }
+
+      updateSystemOptionLabel();
+      syncFromStorage();
+
+      darkQuery.addEventListener('change', () => {
+        updateSystemOptionLabel();
+      });
+
+      if (select) {
+        select.addEventListener('change', (event) => {
+          const value = event.target.value;
+          if (value === 'light' || value === 'dark') {
+            if (meta) meta.content = value;
+            try {
+              localStorage.setItem('color-scheme', value);
+            } catch {}
+          } else {
+            if (meta) meta.content = 'light dark';
+            try {
+              localStorage.removeItem('color-scheme');
+            } catch {}
+          }
+        });
+      }
+
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          syncFromStorage();
+        }
+      });
+    })();
+  </script>
