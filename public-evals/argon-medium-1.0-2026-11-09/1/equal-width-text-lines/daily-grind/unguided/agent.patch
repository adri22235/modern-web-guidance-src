+  <script>
+    (function () {
+      const heading = document.querySelector('.hero h1');
+      if (!heading) return;
+      const lines = Array.from(heading.querySelectorAll('span'));
+
+      function fitPosterLines() {
+        const targetWidth = heading.clientWidth;
+        if (!targetWidth) return;
+
+        lines.forEach((line) => {
+          line.style.fontSize = '100px';
+          const measuredWidth = line.getBoundingClientRect().width;
+          if (measuredWidth > 0) {
+            const scaledSize = (100 * targetWidth) / measuredWidth;
+            line.style.fontSize = scaledSize + 'px';
+            const refinedWidth = line.getBoundingClientRect().width;
+            if (refinedWidth > 0 && Math.abs(refinedWidth - targetWidth) > 0.1) {
+              line.style.fontSize = (scaledSize * targetWidth) / refinedWidth + 'px';
+            }
+          }
+        });
+      }
+
+      fitPosterLines();
+      window.addEventListener('resize', fitPosterLines);
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(fitPosterLines).observe(heading);
+      }
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitPosterLines);
+      }
+    })();
+  </script>
