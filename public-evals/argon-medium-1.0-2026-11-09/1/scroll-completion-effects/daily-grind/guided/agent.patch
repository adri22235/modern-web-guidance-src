+  <script>
+    let currentScrollId = 0;
+    const sections = document.querySelectorAll('main section[id]');
+    const navLinks = document.querySelectorAll('nav a[href^="#"], nav a[data-scroll-target]');
+    const scrollTriggers = document.querySelectorAll('nav a[href^="#"], [data-scroll-target]');
+
+    async function scrollToAndHighlight(targetElement, activeNavLink) {
+      const scrollId = ++currentScrollId;
+      sections.forEach((sec) => sec.classList.remove('highlight'));
+      navLinks.forEach((link) => link.removeAttribute('aria-current'));
+
+      await targetElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
+
+      // Abort follow-up effect if another scroll was triggered while awaiting
+      if (scrollId !== currentScrollId) return;
+
+      targetElement.classList.add('highlight');
+      if (activeNavLink) {
+        activeNavLink.setAttribute('aria-current', 'true');
+      }
+
+      const targetHeading = targetElement.querySelector('h2[tabindex="-1"], [tabindex="-1"]') || targetElement;
+      targetHeading.focus({ preventScroll: true });
+    }
+
+    scrollTriggers.forEach((trigger) => {
+      trigger.addEventListener('click', async (event) => {
+        const rawTarget = trigger.dataset.scrollTarget || trigger.getAttribute('href') || '';
+        const targetId = rawTarget.replace(/^#/, '');
+        const targetElement = document.getElementById(targetId);
+        if (!targetElement) return;
+
+        event.preventDefault();
+        const matchingNavLink = trigger.closest('nav')
+          ? trigger
+          : document.querySelector(`nav a[data-scroll-target="${targetId}"], nav a[href="#${targetId}"]`);
+        await scrollToAndHighlight(targetElement, matchingNavLink);
+      });
+    });
+  </script>
+
