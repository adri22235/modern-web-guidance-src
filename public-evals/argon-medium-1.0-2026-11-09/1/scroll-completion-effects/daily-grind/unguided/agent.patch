+  <script>
+    (function () {
+      let activeScrollCleanup = null;
+
+      function getTargetElement(trigger) {
+        const dataTarget = trigger.getAttribute('data-scroll-target');
+        if (dataTarget) {
+          const cleanId = dataTarget.replace(/^#/, '');
+          const el = document.getElementById(cleanId);
+          if (el) return el;
+        }
+        const href = trigger.getAttribute('href');
+        if (href && href.startsWith('#') && href.length > 1) {
+          const cleanId = href.slice(1);
+          return document.getElementById(cleanId);
+        }
+        return null;
+      }
+
+      function clearSectionEffects() {
+        document.querySelectorAll('.page-section').forEach((section) => {
+          section.classList.remove('section-arrived', 'is-highlighted', 'active');
+          section.removeAttribute('data-scroll-arrived');
+          if (document.activeElement === section) {
+            section.blur();
+          }
+        });
+      }
+
+      function activateTargetAfterScroll(target, trigger) {
+        clearSectionEffects();
+
+        document.querySelectorAll('nav a').forEach((navLink) => {
+          const linkTarget = getTargetElement(navLink);
+          const isMatch = linkTarget === target || navLink === trigger;
+          navLink.classList.toggle('active', isMatch);
+          if (isMatch) {
+            navLink.setAttribute('aria-current', 'true');
+          } else {
+            navLink.removeAttribute('aria-current');
+          }
+        });
+
+        target.classList.add('section-arrived', 'is-highlighted', 'active');
+        target.setAttribute('data-scroll-arrived', 'true');
+        target.focus({ preventScroll: true });
+
+        if (target.id && window.history && window.history.replaceState) {
+          window.history.replaceState(null, '', '#' + target.id);
+        }
+
+        target.dispatchEvent(
+          new CustomEvent('scrollarrival', {
+            bubbles: true,
+            detail: { targetId: target.id }
+          })
+        );
+      }
+
+      function smoothScrollToTarget(target, trigger) {
+        if (activeScrollCleanup) {
+          activeScrollCleanup();
+          activeScrollCleanup = null;
+        }
+
+        // Ensure no target visual effects, animations, or focus changes exist while scrolling
+        clearSectionEffects();
+        document.body.setAttribute('data-scrolling', 'true');
+
+        const nav = document.querySelector('nav');
+        const navOffset = (nav ? nav.getBoundingClientRect().height : 68) + 20;
+        const startY = window.scrollY || window.pageYOffset || 0;
+        const maxScrollY = Math.max(
+          0,
+          document.documentElement.scrollHeight - window.innerHeight
+        );
+        const rawDestinationY =
+          startY + target.getBoundingClientRect().top - navOffset;
+        const destinationY = Math.max(0, Math.min(rawDestinationY, maxScrollY));
+        const totalDistance = Math.abs(destinationY - startY);
+
+        let finished = false;
+        let idleTimer = null;
+        let fallbackTimer = null;
+        let hasObservedScroll = false;
+
+        function finishScroll() {
+          if (finished) return;
+          finished = true;
+          cleanup();
+          document.body.setAttribute('data-scrolling', 'false');
+          activateTargetAfterScroll(target, trigger);
+        }
+
+        function onScroll() {
+          hasObservedScroll = true;
+          if (idleTimer) clearTimeout(idleTimer);
+          const currentY = window.scrollY || window.pageYOffset || 0;
+          const remaining = Math.abs(currentY - destinationY);
+          const delay = remaining <= 8 ? 80 : 140;
+          idleTimer = setTimeout(finishScroll, delay);
+        }
+
+        function onScrollEnd() {
+          if (hasObservedScroll || totalDistance <= 4) {
+            finishScroll();
+          }
+        }
+
+        function cleanup() {
+          window.removeEventListener('scroll', onScroll, { passive: true });
+          window.removeEventListener('scrollend', onScrollEnd);
+          document.removeEventListener('scrollend', onScrollEnd);
+          if (idleTimer) clearTimeout(idleTimer);
+          if (fallbackTimer) clearTimeout(fallbackTimer);
+          activeScrollCleanup = null;
+        }
+
+        activeScrollCleanup = cleanup;
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', onScrollEnd, { once: true });
+        document.addEventListener('scrollend', onScrollEnd, { once: true });
+
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+
+        if (totalDistance <= 2) {
+          fallbackTimer = setTimeout(finishScroll, 150);
+        } else {
+          fallbackTimer = setTimeout(finishScroll, 700);
+        }
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"], [data-scroll-target]');
+        if (!link) return;
+
+        const target = getTargetElement(link);
+        if (!target) return;
+
+        event.preventDefault();
+        smoothScrollToTarget(target, link);
+      });
+    })();
+  </script>
 </body>
 
