+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
+      const sections = navLinks
+        .map((link) => {
+          const id = link.getAttribute('href').slice(1);
+          return document.getElementById(id);
+        })
+        .filter(Boolean);
+
+      function setActiveSection(activeId) {
+        navLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + activeId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function getActiveSectionId() {
+        if (!sections.length) return null;
+
+        const navHeight = nav ? nav.offsetHeight : 64;
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        const probeLine = navHeight + Math.min(140, viewportHeight * 0.25);
+
+        // 1. If scrolled to the very bottom of the page, highlight the last section if it is visible
+        const scrollBottom = window.scrollY + viewportHeight;
+        const docHeight = Math.max(
+          document.body.scrollHeight,
+          document.documentElement.scrollHeight
+        );
+        if (docHeight - scrollBottom <= 10) {
+          const lastSection = sections[sections.length - 1];
+          const lastRect = lastSection.getBoundingClientRect();
+          if (lastRect.top < viewportHeight && lastRect.bottom > navHeight) {
+            return lastSection.id;
+          }
+        }
+
+        // 2. Check if any section straddles the probe line right below the sticky header
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= probeLine && rect.bottom > probeLine) {
+            return section.id;
+          }
+        }
+
+        // 3. Otherwise, pick the section with the largest visible height in the viewport
+        let bestId = null;
+        let maxVisibleHeight = 0;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, viewportHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          if (visibleHeight > maxVisibleHeight) {
+            maxVisibleHeight = visibleHeight;
+            bestId = section.id;
+          }
+        }
+
+        return bestId;
+      }
+
+      function updateActiveNav() {
+        const activeId = getActiveSectionId();
+        setActiveSection(activeId);
+      }
+
+      // Click listener for immediate feedback when clicking a nav anchor
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').slice(1);
+          setActiveSection(targetId);
+        });
+      });
+
+      // IntersectionObserver + scroll/resize listeners for comprehensive reactivity
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveNav();
+          },
+          {
+            root: null,
+            rootMargin: '-15% 0px -45% 0px',
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      window.addEventListener('scroll', updateActiveNav, { passive: true });
+      window.addEventListener('resize', updateActiveNav, { passive: true });
+      window.addEventListener('hashchange', () => {
+        const hashId = window.location.hash.replace(/^#/, '');
+        if (hashId && sections.some((s) => s.id === hashId)) {
+          setActiveSection(hashId);
+        } else {
+          updateActiveNav();
+        }
+      });
+
+      updateActiveNav();
+    })();
+  </script>
+
 </body>
 
