+
+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['title', 'description', 'href', 'link', 'action-url', 'action-text', 'link-text', 'badge', 'limited'];
+      }
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        const template = document.getElementById('drink-card-template');
+        this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+        this._badgeWrapper = this.shadowRoot.querySelector('.badge-wrapper');
+        this._badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        this._titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        this._descSlot = this.shadowRoot.querySelector('slot[name="description"]');
+        this._actionLink = this.shadowRoot.querySelector('a.btn');
+
+        this._badgeSlot.addEventListener('slotchange', () => this._sync());
+      }
+
+      connectedCallback() {
+        this._sync();
+      }
+
+      attributeChangedCallback() {
+        this._sync();
+      }
+
+      _sync() {
+        if (!this.shadowRoot) return;
+
+        // Title fallback when no slotted title is provided
+        if (this._titleSlot.assignedNodes().length === 0) {
+          this._titleSlot.textContent = this.getAttribute('title') || '';
+        }
+
+        // Description fallback when no slotted description is provided
+        if (this._descSlot.assignedNodes().length === 0) {
+          this._descSlot.textContent = this.getAttribute('description') || '';
+        }
+
+        // Action link fallback when no slotted action is provided
+        const href = this.getAttribute('href') || this.getAttribute('link') || this.getAttribute('action-url') || '#';
+        const actionText = this.getAttribute('action-text') || this.getAttribute('link-text') || 'View Details';
+        if (this._actionLink) {
+          this._actionLink.setAttribute('href', href);
+          this._actionLink.textContent = actionText;
+        }
+
+        // Optional "Limited" badge handling (via attributes or slot)
+        const slottedBadgeNodes = this._badgeSlot.assignedNodes().filter(
+          node => node.nodeType === Node.ELEMENT_NODE || (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+        );
+        const hasSlottedBadge = slottedBadgeNodes.length > 0;
+        const badgeAttr = this.getAttribute('badge');
+        const hasLimitedAttr = this.hasAttribute('limited') && this.getAttribute('limited') !== 'false';
+        const hasBadgeAttr = this.hasAttribute('badge') && badgeAttr !== 'false' && badgeAttr !== '';
+
+        if (!hasSlottedBadge) {
+          this._badgeSlot.textContent = (hasBadgeAttr && badgeAttr !== 'true') ? badgeAttr : 'Limited';
+        }
+
+        const showBadge = hasSlottedBadge || hasLimitedAttr || hasBadgeAttr;
+        this._badgeWrapper.classList.toggle('has-badge', showBadge);
+        this._badgeWrapper.hidden = !showBadge;
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
