+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      @layer base, theme;
+
+      @layer base {
+        :host {
+          display: block;
+          container-type: inline-size;
+          --_card-bg: var(--card-bg, white);
+          --_card-fg: var(--card-fg, var(--text, #3e2723));
+          --_card-primary: var(--card-primary, var(--primary, #4e342e));
+          --_card-primary-hover: var(--card-primary-hover, #3e2723);
+          --_card-accent: var(--card-accent, var(--accent, #ffab40));
+          --_card-radius: var(--card-radius, 8px);
+          --_card-shadow: var(--card-shadow, 0 2px 5px rgba(0, 0, 0, 0.1));
+        }
+
+        .card {
+          position: relative;
+          height: 100%;
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+          align-items: center;
+          background: var(--_card-bg);
+          color: var(--_card-fg);
+          padding: 20px;
+          border-radius: var(--_card-radius);
+          box-shadow: var(--_card-shadow);
+          text-align: center;
+          box-sizing: border-box;
+        }
+
+        .badge {
+          display: inline-block;
+          background: var(--_card-accent);
+          color: var(--_card-fg);
+          font-size: 0.75rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.05em;
+          padding: 2px 10px;
+          border-radius: 999px;
+          margin-bottom: 8px;
+        }
+
+        .badge[hidden] {
+          display: none;
+        }
+
+        .title {
+          margin: 0 0 10px;
+          color: var(--_card-primary);
+          font-size: 1.17rem;
+        }
+
+        ::slotted([slot="title"]) {
+          margin: 0;
+          color: inherit;
+          font: inherit;
+        }
+
+        .description {
+          margin: 0;
+        }
+
+        ::slotted([slot="description"]) {
+          margin: 0;
+        }
+
+        .actions {
+          margin-top: 15px;
+        }
+
+        .btn,
+        ::slotted([slot="action"]) {
+          display: inline-block;
+          background: var(--_card-primary);
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          font: inherit;
+          transition: background 0.3s;
+        }
+
+        .btn:hover,
+        ::slotted([slot="action"]:hover) {
+          background: var(--_card-primary-hover);
+        }
+
+        @container (min-width: 22rem) {
+          .card {
+            padding: 24px;
+          }
+        }
+      }
+
+      @layer theme {
+        :host(:state(limited)) .card {
+          outline: 1px solid var(--_card-accent);
+        }
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card" part="card" aria-labelledby="card-title" aria-describedby="card-desc">
+        <div class="badge" part="badge" hidden>
+          <slot name="badge"><span class="badge-text">Limited</span></slot>
+        </div>
+        <h3 id="card-title" class="title" part="heading">
+          <slot name="title"><span class="title-text"></span></slot>
+        </h3>
+        <div id="card-desc" class="description" part="description">
+          <slot name="description"><slot><p class="description-text"></p></slot></slot>
+        </div>
+        <div class="actions">
+          <slot name="action">
+            <a class="btn" part="action" href="/menu">View Details</a>
+          </slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = [
+        'limited',
+        'badge',
+        'heading',
+        'description',
+        'href',
+        'action-label',
+      ];
+
+      #internals;
+      #badgeEl;
+      #badgeTextEl;
+      #badgeSlot;
+      #titleTextEl;
+      #descTextEl;
+      #actionEl;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        this.#badgeEl = this.shadowRoot.querySelector('.badge');
+        this.#badgeTextEl = this.shadowRoot.querySelector('.badge-text');
+        this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        this.#titleTextEl = this.shadowRoot.querySelector('.title-text');
+        this.#descTextEl = this.shadowRoot.querySelector('.description-text');
+        this.#actionEl = this.shadowRoot.querySelector('.btn');
+
+        this.#badgeSlot.addEventListener('slotchange', () => {
+          this.#syncBadge();
+        });
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(on) {
+        this.toggleAttribute('limited', Boolean(on));
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(v) {
+        v ? this.setAttribute('badge', v) : this.removeAttribute('badge');
+      }
+
+      get heading() {
+        return this.getAttribute('heading') ?? '';
+      }
+
+      set heading(v) {
+        v ? this.setAttribute('heading', v) : this.removeAttribute('heading');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(v) {
+        v ? this.setAttribute('description', v) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+
+      set href(v) {
+        v ? this.setAttribute('href', v) : this.removeAttribute('href');
+      }
+
+      get actionLabel() {
+        return this.getAttribute('action-label') ?? '';
+      }
+
+      set actionLabel(v) {
+        v ? this.setAttribute('action-label', v) : this.removeAttribute('action-label');
+      }
+
+      connectedCallback() {
+        this.#render();
+      }
+
+      connectedMoveCallback() {
+        // Preserve state across Node.moveBefore() relocations without re-running full setup.
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#render();
+        }
+      }
+
+      #syncBadge() {
+        const slottedNodes = this.#badgeSlot
+          .assignedNodes({ flatten: false })
+          .filter(
+            (node) =>
+              node.nodeType === Node.ELEMENT_NODE ||
+              (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+          );
+        const hasSlottedBadge = slottedNodes.length > 0;
+        const badgeAttr = this.getAttribute('badge');
+        const hasAttrBadge =
+          this.limited || (badgeAttr !== null && badgeAttr !== '' && badgeAttr !== 'false');
+        const showBadge = hasSlottedBadge || hasAttrBadge;
+
+        this.#badgeTextEl.textContent = badgeAttr || 'Limited';
+        this.#badgeEl.hidden = !showBadge;
+
+        if (showBadge) {
+          this.#internals.states.add('limited');
+        } else {
+          this.#internals.states.delete('limited');
+        }
+      }
+
+      #render() {
+        this.#titleTextEl.textContent = this.heading;
+        this.#descTextEl.textContent = this.description;
+        this.#actionEl.href = this.href || '/menu';
+        this.#actionEl.textContent = this.actionLabel || 'View Details';
+        this.#syncBadge();
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
