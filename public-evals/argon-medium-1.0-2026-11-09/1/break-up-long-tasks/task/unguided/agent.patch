+      `;
+
+      let worker = null;
+      let isRunning = false;
+      let currentRunId = 0;
+
+      function createSimulatorWorker() {
+        try {
+          const w = new Worker('simulator-worker.js');
+          w.onerror = function (err) {
+            if (err && typeof err.preventDefault === 'function') err.preventDefault();
+            fallbackToBlobWorker();
+          };
+          executionModeEl.textContent = 'Web Worker (Off-Main-Thread)';
+          return w;
+        } catch (e) {
+          return createBlobWorker();
+        }
+      }
+
+      function createBlobWorker() {
+        try {
+          const blob = new Blob([WORKER_SOURCE], { type: 'application/javascript' });
+          const url = URL.createObjectURL(blob);
+          const w = new Worker(url);
+          executionModeEl.textContent = 'Web Worker (Blob Thread)';
+          return w;
+        } catch (err) {
+          executionModeEl.textContent = 'Async Time-Sliced Scheduler';
+          return createAsyncChunkRunner();
+        }
+      }
+
+      function createAsyncChunkRunner() {
+        const fakeSelf = {
+          onmessage: null,
+          postMessage: function (data) {
+            if (typeof runner.onmessage === 'function') {
+              setTimeout(function () {
+                runner.onmessage({ data: data });
+              }, 0);
+            }
+          }
+        };
+        const fn = new Function('self', WORKER_SOURCE);
+        fn(fakeSelf);
+        const runner = {
+          onmessage: null,
+          postMessage: function (msg) {
+            if (typeof fakeSelf.onmessage === 'function') {
+              setTimeout(function () {
+                fakeSelf.onmessage({ data: msg });
+              }, 0);
+            }
+          },
+          terminate: function () {
+            if (typeof fakeSelf.onmessage === 'function') {
+              fakeSelf.onmessage({ data: { type: 'cancel' } });
+            }
+          }
+        };
+        return runner;
+      }
+
+      function fallbackToBlobWorker() {
+        if (worker) {
+          try { worker.terminate(); } catch (_) {}
+        }
+        worker = createBlobWorker();
+        if (worker) {
+          worker.onmessage = handleWorkerMessage;
+          if (isRunning) {
+            worker.postMessage({
+              type: 'start',
+              runId: currentRunId,
+              config: getFormConfig()
+            });
+          }
+        }
+      }
+
+      function updateFlavorMeters(averages) {
+        if (!averages) return;
+        const metrics = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+        metrics.forEach(function (key) {
+          const val = Number(averages[key]) || 0;
+          const scoreEl = document.getElementById('score-' + key);
+          const barEl = document.getElementById('bar-' + key);
+          if (scoreEl) scoreEl.textContent = val.toFixed(1) + ' / 100';
+          if (barEl) barEl.style.width = Math.min(100, Math.max(0, val)) + '%';
+        });
