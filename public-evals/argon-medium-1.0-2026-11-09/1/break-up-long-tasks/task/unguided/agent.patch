+                  topBlends.sort((a, b) => b.matchScore - a.matchScore);
+                  if (topBlends.length > 6) topBlends.pop();
+                }
+              }
+              processed = limit;
+              const percent = Math.round((processed / totalBlends) * 100);
+              const elapsedMs = Math.round(performance.now() - startTime);
+              self.postMessage({
+                type: 'progress',
+                runId,
+                processed,
+                total: totalBlends,
+                percent,
+                elapsedMs,
+                averages: {
+                  acidity: Math.round((sumAcidity / processed) * 10) / 10,
+                  body: Math.round((sumBody / processed) * 10) / 10,
+                  sweetness: Math.round((sumSweetness / processed) * 10) / 10,
+                  bitterness: Math.round((sumBitterness / processed) * 10) / 10,
+                  aroma: Math.round((sumAroma / processed) * 10) / 10,
+                  matchScore: Math.round((sumScore / processed) * 10) / 10
