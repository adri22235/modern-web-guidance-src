+          return {
+            id: 'BLD-' + String(index + 1).padStart(5, '0'),
+            composition: primaryRatio + '% ' + primaryOrigin.name.split(' ')[0] + ' / ' + secondaryRatio + '% ' + secondaryOrigin.name.split(' ')[0] + ' / ' + tertiaryRatio + '% ' + tertiaryOrigin.name.split(' ')[0],
+            tempC,
+            acidity,
+            body,
+            sweetness,
+            bitterness,
+            aroma,
