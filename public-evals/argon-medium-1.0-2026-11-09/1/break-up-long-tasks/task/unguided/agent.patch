+              });
+              if (processed < totalBlends) {
+                setTimeout(processChunk, 12);
+              } else {
+                self.postMessage({
+                  type: 'complete',
+                  runId,
+                  processed,
+                  total: totalBlends,
+                  elapsedMs: Math.max(1, Math.round(performance.now() - startTime)),
+                  averages: {
+                    acidity: Math.round((sumAcidity / totalBlends) * 10) / 10,
+                    body: Math.round((sumBody / totalBlends) * 10) / 10,
+                    sweetness: Math.round((sumSweetness / totalBlends) * 10) / 10,
+                    bitterness: Math.round((sumBitterness / totalBlends) * 10) / 10,
+                    aroma: Math.round((sumAroma / totalBlends) * 10) / 10,
+                    matchScore: Math.round((sumScore / totalBlends) * 10) / 10
