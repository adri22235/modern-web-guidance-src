+          const body = clamp((primaryOrigin.body * pW + secondaryOrigin.body * sW + tertiaryOrigin.body * tW) * roastMod.body * brewMod.body * extractionFactor, 10, 99);
+          const sweetness = clamp((primaryOrigin.sweetness * pW + secondaryOrigin.sweetness * sW + tertiaryOrigin.sweetness * tW) * roastMod.sweetness * brewMod.sweetness * curveBoost, 10, 99);
+          const bitterness = clamp((primaryOrigin.bitterness * pW + secondaryOrigin.bitterness * sW + tertiaryOrigin.bitterness * tW) * roastMod.bitterness * brewMod.bitterness * extractionFactor, 5, 95);
