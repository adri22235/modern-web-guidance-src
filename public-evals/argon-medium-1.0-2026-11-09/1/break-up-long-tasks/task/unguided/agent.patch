+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+          statusEl.textContent = 'Simulation cancelled by user';
+          return;
+        }
+
+        if (msg.runId && msg.runId !== currentRunId) return;
+
+        if (msg.type === 'progress') {
