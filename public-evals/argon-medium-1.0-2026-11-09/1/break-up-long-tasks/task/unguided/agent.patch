+          balanced: { acidity: 72, body: 76, sweetness: 84, bitterness: 44, aroma: 86 },
+          fruity: { acidity: 88, body: 64, sweetness: 86, bitterness: 32, aroma: 92 },
+          bold: { acidity: 54, body: 92, sweetness: 74, bitterness: 66, aroma: 84 },
+          sweet: { acidity: 66, body: 78, sweetness: 92, bitterness: 38, aroma: 88 }
+        };
+        let activeRunId = null;
+        function clamp(val, min, max) { return Math.max(min, Math.min(max, val)); }
+        function nextRand(seed) {
+          let t = (seed += 0x6D2B79F5);
+          t = Math.imul(t ^ (t >>> 15), t | 1);
+          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
