+      }
+
+      function getFormConfig() {
+        return {
+          batchSize: Math.max(100, Math.min(200000, Number(batchInput.value) || 12000)),
+          origin: originSelect.value,
+          roast: roastSelect.value,
+          brew: brewSelect.value,
+          target: targetSelect.value
