+  <script type="module">
+    const ORIGINS = [
+      { name: 'Ethiopian Yirgacheffe', acidity: 92, body: 52, sweetness: 84, aroma: 95, bitterness: 28, notes: ['Floral', 'Citrus', 'Bergamot'] },
+      { name: 'Colombian Supremo', acidity: 68, body: 74, sweetness: 82, aroma: 78, bitterness: 42, notes: ['Caramel', 'Nutty', 'Cocoa'] },
+      { name: 'Sumatra Mandheling', acidity: 38, body: 94, sweetness: 64, aroma: 80, bitterness: 66, notes: ['Earthy', 'Dark Chocolate', 'Spice'] },
+      { name: 'Guatemala Antigua', acidity: 74, body: 78, sweetness: 79, aroma: 86, bitterness: 45, notes: ['Cocoa', 'Citrus', 'Spice'] },
+      { name: 'Brazil Cerrado', acidity: 48, body: 82, sweetness: 86, aroma: 72, bitterness: 50, notes: ['Nutty', 'Caramel', 'Dark Chocolate'] },
+      { name: 'Kenya AA', acidity: 95, body: 68, sweetness: 77, aroma: 91, bitterness: 34, notes: ['Berry', 'Citrus', 'Floral'] }
+    ];
+
+    const ROAST_MODIFIERS = {
+      light: { acidity: 1.12, body: 0.9, sweetness: 1.04, aroma: 1.1, bitterness: 0.8 },
+      medium: { acidity: 1.0, body: 1.0, sweetness: 1.08, aroma: 1.02, bitterness: 0.95 },
+      dark: { acidity: 0.78, body: 1.16, sweetness: 0.92, aroma: 0.96, bitterness: 1.25 }
+    };
+
+    const TASTING_FILTERS = ['All Notes', 'Caramel', 'Citrus', 'Cocoa', 'Floral', 'Nutty', 'Dark Chocolate'];
+    let currentFilterIndex = 0;
+    let latestTopBlends = [];
+
+    const batchSizeSelect = document.getElementById('batch-size');
+    const roastStyleSelect = document.getElementById('roast-style');
+    const acidityInput = document.getElementById('target-acidity');
+    const bodyInput = document.getElementById('target-body');
+    const sweetnessInput = document.getElementById('target-sweetness');
+    const acidityVal = document.getElementById('acidity-val');
+    const bodyVal = document.getElementById('body-val');
+    const sweetnessVal = document.getElementById('sweetness-val');
+    const runBtn = document.getElementById('run-simulation-btn');
+    const noteBtn = document.getElementById('tasting-note-btn');
+    const activeNoteLabel = document.getElementById('active-note-label');
+    const statusEl = document.getElementById('simulation-status');
+    const progressFill = document.getElementById('progress-fill');
+    const progressPercent = document.getElementById('progress-percent');
+    const progressBar = document.getElementById('simulation-progressbar');
+    const statProcessed = document.getElementById('stat-processed');
+    const statTopScore = document.getElementById('stat-top-score');
+    const statYields = document.getElementById('stat-yields');
+    const statDuration = document.getElementById('stat-duration');
+    const resultsContainer = document.getElementById('blend-results');
+
+    function syncSliderLabels() {
+      acidityVal.textContent = acidityInput.value;
+      bodyVal.textContent = bodyInput.value;
+      sweetnessVal.textContent = sweetnessInput.value;
+    }
+
+    acidityInput.addEventListener('input', syncSliderLabels);
+    bodyInput.addEventListener('input', syncSliderLabels);
+    sweetnessInput.addEventListener('input', syncSliderLabels);
+
+    noteBtn.addEventListener('click', () => {
+      currentFilterIndex = (currentFilterIndex + 1) % TASTING_FILTERS.length;
+      activeNoteLabel.textContent = TASTING_FILTERS[currentFilterIndex];
+      renderTopBlends(latestTopBlends);
+    });
+
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        await window.scheduler.yield();
+      } else {
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+    }
+
+    function generateRecipeBatch(count, roastKey) {
+      const recipes = [];
+      for (let i = 0; i < count; i++) {
+        const primaryIdx = i % ORIGINS.length;
+        const secondaryIdx = (i * 3 + 1) % ORIGINS.length;
+        const tertiaryIdx = (i * 5 + 2) % ORIGINS.length;
+
+        const w1 = 40 + ((i * 17) % 35);
+        const w2 = 15 + ((i * 23) % (85 - w1));
+        const w3 = 100 - w1 - w2;
+
+        recipes.push({
+          id: i + 1,
+          name: `Blend #${String(i + 1).padStart(4, '0')}`,
+          roast: roastKey,
+          components: [
+            { origin: ORIGINS[primaryIdx], ratio: w1 },
+            { origin: ORIGINS[secondaryIdx], ratio: w2 },
+            { origin: ORIGINS[tertiaryIdx], ratio: w3 }
+          ],
+          brewTempC: 90 + (i % 7),
+          extractionSeconds: 24 + (i % 12)
+        });
+      }
+      return recipes;
+    }
+
+    function simulateBlendFlavorProfile(recipe, targetProfile) {
+      const modifier = ROAST_MODIFIERS[recipe.roast] || ROAST_MODIFIERS.medium;
+      let rawAcidity = 0;
+      let rawBody = 0;
+      let rawSweetness = 0;
+      let rawAroma = 0;
+      let rawBitterness = 0;
+      const notesSet = new Set();
+
+      for (const comp of recipe.components) {
+        const weight = comp.ratio / 100;
+        rawAcidity += comp.origin.acidity * weight;
+        rawBody += comp.origin.body * weight;
+        rawSweetness += comp.origin.sweetness * weight;
+        rawAroma += comp.origin.aroma * weight;
+        rawBitterness += comp.origin.bitterness * weight;
+        for (const note of comp.origin.notes) {
+          notesSet.add(note);
+        }
+      }
+
+      // Multi-step extraction curve simulation (thermal & solubility modeling)
+      let extractionFactor = 1;
+      for (let step = 1; step <= 180; step++) {
+        const tempCurve = Math.sin((recipe.brewTempC * step) / 180) * 0.015;
+        const timeCurve = Math.cos((recipe.extractionSeconds * step) / 120) * 0.012;
+        extractionFactor += (tempCurve - timeCurve) / 180;
+      }
+
+      const clamp = val => Math.max(0, Math.min(100, Math.round(val)));
+      const acidity = clamp(rawAcidity * modifier.acidity * extractionFactor);
+      const body = clamp(rawBody * modifier.body * extractionFactor);
+      const sweetness = clamp(rawSweetness * modifier.sweetness * extractionFactor);
+      const aroma = clamp(rawAroma * modifier.aroma * extractionFactor);
+      const bitterness = clamp(rawBitterness * modifier.bitterness / extractionFactor);
+
+      const diffAcidity = Math.abs(acidity - targetProfile.acidity);
+      const diffBody = Math.abs(body - targetProfile.body);
+      const diffSweetness = Math.abs(sweetness - targetProfile.sweetness);
+
+      const harmonyBonus = (aroma * 0.15) - (bitterness * 0.08);
+      const matchScore = clamp(
+        100 - (diffAcidity * 0.35 + diffBody * 0.35 + diffSweetness * 0.3) + harmonyBonus * 0.25
+      );
+
+      return {
+        id: recipe.id,
+        name: recipe.name,
+        composition: recipe.components
+          .map(c => `${c.ratio}% ${c.origin.name}`)
+          .join(' • '),
+        acidity,
+        body,
+        sweetness,
+        aroma,
+        bitterness,
+        notes: Array.from(notesSet),
+        matchScore
+      };
+    }
+
+    function updateProgressUI(processed, total, yieldCount, elapsedMs) {
+      const pct = total > 0 ? Math.round((processed / total) * 100) : 0;
+      progressFill.style.width = `${pct}%`;
+      progressPercent.textContent = `${pct}%`;
+      progressBar.setAttribute('aria-valuenow', String(pct));
+      statProcessed.textContent = processed.toLocaleString();
+      statYields.textContent = String(yieldCount);
+      statDuration.textContent = `${Math.round(elapsedMs)} ms`;
+    }
+
+    function renderTopBlends(blends) {
+      const selectedNote = TASTING_FILTERS[currentFilterIndex];
+      const filtered = selectedNote === 'All Notes'
+        ? blends
+        : blends.filter(b => b.notes.includes(selectedNote));
+      const topItems = filtered.slice(0, 6);
+
+      if (topItems.length === 0) {
+        resultsContainer.innerHTML = '<p>No simulated blends match the selected tasting note filter.</p>';
+        return;
+      }
+
+      resultsContainer.innerHTML = topItems.map(blend => `
+        <article class="blend-card">
+          <div class="blend-card-header">
+            <h3>${blend.name}</h3>
+            <span class="blend-score">${blend.matchScore}% Match</span>
+          </div>
+          <p class="blend-composition">${blend.composition}</p>
+          <p class="blend-composition"><strong>Notes:</strong> ${blend.notes.join(', ')}</p>
+          <div class="flavor-bars">
+            <div class="flavor-row">
+              <span>Acidity</span>
+              <div class="flavor-meter"><div class="flavor-meter-fill" style="width: ${blend.acidity}%"></div></div>
+              <span>${blend.acidity}</span>
+            </div>
+            <div class="flavor-row">
+              <span>Body</span>
+              <div class="flavor-meter"><div class="flavor-meter-fill" style="width: ${blend.body}%"></div></div>
+              <span>${blend.body}</span>
+            </div>
+            <div class="flavor-row">
+              <span>Sweetness</span>
+              <div class="flavor-meter"><div class="flavor-meter-fill" style="width: ${blend.sweetness}%"></div></div>
+              <span>${blend.sweetness}</span>
+            </div>
+            <div class="flavor-row">
+              <span>Aroma</span>
+              <div class="flavor-meter"><div class="flavor-meter-fill" style="width: ${blend.aroma}%"></div></div>
+              <span>${blend.aroma}</span>
+            </div>
+          </div>
+        </article>
+      `).join('');
+    }
+
+    async function processRecipeBatch(recipes, targetProfile) {
+      const startTime = performance.now();
+      let deadline = performance.now() + 50;
+      let yieldCount = 0;
+      const evaluated = [];
+
+      for (let i = 0; i < recipes.length; i++) {
+        evaluated.push(simulateBlendFlavorProfile(recipes[i], targetProfile));
+
+        if (performance.now() >= deadline) {
+          yieldCount++;
+          updateProgressUI(i + 1, recipes.length, yieldCount, performance.now() - startTime);
+          await yieldToMain();
+          deadline = performance.now() + 50;
+        }
+      }
+
+      evaluated.sort((a, b) => b.matchScore - a.matchScore);
+      const totalDuration = performance.now() - startTime;
+      updateProgressUI(recipes.length, recipes.length, yieldCount, totalDuration);
+      return evaluated;
+    }
+
+    async function runBatchSimulation() {
+      const batchSize = Number(batchSizeSelect.value) || 2500;
+      const roastKey = roastStyleSelect.value;
+      const targetProfile = {
+        acidity: Number(acidityInput.value),
+        body: Number(bodyInput.value),
+        sweetness: Number(sweetnessInput.value)
+      };
+
+      // Immediate synchronous UI feedback before batch work begins
+      runBtn.disabled = true;
+      statusEl.textContent = `Simulating ${batchSize.toLocaleString()} recipe blends...`;
+      updateProgressUI(0, batchSize, 0, 0);
+
+      await yieldToMain();
+
+      const recipes = generateRecipeBatch(batchSize, roastKey);
+      const rankedBlends = await processRecipeBatch(recipes, targetProfile);
+
+      latestTopBlends = rankedBlends.slice(0, 30);
+      statTopScore.textContent = rankedBlends.length > 0 ? `${rankedBlends[0].matchScore}%` : '—';
+      renderTopBlends(latestTopBlends);
+
+      statusEl.textContent = `Completed ${batchSize.toLocaleString()} blend simulations smoothly.`;
+      runBtn.disabled = false;
+    }
+
+    runBtn.addEventListener('click', runBatchSimulation);
+
+    // Run an initial batch simulation once loaded
+    runBatchSimulation();
+  </script>
+
 </body>
 
