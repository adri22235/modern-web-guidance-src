+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const messageEl = document.getElementById('newsletter-message');
+
+      const DEFAULT_FAILURE_MSG =
+        'Sorry, your request could not go through. Please try again later.';
+
+      function showCustomerMessage(text, status) {
+        if (!messageEl) return;
+        messageEl.textContent = text;
+        messageEl.className = 'newsletter-message ' + (status === 'success' ? 'success' : 'error');
+        messageEl.hidden = false;
+        messageEl.style.display = 'block';
+      }
+
+      document.addEventListener('securitypolicyviolation', function () {
+        showCustomerMessage(
+          'Sorry, your request could not go through because external connections are not allowed.',
+          'error'
+        );
+      });
+
+      if (typeof window.fetch === 'function') {
+        const nativeFetch = window.fetch.bind(window);
+        window.fetch = function () {
+          return nativeFetch.apply(window, arguments).catch(function (err) {
+            showCustomerMessage(DEFAULT_FAILURE_MSG, 'error');
+            throw err;
+          });
+        };
+      }
+
+      if (typeof window.XMLHttpRequest === 'function') {
+        const nativeSend = window.XMLHttpRequest.prototype.send;
+        window.XMLHttpRequest.prototype.send = function () {
+          this.addEventListener('error', function () {
+            showCustomerMessage(DEFAULT_FAILURE_MSG, 'error');
+          });
+          return nativeSend.apply(this, arguments);
+        };
+      }
+
+      if (form) {
+        form.addEventListener('submit', async function (event) {
+          event.preventDefault();
+          const email = emailInput ? emailInput.value.trim() : '';
+          if (!email) {
+            showCustomerMessage('Please enter a valid email address.', 'error');
+            return;
+          }
+
+          const endpoint = form.getAttribute('action') || '/subscribe';
+
+          try {
+            const response = await window.fetch(endpoint, {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json',
+                'Accept': 'application/json'
+              },
+              body: JSON.stringify({ email: email })
+            });
+
+            let payload = null;
+            try {
+              payload = await response.json();
+            } catch (_) {
+              payload = null;
+            }
+
+            if (!response.ok || (payload && payload.ok === false)) {
+              showCustomerMessage(
+                (payload && (payload.error || payload.message)) || DEFAULT_FAILURE_MSG,
+                'error'
+              );
+              return;
+            }
+
+            showCustomerMessage(
+              (payload && payload.message) || 'Thank you for subscribing to The Daily Grind newsletter!',
+              'success'
+            );
+            form.reset();
+          } catch (_) {
+            showCustomerMessage(DEFAULT_FAILURE_MSG, 'error');
+          }
+        });
+      }
+    })();
+  </script>
+
