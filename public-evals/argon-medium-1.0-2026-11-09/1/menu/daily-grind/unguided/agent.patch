+          event.preventDefault();
+          focusItemAt(items.length - 1);
+        } else if (event.key === 'ArrowRight') {
+          if (target.hasAttribute('aria-haspopup')) {
+            event.preventDefault();
+            openSubmenu(target, true);
+          }
+        } else if (event.key === 'ArrowLeft' || event.key === 'Escape') {
+          event.preventDefault();
+          const parentTrigger = document.querySelector(`[aria-controls="${currentContainer.id}"]`);
+          if (parentTrigger) {
+            closeSubmenu(parentTrigger);
+            parentTrigger.focus();
+          } else {
+            closeAllMenusExcept(null);
+          }
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          handleMenuItemAction(target, event);
+        } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          // First-character typeahead navigation
+          const char = event.key.toLowerCase();
+          const ordered = items.slice(currentIndex + 1).concat(items.slice(0, currentIndex + 1));
+          const match = ordered.find((el) => el.textContent.trim().toLowerCase().startsWith(char));
+          if (match) {
+            event.preventDefault();
+            focusItemAt(items.indexOf(match));
+          }
+        }
+      });
+    })();
+  </script>
