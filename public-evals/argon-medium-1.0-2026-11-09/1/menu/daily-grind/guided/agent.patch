+          if (returningFromSubmenu.has(trigger)) {
+            returningFromSubmenu.delete(trigger);
+            return;
+          }
+          if (!isOpen(menu)) {
+            showMenuPopover(menu, trigger);
+          }
+        });
+
+        trigger.addEventListener('blur', event => {
+          const next = event.relatedTarget;
+          if (next && (next === trigger || menu.contains(next))) return;
+          if (isOpen(menu)) {
+            menu.hidePopover();
+          }
+        });
+
+        trigger.addEventListener('pointerleave', event => {
+          clearTimeout(hoverPreviewTimer);
+          startBridge(menu, event);
+        });
+
+        trigger._setHoverPreviewTimer = fn => {
+          clearTimeout(hoverPreviewTimer);
+          hoverPreviewTimer = setTimeout(fn, 80);
+        };
+      }
+
+      // Sync aria-expanded and focus movement on popover toggle
+      menu.addEventListener('toggle', () => {
+        const open = isOpen(menu);
+        trigger.setAttribute('aria-expanded', String(open));
+        if (!open) return;
+
+        positionMenuFallback(menu);
+
+        if (enterOnOpen.has(menu)) {
+          enterOnOpen.delete(menu);
+          enabledItemsFor(menu)[0]?.focus({ preventScroll: true });
+        } else if (!isSubmenuTrigger(trigger)) {
+          trigger.focus({ focusVisible: false, preventScroll: true });
+        }
+      });
+
+      // Escape, ArrowLeft, and Tab inside a menu
+      menu.addEventListener('keydown', event => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu, { fromPointer: false });
+        } else if (event.key === 'ArrowLeft' && isSubmenuTrigger(trigger)) {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu, { fromPointer: false });
+        } else if (event.key === 'Tab') {
+          const root = rootMenuFor(menu);
+          if (root && isOpen(root)) {
+            root.hidePopover();
+          }
+        }
+      });
+    });
+
+    // 7. Menu item pointer hover, sibling submenu closing, and activation
+    function updateCardSummary(card) {
+      if (!card) return;
+      const summaryEl = card.querySelector('[data-summary]');
+      if (!summaryEl) return;
+      const selected = [...card.querySelectorAll('button[aria-checked="true"]')]
+        .map(btn => btn.dataset.option || btn.textContent.trim());
+      summaryEl.textContent = selected.length ? selected.join(' · ') : 'Standard recipe';
+    }
+
+    function announce(message) {
+      if (statusBanner) {
+        statusBanner.textContent = message;
+      }
+    }
+
+    document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+      // Close sibling previewed submenus when focus moves to another item in this focusgroup
+      group.addEventListener('focusin', event => {
+        const target = event.target;
+        if (target.closest('[focusgroup~="menu"]') !== group) return;
+        group.querySelectorAll(':scope > [popover]').forEach(sub => {
+          const subTrigger = triggerFor(sub);
+          if (subTrigger !== target && !sub.contains(target) && isOpen(sub)) {
+            sub.hidePopover();
+          }
+        });
+      });
+
+      const ownButtons = [...group.querySelectorAll('button')].filter(
+        btn => btn.closest('[focusgroup~="menu"]') === group
+      );
+
+      ownButtons.forEach(item => {
+        // Hover follows focus without painting a keyboard focus ring
+        item.addEventListener('pointermove', event => {
+          const hit = document.elementFromPoint(event.clientX, event.clientY);
+          if (!hit || !item.contains(hit)) return;
+          if (item.hasAttribute('commandfor')) {
+            if (document.activeElement !== item && item._setHoverPreviewTimer) {
+              item._setHoverPreviewTimer(() => {
+                item.focus({ focusVisible: false, preventScroll: true });
+              });
+            }
+          } else if (document.activeElement !== item) {
+            item.focus({ focusVisible: false, preventScroll: true });
+          }
+        });
+
+        // Skip command activation for submenu triggers
+        if (item.hasAttribute('commandfor')) return;
+
+        item.addEventListener('pointerdown', event => {
+          event.preventDefault();
+        });
+
+        item.addEventListener('keydown', event => {
+          lastKeyByItem.set(item, event.key);
+        });
+
+        item.addEventListener('click', event => {
+          const fromPointer = event.detail > 0;
+          const lastKey = lastKeyByItem.get(item);
+          lastKeyByItem.delete(item);
+
+          const role = item.getAttribute('role');
+          const rootMenu = rootMenuFor(item);
+          const card = item.closest('.card');
+          const drinkName = card?.dataset.drink;
+
+          if (role === 'menuitemcheckbox') {
+            const nextChecked = item.getAttribute('aria-checked') !== 'true';
+            item.setAttribute('aria-checked', String(nextChecked));
+            const label = item.dataset.option || item.textContent.trim();
+            updateCardSummary(card);
+            announce(
+              `${drinkName ? `${drinkName}: ` : ''}${label} ${nextChecked ? 'enabled' : 'disabled'}.`
+            );
+            // Space on menuitemcheckbox toggles and keeps the menu open; Enter or pointer closes after ~300ms
+            if (!fromPointer && lastKey === ' ') return;
+            setTimeout(() => {
+              closeAndRestore(rootMenu, { fromPointer });
+            }, 300);
+          } else if (role === 'menuitemradio') {
+            const radioGroup = item.closest('[role="group"]');
+            if (radioGroup) {
+              radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+                radio.setAttribute('aria-checked', String(radio === item));
+              });
+            } else {
+              item.setAttribute('aria-checked', 'true');
+            }
+            const label = item.dataset.option || item.textContent.trim();
+            updateCardSummary(card);
+            announce(`${drinkName ? `${drinkName}: ` : ''}Selected ${label}.`);
+            setTimeout(() => {
+              closeAndRestore(rootMenu, { fromPointer });
+            }, 300);
+          } else {
+            const actionLabel = item.dataset.action || item.textContent.trim();
+            announce(`${actionLabel}.`);
+            closeAndRestore(rootMenu, { fromPointer });
+          }
+        });
+      });
+    });
+
+    // 8. Close open menus when focus moves outside the menu system
+    document.addEventListener('focusin', event => {
+      const target = event.target;
+      if (
+        target.closest('[popover]:has(> [focusgroup~="menu"])') ||
+        target.closest('button[commandfor]')
+      ) {
+        return;
+      }
+      document.querySelectorAll('[popover]:has(> [focusgroup~="menu"])').forEach(menu => {
+        if (isOpen(menu)) menu.hidePopover();
+      });
+    });
+  </script>
 </body>
 
 </html>
