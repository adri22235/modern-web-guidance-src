+  <script>
+    (function () {
+      const supportsAnchorPositioning =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('anchor-name', '--btn-anchor');
+
+      const buttons = document.querySelectorAll('.card .btn[aria-describedby]');
+
+      function positionTooltipFallback(button, tooltip) {
+        if (supportsAnchorPositioning) return;
+
+        const gap = 10;
+        const btnCenter = button.offsetLeft + button.offsetWidth / 2;
+        const belowTop = button.offsetTop + button.offsetHeight + gap;
+
+        const btnRect = button.getBoundingClientRect();
+        const tooltipHeight = tooltip.offsetHeight || 110;
+        const spaceBelow = window.innerHeight - btnRect.bottom;
+
+        if (spaceBelow < tooltipHeight + gap && btnRect.top > tooltipHeight + gap) {
+          tooltip.style.top = (button.offsetTop - tooltipHeight - gap) + 'px';
+          tooltip.classList.add('flip-above');
+        } else {
+          tooltip.style.top = belowTop + 'px';
+          tooltip.classList.remove('flip-above');
+        }
+
+        tooltip.style.left = btnCenter + 'px';
+      }
+
+      buttons.forEach((button) => {
+        const tooltipId = button.getAttribute('aria-describedby');
+        const tooltip = tooltipId ? document.getElementById(tooltipId) : null;
+        if (!tooltip) return;
+
+        const showTooltip = () => {
+          positionTooltipFallback(button, tooltip);
+          tooltip.classList.add('is-visible');
+          tooltip.setAttribute('aria-hidden', 'false');
+        };
+
+        const hideTooltip = () => {
+          tooltip.classList.remove('is-visible');
+          tooltip.setAttribute('aria-hidden', 'true');
+        };
+
+        button.addEventListener('mouseenter', showTooltip);
+        button.addEventListener('mouseleave', hideTooltip);
+        button.addEventListener('focus', showTooltip);
+        button.addEventListener('blur', hideTooltip);
+
+        button.addEventListener('keydown', (event) => {
+          if (event.key === 'Escape') {
+            hideTooltip();
+            button.blur();
+          }
+        });
+      });
+
+      window.addEventListener('resize', () => {
+        buttons.forEach((button) => {
+          const tooltipId = button.getAttribute('aria-describedby');
+          const tooltip = tooltipId ? document.getElementById(tooltipId) : null;
+          if (tooltip && tooltip.classList.contains('is-visible')) {
+            positionTooltipFallback(button, tooltip);
+          }
+        });
+      });
+    })();
+  </script>
+
