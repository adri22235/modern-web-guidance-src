+  <script type="module">
+    const ownedExpandedTriggers = new WeakSet();
+
+    function normalizeText(value) {
+      return (value || "").replace(/\s+/g, " ").trim();
+    }
+
+    function extractTextWithAlt(node) {
+      let result = "";
+      for (const child of node.childNodes) {
+        if (child.nodeType === Node.TEXT_NODE) {
+          result += child.textContent;
+        } else if (child.nodeType === Node.ELEMENT_NODE) {
+          if (child.tagName === "IMG") {
+            result += ` ${child.getAttribute("alt") || ""} `;
+          } else {
+            result += ` ${extractTextWithAlt(child)} `;
+          }
+        }
+      }
+      return normalizeText(result);
+    }
+
+    function getAccessibleName(el) {
+      const labelledBy = el.getAttribute("aria-labelledby");
+      if (labelledBy) {
+        const text = labelledBy
+          .trim()
+          .split(/\s+/)
+          .map((id) => document.getElementById(id))
+          .filter(Boolean)
+          .map((target) => extractTextWithAlt(target))
+          .join(" ");
+        if (normalizeText(text)) return normalizeText(text);
+      }
+      const ariaLabel = normalizeText(el.getAttribute("aria-label"));
+      if (ariaLabel) return ariaLabel;
+      const contentText = extractTextWithAlt(el);
+      if (contentText) return contentText;
+      return normalizeText(el.getAttribute("title"));
+    }
+
+    function isPopoverOpen(popoverEl) {
+      if (popoverEl.classList.contains(":popover-open")) return true;
+      try {
+        return popoverEl.matches(":popover-open");
+      } catch {
+        return false;
+      }
+    }
+
+    export function wireInterestHints(root = document) {
+      const triggers = root.querySelectorAll("[interestfor]");
+      for (const trigger of triggers) {
+        const targetId = trigger.getAttribute("interestfor");
+        if (!targetId) continue;
+        const hint = document.getElementById(targetId);
+        if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+        const triggerName = getAccessibleName(trigger);
+        const hintText = extractTextWithAlt(hint);
+        if (triggerName && triggerName === hintText) continue;
+
+        if (!hint.hasAttribute("role")) {
+          hint.setAttribute("role", "tooltip");
+        }
+
+        if (!triggerName) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", hint.id);
+          }
+        } else {
+          const opensOnActivation =
+            trigger.getAttribute("popovertarget") === hint.id ||
+            trigger.getAttribute("commandfor") === hint.id;
+          if (opensOnActivation) {
+            if (!trigger.hasAttribute("aria-expanded")) {
+              trigger.setAttribute("aria-expanded", String(isPopoverOpen(hint)));
+              ownedExpandedTriggers.add(trigger);
+            }
+          } else if (!trigger.hasAttribute("aria-describedby")) {
+            trigger.setAttribute("aria-describedby", hint.id);
+          }
+        }
+      }
+    }
+
+    window.wireInterestHints = wireInterestHints;
+    wireInterestHints();
+
+    if ("interestForElement" in HTMLButtonElement.prototype) {
+      document.addEventListener(
+        "toggle",
+        (event) => {
+          const target = event.target;
+          if (!(target instanceof HTMLElement) || !target.id || target.getAttribute("popover") !== "hint") {
+            return;
+          }
+          const openState = event.newState ? event.newState === "open" : isPopoverOpen(target);
+          for (const trigger of document.querySelectorAll(`[interestfor="${CSS.escape(target.id)}"]`)) {
+            if (ownedExpandedTriggers.has(trigger)) {
+              trigger.setAttribute("aria-expanded", String(openState));
+            }
+          }
+        },
+        true
+      );
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const probe = document.createElement("div");
+    probe.popover = "hint";
+    if (probe.popover !== "hint") {
+      document.addEventListener(
+        "beforetoggle",
+        ({ target, newState }) => {
+          const toggletip =
+            target instanceof HTMLElement &&
+            target.getAttribute("popover") === "hint" &&
+            target.id &&
+            document.querySelector(`[popovertarget="${CSS.escape(target.id)}"]`);
+          if (newState === "open" && toggletip) {
+            target.popover = "auto";
+          }
+        },
+        true
+      );
+    }
+
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    if (!CSS.supports("anchor-name: --a")) {
+      await import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+  </script>
+
 </body>
 
