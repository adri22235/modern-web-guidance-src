new file mode 100644
index 0000000..1a60186
--- /dev/null
+++ b/app.js
@@ -0,0 +1,142 @@
+const DEFAULT_SPHERE_COLORS = [
+  0.75, 0.25, 0.25,   // 0: Left Sphere (Wall)
+  0.25, 0.25, 0.75,   // 1: Right Sphere (Wall)
+  0.75, 0.75, 0.75,   // 2: Back Sphere (Wall)
+  0.0,  0.0,  0.0,    // 3: Front Sphere (Behind Camera)
+  0.75, 0.75, 0.75,   // 4: Bottom Sphere (Floor)
+  0.75, 0.75, 0.75,   // 5: Top Sphere (Ceiling)
+  0.999, 0.999, 0.999,// 6: Mirror Sphere
+  0.999, 0.999, 0.999,// 7: Glass Sphere
+  0.0,  0.0,  0.0,    // 8: Light Sphere
+];
+
+const VISIBLE_SPHERES = [
+  { index: 0, name: 'Left Wall Sphere', min: 0.15, max: 0.92 },
+  { index: 1, name: 'Right Wall Sphere', min: 0.15, max: 0.92 },
+  { index: 2, name: 'Back Wall Sphere', min: 0.25, max: 0.92 },
+  { index: 4, name: 'Floor Sphere', min: 0.25, max: 0.92 },
+  { index: 5, name: 'Ceiling Sphere', min: 0.35, max: 0.95 },
+  { index: 6, name: 'Mirror Sphere (SPEC)', min: 0.45, max: 0.999 },
+  { index: 7, name: 'Glass Sphere (REFR)', min: 0.45, max: 0.999 },
+];
+
+const canvas = document.getElementById('smallpt-canvas');
+const ctx = canvas.getContext('2d');
+const randomizeBtn = document.getElementById('randomize-colors-btn');
+const resetBtn = document.getElementById('reset-colors-btn');
+const statusEl = document.getElementById('render-status');
+const swatchesEl = document.getElementById('sphere-swatches');
+
+const worker = new Worker(new URL('./worker.js', import.meta.url), {
+  type: 'module',
+});
+
+let runCounter = 0;
+
+function randomChannel(min, max) {
+  return Number((min + Math.random() * (max - min)).toFixed(3));
+}
+
+function generateRandomizedColors() {
+  const colors = [...DEFAULT_SPHERE_COLORS];
+  for (const sphere of VISIBLE_SPHERES) {
+    const offset = sphere.index * 3;
+    const channels = [
+      randomChannel(sphere.min, sphere.max),
+      randomChannel(sphere.min, sphere.max),
+      randomChannel(sphere.min, sphere.max),
+    ];
+    // Boost contrast so randomized spheres are vivid and distinct
+    const dominant = Math.floor(Math.random() * 3);
+    const secondary = (dominant + 1 + Math.floor(Math.random() * 2)) % 3;
+    channels[dominant] = randomChannel(Math.max(0.65, sphere.min), sphere.max);
+    channels[secondary] = randomChannel(sphere.min, Math.min(0.45, sphere.max));
+
+    colors[offset] = channels[0];
+    colors[offset + 1] = channels[1];
+    colors[offset + 2] = channels[2];
+  }
+  return colors;
+}
+
+function toCssRgb(r, g, b) {
+  const ri = Math.round(Math.min(1, Math.max(0, r)) * 255);
+  const gi = Math.round(Math.min(1, Math.max(0, g)) * 255);
+  const bi = Math.round(Math.min(1, Math.max(0, b)) * 255);
+  return `rgb(${ri}, ${gi}, ${bi})`;
+}
+
+function renderSwatches(colors) {
+  if (!swatchesEl) return;
+  swatchesEl.replaceChildren();
+  for (const sphere of VISIBLE_SPHERES) {
+    const offset = sphere.index * 3;
+    const r = colors[offset];
+    const g = colors[offset + 1];
+    const b = colors[offset + 2];
+    const cssColor = toCssRgb(r, g, b);
+
+    const item = document.createElement('div');
+    item.className = 'swatch-item';
+
+    const dot = document.createElement('span');
+    dot.className = 'swatch-dot';
+    dot.style.backgroundColor = cssColor;
+
+    const label = document.createElement('span');
+    label.className = 'swatch-label';
+    label.textContent = `${sphere.name}: (${r.toFixed(2)}, ${g.toFixed(2)}, ${b.toFixed(2)})`;
+
+    item.append(dot, label);
+    swatchesEl.append(item);
+  }
+}
+
+function triggerRender(colors, label) {
+  runCounter += 1;
+  const runId = runCounter;
+  canvas.dataset.rendering = 'true';
+  statusEl.textContent = `Rendering path-traced scene in WebAssembly (${label})...`;
+  renderSwatches(colors);
+
+  worker.postMessage({
+    width: canvas.width,
+    height: canvas.height,
+    samples: 2,
+    colors,
+    runId,
+  });
+}
+
+worker.addEventListener('message', (event) => {
+  const { pixels, width, height, colors, elapsedMs, runId } = event.data;
+  if (canvas.width !== width) canvas.width = width;
+  if (canvas.height !== height) canvas.height = height;
+
+  const imageData = new ImageData(pixels, width, height);
+  ctx.putImageData(imageData, 0, 0);
+
+  canvas.dataset.rendering = 'false';
+  canvas.dataset.renderCount = String(runId);
+  renderSwatches(colors);
+  statusEl.textContent = `Rendered ${width}×${height} path-traced output in ${elapsedMs} ms (Run #${runId})`;
+});
+
+worker.addEventListener('error', (err) => {
+  canvas.dataset.rendering = 'false';
+  statusEl.textContent = `Render worker error: ${err.message || 'Unknown error'}`;
+});
+
+randomizeBtn.addEventListener('click', () => {
+  const randomizedColors = generateRandomizedColors();
+  triggerRender(randomizedColors, 'randomized sphere colors');
+});
+
+if (resetBtn) {
+  resetBtn.addEventListener('click', () => {
+    triggerRender([...DEFAULT_SPHERE_COLORS], 'default Cornell Box colors');
+  });
+}
+
+// Run initial render on load with classic smallpt Cornell Box colors
+triggerRender([...DEFAULT_SPHERE_COLORS], 'initial scene');
