+export default async function initSmallpt(moduleArg = {}) {
+  const wasmUrl = new URL('./smallpt.wasm', import.meta.url);
+  let instance;
+
+  if (typeof WebAssembly.instantiateStreaming === 'function') {
+    try {
+      ({ instance } = await WebAssembly.instantiateStreaming(fetch(wasmUrl), {}));
+    } catch {
+      const response = await fetch(wasmUrl);
+      const bytes = await response.arrayBuffer();
+      ({ instance } = await WebAssembly.instantiate(bytes, {}));
+    }
+  } else {
+    const response = await fetch(wasmUrl);
+    const bytes = await response.arrayBuffer();
+    ({ instance } = await WebAssembly.instantiate(bytes, {}));
+  }
+
+  const exports = instance.exports;
+  const memory = exports.memory;
+
+  let heapU8 = new Uint8Array(memory.buffer);
+  let heapF64 = new Float64Array(memory.buffer);
+
+  function refreshHeaps() {
+    if (heapU8.buffer !== memory.buffer) {
+      heapU8 = new Uint8Array(memory.buffer);
+      heapF64 = new Float64Array(memory.buffer);
+    }
+  }
+
+  return {
+    ...moduleArg,
+    asm: exports,
+    wasmMemory: memory,
+    _malloc(size) {
+      const ptr = exports._malloc(size);
+      refreshHeaps();
+      return ptr;
+    },
+    _free(ptr) {
+      exports._free(ptr);
+    },
+    _render_scene(outRgbaPtr, width, height, samples, customColorsPtr) {
+      exports._render_scene(outRgbaPtr, width, height, samples, customColorsPtr);
+      refreshHeaps();
+    },
+    get HEAPU8() {
+      refreshHeaps();
+      return heapU8;
+    },
+    get HEAPF64() {
+      refreshHeaps();
+      return heapF64;
+    },
+  };
+}
