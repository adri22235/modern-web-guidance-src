@@ -0,0 +1,65 @@
+import initSmallpt from './smallpt.js';
+
+const wasmPromise = initSmallpt();
+
+const DEFAULT_SPHERE_COLORS = [
+  0.75, 0.25, 0.25,   // 0: Left wall
+  0.25, 0.25, 0.75,   // 1: Right wall
+  0.75, 0.75, 0.75,   // 2: Back wall
+  0.0,  0.0,  0.0,    // 3: Front wall (behind camera)
+  0.75, 0.75, 0.75,   // 4: Bottom floor
+  0.75, 0.75, 0.75,   // 5: Top ceiling
+  0.999, 0.999, 0.999,// 6: Mirror sphere
+  0.999, 0.999, 0.999,// 7: Glass sphere
+  0.0,  0.0,  0.0,    // 8: Light source (emissive)
+];
+
+self.addEventListener('message', async (event) => {
+  const {
+    width = 200,
+    height = 150,
+    samples = 2,
+    colors = DEFAULT_SPHERE_COLORS,
+    runId = 0,
+  } = event.data || {};
+
+  const wasm = await wasmPromise;
+  const pixelByteLength = width * height * 4;
+  const colorCount = 27;
+  const colorByteLength = colorCount * Float64Array.BYTES_PER_ELEMENT;
+
+  const pixelPtr = wasm._malloc(pixelByteLength);
+  const colorPtr = wasm._malloc(colorByteLength);
+
+  try {
+    const colorInput =
+      Array.isArray(colors) && colors.length === colorCount
+        ? colors
+        : DEFAULT_SPHERE_COLORS;
+
+    const colorBuffer = new Float64Array(
+      wasm.HEAPU8.buffer,
+      colorPtr,
+      colorCount,
+    );
+    colorBuffer.set(colorInput);
+
+    const startTime = performance.now();
+    wasm._render_scene(pixelPtr, width, height, samples, colorPtr);
+    const elapsedMs = Math.round(performance.now() - startTime);
+
+    const pixels = new Uint8ClampedArray(
+      wasm.HEAPU8.buffer,
+      pixelPtr,
+      pixelByteLength,
+    ).slice();
+
+    self.postMessage(
+      { pixels, width, height, colors: colorInput, elapsedMs, runId },
+      [pixels.buffer],
+    );
+  } finally {
+    wasm._free(colorPtr);
+    wasm._free(pixelPtr);
+  }
+});
