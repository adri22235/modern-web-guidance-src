index 0000000..ead03f8
--- /dev/null
+++ b/smallpt.cpp
@@ -0,0 +1,216 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Adapted for client-side WebAssembly execution with customizable sphere colors.
+
+#include <math.h>
+#include <stdlib.h>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#define WASM_EXPORT(name) EMSCRIPTEN_KEEPALIVE
+#else
+#define WASM_EXPORT(name) __attribute__((export_name(name), visibility("default")))
+#endif
+
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec& norm() { return *this = *this * (1.0 / sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(Vec &b) {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    else det = sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+static const int NUM_SPHERES = 9;
+
+static const Vec default_colors[NUM_SPHERES] = {
+  Vec(0.75, 0.25, 0.25),   // Left
+  Vec(0.25, 0.25, 0.75),   // Rght
+  Vec(0.75, 0.75, 0.75),   // Back
+  Vec(0.0,  0.0,  0.0),    // Frnt
+  Vec(0.75, 0.75, 0.75),   // Botm
+  Vec(0.75, 0.75, 0.75),   // Top
+  Vec(0.999, 0.999, 0.999),// Mirr
+  Vec(0.999, 0.999, 0.999),// Glas
+  Vec(0.0,  0.0,  0.0)     // Lite
+};
+
+static Sphere spheres[NUM_SPHERES] = {
+  Sphere(1e5,  Vec( 1e5 + 1, 40.8, 81.6),     Vec(),           Vec(0.75, 0.25, 0.25),    DIFF), // Left
+  Sphere(1e5,  Vec(-1e5 + 99, 40.8, 81.6),    Vec(),           Vec(0.25, 0.25, 0.75),    DIFF), // Rght
+  Sphere(1e5,  Vec(50, 40.8, 1e5),            Vec(),           Vec(0.75, 0.75, 0.75),    DIFF), // Back
+  Sphere(1e5,  Vec(50, 40.8, -1e5 + 170),     Vec(),           Vec(),                    DIFF), // Frnt
+  Sphere(1e5,  Vec(50, 1e5, 81.6),            Vec(),           Vec(0.75, 0.75, 0.75),    DIFF), // Botm
+  Sphere(1e5,  Vec(50, -1e5 + 81.6, 81.6),    Vec(),           Vec(0.75, 0.75, 0.75),    DIFF), // Top
+  Sphere(16.5, Vec(27, 16.5, 47),             Vec(),           Vec(1, 1, 1) * 0.999,     SPEC), // Mirr
+  Sphere(16.5, Vec(73, 16.5, 78),             Vec(),           Vec(1, 1, 1) * 0.999,     REFR), // Glas
+  Sphere(600,  Vec(50, 681.6 - 0.27, 81.6),   Vec(12, 12, 12), Vec(),                    DIFF)  // Lite
+};
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) { return int(pow(clamp(x), 1.0 / 2.2) * 255.0 + 0.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+  double d, inf = t = 1e20;
+  for (int i = NUM_SPHERES; i--;) {
+    if ((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t;
+  Vec n = (x - obj.p).norm();
+  Vec nl = n.dot(r.d) < 0 ? n : n * -1;
+  Vec f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+  if (++depth > 5) {
+    if (depth < 50 && erand48(Xi) < p) f = f * (1.0 / p);
+    else return obj.e;
+  }
+  if (obj.refl == DIFF) {
+    double r1 = 2.0 * M_PI * erand48(Xi);
+    double r2 = erand48(Xi);
+    double r2s = sqrt(r2);
+    Vec w = nl;
+    Vec u = ((fabs(w.x) > 0.1 ? Vec(0, 1) : Vec(1)) % w).norm();
+    Vec v = w % u;
+    Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1.0 - r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2.0 * n.dot(r.d)), depth, Xi));
+  }
+  Ray reflRay(x, r.d - n * 2.0 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1.0, nt = 1.5;
+  double nnt = into ? nc / nt : nt / nc;
+  double ddn = r.d.dot(nl);
+  double cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn);
+  if (cos2t < 0) {
+    return obj.e + f.mult(radiance(reflRay, depth, Xi));
+  }
+  Vec tdir = (r.d * nnt - n * ((into ? 1.0 : -1.0) * (ddn * nnt + sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc;
+  double R0 = a * a / (b * b);
+  double c = 1.0 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1.0 - R0) * c * c * c * c * c;
+  double Tr = 1.0 - Re;
+  double P = 0.25 + 0.5 * Re;
+  double RP = Re / P;
+  double TP = Tr / (1.0 - P);
+  return obj.e + f.mult(depth > 2
+      ? (erand48(Xi) < P
+          ? radiance(reflRay, depth, Xi) * RP
+          : radiance(Ray(x, tdir), depth, Xi) * TP)
+      : radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+extern "C" {
+
+#ifndef __EMSCRIPTEN__
+WASM_EXPORT("_malloc")
+void* wasm_malloc(size_t size) {
+  return malloc(size);
+}
+
+WASM_EXPORT("_free")
+void wasm_free(void* ptr) {
+  free(ptr);
+}
+#endif
+
+WASM_EXPORT("_render_scene")
+void render_scene(unsigned char* out_rgba, int w, int h, int samps, const double* custom_colors) {
+  if (!out_rgba || w <= 0 || h <= 0) return;
+  if (samps < 1) samps = 1;
+
+  if (custom_colors) {
+    for (int i = 0; i < NUM_SPHERES; i++) {
+      spheres[i].c = Vec(
+        clamp(custom_colors[i * 3 + 0]),
+        clamp(custom_colors[i * 3 + 1]),
+        clamp(custom_colors[i * 3 + 2])
+      );
+    }
+  } else {
+    for (int i = 0; i < NUM_SPHERES; i++) {
+      spheres[i].c = default_colors[i];
+    }
+  }
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * 0.5135 / h);
+  Vec cy = (cx % cam.d).norm() * 0.5135;
+  Vec r;
+  Vec *c = (Vec*)calloc((size_t)(w * h), sizeof(Vec));
+  if (!c) return;
+
+  for (int y = 0; y < h; y++) {
+    unsigned short Xi[3] = {0, 0, (unsigned short)(y * y * y)};
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++, r = Vec()) {
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2.0 * erand48(Xi);
+            double dx = r1 < 1.0 ? sqrt(r1) - 1.0 : 1.0 - sqrt(2.0 - r1);
+            double r2 = 2.0 * erand48(Xi);
+            double dy = r2 < 1.0 ? sqrt(r2) - 1.0 : 1.0 - sqrt(2.0 - r2);
+            Vec d = cx * (((sx + 0.5 + dx) / 2.0 + x) / w - 0.5) +
+                    cy * (((sy + 0.5 + dy) / 2.0 + y) / h - 0.5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / samps);
+          }
+          c[i] = c[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * 0.25;
+        }
+      }
+    }
+  }
+
+  for (int i = 0; i < w * h; i++) {
+    out_rgba[i * 4 + 0] = (unsigned char)toInt(c[i].x);
+    out_rgba[i * 4 + 1] = (unsigned char)toInt(c[i].y);
+    out_rgba[i * 4 + 2] = (unsigned char)toInt(c[i].z);
+    out_rgba[i * 4 + 3] = 255;
+  }
+
+  free(c);
+}
+
+} // extern "C"
