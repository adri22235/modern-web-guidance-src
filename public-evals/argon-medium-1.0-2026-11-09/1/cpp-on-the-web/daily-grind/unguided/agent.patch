+  <script>
+    const SPHERE_METADATA = [
+      { id: 0, name: 'Left Wall (DIFF)' },
+      { id: 1, name: 'Right Wall (DIFF)' },
+      { id: 2, name: 'Back Wall (DIFF)' },
+      { id: 4, name: 'Floor (DIFF)' },
+      { id: 5, name: 'Ceiling (DIFF)' },
+      { id: 6, name: 'Mirror Sphere (SPEC)' },
+      { id: 7, name: 'Glass Sphere (REFR)' }
+    ];
+
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const samplesSelect = document.getElementById('samples-select');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const wasmStatus = document.getElementById('wasm-status');
+    const renderStats = document.getElementById('render-stats');
+    const sphereListEl = document.getElementById('sphere-list');
+
+    let wasmExports = null;
+    let renderCount = 0;
+
+    function toDisplayByte(linearVal) {
+      const clamped = Math.max(0, Math.min(1, linearVal));
+      return Math.min(255, Math.floor(Math.pow(clamped, 1 / 2.2) * 255 + 0.5));
+    }
+
+    function rgbToHex(r, g, b) {
+      const rb = toDisplayByte(r).toString(16).padStart(2, '0');
+      const gb = toDisplayByte(g).toString(16).padStart(2, '0');
+      const bb = toDisplayByte(b).toString(16).padStart(2, '0');
+      return `#${rb}${gb}${bb}`.toUpperCase();
+    }
+
+    function updateSpherePaletteUI() {
+      if (!wasmExports) return;
+      sphereListEl.innerHTML = '';
+      for (const meta of SPHERE_METADATA) {
+        const r = wasmExports.get_sphere_color_r(meta.id);
+        const g = wasmExports.get_sphere_color_g(meta.id);
+        const b = wasmExports.get_sphere_color_b(meta.id);
+        const hex = rgbToHex(r, g, b);
+
+        const li = document.createElement('li');
+        li.className = 'sphere-item';
+        li.dataset.sphereId = String(meta.id);
+        li.dataset.sphereColor = hex;
+        li.innerHTML = `
+          <span class="sphere-info">
+            <span class="swatch" style="background-color: ${hex};"></span>
+            <span>${meta.name}</span>
+          </span>
+          <span class="sphere-hex">${hex}</span>
+        `;
+        sphereListEl.appendChild(li);
+      }
+    }
+
+    function getResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { width: w || 256, height: h || 192 };
+    }
+
+    function runPathTracer() {
+      if (!wasmExports) return;
+      const { width, height } = getResolution();
+      const samps = parseInt(samplesSelect.value, 10) || 1;
+
+      if (canvas.width !== width || canvas.height !== height) {
+        canvas.width = width;
+        canvas.height = height;
+      }
+
+      renderCount += 1;
+      const t0 = performance.now();
+      wasmExports.render(width, height, samps, renderCount);
+      const elapsedMs = performance.now() - t0;
+
+      const ptr = wasmExports.get_pixel_buffer();
+      const byteLength = width * height * 4;
+      const wasmBytes = new Uint8ClampedArray(wasmExports.memory.buffer, ptr, byteLength);
+      const imageData = new ImageData(new Uint8ClampedArray(wasmBytes), width, height);
+      ctx.putImageData(imageData, 0, 0);
+
+      updateSpherePaletteUI();
+      renderStats.textContent = `Rendered ${width}×${height} @ ${samps * 4} spp in ${elapsedMs.toFixed(0)} ms (Run #${renderCount})`;
+      canvas.dataset.renderCount = String(renderCount);
+    }
+
+    function randomizeAndRender() {
+      if (!wasmExports) return;
+      const seed = (Math.floor(Math.random() * 0xFFFFFFFE) + 1) >>> 0;
+      wasmExports.randomize_colors(seed);
+      runPathTracer();
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      randomizeAndRender();
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      runPathTracer();
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      runPathTracer();
+    });
+
+    async function loadWasm() {
+      try {
+        let instance;
+        if (typeof WebAssembly.instantiateStreaming === 'function') {
+          try {
+            const result = await WebAssembly.instantiateStreaming(fetch('smallpt.wasm'), {});
+            instance = result.instance;
+          } catch (_) {
+            const response = await fetch('smallpt.wasm');
+            const bytes = await response.arrayBuffer();
+            const result = await WebAssembly.instantiate(bytes, {});
+            instance = result.instance;
+          }
+        } else {
+          const response = await fetch('smallpt.wasm');
+          const bytes = await response.arrayBuffer();
+          const result = await WebAssembly.instantiate(bytes, {});
+          instance = result.instance;
+        }
+
+        wasmExports = instance.exports;
+        if (typeof wasmExports._initialize === 'function') {
+          wasmExports._initialize();
+        }
+
+        window.smallptWasm = wasmExports;
+        wasmStatus.textContent = 'WebAssembly Ready (smallpt.wasm)';
+        runPathTracer();
+      } catch (err) {
+        console.error('Failed to initialize smallpt.wasm:', err);
+        wasmStatus.textContent = 'Wasm Load Error';
+        renderStats.textContent = String(err.message || err);
+      }
+    }
 
+    loadWasm();
+  </script>
