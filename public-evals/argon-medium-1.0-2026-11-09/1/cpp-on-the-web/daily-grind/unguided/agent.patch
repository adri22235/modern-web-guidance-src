index 0000000..fb86ec0
--- /dev/null
+++ b/build-wasm.mjs
@@ -0,0 +1,23 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { runClang } from '@yowasp/clang';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const cppPath = path.join(__dirname, 'smallpt.cpp');
+const wasmPath = path.join(__dirname, 'smallpt.wasm');
+
+const source = fs.readFileSync(cppPath, 'utf8');
+
+console.log('Compiling smallpt.cpp to WebAssembly (smallpt.wasm)...');
+const files = await runClang(
+  ['clang++', '-O3', '-mexec-model=reactor', 'smallpt.cpp', '-o', 'smallpt.wasm'],
+  { 'smallpt.cpp': source }
+);
+
+if (!files['smallpt.wasm']) {
+  throw new Error('Failed to produce smallpt.wasm');
+}
+
+fs.writeFileSync(wasmPath, files['smallpt.wasm']);
+console.log(`Successfully built smallpt.wasm (${files['smallpt.wasm'].length} bytes)`);
