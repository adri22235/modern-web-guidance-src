+    function updateShotsProgress() {
+      const value = Number(shotsInput.value);
+      const min = Number(shotsInput.min) || 1;
+      const max = Number(shotsInput.max) || 5;
+      const percent = ((value - min) / (max - min)) * 100;
+      shotsOutput.textContent = value === 1 ? '1 Shot' : `${value} Shots`;
+      if (!CSS.supports('accent-color', '#4e342e')) {
+        shotsInput.style.setProperty('--progress', `${percent}%`);
+      }
+    }
+
+    shotsInput.addEventListener('input', updateShotsProgress);
