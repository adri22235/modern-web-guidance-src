+  <script>
+    (function () {
+      const toolbar = document.getElementById('favorites-actions');
+      const grid = document.getElementById('favorites-grid');
+      const gridViewBtn = document.getElementById('grid-view-btn');
+      const listViewBtn = document.getElementById('list-view-btn');
+      const toggleDetailsBtn = document.getElementById('toggle-details-btn');
+      const toggleFiltersBtn = document.getElementById('toggle-filters-btn');
+      const copyDrinksBtn = document.getElementById('copy-drinks-btn');
+      const statusRegion = document.getElementById('favorites-status');
+
+      if (!toolbar || !grid) return;
+
+      const buttons = Array.from(toolbar.querySelectorAll('button'));
+
+      function announce(message) {
+        if (statusRegion) {
+          statusRegion.textContent = message;
+        }
+      }
+
+      function setView(mode) {
+        const isList = mode === 'list';
+        grid.classList.toggle('list-view', isList);
+        gridViewBtn.setAttribute('aria-pressed', String(!isList));
+        gridViewBtn.classList.toggle('active', !isList);
+        listViewBtn.setAttribute('aria-pressed', String(isList));
+        listViewBtn.classList.toggle('active', isList);
+        announce(isList ? 'Switched to list view' : 'Switched to grid view');
+      }
+
+      gridViewBtn.addEventListener('click', function () {
+        setView('grid');
+      });
+
+      listViewBtn.addEventListener('click', function () {
+        setView('list');
+      });
+
+      toggleDetailsBtn.addEventListener('click', function () {
+        const currentlyShown = toggleDetailsBtn.getAttribute('aria-pressed') === 'true';
+        const nextShown = !currentlyShown;
+        toggleDetailsBtn.setAttribute('aria-pressed', String(nextShown));
+        toggleDetailsBtn.classList.toggle('active', nextShown);
+        grid.classList.toggle('hide-details', !nextShown);
+        announce(nextShown ? 'Drink details shown' : 'Drink details hidden');
+      });
+
+      toggleFiltersBtn.addEventListener('click', function () {
+        const currentlyFiltered = toggleFiltersBtn.getAttribute('aria-pressed') === 'true';
+        const nextFiltered = !currentlyFiltered;
+        toggleFiltersBtn.setAttribute('aria-pressed', String(nextFiltered));
+        toggleFiltersBtn.classList.toggle('active', nextFiltered);
+        grid.classList.toggle('show-filters', nextFiltered);
+        const cards = grid.querySelectorAll('.card');
+        cards.forEach(function (card) {
+          if (nextFiltered && card.getAttribute('data-seasonal') === 'false') {
+            card.style.display = 'none';
+          } else {
+            card.style.display = '';
+          }
+        });
+        announce(nextFiltered ? 'Seasonal drink filter enabled' : 'Seasonal drink filter disabled');
+      });
+
+      copyDrinksBtn.addEventListener('click', function () {
+        const visibleCards = Array.from(grid.querySelectorAll('.card')).filter(function (card) {
+          return card.style.display !== 'none';
+        });
+        const drinksText = visibleCards
+          .map(function (card) {
+            const title = card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : '';
+            const desc = card.querySelector('p') ? card.querySelector('p').textContent.trim() : '';
+            return desc ? title + ': ' + desc : title;
+          })
+          .join('\n');
+
+        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
+          navigator.clipboard.writeText(drinksText).catch(function () {});
+        }
+
+        copyDrinksBtn.classList.add('copied');
+        copyDrinksBtn.setAttribute('data-tooltip', 'Copied!');
+        announce('Featured drinks list copied to clipboard');
+
+        setTimeout(function () {
+          copyDrinksBtn.classList.remove('copied');
+          copyDrinksBtn.setAttribute('data-tooltip', 'Copy featured drinks list');
+        }, 1800);
+      });
+
+      // WAI-ARIA Toolbar roving tabindex keyboard navigation
+      toolbar.addEventListener('keydown', function (event) {
+        const currentIndex = buttons.indexOf(document.activeElement);
+        if (currentIndex === -1) return;
+
+        let nextIndex = -1;
+        if (event.key === 'ArrowRight') {
+          nextIndex = (currentIndex + 1) % buttons.length;
+        } else if (event.key === 'ArrowLeft') {
+          nextIndex = (currentIndex - 1 + buttons.length) % buttons.length;
+        } else if (event.key === 'Home') {
+          nextIndex = 0;
+        } else if (event.key === 'End') {
+          nextIndex = buttons.length - 1;
+        }
+
+        if (nextIndex !== -1) {
+          event.preventDefault();
+          buttons.forEach(function (btn, idx) {
+            btn.setAttribute('tabindex', idx === nextIndex ? '0' : '-1');
+          });
+          buttons[nextIndex].focus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
