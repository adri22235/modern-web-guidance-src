+  <script>
+    (() => {
+      const bar = document.getElementById('favorites-actions');
+      const list = document.getElementById('favorites-list');
+      const status = document.getElementById('favorites-status');
+      if (!bar || !list || !status) return;
+
+      const items = Array.from(bar.querySelectorAll('button'));
+
+      // 1. Upgrade title tooltips only when interest invokers and anchor positioning both work
+      if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+        bar.querySelectorAll('button[title]').forEach((b, i) => {
+          const tip = Object.assign(document.createElement('div'), {
+            id: `favorites-tip-${i}`,
+            textContent: b.title
+          });
+          tip.setAttribute('popover', 'hint');
+          b.setAttribute('interestfor', tip.id);
+          b.removeAttribute('title');
+          document.body.append(tip);
+        });
+      }
+
+      // Wire explicit ARIA for any [interestfor] triggers targeting popover="hint"
+      const ownedExpandedTriggers = new Set();
+      function wireHintAria(root = document) {
+        root.querySelectorAll('[interestfor]').forEach((trigger) => {
+          const hint = document.getElementById(trigger.getAttribute('interestfor'));
+          if (!hint || hint.getAttribute('popover') !== 'hint') return;
+          const hintText = (hint.textContent || '').trim().replace(/\s+/g, ' ');
+          const labelledBy = trigger.getAttribute('aria-labelledby');
+          const rawName = labelledBy
+            ? labelledBy.split(/\s+/).map((id) => document.getElementById(id)?.textContent || '').join(' ')
+            : trigger.getAttribute('aria-label') || trigger.textContent || trigger.getAttribute('title') || '';
+          const triggerName = rawName.trim().replace(/\s+/g, ' ');
+          if (hintText === triggerName) return;
+          if (!hint.hasAttribute('role')) hint.setAttribute('role', 'tooltip');
+          if (!triggerName) {
+            if (!trigger.hasAttribute('aria-labelledby')) trigger.setAttribute('aria-labelledby', hint.id);
+          } else if (
+            trigger.getAttribute('popovertarget') === hint.id ||
+            trigger.getAttribute('commandfor') === hint.id
+          ) {
+            if (!trigger.hasAttribute('aria-expanded')) {
+              trigger.setAttribute('aria-expanded', String(hint.matches(':popover-open')));
+              ownedExpandedTriggers.add(trigger);
+            }
+          } else if (!trigger.hasAttribute('aria-describedby')) {
+            trigger.setAttribute('aria-describedby', hint.id);
+          }
+        });
+      }
+      wireHintAria();
+      if ('interestForElement' in HTMLButtonElement.prototype) {
+        document.addEventListener('toggle', (event) => {
+          const pop = event.target;
+          if (!pop?.id || pop.getAttribute('popover') !== 'hint') return;
+          const open = event.newState === 'open';
+          ownedExpandedTriggers.forEach((t) => {
+            if (t.getAttribute('interestfor') === pop.id) {
+              t.setAttribute('aria-expanded', String(open));
+            }
+          });
+        }, true);
+      }
+
+      // 2. Roving tabindex fallback when native focusgroup is unsupported
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener('focusin', ({ target }) => {
+          if (items.includes(target)) {
+            items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+          }
+        });
+        bar.addEventListener('keydown', (event) => {
+          const currentIndex = items.indexOf(document.activeElement);
+          if (currentIndex === -1) return;
+          const vertical = bar.getAttribute('aria-orientation') === 'vertical';
+          const rtl = getComputedStyle(bar).direction === 'rtl';
+          const steps = vertical
+            ? { ArrowDown: 1, ArrowUp: -1 }
+            : { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          let nextIndex = -1;
+          if (event.key in steps) {
+            nextIndex = (currentIndex + steps[event.key] + items.length) % items.length;
+          } else if (event.key === 'Home') {
+            nextIndex = 0;
+          } else if (event.key === 'End') {
+            nextIndex = items.length - 1;
+          }
+          if (nextIndex !== -1) {
+            event.preventDefault();
+            items[nextIndex].focus();
+          }
+        });
+      }
+
+      // 3. View switching & drink details / filter toggling
+      const viewButtons = Array.from(bar.querySelectorAll('button[data-view-mode]'));
+      bar.addEventListener('click', (event) => {
+        const btn = event.target.closest('button');
+        if (!btn || !bar.contains(btn)) return;
+        if (btn.getAttribute('aria-disabled') === 'true') return;
+
+        const viewMode = btn.dataset.viewMode;
+        if (viewMode) {
+          viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
+          list.dataset.view = viewMode;
+          return;
+        }
+
+        const toggleType = btn.dataset.toggle;
+        if (toggleType === 'details') {
+          const nextPressed = btn.getAttribute('aria-pressed') !== 'true';
+          btn.setAttribute('aria-pressed', String(nextPressed));
+          list.dataset.details = nextPressed ? 'visible' : 'hidden';
+          return;
+        }
+
+        if (toggleType === 'filter') {
+          const nextPressed = btn.getAttribute('aria-pressed') !== 'true';
+          btn.setAttribute('aria-pressed', String(nextPressed));
+          list.querySelectorAll('.card').forEach((card) => {
+            card.hidden = nextPressed && card.dataset.seasonal !== 'true';
+          });
+        }
+      });
+
+      // 4. Copy featured drinks list action with live region status feedback
+      const timers = new WeakMap();
+      let lastMessage = '';
+
+      function legacyCopy(text) {
+        const field = Object.assign(document.createElement('textarea'), { value: text });
+        field.setAttribute('readonly', '');
+        field.style.cssText = 'position:fixed;inset-block-start:0;opacity:0';
+        document.body.append(field);
+        field.select();
+        try {
+          return document.execCommand('copy');
+        } finally {
+          field.remove();
+        }
+      }
+
+      function report(button, ok) {
+        clearTimeout(timers.get(button));
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        let message = ok ? 'Copied' : 'Copy failed';
+        if (message === lastMessage) message += '\u00A0';
+        lastMessage = message;
+        status.textContent = '';
+        void button.offsetWidth;
+        button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        requestAnimationFrame(() => {
+          status.textContent = message;
+        });
+        timers.set(button, setTimeout(() => {
+          button.removeAttribute('data-copied');
+          button.removeAttribute('data-failed');
+          status.textContent = '';
+        }, 2000));
+      }
+
+      function getDrinksText(target) {
+        const showDetails = target.dataset.details !== 'hidden';
+        const cards = Array.from(target.querySelectorAll('.card:not([hidden])'));
+        return cards.map((card) => {
+          const name = card.querySelector('h3')?.innerText.trim() || '';
+          const desc = showDetails ? card.querySelector('p')?.innerText.trim() || '' : '';
+          return desc ? `${name} — ${desc}` : name;
+        }).filter(Boolean).join('\n');
+      }
+
+      async function copy(button, target) {
+        if (button.getAttribute('aria-disabled') === 'true') return;
+        const text = getDrinksText(target) || target.innerText.trim();
+        if (!text) return;
+        try {
+          try {
+            await navigator.clipboard.writeText(text);
+          } catch {
+            if (!legacyCopy(text)) throw new Error('Copy failed');
+          }
+          report(button, true);
+        } catch {
+          report(button, false);
+        }
+      }
+
+      if ('CommandEvent' in window) {
+        document.addEventListener('command', (event) => {
+          if (event.command.startsWith('--copy')) {
+            copy(event.source, event.target);
+          }
+        }, true);
+      } else {
+        document.addEventListener('click', (event) => {
+          const button = event.target.closest('button[command^="--copy"]');
+          if (!button) return;
+          const target = document.getElementById(button.getAttribute('commandfor'));
+          if (target) copy(button, target);
+        });
+      }
+    })();
+  </script>
+
