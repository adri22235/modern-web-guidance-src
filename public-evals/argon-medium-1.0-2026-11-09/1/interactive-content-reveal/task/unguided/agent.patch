+  <script>
+    (function () {
+      const cards = document.querySelectorAll('.product-card');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const HOVER_INNER_SIZE = '95px';
+      const HOVER_OUTER_SIZE = '145px';
+      const INITIAL_HOVER_INNER = '45px';
+      const INITIAL_HOVER_OUTER = '75px';
+
+      cards.forEach((card) => {
+        card.style.setProperty('--mouse-x', '0px');
+        card.style.setProperty('--mouse-y', '0px');
+        card.style.setProperty('--inner-size', '0px');
+        card.style.setProperty('--outer-size', '0px');
+
+        const updatePosition = (event) => {
+          const rect = card.getBoundingClientRect();
+          const x = Math.round((event.clientX ?? rect.left + rect.width / 2) - rect.left);
+          const y = Math.round((event.clientY ?? rect.top + rect.height / 2) - rect.top);
+          card.style.setProperty('--mouse-x', `${x}px`);
+          card.style.setProperty('--mouse-y', `${y}px`);
+        };
+
+        const activateSpotlight = (event) => {
+          updatePosition(event);
+          const isReducedMotion = reducedMotionQuery.matches;
+
+          if (!card.classList.contains('is-hovered')) {
+            if (!isReducedMotion) {
+              card.style.transition = 'none';
+              card.style.setProperty('--inner-size', INITIAL_HOVER_INNER);
+              card.style.setProperty('--outer-size', INITIAL_HOVER_OUTER);
+              void card.offsetWidth;
+              card.style.removeProperty('transition');
+            }
+            card.classList.add('is-hovered');
+          }
+
+          card.style.setProperty('--inner-size', HOVER_INNER_SIZE);
+          card.style.setProperty('--outer-size', HOVER_OUTER_SIZE);
+        };
+
+        const deactivateSpotlight = () => {
+          card.classList.remove('is-hovered');
+          card.style.transition = 'none';
+          card.style.setProperty('--inner-size', '0px');
+          card.style.setProperty('--outer-size', '0px');
+          void card.offsetWidth;
+          card.style.removeProperty('transition');
+        };
+
+        card.addEventListener('pointerenter', activateSpotlight);
+        card.addEventListener('mouseenter', activateSpotlight);
+        card.addEventListener('pointermove', activateSpotlight);
+        card.addEventListener('mousemove', activateSpotlight);
+        card.addEventListener('pointerleave', deactivateSpotlight);
+        card.addEventListener('mouseleave', deactivateSpotlight);
+      });
+    })();
+  </script>
