+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const statusEl = document.getElementById('snap-support-status');
+      if (!gallery) return;
+
+      const slides = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbButtons = Array.from(document.querySelectorAll('#gallery-thumbnails button'));
+
+      // Detect native CSS Scroll Snap Events support with fallback detection
+      const supportsSnapEvents = Boolean(
+        'onscrollsnapchange' in window &&
+        'onscrollsnapchanging' in window &&
+        'SnapEvent' in window &&
+        'onscrollsnapchange' in HTMLElement.prototype &&
+        'onscrollsnapchanging' in HTMLElement.prototype
+      );
+
+      gallery.dataset.snapSupport = supportsSnapEvents ? 'native' : 'fallback';
+      gallery.dataset.fallback = supportsSnapEvents ? 'false' : 'true';
+      if (!supportsSnapEvents) {
+        gallery.classList.add('snap-fallback');
+      }
+
+      if (statusEl) {
+        statusEl.textContent = supportsSnapEvents
+          ? 'Native Scroll-Snap Events'
+          : 'Fallback Scroll Detection';
+        statusEl.dataset.mode = supportsSnapEvents ? 'native' : 'fallback';
+        statusEl.dataset.fallback = supportsSnapEvents ? 'false' : 'true';
+        if (!supportsSnapEvents) {
+          statusEl.classList.add('fallback');
+        }
+      }
+
+      let activeIndex = 0;
+      let pendingIndex = null;
+      let clickedTargetIndex = null;
+      let nativeSnapChangingFired = false;
+      let lastScrollLeft = gallery.scrollLeft || 0;
+      let settleTimer = null;
+
+      function getSlideWidth() {
+        return (slides[0] && slides[0].offsetWidth) || gallery.clientWidth || 1;
+      }
+
+      function getSlideOffsetLeft(index) {
+        const slide = slides[index];
+        if (!slide) return 0;
+        if (slide.offsetLeft > 0 || index === 0) {
+          return slide.offsetLeft;
+        }
+        return index * getSlideWidth();
+      }
+
+      function getClosestSlideIndex() {
+        if (!slides.length) return 0;
+        const scrollLeft = gallery.scrollLeft;
+        let bestIndex = 0;
+        let bestDist = Infinity;
+
+        slides.forEach((_, idx) => {
+          const dist = Math.abs(getSlideOffsetLeft(idx) - scrollLeft);
+          if (dist < bestDist) {
+            bestDist = dist;
+            bestIndex = idx;
+          }
+        });
+
+        return bestIndex;
+      }
+
+      function resolveEventSlideIndex(event) {
+        if (event) {
+          const snapTarget =
+            event.snapTargetInline ||
+            event.snapTargetBlock ||
+            (event.detail &&
+              (event.detail.snapTargetInline ||
+                event.detail.snapTargetBlock ||
+                event.detail.target));
+
+          if (snapTarget) {
+            const item = snapTarget.closest
+              ? snapTarget.closest('.gallery-item')
+              : snapTarget;
+            const foundIdx = slides.indexOf(item);
+            if (foundIdx !== -1) {
+              return foundIdx;
+            }
+          }
+
+          if (event.detail && typeof event.detail.index === 'number') {
+            const detailIdx = event.detail.index;
+            if (detailIdx >= 0 && detailIdx < slides.length) {
+              return detailIdx;
+            }
+          }
+        }
+        return getClosestSlideIndex();
+      }
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbButtons.length) return;
+        pendingIndex = index;
+
+        thumbButtons.forEach((btn, idx) => {
+          btn.classList.toggle('pending', idx === index);
+        });
+
+        slides.forEach((slide, idx) => {
+          slide.dataset.snapState =
+            idx === index ? 'pending' : idx === activeIndex ? 'active' : '';
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0 || index >= thumbButtons.length) return;
+        if (settleTimer) {
+          clearTimeout(settleTimer);
+          settleTimer = null;
+        }
+
+        activeIndex = index;
+        pendingIndex = null;
+        clickedTargetIndex = null;
+        nativeSnapChangingFired = false;
+
+        thumbButtons.forEach((btn, idx) => {
+          btn.classList.remove('pending');
+          const isCurrent = idx === index;
+          btn.classList.toggle('active', isCurrent);
+          btn.setAttribute('aria-current', isCurrent ? 'true' : 'false');
+        });
+
+        slides.forEach((slide, idx) => {
+          slide.dataset.snapState = idx === index ? 'active' : '';
+        });
+      }
+
+      function scheduleFallbackSettle(delayMs) {
+        const timeout = typeof delayMs === 'number' ? delayMs : 180;
+        if (settleTimer) {
+          clearTimeout(settleTimer);
+        }
+        if (nativeSnapChangingFired) {
+          return;
+        }
+        settleTimer = setTimeout(() => {
+          settleTimer = null;
+          if (nativeSnapChangingFired) return;
+          const closestIdx = getClosestSlideIndex();
+          const targetIdx =
+            closestIdx !== activeIndex || pendingIndex === null
+              ? closestIdx
+              : pendingIndex;
+          setActive(targetIdx);
+        }, timeout);
+      }
+
+      // Native Scroll Snap Events
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        nativeSnapChangingFired = true;
+        if (settleTimer) {
+          clearTimeout(settleTimer);
+          settleTimer = null;
+        }
+        const targetIdx = resolveEventSlideIndex(event);
+        setPending(targetIdx);
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const targetIdx = resolveEventSlideIndex(event);
+        setActive(targetIdx);
+      });
+
+      // Fallback scroll + scrollend detection
+      gallery.addEventListener(
+        'scroll',
+        () => {
+          const currentLeft = gallery.scrollLeft;
+          const delta = currentLeft - lastScrollLeft;
+          lastScrollLeft = currentLeft;
+
+          if (!supportsSnapEvents || !nativeSnapChangingFired) {
+            let previewIdx;
+            if (clickedTargetIndex !== null) {
+              previewIdx = clickedTargetIndex;
+            } else {
+              previewIdx = getClosestSlideIndex();
+              if (previewIdx === activeIndex && Math.abs(delta) > 0) {
+                const activeOffset = getSlideOffsetLeft(activeIndex);
+                if (Math.abs(currentLeft - activeOffset) > 4) {
+                  const candidate = activeIndex + (delta > 0 ? 1 : -1);
+                  if (candidate >= 0 && candidate < slides.length) {
+                    previewIdx = candidate;
+                  }
+                }
+              }
+            }
+            setPending(previewIdx);
+            scheduleFallbackSettle(180);
+          }
+        },
+        { passive: true }
+      );
+
+      gallery.addEventListener('scrollend', () => {
+        const closestIdx = getClosestSlideIndex();
+        const settledIdx =
+          closestIdx !== activeIndex || pendingIndex === null
+            ? closestIdx
+            : pendingIndex;
+        setActive(settledIdx);
+      });
+
+      // Thumbnail button click handlers
+      thumbButtons.forEach((btn, idx) => {
+        btn.addEventListener('click', () => {
+          const targetLeft = getSlideOffsetLeft(idx);
+          if (Math.abs(gallery.scrollLeft - targetLeft) < 2) {
+            setActive(idx);
+            return;
+          }
+          clickedTargetIndex = idx;
+          setPending(idx);
+          gallery.scrollTo({ left: targetLeft, behavior: 'smooth' });
+          scheduleFallbackSettle(350);
+        });
+      });
+
+      // Initialize first slide as active
+      setActive(0);
+    })();
+  </script>
+
 </body>
 
