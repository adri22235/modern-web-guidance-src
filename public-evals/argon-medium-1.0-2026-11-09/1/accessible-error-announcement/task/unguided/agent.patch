+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorEl = document.getElementById('newsletter-error');
+      const successEl = document.getElementById('newsletter-success');
+
+      if (!form || !emailInput || !errorEl) return;
+
+      const ERROR_MESSAGE = 'Please enter a valid email address.';
+      let hasInteracted = false;
+
+      function isUserInvalid() {
+        try {
+          return emailInput.matches(':user-invalid');
+        } catch (err) {
+          return false;
+        }
+      }
+
+      function syncErrorState() {
+        const isValid = emailInput.validity.valid;
+        const shouldShowError = (hasInteracted || isUserInvalid()) && !isValid;
+
+        if (shouldShowError) {
+          emailInput.setAttribute('aria-invalid', 'true');
+          emailInput.classList.add('is-invalid');
+          errorEl.hidden = false;
+          errorEl.classList.add('is-visible');
+          if (errorEl.textContent !== ERROR_MESSAGE) {
+            errorEl.textContent = ERROR_MESSAGE;
+          }
+          if (successEl) {
+            successEl.hidden = true;
+            successEl.classList.remove('is-visible');
+            successEl.textContent = '';
+          }
+        } else {
+          emailInput.setAttribute('aria-invalid', 'false');
+          emailInput.classList.remove('is-invalid');
+          errorEl.hidden = true;
+          errorEl.classList.remove('is-visible');
+          if (errorEl.textContent !== '') {
+            errorEl.textContent = '';
+          }
+        }
+      }
+
+      emailInput.addEventListener('input', function () {
+        if (successEl && !successEl.hidden) {
+          successEl.hidden = true;
+          successEl.classList.remove('is-visible');
+          successEl.textContent = '';
+        }
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('change', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (!emailInput.validity.valid) {
+          hasInteracted = true;
+          syncErrorState();
+          emailInput.focus();
+          return;
+        }
+
+        hasInteracted = false;
+        syncErrorState();
+        if (successEl) {
+          successEl.textContent = 'Thanks for subscribing to The Daily Grind!';
+          successEl.hidden = false;
+          successEl.classList.add('is-visible');
+        }
+      });
+
+      form.addEventListener('reset', function () {
+        hasInteracted = false;
+        setTimeout(syncErrorState, 0);
+      });
+
+      syncErrorState();
+    })();
+  </script>
+
 </body>
 
