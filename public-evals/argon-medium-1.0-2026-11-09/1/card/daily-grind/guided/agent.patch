+  <script>
+    // Handle adding drinks to the order with accessible live-region feedback
+    document.querySelectorAll('.order-form').forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(form);
+        const drink = formData.get('drink');
+        const size = formData.get('size');
+        const checkedRadio = form.querySelector('input[name="size"]:checked');
+        const price = checkedRadio ? checkedRadio.dataset.price : '';
+        const statusEl = form.querySelector('.order-status');
+
+        if (statusEl && drink && size) {
+          const formattedSize = String(size).charAt(0).toUpperCase() + String(size).slice(1);
+          statusEl.hidden = false;
+          statusEl.textContent = `Added ${formattedSize} ${drink} (${price}) to your order.`;
+        }
+      });
+    });
+
+    // Fallback JavaScript for older browsers that do not support the :has() selector
+    if (!CSS.supports('selector(:has(*))')) {
+      const cards = document.querySelectorAll('.card');
+
+      const syncCardState = (card) => {
+        if (card.querySelector('img, picture, video, svg, .media')) {
+          card.classList.add('has-image');
+        }
+        if (card.querySelector('a.card-link')) {
+          card.classList.add('has-card-link');
+        }
+
+        const checkedRadio = card.querySelector('input[name="size"]:checked');
+        card.classList.toggle('is-size-small', Boolean(checkedRadio && checkedRadio.value === 'small'));
+        card.classList.toggle('is-size-medium', Boolean(checkedRadio && checkedRadio.value === 'medium'));
+        card.classList.toggle('is-size-large', Boolean(checkedRadio && checkedRadio.value === 'large'));
+
+        card.querySelectorAll('.size-option').forEach((option) => {
+          const input = option.querySelector('input[type="radio"]');
+          option.classList.toggle('is-selected', Boolean(input && input.checked));
+        });
+      };
+
+      cards.forEach((card) => {
+        syncCardState(card);
+        card.addEventListener('change', () => syncCardState(card));
+      });
+    }
+  </script>
