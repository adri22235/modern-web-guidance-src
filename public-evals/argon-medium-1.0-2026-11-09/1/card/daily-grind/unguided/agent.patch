+  <script>
+    document.querySelectorAll('.order-form').forEach((form) => {
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const card = form.closest('.card');
+        const drinkName = card.dataset.drink || card.querySelector('h3')?.textContent || 'Drink';
+        const selectedInput = form.querySelector('input[type="radio"]:checked');
+        const size = selectedInput ? selectedInput.value : 'medium';
+        const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+        const btn = form.querySelector('.add-to-order-btn');
+        const status = form.querySelector('.order-status');
+
+        if (btn) {
+          btn.classList.add('added');
+          btn.textContent = `Added (${sizeLabel})`;
+        }
+
+        if (status) {
+          status.textContent = `✓ 1x ${sizeLabel} ${drinkName} added to your order.`;
+        }
+
+        clearTimeout(form._resetTimer);
+        form._resetTimer = setTimeout(() => {
+          if (btn) {
+            btn.classList.remove('added');
+            btn.textContent = 'Add to Order';
+          }
+        }, 2500);
+      });
+    });
+  </script>
