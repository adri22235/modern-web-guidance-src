+  <script>
+    const BREW_STRENGTHS = [
+      {
+        label: 'Mild',
+        notes: 'Delicate floral aroma with bright citrus notes and a light, tea-like body (1:18 brew ratio).'
+      },
+      {
+        label: 'Medium',
+        notes: 'Balanced body with toasted caramel sweetness and a smooth, clean finish (1:16 brew ratio).'
+      },
+      {
+        label: 'Bold',
+        notes: 'Rich dark chocolate undertones with full-bodied warmth and low acidity (1:14 brew ratio).'
+      },
+      {
+        label: 'Extra Bold',
+        notes: 'Intense, velvety extraction with smoky espresso-style depth and a lingering cocoa finish (1:12 brew ratio).'
+      }
+    ];
+
+    const slider = document.querySelector('#brew-strength-slider');
+    const output = document.querySelector('#brew-strength-output');
+    const notes = document.querySelector('#brew-strength-notes');
+    const stops = document.querySelectorAll('.brew-strength-stops li');
+
+    function syncSliderValue() {
+      const index = Number(slider.value);
+      const strength = BREW_STRENGTHS[index] || BREW_STRENGTHS[1];
+
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 3);
+      slider.style.setProperty('--control-value', slider.value);
+      slider.setAttribute('aria-valuetext', strength.label);
+
+      output.textContent = strength.label;
+      notes.textContent = strength.notes;
+
+      stops.forEach((stop, stopIndex) => {
+        if (stopIndex === index) {
+          stop.setAttribute('data-active', 'true');
+        } else {
+          stop.removeAttribute('data-active');
+        }
+      });
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
