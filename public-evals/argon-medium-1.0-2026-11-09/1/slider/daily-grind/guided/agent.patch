+      --slider-thumb-radius: 50%;
+      --slider-track-color: var(--secondary);
+      --slider-fill-color: var(--primary);
+      --slider-thumb-color: var(--accent);
+      --slider-direction: to right;
+
+      /* reverse gradient direction for right-to-left layouts */
+      &:dir(rtl) {
+        --slider-direction: to left;
+      }
+
+      /* Read min and max from attributes; --control-value is synced by script. */
+      --attr-min: attr(min type(<number>), 0);
+      --attr-max: attr(max type(<number>), 3);
+      --control-value: attr(value type(<number>), 1);
+      --slider-progress: calc(
+        progress(var(--control-value), var(--attr-min), var(--attr-max)) * 100%
+      );
+
+      appearance: none;
+      font: inherit;
+      font-size: max(1rem, 1em);
+      inline-size: 100%;
+      block-size: 3rem; /* Preserve a generous 48px interaction area. */
+      margin: 0;
+      padding: 0;
+      border: 0;
+      border-radius: 0;
+      background: transparent;
+      cursor: pointer;
+    }
+
+    @media (pointer: coarse) {
+      input[type="range"] {
+        block-size: 3.25rem;
+      }
+    }
+
+    @supports not (opacity: progress(1, 0, 100)) {
+      input[type="range"] {
+        --slider-progress: calc(
