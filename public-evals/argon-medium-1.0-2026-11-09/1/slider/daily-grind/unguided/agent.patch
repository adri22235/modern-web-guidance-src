+  <script>
+    (function () {
+      const strengths = [
+        {
+          name: 'Mild',
+          notes: 'Delicate, bright floral aroma with a light, tea-like finish.',
+          ratio: '1:18 Brew Ratio'
+        },
+        {
+          name: 'Medium',
+          notes: 'Balanced body with toasted caramel and smooth cocoa notes.',
+          ratio: '1:16 Brew Ratio'
+        },
+        {
+          name: 'Bold',
+          notes: 'Full-bodied richness with dark chocolate and roasted hazelnut undertones.',
+          ratio: '1:14 Brew Ratio'
+        },
+        {
+          name: 'Extra Bold',
+          notes: 'Intense, velvety extraction with smoky espresso depth and lingering spice.',
+          ratio: '1:12 Brew Ratio'
+        }
+      ];
+
+      const slider = document.getElementById('brew-strength-slider');
+      const fill = document.getElementById('brew-slider-fill');
+      const output = document.getElementById('brew-strength-output');
+      const notesEl = document.getElementById('brew-strength-notes');
+      const ratioEl = document.getElementById('brew-strength-ratio');
+      const stepButtons = document.querySelectorAll('.brew-step-label');
+
+      function updateBrewStrength(index) {
+        const min = Number(slider.min) || 0;
+        const max = Number(slider.max) || 3;
+        const clampedIndex = Math.max(min, Math.min(max, Number(index)));
+        const percent = ((clampedIndex - min) / (max - min)) * 100;
+        const current = strengths[clampedIndex] || strengths[1];
+
+        slider.value = String(clampedIndex);
+        slider.style.setProperty('--fill-percent', `${percent}%`);
+        slider.setAttribute('aria-valuenow', String(clampedIndex));
+        slider.setAttribute('aria-valuetext', current.name);
+
+        if (fill) {
+          fill.style.width = `${percent}%`;
+        }
+        if (output) {
+          output.textContent = current.name;
+          output.value = current.name;
+        }
+        if (notesEl) {
+          notesEl.innerHTML = `<strong>${current.name}:</strong> ${current.notes}`;
+        }
+        if (ratioEl) {
+          ratioEl.textContent = current.ratio;
+        }
+
+        stepButtons.forEach((btn) => {
+          const btnStep = Number(btn.getAttribute('data-step'));
+          btn.classList.toggle('active', btnStep === clampedIndex);
+          btn.setAttribute('aria-pressed', String(btnStep === clampedIndex));
+        });
+      }
+
+      if (slider) {
+        slider.addEventListener('input', (e) => updateBrewStrength(e.target.value));
+        slider.addEventListener('change', (e) => updateBrewStrength(e.target.value));
+
+        stepButtons.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const step = Number(btn.getAttribute('data-step'));
+            updateBrewStrength(step);
+            slider.focus();
+          });
+        });
+
+        updateBrewStrength(slider.value);
+      }
+    })();
+  </script>
