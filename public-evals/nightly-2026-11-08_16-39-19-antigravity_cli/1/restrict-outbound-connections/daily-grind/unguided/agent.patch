+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const statusEl = document.getElementById('newsletter-status');
+      const errorEl = document.getElementById('request-error');
+
+      const DEFAULT_ERROR_MESSAGE =
+        'Unable to complete request: the request could not go through (blocked or failed to reach the server).';
+
+      function hideError() {
+        if (!errorEl) return;
+        errorEl.hidden = true;
+        errorEl.textContent = '';
+      }
+
+      function showRequestError(message) {
+        if (!errorEl) return;
+        errorEl.textContent = message || DEFAULT_ERROR_MESSAGE;
+        errorEl.hidden = false;
+      }
+
+      function showSuccess(message) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.hidden = false;
+      }
+
+      // Listen for Content Security Policy violations when any disallowed request is blocked
+      function handleCspViolation(event) {
+        const target = event && event.blockedURI ? ` to ${event.blockedURI}` : '';
+        showRequestError(
+          `Request blocked${target}: the request could not go through because external connections are not permitted.`
+        );
+      }
+
+      document.addEventListener('securitypolicyviolation', handleCspViolation);
+      window.addEventListener('securitypolicyviolation', handleCspViolation);
+
+      // Wrap fetch so any network error, CSP block, or failed response immediately displays a message
+      if (typeof window.fetch === 'function') {
+        const originalFetch = window.fetch.bind(window);
+        window.fetch = async function (...args) {
+          try {
+            const response = await originalFetch(...args);
+            if (!response.ok) {
+              showRequestError(DEFAULT_ERROR_MESSAGE);
+            }
+            return response;
+          } catch (err) {
+            showRequestError(DEFAULT_ERROR_MESSAGE);
+            throw err;
+          }
+        };
+      }
+
+      // Wrap XMLHttpRequest so failed or blocked XHR requests also display a message
+      if (typeof window.XMLHttpRequest === 'function') {
+        const originalSend = XMLHttpRequest.prototype.send;
+        XMLHttpRequest.prototype.send = function (...args) {
+          this.addEventListener('error', function () {
+            showRequestError(DEFAULT_ERROR_MESSAGE);
+          });
+          this.addEventListener('load', function () {
+            if (this.status >= 400) {
+              showRequestError(DEFAULT_ERROR_MESSAGE);
+            }
+          });
+          try {
+            return originalSend.apply(this, args);
+          } catch (err) {
+            showRequestError(DEFAULT_ERROR_MESSAGE);
+            throw err;
+          }
+        };
+      }
+
+      // Wrap navigator.sendBeacon so blocked beacon requests also display a message
+      if (navigator && typeof navigator.sendBeacon === 'function') {
+        const originalSendBeacon = navigator.sendBeacon.bind(navigator);
+        navigator.sendBeacon = function (url, data) {
+          try {
+            const sent = originalSendBeacon(url, data);
+            if (!sent) {
+              showRequestError(DEFAULT_ERROR_MESSAGE);
+            }
+            return sent;
+          } catch (err) {
+            showRequestError(DEFAULT_ERROR_MESSAGE);
+            throw err;
+          }
+        };
+      }
+
+      if (form) {
+        form.addEventListener('submit', async function (event) {
+          event.preventDefault();
+          hideError();
+
+          const email = emailInput ? emailInput.value.trim() : '';
+          if (!email || !email.includes('@')) {
+            showRequestError('Please enter a valid email address. The request could not go through.');
+            return;
+          }
+
+          const endpoint = form.getAttribute('action') || '/newsletter';
+
+          try {
+            const response = await window.fetch(endpoint, {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json'
+              },
+              body: JSON.stringify({ email })
+            });
+
+            if (!response.ok) {
+              let errorText = DEFAULT_ERROR_MESSAGE;
+              try {
+                const errPayload = await response.json();
+                if (errPayload && errPayload.error) {
+                  errorText = `${errPayload.error} The request could not go through.`;
+                }
+              } catch (_) {}
+              showRequestError(errorText);
+              return;
+            }
+
+            const data = await response.json().catch(() => ({}));
+            showSuccess(data.message || 'Thank you for subscribing to The Daily Grind newsletter!');
+          } catch (err) {
+            showRequestError(DEFAULT_ERROR_MESSAGE);
+          }
+        });
+      }
+    })();
+  </script>
