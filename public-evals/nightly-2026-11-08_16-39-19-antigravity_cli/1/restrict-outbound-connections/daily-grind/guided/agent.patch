+  <script nonce="__CSP_NONCE__">
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const submitBtn = document.getElementById('newsletter-submit');
+    const statusEl = document.getElementById('newsletter-status');
+
+    function updateStatus(message, state) {
+      if (!statusEl) return;
+      statusEl.textContent = message;
+      if (state) {
+        statusEl.dataset.state = state;
+      } else {
+        delete statusEl.dataset.state;
+      }
+    }
+
+    // Client-side helper that catches blocked or failed outbound requests gracefully
+    // without unhandled promise rejections, updating customer-visible status.
+    async function fetchWithPolicyHandling(url, { statusElement = statusEl, ...fetchOptions } = {}) {
+      try {
+        const response = await fetch(url, fetchOptions);
+        const contentType = response.headers.get('content-type') || '';
+        const payload = contentType.includes('application/json')
+          ? await response.json()
+          : { message: await response.text() };
+
+        if (!response.ok) {
+          const errorMessage = payload?.message || `HTTP ${response.status}`;
+          if (statusElement) {
+            statusElement.dataset.state = 'error';
+            statusElement.textContent = `Could not complete your request: ${errorMessage}`;
+          }
+          return { ok: false, body: payload, error: new Error(errorMessage) };
+        }
+
+        const successMessage =
+          payload?.message || 'Thanks for subscribing! Your email was received.';
+        if (statusElement) {
+          statusElement.dataset.state = 'success';
+          statusElement.textContent = successMessage;
+        }
+        return { ok: true, body: payload, error: null };
+      } catch (error) {
+        const reason = error instanceof Error ? error.message : String(error);
+        if (statusElement) {
+          statusElement.dataset.state = 'error';
+          statusElement.textContent =
+            `Your request to ${url} could not go through because it was blocked by our outbound connection security policy or a network error (${reason}).`;
+        }
+        return { ok: false, body: null, error };
+      }
+    }
+
+    window.fetchWithPolicyHandling = fetchWithPolicyHandling;
+
+    // Surface any runtime Content Security Policy violation in the customer message area
+    document.addEventListener('securitypolicyviolation', (event) => {
+      const blockedTarget = event.blockedURI || event.effectiveDirective;
+      updateStatus(
+        `Request blocked: Outbound connection to ${blockedTarget} is not permitted by our security policy.`,
+        'error',
+      );
+    });
+
+    // Validate on blur (if edited) and clear custom error state on input
+    emailInput?.addEventListener('blur', () => {
+      if (!emailInput.value) return;
+      if (!emailInput.checkValidity()) {
+        emailInput.setAttribute('aria-invalid', 'true');
+        updateStatus('Please enter a valid email address (for example, alex@example.com).', 'error');
+      }
+    });
+
+    emailInput?.addEventListener('input', () => {
+      emailInput.setCustomValidity('');
+      if (emailInput.checkValidity()) {
+        emailInput.removeAttribute('aria-invalid');
+        if (statusEl?.dataset.state === 'error') {
+          updateStatus('', '');
+        }
+      }
+    });
+
+    form?.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      if (!emailInput.checkValidity()) {
+        emailInput.setAttribute('aria-invalid', 'true');
+        updateStatus('Please enter a valid email address before subscribing.', 'error');
+        emailInput.focus();
+        return;
+      }
+
+      emailInput.removeAttribute('aria-invalid');
+      const endpoint = form.getAttribute('action') || '/api/newsletter';
+      const email = emailInput.value.trim();
+
+      submitBtn.disabled = true;
+      try {
+        const result = await fetchWithPolicyHandling(endpoint, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            Accept: 'application/json',
+          },
+          body: JSON.stringify({ email }),
+          statusElement: statusEl,
+        });
+
+        if (result.ok) {
