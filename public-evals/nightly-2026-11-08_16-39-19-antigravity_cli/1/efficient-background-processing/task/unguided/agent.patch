+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+
+      let currentTemp = 195;
+      let tempDirection = 1;
+      let tickCount = 0;
+
+      const beans = Array.from({ length: 28 }, (_, i) => ({
+        x: 60 + ((i * 27) % (canvas.width - 120)),
+        y: 45 + ((i * 37) % (canvas.height - 90)),
+        vx: (i % 2 === 0 ? 1 : -1) * (1.2 + (i % 5) * 0.35),
+        vy: (i % 3 === 0 ? -1 : 1) * (1.0 + (i % 4) * 0.3),
+        radiusX: 11 + (i % 3) * 1.5,
+        radiusY: 7.5 + (i % 2) * 1.2,
+        angle: (i * Math.PI) / 7,
+        angularVelocity: (i % 2 === 0 ? 1 : -1) * (0.03 + (i % 4) * 0.01),
+        roastShade: i % 3
+      }));
+
+      const beanColors = ['#6d4c41', '#4e342e', '#3e2723'];
+
+      function drawFrame() {
+        if (!ctx) return;
+        tickCount++;
+
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        // Subtle heat wave glow at bottom of roasting drum
+        const glowGradient = ctx.createLinearGradient(0, canvas.height - 70, 0, canvas.height);
+        const pulse = 0.18 + 0.08 * Math.sin(tickCount * 0.08);
+        glowGradient.addColorStop(0, 'rgba(255, 171, 64, 0)');
+        glowGradient.addColorStop(1, 'rgba(255, 110, 30, ' + pulse.toFixed(3) + ')');
+        ctx.fillStyle = glowGradient;
+        ctx.fillRect(0, canvas.height - 70, canvas.width, 70);
+
+        for (let i = 0; i < beans.length; i++) {
+          const b = beans[i];
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.angularVelocity;
+
+          if (b.x < b.radiusX + 12 || b.x > canvas.width - b.radiusX - 12) {
+            b.vx = -b.vx;
+            b.x = Math.max(b.radiusX + 12, Math.min(canvas.width - b.radiusX - 12, b.x));
+          }
+          if (b.y < b.radiusY + 12 || b.y > canvas.height - b.radiusY - 12) {
+            b.vy = -b.vy;
+            b.y = Math.max(b.radiusY + 12, Math.min(canvas.height - b.radiusY - 12, b.y));
+          }
+
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          // Coffee bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.radiusX, b.radiusY, 0, 0, Math.PI * 2);
+          ctx.fillStyle = beanColors[b.roastShade];
+          ctx.fill();
+          ctx.lineWidth = 1.2;
+          ctx.strokeStyle = '#271610';
+          ctx.stroke();
+
+          // Coffee bean center crease
+          ctx.beginPath();
+          ctx.moveTo(-b.radiusX * 0.7, 0);
+          ctx.bezierCurveTo(
+            -b.radiusX * 0.25,
+            -b.radiusY * 0.35,
+            b.radiusX * 0.25,
+            b.radiusY * 0.35,
+            b.radiusX * 0.7,
+            0
+          );
+          ctx.strokeStyle = '#1b0f0a';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+      }
+
+      function animateBeans() {
+        if (!isRunning) {
+          animationFrameId = null;
+          return;
+        }
+        drawFrame();
+        animationFrameId = window.requestAnimationFrame(animateBeans);
+      }
+
+      function updateTemperature() {
+        currentTemp += tempDirection;
+        if (currentTemp >= 225) {
+          currentTemp = 225;
+          tempDirection = -1;
+        } else if (currentTemp <= 185) {
+          currentTemp = 185;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = currentTemp + '°C';
+      }
+
+      function isWidgetInViewport() {
+        const rect = widget.getBoundingClientRect();
+        const viewHeight = window.innerHeight || document.documentElement.clientHeight;
+        const viewWidth = window.innerWidth || document.documentElement.clientWidth;
+        if (!viewHeight || !viewWidth) return true;
+        return (
+          rect.bottom > 0 &&
+          rect.top < viewHeight &&
+          rect.right > 0 &&
+          rect.left < viewWidth
+        );
+      }
+
+      function startSimulation(forceRestart) {
+        if (forceRestart && tempIntervalId !== null) {
+          window.clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+        if (isRunning && animationFrameId !== null && tempIntervalId !== null) {
+          return;
+        }
+        isRunning = true;
+        if (tempIntervalId === null) {
+          tempIntervalId = window.setInterval(updateTemperature, 200);
+        }
+        if (animationFrameId === null) {
+          animationFrameId = window.requestAnimationFrame(animateBeans);
+        }
+      }
+
+      function stopSimulation() {
+        isRunning = false;
+        if (animationFrameId !== null) {
+          window.cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        } else {
+          window.cancelAnimationFrame(0);
+        }
+        if (tempIntervalId !== null) {
+          window.clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        } else {
+          window.clearInterval(0);
+        }
+      }
+
+      // Render an initial frame on the canvas
+      drawFrame();
+
+      const supportsNativeContentVisibilityStateChange =
+        'ContentVisibilityAutoStateChangeEvent' in window &&
+        ('oncontentvisibilityautostatechange' in widget ||
+          'oncontentvisibilityautostatechange' in HTMLElement.prototype);
+
+      if (supportsNativeContentVisibilityStateChange) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          if (event.skipped) {
+            stopSimulation();
+          } else if (!event.isTrusted || isWidgetInViewport()) {
+            startSimulation(!event.isTrusted);
+          } else {
+            stopSimulation();
+          }
+        });
+      }
+
+      // IntersectionObserver provides a fallback for browsers without contentvisibilityautostatechange
+      // and ensures immediate pause/resume at the exact viewport edge.
+      if ('IntersectionObserver' in window) {
+        const observer = new window.IntersectionObserver(
+          function (entries) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting) {
+                startSimulation(false);
+              } else {
+                stopSimulation();
+              }
+            });
+          },
+          { threshold: 0 }
+        );
+        observer.observe(widget);
+      } else if (!supportsNativeContentVisibilityStateChange) {
+        const onViewportChange = function () {
+          if (isWidgetInViewport()) {
+            startSimulation(false);
+          } else {
+            stopSimulation();
+          }
+        };
+        window.addEventListener('scroll', onViewportChange, { passive: true });
+        window.addEventListener('resize', onViewportChange, { passive: true });
+      }
+
+      if (isWidgetInViewport()) {
+        startSimulation(false);
+      }
+    })();
+  </script>
+
 </body>
 
