+  <script>
+    (function () {
+      const roastingWidget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      if (!roastingWidget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+
+      // Simulated roasting temperature state
+      let currentTemp = 395.0;
+      let tempDirection = 1;
+
+      // Coffee beans particle state for canvas animation
+      const beanCount = 28;
+      const beans = Array.from({ length: beanCount }, (_, i) => ({
+        x: 60 + ((i * 27) % (canvas.width - 120)),
+        y: 50 + ((i * 43) % (canvas.height - 100)),
+        vx: (i % 2 === 0 ? 1 : -1) * (1.2 + (i % 5) * 0.35),
+        vy: -1.5 + (i % 7) * 0.45,
+        angle: (i * 0.45) % (Math.PI * 2),
+        spin: (i % 2 === 0 ? 1 : -1) * (0.03 + (i % 4) * 0.01),
+        rx: 12 + (i % 4) * 1.5,
+        ry: 8 + (i % 3) * 1.2
+      }));
+
+      function drawRoastFrame() {
+        if (!isRunning) return;
+
+        if (ctx) {
+          const width = canvas.width;
+          const height = canvas.height;
+
+          ctx.clearRect(0, 0, width, height);
+
+          // Subtle thermal glow at bottom of roasting drum
+          const glow = ctx.createLinearGradient(0, height * 0.4, 0, height);
+          glow.addColorStop(0, 'rgba(26, 15, 13, 0)');
+          glow.addColorStop(1, 'rgba(255, 111, 0, 0.18)');
+          ctx.fillStyle = glow;
+          ctx.fillRect(0, 0, width, height);
+
+          // Calculate bean color progression based on drum temperature (385°F - 435°F)
+          const roastProgress = Math.max(0, Math.min(1, (currentTemp - 385) / 50));
+          const r = Math.round(145 - roastProgress * 75);
+          const g = Math.round(98 - roastProgress * 58);
+          const b = Math.round(58 - roastProgress * 38);
+          const beanColor = `rgb(${r}, ${g}, ${b})`;
+
+          for (let i = 0; i < beans.length; i++) {
+            const bean = beans[i];
+            bean.x += bean.vx;
+            bean.y += bean.vy;
+            bean.vy += 0.06; // gravity inside rotating drum
+            bean.angle += bean.spin;
+
+            // Bounce off drum walls and agitator paddles
+            if (bean.x < bean.rx + 12) {
+              bean.x = bean.rx + 12;
+              bean.vx = Math.abs(bean.vx);
+            } else if (bean.x > width - bean.rx - 12) {
+              bean.x = width - bean.rx - 12;
+              bean.vx = -Math.abs(bean.vx);
+            }
+
+            if (bean.y > height - bean.ry - 12) {
+              bean.y = height - bean.ry - 12;
+              bean.vy = -(2.4 + (i % 5) * 0.45);
+            } else if (bean.y < bean.ry + 12) {
+              bean.y = bean.ry + 12;
+              bean.vy = Math.abs(bean.vy) * 0.6;
+            }
+
+            ctx.save();
+            ctx.translate(bean.x, bean.y);
+            ctx.rotate(bean.angle);
+
+            // Bean body
+            ctx.beginPath();
+            ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+            ctx.fillStyle = beanColor;
+            ctx.fill();
+            ctx.lineWidth = 1.2;
+            ctx.strokeStyle = 'rgba(30, 15, 10, 0.85)';
+            ctx.stroke();
+
+            // Center roast crack/crease
+            ctx.beginPath();
+            ctx.moveTo(-bean.rx * 0.7, 0);
+            ctx.quadraticCurveTo(0, bean.ry * 0.25, bean.rx * 0.7, 0);
+            ctx.strokeStyle = '#24120d';
+            ctx.lineWidth = 1.5;
+            ctx.stroke();
+
+            ctx.restore();
+          }
+        }
+
+        animationFrameId = requestAnimationFrame(drawRoastFrame);
+      }
+
+      function updateTemperature() {
+        if (!isRunning) return;
+        currentTemp += tempDirection * 0.7;
+        if (currentTemp >= 432.0) {
+          currentTemp = 432.0;
+          tempDirection = -1;
+        } else if (currentTemp <= 388.0) {
+          currentTemp = 388.0;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°F`;
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(drawRoastFrame);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 200);
+        }
+      }
+
+      function stopSimulation() {
+        isRunning = false;
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Start initially; contentvisibilityautostatechange or IntersectionObserver will pause when off-screen
+      startSimulation();
+
+      // Native rendering state change listener
+      roastingWidget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          stopSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      // Fallback using IntersectionObserver for older browsers lacking content-visibility support
+      const isSupported = 'contentVisibility' in document.documentElement.style;
+
+      if (!isSupported) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(roastingWidget);
+      }
+    })();
+  </script>
 </body>
 
