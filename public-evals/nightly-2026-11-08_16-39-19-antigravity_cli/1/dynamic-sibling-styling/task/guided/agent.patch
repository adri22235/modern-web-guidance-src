+  <script>
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const updateGroup = (items) => {
+        items.forEach((item, index) => {
+          item.style.setProperty('--sibling-index', index + 1);
+          item.style.setProperty('--sibling-count', items.length);
+        });
+      };
+
+      const selectors = ['.spectrum-card', '.fan-card', '.circle-orb'];
+      selectors.forEach((selector) => {
+        const items = document.querySelectorAll(selector);
+        updateGroup(items);
+      });
+
+      const containers = document.querySelectorAll('.grid, .fan-container, .circle-container');
+      const observer = new MutationObserver((mutations) => {
+        mutations.forEach((mutation) => {
+          const children = Array.from(mutation.target.children);
+          updateGroup(children);
+        });
+      });
+      containers.forEach((container) => {
+        observer.observe(container, { childList: true });
+      });
+    }
+  </script>
 </body>
 
