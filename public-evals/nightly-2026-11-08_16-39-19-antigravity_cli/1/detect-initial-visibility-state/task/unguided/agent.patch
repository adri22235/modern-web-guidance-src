+  <script>
+    (function checkInitialBackgroundLoad() {
+      const visibilityEntries = typeof performance !== 'undefined' && typeof performance.getEntriesByType === 'function'
+        ? performance.getEntriesByType('visibility-state')
+        : [];
+
+      if (visibilityEntries.length > 0) {
+        const initialEntry = visibilityEntries[0];
+        const isBackgrounded = initialEntry.name === 'hidden';
+        const timestamp = initialEntry.startTime;
+
+        console.log({
+          backgrounded: isBackgrounded,
+          loadedInBackground: isBackgrounded,
+          visibilityState: initialEntry.name,
+          timestamp: timestamp,
+          timestampMs: timestamp,
+          startTime: timestamp,
+          method: 'VisibilityStateEntry (performance.getEntriesByType("visibility-state"))',
+          note: 'Checked via Performance Timeline VisibilityStateEntry API, which reliably records the initial visibility state at navigation start (0ms). Older fallback checks like document.visibilityState or document.hidden only reflect the current state at execution time and are unreliable for async or deferred scripts.'
+        });
+      } else {
+        const currentVisibility = document.visibilityState;
+        const isBackgrounded = currentVisibility === 'hidden' || document.hidden === true;
+        const timestamp = typeof performance !== 'undefined' && typeof performance.now === 'function'
+          ? performance.now()
+          : Date.now();
+
+        console.log({
+          backgrounded: isBackgrounded,
+          loadedInBackground: isBackgrounded,
+          visibilityState: currentVisibility,
+          timestamp: timestamp,
+          timestampMs: timestamp,
+          startTime: timestamp,
+          method: 'document.visibilityState (fallback)',
+          note: 'Warning: Older fallback checks (document.visibilityState / document.hidden) are unreliable for async or deferred scripts because the tab visibility state may have changed between initial page navigation and when the script executes.'
+        });
+      }
+    })();
+  </script>
