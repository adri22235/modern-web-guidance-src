+  <script>
+    const sweetnessRange = document.getElementById('sweetness-range');
+    const sweetnessOutput = document.getElementById('sweetness-output');
+    const sweetnessLabels = ['0 Pumps (Unsweetened)', '1 Pump (Light)', '2 Pumps (Standard)', '3 Pumps (Sweet)', '4 Pumps (Extra Sweet)'];
+
+    if (sweetnessRange && sweetnessOutput) {
+      sweetnessRange.addEventListener('input', () => {
+        const val = Number(sweetnessRange.value);
+        sweetnessOutput.textContent = sweetnessLabels[val] || `${val} Pumps`;
+      });
+    }
+
+    const sleeveColorInput = document.getElementById('cup-sleeve-color');
+    const colorHexLabel = document.getElementById('color-hex-label');
+    if (sleeveColorInput && colorHexLabel) {
+      sleeveColorInput.addEventListener('input', () => {
+        colorHexLabel.textContent = sleeveColorInput.value;
+      });
+    }
+
+    const orderForm = document.getElementById('coffee-order-form');
+    const orderStatus = document.getElementById('order-status');
+    if (orderForm && orderStatus) {
+      orderForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const drinkSelect = document.getElementById('drink-select');
+        const selectedDrink = drinkSelect.options[drinkSelect.selectedIndex].text;
+        const customerName = document.getElementById('cup-name').value || 'Guest';
+        const pickupTime = document.getElementById('pickup-time').value;
+        orderStatus.textContent = `Order queued for ${customerName}: ${selectedDrink} ready for pickup at ${pickupTime}.`;
+        orderStatus.classList.add('visible');
+      });
+
+      orderForm.addEventListener('reset', () => {
+        setTimeout(() => {
+          if (sweetnessRange && sweetnessOutput) {
+            sweetnessOutput.textContent = sweetnessLabels[Number(sweetnessRange.value)];
+          }
+          if (sleeveColorInput && colorHexLabel) {
+            colorHexLabel.textContent = `${sleeveColorInput.value} (Espresso Brown)`;
+          }
+          orderStatus.classList.remove('visible');
+        }, 0);
+      });
+    }
+  </script>
+
