+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackTextarea = document.getElementById('feedback-textarea');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    feedbackTextarea.addEventListener('keydown', (event) => {
+      if (event.key === 'Enter' && !event.shiftKey) {
+        event.preventDefault();
+        if (typeof feedbackForm.requestSubmit === 'function') {
+          feedbackForm.requestSubmit();
+        } else {
+          feedbackForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
+        }
+      }
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      feedbackTextarea.value = '';
+      feedbackStatus.classList.add('visible');
+    });
+  </script>
