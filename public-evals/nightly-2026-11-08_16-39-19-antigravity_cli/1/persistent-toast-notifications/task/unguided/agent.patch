+      gap: 16px;
+      font-size: 0.95rem;
+      font-weight: 500;
+      pointer-events: none;
+      opacity: 0;
+      transform: translateY(12px) scale(0.96);
+      transition:
+        opacity 0.2s ease,
+        transform 0.2s ease,
+        bottom 0.25s cubic-bezier(0.22, 1, 0.36, 1),
+        display 0.2s allow-discrete,
