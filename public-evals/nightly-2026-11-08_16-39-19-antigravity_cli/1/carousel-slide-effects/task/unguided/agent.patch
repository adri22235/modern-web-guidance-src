+
+    /* Product Carousel (.scroller) */
+    .carousel-section {
+      margin: 60px 0;
+    }
+
+    .carousel-header {
+      text-align: center;
+      margin-bottom: 10px;
+    }
+
+    .carousel-subtitle {
+      text-align: center;
+      color: #5d4037;
+      margin-bottom: 20px;
+      font-size: 0.95rem;
+    }
+
+    @keyframes scale-card {
+      0% {
+        transform: scale(0.82);
+        opacity: 0.75;
+      }
+      50% {
+        transform: scale(1.08);
+        opacity: 1;
+      }
+      100% {
+        transform: scale(0.82);
+        opacity: 0.75;
+      }
+    }
+
+    .scroller {
+      display: flex;
+      gap: 2rem;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      padding-block: 2.5rem;
+      padding-inline: max(2rem, calc(50% - 150px));
+      margin-inline: calc(-50vw + 50%);
+      width: 100vw;
+      max-width: 100vw;
+      align-items: stretch;
+      scrollbar-color: var(--primary) var(--secondary);
+      scrollbar-width: thin;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: -3px;
+    }
+
+    .scroller .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      background: white;
+      padding: 20px;
+      border-radius: 12px;
+      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
+      transition: box-shadow 0.3s ease;
+      transform-origin: center center;
+      view-timeline-name: --card-timeline;
+      view-timeline-axis: inline;
+      animation: scale-card linear both;
+      animation-timeline: view(inline);
+      animation-range: cover 0% cover 100%;
+    }
+
+    .scroller .card:focus-within {
+      box-shadow: 0 8px 24px rgba(78, 52, 46, 0.28);
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .scroller .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 8px;
+      margin-bottom: 15px;
+    }
+
+    .scroller .card .price {
+      font-weight: bold;
+      font-size: 1.15rem;
+      color: var(--primary);
+      margin-top: 10px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .scroller {
+        scroll-behavior: smooth;
+      }
+
+      .scroller .card {
+        animation: scale-card linear both;
+        animation-timeline: view(inline);
+        animation-range: cover 0% cover 100%;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .scroller .card {
+        animation: none;
+        transform: none;
+        opacity: 1;
+        transition: none;
+      }
+    }
+
