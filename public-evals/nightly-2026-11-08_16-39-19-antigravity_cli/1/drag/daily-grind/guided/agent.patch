+
+  <script>
+    (() => {
+      const draggable = document.querySelector('[data-draggable]');
+      const handle = draggable?.querySelector('[data-drag-handle]');
+      if (!draggable || !handle) return;
+
+      const grip = handle.querySelector('.drag-grip');
+      if (grip) grip.hidden = false;
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let activePointerId = null;
+      let hasCustomPosition = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+        draggable.style.right = 'auto';
+        draggable.style.bottom = 'auto';
+        draggable.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        draggable.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        hasCustomPosition = true;
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+
+        const rect = draggable.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        activePointerId = event.pointerId;
+        if (typeof handle.setPointerCapture === 'function') {
+          try {
+            handle.setPointerCapture(event.pointerId);
+          } catch {}
+        }
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        const isCaptured =
+          (typeof handle.hasPointerCapture === 'function' && handle.hasPointerCapture(event.pointerId)) ||
+          activePointerId === event.pointerId;
+        if (!isCaptured) return;
+
+        handle.classList.add('dragging');
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      function endDrag(event) {
+        if (activePointerId !== null && event?.pointerId !== undefined && event.pointerId !== activePointerId) {
+          return;
+        }
+        activePointerId = null;
+        handle.classList.remove('dragging');
+      }
+
+      handle.addEventListener('lostpointercapture', endDrag);
+      handle.addEventListener('pointerup', endDrag);
+      handle.addEventListener('pointercancel', endDrag);
+
+      const KEY_STEP = 15;
+      const KEY_DELTAS = {
+        ArrowLeft: [-KEY_STEP, 0],
+        ArrowRight: [KEY_STEP, 0],
+        ArrowUp: [0, -KEY_STEP],
+        ArrowDown: [0, KEY_STEP],
+      };
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const delta = KEY_DELTAS[event.key];
+        if (!delta) return;
+
+        event.preventDefault();
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+      });
+
+      function reclampIfNeeded() {
+        if (!hasCustomPosition) return;
+        const currentLeft = parseFloat(draggable.style.left);
+        const currentTop = parseFloat(draggable.style.top);
+        if (!Number.isNaN(currentLeft) && !Number.isNaN(currentTop)) {
+          moveTo(currentLeft, currentTop);
+        }
+      }
+
+      window.addEventListener('resize', reclampIfNeeded);
+      if (typeof ResizeObserver === 'function') {
+        new ResizeObserver(reclampIfNeeded).observe(draggable);
+      }
+
+      // Interactive coffee cart controls
+      const collapseBtn = document.getElementById('cart-collapse-btn');
+      const cartBody = document.getElementById('quick-cart-body');
+      const addForm = document.getElementById('quick-add-form');
+      const drinkSelect = document.getElementById('quick-drink-select');
+      const itemsList = document.getElementById('cart-items-list');
+      const countBadge = document.getElementById('cart-count-badge');
+      const subtotalEl = document.getElementById('cart-subtotal');
+      const checkoutBtn = document.getElementById('cart-checkout-btn');
+      const statusMsg = document.getElementById('cart-status-msg');
+      const notesInput = document.getElementById('cart-notes-input');
+
+      collapseBtn?.addEventListener('click', () => {
+        const isExpanded = collapseBtn.getAttribute('aria-expanded') === 'true';
+        collapseBtn.setAttribute('aria-expanded', String(!isExpanded));
+        collapseBtn.textContent = isExpanded ? 'Expand' : 'Minimize';
+        if (cartBody) cartBody.hidden = isExpanded;
+        reclampIfNeeded();
+      });
+
+      function updateCartSummary() {
+        const items = Array.from(itemsList.querySelectorAll('.cart-item'));
+        let totalQty = 0;
+        let totalPrice = 0;
+
+        for (const item of items) {
+          const qty = parseInt(item.dataset.qty || '0', 10);
+          const price = parseFloat(item.dataset.price || '0');
+          totalQty += qty;
+          totalPrice += qty * price;
+        }
+
+        countBadge.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'}`;
+        subtotalEl.textContent = `$${totalPrice.toFixed(2)}`;
+        checkoutBtn.disabled = totalQty === 0;
+      }
+
+      function addDrinkToCart(name, price) {
+        const existing = Array.from(itemsList.querySelectorAll('.cart-item')).find(
+          (li) => li.dataset.name === name
+        );
+
+        if (existing) {
+          const nextQty = parseInt(existing.dataset.qty || '1', 10) + 1;
+          existing.dataset.qty = String(nextQty);
+          existing.querySelector('.qty-value').textContent = String(nextQty);
+        } else {
+          const li = document.createElement('li');
+          li.className = 'cart-item';
+          li.dataset.name = name;
+          li.dataset.price = price.toFixed(2);
+          li.dataset.qty = '1';
+
+          const info = document.createElement('div');
+          info.className = 'cart-item-info';
+          const nameSpan = document.createElement('span');
+          nameSpan.className = 'cart-item-name';
+          nameSpan.textContent = name;
+          const priceSpan = document.createElement('span');
+          priceSpan.className = 'cart-item-price';
+          priceSpan.textContent = `$${price.toFixed(2)} each`;
+          info.append(nameSpan, priceSpan);
+
+          const controls = document.createElement('div');
+          controls.className = 'cart-item-controls';
+
+          const decBtn = document.createElement('button');
+          decBtn.type = 'button';
+          decBtn.className = 'qty-btn';
+          decBtn.dataset.action = 'dec';
+          decBtn.setAttribute('aria-label', `Decrease quantity of ${name}`);
+          decBtn.textContent = '\u2212';
+
+          const qtyVal = document.createElement('span');
+          qtyVal.className = 'qty-value';
+          qtyVal.textContent = '1';
+
+          const incBtn = document.createElement('button');
+          incBtn.type = 'button';
+          incBtn.className = 'qty-btn';
+          incBtn.dataset.action = 'inc';
+          incBtn.setAttribute('aria-label', `Increase quantity of ${name}`);
+          incBtn.textContent = '+';
+
+          controls.append(decBtn, qtyVal, incBtn);
+          li.append(info, controls);
+          itemsList.appendChild(li);
+        }
+
+        statusMsg.textContent = `Added ${name} to cart.`;
+        updateCartSummary();
+      }
+
+      addForm?.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const [name, rawPrice] = (drinkSelect.value || '').split('|');
+        const price = parseFloat(rawPrice);
+        if (name && !Number.isNaN(price)) {
+          addDrinkToCart(name, price);
+        }
+      });
+
+      itemsList?.addEventListener('click', (event) => {
+        const btn = event.target.closest('button[data-action]');
+        if (!btn) return;
+        const item = btn.closest('.cart-item');
+        if (!item) return;
+
+        const currentQty = parseInt(item.dataset.qty || '1', 10);
+        const nextQty = btn.dataset.action === 'inc' ? currentQty + 1 : currentQty - 1;
+
+        if (nextQty <= 0) {
+          item.remove();
+        } else {
+          item.dataset.qty = String(nextQty);
+          item.querySelector('.qty-value').textContent = String(nextQty);
+        }
+        statusMsg.textContent = '';
+        updateCartSummary();
+      });
+
+      checkoutBtn?.addEventListener('click', () => {
+        const noteText = notesInput?.value.trim();
+        statusMsg.textContent = noteText
+          ? `Order placed! Ready in ~5 mins (${noteText}).`
+          : 'Order placed! Ready for pickup in ~5 mins.';
+      });
+    })();
+  </script>
 </body>
 
