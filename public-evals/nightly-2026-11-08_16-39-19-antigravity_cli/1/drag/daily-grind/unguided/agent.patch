+  <script>
+    (function () {
+      const panel = document.querySelector('[data-draggable]');
+      const handle = panel ? panel.querySelector('[data-drag-handle]') : null;
+
+      if (panel && handle) {
+        let isDragging = false;
+        let startX = 0;
+        let startY = 0;
+        let initialLeft = 0;
+        let initialTop = 0;
+
+        function getCoords(e) {
+          if (e.touches && e.touches.length > 0) {
+            return { x: e.touches[0].clientX, y: e.touches[0].clientY };
+          }
+          if (e.changedTouches && e.changedTouches.length > 0) {
+            return { x: e.changedTouches[0].clientX, y: e.changedTouches[0].clientY };
+          }
+          return {
+            x: typeof e.clientX === 'number' ? e.clientX : (typeof e.pageX === 'number' ? e.pageX : 0),
+            y: typeof e.clientY === 'number' ? e.clientY : (typeof e.pageY === 'number' ? e.pageY : 0)
+          };
+        }
+
+        function startDrag(e) {
+          if (typeof e.button === 'number' && e.button !== 0) return;
+          if (!handle.contains(e.target) && e.target !== handle) return;
+
+          if (!isDragging) {
+            const rect = panel.getBoundingClientRect();
+            const coords = getCoords(e);
+            isDragging = true;
+            startX = coords.x;
+            startY = coords.y;
+            initialLeft = rect.left;
+            initialTop = rect.top;
+            panel.style.left = initialLeft + 'px';
+            panel.style.top = initialTop + 'px';
+            panel.style.right = 'auto';
+            panel.style.bottom = 'auto';
+            panel.style.margin = '0';
+            panel.setAttribute('data-dragging', 'true');
+          }
+
+          if (e.cancelable && e.type === 'mousedown') {
+            e.preventDefault();
+          }
+        }
+
+        function onDragMove(e) {
+          if (!isDragging) return;
+          const coords = getCoords(e);
+          const dx = coords.x - startX;
+          const dy = coords.y - startY;
+          panel.style.left = (initialLeft + dx) + 'px';
+          panel.style.top = (initialTop + dy) + 'px';
+        }
+
+        function stopDrag() {
+          if (!isDragging) return;
+          isDragging = false;
+          panel.removeAttribute('data-dragging');
+        }
+
+        handle.addEventListener('pointerdown', startDrag);
+        handle.addEventListener('mousedown', startDrag);
+        handle.addEventListener('touchstart', startDrag, { passive: true });
+        handle.addEventListener('dragstart', function (e) { e.preventDefault(); });
+
+        window.addEventListener('pointermove', onDragMove, true);
+        window.addEventListener('mousemove', onDragMove, true);
+        window.addEventListener('touchmove', onDragMove, { capture: true, passive: true });
+
+        document.addEventListener('pointermove', onDragMove, true);
+        document.addEventListener('mousemove', onDragMove, true);
+
+        window.addEventListener('pointerup', stopDrag, true);
+        window.addEventListener('mouseup', stopDrag, true);
+        window.addEventListener('touchend', stopDrag, true);
+        window.addEventListener('pointercancel', stopDrag, true);
+
+        document.addEventListener('pointerup', stopDrag, true);
+        document.addEventListener('mouseup', stopDrag, true);
+      }
+
+      // Interactive Cart Logic
+      const itemRows = Array.from(document.querySelectorAll('.quick-order-item'));
+      const badgeEl = document.getElementById('cart-badge');
+      const totalEl = document.getElementById('cart-total');
+      const cupSizeEl = document.getElementById('cup-size');
+      const milkChoiceEl = document.getElementById('milk-choice');
+      const extraShotEl = document.getElementById('extra-shot');
+      const clearBtn = document.getElementById('clear-cart-btn');
+      const orderBtn = document.getElementById('place-order-btn');
+      const statusEl = document.getElementById('order-status');
+
+      function updateCartSummary() {
+        let totalItems = 0;
+        let baseSubtotal = 0;
+
+        itemRows.forEach(function (row) {
+          const price = parseFloat(row.getAttribute('data-price') || '0');
+          const qtyEl = row.querySelector('[data-qty]');
+          const qty = parseInt(qtyEl ? qtyEl.textContent : '0', 10) || 0;
+          totalItems += qty;
+          baseSubtotal += price * qty;
+        });
+
+        const sizeUpcharge = cupSizeEl ? parseFloat(cupSizeEl.value || '0') : 0;
+        const shotUpcharge = (extraShotEl && extraShotEl.checked) ? parseFloat(extraShotEl.value || '0') : 0;
+        const total = totalItems > 0 ? baseSubtotal + (sizeUpcharge * totalItems) + shotUpcharge : 0;
+
+        if (badgeEl) {
+          badgeEl.textContent = totalItems + (totalItems === 1 ? ' item' : ' items');
+        }
+        if (totalEl) {
+          totalEl.textContent = '$' + total.toFixed(2);
+        }
+      }
+
+      itemRows.forEach(function (row) {
+        const qtyEl = row.querySelector('[data-qty]');
+        const decBtn = row.querySelector('[data-action="decrease"]');
+        const incBtn = row.querySelector('[data-action="increase"]');
+
+        if (decBtn && qtyEl) {
+          decBtn.addEventListener('click', function () {
+            const current = parseInt(qtyEl.textContent, 10) || 0;
+            qtyEl.textContent = String(Math.max(0, current - 1));
+            if (statusEl) statusEl.textContent = '';
+            updateCartSummary();
+          });
+        }
+
+        if (incBtn && qtyEl) {
+          incBtn.addEventListener('click', function () {
+            const current = parseInt(qtyEl.textContent, 10) || 0;
+            qtyEl.textContent = String(current + 1);
+            if (statusEl) statusEl.textContent = '';
+            updateCartSummary();
+          });
+        }
+      });
+
+      if (cupSizeEl) cupSizeEl.addEventListener('change', updateCartSummary);
+      if (milkChoiceEl) milkChoiceEl.addEventListener('change', updateCartSummary);
+      if (extraShotEl) extraShotEl.addEventListener('change', updateCartSummary);
+
+      if (clearBtn) {
+        clearBtn.addEventListener('click', function () {
+          itemRows.forEach(function (row) {
+            const qtyEl = row.querySelector('[data-qty]');
+            if (qtyEl) qtyEl.textContent = '0';
+          });
+          if (cupSizeEl) cupSizeEl.value = '0';
+          if (extraShotEl) extraShotEl.checked = false;
+          if (statusEl) statusEl.textContent = 'Cart cleared.';
+          updateCartSummary();
+        });
+      }
+
+      if (orderBtn) {
+        orderBtn.addEventListener('click', function () {
+          const countText = badgeEl ? badgeEl.textContent : '0 items';
+          if (countText.startsWith('0 ')) {
+            if (statusEl) statusEl.textContent = 'Please add at least 1 coffee first.';
+            return;
+          }
+          const milk = milkChoiceEl ? milkChoiceEl.options[milkChoiceEl.selectedIndex].text : 'Oat Milk';
+          if (statusEl) {
+            statusEl.textContent = 'Order placed (' + countText + ', ' + milk + ')! Ready in ~5 mins.';
+          }
+        });
+      }
+
+      updateCartSummary();
+    })();
+  </script>
 </body>
 
