+export interface ReaderAccount {
+  id: string;
+  userId: string; // Base64URL-encoded user handle for WebAuthn Signal API
+  username: string;
+  name: string;
+  displayName: string;
+  email: string;
+  subscriptionPlan: string;
+}
+
+export interface PasskeyCredential {
+  id: string;
+  credentialId: string; // Base64URL-encoded credential ID for WebAuthn Signal API
+  name: string;
+  displayName: string;
+  authenticatorName: string;
+  deviceType: 'multiDevice' | 'singleDevice';
+  createdAt: string;
+  lastUsedAt: string | null;
+  transports: string[];
+  backedUp: boolean;
+}
+
+export interface SignalSyncResult {
+  synced: boolean;
+  method: 'signalAllAcceptedCredentials' | 'signalCurrentUserDetails' | 'signalUnknownCredential';
+  supported: boolean;
+  timestamp: string;
+  payload: Record<string, unknown>;
+  error?: string;
+}
+
+/**
+ * Normalizes a Base64 or Base64URL string to unpadded Base64URL format.
+ */
+export function normalizeBase64Url(value: string): string {
+  return value.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+/**
+ * Encodes a string, Uint8Array, or ArrayBuffer into an unpadded Base64URL string.
+ */
+export function toBase64Url(input: string | Uint8Array | ArrayBuffer): string {
+  let bytes: Uint8Array;
+  if (typeof input === 'string') {
+    bytes = new TextEncoder().encode(input);
+  } else if (input instanceof ArrayBuffer) {
+    bytes = new Uint8Array(input);
+  } else {
+    bytes = input;
+  }
+
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+
+  const base64 =
+    typeof btoa === 'function'
+      ? btoa(binary)
+      : Buffer.from(bytes).toString('base64');
+
+  return normalizeBase64Url(base64);
+}
+
+/**
+ * Ensures the given ID string is a valid unpadded Base64URL string.
+ * If it is already valid Base64URL, returns it unchanged; otherwise encodes it.
+ */
+export function ensureBase64Url(value: string): string {
+  if (!value) return '';
+  const trimmed = value.trim();
+  const normalized = normalizeBase64Url(trimmed);
+  if (/^[A-Za-z0-9_-]+$/.test(normalized) && normalized.length % 4 !== 1) {
+    return normalized;
+  }
+  return toBase64Url(trimmed);
+}
+
+/**
+ * Decodes a Base64URL string into a Uint8Array (for WebAuthn PublicKeyCredential descriptors).
+ */
+export function base64UrlToUint8Array(base64Url: string): Uint8Array {
+  const normalized = normalizeBase64Url(base64Url);
+  const padding = '='.repeat((4 - (normalized.length % 4)) % 4);
+  const base64 = (normalized + padding).replace(/-/g, '+').replace(/_/g, '/');
+
+  if (typeof atob === 'function') {
+    const binary = atob(base64);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+  }
+
+  return new Uint8Array(Buffer.from(base64, 'base64'));
+}
+
+// Base64URL("user-reader-101") = "dXNlci1yZWFkZXItMTAx"
+export const DEFAULT_USER: ReaderAccount = {
+  id: 'dXNlci1yZWFkZXItMTAx',
+  userId: 'dXNlci1yZWFkZXItMTAx',
+  username: 'alex.rivera@devtoolstimes.com',
+  name: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+  email: 'alex.rivera@devtoolstimes.com',
+  subscriptionPlan: 'Digital All-Access',
+};
+
+export const DEFAULT_PASSKEYS: PasskeyCredential[] = [
+  {
+    id: 'cGFzc2tleS1tYWNib29rLXByby10b3VjaGlkLTAx',
+    credentialId: 'cGFzc2tleS1tYWNib29rLXByby10b3VjaGlkLTAx',
+    name: 'MacBook Pro (Touch ID)',
+    displayName: 'MacBook Pro (Touch ID)',
+    authenticatorName: 'iCloud Keychain',
+    deviceType: 'multiDevice',
+    createdAt: '2026-08-14T10:30:00.000Z',
+    lastUsedAt: '2026-11-08T09:15:00.000Z',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'cGFzc2tleS1waXhlbC05LXByby1iaW9tZXRyaWMtMDI',
+    credentialId: 'cGFzc2tleS1waXhlbC05LXByby1iaW9tZXRyaWMtMDI',
+    name: 'Pixel 9 Pro',
+    displayName: 'Pixel 9 Pro',
+    authenticatorName: 'Google Password Manager',
+    deviceType: 'multiDevice',
+    createdAt: '2026-09-22T16:45:00.000Z',
+    lastUsedAt: '2026-11-05T18:20:00.000Z',
+    transports: ['internal', 'hybrid'],
+    backedUp: true,
+  },
+  {
+    id: 'cGFzc2tleS15dWJpa2V5LTVjLW5mYy1zZWN1cml0eS0wMw',
+    credentialId: 'cGFzc2tleS15dWJpa2V5LTVjLW5mYy1zZWN1cml0eS0wMw',
+    name: 'YubiKey 5C NFC',
+    displayName: 'YubiKey 5C NFC',
+    authenticatorName: 'Hardware Security Key',
+    deviceType: 'singleDevice',
+    createdAt: '2026-06-03T14:00:00.000Z',
+    lastUsedAt: '2026-10-12T11:05:00.000Z',
+    transports: ['usb', 'nfc'],
+    backedUp: false,
+  },
+];
+
+// Server-side in-memory fallback store in case session cookies are not sent
+let serverFallbackUser: ReaderAccount = { ...DEFAULT_USER };
+let serverFallbackPasskeys: PasskeyCredential[] = DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+
+export async function getSessionAccountData(session?: any): Promise<{
+  user: ReaderAccount;
+  passkeys: PasskeyCredential[];
+}> {
+  let user: ReaderAccount | undefined;
+  let passkeys: PasskeyCredential[] | undefined;
+
+  if (session) {
+    try {
+      user = await session.get('user');
+      passkeys = await session.get('passkeys');
+    } catch {
+      // Fall back to in-memory state if session access fails
+    }
+  }
+
+  if (!user) {
+    user = { ...serverFallbackUser };
+    if (session) {
+      try {
+        await session.set('user', user);
+      } catch {
+        // Ignore session write errors
+      }
+    }
+  }
+
+  if (!passkeys) {
+    passkeys = serverFallbackPasskeys.map((pk) => ({ ...pk }));
+    if (session) {
+      try {
+        await session.set('passkeys', passkeys);
+      } catch {
+        // Ignore session write errors
+      }
+    }
+  }
+
+  return { user, passkeys };
+}
+
+export async function saveSessionAccountData(
+  session: any,
+  user: ReaderAccount,
+  passkeys: PasskeyCredential[]
+): Promise<void> {
+  serverFallbackUser = { ...user };
+  serverFallbackPasskeys = passkeys.map((pk) => ({ ...pk }));
+
+  if (session) {
+    try {
+      await session.set('user', serverFallbackUser);
+      await session.set('passkeys', serverFallbackPasskeys);
+    } catch {
+      // Ignore session write errors
+    }
+  }
+}
+
+export async function resetSessionAccountData(session?: any): Promise<{
+  user: ReaderAccount;
+  passkeys: PasskeyCredential[];
+}> {
+  const user = { ...DEFAULT_USER };
+  const passkeys = DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+  await saveSessionAccountData(session, user, passkeys);
+  return { user, passkeys };
+}
+
+/**
+ * Signals the current list of accepted credential IDs for the signed-in reader
+ * to the browser authenticator via the WebAuthn Signal API.
+ * Removes stale or deleted passkeys from the authenticator.
+ */
+export async function signalAllAcceptedPasskeys(
+  userId: string,
+  credentialIds: string[],
+  rpId?: string
+): Promise<SignalSyncResult> {
+  const resolvedRpId =
+    rpId || (typeof window !== 'undefined' ? window.location.hostname : 'localhost');
+  const encodedUserId = ensureBase64Url(userId);
+  const encodedCredentialIds = credentialIds.map((id) => ensureBase64Url(id));
+  const payload = {
+    rpId: resolvedRpId,
+    userId: encodedUserId,
+    allAcceptedCredentialIds: encodedCredentialIds,
+  };
+  const timestamp = new Date().toISOString();
+
+  const supported =
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function';
+
+  if (!supported) {
+    return {
+      synced: false,
+      method: 'signalAllAcceptedCredentials',
+      supported: false,
+      timestamp,
+      payload,
+    };
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+    return {
+      synced: true,
+      method: 'signalAllAcceptedCredentials',
+      supported: true,
+      timestamp,
+      payload,
+    };
+  } catch (err) {
+    return {
+      synced: false,
+      method: 'signalAllAcceptedCredentials',
+      supported: true,
+      timestamp,
+      payload,
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+/**
+ * Signals updated user details (username and displayName) to the browser authenticator
+ * via the WebAuthn Signal API so stored passkeys show up-to-date display names.
+ */
+export async function signalUserDetailsUpdate(
+  userId: string,
+  name: string,
+  displayName: string,
+  rpId?: string
+): Promise<SignalSyncResult> {
+  const resolvedRpId =
+    rpId || (typeof window !== 'undefined' ? window.location.hostname : 'localhost');
+  const encodedUserId = ensureBase64Url(userId);
+  const payload = {
+    rpId: resolvedRpId,
+    userId: encodedUserId,
+    name,
+    displayName,
+  };
+  const timestamp = new Date().toISOString();
+
+  const supported =
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalCurrentUserDetails === 'function';
+
+  if (!supported) {
+    return {
+      synced: false,
+      method: 'signalCurrentUserDetails',
+      supported: false,
+      timestamp,
+      payload,
+    };
+  }
+
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails(payload);
+    return {
+      synced: true,
+      method: 'signalCurrentUserDetails',
+      supported: true,
+      timestamp,
+      payload,
+    };
+  } catch (err) {
+    return {
+      synced: false,
+      method: 'signalCurrentUserDetails',
+      supported: true,
+      timestamp,
+      payload,
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+/**
+ * Signals to the browser authenticator that a specific credential ID is unknown or was removed.
+ */
+export async function signalUnknownPasskey(
+  credentialId: string,
+  rpId?: string
+): Promise<SignalSyncResult> {
+  const resolvedRpId =
+    rpId || (typeof window !== 'undefined' ? window.location.hostname : 'localhost');
+  const encodedCredentialId = ensureBase64Url(credentialId);
+  const payload = {
+    rpId: resolvedRpId,
+    credentialId: encodedCredentialId,
+  };
+  const timestamp = new Date().toISOString();
+
+  const supported =
+    typeof window !== 'undefined' &&
+    typeof PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalUnknownCredential === 'function';
+
+  if (!supported) {
+    return {
+      synced: false,
+      method: 'signalUnknownCredential',
+      supported: false,
+      timestamp,
+      payload,
+    };
+  }
+
+  try {
+    await PublicKeyCredential.signalUnknownCredential(payload);
+    return {
+      synced: true,
+      method: 'signalUnknownCredential',
+      supported: true,
+      timestamp,
+      payload,
+    };
+  } catch (err) {
+    return {
+      synced: false,
+      method: 'signalUnknownCredential',
+      supported: true,
+      timestamp,
+      payload,
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
