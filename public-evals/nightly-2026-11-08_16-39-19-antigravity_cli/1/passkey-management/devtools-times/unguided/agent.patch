+import React from 'react';
+import PasskeyManagement from './PasskeyManagement';
+import {
+  DEFAULT_PASSKEYS,
+  DEFAULT_USER,
+  type PasskeyCredential,
+  type ReaderAccount,
+} from '../utils/passkeys';
+
+interface AccountSettingsProps {
+  initialUser?: ReaderAccount;
+  initialPasskeys?: PasskeyCredential[];
+}
+
+export default function AccountSettings({
+  initialUser = DEFAULT_USER,
+  initialPasskeys = DEFAULT_PASSKEYS,
+}: AccountSettingsProps) {
+  return (
+    <div className="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
+      {/* Account Settings Page Header */}
+      <div className="border-b border-gray-900 pb-6 mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-1">
+            Reader Account
+          </p>
+          <h1 className="text-3xl font-bold text-gray-900">Account Settings</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Manage your reader profile, security preferences, and registered passkeys.
+          </p>
+        </div>
+
+        <div className="flex items-center space-x-2 text-xs text-gray-600 bg-gray-50 border border-gray-200 px-3 py-2 rounded-md">
+          <span className="inline-block w-2 h-2 rounded-full bg-green-500" />
+          <span>
+            Signed in as <strong className="text-gray-900">{initialUser.displayName}</strong>
+          </span>
+        </div>
+      </div>
+
+      {/* Main Passkey Management & Reader Profile Sections */}
+      <PasskeyManagement
+        initialUser={initialUser}
+        initialPasskeys={initialPasskeys}
+      />
+    </div>
+  );
+}
