diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..a638200
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,947 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  DEFAULT_PASSKEYS,
+  DEFAULT_USER,
+  base64UrlToUint8Array,
+  ensureBase64Url,
+  signalAllAcceptedPasskeys,
+  signalUnknownPasskey,
+  signalUserDetailsUpdate,
+  toBase64Url,
+  type PasskeyCredential,
+  type ReaderAccount,
+  type SignalSyncResult,
+} from '../utils/passkeys';
+
+interface PasskeyManagementProps {
+  initialUser?: ReaderAccount;
+  initialPasskeys?: PasskeyCredential[];
+}
+
+export default function PasskeyManagement({
+  initialUser = DEFAULT_USER,
+  initialPasskeys = DEFAULT_PASSKEYS,
+}: PasskeyManagementProps) {
+  const [user, setUser] = useState<ReaderAccount>(initialUser);
+  const [passkeys, setPasskeys] = useState<PasskeyCredential[]>(initialPasskeys);
+
+  // Reader profile display name form state
+  const [profileDisplayName, setProfileDisplayName] = useState(initialUser.displayName);
+  const [profileUsername, setProfileUsername] = useState(initialUser.username);
+  const [savingProfile, setSavingProfile] = useState(false);
+
+  // Per-passkey inline display name editing state
+  const [editingCredentialId, setEditingCredentialId] = useState<string | null>(null);
+  const [editingDisplayName, setEditingDisplayName] = useState<string>('');
+  const [savingCredentialId, setSavingCredentialId] = useState<string | null>(null);
+  const [removingCredentialId, setRemovingCredentialId] = useState<string | null>(null);
+
+  // New passkey registration state
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [showAddForm, setShowAddForm] = useState(false);
+  const [registeringPasskey, setRegisteringPasskey] = useState(false);
+
+  // Status alerts and WebAuthn Signal API sync log
+  const [feedback, setFeedback] = useState<{
+    type: 'success' | 'error' | 'info';
+    message: string;
+  } | null>(null);
+  const [syncLog, setSyncLog] = useState<SignalSyncResult[]>([]);
+  const [signalSupported, setSignalSupported] = useState<boolean>(false);
+
+  const apiUrl = `${import.meta.env.BASE_URL}api/passkeys.json`;
+
+  const appendSyncLog = useCallback((...results: SignalSyncResult[]) => {
+    setSyncLog((prev) => [...results, ...prev].slice(0, 10));
+  }, []);
+
+  // Detect WebAuthn Signal API support and perform initial sync with browser authenticator
+  useEffect(() => {
+    const isSupported =
+      typeof window !== 'undefined' &&
+      typeof PublicKeyCredential !== 'undefined' &&
+      (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' ||
+        typeof PublicKeyCredential.signalCurrentUserDetails === 'function' ||
+        typeof PublicKeyCredential.signalUnknownCredential === 'function');
+
+    setSignalSupported(isSupported);
+
+    const loadAndSync = async () => {
+      try {
+        const res = await fetch(apiUrl);
+        if (res.ok) {
+          const data = await res.json();
+          const loadedUser: ReaderAccount = data.user || initialUser;
+          const loadedPasskeys: PasskeyCredential[] = data.passkeys || initialPasskeys;
+          setUser(loadedUser);
+          setProfileDisplayName(loadedUser.displayName);
+          setProfileUsername(loadedUser.username);
+          setPasskeys(loadedPasskeys);
+
+          const acceptedResult = await signalAllAcceptedPasskeys(
+            loadedUser.userId,
+            loadedPasskeys.map((pk) => pk.credentialId)
+          );
+          const userResult = await signalUserDetailsUpdate(
+            loadedUser.userId,
+            loadedUser.username,
+            loadedUser.displayName
+          );
+          appendSyncLog(acceptedResult, userResult);
+          return;
+        }
+      } catch {
+        // Fallback to initial props if fetch fails
+      }
+
+      const acceptedResult = await signalAllAcceptedPasskeys(
+        initialUser.userId,
+        initialPasskeys.map((pk) => pk.credentialId)
+      );
+      const userResult = await signalUserDetailsUpdate(
+        initialUser.userId,
+        initialUser.username,
+        initialUser.displayName
+      );
+      appendSyncLog(acceptedResult, userResult);
+    };
+
+    loadAndSync();
+  }, [apiUrl, appendSyncLog, initialPasskeys, initialUser]);
+
+  // Handler for updating the reader's account display name & username
+  const handleUpdateReaderDisplayName = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplayName = profileDisplayName.trim();
+    const trimmedUsername = profileUsername.trim() || user.username;
+
+    if (!trimmedDisplayName) {
+      setFeedback({ type: 'error', message: 'Display name cannot be empty.' });
+      return;
+    }
+
+    setSavingProfile(true);
+    setFeedback(null);
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          target: 'user',
+          displayName: trimmedDisplayName,
+          username: trimmedUsername,
+        }),
+      });
+
+      let updatedUser: ReaderAccount = {
+        ...user,
+        displayName: trimmedDisplayName,
+        username: trimmedUsername,
+        name: trimmedUsername,
+      };
+
+      if (response.ok) {
+        const data = await response.json();
+        if (data.user) {
+          updatedUser = data.user;
+        }
+      }
+
+      setUser(updatedUser);
+
+      // Signal updated user details to browser authenticator via WebAuthn Signal API
+      const syncResult = await signalUserDetailsUpdate(
+        updatedUser.userId,
+        updatedUser.username,
+        updatedUser.displayName
+      );
+      appendSyncLog(syncResult);
+
+      setFeedback({
+        type: 'success',
+        message: `Display name updated to "${updatedUser.displayName}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      setFeedback({
+        type: 'error',
+        message: 'Failed to update display name. Please try again.',
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  // Start editing a specific passkey's display name
+  const handleStartEditPasskey = (passkey: PasskeyCredential) => {
+    setEditingCredentialId(passkey.credentialId);
+    setEditingDisplayName(passkey.displayName || passkey.name);
+    setFeedback(null);
+  };
+
+  const handleCancelEditPasskey = () => {
+    setEditingCredentialId(null);
+    setEditingDisplayName('');
+  };
+
+  // Save updated display name for a registered passkey
+  const handleSavePasskeyDisplayName = async (credentialId: string) => {
+    const trimmedName = editingDisplayName.trim();
+    if (!trimmedName) {
+      setFeedback({ type: 'error', message: 'Passkey display name cannot be empty.' });
+      return;
+    }
+
+    setSavingCredentialId(credentialId);
+    setFeedback(null);
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          credentialId,
+          displayName: trimmedName,
+          name: trimmedName,
+        }),
+      });
+
+      let updatedList = passkeys.map((pk) =>
+        pk.credentialId === credentialId
+          ? { ...pk, name: trimmedName, displayName: trimmedName }
+          : pk
+      );
+
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          updatedList = data.passkeys;
+        }
+      }
+
+      setPasskeys(updatedList);
+      setEditingCredentialId(null);
+      setEditingDisplayName('');
+
+      // Keep browser authenticator in sync via WebAuthn Signal API
+      const userSync = await signalUserDetailsUpdate(
+        user.userId,
+        user.username,
+        trimmedName
+      );
+      const acceptedSync = await signalAllAcceptedPasskeys(
+        user.userId,
+        updatedList.map((pk) => pk.credentialId)
+      );
+      appendSyncLog(userSync, acceptedSync);
+
+      setFeedback({
+        type: 'success',
+        message: `Passkey display name updated to "${trimmedName}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      setFeedback({
+        type: 'error',
+        message: 'Could not update passkey display name. Please try again.',
+      });
+    } finally {
+      setSavingCredentialId(null);
+    }
+  };
+
+  // Remove a passkey and signal the browser authenticator
+  const handleRemovePasskey = async (passkey: PasskeyCredential) => {
+    const targetId = passkey.credentialId;
+    setRemovingCredentialId(targetId);
+    setFeedback(null);
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ credentialId: targetId }),
+      });
+
+      let remainingPasskeys = passkeys.filter((pk) => pk.credentialId !== targetId);
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          remainingPasskeys = data.passkeys;
+        }
+      }
+
+      setPasskeys(remainingPasskeys);
+      if (editingCredentialId === targetId) {
+        setEditingCredentialId(null);
+      }
+
+      // Synchronize with browser authenticator using WebAuthn Signal API:
+      // 1. Signal the updated list of all accepted credentials for this user
+      // 2. Signal that the removed credential ID is no longer recognized
+      const acceptedSync = await signalAllAcceptedPasskeys(
+        user.userId,
+        remainingPasskeys.map((pk) => pk.credentialId)
+      );
+      const unknownSync = await signalUnknownPasskey(targetId);
+      appendSyncLog(acceptedSync, unknownSync);
+
+      setFeedback({
+        type: 'success',
+        message: `Removed passkey "${passkey.displayName}" and updated your browser authenticator.`,
+      });
+    } catch {
+      setFeedback({
+        type: 'error',
+        message: 'Failed to remove passkey. Please try again.',
+      });
+    } finally {
+      setRemovingCredentialId(null);
+    }
+  };
+
+  // Register a new passkey and sync with browser authenticator
+  const handleRegisterPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setRegisteringPasskey(true);
+    setFeedback(null);
+
+    const desiredLabel =
+      newPasskeyName.trim() || `Passkey (${new Date().toLocaleDateString('en-US')})`;
+
+    let createdCredentialId = toBase64Url(
+      `passkey-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+    );
+    let transports: string[] = ['internal', 'hybrid'];
+
+    // Attempt WebAuthn credential creation if supported by browser
+    if (
+      typeof window !== 'undefined' &&
+      window.PublicKeyCredential &&
+      navigator.credentials &&
+      typeof navigator.credentials.create === 'function'
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        }
+
+        const credential = (await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              id: window.location.hostname,
+              name: 'The DevTools Times',
+            },
+            user: {
+              id: base64UrlToUint8Array(user.userId),
+              name: user.username,
+              displayName: user.displayName,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 }, // ES256
+              { type: 'public-key', alg: -257 }, // RS256
+            ],
+            authenticatorSelection: {
+              authenticatorAttachment: 'platform',
+              residentKey: 'required',
+              userVerification: 'preferred',
+            },
+            timeout: 15000,
+            excludeCredentials: passkeys.map((pk) => ({
+              id: base64UrlToUint8Array(pk.credentialId),
+              type: 'public-key' as const,
+            })),
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential && credential.id) {
+          createdCredentialId = ensureBase64Url(credential.id);
+          const response = credential.response as AuthenticatorAttestationResponse;
+          if (response && typeof response.getTransports === 'function') {
+            const reportedTransports = response.getTransports();
+            if (reportedTransports.length > 0) {
+              transports = reportedTransports;
+            }
+          }
+        }
+      } catch {
+        // If user cancels native dialog or headless environment lacks authenticator,
+        // continue registering with generated Base64URL credential ID
+      }
+    }
+
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'add',
+          credentialId: createdCredentialId,
+          displayName: desiredLabel,
+          name: desiredLabel,
+          authenticatorName: 'Browser Platform Authenticator',
+          deviceType: 'multiDevice',
+          transports,
+          backedUp: true,
+        }),
+      });
+
+      let updatedPasskeys = passkeys;
+      if (response.ok) {
+        const data = await response.json();
+        if (Array.isArray(data.passkeys)) {
+          updatedPasskeys = data.passkeys;
+        }
+      } else {
+        const fallbackKey: PasskeyCredential = {
+          id: createdCredentialId,
+          credentialId: createdCredentialId,
+          name: desiredLabel,
+          displayName: desiredLabel,
+          authenticatorName: 'Browser Platform Authenticator',
+          deviceType: 'multiDevice',
+          createdAt: new Date().toISOString(),
+          lastUsedAt: new Date().toISOString(),
+          transports,
+          backedUp: true,
+        };
+        updatedPasskeys = [fallbackKey, ...passkeys];
+      }
+
+      setPasskeys(updatedPasskeys);
+      setNewPasskeyName('');
+      setShowAddForm(false);
+
+      const acceptedSync = await signalAllAcceptedPasskeys(
+        user.userId,
+        updatedPasskeys.map((pk) => pk.credentialId)
+      );
+      const userSync = await signalUserDetailsUpdate(
+        user.userId,
+        user.username,
+        user.displayName
+      );
+      appendSyncLog(acceptedSync, userSync);
+
+      setFeedback({
+        type: 'success',
+        message: `Registered new passkey "${desiredLabel}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      setFeedback({
+        type: 'error',
+        message: 'Could not register new passkey. Please try again.',
+      });
+    } finally {
+      setRegisteringPasskey(false);
+    }
+  };
+
+  // Manual full sync button
+  const handleManualSync = async () => {
+    const acceptedSync = await signalAllAcceptedPasskeys(
+      user.userId,
+      passkeys.map((pk) => pk.credentialId)
+    );
+    const userSync = await signalUserDetailsUpdate(
+      user.userId,
+      user.username,
+      user.displayName
+    );
+    appendSyncLog(acceptedSync, userSync);
+
+    setFeedback({
+      type: 'info',
+      message: `Synchronized ${passkeys.length} accepted passkey(s) and reader details ("${user.displayName}") with your browser authenticator.`,
+    });
+  };
+
+  // Restore demo passkeys if user removed all of them
+  const handleRestoreDefaults = async () => {
+    try {
+      const response = await fetch(apiUrl, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset' }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        setUser(data.user);
+        setProfileDisplayName(data.user.displayName);
+        setProfileUsername(data.user.username);
+        setPasskeys(data.passkeys);
+
+        const acceptedSync = await signalAllAcceptedPasskeys(
+          data.user.userId,
+          data.passkeys.map((pk: PasskeyCredential) => pk.credentialId)
+        );
+        const userSync = await signalUserDetailsUpdate(
+          data.user.userId,
+          data.user.username,
+          data.user.displayName
+        );
+        appendSyncLog(acceptedSync, userSync);
+
+        setFeedback({
+          type: 'info',
+          message: 'Default passkeys restored and synchronized with your browser authenticator.',
+        });
+      }
+    } catch {
+      // Ignore error
+    }
+  };
+
+  const formatDate = (iso: string | null) => {
+    if (!iso) return 'Never';
+    try {
+      return new Date(iso).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
+      });
+    } catch {
+      return iso;
+    }
+  };
+
+  return (
+    <div className="space-y-8" id="passkeys" data-testid="passkey-management-section">
+      {/* Feedback Alert Banner */}
+      {feedback && (
+        <div
+          role="status"
+          aria-live="polite"
+          data-testid="passkey-feedback-banner"
+          className={`p-4 rounded-lg border flex items-start justify-between ${
+            feedback.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : feedback.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-blue-50 border-blue-200 text-blue-800'
+          }`}
+        >
+          <div className="flex items-center space-x-2 text-sm font-medium">
+            <span>{feedback.message}</span>
+          </div>
+          <button
+            type="button"
+            onClick={() => setFeedback(null)}
+            className="text-xs font-semibold underline ml-4 hover:opacity-80"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Reader Profile & Display Name Section */}
+      <section
+        aria-labelledby="reader-profile-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm p-6"
+      >
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-200 pb-4 mb-5">
+          <div>
+            <h2
+              id="reader-profile-heading"
