+import type { APIRoute } from 'astro';
+import {
+  ensureBase64Url,
+  getSessionAccountData,
+  resetSessionAccountData,
+  saveSessionAccountData,
+  toBase64Url,
+  type PasskeyCredential,
+} from '../../utils/passkeys';
+
+const jsonHeaders = {
+  'Content-Type': 'application/json',
+};
+
+export const GET: APIRoute = async ({ session }) => {
+  const { user, passkeys } = await getSessionAccountData(session);
+  return new Response(JSON.stringify({ user, passkeys }), {
+    status: 200,
+    headers: jsonHeaders,
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json().catch(() => ({}));
+  const { user, passkeys } = await getSessionAccountData(session);
+
+  const action = body.action || 'add';
+
+  if (action === 'reset') {
+    const resetData = await resetSessionAccountData(session);
+    return new Response(JSON.stringify(resetData), {
+      status: 200,
+      headers: jsonHeaders,
+    });
+  }
+
+  if (action === 'remove' || action === 'delete') {
+    const targetId = body.credentialId || body.id;
+    if (!targetId) {
+      return new Response(
+        JSON.stringify({ error: 'Credential ID is required to remove a passkey.' }),
+        { status: 400, headers: jsonHeaders }
+      );
+    }
+
+    const updatedPasskeys = passkeys.filter(
+      (pk) => pk.credentialId !== targetId && pk.id !== targetId
+    );
+    await saveSessionAccountData(session, user, updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({
+        user,
+        passkeys: updatedPasskeys,
+        removedCredentialId: targetId,
+      }),
+      { status: 200, headers: jsonHeaders }
+    );
+  }
+
+  if (action === 'updateUser' || action === 'updateProfile') {
+    const newDisplayName = (body.displayName ?? body.name ?? '').trim();
+    const newUsername = (body.username ?? body.email ?? user.username).trim();
+
+    if (!newDisplayName) {
+      return new Response(
+        JSON.stringify({ error: 'Display name cannot be empty.' }),
+        { status: 400, headers: jsonHeaders }
+      );
+    }
+
+    const updatedUser = {
+      ...user,
+      displayName: newDisplayName,
+      username: newUsername || user.username,
+      name: newUsername || user.name,
+      email: newUsername.includes('@') ? newUsername : user.email,
+    };
+
+    await saveSessionAccountData(session, updatedUser, passkeys);
+
+    return new Response(
+      JSON.stringify({
+        user: updatedUser,
+        passkeys,
+      }),
+      { status: 200, headers: jsonHeaders }
+    );
+  }
+
+  if (action === 'rename' || action === 'update') {
+    const targetId = body.credentialId || body.id;
+    const newName = (body.displayName ?? body.name ?? '').trim();
+
+    if (!newName) {
+      return new Response(
+        JSON.stringify({ error: 'Display name cannot be empty.' }),
+        { status: 400, headers: jsonHeaders }
+      );
+    }
+
+    if (targetId) {
+      const updatedPasskeys = passkeys.map((pk) =>
+        pk.credentialId === targetId || pk.id === targetId
+          ? { ...pk, name: newName, displayName: newName }
+          : pk
+      );
+      await saveSessionAccountData(session, user, updatedPasskeys);
+      return new Response(
+        JSON.stringify({ user, passkeys: updatedPasskeys }),
+        { status: 200, headers: jsonHeaders }
+      );
+    } else {
+      const updatedUser = {
+        ...user,
+        displayName: newName,
+      };
+      await saveSessionAccountData(session, updatedUser, passkeys);
+      return new Response(
+        JSON.stringify({ user: updatedUser, passkeys }),
+        { status: 200, headers: jsonHeaders }
+      );
+    }
+  }
+
+  if (action === 'verify') {
+    const targetId = body.credentialId || body.id;
+    const matched = passkeys.find(
+      (pk) => pk.credentialId === targetId || pk.id === targetId
+    );
+    if (!matched) {
+      return new Response(
+        JSON.stringify({
+          verified: false,
+          unknownCredential: true,
+          credentialId: targetId,
+          error: 'Passkey not found on server.',
+        }),
+        { status: 404, headers: jsonHeaders }
+      );
+    }
+
+    const now = new Date().toISOString();
+    const updatedPasskeys = passkeys.map((pk) =>
+      pk.credentialId === matched.credentialId ? { ...pk, lastUsedAt: now } : pk
+    );
+    await saveSessionAccountData(session, user, updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        user,
+        passkey: { ...matched, lastUsedAt: now },
+        passkeys: updatedPasskeys,
+      }),
+      { status: 200, headers: jsonHeaders }
+    );
+  }
+
+  // Default action: add / register a new passkey
+  const label = (body.displayName || body.name || `Passkey (${new Date().toLocaleDateString()})`).trim();
+  const rawCredId =
+    body.credentialId ||
+    body.id ||
+    toBase64Url(`passkey-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`);
+  const credentialId = ensureBase64Url(rawCredId);
+
+  const newPasskey: PasskeyCredential = {
+    id: credentialId,
+    credentialId,
+    name: label,
+    displayName: label,
+    authenticatorName: body.authenticatorName || 'Browser Authenticator',
+    deviceType: body.deviceType === 'singleDevice' ? 'singleDevice' : 'multiDevice',
+    createdAt: new Date().toISOString(),
+    lastUsedAt: new Date().toISOString(),
+    transports: Array.isArray(body.transports) ? body.transports : ['internal', 'hybrid'],
+    backedUp: body.backedUp !== undefined ? Boolean(body.backedUp) : true,
+  };
+
+  const updatedPasskeys = [
+    newPasskey,
+    ...passkeys.filter((pk) => pk.credentialId !== credentialId),
+  ];
+
+  await saveSessionAccountData(session, user, updatedPasskeys);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkey: newPasskey,
+      passkeys: updatedPasskeys,
+    }),
+    { status: 201, headers: jsonHeaders }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  const { user, passkeys } = await getSessionAccountData(session);
+
+  const targetId =
+    body.credentialId ||
+    body.id ||
+    url.searchParams.get('credentialId') ||
+    url.searchParams.get('id');
+
+  const newDisplayName = (body.displayName ?? body.name ?? '').trim();
+  if (!newDisplayName) {
+    return new Response(
+      JSON.stringify({ error: 'Display name is required.' }),
+      { status: 400, headers: jsonHeaders }
+    );
+  }
+
+  if (targetId && body.target !== 'user') {
+    const updatedPasskeys = passkeys.map((pk) =>
+      pk.credentialId === targetId || pk.id === targetId
+        ? { ...pk, name: newDisplayName, displayName: newDisplayName }
+        : pk
+    );
+    await saveSessionAccountData(session, user, updatedPasskeys);
+    return new Response(
+      JSON.stringify({ user, passkeys: updatedPasskeys }),
+      { status: 200, headers: jsonHeaders }
+    );
+  }
+
+  const newUsername = (body.username ?? body.email ?? user.username).trim();
+  const updatedUser = {
+    ...user,
+    displayName: newDisplayName,
+    username: newUsername || user.username,
+    name: newUsername || user.name,
+    email: newUsername.includes('@') ? newUsername : user.email,
+  };
+  await saveSessionAccountData(session, updatedUser, passkeys);
+
+  return new Response(
+    JSON.stringify({ user: updatedUser, passkeys }),
+    { status: 200, headers: jsonHeaders }
+  );
+};
+
+export const PUT: APIRoute = PATCH;
+
+export const DELETE: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => ({}));
+  const { user, passkeys } = await getSessionAccountData(session);
+
+  const targetId =
+    body.credentialId ||
+    body.id ||
+    url.searchParams.get('credentialId') ||
+    url.searchParams.get('id');
+
+  if (!targetId) {
+    return new Response(
+      JSON.stringify({ error: 'Credential ID is required.' }),
+      { status: 400, headers: jsonHeaders }
+    );
+  }
+
+  const updatedPasskeys = passkeys.filter(
+    (pk) => pk.credentialId !== targetId && pk.id !== targetId
+  );
+
+  await saveSessionAccountData(session, user, updatedPasskeys);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys: updatedPasskeys,
+      removedCredentialId: targetId,
+    }),
+    { status: 200, headers: jsonHeaders }
+  );
+};
