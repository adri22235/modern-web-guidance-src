+          </h2>
+          <p className="text-sm text-gray-600 mt-0.5">
+            Updating your account username or display name automatically synchronizes with your browser passkey authenticator so your sign-in prompt stays up to date.
+          </p>
+        </div>
+
+        <form onSubmit={handleUserRename} className="grid grid-cols-1 sm:grid-cols-2 gap-4 items-end">
+          <div>
+            <label htmlFor="account-username" className="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">
+              Username / Email
+            </label>
+            <input
+              id="account-username"
+              type="text"
+              value={profileName}
+              onChange={(e) => setProfileName(e.target.value)}
+              required
+              className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <div>
+            <label htmlFor="account-display-name" className="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">
+              Display Name
+            </label>
+            <input
+              id="account-display-name"
+              type="text"
+              value={profileDisplayName}
+              onChange={(e) => setProfileDisplayName(e.target.value)}
+              required
+              className="w-full px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <div className="sm:col-span-2 flex justify-end pt-2">
+            <button
+              type="submit"
+              disabled={savingProfile}
+              className="px-4 py-2 bg-gray-900 text-white text-sm font-semibold rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 disabled:opacity-60 cursor-pointer"
+            >
+              {savingProfile ? 'Updating profile...' : 'Update Account Details'}
+            </button>
+          </div>
+        </form>
+      </section>
+    </div>
+  );
+}
