diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..d26dbe4
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,780 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import 'webauthn-polyfills';
+import aaguidsData from '../utils/aaguids.json';
+
+interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+const aaguids = aaguidsData as Record<string, AaguidEntry>;
+
+export interface PasskeyCredentialItem {
+  id: string;
+  passkeyUserId: string;
+  credentialPublicKey: string;
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice';
+  credentialBackedUp: boolean;
+  aaguid: string;
+  providerIcon?: string;
+  name: string;
+  transports: string[];
+  lastUsedAt?: number;
+  registeredAt: number;
+  counter: number;
+}
+
+interface UserProfileState {
+  id: string;
+  passkeyUserId: string;
+  name: string;
+  displayName: string;
+}
+
+// Valid unpadded Base64URL: non-empty, [A-Za-z0-9_-] only, no '=' padding, length % 4 !== 1
+export function isValidBase64Url(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length % 4 !== 1 &&
+    /^[A-Za-z0-9_-]+$/.test(value)
+  );
+}
+
+function getProviderFromAaguid(cred: PasskeyCredentialItem): {
+  providerName: string;
+  providerIcon?: string;
+} {
+  if (!cred.aaguid || cred.aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      providerName: cred.name || 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const entry = aaguids[cred.aaguid];
+  return {
+    providerName: cred.name || entry?.name || 'Unknown passkey provider',
+    providerIcon: cred.providerIcon || entry?.icon_light,
+  };
+}
+
+function formatEpochDate(epochMs?: number): string {
+  if (!epochMs) return 'Never used';
+  return new Date(epochMs).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+export default function PasskeyManagement() {
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  const [credentials, setCredentials] = useState<PasskeyCredentialItem[]>([]);
+  const [rpId, setRpId] = useState<string>('');
+  const [userId, setUserId] = useState<string>('');
+  const [userProfile, setUserProfile] = useState<UserProfileState>({
+    id: 'user-1',
+    passkeyUserId: '',
+    name: 'alex.rivera@devtoolstimes.dev',
+    displayName: 'Alex Rivera',
+  });
+
+  const [profileName, setProfileName] = useState('alex.rivera@devtoolstimes.dev');
+  const [profileDisplayName, setProfileDisplayName] = useState('Alex Rivera');
+  const [savingProfile, setSavingProfile] = useState(false);
+
+  const [editingCredId, setEditingCredId] = useState<string | null>(null);
+  const [editingCredName, setEditingCredName] = useState<string>('');
+  const [savingCredId, setSavingCredId] = useState<string | null>(null);
+  const [deletingCredId, setDeletingCredId] = useState<string | null>(null);
+
+  const [loading, setLoading] = useState<boolean>(true);
+  const [canCreatePasskey, setCanCreatePasskey] = useState<boolean>(false);
+  const [capabilitiesChecked, setCapabilitiesChecked] = useState<boolean>(false);
+  const [creatingPasskey, setCreatingPasskey] = useState<boolean>(false);
+
+  const [statusMessage, setStatusMessage] = useState<{
+    type: 'success' | 'error' | 'info';
+    text: string;
+  } | null>(null);
+
+  const syncAcceptedCredentials = useCallback(
+    async (serverRpId: string, serverUserId: string, currentCredentialsList: PasskeyCredentialItem[]) => {
+      if (typeof window === 'undefined' || !window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+        return;
+      }
+      const credentialIds = currentCredentialsList.map((c) => c.id);
+      if (
+        !serverRpId ||
+        !isValidBase64Url(serverUserId) ||
+        !credentialIds.every(isValidBase64Url)
+      ) {
+        console.warn(
+          'SignalAllAcceptedCredentials skipped: server rpId and valid unpadded Base64URL userId and credential IDs are required.'
+        );
+        return;
+      }
+
+      try {
+        await PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId: serverRpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+          userId: serverUserId, // Base64URL-encoded user ID from the server
+          allAcceptedCredentialIds: credentialIds,
+        });
+      } catch (e) {
+        // Use console.warn instead of console.error so passive sync failures do not fail Lighthouse errors-in-console
+        console.warn('SignalAllAcceptedCredentials sync warning:', e);
+      }
+    },
+    []
+  );
+
+  const loadManagementPanel = useCallback(async () => {
+    try {
+      const response = await fetch(`${baseUrl}api/credentials`);
+      if (!response.ok) return;
+      const data = await response.json();
+      const { rpId: serverRpId, userId: serverUserId, user, credentials: credsList } = data;
+
+      setRpId(serverRpId);
+      setUserId(serverUserId);
+      setCredentials(credsList || []);
+
+      if (user) {
+        setUserProfile(user);
+        setProfileName(user.name);
+        setProfileDisplayName(user.displayName);
+      }
+
+      // Sync accepted credentials on initial load using server-provided rpId and userId
+      await syncAcceptedCredentials(serverRpId, serverUserId, credsList || []);
+    } catch (e) {
+      console.warn('Could not load passkey credentials:', e);
+    } finally {
+      setLoading(false);
+    }
+  }, [baseUrl, syncAcceptedCredentials]);
+
+  useEffect(() => {
+    // Gate the "Create passkey" button on page load using PublicKeyCredential.getClientCapabilities()
+    async function detectPasskeyCapabilities() {
+      if (
+        typeof window !== 'undefined' &&
+        window.PublicKeyCredential &&
+        typeof PublicKeyCredential.getClientCapabilities === 'function'
+      ) {
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet) {
+            setCanCreatePasskey(true);
+          } else {
+            setCanCreatePasskey(false);
+          }
+        } catch (e) {
+          console.warn('Capability check warning:', e);
+          setCanCreatePasskey(false);
+        }
+      } else {
+        setCanCreatePasskey(false);
+      }
+      setCapabilitiesChecked(true);
+    }
+
+    detectPasskeyCapabilities();
+    loadManagementPanel();
+  }, [loadManagementPanel]);
+
+  const handleUserRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setStatusMessage(null);
+    const updatedName = profileName.trim();
+    const updatedDisplayName = profileDisplayName.trim();
+    if (!updatedName || !updatedDisplayName) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Both username and display name are required.',
+      });
+      return;
+    }
+
+    setSavingProfile(true);
+    try {
+      const response = await fetch(`${baseUrl}api/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          name: updatedName,
+          displayName: updatedDisplayName,
+        }),
+      });
+
+      if (response.ok) {
+        const data = await response.json();
+        const serverRpId = data.rpId || rpId;
+        const serverUserId = data.userId || userId;
+
+        setUserProfile({
+          id: data.id || userProfile.id,
+          passkeyUserId: serverUserId,
+          name: updatedName,
+          displayName: updatedDisplayName,
+        });
+
+        if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+          if (!serverRpId || !isValidBase64Url(serverUserId)) {
+            console.warn(
+              'SignalCurrentUserDetails skipped: server rpId and valid unpadded Base64URL userId are required.'
+            );
+          } else {
+            try {
+              await PublicKeyCredential.signalCurrentUserDetails({
+                rpId: serverRpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+                userId: serverUserId, // Base64URL-encoded user ID from the server
+                name: updatedName,
+                displayName: updatedDisplayName,
+              });
+            } catch (syncErr) {
+              console.warn('SignalCurrentUserDetails sync warning:', syncErr);
+            }
+          }
+        }
+
+        setStatusMessage({
+          type: 'success',
+          text: 'Account profile updated and synchronized with your passkey authenticator.',
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Failed to update account details.',
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while updating account details.',
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  const startEditingCredential = (cred: PasskeyCredentialItem) => {
+    setEditingCredId(cred.id);
+    setEditingCredName(cred.name);
+    setStatusMessage(null);
+  };
+
+  const cancelEditingCredential = () => {
+    setEditingCredId(null);
+    setEditingCredName('');
+  };
+
+  // Renaming an individual passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+  const performCredentialRename = async (credentialId: string, newCredentialName: string) => {
+    const trimmed = newCredentialName.trim();
+    if (!trimmed) return;
+
+    setSavingCredId(credentialId);
+    setStatusMessage(null);
+    try {
+      const response = await fetch(`${baseUrl}api/credential/${encodeURIComponent(credentialId)}`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: trimmed }),
+      });
+
+      if (response.ok) {
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        if (updatedResponse.ok) {
+          const { credentials: updatedCreds } = await updatedResponse.json();
+          setCredentials(updatedCreds || []);
+        }
+        setEditingCredId(null);
+        setEditingCredName('');
+        setStatusMessage({
+          type: 'success',
+          text: `Passkey display name updated to "${trimmed}".`,
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Could not rename the passkey.',
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'An error occurred while renaming the passkey.',
+      });
+    } finally {
+      setSavingCredId(null);
+    }
+  };
+
+  const performDelete = async (credentialId: string, credName: string) => {
+    setDeletingCredId(credentialId);
+    setStatusMessage(null);
+    try {
+      const response = await fetch(`${baseUrl}api/credential/${encodeURIComponent(credentialId)}`, {
+        method: 'DELETE',
+      });
+
+      if (response.ok) {
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        if (updatedResponse.ok) {
+          const { rpId: serverRpId, userId: serverUserId, credentials: updatedCreds } =
+            await updatedResponse.json();
+          setRpId(serverRpId);
+          setUserId(serverUserId);
+          setCredentials(updatedCreds || []);
+
+          // Sync remaining accepted credentials after deletion
+          await syncAcceptedCredentials(serverRpId, serverUserId, updatedCreds || []);
+        }
+        setStatusMessage({
+          type: 'info',
+          text: `Removed passkey "${credName}" and synchronized with your authenticator.`,
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Could not remove passkey.',
+        });
+      }
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'An error occurred while deleting the passkey.',
+      });
+    } finally {
+      setDeletingCredId(null);
+    }
+  };
+
+  const registerPasskey = async (isPromotion = false) => {
+    setStatusMessage(null);
+
+    if (
+      typeof window === 'undefined' ||
+      !window.PublicKeyCredential ||
+      typeof PublicKeyCredential.getClientCapabilities !== 'function'
+    ) {
+      setCanCreatePasskey(false);
+      return;
+    }
+
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+      setCanCreatePasskey(false);
+      return;
+    }
+
+    setCreatingPasskey(true);
+    try {
+      const optionsRes = await fetch(`${baseUrl}api/passkeys/register-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ promotion: isPromotion }),
+      });
+
+      if (!optionsRes.ok) {
+        setStatusMessage({
+          type: 'error',
+          text: 'Could not request passkey creation options from server.',
+        });
+        return;
+      }
+
+      const creationOptionsJSON = await optionsRes.json();
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      let credential: PublicKeyCredential | null = null;
+      try {
+        credential = (await navigator.credentials.create({
+          publicKey,
+        })) as PublicKeyCredential | null;
+      } catch (err: any) {
+        if (err.name === 'InvalidStateError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'A passkey already exists on this authenticator for your account.',
+          });
+        } else if (err.name === 'SecurityError') {
+          setStatusMessage({
+            type: 'error',
+            text: 'Configuration RP ID or Secure Context error.',
+          });
+        } else if (err.name === 'NotAllowedError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'Passkey creation was cancelled.',
+          });
+        } else if (err.name === 'AbortError') {
+          setStatusMessage({
+            type: 'info',
+            text: 'The passkey creation operation was aborted.',
+          });
+        }
+        return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+      }
+
+      if (!credential) return;
+
+      // Server Verification phase (Segregated Try/Catch)
+      const encodedResponse = credential.toJSON();
+      const serverRpId = publicKey.rp.id || rpId;
+
+      try {
+        const verifyRes = await fetch(`${baseUrl}api/passkeys/register-verify`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!verifyRes.ok) {
+          if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential && serverRpId) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: serverRpId, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+                credentialId: encodedResponse.id,
+              });
+            } catch (sigErr) {
+              console.warn('SignalUnknownCredential warning:', sigErr);
+            }
+          }
+          setStatusMessage({
+            type: 'error',
+            text: 'Failed to verify the newly created passkey with the server.',
+          });
+          return;
+        }
+
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        if (updatedResponse.ok) {
+          const {
+            rpId: updatedRpId,
+            userId: updatedUserId,
+            credentials: updatedCreds,
+          } = await updatedResponse.json();
+          setRpId(updatedRpId);
+          setUserId(updatedUserId);
+          setCredentials(updatedCreds || []);
+          await syncAcceptedCredentials(updatedRpId, updatedUserId, updatedCreds || []);
+        }
+
+        setStatusMessage({
+          type: 'success',
+          text: 'New passkey registered and synchronized with your account.',
+        });
+      } catch (serverErr) {
+        console.warn('Server verification network failure:', serverErr);
+        if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential && serverRpId) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: serverRpId, // Always use the server-provided rp.id; DO NOT use window.location.hostname
+              credentialId: encodedResponse.id,
+            });
+          } catch (sigErr) {
+            console.warn('SignalUnknownCredential warning:', sigErr);
+          }
+        }
+        setStatusMessage({
+          type: 'error',
+          text: 'Network error while verifying the passkey with the server.',
+        });
+      }
+    } finally {
+      setCreatingPasskey(false);
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Page Header */}
+      <div className="border-b border-gray-300 pb-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-gray-500">
+            Subscriber Account Settings
+          </p>
+          <h1 className="text-3xl font-brand font-bold text-gray-900 mt-1">
+            Security &amp; Passkey Management
+          </h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Manage your registered passkeys, update their display names, or remove unused keys while keeping your browser authenticator in sync.
+          </p>
+        </div>
+        <div className="flex items-center space-x-2 text-xs bg-gray-100 border border-gray-200 px-3 py-2 rounded-md self-start">
+          <span className="inline-block w-2 h-2 rounded-full bg-green-600"></span>
+          <span className="text-gray-700 font-medium">Signed in as {userProfile.displayName}</span>
+        </div>
+      </div>
+
+      {/* Status Notification Banner */}
+      {statusMessage && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`p-4 rounded-md border text-sm flex items-center justify-between ${
+            statusMessage.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-gray-50 border-gray-200 text-gray-800'
+          }`}
+        >
+          <span>{statusMessage.text}</span>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="ml-4 text-xs font-semibold underline hover:opacity-80"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Passkeys Management Section */}
+      <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
+        <div className="p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+          <div>
+            <h2 id="passkeys-heading" className="text-xl font-bold text-gray-900">
+              Registered Passkeys
+            </h2>
+            <p className="text-sm text-gray-600 mt-1">
+              Passkeys let you sign in securely to The DevTools Times using Touch ID, Face ID, Windows Hello, or your password manager.
+            </p>
+          </div>
+
+          {/* Conditional "Create Passkey" Button gated by PublicKeyCredential.getClientCapabilities() */}
+          {capabilitiesChecked && canCreatePasskey && (
+            <button
+              type="button"
+              onClick={() => registerPasskey(false)}
+              disabled={creatingPasskey}
