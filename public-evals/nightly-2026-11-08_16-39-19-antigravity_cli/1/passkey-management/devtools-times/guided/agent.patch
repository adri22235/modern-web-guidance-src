+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M12 4v16m8-8H4"
+                />
+              </svg>
+              {creatingPasskey ? 'Creating passkey...' : 'Create passkey'}
+            </button>
+          )}
+        </div>
+
+        {/* Fallback notice if passkey platform authenticator is unsupported */}
+        {capabilitiesChecked && !canCreatePasskey && (
+          <div className="px-6 py-3 bg-amber-50 border-b border-amber-200 text-xs text-amber-900">
+            Passkey creation is unavailable on this browser or device. You can still rename or remove existing passkeys below, or use standard multi-factor authentication (MFA) methods for sign-in.
+          </div>
+        )}
+
+        {/* Passkey Credentials List */}
+        <div className="divide-y divide-gray-200">
+          {loading ? (
+            <div className="p-8 text-center text-sm text-gray-500">
+              Loading your registered passkeys...
+            </div>
+          ) : credentials.length === 0 ? (
+            <div className="p-10 text-center">
