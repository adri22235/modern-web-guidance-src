+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,106 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  passkeyStore,
+  resolveAaguidMetadata,
+  RP_ID,
+  type StoredPasskeyCredential,
+} from '../../../utils/passkeys-store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const body = await request.json().catch(() => null);
+  if (!body || !body.id) {
+    return new Response(JSON.stringify({ error: 'Invalid attestation response payload.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = (await session?.get('userProfile')) || passkeyStore.getUser();
+  const expectedChallenge =
+    (await session?.get('passkeyChallenge')) || passkeyStore.getLatestChallenge();
+
+  const expectedOrigin = request.headers.get('origin') || url.origin;
+
+  try {
+    const verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin,
+      expectedRPID: RP_ID,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey registration verification failed.' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { registrationInfo } = verification;
+    const {
+      credential,
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+    } = registrationInfo;
+
+    let credName = 'Unknown passkey provider';
+    let providerIcon: string | undefined = undefined;
+
+    if (aaguid === '00000000-0000-0000-0000-000000000000') {
+      credName = 'Unknown passkey provider';
+      providerIcon = undefined;
+    } else {
+      const meta = resolveAaguidMetadata(aaguid, 'Unknown passkey provider');
+      credName = meta.name;
+      providerIcon = meta.providerIcon;
+    }
+
+    const now = Date.now();
+    const newCred: StoredPasskeyCredential = {
+      id: credential.id,
+      passkeyUserId: user.passkeyUserId,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType: credentialDeviceType || 'multiDevice',
+      credentialBackedUp: Boolean(credentialBackedUp),
+      aaguid: aaguid || '00000000-0000-0000-0000-000000000000',
+      providerIcon,
+      name: credName,
+      transports: credential.transports || body.response?.transports || ['internal'],
+      registeredAt: now,
+      counter: credential.counter ?? 0,
+    };
+
+    const saved = passkeyStore.saveCredential(newCred);
+    await session?.set(
+      'passkeyCredentials',
+      passkeyStore.findCredentialsByUserId(user.passkeyUserId)
+    );
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        rpId: RP_ID,
+        userId: user.passkeyUserId,
+        credential: saved,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({
+        error: err?.message || 'Verification failed.',
+      }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
