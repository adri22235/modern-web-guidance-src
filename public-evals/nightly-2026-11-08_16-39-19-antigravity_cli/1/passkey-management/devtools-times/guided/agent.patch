@@ -0,0 +1,83 @@
+import type { APIRoute } from 'astro';
+import { passkeyStore } from '../../../utils/passkeys-store';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const body = await request.json().catch(() => ({}));
+  const { name } = body;
+  if (typeof name !== 'string' || !name.trim()) {
+    return new Response(JSON.stringify({ error: 'Valid name is required.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = (await session?.get('userProfile')) || passkeyStore.getUser();
+  const sessionCreds = await session?.get('passkeyCredentials');
+
+  const cred = passkeyStore.findCredentialById(id);
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  cred.name = name.trim();
+  const saved = passkeyStore.saveCredential(cred);
+
+  if (Array.isArray(sessionCreds)) {
+    const updatedList = sessionCreds.map((c: any) => (c.id === id ? saved : c));
+    await session?.set('passkeyCredentials', updatedList);
+  } else {
+    await session?.set('passkeyCredentials', passkeyStore.findCredentialsByUserId(user.passkeyUserId));
+  }
+
+  return new Response(JSON.stringify(saved), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const { id } = params;
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential ID is required.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = (await session?.get('userProfile')) || passkeyStore.getUser();
+  const cred = passkeyStore.findCredentialById(id);
+  if (!cred || cred.passkeyUserId !== user.passkeyUserId) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  passkeyStore.deleteCredential(id);
+
+  const sessionCreds = await session?.get('passkeyCredentials');
+  if (Array.isArray(sessionCreds)) {
+    await session?.set(
+      'passkeyCredentials',
+      sessionCreds.filter((c: any) => c.id !== id)
+    );
+  } else {
+    await session?.set('passkeyCredentials', passkeyStore.findCredentialsByUserId(user.passkeyUserId));
+  }
+
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
