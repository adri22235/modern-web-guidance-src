+              <p className="text-sm text-gray-500 mt-1">
+                You do not have any passkeys registered to your account yet.
+              </p>
+            </div>
+          ) : (
+            credentials.map((cred) => {
+              const { providerName, providerIcon } = getProviderFromAaguid(cred);
+              const isEditing = editingCredId === cred.id;
+              const isSaving = savingCredId === cred.id;
+              const isDeleting = deletingCredId === cred.id;
+
+              return (
+                <div
+                  key={cred.id}
+                  data-credential-id={cred.id}
+                  className="p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 hover:bg-gray-50/60 transition-colors"
+                >
+                  <div className="flex items-start space-x-4 flex-1 min-w-0">
+                    {/* Provider Icon */}
+                    <div className="w-10 h-10 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center flex-shrink-0 overflow-hidden p-1.5">
+                      {providerIcon ? (
+                        <img
+                          src={providerIcon}
+                          alt={`${providerName} icon`}
+                          className="w-full h-full object-contain"
+                        />
+                      ) : (
+                        <svg
+                          className="w-5 h-5 text-gray-500"
+                          fill="none"
+                          stroke="currentColor"
+                          viewBox="0 0 24 24"
+                          aria-hidden="true"
+                        >
+                          <path
+                            strokeLinecap="round"
+                            strokeLinejoin="round"
+                            strokeWidth={2}
+                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                          />
+                        </svg>
+                      )}
+                    </div>
+
+                    <div className="flex-1 min-w-0">
+                      {isEditing ? (
+                        <form
+                          onSubmit={(e) => {
+                            e.preventDefault();
+                            performCredentialRename(cred.id, editingCredName);
+                          }}
+                          className="flex flex-wrap items-center gap-2"
+                        >
+                          <label htmlFor={`rename-${cred.id}`} className="sr-only">
+                            Passkey display name
+                          </label>
+                          <input
+                            id={`rename-${cred.id}`}
+                            type="text"
+                            value={editingCredName}
+                            onChange={(e) => setEditingCredName(e.target.value)}
+                            className="px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+                            placeholder="Enter passkey name"
+                            required
+                            autoFocus
+                          />
+                          <button
+                            type="submit"
+                            disabled={isSaving}
+                            className="px-3 py-1.5 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800 disabled:opacity-50 cursor-pointer"
+                          >
+                            {isSaving ? 'Saving...' : 'Save'}
+                          </button>
+                          <button
+                            type="button"
+                            onClick={cancelEditingCredential}
+                            className="px-3 py-1.5 bg-white border border-gray-300 text-gray-700 text-xs font-semibold rounded-md hover:bg-gray-50 cursor-pointer"
+                          >
+                            Cancel
+                          </button>
+                        </form>
+                      ) : (
+                        <div className="flex items-center flex-wrap gap-2">
+                          <h3 className="text-base font-semibold text-gray-900 truncate">
+                            {providerName}
+                          </h3>
+                          {cred.credentialBackedUp && (
+                            <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700">
+                              Synced
+                            </span>
+                          )}
+                        </div>
+                      )}
+
+                      {/* Registration Date & Last Used Date */}
+                      <div className="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
+                        <span>
+                          Registered: <strong className="font-medium text-gray-700">{formatEpochDate(cred.registeredAt)}</strong>
+                        </span>
+                        <span>
+                          Last used: <strong className="font-medium text-gray-700">{formatEpochDate(cred.lastUsedAt)}</strong>
+                        </span>
+                      </div>
+                    </div>
+                  </div>
+
+                  {/* Per-Item Action Buttons: Rename & Delete */}
+                  {!isEditing && (
+                    <div className="flex items-center space-x-2 self-end md:self-center">
+                      <button
+                        type="button"
+                        onClick={() => startEditingCredential(cred)}
+                        className="inline-flex items-center px-3 py-1.5 border border-gray-300 rounded-md text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900 cursor-pointer"
+                      >
+                        Rename
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => performDelete(cred.id, providerName)}
+                        disabled={isDeleting}
+                        className="inline-flex items-center px-3 py-1.5 border border-red-200 rounded-md text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-600 disabled:opacity-50 cursor-pointer"
+                      >
+                        {isDeleting ? 'Removing...' : 'Delete'}
+                      </button>
+                    </div>
+                  )}
+                </div>
+              );
+            })
+          )}
+        </div>
+      </section>
+
+      {/* Reader Profile & Authenticator User Details Sync Section */}
+      <section aria-labelledby="profile-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <div className="mb-4">
+          <h2 id="profile-heading" className="text-lg font-bold text-gray-900">
