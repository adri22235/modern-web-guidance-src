+import crypto from 'node:crypto';
+import aaguidsData from './aaguids.json';
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID (Base64URL-encoded)
+  credentialPublicKey: string; // Base64URL-encoded public key used to verify assertion signatures
+  credentialType: 'public-key';
+  credentialDeviceType: 'singleDevice' | 'multiDevice'; // Helps distinguish device-bound vs cloud-synced passkeys
+  credentialBackedUp: boolean; // Boolean backup state reported by the authenticator
+  aaguid: string; // Authenticator Attestation GUID
+  providerIcon?: string; // Provider icon derived from the AAGUID registry
+  name: string; // Provider name derived from AAGUID registry or custom nickname
+  transports: string[]; // Array of transport names (e.g. 'internal', 'hybrid') necessary for exclusion options
+  lastUsedAt?: number; // Optional epoch timestamp of last sign-in
+  registeredAt: number; // Registration epoch timestamp
+  counter: number; // Authenticator sign-in signature counter used to prevent replay attacks
+}
+
+export interface UserProfile {
+  id: string;
+  passkeyUserId: string; // Valid unpadded Base64URL string
+  name: string; // Account username / email
+  displayName: string; // User display name
+}
+
+interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+const aaguids = aaguidsData as Record<string, AaguidEntry>;
+
+// Predefined server RP ID and Name
+export const RP_ID = 'localhost';
+export const RP_NAME = 'The DevTools Times';
+
+// Valid unpadded Base64URL user ID for the signed-in reader
+const DEFAULT_USER_ID = Buffer.from('reader-devtools-times-01').toString('base64url');
+
+//Valid unpadded Base64URL credential IDs for initial seed data
+const SEED_CRED_1_ID = Buffer.from('cred-gpm-macbook-pro-2026').toString('base64url');
+const SEED_CRED_2_ID = Buffer.from('cred-icloud-keychain-iphone').toString('base64url');
+const SEED_CRED_3_ID = Buffer.from('cred-1password-work-vault').toString('base64url');
+
+export function resolveAaguidMetadata(aaguid: string, fallbackName = 'Unknown passkey provider'): {
+  name: string;
+  providerIcon?: string;
+} {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: fallbackName,
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || fallbackName,
+    providerIcon: provider?.icon_light,
+  };
+}
+
+const gpmMeta = resolveAaguidMetadata('ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4');
+const icloudMeta = resolveAaguidMetadata('fbfc3007-154e-4ecc-8c0b-6e020557d7bd');
+const onePasswordMeta = resolveAaguidMetadata('bada5566-a7aa-401f-bd96-45619a55120d');
+
+let currentUser: UserProfile = {
+  id: 'user-1',
+  passkeyUserId: DEFAULT_USER_ID,
+  name: 'alex.rivera@devtoolstimes.dev',
+  displayName: 'Alex Rivera',
+};
+
+let credentialsStore: StoredPasskeyCredential[] = [
+  {
+    id: SEED_CRED_1_ID,
+    passkeyUserId: DEFAULT_USER_ID,
+    credentialPublicKey: Buffer.from('mock-public-key-gpm-01').toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    providerIcon: gpmMeta.providerIcon,
+    name: gpmMeta.name,
+    transports: ['internal', 'hybrid'],
+    registeredAt: Date.now() - 1000 * 60 * 60 * 24 * 45, // 45 days ago
+    lastUsedAt: Date.now() - 1000 * 60 * 60 * 3, // 3 hours ago
+    counter: 12,
+  },
+  {
+    id: SEED_CRED_2_ID,
+    passkeyUserId: DEFAULT_USER_ID,
+    credentialPublicKey: Buffer.from('mock-public-key-apple-02').toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+    providerIcon: icloudMeta.providerIcon,
+    name: icloudMeta.name,
+    transports: ['internal', 'hybrid'],
+    registeredAt: Date.now() - 1000 * 60 * 60 * 24 * 120, // 120 days ago
+    lastUsedAt: Date.now() - 1000 * 60 * 60 * 24 * 14, // 14 days ago
+    counter: 5,
+  },
+  {
+    id: SEED_CRED_3_ID,
+    passkeyUserId: DEFAULT_USER_ID,
+    credentialPublicKey: Buffer.from('mock-public-key-1p-03').toString('base64url'),
+    credentialType: 'public-key',
+    credentialDeviceType: 'multiDevice',
+    credentialBackedUp: true,
+    aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+    providerIcon: onePasswordMeta.providerIcon,
+    name: onePasswordMeta.name,
+    transports: ['internal'],
+    registeredAt: Date.now() - 1000 * 60 * 60 * 24 * 210, // 210 days ago
+    counter: 0,
+  },
+];
+
+let latestChallenge: string = crypto.randomBytes(32).toString('base64url');
+
+export const passkeyStore = {
+  getUser(): UserProfile {
+    return { ...currentUser };
+  },
+
+  updateUser(updates: { name?: string; displayName?: string }): UserProfile {
+    if (typeof updates.name === 'string' && updates.name.trim()) {
+      currentUser.name = updates.name.trim();
+    }
+    if (typeof updates.displayName === 'string' && updates.displayName.trim()) {
+      currentUser.displayName = updates.displayName.trim();
+    }
+    return { ...currentUser };
+  },
+
+  findCredentialsByUserId(passkeyUserId: string = currentUser.passkeyUserId): StoredPasskeyCredential[] {
+    return credentialsStore
+      .filter((c) => c.passkeyUserId === passkeyUserId)
+      .map((c) => ({ ...c }));
+  },
+
+  findCredentialById(id: string): StoredPasskeyCredential | undefined {
+    const found = credentialsStore.find((c) => c.id === id);
+    return found ? { ...found } : undefined;
+  },
+
+  saveCredential(cred: StoredPasskeyCredential): StoredPasskeyCredential {
+    const index = credentialsStore.findIndex((c) => c.id === cred.id);
+    if (index >= 0) {
+      credentialsStore[index] = { ...cred };
+      return { ...credentialsStore[index] };
+    }
+    credentialsStore.unshift({ ...cred });
+    return { ...cred };
+  },
+
+  deleteCredential(id: string): boolean {
+    const initialLen = credentialsStore.length;
+    credentialsStore = credentialsStore.filter((c) => c.id !== id);
+    return credentialsStore.length < initialLen;
+  },
+
+  generateChallenge(): string {
+    latestChallenge = crypto.randomBytes(32).toString('base64url');
+    return latestChallenge;
+  },
+
+  getLatestChallenge(): string {
+    return latestChallenge;
+  },
+};
