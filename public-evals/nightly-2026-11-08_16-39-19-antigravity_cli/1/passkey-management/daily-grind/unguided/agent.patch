+            <p style="font-size: 0.88rem; margin-top: 4px;">Add a passkey for faster, passwordless sign-in.</p>
+          </div>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    (function () {
+      const STORAGE_KEY_PASSKEYS = 'daily_grind_passkeys_v1';
+      const STORAGE_KEY_USER = 'daily_grind_user_v1';
+
+      // Default signed-in customer with valid Base64URL userId and credentialIds
+      const DEFAULT_USER = {
+        userId: 'ZGFpbHktZ3JpbmQtdXNlci1hbGV4LWpvcmRhbi0wMQ',
+        name: 'alex.jordan@dailygrind.coffee',
+        displayName: 'Alex Jordan'
+      };
+
+      const DEFAULT_PASSKEYS = [
+        {
+          id: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+          credentialId: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+          name: 'MacBook Pro (iCloud Keychain)',
+          authenticator: 'Platform Authenticator',
+          createdAt: '2026-08-14',
+          lastUsedAt: '2026-11-08',
+          backedUp: true
+        },
+        {
+          id: 'AbCdEfGhIjKlMnOpQrStUvWxYz0123456789_-ab',
+          credentialId: 'AbCdEfGhIjKlMnOpQrStUvWxYz0123456789_-ab',
+          name: 'Pixel 9 Pro (Google Password Manager)',
+          authenticator: 'Synced Passkey',
+          createdAt: '2026-09-21',
+          lastUsedAt: '2026-11-05',
+          backedUp: true
+        },
+        {
+          id: 'YubiKey5NFC_Credential_9876543210abcdef',
+          credentialId: 'YubiKey5NFC_Credential_9876543210abcdef',
+          name: 'Backup YubiKey 5 NFC',
+          authenticator: 'Roaming Security Key',
+          createdAt: '2026-10-02',
+          lastUsedAt: '2026-10-19',
+          backedUp: false
+        }
+      ];
+
+      function toBase64Url(bytes) {
+        let binary = '';
+        const arr = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+        for (let i = 0; i < arr.byteLength; i++) {
+          binary += String.fromCharCode(arr[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function fromBase64Url(str) {
+        const base64 = str.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        const binary = atob(padded);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) {
+          bytes[i] = binary.charCodeAt(i);
+        }
+        return bytes;
+      }
+
+      function loadUser() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY_USER);
+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (parsed && parsed.userId && parsed.name && parsed.displayName) {
+              return parsed;
+            }
+          }
+        } catch (err) {
+          console.warn('Could not load user from storage:', err);
+        }
+        return { ...DEFAULT_USER };
+      }
+
+      function saveUser(user) {
+        try {
+          localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));
+        } catch (err) {
+          console.warn('Could not save user to storage:', err);
+        }
+      }
+
+      function loadPasskeys() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY_PASSKEYS);
+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (Array.isArray(parsed)) {
+              return parsed;
+            }
+          }
+        } catch (err) {
+          console.warn('Could not load passkeys from storage:', err);
+        }
+        return DEFAULT_PASSKEYS.map(pk => ({ ...pk }));
+      }
+
+      function savePasskeys(list) {
+        try {
+          localStorage.setItem(STORAGE_KEY_PASSKEYS, JSON.stringify(list));
+        } catch (err) {
+          console.warn('Could not save passkeys to storage:', err);
+        }
+      }
+
+      let currentUser = loadUser();
+      let passkeys = loadPasskeys();
+      let editingCredentialId = null;
+
+      function getRpId() {
+        return window.location.hostname || 'localhost';
+      }
+
+      function setStatusMessage(msg, type = 'success') {
+        const banner = document.getElementById('status-banner');
+        const text = document.getElementById('status-message');
+        if (!banner || !text) return;
+        text.textContent = msg;
+        banner.className = 'sync-banner' + (type === 'info' ? ' info' : '');
+      }
+
+      /**
+       * Keep the browser authenticator in sync with the current list of accepted passkeys
+       * using the WebAuthn Signal API:
+       * - PublicKeyCredential.signalAllAcceptedCredentials({ rpId, userId, allAcceptedCredentialIds })
+       * - PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }) when a specific key is removed
+       */
+      async function syncAcceptedCredentialsWithAuthenticator(removedCredentialId) {
+        const rpId = getRpId();
+        const acceptedIds = passkeys.map(pk => pk.credentialId);
+        const signalsSent = [];
+
+        if (typeof window.PublicKeyCredential !== 'undefined') {
+          if (removedCredentialId && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: rpId,
+                credentialId: removedCredentialId
+              });
+              signalsSent.push('signalUnknownCredential');
+            } catch (err) {
+              console.warn('PublicKeyCredential.signalUnknownCredential failed:', err);
+            }
+          }
+
+          if (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+            try {
+              await PublicKeyCredential.signalAllAcceptedCredentials({
+                rpId: rpId,
+                userId: currentUser.userId,
+                allAcceptedCredentialIds: acceptedIds
+              });
+              signalsSent.push('signalAllAcceptedCredentials');
+            } catch (err) {
+              console.warn('PublicKeyCredential.signalAllAcceptedCredentials failed:', err);
+            }
+          }
+        }
+
+        return signalsSent;
+      }
+
+      /**
+       * Keep the browser authenticator in sync with user / display name updates
+       * using PublicKeyCredential.signalCurrentUserDetails({ rpId, userId, name, displayName })
+       */
+      async function syncUserDetailsWithAuthenticator(customDisplayName) {
+        const rpId = getRpId();
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: rpId,
+              userId: currentUser.userId,
+              name: currentUser.name,
+              displayName: customDisplayName || currentUser.displayName
+            });
+            return true;
+          } catch (err) {
+            console.warn('PublicKeyCredential.signalCurrentUserDetails failed:', err);
+          }
+        }
+        return false;
+      }
+
+      function renderProfile() {
+        const displayTitle = document.getElementById('profile-display-title');
+        const usernameTitle = document.getElementById('profile-username-title');
+        const avatar = document.getElementById('profile-avatar');
+        const displayInput = document.getElementById('user-display-name');
+        const nameInput = document.getElementById('user-name');
+
+        if (displayTitle) displayTitle.textContent = currentUser.displayName;
+        if (usernameTitle) usernameTitle.textContent = currentUser.name;
+        if (displayInput) displayInput.value = currentUser.displayName;
+        if (nameInput) nameInput.value = currentUser.name;
+        if (avatar) {
+          const initials = currentUser.displayName
+            .split(/\s+/)
+            .filter(Boolean)
+            .slice(0, 2)
+            .map(part => part[0].toUpperCase())
+            .join('');
+          avatar.textContent = initials || 'DG';
+        }
+      }
+
+      function renderPasskeys() {
+        const listEl = document.getElementById('passkey-list');
+        const emptyEl = document.getElementById('passkey-empty');
+        if (!listEl || !emptyEl) return;
+
+        listEl.innerHTML = '';
+
+        if (passkeys.length === 0) {
+          emptyEl.style.display = 'block';
+          return;
+        }
+        emptyEl.style.display = 'none';
+
+        passkeys.forEach((pk) => {
+          const li = document.createElement('li');
+          li.className = 'passkey-item';
+          li.dataset.credentialId = pk.credentialId;
+
+          const infoDiv = document.createElement('div');
+          infoDiv.className = 'passkey-info';
+
+          const iconDiv = document.createElement('div');
+          iconDiv.className = 'passkey-icon';
+          iconDiv.setAttribute('aria-hidden', 'true');
+          iconDiv.textContent = '🔑';
+
+          const detailsDiv = document.createElement('div');
+          detailsDiv.className = 'passkey-details';
+
+          const nameRow = document.createElement('div');
+          nameRow.className = 'passkey-name-row';
+
+          const nameSpan = document.createElement('span');
+          nameSpan.className = 'passkey-name';
+          nameSpan.textContent = pk.name;
+
+          const badgeSpan = document.createElement('span');
+          badgeSpan.className = 'passkey-badge';
+          badgeSpan.textContent = pk.backedUp ? 'Synced' : 'Device-bound';
+
+          nameRow.appendChild(nameSpan);
+          nameRow.appendChild(badgeSpan);
+          detailsDiv.appendChild(nameRow);
+
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'passkey-meta';
+          const shortId = pk.credentialId.length > 16
+            ? pk.credentialId.slice(0, 10) + '...' + pk.credentialId.slice(-4)
+            : pk.credentialId;
+          metaDiv.innerHTML = `Created ${pk.createdAt} &bull; Last used ${pk.lastUsedAt} &bull; ID: <code class="passkey-id-code"></code>`;
+          metaDiv.querySelector('code').textContent = shortId;
+          detailsDiv.appendChild(metaDiv);
+
+          if (editingCredentialId === pk.credentialId) {
+            const renameForm = document.createElement('form');
+            renameForm.className = 'rename-form';
+            renameForm.setAttribute('aria-label', `Rename passkey ${pk.name}`);
+
+            const input = document.createElement('input');
+            input.type = 'text';
+            input.className = 'rename-input';
+            input.name = 'newName';
+            input.value = pk.name;
+            input.required = true;
+            input.setAttribute('aria-label', 'Passkey name');
+
+            const saveBtn = document.createElement('button');
+            saveBtn.type = 'submit';
+            saveBtn.className = 'btn btn-sm';
+            saveBtn.textContent = 'Save';
+
+            const cancelBtn = document.createElement('button');
+            cancelBtn.type = 'button';
+            cancelBtn.className = 'btn btn-secondary btn-sm';
+            cancelBtn.textContent = 'Cancel';
+            cancelBtn.addEventListener('click', () => {
+              editingCredentialId = null;
+              renderPasskeys();
+            });
+
+            renameForm.addEventListener('submit', async (e) => {
+              e.preventDefault();
+              const trimmed = input.value.trim();
+              if (!trimmed) return;
+              await renamePasskey(pk.credentialId, trimmed);
+            });
+
+            renameForm.appendChild(input);
+            renameForm.appendChild(saveBtn);
+            renameForm.appendChild(cancelBtn);
+            detailsDiv.appendChild(renameForm);
+
+            setTimeout(() => input.focus(), 0);
+          }
+
+          infoDiv.appendChild(iconDiv);
+          infoDiv.appendChild(detailsDiv);
+
+          const actionsDiv = document.createElement('div');
+          actionsDiv.className = 'passkey-actions';
+
+          if (editingCredentialId !== pk.credentialId) {
+            const renameBtn = document.createElement('button');
+            renameBtn.type = 'button';
+            renameBtn.className = 'btn btn-secondary btn-sm rename-passkey-btn';
+            renameBtn.textContent = 'Rename';
+            renameBtn.setAttribute('aria-label', `Rename ${pk.name}`);
+            renameBtn.addEventListener('click', () => {
+              editingCredentialId = pk.credentialId;
+              renderPasskeys();
+            });
+            actionsDiv.appendChild(renameBtn);
+          }
+
+          const deleteBtn = document.createElement('button');
+          deleteBtn.type = 'button';
+          deleteBtn.className = 'btn btn-danger btn-sm delete-passkey-btn';
+          deleteBtn.textContent = 'Delete';
+          deleteBtn.setAttribute('aria-label', `Delete ${pk.name}`);
+          deleteBtn.addEventListener('click', async () => {
+            await deletePasskey(pk.credentialId);
+          });
+          actionsDiv.appendChild(deleteBtn);
+
+          li.appendChild(infoDiv);
+          li.appendChild(actionsDiv);
+          listEl.appendChild(li);
+        });
+      }
+
+      async function renamePasskey(credentialId, newName) {
+        const target = passkeys.find(pk => pk.credentialId === credentialId);
+        if (!target) return;
+        target.name = newName;
+        editingCredentialId = null;
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncUserDetailsWithAuthenticator();
+        await syncAcceptedCredentialsWithAuthenticator();
+
+        setStatusMessage(`Passkey renamed to "${newName}" and synced with your browser authenticator.`);
+      }
+
+      async function deletePasskey(credentialId) {
+        const index = passkeys.findIndex(pk => pk.credentialId === credentialId);
+        if (index === -1) return;
+        const removed = passkeys[index];
+        passkeys.splice(index, 1);
+        if (editingCredentialId === credentialId) {
+          editingCredentialId = null;
+        }
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncAcceptedCredentialsWithAuthenticator(credentialId);
+
+        setStatusMessage(`Deleted passkey "${removed.name}" and notified your browser authenticator.`);
+      }
+
+      async function registerNewPasskey() {
+        const today = new Date().toISOString().slice(0, 10);
+        let newCredentialId = 'passkey_' + toBase64Url(crypto.getRandomValues(new Uint8Array(16)));
+        let passkeyLabel = `Passkey #${passkeys.length + 1}`;
+
+        if (navigator.credentials && typeof navigator.credentials.create === 'function') {
+          try {
+            const challenge = crypto.getRandomValues(new Uint8Array(32));
+            const userIdBytes = fromBase64Url(currentUser.userId);
+            const excludeCredentials = passkeys.map(pk => ({
+              id: fromBase64Url(pk.credentialId),
+              type: 'public-key'
+            }));
+
+            const credential = await navigator.credentials.create({
+              publicKey: {
+                challenge: challenge,
+                rp: {
+                  name: 'The Daily Grind',
+                  id: getRpId()
+                },
+                user: {
+                  id: userIdBytes,
+                  name: currentUser.name,
+                  displayName: currentUser.displayName
+                },
+                pubKeyCredParams: [
+                  { type: 'public-key', alg: -7 },
+                  { type: 'public-key', alg: -257 }
+                ],
+                authenticatorSelection: {
+                  residentKey: 'required',
+                  userVerification: 'preferred'
+                },
+                excludeCredentials: excludeCredentials
+              }
+            });
+
+            if (credential && credential.rawId) {
+              newCredentialId = toBase64Url(new Uint8Array(credential.rawId));
+            }
+          } catch (err) {
+            if (err && err.name === 'NotAllowedError') {
+              setStatusMessage('Passkey registration was cancelled.', 'info');
+              return;
+            }
+            console.warn('WebAuthn navigator.credentials.create fallback:', err);
+          }
+        }
+
+        const newEntry = {
+          id: newCredentialId,
+          credentialId: newCredentialId,
+          name: passkeyLabel,
+          authenticator: 'Platform Authenticator',
+          createdAt: today,
+          lastUsedAt: today,
+          backedUp: true
+        };
+
+        passkeys.push(newEntry);
+        savePasskeys(passkeys);
+        renderPasskeys();
+
+        await syncAcceptedCredentialsWithAuthenticator();
+        setStatusMessage(`Registered "${passkeyLabel}" and synced with your browser authenticator.`);
+      }
+
+      // Wire up event listeners
+      document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const displayInput = document.getElementById('user-display-name');
+        const nameInput = document.getElementById('user-name');
+        const newDisplayName = displayInput ? displayInput.value.trim() : '';
+        const newName = nameInput ? nameInput.value.trim() : '';
+        if (!newDisplayName || !newName) return;
+
+        currentUser.displayName = newDisplayName;
+        currentUser.name = newName;
+        saveUser(currentUser);
+        renderProfile();
+
+        await syncUserDetailsWithAuthenticator();
+        setStatusMessage(`Updated account details for "${newDisplayName}" and synced with your browser authenticator.`);
+      });
+
+      document.getElementById('register-passkey-btn')?.addEventListener('click', () => {
+        registerNewPasskey();
+      });
+
+      document.getElementById('sync-authenticator-btn')?.addEventListener('click', async () => {
+        await syncUserDetailsWithAuthenticator();
+        await syncAcceptedCredentialsWithAuthenticator();
+        setStatusMessage('All registered passkeys and user details have been synchronized with your browser authenticator.');
+      });
+
+      // Expose helper API on window for programmatic inspection / integration
+      window.DailyGrindPasskeys = {
+        getUser: () => ({ ...currentUser }),
+        getPasskeys: () => passkeys.map(pk => ({ ...pk })),
+        renamePasskey,
+        deletePasskey,
+        registerNewPasskey,
+        syncAcceptedCredentialsWithAuthenticator,
+        syncUserDetailsWithAuthenticator
+      };
+
+      // Initial render & initial authenticator synchronization on load
+      renderProfile();
+      renderPasskeys();
+      syncAcceptedCredentialsWithAuthenticator();
+      syncUserDetailsWithAuthenticator();
+    })();
+  </script>
+</body>
+
