+  <script>
+    (function () {
+      const menuToggle = document.getElementById('menu-toggle');
+      const drawerClose = document.getElementById('drawer-close');
+      const navDrawer = document.getElementById('nav-drawer');
+      const drawerOverlay = document.getElementById('drawer-overlay');
+
+      let isOpen = false;
+      let startX = null;
+      let startY = null;
+      let currentDeltaX = 0;
+      let isDragging = false;
+
+      function openDrawer() {
+        isOpen = true;
+        navDrawer.classList.add('open');
+        drawerOverlay.classList.add('open');
+        navDrawer.setAttribute('aria-hidden', 'false');
+        drawerOverlay.setAttribute('aria-hidden', 'false');
+        menuToggle.setAttribute('aria-expanded', 'true');
+        navDrawer.style.transform = '';
+      }
+
+      function closeDrawer() {
+        if (!isOpen && !navDrawer.classList.contains('open')) return;
+        isOpen = false;
+        isDragging = false;
+        startX = null;
+        startY = null;
+        currentDeltaX = 0;
+        navDrawer.classList.remove('open', 'dragging');
+        drawerOverlay.classList.remove('open');
+        navDrawer.setAttribute('aria-hidden', 'true');
+        drawerOverlay.setAttribute('aria-hidden', 'true');
+        menuToggle.setAttribute('aria-expanded', 'false');
+        navDrawer.style.transform = '';
+      }
+
+      function toggleDrawer(e) {
+        if (e) e.stopPropagation();
+        if (isOpen) {
+          closeDrawer();
+        } else {
+          openDrawer();
+        }
+      }
+
+      menuToggle.addEventListener('click', toggleDrawer);
+      drawerClose.addEventListener('click', function (e) {
+        e.stopPropagation();
+        closeDrawer();
+      });
+
+      drawerOverlay.addEventListener('click', function () {
+        closeDrawer();
+      });
+
+      // Close when tapping/clicking anywhere outside the drawer and toggle button
+      document.addEventListener('click', function (e) {
+        if (!isOpen) return;
+        if (!navDrawer.contains(e.target) && !menuToggle.contains(e.target)) {
+          closeDrawer();
+        }
+      });
+
+      // Close on Escape key press
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && isOpen) {
+          closeDrawer();
+          menuToggle.focus();
+        }
+      });
+
+      // Close when a navigation link inside the drawer is clicked
+      navDrawer.querySelectorAll('a').forEach(function (link) {
+        link.addEventListener('click', function () {
+          closeDrawer();
+        });
+      });
+
+      // Swipe gesture support (Touch & Pointer/Mouse events)
+      const SWIPE_THRESHOLD = 40;
+
+      function handleSwipeStart(x, y) {
+        if (!isOpen) return;
+        startX = x;
+        startY = y;
+        currentDeltaX = 0;
+        isDragging = true;
+        navDrawer.classList.add('dragging');
+      }
+
+      function handleSwipeMove(x, y) {
+        if (!isDragging || startX === null) return;
+        const deltaX = x - startX;
+        const deltaY = y - startY;
+
+        // Visual drag feedback when swiping left
+        if (deltaX < 0 && Math.abs(deltaX) > Math.abs(deltaY)) {
+          currentDeltaX = deltaX;
+          navDrawer.style.transform = `translateX(${deltaX}px)`;
+        } else {
+          currentDeltaX = deltaX;
+        }
+      }
+
+      function handleSwipeEnd(endX, endY) {
+        if (!isDragging || startX === null) return;
+        const deltaX = endX !== undefined ? endX - startX : currentDeltaX;
+        const deltaY = endY !== undefined && startY !== null ? endY - startY : 0;
+
+        isDragging = false;
+        startX = null;
+        startY = null;
+        navDrawer.classList.remove('dragging');
+        navDrawer.style.transform = '';
+
+        // Close if horizontal swipe distance exceeds threshold (either left or right swipe away)
+        if (Math.abs(deltaX) >= SWIPE_THRESHOLD && Math.abs(deltaX) >= Math.abs(deltaY)) {
+          closeDrawer();
+        }
+      }
+
+      // Touch events
+      document.addEventListener('touchstart', function (e) {
+        if (!isOpen || !e.touches || e.touches.length === 0) return;
+        handleSwipeStart(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      document.addEventListener('touchmove', function (e) {
+        if (!isDragging || !e.touches || e.touches.length === 0) return;
+        handleSwipeMove(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      document.addEventListener('touchend', function (e) {
+        if (!isDragging) return;
+        const touch = e.changedTouches && e.changedTouches[0];
+        handleSwipeEnd(touch ? touch.clientX : undefined, touch ? touch.clientY : undefined);
+      }, { passive: true });
+
+      // Pointer / Mouse events for swipe simulation
+      navDrawer.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'touch') return;
+        handleSwipeStart(e.clientX, e.clientY);
+      });
+
+      document.addEventListener('pointermove', function (e) {
+        if (e.pointerType === 'touch' || !isDragging) return;
+        handleSwipeMove(e.clientX, e.clientY);
+      });
+
+      document.addEventListener('pointerup', function (e) {
+        if (e.pointerType === 'touch' || !isDragging) return;
+        handleSwipeEnd(e.clientX, e.clientY);
+      });
+    })();
+  </script>
 </body>
 
