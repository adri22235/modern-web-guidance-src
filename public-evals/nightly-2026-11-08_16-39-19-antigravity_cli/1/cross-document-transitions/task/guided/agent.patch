+  <script blocking="render">
+    (function () {
+      const pageOrder = ['/previous.html', '/index.html', '/next.html'];
+
+      function normalizePath(urlStr) {
+        try {
+          const url = new URL(urlStr, window.location.origin);
+          let path = url.pathname;
+          if (path === '/' || path === '') return '/index.html';
+          if (!path.endsWith('.html')) path += '.html';
+          return path;
+        } catch {
+          return '/index.html';
+        }
+      }
+
+      function getTransitionDirection(fromUrl, toUrl) {
+        if (fromUrl && toUrl) {
+          const fromIndex = pageOrder.indexOf(normalizePath(fromUrl));
+          const toIndex = pageOrder.indexOf(normalizePath(toUrl));
+          if (fromIndex !== -1 && toIndex !== -1 && fromIndex !== toIndex) {
+            const diff = (toIndex - fromIndex + pageOrder.length) % pageOrder.length;
+            return diff === 1 ? 'next' : 'previous';
+          }
+        }
+        try {
+          const saved = sessionStorage.getItem('dg-transition-direction');
+          if (saved === 'next' || saved === 'previous') {
+            return saved;
+          }
+        } catch {}
+        return 'next';
+      }
+
+      if ('onpagereveal' in window) {
+        window.addEventListener('pagereveal', (event) => {
+          if (!event.viewTransition) return;
+
+          let direction = null;
+          if (window.navigation?.activation) {
+            const fromUrl = window.navigation.activation.from?.url;
+            const toUrl = window.navigation.activation.entry?.url || window.location.href;
+            direction = getTransitionDirection(fromUrl, toUrl);
+          } else {
+            direction = getTransitionDirection(document.referrer, window.location.href);
+          }
+
+          if (direction === 'previous') {
+            event.viewTransition.types.add('previous');
+            event.viewTransition.types.add('backward');
+          } else {
+            event.viewTransition.types.add('next');
+            event.viewTransition.types.add('forward');
+          }
+        });
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a#previous, a#next');
+        if (!link) return;
+        try {
+          sessionStorage.setItem('dg-transition-direction', link.id === 'previous' ? 'previous' : 'next');
+        } catch {}
+      });
+    })();
+  </script>
