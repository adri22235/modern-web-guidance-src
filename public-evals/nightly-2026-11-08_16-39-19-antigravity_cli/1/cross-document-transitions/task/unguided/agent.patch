+  <script>
+    (function () {
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('a#previous, a#next');
+        if (link) {
+          const direction = link.id === 'next' ? 'forwards' : 'backwards';
+          sessionStorage.setItem('transitionDirection', direction);
+        }
+      });
+
+      function applyDirection(event) {
+        if (reducedMotionQuery.matches) {
+          if (event.viewTransition && event.viewTransition.types) {
+            event.viewTransition.types.clear();
+          }
+          delete document.documentElement.dataset.transitionDirection;
+          return;
+        }
+
+        let direction = sessionStorage.getItem('transitionDirection');
+
+        if (!direction && window.navigation && window.navigation.activation) {
+          const { from, entry, navigationType } = window.navigation.activation;
+          if (navigationType === 'traverse' && from && entry) {
+            direction = entry.index > from.index ? 'forwards' : 'backwards';
+          }
+        }
+
+        direction = direction || 'forwards';
+        document.documentElement.dataset.transitionDirection = direction;
+
+        if (event.viewTransition && event.viewTransition.types) {
+          event.viewTransition.types.clear();
+          event.viewTransition.types.add('slide');
+          event.viewTransition.types.add(direction);
+        }
+      }
+
+      window.addEventListener('pageswap', (event) => {
+        if (event.viewTransition) {
+          applyDirection(event);
+        }
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (event.viewTransition) {
+          applyDirection(event);
+          event.viewTransition.finished.finally(() => {
+            delete document.documentElement.dataset.transitionDirection;
+            sessionStorage.removeItem('transitionDirection');
+          });
+        } else {
+          sessionStorage.removeItem('transitionDirection');
+        }
+      });
+    })();
+  </script>
