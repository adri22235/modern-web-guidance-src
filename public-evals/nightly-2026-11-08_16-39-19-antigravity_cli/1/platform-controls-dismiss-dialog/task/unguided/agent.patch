+  <script>
+    (function () {
+      const COFFEE_DETAILS = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          price: '$5.50',
+          description:
+            'Creamy oat milk with a hint of Vermont maple syrup, paired with our signature double-shot espresso and finished with a light dusting of warm cinnamon.',
+          notes: 'Pure Vermont Maple, Toasted Oat, Warm Cinnamon',
+          roast: 'Medium-Dark Espresso, Steamed Barista Oat Milk',
+          dietary: '100% Plant-Based / Dairy-Free \u2022 12 oz / 16 oz',
+          image:
+            'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'Maple Oat Latte with latte art in a ceramic cup'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          price: '$3.75',
+          description:
+            'Bold, smokey, and perfect for a morning boost. Pulled from single-origin Sumatra and Colombian beans roasted to a rich, velvety finish with lingering crema.',
+          notes: 'Dark Chocolate, Smoked Cedar, Caramelized Sugar',
+          roast: 'Full City Dark Roast, Double Ristretto Pull',
+          dietary: 'Vegan \u2022 Single (1 oz) / Double (2 oz)',
+          image:
+            'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'Freshly pulled Dark Roast Espresso shot with rich crema'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          price: '$4.75',
+          description:
+            'Steeped for 18 hours in filtered cold water for maximum smoothness and naturally low acidity, served chilled over crystal-clear artisan ice.',
+          notes: 'Smooth Cocoa, Toffee, Crisp Clean Finish',
+          roast: 'Medium Ethiopian & Guatemalan Blend, 18-Hour Cold Steep',
+          dietary: 'Vegan & Unsweetened \u2022 16 oz / 20 oz',
+          image:
+            'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=900&q=80',
+          imageAlt: 'Iced Cold Brew coffee poured over ice in a glass'
+        }
+      };
+
+      const modal = document.getElementById('coffee-details-modal');
+      const titleEl = document.getElementById('modal-title');
+      const priceEl = document.getElementById('modal-price');
+      const descEl = document.getElementById('modal-description');
+      const notesEl = document.getElementById('modal-notes');
+      const roastEl = document.getElementById('modal-roast');
+      const dietaryEl = document.getElementById('modal-dietary');
+      const imageEl = document.getElementById('modal-image');
+      const closeBtn = modal.querySelector('[data-close-modal]');
+
+      let activeTrigger = null;
+
+      function openCoffeeModal(coffeeId, triggerEl) {
+        const data = COFFEE_DETAILS[coffeeId];
+        if (!data) return;
+
+        activeTrigger = triggerEl || null;
+        titleEl.textContent = data.title;
+        priceEl.textContent = data.price;
+        descEl.textContent = data.description;
+        notesEl.textContent = data.notes;
+        roastEl.textContent = data.roast;
+        dietaryEl.textContent = data.dietary;
+        imageEl.src = data.image;
+        imageEl.alt = data.imageAlt;
+
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+      }
+
+      function closeCoffeeModal() {
+        if (!modal.open) return;
+        if (typeof modal.close === 'function') {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+      }
+
+      document.querySelectorAll('[data-coffee-id]').forEach((button) => {
+        button.addEventListener('click', (event) => {
+          event.preventDefault();
+          openCoffeeModal(button.getAttribute('data-coffee-id'), button);
+        });
+      });
+
+      if (closeBtn) {
+        closeBtn.addEventListener('click', () => {
+          closeCoffeeModal();
+        });
+      }
+
+      // Dismiss when clicking on the dialog backdrop outside .modal-inner
+      modal.addEventListener('click', (event) => {
+        if (event.target === modal) {
+          closeCoffeeModal();
+        }
+      });
+
+      // Fallback for synthetic/untrusted Escape key events in test environments
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && !event.isTrusted && modal.open) {
+          const cancelEvent = new Event('cancel', { cancelable: true });
+          if (modal.dispatchEvent(cancelEvent)) {
+            closeCoffeeModal();
+          }
+        }
+      });
+
+      // Ensure history popstate also dismisses the modal if open
+      window.addEventListener('popstate', () => {
+        if (modal.open) {
+          closeCoffeeModal();
+        }
+      });
+
+      // Restore focus to the triggering button when the dialog closes
+      modal.addEventListener('close', () => {
+        if (activeTrigger && typeof activeTrigger.focus === 'function') {
+          activeTrigger.focus();
+        }
+      });
+    })();
+  </script>
+
