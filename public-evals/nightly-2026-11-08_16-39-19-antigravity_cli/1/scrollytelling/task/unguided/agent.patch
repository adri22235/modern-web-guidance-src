+  <script>
+    (function () {
+      const trackedSections = Array.from(document.querySelectorAll('#tracked > section'));
+      const animatedSections = Array.from(document.querySelectorAll('#animated > section'));
+
+      if (!trackedSections.length || !animatedSections.length) return;
+
+      function updateScrollAnimations() {
+        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
+        const viewportCenter = viewportHeight / 2;
+
+        let closestIndex = 0;
+        let minDistance = Infinity;
+
+        trackedSections.forEach((stepEl, index) => {
+          const rect = stepEl.getBoundingClientRect();
+          const stepCenter = rect.top + rect.height / 2;
+          const distanceFromCenter = stepCenter - viewportCenter;
+          const absDistance = Math.abs(distanceFromCenter);
+
+          if (absDistance < minDistance) {
+            minDistance = absDistance;
+            closestIndex = index;
+          }
+
+          // Continuous normalized progress: 0 when entering bottom, 0.5 at center, 1 when exiting top
+          const totalTravel = viewportHeight + rect.height;
+          const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / totalTravel));
+          stepEl.style.setProperty('--scroll-progress', progress.toFixed(3));
+
+          const visualEl = animatedSections[index];
+          if (visualEl) {
+            visualEl.style.setProperty('--scroll-progress', progress.toFixed(3));
+          }
+        });
+
+        trackedSections.forEach((stepEl, index) => {
+          stepEl.classList.toggle('is-active', index === closestIndex);
+        });
+
+        animatedSections.forEach((visualEl, index) => {
+          const isActive = index === closestIndex;
+          visualEl.classList.toggle('is-active', isActive);
+          if (!CSS.supports('animation-timeline: --step-1')) {
+            const rect = trackedSections[index].getBoundingClientRect();
+            const offsetRatio = Math.max(-1, Math.min(1, (rect.top + rect.height / 2 - viewportCenter) / (viewportHeight * 0.6)));
+            const opacity = isActive ? Math.max(0.2, 1 - Math.abs(offsetRatio) * 0.8) : 0;
+            const scale = isActive ? 1 + Math.abs(offsetRatio) * 0.05 : 1.08;
+            const translateY = isActive ? offsetRatio * 20 : (index < closestIndex ? -24 : 24);
+            visualEl.style.opacity = String(opacity);
+            visualEl.style.transform = `scale(${scale.toFixed(3)}) translateY(${translateY.toFixed(1)}px)`;
+          }
+        });
+      }
+
+      window.addEventListener('scroll', updateScrollAnimations, { passive: true });
+      window.addEventListener('resize', updateScrollAnimations);
+      updateScrollAnimations();
+    })();
+  </script>
