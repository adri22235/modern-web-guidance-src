+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('ai-status');
+      const summaryBox = document.getElementById('journal-summary');
+      const summaryList = document.getElementById('summary-list');
+      const articleEl = document.getElementById('journal-article');
+
+      const summarizerOptions = {
+        sharedContext: 'An article from an artisanal coffee roastery journal describing their ethical direct-trade bean sourcing, harvesting, processing, and quality control process.',
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'medium',
+      };
+
+      function renderBullets(summaryText) {
+        summaryList.innerHTML = '';
+        const lines = summaryText
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+
+        const bullets = lines.length > 0 ? lines : [summaryText.trim()].filter(Boolean);
+
+        for (const point of bullets) {
+          const li = document.createElement('li');
+          li.textContent = point;
+          summaryList.appendChild(li);
+        }
+
+        summaryBox.hidden = bullets.length === 0;
+      }
+
+      async function checkSupport() {
+        if (!('Summarizer' in self)) {
+          summarizeBtn.disabled = true;
+          statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+          return false;
+        }
+
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            summarizeBtn.disabled = true;
+            statusEl.textContent = 'Local summarization is unavailable on this device.';
+            return false;
+          }
+          if (availability === 'downloadable') {
+            statusEl.textContent = 'Click Summarize to download the on-device AI model and generate key points.';
+          }
+          return true;
+        } catch (err) {
+          summarizeBtn.disabled = true;
+          statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+          return false;
+        }
+      }
+
+      checkSupport();
+
+      summarizeBtn.addEventListener('click', async () => {
+        if (!('Summarizer' in self)) {
+          summarizeBtn.disabled = true;
+          statusEl.textContent = 'Local summarization is currently unsupported in this browser.';
+          return;
+        }
+
+        summarizeBtn.disabled = true;
+        statusEl.textContent = 'Checking on-device AI availability...';
+
+        let summarizer;
+        try {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            statusEl.textContent = 'Local summarization is unavailable on this device.';
+            return;
+          }
+
+          statusEl.textContent =
+            availability === 'available'
+              ? 'Summarizing journal entry...'
+              : 'Preparing on-device AI model...';
+
+          summarizer = await Summarizer.create({
+            ...summarizerOptions,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (e.total) {
+                  const pct = Math.round((e.loaded / e.total) * 100);
+                  statusEl.textContent = `Downloading on-device AI model (${pct}%)...`;
+                } else {
+                  statusEl.textContent = 'Downloading on-device AI model...';
+                }
+              });
+            },
+          });
+
+          statusEl.textContent = 'Generating bullet points...';
+          const longText = articleEl.innerText;
+          const summary = await summarizer.summarize(longText, {
+            context: 'Summarize the coffee bean sourcing and roasting process into concise bullet points for coffee shop customers.',
+          });
+
+          renderBullets(summary);
+          statusEl.textContent = 'Summarized on-device with Built-in AI.';
+          summarizeBtn.disabled = false;
+        } catch (error) {
+          console.error('Summarization failed:', error);
+          statusEl.textContent = 'Unable to generate summary with on-device AI.';
+          summarizeBtn.disabled = false;
+        } finally {
+          if (summarizer && typeof summarizer.destroy === 'function') {
+            summarizer.destroy();
+          }
+        }
+      });
+    })();
+  </script>
+
 </body>
 
