+    <section id="roasters-journal" class="journal-section">
+      <div class="journal-header">
+        <div>
+          <h2>Roaster's Journal: From High-Altitude Farms to Your Morning Cup</h2>
+          <p class="journal-meta">Field Notes on Our Bean Sourcing Process &mdash; By Elena Vance, Head Roaster</p>
+        </div>
+        <button id="summarize-btn" type="button" class="btn summarize-btn">
+          ✨ Summarize
