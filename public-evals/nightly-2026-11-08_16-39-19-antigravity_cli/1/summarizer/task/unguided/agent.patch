+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const journalContent = document.getElementById('journal-content');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryContainer = document.getElementById('summary-container');
+    const summaryList = document.getElementById('summary-list');
+
+    function renderBulletPoints(summaryText) {
+      summaryList.innerHTML = '';
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*\-•\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      if (lines.length === 0 && summaryText.trim()) {
+        lines.push(summaryText.trim());
+      }
+
+      for (const point of lines) {
+        const li = document.createElement('li');
+        li.textContent = point;
+        summaryList.appendChild(li);
+      }
+
+      summaryContainer.classList.add('visible');
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const textToSummarize = journalContent.innerText.trim();
+      if (!textToSummarize) return;
+
+      summarizeBtn.disabled = true;
+      summaryStatus.textContent = 'Checking browser AI availability...';
+
+      const summarizerOptions = {
+        sharedContext: 'A coffee roaster journal article detailing ethical, direct-trade coffee bean sourcing, harvesting, processing, cupping, and roasting.',
+        type: 'key-points',
+        format: 'markdown',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      let summarizer = null;
+
+      try {
+        if ('Summarizer' in self) {
+          const availability = await Summarizer.availability(summarizerOptions);
+          if (availability === 'unavailable') {
+            throw new Error('The built-in AI Summarizer is unavailable on this device or browser.');
+          }
+
+          if (availability === 'downloadable' || availability === 'downloading') {
+            summaryStatus.textContent = 'Downloading built-in AI model...';
+          } else {
+            summaryStatus.textContent = 'Generating summary...';
+          }
+
+          summarizer = await Summarizer.create({
+            ...summarizerOptions,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const progress = typeof e.loaded === 'number' ? Math.round(e.loaded * 100) : 0;
+                summaryStatus.textContent = `Downloading AI model... ${progress}%`;
+              });
+            },
+          });
+
+          summaryStatus.textContent = 'Summarizing article...';
+          const summary = await summarizer.summarize(textToSummarize, {
+            context: 'Summarize the coffee bean sourcing process into a few concise bullet points.',
+          });
+
+          renderBulletPoints(summary);
+          summaryStatus.textContent = 'Summary generated using browser built-in AI.';
+        } else if (self.ai && self.ai.summarizer) {
+          const capabilities = await self.ai.summarizer.capabilities();
+          if (capabilities && capabilities.available === 'no') {
+            throw new Error('The built-in AI Summarizer is unavailable on this device or browser.');
+          }
+
+          summaryStatus.textContent = 'Generating summary...';
+          summarizer = await self.ai.summarizer.create(summarizerOptions);
+          const summary = await summarizer.summarize(textToSummarize);
+
+          renderBulletPoints(summary);
+          summaryStatus.textContent = 'Summary generated using browser built-in AI.';
+        } else {
+          throw new Error('Your browser does not support the native AI Summarizer API.');
+        }
+      } catch (error) {
+        console.error('Summarization failed:', error);
+        summaryStatus.textContent = error.message || 'Unable to generate summary with browser AI.';
+      } finally {
+        if (summarizer && typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
