+  <script type="module">
+    import 'webauthn-polyfills';
+
+    let isAuthenticating = false;
+    let pendingAuthContext = null;
+
+    const statusBanner = document.getElementById('auth-status-banner');
+    const statusMessage = document.getElementById('auth-status-message');
+    const fallbackSection = document.getElementById('fallback-signin');
+    const fallbackSubtitle = document.getElementById('fallback-signin-subtitle');
+    const fallbackForm = document.getElementById('fallback-signin-form');
+    const fallbackFullSigninLink = document.getElementById('fallback-full-signin-link');
+    const closeFallbackBtn = document.getElementById('close-fallback-btn');
+    const togglePasswordBtn = document.getElementById('toggle-password-btn');
+    const passwordInput = document.getElementById('current-password');
+    const emailInput = document.getElementById('email');
+    const navUserItem = document.getElementById('nav-user-item');
+    const navUserBadge = document.getElementById('nav-user-badge');
+    const navSigninItem = document.getElementById('nav-signin-item');
+    const logoutLink = document.getElementById('logout-link');
+
+    async function isImmediateUiSupported() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        return false;
+      }
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        return Boolean(capabilities?.immediateGet);
+      } catch {
+        return false;
+      }
+    }
+
+    async function authenticateWithImmediateUi() {
+      // MANDATORY: Check immediateGet support so unsupported browsers do not open a modal QR dialog
+      const supported = await isImmediateUiSupported();
+      if (!supported) {
+        throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+      }
+
+      const optionsResponse = await fetch('/api/login/options', { method: 'POST' });
+      if (!optionsResponse.ok) {
+        throw new Error('Failed to fetch authentication options');
+      }
+      const optionsJSON = await optionsResponse.json();
+      // Never pass a non-empty allowCredentials list with uiMode: 'immediate'
+      delete optionsJSON.allowCredentials;
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+      delete publicKey.allowCredentials;
+
+      // MANDATORY: Request both password and publicKey with uiMode: 'immediate' and NO signal parameter
+      const cred = await navigator.credentials.get({
+        password: true,
+        publicKey,
+        uiMode: 'immediate',
+      });
+
+      if (!cred) {
+        throw new DOMException('No credential returned', 'NotAllowedError');
+      }
+
+      if (cred.type === 'public-key') {
+        const encoded = cred.toJSON();
+        const verifyResponse = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+        });
+
+        if (verifyResponse.status === 404) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: publicKey.rpId, // Always use the server-provided rpId; DO NOT use window.location.hostname
+              credentialId: encoded.id, // Base64URL-encoded credential ID string
+            });
+          }
+          throw new Error('Passkey credential is no longer recognized by the server');
+        }
+
+        if (!verifyResponse.ok) {
+          throw new Error('Passkey verification failed');
+        }
+        return await verifyResponse.json();
+      }
+
+      if (cred.type === 'password') {
+        const verifyResponse = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: cred.id,
+            password: cred.password,
+          }),
+        });
+
+        if (!verifyResponse.ok) {
+          throw new Error('Password verification failed');
+        }
+        return await verifyResponse.json();
+      }
+
+      throw new Error(`Unsupported credential type: ${cred.type}`);
+    }
+
+    function showStatusBanner(message) {
+      statusMessage.textContent = message;
+      statusBanner.hidden = false;
+    }
+
+    function updateHeaderUserState(user) {
+      const displayName = user?.name || user?.username || user?.email || 'Coffee Lover';
+      document.body.dataset.signedIn = 'true';
+      navUserBadge.textContent = `Welcome back, ${displayName}`;
+      navUserItem.hidden = false;
+      navSigninItem.hidden = true;
+      fallbackSection.hidden = true;
+    }
+
+    function toggleFavoriteButton(button, forcePressed) {
+      const nextPressed = typeof forcePressed === 'boolean'
+        ? forcePressed
+        : button.getAttribute('aria-pressed') !== 'true';
+      button.setAttribute('aria-pressed', String(nextPressed));
+      button.textContent = nextPressed ? 'Saved to Favorites' : 'Save Favorite';
+      const itemName = button.dataset.itemName || 'item';
+      showStatusBanner(
+        nextPressed
+          ? `Added ${itemName} to your Daily Grind favorites.`
+          : `Removed ${itemName} from your Daily Grind favorites.`
+      );
+    }
+
+    function completeUserIntent(context, user) {
+      if (!context) return;
+      const { trigger, returnAction, returnUrl } = context;
+      const displayName = user?.name || user?.username || user?.email || 'Member';
+
+      if (trigger && trigger.hasAttribute('aria-pressed')) {
+        toggleFavoriteButton(trigger, true);
+        return;
+      }
+
+      const actionMessages = {
+        rewards: `Signed in as ${displayName}. You have 240 Roast Points ready to redeem in Rewards.`,
+        account: `Signed in as ${displayName}. Your Daily Grind account preferences and saved orders are unlocked.`,
+        order: `Signed in as ${displayName}. Your express pickup order has started with your saved preferences.`,
+        signin: `Signed in as ${displayName}. Enjoy browsing The Daily Grind!`,
+      };
+
+      showStatusBanner(
+        actionMessages[returnAction] ||
+          `Signed in as ${displayName}. Ready to continue to ${returnUrl || 'your destination'}.`
+      );
+    }
+
+    function showFallbackSignInUi({ returnAction = 'signin', returnUrl = '/', trigger = null, reason = '' } = {}) {
+      pendingAuthContext = { returnAction, returnUrl, trigger };
+      const encodedReturn = encodeURIComponent(returnUrl);
+      fallbackFullSigninLink.href = `/signin?returnTo=${encodedReturn}`;
+
+      const actionLabels = {
+        rewards: 'view your Daily Grind Rewards',
+        account: 'access My Account',
+        order: 'start your online order',
+        favorite: `save ${trigger?.dataset?.itemName || 'this coffee'} to your favorites`,
+        signin: 'access your Daily Grind account',
+      };
+      const label = actionLabels[returnAction] || 'continue';
+      fallbackSubtitle.textContent = reason
+        ? `${reason} Please sign in below to ${label}.`
+        : `No saved passkey or password was selected on this device. Sign in below to ${label}.`;
+
+      fallbackSection.hidden = false;
+      emailInput.focus();
+    }
+
+    // Attach Immediate UI mode to contextual triggers (links and micro-actions)
+    const quickSignInTriggers = document.querySelectorAll('[data-quick-signin]');
+    quickSignInTriggers.forEach((trigger) => {
+      trigger.addEventListener('click', async (event) => {
+        const returnAction = trigger.dataset.returnAction || 'signin';
+        const returnUrl = trigger.getAttribute('href') || '/';
+
+        // If already signed in, complete micro-actions or in-page actions immediately
+        if (document.body.dataset.signedIn === 'true') {
+          if (trigger.hasAttribute('aria-pressed')) {
+            event.preventDefault();
+            toggleFavoriteButton(trigger);
+          }
+          return;
+        }
+
+        event.preventDefault();
+        if (isAuthenticating) return;
+
+        isAuthenticating = true;
+        try {
+          const user = await authenticateWithImmediateUi();
+          updateHeaderUserState(user);
+          completeUserIntent({ trigger, returnAction, returnUrl }, user);
+        } catch (err) {
+          if (err.name === 'NotAllowedError') {
+            // No local credentials available, Immediate UI unsupported, or user dismissed dialog:
+            // transition smoothly to inline fallback sign-in UI with return URL
+            showFallbackSignInUi({ returnAction, returnUrl, trigger });
+            return;
+          }
+          console.error('Authentication error:', err);
+          showFallbackSignInUi({
+            returnAction,
+            returnUrl,
+            trigger,
+            reason: 'We could not verify that saved credential.',
+          });
+        } finally {
+          isAuthenticating = false;
+        }
+      });
+    });
+
+    // Show/hide password toggle in fallback sign-in form
+    togglePasswordBtn.addEventListener('click', () => {
+      const isShowing = passwordInput.type === 'text';
+      passwordInput.type = isShowing ? 'password' : 'text';
+      togglePasswordBtn.setAttribute('aria-pressed', String(!isShowing));
+      togglePasswordBtn.textContent = isShowing ? 'Show password' : 'Hide password';
+    });
+
+    closeFallbackBtn.addEventListener('click', () => {
+      fallbackSection.hidden = true;
+    });
+
+    // Standard password submission on fallback form (never uses uiMode: 'immediate')
+    fallbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const username = emailInput.value.trim();
+      const password = passwordInput.value;
+      if (!username || !password) return;
+
+      try {
+        const verifyResponse = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, password }),
+        });
+        if (!verifyResponse.ok) {
+          throw new Error('Password verification failed');
+        }
+        const user = await verifyResponse.json();
+        updateHeaderUserState(user);
+        completeUserIntent(pendingAuthContext, user);
+        fallbackForm.reset();
+      } catch (err) {
+        console.error('Fallback sign-in error:', err);
+        showStatusBanner('Unable to sign in with those credentials. Please try again.');
+      }
+    });
+
+    logoutLink.addEventListener('click', (event) => {
+      if (document.body.dataset.signedIn === 'true') {
+        event.preventDefault();
+        document.body.dataset.signedIn = 'false';
+        navUserItem.hidden = true;
+        navSigninItem.hidden = false;
+        showStatusBanner('You have been signed out of The Daily Grind.');
+      }
+    });
+  </script>
 </body>
 
