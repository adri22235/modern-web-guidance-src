+    /* Roast Selector */
+    .roast-selector {
+      margin-top: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .roast-selector label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+      color: var(--accent);
+      text-transform: uppercase;
+    }
+
+    select.roast-select {
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 6px;
+      padding: 0.6rem 1.2rem;
+      font-size: 1rem;
+      font-family: inherit;
+      font-weight: 600;
+      cursor: pointer;
+      min-width: 220px;
+      outline: none;
+      transition: box-shadow 0.2s, background-color 0.2s;
+    }
+
+    select.roast-select:hover,
+    select.roast-select:focus {
+      box-shadow: 0 0 0 3px rgba(255, 171, 64, 0.35);
+    }
+
+    @supports (appearance: base-select) {
+      select.roast-select,
+      select.roast-select::picker(select) {
+        appearance: base-select;
+      }
+
+      select.roast-select {
+        display: inline-flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 0.75rem;
+      }
+
+      select.roast-select::picker-icon {
+        color: var(--accent);
+        transition: rotate 0.2s ease;
+      }
+
+      select.roast-select:open::picker-icon {
+        rotate: 180deg;
+      }
+
+      select.roast-select::picker(select) {
+        background-color: var(--primary);
+        color: var(--accent);
+        border: 2px solid var(--accent);
+        border-radius: 6px;
+        padding: 0.25rem;
+        margin-top: 0.25rem;
+        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
+      }
+
+      select.roast-select option {
+        background-color: var(--primary);
+        color: var(--accent);
+        padding: 0.5rem 0.75rem;
+        border-radius: 4px;
+        cursor: pointer;
+      }
+
+      select.roast-select option:hover,
+      select.roast-select option:focus {
+        background-color: var(--accent);
+        color: var(--primary);
+      }
+
+      select.roast-select option:checked {
+        font-weight: bold;
+      }
+
+      select.roast-select option::checkmark {
+        color: var(--accent);
+      }
+
+      select.roast-select option:hover::checkmark,
+      select.roast-select option:focus::checkmark {
+        color: var(--primary);
+      }
+    }
+
