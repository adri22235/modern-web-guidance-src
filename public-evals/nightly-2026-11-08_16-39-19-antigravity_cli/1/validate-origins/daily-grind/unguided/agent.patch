+            const redirectCheck = validateSameSiteRedirect(data.redirectUrl);
+            if (redirectCheck.valid) {
+              logSecurityEvent(`[VALID REDIRECT] Order redirect verified: ${redirectCheck.url}`);
+            } else {
+              logSecurityEvent(`[BLOCKED REDIRECT] Order redirect rejected: ${redirectCheck.reason}`);
+            }
+          }
+
+          return { handled: true, category: 'trusted-ordering', origin: event.origin, data };
+        }
+
+        // 3. Reject untrusted origins
+        logSecurityEvent(`[REJECTED ORIGIN] Ignored cross-window message from untrusted origin: ${event.origin}`);
+        return { handled: false, category: 'untrusted-origin', origin: event.origin };
+      }
+
+      window.addEventListener('message', handleWindowMessage);
+
+      // Initialize page validations on DOMContentLoaded / load
+      function initSecurityValidations() {
+        validateAndHardenLinks(document);
+
+        // Check URL query parameters for any returnTo / redirect / next / continue parameter
+        const params = new URLSearchParams(window.location.search);
+        const redirectParam =
+          params.get('redirect') || params.get('returnTo') || params.get('next') || params.get('continue');
+
+        if (redirectParam !== null) {
+          const check = validateSameSiteRedirect(redirectParam);
+          if (check.valid) {
+            showBanner(`Verified same-site redirect destination: ${check.url}`, 'success');
+            logSecurityEvent(`[URL PARAM REDIRECT] Accepted same-site redirect: ${check.url}`);
+          } else {
+            showBanner(`Blocked unsafe redirect parameter: ${check.reason}`, 'error');
+            logSecurityEvent(`[URL PARAM REDIRECT] Blocked unsafe redirect "${redirectParam}": ${check.reason}`);
+          }
+        }
+
+        // Wire interactive redirect validator in the UI
+        const redirectBtn = document.getElementById('validate-redirect-btn');
+        const redirectInput = document.getElementById('redirect-input');
+        const redirectResultEl = document.getElementById('redirect-validation-result');
+
+        if (redirectBtn && redirectInput && redirectResultEl) {
+          redirectBtn.addEventListener('click', function () {
+            const result = validateSameSiteRedirect(redirectInput.value);
+            if (result.valid) {
+              redirectResultEl.textContent = `Allowed (Same-Site: ${result.site}) → ${result.url}`;
+              redirectResultEl.style.color = '#2e7d32';
+              logSecurityEvent(`[REDIRECT CHECK] Allowed: ${result.url}`);
+            } else {
+              redirectResultEl.textContent = `Blocked: ${result.reason}`;
+              redirectResultEl.style.color = '#c62828';
+              logSecurityEvent(`[REDIRECT CHECK] Blocked: ${result.reason}`);
+            }
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSecurityValidations);
+      } else {
+        initSecurityValidations();
+      }
+
+      // Expose validation utilities for programmatic inspection / testing
+      window.DailyGrindSecurity = {
+        TRUSTED_ORDERING_ORIGIN,
+        getRegistrableDomain,
+        parseOriginInfo,
+        isSameOrigin,
+        isSameSite,
+        validateSameSiteRedirect,
+        isTrustedOrderingMessage,
+        handleSandboxedWidgetMessage,
+        validateAndHardenLinks,
+        handleWindowMessage,
+        getPinnedWidgetSource: function () {
+          return pinnedWidgetSource;
+        },
+        resetPinnedWidgetSource: function () {
+          pinnedWidgetSource = null;
+        }
+      };
+    })();
+  </script>
+
